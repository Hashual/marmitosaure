INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 11568aad-b987-438c-b85e-5c3902b73149, 'Super recette, très facile et la crème est parfaite avec les ingrédients cités. 24h au frigo et la consistance est impeccable, le tiramisu délicieux !', '2022-03-01T16:37:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 2bd302e3-4395-48e9-b6ba-309d9e6079be, 'Super recette, facile et rapide. J''ai fait 2 étages de biscuits cuiller/framboises/mascarpone pour que ça soit plus homogène dans les verrines. ', '2022-01-30T15:35:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 355daab9-7d76-4d78-9209-6c34851f2cd1, 'J’ai réalisé cette recette un tas de fois…. Jamais raté. Consistance légère 
