INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 4dfc4bbd-10ef-4df0-bad0-2f89f57d6c44, 'Délicieux. On peut aussi réaliser ce crumble avec d''autres fruits (abricots, poires, myrtille... )', '2018-09-24T13:40:03+02:00');
