INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 6ccf9052-d740-4208-86ee-db7bb8651d59, 'J''ai juste ajouté 1 banane en plus et je n''est pas laisser poser la pate ( j''étais trop impatiente de gouter) et franchement un régale les meilleures que je n''est jamais mangé ', '2017-06-04T10:45:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 67773cd2-1e3c-435a-852a-abcc6ab07b4d, 'Très bon et facile à faire ! Pour ma part je ne mets pas de beurre mais je rajoute une banane ', '2017-02-24T08:24:02+01:00');
