INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, 7070cc34-1cee-4353-9e95-649a59351957, 'Magnifique !! J''ai suivi la recette et ai juste remplacé la liqueur par du sirop. Avec une petite framboise entière qui trône sur quelques muffins le résultat est beau et bon !', '2013-10-16T10:44:46+02:00');
