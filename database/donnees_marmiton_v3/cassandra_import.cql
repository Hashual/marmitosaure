INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 4a41cd93-dbd4-4db5-9039-a7b944142fc3, 'Personnellement, j’utilise tous les ingrédients de la recette pour 4 personnes mais j’y ajoute 100ml de lait et je coupe mes pommes en petit morceaux et je les incorpore à ma pâte. (Pour les plus gourmands, j’y ajoute de la cannelle). Délicieux !', '2020-04-15T15:27:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 4d3649d5-9e97-4072-bbf1-456e21a5ccaa, 'Merci pour cette recette, je ne sais pas ce que j''ai loupé mais le cake était extrêmement sec. La pâte etait très compacte et difficile à travailler.', '2020-04-13T14:04:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, d57b37a0-529d-418a-a2ed-ede00539ed3a, 'Bonjour, je cherchais une recette avec un moula à cake car ma fille m''a piquée tous les autres plats à gâteau ! Je tombe sur cette recette avec photo du plat à cake mais quand j''arrive à la fin de la recette, je lis mettre dans un plat rond !  !  !  ! J''ai pas réussi à mettre toutes les pommes coupées dans mon plat. Marre des recettes qui ne correspondent pas à mes recherches !', '2020-04-05T16:21:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, dca42202-fd3a-4a3e-aab1-284975c81b52, 'Excellent !? un peu de mal avec la pâte mais le cake est vraiment bon.', '2020-03-14T10:38:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 73fc8a16-3ee0-4992-9047-b47338a22f08, 'Excellent ! Merci.', '2020-03-08T15:32:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 07db0b17-1080-4e9f-9bbb-58dfccf9dd52, 'Excellent une recette qui fait partie de mes favorites.', '2020-02-15T19:24:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, cf3a616e-7d61-406b-9554-3463f0326c48, 'Excellent cake, moelleux à souhait, je le refererais tres certainement !
Je n''ai pas mis le rhum et après avoir lu les commentaires précédents, j''ai ajouté un petit pot de fromage blanc à ma pâte,  ainsi que l''équivalent de 2 cuil. à soupe de lait.', '2020-02-12T07:27:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, e0f42c97-c729-4ccc-b66c-4da5aa735c6d, 'Trop sec pour ma part !', '2020-02-01T09:24:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, ec79c87f-8a59-443b-aee8-dee77bf4d2da, 'Fromage blanc pour moi également pour une meilleure texture et plus moelleux. Sinon très bonne recette. Top.', '2019-11-10T02:00:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 075605c3-07ce-407d-9956-5d5fc9ef3190, 'J''ai ajouté une pomme, le jus d''un citron et un oeuf. Juste trop sucré à mon goût. Et j''ai remplacé 50 g de la farine par 50 g de son d''avoine. Délicieux, pas sec.', '2019-09-09T06:57:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 615dbdea-2fa9-4682-b361-5dd25f3869b0, 'Déçue, j''ai tout suivi à la lettre. J’ai même salivé devant !  Mais il est trop sec ?', '2019-04-16T19:52:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 5781c2f9-1c7e-4856-bb62-dce4803e12b8, 'J''ai remplacé les 150 g de sucre par 100 g de rapadura et j''ai ajouté un peu de lait et de cannelle. Une tuerie !', '2019-02-07T10:47:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, c1011a16-8246-49d1-9fd8-55f3317d7107, 'Super bon. J''ai mis que 2 pommes et rajouté de la vanille du rhum et cannelle mais sans ajout au top également. Toute la famille et amis ont validés merci pour cette recette !', '2018-09-27T19:12:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 1acbfa7c-78fe-4851-ab27-9b5f0fa44d14, 'Excellent gâteau très moelleux. A refaire.', '2018-09-12T21:20:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 35015728-8fc9-43de-88cf-e41ea8807aeb, 'Très facile a faire, et délicieux !!! C''était le gâteau d''anniversaire de mon chéri, et il a ADORÉ !', '2018-09-06T08:50:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, d30f5110-d075-4f65-bfcc-b86dcc0f703e, 'Excellent cake, pas trop sec grâce aux pommes. J’utilise du sucre de canne qui a meilleur goût. Et la touche de rhum... un régal.', '2018-09-03T11:20:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 4e6ca84d-04c8-4a7b-b597-4844590d7048, 'Très bon mas j''ai rajouté de la cannelle et un peu de lait, gâteau plus moelleux.', '2018-06-04T13:07:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 5291fb58-0ba0-4d60-a782-4bd0871e00c9, 'Très bonne recette appréciée par tous les gourmands lors de grandes fêtes.', '2017-11-18T11:32:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 91beb331-1c0a-4d30-ac9e-00b2263a3f79, 'Je trouve que le cake est sec et trop sucré.', '2017-09-24T03:16:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 56de90c9-a506-4569-8ff9-a3da218fe27d, 'Un délice ! Je me suis régalée !', '2017-09-13T20:51:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, a7b8b9e2-d2a6-4140-9db8-1332bd3f5ce7, 'Super recette. J''ai coupe les pommes en cubes et un peu plus de rhum...trop bon trop moelleux.', '2017-04-03T00:49:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, cc6ecfc5-3342-4340-9aa8-e51f9381bae0, 'Réalisé sans rhum et pommes mélangées en petits cubes - Délicieux !', '2017-04-02T12:32:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 68ec9c5c-d5ad-4839-9160-46cc22989236, 'Excellent!', '2017-03-18T18:12:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 22d9a339-17bb-4fd3-9e1d-274ff3d00781, 'Mmmmm, hyper réussi. J''ai juste mis 2 pommes et plus ou moins 10 cl de crème. À refaire. Vraiment très moelleux !!!! Miammmmm.', '2017-01-03T20:53:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, c7856bee-ab67-43f0-8b9b-51eee38f6259, 'Toute la famille a trouvé ce cake exquis. Moelleux, aérien. Juste un pur délice. Je le referais sans aucun doute !', '2016-12-27T21:13:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 1b516b87-af68-450c-bb06-c897a77d80b1, 'Top top !! J''ai personnellement rajouté un peu de cannelle et 2 cuillères de lait et je n''ai pas mis de rhum. Cake super moelleux et délicieux !!!', '2016-12-19T14:59:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 2a02fed6-656d-4efc-8fe6-de9bdf72571e, 'Excellent !!! Je ne avais pas mis de rhum, mais ça manquait. J''ai respecté les proportions mais multiplié par deux histoires de faire 2 gâteaux en une fois !!! J''ai utilisé des moules rectangulaires et j''ai ajouté 20 cl de crème liquide allégée... un délice ! ', '2016-10-02T22:53:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, d1c00226-b278-4f64-9910-b0c563e15a1a, 'Excellent et facile à faire .', '2023-10-30T12:35:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, d11d8d22-8489-49b4-825a-8e26f60c6746, 'pour ma pare j’ai ajouté le jus d’un citron jaune et deux cuillères à soupe de miel , et c’était excellent 😜', '2023-08-07T21:54:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, 16e2d54f-51c3-4175-b612-dd1a2251d5f3, 'Excellent sortant du four avec ce petit goût meringué ', '2023-07-13T21:11:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, b6d1091c-18c0-4322-9c94-443c82a80396, 'En plus des pommes , jai changé les framboises contre des noix . . Extra', '2020-11-17T15:05:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, 8840a4cb-ffc8-492d-8215-89588568f034, 'Super bon avec 100g de farine et 50g de poudre d amandes', '2020-11-16T21:22:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, 5cc9ed14-9c7c-4c61-97d3-ac4fd4343575, 'Excellent, je l''ai testé avec framboises et pépites de chocolat et également mûres (mettre une bonne quantité)
', '2020-08-21T01:25:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, 59eb879c-22aa-4c82-b5a2-80077570ff59, 'Succès à tous les coups et bien facile à faire à l''improviste, si l''on a des framboises surgelées, et si l''on ne met pas de citron. Pas besoin d''aller faire des achats. Et en cupcakes, tout aussi apprécié.', '2020-08-09T11:26:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, a5bece91-5e5f-4de3-b80c-836cd1237692, 'Recette réalisée avec des framboises fraîches du jardin,quantité de sucre réduite pour nous, mais un pur délice ! à garder car c''est un gâteau facile à faire', '2020-05-14T16:22:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, 241f7a45-5a7e-474a-8099-7ee4fe1e9515, 'Excellent ! Un petit coté croquant au dessus. Parfait avec de framboises congelées. A faire et à refaire.', '2020-03-22T15:44:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, dee27b48-7b6b-4aeb-a929-f9007ee0efbf, 'Excellent ! J''ai utilisé des fruits rouges congelés . A refaire !', '2019-08-15T11:19:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, c4bb9105-eee2-43d7-9219-6ec7cecf159f, 'Petite variante, j’ai mixé les framboises avec le zeste de citron et je l’ai incorporé à la pâte. Puis j’ai mis les framboises et le beurre dessus comme dans la recette. On me demande de le préparer très souvent !', '2019-06-04T12:15:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, e80e909e-7bac-4f91-8b5d-04b839b11349, 'A refaire !', '2018-12-19T07:34:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, 025b5604-5ba5-4494-b02f-abbe477dd96b, 'Délicieuse rien à changer !', '2018-07-25T07:01:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, 19036812-2b45-4fa6-96c0-bb0317880b93, 'Excellent ! Croquant dessus moelleux à l''intérieur j''ai suivi la recette.', '2017-04-28T22:42:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, 3fd2bb4e-eb57-4ecb-88f5-e5d1de881bf8, 'Une base de génoise simple relevée par les framboises. Adopté uniquement avec une crème anglaise. Il faut mettre le zeste de citron à mon goût. ', '2016-10-19T15:06:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, ee20f30e-dbb8-46d3-a2c6-a0c8fe530303, 'Gâteau excellent, pas trop lourd. J''ai mis 3 oeufs 200 g de sure 200 g de framboises et 170 g de farine. Avec tout ça j''ai ajouté un coulis de framboises, c''était vraiment bon.', '2016-05-06T10:18:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, 24ccdee5-685e-4365-8441-e3fe516c1883, 'Fait en suivant les conseils mais la prochaine fois je ne mettrai que 100 g de framboise... Un peu trop acidulé pour moi...', '2016-02-14T20:55:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, ff67bbbf-308f-44fd-9ba7-059d51db05b0, 'Très bon gâteau, très vite fait. Testé sans citron, avec de la maïzena pour remplacer la fécule. Idéal servi avec une crème maison à la vanille. Le biscuit est légèrement croustillant mais moelleux à l''intérieur. A refaire avec d''autres fruits...', '2015-11-01T19:59:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, a714dc8c-0e42-4ad0-b30e-ef069addfafe, 'Fait en 4ème vitesse pour des invités surprise ! Trop bon !!!! J''ai juste mis du jus de citron par manque de fruits frais ', '2015-11-01T18:10:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, f97dc4a8-f39d-4ce6-91f4-4a587fc04496, 'J''ai mis trois oeufs, 200 g de framboises, 200 g de sucre, 170 de farine et pas de citron trop bon ', '2015-10-13T12:26:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, 376d3978-ce75-4a04-a7a5-d907ee44d47b, 'Très vite fait et les enfants ont adoré.', '2015-08-16T17:39:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315337, 2238e59c-66d7-4442-ba64-0c44c129d0da, 'Un gâteau rapide et bon pour un goûter improvisé ! je rajoute juste du sucre perlé sur le dessus avant la cuisson au lieu du sucre glace. il n''en reste jamais une miette!', '2015-06-27T13:02:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 3db6c77b-7a90-423f-a607-a6051672241b, 'Très bonne idée ! Les  épinards peuvent être revenus à la poêle, après les oignons et l''ail. Pour que ce soit plus rapide (soir de semaine par exemple 🤩), j''ai cuit les patates déjà coupées (au robot). Bonne idée de mettre du thym 😉.', '2023-03-18T19:58:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, ca6d201a-494b-49dd-817e-bd87c3f5c019, 'Très bonne recette. J ai un peu augmenté les doses. Nous nous sommes régalés !', '2023-05-23T07:41:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, fe12d690-0b7b-4315-b095-5a4d5c35a10d, 'Tres bon plat complet.', '2020-05-10T19:45:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 332c0b9d-8197-4583-990d-21623f927be4, 'Comme dans un commentaire j''ai ajouté 200 g de lardons aux épinards; je n''ai pas mis de thym et de muscade (pas dans mes goûts); j''ai également ajouté 4 oeufs cuits durs coupés en 2 dans mes couches d''épinards. Résultat excellent. ', '2016-08-14T15:08:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 728878a8-a9a0-4c54-847d-1c10f2840e4f, 'Excellente recette, facile à réaliser et qui a ravi ma famille ', '2016-06-03T21:46:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 189b9c70-d4cc-4f24-8229-f4b23e388b45, 'Très bon. J''ai remplacé le râpé par du chèvre en bûche. Fait avec les épinards bio en branches de Picard. Bon équilibre épinards/pomme de terre.', '2015-03-24T21:28:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, f311866a-9426-4d0a-84b3-ef9c9ccdb6ee, 'Très bonne recette ! Perso j''ai pelé les pommes de terre avant la cuisson, ajouté de l''ail, de la crème fraîche et des épinards et 1/2H de cuisson. A l''unanimité je referai ce plat.', '2015-01-09T22:44:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 4dc1ac92-3ee2-45dd-ab19-767bf97e61bc, 'Excellent avec des lardons. ', '2013-12-15T23:27:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 4c7bf003-d00c-4cb5-ac99-92c5f2b6880f, 'Très bonne recette à faire avec un reste de pommes de terre cuites. En revanche je mets un peu plus d''épinards : plutôt 400g d''épinards surgelés...', '2013-12-09T23:07:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, b1e31c4a-2311-49d9-9598-e1b12228a39a, 'Superbe recette ! Par contre je mettrais moins de gruyère la prochaine fois. J''ai rajouté des lardons et des feuilles de laurier. Je n''hésiterais pas à la refaire tout le monde s''est régalé !', '2013-05-08T20:48:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, f077c2de-158a-4322-bd1c-c578a80a83c3, 'Très bon, mais il n''y a absolument pas besoin de blanchir les épinards, les faire tomber à la poêle avec l''ail et l''oignon 5 min suffit amplement.', '2013-03-14T12:36:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, b64c27ea-2d54-4d06-8571-ccce6439db2b, 'Une bonne recette qui permet de manger des épinards. J''ai rajouté des lardons que j''ai fait revenir au préalable avec les épinards et une échalote (faute d''oignon). Craignant l''ail, je l''ai juste frotté sur mon plat. Enfin, pour terminer, j''ai mis de la crème entre chaque couche. ', '2013-02-13T12:14:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 82cc4783-a5f1-4d26-aa5d-b7f7e92b6211, 'Excellent moyen de faire consommer des épinards, je la fais avec des lardons, et sans crème fraîche  ', '2013-02-11T17:17:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, c0eebeea-2994-43dc-bd6b-c2345751603b, 'Très bon. A été apprécié des convives.', '2013-01-27T09:28:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 412402b7-488e-4a52-b08a-50ad61c47b85, 'En manque d''inspiration pour consommer les épinards frais, je me suis lancée dans ce gratin=> très bon ! Pour varier, la prochaine fois je testerai avec une autre épice que la muscade pour voir !', '2012-09-08T11:06:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 0fd81abf-bd2a-4982-9149-386d4408615d, 'Le mien était un peu sec, j''ai probablement mis trop de patates... Néanmoins ça reste un plat très sympa, original et facile. Je le referai sans problème !', '2012-04-15T23:47:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, eb02d1fc-76d4-4e1b-86b2-67b65b240ce4, 'Tout simplement délicieux, mon fils de deux ans a adoré !', '2011-02-23T18:37:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 25d2891b-4e9d-47e3-9f53-e63c509d50a4, 'Ici tout le monde a mangé des épinards même si les enfants ont mangés plus de pommes de terre mais en gros tous ont au moins un peu mangé des épinards et j''ai mis du gruyère au milieu du gratin', '2011-01-23T18:58:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, c5678e82-4983-44fe-99a0-2a94398dbb94, 'Parfait avec des épinards surgelés ! A l''œil pour les proportions puisque j''ai cuisiné pour 2 !!!!', '2010-09-02T21:51:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 715c2547-cdab-4516-bf5c-af3d9df8ad36, 'Très bon simplement la prochaine fois je mettrai un peu plus d''ail pour relever le goût.', '2010-09-02T11:45:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, c076f1a3-0153-4fbb-90b8-b17c9ae5c446, 'Tous ceux qui n''ont pas l''habitude de manger les épinards ont adoré. Excellent et à refaire.', '2010-04-03T13:27:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 2c82337b-ef3b-46c3-ada3-b8e29c542a20, 'C''était très bon.', '2009-04-05T16:24:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 8af64c03-7188-4909-9c40-6e39e848ca21, 'J''ai du loupé une étape, je pense!! Mais cela change tout de même.', '2009-03-19T08:29:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, df3546a5-80ed-45d1-ad1a-a52261d8eb87, 'Simple et excellent mais mettre plus d''épinards !', '2008-05-22T20:26:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, f1636e19-362f-4508-add6-7a9b0ab694df, 'Très bon. J''ai mis de la crème entre chaque couche comme conseillé. La prochaine fois, je mettrai un peu plus d''épinards.', '2008-04-16T22:13:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 3fa2a86e-70f4-4d5d-a81d-82994fcad404, 'J''ai vraiment adoré! L''ail et le fromage donnent du goût et je n''ai pas lésiné sur la quantité de crème fraîche liquide. C''est simple, sain et délicieux!', '2008-02-28T17:46:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, cc712289-7f26-41a4-a3bb-7c82103ec37e, 'Qu''ajouter de plus à tous ces commentaires ! Cette recette est excellente. Je n''avais pas d''épinards et j''ai donc utilisé du vert de blettes ! Toute la famille a aimé.', '2008-02-14T22:07:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 2b9fe67a-6733-4b5d-9f75-de03baccf5a2, 'Une recette excellente! J''avoue que je ne m''y attendais pas. Je l''ai réalisée surtout parce que j''avais sous la main que ces ingrédients et que je cherchais une recette avec pour me dépanner! Résultat: je me suis régalée. Je conseille de mettre la crème entre chaque couche plutôt que sur le dessus. J''ai mis des morceaux de fromages qui me restaient et qui ont grandement contribué à parfaire la recette. Ah oui, je ne sais plus s''il y avait de l''ail mais moi j''en ai mis et ça aussi c''était un "bon plus"!', '2007-12-14T19:35:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 35b22784-ca03-4513-84ad-e950d705b2f0, 'Super recette!!! Je suis une grande gourmande, alors j''ajoute du chèvre et pour que la crème soit bien répartie, j''en mets entre chaque couche un petit peu.', '2007-11-23T12:36:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 4de34354-4cea-4356-b611-aaa043317b65, 'Super! Mais je pense qu''il faut beaucoup plus d''épinards. J''ai eu quelques problème avec la crème qui est restée vraiment sur le dessus du gratin : Du coup j''ai arrosé de lait et ça l''a fais descendre! Ca a permis aux pommes de terre d''être très mouelleuses.', '2007-09-22T08:56:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 1ea46eb6-26de-42ef-82b1-06090bae3246, 'Bon je n''ai pas mis de crème, du coup c''était un peu sec mais c''est une excellente base pour laisser libre court à l''imagination. Merci.', '2007-09-11T23:02:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 52fa6b2c-ceeb-4803-80df-d578eac44b9f, 'Manière originale de manger des épinards, c''est délicieux en plus. Peut-être un peu plus de fromage et  un qui a du goût (Cantal, Comté).', '2007-07-04T14:49:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 2e3513cd-4fe4-4830-a749-905ab997e9b4, 'J''ai rajouté du poisson émietté au milieu...Un régal pour toute la famille !!!', '2007-05-20T16:08:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 04d7ee1f-8217-4509-9947-87e920a659be, 'Très bonne recette. Toutefois, 300 g d''épinards s''est averé très insuffisant. La prochaine fois, j''utiliserai sans doute un kilo.', '2007-05-19T23:38:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, ebcca104-2ac8-43b0-8c6a-75af84b4c5e5, 'Avec un peu moins de pommes de terre, c''est une très bonne façon d''accomoder les épinards!! Et ça marche avec des épinards congelés!', '2007-05-06T17:53:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 8f8e1a1d-37d6-4bcb-a3e0-7950d281aeac, 'Merci pour l''idée : ce gratin est très bon et surtout permet de varier. Bon, moi j''ai mis trop de pomme de terre... et je pense que mettre aussi la crème fraîche au fond du plat serait pas mal (chez moi elle est restée plutôt dessus).', '2007-03-07T21:02:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 5adf4883-6e39-4767-bbbb-ce15253323c6, 'Super bon!! recette très facile! J''ai utilisé des épinards surgelés, et mon mari qui ne les aime pas, a raffolé du plat!! Tout comme moi et notre fils de 23 mois! J''ai eu l''idée de rajouter du poisson pour faire un repas complet: 2 pavés (de cabillaud je crois lol!) surgelés que j''ai émiétté dans le plat! Miaaaaam!! Cette recette sera un classique chez moi ! Moi qui ne sais jamais comment cuisiner les épinards alors que j''aime ça !! Merci !!! ', '2007-02-10T22:31:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, b2dc393e-2029-497c-864f-4faf5c5f64d2, 'Moi qui ne suis vraiment pas une fan des épinards, j''ai beaucoup aimé ce gratin. Et monsieur aussi...Recette à conserver!', '2007-01-25T12:03:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 59d52428-3f53-49c2-85b4-e8c182039fcc, 'Une recette vraiment délicieuse pour un repas du soir. La prochaine fois, je mettrai un peu plus d''épinards.', '2006-11-17T16:21:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 2b68facd-f0c1-4df6-b5f4-532fe0a904ba, 'Whah, délicieux, tout le monde a adoré! Je l''ai fait avec des épinards à la crème surgelés, un reste dont personne ne voulait ! Tout comme quoi, tout se transforme, notamment avec ce très très bon gratin.', '2006-09-21T19:02:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 9f8d5d41-5af1-4f05-9d07-84bde43d60b8, 'Délicieux ! les épinards rendent le plat plus léger, c''est vraiment très bon ! ', '2006-03-26T11:26:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 659ec58b-a7b2-4949-b34d-d51e9e136dad, 'Je n''aime pas les épinards, mais j''en fait pour les enfants et mon mari, et bien j''en ai mangé. Tout le monde a adoré ça, même mon fils de 8 mois en mixant a tout mangé. Merci beaucoup pour cette recette que je garde  précieusement.', '2006-02-09T21:21:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 05653d2b-5e78-4709-87dc-b653f48a344e, 'Très bon! Très facile ! Tout le monde s''est régalé. ', '2005-11-09T15:42:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 2fb1dc48-d404-4fae-b548-0c890fb7b798, 'Très bon, ça permet de cuisiner les épinards autrement!', '2005-08-15T18:28:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, eeb63c3b-7169-4170-8c4b-585bb1153f7d, 'Ça aide à faire passer les épinards pour ceux qui n''aiment pas ça.', '2005-07-22T14:20:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 6a5b19d7-7500-41ba-8d54-b62f7aca8c3b, 'Très bon! Ca change du gratin classique et les récalcitrants des épinards adorent...', '2005-04-29T15:33:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, c2311b39-9809-4df4-a1f8-64baa292fed2, 'Sympa! Une autre façon d''agrémenter des épinards et pommes de terre. J''ai utilisé des épinards surgelés (le sac entier!). Je mettrais juste un peu moins de crème fraîche car ça "nage" un peu.', '2005-04-23T21:44:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, cd702dfc-b931-434d-b07c-29228c3f2e9f, 'À exécuter tel quel pour un vrai régal. ', '2004-12-22T08:55:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 1e89a17e-03a0-4736-9b41-6ba9ba213481, 'C''est super bon!!! Il faut l''essayer absolument! :o))', '2004-11-06T15:16:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31211, 06712809-5da3-43cb-a5ba-ee5d98c5e4c1, 'Humm, délicieux!!!', '2004-09-23T20:54:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222859, 1ffe0a94-a1d9-498d-a3e1-9c90b592a984, 'Bonjour, j''ai fais ce gâteau en remplaçant la confiture de framboise par une confiture myrtille groseille. N''ayant pas de biscuit j''y ai mis des flocons d''avoine, je n''ai pas sucré la chantilly. Excellente recette ! Merci !', '2018-08-14T10:53:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222859, 21c72dec-6b72-4765-9590-7c67a01a59a8, 'Simple et délicieux ! J''ai doublé les proportions, sauf pour la couche supérieure, mmmh', '2017-02-11T16:18:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222859, 37b0d5f4-e3df-4f77-aa4a-e7bb9617c4cd, 'Absolument délicieux. Fait avec des galettes bretonnes et recouvert de framboises fraîches sur le dessus, c''est un dessert fantastique.', '2015-10-22T15:27:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222859, 6f9cfd34-2849-4e88-8a75-628e42b69d95, 'Très bon. Attention, pour un moule à manqué de 26cm environ, la quantité de chocolat blanc est un peu juste pour bien étaler. Et si ça ne tenait qu''à moi je mettrais moitié plus de chantilly au chocolat, le résultat est un peu mince. Mais ça reste délicieux !', '2013-11-12T19:37:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222859, 0abc5f53-af52-48e1-8650-69950b603d6b, 'Facile à faire. Mes doudous l''ont adoré... ', '2013-07-31T11:44:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222859, 2e0ca2f5-af80-4601-b85d-5c866231c518, 'Mon premier gâteau "élaboré" et réussi ! Juste un peu de difficulté pour faire fondre le chocolat blanc (aspect totalement différent du chocolat noir). J''ai mis de la gelée de framboise (pas de petites graines). J''ai fait la chantilly au chocolat au robot, résultat impeccable, la chantilly prend au frigo, et ne tombe pas. Gâteau à faire le jour même pour éviter que le croustillant ne durcisse trop.', '2013-06-13T22:49:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222859, 7a932841-8020-4633-95e6-8e686b79a8c7, 'Bon mais le fond n''était pas du tout croustillant !!!! ', '2012-07-30T22:16:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222859, f3279569-e4c3-45c0-b3e7-c759ea3180a1, 'Facile et très bon.  A part le biscuit qui est croquant, ça me rappelle les biscuits Pim''s (je crois), qui utilisent aussi le mélange chocolat confiture. Par contre attention, ce n''est pas un dessert léger...', '2012-05-30T22:31:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222859, d954d6d4-031f-4a14-951a-c33df424e17f, 'Un pur délice ! Le plus dur dans la recette, c''est d''attendre 2h avant de pouvoir le goûter. Un vrai dessert de fête facile à préparer et qui fait son effet, merci !', '2012-02-14T04:17:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 74b08ef7-9055-478a-8837-c653028d9348, 'Très bon! Dommage il me manquait quelques fraises! J''ai mis un fromage blanc à la place du yaourt et un sachet de sucre vanillé ! A refaire ', '2023-05-25T23:20:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, ef4e637c-f2a5-44ac-bbb2-846b677e04f2, 'Seulement 1 pot de sucre et 500g de fraises. Parfait car pas sucré ', '2023-05-17T08:10:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, a165e9c9-25ff-464b-8704-6fa049d39235, 'Excellent, léger, je l’ai déjà fait plusieurs fois, tout le monde se régale.', '2023-05-26T13:46:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 847e6270-31ed-420a-bdb2-8625bd261cd0, 'Cuisson en cour... . Recette FACILE pas besoin de balance !  !  !  !', '2018-12-01T10:26:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, b0890a87-8188-473c-bd7b-48fbe64e1fd4, 'Fait le 2 /12 /2024 j''ai mis 1 pot de sucre et un peu plus de fraises', '2024-01-02T18:51:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, e03d75e2-1b47-4afd-8b4b-84280657c722, 'Facile rapide et bon merci beaucoup j ai juste rajouté un peu de coco par dessus', '2023-04-21T12:51:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 339439e2-45b2-413a-bada-795fc4aded8f, 'Suivi à la lettre ( juste un petit sachet de sucre vanillé en plus) et excellent !! Merci beaucoup pour votre recette !!!', '2022-06-06T09:32:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 9a5b55b6-e0fe-4f42-9390-2d347d0a2deb, 'Délicieux ! J''ai remplacé un pot de sucre par un pot d''amandes en poudre.', '2015-05-03T17:41:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 459d45a4-20a0-4539-af28-0b935b3751c0, 'Super simple et délicieuse, j''ai mis le résultat en photo... je l''ai fait en 10 min et j''ai épaté tout le monde j''adore !', '2014-06-01T14:16:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, bea496be-c698-4376-b2a9-aa7d777d824d, 'Je viens de le faire excellent, merci', '2022-05-23T14:01:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, a619f4b9-6d1b-4c06-8670-644f7a261f1e, 'Superbe gâteau et très facile à faire, un délice', '2022-04-25T18:48:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, e4f7c15e-fb6c-48c3-b2d9-0bb15c80e48b, 'très bonne recette simple à faire est très bonne à refaire', '2022-04-04T10:21:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 0529dd55-56c5-4474-af02-1d10b8903ac8, 'Super facile et très bon. Je referais sans hésitation.  Merci marmiton.', '2022-03-27T15:14:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 964948dc-8ae0-42d3-8947-5de46cffe8af, 'Un délice 
Photo avec gateau entrain de cuire
Dans un plat à tarte c est parfait pour la cuisson ', '2021-05-24T11:56:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 1e66b68b-07a4-489a-9245-c3d897363716, 'Très bon ce moelleux aux fraises  , la prochaine fois je mettrais beaucoup plus de fraises ...', '2021-04-23T20:55:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 8b180d91-1857-4b54-bf9d-d91c050c4dbb, 'Hyper simple, moelleux et savoureux', '2020-05-14T17:12:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 1e8e0c02-aade-430d-8340-9eaed6f416cc, 'Très bonne recette. Réalisé avec un seul pot de sucre. Avec des moules à muffins.', '2020-04-03T21:21:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, cc15acff-c12f-4eee-9b9f-ddf91c4c6df9, 'Hyper simple à faire, inratable ! Ma fille de 4 ans et demi adore.', '2020-02-26T15:39:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, ee358ebe-912f-4b1d-b795-074f3e55ce8c, 'Très bon gâteau, J''ai mis plus de fraises.
J''ai commencé par une couche de fraises ensuite la pâte et à nouveau quelques fraises et pour finir je saupoudre de sucre vanillé.', '2019-06-15T06:03:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 8e25eb80-436b-4493-a93f-e5562a637eb7, 'Gâteau super bon, super moelleux. On adore ? Je l''ai fait avec un yaourt à la vanille c''est encore plus meilleur et pour la cuisson 20-25 minutes ont suffi pour ma part ?', '2019-05-18T22:44:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, dc19cd6b-11e4-4411-a134-304d69c49505, 'Recette géniale. Délicieux gâteau hyper simple à faire que j''ai accompagné d''une chantilly maison', '2019-04-30T09:28:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 6617edfd-ffe5-4fec-94a8-d399f36d5fcc, 'Je l''ai fait plusieurs fois tout le monde se régal.', '2018-12-19T07:32:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 2d205dec-f099-46e8-a854-a23da340639b, 'C''est mon fils de 10 ans qui a fait ce gâteau pour l''anniversaire de sa soeur, et il a fait sensation...', '2018-11-04T16:02:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 50969d58-8c45-4fe5-8658-99389c6e3e4b, 'Ma fille s''est régalée pour son anniversaire.', '2018-08-15T19:33:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, b2bb29d5-4e2c-4825-8ca0-4c6060ed1220, 'Testée avec 3/4 pot de margarine végétale et 1 yaourt nature classique ce gâteau est une réussite, moelleux, savoureux, facile...merci !', '2018-03-25T12:44:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 0a3c4417-74bd-467d-8851-5ae791113b56, 'Très bon. A tenter avec d''autres fruits.', '2016-10-01T22:41:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, f1341ec6-c456-49c8-a6a7-f9d5817d36a3, 'Vraiment super bon ! Par contre j''ai cuit 45 minutes au lieu de 30, et j''ai fait ça avec des fraises surgelées presque décongelées, un régal ! Je vais le refaire sans problème ! ', '2016-06-19T16:30:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 1cb55c7d-44da-4193-9daf-0ed7cc16fec4, 'Très bonne recette, ultra rapide et gâteau très moelleux. J''ai juste ajouté un oeuf et mis un sachet de levure entier pour bien qu''il gonfle.', '2016-06-01T01:12:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, dd0c09a5-63ac-4e49-b2b5-5ff557e67359, 'C''est devenu ma recette de gâteau fétiche ! par contre il faut absolument la faire dans un moule plat type plat a tarte, ou alors en version mignardises, sinon ça ne cuit pas bien a l''intérieur. ', '2015-05-27T13:49:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 795363b9-ea0a-4881-9470-e8d65d4b29e7, 'Bien bon, à faire avec d''autres fruits.', '2015-03-04T19:09:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 5246a9c6-1437-41a3-89b1-3385a62dd002, 'Très bon !  Fait dans des moules à muffin avec un yaourt à la grecque... Aussi bon que beau ! Je réessaye ce soir en suivant la recette à la lettre.', '2014-06-26T11:33:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 41489973-f4da-449a-b524-90b00f77a22f, 'Miam ! ', '2014-06-24T15:50:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 261dd3ae-2a2c-4f4b-aa43-69caebd8a4ce, 'J''ai rajouté des spéculoos mixés par dessus. Cela se marie très bien avec les fraises !!!', '2014-06-18T20:02:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, d9850983-33f0-467c-bb81-093f1fc85e6d, 'J''ai testé mais ça ma donner la consistance d''un flan... Sûrement à cause du jus des fraises. J''ai du rater quelque chose!', '2014-06-15T23:04:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, ea1db560-83a3-4b0f-882b-de352b86c5aa, 'Délicieux !! J''ai mis un pot de fromage blanc à la place du yaourt et moitié sucre vanillé !', '2014-06-04T15:10:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 6272b600-0297-4e6a-96c0-c5929eaeaa20, 'Très bon, à refaire ', '2014-06-01T16:09:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, a0263883-e5d2-4d55-8457-1253a570e5a0, 'Recette parfaite, même avec un yaourt nature et des fraises très ordinaires ! J''ai mis une barquette de 500 g de fraises: moelleux, savoureux et pas sec du tout ! Et encore meilleur le lendemain... On peut réduire un peu le sucre pour ceux qui n''aiment pas trop sucré. Mon secret: une touche de fève Tonka pour un arôme d''une grande finesse. Et pour ceux qui ont un four micro-onde combiné avec plat et fonction "crisp": cuisson parfaite et gâteau bien doré en 12 min ! ', '2014-04-29T15:16:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, fc51aa75-adb2-4ac5-87ec-f332f14fb698, 'Très bonne idée de dessert quand on veut faire quelque chose de rapide avec ses fraises. Je retente aujourd''hui mais sous forme de muffins !', '2014-04-06T12:46:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 4d12f142-6ff7-47de-a0c4-3a93fb17ed47, 'Excellent avec les fraises du jardin, j''ai rajouté de la cannelle et du sucre vanillé.', '2013-06-16T18:24:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 718bea37-b7e9-48fc-8309-67317389e327, 'J''ai essayé ce gâteau pour un anniversaire, c''était une réussite mais j''avais ajouté un pot de lait ! Un vrai succès. ', '2013-03-31T12:21:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, 0a4bbaf6-9122-4c37-84a2-7134efb5e7c3, 'Très bon, j''ai diminué le temps de cuisson, j''ai utilisé des minis moules, je recommencerai avec des moules à muffins.', '2013-03-12T22:46:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228481, b66fa2c2-a0bc-4c9c-8744-86940a17d2dc, 'Pas mal, j''ai trouvé ce dessert agréable ! A refaire.', '2012-11-12T19:52:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 22cea764-981c-449a-9934-4b219915fa47, 'Les muffins sont vraiment moelleux, pas écœurants et il ne manque rien. Je les ai fait hier en modifiant à peine la recette : j''ai ajouté un demi sachet de levure chimique. Je les ai fait cuire 30 min à 180°C. Ils sont parfaits !!!', '2014-09-04T10:13:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, b6ec63a8-641d-4794-bd78-62599c7f3333, 'On dirait vraiment des financiers et les "muffins" sont restés plats, je n''ai pas été fan à vrai dire.', '2017-02-10T17:28:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, f64813b7-8956-47f0-9af6-ab7c71d46ecd, 'Waouw ! Super simple à faire (je suis nulle en pâtisserie), moelleux juste comme il faut... Hmmm un délice ! J''ai mis un mélange framboises myrtilles que j''avais au congélateur. Demain je recommence avec d''autres fruits surgelés 😁👌', '2022-11-05T22:38:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 14b59961-9ad7-456f-b96e-d6156146c483, 'Pour changer, même si cette recette est délicieuse, j''ajoute parfois 100 g de chocolat noir râpé.', '2022-09-25T07:06:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 658699a5-295e-45fd-b9bc-75db1ea6c494, 'Je suis la recette pour une quinzaine de muffins environ en rajoutant un sachet de levure... Juste parfait !
Avec des framboises fraîches ! ', '2021-09-22T19:48:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 15717e54-c56f-47a9-96ad-81cff488f4bf, 'Super recette ! A la maison on adore !! ', '2021-04-11T20:13:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 56459d9b-f842-4af6-968b-3a12b9a51404, 'Très bon, très bonne recette ❤️', '2020-09-15T22:06:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, da61adff-fbc1-4dec-b9b1-a0305115c2a0, 'J''ai battu les œufs en neige et ils ont bien gonflé à la cuisson, mais sont retombés après. C''était quand même très bon!! Un peu comme une texture de soufflé ou de flan.', '2020-07-19T18:05:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, e86eb3a3-1f5f-401e-84c7-b676edee8439, 'Perso ça n''a pas du coup gonflé et ils sont tous durs j''ai pas compris... Pas une réussite pour moi.', '2019-12-09T16:39:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, bd5f9f20-6128-48e3-bf6c-5dda518a5c6c, 'J''ai suivi la recette à la lettre et mes muffins étaient trop bons !! A refaire', '2015-08-31T06:44:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 221260f1-2470-48c9-b94c-4e8a39586d2f, 'Ma famille et moi nous avons adoré. Je n''avais pas de framboises donc je les aies remplacées avec des mûres. Trop bon !', '2014-08-21T19:56:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 98dd7828-0175-4c58-913a-4812fb25b69e, 'Très bonne recette. Par contre, j''ai utilisé des framboises surgelées et je n''aurais pas dû, les gâteaux étaient humides... Je retenterai avec des framboises fraîches. En tous cas au goût c''était super ! ', '2014-01-11T14:55:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, d25185c2-e3f7-4ed1-93e4-374f3abf0d93, 'Muffins vraiment pas très bons. On ne les a même pas fini je m''attendais vraiment à mieux.', '2013-01-19T11:43:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, aeb0015b-12ce-4dc1-bbe9-740957e09a60, 'Trop trop bon. Je les ai fait avec de la farine d''épeautre et les muffins étaient plus que moelleux. Super quand on a du blanc d''oeuf, ça change des financiers. Merci.', '2012-08-19T18:00:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 74297402-4969-4560-bf28-ee9aef0c3de4, 'Trop sec. Je pense que 40 minutes de cuisson à 190° c''est beaucoup trop. Je réessaierai en surveillant la cuisson.', '2012-06-04T11:40:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 2f4a5662-2c9a-427e-bb05-ea147a655d16, 'Bon, mais quelques bémols. Les muffins sont plutôt petits et les framboises sont souvent trop acides par rapport à la pâte du muffins. Ce dessert reste cependant délicieux. A refaire.', '2011-08-14T23:57:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 63ee47b9-2868-4cf4-ac4a-6f7b6f15ec9a, 'Juste parfaits ! Avec mon copain on adore.', '2011-05-14T19:10:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 16e2c9f4-1aa1-436c-ab36-c7844e5a1cd1, 'Je viens de tester cette recette aujourd''hui, et je dois dire que c''était excellent. J''y ai ajouté du nutella fait maison dedans, et c''était parfait !', '2011-01-30T16:12:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, fb6a5d07-5379-4320-9048-eec9b0a21bf4, 'Délicieux et très rapides à faire, mais je trouve que cela ressemble davantage à la texture des financiers qu''aux muffins. Petite précision de vocabulaire, mais pas faute de goût !', '2011-01-20T11:13:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 1e74d575-a79b-41c3-880a-c3aed765f22e, 'Les cousins ayant adoré ces muffins, j''ai refait la recette. Pressée de leur donner un goûter avant qu''ils ne partent à l''école j''ai oublié de mettre le beurre. Je m''en suis rendue compte 1h après avoir fait mon goûter ! Sans beurre dans des moules en silicone = 100% de réussite !', '2010-10-17T15:24:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 80e35c1e-e88c-4a10-b156-3645ba88a84d, 'Je les ai trouvés super bons et jolis à voir.', '2010-07-02T19:38:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 3fe65c90-329a-42cc-ae42-5568a98a0887, 'Idéal lorsqu''il reste des blancs d''oeufs. Nous avons adoré', '2010-06-18T15:19:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 906d85d0-34fd-4381-9909-ed69385439a5, 'Super recette ! Moi, j''ai bien pris mon temps pour mélanger les blancs à la farine. Tous mes invités ont été bluffés !', '2010-04-10T17:03:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 16be9535-4fd4-4835-a762-5c7bcdd1e598, 'Très bon ces petits muffins et en plus génial à faire lorsqu''il y a des blancs d''oeufs à utiliser.  Merci !!', '2010-02-24T11:40:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, ee5de7f2-020f-4b06-8ed4-40ea7d8af797, 'Comme je n''avais plus de framboise, je les ai remplacé par 150 g de fruits (ananas, kiwis, groseilles), un vrai délice. Gâteaux hyper moelleux, sucré juste comme il faut. Cuisson : 30 min (th7).', '2008-11-30T20:34:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, e13f59e7-9418-40cd-b0ce-db08fef5256c, 'C''est bon ! Mais ça n''a pas trop la consistance d''un muffin je trouve... peut-être parce que j''ai mis aussi les jaunes d''oeufs... Je la referais avec un peu de levure plutôt que de battre les blancs. Merci !', '2008-04-16T18:19:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 22461e16-a90c-4af4-b34c-6c16856e9060, 'Délicieux, c''est mieux par contre de mettre une 1ère couche de pâtes ensuite les framboises et pour terminer le reste de pâte car les framboises ne descendent pas... Attention si vous utiliez les moules à muffins Tupperware ça ne fait pas pour 6 muffins.', '2007-02-01T17:28:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 9143aa9e-f409-4999-9e5e-65a04425000c, 'Je ne sais pas, il manque un truc...bon, mais sans plus. Les autres ont néanmoins beaucoup aimé.', '2006-07-15T16:13:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, f13fc77f-6ba2-46b1-802f-40d5b42b4ae5, 'Simplement succulent, même sans poudre d''amandes. Les framboises rendent ce muffin très léger.', '2006-05-07T17:46:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, f3c0c54d-d892-4449-b9a9-d01fcd59d1ba, 'Très bon, pour moi qui suis fan de framboises cette recette est parfaite. J''ai testé aussi en ajoutant des morceaux concassés de chocolat blanc. Le chocolat caramélise à l''intérieur, c''est bon mais plus écoeurant. Prochain essai, avec du chocolat noir bien sur!', '2005-11-09T21:10:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 5aba4cbf-16d0-4fc2-ab78-9c1ea7bdbb05, 'Très très bon. J''ai mis la pâte, puis les framboises et enfin re-pâte! Quel délice quand en mordant dedans, on arrive sur la douceur de la framboise, hum, ils ont été avalés en moins de temps qu''il ne faut pour le dire. Délicieux !', '2005-11-06T13:07:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39688, 19f6d14c-3228-4415-ad7d-65252298669b, 'Très bon. En mini-muffins, ça ressemble plus à des financiers qu''à des muffins traditionnels. Ils sont partis très vite!', '2005-10-17T01:19:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72222, 3cf4a620-c2bd-4cbc-8f13-f6edfa556eb9, 'Ça a l''air bon mais il y aurait pas une erreur dans la recette ? 😅 Une moule (avec photo de moules, celles qui sont dans l''eau). C''est pas plutôt qu''il faut un moule ? 🤣', '2022-04-10T21:15:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72222, 03ed3133-cf0a-428d-89a8-1df8e13ad5f0, 'C''est la recette de charlotte que je fais tous les ans. Tout le monde l''adore. MERCI.', '2019-05-05T13:10:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72222, 08557526-28a4-4fe4-a075-bdb32271bb80, 'Facile et excellente. Par contre, ne pas tremper les biscuits du milieu car sinon trop de liquide ds l''ensemble du gâteau entre le fromage blanc et la tisane. Aussi je n''avais passe tisane donc j''ai utilisé du thé à la menthe, très peu infusé. ', '2012-03-31T12:05:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72222, 6cf0a71b-3c26-4915-90a8-7c732b8b8706, 'Délicieuse charlotte, la menthe se marie vraiment bien avec les fraises et la consistance est bien plus agréable que lorsqu''on met de la gélatine. J''ai tapissé le moule avec du film étirable, elle s''est démoulée sans problème! A refaire!!', '2008-07-12T18:53:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72222, 87e5e7d5-162f-4f10-903b-a8517176082b, 'Excellent, c''est devenu une recette familiale. Merci', '2023-01-30T19:15:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72222, 15a0e749-d613-43df-9e8e-09ec5bb052b8, 'Super bon. J''ai juste rajouté un sachet de sucre vanillé, car les fraises n''étaient pas très mûres.', '2022-04-30T17:17:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72222, cd16206c-88c7-415f-9a86-841d8791fef5, 'Très bon ', '2020-05-01T14:44:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72222, e2525720-6930-46ec-a6ec-1443bf3371b4, 'Réalisée pour la fête des mères, un grand succès ! ', '2017-05-28T15:33:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72222, 8fcb8726-55ec-4e2e-a87d-cc62183dc802, 'Très bon ce petit goût de menthe! Je n''ai pas mixé les fraises, je les ai toutes coupées en petits morceaux et mélangées au fromage blanc avec un peu de sucre.', '2015-05-11T12:35:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72222, 60b86170-1dc9-4004-952b-e0ea0a7a1537, 'Très bonne charlotte, facile à faire. Lorsque je mixe les fraises, je mets quelques feuilles de menthe dans le mixeur pour donner un peu plus de goût au fromage blanc. Je mélange la mixture avec la totalité des fraises en morceaux et je ne mets pas de biscuits à l''intérieur.', '2010-07-02T14:24:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72222, 0bbf42b0-6aed-4d92-9730-d3c845981ad6, 'Mon mari a adoré... Aucun problème de démoulage, elle est parfaite. Merci !!', '2009-06-09T14:49:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72222, 186d0471-cafb-43d5-b764-fb2219491f57, 'Très bien l''idée de tremper les biscuits dans une infusion menthe. C''est délicieux mais les fraises ne sont pas encore assez riches en goût... A renouveler de toute évidence à la pleine saison et à essayer évidemment avec d''autres fruits.', '2009-05-10T21:15:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72222, ffcc290c-283e-43ad-8861-c15ecac62c0c, 'Mon mari a dit que c''était la meilleure charlotte qu''il ait jamais goûtée! L''association menthe-fraise est très agréable, et la charlotte a parfaitement tenu. J''ai mis un sachet de sucre vanillé dans le fromage blanc, car hors saison les fraises ne sont pas très sucrées.', '2009-04-13T14:40:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72222, cfe400f4-0ccb-40ba-b4b5-4260ec1bcd23, 'Très bon et simple à faire. Les biscuits trempés dans la tisane donnent un goût frais très agréable. Parfait pour terminer un repas en beauté!', '2008-06-22T14:00:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72222, 54974d61-7566-4ff9-943c-026cc879d5f2, 'C''est bon, c''est simple et ça tient bien.', '2008-06-19T17:14:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 489cb2eb-5370-4f2f-b940-4cadd75ab873, 'J''ai fait sans écraser les pommes de terre et sans crème fraîche, un peu comme un pot au feu. C''était excellent. Merci.', '2015-12-07T23:06:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, a5a4d114-74be-49c6-856d-8745071028e6, 'Super recette mais j''ai fait revenir les rondelles de carottes et de poireaux et les dés de navets (le céléri rave ne passe pas chez nous) avant de rajouter le bouillon et les pdt. 5 pdt écrasées à la fourchette pour épaissir la sauce.', '2023-01-15T22:42:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 19342728-7e6b-4fe1-8d16-d652ee9d5943, 'Excellent.. une très bonne soupe de campagne.', '2019-05-30T08:13:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 28226057-c1f7-49f9-b052-9526ab6c9b78, 'LA soupe d''hiver par excellence ! On ne passe plus un hiver sans la faire au moins plusieurs fois. Tout le monde adore ! Merci pour cette chouette recette ! Pour varier, j''utilise souvent du céleri rave à la place des pommes de terre. Ça fonctionne très bien !', '2018-10-22T08:26:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 5272a9a1-76b3-43e1-99de-43da7dd52a81, 'Alors là! C’est « the » soupe! Excellente tout le monde adore !', '2018-02-04T03:28:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 49ba5053-852a-4239-8c0b-1d7fe1613ef7, 'Tres bonne, savoureuse, a refaire.', '2017-10-28T22:28:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, c0cae6ba-6200-4872-aee9-767f1c7b9716, 'Excellent ! J''ai rajouté de l''oignon pour ma part! ', '2017-05-03T21:42:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 01bb92c5-a7c8-4829-b496-9bea8b078f37, 'Très bon', '2017-02-05T21:08:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, a0a72d7a-1876-4181-b472-39f3cd5643d0, 'Très bon ! La prochaine fois je teste sans écraser les pommes de terres et la crème fraîche, pour une soupe plus légère ! ', '2015-12-21T12:03:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, f44f2e53-8940-4e72-8c55-3f1447bd77c5, 'Soupe très bonne au goût mais trop de pommes de terre à mon sens ; difficile à digérer. Pour qu''elle soit moins grasse j''ai pris 2 saucisses de Montbéliard coupées en rondelles et cuites en premier à la poêle afin d''enlever la graisse. Je n''ai pas écrasé les pommes de terre à la fin car trop pâteux. Peut-être réessayer avec beaucoup moins de féculents et plus de poireaux, de carottes et même pourquoi pas du choux vert ?', '2015-12-15T21:37:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, eadda74c-187c-4b57-834e-0a5f463842d5, 'Trop trop bon ! Même les récalcitrants à la soupe ont apprécié ! A refaire !', '2015-03-29T23:34:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 96dbc2fa-3b88-4665-88f1-9d617aa59ed0, 'A refaire c''est très bon et ça réchauffe bien après une journée froide !', '2015-03-21T23:04:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, e3e245fe-c33b-46a8-b433-783ecc48e004, 'Absolument délicieuse, merci. Je n''avais pas de céleri rave sous la main, j''ai mis plus de blancs de poireaux. Et réchauffée le lendemain, c''est encore meilleur !!!', '2015-03-21T20:53:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, a2ecdeb7-ec0b-4ca8-9b9a-c76b2a4f233d, 'C''est effectivement très bon, plein de saveurs et très rapide à faire. J''ai ajouté du navet et pas du le temps d''écraser quelques pommes de terre, mais très épaisse quand même. J''ai juste hésité sur la quantité de bouillon à mettre.', '2015-03-15T11:19:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 6de8fa6f-6e16-4c1c-962e-007460888b61, 'Merci ! Cette recette de "base" restera dans mes classiques. Je suis en Espagne et n''ai donc pas de saucisse de Morteau, mais j''ai remplacé par des chorizo criollo et c''était divin ! ', '2015-03-10T13:42:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 25dbf5d6-74ff-44fd-abca-fa4450619143, 'Très bon mais j''ai mis trop de bouillon (1,5 c''est trop). j''ai mis peu de céleri mais j''ai ajouté du laurier et du romarin, très parfumé.  tout le monde a adoré', '2015-03-04T05:53:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 48315ba9-ae45-49b9-94bc-e71501ad4615, 'Bonjour. Je suis content car pour une première cela a été une réussite, les invités et moi-même avons trouvé ça très bon. A refaire !', '2015-02-21T04:50:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 657f3b80-9aa0-48d7-b4e6-97d81df80f22, 'Un vrai régal ! J''ai fait cuire les saucisses à la poêle et le reste en même temps dans la cocotte avec du thym et du laurier. A refaire', '2015-02-18T11:13:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, cb09d5c6-f7e0-42e1-a5fc-13a7277d9cfd, 'Très bonne recette pour l''hiver! Cette soupe a fait l''unanimité, avec du pain frais pour saucer top délice. J''avais rajouté des saucisses fumées en plus de la saucisse de Morteau! Encore meilleure réchauffée! ', '2015-02-15T15:28:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 1cb948da-0fb9-4828-a555-3c4a86051957, 'Cette soupe est devenue un grand classique. Toujours autant appréciée', '2015-02-12T18:54:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 601b2d0e-397b-40ae-8594-cf9d0ef9e022, 'Très bonne !!! A refaire.', '2015-02-12T11:08:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 60bc9028-ae54-4af6-95d5-4b5cc1d8a61f, 'J''habite sous les tropiques mais cette recette m''a, malgré les 35 degrés C, complètement charmée ! À refaire !', '2015-02-11T00:56:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, c76f0c18-d9f3-482c-8be1-48e24f760fe3, 'Très bonne recette que je vais garder et refaire en ajoutant peut-être 1/2 chou vert. J''ai beaucoup aimé l''idée des quelques pommes de Terre écrasées avec la crème pour donner de l''onctuosité. J''ai aussi précuit la saucisse pour moins de gras.', '2015-02-10T23:03:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, a56c88ed-e8f9-48d2-bb74-66f3ac2270c3, 'C''est devenu MA soupe après ski. Tout le monde l''adore ! ', '2015-02-10T19:07:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, fa8276af-f731-479d-91e2-37a04c5bbe10, 'Super ! Après un séjour en Allemagne, je cherchais une recette de soupe à la saucisse car nous nous étions régalé là bas et bien ça y est ! La soupe a fait l''unanimité à la maison. Je ne fais pas précuire les pommes de terre, je les met en cubes en même temps que les légumes et la saucisse et la cuisson est parfaite. J''en ai fait juste un peu à la vapeur à part pour écraser avec la crème fraîche.   ', '2014-10-02T19:26:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 3f6b3833-ed01-41db-826e-daca1f28cdda, 'Soupe délicieuse ! J''ai fait revenir la saucisse et les légumes avant d''ajouter le bouillon, et j''ai incorporé les pommes de terre en dés au bout de 20 minutes de cuisson pour qu''elle ne se réduisent pas en purée.', '2014-01-15T15:11:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 086643e4-2f26-4718-bc75-ab5c93bd9cb0, 'Une vrai bonne soupe d''hiver ! N''étant pas grande amatrice de céleri j''en met une petite moitié, néanmoins il se mélange très bien au reste des saveurs. Cette recette nous a fait plusieurs repas et pour le dernier j''ai mixé le tout, tout aussi bon ! ', '2012-01-19T18:39:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 7652c4d4-f600-4e7a-9e2a-76aa42302f7e, 'Vraiment très bon, long à préparer car il faut absolument faire des dès, mais dès que les invités arrivent.... plus rien à faire. Ne pas cuire plus que indiqué dans la recette, car on obtient de la purée.', '2011-12-03T17:39:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 2899380a-ff42-4f8a-90ba-bfdff9b7bfa0, 'Très bonne soupe de légumes. Seul bémol : la saucisse qui rend la soupe très grasse et qui ramollit lors de la cuisson. Je pense que la prochaine fois, je cuirai la saucisse à part pour lui faire rendre un peu sa graisse. Je l''ajouterai à la fin dans l''assiette.', '2010-03-15T20:36:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 20168c44-8178-4156-81ad-4490092b8ef7, 'On a adoré ! Moi aussi j''en ai donné a ma fille de 17 mois et elle a adoré aussi ! ', '2008-12-23T14:23:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, bf08b685-1725-4e9e-926f-adff131ce1bb, 'Très bonne recette, pour toute la famille, j''ai servi les légumes en purée à mon fils de 1 an.', '2008-12-04T21:11:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, ed45a1c3-8809-4795-a0b6-d34ab9bf6860, 'J''ai tout mixé et ajouté une boîte de haricots blanc. Mon mari appelle ça la soupe au cassoulet et adore !', '2008-11-21T12:32:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 828dbdef-14f8-47a7-9273-3b0c920ebf22, 'Je n''avais pas de céleri-rave, mais j''ai rajouté une demie-courgette qu''il me restait. Grâce à ce plat j''ai découvert la saucisse de Morteau (son prix aussi :(   )', '2008-10-30T15:10:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 4b1f3dae-e23e-4841-8054-4bc106e31515, 'Très bon, je n''avais pas mis de saucisse, mais un délice tout de même, mon mari a fait un peu la tête au début (il est plus habitué au potage), mais il en reprit deux fois.', '2007-10-23T20:05:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, f05f1bd8-012e-4048-8a5c-418f751811db, 'Cette soupe est vraiment excellente! Consistante a souhait et vraiment goûteuse ! On s''est régalé!', '2007-07-25T07:21:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, b3aca332-7feb-4737-bc47-d9f25d77ec25, 'Bonjour! Je vais passer pour la blonde de service mais la quantité de bouillon n''est pas indiquée ;-)  Bonne recette, très tradition. Hummmmm le lard fumé, j''ai ajouté un diots de Savoie en lieu et place de la saucisse de Montbelliard et 1,5 l de bouillon au pif !  Une réussite ! ', '2007-02-09T21:47:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, e58f641d-32d2-46bb-bc2c-c8540d5d2219, 'Très bonne soupe, je n''ai pas mis le céléri mais excellente, tous mes proches ont également apprécié.', '2006-11-12T19:17:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20525, 8ab6a712-13f7-4900-8cd6-627fed764c8c, 'Délicieuse soupe...Je l''ai mixée (sauf les saucisses bien sur) pour qu''elle soit acceptée plus facilement par notre fille (j''avais un peu peur du goût du céleri tout seul) Succès total, tant pour mon mari que pour ma fille... et pour moi-même! Les légumes se sont bien mariés ensemble, et le bouillon + lardons fumés donnent un bon petit goût de souplette d''hiver... La saucisse de Montbéliard ne gâche rien!', '2006-01-08T10:31:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 115cd40f-fad1-49ed-a98f-2a282d2a9e88, 'Excellent ! J''ai délayé le fonds de veau dans un peu de vin blanc, mis la moitié des pommes et des pruneaux en début de recette comme indiqué puis ajouté le reste en fin de cuisson (15 min avant de servir environ) comme déjà suggéré. J’ai également mis davantage de pommes. Les pommes et pruneaux mis en début de cuisson épaississent la sauce en fondant. Servi avec des tagliatelles fraîches. A refaire ', '2016-12-05T18:06:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, ea577f25-182e-4c8b-9ba6-3bbf236c9e83, 'Je n''ai pas mis de fond de veau, j''ai ajouté un peu de cognac et versé les pommes 20 min avant de servir. Excellente recette.', '2013-03-18T13:24:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 27d383f4-bae5-41ab-8261-db084980eff1, 'Très bon et très facile à faire. Je n''avais pas de fond de veau, j''ai dilué un carré de bouillon poulet et fines herbes acheté en magasin bio. C''était parfait, tous les convives ont apprécié.', '2008-08-25T21:31:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, e1ba25f6-e7c3-421a-a028-30e8e41cfa6c, 'Mes invités ont été impressionnés quand je leur ai servi les paupiettes ! C''était vraiment délicieux et incroyablement simple à faire ! ', '2004-09-20T13:04:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 0ea995d9-098b-4661-ad8a-490583e713c3, 'Délicieux !!!', '2022-05-26T14:51:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, faee2376-36fa-4e69-8f90-236e70b69d32, 'Recette un peu fade. Il faut relever avec épices et herbes. Quant à la pomme et aux pruneaux mieux vaut les mettre 10 minutes avant la fin sinon ils fondent.', '2019-10-09T06:38:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, cad63ac6-d808-477f-be57-124937b6d29c, 'J''ai suivi la recette. C''est facile, et le résultat est excellent.', '2016-06-02T23:02:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 2f0a787b-d2fd-49c3-af4a-12f8bf81c4b2, 'Recette réalisée et très appréciée. Facile et très bon.', '2016-03-15T20:08:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, db25f826-2054-4d30-af6e-75255a69ea7f, 'Très très bon, pommes-pruneaux-veau : un DÉLICE. Plus de pommes c''est mieux.', '2015-01-03T21:10:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 0a53df3b-0205-400a-b063-01eaa5b76288, 'Excellent, même sans fond de veau !', '2014-03-26T14:14:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 91a302c0-4fd8-4d43-8c4c-9d41899f05c2, 'Très bien ! J''ai mis 6 pruneaux, 1 pomme granny coupée 10 minutes avant la fin pour un peu de croquant...  et des lardons. Avec un bon riz basmati et quelques poivrons... Un régal :-)', '2014-03-10T23:59:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 6cdaa356-c9f5-4275-9fb9-8262d4f5b1f4, 'Excellent. A refaire. ', '2014-02-27T20:32:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, fc7a7521-c729-4c38-ad12-55b1904a91a5, 'Excellent ! Juste remplacé les pommes par des coings. Le résultat est parfait. ', '2013-12-15T09:07:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 824876cb-c524-4b26-ad28-413898571c72, 'Excellente recette.', '2013-07-29T19:51:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 98951570-e10c-40fe-90a6-b79b1561adef, 'Pour 6 paupiettes j''ai mis 3 grosses pommes et une vingtaine de pruneaux macérés au rhum. Un sucré-salé tout simplement délicieux et facile à faire. Merci. ', '2013-04-24T20:25:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 6bdf9744-21f6-4bb8-b861-66087d3eb653, 'Très simple à réaliser et tout simplement succulent.', '2012-05-17T22:35:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, eca2dedf-fa7b-4834-bc11-7e9333b0af20, 'Un régal.. à refaire sans hésiter ! J''ai seulement mis un peu plus de pommes que prévu.', '2012-05-15T23:18:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, e65ed831-427c-4702-a48e-ea8924946db8, 'Très bon. A refaire mais avec un peu moins de pruneau car un peu trop sucré à notre goût.', '2012-02-04T07:33:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 5dab7cdc-c1f5-47bf-b247-957b6d782b3b, 'Je n''avais pas de fond de veau et n''ai mis que de l''eau. Dans ce cas, il faut saler un peu. Le plat était très savoureux, rien à redire.', '2012-01-29T16:42:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 2f171908-1c64-436d-944d-14de699684c0, 'Très bon mais j''ajouterai une pomme en plus et mettrai un peu moins de pruneau, car j''ai trouvé ça trop sucré. Avec un peu de riz basmati c''est top !', '2012-01-19T22:35:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, b7758202-0b58-4c5c-95bc-d92a14998885, 'Vraiment délicieux et original avec les pommes qui sont fondantes......', '2011-12-22T18:53:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 6ac6b81d-8a70-423a-8d79-1d574dba92ec, 'Délice ! Ce mélange sucré-salé est bon à se rouler par terre ! A faire et refaire !', '2011-11-20T00:23:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 241a29ff-ab1c-46a8-822e-3be10cb71ce2, 'Excellente recette, rapide et délicieuse !', '2011-11-19T20:35:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, ae041c06-d6ed-4818-821c-dca3abff723e, 'Très bonne recette, bien utiliser des pommes acidulés sinon c''est trop sucré', '2011-11-13T13:23:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 1574ed5c-dac7-4eee-a275-0c9c1215ae55, 'Parfait, tout le monde s''est régalé !', '2011-11-04T17:01:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 6d5aac97-d87e-42eb-9811-5c589804dee2, 'Excellent !!! Nous nous sommes régalés.', '2011-10-07T15:00:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 53f04ea1-1199-4e7d-95f0-f2e4f459cb20, 'Super bon, rien à modifier, tout le monde a adoré.', '2011-09-26T14:46:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 115b4dbb-2fb6-46a3-935e-1a69a1d9df38, 'Recette à refaire avec une variété de pomme plus acide. Un plat trop sucré mais pas mauvais quand même.', '2011-05-01T16:13:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 77ae672e-3ed1-442e-9d2d-f69ba28590ae, 'Très bien pour ceux qui aiment le sucré-salé. Délicieux !!!', '2011-04-16T23:01:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 4566f4b1-4d46-49ad-b529-67af7374339b, 'Délicieux ! J''ai fait cette recette sans lard ni bacon. Même si les pruneaux et les pommes font une compotée à la fin ça ne gâche rien. A chaque fois je l''ai fait la veille et c''était très bon réchauffé.', '2010-11-15T21:04:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 8d382791-9762-4018-be5a-6c3a492d56be, 'Un vrai régal en suivant les instructions des commentaires, recette à refaire', '2010-11-07T15:11:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 2cc04848-8108-43fe-8a1f-e8b9135fa1e7, 'Pas mal, mais ne pas mettre trop d''eau et relever le fond de veau en sauce un peu plus épicée à la fin de la cuisson et là ce sera parfait.', '2010-09-11T17:11:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, b8f69626-bf37-4ecf-b4ef-ade2f8eeb26c, 'Un vrai régal ! Comme mes paupiettes n''étaient pas entourées de lard, j''ai ajouté du bacon en petits morceaux. Simple à faire et super bon !', '2010-08-30T17:44:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 6152417c-9e90-461c-8f4b-ce65f8cc9c76, 'Avec un mélange de pommes granit et golden délicieux pour les personnes qui aiment le sucré / salé  Délicieux !', '2010-03-22T09:18:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 6468d98b-0ba5-4ce3-9140-36505f3746ef, 'Très bonne recette. Je n''ai pas utilisé de fond de veau, et c''était très bien quand même. J''ai suivi les conseils : ne mettre les quartiers de pommes que 15 minutes avant la fin de la cuisson, sinon compote assurée. Recette servie avec un gratin de pommes de terre. Super pour un dîner entre amis : on peut tout préparer à l''avance !', '2009-10-17T20:45:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 965d93ff-a757-4e85-8edb-d27cffdc8cb8, 'Un régal !! j''ai fait goûter cette recette à une amie qui n''aime pas trop les mélanges sucrés-salés, elle a adoré ! Merci Candice.', '2008-12-14T11:56:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 46a7181f-b0b6-410e-af3b-9028bd9b7e71, 'Super bon! Facile et rapide à préparer ! A refaire !', '2007-05-24T12:39:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 25bb38ce-cd07-4056-9ac9-06fba30cf627, 'Je pense que je mettrais beaucoup moins de fond de veau la prochaine fois ou peut-être mon boucher a-t-il abusé du sel dans sa préparation, je ne sais pas, mais le résultat était limite mangeable...  Quoiqu''il en soit je recommencerai car je suis persuadée que ce doit être délicieux (moins salé donc).', '2006-12-17T13:43:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 30dbdb27-21af-4a2a-8aba-82d994306bae, 'On s''est tous régalés! Le pruneau mélangé à la pomme donnent un goût exquis aux paupiettes!', '2006-11-09T14:00:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, beecd17d-e741-4cdb-b84c-5669ac91da03, 'Rapide et savoureux! Recette réalisée hier, et on s''est régalés! Bien faire dorer les paupiettes en phase 1 et ne pas hésiter à doubler les quantités de pomme pour faire plus de sauce. ', '2006-04-24T17:27:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, f7bf6cbf-4c57-4720-907b-c7be6c4209c2, 'Vraiment très bon et surtout facile à faire pour moi qui ne suis pas une grande cuisinière!', '2006-03-19T16:28:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 65ae3622-4c82-4c3f-9715-801f26173ae4, 'Excellent! J''ai rajouté des pommes de terre et j''ai mis de la moutarde à l''ancienne, c''est un vrai délice!', '2006-02-18T17:31:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, f769b9cf-6441-4769-8503-45bf7fc80094, 'Bon, mais sans plus...', '2006-01-23T13:40:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 86d685ce-b2ba-4b79-9dd9-2ceeb26f82ae, 'Comme j''avais des lardons, je les ai mis dans la sauce... c''était super bon, goût étonnant; et avec des paupiettes de veau, ce plat fait très raffiné... A recommencer!', '2006-01-15T12:24:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 66fc8492-ca57-45a7-9d19-773895c6e33a, 'Décevant. J''attendais quelque chose de surprenant, et je reste sur une impression de quelconque. Beaucoup trop de sauce, mettre moins d''eau.', '2005-11-27T17:42:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 441adc41-5ffe-41bd-9b84-fd87e5f8b464, 'Muum! Pour ceux et celles, qui aiment le sucré-salé, essayé c''est l''adopté! Je n''avais pas de fond de veau, alors j''ai pris un cube dit "jumbo" et le résultat m''a plu, alors merci pour cette recette!', '2005-10-02T21:56:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, c707d972-f5fb-459b-9159-fca6bbf92143, 'Très bon, une recette que je n''hésiterai pas à refaire avec mes prochains invités.', '2005-09-24T15:43:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 4d1a6b68-1c6f-4815-845f-80b94ea704b0, 'Un mélange tout à fait délicieux qui a ravi mon homme et les amis à qui j''ai fait goûté cette recette. Toutes mes félicitations!!!', '2005-08-04T22:28:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, dd9805d0-3a16-4fb5-9000-db8b0a86c8f8, 'Très bon. Les pommes, les pruneaux et les oignons sont caramélisés dans la cocotte et se marient très bien avec les paupiettess. Un régal...', '2005-07-19T11:23:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 003ded9e-ce54-40f8-86c7-9512e098f227, 'Super recette ; je n''avais pas de pruneaux alors j''ai remplacé par une pomme rouge et 2 vertes c''est excellent et nous avons préféré les haricots verts en accompagnement.', '2005-05-12T13:55:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 3e1deaff-dfe3-418e-9e6a-f8eba64ba9c6, 'Délicieux!! Moi aussi, j''ai testé avec les paupiettes de M.P... pas même besoin de les décongeler !', '2005-03-26T20:59:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 85fc8a55-63e6-4fde-82e6-efcf4f1f1140, 'J''ai remplacé les paupiettes de veau par des paupiettes de dinde et forcément avec du fond de volaille + un cube de bouillon de volaille, un peu d''herbes de provence, sel et poivre. Mettre les pommes les 15 dernières minutes seulement. Très bon quand on aime le mélange sucré-salé.', '2005-03-14T14:03:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, c1075624-c287-41fe-844d-952f8a8edddb, 'Excellent et très facile à réaliser!', '2005-02-10T20:38:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 05a753f7-ebfc-4d11-ae9d-40160136a7f8, 'Excellent, même sans les pruneaux et les oignons ! Bravo !!!', '2005-01-15T19:56:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, d991815f-43e9-4a3b-85ec-a43c6e8842d3, 'Délicieux! Un vrai régal avec des pommes assez acides et des pruneaux aromatisés à l''orange.', '2004-12-04T17:26:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, e2e1f099-362a-48a9-852c-032aec1b236b, 'Recette originale et surtout très facile à réaliser. C''est délicieux!', '2004-12-02T22:33:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 410f0005-9891-467a-97d9-da44a9c6d55c, 'Très bon, facile à réaliser. J''ai juste rajouté quelques châtaignes et ceci en même temps que les autres fruits, juste 20 mn avant la fin de cuisson.', '2004-10-16T16:54:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 84a40ba0-9b5f-469f-ae60-39a675677440, 'Je n''avais pas de pruneaux, j''ai remplacé par 75g de raisins secs et j''ai mis 4 pommes. Je n''ai pas mis de fond de veau, mais j''ai mis un bouquet garni. J''ai servi avec du riz cuit dans du lait de coco. Délicieux!', '2004-06-13T15:27:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, aa8c9462-caa1-4c5f-be60-9246083878d9, 'Très bon, simple, rapide et délicieux. Je conseillerais juste d''ajouter les pommes que le dernier quart d''heure de cuisson pour éviter de les voir se transformer en compote.', '2004-05-25T19:03:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27994, 780e83e0-4ad0-46af-b2b0-56447221ae2d, 'Excellente recette, facile à faire, toute la famille a apprécié.', '2004-05-14T22:53:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 6bd83392-160b-4b23-a319-b876a96c42c7, 'Très bonne. J''ai suivi les commentaire et j''ai mis à l''étape 1 : 100g de farine  et 50g de sucre avec 4 pommes.
À l''étape 2 j''ai mis 80g de beurre pour 40g de sucre.

Le gâteau à fait l''unanimité (adultes et enfants) 
La double cuisson lui donne un petit côté caramélisé. Un délice. 
Je garde bien la recette de côté pour le refaire.', '2020-10-13T22:38:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 043beacb-9a36-4ece-be9b-2bcc62a4ac70, 'Il faut mettre des morceaux de pommes dans la pâte, et pas seulement au dessus façon tarte sinon c’est trop sec. Un peu plus de sucre peut-être ? Ou un peu plus de pommes ! 
Glaçage très bon. ', '2022-02-06T19:52:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 955fe927-5adc-4bdb-9c2a-5f9e098ef51d, 'Jai doublé les doses pour avoir un gâteau bien haut', '2021-02-16T17:39:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 591eb037-6b68-4a58-bdd5-d84fba11efb5, 'Super Une vraie réussite à chaque fois Le meilleur gâteau maison Pour la première partie Cinq pommes 100 g de farine 50 g de sucre Pour la seconde partie 80 g de beurre 40 g de sucre', '2020-09-25T13:00:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, e9512d81-a93b-4556-aff5-a5768731bb25, 'Très bon, étrange la cuisson de la deuxième partie qui fait des bulles au four mais au final c''est très bon. Un peu trop gras même en réduisant les doses, n''hésitez pas à modifier en fonction de vos goûts.
À enlever du four avant que ça devienne trop foncé !', '2020-03-29T19:59:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, a211586d-e57e-48ad-b98e-10b3e3ab0260, 'C''est bon, mais très riche… Utiliser un grand plat.', '2022-09-30T18:08:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, f8cca5be-962b-4ecb-8a61-224ce9e3266f, 'Super ', '2022-05-24T19:13:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 6e20f1d6-69b4-4c87-94ab-520c9e4ffcf6, 'Malgré les doses aléatoires des cuillères à soupe, je baisse un peu les doses de sucre et de beurre pour le glaçage. Même la belle mère est fan !', '2021-11-17T18:25:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, c2569a28-070f-47bc-b3e5-016e1d054ae7, 'Nous on adore, mais pour la 2ème partie de la recette je mets 1/4 de beurre de moins, idem pour le sucre ', '2021-02-21T21:42:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, ccfc72da-ef99-4a8c-8079-1786c30c82d5, 'Un nouveau grand classique à la maison ! Voici les modifications que j''ai réalisé à la lecture des commentaires: 5 grosses pommes + 70 g de farine + 45 g de sucre. Pour la 2ème partie, je mets 80 g de beurre et 40 g de sucre. Avec ces proportions, le goût du sucre vient surtout des pommes.', '2020-01-29T11:05:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, e2a2e055-ac15-43be-bdca-c138a4324b41, 'Je tiens pratiquement la même recette de ma belle-mère, qui la tient de sa mère, ou tante je ne sais plus.
C''est un des meilleurs gâteaux que j''ai mangé.

Pour la première partie j''ai : 12 c.s de farine, 6 c.s de sucre, 6 c.s de lait, 4 c.s d''huile, 2 oeufs, une pincée de sel et un sachet de levure chimique.

Pour la seconde partie 80 gr de beurre fondu, 3 c.s de sucre, 1 oeuf et des amandes effilées.', '2018-04-12T07:39:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 87d90462-1294-456f-946f-c8a33e5f652e, 'Ce gâteau est beaucoup trop sucré ! je l''ai refait avec la quantité de sucre divisé de moitiée c''est largement suffisant !!', '2018-04-09T13:38:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, d2fde074-fbd5-4d66-a67a-e86dc20d4103, 'Gâteau excellent, personnellement, je remplace le tiers de sucre de chaque partie du gâteau par de la poudre d''amandes, à tomber !! et moins sucré du coup...', '2016-10-14T14:25:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, d1b3a5eb-e81b-4565-b3ed-5c26487c08a8, 'Très bon mais pas extraordinaire non plus. Gâteau moelleux, j''ai mis beaucoup de pommes car j''aime ça.  Par contre, un peu déçu de la 2ème préparation,  elle n''apporte pas ce que j''espérais. J''ai suivi les conseils et mis moins de beurre et de sucre.', '2015-10-23T18:37:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 4f350b9a-e46a-4c95-ab76-6e17c535fd64, 'Depuis le temps que j''entendais parler de cette recette, et de la fameuse petite couche croustillante... Alors effectivement, ce n''est pas léger, mais qu''est-ce que c''est bon! Je l''ai fait avec trois pommes, en divisant toutes les autres proportions par deux, et c''était très bien. Merci Gloria !', '2006-02-23T17:21:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 7c380ec1-16af-4c5b-a3a6-928578c9ab62, 'Inbouffable !!! Un gâteau à l’huile et au sucre!! Passez votre chemin sur cette recette!!!', '2023-10-28T19:48:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 2abba10a-26e3-46e3-b5e5-dde324558ad6, 'J''ai ajouté un peu de liqueur.', '2023-10-26T16:22:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 2a6517d7-dac3-4465-a51d-f7cfdb972c6f, 'Très bonne recette, j’ai diminuer un peu les doses pour le glaçage et à  la place du sucre j’y ai mit du caramel et j’ai fais revenir mes pommes avant. 😋', '2023-09-22T19:09:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, b575be05-5e04-491b-99b1-8cf9dff2cecf, 'Excellent... 
Ma famille en redemande, ils adorent.
J''ai juste un peu diminué les doses pour la deuxième partie moins de beurre moins de sucres et un vrai régal...', '2021-05-02T15:22:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 538cf772-b1ec-409e-80d8-838ecf907d9e, 'Les doses de beurre et de sucre sont gargantuesque, j’ai l’impression de manger la plaquette de beurre, on ne sent plus le gout des pommes. Faire attention aux doses
', '2021-02-04T21:42:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 4689bed3-8fb5-4dff-9a8f-9b7c56236302, 'Je réduis la dose de sucre et c’est une tuerie, gâteau inratable, simple, et qui plait vraiment à tout le monde !', '2021-01-25T16:03:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 14660458-bf83-4e6b-bbf0-cd760b870a62, 'Pour ma part, je n''ai pas mis la deuxième partie,  c''est déjà bien sucré et bien gras..à moins de remplacer le beurre par de la crème fraîche légère pour la 2ème partie...il refroidit donc pas encore goûté. 
Par contre, j''ai doublé les doses pour la pâte sinon pas assez pour remplir le moule..dans la recette la dimension de celui-ci n''est pas indiqué !', '2020-11-22T08:15:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, fd956688-fdb4-40b6-bac3-9c2b7aa4b3ad, 'Meilleur gâteau aux pommes ! Vraiment délicieux ! ', '2020-11-07T22:21:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 3fa81bfb-22d2-4de5-91ae-75e673854e79, 'Vraiment top cette recette !', '2020-11-01T18:08:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 48b27611-bcca-4488-8f91-a1d20c7c4d6d, 'Délicieux. À faire aussi avec des bananes !! ', '2020-08-04T23:34:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, a3b026e3-1724-4fac-bb5a-9a6b150b16a0, 'Très très bon ', '2020-05-29T11:58:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, e6a1008e-4086-4cd3-82a8-aa47201ccb4a, 'Très bien et très bon.', '2020-05-16T11:44:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 15479b01-009e-4aa7-82ad-a8901e6a2293, 'Excellent ! A faire absolument.', '2020-04-10T19:01:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, ccbb1b66-c61a-4634-b914-53289764826c, 'Délicieux ! J''ai fais quelques modification après avoir lu des commentaires: Pour la première partie j''ai mis 5 pommes + 12 cuillères à soupe de farine + 6 cuillères à soupe de cassonade et pour le reste j''ai respecté la recette (lait, huile, oeufs). Pour la 2ème partie: 80 g de beurre + 40 g de cassonade + un sachet de sucre vanillé et des amandes effilé par dessus tout ça ! Un Régal !', '2020-04-09T16:47:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 8a4f5e35-0fa4-4ab8-b6b9-d3527a36c3b5, 'Excellant', '2020-04-03T23:52:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, e30cca96-d920-41a3-8bb8-39987fb7a6db, 'J’ai cuit les pommes avant dans du beurre et légèrement sucré. J’ai suivi la recette mais j’ai mélangé la moitié des pommes avec la pâte et ensuite j’ai déposé le reste des pommes sur la pâte. Pour la seconde partie j’ai mis 1 demi verre de sucre et ce gâteau est vraiment délicieux tout le monde a adoré. À refaire.', '2020-01-25T05:49:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, d696d1c5-4c31-4db3-b2d0-f78f7206efe1, 'Excellent. Je n''arrête pas d''en faire, tout le monde en demande et en redemande !', '2019-09-07T09:35:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 4643acc1-a404-47e3-b8a6-af71b9dd82e9, 'Gâteau aux pommes Golden facile et rapide', '2019-06-20T22:38:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, eb7a7ba9-afae-469e-b23d-a94a38cbd86c, 'Gâteau fait pour le travail de mon chéri. Il a fait un tabac ! Je n''ai même pas pu le goûter, ils ne m''en ont pas laissé !
Grâce aux commentaires, j''ai suivis les conseils : seulement 75g de beurre, 1/2 verre de sucre et un oeuf pour la seconde couche.
Merci pour la recette !!', '2019-04-30T03:27:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 7b89c9a0-508c-47a1-947a-f8f0d0450d2a, 'J''ai rajouté 1 cuillère à soupe de rhum ... Délicieux !', '2019-02-04T07:40:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 4e72ae2a-8433-43cb-8ce2-85fe61eaf526, 'Très bon !', '2019-01-09T14:55:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, fab7e542-317d-41eb-b349-4afa4131265b, 'Très bon, j ai suivi les conseils pour le deuxième temps et mis que 80 g de beurre 3 cuillères à soupe de sucre et 1 oeuf. 
C''est super moelleux mais je me demande si ça peut pas être un peu moins gras. J''essayerai avec un peu moins de beurre sur le deuxième temps. Mais ça va devenir un incontournable des goûters. Les enfants ont dit que c''était le meilleur gâteau de la galaxie !!', '2018-10-20T07:11:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 598d8b41-9493-4ea5-87a5-c3a3c72cfbaa, 'Hyper sucré et le gout des pommes a disparu, c''est dommage.', '2018-10-06T23:27:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 1057d95c-9825-4b92-b511-6a3077d07ed9, 'Un pur délice !!!
À faire sans hésiter...

J''ai suivi les conseils en commentaires et ai ajouté 2 pommes, le gâteau était extrêmement moelleux.
Puis pour la seconde partie : 80gr de beurre, 3 cs de sucre, 1 oeuf et des amandes effilées.

Viiite que je le refasse car toute la famille a adoré !', '2018-09-02T10:18:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 239e9092-376a-4d76-a995-b78bad3a74da, 'Simple et succulent ! Rien à redire, une touche de rhum peut-être?', '2018-08-18T07:51:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 3e5a7b4a-6706-4c6d-b480-f01e05f75f82, 'Excellent la première partie fait exactement comme la recette.  Et la deuxième moins de beurre et sucre et 1 oeuf un vrai délice. Très Mouelleux.  acajous974', '2018-07-01T06:31:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, ae38655e-1f10-4c7d-9ea2-f124c65aee64, 'J''ai également mis la moitié du sucre préconisé cependant je pense que c''est le meilleur gâteau que j''ai jamais fait. Merci pour la découverte de cette recette !', '2018-06-01T09:34:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 045a4c5e-73a1-44f9-8e85-02e0a6214231, 'Gâteau délicieux !', '2017-11-09T10:30:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 77eab936-7b66-4b99-b33c-c916a6c250d3, 'Mon homme, qui n''est pas gâteau, m''a dit que c''était le meilleur gâteau qu''il ait mangé !  Et même moi qui préfère les gâteaux au chocolat, je me suis régalée ! À refaire .. ', '2017-02-10T23:53:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, b281d7eb-c5c9-4ba2-9bf7-1a263433377c, 'Très bonne recette. La prochaine fois je n''hésiterai pas à mettre plus de pommes surtout dans le fond de la 1ère préparation pour rendre le gâteau encore plus moelleux.', '2017-02-05T10:03:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 0be7d0d9-a17a-4ae8-a697-66a969543029, 'Excellent!', '2016-10-08T22:00:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, d5a6d27f-3544-4c3d-9a93-92b0b7a43c18, 'Un délice ce gâteau!!! ', '2016-09-20T21:57:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, d1c604d0-0c76-4790-80e6-4b3f441bbd92, 'Excellent ! Je le referai.', '2016-01-31T22:46:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, a5f73621-b3d0-440a-83c1-f307aba146d4, 'Très bon, mon mari a reconnu le gâteau tupperware de sa maman...', '2015-11-11T14:25:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, e51484e2-3d1b-406c-99da-f926309a0c35, 'Beaucoup trop sucré tel quel, à réessayer avec les quantités de la 2nde partie divisées par 2 !!', '2015-10-10T16:02:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 383e51b2-1c12-43df-b10b-ebc7d6bff1ae, 'Très bon et moelleux. J''aurais juste tendance à mettre un peu moins de sucre mais c''est un détail et suivant le goût de chacun.', '2015-10-03T19:37:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, e3b24394-e64d-413b-aeec-d1093692a013, 'Un vrai régal !', '2015-04-25T16:58:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 46e0b638-35da-43bd-9a41-16bf6cb9b33e, 'Une tuerie ce gâteau ! je le referai !', '2015-04-25T11:40:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 4d238b43-5aff-41f3-89fa-2ec395249dfb, 'N''ayant pas de sucre blanc, je l''ai fait avec moitié sucre roux/moitié sucre vergeoise !! Trop bon !! Je ne regrette pas et je conserve la recette !', '2015-03-22T21:34:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 0e75e16b-ef2f-4a16-8f21-50be21750b61, 'Un peu moins de sucre dans la 1ere partie avec une cuisson à chaleur tournante 25min puis un seul oeuf avec 100g de beurre et 2 cuillères à soupe de sucre suffisent pour la 2eme partie pendant 15 min. mon ptit plus: je rajoute des amandes effilés sur le gâteau avant de verser la deuxième partie un DÉLICE', '2014-11-08T19:24:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 7bc87aa8-2364-4cb2-a44b-9f09e4f38d1a, 'Je l''ai fait en respectant les quantités et même si j''adore la texture, c''est trop gras et trop sucré à mon goût. je vais donc le tenter en diminuant de moitié les quantités de beurre et sucre de la deuxième partie comme certains d''entre vous l''ont fait... merci en tous cas pour cette recette moelleuse !', '2014-11-06T22:35:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, ba03332b-b3f3-4cba-9e04-9840538aa2e3, 'Moi je l''ai trouvé sec, pas du tout onctueux', '2014-10-29T10:57:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 45a97caf-63b1-40eb-a8f5-341320100bad, 'Je le fait avec toutes les quantités divisées pas 2 et on l''appel le 5 4 3 2 1 (nombre de cuillères des ingrédients principaux) Ici c''est devenu LE gâteau aux pommes !', '2014-10-08T12:55:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 75eab993-5375-4424-a71a-c65e4d730f98, 'Excellent ! On n''a pas l''habitude de manger les gâteaux aux pommes sous cette forme là et après avoir essayé cette recette je ne ferai plus que ce gâteau aux pommes. Miammmm', '2014-09-30T16:13:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30173, 2079fbde-026b-4d07-ae00-e1154ce9da67, 'Change de l''ordinaire, très bon !', '2014-09-20T13:02:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 0ac17a62-db1c-4b8d-9bcd-2a90e4c6543c, 'C’était vraiment délicieux. J’ai également doublé la marinade', '2022-04-05T21:25:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, c20a4335-522e-4313-b571-457a2ab58326, 'Mon avis n''est pas très consensuel, mais j''ai été très déçu par cette recette. Tout d''abord, j''ai trouvé le fait d''enlever la peau assez suspect: ce qui fait la richesse d''un magret de canard par rapport à d''autres viandes, c''est bien de le cuire dans sa graisse ! La marinade est facile à faire, mais n''apporte pas grand chose par rapport à faire cuire le magret badigeonné de miel et avec les échalottes revenues dans la poêle. Le résultat final est correct, mais on peut tellement mieux faire avec un bon magret de canard!', '2024-01-14T04:30:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 854fd31c-f455-4aa9-98a3-77502792f353, 'J''ai doublé la marinade car il n''y en avait pas assez à mon goût. A part ça rien à redire la cuisson est parfaite et le goût est là.', '2019-07-15T15:26:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, e206b019-32e9-4f8d-937f-e4c293c4373b, 'Très bon,  mais doubler ou tripler la quantité pour la marinade, 6 minutes par face était bien pour un magret tendre et rosé, on l''a accompagné de semoule de couscous ', '2015-11-29T15:30:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 5791240f-7b83-4e8f-80fc-6b76d369c80e, 'La même recette avec des pêches est sublime !', '2014-09-18T12:35:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, b195dc5a-88e6-4c27-a146-d8ea1fd3e39b, 'Même recette avec des poires. Je trouve que le goût des poires rend ce plat plus raffiné en goût.  ', '2013-01-22T13:09:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, c426568b-6745-4d2a-b253-69f5c0513523, 'Très facile à faire et très bon avec un vin de madiran', '2022-03-14T17:07:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, ec2723d2-edf4-4798-8b77-8c7099be4d4c, 'Un délice ', '2022-02-08T19:43:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 76903a51-ca5e-44fe-93ca-74fa0a641fdc, 'Super recette !', '2021-11-26T23:22:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 2b108f74-12bd-407b-9997-479b5fc56937, 'Nous avons adoré vraiment à refaire. Merci pour cette idee de recette ', '2021-08-29T14:43:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 3f5c21c2-0183-4172-a798-6f3893ee5e64, 'Excellent oui étonnant pour du magret mais ça se marie très bien', '2021-07-19T21:34:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, e9dabf17-3d28-40a1-9c3d-3a49bf8a45f2, 'Excellente recette 5 minutes de chaque côté j''ai doublé la sauce on s''est régalé', '2021-07-16T07:36:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 8ea32aa6-4a71-411b-9f50-a46938ee8f38, 'Temps de cuisson sous estimé pour un grill réglé à 190°. Mais très bonne recette.', '2020-12-19T15:43:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 2ff2da42-7ac9-4c61-b699-2d40cab2c4c1, 'Fait plusieurs fois, j''adore, de même que mes convives.', '2020-02-23T12:42:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, a6cc6492-ed90-444f-afbf-57ecb55dc01f, 'J''ai aussi coupé en tranches (biseau) et doublé la marinade, sauf les échalotes et cuit à la poêle environ 5 mn par côté (je n''aime pas saignant, excellent avec des pommes fuji (qui ne se défont pas à la cuisson).', '2020-01-01T19:08:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, a72630e3-6c5c-49d4-8255-9d4729eb6020, 'Très bonne recette, je n’ai rien modifié, c’etait parfaitement cuit.', '2019-04-18T12:04:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, f7caa656-a865-4b95-b456-2d70f0dcddb9, 'Rien de spécial, même en faisant plus de sauce. Quel dommage d''avoir utilisé de bons magrets pour ça.', '2018-09-06T03:05:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, bbc75517-07e8-4a2b-998f-176fbffff8fc, 'Un super mélange, salé sucré et un peu d''acidité de la pomme !', '2017-12-14T13:27:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, a2c0d9b5-36f8-41dd-a960-6895cea7f615, 'Un régal... J''ai ajouté du cognac et des échalotes aux pommes et coupé des "tournedos" dans mes magrets.', '2017-03-29T06:55:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 093ee43a-779b-4c11-bdeb-81e9e77c8c3b, 'Prévoir un peu plus de temps de cuisson des magrets même si on aime saignant. ', '2017-03-12T13:05:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 11b2a394-1ced-473a-9e4d-30870b5e8cd9, 'Recette au top ', '2017-01-02T01:55:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 995d2eb5-71b0-4385-8aba-ae952fe54f36, 'Très bonne recette mais il faut faire des tranches ( surtout si les magrets  sont épais) avant de les mettre dans la marinade ! ils cuiront plus facilement. je rejoins les autres commentaires il faut doubler ou tripler les pommes le miel etc . les laisser les mariner 1 heure ou plus si vous en avez la possibilité. ', '2016-02-14T00:33:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 67901216-ccd1-43fe-92a6-b16827eb771e, 'Je confirme les remarques sur le doublage des ingrédients de la marinade, utiliser d''autres pommes; compter plus de temps pour enlever la peau.', '2016-01-09T12:11:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, b31481eb-c0d4-4fab-a180-3be04028ecef, 'Cuisson parfaite pour les magrets, très tendres et pas gras, super digeste avec les pommes. A refaire !', '2015-12-19T20:32:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 277e03d2-4f0f-465c-8c7e-c4e1d5559705, 'Tout simplement excellent. Fait en suivant les conseils dans les commentaires précédents. ', '2015-11-08T00:38:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, e639ba76-098e-49fd-906f-6b745a0b70b7, 'Quasi divin ! Merci pour cette recette. Par contre, quand on n''a pas l''habitude, prévoir 1/2 heure de plus pour la préparation : enlever la peau n''est vraiment pas facile si on ne veut pas blesser la viande !', '2015-05-16T22:36:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 94b5a655-9569-42d7-af76-c4c5d91e141d, 'Très bon mais je confirme que 5 min de cuisson par face suffisent amplement. Il faut également au moins doubler les doses de vinaigre et miel si l''on veut avoir une quantité correcte de sauce... ', '2015-04-13T12:42:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 18a979a3-0f87-45ac-bdb8-fef5bb2896a5, 'Je viens de faire la recette qui nous a beaucoup plu mais je la referai en réduisant un peu le temps de cuisson car le coeur n''était pas assez rosé à notre goût, mais c''était quand même très bon.', '2015-01-29T16:21:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 857547fc-5672-4041-9e02-8629da47e22f, 'Excellent pour le réveillon de Noël. Même les enfants ont adoré !', '2014-12-26T21:32:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 11cad51d-d1a8-4478-938a-5928e36ca7e2, 'Plat testé pour un Noël en amoureux et extrêmement apprécié, c''était un vrai délice ! Comme indiqué dans les précédents commentaires, ne pas hésiter sur la quantité de vinaigre balsamique pour avoir suffisamment de sauce et réduire le temps de cuisson des magrets à 5mn par face. Merci beaucoup pour cette recette ! ', '2014-12-25T23:50:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 41628897-3374-4665-a06d-272154256868, 'Parfait ! J''ai remplacé le miel par du sirop d''érable, ça marche très bien ! Merci pour cette recette ', '2014-12-25T19:31:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 0ea644f1-315f-41ce-adad-bf7e3d3b3ad3, 'Facile pour un résultat satisfaisant', '2014-10-23T20:33:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 3155e93d-1085-406c-a752-d6f3618697ad, 'Recette faite pour un diner à 4 ! Tout simplement délicieux. Les invités étaient ravis et moi aussi ! J''ai fais la cuisson en deux fois : 5 min puis 10 min juste avant de servir. Accompagné de tagliatelles de legumes.', '2014-08-10T18:14:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, c2f9a63d-2b77-4e2f-a860-731a526c2798, 'Excellente recette, viande succulente, réduire temps de cuisson (5mn de chaque côté). J''ai cuit les magrets sans la marinade que j''ai faut chauffer à part, sauce sirupeuse et pas grasse. Mon mari et mes amis se sont régalés.', '2014-07-16T16:18:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, d2e38dae-108a-4bc7-b52a-9c67073a0544, 'Fait pour la Saint-Valentin, mon homme s''est régalé ! Facile à réaliser, je ne suis pas un cordon bleu et je l''ai épaté ! ', '2014-05-27T18:31:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 52ef468d-7449-4abd-8db9-e041cab6d4c5, 'Plat simple à préparer et recette plus légère que les magrets que j''ai l''habitude de manger. J''ai mis plus de vinaigre balsamique et plus de pommes. Je la referai !', '2014-04-29T15:19:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 2685095e-63da-4554-9702-8db0e29d9dde, 'Très bonne recette effectivement. En ce qui me concerne, j''ai ajouté du thym à la marinade qui se marie bien avec le miel et la pomme. Pour ce qui est de la cuisson, je les ai poêlés un temps max de 3 min chaque côté et ensuite laissés reposer entourés d''aluminium afin que la chaleur se répartisse bien. Résultat, viande rosée à souhait pour celui qui aime évidemment.', '2014-03-16T15:32:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, eb689622-967e-411c-8ab9-5ae2f3181f29, 'Rien d''exceptionnel.', '2013-12-04T17:11:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 8c6ae135-a460-442a-80e3-2bf55ce5062c, 'Très fin, vraiment original et qui reste léger du fait de l''accompagnement avec des pommes. Cela change des pommes de terre ou autre féculent. Ce plat a été vraiment très apprécié et a eu du succès pour un repas dominical en famille. Prévoir plus de vinaigre balsamique pour qu''il y ait plus de jus, et plus de de pommes pour ne pas rester sur sa faim car elles réduisent beaucoup et sont très vite englouties tellement elles sont bonnes!', '2013-11-10T15:19:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, f2524007-c697-4a7e-a333-d75ab77d9c9f, 'Recette excellente... je l''ai suivie à la lettre. Raffinée et pratique quand on reçoit du monde !', '2013-11-03T19:09:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, f5da4352-f0a5-4ad2-9ee3-f25d0071f556, 'Très très bonne recette ', '2013-10-27T20:06:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 12a8fd06-ad0d-4ce8-ac52-919d14d48c9d, 'Très bonne recette faite pour le baptême de ma petite nièce (30 personnes environ). Parfaite pour un grand repas facile à faire. j''ai juste fait cuire les magrets sans marinade et je l''ai fait réduire à la casserole pour faire un cordon de sauce dans l''assiette. J''ai suivi les conseils précédents et réduit le temps de cuisson. ', '2013-06-30T02:28:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 51c37c21-28f6-41a3-a22e-fe6f5938485f, 'Très bonne recette mais avec des pommes flambées au rhum ambré, cela donne un très bon sucré-salé.', '2013-05-02T23:34:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, a8b0d456-02e2-4af7-ad2d-7652d4c1940e, 'Un vrai délice. ', '2013-03-04T23:37:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 73c9d0ff-7457-4c66-8612-4d3037b45ff6, 'Merci pour cette recette. C''est excellent. ', '2013-02-22T06:39:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 1b4d1f3e-3244-4aa8-975d-2762c156469d, 'Facile à faire...apprécié par petits et grands...un vrai délice', '2013-02-19T04:17:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 472b0a31-70cb-47df-bc5f-3662d9db5fec, 'Très bon avec cette marinade. Les pommes accompagnent très bien le magret ! Dommage que la viande refroidisse très vite...', '2013-02-07T13:51:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 239cdda1-7a17-41e2-9770-aea7586ef6a0, 'Merci pour cette super recette, cuisson au four parfaite', '2013-01-06T23:17:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, c309935d-e6b7-438e-be3e-48026b29997b, 'Surtout ne pas oublier de faire mariner le canard (j''ai utilisé des filets). Ce serait pas mal de mettre un peu de sucre sur les pommes pour lever l''acidité.', '2013-01-05T21:45:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 81b74cc9-e73d-4596-a289-34e2fdcef8b7, 'Très très bon, laissé mariné 8h, et préparé avec des Goldens (le double de la quantité indiquée). On en refera !', '2013-01-05T20:21:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 1cb6ede8-9a82-46e8-91f4-83d6b2f225a5, 'Bonne recette mais le magret est trop cuit avec 14 min au four', '2013-01-03T11:55:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 412ef7e6-2bdc-4810-80fa-6c7ce40a8f20, 'Très bon, moelleux et vite fait. A refaire', '2012-12-31T12:12:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, b80b3fc8-a9af-4c99-8a7a-0312db0e0ba4, 'C''est très bon mais attention à notre pas mettre trop de poivre !!!', '2012-12-30T18:52:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, eb04fbe7-3a1b-40c1-a7a0-9826a5e540d5, 'La meilleure recette de magret !! Je fais en plus des rostis de pommes de terre ! Excellent', '2012-12-29T19:43:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 01fb5acd-1679-4041-b775-0f3ee871ef06, 'Délicieux, effectivement il faut doubler voir tripler les doses de la marinade !', '2012-12-29T18:16:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, a365706c-845f-4d1e-adf3-2a400f66c0cb, 'Très bonne recette. 12 minutes de cuisson me semble plus appropriée.  Je la referai avec des goldens car les boskoops fondent. ', '2012-12-28T12:02:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 265683b3-95db-4f28-8334-cdef3606f070, 'Testé avant Noël approuvé par la famille pour le menu de Noël 2012 délicieux ', '2012-12-08T21:35:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 9a49d671-522a-49b5-bae1-b3ccb5d29e6b, 'Le mélange miel - huile balsamique n''a pas plu. ', '2012-12-05T13:13:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 5a1e69e4-e254-4086-a37b-7981285ac083, 'Recette sympa avec 8 pommes et 30 g de beurre. La cuisson 5 min de chaque côtés suffisent sinon c''est trop sec. ', '2012-12-02T19:59:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13686, 20b726b0-a29c-436d-984a-c45f73c2b73d, 'J''ai essayé, c''est très bon et pas gras du tout. Je le conseille.', '2012-12-02T19:44:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 85fd8a68-4951-471b-9226-d1483b5cc082, 'J’ai ajouté des lardons fumés que j’ai fait au préalable à la poêle…. Miiiaaaammmm !!!', '2022-06-07T20:44:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 08db4f60-889f-4652-8572-6420e4132644, 'Nous nous sommes régalés en famille (enfant 2 ans), j’ai fait une version végétarienne pour moi en mélangeant oignon et blanc de poireau, et pour les autres j’ai laissé le jambon à la moutarde + le mélange oignon/poireau. Très bien !', '2022-09-12T18:11:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, bbce2e22-a702-4aab-b5ed-d7b4475b526e, 'Super recette j’ai remplacer le jambon par des émincée de poulet et remplacer le lait par un yaourt nature mélanger à la crème et sur le dessus du reste de fromage à raclette de la veille 😉', '2021-03-30T20:24:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 55b35fc1-fdfc-49b6-bc02-72071ac8e515, 'Excellent ! J''ai suivi les conseils et enlevé le lait à la fin, en mettant uniquement de la crème fraîche (environ 50mL) et du fromage râpé par-dessus. J''ai rajouté un reste de carottes cuites en rondelles au milieu du gratin au lieu des pommes de terre, cela se marie très bien. Excellente idée de rajouter de la moutarde au milieu ! J''ai également agrémenté d''un mix d''épices italiennes au milieu (ail, herbes, piment).', '2020-04-12T16:41:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 795d676b-1c60-4a6b-9ed1-d1bfc2484870, 'Valider par ma femme et mon fils ! ', '2014-05-25T19:44:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 09f9784e-2444-4269-bd25-594fb801b2bb, 'Très simple à faire et super délicieux merci !!', '2023-08-26T10:24:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, efb43d91-b2c4-410e-b718-965326e35ddd, 'très bon à refaire', '2023-04-09T12:49:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 48578eac-c375-4c44-90c4-116e3dd4471f, 'j''ai mis de la crème de soja et la même quantité de lait. Du coup trop liquide mais le plat était bon et facile à faire.', '2022-04-19T15:31:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 779fae3d-f6f0-498c-8632-6de8c3c9725c, 'Excellent, absolument excellent ! Merci pour l''auteure de cette recette simple, facile à réaliser et délicieuse avec une bonne salade verte', '2022-04-06T12:57:27+02:00');
