INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 373efcea-5ca9-4775-a399-532c6e462153, 'Excellent ! J''ai utilisé des champignons et du poisson surgelés que j''ai décongelé quelques minutes aux micro-ondes ! 
