INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, e621bdb1-f6a8-40a2-b136-39acf348d2dc, 'Simple, efficace… et surtout excellent.. je recommande!', '2023-02-22T19:06:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, a41b5dc8-e966-49df-9f82-56903be02bbb, 'Le cake est bon mais le sirop le rend beaucoup trop sucré. Je réduirai la quantité de sucre dans le sirop la prochaine fois.', '2022-12-22T18:22:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, ba537dbb-9ddb-44b8-8307-2ccf0e94299a, 'Très bon, juste un peu trop sucré ', '2022-07-09T10:12:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 32df7489-e2a0-401f-ad1c-266788039997, 'Une excellente recette, je gagne du temps et le résultat est identique en battant les œufs en omelette ! Temps de cuisson à revoir 40/45 m, th 200', '2022-06-19T08:12:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, c9b8007d-f973-4a77-8bc6-f8b7e1a92b8f, 'C’est la meilleure recette de cake au citron! Facile et très bon! Il suffit de suivre la recette à la lettre.', '2022-05-07T19:32:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 599470a3-8f01-4a19-bafb-93f183d09bf1, 'Super cake ma famille a adoré mon père veut que j''en refasse et ma mère en a repris', '2022-02-18T17:07:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, ea4abc42-4846-42b9-860c-9eb822978f67, 'Frais facile trop bon ', '2022-07-15T13:31:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 471b5997-6990-4496-bfa5-3da8bb2b098c, 'Malheureusement, j''ai dû jeter ce mélange de mascarpone et de crème fraîche, qui n''a pas fait de crème légère genre chantilly, mais s''est transformé immédiatement en beurre avec les premiers coups de fouet... Pour éviter cela, vous pouvez mélanger le mascarpone à un jaune d''œuf, puis au blanc battu en neige.', '2019-12-25T07:32:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 6c5931e9-0009-484f-965c-28ca77bd73ba, 'Comme nous n''avons plus de fraises au jardin, je l''ai fait avec des cerises. Recette identique, sans les pistaches, mais avec une chapelure de biscuit sec et quelques éclats de cerises. Termine très bien un repas léger d''été.', '2019-06-14T01:18:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, ffc4a89c-6ce1-4cd0-9547-9339e89b7b95, 'Superbe recette qui a beaucoup plu !
Merci pour cette petite douceur.', '2017-08-24T22:20:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 5172ed21-f60d-4a1c-a862-bcf1ece4163b, 'Merci', '2017-03-16T08:59:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 254e4595-9558-4dec-a7a2-d67a70b008fa, 'Au top, vraiment une super recette, rien à changer ', '2016-06-26T19:02:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 6a6c0fe5-be0d-413c-9df8-8fe88dad94ec, 'Excellent et facile à faire !! Pour gagner du temps, j''ai tout préparé à l''avance dans des ramequins, j''ai aussi coupé les ronds de glace que j''ai remis au congel, du coup ça m''a pris 5 minutes au moment de servir le dessert.  Ne rien changer, c''est frais et délicieux !', '2016-06-16T12:25:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 1f8db987-8eaa-49b7-8a8b-92ea43f75662, 'Un dessert facile à réaliser. A faire et à refaire à la saison des fraises. Très frais et léger après un repas, se laisse manger sans faim (fin) !', '2016-06-08T00:37:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 0ac2948f-8247-4063-9df7-85f72705dd7b, 'Excellent et facile à faire. Je mets un peu moins de sucre dans les fraises.', '2016-05-29T08:25:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 7e192b28-52cb-4249-85c1-65cd55471789, 'C''était simplement délicieux ! ', '2016-01-24T12:39:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 100a9d3b-c765-426e-8bb7-c63c6c49fd96, 'Délicieux, j''ai fait une chantilly maison et j''ai mis des morceaux de spéculoos au dessus et au dessous !', '2015-07-12T21:03:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, bd39032f-8363-4e2c-a952-b488a7099a13, 'Recette facile à faire et délicieuse . Aimée par toute la famille . A refaire ', '2015-07-09T20:20:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 8ff50ba8-c66d-48cf-b3bc-2dba5068445e, 'Juste sublime simple rapide a faire tout ce que j''aime j''ai épaté mes invites tout le monde m''a demande la recette en cette forte chaleur très apprécié...', '2015-06-29T16:31:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 1af1861b-9160-4b69-b276-d2cd6ceb9548, 'À essayer aussi avec la glace au lemon curd de Mme Pi...d = une tuerie ! ', '2015-06-24T10:54:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 870bf1a8-ed38-4653-92e0-0664b306be67, 'Moi je prends de la glace à la vanille et je rajoute des pépites de chocolat c''est excellent ', '2015-06-23T19:03:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, ec73103e-7dbf-4f03-9ba8-977e1e4123cc, 'Que des compliments pour ce moment de bonheur merci de nous le faire partager plutôt que de le garder pour soi !! on en redemande des recettes simples à la portée de tous ne soyez pas avares les autres "marmitonnes" lorsque vous pouvez nous en apprendre d''autres pas compliquées bon été à tous ', '2015-06-23T18:04:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, e47a3901-77a3-4f56-a587-1ce4243bc211, 'Recette trop lourde avec le mélange crème mascarpone. A refaire sans.', '2015-06-23T10:42:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 23796494-29d5-4cb7-afab-f28dd1d10d5c, 'J''ai remplacé la pistache par du chocolat (glace dessous et copeaux dessus), une tuerie. Facile à faire et un régal à déguster.', '2014-06-15T22:35:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, ffe4b9e1-e894-4ded-b1ae-cc5887633201, 'Très bonne recette ! Attention à ne pas mettre trop de coulis de fraise dans la verrine pour ne pas que le goût de fraise l''emporte sur le reste. ', '2014-05-31T20:45:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 84868de0-d455-4bb8-af3f-577a54f44ce7, 'Rafraîchissant, très beau et surtout très bon ! Fait avec de la glace vanille, un délice. Et sans glace (pour les régimes), dans une farandole de desserts (légers, évidemment!), ça fait aussi son effet...', '2012-08-22T22:56:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 4984e156-bd4e-4a9a-95d3-bebfefa0dd93, 'Très bon, je n''avais pas de glace à la pistache donc j''ai mis de la vanille. Excellent ! Et le mélange crème fraîche + mascarpone, un délice...', '2011-08-28T19:08:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, aa316ef8-4ee7-4f3d-98bd-b250d32fe6f5, 'Excellent !! Que c''est bon et beau en même temps. C''est délicieux. Merci pour cette recette digne d''un grand resto !', '2010-10-23T13:29:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, c2a939e2-803a-4440-b711-c9307ee42793, 'Super recette ! Mes invités se sont régalés et en ont redemandé !', '2010-06-04T22:02:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, f7ac5bf9-aa12-4946-9f11-b7347f71cc08, 'Pour les amateurs de fraises, c''est du bonheur. J''ai essayé avec de la glace à la vanille. Très bon pour les puristes!', '2008-01-04T14:05:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62659, 9c9cc1bd-8185-4c62-8b9f-d351d547445a, 'Génial', '2007-10-22T01:44:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, 150de1a5-9741-45d1-a4bd-738c73f59f74, 'Super recette ! Pâte au spéculos délicieuse (je rajouterai un tout petit peu plus de beurre la prochaine fois), crème excellente (je mettrais juste un peu moins de sucre dans celle-ci et je ne rajouterais pas de sucre glace sur la tarte à la fin). À refaire ! ', '2021-06-28T15:25:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, 8a8623b5-e4d3-4f01-8643-66a9c53fb7d7, 'Bonne tarte mais inutile de passer la pâte au four, la mettre directement au frigo !!', '2019-06-27T13:37:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, a9b314ab-5efb-41b1-bb18-aaf9166e5037, 'J''ai juste ajouté de la vanille de la réunion dans la crème chantilly ainsi que des zestes de citron vert pour exhauster la saveur de la fraise.', '2017-03-30T02:19:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, 05fa01b4-e3d5-4f3d-a451-319d13abde0a, 'La pâte est excellente et constitue une très bonne base associée à d''autres fruits. Je fais une version chocolat blanc et pommes caramélisées qui est très réussie également !', '2016-02-22T20:43:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, 64ea46cf-b7e1-405f-80c9-2acd2f8681c8, 'Très bonne recette pour la partie crème ! Par contre, bien attendre que la pâte soit refroidie avant de déposer la crème dessus sinon la crème devient liquide...', '2014-09-07T17:31:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, c30dbc7a-9647-4ea6-a976-3bc76818d527, 'Un délice tout le monde a adoré. J''ai mis un peu plus de beurre (au pif) car je trouvais la pâte friable et j''avais peur de ne pas pouvoir l''étaler et la couper. C''était parfait, merci pour cette recette !', '2013-07-01T18:32:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, a4ecb0ec-0476-4bbb-88ba-4f06c0eda807, 'Tout le monde a apprécié la tarte. Très très bonne, à refaire. La crème aux mascarpone, un délice avec les fraises, la pâte s''émiette un peu au découpage mais à part ça c''est génial !', '2012-06-28T11:22:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, 5c649729-7c49-4fe4-9a39-3000ef6d189e, 'Très facile et délicieuse ', '2023-06-08T15:22:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, b3f734cb-8c4e-4e41-b108-cd20c770feac, 'Parfait et facile.', '2022-05-07T18:43:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, c1e6911c-4819-4452-a3a7-bd14d84c5a81, 'Parfais, délicieux et facile.', '2020-12-15T12:42:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, c6525e31-4659-4f9b-a7f2-faa2757089f7, 'Unanimité sur cette recette! Facile à réaliser et très savoureuse!! Je vais tenter avec des cerises!!', '2020-06-21T01:38:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, f5552126-c899-4ba5-bf54-e6785b095f4c, 'Recette tip top . . . Nous avons adorée. Merci', '2020-05-05T18:34:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, 29f30611-ed62-4154-a2fe-0eeb6b7030bb, 'Tres contente extra ', '2020-04-04T09:05:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, 9e3479da-9eaf-42ea-a2d6-0b5e7ecba958, 'Recette suivie à la lettre et a eu un franc succès !', '2019-06-16T13:00:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, cec4e3ec-bfd6-4e90-a48d-cbba7ba7e0cb, 'Bof, crème trop liquide ....', '2019-05-23T13:34:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, 1bb2417e-45d0-4917-a079-7a052891f490, 'Vraiment déçu j''ai tout stoppé après le résultat de la pâte au spéculoos toute dure, impossible à démouler.', '2014-06-12T23:09:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, 6320d18e-d875-41dd-a552-d807363f8bbd, 'J''ai adoré. A refaire !', '2014-05-31T15:00:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, cbc8316b-1115-4ba2-a2a7-6ba6f8417c2b, 'Super recette, j''ai juste ajouté le zest et le jus d''un demi citron vert.', '2013-07-01T22:07:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211777, f1a5135e-e286-4298-b916-6d9b2da69b5c, 'Super bon, onctueux et léger.', '2013-06-22T19:31:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 27bc8784-67a3-4986-9070-1c0c25b8c587, 'Très bon ! C''est un peu long en préparation mais le résultat est top ! Petit conseil : les conserver au congélateur mais pour les déguster, les mettre une heure avant au frigo (pour que la mousse ne soit pas gelée)', '2015-08-29T13:09:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 365cc9d8-212b-45b4-ba3c-816c8f550bcc, 'Perso, je n’ai jamais réussi à faire les dômes au chocolat qui se cassent tous au démoulage. Dommage ! 
', '2022-04-15T16:23:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 3d2fe939-b9b2-4805-9abb-75c3819df114, 'Pour une mousse parfaite je conseille 200 g de crème fraîche et une meringue italienne: plus légère et ça tient à tous les coups! Aussi je ferme les dômes par du chocolat noir (au moins 60%), je trouve que ça donne un meilleur équilibre. Merci bien pour cette belle inspiration !', '2015-12-09T08:14:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 6543254c-934d-4d56-80d5-4fe70156ac1a, 'Dessert fait pour la fête des pères toit le monde s''est régalé. J''avais peur pour les dômes j''ai utilisé des moules en inox démoulage nickel. à refaire', '2015-06-24T23:41:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 80aef4af-bc65-4d9f-9bdf-7a2e75e6e80a, 'Une présentation fantastique que je croyais ne pas pouvoir réussir et que j''ai finalement réussie sans problème. Par contre, comme dans beaucoup d''autres commentaires, j''ai mis le double de chocolat pour bien renforcer la coque, ça me paraissait tellement fragile !  Niveau goût, coulis fantastique mais j''ai été un peu écoeurée par le dôme en chocolat mais je ne suis pas grande fan de chocolat blanc,donc.... merci pour cette recette "qui en jette" !!!', '2014-06-26T20:46:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, c91c025f-418d-4695-b2bd-cdbfd99de418, 'Fait à Pâques, j''ai bluffé mes invités. Je l''ai fait au chocolat noir 70% et comme je suis au régime, j''ai remplacé la crème fraîche par du fromage blanc. Avec les blancs d''oeufs montés en neige, cela fait quand même une texture de mousse.', '2014-04-21T20:10:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, cd936e03-ce5a-454e-8ed3-20ce83174fc0, 'Merci pour la recette, mes invités ont apprécié. Recette bien expliquée. J''ai mis davantage de chocolat blanc.', '2022-11-01T07:04:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 5db921b7-21d6-46c5-8997-08ab9c1bbf44, 'Délicieux ! Fait pour un anniversaire, trop trop bon ! Par contre, pas assez de chocolat pour 10 dômes, j''en ai eu que 4 ! Mais assez de mousse pour 10 !', '2021-07-17T14:15:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 9241a4e5-e94f-41a3-8a8c-a9bec41322c7, 'Si nous utilisons des fruits surgelés, il y a pas mal d''eau même après un bon moment de cuisson, la mousse donne donc plutôt une purée qu''une mousse niveau consistance. Mais peu importe, ce petit dessert à fait sensation ! Un délice. Pas difficile à faire mais il faut avoir du temps devant soi pour réaliser les étapes convenablement.
Merci pr la recette ! ', '2020-06-21T21:05:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, d17d02cc-1813-485f-8ddf-69f1625d0f59, 'Je fais cette recette assez souvent avec des coques en chocolat noir, blanc ou au lait. Avec des inserts de mousse à l’orange ou framboise. Tempérer le chocolat (de couverture) est impératif. A la fin, pour le coup d’œil je fais un glaçage ultra brillant, chocolat, rouge ou blanc etc. Les invités adorent.', '2019-04-19T07:44:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 79bea125-97b8-457a-a163-c320792c368f, 'Super mais relativement technique !  ! Très bonne recette !', '2017-10-26T16:30:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 54142018-0ae6-40ab-b6fc-94d300a5612f, 'Très bon. Très joli. Réussi mais je n''ai pas mis d''oeuf et j''ai pratiqué un tempérage du chocolat. ', '2016-07-22T23:14:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 021c359a-48fc-4b10-86a6-108ea2ef3e2d, 'Impossibles à démouler, tous les dômes se sont cassés !', '2016-02-06T12:34:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 0c33a908-382f-4364-83f9-91fbc111b514, 'Trop bien pas besoin de gélatine', '2015-04-03T22:10:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 0955d00c-af9d-4dd6-a6e2-7d2779fda961, 'A refaire car j''ai raté ma mousse mais sinon c''etait bon quand meme', '2015-03-12T13:15:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 13974bc5-e89d-4b66-a080-fbc14c33658f, 'Très déçu... tout d''abord mettre le chocolat au pinceau ne fait très joli car on voit tout les strie du pinceau. Ensuite ma mousse n''a pas pris. Bref une après midi entière à préparer le dessert pour finalement tout mettre à la poubelle. De plus, je n''avais pas assez de préparation pour remplir 8 sphères. si vous avez des conseils je suis preneuse.', '2014-12-08T18:02:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, b9fad34e-19ac-40bd-bdc6-ef92efcfdb96, 'Un dessert succulent que mon chéri a ADORE ! Merci Marmiton, j''en referai', '2014-09-25T16:33:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, f7e14a92-f352-4912-949d-4849ee2cc046, 'Tout le monde a adoré, j''en ai fait pour 15 personnes. C''est vrai que ça met du temps à la préparation. J''ai fait moitié chocolat blanc et chocolat noir, celui au chocolat noir est super bon aussi !', '2014-07-13T15:44:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, de8c65d5-0ba3-4c8a-b049-bb9676b31863, 'Original comme présentation de dessert mais un peu déçue par rapport au travail que cela représente, j''ai aussi doublé le chocolat blanc sinon la coque est transparente , je n''ai pas trouvé de moules demi sphères, j''ai pris des moules à muffins.', '2014-06-28T10:26:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 7096ebb4-f12b-4212-b201-be8de470979a, 'Très bon, agréable en bouche et je confirme prévoir le double en chocolat.', '2014-06-20T08:32:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 5e83118f-ff43-490f-b750-a232575e7a04, 'J''ai adoré, c''est à refaire. ', '2014-06-19T01:14:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 9fe66ad2-5118-4269-b465-b38045715ddb, 'Pas mal, très bon, à refaire par contre j''ai raté le dôme... sinon c''est très simple !', '2014-06-14T08:59:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, c049434e-a5d4-4779-a21e-74977652159f, 'Est-on obligé de mettre de la gélatine ?', '2014-06-13T22:13:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 59cfdbe1-d377-4645-a941-f68ec32ef2c0, 'Quelle excellente et délicieuse recette, vous nous offrez là, un merveilleux petit dôme, mais qui nous réserve une magnifique et féerique farandole de bonheur, quand ont le déguste, par contre surtout, des aminautes, prévoir un peu plus de chocolat blanc, pour renforcer la coque. J''adore et mes amis, ont étaient complètement bluffés, alors je recommande vivement ce dessert et je vous remercie, pour la recette. Bonne soirée et bonne dégustation à tous. 20/20 !', '2014-06-13T21:59:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 051ba3fe-5c2e-4828-9a95-3de1c5b6142d, 'La crème pas bonne du tout. Le dôme, c''est pareil.  ', '2014-06-13T19:51:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 7dc88f9b-9757-46a9-8d36-db4f753b3ea0, 'Excellent et très original, les convives ont été bluffés ! ', '2014-06-13T10:32:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 8e7c8edc-5a91-4590-9956-9313b8710a0c, 'Excellent ! Je recommande !! En revanche, prévoir le double en chocolat blanc : 200 g pour faire le fond et les bords et 200 g pour l''ultime étape. Merci pour la recette', '2014-05-12T18:14:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 42355ccd-56c4-4865-acd5-3d63b30c7190, 'Recette très longue à faire mais vraiment excellente. C''est une bonne surprise en fin de repas...  Pour un peu plus d''originalité j''ai choisi des moules en forme de cœur mes amis étaient ravis !! ', '2014-05-04T09:56:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 9a7881e7-602b-43ee-9d54-b27a6cf5c2ba, 'Super bon... Par contre il faut bien penser à sortir un bon moment avant de servir car sinon la mousse est glacée...', '2014-04-15T12:19:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 3b868f72-bc79-45a4-b331-f5e7d205e5d4, 'Original, beau et bien équilibré ! Super dessert qui bluffe... et pourtant pas compliqué !', '2013-10-19T20:32:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 85b46071-1dc5-4d72-9606-49c55bc1962f, 'Recette excellente et facile à réaliser. ', '2013-05-10T18:34:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, b1536fe4-7f2b-41b7-bee1-d0ad13a1d297, 'Fabuleux !! Un réel succès qui a bluffé mes invités ! Merci pour cette recette', '2013-04-28T15:15:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, 2cf8a01c-db18-43f9-81c9-61a487bd7e1d, 'Très bonne recette et une présentation qui en jette ! Ma mousse était un peu ratée parce que ma chantilly n''a pas pris, mais c''était bon quand même. Pour la présentation, j''ai posé les dômes sur une grande galette bretonne.', '2013-04-14T15:56:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, c4cb4514-fb71-480d-847c-879a87327eaf, 'Bonne recette mais j''ai eu du mal à réaliser les dômes en chocolat !! Je retenterai car dessert sous le signe de la légèreté !', '2012-09-11T00:58:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172829, beacd271-43b2-4283-9ece-3ceb1ae5e59c, 'Excellent', '2011-10-19T12:37:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 6dc8646f-ade9-4414-9e6b-e976e54782e2, 'Super recette facile et rapide pour ma part j’ai tout divisé en deux car je n’avais plus assez de framboises...à part ça cette recette et délicieuse ? j’ai rajouté un peu de lait d’amande vanille (de la marque BJORG) dans les framboises et un peu d’extrait de vanille liquide (de la marque VAÏNÉE) dans le mélange mascarpone etc... bref cette recette et TOP et très bonne ! ', '2023-10-31T17:50:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 286dc0dc-51f6-436f-beac-7d1479e9ac42, 'Délicieux ! Je l’ai déjà fait à plusieurs reprises, on me le demande à chaque repas de famille. Je ne mouille pas les biscuits dans le lait, car sinon je les trouve trop mous. Les framboises écrasées suffisent à imbiber juste ce qu’il faut. Merci pour cette recette !', '2022-08-07T15:55:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 2a6b7993-b79e-4720-aca6-36101dcf45be, 'Excellente recette, faite avec des framboises surgelées et des biscuits roses. Merci.', '2022-07-03T17:17:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 18104e3c-63a7-42de-939c-415fb11f5ef2, 'Ne pas tremper dans le lait avec des framboises surgelées pour ma part c''était trop liquide dommage.. 
