INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, e21fe103-c6c1-4c50-b5dd-caf2087d2860, 'Excellent', '2017-05-06T22:30:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 6ad689c2-e382-41c9-8dda-1283cb6f7f2d, 'Délicieuse. A la période des fraises, un vrai régal avec de bonnes fraises bien sucrées...', '2017-02-19T14:32:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 8309ba15-4b6e-45b5-98b5-a4765cc67dc8, 'Super ! A faire et refaire ! ', '2016-09-14T10:14:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, be584957-7d1d-4996-b4b2-d70fc7715012, 'Je n''ai mis que deux cuillères à soupe de sucre, et remplacé le sucre vanillé par quelques gouttes d''extrait de vanille, et mis plus de fraises ! Tres bon ! ', '2016-08-31T12:12:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 20c5d8e2-4bda-4b1a-b27d-fd209ddc17ae, 'Excellente recette qui fait mouche à chaque fois. je l''ai réalisé avec des pêches fraîches que j''avais préalablement épluchées et mises dans une petite boîte en plastique avec du sucre vanillée pour leurs donner encore plus de saveur. Un vrai régal !! Merci.', '2016-07-22T16:25:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 61f73a2b-8a0a-4c84-ba83-57353bc9ec5b, 'Bonne tarte! Avec une pâte sablée maison, la prochaine fois ça sera en tarte individuelle plus présentable car à la découpe c''est moyen. ', '2016-06-09T15:35:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 2d0b7231-e8bc-4479-8941-8d15ea1757a2, 'Meilleure avec une pâte sablée pur beurre', '2016-05-29T10:16:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 137b5f81-5c5a-47d1-98fe-1e9e4bf33ad4, 'Excellent ! 10/10', '2016-05-11T22:27:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 729e92bb-2da7-4491-9016-4196a788cee0, 'Excellente tarte. J''ai mis 500 g de fraises pour qu''elle soit bien garnie.', '2016-05-02T22:26:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 4a35d279-2ee6-4ee8-b24a-a30149b870b5, 'Juste un mot EXCELLENTE !', '2016-04-18T20:48:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, c5e58384-6f46-477c-a905-21eac3935008, 'Super recette, tout le monde la redemande !!!', '2015-11-12T23:54:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 99d2fbc5-0bb7-4595-9323-8f92361be6c1, 'La crème est un vrai délice !! un super mariage avec les fraises ! par contre la pâte à revoir. ', '2015-06-10T00:05:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 754e3612-70e2-4850-a5ec-e45a2631544f, 'Trop bonne... je l''ai faite avec de la pâte sablée même si j''ai pas réussi à faire une mousse c''est sur je vais la refaire.', '2015-05-03T23:27:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, e68a0f1a-4a57-43f8-9848-852b09898176, 'Très bonne recette, facile à réaliser et légère sans la crème pâtissière. Je l''ai déjà refaite, même si j''utilise une pâte sablée, qui est plus à mon goût !', '2014-08-28T13:30:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, c696f13c-cd5f-4292-b0ae-2465ddc40a66, 'J''ai suivi tous les conseils précédents et j''ai fait une pâte sablée plutôt qu''une pâte brisée, j''ai rajouté 1 blanc d''oeuf en neige au mascarpone. C''était très bon, mais ça manquait de garniture, la prochaine fois je doublerai la dose de crème. ', '2014-08-15T17:12:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 1c4593c9-5fd3-4036-8059-1b32fa6992a7, 'Excellentissime ! l''intitulé "nuage" m''a donné l''idée de faire la tarte avec des feuilles de brick (3) comme pâte. C''etait encore plus aérien, et a produit beaucoup d''effet...  pour mon goût personnel, la crème au mascarpone est un peu lourde, mais ça évite de se resservir. bravo et merci pour la recette.', '2014-05-11T15:21:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 9d28fde0-5bd4-4ed5-bdc0-421033204485, 'Pas mauvaise mais trois bémols : 1/ mentionner que les proportions sont pour un grand plat à tarte et qu''il ne faut pas laisser de rebord (?). J''ai utilisé un plat à tarte de taille moyenne parce que les pâtes toutes faites sont trop petites à mon goût pour les grands plats car on ne peut y remonter les bords. et dans mon petit plat : trop de mascarpone : les fraises s''enfonçaient dedans allègrement ... :-))  2/ J''ai eu beau battre le mascarpone : il est resté crémeux. Pas de mousse ... sucré ça n''en est pas moins bon, mais bon on a le goût de la chantilly sans la texture, autant faire une chantilly. 3/ Finalement la prochaine fois je ferai avec une pâte sablée. La brisée était fade face à la fraise et à la "chantilly". Merci pour cette recette : c''était ma 1ère tarte aux fraises et... pas la dernière. ', '2014-05-02T22:32:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 4712c9d3-5265-4e08-a8ac-be713d9fd451, 'Trop bonne, nuage de mousse de fraise avec fraise coupée en deux dessus et un coulis de fraise miammmm !!! ', '2014-04-16T20:59:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, df068ce0-273e-44ba-ab4c-6219b268ecd2, 'Excellente recette ! Très légère,  tout le monde s''est régalée. Il n''y a rien à modifier, les doses sont parfaites. ', '2014-03-26T12:50:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 236ce117-d7b5-42f0-a542-8dcfc43a391d, 'Recette super légère et très bonne...', '2014-03-25T22:38:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, e32296f6-2adc-4682-887e-dab4312decb4, 'Dessert léger et excellent ! Je le referai sans hésiter.', '2014-03-23T12:39:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 5428fdd7-17c2-44b6-a829-3490b724533e, 'Tout simplement excellent, je la conseille à tous', '2014-03-21T22:11:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 66358e3b-69bc-4445-8b75-4994e275ab77, 'Excellent et facile !', '2013-11-11T13:20:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 1652d824-07e3-41c8-a831-d2bec15e0e53, 'Une merveille de simplicité et un dessert qui conquit tous les convives, enfants compris. Perso j''utilise de la pâte sablée ou de la pâte brisée maison et je remplace le sucre vanillé par de la poudre de vanille bourbon.', '2013-11-08T17:20:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 82a25a85-ad0a-4a1b-ade7-9d07e5abdd0c, 'Vraiment très bon ! D''autant plus que très rapide et facile à réaliser. Bref une très bonne recette !', '2013-09-20T18:22:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 43df71f1-292a-4c11-8515-f548061c3efa, 'Recette très sympa et facile ! J''ai remplacé la pâte par une pâte sablée faite maison et ajouté de la confiture de fraise sur la tarte terminée pour l''esthétique ! Tous les invités ont adoré !', '2013-09-01T20:04:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 5c0362f2-ca7a-4556-b395-78ebe65587a9, 'Super bon. Je l''ai fait, il est simple à faire mais j''ai ajouté de la crème chantilly légère :)', '2013-08-18T12:42:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 99214ca9-7104-438d-ae98-06bc598c7e44, 'Très bonne recette.', '2013-08-04T16:11:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 53de052c-7752-45fd-95b2-8f64eee81441, 'Je suis débutante en pâtisserie et mon compagnon et moi même avons adoré ! Je l''ai fait avec des framboises miam miam !!! Très rapide et bon !', '2013-07-27T21:56:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, c560392b-4f8d-46e4-bc34-2341b51351c0, 'Super facile, super bon.', '2013-07-17T18:17:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, cb9448cf-9a0a-44fc-9de6-25f5309c222e, 'Avec une pâte sablée maison... SUCCULENT !', '2013-07-16T19:50:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, ab30602a-0cf3-440b-a5fe-d4f62e70ad3e, 'Excellent ! J''ajoute miel et cannelle !', '2022-11-11T19:34:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 45b4700c-e8fe-4602-8b22-d77ceab2e889, 'J ai fait précuite la pâte et j ai ajouté 100 g d amande en poudre. Super', '2021-04-18T21:08:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, d5c5239b-45ba-4230-ba73-af468989b64d, 'Très bonne recette 😁 J’ai juste fait la pâte brisée moi-même 😄', '2022-02-05T12:45:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 3694262d-69c6-4de2-97b3-d60b159d9e81, 'J''ai mis 2 pommes et 1 poires (6 personnes) et un peu de semoule dans le fond de la pâte à tarte pour éviter que le jus donne un aspect "pas cuit" à la tarte dans le fond.', '2022-01-09T12:56:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 7c33b25f-94eb-4043-a7cc-46c85b852a6e, 'Excellent crumble aux pommes avec le plus d''avoir une pâte à tarte en dessous :D. Encore plus gourmand ! Personnellement, j''ajoute de la cannelle en plus avec les pommes. Merci pour cette bonne recette :)', '2021-04-26T16:23:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 9cae1bca-755b-4832-a434-3acfedfec31d, 'Avec une compote faite maison (faire bouillir des petits morceaux de pommes dans un fond d''eau dans une casserole, charger en cannelle et un peu de sucre, et écraser avec un presse purée), c''est encore meilleur !', '2020-07-25T11:32:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, a581ae64-a46c-4cef-bf56-7e833f3be887, 'Désolé j''adore beaucoup de recette de Marmiton mais la... . La cata... Pâte pas cuite et les pommes non plus.. Malgré 40 minutes de cuisson. Points positifs : quantité d''ingrédients parfaite , et le petit plus de la canelle très bon. Je la referais mais en faisant précuire la pate et couper les pommes en plus petit morceaux. ', '2021-02-28T22:09:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 6a94c02b-8238-425c-b207-19956d727336, 'C''est devenu un classique, délicieux !', '2022-11-06T10:41:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 55648fd2-eaed-4e75-a93b-bd52b2d8b1bf, 'Excellente, je l''ai fait avec une pâte feuilleté et une compote fait maison.', '2022-09-22T10:13:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 5e77c1aa-a7fc-4ff0-8ffa-5f6ed0df667f, 'Facile à faire 🙂', '2022-01-11T19:26:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 117fd276-a205-400e-a089-180cbca5be18, 'Super facile et trop bon l''hiver avec des pommes de saison. Je mets beaucoup de cannelle dans ma compote de pommes (faite maison) ! Servir avec une crème anglaise ou glace vanille', '2020-03-29T19:08:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 84e69312-7d8f-4769-a368-7d515f865c6d, 'Premier gâteau que je fais vraiment très bon.', '2020-01-12T07:44:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, fb809fe7-98e3-4794-8eb9-1de23d60beb8, 'Au lieu de la compote, je mets de la marmelade de cerises parfumée à la cannelle puis je dispose mes cubes de pommes par dessus et je couvre de crumble.', '2019-07-14T07:35:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, a20000d5-8128-4cd2-866d-ea7a6b745539, 'Recette faite cette apres midi j''ai fait des petits cubes de pomme que j''ai caramélisé et déposer sur une couche de compote de pomme sur une tarte brisé et fait cuire 35 min a chaleur tournante a 180°C. Un vrai délice tiède avec un bon café !', '2018-05-20T14:00:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 18ffa14f-ded3-4158-ab7d-7db1b748d3cd, 'Je fais précuire ma pâte maison et je remplace la compote par du caramel beurre salé maison. La tarte fait l''unanimité même chez les personnes "pas gâteau", un succès a chaque fois.', '2017-11-05T11:23:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, a11b71bb-8522-49ab-8b76-2823280f02ee, 'Excellent ! Nous nous sommes régalés ! J''ai ajouté de la cannelle sur les pommes (comme annoncé dans un commentaire précédent) cela donne beaucoup de goût à la tarte ! Rapide et bon, un dessert parfait lorsqu''on reçoit en dernière minute ! ', '2017-02-09T21:07:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, de33fc92-7ba1-490e-b784-1a9cd5c8921b, 'Délicieux! Juste la compote fait maison, sinon j''ai suivi la recette et franchement j''ai adoré, et ma petite famille aussi !! Merci.', '2016-10-24T17:07:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, e2283891-384a-4f17-ae4d-27691c36082c, 'Faite hier soir. Un pur délice. J''ai juste saupoudré de la cannelle et du gingembre en poudre sur les pommes avant de mettre la pâte à crumble où j''ai mis du beurre demi-sel à la place du beurre doux. À refaire sans hésiter.', '2016-06-04T12:25:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 80549c6f-126d-4378-b619-aecb69c8d77a, 'Super facile à faire et très bonne', '2015-02-22T12:26:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, a575a527-8f21-4d6a-b87f-582124c91aec, 'Simple rapide et excellent. Pour les fans de citron, je recommande vivement cette recette ! ', '2015-01-27T11:13:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 5ddceeac-2113-4438-8f86-fb4183025f55, 'Cette tarte est devenue ma spécialité ! A chaque fois que je la fais, c''est une véritable réussite ! Pour ma part, je fais aussi revenir les pommes à la poêle avec du beurre salé et du sucre roux afin de les rendre fondantes. Je ne mets donc pas de compote. Attention, les quantités de la recette pour le crumble ne sont pas bonnes ! Si on suit au pied de la lettre, le crumble est farineux et ne prend pas du tout. Pour un crumble réussi, il faut autant de sucre, de farine et de beurre. Dans ma recette, je mets 150 g de chaque ! A accompagner d''une bonne glace à la vanille.', '2015-01-04T20:49:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 82434d7e-3cba-49d9-8eda-4beb18e947d5, 'Miami meilleur que le classique crumble et j''ajoute en peu de gelée groseille ou cassis sur les pommes : délicieux ', '2013-04-28T14:56:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 9ce747af-d468-4180-8844-46d6fb553822, 'Facile et au top !  J''ai utilisé une pâte feuilletée.  J''y est mis également un peu de confiture aux pommes de ma marraine. Ça l''a sucrée et légèrement caramélisée.  Par ailleurs, dans le mélange pour crumble, j''ai ajouté un peu de poudre d''amande et des noisettes coupées finement.  Merci pour cette super recette ! ', '2013-01-01T20:29:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 308d626a-85e7-4c88-aaa3-cbf4b0aaddc9, 'Parfaite ! Plus de temps de cuisson en ce qui me concerne (15 min puis 10 min), afin d''obtenir un crumble bien doré et une pâte bien croustillante.', '2012-11-04T15:05:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 1ff8c40c-bb6f-4bc9-80fa-b94ac5946a9e, 'J''ai précuit un peu la pâte et ajouté de la cannelle aux pommes. Juste délicieux.', '2011-11-20T11:16:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 0acb77a8-73cc-4272-acf2-3cb4ba6c2620, 'Très bon, tout le monde l''a préférée au crumble classique.', '2011-11-15T10:30:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 60c779ee-ae2f-4256-b707-a98ff92844e9, 'Cette tarte crumble est excellente. Comme nous sommes en automne, et qu''il y a pas mal de pommes, j''ai fait ma compote. Par contre, j''ai été déçue par la pâte à crumble, pas assez de texture, un peu sablonneuse. Sinon, rien à redire.', '2011-11-12T10:06:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, ecd3b0d4-43bc-486c-ba34-11f8a5209e73, 'Très facile à faire ! J''ai mis sur les pommes du miel et de la cannelle et dans la pâte du sucre vanillé. Très bon dessert j''ai adoré !', '2011-10-26T01:32:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 74b31ee0-4145-4a7e-99f3-1d5199776e46, 'Ma première tarte !!! Réussie de belle manière. J''ai précuit la tarte et ajouté un peu de cannelle mélangée à la compote. J''ai également terminé en mode gril pour doré le crumble. A refaire sans hésiter !!! ', '2011-10-08T23:55:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 59bb367e-5690-419c-a02f-68ec49d4e05f, 'J''ai utilisé de la compote pommes-vanille et ajouté 2 spéculoos broyés au crumble, c''était délicieux.', '2011-09-29T14:15:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 36654a04-fcf3-49fa-814b-eeb9a341648a, 'Miam, miam, le 2 en 1, la tarte + le crumble, succulent !', '2010-10-21T17:06:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 99321652-dbd3-4d3f-b557-33d713326ee0, 'Facile, et vraiment délicieuse. Il convient quand même, pour un four électrique, de mettre le thermostat à 200 et de le faire cuire pendant 45 min. C''est une recette succulente, que je referais, à nouveau. Merci.', '2005-09-01T15:08:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 1a749fe4-9d1e-4884-8252-3be1158c1026, 'Recette facile, rapide et délicieuse!', '2023-10-09T17:15:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 8463e358-4932-46e3-a405-d1b141b2d7bf, 'Excellente ', '2023-10-09T12:54:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, db76b333-8d82-4282-bffe-f7ebc2346658, 'Magnifique j''adore cette recette a refaire 🥰😍😋', '2023-07-15T17:46:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, cd599457-ab61-401b-9d0f-4fa2f74808f5, 'Cette recette express a rejoint la liste de mes basiques en cuisine « mini temps maxi gourmand » !', '2023-04-21T13:26:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, f1fdbd81-6fd6-4b3b-a88b-19bae657cfa7, 'Un vrai régale !! Elle est adorée de tous à la maison !! ', '2023-04-11T13:29:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 69b79d91-daa5-4fa4-a9eb-25e677a1cf97, 'super facile à faire et très bon :) ', '2023-02-11T17:06:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 561d1343-7f69-4b64-8fd5-c0b196c7a9fa, 'Très bonne tarte, facile à faire et rapide ', '2023-01-15T15:56:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, a5f6b52c-a6d7-4c33-875b-e0c15ac51be0, 'Délicieux !', '2022-09-17T19:53:37+02:00');
