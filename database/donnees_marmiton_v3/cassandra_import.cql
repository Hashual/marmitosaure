INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 73a28765-37d3-4744-adc9-dc99e5e03d87, 'Excellent sans bicarbonate, encore meilleur avec des pépites de chocolat !!!', '2022-02-01T18:28:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 9b97d184-1d92-4495-aeed-d86c00c8e8d6, 'Facile et rapide à faire, un délice avec quelques pépites de chocolat en plus !', '2022-01-30T12:51:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 613a779e-76f0-4d4e-968f-a9645039efea, 'J’ai mit moins de sucre que prévu et j’ai rajouté des pépites de chocolat, et il est excellent !
J’en referais!🥰', '2022-01-11T17:13:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, f0c1c3b3-895f-4a39-9d10-b20dcc091057, 'Top. Mes copains runes ont tous aimé après notre sortie.. Je l’ai fait avec de la farine 5 céréales bio, j’ai ajouté une cuillère de pâte à la pistache et des billes de chocolat noir…😋', '2021-12-05T15:16:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 7b7c50ab-b881-48a5-8b9d-dd1f5d4f1300, 'J’ai utilisé du beurre ramolli et non fondu. J’ai mis moitié farine, moitié fécule, un sachet entier de levure et 3 bananes. Au top !', '2021-11-07T06:17:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 7656ef16-0bf0-406e-a0b0-6852f79205b0, 'Juste parfait. J’ai remplacé le lait par du lait de coco pour en donner au bébé. Ajouté quelques pépites de chocolat et une gousse de vanille.', '2021-11-06T21:48:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 4792d490-a67c-4afc-a354-9c31d1a63c8d, 'Très bon et encore meilleur avec des noix et des morceaux de chocolat que j''ajoute à chaque fois. 👍', '2021-11-06T19:29:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 0a8f37f3-0ad4-479f-80af-8cf67d44866d, 'Très bon avec une banane de plus, une grosse cuillère à soupe de beurre de cacahuète et arômes vanille et amande amère et un peu de canelle. Je n''ai pas mis de bicarbonate et utilisé 100g de sucre.', '2021-08-08T02:16:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 138eb1d1-40db-4f2c-b1cf-3d190ecf2dd7, 'Très bonne recette, j''ajoute des noix et de la cannelle. En 45 min le cake est cuit dans un four chaleur tournante.', '2018-11-11T09:12:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 45b6e37a-d0cb-44a4-bbb6-9aad47cf32e4, 'Au top !', '2018-02-18T12:09:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 08a694b0-36b7-4d3d-b44a-37c5d8d9812c, 'Super ! J’ajoute de la cannelle ou des pépites de chocolat.', '2018-02-16T02:10:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 51ef6877-9e68-4722-b1b9-bf24ae971e8d, 'Excellente recette ! Bonne proportion et indication pour la cuisson. Merci beaucoup !', '2013-02-28T23:59:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 25714482-11be-413e-b6a9-9f59f0ff5aeb, 'Moelleux et délicieux ! ! !', '2023-12-30T10:20:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 3bd88e02-84dd-4bbb-b0cc-6e151a92a44f, 'Super recette! J''ai mis 60gr de pépites de chocolat, 3 bananes et 80gr de sucre cassonade dans la pate et saupoudré de 2 cs de sucre pour plus de croquant.', '2023-10-29T08:09:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, b589e685-2542-4855-8641-07b8a60eb26b, 'Excellent fait avec 3 bananes archi mûres et donc 1/3 des proportions en plus sauf pour le sucre et le beurre. Garni de pépites de chocolat,de rhum et d''amandes en poudre en plus
Cuit en portions individuelles, j''en ai obtenu 13. Une bonne demi-heure de cuisson était suffisant !', '2023-09-14T18:34:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 136ba3fd-02a4-49d7-849a-73f391a7e037, 'Top! Pour mon fils allergique aux protéines de lait, j''ai remplacé le beurre par du beurre végétal, et le lait par du lait de coco (+1 cuillère à soupe)! Parfait, un régal !', '2023-08-12T16:36:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, db858896-7449-4232-bc75-54970d856b8b, 'Avec des pépites de chocolat en plus c’est délicieux !', '2023-04-04T13:53:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 57be31c1-eafa-4dc7-8117-8448abdf214b, 'Très bon !
Super recette anti-gaspi pour passer les bananes trop mûres. 

Modifications : 100g de sucre, 50g de beurre, et 1 sachet de levure chimique
', '2023-04-02T16:44:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 8b360a2a-a59d-4c9d-9baa-40a9d6501f72, 'Trèeeees bon 🤌', '2023-03-27T23:46:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 19ad0b9e-5480-49e8-975b-6e2283f44cb4, 'Très moelleux, bon goût de banane mais en en mettant 3. J’ai mis 120g de sucre, suffisant et très bien. Pour le reste, respecté à la lettre. Très bon. ', '2023-03-05T16:00:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 373d95a7-cb59-4672-8c8d-5d22f122c305, 'Très bonne recette. Moelleux, j’ai rajouté des pépites de chocolat noir. Un régal ', '2023-02-22T17:45:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, ee952030-1cfe-4ffb-ba61-998b30a0d8e4, 'Très bon et moelleux ! J''ai ajouté une banane, des noix et des morceaux de chocolat. Il a été vite mangé... 😅', '2023-01-13T13:20:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 0a3e531b-81e4-4e10-b72e-35d9814c516d, 'J''ai diminué la quantité de sucre (120 g), ajouté des pépites de chocolat et mis un sachet entier de levure chimique.
J''ai également essayé avec une banane en plus, top !', '2022-11-13T14:46:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, e620475b-1469-4f09-af1d-961bec61503c, 'Excellente recette, j''ajoute une banane sur le dessus saupoudrée de sucre complet, 10 carrés de chocolat hachés, 85 g de sucre blanc et 1/2 cuillère à café de jus de citron ou de vinaigre de cidre pour activer la levure et rendre le gâteau très moelleux.', '2022-10-29T11:38:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, b1dc10f3-e8af-4864-863c-f6784059d388, 'Extra moelleux !! Le meilleur que j''ai jamais fait !! J''ai ajouté une banane et mis que 80 g de sucre !', '2022-09-23T21:34:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 38a2e71a-4168-4d92-8f89-1387e4639b75, 'Hyper facile et vraiment bon

', '2021-11-14T18:41:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, b92ed3fb-bfe6-4926-8b4b-60467a9d373e, 'Très bon ! Pas sec du tout et très bien cuit. Un régal !', '2021-11-09T08:04:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, e5ea2694-e366-49ff-97aa-479595bceb9a, 'Très bon gâteau rajouter au dessus une banane tranchée dans la longueur c’est encore meilleur ', '2021-11-02T17:07:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 69e9f09b-2c13-42b2-9323-461fe0fd7ef2, 'Recette parfaite toute les proportions sont exactes.
Réussi à chaque fois: il m''arrive de rajouter du chocolat, ou d''imbiber de rhum lorsqu''ils sortent du fours. Merci 😊', '2021-09-30T11:35:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, dc3e7788-012e-4482-9d10-55f84ebdf2af, 'Super bon pour le goûter ou petit-déjeuner !', '2021-09-17T10:21:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, bac2a0a7-9a45-4af8-85ab-4eee5b3239b4, 'Facile à réaliser, en surveillant la cuisson au couteau. En ajoutant de la vanille, le goût de la banane ressort davantage 👌🏼🍌🥧', '2021-07-05T17:41:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 254d3609-8a0a-4919-b598-7c781f80ba8f, 'Très bon, j’ai cependant seulement mis 50gr de sucre, j’ai remplacé le beurre par de l’huile de coco et j’ai ajouté de la cannelle et des morceaux de noisettes ', '2021-05-02T17:04:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, b5714cf3-6db9-4156-89cc-97260faa901e, 'Excellente recette', '2021-04-17T09:36:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 220fe6c7-a16a-4987-a971-a385212f3afc, 'Je l’ai fait au robot companion avec le couteau pétrisseur, un régal :)', '2021-03-06T12:52:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, c2e26521-a933-46e3-b38a-e33ca5c2ab22, 'Excellent un classique que je fais régulièrement avec 3 ou 4 bananes et 140gr de sucre et 60 gr de beurre', '2021-02-19T20:08:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 524d7899-2412-44cf-adaf-557c1aca7405, 'Excellent ! Texture parfaite, goût incroyable. Un de mes desserts préférés !!', '2021-01-24T13:57:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 1ff7b028-0c0e-4063-a039-d7392c1577e2, 'Et voilà, avec pépites de chocolat', '2020-11-25T18:00:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 13176d9b-f293-441d-af64-b758dfbb3c9b, 'Excellentissime. Je remplace le beurre par autant de gramme de banane et c’est top. Encore meilleur le lendemain.', '2020-11-03T19:59:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 6236b5b9-d691-4339-a035-f53689471dde, 'Delicieuse recette ! ??vraiment parfaite ! ', '2020-03-24T15:30:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, ddd44faf-5a14-4600-99f9-16a9b67012ae, 'Un délice ! J’ai rajouté des pépites de chocolat pour plus de gourmandises. Et j’en ai fait des petits à emporter. ', '2020-03-04T17:42:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 5dc249d6-dc6c-4d29-866e-c7332686029d, 'Je divise la quantité de sucre par deux, et c''est toujours très réussi. Je bats à la main, pas au mixeur. Et depuis quelques temps, je remplace le beurre par de l''huile de coco.', '2020-01-30T23:53:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, c2e54010-be24-4cf0-8208-122b1d5ac687, 'Délicieux avec moins de sucre : 100g, un peu de rhum, et 150 g de noix de pécan et noix concassées.', '2020-01-04T01:00:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16482, 4ca051c5-e4fa-43a4-9809-6327dde97781, 'Au gout très bon mais il faut mettre moins de crème car trop liquide dommage la prochaine fois je mettrais moins de crème', '2016-12-25T01:27:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16482, 0b990d89-d0e0-4003-8b87-afee54269db5, 'Très bon.', '2009-05-08T14:39:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16482, 88c5b0bc-ca34-493c-a1f6-8b4b3962a151, 'Moi qui aime la banane et la crème fraîche, j''ai été très déçu. Le résultat n''est pas vraiment présentable et le goût n''a rien d''extraordinaire. Mieux vaut servir les bananes séparément avec de la crème Chantilly!', '2003-05-10T01:43:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16482, 3e3f06f6-37d9-4c7e-b44b-a01f93fc2923, 'Le goût est délicieux, mais l''aspect laisse à désirer, sans doute parce que la banane s''oxyde et donne une coloration brunâtre à la crème. La prochaine fois, j''essaierai d''ajouter un peu de citron pour conserver la couleur.', '2002-04-18T16:45:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16482, f0c3a2a3-a918-4a94-b1e5-6b2717720dcf, 'Délicieux! Quant à l''aspect, peut-être plus de crème fraîche que de bananes. Moi,je la referai!', '2002-04-13T18:50:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16482, 27365a12-afe9-47fa-8262-72c866d586ff, 'La crème n''a pas fait fureur! Son aspect y est pour beaucoup, je pense. Je n''en referai pas.', '2002-04-12T17:16:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29057, 675c0b86-e955-4ae3-b0aa-6161a7a31507, 'Je viens d''essayer cette recette. Préférer le beurre à l''huile et c''est mieux de sortir les bananes dorées. Mélanger aux œufs et ajouter un peu d''extrait de vanille, remettre à cuire puis flamber...', '2011-01-28T14:07:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29057, 739b63fe-8940-4c9f-9e10-36f70fab66a9, 'Je ne suis pas convaicue... Cette grosse omelette est impossible à retourner sans la "casser" et du coup, la consistance au moment de servir n''est pas jolie-jolie, mais peut-être ne suis-je pas douée en omelette tout court ?! Quand au gôut banane et rhum font, bien entendu, très bon ménage mais l''omelette alourdi ce plat et n''apporte à mon sens, rien de plus au goût...', '2006-02-13T09:55:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29057, 50ca6567-99c1-4913-898e-cf8886c2a0d2, 'Simple & bon.', '2006-02-27T12:56:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29057, 03df7f35-7ab6-4e4c-b1b9-bf152a02a999, 'Hummm....', '2006-01-27T19:55:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315720, cca71f11-808f-4ac6-aa03-077818b5035e, 'Délicieux et si facile à réaliser ! (fait sans les nounours)', '2015-08-11T16:04:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315720, d461f67e-e49d-46e8-b392-55a13bea9d61, 'Super bon, facile à faire ! J''adore ! ', '2016-01-17T18:07:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334872, ed35cfa4-9073-4c2a-abc2-7657e243669a, 'Trop de bananes à mon avis. La crème n''est pas assez sucrée à mon goût bien que j''ai choisi des bananes bien mûres. Le biscuit est plutôt sec et manque de saveur. Je ne referai pas cette recette.', '2016-10-17T09:38:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337957, 770d46af-b5e6-4251-be6a-83687555fc68, 'Tout bonnement délicieux !', '2015-07-08T17:02:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (313158, 9e47a90b-bdf0-40ab-a7ae-a8ccc19fd756, 'Vraiment délicieux ! Recette assez délicate, il faut être patient et ne pas avoir peur que ça tombe; je pense que ça vaut le coup de tester car le gout est particulier mais vraiment délicieux ! ', '2016-11-02T13:21:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (313158, 0810efbf-66a6-4002-a70a-b0f468457584, 'Je viens de faire cette recette... Une catastrophe ! Je mets deux quand même 2 sur 5 car c''est pas mal visuellement et ce n''est pas mauvais en goût. Néanmoins, le nappage est une catastrophe, les paillettes ou sucre coloré ne tiennent pas, ça coule, ça dégouline ! Deux boules sont même tombées malgré les piques préalablement trempés dans le chocolat comme indiqué dans la vidéo associée. Enfin, c''est très bourratif. Je pense que plus de la moitié partira hélas à la poubelle... ', '2014-02-14T16:15:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19477, 27342c24-b5c5-482c-babf-5197562da8d4, 'J''ai mis des yaourts sucré à la place de nature et donc 1 sachet de sucre vanillé en moins ! Super recette, j''adore !', '2013-02-04T14:42:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19477, b51b807e-8f15-41b6-9709-dd6166ce5cff, 'Frais et délicieux, petits et grands ont beaucoup apprécié. N''aimant pas les litchis, j''ai préféré les kiwis, et j''ai accompagné de petits sablés maisons, après un repas léger c''était très bien.', '2007-12-04T10:21:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19477, c76fd8af-982e-496c-8f6e-979541e8c979, 'Très frais et très bon. Plaît aux grands et aux petits.', '2005-12-30T14:29:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19477, f27c1c7a-cfd3-4789-b5f3-59bd042c2cc3, 'Les litchis dans la salade Sofia... Mouais. Je ne mets que des oranges et des des bananes l''hiver. Et en été, des fraises et du melon.', '2004-07-04T20:52:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19477, 4ecb0da4-480c-4ace-aa3c-0b218feaaf3c, 'Excellent ! de plus c''est très intêressant de varier avec pleins d''autres fruits !', '2003-07-22T15:14:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16362, 382756c6-73e6-4f81-889d-d8e543015f2f, 'Ce n''est pas du tout du bavarois, ni à l''aspect, ni au goût; c''est une charlotte, facile ça oui, pas mauvaise, mais rien d''exceptionnel non plus...', '2008-08-24T19:57:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16362, 69f11ad8-2092-48b9-b8ce-f84a4521cef9, 'Super bon! Simple et rapide, j''ai juste monté ma crème fraîche en chantilly et sucré un peu mon lait. Vraiment très bon, léger, idéal après un repas copieux. PS: je suggère de servir avec du chocolat noir fondu.', '2006-11-16T12:55:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16362, 0e12a1f8-2639-47fe-a414-c70db3fa4346, 'Délicieux, et très rapide et facile à faire. La recette est inratable!!!', '2002-05-21T12:53:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166076, 6cf2b5c6-9462-41ea-8ca9-9832ffa79829, 'Très facile à faire ! Préparées pour le dîner... J''ai ajouté pour la déco quelques fraises coupées en 4 pour dessiner une fleur.  Hormis la découpe et l''émiettage de Granola, ma fille de 5 ans et demi a réalisé la recette toute seule !', '2016-04-16T21:10:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166076, 0fd03a04-81b4-49bc-91fa-44e537df53e5, 'Moi j''ai remplacée la banane par une poire qui passe super aussi avec la cannelle. Et j''ai rajouté une cuillère à soupe de mascarpone battu avec du sucre. Un délice, très rafraîchissant !', '2011-07-23T18:29:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, 4a91c5ef-003d-43e1-a671-96f7066ae963, 'Meilleur en utilisant de la banane plantin.  Pimenter pour une version plus créole... ', '2018-07-12T07:01:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, dcdcd362-b0f6-4de3-b868-6a22860a54bf, 'Gras comme on aime', '2014-12-15T00:24:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, 25452670-a7dd-40bf-b564-1fc758af3932, 'Réalisé sans la menthe. Un mélange sucré/salé comme j''adore.', '2018-07-24T09:03:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, c9316091-1501-41b6-bac9-9dddee0fdf36, 'Facile et rapide. Au barbecue, laisser cuire 5 min sur chaque face.', '2013-06-02T15:27:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, 183eacdb-b5f8-4824-a8d0-b978e344ad87, 'J''ai remplacé les bananes par des Fei (banane cuite) que l''on trouve en Polynésie française. Ca a été très apprécié en apéro par les petits et grands...', '2013-02-13T05:02:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, 0165082a-bcbb-43da-9cd6-899dbc48f2a5, 'Remplacez au plus vite les bananes par des pruneaux...Un peu plus laxatif , beaucoup moins pâteux!', '2006-05-09T23:29:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, bd838759-9c6b-4add-b34b-745f42e6ac48, 'Faites pour un apéro "créole" avec ti-punch, boudins antillais, et accras de morue... ces brochettes, très originales, ont eu beaucoup de succès. Je n''avais ni moutarde, ni menthe, sous la main; mais la prochaine fois, je suivrais la recette à la lettre.', '2006-04-20T19:49:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, 1ac8157c-ed02-4e75-ba8a-4b9c3ce3067a, 'Recette originale, surtout prenez des tranches de lard très fines, de la moutarde à l''ancienne c''est super bon et très rapide à faire!! ', '2005-08-14T13:31:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, a91b6351-f256-48ce-83f6-cdfc0c177b7f, 'Recette simple, rapide et économique comme je les aime... Toutefois, je dois avouer que je l''ai trouvée un peu écoeurante.', '2005-07-31T23:48:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, 93adcd09-e8ae-48ff-a9f9-6a393331d8e1, 'Avec du jambon c''est bon aussi.', '2005-07-23T01:03:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, 33ac4da2-4bd3-4b0e-8d4f-c4014a81de2b, 'Les invités ont bien apprécié mais je vais essayer en mettant un peu plus de menthe et de la moutarde des deux côtés. Fait au barbecue, c''est un délice!', '2005-06-04T22:18:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, cd0cdd8b-d65e-4bfc-8607-0196bef0646f, 'Moi je l''ai fait en utilisant une banane plantain.', '2005-05-03T10:04:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, 920bb0c0-c2aa-4651-9ce8-940167cc398f, 'Original mais pas exceptionnel. Ca épate les amis, mais ça ne les régale pas!', '2004-11-07T17:26:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, 570bc458-1a0a-4881-801e-2ea77d5e99ee, 'Recette originale, parfaite pour les apéros améliorés. Je ne mets pas de menthe, je moutarde fortement chaque côté de banane et je les fais cuire à feu moyen au four durant 5 à 7 mn. Un délice...', '2004-09-02T18:16:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, b9df1113-4bfe-415c-a150-a1a1edf43a3a, 'J''ai mis de la moutarde à l''ancienne, au barbecue, c''est délicieux.', '2004-06-30T16:09:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, bfb804bb-71f0-4608-b857-ce80f8733ba6, 'Original et bon... Je les ai préparées au grill du four, ça a plu. Par contre, j''avais peur de mettre trop de moutarde, du coup je pense que je n''en ai pas mis assez!', '2004-05-24T18:33:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, a66d78f3-ade2-4d2c-9cd9-9fb25c55e7d8, 'Un peu gras il est vrai mais délicieux !', '2003-07-16T19:15:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, df60b528-d0b9-40f0-9041-86d3a9b42efa, 'Pas mal et surprenant et super facile à faire.', '2003-07-14T17:36:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, d60da61b-272f-41a7-b169-9819c78ffb1e, 'Très apprécié, même si les gens sont d''abord étonnés du mélange! Ne pas prévoir un plat trop copieux ensuite.', '2002-08-07T14:59:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, 4a4d6afd-8d17-452a-acf8-4ad43fcbaafd, 'Très très bon... Original. Mais 1/2 banane suffit par personne! ;-)', '2002-07-27T15:17:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14727, 80abfc3c-562d-46fc-a3e3-3ff8efc3f019, 'Génial, super bon au barbecue. Surélevez légèrement la grille du barbecue pour que le lard ne grille pas.', '2002-07-08T09:44:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339559, ec2bcca3-0056-4f02-afd2-b50f8c699332, 'Dessert simple et délicieux ! La prune et la banane juste parfait !', '2018-08-16T17:44:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339559, 1374ed15-20d0-4f80-8812-d385ccc99645, 'Excellent j''ai suivi la recette mais j''avais pas de banane. il était tout de même super bon. je vais réessayer avec la banane. il doit être encore meilleur.', '2015-08-21T17:02:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73588, 3e81bbf7-2676-4d13-b936-87458952c0f7, 'Fait avec moins de lait, moins de sucre, du sucre roux et sans sorbetière (mixer 4 fois en mettant 45 min au congélateur entre chaque "mixage". Un régal !', '2011-05-25T20:48:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73588, 8340a73b-3ef0-4e42-8793-f4acfc5b4d3c, 'C''est bon  et simple à réaliser', '2013-08-28T15:35:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73588, 31a61ecb-5ca9-48f1-96d0-cc512b77d33e, 'Léger et acidulé. ', '2011-07-20T23:15:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24316, 02b5a241-f757-4945-87fe-68a2c3fac2c8, 'Bon goût mais la pâte était trop liquide pour moi', '2014-06-24T14:48:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24316, fa688943-df20-448c-b803-b11a68ca7edf, 'Vraiment très bonne !', '2014-03-05T19:16:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24316, d1b8b6b6-03d5-40ac-8317-411bf75044d0, 'Trop bon.', '2013-02-13T18:40:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194311, 560d1cf1-75c8-4d2d-abd4-ae7a9655106c, 'Bonjour, je viens de faire les bricks... je suis un peu déçue, je les ai cuites au four comme indiqué, mais la prochaine fois je les ferai à la poëlle avec un petit peu de beurre et une goutte d''huile, elles seront plus croustillantes et savoureuses... ', '2016-12-24T12:51:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13452, 21a079ce-6c1e-489c-ae01-f105b6364c2f, 'J''ai mis du lait à la place de la crème fraîche c''est plus "léger". En attendant c''est une bonne utilisation pour les bananes mûres, merci bien!', '2009-02-12T18:20:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13452, bbd5607f-dfbf-4612-9e81-73e150fe52fb, 'J''ai toujours fais ça en dessert : on remplace la crème fraîche et le yaourt par deux petits suisses natures... ca a un aspect assez peu engageant, mais c''est délicieux!    ', '2007-11-19T04:37:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13452, ab08043c-4152-43c6-ac94-dadd1872eb07, 'Délicieux ! Je mets aussi d''autres fruits (pommes, poires...) et ma fille de 2 ans 1/2 raffole de ce goûter. C''est sain et bon pour toute la famille.', '2007-07-17T15:57:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13452, c4b5ad92-7203-4c36-a6eb-f19fd3b3e25d, 'Super sympa! Je l''ai préparé avec les saucisses et la moutarde de dijon: mes enfants adorent !!', '2006-10-04T18:38:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13452, 962f544e-e4d3-4cec-9afd-4a3396cdec6e, 'Personnellement, j''ai essayé avec des courgettes de <pologne farcies à l''escargot grillé, c''est encore meilleur!...miam! ;-)', '2005-08-25T01:26:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13452, 97f4d2c4-0079-49c0-9aa6-8e0ea68933bd, 'La recette est vraiment délicieuse, je ne l''oublirais pas et je la recommencerais!', '2005-04-26T18:13:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13452, 24938853-e6db-4f82-9ead-564ed4693f43, 'Miam! Ca tasse bien l''estomac mais qu''est-ce que ça réconforte!', '2005-04-12T12:35:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (348234, af27820e-b1e1-4913-809b-2866b8956a9d, 'Délicieux. La texture est collante on en a plein les doigts.  Ne pas hésiter à mettre de la farine. 
', '2017-08-24T22:23:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (348234, 580744e6-b7f6-451f-b4e1-ea3ed9c0fe16, 'Bonne recette, j''ai mis un peu plus de framboises, toutefois, je ne suis pas parvenue à former des boules. Aussi, je rajouterai plus de pistache car je n''ai pas vraiment senti le gout. Toutefois, bonne recette que je referai avec plaisir :) ', '2017-08-28T19:31:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (348234, 79fec8f5-5397-41bc-9b9d-83ce6f199980, 'Délicieux !', '2017-08-24T14:12:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (348234, a5e00f67-282e-4fd7-9b7f-2813bf275f68, 'C''est très bon, j''ai rajouté une bonne dose de farine et un peu plus de framboises comme mentionné dans d''autres commentaires, mais j''aurais pu ajouter plus de framboises', '2021-06-05T17:47:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (348234, 6f3368e6-9635-4261-bdee-6baa2448bb0a, 'J''ai préféré faire un coeur au chocolat, donc je n''ai pas essayé la touche framboises, mais très bonne recette!', '2018-08-13T03:07:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57083, 99676b3c-e65d-4767-ab3a-29f5b714e0c9, 'Très bon, j''ai remplacé la banane par un autre kiwi ! A refaire !', '2012-11-08T14:06:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57083, 4cb28bfc-a627-493d-90b5-74236bd09ddf, 'Très bonne recette, l''acidité du kiwi est très appréciable ! A refaire !', '2011-09-14T15:18:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57083, aa96ee65-ba1d-4b3d-85f3-d78277bd61cc, 'J''ai mis 3 kiwis et 2 bananes pour avoir plus le goût du fruit. J''ai trouvé la tarte encore meilleure une fois refroidie. Très bonne recette !', '2010-11-22T11:43:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57083, c957df6a-e5bf-48fe-a7d6-d77f3fdb37d8, 'Quel succès !!! Je l''ai parsemée de coco râpée avant de l''enfourner, elle s''est faite dévorée par petits et grands... Merci, à refaire', '2008-05-28T17:53:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, dabda543-9e27-494f-81d9-4158c7dc0157, 'Testée avec de la farine sans gluten, j''ai fait dégorgé la rhubarbe en cubes dans de la cassonade et mis un peu moins de sucre qu''indiqué. J''ai utilisé des petits moules silicones (15 min de cuisson pas plus sinon, ils perdraient de leur moelleux !). J''ai mis plus de rhubarbe que dans la recette et une seule banane, c''est DELICIEUX ! Yumi', '2016-06-20T23:17:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, acc39c2e-fb29-4dc8-bb21-3c292c4d4a4e, 'C''était vraiment très réussi ! J''ai mis un peu plus de rhubarbe (pour ne pas gaspiller ce que j''avais coupé en trop) et la quantité était parfaite !', '2016-05-04T18:22:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, d5b0e92a-46e8-44d6-bc07-0fd767f740b7, 'Bien gonflés ! Je mettrai un tiers de rhubarbe en plus et un peu plus de sucre la prochaine fois. ', '2010-06-20T11:53:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, deb5ea7c-f009-4d29-9bb0-7b5a7a4a3b32, 'Je fais la recette très souvent c''est devenu un grand classique à la maison, j''ai essayé avec des morceaux de pommes dedans c''est aussi très bon, mais le meilleur est la recette originale, excellent!', '2009-01-03T11:57:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, dd68375a-1235-4a86-8a65-ec75d834e167, 'J''ai remplacé la rhubarbe en dés par de la compote de rhubarbe maison (5 c.a soupe) que j''ai intégrée au mélange liquide et mis 100g de sucre seulement. Vraiment délicieux! Bien moelleux, ils n''ont pas fait long feu. Merci pour cette recette.', '2008-05-05T19:11:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, 5b6e70dc-2a86-4cc8-9af3-4465fdc0b583, 'Facile mais je n''aime pas trop le mélange.', '2020-11-20T19:44:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, 0551d106-0ea3-4974-bfd2-e48fa7a383fd, 'J''ai rajouté une cuillère à soupe de rhum, excellente recette et muffins bien gonflés avec 2 bonns cuillères à café de levure chimique ?', '2020-05-10T18:23:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, 0b09ab70-4dbd-4923-a6fa-9cbc60a92eed, 'Vraiment délicieux et surprenant.
En plus c''est très rapide a faire', '2019-06-19T07:59:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, 511920c2-a7f9-4720-a2f3-2b99af06ccd2, 'Muffins très moelleux, accord banane/rhubarbe délicieux, équilibre entre les goûts parfait. Merci pour cette recette !', '2017-03-07T17:55:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, b73a7904-dad2-4f68-a53f-2c0f229c2c9e, 'Bonne réussite ! il faut aimer un peu l''acidité de la rhubarbe ', '2015-05-22T12:22:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, ecc35a5a-d7ca-48e9-b790-f3891af6fd36, 'Très bons muffins ! A faire sans hésiter ! ', '2014-05-14T23:06:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, 9101603b-5a75-4014-a4f0-e70f37edb68f, 'Très bonne recette. Moi, je mets 300 g de rhubarbe. Cette recette a converti les personnes n''aimant pas trop l''acidité de la rhubarbe. ', '2013-06-17T16:58:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, 7c51af53-89b9-450b-aea1-5e954e9596b4, 'Le mélange rhubarbe et banane ne nous a pas plu du tout. De nous 4, personne n''a aimé pourtant nous sommes des inconditionnels de la rhubarbe. Désolée.', '2011-10-07T18:33:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, f6a8bc76-ff35-4ef2-b811-de07a373d6f5, 'Essayé pour un enterrement de vie de jeune fille, on a toutes adoré : fondant dedans et craquant dessus.', '2011-06-24T13:08:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, a18471d9-a281-42a9-89a8-25059cfa9254, 'Super recette, tout le monde s''est régalé, muffins bien moelleux, je mettrai peut être un peu plus de rhubarbe la prochaine fois. A faire et à refaire sans hésitation.', '2010-08-22T13:06:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, 68fc1171-9935-4128-ad2e-57c44a1ee3b9, 'Je n''avais que des petites bananes et on ne sentait pas trop le goût. La prochaine fois, j''en mettrai une de plus.', '2009-09-17T14:08:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, 0bfe4316-ed25-4d94-9747-62529c29d46b, 'Vraiment tip-top, j''ai servi les muffins avec un coulis de fraises fraiches, et vraiment, quel régal : merci.', '2009-05-22T13:46:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, 991ce7d1-eb84-4016-afee-a9bd8b3e8013, 'Je cherchais un dessert à base de bananes qui trainaient dans ma cuisine....Moi qui ne suis pas fan de gâteaux à base de banane, là j''ai adoooooooooré ! Mes enfants aussi d''ailleurs ! J''ai suivi scrupuleusement la recette à part avec la rhubarbe : je l''ai faite égoutter avec du sucre roux pendant 15/20 min.  Un régal !!! ', '2009-04-22T17:17:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, 617d6416-fab8-4663-8b2e-80e20fd02a6d, 'J''ai utilisé de la rhubarbe surgelée et je n''ai rien changé à la recette: le résultat est succulent!', '2008-05-29T19:02:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, 4dcfb7ad-eeb4-4ac4-b6cc-d00251d62bb3, 'Recette très facile, j''ai juste modifié les 5 cl d''huile par 4 cl d''huile et 1 cl d''eau.  Résultat parfait entre la douceur sucrée de la banane et l''acidité de la rhubarbe.', '2008-04-19T23:16:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48940, 52b6a867-8f1f-4fda-821a-d12a39b801d6, 'Un délice! Rien à changer à la recette! ', '2006-09-15T14:31:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27615, 63c631ac-3361-4c82-9c47-e31478487437, 'Excellent. Chéri et moi la referons. J''utiliserai néanmoins moins d''huile.', '2012-02-15T13:54:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62867, d482dfe9-11e4-48e4-8240-b683da425aeb, 'C''est vraiment trop bon. Ces fruits pas trop cuits qui croquent encore un peu. Le poulet bien cuit, pas sec qui se mange sans faim. J''ai juste ajouté un peu de coco en poudre pour une touche un peu plus exotique. Merci pour la recette.', '2007-12-23T19:04:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62867, 9e62cd0e-a70b-4570-b907-80899ef065ff, 'Plat préparé lors de la rencontre au GD de Luxembourg. Tout le monde a apprécié.', '2007-11-30T16:19:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62867, 313b7f27-99ee-414d-8380-4f771b9308d2, 'Ce plat mélange salé/sucré. Il est vraiment très bon. De plus, il est rapide et facile à faire. Pour ma part, j''y ai ajouté un peu de crème fraîche. Merci pour cette recette.', '2007-11-21T14:05:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42762, 85282e1e-b9a0-428d-b78c-c6b5f46b03e3, 'Excellent ! J''ai aussi doublé les doses de pâte à crumble. Pas de compote de poire ni de rhum juste gingembre/cannelle, c''était parfait ! Merci !', '2011-02-14T17:56:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42762, 8bb39241-4ad3-44d9-ac9b-82a56f97c206, 'Goût certes exotique, mais pas terrible.', '2011-02-06T13:07:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42762, 38f2fcf8-2b4a-4bd4-b637-aba4a4fd03f0, 'Tout simplement succulent!! Ne pas hésiter à doubler d''office les proportions de la pâte crumble . Mille mercis pour la recette !!', '2009-05-02T00:14:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42762, 5816e94b-2ba7-469e-8e19-863533d91ed4, 'Tout simplement délicieux pour deux grands mangeurs de litchis, je l''ai accompagné d''une salade de framboises fraîches au sirop de rose. Je n''ai mis personnellement que des litchis mélangés à la compote de poire comme conseillé. Merci pour ce crumble unique en son genre!', '2006-08-17T17:03:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42762, d64bdc11-bbe6-4eb9-8cfe-b4e70a84a9f7, 'Un succès fou après un repas asiatique et donc riche... crumble délicieux, léger et terriblement exotique!!! L''ayant préparé pour 8 personnes, j''ai rajouté aux fruits initiaux une boîte du mélange papaye, goyave et ananas et de la mangue ... vraiment que du bonheur pour les papilles !!! A faire absolument ! Mille merci pour ce crumble !    ', '2006-03-26T22:12:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42762, aef717e0-56d3-4cce-a404-d4762e6769ba, 'Extra! Succès total lors d''un dîner entre amis !', '2006-01-06T18:21:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45363, e0da0552-8c57-4006-b1c9-3e1cb1e309b4, 'Trop bon.', '2019-09-03T18:59:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45363, 1f76dc64-096d-4764-9927-b4a321fc2a6e, 'Recette essayée une fois il y a deux ans, mais les enfants n''ont jamais voulu retenter l''expérience, ils n''ont pas aimé du tout.', '2011-01-05T18:58:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45363, ab94056c-bd55-47b8-93d8-6c145cdfcf84, 'Ayant lu les 2 premiers commentaires, j''ai préféré éviter la sauce Béchamel, donc, c''est avec une briquette de ''Sojasun pour gratins'', que j''ai préparé ce plat. Enfin une recette où le temps de préparation est effectivement respectable : 10 min montre en main ! Et perso, j''ai doublé la dose pour le curry : résultat EXCELLENTISSIME : la banane perd son goût sucré entourée qu''elle est, de jambon, et le curry réhausse le tout accompagné qu''il est d''emmental râpé!', '2008-03-24T17:44:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45363, a44e0eae-a938-438d-9b28-4297d9a8615d, 'Nous n''avons pas trop aimé cette recette, c''était un peu lourd. Personnellement, je préfère "arroser" les bananes au jambon de crème fraîche légère, je trouve ça bien meilleur.', '2006-05-07T21:38:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45363, 794a421d-c08b-4d9e-b3db-203c4c6b5fe9, 'C''est excellent! Une des meilleures recettes salées à la banane que j''ai essayée.', '2006-03-15T21:55:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, 1dfc4977-bd6c-414e-b376-875742167eb8, 'Je ne le trouve pas terrible tiède (contrairement à la plupart des crumbles) mais par contre excellent après quelques heures au frigo ! ', '2013-10-08T12:42:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, 92338270-2d60-4b1c-9636-1dce3cd3dc4d, 'Un délice, mon mari adore ! Et facile à réaliser. ', '2013-08-27T22:20:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, b778cedb-a503-4c83-a3f9-b7cb2de08d54, 'trop de beurre à mon goût. ', '2013-05-09T07:24:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, 3664d472-a8d6-4cfc-b9f7-e51f092364e4, 'Résultat pas terrible : s''effrite quand on le sert et les écorces de citron donnent un goût particulier.', '2013-04-02T02:11:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, 281f8e7a-382a-4c98-9611-31dbcef1c589, 'J''ai adoré ! Un vrai délice. J''ai juste dû mettre un peu trop de jus de citron, car il y en avait pas mal dans le fond du plat.', '2013-03-14T15:37:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, 48961d17-2ae2-4df5-aa93-fc54decd60d2, 'Mettre un peu moins de citron vert.', '2013-03-02T14:19:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, 749b2a11-c3af-4f8f-8159-fbe38cae569d, 'Tout le monde a adoré ! Ne pas hésiter à mettre un peu plus de jus de citron pour plus d''acidité et à réduire un peu la dose de sucre, les bananes sont déjà bien sucrées! ', '2013-02-09T21:43:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, 78c91cdf-6469-40ab-a305-9ced77b1f6bf, 'Excellent !!!', '2013-02-08T14:35:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, 7f6631a8-7023-478c-9d2b-32a721d75eab, 'Je l''ai testé ce week-end en le partageant avec des amis, original, ça change un peu...J''ai adoré le mélange des différentes saveurs, la douceur de la banane, avec le gout acidulé du citron vert, puis la petite touche exotique avec la noix de coco, trés facile à faire, et divin !!! A tester...', '2013-02-04T14:23:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, dd5afb9a-c03b-4901-a184-e65927445412, 'Excellent mélange. En revanche, il y a un tout petit peu trop de sucre, attention au dosage. En tous les cas, je recommande !', '2013-02-03T20:01:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, 51b73102-e3e5-4663-bb99-075a935cb6b8, 'Des saveurs originales mais épongées par trop de beurre. Il est rare pour un crumble de ne pas mettre de farine pour les miettes, ce qui fait qu''on a l''impression de manger des fruits au beurre, je n''ai pas retrouvé la texture du crumble.', '2013-02-03T01:04:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, 32938c29-d819-4c1e-813c-211601edf769, 'Recette top ! J''ai doublé les quantités et j''ai eu 18 cookies. Ils ont été dévorés ! Effectivement le marteau est effectivement l''arme la plus efficace pour concasser les m&ms et fait de beaux morceaux ! Délicieux !', '2013-02-02T19:49:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, 505b471d-e178-47d9-854d-a836bea84b1a, 'Très bon, malgré un crumble très sucré.', '2013-01-31T01:34:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, 812adf05-18d6-4f38-89f2-70bb6f835f84, 'Très frais, exotique ! Je n''ai mis que 4 bananes. Suffisant ! Je ferai l''essai avec de l''ananas ! Merci facile et rapide !', '2012-03-04T17:01:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, 4ee4b0f3-43ab-49eb-8791-105cba346d5a, 'D''une simplicité enfantine à réaliser, et délicieux. J''ai ajouté juste un tout petit bouchon de rhum, mais je pense, la prochaine fois, le servir avec un petit peu de chocolat noir fondu. Merci pour cette recette !', '2011-10-19T23:04:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, 72936b36-6c53-4112-a920-de66451b391b, 'Trop top ce crumble !', '2011-05-05T15:34:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64958, 00f080ed-57e5-4002-a6c5-b5947619b813, 'Un dessert qui change! Des parfums très exotiques, et c''est hyper simple à préparer. Merci beaucoup pour cette recette.', '2008-01-04T10:45:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (225515, 05561a4d-811b-4477-8170-62ff00223a1e, 'J''adore', '2013-06-29T00:22:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (318806, bf17cf5c-e439-4507-b94f-92124f327021, 'Très bon !', '2024-01-27T16:00:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (318806, 046a837b-5c54-42b6-8f4b-1e932fbe7720, 'Matière un peu désagréable mais très bon', '2023-03-05T11:24:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (318806, de240937-0d7f-4f3a-ae83-d86738266c53, 'Rapide et facile à faire. J''ai remplacé la cannelle par de l''extrait de vanille. Délicieux !', '2019-05-05T14:06:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347547, 94e68035-1c4c-4dec-b339-2af1d1d891d6, 'Pas mal', '2019-05-30T11:57:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347547, 21a69b35-55c8-444a-8e97-fdb0249eb100, 'C’est divin ! J’ai utilisé un lait protéiné un peu sucré à la vanille, des baies, le jus de l’orange... mais alors le gingembre donne un goût exotique succulent !', '2019-04-25T01:09:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347547, 18e9a6f5-a41b-437a-a029-2048ab07ead0, 'Vraiment très bon.', '2018-07-10T03:07:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347547, 1a3e1bf0-98cb-47f4-82cc-531f4cf5d3fb, 'J''ai remplacé le lait de soja par de l''eau de coco (pour ceux qui n''aiment ni le lait ni le soja)', '2017-07-22T07:17:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347547, 4af13ab4-a754-4b20-8856-034d2e578086, 'Bien', '2017-07-19T05:01:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347547, 39522093-0869-4852-99aa-a384d65443bb, 'Personnellement je remplace le lait de soja par du lait de vache classique!! ', '2017-05-07T14:18:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15346, e58eb063-bbde-49b0-90db-7a6a035e6d41, 'Cette recette fait partie des merveilles de la pâtisserie anglaise! Découverte durant mon séjour outre Manche, y penser me fait saliver... un délice, à déguster lentement pour éviter un alourdissement précoce! Mon conseil : remplacez la pâte brisée par des "shortbread" émiettés (biscuits écossais) et mélangés au beurre fondu. Pâte idéale!', '2006-11-21T19:14:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15346, 327af936-d997-4291-872a-baaccf18a8a9, 'Je préfère également les biscuits écrasés avec du beurre pour faire la pâte... Petit conseil pour accélérer le processus de cuisson du toffee : placer la boîte de lait concentré dans une cocotte minute et couvrir complétement d''eau bouillante. Fermer la cocotte, laisser "siffler" 45 min et c''est prêt ! Ça permet de gagner 1h ou 2 sur la cuisson au bain-marie qui est super longue et ça laisse plus de temps pour la dégustation...', '2011-06-04T18:55:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15346, e5dc1ae9-3126-467e-8287-dc213b0d420c, 'Je suis d''origine anglaise et dans ma famille installée en France pour le fond le meilleur équivalent qu''on ait trouvé ce sont des biscuits type granola écrasés avec un peu de beurre. Oui c''est lourd mais c''est tellement bon.', '2009-01-09T13:28:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15346, 29b1a42c-63be-4611-b6db-d328191cb8a8, 'Personnellement, je l’ai toujours préparé à base de shortbreads mixés bien tassés, double crème fouettée avec sucre vanillé et du cacao saupoudré sur la crème au dernier moment. J’ai aussi tenté les verrines, plus facile à transporter. Je n’ai jamais vu de banoffee avec du café.', '2019-05-23T12:39:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15346, 357f590d-bc83-416b-a804-fa2420b77347, 'J''avais goûté le banoffee pour la 1ère à Toulouse et j''ai vraiment retrouvé le même goût que la bas, par contre le sucre j''en mettrais très peu 30 g ou voir pas du tout parce qu''avec les spéculoos et le mascarpone ça fait beaucoup sucré, mais sinon la recette est excellente, merci.', '2012-04-09T09:58:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15346, e816efd9-8ba5-4615-b038-14b853afc08e, 'Très bon mais vraiment trop lourd...trop gras...presque comme s''enfiler un pot de nutella à la cuillère! A essayer pour le réconfort après une rupture par exemple!', '2005-03-15T11:22:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15346, def524c9-f09a-4979-b481-38e74677985c, 'Très bon. 9/10 de la par de mes convives', '2022-01-29T16:54:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15346, ab9513b4-378f-4a5a-87bd-ceb93494c06a, 'Spécial, très sucrée !', '2021-03-21T20:41:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15346, 945e292a-893b-4936-b196-2f3030d204cf, 'J''ai fait cette recette 2 fois, les 2 fois avec des biscuits écrasés plutôt qu''une pâte, mais la 1ère fois avec du lait concentré, j''ai trouvé la tarte beaucoup trop sucrée et vraiment écoeurante (pourtant je n''avais même pas ajouté de sucre), mais j''avais quand même envie de la refaire car je sentais le potentiel. La 2ème fois j''ai donc mis de la confiture de lait au lieu du lait concentré, et c''était pour ma part vraiment meilleur ! Mais bon mon mari a préféré la 1ère donc ça dépend des gens.', '2015-05-20T11:10:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15346, df725732-a52e-4c00-bbbb-e145677e4d39, 'Succulent et inratable. J''ai remplacé le café en poudre par des noisettes caramélisées et utilisé des ramequins individuels  (la préparation ne se démoule pas). Les invités étaient surpris et ravis...', '2003-12-26T18:43:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15346, 89ac6f0a-1ce2-4d4e-a003-12a65e5ea7e0, 'Absolument délicieux! La pâte brisée peut être remplacée par des biscuits type palets bretons réduits en miettes et mélangés à du beurre fondu pour en faire une pâte plus savoureuse.', '2003-12-07T22:09:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42688, a55504c1-3dbb-4fea-9d77-c85216664960, 'J''ai également fait le crumble que je fais habituellement : du beurre au lieu du mascarpone, et pas de noix de coco pour ma part. Le résultat est délicieux si l''on dose bien les fruits en fonction de leur saveur, je l''ai fait accompagné de mousse au chocolat blanc et mousse au chocolat noir.', '2012-12-28T03:01:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42688, aad47075-5273-49b8-a3bb-a6508880184d, 'Un régal !!! Les invités ont adoré... à la fois frais et gourmand. Par contre j''ai écouté les conseils des commentaires précédents, je n''ai pas fait le crumble avec du mascarpone mais avec du beurre et mis que la moitié du mélange, c''était parfait.', '2011-11-03T20:05:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42688, fbb1faca-7474-4acf-b338-d15f0d68da95, 'Je suis d''accord avec le commentaire de Stéphanie. Je garde la recette mais avec un crumble à la noix de coco classique, sans le mascarpone. Je suis fan du mascarpone mais dans cette recette, cela retire le coté croustillant du crumble et la pâte est bien plus dure à effriter. Les invités ont semble-t-il aimé quand même, mais je suis restée un peu déçue.', '2007-03-17T11:46:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42688, 787dfa41-b64f-482e-b230-b03eda6e3656, 'Mes invités se sont régalés mais personnellement j''ai été déçue par le crumble au mascarpone. Difficile à travailler en sable il devient tout de suite plus mou et forme un genre de pâte. De plus je le trouve moins croustillant qu''au beurre à la cuisson et plus fade au goût. Je garde cette recette que je referai avec un crumble au beurre classique. Je l''ai servi en ramequin individuel juste tiède avec une boule de glace vanille dessus. Nous nous sommes quand même régalés...', '2007-02-04T17:18:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29371, 08f7cea1-21ad-43f0-ba09-35e8a564ef89, 'Pas mal, mais pas excellent non plus ! Mon cake s''est cassé au démoulage, donc pas top pour la présentation. De plus, je trouve que les goûts se mélangent de trop pour qu''en en profite bien.', '2009-09-05T17:00:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29371, 34ce7c3c-a0f1-4b8c-81e4-a2405c45a1ca, 'Absolument délicieux. J''ai utilisé un mélange de fruits secs comme conseillé par l''auteur de la recette, et je l''ai présenté avec une crème anglaise.', '2005-06-01T15:37:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29371, 4594aa6a-8c43-489f-ac0c-2cd2a9b8c78d, 'Il est très bon.', '2004-10-08T13:51:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29371, 31836333-ef8d-421f-9e8b-2a7daf17b347, 'Tout simplement délicieux !', '2004-09-10T16:06:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22437, 4e4caf08-aa36-4cfb-a621-12cb01d28eaa, 'J''adore ', '2020-10-31T19:43:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22437, 9ba822a7-1613-4589-bd4f-63e926606bb8, 'J''ai rarement mangé quelque chose d''aussi mauvais. J''adore la plantain, j''adore la patate douce... Mais ce gratin tue à la fois le goût de la plantain et celui de la patate douce. Je n''ai retrouvé le plaisir ni de l''une ni de l''autre. L''ail et le goût laiteux de la crème dominent et la muscade ne va à mon goût pas du tout avec. La prochaine fois je me contenterai de les cuire ensemble et de les passer au four avec un peu de beurre et de piment...  Pour faire écho aux remarques sur la cuisson des bananes, j''ai fait cuire les plantains (jaunes) pendant dix minutes et après passage au four, elles étaient encore fermes.', '2016-05-31T12:44:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22437, acfbb5dc-6e84-4773-8948-b968311d7ff7, 'Le résultat était savoureux mais j''ai eu quelques petits déboires avec la cuisson. Les bananes plantains sont en général assez grandes donc c''était difficile de trouver un récipient suffisamment grand pour les immerger totalement (sans les couper puisqu''il fallait les cuire dans leur peau). Je les ai donc cuites deux fois 5 minutes : d''abord une extrémité puis l''autre (celle qui était restée en dehors de l''eau). Au final, elles étaient bien tendres (il faut dire qu''elles étaient très mûres). En revanche, je pense que j''aurais pu laisser les patates douces 15 à 20 minutes dans l''eau bouillante. Ou alors il faut de toutes petites patates douces (j''ai utilisé des patates d''une taille moyenne). Ou faire des tranches plus fines ensuite... Toujours est-il que, dans mon gratin, ce sont les patates qui n''étaient pas assez cuites. J''ai dû prolonger la cuisson au four de 20 minutes.', '2016-02-04T21:15:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22437, 5b166806-ecf0-4a71-86f6-5e971efe0765, 'Pas déçue ! Avec les bananes (cuites plutôt 10 min), et une tranche de jambon entre chaque couche pour le contraste des goûts.', '2013-02-20T21:58:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22437, 893e638e-77b5-46f0-830d-ff9229b6d293, 'Merci, j''ai écouté les autres commentaires je n''ai pas mis de bananes, et j''ai mis que de la crème fraiche liquide.', '2010-02-05T16:12:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22437, 5a746a0d-267b-4c68-bfc4-8081d1ffdaa0, 'Je n''ai pas réussi à bien cuire la banane donc un goût vraiment particulier. En revanche la patate douce est un régal préparée comme ça', '2010-01-18T20:22:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22437, 38b0845f-a36b-4c99-a1f1-5c487bf08ca1, 'J''ai fait la recette sans les bananes uniquement la patate douce et c''est délicieux. Recette simple, originale et très savoureuse. ', '2009-02-24T15:02:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22437, 622e1052-f27c-4478-ad39-a4ee7080e902, 'Cette recette n''a pas plu du tout aux enfants. J''ai trouvé bon sans plus. La recette manque d''originalité à mon goût, contrairement à ce qu''ont pu penser les autres. Assez gras aussi. La patate douce étant assez sucrée de nature, je trouve qu''elle se marie mieux avec du salé. Ou peut-être il suffit de rajouter un autre ingrédient, des lardons ou quelque chhose ?', '2008-09-28T16:44:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22437, f6968aa4-cd25-4d32-8708-c2d3a148a8ac, 'La banane n''a pas bien cuit, même en la laissant aussi longtemps que la patate dans l''eau bouillante. Je referai cette recette mais sans banane et en essayant les ajouts conseillés dans les autres commentaires', '2008-02-24T12:21:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22437, f425b963-1131-4986-935f-3ce7595c3a8e, 'Ajout de 2 poivrons, 1/2 céleri rave, jus d''1 citron, pulpe d''orange, et 2 grosses carottes. Excellent! Merci pour cette recette rapide et savoureuse.', '2008-02-10T14:12:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22437, dc12831b-f820-4475-a066-e781d987c6a7, 'Pas trouvé de bananes plantain, donc réalisé seulement avec des patates douces.... un délice! Mélange d''originalité et de tradition: Parfait en accompagnement d''un magret aux épices.', '2007-09-19T23:04:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22437, c914feda-1d2b-4fa6-a430-004e90389f6e, 'Un peu liquide je n''ai pas dû mettre assez de crème fraîche. Je n''avais pas de muscade j''ai donc dû faire sans. Je l''ai dégusté en plat principal sans acun accompagnement c''était délicieux.', '2007-03-23T19:56:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22437, 73bc7c3d-31f3-46b8-bd57-f1a11c551ee2, 'Très bon! Demande à être un peu plus épicé.', '2007-02-08T10:46:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22437, 0d10329c-7273-42f6-8200-5ab96546e9ba, 'Excelent, je n''avais pas d''ail alors j''ai mis un oignon. J''ai aussi utitlisé 2 variétées de patates douces (orange d''Afrique du Sud et blanche d''Israël).', '2004-11-27T18:07:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22437, 824dc515-ab7b-477e-aadc-b6daf5613bba, 'Très original.', '2003-07-06T13:22:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164952, 3e0ff4cb-07a3-43b9-8da7-6a78ac51ca48, 'Les propositions sont impeccables, une fois fini ça fait la grosseur d''un cake !', '2022-07-08T04:30:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164952, f3eb7c5a-f2d8-4659-b1e0-56403b0384f7, 'Moi aussi j''ai réduit de moitié les ingrédients. J''ai divisé par deux la quantité de lait et de pain, ajouté 4 oeufs, conservé la dose de miel avec un peu moins de chocolat et 2 bananes, plus un peu de poudre de Vanille. Approuvé par toute la famille.   ', '2016-05-02T12:47:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164952, 66483267-b9bb-4780-953a-b0364394bbd3, 'J''ai réduit de moitié la quantité de lait et de pain, mis 3 oeuf, laissé le miel et le chocolat à l''identique. Remplacé les bananes par 3 poires. Vraiment sympa.', '2010-08-18T19:26:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164952, 23699ea5-e387-4a0d-bd6d-db880013acd1, 'Excellent, mais j''ai regretté que cela fasse un si gros gâteau. Mes filles sont des petites mangeuses et nous n''avons pas pu le finir. Je le referai mais en diminuant les proportions.', '2010-05-29T14:48:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164952, ed82b2c8-a37f-438b-9406-faf665ba92b3, 'Bon pudding pas sec du tout,j ''ai mis 5 bananes et 2 pommes un peu passées. J''ai aussi mis une tablette de chocolat ! Et de l''extrait de vanille et plus de miel.  ', '2010-03-18T11:42:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344335, 22f5a43e-4a27-4d9c-b6ef-c73b6948f91f, 'Excellent...Toute la famille est de mon avis, et surtout j''en fais plus la prochaine fois!!!', '2018-08-08T03:12:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69529, 7ece6bb2-2876-4271-a0a5-e55b183db341, 'C''est fin. Je l''ai utilisée pour diper des légumes (c''est un peu liquide, mais bon). J''essaierai comme sauce avec le reste...', '2008-05-25T15:20:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86806, e849c5da-702a-437b-926e-4d8f5ec1c79b, 'C''est bien  la première fois que nous sommes déçus. Pour le chocolat 120 g ou 200 g ? Moi j''ai mis  120 g mais cela était vraiment trop. Je n''ai pas fait les aumônières, mais j''ai roulé les bricks, puis au four, les bricks sont trop sèches et le surplus de chocolat enlève le goût de la banane. Pour moi je ne referai pas cette recette, je la mets aux oubliettes. Bien a à vous. ', '2013-06-12T22:49:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167158, 5d95879a-323d-498e-814a-02f27c4ce77d, 'L''idée est ingénue mais il manque une base à la tarte car c''est un peu sec.', '2011-08-15T17:39:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (93668, 1398e27f-239f-416d-bbd3-0ad9da4118b6, 'Délicieux ! Ne pas oublier d''incorporer les œufs après la farine...', '2013-01-26T18:39:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (93668, ea1be41c-35eb-462a-99c1-47df59bcdb98, 'Très bon cake moelleux.', '2012-05-02T22:50:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (93668, b8db9825-6d8b-4bda-8527-516f81360585, 'J''ai suivi la recette à la lettre, mais à la fin, je me suis rendue compte que la pâte est ultra compacte. Donc je me suis dit que c''était plus une pâte à cookies. Donc je l''ai préparé telle quelle, et c''est super bon en cookie. Moelleux et tout.', '2010-01-28T18:51:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (319591, e72bb41f-5266-43cb-bb96-5d4b7de18747, 'Faite avec une pâte brisée au lieu de la pâte sablée et avec seulement des fraises... Une merveille :) ', '2014-06-18T00:00:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (319591, d6d74482-13f0-46d6-bdce-dff824e15a0b, 'J''ai fait la pâte moi-même. Un délice !', '2014-04-30T22:10:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165463, 1273ec16-9dfa-4199-bbd4-4f22c1799e16, 'Très bon ', '2011-12-31T17:48:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30363, 039eda07-8208-41de-af93-ac1c37ce5024, 'Je ne l''ai pas fait pour un bébé, mais pour moi (je viens de me faire opérer des dents de sagesse!!!) et c''est super bon!! Idée de mélange très sympa.', '2005-06-16T15:20:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (382915, e291d3a4-5e96-41d5-8ec0-980e0b83e23e, 'Très bien mais on sent très peu le chocolat, la banane prend le dessus mais sinon ça va.', '2023-08-01T18:17:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (382915, 42d3d427-0efd-4996-80be-9c812d6fbf05, 'C''est exquis j''adore', '2021-01-17T14:08:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (382915, e556f368-7ebd-427d-a083-095b6d8bd572, 'Plutôt bon, je conseille de ne pas mettre l''huile d''olive ', '2020-12-14T19:12:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (382915, ba294b32-dc0e-4b67-97a0-6b8e8d433996, 'Tres bon, il faut peut-être un petit peu plus de cuisson mais ça a un goût délicieux ', '2020-12-13T23:01:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (382915, 242836f8-21c8-446f-a0b3-a0c6ea42435d, 'Rapide et très bon ', '2020-07-09T23:59:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (382915, d00dbae3-0075-433c-8591-c3058e5a7409, 'Délicieux !', '2020-01-22T07:54:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 00d85e6d-31b9-4c9d-a5bb-b3b57293d78c, 'Très bon mais en suivant les modifications suggérées :
J''ai mis 30 cl de lait au lieu de 50 cl, 2 bananes et un peu de vanille (le goût était peu prononcé), 3 c à s de sucre et j''ai laissé reposer (3h en l''occurrence). Le résultat était bien proche des pancakes américains en consistance avec un très bon goût.', '2021-12-31T03:23:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, ee2da1aa-7f87-4551-9c45-0aa4e5ad9a27, 'Très bon. J''ai ajusté les doses grâce aux avis. J''ai mis 3 bananes moyennes, 30 cl de lait, 1 sachet de sucre vanillé, 200 gr de farine. J''ai laissé poser 30 min et Top.🤗', '2022-03-26T12:55:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, b23d4b64-e612-4016-a0d3-98ae6e8769b8, 'C’était bon. 
J’ai mis une banane et demi et pas de sucre. J’ai mélangé dans un premier temps les bananes et le beurre au micro-onde pour obtenir une pâte bien lisse (mes bananes n’étaient pas très mûres donc difficile à écraser). J’ai ajouté ensuite les œufs au mélange bananes+beurre. Et ai versé le tout dans la farine semi-complète+levure. Puis j’ai ajouter du lait d’épeautre petit à petit jusqu’à obtenir une pâte à panecake. Ça s’est très bien mélangé et il n’y avait pas de grumeaux. J’en n’ai pas laissé reposer.
La prochaine fois je mettrai un peu plus de lait car c’était un poil trop compacte. ', '2023-11-01T09:10:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 3eb5201e-f53f-4bec-bf75-0328fb0fdb60, 'Parfait, du coup avec la même base je fais des essais avec d autres parfums ou simplement nature.... Ça plaît à mes ados ', '2023-10-31T17:42:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 73954d3c-7bcb-4648-accb-715a99af60e2, 'Je ne recommande pas cette recette sauf si vous voulez faire des crêpes à la banane et non des pancakes ! ', '2022-07-23T22:58:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 274a0dd1-b272-438e-a5a3-7f310ad74a3e, 'Dégoûtée de ne pas avoir lu les commentaires AVANT de faire la recette... beaucoup trop liquide, ce sont en effet des crêpes et pas du tout des pancakes :-( ça a bon goût, mais j''ai 3 enfants déçus car je leur avais promis des pancakes ! ', '2022-07-04T16:54:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, f0a09b38-5a54-4134-ae9c-65d92f3e64e6, 'J''avais 2 bananes bien bien mûre et je n''ai mis que 30cl de lait. C''était parfait pour les gourmands que nous sommes. ?', '2019-11-03T06:26:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 85c051f7-25e5-4da8-902d-5b947389e42e, 'J''ai mis 200 g de farine, deux bananes bien mures, 4 cuillères à soupe de sucre, et 2 cuillères à soupe de vanille liquide et seulement 15 cl de lait pour que la pâte soit consistante, un régal !', '2017-02-27T17:56:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 80753475-4ead-4799-8d8f-83f3a9c9052e, 'Miam😋', '2023-02-09T20:05:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 21586fca-7120-4d3b-9067-6077cd0ccbdb, 'Top consistance parfaite avec 2 bananes et 30cl de lait ', '2022-04-19T16:55:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, a463a783-1b80-4c29-87f7-e91978e59fe4, 'Ça s’appelle des crêpes.... ', '2021-01-13T10:50:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, a9c39db8-4b82-4b2f-a72a-2167f7bd4d0c, 'Très bon, j''ai mis un peu trop de ĺiquide donc ils ressemblaient plus à des crêpes épaisses. J''ai mis du bicarbonate au lieu de levure et rajouté de la cannelle. Pour les proportions que je conseillerais : 1 banane, 1 œuf, 70g de farine (j''ai mis de la T80), 120mL liquide (eau ou lait ou yaourt). ', '2020-10-04T20:55:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 697dd95e-cea2-4e59-a204-885de69f6630, 'J''ai mis plus de bananes et 200grammes de farine. Totalement delicieux ! Avec de la confiture et un bon café !', '2020-08-02T11:15:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 10c0e852-52fd-4085-9690-c6e549828bb1, 'Super recette j''ai mis 2 bananes excellent très moelleux. A refaire.', '2020-01-05T10:55:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 4ad2f3e8-dfe8-406c-8887-053d122e1a69, 'Très bonne recette... De crêpes ! Je l''ai suivie à la lettre, j''ai juste ajouté un sachet de sucre vanillé. Là pâte est trop liquide pour des pancakes, c''est pour cela que j''ai enlevé 1 étoile, cependant ça fait de très bonnes crêpes avec un subtil goût de banane (parfait avec du chocolat... Miam).', '2019-09-22T22:34:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 8eb529a9-f190-435b-a624-c21c9fc8f09c, 'Fait avec deux bananes et un peu moins de lait comme conseillé dans les commentaires et c’est parfait !  ', '2019-09-11T01:28:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 28707361-9558-4ba2-98d6-4f8ae4c04d55, 'Recette impec''. Ce qu''on obtient dans la poêle est un hybride mi-crêpe mi-pancake. La banane est présente, mais suffisamment discrète pour ne pas être envahissante. Les pancakes ont du goût et peuvent très bien être dégustés sans garniture si on est pas fan de sucré.', '2019-06-25T15:38:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 53ce0660-3938-445f-af73-62e8ddf91538, 'Très bonne recette. La banane est imperceptible. Le résultat n''est pas très sucré.', '2019-01-04T21:27:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 4881481e-9104-40ae-86e9-ec95e525e955, 'Super recette facile à réaliser. J''ai ajouté 3 bananes pour avoir plus de gout excellent un pure régale. ', '2017-04-17T11:23:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 6967d0f4-d3e9-4af4-84ef-530b8d37992d, 'Malheureusement aucun goût, j''ai donc modifié la recette en utilisant du lait de soja, 200 grammes de farine, 2 cuillères à soupe de miel et 2 sachets de sucre vanillé, et un peu d''extrait de vanille. + 2 bananes au lieu d''une seule : résultat UNE TUERIE !', '2015-05-30T19:18:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, dbd17e01-f654-4a5c-b0b6-720aa3f0c859, 'Très bon, mais ils ont eu  du mâles à grossir !!😋😋', '2023-08-25T15:25:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 5e03dc25-56f9-46c9-bdb5-ee1e04a92bd0, 'Top ', '2023-08-22T12:50:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, f78a8dd1-4547-4aae-a565-7e891cb1a24c, 'J’ai adoré la recette mais j’ai eu un peu de mal à mixer les l’ingrédient', '2023-04-11T09:08:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 34fbf96b-30ac-4e60-b0c3-de9de4a36155, 'Vraiment super bon :)', '2023-02-12T17:34:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 749a7908-a748-4c7d-8116-48662297eac0, 'Respect des proportions indiquées pour 4 pers. (sauf pour la banane : j''ai mis 1 entière au lieu de 2/3). Parfait, pancakes goûteux !', '2023-01-13T11:26:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 77ec44f0-886f-4ee2-9d9f-33b56eeeb638, 'Super facile et en plus délicieux !!', '2022-09-20T15:56:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 99dec9e2-fed9-467f-9c2f-3b5bab5528ba, 'Parfait selon moi, la banane apporte suffisamment de sucre et le pancake a une bonne consistance.', '2022-03-14T22:50:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 64c88d14-2875-459e-b7ce-c3eb710fdf12, 'Pâte trop liquide et pancakes tout plat', '2022-01-29T10:47:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, cf999a26-b50e-4112-948a-a1d57ae7b510, 'Impeccable ', '2021-12-24T00:02:14+01:00');
