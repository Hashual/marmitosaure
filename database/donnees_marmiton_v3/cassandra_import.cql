INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 513de35e-3e6d-49cd-8788-b3be65c1d838, 'Délicieux !!!! Mais la prochaine fois je suivrais les conseil en commentaires avec un petit peu moins de sucre et de beurre. Juste pour la ligne lol car on a tous adoré ! Merci !', '2023-02-28T18:08:25+01:00');
