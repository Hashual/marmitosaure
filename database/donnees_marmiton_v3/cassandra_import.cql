INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92486, b55a890d-8930-448b-813a-dbd29e5de326, 'J''ai ajouté a la fin de la cuisson un sachet de sucre vanillé, un délice', '2023-03-17T19:02:59+01:00');
