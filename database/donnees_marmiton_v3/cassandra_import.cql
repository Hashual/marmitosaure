INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 13d23174-de2d-4e3c-b9b1-a860249549ef, 'J''aime bien cette recette, par contre, j''ai mis beaucoup moins de sucre (environ 160 grs) et on l''a trouvé trop sucré. Merci de l''avoir partagée avec nous ! Je pense aussi l''essayer en intégrant un peu d''eau des fleurs d''oranger...', '2018-05-19T02:23:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, d1a37445-0dc4-48ef-8cb7-d4a1e8f16edb, 'Excellent. Par contre, je ne mets pas de sucre dans les pommes. Sinon, parfait !', '2018-03-11T09:25:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, b1229da4-0ac4-466c-b796-b0d53c56e6bd, 'Simple, excellent et rapide à réaliser ! Je mis également moins de sucre. Mais vraiment délicieux.', '2018-03-03T06:12:21+01:00');
