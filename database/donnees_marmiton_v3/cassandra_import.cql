INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, dd17a76f-0290-4c90-9e12-ef348326d447, 'Voilà qui va bien m''aider. J''étais toujours perplexe devant les étals de patates... Merci beaucoup.', '2006-01-04T10:37:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, 05240340-d1de-4361-9158-6bf1fb513aa4, 'Je découvre de bon matin, hébétée ce tableau grâce à Bouldegom... Merci Fanny, merci Bouldegom! Quel bonheur d''intégrer ça à mon carnet...', '2005-11-23T09:49:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, b4a2b2ef-2aa5-46de-a5ef-f2c4c7b9ee4f, 'Merci d''avoir fait ce tableau si pratique...', '2005-11-22T15:05:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, 63d0c334-0404-4672-8668-dc2ec5e74955, 'Merci pour le tableau, c''est super.', '2005-01-12T20:26:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, 65ef3696-c20f-4922-8b32-5b4d7e23cf50, 'Super idée Fanny ! Moi qui n''y connaissait rien en pommes de terre...', '2005-01-08T21:57:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, 6e28ad39-4678-4816-b142-fc8ca5e273d8, 'Merci Fanny, très utile ton récapitulatif. On s''y perd avec toutes ces variétés de pommes de terre. Grâce à toi nous pourrons utiliser la pomme de terre adéquate.', '2005-01-06T00:00:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, cc730c90-ce4a-4fc4-a3a1-c5151b916cc5, 'Bonne idée ! Une correction : la ratte est aussi parfaite rissolée, c''est même celle qui tient le mieux et n''a pas besoin de précuisson à l''eau.', '2005-01-01T12:34:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, 00950343-315c-453b-bcb5-f5ac9e41373d, 'Très pratique. Moi qui n''y connaissais rien, je vais enfin pourvoir faire la différence !!', '2004-12-30T08:17:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, 739f2f55-20fa-4e0a-9e76-070431a08df8, 'Merci beaucoup. j''en avais besoin ! ', '2004-12-29T22:06:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, 3f69e632-8f2b-4a47-82ee-c0a9ba425162, 'Quelle bonne idée Fanny !!! Merci beaucoup, ça va m''être super utile !', '2004-12-29T19:52:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, 766ccc31-1fae-41f5-8e64-fadde53bc72e, 'Voilà une idée super pratique qui va être imprimée, je la met aussi dans mon carnet. Merci.', '2004-12-29T16:36:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, b1373dbc-ea43-4f8f-96c2-72da1da1cd50, 'Merci c''est très utile comme liste, et hop je l''envoie dans mon carnet !', '2004-12-29T11:22:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 14d080df-a830-41ba-bca4-e1bc3b375e0a, 'Juste un délice!!!! Je me suis régalée !!! En plus à l''aide des commentaires des marmitonautes je peux dire que c''est le meilleur crumble que j''ai mangé: j''ai fait cuire les coings plus longtemps que les pommes et mis des noix concassées au milieu, ce qui apporte du croquant! J''ai ajouté au mélange farine de la poudre de noisettes et servi ce crumble avec une boule de glace vanille (je sais, c''est riche mais comme c''est bon !!!). Je remercie tout le monde !', '2015-11-17T22:36:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 0c40e01b-01a3-4a22-be64-112584433472, 'Excellent. Moins de beurre pour faire revenir les fruits, moins de sucre également, quelques noix hachées dans le crumble. ', '2021-02-28T19:19:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, c2c1ce00-8c23-4eb2-9111-9e0b3ddc8db9, 'Testė ce midi parfait.....comme je n avais pas se calvados j ai mis un peu de sirop d erable et top....merci pour cztte recette.', '2020-12-07T16:00:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 469e89b9-452a-4c83-9df6-3d8488e035c9, 'Délicieux, les enfants qui ne voulaient pas goûter au début, et ils ont adoré ! A refaire !', '2020-11-10T21:45:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 6a7ee31a-13ed-4f66-9d8b-9a934cda39a6, 'C’est encore meilleur de servir avec une crème liquide à la vanille,vcomme en Angleterre ! C’est même succulent et je n’ai eu que des compliments de tous ceux et celles qui l’ont goûté !', '2019-09-28T17:58:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 8a0448cb-0de7-4cbf-855c-a087bbada0b9, 'Un  vrai délice et un succès auprès  des grands comme des petits...recette suivie à la lettre parfait.', '2016-11-01T10:07:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, c368cad1-71dc-4821-939c-280f980fa64e, 'Une recette au top et très originale avec le coing à refaire.', '2015-11-13T20:40:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 22832792-9113-4084-9c41-cc465bb53376, 'Excellent, j''ai remplacé le beurre par de l''huile. Proportions parfaites (d''habitude je trouve qu''il y a trop de fruits par rapport à la pâte). Merci', '2015-10-25T11:47:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 68609711-84de-4afb-9266-e3bd04196882, 'On peut remplacer... ou ajouter ! Dorénavant ma formule idéale c''est pommes poires coings... et je poivre... et j''ai un succès fou. C''est un dessert assez riche en lui même mais exceptionnellement. Un de crème fraîche ou une boule de glace à la vanille.', '2014-12-17T15:46:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 94342ec7-1a64-4d1d-9924-38d1a9ce3b5f, 'Les coings sont remplaçables par des poires sans aucun problème. Pour ma part, je n''ai pas trouvé la recette trop sucrée... vraiment parfaite !', '2014-11-18T22:21:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 8a498ac4-1274-4b38-bdae-fcfc3a102652, 'Simplement deux mots : facile et délicieux.....', '2014-11-18T19:16:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 13f2c6f2-6acf-4bcb-ba0b-98c2da1ef26c, 'Très bon... je recommande.', '2014-10-09T19:45:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 0faca6fd-9d64-4f8e-8f22-fc862b797209, 'Mettre moins de sucre', '2014-10-06T20:41:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 67ff1015-f4b8-48f4-b865-468c909aaae8, 'Excellent. Facile à réaliser. A refaire.', '2014-10-06T20:13:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 835886e2-c3a7-4208-b01c-0018655307d4, 'Je trouve ce dessert un peu trop sucré à mon goût. J''ai fait revenir les coings plus longtemps que les pommes, pour les attendrir un peu. J''ai ensuite disposé sur les fruits cuits les cerneaux de 2 ou 3 noix. Dans la pâte, j''ai mis 100 g de farine puis ai complété jusqu''à 180 (graduation du verre doseur) avec des flocons d''avoine.', '2012-11-28T23:47:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, dd4b159c-16a5-4d2c-8e40-fea0876e0e05, 'Merci pour cette recette ! J''ai ajouté 10 cerneaux de noix grossièrement découpés aux fruits et j''ai mis de la cannelle dans la pâte ! Un délice avec 10 g de sucre en moins.', '2012-01-19T14:34:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, b7d70618-81cb-4bc2-9275-6f871bd1c056, 'Rien à redire. Simple et délicieux. Le goût légèrement acidulé du coing donne un véritable plus à ce crumble.', '2011-10-27T01:55:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 67add168-c508-4de3-978c-776452b06dfd, 'Très bon. Un peu trop sucré... Et j''ai ajouté de la praline avec la farine.', '2011-10-19T20:04:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, acb542cf-649e-4000-b66d-8e77cf28a204, 'Très bon crumble, essayé l''an dernier et refait plusieurs fois avec succès. Comme dit plus bas je remplace un tiers de la farine par des flocons d''avoine ce qui donne plus de croustillant. Je mets quelques raisins secs quand les fruits sont cuits et de la cannelle dans la pâte. Délicieux !', '2011-10-17T20:26:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 2718a46a-73c4-48d2-a490-37011ccc7359, 'Tellement bon qu''on oublie combien les coings sont difficiles à couper !', '2011-09-10T21:40:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, eba71d73-1911-4a2b-aa44-8d6a51ac92aa, 'Délicieux ! J''ai ajouté un peu de cannelle sur les fruits. Merci pour cette recette.', '2011-09-07T10:49:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 71acfaf9-991d-4389-bd5c-850397ddd51b, 'Délicieux. C''était la première fois que je cuisinais du coing... à refaire', '2010-11-23T21:03:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 1194ff85-f4f3-4fb0-8bd6-75236192302d, 'J''ai fait revenir les coings dans 20g de beurre seulement, sans les pommes (qui cuisent plus vite), et j''ai remplacé dans la suite le beurre et une partie de la farine par des speculoos écrasés. Très bon (même sans avoir épluché les coings !)', '2010-10-16T19:25:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 677000d6-8880-4746-a11c-5c1718d865cd, 'Je recherchais une recette rapide, simple, je ne suis pas déçue !! Par contre, je n''ai mis que 20 minutes au four, car ça commençait à brunir un peu fort ! ', '2010-10-06T00:33:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 3b8c34b4-c0cc-4624-a0ae-c704f1c8b626, 'Super bon et très facile.', '2009-11-15T21:06:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 32812665-8ee9-442b-9106-b88c38511c48, 'Très bon! Le beurre pour cuire les fruits n''est peut-être pas nécessaire (ou en plus petite quantité), ce serait moins gras. J''ai ajouté des noix.', '2009-11-08T20:59:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, d5182eb5-d2c6-4d93-b772-6c5ba668b171, 'Très très bon ! J''ai fait revenir les coings coupés en dés avec du sucre vanillé.', '2009-10-27T12:27:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 1022e045-33b0-40dc-bcc0-f167bc4f5377, 'Super bon, ma belle-mère a aimé, j''ai juste ajouté un peu de cannelle.', '2009-10-16T19:36:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 259aa757-815d-468a-a4b6-da2a4f51f37c, 'Super ! Comme pour tous mes crumbles, je remplace 1/3 de la farine par des flocons d''avoine... encore plus crousti ! A savoir : le coing est recommandé pour assainir les petits intestins chahuttés... il y a une épidémie de gastro à l''école de mes filles : nous avons joint l''utile à l''agréable!!', '2009-10-15T20:07:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, f230a4db-2e57-495e-955b-c49ce1417b14, 'A recommander vivement aux amateurs de coings ! Les proportions sont parfaites. J''ai ajouté un peu de rhum dans la compote et de la cannelle dans la pâte.', '2009-10-12T18:19:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 4e26d9a8-0219-46c1-94e4-e6b87b3ca782, 'J''ai ajouté de la cannelle dans la cuisson des pommes et des coings. Je n''avais jamais travailler le coing c''est très difficile à éplucher !!! Nous l''avons déguster tiède avec une glace vanille c''est excellent.', '2009-10-03T22:47:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 1e036872-9f71-45b2-ac5f-100dae1dae40, 'Excellent! Toute la famille a adoré. A faire et à refaire, avec ou sans coings. Je vais essayer pommes-poires. La cassonade apporte un croustillant inimitable.', '2006-11-29T20:08:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, ba5dc4b9-273b-4e0b-b2f6-cd3bff79187e, 'Je fais revenir les pommes, les poires dans du beurre demi-sel. Puis j''ajoute à la pâte de la cannelle.', '2006-11-08T10:28:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, fe50b8e5-fd1b-470e-9d74-44ece7503901, 'Un peu déçue... Après avoir lu les commentaires, j''attendais mieux. Cependant, ce crumble ayant fait l''unanimité autour de la table, je lui accorde un 4/5 et le referais certainement en essayant de cuire la compote sans beurre. ', '2006-10-15T14:08:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 1c869be0-928e-40f6-94d3-f697bb8ac140, 'Très bon. J''ai eu du mal à obtenir une pâte, j''ai rajouté un peu d''eau pour que l''ensemble prenne. Je l''ai fait cuire l''après-midi puis réchauffé tout doucement avant de le servir à table le soir.', '2006-09-30T20:44:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 3f4a031a-0a33-42fd-96c8-4546732b53e1, 'Vraiment très bon, tout le monde a vraiment apprécié, on peut cependant lègerement réduire la proportion de sucre.', '2005-11-10T22:32:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 7d24d86e-ecca-4ef3-a8f1-77ec9c2c9257, 'Délicieux! Au bout de la 3ème fois, j''ai ajouté 2 cuillères à soupe de poudre de noisettes dans les miettes, c''est succulent!', '2005-10-18T22:12:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 8efdfbaf-d363-4e82-b98a-d47d5cdfb572, 'Très bon. J''ai mis des coings, quelques tiges de rhubarbe, de la cannelle et du gingembre. Une façon originale d''utiliser les coings.', '2005-10-17T19:31:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 4928e29c-f206-40f6-af02-1531a31cb0ad, 'Délicieux sans pommes, mais fait avec une compote (grossière avec beaucoup de morceaux) de coings que j''avais congelée et que j''ai décongelée sur le feu en ajoutant de la cassonade et une lichette de manzana.', '2005-02-07T14:29:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 44edebd0-b9c6-4c26-a0de-4fc6c6f437c7, 'Très bon. Moi aussi, j''ai mis des raisins secs et du muesli, mais aussi du rhum, du gingembre et de la cannelle dans les fruits, ainsi que quelques gâteaux écrasés dans le mélange.', '2004-11-10T21:13:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 3088e4fd-52bc-4b9c-8df4-679e0657bf93, 'Original, se mange chaud avec une boule de glace vanille ou froid! Excellente recette. Pour ma part, j''ai mis le poids en fruits pelés et épépinés.', '2004-10-30T22:29:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 779c1fc9-892d-4294-aed3-8211ae05132a, 'J''ai ajouté un peu de muesli pour le croquant et quelques raisins frais ainsi que des morceaux d''abricot sec en fin de cuisson des pommes et coings. C''est un vrai délice!!!', '2004-10-11T11:22:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 34fc8e72-d4ea-401f-8a31-6d440fa0ac8b, 'J''ai ajoutée des raisins secs et un peu de cannelle, pour lui donner un petit côté de strudel ; tout le monde a adoré.', '2004-10-04T09:36:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19562, 5932b5e4-ae55-4d52-b84d-531fb4b1eca4, 'Délicieux!!! Toute la famille a adoré et en a redemandé.', '2003-10-19T18:34:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, afab79f1-6d72-4c4f-b27d-f39b127154d1, 'Très bon crumble ! ATTENTION ! T°de 240°C n''est pas adaptée (Crumble qui brûle). Conseil d''enfourner à 200°C environ 20/25minutes = cuisson parfaite. ', '2021-06-04T08:06:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 55b48fbb-5931-40cb-b39a-23fa0932c1ff, 'Super recette faite  aujourd''hui sans rien modifier sauf température du four (220° au lieu de 240°) Tout le monde s''est régalé. Mes loulous ont même "gratté" le tour du plat  pour qu''il ne reste plus une miette 😅', '2022-01-16T19:31:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 7163883d-bc42-4eaf-acc5-545f0053042e, 'La seule recette que j’ai conservé dans mon carnet. ', '2021-03-07T11:48:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 558ef8c1-0a3a-45df-bd00-4e063e2d375f, 'Ça doit être bon quand ça crame pas. 240°C, totalement inadapté. Pour 20 minutes j''ai lancé sans surveiller autant dire qu''on a plus que de la compote pour le dessert.', '2020-11-29T10:22:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 6abf9167-f013-4b77-9e31-7a69c642344a, 'Super recette que nous avons adaptée en rajoutant de l''arôme de vanille naturelle. ', '2020-04-12T19:29:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, efe165a1-c39e-4e05-9a50-11109f6b86f7, 'Super bon ! j''ai ajouté un sachet de sucre vanillé et cuisson à 220°C. Top ! Je n''ai pas mis de cannelle car je n''aime pas ça et mis un peu plus de poudre d''amandes. Délicieux ! ', '2015-09-28T22:08:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 5675da9e-6733-4040-a255-9d368bd94beb, 'Bonne recette, par contre j''ai fait cuire moins longtemps et moins fort et j''ai rajouté quelques pépites de chocolat par gourmandise...', '2015-09-27T17:46:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 7a3fca20-0408-4757-aa19-e70d99486bd6, 'Super rapide à faire ! Petit bémol pour la température avec mon four. J''ai dû arrêter avant car ça noircissait, du coup, il manque peut-être un peu de cuisson pour la pâte. Et il manque de beurre à mon goût, j''en mettrai plus la prochaine fois.', '2014-02-22T14:37:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 6e052272-1e92-48d6-ad01-2391a60a36e2, 'Vraiment délicieux ! Pommes, poires, amandes se marient parfaitement.', '2009-11-15T17:15:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, f9369926-4959-4f7f-963d-c4e5db0f9a47, 'Excellente recette', '2023-03-19T10:16:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, d1377a2a-6237-48b9-9360-8ab7c527628d, 'Cuit dans le four du poêle à bois, un régal !', '2022-12-17T15:35:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 793f5a9f-298c-41e6-9d37-575e296825af, 'Très bonne recette 👍', '2022-01-28T17:26:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 877299a2-763f-42d6-9356-32d8d84dcb2a, 'Super recette ! Tout le monde a adoré... Accompagnée d''une boule de glace un régal !', '2021-12-19T11:34:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 5dfa4ddc-b97b-4f71-b762-1b9ad6c2f409, 'Superbe recette 👍🏻', '2021-11-12T12:37:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 7e68cf27-48c9-498c-a0db-db68ef539ff8, 'Aussi délicieuse que facile à suivre', '2020-10-18T12:11:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 185ebcd1-b3b8-40a8-98d5-50f978d360b8, 'Nous avons adoré !!
Pour le crumble j''ai mélangé farine de seigle et sucre de coco avec la poudre d''amande et le beurre.
Pour les fruits juste cuits sans beurre et avec une cuillère à café de poudre de vanille.
Par gourmandise j''ai ajouté quelques pépites de chocolat entre les fruits et le crumble.
Je salive rien qu''en y repensant.', '2020-04-06T23:57:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, d55bc133-1c76-4677-93d6-84707ed974c7, 'Un délice ! Rien à ajouter, j''ai suivi la recette, je l''ai déjà fait plusieurs fois !', '2020-03-29T22:13:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 1fd25316-178a-44df-8267-70bae7021764, 'Excellent! Merci pour la recette. En revanche j’ai mis un peu de sucre roux et fait chauffer à 220 degrés le four ', '2020-03-27T22:05:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 309fa835-d74e-4397-8b26-df973e9f9865, 'Très bonne recette, merci.', '2019-12-17T21:32:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, d68cd81b-53b0-4150-82f6-3e0b0b6dbe9c, 'Facile à réaliser et très bon ! Comme conseillé, j''ai mis du sucre vanillé et un peu plus de cannelle !', '2019-10-07T13:30:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 8cfd22af-6591-4055-8aa6-a7c0c8c9bc6b, 'Rapide et super bon.', '2019-09-30T12:26:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 3dbe02a1-af1e-438b-8fb1-d2a273b8e67c, 'Délicieux !', '2016-11-28T16:00:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 2b9d572b-6f29-499b-b399-e0d1dbd91ab4, 'Très très bonne recette, je l''ai déjà réalisée plusieurs fois et réussie avec succès. Délicieux', '2015-11-08T18:11:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, a6f26ddf-eedd-4fd2-afda-a38604136cf0, 'Super ! Merci pour cette recette. J''ai ajouté une poignée de raisins secs, et j''ai utilisé du beurre 1/2 sel. Une tuerie ! ', '2015-11-01T13:30:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 003b83f8-eabe-4c58-943a-1c058106c549, 'Très bonne recette. Mes amis ont adoré. Attention à la température du four, mettre plutôt à 220°.', '2015-10-18T11:29:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, b823e32d-0f74-4cde-91e0-3b0086c20c27, 'Excellente recette. J''ai ajouté 2 sachets de sucre vanille (et soustrait autant de sucre) dans la pâte et ai verse du rhum ambre sur les fruits dans le plat. C’était délicieux, accompagné d''une crème anglaise.', '2015-10-05T04:57:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 59bde91d-6fd0-40c1-8235-c13b1b81d7a9, 'Très bonne recette mais qu''on apprécie davantage dans des moules individuels pour une meilleure présentation je la recommande  ', '2015-06-02T00:40:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 2bdfc854-48bb-48ae-a290-e8457f429ac7, 'Excellent avec un peu de copeaux de spéculos pour les gourmands ', '2015-04-27T20:22:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, ea49e89b-0b53-422c-b1b6-5f96a6c4a634, 'Le meilleur crumble jamais fait !!! C''est une tuerie.', '2015-02-28T17:07:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, d3f3769c-b620-4b8b-8b67-4e8a698f92b5, 'Très bon ! ', '2014-12-25T00:39:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, d7c003d5-b01a-4d28-8b10-e14b3735cb8d, 'Super bon et facile à faire mais cela manquait un peu de sucre à mon goût. ', '2014-12-07T09:51:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 62486202-4f09-43de-abf7-a88f1c546096, 'C''était très bon... J''ai mis du sucre vanillé dans les pommes, et moins de sucre dans le crumble ! A refaire. ', '2014-11-16T21:03:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, b88d6fe3-04fd-4e33-8f2f-2c9c0a9bf603, 'Très très bon dessert. Les proportions sont très bien. A refaire sans hésitation.', '2014-11-11T13:41:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 53c7a9f6-1eec-46d9-87dd-d54bb696c32d, 'Excellent !!! mes convives se sont régalées, seul bémol le temps de cuisson à diminuer pour éviter de faire tout brûler, merci pour cette recette', '2014-10-03T20:30:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, c994d56b-7b1b-462d-9053-1591e3bc32aa, 'Parfait et pas cher. Pommes fraîches et une boite de poires au sirop, des noix concassées à la place de la poudre d''amande. Un délice. En suivant la recette j''ai sorti 8 portions. Merci !', '2014-09-17T16:10:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 547a0af8-563c-4be6-9b49-19bd0dfc0fb7, 'Excellent , mais la prochaine fois je mettrai un peu moins de sucre', '2014-02-22T14:15:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 4c75e1cb-917d-4b05-8563-a3384f5b81d8, 'Excellente recette très simple à faire. Je recommande. ', '2014-02-16T22:03:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, a312cb5e-d85f-40ad-b0c7-0b0da856801f, 'Je ne suis pas spécialement fan des crumbles mais alors cette recette a détrôné toutes les autres! Juste EXCELLENT. A faire et à refaire. Merci ;)', '2013-12-01T14:22:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 7b09277f-009b-4dee-86bf-5f624b9d9dc9, 'Je l''ai testé et avec des amies nous avons adoré !!!! Facile et vite préparé : une délicieuse gourmandise. Merci Marmiton de nous régaler avec vos délicieuses recettes.', '2013-12-01T00:29:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, ba53eeb4-28ba-433d-877a-1aa6d56b016c, 'Excellent !! J''ajoute des noix et noisettes concassées cela ajoute un peu de craquant !! Super bon !', '2013-11-25T12:31:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, f1ff70a7-b5db-4a6e-8cd9-abd716c53102, 'Super bon mon mari a adoré, mais je ne mets que 220°C car à 240°C légèrement trop brûlé sur le dessus.', '2013-11-04T22:02:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, f0824d5f-8c9a-475a-8a1e-81b1642d5aa0, 'C''est très bon. J''ai fait un mélange de poudre de noisette et d''amande. ', '2013-10-31T09:51:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, c3f32219-c4e4-48cd-90c3-4af9287aebc5, 'Facile à faire. Je n''ai mis que des pommes car je n''avais pas de poire sous la main et j''ai rajouté un peu plus de sucre et de poudre d''amande. Toute la famille a adoré. ', '2013-10-30T12:02:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 8e62fda5-33a7-4024-9345-41342fdccbd1, 'Testé, simple et super bon.', '2013-10-20T21:02:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 4e4f7ca3-b04c-4888-b5f6-30129008fa38, 'Un délice ! C''est mon tout premier crumble et c''était une réussite. Avec mon mari, on l''a mangé à deux et il n''a pas fait long feu ! Les fruits étaient fondants à souhait. Quand au "dessus", une pure gourmandise.', '2013-10-10T15:16:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 5a9082b5-e90c-4d81-937f-887bce6d2925, 'Très bon, ma petite fille s''est régalée !', '2013-10-09T19:33:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, ea471865-601a-4236-af67-33f62e41d5fc, 'Délicieux... Fait avec ma fille de 8 ans.', '2013-10-05T15:36:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, b4d3c8cf-7d9f-46f1-828b-5c89dc1509db, 'Simple et efficace !', '2013-10-05T01:56:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 2c6aa34d-da4a-4175-a990-47d955bebdfd, 'Excellent, même avec juste des pommes. J''ai ajouté des copeaux de chocolats avant de mettre le crumble. Tiède, c''est un régal pour les petits comme les grands. Attention cependant au temps de cuisson, j''ai un four à chaleur tournante et 20 minutes à 240°C, c''est un poil de trop, dessus noirci.', '2013-10-02T11:48:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 189b08d3-6eb9-4a1b-885d-15a1f0f4c526, 'Essayé c''est adopté !! 10 min de cuisson suffisent avec mon four à chaleur tournante. Réalisé avec de la poudre de noisettes faute de poudre d''amandes et c''était très bon également.', '2013-10-01T01:05:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, cf07f3dd-2816-4907-9b05-a6ccafe7b1e9, 'Même sans poire c''était cré cré bon!!! merci ', '2013-09-30T20:26:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 1ca4b697-106e-4ba1-9dfb-6e9a1ea03501, 'Un régal !', '2012-01-10T17:43:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, fcc0a85c-1f5b-4985-9d50-a80396c0c531, 'J''ai mis un peu moins de fruits et ai divisé la pâte par deux. C''est très bon et pour une fois ce n''est pas trop sucré.', '2011-12-21T20:57:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 5e45441f-7bf0-45e8-95c9-d3180745f0cf, 'Excellente recette. J''ai fait cuire les pommes et poires plus longtemps pour qu''elles soient plus fondantes, je les ai coupées en assez gros morceaux pour que ça ne ressemble pas à de la compote.', '2011-12-04T13:07:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, d76f064b-5d5f-459f-bc03-6da3bf831cb1, 'Simple et facile à réaliser, ce crumble est un délice !', '2011-07-16T18:55:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 003e8006-4cdd-431e-a28d-bd3558ab0c94, 'Excellente recette, rapide et délicieuse ! ', '2011-02-23T20:36:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, a4de4243-5604-451d-8d71-f0189627e203, 'Vraiment délicieux...tout le monde s''est régalé !', '2010-11-11T19:50:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 6b8313d6-b0af-42e3-b16a-4fde5a38b0f6, 'Seulement 4 parce que je trouve qu''il y a trop de pâte sur les fruits. La prochaine fois, je diviserai les proportions de la pâte par 2. A part cela, c''est délicieux !', '2009-12-14T12:30:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, bddcf760-441b-4865-ba86-c1dd4168facc, 'Très bien et tout simple à faire !! Comme à la maison, mes hommes adorent la pâte du crumble, j''ai multiplié les doses par 1.5... Un régal !', '2009-08-10T18:53:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24635, 1e17eba5-66ad-4124-a7a2-04dc9d27f711, 'Très bon crumble facile à réaliser. N''ayant pas de poudre d''amande, j''ai remplacé par de la noix de coco râpée et c''était aussi top. A refaire sans hésiter. ', '2008-12-14T10:51:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201305, 36471147-7530-4a5b-b18d-01ee2e9cb957, 'On peux aussi acheter les fruits surgelés et les laisser tout simplement la nuit au frigo pour doucement les décongeler. J’ajouter un sirop de sucre de canne, juste un blanc d’œuf pour alléger le tout et hop ! La sorbetière fait le reste. Ne pas oublier de passer les framboises au chinois avant d’ajouter le sucre pour ne laisser que quelques graines ou pas du tout : C’est selon ses goûts.', '2021-08-20T08:42:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201305, 39ed11e6-b0f7-42a0-952a-55558a0e8ae0, 'Trop bien et bon ', '2022-07-01T19:58:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201305, 412aae33-ba8e-448e-8002-971497e49200, 'Rapide et super bon...', '2016-01-03T11:48:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201305, fdc3307e-4158-43f5-bdb0-5dcdf8fef917, 'J''ai fait le double en quantité et ajouté 2 belles cuillères à café de crème fraîche épaisse. Un régal ! Et même pas besoin d''utiliser la sorbetière.', '2013-09-01T11:26:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201305, 6f88c682-8aac-4847-80a2-dc9b3e7d7afb, 'Trop de framboises, pas de problème en un tour de main c''est fait, simple er rapide et très, très bon marché .un vrai régal 👍', '2023-10-12T12:40:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201305, 31b4e28e-239e-448c-a690-5623694b9150, 'J’aime beaucoup ', '2023-08-22T23:49:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201305, 8ba56c84-8b87-493a-b356-50e6b6f80bf5, 'Facile etrapide à faire', '2020-07-02T19:23:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201305, 4a34db6f-8b20-40e4-ba36-366e101e8263, 'Un vrai délice ! Très facile et rapide à faire. Super recette.', '2017-05-30T19:24:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201305, 74b0e1cf-01f1-4648-97c0-2964b5bc0c04, 'Facile et super bon !', '2015-05-10T19:01:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201305, 8a5707ea-3d43-4c6f-a24a-7395fcf106e7, 'Excellent mais j''ai quand même remué à plusieurs reprises la préparation dans le congel... ', '2015-04-24T11:57:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201305, 74f93b31-aa42-4071-a0a7-30819638e5d7, 'Très facile et excellent !', '2014-04-22T13:17:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201305, d131b784-4be9-4c4b-8d1d-68729110147a, 'Un délice !', '2014-04-19T19:25:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201305, 656e04f0-a7bc-426b-a78e-b3b542b312f0, 'Très facile et excellent.', '2013-09-09T06:25:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 51386a81-4c8d-46db-9e29-46f1ef842861, 'Trop de farine, trop sucré pas très goûteux recette à éviter.', '2019-03-09T20:55:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, b3a069bb-3f75-4ac4-943e-34cd51ebd634, 'Super bon, recette suivie à la lettre, cale change du chocolat!', '2016-04-30T17:16:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 7480846b-1ee1-40cc-a87f-019fd68fee20, 'J''ai adapté la recette sans gluten en prenant un mix de farine sans gluten, et sans lait en remplaçant par du lait de riz ou noisette (les deux sont délicieux). J''ai aussi testé avec pommes, puis nectarines, kiwi et pépites de chocolat... C''est très bon. ', '2015-05-30T12:29:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 07f469d3-9387-4056-ae73-177ede73b374, 'Je n''ai pas mis la menthe mais vraiment bon! dans les commentaires précédents, on conseille de mettre 250-300 grammes de fraises, j''ai testé et je n''approuve pas trop car alors, l''intérieur du muffins ne cuit pas assez à cause de la fraise qui le ramollit.', '2015-03-30T21:15:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 05037655-cdcb-4f33-8f1b-a50c39be1298, 'Avec un peu plus de menthe et moins d''huile : délicieux ! ', '2014-08-08T02:23:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, f121e020-ba04-4b80-ade8-e264d2e4249a, 'Je viens de les faire mais sans menthe (tout le monde n''aime pas chez nous) que j''ai remplacée par de la vanille. Une texture bien fondante. ', '2014-06-06T21:48:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 1809165e-68af-4a2e-8a59-17c3bf305b2a, 'Excellent rien à redire. Fondant, moelleux et frais grâce à la menthe. Merci.', '2014-05-09T19:07:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, ceaa93a7-6b8d-458d-9163-0e19e1ba501e, 'Très bonne recette. J''ai ajouté des pépites de chocolat au mélange, ce qui a donné un goût un peu plus sucré. Tout le monde a aimé. Cependant, la prochaine fois, je laisserai 5 à 10 minutes de plus au four, le milieu n''était pas tout à fait cuit.', '2014-03-13T19:13:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, ebd6d793-9625-4322-9244-754bbbec331d, 'Alors là c''est le top du top ! Merci pour cette belle recette ! Je vous avoue tout je suis nulle en dessert, il y a toujours un petit truc de raté qui fait que le dessert n''est pas au top. Mais là j''ai tout bien respecté, aucun soucis dans cette recette, tout fonctionne à la perfection ! Je mets cette recette dans le top ten !  Oups par contre je n''avais pas de fraise du coup j''y ai mis des framboise et c''est je suppose tout aussi bon ! Je dois en refaire pour l''anniversaire de mon père. Merci ! ', '2013-11-20T00:04:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 24d80e77-d19c-4860-8653-a6972fc4b672, 'Testé avec des petites fraises des bois, c''est excellent, j''ai mis moins d''huile et juste 6 petites feuilles de menthe.  Très bon, mes enfants ont adoré !', '2013-07-06T18:16:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, e3c4ff3f-ab12-4332-9ec9-fdb3b0cb5016, 'Avec 2 fois moins d huile : au TOP TOP TOP !!!', '2013-04-13T20:15:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, afa90b7e-9d56-40c1-a6ca-79a867dec040, 'J''ai testé, j''en ai fait 12 et je dois me les coltiner toute seule parce que personne n''aime ça chez moi !!! La recette de base est bonne, il faut mettre 300g de fraises, mais pas de feuilles de menthe !!! Elles gachent tout le goût des fraises !!', '2012-06-22T15:47:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, ef510c3c-2c1a-417e-b994-f180e56371f1, 'Super recette, on peut se permettre de mettre un peu plus de menthe, cela ne gâche rien...', '2012-05-22T18:09:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, c2dd0653-e66f-4ce8-af2c-dc9ca0b60fba, 'N''ayant pas de petits moules à muffins, je les ai fait dans un moule à savarin, ce n''était pas si mal. Même en ayant mis 220 g de fraises j''ai trouvé que le goût n''était pas assez prononcé.', '2012-04-11T17:41:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 1a6de4fd-c239-41a9-97d0-8dddb3791f98, 'Ne pas hésiter à mettre plus de fraises, 150 g de sucre suffisent et j''ai mis 2 feuilles de menthe en plus. C''est une chouette association de goût !', '2012-04-05T14:18:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 7f7eaa26-b182-4310-b4b8-ee9c9c731a47, 'Très frais et délicieux. Bien prendre de la menthe fraiche...', '2011-08-30T11:11:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 9a496099-004f-4c80-a030-955316f04c80, 'Je fais cette recette depuis longtemps, elle est excellente ! Lorsqu''il n''y a plus de fraises, je les remplace avec le zeste de 2 oranges passées dans le mixeur. C''est totalement différent, mais tout aussi bon ! J''attends votre essaie et vos commentaires. Martine_3352', '2011-05-28T22:52:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, e8aff570-3d03-43d9-9940-0e79b945c558, 'Plutôt joli visuellement et facile à faire. Néanmoins, j''ai été assez déçu au niveau gustatif. Bien qu''ayant ajouté plus de fraises que dans la recette initiale, j''ai trouvé que le goût des fraises ressortait peu et n''était pas assez prononcé.', '2011-05-15T13:41:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 84d9c6d3-d28f-41d4-9477-1f9a8bb92bb1, 'Muffins très frais et délicieux ! Les saveurs sont originales et subtiles (la fraise est rehaussée par un parfum discret de menthe). Par contre, étant adepte du bio, j''ai remplacé le sucre blanc par du sucre non raffiné !', '2011-04-27T23:07:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, cbb7e1b4-8adf-4043-a66f-c282965d032c, 'Vraiment très moelleux ! La prochaine fois, c''est-à-dire dans peu de temps, je mettrai plus de fraises et de menthe. Et puis, une autre fois encore, j''essaierai avec d''autres fruits.', '2011-04-27T22:33:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 5916466f-3db5-4dc1-919d-2a5e095e1be3, 'Simple et très bon ! ', '2011-04-25T23:43:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 0d6e9b12-3e39-424f-af84-0463449c3342, 'J''ai beaucoup aimé le mélange fraises menthe. Merci pour cette recette c''est délicieux. A refaire avec d''autre fruit la base de la recette est facile à réaliser', '2010-08-22T10:46:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, f61a4fbe-be19-4d87-a79e-583bb88ea6eb, 'Même si la recette avec des fraises a rencontré un succès mitigé, depuis que j''ai découvert cette recette, je l''utilise comme base de tous mes muffins. Ceux qui ont le plus de succès : Ananas (en boite), lait de coco (en remplacement du lait), vanille et rhum ambré. Un vrai régal !', '2010-05-03T12:54:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 248e0d6a-cf03-40ad-802f-e7a829c669a1, 'Il n''ont pas bien gonflé, mais sont quand même bien tendres. La température du four n''est pas indiquée : j''ai pris 180°C et cela a donné de bon résultats.', '2010-05-01T13:59:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 15269729-3c77-4fa4-ab51-cadb62e10743, 'Recette simple et rapide. Depuis pratiquement 1 an je fais cette recette (mais je change d''ingrédients : chocolat, framboise...), et elle remporte toujours un franc succès ! Grand merci.', '2010-01-17T14:21:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 6f5c3d16-3b5b-44af-a1b4-7a32e9d6b537, 'Merci pour cette recette ! Vraiment super bon !', '2009-08-10T16:05:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, b1e42f8a-c212-428b-a9dd-4ed72fbbd13b, 'Je la fais avec des cerises fraiches, c''est de saison ! Les "burlat" de l''Yonne tiennent bien, une bonne quantité, dénoyautées et coupées en 4 ! (les jeunes enfants peuvent y aller sans danger).  La menthe apporte un vrai plus, en bonne citadine que je suis, j''ai toujours un petit pot surgelé chez moi.', '2009-07-28T19:30:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 2b1955e7-6bba-4977-833e-9bbd79d3ebcc, 'Super bon, mon homme adore, à refaire avec plaisir !', '2009-06-08T11:11:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 3da6c996-6450-4d14-8753-23fce3da6935, 'Super bon, et super facile. Mes filles se sont régalées à les faire et...à les manger ! Par contre, la recette nous a fait 18 muffins. Merci.', '2009-06-05T15:19:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, edf357e7-0074-449b-91c3-6df738ad6137, 'En suivant les commentaires, j''ai ajouté plus de menthe.... Mais j''ai trouvé que ça masquait le goût des fraises. Dommage.', '2009-05-29T23:21:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 22fc9e25-95eb-48ef-8d25-01278326e3b7, 'Je n''avais pas de menthe, donc j''ai suivi la recette en ajoutant juste de la fleur d''oranger. C''est vraiment super bon !!', '2009-04-18T22:29:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 01f905f6-b5a3-4914-9c4b-ab2fe33f28e3, 'C''est un dessert original, ajouter un peu plus de feuilles de menthe pour accentuer le goût. Très facile à réaliser. J''ai ajouté en accompagnement une crème à la fraise et à menthe, tout le monde adore.  ', '2009-04-04T16:12:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, ab4eb12b-9d76-4b5c-9cab-0f09ae61827c, 'Moi je préfère ne mettre que 10 cl d''huile et 20 feuilles de menthe pour plus de goût. J''ai remplacé les fraises par des framboises. C''est excellent!!', '2008-09-12T12:32:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 50388077-1006-406c-9508-0d3440907de0, 'Très très bon, même si nous n''avons pas mis de menthe. Mon amoureux les a adoré, moi je les aurais préférés un peu plus sucré. Mais à part ça ils sont délicieux. On en a fait plus de douze donc on en aura pour le petit déjeuner demain matin.', '2008-06-05T20:34:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 2eeb5830-112d-4edb-a338-8cdd4d1dec54, 'J''ai suivi le conseil de doubler les fraises et de ne mettre que 10 cl d''huile. DÉ-LI-CIEUX! La prochaine fois j''ajouterai tout de même un peu de menthe, j''aurais aimé un goût un peu plus prononcé.', '2007-08-14T20:23:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 63d4e738-4dbc-4bb8-9426-1712b41151a7, 'J''avais gouté cette recette et je voulais essayer. Le résultat n''est pas vraiment ce que j''attendais mais c''est bon quand même. J''ai mis 250gr de fraises mais la prochaine fois j''en mettrai plus. La pâte a pas beaucoup monté,  pour le prochain essai je mettrai plus de levure ou bien remplacer une partie de la farine par de la maizena. Sinon, on sent un peu la menthe mais là aussi la quantité est à revoir à la hausse. Enfin pour un premier essai, c''est pas mal du tout. J''ai l''habitude de "retoucher" un peu les recettes. Par contre il manque la température du four dans le texte de la recette. J''ai mis à 200°C (four à chaleur tournante) et 20 min suffisent.', '2007-08-11T22:18:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, f96f5d47-e5f4-4a44-921f-52a51cf4f228, 'Excellente recette, tout le monde a apprécié! J''ai testé avec des mures, des framboises et des fraises et c''est toujours aussi bon!', '2007-08-01T14:33:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 2272bb0f-3321-479f-b0f8-aa6c1eb1af74, 'Super bon, c''était mes premiers muffins et ce fut une réussite!!! J''ai doublé la quantité de fraises et j''ai supprimé l''huile pour la remplacer par du lait. Je me réjouis de l''année prochaine pour recommencer.', '2007-07-21T17:47:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 81571c7e-de0a-45ca-88da-5126ade121b7, 'Ce dessert est parfait, le mariage fraise/menthe est vraiment intéréssant et l''odeur de fraise pendant la cuisson est délicieuse ! Merci. ', '2007-06-07T10:42:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, be8aa46c-54e3-4f84-84cf-855cf3ce1852, 'Que du bon, rapide, facile et délicieux!! Pour ma part, j''ai mis 140 g de sucre, et mis de l''huile d''olive, le résultat est divin!!!!! Merci.', '2007-05-24T18:16:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 0f38d613-cc31-42e4-9447-cdc28100accf, 'Je n''ai pas osé avec la menthe, ce sera pour une prochaine!! Vraiment extra ces muffins pour ma première, j''ai aussi rallongé le temps de cuisson de 10 minutes.', '2007-05-01T10:27:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 880c08db-70e4-4004-b3e5-5b3204490434, 'Je me suis régalée, j''ai aussi adoré les préparer car facile à faire, j''ai hâte d''essayer avec d''autres fruits. J''ai mis moitié farine et moitié maîzéna, et 10 cl d''huile. Merci pour la recette que je garde précieusement!', '2007-03-28T20:10:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 45fcad3b-9a24-41af-bbc9-53e13b269c59, 'Je n''avais pas de menthe sous la main, mais j''ai rajouté un sachet de levure vanillé et c''est exquis!!', '2007-01-05T19:29:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 6faa8d95-8360-4002-8200-c11e855ea9e2, 'Recette vraiment extra, de plus je m''en sert pour dresser mon chien (une vrai réussite !) ', '2006-09-23T10:39:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, b062b28c-40db-434b-8771-4949dcd82a25, 'Délicieux, toute la famille a apprécié. Une variante, j''ai  remplacé les fraises et la menthe par des pépites de chocolat super bon!', '2006-08-01T20:01:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, d5931c5e-f868-43ab-ad5d-2210cb02d858, 'Excellente recette où j''ai mis 400 g de fraises et seulement 10 cl d''huile (la prochaine fois, j''essaierai avec du beurre). J''ai fait cuire le tout au Th 7 pendant 20 min. Pas de menthe car cela casse le goût de la fraise.', '2006-07-20T19:26:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 82e284f1-e03d-449c-b629-1fdbd95412b5, 'Un grand moment de bonheur...J''ai juste remplacé une partie de la quantité de farine par de la maïzena et je n''avais pas de menthe mais je vais très certainement bientot la refaire avec de la menthe. Ce doit être tout aussi délicieux, vu la légèreté de la pâte! ', '2006-06-20T19:35:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 9965e043-7623-43ba-8f54-38e1f7406cc3, 'Excellent! J''ai suivi les conseils des marmitonautes, doublé les fraises et mis seulement 10 cl d''huile. A l''énoncé de la recette certains semblaient dubitatifs... mais ce fut un franc succès! Le goût de menthe est léger et apporte beaucoup de fraîcheur.', '2006-06-09T12:34:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 24543cf2-0950-4ef6-bba9-7bd34788c3db, 'J''ai remplacé l''huile par du beurre et n''ai pas mis de menthe. Mais qu''est-ce que c''était bon!!! Ca sentait la fraise dans toute la cuisine et on avait l''eau à la bouche en les sortant du four. Moelleux et succulent !', '2006-06-03T15:00:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 5fe289b1-d161-4424-b25f-9e3993997e3b, 'Ils sont tout simplement délicieux bien que je n''ai pas mis de menthe cette fois-ci, n''en ayant pas sous la main... Mais je re-essayerai avec, ça doit être encore meilleur et plus original!   En tout cas, parfaits en muffins "tout bêtes" à la fraise, en suivant les conseils des marmitaunautes: seulement 10 cl d''huile et au moins 200 g de fraises... ', '2006-04-28T21:48:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 3fdeb461-3741-4911-9da4-828019697c5c, 'Extra! Mais j''ai réduit la quantité d''huile, de sel et de sucre.', '2006-01-15T13:06:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, c3dfd429-bd6d-4e32-bf52-4f07def47683, 'Comme Amélie, j''ai mis le double de fraises et pas de menthe (question de goût). Le résultat est vraiment très bon, très moelleux. Une recette à garder !', '2005-08-22T10:27:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 1f93be00-8649-4755-92b2-9a1eb647ba10, 'Ces muffins sont délicieux, bien moelleux en mettant le double de fraises. La menthe laisse un goût léger, agréable et original.', '2005-06-26T16:34:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 275f739c-62a0-4b19-b2eb-73cf07165a27, 'Ces muffins sont tout simplement excellents. J''ai mis le double de fraises et je n''avais pas de menthe. Ideal pour le goûter.', '2005-06-10T17:01:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 0e400761-2bdf-4a90-a06c-06eb2351c320, 'J''ai mis deux fois plus de fraises comme conseillé...et je les ai fait dans des mini-moules...un pur bonheur! A refaire absolument!!', '2005-06-05T19:41:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 88f9a762-ceec-48e5-81f8-3af31682de22, 'Je débute en cuisine et c''est vraiment la classe ces muffins! J''ai aussi réduit l''huile de moitié et fais cuire 10min de plus et voilà que mon mari était tout impressioné! Merci pour cette recette!', '2005-06-03T19:44:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, fd0fd9b7-2d9e-4335-be6d-63343cc1f989, 'N''ayant pas de feuilles de menthe, j''ai donc plutot testé la recette ''muffins aux fraises''. J''ai mis le double de fraises et je pense qu''on peut en rajouter encore. J''ai cuit 5 minutes de plus que sur la recette. C''est un vrai régal!', '2005-05-29T16:56:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, edc47f1a-6e22-4ad6-b93e-0847f466e692, 'Mon mari a adoré. Par contre, je n''ai mis que 10 cl d''huile et ça n''a pas gâché le plaisir pour autant!', '2005-04-20T20:10:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 92e32782-87c6-48d6-a730-4409844a0516, 'Recette très sympa. J''ai remplacé la menthe par des pistaches pour donner du croquant et j''ai rajouté 10min de cuisson. ', '2005-04-12T17:56:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31325, 0f39b9b2-a472-4dcc-b15d-441a71c4602c, 'Ces muffins sont délicieux, cependant la prochaine fois j''ajouterai un peu plus de fraises.', '2005-04-05T22:15:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 15736a21-1323-4a54-90ee-177372198c8d, 'Pour faire briller les fraises naturellement et sans coulis ou confiture, c''est très simple : dans un saladier, coupez les fraises en 2, sucrez et remuez pour bien imprégner toutes les fraises. Laissez les ainsi quelques minutes (le temps de faire la pâte et la crème). Vous récupérerez des fraises brillantes comme il faut !', '2016-07-09T18:09:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 3fb6604c-8a4f-44b3-8b38-6db2354cafd6, 'C''est la 1ère fois que je faisais cette tarte aux fraises et franchement tout le monde a a do ré!

Dans un moule pyrex de taille normale, il faut compter presque 1 kg de fraises.

C'' est long à faire mais franchement: aussi bien visuellement que gustativement, ça en vaut la chandelle. ', '2023-05-14T22:13:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 7249c1f7-ebd0-4b7b-aeec-dadc4a49ce51, 'Beau résultat dans l’ensemble. En revanche ce qui est regrettable c’est que les instructions écrites soient lacunaires. J’ai dû utiliser la vidéo pour faire la recette et c’était pas facile du tout de faire pause, play, avance rapide, retour etc.', '2019-04-02T07:17:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 29692d05-3ed4-4176-8f67-81d37bbdf7ff, 'Très bonne mais j''ai fait moitié fraise moitié kiwi !', '2018-04-21T00:25:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, e543cc2e-fe04-42d6-a873-28d3b17ef875, 'La crème pâtissière ne se fait qu''avec le jaune de l''œuf et non pas l''œuf entier!! Sinon bonne très recette.', '2017-06-06T22:30:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 4c0aca2c-9a20-45d9-9985-0a8352fc2eaf, 'Un pur délice !!! 
Petit conseil en plus, vous pouvez ajoutez quelques fraises coupées en cubes dans votre crème pâtissière...', '2022-07-25T12:56:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, ad1eda81-57e5-4820-8d99-8fe01e0d5a28, 'Assez facile à faire, par contre après lecture des commentaires j''ai également doublé la crème pâtissière et j''y ai ajouté 4 feuilles de gélatine pour que ce soit bien ferme et que ça ne déborde pas sous le poids des fraises.
J''ai aussi attendu que la pâte avec la crème se refroidissent à part avant de mettre les fraises.
Résultat garanti !!', '2019-04-25T07:10:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 2f61f681-6621-4c9e-b51c-25eedaad79ff, 'Très bon et simple ! Jai également doublé la dose de crème pâtissière.', '2018-07-24T11:43:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 05ca87f7-7df2-4f99-9b2a-5bb4a86a0f1c, 'Presque parfait ! Je double la quantité de crème pâtissière et ajoute un peu de nappage brillant. Une tarte aussi bonne que celle du pâtissier qui ravit tous mes convives ! À faire et à refaire !', '2018-06-23T04:24:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 79c61b96-a5f5-41a9-9df2-5bd76f7a1595, 'Parfaite, j''ai remplacé 70grs de farine par de la poudre d''ammande... Un delice pour les papilles, un carnage pour les hanches.', '2017-07-01T21:57:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 96b5c868-4bd2-4e83-b7ee-f657ad0ef96a, 'Très très bonne et légère ! À refaire sans hésiter. Mon mari aurait préféré avec un peu plus de sucre, à essayer pour la prochaine fois', '2023-04-17T00:42:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, cdab33bc-d6f6-4b4e-8055-f85cb21e7c6f, 'La recette en vidéo est super simple à suivre, je n''en avais jamais fait auparavant, je suis trop contente de ma tarte ! Elle est incroyable merci marmiton ❤️', '2022-04-17T15:58:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, bcd35c4c-36da-494a-9e26-9011bbb29b2e, 'Pas mal cette recette,mais pensez à  mettre au frais la crème pâtissière en la filmant au contact  qq heures le temps du refroidissement...sinon cela ne va pas le faire sur la pâte et sous les fraise fraiche   peut-être faire pâtissière la veille au soir..', '2021-05-26T20:23:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 41efb27f-2c72-422b-bf9e-b5d47de4b5e7, 'Superbe tarte aux fraises .Je nai pas fait la pate donc je ne sais pas quel gout elle a  , jai fait ma flemmarde jai pris une pate feuilletée...par contre la creme pâtissière est exellente , un peu legere en proportion je trouve , voir si il ne faudrai pas doubler les proportions pour les gourmands.Cest vraiment un fond de tarte, pas plus.', '2020-04-20T11:09:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 5fd9980d-44f2-43ab-a558-2f8b7e9804e7, 'Un délice !  !', '2018-08-11T18:28:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, ef13a127-74f5-4280-9bc2-76338aa1ce63, 'Très bonne tarte ! J''ai suivi le conseil donné de doubler la quantité de crème pâtissière et c''était excellent. A refaire !', '2018-07-04T07:10:51+02:00');
