INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212490, e02848c3-1fc9-4bc3-96a6-91aa6a51cfea, 'Très bonnes proportions pour une boisson-dessert-goûter fraîche et légère. Se prépare très rapidement, les enfants en raffolent, les grands aussi !', '2013-05-20T15:03:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212490, 2e47653a-8720-47ae-a55b-c5402eb3bff5, 'C''est pas mal ! Une touche de fraîcheur après un repas un peu lourd !', '2012-02-16T20:40:29+01:00');
