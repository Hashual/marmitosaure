INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, efb98d8d-7887-4716-b94e-d8e1b09633af, 'Excellent je conseille fortement.', '2020-05-29T23:16:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 9c805324-9bab-48a8-90a9-8b4c5051fc88, 'Une envie soudaine de smoothie mais finalement je suis partie sur ce milk-shake et c''était très bon ! J''hésite à tester avec un glacon de plus ou peut être le mettre après. Merci en tout cas ! Je la referai !', '2020-05-28T19:53:27+02:00');
