INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 4e81b0c3-9b6f-465a-9d5e-7a0666201a04, 'Je n''avais jamais réalisé de punch. J''ai épaté tout le monde même les connaisseurs.
