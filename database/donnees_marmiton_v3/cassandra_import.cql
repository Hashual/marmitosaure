INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, a6499c34-727a-442c-8c0c-08b7607a0a20, 'Moi j''ai fait crème fraîche, courgettes en rondelles, morceaux de jambon, moutarde et ananas avec mes épices à pizza.', '2016-07-27T03:06:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, 4524f419-5766-40e2-8137-138000b4b9de, 'Super, ca donne de l''inspiration pour tester de nouvelles garnitures, en plus de tester celles-ci. Merci !', '2016-07-21T18:51:08+02:00');
