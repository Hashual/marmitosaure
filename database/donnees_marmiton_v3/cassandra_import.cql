INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 0eeb6dc1-ea6b-4bab-b597-f8478e223476, 'Pour une première c''était un régal, j''ai utilisé des framboises surgelées et de l'' Agar-Agar  à la place de la gélatine et décors en chocolat blanc .Digne d'' un pâtissier. Délicieux ', '2023-09-17T13:44:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, ba5fcc7a-e0b1-41d0-8840-8cfbefc2b474, 'Bonjour faut il faire un miroir dessus et peut t on le faire la veille ', '2023-09-13T18:01:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, cecf6d6a-32d4-4698-acc0-b9e085fb4c36, 'Pour une première fois j''ai régalé mes convives ils ont adoré', '2023-05-18T21:39:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 6e2e30ec-4b6f-426e-9d2f-2c7fb01f5af0, 'Recette facile à faire.
Mes invités se sont régalés ', '2022-04-16T13:49:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 1268bdc4-4583-4895-a8a4-29149c2f38fe, 'Excellent ! On me le réclame à chaque anniversaire.', '2022-03-20T11:44:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 7660edab-4f61-4d70-b2ac-2ebedb381eeb, 'Parfait les étapes sont bien détaillées 
', '2022-03-09T15:54:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, bb761c28-3fb7-44eb-84d0-549b5e1000bf, 'Trop de gélatine... Fait pour 6 personnes... Décevant on dirait un flan tellement la mousse est collée. J''ai pourtant respecté scrupuleusement les directives de la recette. Dommage car l''équilibre sucre  est plutôt bon et la répartition biscuit mousse est bien.', '2021-01-11T02:27:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 83a2fa2d-5240-48f1-a894-14ad54f7ff16, 'La génoise est trop épaisse et la mousse n’est pas assez sucrée. Le glaçage miroir non plus. En revanche, la texture de la mousse est très bien. Il manque du sirop dans la génoise pour la rendre moins sèche.', '2020-11-29T22:34:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 5ad81556-b56b-4bfb-8f34-489cb2b5424d, 'Je fais avec 250g de coulis pour la mousse, donc max 6 feuilles de gélatine.
Et 100g de coulis pour l''effet miroir, ce qui demande moins de 3 feuilles de gélatine.', '2020-06-07T11:33:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 78af4842-4d1d-428c-b598-8c0bafc7b1da, 'Un pur plaisir ', '2020-04-21T19:43:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, c1b0c498-8c4f-4327-a483-062c8dd1216d, 'Recette au top avec un goût délicieux....', '2019-05-27T14:03:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, d6dbeedc-55b5-4431-b2ce-94177fd6870e, 'J''ai suivi la recette à la lettre et pourtant la mousse de framboise n''est pas assez ferme malgré plus de 3h au frigo... Je ne sais pas si ma gélatine était de mauvaise qualité mais très déçue d''avoir eu un résultat pareil', '2019-05-14T17:14:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 416a1373-4d1a-4eef-ae41-edf31090d60e, 'Excellente recette.', '2019-05-07T04:59:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 4a5ce73f-a8cd-49eb-8802-c88cf327fc51, 'Déjà réalisée 2 fois, cette recette est parfaite.', '2019-03-30T06:16:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 1a995738-c15a-44b3-b750-668cbd1f3783, 'Super bon. C''est un peu long mais délice !!
', '2019-02-26T08:42:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 57ec0023-c762-409f-84c8-9eb01df7928f, 'Juste super bon et très frais. A faire avec tout type de fruits et tout type de miroir en déco !', '2018-06-19T14:49:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 0efd9823-3e99-4cb8-a1e8-65cf2fed1e97, 'J''ai réalisé la recette plusieurs fois avec du coulis ( framboises, fraises, fruits exotiques ) résultats impeccables et plus simple a réaliser !', '2018-03-16T11:14:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 0b8d92af-bc7c-4fd6-b0c1-c3650c12c62c, 'Parfait long mais tellement bon !', '2017-10-06T15:52:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 3551a922-95bf-4bae-8a69-137f76f1dd8d, 'Excellent.', '2017-09-15T18:26:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, c59e4192-512c-4976-b0e5-9af03fdcdcac, 'J''ai adoré la recette je pense la reproduire pour une fête qui arrive en juin je n''ai pas hésité à mettre 5 étoiles c''est vraiment top !', '2017-03-25T10:58:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 08ee4a79-7e85-4086-b094-79409a912ef3, 'Superbe gâteau, excellent, digne d''une pâtisserie pour un coût modique vu le prix de la part de ce genre de gateau ! Très facile à faire mais demande un peu de temps', '2017-02-25T14:23:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 08eda78b-5c0d-454e-86dc-447653359262, 'Il faut prévoir suffisamment de temps, mais cette recette est incroyable et facile ! Un vrai délice. J''ai ajouté des framboises entières et fraîches entre la génoise et la mousse. Effet garanti ! ', '2016-12-21T09:55:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, aaa7f3b1-a799-4b55-90ea-5ccdc55e2dba, 'Super bon ! Facile à faire malgré des temps de repos assez long, c''est très bon ! ', '2016-06-24T17:50:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 0da5d5bd-9a32-40ed-ba0c-09069df26586, 'Tout le monde a adoré et en a redemandé ! Même ceux qui ne sont pas fan de pâtisseries. Dessert succulent.', '2016-01-09T01:22:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 749966d1-f86a-4cc1-b9c4-1108806dd2b1, 'Nous étions 8, j''ai augmenté les doses. Facile, léger, rapide et tous les convives ont apprécié. A refaire aussi avec d''autres fruits.  ', '2016-02-15T10:50:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, d1a3f79f-a4e4-4f44-aaba-188b699a9391, 'Surement une excellente recette si j''avais utilisé des framboises fraiches. En framboises décongelées, le tout a fondu sur une soupe de framboises... Mais je referai autrement !', '2021-11-14T09:12:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 8251040d-ac7f-4b18-9b2d-13f3e429d0ef, 'Tellement bon ! J''ai mis des fraises (surgelées) à la place des framboises, et j''ai très peu sucré car les fraises rendaient beaucoup de jus.', '2020-07-15T18:51:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 0f095164-7517-47d4-a85f-7a9407457485, 'C''est vraiment un régal! J''ai mis l25 g de poudre d''amandes, 4 cuillères à soupe de crème liquide et 80 g de sucre. C''est aussi bon tiède que froid et le mélange amandes et framboises est terrible!! Merci pour cette très bonne recette.', '2008-08-24T19:33:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 74a5be32-294f-49b6-b928-8a949c5eb728, 'Délicieux... Mais chose peut-être évidente, sauf pour moi (...): si vous employer des framboises surgelées, n''omettez pas de les laisser dégeler auparavant; afin d''éviter le côté "soupe de framboises"...', '2008-08-21T00:40:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, bcf36ee0-838b-4043-9fcb-06efdf9c4932, '5 sur 5 et même plus ! Bon quelques variantes dans ma recette : n''ayant pas de framboises, j''ai utilisé 400 gr de fraises fraîches. J''ai mis 125 gr de poudre d''amandes (contenance du paquet acheté), 80 gr d''édulcorant (au verre mesureur) et 15 cl de crème liquide à 4%. J''ai mis 8 minutes à four moyen (180°C) + 2 minutes sous le gril. C''était super délicieux ! Bien sûr, j''essaierai avec des framboises. N''hésitez pas à faire ce dessert super facile et exquis, dans des ramequins transparents pour un meilleur effet !', '2005-02-23T14:50:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 4bfe1ed0-001c-4589-9308-674bfb635732, 'Paaarfait ! Facile et juste comme il faut. Léger, pas trop sucré, une tuerie plébiscitée par toute ma tribu. Merci pour cette recette !', '2015-06-17T13:27:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 03be37a1-de08-4d76-9db2-35d1ab36b1a1, 'Très très bon. J''avais des framboises qui attendaient dans le congélateur. J''ai enfin trouvé la recette facile et rapide pour les utiliser. Merci pour la recette. Rien à changer.', '2015-05-04T16:16:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, e7e0a82e-1b6e-4553-bf4e-c1ec375c0250, 'Délicieux ! J''ai vu cette recette sur le magazine de Marmiton, elle est très facile à réaliser et le résultat est super. On peut la faire avec des framboises surgelées pour en avoir toute l''année. Un dessert simple et efficace pour recevoir. ', '2012-07-05T23:47:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 4240d5d5-4bd2-4f6c-9110-57d4d0936720, 'Pas fantastique, un peu trop sucré mais c''est personnel. Il faut à mon avis doubler les doses  pour avoir un juste équilibre entre framboise et crème d''amande.   Privilégiez plutôt un crumble !!! ', '2012-06-10T12:06:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 9afa38c2-809d-4d8c-a8f5-6e6507ff039c, 'Délicieux, à manger en sortant du four...', '2011-10-08T19:34:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 5ad11c1e-afcb-4631-80d2-465b7a73d6d1, 'J''adore la framboise et j''adore l''amande donc je suis très contente d''avoir trouver cette recette vraiment rapide à préparer pour un effet bluffant. Je la refais sans hésiter. Prévoir d''adapter certains proportions des ingrédients.', '2009-11-19T00:00:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 4d690acf-8b1f-4d95-aa73-208d544522b5, 'Vraiment pas terrible. Aucun intérêt.', '2009-04-20T18:43:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 32916826-e84c-4f1c-935e-58dc6bffd8e3, 'Excellente recette!! Je l''ai effectuée une fois avec des fraises et l''autre fois avec des framboises comme indiqué. Je n''ai pas utilisé de grand plat mais des ramequins individuels. Tout le monde a apprécié. ', '2008-12-31T15:30:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 1413c8e2-cbec-4813-bcd2-6ae36a53d2dd, 'Bon mais un peu lourd. La prochaine fois je rajouterais un blanc d''œuf en neige pour alléger un peu la pâte et je mettrais un peu moins de sucre.', '2008-12-21T12:22:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 5bd1b82d-91ac-46fd-8fc6-f29e52b54a0f, 'Je dois être parmi les rares... désolée mais j''ai trouvé cette recette très quelconque... je préfère me réfugier dans mon tiramisu ananas ( valeur sûre) également sur le site de marmiton.', '2008-12-19T20:42:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, dde28bb9-9b18-492c-97c8-cf465c7fa004, 'Afin que ce gratin soit moins acidulé, j''ajoute des morceaux de pommes aux framboises (je mets donc moins de framboises que prévu). Aussi, je mets un peu plus de crème liquide : le dessus est plus moelleux. On peut préparer ce dessert la veille, le mettre au réfrigérateur et le mettre à cuire au dernier moment.', '2008-10-28T18:35:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 3f7db0a0-0559-44dd-bf09-e2c05999c02a, 'Un délice et très facile à faire.  Je l''ai fait avec un mélange surgelé de fruits rouges. Mmmm!', '2008-08-31T02:57:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, a441ab0c-9ed4-4985-87f8-b84f7c2dc3cd, 'C''est succulent, toute la famille a aimé. J''ai rajouté un peu de crème, et mis le sachet entier de poudre d''amande.', '2008-07-18T12:52:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 99ca5aa9-adf1-47c2-bf7e-aa43d36bd5bd, 'Pas de framboises au marché, je les ai remplacées par des cerises. Bon goût d''amande mais attention à la cuisson, c''est rapide même dans un grand plat et en augmentant les proportions... A mon avis meilleur froid ou à la sortie du four avec une boule de glace que tiède.', '2008-06-30T00:03:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, c34434f7-d43a-4d36-a599-3ceacc385a6c, 'Succulent. Je l''ai laissé cuire 20 min et mangé froid, très bonne recette! ', '2008-06-29T20:30:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 282c3538-c4b9-40d9-bfd8-177fb0944c8c, 'Recette essayée avec des fraises, excellent mais plutôt froid que tiède! A faire et refaire !', '2008-04-06T22:52:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 885a2729-2da0-42bb-a6a4-ebd6b7d2ef9e, 'Rapide, facile et surtout excellent. Aussi bon tiède que froid. J''ai fait cette recette dans des petits caquelons individuels et complétés par d''autres desserts. Bravo.', '2008-02-03T19:14:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 8b1b94b5-1f9e-4549-b593-c61e5b1c2f27, 'C''était excellent, parfait,... et tellement simple à faire!!!', '2007-12-31T16:51:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 4d5b937e-c41d-4443-b0a3-4254b05ae845, 'Dommage qu''on ne puisse mettre 6!!!! Dieu que c''est bon, et simplissime à faire, SUPER !!!!', '2007-09-16T22:13:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, b6f7c1f8-a0a1-4f9f-b144-c7b6af383fcf, 'Dessert sublime pour une préparation aussi rapide. Succès assuré auprès des invités. J''ai mis 2 oeufs entiers et 20 cl de crème fraîche entière, et avant de recouvrir les framboises, je les ai saupoudré de sucre vanillé.   Un conseil : rester devant le four, la cuisson est très rapide. Avant de servir, j''ai ajouté une boule de glace vanille sur chaque ramequin, c''était le top!', '2007-06-14T12:53:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 44378f1c-6517-4bb2-95a1-e5e487a98d92, 'Délicieux. J''ai compilé plusieurs conseils donnés ici : plus de crème, 2 oeufs, du sucre vanillé sur les framboises, moins de sucre dans la crème d''amandes, et 10 min à 180° avant de faire gratiner. Résultat encore liquide à mon goût, mais délicieux quand même. Le lendemain, le gratin se tient mieux.', '2007-03-12T12:36:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 3d0bde14-8d9a-4a71-811c-dd75396dcbee, 'Délicieux! Rien à changer mais j''essairai aussi ce dessert avec d''autres fruits: pommes, poires... et je suis sûre qu''on se régalera!', '2006-11-26T19:53:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, acc1c2b4-b958-4fce-b12d-be62f40fad35, 'Bon mais... j''ai mis 200g de framboises pour la moitié de la quantité de crème et on ne sentait pas trop le goût de frangipane. A refaire avec les bonnes proportions. Par contre je conseille les moules individuels parce que sinon pour servir c''est pas très chic!', '2006-10-01T22:09:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 1cf6eb12-0ad7-4808-9080-c873144f71c2, 'Mmmh! J''ai fait ce délicieux gratin dans des petites coupes individuelles et comme il fait très chaud, j''ai servi avec une boule de glace à la vanille. Et là.... le nirvana assuré! Mille mercis pour cette fabuleuse recette.', '2006-07-19T22:07:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, ec607ed9-1c91-4418-a731-342ad3376962, 'J''ai fait cette recette dans l''urgence pour 2 avec des framboises concassées. J''ai divisé les ingrédients par 2, mis au four à 180°C 10 min environ et passé au grill en restant devant. Nous nous sommes régalés, servir tiède, recette du dernier moment avec fruits rouges. Je vous la conseille. Merci.', '2005-12-25T14:50:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 27893c6a-0555-4267-bacc-62e1e98ac8c4, 'J''ai oublié mes gratins dans le four et... ce fut un délice. Bien doré, très bon. Je mettrai plus de sucre la prochaine fois car les framboises n''étaient pas fort sucrées.', '2005-07-17T21:42:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 309fad93-12a4-4fd1-b403-950b2999e1df, 'Je cherchais une recette pour utiliser mes framboises un peu trop mûres et je suis bien contente!  J''ai saupoudré de sucre vanillé pour faire caraméliser... Assez bourratif tout de même, la frangipane n''est pas légère !', '2005-07-14T15:37:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 8b497394-a5d7-4ce6-b091-3dc47bcf9762, 'Délicieux et si rapide à faire... Pour 4 personnes j''ai utilisé 200 g de framboises réparties dans 4 ramequins plats de 12 cm de diamètre et divisé les autres ingrédients par deux, par contre, j''ai utilisé un oeuf entier. On peut en effet réduire légèrement le sucre si on n''aime pas les desserts trop sucrés. ', '2005-07-08T23:51:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 50965f3f-d9bb-4507-84f8-6450e85fb3fa, 'Recette très bonne, je n''arrivais jamais à trouver une bonne recette de gratin de fruit, là j''ai mis des fraises et c''était très bien, j''ai mis environ 10 cl de crème fraîche et j''ai mis un peu de cassonade sur le dessus! Très bon résultat!', '2005-07-05T15:35:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 7c7d5b31-85d6-4c0a-a58c-938847293ac9, 'Je confirme, c''est très bon!', '2005-07-04T23:32:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 5cef8b9f-d4ba-42ea-bd0a-502b5a17c2cd, 'Somptueux! Mes parents ont adorés! Le gâteau est parti tout de suite! Très facile à faire et surtout très rapide (recette inratable! je vous l''assure!). Personnellement je le trouve meilleure frais, on sent mieux le goût des framboises (ah oui et pour les framboises c''est encore mieux avec des framboises du jardin!!). Super recette! N''hésitez pas à la faire! Merci encore!', '2005-06-20T15:34:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 61b7f498-e76c-437b-9322-a6e9f31f57db, 'Très bon mais un peu liquide. ', '2005-03-21T20:05:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 51feaf8e-c002-40b5-8624-4add45561368, 'Divin, moi qui ne suis pas douée pour les dessert, j''ai épaté toute ma petite famille pourtant experte en ce domaine. A refaire sans hésitation, en ramequin individuel pour la présentation, c''est simple et inratable, merci !', '2005-03-02T21:22:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 0725eb7e-fdd7-4076-bedc-f4ec7434a6f5, 'Original, délicieux et présente super bien. Je l''ai fait dans des ramequins individuels.', '2005-02-05T01:49:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 8353882b-93c8-408d-ba85-9a5c9c35ad2e, 'Excellentissime! Dessert original et délicieux, qui convient très bien pour épater des invités. J''ai essayé une variante -aux pommes et aux poires- mais c''était beaucoup plus fade. Les fruits rouges sont ce qu''il y a de meilleur pour réaliser ce plat si savoureux.', '2004-11-12T15:17:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, e1227db0-2c74-43bd-8d92-da5fe112334f, 'Quelle doit être la consistance du gratin ? car une fois, je l''ai fait et c''était plutôt liquide ! merci d''avance.', '2004-10-15T19:24:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 99c73223-639f-40bb-b374-fb8c5ee097c4, 'Délicieux mais attention pour ceux qui n''aiment pas les desserts trop sucrés et ne pas hésiter à rajouter 2 cuillère à soupe supplémentaire de crème fraîche liquide.', '2004-09-20T13:26:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 1b25dafc-d2a2-4864-9ccf-96f68c95c86b, 'Très bon en suivant les conseils des internautes notament de Caroline. J''ai mis 15 cl de crème et j''ai fais cuire 6-7 mn à 180°C puis j''ai fais dorer sous le grill.', '2004-09-16T14:51:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, bc82d3c4-e45e-4f64-ae32-835702c0ed84, 'Simple, rapide et excellent. Que demander de plus ?   Moi, je le fait dans des ramequins individuels...', '2004-09-11T15:45:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 8c01852f-450b-432a-8490-49117b6ab6a7, 'Exceptionnel! Facile et rapide et succulent. Nous avons mis les deux oeufs entiers. Il faut effectivement faire attention avec le grill et la hauteur de la grille. Son seul défaut: il se mange trop vite! :)', '2004-09-08T11:15:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, ca3254ab-01b4-43f3-b574-3be7ddbc95e0, 'Excellent dessert... Mais je pense que la moitié du sucre suffit.', '2004-09-05T22:18:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 4d0ff942-089f-4b3a-aa55-7c73d7315cb1, 'Je me suis complètement trompée dans les quantités, mais c''était tout de même bon: 500g de framboises (surgelées), 15 cl de crème fraîche et 2 oeufs entiers. Et nous l''avons mangé tiède.', '2004-08-30T09:24:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, fa132a62-e0aa-4642-8323-4388aac1fc36, 'J''ai carrément fait un gratin de fruits rouges (framboises, mûres et myrtilles) et c''était très bon. Les proportions sont bonnes, sauf pour la crème, il faut effectivement en mettre plus qu''une cuillère à soupe.', '2004-08-29T22:20:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, a01452a1-f9c6-42e9-ac63-b55ab3422bdb, 'Merci pour cette super recette facile comme tout, même pour une débutante comme moi!', '2004-08-21T14:04:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 9131f846-077f-4ace-a6d5-979fb89cce76, 'C''est un délice!!! Effectivement, je mets aussi un peu plus de crème. C''est aussi super bon le lendemain, lorsque la crème a un peu épaissi.', '2004-08-14T12:13:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 0d487d59-beb8-4f58-9939-f4cfdcbbb07f, 'J''ai ajoute des mûres, des fraises et une pêche jaune coupée en dés et j''ai mis le tout dans des ramequins individuels. J''ai également mis plus de crème fraîche dans la crème d''amande, que j''ai répartie dans les ramequins. Puis j''ai tout mis au four une dizaine de minutes a 180°C et mis sur gril 230°C pour 2-3 minutes à la fin pour que le dessus soit doré et légèrement craquant. Ces petites crèmes ont eu beaucoup de succès!!', '2004-07-30T10:19:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, eaddb5fa-d5c2-424f-ae12-63a304dbac88, 'Mettre moins de sucre!', '2004-07-20T10:21:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, cdeea32d-ace1-4df4-b3f9-b4a9ce54170a, 'Un vrai régal...', '2004-07-19T14:34:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 743c3456-c6a6-47d3-b631-93a281303506, 'Gros succès auprès de mes pensionnaires. J''ai remplacé les framboises, rares et hors de prix en Polynésie, par des papayes.', '2004-07-19T06:44:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, c4c05b71-d9c0-4673-b045-8c2aaca31e12, 'Excellent, rapide à faire qand il y a des invités (se prépare à l''avance) mais il faut vraiment mettre 15 cl de crème pour que ce ne soit pas trop sec.', '2004-07-17T08:51:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, c328a54f-b475-4b74-9974-1864ce805010, 'Exquis! Attention, la crème dore très vite...', '2004-07-15T22:25:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 0f2b6d7b-a634-41a0-bb69-88453ef6a9df, 'Très commode à faire lorsque vous avez de nombreux invités, il suffit de les présenter dans des moules à crèmes aux oeufs!', '2004-06-06T15:54:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 36ff1384-2ff8-4e1b-8768-d79473466945, 'Pour ma part, je mets beaucoup plus de crème (environ 15 ml), le résultat: une couche gratinée et une couche plus onctueuse en dessous (et moins sèche): délicieux!!!', '2004-03-23T09:27:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17263, 8d0d0535-ec1c-4f5b-8271-3cc530be5dcb, 'Bon, j''ai augmenté la quantité de crème pour bien recouvrir toutes les framboises.', '2003-10-16T21:58:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337257, 112153c3-729a-4ba4-bc28-1c9d6f134d88, 'J''ai seulement 15 ans et je ne pensais pas y arriver, mais je suis assez contente du résultat.', '2018-08-13T13:18:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337257, af502ac4-5249-477c-bb47-a432c6ddafc9, 'Première tentative réalisé pour Pâques. Tout le monde s''est régalé. 
Un peu long à faire mais en suivant la recette tout va bien. Pour ma part, j''ai utilisé du pralin déjà fait et j''ai pas fait de macaron.', '2023-04-09T16:18:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337257, ba9ada42-5569-4558-8666-626735284ce9, 'Longue préparation mais en suivant les étapes on arrive a un bon résultat.', '2021-02-13T00:24:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337257, e51f7a0e-af9a-4d38-971c-e1df45dcf7d4, 'Très bon', '2019-02-08T07:56:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337257, 0b543e7d-2cea-4035-bad8-9961c20cea0c, 'Très très bon ! J''ai remplacé la gélatine par de l''agar agar. Et j''ai fait refroidir la crème vanille (qui deviendra la mousse vanille) à l''air libre car au frigo elle s''était trop solidifiée. Sinon : parfait.', '2016-09-12T19:19:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337257, 05c6d765-df19-44c3-aa32-ecbc561f9dcf, 'Excellent au lieu de faire une mousse vanille, j''ai mis de la liqueur de litchi et je n''ai pas fait la feuilletine  (question de goût) mais c''est vraiment délicieux ! A refaire !', '2016-09-01T14:12:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337257, d614d387-fb4f-44fb-9539-d9a1b35664a2, 'Très bon et facile à faire en variant le parfum c''est tout aussi réussi et parfait !', '2016-08-25T00:58:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337257, a2d31111-751f-48c3-8515-132e3445711f, 'Juste parfait !!! Les temps de prise sont longs mais les étapes sont faciles à effectuer en suivant la recette. Léger, aérien effet garanti ! je me sers parfois de certaines étapes pour une autre recette. Merci !', '2016-04-10T23:06:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337257, 45fc5a22-9c28-4b26-9c60-8601a64782a4, 'Très bonne recette. Je l''ai faite pour Pâques et on me l''a redemande déjà. Par contre, j''ai fais génoise, couche pralin, bavarois framboise, mousse vanille et miroir framboise. Ensuite je décore selon mes envies.', '2016-04-09T13:05:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337257, dfb91fac-7953-4da1-88e2-d90f8c3f95c8, 'Bon. Délice ', '2015-12-09T17:21:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337257, 036ca4ac-70db-41c7-9af7-8b4db4769aaf, 'Très bon. Prend beaucoup de temps mais ça vaut le coup! ! J''ai juste remplacé le pudding (dans la mousse vanille) par 133 g de chocolat dessert car je suis très chocolat! ! Merci pour la recette! ', '2015-08-12T17:59:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, c46fc6fb-7f5a-4b63-894e-31d456aef392, 'Excellente ! J’ai ajouté pour réduire l’acidité une préparation avec trois œuf battus avec trois cuillères de crème fraîche et un peu du jus de la cuisson de la rhubarbe. ', '2020-06-21T23:34:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, f67ade14-3a50-4f77-91d9-b8e9c3c68013, 'Excellente ! Suivre la recette mot à mot !', '2022-05-25T08:35:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 29e8374b-7078-483f-bb23-5006212f98c2, 'N''étant pas fan de meringue, je l''ai supprimée. Pas de précuisson de la pâte pour moi: J''ai  égoutté à fond la rhubarbe cuite,  déposé après cuisson les fraises préalablement macérées dans le sucre et saupoudré de sucre glace avent le service. Très bon dessert.', '2020-06-01T15:21:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, b1f1eaec-e781-4167-afae-efba52b8bb18, 'Bonne recette. Un peu trop sucrée toutefois.', '2016-06-20T08:16:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, d27f9c7e-a974-43c7-8630-c57248b3e890, 'Délicieux.', '2016-06-04T20:21:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 354fdb4a-0795-4bc3-8c9a-8fd5135d16db, 'Recette absolument parfaite, on m''en redemande tout le temps !', '2014-08-27T15:27:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 65430132-1b93-4e89-855d-4d1f9697ec8e, 'Un régal ! J''ai juste diminué la quantité de sucre car j''avais des fraises très parfumées et j''avais bien fait dégorger la rhubarbe dans le sucre. J''ai donc ajouté un sachet de sucre vanillé pour faire compoter la rhubarbe et un autre sachet de sucre vanillé pour les fraises. Servie bien fraiche, cette tarte a rencontré un véritable succès! Merci !', '2014-05-31T10:53:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 93dfd2a5-ff8a-48e9-88fc-e87bda85fb05, 'Super bonne !! J''ai un peu loupée ma meringue dessus, mais c''est parce que je l''ai faite trop tôt ! Tout est bon, j''ai mis un peu + de rhubarbe :)', '2014-04-25T13:03:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 7acd9d2c-e95e-417f-b4c6-f05bb72ae916, '...laisser réduire le jus de rhubarbe et le sucre pour une petit gelée à étaler sur les tartines au petit dej´.', '2013-07-10T12:10:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 2106096e-2f7e-4982-aecf-98bb9098c4d3, 'Rien à changer.', '2013-05-18T14:11:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, c7241220-60c1-4bc3-927a-05762e9e96c6, 'Je n''ai pas mis de fraises, ce n''est pas encore la saison. J''ai donc mis 1.2 kg de tiges de rhubarbe, cuites avec 120 gr de sucre (c''est suffisant) et 2 sachets de sucre vanillé en fin de cuisson. Très bonne recette, même avec une pâte feuilletée. Très beau visuel. Ça fait un dessert chic... Les temps de cuisson indiqués sont parfaits. A refaire sans hésitation', '2011-03-28T11:37:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, bb56bd4f-2bd3-4a8a-96cb-f1ef7a2e87a3, 'Pas mal , mais pas super génial !', '2009-05-29T19:38:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, e5ab6d8e-15ce-4ce7-8fac-fcc7df9ce7b1, 'Parfait! J''ai respecté les doses de sucre à la lettre et je trouve l''ensemble légèrement sucré, mais très agréable. Par contre, je suis un peu déçue par la "meringue", pas assez craquante à mon goût. Merci, merci!!', '2009-05-10T00:39:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 23094071-f9a5-427a-8b51-5e5c7dba3284, 'Très bonne recette, qu''on peut aussi faire avec de la confiture de fraises à la place des fraises : on sucre alors à peine la rhubarbe.', '2008-08-15T15:29:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, c714a128-a140-4b51-935d-fb981774894a, 'Parfait! Même sans les fraises et en ayant laissé brûler la rhubarbe... Je me joins aux commentaires précédents en ce qui concerne le sucre : c''est tout aussi bon en en mettant un peu moins.', '2008-07-10T14:28:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 0aeca11d-54aa-460c-ae43-b7ed2afcf211, 'Délicieuse! J''ai mis un peu moins de sucre, comme conseillé dans certains commentaires et j''ai utilisé une pâte feuilletée.', '2008-06-19T22:24:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, ab39d0de-a17c-45f5-b7b0-cb75ce37084e, 'Tout simplement délicieux...', '2008-05-12T01:26:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, f066d720-43cf-4ae4-88ee-a2c184b811be, 'Sublime! Avec juste un peu moins de sucre (150 à 200 g en fonction des fraises) et une pâte sablée...', '2008-05-09T00:15:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, d9ca4854-3df2-4222-b7a9-c0910591262b, 'Tout simplement délicieux; et pourtant je n''avais pas de fraises: j''ai donc utilisé un sachet de fruits rouges surgelés. Je conseille toutefois de mettre 150g de sucre seulement pour conserver un peu l''acidité de la rhubarbe.', '2008-05-07T17:11:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 858fc733-cd38-40f2-8f70-f3d26634c84b, 'Un vrai délice! Des saveurs subtiles en toute légèreté, mes amis ont adoré! J''ai déjà envie de la refaire. Je conseille simplement de ne pas mettre le jus des fruits et de les saupoudrer d''un peu de poudre d''amande!', '2008-03-25T14:37:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 8931ed25-c2b7-41de-bd01-16e20bbba613, 'Délicieux. A faire telle quelle. Il m''en restait un peu et je l''ai congelée : elle était bien moins présentable mais gustativement intacte : mon ami et moi nous sommes régalés sans cuisiner!', '2007-10-29T12:50:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 3d798cd9-36a1-4a72-a16e-0b61415861fd, 'Excellent, facile à faire. Testé pour un repas entre copains comme pour un repas de fête, ça fait toujours autant d''effet. Petit bémol, la meringue est un peu molle.', '2007-08-25T17:17:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 65627ca8-6cb3-400e-9c58-6faeb49718e0, 'Très bonne recette, la fraise et la rhubarbe se marient à merveille et la meringue pas trop sucrée enrobe le tout de son petit nuage de douceur. Allez y sans hésiter. Merci pour cette recette. ', '2007-07-07T13:24:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, cf8f8b36-238c-4879-b937-66cee4281f11, 'Très bonne avec des fruits du jardin et une pâte brisée maison. Je me suis permis de faire quelques petits changements : pas de meringue, et seulement 150g de sucre pour la rhubarbe (je voulais garder son acidité) et juste un saupoudrage sur les fraises.', '2007-06-06T13:43:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, f359e913-bbf8-4e50-8a44-91c3fe52d083, 'Un pur délice, tant par le goût que par sa présentation dûe à la meringue.  A refaire vite et sans hésitation. ', '2007-05-20T15:03:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, bfe465ca-1b7f-4c08-9106-36a5a6da1e3e, 'Délicieux. Le mariage acidulé de la rhubarbe et la douceur des fraises est parfait. A faire même sans la meringue pour mieux apprécier le mélange!', '2006-07-19T15:31:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, cfbff4d1-91fc-43fa-91d1-98c1108f3898, 'Délicieux! Juste dommage que la meringue ne soit pas dure.  ', '2006-05-01T14:42:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 286eb663-0ede-45a4-9639-138bcd77a6e4, 'C''est ma recette préférée de tarte à la rhubarbe.', '2005-07-30T15:05:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, cc517103-5393-41dc-b6a4-c7f03782c95f, 'Une tarte idéale pour les gens qui n''aiment pas tellement la rhubarbe, des fois un peu trop acide. Je préfère la rhubarbe non blanchie, je la coupe une petite heure avant, et je la sucre, puis j''écume la rhubarbe avant de m''en servir. ', '2005-05-12T16:06:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 05fb0d1c-108d-4504-8643-4a8b14f4fc2f, 'Un délice! Fan de rhubarbe, c''était mon premier essai de tarte meringuée et je recommencerai!! La douceur de la meringue équilibre parfaitement l''acidité de la rhubarbe et ce n''est même pas difficile...', '2004-10-09T18:26:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 33bcd114-c971-4304-8f0e-583957c5177e, 'Mmmm, quel délice! Le seul hic, c''est la meringue qui se rétracte à la cuisson, du coup on cherche la meringue une fois les parts découpées. Je ferai donc plus de meringue la prochaine fois. Sinon, j''ai achetée de la rhubarbe surgelée que j''ai faite cuire avec des pommes. Un régal!', '2004-06-24T16:28:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 73984e1f-11c5-472b-b270-648d6d670617, 'Un délice. Juste un peu trop sucré (250 ou 300g suffisent). Pour ne pas gaspiller les jaunes d''oeufs, je les ai rajoutés avec de la crème avant de la faire cuire.', '2004-05-30T12:45:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 731e7d21-35b4-474c-87ef-965fedfb0323, 'Super bon! Je l''ai faite sans meringue et avec une pâte sablée à la vanille. Enfin, comme je n''avais pas assez de rhubarbe, j''ai disposé des quartiers de pommes tout autour de la tarte: très joli et délicieux!', '2004-05-17T14:11:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, b96b11f0-0bfa-4f81-8933-d9501dfef67a, 'Tout simplement extra (même sans la meringue, si vous êtes en manque d''oeuf! :-)).', '2004-05-16T13:21:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 8cc903af-d03f-43ef-80e2-1bbc926403fc, 'Très très bon et très facile à faire. Je vais d''ailleurs aller en manger une deuxième part!', '2004-04-03T21:31:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14304, 3275707a-5d9a-4c78-88a1-d4e6aced2275, 'Une tarte qui ravit les plus réfractaires à la rhubarbe! Le mariage des fraises et de la rhubarbe est très doux. A essayer peut-être avec une pâte sablée pour réhausser le sucre qui reste assez timide.', '2002-05-19T17:23:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 6e960815-909e-4393-a36f-9587b4176443, 'Super bon ravie de cette recette. ', '2021-10-30T08:14:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, dca07906-dce2-460b-ada6-e3dcd924804d, 'Très bon, j''ai mis seulement 250 g de mascarpone pour que ça ne soit pas trop bourratif. Avec seulement 50 g de sucre cristal c''était largement assez sucré, étant donné que le coulis sucre beaucoup. ', '2016-02-18T16:23:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, dc642189-29b7-499c-8fc8-336be555c451, 'Simplissime ! Et excellent ! ', '2023-07-02T12:21:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 839657c6-547a-45af-a5b6-32f5c6032ecf, 'J''ai mis 75 g de sucre glace, fait les verrines avec du spéculoos, des framboises et un coulis de fruits rouges. Très bonne recette !', '2017-10-18T03:08:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, a8bbcd75-0e51-4da3-a27d-3d1ab91eec9a, 'Super recette, moi ça me fait 8 verrines. Merci beaucoup pour cette recette délicieuse. ', '2017-03-05T22:32:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, d7d32df6-5333-4c71-9bd1-b9f8f4c3ff01, 'Très bon. J''ai utilisé 250 g de mascarpone et 50 g de sucre glace et j''ai mis du speculoos, pour 6 verrines. A refaire !', '2017-01-28T23:24:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 9d8a9b1e-9b5b-4c63-a37b-af2a71e996d9, 'J''ai mis des speculoos et des morceaux de pistaches sur le dessus. Un régal, et à refaire rapidement.', '2016-11-07T11:57:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 2b5a9dd2-1877-4d5b-bf7a-e7cfad3d61ce, 'Bon dessert facile à réaliser. Faite avec des framboises surgelées, certaines étaient un peu molles. Merci pour les commentaires antérieurs car je confirme la moitié de sucre suffit et j''ai commencé par la mascarpone également. Revoir les proportions car pour 8 verrines il me reste énormément de mascarpone.', '2016-07-24T23:41:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, c79d1833-d31e-498f-a51d-16c90d628af6, 'Au top !!', '2016-04-29T15:16:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 4d32b255-4aca-4a6d-8097-c31ebc111a2d, 'Délicieux', '2015-09-16T10:46:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 76e4d3a5-3eb4-4982-9ee3-89ed50196300, 'Recette excellente et facile à réaliser ! ', '2015-07-12T13:50:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, c291705f-b963-4af9-8de6-c55302ce44b4, 'Excellent !', '2015-06-07T19:42:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 1138b3ba-de1f-4a85-bc24-3204e8b5053a, 'Très bon, tout le monde a adoré, j''ai juste commencé par la préparation au mascarpone au lieu du gâteau émietté.', '2014-11-30T22:46:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 6ff88ebb-0a05-406f-9065-4e8f3a2ef466, 'Excellente recette, pour changer, on peut y mettre des spéculoos au fond, c''est tout aussi croustillant et ça raffine le goût !!', '2014-11-28T19:04:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 1374f3e7-55ee-4fe4-a537-4264f9b64265, 'Je l''ai fait avec des morceaux de fraises et un coulis de framboises. Délicieux. Proportion pour 8 verrines !', '2014-07-28T01:37:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 4b7dfd2d-0bb5-4bd5-b43a-7337a928d6b2, 'Super ', '2014-06-04T16:37:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 9a64c69e-a783-45b8-9bb9-72d267c72bc9, 'Super ! Je n''ai pas exactement ce qu''il me faut mais en revanche ca ma donne une idée', '2014-05-22T16:20:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, e0063343-b873-474a-b45f-f1367d5e526f, 'Super bon et jolie à voir !! Effectivement le sucre est à réduire et j''avais beaucoup trop de préparation pour mes 8 verrines donc un peut de gâchis !! je reverrais les proportions à la baisse la prochaine fois ! Merci pour cette recette !', '2014-04-06T02:30:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 7eea3aba-64a2-4add-a87b-66ba9c5b268a, 'C''est la recette de verrine framboise-spéculoos inratable que j''adore préparer ! Une recette que je fais souvent.', '2014-02-08T17:37:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 2d60b6f3-3ff8-402a-9f6e-24f6da88d676, 'Un régal. Je recommence dimanche ! Facile, rapide, pas cher. Dessert top. En revanche, je trempe les biscuits avant de les mettre, sinon, c''est trop sec ! Et je mets les framboises dessus.', '2013-08-06T22:37:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, d6fa798c-5f21-4cc1-9488-b9f66cd64808, 'Super bon, une vrai tuerie, tout le monde a adoré et en plus, on peut décliner avec d''autres variétés de gâteaux et de fruits. Moi je commence par la mascarpone sinon on fini part le biscuit et c''est trop sec.', '2012-08-24T13:58:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, ff169182-5524-4ac8-97b2-7162753a2abc, 'Dessert à refaire. Fait avec framboises congelées et seulement la moitié de sucre. Proportions valables pour 8 personnes. Tout le monde a adoré !', '2012-01-07T18:35:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, ba20e973-3775-4938-99a1-00d1b9c7c637, 'Super bon, frais avec les framboises du jardin. Pas besoin forcément de coulis car c''est déjà riche en saveur. ', '2010-07-13T12:44:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 061f32c2-3cb6-4b65-9715-baa8d915241d, 'Tout simplement parfait ! J''ai prépare ces verrines pour un diner entre amis, tout le monde a été conquis ! J''ai suivi les commentaires et revu les proportions de sucre à la baisse (50g). Excellent ! Merci !', '2010-06-16T21:06:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 78b56e70-ac0f-4599-a4c1-792bb8d183eb, 'EXCELLENT!Testé pour un diner romantique et mon mari a adoré!Quantités divisées par 2 et recette faite avec des biscuits roses de Reims. Pour la déco framboises et copeaux de chocolat. A faire et à refaire pour épater mes invités tant sur le goût que sur la vue!!! ', '2010-02-14T23:55:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, fe63f252-0869-4303-a0c0-fb63dc5fe63b, 'J''ai suivi les conseils des internautes en réduisant les quantités de sucre glace à 50 grammes, tout le monde a aimé. A refaire!', '2009-10-31T16:53:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 9a621941-3a1f-4574-8ec1-bcc1daf880f6, 'Très bon et très facile ! La prochaine fois je mettrai probablement un peu moins de sucre. ', '2009-09-08T23:38:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 92f4432a-a56b-49ba-b5ca-80f1e120397a, 'Un véritable succès ! Très facile à réaliser.... Bonne dégustation !!', '2009-08-05T18:22:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 968ff78e-99d2-4dab-b8d9-0edfc029c130, 'La  verrine est vraiment jolie et tellement rafraichissante et légère ! A faire sans hésiter !', '2009-06-30T01:11:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 4e159c35-87bd-4725-9ab9-f686f360bbbd, 'Très bon, j''ai ajouté de la noix coco râpée dans la mascarpone. Je n''ai pas mis de coulis de framboise et remplacé les biscuits par des spéculoos. A refaire.', '2009-05-27T11:20:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 324dce6a-a6fb-46bd-abd6-e8a5d4631148, 'Excellent et ravissant.  J''ai divisé les proportions par 2, et j''ai pu faire 15 petites verrines. J''ai épaté la galerie! A refaire', '2008-09-07T22:53:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, d4be6968-184b-4579-bf31-fe1adef0b9f9, 'Très frais! Mes invités ont tous apprécié. Toutefois, les proportions de la recette permettent de faire jusqu''à 6 verrines et 45 g de sucre suffisent largement.', '2008-07-11T21:07:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, 8634b0ea-27a5-452d-8b4b-5c17e34dc20a, 'Excellent et très joli. Cependant les quantités me semblent énormes! Avec la moitié de mascarpone, j''ai réussi à faire 6 verrines et il m''en restait presque autant... Par goût j''ai beaucoup réduit la quantité de sucre glace (45 gr) et j''ai utilisé des spéculoos comme l''indiquait le premier commentaire. Tout le monde a adoré!^^', '2008-06-16T21:38:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70589, ec92fdaf-7289-4b51-ace2-25a693b2e164, 'Excellent et très frais ! Par contre il faut diminuer un peu le sucre. Je l''ai fait avec des "spéculoos". J''ai mis le coulis de framboise, mais cela n''est pas nécessaire. A refaire !', '2008-05-20T10:37:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 4ec42e1a-894e-41d7-a7ca-60296d4a3616, 'Un délice :)', '2013-06-25T15:52:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 26b84173-b73d-417d-bf90-c5b6b00c3ae9, 'Moi je dis excellent!! Fait avec une bouteille de bourgogne Chardonnay 2012 et une bouteille de Monbazillac, car je ne savais quel vin prendre... Par contre j''ai laissé macérer pendant deux jours ayant dû absenter.... Un régal. Merci pour cette recette.', '2013-06-20T23:40:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, e5be34f7-6e79-4b3a-b26d-0df38f7a490f, 'Se boit comme du petit lait !', '2016-08-15T21:02:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 1d00e7a3-d926-4d86-8850-96e9c6309d2e, 'Apéro réussi, bien le servir frais, ne pas trop sucrer, c''est un régal ! Je le refais pour l''anniversaire de mes enfants (pas pour eux !!!).', '2010-06-08T19:46:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, c2bf620b-2495-4363-bd51-3d9b3899a7ce, 'Préparé avec un sylvaner, 2 sachet de sucre vanillé et 50g de sucre en plus, c''est abosolument divin.', '2007-05-27T12:59:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, f0261c31-ca4f-4aca-b770-7392d97afe6c, 'Délicieux même avec un vin blanc sec de piètre qualité c''est pour dire!!! Pour le filtrage, j''ai galéré avec le coup du bas sur le collant. Finalement, j''ai d''abord filtré au chinois puis j''ai embouteillé avec l''entonnoir et c''était beaucoup plus simple...', '2005-07-07T11:58:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, ca26c8d3-7700-4cfd-9555-237536a9a4cf, 'Très bonne recette. J''ai ajusté les proportions pour 1,5 litres de vin (puisque les bouteilles font en général 75 cl, c''est plus simple). 1,5 de vin, 700 g de fraises, 120 g de sucre. Je ne mets que 4/5 parce que le type de vin n''est pas précisé. Or à mon sens, c''est capital! Il faut prendre un vin moelleux, qui accompagne le foie gras et les desserts, type Jurançon ou Sauternes. Je pense qu''il vaut mieux mixer les fraises avant de les incorporer au vin. Pour la filtration, je l''ai effectuée en deux temps: tout d''abord j''ai passé la boisson au chinois puis j''ai filtré avec un entonnoir voluptueusement agrémenté d''un mi-bas (un collant fait l''affaire)!', '2005-06-03T17:46:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 7be7d52f-104e-4fb0-b087-694af6f0cdcd, 'J''aime les fraises, j''aime le vin, mais les je n''ai pas aimé du tout les deux ensemble. Cela ne donne pas du tout envie de reprendre un deuxième verre. En tout cas, j''ai eu du mal à finir le premier, le mélange est douçâtre, fait perdre toutes les qualités intrinsèque du vin. Sans intérêt !', '2012-06-13T15:04:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 844bbb99-baa9-4b4d-8c8a-1c9f771f1980, 'Délicieux. Je mets un peu moins de sucre (150 g). C''est également très bon avec des merises (dont je ne savais plus quoi faire). Tout le monde adore. Merci pour cette recette.', '2012-05-16T21:23:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, c9426a3a-22f4-4c10-bfe4-a39e99577bcb, 'Mon grand succès de l''été ! Idéal quand on est invité chez les amis, ce vin de fraises a fait l''unanimité (surtout avec du rosé). Attention, quand c''est bien frais on ne sent plus l''alcool, consommer prudemment... mais avec délice !', '2011-10-16T11:02:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, ac325edb-1fd8-4d76-954c-ceaa2d5ae4fd, 'Délicieux ! Tous nos invités adorent. On a d''abord utilisé un vin de Loire fruité et ensuite on a essayé avec du rosé  ', '2011-07-28T01:12:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, cdeddd8c-a82b-42b5-a71e-dd670188e67d, 'Fraîcheur, saveurs... On s''est régalé. J''ai essayé avec un rosé, miam ! Mais je suis en train de tenter le blanc moelleux. Je pense que ce sera encore meilleur avec ce vin plus doux et sucré ! Et puis ça surprend les invités qui en redemandent, et ça, j''adore. ', '2011-06-24T21:22:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 4bbef8bc-2c29-4508-94a1-ff621c674b23, 'Délicieux ! Mon chéri n''aime pas trop les fraises et pour ma part, je n''aime pas le rosé, la partie n''était donc pas gagnée d''avance ! Nous avons trouvé cela parfait à déguster en amoureux par cette belle soirée de printemps, c''est dire combien cela nous a plu ! Nous allons organiser une grande fiesta d''ici peu, cela sera une jolie manière d''honorer à la fois nos amis et notre Jardin Généreux et sa belle récolte de fraises. J''ai ajouté un peu de sucre car, peut-être à cause du rosé, la première dégustation donnait un goût trop rude... Cela vaut la peine de goûter le résultat quelques heures avant de le servir. Après, ce fût juste parfait ! Merci ! Bravo !', '2011-05-28T22:29:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 69764b4f-212d-4a16-b47b-a50eae0f20ab, 'Excellent !!! Mais attention, j''ai fait mon vin de fraise il y a 15 jours et l''une des bouteilles que j''ai voulu ouvrir aujourd''hui a littéralement explosé : je ne sais pas à quoi cela est dû, peut-être de la fermentation mais pourquoi ??', '2010-09-08T18:37:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 33a71c44-ce88-4f0f-8a18-90603fca63df, 'Moi aussi je l''ai essayé avec une bouteille seulement et je n''avais que du rosé... C''était excellent !!!!', '2010-07-16T16:57:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 06d2934a-2e25-4dc0-b6d2-311036bccecd, 'Je l''ai fait seulement pour une bouteille de vin car j''avais un doute, mais c''était tellement bon que je viens d''en refaire en essayant avec du rosé. Comme mon jardin regorge de fraises, je vais en faire assez souvent je crois !!! Servi bien frais, c''est vraiment excellent à l''apéritif.', '2010-06-26T11:24:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 61c90070-8428-48e7-a831-e465473773b2, 'C''est super, je l''ai essayé avec un muscadet sec et un bourgogne aligoté, à réaliser selon votre goût, plutôt doux ou plus noté, mais à tous les coup elle plaît... Merci pour cette super recette !!', '2010-06-25T14:48:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, cd215309-d476-4c71-9828-b9b75e6668e3, 'Un vrai délice ! Je le bois très frais et mon mari ajoute dans son verre un trait de vodka. A consommer avec.... Félicitation !', '2010-06-06T13:02:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, f09a6a51-b8cc-48e4-ad74-045f40d19eb0, 'Congrats, congrats, congrats. Quel succès. Préparation de plus ultra rapide : dry sherry blanc (vin blanc bien moelleux) + fraises et voila. Pas besoin de sucre. Filtre avec une passoire très fine pour le thé. Mes invites ont a-do-ré (pourtant anglais un peu difficiles...). Merci, merci, merci...', '2010-06-02T18:18:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 0ec2a0cc-ed5f-41bf-b2d0-2a57107e7d33, 'J''ai fais ce vin pour le baptême de ma petite fille (36 bts)tout le monde a aimé.Pour servir j''ai surgelé de grosses fraises qui ont serviesde glaçons', '2010-02-21T12:55:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, b094b1f5-0486-41a3-a12b-ef7908028da4, 'Un vrai délice. J''ai réalisé la recette avec 75 cl de vin, un Bourgogne. Il me semble que si j''avais pris un vin moelleux, l''apéritif aurait été un peu trop sucré, selon les proportions de 350 g de fraise pour 60 g de sucre.', '2009-04-23T12:24:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 765b7c42-d80d-4371-b9ce-c3e5456786ba, 'Original et pas mauvais du tout. Je l''ai apporté chez les cousins pour l''apéro, il a été fort apprécié. A refaire et à recommander.', '2008-11-19T19:38:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 845fbbdc-389b-43af-8b95-352959adce8f, 'Trés bon et frais, passe bien à l''apéro.', '2008-09-09T19:30:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, a0a3e162-062a-4abc-af7c-e0a475a93538, 'Succulent et facile à faire! Parfait pour une réception sur le pouce, décidé quelques jours à l''avance seulement. Même ceux qui n''aiment pas le vin ont aimé. http://picasaweb.google.fr/MEDRO13/LeTempsDesFraises/photo?authkey=C0NS4rb1c58#5223421416621389266', '2008-07-16T17:36:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 3dd088f9-23af-47f4-b1a9-b8f92d9a6b05, 'Trop top! Tout le monde a aimé. Long à filtrer, plus rapide en utilisant un chinois à deux fois en laissant le vin se décanter.', '2008-07-07T14:01:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 429110bf-5c33-48cc-8fae-017e70810b79, 'Tout le monde a apprécié. Pour l''été, c''est parfait, bien frais.', '2008-06-23T19:42:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 801823e8-4e27-49e5-9b64-3a023bf85860, 'Recette surprenante!!! Très réussi avec du muscadet, tout le monde a adoré. Avec la chair restante des fraises, j''ai fait de la compote pomme-fraise qui ne garde que peu le goût de l''alcool. N''hésitez pas, lancez-vous!', '2008-06-23T12:26:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 683d38bd-5681-44f3-a7d3-0f5452cc449a, 'Cela va faire la 3eme année que je fais de cet excellent vin dont tout le monde raffole et qui se boit comme du sirop mais attention ..... aux maux de tête! Par contre attention moi il m''en restait une bouteille de l''année dernière et elle n''etait vraiment plus bonne (je n''avait pas fait de cuison de peur de perdre cette magnifique couleur).', '2008-06-16T16:43:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 5e98397c-cab1-456d-b091-91a8046cb1d1, 'Une recette délicieuse pour un apéritif en amoureux et très facile à faire en très peu de temps.', '2008-06-08T12:43:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 81f9ba4d-48bf-4903-9f16-9e47027996a4, 'Délicieux! Tout le monde à adoré et en a repris! J''ai suivie la recette à la lettre et c''était succulent! J''ai utilisé du vin blac moelleux! Il me reste encore 2 bouteille mais je n''hésiterai pas à en refaire une fois fini!', '2008-05-13T10:21:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, abf156e8-3bd6-4d5a-8191-69125bfa715b, 'Beaucoup de succès !!! Laisser reposer 2 mois dans une cave avant de consommer, plus le vin "vieillit" plus il a le goût de fraise...Hummm. ', '2007-10-30T19:24:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 312c8790-4350-4652-ae42-23f248c1a76b, 'J''ai essayé cet été...ça a la goût d''un kir, pas mal...par contre ça c''est mis à fermenter en bouteille et les bouchons ont sauté tous seuls au bout de quelques jours!!', '2007-10-20T22:42:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 5ffdc32c-9179-4903-b0fa-eb94e421dfc0, 'Très bon selon les dires de ma famille. Moi j''ai juste préparé car je suis enceinte ! Un peu long à filtrer. J''ai utilisé un vin blan sec.', '2007-06-19T18:02:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, d06a1a9d-9f82-48dc-8d4d-0399d653a565, 'Vraiment délicieux! J''ai également réduit les proportions pour une bouteille de vin, soit 75cl, 350g de fraises et 60g de sucre et j''ai utilisé du blanc moelleux.', '2007-06-04T14:55:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 61200871-d8de-4c0d-8d41-fcb241ea105f, 'Très bon... Ca va être super pour l''apéro cet été.', '2007-04-04T18:27:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 2d1a13ce-572e-40af-9c15-fc7116992c16, 'C''est tout doux, tout sucré et si original! Idéal en apéritif quand il fait chaud (mais on croirait presque que ce n''est pas alcoolisé)!', '2006-07-21T21:18:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 88daa17e-3bc9-4e6c-abd4-296988b2ad74, 'Très bon à déguster l''été mais attention, ça monte très vite à la tête ! ', '2006-07-21T13:26:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 25c10c59-d43f-45b9-a2dd-d478f6ed3ea3, 'J''ai réalisé cette recette il y a 1 an mais j''ai oublié de la noter, c''est chose faite. Ce vin est excellent, frais sucré. Il est top, la bouteille n''a pas fait long feu lors d''1 soirée.', '2006-05-19T18:09:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, adaabad3-4c02-47e9-ac1c-010c26729311, 'Vraiment très bon, mais attention, ça monte vite à la tête...', '2006-04-24T16:39:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 5ba7fba6-09c3-4c71-b064-e15cac33b267, 'Très, très bon. Ca se boit comme de l''eau, mais attention... A consommer avec modération quand même!', '2005-10-29T19:06:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 45479c2b-706b-4f68-affe-38421770dc56, 'Délicieux ! J''ai suivi les conseils précédents pour bien filtrer et j''ai réduit les doses aux quantités calculées pour 2 bouteilles. Parfait !', '2005-07-19T14:25:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 7d8b00dc-0a66-4980-ac6e-62ead2b7ec13, 'Tout le monde a adoré, c''est une très bonne idée pour les apéritifs d''été. Pour le vin, j''avais pris un côte du Rhône blanc. Aucun problème pour filtrer le vin, uniquement au chinois, en écrasant bien la pulpe des fraises.', '2005-07-05T11:25:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 6354f8bc-af6d-4102-b506-210813d37e52, 'Tout simplement délicieux! Essai en petites quantités (2 bouteilles) histoire de voir ce que cela donne. J''ai testé la recette avec un vin blanc plus sec que celui préconisé: un Muscadet sur lie. C''est très parfumé et la fraise vient adoucir le côté sec du vin. A boire très frais à l''apéritif. ', '2005-06-17T20:38:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, adbbffd4-8587-46d5-94ad-71247aeb0645, 'Pas mal du tout, à refair. Dommage que le type de vin blanc à employer n''est pas précisé...', '2005-06-15T21:05:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 1300ffaa-5fb6-4057-b5f7-90b945035a51, 'Délicieux.  Le problème c''est que ça se boit trop vite.  J''ai suivi les proportions mais pour nous, avec un vin doux, c''était un chouia trop doux donc j''ai rallongé un peu.  ', '2005-06-13T19:43:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, cda16ab0-47ec-47ca-80fa-4673343cf9cb, 'Très très bon. J''ai ajusté également pour avoir les proportions pour une bouteille. J''ai également suivi les conseils des autes marmitonnautes: vin moelleux, filtrage avec un collant (après avoir perdu patience avec des filtres à café, une passoire à thé...) et mixage des fraises.', '2005-06-13T12:41:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, e6e4892c-6173-480f-8918-7cf51d4e61cd, 'J''adore !!! C''était la première fois que j''essayais et ma foi je suis plus que satisfaite du résultat. Un bon vin doux qui se boit avec exquise, on en reprendrait jusqu''à finir la bouteille, tant le goût est savoureux, mais attention ;) C''est une super recette de saison miam miam ou plutôt glou glou !!', '2005-05-11T14:27:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 95aff0c3-4f74-44b3-b041-ec5640627b1f, 'Très bon, très frais, parfait pour un apéritif d''été.', '2005-04-30T18:30:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, a4407518-aacb-4456-91a8-20b65c3465b0, 'Un vin pour un apéritif d''été super. Très frais, très goûteux, très facile à faire... Bref, pourquoi s''en priver!!! (j''ai pris un vin blanc moelleux)', '2004-07-03T10:31:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 75dbb1b4-9672-41ed-aa1a-0c8815ac0011, 'Très bon, très frais, facile à faire. Parfait pour l''apéritif. A consommer cependant avec modération car ce vin se boit sans soif!', '2004-06-19T10:06:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, 00216fe5-74fc-4a17-9919-36d0ddb79d0e, 'Excellent! très frais, très fruité, ce vin accompagne parfaitement les desserts.', '2004-05-07T02:15:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, aede3579-0871-4457-a578-867576448ef2, 'Très simple et rapide, ce vin est fin et très bon, je ne pensais pas le réussir pour une 1ère fois et en fait il était parfait, tout le monde à aimé.', '2002-08-21T20:23:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11104, f3d2860f-112e-47c5-b829-d1d290e9ecde, 'Long à faire car long à filtrer mais excellent. Tout le monde est impressionné car personne ne connait!', '2002-06-24T19:26:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228915, 51ac5af7-415c-4f29-b946-d7c7855bd0f6, 'Gâteau excellent moelleux avec ce goût fraise Tagada (j''en ai mis 30 pour avoir plus le goût ?) sinon suivi la recette a la lettre et vraiment top. Tous le monde est surpris. Merci ', '2020-03-28T22:21:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228915, 4fda6e38-77d4-48b7-85e6-b9f298eaebdb, 'C''est juste une question de goût mais j''ai pas trop aimé, trop sucré pour moi qui n''aime pas trop les bonbons mais qui voulais faire plaisir à ma fille qui n''en a mangé qu''un seul.', '2016-02-29T23:26:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228915, 70d22a01-844e-422f-ad0f-407d00a2e93d, 'Vraiment trop sucré!', '2015-12-16T14:29:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228915, 47d3d3e7-7671-4677-a466-caf81a61fe6e, 'Super facile à faire, gout subtil de la Fraise Tagada, gâteaux moelleux. Recette à garder, merci !', '2015-01-25T12:32:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228915, e603c3a4-5aaf-41a0-b589-67f3d744e225, 'Excellent !!!  Je ne réussi jamais les gâteaux individuels et là c''était parfait !! Merci beaucoup pour cette recette ', '2015-01-08T19:41:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228915, 4e39e082-f75d-4687-8ab5-190b8cb2d202, 'Super mega bon hiii ', '2014-06-19T00:02:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228915, 67749e15-d06d-42d1-b1ff-ac8e27d8f58b, 'Très bonne recette, les gâteaux sont très parfumés. Très facile à faire.', '2013-12-28T12:19:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228915, 0c1d24b7-54d7-44e4-a326-05041abeb57b, 'Tout simplement excellentissime ! J''ai suivi la recette à la lettre. Je n''ai jamais mangé de muffins aussi moelleux ! Et le goût de la fraise est là, ni plus ni moins il y a juste ce qu''il faut.  Merci !', '2013-12-19T22:15:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228915, afb026be-63f3-48d4-8a7f-2f5e3f26ca71, 'Très bonne recette. Les gâteaux sont vraiment moelleux. Par contre je m''attendais à un goût de bonbons plus prononcé.', '2013-07-15T10:56:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228915, b8e83105-edfa-4705-a571-f1b956c99bb6, 'Délicieux ! On s''est tous régalés. J''ai juste ajouté une cuillère à café de levure. La prochaine fois, j''en fais le double, car là, il n''y avait "que" 15 mini-muffins. A refaire, miam.', '2013-02-18T22:42:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228915, 6617597e-c6bb-4a2c-a2fb-896269ab4746, 'Bonne recette, je mettrai un peu plus de fraises tagada la prochaine fois pour un peu plus de goût. Le beurre demi-sel ne se sent pas du tout. ', '2013-02-09T21:58:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228915, 4e99888e-902f-47eb-b944-8b9b9aca85ca, 'Très bon dessert. Je pensais qu''ils allaient être secs mais non. J''ai vraiment aimé et mon fils aussi. Je le recommande.', '2013-02-01T18:06:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228915, 05133b68-0e0e-4e04-902b-226f1d3ff0bc, 'Muffins très originaux. La pâte est très légère et fond dans la bouche. C''est très bon. Je pensais que le goût de la fraise tagada serait plus fort. C''est discret et très fin. A refaire. ', '2013-01-05T16:53:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228915, 2c5d7c81-d268-43ea-9f11-c4a89e98e82e, 'Très bonne recette ! Le goût des fraises tagada est bien là ! Facile à réaliser et très bon !', '2013-01-02T17:39:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, b7659a60-3be6-4c27-9e6a-82b5f62cc62f, 'J‘ai remplacé les poires par de l’ananas et mis un peu moins de sucre et j’ai également utilisé une pâte feuilletée du commerce. Les pommes et l’ananas se marient très bien ensemble. Délicieux !', '2023-03-04T21:42:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 4a1c4d1d-893a-466c-99c5-d38c43b720c4, 'Excellent avec 4 pommes et 4 poires de taille moyenne. Rien à modifier !', '2020-12-21T14:58:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, b34bf448-ce96-4e62-ac39-04cd43dc0041, 'Délicieuse tarte... Je n''ai pas pu la démouler alors je l''ai décorée et servie pâte sur le dessus. J''ai mis 1/4 de cc de rhum dans les fruits cuits. Trop bon. Servir tiède avec une glace à la vanille bourbon.', '2020-08-25T00:35:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, f13232d2-db57-4e41-8980-125996c59d6b, 'Excellent dessert, les fruits sont caramélisés à souhait. Pour bien les enrober, on peut les arroser avec le caramel tout au long de la cuisson. Par contre, comme cela a déjà été relevé, la pâte s''effrite dès qu''on commence à l''étaler, et quand on veut la transporter sur le moule, c''est un carnage ! Et on finit de la massacrer en la découpant, une fois démoulée. Peut-être qu''une pâte sablée (mêmes ingrédients avec 2 jaunes d''oeufs en plus) règlerait le problème ?', '2012-11-29T15:54:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, ea75cc18-fae5-42fe-8e8d-6a2e05c06688, 'Pas mal du tout même avec une pâte feuilletée achetée... J''ai mis 80g de sucre pour 4 pommes, pour moi ca suffit en sucre mais 5 pommes auraient été mieux.', '2010-04-16T10:32:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, e00c93ae-a322-46d9-b29c-4a04572cbd6b, 'simple, rapide et bon', '2022-03-20T10:30:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 31840dcf-e9dc-47b8-aa89-0ea3b48fa773, 'Recette au top! Trop trop bon', '2022-02-15T23:18:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 128e8b5f-3a6c-4157-a276-234474291c8e, 'Superbe recette ❤️', '2021-12-17T00:56:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 47cfcc7a-fd1c-4734-995f-6d2db2750d68, 'Excellent ! On s’est régalé !(même sans cannelle!)', '2020-10-26T12:40:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 4938673c-0832-4a3f-b697-bb56846e1d87, 'Tout le monde a adoré !!!!! Avec une pâte brisée maison à laquelle j’avais mis une cuillère à café de poudre d''amande. Fait avec pommes et poires, mais j’ai dû en re-éplucher, à la cuisson à la poêle avec le caramel ça avait beaucoup réduit. A faire et refaire.', '2018-10-24T10:42:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 65ddd387-b5b6-4eb4-a553-543b27008918, 'Super bon, j''appréhendais de mettre du vinaigre dans la préparation mais au final ça ne se sent pas. J''ai mis beaucoup moins de sucre que pévu, juste saupoudré les fruits. Je n''ai pas non plus rajouté d''eau car les fruits en rendait deja beaucoup. J''ai utilisé une pâte sablée, ma préférée de loin pour les tartes !', '2017-11-14T23:09:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, a48eaa65-b11e-487e-a0e3-d03eb5d89788, 'Juste deux mots !! Miam miam', '2017-02-13T21:56:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 9455e8be-ac5c-49ce-8c32-67b4310253a4, 'Excellente, je la recommande !', '2016-12-11T14:07:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 4dd8e464-19ec-44c1-8b07-12f2122c909c, 'Délicieux, une cuillère de cannelle suffit.', '2016-08-07T17:57:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, a64a5c0d-b343-4f5c-a1ea-af1aace66661, 'Pas besoin d''ajouter du vinaigre, pas de cannelle non plus (tout le monde n''aime pas), duo pommes/poires délicieux. Effectivement pâte assez dure à étaler mais qui ravit tous ceux qui goûtent à cette tarte.', '2016-04-11T21:34:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, b180e719-bc91-4437-a45c-2cc6fc45e587, 'Fait avec uniquement des pommes, j''en ai mis 6, une ou deux de plus n''auraient pas été de trop. Je l''ai faite avec une pâte feuilletée toute faite, c''était parfait ! Vraiment très bon, caramélisé comme il faut.', '2015-07-25T20:11:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 9be2f265-fd49-4313-a993-1511a1e6f45d, 'La meilleure tarte tatin que je n''ai jamais mangé ! Je ne mets pas de vinaigre et c''est tout aussi bon, la pâte est assez dure à étaler mais elle est vraiment excellente alors on lui pardonnera! ', '2015-01-24T11:15:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, ffe6be4b-6d27-4fa0-92a6-956fcc50ba78, 'Excellent rapport temps/résultat  (surtout avec une pâte prête à l''emploi !) Prévoir 6 fruits (gros) pour un plateau à tarte classique.', '2014-10-31T14:21:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, f7fd1f2b-fa55-42a4-9265-b244c6d26693, 'Recette délicieuse, pour la pâte j''ai utilisé une pâte feuilletée non maison, et avant de mettre la tarte dans le four j''ai fait un petit trou au centre pour éviter que la pâte ne gonfle.', '2014-09-06T19:48:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, b603a13d-a9b2-415c-a8a6-cba81d1ea3e7, 'Exquis ! Tout le monde s''est régalé ! ', '2014-06-08T03:15:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, d80985b5-0a3d-4275-8456-1d7315acaccc, 'Exquis ! Tout le monde s''est régalé ! ', '2014-06-08T03:15:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 0bc848f1-1b67-4a46-beea-f063a7fa4ac8, 'Recette faite ce midi : j''ai utilisé une pâte feuilletée déjà prête. Dans ma préparation pommes/poires à la place de la cannelle j''ai mis du piment d''Espelette. Je n ai pas mis de vinaigre et j''ai servi la tarte avec 1 boule de glace à la framboise.  ', '2014-04-22T15:13:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 116b3498-d715-455d-93bc-b2bc08a72945, 'Je fais la recette avec des poires seulement. Les poires ont jeté beaucoup d''eau et il y avait un peu trop de sucre (j''ai mis la quantité indiquée dans la recette) mais c''était très bon ! La prochaine fois, je mettrai moins de sucre, la moitié.', '2013-12-01T11:35:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 9d06d9db-6f66-4dda-a62e-85a9144873d0, 'Un délice ! J''ai pris une pâte toute prête. A servir tiède avec une boule de glace vanille. Tout le monde a adoré ! Rien à changer à la recette ! ', '2013-10-27T10:59:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, db7c73eb-e481-4ac0-baf7-2c826e6556e6, 'Excellent ! J''utilise environ 5 fruits et je la sers tiède avec de la glace à la vanille. ', '2013-10-08T12:51:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, f579ba18-84b3-4149-b20d-84e95d56a5fb, 'Bonne recette. Effectivement la pâte est un peu friable mais j''ai rectifié les proportions au deuxième essai et plus de problème : 100g de beurre, 80g de sucre et 6-7 cuillères à soupe d''eau.', '2013-03-09T10:08:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 207ba4f0-dcc8-442a-afcf-c690be8e4c4e, 'Très bonne recette. Maintenant je ne fais que celle-ci mais sans les poires. Avec une bonne crème fraîche, un régal !!!', '2013-02-22T14:53:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, dafb0d7e-9764-420c-a7be-f0ef606f0b43, 'Une catastrophe pour la pâte, elle s’effrite je suis donc repartie sur une pâte brisée. De plus pas de quantité pour les fruits, il a fallu donc que j''en refasse ! Et j''ai aussi fait le caramel à part car il ne prenait pas avec les fruits dans la poêle.', '2012-10-14T19:14:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, a2432b43-64e3-4f0d-9f28-4372a066d30a, 'Excellentissime. Même si la pâte s''émiette un peu, il n''en demeure pas moins que cette recette est un véritable délice. ', '2012-09-27T13:40:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 2d6bdeef-c5ac-4836-832d-23e048f397a4, 'Je pensais que réaliser une tarte tatin était bien plus difficile... ! En réalité un vrai jeu d''enfant et surtout très très bon ! A refaire sans hésitation !', '2012-08-01T18:59:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, c862d45e-e596-4839-9440-80658d851751, 'Un vrai régal, ça m''a rappelé mon enfance.', '2012-07-14T14:38:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, b5f8d151-12ab-494c-accf-a31eb9734288, 'Un véritable délice !!! Je n''ai mis que des pommes, de la cannelle et du sucre que j''avais ramené de l''île Maurice et ma tarte a fait l''unanimité ! A refaire à volonté...', '2012-05-21T19:02:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 4f0a0fca-78ac-48e7-bf28-96ad67f69815, 'Dessert très bon mais pas du tout présentable : la pâte s''émiette, pas assez solide, du coup ça ressemblait plus à un crumble !', '2012-03-09T17:16:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, d18be479-bed5-4c48-b7d4-fae255c0b57d, 'Comme il fallait que je fasse vite, j''ai utilisé la pâte feuilletée toute prête qui m''attendait sagement dans le frigo... J''ai mis les pommes et quelques poires qui trônaient sur le bar (plus de pommes que de poires) et pour le reste j''ai suivi la recette à la lettre ! Ce fut un régal, un succès, une vraie réussite. Merci !', '2012-02-05T20:00:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, a9b146d5-2f10-4bd1-b71e-3a152aae31f8, 'Recette simple et facile, pas chère, super bonne, le top, et en plus on reçoit que des compliments. Merci, des recettes comme on les aime.', '2011-12-11T09:05:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 23ce703b-6763-4392-b2af-60f6f1d174ba, 'Super !!! J''ai apporté quelques modifications (urgence de l''invitation de dernière minute) : avec une pâte feuilletée achetée, pas de poires... et bien, elle n''a pas fait long feu... A refaire !', '2011-10-19T19:05:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, d859483c-b5c1-4a90-8e1d-52d0137427e0, 'Comme le dit la note : excellent !! Merci pour cette recette les enfants en raffolent...', '2011-10-07T16:32:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, ac3dbcdf-20c9-43da-b684-aaf983b8cca7, 'Miam... un vrai régal !!! Simple, rapide, efficace et surtout très bonne. Merci pour le partage de cette recette.', '2011-09-29T12:08:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, f37f0024-915b-4385-9cb5-afbe614e072d, 'Tip top et simple !', '2011-09-08T23:12:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, e2c9df10-0045-41af-9d4a-49b3e8475521, 'Ma première tatin avec cette recette a été une réussite, un régal. Simple, temps de cuisson ok. J''ai mis 6 pommes pour 100 g de sucre. Merci pour cette recette.', '2011-02-27T18:19:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, f2c7dac7-31e4-4292-a9e5-d24d4d8e844c, 'Top !!! Je fais cette recette depuis depuis plus d''un an et cette tarte est excellente !! Très simple de réalisation. Je mets juste un peu moins de sucre car je n''aime pas les desserts trop sucrés. Recette à conserver précieusement !!', '2010-12-24T14:43:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 7aabe9b6-e6df-4be9-869d-8d76a1228912, 'Délicieuse et très facile à faire. Pour le caramel, j''ai remplacé 25 g de sucre par de la cassonade et je n''ai mis que des pommes.', '2010-03-07T21:56:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 36d3cd95-c83a-49ef-a9ca-0b5a68c35953, 'Tout simplement excellente!! Mis à part un peu plus d''eau que prévu dans la pâte (sinon trop friable), j''ai suivi la recette à la lettre et mes invités (et nous aussi!) se sont ré-ga-lés!! Le balsamique, je pense le secret de cette recette, aide au goût du caramel, on a juste eu l''impression d''être au resto...! Un pur délice...', '2010-02-16T14:40:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, ce948c28-c067-49a3-8fd4-c4e9b08d3595, 'Fans de tarte tatin, mais surgelée, nous avons cherché une recette spécialement aux pommes. Force est de constater qu''il y a les pros "pâte brisée" et les pros "pâte feuilletée". Cette recette m''a interpelé car justement le type de pâte n''était pas spécifiée ! Du coup, j''ai réalisé la recette uniquement avec des pommes, et la pâte était tout simplement parfaite ! Un vrai délice en ajoutant un caramel fait maison sur les pommes après cuisson ... A recommander vivement pour faire forte impression à toute occasion !!', '2009-08-23T00:13:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 199c4dfa-ff4e-4cdf-97ac-7d49788e5b19, 'Délicieuse ! J''ai testé la recette avec des pommes uniquement et sans le vinaigre (deux fois). Je préfère réduire la quantité de sucre dans la pâte. Sans hésitation à refaire. Faire la pâte maison apporte beaucoup à la recette.', '2009-08-18T20:00:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 29d81770-1ece-4854-b230-29f2109972b2, 'Délicieux ! J''ai testé cette recette que j''ai proposé à mes parents, mon père qui ne mange jamais de dessert a adoré et la tarte est même pas resté 10minutes sur la table, mais le problème a été pour "retourner" la tarte, la pâte est tombée, les fruits sont resté collé au moule ; mais ça a plu c''est le principal ^^', '2009-06-23T21:26:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 340468fe-6fd2-4046-8e76-b5571788804c, 'Facile et délicieux! J''ai utilisé une pâte feuilletée pur beurre toute faite mais j''essaierai bientôt avec celle de la recette originale.', '2009-05-08T23:13:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, f967d192-5a50-4e3f-a9aa-8c9e5996189d, 'Tout à fait excellent. BRAVO !!!!!!!!!!!', '2008-10-29T19:15:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, 35da3175-639e-45f8-85a7-ed9e78c45cd5, 'La pâte est un peu trop sucrée à mon goût mais hyper simple à réaliser. Le résultat d''ensemble est vraiment excellent. ', '2008-01-19T11:19:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, b5c7faa3-eeaf-4227-9164-738149996ed9, 'Première fois que j''essaye une tarte tatin.. très facile et très bonne! toute ma famille a apprécié ! Merci pour cette recette  ', '2007-09-30T14:48:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50497, e831bd58-393e-4e1b-86d8-29fe57c66810, 'C''est une bonne recette, réalisée avec ma fille de 11 ans, hop dans mon carnet, et celui de ma nénette!', '2007-04-09T12:37:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, ee0a8211-59dd-4c7e-acdf-66ac83091c14, 'Trop de sucre, il faut diviser par 2 la quantité', '2023-04-03T12:33:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 3c8a4818-d681-4677-858a-581796c298f7, 'Très bonne recette. Je n’avais pas de sucre vanillé et de sucre roux. J’ai mis seulement du sucre blanc et n’ai pas mis de cannelle. C’était très bon, merci pour la recette', '2022-06-10T09:50:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 0158d5ae-f318-4813-a43f-bf26500ea96f, 'Très bonne recette ! ', '2023-11-20T11:22:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 7267bda6-c99f-43f1-9cf7-a2ad82c63267, '👍', '2022-09-10T11:58:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 5d99b4ac-b57d-4c4b-931c-a85f540e0000, 'En mettant moitié moins de sucre et sans ajouter de beurre, je trouve la compote encore plus succulente...', '2022-02-14T17:24:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, cde60e91-02db-47f6-99dd-3e34c7e76767, 'Excellente ! Mais sans aucun gramme de sucre, les pommes sont naturellement sucrées !', '2021-11-20T19:51:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 4a4649a3-23a1-4839-a26c-9f2721b0503d, 'Bonne recette,très riche et savoureuse.
Personnellement, j’egoutte mes fruits après l’ébullition et mixe la préparation finale avec un bon ustensile électrique pour une purée lisse et onctueuse...', '2025-09-20T11:25:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 716c459f-69e5-4d5e-a751-66f196f7bee7, 'Très bonne incomparable a celle du supermarché je recommande.', '2023-08-15T16:28:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, e479953d-ed51-4c3b-8bc4-61e676871832, 'C''est très bon mais je trouve que sans sucre ce serait mieux!', '2023-03-11T12:38:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 1ec42bbc-11da-4534-a1b6-135a6443f1dd, 'Miam', '2022-10-19T19:25:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 5b3275b8-30b9-4b2f-ad30-5d7e9b3a3130, 'J''ai ajouté une poire. Excellent !', '2022-09-24T15:42:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 499fd54d-c6b8-47a3-b713-3932574a1936, 'Très bonne recette.', '2022-07-03T17:22:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 77e2f6bd-f383-47e9-8e7f-114d8d16653d, 'Facile à réaliser pour les débutants ! J’ai fait cette recette deux fois : la première compote était DÉLICIEUSE, pour la seconde, j’avais mal épluché les pommes et laissé des morceaux de peau qui n’étaient pas très agréables à croquer. À refaire et à partager avec tous ses proches.', '2022-05-24T21:43:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 144bb072-1bce-4a66-8232-ec7ead286666, 'J’ai ajouté une banane avec délicieux 😋 à refaire ', '2022-05-24T12:39:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 6d034b29-a12e-4465-992f-6ea671f26d1a, 'Facile à faire ! Dommage qu''on n''ait pas le grammage du beurre.', '2022-02-14T13:33:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, c48bf236-f152-4f36-803e-5984b3205d9a, 'Recette top !', '2021-05-18T18:18:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 40b4e063-5b55-4d55-a806-96d1e111f991, 'Même avec un peu moins de sucre, excellent!', '2021-03-26T12:40:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 9a1c74a8-718d-4bfe-b8ac-085e406255f7, 'Très simple et très bon, aussi sans canelle', '2021-01-30T21:03:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 4d3d593f-8142-44c2-b661-00b434aa8e47, 'Super recette ! Je n''avais pas de beurre donc j''ai mis un peu d''huile de tournesol. Parfait ! Et j''ai mis 2 fois moins de sucre.', '2020-11-13T14:10:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, d1696fee-1152-422d-bfde-e67718159ada, 'Simple et trés bonne !', '2020-10-22T22:05:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, c4953c0f-179b-4b94-9ef3-b3bc80ca1224, 'J''ai fait avec du sucre roux, la cannelle et un peu d''extrait de vanille (liquide) pas mis de beurre, je vais en avoir 5 ou 6 pots à confitures.', '2020-03-31T14:31:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 2b09586b-0830-4d25-8766-05b0eb5ea0f1, 'Nickel... J''ai bien sûr ajusté les doses de sucre roux et de cannelle à mon goût. Merci pour ce partage de qualité en tout cas.', '2020-02-16T14:43:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, f0fe162e-91d9-4451-8a35-242ba8616f43, 'Délicieux ! À refaire !', '2016-08-08T16:44:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, fcc7c1bf-c78a-4db8-a33f-5bb26b977f89, 'Une perfection de compote!!!! Formidable.', '2016-03-01T10:39:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 3c34c209-1c07-4651-b01e-db958fb4fa19, 'Un peu trop sucrée, mais cela convient finalement assez bien pour accompagner un plat salé (du poulet rôti pour moi). J''ai diminué légèrement la quantité de cannelle. La texture est extra.', '2015-12-07T10:49:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 50c856bd-35e1-46b5-aaa2-d1f0e93547d3, 'Recette au top, rapide et très bonne ! Une bonne façon d''utiliser les pommes abîmées !', '2015-11-11T14:54:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 5732c1bd-950a-4a87-8097-4a939e7dcffc, 'Excellente recette la juste dose en sucre j''ai adoré ', '2015-11-02T16:56:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 070d8434-9a27-4786-b715-53edc2e1a2e9, 'Recette vraiment top ! Je l''ai réalisée avec des pommes Chanteclerc sans cannelle (on n''en est pas très fan). La compote a une très bonne texture. Je l''ai déclinée en ajoutant des framboises fraîches juste 5 minutes avant la fin de la cuisson et le résultat est bluffant !', '2015-08-25T22:52:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, b3934f00-3236-44ac-b57e-854bbd2fb7e0, 'Top ! Utilisée pour une recette de tarte aux pommes avec grand succès. L''essayer c''est l''adopter !', '2015-01-10T13:19:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 1c96c412-4834-4ad4-b2ff-717850d36e47, 'Très bonne recette. Je l''ai faite pour accompagner un rôti de porc. Excellent. ', '2014-03-15T17:44:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 9470c54c-910f-4cef-b3c4-3ac19bf244d0, 'Très bonne ! Avec la cannelle parfait !', '2013-11-11T01:08:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 861a31c4-46a9-45e6-8e65-98dea6327337, 'Simple, rapide, original et très bon !', '2013-04-17T15:27:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 77bf6f52-1acf-4325-b1fd-f3fdc99b0930, 'Excellente recette et très simple à réaliser. J''envisage aussi de m''en inspirer pour ma future tarte. Merci Marielle.', '2012-11-17T20:02:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 1ae9abab-d5b2-4176-94e8-6ab072561002, 'Recette très simple à faire et très bonne. Je l''ai testée avec des pommes Canada grises.', '2012-11-08T15:53:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 7ad9636f-fe5c-48e5-bd70-07112e7dee10, 'Trop bon !', '2012-10-19T19:40:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 95a3ec1b-5a68-4d44-8810-776fe90f8235, 'Je cherchais une recette de compote de pommes à intégrer dans une tarte et je suis ravie. Je me sert donc de cette délicieuse compote pour faire une tarte : pâte feuilletée (ou brisée suivant les envies) et cette compote de pommes que je recouvre de frangipane.', '2012-07-21T16:00:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, fb4771cd-a693-4690-a7a4-1f36afb0b8b3, 'Recette très bonne et qui a le mérite d''être rapide. Le plus long reste encore l''épluchage des pommes ! J''ai juste remplacé le sucre vanillé par une gousse de vanille bourbon et le sucre roux par du blanc (je n''avais pas de sucre de canne).', '2012-02-22T16:12:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 3cd5780d-696c-4e04-ac5a-c5e794346107, 'Avec du beurre salé c''est aussi délicieux !', '2012-01-14T14:01:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 3563276a-992e-4a87-b124-6b0e62f506d0, 'Très bonne recette. J''ai tout de fois trouvé que c''est un brin trop sucré. Je n''ai pas non plus mis le beurre. A refaire.', '2011-11-01T14:43:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 19387adb-ad26-403c-be37-bd333d06fd3b, 'Excellente telle quelle mais j''essaierai la variante avec la confiture de fraise', '2011-10-12T00:36:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, b087b804-a2fd-47ba-b056-0d5fc8eccf76, 'Je l''ai fait en ajoutant de la confiture de fraise à la place du sucre. Un régal.', '2011-08-15T17:14:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 91a249de-8545-4e33-a052-2cba39e5e83d, 'Je l''ai faite en remplaçant le sucre par de la confiture de fraise. C''est super bon !', '2011-08-15T17:11:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 63f06f0f-1964-4505-b96c-4627ad967291, 'Simple, rapide et délicieux ! Merci pour cette recette que j''utilise également pour mes fonds de tarte aux pommes avec un peu de confiture de fraises. Un régal !', '2011-06-08T13:46:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, f820c679-0a7e-407e-a863-b8bdf9545ed5, 'J''ai utilisé du sucre blanc + sucre vanillé, j''ai mis très peu de cannelle et pas de beurre : très bon.', '2011-01-10T21:14:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 331f2f12-66fd-44f4-b3a2-c12be706408a, 'Très simple et très bon !!! Rien à ajouter', '2010-12-06T16:07:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 1a38c7cf-e643-40af-be61-799263809242, 'N''ayant pas les différents sucres, je n''ai mis que du sucre blanc.', '2010-11-01T15:47:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, dda967b4-300d-4fe2-89da-14f1ec1ff7e2, 'Excellent et très facile à faire ! Tout le monde a adoré même sans morceau de beurre.', '2010-10-15T13:20:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, f0e85ae3-d7b8-447b-873c-80d387283601, 'Délicieuse et tellement rapide à faire que je n''achèterai plus jamais de compote en boite ! ', '2010-09-13T21:14:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, b1b9115c-0480-4320-a0f1-81dd26a73529, 'Délicieux en dessert tiède avec de la glace à la vanille, à refaire. Merci pour ce dessert simple et si bon et apprécié de toute la famille !', '2010-06-11T21:58:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 62fd0de3-111c-4c91-91f0-042e575c2bcf, 'Très bonne recette, facile à faire ! En dessert, en accompagnement, dans une galette, idéale pour tout ! ', '2010-01-10T21:32:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 7eaaf1e5-839e-4ef6-b208-a13def361fba, 'Super bon. Je l''ai présentée dans une verrine avec une boule de glace et des raisins secs.', '2008-12-28T13:13:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 38eb5b3c-8ab3-4beb-a429-0c4107710ae0, 'Simple, rapide et excellente!', '2008-12-26T21:57:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 5bb5125e-723b-4f00-9d07-27468eed1413, 'Vraiment excellent en accompagnement du boudin noir. Et même sans cannelle la compote reste parfaite!', '2008-10-22T20:03:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 1b99fe3d-5bf6-4d00-9c92-00c9ce21699e, 'Très bonne compote maison et bien parfumée!', '2008-10-15T21:04:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 182c13ec-7293-43a5-97aa-392c3f656da7, 'C''est une véritable merveille ...mon fils et moi-même avons adoré.', '2008-10-09T15:39:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, ff180e63-dc00-4fab-a110-0a74716210f3, 'Cette recette est exactement celle que je cherchais depuis longtemps. Absolument délicieux. ', '2008-08-09T10:32:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, f1ef7663-6a42-4f21-9fb6-4b62bd101c9e, 'Recette très simple, assez rapide et délicieuse! Idéale pour s''improviser un dessert.', '2008-03-26T14:03:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 3c304852-911a-4c58-8e9a-9c3e6b2aed41, 'Délicieuse à manger seule, mais aussi en accompagnement, ou même pour un fond de tarte.', '2007-12-07T18:10:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, a5adf4da-9c42-40a3-a2b5-f73eaa159be1, 'Tout simplement excellent !', '2007-11-09T21:09:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34545, 0677e720-3eb3-4163-95d8-b7f97ef7e310, 'Très bonne tiède avec de la glace à la vanille.', '2007-10-28T13:38:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 3ad820dd-9acc-4d54-bb84-5c296e2665d6, 'Fromage blanc remplacé par 100 g crème fraîche pour plus d''onctuosité et de tenue.', '2016-05-29T18:46:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 22726002-eaaa-4f67-88f4-3c3d8d647fe3, 'C''est frais et léger pour finir un repas un peu trop chargé 😉', '2023-05-14T19:11:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 40d559de-f9da-44cc-9ba9-bec96d161525, 'Respecté la recette. Très frais ! Agréable ! C''est extra, Marmiton !', '2022-05-17T19:27:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 8a4bb5b4-8b95-474d-add6-66c79613f415, 'Un régal !! Dessert léger et goûteux !', '2019-05-24T04:16:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 0b6168c7-ebb9-4143-8905-b61f5f0b1ccb, 'Je l''ai fait la veille pour le lendemain avec du yaourt à la vanille à défaut de fromage blanc. Je n''ai tout simplement pas eu le temps de compter les coupelles terminées qu''il n''y en avait déjà plus au frigo... Idéal quand on a des fraises qui ne présentent plus très bien, vu qu''on en mixe une partie et que l''autre partie est coupée en morceaux; il suffit juste d''en garder quelques-unes, les plus belles, pour décorer sur le dessus. ', '2014-08-25T06:35:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 52eac1d5-61ac-4dc6-9b81-47615d39897f, 'Délicieux, frais et léger ! Le fromage blanc que j''ai utilisé était juste un peu fluide; donc, la mousse fraise était un peu trop coulante. Je conseille donc un fromage blanc égoutté ou du mascarpone. Peut être préparer une ou deux heures avant le repas. Poser simplement le biscuit au moment de servir.', '2012-05-06T20:04:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 5df3ab9a-d5f7-4a87-9ff6-200039465c6c, 'Fait avec des pêches car ce n''est plus la saison des fraises et c''est excellent aussi - je diminue un peu la quantité de fromage blanc ', '2023-10-07T17:21:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, f13f5a85-8ab9-4edd-baed-3dd5eda79048, 'EXCELLENT. Pour 2 j''ai remplacé le fromage blanc par 3 petits suisses et crème liquide (200 g au total) c''était divin.', '2019-04-29T18:24:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 2c9f8ade-acca-4270-ae22-a008ca62f0e4, 'Excellente recette ! J''ai dû ajouter du sucre au fromage blanc car mon fromage était un peu trop acidulé. Très facile à faire, rapide.  Les petits et les grands ont adorés. On se croit déjà en été.', '2014-03-12T09:35:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 731884b7-3e05-4200-86e5-7ca6030be34b, 'Bon mais mérite un peu de craquant. J''ai testé une deuxième fois avec des crêpes dentelles à la place des biscuits à la cuillère et c''était meilleur.', '2013-08-30T09:33:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 367c14ff-c668-4031-9e73-d756525a40fa, 'Tellement facile à faire et si bon. Fait ce matin et dégusté ce midi. Que du régal, à refaire à volonté durant la saison des fraises.', '2013-06-20T15:46:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 9ae363b4-0279-48dc-95d3-541ff8c0d522, 'Cette recette est un vrai délice. J''ai trouvé ça excellent et ma famille aussi. Je vous conseille d''essayer cette recette.', '2013-05-26T15:17:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 05415a51-e917-4d36-8499-fb4e1aaac9d1, 'Top ! Dessert léger, et bon et simple à faire. Mon ami qui fait un régime a adoré, il a même répliqué que c''est le meilleur dessert Marmiton que j''ai fait. À refaire sans hésiter ', '2013-04-28T14:48:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, f0015175-4189-4d98-bbb3-8b6a58994cdf, 'Excellent !!! Mon mari a adoré, merci pour la recette.', '2013-04-09T21:37:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, fc5f1838-8eff-462a-b1f4-97873ac1cce2, 'Délicieux et léger. J''ai remplacé les biscuits à la cuillère que je n''avais pas, par des petits écoliers au chocolat blanc mixés grossièrement. Très bon.   ', '2013-03-30T19:43:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, c0298f90-0364-49a5-abf9-bfcb2eb9e693, 'Rapide, facile et léger comme désert. J''ai utilisé les biscuits bruns et j''ai mis plus de fraises et du sucre et c''est délicieux ! Merci pour la recette.', '2012-07-06T01:32:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, eca6724d-3318-43df-b7a5-01f53541ca21, 'Très bon. Réalisé à plusieurs reprises, je n''ai eu que des compliments. J''ai juste ajouté un peu de vanille en poudre dans le fromage blanc nature, un délice. Merci encore.', '2012-05-09T00:31:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 19088661-2990-47e7-a6bc-db16f7f65156, 'Recette très bonne et très facile à faire. Très léger avec un repas bien copieux.', '2012-04-22T16:48:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 26279ff4-9f2e-4662-84f2-9b105e31884b, 'Excellent dessert, tout le monde a bien aimé', '2012-04-21T22:41:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 97e252f9-ab4b-43db-8952-ad3bbf8fc27e, 'Très bon dessert, léger et simple : je l''ai fait goûter à des amis ils ont tous aimé et ils ont même demandé la recette, merci encore.', '2012-01-11T23:02:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 0d0f5d45-1d4f-4717-bb93-af7227a52cfc, 'Passable. Un peu fade, peut être avec plus de sucre ? Mais globalement, ça fait beaucoup de travail pour au final le même résultat que du fromage blanc aux fraises.', '2011-08-22T20:21:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, cfefbde3-6b32-4353-8f31-996c4f1d0a66, 'Merci pour cette délicieuse recette qui a ravie toute la famille. A refaire dès que possible : simple, frais, un régal !', '2011-08-22T15:36:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 183fdf5c-e87d-4590-a511-9935466d0194, 'Merci gloria, votre recette a fait un tabac pour l''apéro dînatoire que nous avons présenté dans des minis pots de conserve. Avant de servir, nous avons ajouté de la confiture de fraises sur la couche blanche et de la chantilly, 1/2 fraise et 1/2 boudoir sur la dernière couche. ', '2011-05-01T13:40:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, d60f9f4d-e761-40ac-9c45-37c39e5fb67a, 'Excellente idée ! Je n''avais pas de fraises mais des framboises, ni de biscuits à la cuiller mais des palets bretons. Recette esthétique et très bonne !', '2010-08-20T09:11:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 73876e2f-0515-4a3b-be84-60a1ce2b174b, 'Olala j''en avais partout ! J''y ai passé pas mal de temps entre décortiquer les 600 à 700 g de fraises, les mixer, monter les blancs et mettre le tout dans des grands verres. Mais heureusement que mes invités ont apprécié !! Ouf ... Peut-être que la prochaine fois, j''essaierai avec des boudoirs (aux dire de mon chéri).', '2010-04-21T12:09:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 476d7082-8714-4b8c-b4fc-2664db3f0a83, 'Vraiment délicieux!!! j''ai mis des palets bretons et ajouter une couche de framboises et un peu de sucre mais c''était parfait !!! Mes invités ont adorés !! merci !!!', '2009-04-20T00:16:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, ac42801e-b1fc-4650-8f38-56bf6ebd2725, 'Très bon et léger, je changerai juste les biscuits cuillère en sablés ou meringues la prochaine fois.', '2009-02-14T10:49:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 3948c273-31c2-47a6-ac6e-d3561d8fbcd1, 'C''est délicieux, et c''est meilleur encore avec des meringues à la place des biscuits à la cuiller', '2008-06-05T20:29:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 56806334-acd1-4802-bbc3-ca8e3653df22, 'C''est top! Personnelement, j''ai un peu modifié la recette. J''ai ajouté un lait de coco, et j''ai fait mes trifles aux pêches (fruits du moment). J''ai aussi ajouté des amandes éffilées sur le dessus du trifle. Et mes hôtes se sont régalés ! Merci !', '2007-07-22T22:02:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, b60868b2-9a8a-41c7-a1a9-1329ffa54a76, 'Succulent! Et tellement joli! Merci beaucoup pour cette recette que je vais garder précieusement. J''ai adoré la mousse rose parfumée à la fraise (j''avais mis un peu plus de fraises pour plus de goût). Précipitez-vous pour réaliser cette recette, vous ne le regretterez pas!', '2007-06-03T23:23:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, e4a0fc1c-cd51-414d-97aa-51c1c3c5c6bb, 'Délicieux ! Très frais et leger à la fois! Merci Gloria !!', '2007-05-08T22:41:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, b2d2e689-ad10-406d-a3ec-187eb0941da2, 'Dessert très beau et bon! Réalisé avc des fraises au sirop et de la mousse de fraises avec un peu du sirop. Très bon, mais pas assez sucré. A refaire !', '2006-12-10T17:34:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, bafa2e7a-b959-4164-af3e-7122c773fc6a, 'J''ai suivi les conseils et sucré un peu plus (4 cuillères au lieu de 3). J''ai mis un peu plus de fraises aussi. Présenté dans des verres hauts c''est très joli et classe, tout le monde a aimé. Je garde la recette de côté ! Et j''essaierai avec d''autres fruits.', '2006-07-22T00:15:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 771f4dfe-3ff2-4a45-b686-bb9b8d2bfb09, 'Excellent. En doublant les quantités, j''ai fait 8 verres de 250 ml remplis à ras bord. Contrairement à ce qui a été écrit plusieurs fois, je trouve la quantité de sucre indiquée parfaite (avec plus de sucre, le goût de la fraise ressortirait moins). Merci Gloria!', '2006-07-18T13:39:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, f1f0f7a5-2a00-4763-8951-023010310a2f, 'Dessert léger et délicieux! J''ai remplacé les biscuits à la cuiller par des sablés nantais et j''ai fait le montage au dernier moment pour que les biscuits restent croquants. ', '2006-05-22T11:44:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 1ec11535-4184-4df1-8d1b-b0eb839fa724, 'Excellente mousse très légère et idéale pour l''été. J''ai mis 2 feuilles de gélatine fondues dans du kirsch (une cuillère à soupe) dans mon fromage blanc. Et j''ai remplacé le biscuit à la cuillère par un palet breton. Pour rendre ce dessert très light, on peut mettre du fromage à 0% et de l''édulcorant à la place du sucre.', '2006-05-21T14:10:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, bd7e4fce-dd65-414b-80b9-9a737818deb2, 'Très bon au goût ! Dommage que ça ne se tienne pas plus (la partie mousse de fraises mixées est un peu liquide).', '2016-05-22T15:50:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 37575aa9-60ad-4d91-8de9-fbc6a9ffb7bc, 'J''ai mis un peu plus de fraise et j''ai remplacé les biscuits cuillères par des speculoos. Le dessert était bon mais j''ai eu de l''eau au fond ! dommage', '2015-06-27T00:01:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, d18c8901-7fff-4010-9c74-360ee3e99683, 'Excellent et simple à faire.', '2014-06-03T20:00:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, c0ad5501-fc82-4252-ab25-4a94d1fc3b0a, 'Très agréable mais pas assez consistant, très liquide', '2014-05-30T17:04:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 0155ae20-80b3-4c20-b81e-19b71c6d2739, 'Dessert léger mais pas très agréable en bouche. Peut-être serait-il intéressant de passer les fraises mixées au "chinois" afin d''éliminer les akènes (grains) dont elles sont pourvues ! ', '2014-03-16T13:06:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 804fb653-08b5-42de-9fd8-dbb30baad627, 'Très bon mais j''ai eu de l''eau au fond de mes coupelles !!! A refaire quand même.', '2014-01-06T23:36:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 10527058-dfad-481e-8b7a-c36580c70d74, 'Très frais, sympa.', '2013-08-13T14:46:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 8e598314-7c19-406e-8f43-30e754c4282a, 'Dessert excellent ! Je le referai volontiers !', '2013-06-14T19:38:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, a973dd72-b8df-4ec1-b831-affc3e0e7cf5, 'J''ai suivi scrupuleusement la recette et c''est fade, de l''eau au fond de la coupelle. Vraiment très déçue, surtout que les avis étaient très élogieux. ', '2013-06-09T21:57:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 56fa2781-3293-403a-b0a5-59b35c42a2d8, 'Une vraie tuerie que je varie selon les saisons avec d''autres fruits, cerises, ananas....etc que du bonheur !!!', '2013-04-26T19:32:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 02416cbc-6bb7-4933-82b5-9f20e8a217de, 'J''avais beaucoup trop de mousse par rapport aux fraises. Et j''ai du rater un truc car ma mousse aux fraises est retombée. C''était bof bof.', '2013-04-21T20:07:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, d30fe2dd-55b9-4911-8c01-4d1873fd9d4f, 'Extra ! simple et rapide !', '2013-03-28T15:48:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, ce22dbd3-05d6-4c70-b134-b315c035a221, 'Quel délice ! C''est un dessert léger qui permet de de terminer un repas de façon très agréable.', '2012-07-20T23:53:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 31637ce4-0ca0-4df6-b5b9-74453a634cf6, 'vraiment délicieux ! léger et très goûteux à la fois, ça a énormément plu et il n''est rien resté ! merci pour cette magnifique recette.', '2012-06-30T17:55:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 233d3793-eb2d-4838-bb2d-c3abf132a6d5, 'Très léger comme dessert...j''ai mis plus de fraises.', '2012-05-21T20:49:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 53ba768a-3a2b-4fcb-8d12-c04cceb89744, 'Bon dessert. Rien d’exceptionnel (cela reste du fromage blanc amélioré) mais effectivement après un repas bien copieux, il est très léger et passe bien. Présentation très sympa qui a fait son effet.', '2012-05-14T00:27:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, beaa0f76-e2ae-4ae6-979f-bd9066d8c2a9, 'Excellent - simple - rapide - je l''ai faite avec des framboises. Merci pour cette recette.', '2011-08-19T19:58:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, e6f8fb00-3175-45b9-a7bb-e1edf2e291de, 'Délicieux, j''ai ajouté quelques framboises et mis du fromage blanc 3,5 % de matière grasse. ', '2011-08-03T10:53:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 54c6c06c-3f96-4316-af7d-f25c1c62a984, 'Très bon ! Très léger ! ', '2011-07-28T02:13:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, d0adfb8e-537c-4cbd-abfc-5f41cfcf34ed, 'Ce dessert a fait l''unanimité tant auprès des adultes que des jeunes enfants. A refaire sans tarder !', '2011-07-12T20:20:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 8717a36c-d02a-4bb9-bc6a-4e44597b0aea, 'Très bon ! ', '2011-07-01T14:41:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 277bfc53-df54-4f3c-89f8-bbbaaf3afec8, 'Dessert ultra frais et très léger.', '2011-06-16T00:07:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, d1937ac3-2197-4db7-8190-55ebb7475f97, 'Très bonne recette, petits et grands ont aimé. J''ai mixé 250 g de fraises avec le fromage blanc et le sucre et j''ai ajouté 250 g de fraises fraîches coupées dessus. Je n''ai pas mis de biscuits car je n''en avais pas mais ça manquait !', '2011-05-07T19:07:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37813, 25f51977-0e2d-4a08-bac3-3ac25491f571, 'Comme d''autres, il m''a manqué un peu de croustillant. C''est peu sucré, mais je trouve ça parfait car ce n''est pas écœurant. C''est frais et c''est très fondant. très bien. Je retente aujourd''hui avec des sablés émiettés avec les morceaux de fraises.', '2010-07-27T15:59:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, d2ae42d1-94e1-49ac-b7e5-83a17cfe3afa, 'Très bonne recette. Merci', '2021-12-30T12:17:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, ba8b1539-db3d-4c2c-8517-9fa8b1aa8e58, 'Facile et excellent ! Il faut juste bien rouler le biscuit chaud avec le torchon humide et ne plus y toucher jusqu''au refroidissement complet', '2018-12-25T14:22:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, 9cf1368c-e04a-44c4-92e8-8a15a35e1436, 'Ma première bûche. La présentation est parfaite ! Moitié ganache et sirop. C''est très chocolaté !', '2018-12-25T09:48:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, 7775f781-53d0-4f02-b1a7-1f07e09858c0, 'Mouais pas mal', '2015-04-17T17:16:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, 8cdff2d7-5c3a-4425-8daf-fef370a138a8, 'Je n''ai utilisé que la recette du biscuit, très bon ! Moi qui le rate très souvent, ce fut une réussite ! Merci ', '2014-07-21T19:52:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, b22d73b0-4bca-471e-9429-9f610783fe30, 'Excellente recette, faite la veille, décorée le matin pour le soir, très bonne, appréciée par mes invités, merci pour cette recette.', '2014-01-11T13:38:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, c7177ff2-b825-452e-986d-aa2e7837eb98, 'Préparée la veille et ganachée le matin. Excellente et très appréciée par mes invités. Merci pour cette recette', '2014-01-02T18:30:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, d4979a10-d2eb-4273-9daf-8f941a130164, 'Excellente recette, j''ai décoré avec des groseilles et des framboises, ça se mariait très bien avec le chocolat! A refaire rapidement!!', '2013-12-22T09:20:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, ceb47141-146e-43ae-bef6-2081e021460b, 'Première bûche et une grande réussite !!! Réalisée avec 2 rangs de framboises et c''est encore trop peu ! Servie avec un coulis de framboise, c''était super.', '2013-03-06T14:28:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, 0b4875c3-35ca-4f85-8b43-a07952ae438b, 'Un délice !!! Vraiment délicieux !! Par contre il y a beaucoup trop de ganache !!!!! On aurait pu faire une seconde bûche !!!  Je vous la conseille, elle est très légère et ni trop sucrée ni trop chocolatée !! Un régal !!!', '2012-12-23T20:12:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, 74d9d898-2b0a-4794-a6ab-6ae118c5c885, 'Très bonne bûche, tout le monde m''a félicité , c''était ma première !!A refaire', '2009-12-31T18:12:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, bb1cc97f-92d4-451e-8f85-1dc5faee094d, 'A faire la veille impérativement.  J''ai mis 2 rangées de framboises à l''intérieur. J''ai fait une pâte très fine car mon plat était très grand et la quantité de ganache était parfaite. Tout le monde a aimé, une part suffit car c''est quand même assez lourd ! A refaire sans aucun doute. ', '2009-12-21T16:09:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, 61e0091b-292d-4855-8d59-e409e1138b0e, 'C''était la première buche que j''ai réalisée pour le 31 décembre 08. J''avais tellement de ganache en reste que j''ai du en refaire une (en fait je n''ai pas roulée la 2ème). TROP BON.', '2009-07-05T21:20:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, 9d811e0e-d761-407a-8e14-ba63865bd2b0, 'C''était également ma première bûche et elle était délicieuse. Je n''ai juste pas su quoi faire de toutes les framboises et de la ganache au chocolat. Mais mon mari n'' en a pas cru ses yeux. Un grand merci!', '2009-01-06T12:26:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, 10dd8e31-b5c1-47c0-af60-af49d88679a0, 'Totale réussite pour ma première bûche. J''ai juste mis de l''alcool de prune à la place de la framboise parce que je n''en avais pas ! Très bonne recette, à conserver !', '2008-12-29T00:01:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, fc212da6-172a-43e1-8ff9-e87bf02303ce, 'Bûche faite pour le réveillon, un vrai régal ! J''ai eu que des compliments. Je suis ne pas très douée en pâtisserie, mais je l''ai très bien réussit. D''ailleurs j''en ai refait une aujourd''hui, pour mon anniversaire. Merci.', '2008-12-26T21:36:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, 2ddef628-94e4-495a-b61d-8d97bd5adeba, 'Bûche très appétissante mais un peu décevante à la dégustation. J''ai trouvé la pâte un peu dure peut-être est-ce le fait de l''imbiber trop généreusement de sirop, sinon trop de ganache mais bon, c''est toujours agréable d''en rajouter à table, à côté !', '2008-12-25T21:16:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, e57478ef-b647-464e-982b-d28765e5c433, 'Je ne change rien! A part peut-être que j''imbibe la génoise avec une liqueur à la framboise (fait maison) diluée avec un peu d''eau. Pour les enfants, j''en fait une avec des fraises en bonbon. Il en réclame à chaque Noël!', '2008-11-12T23:08:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, 8236c9f6-71fa-439d-a5e3-ae056a222f67, 'La bûche est superbe, mais la première fois, je l''ai trouvée un peu fade et pas assez sucrée. Si c''était à refaire, je rajouterais des framboises et des pistaches dans la ganache (à défaut j''en ai rajouté par dessus!), et pourquoi pas des meringues concassées. La deuxième fois qu''on en a mangé, j''ai rajouté un coulis de framboises, et là, c''était de l''avis de tous délicieux!', '2007-12-25T20:21:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, 3c60774a-673c-44fd-9036-edce8ac8f913, 'Bon, j''avoue que j''étais bien contente d''avoir de l''aide pour rouler le biscuit ! Ah, et j''ai beau être fanatique de chocolat, il restait presque un tiers de la ganache une fois la bûche terminée... mais quel délice ! Vivement Noël prochain !', '2007-03-09T22:31:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, 5bc8afcf-98a9-467f-acd9-0630ade580ff, 'Merci pour cette recette. C''est un délice avec une crème anglaise. Personnellement je n''ai pas mis de beurre dans la garniture la deuxième fois et c''est pas plus mal.', '2007-01-01T22:46:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34199, a8ab0bfd-e92a-4f6a-91f6-d8d7b13238d3, 'C''était moi aussi ma première bûche. Tout le monde a aimé même une amie qui n''aime pas les gâteau en général! Mais j''avoue avoir eu quelques difficultés au moment de rouler la bûche: c''est pas facile de garder les framboises à l''intérieur, mais avec persévérance on y arrive!', '2006-01-17T16:10:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 278e2e52-240c-4df9-98c1-518f19f4d4d7, 'Super avec un fond de compote pomme/banane et 2 cuillères à soupe de Calvados.', '2021-11-01T10:58:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 6337b6ef-ccc1-4bf2-a23e-398dcf05b00f, 'J''ai utilisé une pâte feuilletée et comme je suis diabétique, j''ai remplacé le sucre roux par du sucre pour diabétique !', '2021-11-10T09:31:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 754fc9ee-b07b-4a61-80fb-4f5fe752602d, 'Très bonne recette !!', '2020-08-27T13:50:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 381208cd-94cb-450d-838b-26d1a8e317c8, 'J''ai fait cette recette et j''ai bien aimer. Par contre, j''ai fait quelques modification, j''ai rajouter de la compote de pomme et j''ai mi du sucre en poudre simple (au lieu du sucre roux), mais c''était très bon quand même.', '2018-08-24T19:48:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 6aa48cb7-325c-4076-a0c2-1619cdc139cf, 'Délicieusement bon ! Rien à changer, je voulais essayer de mettre de la compote en fond de tarte, mais c''est tout simplement superflu. J''ai juste adapté la cuisson 15 min à 220°C puis 20 min à 200°C', '2011-03-11T19:10:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 9a4f4dab-9f3b-480b-94cf-2ed7ba661955, 'Super recette, j''ai pris quelques liberté, j''ai coupé les pomme en petit morceau, j''ai rajouté de la compote et j''ai fait un quadrillage sur la tarte ! ', '2023-10-17T17:33:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 57ee8445-19e7-4320-86ba-3665c8085642, 'Super bonne, et facile a faire!', '2023-10-14T19:37:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 1d82d6eb-f386-4b77-97d1-f7384f643e0c, 'Mes enfants ont aimé ! Merci !', '2022-11-03T21:35:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, f8ad59b3-b009-4109-b329-4fbfa02cc3a9, 'J’adore et en plus super simple !', '2021-10-29T12:33:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 082ade18-4515-4ede-8565-b19873cf218c, 'Très bonne recette mais j''enlève la  cannelle', '2020-06-10T17:37:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 09ddbb6e-21fe-44fa-9ffa-058fcae6a8bf, 'Excellente avec un fond de compote de pommes et 2 pommes belchard (douceur) et 2 pink lady (croquantes) coupées en fines lamelles ... un délice', '2019-04-28T09:04:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 85be886a-5752-4c3b-b34f-98f774050832, 'La simplicité. ....juste délicieux !!!! Je valide l''option compote, pomme abricot par exemple.', '2019-02-10T11:58:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, fee23b88-6e45-4afb-be08-828b8455f372, 'Suivi à la lettre. Trop bonnnnnne. 
Avec une base de deux petits pots de compote pomme châtaigne.
Prochaine fois je le ferai avec une base pomme banane.', '2018-11-25T07:08:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 44b1a084-807f-44d3-af8a-38c08608902d, 'Je confirme au top cette tarte, très simple et qui plait beaucoup. Et effectivement de la compote en fond de tarte et 3 pommes suffisent largement !!! ', '2016-03-13T15:44:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 239b65ad-95d0-4066-9e96-5a720107f378, 'Top. On adore!!!', '2015-06-06T21:41:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, fd92e118-3b45-4dce-941a-0fa9546b7840, 'Bonne mais personnellement je préfère avec une migaine où je mélange les sucres de canne et vanillé et saupoudré de cannelle ! bref bonne base tout de même ', '2015-04-05T06:23:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 84dee8c7-1c4a-4d6c-a68b-708a7be0f761, 'Tout simplement délicieux !!! ', '2014-09-22T21:48:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 4ce8d4dd-4d66-4517-8bbd-b8d1982dd09a, 'Simplement parfaite. J''ai eu un succès fou avec', '2013-09-05T19:50:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 96553908-a5c6-452e-b4c5-82936f634701, 'Recette très bonne. Moi j''ai ajouté de la compote de pomme fait maison pour pas que les pommes soient trop sèche. J''ai aussi ajouté des jaunes pour que la tarte soit dorée et peut être que la cuisson dans le four pourrait être plus longue. En tout cas elle est très très bonne et très facile.', '2013-07-25T02:18:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 86592f07-bd4a-4d60-86ca-da32eace86b8, 'Très bon !', '2012-11-03T20:51:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, f59e66a9-27a1-4400-b6d8-7bd5426bea53, 'Très facile à réaliser et délicieuse en plus ! J’adhère !!', '2012-07-25T18:52:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 4a39e27d-ca37-4837-92eb-e3da753f916b, 'Très bien mais surtout très facile !!! Pour plus de goût j''ai ajouté de la compote dans le fond de la tarte avant d''y disposer mes pommes ', '2012-06-07T18:00:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, e30a9543-d7dd-4cd3-91aa-5e340019d075, 'Et bien, j''ai un gros problème ! La tarte fait 5mm d''épaisseur et le bord de pâte + de 3cm... Sinon, le goût est bon !', '2011-11-04T16:47:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 3bc6ea34-36da-475b-8243-996b66d4a99a, 'Très facile à réaliser et surtout très très bon !', '2011-09-25T13:48:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, bd8d8dc0-d391-42ce-b637-9c4d93487270, 'Un vrai bonheur pour les papilles. Simple, rapide et délicieuse. Question de goût, j''ai remplacé la pâte brisée par de la feuilletée et remplacé le sucre roux par de la vergeoise.', '2011-08-23T11:14:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 0f5ac364-9bcc-444a-aa22-62c806ae9906, 'Super recette ! Très simple et rapide, la tarte est délicieuse !', '2011-08-07T19:56:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 0b69035d-6ef5-439d-a7d6-306c898f532f, 'Moi je fais la même mais je râpe en plus une pomme sur ma pâte avant de disposer les lamelles de pommes. C''est facile et meilleur.', '2011-07-05T02:08:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 41230734-2654-49be-8806-eaa8619a6e1c, 'Excellent ! J''ai ajouté quelques quartiers de clémentines.', '2011-04-02T22:17:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, a4129b04-5b73-4918-8c5d-0d70a74be211, 'Super facile et délicieux ! ', '2011-02-06T16:27:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 9645c3c6-848d-4670-a5f0-582244e1842c, 'Délicieuse ! Nous l''avons dévorée. Je l''ai juste laissée 5 min de plus au four. Un vrai régal. Merci !', '2010-12-04T11:31:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, afe726e2-c3a1-413a-936f-2b03a439cc5a, 'Recette terriblement simple, mais efficace !!! Cannelle et pommes font bon ménage. Par contre j''ai du laisser au four plus longtemps qu''indiqué sur la recette. ', '2010-05-08T23:53:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 1a10d009-57c8-4157-aa91-2d33b6446ce8, 'J''ai déposé quelque morceaux de beurre sur la pâte avant déposer les pommes, puis quelques morceaux sur les pommes... Pas très diététique certes, mais tellement bon ! ', '2010-02-27T18:16:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 9ff29f97-6681-4b6a-9ad6-930c47fe7e73, 'Merci beaucoup pour cette recette la prochaine fois je mets un peu moins de sucre mais je pense que cela dépend de la variété de pomme. Autrement aucuns problème. Merci', '2009-11-14T13:49:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 87787c8e-50e8-4146-8cde-5b9dceed79cb, 'Recette simple mais moyenne. Mieux vaut ajouter un fond de compote.', '2009-11-04T22:57:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 7144ac18-d61f-4649-9a19-c9ea11149fa4, 'Bon, mais meilleur avec une pâte feuilletée et une compote sous les pommes. Servir un peu tiède.', '2009-07-18T20:54:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, b350bb86-600c-49ba-96d5-4fdac51a9001, 'Très bon pour les amateurs de cannelle.', '2009-04-19T23:59:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, f167953b-11e0-4bd3-9942-df7356e40a73, 'A la place de la cannelle on peut mettre des épices à pain d''épices. C''est extra.', '2009-02-07T17:00:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, b323d73f-c1ab-441b-aeb5-3b78120354fb, 'Je l''ai faite ce soir, vraiment très bonne, j''ai mis une compte maison à la cannelle, un vraie régal, à refaire avec plaisir entre amis.  ', '2009-01-21T21:02:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 29cc3619-6f7b-40ad-8df8-9a5db2e038e6, 'Je suis entrain de la cuire et ça sent bon à la cuisson. J''en salive déjà !', '2008-12-24T13:54:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 7edf6bbf-3322-4f7c-837a-9be767d7ce34, 'Splendide. Pourquoi se compliquer la vie ? Cette recette est simple et délicieuse. La suivre à la lettre et c''est le succès assuré! ', '2008-12-15T19:49:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 7a02888b-c67d-46b4-9b9f-6ed0a8101717, 'réalisé pour un anniversaire. Dé-li-cieux!!! J''ai ajouté de la compote de pommes sur la pâte avant de mettre les pommes et un sachet de sucre vanillé. Les pommes utilisées sont des "goldens" (3 ou 4 pommes suffisent) A recommencer !!! Très vite !!!', '2008-10-26T15:23:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 20198923-d9e0-4866-8db4-10fb5b528abb, 'Trés bonne tarte, la cannelle donne un super goût, moi je l''ai utilisé en bâton que j''ai mis dans la compote de pommes que j''ai préparé, c''était excellent.', '2008-10-22T20:14:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 737d783d-6423-4d82-a713-ace1bef5915c, 'Recette très simple et rapide je l''ai faite avec une pâte feuilletée, une couche de compote de pommes à la canelle faite maison et de la cassonnade pour finir à la place du sucre. Le beurre est superflu dans ce cas - excellent merci beaucoup!', '2008-10-11T18:36:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 2f90afd2-268d-4dc3-baae-4d6e1d8353e4, 'Tés bien mais pour ceux qui n''aime pas la canelle je mets de la gelée de cidre que je fais fondre au bain marie. J''ajoute que je fais ma gelée moi-même. A faire avec du cidre qui a déja quelques mois de fût je mettrai prochainement ma recette pour les marmitonnes qui le souhaitent', '2008-10-07T12:18:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, f9095ccb-a9e6-461f-a724-a77a930b0e8c, 'Excellente recette, et légère en plus. On peut éviter la noix de beurre et mettre moins de sucre, ça reste divin. Pour la pâte, je vous conseille de faire une pâte brisée avec de la farine semi-complète, T80, ça va très bien avec les pommes et la cannelle. Recette à garder, vraiment.', '2008-09-10T11:14:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 5938c3a2-2572-4b65-9aa5-61ebbee32ec6, 'Très facile à réaliser. J''ai étalé de la compote de pommes sur la pâte, un délice!! Toute la famille s''est régalé.', '2008-06-28T15:59:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 3d6e7864-aec5-4046-a64d-b13dab19c273, 'Vraiment facile à faire et délicieux!!! Merci!', '2008-06-05T15:20:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 27d5133d-843c-46fa-8ed9-8e9bcf3f1536, 'Excellente tarte et facile à préparer. J''ai rajouté des amandes effilées et une boule de glace vanille, délicieux!  ', '2008-02-17T18:49:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 97404826-b1eb-4af4-94a9-7d807de8b905, 'Très bon dessert, cependant je mets une couche de compote de pommes maison au fond de la tarte puis je dispose les pommes, et je ne mets pas le beurre compme sur la recette. Les convives se sont régalés. Merci.', '2008-01-05T13:37:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 4d7f680e-8001-4144-bbee-bc8c864d99d4, 'Super bonne base de recette, par contre je rajoute de la compote de pommes au fond de la tarte et je ne mets pas le beurre! Un délice.', '2007-12-09T14:59:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 4dc5f9af-0af1-4810-a6df-e420ba626c27, 'Tout simplement fabuleux!!! On peut faire cete recette avec une pâte sablée, voir même feuilletée!', '2007-11-23T19:02:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 89cdd3f2-da3a-4570-826d-c1abb5765bf6, 'Facile rapide et en cette saison ou les pommes sont bon marché les tartes aux pommes sont un excellent dessert gourmand. Tiède servie avec un peu de crème fraîche un régal pour les papilles.', '2007-11-03T10:54:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 1a2d64d1-d13c-476b-89a5-7dc3e2e02a64, 'Absolument délicieux.... J''ai mis moi aussi de la compote sous les lamelles de pommes, et vraiment, chaque fois que je fais cette tarte, il n''en reste pas une miette!!! Merci pour cette recette.', '2007-04-29T16:36:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 6362f4b9-62e9-41e1-9aa4-3c91a2a8da64, 'Même mon mari pourrait la faire, c''est dire! Même avec 30 grammes de sucre, elle est délicieuse. Je tapisse également le fond d''un pot de compote de pommes sans sucre.', '2007-04-11T22:18:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 6633e3fe-9270-4513-acb5-e7c3e85b7088, 'Facile et très bonne. ', '2006-11-25T11:33:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, ccf3d052-3969-4717-8801-3512e86f2d8d, 'Excellente! Je l''ai aussi faite avec de la compote de pomme en fond de tarte c''était divin mais l''un comme l''autre se valent.', '2006-11-08T12:56:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 5ca03a2e-91b5-4edf-90fc-b855c7088194, 'J''aime beaucoup cette tarte qui est très facile à faire. A refaire absolument.', '2006-02-27T09:43:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, aba9c5bc-a531-486b-bac1-0e1b8f986075, 'Très bon et facile à faire.', '2006-02-15T11:48:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 647fc4cf-ce45-4ab8-a960-57cbf798f645, 'Comme beaucoup de "marmitonnes", je rajoute une fine couche de compote de pommes sous mes pommes et je diminue le sucre (25g suffisent): un régal! Petit conseil: couper les pommes en lamelles très fines de manière à ce qu''elles soient fondantes. Pour ceux et celles qui n''aiment pas la cannelle (quel sacrilège...), on peut la remplacer par 2 ou 3 cuillérées de confiture d''abricots maison, c''est aussi très bon!', '2005-08-16T20:53:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12044, 8fa4329b-70b8-4b7d-9ca8-eb5fa1d917fc, 'Très bon et il n''y a pas plus facile! A la maison, on utilise une râpe pour des lamelles fines, c''est encore meilleur.', '2005-05-24T13:26:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 3e0a776f-931a-48d4-b039-d45695153ce8, 'Trop bon ', '2023-09-22T17:12:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 9e0bf852-7b3a-4472-a7b3-6e540fe90105, 'La génoise ne gonfle pas même après avoir mis levure et œufs en neige ( conseils sur les commentaires ! ) 
Et framboises sur le gâteau elle se casse quand on la démoule !
Une catastrophe .', '2023-03-14T13:28:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, fd32d57f-7ba6-40b9-900e-e847f249776f, 'Bourratif, colle aux dents. Pourtant j’avais suivi les conseils et pris soin de monter les œufs en neige. Visuel magnifique, mais ne suffit pas. Nous l’avons mangé car j’avais mis beaucoup de framboises. Elles apportaient de la fraîcheur et un peu de légèreté. ', '2021-12-08T09:30:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 94bb841f-23d0-4f3b-b144-7c77086a64ca, 'Très bon gâteau tout le monde a adoré', '2019-09-20T06:59:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, c3551261-ab6c-496c-a001-a654b6ce3c9c, 'Un gâteau délicieux. La prochaine fois je monterai les blancs en neige avant de les incorporer à la préparation, pour un gâteau encore plus léger. Mais il était tout de même délicieux et a eu beaucoup de succès. ', '2018-11-03T11:33:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 1fe6b296-e5dc-46cb-959f-b5f8ce207089, 'Superbe recette pour faire un gâteau décoré pour une occasion spéciale car la base au chocolat s''apparente à une génoise. Et l''idée de la fourrer à la mousse au chocolat et aux framboises ... c''est divin ! Quelques modifications toutefois, j''ai séparé les blancs des jaunes d''oeufs et incorporé les blancs montés en neige en dernier. J''ai doublé les quantités pour un gâteau 12-14 personnes sauf le sucre augmenté seulement de moitié et j''ai bien fait ! Soyez généreux en mousse et framboises ! Un succès total !', '2017-03-06T18:27:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 37c9bfcb-f14f-43bb-bcb9-8cabb91886eb, 'Une tuerie! Même mon conjoint qui n''aime pas les desserts a adoré ! Un demi sachet de levure en plus, un peu plus de cuisson et de la mousse au chocolat maison faite avec 100 g de chocolat et 3 oeufs. J''ai fait un glaçage miroir au chocolat, décoré avec quelques framboises... J''ai déjà des commandes pour les prochains anniversaires!', '2016-09-13T22:29:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 972638ce-2a21-4ace-a9e3-205a1e46360a, 'Fait avec les modifs des derniers commentaires, c''était top !', '2015-09-06T14:17:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, fa157102-cac0-4128-ae60-b6d692c6a4c5, 'Parfait avec le double de framboise & de mousse au chocolat ainsi qu''1/2 sachet de levure. Il a rapidement été dévoré !', '2015-06-15T23:57:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 78701f78-72f1-4d28-9d6e-7581bf87cf0d, 'Un délice ! Je n''ai pas mis de mousse au chocolat mais nappé de coulis de framboises et décoré de framboises sur le dessus et tout autour ;  excellent gâteau d''anniversaire. merci pour cette recette.', '2015-02-23T21:02:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 87da80f2-4592-4b2d-becc-c503628d90a5, 'Choisi comme gâteau d''anniversaire, un gâteau délicieux et qui a bien plu à ma fille et à ses invités. J''ai fait quelques modifications par rapport à la recette proposée : j''ai doublé la quantité de mousse au chocolat et la quantité de framboises, 25 minutes de cuisson au lieu de 35. Pour trancher le gâteau, j''ai utilisé un set de table rigide bien lisse, que j''ai glissé dans le gâteau au fur et à mesure que je coupais, pour pouvoir soulever facilement la moitié du haut.  Vu son succès, j''ai réessayé mais avec des quartiers de clémentine à la place des framboises, c''était très bon aussi.', '2014-10-20T16:14:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 4633077d-9bf6-4fa4-8cae-6df39d006c71, 'Encore meilleur quand la mousse au chocolat est faite maison ! Rajoutez un sachet de levure pour faire monter le gâteau ! Gâteau estival qui régale aussi bien toute la famille que des invités !', '2014-08-06T18:42:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 02dba2ec-329d-401c-af4c-49e99e739936, 'Excellente recette. Nous avons adoré ce gâteau. J''ai ajouté un 1/2 paquet de levure comme suggéré et augmenté la dose de mousse au chocolat. Un vrai régal ! Encore merci. ', '2014-04-03T19:58:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 02d90cd2-7f24-46eb-a424-f0bf8bd6ed20, 'Je l''ai fait aujourd''hui et franchement, ça fait bien son effet ! J''ai juste ajouté un demi sachet de levure pour que le gâteau gonfle un peu pour le couper et c''est tout. Merveilleux.', '2013-05-17T22:23:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 1f351235-8784-465a-9c7a-24a3b2b717b0, 'J''ai adoré, mon copain a adoré aussi ! Facile et rapide à faire. J''ai fait le gâteau au chocolat au lait et la mousse au chocolat noir. C''est meilleur le lendemain, comme toujours.', '2013-05-07T20:18:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, c5896f2b-bf33-4eab-9d49-8a19dc652223, 'Parfait gâteau d''anniversaire ! Les enfants ont adoré !', '2013-05-05T20:51:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 1a67f6f1-dbb6-45e7-8c38-e926866a126c, 'Bon gâteau mais copieux !  C''est plutôt pour 6-8 personnes que pour 4... Ne pas fourrer le gâteau la veille, sinon il s''affaisse dans le réfrigérateur...  Mieux vaut peu avant le repas.', '2013-05-03T21:34:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, cf5dda2e-71d1-4056-b7b3-bee6e2172b24, 'Très très bon ! Un parfait gâteau d''anniversaire !', '2012-12-19T20:06:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, a1a66e39-3818-42b9-aa0d-7dfaf67022c8, 'J''ai suivi la recette et adaptée en fonction des commentaires, 1 1/2 sachet de levure chimique en plus. Le seul point délicat a été le soulèvement du dessus, j''ai utilisé un plateau en carton dont j''ai découpé le bord et l''ai glissé entre les deux parties. Mon dessert a été adoré très léger et beaucoup d''effet. Merci.', '2012-12-05T20:46:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 1bf6f4e5-e09e-4555-b7ca-f1d8e57b0a73, 'Super recette, comme je n''avais pas de temps j''ai mis de la confiture à la fraise à l’intérieure et recouvert le gâteau de crème au beurre au chocolat (mi-noir-mi-lait) un délice ! ', '2012-10-29T22:17:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, b9b5b837-10a7-42e8-aa61-6bbd75121739, 'un régal ! Suivez bien les instructions, c''est un peu long mais quelle satisfaction d''offrir un gâteau maison pour un anniversaire ! ', '2012-10-09T17:00:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, e74c734c-537d-441b-b365-79be693d8f12, 'Trop bon et très classe ! Et quel effet çà fait quand on le met a table ! Ma famille américaine a adoré.', '2012-08-11T16:38:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 677e557b-73bd-4432-bcc4-29f804d76e83, 'C''est un gâteau qui en jette et qui est super facile à faire ! Ne pas hésiter à doubler la quantité de mousse et de framboises. J''ai voulu faire la mousse au chocolat moi-même mais pour plus de tenue, il vaut mieux en acheter de la toute prête. J''ai utilisé un moule carré et j''ai pu faire 6 à 8 part dedans.', '2012-07-21T09:51:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, c9532077-25f5-4d2a-ae6d-b31cc9f6754b, 'Malgré la fragilité du gâteau, cette recette est excellente ! Facile à réaliser, j''ai juste ajouté un sachet de levure en plus. Cela va devenir un de mes basiques.', '2012-05-26T20:23:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 071fe84e-10f5-480b-8400-15e409a63811, 'Super bon mais une catastrophe pour la génoise qui c''est cassée. Heureusement, j''ai eu l''idée de ne pas le démouler et avec la décoration, le gâteau était magnifique. Il faut trouver une solution pour que la génoise ne se fissure pas.', '2011-06-26T20:01:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 7c3c612a-eb77-44cf-97e4-4a4b993c4b3c, 'Vraiment très beau et bon ! J''ai ajouté une ganache chocolat praliné dessus pour masquer quelques trous dans ma génoise qui se cassait pour la couper en deux. Du coup, les framboises fraiches tenaient beaucoup mieux ! Delicious !', '2011-05-22T15:53:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, c02b2e98-1399-40c9-9b50-881362df1cc0, 'Très bon gâteau ! Par contre j''ai eu du mal à déplacer la partie supérieure du gâteau...', '2011-02-18T21:31:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 6cee70ce-53c8-4b36-aef4-8aef03b0e0ae, 'Ravie d''avoir tenté cette recette, ça ressemble à un gâteau compliqué et en fait c''est assez simple à faire et très bon surtout ! Le changement que j''ai fait est d''avoir ajouté un sachet et demi de levure, la génoise est bien montée, environ 4/4,5cm , largement suffisant pour la couper en deux sans trop de difficulté !', '2010-08-27T00:55:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, bb0ce431-0aeb-4408-a2d2-c90c485940fd, 'Super recette ! je l''ai un peu modifié (un peu + de farine + de la levure + du sucre) le gâteau est monté et a bien gonflé ! L''idée du nappage à la mousse au chocolat est épatante !', '2010-01-04T22:22:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 120cab78-478c-455a-8423-9e341a23c847, 'Très bon gâteau. J''ai suivi les conseils des autres lecteurs: j''ai ajouté un sachet de levure, mis uniquement 3 jaunes d''œuf et monté les blancs en neige. J''ai aussi mis un peu plus de mousse de chocolat (très bonne idée, la mousse!) et plus de framboises que dans la recette d''origine. Le résultat était excellent!', '2009-05-01T21:04:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 736f5bde-cb4d-4d48-a1f5-dd6a588afbe8, 'C''était très bon, mais très lourd... j''ai dû louper quelque chose : le gâteau au chocolat était lourd et compact, donc difficile de la couper en 2. Heureusement la framboise permet d''ajouter un peu de légèreté à la recette. Le gâteau a quand même fait sensation.', '2009-03-25T20:56:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, b0c86a3c-db6f-45cf-b418-603a3c54d9d3, 'Hmmm..rien que de penser à nouveau à ce gâteau cuisiné pour l''anniversaire de ma Maman! J''ai fait la mousse choco et elle manquait peut être un peu de froid car a eu tendance à "couler"..mais excellente recette!', '2009-03-05T12:37:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 36913be6-e3a5-4940-b114-9f5691dd0f88, 'J''ai fait ce gâteau sauf qu''au milieu à la place de la mousse et des framboises, j''ai mis une créme patissière! Résultat le gâteau était délicieux! Le gâteau au chocolat était craquant autour et au milieu moelleux comme il faut! Pas de regrets!', '2008-11-10T20:10:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 202cd189-f359-439d-8e8d-08ce1d28e114, 'J''ai été un peu déçu du résultat, compte tenu des élogieux commentaires. J''ai trouvé la génoise trop sèche et les quantités de mousse au chocolat me paraissent bien moindre, ainsi que la quantité de framboises. Cependant, il a quand même été mangé rapidement!', '2008-08-01T13:41:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, a9f9172c-4a14-4c76-a293-184274b9ad12, 'J''ai suivi la recette à la lettre, tout en montant les blancs en neige. J''ai aussi ajouté de la levure qui n''a quand même pas permis à la génoise de monter bien haut. Cependant c''est un gâteau très très beau et très très bon qui a fait un régal dans toute ma famille.', '2008-07-15T17:50:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 792c79c9-f61f-4281-972f-975babb487c6, 'Pour réaliser ce gâteau j''ai tenu compte des conseils précédents, et en plus j''ai rajouté ma petite patte perso : un peu de crème liquide dans la pâte à gâteau pour alléger le tout, et une fois coupé en deux j''ai arrosé le gâteau d''un peu de sirop de sucre léger (8 carrés de sucre + un peu d''eau et de la fleur d''oranger chauffé quelques minutes sur le feu...). J''ai nappé le gâteau du coulis de fruits rouges avant de le décorer avec les framboises (elles tiennent mieux dessus). Et il était très réussi et très moelleux! C''est une recette très facile à réaliser et qui fait beaucoup d''effet...', '2008-03-03T18:17:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 20303518-12ca-44bd-b065-2fe1b9fbafe3, 'Délicieux... mais après plusieurs modifications. Sans cela, le gâteau est bien trop compact, donc trop dur et trop lourd. J''ai donc supprimé un jaune d''oeuf, et battu les blancs en neige avant de les incorporer. J''ai aussi utilisé de la levure. Je n''ai pas roulé les framboises dans le sucre, elles ont ainsi gardé leur goût acidulé. Enfin, j''ai nappé le gâteau de confiture de framboises pour la présentation. J''ai servi ce dessert à l''assiette avec une boule de sorbet framboise, le coulis, et une petite meringue.', '2007-12-26T14:56:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, e0cd57b2-10aa-4af8-a46c-cd4ebd6e3013, 'Délicieux!', '2007-11-19T19:10:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 99cc5d64-1f16-44dc-b0b4-970c5563d8b5, 'Absolument succulent je l''ai fait en gâteaux d''anniversaire pour mon homme qui est litteralement tombé sous le charme le coulis à mon goût est indispensable cette touche acide remonte a merveille le goût du chocolat! bravo sincèrement.', '2007-08-22T12:02:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 76f53864-a76d-477d-91b1-d0b7c4068d3f, 'Je l''ai réalisé avec de la levure et j''ai utilisé 200 g de framboises congelées (dedans et dessus). Succés assuré pour un aprés-midi entre amis. Tout le monde en a repris.', '2007-07-10T22:20:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, aaa339f4-6644-45d5-bc39-0a2b96c4fb37, 'Délicieux!!! Nous avons rajouté de la levure en suivant les précédents commentaires. Comme nous avons trouvé que nos 100g de framboises avaient l''air un peu perdu dans tout ce chocolat nous avons nappé le gâteau de gelée de framboise et recouvert ensuite de copeaux de chocolat. Résultat très beau et excellent!', '2007-06-06T14:09:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 2f1e58a3-29f0-415d-8edb-c47c00632fe6, 'Excellent. J''ai 12 ans et je l''ai fait pour ma maman à la fete des mères. Ca a été un succès!!!!', '2007-06-02T17:01:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 987f61fc-6792-44cc-b2ea-00e2b35d26c2, 'Parfait et vraiment facile à faire. J''ai ajouté une petite cuillère à café rase de levure et il vaut mieux à mon sens mettre un papier aluminium sur la génoise à 20 minutes de cuisson pour qu''elle reste jolie, moelleuse et la découpe se fait absolument sans problème. Décorée de framboises, de petites fleurs fraîches et de quelques rosaces de chantilly, il a fait son petit effet façon pâtissier ! ', '2007-05-20T15:07:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, ce439dfc-1335-43c3-8517-618401c83817, 'Je vous conseille de le tester, le mariage du chocolat et des framboises est un délice.             ', '2007-03-26T23:50:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 1169a19f-d341-4a5b-b22c-9641f3d9b14e, 'Très facile à faire et très bon ! Mais comme d''autres marmitonnautes, j''ai eu du mal à couper le gâteau. Il n''avait pas assez levé. Peut-être que la prochaine fois, j''ajouterai de la levure chimique. Il était friable... Mais une fois nappé de mousse au chocolat et décoré de framboises au sirop, le gâteau a fait son plus bel effet ! Merci ! ', '2007-03-05T13:16:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, b121ffd3-83d1-455d-b99f-057bc54f25cf, 'Je n''ai pas utilisé la recette de ce gâteau au chocolat (mais celle de ma grand-mère..., obligée!), mais je voulais quand même dire que l''idée du fourrage mousse au chocolat et framboises est absolument délicieuse ! Par contre j''ai mis plus de mousse (200g). ', '2007-02-19T11:27:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 52059574-7dd5-4b4b-ba6a-ea9463892375, 'Très bon, ultra simple et ultra rapide...J''ai cependant doublé les doses et j''ai utilisé des framboises surgelées...A faire sans hésiter !', '2006-08-05T18:58:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 4d1d9a57-7b5c-45a8-b690-80be7b7cbdc9, 'Ma fille a choisi ce gâteau pour son anniversaire (fan de framboises et de chocolat la puce) et elle n''a pas été déçue. Excellent mais à réserver aux fins de repas légers.', '2006-07-21T13:11:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, fd1e4da0-1673-4efc-bd69-9ac5b00281b6, 'Très bon mariage du chocolat et des framboises: le mari et les 4 enfants ont adoré! La prochaine fois je servirai avec du coulis (realisé avec des framboises surgelés qui ont égouttées toute la nuit).', '2006-05-16T21:55:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 98656834-f0ed-483d-bfca-bc9399061a60, 'Tout le monde a adoré se gâteau! Il était délicieux. J''ai juste eu un peu de mal à le couper en 2.', '2006-05-06T12:32:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, ee26ba32-cb88-414b-97e8-e130bf933370, 'Une véritable merveille!', '2006-02-23T22:56:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 7ee7b047-6357-4fc5-be74-03d4cdcfb625, 'Excellent. Le mariage des framboises et du chocolat noir est sublime. J''ai fait un glaçage au chocolat noir et j''ai décoré de framboises et de sucre glace, accompagné du coulis c''était vraiment très bon. A refaire...', '2006-01-27T17:00:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 22815059-1b63-4fc3-be37-d8f5d0f65191, 'J''ai fais ce gâteau, il est très bon mais j''ai dû revoir la recette faute de ne pas avoir réussi à couper le gâteau en 2! Je l''ai donc nappé de la mousse et décoré le tout avec les framboises! C''était très bon, je réessaierais en utilisant un moule encore plus petit!', '2005-09-11T00:50:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, c38d6390-0344-4224-8266-2f08a63629ad, 'Absolument merveilleux! Rien à redire! Je l''ai fais avec des framboises surgelées. Parfait !', '2005-09-04T13:55:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 73f1de8a-b64c-4091-9d20-5a1dafd4f1a4, 'J''ai également suivi les indications à la lettre mais malheureusement j''ai touvé la génoise pas assez aérée et même un peu collante. Cependant le goût est très bon.', '2005-09-01T18:43:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 1a8be6be-faaf-4bbc-a4d5-c5e1148f6079, 'C''est un régal ce gâteau ! J''ai suivi les consignes à la lettre (donc pas de blancs en neige)... et le gâteau est très moelleux comme ça et en plus rapide à faire. Ne changez rien à la recette, elle est parfaite!', '2005-07-14T22:42:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 4df847f7-2649-42d3-afa1-ee9df42f4339, 'Très bon dessert, succès garanti ! Suivant les commentaires, j''ai monté en neige la moitié des blancs d''oeufs pour plus de légèreté. Attention à bien utiliser un petit moule, sinon le gâteau est difficile à couper en deux. Ce doit être encore meilleur avec une gelée de framboises ou de groseilles sous le glaçage !', '2005-07-04T13:07:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 0918eac3-51a8-44e4-9f1e-75bfa28cc0ea, 'Délicieux! La fraîcheur des framboises et l''onctuosité du chocolat font de cette recette un véritable succès!', '2005-02-14T02:00:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, e623d243-043e-4bc0-89da-76810327f278, 'Très bon, j''ai fait une vraie mousse au chocolat maison. Par contre, la prochaine fois, je monterai les blancs en neige, je pense que la génoise sera plus légère.', '2004-12-09T21:16:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15419, 13ee6d32-ce1d-46d2-9737-ae5fca483fc7, 'Très très bon! Les framboises donnent un petit goût fruité. Je vais le recommencer pour le faire découvrir à des amis! Merci encore...', '2004-03-17T18:26:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, dec3b281-014f-4552-bb74-dba2d986561d, 'Testé avec des myrtilles et des raisins secs et sans noix de coco (donc 180 g de farine), excellent ! Moelleux à souhait ! Par contre, 150 g de beurre suffisent LARGEMENT !', '2013-04-06T15:46:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, 52cc0f5e-088f-47a3-87ba-a4608a9b3b94, 'Très bonne recette que j''ai faite avec des fruits rouges surgelés. Très moelleux, parfait en fin de repas! J''ai juste dû ajouter un peu de cuisson.', '2011-03-27T12:17:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, d817b3e3-2791-4648-8a96-2553a5307ea9, 'Bon et original gâteau. Merci !', '2009-05-25T02:13:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, e1f720b6-dc98-46e1-a942-e668f045c955, 'On a tous adoré! J''ai ajouté le glaçage noix de coco  de Mamie gâteau, et même les réfractaires de la noix de coco ont apprécié.', '2009-02-09T10:20:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, c492d512-4eb5-44c0-bd40-160bd41b3d7a, 'Excellente recette, moelleuse à souhait. Je n''ai mis que 150 g de beurre, c''était très bon comme ça.', '2007-06-25T15:28:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, 782c085f-d7ba-44ae-8172-6fd925e052cc, 'C''était très bon, même si la première fois j''ai testé avec de l''édulcorant pour que mon beau-père diabétique puisse goûter...  à éviter, ou alors il faut doubler ou tripler la dose!  Avec du vrai sucre, ça marche super bien, et tant pis pour les kilos...', '2007-05-29T13:36:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, 3b5f8116-5334-4bd1-b10e-8b4c741b03f8, 'J''ai fait ce gâteau très rapidement en loupant des étapes...mais on l''a quand même dévoré ! En plus d''être délicieuse, cette recette est inratable !', '2007-05-28T12:17:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, 3bfe8dd3-9c46-4c03-a485-0bc91ed4fb67, 'Quelle déception! Pourtant les commentaires m''avaient mis l''eau à la bouche! Les framboises sont restées au fond, le gâteau était tout raplapla. Dommage...', '2007-05-15T17:07:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, 226cbcb9-b20c-41ce-bdf0-79ca27dd34ea, 'Merci pour cette excellente recette. Succès garanti.', '2007-04-25T23:57:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, 063a5ef5-571a-4387-aeb5-b942eaa87115, 'Les invités ont adoré. Pour ma part, les framboises sont restées au-dessus du gâteau. La prochaine fois, j''en mettrai une couche au milieu pour le côté esthétique.', '2006-10-10T12:51:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, 3fd6f2ec-8625-439f-88f5-6055e06b04df, 'Original et goûteux. La noix de coco et la framboise vont très bien ensemble, c''est délicieux. Merci pour cette recette!', '2006-08-19T14:09:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, cb980b5c-c6dd-4d0c-aed0-4a2cab7e51df, 'Merci pour ce très bon gâteau. J''ai utilisé des framboises du jardin congelées. Par contre je ne mets que 100 g de beurre dans tous mes gâteaux, c''est aussi bon! Peut-être que je mettrai un peu plus de coco râpée la prochaine fois. A refaire sans hésiter !', '2006-07-08T22:22:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, a5abc87f-c081-4435-94d3-fbaefb7f6fe3, 'Succulent, les deux parfums se marient très bien, le gâteaux est moelleux, très bonne recette, à faire en toute saison avec des framboises congelées...', '2006-04-27T14:44:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, fe0b8472-3fb8-4c67-8761-f96a37aca40f, 'Facile, rapide, pas cher et surtout très bon. Un délice... Attention à ne pas mettre trop de framboise, car ça attache au fond du moule.', '2005-06-16T15:13:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, febda61d-88ce-4112-8028-07895a1521dc, 'Délicieux gâteau, très moelleux. J''ai testé la recette telle qu''elle et il est déjà très goutu (l''acidité des framboise se marie très bien avec la suavité de la noix de coco). J''essaierai par curiosité avec rhum/vanille la prochaine fois.', '2005-04-12T14:26:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, 79dbe707-edb8-45e3-9206-1367696f40c1, 'Bof, bof, réussi mais bof bof, je pense qu''il faut mettre plus de framboises...', '2004-11-24T22:59:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, 07c5e478-696b-4d92-a83b-c9695bc2f17f, 'Délicieux ! Et très facile à faire. Perso j''ai ajouté un peu de vanille et de rhum et la prochaine fois je tente avec le jus d''un citron. ', '2004-11-19T10:46:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, d9ad1e3b-38e7-44e6-a517-dbe08550542e, 'Pas mal du tout ! A essayer ! Rien à ajouter ou alors un peu de vanille et de rhum.', '2004-10-02T01:45:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16618, c4a69dbe-fa40-4496-a12b-566f92ce0977, 'Un vrai délice, ce gâteau! Il est moelleux au centre et croquant sur le dessus. Je n''ai mis que 125g de framboises, je pensais que sinon il y en aurait trop, eh bien je regrette de ne pas en voir mis plus, les 250g ne sont pas de trop je pense. En tout cas, félicitations pour cette délicieuse recette!', '2004-05-29T16:33:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, e53654f0-cb34-4ea5-a833-34ee5592dc9a, 'très bonne recette réalisée 2 fois. néanmoins je double les doses (500g de mascarpone et fraises pour avoir 4 à 6 belles verrines). j''ajoute un yaourt nature pour travailler la pâte facilement et je ne mets que le jus d''un demi citron. je ne mets que les 2/3 du sucre et goûte au fur et à mesure pour que ce dessert reste rafraîchissant. Et comme les autres commentaires, je prépare le mascarpone dans un bol à part et ne monte mes verrines qu''avant de les servir.', '2012-05-01T11:52:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, ba2c2d80-636e-41bd-8dc9-7a1e5e62d8b9, 'Un dessert original, très sympa. Mais très déçue, les spéculoos ont ramolli, ce qui a enlevé tout le charme à cette recette qui pourtant me donne énormément envie...', '2010-06-20T18:05:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, bdf532b0-f2b6-4065-a816-efebe3fc66f2, 'Très bonne recette, mais pour avoir plus d''onctuosité, je rajoute à mon mascarpone du fromage blanc.', '2010-04-14T19:54:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 30c6d53f-7bbc-4e9f-aa93-d794ed328217, 'Nous nous sommes régalés.  J''ai décoré avec un peu de chantilly et des framboises ', '2023-06-17T20:44:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 92b0ba26-3d18-4beb-b6dd-a41eac4bc1c7, 'Très beau et bon et facile à faire ! Mes convives ont été épatés ! J''ai allongé le mascarpone avec un peu de lait.', '2014-05-19T13:26:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 9b34f838-7489-4dc3-ab88-9db440eab25c, 'Bon et frais... mais pas un dessert à tomber. J''ai été un peu déçue : les spéculoos avaient perdus leur croquant et la préparation si elle n''est pas assez fraîche est un peu écœurante à mon gout. Cependant, cela a plu à mes invités.', '2013-06-11T18:09:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 53c47f92-d8d5-4507-9ce5-c4700dc72d9c, 'Dessert très frais et léger après un repas un peu copieux ! ! ! Ai ajouté quelques framboises.', '2013-05-06T01:58:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 1fd37698-a559-4ff6-bf7a-7db2cfecdd1f, 'J''ai suivi les conseils de patchouly7, c''était très bon. Par contre, je mettrai moins de sucre la prochaine fois. J''ai mis moitié de framboise, moitié de fraises, c''était très bon.', '2012-08-29T12:14:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 886144c7-cadc-4b7d-a42e-d0e2b5aa6991, 'C''est un délice ! Mais pour plus d''onctuosité, je bats 3 jaunes d''oeufs, je mélange avec 80g de sucre (ou moins..) 1 sachet de sucre vanillé, 250g de mascarpone et enfin j''ajoute les 3 blancs montés en neige. La préparation devient très onctueuse et très facile à travailler. Et puis pourquoi pas une petite feuille de menthe posée sur le dessus une fois la verrine prête?', '2012-06-27T15:35:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, f0c6ce46-46fb-4d23-8c65-ac2faa0639a7, 'Délicieuse recette à refaire et à refaire encore. J''ai mis ma préparation au frais avant et le jour J J''ai ajouté mes spéculoos. Les spéculoos sont restés très croquants. Merci', '2012-05-14T20:16:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 9483bf6d-8134-4558-bd8c-5936625fbc58, 'Succulente verrine, fraîche et agréable en goût. En fait, ce sont carrément mes premières verrines dessert. A les regarder, les unes, les autres, j''avais tendance à les trouver toutes "simplistes".  Et celle-ci l''est aussi. Simple, rapide, facile. Si sympathique en bouche.. hé bien que j''ai racheté de la mascarpone pour en refaire, sitôt le lendemain.  ', '2012-05-07T18:29:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 99a279b6-0e0a-42f0-8793-9920ca5a99e8, 'J''adore cette recette légère, les fraises et les spéculoos se marient très bien ', '2010-09-17T22:19:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 693e4862-d24c-4c77-baad-78e3f7cd456f, 'Délicieuse ! Si le mascarpone est trop rigide et déjà suffisament citronnée, j''ajoute un peu d''eau pour qu''elle soit plus maléable. Je n''ai également mis l''équivalent que d''un jus de citron. Merci pour cette recette !', '2010-01-19T10:51:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 95c0bedc-0492-44d9-907f-0e49e48b3c61, 'Très frais et bon j''ai suivi le commentaire d''avant. J''ai juste mis les spéculoos au fond des verrines et mis les fraises dans un bol et le mascarpone mélangée avec le sucre dans un autre bol au frais le temps du repas. J''ai composé mes verrines au dernier moment et mes invités étaient ravis, je refais ce dessert régulièrement. Merci', '2009-11-27T11:04:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 562dca2d-ed03-441f-b1f8-25f62f23d8c5, 'Mes invités ont apprécié mais personnellement j''ai été très déçue; les spéculoos avaient absorbé du jus et étaient tous mous... donc rien de croquant. Assez lourd à mon sens, je n''ai pas terminé.', '2009-08-21T13:37:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, d261e03c-8035-4d59-89c6-40c0c530cdfa, 'Recette très simple et adaptée à une cuisinière de base comme moi ! Excellent et très frais.', '2009-07-27T12:28:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 6d2710af-e8da-403f-9322-ba592de30f22, 'Aussi bon que beau... Mes invités ont adoré; pour ma part, je trouve que le mascarpone est difficile à mettre dans les coupes du fait que c''est trop compact... Mais pour le goût rien à redire ça mérite un 5... Merci pour cette recette.', '2009-07-20T03:25:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, e9ab5cec-b7c0-4515-9a1b-eb08b5ce51e6, 'Super bon et dosage parfait : mes deux petites filles de 13 et 8 ans l''ont tellement aimée que la deuxième fois, ce sont elles "seules " qui ont refait cette recette !', '2009-07-15T15:47:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 62acab2c-2232-4540-84ca-99dd1da88a3b, 'Excellent ! A faire et à refaire sans aucune hésitation !', '2009-07-13T23:53:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 3e02ac6a-815c-487b-b07d-45a56cd8ec62, 'Ai fait macérer mes fraises dans un peu de vinaigre balsamique et remplacé par des palets bretons. Ajouter quelques gouttes de lait au mascarpone pour le rendre un peu moins consistant. C''était vraiment très bon, à refaire.', '2009-07-01T00:41:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, edac8b91-4d33-4a45-a528-47bf759e8a33, 'TRÈS FACILE TRÈS RAPIDE TROP BON!!! Malgré le fait qu''elles aient été préparées la veille au soir, nous avons tous adoré, merci pour cette recette.', '2009-06-30T18:20:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, cd5c0bad-a191-4a1a-b79f-55ff5f0a725b, 'Un vrai délice. Recette très fraiche, idéale pour l''été. Tout le monde a adoré.', '2009-06-29T10:13:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 40442761-a3a8-43c9-af53-6e075dd77f27, 'C''est trés rapide à faire avec une trés jolie présentation. Avec les quantités de la recette j''ai pu faire 20 mini verrines pour un buffet. J''avais  ajouté des groseilles . Tout le monde à apprécié car c''était frais et appetissant.', '2009-06-22T21:04:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, c5e37cad-e2db-4fbf-8907-b37931506382, 'Très déçue par cette recette... le mascarpone est beaucoup trop compact et intravaillable... j''ai dû ajouter 200g de fromage blanc pour obtenir une consistance acceptable ! Du coup, je n''avais pas assez de fraises, je préfère passer un peu plus de temps et faire un bon tiramisu aux fraises !', '2009-06-22T20:45:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 28d10c37-0d24-4043-b297-16432f98aa2e, 'Sympa à faire pour un diner entre amis et très rapide, par contre le jus des 2 citrons était de trop dans le mascarpone ! On était un petit peu écoeurés du citron à la fin du dessert ! (j''avais pourtant pris 500 g de fraises et 250 g de mascarpone. Je le referai volontiers (présente super bien) mais avec 1 seul jus de citron   ', '2009-06-21T23:02:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 5572b3ad-46b0-47fb-bbb3-797a3bbb6421, 'Super dessert. J''ai ajouté au dernier moment dans chaque verrine, en guise de déco, un macaron fraise. Tout le monde a adoré', '2009-06-21T19:25:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, b96c4c71-ff79-4b86-93d2-781869fa4834, 'Je ne connaissais pas le mascarpone (mieux vaut tard que jamais !)... on a adoré le mélange fraises/mascarpone/spéculos. C''est original, frais et léger. Ce dessert clôt en beauté un déjeuner ou un dîner d''été. Petite variante : j''ai complètement mixé les spéculos, j''avais donc un étage sableux. Je recommande vraiment ce dessert léger et frais.', '2009-06-21T13:17:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, ebf4e81c-84fc-40cb-8d51-ea390e73081e, 'un vrai régal à faire et à refaire', '2009-06-16T02:23:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 13a964f3-595e-4875-a3fb-7be18a5f0155, 'Très frais et doux grâce à la crème. Je n''ai mis qu''un jus de citron, c''était très bon. Par contre, je les ai laissé plus de 3h au frais et les spéculoos étaient tout mous...je pense qu''une heure suffit. Merci !', '2009-06-15T18:17:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 9c91dbc5-e5d9-4383-909d-c358e9a931a6, 'les spéculos se transforment en miettes imbibées et la mascarpone durcit trop... déçue ...', '2009-06-15T13:40:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 93de9e76-958f-4954-a818-746c14a81e0a, 'Très bonne recette. Je n''ai pas ajouté de poivre ni de sel et c''était super bon ', '2009-06-14T17:46:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, a976bf2a-9a15-471c-a5ff-5d75a07d11e0, 'Non seulement facile et rapide à faire et en plus délicieux, mes invités ont adoré!', '2009-06-14T13:49:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 6511e902-b525-402f-bac6-46365daace7e, 'Délicieux, tout simplement ! Mes enfants et mon mari on trouvé que je n''avais pas suffisamment amolli le mascarpone. La deuxième fois, j''ai ajouté de la crème fraîche et super super !!! Les verrines étant + grandes que d''habitude, j''ai pu facilement faire 2 couches de tout ! A faire, refaire et abuser le cas échéant !!! Merci à toute l''équipe Marmiton ! Avec Marmiton je ne suis jamais déçue !', '2009-06-13T13:29:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 2a31b6a0-c223-47c1-93ee-1d1863399185, 'A fait un excellent dessert de fête des mères, j''ai ajouté un peu de menthe sur le dessus et un coulis de fraises (fraises mixées avec deux cuillères à soupe de cassonade et un demi jus de citron) et c''était top !', '2009-06-07T21:33:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, d62970dc-45e4-48ff-8e37-917fcd16e4a1, 'Excellent et super simple et rapide. J''ai testé cette recette hier et tout le monde a adoré, en plus c''est du plus bel effet dans de beaux verres, merci', '2009-06-06T19:33:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, 40f368ad-e8eb-453b-b55f-9998c543e7ef, 'Merci pour cette excellente recette si facile à réaliser. Mes invités ont été séduits par la présentation. Il faisait chaud, c''était un dessert de circonstance. Ils l''ont apprécié, car rafraîchissant, savoureux et très fin. Ils ont emporté la recette. Pour la première fois, j''ai préféré ne mettre qu''1 citron et demi, la prochaine fois, je respecterai la recette à la lettre et choisirai par la suite ce qui nous convient le mieux. Cette recette va désormais faire partie de mes classiques.', '2009-06-03T23:49:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72925, ad46aaf3-3723-4f7a-9bda-5c2af4315e4b, 'Très bon, très rafraîchissant et simplissime... J''ai testé la recette hier et je la refais demain pour épater la galerie !', '2009-06-03T09:59:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, 8b967d08-693a-4b4d-9d9e-21666b2d6604, 'C''est une ABSOLUE catastrophe !!! Ça n''a rien d''un sorbet ni d''une glace ! J''étais bien naïf de penser pouvoir faire un sorbet sans sorbetière !!', '2016-10-01T22:03:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, b5712dc6-1349-4d99-b05a-46ced7d6bbea, 'Trop dur ! A sortir du congélateur très tôt et à ne pas recongeler : il faut tout manger !', '2014-08-09T14:51:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, 0143600b-1f5c-43c2-9b4b-510cc8846e59, 'Quelle recette géniale ! Merci beaucoup !  J''ai mis les 2/3 du sucre et ça passait très bien. J''ai même oublié la crème fraîche la dernière fois et c''est quand même très bon.  Mais surtout je la décline à tout, au fil de la saison : pêche de vigne, banane, melon, pastèque, brugnon, etc... Ça marche très bien ! ', '2013-09-04T17:49:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, b9d43687-ee76-427a-ad13-4d8c047ddb55, 'Excellent, je vais vite voir au marché s''il reste des fraises, c''est vraiment trop bon... Après la première congélation d''une nuit, c''était dur, j''ai remixé et servi 3 h après, vraiment délicieux, moelleux et sans poudres chimiques.', '2013-08-20T10:30:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, e470243c-49ca-4006-aa50-77b4b059f57c, 'Sorbet réalisé exactement selon la recette, le résultat est bluffant, même sans sorbetière, la glace ne présente pas de paillettes en ayant gelé. C''est frais et léger mais... trop sucré ! 300 g de sucre auraient surement suffit. Ceux qui n''aiment pas les pépins peuvent passer au chinois avant congélation.', '2013-05-08T20:28:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, 727d6d47-8741-4630-996b-580c5b1163a4, 'Très bonne recette mais un peu trop sucrée à mon goût ! Je rajouterais moins de sucre la prochaine fois, je réessaye demain et vous dirais !', '2010-07-12T18:53:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, 7e5aac7b-8a44-4ae1-aeba-76395fbd43c1, 'Très bon dessert, frais et léger. J''avais peur que le sucre soit excessif mais pas du tout, toute la famille a adoré.', '2008-07-18T16:57:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, dd3bb9f4-ba43-47f4-a7dd-52b84208eabb, 'Super bon mon mari en raffole et serait prêt à tout manger en une fois ! top', '2021-06-18T12:13:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, 97201772-4066-451c-9dcb-ca42398a2694, 'Facile à faire, je fais des portions individuelles, tout le monde adore !!!', '2019-05-02T14:58:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, 98632195-96fa-4d51-b34b-0f874f3938a0, 'QUESTION : combien de temps au congélateur avant dégustation ???  Merci à vous.', '2014-06-02T22:58:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, e0fb7ad3-bced-405c-a4f8-fc9c0c8316da, 'Avec de la creme c''est de la glace... Le sorbet se fait exclusivement à l''eau... mais c''est une très bonne recette... Bravo !!!', '2014-06-02T22:48:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, 5ba17736-c8d9-4d63-be37-617f4e63a64c, 'Excellent résultat pour une recette on ne peut plus simple. Je divise le sucre par 2 et ça suffit. Je l''ai également réalisée avec des fraises des bois, c''est très parfumé. Le prochain test ce sera 1/2 fraises + 1/2 fraises des bois, car la cueillette de ces dernières est très longue !', '2013-07-02T12:45:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, 12c66001-d9a0-4147-b381-24111f7a8db4, 'Délicieux. J''ai respecté les doses et mes invités et moi avons adoré.', '2012-01-10T19:01:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, 813defd7-7cbd-41b7-9d9e-98b46f11a613, 'Excellent, j''ai mis 125 g de sucre pour 600 g de fraises !', '2010-04-25T19:20:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, ac36106c-6c55-40dc-9d0c-90be4c0f4a26, 'Très bonne recette de sorbet à la fraise ressemblant aux batonnets de sorbet à la fraise dégustés dans mon enfance. Par contre un peu trop sucré à mon goût, 200 ou 300 gr de sucre devraient suffire à mon avis amplement.', '2009-06-22T23:49:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, 4ab3f136-7ff9-4d6a-a0e9-30530550d79d, 'Merci pour la recette  c''était excellent tout le monde a adoré je l''ai fait avec des fraises du jardin seule moi je l''ai trouvé trop sucrée mes invités ont adoré', '2009-06-17T10:11:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72617, d6ae1488-a948-4569-80e8-593571730278, 'Génial !!! On s''est régalé mais par contre avec 400 g de sucre c''était trop sucré donc je n''imagine pas avec 600 !!! Si les fraises sont déjà bien mures et sucrées, je pense que 200G suffisent amplement! En tout cas, merci pour cette recette pratique sans sorbetière!', '2009-05-05T19:23:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, ca2d1c3f-6811-4c29-b306-e0b34ea8cfbb, 'Bon goût mais la prochaine fois je ferai le montage à la dernière minute mes cercles de brick étaient tout ramollis au moment de servir ce fut un désastre et ne pas les tailler trop gros car sinon c''est compliqué à déguster.', '2014-03-19T23:42:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 6ee3d98b-a566-4dad-896d-7f2d90a97570, 'Je fais cette recette depuis des années et toujours autant de succès. Par contre je fais des individuels ', '2020-07-08T18:33:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 208c1231-d614-4408-b7ff-3c71d51e1888, 'Une pure merveille ! Merci pour cette recette qui fait le plaisir des gourmands.', '2013-10-27T18:30:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 06c20dc3-68d5-4e13-9aeb-e895c12bdd74, 'Merci Jeanne ! Encore une très bonne recette. Par manque de temps je n''ai pas fait chauffer ma crème comme un sabayon, et c''était très bon quand même. Un beau et bon dessert !', '2013-08-05T20:46:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 8327fcb6-f960-4508-943d-5a29a6939d1d, 'Excellente recette ! la crème est bien meilleure faite au bain marie, avec 2 gouttes d''extrait de vanille c''est aussi délicieux !', '2013-06-29T13:25:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 7086b723-f447-4e03-9c3e-7abaefe87c22, 'Excellent dessert... Tout était parfait... J''ai  juste attendu le dernier moment pour le montage... La mise en place étant fait 3h avant... J''ai rajouté quelques amandes grillés pour la finition ...Mes convives étaient ravis. Merci.', '2013-06-15T11:01:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 2c9c032f-aff6-4cfa-8abb-6cc17fd4a458, 'C''est juste top !', '2013-06-03T18:33:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, c3365777-8e75-4786-9ac6-f9cd8ddcbea9, 'Fait pour la première fois aujourd''hui. Moi aussi je l''ai fait en parts individuelles et préparé mes croustillants la veille. Mes filles m''ont aidé à dresser les assiettes. Tout le monde a été conquis. Ce dessert est léger. A refaire.', '2013-06-01T22:27:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, f7e81968-d841-4391-8471-09a40c42e000, 'Un dessert vraiment délicieux, merci infiniment pour cette recette !! Pour ma part, je mets des framboises à la place des fraises et je coupe mes feuilles en triangle (comme sur la photo! avec des ciseaux, plus rapide et joli que faire des cercles à mon goût!) ensuite, je mets seulement 40 g de sucre et je déguste sans difficulté avec couteau et fourchette évidemment ! ', '2013-05-27T20:39:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, e4686267-e177-485e-a1d7-07755d3c5f07, 'Si on le fait en suivant la recette, la présentation est très discutable. Peut être à réessayer en portion individuelle, ce qui demanderait plus de temps. Niveau goût, bon mais sans plus. Je ne referai pas ce dessert.', '2013-05-22T20:14:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 285f906f-0d4c-435f-9ada-4f284dfdd9a4, 'Un vrai succès, délicieux et top classe.', '2013-05-14T21:08:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 889c299a-a4d2-4fbc-bcc2-b45253c6ec18, 'hello les gourmands! Alors moi, j''ai fait des mignardises de la dimension d''une tasse à expresso, et du coup on a mangé étages par étages. J''ai ajouté 100 g de chocolat blanc à ma préparation, c''était MMMM.... !  Par contre, il faut vraiment les dresser au dernier moment sinon ça ramolli tout... bonne dégustation !!! ', '2013-05-07T15:53:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, a65a2e98-a788-4070-825b-f364aba996ce, 'Excellent mais j''ai mis 2 jaunes d’œufs au lieu de un et je trouve ça mieux !', '2013-05-01T22:21:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 29406423-d61c-40b5-9bfb-4e0e146bf7e2, 'J''ai fait cette recette aujourd''hui, en portion individuelle. J''ai bluffé mon époux ! C''est très beau et surtout très bon. Et ne faites pas comme moi, j''ai fait une première crème en mettant un œuf entier (je me suis trompée) et bien sûr, la crème était trop liquide ! Dessert à faire et refaire pour vos invités, ils n''en reviendront pas. Merci pour cette recette !', '2013-05-01T18:17:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 256d1e61-aecd-4a77-b530-09374cb5dd4a, 'J''ai essayé également les parts individuelles... Cela n''étant pas évident, du coup, j''ai présenté en verrine de taille moyenne en respectant la recette: j ai émietté les feuilles de bricks puis couche de crème puis fraises à nouveau bricks crème fraises puis bricks une fraise entière et sucre glace. Un vrai délice et facile à manger !!!! Merci pour cette super recette !!!', '2013-05-01T11:46:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 11b6e321-20ee-469b-932c-e7f91237aff9, 'Bien....mais il est impératif que le dressage soit fait à la dernière minute, les feuilles ramollies, ce n''est ni beau ni bon ! ', '2013-04-28T12:42:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 5726c1ea-5fbe-47d4-812a-7e82ac8a15bc, 'quasi impossible à couper proprement, nous avons choisi de faire des portions individuelles. quel effet quand le plateau arrive sur la table. et le goût est top. à faire dans tous les foyers...', '2013-01-07T19:26:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 5611a4c7-43e8-4940-9c97-be104634cfa2, 'Super ! Fait en portions individuelles, pas pratique à manger mais tellement bon et beau ! A refaire absolument !', '2012-08-19T15:00:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 291a8e3b-6a06-427e-9242-9bc743ea5c3c, 'Voilà un dessert rapide et facile à réaliser et qui a fait l''unanimité. Tout le monde s''est régalé... Excellentissime. A refaire sans hésitation. Merci beaucoup pour cette super recette.', '2012-06-02T21:56:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 27838e0f-ec43-4899-aac2-c410358bddb4, 'Un vrai régal je le refais souvent !! Je mets un peu moins de sucre 40 g suffisent, merci', '2012-05-18T04:02:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 36d726f4-cb1a-404d-a460-e1452df5b0e6, 'Il n''y a vraiment rien à ajouter côté goût, l''utilisation des blancs d''oeufs en neige donne vraiment un côté aérien et mousseux, rien à dire; ça a vraiment fait l''unanimité, même au niveau de la présentation; par contre il faut vraiment les faire en mignardises car c''est impossible à découper autrement', '2012-05-17T11:58:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 0ec6d554-6d77-440f-80c7-2180ccc8557e, 'Voilà un dessert magnifique et simple à réaliser... que du bonheur... J''ai suivi la recette mais n''ayant pas de fraises, j''ai mis des framboises à la place... on s''est régalés!!! Merci pour cette délicieuse recette que je proposerai à noël en version mignardise pour que ce soit plus facile à manger.', '2009-10-27T21:37:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 4c67f9fa-9949-4b0e-a5ec-9fac6264dcbc, 'Le goût est délicieux, identique au tiramisu aux fraises que je recommande par ailleurs. Par contre, très difficile à manger. Feuilles de brick incoupables à la ptite cuiller. On a dû manger avec les doigts en secours ! Je réessaierai en dressant au dernier moment, peut-être mes feuilles ont-elles ramolli.', '2009-10-20T23:42:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 9f9d7a76-a5a7-4065-821e-905b3b24497e, 'Je l''ai préparé en part individuelle pour 11 personnes. J''avais découpé des petits ronds à l''aide d''une tasse et précuit les feuilles la veille. Mais ce n''est pas facile à manger ! Malgré tout, c''est très bon et ça fait son effet ! ', '2009-07-12T23:13:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 7c65a7d5-80ec-425d-8e5f-0a4ce1bf72a9, 'C''est délicieux, beau et en plus facile à faire. Que du bonheur !  J''ai préparé les petits millefeuilles individuelles au moment de servir. Merci beaucoup.', '2009-07-11T16:02:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 8e02420c-13ec-46a7-b514-ea6a97be5226, 'Super et enfantin ! Même ma fille de 10 ans y est arrivée !!! Et en version individuelle servie sur assiette, c''est vraiment top. Merci Jeanne !', '2009-05-10T18:25:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 391438ab-8989-49d4-88e5-85f56c22c2db, 'C''est délicieux, beau à regarder, rapide et facile à faire. Le bonheur! J''ai préparé la crème à l''avance que j''ai allégée avec le blanc d''oeuf monté en neige, je n''ai monté les millefeuilles qu''au moment de servir.', '2009-03-15T17:30:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 5fc103ef-5a82-48a0-ba85-40619ad5e552, 'Un seul mot : délicieux!', '2008-10-11T11:10:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, e8bd9a6e-7ac3-4bc6-a3eb-da5b47ac2cf7, 'Bluffant, très simple à préparer, joli à présenter, délicieux. J''avais acheté des fraises mara des bois, sublime! Et accompagné d''une glace aux calissons. Miam !! ', '2008-08-07T20:48:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, b15b481c-7a74-4a98-8422-abb1634bca95, 'C''est très bon ! Je referai cette recette très simple et rapide à mes prochains invités. J''ai pu préparer à l''avance et dresser à la dernière minute. Ma seule modification à été un sachet de sucre vanillé + 50g de sucre. Merci.', '2008-06-03T22:56:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 1312c54f-51ca-4253-ab52-e7b012d3795c, 'J''ai trouvé la recette dans les thématiques plein la vue et bien ce n est pas pour rien!!! visuel sympa et en plus excellent!!! ', '2008-04-18T17:21:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, f41dda33-c769-4efa-ae91-8f7d48d25135, 'Franchement délicieux... tout le monde a été épaté, j''ai utilisé les blancs en neige comme l''a conseillé Nicole! C''est vraiment délicieux, facile et ça en jette!!', '2008-03-30T21:54:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 6b08f80d-8a6b-4b20-bd8b-85465aa92abc, 'Délicieux. J''ai pris note des commentaires en préparant la crème avec 2 oeufs et les blancs en neige. J''ai préparé la veille la crème et les bricks, j''ai donc dressé au dernier moment sans craindre un ramollissement des bricks. ', '2007-07-11T18:58:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 50743ecc-cc81-4445-bf3b-4871bf6ebadc, 'Ah oui, quel résultat spectaculaire ! J''ai beaucoup simplifié la partie crème en mettant simplement de la crème légère fouettée et j''ai adopté moi aussi le système du bol pour faire des parts individuelles. Effectivement une parfaite alliance entre le crèmeux et le craquant. C''est sûr, je recommencerai !', '2007-05-28T12:00:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 32c34338-9c0f-4d9c-92a8-8fb71163575a, 'Epatante! Pour ma part, j''ai fait des cercles de pâte à brick d''environ 7cm de diamètre pour réaliser des montages individuels. Et pour la crème, j''ai utilisé du sucre glace et suivi les conseils précédents en incorporant des blancs en neige (2). Un peu de sucre glace sur le dessus avant de servir et l''effet est ga-ran-ti!', '2007-05-20T14:13:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 1c08fbf4-200e-43ae-885b-517f5488431c, 'MMMh Absolument délicieux et très beau! J''ai suivi les conseils : j''ai préparé des petits ronds de feuilles de brick à l''aide d''1 bol pour faire des parts individuelles et j''ai ajouté les blancs en neige. Tout le monde s''est régalé.', '2007-04-24T10:13:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 3c5d1b49-492d-4e9c-a936-f873372d31ce, 'Excellent! J''ai fait des portions individuelles dès le début, car je craignais de ne pas parvenir à couper les feuilles de brick dans les casser... Ma crème était plus compacte que sur la photo, mais en l''étalant délicatement, pas de problème ! Je n''ai pas mis de beurre sur les feuilles de brick car je n''aime pas ça, elles ont un peu roulé, mais dans l''ensemble, c''était présentable. Mes filles de 2 ans et demi et 15 mois ont adoré !', '2007-04-20T10:26:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 726e7854-74ed-493d-b8ff-9a70611cd4a2, 'Résultat épatant pour un dessert simple et rapide à réaliser. Parfait avec une petite coupe de champagne pour terminer un tête-à-tête en beauté...bon appétit à tous ! ', '2007-02-20T21:57:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 00670219-4384-46cd-8d51-b7c4d0dfbbc9, 'Dé-li-cieux. Rien à ajouter ou à enlever! ', '2007-01-14T01:06:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 1c33f59d-6dac-4284-9aa7-de244a3a3dc5, 'C''est très bon, rapide à faire, et quel présentation!!! A la place du mascarpone, j''ai mis de la crème fraîche car je n''avais pas l''autre ingrédient sous la main et c''était très bon. J''ai fait en parts individuelles et en rond servi avec quelques fruits rouges autour, super, à refaire!', '2006-09-03T00:38:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 759bc4fd-3a26-4143-afbf-a3ae4c4a3e46, 'Un bonheur! facile et réussi, mon copain m''a limite demandée en mariage! Merci Jeanne. Moi aussi j''ai rajouté des blanc d''oeufs battus en neige. Et les restes de feuilles de brick ont été trempés dans le reste de crème, un régal!', '2006-07-21T13:04:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 0b3a5f39-3bb9-43a2-9132-36bf1fa7848f, 'Beaucoup d''effet pour ce dessert! Je n''avais pas de mascarpone, je l''ai remplacé par de la crème et du fromage blanc (surement moins bon que la recette originale mais correct). L''effet visuel est bluffant, j''ai rajouté une feuille de menthe pour la déco, mes copines étaient épatées! (Par contre, je n''ai pas mis au frigo pour garder le croustillant.)', '2006-06-23T15:20:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 5f7b90ce-11b9-409a-97e6-cbb88ae89cd2, 'C''est beau et bon! Les fraises apportent une note fraîche bien agréable. Mais il y a dans la cuisine marocaine un grand classique appelé pastilla "ktéfa" ou pastilla au lait, qui ressemble énormément à cette recette, la crème est faite avec lait, sucre, eau de fleur d''oranger et fécule de riz. Au montage on alterne feuilles de brick et amandes frites, les feuilles de brick sont dorées à la poêle, c''est plus gras mais plus croustillant aussi. Voilà, c''est une information que je voulais apporter.', '2006-06-16T00:57:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 6b7642e2-c4fd-4834-8d7e-7ce9eea6da8b, 'Très bon !!!... Mais qu''est ce que c''est compliqué à manger ! lol J''ai également suivi les conseils de certains : j''ai mis 2 jaunes d''oeuf et incorporé 2 blancs d''oeuf battus en neige. Le résultat est vraiment très bon ; merci pour ce dessert que j''ai fait à ma maman à l''occasion de la fête des mères !!', '2006-05-28T21:47:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 50ea8a67-d4f0-4f07-bcaf-087908b9cf81, 'Alors ça, super bon, super beau, mes invités ont adoré... par contre un peu long à faire je trouve. J''ai fait 4 cercles par feuille de brick et pour cela j''ai pris un ramequin pour avoir un rond parfait et j''ai découpé avec une roulette à pizza pour plus de facilité. A faire et refaire absolument!', '2006-05-15T13:18:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 9a93a029-39fe-4514-b725-83d3dee90928, 'C''est bon : j''ai utilisé 500 g de fraises et 200 g de framboises et allégé la crème avec 3 blancs en neige. L''assemblage est à faire au tout dernier moment car les feuilles de brick ramollisent très vite. A servir avec un coulis de  fruits rouges. ', '2006-04-17T19:26:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 6d51832e-fb89-4eab-a430-e1567f7c1c27, 'Très bon et très beau à regarder! Je l''ai fait avec des framboises, et j''ai moi aussi suivi les conseils d''autres internautes : j''ai utilisé des blancs en neige pour alléger la crème. Mais même comme ça, il vaut mieux prévoir un repas léger avant ce dessert! Je pense que je vais finir par devenir une fan de "Jeanne"... A suivre...', '2006-01-10T15:06:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, cfa6cf85-73ca-45f7-985a-fd3f8f75a52a, 'C''est beau, c''est bon et rapide à préparer pour un résultat épatant... Que dire de plus à part : Merci Jeanne!', '2006-01-06T10:15:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 237f3c78-cfc9-406d-9f38-c1152fc65c8c, 'Vraiment délicieux, un dessert qui en jette!', '2005-10-12T22:24:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 101d3121-890f-4579-a289-3f1a457fda6f, 'Waouhhhhh!!! J''ai adoré, j''ai suivi les conseils des marmitonnes et allégé la créme avec des blancs en neige... Par contre je les recommande après un repas léger ... ', '2005-10-11T14:18:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, e5928d10-7e57-4f56-9a1e-1386c828e48d, 'Bravo Jeanne pour cette recette merveilleuse qui en jette!!! Pour ma part j''ai allongé la crème avec de la liqueur de fraise des bois, ajouté des framboises et saupoudré les feuilles de brick avec un peu de sucre avant la cuisson! Un régal!', '2005-08-24T20:32:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 10bfd70e-6e3c-4a24-8772-924a8c627895, 'Très bel effet et très bon goût. Il faut simplement diminuer la quantité de sucre. Je l''ai fait avec un étage de fraise, un de framboise, un de myrtilles... Le bonheur!', '2005-07-31T23:20:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 30ba98a0-4562-4532-a0e0-d962406cc01c, 'Ecellent, frais et se mariant effectivement parfaitement au champagne. Comme en plus c''est vite fait et ça peut se préparer à l''avance, c''était parfait pour la fête des mères! Par contre, jaune d''oeuf + sucre + mascarpone, c''était un peu trop du béton, j''ai donc ajouté quelques ml de lait pour rendre la crème plus liquide.', '2005-05-31T12:35:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, a2d7d97e-7379-42f9-85d1-6600e3245977, 'Délicieux. la crème était très épaisse avec les proportions données. J''ai présenté dans des coupelles avec les feuilles de brick émiettées par peur des difficultés. L''amande amère apporte un petit plus très appréciable. Merci Jeanne pour cette recette!', '2005-05-30T00:21:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 10ad11d3-f9ad-4097-8f5f-aab4df9a7138, 'Exellent... même après un bon repas ça passe très bien. Personnellement, comme je l''ai fait pour 2 personnes, il me restait des fraises, j''en ai fait un coulis (avec un peu de sucre) dont j''ai nappé le haut des craquants! ', '2005-05-24T19:23:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 152a44ef-fdbd-4a1a-8424-a14a91fc490b, 'La 1ère fois, j''ai suivi la recette de base: un régal! Et la seconde fois, suivant l''avis de Nicole j''ai incorporé les blancs en neige. C''est tout aussi bon, ça allège la crème et surtout c''est beaucoup plus facile à étaler sans "massacrer" les feuilles de brick !! J''en referai, harcelée par mon fils !!', '2005-05-23T10:17:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, f8d2a657-37bb-4682-8aa0-a4a7594e6ab8, 'A faire au dernier moment car c''était tout ramolli. Peut-être mettre de la gélatine dans la crème... A refaire.', '2005-05-23T09:02:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 7ba3baa5-a20d-447d-a981-9b218c474436, 'C''est vrai que ça en jette, la présentation en parts individuelles est magnifique! C''est original et délicieux. J''ai aussi utilisé le blanc en neige pour allonger la crème.', '2005-05-21T01:05:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 7c5ab101-89d0-492a-a266-52f339b694af, 'C''est très bon et très beau ! J''ai suivi le conseil en mettant moitié mascarpone et fromage blanc et j''ai mis un peu moins de sucre. Mais surtout pas plus de 30mn au frigo sinon ça ramollit trop.. et c''est dommage.', '2005-05-18T21:15:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36356, 85364cd0-a118-4726-ab78-5c9aa0d6ad04, 'Excellent et c''est vrai que ça en jette ! Zéro stress : on peut tout préparer à l''avance et assembler 1/2 h avant le dessert. En plus, il faut tout finir, sinon les feuilles de brick s''amollissent et c''est moins bon. On peut avoir la main lourde sur les fraises !', '2005-05-15T21:40:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, caeee703-cd67-4de1-a72f-1f680d98f420, 'J''ai remplacé le miel par du caramel beurre salé et diminué le sucre 50 g.', '2018-11-11T19:03:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 22f1621d-01b9-4744-a793-d56e66f9ef3a, 'Très bonne recette, mais avec moins de sucre. J''ai déjà diminué d''office de 20g la quantité de sucre et j''en mettrai encore moins la prochaine fois.', '2023-10-24T12:57:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 2c738460-be32-46e5-9b31-9be441e8aab1, 'Facile à faire et excellent ', '2023-04-08T09:35:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 3564cc15-2699-40ac-a43c-bcb2903d620e, 'Très bon mais mais il est meilleur avec des palets bretons(recette marmiton), la pointe de sel se marie très bien avec la compotée de pommes.', '2022-02-11T16:10:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 78b1e4a3-de5a-4cb9-8e6d-7155254a51d7, 'Bonne recette et très simple mais trop sucrée et trop de cannelle. Je referais cette recette en diminuant les doses de ces 2 ingrédients', '2020-12-07T00:20:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 1afa1977-a7f7-47dd-9a30-9e75345d474e, 'Recette au top !', '2020-09-27T21:54:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 88e08ae6-a4c8-43dc-b330-f87cd2584646, 'Délicieuse recette ! Je la réalise régulièrement et mes invités sont à chaque fois conquis !', '2020-01-17T03:56:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 748dbc8c-259a-43d6-b083-fc0eeda62fce, 'Très bonne recette, un délice. Par contre pas de jus de pomme dans le fond de la casserole, je ne savais pas par quoi remplacer .', '2019-10-22T06:39:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 198fe431-cf7f-47aa-8a28-7256633e9dcf, 'Délicieux mais il est vrai que comme tous les internautes, c''est fort sucré avec le miel. Il vaut mieux diminuer les doses !', '2019-04-17T22:01:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 5c5dfc78-dbdd-4947-8f2d-9beb5d6ef23f, 'Très bon mais juste un peu moins de sucre aurait été parait ☺️', '2019-04-07T07:40:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 06cc3fb1-7ffd-43d8-9cea-4e4f5cadd67a, 'Très bonne recette mais trop sucrée. J''ai divisé la quantité de sucre et de miel par 2. J''ai ajouté 2 pommes pour faire 9 verrines.', '2018-12-22T04:36:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, ba7feca4-89e8-43be-98a3-665d5eac9127, 'Super bon! J''ai suivi les conseils. 1 cs de miel et 40 gr de sucre suffisent largement. N''ayant pas eu de jus de cuisson des pommes j''ai trempé les speculoos du fond du plat dans du jus d''orange. ', '2018-02-17T09:43:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 03716e30-27ee-4ef5-aaec-52f04e74aced, 'juste délicieux', '2017-07-17T00:57:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 74ab6057-42a2-46ba-9441-d533deb10635, 'Une tuerie. Un des meilleurs tiramisu que j''ai mangé, j''ai adoré, même mon chéri qui n''aime pas les desserts a trouvé ça delicieux. A faire et à refaire sans modération. Merci pour cette délicieuse recette.', '2017-05-10T13:07:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 5af5b697-ea3a-4946-9cd9-bc8cf4314d81, 'Excellent !!! J''ai juste ajouté un peu de compote au fond du verre pour attendrir les spéculoos ! Attendre au minimum 24 heures avant de servir.', '2017-03-21T13:20:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, fba506e2-07ad-4e4d-b134-5ec7ec075c25, '5ogr de sucre suffisent. Excellent avec des poires !', '2016-10-09T19:27:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 0d1edc1c-b567-43f1-8e67-c43c2f65073b, 'Excellente recette mais trop de sucre : 1 cuillère à soupe de miel + 40 g de sucre suffisent. ', '2016-02-29T18:57:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 55c499fb-f1ca-438d-b4e6-b2f1fd6c4194, 'Excellente recette ! Merci beaucoup !', '2015-11-01T21:16:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 529f6a43-826d-48ee-accf-b1b42d8dd7e8, 'TROP TROP BON ! Merci !', '2015-06-18T16:38:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 5301b26f-9900-4ee1-b733-cafeb1161b70, 'Super rapide et délicieuse !!  N''ayant pas prévu mes invités, je n''avais que des pommes et j''ai tout à fait étonné tout le monde avec un goûter juste parfait', '2015-01-02T02:09:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 6485ae98-9d6a-4246-b023-8a72438dc7e9, 'Recette vraiment délicieuse ! Je la referai sans hésiter, et sans rien changer. Délicieux.', '2014-11-24T14:57:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, e0837a8c-1cbf-4f41-9bec-2d0f370d2934, 'Bon même très bon mais et il y a un mais un peu trop de miel, il faut réduire cette quantité. ', '2014-03-16T18:50:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 1538896e-9111-4b70-926a-b96c60a9994c, 'A refaire sans hésiter !', '2013-12-20T19:42:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, cf726c72-8257-468e-81a3-479f6e80a01b, 'Recette pour 4 faite pour 6 sans problème !', '2013-11-10T18:51:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, c09bafd8-79d2-4405-9c4e-af8641c5739f, 'Très bon, mais mes pommes n''ont pas rendu de jus. J''ai tout de même mis mes spéculoos et c''était très bon. Également, à mon goût, la préparation de mascarpone/œufs/sucre était trop sucrée. Mais oui je la referai sans problème car facile et rapide.', '2013-09-01T15:39:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 6549ebf3-8db2-44ef-8da9-f829813874b0, 'C''était une première pour moi le tiramisu est bien je suis très contente c''est super bon.', '2013-08-09T12:13:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 20f3bb35-2192-4f89-b2ff-363413b705ff, 'Original et très bon ! Nous avons choisi de ne pas mettre le miel et tout le monde a été enchanté de ce dessert ! ', '2013-07-19T11:12:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, b6d9c91f-c12e-4b3c-a3bd-795a9166c504, 'Excellent, j''ai remplacé le miel par du caramel liquide.', '2013-02-22T20:17:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, a5580dbb-f325-4a3e-b6f5-a173e8bef3bb, 'N''étant pas fan de la vanille, j''ai mis du caramel au beurre salé avec les pommes et comme certains internautes, j''ai réduit le sucre dans le mascarpone (environ 50 g)... et finalement "ce dessert, il déglingue!!!" (selon mes invités...) merci beaucoup', '2012-11-11T14:49:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, f20b62f7-6f2d-47b7-976c-232a39c824ce, 'Excellent ! Recette très bien expliquée, réalisé pour une quinzaine de convives, petits et grands se sont tous resservis ! ', '2012-10-23T12:01:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 5969cb97-c81e-48d8-88be-a828178723c0, 'Pour moi, un total gâchis, les pommes n''ont pas caramélisées, il n''y avait pas de jus et beaucoup trop de mascarpone par rapport aux pommes. Personne n''a aimé.', '2012-05-20T21:13:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, bff88e69-95af-4028-ad1e-e76078545018, 'Une aute variante du tiramisu, très bonne et la présentation en verrines est très jolie (couches bien distinctes). Rien à redire, parfait.', '2011-12-09T20:14:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 49495f73-d55c-49a9-8151-7c71f6828f71, 'Quel succès ! Tous mes invités ont adoré ! J''étais super fière. En plus, la présentation dans des verrines rend vraiment très bien. Niveau sucre, 40 g c''est suffisant, je pense que ça évite de rendre le dessert écœurant, c''est peut être pour ça qu''ils en ont tous repris !', '2011-11-28T13:08:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 07f22d5c-8ac0-4e75-9a58-505af1082b51, 'Très très bon, j''ai juste diminuer un peu la dose de sucre (70g). 4 énormes verrines bien fraîches. Idéal par ce temps !!', '2011-10-03T22:24:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, f63f7acd-efa9-4443-97f5-04a8eca0ef0b, 'Vraiment très, très bon. J''ai cependant, la deuxième fois que je l''ai fait et sur les conseils de mes consommateurs, mis un peu moins de sucre et fais flamber les pommes avec un peu de calvados et tout le monde s''est régalé la deuxième fois', '2011-01-07T18:40:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 8f31523b-cc71-4c50-9ace-452ccc2cdea3, 'Très bien ! Mais je n''ai pas eu beaucoup de jus, il était peut-être trop caramélisé !', '2010-11-23T13:23:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 826e8adf-1faf-4cd9-b33c-6752d35ff053, 'Très bon, recette légère. A refaire ', '2010-10-04T18:22:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 4dc42c29-910d-4386-8606-1532303a093f, 'Divin ! Et impossible à rater ! Ce dessert, servi en verres, a vraiment fait son effet. Léger, parfumé. Important d''imbiber les spéculoos du jus de pommes. ', '2010-05-15T09:46:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 8061cfed-c33c-4038-9071-e53e4b3bd1f9, 'c''est monstrueusement excellentissime !!!! =) J''ai trempé les biscuits dans de la manzana (liqueur de pomme), et j''ai mis 30g de sucre+1sachet de sucre vanillé. J''ai aussi mis moitié/moitié mascarpone et ricotta pour rendre le tout plus léger... C''était divin ! Par contre, dans des verres ça aurait été vraiment mieux pour la présentation...', '2010-02-21T17:59:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 1f974397-4667-473f-85b1-fe7db20496d6, 'Plus d''un an que je fais cette recette et tous ceux qui l''ont goutés m''en redemandent. Super effet en verrine.', '2010-02-19T15:41:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 56bb6ac6-ce73-463b-bf82-75bb8742d2a4, 'Une tuerie!!!! Juste un peu moins de sucre', '2010-02-16T02:31:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, b683727e-5647-4e27-b16c-cdcdafddb584, 'Excellent! Les pommes sont un pure délice. Sous forme de verrine, cela constitue un dessert idéal en période de fête!', '2009-12-26T11:06:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 8a1f358f-d747-4e86-9834-99aadc37f952, 'Très, très bon! Je n''avais pas de miel donc j''ai mis un peu de sucre pour caraméliser les pommes et j''ai ajouté de la liqueur de pommes sur les spéculoos pour qu''ils soient moins secs. A part ces modifications, c''est un réel délice et ça change du tiramisu traditionnel.', '2009-09-20T22:03:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 7952dd32-2cb3-4308-8adb-a4dc1d7c6ecc, 'J''ai divisé les quantités de sucre et de miel par 2. Ce dessert est super bon ! Je le refais souvent.', '2009-09-12T12:42:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, c8f0209a-3b92-4a7f-8295-c73a1d7aea32, 'Super bon servi dans des verres par contre j''ai mis des boudoirs au fond puis des spéculoos', '2009-08-10T22:00:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 78e03e3e-cff6-4c64-8182-47166ea5113e, 'Ça déchire !!!', '2009-07-25T17:23:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, c6af5b6a-46dc-4593-8bb0-56b62640003a, 'Quel délice ! Rien à changer à la recette, merci !', '2009-05-30T21:03:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, de99d787-3c65-4b2f-8c74-e98460289f12, 'Dé-li-cieux. J''en ai préparé avec à côté, pour les plus frileux, un tiramisu plus "traditionnel", celui-ci a été englouti en premier et sans somations! Facile à préparer et à réussir, original et gourmand. Très bonne découverte !', '2009-03-16T17:55:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, e74a1068-b3f4-44e7-b9dd-a226608b132d, 'Très bon! Un véritable régal, tout le monde a adoré, même les enfants. A refaire sans hésitation !', '2009-02-25T21:45:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, dbfb1068-1c46-406e-86a9-a15a61a89c47, 'C''est très très bon! A faire sans hésiter. C''est rapide (sauf l''épluchage des pommes)et délicieux! Le mélange de mascarpone a comme un goût de crème chantilly. J''ai mis 50g de sucre parce que j''avais peur que ce soit trop sucré. Après un plat assez consistant ça descend tout seul! Je le referai à coup sûr!', '2009-02-15T19:38:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 83cda019-17e2-42f9-904b-b3b4f91028c1, 'Délicieux ! Il est au frigo pour demain mais on en a mangé un (fait en verrines) en famille avec les pommes encore tièdes...c''est un délice !', '2008-12-04T22:17:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 5edebb19-6397-4ad1-921d-d9c327ad03d8, 'Excellent aussi ! Succès assuré !  Je l''ai servi en coupe à cocktail, très bon effet visuel !', '2008-11-22T15:40:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 11d53fc4-751a-41fc-ac1d-21f91007a943, 'Original. Bon. Le miel et les spéculoos mhhh. Tous mes amis ont dévoré.', '2008-10-03T15:57:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 369bef30-03fd-40da-90d8-7fb64e989050, 'Excellent, il n''y a pas d''autre commentaire à faire.', '2008-09-25T22:00:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, cb5524e4-868d-4489-b640-c18769d6d35e, 'Délicieux! J''ai fait la recette telle quelle et c''est un pure délice. Tout le monde a adoré!', '2008-07-11T21:31:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 12b5aad6-9d15-4a5d-a19d-f25e34058150, 'Très bon, attention toutefois car très sucré. Moi je conseille de diviser par 2 la dose de sucre ou d''enlever le miel. Cela ne dénature pas la recette.', '2008-07-02T18:56:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, cb3513c3-f6aa-4a3b-a8cf-0dbdbbbc079d, 'C''est très bon, je l''ai préparé la veille au soir pour le lendemain midi et tout le monde s''est régalé.', '2008-05-11T22:59:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 5366fe7f-8b68-44c3-a501-a7ae0a812fb5, 'Excellent et original. Change du traditionnel tiramisu.', '2008-05-10T14:07:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68982, 0a1f2878-8fbd-4cb1-a821-c702611b7ad2, 'Un vrai délice, tous mes convives ont adorés.Très facile à réaliser quand on possède un batteur électrique et ça change du traditionnel tiramisu au café...ses pommes caramélisées, un pur bonheur .', '2008-04-05T18:04:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, da57e7ae-b4e6-4e4a-9cbe-b05b84d24b47, 'Très rapide et sympa. Ne pas hésiter à prendre 300 voire 350 g de framboises et du coup supprimer le lait (trop liquide sinon) Prendre la crème entière et non allégée pour une consistance moins "yaourt" Astuce pour avoir une texture plus "bavarois". Faire ramollir  2 feuilles de gélatine dans l''eau chaude et une fois ramollies les mixer avec le tout. Tapisser le fond de jolies coupes avec des framboises, mettre la mousse, décorer avec des fruits rouges et deux feuilles de menthe. Mettre au froid  2h avant de servir ! Et cela fait son petit effet ! C''est très frais en cette période chaude.', '2020-09-14T18:11:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, 5156c163-4d0d-41fd-8811-23ad370181d6, 'Pas top, ressemble à un simple yaourt aux framboises ', '2016-01-03T20:18:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, 120038d5-1af2-43fd-823a-dbd11efd1ef7, 'Super vite fait ! J''ai mis du lait concentré sucré à la place du sucre et du mascarpone à la place du ricotta. (Les fonds de frigo quoi !). Résultat extra !', '2015-03-28T15:08:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, 4c2dc86d-cd42-4ba5-991b-dd52a43384ba, 'Simple, facile à préparer... tout simplement délicieux !', '2013-12-31T16:35:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, 2f6f4425-04d1-4881-8696-53fa0d4763d4, 'Rien à dire c''est délicieux et si simple!!!', '2006-12-25T04:28:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, 0362097a-b9da-417e-8ea3-0f7f1ae984ac, 'Très rapide, très frais. J''ai mis un peu de sirop d''agave au lieu du sucre, ça évite d''avoir des petits grains et ça donne un goût plus agréable. ', '2013-02-16T10:43:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, e727f48b-4ab9-449d-b53c-458afe68ced7, 'Bon dessert rapide à faire. J''ai mis la crème en verrines, j''ai ajouté des spéculoos brisés dans le fond, et décoré avec des framboises, fraises des bois, groseilles et pistaches bien vertes pour la couleur.', '2012-09-19T13:44:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, 0d3fb1f8-90bb-4bd6-8505-dde7cdda2b44, 'Très très bon, j''ai ajouté sur le dessus des morceaux de spéculos : ça ajoute du sucre et du croquant, c''est terrible !', '2012-09-14T13:30:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, 92613a79-1d7c-4809-9ffb-add7b8a63022, 'Très bon et frais. j''ai moi aussi pris 350 g de framboises, ajouté plus de sucre, mais je trouvais le dessert un peu trop liquide. la prochaine fois je battrai la crème en chantilly et je pense que le lait n''est pas nécessaire.', '2012-08-06T00:03:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, a43425bb-1573-4cc3-96b0-44fccddf783e, 'Très bon dessert, super vite fait. J''ai ,moi aussi, ajouté des framboises (350 gr) et du sucre. Très frais,convient après un bon repas. Belle couleur rosée.', '2010-11-08T12:15:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, f8fed49a-1d92-4bb3-bcb6-15159f37501d, 'Dessert adopté depuis un moment par mes enfants et mon mari, ils adorent !', '2010-06-09T16:28:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, 1a6ad621-83b2-4d1b-a6bd-5270f2f86465, 'Il me restait 250 g de ricotta, je cherchais une recette rapide à faire pour l''utiliser. Celle ci convient très bien. J''ai mis de la crème liquide, un peu moins de 20 cl, et j''ai laissé au frigo une bonne heure. ', '2008-02-25T20:05:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, 7359d711-2a71-40ad-a305-a6e13917a6ee, 'Pratique mais rien d''extraordinaire. Bonne base pour expérimenter avec d''autres ingrédients. ', '2008-02-16T00:29:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, f95483f4-d12c-475d-aee1-75ac42851019, 'Facile et très bon. j''ai suivie les conseils lu en commentaire et j''y ai mis 500gr de framboises ce qui rend le dessert plus sucré et moins acide. En revanche n''ayant pas trouvé de framboises surgelées, je m''en suis procuré des fraîches, ce qui revient assez cher (12€ les 500gr). Mais bon quand on aime on compte pas.....', '2007-09-26T15:33:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, 05181e26-4113-4cfe-a136-6a20bde6b2db, 'Idéal pour l''été ou après un repas copieux, cette recette a une couleur très sympa à présenter. Ne pas hésiter à mettre plus de framboises pour un goût fruité plus prononcé.', '2007-06-21T11:42:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, b92e8958-0c0d-457a-80b8-25b4f5518f69, 'Délicieux, facile et très frais (juste rajouter un peu plus de sucre)... ', '2007-06-17T23:58:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, d9044e43-6ca1-42c1-a3ad-e519165a20e1, 'Rapide et simple à faire, très léger, frais, mes invités ont adoré.', '2007-06-16T15:53:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, fd17f6c0-9e95-4962-b779-0491068f43e3, 'Merci pour cette délicieuse recette, simple et rapide.', '2007-06-12T01:57:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, c5b5ca8a-9ce5-4240-ad26-6edb0a3070b8, 'J''ai fait cette crème pour des amis. Personne n''a aimé. Ca ressemble à une espèce de yaourt rance aux fruits.', '2007-06-07T12:39:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, bc37e01a-69ed-4053-9874-d78c5ae59231, 'Une recette qui va devenir un classique chez nous! Très onctueux et un super goût de framboises. J''ai fait plusieurs tests en ajoutant de l''anis vert en poudre, de la cannelle (1 cac) et de la crème de cacao (1 cuillère à soupe) c''est divin et on ne perd pas le goût d''origine mais on lui ajoute des notes un peu chaleureuses.', '2007-04-01T13:47:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, 58221b49-3610-4385-9598-dee386f57034, 'A faire et à refaire...', '2006-07-09T15:31:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, 01c065fe-3deb-49d6-89b5-e49553dc9d1e, 'Recette simplissime! Crème très agrébale et très fraîche.', '2006-02-14T15:28:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, c6ed0433-2fde-4239-b7e7-7a9bcbea2200, 'Oulala, c''est super bon... Merci!!', '2005-10-02T22:00:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, bc9226a4-ce61-4710-9380-38fec07bc332, 'Cette recette est d''une simplicité enfantine!!! Vraiment délicieux. Pour ma part j''ai utilisé un paquet de baies des bois congelées. Il faudra que j''essaie qu''avec des framboises. Merci pour cette recette !', '2005-08-19T19:19:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, 96c97994-0bb9-4f57-ba61-fca7dcf8651c, 'Très bon, très rapide, très frais. Merci pour cette recette idéale en été.', '2005-07-22T01:34:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26447, 41e2dce7-25b1-4fba-ae75-870a11ada93a, 'Délicieuse, très rafraîchissante et vite faite.', '2004-04-09T14:06:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, 6f3bd298-9fc9-4612-9d26-b1c728b9e8cd, 'J''ai piqué les fraises sur des Mikados pour apporter un peu de croquant.', '2021-04-24T18:42:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, 106359dc-f78c-4df1-bd53-66113b711c2b, 'La recette serait meilleure avec du chocolat fondu dans du beurre !', '2013-12-30T17:24:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, 1b513730-cb72-4f37-9c6a-841dbe0025ba, 'Cette recette a eu un franc succès auprès de mes convives. A la place du pic j'' y ai mis un mikado au chocolat noir et je peux vous dire que les sucettes n''ont pas fait une minute sur la table.', '2011-08-29T17:42:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, d3908cfb-4341-4b44-a3f0-b7a29ab41071, 'Facile et deliiiiiiiiicieux ! ', '2022-03-05T23:05:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, fa38c8cf-55f9-4b03-93f6-d3d4e848ae91, 'J''ai ajouté 35 g de beurre demi-sel dans le chocolat. Un vrai régal car la fraise reste tendre sous la dent et le chocolat durcit au réfrigérateur... Belle harmonie et fondant. J''ai fait 20 fraises.', '2011-04-19T11:10:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, 7b27a88d-b1eb-4418-8ff0-99bd32f11158, 'Les fraises ne tiennent pas sur les pics: ( sinon trop bon.', '2020-05-24T17:45:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, 5fddd773-6ac8-451c-b8f1-676d067eff87, 'Mon petit-fils n''aime pas les fraises. A tout mangé. Merci', '2019-07-10T10:25:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, a12ee358-9534-4b03-a91d-07326180990e, 'Excellent, à préparer vite', '2019-07-10T09:10:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, 3960520c-2440-4cc0-8148-893f9e5af8a5, 'Génial pour les gourmands !', '2018-11-14T09:09:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, bbf85338-e56d-4914-9ba7-844cd3bd5e4f, 'original et beau', '2018-05-14T12:41:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, 949c1d91-e9a4-4f00-b827-a84f8f81c98b, 'Perso, je trouve que ça serait bien meilleur en mélangeant un peu de beurre et de crème au chocolat. Mais le visuel est réussi.', '2017-04-26T16:34:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, 0f70f087-b950-4a95-9723-c02d46cc8c6d, 'Les gourmands se ramènent quand on secoue la sucette pour petit et grands', '2015-05-28T21:10:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, e6dabfa4-d862-4856-a839-070545cb755d, 'Le chocolat ne voulait pas tenir sur les fraises... dommage.', '2015-05-22T04:23:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, b5740406-89b0-462e-8a72-e181dc476994, 'On peut le faire aussi avec du chocolat blanc trop bon ', '2015-05-15T14:01:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, e07864c9-e49e-43aa-a07a-c8079b15fdd0, 'Il faut utiliser des petites fraises et ne pas laisser le feu trop chaud sinon la texture du chocolat devient mauvaise. Sinon c''est un délice !', '2014-05-26T17:02:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, 5db6bd05-651e-4092-9e5d-5f480fc22a6f, 'Simplement délicieux. Mes convives ont été épatés !', '2012-09-15T14:45:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, 3532a997-1cbb-408a-8a14-3c92c4d51d90, 'Simple, frais, gourmand .. De quoi régaler les invités ! Félicitations pour la recette.', '2012-08-04T12:28:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, da1ea683-ce06-4567-83de-194ea770352f, 'C''est bon, mais ça reste simpliste. Ça plait aux enfants.', '2012-05-09T22:50:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, e32e2bb6-3f74-4602-9e8a-bed78a586096, 'c''est un délice ! facile à faire et bonne présentation ! j''ai essayé avec des fraises "Tagada" SUPER ! ', '2012-04-27T23:08:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, 6028d17b-75b6-4686-ba0c-9939124cac14, 'Top !!! Merci pour cette recette originale, un vrai délice pour l''anniversaire de ma petite fille', '2012-04-25T18:04:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, 6fa0198e-0b65-48e7-a240-65fad96331ef, 'Je les ai faites avec des bananes, très bon aussi et original.', '2012-03-07T16:23:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169175, 638d21bc-60ae-40cc-bf8c-3913dbcc4f3b, 'Tout simplement délicieux ! Je n''ai rien changé à la recette. Très frais, idéal avec un café gourmand.', '2011-06-15T13:47:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 1dfd942f-e959-483b-a58c-fab219b8c902, 'Gâteau facile à réaliser ! Très bon, tout le monde a adoré ! J''ai tout de même diminué de moitié le sucre et je l''ai servi avec une petite boule de glace à la vanille ! Parfait !', '2020-12-20T14:27:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 8898f875-441e-4b71-a490-5a176f06ed18, 'Super fondant !! J''ai ajouté de l''extrait de vanille liquide et c''était délicieux ! ', '2008-11-30T14:43:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 2822fb29-e625-459d-8272-acff16642747, 'Gâteau à coup raisonnable. Facile à réaliser. Très apprécié par la famille et les enfants. Pour les adultes, je rajoute 3 cuillères à soupe de calvados, pour parfumer .Merci pour cette délicieuse recette.', '2005-11-26T13:35:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, f2fa1e4b-d63e-4ccc-93f8-b144de266c44, 'Excellent. Je recommande ', '2021-03-19T19:52:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, a16da9bc-5690-4127-8dc1-23c33e6f6fd8, 'Excellent j ai couper les pommes et laisser mariné dans de la liqueurs de pommes ', '2021-02-24T10:53:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, fad68fc3-847a-4e2d-8749-56933786b499, 'C''est super bon juste j''ai mis que 50g de sucre et ça suffit largement et j''ai rajouté un peu de rhum. Maid sinon super recette.', '2020-05-01T23:01:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, f06085c3-ea36-43d8-b18b-cb4782ae3310, 'Ce n''est pas un fondant ! Il devient moelleux (j''avais pourtant mis 100g de beurre) après 48h quand les pommes ont humidifié la pâte. Il y a beaucoup trop de levure par rapport à la farine, on la sent ! Un demi paquet est suffisant. Il est bon, je le referai avec des modifications.', '2020-03-30T15:07:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, cbcb6ba2-ffdc-44e9-9d6c-3a5717746699, 'Un délice ! J''ai rajouté une cuillère de Rhum.', '2020-03-20T21:21:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, a4c2802f-c0d3-486e-9b67-d8819dbf0988, 'Excellent, fait à l''identique un peu réchauffé, on peut ajouter un peu de rhum', '2017-12-20T21:50:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 06b197d3-990a-4ff6-9876-60f1635222a4, 'Fondant très bon, à refaire !  J''avais mis qu''une couche de pomme pensant que ça suffirait et non il en faut bien 3. ', '2016-07-12T11:37:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, b519034f-3f7c-4e43-abbc-9b8b58d18dae, 'Très bonne recette, il est bien fondant! J''ai suivi la recette à la lettre. J''ai un plat plus petit mais j''ai gardé les mêmes proportions mais avec seulement 2 pommes du coup. Top ! ', '2016-03-25T18:32:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 02ad5a2d-a499-498d-b6f5-a6f751858349, 'Excellent ! Je me suis permise de remplacer le beurre par de l''huile et la crème par du yogourt blanc. J''ai également doublé les doses. Très moelleux ', '2015-10-07T18:11:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 896f62e5-47ea-4803-a427-9fc88b4860d4, 'Parfait, cuisson 35 min avec un four à chaleur tournante. 3 pommes et un peu de rhum. Grand succès, à refaire !', '2015-03-22T14:07:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, e8a44c05-f366-43ba-bc0a-818cf48e37f2, 'Très moelleux plus que fondant mais très bonne recette testée et appréciée pour le goûter; je la ferai à nouveau en dessert servi tiède avec une boule de glace vanille ou caramel.', '2014-11-02T18:50:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 1d313bb2-4d77-41d1-bc20-9fab39b22636, 'Huuum ! Très fondant ! Je me régale rarement avec des gâteaux aux fruits mais celui-ci est gourmand à souhait. J''ai mis seulement 2 pommes (peut-être que mon plat était trop petit). Une valeur sûre que j''ai saupoudré de sucre. J''ajoute une photo.', '2014-09-14T19:26:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 7b5f0963-67ce-47dd-b527-67a9dc719c8a, 'Je l''ai fait cuire 35 min à chaleur tournante et il aurait bien mérité 5 min de plus. Très bon sinon.', '2014-01-05T10:07:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 76ce0758-019c-4f95-b6a5-ea41b8c31200, 'Un vrai délice pour le gouter. Bien respecter les précautions : 3 épaisseurs de pomme au minimum pour avoir le fondant et surtout bien noyer les pommes sous la pâte. Rien ne doit dépasser.', '2013-12-24T18:17:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 8d2089a5-8c90-4dd8-90f0-61035e98de9b, 'Bon, mais pas transcendant, j''ai augmenté de moitié les doses et les pommes étaient tout juste recouvertes, de plus comme d''autres, je pense qu''il faudrait ajouter un parfum. ', '2013-12-17T10:20:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, c2c983f4-5327-4377-b827-29f37d41b477, 'Bon', '2013-08-25T15:59:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 7983cb32-1ee4-448d-b766-45fba51159d1, 'Très bonne recette, tout le monde a aimé. Mon petit plus: j''ai fait un caramel pour accompagner ce délicieux dessert, très bon mariage, hummmmmm.', '2013-04-09T18:06:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 237d2b80-9716-4281-a904-77385a538e09, 'Essayer, c''est l''adopter on s''est régalé. Très bonne recette, à faire et à refaire.', '2013-03-02T17:49:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 7be70c20-4f43-4683-96c2-18abfce25690, 'Tout le monde a adoré !!! J''ai apporté quelques modifications : 80 g de sucre + 1 sachet de sucre vanillé, j''ai ajouté un bouchon de rhum dans la pâte et j''ai fait la moitié du gâteau avec des kiwis... Excellent, vraiment bonne recette... Je la referai sans problème.', '2012-06-15T19:57:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 47225c4e-a3e1-4c1f-9a5d-4cb34793d803, 'Moi je le refais ce soir pour le dessert toute ma petite famille l''a adoré  ', '2012-01-04T16:07:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, daf92d83-1a89-4c27-b494-ee337faace96, 'Je viens d''essayer la recette et je suis ravie, c''est vraiment bon et moelleux ! Cela fera un super dessert ainsi qu''un 4 heures !', '2011-12-16T19:30:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, d3c13818-2caa-41bf-a8ff-5aab22a4cbaa, 'Super gâteau, il est léger et super facile à faire ! Moi je le fais tous les dimanches, et il passe très bien auprès de tous. J''ajoute du rhum dans la pâte et je présente les pommes en moitiés coupées en lamelles, posées au fond du plat. En plus d''être bon il est léger. Alors pourquoi s''en priver !', '2011-12-13T11:58:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 9b316395-1cdf-4369-a687-c74b72f25c30, 'J''ai réalisé ce gâteau hier pour mon fils et mon mari, moi qui ne suis pas douée en pâtisserie, et bien la franchement je me suis épatée, et de plus mes hommes se sont régalés, et moi aussi. fondant, du goût, bref rien à dire, extra !', '2011-11-27T13:45:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 3cd33705-86eb-4ed0-918f-b8a13b106314, 'Très bonne recette mais la prochaine fois je mettrais moins de sucre et je complèterais avec du sucre vanille.', '2011-10-06T23:42:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 039b8894-347c-4f68-8492-a2d57b78936b, 'Excellent recette, j''ai suivi la recette à la lettre et il n''y a rien à dire... gâteau léger, fondant et sucré comme il faut... j''adore. ', '2011-10-05T18:53:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 890737be-7ecd-460d-bb28-605ea6bcf2f3, 'Excellente recette, je l''ai gardé précieusement, à refaire sans hésitation. Un grand merci.', '2011-09-18T14:03:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 01b4b4ca-8359-4ba3-8b85-23d422b22632, 'Trop bon, c''est parti en 1,2,3.... Je garde précieusement cette recette bien rapide et facile à faire en plus !', '2011-09-09T23:13:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 076c6bd6-22f2-4ddc-be8d-945c07b106e3, 'Je l''ai réalisé dans un moule rectangulaire de la taille conseillée mais je crois que c''était trop grand, j''ai superposé mes pommes, mais du coup elles n''étaient pas recouvertes de pâte. Le gâteau était très joli mais pas fondant comme il aurait dû, la prochaine fois je mettrai les pommes en premier.', '2009-06-03T14:36:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 54179081-cfd9-4ff0-b2ee-05d1f2fffae1, 'Fondant réalisé hier, sans rien changer à la recette, avec des pommes "antarès". Comme nous ne sommes que 2, nous l''avons fini ce jour et, surprise, il était encore meilleur! Merci pour cette recette.', '2008-10-05T20:25:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 7e5d9f4b-45b8-4fba-a343-0859ada39c09, 'C''est une bonne recette facile à faire et très moelleuse. Tout le monde adore. Il n''y a jamais de restes !', '2008-04-12T19:10:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 1445d199-f959-468f-b201-fc38c4679693, 'J''ai fait 2 x la recette en mettant 100 g de sucre blanc et 100 g de sucre de canne, j''ai haché les pommes en faisant la pâte et rajouté 1 pomme en lamelles au dessus...c''est délicieux tout est parti en un goûter...j''esperai en avoir un peu comme dessert ....il ne reste plus qu''à en refaire.', '2007-10-10T17:55:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 8f8a0511-c113-4a1b-9b42-dce0ae059277, 'Pour ma part, je vais revoir le temps de cuisson, 35 minutes me paraissent un peu trop long, je pense que 25 minutes suffisent, il était fondant au milieu mais un peu sec sur les bords. J''ai également rajouter rhum et vanille liquide.', '2007-07-09T14:42:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 2e46d4e1-62a7-42ec-9321-8678ecdbc6a9, 'Excellente recette, très rapide à faire. Je le fais souvent pour mes amis.', '2007-05-20T13:15:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, c9f3a62c-3b9b-4671-94a6-3814c4092614, 'Vraiment très fondant et très bon, à refaire !', '2007-02-17T20:06:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 59fc1556-ac18-4424-9a9f-f78314c1fa19, 'Absolumenent délicieux, a remporté un grand succès.', '2007-02-08T14:17:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 1eaaa724-017f-4735-a035-dc0f4f505ad8, 'Excellente recette, simple, rapide et délicieuse!!Je l''ai saupoudré d''1 sachet de sucre vanillé à la sortie du four et il a fait l''unanimité.', '2006-12-28T10:51:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, b80b461c-452d-4677-a931-f58072f1c7cd, 'C''est en effet assez bon. J''ai fait macérer les pommes dans du calvados (et un peu de sucre), car j''avais mis des golden (peu sucrées) et j''ai saupoudré de sucre à la sortie du four.', '2006-04-22T09:54:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 62edfa1a-2095-45f4-a510-d4f9a3a6c995, 'Très bon. Le côté fondant ne vient pas du gâteau lui-même, mais des pommes qui fondent à chaque bouchée...', '2006-04-18T02:34:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, f4fad7fb-af36-421c-9434-8832fb5bec9c, 'Vraiment très délicieux, succulent! ', '2006-04-11T01:08:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, d6ea1d69-4013-4387-8404-fe5db60d3587, 'Un peu déçue par le côté "pâteux" et fade de ce gâteau malgré quelques gouttes d''arôme de vanille.', '2006-04-04T13:27:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 4c8c611b-1db2-434a-8253-0520282bc083, 'La recette est délicieuse. J''ai mis un peu plus de pommes et de crème liquide (en supprimant le lait). C''est fondant et frais. Mon mari qui n''est pas féru de dessert a adoré!', '2006-04-01T11:46:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, ac26cc80-f780-43f1-8895-154b1cecd61b, 'Délicieux! J''avais mis un peu moins de sucre que prévu, et c''était parfait. Sans moule carré, j''avais mis le tout dans un moule à cake. Je vous conseille le mélange pommes et poires!', '2006-03-16T10:31:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 72503ee8-c227-4b3b-a093-1a31f30540eb, 'Très bon! Facile à réaliser et très convivial. J''ai mis 4 pommes que j''ai coupées en petits morceaux et je les ai directement mélangés à la pâte avant de mettre le tout dans le plat allant au four.', '2006-03-05T14:54:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 9ab3f398-691b-4e4c-be5d-7a69642561e3, 'Parfait, délicieux et les proportions sont parfaites ainsi que le temps de cuisson: très bon avec des pommes reinettes et chanteclerc.', '2006-02-20T22:06:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 1ac7a7be-eb57-4f51-997b-e419a7b79c3b, 'Merci de cette recette très facile et économique!Beaucoup de succès auprès des gourmands! Les pommes sont fondantes. Un peu de cannelle en plus pour ceux qui aiment. A refaire bien sûr!', '2006-02-18T21:04:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, dc308e09-5a66-4fcf-b09a-3eac91b19d4d, 'Bon gâteau mais un peu trop commun.', '2006-02-12T13:12:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 60442aa3-9d6c-48a2-b44e-8b3b59dc39bf, 'Vraiment excellent, même le lendemain.', '2006-02-11T22:35:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 54bd9adb-2335-4885-ae80-1a694dd69514, 'Très bon avec une cuillérée de rhum.', '2006-02-02T12:02:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, bbb23da8-14e7-4de3-a4a9-c7b207a959d7, 'Super bon, léger, ne pas lésiner sur les pommes.', '2006-01-21T12:19:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 30cadcf0-80d0-4c53-919a-fe90bdd45833, 'Moelleux plutot que fondant, j''ai mis 30 cl de crème fleurette et pas de lait, et de la fleur d''oranger, très bon!!', '2005-12-13T14:32:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, a145d7d1-56ca-4f40-824c-f0452ab520db, 'C''est le gâteau que je fais le plus souvent, et mon mari le réclame toujours, moi aussi! J''y rajoute un peu du calvados, c''est plus fin.', '2005-12-08T22:21:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 0e76f06c-ec31-4c3b-802a-b82ed4c7db8f, 'Délicieux!! Je le fais souvent, et il est toujours aussi bon!!!! ', '2005-12-03T14:33:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 4f8a5e12-e8f5-4d11-a6b4-f46282224c30, 'C''est très bon et très léger. Comme l''une des internautes, j''ai mis un peu de calvados sur les tranches de pommes et j''ai battu les blancs en neige.  ', '2005-11-29T14:33:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, a9322362-38f6-4192-9945-c022078d2bf6, 'Avec un peu de cannelle dans la préparation, très bon gâteau au pommes...', '2005-11-29T14:12:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, 935010b3-8267-466c-b815-38b4b82e3d62, 'Très moelleux et délicieux... Mes collègues ont adorés!', '2005-11-28T12:34:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, d8031114-386d-43ed-83a2-a4054299b3b9, 'J''aurais plutôt dit moelleux que fondant, mais très bon en tout cas, avec un peu de canelle et une goutte de rhum !', '2005-11-20T18:31:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26866, d740bcec-f695-4295-9eeb-7afc6d9b5b42, 'Très bon, très simple et très rapide. Ce dessert me fait vaguement penser à la "flognarde" que faisait ma maman... Une sorte de grosse crêpe fourrée aux pommes ou aux poires, miam!', '2005-11-20T17:12:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, 24390e85-1b80-41a5-a1af-ce4b30bbc770, 'Une tuerie 😋', '2023-06-10T19:35:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, c188495a-eb91-480c-9bc4-9ffcc14042b4, 'Parfaite ! Je l''ai intégrée à une charlotte aux fraises, simplement en l''ajoutant à mes biscuits trempés dans un sirop de fraises et en incorporant des fruits frais par couches. Délicieux.', '2015-07-16T04:41:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, 46a8189f-1855-4973-8469-b9527e1f45b5, 'C’est vraiment délicieux, je n’ai pas eu d’eau au fond de ma verrine, peut-être du à la variété de fraises ? À refaire sans hésiter, merci ', '2023-04-23T14:00:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, 8cd78616-38ad-4e8b-8b5e-bfd418a24957, 'Super recette ', '2021-06-25T11:25:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, ae7b1a52-6173-46dd-890b-30d461b623e4, 'Recette au top qui a ravi mes convives ! Les vérines n''avaient pas de liquide au fond mais le pot (contenant de la mousse que j''avais en trop) s''est retrouvé avec du liquide au fond, je ne sais pas trop pourquoi.', '2020-12-01T15:46:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, a44beaa5-6c0a-403e-978c-a610d4b5effa, 'j''ai réalisé la mousse de fraises pour la première fois, et c''est un véritable succès', '2020-04-20T12:19:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, bfe56335-2feb-43e5-86fa-0548a685cf93, 'Super recette, réalisée à plusieurs reprises avec fraises ou framboises. C''est toujours un régal', '2019-08-16T04:04:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, e6b361ab-cfff-4d12-a174-32efec750b74, 'Réalisée sans aménagement, elle est restée liquide au fond des verrines...', '2018-08-09T23:52:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, b239ce00-a339-449e-a4c1-d1debc558f54, 'Franchement très facile à faire  Dessert a refaire  Merci pour la recette ', '2017-06-01T16:58:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, ee9e6560-bd9e-4a19-9c56-eba1b88e6cc4, 'Délicieuse et déjà réclamée. J''ai placé des cookies au chocolat, émietté dans le fond et au dessus. J''ai néanmoins eu un peu de liquide dans le fond, je passerai les fruits au chinois la prochaine fois. Merci pour cette recette.', '2016-07-26T12:27:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, 3e773ba0-7de2-4e5d-a086-df24de7661e9, 'Recette très fraîche mais qui manquait un peu de sucre.', '2016-06-10T08:05:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, 357323ff-e742-4d6b-9ba8-3b5e2647fae8, 'Vraiment frais et excellent. J''ai mis 4 blancs d''oeufs pour une texture plus aérée et il n''y avait pas de jus au fond. Parfait pour le dessert en été.  Je suis sûr qu''avec d''autres fruits c''est réalisable !', '2016-04-16T17:15:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, c04f64af-2ed7-40be-a1b5-6836c7ec44b9, 'Très bonne recette rafraîchissante. Je mets aussi des spéculoos dans le fond de la verrine ainsi qu''au dessus en déco avec des fruits.', '2016-04-10T22:16:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, 956422fb-09c3-46d0-8e58-5aa7ae2829f1, 'Recette suivie à la lettre mais pas convaincue : réalisée la veille pour le lendemain, de l''eau (des fraises ou blanc retombé ?) s''était formée au fond des verrines. Pas vraiment esthétique et pas agréable en bouche.', '2015-06-24T16:17:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, 5f30ba0c-badc-4466-990f-bf8f64626709, 'Mousse très aérée et excellente ', '2015-05-13T09:15:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, f9c576d7-1b80-499c-9c4a-4ddf05f16a97, 'Très bon dessert. J''ai émietté des spéculoos au fond de la verrine.', '2014-07-24T19:16:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, c346c767-e71e-497a-8bb3-15c173b7ee58, 'Super recette de mousse à la fraise ! Elle est vraiment excellente et en plus super simple à réaliser ! ', '2014-06-13T23:59:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, 1601bb6e-aec4-4b60-bd8c-4fd7873497a3, 'Dessert réalisé après un plat unique (paella). Succès et compliments au RDV ! A refaire sans hésiter...', '2014-03-30T23:22:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, 4e18bffe-62f1-44f8-bf19-0042f2af7da6, 'Très bien. J''ai fait 2 fois avec environ 400/500g de fruits rouges et 225g de mascarpone et 3 blanc d''oeufs.', '2014-01-19T00:25:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, fd76c785-2243-4c79-a99b-c18a8ef10fa5, 'Une mousse super onctueuse et aérienne avec ce qu il faut de sucre ! je l''ai faite à l''occasion d''un souper grillade entre amis, tout le monde a adoré ! À refaire sans hésiter... merci pour cette recette ! ', '2013-07-03T15:05:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, d889c760-a6ff-4992-a5db-d48db8142422, 'Super facile et très frais. J''ajoute quelques framboises pour un peu plus de caractère.', '2013-04-04T22:57:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, d9bad261-f39c-4be4-88b1-6360c11e9cd1, 'On s''en lèche encore les babines !', '2013-03-11T15:57:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, 36d4973b-f043-4be7-a211-9be10b73abbf, 'Très bonne recette. avec les fraises, j''ai mis un peu moins de mascarpone, si non c''est un peu trop doux. par contre, je l''ai refait avec des framboises au lieu des fraises, sans changer la mascarpone cette fois, un vrai délice. A faire et refaire. ', '2012-07-23T19:46:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, 5ec28b0f-6174-4ae0-93d0-4ec727eec53a, 'Pour ma part, j''incorpore les jaunes d''oeuf au sucre et au mascarpone. Sinon dessert très agréable.', '2012-07-07T15:01:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, f0cc226a-b356-4aa8-a6b6-67606cc7eee4, 'C''est un vrai régal et en plus une mousse légère !!!', '2012-06-14T11:44:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, b44f9f2b-d2c4-41b3-86ae-f69f87be5458, 'Léger, délicieux', '2012-05-17T00:40:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, b41cfcc6-da91-496c-9f26-aef42e81a441, 'Très bon, mais ça serait encore meilleur en ajoutant des morceaux de fraises et peut-etre une feuille de menthe.', '2012-05-06T01:09:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, 1905e91d-901a-4252-8b56-141756c5648e, 'Pas mal, en plus c''est super rapide !', '2011-10-03T18:16:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212970, fcb07647-7c26-4a27-bd15-a8946283abfd, 'Absolument délicieux !!! A préparer le jour même, ou la veille, mais pas plus tôt, car la préparation rends du jus.', '2011-09-23T17:17:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, cfb77de0-b3f3-4ed7-baf7-697a5d650a23, 'Chez nous, on n''a pas aimé le mélange d''épices avec les fruits. La menthe fraîche aurait déjà été bien assez. ', '2016-04-17T14:53:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 67b44cd5-02b3-483d-a3ea-0d4fda286cd1, 'J''ai diminué la quantité de fraises. Avec de la mangue bien mûre, et de la menthe bien fraîche, c''est un délice.', '2015-05-30T10:58:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 19d971c7-2946-4911-821a-6039e6a195e7, 'Il manque pour cette recette les quantités en matière d''épices. En effet, il est difficile de juger sur les proportions et cela peut devenir trop relevé. Sinon, le mélange Frais-Mangue s''accorde très bien.', '2015-05-30T10:53:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, de3d09e3-a98e-4c5d-b1dc-6ff8320f8b9e, 'J''ai mangé plusieurs fois de la salade de fruits fraises, mangues. Cette version épicée est très bien et à été appréciée de mes invités.', '2014-07-26T13:18:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 371e219d-792b-48e3-856a-8e0dcdd7172f, 'Super recette !! C''est un vrai dessert !! Facile et rapide... Faite et à refaire Trop trop bon. Merci', '2012-09-24T19:16:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 00516acf-922f-44ab-ab9e-1081e61c8655, 'Que c''est bon ! Et pourtant je n''avais plus de cannelle, et j''ai oublié la menthe ! A refaire !', '2012-06-17T22:53:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 4f3b8601-a58b-446d-a4da-414c32caeced, 'Très bon, j''avais pas de menthe et j''ai mis de la coriandre à la place avec de l''ananas en plus. Tout le monde s''est régalé.', '2012-02-04T21:03:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, ace190a6-8b0b-4ca1-b337-06ae4722f8ed, 'Très bon à mettre au frais ', '2011-12-07T00:41:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 6c62550b-ad42-4b93-b7a6-3ea08d957515, 'Très bon et très frais. Effectivement ne pas hésiter à réajuster l''assaisonnement en dernière minute.', '2010-11-28T14:02:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 249e0448-2da8-4ffc-8afa-1af06f491247, 'J''ai dosé les épices dans le jus d''orange, ça me semblait assez relevé mais lors de la "dégustation", on ne sentait pas du tout le goût épicé. C''était une banale salade fraises-mangues. Comme il en restait, j''ai ré-épicé (poivre / gingembre / 4 épices), c''était nettement meilleur.  Conclusion : comme pour les autres "plats", on peut ajuster l''assaisonnement à la dernière minute :-)', '2009-05-10T17:16:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, d565515d-2c12-439a-84bb-1ad4a4820e74, 'Le jus d''une seule orange ne suffit pas, j''en ai mis deux et c''était juste....', '2008-06-23T20:56:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 21742b81-8995-4b41-85c4-48dbdf2b55b2, 'Excellente recette, très parfumée. J''ai remplacé les fraises par des framboises et des myrtilles (de mon jardin) et le poivre par du poivre de Sichuan. J''ai servi cette salade avec une boule de glace vanille. A refaire.', '2007-11-04T14:29:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, ab29b60b-f0ad-4dce-81ca-334b345434e7, 'Extrêmement BON!!! attention aux eéices, soyez raisonnable lors du dosage du gingembre cannelle et poivre... Peu d''épices suffisent pour parfumer très fort.', '2007-05-27T11:34:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, a98bb0d0-0dd4-468c-99a8-697a8f4b4ae0, 'Délicieux : surprenant, frais, classe...', '2007-04-16T22:28:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 60a41c0b-3ce1-4d10-a96b-dd8d6aea1801, 'Hou là que c''est bon...Facile à faire mais d''une saveur incomparable! J''avais des oranges sanguines et ai utilisé le jus... Bien "épicée", relevée sans excés mais si délicieuse ! Bravo et merci..', '2007-03-20T13:06:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 0a398fe5-4844-416e-a94e-242bd17e296c, 'Cette salade est très bonne et très fraîche, et les épices se marient très bien au tout. Pour le poivre j''ai mis du 5 baies, sauf que j''ai eu la main un peu lourde!', '2007-03-15T10:46:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, cf5a43aa-1dfa-46d6-b8fe-5fca7f47a4c2, 'Ce dessert est excellent ! En y ajoutant une boule de glace à la crème et quelques litchis (décoration et/ou accompagnement), c''est un vrai délice...  ', '2006-07-01T17:45:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 47d07363-7ae8-4a56-9610-d1635552ef20, 'Super bon! Moi qui adore les fraises ET les mangues, qui se mariaient très bien avec le goût subtil du sirop épicé.', '2006-05-21T01:17:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 4e05ff68-f77b-4da4-81b8-c1ea1dec64dd, 'Frais, facile, léger et original... Et en plus excellent... Merci!', '2006-04-08T02:29:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, fd5b7460-d2be-4e54-8aa2-9f3c0ec3ebcb, 'Simple et bon. Dessert léger et facile à faire, qui sort un peu de l''ordinaire sans trop.', '2006-03-07T22:58:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 5c0ec94e-7f77-4cc0-b82a-bad3eb7c9841, 'Très bonne salade de fruits, très jolie à présenter.  A adapter selon le goût de chacun pour les épices, c''est bon même si on en met peu.', '2005-09-04T11:54:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 26e90f28-3662-4eb7-9e4c-772f9543ff62, 'Très fraîche, mais mieux vaut la laisser quelques heures au frigo que 30 min. ', '2005-07-14T13:15:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 72115740-59c7-4dd2-b5bf-156bb9cfdd86, 'Délicieux et très rafraichissant. Ne pas hésiter à la faire plusieurs heures à l''avance c''est encore meilleur.', '2005-06-29T13:59:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, e0f4e19b-85a6-40cf-b6fe-277ca5429193, 'Très bien, frais et original, ça a eu beaucoup de succès. J''avais peur que ça manque un peu de sucre, mais non...J''ai servi avec du nougat glacé et ça se marie bien.  ', '2005-06-22T01:46:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 355931d2-3cc1-42ac-b53b-5ea91e03037f, 'Recette très agréable pour une salade de fraises originale. Elle est trés appréciée par mes amis, servie avec des boudoirs rémois...MERCI pour toute vos recettes!', '2005-05-22T19:56:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 0d76e8a6-2138-4b08-9d19-120b2a0a21bd, 'Délicieux et frais, très original...Le mariage avec les épices est une réussite, bien que je n''avais pas de gingembre.      ', '2005-05-07T16:38:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27980, 61fc7df9-2731-4171-adcd-b460189fed3c, 'Très bon. La mangue et la fraise font un heureux mariage, relevé par les épices. De plus, c''est beau et léger!', '2004-05-05T17:30:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, a9f6eab3-5b8a-42c1-b68e-45fd9c50a8b7, 'Au secours !!!! A cause des framboises congelées, on aurait pu manger ma tarte à la paille !!! Le goût était top mais la présentation ne l''était pas !', '2013-03-11T13:29:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 86e8efad-bebc-4007-a66e-233779dd26c7, 'Malheureusement: 20 min à 180°= pate trop cuite (cuisinière à gaz)', '2023-11-24T16:56:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 09cc5968-a09f-4855-9661-2bb107abff27, 'Super recette!!', '2021-04-17T19:49:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 5d3e0a39-4b81-4a79-ad33-f169cc90bdf5, 'Malheureusement la crème pâtissière en-dessous des framboise était toute granuleuse et vraiment pas agréable à manger !', '2018-06-16T05:03:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, b1034527-c320-47b5-906a-0b2c9304bdd4, 'Super bon et super facile parfait pour un dessert rapide et délicieux !', '2018-05-08T16:14:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, a2ef31b9-c5e0-409c-bc4e-b9f2a8c7cc26, 'Super facile super bon et super rapide !
Un dessert parfait pour les occasions ou on a pas d''idée de dessert ;
simple et délicieux ! Mais pour la crème sous les framboise j''ai pas eut besoin de remuer, ça prend plus vite.', '2018-05-08T04:19:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, a88271be-f909-42b5-a4f1-c712bc50b940, 'Recette excellente, très facile à faire, très belle présentation. Tout le monde s''est régalé. Merci.', '2011-09-17T01:00:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, d9829cc8-d1bc-4ccf-ba1b-fa2cf9e2542e, 'La pâte est restée maleureusement molle, impossible de découper les parts! Dommage!', '2006-06-12T18:48:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 382c84fe-773c-40ef-a238-70553a6f878e, 'Cette tarte est très facile à réaliser et ce en peu de temps! C''est génial et délicieux, merci! ', '2006-02-04T19:00:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, dbc67457-0b6d-4af7-b96c-d0cbdfc69791, 'Rajouté un peu de farine car la crème n epaississait pas. Consistance à peu  près correcte mais goût très neutre pour ne pas dire fade. ', '2023-10-07T14:59:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 2f7b327d-37ec-4d5e-ad90-1b10cb91caf2, 'Excellente recette, facile à faire, et en plus moi je préfère la crème pâtissière à celle que l’on fait parfois aux amandes ! Donc tout va bien !', '2023-08-18T17:10:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 7c850cdc-cadf-42fb-b6f2-ef8e80a84063, 'Très facile à réaliser et très bonne recette. Je l''ai faite plusieurs fois pour des invités.', '2022-11-18T15:49:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, d1394ef2-335c-40bd-8507-519feab28627, 'Très bonne tarte, facile à faire avec les enfants.', '2022-06-26T15:47:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 9430c815-d82f-4f44-af05-c6a3539ab0ec, 'Bonne recette très facile a faire', '2021-09-30T19:50:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, a4e977b2-9630-4d3d-8381-6b7d9cfb0f5a, 'J''ai fait une petite variante, moitié fraise et moitié framboise, mais sinon c''est la recette de base avec la pâte brisée maison ', '2021-08-28T13:22:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, d73e8f40-2a73-4c77-b5e0-7c5644e37d46, 'Très bonne recette.  Tout le monde a apprécié.
Merci pour ce partage.', '2021-06-24T00:48:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 3dae5ea9-d792-4162-af2c-11597e25b025, 'Tarte faite pour la première fois pour l''anniversaire de mon grand ! Parfait, rien à redire tout le monde a adoré.. . A refaire sans modération ?', '2021-02-27T12:32:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, e5b987e6-9c9e-4647-9917-0769c8ad27e2, 'Super bon !!!', '2021-02-08T19:03:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 258dbb2e-602f-4f8e-94a2-1faf5b9b4943, 'Excellent !', '2020-09-12T16:55:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, debd344c-2586-4cf9-93fa-e4d098fa96bc, 'vraiment délicieuse et simple a faire.  
régal des petits et des grands. ', '2020-04-14T06:58:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, f5b3e2ce-f697-419e-a5a3-b384e9dde4af, 'très bien. J''ai juste ajouté 50 g de poudre d''amandes. Merci', '2020-04-12T20:37:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 6c5d4ceb-98f9-43b0-b049-14a2f89f1fba, 'Très bonne recette, j’ai remplacé la pâte brisée par une pâte sablée maison, super résultat.', '2019-08-25T08:39:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, e5f7d629-a3c6-443e-978b-e9ccde695902, 'Génial pour une première fois ! La pâte devient un peu molle à la fin mais vraiment excellent ❤️', '2019-06-15T03:06:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 68a509d0-c053-4919-a40a-6eeaaa0cb40d, 'Tout le monde en raffole !!
Bravo à sandrine_1046', '2018-02-25T12:35:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 785e320a-6eeb-45ed-af6f-e09953632ab2, 'Je n''ai pas trop aimé la préparation sous les framboises.  ', '2014-09-13T16:37:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 4bf3c3cc-f798-413a-80a2-0aa97a64985a, 'Simple, délicieux, je suis d''ailleurs en train d''en refaire une ! J''ajoute un peu de poudre d''amande, et du mascarpone dans le lait, mais c''est pour le vice.  Pour info : l''appareil convient pour un moule à tarte grand format (diamètre 30cm), pour un moule de diamètre 26, il en reste beaucoup (conseil : refaire une autre tarte le lendemain, hehe...)', '2013-10-28T19:07:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 384cf1bb-1a26-42af-99bf-5309f5303ad5, 'Je l''ai testée avec des framboises fraîches et c''était un délice, je n''ai rien changé, elle est parfaite.', '2012-08-11T17:26:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 1baf36ae-2e5e-49a5-9f32-1dda35939a82, 'Miam, un délice. Facile à faire mais pas vraiment express je trouve. Avec un peu de chantilly, nous avons succombé.', '2011-08-15T13:37:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, ea95b24a-5c14-48a7-919e-f3531f6b7886, 'Très rapide, très facile, très frais et surtout très bon!', '2008-05-12T22:30:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, ec7cac66-fdec-4775-904e-a08d20fa68ce, 'Super rapide, et en plus c''est délicieux. J''utilise ainsi les framboises du jardin, que je congèle en partie, le reste en coulis.', '2007-07-08T12:11:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, df2f9b7b-4e17-4d79-b1cc-80f2f8bdd1a9, 'C''était vraiment délicieux ! je ne pensais pas réussir une si bonne tarte avec des framboises congelées. A refaire.', '2007-02-19T14:36:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 0e63f2d1-5cc4-41be-8d77-fb5b6f72451a, 'Facile à realiser et très bon à déguster. Vite fait quand des invité imprévus arrivent.', '2006-09-28T15:35:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, a66dd8db-6016-47aa-ae61-a8a7bc3eb0b0, 'Tarte rapide à préparer et à manger! Nous nous sommes régalé. J''ai attendu que la pâte soit bien froide avant de déposer la crème et je n''ai eu aucun souci pour servir les parts.', '2006-07-11T00:03:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40829, 9524d022-6313-4360-9431-367722b6b528, 'J''ai essayé cette recette: elle est super bonne et facile à réaliser.', '2006-07-08T19:46:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, 218721bb-a930-44e7-b484-0fbff1b92cee, 'Très bon  j''ai juste rajouté un yaourt au lait de coco nature pour donner de l''onctuosité et casser l''acidité ', '2023-06-14T14:28:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, de81ca78-0c5f-44f3-a7e6-231eb9f48767, 'Très bon mais ne pas mettre de citron (trop acide)', '2022-05-06T14:17:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, c79a29ef-9a71-4f67-af65-c59b490b4d2c, 'Facile, frais, délicieux ', '2020-04-20T15:52:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, 60cea572-b9c9-4ceb-b369-78cd1567e332, 'DÉlicieux et Rafraîchissant .?', '2020-04-10T15:20:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, 786f27bb-d49b-4bc4-a79e-14d39fd3ed24, 'Recette très sympa, goût excellent, mais préparation un peu trop épaisse. J''ai ajouté des glaçons et un peu d''eau en plus.', '2019-09-01T12:14:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, 63ef509f-d5ce-42b4-85f3-0591f56aac91, 'J''ai ajouté une poire et des glaçons. Excellent, merci pour la recette', '2019-06-27T18:06:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, 753bad7e-d7e4-4c0b-8f47-df41bda34c70, 'J''ai doublé les quantités pour 2 personnes. Le jus de citron frais  apporte vraiment ! Un yaourt et 30 minutes au congélateur.  Excellent ! ', '2019-04-27T12:26:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, fae71c85-d70d-4871-a3f5-d833fe1c6811, 'Jai rajouté un yaourt et c''est top ! Bonne recette ', '2017-05-08T10:56:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, 4074de1c-4574-4d5b-b507-5f995fd3562f, 'Pas de fraise mais j''ai suivi la recette quand même très bon ! Pour donner un coup de frais, j''ai mis 10 petite minutes au congélateur ! ', '2017-03-23T21:00:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, eaf6adc6-9aed-4116-94cb-b30375c63454, 'Juste excellent ! Un vrai régal ! ', '2016-05-26T10:52:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 85362983-e96b-4cfc-be13-a508af744138, 'J''ai mis 50 g de sucre en moins et remplacé l''eau par du lait. Après 25 min de cuisson, c''était encore tout liquide ! J''ai augmenté à 180°C et prolongé 15 minutes. C''était parfait ! Recette moelleuse, les fruits amènent de la fraîcheur. Délicieux !', '2018-11-21T13:05:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, b1004ac4-366b-4904-9ed7-da068e9b0e19, 'Je n''ai même pas eu le temps d''y goûter !! Moins de sucre 120 g et 1 sachet de sucre vanillé + de la cannelle et des pépites de chocolat et laissé 5 mn dans le four après l''avoir éteint. Un délice paraît - il et hyper facile à réaliser pour faire plaisir à toute la famille. ', '2014-11-12T15:37:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 88ba82f2-e654-43b6-aa07-12ab1e0fe3b0, 'Très bon et très moelleux. Avec 80g de sucre et un sachet de sucre vanillé', '2014-04-13T00:21:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 9284c815-1867-4b47-ac21-8f9f9014fc2d, 'Excellent !!! Fondant ! J''ai fait un carton avec mes invités! Par contre je l''ai mis cuire 45 min à 180°C c''était parfait !!!', '2008-10-26T19:01:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, d6ce241a-502a-4247-804b-1e19498ec799, 'Super moelleux avec quand meme un peu moins de sucre!!!', '2023-10-31T00:32:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 1516f8dc-97ce-4625-aa20-a652832c2352, 'Gâteau 🍰 très bon, et vite fait 👍 on a adoré, j''ai rajouté des pépites de chocolat', '2023-04-30T11:55:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 95725156-4e4f-403d-92fa-1c96471def98, 'Excellente recette ! Nous avons adoré !', '2022-10-22T17:04:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, a2fbadf8-fd46-4d0b-876c-fc067d978b60, 'Très bon gâteau moelleux et léger, les bords sont croustillants. J''ai juste saupoudrer de sucre vanillé le dessus et allongé le temps de cuisson parce que mon moule est petit et profond. ', '2021-03-27T09:39:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, d68663e6-1ab0-4cd3-bd61-139a4f09375c, 'Il faut en effet augmenter le temps de cuisson et la température. Je recevais des invités ce jour là et j''ai eu une frayeur quand j''ai constaté que la pâte était encore liquide au bout des 25 mn. Fait avec 2 pommes et 2 poires tout le monde a aimé ce gâteau rafraichissant. Merci.', '2019-10-13T16:10:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, af791ea8-48cd-462c-8f4d-7bc5297aa41b, 'Avec 110 de sucre et un sachet de sucre vanillé, et aussi les 2cs d’eau ont été remplacés par 2cs de yaourt nature... c’était parfait !', '2018-05-08T08:15:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 8c44648d-8e71-4434-bd7a-e35e11d49ce1, 'Bon gâteau, réalisé avec des pommes et des poires, mais je l''ai trouvé un peu sec. La prochaine fois, j''essaierai de l''arroser avec un sirop après la cuisson.', '2018-04-24T05:39:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, dcaa0e3d-3f86-4e5e-ac1a-3ad6c786d4f8, 'Excellent!!! Facile, rapide, moelleux. Trop top !', '2016-10-12T22:11:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 14d9c368-6b7f-4265-b1be-d14c88b1ee09, 'Gâteau excellent. J''ai moi aussi mis de la crème fraîche à la place de l''eau. J''ai ajouté un peu de kirsch, une cuillerée à soupe, et c''était délicieux. ', '2015-11-01T10:26:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 3ef1c29a-0739-4f53-8a79-8b77b25d2715, 'Dessert excellent, tendre, moelleux et léger à la fois... Un pur délice !', '2014-02-08T15:57:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, d7c0d3f6-d3d3-4e10-931f-c5e9e48a560a, 'Gâteau délicieux, super bon ! J''ai mis moins de sucre (150 g) et c''était très bien. Recette à faire et à refaire !', '2013-05-06T23:16:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 6b1b1548-be14-48a3-a50c-7981b4c2d8b2, 'Bonjour. Délicieux gâteau auquel j''ai ajouté 10cl de crème fraiche liquide à la place de l''eau et quelques pétites de chocolat qui se marie à la poire !! Merci', '2013-03-13T22:25:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 917568f0-1f0a-4e30-8929-74ef0f027014, 'Délicieux ! Ne pas lésiner sur les pommes et les poires et pour les gourmands, un glaçage chocolat, miam ! ', '2013-01-12T22:34:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 429e84df-e9ac-4765-a5a1-c1ca2df18c14, 'C''est bon et léger, trop de sucre par contre, j''ajoute un sachet de sucre vanillé pour parfumer ', '2012-09-05T13:15:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, b6713b77-29a4-45f1-aa2f-8207c4d8761a, 'Faire cuire pommes et poires avant dans une poêle. Temps de cuisson doit être allongé. J''ai mis du sucre à la cannelle et des noisettes en poudre sur le dessus.', '2012-01-15T19:49:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 37028613-0550-4f69-a849-843699c1083c, 'Simple comme bonjour, rapide et bon ! Nous avons essayé avec des poires et des raisins secs trempés dans l''eau. Un régal !', '2011-11-16T14:34:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 9025a1ec-7222-422b-81dd-6004ea174397, 'C''est une merveille ce gâteau "inratable", j''ai simplement allégé en sucre (100 gr) largement suffisant sachant que j''y ai mis 2 poires et 2 pommes qui ont un fort pouvoir sucrant. La prochaine fois, je n''y mettrai que 80 gr de sucre. J''ai ajouté un cuillères à soupe de rhum. A faire et à refaire. ', '2011-10-15T12:17:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, c6a00ecb-1a72-4b0f-b5ba-917e2499dfd2, 'Un grand succès. Fondant, moelleux à cœur. Merci !', '2011-09-27T21:08:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 8b2e7455-f5c1-42dd-9c82-09c8c107dce7, 'C''est un excellent gâteau familial. Chez nous on le fait aussi avec des abricots en saison, ou des ananas en boite quand on est pressées, et c''est très bon aussi ! ', '2011-02-06T12:08:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 8474bccf-d341-4e96-a713-aa813e6230de, 'Très bon gâteau ! Par contre, j''ai un peu modifié la recette d''origine : j''ai divisé la quantité de farine par 2 et ai ajouté 100 g de d''amandes en poudre ainsi que de la cannelle. Et je l''ai fait cuire 45 minutes à 180°.', '2009-12-23T13:42:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, cab75dfe-0e77-43d8-8eb6-4cfb8bda8d53, 'Cette recette est pas mal, le gâteau se tient bien et est facile à faire mais même en mélangeant pommes et poires je trouve que cela manque de goût. Pour des enfants pas de souci car cela reste simple pour la gouter mais pour des invités c''est trop simpliste. Je m''attendais à plus... Je confirme que le temps de cuisson est trop court, bien mettre au four 45 mn à 180°.', '2009-04-19T21:28:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 9a35c388-32ee-405b-8d9c-23388f5ed2fa, 'A fait l''unanimité avec des poires ! Cuisson + longue de 20 min. Nous essayerons avec des pommes.', '2008-12-16T12:54:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 7848c454-7c28-425d-822d-ca6fc3c67f7e, 'Délicieux! Je l''ai fait avec des poires et j''ai juste rajouté un peu d''eau de vie. Par contre j''ai dû le cuire 45 min au lieu de 25, dans un four à chaleur tournante.', '2008-09-02T19:40:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 581705a2-c1db-4e0f-9cbe-55a453104306, 'Très bon!', '2008-06-03T18:03:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, a51f6079-4340-44ec-ab3e-6f05c33a5677, 'Facile et très bon, j''ai fait la recette poire et pomme mélangés, un régal !', '2008-05-05T20:09:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, f0f95bb3-adcd-464a-b819-9133f8aeaa7e, 'C''était excellent, j''ai ajouté des raisins secs trempés dans du cognac et prolongé la cuisson, à surveiller, ce gâteau est très moelleux et parfumé; à renouveler. ', '2008-02-15T19:49:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 20aec72f-a5c0-447d-9491-9a37413f90b1, 'Très bon gâteau bien que très éloigné de la recette du gâteau Anna fait par ma maman (mais bon, je ne vais pas vous faire le coup du VRAI gâteau Anna !). J''ai ajouté aux 4 pommes un bol de fruits rouges et laissé cuire 40 min. C''était parfait.', '2007-02-26T16:29:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 25d01090-8187-49c9-ac47-9bd0f7aaa461, 'Délicieusement léger. A ravi tous les invités, les petits comme les grands !', '2007-02-19T20:11:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 1f69a5e5-9498-43ad-a26f-5c77675014c7, 'Très Bon. Effectivement 150 g de sucre suffisent. Merci pour cette recette ayant fait le plaisir de mon fils et mon mari.', '2007-01-08T18:49:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, dea4f2f0-bc14-4c9c-89ee-f1b166b195b7, 'Très bonne recette! J''ai simplement diminué la quantité de sucre à 150g et j''ai mis 150g de farine et 50g de maizena pour plus de légèreté. En ce qui concerne la durée de cuisson j''ai mis 30 min. Merci beaucoup pour cette excellente recette!!!', '2006-09-21T12:39:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 033a341b-7a51-4ab8-87dc-67f2072244f5, 'Gâteau léger et moelleux. Seulement 3 poires suffisent et environ 40 min au four. J''ai également mis moins de sucre.', '2006-06-17T17:05:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, dfd2f084-4f7c-4845-8ced-887b0b7f51ea, 'Super bon, super moelleux. J''ai ajouté un peu de cannelle, c''était délicieux.', '2006-04-09T18:32:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 7eb69352-87a2-4827-8b7b-77e4abf714f2, 'Je me suis dit "encore un gâteau style gâteau au yaourt". Grave erreur, ça n''a rien à voir. Ce gâteau est tout simplement divin de moelleux, pas sec du tout, un bon gros chamallow aux pommes!  Suivre les commentaires précédents pour se régaler : cuire 40 min, et bien mettre la levure.', '2006-04-08T21:51:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 2b7e5326-da5f-45ad-ac25-92e974b5752a, 'Ce gâteau est très moelleux et fondant. Le temps de cuisson est trop court. Nous l''avons laissé 40 min. Nous avons enlevé 50g de sucre, c''est suffisant.', '2006-03-25T17:33:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 369a491d-992b-437e-9120-0333243b2457, 'Ce gâteau est délicieux! Très moelleux, riche en fruits, pas trop gras...Idéal pour les petits goûters ou pour une fin de repas pas trop lourde. J''ai mis moitié pommes moitié poires, les deux se marient vraiment très bien. A refaire, c ''est sûr !!', '2006-03-19T15:56:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, bbcb1493-4d52-4a30-a74c-930cd76eff27, 'Très bon gâteau, moelleux et tendre, sans être trop gras... J''ai eu du mal à le démouler, bien que j''ai suivi à la lettre le conseil de beurrer et de fariner le moule... Aussi, je vous conseille de mettre un rond de papier sulfurisé au fond du plat.', '2006-01-11T14:43:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, fb4090a8-b4f0-488c-af4c-6d1118e38208, 'Bof, rien de transcendant... Il pourrait être meilleur en mélangeant sucre en poudre et sucre glace. En tout cas, 2 jours plus tard, il est tout mou...', '2004-11-16T10:18:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 63d1935f-9d5c-4b46-b901-da38f71e324a, 'Très bon, mais il est vrai que j''ai rallongé le temps de cuisson de 20mn, que je n''ai pas mis la levure et je n''ai mis qu''une pomme et une poire (il faut dire qu''elles étaient de gros calibre aussi!!). J''ai rajouté une pointe de cannelle, ce qui est vraiment un petit plus!! Bon appétit aux gourmands! ;-D', '2004-11-13T11:05:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 4e51c700-5f45-4ec0-bfe1-f83b19da6877, 'Un peu déçu... Dans le genre, il y a mieux!', '2004-11-07T19:11:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 80464016-18df-4600-b8d2-16a4166a4e60, 'Recette formidable, facile et légère. Elle est tout aussi délicieuse en utilisant de la farine de sarrazin et/ou avec des poires.', '2004-10-10T13:35:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 88506925-1afa-4439-818f-6a592a5e1785, 'Gâteau très facile à faire, moelleux et léger. J''ai essayé avec les deux fruits, le goût de la poire ressort très bien. C''est très bon, toute la famille a adoré, j''en referai!', '2004-10-06T13:19:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, b8137c0b-6868-479d-9157-b489a6c9962f, 'Délicieux, c''est exactement la recette que je recherchais mais j''ai augmenté le temps de cuisson de 20 mn et monté le th à 175° en 2ème partie de cuisson car au milieu la pâte n''avait pas pris (il faut dire que mon moule était assez haut). Merci encore pour la recette.', '2004-09-14T11:58:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 775690a0-cce2-4acb-8176-b0fded2fdbfd, 'Excellent, mais je l''ai fait cuire 40 minutes.', '2004-09-06T21:56:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, ac54d104-fc57-46c8-b10f-4ecf223cd55d, 'Délicieux! La prochaine fois, j''essaierai tout de même de mettre moins de sucre.', '2004-08-15T22:56:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 970c4303-c8c6-4fe0-a167-9051951c09eb, 'Très bon, mais à ne pas réchauffer...', '2004-06-04T21:30:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 8ab8deee-d3c0-4e95-9de6-889ed5e6d3f3, 'C''était excellent! Je l''ai déjà fait 2 fois...', '2004-04-19T20:11:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 4543cb31-989a-4561-9a55-124a7b059c0a, 'Super bon!', '2004-03-12T23:18:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 7bacc499-128d-4d2b-aca3-20286a94914c, 'Très bon. Il a plu à tout le monde, allez j''en refais un !!!', '2004-02-28T17:40:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 1893791a-e1d1-4948-9d52-a312c425ef9d, 'Excellent! j''ai suivi respectueusement la recette et c''était parfait.', '2004-02-18T04:54:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 130db4ea-59cd-41ee-ae0a-0502429fdf36, 'Délicieux, mais après cuisson, laisser reposer une nuit pour ne le manger que le lendemain. Tendre et moelleux, un délice pour vos invités!', '2004-02-15T14:45:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 249e9c6e-0b51-42d9-b2e0-c9ca5a01eda8, 'J''ai essayé le gâteau mais comme j''étais un peu distraite, je n ai pas remarqué qu''il n''y avait plus aucume mention de la levure dans l''intitulé de la préparation: du coup, cela donne un gâteau qui ressemble à un clafoutis. Mais c''est bon quand même!', '2004-02-11T20:22:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 83a6adaf-c0b4-4bdc-80cf-ec23d78b3e9e, 'Très bon gâteau, très simple à faire pour le goûter des enfants et des adultes...', '2004-01-17T14:59:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, c2d67f67-ba44-4719-a49f-7b224fab03d1, 'Super, j''ai même cassé les oeufs pour la première fois. Yanis (4 ans).', '2003-12-30T20:59:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, d0981a9a-c25a-405a-91c1-f5a856724d7e, 'Ta grand-mère Suzanne a surement le même livre de cuisine que ma mère, j''ai exactement la même recette du gateau Anna chez moi, qui date de quand j''habitais encore chez mes parents. Néanmoins c''est un très bon gâteau.', '2003-11-12T22:41:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25545, 1b284921-c4b1-4093-99b5-b1fab8d73815, 'Facile et vite fait. Réussite totale, de l''avis unanime de toute la famille.', '2003-11-12T21:19:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, 24158e4f-fad8-4ccc-8a28-0c378399c60f, 'J''ai fait la même recette avec des fraises. Parfaitement équilibrée, c''est top!', '2015-04-15T09:36:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, bebe0457-9def-4fd0-888f-0b5857fba87e, 'Très bon. Temps de cuisson du biscuit 10 min. J''ai pris des citrons verts je préfère. Et pour le miroir j''ai pris du coulis deja prépare.', '2014-03-30T22:49:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, e6b6c454-390d-4351-a8d1-654f0a135fd6, 'Parfait excellent
J’ai bluffer mes amis ils croyaient que ça sortait de chez le pâtissier
Par contre il faut utilise soit de la crème épaisse soit de la crème fleurette
', '2023-10-23T08:36:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, 259b5327-aceb-4b82-bc9a-344c137d6ab7, 'Plusieurs fois que je le réalises et toujours un régal pour tout le monde!!! Merci pour cette recette 🙏🏼', '2023-09-03T08:03:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, 28766f2b-2ee0-4420-9d2f-a0ff95f2fcb9, 'Pour une première fois j''ai eu du mal à tout dissocier, mais la fin de la recette j''ai du compris pas mal de choses ; il faut beaucoup de temps de pause car ma crème était pas assez prise quand j''ai mis mon glaçage, du coup j''ai arrangé comme j''ai pu et puis mon plat était trop grand et mon biscuits malgré qui était super bien cuit il était trop grand pour la préparation. du coût à refaire pour ma part', '2023-04-30T18:36:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, 920a3765-abf4-49f4-b50a-8ee16e3cc6f1, 'Super recette ', '2022-01-08T10:26:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, 733043fd-9c6a-4bb0-8699-01b9a3db8f92, 'Recette parfaite ! C''est la 2ème fois que je l''a fait!', '2021-05-31T15:14:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, 457aad90-b078-4db4-8882-b5600315e5cf, 'J’adore', '2020-11-07T17:40:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, 3bb3e56b-17f6-4b94-aeec-5503db15a700, 'Très  bonne recette. Bon équilibre pour le bavarois et surtout très  joli en parts individuelles faites avec des emporte-pieces. Pour démouler j''ai mis le poussoir sous le gâteau ainsi pas de risque d''abîmer le miroir. Par contre je n''ai pas mis le sirop de citron. Tout le monde a adoré  je referai souvent', '2019-03-02T11:26:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, dd8c96c9-6a0c-4d33-bf6e-c279042d731a, 'Délicieux et belle composition.Réalisés dans des moules cylindriques, ils sont super! le biscuit est léger et j''aime le gout citronné.', '2018-06-10T12:05:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, 2a4eca19-75be-4f71-9181-dd52c4c7b77e, 'Fait pour un anniversaire, tout le monde a adoré !', '2017-12-12T22:14:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, 92b16dfb-ceab-419b-963e-d5faf062b790, 'Parfait ', '2017-08-29T19:26:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, 44cd03c4-9e86-4b33-983c-5460369a4e6e, 'Mon premier bavarois.  J''avais un peu peur que ca soit compliqué.  Mais au final le plus dur c''est t''attendre pour le manger.  
Et elle a eu un succès sur toute ma famille. C''est frais et léger en soit un dessert idéal pour l''été. ', '2017-06-29T23:18:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, 3a559a8c-8c89-4da5-9f33-dfa627bfdaf8, 'Super recette qui fait sensation à chaque fois ! ', '2016-12-18T20:57:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, 0ee0951a-d2bd-4b83-a257-a44647e3e639, 'Le sirop de citron était un peu acide à mon goût et du coup un peu trop présent. La quantité était un peu trop restreinte pour imbiber tout le biscuit. Parfait sinon au niveau des textures !', '2016-02-28T17:00:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, 43a81d57-b4a1-4491-a419-93c8b9b13ef2, 'Recette parfaite. ', '2016-01-18T00:18:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315501, 85cc4e20-332a-4821-9acf-974dbedbe9b1, 'Excellent, mais je préfère sans citron, je trouve que cela couvre trop le parfum des framboises.', '2015-03-15T11:51:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, 65120abf-cb3c-4925-9c1e-0d974b40f073, 'Excellente recette ! J''ai ajouté une couche de pommes préalablement dorées à la casserole avec une pointe de beurre, de la cannelle et un peu de sucre roux. Un régal avec le spéculoos qui apporte une touche d''originalité !', '2013-01-12T19:49:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, acf95a99-4d75-434b-a702-b101f2602005, 'Hyper rapide et délicieux !
', '2021-08-31T21:21:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, f41f9c1e-278a-47ac-938e-b9e3ee7f7a70, 'Excellent ! Servi avec un peu de Chantilly et une boule de glace vanille... Ça fait son effet ! ', '2021-08-26T18:54:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, 9131d947-6c1b-4562-b741-892b8ac14bb4, 'Très bonne recette, j''ai juste mélangé des framboises et des mûres.', '2020-08-18T21:19:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, 4e5a16bc-8025-4e63-b30c-e0e51a3e2342, 'Très très sympa.  J''ai juste rajouté une pomme et une
Banane pour absorber le jus des framboises.  Très apprécié par toute la famille ', '2020-08-16T21:26:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, 2545540d-0459-40ee-940d-56cbc153b690, 'Excellent dessert. Super facile et rapide à faire. Sucré, croustillant, fruité, savoureux.... Dégusté avec un peu de yaourt à la vanille. Parfait.', '2018-09-07T11:34:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, c16c7711-97fa-4e8c-8a1a-608df3481e0f, 'Trop trop bon juste rajouté un peu de cannelle.', '2017-11-15T20:55:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, aea04c30-6369-424b-8b1a-dd4c7f351611, 'Top rapide', '2016-04-27T10:53:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, cdb10325-7bb0-40e3-867b-cd92569ee375, 'Excellent et très facile à faire ! Merci! ', '2012-11-11T18:46:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, dd3a8d25-4da0-4883-aa82-01db73109b66, 'Très bon les spéculos donnent un autre goût', '2011-07-09T16:12:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, f6566d20-86f1-4287-b337-b8a53dc11c77, 'Très bonne recette et très facile à réaliser... Encore meilleur avec une boule de glace à la vanille pour accompagner le tout.', '2011-06-19T16:12:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, a182fdde-043f-448c-af22-862c8d7ca88e, 'Recette facile et très bonne, pour accentuer le gout des spéculoos un peu de cannelle dans la pâte. A refaire avec d''autres fruits selon la saison', '2010-08-12T23:08:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, 0233671c-6447-4b02-8a07-05dc7c9befa4, 'Recette rapide et parfaite!', '2010-08-09T17:56:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, 13498abe-0a3c-405a-a1b1-b19e47321502, 'J''ai remplacé les framboises par des quetsches. J''ai aussi remplacé les speculoos par tous les restes des petits gâteaux de Noël, comme il y en avait environ 200 g, j''ai juste ajouté un peu de beurre et un peu de farine pour avoir une consistance plus granuleuse... C''était délicieux ! Avec une boule de glace au caramel, c''était vraiment divin !', '2010-03-28T18:43:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, 70b1da5e-541a-42af-b040-370418f19b04, 'Super ! Merci beaucoup pour cette recette !', '2009-08-14T12:14:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, 691d17ea-4607-464b-aa11-d2b1bf18d6b3, 'Excellente recette! A tester avec d''autres fruits. Aujourd''hui, j''essaie pommes-poires. Merci pour la recette.', '2009-03-01T09:45:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, bac183bb-039e-41e2-887a-456aa1747219, 'Vraiment très bon.', '2009-01-26T21:50:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68580, 7011246c-a538-4f86-86e3-30d264668b02, 'Que demander de mieux : c''est très bon, c''est super rapide et c''est relativement économique, voir même très économique si l''on utilise des fruits de son jardin. A tester je le recommande vivement !!', '2008-10-26T18:41:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, b139c678-6b19-4518-a429-bb137c774f97, 'Parfait je n''ai rien rajouté à la recette. Mes invités ont adoré ! Je vais la, refaire souvent. Merci ', '2021-08-27T17:13:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, f2c8866f-5256-402e-b254-c9c9f71b7922, 'Un pur delice ! J''ai ajouté un peu d''amande amère c''était parfait.', '2020-04-15T23:18:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, c97a60e5-4dfb-4f2d-81fa-003ee8c3a1f6, 'Très bonne tarte, bien meilleure le lendemain pour ma part ! La pâte est en effet bien beurrée mais je l''ai bien travaillée avant de la mettre au frigo (contrairement à ce qui était conseillé) pour en faire une jolie boule bien ronde et je n''ai eu aucun problème pour l''étaler, après l''avoir par contre laissée reposer au frigo une bonne heure et demi !  Le dosage du sucre est parfait, d''autant plus que mes fraises n''étaient pas très goûteuses. La crème d''amande était un peu trop cuite (mais mon four est peut-être fautif, il n''est pas des plus récents). Le lendemain, le jus des fraises avait imbibé la crème donc c''était juste parfait ... Un délice ! ', '2016-04-28T16:03:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 3e027513-b1c1-426a-b566-71afac9e7d44, 'Excellente, très bonne recette. J''ai remplacé le sucre glace par du semoule et la vanille par du sucre vanillé et ajouté un peu de lait dans la crème d''amande !!!!! Et bien faire dorer la pâte sableé au four !!!', '2007-05-12T14:31:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 4838af56-8342-4906-a192-031d0fe5f609, 'Variante avec pâte feuilletée 😄', '2023-06-18T10:53:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, f3fcacc4-a2c2-40e4-aa3f-f16b8c2f4d1f, 'Vraiment fameuse. J ai suivi les commentaires avec un peu de lait dans la crème et de la confiture de fraise sur la crème ...pour finir j ai arrosé de sucres glace.', '2021-05-02T14:45:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, b44b9f39-34bd-4797-bf24-fb9837236259, 'Préparation plutôt facile il faut  faire  cuire au départ plus de  de 160 ex 175 pour que la pâte sois  plus cuite y ajouter un peu de lait dans la pâte d''amande pour que ce soit moins secs. ', '2020-05-23T21:27:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 1e29d4ad-6770-4597-bb2c-1ec96aba79bb, 'Top ! Et encore meilleure le lendemain', '2020-05-17T20:38:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 88bab524-c46b-4192-81e6-ec088a3296a9, 'Un pur délice apprécié de tous !', '2015-06-26T20:32:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 3ea7041e-447b-47f3-91f9-f5639ea54200, 'Fait en tartelette avec de la confiture de fériés sur la crème d''amande comme sur certains commentaires très bonnes a refaire', '2015-05-01T23:09:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, a2949573-549d-4108-a7f9-d64b08e738dd, 'Est devenue ma recette fétiche! Trouvant la crème pâtissière un peu lourde j''adore cette variante. Oui la pâte est un peu fastidieuse à faire mais ça vaut complètement le coup! Un bon goût de beurre et du croquant! Personnellement j''ajoute un peu de lait à la préparation aux amandes et elle reste moelleuse. ', '2015-04-25T15:47:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 1a700842-cea0-4eba-9e6e-7a4e791b20a2, 'Super bonne, un peu moins de sucre la prochaine fois merci.', '2014-05-26T00:48:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 9dbc31a2-96cd-4f6c-b85a-602d0c95f363, 'Parfaite ! Absolument délicieuse ! N''hésitez surtout pas, elle est exquise ! J''ai ajouté une fine couche de confiture de fraise au dessus, pour faire tenir les fraises que je n''ai pas positionné de cette façon. La pâte est un peu difficile à tenir, peut être à cause du beurre, mais dès que c''est cuit, on sent bien la différence avec les pâtes toutes faites ! Bref, tout est super bon !', '2013-08-28T12:51:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 943cf059-3596-45d9-afc1-8c8bf7e70723, 'Super ! J''ai ajouté confiture fraises maison sur fond de tarte ;) ', '2013-07-15T15:27:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 70185aad-30df-46d2-bf8a-db6e45b18682, 'Très bonne !!! J ai ajouté à la crème un peu d''amandes en poudre et une pincée d''épices pour un pain d''épices !  ', '2013-06-16T12:43:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, b08356a8-75f9-4fa9-9e53-988c49ef037a, 'Beaucoup trop de beurre dans cette pâte qui du coup n''est pas assez croustillante. 100 g devraient le faire aussi. Moins de sucre aussi. Sur les conseils des autres, j''ai mis une crème pâtissière (17 cl de lait, 25 g de sucre, 1 jaune et 15 g de farine) avant de mettre les fraises.', '2013-06-15T19:51:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, f65b6f38-9aa1-4e4f-b2d6-57170196c9d2, 'Très bon, excellente variante !', '2013-05-19T18:47:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 08e55165-c34e-437d-a582-62ae07eaf9e1, 'Testée le weekend dernier, cette tarte a remporté un franc succès ! En ayant lu les commentaires, j''ai ajouté une fine couche de confiture de fraises sur la crème d''amandes cuite (et aussi parce que sinon, les fraises ne tiennent pas !) et c''était parfait. En 15 minutes il n''en restait plus une miette !', '2013-05-08T23:39:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 79453eaf-0a93-4c3a-813a-b8d13e442140, 'J''ai bien aimé, mais la crème d''amande étant un peu sèche, j''y ai remédié en ajoutant un nappage de fraise (confiture + eau réduite) pour que le tout soit moins sec au palais. C''était très bon. La prochaine fois, j''allongerai la crème d''amande avec du lait pour qu''elle soit moins sèche.', '2011-05-14T15:03:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 7615aef6-4d6b-4d52-a5cb-674d08e7b81e, 'Excellente recette, simplissime et délicieuse (un peu difficile) d''étaler la pâte, mais bon... ', '2010-06-11T16:07:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 377201f1-9998-4d21-bd5c-e5d4f29eb7b3, 'Très, très bonne recette Papa et enfants en redemandent. Un peu débordée, j''achète une pâte toute prête, et préférant le goût de la noisette, je mets plutôt de la poudre de noisette à la place de l''amande mais le résultat est esthétique et délicieux !', '2010-06-01T18:05:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 8c771eaf-678a-4cc6-821f-716642d15b1f, 'Un régal, j''en ai fait et refait et à chaque fois c''est l''extase. Je rajoute de l''eau de fleur d''oranger dans la crème d''amandes et je "vernis" le dessus avec un mélange appelé brillant pour tartes (dans le commerce). Merci pour cette recette!', '2008-07-28T12:07:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, c2244714-48e2-4957-a4c8-15a9bb8d5f62, 'TOP!! J''ai mis un peu moins de poudre d''amande et laissé cuire un peu plus, c''était parfait en tout cas !! (avec une pate sablée toute prête par contre)', '2007-09-09T22:29:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 44cada8f-aa0e-45c5-a7f9-47af03fe90e2, 'Bonjour petit conseil : ajouter de la crème pâtissiere dans la crème d''amande et le double du sucre. Sinon avant de mettre les fraises, étaler sur la tarte de la crème mousseline (40 g de crème pâtissière + 10 g de chantilly).', '2007-07-11T20:35:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 5ba28b7b-1a8d-46fa-bb8c-91aca1ba1794, 'La crème d''amandes est un peu sèche mais se marie très bien avec les fraises. Pour "sucrer les fraises" je les nappe de gelée de groseilles maison...      ', '2007-04-08T20:59:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, df31fb15-74d3-49fb-93e2-fa8306c8b2a9, 'Avec une crème chantilly par dessus et une pâte brisée à la place! C''est délicieux.', '2006-10-11T19:28:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 31c22125-05a7-4af3-b7f6-ea6386597077, 'Délicieux! J''ai remplacé la pâte sablée, que je n''aime pas, par une pâte feuilletée. Pour la crème d''amande, j''ai préféré la rallonger avec du lait, ce qui l''a rendu bien plus moelleuse. Après que ça ait refroidi, j''ai préparé un coulis de  fraise et déposé les fraises au dessus. Ca a beaucoup plus!', '2006-06-29T15:36:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, cba09054-f10b-45d2-99ef-f193cfd40a8e, 'Très déçue, pâte beaucoup trop salée, crème d''amande très sèche. Il manque un nappage sur les fraises, en bref ensemble sec et salé, dommage...', '2006-05-10T23:16:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 38c64bd3-76b6-4f29-9707-20b74b972748, 'Avant d''étaler la pâte sablée que j''ai gardée au réfrigérateur, je la place entre 2 feuilles de papier sulfurisé. Cela évite qu''elle ne colle au rouleau quand je l''étale et permet de la poser diretement dans la tourtière (sans enlever les 2 feuilles de papier). Je mets ensuite des légumes secs pour empêcher la pâte de gonfler pendant la cuisson. A la sortie du four j''enlève les légumes secs et la feuille de papier avant d''étaler la crème d''amandes, puis les fraises. Je retire la feuille de papier qui reste quand je transfère  la tarte sur le plat de service.', '2005-05-25T20:16:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 0bcec06f-ecf9-4a96-b65b-22624c6c4843, 'Je suis déçue par la crème d''amande (un peu sèche)et je ne trouve pas que le goût se marie bien avec la fraise. Je préfère cette tarte avec de la crème pâtissière.', '2005-04-17T23:12:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 2609b3a3-55e0-406e-8d6e-0e1a9e795095, 'Effectivement, 20 minutes suffisent largement pour la cuisson de la crème d''amande! Rajouter un peu d''amande amer dans votre préparation, cela n''en sera que meilleur ! Bon appétit aux gourmandes !', '2005-04-14T13:22:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 464c501b-a710-446c-abd1-f0429f0a1355, 'Excellente recette ! je n''ai pas fait la pâte sablèe, je l''ai achetée toute prête !!!', '2004-11-18T23:20:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 227dd1c5-ba41-432d-a822-ec0d58f3702d, 'J''ai été un peu dessus du fond de tarte, il faut faire attention à ne pas le cuire de trop. ', '2004-08-30T13:20:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 07d8fa3e-57e6-4ae7-b6e4-e9f5c30f5584, 'Très bonne recette. C''est vrai que la pâte sablée est un peu difficile à étaler, j''ai fait avec les mains directement dans le moule. Je n''ai pas fait la cuisson à blanc mais avec les haricots secs(selon la tradition).', '2004-06-01T11:43:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 3c0d1788-916f-4d16-8289-c9b3352383af, 'Bôf! J''ai fait la pâte à tarte au robot, résultat: très difficile à étaler... Pire, même lestée pour la cuisson à blanc, la pâte à tarte a levé dans le plat (à cause de l''oeuf entier?). Je préfère une pâte sablée traditionnelle! La crème d''amandes, c''est OK à condition d''en mettre 2-3 mm dans le fond, sinon ça  fait frangipane, c''est lourd et ça écrase le goût des fraises... Idée: avant de disposer les fraises, étaler sur la couche de crème aux amandes un coulis de fraises (mixer ensemble des fraises + du sucre). C''est joli et goûteux!', '2004-05-24T17:14:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, d8e073a7-66ae-4112-a060-dafe52a71311, 'Très bonne tarte aux fraises avec une touche d''originalité! J''ai rajouté un peu de gelée de groseille pour le plaisir des yeux et du palais!!', '2004-04-27T13:46:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, 1f0a9524-46da-4a5f-b8b3-ca140f9db127, 'Génial! Les fraises et la crème d''amandes se marient très bien. Par contre, à ne surtout pas faire la veille car la pâte et la crème absorbent le jus des fraises et tout est mou. Le jour même, c''est un délice!', '2004-04-11T20:23:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23954, c4b39222-6fad-414e-a9ec-51ef6dbf7120, 'Très bonne! J''ai ajouté quelques gouttes d''amande amère pour rehausser la saveur de la crème d''amande. Pour mon four électrique 15 mn de cuisson à blanc ne suffisent pas, plutôt 25 mn et cuisson à 180°C avec la crème d''amandes.', '2004-04-02T12:56:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 2d9c1da3-bbb4-4505-8ab0-14d7de027a47, 'Muffins délicieux en mettant plus de gingembre et un peu moins de cannelle. ', '2022-11-20T14:33:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, f5a99f98-a823-40d1-a666-d27967ca9643, 'Très bon et moelleux,  j''ai mis moitié maïzena moitié farine', '2021-11-22T16:54:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 02296fe5-faff-4045-8c05-27f7730f21b5, 'C''était plutôt bon, mais je changerais quand même quelques détails pour la prochaine fois: Tout d''abord, 150g de sucre devraient suffire (pourtant j''aime le sucré ! ). Ensuite je trouve que le ratio pomme/pâte était un peu trop élevé, et la pâte devenait difficile à gérer donc j''en ai mis une de moins. Je mets aussi 2 fois plus de cannelle, mais ça c''est une histoire de gout. Et enfin comme certains dans les commentaires, mes muffins n''ont pas beaucoup monté, la prochaine fois j''y mettrais plus de levure. Sinon le goût était pas mal !', '2020-04-11T22:38:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, de37260c-320c-4139-992e-826fb5c10129, '150 g de sucre - 3 cuillères de cannelle pour mes légères modifications.
Ces gâteaux sont très bons ! Merci d''avoir partagé cette recette.', '2019-03-22T10:19:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, a0679c5f-b56c-40cb-8fe6-78450f2fcd1c, 'Avec 1 sachet entier de levure c''est parfait ! Avec des petits morceaux de gingembre frais ou des poires c''est aussi délicieux.', '2019-03-07T12:43:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 64848b55-3a9e-4546-95bc-9961c7517853, 'Les muffins ne sont pas gonflés et collent au papier sulfurisé. Absolument pas présentables. Dommage car le goût est bon.', '2018-03-24T09:06:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 4b51b103-8efb-449d-bc64-f08732ff29fc, 'J''ai fait un malheur avec ces muffins ! Quel goût et quelle texture ! C''est désormais ma recette préférée, merci beaucoup ! ', '2018-02-13T12:58:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 124904d4-0c29-4556-ac8f-d3ddf8d12d9a, 'Excellent, très original, j''ai suivi les conseils : 1 sachet de levure. Par contre, cuisson à 180°C au moins 40 min, ça dépend de la quantité de pommes qu''on met. A refaire sans hésitation.', '2015-04-04T17:17:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, a4fe300a-653d-4169-84eb-9155f12a588e, 'Dé-li-cieux! On a adoré tous les deux, et on en refera avec plaisir! J''ai suivi la recette presque à la lettre: 2 yaourts au lieu d''1 et demi, et 3 pommes. C''était trop trop bon! Il en reste pour le goûter, j''ai hâte! :) Merci!', '2014-04-06T13:38:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, f09c2a34-814d-44bd-9528-4567debbb1ee, '5/5 à l''unanimité du jury. J''ai râpé grossièrement les pommes au lieu de les couper en morceaux. Le résultat est délicieux.', '2012-11-29T22:36:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 7ce7fd97-3607-4aef-90c1-260acf1e30a9, 'Parfait, tout le monde a aimé. J''ai remplacé le yaourt par 20 cl de crème fraîche allégée. ', '2012-03-05T18:35:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, a9347796-f457-4935-a979-635da9b57cd7, 'Je viens de faire ce dessert il est délicieux. Je n''avais pas de moule à muffins j''ai pris un moule à manqué et je n''ai fait qu''un seul gâteau. Trés bon encore tiède et j''ai mis les deux yaourts en entier.', '2012-02-20T08:40:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 37e5b1d9-91fc-4a90-84d5-ab61a8320e9e, 'Trop trop bon j''ai juste ajouté un peu d''huile dans la pâte et mis 140 g de sucre et 2 petits pots de fromage blanc je garde la recette, merci ', '2012-02-14T18:35:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 2e08b3d9-a469-47bf-8ef4-5a2a1ca96c88, 'Vraiment bon muffins, moelleux à souhait et pas trop gras car il n''y a pas de beurre. J''ai réduit le sucre à 150 g et j ai mis 2 cuillères à café de cannelle et pas de gingembre. Je referai cette recette, mon fils de 3 ans a adoré.', '2011-10-27T21:16:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, a3aea8e7-13ef-4b31-a66c-7e045384444d, 'Très bons, mais un peu trop sucrés à mon gout (même avec 180 g de sucre au lieu de 200). J''ai aussi ajouté 4 cuillères à soupe d''huile et rien changé d''autre. ', '2011-08-20T19:34:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 9243666d-fe8e-4070-8acb-7f330765a54c, 'Très très bon ! J''ai un peu modifié la recette selon les commentaires précédents : 100 g de sucre seulement, 1 seul yahourt, 1 sachet entier de levure, 1,5 cuillères à soupe de cannelle, et petite variante personnelle, j''ai fait caraméliser les pommes. Inutile (selon moi) de séparer la préparation en deux mélanges différents, j''ai mis tous les ingrédients ensemble les uns après les autres et le résultat est parfait. ', '2011-08-20T01:12:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 35383559-700c-44a3-b5b9-1427817de2c2, 'Très très bonne recette adoptée, merci beaucoup, par contre, je ne mets que 100 g de sucre environ car avec le sucre des pommes, nous trouvons cela suffisant !! J''ai testé des variantes en ajoutant de la noix de coco, du chocolat noir ... et c''est toujours une merveille, la base est excellente.', '2010-12-20T15:51:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, a7ba6441-0d8b-484f-be91-c64a8e546f19, 'Dé-li-cieux !!! Comme la plupart, je n''ai mis que 150 g de sucre et 2 cc de cannelle; n''ayant pas de yaourt, j''ai mis 85 g de fromage blanc 0%. J''ai utilisé des pommes Canada. Comme elles sont grosses, 3 ont suffit. Comme ces muffins dodus devaient attendre leurs invités, je les ai couvert d''un torchon pour qu''il garde leur moelleux. Mmmmmh ! A refaire !! Merci beaucoup', '2010-06-25T13:53:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 8ee4baa3-b23f-4c74-ab88-4541e74e86ba, 'Excellent!!! Ces muffins sont très bons! J''étais sceptique au départ par le manque de beurre ou d''huile... Et bien, ce n''est vraiment pas nécessaire, et les muffins sont parfaits ainsi! Moins de culpabilité pour les gourmands! Ils sont dorés à l''extérieur, moelleux à l''intérieur... J''ai tout de même apporté quelques modifications; seulement 130g de sucre, ça suffit! Je n''ai pas mis de gingembre, mais rajouté les zestes d''une orange non traitée et des noisettes concassées... Une merveille!!! J''ai testé aussi avec des poires, des amandes hachées préalablement grillées dans une poêle, et une boule de nutella que j''ai déposé entre deux couches de pâte dans les moules...! Que du bonheur!!!!! Merci pour cette recette! Cette base est parfaite, légère, et on peut varier les plaisir avec d''autres fruits ou épices... Bravo!!!! N''hésitez pas à tester!!!!!', '2010-02-07T22:37:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 46034097-327a-483c-aa80-4762fbc5ac8a, 'Effectivement un peu trop sucré, mes enfants adorent ! 
', '2023-11-03T18:35:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 9288f459-912b-4ac3-b1c9-7b4ed9850496, 'J''ai respecté la recette avec moitié moins de sucre. C''était parfait !', '2022-10-19T07:37:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, c2267d5d-bb4b-47e0-8644-761b492d0fbb, 'Très bonne recette. Les pommes qui commençaient à fatiguer ont eu une excellente seconde vie. Je la garde dans mon carnet. A refaire! 👍', '2022-05-17T21:45:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, dd681d26-d8f7-434f-9760-16342ecafb08, 'Très sucré, on peut diviser par 2 le sucre.
Sinon tip top', '2022-03-16T21:28:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 4567a89f-09b1-4e27-954c-017b82774a9e, 'Super recette… très facile à réaliser 😊', '2022-02-14T00:50:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 04266431-987f-42ab-af95-c22c04835bbc, 'Excellente recette ', '2022-01-21T11:34:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 7ea7f3e9-9abb-4e0d-a8cd-c8aa5594d515, 'Génial ! Merci pour la recette ^^ !', '2021-12-15T13:19:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 900f2659-a16f-4ec6-b82e-dadda55e3a32, 'Nous avons trouvé ces muffins trop secs malgré l''ajout de beurre...', '2021-11-12T22:26:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 7d30486c-de85-4543-844a-37592e69faab, 'Je trouve que c est beaucoup trop sucré, et la recette manque de beurre', '2021-07-03T08:03:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 67988536-662b-4421-8ba3-24431371b8f9, 'J''aime cette recette', '2021-06-02T14:01:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, b9514e56-03ad-4466-ac28-17a568fe2685, 'Très très bon ! J''ai pris des pommes un peu acidulées. Un beau contraste avec le sucre.
Les enfants ont aimé le goût cannelle et gingembre qui donnent une saveur particulière. Une recette originale à déguster avec une tasse de the
Ingrédients suivis à la lettre. Aucun soucis !', '2020-10-31T00:18:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 0ea62133-90f0-45b7-ae58-d7ae78e14d33, 'Excellent  merci beaucoup pour  cette recette, moi je la fais sans rhubarbe, en  gateau ou en muffins, délicieux !', '2019-06-22T06:04:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 7657eee3-05e0-4b79-92b4-7874228d42c4, 'Je suis déçu les muffins sont trop secs et dur.', '2019-04-17T10:41:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 4fbee4ae-e112-4f03-af88-b50e696829ee, 'Excellent', '2019-03-16T12:39:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 56f9d85c-19d2-4c0c-a5e0-eac165043233, 'Mettre 1 sachet de levure au lieu de 1/2. 
Parfait.', '2018-10-31T12:21:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 9f6d943f-9298-4423-b1a1-abd35095b504, 'Super recette! Je n’ai mis ni gingembre ni cannelle et j’ai remplacé les pommes par des nectarines. Les fruits ont très bien tenus la cuisson sans empêcher la cuisson de la pâte. ', '2018-09-04T06:13:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 36d792e7-2cdf-4004-8f03-8f6c940189d0, 'Recette délicieuse malgré l’élasticité de la pâte  !', '2018-08-30T10:14:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, ae2e0865-d940-4151-afbe-43c557859415, 'Une magnifique recette simplissime et délicieuse je suis une catastrophe en cuisine que Gordon Ramsay ne renierait pas, et pourtant je suis arrivée sans problème à faire une douzaine de muffins qui ont régalé tout le monde. A recommander absolument, avec un thé ou un cappuccino !!', '2017-04-21T19:37:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 3e24366c-f043-4dfe-a7ec-58670660d046, 'Un délice ! Rien à changer.', '2017-01-09T11:54:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 09891e67-f275-4a4c-b444-a72c101a66fa, 'Très déçue, au vu des commentaires je m''attendais à de super muffins et en fait ils étaient c''est vrai goûteux, un peu pain d''épices, mais collants en bouche et aspect plats... je ne referai pas c''est sûre !', '2016-10-25T11:00:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 870be36a-1884-41f7-a2ae-2af79107a8ab, 'Un vrai délice! J''ai mis 100 g de sucre et c''était largement suffisant! Plein de variantes possible! J''ai eu un succès fou! Grand coup de coeur.', '2016-10-17T01:00:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 21c638ee-2e46-4d3e-b44a-3ecdf64e4abb, 'Super recette, avec le gingembre c''est un délice, à refaire.', '2016-04-13T21:29:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 1e1062b2-12f3-444b-8c30-44ab03d03d99, 'Excellent, je n''ai rien ajusté et super !', '2015-11-19T19:01:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 47072f17-c47c-41f8-8fcd-1702132ec6ad, 'Excellente recette ! A consommer sans modération ! ', '2015-11-08T18:36:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 9acbfd77-ade8-47a0-b558-fdeb09e72343, 'Excellent!!', '2015-07-10T20:44:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, c86044dd-2062-4af2-b836-345c96344df3, 'Pas super, la texture est bizarre et ne ressemble pas tellement à celle d''un muffin, j''ai suivi les conseils des commentaires et j''ai mis moins de sucre.', '2015-05-01T14:13:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 4bc886f5-09fe-42a1-a947-7d74362c208f, 'Excellente recette. J''avais dans mon panier à fruits 3 petites pommes dont je ne savais pas quoi faire : cette recette tombait à pic. J''ai mis le paquet entier de levure. J''ai ajouté quelques gouttes d''arôme amande amère; mais sans les fruits secs !  Cuit dans des moules à muffins individuels.  Juste PARFAIT ', '2015-02-07T23:27:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 8951e250-8fdb-4386-bd1c-2b15c9791939, 'Légers et relevés en goût, j''adore cette recette facile à réaliser ! Un délice ! ', '2015-02-03T18:28:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, b9d03b1b-5af3-4459-bbdc-9e722553c1b8, 'J''ai rajouté du gingembre confit en brunoise et j''ai remplacé les pommes par de l''ananas.  Excellent! ', '2015-01-13T14:42:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, f55c0eed-b8e1-4754-b25a-0d9c1ade2f18, 'Vraiment très bons, malheureusement ils n''ont pas fort montés mais n''en reste pas moins succulents ! ', '2015-01-07T18:42:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, d9d8929b-ce88-45eb-a1ee-e8ec957947e6, 'Trop trop bon !', '2014-11-04T16:36:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 048f63df-b7f3-4981-88c1-6df356a02355, 'Excellent avec seulement 100 g de sucre. Je n''avais que des yaourts à la noix de Coco et ça marche aussi bien.', '2014-11-01T21:25:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, f650ede1-8d6c-4e6d-84d9-6a24583a3310, 'Merci pour ce moment de bonheur... Mmh !', '2014-10-16T18:59:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 9c434901-ecf4-431d-ada0-dd9cd84871e7, 'Excellent et facile à faire. Une odeur ravissante. Les enfants n''ont même pas attendu que les muffins refroidissent pour les engloutir !', '2014-08-27T22:30:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, bf69443d-b4eb-4688-a70c-4e4e873a0ba1, 'Très bons muffins avec 150 g de sucre, effectivement légèrement élastiques mais très bon goût. 3 pommes suffisent.', '2014-06-27T21:09:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 6155bc7a-57b7-40a9-93d0-3427bea5c6fe, 'Trop bon', '2014-05-29T20:10:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, d12f3bf9-7baa-4a1b-ac5c-55add76e8308, 'Simplement excellent, ça change du muffin basique.', '2014-05-18T22:29:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, b61f4e7e-8b32-4071-b6a9-26f1e72cdf02, 'Bon et facile à faire, je recommande cette recette et perso je n''aime pas le gingembre donc je n''en ai pas mis.', '2014-05-03T23:17:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 90d904e6-40dc-4995-9b3f-cd4c65e43d8a, 'Le mélange cannelle pommes gingembre est excellent. Cependant j''ai trouve les muffins un peu " élastiques" je préfère la recette avec beurre fondu et lait plutôt que œufs et yaourt. ', '2014-04-07T17:49:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, bb44faa2-1b10-498a-8a2a-c0d9d7be6e5f, 'Excellente recette. 180 grammes de sucres et pommes finement broyées.', '2014-03-30T19:29:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36250, 20c70d65-2f3f-4450-87b2-0178e0c7d8f2, 'J''ai mis 180 g de sucre et un peu moins de gingembre... Magnifique ! ', '2013-11-26T19:23:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, de6ad58c-ac8f-44cd-8245-5a7ba8c52f65, 'Excellente et ça change de la traditionnelle tarte aux fraises par contre je fais cuire ma pâte plus 25min que 15 et j''ajoute une noisette de beurre au chocolat et non du lait ça s''étale beaucoup plus facilement . ', '2017-04-07T12:09:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, c3e4d0f0-925c-4692-998d-255b585e9c9f, 'Super bon ! Avec le reste de fraises du jardin et le chocolat de Pâques : un régal !', '2011-08-12T21:57:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 10f7a72a-1361-4218-b55a-dde220814d0b, 'Recette légère et délicieuse. Tout les invités ont adoré ! Rien à changer dans cette recette.', '2022-05-29T08:55:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, bf252406-6f34-4583-9249-033e254e23e7, 'Très bonne recette ! Faite avec une pâte brisée en version banane-fraise, ça fonctionne très bien aussi ...', '2019-06-09T09:05:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, c8e084b4-6aa5-45c6-a755-ba7a2f80c9e5, 'Dessert délicieux et facile !', '2018-05-02T12:45:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 7e799622-06a0-4b16-a14f-a961529a67d8, 'Un délice, recette avec de bonne proportion, les aliments s''accordent à merveille, même ceux qui n''aiment pas trop les tartes en ont repris !', '2017-05-31T12:21:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, bd352126-39b6-4dc9-bc61-c376589cbf9c, 'Recette top. Le chocolat est un vrai plus. Je diminuerai le mascarpone la prochaine fois car c''est sur que je vais la refaire...', '2016-04-02T11:50:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 2ee893c0-dbb8-4ed2-b811-4a77d037988c, 'Parfait !', '2015-11-28T18:00:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 0b6934be-cc08-427b-a5b8-4f1fb892cc47, 'Vraiment très bon.', '2015-06-09T19:27:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, e9904e30-8253-49a2-a74a-644c68dff32e, 'Je la fais tous les ans avec le même bonheur. Je comble les espaces entre les fraises entières avec des framboises ou des morceaux de kiwis gold et je fais un mélange 50 g pralinoise et 50g chocolat noir pâtissier.', '2015-05-24T12:40:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 3eba367a-ae90-40fc-a9f6-ab36b52f757c, 'Recette excellente et quelle surprise cette petite touche de chocolat!', '2015-05-08T14:58:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, b61f6ccb-7ebe-4dea-bf94-3cef665569e3, 'Très bonne tarte. Le chocolat casse le côté crème écœurant. On s''est régalés.', '2015-04-14T19:29:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 1cfdfb49-3d4d-4463-b996-54fbada86d9c, 'Vraiment délicieuse ! Je mets plus de chocolat pour avoir une bonne couche épaisse et un peu moins de mélange mascarpone/fromage blanc. Même mes amis qui n''aiment pas le mascarpone en mangent ! Et c''est encore meilleur avec une pâte sablée maison...', '2013-07-11T17:31:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 4965b129-a488-4b52-bec8-66aa409485b5, 'Très appréciée par ma famille ! A refaire plein de fois ! Très simple.', '2013-05-10T20:39:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 9137d73d-9667-4d29-bd9e-4038165fd964, 'Très jolie à présenter et délicieusement bon !', '2013-04-01T15:39:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 523f86b8-3bda-4839-8333-dea1715790c4, 'Bonne association d''ingrédients. Plus de chocolat et moins de mascarpone seraient davantage appréciables et moins écoeurants. Des mini tartelettes serait certainement moins bourratives.', '2013-02-23T22:04:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 13993706-8542-4397-aeba-8e1fdbde138e, 'Très bonne association de saveurs! Tellement meilleure et plus originale que la traditionnelle crème pâtissière! Tout le monde s''est régalé. J''ai juste mis un petit peu moins de mascarpone et plus de fromage blanc. J''avais peur que ce soit écœurant pour les moins"sucrivores"de mes invités!', '2012-07-18T14:58:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 6b5796a2-fbe2-445c-8e9d-760084f3fd50, 'Le mélange mascarpone/fraise + chocolat fonctionne bien, nos convives ont beaucoup aimé. Bonne recette.', '2011-12-04T14:27:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 6d6d28d8-2e89-4e3a-b4fb-a7537cb4ab18, 'J''adore chacun des ingrédients. Mais cette tarte est vraiment loin d''être excellente... Il y a beaucoup trop de garniture, c''est très très écœurant. J''ai tout suivi à la lettre, et je le regrette. Si je devais me risquer à la refaire, je mettrais peut-être un peu plus de chocolat, mais sûrement bien moins de mélange mascarpone/fromage blanc. ', '2011-08-04T23:27:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 2d13e535-4c81-4bc5-bfd5-53d790e9ab67, 'Trop bon ! Je viens d''en faire 2 pour mes invités, j''espérais qu''il nous en resterait un peu pour ce soir... Mais non, si j''en avais fait une 3e elle serait mangée aussi ! Merci, je la referai !', '2011-06-02T21:02:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, ec5a094d-78aa-4965-976b-11194cf8f791, 'Délicieux ! La combinaison tarte sablée/chocolat/fraises/mascarpone est très chouette. Mais la pâte est un peu dure, et le mascarpone écoeurant pour certains. J''ai refait la recette en faisant des mini-tartelettes, en faisant des petits sablés, les badigeonnant de chocolat, et finalement en mettant une petite fraise (ou un morceau) avec juste une touche de mélange au mascarpone pour la touche crémeuse. La 2e version plait davantage, mais évidemment cela prend beaucoup plus de temps !', '2009-06-21T18:25:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 75301342-7788-4e6c-94a9-5244ebfd8458, 'Malgré une pâte sablée un peu loupée, la tarte était délicieuse. La garniture est facile à faire et vraiment super ! ', '2009-05-17T00:01:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 5bc9928c-6553-4922-bd23-2e14b91adf8a, 'Super la tarte, mes invités ont adorés!!', '2009-05-02T21:17:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 24b5dbb3-c305-402a-8b7a-06bcc640309e, 'Très bon dessert, avis partagé quant au chocolat, certains de mes invités n''en aurait pas mis ou un peu moins (j''en ai mis 150 g cela dit), par contre franc succès de la garniture, je le referai sans hésiter avec moins de chocolat et sans doute de sans, merci !! ', '2009-04-26T10:34:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 3e645a2b-a15e-4817-b296-9c2e54f2e3b7, 'Je n''ai pas mis la confiture de groseilles (trop sucré pour moi) et c''était excellent !', '2009-04-24T13:23:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, fbbfddc3-5014-4569-b9c3-240745a01f89, 'Franchement... bof. Bien meilleure le lendemain mais le mélange ne fait pas l''unanimité.', '2009-04-07T18:25:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 545b76ed-927d-480c-85ea-2b69b89bc338, 'Super!', '2009-02-15T10:04:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 8d19827f-c02c-4d6f-b1e8-99521ebb68d7, 'J''ai trouvé cette recette compliquée à la lecture, mais avec tous les commentaires positifs je me suis lancée! Un seul conseil: le plus dur c''est de faire cuire la pâte! Moi j''ai posé des ramequins, et 5 min avant la fin de la cuisson je les ai enlevés! Il ne faut pas hésiter à remonter les bords de la pâte qui ont tendance à redescendre...Excellent!', '2008-10-03T00:00:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, e93231c2-9b87-4083-bd65-ec2114d54f33, 'Un vrai régal! Rien a redire... juste à savourer!', '2008-08-01T15:20:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, d58095dd-55b6-4801-8f7d-6c6dfead7ee4, 'Tout le monde a adoré, attention à bien laisser prendre la tarte au frais (quelques heures) pour que la crème ne coule pas au découpage. Avis général: encore meilleure le lendemain (pour le peu qu''il en reste)!', '2008-05-21T19:10:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, e8843f71-f9ed-4af3-8846-8fcadb2fe8f6, 'Pour tous les gourmands je vous la recommande, c''est vraiment un dessert succulent car il surprend c''est un savant mélange croquant et moelleux à la fois. Inratable', '2008-04-23T19:17:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 6206bae0-98a5-406b-bd9e-b01697180084, 'Pour une débutante, dur de faire cuire la pâte... Rien de terrible, j''ai trouvé ça trop sec !', '2008-03-30T00:31:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 3a060bda-7ff2-4533-a5d8-18b1af4aeeeb, 'Je l''ai faite pour la fête des pères : tous ont adoré ce savant mélange fraise-choco-mascarpone! J''ai eu un peu de mal à chauffer la pâte seule (j''avais mis du riz), ça ira mieux la prochaine fois avec des haricots secs.', '2007-09-08T16:21:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 4666ca4c-e35a-44b5-bd54-722d0a3be5d0, 'Délicieux!!! certes pas très light (heureusement qu''il y a les fraises pour avoir bonne conscience...) mais je la referai sans hésiter!', '2007-09-06T15:34:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 75a0fe92-be64-48c7-8a6c-99cd7e31c409, 'Même en ayant oublié le fromage blanc (oups!), la tarte a été dévorée par les invités (et nous aussi d''ailleurs!). Avec 150g de chocolat, et quelques framboises en plus comme conseillé dans la recette, cette tarte est à facile à faire, et à refaire! Merci de nous l''avoir fait découvrir.', '2007-08-04T13:57:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 47871b99-5908-41f5-8fea-12ee1fec023a, 'Bien. La consistance solide de la pâte s''allie très bien avec les fraises. Je trouve que le chocolat n''est pas nécessaire. ', '2007-07-23T12:23:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 59ea9107-23b1-4c9e-a4c0-211ff2c331fd, 'Super, rien à redire', '2007-07-20T03:11:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, a21ce11a-0e85-4762-abb2-1b90f773c33f, 'Exceptionnellement délicieuse. Je l''ai réalisée aux fraises puis aux framboises avec le même succès.', '2007-06-17T21:43:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 6d4d52c9-4f00-452a-95e6-7a5c6f1f9c89, 'Excellent !! Surtout quand on a des convives qui sont "chocolat" et d''autres "fruits" : il y en a pour tout le monde. Le seul truc : un peu trop sucré à mon goût en mettant de la gelée de groseille.', '2007-06-09T16:15:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, bd590097-b547-44cc-a7ef-a41fd179b4ab, 'Très très bon, mais je préfère encore sans le chocolat !!!', '2007-05-28T12:41:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, a44abf35-bb9d-4ba9-adb8-2622ac46666f, 'Bon, c''était la première tarte aux fraises que je faisais...une réussite, un délice, il m''a juste fallut un peu plus que 500 g de fraises, parce que je les ai mises entières sur la tarte. Mes invités ont adoré, et moi aussi...encore merci pour ce super tuyau!', '2007-05-13T21:46:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 2efe2363-0f32-4a24-a806-886ac21490f8, 'Vraiment une excellente recette... Il n''en est rien resté... L''alliance mascarpone, chocolat et fraise est redoutable... J''adore !', '2007-05-09T11:27:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 0baa4bd3-508c-4b7f-a896-006ab539dce5, 'Bonne mais le chocolat ne me paraît pas indispensable.', '2006-06-14T12:04:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 6080c446-855b-4aed-a50c-0a5bed1caa53, 'Super délicieuse. J ai fait la pâte sablée,et je n''ai eu que des compliments. L''alliance chocolat, mascarpone et fraises est un pur délice !! Bravo ; je la recommencerai ; c est certain !!!!!!!', '2006-05-22T16:00:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 7dcf5872-f94f-4438-9ac1-b1ad5af0bfcb, 'Très bonne et facile à faire.', '2005-08-15T18:57:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 981f3b7f-9aad-4517-ab24-3546e723be4f, 'Une tarte que je fais très souvent depuis que j''ai decouvert cette recette sur Marmiton et qui a toujours un franc succès. Je trouve que 150g de chocolat sur mon fond de tarte est idéal mais c''est une question de goût....', '2005-07-13T16:37:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, d9524067-e620-4b7f-bd1d-b3b93f84883d, 'Je l''ai faite avec des framboises. J''étais un peu déçue au début car nous l''avions mangé à peine une heure après la prépration mais ce fut un régal le lendemain. Il faut le servir très fraîche, en plus la couche de chocolat empêche la pate de ramollir au fond. Merci pour la recette.', '2005-07-09T00:46:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 569555b8-7aa9-4528-8219-8789f8461f5f, 'Délicieux!!!!! Je connaissais déjà le mélange mascarpone/fromage blanc/sucre) qui est une vraie petite merveille  L''idée de rajouter du chocolat est excellente!! Ca donne un petit (même un gros) plus! Et c''est très discret! A essayer avec des framboises.', '2005-06-02T16:55:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, 0c41d61e-ba3c-435d-aff6-105ce265c102, 'Cette tarte est un vrai régal! Le mélange mascarpone, fromage blanc, sucre change de la traditionnelle crème patissière! Et que dire du chocolat au fond!! Un vrai plaisir à faire et à déguster!', '2005-05-27T19:28:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, f75fe334-f83c-4087-bf74-950de45aa088, 'Excellente ! Un vrai plaisir que de faire cette tarte, mais encore plus de plaisir de la déguster après, avec du Champagne !', '2005-05-18T13:07:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, a5a61459-b345-469c-b0a4-be70acc04029, 'DIVINE!!! Le chocolat est présent sans être écoeurant. Le mélange mascarpone/fromage blanc est super léger. La présentation est alléchante. Tout le monde s''est resservi. Merci.', '2005-05-06T10:07:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, c2e1ec9a-e7ae-4a32-9d9f-a3f6a1b791a2, 'Un délice de chez délice... c''est vrai que le plus difficile à faire c''est la pâte brisée !!!', '2004-09-20T22:35:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, c33266e8-a755-40f8-bc7f-3c97f7c637c8, 'Excellente tarte... en particulier la petite couche croquante au chocolat. J''ai réalisé cette recette avec un mélange de fruits rouges surgelés. Le résultat était aussi beau que sur la photo !!!', '2004-09-13T00:48:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30449, a5c509f5-83e5-43d7-b5e0-4659ac4b9070, 'Super facile à réaliser (le plus dur a été de faire la pâte sablée, c''est tout dire!) et effet garanti. J''ai utilisé de la ricotta à la place du fromage blanc. Variante: fruits des bois ou tout framboise. Attention, elle n''est jamais trop grande...', '2004-09-08T08:00:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 5e0ce26e-5fea-4fa1-993c-bee460ff6914, 'Quelle quantité de sucre par kg de pommes épluchées ?', '2023-10-31T17:37:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 1be4f186-a139-42cb-8515-cf3e2b93c2b7, 'Compote réussie ! 8 min au micro-onde puissance 900w. Magique. Merci ;)', '2022-04-05T09:00:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 77c47e8c-18d6-422e-afee-8d3d02e7a5b3, 'Très bonne recette, très simple à réaliser ', '2022-02-27T22:29:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, c602ac5a-146c-4d3f-95ce-b595c5229f41, 'Recette vraiment facile et rapide. Je n''ais pas mis de canelle il suffit d''un sachet de sucre vanillé. Je conseille cette recette vivement. ( Et pour se qui doivent se dépecher mais qui doivent prende un petit déjeuner en plus he bien cette recette est faite pour vous )', '2017-06-17T21:43:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 69d4d59c-4c92-4aab-a200-8ee08e2f2016, 'faites plusieurs fois - un vrai regal - avec des pommes goldens, je ne rajoute rien d autre merci pour cette recette simple, bonne et vite faite.', '2015-10-10T23:37:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 0fa1980b-8044-4adb-9024-3d08230cfafa, 'J’étais en manque d''inspiration pour mon goûter à 4h et puis je suis tombée sur cette recette ! Déliiiiciiieux !! Je me suis régalée ! Cuisson réussie (2min sans film étirable)! En plus c''est super facile, quoi demander de mieux ? ', '2013-07-03T18:59:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 7f3de58a-47c0-4b19-a75d-c0250cd32a46, 'J''aime bien cuisiner mais il y a des choses que je peux pas faire comme je suis jeune (donc ma mère veut pas) mais la c''est facile et bon. J''adore ça. Rapide, facile, pas de refus des parent franchement c''est super!!!', '2009-02-21T15:53:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 44587f34-9b08-472c-b2d3-21e30943a738, 'Cette compote est très bonne et rapide à faire. Mais il ne faut pas la cuire trop longtemps si on veut garder des morceaux. Et je trouve qu''une pomme par personne, c''est trop peu!', '2009-01-24T17:33:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 5925cb21-4817-4836-9425-7109c4fcb98f, 'Facile rapide, délicieux!! Saupoudrez de cassonade et gratinez juste ce qu il faut c''est un delice', '2007-09-05T15:43:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 3640a44d-d1f6-49d2-a880-65420b215aba, 'C''est une très bonne idée de cuire les pommes au micro-ondes! J''ai fait une portion individuelle (cuite en 3 minutes) avec 1 pomme, 1/4 de citron avec son écorce et 1 cuillère à café de confiture de framboises. Hmmmmmm', '2007-02-11T21:00:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, f82c68e8-f128-40fd-9728-5410875311f7, 'Excellent, surtout pour une 1ère fois! J''ai ajouté pour 4 belles pommes 2 sachets de sucre vanillé, on n''a pas résisté... C''est trop bon, merci. ', '2006-10-14T17:49:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, e3df0f39-909b-4b5a-b778-ebee55ed8fcc, 'Très pratique, mais vous devriez préciser la durée de cuisson suivant la puissance de chaque four.', '2005-12-22T18:39:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 88d75f61-d9bc-4c42-b3de-f563cbec860a, 'Moi, je lave les pommes et je les coupe avec peaux et pépins, et quand elles sont cuites, je passe au moulin à purée.', '2005-05-21T23:57:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 97c0240c-4d17-4021-a582-c49b5eebaadc, 'Très bonne recette, mais attention à ceux qui comme moi sont allergiques à la pomme crue, la protéine ne cuit pas au micro-ondes (contrairement au four ou à la casserole) et reste allergisante!', '2005-02-25T11:42:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 7c3b8d5e-6a47-4721-bd2c-6ea01d963273, 'J''ai rajouté du caramel c est extra ', '2023-07-04T15:43:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 70e981a2-8b19-42fb-b2dd-3d12bbf1dd1c, 'Très rapide, en plus c''est TROP bon.', '2022-11-14T19:23:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 7c0ca0b0-e556-4325-a7bc-62fb0337f23a, 'Tellement rapide pour un dessert au dernier moment !', '2022-10-19T13:31:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, a0804321-8368-446b-bc1d-0619406adb2f, 'Très facile et rapide !', '2022-06-14T12:02:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 701134ea-07ce-4ff4-9d99-0bd1bae7af8f, 'C’est super rapide moi j’ai mis du sucre et de la vanille délicieux ', '2021-11-05T13:27:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 2d95c4e8-e024-4dc1-932f-eee3beff5ad1, 'Simple et rapide. ', '2021-10-30T23:18:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, cb0ab64c-d03a-4233-be2c-aeb2fd0d3d04, 'Tres bon', '2021-04-11T14:33:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 71214646-82af-4eb2-971b-722d6c2b9369, 'Génial, super facile et rapide. Toutes les variantes sont possibles. Avec ou sans cannelle, avec ou sans sucre, avec ou sans vanille... Avec ou sans mixer si on préfère avec ou sans morceaux. Vraiment top.', '2020-12-09T12:54:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, e99c9a06-e8d0-41e7-8005-e15a21aea9de, 'Excellent et ultra simple, j''ai mis miel et spéculoos concassé à la place du sucre et cannelle, un délice !!!', '2020-04-07T22:19:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 21896209-f4bf-4021-9b21-d3542a30cc9a, 'Vite et bien fait. Tiède avec un peu de chantilly, un vrai bonheur.', '2019-04-25T14:52:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, cb272f1f-577d-4157-8d85-b6992987096f, 'Super rapide et excellent. Un peu de flocons d''avoine ou autres céréales donne un peu de croustillant. Idéal en dessert, en goûter ou même en petit dèj''.', '2019-04-17T23:12:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 8a30205b-3e1d-4b33-ab79-82cc74a30489, 'J''ai testé c''est super bon.', '2019-03-31T10:07:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, e43971a8-3036-4332-a2ff-454a38b415d2, 'Je n''ai pas mis de sucre mais une cuillerée de miel car chez moi la cannelle ne fait pas l’unanimité. J''en mets sur la table et celui qui aime en saupoudre sur sa part. ', '2015-11-12T20:59:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, fa88eda4-495c-4d6d-abde-9d45de2fc20a, 'J''ai mis un petit fond d''eau ce qui m''a permis d''avoir une compote un peu plus liquide ! 10 minutes de cuisson pour moi et j''ai remué en milieu de cuisson ! Et j''ai mixé le tout ensuite !', '2015-10-09T20:05:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, b7a85374-0737-47af-986a-f5415311cba2, 'Parfait, très pratique, pas mis de sucre ce n''est pas nécessaire, la cannelle parfume suffisamment. 10m minimum pour mon micro ondes à 750W', '2015-02-16T08:41:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 3f0431d8-5855-4f37-afaa-a9e2481813ec, 'Super ! ', '2015-01-23T17:52:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 29dfbbf8-1a70-47c2-80bf-292159ff19b6, 'Excellent et efficace avec de l''aspartame et hop voilà un bon dessert diétetique et 0 calories !', '2015-01-04T11:13:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, d3e3dee1-f014-461f-9791-85277daa5bca, 'Super rapide et facile à faire ! J''ai ajouté des copeaux de chocolat et un peu d''amande, délicieux !', '2015-01-02T20:57:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, ece8ce46-775e-43fd-9f12-928c101bd35c, 'J''ADORE ! ', '2014-12-01T19:27:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, c82a6cef-df04-4fd9-b8e2-9a7dd461d0a5, 'Facile rapide top! ', '2014-10-26T13:43:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 9e3adf5f-d833-4fd9-9473-bec9cf9e1f05, 'Facile, rapide, super bonne', '2014-09-22T22:05:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, f83c72eb-b551-46df-b595-d3b4f801ce20, 'On ne peut plus simple ! Je l''ai faite avec des fraises et aussi avec de la rhubarbe.', '2014-06-06T22:05:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 110fa976-80f2-4d18-b65d-8d0e44e7eca1, 'Trop bon', '2014-04-18T16:27:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 367bafbb-ca07-45f7-81f9-8373771bf0db, 'Voilà ma déclinaison de cette recette, inspirée  par les commentaires et ce que j''avais sous la main : une dizaine de petites pommes + un peu de sucre de palme + jus d''un demi-citron + un peu de gingembre + la cannelle. Cuisson 6 minutes avec boîte micro-onde. La consistance est mi-compote/mi-morceaux ; il y a du jus et c''est très bon !', '2014-04-08T12:20:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, d8096ab8-ef71-4180-a406-4093f5bf10a2, 'Bonne recette !! J''ai mis de l''édulcorant à la place du sucre.', '2014-01-26T19:33:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 9dc01168-fbce-4d30-8c0a-44da85a0aff3, '5 min avec un couvercle spécial micro-ondes délicieux mais trop long pour la puissance de mon micro-ondes, cela à gicler.', '2013-11-06T14:42:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 6fad0c87-17b1-4a28-9e5c-fa104674f42c, 'Simple et rapide. Testée sans cannelle car je n''en avais pas. A peine saupoudrer de sucre, les enfants ont adoré. Première fois que je faisais une compote.', '2013-06-26T19:28:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 32e63123-5c66-4b72-99e1-1dd93f7f66a5, 'Délicieux : j''ai mis du sucre et du mélange 4 épices Et un peu de crème liquide après la cuisson. Les enfants ont adoré !!!', '2013-03-10T14:09:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, c8a33138-95d4-4e9d-a5dc-5c627669756d, 'Recette ratée avec le film étirable et les 5 minutes de cuisson à 900W... Recette réussie avec 2 minutes de cuisson sans film étirable !! Très bon !! ', '2012-11-06T14:21:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 477eb09b-d488-45ba-86f0-a7c8c20d803c, 'Recette très facile à faire. J''ai utilisé du sucre vanillé à la place de la cannelle. Sinon, je trouve que la recette manque de sucre.', '2012-10-07T22:54:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 1583e3bb-25e6-4256-bcbf-81627bfe9992, 'Plutôt 5 pommes et 20 g de sucre avec un peu de cannelle.', '2012-08-15T20:13:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 4b4e6d17-b6be-4512-8b32-7429992314b9, 'Très rapide, très bonne et quelle économie d''énergie pour la cuisson. Comme j''aime la cannelle j''en ai mis mais pas de sucre, ça c''est une affaire de goût.', '2011-09-24T18:21:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 834d2b79-9f58-4244-b2ce-f87d1d299ba1, 'Très simple et tout aussi délicieux !!!', '2011-02-04T19:39:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 80dd7f0b-8de8-4c93-a2c4-5aa8e4292d05, 'Rien d''extraordinaire ; juste tout simple et tout bon. Tout de même la recette gagne à être agrémentée d''un jus de citron. Proportions pour 4 trop justes.', '2009-03-22T22:32:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, d03a1cb7-2162-4597-8584-4d2dd5548d65, 'Impeccable! Du sucre vanillé, un peu de citron, le tout passé au presse-purée puis déposé sur une pâte brisée maison et voilà ma tarte préférée : la tarte à la compote de pommes!', '2008-10-26T00:56:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 2ea3820c-5fa0-4919-9d6f-8193de173b74, 'Bah voilà, c''est super. Maintenant, je sais faire de la compote. Elle est pas belle, la vie. Etalée sur des crêpes, hummmmmmmmmmmmmm!', '2008-10-15T16:34:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 21e3a59c-829d-4760-ba41-79decb503ca7, 'Génial, une compote vite fait, et délicieuse.', '2008-09-16T18:07:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 0a42fc14-19c0-45b7-ab0a-b397422ab7b8, 'Rapide parfait, j''ai juste rajouté 2 c a s de cidre, un délice! Merci.', '2008-04-08T17:57:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, e60d8578-093b-4c1f-a3b8-4a6b297fccdf, 'C''est vraiment rapide. En un tour de main, mon bout de chou a eu sa compote maison ! C''est pratique pour toutes celles (et tous ceux) qui travaillent et n''ont pas beaucoup de temps pour cuisiner !', '2008-02-19T09:46:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 9bb12c0e-0c75-4857-9767-71d58909a6cf, 'Très bon et rapide, je n''ai pas eu besoin d''utiliser du sucre.', '2007-12-19T11:33:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 5a0040a0-2f0e-4a94-ab02-0c3aa7d4bf5b, 'Trop bon! Avec des pommes bien vertes ça fait l''affaire!', '2007-11-18T11:52:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 61f8e1f5-1c85-4da4-8da7-f9818f04e37a, 'Je viens d''utiliser cette recette pour accompagner du boudin noir. J''ai juste salé les pommes coupées. Bien sûr, ça ne vaut pas une compote mijotée pendant des heures dans une grosse casserole, mais mon repas était prêt en 10 minutes et je me suis régalée.', '2007-11-15T16:00:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 44ea281e-f71c-4153-a295-0de2b9a2ecf6, 'C''est vraiment une compote facile très bonne et avec juste que quelques ingrédients, mes enfants ont vraiemnt adoré !!!!!', '2007-11-06T14:12:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, eff6c216-4a84-483b-84be-d3bc5d1248b9, 'Tres bon, je n''ai pas rajouté de sucre mais j''ai mangé la compote avec une boule de glace à la vanille. Un délice', '2007-10-03T23:19:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 2996b27d-b2af-4a58-9f5b-b434285c17e9, 'Super facile, rapide et en plus délicieux ! Les enfants et moi-même avons adoré.', '2007-09-26T18:51:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20990, 395433c2-705c-4fc3-9361-74dd808bcd78, 'Très très bon et simple à réaliser pour accompagner des crêpes! j''ai mis de la cassonnade et de la cannelle! miam! ', '2007-08-31T20:56:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227615, a331ec28-6adb-4092-9ed2-38e1152a24c9, 'Dessert préféré de mon mari ! Vraiment excellent ! ', '2023-03-10T14:46:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227615, 1878d51e-93c5-4847-8b31-f895305d2d49, 'Rien a changer sur cette recette; facile, rapide, très bon... 5 étoiles ! 

(Je n''ai juste pas mis de jus de citron)', '2021-02-05T12:00:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227615, bce78481-af10-4b7d-a538-97b100ff91ee, 'Super bon ! ', '2015-03-04T05:26:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227615, 5aceefd4-965a-4ef2-aead-9087b128e461, 'Une tuerie cette recette ! j''ai eu un succès fou !', '2014-10-26T13:43:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227615, 1d0be79c-6d9f-42a6-8a2a-c8648af2c6fb, 'Un vrai délice ! Je l''ai testé car j''avais envie d''utiliser de la bonne vanille, et l''association avec les framboises est top ! Pas écœurant du tout pour une fin de repas. La présentation est super jolie en plus, en petite ou en grande verrines. Super, merci !', '2014-05-11T21:27:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227615, 005758cd-1bdd-45c2-ac1b-f3020c00ef29, 'Recette réalisée 2 fois et c''est un régal. Pour ma part j''utilise des palets bretons... C''est succulent ! ', '2014-02-28T13:30:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227615, 249331ed-db51-4020-b4d2-a060f970d93b, 'Du bonheur!', '2013-08-27T14:52:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227615, 1637c53e-8b36-4529-b19d-55dab7eb897d, 'Le goût est excellent mais la tenue de la crème n''est pas top... Un peu liquide en fond de verrine. Quelqu''un m''a dit qu''il convenait de changer la proportion jaunes d''œuf/blancs d''œuf.. Il faudrait le doubler de blanc d''œuf en fait..', '2013-07-30T12:21:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227615, 45028b81-673d-435b-8280-0184588e5b4b, 'Excellente recette mais moi avec une double dose j''ai obtenu 24 verrines. C''est très frais en fin de repas. Recette à refaire !', '2013-05-12T12:28:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227615, c23990a2-3dab-4b2b-80a1-e1886c650c06, 'Trop bon !!!! Recette au top ! Merci !', '2012-12-09T16:16:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227615, 65a0dd27-f715-4fa6-89ca-466915bb0af6, 'Excellent ! Je le fais sans coulis et avec des spéculoos à la place des sablés bretons, et j''ajoute juste avant de servir des copeaux de chocolat noir dessus. J''ai toujours fait avec du sucre blanc mais le sucre roux et sucre vanillé donnent un bon petit gout agréable. Les quantités correspondent bien. Bonne recette à garder. merci', '2012-12-07T21:18:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227615, 46244b2e-bbbf-447f-bba7-4af4474b5dba, 'Pas de sables alors j''ai mis des valets bretons. Recette excellente et facile. Merci', '2012-11-01T18:36:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 2e81e23b-01c8-42ce-a473-da5cb4521bbf, 'Ce potage est onctueux et délicieux au goût. Une petite remarque pour toutes les recettes: Il est plus pratique de connaître le poids des ingrédients à mettre que leur nombre d''unités. Rien que dans cette recette-ci, il y a des carottes, des poireaux et des pommes de terre de tailles très diverses.', '2019-11-17T11:43:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, d409e664-4066-4266-8330-42fd0cfd1bee, 'Super.', '2020-02-29T18:19:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 4e7dd977-9c7d-4ca1-81ae-b4837587fba4, 'Excellent ! La recette peut être légèrement adaptée suivant ses gouts.', '2018-03-04T15:57:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 34c3793a-6860-40ee-b604-e7445dbb6b3b, 'Super bon, tout le monde a adoré. J''ai mis de l''ail et plus d''eau car c''était trop épais ainsi que du sel et des épices en fin de cuisson : coriandre, curcuma, gingembre, piment d''Espelette... J''avais coupé les légumes très fins et du coup, j''ai servi la soupe telle quelle sans la mouliner.  Rien à voir avec la soupe de légumes traditionnelle. Recette gardée précieusement. ', '2017-01-27T14:12:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, c9131b95-ba61-48b8-9633-492729ab7a0a, 'Délicieux', '2017-01-26T21:27:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 3a6b0366-a289-4dc6-b3ac-7952e7b7eb87, 'Très bon même sans bouillon.', '2012-02-20T23:09:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, a332798b-9fcc-4b3b-8a1e-66c9d6c08b52, 'Trop bon !', '2023-01-07T22:50:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 4be07b63-8ead-411d-ad25-ad221e6c7a4a, 'Très bonne, je n''ai rien changé à la recette !', '2022-10-26T00:22:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 0787530c-b88a-410d-8517-6120dcb4690c, 'Très bonne, j’ai mis des carré de fromage frais à la fin de la soupe à la place du lait. 🤤', '2022-05-13T22:03:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, e16e9b53-63e3-4200-b05f-a76f13dc4596, 'Très bonne soupe, un chouïa de muscade, bravo et merci', '2022-04-28T21:02:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, bf55cada-5035-4c4a-bc88-c1cd51dbd6c3, 'Un régal cette recette 👌🏻', '2021-11-30T12:57:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 4555911d-cb82-4887-b612-69f0b21daf34, 'Très bon. Cette soupe plaît beaucoup. J''y est rajouté des morceaux de saucisse de Morteau c''est excellent...', '2021-11-16T19:18:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, a334d2d7-ce09-4c06-a37d-1cd134c14d05, 'Delicieux, ma première soupe !!', '2021-03-11T21:37:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 0eefbd15-6567-42ab-803a-6644926b66d0, 'Délicieuse ; il me restait 3 navets que j''y ai ajouté également.', '2021-01-31T20:31:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 994fb7d4-df8a-4482-a64f-1b93a7d2e0d7, 'C''était ma 1ère soupe maison. Et j''étais fière de moi grâce à cette recette !! Donc, merci. ?
Je n''ai mis que 2poireaux  et ajouter 3cuillières de crème fraiche épaisse à la toute fin. Un délice.', '2021-01-30T01:51:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 155d2811-36ba-43e3-8fd0-a96b69d4e045, 'Très bonne', '2020-12-07T20:08:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 43d23dfd-e8a0-46c3-9f38-c26c6c7ee4b8, 'Un délice. Surtout en rajoutant une saucisse de morteau ou des diots (ou autres saucisses selon vos préférences )', '2020-12-02T11:10:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 87401304-3726-4741-8885-1dc75a1b63ed, 'Bon potage, j''ai mixé je préfère. Le plus long : la prépa des légumes mais pas le choix si l''on veux du fait maison bien meilleur et l''on est content du résultat. Recette validée par toute la famille même la plus difficile, à refaire !', '2020-09-29T13:54:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, faec572d-d02b-4a3f-bdbc-823ad474ad4f, 'Je n''avais pas de poireaux sous la main, mais j''avais tous les ingrédients; Je n''ai pas mixer le potage, j''aime bien, dans un potage que tous les légumes soit découpés en morceaux ou dés,...', '2020-09-16T17:34:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, c1ce6046-bd9f-499c-bee8-1b6ca3a6816e, 'Excellente !  !  !  !', '2020-01-19T15:53:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, da1b5877-37a0-40b2-bafc-0ad165825332, 'Très bonne recette.', '2019-10-20T08:56:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 290a7373-0121-409e-acac-6c1d3fe3289a, 'Juste délicieux !!! Rien à changer !!', '2019-04-02T12:51:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 5a5b7b33-de1a-480c-9b85-3910518bb4c5, 'Un régal, merci !
Je n''avais plus que des bouillons de légumes, ça allait très bien. ', '2019-03-24T10:17:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 08ffe09e-c794-4a1b-b1b1-e0998d397891, 'Cette recette est tout simplement parfaite ! Mon mari ainsi que mes enfants se sont régalés (ce qui n''est jamais cas lorsque je leur sers une soupe). Je vais la refaire régulièrement. Merci pour cette délicieuse recette.', '2019-03-19T18:42:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, c030138f-cbc9-4c27-b18c-ba799c566335, 'Facile et très bonne !  !', '2019-01-24T18:50:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 662530a5-042f-4380-94ed-7ec3f8d732da, 'Facile et goûteuse ! Un régale !', '2019-01-03T21:16:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 5ec3dbc3-ae9a-4ff4-abc0-67e3a3c4a31d, 'Excellente, merci pour cette recette', '2018-11-18T21:14:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 61a70e04-3cef-40ad-ac60-377e49c52204, 'C''est une soupe que ma mère me faisait très souvent quand j''étais petite, depuis que j''ai mon propre chez moi je n''avais jamais osé la refaire, et celle-ci est vraiment parfaite ! Merci beaucoup.', '2018-10-24T11:58:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, bd8326d7-1541-404c-8b2f-9afa0b7f09cd, 'Soupe délicieuse ! Très réconfortante et pleine de vitamines pour affronter l''hiver', '2017-12-27T18:50:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 49716b31-0f2d-40d4-888d-a4a838a22056, 'J''ai réalisé cette recette avec les moyens du bord (donc juste un blender, et pas de mixeur plongeant) et j''ai mis un oignon entier au lieu d''un demi. C''était vraiment super bon, merci pour cette recette qui fait du bien par ce temps froid: D', '2017-11-13T21:30:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, b1ceb3dd-0574-42fd-ae1f-b05386d2c730, 'Super recette ! Très facile pour débuter dans les soupes maison. J''ai mis un seul cube de bouillon et c''est suffisamment salé.', '2017-09-27T23:40:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 68751482-57ff-4075-bd8c-5a1c6788f1bf, 'Facile à faire et très bonne ! ', '2017-01-14T19:35:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 42cbfedb-b2b0-4e74-95fa-cb992a9e6e54, 'Recette suivie à la lettre et qui a rencontré un beau succès auprès de toute la famille.', '2016-11-15T10:10:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, e3cae3a8-bc7f-4816-bc37-7f7381bada14, 'Très très bon. Nous étions 2 donc un poireau, une pomme de terre et une carotte ont été suffisants. J''ai ajouté un peu d''ail semoule avec la cuisson de l''oignon. Miiiam. Merci pour cette recette, ce soir rebelotte.', '2016-11-14T12:32:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 2866591f-289d-4273-9eb6-7415d5150a5a, 'J''ai trouvé le potage un peu trop épais, trop de pommes de terre. Le bouillon de volaille lui donne un bon goût.', '2016-11-03T19:51:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 0f5fc149-bc49-4579-8d19-8c2384fb258e, 'C''est tout simple et c''est bon. J''ai remplacé les bouillons cubes par un bouquet garni (laurier, thym, persil). En cuisson à la cocotte, j''ajoute le lait à la fin en mixant la soupe et je refais bouillir.', '2016-04-30T19:50:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, f4722de2-e111-4017-b527-46567bee5f86, 'Délicieux!!! J''y ai ajouté une fois sorti du feu de l''ail frais pressé pour un peu de peps. Vraiment bon. Je referai!', '2016-01-23T16:40:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 2a86c0fa-8d6f-441b-9f7c-e0a7f0c7f8a5, 'Excellent. Par contre attention en cuisson cocotte minute ... en cuisant dans le lait au moment d''enlever la vapeur, éclaboussures importantes ... c''est toujours vrai quand on cuit dans du lait en cocotte - préférer la cuisson 30 minutes en casserole.', '2016-01-16T17:05:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, c9bb9327-86f6-4a38-9858-a29658cf67fd, 'Excellent', '2015-12-28T20:13:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 828be8e1-7b53-40d4-a412-76c9201071f2, 'Ce potage est un régal pour les papilles, consistant et rustique ', '2015-11-19T09:59:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 0c757c87-b6e4-4ce5-87e7-8195204fd464, 'Un velouté... Un vrai régal pour toute la famille, même pour les ados. A refaire', '2014-12-28T22:36:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 56210b35-b1b4-41bd-a7b5-527d07b111f7, 'Excellent. Ce serait bien par contre de préciser le poids des poireaux... J''en ai mis 2 gros, en supposant que cela faisait 3, et j''ai adapté les autres quantités en conséquence. In fine, un peu épais, mais cela donne un délicieux velouté de poireaux. L''oignon est bien présent, ce qui relève le tout comme il faut.', '2014-11-29T21:51:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 0638c544-132d-46b0-aa22-14f45c8ac242, 'J''ai mis du lait d''avoine et du bouillon de légumes et n''ai pas ajouté de poivre. Résultat : un excellent potage ! Merci pour cette recette.', '2014-11-25T09:00:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 7cfed1f5-c7ef-4025-a9e5-61269271b819, 'Excellent !', '2014-01-25T15:46:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 2b952806-93ce-447b-bc54-2e39bd39e463, 'Très bon', '2014-01-07T22:19:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, b7e89b38-6298-4ae4-b07f-af805c03a0e0, 'Très bon mais un peu long. J''ai remplacé un des bouillons de poulet par du Kubor car je préfère le goût. Si je devais la refaire je mettrai seulement la moitié d''un oignon car trop prononcé. ', '2013-03-20T23:19:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, a08c7250-ad42-4eb4-93ab-1f95a7207818, 'Un délice. ', '2013-02-22T14:27:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, fb65c0fe-f457-43e0-b780-31bdfcf1262e, 'Merci pour cette recette. Par contre, j''ai utilisé des légumes surgelés, ce qui n''était, de ce fait, pas évident pour les quantités. J''ai peut être mis un peu trop de poireaux. Néanmoins elle est très bonne.', '2013-01-30T10:16:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 28d4f773-9db8-4554-9656-e26ef02d86f1, 'Merci pour cette excellente recette. Absolument délicieux et épais comme il faut ! Pour ma part, j''ai simplement ajouté un pointe de curcuma.', '2012-10-08T20:10:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 3e8f03b9-520e-4a85-9b95-3f7981f49fe9, 'Très bonne recette. J''ai laissé cuire un peu plus longtemps mais sinon, toute la famille a apprécié ! ', '2012-10-04T22:21:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, eae1710f-accf-4bb6-a5ca-a3ffcc22c391, 'Cette recette pourrait paraître simpliste, mais le résultat donne un potage riche en saveurs et velouté.', '2012-09-30T23:26:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 20bef1c4-5663-41b6-9f40-9727eccdc871, 'Excellent ! J''ai remplacé le lait par un peu de crème fraiche. ', '2012-09-30T21:01:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 91c31750-4b57-4fa2-b578-78e5c6b784f6, 'Exquis, très onctueux et savoureux. Un vrai régal équilibré. Je vous la recommande !', '2012-02-15T21:29:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 7778731c-5c60-4e4b-8606-03a866a168ef, 'Très bonne recette. Simple et économique !', '2012-01-25T22:29:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 8ca009be-626b-403b-ba14-a62315d6fce2, 'Très bonne. Je n''avais pas de cubes alors j''ai fait sans mais c''était quand même un délice !', '2011-12-16T22:54:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, b2929b16-3c65-4535-bedf-59ecb97b7b68, 'Soupe excellente car très crémeuse. Mon mari et moi avons adoré !', '2011-11-02T21:53:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 7a76a21b-a3f9-4433-8ac7-babb60d9b121, 'Hmmmm quel régal !!! Bébé, mari et moi nous sommes régalés !!! Merci pour cette recette que je m''empresse de mettre dans mes favoris ! ', '2011-10-09T13:55:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, d7901487-4b2b-46c1-9b53-eb2a346cdaf1, 'Pour moi (et le reste de la famille (42 ans et 7 ans), c''est la meilleure. Très simple, rien à modifier, elle est goûteux et permet de manger tout plein de bons légumes. A faire, re-faire, re-re-faire... ', '2011-03-28T21:02:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 424fe9ee-7a86-44b7-8fb8-5ed05fefad29, 'Très bon.... simple et très bon.', '2010-01-05T19:45:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65812, 379de3c2-c19c-4fac-8fcd-1acfb0da21ec, 'Simple et bon!! On dirait le potage de ma mère ... ce qui fait qu''il a un bon goût d''enfance. A refaire peut être en y ajoutant des épices pour davantage d''originalité.', '2009-03-08T14:06:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 5f4cd167-b43a-47cc-a84d-915b66d8947c, 'Sans précuire, j''ai coupé les pommes de terre à la mandoline (très fines). Dans des cassolettes individuelles en rajoutant un peu d''aneth, un soupçon de sel et une pincée de muscade. J''ai recouvert de lait et ai passé au four à 180°C pendant 1h20 (en couvrant en fin de cuisson). C''était parfait. ', '2012-01-19T14:03:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, c4cdbdba-a6e9-4c52-be16-0b26c963a996, 'Excellent, j''ai remplacé le gruyère par de la mozzarella entre les couches de saumon et de pomme de terre, cuit les pommes de terre dans mon cuiseur vapeur et utilisée de la crème fraiche épaisse ensuite j''ai arrosé le dernier étage de crème liquide en petite quantité puis parsemer de gruyère, pas de lait. Excellent vraiment. Plus poivre et 4 épices   ', '2009-11-23T23:05:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 1f4062b4-4fc7-4105-88cd-de9d3345b42e, 'Ce gratin a eu beaucoup de succès auprès de mes invités. Très bon plat pour une recette plus que facile et qui épate.  J''ai juste ajouté un mélange d''épices à poissons sur la première couche de pommes de terre. Je vous la conseille pour un diner entre amis ou pour épater belle maman !', '2008-12-08T17:38:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 40aba399-f9f0-4455-87cf-0183022851de, 'Très facile à réaliser, mais ne pas hesiter à mettre pas mal de lait sinon cela devient vite sec! J''ai rajouté quelques herbes pour relever un peu le goût et je l''ai fait cuire moins longtemps. Une bonne variante!', '2008-01-16T16:02:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, eb941795-0d63-47a8-8921-5862e3c45618, 'Délicieux ', '2023-05-02T15:21:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 07c17000-655d-4cca-9344-8af1a7ea9378, 'Super recette, facile à réaliser et excellente ! À refaire.', '2022-09-25T18:28:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, a73a19e6-5103-4c55-bbe8-2fd9cdcd71ff, 'Super recette ??', '2021-01-24T15:06:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 427f8d2a-16ce-4f28-9f03-eb36cc0151ae, 'Très bon, j''ai juste diminué un peu la crème pour y mettre du boursin cuisine c''était pas mal.', '2018-03-31T12:40:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, e0daef22-4f9f-49c5-a64a-93f2efed5ba2, 'Bon gratin, j''ai préféré faire des rondelles de pommes de terre plutôt que des dés. Dans mon cas, il y avait un déséquilibre car trop de pdt par rapport au saumon. Je vais tenter à nouveau la recette.  De plus, j''ai fait précuire les pdt dans du lait, comme un gratin dauphinois. ', '2015-05-27T17:23:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 6720d022-99ad-4712-b41b-c29ca1d389eb, 'Simple et très bon. J''ai mis pas mal de lait, même s''il en restait après avoir vidé le plat, pour être sûre d''avoir un gratin tendre. Par contre, la prochaine fois, je doublerai la dose de saumon, trop peu pour 6 personnes.', '2014-07-22T22:55:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 6a8fa296-71c2-45ce-8ccf-24b8acb855b3, 'Excellent j''ai ajouté de la ciboulette', '2013-10-22T21:57:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 8bcb6ea8-18a4-49dd-9809-7c821c0e247a, 'Excellent ! J''ai ajouté un peu de ciboulette et c''est un bon gratin qui passe bien en toute occasion !', '2013-02-14T23:11:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 95f97ca9-51de-4e50-ac27-fc29aa065954, 'Très bonne recette, facile et rapide à réaliser qui a toujours plu lors de mes repas.', '2012-08-01T01:21:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 74f865d9-7625-4112-a52e-cc8ca0697850, 'Très très bonne recette. J''ai fait cuire à la vapeur les pommes de terre 8 minutes à la cocotte. J''ai procéder ensuite comme sur la recette sauf que j''ai mis de la crème liquide à la place du lait. ', '2009-11-16T13:38:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, b1525ba8-e489-4fd1-ad26-9b00ae8741f2, 'Le 1 c''est juste pour l''idée parce que c''était vraiment immangeable. Les pommes de terre n''était pas assez cuite (même en allongeant le temps de cuisson) et ça baignait dans l''eau, c''était fade, je suis vraiment très déçue.', '2009-10-22T23:34:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, f8baaac4-3fe7-4a92-8905-fc269981247e, 'Que du bonheur! Excellent, j''ai juste mis un peu d''anis pour relever le goût. Recette suivie à la lettre.', '2009-05-01T22:22:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, d76bc76b-1ee4-4e0a-bf1c-5133fcc4fc18, 'Bon rien à redire.', '2009-01-06T15:43:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, f3eb4293-9d24-4334-aaac-9f1879199a12, 'J''ai fait précuire mes pommes de terre (coupées en rondelles) 5 à 6 minutes dans le lait. J''ai aussi ajouté un peu de chèvre. Je l''ai mis au four 40 minutes à 160°C (thermostat 5-6), ainsi mon gratin était très moelleux.', '2008-11-29T16:46:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 78f24c45-c7ae-4fb7-bdd1-8a97ad9db2f3, 'Recette très bonne, pratique et rapide à préparer (bien que longue à cuire)!! J''ai rajouté des courgettes pour que le gratin soit moins sec. J''essaierai la prochaine fois avec des poireaux. J''ai aussi fait poêler les pommes de terre avec sel et poivre dans une noisette de beurre, après les avoir précuites environ 15 min. J''ai bien aimé... à refaire!!! (surtout que l''hiver arrive) ', '2008-09-30T01:05:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 9b298ddf-8358-4124-a7d0-84502d02aa92, 'Excellentissime!!!  J''ai fait cuire mes pommes de terre (chair ferme) à la vapeur, déjà tranchées comme un(e) autre internaute, ajouté quelques morceaux de poireaux... (à refaire) !!! Je n''ai ajouté qu''un peu de lait (de chèvre, dans mon frigo) que lorsque j''ai vu que le gratin commençait à se colorer. ', '2008-09-28T13:18:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, ee1a27e8-4e5d-409b-ac77-2128c3d4c70e, 'Je n''ai pas fait exactement la recette, mais je mets la note de 5 pour la base, j''ai rajouté du boursin ail et fines herbes, crème liquide et basilic dans la crème. Délicieux, mon mari a aimé lui qui est très difficile, merci.', '2008-09-10T15:03:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 72f78694-03f7-424b-8051-2dcaed040516, 'J''ai doublé la quantité de saumon et j''ai bien arrosé de lait comme indiqué dans les commentaires. J''ai fait cuire les pommes de terre en dés au cuit vapeur 8 min au préalable. C''était excellent!!! Merci pour cette succulente recette très simple à réaliser.', '2008-09-01T13:31:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, bc416ea9-7928-400d-bb6f-5da07af40d22, 'Gros succès pour cette recette. Merci!', '2008-08-19T23:44:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 2564e5dc-81eb-4d7f-a0a5-03fe89544422, 'Très bonne recette, les différentes saveurs se marient très bien (j''ai ajouté aussi un peu de chèvre, comme indiqué dans les commentaires). Ayant utilisé de la crème fraîche liquide, ce n''était pas sec du tout, mais les proportions sont quand même à revoir: pour un plat de la taille indiquée, 3 kg de pommes de terre, c''est beaucoup trop!  2 kg, c''est un maximum. Par contre, la quantité de saumon est au moins à doubler..... ', '2008-06-15T13:31:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 644c27a8-2b28-49dd-8ce5-afdad07569ad, 'Repas raffiné et pratique puisqu''il peut être préparé la veille. Je rajoute des poireaux au pommes de terre et du chèvre mélangé à la crème fraîche. Délicieux mélange de saveur... vous ne le regretterez pas...', '2008-05-17T16:27:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 6b83d662-2d78-47e6-896a-c18bb963cc90, 'Très bonne recette... originale et simple... J''ai écouté les conseils... J''ai fait cuire les pommes de terre à la cocotte 5 min et du lait jusqu''à moitié du plat... Délicieux et pas sec du tout !!!', '2008-04-24T23:00:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 56f7fe47-e902-43e9-8cb0-9c3018a2172b, 'Délicieux et toute la famille peut en manger. Faire simplement cuire les pommes de terre un peu plus et c''est parfait!', '2008-04-11T13:45:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 4bbe9dbf-1681-4d3d-be16-cef2fe833670, 'Délicieux et facile. J''ai rajouté un peu de basilic avant de mettre au four ça relève le goût.', '2008-03-04T20:44:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 61f47115-096d-4fe6-9e0d-26a1d2196d0f, 'J''ai fait cuire les pommes de terre plus longtemps, ça réduit le temps de cuisson du gratin (35 min). Et n''oubliez pas l''aneth, ça change tout!', '2008-01-20T16:08:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 34525f4f-5a6d-4fdd-9cd1-0f801f343332, 'Un régal, tout le monde a apprécié ! J''ai rajouté de l''aneth qui se marie à merveille avec le saumon et pas mal de lait d''après les conseils précédents.', '2008-01-08T11:37:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 40b2e157-ebf6-4d25-bb19-60bb143bc197, 'Recette vite préparée, toute la famille apprécie et en redemande,avec une salade, c''est parfait, bravo.', '2007-12-03T18:24:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, a0a18523-bdee-4f70-805a-03de5ad30d91, 'Très bon ! Simple et rapide.', '2007-11-14T23:30:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 036fc43f-0c45-4278-9e35-6c1d0c2fb27b, 'Merci pour cette recette, c''est excellent, très facile à faire et en plus ça impressionne les amis.', '2007-11-05T22:14:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 6c2f7948-3d41-447b-9501-70c9ff31de6f, 'Vraiment excellent !!! Rien à redire, nous nous sommes vraiment régalés !', '2007-10-29T22:18:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 5ab96fd6-5f82-436a-9e31-8d5fa95af55b, 'Simple et très bon. 45 minutes au four suffisent.', '2007-10-24T13:57:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 03af0664-587b-490d-aba8-1a195626a2e1, 'Ça change du gratin classique, c''est très bon !', '2007-07-27T02:01:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 1651b5fc-31c0-438a-8538-d7e47da414a5, 'Ce gratin est délicieux, il est facile, rapide ! A conseiller.', '2007-06-25T13:18:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 441c1fc0-0a76-4511-ba1e-237ac5093bf2, 'Super, très bon, j''ai oublié de mettre le lait, mais pas de soucis, on s''est régalé!! J''aime ces recettes qui sortent de l''ordinaire. Merci encore. ', '2007-06-20T13:03:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 065b102b-ef14-45ff-8d3f-8c2182cf3163, 'C''est très facile à faire mais j''ai trouvé ça un peu sec. Il ne faut vraiment pas hésiter à submerger de lait, et rajouter plus d''herbe et épices. J''ai ajouté beaucoup de sauge et ça rend bien.', '2007-03-27T22:35:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, c7618201-e46c-44e8-a2d8-88cc3d967bec, 'Rien à dire: Parfait!', '2006-12-24T15:20:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, c786c649-e7d6-4e9e-8537-bd6ab9d9db4c, 'Tout simplement parfait!! J''ai rajouté un peu de fromage de chèvre, ça se marie très bien ! ', '2006-11-30T21:08:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 1c931878-109f-4000-98cd-7feba0b0cded, 'Délicieux! Simple à faire et très bon. Par contre je suis d''accord avec l''un des commentaires précédents : 1 heure de cuisson c''est trop long. Je l''ai laissé 45 minutes et c''est suffisant, bien cuit et bien doré en surface. Recette à refaire...', '2006-11-21T12:57:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, aceaadf0-b329-474e-ae91-b8950880dcc3, 'Tout le monde a adoré, des plus petits au plus grands. Parfait avec une bonne salade, un repas vite fait et délicieux!', '2006-09-28T05:26:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, f5a45269-d182-422e-b443-41ea459e1a8b, 'Excellent... Vraiment facile à faire mais une heure au four c''est peut-être un peu trop long. A rajouter par la suite des herbes de provence, super goût au final.', '2005-09-06T12:27:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 41c695ce-50d3-460b-b523-3f72ee123d2c, 'C''est simple et délicieux, mais je rajoute de l''aneth à la crème cela donne un goût divin, je refais de temps en temps la même recette avec des tagliatelles.', '2005-03-31T11:27:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 35bd7bd9-794f-420e-b717-3c16649c8fc4, 'Le plat préféré de toute la famille! Je l''ai fait 2 fois, il est très bon et bien fondant!!!', '2004-12-15T19:30:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 7a0ac7f8-a1e4-4aad-9e85-7e6593ef3121, 'C''est très bon. Je fais cuire les pommmes de terre seulement 10mn, je rajoute un peu plus de crème et le résultat est ultra-fondant.', '2004-04-02T12:36:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 065fee0f-e4b8-4d74-97a9-dd38b049de42, 'Excellent avec une salade!! Merci.', '2003-08-14T09:55:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, d097b1cb-f68b-4a12-b76b-5a96397a1d32, 'Excellent!!! Facile à faire. Bravo!!', '2002-01-22T12:53:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 179e40bf-f146-4110-9ebe-d29574d22b53, 'Un excellent plat pour un dîner accompagné d''une salade.', '2001-12-25T19:08:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12281, 0cdfcbb2-5b2b-491e-8bec-532aee873d12, 'Rajouter davantage de lait, car sur la recette il est indiqué ''un peu'' et cela fait juste. Le gratin reste encore sec!', '2001-11-12T20:39:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41161, f6afff5e-ea82-4797-b12b-bcfc13c78254, 'Elle est très  bonne mais je crois que j''ai mis trop d''eau 😕 donc la prochaine fois j''en metterai moins et là elle sera extra😉', '2023-11-09T22:09:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41161, ce310f7b-67dd-4f31-9900-4aa100219161, 'Faite et refaite. Toujours aussi top. Je remplace la crème par du lait de coco et je sers ce velouté avec des marrons émiettés.  Lorsque je reçois des invités, j''ouvre le repas avec ce velouté dans de petites verrines avec les morceaux de marrons et je décore avec une tige de ciboulette. Toujours appréciée.', '2017-01-21T21:22:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41161, 2a821639-ca8a-418b-99f0-c8e0cd88d36b, 'Excellent ! Très bonne recette ', '2023-11-02T11:33:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41161, 7cfaef74-7834-45ff-bd7c-0a1de44fa7e4, 'J''ai remplacé les pommes de terre par des châtaignes 15 minutes avant la fin de la cuisson ! Excellent !', '2022-12-19T18:55:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41161, 5ae9638b-172a-46e0-a0cf-71b8b0a45e67, 'Super bon velouté, et en plus j''ai ajouté quelques lardons cuits avant et quelques croûtons.', '2022-12-14T18:46:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41161, 17aff563-9c6c-4800-8eb0-27fd74e3a6d8, 'Excellente ! Vite prête et aussi vite mangée !', '2022-11-27T20:21:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41161, e4c81d1f-ffc3-45fc-8a5d-99b4be9bc038, 'Super recette, simple et efficace.
Un peu de lait de coco n''est pas de refus non plus au moment de mijoter !', '2023-01-17T12:33:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41161, e4e281ab-e617-4ed4-a580-dd70409b93df, 'Un vrai délice, on a ajouté des croûtons, on s''est régalé !!!', '2023-01-04T21:09:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41161, 003891d0-45bd-4db4-a569-37299cefc5a0, 'J''ai respecté la recette à la lettre : très bonne !! Tout le monde s''est régalé ! Une des meilleures recettes de soupe parmi les nombreuses que j''ai testées ! 😀', '2022-10-08T07:43:22+02:00');
