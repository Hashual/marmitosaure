INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 943f6dda-4ce0-4787-9ff0-2d86f14c842c, 'Super recette ! Je l''ai faite avec un mélange de fruits rouges surgelés et c''était délicieux !', '2020-09-03T23:15:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 0b7eb062-dce9-4b59-b8d2-6d77eb8b3f23, 'Cette recette est super mais elle prend beaucoup de temps avant de la manger. Mais c''est réussi.', '2020-09-03T17:16:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 295c2747-bb9c-4208-b0ef-423854976330, 'Faute de boudoirs, je les ai remplacés par des biscuits spéculos trempés dans du café, et j’ai mis des fruits rouges à la place des framboises, c’était parfait.', '2020-01-05T08:12:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 6bff0576-7b57-4910-9be9-3542af37e4d1, 'Excellente recette c''était délicieux j''ai juste remplacé les boudoirs par des palets bretons j''adore le goût et à la maison ça a fait l''unanimité merci.', '2019-06-01T04:23:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, a8367945-f7ea-4228-88bf-9bae0df04dab, 'J''ai fait  cette recette avec des biscuits roses de Reims, le coulis de framboises est suffisant pour humidifier les biscuits, très bonne recette.', '2019-05-30T05:40:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 2081561f-a466-407e-a8cc-38fcdabc9af3, 'Merci pour cette super recette, j’ai vraiment pris plaisir à réaliser ce dessert surtout que je ne suis pas une cuisinière aguerri. Je recommande c’est Light - je mets moins de sucre et je prends que des produits frais pour plus de goût.', '2019-05-01T12:42:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 685766cf-10dd-4e41-86dd-592fd02c8ef1, 'Je remplace par des biscuits de Reims ou des Spéculoos : Excellent !', '2019-03-12T23:20:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 7b00ea26-1ef8-4344-a3aa-2f84a91fedb9, 'Excellent. Merci !', '2018-08-30T11:43:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, fb1f0f9f-f47a-418c-b917-ae22d9b1060a, 'Excellente recette, réalisée en verrine avec 60g de sucre au lieu de 100. Idéal pour un dessert léger après un gros repas !', '2018-08-27T14:33:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 60797f14-aec6-40b4-b985-6fcaa9746d60, 'Parfait, à faire et à refaire. Si vous voulez encore mieux : émiettez des meringues sur le dessus au moment de servir, ça donne du croquant, c''est un régal.', '2017-06-19T13:08:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 840cbc8b-ac26-4b35-92dc-85db3f149344, 'Excellent ', '2017-01-07T00:11:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, ccc18b07-c37f-4efa-8401-2315b2176e24, 'J''ai fait confiance aux commentaires déjà déposés en ce qui concerne le sucre. Moitié moins et c''était excellent. Rapide à faire.', '2016-06-08T15:34:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 726e4777-a57c-4066-ab7a-fa14f956bea1, 'Super recette. Si vous avez oublié de le faire la veille et que vous avez 3h devant vous, alors 40 minutes au congélateur, et après direction le frigo. Et c''est au top. Recette à faire avec tous les fruits que vous voulez. ', '2016-05-14T12:41:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, f998addc-23db-46cc-902d-1fab3aa9e6e3, 'Recette excellente !!! Un vrai régal ! C''est frais et léger, je l''ai préparé la veille au soir et manger le lendemain midi. Tout le monde a adoré, tout est parfait il n''y a rien à changer ! Merci pour cette très bonne et délicieuse recette !', '2015-05-04T17:44:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 68b51baa-4b8b-4071-82b8-1a2da6c682ea, 'A chaque fois que je le fais, un grand succès ! Je suis scrupuleusement la recette, avec des framboises surgelées. Je ne mets donc pas de lait sur les gâteaux. Pour un grand plat sabot, je le fais 48 h à l''avance. 24h pour un plat plus petit ou des portions individuelles. Merci !', '2015-03-03T19:21:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 804384cd-ad7a-478d-b450-8aecf2978a57, 'Moi je fais tremper mes biscuits dans un sirop eau/sucre/confiture de framboise : c''est juste meilleur.', '2014-07-30T00:18:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 94fc2fa1-8b0c-45da-9bf7-abca140da7a3, 'Super ! D''ailleurs, je le refais demain pour d''autres invités. Toutefois, j''utilise deux couches de biscuits et donc je partage les framboises en deux afin que ce soit moins trempé car nos framboises de jardin sont très juteuses. Grand merci à l''auteur de partager cette bonne recette.', '2011-08-19T22:32:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 3114f874-f1f5-494e-bb56-bdfa8dc3a8bf, 'C''était la première fois que je tentais de faire un tiramisu. Mes invités ont tous très apprécié et sont partis avec la recette. J''ai suivi les conseils : j''ai préparé 48 heures avant, je n''ai pas sucré les fruits, je n''ai mis que 60 g de sucre dans la crème et il n''est pas nécessaire de tremper les biscuits dans le lait. J''ai présenté dans des verrines. J''ai hâte de refaire cette recette avec plusieurs parfums différents. ', '2008-03-30T14:56:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 6f6bbf36-16b7-43ef-b70e-b0813ca95a23, 'Très bon, facile à réaliser, 
préférable de prendre des framboises non congelés, les framboises congelées rendent beaucoup d’eau ', '2023-10-14T16:31:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 187f380e-9cc9-40d7-9e6b-b28c859cb9b6, 'C''est mon dessert préféré lorsque j''ai des invités ..recette très vite faite avec des framboises surgelées en toutes saisons. 
Cette recette est super.', '2023-09-28T21:19:40+02:00');
