INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, 0b8971cd-c541-43fc-9dba-859cc335ad82, 'Très bon mais assez bourratif !', '2013-03-13T22:22:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, 1a2d66c4-d51d-4e87-ba48-3847b9496620, 'Très bon ! Mais j''ai effectivement fait cuire plus longtemps (près de 30 minutes) et j''ai ajouté un demi sachet de levure... pour des muffins, ça me semblait étrange sans... ', '2013-03-07T00:52:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, dabca7ad-0afb-4b50-a2b5-2418a68adecf, 'Excellente recette, rien à redire sauf le temps de cuisson qui a été un peu plus long c''est-à-dire environ 10 min de plus.', '2012-03-09T15:26:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, ef1320db-4678-49b7-92bb-70dee39ca179, 'Très facile à faire, c''est un délice ! ', '2012-02-26T14:15:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, 85564bc3-72bf-4843-8674-91bb1205f491, 'J''ai ajouté des morceaux de chocolat à de framboise quelques minutes avant de les sortir du four !', '2012-01-18T03:45:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, 3a9de37b-cab7-4f83-a174-e06d7c2c56ac, 'Très bon mais il faut en effet ajouter 15 min de cuisson.', '2011-06-09T22:47:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, 02a035fa-edd2-45c3-bea2-cc481003482c, 'Pour ma part, j''ai trouvé ces muffins beaucoup trop sucrés. Cela en cache même le goût de la framboise, ce qui est dommage. J''ai également du augmenté le temps de cuisson car après 15 min, ils étaient encore trop liquide au coeur. ', '2009-06-23T13:22:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, 0db4a591-d508-4a31-9a46-a30459425c19, 'Vraiment très bon. Je rajoute avant de les faire cuire, un morceau de chocolat à cuire et une framboise dans l''appareil. Ça apporte un coté moelleux extra. Bon appétit.', '2009-06-13T14:12:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, 14e8281a-9a86-4f3d-b229-0c3a05a13cf5, 'Excellente recette, j''ai également testé une variante avec des fruits rouges et pas que des framboises, résultat excellent je vous conseille cette recette.', '2009-06-08T19:30:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, c5661e87-935c-4cf5-9372-569e3ea2d7c2, 'J''ai modifié les doses car il me semblait qu''il y avait trop de farine, et le résultat était plutôt pas mal. Et j''ai ajouté un demi-carré de chocolat au centre, avec une framboise enfoncée dessus, du coup le chocolat fondu se mélange à la framboise au coeur. Grand succès. Merci !', '2008-12-31T14:30:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 1140a741-6551-48df-a5b9-4d235615a0be, 'Très bonne recette ! Mais j''ai réduit le sucre à 100g et c''est déjà bien suffisant. Pas besoin de 6 feuilles de gélatine non plus, j''en ai mis 4 et le gâteau se tient parfaitement ! La prochaine fois je ferai avec 3 feuilles même car le coté gélatineux est encore trop présent. Sinon c''est parfait ! On se régale !', '2021-04-17T19:36:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 1c5e577e-6cd8-42c4-ab5b-f34fd87b7d96, '1 première et c''est une réussite, à refaire avec 2 feuilles de gélatine en moins', '2023-12-05T19:38:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 5251613c-8606-47ea-a519-908a0e54d803, 'Très bonne recette et pas compliquée. J’ai suivit les conseils et mis un peu plus de fraises et moins de feuilles de gelatine(8 au lieu de dix pour dix parts). J’ai rajouté de la chantifix dans ma chantilly. Elle était ferme et onctueuse. Je pense que la saveur de la charlotte réside dans la qualité des fraises. J’ai utilisé des gariguettes dont le goût est beaucoup plus prononcé. Une nuit au frigo. Delicieux.', '2020-05-25T11:48:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 036623f9-02c4-4264-8da3-e8195472e1e9, 'Excellente et facile :)
Je l''ai fait en activité avec mon fils de 6 ans qui est fan de fraise, je recommande ! ', '2023-10-31T12:45:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 0ded6968-88fa-4f0a-a95e-67bb08acb6c6, 'Juste parfait👌
Je mets 40g sucre et 40g sirop de fraises car pas fan de l''alcool de fraise.', '2023-05-05T19:39:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 3cc4aeea-04e7-408f-96a0-a1005eaf68eb, 'Superbe recette ! Que j''ai faite avec quelques modifications : pas d''alcool de fraise (pas trouvé en magasin) et seulement 2 feuilles de gelatines ! Ca se tient bien si on respecte le temps au frais (une nuit et une demi journee par ex) et la texture n''est pas figé 😉 bref jz recommande et la chantilly apporte légèreté et fraîcheur ! ', '2021-05-23T13:46:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, b756d9de-ff4d-4d59-b1f1-1ff0f8e6ad2a, 'Super recette ! Seulement 4 feuilles de gélatine et c''était parfait', '2021-05-23T11:08:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 9ff86a87-de95-4328-a49f-6892c50969f4, 'Super recette, j''ai réduit le sucre et s''était parfait ! J''ai mis 850g de fraises mais plus aurait été encore mieux ! Belle tenue (j''ai mis que 6 feuilles de gélatine pour un résultat moins gluant). Il me manquait juste le moule à charlotte mais celui à cheescake a fait l''affaire pour cette fois...', '2020-05-18T23:37:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 559bb421-8a37-4808-9358-70920c53ebdc, 'Recette facile, juste mis 5 feuilles de gélatine à la place de 6.', '2023-05-07T19:22:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, c27f9078-caa3-48a5-b4f5-a63c260a3f9b, 'Recette super !
Je l''ai fait plusieurs fois et c''est toujours un franc succès. 
J''ai juste un peu diminué le sucre et la gélatine. 
Merci pour la recette ', '2022-05-07T21:57:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, ce372f9e-69ae-4917-ba33-7a69dc43d472, 'J''ai remplacé les fraises par de la mangue... 😃 un délice', '2022-04-17T18:48:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, a276b0bd-5a71-4307-8d8d-e581214d3382, 'simple et trop bonne 😋', '2021-04-22T11:47:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 1644be61-7cd5-416c-b033-1a9fdee38bdf, 'Un régal! Surtout en utilisant des fraises Gariguettes!
Comme je n''aime pas l''alcool, j''ai mis une cuillère à soupe de sirop de fraise!', '2021-03-25T10:20:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, e6f45e22-ee18-4b22-a1a0-c3f0fd1a2bbf, 'Super recette, ma famille a adoré la charlotte.
J''ai pris un moule déclipesable pour que la charlotte soit bien ronde mais j''aurais dû faire une génoise pour le fond car je n''ai pas osé enlever la plaque du moule sous la charlotte par peur de l''abîmer.
J''ai mi 120g de sucre et j''ai utilisé du coulis pour les biscuits.
Conseil: PRENDRE de la CREME LIQUIDE 30% et la mettre au frigo la veille.
Et ne pas oublier de mettre un moule en inox ou en verre mais surtout pas de plastique au frigo 3 - 4 heures avant.', '2020-05-21T16:05:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 1013b884-9f4f-4138-93ef-1aa08779e8ab, 'Merci pour cette recette. J''ai fait une ou deux betises en voulant aller vite mais rattrapées. Une merveille. Un peu long a faire mais tres facile en suivant les etapes. Tres légere et pas ecoeurante du tout. Dans le sirop, je n''avais pas d''alcool de fraises,j''ai mis du sirop de grenadine et un peu de kirsh. Ca y va bien. 
Merci pour cette recette. 
', '2020-05-14T18:59:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 88dca676-d8d2-44b7-a4cd-fd5631e1cdb1, 'Excellente recette que j''ai préféré réaliser avec de l''agar agar. J''ai mélangé le coulis de fraises avec 75g de sucre et 2g d''agar agar. Puis j''ai porté à ébullition 2 minutes à la casserole. J''ai laissé refroidir un peu avant de mélanger à la crème chantilly. J''ai réalisé le sirop de sucre avec 2 cuillères à soupe de sucre et 5-10 cl d''eau.', '2020-05-02T14:07:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, c903c879-f57f-4aa7-a0f5-b23056fb3596, 'Un vrai régal !', '2020-04-23T00:04:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 9060e4f6-4baa-47af-a6be-1263d44cc595, 'Super recette, la première fois cela prend un peu de temps mais plus on la fait plus on a le coup de main !
N''ayant pas de moule à Charlotte j''utilise à la place une casserole que je recouvre de film étirable afin d''avoir un démoulage très simple et rapide.
J''ai fait plusieurs fois cette recette et mes invités me la redemande à chaque fois. ', '2020-04-19T21:53:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, cd8f2e6c-3c7a-46af-804a-8196852708d3, 'Délicieux !! Je garde cette recette !! Seulement 5 feuilles de gélatine, 120g de sucre, un peu plus de fraises entre les couches de mousse et des biscuits de Reims pour le goût et le look. Merci !!!! ', '2020-04-12T23:31:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, c559ba61-897e-4f94-8f7e-d73f5ff864a4, 'Un délice ! J''ai mis seulement 5 feuilles de gélatine et mis au congélateur plutôt que d''utiliser des glaçons.  Une nuit au frais et c''était parfait ! ', '2020-04-03T20:35:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 6dcb445f-640b-45ca-ba39-577f68c68b98, 'La recette est un peu longue mais c’est une réussite à chaque fois ! Sans alcool de rose, j’ajoute du sirop de grenadine. La crème doit être semi-épaisse si on la veut plus onctueuse. Sinon, en ajouter encore.', '2019-08-04T03:55:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 6e32fa78-bd08-4a87-81ff-4fcdf5b962de, 'Excellent. Faite avec 3 feuilles de gélatine et 350gr de fraises en plus. Un régal !', '2018-07-11T08:01:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 993cbbc7-6949-461d-ab48-a34ee6822b98, 'Super recette très parfumée et légère. 
J''ai fait avec des fraises fraîches et surgelées de l''an passé. Du coup ,je me suis servie du jus de decongelation pour faire mon sirop.
5 feuilles de gélatine suffisent.
', '2018-06-05T01:51:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 9b2dda09-ca16-48c3-a707-d9d61d4baaf6, 'Excellente recette réalisée le double de quantité, ayant utilisé un moule plus grand !', '2018-05-08T09:34:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 500b8644-a248-4cfc-9c4b-4c06f6352bae, 'Bonjour, recette extra. Je suis nulle en pâtisserie et pourtant j''ai réussi en suivant scrupuleusement la recette. Cela m''a pris une heure comme indiqué. Merci.', '2018-04-18T14:07:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 379f3cdc-2693-412f-87f5-c8ebebefb1bb, 'Excellent ! Tout le monde à aimé !
A la place de l''alcool de fraises ou du sirop de fraises, j''ai mis du poliakov fraise-vanille comme cela y en avait pour tout les goûts ( pas trop sucré et pas trop fort en alcool )!', '2017-06-20T13:00:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, b9ca20d1-118a-451f-bf31-dcc2adb9320b, 'Excellent! Je fais très souvent cette recette et c''est toujours un succès. J''ai pris l''habitude de la faire aux framboises plutôt qu''à la fraise, j''ajoute alors un peu de sucre dans la purée de fruits.', '2016-10-20T12:02:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 546dbfe6-f12e-40dc-81f0-cc8938e47b58, 'Top de chez top merci pour cette super recette, je n ai pas trouvé d''alcool de fraises, j''ai remplacé par du rhum.', '2016-05-06T01:44:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, f81602ae-34fa-4da7-ae37-b1f664ebac27, 'Faite avec des framboises en petits morceaux (achetées surgelées chez picard) j''ai remplacé l''alcool de fraise par du café (parce que plus facile à trouver dans mon placard). J''ai utilisé une crème chantilly déjà prête achetée dans le commerce (ça simplifie la recette). J''ai mis une couche de framboise au milieu. A ne pas refaire. ça donne une texture bizarre. Cette recette est TOP de chez TOP. Merci :)', '2015-11-04T12:50:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, bc7ad878-533e-4550-bbb0-923a7e53083a, 'Très bonne recette. J''ai mis quelques boudoirs en plus et un peu moins d''un citron. Résultat top ! A essayer avec de l''agar-agar la prochaine fois.    ', '2015-10-04T02:40:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 1bab9220-6d42-4e10-9b0f-7763998ad4ce, 'Excellente recette. 👍', '2023-10-31T12:45:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 0520330d-c175-4e95-943a-09c9ee0780ee, 'Super recettes que je ne rate jamais ! A part aujourd''hui ou j''ai laisser mon coulis de fraise avec la gelatine trop longtemps avec les glaçon.. ca fais des petit morceaux dans la Chantilly ? ont verra bien demain ?', '2023-10-31T12:45:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 4e1f31b1-2045-4c64-a5b7-0f422becb25d, 'trop trop bien génial', '2023-04-17T08:18:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 84351b45-e0ed-4d3b-9f3c-95656ab3e80e, 'Très bonne! Ce champ (sans »s ») contient maintenant assez de caractères, non? 😁', '2023-04-09T17:03:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, b9c89c1d-9b87-42da-bd17-e4cb56f1b002, 'Super recette. J''ai mélangé quelques framboises et décoré le dessus avec.Excellent !', '2022-07-30T14:35:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 74fb06a7-5e6a-4d57-943d-6abf697737ed, 'Une perfection qui a fait l’unanimité ! ', '2022-04-14T18:19:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 9822e2c0-0dd1-4ba6-abfb-1f3ff7c3acdf, 'Superbe :)', '2022-02-05T01:52:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, ae47247d-eb15-4f93-bd97-85e90358c25f, 'Excellent !', '2021-07-24T21:56:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 417f7b5d-706d-4c33-a1b1-bcf18ab6cbfd, 'Recette plutôt accessible à la novice que je suis. Tout le monde s''est régalé !', '2021-06-11T09:47:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 317f3429-4dbb-4cec-8b4a-7c21d677201e, 'Excellente ! On adore !!', '2021-06-10T17:33:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 56a11396-eeb3-4826-8e9b-b42b555a914c, 'C’est avec cette recette que j’ai fais ma première charlotte il y a un an... et je n’en changerais pas de sitôt ! Elle est top je conseille ! Même si un peu long... ça occupera votre week end 😊', '2021-05-22T17:38:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 339e0d7b-e1c0-4895-883d-730ce09b5652, 'Cool', '2021-05-08T09:35:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 6023327e-ab77-4813-98be-346fd40c6798, 'Une tuerie !  La recette est effectivement longue mais cela vaut le coup ! J''ai utilisé des gariguettes et des maras des bois. ', '2021-04-25T20:19:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 0bfd01cd-4cb9-4aa4-b2a1-94371c64c51c, 'Une horreur j''ai suivis la recette a la lettre j''en avais déjà fais une autre en suivant une autre recette un délice celle la.. . Un CAUCHEMAR ! Elle n''as pas du tout tenu tout c''est écrouler au moment du démoulage ! Dégoûtée je l''avez fais pour les 1 an de ma fille , j''ai du aller acheter un gateau en urgence dans une pâtisserie !
Plus que déçu c''est la première fois de ma vie que je loupé un gateau et c''est loin d''être mon premier !', '2021-02-09T21:56:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 935045a4-bcea-4ba9-a584-e800a308fa72, 'Super recette ! ', '2020-11-22T00:14:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 6cd36a93-0f7b-4b79-ac9c-c8827aea7652, 'Recette au top ! Pour ma part vu qu’on est en octobre et qu’on trouve plus beaucoup de fraise, j’ai fais cette même recette mais avec des bananes à la place des fraises? J’ai egalement rajouter du Chantifix pour la crème chantilly qui est super ! Hop place à la mise au frigo pour cette nuit, on verra demain le résultat de l’aspect rendu et du goût ?? Fait chier qu’il faut attendre 6h ou une nuit au frigo... . J’ai envie de le manger Maintenant moi euuuh ???', '2020-10-17T20:39:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, dbb37980-160e-4b0d-bd5f-9929d85bc19c, 'Super recettes que je ne rate jamais ! A part aujourd''hui ou j''ai laisser mon coulis de fraise avec la gelatine trop longtemps avec les glaçon.. ca fais des petit morceaux dans la Chantilly 😞 ont verra bien demain 😊', '2020-05-22T18:23:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, e60f70c1-7c8c-40d1-a292-1c12a81bd0a9, 'Superbe recette. Faites avec des biscuits de Reims et un peu plus de fraises fraîches pour mettre à l’intérieur. Cette charlotte est un délice !!', '2020-05-18T20:36:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 8454382e-db6b-4f1b-938c-9640e35d6790, 'Excellent. En en a fait 2 depuis le début de la saison des fraises. À refaire encore', '2020-05-13T21:58:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 771c7637-65dd-4e14-9767-1ee71eb3e9cc, 'Bonne recette !  !  ! Je n''ai pas mis le sachet de sucre vanillé', '2020-03-16T11:42:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 56c484b5-289c-445c-bd20-e4e786f7ce58, 'Merci pour cette recette délicieuse !', '2020-02-10T21:26:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, fa4166d3-ad07-4010-9cd6-b727aeb00859, 'Ca fait plusieurs fois que je la fais et mes invites adorent. C est long mais ça en vaut vraiment la peine. Merci pour cette recette.', '2019-11-16T09:59:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, f1de258f-602d-4204-95f6-dc5a811c3f50, 'Très bonne recette. Pour les allergique au lactose vous pouvez remplacer la crème fraîche par de la crème de coco.', '2019-10-31T15:00:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, b4997aaa-83e3-46c4-b092-ec9805de059e, 'Quantité de gélatine à revoir absolument: écoeurant même avec seulement 3 feuilles de gélatine tout en gardant des proportions identiques pour le reste...', '2019-08-15T14:16:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 06793eb3-4646-48d3-9ecc-5f451172409b, 'Excellente ! J''ai improvisé et remplacé l''alcool de fraises par un bon vin rosé, c''est encore meilleur à mon gout. Et maintenant, on me réclame constamment des charlottes ... Merci pour la recette', '2019-08-12T10:10:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 93d65b3e-703f-4df5-ac3a-606b7368b71e, 'Superbe merci beaucoup', '2019-08-11T15:47:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 52a24c19-6c60-4680-948c-cda9bfa0d96c, 'Trop de crème Ça gâche le goût de la fraise dommage et la quantité est vraiment trop énorme pour un moule à charlotte.', '2019-06-02T14:27:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, efd6bede-2784-4195-b9a1-b774d4191405, 'Très bonne recette à laquelle j''ai ajouté 1 yaourt blanc, et des fraises pour la décoration. Mon petit plus : prendre les biscuits rose de Reims. À refaire sans hésiter.', '2019-05-20T15:35:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, 153f03c5-87e4-4086-9882-96f17ac13e8c, 'Très bonne recette bien expliquée. J ai suivi les conseils en mettant 5 feuilles de gélatine. Et pour faire monter la Chantilly j''ai mis le fouet du batteur au congélateur ainsi que la crème 30 mn au frais. Choisissant bien votre crème !', '2019-05-19T10:20:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31214, f9b8a7ba-2a37-41ed-b2b2-5c5eb83868b6, 'Délicieusement bon. C’est la première fois que j’utilise les feuilles de gélatine pour une charlotte et c’est une réussite. En suivant strictement vos indications j’ai trouvé cette recette facile. ', '2019-05-05T03:05:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166389, 3ce2f1ed-b4ca-4073-bb92-ddee9405f0be, 'Bon dessert pour un soir après une salade. Pour 3 grands verres à whisky: 250 g de mascarpone,une couche de framboises en + SUR les spéculoos et j''ai doublé la pâte de pistache (faite maison ou achetée bio sans rien d''autre que de la pistache)', '2020-08-02T22:34:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166389, 636ff794-7eed-410e-a416-8610d57e37f8, 'J avais l idée de faire un tiramusu fraise pistache et je serai de quoi m inspirer. Cette base est top. Je viens de faire tester à mes enfants et mon mari qui approuvent. A refaire avec de la framboise cette fois 😉
', '2021-05-01T23:59:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166389, e6fe5dab-6efc-4f27-9a0f-a5c109fb9858, 'Très bien et jolies verrines. Je n''ai mis que deux blancs d''oeufs.', '2019-06-28T13:02:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166389, 70ba6696-a9ad-453e-9464-46dc4d9250b6, 'Très faciles à réaliser. Un régal pour tous ceux qui aiment l''association pistache/framboises.', '2013-03-29T18:09:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166389, a64f7d15-14a7-4622-9a54-d1446292c37a, 'Super bon... Je n''ai pas trouvé de pâte de pistache alors je l''ai remplacé par de la halva aux pistaches. Cela a bien parfumé ma crème mais du coup c''était un peu trop sucré... Devant l''enthousiasme de mes invité je recommencerai mais en diminuent la dose de sucre dans les œufs.', '2013-01-15T12:13:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166389, f1c866d1-3869-4a32-a282-ba36425538d0, 'Testé aujourd''hui... Très bon mais peut-être un peu trop sucré à mon goût. J''essaierai de réduire le sucre la prochaine fois ! Merci pour ce dessert agréable en été...', '2012-08-15T15:30:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166389, 28cea56b-45d0-4fc9-90ed-8f2941074e61, 'Super idée, c''était excellent ! Je l''ai faite avec les framboises de mon jardin (un peu acides, la prochaine fois je les sucrerai plus) et j''ai fait la pâte de pistache moi-même, un peu plus long mais ça valait le coup. A refaire dès que possible !', '2012-07-03T14:35:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166389, fd8e9576-2a1c-4570-82ec-f913cffa0339, 'Un délice, je viens d''en faire 2 fois en 2 jours (pour des amis différents et tous ont trouvé ce dessert délicieux, j''ai remplacé les spéculoos par une sorte de sablé à la cannelle fait maison ! Je pense que l''on peut remplacer les framboises par d''autres fruits ou un fond de marmelade.  ', '2011-12-28T01:45:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, 0f9baf03-f0e5-4351-bcae-5192e8f16256, 'Faits avec des framboises congelées du jardin, pâte un peu épaisse donc difficile de remuer pour intégrer les fruits mais très bon !', '2011-03-13T15:17:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, 5114617d-3eec-438a-bad7-add709e9857d, 'Super bon ! J''ai modifié quelques petits éléments pour raison technique (pas de farine levante) et saisonnière (on est en mars ! ): 300g de farine et 75g de MaÏzena avec 1 sachet de levure, et 300g de fruits rouges surgelés. C''était vraiment simple à faire et surtout très bon avec le crumble au dessus. Merci et bon appétit !', '2020-03-27T18:53:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, ecc68988-c348-4512-b712-f2a16c177dcc, 'Très bon ', '2015-05-07T20:38:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, fd2c74c0-9f15-47b6-8962-23abde690985, 'Vraiment déçue de cette recette. Je ne réitérerai pas.', '2015-03-12T19:19:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, d9463452-bb13-44ab-9c9b-9814e9bcfd84, 'Pas assez de framboises (elles se sont écrasées dans la pâte, donc pas de trace de framboises) et pas assez sucré on ne les a pas fini. Désolé.', '2014-05-19T23:11:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, ed0634af-03a9-4029-a6aa-a3f7d024d7c1, 'Facile à faire, très bon moelleux. C''est parfait.', '2014-05-19T17:11:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, 2ce1d676-fff1-40a7-b312-eafbc92d57f3, 'Très bon. Peu sucré et goûteux !', '2013-09-11T11:05:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, 9d6b6d8a-e151-49c9-ae63-8e655f194af5, 'Un régal pour les petits et les grands aussi.', '2011-09-08T06:39:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, a490fed4-ef07-4cb1-9f0a-22273dc639eb, 'J''ai trouvé ces muffins très goûteux et peu sucrés, pour moi, je préfère, ajoutez du sucre pour ceux qui aiment sinon rien à redire à la recette !', '2011-05-01T18:55:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, 7717d0a2-01db-4f16-9ac6-abe4f18991b8, 'Pas très goûteux, j''ai suivi la recette mais je suis déçue surtout au vu des autres commentaires...', '2010-10-25T09:56:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, cf83557f-6ce0-4776-88f7-50d2dbb7f687, 'Délicieux, rapide, simple et esthétique ! Merci, merci, merci !', '2010-04-23T01:05:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, ed80d2ae-2902-4ad9-9fc5-dccecca0c760, 'Un vrai délice trop top !!! J''adore cette recette très facile et très rapide qui a conquis toute la famille merci beaucoup et bravo pour cette recette ', '2009-11-15T15:26:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, 56731663-dd6c-4b7f-847d-7d437b7b4b79, 'Merci pour cette excellente recette ! Je cherchais une bonne pâte à muffins pour notre récolte de mûres : j''ai trouvé mon bonheur !', '2009-09-06T22:38:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, 315e5574-03b9-49bd-8bf5-a1e2a9650562, 'J''ai mis de la cannelle dans les muffins et c''était excellent !! ', '2009-07-18T14:31:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, 7d35ae7f-58e6-4470-99e9-d4f27e8e5ae9, 'Supers muffins, tant pour la forme (ils sont très beaux), que sur le fond (ils sont très bons)! Personnellement, j''ai remplacé la farine normale par de la farine complète et j''ai mis un sachet de levure. Seul bémol: j''ai trouvé les gâteaux un peu chiches en framboises, j''en mettrai plus la prochaine fois.', '2008-03-02T13:24:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, e882dede-88a3-4d6c-9aca-1c0ae292bb86, 'Super recette! Très rapide et surtout très facile. N''ayant pas de framboises, j''ai ajouté une bonne cuillère de confiture de framboises dans la pâte une fois mise dans les moules. Par contre, bien laisser refroidir avant de démouler. Résultat excellent !! A refaire...', '2008-02-11T13:45:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, d9ce31a4-2a38-4738-9635-53342f49148b, 'Très bonne recette. J''en ai fait profiter mes voisines et elles ont adoré ces muffins framboise. Je la referai avec d''autres fruits. Merci pour cette recette.', '2007-12-17T17:50:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, fbffc46a-cad7-43c4-a7d5-a63d86263e94, 'Excellente recette. Très facile. J''ai remplacé les framboises par des griottes au sirop, tout aussi bon.', '2006-12-18T19:59:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, cbeb443a-6557-49a7-837d-f7cc6171fe92, 'Supers, et en plus très beaux!', '2006-10-28T22:20:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, c3a0b60d-afd4-4b1b-aa46-1fdab479f07d, 'Vraiment excellent, rien à redire.', '2005-07-01T11:45:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, 106cc94b-c578-4ddf-b056-19f4098a771d, 'Très bon. Mais mes framboises étaient un peu acides, du coup il n''y avait pas assez de sucre. J''ai donc ajouté 50g de sucre par rapport à la recette initiale et c''était parfait.', '2005-04-19T23:54:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30516, f7673c30-defd-4406-989c-fe5e0995a637, 'J''avais des mûres,je voulais faire des muffins. Pas de recette sur Marmiton, ça arrive parfois, j''ai donc utilisée cette recette avec de la farine + de la levure. Mes muffins ont été très appéciés.', '2004-10-13T11:54:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, a0c20a6c-296f-428d-81a3-3afd8ccfee77, 'Charlotte excellente, je mettrai des biscuits au milieu la prochaine fois même si elle ne s''est pas beaucoup affaissé. A tester aussi l''idée des framboises entières dans la mousse. ', '2014-02-09T16:15:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, 22374f34-aedd-436e-a66c-d60d37675074, 'Parfait ! Simple et délicieux ! Merci pour la recette !!', '2022-12-25T14:59:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, f59eade7-f070-49b0-8329-68276f06ab13, 'Tous le monde a apprécié, j''ai mis plus de framboises mais je les ai faites bien égoutter pendant la décongélation.
Et j''ai récupéré le jus (plus un peu de liqueur de framboises) pour faire humidifier les biscuits dedans, et comme  il en restait à la fin j''en ai fait un peu de gélatine pour mettre sur le dessus.', '2022-07-10T11:27:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, 6db78407-a470-4334-9640-7d37e7bac1c1, 'Faite pour la 2eme fois. C''est toujours un régal. ', '2020-04-14T18:26:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, 36a02683-f4d0-4591-afcf-05ea592a9983, 'Recette respectée à la lettre et résultat très décevant. Charlotte pas consistante heureusement qu''il y avait les biscuits. La prochaine fois j''essaie sans les blancs d''oeufs.', '2016-06-26T16:43:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, 6f9829aa-f205-46d7-ba49-a05d1ecaa157, 'Excellente, j''ai suivi la recette et les commentaires : boudoirs au milieu, mélanger un yaourt à la purée de framboises, 20 min au congélateur pour la mousse puis la charlotte. PARFAIT alors que je ne suis pas une grande cuisinière.', '2016-05-16T21:46:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, 1b246ea4-5af8-45c1-9c6c-b59b63ef3c0b, 'Super recette ! Hyper facile ! Ne pas hésiter à bien imbiber les biscuits... :) Première fois que je fais une charlotte et gros succès pour moi :)', '2015-11-16T18:50:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, df045e0b-ea45-4737-9123-e43a0b2b17ec, 'Un vrai délice, toute la famille a adoré, à refaire sans hésiter, très frais pour l''été !', '2015-06-27T21:26:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, 3637de58-5a19-45f2-8a48-82f99bc11bfd, 'Désolée je n''ai pas aimé. J''ai suivi la recette et j''ai mis des biscuits au milieu ainsi que des framboises fraîches à l''intérieur mais c''est écoeurant. La mousse obtenue avec le coulis chantilly me reste sur l''estomac. Je préfère les autres recettes avec du fromage blanc. ', '2014-06-16T00:19:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, 6432678a-6553-41c4-a195-d526de5cb58d, 'J''ai utilisé la recette de la mousse aux framboises pour faire une buche de Noël légère avec de la génoise...parfaite !', '2013-12-29T10:13:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, 88e7edcb-4df7-42cc-993b-9d7fd131cea5, 'Un régal. La mousse est légère. Démoulé au dernier moment, elle ne tombe pas du tout !', '2013-07-31T20:24:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, ea9aaa8c-8cd0-4c0b-b6a2-eb5c7b64d3f9, 'Me semble excellent, elle est au frigo pour demain. J''ai mis des framboises entières dans la mousse. Merci', '2013-05-19T18:50:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, 4a9c7ae3-cf9a-44db-acf0-b425ca067d3e, 'Bonne tenue au démoulage. Goût un peu trop prononcé des framboises (fraiches). Mais pas un régal', '2013-04-01T00:44:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, b8b1a2f9-0981-4e20-a929-19b7ffb51624, 'Recette parfaite ! La mousse est très légère, très digeste, même avec la chantilly. N''ayant pas de chinois, j''ai du laisser les pépins, mais passe assez inaperçus tout de même. ', '2011-07-07T15:10:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, ddd72e6c-3665-4187-a326-450481708517, 'Délicieux. Très facile à démouler et pourtant j''ai commencé 8 h avant de la servir. L''astuce est de placer la mousse 20 min au congélateur avant de la mettre au frigo. Idem pour la charlotte. On gagne beaucoup de temps !', '2009-07-23T21:54:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, 202b7635-488c-417f-bd49-2df93bd6f0b0, 'Je l''ai déjà faite 2 fois en 15 jours ! Et on m''en redemande ! Merci pour cette recette, c''est un délice.', '2009-03-21T21:42:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, 8d02d0e8-1b2c-4457-b811-6c07184166c1, 'Bien que j''ai raté ma chantilly, cette charlotte est délicieuse! Excellente tenue pour ma part.', '2008-11-15T11:49:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, a50d77ef-88fd-41f1-8ab4-65727cfd3323, 'Rien que la mousse est excellente !!! Je n''ai pas pu m''empêcher de la goûter avant de l''incorporer à l''intérieur de la charlotte, un délice !! J''ai bien tassé ma charlotte, rajouté des moitiés de biscuits au milieu avec les framboises écrasées et sa tenue a été pratiquement impeccable (elle s''est affaissée un peu mais c''est parce que mon plat était trop haut par rapport aux biscuits et pas assez rempli)', '2008-05-29T22:21:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, fe19b651-f36a-4044-a853-bf03600e4335, 'Charlotte excellente,je l''ai décorée de framboises fraîches ,cependant elle a tendance à s''effondrer sur elle-même...', '2008-03-09T23:23:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, 706ed02b-2222-4319-ac3c-6fc77d93ca46, 'Je n''ai rien changé à la recette, et c''était délicieux. De plus, la charlotte tenait très bien, même une fois découpée. ', '2008-01-03T15:31:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, 6babcb63-bdfd-4147-8fcd-280b509cd775, 'Trop bonne! toutefois, j''ai plutot fait une petite variante.... j''ai melangé dans la chantilly 2 petits suisses pour alléger la crème chantilly. Je n''ai pas utilisé de feuilles de gélatines et elle se tient bien. J''ai imbibé les boudoirs dans un mélange de gelée de cassis et le jus des framboises et un peu d''amaretto (liqueur d''amande)! un délice !', '2007-05-13T15:48:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, 45201fc0-45cc-4f6e-8e48-3cb5d508c0d9, 'C''est une recette simple, qui demande juste à être prévue la veille. J''ai seulement remplacé le sirop par de la crème de framboise. C''est un dessert vraiment délicieux, très frais et léger, avec un bon goût fruité. Juste une petite astuce: utiliser un moule à charlotte refermable, c''est l''idéal pour tasser la charlotte et pour qu''elle se maintienne bien.', '2007-04-06T01:59:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, d8cfb853-4f76-4392-be26-8f0bbb196f1d, 'C''est une très bonne charlotte qui en plus est très légère. Néanmoins, elle s''effondre au découpage. A servir impérativement accompagnée d''un coulis de framboises. Mes invités se sont régalés.', '2006-11-09T20:52:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46617, 2a94c1e6-e95c-4548-90c0-88b5f3f608aa, 'C''est excellent. Les enfants se sont régalés. J''ai suivi la recette à la lettre mais avec des framboises fraîches. A tester la prochaine fois avec de la crème anglaise pour accompagner ou une boule de glace vanille pour couper le "trop" de framboises.', '2006-08-28T09:26:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168545, 4b1415fa-8117-4fb4-a395-49649b61d6bf, 'Excellent et facile! J''ai juste ajouté une cuillère à café d''extrait de vanille dans le mascarpone. Pour la personne qui a fait le montage à la dernière minute, aucun risque d''imbiber les biscuits : j''ai monté les verrines plus de 3h avant et les biscuits écrasés sont restés secs. Puis j''ai fait une version aux dés de pommes caramélisés et légèrement parfumés à la cannelle, et des brisures de nougatine en décoration : un délice!', '2011-03-07T20:56:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168545, aea58cc9-a820-4690-afce-811d197bbe44, 'Pour les inconditionnel(le)s de la framboise, voilà un dessert simplissime et délicieux ! Pour la déco j''ajoute un spéculoos et une petite boule de chantilly, que du bonheur !', '2016-02-25T17:00:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168545, 5ce5da4b-ef92-4236-9e7a-c0c2a5b9d64a, 'Une tuerie ! Rapide à préparer et délicieux. Attention : cela vaut 9 points !', '2014-03-25T09:15:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168545, 3b3d875b-c07c-4514-811b-063601cd1491, 'Très Bonne recette pour un dessert sympa et facile à faire', '2013-06-17T23:16:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168545, 996a933c-185f-40de-95c8-79936d44bb4c, 'Très raffiné comme dessert.  Parsemé de quelques framboises dessus', '2013-05-04T22:14:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168545, d43b2912-bace-497c-9f5d-bdabf9974deb, 'Un délice !!!', '2012-08-25T01:38:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168545, 036d99fe-b469-456b-89e2-0847dc9904ef, 'Dessert très gourmand comme je les aime !!!! N''aimant pas le miel je l''ai remplacé par de la confiture de fraise : trop bon quoi !!!! Et j''ai même ajouté du spéculoos dans mes verrines à la place des biscuits à la cuillère (mes verrines étant trop petite...) en décoration au dessus du mascarpone j''ai ajouté une framboise. En tout cas tout le monde s''est régalé !!', '2010-12-19T16:28:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168545, 04e307f8-5bdd-4aa1-949c-90bbd83571f3, 'Tout le monde a aimé. J''ai cependant trouvé le goût du miel un peu trop prononcé. Le prochaine fois, j''en mettrai moins. Ça marche aussi avec des fraises.', '2010-10-18T08:27:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168545, 32b8cb25-985b-4757-99cd-445bcd777111, 'C''est très bon et très rapide à faire. J''ai attendu le dernier moment pour tout assembler car j''ai eu peur que les biscuits du fond deviennent papette !! Sur le dessus, moi j''ai décoré avec de petites branches de groseilles... c''était très beau !', '2010-10-04T21:37:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168545, 4632c1d0-e9a7-4acb-91b7-95d8b8a62b45, 'A la place des biscuits à la cuillère, je mets des spéculos et des petit beurres. Cela relève le goût de la framboise.', '2010-09-24T01:59:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168545, 725af987-d48d-4807-95e8-02bc93548dd1, 'Simple, rapide et léger, un vrai plaisir gourmand. ', '2010-07-24T20:29:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 1e7b1cbc-13e8-47a8-99b9-ca5c64b0637f, 'J''ai suivi la recette à la lettre 
Mais pour 8 personnes j''ai juste mis 4 filo à chaque fois au lieu de 3 et j''ai fini 2 feuilles froissées sur le dessus ', '2023-03-14T11:16:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, a9e79388-6934-43d8-927e-6c70bbc545d5, 'Très bon. Je n’avais pas d’armagnac j’ai mis 1 cuillère à soupe de rhum. ', '2021-02-14T11:35:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 88f63a42-ebd8-4315-8a73-3deabde6c232, 'Tout simplement délicieux. Juste 3 feuilles dans le fond et en suite 2 suffisent... Merci un régal. ', '2023-05-21T11:21:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, e91a8ddc-954e-4f78-9e20-6c1863691f53, 'Réussite totale ! Un délice !!! Merci pour cette recette ! ', '2022-02-12T13:24:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, e45bbe70-b20e-43f4-81ed-ea63f5796d5d, 'Très bonne recette mais peut-être un peu trop de beurre', '2021-03-09T11:30:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 7d7b8cf7-83f4-405f-b378-9de6d4b9063f, 'Excellent gâteau à faire et à refaire toute la famille adoré même ce qu’ils étaient sceptique bravo marmiton merci', '2021-02-22T21:40:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 33db59bb-cecf-4afa-862c-756fdba8f278, 'N’ayant pas de feuilles de filo j’ai pris des feuilles de brick ... je déconseille formellement de faire la mm chose ... brick trop épaisses résultat sec et pateux au centre .... dommage parce que esthetique super ... comme dans les Landes ! Et gout idem', '2021-02-11T18:21:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 3ea1860c-e83d-4032-a1f4-af93b8c2f014, 'Recette excellente ☺️ Parfaite ! ', '2021-01-29T22:36:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 2da1b704-7739-426d-9db1-f9b93729364e, 'Excellent', '2020-12-21T20:11:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 8500affe-ec9e-4700-ae01-cb37b890ff00, 'Croustillant et fondant. Top', '2020-12-21T01:15:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 36752530-6569-4560-a019-d9809b26f0ab, 'Excellent !', '2020-10-24T15:26:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, d1319001-d109-4a95-8022-ff3eec8915bc, 'J''au rajouté une pomme et 2 pruneaux de plus. Une excellente recette. ', '2020-09-26T21:14:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, d7c3bbfb-f8e3-493e-bca8-73aba4005fe8, 'Très bonne recette... mais avec seulement 60 gr de sucre et 6 pommes golden! Je l''ai faite sans armagnac car nous ne sommes pas fan, mais peut-être à tester avec du rhum...', '2020-05-20T15:34:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, ae935dca-5e84-4aa9-b4f3-cc69e6cf494e, 'Très bon et léger à refaire très vite 
', '2020-04-01T20:53:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, b0daa872-e41b-486b-9c5e-6ad40acd3c99, 'Respectée à la lettre. Nous retrouvons le goût des croustades faites par mes grands-parents. Merci', '2019-03-09T04:28:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, bd14323c-e500-480d-bb61-ca67d723be47, 'Très bonne recette, un régal ! Je conseille de mettre plus de pommes et peu de sucre. Perso, j''ai supprimé l''armagnac.', '2018-11-02T10:27:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 990e201c-4c57-453e-8d71-13943099b360, 'Délicieuse, je mettrai un peu moins de sucre la prochaine fois mais c''est une question de goût. Vraiment très très bon.', '2018-03-12T17:28:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, fd781abc-b155-4c11-b7b9-1fd6f99e60c4, 'Facile excellente je la recommande !', '2017-12-03T19:32:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, a7f089de-f83f-4315-8015-57e704c1c185, 'Très bon, je n''ai pas ajouté les dernières cuillères d''armagnac.', '2016-03-05T21:20:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, bf090c45-6d76-4d7d-b81b-857bd3697e84, 'Un régal mais sans les pruneaux !', '2015-10-15T15:53:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, db8cf2be-ce7b-4bd4-bb7c-72376cbe83a7, 'Très facile à faire et un délice au final.', '2015-10-01T17:39:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, ebff54b3-be34-4418-af1e-b41a0664c4ad, 'Très bonne recette. J''ai remplacé l armagnac par du rhum et utiliser du beurre clarifié vendu dans le commerce pour gagner du temps.  ', '2015-02-18T23:04:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 835fee2b-ca5b-4301-b87f-2c3745edc148, 'C''est un de mes desserts préférés. tout le monde apprécie et est même bluffé qu''il n''ai pas été acheté!! je n''hésite par contre pas à mettre un peu plus de pommes.', '2013-01-19T17:37:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 200a9bb6-e03f-4aef-bb70-3f923eb22617, 'Enfin je retrouve la recette de la croustade de mes 20 ans que j''achetais à Aires s/ Adour quand j''étais étudiante à Bordeaux, je rentrais à Pau le WE ! Si je m''écoutais, je la referais chaque jour !!!', '2012-04-10T08:37:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 5e0ce82d-62d5-4c5d-ab25-4289073d5fe5, 'Pas mal du tout. Servi avec une boule de glace à la cannelle ça doit être le top mais comme ça, avec l''armagnac, c''est déjà très bien. ', '2011-05-03T21:56:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, fa9d2a73-6d96-42d5-a046-7e609313e189, 'Je n''avais pas de pruneaux, alors j''ai mis des poires à la place et c''était un vrai régal. Je n''ai eu que des compliments...et tout le monde a voulu la recette ! Un vrai bon dessert, léger et croustillant.', '2009-04-26T20:00:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, c46015f8-621f-4c6f-8878-c07ba40caf75, 'Super bon et très fin. Passe très bien après un cassoulet!!', '2008-06-16T20:37:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, cf6d58f9-4928-46a9-bb85-43f11967cf4c, 'Très bon et très simple à préparer! Parole de landaise.', '2008-02-26T20:45:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 3f1d4769-aa84-47ee-8879-7c77548e6bf6, 'Vraiment délicieux, parfumé, léger et excellente présentation. Recette réalisée par mon mari à l''occasion d''une fête.', '2007-10-22T12:27:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 68ac1a8b-649c-4f41-89cc-d3cb09a97d3c, 'Félicitations, excellent, je n''avais pas d''armagnac alors j''ai remplacé par du rhum. Très bon aussi mais la prochaine j''aurais de l''armagnac.', '2007-06-17T10:11:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 8c5cc23c-9f58-4793-a97d-d09e5e814992, 'Délicieuse recette!! Fondant, un vrai bonheur! Merci.', '2006-12-21T12:45:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 14b51b99-5e59-4239-8c1f-2fbf554c86bf, 'Délicieux! Ou comment retrouver les saveurs du sud-ouest chez soi !', '2006-09-30T20:42:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, 6acfc5d4-80c8-4138-9b59-c53d5a6e2522, 'Super bon!!! Super simple. Grâce aux feuilles de filo, j''ai pu me remémorer mes vacances dans le Gers, à refaire!', '2006-01-22T22:44:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, b61a7016-ad43-4624-b31c-321e4833f5cb, 'Tout simplement succulent. Le plus difficile est de se procurer les feuilles de filo!', '2005-12-20T18:48:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14618, f08adff8-1157-4728-99c2-777329347aec, 'Très bon et simple à réaliser.', '2005-03-27T19:27:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, eebd6290-6307-492b-a084-538da2324242, 'Excellent gateaux facile a faire ', '2021-05-11T11:39:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, ffa31ae5-0574-4983-a5ca-1b84e8570f3f, 'Très bon gâteau léger. Rapide à réaliser. J''ai pris la recette de la génoise rapide et légère (plus simple à faire) et j''ai ajouté 3 blancs en neige à la crème au mascarpone pour la rendre plus légère également. Le résultat était excellent !', '2014-06-19T18:00:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 4110cebd-a7d2-47a2-a2f0-6f00b3450998, 'Le gâteau est très bon, des fois, on ne comprend pas ce qu''il faut faire.', '2022-07-04T10:38:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 86a67ca1-877b-4611-8ff7-0eab9ced97a0, 'Gâteau très facile à faire, je recommande !', '2022-04-22T13:34:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 29d05585-60ba-4094-8201-34fbeceda4e8, 'N''étant pas une grande pâtissière ce gâteau est un grand succès excellente recette', '2021-12-01T20:00:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 84ca6178-ab24-4219-8fc5-755235f4ab50, 'Mon 1er vrai gâteau ! Mes jumeaux ainsi que leur papa se sont régalés. En suivant les autres commentaires je n''ai mis que 30min de cuisson et effectivement ça a suffit. Je le referai sans aucun doute.', '2020-05-12T00:58:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 100a64e3-8572-42ee-b456-737d6a77e5e4, 'Une tuerie, moi j''ai mit de la Mascarpone au lieu du yaourt
juste un délice!!!!!!!', '2020-04-11T16:15:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 80e7ae69-f02a-4c0c-ba8b-4baead2af3ae, 'Super à refaire 😉😉😉👍👍👍', '2023-04-17T15:36:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, f0920d00-b83c-47e6-9379-8e64ff367c73, 'Gâteau très bon, mais il faut diminuer le sucre', '2019-05-25T09:22:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 8af46ba6-6800-45b4-b965-b74452324613, 'Facile, mais manque de légèreté, trop de mascarpone, ensemble trop sucré, pas fin. Les gosses ont aimé, pas les adultes. ', '2019-04-19T02:28:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, d6697ad1-72d8-421c-a8ae-f7366b3fe5e0, 'Super recette, réussie du premier coup. Pour ceux qui n''aiment pas les gâteaux trop sucré, un conseil mettez que 70 g de sucre et un sachet de sucre vanillé pour le mélange avec le mascarponne.', '2016-04-03T20:45:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, b8d7e658-9a9c-4e1d-abfd-bf586aa010b3, 'Ma recette fétiche du moment ! je l''ai faite avec fraises framboises et myrtilles. Mais elle peut se faire avec n''importe quels fruits à toutes saison :) pour la génoise 30 min de cuisson suffisent. pour la mascarpone je n''avais que la moitié j''ai ajouté de la crème fraîche semi épaisse (un bon demi pot) c''était parfait. réduire un peu le sucre pour la crème. légèrement imbiber le gâteau de jus dilué... l''effet wouahou garanti !', '2015-06-25T18:41:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, dd011659-e4fd-40fa-98d1-b27a43cf8ebb, 'Très bonne recette, Je l''ai réalisé facilement. Quel plaisir de faire plaisir et réussir à coup sur .....', '2015-04-17T22:10:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, dde81683-89cb-43e5-a2cd-a6fb1f78c503, 'Très facile à faire grâce à cette génoise de type gâteau au yaourt. Nous avons fait 2 versions. Un gâteau à la fraise et un gâteau garni avec des bananes et des pêches sur le dessus. C''est super bon. ', '2014-07-21T15:37:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 710864ab-24ea-4e8e-93b4-3bd8b257afb3, 'Très apprécié de tous pour son goût et sa fraîcheur', '2014-07-10T21:29:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 6e4c0ca0-8023-49c1-9563-d2c8db0a52df, 'Excellent, nous avons tous adoré.', '2014-04-02T09:51:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, e694d9f4-2f9e-4188-b1ea-72e2d00bd387, 'J''ai utilisé tous les ingrédients pour faire la génoise dans un moule coeur, 30 min à 180°. Par contre, j''ai utilisé 250 g de mascarpone avec 50 g de sucre et un sachet de sucre vanillé. Pour les fraises (du jardin), 400 g m''ont suffit. Se tient très bien quand on le coupe.', '2013-06-12T22:56:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 1f1044b9-64d2-40ba-8bf6-ed8de5a47a93, 'Très bon gâteau !!', '2013-05-30T15:45:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 4bbceb83-4726-40f3-9ff2-dccf1170b9bb, 'Il est très bon juste un petit problème sur les blancs en neige ', '2023-07-17T20:34:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 875b438f-74ff-4ea2-91fc-a3994fe85898, 'Facile, frais ', '2023-05-23T19:00:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, e6f23c54-a48a-4565-b527-07d5176b3d51, 'Trop bon je conseille 👍🏻', '2023-05-13T08:59:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 83bc581f-1859-4052-8ca9-ea4233118151, 'Excellent !!!!', '2022-12-17T17:14:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 2d722244-959c-4082-97c1-e88fd3626d6f, 'Très bien', '2022-06-14T11:53:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 1d55aa20-5c85-402c-82ad-9a4e8380694c, 'Très bon ! Je garde cette recette ! Tout le monde a adoré ! Je n''ai mis que 100g de sucre cependant.', '2020-04-18T19:55:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, ee7ae936-fec8-43d5-adc1-ad79dd349d1f, 'Très bon dessert apprécié par tous. 30 minutes suffisent largement pour la cuisson du gâteau. J''ai fait refroidir le mascarpone pour qu''il ne soit pas trop crémeux et qu''il ne "coule" pas lorsque que l''on recouvre le côté du gâteau.', '2018-08-02T10:46:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, e28a146b-8d94-47a4-a240-3e40fb12019d, 'Recette topissime ! J’ai craint que le gâteau soit trop lourd mais pas du tout. Faire juste attention à la cuisson: 30 minutes suffisent largement !', '2018-06-11T10:00:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, a80e3019-dd2c-4b81-aa6e-41a6cc3c0fc8, 'Excellente recette !', '2018-05-05T22:02:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 9e16d536-9688-443e-b025-b579869753d8, 'Bon !', '2018-03-23T08:09:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 5665627f-819b-4c17-ae80-a6e309c5daae, 'Parfait, tout le monde a adoré. Je l''ai faite aux poires avec un peu de chocolat, un délice. Je confirme la cuisson, 30 minutes suffisent.', '2017-07-23T18:25:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 51676c96-851a-4957-9d46-cb340b1a8ee0, 'Dommage un trop de ganache sinon très bon !', '2017-05-06T12:30:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, da1e16fa-ab31-476a-94ba-392bd88ae46c, 'Excellent gâteau !', '2017-04-15T19:59:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 52dad4a3-c874-4c78-9ebc-045ae9202eeb, 'Recette au top ! Simple à réaliser, elle a bluffé tous mes convives ! ', '2017-04-12T23:18:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 7a78209f-db3d-408a-8d99-0980aca28959, 'Génoise au top ! Je remplace les fraises par pleins d''autres ingrédients pour varier : chocolat, kiwi, banane... ', '2017-02-02T15:57:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 8e0c7d34-afd4-4602-af3f-e0950a13737a, 'Super recette ! J''ai juste ajouté 500 g de mascarpone car je l''ai fait beaucoup plus gros et j''ai fait une déco avec du mascarpone et du coulis de fraises. Tout le monde a adoré.', '2016-07-16T22:57:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 6592eecd-0430-451c-9994-134aa8019c35, 'Merci pour cette recette simple qui a ravit tous les convives ! Je n''avais pas 500 g de mascarpone alors j''ai mis 250 g de crème fraîche épaisse et c''était très bon.', '2016-05-02T09:56:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, d705478a-db8d-48f3-b465-d787d8623cfa, 'Trop bon et beau en plus. Je l''ai fait hier mes convives étaient ravies.', '2016-05-01T16:33:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, ea646aab-3c38-4471-965a-70199a7e5b25, 'Génoise super bonne et la crème mascarpone très simple et pourtant si délicieuse ! Pour un effet festif, j''ai ajouté de la crème chantilly, vermicelles colorés et petits morceaux d''amandes sur le dessus du gâteau. Merci, je recommande vivement cette recette inratable pour son goût, sa facilité et rapidité. 20 min chaleur tournante suffit. ', '2016-04-05T20:12:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, a8f445c5-0036-40a3-bc01-493d18012257, 'Une recette parfaite ! J''ai même publié une photo avec les petits oeufs dessus tellement j''étais fière. ', '2016-03-27T19:18:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 6f60750e-1ede-4116-9116-2184d3a2b815, 'J''ai suivi la recette en ajoutant des framboises dessus. Très bon.', '2015-05-07T22:15:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, e7ecbe3d-6edd-419d-9f83-496eeed59528, 'Je  l''ai fait pour l''anniversaire de mon garçon : tout le monde a adoré.', '2014-09-02T21:24:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 97fc57eb-4544-4035-914c-6118d6f8165a, 'Super recette ! J''ai mis une photo: celle avec les amandes effilées. Pour la génoise, j''ai pris 4 œufs, 125 g de sucre et 125 g de farine et 1 sachet levure chimique. ', '2013-06-15T20:32:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 0e813e5e-5ac8-4652-b983-28c3d2edbad8, 'Excellent, grand succès ! Merci !!!', '2013-05-21T00:40:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, a2f5ee42-bfed-48ac-8b3d-22aa9b1ca6a2, 'Que dire d''un aussi bon gateau à part que mes invités ont adoré et cela à plusieurs reprises ! Excellente recette !', '2012-06-26T18:32:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, f2e26446-e81e-4724-8f08-5442f617091f, 'Très bon gâteau ! Je n''avais que 275 g de mascarpone alors j''ai ajouté 2 blancs d''oeufs montés en neige dans la garniture: plus crémeux et plus facile à étaler. Sinon j''ai presque diminué de moitié les quantités de sucre autant dans la génoise que dans la garniture : suffisant à mon goût et à celui de mes amis. Dernière chose : un peu moins de 30 min a suffit à la cuisson de la génoise. Je vais garder la recette moi aussi !', '2012-05-02T18:40:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, c2532ef6-524f-4b38-a1e4-174cc5abb550, 'Je me suis librement inspirée de la recette : je l''ai faite avec des brisures de framboises surgelés, dont j''ai récupéré le jus de décongélation. J''en ai fait un sirop dont j''ai imbibé le gâteau. J''ai réduit le sucre dans le mascarpone et j''ai ajouté de la pâte de pistache. Et j''ai ajouté de la vanille dans la pâte à gâteau. C''était vraiment excellent.  ', '2010-10-12T11:57:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82777, 5558d837-1fd7-4c3a-a66c-7e9a440da918, 'Beau et bon !! Un vrai régal, frais. Je pense que je le referai avec une génoise roulée. En tout les cas, je garde la recette.', '2010-05-25T16:02:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 96c0675a-4af1-4ea6-9891-5e6e6d63f7ee, 'Encore meilleur avec une compote "maison" sans sucre, écrasée grossièrement.', '2020-01-29T20:32:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 3acbce12-615d-42db-9255-56bd00b4d1d0, 'Très bien, j''ai fait caraméliser les pommes dans du lait concentré sucré au lieu du caramel. ', '2022-04-08T16:13:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 7d3ac74c-8d1f-4d64-830e-8c4cf342e892, 'J''ai fait ces petites verrines pour le goûter d''anniversaire de mon fils ! J''ai toutefois modifié la recette car l''ajout de compote ne me plaisait pas !  J''ai donc tout suivi à la lettre sauf que mes petits morceaux de pommes je les ai fait fondre dans du beurre en laissant bien compoter ! J''ai complètement banni la compote de la recette. Pour le dressage, les spéculoos, les petits morceaux de pommes compotėe, le caramel beurre salé, l''appareil à tiramisu, et sur le dessus pour la déco des petits morceaux de pommes arrosés de citron pour qu''ils ne noircissent pas ! Les verrines ont fait fureur, certains invités en ont repris une deuxième.', '2014-02-01T15:02:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, d73b81de-92bf-4339-9467-7d650d524ea6, '🤗👍👍👍👍👍👍', '2022-03-02T18:19:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, ab9f725c-9225-4f7e-8e87-f15c240ad2dd, 'très bon mais meilleur avec des biscuits de reins mais imbibé de rhum franchement un délisse c''est beaucoup moins sucré  ', '2021-12-29T17:49:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, af1c24f4-2fdd-4f69-9445-2c387d7760de, 'Recette choisie par mes enfants, qui a donc été testée et approuvée ! Par contre je n''ai pas mis de compote, j''ai fait revenir mes morceaux de dés de pommes dans du caramel au beurre salé fait maison et j''ai réduit la quantité de sucre avec le mascarpone... J''ai ajouté sur le dessus quelques dés de pommes crus légèrement arrosés d''un peu de jus de citron... Un délice ! Merci pour cette recette !', '2019-04-20T12:20:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, d9dbfb5b-bcca-403f-9779-fbb408342c64, 'Superbe recette. J''ai laissé mijoter le caramel au beurre salé avec les morceaux de pommes quelques minutes. Un délice !', '2017-10-05T11:28:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, f4218635-9c7c-40e0-9908-597ac0f61e09, 'Excellent, sans rien changer....juste 1/2 spéculoos planté dessus dernier moment pour ajouter du croquant !', '2016-10-25T14:08:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 0c29b828-f643-48dc-b719-f18935ae607d, 'Très bon ! J''enlève juste un peu de sucre je mets 70 g au lieu de 100 g.. Très simple et rapide !', '2014-07-10T13:38:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 72d00288-ad7c-4698-9027-7dd74c0af403, 'J''ai fait revenir mes pommes dans du caramel beurre salé, au top mais du coup j''aurai du éviter d''ajouter du caramel pendant le dressage. Penser à couper les pommes en petits des c''est meilleur ainsi ', '2014-07-06T18:29:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, c784bfd4-aed9-45db-b5e8-3fea675a373c, 'Très très bon, première fois j''ai suivi la recette à la lettre, après j''ai testé en remplaçant la compote et les pommes par des pommes caramélisées à la poêle : encore meilleur à mon goût... A faire et à refaire !!', '2012-12-21T19:31:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, c288c32e-dd0b-4b1c-9778-20cd3ba787b0, 'Delicieux ! J''ai un peu caramélisé les pommes dans du beurre à la poêle et pris du caramel beurre salé tout fait. Ça change et c''est excellent.', '2012-10-16T20:47:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, f5603c21-9e58-4fbd-adbc-6567364ce12f, 'Super bon, effet garanti sur les invités !', '2012-09-27T14:24:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 4cde246c-1540-4e27-a42f-fd14c167983f, 'Un délice !! Le mariage de toutes ces saveurs est parfait 👌', '2022-12-22T13:31:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 93bdbc97-7456-40f0-8f82-0f5e3b792d54, 'Bon et bien !', '2022-11-30T18:13:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 0f13db24-12fe-4a30-b15c-fc3cbe1cb6a3, 'Super bon ', '2022-02-27T08:32:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 72990383-48d5-470f-8796-19993b23bfce, 'Bonjour, super recette, peut-on la faire la vielle, merci.', '2020-06-11T10:46:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, b94e07be-1ea1-4787-85f7-8e327b9d194a, 'Très bonne recette.', '2017-03-14T12:46:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, ab6cb0f4-f204-4932-9176-a6097adf9cbb, 'Super dessert original, beau, qui fait son petit effet ! Attention ne pas mettre trop de caramel (même si c''est très tentant) car ça prend beaucoup le gout et c''est très sucré. Effectivement 60/70 g de sucre suffit. Ne pas hésiter à mettre plus de spéculoos. Facile à faire ! ', '2016-12-27T11:35:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 6e84b8a3-0840-4597-b4cf-416cf5988597, 'Juste génial !!', '2016-06-01T14:56:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 3879cd20-8e77-4b63-9782-ee85d1b2f42e, 'Juste génial !!', '2016-06-01T14:56:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, c6cbee39-ab53-4cf9-918e-79b7a70991fe, 'Un vrai régal quel plaisir et super sympa à faire ', '2016-01-15T21:05:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, ca73452f-786b-43da-9666-0a10a8fd767a, 'Trop bon j''ai fait 25 verrines sans mettre la compote et en faisant revenir les pommes... une tuerie mes invités ont adorés, facile à faire en plus ', '2015-10-05T00:10:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, db7d0dbf-12b4-426b-9ca1-1e7ef7f5ee48, 'Très bonne recette mais mettre moins de sucre (la moitié suffit) !', '2014-10-19T17:33:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, a81b8c74-0570-426d-a3e5-74200e712e8b, 'UN DÉLICE ! J''ai ajouté une gousse de vanille quand je faisais compoter les pommes... les amis ont adoré... à refaire encore et encore encore !', '2014-10-01T12:49:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, e809cceb-402b-4dff-b616-6a98a55c0508, 'Dessert léger et excellent ! J''ai eu des personnes qui n''aimaient pas la cannelle, du coup j''ai mis saupoudré de chocolat, c''était très bon aussi !', '2014-04-07T18:08:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 60d47427-aa05-4cfe-a0d8-6427032f883b, 'Inconditionnelle du caramel au beurre salé, j''ai adoré cette recette... J''ai remplacé les spéculoos par des palets bretons émiettés. Je referai cette recette sans aucun doute...', '2013-11-04T12:24:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 3e9dc3dd-028d-4684-9151-e0f6cc42fe21, 'Superbe recette ! Cependant comme déjà dit, 30 minutes de plus de préparation au bas mot n''est pas de trop. 10 minutes c''est au mieux pour le dressage.', '2013-08-17T17:55:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, adfcf976-a644-4a1f-9899-91877e9f0f7e, 'Délicieux. Un vrai régal.  Par contre, prévoir un peu de temps pour la préparation. Mais à refaire sans aucun problème ! :-) Merci pour cette recette divine.', '2013-04-15T11:03:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 7db33639-4aa7-4466-8f98-34b2eb271f45, 'Sublimissime ! Il faut en revanche compter 30 minutes de plus de préparation. J''ai fait caramélisé mes pommes dans du caramel beurre salé qu''il me restait d''une autre recette marmiton (mousse au chocolat, caramel beurre salé,miam!). Mes invités étaient plus qu''enchantés. ', '2013-02-23T01:21:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, cb9853ee-2ea9-4916-8f0e-e5843804662e, 'Excellent !!! J''ai goûté à ce tiramisu grâce à une amie et je me suis ré-ga-lée !!! Elle aussi avait fait un peu revenir les morceaux de pommes dans du beurre pour les rendre fondants. À la fois fin et léger, ce tiramisu termine parfaitement un repas et n''est pas du tout écœurant comme peuvent l''être les tiramisus classiques. Une recette que je vais m''empresser de faire et que je garde précieusement!', '2013-02-20T15:55:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, ce14359d-50b5-4500-95db-e67afdbf87b8, 'Cette recette vaut la peine d''être connue ! Je l''ai réalisée pour mon dessert de nouvel an et elle a ravi tout le monde, elle se déguste aussi bien pour le goûter ! Régalez-vous bien.', '2012-01-23T20:11:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 33ee76a8-3cca-4a99-ae06-553394f072b5, 'Très bon ! Testé en faisant caraméliser les dés de pomme, ça vaut le détour. Réalisé avec la recette de caramel au beurre salée trouvée aussi sur Marmiton.', '2012-01-02T14:08:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 894a45e3-fab8-4981-8088-8508e5478d80, 'Un vrai délice ! Les convives étaient ravis (même ceux qui ne sont "pas trop dessert"). Léger et original, il ne déçoit personne ! A faire et refaire à volonté ! Seul petit bémol, j''ajouterais un peu plus de temps au niveau de la préparation (10 minutes est trop court).', '2011-11-03T11:14:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94778, 29e166f8-9e7e-40ef-8c0b-9184a0a58251, 'Version originale du tiramisu, c''était trop bon merci !', '2011-03-04T10:08:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, c45da4ca-65e1-4616-8e7d-a8f0387661cb, 'Un régal !!
', '2022-02-07T22:01:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 4371e2cd-4dab-47dd-bc80-3fb921616124, 'Facile et delicieux', '2023-09-19T15:34:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, f011e533-dd7c-4f11-9877-42a0f88d23f9, 'Très bonne recette ! Faite pour la première fois et pas déçue, c’était un régal 😋
Juste les ingrédients pour 6 personnes mettre éventuellement qu’un seul oignon (pensée aux personnes qui n’aiment pas trop les oignons). Mais pour les enfants qui ne mange aucuns légumes c’est le BON PLAN !!!! 😁😁', '2023-04-25T20:44:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 4695c1f5-974a-4fbc-8281-0a8bdaffe80b, 'Vraiment très bon même sans noix de muscade.', '2022-12-19T11:41:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 184c0f70-db9a-4ed5-9ae8-e7f8b5fa41ad, 'J''ai bien aimé mais ni mon mari ni ma fille ont apprécié.
Je pense que je n''ai pas assez cuit les carottes, dommage, mais je retenterai !', '2022-12-07T17:03:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, b69e5a5e-402c-41f1-87a4-f940684c1549, 'Simple et efficace. Merci.', '2022-09-20T10:37:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, dddfca55-9b79-49b1-a6f0-04a67975ce37, 'Recette simple et délicieuse. ', '2021-12-23T21:51:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 2f309976-926c-4d78-9066-2ddbda83ae36, 'Vraiment très bon, l''oignon donne une saveur supplémentaire. Merci pour cette recette ', '2021-12-08T19:34:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, c055496a-33ff-4eb2-9faa-4ad681d5c1b7, 'Excellent, j''ai fait revenir des rondelles de saucisse de Francfort avec mes oignons. J''ai saupoudré de paprika, de muscade et de cumin. Avec une salade verte, un vrai régal pour tous les convives.', '2015-10-06T08:28:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 2686d0a0-f104-4e1a-87a5-bc26d2c61480, 'Très bon. Fait avec des carottes et des pommes de terres précuites pelées et découpées. Plat réalisé très rapidement. ', '2013-11-18T14:43:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 0817d595-afea-445f-aa80-edd851204267, 'Très très bien même si nous n''avons pas mis d''oignons. Par contre, nous avons ajouté du cerfeuil! Délicieux.', '2008-10-04T19:23:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, ebec58b5-ddd0-43fa-a75e-ebfd58fcde2d, 'Trop trop bon, j''ai fait les ingrédients pour 8 personnes, euh.. . Comment dire... Je me retrouve avec une purée pour 2 ou 3 personnes. En tout cas recette au top. Merci beaucoup. ', '2025-09-21T19:26:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 89871c10-1382-4fc9-912f-866847a1b775, 'Très bon, je rajoute un peu dans blanc de poulet et je déglace les oignons à la sauce soja. ', '2023-12-10T18:19:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, cefea59e-d28d-46a9-ba1f-ac8634514e49, 'Excellente recette, franchement je referai. Je n’ai rien changé mise à part que j’ai rajouté du curry.', '2023-03-29T21:43:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 36c9dfbb-0c33-4775-ba48-13df38871f9b, 'Les oignons donnent un goût délicieux à ce gratin. Pommes de terre et carottes cuites à la vapeur pour gagner du temps. A refaire !', '2023-03-01T19:12:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 4fddc37d-a4c8-4f59-a843-b8cea08ee347, 'Très très bon, j''ai mis 750 gr de pommes de terre et 750 gr de purée de carottes congelés, rajouté du persil pour le goût, c''était un vrai délice. ', '2022-01-18T22:23:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, b99cd56e-a274-4f4d-83e5-cd19615049fd, 'Super nourrissant ! Excellentissime...', '2021-11-29T16:26:49+01:00');
