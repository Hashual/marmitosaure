INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 3a51280b-c418-462d-bd92-654d6cb50d7e, 'Délicieux. Perso j''ajoute 1 tasse lait (1 cup). Moelleux. Idéal : alterner couches pâte - tranches de pommes.', '2022-10-09T15:28:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 58bd6de1-068c-4b0e-b336-cb20d589123b, 'Bonne recette, j''ai remplacé le beurre par de l''huile de coco et le sucre par du sirop d''agave ! Et j''ai rajouté du lait !  Super bon !', '2018-09-19T07:18:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, d3133dc8-cc64-488b-ab58-2a79b389cb67, 'C''est une super recette, effectivement comme dit dans les commentaires rajoutez du lait. Tout le monde a adoré, et je me suis éclatée à le faire !', '2021-12-20T17:09:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, ab41b46a-b98f-4269-b15b-916f9f5d9f79, 'Bien et bon goût', '2021-10-09T23:52:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, aa0a067a-6860-4882-828c-5f33f2574707, 'super juste il faut rajouter 15cl de lait !', '2021-08-25T19:19:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, bbcd4260-ae4e-4f97-93ce-5b96538a55f5, 'Moi j''ai modifié la recette un peu. Au lieu de 200g de farine, j''ai mis: 100g de farine, 50g de maïzena et 50g d''amonde en poudre. On s''est régalé', '2021-06-28T19:38:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 9bc70c41-c8f7-4b71-91c7-d35e00651508, 'Simple mais superbement bon ?', '2020-10-18T18:43:44+02:00');
