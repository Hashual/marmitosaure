INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 88f2a6c9-ca8e-499b-a830-2c0f2113a757, 'La crème au mascarpone fait comme une crème anglaise !! je fais régulièrement de très bons Tiramisu, mais avec une autre recette : 300 grs de mascarpone et 6 oeufs !!! Et je peux vous assurer que la crème est ferme. Pourtant ici je l''ai bien laissé reposer 24h. Qu''est-ce que j''ai raté ? (pourtant ça a l''air très bon...)', '2021-08-06T12:02:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, aaecee40-fb90-4f43-85a0-460aaf87cc17, 'Excellent et rapide !', '2021-05-12T16:03:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 1b75af4f-6116-41c2-8574-16a0fe0505c8, 'Absolument délicieux !! J’ai fait la recette à la lettre et j’ai laissé un peu moins de 48h et c’est parfait ', '2021-04-05T20:28:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 17cdbccd-6256-4372-ae7d-443b44d21dc1, 'La recette n’est pas correcte au niveau du mascarpone ça devient trop liquide il fait mettre 500g.', '2021-03-19T18:33:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 34a186aa-3a12-4c88-8fd0-6ed5b479faf8, 'Vraiment délicieux !', '2021-02-20T15:44:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 97f15b15-48cc-422a-a1b6-170bd1b02bbd, 'Parfaite avec les framboises  du jardin  rien à  changer ', '2020-11-07T13:13:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, d2ae2cce-6972-44d1-b5ff-3debfdd0b935, 'Juste délicieux ! Jai pris directement des framboises surgelées.le sucre roux directement à  remuer avec les framboises leur donne un meilleur goût. La crème est délicieuse ', '2020-10-23T09:37:02+02:00');
