INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331370, 424baff8-ca93-4b5e-bcf2-aaf8df7e43fb, 'Génoise trop épaisse donc je l’ai coupée en deux. J’ai aussi ajouté du sucre au miroir.', '2019-11-09T22:01:46+01:00');
