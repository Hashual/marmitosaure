INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92486, 8c5275d8-74da-43d0-848d-12d3f5f4f48d, 'Tarte facile, bonne et réussie ! Mes invités ont adoré ! 10 min de cuisson en plus par contre. Je recommande 🤩', '2023-04-16T20:21:29+02:00');
