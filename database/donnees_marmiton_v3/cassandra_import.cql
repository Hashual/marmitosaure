INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, d483800f-7302-4629-99a7-8f9fc306fbd4, 'Très délicieuse les enfants ont aimé ', '2021-11-28T17:11:24+01:00');
