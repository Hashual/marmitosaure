INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 376b4676-d5b9-40a7-9d59-153c7d4e2ef0, 'Très simple et très bon ', '2021-07-28T16:18:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, ef672062-bcb2-4541-b2db-9ab5553913f2, 'très bonn', '2020-12-17T19:51:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 24d30836-84dc-4e97-8694-391ed429703a, 'Simple et délicieux pour le goûter !', '2020-11-10T16:00:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, d76ed357-3978-46ba-8dde-a82926617130, 'C''est délicieux.', '2020-09-22T01:12:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, a4f805f9-5885-4f3c-b48b-98f596de7123, 'Très bonne recette, super rapide !! ', '2020-08-07T18:45:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, b87fbbbd-c805-4777-8a70-fa8efc9384a5, 'Je rajoute des pépites de chocolat pour l’aspect gourmand.', '2020-02-15T08:02:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 279166eb-56d9-40a5-9a68-6f24665bcf4e, 'Frais et excellent !', '2019-09-15T05:45:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, a36e846a-4927-46dc-8edc-21b8a8b53604, 'Très très bon avec du lait végétal coco. Rafraîchissant', '2019-05-21T13:11:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 9f902d87-734c-4809-bdbe-efd03a4c1453, 'Très bonne recette surtout quand il fait chaud dehors. J''ai même personnalisé la recette en ajoutant des fraises.', '2016-06-03T19:54:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 1d13b93d-02f4-49b8-9c9c-8883e32f64f0, 'Excellent, personnellement, j''ai ajouté 2 cuillères à soupe de poudre de cacao pour le côté chocolat...c''était parfait!', '2016-05-09T22:40:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, bbe0cec7-89d3-4102-8f33-2cb1d702c3a9, 'Excellent ! Je n''ai pas mis de glace vanille, j''ai mis un sachet de sucre vanillé, mmmhhhhh !!!!!! J''ai rajouté du sucre.', '2016-01-29T01:21:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 10ea4478-e8c3-49af-bcba-4c330a035002, 'Super bon ! Mais éviter de boire au soir car c''est plutôt lourd... Mais il reste délicieux ! ', '2015-05-17T00:54:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 04275d69-e819-40e2-a893-9100f15fd353, 'C''est mon dessert préféré ', '2015-04-17T11:33:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 84b10a00-ecc3-4ca5-86c8-6cf9e3099dea, 'Assez satisfaite de cette recette.', '2015-04-09T20:27:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, b547b037-8fe0-4981-a0da-e765317c12f6, 'Mes enfants l''aiment beaucoup !', '2014-09-15T21:31:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 80727b46-c7b1-4c0b-ae37-0d91c7ed60e3, 'J''ai changé la recette au lieu de mettre du lait j''ai mis du lait de coco, deux bananes et deux boules de glace vanille. Excellent. ', '2014-05-19T15:47:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 55ad6edb-5169-4a86-866e-c2072ec3c820, 'J''ai mis plus de glace vanille, une banane en moins et moins de lait Très bon', '2013-09-10T00:04:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 4c83c54b-5249-449c-92ca-5179678b8da4, 'Mouais, bof... Je n''ai pas mis de sucre comme spécifié dans les commentaires car je n''aime pas trop sucré mais j''aurais du... C''est fade sans... Bref, à faire mais à améliorer !', '2013-08-03T16:02:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 5dfa7464-6d7d-4625-8c3d-09d07c6c4eb4, 'C''est bon mais effectivement il faut mettre 200 ml de lait au  lieu de 500, rajouter de la cannelle ou du sucre en poudre et même deux boules de glace à la vanille ce sera meilleur. Ne pas oublier de le mettre au frais.', '2013-02-23T20:25:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 89c10020-d963-4c85-84cc-8d62bb7e5389, 'Excellente recette !! Je conseillerais de mettre un petit peu moins de lait, si vous le préférez plus épais ! ', '2012-10-25T17:47:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 317aaa7c-6ca8-488b-a6d0-e26abff84d0b, 'Parfait ! N''ayant pas de glace vanille j''ai mis glace caramel. J''ai mis 200 ml de lait pour 3 bananes des glaçons 2 cuillères à soupe de cassonade et un peu de cannelle... une tuerie !', '2012-07-22T14:24:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 49f6ab94-4e8f-4d49-ab99-86adf5f41c0f, 'J''ai ajouté un peu de cannelle en poudre, le tout servi dans un verre recouvert de chantilly ! Une tuerie !', '2012-05-14T01:35:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, d715b5fb-0c2f-43cf-b702-c76c95496b78, 'Pour une personne et une recette un peu moins diluée prenez une cuillère à soupe de glace, une banane, 10 cl de lait. Alternative aux glaçons : mettez le lait et les bananes au frais ou réservez votre milkshake au frais. Miam', '2012-05-05T18:18:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 8a119860-124d-459a-94b6-ed55b24900b0, 'Très bon !  Mais n''oubliez pas les glaçons ! ', '2012-03-25T16:25:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 1c535c51-234e-4f3e-b687-23646db2236b, 'C''est vraiment excellent ! Il manque juste quelques glaçons...', '2012-01-21T16:20:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 69ff13a1-9e88-4308-a64b-f1c0fd6eec60, 'C''était délicieux, j''ai seulement un peu changé les ingrédients.', '2011-12-04T10:25:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, d526f2ec-2930-45b8-bd96-3a3515d457fa, 'J''ai moi aussi un peu revisité la recette en diminuant la quantité de lait et en ajoutant un peu de sucre roux et quelques glaçons. Mmmm très frais... Merci pour cette recette ', '2011-10-09T15:26:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, ff7f6636-f5f5-415b-bedb-094eb636009b, 'C''était très bon sauf qu''il faudrait mettre un peu moins de lait ', '2010-05-09T17:21:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, dd1928d9-534a-47b1-9563-312ece652c25, 'C''est très bon ! Moi, j''ai rajouté une banane et j''ai mis le blender au frigo la texture en était meilleure !', '2010-05-07T19:41:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 45cca295-1eeb-4e2a-ac65-f17a52598271, 'J''ai un peu modifier à cause de la consistance. Pour 2 : 2 Bananes, belles boules de glace à la vanille, 20 cl de lait.', '2010-03-15T19:14:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 81abcd25-b377-4b94-93da-8306f072acaf, 'C''est bon mais... un peu liquide 500 ml de lait me semble trop , en rajoutant une banane c''était mieux. ', '2010-03-06T14:48:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 4ec113bc-6245-472c-9aab-53bd6de49382, 'Très bon. Recette à refaire!', '2009-04-21T15:30:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 46f1ff65-fca5-4c35-be27-c434eaea779d, 'Très bonne recette mais il faut une grande banane!! A refaire avec plaisir!', '2009-03-31T19:38:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 02b1d4fc-4424-42ac-84ee-34b07c7747aa, 'Bon, nous l''avons accommodé à notre façon, nous avons rajouté une banane, 2 boules de vanille, une grosse cuillère à soupe de sucre, et du jus de fraises. A refaire.', '2009-03-28T17:23:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 41450b46-22bc-44a3-8999-78f83132968a, 'C''est vraiment super bon. Je rajoute juste une boule de glace supplémentaire.', '2008-09-01T20:58:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 9cef8d62-c7ae-4dd6-87f9-f2f9535fd4bd, 'Très rapide, facile et délicieux!!! On pourrait par contre rajouter une ou deux boules de glace vanille car je trouve qu''il n''y en a pas assez... Mais sinon, super recette, très simple, à faire sans modération ^^', '2008-08-24T18:00:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 47ee61a3-9484-4d08-96f0-31303febdfe5, 'Bah, mon mari et moi,nous n''avons pas du tout aimé, et puis c''est fade.', '2008-06-04T23:31:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 2d9abbc3-ca94-4747-baa3-cf52bb6c9c26, 'Recette très rapide et c''est super bon!!!!!', '2008-04-13T22:16:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, aaff97af-f944-4922-9351-548a531cc516, 'Rajouter à tout cela un peu de sucre vanillé et une cuillère de miel d''accacia. Tout le monde à adoré.', '2008-02-02T17:16:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 93e5abf9-8fa2-489e-84ed-ad7ec11b27a8, 'Un vrai délice. Petites astuces: mettre les verres dans lesquels seront servis les milks shake au congélateur pendant 15 minutes avant de les remplir, une petite feuille de menthe en plus : trop bon... ', '2006-08-31T04:57:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 00f4b5e4-69e9-41b0-a85e-36f84dcf593a, 'Trop bon!!! En mettant 2 boules de glaces, du sucre roux, 40 cl de lait ainsi que quelques glaçons avant et après avoir mixé, je vous le conseille ! En plus c''est trop facile !', '2006-05-20T20:29:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 0453521e-03b8-4a09-af25-df15a578f0fa, 'En suivant les autres commentaires, j''ai mis deux boules de glace et 400 ml de lait. J''ai aussi mis 4 bananes au lieu de 3, et ajouté quelques glaçons. Et c''est délicieux!', '2006-03-01T11:23:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 0f1a7f28-76c7-4205-8a49-5822596ad25a, 'Très bon et rapide à faire.', '2006-01-14T17:19:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, c744a750-bbf6-4c1b-8ca5-d4c55a822d25, 'En suivant la critique sur l''épaisseur, j''ai mis 2 boules de glace et 400 ml de lait. C''est trop bon!', '2006-01-05T17:27:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 94c38c68-5685-4f58-8420-9bede8e61a46, 'Très bon. Encore meilleur en ajoutant quelques glaçons avant de mixer.', '2005-08-13T20:32:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 0e39f495-6eb2-419c-830e-a1df5d01e94f, 'Agréable en bouche, mais pas assez épais...', '2004-08-09T15:34:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 07c28cff-fb20-427a-9cba-b781c81f156a, 'Un délice, on ne peut plus facile à réaliser! :)', '2004-04-15T18:17:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 9dd62c92-40ed-4db5-acc0-2d3aab3695e9, 'J''adore ça... Mais j''aime bien ajouter quelques glaçons avant de mixer, ainsi qu''une cuillère à soupe de sucre roux pour le parfum.', '2004-01-27T20:50:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 8756ad80-bf01-4cda-815d-abb1a8885ca7, 'Délicieux!!! Pour une plus belle présentation, je rajoute du chocolat liquide sur les parois du verre. FRAîCHEUR GARANTIE!!!', '2003-10-29T17:55:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, 609bed6a-2f1d-4ed6-b6ca-919d76eb554e, 'Très bon et rafraîchissant.', '2003-07-16T13:26:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, e2441203-a750-4bee-b5b8-11ad93aeee2c, 'Excellent et simple à réaliser. Et surtout très rafraîchissant!', '2003-04-01T21:42:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40692, 807f8fbe-fcda-4c0c-9735-834683167a1c, 'J''ai suivi le commentaire de fab099 et ses conseils sur les proportions ; je confirme que le crumble est délicieux !', '2017-04-23T19:47:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40692, 41d4850f-884b-463e-98ae-c4bbdb664766, 'C''est une bonne recette, le crumble est croquant et moelleux à la fois. Par flemme je n''ai pas fait le caramel et c''était très bon. Par contre pour la même quantité de fruit j''ai doublé les proportions de la pâte. Elle est dans mon carnet.', '2016-07-31T12:39:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40692, ffbc487b-5a37-4fce-ae9a-0bbe48787bae, 'J''ai utilisé du caramel au beurre salé tout prêt. Ensuite j''ai diminué à 100 g la quantité de beurre et ajoute 100 g de noix de coco. Servi tiède avec une boule de glace vanille ou de la crème fraîche  Un vrai délice !  ', '2015-07-26T11:36:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40692, ec9295c6-0841-47ef-b189-08a44138527d, 'J''ai suivi le conseil de mettre moins de beurre et plus de Sucre dans le crumble, c''était un délice !', '2014-08-29T23:23:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40692, 74aaa3d1-1851-4cd9-beae-7521d643894d, 'Il y a beaucoup trop de beurre en proportion des autres ingrédients ! Voici ceux que j''ai utilisé : 150 g de farine, 75 g de beurre, 120 g de sucre. Pour celui ci c''est trop tard, je dois étaler une pâte que je ne peux pas émietter... Quel gâchis... ', '2010-05-21T20:58:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40692, f0fead11-83a4-43b5-8e6b-5554e373ebfd, 'J''ai fait cette recette avec de la compote de rhubarbe au lieu de prendre des tiges de rhubarbe, il faut simplement diminuer la dose de sucre, et je n''ai mis qu''une banane et demi. Délicieux...', '2008-06-23T00:38:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40692, 2d569884-7d9b-45d0-afca-72951104e7e7, 'N''ayant pas de caramel et pas l''envie d''en faire, j''ai mis 80 g de sucre roux et un peu moins de rhubarbe. C''était excellent. Un dessert gourmand mais pas trop lourd !', '2008-05-21T10:29:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40692, ade72e09-7cf2-43cc-9bea-f2a35eadfcb9, 'J''ai utilisé de la rhubarbe congelée (dégelée avant!). J''ai mis de la cassonade à la place du sucre roux, et saupoudré le fond du plat de cassonade également, à la place du caramel. Le mélange bananes-rhubarbe est très bon, la banane annule totalement l''acidité de la rhubarbe. A refaire!', '2007-02-18T14:12:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40692, 5f9db9e1-79ae-4d8f-9b1c-636760b29ee2, 'Moi j''ai essayé sans le caramel, pour que ça soit plus léger. Mais du coup, on sentait un peu trop l''acidité de la rhubarbe. Peut-être en la saupoudrant d''édulcorant...', '2006-09-12T13:35:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40692, f37fcdfd-b831-4db6-9c37-f182bb952100, 'Vraiment très bon. La banane enlève l''acidité de la rhubarbe. Très agréable en bouche.', '2006-05-22T15:03:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40692, bc372c48-6972-4f75-9d4d-d7c3fef90d01, 'Très bon crumble, sucré comme il faut, rapide à faire, c''est un dessert que je referai avec plaisir.', '2006-05-18T12:30:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40692, f9de599d-86ec-40e0-97fe-88b4a5fc6cd0, 'Les goûts de banane et de rhubarbe se marient très bien et ça change des éternelles pommes, mais au prochain  essai, je ferai absolument dégorger les tronçons de rhubarbe dans le sucre avant de les ajouter, de façon à ce que le dessert soit moins acide et à ce qu''il y ait moins de jus.', '2006-05-07T23:50:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, fbda720e-c9e8-4cfd-96da-48268899942c, 'Super recette même sans coriandre pour ma part !', '2020-04-08T07:35:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, 32147cc8-bc61-42a6-a670-8819b29a0fe4, 'Nous nous sommes régalés la semaine dernière. Et c''est au programme du repas de ce soir !!', '2016-02-09T21:39:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, c6ddb8f3-a81c-4933-8d09-0a01cde0325c, 'J''avais peur de cette recette à cause des bananes, mais, nous avons, et ce, avec surprise, aimé ce mélange sucré/salé! Hourra! Un bon truc pour nous aider consommer les bananes achetées en trop. Par contre, si jamais il nous arrive ne pas avoir de bananes et bien, tant pis, parce que comme l''a écrit ChCastel, elle ne sont pas indispensables à cette recette qui est fort délicieuse aussi sans ces dernières.    Aussi, j''ai utilisé une bonne cuillère à soupe de coriandre en tube et du bouillon de poulet à la place de celui aux légumes et omis la crème.  Nous allons refaire cette recette agréablement différente ! Merci à Marmiton !', '2014-10-29T21:53:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, c6d35c66-436e-4a9c-854b-2fc228f8ed3c, 'Délicieux ! Ma fille de 2 ans adore !', '2014-10-06T13:31:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, 22e81fa5-9ebd-4e61-811f-563f539406e7, 'Je voulais faire une recette salée avec des bananes, je suis tombée sur cette recette. Finalement, les bananes ne sont pas indispensables... Mais le reste est d''un goût parfait, à faire !!! Cuisine épicée pour des lentilles (vertes), ça change.', '2014-09-24T10:45:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, 2e58e8ec-8ef1-4f10-8f8e-d46ad709489f, 'Recette succulente ! Réalisée avec des lentilles vertes et j''ai divisé les proportions pour deux personnes, mais en gardant 50 cl de bouillon. Temps de cuisson parfait. ', '2012-01-27T20:34:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, ba0533db-60c0-4a64-aca1-22ce98b99089, 'Ma-gni-fique ! J''ai utilisé des échalotes à la place des oignons, et des lentilles vertes à la place des rouges. Rien à redire !', '2011-02-09T21:36:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, a8ecda42-f778-489e-9a61-68359e03e358, 'Très bon mais les lentilles méritent au moins 1h de cuisson, j''ai dû remettre au moins 4 fois du bouillon par dessus pour avoir une cuisson satisfaisante. Au final très réussi mais nous avons mangé beaucoup plus tard que prévu ! ', '2011-01-31T13:26:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, b7e18aa0-e02c-4dee-a001-36e4e10a8a0a, 'Recette sympa et simple ! Un gros oignon suffit mais c''est au goût de chacun. J''ai caramélisé l''oignon avec un peu de sucre en poudre.', '2011-01-10T05:55:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, 1a87dc09-e02a-42ff-83d4-ecee0c1bd3e5, 'Vraiment délicieux. J''ai juste pas ajouter l''ail, parce que j''aime pas trop ça. Pour le temps de cuisson, il est bien pour ceux qui aiment les lentilles "croquante", moi je les préfères "purée", j''ai donc alongé le temps de cuisson. De toute façon, il faillait cuire le riz que j''avais oublié. Et en plus, ça se réchauffe très bien au micro onde !', '2009-12-13T13:02:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, 7fb14845-48f1-4135-b308-835169d9aa03, 'Nous avons adoré même sans la crème fraîche, un vrai régal !', '2009-11-25T22:04:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, 31437af2-e848-40e1-bf62-125484bd8dd4, 'Est-ce que vous avez bien utilisé des lentilles corail ? Ils cuisent vite normalement. J''avais envie d''un plat avec des bananes et nous avons testé et approuvé cette recette. Comme je n''avais pas tout dans le placard (ni ail ni oignon)et j''ai ajouté une tomate et une carotte (à la fin, pour garder le croquant). Miam !', '2009-06-24T22:51:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, 6b623ff0-b274-4ec3-9815-09a0531b5458, 'Absolument délicieux. j''ai rallongé le temps de cuisson des lentilles : 1 bonne heure.', '2009-02-18T21:40:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, a9314d78-b85a-467f-8d3a-a1beb8623c47, 'Délicieuse recette, faite sans bananes (Chéri n''aime pas trop le sucré-salé...) ni crème, et en supprimant un oignon et une gousse d''ail. Par contre, il faut effectivement augmenter la quantité d''eau et presque doubler celle de lentilles si c''est le plat principal.', '2009-02-02T22:28:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, 719c8a1a-49ba-45d4-85a2-b2db9141221f, 'Recette végétarienne idéale, très parfumée. Je n''avais pas de lentilles corail, alors j''ai mis des lentilles vertes (d''accord, ça fait moins indien...). Avis mitigé en revanche quant aux bananes : les enfants ont adoré, mais nous les adultes n''avons pas vu ce que ça apportait à la recette (et pourtant nous sommes assez friands du sucré-salé).', '2009-01-24T15:03:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, 91b063d2-bf64-4563-81c1-927dbcf41edc, 'Plat très surprenant et très bon! Mon compagnon n''était pas convaincu en voyant la recette mais après avoir goûté il a changé d''avis! Nous avions oublié de mettre de la crème et c''était très bon comme ça.', '2009-01-06T20:17:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, d1a49d40-df63-45d9-8f1d-0780c9895a4d, 'Délicieux et facile à réaliser! Je n''ai pas fait les bananes, je trouve le plat déjà assez complet avec du riz. Une bonne recette pour les végétariens (et même végétaliens en enlevant la crème fraîche).', '2008-04-22T16:42:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, 38f67a5c-4c16-41c9-8d8e-59367ed644bb, 'J''ai adoré cette recette sucrée-salée aux lentilles. La prochaine fois, je diminuerais juste un peu les oignons et l''ail ainsi que le temps de cuisson. Merci.', '2007-11-27T13:29:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, b12dc3e1-8a92-434a-ad8b-e1c661fe02c8, 'Une fois avec les bananes, une fois sans...de même pour la crème! Merci pour cette recette, toutefois il faut augmenter la dose d''eau et donc du temps de cuisson (le double).', '2007-09-25T21:42:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, 34e247c2-b1b3-46b5-ad8b-3a781e91cd3a, 'Je mange les lentilles plus par necessité que par goût et grace à cette recette je suis réconciliée! Les becs à sucre aimeront.', '2007-03-02T16:57:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, 4ed0f73f-9f70-4986-b204-1072fdc3848e, 'C''est dé-li-cieux! Mes bananes frites se sont plutôt transformées en compote, j''essaierai avec des bananes moins mûres la prochaine fois, voire des bananes plantains.', '2006-11-28T20:55:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39412, 841ee8b8-475b-4051-96bd-bc9e37ab7cee, 'Cette recette est une réusite! J''ai remplacé la crème par du lait de coco, qui se marie très bien avec les recettes de lentilles au curry... C''est vraiment très bon avec les bananes, très bonne idée!! J''ai accompagné de riz au noix, et j''ai parsemé l''assiette avec de la coriandre fraîche hachée, un délice!!', '2005-12-07T22:30:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83879, 01fa48d0-353a-4457-ab5a-c8ca43b49429, 'Merci pour cette recette qui a beaucoup plu pour un anniversaire ! La ganache est super onctueuse et le parfum de la banane A le temps de se diffuser, c''est subtil et pas écoeurant. J''ai utilisé de la crème supérieure Président pro.', '2016-02-05T09:46:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45076, 475eff25-05c5-4305-9f08-78b7038b205d, 'J''ai remplacé la glace vanille par de la glace au chocolat (c''est ce que j''avais a disposition), c’était très très bon, et tout le monde a adoré !', '2011-08-13T23:23:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45076, 592f5cd9-f49d-4341-a37e-9b505107ca07, 'Merci pour l''idée j''avais une bouteille de Baileys qui dormait dans le bar, par contre pour le deuxième verres j''ai ajouté 20 cl de lait et 1 banane ça fait un verre de 50 cl et gout du baileys est plus subtil, j''adore. En tout cas merci pour l''idée. ', '2010-02-13T18:16:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45076, 50b06c24-4799-4b95-9234-6e5ed42f296e, 'Ce n''était pas terrible.', '2008-06-13T12:18:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 7f598358-5f5a-4913-b5c0-7d34cae706d9, 'Excellent quand on y met sa touche personnelle : en quartiers, en rondelles ou en bâtonnets, peu importe : épluchez, coupez, mettez dans un grand tupperware avec l''équivalent d''une à deux cuillères à soupe d''huile d''olive, sel, poivre, persillade, paprika ou selon l''envie (curry, etc...) et secouez ! Les pommes de terre sont bien imprégnées de tout. Disposez sur papier sulfurisé et au four 30 min à 180°C environ selon l''épaisseur de la découpe. Résultat : du goût, de la saveur, du moelleux, bref... un régal !', '2016-06-28T22:51:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, f8e77984-1ad5-45e5-98c5-53acec555374, 'Parfait !! J’ajoute avec les pommes de terres toutes sortes de légumes : brocolis, carottes par exemple 
Puis filet d’huile d’olive, sel poivre et paprika fumé c’est juste un délice !! ', '2023-05-18T13:16:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 812ee6e0-2bfc-4100-9c10-e44fd3688301, 'Simple, efficace et tellement bon !
J''ai mis dans un sac congélation avec huile d''olive et herbes de Provence on secoue et hop !', '2019-04-14T08:19:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 95a968f5-e86e-44ca-9545-0764b7104289, 'parfait pour accompagner un BBQ, avec un filet d''huile d''olive et des herbes de Provence/ thym', '2023-05-24T19:44:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, f633e917-cecf-46f6-b67f-e735b37181a1, 'Simple, mettre le fromage avant la fin de la cuisson. C''était très bon avec du reblochon.', '2020-09-23T15:45:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 6f381377-fb56-4e6a-9e0f-5fd1ccbc732b, 'Les pommes de terre au four, ou les pommes de terre "pouf" comme on dit à la maison. C''est un grand classique dans la famille pour accompagner les grillades de l''été. Dans l''assiette, on ouvre la pellicule bombée sur le dessus et on y glisse un peu de beurre... Humm délicieux. Les enfants adorent et les adultes aussi.', '2019-05-15T17:59:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, c2c81224-4e7a-45e6-aa2d-db870986845a, 'Très bon ', '2023-03-27T11:24:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 30530955-d35f-4ca2-8cb3-0ad118920e2c, 'Trop bon', '2023-02-05T21:27:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, c53769af-7b0a-467e-9035-8ab640be15be, 'Super !', '2022-10-28T09:31:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 7d19c2bf-12b0-4d27-82c2-7794d60d3d6c, 'Facile et excellent. À refaire.', '2022-09-18T13:55:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 55a399b8-073e-4c62-81ad-c47013f5c1e0, 'Simple et très bon', '2022-02-26T12:58:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 38ee28f5-2e44-40bc-946f-130060e73c98, 'Facile, rapide et bon... Des invités à l''improviste, cela accompagne très bien une omelette !', '2021-09-13T13:12:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, cd74e10a-5d75-4f19-ba68-cb29e4649d66, 'Parfait ! En réponse à Moulig_91 j''ai mis mon four entre 180 et 200° ( thermostat 6/7 )', '2020-08-20T19:25:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, b57d681a-b905-4bfb-8de3-e1b6ccdc92d8, 'Excellent ! Avec une marinade huile d''olive et ciboulette, et un peu de gros sel. Temps de cuisson plus long avec mon four, 50 mn. Tout le monde s''est régalé. ?', '2020-02-09T03:34:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, bfa3b709-cb6b-4b46-8309-9db32ef63e2f, 'Excellent et facile ! Je plussoie l’idée du sac congélation, on met tout dedans, on secoue et hop ! Un bon repas prêt en 35 minutes. Avec un peu de parmesan râpé et de la crème fraîche, miam !', '2019-08-10T10:18:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 64361157-5ab6-41e8-ad96-0ff3586a1a5c, 'Pas mal, mais écrire "sans graisse"... Si ce n''est les 30% du fromage', '2019-03-28T13:15:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 3a52c70d-08dc-48d6-9284-3da2c71e1bab, 'Prendre plutôt des petites pdt pour 30 mns de cuisson et délicieux avec du saint nectaire (une bonne tranchette sur chaque)', '2019-03-15T14:09:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 64f72e3e-ec3a-4c79-93d2-bd1a65e40dcb, 'Excellente recette.  Un vrai régal simplissime ! A refaire  !', '2018-09-30T03:54:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, fb50de3b-0e2f-4225-9ed5-d8c2efebff29, 'Super facile merci beaucoup ! Rapide et simple et surtout un régale.', '2018-04-07T13:52:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 23e8e407-e19a-4cd1-878a-daa45f282ee2, 'Plus personne ne veut les pommes de terre autrement ! L''astuce de l''huile dans boite hermétique pour les enrober légèrement c''est top!  Bien rôties, c''est plutôt 40 minutes à 180°C.', '2017-01-26T13:15:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 8398d147-1a45-4def-8085-721a391a5ec7, 'Comme beaucoup d''autres personnes, j''ai, moi aussi, fait macérer les pommes de terre épluchées et coupées en grosses tranches avec huile olive, herbes de Provence, sel, poivre, épices diverses (curcuma, paprika), puis cuisson à 180°C (thermostat 6) pendant 45 minutes ....un pur régal! Merci pour cette recette. ', '2016-02-21T21:34:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 01d73f63-179d-495b-90b1-d10dac5a3a5a, 'J''adore, je la refais et la referai encore ! Je mélange dans un saladier pour plus de facilité comme indiqué dans un commentaire, bref j''adhère.', '2015-11-01T12:12:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, f2a6798d-8013-4fe5-a6a4-c92b1cdda7ed, 'Tout simplement excellent ! Avec un peu de fleur de sel en fin de cuisson et très bien pour accompagner une bonne viande rouge.', '2015-02-13T20:53:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 9c876df3-770e-4a0a-ae2d-a379b84eecc9, 'Si vous souhaitez déposer une légère couche d''huile (je conseille l''huile de noix) sur vos pommes de terre, mettez-les dans un saladier fermant avec un couvercle ; y ajoutez une cuillère à soupe d''huile, fermez le couvercle et agitez vivement. Vous pouvez y ajouter des herbes, du gros sel, des épices...', '2014-11-18T19:07:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, c7a16e89-5a54-4fe2-8d48-d9fa6f601d51, 'Une valeur sûre et simple à préparer. Meilleur avec un peu d''huile d''olives et des aromates. Pré-cuisson inutile. ', '2014-06-07T23:09:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 38935bda-412d-4b21-9f0b-e82a15dcba7e, 'Je fais toujours mes pommes de terre en casserole à l''eau ou sautées à l''huile dans une poêle, j''ai voulu changer pour les faire au four : bien meilleur. On sent bien le goût et rappel les pommes de terres traditionnelles de campagne servies dans les patateries (oui ces restaurants existent). Nature et pas une goutte de graisse, le top !', '2013-10-11T20:40:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, d05be497-3dff-413f-b9f7-df04821b1018, 'Une très très bonne idée d''accompagnement. A servir avec une sauce crème fraîche-ciboulette. TOP !', '2013-08-16T01:04:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, e1653bb0-4c84-4525-a5ae-3b52dbfa8e0d, 'Ha oui ! C''est vrai ! Je vais faire goûter aux enfants, c''est délicieux et ça change ! Merci', '2013-04-25T16:34:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 1ec449c9-604d-4afa-86e8-557e1dfadfa2, 'Super bonne recette, je l''ai faite avec des truites (un régal) et j''ai rajouté de la persillade sur le dessus. La prochaine fois j''essaie avec le fromage.', '2009-05-08T22:20:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 96c16971-8041-4de0-ae59-00c9c5a444e9, 'Très facile à réaliser et excellent. J''ai fait cuire 50 minutes à 200 degrés. Ce n''est pas gras du tout et c''est assez original.', '2008-02-14T21:54:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, b26b9e86-5f30-465d-b842-2a37ec802b97, 'Excellent!  Pour ma part, j''ai ajouté une sauce à base d''oignons, d''ail, d''herbes et de crème fraîche.', '2008-01-18T21:55:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 2fadb502-b697-405d-8df7-57ac4da85de0, 'Excellent! Tout bête mais vraiment bon. Les pommes de terre sont à la fois moelleuses et dorées. Nous les avons mangées avec des saucisses et du yaourt.', '2007-08-02T19:16:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 7c2d804e-8b2c-455f-b2df-c265acb67065, 'C''est croustillant à l''extérieur, onctueux à l''intérieur. A faire pour accompagner toutes sortes de roti.', '2007-06-03T16:27:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 063ae2fc-a70a-4f41-9b25-3209284a1974, 'Délicieux 👍', '2023-10-30T12:40:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, f86ab12c-1a4c-44ef-a133-347f66a57cd5, 'J aime ', '2023-10-09T06:41:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, ad74ecb3-b170-4e40-8db3-ed168ada6b7e, 'Niquel❤️❤️❤️', '2023-03-06T16:36:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 95bdbb80-2974-47b4-931b-bc7e0af46ebf, 'Épatant ! Juste avec un peu de sel pour accompagner un plat en sauce. J’ai hâte d’essayer tous les trucs des autres commentaires. ', '2023-01-10T08:03:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, fcdd2a9b-576c-40bd-9a0c-1a71aefd8f23, 'Facile et délicieux.', '2021-08-22T20:57:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 998174d4-dfc7-44c2-ac4e-e6692cdae176, 'Temps de cuisson nécessaire beaucoup plus long qu''indiqué dans la recette (compter une bonne demie heure en plus au moins). ', '2020-12-12T21:41:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, fe4da73f-4217-4479-9ac8-aae681dc8e73, 'Moi je les vides je fais une purées avec la chair je rajoute du jambon et du gruyère je remets tout ça au four c''est super bon.', '2020-11-11T18:13:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 16160784-5ebb-4c10-8982-ad59f18d8724, 'Délicieux et économique !', '2020-09-20T21:54:25+02:00');
