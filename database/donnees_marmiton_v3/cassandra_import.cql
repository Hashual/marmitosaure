INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, d2fec52a-a9ea-45cc-8aa7-de54d1e7e9f9, 'Excellente! Enfin j''arrive à faire une pâte sablée ! J''ai doublé les portions pour la crème pâtissière,  et il m''en reste un peu pour un dessert improvisé. ', '2023-06-11T10:57:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 3170fbaa-502b-40e8-b3dd-aee92724d31b, 'Vraiment super cette tarte aux fraises ! Pâte et crème anglaise très bien expliquées et très bonnes,un grand merci pour cette superbe recette ! ', '2023-05-25T15:12:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 5c1e3b01-64dd-49c9-851e-21b51dba3c9a, 'J’adore parfait pour faire passer son message à son crush… 
J’ai passé une bonne soirée 
Je recommande et recommence ', '2023-02-27T05:44:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, eb257cf3-a5a7-4ecb-b616-5ab14b3716e7, 'Facile à faire et le résultat est excellent. Je mets un peu plus de lait (30 cl) pour que la crème pâtissière n’épaississe pas trop et je remplace le sucre vanillé par deux gousses de vanille et j’ajoute 3 ou 4 feuilles de menthe dans le lait à faire bouillir.', '2022-06-27T00:15:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, ae785cc2-860a-40ff-a4c2-9024c3c9fa82, 'Mis une pâte brisée. Fait une crème pâtissière et incorporez les fraises. Excellent Marmiton ! Merci pour cette recette !', '2022-05-13T20:20:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 493cfd54-42b8-4b8d-a9d5-c832b03b4e15, 'C''était délicieux ! Ma première tarte aux fraises. ', '2022-04-30T21:26:57+02:00');
