INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, d709ce7a-4f1a-4825-b785-258dc897e5aa, 'Simple et rapide cette recette et délicieuse.', '2019-08-26T11:02:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 8da9ff4d-16c2-4146-a67b-89c1e31a092b, 'Délicieuse recette !  J’ai adoré ce milkshake à la banane -pêche. Au top ;)', '2019-08-20T06:23:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 9f6fe092-a969-44ac-8ce5-9b47fbbec23e, 'J’adore cette recette ! J’ai mis deux bananes et une cuillère à soupe de sirop d’agave donc pas de sucre, le tout mixé dans mon robot culinaire c’était très rafraîchissant tout le monde a adoré ??', '2019-06-25T21:02:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, e2bd2ecf-db08-48c9-9b26-fd97785bf830, 'Ai testé avec de la stévia... Que du bonheur !', '2019-04-22T18:53:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 4e80af2c-0f36-47c9-aebb-8cd0ad0d47a0, 'Très très bon ! Pour la ligne je n’ai pas mis de sucre et c’est aussi bon !! Merci.', '2019-04-20T01:41:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 8fe7a7f9-94f8-4a13-8dcf-14ffd37ef411, 'Ayant testé la recette initiale j’ai rajouté une touche de crème et une touche de glace banane pour le crémeux, c’est encore meilleur.', '2019-02-26T11:00:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, e9b24427-c80a-4403-9f5c-1c18e7695ca6, 'Super bon', '2018-11-02T09:38:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 94f3b054-94e2-4ff1-a1eb-b23da580000d, 'Ma fille a adoré !', '2017-09-08T17:34:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 3f0a0dbf-d1c8-4eb4-ab5f-dc7f12eb8cd8, 'Super succulent j''en ai repris 5 fois ', '2017-05-28T21:20:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 9a2fd080-4291-4f7c-8470-0af5323a8bcb, 'Hum une tuerie !! J''ai suivi les commentaires et j''ai mis deux bananes ben c''est vraiment trop bon !! À faire et refaire sans modération !', '2017-05-13T23:24:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, f60eb1c6-1118-41e7-8290-f8fe11ddfb5e, 'Très bon moi j''ai mis 25 cl de lait, 20 cl de crème liquide, glace pilée et deux bananes mais pas de sucre car je n''y ai pas le droit, c''est un régal. ', '2016-06-05T15:15:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 006a5ac8-2182-4a29-85ca-71bd72a0c2ea, 'Même recette avec des fruits rouges... super tout le monde a adoré ! J''ai juste mis 5 glaçons ', '2016-05-18T22:33:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 294b83d9-c91d-436a-a1d3-7b7f9eae2719, 'Délicieux !!! Très facile et rapide à faire il est parfait quand on ne sait pas quoi faire pour le goûter!', '2016-03-06T17:26:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, f718b5bc-aca6-4b39-9aaa-d1e2c62c580a, 'En effet,  facile et absolument délicieux', '2016-01-20T16:54:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, bd0e0860-d2fb-40f4-9c1b-51a578822c8f, 'Super bon mais j''ai juste mis du sucre vanillé car j''ai ajouté un yaourt à la fraise... ', '2015-08-04T19:33:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 0d997aa0-d6fb-4ddd-95aa-4831a127c86b, 'C''était très bon mais on ne sentait pas vraiment le goût de la banane. La prochaine fois j''en mettrai deux au lieu d''une.', '2015-07-29T10:57:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 47e49d09-4c18-4a3d-a121-296eadb520de, 'Excellente recette  je l''ai bu le matin avant de partir en cours ça m''a calé jusqu''à midi. Par contre j''ai doublé la dose de banane et de glaçon. ', '2015-03-11T08:03:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, bdef3b1d-02f9-4f5a-bb96-d9ead122a58b, 'Super bon. J''ai fait quelques changements : 2 bananes, 4 glaçons,  20 cl de lait, 20 cl de crème liquide, et un peu de vanille liquide. C''est une tuerie !', '2015-01-16T17:01:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, ca0cda9a-21a5-4188-8eab-5f37e47afd9b, 'Super bon ! J''ai mis un sachet de sucre vanillé et plus de glaçons pour que ce soit bien frais.', '2014-09-07T12:13:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 70470ac4-6676-4caa-9311-65bf9937a20f, 'Super bon mais je rajoute 2 boules de glace à la vanille :-)', '2014-08-04T19:31:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, cd2525a4-5ef1-4a14-a4db-3d3901c497a5, 'Très bonne idée de recette mais trop sucré. Un sachet de sucre vanillé suffit + j''ai mis 2 bananes au lieu d''une et 20 cl de lait supplémentaire à la préparation.  PS : si vous n''avez pas de glaçons, vous pouvez mettre la préparation 15 min au congélateur avec les verres à milk shake', '2014-04-21T18:45:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 4c0997db-01fc-4f0f-8d36-1331d3c3b9e8, 'Un gros plaisir à déguster avec sa copine ou son copain :)... Mais moi je l''ai faite avec une poire et c''était parfait... petit régal ♡', '2014-03-09T11:51:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, db8cce5c-c2e1-4bfb-99ba-5a9f6a8e31a2, 'J''ai essayé avec 20 cl de lait + 20 cl de crème liquide et 1 sachet de sucre vanillé, 10 glaçons et 2 bananes, un pur délice.', '2013-12-15T07:46:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 898c360d-141e-4422-878d-723e9efaa1b2, 'Premier essai en suivant la recette et... pas terrible...! Alors j''ai mis 25cl de lait et 20cl de crème liquide et la... Hummm un délice!! ', '2013-08-14T22:26:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (372330, 70fb2bbf-83cb-4cb4-810b-111ed9ac3fb2, 'Super recette très simple réalisée en 2 minutes, il me manquait le yaourt donc j''ai ajouté une banane en plus pour la texture', '2021-01-04T01:08:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (326819, aee86fa2-82cc-4a5b-b898-26a3611dd857, 'Recette à ne pas refaire, j''ai bien suivi la recette mais le résultat est nul, la mousse n''a pas prit.', '2017-07-08T13:50:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (326819, 8272715e-051e-4000-b54d-19928af5178c, 'Bon mais trop sucré!', '2016-10-14T21:06:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (326819, f1a03d83-594b-4874-87e8-6b5b1dd74b26, 'J''ai remplacé le lait par un bouchon de rhum. ', '2016-10-05T15:28:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65126, 16528080-e7f6-45e9-bfb5-92d08efe25ad, 'Il y a un problème de dosage et d''expliquation..', '2022-03-11T18:50:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65126, 4b06560f-10f3-41d0-8c18-8c6a6146856e, 'Excellent !!', '2017-08-11T15:19:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (254535, 430ace48-7961-4692-8617-42ef852cfcdd, 'Très bon ! À refaire sans hésitation...', '2017-07-13T01:17:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (254535, 538fcc02-54e1-411f-a081-d3bf9c75d199, 'Clafoutis excellent, très moelleux, pas du tout compact. Très bon !', '2014-06-28T10:34:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (254535, 9173ecf3-9d1c-40b7-9331-4238ef1bbe56, 'Je n''ai pas aimé du tout.', '2014-05-04T14:27:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12953, 3ad3d6dd-6c4a-4a28-8cd1-755eec3c0dcc, 'Il faut rincer une poignée de perles du japon puis mettre dans 3-4 verres d''eau froide et faire bouillir en remuant tout le temps(ajouter de l''eau si besoin) ; il faut cuire dans l''eau et non dans le lait de coco, qui ne doit pas bouillir. Quand les perles sont transparentes (après environ 15-20 mn), ajouter pas mal de sucre, 1 boîte de 250 g ou 1 brique de 500 ml de lait de coco, et 3-4 bananes en tronçons. Chauffer à feu doux, et là, tiède, ça mérite en effet un 5/5!', '2009-02-28T22:11:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12953, 29ec32fa-7166-49b8-a11d-11139c92d4fc, 'La recette n''est pas juste. Il faut mettre moins de perles, 20 min suffit amplement et il faut mettre les bananes dès le début pour mijoter.', '2022-03-19T13:42:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12953, f0e894be-2435-46b5-962b-16a0fc1e5604, 'Recette suivi a la lettre  sauf le temps de cuisson 10 15 min suffisent
Tres tres bon et tres simple sans chichi
', '2021-03-20T20:05:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12953, 65111b56-bb71-4689-b8e1-693d7a8d51ee, 'Je n''ai pas pu le faire 30 mn car collait à la casserole. Je ne sais pas du tout ce que cela devait donner mais ça ressemble plus à une bouillie. Mais, très bon! J''ai mis des pommes à la place de la banane.', '2007-06-15T19:33:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12953, 67ae3426-513b-4325-bdc5-a02264bef479, 'Trop collant, pas assez liquide alors que j''avais suivi le conseil des internautes en rajoutant de l''eau, et pas assez sucré. Alors, peut-être que je n''avais pas les bons ingrédients et que j''ai mal suivi la recette mais je suis déçue.', '2007-03-07T12:06:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12953, ac87ca66-d6e1-4828-a81c-4f1ba3b826d7, 'Pour les fans du mélange noix de coco et banane, cette recette est carrément conseillée! Je suis trop fan, il est vrai qu''avec plus de liquide cette recette est encore meilleure...', '2006-10-05T01:53:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12953, d5991657-646d-4f6a-8404-659a2686d19b, 'Délicieux, mais il faut effectivement rajouter autant d''eau (25 cl) que de lait de coco pour cuire le tapioca ou perles du Japon. Pour ma part, je sers ce dessert avec des graines de sésame grillées à sec et mélangées à un peu de sel, oui, du sel! Comme au Cambogde.', '2006-03-12T22:14:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12953, 0b9ad196-78a2-48d0-ab40-4458872185da, 'C''est fameux, mais attention à ne pas cramer la casserole: rajouter plus de liquide est mieux. Personellement, je rajoute beaucoup de gingembre. C''est miam.', '2005-12-04T13:25:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12953, d98db757-67ab-4367-b5b2-b75694bd1896, 'Un bon petit dessert, tout simple à préparer. N''ayant pas de perles du Japon, j''ai remplacé par du tapioca. C''est très bon aussi, sucré comme il faut. Je pense qu''à l''avenir, je ferai cuire les bananes dans le lait + lait de coco un peu plus longtemps afin qu''elles soient bien fondantes. C''est bon froid mais meilleur tiède.', '2004-09-11T17:24:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12953, a63a4050-e80a-4c78-9ef0-0317cbbbc462, 'Le lait de coco est très épais et ne permet pas de cuire les perles 30 mn: rajouter autant d''eau. Goût un peu fade. Parfumer davantage: la banane, c''est très bien, rajouter des pommes coupées très fin, des amandes effilées, des poires coupées fin, et quelques raisins secs trempés dans de l''eau chaude et bien égouttés. Alors, c''est très bon, onctueux et ainsi parfumé!', '2002-10-14T20:46:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12953, 442be7de-b05b-43f7-90b9-ed927613ade9, 'Se déguste tiède. C''est un dessert servi dans les restaurants asiatiques. Il faut ajouter un peu de cacaouhètes pillées sur le dessus, avant de servir. C''est succulent!!!', '2002-07-30T14:35:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (327595, e2099b0f-9841-410a-b243-45002ab73dda, 'Merci', '2014-09-11T08:06:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34208, a830925f-2343-455c-a4e8-07be1603b9d1, 'Excellent. Un vrai régal pour la bouche et pour les yeux (l''ananas est matière à décoration)! Seul bémol : deux poissons pour un assaisonnement trop proche. Le thon devrait tolérer une marinade plus relevée soit dans l''acidulé (citron jaune plutôt que lemon + poivre ou ail éventuellement comme suggéré) soit dans le pimenté (petits piments rouges). Histoire d''avoir un contraste avec la douceur et la finesse du saumon...', '2009-02-15T01:51:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34208, cae6bdc1-6c45-4d74-9414-9f405d704373, 'Très bon !', '2024-04-23T21:23:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34208, c4898a4a-3667-49c7-b2c7-442ffa214c48, 'Eh oui, excellent !! Simple et efficace !', '2011-10-09T21:59:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34208, 10e66ecd-5001-4759-aa46-bf5bc21e578f, 'Un voyage culinaire dans les îles!! C''est remarquable. Même mes enfants qui ne sont fanas ni des légumes ni du poisson en ont repris!', '2006-12-17T15:59:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34208, 274f1aac-f7f5-46c2-8629-90b9bf14c080, 'Recette originale et facile à réaliser... succès garanti! Absolument délicieux !! ', '2006-09-26T13:43:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34208, 128044cf-fb8f-454a-bdea-55f5aa4392b3, 'J''ai fait la même recette en remplaçant l''ananas par la mangue, et c''était très bon aussi!', '2006-07-28T15:00:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34208, ab957921-86d6-48fa-9864-0e06c62fd83b, 'Hummmmmm.... Original et très simple à faire. Le plus long est de découper l''ananas. A faire absolument!', '2006-07-09T14:57:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22752, cdae270a-1672-43de-a133-1be6d0758c23, 'Excellent, simple on en redemande !! A la place de la crème j’ai mis du fromage blanc vanille 0%. ', '2019-09-17T09:44:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22752, 85fcb0ff-509c-40ad-84b5-65c778bd114a, 'Un mélange fondant/craquant délicieux. Un bon moyen de manger des fruits frais. Le sirop d''érable sucre sans tuer le goût des fruits et va super bien avec le muesli.', '2010-06-15T19:24:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22752, 0f9a858c-a739-401a-b3e6-f699dccd9897, 'Très frais! délicieux et original.', '2009-03-09T12:15:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22752, 9484e19d-c9fb-4175-a775-fd1e3fbbb74c, 'Simple à faire et très bon après un repas copieux!! Merci !!', '2008-09-29T17:42:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22752, 39501a9a-0f4e-44b3-8487-16e16648940c, 'Dessert vite fait et facile à adapter! J''ai mis du fromage blanc à la place de la crème et des copeaux de chocolat blanc (fait avec l''économe) sur le dessus. Le tout dans de jolis verres et servi bien frais.', '2007-03-07T10:16:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22752, 17956c30-6721-478d-95f4-15264e6df9b3, 'C''est très simple à faire. Pour le petit déjeuner aussi, ça permet de manger des fruits et des céréales.', '2005-04-09T15:55:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15331, 56b67c45-8336-4afd-880d-7a4b4df92137, 'Désolé, mais personne n''a aimé le mélange boudin blanc, banane et 4 épices. C''est spécial, mais chacun ses goûts!', '2001-11-25T16:54:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66863, 80a39662-f5ab-45ff-b2ae-42377a2b563c, 'J''ai réduit la dose de sucre et de banane, et j''ai fait les copeaux de chocolat moi-même pour qu''ils soient plus fin. Une gourmandise à partager dans la bonne humeur, un succès auprès des copines !', '2012-02-16T00:39:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66863, 92b5286f-4a73-44e9-bf44-e3f689fef2b4, 'J''ai réalisé cette recette en divisant toutes les proportions par deux. Le crumble avait une très belle consistance et n''était pas trop sucré. On s''est régalé en le mangeant tiède! En revanche, la banane a tendance à masquer le goût des poires et des pommes. La prochaine fois, je réduirai donc la quantité de banane et augmenterai celle des pommes et poires.', '2009-04-05T13:23:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66863, c4a7c700-e271-4d38-86a7-297ba8cd2372, 'Un crumble avec beaucoup de saveurs et de plaisir! Mon fiancé et moi avons adoré ! A refaire sans modération!', '2009-02-27T16:48:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66863, 3f429041-95f8-4dad-a71a-945284467965, 'Tout simplement excellent ! Mes amis  ont dévoré ce crumble ! Il n''en restait pas une miette. La prochaine fois, j''en ferai plus pour qu''il m''en reste un peu... A faire et a refaire !', '2008-02-19T18:31:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347873, 6959f3f7-5c1e-4460-9387-9fb4bd9085a0, 'Pour des wraps parfaits bien les aplatir car pendant la cuisson le wrap s’épaissit.', '2019-07-02T10:29:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347873, f2d8ee48-3370-4bf6-a798-de2140235082, 'Bon mais sans plus.', '2017-11-28T00:01:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347873, b6b606ab-c3c8-4d6b-821b-b6982a38afd9, 'Mes tortillas n''ont pas le même aspect que celles de la photo. Celles de la photo ressemblent à celles achetées dans le commerce. J''ai ajouté une boule de glace vanille dans la tortilla mais je ne l''ai pas passée au four.', '2017-07-17T22:53:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347873, f19e3ea5-5347-4112-872b-c7985b3f8d42, 'Ca va', '2017-06-01T19:08:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172555, e1d82cd8-25a7-411d-afe8-9e7684f5a24d, 'Très facile à réaliser. Attention car les œufs sont à mélanger dans la préparation.  C''est excellent avec un cœur à la banane.', '2013-02-17T13:31:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172555, 42e6964d-1df3-498b-8b78-9a8ce0ef987d, 'Succès à la maison !!!', '2012-07-12T17:33:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172555, 3c9ee995-4a10-4f21-91c0-dd4a9a742ab6, 'J''ai dû ajouter du beurre car la pâte ressemblait plutôt à un crumble !', '2011-06-23T17:32:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347619, 2c7ba3d0-1473-44f1-9810-9906a362cc55, 'Super recette très originale ! Très bon aussi sans banane et avec un peu de confiture.', '2018-06-20T18:28:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347619, 4cd9c7e5-36ac-4e0e-bf43-be62d1f2045a, 'Très bon  !', '2018-06-30T08:24:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29907, 150479bb-90d5-43da-aca4-ca1e0cccc0ad, 'Super bon, très facile à faire et c''est très léger !', '2022-10-26T18:32:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29907, ab7e1035-0659-49ed-9550-e8da69e06969, 'Facile à faire, je n''ai pas chauffé le rhum, je les ai flambées dans la poêle. Tout le monde a aimé avec une boule vanille ! À refaire.', '2016-01-31T14:22:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29907, d02f0414-3ef7-45fd-95ce-1db0ad12c54e, 'Bonne recette mais trop sucrée à notre goût.', '2015-12-29T22:32:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29907, c9e49eea-e85c-4b70-bb0a-820fc984c42a, 'La recette n''est pas très claire en ce qui concerne les sucres : faut-il les ajouter aux jus d''orange et raisins ou en saupoudrer les bananes ? Quoi qu''il en soit, le résultat est délicieux ! ', '2014-01-29T23:54:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29907, 24fc56e5-f94c-407a-b188-50b00f841807, 'Superbement délicieuses. J''ai ajouté dans le jus des morceaux de biscuits secs et  j''ai servi avec un sorbet aux pommes. Que de compliments... Recette très facile à confectionner et en plus peu onéreuse. À faire et refaire sans hésitation. Merci et bien à vous. ', '2014-01-20T17:34:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29907, d6374fe5-dfee-47c4-a013-84f6ff553336, 'C''est trop bon !', '2013-01-20T15:16:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29907, f6977506-525a-4654-9c1f-230a77daff09, 'Absolument délicieux et à refaire sans hésitation ! Les raisins trempés dans le jus d''orange apportent une note encore plus gourmande au plat. Ne pas hésiter à servir avec une boule de glace à la vanille ... Merci pour la recette :-))', '2010-09-19T13:07:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29907, 9ddf1309-eea0-4a86-97a5-6276d76ce3b9, 'Excellente recette, super simple à faire et le mélange orange-raisins-banane est exquis... Demandez à Juju et Eugénie...  Mon rhum chaud ajouté au plat n''a pas trop flambé, par contre (il faut peut-être le faire flamber dans la casserole avant de le verser sur les bananes ??). Mais c''était très bon quand même ; je le referai sans hésiter !', '2008-11-16T19:59:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29907, 6b6c6b31-3e29-4188-8154-2e6e6afd8aa2, 'Facile et rapide à faire. L''ajout de jus d''orange donne une impression de légèreté à ce dessert : c''est succulent.', '2008-05-28T22:58:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33715, 2898fb23-9ee1-45d0-866a-b47cec0d9388, 'Il faut essayer.. c''est pas mal.. mais rien d''extraordinaire non plus.. ', '2015-10-06T18:36:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15020, afa89d97-04af-4350-b50f-d2c767ad0577, 'La banane donne une texture un peu bizarre, un peu caoutchouteux. La saveur est agréable, mélange d''épices (cannelle et j''ai rajouté du gingembre) et de banane. A part la couleur donné au cake, le goût de la carotte est inexistant. A savourer au petit déjeuner ou à l''heure du thé!', '2003-08-12T13:45:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15020, 20e8a49d-b21a-4a5c-8ae6-96808dd2cd5a, 'Le temps de cuisson m''a paru trop juste, j''ai laissé 20 minutes de plus. Après refroidissement, il était pâteux au milieu, est-ce mormal? Mais c''était délicieux.', '2003-05-10T18:36:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, d042c197-9eeb-476a-bb73-66b9f06faa22, 'Recette originale, il faut aimer ce qui est exotique. J’ai mis 4 bananes, si c’était à refaire je diminuerai la quantité je trouve ça trop fort. Idem pour le curry ne pas hésiter à diminuer la dose au départ. ', '2018-05-01T13:23:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 6fa408e9-de81-442d-a0b8-97ba08f628d5, 'J''ADORE
Je fais et refais dès que mes bananes sont trop mûres. Je ne m''en lasse pas', '2023-07-08T17:13:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 02f575ea-9c00-42fe-abdc-cf016e3931f0, 'j''en ai étonné plus d''un.
', '2023-01-20T12:29:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, f6434fb7-4ba7-4646-b213-6215f5403e44, 'Immangeable vraiment déçu', '2021-01-02T11:17:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 6f391225-e700-4cf4-834e-9b6bb2e82a7a, 'J''adore cette recette, c''est devenu un classique à la maison. La coriandre fait presque tout le travail. Attention à ne pas mettre trop de tomates. ', '2020-11-23T17:59:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 70b9dc47-8bc6-4beb-a6dd-32cb28b1edfe, 'J''ai fait cette recette avec 3 bananes ? et je n''ai pas trop ressenti leur goût mais me femme a adoré et les ressentait très bien. Donc jenpense que c''est une histoire de goût. J''ai remplacé la crème par de la crème de coco et j''ai mis la moitié de farine de banane plantain. C''était très bon. Merci beaucoup pour cette recette. Je referai...', '2020-04-30T22:15:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 4fc3f62e-267e-457f-90b6-da5e6db6f8a3, 'Très bonne recette, trois bananes c''est assez pour moi et j''ai mis de la purée de tomates.
Mon ami a apprécié.', '2020-01-16T07:19:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 710d45c7-355c-455e-be66-b6148477d4a9, 'Juste Extra !', '2018-03-26T12:03:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 5b5469f5-e810-4b8f-9fd6-dd050494cbfe, 'Recette très originale , j''ai remplacé le curry (je n''aime pas ça) par du cumin et 4 bananes je n''avais que ça, c''est tout simplement sublime.', '2017-10-03T18:43:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, e20bc2eb-ea68-405b-973b-491c1d4fe1b7, 'Moi qui adore la banane et les tomates, c''est vraiment trop bon. On a mis seulement 4 bananes, et on a utilisé du bouillon de légumes.', '2017-02-26T16:15:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, a44d0f0b-1643-424f-a18d-4e1de0711d79, 'Recette qui sort de l''ordinaire, utile pour utiliser des bananes trop mûres. Le curry ajoute une note très parfumée à l''ensemble. Recette adoptée. Merci. ', '2015-12-27T17:54:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 77aac747-6774-4efc-9ba1-e4470ca664e8, 'Très bon, facile à préparer et mis que 2 bananes : j''hésitais mais vraiment on ne sent pas le goût de la banane et la soupe est onctueuse. A refaire sans hésitation. M. ', '2014-04-12T23:09:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, cd61bb5f-4627-4689-b36c-974d09ee51ad, 'J''ai pris en compte les commentaires et j''ai mis seulement mis 2 bananes. C''est largement suffisant. Un régal ! Facile à faire et étonnant. A recommencer. Une bonne façon de manger des bananes trop mûres. ', '2013-12-18T20:54:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, a9442e2d-6f53-46e3-b5bb-c04a71083b77, 'Très bon et très exotique, rempli la panse, mais 1,5L c''est un peu trop ...', '2013-12-13T13:21:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, c9a22f6d-6480-4092-bdfe-44dd9457ef1e, 'Recette originale... Surtout ne pas oublier la coriandre en feuille par dessus, je trouve que c''est ce qui lie le tout... ', '2013-12-06T12:24:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, b37b80e1-00e7-4956-a5b3-c716fab6fcc4, '1,5 l de bouillon de cube, c''est trop, ma soupe était trop liquide. Au goût c''est original. ', '2013-12-02T13:19:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, da243beb-2091-4201-a3f6-b087426c5e7e, 'Super bon ! Je l''ai préparée pour un concours de soupe, eh bien je l''ai gagné grâce à cette recette !', '2013-12-01T21:35:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 98cbeaa6-d760-45f8-b5ec-8079da59469c, 'Recette juste "exceptionnelle". Même avec d''énormes a priori, les bananes en soupe vont à merveille !', '2013-09-26T20:04:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, d5c538f8-ac00-459e-8903-6dfe2c973120, 'Super bon ! Sur vos avis j''ai diminué le nombre de bananes. Même pas besoin de crème fraîche. ', '2013-09-23T23:42:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 614e85d7-b06e-4ad1-abd3-adb1375eb68e, 'Soupe originale que mes enfants apprécient beaucoup. Comme mis dans les commentaires précédents, je ne mets que trois bananes.', '2013-02-28T19:56:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 23a9f3cc-00e5-462d-b24a-41a4f08d14f7, 'J''ai rajouté un oignon émincé et un bouquet de coriandre fraîche pour le côté exotique et avant de servir, j''ai ajouté de grosses crevettes cuites et décortiquées, nous nous sommes régalés avec un plat complet. Parfait !', '2013-02-09T08:34:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 9e87100f-a455-4f76-b6a9-5a6ec176b5fc, 'J''ai mis du curry beaucoup trop fort ! Trop relevée, ma soupe était écœurante !', '2012-12-11T15:08:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, e039ab07-9973-48a3-aa66-87c9dc81e82d, 'Excellent ! Les convives sont méfiants au début mais enchantés dès la première cuillerée. Par contre, les proportions sont trop importantes et c''est parfait pour 4 avec la moitié. ', '2012-11-24T19:25:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 80e823a1-a6ea-4bba-bc86-1dcd19f8f74a, 'Un vrai délice !!! Rien à modifier à la recette ! Merci Marmiton ', '2012-10-19T21:54:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 2efe35c4-2d44-4474-88b7-093da10bcd64, 'Si je pouvais mettre plus que 5 je l''aurais fait ! Cette soupe est excellente, même si j''ai eu une petite appréhension au début, n''ayant jamais cuisiné de plats salés avec des bananes... Bravissimo ! ', '2012-04-17T00:33:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 8b3c30e3-44e3-4b46-a010-6d8a6487cdae, 'Toute la famille a littéralement adoré ! Avec une boîte de 850 ml de tomates pelées et seulement 2 bananes, la soupe était très savoureuse. A refaire !!', '2012-03-03T17:53:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, ce0be70e-cedf-4062-ab05-5e18991979de, 'Bonne recette juste 3 bananes et ai ajouté une cuillère à café de concentré de tomate, avis partagés, mais moi j''adore', '2012-01-06T14:28:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, a9532ae0-d073-4f40-bf08-a0d80a646567, 'Super bon... j''aurai jamais cru. Mais par contre je n''ai mis que 2 bananes aussi, et on sent assez le goût, juste ce qu''il faut ! Le reste rien à changer.', '2011-12-20T09:56:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 29532231-4dfd-498f-aba8-84c843b52420, 'C''est franchement super bon ! Voir délicieux ! A chaque fois que je la fais tout le monde se régale, les grands comme les petits... et en plus vous ne pouvez pas la rater !!!', '2011-12-02T14:04:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 17c0552f-abcf-4ea4-ab61-404a58fda2e1, 'Super bon, je n''ai mis que 4 bananes et plein de curry un délice. En revanche, la prochaine fois je diviserai les doses par deux. Car on en a mangé pendant des jours !', '2011-10-27T22:08:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 0c27d512-ffe0-4515-98aa-d568e1349f0c, 'Je n''ai vraiment pas aimé. Le goût de la banane est beaucoup trop présent malgré que je n''en ai mis que 3 au lieu de 5. Et pourtant j''aime bien tout ce qui sort de l''ordinaire en cuisine.', '2011-10-18T22:57:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, fea3546e-f5a3-4de1-98a9-872175f360c8, 'J''adore ! On ne sent pas le goût de la banane mais elle donne un incroyable velouté ! C''est une soupe très nourrissante qui a toujours rencontré du succès auprès de mes invités !', '2011-08-15T17:33:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, b6831583-0d38-4941-a513-7838f2549aca, 'Très très bon. J''ai mis 2 bananes pas trop mûres et une seule cuillère de curry pour un litre d''eau. Un délice.', '2011-08-13T23:04:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 2410ea6b-11d4-4384-8ee7-221847d7d232, 'Avis partagé ou on aime ou alors pas du tout. Par contre les quantités indiquées sont prévues pour une équipe de rugby de retour d''un match. Beaucoup trop pour 4.', '2010-03-11T15:52:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, cc60f49d-ec93-4697-9701-5f6608d09f4a, 'Très agréable avec un léger goût de banane "en fond" mais la tomate est trop prononcée ; j''en mettrai un peu moins la prochaine fois (3/4 boîte tomates pelées) ; rien à redire pour mon époux qui s''est régalé .', '2010-02-12T17:39:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 4ea62c05-5443-4e97-bcc4-4cfccb97a8c0, 'J''ai trouvé ça très bon et assez parfumé.. par contre je n''ai mis qu''1 cuillère de curry...', '2010-02-09T17:14:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, e8c01282-83e8-4b02-a860-0bec11bc1328, 'Très parfume et délicieuse. Personnellement, il y a un peu trop de curry ce qui rend la soupe trop épicé. A refaire.', '2009-11-02T20:33:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, eae1711a-031b-4422-ac3e-106f510bf591, 'Pas exceptionnelle mais très bonne. Je n''ai mis que 3 bananes et pas de crème. La prochaine fois je vais tester avec 4 bananes pour voir si le goût est plus prononcé (je pense que le goût n''en sera que meilleur). Si vous utilisez de la pâte de curry, n''en mettez surtout pas trois cuillères, le goût de la pâte est beaucoup plus prononcé que la poudre, à mon avis une cuillère suffira amplement.  ', '2008-08-18T14:20:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 7d721a49-7583-4540-a180-5c16714781be, 'A tester avant de servir aux invités car à la maison les avis sont partagés (mon mari ne l''a pas fini). Je n''ai mis pourtant que 3 bananes. Je ne la referai pas.', '2008-07-08T15:25:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 97d499c2-7251-41af-b163-0787dcc6ec0e, 'Un succès assuré pour les grands et les petits!!!', '2008-06-15T18:51:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 790d4104-ef12-480e-90e0-5dc38fec2850, 'J''ai mis 3 bananes et pourtant je trouvais cela écoeurant. Par contre, mes invités ont beaucoup aimé.', '2008-06-05T14:44:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, c731e96d-cbe4-4aee-b208-ff1669ce723c, 'Cette soupe est très dépaysante et surprend même les amateurs avertis! Très difficile pour eux de déterminer les ingrédients utilisés. Cette soupe est meileure si elle est réchauffée et servie le lendemain car les épices renvoient alors toutes leurs saveurs ! Enfants et adultes en raffolent !', '2008-05-11T16:13:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 0c6f0c0e-6dbe-4514-b149-b8e2f91f246b, 'Même avec seulement 3 bananes et sans la crème, le résultat était très écoeurant. Apprécié toutefois des invités en mini quantité (amuse-gueule)', '2008-02-16T00:36:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 81d960ac-7e80-4cde-be35-251538da445c, 'J''adore cette recette! Comme c''est un peu "lourd", je la sers en portions individuelles, dans une petite coupe! Et je remplace le curry par du cumin : excellent!', '2008-01-19T17:43:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, f19a1e67-46f6-449a-b954-6d2b317e7bfa, 'Si vous voulez être original, c''est la recette qu''il vous faut. ELle a été appréciée je recommencerai. J''ai suivi les commentaires précédents, soit seulement 3 bananes et attention au curry, car c''est vite épicé. Soyez original! Essayez !', '2008-01-17T11:01:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 32dea0f5-4995-4b37-99af-d0184c461f10, 'Au vu des commentaires élogieux, j''ai essayé cette soupe. Malheureusement, tout le monde l''a trouvée écoeurante. Mais c''est une question de goût.', '2008-01-14T10:10:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, ffe2d0e0-1a16-4ad9-aab8-afe7a8a9c5dc, 'Bravo j''en fais à tous mes visiteurs! Quatre bananes suffisent, je ne mets pas de crème fraîche, et je mélange colombo et curry pour éviter que ça ne pique trop, cela plait à tout le monde.', '2008-01-02T12:40:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 4a188e9b-70ce-43b8-b203-3f8f320039cf, 'Merci pour cette recette! Je la fait régulierement et la conseille souvent. Suite aux avis des internautes je ne mets que 3 bananes et 1 cuillère à café de curry après tout est une question de goût. On peut toujours en rajouter.', '2007-11-24T09:46:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, b84cbc74-9e4f-4a06-af78-5cd895c6bbde, 'Faite avec 7 petites bananes plantain et sans crème. Excellent, le mélange tomate-banane donnant un goût sucré et acidulé. A refaire !', '2007-10-08T13:31:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, b265a30b-36ac-4a48-a8e5-6ceb5f8ffe10, 'Recette très simple à faire. La première fois j''ai trouvé qu''il y avait un peu trop de curry. Cela été rectifié la seconde fois. Les invités devinent de suite qu''il y a des tomates mais impossible de deviner les bananes, l''étonnement est garanti. ', '2007-01-02T00:00:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 0af73c80-bfb0-48c1-a91a-fd627d1d1959, 'Très bonne soupe, surprenante. Le mariage de la tomate et de la banane est parfait. Une soupe à faire et à refaire.', '2006-12-27T19:48:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, b61f1a5c-cac1-4b55-9075-d85e39aab2eb, 'Très bon mais sur la base de cette recette mon mari a ajouté du curry et du piment dans son assiette tandis qu''en ce qui me concerne avec un peu moins de curry cela aurait été mieux : question de sensibilité!', '2006-12-13T17:00:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 0eeb76ef-f96e-4eb7-97bd-49f379b8bf96, 'Très velouté et parfumé. Il est amusant de faire deviner les ingrédients, vous verrez, les avis pour la composition sont très variés. ', '2006-12-02T17:38:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 56210683-c081-4ab0-96c2-98b1edae7fa5, 'Déroutante et délicieuse, nous la servons dans notre snack; et rare sont ceux qui devine la composition!', '2006-10-02T19:08:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, aa085516-bf3e-4843-bc98-780dcb9e4ca7, 'C''est très bon, mais attention! Faites bien cuire votre roux (15 min environ pour le mélange beurre/farine en remuant sans arret, jusqu''à ce qu''il prenne une belle couleur brune), sans le brûler. C''est lui qui va donner de la force à votre soupe!', '2006-09-16T18:25:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 32b520ad-ba9a-45cd-a3ea-2eee599cf30e, 'C''est très bon, facile et rapide. Les enfants ont adoré.', '2006-05-09T17:09:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 07f08da3-2730-4e18-b293-dc7a755f975b, 'Les petits ont adorés... Pour ma part, j''ai trouvé ça bon, mais sans plus.', '2006-01-18T11:31:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 454a90f7-4ed6-42ea-ba62-f3156a6a9d5e, 'Je n''ai mis que 3 bananes et pas de crème et c''est quand même très très bon et surtout plus léger! J''ai mixé une première fois au début pour accélerer la cuisson.', '2005-11-03T17:02:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, 99fdd40b-e584-422c-ab82-9df5b565d28f, 'Très très bon...la casserole n''a pas duré longtemps...miam-miam.', '2005-10-09T23:21:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15158, a80bdf34-f64d-4383-91e8-3cccbc2fc5a2, 'Que dire de plus que tout ce qui a été dit ? J''ai testé avec 3 bananes, j''essaierai avec 4 la prochaine fois. C''est divinement bon et surprenant. J''ai réussi à convaincre mes parents. Mille fois bravos!', '2005-03-15T17:22:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19483, f8623082-4c7c-46c9-b063-0d8e477f5e8a, 'Délicieux original et très rapide. Personnellement, je rajouterais un peu de chocolat en poudre ou du sucre en poudre.', '2003-03-04T12:02:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21635, 878db0dc-3cf2-4123-88d9-5ce6696d7ec5, 'Sans Bourbon (je n''aime pas l''alcool), c''était délicieux. Seul petit probleme qui justifie que je n''ai pas mis 5 comme note, le gâteau s''effrite un peu et il n''est pas très pratique de couper de jolies tranches. Mais bon, ça ne gache rien au goût.', '2006-09-19T23:54:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30671, e02c400a-3f96-4caa-84f8-85b0dc55f6a3, 'J''ai fait cette recette avec des fruits d''hiver (pommes-prunes-bananes) Nous avons beaucoup aimé et surtout quelle facilité. Je craignais le fromage blanc au four mais pas de souci.', '2013-10-16T21:12:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30671, 0a5763bc-b959-4a74-9244-8a2d1061742a, 'Fait avec des fruits de saison (pommes/poires/figues/orange/bananes), un fond de lait de Coco et un yaourt grec, sucre vanillé ; 10 min à 200• : très bien', '2015-10-04T16:28:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23895, f55b6372-72d0-45ee-841f-84a874ca0c8d, 'Excellent j’ai utilisé du baobab en poudre', '2019-05-06T12:40:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23895, dd1543a7-7337-45d9-a9e1-79ee2d2db54e, 'Superbe recette, très fraiche. A essayer !!!', '2013-02-11T00:33:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23895, aac92fef-c9d0-48de-b3ae-1dc542eb3b11, 'Excellent mais au lieu de rincer très vite le pin de singe, il faut le laisser dans de l''eau pendant 20 minutes environ et le filtrer. Sinon c''est impeccable.', '2008-12-07T19:15:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23895, 1d9d3e66-7f5e-465e-a1ba-88dcf519373e, 'Délicieux, il existe plusieurs façons de préparer le bouye.', '2004-01-13T12:35:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38703, 549b2b44-2a28-4df8-a914-7d023199de0a, 'C''est très bon effectivement, mais j''ai eu un petit problème au moment de retourner la tarte, le chocolat est resté collé à la tourtière... Je n''avais peut-être pas mis assez d''huile ! C''est pour ça que je n''ai pas pu ajouter de photo !', '2011-04-29T17:55:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38703, 52dfba25-0f9d-45e0-8ca7-256b0c67474d, 'Très bonne! Rapide et facile à réaliser! Toute ma petite famille a adoré!!! Pour la rendre plus jolie en présentation je l''ai saupoudrée de noix de coco râpée! Un délice!', '2010-02-18T16:48:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38703, ab2c1dd9-7332-4cfd-b787-7af431dafa38, 'Bonjour, cette recette était excellente j''avais tout ce qui fallait et je n''avais plus de crème car en général cette recette et fait avec de la crème. J''ai vraiment bien fait de chercher mes invités ont aimé. Merci!!!', '2009-01-17T17:51:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38703, 9c52a08e-8b65-401d-a924-fdf1995db69d, 'Très bon, effectivement imprésentable, mais pour qui aime la banane, c''est une excellente recette.', '2008-02-24T20:02:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38703, 2e2dd733-3ad7-4dab-9549-705793fddbe2, 'J''ai fait l''impasse sur le citron, la tarte est excellente, rapide à faire, merci de l''avoir rentrée!', '2007-02-25T23:11:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38703, 8cdba1a7-24e8-4ea3-bd8a-e4c02ec84582, 'Bof! Au déla du fait que la tarte soit imprésentable, elle est écoeurante, cela forme une pâte banane chocolat pas mauvaise mais pas très compatible avec une tarte.  ', '2006-11-13T16:48:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38703, fb459470-05cd-48f9-bb42-dc0cceedc464, 'Bon, mais il a fallu que je rajoute 3 bananes et j''ai fait fondre 200 g de chocolat dessert au bain-marie, auquel j''ai rajouté de la crème liquide. Le résultat ne m''a pas convaincue.', '2006-04-29T07:44:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38703, 3e622f25-f4f0-48cd-8fd2-84780b1a605b, 'Les fans de banane et chocolat apprécieront! Par contre, j''ai mis 8 bananes en tout car sinon ça faisait ridicule dans le plat! Et j''ai pris une pâte sablée, c''était très réussi, et parfaitement démoulable car j''avais beurré le moule.', '2006-03-28T23:38:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38703, 91791638-7d97-4c9e-a536-c6735012a9ca, 'Bon au goût mais sans plus, et surtout imprésentable: impossible à retourner, on a galéré ferme pour servir les parts...', '2006-03-13T22:25:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38703, 004c2f4c-e9e4-4f37-bc3f-ee5fec62e59c, 'Elle n''as pas un bel aspect mais c''est très bon!', '2006-03-12T19:06:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38703, 05319b13-cbe9-4b28-848f-5083a3a36e3d, 'Rien de transcendant, le chocolat a brûlé. Bof!', '2006-02-26T21:58:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38703, 24c49cd0-6968-4834-862a-e8858d461904, 'Hyper rapide, et super bon, pour les amateurs choco/bananes... Je l''ai faite avec des copeaux de chocolat, taillés dans la tablette... Et une vraie pâte brisée... C''est quand même bien meilleur, et facile à faire. Merci.', '2005-11-28T12:22:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38703, 8f11be4e-1c62-49be-9510-55c59704810e, 'Super facile à faire et vraiement très bon. En 5 min il n''y en a plus.', '2005-11-06T10:05:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (214843, bc89bd72-3599-4d1c-b40b-24688df8db52, 'Excellente recette et encore meilleure froide !  ', '2012-07-19T15:29:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (214843, fdaaf7ac-54c5-4630-82ae-e68ebf1e4728, 'Exquis ! Mes invités ont adoré ce mélange bananes-framboises et amandes ! Pour la déco, à la fin, j''ai ajouté une framboise sur les amandes ! Magnifiques couleurs en verrine.', '2011-10-20T10:18:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50604, 66809e8c-c311-45f1-8330-be863188007a, 'Très simple à réaliser, bon et plein de vitamines. Bonne recette.  ', '2012-02-12T19:12:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 471afa70-b00d-4293-9beb-6e1c749da9b5, 'Ya de lidee. Jai mis moins de sucre, moins de beurre et plus de farine pour une pâte de crumble "qui semiette". 
Jai mis le double de fruit et ai rajouté en lisière entre les fruits et le crumble de la poudre de chocolat.
Poir la cuisson, à 200° 15min.
', '2021-03-07T21:27:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, b2b3889b-aec6-4b71-94cc-9884b95bbb96, 'Le kiwi cuit n''a pas un très bon goût et les proportions de la pâte à crumble ne donnent pas une pâte qui s''effrite. J''ai dû ajouter de la farine.', '2014-01-12T22:05:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, fb6eecb2-f875-4326-9527-6bf616e87db7, 'Très très bon ! Petits et grands ont adoré !', '2013-12-01T23:07:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 364c035e-d079-4ecc-a3b2-f11a37e26323, 'C''est très bon ! La banane adoucit agréablement l''acidité du kiwi.  Habitant un petit studio d''étudiante sans four, je fais cuire les fruits à la casserole d''un côté et dorer la pâte à la poêle de l''autre. Je rassemble ensuite le tout dans un ramequin, et le tour est joué ! ', '2012-05-13T21:35:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, fcd78fec-514e-4e59-93fe-6e8c7ef2323e, 'Bon dessert. Cependant ai mis moins de sucre et moins de beurre : 125g de farine, 50g de beurre, 50g de sucre roux , 50g de flocons d’avoine et un peu de cannelle. A été apprécié ', '2021-10-24T12:24:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 645071aa-92c6-4d0d-a87a-1e5d3a80b691, 'Très bonne alliance de fruits !', '2021-05-09T07:48:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 23760d0f-682e-4c37-9d0c-a36b7d29fd84, 'Rapide et très bon', '2021-02-28T17:04:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 81203295-12c7-48b1-a4a6-f1d321164b62, 'Un très bon crumble. Je mettrai pour ma part un petit peu moins de sucre la prochaine fois.', '2020-02-25T03:18:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, d568ce42-0837-42e4-94f7-5cd82f850312, 'Excellent crumble pour garnir une tarte aux pommes !', '2019-02-02T08:19:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 33bd4356-5ce1-4905-a046-5bd2e2c70d9e, 'Mon 1er crumble...  une réussite merci grâce à cette recette tout le monde a adoré...  Je vais pas être original mais l''association des deux fruits super bien ', '2015-09-06T21:27:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, aa175a71-8a1e-40b9-a72c-0329f5669409, 'Excellent ', '2015-07-08T19:27:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 2ea97820-d512-4673-818a-6d694733689e, 'Vraiment très bon ! Ça change du traditionnel crumble aux pommes...', '2015-02-26T11:52:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 18877ff4-2d86-493f-9972-5ba1bfac2591, 'C''est délicieux ! A refaire sans hésiter !', '2015-01-22T23:08:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 9e13069f-c06e-4bbb-b0a0-d21882952f0e, 'Parfait ! Les fruits se marient très bien, une vraie réussite.', '2014-07-21T07:51:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, b1ae51ac-9d20-4081-a28b-9f9b45df85ff, 'Je l''ai faite a moitié aussi. Très très bon ! Moi qui ne suis pas fan de kiwis, ils apportent une petite touche d''acidité très agréable ! Variante pomme-kiwi pas mal non plus !', '2014-06-01T21:02:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 34d19c7a-d547-49c3-a938-1e8d064d3462, 'Je l''avais pour deux en divisant les portions. Parfait en partant sur une banane et deux kiwi et le reste dans les mêmes proportions. Un délice qui se mange tout seul.', '2014-05-03T03:32:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, d0294916-f122-4a75-9f71-ed137dae065a, 'Mon premier crumble ! Très bon si ce n''est que la pâte était bien trop sucrée à mon goût alors que j''avais déjà réduit la dose. J''ai rajouté aux fruits du sucre vanillé (à la place du sucre roux) et de la cannelle. Bonne recette sinon car très facile à réaliser et rapide.', '2014-03-03T17:24:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 97b33d06-ac0e-4cae-ac71-988bcbfc8fb4, 'Très bon et encore meilleur un peu chaud !!', '2014-02-11T22:19:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 5f16642c-2f9a-414d-986b-2bc6a2a8ce64, 'Excellent j''ajoute de la pomme !', '2013-12-09T13:50:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 19de33ed-3b11-43a2-81e2-9e23aa8f9d24, 'Excellent ! Mais avec un peu trop de beurre à notre goût.', '2013-12-09T04:08:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, bfabda22-cb40-479b-a49d-5694135ce220, 'Excellent ! Tout le monde a aimé et j''ai rajouté comme fruit du kaki le tout dans des ramequins individuels ! Ceci dit un peu bourratif ! Mais je le referai au moins mes enfants mangent des fruits !  ', '2013-12-01T20:22:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, d9fdbbbf-3d70-44cf-b3c8-91dec2b0c32b, 'C''était vraiment très bon mais j''ai eu un petit souci de cuisson parce que les fruits ont rendu trop de jus !', '2013-09-12T19:15:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 0a008b2e-4384-4576-9671-24552c954a53, 'Fait dans 4 petits ramequins individuels. J''ai divisé les portions par deux. Excellent!!! La pâte a crumble est un vrai délice !', '2013-04-04T13:35:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 0895d430-dcd3-4f9d-825c-fd544bcaed64, 'J''avais un peu peur de mettre des kiwis dans un crumble mais finalement le sucré de la banane masque l''acidité du kiwi et l''équilibre est parfait !', '2013-03-08T18:13:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 2dbae1bb-9ac7-4dce-8be5-aa49b0ba1e8d, 'Je viens de la réaliser et cela est excellent, ça a eu un franc succès !!! J''ai simplement ajouté 2 cuillères de nutella à ma pate pour un petit gout de chocolat en plus !!! Merci.', '2013-03-07T18:36:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 48da0070-e547-469e-9c7a-6cab1c0009a0, 'Très bon, la pâte à crumble est vraiment bien même si j''ai réduit un peu le sucre. J''ai fait des parts individuelles qui ont eu beaucoup de succès. Le mariage banane/kiwi est excellent, merci pour la recette que je referai', '2012-09-07T16:22:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, ba2b8ba8-a1ec-44ad-849f-66580a26a8af, 'Bon petit dessert ou pour le "4 heures". J''ai, cependant, mis moins de beurre (environ 100 g) et utilisé du 1/2 sel. Comme je n''ai pas d''enfant, j''ai ajouté une goutte de rhum sur les fruits avant cuisson et mis une cuillère à café d''arôme vanille dans la pâte. Bonne dégustation !!', '2012-07-24T20:22:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, a73b455d-79c4-44fd-a336-c42bc09658db, 'Excellent, fait avec des kiwis/mangues, fait avec des pommes avec des fruits rouges mais toujours aussi bon agrémenté d''une petite boule de glace vanille, un délice mes convives sont ravis à chaque fois et surtout tellement facile à faire ! ', '2012-02-18T20:45:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 47fc094f-675c-404c-b5bb-13d74d04a2ae, 'Très bon', '2011-12-06T01:29:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, d475004c-4a3e-4a15-ae93-e229708ee51e, 'Très bon crumble, bien sucré de sorte à ce qu''il ne soit pas trop amer avec le goût des kiwis le dessus du crumble est très croustillant et ne le perd pas même au bout de quelque jours.', '2011-08-04T19:04:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, aa50b5ff-3d82-4c75-a615-09570b21c763, 'Super bon ! Tout le monde a adoré !', '2011-07-01T14:40:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 6cea54c7-0abb-4b17-8c35-4ea86f2b602c, 'Premier crumble que je fais. C''était très bon ! Faut prendre le kiwi dans la cuillère en même temps que la banane, sinon on sent l''acidité. Mon mari qui n''aime pas le Kiwi a beaucoup aimé. Seul problème, c''est que le temps de cuisson ainsi que la température n''est pas indiqué. Premier crumble que je fais, j''ai eu du mal à bien le cuire. J''ai cuit environ 25 min a 210°C', '2011-01-21T10:41:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 88464d7e-6848-4ae1-8388-9e297a9379bc, 'J''ai  mis 125 g de beurre et autant de sucre, 2 sachets de sucre vanillé entre les fruits et le crumble. Extra', '2010-08-28T19:05:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 4092cdc7-ae4b-44be-ae9a-814760fb44d9, 'Excellentissime ! J''ai ajouté un peu de noix de coco à la pâte.', '2010-06-19T12:09:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, d293eca3-b728-4645-8bc2-de624dac4326, 'Rapide et très bon ! J''ai ajouté ma touche personnelle en y mettant des pépites de chocolat.', '2010-04-28T12:44:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 51cc9890-3f05-4f6d-b323-319f77238be6, 'Très bon. La prochaine fois, je mettrai juste un kiwi et une banane de plus !', '2010-04-05T12:24:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 3efc94f0-98f4-46f6-bce3-4b98a6c5b565, 'crumble bananes kiwis génial facile et rapide et en plus délicieux...merci toute la famille se régale...', '2010-01-01T13:16:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 90abeaa0-2fa6-4d40-a73a-6693da9cda43, 'Excellent, rapide et facile!! Génial à refaire absolument !!', '2009-03-01T16:41:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 3353c19a-c807-47bf-b250-5bec903752f4, 'Délicieux, je suis en train de le déguster ! Très facile à réaliser et très bon. Le sucre roux y est pour beaucoup. Seul bémol, la quantité de sucre un peu trop importante peut-être. J''essayerai en n''en mettant moins la prochaine fois. Un régal !!! Merci.', '2008-12-04T15:02:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 5ffcbe97-dd37-477e-8f7a-8408c5140508, 'Rapide, délicieux et surprenant. Il est devenu un classique à la maison.', '2008-11-22T14:18:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 159e8921-a279-4d7a-bcc2-09df05ab3451, 'Ca change du traditionnel crumble aux pommes...et c''est vraiment très bon!!! J''ai par contre mis un peu moins de sucre...', '2008-11-15T20:11:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 3caf8b81-c5bf-4a9e-a226-cf97cf9827a8, 'Je l''ai fait faire à mon petit fils qui a eu du mal avec la pâte qui lui collait fortement aux doigts, il n''a pas trop apprécié l''acidité des kiwis. Dans l''ensemble, c''était bon et léger.', '2008-10-25T22:09:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, ba7142f3-84f0-40eb-9858-2602c66b72cd, 'Excellent, un vrai succès! Je n''ai mis que 125 g de sucre et 125 g de beurre, c''était suffisant. Et rajouté deux pêches. Merci pour cette recette.', '2008-07-06T20:30:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, e8e39572-579b-4090-8c62-499f82d33a10, 'Tout simplement délicieux ! Pour ma part j''ai ajouté de la praline dans la pâte à crumble, cela lui donne un petit goût de biscuit en plus. Merci pour la recette.', '2008-04-08T21:58:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, db243421-c07d-4b1b-aee2-efff1f94659f, 'Super recette, quoique les conseils pour agrémenter le goût ne sont pas superflues (top avec des noisettes).  N''ayant pas de sucre roux à disposition, j''ai alterné sucre blanc et sucre vanillé sur les fruits et dans la pâte, ça fonctionne très bien !', '2008-02-25T00:57:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 5a123771-f517-497e-a1ea-b522642c4982, 'Très bon et pas lourd du tout contrairement à ce qu''on pourrait croire au 1er abord. Le kiwi contrebalance bien avec la banane. Moi je rajoute des éclats de noisettes dans la pâte pour donner un peu de croustillant.', '2008-02-09T14:21:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, d4414520-3d05-4c6e-968d-bc98042528ca, 'Délicieux, surtout avec quelques pépites de chocolat dans la pâte!!', '2008-01-27T00:21:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 07a1ff50-9209-4110-ac91-66f5e4be3ffa, 'Je ne sais pas ce qui est le mieux : c''est simple, c''est rapide et c''est délicieux! Merci.', '2008-01-26T23:08:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 6594ebe2-0c03-4b59-af26-7b104c6a041f, 'Délicieux et simple à faire. Belle harmonie de goûts et de texture. Merci.', '2008-01-13T17:12:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 3f3f923f-a4f5-45d0-b1be-a8e9427e1c8b, 'Tout simplement excellent, à refaire.', '2007-11-26T16:27:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 6476edae-4392-40e1-b4d0-9f345fdd83ea, 'Rapide, super bon, j''ai mis un peu de pâte à tartiner choco/noisette avant de mettre ma préparation crumble. C''était vraiment sympa avec le petit goût acide du kiwi.', '2007-10-30T23:00:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 544bfbde-270e-452b-ab93-db495569a7c3, 'Merci pour cette très bonne recette j''ai fait un malheur avec. Seul petit souci c''était la première fois que je faisais un crumble et je ne savais pas à quelle température je devais mettre le four. J''ai mis thermostat 6/7 j''ai surveillé la cuisson et c''était parfait. ', '2007-07-08T12:11:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 348378b0-ab16-4d7d-ac60-ed280291f2b2, 'Tout bonnement délicieux. J''avais un peu peur du mélange mais c''est vraiment bon. Je l''ai servi chaud avec de la crème anglaise.', '2007-06-18T13:51:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 6be2cae5-9f64-4724-82fd-aa1260978fc9, 'Vraiment délicieux, servi chaud comme froid! Dessert rapide et facile à réaliser. On referra... Merci Marmiton.', '2007-02-16T17:09:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 8331bbc6-ec29-4e92-8a3e-ecaa5f1139cd, 'Vraiment délicieux surtout avec une crème anglaise... merci pour cette recette. ', '2007-01-26T15:36:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 30d84236-c41b-4ba6-a3b6-5fd195c6018f, 'Tout simplement délicieux. Je n''aurais jamais penser à associer banane et kiwi et pourtant c''est un mariage réussi! Je la refais ce soir!', '2007-01-15T14:15:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 5a74ca25-134c-4968-ac41-79add69fa4e0, 'Bon, mais mes kiwis étaient toujours trop acides...', '2006-10-29T16:16:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, c00a206a-1d04-4d66-bcc6-7bb7acaefb57, 'Le mélange peut surprendre... mais c''est vraiment à essayer. La banane et le kiwi sont complémentaires. Toute la famille a adoré. Merci pour cette recette très originale.', '2006-06-09T23:01:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, d1223b7a-6c08-41f3-ae21-254cd2832d30, 'Rapide à faire et très bon chaud. Je sais pas ce que ça donne froid (il en reste plus... mais je n''ai pas beaucoup de doutes).', '2006-04-09T00:14:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43066, 39302de3-32ba-4ff4-b88b-9f6939e8342a, 'Délicieux, très simple et rapide. J''ai mis 125 g de beurre et 125 g de sucre, pour plus de légèreté et le résultat après 25 min de cuisson à 200°C était parfait.', '2006-03-07T21:48:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172383, e1d2c089-1e58-4129-9868-23e2ab08411c, 'Super recette!  J''ai mis deux cuillères à soupe de farine de riz supplémentaires car je n''avais plus de Maizena. J''ai mis du lait de vache car pas de lait de soja. La prochaine fois, j''essaierai avec du lait de coco! ', '2015-05-13T06:47:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172383, 057e219a-140d-423f-862e-16fbe60df8f5, 'Le temps de cuisson est beaucoup trop juste en ce qui me concerne mais je réessaierai cette recette qui permet d''utiliser le surplus de quinoa. J''ai rajouté une bonne cuillère à café de cacao en poudre, c''est pas mal.', '2013-08-08T16:53:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172383, 13748ffa-95c0-4a91-8e50-2c137c0e7f6e, 'J''ai remplacé le lait de soja par du lait de riz et la levure par du bicarbonate de soude. Peut-être que mes bananes n''étaient pas assez mûres car on ne sentait pas trop le goût. J''ai ajouté du zeste de lime qui a bien relevé le goût. C''est un gâteau étonnant et qui change.', '2013-07-07T00:20:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 7a044760-8f19-4bf9-b790-29cac7c62b20, 'Facile, rapide, simple et bon !
Je recommande de casser les glaçons pour faciliter le mixage.', '2022-08-13T16:24:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 57445492-38b0-4ad1-92da-2cca05c31c9f, 'J''aime bien, je recommande fortement !', '2023-01-17T13:19:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 562e2725-c16f-4ea1-b982-a1197bb2d5b7, 'J''ai mis un tout petit peu de lait mais pas de sucre. Un délice.', '2023-01-08T11:21:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, f2193c5a-9fed-40fd-927b-73498916abe6, 'Très bonne recette, mais les quantités sont fausses, j’ai voulu faire pour 2 personnes, il n’y avait même pas 1 verre, mais très bonne recette.', '2022-05-14T11:10:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, a0f7f0b2-84ca-402d-ac5d-1302cb679f5e, 'Super bon je l''ai fait avec des fraises surgelées du coup pas besoin de glaçon.', '2016-02-29T11:46:18+01:00');
