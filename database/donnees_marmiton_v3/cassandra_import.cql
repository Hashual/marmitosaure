INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 222012df-236d-4a43-a9b2-d17257190f18, 'Recette délicieuse, simple et rapide. J''ai ajouté du Mascarpone (350 g environ au total). J''ai choisi de mettre des gariguettes. 

J''en referai !', '2020-04-04T23:53:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 500a614d-4713-4b4d-8374-b8b2484feed6, 'Magnifique vraiment. Au frais pendant 2 h, un délice.', '2019-07-20T20:06:16+02:00');
