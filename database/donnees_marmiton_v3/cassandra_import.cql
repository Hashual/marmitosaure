INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 74b30a30-da0f-4667-8cd3-7465dc128a85, 'Succulent !!!!  Mes amis me demandent la recette. ', '2021-10-08T16:55:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, e0cf8990-fedf-4a13-ace4-4260df0be4b6, 'Magnifique! 3 badianes, du gingembre, de la vanille.  J''ai rajouté un caramel liquide fais avec le jus a versé sur mes pommes avant de mettre le crumble ! ', '2021-09-02T07:33:53+02:00');
