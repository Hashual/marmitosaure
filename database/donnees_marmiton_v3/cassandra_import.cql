INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 69294f06-8439-49ae-b425-9466fdf0b5ef, 'Je remplace les spéculoos par des biscuits rose de Reims émiettés è', '2018-09-02T14:24:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 62a7339a-b1fe-483e-857d-f7d3959ee4a0, 'Moi qui suis novice en cuisine et qui apprécie regaler mes convives j''ai trouver cette recette simple , rapide et excellente', '2017-07-20T17:33:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 960b23b4-c317-4d48-a561-7e5f9600a766, 'Excellent ! Très bon en bouche facile à réaliser je recommande cette recette !', '2017-04-20T01:11:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, b276d3ad-7b5e-465e-b069-2032d9bffac7, 'Moi j''ai réduit les doses, 3 oeufs, 30 g de sucre et 1 sachet de sucre vanillé, 5 speculoos et à la place de mascarpone j''ai mis 1 yaourt nature. C''était délicieux. Un ajout de chantilly pour les gourmands lors de la dégustation !', '2016-05-27T17:34:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 2792315e-197a-43c4-a4fe-c67b26182834, 'Délicieusement bon ! un carton à chaque fois. Je fais ma pâte à crumble moi même à la place des spéculoos, ça croustille et c''est divin. ', '2015-07-25T14:58:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, e6302d9f-da3d-4776-925e-f7ac73b249e3, 'Super recette respectée à la lettre mis à part un peu moins de sucre, 70 g de sucre ont suffit !', '2015-06-18T14:54:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 6ce71ce1-66b4-452d-b1e0-86496870f0ed, 'Excellent ! J''ai fait 8 verrines et mis 800 g de fraises.', '2015-06-02T23:47:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, a596fe8b-169a-4355-a59b-66cf20d3ee4d, 'Super mais je ferai moins de crème la prochaine fois 3 œufs et moins de sucre.', '2015-04-26T14:48:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 971211a1-edb8-4c7c-a778-7091c0b55ae2, 'Un délice ! Recette que je fais souvent, en été avec des fraises fraîches, et en hiver avec des framboises surgelées (le mariage avec le spéculoos est très bon aussi).', '2015-02-05T23:51:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, d52cb643-5813-4f7d-85c9-b02c05ba9819, 'Super recette ! Effectivement les fraises rendent du jus, donc la 2ème fois que j''ai fait cette recette je les ai laisser à égoutter sur de l''essuie-tout. Cette fois je l''ai faite avec des framboises, génial ! ', '2015-01-24T18:48:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, f1ef0d8a-9497-4434-b8ca-0b0fae74454a, 'Excellent ! Je n''ai pas mis de vanille mais du sucre cassonade. Avec un café, c''est un délice, merci pour cette recette!', '2014-07-22T20:55:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 22a4fc9a-44ee-4831-bee9-d3ab96fc79b0, 'Recette exquise, qui reçoit toujours un grand succès et pour laquelle il y a de nombreuses possibilités! En revanche, je trouve que le consistance reste un peu trop liquide! Mais c''est un vrai délice.... ', '2014-04-05T13:15:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, add57224-2b73-4f59-9a77-33fb81695b45, 'Très bon dessert, le seul hic du jus au fond qui fait vite pas très appétissant avec le spéculons et la fraise ... si quelqu''un a un conseil car pour le reste c''est top le goût est là, c''est frais et très bon ! ', '2013-11-11T11:46:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 8839cc56-d2e0-487f-a2b9-d079019ba82c, 'C était trop on en refais tout le temps 
