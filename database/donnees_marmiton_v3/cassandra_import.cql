INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18588, a2787df1-4188-453d-b49b-ba0286e3378b, 'Très bonne , mais la quantité de pommes ne suffisait pas donc prenez au moins une voir deux pommes en plus. 
