INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 74b58f28-ff1c-47ba-a3b0-240713e731a2, 'Ca fait plusieurs fois que je la fait et mes convives se regales à chaque fois ', '2021-03-16T12:16:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, fb3c3c19-1035-48bd-8718-addd5e13287e, 'Très bon,très frais....mes invités ont adoré!!! A refaire....', '2020-06-21T18:18:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, caec48ab-86aa-4b76-a8c0-011286ea5f60, 'C’est une très bonne recette qui vous alléger en remplaçant la mascarpone par du fromage et 10cL de crémé fraîche. Nous la recommandons vivement', '2020-05-16T11:51:01+02:00');
