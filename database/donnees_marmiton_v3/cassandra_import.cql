INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, eb0fc307-cb60-423e-8fb1-2b2a71fb3a19, 'Thermostat 8 c un peu trop a mon gout mais sinon tres bonne recette 😁😋', '2021-04-28T13:54:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, f47886e7-8e63-4655-b055-53cd3058833d, 'attention au thermostat 8, c’est trop fort, j’ai fait cuire à 180 degrés pour ma part et c’était parfait !', '2021-04-24T12:14:20+02:00');
