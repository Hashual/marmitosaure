INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 716e72cf-e6fc-4766-8a13-9f097e545f50, 'Excellente recette ! J''ajoute des pépinettes précuites mélangées aux courgettes et de l''origan à la viande hachée: Cela fait un plat complet.', '2020-06-21T14:34:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 2856eedd-51d0-4fa9-8049-3e081b961757, 'Superbe recette, simple et rapide à réaliser. Je rajoute du riz cru au fond du plat, il cuit avec la sauce du plat. Et je rajoute de l''ail et des épices. ', '2020-05-07T21:43:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 3c6a0273-ab45-45ce-8db5-e578ebbdfe76, 'Un régal enfin mes enfants et mon mari se régalent avec des courgettes ! Merci super recette', '2020-04-16T12:39:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, d6106170-79dd-476a-b4fe-3015b632de91, 'Tellement bon et adopté, rien à changer', '2019-08-15T19:58:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 154a3219-12a7-41c3-8ca0-2936378b8422, 'Super !! Jy ai ajouté un peu d''épices et du chèvre.', '2019-06-06T08:59:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, aa46e789-fc8a-4f7f-9526-b35acce4df52, 'Excellent ! Un des plats préférés de ma fille. Recette toujours suivie à la lettre et on adore tremper du pain dans la sauce onctueuse qui reste au fond du plat.', '2019-05-31T22:47:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, bd580417-f913-403e-ac3c-6dc2570e94bc, 'Excellente recette, la famille a aimé, j''ai également mis un paquet de riz cru au fond du plat et la cuisson s''est faite avec le gratin.', '2019-05-19T04:13:13+02:00');
