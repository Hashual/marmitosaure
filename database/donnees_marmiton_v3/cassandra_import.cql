INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 5d38327c-7848-4347-83d2-a9941c44e84c, 'Facile à reproduire et délicieux !', '2020-12-29T22:32:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 29222ad8-f1d6-4943-b1c0-bf0c8212d01f, 'Excellente recette. J’ai du la faire au moins 5 fois! Ma famille l’adore !', '2020-06-15T11:36:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, d7d1fc34-389f-405f-b4f3-36567316725c, 'Excellente !! 😀 Rien à rajouter ', '2020-04-21T15:02:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 4e57687c-77b4-4978-ae81-9ee48242b57d, 'Merci pour cette excellente recette. J’ai compilé les modifications indiquées dans les commentaires. 
Pour la pâte : 150 g sucre seulement, et moitié maïzena moitié farine, le jus d’un citron (un peu moins pour que la pâte ne soit pas trop liquide). Pour le jus : 100 g de sucre et le jus de 2 citrons et un peu plus. J’ai fait des trous partout pour imbiber de façon homogène. 30 min à 180°C. Délicieux !', '2019-12-15T09:45:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 027a7182-b55a-483a-945c-42f37ce65ab0, 'Très bon cake même sans sirop. J''essaierai de le remplacer par un peu de jus moins sucré. Il est très vite consommé de toutes façons.', '2019-12-14T10:51:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 20194203-13a3-4a40-9e8a-9024398b042c, 'Excellente recette appréciée par tous !
J''ai tout de même fait quelques petit changements :
Pour le cake: 150 g de sucre 
Pour le sirop : 10 sucres', '2019-05-30T03:45:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, c0e214a5-2aef-4111-8c5d-a83e59537690, 'Excellant ! Pour ma part j''ai mis 100 g de sucre et 75 g de beurre pour la pâte et 100 g de sucre pour le sirop. Tout le monde a été conquis.', '2019-04-30T18:54:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 48296d07-5c9c-4f67-b6b1-75108fae12ec, 'Excellente recette. J''ai apporté quelques modifications à la recettes : j''ai mis seulement 100 g de sucre + j''ai ajouté le jus d''1 citron directement dans la pâte + zestes de 2 citrons + 1 sachet de levure entier (alsa). Pour la sirop : le jus du deuxième citron.', '2019-04-20T19:50:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, f6739cfa-4ca3-44be-9e90-191f2affdfb1, 'Top !
', '2019-02-24T07:38:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 54e9924c-423f-4e49-985b-0f1354ae4ae5, 'Délicieux pour ceux qui aiment le citron comme moi, je l''ai préparé plusieurs fois et ma famille adore vraiment. (J''ai mis 2 citrons au passage).', '2018-08-13T17:37:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, a312cea8-05af-4b60-b687-d7b6d498e9f0, 'Superbe recette ! J''ai juste mis un peu moins de sucre (150g), et ajouté un peu de jus de citron dans la pâte avant cuisson comme le conseillent certains commentaires et c''est délicieux ! Un gâteau bien moelleux comme on les aime !', '2018-07-09T05:30:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 4223daab-e0b6-4aa7-b8bf-6d8910fcd4a2, 'Délicieux cake moelleux. J''ai retiré un peu de sucre question de goût. Pour le glaçage, j''ai mis 40 g de sucre glace et le jus d''un citron. ', '2015-10-07T13:11:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, bc9dfb62-9ee2-4061-9560-4d6a2a3fde35, 'Très bonne recette, pour ma part fait avec farine de blé complete et parfumé au kirsch, excellent ', '2023-11-04T17:41:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 49b7365a-ba4d-4437-a7ed-5f4dcb2ba911, 'Super recette ! Tout le monde a adoré ce cake délicieux !!!', '2023-05-17T05:24:41+02:00');
