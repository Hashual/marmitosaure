INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 0259184f-5ed3-4c46-a445-204d0e9b2874, 'Excellent. J''ai rajouté de la feta émiettée par dessus les courgettes avant de mettre la viande.', '2021-04-14T13:27:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 2a34f5eb-257c-4062-8f89-da36b890aef6, 'Ma fille qui n''aime pas les légumes a dit que c''était bon. À essayer pour les enfants qui n''aime pas les légumes, moi j ai ajouter un peu plus de viande', '2021-03-11T17:25:55+01:00');
