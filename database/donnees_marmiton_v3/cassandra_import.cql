INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73317, 74c859b9-05e2-4526-8718-90f3b9f1f781, 'Très très bon ! Mon fils a adoré ! Et c''est une bonne manière d''utiliser les bananes trop mûres que personne ne veut manger.', '2013-06-15T20:16:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33485, 411610ab-d530-419b-b2d6-054d364efd66, 'Top', '2020-07-10T18:00:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33485, 3e007dec-4b9e-43d6-95cb-8dcab16e2e42, 'Délicieux.', '2020-05-08T18:43:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33485, 21a43d8d-079a-4ccf-a57e-818dc37c0ae8, 'Excellente recette, quoique légèrement calorique... Pensez à préchauffer avant de flamber pour éviter toute déconvenue. Beurrez chaque face au Nutella, et ajoutez un carré de chocolat pour plus de saveur. Variante: remplacer la banane par du jambon et le Nutella par de la raclette. Bon appétit !', '2017-08-01T17:11:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33485, 564f814d-3b36-4ade-8181-086942ef85c5, 'Excellente recette pour les gourmants. Ajouter du nutella généreusement sur chaque face. Un peu de beurre pour dorer la face et faite flamber avant de servir.', '2016-09-26T23:10:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33485, 03c29e4e-5d6e-4290-810f-0141678e9293, 'Excellent ! J''ajoute juste du mascarpone sur la brioche, je mets les bananes et les éclats de chocolat avec le zeste d''un citron jaune ou vert et c''est un vrai régal !!!!', '2015-02-25T22:17:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33485, d00d2f0f-7768-49c2-8582-0acd21fdece1, 'Simple et facile, je remplace le chocolat par du nutella ou de la confiture de fraise.', '2009-05-22T22:32:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33485, 0f8f4580-4b5c-4437-87d2-73e9d9cbca2d, 'Moi j''en fais depuis très longtemps et moi je fais rissoler les bananes avant, en morceaux dans une poêle, et après je mets les morceaux de chocolat. Un vrai délice encore, et oui avec de la chantilly faite-maison c''est encore mieux, lol bisous.', '2008-09-21T20:53:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33485, b5a1c3f9-3a22-4eec-8b88-f87cec7cd2b8, 'Extra! Pour les gourmands on peut rajouter de la chantilly par dessus...', '2005-03-15T13:41:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33485, ba08ca83-5057-432f-8c52-46f954ea0597, 'Je le fais depuis des années! Après des croque- monsieurs au jambon, c''est un régal.', '2004-12-20T14:30:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315022, 0b89bb0c-1ef5-48f0-9ce8-279ca702cc6a, 'Trop , trop bon !', '2014-04-07T21:18:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315383, 356ced3c-c27c-4d4b-a4fd-32b29222fb04, 'Très très bon. Le caramel beurre salé est succulent.', '2014-03-16T01:36:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315383, c0b48cc0-ad3a-4ac1-b92d-aafb9371b3e4, 'Superbe recette ! J’ai Suivi la recette à la lettre, la prochaine fois je mettrai juste moins de sucre dans le mascarpone un chouille trop sucrée !', '2018-05-22T13:40:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315383, 65b08a88-1a3e-415b-8322-c56d86d7e83a, 'Ce dessert a fait l''unanimité ! Merci !', '2017-07-01T03:17:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315383, e96aab4d-2184-4b00-8dba-1865b4ce40f5, 'Bonjour, j''aimerais tester votre recette mais combien de temps faut il les laisser au frais au minimum pour que la crème au mascarpone prenne bien svp ?!', '2015-10-20T19:07:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315383, 0d6328b1-071a-4f2f-8a8b-5754a53b415a, 'Un délice, je l''ai faite déjà 2 fois mes invités ont adoré !', '2014-03-25T22:17:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315383, a4ba5451-7a4f-41a6-a4bf-ede62f20b7e3, 'Très bonne recette ! A ne pas préparer la veille du repas car le biscuit boit l''humidité du reste et devient compact.', '2014-03-15T15:41:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315383, c0710389-f067-434c-abb4-da92724112db, 'Excellente recette, à déguster très frais.', '2014-03-11T21:50:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72862, 899ffb70-9ab6-4cda-b854-e3d5b724f30c, 'Très bon, bravo!', '2008-07-04T16:37:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336399, bdd13b51-cffe-4dd6-bfb8-5743a2992aa5, 'Parfait, les enfants ont adoré !', '2020-03-08T13:12:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336399, bb3faa36-311b-4ad3-8e63-868b34f0ee9b, 'C''est délicieux.', '2020-01-29T20:42:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336399, 57d96cee-a291-4bf1-b348-7642190a7e06, 'La banane est-elle vraiment nécessaire ? Car on ne distingue pas le goût de la banane derrière celui très prononcé des fraises. J''ai ajouté une cuillère à soupe d''édulcorant pour le double de la recette. La texture est très légère.        ', '2016-06-17T03:47:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336399, fa28c04e-54c3-4759-a0e7-ec92ca2d0d79, 'Je l''ai testé. A tester !!', '2016-06-07T14:40:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336399, 06ab4a7f-4285-444f-a659-b1d6a7665bee, 'Bonne recette à refaire sans hésiter.', '2016-06-02T00:47:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346953, 8e59859f-4507-41c3-9c53-1decab693cab, 'Bonjour, il y a des manques dans la recette, par exemple dans l’étape 4 le sucre n’est pas indiqué, dans l’étape 6 les bananes avec quoi? Il faudrait revoir l’intitulé, merci d’avance, c''est dommage parce que la recette à l’air d’être très bonne. Encore merci de corriger.', '2022-02-23T03:07:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346953, f85b29f3-315c-4546-98f0-b3a41ae15557, 'Ça m''a l''air appétissant ! Très facile à faire !', '2020-03-19T17:20:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346953, be2e0867-b323-4bb5-8671-2b11af361fa8, 'Caramel réussi. Très bonne tarte.', '2018-02-21T08:07:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346953, e39f6680-42de-4926-933c-d47255778a46, 'Échec total, la crème n''a jamais monté en toffee... La prochaine fois je ferais un toffee comme d''habitude en faisant bouillir du lait concentré seulement. Dommage car ça avait l''air pas mal...', '2017-09-06T16:28:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170233, ffaabb01-14d0-4d05-a038-3ba3b542d614, 'J''ai ajouté 2 grosses cuillères à soupe de sucre complet et beaucoup de lait de coco (je n''ai utilisé que du lait de coco) pour un rendu plus crémeux. Très bon, la prochaine fois, j''ajoute aussi une banane.', '2018-08-01T20:37:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170233, 81483bf0-accd-4f70-aea0-76a321b68f44, 'On ne sent pas assez le goût de la banane...Il faut peut-être en mettre plus. Heureusement qu''il y a les raisins.', '2012-04-15T18:58:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170233, 934424bf-dff2-4ddd-804f-cbad7216622b, 'Très parfumé avec la banane, une bonne variante de la simple semoule aux raisins', '2011-05-17T21:10:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170233, 66520c13-ae74-40c6-87f5-65ba5d226e3e, 'Dessert facile à faire et qui plaît beaucoup aux enfants. J''ai juste un peu changé les proportions (1 l de lait et 150 g de semoule de riz) et ajouté du sucre.', '2010-10-18T17:31:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65211, c5a11c75-8680-48af-813f-0ddd76dddf31, 'J''ai moi même essayé cette recette, malgré le commentaire très négatif que j''ai pu lire ! Il est vrai que les doses sont très flou, mais une chose est à savoir, c''est que la pâte avant d''être mise au four ne doit surtout pas être trop liquide ! Avant d''enfourner ma pâte ressemblait un peu à une pâte à pain (niveau consistance), elle n''était pas liquide.  Mes doses ont été simples : 2 bananes TRES mures, 200 g de flocons d''avoine, 4 cuillères à soupe de miel liquide.  J''ai parsemé ma préparation de noisettes concassées, et une fois cuit et refroidi, j''ai recouvert le dessous de chocolat !  J''obtiens des barres céréalières dignes des meilleures marques de grandes surfaces ! N''ayez pas peur pour la réalisation de cette recette, si la bases n''est pas trop liquide, vous n''aurez aucun soucis à la dégustation ! Et à savoir que si la préparation vous parait trop liquide, on peut ajouter plus de flocons d''avoine sans problème! Bon appétit !', '2010-06-08T16:06:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65211, f78928f3-08f1-4737-91e2-2b3834e22735, 'En suivant les conseils dans les commentaires, j''ai mis 3 bananes et 3 cuillères à soupe de miel (n''étant pas une grande fan de miel), et c''était parfait ! Pas trop sucré, et avec des canneberges séchées, c''était très bon ! ', '2017-01-12T12:33:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65211, eaf876e4-601b-4e1d-9ad3-0e2dac8c1c4d, 'Excellent ! Un petit en-cas sain qui remplace les biscuits trop sucrés! ', '2021-03-17T20:40:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65211, 663f316d-7355-4a13-8b07-55a8d25ce736, 'J''ai essayé avec les proportions proposées par VanillaLuna dans les commentaires : parfait !  Je fais griller des amandes entières. Pendant ce temps, je fais la préparation avec les flocons d''avoine (200g), 3 cuillères à soupe de miel, 2 bananes mûres. J''ajoute des morceaux de pomme et de la cannelle. J''étale sur une plaque à pâtisserie et j''enfourne 10-15 min à 180°C.  Idéal pour un petit déjeuner sur le pouce et qui cale jusqu''au déjeuner. ', '2014-10-12T14:15:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65211, 7289b954-e07e-4bc8-821f-5d611dcd7720, 'J''ai suivi à la lettre la recette de VanillaLuna, le résultat est impeccable. Le principe est d''avoir la bonne consistance dans le saladier : pas trop pâteux ou trop sec. La prochaine je remplace la banane par de la purée d''amandes.', '2017-05-24T10:30:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65211, a2a5fb50-eb3d-4dda-a727-eca02e23fac0, 'Un délice pour faire passer les flocons d''avoine qui restaient dans le placard.', '2013-04-03T12:58:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65211, ac402d24-ca08-4a48-bda4-aa7a303beeee, 'Le commentaire m''avait fait envie, mais je regrette le temps et l''argent investis. D''abord, il n''y a aucune quantité précise, comment s''y retrouver ? J''ai fait par ajouts progressifs et j''arrive à : 3 bananes (542g. avec la peau), 200g de flocons d''avoine, environ 70g de miel et 2 pommes bicolores épluchées. Le résultat ne correspond pas du tout à ce que j''appelle une barre céréale : c''est mou, collant (j''ai dû le manger à la cuillère) les goûts sont tellement mélangés qu''on reconnait à peine celui de la banane, et heureusement qu''on sait que les morceaux sont de la pomme... Je ne garde pas cette recette.', '2009-11-17T21:59:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65211, f87892f9-441e-4395-b390-cb100557966e, 'Savoureux goût de banane... ai essayé canneberges et noisettes.  Mon compagnon en redemande, mes amies ont imprimé la recette, c''est vous dire!  Moins cher que les biscuits industriels pour l''école et on sait ce qu''il y a dedans... Rien que des avantages.  Essayez et vous adopterez ! ', '2008-07-02T09:44:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 66244101-a403-4a5c-ac26-6296e93eb847, 'Trop bon! J’ai réduit le beurre à 80g. Réduit la farine de 30g et mis 30g de maïzena.
Quand mon robot fais mes pâtes à gâteau c’est toujours une réussite !

', '2023-10-15T18:21:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 59231406-3e5e-47a3-9b07-91aa6f4fa258, 'Super recette, mais je mets un peu plus de banane et moins de farine.', '2021-01-12T13:12:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 61e1004e-98e8-40b3-b679-355d60e96245, 'Bof.. gâteau trop sec, manque de sucre et de moelleux. Pas top', '2020-10-23T18:21:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 2eafb1af-f939-4751-bf5b-7af2f0e82d86, 'Très bon gâteau ! J''ai doublé la dose de levure et ajouté environ 2 cuillères à soupe de crème fraîche pour rendre la pâte légèrement plus liquide et avoir un rendu plus moelleux. 40 minutes au four étaient suffisantes. J''ai aussi ajouté de la cannelle, super bon ! ?', '2020-05-08T14:37:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 56f12cf6-ba21-42e4-bf95-f48f390c151f, 'Très bonne recette à laquelle j''ai juste ajouté 3 crans de chocolat noir concassés, super bon !  ! Temps de cuisson impeccable avec mon four et mon moule à cake (moule de 25 cm de long, et 6 cm de haut, bien rempli).', '2020-04-15T22:22:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 35962abc-4ab9-420b-acaf-4ad7862baf47, 'Très bon gâteau !! En revanche j''ai un peu changé la recette : j''ai mis la moitié de la dose de noix et l''autre moitié des copeaux de chocolat et le résultat est top par contre je pense que la prochaine fois je mettrai encore un peu moins de noix et un peu plus de levure ou un peu de maïzena pour que le gâteau soit plus léger. Mes bananes n''étaient pas hyper mûres mais c''était très bon quand même, la majorité de mes invités ont beaucoup aimé.', '2018-12-29T13:12:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 0cb5a594-0247-45b3-911c-ab6db77df926, 'Beaucoup trop épais et pas assez aéré à mon goût. Il n''a pas du tout la même texture que celui que j''avais goûté.
Cela reste bon tout de même mais je crois que les quantités pour la pâte sont insuffisantes et le temps de cuisson trop long.', '2018-09-07T05:26:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 2b959daf-4dba-4f36-98aa-cc33b91c392b, 'Délicieux dessert qui peut se décliner en parts individuelles (moule à muffins par exemple). Cela rappelle les vacances aux Antilles où l''on se régalait, les noix ajoutent un petit effet supplémentaire. Je recommande. Parfait pour éviter le gaspillage des bananes un peu trop mûres.', '2017-08-13T02:13:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 66a64496-222e-4b7f-ab5e-9a1a5e61a495, 'Un classique, simple à faire et parfait pour le petit déjeuner! Peut très facilement se congeler (tranches par tranches) pour les ressortir quand on en a envie.', '2016-07-28T21:18:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, b6eb35d8-66af-4566-a858-7c683bb59d9c, 'J''adore j''adore j''adore ', '2016-01-03T12:58:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, ea018708-fef0-4f21-99c0-c2fddef552ea, 'Très bonne recette, les proportions sont idéales pour un cake moelleux... J''ai juste mixé les 2 bananes au lieu de les mettre en morceaux, ainsi que les noix. Miam !', '2015-11-22T20:01:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, b47ebec9-e22d-4c2c-96c9-f41b7c1ed23d, 'Superbe recette. Le gâteau tient bien. Nous l''avons trouvé cependant pas assez sucré. A refaire ! ', '2014-02-15T05:40:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, c544cdf8-0fed-437e-a7e9-71807bca5092, 'Superbe mais oublier l''étape de la fonte du beurre et faite le mousser avec le sucre !', '2013-10-28T01:09:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, f717a8d4-b2e6-4656-8809-c1b6c23f08e6, 'Cette recette est ultra simple et délicieuse. Je remplace pour une question de goût les noix par du chocolat: c''est un régal ! ', '2013-06-01T13:08:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 4abfa5ae-6362-475b-ae73-fa19cb570158, 'J''ai suivi la recette à la lettre, un vrai régal ! Un cake super moelleux et savoureux. Je ne change rien, et je recommence très vite ! ', '2013-01-07T23:13:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, e42fcda5-2876-4341-a32f-fb247d0b72eb, 'Super ! J''ai décoré avec des rondelles d''une banane sur le dessus et je n''ai mis que 75 g de noix dans le cake et 25 g dessus ! C''était magnifique et bon !', '2012-10-31T19:58:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, b8492144-7052-4e66-94d0-ce54fd0469a6, 'le plus long et difficile, c''est de couper les bananes! je n avais pas de noix concassées, j''ai remplacé par de la poudre de noisette... il ne va même pas avoir le temps de refroidir. ', '2012-04-15T19:38:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, b9518412-413c-4bf2-bcdc-6ad520e49beb, 'Tout simplement excellent !!!', '2011-08-26T21:59:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, da6011f3-c69c-4c78-a1ee-290f04571a4e, 'Ce cake est délicieux, et pas sec du tout ! A refaire ! Excellente recette.', '2011-08-14T20:16:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, ffdfb3e4-2fa5-4879-9bec-e67be6e18bde, 'Pas de noix en Colombie, donc j''ai utilisé des noix du Brésil. Pour le reste, j''ai suivi à la lettre, et c''était très bon ! Merci !', '2011-06-03T22:06:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 1ef63624-5cc8-4fc4-891d-51892d11547f, 'Je n''ai rien changé à la recette ! Mon mari et mes enfants l''ont dévoré ! L''association noix + bananes est délicieux. Je mets la recette dans mon carnet ! A refaire pour le goûter des enfants !! ', '2011-01-21T13:40:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, fc98062b-13ec-4b65-b7ae-9c6f5cbf5f9a, 'J''avais de très mauvaises bananes (vous savez, celles qui ne murissent jamais!) et je les ais passées au micro-ondes 3 min pour les réduire en purée avant de les incorporer à la pâte. Du coup cette recette devient formidable pour éviter de jeter les dernières bananes dont personne ne veut et qui trainent au fond de la corbeille à fruit... Merci ', '2010-11-06T17:08:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, dff1f0e5-f054-4486-a727-e0058b4ff111, 'Je n''ai pas mis de noix à cause d''un bébé gastronome, mais ça marche quand même ! Super, merci pour la recette.', '2010-09-07T07:51:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 0ecbae40-3686-4c62-a0f0-fa993610fc08, 'Excellent, je n''avais qu''une banane, j''ai donc réduit de moitié la recette et fais cuire dans 6 moules à muffins, super car temps de cuisson réduit de moitié aussi... Merci pour cette excellente recette !', '2010-07-09T14:30:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 328f0c73-acd2-4a7f-88eb-dff7d6c9ce6d, 'Délicieux... Moi qui ai toujours été très mauvaise pour la cuisson des cakes, il était parfait... :)', '2010-04-02T00:11:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, fc5a2369-d1dc-484d-97ce-819ca7c19a48, 'Excellent. Recette simple, rapide et succulente.Le cake est léger pas sec et à beaucoup de goût. J''ai juste mis un peu moins de beurre (80g au lieu de 100g) et comme les bananes étaient mûres mais pas suffisamment j''ai mis 100g de sucre au lieu de 80G. je n''avais que 75g de noix et c''était bien quand même. Je referais cette recette qui à plus à toute la famille. Merci pour cette excellente recette.', '2009-02-20T17:20:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, fb7541a9-aaf5-4f03-a353-d0854ec793f5, 'Je n''ai pas eu le courage d''attendre que les bananes soient bien mûres, c''est probablement la raison pour laquelle je le trouve pas assez sucré. J''ai mis que la moitié des noix et c''est largement suffisant si elles sont en petits morceaux. J''ai écrasé une des bananes pour que la pâte soit plus parfumée et aussi ajouté de la vanille. C''est vrai aussi qu''il est tendre et moelleux et pas du tout sec !', '2008-02-24T23:37:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 95b1d2e0-358c-41fc-aa2f-753eb1353827, 'Très bon cake effectivement! J''aurais dû aussi retirer un peu de noix, 100 g ça fait beaucoup. Un peu de chocolat doit donner un très bon goût!', '2007-08-13T22:25:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 53413da0-c220-4787-975d-0f97416a1a9e, 'Très bon, nourrissant. En plus, rapide à faire et se garde plusieurs jours, cake moelleux et pas du tout sec. On peut dimuinuer la quantité de beurre.', '2007-07-07T23:24:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 8e7c781b-fe46-428c-b74b-babb5bb8ddee, 'Une très bonne recette. Par contre, je n''ai mis que 75g de noix et j''ai fait moitié farine / moitié maïzena.', '2007-03-29T15:58:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, acf9dfc8-8bef-484e-8a99-fee7371afa4f, 'J''ai diminué la quantité de noix de moitié, et rajouté le zeste d''une orange, son jus, ainsi que des copeaux de chocolat et 1/2 sachet de levure. Cake très moelleux et léger.', '2006-10-23T12:36:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 43d0ff3a-eb3e-4595-bc26-56d6d42ff1b8, 'Excellente recette à laquelle je ne rajoute qu''une banane. Je préfère travailler le beurre mou que fondu avec le sucre, et je bats au batteur pendant 5 à 10 minutes pour une crème onctueuse (la clé pour réussir tous les gâteaux!) Le résultat est léger, doux et moelleux. ', '2006-08-16T05:51:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 57c54837-d5b7-41d9-9bb0-89f07c281219, 'Très bon, mais un petit peu lourd. ', '2006-05-04T18:12:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, ac17fec9-d4d4-459f-9657-c50eda516135, 'Excellent.', '2005-10-25T22:09:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35960, 1f280917-0cdc-4547-b8c3-d7067830febc, 'Facile, rapide, excellent. Je l''ai fais aussi avec des noix de pécan ou des noisettes concassées. A faire pour le goûter...les enfants adorent!', '2005-06-04T21:40:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 38f7afa9-3c35-433d-a303-c0d5da781283, 'J''ai finalement fait un cake. Je opté pour des pépites de choco plutôt que du chocolat fondu. Je vous la conseille. Merci pour cette très bonne recette !', '2021-11-29T18:15:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 1df7ebb4-944d-40b4-978a-56e299b7411d, 'Recette très facile et délicieuse!! 
J’ai mis des pépites de chocolat à la place du chocolat fondu et j’ai saupoudré les muffins de sucre brun avant de les enfourner, un délice!! 
', '2023-09-23T22:11:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 730d3039-8524-48a0-bbe8-60befa43eef8, 'Très bonne recette qui a fait l''unanimité auprès de mes amis ! ', '2022-03-09T22:21:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 647a7528-f3f6-4795-86c0-b0a15857a8cc, 'Super recette qui a beaucoup de succès.', '2021-09-11T16:01:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, cdb8c1dc-2ae2-4a43-ab9c-1813c8170edb, 'Testé en version cake (35 min à 180° en chaleur tournante). Résultat : délicieux !
J''ai versé le chocolat au milieu puis sur le dessus du moule. Toute la famille recommande :) ', '2020-04-28T21:35:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 0596270f-cbe1-4dc0-9541-625b16453bc2, 'J''ai suivi la recette a la lettre et ils sont excellent et plutôt léger ! Rien à redire. ', '2020-04-28T18:43:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, bea1662a-5c7b-4f18-a4d6-cf2df9c18081, 'Délicieux je l’ai ai fait le jour même où j’ai vu la recette. Ils sont juste parfait moelleux pas trop sucrés personnellement je l’ai ai manger au petit déjeuner ', '2020-04-28T00:03:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, c8a7c411-ff68-4606-a72f-941b932c204b, 'Excellent, j’ai juste remplacer le beurre par de la compote de pomme pour plus de légèreté.', '2023-11-11T17:03:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 68fb4af9-d01d-4e38-bc46-08007b9b3783, 'Recette suivie à la lettre ! Tout le monde les a kiffés!!! Je la recommande ! ', '2023-08-14T13:18:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 3d7b558f-ee77-4573-be93-9d6da02a4864, 'Très bon ', '2023-07-23T16:35:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 5cbefe82-c545-41ca-8130-659976313a9b, 'Une recette incroyable ! Résultat gourmand ', '2023-05-08T20:59:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 82262cb1-ea57-437f-b41f-cec670640f8e, 'Très appétissant et très apprécié ', '2023-03-19T18:16:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, f2b8849c-ee5d-4c92-81a6-586a1663b97a, 'Délicieux !!', '2023-01-18T16:29:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, fcfb264c-a201-4270-a65d-95b4516598c1, 'Fait en cake et pas en muffins, gourmand et inratable ! ', '2021-05-22T10:43:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, ad519fb9-eab3-4a38-9acf-d7e370c53cbb, 'Délicieux !', '2020-11-10T15:36:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 284e3ffa-cef2-43e1-b3df-eb7ce58fd53a, 'J’ai adoré faire et manger cette recette ultra facile ', '2020-09-06T17:58:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, cd0edae4-51fa-4e76-aa81-9f246ff85453, 'Excellent, même en ayant oublié les œufs !!', '2020-07-06T15:02:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 138b479f-9d9f-49f5-8e06-80b8c70758c9, 'J''ai fait quelques modifications car je n avais pas tous les ingredients. J''ai respecté plus ou moins les proportions. Résultat, j''ai btenu des muffins (moins jolis que sur les photos mais)  très bons et très légers. ', '2020-05-11T09:59:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, cf503d8c-1d19-4eee-aca5-03f855b784a2, 'Tout simplement délicieux ! Très réussi la première fois. J''ai fait 12 petits muffins + un mini cake avec ces proportions. J''ai ajouté un carré de chocolat au milieu des muffins. Très gourmand. Merci ! ', '2020-05-07T20:00:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 382339c2-8e24-4805-a135-71c9862cda67, 'Excellent! Le lendemain on sent encore plus la banane, a refaire !', '2020-05-04T18:45:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 15b1156c-6018-47cf-b11a-00bc59a5772d, 'Très bon et moelleux ! ', '2020-05-04T02:38:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 53896e7d-caae-403c-b96c-702fa4e03324, 'Un régal! À refaire les yeux fermés! ', '2020-05-02T18:15:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 91b98828-52b5-4d0c-b0a0-af3b8f104bb1, 'Recette suivi à la lettre, les muffins sont très bons ! J’ai pu en réaliser 12. Pour plus de gourmandise j’ai ajouté un carré de chocolat à l’intérieur du muffin ! ', '2020-04-27T23:08:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 89388b55-e893-44fa-82f0-d611bb3ae2e5, 'Super bon ! Je l ai fait avec juste 50g de sucre et marbré avec 80g de chocolat fondu dans un peu de lait voir photo', '2020-04-27T00:48:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 636605f2-ee65-4eff-bb4b-84fec24984f6, 'Bonne recette. Je n''ai pas mis de chocolat. pas besoin..', '2020-04-26T19:23:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, 355ed1d0-41d1-4e73-862d-5751d3d7b193, 'Une tuerie ! Muffins super moelleux ! Je referai sans hésiter en y ajoutant peut être quelques pépites de chocolat (mais ça c’est que de la gourmandise)', '2020-04-26T18:33:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392194, e1e99b3d-bbb3-4e71-a402-5de94840b15b, 'Vraiment délicieux ! La recette a remporté un grand succès', '2020-04-26T18:23:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57012, 75683e88-9d64-4066-92f5-661cf0e81049, 'Plat original et sympa, on adore le sucré-salé. Seul bémol, on n''a pas senti le goût de la banane. A refaire avec plaisir quand même.', '2008-08-14T19:05:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57012, 6a8a24a4-5f87-42fc-baa6-aaaf34d7cef2, 'Demandant pourtant peu de temps de préparation, cette recette fut une réussite!! Beaucoup d''originalité, et des invités ébahis!!  A tenter.... donc!  PS : N''ayant que peu de temps, je n''ai pas fait dorer le poulet, les oignons et les patates, que j''ai mis direct dans le four, et ils étaient parfaits. ', '2008-06-08T20:08:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41276, e53fea9d-310e-4a81-ba95-d27ca99c40d6, 'Plat plein de saveurs chaudes et variées. L''ajout de la banane en renforce l''originalité. Délicieux ! Merci ', '2014-10-26T17:41:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41276, 89d657a3-c3cd-444b-be33-814d97a0c879, 'Très bon. Rien à changer, je l''ai fait plusieurs fois  avec succès. ', '2010-11-22T21:12:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (195558, 205e674c-695d-4861-9490-b0b482f7383b, 'Un flop complet
Beaucoup trop de lait. Ca n''a rien d''un gateau !', '2018-04-27T08:28:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (195558, 2dfae2b3-6792-48e2-b539-883aa5a1d39a, 'C''est dommage pour les ingrédients ! En effet, cela se rapproche plus d''un flan que d''un gâteau. On ne peut pas dire que le goût soit mauvais mais la texture est désagréable, le pseudo flan sucré bananes-fraise devient vite écœurant, une petite déception pour mon homme (c''était son premier loupé, il n''avait pas le réflexe de regarder les commentaires de recettes!).', '2014-06-07T19:50:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (195558, 45f921c3-799f-4396-a65f-983cd3ee60ff, 'Ce n''est pas un gâteau mais un flan. Il faut bien faire la différence. Si tu voulais vraiment faire un gâteau il aurai fallu mettre moins de lait. Dommage, ça aurais pu être très bon.', '2012-10-09T18:23:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344693, 33587154-05d6-41ed-9cb2-476c50309267, 'Super recette, pratique pour utiliser des bananes un peu trop mure ! Je mets moins de lait et de levure que la recette, pour avoir la bonne texture (et parce que je mets souvent trop de levure et ce n''est pas bon après).', '2022-04-24T11:42:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344693, 507c2f8c-73b6-467d-b25e-1cc026c8463c, 'J''ai adoré cette recette! Rajouté un peu de sucre vanillé et mangé avec du miel devant un film : moment de bonheur !  Merci, recette légère, digeste, et gourmande ?', '2020-11-08T19:24:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344693, 1898c508-353d-4138-a0f9-53ec77173edc, 'J''ai adoré cette recette! Rajouté un peu de sucre vanillé et mangé avec du miel devant un film : moment de bonheur !  Merci, recette légère, digeste, et gourmande 😍', '2020-11-08T18:24:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344693, cf0d413c-e57f-473c-aaee-abe06a7bbc94, 'Recette simple et appréciée de tous.', '2020-10-12T11:37:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344693, 61de0cce-409b-4f19-b751-f84b3e753cac, 'Très bonne recette ! ', '2022-10-25T15:31:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344693, 6956aae6-d884-4fa0-b7d0-6f97ad1cddc9, 'Très mauvaise recette, les pancakes ne se tiennent pas dans la poêle, j’ai du tout jeté alors que je n’ai jamais raté de pancakes de ma vie !', '2022-02-13T08:33:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344693, dbd90744-ae76-4da7-a8cf-e06af06aed4a, 'Tellement bons !!!', '2022-01-19T18:49:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344693, c9d0faa3-5cf6-418f-a3d8-c811b8f02590, 'Franchement recette nulle ! J''en ait testée plein mais celle là c''est la pire j''ai toujours réussi mes pancakes vegan à la banane mais alors là on ne peux pas faire des pancankes "façon vegan" quand on y connaît rien.
Ça sert absolument à rien de mettre un sachet de levure complet l''appareil est tellement liquide que ça gonflera jamais. C''est pas ajouter une banane et changer le lait qui donne une recette dite " vegan"
Pas hâte a mon petit dej de demain avec ces pancakes la. ', '2021-04-09T21:03:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344693, 06d9f783-5bd2-4b59-97ba-470bd4e2d50c, 'Très bonne recette ! Personnellement,j''ai ajouté un sachet de sucre vanillé .Leger,delicieux et respectueux des animaux! Top!', '2020-04-21T18:00:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344693, 484e51e2-81fc-4dc3-ae65-46bf4f8bb6ab, 'Excellente alternative vegane ! Les pancakes sont très légers et délicieux. Utilisez aussi l''huile de coco pour faire sauter les pancakes.', '2020-01-31T01:10:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344693, 94de1321-e3d7-45b4-9fdf-3d0f8cce7b16, 'Recette simple et rapide et surtout tres digeste ! Merci !', '2017-05-09T11:52:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94983, 68aaf283-5f3d-4181-ae52-60c0dc52f919, 'Très bon, croustillant. J''ai mis du beurre salé et plus de bananes pour accentuer le goût.  ', '2014-05-09T18:32:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94983, 8f4ad13d-0536-4f93-83ad-11cefc2764f9, 'Bonne recette simple et rapide. Très bon, plutôt gras. Ne pas hésiter à mettre une bonne dose de banane séchée pour avoir un goût plus prononcé. La texture est très bien : croustillant autour et moelleux au cœur ! ', '2011-12-03T18:46:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, f077ff64-a3a9-4f05-b028-efd1aa8e76d8, 'Je présente ce potage en verrines pour les apéritifs (tiède ou froid. Lorsque nous sommes un grand nombre les verrines sont vite faites et... surprise assurée pour les invités.', '2017-04-21T15:48:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 037ef3bd-ab2e-4016-99d5-5895ef4ce1f7, 'Délicieuse ', '2022-03-22T16:59:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 08d6cb4e-d5d2-4173-9411-c77ec4ad68fa, 'Très bonne soupe ! Réalisée sans crème.', '2020-07-31T14:13:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 3b50753e-58f2-4cba-905b-fd7e0d699727, 'Excellente recette qui permet de varier les potages !', '2016-11-03T17:10:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 4b2edc1f-6459-442d-a4e6-55a87a819888, 'J''avais envie de tester une nouvelle recette et j''ai choisi celle-ci vu les commentaires positifs mais tout le monde a été vraiment déçu... Ce potage devient vite écœurant après quelques cuillères. J''ai pourtant tout suivi à la lettre. Désolée pour la mauvaise note.', '2014-10-12T12:48:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, a9daec96-c8db-4019-a070-e7f2f93d1b9c, 'Mes enfants ont adorés. C''est original !', '2014-04-30T12:17:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 9300a672-b298-4878-8129-8f72666d25b0, 'Je n''ai pas mis de sel et j''ai oublié de mixer le tout mais je n''ai pas regretté ! J''ai obtenu une compotée très appréciée de tous ceux qui aiment le sucré salé ! Attention à ne pas trop épicer !', '2013-10-27T22:36:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, a722cb44-41d5-4201-88f3-6e977777bf23, 'Je suis mitigée !! Je l''ai testée pour une soirée en amoureux thème Brésil ! Mon mari, qui a horreur du sucré-salé, et a qui j''ai caché les ingrédients, a tout de même trouvé pas mal mais sans plus! Moi, un peu mieux que la moyenne, mais il est vrai que je m''attendais à mieux !', '2013-06-13T00:37:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, e1f5c7c3-c10e-464e-bbc9-813d995dc2f9, 'C''est original, par contre la prochaine fois je ne mettrai pas de sel, ça donne un drôle de goût...', '2013-01-31T12:14:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, d67166a9-a30f-437a-a2c9-1b7fc92e264d, 'Aussi bon chaud que froid. Fait avec tomates fraîches donc plus épaisses, j''ai mis 250 g de crème fraiche et du lait jusqu''à consistance souhaitée. Quel délice, curry tomates et bananes. Je suis surprise du mélange mais qu''est ce que c''est bon.', '2012-10-25T18:10:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, fa20d11d-3781-4d58-b4d8-e3d19bbe4b6d, 'Bonne recette, en la dégustant on voyage !!! Peut être juste ajouter du sucre aux tomates avant cuisson... Merci.', '2012-10-08T17:42:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 92283f23-f9b4-46ff-a85f-84eda0ad8c2b, 'C''est juste un DÉLICE !!! Un mélange harmonieux !!!!', '2012-09-24T11:15:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 05db6fe3-4155-4586-84af-656e8460677a, 'Soupe originale et goûteuse mais la prochaine fois je ne mettrai pas de sel.', '2012-09-23T20:34:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 17be0ccc-df40-42a4-9352-037a0d746256, 'Excellente recette .... On a vraiment adoré et pourtant, je ne suis pas une fan des recettes sucrées/salées. Pour ma part, j''ai ajouté une banane en plus afin de plus sentir le goût.', '2012-09-20T11:16:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, e7b3c883-8c8f-47df-a7af-450a471b5ffd, 'Fait sans ajouter d''eau, simplement avec le jus de boîtes de tomates pelées. Dégustée chaude, un vrai délice. La prochaine fois, ce sera froid en gaspacho. Merci, une vraie découverte.', '2012-07-06T20:42:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 5e46b0e1-28c0-46f3-8127-93f35b3ee509, 'Excellente recette, très bon mariage des goûts, c''est un vrai plaisir ! En plus très simple à faire, c''est parfait !', '2012-06-10T16:56:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, c658ae3a-c281-41c2-b263-bf32393d7b3d, 'Une très bonne recette ; les goûts se marient très bien (la crème n''est même pas vraiment indispensable). Cela fait une pleine soupière, les prochains jours vont être heureux !', '2012-02-17T18:44:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, a064c745-884e-4e9b-abfa-1338975c37c8, 'Très originale, cette soupe ! Je la referai ! La recette est parfaite telle quelle !', '2011-12-30T21:58:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 5a1ed3a2-f026-46a9-8f6b-f9b2c2cf8b80, 'Super ! Mon homme qui n''aime pas le sucré salé a vidé la casserole ! Bon et vite fait, donc à refaire. Merci pour cette recette.', '2011-12-04T11:40:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, c246118b-1adf-46c8-906a-6a63f25b67f5, 'J''avais prévu de faire cette recette lors d''un repas entre amis, j''ai tout de même voulu la tester avant et HEUREUSEMENT ! Je n''ai pas aimé du tout.', '2011-10-06T21:12:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 8992b8eb-079a-443b-acf1-8f2e4c80c5fe, 'Dosage subtil qui laisse dubitatif les convives quand ils savent la composition ! Excellent', '2011-06-30T21:15:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, ee6607bc-0e2d-48e3-bc69-140273078a3b, 'Parfait', '2011-04-16T18:04:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, c4116c1c-a07a-4573-ae42-fe4b4de2a9d1, 'Tout le monde a adoré le mélange banane/tomate...', '2011-03-25T06:14:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 6d032b99-52a4-429f-bc44-d89a212b8b9d, 'Super, même les personnes n''aimant pas la banane se sont régalées. J''ai relevé avec du poivre et servi en verrines à l''apéritif. Tout le monde a voulu la recette.', '2011-03-20T20:33:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, db038407-c9f4-4f2b-be56-0a70097e1a52, 'Très très bonne recette, tout le monde a adoré. Délicieux avec un peu de coriandre fraîche. Merci !', '2011-03-06T22:54:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 34835ec4-1ee5-4e6a-b757-c4a82a39819d, 'Pas mal, ça change de la soupe tomate traditionnelle et apporte une petite touche de sucré.  Pas un grand orgasme en bouche mais bien', '2010-10-09T17:06:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 38564dc2-682f-4982-a7fc-0e7dbb75802e, 'Je trouve qu''on tient quelque chose de vraiment énorme avec le mélange de ces ingrédients. Pour une première fois c''est super bon, à mes goûts je mettrai plus de bananes, moins de tomates, je mettrai plus de curry la prochaine fois. J''ai osé mettre un peu de sucre vanillé, faut en mettre très très peu, c''est génial ! Après, ce sont mes goûts, j''adore les plats sucrés et salés.', '2010-08-30T23:29:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 962589e9-917c-458c-8268-313fd85e3ec4, 'Très bon même en remplaçant la crème par du lait écrémé. Personne n''a deviné la banane, excellente façon d''en faire manger aux enfants !', '2010-03-21T16:28:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, a3b9070f-cef0-47f7-a56c-01328a016cf2, 'J''ai ENFIN osé cette recette et je n''ai aucun regret ! C''est un vrai délice. Les saveurs sortent de l''ordinaire. Très bon potage, à refaire...', '2010-03-15T16:54:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, c2b5f35f-e757-4133-a302-737b71e22b7f, 'Une recette comme on les aime : simple, originale et surtout... délicieuse ! J''ai utilisé une boîte de tomates, y compris le jus : c''est plus simple, on verse tout dans la casserole d''un geste auguste, sans avoir à trier. Du coup la texture était impeccable, ni trop épaisse ni trop liquide, crémeuse à souhait. Merci pour cette recette !', '2009-12-05T18:42:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 76162cc3-cb3f-4dc8-9104-edd67d36be84, 'Bien que sceptique, je me suis lancée dans cette recette. J''ai trouvé sa terriblement délicieux et très simple à faire. J''ai servi ce potage à des amis n''aimant pas le sucré-salé. Ils ont tous adoré ! Je la conseille à tous le monde ! PS : une personne n''aimant pas la banane n''y a rien vu, c''est pour dire ! ', '2009-08-09T11:54:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, a048a015-d5d1-486f-9eff-7d6073a9347f, 'Un peu dubitative, j''ai fait cette recette pour un repas brésilien où chacun devait préparer quelque chose. Franc succès ! J''ai fait deviner les ingrédients aux invités qui ont mis du temps avant de trouver la banane car ce potage a un goût délicieux et pas du tout un goût de banane. Je recommande !', '2009-08-01T17:50:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, deaa43b4-55f9-4908-bf03-b952f2bcf4cc, 'Potage absolument délicieux, surtout servi tiède quand il fait chaud (c''est l''été dans l''hémisphère sud!). Le goût de la banane supprime l''acidité de la tomate. J''ai accompagné avec des tartines grillées au four avec jambon cru et fromage de chèvre...un régal.', '2009-02-14T15:57:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 44cbed19-9856-4760-a7f7-7e1f1151ee42, 'Très simple à faire, et super pour les invités qui aiment la cuisine exotique. Merci!', '2009-01-31T15:43:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, f9dd3022-5dc1-4ab9-9420-33bce4c9f84a, 'D''une simplicité biblique et excellent. J''ai remplacé la crème par du lait de coco, ajouté un peu d''eau et servi avec un peu de yaourt bulgare.', '2009-01-18T16:59:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 81bf283e-6873-4bc6-a290-cff33a0cef82, 'Je viens de finir de lécher mon assiette, et je dois dire que je me suis régalée ! Seul bémol : un peu trop piquant à mon goût, mais je ne savais pas comment doser le curry (j''ai dû mettre 3 cuillères à soupe). Je n''avais pas de bouillon de poulet (j''ai mis quelques herbes à la place), et ayant très peu de crème fraîche j''ai allongé avec du "lait de riz" fait maison auparavant. J''ai réservé la crème pour faire de jolis dessins dans l''assiette directement, résultat convaincant : couleur et texture parfaites, goût original et bon, très peu sucré, et très peu "banané" ! Le meilleur moyen de récupérer des bananes trop mûres en quelques instants.', '2008-12-08T18:39:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 8c8595e5-6e86-4fd0-bfbe-0a05e2d8a8a2, 'Goût top, surprenant et tellement exotique... J''ai juste ajouté un peu d''eau.', '2008-11-11T13:06:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, c443af2e-37ea-4b13-8be0-37e6619a67af, 'C''est très bon accompagné d''un riz avec du poisson ou de la viande ! J''ai remplacé une partie de la crème fraîche par du lait de coco et un bouillon de volaille fait très bien l''affaire ! Si on aime, un peu de piment ça rajoute un petit "quelque chose".', '2008-06-30T21:53:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 7aa2c8c3-4cfd-49f5-80bf-328c567f3303, 'Super original, il manque un petit qqc mais je ne sais pas quoi... Perso je n''ai pas mis de crème (plus light) et c''est très bon!!!  A refaire sans hésiter...  ', '2008-06-16T13:15:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 82eabc2a-4c65-473d-acab-0980178aa2dd, 'Mon mari m''a dit qu''il avait l''impression d''être en vacances! Un vrai régal même pour les réfractaires au sucré-salé. Idéal aussi comme plat végétarien. Merci beaucoup pour cette recette!', '2008-06-11T16:57:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 543ac67b-bf88-4dec-adf7-30cd94ed223d, 'J''ai trouvé ce mélange (surprenant) vraiment excellent, la banane se font vraiment dans les saveurs avec le curry ; j''ai juste ajouté un filet de lait pour allonger la soupe. Tout le monde a aimé, ravie, merci ', '2008-04-11T22:35:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, edc1f9c0-a1de-4faf-87c4-a9d4605d92ee, 'Quel bonheur, ce potage!', '2008-02-26T21:53:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, dae150e2-2a94-490e-8671-abc48e754856, 'Bon. J´ai goûté la même recette avec des pommes au lieu des bananes sur le site et je vous la conseille car elle est encore meilleure!', '2008-02-05T15:33:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 86ac0a96-757d-46da-951f-566b6e5acfc5, 'Un délice, j''en ai même fait manger à quelqu''un qui déteste les plats avec de la banane! Rapide, facile, pas cher.', '2008-02-03T22:36:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 0f2497e6-481a-4755-9fc9-d458fffd7a2e, 'Un vrai régal! A faire et à refaire sans hésiter. J''ai, moi aussi, ajouté 50 cl d''eau pour la cuisson.', '2008-01-16T20:40:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 410d46ae-447d-4e79-9053-6d16e95c5971, '"c''est très bon" voilà ce que mon mari a dit dès la 1ère cuillerée. Je n''avais qu''un kilo de tomates alors j''ai ajouté une toute petite boîte de coulis. En fin de cuisson j''ai rajouté 1 petite banane. Mes garçons en ont mangé mais m''ont dit de mettre encore une banane supplémentaire la fois prochaine.(je pense que c''est à cause de l''acidité des tomates achetées en hyper et qui n''ont jamais vu le soleil...)Il y en avait largement pour 4 personnes. Une recette à refaire', '2007-08-31T20:53:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, ec7afbb6-c56d-4824-a195-b8c0471aa9d1, 'Génial pour les amateurs de sucré-salé! recette surprenante et originale, n''hésitez pas à l''essayer, pour la touche perso : un filet de lait de coco.', '2007-02-25T17:00:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 4453960e-6a8c-4965-8ca9-f3d8871d7f19, 'Facile à réaliser, vraiment nous nous sommes régalés. Idéal pour utiliser un reste de bananes trop mûres, j''ai ajouté un peu d''eau.', '2007-02-24T21:47:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, dfbd3626-7ab0-4b0f-be9d-27945effc75a, 'Excellent et original. Je l''ai testé en entrée puis en accompagnement de brochettes de poulet marinées (miel, herbes,coriandre...) avec du riz. Le mélange de saveurs est exquis. J''ai ajouté 50 cl d''eau. ', '2006-08-28T02:37:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 02502d78-91b8-4346-bb84-267bb9dad1cf, 'Excellent, suprenant et économique!!', '2005-10-23T15:56:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 254303ed-a8e1-408a-bf42-0c0c5a33cd6f, 'Vraiment délicieux! Je trouve qu''on sent juste bien le goût de la banane... J''ai rajouté un chouia d''eau pour une consistance plus fluide!', '2005-10-11T18:32:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 1ea0a1bf-749a-4c33-8852-6b4cf387ffa4, 'Cette recette n''a pas marchée pour nous! Servie à un dîner réunissant 18 personnes de 8 nationalités différentes dont une indienne...tous sans exception l`ont trouvée écoeurante :-( Quelle déception! J''ai pourtant suivi la recette à la lettre. Un vrai gâchis! ', '2005-08-15T22:11:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 288b8d88-52cb-4dee-8062-21aa2aa0205e, 'Mes copines ont été en extase, et en parle encore. Merci. ', '2005-07-11T23:32:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 43ca24b5-3be4-4fb2-bab3-8b6278c69fbf, 'Absolument délicieux! Rien à redire...', '2005-05-31T22:09:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 86242289-e69e-4fd1-a63f-71a41c58f9a1, 'Divin!! C''est excellent. Cela a vraiment plu à tout le monde... Merci!', '2005-02-08T00:54:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 16dfc4af-8803-4ea8-8ec8-abbc1f0f048b, 'Hyper bon !!! Mes invités étaient sous le charme, ils m''en reparlent encore.', '2005-01-28T12:45:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, f5a63cf1-ecd9-4a1f-b18f-6e703581ebf8, 'Extra facile à réaliser, merci.', '2004-12-26T18:56:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 6a6fd76d-7e9b-403f-8a53-8d6e8638cea6, 'Du bonheur à l''état pur. Merci pour cette recette!', '2004-11-14T23:06:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 47c245c5-410f-4169-ac25-73b93d5e5674, 'Je n''ai pas tellement aimé l''association... Dommage, l''idée était sympa!', '2004-11-11T12:55:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12520, 50363dcc-21f5-4c8e-aa71-217568c591ac, 'Très surprenant, très doux et le 3ème ingrédient (la banane) est introuvable. Pourtant les convives ont cherché... A refaire sans hésistation!', '2004-11-09T09:51:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45946, 27b101b2-f92f-426e-9b8d-65ba918b3446, 'Trop sucré mais le principe est super ! Je l''ai fait avec les fruits que j''avais en dernière minute : abricots, pêches, brugnons, pomme, banane (que j''ai mise un peu à la fin). Super ! A mettre dans la rubrique plein la vue ....', '2009-07-21T17:43:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45946, 4142aa9e-6e15-44ce-8c01-41065ef50157, 'Le contraste chaud/froid est saisissant!! J''ai utilisé du miel de lavande, du thym et ... de la glace au café!! La recette a frisé le 5 mais hélas miel + sucre cela donne un goût trop sucré qui gâche un peu la saveur des fruits . Mieler ou sucrer, il faut choisir!!', '2008-06-07T01:10:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45946, 88293c5d-bed4-4914-88ed-45b6b8f5a86a, 'Dessert très apprécié par mes invités, une petite remarque concernant la banane qui à mon goût est trop cuite, peut-être la mettre au dernier moment de la cuisson. Pour la gourmandise j''ai rajouté un coulis de chocolat chaud, délicieux. A refaire.', '2006-04-24T19:35:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21839, ce9a092d-6622-43f3-bbf3-10ed059cb24b, 'Délicieux mais j''ai arrangé la recette à ma sauce : j''ajoute un kiwi pour deux, ce qui donne un aspect plus fruité au milk shake, je remplace le yaourt par du fromage blanc a 0% ce qui le rends plus léger et onctueux, enfin je le glace 30 minutes avant de le servir. Savoureux, je le recommande à tous', '2010-10-06T14:45:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21839, bd7e9ea1-6497-4b2b-9de4-15f57d653385, 'C''est très bon, mais moi je supprime le yaourt, je trouve que c''est de trop, cela fait un peu trop de laitage. Sinon cela reste quand même délicieux et très rafraîchissant !', '2008-02-23T19:59:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21839, 304d2d2d-4359-47e3-a98e-530657c2fd3f, 'Miam miam, un vrai régal. A faire et à refaire!!!', '2004-07-07T13:55:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33803, 4ba97150-0815-4a6d-9819-2618b8090fa3, 'Très déçues ! Sur 5 nems réalisés, seulement 2 ont pu être mangés : 2 cuits à la friteuse qui ont explosé, sur les 3 cuits dans de l''huile à la poêle, 2 ont survécus grâce à une très courte cuisson...... en bref fondue aux fruits rouge très bonne.', '2009-11-12T23:39:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33803, 5d5c6f69-6854-410e-878b-ace78e6fc471, 'C''est long à faire mais ça en vaut la peine ! Pour que ce soit plus léger j''ai modifié la recette: en fait, j''ai fait des rouleaux de primtemps aux fruits, c'' est-à-dire que je n''ai pas frit les préparations, je les ai servies comme ça avec les coulis. C''est très bon et plus léger.', '2006-06-27T17:53:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33803, 56f6016c-78ac-45cb-8dca-5c1cf4ee3c8c, 'Merci cette recette a été très appréciée. Personnelement je n''avais pas de galettes de riz donc au cas ou on peut utiliser des feuilles de brick. Et faire cuire ces nems dans une poêle.', '2005-06-08T17:25:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33803, 3fbb3cf9-12e5-4771-9989-9948d1156483, 'J''ai fait cette recette aussi avec des la rhubarbe préalablement blanchie et des pommes. A la place de la vanille on peut mettre quelques gouttes de rhum. Par contre choisissez des feuilles de riz grandes et épaisses, parceque lors de la cuisson tout est parti dans l''huile!', '2005-06-02T17:18:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33803, c60b10bd-37f7-4b27-80f0-d2def83f9b61, 'Un dessert sympathique et original. Les nems sont assez faciles à rouler suivant les instructions données dans la recette, mais à mon avis c''est encore plus simple si on rabat les côtés dès le début, avant de commencer à enrouler la galette de riz sur elle même. Autre possibilité d''accompagnement : sauce caramel, éventuellement avec des noix ou des noisettes grillées.', '2005-01-14T10:50:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, 284f9d9e-5067-4ba0-a052-59b569c30af1, 'J’ai adoré', '2023-09-27T12:06:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, 533f3440-5314-4cdd-ba74-aee2331a3eb0, 'Très très bon !', '2022-11-12T16:07:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, 5f774be9-f697-4729-84df-a578fd1c4d61, 'Cette recette est succulente, merci beaucoup ! Je n’ai mis qu’une banane et rajouté 2 pêches, c’était encore plus succulent !!', '2022-07-15T17:49:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, 8e8fb850-0961-4347-a3ea-79c84e01cd60, 'Très bon !!! Mais à déguster frais.', '2022-07-09T18:42:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, 7b3480e5-8e3b-411c-89f6-d83ef7355a72, 'Très bon pour le goûter, le dessert...  Je vous le recommande fortement.', '2021-11-10T15:05:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, 85e4ddbd-233d-47f0-b5dc-793c6ab244a3, 'Trop bon !! ', '2020-04-27T18:41:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, e822dc84-3940-41bd-976d-1deac2795300, 'Super recette', '2017-05-07T10:53:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, 191d0c6d-8b92-4819-af69-e916a5183ae0, 'Très bon pas trop sucrée... Personnellement un verre bien remplit tient bien l''estomac ! on peut rajouter un peu de cacao ca relève le goût ', '2015-03-18T17:17:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, c6276c2e-d4ed-4923-9fc6-551773b845ba, 'Simple et rapide à préparer, ça plaît à tout le monde.  Je la fais au mixeur plongeant. J''ai ajouté des framboises au mélange une fois et c''était excellent.', '2014-10-12T20:24:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, d168e3d7-7e3b-4058-a10c-21a474ecbf78, 'La texture n''est pas vraiment celle du smoothie mais c''est un dessert simple, rapide et délicieux ! Pour ceux qui n''aiment pas le lait, il est possible de le remplacer par du lait de soja. ', '2014-04-13T17:45:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, 6278a9f7-3f56-488b-90e7-f7a18d0d056a, 'Bonne recette, ultra rapide et rafraîchissante. J''ai remplacé le yaourt nature par un yaourt à la vanille. Excellent !', '2013-05-01T18:20:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, 18d46a49-1d0f-4a70-a4a6-c673853785d5, 'Certes c''est bon et frais... mais pour moi rien à voir avec un smoothie qui doit être plus consistant et plus mousseux ! Il faut enlever du lait et ajouter du fruit je pense pour avoir un VRAI smoothie.', '2012-08-16T13:21:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, 46fb32f0-b791-4e03-bc21-c96e12977eb7, 'Délicieux après y avoir rajouté un soupçon de chocolat en poudre. Il vaut mieux diviser les proportions par 2 pour se limiter à un bon verre par personne. A boire très frais.', '2012-07-19T21:10:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, d7e7f12b-17af-474c-87e0-4389af8c41a7, 'Si on n''aime pas le lait comme moi on le remplace par du jus d''orange ou d''ananas ! Un régal.', '2012-05-22T20:24:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, f0e73593-b4c1-488a-985e-43200539ff55, 'Un délice ! Mousseux à souhait !', '2012-02-18T22:16:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, c18eba90-5c57-4f3c-8c1f-98c56e35724d, 'Très bon. Pratique quand les bananes sont très mûres.', '2011-07-20T18:30:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, 8e53346e-4867-4dc7-8fa3-4ac81fb5368b, 'J''ai trouvé ça délicieux, quoiqu''un peu écœurant. Je l''ai ensuite retestée en divisant les proportions par deux, de façon à en avoir un peu moins. Avec le miel, c''est encore meilleur que nature. J''ai aussi testé avec un peu de sucre blanc en poudre, car je suis plutôt du genre sucré !', '2011-02-12T16:12:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, 8fc4f25c-5ee7-4149-b8e7-b75421407c3e, 'Super, les enfants ont adoré !! Pour ma part j''ai mis un peu plus de lait...Sinon, rien d''autre à dire. A refaire surtout l''été, bien frais ! ', '2011-01-23T15:06:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65642, 396a5e02-934b-4c82-8ba3-b41913bf21ab, 'J''en fais depuis longtemps et c''est une excellente façon de finir les bananes qui noircissent.', '2009-06-20T14:06:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62382, 3ef6cf80-77c6-41ac-8d27-fe6a832ac633, 'Effectivement les cuillères à soupe de farine sont bien bombées et il faut 4 belles bananes bien mûres. J''ai remplacé le rhum par un peu de lait (trois cuillères à soupe). Cuisson à la poêle avec de l''huile de tournesol. Délicieux. ', '2017-02-24T16:55:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62382, 89c6dae7-a8bc-4aff-b737-9cf8e7d33314, 'J''ai fait un test avec quelques bananes bien mûres. Comme d''autres il m''a fallu ajouter de la farine, sinon les beignets ne se tournaient pas. A mon avis, il faut tester la recette plusieurs fois pour trouver la bonne proportion de farine à ajouter.', '2014-03-17T20:10:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62382, dead3123-ee8d-4ddc-bf68-917952294ea3, 'Cette recette à fait l''unanimité chez nous : elle est excellente !!', '2013-04-30T18:33:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62382, 5cf683cb-e64b-46c7-bde0-d5477361f817, 'J''adore ! Simple et excellent ! Merci pour cette recette.', '2013-03-01T22:15:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62382, fbd07896-756d-4a65-81a3-b9a739e57b87, 'J''y ai rajouté un sachet de levure,j''ai également remplacé le beurre par de l''huile de cuisson et rajouté 3  cuillères de maïzena pour aérer le tout, cela m''as pris 10 min de préparation et 15 de cuisson, un gouter express vraiment sympa. ', '2009-01-26T17:09:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62382, a6fbd382-3a4a-4a43-bb3b-25897c153ec5, 'J''ai pensé à rajouter un peu plus de farine( environ 4 cuilliere a soupe supplémentaire)sinon impossible de retourner les beignets, et surtout  j''ai fait l''impasse sur le beurre pour la cuisson et privilégié une cuisson à l''huile de tournesol.... mais sinon, à part ces éléments technique, cette recette est pas mal, simple et facile. Bravo!! ', '2009-01-12T11:57:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62382, 039fadba-012e-4b44-a146-1707b7f4144d, 'Je ne crois pas me tromper en affirmant que cette recette nécessite 4 bananes plutôt que 14... J''ai pour ma part utilisé 3 bananes bien mûres et 3 cuillères à soupes rases de farine mais cela n''a pas suffit. Les beignets étaient impossibles à retourner. J''ai par contre trouvé une recette similaire sur le net dans laquelle il est indiqué que les cuillères à soupe doivent être bombées. On peut utiliser du sucre vanillé pour la pâte (plus rapide que la gousse) et saupoudrer les beignets de sucre roux. Je referai cette recette en y apportant ces modifications.', '2008-07-30T15:33:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62382, 44cb8559-fd82-4f0e-a4bc-db330e7b66cb, 'Cette recette m''a rappelé toute mon enfance passée dans l''océan indien !', '2007-11-10T11:11:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62382, 01a710c4-0d0c-4045-ae27-fc8796665d7c, 'Avec cette recette du soleil dans votre assiette.', '2007-10-16T12:01:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62382, 4a57b92e-4f0c-4140-b9d7-94d6142eb871, 'Le petit plus du rhum de la réunion ça change de la recette traditionnelle des beignets de banane.', '2007-10-16T11:48:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 2e013312-4a0d-4398-a1b3-28a4c3337278, 'Excellent, la prochaine fois, je mettrai un peu moins de sucre', '2022-07-05T20:11:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, db1d031f-8a1a-438e-927c-bdfee0d61086, 'Très bon (j''ai du substituer la crème pour du yaourt)', '2022-09-24T13:45:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, ddb35fc0-58c9-4658-ada1-be1c584525d8, 'Trop bon ! J''ai suivi les commentaires et mis que la moitié de sucre. C''était bien suffisant. J''ai aussi ajouté des pépites de chocolat. Je n''ai pas de sorbetière, j''ai fait sans et ça a marché quand même.', '2014-09-07T22:12:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 6f868af9-98fd-4374-8463-3d541ec0f568, 'Sirop d''agave à la place du sucre... idéal', '2010-07-29T21:56:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 6febb352-d735-4a63-abbd-9977bba46375, 'J''ai remplacé le jus de citron par un jus d''orange. Absolument délicieuse, cette glace a séduit mes papilles. Merci pour cette recette aussi simple que parfumée!!', '2008-08-31T15:39:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, fd540667-ed48-4a4c-b06c-3c36f20b14c5, 'Super. Je l''ai préparée plusieurs fois et j''ai parfois ajouté de la pulpe de fruits de la passion. Excellent !', '2018-08-15T18:39:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, b989a8ab-75fb-4df5-ad56-25cec29df585, 'Délicieuse glace,  toutefois nous n''avons mis que 20 cl de sucre de canne et c''était encore bien sucré !', '2018-07-30T09:44:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 8c250d6e-a8da-46c9-b2c7-ae9ce060d381, 'Trop bon. 
Pour ma part j''ai rajouté un bon coup de rhum blanc.', '2018-07-24T07:07:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, e377fbba-539c-4f27-a6dd-f24c693b0f77, 'Top. Rien à changer. ', '2018-06-17T03:53:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 217ad089-69a4-4c68-83b7-4d3e2e71c3c9, 'Légère, crémeuse. Ne pas mettre trop de citron ni de sucre.', '2018-01-18T08:53:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, cb0bbd37-8f4b-462d-8053-94297b5869fd, 'Mon conjoint et moi n''avons pas trop aimé. Ni vraiment glace ni sorbet. Trop sucré.', '2017-08-03T20:14:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 27c709a4-97d5-48a3-abe1-a4ba6d1d7750, 'Très bon.  J''y ai mis seulement 12 cl de sirop de sucre de canne et remplacé la crème par 25cl de lait de coco un régal !   ', '2016-08-18T19:49:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 4a9b39e2-eb97-4f4f-81d6-3f7b5f7b4b08, 'Excellent et facile à faire. J''ai mis du sirop de canne. On a adoré.', '2016-07-25T20:17:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 3fda2781-12d9-4fc8-a48a-d3410cbad43f, 'J''ai ajouté des morceaux d''amandes caramélisées. Excellent..', '2015-07-29T18:26:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 2fe865cf-50eb-47ab-9ebf-cc521c453159, 'J''ai mis 10 cl de sirop de glucose de 40 g de sucre et d''eau, de la crème fraîche liquide allégée et cela a rendu une glace très onctueuse ! merci !! mon mari très difficile a beaucoup aimé !', '2015-07-14T17:31:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, db8c5f90-3042-4378-a038-2aa6d1852368, 'Recette suivie à la lettre et c''est juste une Tuerie !!! j''ai ajouté des petites pépites de chocolat pour les gourmands que nous sommes. On adore, un vrai délice pour les papilles !', '2015-07-13T13:07:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 8cdafef9-8ee5-4fc0-b569-4b8e90c84c92, 'Extra ! J''ai mis une cuillère à soupe de sucre et j''ai ajouté des pépites de chocolat dans la sorbetière ', '2014-08-11T18:00:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 8cd87735-7f27-4966-ac8f-e3def2d5088b, 'Un vrai régal, rien à dire. J''ai utilisé comme dans les commentaires 90 g de sucre avec 90 g d''eau pour faire le sirop et ajouter quelques pépites de chocolat qui se marie toujours bien à la banane', '2014-06-15T23:38:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 4fe434ee-70b5-4ca9-b281-285df0f86313, 'Pour ma part j''ai suivi les avis précédents, j''ai mis 120 ml de sucre de canne. J''ai fais une première fois en sorbetière et la seconde fois j''ai essayé de mettre la glace directement en petits moules silicone pour faire des parts individuelles. C''est une réussite, pas la peine de se fatiguer à faire des boules. Je démoule la glace, je la recouvre de sauce chocolat, quelques vermicelles de couleur et c''est la fête pour les enfants !!!', '2014-06-08T20:00:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 00562979-2e66-4424-a1c7-04ea2379a35b, 'Parfait et simple ! J''ai mis de la crème liquide et 12 cl de sirop de sucre de canne. ', '2014-06-04T13:00:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, f14cfa06-611b-44ef-9f0c-deaf24bee69a, 'Super bonne, très bon goût, à refaire !', '2013-09-25T00:24:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 79329d50-39c5-4c60-bcfa-459cfad9a9bd, 'Vrai goût de banane, bonne consistance.', '2013-06-26T17:39:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, e89de490-ac02-4093-8dba-a3b28114c75c, 'Très bonne recette, j''ai juste mis 6 bananes au lieu de 4 et c''est parfait !', '2013-06-17T15:29:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 0e93fb83-3eb4-4f56-9ecd-a24498ab8100, '5/5. C''est excellent, je vais faire des heureux !', '2013-06-17T14:30:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 1d95b94f-c4b2-4d24-8715-46160e3533fc, 'C''est tout simplement excellent, le vrai goût de la banane et l''onctuosité d''une glace. Mon mari est fan.', '2013-06-07T15:02:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, bd25be24-ae5a-4e98-b747-066565c8cbd6, 'C''est vraiment excellent ! Avec 90 g sucre et 90 g d''eau pour le sirop.', '2013-04-13T06:27:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 9473ac5f-11af-4820-8f3e-7fae327292fa, 'Excellente et tellement vite préparée, à faire et à refaire.', '2012-09-05T21:32:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, eb42eac5-6e03-41d1-9100-953d9c3cdc2a, 'Avec 200 g de sucre et sans citron... Excellent !', '2012-08-27T15:09:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 0239a041-85c0-4179-817c-8272870ab039, 'Très bonne recette. Je n''avais jamais réussi à faire une glace onctueuse avec ma sorbetière et là j''ai réussi ! Merci ! C''était vraiment très bon pas trop fort niveau goût et très onctueux un régal.', '2012-05-31T10:03:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 7b51fbbd-0ef4-431a-b19a-ffbb40f77607, 'Oh ! Merci... Cette recette est tout simplement excellente. Je n''ai mis que 90 ml de sucre pour 90 ml d''eau et c''est parfait. Le goût de la banane est bien présent et cette crème glacée est super onctueuse. J''ai ajouté le jus d''un demi citron vert. A faire et à refaire !', '2011-07-17T20:52:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, d5a1044c-e6b9-41b0-9b9f-4b2befda666b, 'Délicieux ! J''ai effectivement diminué le sucre (12,5 ml) ; j''ai mis de la crème fraîche liquide entière, 2 cuillères à soupe de jus de citron du commerce, le jus d''une demi orange, et un peu de cannelle en poudre. Directement au congélateur sans la sorbetière. Servi avec du chocolat fondu et des amandes effilées grillées... Hum, une tuerie !', '2011-05-24T21:08:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, a27b4c7f-7e12-4258-be05-2bf256cac253, 'Excellent elle a séduite mon homme', '2011-04-14T23:22:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 082c66d2-828d-4798-8bc2-8d2bec9de0d1, 'Très bonne avec une demie orange, 90 g  de sucre pour 90 g d''eau et j''ai ajouté des copeaux de chocolat juste avant de mettre dans la sorbetière.', '2010-07-27T09:31:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 69c6c07f-1bcd-4851-bfc9-f1a954840ae5, 'Excellente recette et très facile à réaliser. J''ai suivi les conseils des autres marmitonautes et j''ai mis moitié moins de sucre car les bananes étaient bien mûres et j''ai ajouté de jus d''une 1/2 orange. A déguster avec une glace chocolat, un régal !!', '2010-07-15T21:44:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 95a316e4-aaec-4bbe-bf81-6efd6c268348, 'Simple, rapide et très bon... à suivre à la lettre, à refaire !!!', '2010-05-26T18:46:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 4a2bde15-f5ea-4b13-9e1b-de8321a0175f, 'Tout simplement délicieuse et si simple !', '2010-03-29T11:31:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, ce52f365-8755-4568-91eb-29786eeef7b1, 'Merci pour cette recette simple, rapide et délicieuse : la glace a une texture agréable et reste bien blanche... Pour le sirop de sucre, j''ai fait fondre 90 g de sucre dans 90 g d''eau, c''était assez sucré à mon goût !', '2009-07-06T14:13:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, a79841af-70d1-4a58-9e25-c2c0e9d184e0, 'Super bon!Par contre il faut mettre moitié moins de sucre!!', '2009-06-20T01:47:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 919ffc3f-ad13-4f41-863f-11f46c8edfb5, 'Pas mal, elle est bonne.', '2009-06-02T18:02:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, f51a05d4-7190-474a-8e84-c1552346e5b3, 'Un peu trop de sucre', '2009-03-23T13:40:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 7b18a259-d269-45db-957d-f9e8d6807115, 'Cette recette est super bonne et super rapide à faire. Je n''aime pas particulièrement la banane mais cette glace m''a séduite. Je la recommande a tous!', '2009-01-26T10:31:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 67e4abb9-4bc9-49f8-b749-51ba37c62e02, 'Nous on a rajouté quelques pépites de chocolat et c''était vraiment bon. La texture de la glace est vraiment bien.', '2008-06-28T21:53:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 0210427b-c00e-45f7-9f0f-799dc9265ff8, 'Seulement 4 car effectivement il y a trop de sucre mais sinon c''est une délicieuse glace.', '2008-06-08T17:38:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 6a4f3aee-35a7-44be-99c9-5b12941bb114, 'Je fais très souvent cette glace, plésbicitée par les enfants. Par contre, je remplace la crème par la même quantité de lait concentré non sucré.', '2008-06-06T18:23:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 64c5875e-faba-4347-a7da-db072c7db8dc, 'Fabuleux, merci. Ma première glace fût une réussite !', '2006-05-29T22:24:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 11c6939b-dfc6-42c7-920d-e8ec86985f22, 'Cette glace est excellente, mais il faut diminuer la quantité de sirop de sucre, je n''en ai mis que 12 cl...c''est largement suffisant!', '2006-05-08T13:04:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 374ae0b8-209b-45e2-8d63-fb76d3fdc71f, 'Excellente glace!! Je n''ai mis que la moitié du sirop de sucre. A faire, à refaire et à déguster!', '2005-08-10T21:09:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 6edd8389-711c-4f63-aeb9-8a2033268a64, 'J''ai mis un peu moins de sucre, mais la consistance était très bien, et le résultat EXCELLENT ! ', '2005-07-15T23:22:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 8f42a49d-bf7c-4abb-8e26-3469a47e38e1, 'Excellente recette mais trop sucrée, j''avais pourtant diminué la quantité de sirop bref il vaut mieux rajouter le sirop très progressivement et goûter !', '2004-02-20T20:25:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 3f331aa1-fe18-4955-a734-671701f3341f, 'Très facile et rapide et ne gâche rien au résultat.', '2003-01-19T10:29:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, 3b5da97c-581e-41ab-994f-5a19429b81a1, 'Très bonne et très sucrée, je mettrais donc un peu moins de sirop. Il est par ailleurs tout à fait possible de préparer cette glace sans sorbetière en la plaçant simplement au congélateur.', '2002-05-28T12:13:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13516, af5df743-9c0c-43fc-a9a2-c5b7ef57a595, 'Très, très bonne.', '2002-01-15T10:48:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167436, 62358f54-d729-4b2d-a47e-755a3aa9b8ed, 'J''ai décidé de faire un gros crumble, vu que mes ramequins étaient d''un nombre limité. Par rapport au goût, sucré mais fruité. J''ai bien aimé, sincèrement ! Le seul hic est que vous avez fait une erreur dans la recette, répétant le sucre deux fois. C''était un peu mélangeant, mais j''ai deviné que c''était la farine. La cuisson a duré plus longtemps aussi... Petit filet d''eau à ajouter.', '2017-01-21T15:46:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32532, bfe91d7e-d892-4cdd-afe3-4bd45970117a, 'Cette recett est bonne. On peut remplacer le sucre vergeoise par du sucre normal.', '2005-11-06T16:46:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32532, b06bf21b-d442-41d3-905e-b1509a5cfa43, 'Pas de bonne ni de mauvaise surprise, pour un résultat honnête. Tarte très simple à réalise, assez lourde cependant.', '2005-05-03T12:24:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48864, 712476d7-3d19-4557-b8fe-191a6144d6bb, 'Excellent, doux, crémeux. . Vraiment parfaite idée de dessert rapide. Je n''ai pas rajouté de sucre mais c''est personnel. La banane était déjà très mûre donc bien sucrée.', '2020-10-05T23:17:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48864, 67f049fb-790a-4a68-ae7a-ea628b3c96e7, 'Très agréable, doux, frais ! un dessert léger au top', '2015-03-02T21:07:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48864, 8a8f89c4-98d3-4f4e-b5f0-490c43fef876, 'Doucement sucré, délicieux !', '2014-05-31T16:52:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48864, d68d5ae2-4ab8-4d54-8533-35c3217caa63, 'Délicieux, frais et très rapide !! Je l''ai fait avec d''autres fruits (pèche puis fruits rouges), et c''était toujours excellent ! On peut ajouter un blanc d''oeuf battu en neige pour obtenir une mousse ! Et avec des biscuits à la cuillère (trempés dans du lait) au fond, c''est encore meilleur !', '2012-08-13T21:37:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48864, 4db465ce-ef20-43a6-9758-17fcaf94ce90, 'Délicieux! J''avais pourtant une petite appréhension, le tofu soyeux nature n''étant pas spécialement appétissant. Mais le dessert est vite fait, excellent et léger.', '2008-06-26T09:14:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48864, 63cd2ad8-65dc-45e8-9f14-0b1df9be525a, 'Bonne recette. Pour les gourmands, un sachet de sucre vanillé, 1 banane supplémentaire et un peu de 4 épices pour parfaire cette crème très rapide à réaliser.', '2008-04-16T20:59:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69944, 291e6c77-cdab-4993-9601-101cc12c2ade, 'Excellent en sauce avec à peu près n’importe quoi. Je le fais avec des bananes plantain et de la farine de manioc directement quand je suis pressée. ', '2020-01-05T13:47:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54164, 5d5a370d-72f8-41e2-b1b9-5aaf9f3b4b47, 'La 1ère fois, je l''ai fait avec des bananes. Ce soir, avec une pomme et une poire, un délice !!! Par contre, même commentaire, pas assez de lait ! Il faut au moins 30 cl pour avoir une belle pâte. Démoulé à l''envers après 10 min, le pudding était beau à regarder. A refaire sans hésiter !!!', '2013-05-30T23:27:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54164, 20167e49-b900-4199-8674-65a12d80c326, 'Première recette complètement ratée issue de Marmiton, je l''ai pourtant suivie scrupuleusement !  Ce n''est ni fait ni à faire ! ', '2013-02-17T10:52:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54164, 4549dddd-7cae-48bd-af30-20d48acc9c84, 'Consistance étrange, même en doublant la dose de lait... A éviter ...', '2013-02-09T20:50:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54164, 876596f9-93ed-4fb5-b365-4cc92f0e3aab, 'Bonne recette. J''ai également doublé la quantité de lait, j''ai ajouté un peu de rhum pour aromatiser la pâte. Pour le sirop, je n''avais pas de cannelle alors je l''ai remplacé par du sucre vanillé et un peu de miel et je le verse sur le pudding à fur et à mesure de la cuisson.   En tout cas on m''a demandé de le refaire. ', '2013-01-30T04:00:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54164, 309f6b1a-5ce0-4e98-b95f-279c760ebd35, 'Pas un grand succès chez nous, collant,  sec et trop sucré', '2013-01-26T14:00:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54164, 901af96c-e415-4b73-9f71-0e6b771a34ec, 'J''ai testé, je n''ai pas du tout regretté ! J''ai également suivi le commentaire de Valérie...Certains de mes invités ont trouvé que le gâteau (hors sirop)manquait de sucre; j''ajouterai alors peut-être des raisins secs (ça va bien avec les bananes)et pourquoi pas un peu de rhum dans la pâte... Avec modération bien sûr.', '2013-01-19T21:06:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54164, d5b31bb0-05fe-4bfb-8629-d1c2c5e35e54, 'Délicieux et "cros bon" comme disent mes petits enfants. J''ai suivi le commentaire de Bene70. Et je trouve pour ma part qu''il est même meilleur le lendemain.', '2013-01-15T18:43:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54164, 4600344b-c4f6-433a-ad3c-c93024fe1da0, 'Délicieux ! J''ai suivi le commentaire de Valérie et modifié un peu la recette. J''ai doublé également la quantité de lait. J''ai fait cuire sans le sirop. A la sortie du four, j''ai laissé le gâteau dans le moule et je l''ai piqué avec un cure dents. J''ai ensuite fait couler le sirop dessus jusqu''à ce que le gâteau l''ait absorbé presque en totalité (une bonne demi heure). Je l''ai ensuite démoulé avec le reste de sirop non absorbé et nous nous sommes régalés ! Merci pour l''idée !', '2012-02-13T20:31:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54164, 2d689eee-8c23-4774-891f-3fefec28683c, 'Désolée, à mon avis, il y a un gros gros problème dans les proportions !!  Farineux, dur, excessivement sucré ... pourtant c''est dommage car il avait l''air bon !', '2010-06-06T23:05:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54164, 120e2f10-d753-4b4d-bdec-5c464c404224, 'Effectivement, ça manquait de lait. J'' en ai donc doublé la quantité. Par contre, je n''ai pas ajouté le sirop avant cuisson, mais j''ai réchauffé du sirop d''érable que j''ai versé immédiatement à la sortie du four. J''ai laissé imbiber avant de démouler. DÉ-LI-CIEUX !!', '2010-06-03T16:18:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54164, 393e0a05-70c6-4f06-a839-ff520f212eee, 'J''ai essayé hier soir, je me suis peut être trompée mais je crois qu''il y a un problème dans les proportions, ou nous n''avons pas le même plat à tarte ou le même verre doseur... 12,5 cl de lait me parait trop peu, trop de sirop, trop sucré et texture de la pâte étrange et au goût, si vous avez la solution je veux bien, ca m''a l''air tellement bon :) ', '2007-03-26T13:26:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331208, 282de87e-b22e-4bc7-b4bf-4e96b45bfaa9, 'Simple bon et facile ! Juste délicieux et très très frais ! Rajouter des glaçons et la cannelle n''est pas obligatoire.', '2015-06-22T17:08:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44641, 2a4a4b19-0df6-4d36-a6e9-50bb22f0b94b, 'Un vrai délice je l''ai fait avec une pâte sablée.', '2016-11-08T15:37:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44641, b9a39dc3-2769-4cfc-9d68-343cc15cacf4, 'Cette tarte est originale et adorée par les enfants ! Par contre, j''ai utilisé une pâte brisée pour cette tarte et je n''ai ajouté les raisins secs que 5 minutes avant la fin de la cuisson et ils étaient presque carbonisés (je conseille donc de les mettre quand la tarte est cuite ou sous les fruits dans la compote).  Pour mon four, la cuisson est de 25 min maximum à 200°C et elle était parfaitement cuite. Merci !', '2014-04-19T16:48:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44641, a78da0fd-905a-43a8-862e-a329b7397b84, 'Super, le top des tartes', '2012-11-09T07:55:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44641, 7015722d-869a-4b71-a1da-f61c2e7fd67b, 'Cette tarte est très moelleuse - une cuisson de 25 min aurait suffit', '2007-10-14T20:16:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44641, ea32cf33-27a1-46ff-ae74-a4df1fa8fda5, 'Je l''ai faite hier, elle est très bonne. Je conseille également de mettre une pâte sablée plutôt que feuilletée. Et puis, rajouter les raisins secs après la cuisson, ou à la rigueur en fin de cuisson pour qu''ils ne soient pas carbonisés. Bon appétit!', '2006-03-01T12:47:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44641, 60a1a07d-ebfd-43e6-86fe-cc0ee51f6a08, 'La tarte serait meilleure avec une pâte sablée.', '2006-02-16T22:10:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 0102f158-83e7-4239-9a72-85d854f4b3ca, 'Très bon gâteau à première vue mais j’ai quand même fait plusieurs modifications
Attention à la cuisson , plutôt 35/40 minutes à 180 degré sinon brûlé!
Pour un rendu plus léger j’ai mis moitié farine de blé et moitié maïzena, montez les blancs en neige mis moitié moins de chocolat et 50 g de sucre de roux suffisent largement car les bananes (écrasées et mélangées à l’appareil) sont très sucrées puis juste rajouter une cuillère à soupe de rhum pour encore plus de goût. 
Bon appétit ', '2021-11-18T14:12:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 05890405-5cb3-43f4-ba2c-19b74094af12, 'Suite à la lecture des commentaires, j’ai mis moins de sucre et l’ai fait cuire 40 minutes à 180 degrés et c’était excellent !! À garder !', '2022-09-20T10:35:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 49357af3-add0-4f1d-9128-26bb562fafc2, 'Super bon! Je pense qu''il faut suivre les conseils cuisson des autres membres par contre car 250 degrés ca fait bcp .. il etait un petit peu cramé sur les côtés ', '2023-01-25T16:08:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 9bb28cf2-d5f6-4f6e-83b5-1c68a15f9de8, 'Délicieux, rapide et facile à faire', '2022-02-26T15:29:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 9a658db6-dab6-4da1-adee-208cc5c8604a, '250 degrés c''est beaucoup trop ! ', '2021-12-29T17:01:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 52ede1fc-2030-4e39-a80b-7cbc764c8629, 'J''adore cette recette ! A chaque fois c''est une réussite et on se régale !
Je ne mets que 30g de sucre par contre et c''est tout aussi bon !
Recette approuvé et refaite des dizaines de fois. ', '2021-11-07T17:06:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 2b3e184a-bcfe-4550-bb21-ab0d194286f2, 'J''ai personnalisé cette recette en mettant de la cassonade au lieu du sucre, 50 g de Maïzena et 50 g de farine, de la vanille liquide et les autres ingrédients. J ai beurre ma tôle j ai mit une 1er couche de bananes et rajouter la pâte et deuxième couche de banane. Ma famille a adorée. Vite et facile à faire', '2021-02-22T14:11:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 4c5295fb-e4c6-48d0-b0f4-9f45772c5da5, 'Top', '2020-04-03T16:33:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, ba5d88d6-93f4-420e-bf70-c7c5508365e8, 'Ma nouvelle recette de gâteau favorite !
Je met 2 bananes dans la préparation car je suis une gourmand ?
Rien à dire, très bon ! ', '2020-03-10T21:24:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 1f0ffac6-9cef-41a6-9bdf-edc1b77ab13d, 'Très bonne recette effectivement. Personnellement 15 minutes à 200 degrés dans un four à chaleur tournante suffisent.', '2019-08-14T06:16:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 0d6c6f8b-c57c-469b-b911-95402898eec1, 'Simple, rapide et tellement bon.
Je l''ai fait avec moins de beurre et ce fût dévoré à 2 en quelques minutes seulement.', '2019-06-20T11:18:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 9424bde8-cc5c-4f1d-a481-aa3a72ec256b, 'Excellent ! J''ai doublé les proportions pour un moule de 26 cm avec une tablette de 200 g de chocolat noir coupée en pépites. Je beurre le moule puis ajoute un peu de cassonade au lieu de la farine, je pose dessus  2 bananes en rondelle, puis je verse l''appareil. 
Pensez à retourner le gâteau légèrement refroidi.', '2018-10-27T13:40:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 1df4114c-5cda-41fb-bbe5-82478306048f, '250°C pendant ne serait-ce que 10 minutes = gâteau carbonisé noir non pas de chocolat mais de brûlé.
Merci pour ce gaspillage ça m''enchante au plus haut point super gâchis... ', '2018-05-20T11:59:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 8d858be6-5669-4f91-b097-a7269593ac66, '250°C de cuisson pendant ne serait-ce que 10 minutes = gâteau carbonisé noir non pas de chocolat mais de brûlé.
Merci pour ce gaspillage ça m''enchante au plus au point super gâchis... ', '2018-05-20T11:58:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 34e1688b-3cb0-485b-8d81-c961f7dd36b0, 'J''adore cette recette je la fais souvent. J''ajoute 1 oeuf en plus et je met environ 200 g de chocolat environ, ce qui donne un croquant au gâteau vraiment excellent !', '2018-05-19T10:21:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, ccb347ab-ec18-42d9-8c08-8c416d3a903a, 'J''ai doublé les quantités (pour un grand moule) sauf le beurre... Très moelleux ! Je referai sans hésiter !', '2018-03-25T17:19:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 4c37f25b-991f-46b4-b943-168720811cc6, 'Super recette mais ajouter 50% de tt les ingrédients pour 6 personnes et cuisson à 180° pendant 20-30 minutes...', '2018-03-24T08:57:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 63ad3e19-80c7-423d-9b8c-7c7bcdba17c5, 'A la température indiquée j''ai eu un gâteau brûlé à l''extérieur et pas cuit à l''intérieur, à réessayer en changeant le thermostat. ', '2017-05-22T09:09:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 064ac87a-c773-4d53-8c60-69719018bf94, 'Super bon! Encore meilleur tiède ! J''ai remplacé les pépites par des morceaux de barres Kinder (200 g), j''ai mis 3 gros oeufs, 120 g de farine, 4 bananes dont 2 pour le dessus et cuisson à 250 degré pendant 15 min puis 5 dernières minutes le four éteint.', '2016-07-21T22:43:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, fc2a01bf-deda-4c63-975a-e218fc47c1b8, 'J''ai cuit le gâteau à 180° pendant 30 à 40 min je sais plus trop mais j''ai piqué dedans pour être sur qu il soit cuit, écrasé toutes les bananes et le gâteau était delicieux. Il avait un peu caramélisé ', '2024-01-28T23:09:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, e564dadd-919b-4ad3-a925-f5d7605979f7, 'La recette délicieuse cependant les indications de cuisson sont à peu près mauvaise il faut cuire 45 minutes à 200 degrés celsius et puis recette est imprécise exemple et ils indiquent qu''il faut une tablette de chocolat et dans la recette ils disent un paquet chocolat', '2023-09-30T13:44:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, a582b5f8-ede0-446e-ab37-25394511e180, 'Très bon gâteau ', '2023-04-29T10:03:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 1a764601-3425-4de9-b64b-696d7af1aa3a, 'Parfait !', '2022-12-09T17:10:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, abb1b2a6-a186-4918-81c1-1d28220fb12d, 'Délicieux ! 👌🏻', '2022-10-02T16:19:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 651bbf8e-6263-4a97-9551-0192c6caaf95, 'Préchauffer le four à 250 degrés... beaucoup trop chaud ! Soit j''ai mal compris soit il y a une erreur car mon gâteau a totalement brûlé... je referai avec une cuisson beaucoup plus modérée...', '2022-07-03T19:26:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 98aab308-8c37-41b7-8034-d28e366c8c4b, 'Sympa à préparer j''ai ajouté un p''tit coulis chocolat', '2022-07-02T23:34:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, c00ea483-106d-41f3-97c1-13e77274f2fc, 'Absolument délicieux !', '2022-05-24T12:47:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 0f74fdc9-196e-44b6-b74e-298048bd17c7, 'trop bon et simple !', '2022-04-07T11:32:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 9f518567-4b4b-45a6-9d1b-f8f8b9857e14, 'Très bonne recette. J''ai mis moins de sucre et c''était parfait.', '2022-04-03T21:18:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, fb9ce4f9-b0c5-4184-ac9f-ba8802cb099b, 'Avant de verser ma pâte j''ai saupoudré le fond de mon moule avec de la cassonade 👍', '2022-03-09T11:36:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 9808bcc2-b99a-43ee-bfb2-d9a15980b5a6, 'Ravi de cette recette. gâteau moelleux, tendre, goût savoureux... Il met tout le monde d''accord. Néanmoins, déçu (cannelle), j''aimerais revoir la recette d''antan.', '2021-07-01T17:08:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 670a8c6d-1afd-4fb7-8852-bcd5ce898e89, 'Facile et bon', '2021-03-19T17:37:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 446f8865-4460-4b9e-9896-55a05ea30e88, 'Recette simple et délicieuse, réalisée avec une seule banane bien mûre intégrée à la préparation. J''en ai fait des petits gâteaux dans mon moule à muffins. À refaire sans hésitation !', '2021-01-06T08:26:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 01d9c27b-6986-440e-8c7e-652600479991, 'Excellent et rapide... Tout le monde adore !', '2020-11-01T17:26:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 3cdf35b1-f36f-49af-993c-b8f8ed7fb215, 'Un classique à la maison ! Les proportions sont un peu justes, du coup on multiplie par 1,5 et comme on est des gourmands on remplace les pépites de chocolat par une tablette de Pralinoise grossièrement hachée. ?
Pour la cuisson, il faut surveiller mais le four chaud permet d''avoir un gâteau bien croustillant et moelleux. ', '2020-10-19T18:21:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, e2a1d9c7-2215-4d68-94b4-de7a28c4bd94, 'Un classique à la maison ! Les proportions sont un peu justes, du coup on multiplie par 1,5 et comme on est des gourmands on remplace les pépites de chocolat par une tablette de Pralinoise grossièrement hachée. 😋
Pour la cuisson, il faut surveiller mais le four chaud permet d''avoir un gâteau bien croustillant et moelleux. ', '2020-10-19T16:21:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, f94436c9-22cf-460c-97cb-30ee1fcf8508, 'Le dessus de mon gateau a cramé, et l''intérieur n''est pas cuit', '2020-08-04T18:44:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, ad67cb04-ac09-44f9-8585-560ad684e496, 'Très bonne recette ! C''est devenue le gâteau phare de la maison !
Je met cependant 2 bananes dans la preparation au lieu d''une.
Et je ne met qu''un demi paquet de chocolat. Cets largement suffisant à mon goût. ', '2020-04-13T20:48:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, d61e13a5-8fc8-46ac-9db5-0d3484aa5a4d, 'Délicieux, adultes et enfants ont adoré.
Quelques modifications apportées : 100g de chocolat fondu au lieu des pépites
15min 250°C, 10m 180°C.', '2020-02-26T05:05:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, d38f5b46-13b1-4918-ba4f-5ea6cb203a04, 'Très bon ?? avec un peu de beurre et de sucre.', '2019-12-22T06:58:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, bddf4718-7d41-4304-b177-8c593ffbf430, 'Très  bonne recette que je réalise depuis des semaines / années. Faire attention à la cuisson. A manger tiède ou même réchauffé quelques secondes au micro onde.', '2019-07-15T18:39:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 868348c8-7cfd-4d17-8010-e11ba65159c7, 'Très bon gâteau. Nous l''avons réalisé en utilisant des grosses pépites en mettant moins de beurre et moins de sucre.', '2019-06-10T16:08:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 0aa60da9-9e2c-4f48-840c-b7bd80ed0685, 'Excellent et apprécié de tous. À refaire', '2019-05-25T13:04:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, b35bc96a-2b06-49ba-a6b7-6200c5701043, 'Excellent, merci pour la recette.', '2019-05-20T10:18:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 0a8bd47f-09bc-4216-a772-5ef608490104, 'Très bon gâteau. Tout à fait excellent sans le chocolat et avec un tiers voire moitié moins de sucre.', '2019-04-27T11:43:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 22d8dea1-bd29-4940-bb0b-da167622b8d8, 'Fait sans chocolat, servi tiède avec de la crème anglaise.... un régal!!', '2019-03-30T06:27:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, d38546de-1c28-4b6e-9517-074f0f403b00, 'Super, même pour faire des muffins. J''ai mis 80g de beurre et 50g de sucre et 25 g de cassonnade', '2019-01-30T05:35:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, dd4da3be-00e9-4b54-97ba-1382251423ea, 'Excellente recette ! Testée avec 40g de sucre roux, 50g de beurre et en incorporant les 2 bananes coupées en rondelles directement à la préparation. Four à 200 degrés, pendant 10min + 5min avec le moule couvert d’une feuille d’alu percée pr éviter que ça crame.', '2019-01-01T13:06:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 770902ef-7446-47f0-be08-57ce4996517c, 'Attention si vous avez un four à chaleur tournante 200°C suffit et cuisson à surveiller de près. Sinon très bonne recette.', '2018-12-16T11:32:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 1bf6231a-37a7-44f5-9bdd-85c1394ef49a, 'Gâteau excellent ! Mais un peu gras, la prochaine fois je testerai avec moitié moins de beurre !', '2018-11-04T08:36:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, a699df49-d99a-446c-adc9-34f7f7d40d11, 'Recette réussie avec quelques modifications : ai ajouté un oeuf et laissé cuire à 200°C pendant 40 min environ. Mes pépites de chocolat se sont également retrouvées au fond mais c''est quand même un régal !', '2018-10-23T08:24:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 5a7423f0-311d-4e87-9c42-59a27fc90ac7, 'Excellent !', '2018-10-17T18:43:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, e9680640-dccd-41cd-8c1c-1dd446077645, 'Parfait !  !', '2018-10-15T22:52:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 61f75530-0368-4d6f-9101-2dc5dc3e8383, 'Super gâteau !', '2018-09-27T07:28:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 69f1a683-0417-4f79-abe2-18f38afbea4f, 'Addictif !', '2018-09-12T16:44:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, ec905709-bc44-446b-8816-d888686dab56, 'Parfait !
Bonne proportin bananes/pâte !', '2018-08-27T13:05:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, fd4d0cbf-db04-4c10-952d-bd563da40419, 'Cool ce gâteau.', '2018-07-22T04:03:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 9e2db425-42c5-4750-99cc-be7aec9f79e0, 'Alors sur ma version je n ai pas mis de pépites mais j ai fait fondre du chocolat noir environ 100g, et j ai enfourné a 200°C. Le rendu est vraiment délicieux.', '2018-07-14T11:37:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 26727b49-4722-42c3-8b52-adcb82f20c7d, 'J’ai fait avec ce que j’avais : pas de petites de chocolat et j’ai mis du lait de coco car je n’avais pas assez de beurre pour doubler les quantités. j’ai mis un peu plus de farine (250g au lieu de 200g) car la pâte était plus liquide du coup. Ne pouvant manger de sucre j’ai mis un peu de sucralose et de la vanille saupoudrée dessus. Bref j’ai quand même bien torturé la recette qui était quand même à tomber par terre. Merci pour les conseils cuisson (30min 180 degrés). Pour ma part j’ai dû pousser plus le timing (40/45min) avec mon mini-four sans chaleur tournante et ma recette ajustée. Super recette, délicieuse et que de bons conseils ici, merci !', '2018-03-08T11:57:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30931, 9874f4a8-9e7d-4333-a423-12a0c0f7710b, 'Ce gâteau est simple à faire. J’ai suivi certaines recommandations pour la cuisson donc 30 mn à 180º. Il ne faut pas utiliser un grand moule sinon vous n’allez pas le remplir. La prochaine fois je mettrai un peu moins de sucre car la banane sucre déjà pas mal. Mais même en gardant les proportions originales ce gâteau est très bon !', '2018-03-04T02:49:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, a856389b-da34-4628-b000-510c16baecb8, 'Très bien. J’ai mis moitié farine moitié maïzena, et quelques pepites de chocolat. 
Belle couleur dorée, moelleux. ', '2022-10-26T09:21:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, bb4e4fce-6d0a-4464-a9f4-e50e384eb976, 'Super bon ! Très moelleux, une tuerie ! ', '2022-07-20T22:29:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 2ac81e6b-88cf-4048-9fe7-7ee55e0db958, 'Simple rapide et efficace je le fais régulièrement ', '2022-04-23T11:24:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, bce05aab-aecb-4311-b7ff-9efa5d419825, 'Excellent, j''ai remplacé les pépites de chocolat par un couche de pâte à tartiner au milieu avant cuisson et une autre sur le dessus après cuisson. 180°C , chaleur tournante, 40min.', '2021-10-21T07:00:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 200fed22-91b2-4367-8a97-12d49e658b85, 'Trop bon et super facile !! J''avais jamais goûté de cake à la banane avant donc je peux pas comparer mais très satisfaite du résultat. ', '2021-06-01T01:55:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, fd903026-52d2-40b2-8f68-c8b6debfbb52, 'Dans la recette il n’est pas indiqué quand ajouter le sucre vanillé je présume à la fin mais je n’ai pas l’habitude j’aime suivre la recette à la lettre ', '2021-01-06T10:32:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, bd2e333c-08b7-4473-b2ce-120a5f3bdbe5, 'Très bon, je recommande. ?', '2020-11-20T19:05:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, d3b8ad4c-e492-4839-93c1-61f9d1a59643, 'Excellente recette. Cake très moelleux ?', '2020-11-14T16:22:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, f6444b5c-c890-4ed3-a37f-f404c11f8413, 'Très bonne recette j''ai réduit la quantité de farine, suite au commentaires, je n''avais pas de pépites de chocolat, j''ai pris une demie tablette de chocolat et j''ai couper des tout petit morceaux et hop là ? j''ai garde un peu de chocolat de côté pour le faire fondre une fois le cake cuit et froid j''ai verser sur le cake 
Miam miam ?', '2020-06-17T16:31:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, f52892ca-6f12-4418-8d1a-f0244e7c7fd7, 'Très bonne recette ! ', '2020-05-01T19:14:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, dc72d4a7-8019-470a-866a-e5c8b59d435f, 'Recette parfait merci pour le partage . :)', '2020-04-13T17:20:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, fd8d26ec-ca3b-485f-b03b-a614c367821b, 'Excellente recette', '2020-03-28T16:52:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 56c76951-f343-40fa-bc9a-02d4da48809b, 'Excellent ! J’ai mis un peu moins de sucre et beurre qu''indiqué.  À refaire.', '2020-02-19T03:56:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, f58deba5-e0b2-4527-840b-219b80d68c7f, 'Cake trop sec ! Je pense qu''il faut moins de farine... 120 g au lieu de 200 serait mieux.', '2018-11-29T03:24:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, ffdabe48-2ec6-4363-b934-2fbe0c067373, 'Excellent ! Tout le monde l''adore :-) 
Ce cake est léger et n''est pas sec du tout !
Je le recommande fortement ;-) ', '2018-09-11T04:24:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, a085a4f7-8068-4ce4-9023-c37fbebacf49, 'Recette suivie à la lettre juste un peu de rhum et excellent ! ', '2017-01-22T16:41:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 5f8b16a5-da13-4db0-9aaa-5f825196c3a6, 'Bonne recette (suivie à la lettre) - cake bien moelleux, tout le monde a bien aimé.', '2016-08-15T11:14:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, b36b7da8-be5a-4d95-a3d2-73e43077bb54, 'Très bon, tout le monde a aimé. J''avais un peu peur que le goût de banane soit écoeurant mais pas du tout. J''ai mis un seul sachet de sucre vanillé et ajouté une cuillère à soupe de rhum.', '2015-09-26T16:45:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, ec28a281-b7e2-4407-9bae-085a27570d55, 'J''ai ajouté 2 cuillères à soupe de rhum, ce qui le rend très moelleux. Un délice !', '2015-06-18T20:21:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 3128a34d-b016-411e-a7de-76ea0c3286d6, 'Excellent nous nous sommes régalés, j''ai rajouté 1 banane coupée en rondelle fine et mis 1 seul sachet de sucre vanillé ', '2015-02-26T22:08:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, a728ae7d-19be-4268-b022-858959a04067, 'Excellent ce cake ! Je n''hésiterai pas à le refaire. Merci pour la recette', '2015-02-06T11:07:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 6e6450e8-f4cd-406b-99e7-68f817b07a2c, 'Excellent ! J''ai suivi exactement la recette tout le monde s''est régalé et en redemande !', '2014-10-18T23:39:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 949cee19-dd10-4547-af4b-8144fcb0c0ca, 'Excellent !!!', '2014-06-24T19:31:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 6bd4b86b-2686-4c31-a421-45a4a755c52f, 'Excellent ! Je l''ai fait et refait, et les commentaires ne sont que positifs !', '2014-05-07T03:17:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, d43a8f33-a1ae-434e-b387-e83657070764, 'Ce cake est devenu un classique familial pour les goûters.', '2013-08-20T16:30:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 51cb41e8-34c6-42d8-9b74-6d1c16bc934b, 'Très bon.', '2013-02-13T20:46:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 4159c1b6-c713-4d94-938c-6d6cedec07e8, 'J''ai suivi a la lettre la recette et j''ai pas aimé... Est ce que les bananes étaient trop mûres, ou le chocolat a pris le dessus...', '2013-01-17T18:16:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, a0e3e48b-aca8-453b-8a05-b8c3ec36bd4c, 'Délicieux ! Mes invités ont adoré !', '2012-09-30T15:38:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 2a7b0f1a-8d20-4ab9-ac26-acab9eaa7129, 'Rapide, facile, excellent pour le plaisir des petits et des grands !', '2012-09-19T11:59:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 04a29bec-4c10-4c13-93f6-a7f5b293d9a6, 'Fait avec les enfants qui se sont bien amusés à écraser les bananes, et le beurre + sucre. Et une fois cuit, le cake n''a pas eu le temps de refroidir ! Donc en deux mots : FASTOCH'' et MIAM ! ', '2012-05-23T15:37:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 524a96b6-2340-467b-8b01-6e13a1cd440a, 'éviter les bananes trop mûres car elles prennent le dessus sûr le chocolat et ajouter plus de chocolat ', '2012-04-10T00:47:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 19e2e25e-76e9-4f0a-bb2b-0547a35e6d48, 'Très bon, excellent, moi j''ai mis du chocolat noir que j''ai coupé en petits bouts à la place des pépites. ', '2012-02-09T18:51:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, d9f42efc-4cae-4161-a3f1-cdb1061518c2, 'Mon p''tit bout de 3 ans en raffole, il m''en réclame un tous les jours !!! Merci pour recette facile et délicieuse.', '2011-06-09T15:50:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 67bbefec-6a07-4fca-b52d-a10383744be6, 'Ce cake est une merveille et il est meilleur quand il est tiède. Merci pour la recette.', '2011-05-28T10:13:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 84be5cce-c6f5-41f0-b8fa-4ac442bc0784, 'Trop bon !!!', '2011-05-14T21:49:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, f2d3adff-f2c8-4abb-8f2e-b07988f66248, 'Tout simplement délicieux !!! Ma fille m''en réclame toute les semaines.. Pour un gain de temps optimal, je place tous les ingrédients dans ma machine à pain et hop !! Au four !! ', '2011-01-23T16:41:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 25a2318a-ea8a-4be1-9107-ac3183f73081, 'Facile à faire et très bon ! A recommander (et à refaire) !', '2010-09-18T22:26:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 627fdeed-a5ef-4369-9c00-bd3431899f3e, 'Tout simplement super bon, pas sec, merci d''avoir partagé cette recette. J''y ai juste rajouté un peu de rhum', '2010-06-20T20:53:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 0144c540-2393-40df-a09c-db5cd9cb08d8, 'Excellent et très facile à réaliser ! Moelleux, pas sec du tout, tout le monde a adoré. Préférer des bananes bien mures pour plus de goût et 60 g de chocolat à dessert coupé en morceaux (pas émietté) suffisait! ', '2010-03-21T11:39:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 44db180e-944c-4bef-b096-2eb6b2e946fb, 'J''ai remplacé le beurre par de l''huile de pépin de raisin (60 g). ', '2009-12-20T19:23:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 811f3b0a-13cf-4c8b-ae32-3d345b93c6db, 'Miam ! La recette est parfaite et facile à réaliser. J''ai mis un peu de rhum aromatisé à la vanille pour parfumer, un régal.', '2009-09-18T22:08:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, d30c3b10-7a9e-4079-ac92-0a790bf83897, 'Un vrai délice, très moelleux et pas sec (comme le sont souvent les cakes), j''ai mis des bananes bien mûres et j''ai remplacé le sachet de pépites par du chocolat pâtissier que j''ai coupé en morceaux .', '2009-06-29T18:47:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 4081d3d5-9a0a-4ba8-97f3-1e2f171bbf35, 'Excellent ! J''ai reçu les compliments de tout le monde. J''ai également mélangé 50 g de Maïzena et 150 g de farine.', '2009-05-17T20:18:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 947dd570-c322-4492-b9a2-2d91fee7bfd7, 'Excellent ! J''ai mis 150 g de farine et 50 g de maizena, c''est moelleux et léger à souhait ! Trop bon ! Merci !', '2009-04-07T00:02:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, cd7cc912-9a13-4cb0-b77e-c840c0c24b03, 'Parfait! Moelleux ! Rien à redire !!', '2009-02-22T21:13:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82114, 34a83fed-6caf-4c00-bc3e-b5ae3ed4b6fc, 'Très bon sauf que je n''ai pas mis de choco sinon...très bon!', '2008-10-31T10:19:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22517, e15cf871-fa57-4091-9cdd-b2ae383d42af, 'Très bonne recette, bien que la noix de coco râpée n''apporte rien au plat. La pomme quant a elle n''est pas présente gustativement. Cependant les bananes apportent une fraicheur bienvenue. A refaire !', '2012-01-25T23:27:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22517, b03dbc89-b4d5-4636-bfae-31f89e95b2e2, 'Trop bon. A refaire absolument. Facile, rapide, que du bonheur ! ', '2011-10-29T00:38:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22517, 65a92b49-1493-49f8-ae6a-3266d9876dfa, 'DE LI CIEUX! moi j''ai fait mariner 2 jours, c''était parfumé et tendre, un régal ! une précision : ne pas couvrir, laisser mijoter à l''air libre. ', '2007-08-09T21:05:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22517, 3af4f2f2-8d18-45b4-b149-8a536e8f39ef, 'Très bon!! Je n''ai pas fais mariné la veille et je n''ai pas mis de piment, ce qui a peut être un peu manqué pour relever le plat.', '2006-11-23T20:32:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22517, 0509f770-70a4-4656-9e06-d0c6ad5cb1c7, 'Délicieux!!!! Je l''ai réalisé sans piments oiseaux et ce plat à remporté un franc succès auprès de ma petite famille. Merci.', '2005-05-08T16:53:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33350, ab433ec9-c530-45d2-8f68-4e555fbca8fa, 'Très réussi!! Le mariage des différents fruits est délicieux! Personnellement, j''ai remplacé la moitié des palets bretons par des speculoos et du coup, je n''ai pas ajouté de cannelle. De même, je n''avais pas d''abricots frais, j''ai mis une dizaine d''abricots secs (après les avoir fait trempé pour leur redonner du moelleux) et 4 pêches! Miam! Merci pour l''idée!', '2005-09-29T16:02:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, 5f32eefc-4f6d-4921-a3d6-095b12d259a7, 'Très très bon, surprenant. J''ai fait cuire le poulet a part car j''avais des végétariens parmi mes invites, mais je l''ai fait cuire avec du curry, et ajouté par dessus la garniture. J''ai servi le tout avec du riz, un curry de pois chiches, et des chapatis maison (recettes sur le site). Un vrai régal et des félicitations de la part des invités :)', '2006-07-23T06:34:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, 045b822a-4c60-41ff-8876-8c3d29fbf4b7, 'Délicieux ! Je n’ai pas mis la noix de Coco râpée dans le riz. Je diviserai la dose de citron par 2.', '2022-05-12T22:03:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, 2be990eb-56c5-4fdd-b71a-ca5c7b4346a2, 'Vraiment très très bon, on en refait régulièrement !', '2020-11-25T14:56:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, ff5b14b2-3cda-43bc-9fdc-5481fced264c, 'Très bon.', '2016-10-04T23:45:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, 477158b1-0140-45d1-940e-2c619118bbc8, 'Super bon ! Rien modifié sauf que je n''ai pas fait réduire le jus ', '2016-01-23T11:24:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, 422c39c1-e938-496e-bc18-bbc4bef9cce4, 'Succulent même sans la pomme de terre', '2013-08-25T14:53:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, 92dfd304-da2a-4b2e-b41d-0b1513d0e21c, 'Un régal ! Je n''ai pas mis le jus de citron. Merci pour cette excellente recette !', '2009-11-29T16:32:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, 8b47985e-8851-4c40-ad56-0dbd32a73c49, 'Merci beaucoup pour votre recette, j''ai fait sensation auprès de mes invités!! je l''ai suivi à la lettre et c''était excellent!!', '2009-10-12T15:31:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, 60dcd1a5-2a2d-4160-84c9-bbea19020991, 'Le mélange fruit et curry est vraiment une très bonne piste.  ', '2009-07-27T20:12:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, ed9abd07-a5f5-4c5c-bb9b-114c77822365, 'Très bon, plein de saveurs. Succès garanti!', '2007-11-23T16:15:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, 8667774e-3561-46dc-bdb5-c7a4a48af037, 'Merci pour cette recette pleine de saveur.', '2006-05-20T14:30:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, fcf2f635-09a9-4da7-b144-48a438d1b2f1, 'Excellent recette! Un peu pressée par le temps, j''ai éliminé l''étape de la passoire. Verdict: c''est moins présentable, mais le goût des différents légumes et fruits apparaît davantage. Merci beaucoup.', '2006-02-17T20:57:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, e6852015-9bbd-4a6b-8c31-4ee8d9596f53, 'J''ai adopté cette recette! Et un tout petit peu adapté aussi : en supprimant la pomme et la pomme de terre, et en ajoutant un peu d''ananas et de raisins secs...', '2005-12-06T11:54:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, ea884e70-a33d-4d8d-b3a6-1eb14d812608, 'Très très bon. Je n''ai pas mis de pomme de terre, et juste écrasé la banane avant de la mélanger au reste. Apprécié par enfants et adultes.', '2005-11-09T18:01:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, c1bfacde-77fe-436b-9254-0de2caac0874, 'Excellent! Plat riche en saveurs. Je n''ai pas mis la pomme de terre, et j''ai ajouté les rondelles de bananes, en fin de cuisson, sans mixer et sans faire réduire la sauce.', '2005-10-03T18:19:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, 7bc5f37a-78ba-4c9d-a985-baba26d6f283, 'Vraiment très bon! Ma recette préférée du moment.', '2005-09-25T20:21:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, 4a9b91f7-5e1e-4521-ad47-ff2490e776ef, 'Plat très savoureux, agréable mélange de saveurs.   La pomme de terre n''est peut-être pas obligatoire si on l''accompagne avec du riz. Et si on veut donner un petit "plus" au riz, saupoudrer de noix de coco grillées, et ajouter quelques rondelles de banane...', '2005-09-22T00:05:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, 578c13f3-f2d5-47af-b94d-9cb050ecf622, 'Très bon, mais on s''y perd un peu dans toutes ces saveurs. La prochaine fois, je mettrai peut-être un peu moins d''ingrédients "fruit". Pas la peine de rajouter de la noix de coco dans le riz, selon moi ce serait trop.', '2005-01-22T16:29:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, 8deb1b27-f344-40aa-9544-4a6dbe8db78b, 'Vraiment très bon, j''hésitais à mettre la banane, mais je n''hésiterai plus ! ', '2004-11-18T16:25:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, c243b883-9f4d-47fb-9eba-d71d43e23485, 'Excellent. Très parfumé et pas trop épicé. Je l''ai servi avec du riz basmati.', '2004-10-12T10:49:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27432, de48dc7f-83eb-4285-bc17-0efd0e155194, 'J''ai essayé et c''est super. Succès garanti.  Par contre, j''ai un peu hésité à ajouté tous les fruits. Du coup j''ai fait impasse sur l''orange et la banane. Mais je m''y attellerai la prochaine fois.', '2004-09-06T13:08:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 87aa7fdc-6b68-41e1-a21b-9b9321693486, 'Très bon pour une première ! Petite question… 1 g de chocolat noir ? Il doit y avoir une erreur, non ?', '2022-03-23T20:54:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 10ccf82b-a343-4cbe-bfa5-cb398cf117e4, 'J''adore. ', '2022-05-21T07:42:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, ee9e01da-b667-4a85-b86b-233fe1075acd, 'Fade, je ne sens ni le chocolat ni la banane... et la cuisson à 150 degrés n''est pas une bonne idée. Après la cuisson recommandée j''ai du refaire 1h à 180°C pour arriver à cuire ce gâteau', '2016-06-19T22:48:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 8e8f0a59-e293-4b19-8144-c4eb4312b50b, 'Délicieux!', '2023-05-02T18:32:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, b3a7bf18-1966-4a9c-97ac-c2c84cc3fbae, 'Bon gâteau. J''ai mis un seul pot de sucre. J''ai mis 2 de farine + 1 de maïzena. 30 min à 150 degrés et c''était nickel.', '2022-05-22T16:25:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 68cdfba9-ea55-4599-acd0-756806dcedd6, 'Un échec, cuisson épouvantable et texture vraiment pas terrible.', '2019-10-14T11:37:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, a6946b08-864a-4bc0-b3b6-0b9577751281, 'Miam. Mettre un oeuf de plus, un sachet levure entier et moins de sucre.', '2018-08-02T16:16:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 8cce65f5-f4f5-4a15-a18f-7b7bcf8aa9d7, 'Très bon ! J’ai écrasé la banane et pour la cuisson j’ai suivi les commentaires !', '2018-04-09T06:29:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 320b2c04-36c3-4e6c-9440-61b12d414fb3, 'Mauvais temps de cuisson et de thermostat... pas terrible.', '2017-03-07T16:15:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 43768b5a-a187-44c8-846c-e9fabd40446f, 'J''ai mis un pot de sucre au lieu de deux, je n''ai pas mis d''oeufs car j''en avais pas, j''ai ajouté 1/2 banane, et mis 15 minutes de plus car 40 min il n''était pas du tout cuit, le résultat est très bien la banane sans en mettre trop parfume agréablement le chocolat... par contre le miel je n''en vois pas l''utilité.', '2016-07-26T12:21:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 3970f55f-91da-4414-a118-489f9bfe9e8d, 'J''ai réduit le sucre de moitié et ajouté une banane. Le gâteau a bon goût mais il est trop compact, je réessaierai en battant les blancs en neige.', '2016-04-07T16:53:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 98c13a29-d04e-4d51-8cd1-d5a9b97005c1, 'Trop bon! J''ai mixé la banane au lieu de la mettre en morceaux ! J''enregistre la recette ! ', '2016-03-13T16:24:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 9fef568c-aef5-4ce1-bdd1-676bf5462c9f, 'J''ai mis plus de chocolat (200 g), 1 bouchon de rhum et j''ai cuit 40 min à 180°C : un régal. Même mon mari qui n''est pas fan de banane a beaucoup aimé.', '2015-03-29T19:14:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, b21237f4-0b72-48f5-80ce-671dad2520b7, 'Pas très bon à mon goût ', '2015-03-01T18:23:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, e3ea5856-8645-4504-b5bd-d3ae6fd5b84c, 'Très bonne recette. Je l''ai faite en portion individuelle dans des moules à muffins en silicone et j''ai ajouté au cœur 1 Michoko. Dégusté tiède avec de la crème anglaise. J''ai mis 2 pots de farine et 1 pot de maïzena pour plus de légèreté. Un régal...', '2015-01-08T23:44:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, c2c6bfc1-de14-416d-89ac-4f0adeff6145, 'Tout simplement délicieux. Les enfants qui ne sont pas de grands adeptes de gâteau en ont repris 2 fois au goûter. Facile, rapide, à refaire sans hésiter.', '2014-11-21T11:16:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 646c67bc-f52b-4584-b56e-d0006808e5f9, 'Très bon et très facile. On peut mettre un peu moins de sucre, le gâteau ne perdra pas en saveur. ', '2014-10-16T21:55:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, e429ef9d-9383-414b-909b-1f9ea2b60118, 'Super avec 2-3 modifications. 1 pot d''amandes en poudre en remplacement d''un de farine. 1/2 pot de sucre de stevia au lieu du sucre normal. Il n''en reste rien. Le temps de cuisson en chaleur tournante à 180°C : 30 à 40 min. ', '2014-06-29T17:39:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, eb84f2de-067b-400b-b5fa-4ecb171af998, 'Recette délicieuse. J''ai réduit la banane en purée avant de l''ajouter à la préparation. Je trouve que c''est bien meilleur comme ça qu''avec les morceaux. J''ai appliqué le temps de cuisson préconisé dans les commentaires précédents : effectivement à 150° ce n''était pas du tout cuit.', '2014-06-15T02:26:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 436ff01e-be77-4a1d-bc96-740c47d0c361, 'Super bon, mes hommes ont adoré. 40 min à 180°C. J''ai rajouté un glaçage à la noix de coco.', '2013-05-30T21:34:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 0edb1c34-5ffa-406f-8e9e-0a0ab04a8485, 'Très bon mais je confirme il faut bien 20 minutes de plus de cuisson.', '2013-03-26T18:55:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, db1ded1f-c4d1-40b8-af12-22f2a98f6f8d, 'Mauvais Thermostat et temps de cuisson.  Essayez 40 min à 180ºC. Sinon gâteau très bon !', '2013-01-15T01:15:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 6dfc9406-9fab-4e4e-863b-c1dcd330c1c2, 'Texture moelleuse et très bon goût. je mettrai un demi-pot de sucre en moins la prochaine fois tout de même.', '2012-10-11T01:12:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 10fac3b2-3134-44a2-bf8f-c32e7a1ac2e2, 'Très bon gâteau super moelleux, perso j''ai mis deux bananes et un yaourt à la vanille et pas de sucre vanillé, et c''était très bon. Attention au temps de cuisson dans un moule à cake je l''ai mis 60 min à 150°C. ', '2012-08-16T11:31:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, cf4f09e8-fdbe-4e85-9461-7d20920ab6aa, 'J''en ai fait une version perso, mais les proportions du gâteau au yaourt sont super -> gateau très moelleux, il n''est pas resté longtemps ! : Modifications perso : remplacé l''huile par du beurre fondu, remplacé le choco fondu par du choco en poudre + des pépites (= ce qui restait dans le placard), bananes réduites en purée (car noircie), 3/4 de paquet de levure, cuisson à 165°C.', '2012-07-23T17:02:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 90ca9065-fe9c-4939-bbaa-70cbb5cd331d, 'Très bon ! Avec un peu de rhum c''est encore mieux !', '2012-02-24T16:37:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 118a8726-3728-4f8f-bc49-a80275c00c13, 'Très bon gâteau et très facile. La 2ème fois, j''ai mis les bananes seulement au milieu car au fond du plat la 1ère fois, elles avaient collé.', '2011-06-20T20:00:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 38eb8f05-b4ea-4a5b-9b60-d98b7c158f74, 'Ce gâteau est très bon et rapide à préparer, super pour utiliser des bananes un peu trop brunes ! Par contre, je n''ai pas vu l''intérêt du miel sur le dessus...', '2010-12-10T19:50:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 3e3f411b-c3dd-47ea-a0a1-b8e750360903, 'Bonne recette, mais attention au thermostat et à la durée de cuisson:mon gâteau n''était pas cuit du tout, j''ai dû ajouter 20 min à 185°C', '2010-10-24T16:57:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169823, 4feb9aba-7796-4581-bf10-311d84eb57d6, 'Très bon', '2010-09-17T16:52:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28304, 2c87b293-d362-4483-89fe-cded328afc5c, 'Pas mauvais, mais j''aurais peut-être dû tenir compte du conseil précédent, à savoir ajouter de la gélatine. J''avais pour ma part ajouté un peu de cannelle. J''ai laissé toute une nuit au réfrigérateur, et la mousse rend un jus pas terrible au fond du ramequin... Et à noter que les proportions indiquées ici valent au moins pour 4 personnes (j''ai rempli 4 ramequins bien pleins!).', '2006-04-02T16:38:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28304, ccbd60ef-4a8d-4734-bdd6-f96af3fe2436, 'Je ne pouvais pas faire cette recette à la dernière minute. Donc, pour ne pas que ma mousse retombe, j''ai ajouté une feuille de gélatine dissoute dans le jus de citron que j''ai fait chauffer, puis incorporé aux bananes mixées. La mousse était impeccable. Et je pense que je rajouterai facilement 1 citron vert, car on ne le sentait pas assez à mon goût. Nous avons beaucoup aimé, c''était frais et très léger.', '2006-03-16T14:45:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28304, 7f853d86-7681-4e15-8428-c1f94d043229, 'Bon, très rapide, très facile. Fait avec du lait concentré entier. Les doses indiquées ici pour 2 satisferont au minimum 3 personnes sans problème. On peut forcer sur le citron. On pourra oublier le zeste si on est très pressé.', '2004-03-28T20:00:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392382, 3a7ac14a-21db-43ae-8789-77a04d6b2ad7, 'Il est question d''oeufs battis mais ils ne sont pas repris dans la liste des ingrédients !  !  !', '2020-05-09T14:28:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392382, 128fef67-3688-423e-8e73-e4048653548a, 'Avec 2 oeufs le gâteau était top, super moelleux. Je n''ai pas mis les cranberries (je n''en avais pas), j''ai remplacé par un peu de sucre. Par contre le gâteau est assez plat, si vous préférez les gâteaux aérés il faut ajouter de la farine.', '2020-11-07T22:57:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72349, c2f9b21a-dd1d-4a88-9ac6-6e6df2b13533, 'Dommage que le chocolat cristallise lorsqu''on le met sur la glace, ça ne fait plus un coulis chaud...', '2009-07-07T01:21:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72349, 381b9b95-5a65-4b93-a2f5-883ce0c70fa9, 'Génial pour le mercredi à midi, j''ai remplacé la glace à la vanille par de la fraise coulis fruit rouge.', '2008-06-19T17:11:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (225924, 92838310-e53d-49d2-809b-2ec4e26fe866, 'Un régal pour les papilles   ', '2015-06-05T20:38:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26607, a74f767f-44a9-437c-ac6e-eef3e86b7ae5, 'L''idée est excellente mais l''ordre de cuisson est inversé : on commence par le tapioca (utile de le faire tremper dans de l''eau au moins une demi-heure avant et de l''égoutter avant de s''en servir). On le met lorsque le lait de coco est chaud, remuer constamment. Lorsque la moitié des perles sont transparentes, ajouter les bananes et continuer la cuisson jusqu''à ce que toutes les perles soient transparentes. Toujours remuer pour éviter que le tapioca n''accroche. Très bon tiède ou froid.', '2019-06-11T06:58:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26607, 6d669daf-d47c-481b-8c93-3c6846c4ae31, 'Personnellement je mets un peu moins de tapioco. Un pur délice !', '2015-11-08T11:02:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26607, e53c1f81-2a4c-4841-a785-a097fceddb6e, 'Qu''est-ce que c''est bon!!! je sens que je vais m''en refaire souvent, en plus c''est hyper facile.', '2007-09-07T00:00:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26607, d9aa5f03-be66-447b-87cd-c3abc1287025, 'J''ai été déçue par la consistance trop compacte et presque écoeurante. Peut-être ai-je laissé trop cuire ? Sinon le goût est excellent et c''est un dessert original. A refaire avec le bon tour de main!', '2007-04-23T13:42:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26607, 72e41410-0ad9-46de-9a1b-29297c5efc7a, 'Dessert excellent et vite fait. Un petit plus suggéré par mon mari : une goutte de liqueur de Malibu dans l''assiette.  ', '2007-03-19T23:03:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26607, 11c893a3-8350-48d6-bb9f-936452b75c72, 'C''est bon mais bien consistant! Ne pas oublier les cacahuètes non salées!', '2005-05-27T09:20:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26607, 454931df-6c0c-4eb2-8770-4e75c2c9daf6, 'Ce dessert d''origine vietnamienne s''appelle le ''ciè'', à prononcer [tiai].', '2004-09-06T16:58:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26607, 64188b30-0d9f-49a1-aa46-b4aee057de6d, 'Dessert vite fait, bien fait! J''ai remplacé les petites bananes par 3 grosses.', '2004-03-17T18:48:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530889, f5d701b4-33bc-4866-9582-4c47903cfad3, 'Très bon ', '2021-05-02T17:27:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, 5169881d-84ea-46eb-8755-d154af19ed8a, 'Juste avoine et banane, 180C pour 16 minutes sans préchauffer, c''est parfait !', '2022-07-23T15:43:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, 404ce6f1-da63-4360-8dbb-4cedc050470a, 'Très bon !!! Pour ma part 150 g de flocons d''avoine + 2 cs de sucre + 4 cs de coco râpée + 100g de pépites de chocolat et là, pour moi, c''est parfait !! Toute la famille adore ! ', '2021-12-20T20:14:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, 429ba869-c5e9-4b64-9d31-47288bfc5452, 'Très bonne recette !! A refaire !', '2020-09-14T22:59:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, 7cd9442a-bfcb-4d66-b4e7-9942f09e0bff, 'L''idée était bonne mais le goût de la banane est, à mon avis, trop prononcé par rapport à celui de la noix de coco et du chocolat  qu''on on ne sent pas du tout. La prochaine fois je ne mettrai que 2 bananes, deux fois plus de flocons d''avoine, beaucoup plus de noix de coco et de chocolat et peut être  un peu de sucre roux  ou de miel. La texture un peu mollassonne de ces cookies devrait y gagner. À suivre ! Mais l''idée du "sans beurre, sans oeufs et sans sucre" était sympa. Et au fait, mes enfants ont quand même tout mangé en 10 minutes...', '2020-05-26T20:57:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, e437f4d3-b59d-4ae4-9498-b196633f4ac4, 'Très bon !', '2025-09-22T21:30:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, c97989c5-9987-4f12-8ea7-59b9a766538b, 'Je fais cette recette souvent car j''ai tendance à beaucoup grignoter certains jours, mon mari aime pas la noix de coco donc, j''en pas mis. J''ai rajouter une cuillère à café de miel (bec sucré 😀) et dans une partie de la pate quelques raisins secs et j''ai mis au four 30 minutes pour plus de croustillant à 180 degrés. ', '2023-11-12T08:14:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, f6a5432d-64f1-4be6-9124-f7162b85dca6, 'Pas fan, manque de cuisson. J''aurais dû laisser encore plus que 25 min.', '2022-08-24T18:53:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, 0aa65457-0757-420a-a88a-5af3ff34d38e, 'Très bon, facile et rapide a faire ', '2020-11-29T15:17:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, ba490384-fb5d-45dd-865a-9cc0889dc270, 'Je la fais à chaque fois que j''ai des bananes trop mûres. Je ne jette pas et me fait plaisir grâce à cette recette !!', '2020-11-08T18:42:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, 97b39842-80e9-4201-abf8-4f0bb4cc0905, 'Rapide, inratable et délicieux!', '2020-10-18T20:55:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, db919054-e260-40ec-8667-67e137fd36b8, 'Délicieux ! On peut attendre qu''ils aient refroidi et soient devenus solides, ou bien les manger chauds et encore moelleux presque comme des muffins. Merci pour la recette :)', '2020-07-07T20:30:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, f98f6ff0-1f81-4210-bd92-4e597955f936, 'Cookies très reussis!! 
A faire avec ou sans pépites de chocolat, car au final il y en a effectivement trop peu ppur bien sentir le goût ! N''ayant pas de noix de coco râpée chez moi j''ai essayé avec 50g d''huile de coco, le goût y est et la texture aussi ??', '2020-07-01T23:25:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, 22b65b6e-c7fa-4346-b213-356877ee7734, 'Un delice proteiné?', '2020-06-07T13:02:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, e7bfe19a-c898-4e86-ad00-109beed7f36e, 'Trop bons ! J''ai ajouté 2 cuillères à café de sucre brun dans la pâte et j''ai remplacé la coco par du beurre de cacahuètes. Je les ai cuits 25 min car nous aimons les biscuits croquants. Cela sont crousti moelleux un vrai régal.', '2020-04-21T17:59:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, 89c7bf55-beeb-4171-ab9b-376f59e1c180, 'Recette facile à réaliser mais je n’ai pas aimé ni la saveur ni la texture', '2020-04-18T00:31:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392022, 402c804c-5f8d-470d-ac5d-dacd4be24ffc, 'Super bon. J''ai suivi la recette à la lettre. J''ai formé mes boules à l''aide d''une cuiller à glace. ', '2020-04-05T22:36:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84047, 703542d9-2608-446d-a4af-e15c3e07b06c, 'Pour une première, réussite totale, très apprécié de mes invités. Quelques petits trucs pour vous faciliter la vie : en sortant votre biscuit du four, retournez le sans attendre sur un torchon humide et roulez le pour lui donner sa forme, ce qui évitera qu''il ne se casse par la suite. Pour le nutella, s''il est un peu dur à étaler, 30 secondes au micro-onde et il est de nouveau coulant, beaucoup plus facile alors de faire le nappage final. Pour les bananes, j''ai fait en plus une purée de bananes en faisant revenir deux bananes dans du beurre avec un peu de sucre. J''ai étalé cette purée de bananes sur le nutella avant d''y ajouter quelques fines rondelles de banane crue. Le résultat final était moins sec. Lancez-vous, recette facile et délicieuse.', '2010-12-26T14:54:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84047, 6d32f353-2b14-48a9-9717-43a2dac329fc, 'Super bon ?', '2020-10-24T00:16:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84047, 9cb2eb51-6faa-4c19-adf1-0465d20cacc5, 'Mon roulé n''est pas du tout rond (alors qu''il devrait l''être selon son appellation) et la pâte est plus comme un sablé q''une pâte moelleuse ! Je déconseille malheureusement.', '2020-03-30T20:32:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84047, c997a26f-2ff1-4923-b374-ea784489aa89, 'Super bon et très facile à faire !', '2018-03-16T16:43:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84047, 7746e4e9-ded0-44ca-8cd8-803608ab7bb6, 'Une première pour moi aussi et c''est totalement réussi!!!! j''ai doublé les quantités car j''ai une famille nombreuse bien gourmande, mais la génoise est très facile à travailler. merci', '2015-11-20T10:55:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84047, 3f06ab93-3ae5-4d70-9a77-e199a322b335, 'Super mais je trouve que cela n''est pas assez sucré ', '2015-08-24T18:52:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84047, 99b40683-d5e2-46af-83e8-b2c16d2fdc83, 'Super mais j''ai doublé les quantités.', '2014-12-31T19:08:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84047, d799fe16-19ff-4ec5-87d9-63572cddedef, 'Très bonne recette !', '2013-10-14T19:29:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84047, 66b9ef7c-153d-43f3-94ee-1a2773ad12cf, 'J''ai doublé les proportions pour un anniversaire. Et je n''ai pas mis les bananes, le Nutella suffisait !', '2013-06-20T20:14:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84047, 1976827a-65ea-4c0b-88ce-e0639c50d20f, 'Bizarrement , chez moi ce fut une catastrophe. J''ai pourtant l''habitude des génoises. Là, j''ai fait une omelette...', '2011-12-19T19:33:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84047, d13e09d8-4a3f-43ba-8368-643454ea4de3, 'Rapide et simple ! Un régal... Merci pour cette recette !', '2011-04-03T14:32:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84047, 508b45d9-66c9-40b7-a76e-c23b03593d86, 'Simple et rapide à faire, un résultat excellent.', '2010-06-26T23:40:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84047, c724e443-aa71-4609-9dfb-f8f2e0468b20, 'Rien à redire : MERVEILLEUX. j''ai juste mis une gousse de vanille à la place du sucre vanillé. Merci!', '2010-03-04T16:31:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84047, 43bf5dfa-9e6b-4a35-8695-668a544bf458, 'Premier gâteau roulé de ma vie et ce fut une réussite. Petits et grands ont adoré.', '2009-11-04T13:00:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84047, 709f73b6-71af-4a0b-9acc-d028f7e08b01, 'Délicieux roulé, j''ai mis 3 œufs et ma puce et moi nous nous sommes régalées ! Le biscuit est facile à rouler, super !', '2009-05-27T20:27:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166490, 4a02e3a7-ae66-44ac-b5e4-ba5172872aca, 'C''est un plat délicieux !!! Et pour les gros mangeurs comme moi, un peu de riz pilaf en plus ne gâche rien', '2010-05-13T19:19:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 59056956-ffc9-4bee-8987-69fad51ff696, 'Une tuerie. C’est encore meilleur sans cacao et en coupant le chocolat en morceaux, ceux-ci vont fondre dans votre bouche à la sortie du four 🥰 un délice ! ', '2023-03-29T17:04:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, f7baa23d-475e-4581-bc2d-f582bb8c74b1, 'Très bonne recette ! Perso, je rajoute un peu de cannelle râpée et une goutte d''essence de vanille ! Pour le glaçage, je préfère ne pas mettre de crème, un caramel au beurre salé tout simplement ! Pour le topping, quelques noix et morceaux de bananes séchées !', '2019-09-21T19:50:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 262c2137-6d1b-403b-acf8-452b82845dea, 'Un vrai régal ! J''ai modifié légèrement les ingrédients : mis moins de sucre et chocolat noir au lieu du chocolat au lait. Un vrai régal ! Merci pour la recette', '2019-04-11T18:53:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, a64c1531-da64-4755-ab80-8d551d30b61c, 'J''ai juste remplacé le beurre par la courgette au même poids.  C''était super bon!!', '2018-09-18T05:41:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, af65cd9b-1b49-4e12-8fc8-538a18001d32, 'Super recette. J’ai rajouter un yaourt nature pour plus de moelleux et la découpe c’est nickel ça fait un peu comme un gâteau magique. Et la prochaine fois je mettrai moins de beurre. ', '2018-04-23T09:58:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 23fe2b8c-28e9-4c46-b160-8c1efcd79225, 'Excellent, je recommande cette recette ! ', '2023-10-12T13:16:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 5a613f26-d15a-406b-bf9a-acbc04e72610, 'Rien à redire ! Très simple à faire et délicieux !', '2022-07-05T19:35:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 4ed55f44-711c-4809-b7a4-05380994b80c, 'Super recette ! Très simple et délicieux !! On s''est régalés ', '2022-06-06T12:06:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 79930f40-adf0-4203-b36b-a25c51c23291, 'Très bon mais petit problème de texture le gâteau ne se tenait pas du tout, ça n''empêche pas qu''il était délicieux !', '2022-01-30T12:50:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 6a478836-5288-4af4-bcd3-25efded06b54, 'Bon goût, pas trop sucré mais un peu sec.', '2022-01-09T16:02:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 5aed511f-0f87-4c54-856e-a978f89f1ddc, 'Un peu sec', '2021-04-26T18:32:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 605925b8-8da0-49bb-bed0-e1dd012e6fcd, 'Excellent à refaire. J''ai rajouté de la noix de coco en complément sinon j''ai suivi la recette à la lettre.', '2021-04-19T16:38:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, f883b628-1bf6-4234-b06a-cb0e2d1d52b4, 'Nickel', '2021-04-18T21:54:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, fbc5cf8e-54e2-4095-b3ba-ca14819c3575, 'Miam', '2021-04-18T08:51:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 792fe205-46a8-450c-b531-fef0ebfee190, 'Parfait ', '2021-02-07T15:32:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 85621463-b829-4938-a692-b9166e60e7b5, 'Recette réalisée a la lettre. Bon gâteau mais qui ne se coupe pas aisément. . Peut être trop de farine. .', '2020-11-14T11:42:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, ed41009a-bd8d-430b-93f0-42f2a84edfa1, 'Super recette! Je l''ai fait avec un mélange de chocolat noir et blanc qu''il me restait et franchement un délice! Ma fille de 3 ans a adoré. A refaite sans hésiter! ', '2020-11-01T16:52:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, c4ab0214-f3cd-4de8-afce-2a1d263d5f1f, '2 fois que je le fais et c''est toujours un délice ! Il n''en reste pas une miette. ;-)', '2020-10-01T19:51:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, e12e4f56-9b32-4f1a-ad3c-437879e59a0f, 'Une vraie tuerie. Mes filles et mon mari me le reclame souvent. Il est tellement bon. Je le fais avec du chocolat noir et ne mets pas la banane sur le dessus. ', '2020-07-08T18:55:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 7d97a40f-607e-404e-846d-25d8fff60efb, 'Gâteau vraiment excellent,j''ai juste mis une tablette entière de chocolat que j''ai réduit en pépites au lieu de mettre du cacao, sinon rien changé à la recette, elle est parfaite; Testée et approuvée par tout le monde', '2020-06-01T21:05:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 2a996260-45fb-43e4-bfd4-d98ac5040546, 'Recette excellente 180 degrés 45 minutes cuisson parfaite 
du chocolat à croquer noir 100 g  au lieu de chocolat au lait et du cacao poulain parfait.
Super pour passer les bananes toutes noires', '2020-05-10T12:03:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 2e24f1c8-9c4e-4c00-b15e-13f8e27433e8, 'Trop bon. J''ai mis 100g de chocolat à 40% de cacao et 2 bananes. Il faut laisser cuire 30 minutes pour garder un peu de moelleux au milieu, ce que je préfère.', '2020-03-06T22:28:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 74072d6f-6e07-4f45-b179-c7d99dcaea21, 'Trop bon ce cake !', '2020-03-03T23:10:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 77d81df2-815f-438d-8810-f195e15d45e1, 'Facile à faire et très bon !', '2019-06-23T18:09:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 7c2c84e1-09bf-4c23-a97b-1c91db32ef82, 'Vraiment excellent ! Rien à redire. Même le temps de cuisson est bon, je n''ai eu besoin de rien rectifier. Mes proches ont adoré !!!', '2018-12-14T08:22:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, faf64f06-2f56-4501-a344-b5889f1ad61b, 'Plusieurs fois que je fais ce cake ! Un régal pour tous.', '2018-11-30T09:14:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 0653242d-a254-4a6e-845a-7770a3703eb7, 'Super cake! Je n''ai mis que 70 gr de sucre et 20 gr de cacao en poudre et cela a suffit. A déguster tel quel ou avec une creme anglaise maison... Miam!', '2018-10-16T04:46:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 22f34a7e-9cbe-4fa7-9ca5-256274cc3a6b, 'Trop sec à mon goût.', '2018-07-22T21:42:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 4480af7a-b4b5-46ff-826a-6e6ab9b559b4, 'Bonne recette de gâteau choco banane ! J''ai utilisé du chocolat noir au lieu du lait : Un régal ! Peut-être un peu trop de farine car il est assez cassant !', '2017-10-15T14:37:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 3ce116f7-ce08-41cf-898d-17e404848bd1, 'J''ai mis du chocolat noir à la place du chocolat au lait, fait fondre le beurre avec le chocolat, je n''ai pas mis de sucre (le sucre des fruits suffit , idem pour des moelleux choco-framboises !), et un peu moins de 40 min de cuisson à 180°. Résultat délicieux, très tendre, toute la famille a apprécié !', '2017-07-31T19:58:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, c6b1e780-eec7-4714-8ad3-b704975451b1, 'Très bonne recette, j''ai un peu modifié les ingrédients en ne mettant que 90g de beurre, en ajoutant un sachet de sucre vanillé et en remplaçant les 130g de chocolat au lait par 100g de chocolat noir.
Et c''est niquel ! ', '2017-06-21T21:16:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 9df0ceca-edc3-4e0c-a190-74a76835e6a8, 'Très bon gâteau, très moelleux même s''il s''émiette un peu c''est un délice ! ', '2017-06-01T11:51:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, d3688906-df88-44e4-912a-0075b9f8d79c, 'Super recette ! Meme si je ne l''ai pas suivi à la lettre. Je n''ai pas mis de cacao, jai plutôt utilisé du chocolat noir. Et je mets le cake 50 Minutes au lieu de 45. Mais en tout cas le rendu est super joli et le goût magnifiquement bon ! ', '2017-04-15T12:36:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 8290f7d1-4f07-4410-b93a-040b9ca868d4, 'Très bon gâteau. Moelleux, léger, pas de souci pour le démouler, il reste bien en le coupant. J''ai ajouté une troisième banane dans l''appareil. 10 minutes de plus au four à 175° chaleur tournante. Dans la vidéo, ils mettent les 130 g du chocolat au lait en petits morceaux. Sur la recette ils font fondre le chocolat. Je ne sais pas s''il y une grande importance. Pour ma part j''ai fait fondre le chocolat au bain marie. ', '2017-02-24T18:39:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, b9d0ab32-659a-4e55-8ea4-8664e5935f79, 'Trop bon ! À la sortie du four c''est une tuerie mais il est difficile à découper, il s''émiette. Après passage au froid, c''est toujours super bon et il se tient bien. Cette recette risque de devenir un classique chez moi !', '2017-01-16T10:25:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 67ef3946-c087-449f-817b-ff331fc13b0b, 'Très bon.', '2016-12-13T23:23:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, e2878f9a-3d94-4e50-98c5-5a7180eaa884, 'Très très bon à refaire.', '2016-11-27T19:11:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 97e55a1d-4aff-444a-ae56-2bf2f7b7d696, 'Trop bon.Très moelleux.La prochaine fois j''augmenterais la quantité de banane.Peut-être une de plus.', '2016-11-26T14:00:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 19e5f79f-d343-4f88-af77-2b247574aacc, 'Super recette. parfait !', '2016-11-25T18:53:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, d75a314f-3c9e-4b3f-95be-7956c1c546aa, 'Manque de cuisson, 45 minutes ne sont pas suffisantes. Résultat moyen.', '2016-11-21T13:16:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 91ba42b4-9dc5-4531-92f5-e089931b8b59, 'J''ai suivi exactement la recette. c''est très bon. juste un peu sec une fois que c''est bien froid... Mais super avec une crème anglaise ou trempé dans du lait. on sent bien le goût de banane.', '2016-11-19T17:06:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, f91d5959-af6a-46e1-876e-4d3da034e6b2, 'Rapide et simple à préparer, le mien a cuit environ 50 minutes. Très bon et non bourratif il était bien aéré.', '2016-11-19T01:17:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 90aaa3cd-4bcd-477f-84ab-97550f6d92f0, 'Le gâteau est trop sec... c''est dommage.', '2016-11-16T13:28:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 74832bff-6a15-44f7-9cdf-0aafa6901bac, 'Très bon gâteau. Gâteau très moelleux au final.', '2016-11-15T23:33:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 19a7708e-dc7a-4b42-a484-6375ea49b76c, 'Je l''ai fait et plus qu''un  délice et simple à faire. ! On m''en redemande ! Je le recommande  pourtant  je ne suis pas une grande pâtissière !', '2016-11-14T17:26:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 94077a88-d853-42b8-82cd-409affebbf60, 'La recette ne dit pas à quel moment nous devons mettre les bananes écrasées.', '2016-11-12T15:14:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, ddd2a1dd-17c5-45db-a35f-221e2a24c77f, 'Très bonne recette, le cake est excellent, je n''ai juste pas mis la dernière banane comme indiqué.', '2016-11-06T22:57:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, 20ce8aa5-9d8e-498e-bb6e-f51e87c9cdd4, 'Recette très réussie ! Je n''avais que 2 bananes mais c''était suffisant pour bien parfumer le cake. Nous l''avons trouvé moelleux et très léger. Bravo  ! ', '2016-11-04T09:41:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, b84014f8-3c93-4eb3-9533-d68650ddbe5b, 'Merci pour cette délicieuse recette..... j''ai modifié le temps de cuisson 1h au lieu de 45mn c''est top ...', '2016-11-03T10:48:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346037, cc1b58dd-7056-4085-a43e-89d5b6c60fbb, 'Extra ! Rien à changer à la recette. Nous avons adoré, et pourtant mon chéri n''est pas fan du mélange banane / chocolat !', '2016-11-02T21:12:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40862, 8345c498-dfb7-4b5d-acf4-3c23a7b11a12, 'C''est pas mal, mais sans plus. Bien pour un dessert de tous les jours mais surement pour un jour de fête ni pour recevoir mes invités. A moins peut être en y mettant un peu plus de fruits exotiques ? car là c''est plutôt maigre.', '2009-01-01T02:56:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40862, 34a32046-ecb8-4d86-a7f8-79328cbb7f5d, 'J''ai préféré faire des crêpes, j''ai mis les fruits sans la banane, à la place de la mangue et un peu de gingembre râpé, accompagné d''une glace vanille, caramel, c''est délicieux !', '2008-12-28T18:55:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40862, fc26387e-850b-41d1-bf20-c9740451fc78, 'Mes invités ont apprecié cette recette originale. La prochaine fois je varierai les fruits, peut-être un peu de mangue...', '2007-12-26T12:49:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40862, eaacb099-b84f-4005-81ee-9cca03622c9f, 'Rien d''exceptionnel! la présentation à l''intérieur de la papillote est inexistante, et le goût des fruits reste le même! la noix de coco ne se sent pas! Dommage!', '2006-08-12T20:38:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (231734, 22212896-8b56-42a7-801c-55f36120ce32, 'C''est très bon, j''ai suivi la recette mais j''ai ajouté de la noix de coco râpée et un carré de chocolat noir dans chaque moule à muffin. Ça fait un moelleux banane-coco coeur chocolat !', '2019-05-25T10:56:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (231734, 788c2011-09bb-4ff7-a714-d49de79d48a0, 'Super ', '2017-02-15T10:37:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (231734, e8c9f04e-1293-46dc-9969-a5764d15b9fe, 'Bon mais pas génial... j''ai juste aimé le goût de la banane. Je ne pense pas que je referai.', '2014-05-10T00:06:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (231734, af22c419-89ee-41fe-9be5-13cd46585910, 'Très bon. Mais c''est dommage, comme la pâte est assez liquide, les "moelleux" sont plus plutôt "mous". ', '2014-04-02T19:52:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, dce3ff96-25ca-4e5f-aa4c-784c171af609, 'Une merveille...', '2020-09-07T07:57:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, f27fb151-afac-442c-8645-302cf19dd2d4, 'Bonne consistance de la crème, mais tarte très fade ! A la dégustation je l''ai arrosée d''un peu de rhum, c''etait bien mieux ! Je conseille donc de parfumer la crème à la cannelle par exemple, ou a un alcool si elle est pour adultes.', '2009-04-23T21:59:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, ab48ec86-a1a4-40f7-9b66-651a21dd16ef, 'C''est original et goûteux, cette couche de bananes sous les pommes. Malheureusement, elle ne se conserve pas : même le lendemain, les rondelles de bananes sont noires.', '2008-12-16T17:31:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, fe74e27b-ae77-49a6-8391-edc7d78276d2, 'Je ne suis pas fana de la banane cuite, j''en ai mis qu''une seule et pour moi, ça suffit, il n''en faudrait pas plus. J''ai disposé les rondelles sur une compotée de pomme/poire. J''ai utilisé de la pâte feuilletée...un délice!', '2008-04-06T15:54:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, f434adf7-0f56-4bde-bf3f-4fcbf491e248, 'Très facile à faire et très bon (même sans confiture), recette idéale pour accompagner un café improvisé.', '2005-12-28T12:54:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, 5cfc55c3-7c2a-416e-b79d-3b55055b5b98, 'Assez bonne, mais la tarte était trop sucrée... J''ai peut-être exagéré sur la confiture d''abricots!', '2005-11-04T19:17:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, 598367c8-d4ee-4346-9d07-f24536c2b014, 'Pas mal, ça change. Mon beau père a adoré! A refaire...', '2005-08-13T09:12:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, 51ca94b9-1500-47e1-83f4-db5260812f35, 'J''avais un reste de pâte brisée, une banane bien mûre et une pomme granny. J''ai fait une mini-tarte pour deux. La pomme est indispensable car elle adoucit le goût typé de la banane cuite. Je mettrai moins de sucre la prochaine fois. Dessert facile à faire.  ', '2005-03-30T23:21:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, e6d5de95-c847-4bfe-9eec-aae8d97d38cc, 'Les bananes et la pomme font un mariage sucré, mais pas trop. Délicieux.', '2004-09-18T00:28:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, df99cf32-d3db-48b0-a5e6-492a3ead0ad8, 'Je n''aime pas la banane cuite et pourtant j''ai trouvé cette tarte délicieuse, très légère. Je l''ai faite avec de la pâte feuilletée.', '2004-06-11T17:24:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, 622ae878-f41e-461c-b62c-1356cf3eeff9, 'Très bonne tarte, je l''ai faite avec de la pâte feuilletée et c''était vraiment un délice!!!', '2004-06-10T21:10:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, 9b8b3150-a380-4216-b8fb-3d50c00bc41f, 'Très bon, facile et pas trop riche. Compatible avec mon régime weight watcher! (3 points pour 1/8 de tarte)', '2004-03-14T23:33:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, 4f761c11-6559-4691-ad81-c9867fd4055f, 'Excellente! La première fois que j''y ai goûté, j''en ai englouti un tiers. Et elle a fait l''unanimité auprès de mes amis.', '2003-11-10T00:47:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, e53be0bc-bfbc-47bf-adbf-32dfe58d850e, 'Très bon. Avec une pâte sablée, c''est pas mal aussi.', '2003-05-23T00:17:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, 892270a4-ac20-4791-8f69-86bb3093081a, 'Très bon et original. J''ai rajouté de la compote de pommes avant de mettre la couche de bananes.', '2003-03-24T17:35:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, 3cfec477-d28d-4a98-8d9c-c49fa5d91501, 'D''accord pour doubler la quantité de fruits. Très bon.', '2003-03-22T16:40:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14779, 3c1de511-dc52-4d8c-a6cb-dcffd3171a85, 'Excellent, mais, la prochaine fois je doublerai la dose de pommes et de bananes.', '2002-01-07T14:11:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83125, cd33294e-6328-4edb-bb11-4340d5bbdcd1, 'Lourd et sans finesse', '2012-08-23T23:17:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83125, 02014002-4e6a-4bab-86b9-d18e952ab742, 'Très rapide à réaliser et délicieux.', '2011-08-02T23:44:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83125, e95bfe39-aafa-4cce-b738-776854ac2d32, 'C''est très bon, excellent même', '2011-08-02T15:16:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 3df6526c-f0d7-4914-b63a-538cdf6ecb62, 'Très bon. En refroidissant, la tarte a de la tenue. Je l''ai préparée sur une pâte feuilletée rectangulaire, et coupée ensuite en carré taille lunch, facile à attraper en bouchée individuelle, sur un buffet.', '2020-04-12T07:53:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 362f7b1c-9bba-4e77-b6b7-a5e856ccc6d5, 'Très bonne ! Un régal ! J''ai pas mis du sucre et j''ai mis un peu plus de crème. A faire et à refaite ', '2017-04-08T23:04:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, ca1ffdba-ee81-4a6d-b833-09e74657c9fa, '1 plaque et demi de Nestle dessert, poudre d''amandes et sucre roux sur les bananes ! Au top.', '2016-09-11T12:17:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 8dc5c560-88b3-4dcb-917e-0a8cff8a8d38, 'Je l''ai faite et elle est délicieuse ! Je l''ai refaite en remplaçant le chocolat noir par du chocolat pâtissier praliné et c''est encore plus délicieux !', '2014-12-30T19:40:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 4c014a25-9fc6-490c-bf00-fefeec5aa8a0, 'Cette recette est délicieuse, j''ai fait pré cuire la pâte 10 min, j''ai mis 2 oeufs dans le chocolat fondu et 3 cuillères à soupe de sucre, par contre 4 bananes ont suffit. Je la recommande.', '2014-12-13T21:35:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 57268403-cd21-4473-8a78-8ecefa4d1198, 'Cette recette est super mais encore mieux avec de la noix de coco en poudre ! ', '2014-10-17T18:32:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, dd9743ed-51f3-4807-8f7f-fffa4a03fac5, 'Super bonne ! Pas mis de sucre mais ajouté 1 oeuf et mis un peu plus de crème + 1 nuit au frigo et c''est nickel !', '2014-03-12T01:51:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 9d0f7a91-a3b9-4a34-9895-5e8fc69e5ac1, 'Je la trouve excellente et rapide !! J''ai pris une pâte sablée et mis 2 petites briques de crème soit 4 cl et deux oeufs, je n''ai pas mis de sucre et hop au four !!! Nous nous sommes régalés....', '2014-03-07T14:29:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 89bb23cc-990e-423c-9868-c5bc7f8b304c, 'Très très bon', '2014-02-17T16:19:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, a9b051f3-85b9-49de-8509-00bf156568b9, 'Un délice, facile à réaliser, bonne épaisseur de bananes et de chocolat, je n''ai pas ajouté de sucre. A faire et à refaire. ', '2014-02-14T21:13:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, a178e215-36ac-4cd6-8ab1-0a0694586bba, 'Miam !', '2013-11-10T18:17:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, d046a76c-bce7-4712-8e6d-af04407f44cc, 'Excellente ! J''ai mis 10 cl de crème fraiche en plus car je n''aime pas quand le chocolat couvre trop le gout du fruit sinon il n''y a rien à modifier. ', '2013-09-23T21:36:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 6b0a0924-0886-4177-93b7-de98d6dedf62, 'Très bon ! J''ai rajouté 2-3 cuillerées à café de noix de coco râpée dans le chocolat ! Et j''ai aussi passé à la poêle les bananes ! Un régal !', '2013-08-04T16:41:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 59be48e7-e4d4-413a-8cb1-61892aee8c8f, 'Très bonne ! Elle plait à toute la famille à chaque fois ! ', '2013-03-21T21:55:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, c57af439-8701-4883-bcd9-4c9753b059a2, 'Très bonne recette, tout le monde a adoré.', '2013-01-20T23:15:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, fb1926ac-a9cd-44bf-a93f-03f0d18746a9, 'Très bonne, les enfants et les parents adore, même tiède...', '2012-10-28T12:22:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 532c0c1a-2f6b-445d-8f0b-210604aa9879, 'Toujours très efficace l''association chocolat-banane... Très simple à réaliser et très bon.', '2011-11-28T23:05:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, ce19f535-de9d-41f6-94ee-cd8f4abbdcf2, '3 bananes ont été largement suffisantes pour couvrir le fond de la tarte. Personnellement, je l''ai faite sans sucre et elle était très bonne comme ça.', '2011-10-24T18:35:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, efd34beb-d4f2-4bdc-87ff-7f904b5ba77f, 'Un régal. J''ai fait cuire à blanc ma pâte avant donc ensuite seulement 15 min de cuisson. J''avais ajouté des amandes effilées, j''ai fini la cuisson de la tarte par 5 min sous le gril. Parfait !', '2011-07-16T20:01:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, b8ce9efc-d58f-48b2-9dfc-1ef52fca3c94, 'Super ! Rien à changer, je l''ai ai faite dans des moules à tarte individuels, tout le monde était content.', '2011-05-30T17:18:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 795fb1d5-7b2a-4ea5-ab55-18b670b0a4bb, 'Avant de mettre les bananes coupées en rondelles dans la tarte, je les ai faites revenir dans une poêle beurrée. J''ai mis 2 œufs au lieu d''un car ils étaient petits. Super résultat!!!', '2011-04-06T14:16:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 587a91ac-fc68-4630-a7ef-9e61d3c0d275, 'J''ai préparé cette recette pour toute ma famille qui s''est régalée ! Par contre, la prochaine fois je n''hésiterais pas à mettre plus de chocolat (ou alors moins de bananes) car le goût de la banane était un peu petit trop prononcé par rapport à celui du chocolat. J''ai aussi utilisé une pâte sablée plutôt que brisée (préparée moi même) ce n''en est que meilleur !', '2011-03-10T18:23:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, c1e69d01-f0b6-4615-a08d-713e47818b40, 'Délicieux !! Première fois que je me lançais et grand succès. Mes bananes n''étaient pas assez mûres, je les ai passées quelques minutes au ''Croondes''. Merci pour cette recette.', '2009-08-25T18:22:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, eefc52a2-049a-4569-8260-82b4faf0c172, 'Tout simplement un des meilleurs desserts... Je conseille par contre de prendre des bananes biens mûres. Servie avec une boule de glace à la vanille, je vous dis que ça...', '2009-06-06T18:10:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 814f1ed5-8ce7-4815-b582-6faa4de9c137, 'Un délice ! Simple et rapide toute la famille a adoré !', '2009-04-20T23:34:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 94dc3a87-7c5c-4c37-8333-3d3113669cbf, 'Un régal tout simplement!!!... Nous venons de la déguster. 10 minutes de préparation pour un dessert simple et épatant. Astuce: nous avons coupé les bananes à la demande (environ 3)de façon à tapisser la pâte (sans superposer) et on a choisi des bananes plutôt mûres ce qui donne une purée fantastique!', '2009-03-10T21:39:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, ae3c9580-b669-4489-8fd4-2a69a3c29b14, 'J''ai aimé le mélange.', '2007-03-14T19:42:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 96c4472a-36ec-4949-b2c4-dc972e254e47, 'Je conseille plutôt d''utiliser des bananes bien mûres! Imaginez que mes invités ont eu la même idée en même temps et m''ont dit qu''on dirait des pommes de terre! Quelle honte à la fin du repas! Donc je réessaierai avec des bananes plus mûres. La tarte était cependant très bonne si on enlevait les bananes et aussi d''une grande simplicité et pas chère.', '2006-01-21T12:54:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, a0a30db8-6ee4-4a6f-931d-7ed9df8a738f, 'Facile à réaliser et cela présente bien, mais bourratif... Ne surtout pas manger chaud ou tiède, c''est écoeurant!', '2004-05-18T13:16:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 0cf156e6-08de-4bfb-b203-b975ef9cc7b2, 'Très rapide et très bon: meme si au départ on se dit, ''ce n''est pas trop bourratif'', on se rend vite compte qu''une part suffit... Mais quelle part!', '2003-11-25T19:16:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20406, 9b14f963-bc59-4b28-b4e6-4ce847df9382, 'Super facile à faire! Le mieux est de faire la pâte soi-même (c''est meilleur).', '2003-02-19T10:37:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31142, 4ecc0dfa-e174-44d9-96e4-ed6bd3e52255, 'Excellente recette. Crème anglaise indispensable !', '2019-10-18T13:47:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31142, 49b2ce3d-634d-4dbe-a40a-7020904a201f, 'Une bien longue recette pour un résultat bien décevant...', '2007-03-04T18:57:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31142, c461ed84-c791-42a0-9cab-5fd0e793ace7, 'Afin de bien tout recouvrir, j''ai ajouté 100 g de chocolat et un oeuf à la préparation initiale...les enfants sont fans.', '2006-03-13T19:45:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57016, 6444e2a1-09ba-41b7-b09b-409edbf53a00, 'Tarte très bonne, très facile à faire en en peu de temps.', '2016-07-25T20:33:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167938, 95b29e23-0428-4f58-a955-84fda3c7ee8a, 'La recette est trop succincte, il manque les quantités de certains ingrédients...', '2020-04-05T15:17:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167938, a526c6a6-274c-4754-a417-a44ff9a1130c, 'Pas mal! J''ai ajouté du sucre vanillé et c''est sympa.', '2016-03-07T09:32:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167938, 69ce0786-c572-42ce-98ff-b40c36dcb0de, 'Bof ! Manque de saveur et un côté acide pas très agréable', '2014-10-28T13:54:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167938, aecb7c6b-21a6-4a2c-88fa-bcfe79237327, 'Sympa, facile à faire les gosses ont adoré.', '2012-04-14T22:24:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315229, 5af02184-e73c-41a6-8202-3daa38f6e001, 'Très bonne recette bravo !!!', '2021-12-02T10:11:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315229, 9f2708df-1699-4670-9d1c-4e638f0e0607, 'Très bon, sans oeuf, sans lait et sans gluten, j''ai remplacé la levure par du bicarbonate, bien équilibré côté saveur, j''en referai, merci pour cette recette.', '2018-08-07T10:30:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315229, b17d77a2-0b2b-4d77-b158-6b132b66b2aa, 'Délicieux ! J''ai suivi la recette à la lettre. Je nai juste pas mis d''eau. Ils sont super moelleux ', '2018-05-30T07:19:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315229, 8429b978-f868-4e0c-9c8c-b42c925109a5, 'Vraiment bon. Moi qui aime les cookies moelleux c''est parfait', '2017-11-22T19:40:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315229, ad3bdf1d-dfb0-45f6-9a6e-30be24640f16, 'Pas bon du tout. Je n''ai pas apprécié. le gâteau est mou, même en le laissant un peu plus au four. Le goût n''est pas terrible et on prend beaucoup le goût de la maïzena.', '2016-03-31T03:53:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315229, 727d5802-f9b1-4e1c-a1c3-291ec00a3038, 'Merci c''est excellent! J''ai suivi la recette à part pour l''eau j''en ai mis moins. Les cookies sont très moelleux et c''est très bien je trouve. J''ai fait 12 cookies et le bonheur de ma famille! Pour moi qui est intolérante au gluten ça me permet de varier les gâteaux et de me faire plaisir. ', '2015-04-12T17:06:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315229, aff8538c-5490-4d81-b3d6-890d728fdd5a, 'Super bonne idée la banane et la noix de coco dans les cookies, on a adoré même si je n''ai pas suivi la recette à la lettre (je suis habitué à faire mes cookies avec du beurre et 1 oeuf et sans eau). Ils étaient très moelleux grâce à la banane. ', '2014-04-01T21:27:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11934, 88c2de7d-f3bc-4902-abd6-8bba63e7613a, 'J''ai testé sans poulet car j''en avais pas dans le frigo et c''était très bon aussi ! J''ai peut être abusé sur le piment mais du coup ça m''a fait pensé a une recette mexicaine ! Mélange original à refaire !', '2015-09-10T22:45:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11934, 1e9d6d8b-d088-4809-828f-e0c6bc461674, 'Délicieux ! Je n''ai pas lésiné sur le piment (on aime bien ce qui est pimenté), 1/2h (et non 45 min) de deuxième partie de cuisson a suffi, et avec les patates douces et l''ananas comme indiqué dans la remarque c''était parfait.', '2014-12-14T09:36:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11934, 72b7156d-2444-474a-a74d-a6bb551a469c, 'C''est bon, j''avais peur que ce soit épicé avec le chorizo et les piments mais leur goût piquant s''efface un peu. La banane ne contraste pas trop avec son goût sucré, qui s''efface aussi un peu mais le tout est très réussi, le mélange des saveurs rappelle une recette du sud !', '2012-02-04T00:10:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11934, fba819bb-2b8d-420a-a030-f061a9e2c65d, 'Je n''ai pas mis de chorizo mais plus de bananes. Il faudrait ajouter avec les bananes un peu de sucre. Lorsqu''on saisit la viande il faut ajouter du sel sinon dans le plat la viande fait un peu fade. Sinon accompagné de riz pilaf, c''est très bon.', '2003-03-07T09:09:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11934, ae2c2aa7-c53a-4466-afe1-b99bd0490881, 'Pas mauvais, mais je ne recommande pas le chorizo. Avec plus de bananes, ça aurait été meilleur...', '2002-08-23T20:29:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11934, 6462d97f-5a10-4f9b-ba4e-8301c2693041, 'Original, bon et facile à faire.', '2001-02-17T17:37:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, 3ca3fa2a-fbdd-4ff6-9632-f9be92a99dd4, 'En remplaçant la pomme par des fruits exotiques (litchi, mange, papaye) c''est toujours un succès !', '2020-01-25T12:32:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, b7ccbe1a-b6eb-457c-a918-f4e45dacf527, 'Cette recette a eu un grand succès! Le lait de coco neutralise l''acidité du citron vert, un vrai régal! Je n''ai pas mis beaucoup de crème car ça faisait déjà pas mal de sauce. Je l''ai faite sans le gingembre et la menthe. ', '2014-04-27T16:08:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, c40dc6ca-05af-4870-875a-eb06a80f1f66, 'Cette recette a toujours autant de succès !', '2012-12-01T19:28:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, 0756e25d-8e65-4fb7-bcd3-7d7c17f10dd5, 'Une recette à conserver ! ', '2010-11-30T22:37:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, f9a373d4-bba8-4be6-a824-af229faef98c, 'Pour moi, cela allait de soi qu''il faille éplucher la pomme! N''ayant pas de gingembre frais, j''ai également mis du gingembre en poudre. J''ai suivi vos conseils et ai ajouté des raisins secs noirs (préalablement trempés dans de l''eau chaude) au riz. Tout cela servi avec un bon petit vin blanc, un régal! Merci pour cette recette simple et savoureuse.', '2009-09-27T23:23:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, baa20787-531b-4c57-b765-56372170597c, 'Très bonne recette. Il faudrait cependant éplucher la pomme, la couper en tout petits morceaux et peut-être ajouter une deuxième banane. Fait avec des amandes effilées (qui donnent du croquant) et du gingembre en poudre. A refaire.', '2009-06-21T21:35:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, fadc050e-1348-4623-9e30-7d491a36d0a8, 'Que dire... Mes papilles en rêvent encore! Un vrai délice!', '2009-02-23T23:00:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, edc61f4b-4048-41d5-81fb-467d367804e4, 'Un vrai régal, j''ai juste mis cinq fois plus de menthe.', '2009-02-15T20:38:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, b327f730-e091-4d8b-b8ee-2c1bea854d87, 'Très bonne recette que j''ai simplifiée en ne mettant ni crème fraîche, ni amandes. Serviz avec du blé, elle a été apprécié par les petits et grands.', '2008-07-14T16:06:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, 5e19cdc6-5812-4ad3-9252-95d69547259b, 'Très bon ! J''ai mis de la pâte de curry et comme je n''avais pas de poudre d''amande j''ai mis des amandes effilées. J''ai prolongé un peu la cuisson. Miam!', '2007-10-12T22:49:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, 340817e5-eaaf-4165-94c5-13f5a0e23ad5, 'Simple et délicieux ! Un peu sceptique quand à la pomme verte mais cela s''avère une excellente idée ! Bravo et merci !', '2007-05-29T18:47:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, 70664bd7-3026-4f7c-9a50-363dd60f9317, 'Un régal !!  J''ai suivi exactement la recette, et nous avons vraiment adoré. Merci pour cette recette !', '2007-02-16T21:41:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, 977e3a79-55a6-498f-9bdd-06a35167fb87, 'Délicieux et très simple à faire!', '2007-02-11T15:25:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, e31c617c-c10d-4bbf-ba50-2fe64c21f94b, 'J''ai confondu deux recettes! J''ai donc remplacé les crevettes avec le filet mignon de porc que j''avais acheté mais c''était excellent ! J''ai aussi zappé les amandes et la menthe. Mais le mélange pomme/banane/lait de coco est une super idée donc merci ! ', '2007-02-02T16:51:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, 6c1b35f8-ef05-4cc0-b2e3-e660c39662de, 'J''ai rajouté de l''ananas et servi avec des nouilles chinoises. Un vrai régal.', '2006-10-23T20:55:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, 727d8e54-eb56-4dd0-8901-7c920855619c, 'Délicieux, recette à garder. Toutefoi, je la ferai la prochaine fois sans banane, le goût de la banane masque un peu celui des autres ingrédients...', '2006-05-15T00:19:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, 9bca510f-5964-4380-a2b7-36516c1ac9a8, 'Délicieux et facile à faire!', '2005-08-07T14:52:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, d004f548-6bb0-4bf1-aabb-c172c218ecb1, 'Excellent ! Facile et originale, la recette a fait l''unanimité.', '2005-05-18T17:37:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, a835a8d1-ddec-47d3-b137-616dd1fbd873, 'Un délice, je n''avais pas assez de pain pour la sauce...', '2005-04-21T02:48:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, f4094f16-df57-43d6-914b-3ae228c550d8, 'Bonne recette originale et parfumée, la banane donne vraiment une touche sucrée délicieuse. Je n''ai pas mis de poudre d''amande, je ne voyais pas ce que cela apportait à la sauce.', '2005-02-24T20:18:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, e2bb0eb0-53e8-41b0-89bb-44ee49ab159a, 'C''est délicieux et très original! Personnellement, je n''ai pas mis l''amande en poudre (5 euros le petit paquet, c''était trop cher pour mon pauvre porte-monnaie!) mais c''est tout aussi bon! Les fruits sont fondants, un régal!', '2005-02-02T22:16:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, 2ebb2435-d8cd-4922-a8de-5617700b9a53, 'Très bonne recette: la sauce est délicieuse, très parfumée. J''ai fait la recette sans banane et avec du jus de citron jaune... C''était succulent! Osez l''exotisme de cette recette venue d''ailleurs.', '2003-11-25T00:56:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15206, a6aed556-ff96-4e0f-ba96-a039e75861ad, 'C''est notre amie Michèle qui l''a concocté. Merveilleuse réussite, nous nous sommes régalés!!', '2003-09-07T21:35:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (310861, e989090c-e28b-4408-910b-ce86f7cdae0f, 'Recette sympa quand on a jamais cuisiné d''igname. J''ai gardé de la sauce de coco et le jus des légumes pour que cela ne soit pas sec.', '2015-01-24T19:45:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30499, 2a9ddd86-7302-4ad7-8898-406eb3b571b0, 'Pour une petite tarte: 1 banane bien mûre en tranches, un mélange cacao/noix de coco, une pomme en tranches fines, et un peu de confiture chauffée pour faire briller après cuisson. Précuisson pas nécessaire. Ce n''est pas la tarte du siècle, mais ce n''est pas mauvais du tout...', '2021-03-21T10:39:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30499, 3510a304-bebc-48b2-a9e0-19d9a1ded432, 'Je n''ai pas du tout aimé... Pas du tout du tout !', '2015-01-03T17:46:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30499, 8155a430-76ba-4238-8672-634a843fbfe2, 'Très bon mais assez consistant. A déconseiller à la fin d''un repas bien chargé. Par contre pour un goûter c''est sympa pour les enfants.', '2006-11-14T18:00:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30499, 17ba1a7c-b4d5-4034-a5ac-b93337a14561, 'C''est assez bon, j''ai trouvé cette tarte assez sèche au goût mais mes invités ont bien aimé. C''est une question de goût, mais très facile et rapide à faire, merci pour cette recette.', '2006-09-24T14:12:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30499, 595a18a7-c46b-494a-9a87-a61e52e476c2, 'Très bon et en plus facile à réaliser!!', '2006-04-23T20:32:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30499, 86fe566d-e226-4273-872e-c25ddd06dcd8, 'Pas mal du tout!! Vraiment simple et bon comme tout! J''ai mis des amandes, car je n''avais pas de noix de coco, et ça passe très bien...', '2006-04-22T19:41:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30499, 60b3e72e-cabd-4cef-80df-568224309d87, 'Très doux mélange des 2 fruits... Je n''avais pas mis de chocolat pour faire plus léger, et ça passe très bien aussi!', '2006-04-07T20:13:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30499, 55ed5b50-b5cd-4d70-b98f-a3b886151dc4, 'Super bonne recette! Très facile et surtout délicieuse!', '2006-04-04T19:18:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30499, 76c8b15d-6fc7-416b-83e7-c6ade4fc5def, 'Très facile à faire, et délicieux, surtout tiède! 4 bananes suffisent, avec des copeaux de chocolat à la place du cacao, le tout saupoudré de cannelle.', '2005-10-25T22:56:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30499, c3c6e958-1363-4938-83f3-f5d61d4d2e5d, 'Le "mariage" bananes/pommes ne m''a pas plu (je n''avais mis que 3 bananes mais c''est encore trop) le chocolat en poudre, bof, je pense qu''avec du chocolat noir ce serait mieux...à affiner!', '2005-10-09T22:24:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30499, 90d30ff7-c7b4-4bee-950c-4d029805ce02, 'J''ai fait la tarte ce week-end... D''après tous mes invités, il y a trop de banane, 3 seraient l''idéal, il vaut mieux mettre des pépites de chocolat à la place du chocolat en poudre que l''on ne sent pas vraiment. Il faut aussi prévoir un grand plat à tarte car les quatités sont généreuses. Sinon, l''ensemble est malgré tout très bon et original. J''ai aussi fait cuire un peu plus longtemps.', '2004-11-07T22:38:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30499, b02edccd-6a09-4eed-b500-6ed5d5b917d4, 'Très bon, même en utilisant des bananes pas forcément ''très mûres''.', '2004-10-29T16:37:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30499, 9a6592fe-678c-4da2-867d-8736729dbcec, 'Mmm, avec un peu de cannelle, ça déchire!', '2004-10-09T16:49:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30499, dbd58a4f-81af-4017-9b12-60b4549d9ab9, 'J''ai rajouté un peu de sucre et de la crème fraîche juste avant de servir.', '2004-09-26T20:36:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30499, 22924b3e-e9ae-4399-916e-911d88610947, 'Très bon et très simple, c''est ce qu''il faut faire quand il vous reste une banane bien mûre ! (le mélange chocolat est délicieux dans une crêpe...)', '2004-09-12T22:29:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18890, 27b4428b-3e14-400a-a10b-4ba91a15b1dd, 'Ce cake est trop gras et copieux. Je ne referai pas de gâteau à la banane, car je trouve que ce n''est pas parfait dans un dessert...', '2004-04-08T11:53:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166094, 2c55076c-b443-4bd6-ba43-d8fe6d1c6a1d, 'Super👍 facile et ingrédients facile', '2022-01-08T18:47:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166094, c1071e6c-db12-49e6-89f8-e82ac6274a94, 'Recette très moyenne. Changeante selon le yaourt choisi, liquide même en ayant retiré 75gr de yaourt de base ... Peu convaincue !', '2019-06-21T22:31:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166094, ef51bb46-d448-4ced-8750-6603f69d65be, 'La recette donne une mixture liquide, sucrée. Ce n''est pas une bonne recette !', '2017-03-21T08:30:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (171550, 15a52534-208f-4f96-9690-95753f32b2c5, 'Dessert très original. Je referais certainement ce dessert en y ajoutant un peu plus de noix de coco', '2013-11-18T16:24:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, a19e9754-c830-4db2-90e0-c0c72fc4040a, 'Je l''ai faite de la manière traditionnelle, c''est-à-dire dans une poele en fer qui est ensuite passée au four. Je suis très déçue par le résultat, qui à mon gout n''a aucune finesse. Mon ami a aimé mais pour moi ce plat n''avait aucune texture, aucune variété dans la saveur. Les bananes et les oranges se révélant tous deux friables à la cuisson, je me suis retrouvée plutot avec une "compote tatin" qu''autre chose. Le gout était très enfantin - trop ! Incomparablement moins bon que le tatin de pommes classique.', '2012-04-03T00:53:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, aa2e01f8-287f-401d-b2ac-967c5ab071cd, 'Pas mal du tout ! Et très simple à faire !', '2009-12-27T23:14:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, 4bd8f09b-e74b-48f9-86eb-2f20ee1da058, 'Très bon!', '2007-02-05T12:31:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, 49d91399-bf65-41a1-9eeb-237124a279c1, 'Bon, mais côté présentation très moyen, le jus des oranges a fait ramollir la pâte...', '2006-04-17T16:16:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, 22e4f453-30a3-4eca-95be-5c2c2e7a5e57, 'J''ai préféré remplacer les oranges par des abricots en boîte!)pour avoir moins de jus... délicieux ! Les enfants adorent!', '2005-08-15T21:28:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, b50e923c-6cfb-48c2-a225-beaa2eb66601, 'Un délice! J''ai rajouté une pomme et le mélange des fruits était succulent. Cependant, il y a beaucoup de jus et la tarte ne caramélise pas...', '2005-05-14T22:58:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, 230ea170-82c7-47e5-904d-5c8da8d57ce4, 'Très facile et rapide à réaliser. En remplaçant les bananes par des pommes, le résultat est délicieux également.', '2005-03-09T20:12:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, bfa15dd9-1437-43b7-817b-d9efeef4733e, 'Un véritable délice à déguster sans modération. La banane se marie bien avec l''orange.', '2005-01-30T21:53:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, 90b41b5e-79b1-47e9-b3d3-f40d3f7900af, 'Bon! Banane et orange ressortent bien, pour le renverser attendre plusieurs minutes plus de problème avec le jus. Juste un souci: l''orange était un peu amère si quelqu''un a une solution?', '2004-11-14T20:38:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, 371bee36-e39e-482b-8613-f1a0e12540b2, 'Les oranges ont le goût de banane et même épongées, elles rendent trop de jus!! Dommage!', '2004-10-10T13:32:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, e413a8aa-89aa-40eb-89aa-56280b75b519, 'Attention! Ne renversez pas la tarte, vous feriez couler le jus et ce serait dommage tellement c''est délicieux.', '2004-06-08T11:28:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, 9b8b154a-85cc-4418-9b55-8cdb97247135, 'Très bon et facile à faire.   Accompagner d''une glace vanille.', '2004-02-23T14:04:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, 58375497-04e6-46d4-b9c0-ef6e0d713f89, 'Facile, mais aussi délicieuse. Que demander de plus!!! ', '2004-02-14T12:12:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, 55504af5-396e-4815-a4ca-3467ec2971c5, 'Bonne idée, mais manque de précisions: mettre je pense un bon 100g de sucre (ou 50g de substitut). On peut utiliser aussi des kiwis. Préchauffer le four à thermmostat 6 (180°C) pendant 15 mn et laisser cuire 20 mn.', '2004-01-27T18:30:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, 57f5270f-062d-4a8a-97b7-8c0dc8c7b269, 'Comme Céline, j''ai employé une pâte brisée. Sinon j''ai du adapter aux clémentines (à la place des oranges) Faut éponger les agrumes, effectivement, mais au bout du compte une chose est sûre: c''est bon!!!', '2003-03-27T21:58:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, 4d7743e5-42b8-4624-96f6-ce9e0d7f5179, 'Excellente même qu''avec des bananes. A servir tiède accompagnée d''une boule de glace vanille.', '2003-02-20T16:07:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, 54ef1d6b-1045-40b0-bb8f-7babb77e7d8b, 'Mettre du sucre en faible quantité (avec aussi du sucre de canne). Il faut éponger les oranges avec du sopalin et mettre le four à 190/200°C pour bien saisir les oranges qui sont très juteuses. Pour le reste, vraiment très bonne et originale!!!', '2003-02-06T15:08:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18394, 0ebe8375-d00c-440d-866c-d4a8fc58755f, 'Très bonne idée de tarte tatin, cependant il faut faire quelques changements... Prendre plutot une pâte brisée et penser à légèrement éponger les tranches d''oranges, car sinon la pâte ne cuit pas, les fruits deviennent de la purée et le sucre ne caramélise pas.', '2002-11-30T09:31:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41769, f498f7e5-60b0-4ebf-8ddf-9385bff2f283, 'Très bon. J''ai ajouté un peu de piment parce que le curry en ma possession est très doux. Et en plus des morceaux de banane, j''ai rajouté quelques morceaux de pomme et de clémentine.', '2020-12-28T15:03:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41769, 614919df-656b-477c-a965-43d0a393dca1, 'Très bon! Les enfants ont adoré.', '2018-02-11T02:36:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41769, 983aa7f1-bc9a-4801-97f6-6e383d078b4b, 'J''ai adoré, le poulet était très tendre, et la sauce pleine de saveur, je n''ai pas mis de banane, je n''ai pas mis non plus tout le lait de coco et c''était excellent, je recommande cette recette !!', '2013-11-01T15:17:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13495, 32fccaa6-06d5-4ff3-9221-ebb9f4d7373e, 'J''ai essayé mais le résultat n''a pas vraiment été à la hauteur de ce que j''attendais. J''ai trouvé la sauce trop épaisse...Peut-être qu''il fallait hacher plus menu les oignons? Faut-il épépiner les tomates? Quand ajouter les gousses d''ail? pour les super novices comme moi, quelques précisions auraient été les bienvenues... Surtout à une heure du repas! Par ailleurs, que fait-on du reste du court-bouillon, on le jette? Et quels en sont les ingrédients?', '2004-03-11T11:15:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13495, a0cdde1e-fdba-4ae8-860d-7f1460dd4272, 'Très bonne recette, visuelle, goûteuse, comme dans les îles.', '2022-12-21T18:20:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13495, c2e74093-a6a7-4ef4-aaad-20b7d08dbeed, 'Énorme.... même sans cari ni coriandre fraîche !!! A refaire vite, merci pour le partage.', '2018-02-07T10:05:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13495, 6076a2f6-62f4-4ac9-ba57-168dd0bf32b6, 'Excellent. Pas de lotte sur le marché, j''ai remplacé par de la Julienne. Très bon aussi', '2017-09-17T16:25:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13495, d73b9dd9-0c4c-4073-bede-8a0b279ba93c, 'Un délice sucré salé, à refaire en suivant les proportions, merci !', '2016-12-11T21:23:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13495, 2f975af9-c885-401c-bc68-e0a434449259, 'Délicieux, fin, facile à faire et original... que demander de plus.', '2009-05-03T14:09:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13495, 6a941976-b5f1-4570-bc14-d0134e7f2a68, 'Fait avec des filets de lotte surgelées (1kg), pomme en petits morceaux, sans coriandre fraîche (je n''aime pas cela). Délicieux, original, tout le monde a adoré. La prochaine fois j''essayerai en doublant les épices.', '2008-05-31T14:04:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13495, 9237e0c0-9459-48d9-aee7-9effa9e39c36, 'Facile à faire et très bon. Faites-vous plaisir.', '2008-04-23T11:39:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13495, 2f3ae693-cd52-4a4d-b749-f44427f9e7d7, 'Très bon, j''ai coupé les pommes et la banane plutôt que de les râper. La recette se fait très bien la veille et se réchauffe 15 min sur feu doux le jour même, super pour gagner du temps!', '2006-02-27T12:59:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13495, 173c7b86-41c7-4571-87b9-fbd359b5916c, 'Excellent, n''oubliez pas de saler.', '2005-09-20T16:13:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13495, 4125b4f2-9bc9-4b33-844f-f981e973f943, 'C''est vraimment très bon, facile à faire et rapide. Un plat très populaire chez nous aussi parmi ceux qui n''aiment pas le poisson. J''ai également essayé avec du poulet et c''est aussi bon.', '2003-04-16T16:33:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56861, 7aa8a00f-7f78-4999-9356-a6ddcd3acccf, 'Bon mais encore meilleur quand il sort du frigo ', '2022-06-30T16:50:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15131, 26c02457-9739-45fa-a286-bd382f6f6cd6, 'Recette absolument irréalisable !!! 400 g de poudre de coco avec 1/2 l de lait, on obtient une pâte totalement sèche, impossible à faire bouillir. J''ai du rajouter 1l de lait pour essayer d''en tirer quelque chose. Du gâchis.', '2014-03-16T12:15:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15131, a1528bf5-9e94-464d-8419-58a1a46bd0a8, 'J''ai bien aimé cette recette. Pour l''amiliorer, j''y ai rajouté une gousse de vanille dans le lait. A l''avenir, je mettrai un peu moins de citron, qui pour moi masque le goût de la noix de coco.', '2002-08-08T18:03:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35990, 9e057ceb-36b6-428d-b83b-2a0b7a2369e2, 'Petit conseil: couper la banane en quatre dans le sens de la longueur, sinon risque de purée à force du temps.', '2008-05-10T14:16:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35990, 02fe245a-12f0-4d66-ae27-cbd868b81c3b, 'Bonjour,
Autre petit conseil, prenez une bouteille de 1,5 litre.', '2017-07-08T20:06:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35990, 1b6670da-0af6-41af-ac0b-c2fdab2f4e7f, 'Recette très bien et facile.', '2020-01-14T00:26:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35990, 9e72e0bc-76ee-4c63-8cd8-2692aa8578eb, '1 banane et 4-5 banane naines pour plus de goût sucré. Et du sucre roux (quantité selon le goût) ', '2018-06-27T07:55:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29606, fee960c4-fcca-4abf-9d6e-99ecfc85e1c5, 'Facile et excellent ', '2021-11-04T19:31:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29606, 0918073f-2bfd-4db0-adaa-690876b7afc4, 'Comme je ne savais pas la consistance que devait avoir ce gâteau j''ai cru l''avoir raté (il reste très mouillé). Mais l''ayant servi hier à la rencontre Suisse, on m''a confirmé qu''il devait être tel que présenté et qu''il était très bon.', '2006-07-09T12:14:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 4057ac63-6d53-4f9e-b564-7ebeae0c03d3, 'Personne n''a aimé. Trop lourd. Le visuel et les textures sont pourtant parfaites. Peut-être à faire en mini verrines. ', '2014-10-05T22:56:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 7344099f-0899-4a96-854e-4eed79f892c2, 'J''ai fait un essai avec de l''ananas frais... Les fruits ne sont pas indispensables mais comme il faut manger 5 fruits légumes par jour... En revanche, le lendemain, c''est une tuerie... Les 3 chocolats se bonifient. Il est préférable, si on sert seulement le lendemain, de garder des crêpes broyées pour la déco supérieure, juste avant de servir. ', '2014-01-01T21:40:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 59201257-0d93-4247-a4f3-38a89a9e9c8c, 'Tout simplement mmmmmmmm, mon mari en raffole !!!!!!!! ', '2013-01-09T23:34:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, a6153e82-899a-4405-8c23-430dccbbf533, 'Une vraie réussite une très belle esthétique ! Merci pour cette recette. J''ai effectué une petite modification néanmoins, n''ayant pas de crêpe dentelle j''ai mis de la praline ce fut un délice.', '2012-08-03T02:17:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 0c110697-7058-4467-841e-b498cf895450, 'C''est original.  ', '2012-07-18T12:26:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 51f9efda-606a-4887-aac8-57bbc8ece147, 'Beaucoup de préparation pour un dessert bon mais sans plus.', '2012-07-01T13:59:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, ccc2929e-7494-4b20-83da-74f6ed7bf47f, 'Super recette, j''ai utilisé des poires au sirop que j''ai glissé entre les couches de chocolat. A la place du chocolat au lait j''ai mis du chocolat au caramel, et des spéculoos à la place de la dentelle. Petits et grands se sont régalés.', '2012-01-06T13:43:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 13a7db1e-3857-44f0-85f4-b3fe4f063508, 'J''ai proposé cette recette pour la Saint-Sylvestre et ce fut un succès. Je l''ai servie en petite verrine accompagnée d''une crème brûlée à la clémentine et à la cannelle et d''une mini-tartelette au citron. Tout le monde a adoré ! ', '2012-01-04T12:14:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 7268c146-6422-474a-be15-f24d15b1771f, 'Excellent, que du bonheur, un mélange de textures, de goûts et de saveurs ! J''ai interposé mes fruits entre les différentes couches de chocolat. Du coup, le rendu est très frais avec les différentes textures qui se marient avec la fraîcheur des fruits ! (Kiwi, choco noir, poire williams, choco blanc, pomme golden, choco au lait). J''ai zappé la dentelle de crêpes. Il n''y a que comme ça que je la refais cette recette.', '2011-12-25T14:43:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, d7c4ea6d-f80d-49f7-8f9a-439a46682115, 'A chaque fois un vrai succès ! Tout le monde me demande la recette ! A faire en petite quantité, dans des petites verrines car tout de même assez lourd !', '2011-12-23T13:41:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, be3c3fee-05e9-4d95-afb3-39de02a6508a, 'No comment, recette vraiment extra. Faite au choix à la poire ou aux framboises', '2011-12-08T13:57:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 2c67a53b-b512-4966-be32-d6d6efdfead9, 'Tr7s bonne recette !!!', '2011-07-20T03:04:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 7346bcfe-4327-4d84-bed7-ee45d08364f5, 'Un vrai régal et à chaque fois un succès !', '2011-01-03T22:16:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, f264740d-b079-4b28-bfc3-97d6004bf60c, 'J''ai bien suivi la recette mais je n''ai mis que des fraises, comme fruits. C''est bien agréable et très frais. Je les ai faites la veille. Par contre, c''est beaucoup de travail et je me demande si ce ne serait pas meilleur si on met des fruits entre chaque couche de chocolat. C''est ce que je tenterai la prochaine fois !', '2010-05-18T14:03:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 2427e3f1-4459-40db-b4a0-627f077d1e84, 'Je n''ai pas trop aimé, j''ai trouvé ça très lourd... dommage...', '2010-05-18T13:09:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, f5e68d85-9325-4426-bb64-7621d31b7297, 'J''ai préparé cette excellente recette pour notre dessert en ce jour de Pâques ! J''ai utilisé des fraises : fraises et chocolat font bon ménage. Rien à redire, c''est succulent et facile à faire. La prochaine fois, j''utiliserai de plus petites verrines, car c''est un dessert très copieux après un repas copieux.', '2010-04-04T17:23:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 7170d19d-08d6-49c6-a080-25efbd818333, 'J''adoree !! Je l''ai déjà fait et c''est super bon !! C''est long mais ca vaut le coup', '2010-04-01T18:36:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 84737635-48ca-4640-a66c-325107fa5810, 'Juste DELICIEUX! Avis aux amateurs de chocolat! J''y ajoute un peu plus de fruits au fond de la verrine et du chocolat noir râpé finement sur le dessus. Tous mes convives sont ravis. Petit conseil, préparé 24h avant c''est encore meilleur.', '2010-01-16T15:56:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 5dcea44d-f1a3-49a0-968c-92e3c4a5a155, 'J''ai fait au choix des verrines à la framboise ou à la poire. Le résultat est épatant tant au niveau visuel que gustatif. Bravo pour cette recette !', '2009-05-14T13:03:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 4792f8f2-55a4-4664-bcd5-7c5140db90eb, 'Alors là c''est sublime, vraiment rien à ajouter juste à refaire sans hésitation. Je commence à en faire la pub au près de mes amis j''attends le verdict, mais je ne me fais pas de soucis.', '2009-03-09T21:17:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 7f1b5112-fe72-49cd-b0c4-a3e6471dff69, 'J''ai fait un mélange de banane, poire et kiwi, et pour huit verrines j''ai dû en cours de préparation, doublé les proportions. S''il y en aurait eu de plus tout serait parti. A refaire.', '2009-03-09T12:16:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 1973c3b9-01c0-4557-87dc-8d925eed94a6, 'J''ai préparé ces verrines le 23/12 A.M. pour les déguster le 24 au soir compte tenu du temps de préparation. C''était sublime! Les invités m''ont complimenté. Super recette et très facile à faire. A refaire sans hésiter.', '2008-12-26T12:35:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, 4fb2a19e-a4e4-48da-9221-9edfc08d5235, 'Et je pourrai mettre encore une note plus élevée tellement c''était succulent! Digne d''un grand chef ! Mes invités ont tellement apprécié qu''ils se sont partagés les 2 verrines que j''avais fait en plus ! Cette recette, je la mets dans mes tops du top !', '2008-08-30T21:47:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69781, e98830a5-82f8-44cc-8b57-6825f686b6d2, 'Un vrai régal ! J''ai fait aux choix des verrines aux fraises et aux poires, pour tous les goûts... Par contre, il faut prévoir un peu de temps de préparation... A refaire !', '2008-05-04T11:32:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67924, e4c5ce74-5674-43f0-9481-11c84e0bc9ba, 'Excellent ! J’ai suivi la recette a la lettre une merveille ', '2020-11-05T19:31:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67924, b4a59429-eaa4-40bd-80d2-e2728d44f00c, 'En suivant la recette à la lettre je trouve que c''est loupé. Le pudding n''est pas monté et trop de rhum à mon goût. J''adapterai à ma façon la prochaine fois. Mais le mélange banane chocolat est toujours efficace.', '2018-11-06T07:53:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67924, e75a1ee6-0dfd-4756-9715-f3582cdef64a, 'Découverte par ma fille de 10 ans, cette recette très simple est très bonne, je la conseille !', '2013-01-27T22:51:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67924, 75b3feb0-4c21-4e4a-8ae4-a2583d449fc1, 'Très bon et vite fait, j''avais un vieux rhum de la Martinique encore meilleur (enfants vivant à la Martinique) - merci encore et bonne année 2013 - beaucoup de réussites et de bonnes recettes', '2013-01-24T17:03:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67924, 0a6af84a-6ea4-4c87-ace7-ed87bfe2ef38, 'Trop bon, vraiment je vous conseille cette recette. Je n''ai ni mis de rhum ni 8 mais 6 bananes. Mon frère a même piqué un pudding en cachette alors qu''on en avait laissé à mon père !', '2010-05-13T00:50:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67924, 5df1f3df-ad4e-4bd8-9798-e7dc11ef15e5, 'J''ai adapté la recette à mes goûts (6 bananes, 2 cuillères d''huile, 1 cuillère de rhum) et augmenté le temps de cuisson de 20 minutes. Ce pudding est délicieux et très simple à faire. Très bonne recette !', '2010-03-27T14:14:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67924, 7d1497f9-fd33-440f-b653-93969cd3e64d, 'Excellente recette aux bananes, pas trop sucrée, pas bourrative. Je la referai. ', '2010-02-27T10:19:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67924, 6c3a6e50-6c65-4e24-984e-d8c4cf85292d, 'Très bon, mais j''ai augmenté le temps de cuisson un peu court sur la recette!', '2008-09-14T04:58:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67924, 45b3adfe-5695-4fc5-878b-6eb4963df74c, 'Avec des bananiers dans ma cour, je ne savais que faire des bananes et toutes deviennent mûres en même temps... Enfin une recette qui permet d''utiliser facilement beaucoup de bananes et tout le monde en redemande. J''en ai fait plusieurs et je suis même allé jusqu''à 10 bananes : un régal!', '2008-03-18T06:59:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22775, 26313c48-b721-4ec2-b699-697e27fc88b5, 'Beaucoup trop sucré. Déjà, les bananes sont sucrées, mais alors tout ce sucre en plus, ça fait trop.  J''ai remplacé le beurre par de l''huile.  Il y a beaucoup de liquide au fond.  Il faut faire cuire moins d''une heure, sinon ça crame. ', '2012-10-04T16:36:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22775, 4b7a7ad7-213b-435f-a0e5-6a20d23056ff, 'Bof.... A la sortie du four, les bananes nageaient dans le beurre, et le jaune d''oeuf n''avait pas cuit (125°C)... On peut sans problème diminuer les quantités beuure/sucre, les proportions de base sont très généreuses. Idée de départ pas mauvaise cependant. Je réessaierai, en ajoutant de la farine au mélange jaune d''oeuf/beurre, et en le faisant cuire à 150/160°C, pendant 10 min, avant de mettre la meringue.... Ou alors, version sabayon, pour le mélange jaune d''oeuf/beurre, en le faisant prendre à la casserole, avant de le mettre sur les bananes...', '2006-01-18T12:09:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72804, eeb1aede-0fb2-412e-8eed-2eeb8a5885e4, 'J''ai réalisé votre recette avec les bananes, avec des petits dès de pomme légèrement caramélisés ?C''est exquis !', '2021-01-22T22:23:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72804, 511b6b8e-1083-4f31-8374-6c517441c81f, 'Beaucoup trop sucré, déconseillé aux diabétiques...', '2020-11-20T21:50:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72804, 919a1895-eae4-4979-8dcf-4ee340342a27, 'Écoeurant, même avec 130 gr de sucre.', '2020-03-15T17:06:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72804, c795d81d-cc0b-441e-914f-a71546fff7a5, 'Personnellement j''ai émietté des pséculoos sur les bananes, puis j''ai mis la crème de mascarpone et rajouter la noix de coco dessus (puisque dans la recette on ne nous indique pas quoi en faire... Et de nouveau émietté des speculoos', '2018-06-05T20:28:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72804, 30fb33d8-4329-477f-b152-7f23454683f4, 'Délicieux tiramisu onctueux que j''ai déjà fait à plusieurs reprises et qui ravit tout le monde. Le jus de citron mélangé à la banane donne plus de goût. Je mets le speculoos en poudre sur 2 couches pour le rendre plus esthétique. ', '2016-05-09T20:08:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72804, bff6cc42-3edc-4611-9d74-dbdbb716c33d, 'Bon mais sans plus ! ', '2016-04-22T12:39:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72804, 80ecb4cc-4937-44d7-ae5b-08dbdd4d92a0, 'Très bon dessert ! J''ai mis des spéculoos émiettés en couches entre la banane et le mélange mascarpone et c''est un régal !', '2015-05-27T14:39:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72804, 6d26ad5a-9990-4bf9-9d5b-99ab3a755eb6, 'Excellent ! Rapide et facile à réaliser ! J''ai ajouté des framboises coupées en deux ! C''est encore meilleur !', '2014-11-16T17:47:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72804, 9ecabc66-7e03-4ebf-8c16-35775a061520, 'Super bon ', '2014-11-13T17:29:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72804, aad13c9c-56a3-4f16-a02d-2f38a0716322, 'J''ai utilisé les proportions indiquées dans la recette de base. En effet il y a beaucoup de sucre.  J''avais ajouté des framboises, pour mettre un peu d''acidité. C''était du coup très bon !', '2014-03-13T13:01:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72804, 4912a695-d7b3-449b-a0d3-cc5be9a5e569, 'Excellent dessert, dans des verres super effet. Je n''ai mis que 100 g de sucre. A refaire rapidement.', '2013-02-11T12:46:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72804, 8b9c9329-330d-4c3e-adac-ed318bdeba40, 'Comme Elsa , j''ai mixé banane et spéculoos ..recette préparée en verrine , très réussi et bien bon !', '2011-01-16T12:09:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72804, f7aeea24-5cfc-4023-bc1c-2c1548c848b0, 'L''idée me plaisais j''ai donc suivi la recette mais il y a énormément de sucre je mettrais à peine 50 g. J''en ai mis 100 g et j''ai déjà trouvé ça très sucré', '2011-01-15T13:10:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72804, 3fedf9f8-cce1-4a96-a34a-14084656ef95, 'Très bon dessert; merci pour cette recette facile et rapide.', '2010-08-26T09:36:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72804, 5221591a-1ab4-451c-9c7f-063c2ae2d1d5, 'Il y a, à mon avis, un peu trop de sucre. Je pense que 125g suffirait car la banane est sucrée. J''ai mixé les bananes avec un peu de spéculoos et une cuillère à café de crème fraiche, c''était délicieux !! ', '2010-02-10T21:34:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165108, bf421716-90ee-46a0-bd52-4a49895ed7d4, 'Excellente recette, faite et refaite: toujours le même succès', '2016-02-16T19:52:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165108, b75a300b-d85a-4797-b47d-8169bf2c2b4b, 'Bonne recette. 2 pommes, pour confire compter + d''1/2 heure... Faire avec des joues de lottes cuite à la poële 4/5 mn par face.', '2020-09-06T17:56:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165108, 87ed00a9-bcc8-4af6-954c-311dce984fd9, 'Vraiment bon. J''ai fait 3 petites queues pour 2 et j''ai enlevé l''os avant de les mettre à dorer dans une poêle. Je referai sans problème.', '2014-07-21T16:38:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165108, 1a24d14f-d97d-47cb-9849-6815087c4830, 'Plat facile à réaliser, apprécié par mes invités.', '2014-03-26T14:11:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165108, 440b28c1-3faf-494a-a340-463d26c9e8c6, 'Accompagné de riz c''est vraiment très bon ! ', '2013-07-24T13:54:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165108, 531fbca0-c2b0-416d-9c12-4758118c9ffe, 'Excellent. Même sans banane, je n''en avais pas.', '2010-04-04T23:52:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211493, 10d73ac5-f0bf-4eb6-a69c-a980898e847d, 'Smoothie vraiment pas bon (à peine une gorgée de prise)', '2014-12-06T21:52:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56675, b85f4653-60e1-4063-9057-cd43809b45ca, 'Trop compact : serait sûrement meilleur sans les œufs dans la préparation au mascarpone!', '2008-11-29T16:52:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37561, cfaf698c-4f54-4a5d-b0a6-c266dc83f700, 'Je l''ai testé à Noël: un vrai succès. J''ai mis des abricots secs, des pommes et j''ai servi le tout avec de la semoule.', '2010-12-28T22:21:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37561, 938b1f72-d9b4-4ef0-86b8-a134b7adb46a, 'Recette qui a épaté les amis lors du réveillon. J''ai essayé avec des abricots secs, des pommes de terre et des pommes. Et laissé mijoter dans la tajine électrique 4-5 heures et c''est un régal, la chair se détache aisément, c''est confit et le sucré-salé a beaucoup plu.', '2008-01-07T22:51:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37561, 8cefc0cf-739c-435d-ba1d-9a2e6cbe85e5, 'J''ai réalisé cette recette avec des pilons de dinde car mes petits-enfants( 4 âgés de 3 à 9 ans ) se sont invités au dernier moment et je n''avais que deux cuisses de canard. J''ai mis 2 cuillères à soupe de cumin, des pommes de terre, des abricots et des raisins secs et laissé cuire 3 heures dans un tajine électrique.  Aucun restes..  ', '2006-05-03T17:31:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (225662, b474c159-36e3-4dee-adf8-153a82315db2, 'Ne pas oublier de beurrer les moules. J''en ai fait 12.Avec la recette pour 10 et j''ai mis moins de sucre 80 g.', '2021-02-23T13:37:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (225662, f4b276ee-fb7e-4eb6-8823-a038020c93a1, 'Très bonne recette ! Faire très attention avec le temps de cuisson moi je mets 17 minutes... Et puis on peut garder la même recette mais en variant les plaisirs donc super ! Même recette adopte pour des muffins choco cerises un régal !', '2019-02-26T15:56:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (225662, 0e676edc-9b33-4370-af48-e487bdd21385, 'Très bonne recette je n''ai pas utilisé le beurre et c''était excellent à refaire', '2015-02-22T01:27:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (225662, 0ea79c3a-1814-413c-aa70-5cc353da0217, 'Attention à la cuisson ! J''ai laissé 20 minutes et les muffins étaient trop cuits. Cependant, la recette bonne, à refaire!', '2014-06-22T16:12:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (225662, d2f6755a-3d94-4192-8b24-9a8088e9f916, 'Très bonne recette, on s est régalé. Je ne savais pas s''il fallait couper ou écraser les bananes donc je les ai coupe... Et j''ai bien fait ! Et j''ai utilisé le beurre (à peu près 10 g) pour beurrer les moules. À refaire !', '2013-01-20T17:57:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, c2280254-a6d4-4503-9346-67a5e69635ce, 'Chez nous on n''est pas très banane... Mais là.. Tout le monde en raffole. Fait et refait. Voici mon équilibre parfait à notre goût : je mets entre 75 et 120 g de sucre en fonction du mûrissement des bananes et du jus des pommes. Et surtout la touche qui exalte les saveurs, la (bonne) pointe de rhum. J''ai fait plusieurs tests mais vraiment le rhum embellit la recette. Et je trouve la tarte meilleure refroidie que tiède. Bonne gourmandise ! ', '2020-11-07T19:54:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, 1f8fe8c3-c41a-4624-acdd-701117d2ddd6, 'Très facile à faire. Modifications faites : 100g sucre et un peu de rhum ambré, crème fraîche épaisse environ 250 g, sinon tous les autres ingrédients identiques. Cuisson 15mn à 210 degrés puis 55 mn à 160 degrés. Elle est excellente. ', '2020-05-21T19:35:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, 66e64cce-29f6-4ef9-af95-f6ce6a7ec9b7, 'Excellent ..j''ai suivi la recette a la lettre ...une TUERIE..trop bon', '2023-06-02T20:56:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, fcefddb9-504b-4e5d-8cf8-aeadaecd5d01, 'Très bonne j’adore. J’ai suivi la recette à la lettre et elle était parfaite ', '2023-04-23T10:59:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, 858bba92-95bd-4a12-8550-240b0a17d999, 'Super bon. À refaire.', '2022-03-13T14:04:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, 5c30bb1e-9577-4624-a776-064fd0771528, 'Bonne petite tarte. Je l''ai laissée au four un peu plus longtemps qu''indiqué. Le goût des bananes n''est pas assez présent pour moi. Nous nous sommes régalé. Merci.', '2020-04-20T22:57:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, de936e35-3c95-49aa-af04-8172da421d9d, 'Délicieuse, j ai mis que de la crème fraîche et j ai rajouté un peu de fleur d oranger
', '2020-04-19T00:43:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, aa2e40b8-7424-475c-a980-88891061edc9, 'Tres bien. J''ai laissé cuire un peu plus ', '2017-06-04T21:52:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, 1e072f9c-477d-4870-8789-cf7fa4b6de55, 'Très bonne. J''ai mis 15 min de plus pour la cuisson. Je l''ai fait avec une pâte feuilletée. On a adoré. À refaire ', '2016-03-13T21:44:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, 9a93ba15-8078-4e9f-9e4a-0d0228ce3af2, 'Super bon ! très bonne recette ...', '2015-03-31T19:25:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, 18e90727-35ab-438a-a6dd-f992c2f55b6c, 'Effectivement j''ai suivi les commentaires et je n''ai mis que la moitié des quantités pour l''appareil de la tarte avec de la crème à la place du lait, 1 bouchon de rhum et 50 g de sucre en plus de sucre vanillé', '2015-02-06T22:39:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, 9ecb2748-dbc3-4431-9268-7a6e3c9814e8, 'Bonne recette !!! Je l''ai préparé avec une pâte sablée...', '2015-02-01T17:13:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, 7956e7f1-403b-477b-bc1e-6fa7736bdab8, 'Merci pour cette recette ! Tout le monde a adoré :) J''ai rajouté des pépites de chocolat, miam !', '2014-05-27T18:01:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, 7cfd5678-0ef2-4856-ae06-cca5423424a2, 'Très simple à réaliser.  Faire attention à la bordure de la pâte qui a tendance de retomber lors de la première cuisson.  De plus, il me restait un peu de mélange (sucre, œufs, lait) je n''ai pas pu tout mettre sur ma tarte. Délicieux!!! ', '2009-04-21T16:27:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, e1877da5-7329-459f-a29c-573bb2346b6e, 'Facile à faire ... Tout le monde s''est régalé! A refaire encore et encore! ', '2009-04-05T16:18:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, a980987f-032d-49e8-9464-ce857b8eef08, 'Délicieuse! J''ai mis 80 g de sucre et j''ai remplacé l''extrait de vanille par de la cannelle et je n''ai pas mis de lait...très bonne, on s''est regalé, ma fille a adoré! ', '2008-09-03T21:48:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, fb7ec987-7294-4945-b6da-9fb50ce6d96f, 'Mhhh délicieux et vraiment très facile à faire ! ', '2008-01-22T18:14:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, d9361381-014d-44c4-840b-17b14c69adaf, 'Très bonne tarte, toutefois j''ai mis 20 cl de crème et pas de lait, 2 sachets de sucre vanillé et seulement 50 g de sucre en poudre. Les enfants se sont régalés!!!', '2007-10-11T13:31:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, f792372e-42af-48a1-92b2-e644742adbe1, 'Cette tarte est très bonne, mais je n''ai mis que 5cl de lait et 50g de sucre.', '2007-09-29T23:16:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, 4f78280f-0526-41fc-925a-226a74ce682c, 'Délicieuse, le mélange pomme banane a ravis. par contre j''ai mis du fromage blanc à la place de la crème fraîche et sur la tarte, j''ai fais de la meringue. Un vrai délice. Ma fille l''a dévorée et mes amis aussi.', '2006-11-26T20:53:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, 21406b31-7e32-417f-8d73-598be11020ab, 'Très bon mais un peu trop sucré à mon goût.  50 g de sucre suffisent et c''est alors un vrai délice.', '2006-11-13T11:12:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51182, b6b997a7-54a6-4590-8ff0-fb13e423c16d, 'Tarte délicieuse. Par contre, je n''ai pas mis de lait et j''ai utilisé 200 g de crème fraîche au lieu des 150 g.', '2006-11-10T17:33:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, d916e6ad-c161-4352-b250-c133db7e0bd4, 'Personnellement, j''ai juste remplacé les noisettes par des morceaux de chocolat. J''ai trouvé cette recette très bonne et moelleuse. Cuisson 30 min dans des moules à muffins.', '2019-01-11T04:28:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, 771158b5-6170-4275-8ed0-648f9687d64c, 'Fameux !', '2014-11-13T13:51:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, 9f8091b0-9bfb-40d3-aef1-54535130495d, 'Délicieux et facile à faire, les enfants adorent. Gonfle beaucoup, aspect entre le cake et le pain. Un vrai régal.', '2014-03-29T08:48:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, cbd2840c-dd55-419e-8a4e-f56be5ca56b1, 'Comme quoi, les goûts et les couleurs... Pour moi, gâteau fade, aspect pudding, un peu sec... Vraiment pas ça quoi. Je ne suis même pas sûre qu''on arrivera à le finir !', '2011-09-29T14:06:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, 26d34f6c-1275-4085-96ed-0ef08987d79a, 'Très bon, ni sec, ni lourd, très moelleux, j''ai juste mis des noix au lieu des noisettes, et à peine brisées, ayant beaucoup de bananes, sur les conseils forum, j''ai même congelé de la banane écrasée pour en refaire cet hiver', '2010-09-11T13:28:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, 498e9b20-f20b-4e06-898b-2cef977a9279, 'Au lieu de mettre 300 g de farine, je n''ai mis que 200 g de farine + 100 g de maïzena. Je ne l''ai fait cuire que 45 min. Il était très moelleux et très apprécié par mes invités.', '2010-03-31T23:24:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, 22163b39-7f6a-433a-b900-2911ca8de401, 'Bon mais bourratif. Je referai avec des pépites de chocolats à la place des noisettes. Bien pour utiliser les bananes qui restent.', '2009-04-09T15:44:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, f93702d7-b90b-4f83-bfbf-7166dabc9ef5, 'Très bon gâteau ! Parfait le matin au petit déjeuner. Maintenant je sais ce qu''il me reste à faire quand j''ai des bananes trop mûres !', '2007-06-22T13:01:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, 8322e170-35e6-40ee-9f0e-f3aa64cbc197, 'Très bon. Je l''ai fait plusieurs fois quand il me restait des bananes trop mûres. La derniere fois, j''ai remplacé les noix par des pépites de chocolat... A refaire!', '2006-09-09T21:19:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, c003d888-49cf-4ebb-ab1e-f2a5153e32ea, 'Je l''ai fait avec 2 bananes en rajoutant du lait, et au lieu des noisettes, j''ai ajouté des petits oeufs de Pâques pralinés. Le résultat était très bon: croustillant dehors et moelleux dedans. Par contre, c''est un vrai "teabread" donc assez lourd, plus adapté au petit dej'' ou pour le goûter.', '2005-11-13T15:18:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, f6d8b967-7416-4fb1-90c2-eefe6046096d, 'J''ai dû faire quelque chose de faux!! Je n''ai pas du tout trouvé ce gâteau fabuleux: lourd et pas fin du tout! Il est vrai que j''ai mis 5 bananes, peut-être est-ce un peu trop??', '2005-02-04T21:15:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, 59b4ed52-8dc3-4d44-b131-0b79de681a48, 'C''est vrai, ce gâteau est bon mais plutôt en petit déjeuner car il remplit assez vite le ventre ! Nous avons aimé son côté "humide" au milieu.', '2004-09-30T23:02:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, 32a8a202-a61b-461d-81a8-81c4ebdbbdea, 'Délicieux ! C''est plutôt léger et on sent bien la banane sans qu''elle soit trop présente. Je n''en ai mis que 3 avec un peu moins de farine mais plus de poudre de noisettes... C''est fabuleux !', '2004-09-26T22:03:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, bf7f56fc-406d-4350-8bc8-a41b51eba6b6, 'Tout le monde a adoré ce gâteau, idéal pour un goûter ou petit-déjeuner, avec une bonne confiture... N''ayant pas de noisettes sous la main, j''ai fait marcher mon imagination (eh oui!): j''ai récupéré les noisettes de mon muesli et je l''ai ai broyées!', '2004-09-05T11:51:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, dd6ed4f5-c996-4dff-a41e-e5dcf3e18be7, 'Tres très très... BON!!!', '2004-09-03T09:54:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, 283c084d-c17d-449f-be0c-35750a459e12, 'A essayer absolument! Un régal...', '2004-01-27T11:12:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, ecf9c54c-4707-4f1d-a856-398037f7f30a, 'Super super super bon! Bravo et merci pour cette recette de gâteau: tout ce qu''il me fallait.', '2003-11-10T12:59:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, 7f0d9d10-4c3c-4b73-89e9-7dd32d121566, 'Ce gâteau mériterait sans aucune hésitation l''une des premières places du classement Marmiton, car c''est un véritable régal!', '2003-10-28T11:12:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, f50e9b32-b046-484f-90e4-c60963f9284e, 'Ce gâteau, dégusté avec du thé à la canelle, a transformé notre petit- déjeuner en festin matinal!', '2003-03-03T20:30:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20276, f503a657-5d6e-4aee-bd11-34b9990c7df0, 'Mon dessert préféré, sans hésiter! J''ai goûté beaucoup de recettes et c''est la meilleure!!', '2003-01-16T16:00:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12241, 73d0d0d1-86cd-41b0-adf9-eb5aa4a2566d, 'Pas mal. Testé avec les enfants. Tout le monde a apprécié. En bons gourmands que nous sommes, j''avais évité le repas lourd avant, et malgré cela, nous ne sommes pas arrivés au bout des 400 g de chocolat, et j''avais fais l''impasse sur la brioche. J''avais des fraises, de l''ananas, des bananes et des poires. Mon favori : la poire. Juste un petit bémol, le chocolat n''étais pas assez liquide et onctueux, au prochain coup, j''ajoute une ou deux cuillères à soupe de crème fraîche supplémentaire.', '2008-03-21T21:10:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12241, 7cd1941d-3d4d-40fc-aac6-7e92f7e3cd13, 'Nul ! Le chocolat n''est pas très bien passé pourtant j''avais fait de la salade comme plat ! Je ne vous le conseille absolument pas !', '2007-06-22T17:32:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12241, 66249afb-64e9-48de-aa2c-1ad24261d5d1, 'Excellentissime!!! J''avais un peu peur que ce ne soit trop lourd avec le chocolat. Mais les fruits allègent bien le tout. Je l''ai proposé en dessert après un couscous, et on s''est régalés. Après avoir lu les commentaires, j''ai mis 200 g de chocolat noir et 100 g de toblerone pour 4 adultes et 2 enfants, avec comme fruits 1 ravier de fraises, 1/2 ananas, une pomme, une poire et une banane... il n''en est rien resté. Je n''avais pas mis non plus d''alcool à cause des enfants. Franchement, c''est un dessert à conseiller. Je me réjouis de le refaire.', '2007-04-11T23:36:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12241, b243399a-12bc-443b-8555-6f1367918ec9, 'Effet garanti auprès de vos convives! J''ai mis 100 g de chocolat noir à croquer par personne, que j''ai concassé à l''avance avec mon robot. J''ai rajouté pas mal de crème par rapport à la recette pour ne pas que la texture soit trop épaisse. En accompagnement banane, poires, pommes, marshmallow et fraises tagada en petites quantités. Le repas avait pourtant été léger, mais on n''a pas pu finir.', '2006-04-09T16:40:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12241, cd61640f-9ebe-48d1-895b-cc6bf4ef3723, 'Pour ajouter un peu de fantaisie, sans avoir à y ajouter d''alcool, je met 2/3 de chocolat noir et 1/3 de tobleronne, effet garanti! Les langues de chat sont plus facilement maniables par les enfants ;)', '2005-12-31T11:56:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12241, 5abf31d0-f384-403a-9baa-aa79e0311ed4, 'Personnellement, je préfère lorsqu''il n''y a pas d''alcool et juste bananes + poires en fruits. J''ajoute des chamallows qui, une fois trempés dans le chocolat, font le régal des petits et des grands! Je pense effectivement que 100g de chocolat par personne, c''est un peu trop: je n''ai mis que 300g pour 4 et il en restait!', '2005-03-19T15:30:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12241, 243d8cb4-86e3-4ffb-8064-d01eceebe9f9, '100g de chocolat par personne, je trouve que ça fait beaucoup et pourtant nous sommes de vrais gourmand! En plus, je suis assez déçu parce que l''on pensait se régaler, mais en fait c''est vite écoeurant et finalement on en mange très très peu...', '2004-02-08T14:44:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12241, 98244cf1-7348-4a3c-ad68-af0ed2dd336e, 'Je vous recommande des fraises Tagada', '2003-07-18T02:19:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12241, 5a57ae05-9c1d-436b-ac25-29f8e5223950, 'Excellent pour les gourmands. Par contre, je trouve plus doux avec un gros pot de crème fraîche.', '2003-05-05T18:52:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12241, 067a5f64-bcc2-4096-8b15-216ee1205ce9, 'Original pour un anniversaire. Succès garanti!', '2003-02-26T15:46:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12241, f4b15175-05a9-47ec-82b4-bbd12bb6561f, 'Savoureux, simple et rapide!', '2002-09-16T09:08:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12241, 2955b28b-fd3e-47d7-a9bc-adf560bd8477, 'Appréciez avec de l''eau de vie, à la place de l''armagnac, et retour d''une bonne balade en ski de fond.', '2002-05-29T10:47:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (314700, 5e15bd12-9562-494f-824f-2eed6b19d506, 'J''ai essayé la recette hier soir avec des amis et ils ont adoré ! Les pommes à l''amaretto donne un petit côté frangipane qui est vraiment bon. Je pense qu''ajouter du sucre caramélisé doit être excellent ! Si vous avez d''autres idées pour la recette je suis vraiment preneur. ', '2014-02-01T14:09:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (314700, 41414fb7-3390-4e39-8f51-74ae88c291cc, 'Très bonne recette, merci pour ce dessert délicieux.  ', '2014-02-01T13:39:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41682, ff127907-b6d2-49fe-a97d-e151bcf6c1e9, 'Esthétique dans une verrine, le jeu des couleurs met l''eau à la bouche. Attention cependant à la maturité des mangues: une mangue acide et filandreuse gâche toute l''harmonie du dessert.', '2008-02-25T22:57:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41682, 69693c75-6024-4093-ba9e-f12ff3636eec, 'Rien d''exceptionnel, fade et sèche.', '2007-12-23T23:44:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41682, 0e3c165f-c98e-4446-8026-39428ad3f157, 'C''était délicieux! J''ai ajouté un fruit de la passion... il vaut mieux mettre les framboises à la fin car sinon elles sont trop "cuites " et il n''y a pas trop de rhum ...  Bravo et merci ! ', '2007-01-16T11:19:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41682, b2aefcbc-07fb-4377-8689-44797cdd94cb, 'Rien d''exceptionnel, salade un peu fade et sèche. Le rhum a été absorbé par les fruits et aucun jus, mes mangues n''étaient peut-être pas assez mûres... Bref déçue...', '2006-06-26T14:17:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41682, 3e1da843-698f-4d54-80b7-f63f98148c82, 'Je m''aperçois que je n''avais pas encore mis de note à cette recette simple et délicieuse que nous apprécions beaucoup. Réalisée tel que décrite, elle a beaucoup de succès.', '2006-05-09T12:34:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41682, 4d4f7375-4a7b-47ae-ad40-7e63a902fcea, 'Comme il y avait des enfants, j''avais peur que le rhum soit trop fort, j''ai donc mis 3 cuillères à soupe pour 1 grand saladier de 10 personnes. Résultat: impeccable, le rhum ne se sentait pas et les enfants ont adoré. Très frais et original dans la coupelle avec le biscuit écrasé.', '2006-04-17T14:11:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41682, 70b14996-5ad1-46af-925e-87b39e947f51, 'J''ai mis de l''arôme de fleur d''oranger, 1 cuillère à soupe au lieu du rhum. Super bon! Super beau !', '2006-03-18T13:57:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41682, 4d48d28a-67ba-4ad7-a9aa-78eb22d5861a, 'Un délice. Un dessert tout simple, frais, et qui termine un repas tout en légèreté.', '2005-11-30T10:39:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41682, 9d7fb435-1ac2-473b-b2b5-f789239690e3, 'Outre la qualité gustative de la recette, la présentation dans des verres doit retenir votre attention, pour son effet esthétique!', '2005-11-30T10:22:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, 62b203d9-9732-4894-84ff-348cb07aedd9, 'Trop bon et merci pour la recette les invités se sont régalé !! À refaire 😁', '2022-04-06T11:06:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, 506462bd-5f90-4aa0-a582-83a0a6f005ce, 'C’était délicieux ', '2019-05-12T07:56:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, 35104f6d-4a95-4ab8-828c-875ccbba9359, 'Essayer c''est l''adopter. Super recette, facile et très bonne. Faite pour l''anniversaire de mon fils, je n''ai pas utilisé de fruits mais des bonbons (banane, fraise, guimauve), des biscuits (spéculoos, sablés) et un gâteau au yaourt coupé en carrés. Tout le monde s''est régalé (et les adultes aussi).', '2015-10-31T10:50:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, a0c90c0f-2df5-4f60-b9ba-929a5b737740, 'Génial entre copines gourmandes... J''ai ajouté des morceaux de pommes et de poires !', '2015-01-03T13:28:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, 488d088f-30cc-4313-94ca-0eac708bda11, 'Génial. Les quantités étaient bonnes. Tout le monde a adoré. A refaire. ', '2013-02-05T09:42:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, e952dc51-fbc5-4881-9935-1cb287a76879, 'Un peu calorique mais délicieux !', '2012-11-21T14:50:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, 11ecc2e6-af9c-4671-be3a-1d797eb24cde, 'Excellente recette, ne rien changer à part peut-être la quantité, un délice !', '2012-11-04T20:50:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, 411b0c28-8f14-48a2-8873-e36f671e8343, 'Excellente recette ! Je l''ai faite pour la soirée pyjama de ma fille : elles se sont régalées...et nous aussi. Les quantités sont grandes, j''ai donc conservé le reste au congélateur.', '2010-10-13T22:25:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, 26435be5-eb94-4a3c-b260-bd757fbc3f52, 'Bonne recette, même si je n''avais pas de vanille sous la main. J''ai choisi de l''ananas frais, des pommes, des bananes et des kiwis, très bon !', '2010-02-14T14:31:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, e3058d90-4002-4057-87b9-99b5610c487d, 'Très bonne recette. Je l''ai faite avec des poires, oranges et bananes, c''était excellent... Très rapide à faire. Pour 4 personnes, j''ai mis à peine 2OO g de chocolat et la moitié des autres ingrédients, puis servi dans un bol. A refaire !', '2009-12-12T14:28:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, f724c652-69a3-4ff6-ba06-8ba5ccdd56aa, 'Je l''ai faite en dessert à une soirée entre amis et les papilles étaient au rendez-vous ! Excellente recette, pas trop lourde. N''oubliez pas les chamallows surtout et les framboises qui donnent une touche exquise et sympa à votre dessert. A refaire sans modération...', '2009-09-08T22:41:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, 1010b987-edd4-46b1-b04f-4c1d90d0efe9, 'J''ai fait cette recette hier pour le goûter des enfants et franchement hum  miam miam. Sauf que la prochaine fois je mettrai 20 cl de crème fraîche au lieu de 10 cl. J''ai pas mis non plus le sucre vanille. Et seulement 30 grammes de beurre. Sinon rien à redire c''est trop bon ...à refaire. Merci pour la recette.', '2009-01-17T16:41:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, 167f85c8-5b47-42f0-baa8-bb3697422cda, 'Très bon et simple à faire, très apprecié par l''ensemble des invités. J''ai rajouté des chamalos pour trempé dans le chocolat, delicieux ATTENTION à faire un repas leger avant', '2007-09-25T12:43:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, db334260-0b95-4803-919f-84247f503d60, 'Un vrai succès pour un goûter d''anniversaire, il avait même oublié d''en ouvrir ses cadeaux.', '2007-06-07T09:22:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, c3735293-114b-47e8-814c-65c914a4a6c7, 'Absolument délicieux ! Vraiment pas écoeurante. J''ai mis un peu moins de beurre. Avec des fraises fraîches, des litchis, de la papaye, du nougat... A refaire ', '2007-02-21T16:15:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, 6e81af43-2b93-4d6b-a6a0-7c76580171a6, 'Surprise en bien, ma premiere fondue aux chocolat.. un délice je l''ai preparée pour l''anniversaire de mes filles, un régal,avec des fruits, de la brioche et même des bonbons! Merci pour cette recette.', '2007-01-22T11:13:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, 449501d6-0719-4714-94d0-17291099a613, 'Excellent, si l''on diminue la quantité de beurre!', '2007-01-05T19:46:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, 0c72a0b0-ef37-498a-8d06-d8ee987c1dbd, 'Très sympa et conviviale, on a ajouté des clémentines, des kiwis, des pommes.', '2006-12-09T19:20:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, 9fb095ed-a854-411f-a76a-bc9a8daa98e3, 'Savoureux ! La consistance du chocolat est très agréable. Je le prépare au bain-marie et je verse dans des petits caquelons individuels (chauffés au four). Les quantités sont bonnes si on n''a pas trop mangé auparavant  ! Les poires et les chamallows s''accordent très bien avec la fondue.', '2006-03-26T17:46:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, 649d8e6a-62d4-4a34-bcdc-d1412b788862, 'Vraiment excellente! Je l''ai faite pour l''anniversaire de ma fille. Tout le monde s''est régalé. SUPER recette!!', '2005-12-09T12:01:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, a2c533a6-ea49-43cc-b8f7-d3e85420cdeb, 'Très bon, consistance excellente! Ne pas hésiter à rajouter d''autres fruits, et pourquoi pas même des légumes, c''est original pour les amateurs de mélange! C''est toujours un peu lourd, mais c''est logique... Toutefois ne pas hésiter à réduire les quantités.', '2003-12-28T17:29:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12247, fbdfdf3a-465f-4aa9-bbe7-fc2f2b876eaf, 'Très bonne fondue: le chocolat a une bonne consistance et le choix des fruits est excellent.', '2002-09-09T00:46:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67950, b82434a5-ca14-444e-9ee2-681e0548cb7d, 'On l''a faite 2 fois, comme l''étape cacahuète est manquante dans la recette, on n''en a pas mis la première ou deuxième fois et sincèrement, elles ne manquent pas par contre si pas pimenté, c''est trop sucré. Mais cela reste un régal.', '2013-04-25T21:21:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67950, faf406ab-a06a-4b0d-8393-5f5d57350639, 'Délicieux ! Un sublime mariage sucré-salé, j''adore ! Je n''avais pas de cacahuètes, ni de Worcestershire sauce, et à la place du piment vert j''ai mis du Tabasco. En effet, il ne faut pas hésiter pour la cannelle et de curry ! Je le referai quand j''aurai des invités !', '2011-11-07T22:07:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67950, 79c5ca4a-448e-436b-bce4-75c557e86100, 'Un parfait mélange de saveurs! Bravo drynou!', '2008-05-28T14:22:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17869, 4d22bd75-45fb-4df4-bbc4-eb6d97966b12, 'Un dessert simple et rapide à préparer (j''ai rajouté une banane et enlevé une orange) qui a été apprecié. ', '2006-07-15T00:09:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17869, 8fb906e5-7215-4e6e-8aef-af140d8698cc, 'Très bon, pas cher et facile à réaliser. Cependant, c''est un peu acide! J''ai rajouté un peu de fleur d''oranger et j''ai servi avec une boule de glace à la vanille, ça a atténué l''acidité. C''est très bon, mes invités ont adoré!', '2004-07-23T10:19:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17869, f93cab28-45b4-4556-9c12-bb44ac07220f, 'D''abord, la consistance très liquide m''a incitée à ajouter 100g de fromage blanc. Quand j''ai mis la mousse dans les ramequins (transparents), la mousse est restée en surface et la partie liquide est tombée au fond... Pas très engageant !', '2004-02-19T14:05:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17869, 07e72e8a-1cd7-461a-a760-722c1f466037, 'Très bon et très facile. Par contre, cela peut être un peu acide pour ceux qui ont des problèmes d''estomac: plus de bananes et moins d''oranges et le tour est joué!', '2004-01-28T13:50:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17869, d044ca15-8d89-4367-8742-26586da00289, 'Très bon et très facile à faire.', '2002-08-09T15:27:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15831, 3023d6d9-7361-4bc3-8816-24c6324eaae1, '7.5/10 d''après mes convives.', '2022-01-30T17:15:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15831, 0d118bb3-a74c-480b-aaf6-7b3bcf1eb4c0, 'J''ai fait ce potage  et j''ai vraiment été surprise par le goût, c''était très bon. A refaire. ', '2016-01-10T22:09:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15831, 47db6be9-c70d-486e-beb4-b2ed7a4d9a41, 'Je n''ai mis qu''un bouillon cube et c''était très bien. Je la trouve délicieuse, mais audacieuse, à réserver à des gourmets du même acabit.', '2012-01-20T21:51:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15831, b6b88c43-a89d-4b4b-8a21-195c27f21850, 'A mon avis, il faut mettre moins de bouillon cube.', '2011-07-02T00:20:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15831, 8a858eb3-981b-48ad-98a9-0fe2046e64d8, 'Une soupe délicieuse et originale. Le bouillon de boeuf étant déjà salé, je ne mettrais pas de sel du tout. Je pense aussi que le roux brun se fait avec moins de beurre que ça, ceci dit ça a marché, c''est juste très long (45 minutes a tourner la cuillère en bois !). Au total une très bonne recette, merci !', '2009-04-27T08:41:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15831, 8f970c54-4b90-423b-8e60-9b0b74987a66, 'Très bon potage, facile à réaliser. J''ai pelé les tomates pour plus d''onctuosité. Le goût est subtil et surprenant mais devrait ravir les plus blasés des invités.', '2008-03-15T09:03:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15831, b326764c-3597-42c6-a087-408bdc8c35dc, 'Super facile. Excellent! Pour ébahir les plus sceptiques, c''est LA recette. N''abusez pas des bananes dans le potage. Deux, c''est parfait.', '2004-10-21T20:28:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166688, df03f284-ed5a-411b-8e11-b5c9e7dd1458, 'Top un succès à chaque fois', '2020-11-19T16:46:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166688, 8707249a-a41a-432e-a50e-36b378496462, 'Délicieux et pas compliqué à faire. Toute la famille a adoré. Lancez vous !', '2020-04-30T19:18:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166688, 1361e779-f43c-4496-9410-020953170058, 'Très bonne recette', '2016-10-06T20:56:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 5b630ae6-c3cd-435d-a2b9-d110797496a6, 'J''ai lu les commentaires après avoir fait le gâteau, dommage. Effectivement ce gâteau donne une impression de pas cuit au milieu, je l''ai pourtant fait cuire longtemps en combinant chaleur tournante et micro-ondes à la fin. Cependant il n''est pas mauvais non plus, il a juste une texture bizarre.', '2014-03-22T13:49:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 4a504b56-dc7c-440e-853a-09871754bb95, 'Vraiment il y a un truc qui m''échappe dans cette recettes...Ca doit être la dose de levure et de farine car le gâteau gonfle a merveille dans le four mais alors dès qu''il est sortie et qu''il refroidi c''est une véritable HORREUR!!!Il est retombé comme jamais et la pâte ma même fait des "plis"!!Vraiment je suis pas prête d''en refaire un!!!', '2009-02-10T12:21:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 3a756e59-9e73-4df2-b9e9-6bd2f92c3ffa, 'Je sais pas si ce n''est pas cuit ou si ça doit être comme ça, mais en tous les cas ce n''est malheureusement pas très bon!', '2008-04-22T14:46:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 0ec1a099-3707-4cb2-b8d2-4ce70eaa9b42, 'Vraiment pas terrible, le seul aspect positif c''est qu''il n''y a pas de matières grasses. On a l''impression qu''il y a une erreur dans la recette. Si vous avez des invités...évitez de tester cette recette avec eux...vous serez déçus!', '2008-03-03T16:42:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, f9b43c5b-9b1f-413a-978b-33f436cfc249, 'Un vrai massacre! Dommage parce qu''à la préparation ça avait l''air bon. Il y avait trop d''appareil, ca a donc débordé du moule à cake, mieux vaut donc le faire dans un moule à manquer. Après 1h15 de cuisson à 180°C, le cake n''était toujours pas cuit...', '2006-05-18T14:05:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, ccb0200f-a9b0-4eb7-94a1-84b778df52f7, 'Super facile à faire. J''ai suivi les indications à la lettre, le temps de cuisson pareil...dans le four il avait l''air succulent...et hop dès qu''on le sort ça devient un vieux truc qui se dégonfle à une allure folle ! Pas cuit du tout, qui ne ressemble à rien...je suis déçu ça avait l''air trop bon mais à mon avis il doit y avoir une erreur dans la recette! Bravo quand même pour ceux qui l''ont réussi...', '2006-02-20T23:08:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 46937806-01d4-4c8a-8d0e-f99fe3b7a34f, 'Ce gâteau n''est pas un gâteau!  Il n''a aucun goût, aucun aspect, aucune saveur! bref ce gateau est mauvais :-(', '2006-02-15T17:16:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 012f19b1-db23-4ea5-a11c-2c2edc9346bc, 'Cela avait l''air bon, mais c''est vraiment immangeable (sorte de porridge gluant)... Il doit y avoir une erreur dans les quantités!', '2004-08-10T00:19:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 501bf5fb-e4d2-4bdd-a297-9396e8073f94, 'Je l''ai trouvé bon, on sent bien la vanille.', '2004-04-13T20:28:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 26a8bc42-f09d-48bf-abad-70f5a739439d, '2 pour la bonne odeur dégagée dans le four mais immangeable, ou alors je m''y suis mal prise...', '2004-04-07T14:32:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 0d26679b-91d2-4a46-9f82-e8d54546f472, 'Moi aussi j''avais l''impression de ''pas cuit'' et d''une pâte caoutchouteuse... Sniff, parce qu''il avait l''air bon!', '2004-03-20T16:15:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 5f862dc4-3f85-4cd2-9c1a-b957a0449183, 'Quelconque, un genre de quatre quart, mais trop sucré et pas assez parfumé. Un peu de rhum l''améliorerait ou tout au moins l''accompagner d''un café avec un soupçon de rhum!', '2004-03-20T12:51:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, f08fc12a-5676-4df9-bb85-317880f97c35, 'Il faut couper la farine avec de la maïzena et mettre moins de sucre, mais chouette pour les fans de banane.', '2004-03-12T23:57:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 2221afcc-a3d3-48bf-bd40-75f9e27ed9fc, 'Il est bien dommage que la cuisson soit difficile.', '2004-03-06T19:32:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 13ba7af1-90a8-4af3-bee4-adb78d2e84fb, 'Bof.. J''suis pas convaincu du résultat. Je l''ai laissé cuire une heure mais il a quand même l''air pas cuit.. Dommage', '2004-02-23T17:03:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 0f2a90ca-dd1a-4828-a870-8afe1127ea3a, 'Très bon. /! La cuisson est un peu difficile à surveiller, par contre.', '2003-10-26T10:14:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 56919b19-fdc3-43e9-b5e8-c724ab11b20f, 'Bizarre comme résultat: une impression de ''pas cuit''. Mon frère a essayé la recette: même résultat que moi. Avons-nous oublié un ingrédient?', '2003-08-26T16:46:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, fcdc5d7c-5236-45c4-91f4-00f69f7e2fd9, 'Vraiment très onctueux et savoureux.', '2003-08-18T05:27:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 29c299d1-cdf2-4a2b-b109-9ac03958e211, 'Facile, fait en tour de main avec des bananes qui allaient se perdre! A déguster tiède ou froid, c''est bien moelleux. Par contre, j''ai réduit la température à 160°C (chaleur tournante) et fait cuire 5 minutes de plus.  Je n''avais pas de yaourt à la vanille mais cela marche très bien avec un nature.', '2003-06-10T12:33:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22728, 8cb9c612-94e6-4e89-99c4-ee588b95dfb9, 'Vraiment très aéré et moelleux... La banane ne colle pas au fond, un chef d''oeuvre?! ;-)', '2003-06-04T22:52:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, f072de9a-036c-48d2-8bdc-e8b7babf0c69, 'J’adore le chocolat dans la pâte.', '2018-09-16T18:12:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 2410b58f-28e4-41ea-acb3-a27bb4ec43b0, 'Recette délicieuse, rien à modifier. Je l''ai servi tiède avec de la glace à la vanille, un régal.', '2011-10-22T19:11:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, e00ecf45-b052-4eb4-ad2a-cd76960443c1, 'Je trouve que le sablé est un peu sec, mais l''idée d''y incorporer du chocolat est excellente. En revanche, la banane couvre un peu trop le gôut des autres ingrédients.', '2007-11-20T19:32:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 4c192aae-13ab-41fa-b1ae-0e2bd2a404ad, 'Un régal c’est très gourmand, j’ai ajouté plus de fruit et un peu moins de chocolat; tout le monde s’est régalé :)', '2021-12-07T22:25:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 0d00ab8d-6b39-46a0-818f-6dd0900ba2e8, 'J’ai ajouté quelques petites de chocolat juste avant de mettre la pâte. Un délice !', '2020-04-03T18:00:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 44bbb31a-d5f0-4c3a-8f9c-f26dac63f1f8, 'Recette vraiment excellente ! Les fruits s''accompagnent bien et le chocolat les rend gourmands ! J''ai mis un peu moins de chocolat que dans la recette! ! C''est déjà pas mal !', '2015-02-24T21:38:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, f6f8af95-b68d-456c-bfe5-6f0ccd8eb080, 'Succulent mélange de fruits ! Assez bluffée par la recette, par contre la prochaine fois je mettrai moins de pépites de chocolat !', '2013-10-18T20:22:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, d3e14f40-c0a9-47aa-9b50-5de4638569ff, 'Très très très bon !!!!', '2012-03-08T22:11:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 1ac4806b-bb84-49fa-9c5d-f337bd9d651c, 'Pour une fois, la proportion fruits et pâte est parfaite ! La combinaison de tous les fruits est très réussie, mes invités ont beaucoup appréciés, merci ! ', '2011-12-12T21:03:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, c771e248-313e-4270-a47b-3deb25566faf, 'Très bon dessert apprécié par tout le monde. Merci !', '2011-10-24T21:11:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 79ce43a0-f51b-492a-a3b6-73d2652a48ae, 'Bonne recette mais les bananes viennent alourdir le mélange. La prochaine fois, j''essayerai sans.', '2011-10-23T15:11:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 0cb2038d-0e76-4632-bdb2-86bb1085e745, 'J''ai mis moitié farine et moitié poudre d''amande... Excellent. Recette que je recommence régulièrement en ajoutant en modifiant les fruits et en ajoutant des raisins secs ou cranberries. A la maison, nous sommes fans de cette recette.', '2011-10-23T14:21:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 3196f42f-671f-47c5-b8d2-7419a5a42086, 'Génial, très apprécié des convives. A recommencer.', '2011-10-17T17:35:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 6e471111-db6e-4323-9aa4-272796bf005e, 'Recette facile et très bonne. Toutefois attention à prendre un grand plat car il y a beaucoup de pâte !!', '2010-09-27T19:23:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, f6d6f509-38f8-405b-b6ae-f4a3deb3df1d, 'Recette délicieuse ! Dégustée entre amis, les proportions étaient bonnes et le goût très flatteur. En m''inspirant des autres commentaires, j''ai pour ma part choisi un intermédiaire : la moitié des pépites sur les fruits et l''autre moitié dans la pâte. Un régal ! (je suis déjà en train de le refaire d''ailleurs)', '2010-02-23T13:32:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 64241dac-3eb1-4ea9-bcf5-1c905ce83850, 'Très réussi et délicieux. Toute la famille s''est régalée. Pour ma part je n''ai mis que des pommes et, comme dans n commentaire précédent, je n''ai pas mélangé les pépites à la pâte mais juste posées au-dessus des pommes.', '2010-02-09T09:19:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 74aa3dfc-72f2-41f5-8be3-5e40db5e383c, 'Recette géniale qui fait maintenant partie de mes inconditionnelles. On peut mettre moins de chocolat mais, pour les gourmands comme nous, c''est bien comme ça.  Attention, ce n''est pas vraiment un dessert "light" ! ', '2009-11-01T22:11:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, b095e410-1279-43f1-a844-56af2c2c91b5, 'J''avais acheté des pépites de chocolat que j''ai mises entre les fruits et les miettes au lieu de les mélanger avec le beurre et la farine. Un vrai délice!', '2009-02-24T22:00:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 51457ec0-37f0-4a85-8c9e-0c1b2576ce66, 'Tout le monde a apprécié ce dessert, je l''ai servi avec de la glace vanille en accompagnement.', '2008-10-29T20:05:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 400e8ba9-f008-48a8-8629-ff563ad816e6, 'Délicieux, hyper facile à faire, j''ai tenu compte des conseils des autres marmitons en réduisant les quantités de sucre et beurre. J''ai employé des granulés de chocolat et l''ai servi tiède avec une boule de glace à la vanille. Tout le monde a adoré!', '2008-10-06T10:33:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 63dcd823-3149-467c-84eb-554b1c71b62e, 'Très bonne recette, agréable en bouche...', '2008-05-27T14:09:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 93a4b9e7-e969-4ae7-a3ed-45804c77defe, 'Excellent crumble, toute la famille s''est régalée !!', '2008-05-03T17:13:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 073434ef-5a20-4f7f-9bc2-7cf56e603070, 'SUPER RECETTE!!! SUPER BON CRUMBLE!!! J''en ai déjà fait auparavant et je rajoutais un peu de cacao mais là, le chocolat pâtissier fait vraiment la différence ! Je l''ai fait pour le réveillon de Noël mais je n''avais pas de poires, j''ai mis 5 pommes golden et 5 bananes ! Tout le monde fut ravi ! Je compte donc le refaire pour le réveillon du jour de l''an ! ', '2007-12-30T19:19:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, a126103e-f061-4e88-a3b0-6f963ccc3fd6, 'Je n''ai rien modifié et tout le monde s''est régalé.', '2007-12-21T15:14:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, ffa353b4-8720-4eb3-8240-2361a9f94892, 'Tres bon, j''avais rajouté en plus des framboises et des myrtilles, mais effectivement il faut réduire les quantités ou alors utiliser un énorme moule....', '2007-12-12T21:59:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 17922d99-9666-4016-a1b5-18e699a4ad05, 'Excellent ! Le chocolat rend le crumble moins sucré que la recette de crumble pommes-bananes que je faisais habituellement. Vivement le prochain !', '2007-12-06T18:56:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 80da8bc3-2cee-4720-abe9-2b2febfb9d8a, 'Très bon, mais fait avec 140 g de chocolat. Finalement il faudrait réduire toute la quantité de crumble. Il y en avait un peu trop.', '2007-12-02T21:55:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 34619bdd-9355-45e3-a565-f4d3e635c57c, 'Fait, comme indiqué dans les commentaires, avec 100 g de grosses pépites de chocolat et 100 g de sucre (suffisant!). Trrrès bon !!! Mais le goût de la banane masque celui de la poire... donc à réessayer avec pommes-poires ou pommes-bananes !', '2007-12-02T11:22:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, ed569e8a-f0f4-4c31-af64-803b12a3a9bb, 'J''ai suivi la recette à la lettre mais je dois avouer qu''avec moins de chocolat, celui-ci serai moins écoeurant. Je referais en suivant les avis précédents.', '2007-11-29T19:36:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 2c88987d-b970-4bbb-805d-d4a5f7738b05, 'Super bon, tous mes invités ont adoré et en ont repris! J''ai mis plus de fruits (assaisonnés d''un zest de citron) et j''ai donc conservé les proportions de la recette concernant la farine, le chocolat, etc.  En combinant chocolat noir et chocolat blanc, c''était encore meilleur!', '2007-11-24T00:38:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, a1f0a545-893d-4934-bf77-f3eb5142296d, 'Moitié moins de chocolat et les fruits revenus préalablement au beurre avec cassonnade et cannelle... un régal!', '2007-11-23T15:31:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, e0121f8c-23f3-4803-8d5d-554e31aa39ff, 'C''est excellent, effectivement 150g de chocolat suffisent largement. Je n''ai pas mis le crumble en entier car cela me parraissait beaucoup trop et c''était très bien comme ça. A refaire sans hésitation! Karine', '2007-11-20T14:13:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 77633364-ae5b-4bde-b02d-236d5e0da695, 'Délicieux! J''ai respecté la recette à la lettre. Je n''ai eu que des compliments! Sandrine', '2007-11-18T23:13:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 0f4932dc-662d-4ea7-b0d7-dcffb026580c, 'Ceux qui apprécient le vrai crumble vont être déçu. Le chocolat empêche la pâte de croustiller. C''est granuleux en bouche. Bref bof bof!', '2007-11-18T21:32:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 58cc9480-d55a-436f-b9e4-05ef2c342346, 'Désolé, mais je trouve que le chocolat est de trop (j''ai mis la moitié) dans un dessert déjà copieux et je trouve que la texture des bananes n''est pas très heureuse dans ce contexte.', '2007-11-18T19:04:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, d3eee940-8d50-4929-8ea7-7fe02cbea6a5, 'J''ai suivi les commentaires et ai mis moins de chocolat (100 g), de plus j''ai utilisé des pépites de chocolat en sachet. Tout le monde a adoré !', '2007-11-18T17:37:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 704b4bf5-9fc2-489b-8487-222b2f7f53d6, 'Bon, chez moi, la cuisson n''a pas été suffisante, j''ai rajouté un peu, mais je me suis régalée! Je n''ai utilisé qu''une plaque de 200g de chocolat.', '2007-11-18T12:43:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 78fc4f0d-fbbc-4ef8-bc1f-36bcf66707c7, 'Super bon! J''ai fait un peu comme tout le monde : adapter la recette... J''ai d''abord fait revenir les fruits dans du beurre salé avec du caramel avant de cuire au four. Ensuite, j''ai fait fondre à température ambiante de la glace : caramel, amande et noix de macadamia pour accompagner. Vraiment très bon... A refaire!', '2007-11-16T13:43:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, b125d50b-aa96-4cdc-a8b1-a86c80bdf603, 'Tous mes amis se régalent avec ce dessert. Comme dans certains commentaires, je ne mets pas la totalité du chocolat préconisé... mais c''est délicieux, et si rapide!!! ', '2007-11-16T06:22:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, de203c54-11be-4dce-992c-66d83764f238, 'J''ai rajouté de la cannelle et je n''ai pas mis de bananes. Délicieux!!!', '2007-11-14T18:08:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 7383767f-37f3-415a-bbcc-eb198e63ed2c, 'Très bon ! Je n''ai mis que 75 g de beurre, 70 g de sucre et 200 g de chocolat.  A refaire sans hésiter.', '2007-11-13T21:44:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 3dbd91f5-7a8f-4f1f-b340-145ece638f83, 'A faire et refaire, les enfants comme les grands en ont rafolé. J''ai mis comme sur les commentaire 100 g de chocolat et 200 g de sucre en tout dont de la cassonnade et fait cuire mes fruits 5 m avant dans un peu de beurre. Délicieux...', '2007-11-13T16:21:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 308beea8-2ae2-46b5-912f-e3153aa3a9e8, 'Très bon et très facile. J''ai moi aussi largement diminué le chocolat et c''était suffisant (je mettrai moins de pâte crumble la prochaine fois!). Délicieux servi tiède avec une boule de glace à la vanille!', '2007-11-12T17:06:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, d493d088-1061-4986-91cd-a010f396f5c2, 'Très bon, à refaire. J''ai fait cuire en ramequins individuels pour une meilleure présentation.', '2007-11-12T16:49:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, a526eec4-6358-4d8a-929d-d618ab228219, 'Un régal! Le mélange fruits-chocolat rend plus léger ce crumble. Ma touche perso: j''ai coupé la farine avec 125 g d''amandes concassées, mais les noisettes ou un mélange fruits secs font très bien l''affaire aussi et ça rajoute un petit quelque chose non négligeable au goût..... Merci pour cette recette, tous mes amis ont adorés et sont reparti avec la recette!!!', '2007-11-11T21:31:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 41ede05d-0e22-493d-85ed-21c0c0f019d8, 'Je remplace pour moitié la farine par de la poudre de noisettes, cela donne plus de croustillant.', '2007-11-11T17:39:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, d8bcc257-dd46-48c8-9505-4fd4a066b997, 'Très bonne recette. Je conseille de commencer à faire cuire les fruits séparément et de n''utiliser que 100 g de chocolat.', '2007-11-11T17:28:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 9b37080f-ae55-4d44-a3b4-705b4a7e5d29, 'A consommer sans modération. Très, très bon, succulent, exquis, un festival de saveurs. Un vrai régal pour les papilles... Sur ce je vous laisse, pour retourner au fourneau.', '2007-11-11T13:36:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 6080b9e9-5034-4f69-9622-c3726d136d69, 'Excellent! En manque de poire et n''aimant pas les bananes j''ai fait avec les pomme seules, j''ai donc ajouté un peu de canelle sur les fruits.', '2007-11-10T17:03:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 1addb201-3a06-45fc-b4b9-85d865cad330, 'C''est très bon mais un peu trop riche à mon goût...prévoir de petites portions!', '2007-11-10T11:05:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 993d8402-6d1c-4653-9d9b-0bb4805dc731, 'À faire et à refaire!!!', '2007-11-09T17:15:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 965615b5-8517-4851-978f-85a1785a8fa1, 'Quand je fais un crumble, je rajoute à la farine de la poudre d''amandes et je sers avec une crème anglaise. ', '2007-11-07T11:36:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 340aa008-4353-4075-961b-7be6193d9d0b, 'C''est sûr c''est bon... mais niveau crumble ça ne vaut pas le classique aux pommes (ex : "crumble du chat qui tousse" sur ce site)', '2007-11-06T14:16:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 2e7b3b34-6e64-4a10-9029-4ac502b1c5e5, 'J''ai suivi l''avis des internautes pour le chocolat,100 g suffit. Cette recette est vraiment un délice. Petite astuce pour aller plus vite, mettre les fruits au micro-ondes pleine puissance 5 min puis passer au four 15 min.', '2007-10-05T10:52:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 238a064b-df2c-4198-9bc8-0cfb9f890d9e, 'Très bon!! J''ai un peu modifié la pate à crumble en mettant un peu moins de sucre et un peu moins de farine mais des  biscuits specullos emiettés. Un délice !', '2007-07-31T14:10:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 613b2bfc-6f26-438e-832c-e599e3bd8c13, 'Un délice, j''ai suivi les autres commentaires et mis seulement 200 g de chocolat, j''ai également mis les pommes et poires a cuire un peu avant de les mettre dans le plat ( 2 min a feu vif et 5 min a feu doux). Je vous conseille cette recette', '2007-04-11T17:28:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, 78e67120-59d6-45ed-b880-9317f5b9c4bf, 'J''ai également eu un grand succès avec ce crumble. Je n''avais pas mis de banane. La prochaine fois, je ferais peut-être un peu moins de "pâte". Un délice!', '2007-04-02T16:08:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, de2b2e1e-859e-4400-b8f5-68d9cb79f87b, 'C''est vite fait et facile à faire. J''ai utilisé que des pommes et des bananes...', '2007-03-21T16:59:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, f42608b5-a640-496a-bc49-2c0a30c30314, 'Super recette, j''ai eu un succés fou ! Je n''ai mis que poire et pomme et j''ai beurré le moule et mis beaucoup moins de chocolat. Je me languis d''essayer les trois fruits !', '2006-10-08T00:12:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20217, d28d1791-f81f-4eeb-b51a-295a29381cfa, 'Ce crumble est excellent! J''ai suivi certains conseils des marmitonautes : j''ai mis seulement 200 g de chocolat dans ma première version, et la seconde fois je n''ai mis que 150 g... et c''etait largement suffisant! En effet, plus il y a de chocolat, plus on a une sensation de dessert bourratif... De plus, dans ma première version, je n''ai mis que des pommes et bananes, alors que dans ma seconde version j''ai mis les 3 fruits et c''était vraiment meilleur, car l''acidité de la poire allège. Bref, super bon dessert!   PS : j''ai mis du caramel au fond du plat, et ce n''est pas mauvais non plus...', '2005-11-29T16:54:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42158, 999e69ee-d6f1-4de4-b58d-dd1735e55cd0, 'Parfaite ! Je n''ai pas mis de rhum, mais on retrouve la texture de la mousse au chocolat. D''ailleurs, j''ai fait des verrines 2/3 mousse chocolat, 1/3 mousse banane : exquis ! Bravo et merci pour cette recette.', '2016-06-10T18:24:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42158, 78e37f1b-fb69-4f47-8e34-82238b6e33a1, 'On a aimé le goût mais ce n''est pas présentable pour des invités, avec le jus marron au fond de la coupe.', '2009-07-07T23:03:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42158, eb1aad75-47e6-4508-bff2-097e50873783, 'Très bon ! La texture n''est pas mal du tout (une vraie mousse, assez aérée), même si la couleur est un peu "beigeasse". Ceci étant, au goût, c''est excellent et pas du tout écoeurant, à condition de le servir très frais. Seul souci: j''ai réservé la mousse dans un saladier et au bout d''une heure, la mousse finit par rendre de l''eau au fond du plat. Du coup, j''ai "écoppé", mis la mousse du dessus dans des verrines et jeté le "jus" du fond. Bof, ça a un côté amateur... Mais le goût est toujours excellent! N''essayez pas de remélanger en tout cas, vous feriez tomber votre mousse. J''ai superposé dans mes verrines de la mousse au chocolat noir puis la mousse de banane (ne faites pas l''inverse, la densité du chocolat est supérieure...): délicieux mais... désastreux en période de régime !;)', '2006-06-27T14:45:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42158, ef539220-9a04-4d56-adae-dc8fcc9c961f, 'Jamais vu un dessert aussi mauvais! J''ai suivi la recette à la lettre et j''ai retrouvé dans mon frigo une sorte de patte ratatinée avec un jus marronasse au fond ! C''est parti à la poubelle ! Ceci dit mes invités ont bien rigolé ! ', '2006-06-15T15:38:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42158, 9e8bf303-d50e-4932-8daa-9a0ff1cdd6cd, 'Cette recette est un pure régal aux yeux et aux papilles!!! Mon mari n''aime pas trop l''odeur de la banane et son goût et là, il en a repris 2 fois, c''est pour dire!! L''alliance entre la banane et le rhum c''est juste ce qu''il faut merci!! Pour cette recette, il n''y a rien d''autre à ajouter... à part : bravo!!  ', '2006-04-21T19:21:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230521, 92441ce6-c97d-48c6-8a2a-8719108d181a, 'C''est bon, mais le chocolat domine les autres goûts, c''est déséquilibré, dommage ! De plus, la poudre d''amandes est oubliée; Je l''ai incorporée au mélange oeuf-crème-sucre.', '2020-05-27T22:32:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304800, 980a26cc-510d-4aee-ba43-9088bc46a7bf, 'Recette qui change de l''ordinaire, il faut aimer le sucré-salé. 50 % de mes invités ont aimé, moi j''ai adoré ', '2014-11-03T19:01:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304800, 2ee14c6c-2c2a-450d-a602-e1f0698bad27, 'Recette très facile à réaliser, qui sort du commun et qui est vraiment bonne.', '2013-06-15T16:31:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (218620, d49fb8bc-aedd-4813-8f14-77f5412b343a, 'Très bonne recette ! J''ai remplacé le sirop d''érable par du miel et rajouté des pépites de chocolat.', '2023-02-15T16:03:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (218620, c395bfad-94f7-4f27-920e-a92433bbdcba, 'Parfaites ! J''ai cuit les barres dans un moule en silicone avec des compartiments rectangulaires, nickel. J''ai également rajouté des pépites de chocolat noir pour un peu + de gourmandise
N''ayant pas de sirop d''érable, j''ai remplacé par 3 cuillères à soupe de miel de producteur local.', '2022-06-05T15:18:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (218620, a7c05928-0522-4047-88be-b5117d032183, 'Délicieux ! J''ai ajouté un peu de lait pour plus de légèreté !', '2014-11-08T00:51:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63860, 7c55c739-420b-4c09-84e6-2525ff1014e4, 'Très apprécié de mes invités... Recette simple mais très bonne. Je n''ai pas trop sucré la crème et c''était parfait.', '2019-10-25T11:38:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63860, 1455a64b-e2f9-43db-98e8-b0d28ca41dd4, 'Le résultat est bon mais peu présentable, à la longue c''est un peu écœurant', '2010-08-30T15:25:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63860, 5e9ffbfc-451a-4da3-afe3-1d3db214fdb6, 'Le "croquant" du caramel avec les fruits s''accordent très bien...', '2009-11-03T13:36:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29943, 71336657-4e65-40ec-9e3e-6ad04b86fc9d, 'Très bon! J''ai mis 150 g de chocolat, et j''ai fait avec les fruits que j''avais sous la main : poires, bananes, un peu de fruits secs ; j''ai ajouté des pommes la seconde fois. C''est un crumble vraiment original!', '2008-01-07T12:10:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29943, 8e790849-4c97-4b95-ad6a-2d74e0626a5f, 'Délicieux! A chaque fois, il connaît toujours le même succès. Pour les gourmands, accompagné de glace à la vanille, c''est encore meilleur! 100g de chocolat suffisent.', '2005-10-29T10:59:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29943, f6a63daf-4ad9-42e6-8166-e6e26a01db7f, 'Très bon. Je n''ai mis que 150 g de chocolat et de l''ananas au sirop.', '2005-03-13T18:52:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29943, 85a3b2f8-4422-4ecf-8f73-fdf2ce7d9878, 'Bon et original. On a mis des pépites toutes prêtes, je referai mais avec moins de chocolat (100g ?).', '2005-01-28T22:28:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26093, 6be327e1-fedf-4229-a91b-1cead12b9ca7, 'Tout simplement délicieux, les invités conquis, très simple à faire. J''ai un peu augmenté le rhum.......et la prochaine fois j''essaierai de rajouter un peu de chantilly.', '2011-08-22T11:54:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32062, d791e167-ef98-4a33-8e4f-8ce51f2192f4, 'Original tout le monde a été surpris et a aimé.', '2006-11-19T21:21:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32062, 696d7ab2-f2d8-4b92-ad3b-beacd98b80ef, 'Moyen, le gâteau est assez lourd, les bananes plus le potiron cela fait peut-être un peu trop.', '2006-11-07T22:30:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32062, ecdb9442-0b70-4a0e-a2e1-b0dc15d2b70e, 'Je ne sais pas s''il y a un problème de proportion ou de cuisson mais la pâte à cuit en 1h15 au lieu de 40 min. L''intérieur est resté "collant" sinon le goût, ça va.', '2006-10-31T00:14:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56539, bddb8035-5898-4ac0-a976-3b291ce25569, 'Très bon. Mais visuellement, il manque des couleurs....', '2016-02-21T13:58:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56539, 9ebebe39-0b24-4a43-9f2d-42118316994b, 'Excellente recette qui a ravi mes amis. Merci beaucoup. Bien penser à enlever les bananes avant de recuire les crevettes et donc de bien veiller à ce que les crevettes ne brûlent pas à ce moment là.', '2014-11-16T14:59:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56539, 11f99eb4-901e-4669-be49-b09b6e3237fd, 'C''était un régal ! J''ai préparé cette recette avec du lait de coco et du gingembre. Le tout forme un mélange de saveurs très agréable, et le rhum apporte vraiment une note sympa !  Comme précisé dans les précédents commentaires, j''ai fait attention à ne pas trop cuire les crevettes, et c''était parfait ! ', '2014-07-18T00:39:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56539, 331ab082-89ce-41c3-a38c-dfc678f23d0a, 'Effectivement attention à ne pas trop cuire les gambas. j''ai utilisé le lait de coco à la place de la crème. j''ai terminé la cuisson en faisant flamber au cognac ! un régal !! la prochaine fois j''essaierai en gardant la crème fraîche (je suis normande!!)', '2012-02-27T22:22:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56539, bfafc367-5b00-4f87-8264-8dcfdb685612, 'Excellent, plat facile. Attention, ne pas trop cuire les grosses crevettes et ne mettre qu''un demi citron vert.', '2012-01-30T19:53:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56539, 08c8bd01-e5bf-40f9-bcaf-b0cc9cffcf54, 'Excellent de chez excellent. Pour ma part, j''ai choisi de faire flamber les crevettes (des grosses) et sinon, on s''est divinement régalé. Merci beaucoup de cette recette simple, de dernière minute et si délicieuse.', '2011-12-10T21:50:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56539, ceafa0b5-2b00-4fd1-ba68-4c3aa87a606f, 'Un vrai délice ! Surtout avec du lait de coco (plutôt que de la crème fraîche) et un peu de gingembre ! Attention cependant à ne pas mettre trop de citron et à ne pas trop faire réduire la sauce, comme cela a été mon cas lors de mon premier essai. J''ai hâte de refaire cette recette pour des invités !', '2011-10-17T23:03:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56539, ca12e61a-43bb-4760-84fd-061b078c314f, 'Délicieux ! On s''est régalés ! Je n''ai pas mis la crème fraîche, j''ai mis à la place le lait de coco et c''était parfait ! ', '2011-01-04T15:47:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56539, 5e4fd11c-9a31-4dd6-a883-7ecf29eea525, 'J''ai mis tout le zeste de citron vert, ça fait un peu trop!! Mais c''est très bon quand même! Merci pour cette recette!!', '2008-07-07T12:15:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169148, 73b7ba2b-7363-4d82-b7a3-8ca705a46a60, 'Excellente recette faite à la lettre ! Mes enfants se régalent à la faite et la manger ! Ça va faire 1 an que je la fait et toujours aussi délicieuse merci !', '2018-03-10T13:07:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169148, 00b1492b-05d8-4ed1-9cff-561d094a594b, 'Un délice pour tout le monde !', '2023-11-04T19:16:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169148, 57e394ff-ec61-4f96-abd1-6447704bceee, 'J’adore ces petits gâteaux ', '2023-08-11T14:16:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169148, 145bf340-8899-45b8-84b8-dde3f8c90345, 'Vraiment très délicieux et très moelleux !! Je recommande fortement ✨', '2023-05-02T20:56:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169148, 517d5eb4-83ba-4681-8320-bad6575ab157, 'Trop beau et bon !!! j’ai mis une sachet de vanille c’est trop bon !', '2023-03-08T15:25:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169148, cc37743e-c8eb-4ff6-a160-dfcbdc43f85f, 'Bons petits gâteaux originaux. Manque vanille, rhum ou autre parfum à mon goût. Merci.', '2021-12-23T19:41:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169148, 26fee756-ec0c-487f-8d2b-c8c56725748e, 'Pour une trentaine de mini gâteaux j''ai mis 5 bananes 250g de farine, 215g de sucre 1 sachet de levure, 5 œufs et 220g de beurre, et étant légèrement gourmande j''ai ajouté des pépites de chocolat. Un vrai régal 😍', '2021-04-29T08:51:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169148, 5d4b9885-833b-4e28-867b-2363eb7a5ba4, 'super, c’est assez rare de réaliser une recette avec de la banane qui soit bien, celle-là est top ! peut-être un tout petit peu trop de beurre à mon goût...', '2020-10-08T22:08:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169148, e6b21f06-12d0-4ba4-b86a-fc5d2ba1dd29, 'Super bon !!! J''ai mis de la fleur d''oranger, de la maïzena, du sucre vanillé, de l''huile à la place du beurre. Pour la présentation, j''ai mis du caramel et des bananes, mes parts m''ont dit " voila une future pâtissière ! " voilà !!!', '2018-12-09T14:50:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169148, c03d9827-ada6-45ab-8e75-e4d31e10c5ca, 'Je n''ai mis que 50g de beurre et moitié farine et maïzena. Et un kumquat coupé en petits morceaux et des morceaux de pêches.', '2017-09-13T10:44:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169148, 62595310-1674-4e8d-8808-16067485e788, 'Super bons ces petits gâteaux.', '2017-01-20T18:28:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16246, f7523290-d8d8-413e-825f-24059262a43e, 'La banane doit être très mûre, c''est délicieux avec du poulet rôti ! Ca change des pommes de terre sautées, et c''est très rapide à faire et à frire.', '2014-04-10T23:18:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16246, fa84ca7c-37b2-4376-847c-b0763a273894, 'Mes amis ivoiriens qui m''ont appris cette recette délicieuse l''accompagnent d''une sauce ''sardine'' qui est faite de la manière suivante: dans une casserole, mettre une boite de sardines à l''huile, du piment, du concentré de tomates et du sel. Porter à ébullition et servir avec les allocos.', '2002-11-30T12:13:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16246, 6c771595-e88e-4953-87de-1a969a82c5bc, 'Je n''utilise pas de gingembre, et je sale avant de faire frire les morceaux de bananes. Un vrai délice!', '2002-07-02T15:11:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16246, 9855ccc0-7b2a-4b3d-8158-f356a9b57007, 'Top', '2022-01-15T17:28:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16246, b51a8fd2-dc48-45a8-8a78-9a52b10f87f1, 'Super bon ! Je ne connaissais pas avant d''essayer et depuis je l''ai adoptée', '2020-05-13T20:18:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16246, f293ee8f-b8ab-4615-9f57-9d42acd2b2f8, 'Best food ever !', '2016-08-18T18:17:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16246, 6b7f108c-3e14-4f6e-86d0-82003b14e883, 'Excellent à condition de choisir des bananes très mûres c''est-à-dire avec la peau bien noire et de les saler légèrement avant de les faire frire. Elles seront alors moelleuses et fondantes.', '2011-02-21T20:14:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16246, df3c8b4d-e9ed-422e-bc56-35a04fee9141, 'Pas terrible, assez lourd, sec, ça rassasie c''est sur, mais c''est pas fin du tout.', '2009-01-11T22:15:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16246, 016f5fc8-5ee2-4ae6-85b7-5be0d9cd2cd5, 'Excellent accompagnement, pour le poisson braisé notamment. Toutefois, il faut saler les morceaux de bananes avant de les plonger dans l''huile.', '2002-05-31T18:15:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16246, 559e8a3a-3540-46eb-a4ca-320cbae41d9d, 'J''adore, à consommer toutefois avec modération, mais un écart de temps à autre... ça fait du bien au moral.', '2002-03-16T19:40:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44719, e2d11bfb-d458-429c-97e3-b7eb91829060, 'Très bon et avec de la banane, ça change un peu des traditionnels desserts...', '2012-11-02T22:48:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44719, 2c569383-2ce3-4ee7-99bd-dab191159fc8, 'Un vrai régal. Encore meilleur tiède avec le nutella légèrement coulant... Mmmmm.', '2011-07-28T23:45:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44719, c9ffaa81-2db6-4c67-9228-43914255caa0, 'Délicieux, sans l''appareil à Crumle.', '2006-04-11T19:32:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44719, cb3f0932-05bb-4ae1-bb3f-ff45789461c7, 'Désolée mais cette tarte est beaucoup trop lourde, trop compacte et pâteuse.', '2006-02-12T21:07:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44719, c66b148c-eed6-4578-8d30-23024785339a, 'Alors pour les amateurs de nutella, il n''y a pas à hésiter! Miam miam...', '2006-02-11T15:34:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335643, 07dfc297-8918-4dbb-91fb-382a97d53d4a, 'Très bonne recette, réalisée 2 week-ends de suite pour aller chez des amis. Pour les plus gourmand(e)s, se marie très bien avec une boule de glace à la vanille !
Suggestion, à tester : battre les blancs en neige pour un rendu plus aéré.', '2023-10-21T12:02:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335643, 4e3181f4-b4ba-497d-b97e-146e007abaf7, 'Délicieusement bon et très facile à réaliser.  Je recommande cette recette aux débutants, inratable si on suit bien la recette', '2022-04-24T10:39:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335643, e6a7042d-c66e-442c-aa62-6a2e154f51a7, 'Excellent ! Seule modification, j’ai remplacé le jus de l’orange par un verre de jus de clémentine. Le cake est moelleux et très savoureux. Je garde cette recette.', '2020-01-11T02:53:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335643, f45f4647-a950-45c8-9d91-7e1bb479fc35, 'Très bonne recette. J''ai remplacé le jus d''orange par du lait et ça donne un goût très doux. La texture est moins aérée qu''un cake classique mais elle est également plus humide. Bref, j''adore. Ça manque juste un peu de sucre à mon goût.', '2019-04-14T14:57:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335643, 369dcff5-3278-4f6d-a259-b9bca0519639, 'Superbe mariage entre speculoos bananes et jus d''orange.', '2018-03-16T03:51:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335643, d11159b9-c2d4-410e-9d2b-edbdb0b2cd04, 'Très très bon. J''ai réalisé ce gâteau avec mon fils de 6 ans avec des bananes très mures. Le mélange des saveurs est parfait ainsi que la texture. Je le referai sans hésiter.', '2015-03-31T00:18:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55579, 16ab5fe7-72ad-4c47-9c48-3074e36e3f00, 'Rien d''extraordinaire mais très bon plan pour recycler les bananes en fin de vie. Meilleur après complet rfroidissement des bananes.', '2007-06-08T00:24:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72164, 339ffbaf-8b9f-4f9c-a736-6e4501fda86e, 'Délicieux. On peut aménager à sa convenance avec les fruits à sa disposition et ajouter 2 CàS de rhum blanc ou de Grand Marnier si l''on apprécie.', '2013-07-07T19:38:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72164, 29003299-a168-476f-89e3-a860e25ee9e1, 'Très bonne recette je la fais régulièrement. Toujours un succès.', '2011-11-09T23:29:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72164, 92b7b172-1725-4a61-afec-610554a68614, 'Bonne recette, on peut même ne pas ajouter de sucre à la fin. Avec des pêches de vigne, ce sera d''autant plus appétissant.', '2011-08-18T00:33:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81548, 67e41eb6-ac8d-44e7-9a50-d4e5e44b02e1, 'J''ai mis des cerises à la place des framboises (c''est tout ce que javais sous la main) : un régal ! Meilleur bien frais quand même :)  ', '2014-08-04T15:52:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81548, 475b5643-25e3-4bdb-8240-f73e49a20a82, 'Désolée, je n''aime pas critiquer, mais franchement je n''ai pas trouvé ça bon. Je pense que ça vient de la banane qui donne un goût très étrange, c''est dommage. Je réessayerai mais en remplaçant tous les fruits par des poires par exemple...', '2008-09-29T17:54:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61382, 549aaaee-d451-4843-adb1-c0ee1a810b50, 'J''ai ajouté un peu de poudre d''amandes, délicieux !', '2023-04-14T17:42:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61382, f36926a0-7b2a-49a4-b583-75d71db83341, 'J''ai mis de la farine de blé bio, du beurre à la place de l''huile et un yaourt Les 2 vaches à la vanille. Je n''ai pas ajouté de banane sur la pâte. Le gâteau est très bon , les pépites se marient bien avec la banane. ', '2017-08-22T20:17:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61382, 6e9a91ad-d3c9-4754-9ed9-b5d91036dbe0, 'Ohlala, je l''ai fait il est magique !', '2013-07-31T21:07:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61382, ab487dfe-de7b-4116-952a-cf449c219446, 'Pas mal du tout: texture intéressante grâce aux bananes qui ont fondu sans se mélanger; une très légère amertume, quand même, due au quinoa. Impossible de lècher le bol de préparation, la pâte crue n''est vraiment pas bonne, d''où ma surprise en goùtant le gâteau cuit: c''est BON.', '2008-05-06T18:19:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392165, 4c7c01af-b8ce-4f9f-8fed-b2e827498856, 'Super bon ! Je met juste un petit moins de sucre car je fais revenir les fruits dans du caramel avant ahah', '2021-08-17T16:09:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, c65b0ff8-41f6-48e0-8765-8e168b3dd6a9, 'Un régal au goûter pour toute la famille. J''ai ajouté la levure comme beaucoup le conseille. Ils sont hyper moelleux.', '2017-08-27T19:01:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, be11af15-e3a3-4eb0-ae56-fafd52eecacf, 'Il faut plus de farine. Sinon vous vous retrouverez avec une pâte trop liquide..', '2023-05-05T23:59:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 22de7be0-fd13-410b-9e88-63e20d2df615, 'Pas comme sur la 1ère photo avec cette recette bien évidemment mais très bon ', '2022-04-17T16:58:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 417c2655-41ea-455d-b5af-9ec884387204, 'Très bon !', '2020-12-21T18:33:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 69d8cbd2-2cfa-4f6b-8bb0-c2180e6eccd3, 'J''avais 5 bananes bien mures, j''ai donc mis 5 CaS de farine et 2 oeufs. J''ai ajouté l''equivalent de 1 CaC de stévia et 1/2 CaC de bicarbonate. Mon appareil etait plus liquide que sur le film, mes beignets ont bien gonflé et franchement c''est très bon. Le seul bémol est que ca reste très gras, même aprés un passage sur de l''essui tout. 
Ca reste pour moi une bonne recette pour eviter de jeter des fruits trop murs.
', '2020-06-14T17:29:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 7c52e0b3-7faf-45dc-9b96-696513a0b924, 'Simple et efficace. Pour ma part, j''ai mis un peu plus de banane et on s''est régalé.', '2020-04-02T16:20:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 679e2db4-f1a5-49bc-ae58-67096f3f1597, 'Super bon.', '2020-02-18T23:49:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 6c2a2ff2-3a49-4e34-bff5-12834c4d4509, 'Ca va. 
Un peu trop sucré pour moi, c''est déjà assez gras les beignets en général donc + le sucre ...
Je laisserai des gros morceaux de bananes la prochaine fois, c''est meilleur et la banane sera plus mise en avant !', '2019-06-23T03:10:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 1606b294-2ad5-4536-a1ef-28f83e0c4565, 'Délicieux, moi j''ai aussi fait a l''ananas !', '2017-10-04T22:24:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 5dcf588c-1b26-4c41-afb5-51fcece5278f, 'Ca ne ressemble pas à des beignets. La quantité de farine n''est surement pas suffisante.
', '2017-07-09T19:28:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 2bfc1287-c140-4d7d-baab-d779d427d899, 'Un régal !
', '2017-07-01T15:14:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 7f4de9d8-d178-4bc4-a78a-bc82e53bf89b, 'Recette succulente. Réalisée en 5 minutes et dégustée 15 minutes après. Ces petits beignets sont agréables a regarder ( formes de langues de chat ) et sont croustillants, bien grillés mais au coeur fondant. On adore ce petit gouter. Merci encore Marmiton, a refaire.', '2017-05-07T20:35:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, c619045f-a651-4872-8ab0-f9bbd600b4b5, 'Trop liquide, impossible de faire des beignets.', '2016-10-13T16:32:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, f871f1ec-984c-44ac-aa61-23219ab924a9, 'Excellente recette tout le monde a apprécié donc c''est très bien et vraiment très bon !', '2016-02-28T13:47:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 32a2b2c7-5f90-4176-aef5-de9825df970c, 'Très facile et très bon !', '2015-12-13T20:06:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 18a25380-d66b-4cfb-af65-398d1999a1cf, 'J''ai remplacé les bananes par des pommes, c''est excellent et très facile à faire !', '2015-01-11T14:52:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, a9e9a5ee-603a-4d75-8c96-df2dd861d78b, 'Très bon... La marmaille a bien apprécié.', '2014-10-24T19:58:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 53630e37-83c3-4b9a-ae0d-b3d737a6d0b9, 'Très bon, et le fait d''avoir oublié l''oeuf (proportion divisée par deux) n''a dérangé personne ! Je referai comme ça !', '2014-08-19T13:49:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, d1e09038-ce62-48a2-80c8-0f52e92b0649, 'Un délice, rapide, pas chère, mis exactement même dose, j''ai rajouté 100 g de noix de coco en poudre.   ', '2014-01-30T12:05:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 8722ec25-c547-485f-9e1b-944e81dcb23d, 'J''ai fait cette même recette avec des pommes que j''ai fait bouillir pour transformer en compote. Juste délicieux !', '2013-10-13T19:32:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 9f821ed5-ce68-4f5f-b6be-1ec3006152cc, 'Très bon, il faut bien tenir la cuillère à soupe droite quand vous mettez à frire pour que les beignets soient en forme de boule. Une fois cuit les mettre dans un plat avec de l''essuie-tout, changez l''essuie-tout quand vous avez frit tout vos beignets, cela permet d''enlever un maximum d''huile. Un régal !', '2012-10-14T17:15:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 130749af-844e-4e73-9077-e645ef15e1d5, 'Excellent, j''ai quand même mis 3 cuillères de farine au lieu de 4 et 2 de sucre au lieu de 4...et pour saupoudrer j''ai utiliser du sucre cristallisé. Je dirai que cette recette peut être arrangé selon les goûts. Pour ma part je trouve cette recette très bonne. ', '2011-10-07T00:40:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 5057db1f-b37b-4622-9976-0a8066741ebf, 'Facile ne veut pas dire bon ! Cette recette n''a pas un grand intérêt, on retrouve simplement le goût de la banane cuite, la pâte n''est pas terrible. Personnellement, je déconseille cette recette sous peine d''être déçu ! ', '2009-07-31T17:29:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 5347aba4-1029-45a2-ac43-d6a2cbed0d3b, 'Excellent, cependant nous sentons beaucoup l''huile et leurs aspects n''est pas très appétissant. Dommage.', '2009-02-14T20:45:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, a2139606-6dde-4601-925f-64bea3e736e5, 'Comme ceux de mon enfance.', '2009-02-08T20:09:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, b78d676d-e392-4bee-9eda-b39164a030ad, 'Rien d''exceptionnel, j''ai juste l''impression de manger de la panade chaude. ', '2009-02-01T14:54:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 0d91c1d4-dd61-4938-8296-1941a66f05dc, 'C''est très bon, ça reste des beignets, mais on sent bien la banane, recette sympa.', '2009-01-22T12:43:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 9a78cc66-91fa-4065-8a43-a7af89e569a6, 'Vraiment bon et rapide (j''ai une grande poêle ^^''). Rien à redire, j''en referai. = )', '2007-04-04T19:03:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, f91ea059-709e-4390-91b6-2624664bf8e5, 'Assez décevant et surtout très vite éceourant, ce qui est dommage! Il faut que l''huile soit bien chaude et attendre que les beignets soient bien dorés pour les manger!', '2006-08-16T19:08:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37197, 40e07c22-4afd-4ee7-beea-626b84689072, 'Cette recette est très bonne, rapide, et facile à réaliser. Merci beaucoup.', '2005-12-01T19:20:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28598, c5c3bf28-e3c9-4d75-b2c5-1195886fd3b1, 'J''ai été déçue par cette recette... pourtant j''adore les fruits exotiques mais le mélange de ces fruits (notamment les litchis) sur cette tarte ne donne pas un goût exceptionnel ... ', '2006-08-17T10:26:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28598, be209754-ff4e-43ef-bb1e-48dd5b2f9af2, 'Une tarte aux saveurs exotiques très rapide et facile à réaliser. Cependant les avis sont mitigés car certains trouvent le goût de la banane trop prononcé et d''autres adorent ce goût original de la crème! Merci Hélène.', '2004-11-02T07:21:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 0e40dace-ee57-43b4-8d8a-1f2c87d986c1, 'Je confirme : il faut trois bananes, 150 g de sucre et seulement 30 minutes de cuisson, plus de chocolat pour les gourmands.', '2022-11-11T13:25:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 99f6177e-9c43-4dfc-a762-a25610a40fc6, 'Très bonne recette. Je n''ai mis que 150g de farine et 100g de sucre pour 3 bananes et 2 oeufs, plus un peu de rhum, très moelleux !', '2020-02-23T18:29:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 93e64e3f-d010-430e-8492-944903eac29f, 'Trop lourd à mon goût! Et hyper calorique! Autant de beurre et de sucre? Mon homme cuisto l''a mangé mais n''a pas sauté au plafond! ', '2007-02-04T09:23:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 573a6b0a-beb2-40de-af1d-0a8d98561429, 'En suivant les conseils moitié farine et moitié maïzena, ce gâteau est effectivement bien mouelleux. Mon test fut concluant, je recommencerai. Tous mes collègues de travail l''ont apprécié.', '2003-05-03T19:47:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 40630452-78b5-4c90-b26c-b28ace21641f, 'Pour 10 personnes ,80 mins de cuisson au lieu de 60 mins. Je l''ai laissé 15 mins four éteint porte entre ouverture. Très moelleux mais j''ajouterai 1 banane en plus pour le goût la prochaine fois. 
', '2023-08-27T16:34:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 3701535d-aaf0-41fb-9366-2b3ecab986cd, 'Ce gâteau est délicieux', '2023-05-21T14:46:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 23bc9638-ffa2-45e8-934d-0c7e9c37f7b9, 'C''est un succès ', '2023-04-06T13:12:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, fbdd74ca-f00d-459e-a367-6edbb37ff80a, 'Délicieux et moelleux. 1 banane supplémentaire pourrait être ajoutée pour mieux sentir son goût.', '2023-04-01T14:26:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 8c15c0c2-3f26-4c4e-95e7-777035fa93fe, 'Excellent ! Super moelleux !', '2023-01-01T17:32:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 74f7f0b5-8e1a-40b1-b658-350663957ac8, 'Un classique rapide et facile à faire. Délicieux !', '2022-10-31T10:04:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, a792a543-065a-4f61-b6a6-e5a6c97ad36f, 'Incroyablement bon !!', '2022-10-28T16:45:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 2872f1cc-ffb3-4f2e-8702-aa32ba9c2445, 'Super recette 😉', '2022-05-25T14:11:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 17ad8f17-0897-47e2-af55-35b0aada4e50, 'Tout le monde adore à la maison 😁 comme dans différents commentaires, on met un peu moins de sucre dans la recette, mais on saupoudre de sucre vanillé ! Un délice', '2022-05-06T15:49:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, b416d6c9-a0ec-4501-9705-49a1b07535eb, 'Très bon ! 🥰', '2022-03-02T09:07:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 7f1660c2-e63b-4549-a2d7-1015f4c54ab0, 'Très bon , j’ai mis que 150 g de sucre. Il a été très apprécié. Merci', '2021-11-08T08:38:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 0cb57cca-b14c-464b-b94a-7c9de2a01048, 'Top avec 150g de beurre ', '2020-10-11T16:16:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 74634571-6925-4498-bbfe-a88cd543cd1a, 'Trop sec ', '2020-08-16T21:24:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 9c70e118-9e5a-4e26-8eac-b85870d58593, 'Recette simple à faire. Délicieux et bien moelleux.', '2020-04-06T19:16:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, c9381b6a-e226-4625-9d0d-d3ec4c177348, 'Gâteaux vraiment moelleux, j''ai divisé par 3 le beurre et le sucre et c''est vraiment appréciable en bouche.', '2020-02-20T05:59:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 2d4fc5b8-637f-4a63-9828-5ae0664605a4, 'Rien à dire, juste ajouter 1 banane.', '2019-07-03T06:37:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 99f9250c-5bb1-43c1-a30f-0846bc87caf5, 'Bonne recette. J''y ai mis 4 bananes et un peu moins de sucre et beurre.', '2019-07-01T11:01:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 598ca582-9d92-4232-bb4f-5ac9b11870c5, 'Très bonne recette. J''ai ajouté une banane supplémentaire et un peu plus de chocolat également. Nous nous sommes régalés.', '2019-03-19T08:45:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 6b4cd175-3e64-4aa0-8f0d-c303f5456bba, 'Limite parfait !!! J''ai mis 3 petites bananes et 150 g de beurre...impeccable.', '2019-02-17T06:25:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 681ed37b-9c3b-40ce-9774-0daafacf3208, 'Excellent j''ajouterai une banane supplémentaire la prochaine fois pour avoir plus le goût du fruit. Attention à la cuisson peut-être un peu trop longue.', '2018-12-16T12:21:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 5c46db30-1941-4c72-9783-7b0277ceae13, 'Le meilleur gâteau a la banane que j''ai réussi jusqu''à présent ! J''ai remplacé 40g de beurre par du chocolat fondu et ajouter une poignée de coco râpée, moelleux et plein de saveur,  miam !', '2018-09-17T09:11:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 2a09cf03-f1b6-466e-8d36-7c2c8f5fefc0, 'Moelleux avec un bon goût de bananes avec quelques modifications selon les commentaires: 50g de beurre, 130 g de sucre dont sucre vanillé, moitié maïzena, bicarbonate de soude à la place du sel, 4 bananes. Cuisson 1h a 160 degrés.', '2018-07-04T08:23:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, a579cb20-5ff1-4497-bd51-3ff256d886f1, 'On a tous adoré', '2018-05-11T05:32:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 40fc0da9-d8d8-42a6-b381-b7664376ef58, 'Bonne recette, de quoi faire un bon gâteau avec un trop de banane !', '2017-10-26T17:42:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, ed1df296-3a33-4454-bf24-6992a424f1c9, 'Ma soeur qui a 13 ans a fait ce gâteau hier soir et je peux vous dire que c''était trop bon, bien qu''il soit un peu trop sucré mais tout le monde a aimé. ', '2006-07-26T05:52:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 5fe37d1e-a560-4a60-89d3-7499d796f2dc, 'Très bon, j’ai suivi le conseil de la Maïzena et du sucre.  Je n''ai pas mis l''extrait d''amande qui d''ailleurs n''est pas repris dans la réalisation de la recette. ', '2006-04-29T23:04:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, c3aff502-cfb0-4678-a1e3-ba7c3694a2d6, 'Le gâteau est très gras et on ne sent pas assez les bananes. Mais sinon, tout le monde a aimé.', '2005-11-09T22:38:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 1197c1e7-7524-413c-87d6-f3be3cb045b1, 'J''ai trouvé l''aspect en bouche très particulier mais mes amis ont aimé.', '2005-07-24T20:20:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 58c9c0aa-cde6-4ec2-a4ad-efb7d2099bf8, 'J''ai l''impression que mon gâteau n''a pas trop bien cuit. On dirait un pudding mais mon ami qui est méga difficile à aimé, alors!!', '2005-03-21T21:24:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, de6d26ff-5834-4f50-9fca-914965126257, 'Je l''ai fait 2 fois de suite, les enfants en raffolent! C''est super bon!', '2005-03-07T20:49:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 0764570b-72cc-4913-b5a9-ce7b5e55eb7d, 'Ce gâteau est très bon. J''ai mis moins de sucre: 175 grammes, et la deuxième fois j''y ai mis aussi de l''ananas.', '2004-11-16T19:39:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 0d19207b-4af8-49ce-969b-8c7742dcad80, 'Recette délicieuse! Si on tient compte de quelques modifications. Je n''ai pas du tout mis de beurre je l''ai remplacé par un verre de lait écrémé et un verre d''amaretto, j''ai également diminuer la quantité de sucre à 150g. On s''est tous jetés dessus sans culpabiliser...', '2004-09-24T20:17:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 916dc8fb-7e93-46d8-8e84-35b28c0d8b95, 'J''ai essayé cette recette et je la trouve pas mal du tout bien que le gâteau obtenu ait été assez peu aéré. Cependant je recommande cette recette.', '2004-09-15T19:58:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, c4adb019-46b0-4a91-8577-3eff886c800a, 'C''est un gâteau ni excellent, ni mauvais. Par contre, il est trop sucré.', '2004-09-14T15:38:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, c2dad7d6-c245-4e35-96c2-8f02c5dfcf5c, 'Super bon! En remplaçant la moitié de la farine par de la maïzena, c''est un gâteau super moelleux avec un goût très délicat de banane. Délicieux accompagné de nutella, mais attention pour le régime.', '2004-08-24T21:53:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 1ca141d3-b166-43c1-a1c7-f2a680ad716b, 'J''ai 11 ans, je l''ai fait.. C''est délicieux! Même en oubliant de faire fondre le sucre...', '2004-08-23T18:36:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 42ba9b0e-8b88-4006-b1ab-b034cd90ba8f, 'Assez sec, on ne sent pas beaucoup le goût de la banane, bien que j''en ait mis plus que prévu. Je suis plutôt déçue...', '2004-03-12T14:55:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, b2b79aff-500e-493d-a682-f53a44fee6d5, 'Tout le monde a adoré! Ce gâteau était vraiment très bon, mais j''ai utilisé 100g de maïzena comme les autres internautes. Essayez, vous ne serez pas déçus!', '2004-02-09T00:49:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 204a314a-80e0-4940-b046-1746ef61f0ec, 'En fait, j''ai été un peu déçue. J''ai trouvé que c''était un peu sec et qu''on ne sentait pas assez la banane. Pourtant, j''en avais mis plus que prévu par la recette. Cela dit, il n''y en a plus, donc ils ont dû aimer quand même!', '2003-11-12T13:07:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 19b95d32-a78f-42ce-9ccb-9bb6ef22d5db, 'Super moelleux! J''ai essayé quand même, bien que je n''aime pas la banane. Le goût de banane est délicat, juste ce qu''il faut. Merci pour la recette!', '2003-11-11T11:53:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 988e75e2-ee18-4bdd-84e2-2eef6720780b, 'Cette recette du moelleux aux bananes au chocolat est formidable. Ce gâteau est facile et excellent! A vous de l''essayer, vous en serez satisfait. Vous pouvez même essayez de rajouter ou d''enlever des aliments sans perdre de la saveur ni le gout. A faire et à refaire!', '2003-11-10T14:37:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 6e26e42d-6dcf-4451-9095-e033ee527613, 'J''ai suivi les commentaires de tous et remplacé une partie de la farine par de la maïzena. Il faut conserver le gâteau au réfrigérateur (à cause des bananes!). Tout le monde a apprécié.', '2003-10-05T19:10:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 5efe1acd-7c07-4446-94c7-537f4e5e5f24, 'Excellent! Pour ma part, j''ai coupé les bananes  en rondelles et je mets mon gâteau au frais avant de le servir, un délice!', '2003-10-03T12:58:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 3186d702-3748-4cca-b793-24458e1e2b07, 'Excellent! J''ai aussi remplacé 100g de farine par de la fécule et j''ai découpé les bananes en fines rondelles au lieu de les écraser. Un vrai délice!! Mon petit monde a adoré...', '2003-09-28T20:28:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, d1e7a0b2-a40d-4194-a27c-ab77ecb3c348, 'Comme l''on fait les précédentes internautes, j''ai mis 100g de Maïzena à la place de 100g de farine. Le gâteau est très bon et moelleux, seulement j''ai eu un problème avec les pépites de chocolat qui, avec la cuisson, sont restés collées au fond du plat. Je ne comprends pas. Où est mon erreur?', '2003-06-10T17:44:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, b678bf50-d487-42dc-a7ad-2116b2c9e6b2, 'EXCELLENT! Moelleux, délicieux. J''ai moi aussi remplacé 100g de farine par 100g de Maïzena.', '2003-05-18T01:29:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 2b59806b-2198-4e55-986e-ad955d93f030, 'Vraiment délicieux, léger et moelleux, pour un gâteau à la banane c''est une véritable surprise. Je l''ai essayé avec moitié farine et moitié fécule. Par contre, 1 heure de cuisson a été nécessaire.', '2003-05-12T14:37:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, d2eb0f01-308b-4ab7-9908-9f804e00aa83, 'Excellent, j''ai remplacé 100 g de farine par 100 g de maïzena, c''est encore plus moelleux! Il a fait l''unanimité chez moi.', '2003-04-19T09:37:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 52ca370f-2e48-4980-9b03-e6ccf25cd82a, 'Très bon et très moelleux. Je n''avais pas de pépites de chocolat, alors j''ai ajouté 100g de chocolat fondu à la place. J''ai aussi suivi les conseils avec 80g de fécule et 1/2 heure environ de cuisson. Merci!', '2003-04-17T17:24:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, c45d4a1b-2092-4561-84fe-a77b6778bc27, 'Mmmm!... Il a plu à toute la famille. J''ai suivi les conseils (un peu de fécule, temps de cuisson d''environ 30 min). Il n''en reste déjà presque plus...', '2003-04-07T22:40:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 1128f7bb-5b90-41d8-a284-09ef16e872e5, 'Excellent!!! J''y ai ajouté une banane supplémentaire et diminué légèrement la quantité de sucre. Un délice! Attention toutefois à la durée de la cuisson... 25 à 30 min étaient suffisantes.', '2003-03-15T11:14:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 43e33245-d0b9-4618-bb51-39370d120934, 'Un peu déçue parce qu''il n''était pas moelleux. La prochaine fois, je remplacerai la moitié de la farine par de la fécule.', '2003-02-17T15:46:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 85722ac8-c6a1-4cab-bd23-887008d57e86, 'Tout le monde à qui je l''ai fait goûter l''a vraiment trouvé très bon. En plus c''est une recette très facile à réaliser.', '2003-01-23T14:39:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, e1635af5-6507-4893-8a56-92564b6cbd42, 'Excellent, il a beaucoup plu!! J''ai remplacé environ 80g de farine par le même poids de fécule, cela l''a rendu plus léger. Et effectivement, un peu plus de chocolat ne fait pas de mal!', '2002-12-14T13:55:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17631, 992ec302-d51e-47be-bb4e-efbddce02b2a, 'Très bon. Mais il faut mettre plus de chocolat. Attention, en 30mn mon gâteau était un peu trop cuit.', '2002-12-01T20:50:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54144, 04c977f1-0c3e-49cf-a06c-9282ad08cbca, 'Excellent et succès garanti !', '2014-12-22T22:31:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54144, 86e803ed-aae5-4d11-a61a-70933e7f5b88, 'C''est la 2eme fois que je fais ce dessert avec toujours autant de succès grands comme petits (dans ce cas je n''ajoute pas de rhum qui n''est pas une obligation). Je sers en petites coupelles individuelles avec une boule de glace vanille. C''est succulent et surtout un bon dessert d''hiver, facile à manger après un bon repas. A faire et à refaire sans aucun problème. Je le prépare d''avance pour gagner du temps et le fais réchauffer au dernier moment.', '2012-02-19T15:56:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54144, d0aa9d02-0755-4f48-96ab-bd8f682919d8, 'J''ai suivi la recette telle qu''elle est.  Résultat, c''est très bon. On peut les préparer à l''avance, laisser patienter dans une casserole (les fruits vont macérer)et réchauffer légèrement au moment de servir.  On peut également rajouter une boule de glace à la vanille ou garnir une crêpe.', '2007-03-09T23:04:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167559, 711ea196-4166-4d79-bd26-ceaed6b57d6f, 'Testé avec des poires mûres au lieu des bananes, un DÉLICE ! Merci pour cette recette.', '2016-07-22T17:00:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167559, cd6aaeff-cfb1-44a8-b33c-c18fbac0b56b, 'J''ai testé la recette avec juste un peu de jus de pomme.  Je l''ai cuit 30 minutes. C''était un peu collant mais très bon. Merci pour cette recette simple et avec des ingrédients "classiques".', '2016-03-18T21:31:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167559, 71a1f59b-3134-4702-856e-cb584990c689, 'Merci pour cette recette avec des ingrédients que l''on a ! J''ai testé la version coco chocolat en mettant 4 cas de coco râpée et 6 cas de chocolat en poudre et c''était délicieux. J''ai fait cuire 25 minutes et c''était très bien, moelleux et bons. ', '2015-12-01T16:23:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167559, e6ce426f-5acb-417d-8573-5bc71075ee6d, 'Très bon ! Ne pas hésiter à mettre un sachet de levure entier (11 g la plupart du temps), sauf si vous aimez des petits muffins. J''ai testé coco/choco, ne pas lésiner non plus sur la poudre de coco, ça donne un bon coté croustillant. Enfin, la substitution des bananes avec le yaourt comme conseillé par "flodervily" marche très bien, merci ! ', '2014-11-13T19:17:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167559, 8366c238-5b83-441d-8f04-49d3997aff05, 'Sinon vous pouvez remplacer la banane par du yaourt de soja nature (environ 60 g par œufs) à mon avis dans cette recette 120 ou 150 g ! ', '2011-04-29T12:55:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167559, 62fb33ec-dae7-416a-bd1f-802473ca3d97, 'Excellente recette, la consistance est parfaite et les ingrédients faciles à trouver... J''ai testé la variante pommes-cannelle, j''essaierai les autres sous peu ! Pratique quand on a un invité végétalien, ou juste pour les gourmands !', '2010-06-20T18:55:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, e6996f50-f86e-4003-af42-89990c6c62ff, 'En doublant les quantités et en utilisant 3 bananes bien fatiguées, j''ai obtenu un cake moelleux et délicieux. Temps de cuisson à adapter en conséquence, pour ma part 45mn', '2020-04-03T05:02:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, 22ef2eab-1ad5-4392-89ab-49ca65290e57, 'Top et super pratique pour la recup’ des vieilles bananes', '2018-11-02T06:46:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, a38df6b8-e773-4ad6-9148-1b5428871263, 'J''ai double les proportions car pas assez de pâte et ai rajoute un oeuf.  La couche nutella a l''intérieur reste moelleuse. Une vraie tuerie! Conseil : utiliser des moules a cupcakes.', '2018-02-24T12:07:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, 1df660e6-10c9-4d23-96f7-8749bde0085f, 'J’ai doublé les quantités, par contre les miens ne ressemblent pas à la photo de base j’ai du oublier quelque chose les miens sont blancs enfin doré et pas marron mais ils étaient bon quand même 😁', '2023-02-02T21:41:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, 5f7abfc2-c925-4e14-8e1e-f1b5f687e6d7, 'Super bon mais le résultat n’est pas marron mais beige ??', '2021-02-07T20:37:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, f591a198-2b7c-4cd2-b004-2f709ad40a8f, 'J’ai juste ajouté 2 œufs à la recette et c’est un délice ! Bon appétit. ', '2020-12-27T17:39:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, cc0b5bb4-cb6a-4d90-8076-c0b6afc52b25, 'Super bonne recette', '2020-05-27T01:32:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, 66041f7f-0f2b-48a3-8520-4726a9d9468c, 'Attention aux quantités comme indiqué dans d''autres commentaires, sinon très bon.', '2019-10-21T12:43:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, a939904d-dda5-4d5a-8ead-215e998c42a8, 'Vraiment bon !', '2019-09-13T07:57:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, c1558c25-7ae6-4f8c-8ea3-85ef8f5a619f, 'Très bonne recette. Comme indiqué sur certains commentaires j''ai doublé les ingrédients et mis 1 banane et demi. 
Très bon résultat. 30 min de cuisson et le coeur ne coule pas juste fondant.', '2019-09-01T07:07:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, 2718654d-cae5-4bc9-99c1-9b6b7f984e57, 'Super bon ! 
Petit bémol sur la quantité de pâte et sur la cuisson.', '2018-03-05T09:08:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, 83d402e3-17e0-43f9-868d-b3788403bdfe, 'Exactement ce que j''attendais !', '2017-05-27T20:49:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, 8a8cb751-eba8-48f7-aa58-234241373cc8, 'Mes papilles gustatives ont été gourmandisement satisfaites. ', '2017-05-23T21:33:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, 418319b8-20b1-4d00-93e3-e49450ca618a, 'Recette effectuée en doublant les proportions et ajoutant 1 œuf, j''ai pu remplir un moule à cake, délicieux ! ', '2017-04-05T14:51:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, 6768983a-6484-4a81-8bcf-1b1476ae4e4b, 'Très bonne recette, mais également très peu de pâte alors je l''ai également mise dans des moules à cupcakes. ', '2015-05-14T22:07:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, a9e7aba4-f939-460c-850a-a820ff4744bc, 'Trooop bon ! J''adore, à refaire.', '2014-09-24T18:20:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, 77190830-ca2f-42ac-ad2a-e6b71c67f0aa, 'Très rapide à préparer et très apprécié par les enfants. A refaire.', '2014-05-11T22:08:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, 8ad7e648-8427-4262-98f7-5efbb2206349, 'La première fois que j''ai réalisé ce gâteau j''ai suivi la recette à la lettre. Résultat : pas assez de pâte. Donc la seconde fois j''ai augmenté les quantités de 50 % (sauf pour la banane). Résultat agréable avec un goût de banane pas trop fort. A refaire.', '2012-09-30T20:01:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, 0098c0ac-3eda-4e97-9f51-35cb306db031, 'Mon mari m''a demandé un gâteau nutella banane j''ai donc suivi cette recette. Résultat : très petite quantité de pâte j''ai donc ajouté un œuf et préparé des petits gâteaux dans des moules en silicones pour cupcakes ! Résultat excellent. Moelleux pour la pâte et fondant avec le nutella. A refaire !', '2012-06-19T13:51:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, dea993c2-c077-4ddb-adf4-a1907410cfbc, 'On ne sent pas trop le goût de la banane mais c''est pas mal, sauf la pâte pas trop cuite, je ne l''aime pas trop. Par contre les fans de banane et de nutella vont adorer !', '2011-12-22T14:44:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194185, 63e65870-0329-44a0-a240-6f97409f2ac8, 'On ne sent pas trop le goût de la banane mais c''est pas mal, sauf la pâte pas trop cuite, je ne l''aime pas trop. Par contre les fans de banane et de nutella vont adorer !', '2011-12-22T14:44:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41286, 5c9c5c5e-7f2e-4959-b887-269e0b030c30, 'Très bonne recette ! Dommage que le gout de la banane soit plus fort que le gout de la fraise. J''ai diminué le sucre 1 kg suffisent pour 2 kg de fraises, ne mettre que 3 bananes, 5 c''est trop, sauf pour ceux qui aiment la banane.', '2013-06-15T13:46:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41286, 42a19907-9c68-42eb-a1da-f45f93e573f8, 'Testée et approuvée ce matin, vraiment super bon ! Pour ma part, je pense que les proportions sont parfaites.', '2017-06-30T08:43:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41286, 053b981e-fe24-46dc-b2c9-998ad45e0b58, 'Rien à redire! Délicieuse!', '2008-06-16T21:45:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41286, d7f4f262-311a-4f85-81c0-54fd45e57c3b, '1,6 kg de fraises, 1 citron, 4 bananes 1kg de sucre gélifiant, cuisson 2 minutes dès ebullition : un régal! Merci pour la recette.', '2007-05-21T16:09:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41286, b3c71fd1-dde8-4303-af08-eb97d2c55a0b, 'Une délicieuse confiture, c''est certain, mais que l''on peut préparer plus rapidement si l''on est un peu pressé.   La nuit de macération au frigo n''est pas indispensable.   Personnellement, j''ai mis 1 kg de sucre pour 2 kg de fruits préparés (fraises équeutées et coupées en morceaux, bananes épluchées et coupées), cela suffisait amplement.', '2007-04-15T11:44:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41286, 6792e99f-3fa0-4178-a21a-a4358990091f, 'Super, ça m''a réconciliée avec la confiture de fraises...Je n''en avais fait qu''une fois et je l''avais râtée. Sur cette recette j''ai rajouté un peu de beurre, pour enlever l''écume qui se forme au fur et à mesure. Bien aussi car la recette ne fait pas mettre trop de sucre. Ce sont les dernières fraises de la saison pour un 1er octobre c''est pas mal. J''ai apprécié aussi le mélange fraise et banane : inattendu mais savoureux.', '2006-10-01T13:19:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41286, 72e51011-27a2-4700-bf76-09d5340ec366, 'Tout simplement délicieuse ! Il n''y a pas que les enfants qui se sont régalés... Les fraises et les bananes se marient à merveille. J''ai laissé macérer les quartiers de fraises avec le sucre toute la nuit et je n''ai ajouté les morceaux de banane (bien mûres) qu''au dernier moment. Je n''ai pas ajouté de citron, mais j''ai mixé les fraises et les bananes juste avant de faire cuire la confiture (40 min de cuisson pour 2 kg de fraises et 5 bananes). Confiture crémeuse à souhait. J''ai déjà acheté des bananes pour en refaire ! Merci pour cette délicieuse recette.', '2006-06-27T17:24:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371965, b973cd9a-0ee2-458e-9d50-957a8d5c3069, 'Trooop bon et très sain! Pour les gourmands je conseille de rajouter quelques pépites de chocolat, le rendu est délicieux ?', '2020-04-22T15:23:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371965, e047dd94-00fd-4a99-b047-85a01825ef3c, 'Un peut spécial comme recette je me demande s''il y a pas un problème dans les proportions des ingrédients.', '2020-01-02T07:28:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371965, a26179f7-6105-497a-9700-898911c21bb6, 'recette très spéciale, la pâte est bizarre, je ne conseille pas ', '2023-08-31T09:56:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371965, f8bb0f90-e8a0-4b4d-8d96-038592123090, 'Recette tres simple et délicieuse a tester ', '2020-11-16T15:08:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371965, ddd4a440-2d17-4981-aa8e-9eb5f52c1af0, 'Il faut mettre un petit peu plus de farine mais sinon super recette pour une personne ça fait une dizaine de pancakes. :)', '2019-11-12T05:54:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 9e51e2e2-8e0c-4114-b5eb-62f4d05e96d7, 'Ce gâteaux est un classique à la maison que je réalise depuis de nombreuses années. J''ai au fil du temps rajouté pour le plus grand plaisirs de mes petites filles des noix ou des noix de pécans coupées en morceaux et d''autres fois des pépites de chocolat. J''utilise toujours des bananes très mûres pour le goût. ', '2024-02-19T18:01:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, d659f5f1-a033-4a67-802c-41ee9894d4e6, 'Cette recette est devenue un incontournable chez nous ! Je respecte les quantités indiquées , j’ajoute du rhum , et parfois un peu de jus d’orange. En revanche je laisse cuire à chaleur tournante 40 min.
Ce gâteau est moelleux et délicieux !', '2023-12-04T07:49:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, e6800dda-5b91-418d-8c9d-ebbd344e00d4, 'Trop bon,j ai juste mis la moitié de sucre et monté les blancs en neige ce qui le rend encore plus moelleux', '2023-03-15T09:10:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, fc1c8be8-5f4d-4d4a-869a-0c0c56b986bc, 'Merci pour la recette, c''est top et j''en referai. J''ai fait pour six personnes même si on n''est que quatre à la maison, pour six personnes, c''est marqué 100 g de sucre, j''en ai mis 70 g et c''est très bon. Aussi, je vous conseille de cuire 40 minutes au lieu de 30, ça fait beaucoup, mais à 30 min, ce n''était pas assez cuit. Bref, en gros je vous recommande cette recette, c''est trop bon.', '2022-05-01T03:58:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 6839bae6-fc8c-41a8-aec9-c85901cb0c69, 'Comme j''aime peu sucré je ne mets que 70g de sucre...et pour le petit déjeuner au lieu de mettre 150g de farine, je ne mets que 100g de farine blanche et je complète avec 50g de flocons d''avoine. Super bon et plein d''énergie pour démarrer la journée !', '2021-11-27T18:05:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 3214c1d5-af44-458e-8678-d9bd41aa1930, '130 g de farine, 80 g de beurre, 5 bananes moyennes flambées au rhum !', '2019-04-16T13:52:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 9608bfb2-7860-4ed6-af07-f5df4134dbb0, 'Super bon je met juste un peu moins de beurre (80 g).', '2018-12-22T12:50:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 45fd9347-02f6-427d-b727-a1b0aa226f25, 'Super recette ! Réussie du premier coup, mais avec quelques modifications. N''ayant pas de beurre sur le moment, je l''ai remplacé par de l''huile de colza et le sucre blanc par de la cassonade. Je n''ai pas mis de rhum, mais ajouté un peu d''essence de noyau. On peut très bien remplacer la banane par de la poire ou de la pomme. Nickel !', '2018-12-03T08:31:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, ad8e7542-5875-42b5-aae1-1781d971f1b6, 'J''ai mis moitié farine /moitié maïzena et moins de beurre.Séparer les blancs des jaunes d’œufs. Mettre les blancs battus en neige à la fin. Cuisson 10 minutes de plus.', '2023-01-27T20:28:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 5708b7e1-01d8-458d-922a-306f22c68530, 'Testée et approuvée ! Je n''ai juste pas ajouté le rhum car je ne suis pas fan et ai prolongé la cuisson de 15 minutes pour un effet croustillant sur le dessus. 
Le goût est au rendez-vous !!', '2023-01-20T19:06:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 18a5c1c4-e9b2-410a-8d5b-db5ee4822aec, 'Bonjour et merci ! Super recette, réalisé plusieurs fois 30 min à 180. Testé aujourd''hui en rajoutant des raisins secs. Excellent 🤩', '2022-05-28T15:50:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, a382708d-c9ec-4640-a677-a7097f71657f, 'Délicieux', '2022-05-27T17:01:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 6ce9e5f9-b1f3-40ad-b5d0-e554f0e81fc4, 'Très bonne recette ! Faite avec du beurre demi sel, 2 bouchons de rhum (et optionnel quelques carrés de chocolat noir ajoutés à mi hauteur de la pâte versée dans le moule), cuisson 45/50 min à 180 degrés.', '2022-01-14T07:01:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 2512cbde-0139-4098-9fab-0998bda90969, 'Parfait pour utiliser des bananes trop mures. J’ai mis au four 30 minutes à 200 degrés. Cela aurait pu cuire 10 minutes de plus. Le fond du cake n’était pas assez cuit. ', '2021-12-30T20:27:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, b6721b00-2794-4d50-a352-cd8193838877, 'J''ai diminué le sucre de moitie, mis 1 sachet de levure entier et 200g de chocolat, le gâteau est délicieux, moelleux à souhait! ', '2021-03-20T18:53:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, addfa9c1-85c0-43c5-b251-3923a21e24cd, 'Thermostat 6 = 180°
Je teste de suite :) ', '2020-10-17T19:50:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, e36c50f8-c7b7-4cff-a049-de3689cc1799, 'Super recette, simple et super bon. Par contre n''ayant pas de rhum j''avais mis du Cointreau. Tout le monde s''est régalé. Il était juste un peu lourd malgré qu''il soit super bon.', '2019-05-01T13:43:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, b2a3d539-8ee2-4580-8a03-90dfb796cc68, 'Mmmmmmmh miam', '2024-01-31T18:15:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, f48deb9e-2cd7-42ca-92c2-dd91cb83c3e7, 'Gâteau super bon ', '2023-11-09T10:39:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 0262d8d8-d9db-40ac-8a88-5d64262aa645, 'Fait hier, effectivement super facile, simple et rapide, j''ai rajouter de la noix, UN DELICE, UN IMMENSE MERCI pour partager la super recette', '2023-11-02T07:35:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, f29b2cbb-01b1-427c-9fab-bee7026d2b49, 'Très léger, délicieux. J’ai rajouté des pépites de chocolat c’était top !', '2023-10-16T16:02:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, a2e5c2a5-e77a-4212-b475-5b1b1f578f17, 'Delicieux mais trop de beurre et de sucre. 60g de sucre et 80g de beurre suffisent. ', '2023-08-26T19:58:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 3024d747-4c52-462b-8595-c23c7a4475d3, 'Simple , délicieux et rapide, merci pour la recette Steph ', '2023-08-21T13:59:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 13321824-d01d-401f-b9d7-87f97cdfd3d8, 'Excellente recette ! Gâteau hyper moelleux ! J''ai seulement mis 90 grammes de beurre. A faire et refaire sans hésiter !', '2023-07-23T22:01:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, e0e1b3ff-0383-4484-b522-abc1334e4fce, 'Fait pour 8 personnes, j’ai utilisé moins de sucre que prévu et 5 bananes, un mélanges de 150gr de farine complète et 50 grs de maïzena. La cuisson était de 40 minute avec un four à chaleur tournante. 
Résultat au top’avec un gâteau léger et goûteux. ', '2023-07-21T12:57:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, edc25283-3a33-4ea6-943b-38b29cd21529, 'Très bon mais 125g de beurre ça fait beaucoup trop, prochaine fois je mettrais 90g. Mais merci pour votre recette 😊', '2023-07-10T21:09:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 85a96c23-b45a-4e5e-beee-a416c45612f6, 'Excellente recette !
j''ai remplacé le beurre par 100g d''huile de coco.
Et j''ai fais cuire 40 minutes à 180 degrés, chaleur tournante.
', '2023-04-23T15:52:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 5815068b-f00b-48b9-b536-334dea285260, 'Une tuerie ', '2023-04-18T20:30:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 9b2f0714-d689-4f89-bd8b-a20b12f0ed23, 'J’ai mis 3 bananes : 2 écrasées et mélangées à la pâte, et 1 coupée en fine rondelles et placée au-dessus de la pâte. 
J’ai rajouté des carreaux de chocolats coupés en 4  un petit peu partout et c’est un délice. 
Cuit 30 min à 180 degrés, mais pour ceux qui préfèrent un gâteau bien cuit, je rajouterai 10 minutes. 

Sinon, gâteau excellent !', '2022-07-22T22:17:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, f322536d-7f51-4922-a6c6-6f0dcfa1e1ae, 'Étonnant. Super bon. A permis de ne pas jeter mes quatre bananes !! Cuit 40 min thermostat 6. Merciiiiiii.', '2022-06-01T16:26:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, cf86d11d-9a96-4dcc-9e38-e821f0f097ad, 'avec ou sans pépites de choc ce gâteau est une tuerie, bien vu Steph', '2022-05-01T22:27:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, a2ed1380-6ab4-465e-b33a-ad48d46c5476, 'Délicieux, il a disparu en une journée, j’avais ajouté 100 g de pépites de chocolat 😋
Je suis tombée dans le piège de vouloir mettre des bananes sur le dessus en décoration en le refaisant : elles ont empêché le gâteau de lever ! À bon entendeur…', '2022-03-28T21:19:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 10542c53-c697-47a3-868c-4221a9e44128, 'Super bon', '2022-02-26T18:11:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 20ae7f24-d8b5-49bc-82d2-64d74b99d8f0, 'Pour 6 personnes je coupe 3 bananes en petits dés, une écrasée et j''ajoute 150g de noix de cajou concassées, 10cl de lait, un second sachet de sucre vanillé, 3 cuillèrées à soupe de rhum arrangé gingembre/citron, c''est top !! ', '2022-01-18T07:15:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 582b1b23-5288-4b1d-a332-ad19bb9a3dd5, 'Je fais cette recette depuis des mois et tout le monde en redemande ! Suivi à la lettre ! Merci beaucoup', '2021-12-30T17:11:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, b99f571a-dd7b-411d-a645-2f20e5bcb8e5, 'Fait pour passer 4 bananes trop mûres. Tout le monde a adoré ! Juste cuit comme il faut au bout de 30 minutes. J''ai respecté toute la recette. Pour le rhum, j''ai mis la moitié d''un verre à liqueur. ', '2021-10-30T23:10:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 530bd463-98ca-4eea-afea-d3974b56f70a, 'Gâteau très moelleux, la banane est bien présente 😊. ', '2021-10-27T14:18:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 6200a13f-9685-4317-b656-e6ea4b68cbd9, '👍🏼👍🏼👍🏼', '2021-10-24T07:51:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 87c2a86a-4db3-4c52-bae0-0f7a1ce8c4b9, 'Je fais ce gâteau dès que j''ai des bananes un peu trop mures, je mets de la farine semi-complète, c''est parfait 😀', '2021-10-02T17:11:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, c694a25d-81dc-4ff1-a853-4d3d6a3e4422, 'Topissime on rajoute vanille cannelle ', '2021-07-25T17:57:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 114b5219-e506-40ba-834b-c0e5f30fd984, 'Je viens de réaliser la recette et honnêtement c’est excellent ! J’ai laissé cuire env.40mn à 180 et la pate est bien croustillante sur les bords et moelleuse/fondante à l’intérieure ! Je m’attendais à ce que ce soit bien plus cuit, mais j’en avais marre d’attendre alors j’ai goûté et j’ai trouvé cela excellent tout juste cuit ! ', '2021-05-15T03:12:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 02a2e3fa-d7ce-446c-8689-bd55231b6da1, 'Rien a redire! Il est parfait comme il est! ', '2021-02-20T18:59:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 5de6fcb8-2bef-4ae1-ab12-604364eca690, 'Merci pour la recette. On a tous bien aimé. La cuisson 30 min à 180 degrées était largement suffisante. ', '2021-01-26T22:03:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 83a59471-fb09-44d7-b373-2ef749df5faa, 'Gateau très moelleux, j ai laissé environ 40 min à 180°C car pas assez cuit.
Il est cependant un peu fade, je retesterai avec du beurre demi sel la prochaine fois, et ca devrai être parfait.', '2020-12-31T23:51:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 473f1453-194b-469a-9423-36430c8c7549, 'Parfait avec mes grains de sel ! Soit beurre demi-sel ; 1/3 du sucre total avec du sucre de coco et comme vu dans les commentaires des pépites de chocolat. Merci pour cette bonne recette. ', '2020-11-14T11:27:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 4a7608b6-2086-461e-8ada-9704a073fb34, 'Délicieux et très facile à faire. Je le note dans mon carnet. ', '2020-11-13T20:59:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, bf2ba57d-066c-418d-9351-923c14e5f4d4, 'Très peu de goût, très déçue au vu des commentaires', '2020-09-20T12:17:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, f4653fa7-ff3c-4a4d-be3d-d9a442594464, 'Top, merci Steph, enfin une recette vraiment délicieuse... Pour ma part c''est en version beurre salé que je trouve le goût parfaitement parfait !', '2020-09-11T17:19:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 876225bc-d71c-48a8-80e8-2ccb3fc4b8cd, 'Excellent ! Je ne met pas de rhum mais 2 c.à.s de vanille liquide et c''est délicieux !!! Et je rajoute fes pepites de chocolat noir... Un régal ! ', '2020-05-16T20:52:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 9406c7b2-0875-4571-baff-1c4fb855d812, 'Excellent ! Merci pour la recette. Je n''ai mis que 2 oeufs et 50gr de sucre.', '2020-04-11T11:04:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, ca821698-b323-474b-8b38-287c5a6aa6bf, 'Excellente recette. Toutefois, j''ai tenu compte de plusieurs avis. J''ai mis seulement 80gr de sucre, 3 grosses bananes que j''ai flambées au rhum et j''ai cuit 40 mn à 180 °. Ce gateau a eu un franc succès auprès de mes convives', '2020-04-06T10:04:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, e156f3f4-f1dc-44ac-859e-61e2ef661514, 'Avec les bananes flambées comme mentionné en commentaire, une tuerie. J’ai ajouté un yaourt et mis 200g de farine. Moelleux pas trop sucré et un léger goût de banane. J’ajouterai une pointe de cannelle la prochaine fois.', '2019-11-03T11:39:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, fde65356-fc70-4c6d-a9c7-4961dd98b9fd, 'Très bon gâteau ! J''ai mis moitié moins de sucre et ajouté 1 oeuf et 1/2 jus de citron ainsi que 2 barres de chocolat tel quel au milieu du gâteau... Un régal ! Je mettrais peut-être moitié farine, moitié maïzena la prochaine fois', '2019-10-10T11:04:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 25e4bb54-d025-45df-8344-048218bb8504, 'Très bonne recette. Je n''ai mis ni rhum ni vanille, mais du jus et du zeste de citron. En plus, j''ai séparé les jaunes des blancs que j''ai monté en neige et incorporé à la fin de la préparation, juste avant d''enfourner. Il est moelleux et délicieux. ', '2019-09-04T10:47:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 01c8d944-ced9-44e9-90bb-e421977f34ce, 'Excellente recette en tenant compte des suggestions : 75 g de farine, 75 g de maïzena, 80 g de sucre, 80 g de beurre et bananes revenues dans le rhum et pour terminer saupoudrage de cassonade. A faire et refaire ! Merci.', '2019-03-03T11:05:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, efae798b-f6c2-4c62-8692-8bb1f3549870, 'Recette respectée mais je n''ai mis que 60 grammes de beurre sur les 125 prevu. Gâteau très bon et moelleux.', '2018-08-26T14:12:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 876a9728-8d8c-42ee-9dc3-ea469e2d6e37, 'Formidable ! Fait et refait (sans gluten ni caseine) pour mes enfants, un "hit" instantané. Merci Steph !', '2018-04-10T18:29:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 65a109ad-eb0a-42f9-85b4-c1731d7e094c, 'Delicieux, reclamé encore et encore par la petite famille !!', '2012-06-04T14:35:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, dc62ba3f-aeff-4250-a341-fd6a5f54d924, 'Top', '2023-11-12T08:08:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31190, 96313e7e-be50-4500-9398-7e2a3da3a186, 'J''adore ce gâteau au bananes!😄
En + il est très simple à réaliser. 
Délicieux je vous le conseil!
Miam

', '2023-11-10T17:30:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, 178987f9-afa2-4e72-926e-37c5dd133e4b, 'J''en fais régulièrement. C''est parfait si on veut réduire le sucre tout en se faisant plaisir. Pour ma part, je rajoute une cuillère de cacao non sucré.', '2022-02-25T18:26:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, a66a6e1f-cb40-4838-9caa-131ddbd6c6fe, 'J’ai aussi ajouté un œuf, et une cuillère à café de poudre à levée comme mentionné dans les autres commentaires . Et cuit à 180C durant 16 minutes . ', '2023-05-18T10:12:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, ec5426df-74e7-4cb1-9b86-bb3969f7dab3, 'Super recette. Pour un rééquilibrage alimentaire c''est top', '2021-12-19T15:58:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, 5e59d11e-e0af-40a2-8ad4-c12ba27ac98b, 'Je me suis servi des doses qui sont parfaites 👍. Pour ma part j''ai mis 100 g de chocolat fondu (pour l''effet ou chocolat) et j''ai remplacé les pépites de chocolat par un mélange de noix', '2021-05-16T10:50:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, 559855de-38f4-4ac9-94f3-625787ac732b, 'Super recette express et allégée ! 
On se rend compte que nos bananes sont en train de passer, et paf, aussitôt les cookies sont préparés ! Le temps de cuisson, entre 10 et 15 minutes, est largement suffisant.', '2023-09-14T21:08:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, 3da37281-7cf0-4715-b9d3-fc22144612fb, 'C''est simple, rapide et efficace. Mais c''est quand même délicieux ☺️', '2022-11-04T10:30:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, f3b062b0-da23-4a0a-be7c-b314fe531b48, 'Super recette ! Comme le disaient d''autres utilisateurs, j''ai rajouté un œuf et un peu de farine. Le rendu est top et les cookies sont super bon !! Merci.', '2022-02-10T16:49:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, d26db9a5-43ae-4118-9150-0e647d9505b2, 'Délicieux! Hyper rapide, pas de vaisselle, et la texture est assez moelleuse c’est top', '2021-05-05T20:56:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, 6d3849b2-b72a-4798-95f1-423bb9fdced0, 'Pas terrible', '2020-09-06T21:20:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, c7c29bef-1b0d-4183-80d2-6a82e3912c51, 'Très bon !
J''ai modifié quelques points, j''ai mis 100g de son d''avoine (car j''avais pas de flocons), j''ai mis du chocolat au lait (en pépites) et 10 min à 180°C ', '2020-07-01T12:32:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, 8ac6ef85-3bfa-4696-8400-60278b4a29a6, 'Super, j''étais à la recherche d''une recette plus légère et c''est exactement ça ! J''ai rajouté un œuf et un peu de farine comme le conseillent certains commentaires.', '2020-06-10T16:30:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, 3fbb724d-8b48-4508-b106-0d0a686d0e84, 'Je rajoute 1 œuf, 40g de farine et 40g de noix de coco :)', '2020-05-09T09:43:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, f20473a5-1b75-4b6c-93ed-9e248c7cc71e, 'Super mais j’ai suivis l’avis d internautes et ai ajouter un oeuf (ou du lait de soja) 50g de farine et de la levure. Également mis 8 carré de chocolat dedans et 1 au dessus :) sinon hyper bon !!!', '2020-05-03T20:20:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, de27227a-2052-4f64-abab-b24091ff760c, 'J''ai ajouté 1 oeuf 50g de farine et un peu de levure pour retrouver okus l''aspect moelleux du cookie. C''est mangeable, mais c''est un peu mastiquable... Bof la recette. Sinon c''est tres healthy !', '2020-04-21T11:23:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, d39597db-fcd0-49d5-ab0a-e544c8ccb59b, 'Pas mal. J''ai rajouté un peu de coco râpée ?', '2020-04-15T00:16:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, 9240600d-4111-49de-8ef3-97bea3d581ae, 'J''ai rajouté 1 oeuf à la banane et 50g de farine complète et 1 c à c de levure chimique. J''ai mis en tout 9 carrés de chocolat noir. Ça donne vraiment des cookies et les enfants ont tout mangé. Recette healthy et saine. Parfait !', '2020-01-13T16:17:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, a5853ef0-ef13-467a-b500-0e7fad61e07d, 'Très bon, facile et rapide à préparer. J''ai personnellement ajouté de la noix de coco râpée (150 g de flocons d''avoine et 50 g de noix de coco), et je ne fais cuire que 12 min à 180 degrés.', '2019-12-03T16:42:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, 49e08ea1-82ee-41d7-9097-a4cecdc07ea5, 'C''est vraiment pas terrible ! Désolé, mais c''est caoutchouteux et pas loin d''être immangeable, heureusement qu''il y a le goût du chocolat. Pourtant je suis fan des ces 3 ingrédients !', '2019-11-17T18:46:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, 59dcc772-ce1e-47cd-802a-88c8b8f73ef2, 'Excellent ! Merci pour cette recette très simple à réaliser, pour un dessert pas trop calorique. J''ai mis des raisins secs au lieu du chocolat. Un régal.', '2019-10-28T16:45:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, 4b7ee433-7505-431b-8391-78684ab4fe71, 'Super rapide, super bon et sain. Jai ajouté 30 g de noix de coco râpé. Parfait pour un petit-déjeuner consistant et pas trop sucré !', '2019-03-17T20:35:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, fe163b43-58f5-450e-a40a-6da2adacfcd0, 'Ayant un diabète gestationnel, j’étais heureuse de trouver une recette qui allie si peu d’ingrédients et qui ne me sont en plus pas interdit. J’ai juste mis à la place du chocolat noir 85%... c’est très bon, je la referai régulièrement. ', '2018-08-19T12:14:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, f1e4d041-fcc4-4bef-bb17-6c9c50957a3d, 'Absolument parfait !
Seulement 3 ingrédients, recette simplissime, résultat délicieux
à faire en doublant, voire en triplant les quantités !', '2018-05-02T11:24:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, c5972c6a-99dc-4545-af3e-468024c55ad0, 'Effectivement c’est plus sain. 12 minutes au four suffisent. Bonne idée quand il reste une banane un peut trop mûre.', '2018-03-02T12:22:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, f0b7d661-f726-484b-8528-ca016e6efa85, 'J''ai adoré !', '2018-02-27T07:13:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, b75f077d-ad1c-4ab6-8427-2726f04edaed, 'Mes enfants n''ont que moyennement aimé, je crois que je n''aurais pas dû annoncer des cookies mais des biscuits choco-banane ! Moi j aime bien, et en plus c''est très sain ... mais j''ai mis plus de chocolat !', '2016-11-09T18:37:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, fa9c6251-5942-474c-885a-bef925be97db, 'Pas mauvais mais ce n''est pas une recette de cookies du tout...', '2016-10-29T16:53:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336806, aadac5b9-d93d-469f-b93e-f03d367cd676, 'Cookies légers et très bons ! Comme je n''avais qu''une petite banane, j''ai adapté la recette et mis que 60g de flocons d''avoine. J''ai mis 50g de pépites de chocolat puisque je trouvais qu''il y avait trop peu de pépites. Attention pour la cuisson ! Pour ma part 12 minutes ont largement suffit.', '2015-06-21T15:10:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168769, bbf9974f-2031-4e8b-8587-f7388f5641ee, 'Je l''ai testée en version sans gluten (remplacer la farine de blé par de la farine de riz et garder la maïzena) et c''était très bon mais la prochaine fois je mettrai plus de caramel !', '2014-07-06T08:45:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168769, a353a6ad-eeab-4f3c-91f2-00e2ae621087, 'C''est une tuerie !!! merci :)', '2014-05-29T23:04:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 89ca9d7a-11d8-4490-9c61-496f4f55a714, 'Perso, j''ajoute de la cassonade pour le côté caramélisé avant de flamber au rhum.', '2022-04-16T09:25:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, fdb3346a-bd8c-4423-b0bf-e81a174c180d, 'Avec de la chantilly, un délice ! Attention quand même au moment de flamber les flammes peuvent monter assez haut ! ', '2020-12-31T15:20:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, ce0a8628-9da0-4663-8dcb-8831a8391817, 'Je valide la conception de la recette. Si on veut en faire un vrai beau dessert pour des invités, je recommande une boule de glace coco, un peu de chantilly et du chocolat fondu ! Je vous assure ça impressionne alors que c''est simple !', '2018-03-04T21:39:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 9fdddf68-2beb-4f43-abd8-d6ba1bf84f58, 'En déglaçant avec un petit jus d''orange fraichement pressée... hum un délice ! Attention tout de même à ne pas utiliser une poêle munie d''un revêtement spécifique. surtout pas de surchauffe dans ce cas...', '2012-11-23T10:45:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 966074c3-f55e-4f6a-a202-2d37487f3a0e, 'Franchement un délire j''ai juste ajouté une crêpe et du caramel beurre salé, une vraie tuerie', '2023-02-06T14:50:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 0348c0c3-0f15-4acf-b6db-e1ff7f8e1aa8, 'Plutôt que de jeter des bananes trop mûres voilà une recette simple et rapide !', '2020-11-07T13:34:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 27515a63-dfbf-43a7-aef7-8042ba42c20e, 'Dessert facile et très bon quand on ne sait pas quoi faire avec des bananes un peu mûres. Je n''ai pas fait flamber cependant car j''ai un détecteur de fumée trop sensible ! Excellent avec un peu de cannelle et de la noix de coco râpée :)', '2020-03-18T13:53:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, c08b6b97-31d3-40eb-8fd2-13c1d544eb32, 'Testé avec des bananes plantins, au moins 20min de cuisson et au final un goût assez neutre proche de la châtaigne. ', '2015-12-29T18:12:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 6e34fa91-8911-4fdc-880e-642195a2d74e, 'C''est très bon mais j''ai du forcer un peu sur le rhum et ma flamme faisait un mètre de haut... Heureusement, je n''avais pas mis la hotte en route.', '2012-04-28T15:55:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 50187aed-e09a-4972-9633-70b16d7ce7e5, 'Très bonne recette facile à faire. J''ai fait revenir les bananes avec le beurre et le sucre roux. Avec le rhum, cela parfume juste ce qu''il faut les bananes. Je vous recommande cette recette ultra facile', '2011-02-14T21:46:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 2f4c0618-7992-492d-910c-3044f5cc2f9f, 'Bonne recette pour manger les bananes trop molles.', '2022-09-12T20:39:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, ba61db96-94a5-4201-8d5d-b11b2d0723a6, 'Super bon !', '2018-12-09T10:01:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 4a216e28-06f2-4c2d-8b31-d0ac4e776d7e, 'Super délicieux, faire attention quand on flambe !! Dessert idéal pour bananes trop mûres et agréablement surprise car pas lourd pour une fin de repas c''est top !! A refaire.', '2016-07-11T22:12:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 7fa5102e-99f9-47dd-8e96-5db45e8a68c1, 'Super recette. Peut-être laisser un peu plus long temps sur le feux, après flamber pour ceux qui n''aiment pas forcement le goût de l''alcool, mon homme et moi avons adoré, en plus recette très rapide. Je teste avec des amis dans 15 jours.', '2012-11-25T11:44:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 34db28fd-a1eb-4c7b-9388-2e26de37a763, 'Recette réalisée avec du beurre salé et 1 cuillère à soupe de sucre non raffiné avec un peu de vanille bourbon à la place du sucre vanillé, et c''était juste excellent !', '2012-09-29T23:41:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 3299a24f-6ad9-42bb-9ef5-25e19fb76b0a, 'Un délice ', '2023-08-20T22:52:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, d7e2b0fc-f5bd-4adf-aabd-19f1f3aef2ff, 'Excellent ', '2023-06-22T21:31:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, ed740adc-afbc-493f-ac66-fc2ceac18d7f, 'Trop bon', '2023-02-20T13:11:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 0c887d44-717c-4b10-b07b-dfa45cc6342f, 'Délicieux! Avec un coulis de Nutella et une boule de glace coco, c''est parfait! Attention à la quantité de rhum pour flamber, il en faut très peu pour ne pas noyer les bananes ', '2023-02-18T21:15:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, d5d4b70f-49a1-431d-ab7c-55cda1707d2e, 'Rapide délicieux à refaire', '2022-05-25T09:23:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 732950b9-41bc-4cba-b839-9c483c540c3e, 'Excellent 
', '2021-04-10T16:24:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 9c4a287a-ea89-4146-bf24-fbed19bb1dfd, 'Excellent, rien à dire ?', '2021-02-14T19:30:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, fa4de156-a53b-43a5-bd80-da3a6e9d78e6, 'Super recette.... faites attention au moment de flamber. ?', '2020-02-23T02:54:59+01:00');
