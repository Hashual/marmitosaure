INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, b5e502ad-dbbe-4872-95b6-393616973232, 'Sauce réalisée sans le citron... Et parfaite. Tout le monde a adoré.', '2017-10-27T15:41:23+02:00');
