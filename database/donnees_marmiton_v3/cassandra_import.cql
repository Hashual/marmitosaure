INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 60a17c7b-63d1-4a64-89fb-add1078a23af, 'Recette excellente et rapide à faire. J''ai mis 1,5 kg de pommes de terre pour remplir mon plat à gratin correctement. ', '2016-06-11T22:07:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 788e28d6-f4f0-42b5-a291-85f95c14cd9a, 'Recette facile et simple à réaliser ! J''ai rajouté un peu d''ail que j''ai fait revenir avec les oignons, à refaire !', '2016-05-25T13:08:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, f5bbc564-f396-43d5-a8dc-fcc34d6c2567, 'Excellente recette avec plusieurs variations possibles. La moutarde donne effectivement une petite touche gustative. A refaire ', '2016-05-19T16:30:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, b9964414-1df1-4887-9281-7347ddc22d74, 'Très facile à faire.', '2016-05-11T22:37:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 8f85defc-fccf-48d7-b933-6dd3a9cde234, 'Très bonne idée de mettre de la moutarde, je n''y aurais pas pensé, ça donne un bon goût. En plus c''est rapide et facile à faire donc parfait pour moi. Je la met dans mon carnet de recettes ! Merci', '2016-02-17T13:44:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, eb3f21ba-a438-4bb6-a6c2-4aaf3eefefe5, 'Juste excellent en remplaçant le jambon moutarde par des petits lardons', '2016-02-17T12:57:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 2ad18849-c8b3-4b7e-8857-62f08c20ec15, 'Simple, pas cher et excellent..! Un vrai plat des familles !...Merci', '2016-02-15T09:58:29+01:00');
