INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 04ba1126-2033-47c3-bde7-5d2de6c2edd4, 'Pas vraiment fan... Je trouve que la pâte à du mal à cuire... Niveau goût je trouve ça un peu écoeurant. Je pense que pour cette recette il faut vraiment aimer la banane...', '2016-06-15T02:48:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 73ee426e-36ea-48dc-b53a-058e9b477b44, 'Bonne idée pour liquider ses vieilles bananes toute noires. Avec deux bananes au lieu d''une et moitié moins de lait, ça le fait !', '2016-04-18T03:17:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 301a3b6e-a837-46ab-afcf-20ae42fed8a3, 'Avec la recette originale on sent pas beaucoup la banane mais sinon c''était bon.', '2016-02-13T21:10:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36076, da979fac-3a15-45cd-b823-63c436c75d0b, 'Très bon mais ma confiture de lait ne s''est pas bien liquéfié...', '2017-01-27T16:57:38+01:00');
