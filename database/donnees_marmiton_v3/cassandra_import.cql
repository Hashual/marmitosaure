INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 2ddabbbf-417d-4729-917b-ca7a1d0fd969, 'Incroyable merci !!!', '2022-07-22T12:13:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 1d6f4475-3751-4a42-b5e6-12cb1a1b048a, 'Trop bon, merci beaucoup !', '2022-06-14T17:10:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, c551172c-6825-4d46-9879-fbd6eb7e994c, '👍', '2022-03-20T17:27:27+01:00');
