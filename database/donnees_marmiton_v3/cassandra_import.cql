INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212490, 62315510-4a42-48b4-a849-7e90fbc43b59, 'Meilleur sur une glace ou un sorbet fraise. On l''a fait en hiver avec des fraises surgelées et sans lait. Merci', '2013-11-17T13:03:50+01:00');
