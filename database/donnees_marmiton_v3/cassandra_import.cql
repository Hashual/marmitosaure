INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, be3af053-cc0e-4cc8-9ed6-31f994ea73c0, 'Très bon !', '2018-03-17T05:39:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, d0af1ed9-8c58-4997-88e2-1c8b414542f2, 'J''aime beaucoup!', '2017-04-19T17:47:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, c0cab9c3-48c5-4a1b-b089-3cef86949ede, 'J''ajoute juste une cuillère à café de miel et le smoothie est parfait.', '2017-03-05T10:55:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, bb7d4d48-38b6-4f38-93f7-b53083ca69f5, 'PARFAIT !!', '2016-05-22T15:02:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, 47c396e5-415a-4638-8a91-22e12a8f58f4, 'Très bon !', '2015-04-15T21:48:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, 2d5fa043-29be-41b6-8aff-72048d75033f, 'Très bon pour un tout premier smoothie fait maison.', '2015-04-13T18:23:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, 5ab3b0d5-6198-416d-8455-a29ba1bdce86, 'En rajoutant un peu de sucre je le trouve meilleur ! De plus, cela casse un peu l''acidité du kiwi.', '2014-06-11T14:32:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, af92c990-6447-4ca2-90ac-77fcb75bca5e, 'Délicieux ! J''ai remplacé les glaçons par de la glace à la vanille. Le résultat est vraiment bon !', '2014-03-30T17:02:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, d74fa065-e742-4050-bcbe-4c17f6bf813b, 'Ajouter un jus d''orange pressée...  un BKO, banane kiwi orange... ', '2014-03-26T13:42:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, 9a7401ac-6c99-4625-ad77-8f9925fdbce3, 'Le kiwi cache la banane c''est dommage. Bon quand même mais il faut retravailler cette recette pour trouver le bon équilibre et adoucir le kiwi selon moi.', '2013-12-28T17:51:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, 4c597c9a-421f-4219-aa92-2d54d43fcad2, 'Délicieux ! Je n''ai pas mis autant de glaçons, mais j''ai ajouté un peu d''eau. Un super petit-déjeûner ! ', '2013-03-12T11:31:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, bec53f9c-2505-48be-ae13-848754d03237, 'Excellent ! J''ai ajouté un pot-yaourt de fromage blanc et plus de glaçons. Un plein de vitamines !', '2013-02-14T19:28:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, d03cd650-bf37-4c86-a799-76d272172630, 'J''y ai rajouté du miel car il est difficile de trouver des kiwis suffisamment sucrés. Excellent et très vitaminé.', '2013-02-04T18:35:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, e54ff5ef-812a-416d-bb78-c9a617db987e, 'Super bon ', '2012-08-04T22:14:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, efb0fd07-6e7c-49b4-8b00-a6167a991323, 'Super bon! Effectivement il faut rajouter un verre d''eau sinon c''est trop épais.', '2012-05-17T21:57:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, c72db85a-affe-4ba8-82b2-afd29c21ee74, 'Très bon, rien à redire', '2012-02-28T15:54:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, 98f93904-4061-4ced-9ab3-2215d6b38384, 'Même avis que ci-dessous. Trop épais si on n''ajoute pas un peu de liquide. Perso, c''est du jus d''orange pressé que j''ai ajouté, très bon !', '2012-02-22T22:18:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, 11b84a8a-82af-4728-8402-1849d08a080c, 'Assez épais, je rajouterai un demi verre d''eau et peu agréable à boire car nous avons eu la gorge irritée, surement par les graines du kiwi mixées.', '2010-04-04T13:32:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73297, ac5ee12e-f6d8-42c4-9ae2-491a530bf64f, 'Super bon et frais!', '2018-06-13T01:21:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169643, 28060c13-d04e-448d-bf44-62903253e4a1, 'Plat testé et conseillé par une collègue camerounaise, recette très bonne, prévue pour un prochain plat familial !', '2022-11-11T13:40:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169643, bfc04593-5786-48b4-be69-37c6be3c1abc, 'Très bonne recette et facile à faire.
Mes invités ont adoré !', '2018-12-18T06:35:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169643, efdc56a0-2b5b-4113-ba08-1c751d016624, 'Vraiment très bon. Pour ma part j''ai augmenté tout les légumes qui ont donc servi d''accompagnement sans riz. Réchauffé le lendemain c''était encore meilleur. Recette adoptée...', '2011-09-27T08:18:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169643, 9e86653a-5cce-45fa-bb87-b41d7f0936a1, 'Je n''ai pas mis de banane ni de plantains et j''ai remplacé les haricots par des "mange tout", j''ai fait cuire 2 bonnes heures , c''était super bon, j''ai mis du curry et un mélange d''épice pour colombo', '2011-02-06T18:48:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169643, 0568f756-d889-4ffb-9e29-305fa82cb19a, 'Très bonne recette. Par fainéantise, j''ai fait revenir uniquement les oignons avec le poulet, et j''ai ajouté tous le reste des légumes à cru (+ 2 gousses d''ail) sur le poulet, le tout à mijoté 1H, poulet fermier oblige.   Petite erreur dans la 1ère ligne de la phase préparation, lire "carottes et poireaux" au lieu de "poivrons", ceux-ci étant déjà cités la ligne suivante.  ', '2010-09-20T13:57:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533394, 73df85de-9811-46e6-ba7e-cb38593cd993, 'Très bonne recette pour les personnes intolérantes au lactose et aux oeufs', '2023-02-21T20:10:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533394, 256ffb8f-b4b6-4e45-8416-2069c4c477f7, 'Très bon gateau et simple à faire ', '2024-02-11T12:12:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533394, b133641a-b213-4c9d-886c-c69bcc888350, 'Retour de vacances avec des bananes trop mûres et pas d''œuf dans le frigo : excellent ! Il a fait l''unanimité (j''ai utilisé du beurre)', '2023-08-29T21:27:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533394, e3830f18-1b37-467e-a849-743d4fe52762, 'Excellente recette . Gâteau fondant  fort en goût 
J’adore !', '2023-06-20T18:06:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533394, b5f1ecac-deff-45eb-962d-f4b300de9771, 'Super recette qui donne envie et c''est la seule que j''ai trouvé qui soit sans oeuf et sans lactose ', '2023-02-26T21:01:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67018, 6c494ad1-f9c0-406e-ba4f-9285672247ff, 'Je n''avais pas de banane ni de muesli alors j''ai remplacé par de l''orange et des cornflakes. Un peu de miel et de lait concentré sucré et tout le monde s''est régalé !', '2012-04-16T19:05:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67018, e5a40bf5-4b83-4dc3-a579-1a8ac51ccba0, 'J''ai mis de la fraise avec la banane? des amandes du lait d''amande et du muesli aux raisins secs et fruits un régal ', '2016-02-08T23:58:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67018, 800c6281-2ddf-44cd-9be2-3171c7156d02, 'Testé sans banane avec une pomme entière, un yaourt à l''abricot et du muesli aux fruit et c''est vraiment excellent ! parfait pour terminer le dimanche en amoureux !', '2015-10-25T19:23:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67018, 5eca9f68-2245-4046-92f4-77416cd8b629, 'Excellent et nourrissant. ', '2011-05-11T19:39:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67018, 5892e9b3-e324-49f3-9898-f812042a73a5, 'Délicieux avec quelques modifs cependant, je n''ai mis qu''une banane, du fromage blanc à la place du yaourt et ajouter du sucre vanillé, un pur régal.', '2008-09-27T00:47:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12012, e07d9418-a885-4a53-9292-6e8ba05c2c6a, 'J''ai remplacé la farine par 200g de farine sans gluten. Et je n''ai mis que 50g de cassonade au lieu de mettre du sucre.
Résultat vraiment excellent !! Un gâteau hyper moelleux (on croirait une sorte de texture mousseline). N''hésitez plus pour cette recette : testez-là.', '2019-03-17T04:18:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12012, 9728ad79-1531-48b3-883c-359570a271f4, 'Excellent! J''ai mis de l''huile d''olives, remplacé le sucre blanc par 200 g de cassonade et 3 oeufs ont suffit. ', '2016-04-13T21:55:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12012, c0ec19e0-a5d8-4096-9608-a38147590d47, 'j''ai adoré! c''était léger, moelleux, j''imagine bien une variante avec des pépites de chocolat ou bien avec un autre fruit', '2010-03-04T15:09:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12012, 81173af6-1190-4f1d-ada6-9e79ba41a116, 'Un peu trop consistant...très bon avec du Nutella tartiné sur le dessus!', '2006-06-26T07:25:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12012, 26fd199e-6686-4769-b9f0-0f88d704982a, 'Très déçue, car les commentaires me semblaient satisfaisant, j''ai trouvé ça bourratif! (j''ai mis 4 petites bananes, je ne sais pas si cela vient de ça). Peut-être qu''il a trop cuit. Je réessayerais quand même :(', '2006-03-22T19:07:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12012, a63e2db5-03cf-4a30-aac1-bd05ed260e79, 'Facile à faire et moelleux à souhait. Un vrai délice pour les petits et les grands! Moi j''ai divisé les quantités par deux et j''ai ajouté une goutte de fleur d''oranger ou de rhum pour parfumer le gâteau. Comme je n''avais pas assez de banane, j''ai fait le mélange avec des cubes de pomme. Excellent !!! Merci pour cette recette.', '2005-06-15T13:28:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12012, eee34009-fa05-4a53-b2b0-9132ee35c51a, 'Super moelleux!!! Pas trop sucré, pas écoeurant, je vous le conseille!', '2005-06-04T17:08:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12012, c50d7692-a69e-4aeb-b110-b992509cbe87, 'C''était très bon! J''ai rajouté un peu de cannelle, et de l''avis de mon chéri un peu de rhum aurait bien fait l''affaire! Merci!', '2005-04-10T22:08:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12012, 5b849910-1164-45d3-ad5a-2cbdb2ec6ad1, 'Personnellement, j'' ai trouvé cette recette très bonne avec juste ce qu''il fallait de fruits. Et je ne suis pas seule à avoir apprécié...', '2003-01-19T21:12:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12012, d973a4ea-847f-46e6-acf7-8dce36e75e91, 'Hmmm , l''idée du citron c''est très bon !', '2001-04-26T18:06:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12012, 8d79c6da-45ce-4dc3-990e-b53dfe0c9b3f, 'Trop étouffant, bon avec du rhum ou de la fleur d''oranger pour l''assouplir.', '2001-03-17T22:07:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58049, acdafdc2-5d80-4c67-9821-057ec219fac7, 'Hum... Je dois dire que je ne m''attendais pas du tout à cela. J''étais très enthousiaste à l''idée d''un gâteau mélangeant les chocolats, la mangue et la banane. La mousse de fruit a été trop liquide, faire fondre des feuilles de gélatine au bain-marie ? C''est vraiment cette mousse-là qui nous a dérangé... Nous n''avons pas réussi à finir notre part de gâteau. Peut-être un nouvel essai un jour avec des fruits peut-être moins mûrs mais pas pour tout de suite !', '2011-06-18T15:21:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58049, 2b2e7b69-7a76-4e4b-b3ad-4f7e7f6a3145, 'Très bon, léger et beau ! Super', '2010-08-02T14:07:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58049, 6442cd02-e4d2-43f7-a84d-9543b8f21744, 'Super bon !! Même les non-adeptes du chocolat ont aimé. Par contre, un peu long à préparer, mais a l''avantage de se faire la veille. Je garde la recette !!', '2009-07-24T21:34:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58049, 4a641d49-b7e7-44f5-9837-d8ff74b0a035, 'C''est un excellent gâteau qui n''est pas lourd du tout ni trop sucré mais la recette est plutôt pour 10 personnes. Pour gagner du temps j''ai fait ma génoise à l''avance et je l''ai congelée le lundi puis sortie à dégeler le vendredi matin pour réaliser le gâteau le soir et le manger le samedi.', '2009-02-11T22:20:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58049, b740f6df-2443-48fb-ab33-7e54c56ee4c5, 'Vraiment très très bon. Peu sucré, contrairement à ce que j''aurais pensé. Je n''ai pas utilisé de Fix crème et je ne l''ai pas présenté en gâteau mais en verrinne, ce qui est très joli. En s''y prenant à l''avance, ce dessert n''est pas fastidieux à faire. Tout le monde a trouvé cela très bon.', '2007-12-31T12:04:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58049, 5a244dac-80f4-4666-8603-aa00118db1b2, 'Genial! C''est long à faire et je pensais qu''il serait trop sucre et bien ce fut un regal!! tout le monde a adoré! genial!!', '2007-08-17T14:52:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65810, 09352bbd-d37e-4e3c-bce0-45654f5dcfe8, 'Très bon mais donne aussi très soif. J''essayerais avec moins de sucre.', '2012-01-16T20:12:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 7c84410f-a80a-4738-a975-080fd61449e2, 'Super ! J''ai l''habitude de faire une recette qui a toujours du succès mais j''ai voulu changer.
J''ai fait des muffins et des madeleines avec cette recette, en diminuant le sucre, utilisant des pépites de chocolat et 100g de lait à la place de la crème. Seul bémol: je mettrai bien moins de beurre la prochaine fois car c''est gras et peut-être même très peu de sucre. 
Mais je referai avec plaisir.', '2020-02-23T09:27:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 4c7ac93d-e6f7-4135-bd5d-2a38b34ca60e, 'Très bon !!
Je ne mets pas de sucre ( celui de la banane et du chocolat suffit) et réduis la cuisson à 30 minutes.
Un régal 😃', '2022-04-11T11:16:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 9abd13c0-0cca-4490-89dc-422f90cf637f, 'Les muffins sont moelleux à souhaits, perso j’ai mis que 90gr de sucre et 100gr de beurre et c’était parfait en goût et texture  À recommander', '2020-11-16T00:34:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 51833d42-50d2-4237-a349-7bf150c75c94, 'Merci pour cette recette facile et vite faite. Comme certaines, j''ai diminué le beurre et le sucre, et fait des muffins très moelleux, par contre 20 à 25 mn de cuisson suffisent largement.', '2019-06-23T17:18:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, a16c6519-c1d4-4896-bb7f-8d20c0cc9892, 'Superbe recette pour passer des bananes trop mûres. Personnellement j''ai fais des muffins et on les a dégusté encore chaud et c''etais parfait car le chocolat étais fondant. ', '2018-08-29T03:56:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 7b67a231-e128-43e9-9094-23ed5b10f4a5, 'J''ai respecté les quantités indiquées et la texture ressemble plus à un flan qu''à un cake. Il a pourtant cuit 1h au lieu de 50 min. Le goût est bon mais ce n''est pas un cake. Je ne referai pas avec cette recette. ', '2016-09-14T09:46:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, d6e93571-eded-4e0d-90c1-fa6ed8a6f222, 'Cake trop plat, trop petit et trop "fondant" à mon goût.', '2022-06-05T14:15:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, b6ab696b-a5de-484f-9722-404e6c6f46bd, 'Très bonne recette et super simple', '2020-06-10T03:22:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 7f07936a-465a-4978-96e1-405a0b6b8498, 'Je dois la faire au moins une fois par mois, on se régale à chaque fois, j''utilise tous mes petits moules (financiers, cannelés, muffins), chacun son préféré ! Du coup je réduis un peu le temps de cuisson vu que ce sont de petits moules', '2020-05-03T15:13:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 67d6dfa0-dbda-45e3-aea6-82824a817523, 'Je n''ai pas tout compris dans la recette donc cela doit être ma faute si le gâteau était mauvais. J''ai mélangé le chocolat et la banane, le résultat n''est pas celui que j''avais attendu. Je l''ai fait goûter à 4 personnes, ils on tous la même réponse : "bof, pas très bon mais c''est mangeable".', '2019-04-27T07:23:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, e8c482ac-005c-4957-96f7-b755222791a6, 'Très belle recette !! J''ai ajouté un peu de lait au lieu de la crème et de la farine n''ayant pas de fécule : EXCELLENT.', '2019-03-18T09:45:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, d32b4d6c-23df-4546-b85c-542440c0c240, 'Très très bon, pourtant je ne suis pas très fan des gâteaux à la banane mais là top. Parfait pour ne pas jeter les bananes trop mures. Je n''avais pas de fécule j''ai donc mis 140g de farine et seulement 50g de cassonade. ', '2018-10-01T10:46:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, f4131200-0cd8-4d01-bcba-62900097bf47, 'Très bon et super recette pour cuisiner des bananes trop mûres.
J''ai juste remplacé le fécule par de la farine et la crème par 100 mL de lait.', '2018-07-28T10:39:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 98a06cc5-a2cd-42de-9230-7ea207622c46, 'Un régal !
Je l''ai déjà fait plusieurs fois, je mets seulement deux bananes et 80 g de sucre, je fais cuire dans des petits moules plutôt qu''en un seul gros cake, ça se conserve très bien... mais cette qualité est inutile car chez moi ça se mange très vite !', '2018-05-28T11:51:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 06bb6c65-62da-477e-a7ac-3654c687789c, 'Très moelleux ', '2023-06-03T22:21:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, ffd18aba-810d-4395-b232-abf47433888b, 'Délicieux, je n ai pas mis de bananes, j ai remplacé fécule de pomme de terre par 100g de maïzena et que 50 g de farines et moins de sucre le tout pour 30mn a 180 degrés , à refaire sans souci ', '2023-03-05T12:25:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 782c3277-dadb-4e15-ab67-e979430bd32a, 'J''ai remplacé la fécule de pomme de terre par du son d''avoine et fait plusieurs petits cakes plutôt qu''un gros en réduisant le temps de cuisson, tout le monde a adoré à la maison 😃😃', '2023-02-26T23:48:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 55d335fd-f536-43bf-a3ee-ec8f5bc4139a, 'Le cake était très bon. Cependant, il y a deux bémols : il était très gras, je conseille de ne pas faire fondre autant de beurre. Et la texture n’était pas celle d’un cake mais plutôt d’un flan. 
Sinon c’était super bon quand même :) ', '2022-07-03T12:08:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 3962066f-3319-4c53-99c8-88b0f0d42cf2, 'Super recette', '2022-05-02T19:42:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 45dbf473-8d1c-4191-bde4-01865bf9c392, 'Incroyablement bon merci...😄
', '2022-01-14T15:01:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, b66cd6dc-5eb4-473a-9094-9c8845a251a3, 'J''adore cette recette mon fils la prend  pour tous ses anniversaires !', '2021-11-27T20:18:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, ab23abc4-5be4-4afc-80f3-5d6c7f640292, 'Très  très  bon merci pour cette  recette ', '2021-11-17T11:54:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 5f1da809-e224-4cc6-b311-3e3c0e7eff26, 'Très bon mais les quantités peuvent être réduites.', '2021-09-03T22:37:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 3963c237-9016-4424-9bf6-8140cca4b1cf, 'Délicieux et très facile, on peut enlever 25 gr de sucre sans problème !', '2020-11-15T18:59:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 050caae6-5b74-4311-a957-56c31f40a990, 'Très bon et simple à faire. Merci', '2020-10-30T14:38:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 3634cf55-6226-4710-b1a9-e6ab54dfb228, 'Super les enfants adorent', '2020-10-21T20:24:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 4395e93c-1671-4570-8a5f-cdb89b891aa8, 'Un classique qui a toujours du succès !
La variante cerise (avec pointe de liqueur d''amande ) est également excellente .', '2020-10-04T17:39:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 077738d8-56cf-4cc6-bb1e-d1df2265aeee, 'Très bonne recette !', '2020-05-08T00:35:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 3b989121-ee71-42b1-ae8b-52a63faa2d30, 'Trop trop bon!!!!!', '2019-11-20T02:59:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, ed7ebc1a-345d-4a40-9ff5-968e2d9ac010, 'Super bon gâteau !! Mis seulement deux bananes trop mûres. Pour le reste recette suivi à la lettre. Les enfants ont adoré et moi aussi d''ailleurs ? je recommande !!!', '2019-04-13T21:11:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 74cf1ba1-870c-439b-92ef-63fbb3b7e902, 'Excellent ! Merci.', '2019-01-12T04:25:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 4e34a5c8-2126-4018-8901-2fdb70ae4840, 'Extrêmement moelleux !', '2018-10-07T17:22:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 70d7e69f-2011-4bf3-a020-02d3dd8f7af9, 'Merci pour la recette. 
Je l''ai quelque peu adaptée. 
50 g de sucre roux
3 cuillères à soupe de crème de riz au lieu de la crème fraiche. 
Enfin j''ai ajouté des noix de Pécan. 
Je n''avais pas de fécule de pomme de terre et j''ai utilisé de la levure boulangère.
Même réaménagé, c''était très bon!', '2018-03-02T09:44:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, fb3d94f8-f758-4654-b2e6-1e2dbc19109b, 'Très bonne recette. Les enfants se sont régalés!', '2017-04-16T12:16:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, a389e858-3c35-41a2-a8b2-56d6d30118e6, 'Le cake est vraiment moelleux et le reste plusieurs jours. Le gâteau est beau, gonfle bien, un vrai plaisir. Je viens de m''apercevoir que j''ai confondu fécule de pommes de terre avec celle de maïs ! Bon ça fonctionne aussi !  ', '2017-02-19T15:12:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 134b17fe-b0db-4507-8a28-9f0f9f56bd61, 'Très bon, bonne idée quand on a des bananes un peu mûres...', '2017-02-12T18:33:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, b93affcb-6d4a-4306-9052-3c9c21f8c8ea, 'Super bon on s''est tous régalé à la maison. J''ai juste changé quelques ingrédients que je n''avais pas : Remplacé la fécule de pomme de terre par la maïzena et n''ayant pas de levure j''ai mis du bicarbonate de sodium ( 1 cuillère à café pour 500 g de farine). Et c''est parfait. Merci soph_2', '2016-11-27T11:59:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, f8610e1c-b8a7-4910-b140-867f5a35f9c3, 'Trop cuit, je ne comprends pas trop la recette...  En photo il y a des muffins et dans la recette dans un moule à cake...', '2016-08-18T19:39:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 0352fae1-7141-43d8-b0d6-3273e9ad01d4, 'C''est une très bonne recette, j''ai bien aimé, merci beaucoup.', '2016-08-06T10:10:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, faf50865-60e9-45ec-987b-44bf1de6b38c, 'J''ai également réduit le sucre et le beurre et c''est super bon. Recette idéale quand on a des bananes qui commencent à noircir.', '2016-06-09T13:25:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 1a2b59f6-2e3c-4c1f-b7cd-efa5bd8c1088, 'UNE TUERIE !  J''ai suivi un peu les conseils. J''ai mis 70g de sucre et 70g de beurre plutôt. J''ai mis un yaourt grecque à la place de la crème fraîche et des pépites de chocolat au lait. Un sacré délice. A refaire !!!!!!!! ', '2016-03-10T08:54:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 3f3e72a1-55ff-47f3-b93d-bf5fe72e3bae, 'Plus facile à cuire dans des moules à muffins. J''ai remplacé la crème fraîche par un yaourt. ', '2016-03-03T19:20:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 028d44bd-ddb1-4076-9f24-f6e025bd795e, 'Délicieux !! Une tuerie quand ils viennent de sortir du four.', '2016-02-29T03:23:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 7ac066b3-af34-4b77-a5ea-3df5b5a36efc, 'Très bonne recette utile pour profiter des bananes trop mures. Merci beaucoup Je n''ai pas utilisé de crème fraîche mais ai rajouté un peu de lait.', '2016-02-14T18:42:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 68f505d8-ead6-4dc4-b755-24e6c4b95378, 'Délicieux !! Ils sont vraiment légers, en revanche j''ai moi aussi remplacé la fécule par une cuillère à soupe de maïzena.', '2016-01-20T21:51:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, d30b6195-401d-4bdd-b761-94af5eb776e9, 'Délicieux ! Je l''ai fait dans un moule à cake, sans fécule de pomme de terre mais avec 2 très grosses cuillères à soupe de Maïzena, 4 bananes moyennes, des pépites de chocolat. Cuisson 1h20.', '2016-01-19T15:24:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 764d71bd-439d-4126-9828-4387941b8910, '"Une tuerie" dixit mon mari qui en effet est très gourmand. J''ai mis moins de sucre et j''ai remplacé la crème fraîche par du yaourt. Idéal pour utiliser les bananes trop mûres. ', '2016-01-14T15:59:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 060d4148-f7ae-42e0-a794-4e6dd83c00e5, 'Un délice !', '2016-01-05T22:13:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 43405e9a-c07a-433a-99ec-9f6127a72c16, 'Super recette ! Perso j''ai remplacé la fécule par de la maïzena et la crème fraîche par un yaourt à la grecque nature et j''ai coupé les bananes en rondelles seulement, revenues avec du sucre vanillé. Laissé 30 minutes au four ou un peu plus (j''ai géré à l''œil et à la pointe de couteau). Excellente recette, à refaire ! ', '2015-12-06T08:32:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, a189cc89-1e3d-43bd-9ded-6d4106154a89, 'Bof bof.. j''ai trouvé ce cake assez lourd et plutôt écoeurant avec cette bouillie de bananes. Je ne referai pas cette recette.', '2015-11-14T12:35:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, ab2cb03a-4f2b-41e7-bbd5-ae2872a69324, 'J''ai fait ce cake hier et il a été dévoré en moins de 30 min !!! Je n''ai même pas eu le temps de le goûter !! En tout cas, mes copines de formation l''ont adoré !!  Je vais être obligé de le refaire pour savoir si leur gourmandise était justifiée !! J''ai ajouté comme certains 1 bouchon et demi de rhum. Et pour le reste je m''en suis tenue à la recette initiale.', '2015-11-13T16:53:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, f65b9289-ed46-414e-87b9-306c33a06cc7, 'Très bon =) Seul problème et non des moindres, au bout de 40 minutes mes muffins commençaient à cramer =( J''ai eu chaud, enfin, surtout eux ;)', '2015-10-21T23:15:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 5badda0c-22df-4898-bc8e-242a867e4988, 'Excellent ! Je l''ai faite en ajoutant les conseils rhum + carreaux de chocolat ! Un régal ! Merci !', '2015-10-18T21:58:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, e75d7cd3-aa79-4ad1-a81c-4ed6b361a3f2, 'Parfait !! J''ai remplacé la crème par du mascarpone et ajout" du chocolat en poudre non sucré dans la pâte et c''est parfait', '2015-10-10T20:51:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 3f00804b-a66e-4b52-a40a-3fa5e4e7340a, 'Attention, très très bons ! J''ai moi aussi utilisé de la maïzena à la place de la fécule, et en muffins, 20 min au four. ', '2015-10-02T20:23:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 8edd0fba-fe7a-40f9-b8b8-956ac0c0d977, 'Super bon  J''ai fait fondre à la poêle les bananes (2 grandes )dans du rhum et sucre de canne  à la vanille Puis dans la pâte j''ai rajouté un peu de bière en plus de la levure (1/2 sachet) Et des morceaux de chocolat au riz soufflé Bref une tuerie gustative!! alcoolisée.. Merci de la recette', '2015-06-14T22:57:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, fac67772-7cde-41f4-b207-5ae6c0d97453, 'Nickel j''ai juste mis 1 cuillère de rhum et remplacé le sucre vanillé par de l''extrait de vanille liquide et j''ai inséré  de gros morceaux de chocolat après 15 min de cuisson.  Le temps de cuisson convient tout a fait. Toute la famille a apprécié et en a même repris ! ', '2015-06-08T01:38:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, b88f82fe-a63d-465b-8c16-33c7ba4d491b, 'Excellent tout est parti en 1 journée! Je les ai fais en Muffin pour des portions individuelles, c''est top!', '2015-05-28T15:51:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, c50023f3-fc03-400f-b843-91b12273942c, 'J''ai pas aimé', '2015-05-01T20:51:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24844, 9b73ea55-8852-4dff-b36e-924e3f2aee05, 'Excellente recette!!!! vraiment très très bon, hyper moelleux. Par contre j ai réduis la quantité de sucre. Merci pour cette excellente recette.', '2015-04-17T04:00:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 6e230632-4b57-4b59-8c73-098edffb94db, 'Excellent, validé par toute la famille ! Fait avec 1 banane et du chocolat noir.', '2020-02-11T09:49:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, cc6e44ed-74e1-401f-a836-a298e004be95, 'Facile à preparer, rapide, et en plus super bon ! Mais pas besoin de mettre à 220 degrés, après 20 minutes ils commencaient à être cramés sur le dessus.', '2018-05-13T03:08:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, fdb6056d-7a40-4d4b-8556-419e359e3c6c, 'Très bon mais doubler le lait ou doubler avec de la crème liquide et cuire à 180 degrès pendant 20 minutes.', '2014-08-07T23:09:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, c8bfd1f8-20aa-4f9e-ade6-85baf6a128b1, 'Très bon, léger', '2014-04-14T07:30:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 886f5edc-8c0c-45aa-b30e-7b03d84a17fa, 'J''ai respecté les quantités des ingrédients sauf en ce qui concerne le chocolat que j''ai réduit à quelques pépites au fond et au dessus de la préparation versée dans chaque empreinte de plaques à muffins. La quantité de 100 ml de lait était suffisante. C''est un dessert économique et pas trop riche en matière grasse et cholestérol qui permet de se débarrasser d''une banane qu''on ne veut pas manger !', '2014-02-25T21:46:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, bc98613c-607a-49b7-9ccd-1bf5a1b55fcb, 'Très bon mais en effet doublez la quantité de lait.', '2014-01-21T16:28:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 308f96ef-3455-4cf3-844d-c93d1ba01f5d, 'Délicieux, ultra simple et rapide. J''ai doublé la quantité de beurre et ajouter plus de lait ainsi que de pépites de chocolat ! Attention aux grumeaux. J''essaierai avec 20 cl de crème liquide la prochaine fois sans ajouter de beurre ni de sucre.', '2013-12-08T13:37:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, e9cf75d6-6a25-41d9-9af5-06c98417f011, 'Très bons muffins ! J''ai doublé la quantité de lait, comme indiqué dans certains commentaires, et ajouté une banane écrasée dans la préparation.', '2012-08-18T17:07:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 79a5ded4-0708-4e2f-af72-989874cad1d0, 'Merci pour la recette (avec un peu plus de lait). ', '2012-06-20T23:53:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, ffefd6eb-45d7-428a-9cbd-17dbcfa748d9, 'Merci pour cette recette, facile, rapide, j''ai doublé la quantité de lait comme le préconisaient les autres internautes au 1er essai, puis au 2e essai j''ai également doublé le beurre...et là je dis Excellent, à faire et refaire.... Merci', '2011-06-16T16:35:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 9e350e37-b96b-47a0-9e64-972d24f97284, '1ère fois que je fais des muffins sucrés. Merci pour cette recette, nous nous sommes régalés. J''ai doublé la quantité de lait comme noté dans les autres commentaires.', '2010-11-28T20:21:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, f572db2e-7e0f-472b-a19c-2e657b96068e, 'Un peu secs les muffins mais je n''ai pas respecté l''ordre d''incorporation des ingrédients, cela vient peut être de là.', '2010-11-28T14:25:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 4d8a0d89-395b-4535-a16e-9eb19cecc9a1, 'Excellent, à faire également avec un cœur caramel beurre salé avec banane !', '2010-11-16T21:06:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, b051bb47-f91f-48ff-8434-e7e5fa54c58d, 'Bonne recette de muffins. J''ai suivi les conseils et doublé la quantité de lait. C''était très bon !', '2010-11-14T18:54:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 4bbd7cec-7221-44a4-aad2-0534fc39dc6a, 'Très bonne recette de base, mais c''est vrai, il faut plus de lait.', '2010-11-12T21:19:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, d692ad4b-691a-4397-862f-4a932d455800, 'Recette essayée et réessayée toujours avec autant de succès auprès de mon goûteur officiel: mon fils!à faire sans tarder. J''ai juste ajouté un peu de lait pour que les muffins soient moins secs. Recette déclinable à l''infini avec de la poudre de noisettes, d''amandes....', '2010-09-12T18:13:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 7704d06e-2cf0-4e8b-85f7-84ebeed73dfb, 'Les muffins étaient vraiment délicieux mais j''avais doublé la quantité de lait pour que la pâte soit plus fluide et du coup les muffins n''étaient pas secs.', '2010-06-14T17:23:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 6229ce0f-b017-40d7-a2c8-93f1ebecbcf2, 'Ils étaient bon, mais tout le monde a trouvé qu''ils étaient un peu sec, je pense que ça vient de la pâte. Je les referai mais en changeant la recette de la pâte. Merci !', '2010-06-02T19:29:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, a54a1968-89d8-4573-8a89-a9683f0421cd, 'Réalisés sans banane ni chocolat et avec 75g de sucre : ils étaient délicieux !', '2010-05-25T08:17:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 368664ef-e472-436b-9e75-c69dfead3b4c, 'J''adore ! Moi aussi, c''était la 1e fois que je faisais des muffins ! Avec des pépites de chocolat, c''est super bon ! A refaire !', '2010-05-06T15:30:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, f464ed34-10fd-42e5-8499-fdfcc804bde0, 'Un vrai délice ! Pour mes premiers muffins, je ne suis pas déçue :) C''est la recette idéale : simple, rapide et gourmande ! PS : 100g de sucre c''est très bien, et j''ai rajouté une cuillère a soupe de rhum.', '2010-04-09T23:31:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 1103e1c3-5d80-4d49-8ea1-5160c304e43a, 'Super, perso j''ai mis un carré de chocolat au milieu !', '2010-03-28T20:00:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, a7b043c3-d547-4a3e-80e5-f6307b4fe8b1, 'Très facile et bon. J''ai pris la base mais j''ai écouté les suggestions en ne mettant que 75 g de sucre.', '2010-02-28T09:11:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 7fa87bc8-078e-432e-b2f0-64b41821f11e, 'La recette est parfaite, par contre mes muffins sont un peu carbonisés ! 15min à 220° et chaleur tournante suffisent. En tout cas, merci pour cette recette simple et délicieuse !', '2010-02-26T23:34:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 88619b8b-6649-4f29-91dd-01d870a372e3, 'C''est muffin sont excellent! Cette recette est simple et rapide à faire. Et effectivement on peut l''adapter moi j''ai rajouté de la vanille.', '2010-02-24T22:14:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, b353980f-f8c5-4907-8993-f48a2521182a, 'Simplissime et délicieux! J''ai refait la recette plusieurs fois en variant : fruits, chocolat, fruits et chocolat, etc. ', '2009-09-30T19:58:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, f8e57e73-3ddd-42d9-8383-c7e7dcf202e5, 'Réalisés et dégustés à l''instant avec mon fils de 5 ans, un vrai délice. Je n''ai mis que 60 g de sucre, c''est suffisant, 50 g de pépites de chocolat et 1 banane. A refaire sans hésiter en doublant les quantités. Merci beaucoup', '2009-08-26T18:12:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 937c7a3d-5c98-4c34-9246-b277557ba1ce, 'Super !! A faire et à refaire.... Les enfants ont adoré.', '2009-06-02T16:07:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, c4f97f05-eafd-46dd-959f-2fd9943ca70a, 'Il faut, en effet, mettre 75 g de sucre, car 100  c''est un peu trop sucré à mon gout. Je préfère découper le chocolat en petits morceaux pour que la pâte lève mieux. Recette faite aussi avec une poire et du chocolat au lait... Délicieux ! ', '2009-05-29T18:29:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 8fda5393-fd05-489e-84ea-49ab557df4e8, 'Très bonne recette, je n''ai mis que 75 gr de sucre. Avec mon moule pour "gros" muffins, les quantités données permettent d''en faire 6 (je n''avais pas mis la banane). Les muffins étaient cuits en 20 minutes avec mon four électrique à chaleur tournante à 200°C.', '2009-04-05T21:24:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, c64aad3a-2eaf-4faa-b466-6efde1d3a26b, 'Très bon et facile à faire! La prochaine fois un peu moins de sucre et par contre ayant un four à chaleur tournante 18 minutes suffisent largement. Merci pour cette recette.', '2009-03-14T19:38:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 16b798f9-7ba1-46f8-9410-bd0c414218d9, 'DELICIEUX! A faire et à refaire. Depuis que je les ai testés (il y a 1 mois), ma fille de 3 ans et moi en faisons 1 fois par semaine.', '2008-07-28T03:01:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 171a7e9b-f530-4dff-b9b2-de109bd85a30, 'Fait avec des pépites de chocolat et une cuillère à soupe de cacao sucré. Délicieux et rapide à faire.', '2007-12-21T17:27:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58218, 930b410b-425c-4dab-8dad-e9c1b67c4a6b, 'Excellent !', '2007-07-04T09:39:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20153, 83a4a6aa-8012-4021-9494-2137e7e1696b, 'Délicieux ', '2023-01-21T16:51:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20153, f28f61d5-934b-4023-a25c-2c7b7ef104a3, 'Une recette vraiment délicieuse et facile à faire !', '2020-04-11T16:23:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20153, ac8a839a-6bf9-4070-9fdd-cc0a552f4069, 'Déjà fait et très bon. Je n''ajoute pas de sucre. Mais du sirop à la place.', '2015-02-07T12:43:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20153, e074816d-40fd-42eb-8383-e2c8281dd0dd, 'C''est très bon. J''adore ce petit goût qu il y a derrière juste pour dire c''est excellent. ', '2013-11-15T22:50:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20153, 17828655-1acf-483d-8828-212d7196e147, 'Très bon, a refaire !!', '2013-02-01T11:51:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20153, 162a9c75-1ed4-4e2a-b073-20e13b03a840, 'Pas mal si on ne garde que la partie verte du kiwi, sinon la texture est râpeuse et désagréable en bouche.', '2008-06-17T12:27:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20153, 23e976e6-b5c4-4df0-b7ff-11a59bc4e53f, 'Simple et bon, mais sans mandarine en ce qui me concerne.', '2006-10-16T15:30:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20153, c2088ab3-0cbe-4bb7-a05d-cd46f5afe8dd, 'C''était très bon mais 15 glaçon c''est un peu trop.', '2006-08-08T19:45:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20153, 9d16c5bc-85ae-4fbf-8730-29e6a6a865c7, 'C''est trop bon! Un bon conseil tous à votre frigo et c''est parti le mixeur...', '2003-02-26T16:31:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32393, 6ac3306e-db09-459a-bebe-78be8b72710d, 'Très bon', '2024-02-16T13:00:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32393, f5c678f2-12bb-4f0b-883f-bfb1f0cf1c80, 'Très doux', '2023-09-21T14:25:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32393, ba9d3c29-6e8e-41f4-8c0f-d8de6e16e5eb, 'Parfait ', '2020-06-25T00:40:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32393, 0c7c881a-3dc5-4c66-922c-8b1a22382f76, 'C''est bon mais moi j''ai rajouté un peu d''eau et un peu de sucre mais après c''est une question de goût !', '2015-01-24T22:31:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32393, 508025ff-e235-4eee-b2ed-c9a9970f9500, 'Très bon, j''ai juste rajouté un peu d''eau, car c''était un peu épais à mon goût.', '2014-02-09T16:58:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32393, fecce4ba-bc30-418b-bfdc-8383f77e7cef, 'Très bon, j''ai juste ajouté un peu d''eau mais pas de sucre.', '2011-12-11T23:11:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32393, 2cbad63d-b1f0-4050-a779-908fa72b0c1a, 'Délicieux, je n''ai rajouté ni sucre ni eau. Merci', '2008-04-29T09:22:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32393, 6dbff40e-8853-4503-96f0-65331104c7b8, 'Très bon. Inutile de rajouter du sucre!', '2008-01-03T22:03:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32393, a3c1ed26-89c7-4dbf-b34b-2150aa401836, 'Tout simplement excellent !', '2006-03-26T13:49:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29142, bd8b184d-973a-4c59-bd15-aee5c8a78689, 'Je le fais avec 4 carreaux de chocolat noir que je sépare bien pour répartir dans tout le croque, c''est délicieux, et sans beurrer c''est pas la peine dans les appareils à croque monsieur actuels anti-adhérents et le chocolat est déjà assez gras comme ça.', '2014-01-21T22:34:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29142, 408267e5-f453-454d-aa63-e10bb4786b68, 'J''ai retrouvé ce délicieux goûter que je mangeais petite .... Mon fils de 5 ans et mon mari ont adoré et m''en redemandent !!!', '2010-10-10T14:28:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29142, 9fb22e69-350a-46df-871e-1680f98f7dcf, 'C''est simple et ça déchire !!! Mais je n''ai pas pu attendre que ça refroidisse... ça coule mais c''est bon !!!!!!!!', '2007-01-26T18:52:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29142, 2241c688-06a8-4d26-b418-d3a33113a25f, 'Miam!! Et en remplaçant le pain de mie par de la brioche tranchée (en surveillant bien la cuisson), ce goûter devient une pure merveille pour les petits et les grands!', '2006-08-09T21:13:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29142, 1ba61fcc-e446-4746-90b0-67dde2cbe274, 'Idéal! Fallait l''inventer... Quoi de plus facile et rapide pour assouvir une envie de chocolat ? Bravo pour ce délice pur et simple, merci beaucoup.', '2006-01-09T13:03:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29142, 25665a29-2b97-4fac-b2d9-04929211b4e9, 'Je fais souvent ce dessert pour le goûter de mes enfants. C''est un délice!', '2004-05-07T21:17:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32193, c64c2d02-5bde-4c10-8c7c-d0027c27c530, 'J''ai fait la recette 2 fois en 1 semaine et chaque fois ce dessert a eu beaucoup de succès...j''ai remplacé une des deux boules de vanille par une boule de glace à l''ananas!.  ', '2007-08-02T19:29:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312358, df6f9093-11f5-4f49-8409-299794fa7835, 'Excellente et très facile', '2021-10-10T11:54:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35523, a72211e8-5d1f-4c82-ad79-ce2bd150539a, 'C''est un peu lourd et le goût des fruits n''est pas mis en valeur selon moi.', '2005-06-13T14:32:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43251, b0ff0002-041f-4e6c-97dc-bf79a8931154, 'A la lecture des commentaires précédents j''ai opté pour une cuisson à 180 degrés pendant 35 minutes. Parfait et très bon !', '2014-11-11T16:13:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43251, 54edef42-7cdc-49c5-a2ab-5a7d0c947b1e, 'Très bon gâteau et facile à faire (je l''ai fait au robot) Le miel lui donne un petit gout subtil et va très bien avec les bananes. Par contre, c''est un peu lourd, et à la sortie du four, il s''est aplati... j''essaierai en y incorporant des blancs en neige la prochaine fois.', '2011-01-26T16:43:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43251, 397adac6-69f3-413d-abdd-82313815ee66, '2 points particulièrement positifs : - très simple à faire, j''ai pu l''intégrer dans ma préparation d''un dîner de tous les jours sans que ça me prenne beaucoup plus de temps ou que je me perde dans mes plats - vraiment très moelleux et doré à souhait!', '2009-06-30T15:38:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43251, d13e0cf2-5105-4670-89e5-341296df42a1, 'Gare à la cuisson! Le thermostat était bien trop élevé, et le dessus du gâteau a brûlé au bout de 15 minutes de cuisson... alors que l''intérieur n''avait pas encore cuit. Je l''ai refait cuire 15 minutes à 180°, et l''intérieur était bon, mais j''ai du enlever le dessus pour qu''il soit mangeable!', '2008-05-27T18:25:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43251, 036519bb-0494-4795-93f8-e5eec4ccb8b3, 'Cette recette est délicieuse (même sans noix), rapide et efficace. Bravo!', '2008-05-06T12:21:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43251, 83bda5ab-156c-4cce-a123-33267f3a146f, 'Très bon, les enfants ont adoré... et ont pu le préparer tout seul (un qui mixe pendant que l''autre met les ingrédients). Je n''avais que 3 oeufs, je n''ai mis alors que 150 g de farine et 120 g de beurre (cela suffit et est plus diététique!) mais attention à la cuisson, cela brûle rapidement!!! Après la 3ème tentative, une brûlée, une un peu cuite la dernière était parfaite!!! A surveiller donc...', '2007-02-20T21:27:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83516, d59bdc63-160d-4472-827f-8c15398a07a8, 'J''ai l''honneur de donner la première note pour un dessert ultra facile mais ultra délicieux. Petite modification personnelle, je n''avais pas de curacao alors j''ai mis du Grand Marnier. Accompagnés d''une glace à la vanille et d''une glace caramel au beurre salé, aini que d''une tuile aux amandes maison. Mes invités étaient subjugués. Merci pour cette recette que je referai très bientôt et très longtemps!', '2011-02-27T11:13:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61038, 5d63fbe6-1338-40bb-93a3-588036a5ae78, 'Pour les amateurs de sucré-salé! Excellent!', '2009-04-14T16:19:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61038, 68244737-b12e-4ce8-b8c9-484a7b7bf578, 'Délicieuse recette!! Réalisée à la cocotte avec un poulet entier. J''ai ajouté du lait de coco pour allonger et adoucir la sauce, un régal !', '2009-03-11T20:59:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61038, 4ad50dac-f6a0-4a4e-99ae-42553265e9ed, 'Recette vraiment remarquable, mais la prochaine fois je ferais rôtir les bananes à part.Merci pour cette excellente recette.', '2008-03-25T00:44:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31478, 43ad03af-e54c-4131-8b81-da42091d14c2, 'Recette délicieuse! Avec des bananes classiques et plus de lait de coco (1 boîte entière).', '2006-10-10T14:11:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31478, 4847177e-50a1-458a-9ccf-2969172a8feb, 'Déception.... Plat trop sec, le thon était très bon, mais les bananes plantains beaucoup trop sèches. Revoir le dosage de lait de coco ??', '2006-05-28T03:51:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31478, f15e14fb-c8ec-4d11-81de-8838cdaaab54, 'Moi, j''ai ajouté le lait de coco (un petit peu plus que prévu) directement avec le thon. Sinon, j''ai suivi scrupuleusement la recette, et c''était un régal! On a quasiment liquidé le plat à 3!', '2005-11-28T11:46:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31478, e2552478-28a0-4b70-9600-aa056655bc77, 'Pas mal, mais sans plus pour ma part. C''est original, rapide et facile à faire.', '2005-11-21T22:19:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31478, 167f7ed9-564c-4beb-996c-349e2c154ff0, 'Pour accentuer le coté exotique du plat, j''ai rajouté le jus et le zeste d''un citron vert, ainsi qu''un morçeau de sucre de palme. Dépaysement et saveurs garantis!', '2005-11-19T17:00:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31478, cc6362c8-294a-4331-8f6a-cc7638787e85, 'Nous avons absolument adoré cette recette même si j''ai rencontré quelques difficultés de cuisson: il m''a fallu doubler la quantité de lait de coco pour permettre aux bananes de mijoter un peu. J''ai saisi les dés de thon dans une poêle à part pour être sûre d''obtenir du thon mi-cuit (encore rouge à l''intérieur). J''ai rallongé le temps de cuisson des bananes dans la sauce. Avec tous ces aménagements, ce fut une merveilleuse surprise gustative.', '2005-11-17T22:03:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31478, e25de17a-74bd-4b81-9fdc-7fc03c43116b, 'Très bon. Je l''ai préparé avec du requin, car il n''y avait plus de thon. C''est tout aussi bon. ', '2005-09-20T19:14:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31478, adbbbd77-57b9-4706-bdf8-ae0291410e7b, 'Très bon. Mariage sucré-salé réussi. Pour donner plus de piquant au plat, on peut faire revenir le piment vert en même temps que les oignons. Suivant un des commentaires, je l''ai fait avec banane normale pas très mûre. Pas très apprécié.', '2005-08-24T23:25:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31478, cbb5a51a-1beb-4244-ad49-9f3057a0645a, 'Je l''ai faite sans bananes et j''ai remplacé le piment vert par du piment oiseaux séché et c''était délicieux, mes parents ont adoré.', '2005-07-24T23:53:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31478, 19d50c8f-d9de-4ba1-9172-7ff61f80aa13, 'Délicieux! Fait avec des bananes ordinaires pas mûres du tout, elles avaient un petit goût de patates douces, un régal...', '2005-03-14T21:20:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31478, 40b8b31b-7acc-4923-b266-382ffd2f257d, 'Surprenante recette! Mon mari, cuisinier, a beaucoup aimé. J''ai simplement rajouté un poivron rouge pelé et épépiné pour la couleur. Merci!', '2004-11-16T15:05:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31478, 83f0307e-0cad-421b-bc26-1ef482ae2b1f, 'Facile et excellent.', '2004-11-07T17:51:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31478, 40212b67-5c52-41fa-8040-a280225b989f, 'Nous étions 10 à dejeuner ce dimanche et les 10 sans exception ont A.D.O.R.E!!!! Goût exquis et assez raffiné! Par contre, n''ayant pas des plantains, j''ai utilisé des bananes normales... Très bon quand mâme! A conseiller.', '2004-10-25T08:56:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31478, 7787aa25-ed30-4cce-86e5-b505e0ea431d, 'Miam.', '2004-10-01T20:59:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65640, 9935cc83-ac85-4729-abd6-f4dc96c4f67a, 'J''ai enfin testé cette recette qui me rappelle de bons souvenirs de mon séjour à Tahiti ! !! Excellent ! ', '2016-03-15T22:17:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65640, 752cb897-5767-4840-8c64-2c12ec789f4d, '300 ml de coco au lieu de 200 ml et 25 minutes de cuisson. Je verse le restant de lait de coco sur le gâteau une fois cuit pour plus de moelleux !', '2022-04-24T21:41:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65640, 2fcf89f9-9faa-4d67-bb57-f276254b579d, 'Dès que nous avons des bananes un peu trop mûres, je fais un poé.... On se régale chaque fois ... Merci Marmiton pour toutes les recettes que vous nous proposez....', '2021-09-28T13:43:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65640, aca7e04e-e5b7-4389-b391-ccef70906032, 'Moi je ne rajoute pas de sucre, le côté caoutchouc c''est peut être mal dosé la farine. Non ça ne marche pas avec la farine de blé.', '2016-04-03T17:17:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65640, afd53202-2ef5-46ae-8d83-58d304c55fe2, 'Je ne connais pas la recette originale, mais il est vrai que la fécule de manioc apporte un côté caoutchouteux que j''ai moyennement aimé. Je me demande ce que ça donnerai en adaptant la recette à la française avec de la farine normale.', '2013-10-24T21:13:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65640, b31d9aa2-cc91-4b32-8e26-1ace38af127f, 'Vous pouvez tout simplement cuire les bananes dans une poêle avec un peu d''eau et les écraser à la fourchette avant de mélanger à la farine de manioc. Chez nous, on "déchire" le poé après la cuisson pour le rendre moins compact. ', '2013-05-14T15:10:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65640, 58b9587c-01a2-4955-ad7d-1ef5f0672a35, 'Plat traditionnel tahitien. Excellent ! :)', '2013-01-12T21:18:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65640, 7285fb36-0c18-4e14-a669-cd9a4bd94fb9, 'Très bon et très facile.', '2012-06-08T18:55:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65640, ff8061ed-994b-4459-892f-bca1dc5415eb, 'Verdict unanime : la recette est à tomber par terre ! Très facile, rapide et exquis ! Encore meilleur le lendemain, trempé dans le lait de coco toute la nuit ! Miam ! Ça change des traditionnels fondants au chocolat et autres gâteaux au yaourt.', '2008-04-16T20:03:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37999, fbc7fb1d-aeed-4d3e-93ba-622f31e1fbc2, 'Excellente recette ! Facile à faire et à réussir. Appréciée par petits et grands (même par les personnes qui n''aiment pas les confitures de fraises).', '2011-06-21T13:13:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37999, fcd98335-42c2-4a3a-9c10-8b71ce546d3e, 'Moi aussi je l''ai trouvé excellente! J''ai ajouté du rhum.', '2011-04-04T18:15:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37999, 731fcb31-da95-4b8b-bd81-10d2b393d3b1, 'Super. Très bonne recette, pour pancake aussi!!!', '2005-09-25T13:08:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45469, f1c292ac-fe9a-43c5-84a3-8c6cf68852be, 'Du gingembre en poudre (très peu) à la place du gingembre frais et pas de menthe (je n''en avais pas). Dessert très rafraîchissant.', '2011-11-25T22:01:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42864, 7496c166-aae2-4993-80b9-26ff46201325, 'Très bonne je recommande. ', '2018-04-21T03:47:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42864, a52cf26b-5c5c-475e-8cfa-aa98303705f6, 'Délicieux. Je l''ai préparée dans mon blinder chauffant comme une soupe. Extra facile. ', '2016-01-10T11:03:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42864, 7ea6eb8e-f926-42e5-82ce-bcd44dab7c27, 'Extra avec 1 oignon et du lait de coco.', '2009-02-27T19:15:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42864, 5339fbf5-84fc-42e3-9597-7a14fe72ebea, 'Dé-li-cieux ! J''ai remplacé la crème par du lait de coco pour adoucir et bien passé le tout au blender. Sauce onctueuse, léger goût de banane curry et accompagne très bien tofu, seitan, tempeh et légumes.', '2008-05-04T14:34:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (359666, 29262e24-d2f6-4a1c-9998-eb3933b8abb9, 'Très bonne recette.', '2018-08-10T14:45:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57080, 7cab852d-c865-47e9-a85d-f9390645c3fd, 'Un grand succès. Tout est parti très vite. Tous ont adoré le mélange sucré-salé. A faire et refaire sans hésitation', '2011-10-02T00:35:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57080, 396a4b4e-e65c-4b6f-a21c-bdc0d813852b, 'Délicieux ! Merci', '2010-04-17T18:28:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57080, 37017970-bb07-459f-8251-825e47abadf7, 'C''est ultra facile à faire pour l''apéro, et ça "déchire grave".... A essayer impérativement. (personnellement je coupe les tronçons dans le sens de la longueur et je coupe les tranches de poitrine en 2, ça en fait + pour tous les gourmands)', '2007-07-24T17:57:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 3e0eb5b5-ae18-498f-b80c-55631ff29e00, 'J’ai suivie la recette pas à pas, seulement que j’ai mit du beurre doux au lieu de mettre du beurre salé. Avec un filet de Nutella avant la cuisson sur le dessus, c’était sublime. Bravo ❤️', '2020-06-14T18:39:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, be68e713-23d8-4263-a401-8a6a315eb39a, 'Très bon ! J''ai ajouté un peu de cannelle et du rhum dans la pâte. Nous l''avons dégusté avec une mousse au chocolat. C''était délicieux ! Merci pour cette recette.', '2014-04-13T19:52:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 4df1b64f-6e75-40ba-bea2-432fd82c5e04, 'J''ai trouvé ce gâteau bon au goût mais l''aspect donne moyennement envie. Le dessus de mon gâteau était tout lisse et la tranche paraissait pâteuse mais mon fils a adoré.', '2014-02-06T21:00:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 17752627-80e0-4328-9e35-951b330aa173, 'Bon mais un peu trop sucré à mon goût, les bananes sont sucrées aussi. J''ai modifié un peu la recette : moitié farine complète, moitié farine de maïs, 25 g de beurre, 2 œufs dont j''ai battu les blancs en neige et 100 g de cassonade. Résultat, un gâteau léger et moelleux à souhait !', '2011-09-03T17:19:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, b8dfae83-ce33-43c4-9f7d-845be890e161, 'Excellent, je n''ai rien changé à la recette et c''est vraiment très bon. La prochaine fois, j''ajouterai un peu plus de cannelle et une banane supplémentaire. Petite astuce pour les goûters, mettre la pâte dans des moules à muffins et cuire 15 minutes.', '2008-10-14T17:31:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 6c4da3c2-0c67-4a62-915f-7da9955f8f95, 'Génial et avec comme glaçage sucre glace et noix de coco.', '2022-12-31T11:26:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 391f291e-f458-480d-85d4-9ab177ff1c4b, 'Bon gâteau qui a été apprécié j’ai finaliser ma préparation par un glaçage 3 chocolats pour améliorer l’apparence.
Un aspect un peu compacte mais bon en bouche j’ai mis 4 bananes et sans beurre (pour éviter que ce soit trop gras) j’ai aussi mis 50g de sucre en moins car les bananes sont déjà sucrées :)', '2022-02-14T12:00:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 6abccaaa-b0bc-4352-ae0a-58d9102469f0, 'Très bonne idée pour ne pas gaspillé les 🍌 ', '2021-12-30T22:49:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 584c29f4-1dbe-4652-8d0a-e336842fccb3, 'Délicieux ! J’ai utilisé trois bananes bien mûres de bonne taille, farine blanche et farine de blé à part égales et peu de cannelle. Si suivi une des idées notées dans les commentaires et fais des muffins plutôt qu’un gâteau.  ', '2020-06-07T10:44:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 43ecb8e3-c783-4e52-a3bc-11ea3ffbe28b, 'Excellent !', '2017-06-24T15:47:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 3d82d6dd-ab91-42bf-817d-168598d83d83, 'Ressemble plus à du pudding... très compact mais bon...', '2015-05-22T16:35:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, e32d8505-681a-44da-9ddb-c4bdbcae29ea, 'Pas aussi moelleux que je m''y attendais mais très bon au goût', '2015-04-07T02:19:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, e407270c-cb28-42f1-a47c-ae1e9c6faa55, 'Moelleux, sucré juste ce qu''il faut... Bref excellent !', '2014-10-17T23:45:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 382c77fc-e9d1-4122-ae99-217a703c3410, 'Excellent! Je n''ai pas mis de cannelle (question de goût...) mais le résultat est nickel! Facile à faire, inratable! ', '2014-06-04T14:57:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 467ff94b-e010-4bea-89bb-992c55ccbe97, 'Bon gâteau, moelleux effectivement. Il a assez bien levé dans mon moule à manqué. La prochaine fois je mettrai un peu moins de sucre.', '2013-12-11T11:50:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 874681d7-c8fa-4cfd-87f4-c632c3243d96, 'Je ne sais pas si c''était dû aux bananes que j''ai utilisé mais j''ai trouvé le gâteau pas assez sucré, j''ai donc rattrapé le truc en faisant un glaçage de chocolat sur le dessus. Attention ne pas mettre le gâteau au frigo car il durcit très fortement et devient immangeable. C''est une recette que je ne referai pas en tant que telle mais l''idée et la base me parait une bonne idée à creuser. En l''état le gâteau n''est pas assez sucré, trop gras, la consistance n''est pas top non plus.', '2013-11-26T07:47:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, d47affda-b094-4730-a11f-1aebc7c59c6b, 'Il est excellent. J''ai juste mis 100 g de sucre et environ 100 g de beurre. Quelques pépites de chocolat et une cuillère à soupe de marsala. Je n''avais que de la farine normale. ', '2013-11-09T18:23:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, ac68f225-04ec-4eaf-afdd-66bbff9e76a8, 'Simple et vraiment excellent ! A décliner avec toutes sortes de fruits (pommes, poires...)', '2013-09-18T10:18:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 59d4127a-e984-4729-a4e3-9dd0607b4e55, 'J''aime beaucoup ce gateau qui permet d''utiliser les bananes qui traînent. Goûteux, moelleux, délicieux...', '2013-03-03T20:13:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, fdd2201c-70e1-4a62-9bdf-a9bc4fa73b2a, 'Simple et délicieux !', '2012-10-15T09:04:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 726ce69c-a8e6-4ad0-99f5-c71774df65b9, 'Un vrai délice ! gâteau pas trop sucré, léger et goûteux ! J''ai mis du beurre doux à la place du demi-sel. Mes invités n''en ont pas laissé une miette ! A faire et à refaire !', '2012-09-09T23:25:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, e8b3b58b-9359-48ab-878b-dc5ee5a98145, 'J''ai adoré déguster cette recette. J''ai mis du beurre doux. Mais ce gâteau est lourd ! En tout cas cette recette et facile à faire. ', '2012-08-22T10:59:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 5f0b16a0-3095-4cfa-8ce7-2955b206d518, 'Les collègues de mon mari ont adoré', '2012-07-30T21:53:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 6403afdc-995f-4a43-a49f-8a1324dac418, 'Parfait ! Gâteau bien moelleux. J''ai mis du beurre doux a la place du beurre salé et ajouté quelques pépites de chocolat ! Je referai sans hésiter cette recette !', '2012-03-01T17:56:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 78931a94-3b41-44a9-a628-0df72c54df66, 'Je ne suis pas une grande cuisinière et il ne restait pas une miette à la fin du repas ! Un peu gras, mais c''est ça qui est bon !', '2012-02-21T17:52:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 47e31e31-a497-422c-8267-9e4fe9bff515, 'Bon gâteau mais je vous conseille de mettre du beurre doux au lieu du beurre demi-sel. J''ai trouvé le gâteau beaucoup trop salé. Avec de la crème 30% c''est également bien meilleur et si vous n''avez pas de farine complète la farine blanche passe très bien.', '2012-02-18T18:16:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 939eeb1b-6f08-4085-8e52-e7d17c8b4bd9, 'Un chef d''oeuvre ! Parfait pour les visites surprises  ! Rapide et excellent !', '2012-01-30T00:55:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 20105586-daa8-4567-a670-20d053994ba7, 'Excellent gâteau, j''ai utilisé de la farine blanche et le résultat est très bon également. Il a bien levé et a très bel aspect dans un moule rectangulaire. Il est très bien dosé niveau sucre.', '2011-05-30T15:52:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, d789b8ad-a82f-4999-a994-70d4dcc52be3, 'J''ai utilisé de la farine blanche, ajouté une cuillère à soupe de rhum et réparti le tout dans des moules à muffins. Résultat : Moelleux, gouteux et délicieux !', '2011-02-26T20:11:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 37ada525-536e-4a85-a2c0-20a6834953c1, 'J''ai trouvé cette recette bonne, mais je trouve que ce gâteau ne lève pas assez. Il est au final trop "lourd". Je pense que la pâte est trop liquide et empêche la montée. La prochaine fois, j''essayerai sans la crème. En revanche, l''idée de poêler les bananes avant de les mélanger à la pâte est excellente.', '2011-02-15T20:21:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 76249137-c2d0-4573-b94b-2f3c867a2aba, 'Vraiment très bon. Je n''avais pas de farine complète alors j''ai mis de la farine normale et pas de bananes alors j''ai mis des pommes que j''ai caramélisé comme dans la recette. Résultat parfait. Moelleux et très bon. A refaire sans hésitation. Merci.', '2011-01-12T19:57:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 6f48b4d0-206d-443e-8f10-c93fa98211f2, 'Quel flop, quelle déception...c''est vrai que je n''avais pas de farine complète mais, aucun succès chez moi, personne n''en veut...Consistance très curieuse qui ressemble à un pudding sans en être un. Décidemment, ça ne nous a pas plu!', '2010-10-31T14:14:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 781784f6-1bff-4c85-a823-51a691521037, 'Délicieux. J''avais vraiment peur vu les quantités de cannelle, mais j''avais tord. Un vrai régal et une douceur insoupçonnée. A faire et à refaire.', '2010-09-15T23:45:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 055e7bbb-e716-4fe0-9262-2f24859da697, 'Excellentissime !!! Rajouter une banane ou 2, un peu de rhum et de la vanille liquide, et c''est parfait ! Merci pour cette bonne recette !', '2010-06-14T12:56:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, c572b9a8-8310-48d1-953f-c7ed11467042, 'Excellent ! Tout le monde me demande la recette ! J''ai effectué quelques changements : farine normale, beurre doux, 1 seule cuillerée de cannelle et 4 bananes au départ, à cause des "moyens du bord", mais comme il plaît à tous, j''ai gardé ces modifications. Je ne compte plus le nombre de fois où j''ai fait ce gâteau !', '2009-10-28T12:25:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 74ac2b0d-2178-48be-be6a-bb592777b2d5, 'J''ai trouvé très bon le gâteau mais j''ai monté mes blancs en neige pour qu''il soit plus onctueux et j''ai mis un peu plus de bananes. ', '2009-02-14T21:11:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 9086dad0-9825-49d0-a4b8-02b31d574d75, 'Bonne recette. Mon gâteau n''est pas moelleux du tout. La prochaine fois, je pense que je ferai une sorte de compote de banane que je mettrai dedans.', '2009-02-08T16:53:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 57f6fdb4-33fd-443b-895e-6807ab88acd3, 'Je n''avais pas de farine complète,alors j''ai pris de la farine normale, et j''ai ajouté des raisins secs,c''était hyper bon , mes enfants ont adoré, j''ai mis la pâte dans des moules à muffins pendant 15 min, un régal!', '2009-01-09T14:16:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 56ca21c3-4857-49e6-ba15-1e4a066d3e24, 'Manque un peu de goût de banane et un peu étouffe chrétien.', '2009-01-05T16:14:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, a14174bb-f2c1-457e-920e-042167de3903, 'Excellentissime! A chaque fois, on est épaté par le mélange de goûts ! Ca va devenir LE gâteau du goûter, c''est sûr, et dans 15 ans, il faudra que je donne la recette secrète à ma fille (c''est déjà elle qui fait le gateau...). Un grand merci !', '2008-11-05T10:08:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, a7c6c039-35cb-43fa-a180-02d37135c8f2, 'Un regal! Mes enfants et mon mari ont adoré. Que je mette 3 bananes ou 5 bananes, c''est toujours un régal! C''est vrai, j''ai ajouté 1 sachet de levure et crème liquide à 18%. C''est une recette adoptée par la famille. Merci.', '2008-09-25T16:17:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, ed899702-7763-4da0-a551-9c90ecc9960d, 'Tout est parfait! Le beurre salé est un vrai plus. Je n''avais pas de cassonade alors j''ai utilisé du sucre roux.', '2008-08-13T11:10:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 9bd6964f-4029-4a42-984c-dfc871ae9706, 'Excellent! En effet, le gâteau ne lève pas beaucoup malgré un sachet de levure chimique. Mais ça n''enlève rien au goût. J''ai rajouté une banane, c''était meilleur ... Mon mari et ma mère ont adoré, du coup je suis obligée de recommencer ;-). Merci pour cette excellente recette.', '2008-05-22T16:20:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, bd93079b-5740-44cb-a87f-a6d665e98aa3, 'Mon chéri a adoré ! J''ai trouvé ça moelleux, ce qui est rare pour un gâteau à la banane. A refaire !', '2008-05-19T23:51:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, cb331b9f-e90e-45a8-ac1a-f53812434a39, 'Excellent très moelleux, pas du tout sec juste rajouter plus de banane j''ai également mis un peu moins de sucre. J''ai utilisé de la farine de blé et c''est tout à fait parfait :)', '2008-04-05T22:15:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 8d400ea5-515d-4a95-8db5-555013f0ebaa, 'Alors c''est sûr, c''est super bon !!! Mais le truc c''est que j''ai bien suivi la recette, à quelque chose près, et mon gâteau n''a pas gonflé, ou pas vraiment, il fait un peu pâteux, je ne sais pas si c''est normal ou alors ça vient peut être de mon four... sans cela j''aurais mis 5 sans hésiter, car c''est vraiment très bon ! Par contre j''ai réduit un peu le sucre, j''en ai mis environ 110 g. Comme d''autres, je trouve que 3 bananes ne suffisent pas j''en mettrai plus la prochaine fois. J''ai aussi réduit la cannelle à 1 cuillère à café au total car je n''aime pas quand on la sent trop, en revanche je trouve qu''il faut quand même un peu, ça relève le goût des bananes ! J''ai aussi réduit un petit peu le beurre de 20/30 g. Voilà, en tout cas je referai cette recette, en espérant que cette fois le gâteau monte !', '2008-02-26T10:53:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, febd9dd9-2282-452a-bb92-91fe82c0bfc6, 'Bonne recette, j''ai aussi mis du lait à la place de la crème. Bien moelleux. A essayer avec du chocolat!!', '2007-12-27T12:34:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 94cd83c7-d37e-4386-a90e-9f38face1a71, 'Tout simplement délicieux !!! A noter que j''ai fait quelques modifications dans la recette : je n''ai pas mis de cannelle, remplacé la crème par du lait et j''ai ajouté des pépites de chocolat.  J''ai obtenu un gâteau moelleux où tous les ingrédients se marient très bien.  Par contre, la prochaine fois, je mettrai plus de bananes. ', '2007-11-07T16:40:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, a897163f-224e-407b-87ad-9076d9ad5104, 'Un peu surprise par le goût de la farine complète, à mon sens trop présent, ce qui m''a un peu gâché le plaisir.  Par ailleurs, très bonne texture, dosages parfaits entre les ingrédients! je la referai sans problème... Mais avec de la farine classique !', '2007-09-15T19:44:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, bf402264-3b02-4f48-885b-a894ccc16277, 'Très bon ! à refaire !!!', '2007-07-09T20:20:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 0eef3e28-9c59-4b21-be7d-94cc8ae5e3df, 'Très très bon! J''ai suivi la recette à la lettre et j''ai été surprise par le goût et la texture. Ce n''est pas étouffant et on en reprend plutôt 2 fois qu''une! La prochaine fois je rajouterai des pépites de chocolat.', '2007-03-15T23:20:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 728f6dce-a290-4aaa-bf22-5d47fd60dc1a, 'Excellent. A défaut de farine complète, j''ai mis 150 g de farine normale et 50 g de farine de blé noir. 4 bananes bien mures ont fait parfaitement l''affaire, j''ai garni le dessus du gâteau des plus belles rondelles avant de l''enfourner. 1 cuillère à café de cannelle m''a semblé suffisante. J''essaierai en le parfumant au rhum la prochaine fois. Cuisson parfaite. Un gateau fort apprécié au petit-déjeuner ou pour le gouter des enfants qui craqueraient complètement si j''y mettais aussi des pépites de chocolat. Merci.      ', '2007-02-27T00:25:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 9743b15a-e99f-4954-9df0-e398cef43811, 'Très léger, très bon... Une merveille!! On sent bien la cannelle et ce n''est pas écoeurant. Moi j''ai préféré écraser les bananes et les mélanger au beurre fondu pour mieux les incorporer. A la place de la crème, j''ai mi du lait.', '2007-02-01T22:30:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 9e224310-5a43-48ef-83eb-d7796cc9148e, 'Très bon, on sent fort la cannelle donc il faut aimer! Je l''ai trouvé assez consistant, c''est parfait après un repas léger ou un goûter.', '2007-01-26T10:20:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 4a9f3427-3813-45ea-90fe-c0c4d2ea1d52, 'Recette parfaite, gâteau très moelleux. A tenter avec d''autres fruits.', '2006-11-17T18:29:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 7706f823-473d-44e3-bb6c-7e8638bb6504, 'Un régal! J''ai suivi les conseils des marmitonautes en utilisant 4 bananes, de la crème fraîche épaisse et en ajoutant du rhum et des pépites de chocolat. Mais nous n''avons pas senti le goût du beurre salé...', '2006-10-22T20:39:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, b2f546f2-2f8a-45e2-b2a2-48949935208c, 'Absolument délicieux.. En utilisant des bananes bien mûres, on peut éviter le sucre (je l''ai remplacé par un peu de sirop d''érable), je pense que c''est encore meilleur! ', '2006-10-15T01:26:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, a5654273-8d5a-425c-aa53-004ef29d55b1, 'Super bon gâteau. Très, très moelleux, et idéal au petit déj''. Il se conserve bien 2-3 jours couvert.', '2006-10-13T15:05:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, aafabebd-b56c-4b2b-8ad3-41b75223f04d, 'Moelleux à souhait, il mérite bien son nom ce gâteau! Et il est parfait à l''heure du thé ou du brunch. Très bon même en remplaçant la crème par du lait! Petit plus, j''ai déglacé au rhum ambré la poêle où j''avais fait dorer les rondelles de bananes. On doit pouvoir ajouter sans problème une ou deux bananes en plus...', '2006-06-25T18:49:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25956, 97ade603-0427-4116-8205-0d5e9a327e9c, 'Enfin un gâteau aux bananes pas sec du tout! J''ai mis de la margarine, 4 bananes, et c''était super bon!', '2006-03-13T16:11:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72818, f6194514-5053-4d3f-950a-683b4e7a28ac, 'Ce smoothie a fait l''unanimité à la maison. J''ai mis un peu plus de cassis pour mieux sentir le goût. Attention, il faut le servir tout de suite car il s''oxyde très vite et peut prendre une teinte marron pas appétissante, alors qu''il est d''un violet ravissant au sortir du blender :)', '2013-07-24T18:18:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72818, 970113ba-3759-453d-bf25-bca286553e94, 'Délicieux ! Fait avec du lait de noisettes bio, miam.', '2014-07-05T14:48:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72818, ab834791-8aa5-4389-931d-c4ecfcf84d9d, 'Très bon, merci !', '2013-05-21T20:47:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72818, 3307e266-fd65-4944-ad74-6f588d63bddb, 'Très bon, mais j''ai passé le smoothie une fois mixé car les petits grains du cassis sont assez pénibles', '2012-07-12T15:15:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72818, 153c56bd-419c-46cb-aea9-3f0500d9ad26, 'J''adore! Je double la dose de lait de soja, pour avoir un plus grand verre !', '2008-07-03T13:50:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167994, 1b6aff44-2c73-4bbf-801e-589a3e9dec2b, 'Parfums magnifiques ! Franc succès ! Merci.', '2019-11-29T12:40:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167994, 0be27114-29b8-4529-9ed4-c519a547873c, 'Excellent.', '2019-10-19T09:23:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18655, d82f823e-5ac7-457c-bff4-03aa1ccd08d7, 'Les blancs de poulets sont moëlleux, c''est un plat savoureux, à condition de bien relever avec la coriandre et, pour les amateurs, une bonne dose de piment, pour compenser la fadeur de la viande et la douceur sucrée de l''ananas. C''est de réalisation facile et très économique.', '2007-02-15T10:06:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18655, bf36d938-fcd4-4720-b3b1-c768eb540b7b, 'Trop sec, écoeurant...', '2002-12-14T13:08:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68821, 00bdc95e-fb58-4389-84c5-34838fb1839b, 'Pour faire plaisir sans trop se casser la tête. Pâtisserie facile qui fait de l''effet. En plus, c''est très bon. La fleur d''oranger fait très bien... Et comme il n''y a pas d''enfants à la maison, je me suis permis d''ajouter une lichette de Rhum. ', '2008-04-22T08:53:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68821, 491d6c51-a979-4286-8c32-afa71c532844, 'Bon gâteau mais a mon goût, il y a trop de fleur d''oranger. La prochaine fois, je n''en mettrai qu''1 cuillère à soupe. J''ai dû aussi augmenter le temps de cuisson d''au moins 15 min (avec chaleur tournante). ', '2014-04-27T00:41:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68821, c5b48cc2-d2bc-45d1-875b-bf55a423fc13, 'Une très bonne surprise que ce fondant ! Cependant, j''ai dû augmenter le temps de cuisson d''environ 20 min (je précise toutefois que j''utilise un mini-four) et je me suis permis de n''utiliser que 10 cl d''huile à la place des 15 inscrits dans la recette. Au final, un gâteau avec à peu près la même consistance qu''un far breton et une saveur fort appréciable. Attention toutefois pour les amateurs de cuisine légère : ce gâteau est assez lourd !', '2010-08-14T18:34:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32640, ce581d1b-7a00-4d73-b313-db92064237c8, 'Génial, trop bon et très simple. ', '2016-11-11T20:28:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32640, bdf0b929-6fac-4087-a00c-3e1794013e1b, 'Encore !!!! C''est clair que ce n''est pas super léger mais quel régal !', '2009-08-26T16:14:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69532, ade2e2d6-8035-44ea-be92-9bbbfe9cd821, 'Je n''ai pas trouvé de grand intérêt à cette recette. Il s''agit juste une crème choco-bananes, entourée de biscuits. Tout cela manque de légèreté dans la texture, une mousse aurait été la bienvenue. Cela manque de subtilité dans le gout j''ai mis 3 bananes et on ne les sentait pas beaucoup, le gout étant noyé dans le chocolat. Décevant.', '2011-06-12T17:47:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69532, 5f51b35c-b301-476e-ade9-1ace9af3d7e3, 'Attention quantité pour 12 bonnes parts et environ 36 biscuits suffisent. Sinon c''est une excellente recette qui a eu du succès chez moi ! Merci.', '2011-05-26T00:12:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69532, 32bc1740-2ace-4a83-a9e6-ed19259200cf, 'Un dessert fondant et savoureux ! A refaire...', '2009-12-30T14:39:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36370, 2387e365-8b2e-45d5-bbc2-a4301900f281, 'Je n''ai pas trop aimé parce que la pâte est sèche et c''était trop sucré. ', '2014-08-22T15:07:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36370, 8b9c4798-f434-4dbb-9483-481bba419d0d, 'Grande idée, mais pas très photogénique !', '2014-05-12T00:03:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36370, db7fd37d-2cc7-4af0-971a-db441f869882, 'Probablement par goût personnel, je n''ai pas du tout aimé. Beaucoup trop sucré, très écœurant et esthétiquement ne donne pas envie.  Je n''ai pas modifié la recette. Mon épouse qui adore le chocolat banane n''a pas aimé non plus.', '2014-02-01T13:16:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36370, 53ee3ce2-e4ca-48ef-9a37-98d36cf2eddc, 'Ça paye pas de mine mais c''est super bon. J''ai remplacé le chocolat par de la pâte à tartiner une variante plutôt sympa.', '2013-10-09T19:24:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36370, 38ab7009-4eb3-43b0-97ab-cbc59b9d4c8c, 'Très bon !! Ce n''est pas précisé, mais j''ai mis 10 cl de crème fraîche épaisse. Par contre, je n''ai mis que 100 g de chocolat au lait en copeaux. C''est très nourrissant, on a mangé une pizza à 3.', '2012-07-31T13:06:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36370, ed1f6737-a4e1-4066-8eaf-22ca1115823d, 'Pour les amoureux des îles, à mi-cuison parsemer de poudre coco; à essayer!', '2008-09-25T19:57:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36370, 72a18da4-906f-4859-a6c1-68c2ac0899da, 'Personnelement je rajoute un peu de cannelle. J''aime beaucoup cette pizza, elle sort un peu de l''ordinaire! L''idéal, c''est de la manger tiède ou chaude, après un repas léger, sinon, cela risque d''être unh peu lourd...', '2007-10-03T16:21:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36370, 91a14c1e-2862-4d4a-a071-9f7fa724b9c3, 'Super bon mais un peu écoeurant si on en mange trop.', '2006-12-27T23:24:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36370, a3df52c3-3b13-40fe-bf16-d3c888200254, 'Tout le monde a adoré... Très facile à réaliser! Cependant, au bout de 15 minutes, les copeaux ne sont pas tous fondus. Mais très bon quand même!!!', '2005-05-31T11:29:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36370, ca7dd4bb-af0f-4b75-8b80-f20687dfb496, 'J''ai trouvé ça pas bien savoureux. Un peu fade et pas très raffiné...', '2005-04-29T17:47:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36370, e03a0c59-29ac-4d23-a651-531a8c1251f1, 'J''ai trouvé cela un peu trop lourd. Je ne la referai pas.', '2005-04-24T02:21:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35886, f471126f-682f-45b6-b041-97a2984596f5, 'J''adore ! Moi j''ai mis en plus un petit peu de piment de Cayenne en poudre ! Une petit précision : les alokos sont meilleurs lorsque les bananes plantains sont bien mûres (peau de la banane noire), ça permet que les alokos soient tendres et moelleux !', '2020-03-05T20:43:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35886, 5126b362-a205-4fa6-bf8d-6f82ff991954, 'Recette sympa mais attention à prendre des bananes plantain bien mures sinon ça n''a aucun gout. Peut aussi se servir à l''apéro.', '2014-01-08T13:10:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35886, 70cc0bf6-93fc-40fd-8292-9983a37faa10, 'Simple et efficace.', '2020-01-06T11:51:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35886, 0dee9f1a-6143-488f-9a30-2582b150cbb8, 'Je ne vois pas l''intérêt d''utiliser des bananes plantain, c''était des bananes cuites dans l''huile, sans rien de particulier ... Aurais-je raté quelque chose au niveau du choix de mes bananes plantain ? ', '2009-04-06T00:50:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35886, 5cfbb9f4-1e02-44f6-8923-1dd23b4edc7e, 'Un vrai régal! Pour ma part, je les fait cuire à la poêle. Surtout, bien éponger après sur un sopalin. ', '2006-01-14T10:59:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35886, ba947e34-de78-490b-bfbb-77196d692728, 'Excellent j''adore miamm miammm..! ', '2023-05-06T15:00:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35886, fd4fd34b-1e93-4e5e-9bf5-423c0587df41, 'Un accompagnement qui change, facile à faire et rapide !', '2020-09-21T22:37:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35886, c8b44cc1-d60f-4ca5-87cf-c114816a0c83, 'Delicieux !', '2016-11-20T20:45:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35886, 425cf17d-e208-4330-8028-edf74e6a3b28, 'Tout simple et délicieux ! J''ai accompagné les bananes d''une sauce faite de tomates et de poivrons mixés, avec du Tabasco.', '2015-07-09T22:41:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35886, f5d3cfc7-e3ec-4883-91cd-aca1e3f04357, 'Excellent. C''est très simple à faire et très bon.', '2013-10-02T15:40:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35886, 066e3d17-cfb6-4e55-ae8c-657d570a1066, 'Excellente recette !', '2012-04-18T00:32:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35886, 0697010d-b3b1-4b7e-b470-949aa225c461, 'J''ai réussi mes alokos avec l''huile d''arachide par contre avec de l''huile de colza (je n''avais que ça !) ça donne pas vraiment le résultat recherché. Ça fait " bananes cuites à l''huile" ! Je me demande si finalement elles n''étaient pas trop mures (un peu trop noires).', '2010-05-04T00:30:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35886, cf9f4df5-1dd8-466b-837b-27e50e1884fd, 'Couper les bananes avec une mandoline directement dans l''huile, elles ne colleront pas. ', '2008-08-03T08:16:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35886, 553f4262-ed68-4eea-a986-5beee61ab9dd, 'Excellent! Cela a un goût de pomme de terre sucré. Très bon pour l''apéro !', '2005-12-31T14:52:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38986, d855cf9a-bcd8-42ba-822f-8a264d18c9bb, 'Pas terrible. Trop confipote, pas assez goûteux car trop de fruits différents qui s''annulent. ', '2016-05-22T15:07:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38986, c727c9fe-2a43-498d-a60a-0b84963f77d1, 'Faite avec du sucre cristallisé : 600 g par kilo. Le résultat ressemble plus à une confipote qu''à une confiture et j''adore le mélange des trois fruits.', '2013-03-18T08:28:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38986, 8c82c50f-e747-45d0-86db-55669a5cbc97, 'J''ai refait un peu à ma façon en mettant 1 banane, une petite mangue et 150 g de sucre (pour un 1 bon pot) et bien c''est un délice !  Ça a exactement le même goût que la confiture de mangue achetée en Guadeloupe ! Super non ?! ', '2012-06-24T17:05:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38986, 0cc2a4ab-7a9f-48f0-92ae-1b79b05cc982, 'Surprenant et délicieux. Le résultat me fait plus penser à une belle compote qu''à de la confiture mais je vous conseille d''essayer.', '2011-05-18T22:43:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38986, d20fb208-8064-4d3a-9475-d09a29c868bc, 'J''ai remplacé les 2 mangues par 3 branches de rhubarbe.  Pour 500 g de fraises, 2 grosses bananes et 3 branches de rhubarbe, j''ai mis 850g de sucre pour gelée. Un peu trop sucrée... Je la referai avec 500 g de sucre, d''autant plus que la confiture étant très, très bonne elle est très vite mangée donc pas de problèmes de conservation !', '2011-05-08T13:48:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38986, 1da43ff8-5ced-4422-b4a4-28650e2f85a5, 'Confiture faite avec bananes-pommes-framboises et réussie avec succès. Un vrai délice!', '2007-02-13T14:23:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38986, 9e373d15-a628-4016-a672-f23b4e803f16, 'Facile et très bon... Sans banane c''est pas mal aussi...!', '2006-03-24T12:27:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (370749, 34ba2dee-a107-48ef-ad19-f04cd99b384c, 'Un sachet de levure est effectivement de trop! La recette en soit est très bonne. Réduisez la levure sinon ça déborde (bjr le nettoyage du micronde) ', '2023-02-08T21:18:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (370749, ee2a0a8f-f15f-4707-bda1-9e23e0452ad4, 'Il faut mettre juste une pincée de levure chimique et y aller par étape pour faire cuire. Délicieux.', '2022-06-19T07:56:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (370749, 8900032c-f345-4ec2-a285-8307ef4f8cf3, 'J’ai respecté les doses et le temps de cuisson et avec seulement la moitié de levure la préparation a débordé et avec 3min de cuisson cela n’est pas assez cuit. ', '2022-06-09T16:36:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (370749, f5e92a40-f0c7-4361-aec4-d706eb4e35dc, '1 sachet de levure me parait énorme !!!', '2021-04-08T14:28:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (370749, fe575bd4-29cf-41be-82f9-f5034290fa38, 'ça n''a pas la même tête que sur votre photo. Bon appétit', '2023-06-09T19:52:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (370749, 25f0e552-f916-484b-99c3-078aaf89fdbc, 'Le sachet de levure c''est de trop, le bol a débordé et on sens trop la levure du coup.', '2022-05-01T20:10:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (370749, 83fb4376-a604-4d49-9fbf-63b48587a826, 'Délicieux !! J''ai adoré faire la recette, fondant en bouche, on sent bien les pépites de chocolat.
À faire et à refaire!!!', '2022-03-29T22:35:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (370749, f5518f46-0d76-4471-987d-fde43e374d3f, 'Fait avec 10g de cacao en poudre 100% et 20g de miel, accompagné avec une grosse poignée de fruit rouge et c''était excellent :)', '2019-03-29T10:38:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (370749, 368a68af-629d-4c00-bc30-52f5f0cf2d74, 'Simple, efficace et bon.', '2019-03-27T12:44:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20540, 4632e508-c109-4cbb-ae5e-65adff9b6198, 'Très bonne recette !', '2019-01-26T16:17:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20540, 54b2633b-b6b9-46d1-81f0-e386dee9428c, 'Bon goût mais présente très mal ! ', '2008-02-06T19:30:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20540, d233d0e3-cf68-4b56-b725-f7d6c326c13f, 'Très bon! Cette recette est valable aussi en soupoudrant de sel pour accompagner les plats en sauce ou au four.', '2007-09-11T23:41:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20540, d8306a29-a692-47f0-8d4b-01ffece4819c, 'Ouh que c''est bon...mais malheureusement pas pendant les régimes...mais vraiment trop trop bon!', '2006-08-13T18:11:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20540, 36ef3132-ad60-4d3a-9092-9a927bbe02cd, 'Originaire des antilles, ce dessert est l''un de mes favoris!!! Tout le monde adore, petit comme grand. Cependant, il ne faut pas en abuser... A essayer absolument!', '2005-08-31T16:18:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25914, dd481347-d109-4402-b78b-8b61763f2563, 'Je ne sais pas ce qu’il s’est passé mais je n’ai pas réussi à reconstituer les bananes et malgré le passage au congélateur 30 min et frigo, tout avait dégouliné donc aspect pas terrible. Mais le goût très bon. La prochaine fois j’essayerai en verrines. ', '2019-04-05T05:00:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25914, 3aa45276-ad84-4a11-a875-e4772af757c2, 'Cool.', '2019-04-20T11:19:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25914, 398e747b-f1ad-44eb-8e83-80830bad4fd6, 'Deux mots : un régal !', '2014-03-16T12:01:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25914, ead262d3-2da7-4b68-a08a-04cba6495cfa, 'Simple et très bon', '2012-10-21T08:30:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25914, e8cbe585-acb0-477b-9fda-28222835fe76, 'C''est trop bon !', '2012-05-31T19:22:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25914, ccc941b9-5ce6-4195-9d11-c6652b612a96, 'Humm j''en ai fait pour moi et mon copain c''est délicieux', '2011-08-22T15:24:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25914, e76b4754-b8f4-4e1a-9a1f-1d1f705aa218, 'En verrine, et sans sucre, c''est pas mal non plus !', '2010-04-23T20:36:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25914, 8dc9be8a-8981-4aa8-b889-98921eb99e2b, 'Délicieux, les enfants ont été ravis. Les plus grands ont noté la recette dans leurs carnets personnels!', '2007-02-11T23:04:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25914, e1404179-fd62-4ceb-9dc1-c073576ab0fe, 'Vite fait, délicieux et pas si difficile de réassembler les bananes.', '2004-02-28T16:59:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17978, a72b397d-9f4a-4477-bb31-57f316d1d47a, 'Très bon, avec une boule de glace, c''est léger et rafraichissant !', '2022-08-07T11:26:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17978, 0c19d1a6-0b24-46db-b244-895af9aed87f, 'Absolument parfait... à s''en lécher les doigts.', '2013-08-14T04:59:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17978, 2dbfdab4-c039-473d-b63a-cf4482f932d1, 'Proportion de marinade doublée, et ajout de cannelle. Fait la veille au soir.... et invités conquis. Franchement super idée de dessert pour terminer un repas en extérieur, déjà tout en BBQ. On consomme tranquille les grillades salées, pendant que les petites brochettes de fruits se dorent sur le papier alu, on passe un pinceau de marinade dessus, on les retourne, puis des cuillerées de marinade. Ça se caramélise... et tout chaud, c''est délicieux, sympathique, surprenant. Bref, je ne regrette pas d''avoir testé. Ça a été large approuvé.', '2012-07-22T21:20:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17978, a35176a2-10dd-450d-aab5-28fb43875f7e, 'Par contre pas assez de marinade, difficile de faire tremper tous les fruits dedans, avant de les cuire un petit passage dans une assiette de coco râpée... A essayer dans le futur.', '2010-08-19T02:22:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17978, ecf0db88-949d-44dd-8832-d7dfc8642ca5, 'J''utilise des fruits qui se tiennent mieux comme la pomme, la poire avec en plus la banane et l''ananas. Ma marinade (à faire la veille) est bien plus simple avec simplement du rhum et un peu d''eau sucrée. Une fois que les brochettes cuisent, je les saupoudre de sucre vanillé , des deux côtés, ensuite encore chaudes et dans l''assiette de la chantilly et du coulis de chocolat, un régal (mais pas pour la ligne).', '2008-07-12T20:54:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17978, f8fe21ae-736a-4ee5-a55d-a5be7e8ce7a4, 'Hum, la marinade était très épaisse, je ne m''attendait pas à ça. Donc difficile d''y faire tremper les fruits. Dommage.', '2008-06-10T13:17:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17978, db4d7efd-a24f-4297-8d28-cc38a0c915be, 'Super bon, super joli, super original, franchement super....essayez vite.', '2007-07-03T18:05:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17978, 6a8ef07e-1e2b-4aef-8709-dc6e3905f86b, 'Délicieux facile et rapide! J''ai remplacé la pêche et la cardamome par de l''abricot et de la vanille. Le tout passé au grill du four.', '2007-04-15T12:02:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17978, 97d21b60-302a-46f8-b6de-74ad73fe65cc, 'Excellent même au grill du four. J''ai fait réduire la marinade après y avoir ajouté un peu plus de  miel et décoré l''assiette avec de la menthe, un filet de sauce chocolat chaude (mélange chocolat de cuisine et crème fraîche comme pour la fondue ) et quelques chammallow.', '2005-03-11T15:51:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17978, 61557b6b-71cb-441f-98bc-5312810686bb, 'Desser délicieux qui a ravi mes invités. J''avais fait un caramel avec la marinade: le top!!! Attention toutefois à la cuisson.', '2004-07-19T10:43:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17978, 6f47605d-6244-402e-a761-9851a2b2215f, 'Je n''ai pas mis de cardamome et j''ai remplacé le sucre brun par du sucre blanc et c''était tout aussi bon!', '2004-07-12T17:53:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28179, e8bd6b7c-514b-4a2f-9cee-4f2b42e37523, 'J''ai trouvé plutôt fade et gras. J''avais juste mis un sachet de sucre vanillé, et pas de sucre. Le goût des fruits se mélange et le Rhum emporte la finesse de l''ananas et de la mangue.  Les invités n''ont pas non plus été convaincus...', '2011-02-15T19:50:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28179, 3f64d33f-28fa-4df6-a849-5444492d95f2, 'Dessert léger et agréable à déguster en hiver. Ne pas ajouter ni sucre vanillé ni sucre blanc, le sucre des fruits suffit. Gratter une 1/2 gousse de vanille pour avoir le goût de vaille sans utiliser de sucre. Servi avec une glace', '2010-12-05T19:11:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28179, fa94c0d2-821b-47a4-b464-0b7962119fa0, 'J''ai préparé ce gratin dans des marmites individuelles et j''ai laissé au frais macérer pendant 4 bonnes heures et passé au four avant de déguster. Un délice.', '2010-12-05T14:01:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28179, 2e197c2e-ce38-41f3-bb5c-ae980f727c5a, 'Le sucre vanillé suffit. J''ai présenté ce dessert dans des petits plats individuels mais pour les gourmands c''était un peu juste!...  ', '2009-02-11T14:42:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28179, 3670eedb-3fc7-43fa-b740-a06000339e09, 'Original, mais le sucre est presque en trop... Les fruits frais suffisent!', '2004-11-06T18:58:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, e40dbec2-2008-438d-84ba-18991602a5a3, 'Très bonne recette mais la prochaine fois j''y mettrais moins de beurre.
', '2021-12-05T17:40:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, d1b3ea22-d5b6-4fc2-b7d0-f0de878bf4d6, 'C''est délicieux 😋💜', '2021-05-09T17:09:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, f3960d54-2746-4826-b94b-cadd59c55576, 'Super bon ! Ne pas oublier de mettre la levure qui n’est pas écrite dans la recette.. Pour ma part, je met un peu plus d’1/3 de pâte dans le moule ensuite une rondelle de banane puis une bonne cuillère café de nutella et je recouvre jusqu’au bord de pâte. Effet garanti !', '2018-06-07T04:33:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, 56dec5ad-6092-437f-b77e-ef696fe8358d, 'Très bon ! Une banane est suffisant pour moi, je ne suis pas fan de la banane dans les gâteaux donc c''était parfait. J''ai rajouté un peu de spéculoos pour le croustillant.', '2017-09-19T18:33:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, 062f7b1f-b5d3-4efa-aa9a-e1b49cc74559, 'Très bon ! Par contre on n''a fait que 6 muffins! Pas 30!', '2017-05-28T19:46:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, af8fce9c-3db1-4587-879b-231c4c9c9a80, 'Très bon ! Mais un peu sec ', '2016-06-27T23:03:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, beef2f25-72fb-477c-927a-928ed3e730fe, 'Excellent... 2 bananes mixées, un moule en silicone et aucun souci au démoulage. Et ils sont encore meilleurs le lendemain. Merci pour cette recette vite réalisée et qui comble tout le monde.', '2016-02-29T10:52:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, dfd92e63-7b13-457f-98ea-7d8467f0d513, 'Facile à faire ! J''ai fait 20 petits muffins avec et c''est un régal !', '2016-02-15T17:45:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, 049976bf-ae61-49f1-a1a1-e6d7f835549d, 'Excellents muffins ! Mes fils m''en réclament régulièrement !', '2015-02-01T15:31:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, fec42c0b-43d6-4c66-90a3-6a8492cebe6d, 'Excellente recette, tout le monde a beaucoup aimé. Si je peux ajouter un conseil c''est de ne pas mettre la moitié de la pâte mais plutôt les 3/4 puis mettre le nutella et recouvrir ensuite avec le reste de pâte. Cela évitera que le nutella colle au fond. ', '2014-10-21T17:24:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, 0d133ec3-3a47-4dee-be75-347683ff3ee9, 'Trop de beurre! Sinon, c''est très bon.', '2013-06-18T12:15:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, ff098ece-6e03-4e4c-8451-e2b96dbf5e12, 'Très bon au goût mais présentation catastrophique quand on utilise des caissettes en papier !! Tout a débordé et mes muffins ne sont pas présentables.', '2013-04-25T18:22:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, a3174b87-a0a6-428d-a0ea-5e480e9c62e1, 'Succès garanti ! Collègues, famille, grands et petits, tout le monde les adore !  Je mets généralement 100 g de beurre salé, c''est suffisant car avec l''huile de palme de nutella c''est trop gras après. Je mets toujours deux bananes minimum car sinon on ne sent pas assez la banane et pour le nutella une bonne cuillère à café car c''est meilleur !', '2013-03-19T00:14:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, bac1cf0a-9675-4cbf-973a-6adc2976029b, 'Mes enfants ont adoré, à l''unanimité (5 quand même !). J''ai essayé en doublant et triplant la dose de banane pour les mêmes proportions... DIVIN !', '2013-02-25T17:30:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, f002cc8c-c690-4ea3-9b06-5133241b6a5e, 'Un peu déçue car le Nutella coule au fond et durci un peu mais la banane/nutella, c''est une association qui cartonne.', '2013-02-08T12:13:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, 68e5e840-0154-4b89-934b-6afd1db3fa0f, 'Très facile à faire et excellents ! Tout le monde a adoré ! A refaire !', '2012-12-08T11:17:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, a23acbe2-1c45-4120-9d8d-25f8429d51ea, 'Excellent, j''en ai fait une première fois la semaine dernière. Les collègues de mon mari en ont redemandé !! Et lui aussi !!! Recette parfaite, aérée, les muffins sont légers !!! A refaire encore et encore', '2012-11-27T13:22:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, 39e64f1e-3d5e-4bdf-b0b0-faaad2be4314, 'Mon conjoint a tout simplement adoré ! A refaire sans hésiter.', '2012-11-17T11:50:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, 96c17bfa-9091-4674-b6ef-5097380ea289, 'Très facile et très bon, bref parfait !', '2012-05-08T17:09:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, e160d04d-7801-406b-a717-c6b2e99b0dca, 'Très bonne recette que j''ai faite plusieurs fois. Ne pas oublier la levure, qui n''est pas mentionnée dans les étapes de la recette. Je mets parfois 2 bananes. Je la referai sans hésiter !', '2012-04-23T18:20:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, 12a5f30e-e20c-4547-95a2-3038528094a0, 'Super bon ! Très facile à réaliser. A refaire.', '2012-02-22T08:21:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, 478c5ee3-59cf-4185-9c74-24e2a4a80c23, 'Juste excellent ! J''ai fait cette recette plusieurs fois et une fois j''ai ajouté de la noix de coco et une touche de rhum, c''était trop bon.', '2012-02-11T17:01:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, d703a21c-7457-4fa5-8bfb-26d0b83c5017, 'Très bon ! Je l''ai faite trois fois pour le plus grand plaisir de mon mari, à refaire !', '2012-01-23T00:56:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, 5cd858a9-b903-400f-8f2c-6f20df74a16e, 'Super facile à faire et un régal ! Conseil : j''ai mis 2 bananes.', '2011-12-06T20:05:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, b68694b5-f21c-4b0d-a5d6-8b09fb273777, 'Le goût est bon mais je ne comprend pas, les muffins n''ont pas du tout gonflé mais ont débordé et sont très très gras (les caissettes sont toutes huileuses). Pourtant j''ai bien respecté les doses et temps de cuissons.', '2011-11-24T10:46:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, 04c6ce0a-ea94-46ad-9ef2-a5294c1f17e3, 'Bon mais mais on ne sent pas vraiment de goût de la banane. Et mieux vaut les faire dans des petits moules, car assez consistants.', '2011-02-04T22:47:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, 6e65b7cd-6267-46d9-9066-17d913962be6, 'Très bonne recette, facile à réaliser et rapidement !  Conseil : prendre des bananes bien mûres. ', '2010-11-01T13:32:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, 18a6a02f-da3b-418a-88de-22aa25dbca77, 'Muffins faciles à faire, par contre les quantité sont plutôt pour 12 muffins que 6!... réussite à chaque fois, mes enfants adorent!', '2010-10-03T19:03:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, cc028983-d291-4d5b-872f-e1733d045083, 'j''ai ajouter des noix coupées en petits morceaux, ca va très bien avec le gout de la banane et u nutella .. j''ai suivit la recette à la lettre,rien est à changer !!', '2010-02-22T01:07:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, eaf69538-51e9-4705-bb16-ecceed056bc6, 'Les enfants ont adoré, les parents en ont raffolé. C''est très simple à faire, on sent bien la banane, et le nutella fondant, c''est un régal!!!', '2010-02-01T19:03:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70186, 67a9cc40-f585-4a00-9e7e-073dfdf2dbd9, 'Très bon si on est fan de Nutella comme moi.', '2008-06-04T15:47:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166214, 7cfbf15d-e541-4401-af44-3f0a6f69484f, 'Le mélange chocolat-banane mixé, ce n''est pas excellent ; à chacun ses goûts. A tester avant de le faire à des invités.', '2010-05-08T23:55:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (87550, 9ebee9e0-f996-4c4e-a535-a7033bf99610, 'Fait avec des poires et résultat super léger très bon ', '2023-10-31T21:32:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (87550, 0d49059f-f922-4f50-a11e-817af848ec90, 'Excellent. Moelleux avec des petits morceau de poires. ', '2020-03-31T15:15:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (87550, 672f578c-3809-41be-a3d1-881ea3b79274, 'Je sais que l''intitulé super léger fait allusion au fait que ne mette pas de beurre mais je trouve que ça manque vraiment, goût farineux de la pâte avec les bananes... décevant. Avec du beurre, ça serait bien meilleur...', '2010-03-13T21:43:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (87550, 18000bbd-46be-4e6a-9f13-4260923f4855, 'Je les ai fait avec des poires au sirop c''était très bon et très moelleux. ', '2009-11-09T11:39:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (87550, e9d0434b-e444-4f31-840a-3a2a45b6bf8f, 'Succulents ! Ces muffins sont en effet très legers et super moelleux ! Je les ai fait pour la famille anglaise chez laquelle j''habite et ils ont tout simplement adoré. De plus ces muffins sont très facile à faire. Seul petit bémol, le goût du chocolat n''était pas assez prononcé et le tout manquait un peu de sucre, je rectifierai donc cela la prochaine fois que je referai cette recette. ', '2009-11-03T17:53:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92864, d0d79e48-bfdb-4238-b890-abb7eea8dfa3, 'Excellente recette facile à faire et le résultat est très bon. La mousse de coco très légère. Je n''ai eu que des compliments. J''ai alterné pommes et bananes. Je referai cette recette. Juste une petite modification : les quantités pour la mousse sont un peu trop importantes. Il faudrait, à mon avis, diminuer de moitié. A tester.', '2019-02-17T13:45:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92864, ff13a135-4f56-4839-9536-864d041ceb48, 'Vraiment très bon! Les enfants étaient ravis et le papa aussi! Ça ressemble un peu à un flan à la banane.', '2017-04-03T22:34:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92864, b0fd3a5f-d226-4e22-9800-ec8d02f5a2db, 'J''ai fait cuire à blanc la pâte feuilletée. 2 bananes. 200 g crème de coco. 50 g de sucre. Le goût du coco n''est pas prononcé.  J''essayerai avec 300 g.', '2016-06-20T11:24:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92864, b47814fd-77d6-470a-b1f8-4321ce1e9673, 'Excellent....2 bananes, 1 pommes, rhum ', '2015-10-03T22:11:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92864, 9dc12713-480d-4120-b2ca-8a3ee376951d, 'Facile et très bon. Je l''ai faite 2 fois déjà avec banane. Je conseille de plutôt prendre de la crème de coco un peu plus épaisse pour que le mélange se fasse bien avec le blanc d''oeuf. La mousse coco est très épaisse : 3 cm. Je pense qu''en diminuant de moitié les quantité : 2 oeufs et 200g de coco et 50g de sucre ce sera bien aussi mais je n''ai pas encore testé. Merci de cette recette que je garde et qui a enchanté les jeunes.', '2015-01-30T00:34:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92864, 4c375e49-0d4f-48ad-9197-e8437f3b1801, 'Excellent !  ', '2014-06-07T15:14:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92864, 60229c8a-6f0c-46a6-b89b-42b269665939, 'Très bon ! J''ai étonné tout le monde par la légèreté de cette tarte ! J''ai utilisé une pâte sablée, et 2 bananes. Je referai !', '2013-10-04T14:29:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (314631, 7d108284-0a82-45ff-90e9-8d38bef80cb3, 'Tip top!', '2023-06-17T15:04:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (314631, 74a7665a-76fa-4c63-b94b-8eb5848687a6, 'Trop bon un régal je l''ai fait plusieurs fois, croustillant à l''extérieur et moelleux à l''intérieur', '2019-03-29T10:21:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23419, bb536b82-6f72-456f-8672-f20f142e2c67, 'Excellente recette, rigolo et facile à faire. Présentation qui donne envie !  Pour mettre le chocolat, j''ai directement tremper la brochette avec la banane dans le chocolat, par contre il faut faire assez vite car quand le chocolat commence à durcir, c''est un peu plus galère..  Le sortir au moins 10-15 min avant de servir, c''est meilleur quand ça commence à décongeler.   Idée : Rajouter de la noix de coco râpé dessus le chocolat !', '2016-08-10T11:25:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23419, 6e9fdd02-cba6-40f6-86d1-248e46c63967, 'Merci pour cette recette originale. Suite aux commentaires précédents, j''ai résolu le problème des doigts en piquant les rondelles de bananes sur des pics à brochettes une par une pour les tremper. C''était très simple. Ne trouvant plus mon chocolat noir, j''ai utilisé une demi tablette de chocolat noir à l''orange et une autre demi tablette de chocolat au sésame, mélangé les deux, c''est excellent ! Je n''ai pas mis 5/5 car pour être frais, c''est frais ! En fait, trop glacé ! Peut-être sortir ces petites confiseries du congélateur un peu avant de les consommer.', '2012-08-26T11:53:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23419, b4297ccd-9f02-4232-be3c-724212f871f5, 'Super bon un vrai régal.', '2019-11-06T12:35:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23419, f7b0f98a-d78a-4346-91d5-ede57b1ec441, 'Une bonne recette de dessert très simple et rapide. Il faut effectivement les sortir légèrement avant de les déguster pour pas que la banane soit trop froide', '2019-07-27T17:56:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23419, de7a071f-4d19-47b7-a9ad-bd2a0a383826, 'Très bon, à réaliser maintenant.', '2016-02-20T05:48:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23419, f762c34e-c5cd-41fc-98e1-694f0dc7cda0, 'Trop bon', '2016-01-24T15:59:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23419, 83891dce-e888-4fdd-badd-649695a5a9a1, 'Très bon, le chocolat est croquant et les bananes bien fraîches. Par contre, je les ai sorties du congélateur quelques minutes avant de les manger, car sinon c''est trop froid... Avec une cuillère pour tremper les bananes, ce n''est pas du tout salissant... A refaire avec plaisir !', '2015-07-23T19:57:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23419, 8130106e-6a90-47ac-8ee3-27b6c7d8c4fa, 'Vraiment délicieux ! J''ai utilisé 2 cuillères pour faire rouler les rondelles de banane dans le chocolat, ce qui m''a permis de garder les main propres... Je réessayerai accompagné d''une boule de glace vanille, hum...', '2010-09-12T18:21:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23419, 54014905-be2e-4aaf-9d95-31e4a9fb40fa, 'En rondelles ou en tronçons,ouf que c''est bon. Facile à faire, un dessert à faire préparer aux enfants.', '2008-07-08T14:46:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23419, 96e0989d-298b-4669-9110-721e520f2a4f, 'Facile, rapide, j''adore. Miammmm', '2005-09-19T16:59:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23419, 40ee5507-3bec-48e1-b40b-caa07afee887, 'Délicieux!! Super idée. J''ai trouvé un compromis pour garder les doigts propres: je mets une cuillerée de chocolat sur chaque rondelle, c''est moins beau mais tant pis !!', '2005-06-03T15:55:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23419, 21e806cb-5b92-4de7-9273-443bb4b9659f, 'Très très bon et rafraîchissant. J''ai utilisé des pommes vertes que j''ai aussi trempées dans le chocolat. Par contre, tremper les bananes dans le chocolat, ça n''est pas facile! Salissant...', '2004-07-24T20:47:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23419, 46c18e9c-af92-4aaf-8c1b-607c2ca314ba, 'Super bon! Tout le monde a adoré.', '2003-08-26T16:45:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23419, bd7e387a-f228-438b-ac8b-2126b3b0adea, 'Un vrai délice! Les enfants ont adoré, les parents aussi !!!', '2003-07-25T05:38:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 26b98028-1764-4996-9956-ad93b784116e, 'Excellent gâteau !! A manger tiède pour ma part car le chocolat est fondant !!!!!!!!', '2015-03-12T19:02:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, d826c343-5aea-4bad-8355-a119a5fd1cb9, 'Moins de sucre : 200 g remplacés par 2 cuillères à café de Stevia. Plus de bananes 2-3 en l''occurrence. Moins de beurre (mélangé avec margarine). Moins de chocolat (une demi tablette de chocolat au lait) dont j''ai coupé chaque carré en 2 pour créer les éclats intègres 20'' après le début de la cuisson. J''ai ajouté du jus de citron et une cuillère à café de rhum aux bananes. Pour la cuisson 20 50 minutes suffisent.', '2013-09-07T16:37:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, acaf31c4-a71b-4916-b56f-6b528e03bc7d, 'Excellent cake ! J''ai mis 210 g de sucre et utilisé du fromage blanc 0%. Je conseille de consommer le cake une fois refroidi, voire le lendemain. Je l''ai fait une dizaine de fois et à chaque fois c''est un réelle succès ! Merci pour cette recette simple et délicieuse !', '2013-05-19T17:16:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, c9e15568-d945-4427-8867-253e58f3a0e2, 'Pas bon, gras, trop sucré... à éviter. ', '2012-09-26T13:55:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 41cefb8a-3272-4249-b0fd-b16ca6eecee0, 'A chaque fois que je le fais tout le monde en redemande, on me passe même commande !!! Je mets un peu moins de sucre et un sachet de sucre vanillé en plus et aujourd''hui j''essaie avec un peu de rhum pour changer. Merci pour la recette !!! ', '2012-08-09T19:34:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 30f55a36-f0b7-4dad-a103-3ef3e0724156, 'Le gâteau est super bon, j''adore le goût de banane... Malheureusement j''ai oublié mettre la cannelle... Ce sera meilleur avec... En revanche, j''ai eu peur avec la quantité du sucre, donc j''ai mis que 100 g de sucre et c''est déjà un peu trop sucré pour moi (n''oublie pas que la banane est déjà sucré..). Merci pour cette recette.. Je le referai !', '2012-07-22T19:43:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, de84f20f-6048-48b2-915b-7d6ab5ebf928, 'Très bon ! C''est vrai que la cake est gras mais pas à l''extrême, et puis c''est tout de même un dessert... J''ai aussi utilisé du chocolat à la menthe (à défaut de n''avoir rien d''autre chez moi au moment de la recette) et c''était excellent !', '2011-01-22T04:44:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 4ed8c4d3-4fd7-4ad2-a831-28e2d49f6695, 'Seulement 3, j''ai trouvé le cake un peu gras, se cassant facilement à la découpe, le chocolat tombe au fond et c''est moins présentable, bref je ne le referai pas', '2010-11-04T07:28:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, ecee7d51-d480-4b68-bfa3-188e93f37371, 'Nous avons aimé, tout a été mangé, j''ai juste mis une banane en moins.', '2010-01-22T13:01:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 6088f31d-7464-4eee-bc06-02152b4d35f5, 'Ce gâteau a fait l''unanimité au petit déjeuner!! J''ai suivi les conseils d''autres adeptes bien avisés : je n''ai utilisé que 200 g de sucre et pour le chocolat j''ai pris du noir à dessert découpé en petits morceaux. La prochaine fois je les intègrerai dès le début de la recette pour un côté encore plus fondant. Peut être j''y ajouterai aussi une banane!! Gâteau vite fait et bien fait et très apprécié!!', '2010-01-17T10:21:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 027136f1-05fe-4d3c-b86d-a204f563158f, 'Excellente recette !  Je me suis permise de modifier la recette en y ajoutant deux cuillères à soupe de Rhum !!   Merci pour cette recette !  ', '2009-09-10T18:17:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 44f8732a-8193-4824-87c5-dd6f858803f8, 'Un vrai délice avec 200 g de sucre !', '2009-07-18T17:28:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 7d3780d3-c85d-4777-811e-f3ebdadfd64e, 'Excellent gâteau, les enfants ont adoré. Je n''ai utilisé que 200 g de sucre comme conseillé dans les commentaires précédents, et j''ai piqué des carreaux de chocolat après 20min de cuisson ... un régal !! Merci pour cette recette.', '2009-06-04T20:15:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 2b4ef261-bbdc-441e-9441-82c9822ffa43, 'Recette testée aujourd''hui et très appréciée. Il faut diminuer les proportions de sucre et de chocolat comme l''indique les internautes.', '2009-02-17T20:20:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, d22cbdc0-d37f-4bdc-8420-0d1435570f3d, 'Je conseille de le faire plutôt dans un plat à gâteau plutôt qu''un plat à cake (plus rapide à la cuisson et plus facile pour disposer les copeaux de chocolat) et de mettre plutôt 200g de sucre et 100g de chocolat car les doses indiquées sont trop importantes. Sinon délicieux, grand succès auprès de mon entourage!', '2008-11-10T21:28:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, fb50bc32-980d-48af-9025-97dc33eea2c6, 'Bon, mais pas génial! Cependant je referai avec moins de sucre, et en essayant de l''alléger (je vous dirais comment dès que j''aurais la solution), excellente solution en tous les cas pour passer les bananes mûres.', '2008-09-25T23:27:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 6ffd00ce-b72d-4aaa-aa8a-bed218bacc53, 'Très bon. Excellent pour utiliser les bananes trop mûres que les enfants ne veulent pas manger... 200 g de sucre sont largement suffisants. Par contre, incorporer le chocolat après 20 min de cuisson est bien périlleux. Une croûte est déjà formée et le centre est encore liquide, bref un vrai carnage brûlant qui n''empêche pas le chocolat de tomber au fond... je le mettrai dès le début la prochaine fois ! 1 h à 160° en tout a suffit pour la cuisson.', '2008-03-02T20:56:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, b738b2f4-9abf-445d-bfb3-350e8adaf54b, 'Pas mauvais pour le goût mais porte bien son nom de "pavé" pour la texture. Essayé une fois mais pas deux, désolée!', '2008-01-31T14:26:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 09c56906-7b57-424f-929e-5c3f875d4f9a, 'Excellent! Merci pour cette recette, c''est devenu un classique chez nous ! Décliné en gâteau rond dans un moule à manqué, en petit train pour l''anniversaire de ma fille, ou en cake traditionnel, ... LE must réclamé de tous ! Niveau proportions j''ai juste réduit à 260 g le sucre et 200 g la farine et remplacé les pépites de chocolat du commerce en copeaux de chocolat coupés à l''éminceur.', '2007-07-24T14:20:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, c9f5bd09-979c-4ddd-a7c8-1b6810bae688, 'Une merveille, tout le monde adore. A essayer aussi avec une cuillère à café de cannelle ou 4 épices à la place de la vanille.', '2007-03-29T19:08:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 5f9224c2-91e0-4fcd-a5f7-790d84228e12, 'Recette simple et très efficace. Un délice !! Le mélange banane-vanille-chocolat est extra ! Merci', '2007-01-31T17:33:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 4c21155e-9656-422f-a853-5997631fcd61, 'J''ai suivi les commentaires et mis que 200g de sucre. Ce gâteau est délicieux, moelleux, le goût de la banane est subtil, et l''association avec le chocolat est excellente.', '2006-10-18T15:56:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 5a8110bf-1bbb-493b-b748-98d08fd6c7ee, 'Trop bon!!! Moi qui adore l''association banane-chocolat j''ai été ravie!(et mes amis aussi)', '2006-10-05T20:52:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 391a10af-0248-44c6-b865-b52fba3d6188, 'Trop sucré tel quel mais très bon avec la moitié du sucre et les 2/3 du beurre. Du coup le chocolat reste à la surface, mais ce n''est pas désagréable. Merci pour cette recette qui permet d''écouler les bananes en se régalant!', '2006-09-21T17:23:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 80fa9c92-009b-464e-a0f0-0e83b3e8ff4a, 'Bravo! Délicieusement moelleux! J''ai quand même réduit la quantité de sucre (200g suffisent largement à mon goût) et remplacé le chocolat par des raisins secs que j''ai ajoutés à la pâte dès le départ.', '2004-12-21T20:16:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, cfa57eef-3ea9-49e9-b93f-441e3921ede6, 'Délicieux... bien attendre les 20 minutes avant d''incorporer les pépites de chocolat car elles ont tendance à tomber au fond.', '2004-04-05T20:28:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 1faff1c9-3a50-434a-b886-22d192890fd5, 'Très bon, mais il suffit de moins d''une heure de cuisson.', '2004-02-27T13:46:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11043, 4ad76cd3-0236-4e4d-aff8-06eaaae2c85c, 'Excellent, à essayer avec des poires, c''est succulent !', '2001-01-14T17:51:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (175378, 40ff1144-b0f2-4e17-a94f-9a895c8a7178, 'Les quantités d''ingrédients indiqués dsan la recette sont destinées à réaliser au moins 36 petits cakes ! Le mélange est bon mais le gâteau est assez dense ! J''ai mis un peu de rhum mais je pense qu''il manque de la levure !', '2012-02-08T14:02:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345584, c18af2cd-8deb-4fc3-a748-2467dbcf4eb6, 'Super bon  le mariage pomme comconbre orange banane 
j''ai rajouter deux glaçons  .tres onctueux ', '2021-04-22T11:44:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24258, 13023134-de41-4526-90d2-5eb1645b4921, 'S''il vous plait... Je suis sûre qu''il y a beaucoup de recettes qui peuvent se prêter à la délicieuse banane, mais mes ancêtres ne connaissaient pas cela avant les années 50... Je ne voudrais pas être terroir/terroir, mais quand même... le far est un gateau rustique de famille et breton, pas antillais ni africain... Appelez-le gâteau aux bananes ou clafoutis aux bananes!', '2004-01-29T03:02:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24258, d188a633-2b98-4b90-bcf9-fad111a11d7f, 'Il existe certainement des recettes bien meilleures. Celle-là ne contient pas assez de bananes et le fructose donne un goût assez spécial...', '2003-12-08T17:12:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (87600, d7e9ac5a-3d54-4dd6-a728-e44308dc6657, 'Bon mais un peu lourd', '2014-06-20T00:05:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (87600, d4ee0c1b-a667-42b3-9275-c69403640c30, 'Votre gâteau et excellent', '2012-12-08T17:56:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (87600, ebe189fb-caa0-4a29-a04b-0370bae73a7a, 'J''ai fait cette tarte sans les raisins et c''est divin ! Le fait de battre des blancs en neige rend l''appareil aérien et léger en bouche. J'' ai mis 3 bananes. Je conseille vivement cette recette. Merci à l''auteure.', '2009-09-01T19:27:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43894, 0c237740-3925-417f-89b3-482101e97d94, 'J''ai essayé avec de la menthe, goût très frais et très bon, surprenant goût banane et poisson, subtilité de saveur avec le curry mais attention à mettre suffisamment de sel et poivre ', '2013-12-28T08:49:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43894, 547f84ad-f227-4ca0-82ce-8a9fe61f8dd9, 'Recette testée et refaite plusieurs fois : c''est toujours aussi délicieux et simple à faire. L''espadon reste très juteux. Si besoin, on peut remplacer la coriandre par de la menthe.', '2013-07-08T13:43:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43894, ec03fbab-8ec4-4316-b71a-4a1267b640c8, 'Surprenant, goûteux et facile à faire. Avec du loup ou du cabillaud, c''est bon aussi.', '2011-10-15T14:13:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43894, 51dcfeec-3ba2-492f-9e0f-87551dd75c29, 'Sublime, même pour ceux qui n''apprécient pas beaucoup le poisson. Quand je n''ai pas de coriandre, je mets du persil et ça va aussi. J''ai essayé cette recette avec des darnes de requin : même constat, très goûteux!', '2009-12-21T19:39:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43894, 2f2c2b31-08b7-46bd-b499-c72c74fff497, 'Oui, excellent ! Facile et rapide. A mettre dans son carnet de recette pour épater les invités. ', '2007-10-07T15:03:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43894, c335f87f-6574-43c8-911e-4281dfc2af2a, 'Excellent, vraiment très facile.', '2006-10-31T21:57:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392558, 14123809-4fa2-479f-80d3-1d6f32810a21, 'La recette a beaucoup plu ! La banane ressort plus que le marron. N’hésitez pas à faire cette recette !
', '2022-01-09T17:23:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167112, ea87a817-3ea3-430f-8382-b5a04db8ef06, 'Recette très facile à préparer. Peu d''ingrédients et peu exigeant en temps. Idéal pour le goûter des enfants.', '2010-07-30T01:09:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21554, 9cd272f7-cf41-4dab-a028-1a77fd84b8cf, 'Très bon! recette facile à réaliser, rapide à préparer. J''ai préparé en avance, et cuit au dernier moment, mes invités étaient épatés!! Par contre, au cuit vapeur, il m''a fallu 1/4 d''heure de cuisson. et pour qu''il y ait de la couleur sur le poisson, j''ai déposé quelques baies rouges sur la farce avant de plier la feuille.', '2008-11-28T15:27:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (535055, 3d7ac319-a7b8-440d-807a-3edeefb521b7, 'Trop gras sans doute ???? ', '2023-03-02T08:00:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528103, 877164d9-ad15-4aeb-96e6-12685a065e3f, 'À la place du miel, j''ai mis un coulis de banane mixer, un vrai délice.', '2022-06-07T17:06:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227745, c7b8eaff-27f7-4f2a-8ba1-af2065f0975d, 'Très très bon, mais à consommer bien frais. Ça change un peu des entremets habituels et c''est très rapide et facile à faire.', '2022-10-23T19:30:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 50ef5775-1454-4bf2-b3fe-a1d0cf4b7343, 'Excellente recette ! A mon goût, 75g de sucre, c''est suffisant.', '2018-05-30T16:58:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 7c8f6166-95ce-44e2-b42a-9d28b9f5b99c, 'Très bonne recette je recommande ! Cependant, un peu moins de beurre, de sucre et de banane ne fais pas de mal… Aussi, laisser la pate reposer serait peut-etre mieux…. J’ai fais 2 fournées dont une avec la pte reposée et les muffins sont plus aériens et la pate moins élastique ', '2024-01-14T12:30:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 3ef7fec3-47a6-4400-b433-e708a97470ce, 'Un pur délice, moelleux et fondant, un vrai plaisir gustatif !', '2023-01-03T21:13:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 75165228-c3c3-4a37-81e9-9ba418c8ca36, 'Rapide et simplement délicieux. Le goût de la banane est suptile et le plus le coeur au chocolat. Un régal !', '2019-06-05T13:47:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 935b6be9-2e1a-4435-be50-e0fd5444d976, 'Bonne recette à refaire !', '2018-09-07T13:01:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, dec9da7f-46eb-47aa-ae27-cf1b969d5168, 'Cette recette est un vrai délice ! Tout le monde a adoré. À refaire !', '2017-06-15T14:16:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 3cc3da24-5a69-4e8b-ad61-fa0e183e70dd, 'Excellente recette. Muffin très moelleux !! A refaire.', '2017-02-04T13:40:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, ef906126-a6c5-4586-a7ef-745659812d14, 'Très bonne recette', '2016-06-26T23:50:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 9be38ea7-7a95-4fae-8e71-478973501b66, 'Excellent, rien à reprocher, on s''est régalé.', '2016-04-01T11:03:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, e39ac8db-9910-4e21-a82b-e3f9b6f4ec35, 'Très léger. Chez nous comme on est gourmand, c''est 2 carrés de chocolat noir dessert que je mets.', '2015-12-16T17:19:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, e79ca1a7-56b0-423e-abf2-5fb5976701c0, 'Pour ceux qui aiment les recettes LIGHT : je n''ai pas mis de beurre du tout ! J''ai mis 60 g de sucre est c''est très bien. J''ai mis du chocolat noir au centre et du pralin au-dessus. C''était très bon ! J''essaierai avec de la pâte à tartiner aux noisettes la prochaine fois ! ', '2015-10-11T12:38:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 8a0c5de9-0efc-4267-8194-68f561c9a8b1, 'Excellent. Réalisé avec un carré de chocolat dessert au centre de chaque muffin. Mais pour la cuisson 30 min de cuisson sont nécessaires (peut-être mes moules sont-ils plus petits ?)', '2015-07-26T19:29:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, c374d726-02bd-4e80-9001-4a4a86a920fe, 'Facile et très bon ! J''en ai fait avec des carreaux de chocolat noir et d''autres avec de la pâte à tartiner de grande renommée !', '2015-07-02T17:39:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 3701c8d2-1ce8-48b2-9950-0160754c0c65, 'Merci pour cette recette moi je baisse un peu les quantités de sucre et de beurre et j''ajoute un peu de vanille et une goutte de rhum tout le monde adore', '2015-05-14T16:40:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, f05ccc61-90ed-4e48-953e-e49f9ff5bf0a, 'A la place du carré de chocolat j''ai mis des pépites, ou une bonne couche de pralin dedans et ça, c''était topissime ! Bonne base pour tout muffin. Pour qu''ils lèvent un peu plus, j''essaierai de battre un blanc en neige la prochaine fois, et j''utiliserai de la levure de boulanger.', '2015-03-14T12:52:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 758833ae-5994-4f8a-9c09-885daa5e9374, 'Quel succès enfants, famille... Tout le monde veut la recette après les avoir dévorés !!! Très bons ', '2015-01-04T21:01:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, c8f28d8c-00c5-4583-a492-ca653ee6738c, 'Excellent ! J''ai utilisé du chocolat noir 70% au lieu du chocolat au lait. Les carrés sont fins donc le chocolat fond bien...      ', '2014-10-27T00:53:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 7d2d1467-5608-447b-bfc0-df93472b13b3, 'C''est devenu un classique... Tout le monde adore ', '2014-10-14T23:14:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 21191933-15a7-453c-87b2-f3b407be6824, 'Très bon, j''ai utilisé du chocolat noir pâtissier et les muffins ont fait l''unanimité ! J''avais fait le choix de les cuire à peine moins pour pouvoir les emporter et les passer quelques minutes au four juste avant le dessert, le chocolat était fondant juste comme il faut. J''ai aussi suivi le conseil et ajouté un peu de rhum. ', '2014-05-17T14:50:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, f032dd3c-27c2-44d3-96bb-5fc9d7db52d2, 'Excellente recette, très simple et délicieuse ! Réalisée lors d''un pique-nique, ces muffins ont fait l''unanimité.', '2013-07-29T23:51:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 91d1dde9-558b-40dd-92dd-bc674541156f, 'Délicieux ! J''ai remplacé la farine de blé par de la farine de sarrasin pour en faire une recette sans gluten! Le chocolat fond après cuisson mais durcit après, moi je les conserve au frigo et les passe 20 sec au four micro-onde avant de les dévorer. C''est parfait, ils sont tout juste tiède et le chocolat est dégoulinant.', '2013-07-10T13:55:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 3f8862ac-8888-47c6-a05c-1ea8b5a83e23, 'C''est vrai que le chocolat ne fond pas!!peut être utiliser du nutella ! Le goût était là ! Les bananes bien mûres, y''a pas mieux.', '2013-03-30T14:26:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 5563dc8f-c8a8-459d-8aa7-c2666808ad61, 'Carrément délicieux, super et très réussi, moi j''ai ajouté un peu de rhum avec les bananes pour plus de goût.', '2012-11-18T20:13:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 0116c284-c48b-47f1-81ec-5261c06b8396, 'Facile et délicieux.', '2012-10-20T21:50:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, eb97642a-a6d9-4b6b-bc54-cf24e2f35b80, 'J''ai mis de la pâte à tartiner à la place du chocolat, et c''est tellement bon que j''augmente les quantité à chaque fois et pourtant il n''y en a jamais assez tout le monde en redemande ', '2012-08-14T20:23:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 7e8cdaea-ca97-45cc-946b-2c52a4e669f0, 'Trop bon, c''est devenu un de mes classiques, accompagné d''un coulis de fraise et d''une boule de glace à la banane, c''est un régal !', '2011-11-15T20:53:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, d26e9618-f30d-4fea-96a0-a00f3d8f5482, 'Facile à réaliser et moelleux. Même la pâte crue fut un vrai délice.', '2010-12-04T11:15:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 8fef437f-d31a-4811-a481-51b7ec461489, 'C''était délicieux (et je ne dis pas ça parce que c''est moi qui les ai faits!). J''ai juste mis 2 bananes et 1 sachet entier de levure pour 6 muffins (sinon je trouve que mes muffins ne lèvent jamais assez). J''avais un chocolat pâtissier aux éclats de noix et c''était très bien comme ca !', '2008-09-18T00:13:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 26ceb4ff-44e4-4e65-8047-73f46bcdfd79, 'C''est un pur délice! Ils étaient parfaits! Bien gonflés, jolis et surtout délicieux! A la moitié de la pâte, j''ai mis une rondelle de banane, au lieu de les écraser, et le carré de chocolat(noir). Merci pour cette recette, ça a été un grand succès pour moi!', '2008-09-05T14:19:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, c78465b9-1384-43f1-93c3-03978eb7d7c2, 'Le goût est bon, mais ce ne sont pas des muffins, ils ne gonflent pas et ce n''est pas la texture, le chocolat ne fond pas, c''est vraiment dommage, recette que je ne retiendrai pas.', '2008-09-02T12:49:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68111, 83a8a213-20fd-443e-bf3c-58c6f73b5686, 'C''est très bon et simple à réaliser', '2008-03-22T14:18:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (232347, 740ab17f-a4cd-4310-96ce-0f52ef82326d, 'Delicieux, facile à faire. Le plus difficile c''est d''attendre !', '2020-08-30T14:18:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (232347, 31f06bb1-043f-4f4e-94ec-c3b9b3d238a1, 'Recette testée et offerte en cadeau pour diverses occasions après 3 mois de macération. Aujourd''hui des amis me donnent des bouteilles de rhum pour que je leur rende en rhum arrangé, selon cette recette. ', '2014-05-06T22:59:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (232347, e3534ff0-0365-47df-801f-b28f7a86bfa4, 'Très bon mais j''ai utilisé du rhum un peu trop fort. Je prendrais plus doux la prochaine fois !', '2020-04-13T18:13:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 23f53a37-1a9b-44a7-8215-8a783acae32d, 'Très bon mais je mets moins de sucre. Je mets la rhubarbe, les bananes et le sucre à macérer sans oublier le jus d''un demi citron !', '2013-09-14T16:20:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 2fbc7b63-2d9e-4f07-abea-812d73c712f0, 'Mettre moitié moins de sucre et moins de banane. ', '2012-12-23T20:41:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 64a78750-41be-4aaf-ba6e-486864b9347f, 'J''adore, merci
', '2023-05-24T12:09:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, fd3e2d74-63d5-4e2b-b1fa-60ca347a56bb, 'Excellent. La banane casse l’acidité de la rhubarbe. Je n’avais que 300 gr de rhubarbe et une demi banane et j’ai mis 150 gr de sucre. C’est largement suffisant. ', '2018-04-29T04:50:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, b6250487-d9c2-4763-a2a8-f4ca91785cc2, 'Troisième recette de confiture réalisée grâce aux recettes Marmiton. 5 M attribués. Pas déçue... Vos commentaires m''ont été précieux. J''ai utilisé 400 g de sucre pour 1 kg de rhubarbe et ajouté 2 bananes. Le goût acidulé de la rhubarbe se marie parfaitement à la douceur de la banane. Merci encore...', '2015-05-03T12:18:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 1a6a2fde-81a9-4c38-aa13-0e134b967e0a, 'Excellent ! voici 3 années que je la prépare (avec en effet quasi moitié moins de sucre) et je régale tout mon entourage à chaque fois !', '2014-05-31T19:14:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 8ab40b8b-4c3b-4307-b317-63e08c7bd7ea, 'Un pur délice cette confiture ! J''ai mis la moitié de sucre et c''est excellent ! J''ai fait aussi un essai pour un pot, en ajoutant la petite touche de rhum brun juste en dernier dans la casserole, c''est fabuleux ! Le goût rappel un peu la banane flambée.  ', '2013-09-25T19:11:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 4b49979b-e772-4ab7-83f2-777a182f1305, 'J''avais déjà testé cette association pour des crumbles : miam ! Je me suis donc lancée dans la confection de cette confiture en mettant seulement 700 g de sucre et une seule banane (je trouve que sinon, la banane domine trop la rhubarbe). C''est vraiment excellent ! Autre variante testée : ajouter une cuillère à soupe de rhum en fin de cuisson dans la marmite : beaucoup de succès auprès des goûteurs (adultes évidemment !). Merci pour cette délicieuse douceur acidulée !', '2012-09-14T19:37:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 6b30e3f4-f5da-4b80-bfa0-ddd7b0d87092, 'Très bonne association des fruits, ça enlève l''acidité de la rhubarbe, un vrai régal !!!', '2012-08-14T14:36:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 68e21465-7c03-41c0-8d47-051576a252f4, 'Très, très bon. Pour 1kg de rhubarbe épluchée, je n''ai mis que 500 g de sucre et 2 bananes moyennes car j''aime le goût acidulé de la rhubarbe.', '2012-05-27T00:38:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 37e96ed5-7177-4fe0-ab72-be53876689a9, 'Comme beaucoup de monde, j''ai réduit la quantité de sucre (je n''en ai mis que 700g pour 1kg de rhubarbe), la banane étant un fruit déjà très sucrée... et puis j''ai ajouté le jus d''un citron, cela évite que la banane noircisse et la confiture prend mieux !', '2011-10-07T19:13:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, dc77be92-7e97-4ab1-8902-a02a8b8aa936, 'Facile à faire mais un tout petit peu trop sucrée à mon goût, elle reste originale...', '2011-09-08T13:48:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, f915d1b8-3ec3-4c20-b88d-1c548d92a195, 'Bonne confiture et facile à réaliser. Toutefois, j''ai mis 500 g de sucre et c''est bien assez suffisant. A refaire mais avec un peu moins de banane.', '2011-07-29T13:45:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, f17217a5-a183-4f89-a8ed-6562071ce70b, 'Même mon mari qui n''aime pas la banane a trouvé cette association particulièrement savoureuse ! Par contre, un peu trop sucrée à notre goût. J''avais réduit à 800 g de sucre pour 1 kg de rhubarbe mais les bananes étaient assez mûres. Grand merci pour cette recette délectable ! Pour le coup, j''ai une liste d''attente...).', '2011-07-14T00:54:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 50b8b3bd-348e-4a37-b6ec-c0248621889d, 'Délicieux, facile à faire, très très bon !', '2011-06-18T01:05:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 7725a2e6-5210-44c6-a432-797bcb422ee7, 'J''ai ajouté de l''agar-agar (2 petites cuillères rases) car nous n''aimons pas la confiture qui dégouline de la tartine : c''est super bon', '2011-05-12T23:01:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, b345ebe4-5c23-4420-81b8-400719d261c0, 'Facile et délicieux ! Que demander de plus ?', '2010-07-20T10:44:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 1eeeacde-b0fe-43f9-969e-ff1363934e82, 'Lorsque je fais cette confiture de rhubarbe, ou rhubarbe- bananes, je mets toujours 750 g de sucre pour 1 kg de rhubarbe; si je rajoute des bananes, je ne rajoute pas de sucre, les bananes étant bien sucrées. Elle est toujours excellente !', '2009-06-03T17:18:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 2b12825b-afc5-4562-903d-001d58b7c46c, 'Excellent, le contraste entre la douceur de la banane et l''acidité de la rhubarbe!  J''ai mis une banane de plus, et j''ai utilisé du sucre gélifiant spécial confitures.', '2008-09-16T00:09:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 7f2468ab-de3c-4d69-9935-abd8152a9e73, 'Très bon dans un yaourt nature. J''y ai mis moins de sucre et de l''extrait de vanille.', '2008-07-02T17:17:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 7e3b5c11-39f2-4ee9-9151-a33f1d18b2de, 'Miam miam miam, très bon!!!', '2008-06-27T16:10:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 072d598b-376e-46fe-be9f-11e3d921946b, 'Vraiment bon, simple à réaliser et les enfants apprécient aussi, donc que du bonheur!', '2008-06-25T18:10:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, a595cdec-693c-4b88-a485-019a55f602e0, 'Très bonne confiture mais la cuisson a duré au moins 40 min', '2007-08-10T18:10:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 89321b95-ad5d-4813-87fc-4c90eeba0fd8, 'Très bon et très facile. Cependant, cette confiture peut paraître encore un peu acide pour certains quoi que ne manquant pas de sucre, mais cela doit sans doute être une constante de la rhubarbe.', '2006-06-20T21:07:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 9243dbad-6471-403a-ab50-1bcb5c1b184c, 'Une très bonne confiture. J''ai rajouté 2 pommes + j''ai laisse mariner les bananes dans du citron + 1 cuiller à café de cannelle en poudre. Par contre il fait plus de temps pour la cuisson.', '2006-02-02T19:00:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 1a584c6a-33ea-48b8-b374-2ec800d5acc1, 'J''ai suivi les conseils d''Audrey (moins de sucre et avec des oranges) et c''était excellent. Par contre le temps de cuisson est plus long que celui indiqué.', '2006-01-16T19:41:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 57ee40b2-6ace-45f8-9409-33c2e938176a, 'Moi j''ai adoré et j''ai même mis un peu plus de bananes parce que c''est le goût que je recherchais. Par contre on peut réduire un peu le sucre effectivement, mais de toute façon c''est de la confiture ;)', '2005-08-29T22:46:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 3457c851-19e5-4f08-8515-a4a2385112e0, 'Excellent!! Rien à redire! ', '2005-08-10T13:53:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 9db3157c-2ccd-4187-9e11-fcfc2f8cd388, 'Un vrai régal...rien à ajouter, c''est Top!', '2005-06-04T13:36:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 38f74024-49ec-4996-a077-0c7130ccc2cc, 'C''est excellent, rien à redire. ', '2005-06-04T12:17:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 86166a8c-8bca-48e2-ad2e-5454fc64acd1, 'Un peu trop sucrée. Sinon, elle est excellente avec seulement 800g de sucre et 300g d''orange. Les pots partent à une vitesse folle...', '2003-08-27T19:19:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 67d73f5b-0b6e-4491-bcf5-400e49d71e26, 'Avec moins de banane (200g) et un zeste de citron, cette confiture se mange à la petite cuillère!', '2003-05-24T20:09:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 173d031f-7b6b-471c-940c-b599bca53889, 'Désolée dêtre si dure, mais c''est une horreur. Ecoeurant!', '2003-04-28T10:01:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 95703778-9950-49e6-b114-46f5c0b555c2, 'Bon, mais meilleur avec moins de bananes.', '2002-10-09T12:17:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16845, 83441448-d249-4ab3-b04e-5b6b7f989bfa, 'Excellent.', '2002-05-10T23:37:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, f28aeb3f-f39d-4b91-b89b-492cefcc1aab, 'Super recette! 
Je craignais le rhum + la cannelle + la vanille mais au contraire l’ensemble fonctionne très bien!
Et tremper au choix dans la noisette ou la noix de coco… Rien à dire… merci…
J’ai varié les fruits frais et n’ai pas fait avec les fruits secs mais seulement parce que je n’en avais pas; je suis sûre que ça marche parfaitement ', '2023-05-10T17:48:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, b2fa9359-779b-4156-950b-700f4811f50c, 'Excellente ! Juste mis une noisette de beurre au vu des commentaires précédents, pas de crème (j''ai oublié !) ni de rhum ni de vanille. Par contre j''ai mis plus de lait (pour compenser l''oubli de crème). Je garde précieusement la recette. Merci.', '2016-11-20T13:47:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 3d144c04-3572-46d1-9a8a-ddf34d38983f, 'Beaucoup trop de beurre et de crème :( Dommage. Sinon bonne recette.', '2023-01-12T22:24:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, b9c457bf-6295-40e0-b49f-9b3900c178c7, 'Super recette !!! Pour ma part j''ai ajouté plus de cannelle pour donner plus de goût, c''était excellent. !! J''ai également enlever 5g de beurre !', '2021-12-19T21:13:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 9d2def9d-3b4d-435c-94c2-4c0a3249a6c5, 'Merci pour l''idée de la noix de coco et des noisettes ! On place aussi sur la table de la poudre de spéculoos et ne mettons pas de cannelle dans la sauce. C''est le dessert de l''année 2021 chez nous !', '2021-05-08T09:31:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 1fb4d009-86b5-4f96-8ba0-367098230c32, 'Tres bonne recette', '2020-04-19T18:53:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 8ce4aba1-ca00-47e3-b207-9629ebbee294, 'Impeccable très bonne recette. Chocolat de texture parfaite. Je fais fondre le chocolat au micro onde comme pour la mousse au chocolat. A refaire', '2019-11-17T00:52:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, dbfb9660-dd9f-48d0-a950-c6dd6e68d248, 'J''ai mixé les 3 recettes trouvées sur Marmiton : fraises, framboises, kiwi, poires, ananas, dates, figues, chamallow, brioches, pralines, coco. J''ai fait fondre le chocolat au micro-ondes, il m''a fallu plus de 4 min, j''ai mis 4 cuillères à soupe de lait, 1 pot de crème fraîche de 20 cl à 15% et 25 g de beurre. Excellent. je le referai sans la brioche.', '2016-03-27T13:22:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, ed1d6d3d-f475-42f9-8ec5-329fc0e93575, 'Très bon.', '2016-02-28T19:38:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 0de2bc39-8efe-4ee2-94a2-f6a9146988a3, 'Excellent', '2015-03-19T22:04:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, fa33f019-e0bf-4226-95af-1c2584857a82, 'Très bon avec du bon chocolat, manquait un peu de sucre pour ma fille !', '2013-09-29T10:56:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 5a1b3a87-b8eb-487f-b3c5-a710b2deaf27, 'Très bon mélange :)', '2013-04-21T15:51:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 3acaaa4b-5070-42b2-aa16-83efdfb9c808, 'Très bon. Je n''ai pas mis le rhum. Toujours aussi bon le lendemain !!! A refaire', '2013-02-16T13:58:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 245c134e-f31a-4197-b50d-1d31c37ba85c, 'Excellente recette mais 40-50 g de beurre, c''est largement suffisant.', '2013-01-19T19:52:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 7812201b-ae97-4c63-bb52-1400b295490b, 'Super recette ! Nous nous sommes régalés ! ', '2013-01-01T18:17:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, aa76a9f6-7612-436b-900b-edc47c6202c4, 'J''ai utilise du chocolat noir 72% et mis 50 g. de beurre et pas de rhum. Délicieux !', '2012-10-20T23:58:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 57080adf-8260-49f5-a337-ab34003b14dc, 'Parfait ! J''ai suivi les conseils et je n''ai mis que 25 g de beurre ; par contre j''ai ajouté 75 g de chocolat noir citron-gingembre qui parfume très agréablement et j''ai supprimé le rhum.', '2011-04-02T19:26:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, a2904604-dbb3-4775-85b2-3a02f2390fa3, 'Pour Noël, une délicieuse recette. Tout le monde a aimé. Cependant, je n''ai pas mis de beurre.', '2011-01-15T13:06:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 7922acd4-1a60-4a34-a0b2-311d28ecae4a, 'Délicieuse recette, chocotat fondant et onctueux. Toute la famille s''est régalée. J''ai juste diminué la quantité de beurre à 25g.', '2010-12-26T15:09:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 292bc43a-02d5-4afb-b98c-0b2e39f6e83f, 'Une bonne recette, qui contient toutefois trop de beurre, mais sans plus.', '2010-08-27T13:41:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, d37f57e9-f324-4c7c-8a34-956d9f7696e1, 'Petit dessert de la Saint Valentin , on a adoré ! j''ai suivi la recette à la lettre sauf pour le beurre que j''ai tout simplement... laissé dans le frigo ! et rajouté un peu plus de lait pour la consistance. Et je verrai les proportions à la baisse la prochaine fois ! Régalez vous !', '2010-02-14T22:30:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, a0a62fe5-663c-4476-bece-8f15d2dca499, 'Très très bon. On y a plongé des petits cubes de brioches et des marshmallows en plus. A refaire sans problème.', '2009-12-13T22:51:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, c2be96b8-4a1c-4923-93b3-ad9ae7266d70, 'Fabuleux !  Dessert adoré par tout le monde !  Par contre, ne pas mettre trop de beurre (20g pour moi seulement et encore je songe à ne pas en mettre du tout la prochaine fois)  N''hésitez pas et prenez cette recette les yeux fermés.', '2009-11-09T15:17:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, f519fd44-1364-478e-9fe0-3f0c4b4c136b, 'Pas de vanille, pas de cannelle, pas de rhum, pas de beurre, et pourtant c''était très bon avec des fruits d''été... mais très copieux ! Attention aux proportions, mais régalez-vous quand même !', '2009-08-25T11:14:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, ad9abc2c-c633-4866-93c5-dd336cbcd11e, 'Très bonne recette, mettre moins de beurre, mettez ce qui vous fait plaisir dans les coupelles, petits et grands vont se régaler. ', '2009-07-16T19:58:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 73f4aeda-4c07-4316-a90a-189e15c329f8, 'Très bonne recette mais la prochaine fois je mettrai moins de beurre car au bout de quelques temps, dans mon caquelon, le beurre ressortait à la surface du chocolat. Merci encore pour cette recette que j''ai testé pour mon dessert du repas de Pâques.', '2009-04-12T22:13:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 1e11b0ce-13b6-46a7-aca0-f2b2d944e065, 'Pour une première c''était très réussi ! Je n''ai mis que 40 g de beurre et la prochaine fois je n''en mettrai que 25-30 g! Pour l''accompagnement, on a pris: chamallow, fraises tagada, fraise, orange, banane, pomme, noix de coco râpée. Hmmmmmm!!', '2009-04-05T15:28:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 30722fd4-96ec-4cd0-acd0-9807dc3b36ec, 'Super recette, je n''ai pas mis le beurre mais un peu plus de crème. On s''est régalé, à refaire sans hésiter', '2009-04-04T23:09:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 4c74b5f7-73b2-4f10-8a97-68976ec47eda, 'Je cherchais une bonne recette pour fondue au chocolat, je l''ai trouvé! Seulement, je n''ai mis que 25g de beurre, et pas de rhum mais sinon tout pareil. Merci pour cette recette, c''est un délice !', '2009-02-14T20:32:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 3434a185-c6cd-4a93-b2c4-0f3cb21451d2, 'Sublime, j''ai fait des heureux. Toutefois j''ai remplacé le beurre par un supplément d''un peu de crème fraîche liquide. Merci pour l''idée.', '2008-12-28T18:18:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 88cd7da3-f935-4138-9b12-429a917fafb5, 'Super recette : mes invités ont été conquis! J''ai servi la fondue dans des petits pots individuels avec des brochettes de fruits : ananas, bananes, clémentines, abricots secs et j''ai ajouté des petits biscuits made in Marmiton : biscuits aux pistaches, amarettis et cookies au chocolat blancs. Le tout en version mini c''est top!', '2008-11-13T13:47:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 3ed5e96d-01a9-479b-a402-0976a3a890f3, 'Très bon. Super réussite, il n''en restait plus une goutte. Plait aussi bien aux petits qu''au grands. Ne pas faire un repas trop copieux avant.', '2008-11-05T23:51:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, ee96a017-6ac1-4185-ba85-d944275c2a96, 'C''est excellent, perso j''ai mis la moitié du beurre. Je l''ai servi dans des verrines individuelles avec des brochettes de fruits, c''était top.', '2008-08-18T22:06:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 36be6fde-587d-481b-9965-44b0933e91a9, 'Un dessert gourmand parfait pour ma première fondue chocolat. Et c''est super bon, c''est assez léger finalement avec les fruits, je pensais que le chocolat serait plus "lourd" sinon petite astuce: en achetant le chocolat je suis tombé sur du chocolat dessert Poulain spécial cuisine intitulé "la pralinoise", j''ai fait ma fondue avec et c''est succulent essayez vous verrez ;)', '2008-05-31T23:00:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 70915c82-73a5-4930-b38a-e76eb7de3696, 'Testée au moins 3 fois, j''ajoute sans cesse des tites choses gourmandes tel que le praliné en poudre, la noix de coco râpée, l''amande en poudre, des bonbons, bref, les petits et les grands se régalent les yeux et les papilles ! Merci', '2008-04-17T10:05:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 3d84239b-be16-49b8-9f82-ca364b378dcf, 'Très bon mais rajouter des fruits comme framboise ou fraise. Les marshmallows : très bonne idée!', '2008-02-02T11:46:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, a9400f0d-2d2a-4409-8b72-025720c8a8ce, 'Mes invités et moi nous sommes régalés.  La pointe de cannelle parfume et s''intègre parfaitement à la préparation. Merci pour cette recette!!', '2008-01-02T00:09:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 228ef8ef-ab87-45a6-9c75-ce109cfaa904, 'Vraiment délicieux, j''ai fait cette fondue deux fois comme dessert pour le réveillon de Noël et cela a été un succès chaque fois! Même ceux qui n''ont plus faim en prennent! Par contre, je ne mets que 40 g de beurre, et les fruits secs n''ont pas rencontré beaucoup de succès.', '2008-01-01T21:03:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, ba7956ea-22b2-4034-89d8-718d87d7bd38, 'Très, très bon à faire et à refaire, les invités ont adoré surtout les enfants.', '2007-04-04T10:35:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 2fc0983d-1562-408a-8421-38d50db8712d, 'Délicieuse recette. Testée sur 4 ados, elles se sont régalées! Je n''ai pas mis la cannelle ni le rhum pour elles, mais la prochaine fois je ferais la recette complète. Je garde également l''idée de cette recette pour les glaces.', '2007-03-29T20:20:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, a739182b-fa44-45d3-b6f4-6c8aac8f4ba3, 'Inratable. Je l''ai faite avec des fraises, des fraises tagada, des pommes, des raisins, des bananes...', '2007-03-26T00:37:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, d4f68c8f-7fb6-4b8e-bdfb-f9179d0b4b66, 'Comme nous sommes gourmands, je l''ai faite en plat principal avec une multitude de fruits : ananas, banane, poire, mangue, kiwi ... J''ai donc doublé les proportions, et il n''y a pas eu de reste. A refaire.', '2007-03-05T21:20:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, afc6a48c-5f0e-407a-94dc-2f4702e16312, 'Recette parfaite, rien à dire, tous mes amis ont aimé. Je la conseille...', '2007-02-15T17:26:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, e977fd81-18b6-418f-a6d4-a7a3c9617ae9, 'Délicieux, très léger, mettre la moitié de beurre, cela suffit.', '2007-01-08T18:17:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 519fdc34-82f1-4281-8193-77ce904416e2, 'Recette testée le 31 décembre pour 12 personnes avec des kiwis et du quatre quart. Résultat... Il n''en ai pas resté! Un régal pour petits et grands.', '2007-01-02T17:04:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 949ac5d6-625d-41aa-a867-c005b24246b8, 'J''ai fait le double de la recette pour 10 personnes mais il y avait trop de beurre, c''est remonté à la surface!!! Mais bon quand même!', '2006-12-23T10:13:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, d4a9e99d-9d56-4d1d-b530-f53ba0751cd7, 'Fantastique. J''ai réalisé ctte fondue pour mon anniversaire et je ne sais pas quel gôut elle a, mais mes invités ont plus qu''apprécié ! Ils se sont jettés dessus! A refaire pour moi cette fois!', '2006-10-23T23:49:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 12e74881-de6e-40fc-9bd0-3faa9d14760a, 'Délicieux et original, mais la prochaine fois j''évite le beurre!', '2006-09-02T21:10:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 9c9ec2a2-4334-456d-9013-2147a21dad25, 'Cette recette est PARFAITE tout simplement, les proportions, le goût, la facilité... Tout le monde a adoré, même ceux qui soit disant "ne sont pas chocolat". Il n''en est pas resté une cuillère!!! En plus, c''est très ludique et très convivial!', '2006-04-07T21:12:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 596681de-3177-46ab-8f00-b041bdb3a3c5, 'Merveilleux dessert!! J''ai rajouté du kiwi et de la pomme et quelques gourmandises supplémentaires, à tremper dans le chocolat : morceaux de brioche et de gaufre liégeoise, petits choux natures faits maison. Délicieux! ', '2006-03-14T16:15:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 46f1dbf3-1d83-454d-b2c6-3c4f9fb0eb87, 'Rien à dire, c''est "un délice". Merci pour cette super recette!', '2006-02-26T21:17:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, c4b48f46-6a76-4ba4-95d3-cc393f0bf91c, 'Excellente recette, c''était ma 1ère fondue, j''avais peur qu''elle soit écoeurante et bien pas du tout. J''ai mis aussi des fraises tagada. Divin pour les amateurs de chocolat. Merci ! ', '2006-02-19T18:04:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 8bb96b2f-e614-4b15-a094-0090b419c030, 'Il est regrettable de ne pouvoir metre 6/5. Je me suis régalé et mes amis aussi. Surtout testez cette recette "ELLE VAUT LE DETOUR!" Merci pour cette aussi bonne recette de FONDUE AU CHOCOLAT.', '2006-02-12T18:26:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 4a7678ba-5690-4dbc-92da-070a3e2b5dcf, 'Parfait!!! Les proportions sont parfaites, on s''est régalé! Je n''ai pas mis de beurre, ni de ruhm! Je vous conseille cette recette! La mangue, les marshmallows... c''était délicieux; et la banane avec la noix de coco... HUMM!!! Essayez aussi avec des meringues, c''est pas mal non plus!!!!!', '2006-01-03T21:36:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 91b3fc5b-7d8d-4290-b5a1-a3db8e24e4f1, 'Délicieux, la consistance est parfaite et le chocolat reste bien sur le fruit. Un vrai régal très convivial. A faire et à refaire.', '2006-01-03T17:59:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, cb338d37-81f8-4594-9a64-83d415c3d9dd, 'Des proportions parfaites pour une recette exquise! L''idée des chamallows est bien trouvée. Je conserve précieusement cette recette!', '2005-11-26T20:40:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 599c899a-b4f4-428f-a0d1-6ce2b7d586d2, 'Délicieux! On peut utiliser toutes sortes de fruits: pommes et mangues par exemple sont les bienvenues.', '2005-11-25T12:19:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 0c11bbdc-477d-4070-86b5-96d4bb06cc00, 'Excellente sauce au chocolat, mais j''essaierai sans le beurre la prochaine fois!', '2005-11-21T19:11:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 2175c989-da0f-4b1d-bb62-3b5b1d6ac9da, 'Un régal...pour les grands et les petits d''ailleurs! Surtout la poire, la banane et les fameux chamalos ! Je suis sûre de faire plaisir une prochaine fois ! ', '2005-10-04T15:23:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12207, 2cea561a-ded6-40bf-ba06-645cdeb35261, 'Une recette facile, mais tellement bonne! Mes amis, mon mari, et mes 3 enfants de 14, 8 et 3 ans, se sont tous jetés dessus!', '2005-10-01T20:27:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338375, fd8e6305-485c-47ab-b269-80f91fe5dc06, 'Gâteau aussi beau que bon... réalisé avec un grand cercle à pâtisserie pour un seul grand gâteau. Ça marche aussi et c’est plus facile pour le démoulage. Recette suivie à la lettre avec du caramel mais j’ai adapté le nombre de bananes.', '2020-11-03T20:03:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338375, ec0d12da-9a0a-439a-8aa2-b67e045c99cc, 'C''est pas mal. Bon je n''ai mis que 125 gr de speculos (pour 4 cercles), que 2 feuilles de gélatine et tout le pot de mascarpone (125 g).
Le reste j''ai suivi. Le tout est pas mal sucré quand même. J''ai eu du mal au démoulage. ?', '2020-02-20T10:06:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 738ff7a9-af4e-4976-a744-6fd40276e538, 'J''ai fait pour une quantité de 6 pots de confiture remplie ! 10 pommes, 6 bananes, cannelle, 1 sachet sucre vanille, 1 cuillère d''arôme vanille suffit 🤤', '2022-06-12T10:54:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, f0176a79-7dd0-4370-9c6a-3b9919cada81, 'Très bonne recette, j''ai mis 4 pommes et 2 bananes. 2 sachets de sucre vanillé sont largement suffisant, pour ma part 30 min de cuisson sont suffisantes. Petit passage au blender en dernier lieu pour une compote bien onctueuse.', '2019-04-29T15:04:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 1bd279ae-259e-4ce3-b6fd-dfdbec0b9b76, 'Savoureux avec pommes reinette.', '2022-09-21T16:38:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, fcaf1ce3-113e-47e2-980f-6b7fd523cf29, 'Si on suit la recette, la compote est trop sucrée.', '2020-04-12T15:31:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 6bf59fb8-bb8c-45ff-8949-b2a1b9946727, 'Super recette ! Facile à réaliser (c''est bien pour moi...) et super bonne, ma fille et moi avons adoré ! Je referai avec plaisir.', '2017-01-16T17:37:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 73c9d45c-879b-42d4-af39-a374622fe6b7, 'Simple et très bonne recette !! 2 sachets de sucre vanillé sont suffisants pour 6 pommes et 3 bananes !!', '2014-10-07T17:42:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 9e07c3f2-26b1-4f8d-b9bd-1f25a25a3fa9, 'Pour moi sans sucre et beaucoup de cannelle ', '2022-03-31T14:49:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, b4c73216-bfb1-45f8-b4c6-acb13d509f3e, 'C’est excellent ', '2022-02-16T21:35:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 4ff3d567-6075-4fd7-92ad-c0136b642241, 'Recette parfaite ! :) ', '2020-10-18T09:15:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 86463867-b910-4234-9609-12f1eda3e44a, 'Très simple et délicieuse', '2020-10-05T19:52:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 125ed50e-d61d-4efd-8a74-9b0c13483ed4, 'Super recette. Fruits bien murs donc très sucrés, je n''ai pas eu besoin de rajouter de sucre. J''ai ajouté de la cannelle et mixé le tout.', '2019-04-16T11:51:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 873481d6-8937-4e00-8244-dec942e53dd7, 'Bonne recette, j ai mis une banane, une poire une pomme, un paquet de sucre vanillé, et de la cannelle, assez sucré pour moi.', '2019-03-24T21:17:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, ef0c1c31-42e5-45a2-a5d6-98e4803c3446, 'Nickel, si la compote est trop liquide il faut la laisser sur le feu, l''eau va s''évaporer.', '2017-01-20T00:35:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 51b5ca47-95ed-417c-a8d1-31e61bbd47af, 'Très déçu de la recette...j''ai mouliné les fruits et ça a donné de la soupe (liquide) je ne referai pas désolé !!!!!!!', '2016-04-12T21:44:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, e6786900-6d1c-4fe5-aa07-a376f8b2769c, 'Très bonne. J''ai utilisé 6 petites pommes et 2 bananes et seulement 2 cuillères à café de sucre vanillé et à mon goût il n''en faut pas plus. ', '2015-12-10T18:54:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 14877e8a-9e62-4b5c-aa2a-f73bee4ed107, 'Je referai ces compotes, c''est délicieux! J''ai utilisé 5 petites pommes qui commençaient à mal vieillir, et je n''ai mis que 2 sachets de sucre vanillé mais je trouve que c''est encore trop. A tester avec un seul sachet :)', '2015-12-10T18:15:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 5156b723-07db-490b-aa0c-1b5a54ae1205, 'Trés bonne compote, mais j''ai doublé la quantité de pommes et de bananes mais pas celle du sucres vanillé, c''est parfait, par contre 3 sachets pour seulement 2 pommes et 1 banane me semble enorme', '2015-11-19T22:14:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 74d96087-1391-4155-9061-32677bc193ef, 'Très bon, un bon accord entre la pomme et la banane ! A refaire  !', '2015-06-19T18:21:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 641e105f-b625-4e6a-8c72-60a87c0ab7ce, 'J''ai ajouté un jus de citron, de l''extrait de vanille et mis seulement une cuillère à café de cassonade pour 6 pommes et 4 bananes bien mûres ! Je l''ai blindé ensuite pour une compote lisse... Un régal, même tiède.', '2015-01-18T17:26:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 5135da13-6c67-410c-86ae-ae50d9a3caaa, 'Tout simplement parfait, il me restait 5 pommes, 5 bananes que j''ai mis à cuire 1 heures avec juste un sachet de sucre vanillé. On mixe le tout et c''est prêt à déguster. Miammmm', '2014-10-25T20:01:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 39dd001b-4f21-4d11-9d40-a4f7a512b4c5, 'Simple et vraiment bon ! Les proportions sont parfaites, j''ai tout de même mis beaucoup moins de sucre (1 cuillère à soupe) et c''était amplement suffisant. J''ai rajouté un peu de cannelle pour plus de goût !', '2014-07-21T21:19:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, b42299e9-f25c-48ac-a229-d85da319e15d, 'Chez nous, il s''agit d''un dessert pour 2 personnes et je confirme un sachet suffit. Très facile à réaliser.', '2013-06-04T11:32:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, c9472519-c444-4758-942f-79f3b2834179, 'Très bon mais à faire avec un seul sachet de sucre vanillé. La proportion 2 pommes/une banane est bonne.', '2013-04-16T18:11:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, c20cad4f-70a0-484d-8fcd-c27b6c2b3c91, 'Recette effectivement très simple pour mes maigres connaissances en cuisine étudiante. J''ai mis 3 pommes et 2 bananes. Cependant, je ne mettrai plus 3 sachets de sucre vanillés car c''était trop sucré à mon goût. Le résultat reste néanmoins très convaincant et n''a tenu qu''un repas !', '2013-03-23T10:49:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, c078826a-3ea2-4744-beeb-fc9f503b2a66, 'Super bonne ! Mais juste un sachet de sucre vanillé pour 4 pommes et deux bananes.', '2013-01-11T21:35:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 38f02284-e050-447a-9c47-c51a8c62e00d, 'Légèrement trop sucré à notre gout sinon recette facile, rapide et c''est tellement meilleur que celles du commerce.', '2012-07-09T19:45:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, e30fb356-d885-4ce3-883f-cf2474d09b30, 'Très bon. J''ai fait avec 2 pommes, 3 bananes et j''ai ajouté des pruneaux : excellent ! J''avais mis 1 seul paquet de sucre vanillé mais la prochaine fois je n''en mettrai pas du tout car les pruneaux sucrent suffisamment.', '2012-02-18T20:10:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, f6bbb5de-7507-44d5-a6ca-7671954b27f8, 'C''était très bon, et très simple à faire ! Merci ! ', '2011-09-14T15:57:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 1444b4ef-acc2-48c9-90fa-c774a5f548ba, 'Très bon mais j''ai mis 1 sachet de sucre vanillé et 1 cuillère à café de sucre normal plus un tout petit peu de cannelle.', '2011-07-09T15:18:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 5894f31e-2d1f-4b31-9ad0-4d0975f934f5, 'Facile. Simple. Mais léger pour 3 personnes.', '2010-05-03T20:26:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 0a93d78b-9293-475c-bd62-5defbca3f53b, 'Facilissime ! Je n''ai mis que 2 sachets de sucre vanillé et c''est vrai que c''est encore un peu trop sucré, j''ai ajouté de la cannelle et je n''ai pas eu a ajouter d''eau car j''ai diminué le temps de cuisson', '2009-08-26T13:06:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 907cb47e-6517-4b2f-849b-8540865aea40, 'Réalisée en suivant les conseils des autres internautes, soit 4 pommes, 2 bananes, 3 sachets de sucre vanillé, 1/2 cuillère à café de muscade et 1/2 cuillère à café de cannelle. Dégustée avec de la brioche, excellent !', '2009-04-29T16:13:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, ea01debb-e6b7-4efa-b69d-991b7970672e, 'Excellent. Je fais cette recette lorsqu''il me reste des bananes qui risquent de murir trop vite.', '2009-04-05T20:22:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 08438ae3-1393-41ff-b5d7-9547ac8f29dd, 'Très bonne compote. Pour ma part j''ai rajouté le jus d''un citron avant la cuisson.  Un bâton de cannelle et une gousse de vanille fendue, pendant la cuisson! C''est encore meilleur...!!!', '2009-02-18T17:19:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, b20ac1a9-ab66-4c1c-aabc-821855540d7a, 'Très bonne recette, meilleure quand on double les doses, pour éviter de devoir ajouter trop d''eau.', '2008-11-02T21:18:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, be4dcdbc-7f32-4dac-a932-3369c5af32ed, 'Super bonne et très facile à faire car c''est mon fils de 5 ans qui la faite un résultat impeccable. Nous avons doublé les doses en fruits mais pas en sucre donc 6 pommes et 3 bananes et 3 sachets de sucre excellent tiède  ', '2008-10-29T18:44:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 53e3875c-cb89-4232-8ca0-e5bc300d5548, 'Très bonne recette - merci!', '2008-10-24T14:51:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, eac5c166-d605-4e99-8db7-7b773e565ee7, 'Excellent! Très simple et très bon, pour ma part j''ai mis un seul sachet de sucre vanillé ! Encore meilleur réchauffé...', '2008-09-29T20:43:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 41e58b5d-73d2-4f34-b046-6ffe651c4d37, 'Recette et goût original. Par contre, je n''ai mis que deux sachets de sucre et encore j''ai trouvé qu''avec la banane, c''était un peu trop sucré. Mais à refaire avec plaisir.', '2008-05-28T19:15:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, bb437d88-587c-43e3-9a46-7b9b771d1718, 'Pas mal ! J''ai déjà fait cette recette 2 fois ! La compote est délicieuse quand elle est tiède. Par contre, 3 sachets de sucre vanillé me semble beaucoup pour la quantité de fruits. Je n''ai mis qu''1 seul sachet de sucre pour 2 pommes et une banane et j''ai trouvé que c''était suffisant. ', '2008-04-08T00:16:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 24a63809-67e5-4b3b-a0e8-0f32265f26ce, 'Merci Gribs pour cette compote. Délicieuse ! L''avantage d''être très rapide comme dessert, c''est qu''on en mange très souvent.', '2008-03-02T19:14:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 85bab76d-620f-4ded-84e5-63fae5474820, 'J''ai utilisé pour cette recette: 6 pommes et 4 bananes + 2 sachet de sucres vanillé. C''est une merveille et y en a pour tout le monde.', '2008-02-12T20:08:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 49b7531d-5b5e-4f28-94be-e6534c31b595, 'Petit dessert familial très simple et très bon avec un peu de cannelle. ', '2008-02-04T21:44:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, dc17853c-06f3-481c-b3a7-869e3eb36c95, 'Très facile et excellente tiède. Je n''avais plus qu''un sachet de sucre vanillé alors j''ai remplacé les 2 autres par 2 cuillers à soupe de sucre roux avec 2 gouttes d''extrait de vanille et une bonne pincée de cannelle. J''ai aussi mixé à la fin car je préfère la compote lisse. A refaire!', '2008-01-19T17:05:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 054dc41c-a749-4be8-98be-6928b8d0b33f, 'Mmmm... Délicieux!!! C''est parti en un soir ! A refaire plus souvent...', '2007-10-31T19:50:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, df1e3690-f733-4465-906b-4dadbfff7923, 'Assez bon, surtout légèrement réchauffée.', '2007-07-06T18:34:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, fc17eb45-3801-4eed-87a2-53814cb41834, 'Trop sucrée et clairement pas assez pour 3 personnes ! Mais sinon, en adaptant, c''est pas mal : 1 sachet de sucre vanillé, 5 pommes et 2 bananes ça serait bien mieux à mon avis.', '2006-12-01T20:55:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, e482f650-3d9d-4ba5-8c3b-688f18c8c394, 'Vraiment très bon! Je l''ai testée 2 fois, dont une fois en ajoutant des kiwis et ça a été une réussite! ', '2006-11-04T14:31:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 5ffa7cde-2fdf-4a6e-ab68-8d8f032b4aa8, 'Excellent! Facile à faire. Il me restait de l''ananas frais que j''ai incorporé dans cette recette.', '2006-09-30T15:42:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 0be6c567-40d3-462b-bc5d-4c376e50152f, 'Les fruits s''accordent super bien et c''est un délice! A faire et à refaire !', '2006-08-08T16:49:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 8b7e4712-289e-466d-86d4-c54897d5cf9c, 'Très bonne compote. J''ai aussi mixé les fruits à la fin. Je l''ai parfumée d''un peu de cannelle.', '2005-11-03T10:14:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, cbb10f4f-3027-42a3-8c5b-06c488191327, 'Je l''ai faite pour mon p''tit bout de 6 mois et il a adoré. Je l''ai mixé au lieu d''écraser les fruits.', '2005-08-13T18:28:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 248a78ab-87bc-4ade-b954-5c672fb64cbd, 'Très bon.! Et quelle bonne odeur pendant la cuisson! J''ai mixé les fruits cuits au pied à soupe car je préfère la compote lisse (sans morceaux).', '2004-03-19T12:51:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18089, 4ccc965e-5e66-4db7-8302-0b1eedaffca3, 'Un petit délice simple et rapide à faire, mais plus de fruits à mettre!', '2003-11-13T18:08:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44947, 41bdf3ce-2c35-43d3-8252-0a167144a2f3, 'Moi je fais 1/3 de rhum antillais, 1/3 de jus d''ananas et 1/3 de jus de goyave. Un chouille de sirop de canne, de la cannelle et de la muscade. Je laisse au frigo 24h pour que ça imprègne bien et zou !', '2013-01-20T17:20:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44947, 919b55b0-674b-4b54-a84e-73b1e981cf90, 'Moi je mets du rhum ambré et du blanc. Du jus de goyave, d''ananas, orange, sirop de canne, un peu de vanille mais pas d''épices car je n''apprécie pas', '2019-08-17T18:57:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44947, beffc6b7-6cf3-48fa-a1cc-d645a55533e5, 'C''est toujours un succès !', '2018-06-14T21:15:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44947, 3a09b9b2-1fff-41b2-be44-342374572bd9, 'Très bonne recette, je n''ai rien changé ! Il est vrai que, comme le souligne Juany, faire du planteur antillais avec du rhum Charette cela revient à cuisiner une choucroute alsacienne avec du Riesling Californien ! ', '2015-12-16T14:14:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44947, fb5f1ec6-8d29-427f-8e04-6b3af4db8811, '1. Le planteur c''est jus d''orange, jus  d''ananas et jus de goyave.  2. Je ne conçois pas qu''on puisse conseiller du rhum Charrette pour faire du planteur (antillais)...  Bref... ', '2014-07-30T22:09:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44947, 7445f8a2-5e03-4679-9fb5-e1aa1bd96b2a, 'Très bon cocktail... Pour ma part, j''ai suivi le conseil de Andel76 et à la place du jus d''ananas, je l''ai remplacé par du jus de mangue. Mes invités l''ont apprécié.', '2013-03-25T23:10:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44947, 7e50243a-2795-4728-8f89-f86065feed38, 'Bon dosage. j''ai quand même rajouté 25 cl de rhum vieux ou ambré pour le trouver parfait. effet planteur garantie (définition par les antillais ; ça se boit tout seul et ça te plante après). à consommer avec modération quand même.', '2009-01-03T15:55:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, 0c8abc40-9ca4-4126-8f09-485a7e3ca917, 'J''ai mis de la crème et deux oeufs supplémentaires pour que ce soit plus aéré ! On peut aussi mettre du fromage blanc en partie pour remplacer la crème, ou bien du mascarpone. On peut aussi mettre du rhum dans la crème.', '2020-07-08T21:43:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, 1ca8aa57-ac60-40cf-a868-bf7cbf4caca6, 'Très bon, pour ma part jai utilisé de la mascarpone, des palets breton maison que jai imbiber dans le sirop et du Nutella que jai mis dessus avant de mettre les bananes et la crème .', '2020-04-24T16:02:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, 2b91615e-39b0-45bf-b6f4-dcfd1d0b1d7b, 'Qui dit tiramisu dit mascarpone j''ai utilisé moitié mascarpone et moitié fromage blanc onctueux pour alléger meilleur avec boudoirs dans jus de fruits, car rhum alors trop prononcé !', '2018-09-20T20:28:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, 652f1bcc-f9e5-48b3-b4c1-1dc6f6343bdb, 'Perso je mets de la mascarpone et non de la crème. J''y incorpore de la banane mixée. Les boudoirs je les trempe dans du jus tropical ou oranges citron. et j''intercale des rondelles de bananes ', '2015-11-13T00:50:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, c423a131-5fc5-4c00-b148-58b3c5f1fba9, 'Bof. La banane quand elle refroidit devient compacte et un peu trop sucré à mon goût !', '2015-07-26T02:21:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, 639b429f-e686-4798-a942-607a6791ce0f, 'Très très bon et très frais mes enfants se sont régalés (ils en ont repris 2 fois)', '2014-05-30T17:23:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, a664dcaf-ad93-4ee0-ac94-7d9aaa4b0d35, 'Délicieux. J''ai remplacé la crème par du mascarpone. Mais attention aux quantités : vite écœurant, ne pas être trop gourmand.', '2013-12-15T21:15:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, a98fe720-74ba-4f17-b54d-9a944cdeb320, 'Pas terrible, pas beaucoup de goût', '2013-01-24T19:54:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, 4e164090-a329-484e-bfd5-3b4badc3f75d, 'J''ai fait ce dessert pour le réveillon de Noël, pour sortir de la traditionnelle bûche... Tout le monde a adoré ! Pour ma part, je le trouve un peu écœurante (il y a quand même beaucoup de crème...). J''ai ajouté la moitié de la dose normale de sirop dans la poêle, et les biscuits étaient imbibés juste comme il faut... même si certains ont trouvé que cela sentait beaucoup le rhum (moi non!) !', '2008-12-25T20:38:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, 9808f88c-05aa-45db-8a9e-abd60f71e1de, 'Excellente recette, malgré le fait que les bananes n''ont pratiquement pas rendues de jus!', '2006-09-04T00:13:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, d2699df6-601b-473c-895a-73b8d46c8a59, 'Super (simple et délicieux)! J''ai mis pas mal de beurre et plus de rhum que prévu (j''ai mis du rhum carambar ce qui a parfumé agréablement!) et deux oeufs pour plus de mousse !', '2006-06-10T00:41:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, 1908fb22-211f-402c-a8b5-67aa1db3b7ff, 'Délicieux et si simple à réaliser!', '2006-06-05T10:36:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, d4421d95-59ce-4a7a-a07b-3f1b371a55a2, 'C''est vite fait et vite mangé! Délicieux fait avec du mascarpone, peut-être faut-il rajouter un peu de sauce pour les boudoirs. A refaire.', '2006-04-09T19:09:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, b6437642-840c-4558-a3e5-184fd149215f, 'Pas mauvais du tout !!! J''ai rajouté 3 bananes et j''ai fais un tiramisu à étage !! Boudoir/banane/creme/boudoir/bananes et chocolat amer dans un plat carré. ', '2006-03-22T11:50:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, b1d54e9a-e052-42f1-a033-4c65f7ba16cb, 'Recette très facile à réaliser, vu le succès de ce dessert: pensez à en faire souvent!', '2006-02-09T11:18:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, a4930214-8a5f-44aa-a8fb-29ddce23eb2b, 'Je suis la reine officielle du tiramisu de Guadeloupe grâce à cette recette, merci!', '2006-01-29T17:27:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, cb4ccd9d-de5c-4b5e-a8ac-2e74172bc73e, 'Très bon, mais j''ai mis du mascarpone au lieu de la crème. Pour les bananes, j''en ai mis 3, et j''ai augmenté aussi la quantité de boudoirs, car il y en avait vraiment pas assez. Et pour la sauce : beaucoup d''eau, 1 rondelle de banane, du sucre, et du rhum pour imbiber les boudoirs.', '2005-11-29T18:31:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, a5b3a6a8-459d-4f3b-8720-9ef948e0d74f, 'Miam, miam! Voici une de ces recettes, qu''on se réjouit d''avoir découvertes, et qui devient rapidement un "grand classique de la maison"! Un grand merci!!! Seuls petits détails techniques :  pour la quantité de crème, j''ai utilisé 12 boudoirs. J''ai un peu augmenté la quantité de rhum.  J''ai laissé reposer toute une nuit (car le "jus de cuisson" n''était pas assez abondant, et cela a pris du temps pour absorber l''humidité de la crème). Un succès!', '2005-10-17T00:42:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, 344fa1f7-85fb-4b96-94f0-11bbd22d12be, 'Miam! Super savoureux! Par contre, ne pas essayer de le démouler, ça donne un drôle de résultat...:)', '2005-09-29T13:34:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, 0b5ef97e-e1cf-41bf-96a1-e97df0ec4de8, 'Délicieux! Et très facile à réaliser.', '2005-09-15T13:12:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, 877d09c8-33f4-470d-b15b-9a2d0cc0934d, 'Rapide, facile et idéal pour utiliser des restes en aménageant les ingrédients. Tout le monde a adoré ce mariage de saveurs et la texture fondante et crémeuse de ce dessert. A refaire.', '2005-08-08T18:59:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32392, 605c963d-031b-4962-a240-40868b3f9a69, 'Excellente recette, qui se fait avec beaucoup de rapidité et de facilité. Ma famille et moi, nous nous sommes régalés!', '2005-02-24T23:38:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337339, 71f9559c-081d-4529-9a1a-16df58852250, 'Au top, très simple à réaliser, et résultat savoureux. Je l''ai laissé macérer 3 mois. Il faut penser à goûter régulièrement, et au besoin, enlever le citron plus tôt pour que le rhum ne soit pas trop amer. C''est ce que j''ai fait.', '2019-07-29T06:08:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339912, c2806d95-a152-4db4-a2ff-56701b932f1d, 'Le gâteau est une pâte fade chocolaté et ne sent pas beaucoup la banane (j''en ai pourtant mis deux suite au commentaire précédent) mais sans résultat.', '2018-02-24T08:59:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339912, 8164a325-8bbf-4495-99d5-44ec78239d0e, 'C''est bon. La texture est croquante dessus et moelleuse dedans. Ils ont bien le goût à la banane mais j''ai du mal à trouver le chocolat. J''ai testé la cuisson sur plaque et dans des mini-moules, les 2 fonctionnent. J''avais mis thermostat 6-7. ', '2016-11-10T00:33:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211377, b69f20d2-ae6e-4673-bd03-ba9c1684244a, 'Très bonne recette. J''ai mis 3 bananes et que 2 kiwis ainsi qu''un seul yaourt mais un peu de lait et je n''ai pas ajouté d''amande amère. Toutefois, les graines de kiwi me gènent un peu quand je bois, elles donnent un goût amer au milkshake que je n''aime pas... la prochaine fois que j''en ferai j''essaierai de les enlever ... sinon c''est une super boisson rafraîchissante et pleine de vitamines ! (j''ai posté une photo de cette recette, celle avec les plumes colorées).', '2017-02-07T13:56:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45452, b2222fe6-9007-4f31-9a46-9c02be6a352f, 'Bon mais il manque une saveur…', '2023-02-12T20:08:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45452, fb2517f1-fa5d-409c-a31e-3d8321c0e415, 'Super bon!', '2022-04-17T23:19:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45452, d55e1f2f-aec2-403b-aa98-6f7b837d0eb3, 'Fait par mon fils de 7 ans, très fière de lui. Un régal !! ', '2021-06-14T19:44:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45452, 9626cf9e-fd6c-4927-a70c-196e4c6d673f, 'Vraiment très simple et très bon, moi je l’aime chaud car je le mangeais comme ça en Thaïlande, avec du tapioca c’est encore meilleure. ', '2020-02-28T09:23:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45452, 75b8503c-de33-46eb-ac55-63cf911d0edf, 'Bonne recette, simple à faire. J''ai mis 2 bananes et baisser le feu après ébullition. A refaire  ', '2015-02-12T01:15:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45452, e636d13f-7ffc-49d0-9556-1cfd087a49ff, 'Juste immangeable. A ne pas refaire.', '2014-05-10T21:23:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45452, db087ce4-2d79-4a2e-a6a7-84d38f720e4a, 'Pour ma part, je n''ai pas mis de cannelle mais un peu de chocolat en poudre. Trouvant la préparation un peu liquide, j''ai ajouté de la semoule. Le mélange donne un dessert original, qui, saupoudré de vermicelles multicolores, est présentable et passe pour de la grande gastronomie aux yeux de mon fils de deux ans et demi ! Merci pour l''idée, cette recette est parfaite pour écluser les restes !', '2010-09-08T19:13:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45452, 03542021-1ffa-4f39-995f-0fdbf04c0d39, 'Super bon !!! De l''avis des autres commentaires, nous l''avons dégusté froid !!! A refaire !', '2010-05-19T22:19:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45452, fbaa9e3b-1f3f-4712-a798-b777f2bbc736, 'Je n''avais pas de cannelle, mais je doute que le goût se serait transformé... ', '2010-01-26T21:28:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45452, 8e8a873a-b4cb-41bb-a327-2a003d2a3d88, 'Rien d''autre à ajouter qu''excellent!', '2009-02-02T18:33:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45452, a08441f3-1705-4464-85a5-c16a343ecc43, 'Tout le monde a adoré !  A faire et à refaire sans modération.', '2008-12-13T16:22:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45452, 8636a0d9-6d7c-444c-9595-5b4b9e069b89, 'Super recette pour finir le reste de lait de coco. Préparer le dessert avant le repas et laisser refroidir pendant que vous manger, c''est exquis et très simple', '2008-04-28T22:48:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45452, 65826034-3699-475b-b3df-a634dc639a15, 'Top!', '2008-01-27T00:24:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45452, adb243dc-33eb-49d9-9eea-fe7f9b5a3a3c, 'Apparence bizzare, mais bon goût! Nous l''avons mangé chaud, comme indiqué dans la recette, mais la prochaine fois nous essaierons froid. Une bonne recette, pour finir un reste de bananes et/ou de lait de coco.', '2006-10-10T15:27:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45452, 7501a4b5-af99-44dc-92e6-2a27ac096f81, 'Pas mal du tout! Même si ça a une drôle de tête au final, le goût est intéressant! Pour ma part, j''ai rajouté une pointe de gingembre en poudre et de la muscade...Divin avec des boudoirs!! Merci!', '2006-10-03T22:27:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (343256, d28d1520-b76f-4282-b86b-33105b017094, 'J''ai préparé la pâte avec de la farine sans gluten et cuit dans un moule à cake.
C''est excellent ! ? ', '2020-11-12T12:23:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (343256, fe129207-d8dc-40ee-8b99-d1e8bb51ac58, 'On ne sentait pas beaucoup le kaki à mon goût (les kakis étaient peut être trop mûrs) mais ce gâteau se marie bien avec un thé.', '2016-11-30T10:51:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (343256, bbf22c95-15a4-4f06-9ab5-996519770fff, 'Très bon mais j''ai mis 2 pots de farine au lieu de 2,5 pots. ', '2016-11-27T14:05:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (343256, f11e93dc-637c-4a95-abe1-8d9156e15552, 'Un bon mélange de saveurs, à refaire !', '2016-01-27T20:11:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22936, e60298ac-e92f-48e9-a356-ccce429487e1, 'Très simple et rapide très bon mais plat écoeurant si on en mange trop.', '2016-08-06T06:51:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22936, f15c75d8-458f-4afa-b604-45e0a43b3065, 'Délicieux nous avons servi ceci en entrée... parfait... merci pour cette recette !', '2016-05-22T15:00:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22936, aa929d7b-366f-4242-9ccf-80b3155b5c1a, 'Un vrai délice. Sans paprika car on en avait pas et on a mis du blanc de dinde à la place du jambon. Le mélange est vraiment top. Un très bon plat sucré salé rapide et très simple ! ', '2016-05-14T15:20:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22936, b25171e2-a475-4318-a7b9-2b616510bc59, 'Recette originale et facile à réaliser, mais le plat est vite écoeurant', '2016-03-06T11:46:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22936, cd164d9e-4116-4252-bb58-5bfe08f00c6d, 'Ravie d''avoir retrouvé cette recette que je fais depuis...des décennies. J''adore, c''est simple et rapide et c''est délicieux pour qui aime les associations sucré/salé...', '2016-02-27T15:40:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22936, 554a0a76-0663-4b1e-a3fd-25f79594b2ea, 'Simple, rapide, ça change un peu nos habitudes... Et c''est surtout très bon ! Je referai !', '2014-09-09T14:48:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22936, 3f2247f8-bb3b-43f1-9eca-7f6df3937ba8, 'Bonne recette, assez rapide. Peut être un peu plus de 15 min pour la cuisson. J''ai mis 20 min', '2013-09-09T23:05:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22936, 81991f40-5e45-47c6-9586-fa5e6905957f, 'Très bonne recette, originale et très rapide à réaliser. J''ai aussi ajouté de la moutarde mais c''est sans doute aussi très bon sans. Merci pour cette recette !', '2013-06-25T17:43:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22936, f1523d96-c834-4011-8f8a-aa2b0b9ccff9, 'Rien à redire, cette recette me ramène 55 ans en arrière et je revois les agneaux de ma grand mère enrubannes et décores d''un oriflamme....Sauf le temps de cuisson est insuffisant :avec mon fourneau Lacanche à 180°C il m''a fallu 50 min pour un résultat parfait (moule en terre vernissé) Bien à vous.', '2013-03-31T00:28:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22936, ec819420-305c-4114-9123-1e17c85ccfc9, 'Surprenant comme association mais délicieux et rapide à faire.', '2013-03-19T19:14:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22936, 9065cbca-3f27-450e-aaf3-ec131ebc2fda, 'Excellent, j''ai également tartiné le jambon de moutarde avant de mettre du paprika. J''ai accompagné de riz à la créole (recette marmiton)', '2008-08-27T23:18:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22936, 89b46630-564f-4e36-9822-80efaf9d75cc, 'C''est excellent! Encore mieux en badigeonnant le jambon de moutarde (avant le paprika).', '2004-11-27T13:56:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70340, 5094fb41-8c41-429f-817f-400e07760ef0, 'En ajoutant plus de légumes, pas besoin de servir avec du riz. Par contre, j''avoue que j''ai éliminé d''office la banane et le concombre. Très bon repas équilibré pour un soir. j''ai gardé les mêmes proportions pour le reste, a l''exception du curry que j''ai doublé. Le lait de coco n''est ni trop fade ni trop présent en bouche, juste ce qu''il faut. Très savoureux comme ça. Recette qui fait son petit effet à chaque fois.', '2018-02-28T07:18:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70340, e1bb1295-1e2f-4210-8f07-14c1b353b9f9, 'Vraiment très très liquide ..... pas convaincue du tout.', '2016-04-12T19:36:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70340, 06bcdc67-ec93-4291-a710-c04539fa3d1a, 'Les saveurs sont très agréables même si on ne retrouve que très peu les épices, une fois le tout mélangé... même mon gingembre frais est passé inaperçu au milieu de tout cela ! Le temps de cuisson est bien trop long. Les légumes ramollissent beaucoup. 40 min suffisent.', '2011-01-27T13:02:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70340, 10b92507-167f-4553-9ceb-653d3944e6b3, 'Excellent, facile à réaliser en suivant bien les indications. A refaire. Toute la famille a aimé. Merci !', '2010-05-10T00:23:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70340, 5989e3c4-d9b5-4bea-ab04-6618171d26de, 'Je n''ai pas mis de pomme de terre et utilisé des tomates fraîches. J''ai remplacé le bouillon par du sel et du poivre car il y avait bien assez de liquide avec le jus des légumes. Toute la famille s''est régalée.', '2009-08-13T16:50:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36944, 545c84ee-c035-49f3-9a37-f9a1b63d9348, 'OK, c''est un peu lourd mais délicieux accompagné d''une crème chantilly ou coupé en petits dés avec de la glace à la vanille. Comme Sylvie, j''ai fait cuire les rondelles des banane avec la préparation : miam !!! Merci beaucoup pour cette recette dé-li-cieu-se.', '2009-05-21T16:35:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36944, 8784c528-4322-4e26-a36b-11c38e791153, 'Pour faire ce gâteau, j''ai suivi tout les commentaires, sauf pour la noix de coco au j''ai mis simplement 125 g et ne voulant pas faire de glaçage, j''ai coupé et mis les bananes dans le mélange final, cuisson 30 minutes. Délicieux, il a fait l''unanimité de toute la famille. Le problème est qu''il se mange trop vite !!!', '2006-08-15T16:31:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392342, a337c2a4-2a47-4001-b232-8b7950482467, 'Délicieux et plein de vitamine C !', '2020-11-21T14:24:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26530, d3e1bfb0-43aa-42d7-9db5-6e50f065573b, 'Le mélange sucré-salé est très bon. Je l''ai accompagné de riz thaï. Malheureusement, je n''ai pas pu épater mes invités car le sirop n''a pas flambé. Peut-être n''aurais-je pas du le verser sur les fruits, mais uniquement sur le rôti...', '2005-07-27T12:09:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26530, 038a71f7-cc72-4425-a5bf-867e8766e81f, 'Hum, c''est la 2ème fois que je fais cette recette... elle épate toujours mes amis et famille... Surtout le spectacle aux flambeaux ! Même ceux qui ne sont pas adeptes du sucré/salé habituellement ont apprécié. J''ai fait la recette sans clou de girofle car je n''en avais pas et il y a déjà suffisamment de saveurs dans cette recette ! Humm, je vais faire ça pour le repas du réveillon !', '2004-12-27T22:25:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26530, 0dcc0878-2079-4209-b38d-39896ecbaa14, 'Les clous de girofle donnent un mauvais goût à la viande...', '2004-08-28T12:19:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68473, 9eb33ef9-1937-4f85-8007-cd8c0c24f688, 'J ai bien aimer c était troopppp bon je vais le faire plus souvent ', '2023-12-13T22:24:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68473, 96fc23d3-fe86-4e90-8e95-1609c9dec020, 'J''ai fait cette recette sans oranges mais avec du jus orange-mangue et du lait d''amandes, très bon !', '2019-04-29T13:00:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68473, 3f49aa31-e84a-4821-a190-e4500fe23746, 'Je n''avais pas tous les ingrédients, alors j''ai fais à ma sauce : - 1 yaourt,nature sucré - 3 bananes - 1 mangue - 2 kiwis - jus multi-fruis J''ai hésité à mettre de la clémentine et/ou du pamplemousse, mais je n''ai pas tenté ! Pas mal du tout !', '2013-04-04T12:20:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68473, 36e9684f-cbe6-4c24-ae49-2e2db3f89e88, 'Très bon merci beaucoup pour la recette. Miam, je vais vite le refaire, avec des fruits rouges cette fois.', '2011-10-07T18:48:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68473, 2ca9bd23-d88a-4cfd-8c81-90ba0ec0f34c, 'Très bon. J''ai utilisé du jus d''orange et un yaourt nature non sucré. ', '2010-11-24T13:43:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68473, 127e4870-3be4-4afa-b8a3-142db2730a71, 'C''est pas mal pour épuiser ses stocks de kiwi (on sait jamais quoi en faire!) Bon par contre je me suis permise par remplacer le jus "banane orange" (??) par du simple jus d''orange!', '2009-02-01T19:32:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15809, 481f66e0-d7b6-44a1-8f7e-6e51389e76cf, 'Recette très facile à faire, je l''ai trouvée meilleure le lendemain (après conservation au frais) car moins sèche.', '2005-01-25T09:30:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15809, 3c278bed-a7c2-48cd-85b5-f3a18db246bc, 'Bon! Je n''ai pas mis la gelée de groseille et c''est tout aussi bon. Recette utile quand on ne sait plus quoi faire avec des bananes déjà bien mûres. Ne pas oublier d''ajouter une larme de rhum!', '2004-08-27T14:14:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15809, 79c64168-01a1-493c-b6ff-a27c9329bd6d, 'Très bon sans la gelée de groseille et en mettant seulement les jaunes d''oeufs dans la crème banane. Les blancs ont fait une parfaite meringue pour cette tarte. Ne pas oublier de mettre le rhum, qui parfume la crème agréablement.', '2003-08-15T15:44:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65020, f6217fef-6bc7-4729-85ae-ac30feca90ff, 'Ce n''est pas si mal que ça ; mais il faut améliorer ce dessert !! Tout d''abord, je conseille de ne pas cuire les bananes au préalable dans le beurre ; elles cuiront seules comme des grandes dans le plat. Ensuite, les proportions données pour le sable sont pour 4 à 5 bananes ( mettre un peu moins de beurre pour que la pâte soit davantage sablonneuse). Enfin, il faudrait mettre un peu de noix de coco râpée dans la pâte crumble', '2008-10-27T00:16:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65020, 868bd45a-085c-42b7-ba16-838d672a8d40, 'Moi qui pensais me régaler, j''ai été super déçue ! C''était horriblement bourratif et indigeste. Désolée ! ', '2008-04-28T22:24:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 1aeeae4c-b346-49eb-8de9-9ffd633610f3, 'Trop peu sucré... mais bon, ça c''est une question de goût. Par contre je l''ai trouvé très sec, donc plutôt à tremper dans le café pour moi... pourtant j''ai bien suivi la recette à la lettre. A recommencer avec peut-être plus de beurre ou moins de farine. A moins que ce soit mon mauvais dosage du lait qui ait causé cet effet sec ...', '2017-02-04T18:15:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 9f0c9ff5-c05a-47a9-8582-99d5c5116bcd, 'Juste parfait. Moelleux, avec raisins trempés dans du rhum puis enrobés de maïzena. Un régal vite fait. ', '2016-08-29T14:52:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 1b30319b-8d54-4fbe-953c-8f7b9a853f52, 'Sans rhum mais avec fleurs d''oranger et vanille plus quelques graines de chia. Un régal', '2016-06-29T15:50:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 46de97b8-443b-467a-b965-2c1b9b698b0a, 'Très bon moelleux, fait avec de l''amande en poudre et à la place du rhum de l''extrait de vanille...un régal.', '2016-06-26T21:52:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 7dcab120-1667-46f8-af0c-4c32c1445fd8, 'Trop bon juste fait avec des oeufs en neige et sucre cristal et j''ai mis des pruneaux sinon j''ai respecté tous le reste super cake moelleux merci pour la recette. ', '2016-06-04T23:59:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 0af95f51-8745-42ed-af0e-5da11c50d1b6, 'Un succès ! J''ai fait en format "miniature" diamètre 6 cm, j''ai réduit la quantité de sucre en doublant les doses, 160 g de sucre et je les ai fait aux pommes et poires. Certains trouvaient que ça manquait de sucre...perso j''ai trouvé ça parfait comme ça. J''ai également ajouté une bonne cuillère à soupe de bicarbonate. 20 minutes de cuisson ', '2016-01-23T10:22:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, c29fa3a2-50d0-4c91-9aff-2d8db0a8a0d5, 'Moyen. J''ai respecté la recette à la lettre et je l''ai trouvé peu sucré alors que j''ai moi-même la main légère sur le sucre. J''ai juste ajouté de la fleur d''oranger pour parfumer. Le bémol, c''est le dosage du lait, la recette n''étant pas précise j''ai du en mettre un peu trop car les tranches se cassent trop facilement au moment de servir.', '2015-11-28T22:26:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 184119ec-dcd2-4206-a0da-06e1103b589c, 'Très bon cake! À refaire! Meri pour la recette. Olivine', '2015-08-16T18:11:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 5715be92-67ab-44f6-8a6e-cea4f09b3e96, 'Très bon. Fait sans rhum juste avec un peu de fleur d''oranger pour aromatiser.', '2015-03-30T00:32:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 6d7c9c49-69b7-4ecb-9de8-c6bf81fa0758, 'Excellent! Je l''ai fait avec des cranberries... Tout le monde a aimé, surtout ma mari qui n''a pas pu s''empêcher de le finir... Croustillant à l’extérieur et moelleux à l''intérieur.', '2015-03-02T14:16:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, fd526c5f-36f0-47a2-bf61-d3fcb66e1dd8, 'Excellent ! Je l''ai fait nature et ai mis que 80 g de sucre.', '2015-02-01T21:29:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, ad969ab9-de45-49fe-9d14-419559ef16d7, 'Très bon !  Je l''ai fait avec des pommes caramélisées dans le sucre vanillé et j''en essaie un autre qui est au four avec des pépites de chocolat.', '2014-11-20T17:25:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, a26d3103-87d0-477f-ab0b-00f2444c56a8, 'C''est trop bon. Miam !', '2013-07-26T18:26:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, dbc1ffc5-ae0f-4bf5-a13a-6b2741da8b80, 'Très facile à faire ! Très rapide ! Je l''ai fait déjà plusieurs fois avec différents ingrédients... Toujours un succès.', '2013-04-13T20:42:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, f4863c24-d3d0-4b09-b87d-69b37b4ef581, 'Simple, rapide. Un vrai délice !!!!!!', '2013-01-04T09:39:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 7140332d-5c63-4432-8259-50b5e24ef7ae, 'J''ai ajouté 100 g de chocolat en poudre, mis plus de rhum ainsi que 10 min de cuisson en plus. Visuellement il est beau et il est délicieux : croûte croquante, intérieur moelleux et très parfumé. Dans cette version j''ai mis des amandes effilées et des raisins secs, mais il y en aura d''autres de versions ! Merci pour cette recette. ', '2012-11-22T16:26:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, d1ea2dfd-a0ac-49dd-834c-5c5c382e7c29, 'Très très bon ! J''ai mis des morceaux de banane et des copeaux de chocolat. Un régal !', '2011-06-17T22:48:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 8a82052e-6bab-42cf-871e-83dd22248fb3, 'Super facile à faire !', '2011-03-13T16:54:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, a856e845-5fb4-4051-b7fa-bb0bf9908ef0, 'Une vraie brique ! Trop compact, lourd... Je vous accorde que le goût est correct, c''est pour cela qu''il reste un point !', '2011-02-28T13:17:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 644bc764-6ec0-4eaa-bc84-5dddee6269e6, 'Rien à dire, c''est très facile, très rapide et très très très bon.', '2009-11-23T22:24:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 211dcd5c-f6f8-4e8c-8f1c-8f3cbfde333c, 'Cake simple et rapide à faire, et en plus, très bon, j''y ai mis des pépites de chocolat. J''ai simplement remplacé le beurre par de l''huile d''olive et j''ai mis du lait d''amande. La prochaine fois, je l''essaierai en rajoutant aux pépites de chocolat, un zeste de citron ou d''orange.', '2009-10-23T01:50:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 7b01577e-6eb5-468f-8b3a-f72e88458222, 'Rapide et très bon. Que demander de plus... J''ai mélangé pépites de chocolat noir et noix de coco râpé...Mhm... Par contre je n''ai pas mis d''alcool. Un vrai régal', '2009-10-15T16:25:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, c30a7c7b-0e0a-416a-b867-9ac4808bd6ac, 'Rapide à faire et excellent!!!', '2009-05-01T20:10:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, c2844f9e-30ff-4eb8-ae24-2099e7c63c69, 'Facile et rapide, vraiment excellent ce cake... ', '2008-11-04T17:21:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 29f73c3e-b56d-452d-847b-3955cf68111a, 'Ce cake porte bien son nom. J''ai fait cette recette au dernier moment en quelques minutes. La cuisson n''est pas trop longue et il ressort toujours croustillant à l''extérieur et moelleux à l''intérieur... (même s''il reste un peu trop longtemps au four, l''intérieur ne sèche pas, il sera juste plus croustillant). J''ai tenté les versions "standard" avec pommes, ou pommes et pépites de chocolat. Je trouve ça un peu commun et me laisserais bien tenté par les noix/pommes, pour changer un peu! Je vous dirai!', '2008-06-22T00:49:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 29100596-b7d3-4c7b-b958-d3326d7594bb, 'Rien à dire de + :) Je n''ai rien mis (ni pépite ni fruit) et le cake est d''un léger et d''une souplesse incomparable! (Mais ce n''est pas parce que je n''ai rien mis hein, rien à voir lol.) J''ai prolongé la cuisson d''environ 10 bonnes minutes (fait dans un moule aluminium car pas de moule silicone, peut être ça...) Ne passer pas à côté de ce cake super simple et rapide à faire, et super simple et rapide à manger :)', '2008-05-31T10:38:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64096, 7bd763b1-b081-4918-988a-007a2eda695f, 'Quel régal!! J''ai remplacé les pépites de chocolat par des petis bouts de tablette de chocolat noir et, dégusté tiède, le chocolat fond, c''est délicieux! Une recette qui convient parfaitement à la saison.', '2007-12-02T16:58:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18422, 6c1e6c01-876f-415e-b576-f49b7c00eeb8, 'Parfait?', '2021-02-12T04:35:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18422, d2308b86-1829-461e-80c5-cdfbd04ff985, 'Délicieux et tout simple à faire !', '2014-05-11T21:30:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18422, 1057d3ab-7b42-4073-a6c4-e1d284082ed4, 'Dessert délicieux et rapide à faire.', '2013-03-09T13:08:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18422, 58cea607-8dbb-47a5-80af-6de50aaaa1e9, 'Tous mes invités ont adoré, surtout les enfants! J''avais mis de la pomme, de la banane, de la pêche jaune, du kiwi et de la fraise. J''avais arrosé de citron. J''ai laissé au moins 4 heures au frigo. Et après, j''ai servi avec un mélange de chocolat fondu et de crème liquide.', '2004-08-30T17:45:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18422, d6b62113-bc07-4b0b-af34-83e5f0e9733f, 'J''ai mis les brochettes au frais. Pas mauvais, mais sans plus! La prochaine fois, je les napperai de chocolat chaud.', '2003-11-30T20:53:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64584, 5e7a9b4e-e9c0-46d3-81d9-74120ad0f4b1, 'Facile et vite fait, on peut varier les fruits selon ce qu''on a sous la main, rajouter des épices, selon les envies et l''humeur du moment. Quand du monde débarque à l''improviste, c''est super pratique et le succès est assuré! Personnellement, je le laisse cuire un peu plus longtemps au four.', '2008-06-07T20:18:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36617, 584fa429-0f70-4783-b0cf-68d34bd5cae2, 'C''est un milk shake, pas une pina colada...', '2005-08-24T18:09:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, de2d6c66-3200-4de9-b340-8e8838fa77bf, 'J''ai fait plusieurs fois ce gâteaux et mes invités se sont régalés. Pour la chantilly j''ai mis moitié crème et moitié mascarpone. C''est un peu moins léger mais pas de problème pour la tenue ! Merci pour cette recette ', '2020-09-19T15:42:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, b497d833-ca1e-48e2-87b5-dc34fbf16d0b, 'Délicieuse recette, dessert très gourmand, on adore. Petit plus, dans la chantilly, je râpe un peu de fève de Tonka. C''est extra !', '2022-05-21T19:20:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, cb1e7999-3e0d-45e7-9d5c-98489d707d41, 'Excellent mais tres sucré et riche. A realiser en petites portions !', '2017-09-17T21:58:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, 1f7d400d-efe0-477c-b6b5-b06e07b7ff0f, 'Vous utilisez quelle taille de lait concentré? ', '2016-04-16T15:07:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, ca0af186-1c0f-4037-af9b-fb6aa51a7f2e, 'Une vraie réussite !! Merci beaucoup !!', '2016-02-14T21:45:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, 5157af99-eb2c-4fdc-9c49-2e5d4b868d8d, 'Parfait ce mélange confiture de lait-banane-chantilly. Une folie ! Les enfants ont adoré et c''est idéal pour finir les "vieilles" bananes qui noircissent et dont personne ne veut.', '2015-10-17T13:15:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, 5f4b358a-69e5-4787-bd84-27bda7e36925, 'Recette faite 2 fois : la première fois en verrine, très bon, la seconde en moule de 23 cm environ..... un régal ! vraiment elle est topossime, ce gâteau a beaucoup beaucoup plu. la garniture tenait assez bien lorsque j''ai enlevé les bords, mais après avoir coupé ça ne tenait plus beaucoup, mais c pas grave. la chantilly n''est pas très sucrée, ce qui est parfait étant donné la dose de sucre des couches inférieures... ;-) Donc, merciiiii pour cette recette ! ', '2015-10-14T01:36:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, d7173f45-2f12-4e38-ae58-21e52a95a690, 'Recette faite à plusieurs reprises. Toujours un régal mais il est vrai que la garniture à tendance à couler. Tout doit être très froid. Faire fondre le beurre avant de le mélanger aux biscuits finement mixés. Laisser refroidir la croute de biscuits au frigo avant de déposer les bananes. Le lait concentré sucré 45 min à la casserole à pression. fait dans un cercle à patisserie (a bien tenu sinon le caramel coule) ', '2015-05-13T16:43:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, ba04f63e-96b8-435b-94af-b3e89b026400, 'Recette délicieuse! Personnellement, je n''ai pas fait la Chantilly moi-même, mais ça n''enlève rien au plaisir de déguster ce dessert. Merci pour cette recette !', '2015-05-07T11:33:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, ad7cec61-1dd6-4036-a768-f65b694dc770, 'Très bonne recette, la chantilly mériterait un peu plus de tenu peut-être en ajoutant du mascarpone?', '2015-04-06T11:07:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, 6bea7809-9e6b-4a6c-b624-62e9e941e822, 'Très bonne recette je ne comprends pas le commentaire précédent. Attention à prendre de la crème entière pour monter la chantilly. Un sachet de chantifix peut aider... et huiler un peu le plat ou faire le gateau sur une feuille de papier cuisson bref une recette ou il faut quelques bases en pâtisserie effectivement ce n est pas un gâteau au yaourt mais si on réussit c est juste parfait ! ', '2015-03-11T17:10:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, 7fa91703-669c-4870-891a-f2d88d522c2e, 'J''ai fêté mon anniversaire hier avec quelques amis. Pour l''occasion j''ai décidé de confectionner le gâteau d''anniversaire de mes rêves : un banoffee. Votre recette étant facile et bien notée, j''ai décidé de la suivre : je n''ai jamais été aussi rigoureuse culinairement parlant. J''ai consciencieusement tout fait comme indiqué. J''ai mis le saladier au frais fait durcir le sablé au frigo, utilisé de la crème entière, etc etc... A priori tout était sous contrôle. Au moment de démouler le gâteau : 5 secondes de triomphe, mon banoffee avait de l''allure. Las, la crème a rapidement commencé à se répandre sur la table. le gâteau et moi-même faisions moins bonne figure. Mais le pire est à venir : pendant que je regarde le gâteau se faire la malle, consternée, mon mari tente de faire des parts, au moins de biscuit. Mais pour une raison tout à fait mystérieuse, ce dernier n''a jamais voulu quitté le moule. La suite est un véritable carnage, une scène d''une violence inouïe à laquelle vous ne voudriez', '2015-02-05T22:02:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, 785b6a6e-9606-474e-9b5c-d79facffa2c7, 'Le meilleure du monde', '2015-02-03T02:49:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, c24452ea-8aae-49c7-bd5b-6dd1069113ba, 'Juste parfait !!!!', '2015-01-24T20:59:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, ffd4dccd-4e63-4e1a-b8ba-a32ab7825c9b, 'Ce dessert est une tuerie! Je crois que je vais créer un fan club du banoffee ! Pour ma part j''ai mélangé 3/4 de sablés avec 1/4 de spéculoos pour le biscuit... Un délice ! ', '2015-01-17T18:59:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, 1c5e223e-6892-4998-8b0a-3a50411e8661, 'Très bon et très facile, mais j''ai du recommencer la chantilly parce que cela ne fonctionne pas du tout avec une crème allégée (18%). ', '2014-09-28T21:34:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, 8fd7c660-0f78-4786-b657-b675478757de, 'Très très bon, je viens de le faire et c''est super léger, faites le, vous serez conquis.', '2014-04-27T01:42:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, 17557d79-b8ad-4308-a540-36beab49f961, 'Si on n''a pas de moule à manquer, on peut utiliser des verrines à fond large pour voir les couches au travers. C''est joli et appétissant. J''ai utilisé des palets bretons et du beurre salé, ces biscuits n''étant pas très sucrés, l''alliage était idéal.', '2014-02-18T10:27:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, b35b3b8e-ab89-49a7-861c-59e89f30daf3, 'Très bon, simple et rapide à faire. Pour ma part, en base gâteau j''ai pris des cookies tout chocolat, c''était parfait. Avec les spéculos, ça doit marcher aussi. Pour la confiture de lait, si on n''a pas de cocotte comme moi une simple casserole suffit, il faut recouvrir la boîte d''eau et laisser à feu moyen 1h30 environ. ', '2014-01-25T16:06:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, 0701edf5-4e9e-4afe-95a7-e633a5c236ae, 'J''ai du doubler la quantité de chantilly pour pouvoir recouvrir tout mon plat. mais le résultat a été parfait!!! ', '2013-12-10T11:21:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227576, 5d06ee4e-62b3-4751-9855-6d84f7bdd2d3, 'Très bon dessert ! On pourrait croire qu''il va être trop sucré mais finalement avec la chantilly très peu voire pas du tout sucrée l''équilibre n''est pas mal du tout.', '2013-10-25T13:18:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58633, 0f0e3aa6-d0ce-45c9-8c56-523ef25370cc, 'Excellent !', '2014-12-13T23:48:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58633, 720e3ed0-8c08-4f75-854c-67112d19b7cd, 'Très grande cuisine lol', '2013-09-20T16:22:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58633, 4f1e4b16-289c-4b6c-b48e-a173b144d5a4, 'Excellent !', '2013-09-02T14:27:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58633, 52c300ce-e1e7-4c81-a0a8-9d5b04fc7dec, 'Bon. ', '2013-06-08T18:32:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25995, 823a48a9-0bfd-4b80-99fe-06a2fcae93ca, 'Pour nous c''est avec glace chocolat, café, caramel au beurre salé.', '2017-04-28T14:41:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25995, 1beac0d9-3519-41ef-acb2-343ed9fe14f2, 'Excellent dessert. Moi, je mets du Nutella et l''autre, fondu avec que des boules de glace cacao.', '2019-06-21T07:05:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25995, dab6e272-a98a-4587-b153-60cfc83edcf1, 'Bon mais sans plus', '2017-05-23T23:58:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25995, a1d79840-387e-499d-a1d2-64f76e016a3d, 'Bien, mais je suis d''accord la fraise ne s''accorde pas avec le reste', '2017-05-12T11:38:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25995, d056be44-485e-4971-9b24-c408cf9411e6, 'Faire chauffer la banane. 15 secondes au micro-ondes et on peut vraiment se passer de la fraise.', '2016-05-21T23:57:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25995, 1f9c84e1-68b2-4313-b824-9d43d6d6f2a3, 'Super recette j''adore ', '2015-02-20T22:08:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25995, 4058949c-cf82-47ac-a2f9-9ffe744fa2d5, 'Très bon mais moi personnellement j''ai mis glace vanille et glace pralinée, ça suffit largement je pense. Sinon ça change des desserts qu''on n''a l''habitude de faire. Je le referai sans problème ', '2015-01-20T15:44:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25995, 5f370970-c0f1-44b3-b3d5-6fd7b5847a90, 'D''après mon mari, super bon mais meilleur sans la fraise !!', '2013-10-03T13:36:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25995, ce501b6c-e239-4f84-8c00-36535db2d6bf, 'A la place de la sauce au chocolat je mets du nutella.. un vrai délice les enfants adorent', '2013-09-21T10:35:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25995, 2033d5e8-a421-4cde-bcd9-6fc00c074df4, 'Pour la facilité de la dégustation, je coupe les bananes en rondelles ; pour celle de la confection, j''utilise de la sauce au chocolat toute faite et de la Chantilly en bombe. Un dessert savoureux et vite fait !', '2013-06-09T10:41:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25995, ae7232df-3f46-4900-87f2-3fa02a14ec03, 'Avec des boules de glace vanille et fraise c''est excellent !', '2008-07-25T12:17:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25995, d7fd508c-302e-431c-9d28-6b7e004f67fe, 'Excellent il n''y a rien à dire (pour les boules de glaces c''est meilleure avec de la vanille)', '2007-07-23T13:47:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51997, ccb351df-37e8-4d04-ac9c-06d818908213, 'Très bon ! ', '2022-05-08T15:24:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51997, 435464e9-2e68-4789-beec-43d51a34ddda, 'Plusieurs fois que je fais cette recette, à chaque fois c''est un délice ! On ne s''en lasse pas ! C''est encore meilleur le lendemain, effectivement, car la sauce épaissit et prend bien toutes les saveurs. A tester pour les amateurs de sucré-salé !', '2021-04-19T17:45:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51997, f8423e15-4674-4b7a-a163-75cd9d3b7c82, 'Tous mes invités se sont régalés très bonne recette, je l''ai refaite trois fois déjà ', '2017-03-13T13:11:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51997, 1d463a60-91d2-407d-85a8-36cc3ecd1f4e, 'Très très bonne recette. J''ai mis de la coriandre moulue à la place du curcuma, pas mis d''ail ni les 2 tomates et le gin. C’était un vrai régal, merci.', '2013-03-07T15:03:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51997, c9b3b12d-19a2-4c13-828e-45e0f007fa3d, 'Excellente recette ! Très facile à réaliser. Encore meilleur à déguster le lendemain de la 1er cuisson. Je l''ai faite 2 fois. ', '2013-02-03T22:17:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29631, a09afffc-17f5-41df-ac7f-f55b677bba34, 'Pas du tout ! Le vrai Ti nains l''an mori se cuit ti nains épluchés et morue dans un seul et même récipient. La recette est correcte. Par contre, c''est un petit déjeuner à la base, tout comme le harensor ! ', '2013-10-26T16:31:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29631, 2426ba68-0490-4554-8b40-e88b8866c480, 'Mmm c''est bon comme là-bas, et la sauce est terrible. En revanche ça complique les choses d''éplucher les bananes avant cuisson, et elles noircissent :-( Je recommande de cuire les bananes avec la peau et de pocher la morue à part. Faire la sauce avec l''eau de cuisson de la morue. Si vous tenez vraiment à éplucher les bananes, enduisez-vous les mains d''huile avant, ça empêche la gomme noire de vous coller aux mains :-)', '2007-12-26T19:25:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18761, 8601891e-a188-442b-b5e0-8c285de31146, 'La prochaine fois j''essaierai de faire caraméliser le dessus car là c''était bof...pas assez sucré et pourtant je ne suis pas une inconditionnelle du sucre. Mieux vaut faire des bananes flambées!', '2010-02-23T09:47:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18761, 4da25b31-2a06-4180-954c-2284242b20c7, 'Très bon... Moi, ce que j''aime, c''est le goût de la banane!  ', '2005-11-06T22:00:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18761, 585e3678-549a-45da-8eee-2423dc356821, 'Très bon et léger. C''est plus une crème aux oeufs qu''un flan.', '2004-04-15T15:42:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18761, 93e0d1c2-eed8-47de-a450-5a37d1bcc377, 'Il est très léger et surtout très bon! Merci à l''auteur! ', '2003-06-19T19:15:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33488, 57884da6-1f72-4007-96fa-f673f3b308ba, 'Recette respectée à la lettre. Facile à faire, mais nous l''avons trouvée beaucoup trop sucrée. Aucun problème par contre pour éplucher l''ananas avec une pointe d''économe on enlève facilement les "yeux". Et pour les pros il y a tout un tas de vidéo  qui explique comment les enlever en diagonale.', '2020-02-02T16:01:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33488, 4b2bc26c-3136-41af-b515-0336eccb892d, ' Dessert chic, frais & léger. La sauce suffit à elle même sans la banane.  Super bon avec glace au caramel beurre salé.', '2016-12-23T19:35:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33488, 8d80feea-74a9-4d9f-9f39-bacac21c1416, 'Très bon dessert, assez épicé. Je n''ai pas mis la banane car je n''en avais pas et j''ai bien coupé mon ananas afin qu''il n''y ait plus "d’yeux" à enlever. On l''a mangé avec un peu de chantilly. Délicieux ! La prochaine fois j''ajouterai une pointe de cannelle. ', '2015-02-16T14:35:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33488, 39d68c1b-22c1-4e1a-ae4c-a95015af7316, 'Mmmm... Rien que d''y penser j''en salive encore ! Très bonne recette, fastidieuse certes mais elle se mérite. Attention : cette recette s''adresse aux amateurs de rhum ! Très bon dessert accompagné d''une boule de glace à la vanille.', '2012-10-10T21:24:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33488, e22ac2dc-a9ca-48bf-8bd5-93426f38db5a, 'Je l''ai faite avec 2 ananas victoria, plus parfumés et sucrés je pense. Présenté avec dans une cage de caramel une boule vanille et une boule rhum raisin, délicieux et faisant l''unanimité. ', '2012-01-01T12:04:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33488, 500e77d1-f903-4f55-9517-3b8a1d5f1985, 'Tous mes invités se sont régalés, certains en ont pris 3 fois. Seul bémol, c''est un peu long pour enlever les yeux. Mais la première partie de la recette peut se faire à l''avance, voire la veille puisqu''il faut laisser refroidir.', '2008-07-27T17:34:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33488, a40c4249-7346-4fdc-a069-b5eb27d9b701, 'Très décevant. J''ai fait cette recette avec de très bons ingrédients (avec et sans glace vanille) et le résultat était de l''avis de tous : "pas terrible". Sans parler du temps passé à retirer les yeux de l''ananas...', '2007-12-28T19:50:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33488, 87007597-2ef5-437b-bf93-cb81f6b27dad, 'Ajoutez l''eau chaude dans le caramel au gingembre, ça ''projetera'' un peu moins!', '2004-12-21T10:51:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46665, eddc86ea-8674-4e7b-9378-1b858006b11e, 'J''ai trouvé cette recette pas mal du tout; et le petit goût de citronnelle original.  Attention: le goût de citronnelle est un peu risqué pour les enfants (ceux qui ont gouté chez moi n''ont pas apprécié...) Et puis il ne faut pas laisser la viande trop longtemps au barbecue, car l''effet "papillote" de la feuille de bananier risque de disparait. ', '2010-10-16T19:39:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43721, 6ababf38-f405-4de7-92bb-cd5f3cce90fb, 'Un très bon mariage de saveurs : c''est exotique et c''est vraiment bon, je pense que la prochaine fois je mettrai plus de bananes et pruneaux. En revanche, c''est vrai que la crème supporte mal la cuisson.', '2011-10-28T23:47:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43721, 3aa96088-112e-4f7d-a762-030feee688b0, 'Très bon au goût mais la crème a mal supporté la cuisson donc présentation plutôt moyenne.', '2011-04-16T18:35:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43721, ce006df6-93f0-454d-b563-4c9c88c72da8, 'j''ai mis une banane et quelques puneaux en moins car je n''avais pas un poulet en entier mais des morceaux..je n''avais pas les epices demandées à la base, mais celles de remplacements et ce fut bon quand même! mon seul bemol, l''huile d''olive je n''en mettrais pas la prochaine fois je trouve que ca ne se melange pas au reste de la sauce!', '2010-02-26T11:01:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43721, 50592b33-6399-4b99-8bd4-50ecfa7e581f, 'C''est délicieux et en plus très très facile à faire! en 5 minutes on peut tout enfourner! J''ai mis des morceaux de citrons confits à la place de la poudre et c''était très bien. ', '2009-05-02T21:22:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43721, 0331237a-5092-4bfe-8839-11e5dec26e08, 'Un peu trop écoeurant. A refaire avec moins de bananes (vraiment trop présente).', '2008-04-13T12:16:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43721, 52b93616-6118-4553-b455-437b58121868, 'Super! On peut sans souci doubler les quantités de pruneaux et de bananes.', '2007-11-18T21:38:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43721, 8d73c844-5427-4361-acfc-1c89ca584c7d, 'Délicieux et ça a fait son effet auprès d''amis qui voyagent beaucoup. J''ai mis le double d''ail, on est fan, on recommencera! Merci.', '2007-01-10T15:23:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43721, 30d51138-35cb-4df7-ad58-9bd52786832a, 'Excellent! Le mode de cuisson, le mélange des saveurs, tout été parfait! Très rapide à réaliser, je l''ai fait cuire à 180°C pendant 1h30. Seul modification: j''ai mixé les bananes en rajoutant un peu de crème...quelle sauce! Miam! ', '2006-02-27T21:19:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 7a8943df-980d-4b91-986d-5a29eee6a907, 'Hyper simple a réaliser ', '2020-12-21T16:39:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 012d903e-3e14-4266-8682-0bb462bc55e6, 'Bof ! la pâte est trop dure et le Nutella chaud c''est écoeurant ! personne n''a apprécié ce dessert ', '2015-04-25T17:22:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 2898f461-cd34-4006-9d46-a85606a16e9a, 'J’adore ', '2022-07-07T18:19:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, a72b2862-2a16-4c9c-892d-f01cadb3a7c1, 'J''adore', '2021-08-21T08:18:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, b0b5378c-e334-4b00-a3ce-37b107deeca7, 'Extrêmement bon ! A essayer, la pizza Nutella banane donne un excellent goût ! Je recommande cette recette !', '2017-08-10T18:48:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, efb1c445-8e4e-4dcc-a48d-7ab1b90a09a8, 'Très bien', '2015-03-03T20:55:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 266638c8-7d0a-4db7-9bfc-523ba7bf6265, 'Déçue par cette recette si attrayante. La pâte (toute prête) était trop dure, certainement car trop de cuisson, mais en laissant moins longtemps, le nutella dégoulinait... Et le goût du nutella chauffé est épouvantable.', '2013-04-16T11:25:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 78d2c0d9-cc83-4f38-be43-5e2807bb45ef, 'J''ai trouvé cela délicieux ! Mes filles, mon mari et moi même avons beaucoup apprécié. Je la referai sans aucun problème !', '2012-06-19T17:52:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, d0aaf2c0-ce5d-4494-b885-69b2a4aab8ca, 'Super sympa ! Les enfants adorent et nous aussi. Pas d''idée pour le goûter, pas de soucis. Fait en 5 min et dévorer en encore moins de temps !', '2011-07-31T23:48:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 78e9947e-8ef3-4154-9b98-0c17cbd6f657, 'Ma fille de 12ans l''a faite. Elle a fait la pâte, puis a mis le nutella + morceaux de banane et de pêche, par contre elle ne l''a pas repliée. C''était un délice !', '2011-07-24T23:15:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, a2a7f038-c926-455c-b309-b82a1fbd9aee, 'Très bon, j''ai adoré !', '2011-07-22T20:07:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, a169f86e-5896-4b41-8462-110181d623f6, 'J''ai fait la pâte moi-même,elle était dure. Je n''ai pas mis de fruits dessus. Ma famille n''a pas apprécié malgré les bonnes critiques. J''ai peut-être raté la recette, mais c''est vrai que c''est une bonne idée ! ', '2010-05-02T22:56:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, c76c2427-995c-4d8c-a2ac-c93595deee5b, 'Très bon. Je l''ai faite selon les goûts des invités, une partie banane et l''autre avec de la noix de coco râpée. J''ai adoré la partie banane. Par contre je ne suis pas sûre que mes invités aient autant apprécié que moi.', '2009-12-11T20:47:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 804748c2-6105-42e7-bbf9-1dd47c867e68, 'Très bon. Chez nous, on l''a préfère avec de la pomme, des noix et des noisettes.', '2009-08-06T16:49:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 434084af-c905-41d3-be00-6e2fa51554d2, 'Avec de la poire à l''intérieur ça marche très bien aussi ! Bonne recette à refaire pour le goûter !', '2008-10-26T18:45:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 385892e6-d938-4158-ae43-f17b6969db3a, 'Vraiment incontournable.', '2008-08-11T12:57:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 63305a31-74d2-400d-8469-84384bfe49be, 'Bonne, je l''ai faite avec une pâte à pizza maison légèrement sucrée (genre pâte à brioche mais sans beurre), par contre, les bananes n''ont pas été appréciées... trop sucrée au goût de tous qui m''ont dit : "la prochaine fois, ne mets pas de bananes, juste du nutella". Je n''y manquerai pas...', '2008-08-07T22:17:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 038d2d6a-c151-4d04-aaa9-a1be9382e560, 'Excellent. Je n''ai pas refermé la pizza et j''ai mis des nectarines sur le nutella avec des amandes concassées. La pâte à pizza était faite maison et le tout cuit au feu de bois.  Grands et petits se sont régalés.', '2008-08-05T12:43:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, e3c0fa8f-234b-46fb-9619-b5fc8d239003, 'Cette recette est top! Surtout pour les gourmands ou les enfants! On n''est pas obligé de plier la pizza en deux car elle est tout aussi délicieuse applatie (par contre dans ce cas-là il faut faire cuire un peu moins longtemps!)', '2007-10-20T14:00:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 5fafe192-e363-49a6-9971-90053e07fed8, 'Met encore meilleur avec de la noix de coco rapée ou des pommes à la place des bananes....', '2007-09-28T16:28:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, e51b5a81-1866-4c6f-a9cc-f2d6a11656b6, 'Très bon, je l''ai réalisé pour un dessert du midi... On a bien apprécié. Merci.', '2007-06-20T17:54:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 96c9def2-f7cf-450a-bf02-0c3ad8cd236b, 'Très bon, mais 15 min de cuisson, ça n''est pas suffisant; 20 min voire plus. Mais c''est très sympa avec pomme granny/bananes. ', '2006-10-28T12:50:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, c3f75f23-bf71-4214-8d97-b9e6c8b02b60, 'Ma première recette de marmiton... pas mal! Mais la pâte à pizza casse un peu sous la dent... A essayer avec une autre pâte peut-être.', '2006-10-14T05:03:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 0855dfc0-f04f-40b1-9e14-d9d9b894779b, 'Les enfants n''ont pas voulu goûter. Mon mari et moi avons trouvé cela pas mal du tout. Seul bémol, j''avais fait la pâte à pizza maison et elle était un peu trop épaisse. A l''intérieur, j''ai mis de la banane en rondelles, le contenu d''une petite boîte de salade de fruits égouttée et de la noix de coco en poudre. Vraiment sympa et goûteux.', '2006-09-17T19:19:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, a0762b5b-e85b-4313-99a3-f401913b1aa7, 'Un succès à chaque fois que je la fais!', '2006-06-18T23:58:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, b85a14ba-b2ff-4573-b0d3-9b67234e58df, 'Bien bon.', '2006-05-24T02:23:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, fb33f74c-1161-4726-b419-ff89508fd21a, 'Très bon.', '2006-01-26T22:06:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, acbddd58-8573-4e8f-8ea3-f91655a704c2, 'Très bon, avec des pommes!', '2005-12-14T21:04:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 23989ea7-2e97-40f9-9314-9b28b67c6db0, 'C''est une super idée, je faisais avant le même genre de "truc" mais avec de la pâte à pain que je tartinais de nutella puis que je roulais. C''était très bon mais très bourratif, alors merci pour cette recette qui est plus facile à réaliser et beaucoup moins bourrative.', '2005-10-04T17:58:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 50bef823-c058-475c-a67a-d22fe87bad18, 'Très très très bon! Il faut retourner le chausson à mi-cuisson (évidemment ça dépend encore des fours). Et nutella nature, sans bananes ou autre ça passe vraiment très bien !', '2005-08-26T17:42:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, adf6bee3-88f9-4d5e-a4d0-6b8bd111630b, 'Et bien même après une pizza tartiflette (recette également sur le site), ça passe tout seul ! Dévorée en moins de 30 secondes par tous mes invités. Vraiment à tester, et bien sûr à refaire !', '2005-05-15T20:26:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 6cb7725f-fd86-4a5a-adbe-dbecde6157de, 'Simple, rapide et sympa! Idéale pour finir du surplus de pâte.', '2005-04-25T17:58:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, bb4d0cdf-9054-43e6-bcd4-ebdef78800f7, 'Au début, avec une copine, on était un peu pessimistes, mais finalemnet cette recette est un vrai délice... Très agréable pour le goûter!', '2005-02-17T11:12:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 52ea5382-f0df-4e29-9eff-c146530160ee, 'Excellent, plutôt au goûter qu''à la fin d''un repas. J''ai ajouté des tranches de bananes, de fraises, de kiwis et beaucoup d''amandes.', '2004-04-21T02:34:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, c39cf552-13c9-4be2-86fe-c04ae481d20f, 'Excellent, rapide à faire... un pur régal! Surtout ne pas hésiter à mettre la dose d''amandes effilées, ça croustille encore plus!!', '2003-07-07T14:43:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, c04ac78b-0a64-41d1-b703-dc9c74e254bb, 'Je l''ai fait avec de la pâte feuilletée. Je pensais que ça allait être très lourd, mais non, c''est très bon.', '2003-07-04T15:06:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, 8bdc4d0b-229f-4417-a55e-93046d847471, '''Trop trop bon!'' a dit mon fils. Trop trop simple à faire et trop sympa comme recette, ajouterais-je!', '2003-05-06T11:13:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22191, e5918331-e791-45ae-a8af-158d2ac12e70, 'Je n''ai pas encore testé mais ca ne saurait tarder ! Vive le nutella et mille mercis pour cette recette, si délicieuse dès la lecture!!!', '2003-05-01T22:13:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335790, c01f90ec-8df8-4bb8-a6f2-24d1f9485740, 'Trop liquide !', '2018-07-06T14:46:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42494, 1c6d00de-3b2f-4e47-9048-af459633c318, 'C''est la bonne recette! Je voudrais juste préciser qu''il vaut mieux broyer les graines avec un moulin à café.', '2006-01-15T19:56:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166350, 5bf8a3d1-41b4-4ba6-b9ab-b00000820cc2, 'Verrines réalisées aujourd''hui pour le réveillon. On en a goûté une et je peux dire que c''est très bon et très frais. Par contre, je n''ai pas mis de kiwi et j ai mixé le fruit directement avec un demi yaourt. MERCI !', '2010-12-31T13:27:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23014, 42914853-99e6-4f6d-9aab-2b88c8c86c2f, 'C''est trop bon alors moi j''ai kiffé grave', '2016-05-19T23:15:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23014, 52e76d97-9125-4789-b9cc-f72b17c864cc, 'Délicieuse rien de mieux pour se rafraîchir en été !surtout pour les gouter d''anniversaire', '2015-04-02T19:29:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23014, b0955fe2-a3e8-4fd5-8153-af4ea1439d39, 'C''est trop bon, j''adore les jus de fruits', '2015-01-05T19:33:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23014, 59c6e810-3c0b-420a-871b-fdc063986e0f, 'Très bonne recette, rien de plus facile mais tout de même très bonne . Mes enfants ont adoré. Merci pour cette recette.', '2009-04-03T16:36:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23014, a86cb4e4-4c07-4d73-9378-f84a9d0214b7, 'Trop épais à mon goût, mais tout de même délicieux. Bravo!!', '2005-02-16T12:27:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23014, 25bca5cc-c02e-4a97-bce4-ca3cf5eebb7b, 'Impossible de faire plus simple... Et c''est une recette adaptable à l''infini! Elle était cela dit délicieuse telle quelle. Petite précision: en suivant la recette à la lettre, on obtient environ 1 litre de boisson... Et même pour les appétits moyens, ne pas prévoir que ça pour le goûter!', '2004-08-20T21:35:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61770, b5c3a493-d34e-47e4-abe6-9814bea36f8c, 'J''ai moi aussi essayé avec une boite d''ananas, c''est excellent. Merci pour cette recette.', '2009-05-15T20:10:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61770, a44cd982-79fb-4ec2-bc30-41e4d262830c, 'Tout le monde a adoré. J''ai utilisé une boîte d''ananas au lieu du jus d''ananas et de l''ananas (cela m''a facilité la vie). A refaire. ', '2008-03-16T21:28:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61770, ccd056a8-ec5b-4105-84a9-5560af8dc911, 'Pour 70 personnes, une franche réussite ! Très bonne recette. Merci !!', '2019-04-24T11:58:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61770, 9f073c00-6a30-4f38-b3ba-19f7c38ca807, 'Très bon cocktail ! Je n''avais pas de poire et j''ai mis de l''ananas en boîte, les invités ont beaucoup aimé. ', '2016-12-17T18:05:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61770, 591205fb-3434-40d9-8615-923fde5eb313, 'Super bon ! Il n''y en avait pas assez, malgré le fait que j''ai doublé les doses. Néanmoins, la moitié du sirop de sucre de canne est suffisant pour que cela soit bon.', '2009-07-20T00:41:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (349578, db31e938-5eb3-47ed-a3d2-07d4301e16dc, 'Très bonne recette mais j’ai remplacé la farine de sorgho par de la farine de châtaigne et à la place du bicarbonate j’ai mis de la levure. Le résultat est excellent...', '2019-05-14T20:51:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391496, 27e04580-efb1-40fd-a80b-1eacf7884847, 'Super gateau ! Il est simple à faire et bon. En plus on peut le faire en famille ou en petits muffins !', '2020-05-03T22:12:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391496, f9ff38f0-38b0-4805-97cb-5c6de6e72495, 'C''est délicieux !  !  !', '2020-05-18T16:17:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391496, ab9014a6-8d27-4ed3-9921-943328d455db, 'J''ai testé, c''est super cool. En plus cela peut servir si vous avez des bananes en reste. En plus il n''y a pas trop trop de beurre, pas mal.', '2020-05-16T00:53:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25197, ed1b4bfa-e933-41cb-a58c-cb2fcc610b94, 'Délicieux!!! mon mari ne pouvait plus s''arrêter! j''ai diminué la quantité de farine à 150g, de sucre à 80g et de beurre à 80g. Cuisson 30 minutes à 180 puis 5 minutes à 200 pour avoir une croûte craquante', '2017-03-29T21:16:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25197, b9f9b014-1ba7-43d2-aee6-7d4f7d9227a0, 'Super recette !', '2022-11-30T19:45:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25197, e624fb1a-1b2c-4574-9109-871d73085aa7, 'Délicieux, j''ai remplacé les raisins secs par des pépites de chocolat, le chocolat fondu, et c''était très bon !', '2017-03-22T20:00:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25197, 8141672f-14cc-4fd4-a8b3-f19005260a35, 'Très bon, facile à faire ', '2014-11-26T02:20:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25197, b4de4fbc-634b-44de-a063-d0f00061eb80, 'Bon mais trop de farine. Il donne une pâte trop épaisse. A compléter avec de l''oeuf ou du lait(de la crème).', '2009-01-28T19:19:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25197, f98066ed-0446-4d60-b922-97b515809040, 'Bon gâteau facile à faire. J''ai ajouté un oeuf car la pâte me semblait trop compacte. Attention, le temps de cuisson est moins long que celui annoncé! J''ai préchauffé mon four à 180°C et cuit mon cake pendant exactement 30 minutes. J''ai aussi remplacé le raisin par du chocolat noir.', '2008-10-17T20:23:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25197, c508108a-4d7a-415a-81eb-9f43e43da8b6, 'Excellent! J''ai juste remplacé les raisins secs par des morceaux de chocolat noir. Un délice!', '2008-07-01T19:36:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25197, 57500adb-57c6-44c5-94d5-514e1855cbe7, 'Un vrai délice : le goût de la banane associé aux raisins secs et le dessus croustillant à souhait, on ne peut plus s''arrêter!', '2006-02-10T16:54:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25197, ca7d75e9-9490-4757-95d3-8fe1e3548a30, 'Avec un peu de rhum, c''est encore meilleur! Très moelleux.', '2004-01-22T09:17:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25197, 7bbaeb72-fbe1-49a1-8667-bc0f795b0d42, 'Bonne recette! J''ai supprimé les raisins, mais par contre, j''ai mis un peu plus de levure.', '2003-11-02T18:43:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, 5f481fdb-eec7-475e-b832-754fca532958, 'Je n''ai pas mis les mûres et les bananes et le résultat est délicieux.', '2019-12-15T02:26:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, 667277e2-c364-4438-8946-635c343825e5, 'J''adore ! La seule et unique recette de mug cake que nous faisons !', '2018-10-20T04:54:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, 4a49b6a2-8566-4fb3-b958-7a50f83652d2, 'Une tuerie. Je n''ai pas mis de sucre, pas besoin. Je pense que j''ajouterai du chocolat noir la prochaine fois. ', '2017-02-05T21:23:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, 81f61285-6596-474e-98d0-c519832ec967, 'Top je n avais pas de mur mais 
j ai rajouté du cacao non sucré enlever le sucre et mis une cuillère de nutella sur le dessus après cuisson ', '2023-09-20T22:16:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, 195b1786-0819-4115-8970-c3e4dc44d51f, 'Très très bon ', '2022-06-13T16:58:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, 804fdfd6-e7a2-4f04-8927-f9472f9a74b5, 'Très gourmand', '2022-01-23T18:07:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, 342fa33f-8206-49c3-9c39-ad8197dea457, 'C''est pas mal mais j''aime pas le chocolat noir donc c''est trop fort pour moi .', '2022-01-14T14:08:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, a2ebb2d3-126f-45b2-9e30-b87a84a98aff, 'Pour une personne j''ai changé :
1 banane écrasée
Sucre en poudre au lieu de sucre glace
1 grosse cuillère à soupe de Nutella
J''ai échangé le lait par de la creme liquide (ce qu''il me restait dans le frigo)', '2021-02-17T22:00:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, b098fb20-15be-496b-81d3-e333c6e338bf, 'Une tuerie! 
Mon mug étant très haut j''ai mis un peu plus longtemps au micro onde.
Texture parfaite.
Inutile de rajouter du sucre! 
A refaire sans hésiter', '2020-05-06T15:14:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, eae63108-5396-4490-9844-3450bc214236, 'j adore l''idée de cette recette au nutella', '2020-04-07T13:47:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, 3439da68-3162-4d59-a3e8-f39bd689204a, 'Très déçue, ce n''était pas bon. J''ai suivi les instructions à la lettre, j''ai mis les ingrédients dans l''ordre, j''ai bien mélangé, mais au final ça ne ressemblait pas du tout à la photo, le dessus était cuit mais pas le fond et visuellement c''était vraiment moche. Bref, je ne referai pas cette recette.', '2019-04-06T10:58:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, 27e17ad9-cce5-458f-8810-47f26f199c03, 'Tres bon,  mais un peu trop de banane a mon gout, on sent plus la banane que le Nutella. Mais je la recommencerai quand même, car tres bonne.  ', '2017-05-27T15:37:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, b6223cbf-1dd4-4a52-a004-295ba7c6857f, 'C''est délicieux, la banane et le Nutella se marient bien !', '2017-04-25T20:58:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, 526b1840-18c0-4e0a-9d3a-514c4c30b202, 'Beaucoup trop sucré a mon goût ', '2017-03-30T17:54:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, 920bb63d-ed9e-4fbf-8991-22f317e6dce3, 'Absolument délicieux !', '2016-09-16T06:31:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, cbe4b7d0-2dfc-4b72-a3a0-3bffcf3fbaf9, 'Superbe.', '2016-03-01T19:16:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, c8eeb9f6-be99-469e-99b2-1fccb8bb7a6c, 'Excellente texture, la meilleure que j''ai pu avoir avec des mugcakes, peut-être parce que j''ai mélangé à la fourchette plutôt qu''à la cuillère. Temps de cuisson niquel. On sent la banane mais pas assez le chocolat je trouve (pourtant j''ai rajouté 1 cuillère à café de cacao, j''en mettrai 2 la prochaine fois !). Sinon parfait ! J''ai utilisé une pâte à tartiner sans huile de palme aux éclats de noisettes. Je n''ai pas mis le sucre qui est inutile à mon goût, étant donné que le Nutella est déjà très sucré et la banane également. ', '2016-01-21T19:31:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, 96245f45-2af4-41d5-ab40-3860cbf4c5b0, 'C''est vrai et puis c''est très bon moi perso j''ai enlevé les bananes de ma recette car je n''aime pas ce fruit mais appart ça c''était délicieux ', '2015-11-04T14:15:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334437, 45ddefe7-08eb-4417-a61e-a7d611ec85e7, 'Pas mal quand on a pas le temps ', '2015-10-24T13:44:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528217, b1e092ff-0f8d-4596-bcc6-b94eae7b9742, 'Alors j''ai dû rater quelque ', '2023-10-29T22:14:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528217, f35c5947-3290-4ad1-8383-06c0f0ff74a9, 'Très bon. La pâte était un peu épaisse à mon goût, j’ai rajouter un yaourt et c’était Nikel. ', '2023-10-21T21:40:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528217, bafc1a60-26c2-42ce-98bc-6dbc1cf20b20, 'Trop bon ', '2023-04-15T18:27:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (311821, 1577d86d-e63d-4d47-a3b9-69e6d917ce30, 'Délicieux. Je préfère mettre un peu plus de citron, voire quelques gouttes d’huile essentielle de citron. J’utilise du sucre de fleur de coco, à la place du sucre. Il en faut très peu.', '2023-08-15T11:19:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (311821, 6c1757d4-1ab5-4b62-86ae-41a3b011374c, 'Délicieux. Ma fille adore. Alors qu''on est difficiles pour les préparations à la banane. Attention 50 g de sucre c''est largement suffisant. J''avais pas de citron, j''ai mis de l''huile essentielle de citron. J''avais pas de gousse de vanille, j''ai mis un peu de vanille liquide. Puis j''avais bcp de bananes bien mûres alors j''en ai mis 4 plutôt petites. Bon appétit ! ?', '2019-12-12T08:20:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (311821, f8b84c62-829e-42ac-82e1-cea3ed88f689, 'Bonne texture, gâteau moelleux et bien parfumé. Pour les amateurs de banane surtout sinon la saveur risque de déranger. ', '2016-03-29T14:36:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (311821, 88a7d6b9-6e00-46c1-b752-e1a16bab02d0, 'Bon, facile à réaliser mais un peu fade. je pense ajouter du citron ou de la vanille la prochaine fois.', '2015-03-21T17:04:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (311821, 2ee7cfa2-e2c1-4b16-a6ac-41115f10bbf7, 'Je l''ai fait cuire 10 minutes de plus, très bon pour une pâtisserie sans gluten.', '2014-02-07T11:25:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, c972a18d-6feb-4134-93b9-0e5e1f6b2639, 'Très bon dessert! Pour ce qui est des proportions, j''ai fait avec environ 10 cuillerées de tapioka, 500 ml de coco et c''était bon!  Le seul truc, c''est que les perles collaient un petit peu!', '2008-06-29T19:59:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, c4a3e6d3-0543-4b4f-961d-993e33b5d6f6, 'Très bon ', '2023-10-08T21:07:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, ad018854-b5c6-43f4-93e6-51e6d9ef6058, 'Recette à éviter, ce n''est pas bon. Aucun dosage, pas de temps de cuisson, le sucre on en fait quoi ? ', '2023-03-26T08:56:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, 8ee6417c-3e1d-4afa-b0c6-80c7eab85fd7, 'Ce n''est pas la vraie recette des perles de coco, les proportions sont très mal indiquées, aucunes astuces en cas de galère (prépa trop liquide par exemple), le sucre n''est même pas indiqué dans la recette seulement dans les ingrédients !!? Il faut absolument regarder les commentaires pour réussir convenablement la recette... déçue de la présentation. C''est dommage car au final c''est plutôt bon (je les ai surtout faite pour ma copine qui ADORE les perles de coco tradi et elle a bien aimé) ', '2022-03-22T12:56:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, 9c91d8a6-c8b1-4aa8-ad3c-107ef6f541e1, 'Recette sympa. J''ai pris les proportions conseillées dans un des commentaires, et les invités ont apprécié. Par contre j''ai eu du mal à leur donner une forme bien ronde.', '2010-02-28T12:16:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, c5344400-6ef7-4f28-bdd4-e4862e5180e5, 'J''ai pas du tout aimé cette recette c''était très ecoeurant en plus ce n''est pas la vrai recette!!!', '2009-04-06T15:39:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, d2c05fad-c7de-4ee2-8540-1a33bb0754ec, 'J''adore ces perles de coco. Elles sont délicieuses. J''ai rajouté ma petite touche personnel en mettant du tapioca de couleur rose, verte et jaune: effet assuré.', '2009-02-23T18:06:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, bb8b47be-7a9d-4e34-8d2e-2fdedb180fdb, 'Pour éviter le côté trop liquide de la recette, il faut laisser refroidir et mettre au réfrigérateur. Par contre la recette n''est pas évidente à réaliser : manque des mesures!', '2008-02-08T16:33:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, dfe8435a-f921-4b60-96bd-5d21f4e8cc5d, 'Franchement, aucun intérêt. Assez difficile à réaliser parce que les indications ne sont pas top. Puis on passe donc de mauvaise surprise en mauvaise surprise (en évitant de justesse une entorse au poignet à force de mélanger le tapioca). Si on ne rajoute pas de sucre, ça n''a pas de goût. J''avais mis trop de lait de coco donc trop liquide, je les ai donc servies en vérines avec des bananes coupées dessus et mes invités ne les ont même pas finies! Cela veut tout dire...', '2008-01-13T12:22:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, acb1804c-a3b4-4349-b4f9-6d2d0999f6dc, 'Bon dessert, léger et facile à faire. Ce dessert agrémente très bien un repas asiatique qui est déjà suffisament chargé et lourd pour que le dessert le soi aussi. Recette à recommander pour un dessert simple et bon. Un basique asiatique (?).', '2007-09-09T12:18:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, 40b47653-deb4-41c8-ac50-21fe06e3b28a, 'Une bonne base, on peu encore chercher à réhausser les saveurs coco banane. L''astuce serait de pouvoir enfermer l''un des deux et avoir l''autre autour, et ainsi avoir deux parfums bien séparés. Bon courage!  je cherche la recette du nougat chinois au sésame', '2005-05-22T18:41:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, b867936b-03f4-49c5-8918-f196f690b549, 'Ce ne sont pas les perles de coco qu''on retrouve dans les restaurants chinois mais ça reste une recette originale car on retrouve énormément le goût de la banane. Ca reste une recette fastidieuse parce qu''il faut remuer de façon énergique et longtemps la pâte pour que le tapioca devienne transparent.', '2005-05-09T09:56:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, 36cf35e3-8177-4b9b-ba04-812b1ae0f11c, 'C''est pas génial à manger et on ne retrouve pas du tout le goût des vraies perles de coco.', '2005-01-08T10:34:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, 3f4eabc1-a64d-4a71-a45e-4577232e7677, 'Excellent.', '2004-12-07T16:51:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, f8b9bddf-20df-4fcb-9272-66bcd358d621, 'C''est très bon, la texture est effectivement amusante. C''est aussi un peu lourd. J''ai ajouté un peu de farine pour épaissir, car je n''avais plus de tapioca, et mis trop de lait de coco. J''ai attrapé une ampoule en remuant comme un fou pendant 25 min !', '2004-10-14T13:31:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, 1f3dc69d-0a90-45a1-8c6d-c2ae7b73d1fc, 'Je ne suis pas sûr que ce soit exactement ce que l''on retrouve dans les restos. Mais c''est très bon. Par contre j''ai utilisé ces proportions (validés au troisième essai): 200g de lait de coco, 2/3 verre d''eau, 160g tapioca, deux bananes et 2/3 verre de sucre (rajoutés dans le mélange juste à la fin de la cuisson). Puis j''ai roulé les boules dans de la noix de coco râpée.', '2004-04-24T13:29:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, 0aed5aa9-0a12-4a79-a7a9-94821fffc4a1, 'Très gluant (ce qui est plutôt agréable), texture marrante et bon goût !', '2004-03-03T22:09:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19227, 8e81f1b1-772d-4428-9aaa-efc743bd8fe5, 'J''ai goûté ce dessert chez une dame asiatique mais au lieu de confectionner des boule, elle fait ce dessert sous forme de crème (moins de tapioca ou plus de lait de coco). Les bananes sont laissées en rondelles et on peut manger ce dessert chaud ou froid : délicieux !', '2004-02-26T18:18:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16903, 8e80afcc-c59d-46ca-b17e-cc18490b835f, 'Très bonne recette, je recommande fortement.... ', '2014-07-05T16:49:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16903, 1317fd26-ebc2-4d99-9b8a-d919ba125920, 'Très très bon!!! J''essaierai avec d''autres fruits.', '2008-01-20T21:36:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16903, db6ee111-0960-4259-b8f0-c9426a117790, 'Pas de problème de tenue mais le flan a cuit 10 bonnes minutes de plus que le temps indiqué. Pour plus de goût, du caramel dans le fond du plat et un peu de rhum ont été suffisants. ', '2007-04-18T11:28:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16903, 60187563-6307-4d42-bf81-413178b0d4cc, 'Il faut 100g de farine et du lait au moins demi-écrémé, voire entier. Comme ça ça marche!', '2005-04-12T13:27:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16903, 70ba9edc-8a6c-4521-aaf8-9686660e0a59, 'J''ai essayé cette recette et heureusement, je n''avais pas d''invités!!! Le goût n''est pas mauvais mais c''est un peu écoeurant et surtout pas du tout présentable car trop mou.... dommage, mais peut-être faudrait-il un peu de farine ou maîzena???', '2002-09-29T19:12:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164591, e7ee5312-5c5b-461b-9a58-8054c5b0f57c, 'Nous avons super bien apprécié ce plat. Par contre nous avons pris du ris thaï et mis le tout à réchauffer dans la grande poêle. Super bon...', '2014-01-25T12:41:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13693, 2b3c3a0a-7dbd-447d-9fcf-4037be28fe1f, 'Très agréablement surprise par cet accompagnement poivron, pomme, banane, raisin. Une fois bien mijoté le tout se fond en une très bonne sauce.', '2019-09-28T20:20:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13693, 5e7e1321-97da-4937-9831-e170a9a302ca, 'Cette recette est délicieuse mais elle manque cruellement de détails.  Pour les temps de cuisson, voici ce que je recommanderais : - la viande = 1heure à mijoter - dans une cocotte - ajouter les poivrons en lanières à 30 min  de la fin de la cuisson, - ajouter les pommes et les raisins (trempés dans l''eau pendant 1h au préalable) à 12min de la fin de la cuisson, - ajouter les bananes à 5 min de la fin de la cuisson.', '2016-10-31T15:42:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13693, f23b3a12-8899-4954-b107-87008b976508, 'Très parfumé! J''ai enlevé les bananes à la fin car nous ne raffolons pas des bananes cuites mais ça donne un goût excellent! J''ai mis une pomme, une banane, un poivron et 3 oignons comme indiqué. J''aurais préféré plus de précision quand à la cuisson (pour ma part j''ai laissé mijoté 45 minutes, avec tous les ingrédients en même temps) et la quantité de curry... Un demi flacon, ça équivaut à quoi au juste?', '2015-02-13T03:10:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13693, ce2200c8-c052-43bd-8e01-49d153b57379, 'Très bon ! Je l''ai préparé au wok : parfait', '2012-04-28T18:53:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13693, 5c1c2c6f-8749-4855-9ac5-a80672dcc161, 'J''ai ajouté 1 yaourt, des amandes, remplacé l''eau et les tomates par une grosse boite de tomates pelées et 2 pincées de piment de Cayenne (en fin de cuisson). J''ai servi avec du riz (cuit dans de l''eau + 2 doses de safran) et des demies rondelles de courgettes sautées.En tout ça ne prend que 5 min de plus. Mes mecs sont très difficiles mais ils ont adoré...MMMMM moi aussi ', '2010-12-02T20:03:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13693, 341747f8-56d7-4c17-be8d-8a7c5054d79e, 'C''était trés fade au gôut et la sauce bien trop liquide! J''ai donc vidé la moitié de la sauce, et j''ai rajouté 3 grosses CS de fromage blanc, 1cc de coriandre, 1cc de gingembre, 1cc à de cannelle, 1cc de muscade , 1 poignée supplémentaire de raisins secs et là enfin çà a donné quelque chose d''agrèable en goût...', '2010-11-08T02:50:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13693, 573759c8-f9bc-4126-8ce6-43db5c2a86bf, 'Divin associé à un Julienas! plat facile et très convivial, riche en goût! même les invités peu séduits par le sucré-salé ont adoré !!! un seul piège à éviter: ne pas mettre trop d''eau sous peine d''avoir un jus trop liquide. ', '2009-10-22T14:25:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13693, 14199d93-32f6-4f25-8c55-655e0baaff3b, 'Se laisser guider par la recette ; on a notre plat pile à l''heure à laquelle on pense le manger ; " tout simplement une pure merveille"! Même pour les convives qui, parait il n''aiment pas le sucré salé y reviennent.', '2009-05-01T21:13:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13693, 271efda4-9054-47e0-a8c4-85e47e85c71a, 'Excellent, rapide et simple à faire (et à refaire!!)', '2009-02-09T16:42:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13693, 90378324-16ff-4812-bed0-f04b8a814602, 'Comme j''aime bien l''agneau un peu rosé, je l''ai seulement fait mijoter 3/4 d''heure à la fin. La viande est moelleuse, le mélange de pommes-bananes-raisins secs est fondant. Bref c''est un régal et les invités se sont spontanément resservis 2 fois. ', '2008-07-07T17:40:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13693, 2755d640-2317-4a33-93b0-22f0286bd2bd, 'C''était bon mais j''étais un peu déçue, je crois que j''ai mis un peu trop d''eau en voulant couvrir. A refaire, merci quand même!', '2008-01-29T16:56:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13693, 7e370b80-b5f5-4d58-83cf-9455ffd6b85a, 'Mmmmmmmmmm!!! Super recette bien relevée. Attention les quantités ne sont pas suffisantes pour les gourmands. Laissez mijoter longtemps pour que se soit bien fondant. Un peu pressée je n''ai pas coupé les ingrédients en tous petits morceaux mais la cuisson a fait le travail !', '2007-03-26T13:47:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13693, 543892f1-6df5-4e1b-bbb6-7dcf37193609, 'J''ai changé l''agneau par des escalopes de poulet, c''est très bon et ça cuit plus rapidement!', '2007-03-02T12:42:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13693, 72c9a010-27a5-4a2a-ae76-e95641c071c5, 'Excellent et très facile à faire. J''ai ajouté des morceaux d''ananas, d''abricots séchés et quelques pignons. Un régal!', '2006-11-19T14:09:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30957, d37c47bb-3528-409d-9feb-c0c9a51677f0, 'Recette réalisée pour une invitée intolérante au lactose, et aussi pour tester une nouvelle recette avec ma sorbetière, mélange préparé la veille en 5 min, puis 30 min de sorbetière, c''était très bien ! Merci.', '2012-02-17T17:08:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27934, 3a96b2a4-32e9-4bcb-a2c7-7d3e412e2a46, 'Extra j’ai mis 200ml de lait coco et 200 ml de crème et j’ai complété avec du bouillon, ensuite j’ai laissé mijoter pendant 30min. J’ai mis de la patate douce aussi. 
', '2021-11-28T13:42:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27934, 61897032-94d1-46c0-961d-cb2bf3158c5f, 'Recette toute simple et qui plait aux enfants. J''ai adopté le conseil de Xaca (200 ml de lait de coco seulement + bouillon fait avec cube pour compléter), utiliser des blancs de poulet, et précuit les pommes de terre. ', '2014-11-12T21:36:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27934, c0df8dfd-1f46-4a64-8036-0e6bb590d194, 'J''ai trouvé cette recette bonne, mais un peu grasse. Je pense que je mettrai juste 250 ml de lait de coco et 150 ml de bouillon de poule la prochaine fois. J''ai mis un mélange 5 baies à la place du poivre, ça donne un petit goût sympa.', '2009-03-05T15:06:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27934, 98bcf50a-6ffa-4a32-9181-2c6f03b72430, 'C''est vraiment délicieux et rapide à faire. Le mélange avec les fruits est divin, je pense qu il est préférable de faire cuire les pommes de terres avant.', '2008-11-26T19:15:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27934, 3729ff07-e161-45ec-8061-fdbda83a6426, 'C''est très très bon, à la place du piment, je mets du piment d''espelette, c''est plus doux pour les personnes qui aiment l''épicé mais pas le relevé.', '2007-11-20T16:42:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27934, 4b69bd2e-c08a-4600-81e6-34b4d3058b53, 'Extra bon!! Ca change et c''est très facile à faire!J''ai remplacé le piment par du poivre et des baies. J''ai également fait précuire les pommes de terre à l''eau avant de les ajouter au lait de coco. C''est un plat très nourissant.', '2006-02-06T17:12:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27934, dc528e22-5383-4e8b-b35f-bc3bba9e3ea0, 'Très Bon!', '2006-01-08T13:37:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27934, 32d2fa64-76d4-44b9-8a77-23fe8222392e, 'Plat complet, original, et très, très bon!!! ', '2005-10-31T15:17:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27934, b2ac2b0e-4b9e-4d75-a08f-e8be063b1944, 'Excellent!! Merci pour ce régal.', '2005-01-14T15:41:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86936, 9d46f7fb-aa58-4a09-84f7-14b70d0721a2, 'Moi je n''ai pas mit de jus de fruits, je l''ai remplacé par 100 ml de lait et un petit ajout de rhum pour relever le goût.', '2016-10-27T18:56:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86936, c532a5df-a6e1-4356-8b27-befb616dbd4e, 'Pas mal du tout, mais pour des raisons de santé je n''ai pas mis de crème fraîche. J''ai fait avec 5 bananes et deux oranges, c''était top !', '2015-09-18T20:51:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27881, 6baacea4-809f-4475-b849-a1df256426e9, 'Bon ..... sans prétention ....mais bon ', '2015-07-01T22:12:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27881, c5587e8d-83bc-4293-b663-60495d5945e5, 'Très bonne recette, rapide et efficace! Attention à ne pas mettre trop de vanille pour ne pas tuer le goût des autres ingrédients. Un seul regret: la feuille de brick a tendance à se déchirer en dessous lorsqu''on la décolle de la plaque. Mais cela n''enlève rien au goût!', '2004-10-27T22:47:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82706, b0e10e61-b3f8-4148-a26e-1175d52c6aed, 'Surprenant mais surtout excellent. Ne pas prendre des bananes trop mures pour garder le bon équilibre bananes/tomates/curry. ', '2013-08-18T19:09:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82706, 95434a46-f796-4b1c-b7f1-cd359d6ee76d, 'Je viens de tester cette recette. Le goût sucré de la banane se marie magnifiquement bien avec le curry et la tomate. Un potage en entrée sucré-salé qui vaut le détour. À refaire.', '2013-03-24T20:56:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82706, 0831f90e-d0cf-41e5-9095-17c3dcf42289, 'Mélange de saveurs amusant & réussi. Bon potage "différent".', '2008-12-22T23:43:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82706, cff21b81-438f-4182-86c4-5a0c6e38fd5a, 'Un peu surprenante la banane dans un potage salé ! J''ai bien aimé. J''avais justement une banane un peu mûre qui a ainsi trouvé une fin appréciée, alors que crue...', '2008-11-24T10:40:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82706, d342f7c8-88fa-47b7-b9a0-9df434e7185e, 'Cette recette figure déjà sur le site sous le titre "potage à la banane (brésil)" avec des proportions légèrement différentes. Cela dit, cette recette est à essayer... Surprenant et délicieux!', '2008-11-10T22:09:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70492, 1f7d5caf-06cc-41e2-8c65-d2f084121ad3, 'La recette de la pâte ressemble plus au gâteau au yaourt...', '2019-02-15T07:45:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70492, 5e2c2151-8186-454b-a182-106fda691054, 'Excellent ! La prochaine fois, je mettrai un peu moins de sucre cependant.', '2014-12-24T19:28:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70492, cf8ca460-697a-4335-b026-4d1193fcd9a0, 'La texture n''a rien du cake... mais niveau goût c''est pas mal', '2008-05-19T23:38:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70492, 0c41caab-2603-4677-b14a-4c349ddbabc7, 'J''ai mis 2 belles bananes et fait cuire dans un moule à 4/4. Servi avec une crème anglaise pour soirée entre amis un délice. Mon amie a suggéré de monter les blancs en neige pour aérer un peu. De toutes façons je le referai.', '2008-05-14T12:41:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56514, 61298e13-8546-4b62-aabe-b651749f88b9, 'Testée pour utiliser de vieux fruits, la recette est surprenante ! C''est bon et léger ! Meilleur avec poires et bananes dans le blanc d’œufs qu''avec banane seule. Je diminue la température de mon four à chaleur tournante à mi cuisson et j''ajoute de gros morceaux de chocolats entre les rondelles de banane pour plus de gourmandise. ', '2015-03-26T12:55:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (383754, 242f881f-f291-4fc0-9e0b-de0119aa8781, 'Tres bon et simple.', '2023-11-15T11:12:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (383754, a4fd81e7-ffe8-4aeb-a4b6-dc1d11a292a6, 'Très bon.', '2022-10-20T20:18:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53848, 47a6f10d-c1ad-4520-a12a-f9cdd4ba6ff8, 'Les muffins sont excellents, ultra moelleux même 3 jours après. La prochaine fois j''essaie avec des poires', '2023-03-14T15:41:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53848, 79b4eee3-7537-4013-a698-343df5acf7fd, 'Vraiment délicieux mais problème à la cuisson. Je les ai mis 20min. La lame du couteau ressortait sèche mais au moment de les démouler, la catastrophe. J''ai réussi à en démouler 2. Les autres sont en piteux état. Tant pis pour la présentation. J''attends le conseil des autres pour m''améliorer à la cuisson mais sinon ils sont divins et gourmands.', '2018-06-09T06:43:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53848, 98b3338a-3809-4657-b30d-df36d6bc9183, 'Super bon ', '2023-02-19T12:00:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53848, 6e0a6725-85bf-4b0b-b98b-9528e9803523, 'Très bonne recette, je n’ai juste pas mis le rhum et remplacé le beurre par de l’huile de coco. Superbe goût !! Par contre, démoulage compliqué, c’est la première fois que ça me fait ça, pourtant ce sont des moules en silicones. Une petite cuillère pour curer le fond du moule et le problème est réglé 😌 Ce n’est qu''un petit détail, le goût est au rendez-vous, c’est le principal. Merci pour la recette 😊', '2022-12-05T21:02:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53848, bf968acd-be37-47e3-9f1b-793082967010, 'Réalisé avec seulement 2 oeufs. Très bon !', '2020-08-24T15:58:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53848, 72915780-3010-40ce-89c5-deec256b4a7a, 'Trés bon', '2019-01-26T11:53:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53848, 6a703e96-40ce-4430-a9ec-5623aa552320, 'J''ai cherché une recette pour utiliser des bananes trop mûres. Ces petits muffins sont délicieux et moelleux. J''ai alterné farine et beurre fondu pour mélanger (plus facile) J''ai mis un peu moins de cannelle et j''ai surveillé mon four... J''ai mis un peu moins chaud car il chauffe beaucoup...', '2018-04-14T16:41:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53848, 73fdb033-b3c5-4624-9806-4388c75c60bc, 'Nous nous sommes régalés !', '2016-11-09T18:36:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53848, 33a30b5f-43b3-4fa4-a3d1-3d3044759423, 'Une tuerie ! Juste parfait ! Personnellement, j''ai ajouté le beurre aux oeufs et au sucre avant d''ajouter la farine, sinon c''est juste brise - poignet !', '2016-03-31T19:53:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53848, 06b03141-9d15-4f1e-81f3-2ebd483e066b, 'Excellent, vraiment ces gâteaux sont délicieux, moelleux et d''un goût exquis. J''ai juste mis moins de cannelle, par goût. Bravo et merci.', '2011-03-23T15:56:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53848, e62d2a8d-d8af-4fe2-a143-8b5063d85d33, 'Excellent', '2011-02-06T14:54:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53848, 8f5ef90f-b4fe-4b6b-9112-6f3398ed994b, 'Les muffins sont supers, pour ma part je n''ai pas mis de canelle car je ne suis pas fan, mais ça reste  vraiment succulents...Je ne peux pas dire si ils restent aussi moelleux 2 jours après ils seront déjà tous mangés!!!', '2007-02-11T19:56:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53848, f69a0cdb-695b-4ff7-b68e-5d6b65f20989, 'Recette à revoir...les muffins n''ont pas gonflé, j''achète des sachets de 11 g de levure, donc 2 cuillères à café, ce n''est pas très parlant. Quant à la cuisson, 30 min au lieu de 15 n''étaient pas de trop, et encore, ils sont assez collants à coeur (et noires sur les bords). J''attendrai les conseils d''autres marmitonautes pour recommencer...', '2007-02-04T14:13:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29663, 5ba73cdf-b7d5-4226-93fd-9dd3ff694e6f, 'Super bon. La prochaine fois nous mettrons également un peu plus de tapioca car il a mal pris au centre du flan.', '2020-04-11T20:08:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29663, 054eef97-88d3-43ba-807f-54129f09b485, 'Très bon flan, facile à faire et original. J''ai rajouté un peu de cardamone au niveau des épices, ainsi qu''un peu de sucre.', '2007-10-09T02:51:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25090, 23c916fa-629a-460b-80de-2a5099187b69, 'J''ai aimé, mais je pense qu''un peu plus de chocolat ne m''aurait pas dérangée (j''adore le chocolat!). La prochaine fois, j''ajouterais de la cannelle ou de la noix de coco.', '2006-04-18T10:13:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25090, 7891cb4a-db90-4ecf-b20d-3186122694a0, 'Très bon et facile à faire, plaît tout le monde (enfin presque à part une personne qui trouvait que cela avait le goût d''artichauts!!!). Il faut cependant utiliser des bananes bien mûres car la deuxieme fois que je l''ai faite les bananes n''étaient pas assez moelleuses car pas assez mûres. Je préfère mettre des carrés de chocolat plutôt que du nutella je trouves cela meilleur (mais ça c''est histoire de goût). Merci pour cette recette.', '2006-01-06T15:27:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25090, f8c7e9e4-144c-4b0b-bd02-ea7ad7d004c8, 'Je l''ai essayé avec du Nutella, et c''était un délice... A se damner!!! On en redemande.', '2005-12-02T16:24:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25090, fea64add-9a09-4f2f-a8e2-daaf2d3f56bf, 'Très bon dessert, mais prendre des bananes bien mûres.', '2005-11-06T13:28:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25090, 96d1e284-f2cd-4be3-acf9-4b0755af891d, 'Ca donne un goût bizarre, avec la pâte feuilleté, mais c''était délicieux. A tester!', '2005-10-23T21:51:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25090, 640b1689-b766-4b62-85d2-61e41b6d43f1, 'Nous l''avons testée ce premier week-end un peu froid et déprimant, sur la fin de la cuisson on n''en pouvait plus d''attendre tellement ça sentait bon ! Je n''avais pas de pâtes feuilletées donc j''ai pris 2 pâtes sablées, et je n''avais pas de crème fraîche épaisse donc j''ai mis une brique de crême légère liquide...Il n''y a qu''un mot pour désigner cette apparition sortie du four: un DELICE !  On n''a même pas pu attendre qu''elle soit tiède, du coup plus déprimant du tout le week-end là.... Gourmands à vos assiettes !', '2005-09-19T19:30:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25090, 1ba87d1a-da42-4391-a14b-0e8db1770409, 'Très bon, mais la prochaine fois je mettrais du nutella pour essayer.', '2005-09-03T01:35:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25090, 59a07e86-2700-4844-93d9-184b38cc1481, 'Il est possible de la faire façon tatin (on ne met pas de pâte en dessous pour la cuisson) c''est aussi très bon!', '2005-08-31T17:30:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25090, 853d0987-a221-4cc3-960a-a60dd7f119cd, 'Le mélange banane et chocolat est délicieux, une recette que je referai et surtout une très bonne tête en sortant du four!', '2005-06-06T17:24:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25090, 24679604-f11e-4994-93e5-d2c2b7f012b4, 'Super ! Il faut effectivement dorer la pâte à l''oeuf pour un meilleur rendu esthétique. Ne pas hésiter sur la quantité de bananes et de chocolat, sinon on a l''impression de ne manger que de la pâte', '2005-03-26T11:24:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25090, 3a3744e1-b7f6-4383-9f16-ac5b954ae288, 'Je n''ai pas mis de rhum et j''ai mis la tarte un peu au four avant de servir .... un vrai délice .... ', '2005-01-15T02:47:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25090, 89d219b5-a0ac-4c3f-9d92-6ea5eba4a86f, 'J''ai complètement oublié la crème fraîche, et... les collègues ont adoré ! Ca rend la tourte très "béton", mais le goût de la banane y est très fort. En petites parts, cela forme un très bon dessert pour les amateurs.', '2004-09-14T22:34:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25090, 584707c6-23a8-4f65-aea8-ccfc41530b86, 'Badigeonner avec un jaune oeuf préalablement mélangé avec un peut de lait et de sucre en cassonade. Cela rend la pâte dorée à souhait!', '2004-01-29T16:39:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28278, a21d027b-2bd7-4fcf-83c4-e348504fcb1d, 'Très frais. J''ai parfumé au rhum blanc et modifié un peu les proportions.', '2020-10-10T11:34:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62194, dae6db75-7707-4798-bbba-b515bf0e6d21, 'Miam miam!... Mon mari latino était ravi, ce plat lui a rappelé son enfance! J''ai modifié la recette: deux bananes, le riz façon pilaf avec des oignons pour avoir plus d''arômes. Un conseil: changez le nom de la recette pour qu''elle soit accessible aux francophones ;) Elle est toute simple mais les saveurs se marient très bien.', '2009-02-07T19:52:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (308201, 46fd57cc-d898-4666-b091-b96c11f1d438, 'Super bon et rapide à faire ! Merci pour cette recette. ', '2018-03-18T11:10:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88656, 68a2366d-ff43-4c32-ae52-e871d622cfd4, 'Très bon gâteau, tout le monde a aimé.', '2019-05-27T09:46:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88656, 98178b41-c51f-428e-ad99-20404d73ab5c, 'J4enfoncerai un tout petit peu plus les bananes la prochaine fois pour qu''elles soient recouvertes par le chocolat, sans tomber au fond. Mais excellente texture, légère, moelleuse...', '2013-03-25T18:40:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88656, 2e5d0568-d044-42fc-ac44-0c4748c9fd19, 'Très bonne recette qui ressemble à un brownies, bananes bien restées sur le dessus du gâteau. Par contre, j''ai prolongé la cuisson dune dizaine de minutes. A refaire sans hésitation. Merci pour cette recette simple.', '2011-11-25T12:34:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88656, 592a0f62-62e2-482b-a622-1c965d6f92fd, 'Très bonne recette, gâteau léger et fondant mais je pense qu''il ne faut pas enfoncer les bananes car elles finissent par tomber au fond du moule ! Et puis j''ai laissé cuire pendant au moins 45 min.', '2011-03-11T20:07:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88656, 329939a6-062a-4522-9be9-c47e9c724d6e, 'Je l''ai fait en respectant les doses et ce n''est pas exceptionnel. Pour moi, ça manque un peu de beurre ou de crème fraîche. Pourtant, je ne suis pas pour les recettes trop riches.', '2011-03-02T00:28:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88656, 96326a4b-0ce3-46c4-a166-fb976039958d, 'J''ai essayé ce gâteau pour utiliser 2 bananes qui me restait. J''ai suivi les ingrédients à la lettre et miam, super le résultat : un gâteau moelleux à souhait, et un mélange chocolat banane bien dosé. Je n''ai pas eu besoin de fariner les bananes, juste de les poser et de légèrement les enfoncer à la surface du gâteau.', '2010-12-12T20:53:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31971, 4bfb329f-4d74-45f3-b55c-db7e08aabd9e, 'Pas terrible', '2010-09-30T00:17:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31971, b8f3e82c-5551-4f6d-b6b0-8a4680a317a9, 'Fait uniquement avec des bananes, je n''avais pas de poires) et c''était très bon. Facile et vite fait. Merci.', '2005-12-06T19:27:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31971, 035f791e-9a71-42e7-8e2b-da3f2bc5d47b, 'Décevant, personne n''a aimé. Le lait de coco a tourné en huile, le résultat: un dessert gras et pas très bon.', '2005-03-07T20:19:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94480, 04a0ca0e-becf-478d-8587-02119c4c32e4, 'Ce mélange passe super bien je suis étonné ! En plus c''est super léger, je l''ai adapté façon vegan mais superbe !', '2018-03-05T08:57:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94480, 0404f5e9-ee67-4eb7-81a1-6768f3e03363, 'Ok, je valide COMPLÈTEMENT cette recette. Je viens de la terminer et gouter (préparée pour ce soir), c''est excellent! J''ai juste ajouté 1 poireau aux ingrédients pour lui éviter la poubelle. Merci beaucoup.', '2016-10-27T18:12:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94480, 4d6d0d9a-0470-4e3a-991a-9d790192df1e, 'Pourquoi ne l''ai-je pas notée avant ? Cette soupe est délicieuse, faite et re-faite : mes enfants de 6 ans l''adorent. Pas de crème fraîche pour ma part mais 40 cl de lait de coco au gingembre et à la citronnelle. Pour en faire un plat complet, j''ajoute des " cheveux d''ange " et des crevettes. Merci beaucoup pour cette recette. ', '2014-10-11T22:42:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94480, 34651ff0-b007-462b-bf15-5695d82eee42, 'Très bonne soupe épicée juste comme il faut !', '2014-01-26T23:20:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94480, 2df12de5-935c-4dd7-90fa-82e4fdc69349, 'Potage cuisiné avec 2 poireaux, quelques carotte et 1 banane : un vrai délice. On ne se doute pas de la présence de la banane et mes invités ont cru que c''était de la patate douce à la place.  A refaire, sans hésiter !', '2013-10-02T00:06:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94480, b30b856d-76cb-4949-bcef-509616f10830, 'Très bien!!! surprenant ! Pour ma part, je n''ai mis qu''une banane. Le goût ne ressort pas et tout le monde a été surpris de savoir qu''il y en avait une dedans.', '2012-02-10T19:30:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94480, bad5224d-1121-4a94-a0e4-b8e400e7a304, 'Un régal pour les papilles ! Des notes subtiles de bananes et de céleri se mélangent, tout en finesse, ce n''est ni trop ni pas assez, c''est tout simplement parfait. Original, surprenant, la banane vient apporter une légère note sucrée à une soupe de légumes d''hiver ordinaire. Laissez-vous tenter !', '2011-11-20T11:29:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94480, 12724bd4-4361-4851-8c8f-4afe829e13d4, 'Cette soupe est surprenante et tout simplement excellente ! Je l’ai testée a plusieurs  reprises, et auprès de publics différents (adultes et enfants) : les assiettes de "soupe", d’habitude boudées, ont fait ici l’unanimité! Vous pouvez remplacer la crème fraiche par quelques cuillerées de lait de coco et le céleri banche par qq galets de purée de céleri congelée. Bon appétit !', '2010-02-19T23:59:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344906, 58e00687-6f2c-47eb-b983-32aabd781c98, 'J''incorpore les deux bananes écrasées dans l''appareil car je n''aime pas les morceaux de banane dans les préparations.', '2021-02-07T12:48:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344906, 4d5d559d-f402-4cf7-9bec-a4de982350e3, 'J’ai mis à la place un yaourt nature et un sachet de sucre vanillé, c’était très bon ! Je garde cette recette sous le coude pour les petits creux. Idéal pour moi qui suis enceinte et ayant le diabète gestationnel. Merci beaucoup ! ', '2018-08-24T13:43:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344906, 2528b692-ef87-4438-af64-269681283db9, 'Muffins très légers, un régal, j''ai ajouté du cacao en poudre pour un résultat banane-chocolat. ', '2018-11-15T08:58:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344906, 2c0e5614-b6ba-4ba4-ac74-0c97e7b8dba7, 'Tout simplement délicieux, difficile de faire un gâteau plus light. J''aurais simplement rajouté 1/2 banane dans la préparation. Je recommande vivement!!', '2018-05-27T12:39:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, 36b0c6f1-0a95-4c27-84c3-18036b75631e, 'Très bon. Je l''ai fait avec des blancs de poulet taillés en cube et j''ai ajouté 2 cuillères à soupe de crème épaisse pour allonger la sauce. ', '2013-06-23T16:01:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, da126d09-6435-4b39-b613-f798caafb109, 'J''ai ajouté du lait de coco avec l''eau. Très bon.', '2013-06-05T10:06:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, c5717fc4-8343-4972-82da-253f819641cf, 'Excellentissiiiiime, un vrai régal, les enfants ont eux aussi adoré.', '2007-11-14T14:29:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, a37b6000-3f97-40ae-989d-d2d1434c4ed0, 'Très bonne recette; mais par contre, rien à voir avec le colombo de poulet antillais!', '2006-09-09T19:29:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, d12691d5-30ed-4740-a6b5-5335c108c019, 'Excellente recette, facile. Le colombo est une épice qui change de l''éternel curry (très bon au demeurant!)', '2006-02-23T17:26:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, 6ecb57b3-187d-4f9c-a459-b99c8cee351a, 'Facile à faire de plus mes enfants ont adoré.', '2005-08-14T17:27:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, 3e6536b5-98a5-43c0-98b9-f6d497ad0329, 'Plat bien relevé sans ajouter de piment... Mais attention, il y a des épices à colombo plus relevées que d''autres! Je l''ai servi avec du riz thaï, des bananes poêlées et de la noix de coco râpée. Un pur régal!', '2005-05-29T21:00:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, 958e0f1e-1c5c-40e7-b2f3-caed64dbf414, 'Très bon! ', '2005-05-25T23:25:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, 580ff660-bbda-4487-84a4-b16091c3a583, 'Recette bonne mais qui manque d''originalité. Il serait intéressant de le servir avec du riz et des bananes plantain. ', '2005-05-18T21:20:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, c98e07d6-5f59-4151-b8d0-6742ed1869b9, 'Moi aussi, j''ai trouvé le plat fade. J''ai dû rajouter du curry, ainsi que des raisins de corinthe pour donner une touche agréable. Bon, mais ce n''est pas un colombo comme aux Antilles.', '2005-03-08T12:26:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, c79f0dec-10b8-4873-8e45-854a1e1dd54d, 'Est-ce dû à la qualité de mon colombo? Toujours est -il que ce plat s''est révélé assez fade et que nous avons ressalé et repoivré dans nos assiettes. Je ferai une autre tentative, mais avec du curry.', '2005-01-30T18:58:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, f553ec64-3e66-41a1-b5c4-e53155524a5c, 'Un colombo comme là-bas! ', '2005-01-16T20:51:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, edb9e7f9-6952-47e5-902b-a05505c1255a, 'J''ai déjà réalisé cette recette deux fois. Toujours avec le même succès! Juste une suggestion: pour aller plus vite, mais aussi et surtout pour plus facilité, couper les bananes dans le sens de la longueur plutôt qu''en rondelles. 2 min de chaque côté suffisent... Autre conseil: il y a plusieurs variantes d''épices à colombo. Certaines sont très pimentées. Mieux vaut goûter avant... ;o)', '2004-12-13T19:39:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, c3a1ec2d-cc43-47bb-8065-42faf93e9e94, 'Absolument fabuleux!!! Juste un petit détail... Ne pas lésiner sur la qualité du poulet. J''ai pris des cuisses de poulet fermier et non pas de l''emballé sous vide!!! Merci pour cette recette dépaysante.', '2004-06-29T23:24:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, 8bd26a72-9548-447c-a6ec-de945cfadb3e, 'Super! En plus, c''est facile à faire...', '2003-08-10T19:46:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18434, 5a1c5787-5475-4a47-acaa-99c1dc4e4599, 'Super, on s''est régalés!', '2003-03-17T18:51:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31110, f7c58f7f-6ac5-4262-9f5a-1bf69d2c01ff, 'Bof, trop gras et trop sucré.', '2004-10-01T13:29:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31110, fa78ac9a-dda6-4e9b-8e64-ff447a756995, 'Je n''appellerais pas ça un clafoutis... Pas assez de goût!', '2004-09-23T16:39:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336250, 54df44ec-f889-4c58-b0dc-92b838a45c59, 'Aucun intérêt. Trop gras, trop sucré, trop mince... Pas bon. Perte de temps et déception. ', '2015-04-13T16:12:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528523, 44f59a43-8b9a-483a-a126-0ec154cc749f, 'Top !', '2021-09-27T18:14:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50259, 194ab713-8ac2-4489-9f74-3728a6603b7f, 'J’ai testé la recette comme indiqué et c’était impeccable. Un bon goûter léger. Merci !!', '2019-06-15T10:58:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50259, 36a85cdc-20e8-4b68-8fed-cb5e08526a74, 'Je n''ai rien changé de la recette !!! Super pour le petit déj ou le goûter !!! Merci !!!  ', '2014-05-24T11:58:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50259, b83f3c7a-1223-482b-94f0-75dbfe3a0df3, 'Moi je mets une spécialité laitière aromatisé a la vanille ', '2010-03-01T12:27:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50259, ce7876e9-95f1-4ac4-84ee-930d4b744ad5, 'Très bon, personnellement je n''ai pas mis de glaçon, bonne recette pour utiliser des bananes restantes et du fromage blanc!', '2008-05-13T12:40:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 7bd84a7c-87d9-4c54-9d68-86cbaf5ab151, 'J''ai changé quelques ingrédients et franchement, c''était top !  J''ai mis du lait d''amande et moitié farine moitié maïzena ! 👍🏻 Je conseille de réduire le sucre !', '2022-07-17T18:56:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 1e765f9e-010e-4696-9d8d-d1c50b777e93, 'Miam !  J''ai rajouté de la coco râpée dans l''appareil et ai fait carameliser à la cassonade. Cuisson rallongée de 15minutes pour ma part. Merci ! ', '2022-04-10T08:56:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 6a302f83-d90c-44d7-8a4a-b7a4be8824ad, 'Mes bananes étaient fort mures. J''ai donc mis 150g de sucre seulement. Je n''ai mis que 40cl de lait et j''ai rajouté 3 cuillères à soupe de noix de coco rapée. Cuisson 40mn et laisser refroidir dans le four.
Une tuerie !', '2017-08-15T22:56:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, b5b93521-95fb-4fa1-813e-3268a75ddfe2, 'J''ai mis un bouchon de rhum et un de fleur d''oranger, et remplacé le lait par une boite de lait de coco, cannelle, vanille.... Excellent!', '2017-07-18T18:34:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 43953f65-876c-41af-9dfb-a22cad2182d4, 'J''ai mis 20 cl de soja cuisine + 20 cl de lait, 100 gr de sucre, 2 pommes et 2 bananes cuisson 45 minutes.  Lle flan était parfait, à refaire !', '2016-09-25T18:43:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 29f01c37-4cce-4e18-a905-877a1ea87a5d, 'J''ai essayé avec moins de sucre et il est meilleur à mon goût, même excellent ...j''ai mis des cuillères à soupe.', '2016-06-15T11:58:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, dea4e37e-dfd4-487d-8618-c110b2f9b51f, 'Heureusement que je n''ai mis que deux verres de 20 cl et que j''ai continué la cuisson (40 min environ) car le flan est resté malgré tout un peu liquide. Il présente très mal.', '2010-10-26T19:45:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 5d415382-dc57-4a15-a51f-30cfa958827d, 'Très bon, mais je ne mettrai que 2 verres de lait la prochaine fois. La pâte sera moins liquide et le temps de cuisson plus court (cette fois-ci,je l''ai laissé environ 45 min dans le four). Sinon, c''est délicieux pour les inconditionnels de la banane que nous sommes !', '2010-04-22T00:18:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 58c7073e-04eb-44b1-b866-cf7688de35a3, 'Simple et bon mais trop sucré. Il faut aussi revoir le temps de cuisson à la hausse ( 35/40 min ).', '2009-09-26T00:51:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 4a17397a-b384-40bf-b3f1-7e0c1e364d5d, 'Très bon flan mais je mettrai un peu moins de sucre. J''ai parsemé de coco râpée avant la fin de la cuisson (35 min). Servi avec une boule de glace c''est parfait !', '2009-08-08T16:42:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 50d6a4ca-8990-4e01-a45a-11fdb4094580, 'Très facile et très bon. Le temps de cuisson est un peu juste, une bonne cinquantaine de minutes mais cela dépend des fours.. J''ai mis 20 cl de lait de coco et 40 cl de lait de vache. Très bon goût. Une recette de plus à garder. Merci', '2009-04-09T17:33:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 960f23bd-9a40-4205-bf16-ee45daa0c755, 'Pas fameux du tout ..... la pâte n''a pas cuit et pourtant je l''ai laissée 1 h au four !!! C''est resté liquide au milieu et une partie de la pâte a collé au fond. Peut être faudrait-il préciser les doses (3 verres de lait c''est vague et 4 cuillères de farine c''est à soupe ou à café...) J''ai été déçue.', '2007-10-07T20:55:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 01027752-8ef9-4b2f-a24d-1dea84238c2c, 'Un vrai délice! je suis une inconditionnelle de la banane sous toutes ses formes et ce flan est vraiment succulent et facile à faire en plus!!', '2007-08-18T21:10:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, dfea3305-f266-4854-a66c-1c74ac4feed0, 'Recette trop sucrée et pendant la cuisson, le gâteau s''est partagé en 3 couches : 1 pas mal avec les bananes, 1 liquide et 1 de pâte collée au fond...Pas très bon et trop sucré :(', '2007-07-19T22:34:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 3da53081-aa1e-4129-9569-088bb5905aab, 'Absolument délicieux ! Je les ai cuits et servis dans des ramequins individuels en les saupoudrant de cassonnade 10 minutes avant la fin de la cuisson...Tiède ou froid, vraiment très bon ! Bravo !', '2007-06-30T10:02:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 6dfc55b8-ed54-4bb5-99cd-28404345b82a, 'Très fondant! dans des ramequins individuels, c''est épatant. Le temps de cuisson est un peu juste, je rajoute 10 mn environ.', '2007-05-13T16:14:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 86022a63-8de7-4552-b1f6-91c24db70d00, 'Une recette rapide et qui fera craquer toute la famille!!! Merci pour cette recette.', '2007-04-05T15:02:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 03db701e-86be-42e7-b568-85c8dfa25524, 'Super bon j''ai mis environ 37,5 cl de lait... J''ai fait 12 petits flans dont 4 auxquels j''ai mis des pruneaux pour varier les plaisirs!!', '2007-03-16T15:53:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 4ce231cc-4e68-43da-9cb0-0ac1d44a28a5, 'C''est super bon merci beaucoup! Toute la famille a adoré !', '2007-02-07T17:12:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, e0ba084f-6e2e-4267-951b-96a4688da9cf, 'Très facile à réaliser, il fond dans la bouche. A déguster tiède de préference.', '2007-02-02T23:51:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53882, 677a2643-de23-42b0-80ac-a3b283fb170c, 'Recette qui a été appréciée par tous J''ai simplement été obligée de faire cuire le flan 50 minutes + 10 minutes à four éteint.', '2007-01-30T20:03:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30256, 5f6be9a1-49b0-4242-bf82-32cce06f9f74, 'Miam.', '2022-09-20T12:13:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30256, 228b7bbe-d255-424f-92bd-36d297c2cfe0, 'Vous pouvez mettre deux triangles de toblerone, c''est également excellent.', '2007-06-08T20:40:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30256, 99fd439e-5be6-46cb-b6d1-bbecbd9235d2, 'Très bon, le mélange choco-banane, dans une pâte légère et croustillante. J''ai testé avec de la pâte à filo, plus facile à travailler que les feuilles de brick.', '2004-11-05T18:53:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30256, 6736b6b3-3076-4d35-81aa-77d80de10b3c, 'C''est très bon et facile à faire. J''ai remplacé les feuilles de filo par des bricks. Prévoir pour chaque convive une fourchette et un couteau car ce n''est évident de couper une feuille de brick garnie avec une fourchette à gâteau. Ne pas oublier la petite cuillère pour récupérer le chocolat fondu!', '2004-08-15T01:04:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49775, 74d36eaf-e4ad-4625-9c1b-5633cb66e20c, 'Pas mal, mais je ne connais pas la recette traditionnelle, je ne peux donc pas comparer... je n''avais que des petits beurre dans mon placard, ce que j''ai donc mis au fond du verre. J''ai cuit légèrement les rondelles de bananes citronnées et sucrées. Reste que le tout m''a un peu déçue... j''essaierai la prochaine fois avec un biscuit plutôt "mou" ou alors trempé au préalable... Merci quand même.', '2009-03-23T19:47:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49775, 058f83ea-c863-4d8a-a9e1-4c3317067d6c, 'Génial, j''ai juste mélangé le yaourt avec le toffee pour le rendre moins pâteux. ', '2009-02-11T11:04:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49775, 1e866702-3b93-4747-97e9-77107c6eb59e, 'Léger, je ne sais pas... Allégé par rapport à la version traditionnelle, on le déguste avec plaisir mais on est plus que rassasié après. Ça doit être la banane.. lol Merci pour cette recette extra.', '2008-04-20T15:34:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219242, fb089a10-be1b-433a-8d13-36547d10237e, 'La recette est délicieuse !! ', '2020-10-29T19:51:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219242, d5c801a4-5892-404d-9302-cba3bf070e7b, 'Fait avec 45 gr de beurre et 35 cl de lait pour une consistance épaisse et c''est très réussi comme ça. ', '2023-10-18T20:59:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219242, 2ed60203-cdf8-46ff-bd21-a38b13bf2f3f, 'Beaucoup trop de lait, c''est une pâte à crêpes...', '2022-05-01T16:39:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219242, 954449b3-4586-45da-914d-bdd9e4687925, 'Très bon, personnellement je préfère les faire à la première familiale.', '2016-07-14T19:48:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219242, e7e991d9-b8fe-4234-999e-1819bf8f56b6, 'Ce n''est pas mauvais, par contre il faut penser à mettre le sucre car il n''est pas indiqué dans la préparation de la recette !!', '2011-11-26T21:38:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, f836b8fb-2711-490a-8cae-a36edc564df7, 'Très bon gâteau quand on a plus d''oeuf. J''ai fait deux gâteaux l''un j''ai mis de la confiture l''autre du nutella et tout le monde a adoré. Merci pour la recette.', '2017-02-28T15:46:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, fb6d5e7c-fee0-4666-a884-9e963c7d9067, 'Très bon !! J''ai mis les mêmes proportions que vivi8565 en remplaçant les fruits congelés par deux bananes et j''ai mis 1 sachet de levure, 39g de sucre et 1verre et demi de lait. En faisant cuire 35 min environ, le gâteau est super bon !! ', '2011-10-12T20:50:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, 463676e2-6ebe-4c62-a3ff-8fed20e7cb1c, 'Vraiment au top ! Surtout pour un gateau sans oeufs, il est bon et moelleux. J''ai réduit la dose de sucre et de farine de 50gr ', '2018-05-08T09:56:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, 9b58b380-011d-4459-915b-164b0043884f, 'Proportions revues selon les commentaires je suis bluffée très bon moelleux bien gonflé super !', '2018-01-18T16:58:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, 0b22eafb-b5d8-4fbe-a20c-606b8e8128e6, 'Super bon gâteau ! J''ai remplacé le beurre par une courgette et le lait par du lait d''amande. J''ai aussi coupé le gâteau en deux après la cuisson pour faire une petite couche de confiture à la fraise [ voir photo ]', '2016-08-21T19:57:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, 9362d71c-e408-4606-b895-406d8edbfb90, 'Je l''ai faite se soir et très très bon ! 200 g de farine et 80 de maïzena que 100 g de beurre car j''en avais plus et 125 g d''amandes sans fruits c’était très bon !', '2013-07-04T22:15:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, 039425d2-74d6-436a-a6de-6ba943b6d8c3, 'J''ai fait des modifs sur les ingrédients en tenant compte des autres arguments. 200 g de farine dont 80 g de maïzena, 125 g de poudre d''amandes, 130 g de beurre, 200 g de mirabelles congelées. Résultat très bien mais a mon gout manque un peu de sucre. A refaire.', '2011-03-13T15:09:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, c77d4cc4-c715-421f-ba10-5042871e7145, 'Il faut mettre un peu moins de farine et plus d''amandes en poudre, et un peu moins de beurre, bonne idée de recette si l''on n''a pas d''œufs...', '2010-04-12T15:51:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, 01da34cc-4dc6-477a-8462-afe4a6192e6f, 'Bon goût mais trop lourd mais je le referai si je n''ai pas d''oeufs', '2009-11-11T10:58:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, a1bd4018-8d5a-4e6e-a591-f40d73371fcc, 'Ma fille nous a préparé ce gâteau pour le gouter avec des pommes. Pas mauvais du tout mais un peu lourd à refaire en essayant d''alléger.', '2009-01-16T00:20:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, c03ad310-3456-4eb5-989a-bea923de91dc, 'Trés bien l''idée de mettre de la compote et moins de beurre! J''ai ajouté une poignée de raisins secs dans la pâte et une pomme coupée en dés sur le dessus, c''est très bon et encore meilleur le lendemain et même le surlendemain! A refaire, bravo!', '2008-05-04T19:23:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, ef43e093-0a8c-4200-9631-6181585ddd69, 'J''ai divisé la quantité de beurre par deux et ajouté 100g de compote de pommes pour alléger. Pour avoir plus le goût d''amandes, j''ai remplacé la moitié de la farine par de la poudre d''amande. Le résultat va au-delà de mes espérances.', '2008-04-04T23:16:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, 88b7b392-bf36-4b89-ada7-44f769db4a92, 'Testés en petits gâteaux,sans fruits (j''en n''avais pas), en rajoutant un carré de chocolat noir au centre du gâteau pour faire un coeur fondant, et en remplaçant la moitié du sucre par 2 cuillères de miel. Résultat : un peu lourd, très gras (200 g de beurre..) mais bon ! Bonne recette quand on est en panne d''oeufs mais peut sûrement être "allégée" un peu sans perdre de saveur!', '2007-10-28T17:24:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, d2f30e15-e54a-4be8-bd24-4900d1312d27, 'Etonnament bon. J''ai divisé la pâte en deux : dans une pâte, j''ai mis 100g de chocolat pralinoise fondu et une poignée d''amande grossierement coupés au couteau et pour l''autre une pêche et une poignée de mirabelles coupés en petits dès. Le tout dans des petites caissettes à madeleines (30 environs) et saupoudrées de sucre. Croustillant dessus et moelleux à l''intérieur, c''est tout simplement magique. A refaire et à recommander en cas de panne d''oeufs... Et se sont mes enfants qui ont tout fait tellement c''est facile et ils ont adorés!', '2007-09-03T18:37:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, 4d8a2048-330a-4fe7-b5fb-2871f55f2f0c, 'Excellents! Préparé en petits gâteaux (un grand moule donne quelque chose d''écoeurant...) avec quelques amandes effilées au dessus... MMMMiam!', '2007-06-30T15:20:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, eaa8de3b-3ace-4609-9de7-b814081e54c7, 'Très bon gâteau bien moelleux, fondant, j''ai mis de la poire et des pépites de chocolat. Plus de gâteau en moins de 10 min au café. Encore merci.', '2007-06-22T23:24:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, 9eeb9aef-b244-4542-a404-9c50133b323c, 'Tres bien pour les allergiques aux oeufs. Très bon chaud avec une boule de glace au chocolat ou une crème au chocolat. Je vais essayer avec du chocolat en poudre et je vous dirais ce que ça donne. Encore merci et bravo, continuez.', '2007-03-28T16:07:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39961, 266582f7-d45e-4fa1-a1d8-fa0c5fe69d14, 'Très bon, moelleux et encore meilleur chaud. J''ai mis du "faux" beurre, ce qui en fait un gâteau idéal pour les personnes au régime anti-cholestérol.', '2006-05-08T14:49:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43621, 3fe2f9d3-5e5b-4350-8eca-89d82904b367, 'Très sucré mais très bon', '2012-03-05T17:19:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43621, 927c60ec-2d9b-45df-9d01-b6403f61e6fe, 'Miam ! Moi j''ai adoré tiède et avec moitié moins de sucre. Très bon et très simple. J''ai rempli 12 ramequins avec ces proportions.', '2011-10-13T00:19:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43621, 2df41a1e-9c42-4c8a-b1ae-d79681932bc0, 'Une très bonne recette, je n''ai mis que 120 g de sucre.... J''ai découvert les perles du Japon et j''aime beaucoup, merci!!!', '2011-08-17T00:14:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43621, 9d91a1c9-2ced-47f4-a58c-ede5f525f1c1, 'Je connaissais la recette pour l''avoir goûtée dans un restaurant. Celle-ci est beaucoup trop sucrée donc devient vite écœurante. Je conseillerais de diviser la portion de sucre par deux.', '2010-09-05T21:57:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43621, 3daed96b-1022-4dd0-9cb4-7e9f6a1ce1a6, 'J''ai remplacé l''eau par du lait, mis 4 cuillères à soupe de sucre, ce qui a mon goût est bien suffisant. Par contre, les quantités sont au moins pour 6 personnes. Mais très bon, très frais.', '2010-08-10T02:29:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43621, a9227fc0-5d42-4f44-98df-49ce87dd9dae, 'Vous pouvez remplacer l''eau par du lait (de vache, de riz...) et ajouter un peu de vanille en poudre pendant la cuisson, c''est encore meilleur.', '2010-04-19T19:59:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43621, bda192b1-ecef-4d7a-96d7-532ffa4d091e, 'Je l''ai fait avec du tapioca et mangé tiède: vraiment très très bon!!! et pourtant je n''y croyais pas du tout...', '2009-01-27T21:45:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43621, 4d33fe6f-bec3-4d50-8f72-499d377e7ba0, 'Chè vietnamien : se mange tiède (sinon le lait de coco est écoeurant). Le tapioca existe en perles mais aussi en petits serpentins de couleur, histoire de varier.', '2008-02-11T14:01:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43621, c78b19c8-05ee-4993-8e5f-cb49df4de612, 'Pour se la jouer perfectionniste : ajouter des graines de sésame grillées dessus au moment de servir!', '2007-04-29T21:37:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43621, 8103785b-fc51-47f4-84e2-2aeb32050f38, 'Très bon dessert qui me rappelle tout à fait un petit resto chinois qui en servait sur son menu. Super j''ai enfin trouvé la recette que j''essayais de copier en vain... A manger très frais et sans modération', '2007-04-04T01:29:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (173732, cd4897e4-27f8-426b-ab1e-c4d3e03e76bc, 'Delicieux, fais avec myrtilles 1x et le sirop,  bcp trop sucré ! Refais avec mûres 150g et 2/3 sirop, parfait! Merciiiiiii ❤️ ', '2022-07-23T13:43:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46392, f4523e5b-32d6-4424-8c13-493b95650ca5, 'Très bonne recette. Tout le monde s''est régalé. par contre j''ai pour ma part coupé les bananes en petits dès et ajouté au mélange avant de verser dans le moule. De cette façon on est sur d''avoir de la banane partout. A refaire.', '2016-11-13T17:29:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46392, f767a25d-1f52-4e7f-a949-967032a9e04c, 'Goût du chocolat très présent, gateau lourd mais très bon! La cuisson de 25 minutes est parfaite pour une texture de brownie avec le dessus craquant et l''intérieur fondant! Avec plus de bananes attention car le chocolat ne recouvre pas totalement.', '2015-02-26T00:04:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46392, 8ddff1f5-1991-4750-bc81-7b9858d47eef, 'Très bonne recette, 5 minutes de cuisson de plus ce n''est pas de trop.', '2014-08-28T19:01:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46392, 81272efd-dd91-494d-9902-06c50fae762a, 'Vraiment excellent. Tout le monde s''est régalé !!!!! J''ai suivi les commentaires en mettant les bananes au fond du plat et mis 50g de noix de coco. Je vais le refaire sans tarder. Merci pour cette recette.', '2013-09-01T12:41:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46392, 035cb78b-e7f0-43fa-aec6-ba3b3cc3173b, 'J''ai fais cette recette en mignardises (avec ou sans bananes). Mes enfants adorent. Je ne les cuit pas trop longtemps car c''est à peine fondant à l''intérieur à la demande de mes enfants. Succès garanti auprès des petits et grands ! Attention de ne pas trop en manger, cela devient vite écœurant.', '2011-10-18T13:04:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46392, 2ca65152-caee-44fd-80d3-d53ed450f804, 'Très bon....les bananes ont été disposées sur le fond du moule pour une meilleure homogénéité.. à refaire avec un peu moins  de chocolat et plus de coco car le goût de la coco est masquée par le chocolat... à tester également avec des fruits exotiques ', '2008-04-13T19:26:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46392, 1b390304-30cf-4168-a5d9-5f8d51492af9, 'Effectivement il faut faire cuire un peu plus mais ce gâteau est génial! Merci.', '2007-04-26T03:00:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46392, eec34b1e-63ac-4cfa-b7cf-d91d0edde9fe, 'Trop yummie!!! Je conseille de déposer les rondelles de banane au fond du moule     et d''y verser ensuite la préparation, au lieu de mélanger tout.', '2006-12-02T12:02:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46392, f6285d27-f4e7-4af3-8fef-d330aeb4481d, 'Bon gâteau, riche mais pas trop lourd. 2 conseils: Plutôt 30-35 min que 20. Et lui laisser le temps de refroidir, il est bien meilleur.', '2006-07-25T00:30:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46392, 62a0e51e-7c1b-4764-8ae2-35e0d9e87067, 'C''est excellent et les enfants m''ont dit que c''etait le meilleur gâteau au monde mais j''ai trouvé que l''aspect brownie n''y était pas et j''ai fait cuire au moins 40 min. ', '2006-05-05T16:25:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32604, 9d555658-a7eb-4883-94ff-b3dd7b2909a2, 'Une vraie gourmandise !!! Je l''ai même testée en tartelette avec un pâte feuilletée, un régal !', '2011-06-09T14:10:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32604, f44f3e3e-eb3f-40b9-8cb4-ce7e42439637, 'Excellente recette! Mon homme et moi avons A-DO-RE! Par contre, à essayer en beurrant un chouia le plat et non en y répartissant 25 g de beuure...', '2010-10-04T01:15:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32604, f98251cc-0b43-497d-97a0-9ce84810913a, 'Parfait : facile et vraiment très bon ! Mes invités ont adoré...', '2008-04-15T21:32:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32604, 77facc93-29a1-40c1-a61a-b1e797be8090, 'Excellent crumble! Facile et rapide. C''est un réel délice. A faire et refaire...Merci pour cette excellente recette', '2007-10-15T20:14:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32604, bde5188b-8e43-43a3-9adb-f61cb999c216, 'Délicieux, fondant et croustillant à la fois... Une perfection ! Merci à toi Olivia!!!', '2006-08-16T20:20:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11750, 96a106e8-6633-43a0-bfa7-584f6e1bb2af, 'Si je devais refaire cette recette, je ne mettrais pas de bananes. Franchement bizarre comme association, pour moi en tout cas.', '2017-04-30T20:11:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11750, 02807039-0b1a-408a-83d3-24d9304cfef6, 'J''ai préféré faire cuire un peu les rondelles de bananes en fin de cuisson. Le goût est plus fruité et ça évite au plat de refroidir. Mes invités ont bien apprécié.', '2011-01-24T19:54:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11750, 49e76efa-8bf5-4be6-b8cc-7badadd3ef31, 'Très bon et facile à faire. Je l''ai fait au wok pour plus de goût. C''est dommage de ne pas avoir les doses précises, donc pour 2 personnes: j''ai mis 2 blancs de poulet, 50 cl de crème fraiche, 2 cuillères à soupe de pâte de curry au cumin et à la coriandre et 1 boite d''ananas au sirop. Merci en tout cas pour cette recette sucré-salé.', '2009-05-16T22:41:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11750, c84d8489-30c4-4a07-875f-313e524d55eb, 'C''est bon mais avec des proportions précises ça serait + facile pour la 1ère fois. Il vaut donc mieux tester la recette (qui reste très facile à faire) 1 fois avant de la réaliser pour des invités ! Ne pas mettre trop de jus d''ananas (si non trop liquide) et peut-être un peu saler les blancs de poulets avant de mettre l''ananas. Avec pas mal de bananes et d''ananas, le riz n''est pas nécéssaire !...', '2007-06-07T16:24:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11750, df005181-1342-4c2e-85b8-25a1e68487a4, 'Très facile à faire, mais il serait plus agréable d''avoir les quantités exactes des ingrédients... Je l''ai fait avec un wok et c''était très bon!', '2004-08-01T20:54:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (370799, 1be9f8e2-b9a3-4034-b3d1-9a7061da19d7, 'Etonnant, mais excellent !', '2018-11-11T12:07:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165542, e4ebed10-237d-470d-b9b5-09b8caec5ed0, 'Excellent mais pour ma part j''ai mis de la creme glacer (glace au chocolat) au lieu de la crème dessert. Idéal pour l''été avec le coté glacé. Une tuerie!', '2021-05-06T17:52:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165542, b857e093-8d6f-4011-acb9-dd0884bd8364, 'Très bon ! Par contre j''ai omis les glaçons car mes bananes étaient prédécoupées et surgelées.', '2019-01-08T21:31:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165542, a51aa81d-4bb1-46f9-9f20-1cc4e6a8ba90, 'J''ai essayé cette recette et c''est vraiment délicieux. J''y ai mis plus de lait que dans la recette et c''est d''autant plus bon!!', '2017-08-05T23:26:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165542, a91ba6d2-efb4-4d93-96dc-40019b413487, 'Très bon ! Pour que la recette soit parfaite selon moi, remplacez les glaçons par une bonne boule de glace vanille ! ', '2013-09-19T21:34:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165542, 2c5a20f2-7121-4444-961c-8ee42b02e40f, 'Hyper bon et facile à faire ', '2015-01-21T22:08:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165542, 3e9f43d7-a944-4710-bb76-170527464f2d, 'Le goût et la texture sont au rendez vous dans ce fameux milkshake ! Recette que j''ai été heureuse de découvrir chez bachus ;) ', '2014-08-09T01:50:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165542, 47284b25-2f98-4a12-a4a3-9aaabd687e49, 'Simple et super bon !', '2012-08-01T05:41:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165542, f072962c-adcf-44fe-af42-32edf2b4c003, 'C''était très bon mais cela ressemblait plus à du lait à la banane et au chocolat qu''à un milkshake ! Cela vient peut être de la texture !', '2012-05-30T13:01:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165542, 23da665e-5582-48e7-8c67-0ca271b9e5fe, 'J''ai bien aimé le goût mais la texture ne m''a pas plu car je voyais cela plus épais ! Ce n''était pas assez frais même avec des glaçons ! Je pense qu''il faudrait peut-être le mettre au réfrigérateur ou au congélateur.', '2011-10-20T17:44:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (197565, f1056dfc-890f-4db7-9b7e-2c0cbe6209a2, 'C''est délicieux. Il faut cependant réduire les quantités. Facile à faire et goûteux', '2014-03-30T12:54:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (197565, 55cf1781-9f51-4212-a5ce-f9fdefdba54b, 'Délicieux, simple à faire. Ceci dit, j''ai utilisé 6 gros oignons et 8 plantains pour 4 personnes, c''était bien suffisant.', '2013-11-05T18:03:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13808, 45a05c1b-c584-42d8-b17f-a32b2f591f10, '1 citron pour une banane c''est trop acide, mettez un-demi citron', '2021-03-01T22:05:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13808, 0b141762-8132-4e25-a84d-96c02eeaaf3f, 'Top !', '2020-01-13T08:01:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13808, 7814a6ea-033b-43a6-9f2f-545027346bf3, 'Très bonne recette ', '2019-07-04T03:15:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13808, 5654d057-5b43-4ac1-b600-842a83fc63e2, 'Excellent ', '2019-06-17T07:47:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13808, 20683fb9-7116-42ec-9d2d-2388cd362059, 'Conseil suivi avec un peu de cannelle, le tout sur de la glace chocolat.', '2014-01-09T08:39:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13808, 0536f30d-c903-475e-8f5b-45cd4887a9df, 'Saupoudrer de canelle, c''est encore meilleur.', '2001-04-07T20:21:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13808, 4d3d1af9-d6ce-476f-a11d-3896c7e9e3b4, 'Délicieux, rapide, facile, pas cher.  Que demander de plus... Ah oui, choisissez des bananes pas trop mûres.', '2001-04-07T19:11:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13808, 01f04bfb-9a86-4a6c-ba0e-6ad170d02e04, 'Un message du Liban : très bon et très bon + cela ne prends pas beaucoup de temps!', '2001-04-03T16:03:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (342743, 8e91deaa-1622-4dae-8039-bd2636cf892a, 'Cette recette est très simple à faire avec peu d’ingrédients, de plus elle est excellente !', '2019-07-06T11:25:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (342743, 4df29a15-e840-482b-b768-4ae04194e09a, 'Au top ! Recette délicieuse malgré le fait que ce soit un peu lourd. 5/5', '2015-12-01T00:50:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38264, 0cb01733-062e-435c-88a2-795dbdc6ea7c, 'Je trouve que les saveurs ne se marient pas très bien...', '2012-03-26T20:48:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38264, e2613bf2-23a9-45e5-8e86-5e2f4a2769c6, 'Merci, pour cette recette originale, et économique... J''ai ajouté des dés de poires et de pommes, et quelques gouttes de sauce soja. C''était encore meilleur, réchauffé le lendemain.  ', '2005-10-21T19:22:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13380, c33cfdaa-763f-4679-a234-6ee0444914b1, 'Délicieuse et très facile à faire. J''ai utilisé des bananes qui étaient en train de se perdre. Un régal!', '2006-08-29T00:22:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13380, 4c3d4034-b54f-4bac-84e6-34c30bd0cf50, 'Super bon. C''était à la limite de la compote (j''ai peut-être pas bien géré la dose de sucre ??) Mon mari et ma fille se sont jetés dessus... A refaire (en plus grande quantité)', '2005-08-25T13:44:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13380, c1af97c7-08e8-41fb-b0d4-c1d3f1c4d706, 'Mmmmmmmmmmmm, divin, très bon gout !', '2010-04-28T13:08:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13380, 04850914-fd60-43aa-875e-c707c8dcc7e4, 'C´est bon bien qu''un brin pâteux. J´aime le parfum d´orange.', '2009-07-04T00:08:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13380, 551012db-e4ee-4430-bdc6-6b565638902e, 'Super rapide à faire, et délicieuse! J''ai mis du jus d''orange en brique, du jus de citron en bouteille, et un bâton de cannelle. Attention, les proportions sont pour 2 pots et pas pour 12, mais vous l''auriez deviné!! ', '2006-10-02T13:27:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13380, 09c0117e-d215-4680-9b79-ec5ffc028f97, 'Très originale, c''est un pur délice... Pour ceux qui aiment un petit goût acidulé, c''est le top... J''avais pas assez de bananes, alors j''ai mis 1 kiwi jaune en plus. Très bon et SURTOUT pas trop sucré!Merci pour la recette.', '2006-09-08T12:40:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13380, 208fba12-d8ca-44ae-899a-93a49b51e630, 'Très bonne confiture, peut-être un tantinet acide (question de goût et d''estomac...). ', '2006-01-02T22:03:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13380, 033bc2b1-0065-4c95-8334-364907fda331, 'Excellent! Une recette très sympa et pas acide du tout. Juste une petite précision: les quantités données permettent de faire seulement 2 pots, n''hésitez pas à les doubler, voire quadrupler, ça ne donne pas beaucoup plus de travail!', '2005-03-19T15:57:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13380, ade08e2d-60f9-4203-acd3-c6de6d77d947, 'Désolée, mais beaucoup trop acide pour moi...', '2003-07-03T23:39:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13380, 2c679c51-dced-400c-b96e-4f057e4da8b1, 'Très bonne! Mais je trouve que l''orange donne un goût acide, je les ai remplacées par un pamplemousse + 2 citrons verts + des gousses de vanille... Et là c''est encore meilleur!!', '2003-07-01T15:44:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13380, d337079d-35fa-429f-b80e-5b67b239e07d, 'Super... J''ai aussi rajouté des petits morceaux d''écorces d''oranges confites... Et dans une autre du chocolat.. Un régal!', '2003-03-26T16:53:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13380, 978fce4d-57f6-4a45-9138-2d6a97fa8bbf, 'Formidable et quelle originalité!!!', '2002-11-16T13:23:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13380, ef56f027-f84a-476a-bc6e-b64a54ee9a08, 'Je ne pensais pas trouver cela ici... Bravo pour avoir rentré cette recette très originale!', '2001-12-19T12:30:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13380, d2c69ac2-3a8d-49a1-8462-801067aacd14, 'Très bon... Un goût original.', '2001-11-08T15:16:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (307777, a84c4ff1-5a62-4cfa-815a-cf583ee3eabc, 'Rapide et sympa !', '2020-04-02T15:48:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36976, bdedee0f-929c-42dd-9886-0a8cd0ba3380, 'J''ai adapté la recette et utilisé du lait demi écrémé, franchement génial ! A consommer sans modération, on peut se faire plaisir tout en faisant attention, bravo !', '2012-01-21T17:59:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36976, 0922f0c6-7288-4058-983c-664d7b6d2e4c, 'Si vous surveillez votre poids et que vous fuyez les glaces. Dessert ou en-cas très agréable, à déguster sans modération ou presque tout en se donnant bonne conscience. J''ai utilisé du lait écrémé et un yaourt aux fruits à 0 %. La prochaine fois j''essaierai avec du lait concentré non sucré et des fruits frais.', '2006-07-16T14:51:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52749, 83d8058a-f0e4-4e50-af07-69e5b67ddc37, 'Impossible de faire plus simple, plus rapide et en plus c''est bon. ', '2016-05-26T13:28:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52749, d3c24567-66d9-415a-bfd0-864fa76558c7, 'Je fais ce petit dessert avec du sucre liquide, du citron vert et de délicieuses petites bananes laotiennes ! 5 minutes au frais avant de déguster, c''est très simple et très savoureux.', '2009-10-06T08:44:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (171059, 71c15533-b80b-4234-b79e-32fad8cd6a7e, 'Très bon goût, mais vite écœurant car trop riche !! Bel essai mais je ne renouvellerai pas', '2011-07-09T23:18:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211499, 0f5b3f85-19a4-4ddd-b962-aa42dbfe4fa2, 'Très bon ! Je refairais cette recette en cherchant une texture plus onctueuse pour la crème à la banane, bien obtenue pour la crème au chocolat.
Merci pour cette délicieuse crème !', '2021-04-05T13:52:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211499, 673dff54-a8d2-4bd8-b240-6972b02490bc, 'Vraiment très bon ! Idéal pour utiliser des bananes bien mûres, je pense que l''on peut en mettre deux pour un goût plus prononcé. J''ai laissé cuire pendant 3 min à ébullition en remuant avec le fouet. A refaire sans hésiter !', '2012-05-06T19:39:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (211499, ec4a5d41-b90f-44e2-a049-af1c173edbfe, 'Génial ! Par contre, on obtient des crèmes marbrées. Je vous conseille de couper le kiwi en barres et de les enfoncer dans la crème à la banane.', '2011-09-03T18:20:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59889, ef3ff938-2bd4-4d40-a7b6-7d29f62f2084, 'J''ai fait la recette dans un moule a cake; pour la présentation, mieux vaudrait le faire dans des moules individuels ; sinon c''est bon et facile. A refaire !', '2009-07-09T12:31:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 7e4a8740-3920-40c9-90b7-eee79b05e018, 'J''ai respecté la recette, résultat un peu sec. Suis déçue...       ', '2014-10-15T00:31:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, f92ecb63-819c-436b-844c-c1915efa615d, 'Super facile à réaliser et super bon ', '2022-04-30T11:33:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 6e6f6000-208b-4311-9be7-c87b25aaf4a8, 'Je n’arrive à faire cuire le gâteau correctement…il reste mou. Des conseils svp? Merci :)', '2022-02-07T23:20:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 4892d3ce-6792-4a5f-87f3-00cc513675f1, 'Délicieux (avec un peu de cannelle en plus... ) !', '2020-11-22T22:05:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, d53b7436-8e09-4cba-abe4-6e1dfe043dbd, 'Trop trop bon ! ', '2020-07-04T18:27:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 5aa2c385-6f46-4520-9e10-70d12af7c7c6, 'J''ai rajouté un oeuf parce que la pâte semblait un peu sèche. Et j''ai mis de l''arôme de noix de coco au lieu de la cardamome. Je pensais qu''il serait assez plat, mais le gâteau a quand même une jolie hauteur. Un bon gâteau facile et rapide pour le petit déjeuner ou le goûter. Je ferais probablement fondre le chocolat avec le beurre la prochaine fois.', '2020-02-09T19:57:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 7bdd3d42-8ec8-4df2-84d3-330f162c64e0, 'Un délice moelleux, j''ai juste ajouté une banane et un peu de lait. Facile et rapide à faire, je recommencerai car j''ai adoré.  ', '2016-09-15T15:33:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, b16a5c89-11a0-4127-a30d-717320595d0f, 'Super recette, facile à faire et délicieuse ! Le cake était moelleux à souhait et fondant.', '2014-10-08T17:02:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 38316a75-b64b-47c4-a0f8-c234482e3702, 'Recette super. Comme le préconisaient les commentaires, j''ai mis 2 bananes. Par contre, cela manque de sucre !!! Sinon top, facile et rapide.', '2014-07-14T13:42:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 023d9234-f0a6-4f9b-933c-2e26426cd887, 'Un pur délice ! Merci pour cette recette qui déculpabilisé les gourmands ! J''ai suivi les conseils des Marmitonautes en mettant 2 bananes écrasées, j''ai également ajouté un peu plus de lait. Recette faite sans cardamome ni cannelle, dans des petits moules à financiers et muffins avec une cuisson de 15 min et c''était très bon !', '2014-04-04T23:49:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 303bce3d-326c-4529-920c-80e35983205c, 'Très bon ! Cake léger et moelleux. Je n''ai rien changé à la recette, seulement mis 2 bananes pour relever un peu le goût. A faire et à refaire. Merci', '2014-02-09T12:23:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 1b36ab38-df33-43eb-865b-05c786edf922, 'Super recette...bien moins calorique que le cake traditionnel. 20 g  de beurre au lieu de 150 g... Les mesures sont justes. A parfumer à son goût, cannelle, pomme, etc. Bien léger pour se faire plaisir à tout moment...merci ', '2013-11-27T22:22:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, fa05c6f5-82dd-4d9f-a145-22d90f496940, 'Très bon ! Proportions comme sur la recette sans cardamome car j''en avais pas. Recette que je garde, merci ', '2013-11-04T23:36:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 151ab7ec-697d-4ad7-b76d-b1e7be303726, 'Un véritable bonheur en bouche ce gâteau ! Je l''ai testé pour un goûter, nous étions 4 adultes et il n''est pas resté une miette ! Je n''ai pas mis de cardamome et j''ai mis 2 bananes, c''était parfait !! A faire et à refaire à volonté... ', '2012-06-28T13:15:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, e21fef8b-f129-4f19-914d-044a48f56870, 'J''ai mis 150 g de farine semi-complète (T110), complété avec de la Maizena et rajouté un peu de lait au jugé. Suivant d''autres commentaires, j''ai utilisé 2 bananes écrasées, râpé le chocolat et remplacé la cardamome par de la cannelle. Résultat: un cake moelleux, idéal pour le petit déjeuner.', '2012-05-06T11:07:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 0c5084f6-b1d7-49ce-8b52-68b5add32680, 'Enfin un cake léger moelleux avec seulement 20 g de beurre ! Je n''ai rien changé à la recette, seulement mis 2 bananes. Impeccable !', '2012-01-30T20:58:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 5efbdd70-6a59-4d64-9cbb-5b74e1634d21, 'Moelleux, léger et sucré juste ce qu''il faut, ce cake va se classer parmi mes préférés !! Après lecture, des différents commentaires, j''ai modifié la recette comme suit : 150 g de farine (au lieu de 180), 2 bananes écrasées (au lieu d''1 en dés), le chocolat râpé (et non en pépites), de la cannelle en poudre (au lieu de la cardamone), le tout enfourné pendant 30 min à 200°C. Résultat : explosion de saveurs sous le palais et papilles conquises !', '2010-08-10T22:26:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 5effab21-4a90-48c2-b39f-6ca214ee21ec, 'Merveilleux ! J''ai mis deux bananes écrasées pour plus de goût et gardé le reste des proportions, c''était impeccable. J''ai utilisé un moule à manquer de 23 cm de diamètre. On a l''impression que ça fera un gâteau tout plat, mais il est très bien comme ça. Bien moelleux et peu sucré, chacun des différents arômes a sa place sans écraser les autres, l''équilibre banane chocolat cardamome est parfait. Merci pour cette recette !', '2009-12-22T12:24:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 232d72f0-59bc-49ff-83be-62abee48b3f0, 'Très bon ! Peu sucré, j''ai mis deux bananes pour faire plus ressortir le gout et j''ai fais des minis cakes accompagnés avec une glace et/ou le café.', '2009-05-27T11:50:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, f56733ed-422e-48e8-b976-f60c1da361c6, 'Il a eu du succès, mais, personnellement, je l''ai trouvé un peu caoutchouteux. J''ai du le faire cuire 10 min de plus en baissant le thermostat pendant ce temps supplémentaire, afin qu''il ne brûle pas. J''ai gardé les même proportions et j''ai remplacé la cardamome par de la cannelle.', '2009-05-14T18:40:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, bf65b3e8-bb7b-4df5-803e-52bc9dcac176, 'Très bon cake. Léger et pas trop riche. Juste ce qu''il faut. La prochaine fois, je tenterai d''écraser la banane pour qu''elle se mélange plus à la préparation. Pour mon four, 220°C c''était beaucoup trop, j''ai mis 200 sans la chaleur tournante.', '2009-05-11T15:28:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 8d908cb7-c4c9-4d8b-b3a2-ca87768856c0, 'Bon, mais il était un peu trop sec, je le laisserai moins longtemps au four la prochaine fois.', '2009-04-22T13:12:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 7853c94c-95c4-4447-a3e7-f475fe205914, 'Très bon cake, pas gras du tout, pas trop sucré non plus... ne pas avoir peur des proportions qui peuvent sembler riquiqui (surtout pour le beurre): c''est en mouillant la pâte avec le lait tout à la fin de la recette que la préparation devient homogène (auparavant c''est un peu granuleux). Excellent avec de l''essence de vanille à la place de la cardamome; je mettrai quand même un chouia moins de farine la prochaine fois!', '2008-06-16T12:50:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, 47f24d8e-fbfa-4193-9ad6-dcaea7d81d34, 'Très bon, pas trop sucré parfait pour le petit déjeuner ou le goûter, à refaire.', '2008-04-12T20:39:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63269, e0c47c51-6fdf-4adb-8dba-1f187a554394, 'J''ai doublé les doses et cuit 50 minutes. Je n''ai pas mis de cardamone. Résultat : très bon, super pour le petit déj ou le goûter! Pas écoeurant, pas gras, juste assez sucré.', '2007-12-08T11:16:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, a70b3b27-824d-487d-a830-6799ba9bc22f, 'Délicieux et original!', '2017-04-23T22:41:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, 6d49baba-5388-4957-ba09-3cba9737bd66, 'Vraiment bon, rapide, et en plus ça donne un petit effet. J''ai aussi doublé la dose de fruits, de cette manière on en a plus avec le riz. Par contre, le poulet était un peu sec, j''essayerai en couvrant avec de l''alu la prochaine fois.', '2011-04-25T14:20:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, 2e2a5433-e32a-4f00-b21f-1d2dbdd410e5, 'Une merveille. La prochaine fois, je ne prendrai pas un poulet entier (que j''ai eu un mal fou à découper) mais des cuisses ou des blancs. En plus de la recette, j''ai mis 2 pommes, 2 bananes, des raisins secs dorés et j''ai ajouté une sauce mango curry qui a donné un super velouté à la sauce. Après avoir tout mélangé dans une cocotte, j''ai transvasé dans un plat en terre et j''ai laissé mijoter 30 min à feu doux. J''ai ôté le poulet en fin de cuisson pour faire réduire et épaissir la sauce. Tout le monde a adoré !', '2011-02-17T21:14:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, adec64a3-f7f1-4d26-9ff9-8081a9634512, 'Cette recette est très bonne et en effet différente des recettes de poulet qu''on est habitué de voir! Je me suis trompé dans mes petits pots et j''ai mis du curcuma au lieu de curry... oups... Le résultat est bon tout de même mais j''ai hâte de la refaire avec du curry! J''ai accompagné le tout d''un riz basmati ainsi que du chutney de mangue! Parfumé à souhait!', '2010-11-06T03:35:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, 767dc3e9-ecc7-4a4b-a1f5-a4e1e97c32a6, 'Très bon, une manière bien agréable de manger du poulet. J''ai pris que des blancs, c''était parfait, mes invités ont adorés.', '2010-10-07T17:53:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, 6cbfa148-4baf-4b4d-89ac-972a3a73c699, 'Nous sommes un petit groupe qui faisons de la cuisine tous les quinze jours à thème cette fois c''était repas fruit donc on a testé la recette. Vraiment délicieuse avec option commentaire !! C''est à dire jus de pamplemousse et sauce lait de coco, miel, et mangue. C''était super ! A recommander à tout le monde ! Au moins ça change de l''ordinaire !!!', '2010-06-15T19:55:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, c243d079-50cf-4ea8-80c1-703d4476d089, 'Excellent !! On a suivi la recette à la lettre, en l''accompagnant d''une sauce mangue/lait de coco/miel/sur le riz c''était un délice !!!! Merci !!', '2010-03-10T21:20:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, 21f3ad88-7b6e-4e68-8c4e-4d67e672fc50, 'J''ai fait la recette avec des restes de poulet, que j''ai désossés et coupés en dés. J''ai remplacé le citron et le vin blanc, par un verre de jus de pamplemousse. C''était vraiment très bon, toute la famille a adoré. ', '2010-01-11T21:15:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, 21a9a351-cce6-4c47-a3b7-cb1ced09bfd8, 'Très bon! En suivant les conseils, j''ai doublé la quantité de fruits et je n''ai utilisé que des pommes.', '2009-01-19T19:40:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, 01f08a56-1982-4971-b9e4-cd0aba3f89d3, 'Extra ! Même sans vin blanc, ce plat étonne les invités ! J''ai pris en compte les commentaires des internautes sur le temps de cuisson : résultat super (c''est vrai que 1h15 fait beaucoup). En 30 min c''est prêt !', '2007-12-15T12:30:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, e7f7628d-ac14-4e75-a639-03c66d64d7f2, 'Je suis d''accord : 45 minutes de cuisson est largement suffisant. Sinon, très bonne recette, goût exotique. J''ai ajouté des raisins secs, contente du résultat. La prochaine fois, j''ajouterai des figues. Une recette à recommander!', '2007-11-24T16:16:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, d04a2358-265f-4ce1-a78f-0c82f049a0c9, 'J''ai décidé de réaliser cette recette pour éduquer le goût de mes enfants, de ce fait j''ai remplacé le vin blanc par du bouillon de poule et je n''ai utilisé que des pommes (4). Très bonne recette, seul bémol: temps de cuisson un peu long (45 minutes suffisent amplement)', '2006-10-25T16:02:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, 964b2d26-e7cb-46e2-97e8-6c09087e8b7a, 'On peut réaliser cette recette avec du lait de coco à la place de la crème fraîche, en mijotant 30 minute pour faire épaissir, très bonne recette.', '2005-11-27T16:56:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, 72db61c4-d408-4488-af5a-4d9b0c179458, 'Très bon, mais c''est un peu juste en fruits. J''ai mis du lait de coco à la place de la crème fraîche: ça va très bien avec les fruits et le curry, et c''est moins riche.', '2004-03-31T17:05:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, 9c0589c9-7bcf-4b72-b229-8d3ef30554bc, 'Exotique, facile, délicieux.', '2003-03-21T20:08:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13113, b8988e82-0e54-42ee-8417-d3ebd36adc29, 'Délicieux et tout simple à faire! On peut tout à fait doubler la dose de fruits.', '2003-02-03T15:47:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530329, 90efd35a-2340-4755-98f1-590fca1e1e30, 'J''ai ajouté des dattes, des noisettes, des pistaches, quelques morceaux de chocolat... on peut varier les ingrédients pour varier les plaisirs ', '2023-10-09T22:17:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530329, 475927f4-fee7-4945-a3e6-c85d536cce3b, 'Je n’avais pas de purée d’amandes j’ai mis de la noix de coco et des graines de potiron, j’ai rajouté un peu d’extrait d’amande aussi,tout le monde a aimé dans ma famille !', '2022-01-25T22:14:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28413, 7c1fb639-2fa4-47f4-9ab4-f787b6f290f4, 'Merci pour cette recette. J ai deja réalisé des beignets de Bananes dans le passé mais cette recette m a conquis par sa simplicité, la saveur des beignets. Un véritable régal.
J ai rajouté du rhum et de la vanille dans la recette mais franchement même sans on adore. Grand merci pour ce partage. ♥️', '2024-01-10T01:18:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28413, 7e271683-b1b5-442c-979a-e336fd2589a8, 'Magnifique ! C''est hyper rapido simple efficace et vraiment délicieux ♥️ Ma fille et moi on se régale !!
', '2023-11-12T16:56:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28413, d0674b2d-7e25-45c3-8fa3-c9b82263d89b, 'Super moche mais hyper bon! 
', '2023-04-25T17:21:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28413, 4961d069-8e0c-4654-8bea-d434b7644c11, 'Excellentissime !!!
4 bananes mûres,  230gr de farine, 1/2 bouchon de rhum, 75gr de sucre, 1/2 Sucre vanillé  et 2 oeufs.
Merci pour cette recette très simple et rapide.
Tout le monde a adoré ??', '2020-04-16T19:04:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28413, 15f75aa9-8b0a-4892-852d-eb7c15e5edef, 'Très facile a faire, et c’est super bon', '2023-01-15T20:52:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28413, 5d9671ae-64bd-4ebd-82fc-c4a56fcbf5cb, 'J''adore cette recette facile à réaliser et les beignets... . Un délice !  !  !', '2020-04-16T11:02:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28413, 2a068f22-4c88-4b80-a33a-18e1d39688ab, 'Génial ! Hyper simple et rapide ! Comme les autres, j’ai juste ajouté un peu d’extrait de vanille. Cette recette est juste extra ! ', '2023-07-20T06:15:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28413, edbaee94-0b53-411f-b6b8-f01642c039f2, 'Très facile et rapide !', '2023-07-01T15:02:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28413, 060336a6-d7c6-4e21-9776-9e34b3a6903f, 'J’avais deux bananes trop mûres, j’en ai fait des beignets avec la recette super super bon', '2022-06-30T18:29:45+02:00');
