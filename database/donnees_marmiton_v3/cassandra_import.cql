', '2020-08-31T16:58:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, e4a97fb0-d215-482f-9546-9d337ad8080f, 'Bonne recette très rapide', '2020-07-17T23:38:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 0cba3409-ae3d-49a1-9ab0-810029d5cd07, 'Goût de banane très prononcé ', '2020-06-15T13:48:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 85bae50b-fed0-4d7b-a96f-07cb8b351fd6, 'Délicieux !', '2020-05-09T17:02:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 1b86e10e-49e0-4667-9dd6-8240aac59f59, 'Excellent', '2020-05-05T22:00:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 59df0f5a-424b-43b6-b298-228e79a6a9e5, 'Trop bon ! Mais j''ai fait quelques adaptations forcées: - Chocolat noir aux pistaches caramélisées - Cassonade plutôt que Sucre - 125g de beurre plutôt que 175 - Piment d''espelette plutôt que du gingembre - Cuisson plus longue', '2020-04-08T22:32:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, b5b1d9c3-675c-4c3e-bc95-58a4190240ad, 'Très bon. Croustillant à l’extérieur et moelleux à l’intérieur ', '2020-04-05T18:38:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 18832651-f9e5-465e-8395-cfdf965f97ef, 'J''ai suivi certains commentaires qui disaient de ne lettre que 100g de sucre et une tablette de chocolat.
J''ai du rajouter une 15aines de minute de cuisson
C''est une recette que je referai, délicieux !', '2020-03-28T09:48:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, ced23fb2-d5c7-433d-b47f-ffd74d07c411, 'Super bon ! Je le fais très souvent !', '2020-02-24T18:59:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (532828, 0c22866d-99cc-4d46-b47e-698bed48ec4f, 'J''adore cette recette !', '2022-09-26T16:46:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34201, 86d88da2-7e1c-45d7-a7f1-ba20564e5401, 'Je donne 3 car il s''agit plutôt une compote, mais elle est excellente. N''ayant pas de fruits de la passion, j''ai mis 1 ananas, une mangue de plus et 1 kg de kiwis. Sympa, les morceaux dû aux fruits gardés pour la fin de la cuisson.', '2005-06-11T21:43:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (87126, 28edb672-8083-498f-a55f-5bd1a58745dd, 'La texture est d''une douceur... Très doux, à refaire absolument !', '2020-08-26T19:48:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (314997, a830d41e-fb3d-43da-8e0b-4b18463141a6, 'Excellente !! Je cherchais depuis longtemps à retrouver un petit goût découvert au restaurant thaï... Ça y est ! J''ai utilisé de la feuille râpée (Paris store) du lait de coco que j''ai fait réduire pour qu''il épaississe. J''ai poché les crevettes et ajouté des cacahuètes grillées non salées pilées et quelques feuilles de coriandre fraiche !! Hummmm un vrai régal. Merci beaucoup pour la recette ! Si vous aimez les goûts thaï allez-y !!', '2019-05-09T22:22:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, d9486152-ecce-4d20-9b13-f1fe964076eb, 'J''adore ! Super facile a faire, surprenant et tout le monde aime... Merci pour cette recette !', '2013-11-08T02:07:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, 427fe97a-a0f6-4f65-be0c-977c781019dd, 'Un vrai régal ! A épicer selon les envies avec un peu de tabasco', '2011-02-08T00:50:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, b49b0ec7-50e0-4c6e-b8f9-8b3d1a74df22, 'Passée la première mise en bouche qui est assez surprenante, le résultat est vraiment bon ! Mes invités ont servi de cobayes et ont beaucoup aimé cette soupe ! C''est très original, la banane adoucit la tomate et en plus c''est hyper simple à réaliser. Je n''avais pas d''auto cuiseur et en moins de 30 mins de cuisson c''était prêt!! Un régal pour les papilles!', '2010-03-20T11:06:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, 5d22d2f9-2ffb-4d46-adba-24f5cc155c25, 'Ce n''est pas mauvais mais ne faites pas l''erreur d''utiliser des bananes plantins!!!  Sinon ce n''est pas génial niveau texture!  Sinon avec des épices : miam miam, c''est doux, pas acide et très agreable ^^', '2007-06-19T12:38:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, 8d8e01a7-e781-41b9-adf5-2f36a9bf841b, 'Vraiment pas terrible, les enfants n''ont pas aimé non plus!', '2006-07-23T16:18:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, b3e41b47-e98d-4fc6-b27d-7ee4e8fe949d, 'Initialement faite pour mon fils de 15 mois, il a détesté... 30 min en autocuiseur, ce fut trop: le fond a brûlé! Pour moi la douceur de la banane casse bien l''acidité de la tomate, mais un peu de crème fraîche n''aurait pas fait de mal. Enfin, mon homme a adoré... en bloody mary!', '2006-03-01T21:26:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, 4994c69e-0bb8-4474-9489-d3153ce6eb04, 'Décevant! Pas immangeable, mais à mon avis sans aucun intérêt, très doux et plutôt écoeurant.', '2004-04-28T17:12:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, a67120ef-3eb3-46a6-a789-3ac72682615a, 'C''était délisieux.', '2004-04-05T16:58:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, c85d75be-0d78-40c0-9f2f-433d3f88c391, 'Au début, vu les commentaires plutôt positifs, j''ai essayé. Mais j''ai été déçu...', '2004-03-27T18:40:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, 26a586b7-38fc-4e7b-900a-db640214641d, 'C''est original et inattendu. Par contre, j''ai utilisé des bananes plantains que l''on trouve facilement dans les magasins africains ou asiatiques et qui ne sont pas chères. Ces bananes sont souvent utilisées comme un légume en Amérique du Sud ou en Afrique noire. j''ai aussi épicé avec du colombo et du poivre et le résultat est délicieux. La prochaine fois, je me lance avec les bananes classiques. Merci pour la recette!', '2004-02-03T11:52:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, f100acf8-fef0-4d94-80d5-4656f32f4629, 'Assez original. ', '2003-09-27T20:49:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, 3fa76b1d-c932-4097-8b30-a558774e2acf, 'Aspect et ôdeur désagréables... J''ai détesté!', '2003-08-07T17:40:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, 049c099d-9b22-41ad-a617-a32cfcba1cd6, 'Délicieux. J''ai rajouté un filet de citron et du persil hâché avant de servir. Très bon!', '2003-02-26T09:20:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, 8d941824-02fc-4a45-bb3c-f3a4a35df967, 'Il s''agit d''un potage qui surprend effectivement généralement les convives lorsqu''ils apprennent ce qu''ils viennent de manger - c''est délicieux. Personnellement, je mets deux cubes de bouillon de volaille en plus et j''ajoute une cuillère à café de curry et 150g de crème fraîche.', '2003-02-18T15:22:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, 280e6bf7-5858-4e44-a5ca-7d726e0b3227, 'Excellent, les commentaires se suivent et se ressemblent.', '2003-02-10T14:03:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, 76ca0da1-4c01-4896-b0e4-213b6f104fe9, 'Au début, on croyait à une blague... Mais on a été agréablement surpris de manger cette soupe qui n''est pas reservé aux enfants!! La banane enlève l''acidité de la tomate et donne un petit goût trés agréable, ça plaît aux enfants à condition de garder le mystère sur les ingrédients!!!', '2003-02-09T23:03:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, e0e783f7-2b13-4d44-b29d-b777b7c359ad, 'Excellent et très apprécié de seize belges, anciens du Congo. Merci.', '2003-02-03T09:42:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, a07ab2f9-fa5a-436f-9df9-8a20ae1d64fa, 'Excellent, original et très apprécié. A faire suivre...', '2003-01-04T13:21:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, 53aa3d49-3edd-4125-9ed1-141dd8508762, 'Facile rapide et bon.', '2002-09-15T13:46:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, 1cb9ebcb-fe36-4b73-aef5-2e0f9e5ae634, 'Extra, et pourtant je n''étais pas convaincue au départ... et très apprécié des enfants, en effet. En plus, c''est pas cher et vite fait!', '2002-09-10T13:05:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, ab94eca7-c7d3-4cbc-a6b5-fd10bd5d888f, 'Franchement, une horreur !', '2002-05-24T07:47:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, 7b067855-ef62-46b6-96c1-12f1be587169, 'Les enfants apprécient. On peut ajouter une pincée de poudre du curry.', '2002-03-18T16:53:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12003, 4d7143df-e03d-442e-802a-eca1f4814c4c, 'C''est effectivement très très bon! Le goût des bananes est délicat et estompe l''acidité des tomates. On peut ajouter quelques épices pour donner a cette soupe un goût encore plus subtil.', '2002-02-20T03:39:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57315, 089d2219-06ed-46d2-ae12-1c8c8bf99f88, 'Après quelques essais de cette recette, j''ai un peu réadapté ça en "brownie bananes". Je prend 6 bananes, que je coupe en rondelles et je les fais revenir à la poêle avec du sucre pour ensuite flamber un petit coup au wisky, ou ce qui traîne. Je met les bananes dans un contenant, je les écrase en gros à la fourchette, j''ajoute du chocolat (Pour ma part j''achète toujours le Callebaut, il est en grosse pépite), un peu à vue d''oeil, 3 petites poignées, avec la chaleur des bananes il fond déjà. A part je mélange les 2 oeufs avec les 100 gr de beurre et 200 gr de sucre. Je rajoute 250 grammes de farine et du sucre vannile, environ 1 cuillère à soupe. Ensuite j''incorpore la préparation bananes chocolat au reste. 35 minutes à 190°C chaleur tournante. Un moelleux extraordinaire, limite intérieur fondant à la dégustation.  Nous on en profite, encore chaud ! 
Ps: Je ne mets pas de levure dans cette recette, et je prends un moule assez grand pour qu''il fasse maximum 4cm d''épaisseur, et qu''on puis', '2019-10-12T14:38:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57315, d210317c-0061-4caa-991d-7d41b42b80ba, 'Top mais besoin de cuire plus longtemps.', '2019-03-30T04:08:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57315, 7bcfd91d-8db8-4595-8d16-ebe0de940d7c, '45 minutes de cuisson ce n''est vraiment pas assez ! Et je trouve que c''était trop sucré... ', '2016-08-22T07:32:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57315, 675ff919-f91b-49b7-ad86-49c37e293d87, 'Avec une chantilly (maison bien sur) et du sirop d''érable c''est encore meilleur !', '2011-05-03T13:52:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57315, 7b341cf7-839a-4bfe-9441-4977a8fee194, 'Un petit goût des Iles... mais les 45 minutes de cuisson n''ont pas été suffisantes pour moi, le milieu de mon cake était encore "coulant"', '2009-08-17T13:15:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57315, 29607603-2650-44cb-8c1b-c1ae82c72005, 'Le résultat est un peu sec mais un régal avec une crème anglaise.', '2008-10-21T14:23:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57315, 13b3bc63-aab8-45a9-96bc-e5836f9082ea, 'Je le trouve bon mais un peu sec. La prochaine fois, je mettrai moins de farine.', '2008-08-07T22:02:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57315, 7028be5a-cbd9-409a-96d2-5b5805d0e4a9, 'Très bon! Je recommencerais ! Par contre j''ai mis moins de farine car la pâte devenait trop consistante. La banane écrasée au citron fond dans le cake, c''est un délice !', '2008-02-20T19:42:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, f88eaba1-0bb7-49e7-ab7b-4844b32c8b45, 'Il faut diminuer la quantité de sucre et de citron.
La recette est beaucoup trop sucrée et citronnée!!!', '2023-05-15T15:56:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 2b254b79-a468-4057-ae0c-cbf632c61bb3, 'Trop de sucre ! Dommage.', '2020-02-07T18:58:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 539c1c05-54d6-43e0-8335-f34e56d5f2e9, 'Une bombe cette confiture. Miam !  !  ! Mettre moins de sucre, pas autant de cuisson inutile la recuisson une fois froide... (Vérifier avec une assiette froide voir si elle fige, valeur sur) La confiture ne devient pas rose pour tous (Pesticide? )', '2018-04-04T20:15:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 812cd289-8328-456b-a230-1ed9dd6338be, 'Pour 1kg300 de banane épluchée, j''ai utilisé 1kg de sucre gélifiant minute,et le jus d''un citron. j''ai amené la confiture à ébullition et compter 4 minutes de cuisson à partir de cet instant la. Ce qui permet à la confiture de bien prendre et de garder sa couleur d''origine. elle est topissime :-) ', '2015-02-12T17:31:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, a244480b-ac82-4412-a04c-868c2bb746f0, 'Excellente !!! Mis quand même moins de sucre (mais c''est mon goût perso) et ajouté de la cannelle et une gousse de vanille et un peu de miel !!! Le tout au mixer pour une texture lisse, un régal qui se mange à la petite cuillère (malheureusement, le pot descend trop vite...) Merci beaucoup de la recette', '2010-08-20T20:14:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 59d54f83-8fb3-47ae-ae81-9214b0ae46c1, 'Hyper simple mais j''ai suivi les commentaires : 400g de sucre pour 1kg et 30 min de cuisson seulement. Un délice. ', '2020-02-23T11:39:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, bd82351f-dc7e-458e-aa02-321125d72706, 'J''ai suivi les commentaires. J''ai réduit la dose de sucre, je n''ai mis que 300g pour 1 kg de bananes épluchées et c''est largement suffisant je trouve ça déjà très sucré, j''ai diminué le temps de cuisson, et rajouté un cuillère de whisky !', '2019-11-27T03:44:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 8d552a85-8291-4cae-b1ea-9bcc98106faf, 'Cette recette n''est pas top : trop de sucre, trop de jus de citron, temps de cuisson beaucoup trop long.', '2019-09-15T07:41:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 73a85eb5-270d-4bc2-82bb-4d1c98f4de48, 'Je confirme un tuerie. Merci pour la recette. Par contre comme beaucoup d''autres je n''ai mis que 400 g de sucre et le temps de cuisson 30 min.', '2018-12-30T03:49:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 0bdcff5a-0453-4c63-85cb-57e01f7378e8, 'Tout simplement une tuerie !', '2018-11-11T19:09:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 225e3480-cac6-4d83-8f66-6290363d33a5, 'Moins de sucre, mais 2 sachets de sucre vanillé et un peu de rhum.', '2018-08-06T12:43:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 2775c563-6061-4eeb-bf25-b1c49aefb69c, '1h de cuisson c''est vraiment n''importe quoi. 30 à 40 minutes suffisent largement et puis ça se voit à la consistance... plus on mets de trucs dedans et moins elles sont bonnes, il ne faut pas dénaturer le fruit mais le sublimer..
', '2017-08-19T18:38:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 3528c35f-2b72-4b5a-8069-e2b96d15042a, 'Pour 1kg150 de banane épluchée, j''ai mis 550gr de sucre, j''ai ajouté un peu de rhum brun, j''ai fait cuire avec une gousse de vanille, du citron, 40 mn, j''ai repris à peine 10mn ce n''était pas vraiment nécessaire. La prochaine fois je mettrais moins de sucre. Attention au rhum pour 1kg, une seule cuillère à soupe. Simple à refaire. ', '2016-05-26T10:57:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 36744aee-4a04-4800-8d75-af3b27536027, 'J''ai mis moitié de sucre gélifiant, un peu de miel et un peu de cannelle en fin de cuisson, la confiture est restée couleur banane.', '2016-05-20T17:53:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 708947fe-794c-42b4-9fd2-a8af83011c7e, 'Un peu trop sucrée pour moi, j''ai remplacé le sucre par du fructose (450g) et je n''ai mis que 150ml de jus de citron vert pour faire plus exotique et en touche finale 1/2 cuillère à café d''eau de fleur d''oranger. Cuisson beaucoup moins longue, avec le test de l''assiette froide... un délice ! ', '2015-08-11T15:38:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, c5a7d50a-b3b8-4ed1-8fce-d4d28f69acc5, 'Après 1 heure de cuisson le sucre était caramélisé. Et il aurait fallu faire une heure de plus ! Ridicule! Pour répondre à certains commentaires (combien les lisent avant ?), la proportion de sucre varie avec les bananes, 700g c''est bon pour des bananes peu sucrées. La proportion de jus de citron varie avec leur acidité. 30cl par kg de fruit est un grand maximum avec des citrons jaunes que je qualifierai de "doux". ', '2015-06-19T18:56:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 4ee161b2-92d1-42e2-8af7-1fdcb93b7eea, 'Pour 1,5 kg de bananes épluchées très mûres, j''ai utilisé 700g de sucre, j''ai rajouté de la vanille liquide et du rhum brun antillais. Cuisson 1h à feu moyen. A la reprise, j''ai mis 2 à 3 pincées d''agar agar et j''ai cuit 1/4 d''heure. Un délice !', '2013-01-25T12:39:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, c80ed546-a467-4bf2-bc36-729e30d5c31e, 'Excellente recette, j''ai ajouté un peu de rhum coco, de la vanille, de la cannelle, et le petit truc en plus pour ceux qui aiment 2 cuillères à café de fleur d''oranger.', '2012-12-15T22:49:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 74fd7b7b-b631-4e28-8792-f3ede4c8bb9a, 'Pour mon arrivée en Guyane, j''ai voulu utilisé le régime de banane qui a mûri d''un seul coût dans mon jardin. Résultat : grâce à cette recette erronée, j''ai gâché toutes mes bananes ! Le temps de cuisson est en effet beaucoup trop long, la moitié du temps aurait largement suffit, mais en tant que bonne débutante j''ai suivi les conseils des personnes avisées et surtout bien notées... La confiture est devenue plus que rose, parlons de rouge !!! Une fois mise en pot puis refroidi, la dégustation plus que décevante: beaucoup beaucoup trop sucrée... Tant pis pour moi, mais faites attention !', '2012-09-09T23:36:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 523ed4b9-8a94-4ad7-af1c-0799a92a2aac, 'J''ai rajouté de la cannelle, du gingembre (poudre) et du whisky. Un déliceeeeeeeeeeeeee. 550 g de sucre pour 1kg suffit. Bonne dégustation', '2012-07-31T13:09:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, de6af990-30a9-4eba-a2fc-ea1cbbc6270c, 'J''ai suivi les conseils concernant les quantités de sucre et le temps de cuisson : cette confiture est excellente !', '2012-05-27T18:27:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 1250ba2e-07b2-466d-8c69-f5b78d87373f, 'Très bonne recette de confiture, vient bien à point quand on ne sait pas quoi faire des bananes trop mûres. Comme lu dans les autres commentaires, ai mis moins de sucre 300g pour 850 g de bananes et je la trouve encore fort sucrée; j''en mettrai moins la prochaine fois; je l''ai cuite une heure dans ma machine à pain qui à la fonction confiture et ai ajouté un peu d''agar agar pour la solidifier et c''était parfait au niveau de la consistance. Merci pour cette recette.', '2011-01-29T18:24:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, f5e54f01-80d6-41f4-94b1-13f478c9afbd, 'Très très bon, mais la cuisson est beaucoup trop longue... Même si mes bananes sont à peine mûres ! J''ai simplement fait cuire la confiture à feu très doux pendant 20 min., puis 10 min.  Je la referai sans aucun doute ! ', '2010-10-30T23:12:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 69919cbf-9980-43b3-b2df-8f256acfa334, 'J''ai testé avec moins d''ingrédients: 700g de bananes, 400g de sucre (il en faut moins, je dirais 300g), et à peine 100ml de just de citron. 1h de cuisson a suffi pour faire épaissir, et je n''ai pas eu besoin de mixer (les bananes étaient assez mûres). Super recette pour utiliser des bananes qui restent...', '2010-10-03T20:10:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, bda56312-3185-456d-a93e-f3d17cd39bd2, 'Une confiture parfaite pour les gouters et petits déjeuner. Toutefois, j''ai utilisé 500 g de fructose.', '2010-05-25T23:41:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 47eca4e3-690b-49cc-b3fb-a5aba31d77dd, 'Excellente cette confiture, nous qui pensions qu''elle serait fade. J''ai toutefois mis moins de sucre (environ 600g) et fait cuire 2 x 45 minutes. Largement suffisant. Vivement qu''on la déguste avec des bonnes crêpes!', '2009-12-20T15:50:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, be37941f-d82a-40a5-b5c5-0c301a45446e, 'Faite avec des bananes de la Réunion, un véritable délice !!! A tester !', '2007-11-01T17:41:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 6aad634c-e742-4872-8da6-d7786c277ef9, 'Plutôt déçue... peut-être que je l''ai trop faire cuire aussi - le résultat est une espèce de marmelade un peu seche. La jolie couleur rose n''est jamais apparu. Ou peut-être que les bananes n''étaient pas assez mûres. ', '2007-09-09T11:53:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 4720f4ec-f58f-42eb-8013-045ec3a198ec, 'Un peu déçue parce que je l''ai trop cuite, mais je retenterai. J''utiliserai des bananes presque noires pour plus de goût avec un peu moins de sucre et de citron.', '2007-03-13T16:47:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 6fb087f4-4811-491f-b160-d17f42dc72ba, 'C''est délicieux pour les petits et les grands. Moi, je fais encore plus simple. 1 kg de bananes épluchées, 1kg de sucre à confitures. Cuisson 7 min. C''est tout.', '2007-03-06T11:24:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 251d1d33-4398-4047-959a-3cbbd99e8da2, 'Très bonne recette, on sent vraiment le goût de la banane, c''est délicieux. On la mangerait même à la cuillère !', '2007-02-13T11:53:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 95318bea-a1c7-4ded-85be-01ff2d30a71c, 'Original et très bon. A refaire.', '2007-01-22T16:23:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 8f05c7cb-75fb-4024-a138-c98411da1d2f, 'Terrible, c''est délicieux! Par contre j''ai mis moins de sucre, uniquement 500 g. ', '2006-11-26T22:07:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 37eab158-eb30-4ed7-8461-40f6095a998f, 'Un vrai régal! Un mélange très doux et une couleur à laquelle on ne s''attend pas. A faire et à refaire !', '2006-11-19T14:32:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, b81e4110-c4b9-47e7-969f-d1fa0887abbe, 'Un vrai délice, mi confiture-mi compote...ça change du traditionnel. Pour varier j''ai juste mis 125 ml de jus de citron et 125 ml de jus d''orange. A vos papilles...', '2006-11-01T13:27:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, eb84d960-6978-4d01-8174-f6e5d7e07a15, 'C''est extra!!! J''ai ajouté pendant la cuisson un peu de miel...ça donne un goût doux et sympa!', '2006-10-25T15:38:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, c97371d2-0ea3-4e1f-a802-4405f1635bfc, 'Excellente recette; Pour ma part, j''ai rajouté des orangettes coupées en petits morceaux juste avant de mettre dans les pots; Tout le monde a adoré.', '2006-08-22T13:32:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, e69ae8a2-b449-436d-9f2d-7cd68511668e, 'Délicieux, ma mère était sceptique, je l''ai convaincue. J''ai suivi le mode de cuisson, je mets du sucre cristal (un peu moins qu''indiqué) et à la fin j''ai rajouté une grande cuillère de rhum, bouh que c''est bon!', '2006-02-24T18:50:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, d5f61fef-0c9b-432f-909f-877306a6ec13, 'Délicieux! Je remplace le sucre en poudre par 600g de sucre spécial confiture. Le résultat fait l''unanimité, à tartiner sans modération, avec du chocolat fondu...Une bonne excuse pour faire des crèpes!', '2005-05-06T19:42:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, 5dbc32bc-8388-4a91-bc06-dd51cfe5c043, 'C''est très facile à réaliser et délicieux :) A faire découvrir :) (moi je mets de la cassonade à la place du sucre blanc).', '2005-04-22T14:06:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35478, e7a86dc7-3b88-4faf-b2c8-882555b9f66c, 'Parfait! Bien que je n''avais pas de quoi mesurer les quantités, le résultat est époustouflant. Je me demande si je ne vais pas l''avaler avant le petit déj de demain matin...', '2005-03-20T02:41:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 35d6556d-c8c1-489d-b917-aa70c2e53d72, 'Bon gâteau, j''ai suivi les commentaires précédents, à savoir 150 gr de sucre au lieu de 200 gr, le jus d''un citron dans la pâte et pour le nappage 80 gr de sucre avec le jus de 2 citrons.', '2022-02-28T11:55:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, dbdc0fc9-2cf6-4655-b8bf-7b2f19f8c29a, 'Alors c’est la pire recette que j’ai pu essayer. II a trop de farine, le gâteau à failli tuer mes convives. Si vous souhaitez tuer votre belle mere n’hésitez pas à le faire. ', '2023-12-01T22:16:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, b955a79d-714c-42e1-bd46-4e104458fcd7, 'J''ai adoré la recette. J''ai mis un jus de citron dans la pâte.', '2024-01-05T15:49:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, ba37478c-42e5-4678-8982-dff434017be1, 'Gâteau très léger. Moi, j''ai rajouté un jus de citron dans la pâte avant de rajouter les blancs en neige. Ainsi, le goût du citron est bien présent.', '2023-11-19T21:50:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, b1a0b530-c557-43df-9249-fd24160f23d7, 'Avec un yaourt et moins de beurre +1/3 maïzena et 2/3 farine. dommage que l''option "mon grain de sel" n''existe plus sur Marmiton, c''était bien pratique...', '2023-01-18T18:02:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 59dc1720-f5d4-453d-850b-cbc7c11fbdb5, 'Délicieux mais encore meilleur avec 2 citrons et leurs jus à l’intérieur du cake !', '2018-08-15T04:11:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, a1fe65fc-fa88-42f8-bf8e-499bcc02e05e, 'Bonne recette, ne pas hésiter à rajouter des tranches de citron confits.', '2023-12-09T12:35:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 886f1886-accc-4b69-932f-2d2a151df9bb, 'Cake au citron testé, mon reproche, c''est trop de farine donc très sec, niveaux zeste de citron pas de goût du citron, j’ai rajouté du jus de citron, mis à part ça, il est bon !!!', '2023-10-31T15:23:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, e42f2cf3-07fb-4aa5-a8c6-d3749103bbea, 'Une tuerie 😀 Ça fonctionne très bien avec le four solaire !', '2023-01-30T19:14:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, f8af765a-55a6-45c2-ab33-0459c64c8ba6, 'Bonne recette, mais 200 gramme de sucre c’est beaucoup trop ! J’en ai mit 140 et c’était très bien. Je vous conseille aussi de mettre le jus de citron directement dans la pâte, et d’en rajouter en plus du jus du citron que vous avez utilisé.', '2021-12-20T17:45:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 6d3db056-cb5e-4a18-9d6b-e4fc2374ad9f, 'jai remplacé le beurre par une banane écrasée et un filet d''huile de tournesol et c''était délicieux ! aussi une petite astuces : pour avoir plus de goût de citron frotter les zestes avec le Sucre !', '2023-08-27T19:57:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, a1f49da5-3a96-464f-814a-4eba9da4cc88, 'Excellent. Si l’on nappe le cake d un sirop de citron, je trouve raisonnable de baisser la quantité de sucre dans kff ère cake, le sirop sucre pas mal en bouche. Il fait équilibrer. C’est mon avis. J ai mis 150 g au lieu de 200 g de sucre. ', '2023-08-20T16:14:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, b3ad5a8a-c675-4853-bf03-8514ea48fc41, 'Super cake ! Meilleure recette que j’ai jamais trouvé avec saveur au citron ! Hyper moelleux et la saveur de citron est juste. Je recommande vivement !!!👍👍', '2023-05-01T21:12:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, d07c042f-f9a2-4e8f-9076-cf3fce2d4b2f, 'Très bon ! J''ai suivi les avis des autres et j''ai mis un peu moins de sucre. Le sirop apporte beaucoup de moelleux au cake, à ne pas louper ! J''y avais ajouté quelques feuilles de basilic pendant la cuisson avant de filtrer le tout au chinois.', '2022-08-23T22:29:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, f6e47ebe-3fd2-47aa-82f9-59f8eeb98e6b, 'Très bonne recette à réaliser, mais pas assez explicite concernant les citrons ! Par ex elle ne spécifie pas qu''il faut les presser avant de les râper', '2022-03-19T19:35:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 37b703b8-0636-4e57-93a6-961eb84332d0, 'Très bon. Un jus de citron dans la pâte et napper de sirop fait avec 80 g de sucre et 2 jus de citron à laisser bien cuire. Pour les amateurs de citron...', '2022-02-20T12:56:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 0bfadf5c-2fcd-43ba-be00-f92b6eddf2b2, 'Super bon ! J''ai mis 180 g de sucre et 1/2 (jus) citron dans le cake. Merci.', '2019-09-11T18:39:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 8c20af30-1a66-449b-a57f-8b0d0ad06ba2, 'Délicieux, j''ai juste mis 150 g de sucre et c''est parfait.', '2019-03-18T11:23:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, eea5c839-da20-4c31-a8d3-b314f5684b46, 'J''ai mis 150 g de sucre et le jus et zeste de 2 citrons pour que ça goûte beaucoup... excellent !', '2018-11-29T10:22:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 15bb2188-67de-42e1-ab92-2874f675ec20, '150 gr de sucre suffisent. Par contre je mettrai 2 citrons la prochaine fois.', '2023-10-08T17:51:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, e81de895-2a16-4aa3-ae03-5fd39ba816ea, 'Très bon , simple et rapide .', '2023-07-30T10:40:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 27ff4d03-690a-41da-820f-ca51d43396c5, 'Recette facile !', '2022-10-16T15:00:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, f97f411a-3e9a-43fe-8655-605e198b09d4, 'Très bon ! Je n’ai pas mis de citron et j’ai mis des framboises congelés et pépite de chocolat. 5/10min de cuisson supplémentaire. C’était délicieux ', '2022-06-29T20:04:04+02:00');
