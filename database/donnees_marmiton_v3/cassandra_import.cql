INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (230942, 'Délice rapide chocolat banane', 'petit beurre, chocolat noir, lait de soja, banane', '15 min', ['Commencer par faire fondre le chocolat noir tout en délayant au fur et à mesure avec un peu de lait de soja pour obtenir une pâte crémeuse ni trop liquide ni trop compacte.', 'Pendant ce temps écraser grossièrement les biscuits au fond du plat/ramequins.', 'Couper les bananes en rondelles et les mélanger au chocolat encore chaud.', 'Verser cette préparation encore chaude sur les biscuits écrasés, de manière à ce qu''ils absorbent le chocolat.', 'Une fois tiède, garder au réfrigérateur, le chocolat est encore meilleur une fois refroidi!', 'Déguster !'], ['Passoire', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Délice rapide chocolat banane', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'lait de soja', 'petit beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:20:40.774892', [{'ingredient_id': '7ccc2edc-a94e-49bc-831c-30636aac1955', 'quantite': '12'}, {'ingredient_id': 'ea6173ff-c7ac-4e3f-bb49-5012299ee395', 'quantite': '120 g'}, {'ingredient_id': '0c99fa2c-2532-46c9-ad44-a5abc12d434e', 'quantite': '20 cl'}, {'ingredient_id': '39e35c94-b8fc-4590-98aa-5a926e28070a', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70949, 'Boulgour aux bananes et aux raisins secs', 'boulgour, lait, eau, banane, raisins secs, curry, poivre, sel, huile d''olive, menthe, citron', '15 min', ['Mélanger dans un bol les raisins dans un peu d''eau et du jus de citron, laisser.', 'Dans une poêle, faire revenir le boulgour dans un peu d''huile.', 'Après quelques minutes seulement, ajouter le lait mélangé à l''eau. Saler, poivrer et ajouter le curry.', 'Une fois que le boulgour a absorbé tout le liquide, ajouter les bananes coupées en rondelles et les raisins essorés, ainsi que la menthe.', 'Retirer du feu lorsque les bananes sont croquantes à l''intérieur et fondantes à l''extérieur (2 minutes).', 'Décorer l''assiette de quelques feuilles de menthe fraîche et servir.'], ['Économe', 'Râpe', 'Louche', 'Planche à découper', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'eau', 'testées', 'cocktail', 'menthe', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'boulgour', 'huile d''olive', 'dessert', 'plat de résistance', 'citron', 'raisins secs', 'poivre', 'lait', 'curry', 'Boulgour aux bananes et aux raisins secs'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:20:44.426332', [{'ingredient_id': '658a55f1-c656-4458-b155-28b4f4885cd2', 'quantite': '75 g'}, {'ingredient_id': '0f76d873-db0b-4405-afb2-9f5e9339b4a7', 'quantite': '33 cl'}, {'ingredient_id': '1c656450-47f0-4779-b6b7-1ae74d2abfc9', 'quantite': '33 cl'}, {'ingredient_id': '85b79a39-5b8a-4991-b292-987c852298b2', 'quantite': '1'}, {'ingredient_id': '0d2f030d-0b87-486d-b2ae-f823f2a2950a', 'quantite': '1'}, {'ingredient_id': '234c59c8-f054-4d5f-8a2d-ed82bcec15bd', 'quantite': '1 cuillères'}, {'ingredient_id': '0a12bc69-2f33-4932-8f2b-1ebe2632a6b9', 'quantite': ''}, {'ingredient_id': 'ea4f5585-b300-4aa5-ae59-24febd426cc4', 'quantite': ''}, {'ingredient_id': '791a86e8-e278-43c4-b878-286d5ead5049', 'quantite': ''}, {'ingredient_id': '2930e5d9-e97f-427d-b567-5f21e58d871c', 'quantite': ''}, {'ingredient_id': 'f1ff5b6f-93b3-48e0-8886-8fbe0090816d', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (253649, 'Gâteau pomme banane extra', 'pomme, banane, sucre, farine, levure, beurre salé, beurre doux, rhum, oeuf, crème fraîche, orange', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Faire fondre un morceau de beurre salé dans une poêle avec 3 cuillères à soupe de sucre puis ajouter les morceaux de pomme et de banane. Faire revenir puis ajouter 1 lichette de Pulco. Réserver.', 'Battre les œufs avec 5 cuillères à soupe de sucre dans un saladier puis ajouter la levure, la farine, le beurre doux fondu (en garder pour beurrer le moule), le rhum et la crème fraîche.', 'Ajouter les fruits.', 'Mettre dans un moule beurré et fariné et enfourner à 180°C (thermostat 6) pendant 20 à 25 min.'], ['Spatule', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'confiserie', 'testées', 'facile', 'beurre salé', 'bon marché', 'oeuf', 'plat', 'recette', 'levure', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'pomme', 'gâteau à la banane', 'orange', 'beurre doux', 'sucre', 'cocktail', 'Gâteau pomme banane extra'], 'Dessert', c09b0020-7acb-4a04-bfa4-5949c4c249a7, '2025-09-26T16:20:48.144098', [{'ingredient_id': 'a102f595-2523-4e00-9d13-eba05229fffc', 'quantite': '2'}, {'ingredient_id': 'f1cfe105-9ff7-4ff9-b571-c963240216d8', 'quantite': '2'}, {'ingredient_id': 'be8e378e-9b99-43fd-bd1a-9f0469ff1296', 'quantite': '8 cuillères'}, {'ingredient_id': '58863b17-d7ef-425f-b5e6-f8bb9d8df8e5', 'quantite': '5 cuillères'}, {'ingredient_id': '0703389c-5e0b-43ef-9a25-9d6d737df34a', 'quantite': ''}, {'ingredient_id': '564fd317-3c63-4232-845b-2747efbc1c1f', 'quantite': '15 g'}, {'ingredient_id': 'ef80dce0-cae1-4aaf-bd46-c3ea0d2a00b2', 'quantite': '30 g'}, {'ingredient_id': 'd8e0e381-5e4f-4f14-bd54-7494c1eba178', 'quantite': '2 cuillères'}, {'ingredient_id': '5ba77e62-5e04-4c0a-967d-2c86ab998642', 'quantite': '3'}, {'ingredient_id': 'df9a70f1-feda-4eeb-8085-049ae75cbfca', 'quantite': '3 cuillères'}, {'ingredient_id': '95a75e79-860f-410e-9c99-67966547c50c', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (53331, 'Ananas en salade de fruits', 'ananas, mangue, banane, papaye, sucre, citron vert, rhum', '20 min', ['Couper l''ananas en 2 dans le sens de la longueur.', 'Creusez-le, éliminez le centre filandreux, coupez la chair en dés et préparer de même tous les fruits.', 'Laissez macérer avec le sucre et le jus de citron durant 1 heure puis présentez bien frais.'], ['Louche', 'Verre doseur', 'Tire-bouchon'], ['', 'entrée', 'banane', 'papaye', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'mangue', 'recette', 'Ananas en salade de fruits', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'ananas', 'citron vert', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:20:53.939720', [{'ingredient_id': 'bac47448-96a6-490d-a4ee-97ff09b11c2c', 'quantite': '1'}, {'ingredient_id': '8da7184c-90ae-4591-b976-bf5bba0eeb98', 'quantite': '1'}, {'ingredient_id': '6dc8c1b6-8b75-4e32-9724-28e1ee7ce3bf', 'quantite': '1'}, {'ingredient_id': 'f45f2ecb-64b8-4911-8739-fc0cb2d55526', 'quantite': '1'}, {'ingredient_id': '3b890b8d-0b16-4d49-a0ed-445ca7ca8dfe', 'quantite': ''}, {'ingredient_id': '159fbe8f-3667-41d6-947f-e0f168559659', 'quantite': '1'}, {'ingredient_id': 'a40238c4-f299-497e-afdb-f3f582758263', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (85284, 'Curry de crevettes au yaourt et aux fruits', 'crevettes, oignon, tomate, pomme, banane, yaourt à la grecque, curry, poivre, sel, huile', '30 min', ['Décortiquer les crevettes. ', 'Couper en petits dés les pommes et les tomates.', 'Faire revenir l''oignon et la pomme dans une poêle (ou cocotte anti-adhésive) avec l''huile.', 'Quand les pommes sont cuites, rajouter les crevettes. ', 'Faire chauffer pendant 5 min.', 'Verser sur cette préparation le mélange des yaourts et du curry (mieux vaut ne pas trop en mettre et rectifier par la suite).', 'Laisser mijoter à feu doux 5 min.', 'Rajouter les tomates et laisser à nouveau mijoter 5 min.', 'Couper le feu, rectifier l''assaisonnement.', 'Au moment de servir, disposer sur la surface la banane coupée en petit dés.', 'Servir avec du riz basmati.'], ['Spatule', 'Louche'], ['yaourt à la grecque', 'banane', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'tomate', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile', 'dessert', 'crevettes', 'plat de résistance', 'Curry de crevettes au yaourt et aux fruits', 'pomme', 'moyen', 'poivre', 'curry', 'cocktail'], 'Plat principal', 5dc368d6-5190-4dbc-b622-d58f5b1c2098, '2025-09-26T16:20:59.347237', [{'ingredient_id': '617ed1d7-87c7-4c31-bb21-2692e5d85fc2', 'quantite': '600 g'}, {'ingredient_id': '6976d406-3759-4996-bae6-3ae0416b98de', 'quantite': '1'}, {'ingredient_id': '6928f223-3446-40d9-a4ae-f2b70a2d95be', 'quantite': '2'}, {'ingredient_id': '188cbf41-a3b2-4c97-b441-f63eecf9b7fb', 'quantite': '1'}, {'ingredient_id': 'a38b8e18-34a5-4f6f-8216-d76b6024384a', 'quantite': '1'}, {'ingredient_id': '2ef46d7a-43b1-4a16-8ffa-db78baeaaae3', 'quantite': '2'}, {'ingredient_id': 'cb20d1f1-8370-4d77-b720-7e566b9f459e', 'quantite': '2 cuillères'}, {'ingredient_id': '1b3db0d9-3533-41f8-8ee6-530790d55dbc', 'quantite': ''}, {'ingredient_id': 'b0fc4789-c0c5-43e3-9e38-a97d8cc8731d', 'quantite': ''}, {'ingredient_id': '0c004397-83f8-4827-905a-9bfa8c93f0b5', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17886, 'Bananes au jambon, moutarde à l''estragon', 'banane, banane, banane, jambon, crème fraîche, eau, moutarde à l''estragon, poivre, sel, riz', '5 min', ['Enroulez une tranche de jambon autour de chaque banane, les saler et les poivre et les disposer dans un plat qui va au four. ', 'Dans un saladier mélanger la crème fraîche, le lait (ou l''eau), et la moutarde à l''estragon, bien mélanger pour obtenir une sauce assez liquide. ', 'Verser la sauce sur les bananes. ', 'Mettre au four, Th 6/7 ', 'Verifier de temps en temps la cuisson : la sauce doit devenir un peu "pâteuse". ', 'Servir chaud accompagné de riz'], ['Casserole', 'Mixeur', 'Verre doseur', 'Presse-agrumes', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'jambon', 'sel', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'poivre', 'moutarde à l''estragon', 'cocktail', 'Bananes au jambon'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:21:03.174117', [{'ingredient_id': 'f9a1c398-9435-49ee-ab14-069e8068e9be', 'quantite': '4'}, {'ingredient_id': '1d00dd2c-63de-4e65-87d5-c701d07c802b', 'quantite': ''}, {'ingredient_id': '282079ec-4023-442f-8a73-3c2be51f2c1c', 'quantite': ''}, {'ingredient_id': '5a02adbf-361d-4d3e-8858-8696b3c844f4', 'quantite': '4'}, {'ingredient_id': 'fd6bd012-e816-4360-9067-86bf0ecd9dc0', 'quantite': '1'}, {'ingredient_id': 'c9c88db8-5e80-4177-8825-0bca2baf36cf', 'quantite': ''}, {'ingredient_id': '37f7c4b1-a063-48b7-a8d8-aa567db71c59', 'quantite': '3'}, {'ingredient_id': '4ca83b58-a549-4c0c-b6e1-9674f781c2cf', 'quantite': ''}, {'ingredient_id': '86993a68-878f-4cb0-9b30-df9ee4332149', 'quantite': ''}, {'ingredient_id': '767e41fc-fd93-4369-a27e-c76c15e39d43', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18533, 'Poulet sauté au curry, petits légumes et banane', 'blanc de poulet, oignon, poivron vert, banane, crème fraîche, curry', '30 min', ['Hachez grossièrement l''oignon. ', 'Faites le revenir à l''huile d''olive dans une grande poêle sauteuse. ', 'Coupez le demi poivron en petits cubes puis ajoutez le aux oignons. ', 'Pendant que l''oignon et le poivron reviennent à feu moyen, couper le poulet en morceaux. Moi, je le fais au ciseaux, c''est plus pratique qu''avec un couteau.', 'Normalement, le temps de couper le poulet (environ 10 mn), oignon et poivron sont prêts. ', 'Ajoutez alors les morceaux de poulet. Salez, poivrez. ', 'Une fois que les morceaux de poulet sont blancs, ajoutez la crème fraîche et le curry.', 'Laissez mijoter quelques minutes en remuant régulièrement, puis rajoutez de la crème fraîche et du curry. Cette opération est à renouveler 3 ou 4 fois en goûtant: c''est que du bonheur!', '1 minute avant de retirer la poêle du feu, ajoutez une banane coupée en rondelle et remuez légèrement. ', 'Voilà c''est prêt!'], ['Moule à tarte', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'poivron vert', 'facile', 'plat', 'blanc de poulet', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'Poulet sauté au curry', 'curry de légumes', 'dessert', 'plat de résistance', 'moyen', 'petits légumes et banane', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:21:09.022945', [{'ingredient_id': '3604d4c5-d245-448c-89a0-424e14fede4a', 'quantite': '4'}, {'ingredient_id': 'facc4004-4d75-4775-ad9d-0fc2e9cb61c6', 'quantite': '1'}, {'ingredient_id': 'd869b348-ccdc-47a2-bd57-52cc62cf04ad', 'quantite': '1'}, {'ingredient_id': '261b8d0e-4abc-4c45-9511-aa54a7437bcd', 'quantite': '1'}, {'ingredient_id': 'de6cac02-8991-46d9-8a15-b5a6e5adecd0', 'quantite': '1'}, {'ingredient_id': '2c80834a-8d36-4958-8d79-0ab430e9e1d8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16581, 'Tarte à la banane et à la cannelle', 'pâte brisée, banane, jaune d''oeuf, crème, sucre, extrait de vanille, cannelle', '20 min', ['Pré-cuire 15 minutes la pâte.', 'Pendant que la pate pré-cuit, découper les bananes assez finement.', 'Mélanger les jaunes d''oeufs avec la crème et le sucre (ajouter éventuellement de l''extrait de vanille et du rhum).', 'Placer les bananes au fond de la tarte et bien les ''tasser''. Mettre la préparation par dessus, saupoudrer d''un peu de cannelle et enfourner à un four chaud 180°C.'], ['Tire-bouchon', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'extrait de vanille', 'facile', 'bon marché', 'plat', 'jaune d''oeuf', 'tarte à la banane', 'crème', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Tarte à la banane et à la cannelle', 'cannelle', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:21:12.578890', [{'ingredient_id': '7a2abd0b-14fa-4240-bc3c-62332f6a7a4d', 'quantite': '1'}, {'ingredient_id': 'cb454b53-22a6-43be-867d-4d83dd7bee93', 'quantite': '2'}, {'ingredient_id': '45086cb1-da76-4ef5-893c-75d5ec4969f4', 'quantite': '2'}, {'ingredient_id': 'a094b2c9-fafd-49f8-b86b-980c84972800', 'quantite': '100 g'}, {'ingredient_id': '5ab029da-2220-490d-8c0b-2389d31c19ed', 'quantite': '60 g'}, {'ingredient_id': '308d46fb-cf42-44be-9bb8-0e5c4e22975b', 'quantite': ''}, {'ingredient_id': 'f9dbed79-2828-4398-9d7f-40c0d3b255bd', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166394, 'Congolais noix de coco banane', 'noix de coco rapée, oeuf, sucre, farine, banane, lait', '15 min', ['Préchauffer le four à 160°', 'Mélanger les jaunes d''oeufs avec le sucre.', 'Couper les bananes en morceaux, puis les mixer et ajouter le lait.Mixer encore un peu.', 'Ajouter la purée de banane au mélange oeufs-sucre. Mélanger.', 'Ajouter la farine. Mélanger.', 'Battre les blancs en neige et les incorporer délicatement au mélange.', 'Ajouter la noix de coco râpée, puis mélanger.', 'Sur une plaque recouverte de papier sulfurisé, disposer des petits tas de pâte à l''aide d''une cuillère à soupe.', 'Mettre au four une vingtaine de minute', '( il faut que les petits gâteaux soient légèrement dorés ).'], ['Économe', 'Râpe', 'Casserole', 'Moule à tarte', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Congolais noix de coco banane', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'noix de coco rapée', 'dessert', 'plat de résistance', 'sucre', 'lait', 'rochers', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:21:16.339784', [{'ingredient_id': '4e2cf304-9dda-4691-94e0-ac96c8a2fae7', 'quantite': '300 g'}, {'ingredient_id': 'd8b27429-8b6b-4800-aecc-6e9b8ff128c5', 'quantite': '2'}, {'ingredient_id': 'a5e57020-1830-4e64-819f-a55dae60d9ec', 'quantite': '200 g'}, {'ingredient_id': 'f0d6bad2-e0c9-45e6-b01c-3c756a120abf', 'quantite': '50 g'}, {'ingredient_id': '56e927e5-4551-4449-abe9-30e7db60067b', 'quantite': '2'}, {'ingredient_id': 'ed0de380-ae74-448d-8d3f-bc0b10bbae1f', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81837, 'Muffins bananes et poires', 'banane, poire, farine, levure, sucre roux, beurre, oeuf, lait, cannelle, extrait de vanille liquide', '15 min', ['Préchauffez votre four à 180°C (thermostat 6).', 'Coupez les deux bananes en rondelles dans un saladier et mélangez-les aux deux oeufs, au beurre fondu et au sucre roux. Mélangez énergiquement avec une fourchette, les bananes s''écraseront grossièrement toutes seules.', 'Ajoutez la farine et la levure, mélangez bien. Puis ajoutez le lait. Enfin mettez la vanille, la cannelle et les poires coupées en morceaux.', 'Mettez la pâte dans des moules à muffins.', 'Enfournez pour 20-25 min environ.', 'Laissez-les refroidir sur une assiette et dégustez.'], ['Batteur électrique', 'Louche', 'Pince de cuisine', 'Économe', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'extrait de vanille liquide', 'confiserie', 'testées', 'Muffins bananes et poires', 'poire', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'muffin', 'beurre', 'cannelle', 'lait', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:21:21.112832', [{'ingredient_id': '58a055b7-af8f-4b2e-a268-18f04717e384', 'quantite': '2'}, {'ingredient_id': '83ffec31-7ad0-4cd9-8210-35f05be86bb1', 'quantite': '4'}, {'ingredient_id': 'e56883d0-cef1-45bd-90c3-f186e4b2197e', 'quantite': '175 g'}, {'ingredient_id': 'd318db06-557c-4fe5-931d-58440ed95852', 'quantite': ''}, {'ingredient_id': '63a1f1af-1837-4c55-95d8-57bd16b172ac', 'quantite': '100 g'}, {'ingredient_id': '516ee2fe-1edd-49a3-95c1-644f901ecdd5', 'quantite': '60 g'}, {'ingredient_id': '9b766810-b745-494b-818d-f3d0589fac50', 'quantite': '2'}, {'ingredient_id': '686bcabf-bf04-45d3-a333-bba51e205134', 'quantite': '10 cl'}, {'ingredient_id': 'db89c06f-cf31-4609-95d7-0af345f613ce', 'quantite': '1 cuillères'}, {'ingredient_id': '392bccb3-a0cd-4c8f-b88b-24786c69d804', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (533483, 'Chocolat Banana Cake', 'chocolat, sucre, oeuf, maïzena, yaourt, banane, beurre', '20 min', [' Mélanger le sucre et les oeufs', 'Ajouter le yaourt et la maïzena', 'Faire fondre le chocolat et le beurre au bain marie', 'Ajouter le chocolat foundue à la preparation', 'Ajouter 1 banane coupée en morceaux', 'Verser la préparation dans des ramequins et enfourner à 180C pendant 10 minutes.'], ['Passoire', 'Pince de cuisine', 'Louche', 'Mixeur'], ['', 'entrée', 'banane', 'Chocolat Banana Cake', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'chocolat', 'très facile', 'maïzena', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', e198219e-52ac-41e1-a0a9-96b2a776b9f0, '2025-09-26T16:21:24.672419', [{'ingredient_id': 'ab2fe8e4-1320-408a-ab1e-2cd3777bd509', 'quantite': '100 g'}, {'ingredient_id': '5123499e-3658-427c-8389-1941a8297018', 'quantite': '2 cuillères'}, {'ingredient_id': '445ed290-4ab5-4453-9117-2ad9ef20b9f0', 'quantite': '3'}, {'ingredient_id': 'c6928507-fbd3-4a7f-8fd8-1c49b4c5465b', 'quantite': '2 cuillères'}, {'ingredient_id': '82f7e51d-4932-49d3-bde3-463117e1cf70', 'quantite': '1'}, {'ingredient_id': '0a035f74-aa70-4077-ac5d-4ddf5b172627', 'quantite': '2'}, {'ingredient_id': 'f3339869-b13b-4700-9589-f198e883e6ff', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12577, 'Potage surprise aux tomates', 'beurre, farine, banane, tomates pelées, eau, boeuf, curry, crème fraîche, poivre, sel, persil, croûtons', '5 min', ['Faire un roux (beurre + farine), ajouter l''eau, les cubes, le curry, les bananes coupées en rondelles, les tomates pelées et les épices.', 'Laisser cuire environ 20 minutes.', 'Passer au mixer.', 'Ajouter la crème juste avant de servir.', 'Ajouter du persil haché et des croûtons à volonté.'], ['Passoire', 'Casserole', 'Spatule', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'boeuf', 'sel', 'confiserie', 'eau', 'testées', 'tomates pelées', 'facile', 'Potage surprise aux tomates', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'croûtons', 'soupe', 'dessert', 'persil', 'plat de résistance', 'beurre', 'poivre', 'curry', 'cocktail'], 'Entrée', 86e86370-636a-4f75-8667-42e766af3b50, '2025-09-26T16:21:28.393921', [{'ingredient_id': 'ac58e5fe-05b7-4c1a-9d04-f57cc66bedf4', 'quantite': '20 g'}, {'ingredient_id': 'ae164335-78ad-48d2-bfc1-8f46d402f2fe', 'quantite': '1'}, {'ingredient_id': 'e92db55a-00ef-4081-92fc-a6adab219fa8', 'quantite': '2'}, {'ingredient_id': '3d0b7050-3d5d-4f71-9f29-0cb6ab9e9aac', 'quantite': '1'}, {'ingredient_id': 'f6df42c9-1712-4134-96bb-5c58cef6b3a0', 'quantite': '1.5 l'}, {'ingredient_id': '674d0c91-3660-47c0-9a7b-26d07154365e', 'quantite': '4'}, {'ingredient_id': '2a98f42c-b45e-462a-b1ad-8074e302a4e9', 'quantite': ''}, {'ingredient_id': 'a0c01ef7-7dbf-4671-97fd-aaa9d4b7afc6', 'quantite': '1'}, {'ingredient_id': 'd3d0b85a-331f-4276-b460-e4ee4f140034', 'quantite': ''}, {'ingredient_id': 'ad2bb72e-d4a0-4351-8186-2ba636aff22d', 'quantite': ''}, {'ingredient_id': 'a68dee6e-c01b-4021-bbef-63d87372e80b', 'quantite': ''}, {'ingredient_id': '62bee1c3-f023-48a6-869f-6ed536b35afc', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530454, 'Tartines bananes pâte à tartiner', 'banane, pâte à tartiner, pain de mie, noix de coco rapée', '7 min', ['Demande à un adulte de préchauffer le four à 170°C (thermostat 5-6).', 'Coupe les bananes en rondelles', 'Tartine les tranches de pain de mie avec de la pâte à tartiner et ajoute les bananes par dessus. Saupoudre avec un peu de coco râpée.', 'Mets au four jusqu''à ce que le pain soit croustillant et la pâte à tartiner fondante.'], ['Moule à tarte', 'Presse-agrumes', 'Couteau de chef'], ['Tartines bananes pâte à tartiner', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'cocktail', 'pain de mie', 'pâte à tartiner'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T16:21:31.921242', [{'ingredient_id': '72c2bd15-87f5-41eb-9df1-c58d57fe5e77', 'quantite': '4'}, {'ingredient_id': 'baae49d6-fe95-49ff-9b68-0209be03763d', 'quantite': '1'}, {'ingredient_id': '3ad0a7ce-e09c-4e98-b7de-3239e21d06bc', 'quantite': '4'}, {'ingredient_id': 'b00aead2-fa3a-4893-acc4-45aa371539cd', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (82633, 'Croque banane nutella noix de pécan', 'brioche, pâte à tartiner, banane, beurre, sucre, cassonade, noix de pécan', '10 min', ['Tartinez de Nutella vos 4 tranches de brioche, réservez.', 'Dans une poêle anti-adhésive, faites fondre le beure et la cuillère à soupe de sucre blanc. ', 'Pendant ce temps, découpez en rondelles vos bananes. ', 'Faites ensuite dorer ces rondelles de bananes dans le mélange sucre/beurre.', 'Répartissez vos babanes sur vos tartines de Nutella. ', 'Parsemez de noix de pécan.', 'Recouvrez avec une autre tranche de brioche. ', 'Pour finir, saupoudrez le tout avec le sucre cassonade et enfournez 1 minute au gril pour faire caraméliser le tout...'], ['Ouvre-boîte', 'Poêle'], ['', 'brioche', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'noix de pécan', 'très facile', 'Croque banane nutella noix de pécan', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail', 'pâte à tartiner'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:21:36.431988', [{'ingredient_id': '88d53c9f-30a6-4c9d-9cbb-f904d4204d84', 'quantite': '8'}, {'ingredient_id': '8ed1eb3a-78dd-4591-b655-7f6897b5eba3', 'quantite': '6 cuillères'}, {'ingredient_id': '9c1ceb76-9a81-4e7e-97cd-6aa2255e915f', 'quantite': '3'}, {'ingredient_id': '7cb12faf-0e7f-4a2e-bdcb-6582f41e660c', 'quantite': '20 g'}, {'ingredient_id': 'd8007f36-4cba-4877-9f3c-5c5b8de33d33', 'quantite': '1 cuillères'}, {'ingredient_id': 'd2b2a134-ac67-4c7e-ac74-c120c12d5645', 'quantite': '4 cuillères'}, {'ingredient_id': '02ec3d77-3dce-4a16-b57d-4d86054fc668', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46773, 'Cookies petit déj banane-choco-flocon d''avoine', 'beurre tendre, sucre roux, flocons d''avoine, farine, oeuf, chocolat noir, banane, sel, levure chimique, sucre vanillé', '15 min', ['Préchauffer votre four à 180°C (thermostat 6 ).', 'Eplucher les bananes, les couper en rondelles assez épaisses et couper les rondelles en 2 ou 3 morceaux. ', 'Mettre environ 20 g de beurre dans une poêle, ajouter les bananes, le sachet de sucre vanillé et mettre à dorer. Les bananes vont s''écraser à la cuisson et se transformer en une compotée.', 'Ne pas trop mélanger pour éviter de trop écraser la compotée. ', 'Réserver quand les bananes sont cuites.', 'Dans un saladier, mettre : la farine, les flocons d''avoine, les oeufs entiers, le sel, la levure, le sucre roux et bien mélanger avec une fourchette.', 'Ajouter le beurre mou en morceaux et mélanger à la main pour bien répartir le beurre dans toute la préparation.', 'Ajouter le chocolat en pépites, mélanger avec une fourchette.', 'Ajouter la compotée de bananes, mélanger avec une fourchette.', 'Le mélange final doit être assez compacte. Si ce n''est pas le cas, ajouter 1 ou 2 cuillère(s) à soupe supplémentaires de flocons d''avoine.', 'Former des petits tas à l''aide d''une cuillère à café sur du papier sulfurisé préalablement déposé sur la plaque de votre four.', 'Mettre au four environ 12 min à 180°C (thermostat 6).', 'Quand les cookies sont cuits, les retirer de la plaque à l''aide d''une spatule et les mettre à refroidir.', 'Préparer une autre fournée jusqu''à épuisement de la préparation.', 'La durée de la cuisson varie en fonction de la taille de vos cookies et de votre four.', 'Les premières fournées sont souvent un peu plus longues à cuire que les suivantes (une fois que le four est bien chaud !).', 'A adapter aussi selon vos goûts concernant la consistance (moelleux, croustillant...) cependant, la banane apporte beaucoup de moelleux à cette recette.'], ['Louche', 'Presse-agrumes', 'Économe', 'Planche à découper', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'beurre tendre', 'levure chimique', 'Cookies petit déj banane-choco-flocon d''avoine', 'très facile', 'bon marché', 'cookie', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre vanillé', 'flocons d''avoine', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:21:41.226373', [{'ingredient_id': '4c8abda3-7d02-42f2-8fd2-f2c974e9da22', 'quantite': '120 g'}, {'ingredient_id': '7eb4b607-fa97-4de9-8107-1a0b4d94acb4', 'quantite': '1.5'}, {'ingredient_id': '170ab29a-2331-4c59-a60e-20247af37eca', 'quantite': '2.5'}, {'ingredient_id': '36b38227-d51b-4ed2-9990-71a2d68b8fab', 'quantite': '2'}, {'ingredient_id': '83f3f9cc-d5a3-46fc-acae-ce00e63fa78b', 'quantite': '3'}, {'ingredient_id': 'e9dd5f72-70fc-4a8e-b1bc-ec7c68d4b3b4', 'quantite': '150 g'}, {'ingredient_id': '8259708f-ab3a-46cd-8d27-45d04eb760d9', 'quantite': '3'}, {'ingredient_id': 'e6a05e95-eeaf-47bc-b74d-1e05a4c5de23', 'quantite': ''}, {'ingredient_id': 'eea11fbd-0774-4a0c-9d1e-d1415377e4a6', 'quantite': '1 cuillères'}, {'ingredient_id': 'e1322b92-2c3d-467f-a78b-3b0e43066c6b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (89606, 'Papillotes de fruits au miel', 'beurre, banane, fraises, abricot, poire, miel liquide, rhum, papier sulfurisé', '10 min', ['Équeuter les fraises. Éplucher les fruits.', 'Couper les bananes en rondelles de 2-3 cm. Couper les poires en morceaux du même acabit.', 'Préchauffer le four à 220°C (thermostat 7-8).', 'Découper 4 carrés de papier sulfurisé assez grands pour envelopper les brochettes. Les enduire de beurre.', 'Mélanger le miel et le rhum dans un bol.', 'Enfiler les fruits préparés sur les brochettes. Badigeonner les brochettes du mélange miel-rhum et les déposer sur les carrés de papier sulfurisé. Fermer les feuilles de papier autour de la brochette pour obtenir une papillote.', 'Faire cuire au four 7 min et servir chaud.'], ['Planche à découper', 'Ouvre-boîte', 'Mixeur', 'Économe', 'Casserole'], ['', 'miel liquide', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'abricot', 'poire', 'facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'papier sulfurisé', 'cuisine', 'recettes', 'boisson', 'Papillotes de fruits au miel', 'dessert', 'plat de résistance', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:21:44.809164', [{'ingredient_id': '52f90112-9630-4fb4-901d-c1916f100250', 'quantite': '30 g'}, {'ingredient_id': '22fa9bb8-2354-4869-9033-9d8887e7459c', 'quantite': '2'}, {'ingredient_id': 'a32d8831-3836-48e8-9f27-cf423f2e5495', 'quantite': '1'}, {'ingredient_id': '380e836c-7093-45f0-b19a-8cf2cd2ba767', 'quantite': '8'}, {'ingredient_id': '675ae593-edd5-460e-9033-b3209053eab7', 'quantite': '2'}, {'ingredient_id': '1cb35f95-da88-4d8a-bc89-0e9ca460e254', 'quantite': '6 cuillères'}, {'ingredient_id': 'b116a76d-b0a2-4af6-a487-24ba524437d9', 'quantite': '1 cuillères'}, {'ingredient_id': '60653be8-8f6e-4037-bca7-8b3dc0f65468', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52998, 'Clafoutis Hawaïen', 'farine, sucre semoule, beurre, sel, oeuf, lait, lait, vanille, crème fraîche, oeuf, sucre semoule, eau de fleur d''oranger, ananas, mangue, papaye, banane', '15 min', ['Mettre la farine dans une terrine, et faire une fontaine dans la farine; incorporer le sucre et le sel sur le bord.', 'Au centre, mélanger les oeufs et le beurre, puis pétrir le tout. Ajouter un peu de lait selon la consistance. ', 'Faire bouillir le lait et la gousse de vanille ouverte. Ajouter la crème et laisser infuser. Fouetter les oeufs et le sucre. ', 'Cuire la pâte non garnie, recouverte pour éviter qu''elle gonfle. (10 min).', 'Garnir la pâte semi-cuite avec les fruits mélangés, préalablement coupés en dés. ', 'Mélanger le lait, la crème et les oeufs battus avec le lait. Verser cette garniture sur les fruits dans la pâte. ', 'Mettre le tout au four 20 mim environ. Servir tiède ou froid.'], ['Balance de cuisine', 'Spatule', 'Fouet'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'oeuf', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'farine', 'dessert', 'plat de résistance', 'clafoutis', 'moyen', 'beurre', 'Clafoutis Hawaïen', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:21:48.457427', [{'ingredient_id': 'c6d49654-c23f-444b-9f00-f4c0f4d65934', 'quantite': '250 g'}, {'ingredient_id': 'dd59f98f-9f55-4420-a560-5c217329fc0b', 'quantite': '10 g'}, {'ingredient_id': '002ab935-5cf0-4bf0-80e9-d7cc794aeef0', 'quantite': '125 g'}, {'ingredient_id': '35c5db2b-2371-4a2f-b18a-b19913621617', 'quantite': ''}, {'ingredient_id': '2cc71a84-968b-446c-847c-53c8e02fac41', 'quantite': '1'}, {'ingredient_id': '1a5f4121-3440-4c55-ba36-21ba9fdd1a50', 'quantite': '1 cuillères'}, {'ingredient_id': 'fd9d9d13-bc3a-4767-8c1e-12a7efe3331e', 'quantite': ''}, {'ingredient_id': 'a3e464f5-368a-4450-97b2-ab3ee6416085', 'quantite': '1'}, {'ingredient_id': '90a0b499-c8bd-4b8c-805a-b787de66bb9c', 'quantite': '120 g'}, {'ingredient_id': 'd186df46-c278-44ba-9e5e-543ed056db01', 'quantite': '4'}, {'ingredient_id': '574067f5-7c8b-4aaa-b619-b9749c646a99', 'quantite': '100 g'}, {'ingredient_id': 'c3f38343-281a-4382-ab9e-2fb167aec5b3', 'quantite': '4'}, {'ingredient_id': '2258063d-beb7-45fb-b7f0-da4e4112e482', 'quantite': '1'}, {'ingredient_id': 'e9d9cfae-5296-4f75-a3c8-9d5f696705f9', 'quantite': '2'}, {'ingredient_id': '4b5c8ab6-258f-43d7-bea1-8d4ee5525b33', 'quantite': '1'}, {'ingredient_id': '5e98ab54-ee37-4c88-8eeb-2a33e0b826c7', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (47407, 'Mousse pomme banane', 'pomme, banane, sucre, blanc d''oeuf, crème fraîche, citron', '20 min', ['Pelez et coupez en morceaux la pomme e les 3 bananes. Réduisez-les en purée au mixeur, arrosez d un filet de jus de citron.', 'Ajoutez la crème fraîche et le sucre.', 'Placez au réfrigérateur.', 'Montez les 3 blancs d''oeufs en neige ferme, incorporez la purée de fruits, versez dans des ramequins et placez au frais avant servir.'], ['Rouleau à pâtisserie', 'Casserole', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Mousse pomme banane', 'dessert', 'plat de résistance', 'pomme', 'citron', 'mousse fruits', 'sucre', 'blanc d''oeuf', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:21:52.037548', [{'ingredient_id': '5326b5b0-ce8e-4112-8d06-6b16d57a0c7d', 'quantite': '1'}, {'ingredient_id': '8be7401d-bd18-4810-a752-cfc41dca78f3', 'quantite': '3'}, {'ingredient_id': '29a4cd10-d04d-409e-a0de-c3e0b5fda6cc', 'quantite': '2 cuillères'}, {'ingredient_id': 'cd7043ba-0e92-4951-8e37-890f0f77c61c', 'quantite': '3'}, {'ingredient_id': '17d218c6-fb07-4e1f-9f34-0ab10455b093', 'quantite': '3 cuillères'}, {'ingredient_id': 'ee317214-cd2b-4879-ae12-771d576a8392', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (48974, 'Verrines estivales aux bananes', 'banane, jus d''ananas, jus de citron, yaourt nature, crème épaisse, maïs, citron vert', '10 min', ['Passer les bananes au blender avec tous les autres ingrédients.', 'Verser dans des verrines et garnir avec des quartiers de lime.', 'Réfrigérer si nécessaire avant de servir.'], ['Verre doseur', 'Spatule', 'Louche', 'Casserole', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus d''ananas', 'jus de citron', 'maïs', 'citron vert', 'Verrines estivales aux bananes', 'crème épaisse', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:21:55.657184', [{'ingredient_id': '4da91899-fbfc-469d-8410-58876dafb83d', 'quantite': '2'}, {'ingredient_id': '3de006d4-8269-48f4-9799-630a66ca7252', 'quantite': '75 cl'}, {'ingredient_id': 'fdb39f78-ec21-4abb-a4ec-158b83a34cc3', 'quantite': '15 cl'}, {'ingredient_id': 'fe6ae564-9c94-4966-a573-fb36cf0d1ac1', 'quantite': '25 cl'}, {'ingredient_id': 'ce38ce15-aefa-4e8c-88ff-7ef4dbb9f1e9', 'quantite': '12.5 cl'}, {'ingredient_id': '3bde188b-62c4-4bdf-a36c-8fec1e7bbd6a', 'quantite': ''}, {'ingredient_id': 'dd067662-abfb-45b1-aa11-1f86990caf9e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (167408, 'Pizza banane-nutella-noix de coco', 'farine, eau, huile d''olive, sel, Nutella, noix de coco, banane, levure', '10 min', ['Pate a pizza:', 'Dans un saladier, melanger la farine, l''eau, le sel, et l''huile d''olive. Pétrir jusqu''à obtention d''une pate bien lisse. Couvrir le saladier d''un torchon et laisser poser 1h à température ambiante.', 'Quand la pate est levée, l''étaler dans un plat et tartiner le nutella.', 'Découper les bananes en tranches fines et déposer les morceaux sur toute la pate.', 'Faire cuire 20mn à 180°C et à la fin de la cuisson, parsemer la noix de coco en poudre à votre convenance sur la pizza.', 'Laisser tiédir et déguster....', 'Bon appétit!', 'On peut également remplacer la noix de coco par des éclats de nougatine ou de noix de cajou.'], ['Râpe', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'huile d''olive', 'Nutella', 'dessert', 'plat de résistance', 'noix de coco', 'cocktail', 'Pizza banane-nutella-noix de coco'], 'Dessert', ae2a0549-c332-4fec-b5f6-157ab4e82ff2, '2025-09-26T16:21:59.953609', [{'ingredient_id': '12eae81c-3cbc-4208-b680-fb48e59e0e2a', 'quantite': '250 g'}, {'ingredient_id': '8d291065-f4d8-4ecb-9c3e-2464b007ea31', 'quantite': '150 ml'}, {'ingredient_id': 'e4f1a1d4-aec5-45ec-b696-48c4ddca70b3', 'quantite': '2 cuillères'}, {'ingredient_id': 'ac6a876c-ce7d-4c96-82e3-c3be0612ad32', 'quantite': '1 cuillères'}, {'ingredient_id': '9ed016fa-bf98-40ff-8d86-4ce816ac4c7b', 'quantite': '1'}, {'ingredient_id': '6c36e50d-393c-428c-875b-b96b5943d8cf', 'quantite': ''}, {'ingredient_id': 'a6d3d0bf-c8f6-4664-9800-fb8d145dc9f9', 'quantite': '2'}, {'ingredient_id': '3129737d-955b-4289-98fc-693e8b1d65a9', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52730, 'Savoureuse tarte : pomme, poire, banane et chocolat', 'pâte brisée, pomme, poire, banane, chocolat pâtissier, crème, oeuf, sucre vanillé, sucre en poudre', '15 min', ['Préchauffez le four à 200°C (thermostat 6-7).', 'Tapissez le fond du moule avec la pâte brisée puis piquez-la à l''aide d''une fourchette.', 'Epluchez la pomme, la poire, la banane puis découpez-les en cubes  ou en rondelles (banane).', 'Répartissez les fruits sur le fond de pâte puis parsemez de 1/2 carrés de chocolat.', 'Mélangez les oeufs battus avec les sucre et la crème puis nappez-en les fruits.', 'Enfournez pendant 30 à 35 minutes puis laissez refroidir.', 'Bon appétit!'], ['Batteur électrique', 'Mixeur'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'Savoureuse tarte : pomme', 'oeuf', 'plat', 'crème', 'sucre en poudre', 'recette', 'chocolat pâtissier', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'banane et chocolat', 'cocktail'], 'Dessert', 2a6f571e-c022-4bad-9cf8-1fe2d002ffe3, '2025-09-26T16:22:03.965564', [{'ingredient_id': '6e7f3143-905a-4cd0-9e28-7d44f153e19e', 'quantite': '1'}, {'ingredient_id': '84ed3bdf-7116-4825-9875-96c45b4c72ec', 'quantite': '1'}, {'ingredient_id': 'a762d955-76f4-4ce1-a56f-2a75fa419960', 'quantite': '1'}, {'ingredient_id': 'c3892ca8-d12d-4f41-b2f9-2066f82f6a63', 'quantite': '1'}, {'ingredient_id': '5f6d5ede-1d99-4c6c-aef3-ecd717118b0b', 'quantite': '70 g'}, {'ingredient_id': '7f5dd17a-e034-4e93-a049-06d02b88f9bf', 'quantite': '25 cl'}, {'ingredient_id': 'a9270255-ea36-419a-820f-00234a64463b', 'quantite': '3'}, {'ingredient_id': '665b9aef-b856-49c4-8a38-df1dcf2563cb', 'quantite': '2'}, {'ingredient_id': 'eb815314-ab51-4a85-9a69-1915f7de37f9', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (71790, 'Crumble de récup''', 'banane, biscotte, boudoir, raisins secs, amandes en poudre, flocons d''avoine, sucre, cannelle', '3 min', ['Couper la banane en rondelles, les disposer au fond d''un petit moule plat (type moule à crème brûlée, ou moule en terre cuite utilisé pour les fromages de chèvre). Parsemer de raisins secs (éventuellement préalablement trempés dans du café, ou du rhum, ou... ce qu''on veut).', 'Dans un bol, mélanger la poudre d''amande, la biscotte écrasée (pas trop finement), les boudoirs écrasés, les flocons d''avoine, la cannelle. ', 'Répartir le mélange sur la banane, saupoudrer de sucre.', 'Passer 45 sec au micro-onde (850W) à couvert, puis découvrir et passer au grill 2 min (on peut aussi utiliser un four traditionnel...).'], ['Louche', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'amandes en poudre', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Crumble de récup''', 'dessert', 'plat de résistance', 'autres crumbles', 'biscotte', 'raisins secs', 'boudoir', 'cannelle', 'sucre', 'flocons d''avoine', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:22:08.405305', [{'ingredient_id': 'de337b44-d170-46d3-ba09-49eeedfe6bf4', 'quantite': '1'}, {'ingredient_id': '1b89a556-607d-400e-9bcd-bd8b552df7ff', 'quantite': '1'}, {'ingredient_id': '39e84b17-6dfb-4495-96ff-aec333a813fc', 'quantite': '2'}, {'ingredient_id': 'de3039ab-cbdd-456a-823f-a019963ddba2', 'quantite': ''}, {'ingredient_id': 'acbcf068-f7b9-4e4b-b1f3-1120c3038aa5', 'quantite': ''}, {'ingredient_id': '3565ffa4-9b65-48d8-b2ee-d80d8db487bd', 'quantite': ''}, {'ingredient_id': 'bde497a6-8654-4004-9c77-6ae147bfcc8f', 'quantite': ''}, {'ingredient_id': '4c693974-a3ee-4b4b-afe4-e2cc1ae58ced', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61693, 'Smoothie djam', 'orange, banane, yaourt brassé, pomme', '10 min', ['Pressez les oranges.', 'Mettre le jus dans 1 mixer. Ajouter les pommes et les bananes coupées en morceaux ainsi que le yaourt.', 'Mixer pendant 1 minute.', 'Boire frais.'], ['Économe', 'Spatule', 'Louche', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt brassé', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'Smoothie djam', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'orange', 'smoothies', 'cocktail'], 'Boisson', 06cb3ac8-dff3-4e44-a21c-e42bebbf5e85, '2025-09-26T16:22:12.221785', [{'ingredient_id': '8ef38306-c920-4d72-b535-ca9a6568f269', 'quantite': '4'}, {'ingredient_id': 'edf25cd9-a3ea-4ea6-b2df-7ef9f6ce850f', 'quantite': '1'}, {'ingredient_id': '2e0c7709-2d38-42c9-9f53-0e4242685ea5', 'quantite': '1'}, {'ingredient_id': 'a79de367-0351-4a99-92ee-0373565e2c49', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68168, 'Galettes moelleuses à la banane', 'banane, pain au lait, lait, cannelle, oeuf, sucre en poudre, sucre vanillé, sucre glace, raisins secs', '10 min', ['Mettre les pains au lait en morceaux à tremper quelques instants dans le lait.', 'Mettre ensuite tous les ingrédients (sauf les raisins) dans le mixer pour obtenir une belle pâte (si pas assez liquide, rajouter un peu de lait). Dans la préparation, rajouter éventuellement les raisins trempés.', 'Faire cuire de petites crêpes (5-6 cm de diamètres) dans une poêle huilée très chaude.', 'Poser sur une assiette avec du papier absorbant et saupoudrer de sucre glace.', 'Déguster chaud, tiède ou froid.'], ['Pince de cuisine', 'Fouet', 'Presse-agrumes', 'Rouleau à pâtisserie', 'Couteau de chef'], ['', 'Galettes moelleuses à la banane', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pain au lait', 'raisins secs', 'sucre glace', 'cannelle', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:22:16.661976', [{'ingredient_id': '3716ffd1-c201-4f1a-a40f-0e420239f31b', 'quantite': '6'}, {'ingredient_id': 'd37aa9b3-5b71-43d9-9a27-1158a79522c1', 'quantite': '6'}, {'ingredient_id': 'bbb87f06-ea4b-459e-92e4-0ff0bb92270e', 'quantite': '50 cl'}, {'ingredient_id': 'e9ef6bd1-df00-4fd1-a0c8-692d180002e0', 'quantite': '1 cuillères'}, {'ingredient_id': 'd84cfc91-215a-4b1b-9fe9-019696c8a8b4', 'quantite': '1'}, {'ingredient_id': 'a54d9868-70ec-4a55-bd92-daa25bfd2bc7', 'quantite': '100 g'}, {'ingredient_id': '20441f6a-6021-45c3-9a41-51cfefb4babc', 'quantite': '2'}, {'ingredient_id': 'e3abc8bb-8d58-40f7-b451-8a9e34c0b1f6', 'quantite': ''}, {'ingredient_id': 'd4077c23-2100-47b6-8f5a-cd020a543dd4', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22500, 'Pain aux bananes et aux noix', 'farine, beurre, sucre, oeuf, noix, banane, levure, cannelle', '30 min', [' Travailler le beurre et le sucre avec les doigts jusqu''à ce qu''ils soient crémeux. ', 'Ajouter les oeufs battus puis les bananes coupées en rondelles (elles s''écraseront au fil du mélange). Incorporer la farine avec la levure et la cannelle. Mettre les noix hachées.', 'Verser la pâte dans un moule à cake beurré et faire cuire dans un four préchauffé 180°C pendant 1h à 1h15 .'], ['Casserole', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'noix', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'cannelle', 'sucre', 'cocktail', 'Pain aux bananes et aux noix'], 'Dessert', 1cb7e83c-f3f3-4254-9412-c86d59dc3e57, '2025-09-26T16:22:20.325360', [{'ingredient_id': '82e2f732-045f-4eff-ba8c-1e72860befc8', 'quantite': '250 g'}, {'ingredient_id': 'da70f876-a17f-4ec3-8c4c-47f86cfc4aee', 'quantite': '125 g'}, {'ingredient_id': 'ab05ab34-1ef2-4f72-b2a7-377097112641', 'quantite': '125 g'}, {'ingredient_id': '0733f652-9843-45af-8af3-4ed124a57f4f', 'quantite': '2'}, {'ingredient_id': 'ba201790-89c7-499a-95be-dbb1bcb2474c', 'quantite': '75 g'}, {'ingredient_id': '8ad0c2d2-b863-4638-96d0-4c105853b2f9', 'quantite': '3'}, {'ingredient_id': 'b14df7ab-bc33-4b6a-96fe-0cd2ba7ad60a', 'quantite': '1'}, {'ingredient_id': 'd2fea3bb-aee0-433c-a9a5-f29dba162db2', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (233112, 'Crêpes fourrées à la purée de banane', 'farine, oeuf, lait, sucre, purée, banane, Nutella, beurre, sucre, jus d''orange', '20 min', ['Mettre la farine, le sucre et une pincée de sel dans un saladier, faire un puits au centre.', 'Y mettre les œufs et mélanger, ajouter petit à petit le lait.', 'Mélanger jusqu''à ce que la pâte soit homogène.', 'Dans une poêle, faire fondre le beurre avec le sucre puis y ajouter les bananes coupées en rondelles et faire cuire 10 minutes.', 'En attendant, faire cuire les crêpes.', 'Quand les bananes sont fondantes, y ajouter le Nutella et le jus d''orange. ', 'Fourrer les crêpes avec la purée et déguster bien chaud.', 'Bon appétit!'], ['Râpe', 'Couteau de chef', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'Nutella', 'dessert', 'plat de résistance', 'crêpes sucrées', 'beurre', 'purée', 'jus d''orange', 'lait', 'sucre', 'cocktail', 'Crêpes fourrées à la purée de banane'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:22:24.782197', [{'ingredient_id': '87c1d9e5-a42f-4150-aeed-c54be3df28a1', 'quantite': '250 g'}, {'ingredient_id': '011bbdfa-5a93-432a-a991-9449aaa1741f', 'quantite': '3'}, {'ingredient_id': '711ee72a-b1f5-42aa-bbdb-639196596ed2', 'quantite': '50 cl'}, {'ingredient_id': 'a86c7a44-7235-49b4-a739-4896a6727924', 'quantite': '3 cuillères'}, {'ingredient_id': '8c6648d6-6496-4d17-9f6b-8b918795ebf5', 'quantite': ''}, {'ingredient_id': 'b01114d2-ccbb-4e4b-bd55-74484f2c4f62', 'quantite': '4'}, {'ingredient_id': '62f6ddde-e266-4c53-aa40-da5160d3e664', 'quantite': '4 cuillères'}, {'ingredient_id': '7b70ac5f-cf84-4d32-aea9-7105c13089d2', 'quantite': '1'}, {'ingredient_id': '1eafc4c9-4999-4d35-8382-59edef940a5f', 'quantite': '1 cuillères'}, {'ingredient_id': '9d0e218d-66c4-43f4-86e2-6f35a0122659', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23668, 'Cake bananes et chocolat', 'farine, oeuf, sucre, banane, beurre, levure, gingembre, chocolat noir, jus de citron', '20 min', ['Couper les bananes dans le sens de la longueur, puis en dés/Les placer dans un saladier, avec un peu de jus de citron.', 'Allumer le four à thermostat 7 (210°C).', 'Placer dans une terrine beurre ramolli, sucre, levure et sel, puis mélanger. Ajouter les oeufs un à un en travaillant la pâte.', 'Verser la farine d''un seul coup.', 'Ajouter le gingembre, les bananes, le jus de citron, puis le chocolat coupé en (petits) morceaux. Bien mélanger.', 'Verser dans un moule à cake beurré et cuire 15 min à thermostat 7, puis 30 min à thermostat 6 (180°C).'], ['Économe', 'Râpe'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'chocolat noir', 'jus de citron', 'moyen', 'beurre', 'Cake bananes et chocolat', 'sucre', 'cocktail'], 'Dessert', 3209e00a-5aff-48b6-ae75-748f45210df3, '2025-09-26T16:22:31.535416', [{'ingredient_id': '798cea3c-405f-440b-b660-9da7eafa68d7', 'quantite': '250 g'}, {'ingredient_id': 'c4bed90f-bff8-4578-89f1-8498db290bfd', 'quantite': '3'}, {'ingredient_id': '47208fbf-95c2-4600-9af9-564a66b51ad9', 'quantite': '125 g'}, {'ingredient_id': '7127c178-278a-4ca8-a807-5c89b53d4ee6', 'quantite': '2'}, {'ingredient_id': 'fd1a8397-b1dd-4953-8380-d240e50aa094', 'quantite': '175 g'}, {'ingredient_id': '82206aee-b55b-4a89-ba9d-e83361fddd6b', 'quantite': ''}, {'ingredient_id': '09f55880-2da7-47f5-8e05-e1dc6c1ec447', 'quantite': '1'}, {'ingredient_id': '14cad0e0-0bbd-4fde-a1dc-f7bf9add234b', 'quantite': '125 g'}, {'ingredient_id': '9a0922f3-175c-4b30-aa1c-10c843d52703', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (532828, 'Fingers de pain perdu banane pâte à tartiner', 'banane, pain de mie, pâte à tartiner, beurre, oeuf, crème liquide, sucre vanillé', '10 min', ['Retirer la croûte des tranches de pain de mie puis étaler finement à l''aide d''un rouleau à pâtisserie.', 'Etaler la pâte à tartiner sur les tranches de pain de mie (en laissant 1 cm vide sur un des côtés.', 'Couper la banane en 8 bâtonnets (ou en petits dés si c''est plus simple) et disposer sur le bord à l''opposé du bord laissé vide. Rouler le pain de mie sur lui-même.', 'Mélanger l''oeuf et la crème puis les passer dedans avant de faire cuire dans le beurre fondu dans une poêle chaude.', 'Faire dorer de chaque côté.', 'A la sortie de la poêle rouler saupoudrer de sucre vanillé.'], ['Couteau de chef', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'Fingers de pain perdu banane pâte à tartiner', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'cocktail', 'pain de mie', 'pâte à tartiner'], 'Amuse-gueule', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:22:35.106123', [{'ingredient_id': 'fe11ed15-2d22-4af4-a5d9-1d9faa2196d9', 'quantite': '1'}, {'ingredient_id': '04f284cb-2961-4fe3-965e-52a0e7ded7c5', 'quantite': '8'}, {'ingredient_id': '2b4f9587-0cd7-4310-bc76-a3546dbcc58d', 'quantite': '8 cuillères'}, {'ingredient_id': '65bedadb-7b0e-45f2-9e45-07539e4d401e', 'quantite': '30 g'}, {'ingredient_id': '59fb9f15-bbda-4698-aff0-9fe9a2b59d83', 'quantite': '2'}, {'ingredient_id': 'eab4fff0-1c3f-43e3-99d9-6ccdbc3b3a67', 'quantite': '5 cl'}, {'ingredient_id': 'a044cd65-f8e9-49be-8681-8bc8171cd28e', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34201, 'Confiture  de fruits exotiques et vanille', 'ananas, ananas, mangue, banane, fruit de la passion, kiwi, vanille, sucre', '30 min', ['Pelez tous les fruits et coupez les en petits morceaux, sauf un kiwi et quelques rondelles d''ananas. Passez le jus et la pulpe des fruits de la passion pour éviter les pépins. ', 'Faites cuire dans un confiturier en cuivre en ajoutant une gousse de vanille fendue en deux dont vous aurez gratté les grains noirs. Laissez cuire une bonne demie-heure. Mixez la confiture pour obtenir une marmelade lisse. Ajoutez les morceaux d''ananas et le kiwi coupé en rondelles. Laissez cuire 10 mn supplémentaires. ', 'Ajoutez le sucre. Faitez cuire encore 10 mn en écumant régulièrement. ', 'Récupérez la gousse de vanille et coupez-la en six. Ebouillantez vos pots de confiture et séchez-les. ', 'Versez la confiture dans les pots en ajoutant un morceau de de la gousse de vanille dans chaque pot. ', 'Fermez et retournez les pots pour la conservation. ', 'Si vous êtes gourmands, vous n''aurez pas à la conserver longtemps !'], ['Casserole', 'Tire-bouchon', 'Louche'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'Confiture  de fruits exotiques et vanille', 'fruit de la passion', 'dessert', 'plat de résistance', 'moyen', 'ananas', 'sucre', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:22:38.824179', [{'ingredient_id': '5280d742-429d-45a3-8e8d-489e3c301551', 'quantite': '1'}, {'ingredient_id': '4448a088-ab02-4a0b-990e-fa177af403a4', 'quantite': '2'}, {'ingredient_id': '7bdffc04-5820-41e4-8ca3-21f097c4d61e', 'quantite': '2'}, {'ingredient_id': '0df30981-f620-4a74-9f68-452bf255b17e', 'quantite': '2'}, {'ingredient_id': '6adb70a8-8603-4b9f-ade6-94f98d39cfeb', 'quantite': '15'}, {'ingredient_id': '51e303dc-60d5-4e51-be2b-bc3a3a0a9b60', 'quantite': '2'}, {'ingredient_id': 'f62b49b9-b27e-4046-a938-08999c44063b', 'quantite': '1'}, {'ingredient_id': '884184a1-bd06-4bf3-959e-a4140c8cf3be', 'quantite': '1.3 kg'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (87126, 'Compote poires biscuits (idéale pour bébé gourmand)', 'poire, banane, sucre vanillé, biscuit sablé, eau', '5 min', ['Éplucher la banane et peler les poires. ', 'Les faire cuire dans une casserole à feu moyen avec l''eau.', 'Laisser cuire 10 min à découvert.', 'En fin de cuisson, rajouter les biscuits et le sachet de sucre vanillé.', 'Mixer. ', 'Déguster !'], ['Louche', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'biscuit sablé', 'testées', 'poire', 'très facile', 'bon marché', 'plat', 'recette', 'Compote poires biscuits (idéale pour bébé gourmand)', 'cuisine', 'recettes', 'boisson', 'compote de poire', 'dessert', 'plat de résistance', 'sucre vanillé', 'cocktail'], 'Dessert', 60ea1b50-0545-4774-b1cf-1036897a2c47, '2025-09-26T16:22:42.371332', [{'ingredient_id': '11b48c36-bd42-4389-916a-2b5945cdfec1', 'quantite': '4'}, {'ingredient_id': '0f7fea53-5719-401c-9110-75ed289f3f01', 'quantite': '1'}, {'ingredient_id': 'f712e012-e65b-40d8-a85f-d0b503ad8745', 'quantite': '1'}, {'ingredient_id': 'aea6b7a2-bf44-4dd1-96b2-3996248f6051', 'quantite': '3'}, {'ingredient_id': '9124e37b-e46e-404b-93d7-ab214446c62a', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169005, 'Cheesecake à la banane et à la confiture de lait', 'biscuit sablé, chocolat pâtissier, beurre, banane, fromage blanc, gélatine, sucre', '25 min', ['Confiture de lait :', '- Placer la boîte de lait concentré sucré dans une cocotte minute, sans l''ouvrir (la boîte, pas la cocotte).', '- La recouvrir largement d''eau.', '- Faire cuire 45 minutes sous pression.', '- Laisser refroidir un peu avant d''ouvrir la boîte.', 'Pâte :', '- Faire fondre le chocolat et le beurre.', '- Emietter les biscuits.', '- Mélanger le tout.', '- Tasser au fond d''un moule à charnière, sans remonter sur les bords.', '- Faire durcir au réfrigérateur (c''est assez rapide).', 'Bananes : les écraser et les étaler sur la pâte.', 'Garniture :', '- Faire ramollir la gélatine à l''eau froide, puis la faire fondre dans un petit fond d''eau chaude. Astuce : on peut tout simplement mettre la gélatine mouillée dans un récipient, sans trop l''égoutter, et la passer quelques secondes au micro-ondes.', '- Mélanger le fromage blanc, la gélatine, 200 de confiture de lait et le sucre.', '- Verser sur les bananes et faire prendre au frais.', '- Au moment de servir, saupoudrer avec un peu de cacao pour décorer.'], ['Poêle', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'biscuit sablé', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'confiture de lait', 'dessert', 'plat de résistance', 'beurre', 'Cheesecake à la banane et à la confiture de lait', 'cocktail'], 'Dessert', c2b5f35f-e757-4133-a302-737b71e22b7f, '2025-09-26T16:22:47.012030', [{'ingredient_id': '5fecd710-50a1-44a7-a304-dbc41f569958', 'quantite': '220 g'}, {'ingredient_id': 'a75a4279-43c1-49f6-9fe3-87b5075c84dc', 'quantite': '40 g'}, {'ingredient_id': 'bff95333-6589-4f0f-a4ee-ddbb0fc0a7be', 'quantite': '100 g'}, {'ingredient_id': 'f3d83788-6144-475d-b1b6-753d9179599c', 'quantite': '3'}, {'ingredient_id': '8361ae73-87ae-4c9b-b5bc-0490065571d4', 'quantite': '350 g'}, {'ingredient_id': 'ad9f2785-f625-4009-b47b-90aaf48afcf8', 'quantite': '4'}, {'ingredient_id': '051d1eee-7428-42e6-a061-0bd4fa241eec', 'quantite': '30 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345625, 'Gâteau à la banane de Rosetta Banana (sans gluten)', 'banane, citron, oeuf, lait d''avoine, beurre, sucre, farine de riz, levure chimique, sel', '20 min', ['Mixer les bananes avec le jus de citron.', 'Ajouter les oeufs, le lait et le beurre fondu pour obtenir une crème légère.', 'Dans une terrine mélangez la farine, le sel le sucre et la levure.', 'Faites un puits et ajoutez la préparation à la banane. Mélangez.', 'Beurrez un moule à manqué ou bien un moule à cake et y verser la préparation.', 'Enfournez 40 minutes à 150°C (thermostat 5).'], ['Presse-agrumes', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'farine de riz', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Gâteau à la banane de Rosetta Banana (sans gluten)', 'dessert', 'plat de résistance', 'gâteau à la banane', 'beurre', 'lait d''avoine', 'citron', 'sucre', 'cocktail'], 'Dessert', ed9fe0c3-ad46-4b56-a25e-a01bc138e6c3, '2025-09-26T16:22:51.691585', [{'ingredient_id': '0b899543-7a2d-4ed0-b791-1473519c45b5', 'quantite': '3'}, {'ingredient_id': 'e5ad1466-bfad-4162-9137-469770a2dd65', 'quantite': ''}, {'ingredient_id': '7e927dab-fd24-4929-bd21-a793096de6a3', 'quantite': '2'}, {'ingredient_id': '1a293234-1192-4085-ad34-ed6c874d71d7', 'quantite': '4 cuillères'}, {'ingredient_id': 'fbb362c3-acfe-4624-bc40-a5109e22402f', 'quantite': '15 g'}, {'ingredient_id': '6cd198d4-c3bb-4791-b5dc-a74f2b044688', 'quantite': '100 g'}, {'ingredient_id': 'b112fdd8-e853-437a-a62e-4af71bf24ffc', 'quantite': '240 g'}, {'ingredient_id': '4266b3d2-dedf-4ce7-b1ad-ecd0379c67fc', 'quantite': '1'}, {'ingredient_id': '724fe47d-ae09-42a9-abf0-b6300cb08676', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (314997, 'Salade de fleurs de bananier', 'crevettes, crème de coco, nuoc mam, citron vert, noix de coco rapée, sucre brun, piment, ail, curcuma', '45 min', ['Tout d''abord il faut préparer avant de commencer un saladier d’eau fraîche dans lequel vous allez presser un citron.', 'Pour ce qui est de la réalisation, la fleur de bananier demande un peu de boulot. ', 'Pour la préparer, il faut d’abord enlever les premières couches de feuilles (à garder pour la présentation). ', 'Ce faisant, vous allez découvrir qu’entre chaque couche se cachent des petites bananes atrophiées, qu’il faudra donc retirer ou bien éplucher une à une, c''est plus long (il faut enlever à l''intérieur une petite pellicule qui ressemble à du plastique et le pistil qui est au milieu) mais on peut les consommer, moi j''aime.', 'Les premières couches de pétales sont rouges, mais plus vous arriverez au cœur de la fleur plus leur teinte s’éclaircit. ', 'Continuer d’enlever les pétales et émincez-les en fines lamelles (en prenant bien soin d’avoir enlevé à chaque fois les bébés bananes). Lorsqu’elles sont jaunes pales, coupez ce cœur de la fleur en rondelles.', 'Jetez les lamelles de fleurs dans l''eau citronnée dès que vous les avez coupées, afin d’éviter qu’elles noircissent. ', 'Faites-les dégorger dans cette eau citronnée une petite demi heure afin de diminuer leur amertume. ', 'Vos fleurs de bananiers sont maintenant prêtes à l’usage, vous n’avez plus qu’à les égoutter puis les plonger dans l''eau bouillante salée 5 min afin de les blanchir (on n''est pas obligé mais moi je préfère ça diminue l''amertume). Puis laisser refroidir.', 'Faites cuire les crevettes à la vapeur.', 'Étalez la noix de coco râpée sur la plaque de votre four recouverte de papier sulfurisé, et enfourner une dizaine de minutes à 200°C jusqu’à ce qu’elle prenne une jolie teinte ambrée. ', 'Surveillez que cela ne brûle pas et mélangez éventuellement au cours de la cuisson pour que cela grille uniformément.', 'Préparez la sauce en mélangeant la crème de coco, le jus du citron vert, les épices et le Nuoc Mam (commencez par une cuillère à soupe) et le sucre. Goûtez et rectifiez l’assaisonnement.', 'Mélangez tous les ingrédients et servez dans les premières feuilles de bananier que vous aurez réservé pour une présentation originale.'], ['Râpe', 'Moule à tarte', 'Rouleau à pâtisserie', 'Tire-bouchon', 'Couteau de chef'], ['', 'Salade de fleurs de bananier', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'ail', 'rapide', 'plat', 'recette', 'piment', 'cuisine', 'recettes', 'boisson', 'curcuma', 'crème de coco', 'sucre brun', 'noix de coco rapée', 'nuoc mam', 'dessert', 'crevettes', 'plat de résistance', 'citron vert', 'cocktail'], 'Entrée', 46ad6cfe-aec3-417c-99f7-9f9f63aa7546, '2025-09-26T16:22:55.349362', [{'ingredient_id': '961064d2-24d3-4224-b913-6097d3f7424a', 'quantite': '12'}, {'ingredient_id': 'bf15f3f7-d9d2-4575-8861-026418fcfde5', 'quantite': '20 cl'}, {'ingredient_id': 'cdc0d5fd-e6e7-49df-8a76-68aafcab8052', 'quantite': ''}, {'ingredient_id': '5b56c0ee-9c47-40c3-b825-c7ce890af1c3', 'quantite': '1'}, {'ingredient_id': '2ad9f24b-91c1-4e6d-b381-6e62b753bef3', 'quantite': '4 cuillères'}, {'ingredient_id': 'dd18afa4-bda0-42ee-82fd-2dc29d299295', 'quantite': '1 cuillères'}, {'ingredient_id': '313ba8ae-b77f-4494-a001-6da8065f4db2', 'quantite': '1'}, {'ingredient_id': 'fa5973d7-56c6-4f6d-b4f6-82abea89be34', 'quantite': '1'}, {'ingredient_id': 'f6c5537d-10e1-4c6d-a123-b6c68c11dda2', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (164999, 'Verrine miam miam!', 'banane, chocolat au lait, glace, crème allégée', '15 min', ['Découpez les carrés de chocolat au lait, les mettre dans une casserole à feu doux avec la crème liquide', 'Pendant ce temps, coupez les bananes en demi-lune, réservez.', 'Sortez la glace du congélateur pour qu''elle soit juste un peu réchauffée (plus facile pour servir!)', 'Une fois le chocolat fondu, le retirer du feu.', 'Prendre un beau verre à orangeade, disposez quelques morceaux de bananes dans le fond, mettre un peu de chocolat par dessus, remettre des bananes puis du chocolat.', 'Ajoutez ensuite 2 boules de glace et terminez avec du chocolat.'], ['Planche à découper', 'Batteur électrique', 'Casserole', 'Tire-bouchon', 'Presse-agrumes'], ['', 'chocolat au lait', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Verrine miam miam!', 'très facile', 'bon marché', 'rapide', 'plat', 'crème allégée', 'recette', 'cuisine', 'recettes', 'boisson', 'glace', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', daa5eabe-89bb-43e6-a3c8-c810fe49d449, '2025-09-26T16:23:00.209666', [{'ingredient_id': 'fcbe22f9-abc5-4121-907a-47b8a3d99212', 'quantite': '2'}, {'ingredient_id': 'ff41dd69-8264-43b0-89c6-c7a2716ee912', 'quantite': '2'}, {'ingredient_id': '8ecae475-20b8-42ec-9ad5-0c8597a13d97', 'quantite': ''}, {'ingredient_id': '9f887f27-637c-4f6f-ad1a-24b8be678424', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68757, 'Salade de fruits frais et confits', 'pomme, ananas, kiwi, fraises, banane, papaye, ananas, vanille, sucre vanillé, jus d''orange', '15 min', ['Peler et couper les fruits, les verser dans 1 saladier. Ajouter la gousse de vanille fendue, verser le jus d''orange.', 'Saupoudrer avec le sucre vanillé.', 'Mettre au réfrigérateur au moins 1 h. Sortir 20 minutes avant de déguster.', 'Bon appétit !'], ['Spatule', 'Poêle', 'Pince de cuisine', 'Tire-bouchon', 'Passoire'], ['Salade de fruits frais et confits', 'entrée', 'salade de fruits originale', 'banane', 'kiwi', 'papaye', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'ananas', 'jus d''orange', 'cocktail'], 'Dessert', 7c471314-8355-4bda-a771-865ebbc3a09d, '2025-09-26T16:23:05.707027', [{'ingredient_id': '9ba126cd-b11c-47c4-b088-c998de041011', 'quantite': '2'}, {'ingredient_id': 'd5f71606-6e3b-4233-aca8-f01af74fbaf3', 'quantite': '1'}, {'ingredient_id': '4911b423-5f86-4219-87b7-6b24058c273a', 'quantite': '2'}, {'ingredient_id': '702fbb76-ee28-4049-a5a6-c9f87722f6f3', 'quantite': '250 g'}, {'ingredient_id': '4ce209c5-f8d5-4385-8209-0fd03bd482ea', 'quantite': '2'}, {'ingredient_id': 'ea0bfda9-3bda-43be-984c-42ecba51c63e', 'quantite': '20 g'}, {'ingredient_id': '50ea463c-726a-4f67-940c-ba6bea8299a8', 'quantite': '20 g'}, {'ingredient_id': 'bfa18da4-cdd9-413e-891e-64947fd6dac7', 'quantite': '1'}, {'ingredient_id': '17b726f4-c205-4d87-ad6b-e9302842b4e8', 'quantite': '2'}, {'ingredient_id': '268767a2-5fbb-4b2d-b0cd-e56886bbb8f9', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12003, 'Soupe a la banane', 'banane, tomates pelées, bouillon de volaille, farine, beurre, eau, sel', '10 min', ['Faire un roux avec du beurre et de la farine.', 'Ajouter les tomates, les bananes coupées en rondelles, les bouillons cubes, le sel, l''eau.', 'Cuire 30 mn en auto-cuiseur. Mixer.', 'Les enfants adorent...Les parents aussi...'], ['Économe', 'Mixeur', 'Casserole', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'eau', 'testées', 'tomates pelées', 'très facile', 'bon marché', 'plat', 'bouillon de volaille', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'soupe', 'dessert', 'Soupe a la banane', 'plat de résistance', 'beurre', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:23:10.605211', [{'ingredient_id': 'e1f77c92-99a2-427f-b409-2e914b320289', 'quantite': '3'}, {'ingredient_id': '54a57f44-7fe5-4f27-801f-a9dd69fd43ef', 'quantite': '476 g'}, {'ingredient_id': 'ba652bd8-81d6-474f-a503-4000f9620245', 'quantite': '2'}, {'ingredient_id': 'e837356b-3fc1-427e-8a46-380a5f0bc284', 'quantite': ''}, {'ingredient_id': '108879da-c9eb-4545-9913-3c72ef0993f8', 'quantite': ''}, {'ingredient_id': 'efc0df6f-f542-44c1-a8ec-c395ad76ac88', 'quantite': '1 l'}, {'ingredient_id': '9c2b42ac-9a89-436f-b312-1da630f94e6a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57315, 'Cake chocolat banane', 'banane, crème dessert au chocolat, farine, sucre, beurre, oeuf, levure, sucre vanillé, rhum, sel, citron', '20 min', ['Travailler le beurre mou, le sucre et les oeufs.', 'Ajouter le sel, farine + levure tamisées.', 'Faire fondre le chocolat et le rajouter à l''appareil.', 'Ecraser les bananes à la fourchette, presser le citron pour éviter qu''elles noircissent, verser le sucre vanillé et le rhum.', 'Incorporer le tout à l''appareil.', 'Beurrer un moule à cake, verser la pâte et cuire au four préchauffer à 180°C (thermostat 6).'], ['Économe', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'Cake chocolat banane', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron', 'beurre', 'crème dessert au chocolat', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:23:14.255467', [{'ingredient_id': '8bd8180b-0437-4647-b7cf-d76884f5b64e', 'quantite': '600 g'}, {'ingredient_id': 'b48fadb0-974d-4569-9277-f8d40977f066', 'quantite': '100 g'}, {'ingredient_id': '4acfea8b-67e1-4367-b9f3-417d5e9febc8', 'quantite': '250 g'}, {'ingredient_id': '6e4500b7-c60b-46b1-a89c-ae51c36052b3', 'quantite': '200 g'}, {'ingredient_id': 'ead2dc05-8048-400a-a615-7f1c7b947658', 'quantite': '100 g'}, {'ingredient_id': 'eea2e75d-95db-458a-8e54-f0c1c23830ea', 'quantite': '2'}, {'ingredient_id': 'e0cead14-5cd2-4612-8a5c-3d817ab6373b', 'quantite': '1'}, {'ingredient_id': '60416162-c1bb-4267-99a0-4907ed3e03e5', 'quantite': '1'}, {'ingredient_id': 'a0408efd-f090-40b3-b2f1-506af5f2ddc0', 'quantite': ''}, {'ingredient_id': '0289459c-d477-435d-a6ff-3b2dc82203c5', 'quantite': ''}, {'ingredient_id': '4d830ed0-b8c1-4ada-8393-69e38b2b66ef', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (35478, 'Confiture de bananes', 'banane, sucre en poudre, jus de citron', '10 min', ['Couper les bananes en rondelles. ', 'Ajouter le sucre et le jus des citrons. ', 'Faire cuire 1 heure à feu moyen. ', 'Ecumer la mousse de la confiture. ', 'Laisser refroidir une bonne heure, puis recuire la confiture une heure, puis passer légèrement au mixer. ', 'La confiture doit avoir une jolie couleur rose fonçée. ', 'Il ne reste plus qu''à déguster cette délicieuse confiture d''hiver.'], ['Ouvre-boîte', 'Moule à tarte', 'Presse-agrumes', 'Mixeur', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'sucre en poudre', 'recette', 'Confiture de bananes', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:23:20.068969', [{'ingredient_id': 'ff3ff263-33d9-4c23-b6fc-8c53a040dc03', 'quantite': '1 kg'}, {'ingredient_id': '7ce08baa-ab18-4936-a5a8-1c7dd0f233a6', 'quantite': '700 g'}, {'ingredient_id': 'b27884ba-b652-4bf4-9b54-c848ecbb900f', 'quantite': '30 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11391, 'Cake au citron', 'farine, sucre, oeuf, levure chimique, beurre, citron, sucre, citron', '10 min', ['Séparer les blancs de jaunes. ', 'Battre les blancs d''oeufs en neige, puis les réserver.', 'Au bain-marie, faire fondre le beurre.', 'Râper le citron.', 'Travailler les jaunes avec le sucre.', 'Ajouter le citron râpé, la farine, la levure et le beurre fondu. Y incorporer délicatement les blancs en neige.', 'Enfourner à 180°C (thermostat 6) pendant 30 à 40 min.', 'Pendant ce temps, faire le sirop à feu doux avec les 20 morceaux de sucre et le jus des 2 citrons; imprégner le cake avec ce sirop.', 'Servir froid avec de la crème anglaise, des fraises, framboises, etc. Et même nature !'], ['Casserole', 'Rouleau à pâtisserie'], ['entrée', 'recettes de cuisine', 'cake au citron', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'Cake au citron', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'citron', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:23:26.774849', [{'ingredient_id': 'aab0c394-148d-42a8-8c7d-21bec3c58cd8', 'quantite': '200 g'}, {'ingredient_id': '4ebb718f-17a6-4bca-a34c-aa79c227d461', 'quantite': '200 g'}, {'ingredient_id': '1930f664-ab84-49f5-9921-608f6f2ee427', 'quantite': '4'}, {'ingredient_id': '8da63788-dedb-4cf9-920f-98f2a6d2a6ca', 'quantite': ''}, {'ingredient_id': '5ae1fcde-961c-4972-b5fa-7f184bc445db', 'quantite': '100 g'}, {'ingredient_id': '8ec66365-e7c3-4b94-be32-a644d8785158', 'quantite': '1'}, {'ingredient_id': 'cc1e801f-cef2-4a42-84da-50dc3563f7ca', 'quantite': '20'}, {'ingredient_id': '790b73ce-e20e-43e6-8894-bedf563aa6a9', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22823, 'Sangria (Espagne)', 'vin rouge, soda, limonade, orange, vermouth, pêche, orange, citron, poire, pomme, banane, cannelle, cannelle, sucre', '20 min', ['A préparer la veille.', 'Couper en morceaux les fruits (sauf la banane), les bâtonnets de cannelle (en deux) et les ajouter au vin rouge. Mettre 2 cuillères à café de cannelle en poudre. Bien remuer. ', 'Dissoudre le sucre dans le jus d´orange et ajouter aussi au vin. Laisser macérer 4-5 heures. ', 'Verser la liqueur choisie, la soda, la limonade et la banane tranchée. ', 'Laisser quelques heures au frigo avant la consommer. ', 'Rectifier, selon le goût, en sucre, liqueur ou cannelle.'], ['Pince de cuisine', 'Spatule', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'vermouth', 'poire', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'sangria', 'boisson', 'soda', 'vin rouge', 'dessert', 'plat de résistance', 'Sangria (Espagne)', 'pomme', 'moyen', 'citron', 'orange', 'limonade', 'pêche', 'cannelle', 'sucre', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:23:30.413678', [{'ingredient_id': 'e0386ee7-3f2c-4034-bba8-814478e16717', 'quantite': '1 l'}, {'ingredient_id': '7657c86c-4ab5-4a9a-b1c3-9e5726ea9883', 'quantite': '50 cl'}, {'ingredient_id': '9b5b24c1-edbe-4033-9af0-28a2fccd621d', 'quantite': '50 cl'}, {'ingredient_id': 'fb685842-93ee-4b7c-ad98-b0a6de4069b1', 'quantite': '25 cl'}, {'ingredient_id': 'e2c9ac4e-e19e-48f9-bd03-5da742fa3656', 'quantite': '10 cl'}, {'ingredient_id': '5f415809-6c23-4dbc-bb9c-1a9cad18b772', 'quantite': '2'}, {'ingredient_id': 'bc0d0481-e04c-46df-b680-e8f449b8e447', 'quantite': '1'}, {'ingredient_id': 'b0358b04-104b-4afb-a822-986d92475c2f', 'quantite': '1'}, {'ingredient_id': 'f5fe6220-8952-4d88-a907-8638b1c663e0', 'quantite': '1'}, {'ingredient_id': '97fff6b1-2ab6-497c-8309-47229c0cf616', 'quantite': '1'}, {'ingredient_id': '54a6ec58-1d34-43e4-bce1-e54f444f3389', 'quantite': '1'}, {'ingredient_id': 'd8669f91-bd40-4188-ba32-5f33936c3882', 'quantite': '1'}, {'ingredient_id': '170acd3b-dac7-47d7-97b6-5ff2b7bfd4ca', 'quantite': ''}, {'ingredient_id': 'd55331b6-c54a-41ac-bc65-93161472358d', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228743, 'Smoothie banane mangue passion', 'banane, mangue, fruit de la passion, citron vert, lait concentré sucré, glace pilée, eau', '5 min', ['Mettre le tout dans un mixeur coupé en morceaux, pulser afin d''obtenir un mélange homogène. ', 'Tamiser le tout puis servir bien frais.'], ['Ouvre-boîte', 'Économe', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'facile', 'bon marché', 'Smoothie banane mangue passion', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'lait concentré sucré', 'boisson', 'fruit de la passion', 'dessert', 'plat de résistance', 'citron vert', 'smoothies', 'cocktail', 'glace pilée'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:23:34.902931', [{'ingredient_id': 'f91e28e0-a344-4ddf-a621-bb369f58d52d', 'quantite': '4'}, {'ingredient_id': 'cf92ea47-02bd-4580-b7d1-e4e178466752', 'quantite': '2'}, {'ingredient_id': '68184d9b-8ac4-47f8-907d-2d6d9e489f8e', 'quantite': '2'}, {'ingredient_id': 'da2d6510-816d-4082-b9a9-b7a391e0059a', 'quantite': '1'}, {'ingredient_id': 'a0d07fdf-e646-4e7d-8322-09739ba44f50', 'quantite': '25 cl'}, {'ingredient_id': '686df84d-1ff3-4a1d-8077-b88fe287f168', 'quantite': ''}, {'ingredient_id': 'ad007e21-aec7-4bb2-9c84-f4d4b9d2631b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72294, 'Gâteau Meringué praline - fraises (pavlova)', 'oeuf, sucre en poudre, sucre brun, vinaigre, maïzena, vanille, amandes, crème liquide, sucre en poudre, vanille, fraises, banane', '25 min', ['Passer les amandes au mixer pour les hacher grossièrement. Mélanger les 2 sucres et la vanille en poudre.', 'Préchauffer le four à 180°C (thermostat 6). Recouvrir une plaque allant au four de papier sulfurisé.', 'Séparer les blancs des jaunes d''oeufs. Ajouter au blancs une pincée de sel et les monter en neige. ', 'Verser le mélange de sucres sur les blancs, en 3 fois. Battre le mélange jusqu''à ce qu''il redevienne ferme après chaque addition.', 'Incorporer la maïzena et le vinaigre, fouetter jusqu''à ce que le mélange soit assez ferme pour le sentir s´alourdir sur les batteurs.', 'Disposer la moitié de la meringue sur le papier sulfurisé en forme de cercle, saupoudrer d´un tiers des amandes.', 'Ajouter le reste de meringue pour obtenir un cercle épais, lisser légèrement le dessus, et laisser de jolis mouvements sur les bords. ', 'Parsemer d´un autre tiers d´amandes.', 'Enfourner et baisser le four à 140ºC (thermostat 3-4). Faire cuire 1h15. Eteindre le four et laisser la meringue refroidir dedans pendant 1h.', 'Fouetter la crème (très froide) avec le sucre et la poudre de vanille jusqu''à ce qu''elle monte en chantilly.', 'Déposer délicatement les bananes en rondelles pour recouvrir la Pavlova.', 'Etaler la chantilly dessus (délicatement pour ne pas faire tomber la meringue) et décorer avec les fraises coupées en tranches, plantées dedans en position verticale. Parsemer du reste d´amandes et d´un peu de sucre glace tamisé.'], ['Ouvre-boîte', 'Verre doseur', 'Fouet', 'Couteau de chef'], ['amandes', 'entrée', 'Gâteau Meringué praline - fraises (pavlova)', 'recettes de cuisine', 'confiserie', 'testées', 'maïzena', 'bon marché', 'oeuf', 'plat', 'moyenne', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre brun', 'vanille', 'dessert', 'plat de résistance', 'pralines', 'vinaigre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:23:39.940275', [{'ingredient_id': 'cad03464-224d-461d-b268-a033f441958b', 'quantite': '4'}, {'ingredient_id': '8aaed371-6731-4632-b4c6-2eb0c9581212', 'quantite': '125 g'}, {'ingredient_id': '683a32f1-672b-4a9f-bc18-5762c757a424', 'quantite': '125 g'}, {'ingredient_id': 'e37676be-0580-429f-bca6-36d1f68ad915', 'quantite': '1 cuillères'}, {'ingredient_id': '13d68e8c-f91c-4d16-a27d-25946a69989f', 'quantite': '1 cuillères'}, {'ingredient_id': '91ed5710-3b0b-4852-8d32-c3dc8ba6aaf3', 'quantite': ''}, {'ingredient_id': '6d91ee47-a5d3-45da-83a0-a4facfc6bef7', 'quantite': '50 g'}, {'ingredient_id': '2e138f3f-2e30-489a-a813-4ae75e56647e', 'quantite': '40 cl'}, {'ingredient_id': 'b36e1504-9f7e-412a-b6f1-993252e55cb4', 'quantite': '1 cuillères'}, {'ingredient_id': '77b50332-b821-4602-a5d2-c314a0d81740', 'quantite': ''}, {'ingredient_id': '521b395b-4d3a-4f34-8670-4151ac418ab1', 'quantite': '200 g'}, {'ingredient_id': '3658609f-fd14-426e-a374-0784fc3ddd90', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36933, 'Pizza africaine', 'pâte à pizza, lait de coco, pâte de curry, escalope de poulet, oignon, poivron rouge, banane, arachide, cheddar, coriandre, poivre, sel', '30 min', ['Préchauffer le four à 220°C (thermostat 7-8, 425°F).', 'Dans une casserole, faire réduire à feu moyen le lait de coco avec une cuillère à soupe de pâte de curry jusqu''à ce que le contenu soit réduit de moitié.', 'Pendant ce temps, cuire à feu vif les blancs de poulets coupés en petits dés d''environ un centimètre. Couper le poivron et le faire sauter avec ainsi que l''oignon.', 'Couper la banane en rondelles.', 'Mettre la pâte à pizza sur une pierre ou une assiette de céramique. ', 'Étaler le lait de coco réduit sur la pâte. Déposer les morceaux de poulet cuits, ainsi que l''oignon, le poivron, les tranches de bananes et les arachides. Ajouter de la coriandre fraîche hachée (au goût). Saler et poivrer. Parsemer la pizza avec le fromage râpé.', 'Cuire au four à peu près une douzaine de minutes, jusqu''à ce que ce soit doré. Sortir du four et ajouter de la coriandre fraîche. ', 'Bon appétit!'], ['Rouleau à pâtisserie', 'Fouet', 'Pince de cuisine', 'Couteau de chef', 'Spatule'], ['pâte de curry', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'pizza', 'plat', 'escalope de poulet', 'recette', 'cuisine', 'arachide', 'poivron rouge', 'recettes', 'pâte à pizza', 'oignon', 'boisson', 'Pizza africaine', 'dessert', 'cheddar', 'plat de résistance', 'moyen', 'coriandre', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:23:43.581785', [{'ingredient_id': 'f0008d4c-be9f-4dd2-be1d-103fe89515a5', 'quantite': '1'}, {'ingredient_id': 'a3e5984f-9116-4e0e-bef4-82d15eb80400', 'quantite': '1'}, {'ingredient_id': '2145195f-c9b0-4dee-a982-da010045afc1', 'quantite': ''}, {'ingredient_id': '38a2b432-200c-4133-9f3e-36f99030db94', 'quantite': '2'}, {'ingredient_id': '495c8e5e-936d-4aa3-8928-43a2b25d0d93', 'quantite': '1'}, {'ingredient_id': '56d76223-e59e-4043-a50d-3604d55a0955', 'quantite': '1'}, {'ingredient_id': '8a9db91d-1d60-4898-8afe-43bf3b24d6d4', 'quantite': '1'}, {'ingredient_id': '7da6ef8a-dc2f-4bd2-ae76-42794dc30706', 'quantite': ''}, {'ingredient_id': '652d721a-bd91-4af4-953a-a7743a859a7a', 'quantite': '1'}, {'ingredient_id': '90be58d9-e567-401a-b349-9f0b3dc9121c', 'quantite': ''}, {'ingredient_id': 'f6e7e6ea-22ff-4221-9b95-0537f7065b77', 'quantite': ''}, {'ingredient_id': 'f182a578-631f-4214-8570-c17e98c74da7', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (314805, 'Roulés Morel feuilletés à la banane', 'banane, sucre semoule, pâte feuilletée, jaune d''oeuf', '75 min', ['Sortez le sucre, une fourchette, un bol et la banane. Écrasez la banane jusqu''à obtention d''une pâte non-homogène. Verser 2/3 de sucre dans ce même récipient et mélangez... reprenez votre pâte. Versez de façon homogène la banane, laissez un rayon de 4 ou 5 cm tout autour de la pâte, afin d''éviter tout débordement. ', 'Roulez un côté jusqu''à la moitié, et l''autre également; jusqu''à former un "parchemin".', 'Placer ce résultat emballé, 1 h ou + dans le congélateur.', 'Ce temps écoulé, sortez le "parchemin" du froid et disposez-le sur le plan de travail, et déballez-le...', 'Coupez des lamelles de 2 cm de façon régulière. Le bout des côtés serviront de test pour la cuisson normalement parfaite. Placez les lamelles sur une plaque recouverte de papier cuisson.', 'Disposez-les par écart de 5 cm  et recouvrez-les du jaune d’œuf. Saupoudrez avec le sucre restant.', 'Enfournez à 200°C (thermostat 6 ou 7) pendant 10 à 15 min.', 'Servez chaud ou froid. Servez accompagné d''un chocolat chaud en hiver ou d''un jus de fruit en été ! Voila pour cette recette...', 'A très bientôt.'], ['Économe', 'Presse-agrumes', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'Roulés Morel feuilletés à la banane', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:23:47.172802', [{'ingredient_id': '406a61e7-4e44-4b1c-b7b7-22303b132cb7', 'quantite': '1'}, {'ingredient_id': '76a5b65a-4207-48f6-85ae-8d3e4a3ea1db', 'quantite': '60 g'}, {'ingredient_id': '12d43be5-7690-400b-b22a-6583f3e3cd37', 'quantite': '1'}, {'ingredient_id': '2583fb79-f081-4df3-b1da-256e49b78755', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42840, 'Muffins bananes et noix', 'farine complète, beurre tendre, levure chimique, oeuf, sucre, banane, cerneau de noix, lait entier, quatre-épices', '10 min', ['Préchauffez le four à thermostat 6 (180°C).', 'Couper les bananes en petits quartiers. ', 'Les faire dorer dans 20 g de beurre. Saupoudrer ensuite de sucre. Et mettre de côté.', 'Mélanger le reste du beurre avec le sucre, jusqu''à ce que le mélange devienne homogène.', 'Rajouter les oeufs et le lait.', 'Mélanger la farine avec la levure, la tamiser pour que ce soit bien homogène. ', 'Incorporer la farine dans le mélange. ', 'Ajouter les épices, les noix coupées ou entières, et finalement les bananes. Mélanger mais sans trop travailler la pâte.', 'Mettre dans un moule à muffins... Si c''est un moule rigide, le graisser d''abord, mais s''il s''agit d''un moule en silicone, verser le mélange directement.', 'Enfourner à thermostat 6 (180°C), pendant 30 min.', 'Une fois cuits, les muffins doivent être retirés du moule tout de suite, et mis à refroidir sur une plaque.', 'Bon appétit!'], ['Tire-bouchon', 'Planche à découper', 'Mixeur', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'cerneau de noix', 'confiserie', 'testées', 'beurre tendre', 'levure chimique', 'très facile', 'bon marché', 'lait entier', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Muffins bananes et noix', 'dessert', 'plat de résistance', 'muffin', 'farine complète', 'quatre-épices', 'sucre', 'cocktail'], 'Dessert', a11c19c0-8e5f-4ec6-a45f-a1159a59d7f9, '2025-09-26T16:23:50.696980', [{'ingredient_id': 'b2786d3c-1e7a-4d4e-bef4-5f67f2d1227b', 'quantite': '220 g'}, {'ingredient_id': 'ad03af08-38ca-4944-a954-69bdd9e6624e', 'quantite': '120 g'}, {'ingredient_id': '60d0bf43-4a78-485f-a41c-94cb26f3671f', 'quantite': '1'}, {'ingredient_id': 'a93998f2-418c-4238-a8ad-5e22c5f2a833', 'quantite': '2'}, {'ingredient_id': 'cc295549-a1b7-47bc-af26-4b358e899491', 'quantite': '130 g'}, {'ingredient_id': 'da976822-7051-4edf-b462-190ff93880ba', 'quantite': '3'}, {'ingredient_id': '734d35fa-d093-4919-8d6a-5cad89b99565', 'quantite': '100 g'}, {'ingredient_id': '37f52d47-3065-4d60-b493-05ba71e209f4', 'quantite': '200 ml'}, {'ingredient_id': '03d6d4a4-5e8f-4baa-bfa6-f10e6d842ce6', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (175117, 'Bananes et clémentines aux épices', 'banane, pamplemousse, jus de citron, cannelle, gingembre, genièvre, sucre roux, clémentine, beurre', '15 min', ['Faire fondre le beurre dans une poêle et y mettre les bananes entières.', 'Ajouter les jus de pamplemousse, le jus de citron et les épices. ', 'Saupoudrer de sucre roux et laisser cuire quelques minutes pour dorer les bananes. ', 'Faire réduire le jus et ajouter les clémentines préalablement épluchées pour les tiédir. Laisser environ 5 min et retirer du feu.'], ['Batteur électrique', 'Planche à découper'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'Bananes et clémentines aux épices', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'clémentine', 'dessert', 'plat de résistance', 'pamplemousse', 'jus de citron', 'beurre', 'genièvre', 'cannelle', 'cocktail', 'sucre roux'], 'Dessert', 142db3e1-3a2e-4d33-89ba-d53869e5a9eb, '2025-09-26T16:23:55.293462', [{'ingredient_id': '0022f9dc-7c95-419f-8b2e-d2050032c9e4', 'quantite': '4'}, {'ingredient_id': '05c25bf3-5093-4555-a495-24de189a2013', 'quantite': '1'}, {'ingredient_id': '7475bc91-fc6a-4bfd-8be6-a757a8d21c6e', 'quantite': ''}, {'ingredient_id': '19e2a64f-a3cb-4a34-8552-cb590f15adb2', 'quantite': ''}, {'ingredient_id': '90fe7716-8094-4318-8ab6-f965aa824f66', 'quantite': ''}, {'ingredient_id': '6b1ed1d3-7f73-4079-bbdc-2daa3b6e5333', 'quantite': '6'}, {'ingredient_id': '2d671a14-01b2-442a-a7c2-b26efd37e437', 'quantite': ''}, {'ingredient_id': '2d63d6ad-cd00-4efa-af03-3783ca88de93', 'quantite': '4'}, {'ingredient_id': '501b56cf-7235-4e50-a581-b6a6a98fafa0', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315153, 'Banane poêlé au gingembre et noix de coco', 'banane, noix de coco, beurre', '0 min', ['Coupez les bananes en deux dans le sens de la longueur.', 'Faites chauffer une poêle à feu moyen. ', 'Faites revenir les bananes dans le beurre ou l''huile puis rapper du gingembre et saupoudrez de noix de coco en poudre.  ', 'Attendez que les bananes caramélisent un peu puis vous arrêtez la cuisson. Bonne dégustation'], ['Balance de cuisine', 'Presse-agrumes', 'Couteau de chef', 'Mixeur', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Banane poêlé au gingembre et noix de coco', 'dessert', 'plat de résistance', 'beurre', 'noix de coco', 'cocktail'], 'Dessert', f026b5bd-5678-472b-9528-37e88ee0f778, '2025-09-26T16:24:00.054888', [{'ingredient_id': '6b238d71-d001-4572-b08c-4a6dfef1fac9', 'quantite': '4'}, {'ingredient_id': 'ef782956-ec18-416b-adc6-e713d06363b4', 'quantite': '10 g'}, {'ingredient_id': '5051a643-b97e-4e52-90e3-ef7967d5f4f6', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21606, 'Milk shake à la banane', 'banane, glace vanille, lait', '10 min', ['Coupez les bananes en morceau et versez-les dans un pot gradué. Ajoutez la boule vanille et le lait. Mixez pour obtenir une pâte liquide et homogène. Voilà votre milk shake!'], ['Batteur électrique', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'Milk shake à la banane', 'plat de résistance', 'lait', 'cocktail'], 'Boisson', 6b930a67-4e4b-4896-ad24-c5b3eaa7ca93, '2025-09-26T16:24:05.803083', [{'ingredient_id': '02eb7275-803b-43dd-a6ff-43b9fb83007c', 'quantite': '3'}, {'ingredient_id': '30a99e06-86f3-4e74-af71-19647de49760', 'quantite': '1'}, {'ingredient_id': '541afc53-2478-4f4a-a2c4-bf8ab7d1cea4', 'quantite': '500 ml'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68611, 'milk-shake banane-kiwi', 'banane, yaourt nature, kiwi, glaçons, crème liquide', '10 min', ['Couper les bananes et le kiwi grossièrement et les mettre dans le mixer.', 'Y ajouter le yaourt, la crème et les glaçons. Mixer le tout.', 'Verser dans un grand verre avec une paille et déguster !'], ['Couteau de chef', 'Mixeur', 'Louche'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'milk-shake banane-kiwi', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'glaçons', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:24:10.634497', [{'ingredient_id': '58245479-3f20-45be-bec4-be1f3009553c', 'quantite': '4'}, {'ingredient_id': 'e5be26bb-7c1a-4813-af8c-4f73a87f023d', 'quantite': '1'}, {'ingredient_id': 'd8c0d979-1ff7-4adc-b0b3-90264f9a53e7', 'quantite': '1'}, {'ingredient_id': 'bcfa4e6d-ac02-43b6-b1ab-3e82f6b9463d', 'quantite': '4'}, {'ingredient_id': 'abf087b0-658d-4773-b0ce-b11e9aefb8c5', 'quantite': '5 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40692, 'Crumble rhubarbe et bananes', 'caramel, rhubarbe, banane, sucre roux, farine, beurre tendre', '20 min', ['Préchauffez le four à 200°C (Thermostat 7).', 'Lavez, épluchez, et coupez la rhubarbe en tronçons. ', 'Epluchez, et coupez les bananes en rondelles.', 'Avec un pinceau, répartissez le caramel sur le fond d''un plat.', 'Ajoutez par dessus, les fruits mélangés.', 'Mélangez le beurre, la farine, le sucre pour former des miettes.', 'Recouvrez-en les fruits.', 'Enfournez pendant 40 min, et passez légèrement au grill, juste avant de servir.'], ['Moule à tarte', 'Presse-agrumes', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'beurre tendre', 'très facile', 'rhubarbe', 'caramel', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'Crumble rhubarbe et bananes', 'autres crumbles', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:24:14.184972', [{'ingredient_id': '658a76e7-4f4d-4b4a-89ab-db6e2ae307cb', 'quantite': ''}, {'ingredient_id': '5cccd733-bdc2-473d-bcb0-6ca1d7946425', 'quantite': '9'}, {'ingredient_id': '6af2a0bb-74e8-45ec-891d-bee193eb866d', 'quantite': '3'}, {'ingredient_id': '767b50e7-d929-4dff-82a5-b1e105ff3438', 'quantite': '60 g'}, {'ingredient_id': '8d2226c4-ffc1-42ae-b177-20a8ad82c259', 'quantite': '120 g'}, {'ingredient_id': '79be8304-a1f0-4acc-856d-e4da81689704', 'quantite': '120 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (39412, 'Lentilles au curry avec des bananes', 'oignon, pomme, ail, curry, lentilles, bouillon de légumes, sel, poivre, coriandre, crème fraîche, banane, beurre, riz', '50 min', ['Faire cuire les oignons dans une grande poêle, avec un peu d''huile bien chaude.', 'Couper les pommes en petits morceaux et écraser l''ail.', 'Ajouter les morceaux de pommes, l''ail et le curry aux oignons. Faire cuire environ 5 minutes avant d''y ajouter le bouillon de légume, puis les lentilles.', 'Laisser le tout mijoter, jusqu''à ce que le bouillon soit absorbé par les lentilles (15-20 min.)', 'Saler, poivrer, et ajouter la coriandre.', 'Mélanger à de la crème fraiche (quantité selon votre goût)', 'Eplucher les bananes et les faire "griller" dans du beurre chaud, jusqu''à ce qu''elles deviennent dorées et les disposer sur les lentilles au curry.', 'Servir avec du riz.'], ['Passoire', 'Tire-bouchon', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'lentilles', 'facile', 'bon marché', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'Lentilles au curry avec des bananes', 'dessert', 'plat de résistance', 'riz', 'pomme', 'beurre', 'coriandre', 'poivre', 'curry', 'bouillon de légumes', 'viande à l''indienne', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:24:18.823252', [{'ingredient_id': 'b80ad96f-2e39-476d-b29a-5757e9729b28', 'quantite': '3'}, {'ingredient_id': '7db53cac-b8dc-4099-a955-a2eb5d506011', 'quantite': '2'}, {'ingredient_id': '62cd1484-9c32-4e27-8763-a979c168d331', 'quantite': '3'}, {'ingredient_id': 'aea440ed-cf1a-49bc-8832-1fd2dba01db8', 'quantite': '1 cuillères'}, {'ingredient_id': '15ea88e1-3242-4acf-940d-eb8233f02a3b', 'quantite': '200 g'}, {'ingredient_id': 'b7bba2e9-540b-4023-a693-b96eca518f5f', 'quantite': '50 cl'}, {'ingredient_id': 'fdc0bbe1-5984-4dfa-9d9d-8c77688d97df', 'quantite': ''}, {'ingredient_id': 'e4ffdd3d-e956-4c94-9a59-289ccade2be8', 'quantite': ''}, {'ingredient_id': 'd8902bc4-08f7-4aa5-8765-d547de71fe85', 'quantite': '1'}, {'ingredient_id': '337361ea-3533-4a73-b79f-a7ed1e37ac97', 'quantite': ''}, {'ingredient_id': '01e5e230-8e25-4630-9f03-70539b2f9728', 'quantite': '4'}, {'ingredient_id': 'f496380b-b02b-41c0-be51-338b44d0060b', 'quantite': '30 g'}, {'ingredient_id': '3f38cbb0-8a3e-4c26-aeee-4f0a84fdee62', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (83879, 'Tarte pate à tartiner - banane', 'pâte sablée, crème liquide, oeuf, pâte à tartiner, banane', '15 min', ['Préchauffez le four à 200°C(thermostat 6/7).', 'Mélangez les oeufs, le Nutella et la crème liquide.', 'Étalez la pâte sablée dans un moule à tarte et versez-y la préparation.', 'Pelez et coupez la banane en fines tranches. Disposez-la sur la tarte.', 'Enfournez et laissez cuire 30 minutes.'], ['Couteau de chef', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'recette', 'Tarte pate à tartiner - banane', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'cocktail', 'pâte à tartiner'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:24:22.884576', [{'ingredient_id': '3e0d711a-8b93-4960-9502-e20643139be4', 'quantite': '1'}, {'ingredient_id': 'ade7781c-0992-4583-8b6e-930c43714492', 'quantite': '20 cl'}, {'ingredient_id': '43ecae1b-ae91-42ca-85f3-498e32a15ec0', 'quantite': '3'}, {'ingredient_id': '3bc1c2d3-6e9d-4eaf-8e5f-50245ddfb46a', 'quantite': '8 cuillères'}, {'ingredient_id': '520fae52-88e0-42f5-a1dc-4c66c3a88028', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (45076, 'Milkshake banane et baileys', 'banane, Bailey''s, glace vanille, glace pilée', '5 min', ['Couper la banane en morceaux puis mixer le tout dans un mixer.', 'Et voilà, tout frais, tout bon.'], ['Tire-bouchon', 'Mixeur', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'moyen', 'Milkshake banane et baileys', 'Bailey''s', 'cocktail', 'glace pilée'], 'Boisson', 1b105525-d3b3-4175-b686-fd1c793dd439, '2025-09-26T16:24:26.419064', [{'ingredient_id': 'ad0acb4e-0765-4e95-a3d2-504978b4844b', 'quantite': '1'}, {'ingredient_id': '5da90748-ae97-4fd5-bc62-160ca5f0c0fb', 'quantite': '5 cl'}, {'ingredient_id': 'a0c1c279-7c71-436d-9bbe-ed925d350075', 'quantite': '2'}, {'ingredient_id': 'b6214416-222a-4f4b-a20f-3562eff5e5dc', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14679, 'Pomme de terre au four', 'pomme de terre', '10 min', ['Préchauffer le four à 180°C / Ther 6.', 'Eplucher les pommes de terre, ou laisser la peau si elle est fine.', 'Les couper dans le sens de la longueur et les placer sur une plaque au four, face bombée contre la plaque. Saler et laisser cuire à four chaud jusqu''à ce que le dessus soit bien doré.', 'Servir chaud accompagnées de salade verte et de toutes sortes de fromages (du kiri pour les enfants en allant jusqu''au maroilles...).', 'C''est délicieux, économique et sans graisse. Délicieux avec de la cancoillotte !'], ['Économe', 'Moule à tarte', 'Passoire', 'Presse-agrumes'], ['boisson', 'bon marché', 'recettes', 'entrée', 'Pomme de terre au four', 'recettes de cuisine', 'plat', 'dessert', 'confiserie', 'pomme de terre', 'recette', 'testées', 'plat de résistance', 'cocktail', 'cuisine', 'très facile', 'pommes au four'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:24:32.889249', [{'ingredient_id': '120c1da2-449d-4300-9c6c-26f1a75c2beb', 'quantite': '500 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52321, 'Pancakes aux pommes ou à la banane', 'farine, sucre, lait, oeuf, sucre vanillé, pomme', '20 min', ['Couper la pomme ou la banane en rondelles de 0,5 cm d''épaisseur.', 'Mélanger les œufs et le sucre jusqu''à ce que le mélange blanchisse puis rajouter la farine en pluie, le sucre vanillé et le fruit. Mélanger doucement.', 'Commencer à faire cuire les pancakes dans une petite poêle, les uns après les autres en versant une petite louche de pâte dans la poêle chaude.'], ['Presse-agrumes', 'Rouleau à pâtisserie', 'Poêle', 'Balance de cuisine', 'Ouvre-boîte'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'pancake', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'Pancakes aux pommes ou à la banane', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:24:36.539995', [{'ingredient_id': '93e4a356-745e-44e7-b3a2-260f358044bf', 'quantite': '150 g'}, {'ingredient_id': 'c7b4d387-75e7-4ff2-8c15-57d5e67368f7', 'quantite': '25 g'}, {'ingredient_id': '67721ffb-1364-4e4b-be8e-61e2ff21d6cf', 'quantite': '25 cl'}, {'ingredient_id': '30f37114-902b-4324-8d09-845757bbdbf1', 'quantite': '3'}, {'ingredient_id': 'e21035ad-c1fc-4b85-b4d7-4349c29f5917', 'quantite': ''}, {'ingredient_id': '7ff5c1a6-051c-4a9f-b256-c51816469223', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (41915, 'Tarte crumble pommes-bananes-raisin', 'pâte brisée, pomme, banane, raisin, beurre, cassonade, farine, jus de citron', '45 min', ['1 heure avant la cuisson : ', 'Mélanger la farine et la cassonade. ', 'Ajouter le beurre en morceaux, et mélanger jusqu''à obtenir une texture sablée. ', 'Former une boule, et la mettre au réfrigérateur pendant au moins 1heure (c''est pour que la pâte à crumble se défasse en petits morceaux).', 'Préchauffer le four à 180°C (thermostat 6). ', 'Etalez la pâte dans un moule à tarte, et la faire cuire à blanc avec une couche de papier sulfurisé, et des légumes secs, pendant 15 minutes.', 'Pendant ce temps, éplucher, épépiner, et couper les pommes en dés, et les citronner. ', 'Les faire revenir dans du beurre à feu moyen, pendant 10-15 min, en les saupoudrant de cassonade (2 cuillères à soupe), à mi-cuisson. ', 'Mettre les pommes dans le fond de tarte, couper les bananes en tronçons, et déposer les grains de raisin. ', 'Ensuite, émietter la pâte à crumble sur le dessus de la tarte, tasser, et enfourner pendant 35 min.'], ['Louche', 'Presse-agrumes'], ['raisin', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'facile', 'bon marché', 'plat', 'tarte aux pommes', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'Tarte crumble pommes-bananes-raisin', 'farine', 'dessert', 'plat de résistance', 'pomme', 'jus de citron', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:24:40.273171', [{'ingredient_id': '335a5811-076f-4443-a2df-c4966ecf116a', 'quantite': '1'}, {'ingredient_id': 'da3fa3d0-2e0c-4ce7-85ed-923e2a6c38ab', 'quantite': '4'}, {'ingredient_id': '2d4e4c39-66b8-4839-a158-747e51300485', 'quantite': '2'}, {'ingredient_id': 'b76a51a4-2964-4d7e-9231-b089368730f5', 'quantite': ''}, {'ingredient_id': '0f9b10c5-e04c-4a72-871e-cdf5cc9704ec', 'quantite': '75 g'}, {'ingredient_id': 'db0e65ab-0939-47dd-90e9-710936eb8bb0', 'quantite': '100 g'}, {'ingredient_id': '4bf7da5a-533d-405c-b3ff-788076c5e5c9', 'quantite': '100 g'}, {'ingredient_id': '40b933c4-a055-48bb-b87e-74c0d733272c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (89392, 'Crumble pomme, banane et chocolat', 'pomme, banane, citron, chocolat, farine, sucre, beurre tendre, lait', '20 min', ['Eplucher les bananes et les pommes. Presser le citron. Dans un saladier, couper les bananes en rondelles et les pommes en dés, les arroser de jus de citron (ou de rhum) et mélanger. Mettre les fruits dans des ramequins ou des verres et réserver au frais.', 'Préchauffer le four à 180°C (thermostat 6). Mélanger la farine, le beurre et le sucre dans un saladier. Malaxer la préparation du bout des doigts jusqu''à ce que la consistance devienne sableuse. Répartir la pâte dans un plat à tarte. Mettre au four 10 minutes à 180°C (thermostat 6)jusqu''à ce que la préparation brunisse.', 'Au dernier moment, cassez le chocolat en morceaux dans une casserole avec 1 cuillère à soupe de lait et faites le fondre à feu doux jusqu''à obtention d''une crème lisse.', 'Verser le chocolat chaud sur les fruits et les saupoudrer de pâte à crumble. ', 'Servir aussitôt.'], ['Spatule', 'Presse-agrumes', 'Planche à découper', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'beurre tendre', 'chocolat', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Crumble pomme', 'farine', 'dessert', 'plat de résistance', 'pomme', 'citron', 'sucre', 'lait', 'banane et chocolat', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:24:43.878403', [{'ingredient_id': 'd3100e29-81e5-4d3f-96f8-7811ec519d92', 'quantite': '3'}, {'ingredient_id': 'a5394a36-b30b-4b99-9561-ba86681e6b05', 'quantite': '3'}, {'ingredient_id': '1ebaf1fd-c1ab-416b-90c0-a2df4ccbc123', 'quantite': '1'}, {'ingredient_id': 'ac70255a-230c-41c9-a7ae-d8b4108db98a', 'quantite': '100 g'}, {'ingredient_id': '81c62b47-49be-4246-8949-b3281f11852e', 'quantite': '75 g'}, {'ingredient_id': '7f42add9-b07f-491f-9412-ec424dd4d52b', 'quantite': '30 g'}, {'ingredient_id': 'e9ca713b-2bc2-473f-9cd8-3a2306edc210', 'quantite': '40 g'}, {'ingredient_id': 'eedce26a-356e-4d84-a747-5425605644eb', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (60670, 'Salade de fruits exotiques aux fraises', 'banane, fraises, kiwi, ananas, jus de citron', '15 min', ['Vider la boîte d''ananas et son sirop dans un grand saladier.', 'Couper les bananes, les kiwis et les fraises en rondelles.', 'Tout mélanger dans le saladier.', 'Rajouter le jus de citron pour éviter que les bananes noircissent.'], ['Couteau de chef', 'Poêle', 'Verre doseur', 'Planche à découper'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'Salade de fruits exotiques aux fraises', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'ananas', 'salade de fruits exotiques', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:24:47.480873', [{'ingredient_id': 'c34c38f8-73da-432b-8afb-4a15f9ebf801', 'quantite': '2'}, {'ingredient_id': '6cf1e22d-16d7-4d88-9d87-c6f04f370a8a', 'quantite': '30'}, {'ingredient_id': '0b9597a1-099a-4d00-ba86-0641c04690f7', 'quantite': '4'}, {'ingredient_id': '2fd21da8-f2b0-4e1a-aa13-f7e271a7ed84', 'quantite': '1'}, {'ingredient_id': '5cff5414-2511-4703-9f17-84d9b772a11d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345352, 'Rainbow smoothie', 'banane, banane, yaourt, framboises, fraises, banane, yaourt, gelée, orange, gelée, banane, yaourt, ananas, yaourt, mâche, ananas, banane, yaourt, cassis, banane, yaourt, betterave, framboises', '40 min', ['Pour chaque smoothie : ', 'Placer tous les ingrédients dans un blender et mélanger jusqu''à l''obtention d''une consistance lisse. Ajouter de l''eau (ou du lait) si le mélange est trop épais.', 'Transférer le smoothie dans un bol ou un récipient, rincer le blender et préparer la prochaine couche.', 'Réalisation du rainbow smoothie :', 'Verser délicatement les couches les unes après les autres.', 'Décorer les verres avec une brochette de fruits restants.'], ['Couteau de chef', 'Presse-agrumes', 'Moule à tarte', 'Rouleau à pâtisserie', 'Spatule'], ['boisson', 'bon marché', 'entrée', 'banane', 'rapide', 'recettes de cuisine', 'plat', 'Rainbow smoothie', 'dessert', 'confiserie', 'smoothies', 'recette', 'testées', 'plat de résistance', 'cocktail', 'cuisine', 'recettes', 'facile'], 'Boisson', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:24:51.559510', [{'ingredient_id': '76370d3c-7f37-4508-af64-2403af3cfc7f', 'quantite': '2'}, {'ingredient_id': '2da573b5-9888-44f0-892f-a102a3bbe4f9', 'quantite': '1'}, {'ingredient_id': 'ef52515f-0280-4418-8ef0-ba19b542243d', 'quantite': '2.5 cuillères'}, {'ingredient_id': '4d365bd4-4dcc-4cc6-935e-a733b6911955', 'quantite': '120 g'}, {'ingredient_id': '63ca147b-a919-429b-b5fb-2eed5f176d35', 'quantite': '40 g'}, {'ingredient_id': 'e045a3d4-26c9-4529-9e2b-a0f8be80ab89', 'quantite': '1'}, {'ingredient_id': '9668fb71-a4ea-44a7-89a1-bde23b1e2861', 'quantite': '2.5 cuillères'}, {'ingredient_id': '6547963a-e2ec-4174-b8a5-3db9f127858e', 'quantite': '2 cuillères'}, {'ingredient_id': 'a8a87441-6588-4c5b-bbd7-7cef120b1e4b', 'quantite': '1'}, {'ingredient_id': '49a3b887-ba6a-4663-b6bf-f8ed00baa50a', 'quantite': '1 cuillères'}, {'ingredient_id': 'b20ae7b3-e65a-4b10-827d-3fef86b47838', 'quantite': '2'}, {'ingredient_id': 'a5312f1f-c1d2-4239-8730-d464ecf76999', 'quantite': '2.5 cuillères'}, {'ingredient_id': 'a9ac1ec4-4bc1-43fe-b333-6af68bf20881', 'quantite': '40 g'}, {'ingredient_id': '95b159de-38bb-44b2-9fac-f46b8439be1f', 'quantite': ''}, {'ingredient_id': '4e7d8c03-923a-4a4b-abeb-b5d2236803b9', 'quantite': '1'}, {'ingredient_id': '2d4f3da8-be4e-4019-b087-8bad5ec23707', 'quantite': '80 g'}, {'ingredient_id': '45a8936b-aa3a-4017-bc03-2a31d931c528', 'quantite': '1'}, {'ingredient_id': 'd06bfbc1-a674-4f18-abcb-594a03281239', 'quantite': '2.5 cuillères'}, {'ingredient_id': 'ae69e183-e4c0-4ce6-a31c-28deaa2ce134', 'quantite': '120 g'}, {'ingredient_id': 'b14561b7-f0dc-4ad6-95f1-2fe90951dcbc', 'quantite': '1'}, {'ingredient_id': 'c49a7871-6de4-4fcc-b3f2-fa2d89cff349', 'quantite': '2.5 cuillères'}, {'ingredient_id': '4ea06589-99cb-4f37-aaa2-645a2c955c40', 'quantite': '2'}, {'ingredient_id': 'a306ef9d-c075-40da-82bc-876c4afe565a', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530772, 'Pirarucu en feuille de bananier, banane grillée au Churrasco, condiment cacahuète au lait de coco et citron vert', 'feuille de bananier, pirarucu, tomate, poivron jaune, oignon jaune, ail, olives vertes, petits pois, piment vert, gingembre, paprika, coriandre, banane, épices, lait de coco, citron vert, cacahuètes', '60 min', ['Pirarucu en feuille de bananier :
La veille, dessaler 24h au réfrigérateur le Pirarucu, tailler en petits morceaux dans un grand saladier d’eau froide. Veiller à changer l’eau 3 à 4 fois.', 'Le jour J, égoutter le poisson et le mettre dans une grande casserole d’eau froide à chauffer. Il ne faut pas faire bouillir l’eau. Garder en cuisson 5 min à partir du moment où l’eau est presque à ébullition.', 'Égoutter le poisson, retirer la peau et les arrêtes et émietter avec les mains. Garder de côté.', 'Laver les feuilles de bananier et laisser tremper 5 min dans un saladier rempli d’eau. Cela va permettre de les ramollir et qu’elles ne brulent pas au barbecue.', 'Tailler 8 carrés de 25cm dans les feuilles. Réserver avec un linge humide dessus.', 'Laver les tomates, les poivrons et le piment.', 'Déposer directement les poivrons sur les braises du barbecue. Veiller à faire bruler la peau sur toute la surface. Débarrasser ensuite dans un plat avec un couvercle hermétique. Laisser 10min refroidir. Ensuite ouvrir le couvercle et enlever délicatement la peau des poivrons. Enlever les pépins. Puis tailler en fine lamelles.', 'Émincer finement les oignons, le piment vert et l’ail.', 'Concasser en petits cubes les tomates.', 'Tailler en rondelles les olives vertes.', 'Mettre à chauffer un wok directement dans les braises du barbecue.', 'Ajouter un peu d’huile d’olive et faire suer quelques minutes les oignons, il faut qu’ils deviennent translucides.', 'Ajouter l’ail, le piment, le paprika, le gingembre et faire suer de nouveau.', 'Ajouter ensuite le poisson émietté, les tomates, les poivrons.', 'Laisser compoter 5min et retirer le wok des braises.', 'Ajouter les petits pois et les olives, mélanger et rectifier l’assaisonnement.', 'Sur le poste de travail superposer deux feuilles de bananier l’une sur l’autre. Faire quatre tas.', 'Répartir la préparation du wok au centre des quatre tas de feuilles. Replier chaque côté des carrés et piquer le haut avec des cures dents pour les fermer hermétiquement.', 'Réserver de côté.', 'Laver la coriandre puis équeuter. Mettre de côté pour le dressage.', 'Banane grillée au Churrasco Brésilien :
Tailler les bananes dans la longueur en gardant la peau et mettre dans un plat côté chair en haut. Saupoudrer avec les épices Churrasco et mettre de côté.', 'Condiment cacahuète au lait de coco et citron vert :
Mettre les cacahuètes dans une barquette en aluminium. Déposer directement la barquette sur les braises. Faire griller les cacahuètes en remuant régulièrement puis garder de côté.', 'Mettre à chauffer le lait de coco dans une petite casserole puis ajouter la moitié des cacahuètes. Faire bouillir 2 à 3 min.', 'Mixer finement la sauce puis faire réduire pour qu’elle soit bien nappante.', 'Ajouter le jus du citron vert, saler, poivrer et réserver au chaud pour le dressage.', 'Cuisson et dressage :
Cuire 10 min le poisson en feuilles de bananier sur la grille du barbecue.', 'Faire griller les bananes 2 min côté chair puis retourner sur la peau et poursuivre la cuisson 5 min. La peau se détache de la chair quand elles sont bien cuites.', 'Dans une assiette en bambou déposer le poisson en feuille de bananier. Enlever les cures dents et laisser apparaître l’intérieur.', 'Ajouter 2 belles cuillères de sauce aux cacahuètes sur le poisson.', 'Déposer sur le côté deux demi-bananes et les croisant.
Finir par quelques feuilles de coriandre fraiches et le reste de cacahuètes grillées.'], ['Passoire', 'Pince de cuisine', 'Casserole', 'Mixeur', 'Moule à tarte'], ['oignon jaune', 'gingembre', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'assez cher', 'pirarucu', 'condiment cacahuète au lait de coco et citron vert', 'tomate', 'ail', 'paprika', 'olives vertes', 'plat', 'moyenne', 'feuille de bananier', 'recette', 'cuisine', 'recettes', 'boisson', 'poisson', 'dessert', 'petits pois', 'plat de résistance', 'banane grillée au Churrasco', 'piment vert', 'coriandre', 'Pirarucu en feuille de bananier', 'poivron jaune', 'cocktail'], 'Plat principal', 8d8894b6-82dd-4a61-837b-530f31adc50b, '2025-09-26T16:24:56.612460', [{'ingredient_id': '6a6999cc-460c-434c-af8a-113cc6d6ea97', 'quantite': '4'}, {'ingredient_id': 'd2284548-5c34-405f-9edd-e85a59eb6ccd', 'quantite': '500 g'}, {'ingredient_id': 'aecaf745-3300-4c6b-aad5-0f9657291c51', 'quantite': '4'}, {'ingredient_id': '419da275-c935-484a-b531-3a5148532595', 'quantite': '2'}, {'ingredient_id': 'eb81d4d0-3705-4188-9eb7-f1b438491c2b', 'quantite': '2'}, {'ingredient_id': '9e5e1645-cb50-4c39-ab81-6e9179bc0f84', 'quantite': '1 g'}, {'ingredient_id': 'cdf12e7f-673d-486c-aaa0-a6644d6a1d6a', 'quantite': '50 g'}, {'ingredient_id': '48d14152-7c8b-4fe1-8fca-abc649a058d1', 'quantite': '300 g'}, {'ingredient_id': '0872323a-ca79-4a42-b0e8-2fdc67d9f39d', 'quantite': '1'}, {'ingredient_id': 'f9e113d3-882a-451d-86d2-b605faaf834a', 'quantite': '1 cuillères'}, {'ingredient_id': 'e4d4cc35-a121-49fb-9680-77c67717a710', 'quantite': '1 cuillères'}, {'ingredient_id': '9b773e3e-127e-4df7-8a02-04a3210ccb86', 'quantite': '4'}, {'ingredient_id': 'ae962735-3eb8-461d-a376-e54753ecdc0e', 'quantite': '4'}, {'ingredient_id': '8f02142d-3e19-4318-a21b-d139fa20873a', 'quantite': '1 cuillères'}, {'ingredient_id': 'e1970472-02ea-4d54-a45c-e927d7fa4a95', 'quantite': '20 cl'}, {'ingredient_id': 'e1ea3733-e6d9-4672-8e12-1980a9a33d28', 'quantite': '1'}, {'ingredient_id': '70ddea3d-8a5e-4552-9939-2f804e9a3455', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16499, 'Cake aux bananes', 'banane, farine, sucre en poudre, beurre, oeuf, sucre vanillé, levure chimique, citron, beurre', '30 min', ['Beurrez un moule à cake avec un peu de beurre. Préchauffez le four à 180°C (thermostat 6). Râpez le zeste de citron, puis pressez-le pour en extraire le jus. Ecrasez ensuite le beurre avec une fourchette, puis ajoutez-lui au fur et à mesure, le sucre, le sucre vanillé, le zeste du citron et les oeufs battus en omelette.', 'Pelez les bananes, coupez-les en petites rondelles, et arrosez-les du jus du citron, puis écrasez-les à la fourchette. ', 'Ajoutez la purée ainsi obtenue à la préparation aux oeufs, puis la farine et la levure; vous devez obtenir une pâte bien consistante. ', 'Versez le tout dans le moule, et enfournez pendant 45 min.', 'Pour vérifier la cuisson du gâteau, piquez-le avec un couteau avant de le sortir du four : si la lame ressort bien sèche, c''est que le gâteau est cuit.', 'Laissez-le reposer 5 min dans le four éteint avant de le démouler. Dégustez-le froid.'], ['Batteur électrique', 'Tire-bouchon', 'Râpe', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'Cake aux bananes', 'facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron', 'beurre', 'cocktail'], 'Dessert', 5d051f9b-7fde-40d3-b996-a2617f11c47d, '2025-09-26T16:25:03.527753', [{'ingredient_id': '006414f9-638a-45f6-99b6-a869afce25dd', 'quantite': '3'}, {'ingredient_id': '98664a19-529b-44b5-a07a-876013bc6204', 'quantite': '200 g'}, {'ingredient_id': 'b746081f-af01-4a4e-a6c9-de4613143edf', 'quantite': '200 g'}, {'ingredient_id': 'f2fd02ca-200e-4c48-ab55-fd4f652eee13', 'quantite': '100 g'}, {'ingredient_id': '9034f5a4-5302-435b-9e73-8b68543f2395', 'quantite': '3'}, {'ingredient_id': '1a55b669-b896-48b9-b70c-ef1887087ece', 'quantite': '1'}, {'ingredient_id': 'a3226126-9bb0-49f8-9b07-4ca6d2ea448a', 'quantite': ''}, {'ingredient_id': '0edf636c-0ee3-49de-9537-9e75b4c1687a', 'quantite': '1'}, {'ingredient_id': 'c5964bcb-2432-40ad-a69d-13609ac0a0f3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (332606, 'Bonite à la balinaise', 'bonite, oignon, gingembre, piment, banane, lait de coco, safran, cannelle, sel', '90 min', ['Couper la bonite en darnes épaisses (presque 3 cm). Les saler.', 'Dans une poêle avec un peu d''huile, faire saisir les darnes à feu vif (2 min de chaque côté) le  poisson doit être saisi mais pas complètement cuit mais suffisamment pour être nettoyé facilement.', 'Nettoyer les darnes, retirer la peau, les arrêtes et les parties noires puis réserver.', 'Faire suer 1 oignon émincé avec le gingembre frais haché et les bananes coupées en morceaux et du piment frais en lamelles.', 'Ajouter les morceaux de poisson, laisser cuire à couvert 5 min à feu doux.', 'Verser le lait de coco environ 40 cl, ajouter une pointe de cannelle et le safran.', 'Ajuster l''assaisonnement, laisser mijoter 10 min.'], ['Presse-agrumes', 'Couteau de chef', 'Économe', 'Rouleau à pâtisserie', 'Mixeur'], ['gingembre', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'plats indonésiens', 'Bonite à la balinaise', 'bon marché', 'plat', 'moyenne', 'recette', 'piment', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'bonite', 'cannelle', 'cocktail', 'safran'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:25:07.182479', [{'ingredient_id': '664de4a6-ab62-4546-915a-7fbdee13612e', 'quantite': '1'}, {'ingredient_id': 'f43ff749-e766-4f4f-8488-96639cfbe3c1', 'quantite': '1'}, {'ingredient_id': '3dff2f9c-f2d5-462b-8260-4483a1628c10', 'quantite': '50 g'}, {'ingredient_id': 'c65f6872-84cf-4a8e-b5e9-19ac464ddbe4', 'quantite': '1'}, {'ingredient_id': 'f72c0fe6-88a8-44b5-b0a8-8d110ec046b1', 'quantite': '2'}, {'ingredient_id': 'f12aa940-53ee-43a0-aa32-6bca201a0390', 'quantite': '40 cl'}, {'ingredient_id': 'dd69d41b-a057-4fc5-94e1-b80935f94b3a', 'quantite': '1 g'}, {'ingredient_id': '5daa927e-fde5-482b-921a-7ad981345db8', 'quantite': ''}, {'ingredient_id': 'a337a7b2-feb0-4f57-92b0-fbde8d436faf', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12016, 'Soupe à la banane, au chou chinois et aux lentilles', 'chou chinois, banane plantain, huile, curry, lentilles vertes, crème, eau', '10 min', ['Eliminer les feuilles extérieures du chou, le couper en deux puis en fines lanières.', 'Couper les bananes en 2 longitudinalement, puis en rondelles.', 'Faire suer les lanières de chou chinois dans l''huile quelques minutes (sans rôtir).', 'Ajouter le curry, remuer et continuer à cuire 2-3 minutes. Ajouter l''eau ou le bouillon. Porter à ébullition et ajouter les bananes et les lentilles.', 'Couvrir et faire cuire 20 minutes à feu doux.', 'Au moment de servir, ajouter la crème et saler selon goût, remuer.'], ['Batteur électrique', 'Mixeur'], ['Soupe à la banane', 'entrée', 'recettes de cuisine', 'au chou chinois et aux lentilles', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'chou chinois', 'plat', 'crème', 'recette', 'cuisine', 'recettes', 'lentilles vertes', 'boisson', 'huile', 'dessert', 'plat de résistance', 'banane plantain', 'plats chinois', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:25:11.082436', [{'ingredient_id': '8663caa9-3af9-4b88-89c1-1cb25d95539a', 'quantite': '1'}, {'ingredient_id': '9d0e3a75-0251-4c6f-807b-750136ed89ea', 'quantite': '2'}, {'ingredient_id': '7d5516d1-980d-44d6-ace9-21c900a008d8', 'quantite': '1 cuillères'}, {'ingredient_id': 'd9bce8f6-df38-4bfc-8bc6-b320a293c8bd', 'quantite': '2 cuillères'}, {'ingredient_id': '1879ae71-393a-4b72-90e1-e4def851c10b', 'quantite': '150 g'}, {'ingredient_id': 'c4ed0287-8e5d-4ba8-b9fc-213a4323fccc', 'quantite': '2 cuillères'}, {'ingredient_id': '9eee399e-188c-488f-b48f-d3f92a64463f', 'quantite': '1 l'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (229581, 'Le smoothie de l''amitié', 'banane, pêche, poire, fruits rouges, eau', '5 min', ['Éplucher les fruits, les couper en petits dés. ', 'Ajouter les fruits rouges sans les décongeler, pour donner la fraîcheur. ', 'Hop dans le mixeur et le tour est joué ! ', 'Ajouter un petit peu d''eau jusqu''à la texture souhaitée, et dégustez entre amis !'], ['Couteau de chef', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'poire', 'facile', 'bon marché', 'rapide', 'Le smoothie de l''amitié', 'plat', 'fruits rouges', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pêche', 'smoothies', 'cocktail'], 'Boisson', 312e189e-4777-4854-a2e3-e6815bc86a13, '2025-09-26T16:25:16.537046', [{'ingredient_id': 'e75bebbe-a0d1-44f2-8ca5-ef8fa0633861', 'quantite': '1'}, {'ingredient_id': '975dd6b0-13fb-416d-973c-b08dafbe99c5', 'quantite': '2'}, {'ingredient_id': '7ecb3523-db66-49bd-a8dd-d0149c02313f', 'quantite': '2'}, {'ingredient_id': 'd5123dbe-2574-4af8-befe-0a69ef67dd77', 'quantite': '120 g'}, {'ingredient_id': '0eb8735c-5851-48d5-afd3-a03f9583acf8', 'quantite': '5 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31042, 'Cake Mangue Banane', 'farine, sucre, oeuf, levure chimique, huile d''olive, lait, mangue, banane, beurre, sucre', '20 min', ['Préparer les bananes en rondelles et les mangues en petits cubes. Dans une poêle, faire fondre le beurre à feu moyen, puis y jeter les fruits et le sucre. Faire caraméliser en mélangeant régulièrement. Réserver.', 'Dans une terrine, mélanger farine, sucre et levure.', 'Faire un puits dans le mélange et incorporer les oeufs. Mélanger activement, éventuellement à l''aide d''un fouet.', 'Ajouter l''huile et le lait.', 'Incorporer délicatement les fruits caramélisés.', 'Verser la préparation dans un moule à cake recouvert de papier sulfurisé et cuire au four préchauffé à 210°C pendant 45 minutes.'], ['Balance de cuisine', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'huile d''olive', 'autres cakes', 'dessert', 'Cake Mangue Banane', 'plat de résistance', 'beurre', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:25:20.206016', [{'ingredient_id': 'b2b37be5-9cc9-4a34-ab7e-663267e439c6', 'quantite': '150 g'}, {'ingredient_id': '1f9a6035-46d8-4866-965a-d7e9d49fbe7d', 'quantite': '125 g'}, {'ingredient_id': '9aa11af2-4d4a-47ae-8deb-cb9ad9364535', 'quantite': '3'}, {'ingredient_id': 'f5b9f72a-fc95-4a3e-b088-bfe53765b193', 'quantite': ''}, {'ingredient_id': 'e7ee2de8-0c96-4e8a-bccc-0f632baaa2a7', 'quantite': '10 cl'}, {'ingredient_id': '7feff12b-696d-49ed-9e43-37c8e015aa1f', 'quantite': '10 cl'}, {'ingredient_id': 'fc14ecae-b652-43fa-992c-cfc8a44061cb', 'quantite': '2'}, {'ingredient_id': '4c1f9bb1-50c5-488c-8c02-d13ee78ab157', 'quantite': '2'}, {'ingredient_id': '0850a311-c0ba-49f7-a15e-f67bb75a930a', 'quantite': '25 g'}, {'ingredient_id': 'b483ad82-102c-4ed6-9d5d-0b0de8d3241d', 'quantite': '25 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228157, 'Bread and butter pudding (à la pâte à tartiner au chocolat)', 'pain de mie, pâte à tartiner, oeuf, cannelle, crème liquide, lait, cassonade, beurre doux, banane, noix de coco rapée', '10 min', ['Munissez vous d''un plat à gratin que vous allez chemiser (tapisser de beurre) afin que la préparation ne colle pas.', 'Découpez les bords du pain de mie afin de ne garder que la mie.', 'Dans un grand saladier, casser 3 œufs, les battre  puis ajouter 100 g de sucre roux de préférence (en mettre moins selon vos goûts), battre le mélange, ajouter la crème et le lait et mélanger le tout. ', 'Enfin, ajouter un peu de cannelle en poudre.', 'Préchauffer le four à 180°C (thermostat 6).', 'Tartiner ensuite le pain de mie avec la pâte à tartiner sur un côté puis disposer 6 tranches dans le fond du plat beurré (ajouter banane ou noix de coco si vous le souhaitez). ', 'Une fois cette première couche de pain et pâte à tartiner disposée y ajouter le mélange juste assez pour que le pain soit imbibé, une fois le pain imbibé refaire la même chose (un peu comme des lasagnes !).', 'A la fin ajouter de la cassonade sur le dessus.', 'Enfourner le plat 30 min au four puis 10 min à 80 degrés, vérifier le pudding de temps en temps en plongeant la lame d''un couteau au milieu et voir si c''est bien cuit.', 'Laisser refroidir un peu avant de servir. ', 'Servir tiède et avec une boule de glace vanille ou rhum-raisin, so british my dear !'], ['Rouleau à pâtisserie', 'Râpe', 'Casserole', 'Fouet', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'noix de coco rapée', 'dessert', 'plat de résistance', 'Bread and butter pudding (à la pâte à tartiner au chocolat)', 'beurre doux', 'cannelle', 'lait', 'cocktail', 'pain de mie', 'pâte à tartiner'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:25:23.859806', [{'ingredient_id': '08899748-b4b9-4921-8271-1f3828fbf1b3', 'quantite': '18'}, {'ingredient_id': 'bef4ba5f-cbce-4bcf-8194-ef9f2981eb69', 'quantite': '200 g'}, {'ingredient_id': 'c238a271-3934-4cee-887f-03499162ee06', 'quantite': '3'}, {'ingredient_id': 'ca50b08e-b459-4196-8c7d-8956f1eb02bf', 'quantite': '1'}, {'ingredient_id': 'aefea513-7a2f-4afc-a5d1-d4c173dfe6d2', 'quantite': '40 cl'}, {'ingredient_id': '52b19a6b-2874-4be6-8fdd-25584e036dff', 'quantite': '40 cl'}, {'ingredient_id': '7790856a-4edf-4643-b5f5-19c46f41a85f', 'quantite': '100 g'}, {'ingredient_id': '777a03a1-8019-4d42-85fb-188ecf94d1d9', 'quantite': '25 g'}, {'ingredient_id': '31a74735-bf45-4424-80da-78a98580b4e0', 'quantite': ''}, {'ingredient_id': '80063518-23cb-48aa-9272-225622a6b6b4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12788, 'Poulet aux bananes vertes (Cameroun)', 'poulet, oignon, bouquet garni, beurre, bouillon, vin blanc, banane, huile, jaune d''oeuf, citron, poivre, sel', '45 min', ['Découper le poulet cru.', 'Faire cuire les morceaux pendant 20 minutes à partir de l''ébullition dans un litre et demi d''eau avec l''oignon coupé en rondelles et le bouquet garni. Egoutter et essuyer les morceaux.', 'Faire fondre le beurre dans une cocotte et y faire dorer les morceaux de poulet. Recouvrir avec le vin blanc et le bouillon. Saler, poivrer, faire bouillir pendant deux minutes et laisser mijoter pendant 15 minutes.', 'Eplucher les bananes. Les fendre en 4 ou en 8 selon leur grosseur. Les blanchir à l''eau bouillante. Les joindre au poulet et laisser cuire pendant 30 minutes.', 'Retirer le poulet et les bananes. Faire réduire la sauce du tiers de son volume. La lier  avec les jaunes d''oeufs. Ajouter le jus de citron.', 'Servir les morceaux de poulet recouverts avec la sauce et entourés de bananes.'], ['Casserole', 'Râpe', 'Moule à tarte', 'Pince de cuisine', 'Poêle'], ['poulet', 'banane', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bouquet garni', 'plats africains', 'vin blanc', 'plat', 'jaune d''oeuf', 'bouillon', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile', 'Poulet aux bananes vertes (Cameroun)', 'dessert', 'plat de résistance', 'moyen', 'citron', 'beurre', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:25:27.507526', [{'ingredient_id': 'ee830474-76a2-414a-a472-813d89b231d0', 'quantite': '1'}, {'ingredient_id': '486984a0-11db-4e15-997f-229f687cd7c6', 'quantite': '1'}, {'ingredient_id': '1140e671-6266-4675-a016-c0cb6341ae36', 'quantite': '1'}, {'ingredient_id': '8cdae0b4-8b91-45f5-8fd8-b8f96f9705ac', 'quantite': '30 g'}, {'ingredient_id': '0a3fde31-2e11-4e5f-9299-573e2869854a', 'quantite': '1'}, {'ingredient_id': '91bb05af-6fd7-46f7-b3ad-0ff7d8954589', 'quantite': '1'}, {'ingredient_id': '4291a9be-a96d-40e5-978f-795960dc45dc', 'quantite': '12'}, {'ingredient_id': '5451936f-a873-4427-b412-c3d23dd3e4c7', 'quantite': '2 cuillères'}, {'ingredient_id': '3ae2c5be-ea34-402c-9177-16dfcd75480b', 'quantite': '2'}, {'ingredient_id': 'e45f4c86-9d6f-47c5-a4c8-357537a4d6cc', 'quantite': '1'}, {'ingredient_id': '3789573a-34a7-438a-a1fd-e71ee875ea9a', 'quantite': ''}, {'ingredient_id': 'eb9024cd-7f35-48a0-8436-d1f417ec36a3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61702, 'Petites bouchées bananes chocolat', 'pâte brisée, banane, jaune d''oeuf, chocolat noir', '5 min', ['Préchauffez le four à 180°C (thermostat 6).', 'Veillez à garder le papier sulfurisé de votre pâte.', 'Détaillez des cercles de 5 cm de diamètre.', 'A l''aide d''un pinceau, badigeonnez vos minis disques de pâte de jaune d''oeuf.', 'Découpez des rondelles de bananes de 2cm d''épaisseur puis déposez-les sur les cercles de pâte.', 'Râpez le chocolat et saupoudrez-en plus ou moins sur les bananes. ', 'Les bouchées sont donc sur le papier sulfurisé et prêtes pour faire un petit détours de 10 minutes au four.', 'La pâte devrait être gonflée et bien dorée en fin de cuisson.', 'Attendez quand même 10 minutes avant de dévorer ! Euh, déguster, pardon...'], ['Poêle', 'Couteau de chef', 'Casserole', 'Spatule', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'Petites bouchées bananes chocolat', 'jaune d''oeuf', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:25:32.882572', [{'ingredient_id': '049f8c46-c483-4587-9733-7060fd79d803', 'quantite': '1'}, {'ingredient_id': '5033454e-38fc-47a1-a28e-6b5063a0cc5f', 'quantite': '1'}, {'ingredient_id': '64fc827f-0a82-4adc-b0d9-c9bf2c27b943', 'quantite': '1'}, {'ingredient_id': 'cc8f5187-b4f5-47d1-a674-406360acc549', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (339858, 'smoothie vanillé poire banane pêche', 'poire, banane, citron, sirop de citrons, sucre vanillé, pêche', '10 min', ['Épluchez les poires, pêches et la banane. ', 'Coupez tous les fruits en morceaux.', 'Versez les fruits dans un saladier et ajouter le jus du citron ainsi qu''un peu de sirop de citron (à adapter selon la consistance voulue).'], ['Couteau de chef', 'Spatule', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'smoothie vanillé poire banane pêche', 'sucre vanillé', 'citron', 'pêche', 'smoothies', 'sirop de citrons', 'cocktail'], 'Boisson', 3d749007-2ef7-4f9f-aa6e-2760bd750919, '2025-09-26T16:25:38.307409', [{'ingredient_id': '0cb6f42c-8072-4e52-b451-b904b51ca952', 'quantite': '4'}, {'ingredient_id': 'f2953d20-aa42-4d64-9185-8aa535d9e08d', 'quantite': '1'}, {'ingredient_id': '687d7d7b-d81c-418d-a7cb-457813e656b6', 'quantite': '1'}, {'ingredient_id': '60785b98-9f21-4d51-8230-0aa828571beb', 'quantite': '5 cl'}, {'ingredient_id': 'd5721805-3c3e-493a-a3b9-afb1d4a05d87', 'quantite': '1'}, {'ingredient_id': '934bd51a-50d7-4037-8b9d-d18ba50a4e2c', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43837, 'Cake traditionnel à la banane (avec fécule de maïs)', 'sucre, beurre, oeuf, banane, citron, fécule de maïs, levure', '15 min', ['Préchauffez le four à 180°C (thermostat 6).', 'Beurrez le moule à cake, chemisez-le de papier sulfurisé, beurré lui aussi.', 'Séparez les blancs des jaunes d''oeufs.', 'Placez les blancs au frais.', 'Mettez les jaunes dans un saladier avec le sucre et le beurre mou.', 'Fouettez jusqu''à ce que le mélange blanchisse.', 'Pressez le jus du citron.', 'Pelez les bananes, coupez-les en morceaux et mettez les dans le bol d''un mixeur avec le jus de citron. Faites tourner jusqu''à obtention d''une purée fine.', 'Versez la puréée de bananes dans la préparation aux jaunes d''oeufs. ', 'Mélangez bien puis incorporez la fécule de maïs et la levure.', 'Battez les blancs en neige ferme. Incorporez-les délicatement à la préparation.', 'Versez la pâte dans le moule et enfournez. ', 'Faites cuire 40 minutes puis démoulez le cake chaud sur un grille pour le laisser refroidir.'], ['Mixeur', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'Cake traditionnel à la banane (avec fécule de maïs)', 'cuisine', 'levure', 'recettes', 'boisson', 'autres cakes', 'dessert', 'plat de résistance', 'citron', 'beurre', 'sucre', 'cocktail', 'fécule de maïs'], 'Dessert', 1e235873-0d9b-4a21-a4b9-c65c9eb09cba, '2025-09-26T16:25:43.140147', [{'ingredient_id': '41ec5a8e-70f6-49a0-bf0b-f343e7055cc6', 'quantite': '200 g'}, {'ingredient_id': '0ec36edc-c4f7-4a3f-8f6a-8ff188da2179', 'quantite': '200 g'}, {'ingredient_id': 'b9cabfa7-8d67-41ff-8f5b-038856e01069', 'quantite': '4'}, {'ingredient_id': 'eef9b11f-d32d-4d57-85ac-0e803e7e0e94', 'quantite': '2'}, {'ingredient_id': 'c78fbc5f-de85-4f22-9540-3d24f477ee26', 'quantite': '1'}, {'ingredient_id': '1f1e3049-7e47-48b8-ac99-b377ce1b8805', 'quantite': '140 g'}, {'ingredient_id': '801c1caa-020b-4a8d-b872-5d668f85d701', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (221601, 'Tarte banane et roquefort', 'pâte brisée, banane, compote, roquefort, muscade', '20 min', ['Préchauffez le four à 180°C (thermostat 6).', 'Placez votre pâte dans votre moule à tarte et faites-la cuire une première fois pendant 10 min.', 'Pendant ce temps, coupez la banane en fines rondelles et émiettez le roquefort au couteau.', 'Sortez la pâte du four et recouvrez le fond avec une fine couche de compote.', 'Recouvrez ensuite avec les rondelles de bananes.', 'Saupoudrez le tout de roquefort (vous pouvez éventuellement râper un peu de noix de muscade).', 'Enfournez votre tarte pour 15 min.'], ['Ouvre-boîte', 'Presse-agrumes', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'muscade', 'facile', 'bon marché', 'plat', 'recette', 'compote', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'Tarte banane et roquefort', 'plat de résistance', 'roquefort', 'cocktail'], 'Entrée', 993943a1-704b-42ef-88fb-bba742deb722, '2025-09-26T16:25:48.847735', [{'ingredient_id': '78439727-7670-4f23-88dd-c7a1e6925c5b', 'quantite': '1'}, {'ingredient_id': '58216c56-62f8-4d08-9ed5-5f3bc337a0b6', 'quantite': '1'}, {'ingredient_id': '9fc18795-8ead-4298-bef1-44586a56db6e', 'quantite': '50 g'}, {'ingredient_id': 'dad1e0a9-4758-4b5b-8749-6434622410d2', 'quantite': '25 g'}, {'ingredient_id': '01bcfe93-df62-4dd2-b00e-5d4381135f56', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (219630, 'Crumble poire banane nutella facile', 'poire, banane, Nutella, farine, sucre, beurre, citron', '15 min', ['Préchauffez le four à 180°C (thermostat 6).', 'Dans un saladier, mettez le beurre découpé en petits morceaux et ramollissez-le avec les doigts ou une cuillère.', 'Ajoutez la farine et le sucre et mélangez le tout du bout des doigts pour formez une sorte de "sable".', 'Découpez les poires et les bananes en petits dés. Mélangez-les avec le jus d''un demi citron pour éviter qu''elles noircissent. ', 'Tartinez un plat de nutella à votre convenance puis mettez y les fruits. Recouvrez de la pâte sablée.', 'Mettez au four 10 à 20 min jusqu''à ce que la pâte soit bien dorée.'], ['Mixeur', 'Ouvre-boîte', 'Moule à tarte', 'Couteau de chef', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'poire', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'Nutella', 'dessert', 'plat de résistance', 'citron', 'beurre', 'Crumble poire banane nutella facile', 'sucre', 'cocktail'], 'Dessert', 24c64509-a4ab-4b3a-b37f-8c2b78280a22, '2025-09-26T16:25:52.642793', [{'ingredient_id': '9e5c5efe-622e-4c3b-9e10-fdf844dad372', 'quantite': '3'}, {'ingredient_id': '76d6c0cf-a40a-458d-a1bb-b0d1f9292a18', 'quantite': '3'}, {'ingredient_id': '99e287fb-9d91-4171-bf71-2cf1adece6e3', 'quantite': ''}, {'ingredient_id': '086378fb-e718-497b-95b5-c93320e0c147', 'quantite': '200 g'}, {'ingredient_id': 'adf2e1d2-bc9d-427f-90ae-ec9e43d88ada', 'quantite': '100 g'}, {'ingredient_id': '1895cab1-9a2a-4f74-a9ec-072cb0917624', 'quantite': '100 g'}, {'ingredient_id': '8c93ffec-949c-4048-862e-9fd882b3d8e7', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22677, 'Tarte des iles au chocolat noir', 'pâte brisée, banane, citron, beurre, oeuf, miel liquide, noix de coco rapée, sucre vanillé, cannelle, chocolat noir, crème fraîche', '30 min', ['Ecraser la banane dans un récipient, verser le jus de citron, le beurre fondu et les oeufs en battant bien. Puis rajouter le miel, la noix de coco, le sucre vanillé et la cannelle. Mélanger. ', 'Préchauffer le four (Thermostat 6 - 180°C ) . ', 'Etaler la pâte dans un moule et étaler la garniture. ', 'Faire cuire 35 mn jusqu''à ce que le dessus soit d''une belle couleur dorée. ', 'Laisser refroidir 10 mn. ', 'Porter à ébullition la crème, retirer du feu et faire fondre le chocolat coupé en morceaux. ', 'Attendre 5 mn puis battre au fouet. ', 'Etaler sur la tarte avec une spatule. ', 'Manger froid'], ['Poêle', 'Casserole', 'Spatule', 'Batteur électrique'], ['miel liquide', 'entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'facile', 'oeuf', 'plat', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'noix de coco rapée', 'Tarte des iles au chocolat noir', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre vanillé', 'moyen', 'beurre', 'citron', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:25:56.375454', [{'ingredient_id': '88072849-6784-429e-b1fa-732dfb1c680c', 'quantite': '300 g'}, {'ingredient_id': '69abb200-d954-4715-b80d-2a5f93f4072d', 'quantite': '1'}, {'ingredient_id': 'b98a5194-e1d6-463a-9035-88532c0082d5', 'quantite': '1'}, {'ingredient_id': 'b33ed270-779d-43cf-9213-f024cf5bfe61', 'quantite': '50 g'}, {'ingredient_id': '6acb4bb2-70b3-4a41-a8df-d377948a8298', 'quantite': '2'}, {'ingredient_id': '465b18e0-66a1-4b51-b83f-74f179f06ab4', 'quantite': '10 cl'}, {'ingredient_id': 'f665c4c0-0b7e-42c7-a406-f7588294e316', 'quantite': '75 g'}, {'ingredient_id': '97cb1b16-5061-4f38-984f-607a9a1c8af1', 'quantite': '1'}, {'ingredient_id': 'aae6728d-21eb-4e80-84f2-e0f8e623c685', 'quantite': '1'}, {'ingredient_id': 'de67532c-a4fd-4d54-81e0-0bc11e5c6228', 'quantite': '150 g'}, {'ingredient_id': '22d52074-6068-43b8-bf83-beee5ffdb91e', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (531072, 'Pudding coco, banane, citron, framboises et graines de chia', 'lait de coco, citron, stévia, graines de chia, framboises, sirop d''agave, maïzena, noix de coco, banane', '10 min', ['La veille au soir, mélanger ensemble le lait de coco, le sirop d''agave et les graines de chia dans un bol filmé et laisser la nuit au frigo. (au moins 2h)', 'Le matin, mélanger le jus de citron, la maïzena et la stévia dans une petite casserole. Mettre à feu doux sans cesser de remuer. Quand le lemon curd est prêt, ajouter et mélanger la 1/2 banane en rondelles.', 'Déposer le mélange lait de coco/chia au fond d''une verrine puis le lemond curd/banane par dessus. Ajouter les framboises et saupoudrer de noix de coco râpée.'], ['Fouet', 'Poêle', 'Passoire', 'Batteur électrique', 'Rouleau à pâtisserie'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'framboises', 'maïzena', 'bon marché', 'rapide', 'sirop d''agave', 'plat', 'recette', 'cuisine', 'recettes', 'graines de chia', 'boisson', 'pudding', 'dessert', 'plat de résistance', 'citron', 'stévia', 'noix de coco', 'cocktail', 'Pudding coco', 'framboises et graines de chia'], 'Dessert', bc9cd607-3158-4b43-9b68-809d4b433fa6, '2025-09-26T16:25:59.989716', [{'ingredient_id': '8f51bc05-6942-427d-bf56-448ec09e91e3', 'quantite': '100 ml'}, {'ingredient_id': '9d84e1c0-5116-410e-94a9-dce603135dbf', 'quantite': '1'}, {'ingredient_id': '252fc71c-fd14-42a8-ab84-e00de651f9d5', 'quantite': '2 cuillères'}, {'ingredient_id': '30bdd704-b455-4a96-9bfa-586b91ccf858', 'quantite': '1 cuillères'}, {'ingredient_id': '7aa8b5d4-5ced-4101-bd07-916411e87f34', 'quantite': '5'}, {'ingredient_id': 'e3845c41-1a54-4059-8393-625b481e0143', 'quantite': '1 cuillères'}, {'ingredient_id': '9d5cce32-a6e8-4807-bf6f-5441a15347da', 'quantite': '1 cuillères'}, {'ingredient_id': 'fd07803e-5c7a-4c63-a051-0cef81a5a164', 'quantite': '1'}, {'ingredient_id': 'fd6b5044-4f4d-4700-99cd-93d33d64c584', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (54524, 'Bananier pâtissier', 'oeuf, farine, sucre, chocolat pâtissier, levure chimique, jaune d''oeuf, lait, farine, sucre, vanille, banane, chocolat, sucre glace, pâte d''amande', '240 min', ['Commencez par la préparation de la génoise au chocolat :', 'Préchauffez le four à 210°C (thermostat 7).', 'Faites fondre le chocolat avec une cuillère à soupe d''eau, mélangez, jusqu''à ce que le chocolat soit bien lisse.', 'Séparez le blanc des jaunes des oeufs.', 'Ajoutez le sucre aux jaunes et melangez vigoureusement jusqu''à obtenir un mélange homogène qui a blanchi.', 'Ajoutez le chocolat fondu. ', 'Montez les blancs en neige avec une pincée de sel à part, incorporez-les délicatement dans le mélange jaunes d''oeufs/sucre/chocolat. ', 'Ajoutez ensuite la farine et la levure tamisée ensemble.', 'Beurrez un moule à manqué, versez-y la préparation et faites cuire pendant 30 minutes.', 'Préparez la crême patissière: ', 'Mélangez les jaunes d''oeuf avec le sucre jusqu''à obtenir un mélange homogène blanchissant.', 'Ajoutez ensuite 1/2 verre de lait afin de rendre le mélange fluide. ', 'Ajoutez la farine tout en fouettant afin de ne pas obtenir de grumeaux. ', 'Faites chauffer le reste de lait avec la gousse de vanille, une fois que le lait frémit, retirez la gousse de vanille et ajoutez le mélange oeuf/sucre/farine/lait.', 'Mélangez jusqu''à ébullition de la crème. ', 'Laissez refroidir la génoise et la crème patissière. ', 'Pendant ce temps, coupez les bananes en petit morceaux.', 'Et si vous le désirez, faites des feuilles, des roses, ect ... avec la pâte d''amande. ', 'Une fois la génoise et la crème refoidies, coupez la génoise en deux.', 'Etalez la crème patissière, et posez les morceaux de banane sur toute la surface du gâteau.', 'Recouvrez l''ensemble du deuxième morceau de génoise. ', 'Avec le chocolat et le sucre glace, faites un nappage tout autour du gâteau et sur le dessus.', 'Vous pouvez maintenant poser vos décorations en pâte d''amande.'], ['Ouvre-boîte', 'Tire-bouchon', 'Spatule', 'Couteau de chef', 'Casserole'], ['', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'oeuf', 'plat', 'moyenne', 'recette', 'chocolat pâtissier', 'Bananier pâtissier', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:26:03.984444', [{'ingredient_id': 'c5ceb7f4-f790-4843-917f-f17b7bd4c151', 'quantite': '4'}, {'ingredient_id': 'c6ac969a-5d64-4e62-8cb5-b1313bc68547', 'quantite': '125 g'}, {'ingredient_id': 'eb1a240d-d304-419c-b4f9-4e349e9b5a21', 'quantite': '150 g'}, {'ingredient_id': '493cc6e3-943f-4686-b0cc-73c8e723ec74', 'quantite': '100 g'}, {'ingredient_id': '4d30ceb6-26f9-4b5a-8e5e-078068fda1ed', 'quantite': '1'}, {'ingredient_id': '64b201d0-e5e6-4a65-9bbc-d21d2faab76f', 'quantite': '2'}, {'ingredient_id': 'd03451fd-f2f9-4adf-8698-5e4c0d5939aa', 'quantite': '50 cl'}, {'ingredient_id': 'dcaa2d58-48c7-44ed-b8df-25fbe0786199', 'quantite': '50 g'}, {'ingredient_id': 'fec565ba-6ef9-4ced-97f7-6b9f70c97952', 'quantite': '100 g'}, {'ingredient_id': 'a545bcfc-64bb-42b7-874b-359ac143990f', 'quantite': ''}, {'ingredient_id': '897589f3-33a8-4ee2-9738-1c1aec74ee1c', 'quantite': '2'}, {'ingredient_id': 'bb157925-77ea-4382-973c-af85108e692a', 'quantite': '100 g'}, {'ingredient_id': 'ee3db8a1-e9d8-4196-8039-b7fa8502e345', 'quantite': '100 g'}, {'ingredient_id': 'c856d0cf-1e83-4e61-a2ac-2344e0af7395', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72039, 'Salade de fruits frais extra et rafraîchissante', 'banane, ananas, mangue, fraises, kiwi, orange, pomme, cannelle, vanille, sirop, sucre en poudre, eau', '15 min', ['Pelez et coupez tous les fruits en morceaux et mettez-les dans un grand saladier. ', 'Faites votre jus en mélangeant dans un pichet le sirop, le sucre et l''eau. ', 'Versez ce mélange sur vos fruits, ajoutez les bâtons de cannelle et de vanille. ', 'Mettez au réfrigérateur minimum 2 h (plus vous la laisserez au frais, meilleure sera votre salade de fruits frais!).', 'Vous pouvez aussi ajouter un peu d''alcool selon les goûts comme du Kirsh, du Rhum, Soho, Pisang... ', 'Bonne dégustation! 
S''il en reste encore le lendemain, elle n''en sera que meilleure car les fruits auront pris le temps de bien macérer dans leur jus !!!'], ['Casserole', 'Fouet', 'Poêle', 'Batteur électrique', 'Spatule'], ['entrée', 'salade de fruits originale', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'Salade de fruits frais extra et rafraîchissante', 'rapide', 'plat', 'mangue', 'fraises', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'pomme', 'orange', 'ananas', 'sirop', 'cannelle', 'cocktail'], 'Dessert', 073434ef-5a20-4f7f-9bc2-7cf56e603070, '2025-09-26T16:26:08.630937', [{'ingredient_id': '9276d0e2-5ce2-4216-8b79-a2690406c0b3', 'quantite': '4'}, {'ingredient_id': '0cfef3a4-bb34-49c9-85cd-48686f1f9f92', 'quantite': '1'}, {'ingredient_id': 'e7146063-835d-4333-a0eb-53963eebf550', 'quantite': '1'}, {'ingredient_id': '74fdd61d-758c-4b72-9548-af16f8ad886b', 'quantite': '1'}, {'ingredient_id': 'b9fbc3d2-8e7d-40a2-b7c0-4dc6f731ff26', 'quantite': '4'}, {'ingredient_id': '5c0f4861-0f73-4fc6-a951-0ba3a6a0d58f', 'quantite': '2'}, {'ingredient_id': '8cc0d567-af2f-4032-8312-ae46d0b0a359', 'quantite': '3'}, {'ingredient_id': '87bbdc25-15c6-44ce-a8e5-4f0a9ed2d635', 'quantite': '1'}, {'ingredient_id': 'b4608186-8d46-430e-a047-d31928eedbe0', 'quantite': '1'}, {'ingredient_id': '6d9a837e-169c-4cc2-bd94-c94b5566f78e', 'quantite': '15 cl'}, {'ingredient_id': 'cbd17e9f-7514-43d5-899a-e3438ac7226f', 'quantite': '100 g'}, {'ingredient_id': '5eab9d99-d169-4119-935c-e8a3bd312e33', 'quantite': '1 l'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23809, 'Pain de banane', 'farine, levure, beurre, sucre, oeuf, banane', '15 min', ['Faites bien ramollir le beurre (éventuellement, passez-le 2 mn au micro-ondes à puissance faible).', 'Mélangez le beurre ramolli et le sucre et battez le toutavec unez fourchette. Ajoutez les oeufs et continuez a battre jusqu''à ce que la pâte devienne mousseuse.', 'Dans un autre saladier, mélangez la farine, la levure et le sel.', 'Ecrasez les bananes à la fourchette dans une assiette et incorporez-les peu à peu à la pâte en alternant avec les ingrédients secs (farine, levure et sel), toujours en mélangeant bien.', 'Versez la pâte dans un moule à gâteau anti-adhésif (ou un moule beurré) et faites cuire pendant 45 mn à thermostat 6/180°C.', 'Après la cuisson, démoulez le gâteau (pain) et laissez-le refroidir.'], ['Verre doseur', 'Rouleau à pâtisserie', 'Moule à tarte', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Pain de banane', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', 03202dca-ad5e-4785-bedf-ea25e838cbb1, '2025-09-26T16:26:13.286713', [{'ingredient_id': '2eb196e9-39f6-46db-8f23-13d5c8218de8', 'quantite': '200 g'}, {'ingredient_id': '3506ed4e-c434-46cc-9283-18b42ef56d6f', 'quantite': '1'}, {'ingredient_id': '2b9b40f5-f537-4f0f-9031-e35eda3e3967', 'quantite': '80 g'}, {'ingredient_id': '8d0c7b10-3122-41e1-9e7e-afe40546771f', 'quantite': '130 g'}, {'ingredient_id': '3f4dbaab-71b8-4978-a927-f6dff38e84c5', 'quantite': '2'}, {'ingredient_id': '0fa27ba5-3352-4b2a-b31b-eac4675d687e', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65962, 'Gâteau à la banane et noix de coco', 'oeuf, sucre, farine, beurre, levure chimique, banane, noix de coco rapée', '10 min', ['Préchauffer le four à 210°C (thermostat 7).', 'Dans une jatte, mélanger le sucre et les oeufs, ajouter le beurre fondu puis la farine et la levure.', 'Ecraser 2 bananes et les mélanger à la préparation.', 'Verser le tout dans un moule à manquer beurré et fariné.', 'Couper le dernière banane en rondelles, diposer sur la préparation et saupoudrer de noix de coco.', 'Enfourner 30 minutes.', 'Attendre 15 min à la sortie du four pour démouler le gâteau.'], ['Planche à découper', 'Moule à tarte', 'Tire-bouchon', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'noix de coco rapée', 'Gâteau à la banane et noix de coco', 'dessert', 'plat de résistance', 'gâteau à la banane', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:26:20.122850', [{'ingredient_id': 'ad5f72f3-26a8-455c-9d65-d44b26ba870c', 'quantite': '3'}, {'ingredient_id': '4ab276fd-2cef-45a2-9e8a-2f6613564b43', 'quantite': '150 g'}, {'ingredient_id': 'f1f96ef6-e62b-43f7-886f-7095b94072ed', 'quantite': '150 g'}, {'ingredient_id': 'c3f7b04d-388c-4a8a-b46d-32aee530cccf', 'quantite': '150 g'}, {'ingredient_id': '69911089-b61a-46d7-81c0-7eb800040c5e', 'quantite': '1'}, {'ingredient_id': 'b75b54a9-29fa-48fe-a34e-78e1fa104109', 'quantite': '3'}, {'ingredient_id': '12bc7f49-e012-463b-ab02-6176305de5ce', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (218553, 'Milk-shake pomme-banane', 'pomme, banane, sucre vanillé, lait', '5 min', ['Épluchez et coupez la pomme en petits morceaux.', 'Faites de même avec la banane.', 'Mettez le tout dans un mixeur puis ajoutez le sucre. Versez le lait puis mixez.', 'Ajoutez du lait selon la consistance souhaitée.'], ['Presse-agrumes', 'Spatule', 'Économe', 'Rouleau à pâtisserie', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Milk-shake pomme-banane', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:26:23.695190', [{'ingredient_id': '2a8a73a2-5809-48b6-ba0a-80b60c33b4e2', 'quantite': '1'}, {'ingredient_id': 'ab5d4e1c-6763-44fa-9b39-8f0870254fdb', 'quantite': '1'}, {'ingredient_id': 'cb85a193-3cbe-462e-b12b-1fcd0ce579f1', 'quantite': ''}, {'ingredient_id': 'ef8ab0e2-db3e-484f-8514-4580cf4e67af', 'quantite': '10 cl'}]);
