INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, 864a867c-b891-4438-8869-ab4a9c5bad6c, 'Un délice merci pour cette super recette.', '2015-02-11T20:14:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, 52e1010b-6484-4033-ba58-2bccc47d0d4c, 'Super bon et facile à faire même les petits peuvent participer.', '2015-02-11T15:04:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, 06c01cc8-e191-4360-b5cf-695bc01fdf69, 'Comme j''habite aux Antilles, mes bananes sont très sucrées. Du coup, j''ai suivi les conseils et diminué d''un tiers la dose de sucre. On s''est régalé !', '2015-02-10T19:01:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, 693b5de8-95d7-42b3-9f8e-a3f3b641d434, 'J''ai adoré, tout le monde était content', '2015-02-10T16:56:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, 56e46eb9-6d07-4e5b-a32c-dee0318f2f4b, 'Parfait, rien à ajouter ! Dosage parfait ! ', '2015-02-10T15:24:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, 06dec034-a65a-48d4-a43a-f520d053ebcb, 'Famille ravie, invités séduits... Que peut on demander de plus ?', '2015-02-10T14:58:37+01:00');
