INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, 23673b2b-f6ea-4cde-986b-962a8d97780b, 'Merci pour toutes ces idées ! J''en ai essayé certaines, un délice ! ', '2015-06-12T20:03:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, 9a1628a5-e8b3-4605-aa50-50114f16266c, 'Merci pour toutes ces idées !', '2015-04-22T18:57:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, d91e21a8-9e9f-4948-a581-009e390d87a5, 'Excellente idée que toutes ces propositions ! chacun a la maison fait son choix les soirs de pizza comme au resto. un grand merci.', '2015-03-11T13:05:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, b5361e1f-86d8-49c0-8774-095996c94147, 'Wow, un gros merci !', '2015-01-22T00:07:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, 1302134e-909f-4522-9f99-f722655154b5, 'Super pour une mamie et les petits loulous', '2014-11-27T08:29:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, 3f2639b2-c3fe-437f-8fe2-4940f379abe8, 'Grâce à la recette; mes invités se sont régalés et se sont resservis ! Merci', '2014-07-07T18:51:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, 627b4e67-d09c-4fdc-a137-4d27a4d7792d, 'Géniale cette liste !! Ça donne plein d''idées, merci. ', '2014-06-13T12:13:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, 97616b5b-6f8c-4b4d-94df-49dedd6cdfea, 'Super plein de belles idées', '2013-09-22T20:33:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, b2cb7733-02a0-4069-9b09-174b77f0e8e7, 'Super ! merci beaucoup ! ', '2013-06-23T23:13:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, c22a4cbc-4dbc-4a9b-93ff-2fb9ad2a6e5b, 'C''est trop bien fait, merci.', '2013-03-28T19:01:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, 009f3111-1400-4ba1-a57a-3d68d17cb1c8, 'Merci pour toutes ces idées !!!!', '2013-02-15T20:03:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, 4941ec21-25e2-4168-a361-ec83fda1b89a, 'J''ai pas encore essayé mais je pense que ça va me donner envie de faire plus souvent de la pizza avec toutes ces idées. Merci beaucoup, à garder absolument dans mes favoris.', '2011-08-24T20:51:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, f6bd0529-d617-4bf9-92d2-7121359c6f4a, 'Plein d''idées pour plein d''envies et de goûts différents. Un grand merci.', '2011-05-04T20:31:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, f3f0e37b-85f5-4029-be60-3fab7b6c13a0, 'Merci beaucoup pour toutes ces idées de recettes pour pizza !!! Excellent !!', '2011-04-16T13:13:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, e608b381-a88e-4026-bf5a-c73629649b88, 'Merci pour toutes ces idées! ', '2010-11-03T21:51:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, a9a809d7-2298-4379-bf25-06251419520b, 'Merci pour toutes ces propositions de garnitures de pizzas. Personnellement, je cuis 15 minutes sur 220°.', '2010-08-02T15:40:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88247, 5ba4c0ee-9fae-4101-9956-7d50e470b6a9, 'J''ai choisi cette recette pour mon repas de Noel, vu qu''il était bien copieux : résultat, un régal. Les saveurs se marient très bien. C''est frais, léger, gouteux et raffiné. Je vais le refaire !', '2017-01-16T19:28:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88247, 179f440a-5b05-47b5-bcab-8a6ec7cfcb86, 'Je trouve que cette recette n''apporte rien de particulier. La banane et le spéculoos prennent le dessus. Où est le sorbet passion ? Je ne referai pas ce dessert.', '2016-11-23T21:46:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88247, c7de9184-aaa7-4243-8170-3215eccc23a7, 'J''ai adoré ! J''ai mis du sucre et un peu moins de spéculoos que la recette. Succulent et frais. Par contre, je n''ai trouvé que du sorbet mangue-passion. A refaire !', '2011-02-26T15:30:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88247, fb9bffaa-3a9f-4887-966d-59f3b98a77fc, 'Très bonne recette, je mettrais pour ma part un peu moins de spéculoos et un peu plus de sorbet passion/crème. Sinon : délicieux, je l''ai servi en petites verrines avec d''autres biscuits tout autours d''un café (gourmand), mes invités ont apprécié.', '2009-11-12T22:05:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337307, 28fdebcd-744b-4528-b708-33fac15db769, 'Bon mais trop moelleux, voire mou. Il aurait fallu rajouter plus de farine.', '2023-10-21T09:21:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337307, 888953a3-7a1a-426c-a9da-cc7dc3c65025, 'Je les ai fait déjà 7 fois 😁', '2022-03-10T18:16:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337307, 0528550b-321b-43b9-9a9b-2d5ba7877a94, 'Recette essayée aujourd’hui. Mais j’ai dû rajouter 6 cuillères à soupe de farine car la pâte était trop liquide. Je n’ai pas mis de pralin car j’en avais pas. Résultat : un délice super moelleux, à refaire.', '2020-02-08T12:18:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337307, 118253e5-25d4-490a-9b84-10503b04de47, 'Très bon. Testé sans pralin car je n''en avais pas. Recette simple réalisée par mon fils pour le goûter. ', '2017-06-18T18:46:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33770, b96bde76-345c-416f-bf61-fe325cae9d05, 'Bon, frais, vitaminé. J''ai pressé l''orange et utilisé du lait de vache, sans mettre de gingembre ni de cannelle. ', '2017-06-27T22:23:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33770, bd91cf1f-3f8e-4196-82e0-f321c5204f6a, 'On doit presser l''orange avant de la mettre dans le blender ? Je n''ai jamais fait de smoothie !', '2015-12-02T10:29:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33770, eea551ed-5eff-470c-9484-de45d145e5ae, 'Mon smoothie préféré! Je le fais presque tout les jours avec du lait d''amande, et je ne m''en lasse pas !', '2015-04-25T01:23:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33770, 010aab92-6ac2-4f42-9e66-5dd34605dbf9, 'Les fruits rouges congelés ne vieillissent pas très bien. Plutôt amer et beaucoup de petits pépins à cause des baies. ', '2014-05-27T13:03:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33770, d4e1c18e-23ce-4038-9eb6-a7d2dc96d5ba, 'Tout simplement parfait !', '2013-08-21T20:42:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33770, 872616e6-7d21-4253-8bea-8edc489f2c1f, 'Très bon et frais ! Je l''ai fait avec du soja aromatisé à la vanille mais je ne recommande pas car la vanille masque le goût des fruits. la prochaine fois je ferai comme indiqué avec du soja nature !', '2012-04-01T16:11:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33770, 25d19ed1-9036-4937-883d-3f64c08b0d78, 'facile et bon je le fais aussi avec du lait demi-écrémé', '2012-02-27T20:35:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33770, 1d7e7f53-e048-4200-8b1a-2f8c1bb00d72, 'Super bon! un bon moyen de manger des fruits. Plus diététique qu''un milkshake mais autant de plaisir.', '2010-02-19T18:07:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33770, 76838564-efde-4f69-8d38-23f4453e6a4a, 'Diététiquement correct et si bon!!!', '2008-06-27T23:29:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33770, ba8438ea-a94c-42f5-8842-8f0f19cb8aae, 'Super bon! Une consistance agréable et beaucoup de parfum. Je l''ai fait avec des fraises et un yaourt à la vanille, et c''est certain, je recommencerai! Merci pour cette recette!', '2007-03-26T19:46:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33770, 7622f2b3-094d-4933-9025-24175797e497, 'Mmmmh! je l''ai fait avec deux bananes, une barquette de framboises et du lait de soja nature! Ca a beaucoup de goût et c''est très frais!', '2006-05-14T20:04:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305069, dd94062a-cd4e-40d8-ad75-dfad740ec18d, 'Excellent mélange des saveurs ! J’ adore !', '2018-03-30T14:25:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72723, 45be1c5c-a14f-436c-969b-594934d432b2, 'Je viens de le faire et je le trouve excellent ! Très bonne recette pour utiliser une récolte de fruits généreuse !', '2015-04-05T21:47:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72723, 889373b1-dd58-475e-951f-851f018ba9d4, 'Le crumble est vraiment délicieux ! J''ai mis deux bananes, trois pommes et quelques framboises... Parfait :)', '2010-04-10T12:36:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72723, 1dcc85f1-f12c-49ff-899e-5e22a23297a5, 'j''ai fait la pate avec du beurre demi-sel et j''ai utilisé un mélange fruits rouges surgelés(framboises,mures,myrtilles).Miam.', '2010-02-21T15:15:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50945, 3b248900-d499-4a56-8498-0b7f8252f5c0, 'Ce crumble est un délice. Je n''ai eu que des compliments. Ne rien changer à la recette ; elle est parfaite', '2015-02-24T14:18:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50945, 4e611b58-efc0-471e-90cb-8babeb637470, 'Trop de cannelle, très écoeurant, ça couvre le goût des poires et bananes; il faut en mettre vraiment très peu.', '2009-07-14T15:32:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, efeb5fa3-a851-4f44-96ab-bf00c566e305, 'Je finis par penser que je suis invitée pour amener le punch !!! Tout le monde en raffole, cette recette est vraiment excellente.', '2019-05-29T10:33:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, ce8337e8-e207-47c6-9330-13d605c09d39, 'Très bon punch. J''ai mis un peu moins de sucre mais mis un peu de grenadine. J''ai mis citron et orange en morceaux. Au repos deux jours. Très très bon, gros succès. Assez pour 25 personnes.', '2019-03-23T05:47:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, fba6c6df-f993-4754-b07d-2fb346688919, 'Je n''ai pas mis le jus de banane mais jus de passion.... bref le kiff total !!', '2019-01-25T13:59:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 2c2ed2f4-f703-4112-8a05-f3ea776ef370, 'Punch très bon. Franc succès pendant ma soirée. En revanche rajouter du Rhum car très léger.', '2017-09-04T13:12:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, ae58240a-b6ad-4922-b590-fbecddfdcfd4, 'Super recette suivie à la lettre, un délice. Merci !!', '2023-01-29T12:17:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, ff4c2407-3896-4b8d-85c3-a5390fbbfd66, 'Excellent ! J’en referai dès qu’une nouvelle occasion se présentera. Merci !', '2022-11-09T21:56:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 1568c249-cc86-4c33-8903-1fd485ce4bab, 'Incroyable !', '2022-09-30T04:33:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 40e55342-9887-421c-a88c-ec48b246e2ce, 'Punch délicieux avec le bâton de cannelle et légèrement moins de sirop de sucre de canne.', '2022-07-31T02:39:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 56aa1174-916d-455a-a161-a438755b3d5a, 'Délicieux ! C''est le bon mot, pas besoin de sirop de sucre de cannes, car il y a beaucoup de jus de fruits (recette faite pour 30 pers).', '2022-06-29T21:27:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 286ecf04-6d49-4011-a490-6d6408682a8a, 'Délicieux punch, fait comme la recette, avec 1 verre de sucre liquide. Rhum à 55 degrés. Un délice. Merci pour la recette.', '2022-05-10T20:19:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 638efc25-9237-4209-9eff-f3ba60671fc3, 'Fait pour nos 30 ans, et tout le monde l''a adoré! 
Nous avons mis du rhum ambré au lieu du rhum blanc, car nous le trouvons moins traitre...
Beaucoup m''ont effectivement demandé la recette! Merci pour cette excellente recette, je l''a mets dans mes favoris!', '2021-01-31T22:02:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 99de9882-d01c-46bb-ba53-c0ed18d2e07f, 'Au top ! Punch réalisé pour l’anniversaire de mon chéri, je ne m’attendais pas à ce qu’il fasse un tel effet, tout le monde l’a adoré. Je vais être de "corvée" de punch maintenant 😅', '2020-07-20T08:56:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 9ab57dcb-25f0-42a1-ae60-0fabbe4c79d5, 'Je le fais régulièrement toujours aussi délicieux, je le laisse macérer au réfrigérateur 3 jours avant de le mettre en bouteille.', '2019-12-06T15:15:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 410ba725-044f-408f-be16-3d76657d4422, 'Moi je l''ai fait à plusieurs reprises. J''ai remplacé le rhum blanc par du rhum ambré qui est plus parfumé et je rajoute toujours une lichette de Ricard pour lui donner un petit goût d''anis et de réglisse.', '2019-09-24T03:05:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 3f442310-1350-4c92-a779-b9c1089dc0f7, 'Vraiment parfait. Mes invités se sont régalés. À préparer au moins 2 ou 3 jours avant de déguster.', '2018-08-12T17:58:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 00f55dca-f442-4de5-b612-d77820bcc45e, 'Trèeees bon ! Se conserve très bien et se bonifie jours après jours. Merci !  !', '2017-12-30T11:14:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 54a02e02-f444-4e16-a941-676f4180070e, 'Pour mon premier punch, tout est parti en à peine 1h, avec une quinzaine d''invités. Je suis vraiment ravie de cette recette, merci !', '2016-10-09T23:55:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 1b350d21-8a74-4c53-85ee-a780f37d18db, 'Super bon j''ai fait un punch de 30 L avec cette recette pour environ 100 personnes. il et parti comme du petit lait , tout le monde etait ravis . pas trop fort et un goût agréable. on ma pas mal demandé la recette de ce punch, la cannelle et le poivre super idée. je le refais prochainement  !!! ', '2015-10-16T13:43:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, ce2353d4-22cb-4ad2-b210-67ce90249f2c, 'Mes amis ont adoré ! Ne pas hésiter à goûter pour réajuster. ', '2014-03-31T00:28:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 70fcdfdd-4e4f-40e3-b679-daab8ad07aa2, 'Rajouter 1/2 L de rhum ou retirer le jus de goyave pour ne pas enlever tout le goût du rhum.', '2012-06-19T02:38:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, e122ea03-d186-4438-ad1f-7370ed6395d9, 'Un grand merci pour cette recette qui mérite bien son nom. Mes amis l''ont trouvé très bon. je l''ai fait 4 jours avant au lieu des 12h et je n''ai pas mis de poivre. Nous étions 12 et il s''est bu comme du petit lait. Cette recette devrait être sur la première page en tête de liste.', '2010-02-02T18:27:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, b20ee9b8-2e2a-4a9b-8c57-3189f4e2c16c, 'Au top ! Punch réalisé pour l’anniversaire de mon chéri, je ne m’attendais pas à ce qu’il fasse un tel effet, tout le monde l’a adoré. Je vais être de "corvée" de punch maintenant ?', '2023-10-31T17:34:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, a54d62e9-4735-4294-bf51-cb30c8fc98a7, 'Une tuerie 😋 merci pour ce partage
