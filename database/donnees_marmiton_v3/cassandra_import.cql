INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 91751fc4-5cf9-4570-8533-55ab240a41f8, 'Super recette !!!!!!!!!!!!', '2020-06-10T17:39:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, d6595379-6581-418f-abb8-f8e24313df18, 'Top top top je l''ai faite avec une pâte feuilletée on s''est régalé merci pour cette recette', '2020-04-21T14:24:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 0335f482-7e61-48cf-8f41-a527128a65e2, 'Tout ce que j''ai à dire c''est hummmm !', '2020-03-31T15:36:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 6468f704-8b69-46cf-a313-b8eb69b44e6a, 'Simple et efficace.', '2019-08-29T18:42:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 2a536e51-2a06-4c88-81a9-fef4b4cf209b, 'Excellent! ', '2019-04-21T08:53:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, c0ba65a8-fc4a-497f-b13f-1d54465aec31, 'Excellent, compote maison, pate sablee aussi. Très beau rendu si vous avez du monde.', '2018-09-29T12:50:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 0f8284a7-60e2-42da-9a96-0afd68b00748, 'Super bon... j''ai juste fait une pâte à tarte moi-même tout comme la compote, à laquelle j''ai ajouté un peu de cannelle...', '2018-08-31T09:30:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 2ac3c79d-e2f8-48ce-a1b6-0c9acffddc42, 'Très bon ! Recette réalisée très régulièrement, mes proches adorent ! J''ajoute un peu de cuisson par contre.', '2018-06-11T09:08:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 81796c55-891c-40be-acb1-b6a149d93cf2, 'Nickel !', '2017-03-30T21:14:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 9c9dda5d-82ac-49dd-971a-ea0a4c7564b8, 'Super bon malgré le manque de cuisson de la pâte ', '2017-03-21T11:09:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, dca59b3d-225d-4d0f-bec8-57ac573dae10, 'Recette facile à suivre, et délicieuse ! ', '2017-03-10T14:14:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 2d0295fb-0b6f-4774-a5de-16bf401c9554, 'Un crumble très pratique à servir... Mais un peu trop consistant, j''ai mis un peu moins de farine pour le crumble. Et c''est encore mieux avec la compote maison et la pâte maison.', '2016-11-06T14:21:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 57c76a73-8895-46d0-923c-0b860bff49e6, 'Bon, un peu trop consistant à mon goût, par contre facile à servir.', '2016-10-17T08:56:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 1f188028-a2a8-42bc-8c83-673729db3559, 'Je n''ai pas aimé.', '2016-10-04T00:43:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, e099cba7-928b-4e03-9ced-dd6078af9d43, 'Croustillant à l'' extérieur, fondant à l'' intérieur... un délice !!! 
NB: j ai utilisé du sucre cristallisé (et pas du sucre glace) et diminué la quantité de sucre de 20%', '2023-02-17T12:17:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 4bc0d188-6de7-49a3-bc8a-01e342b16cdf, 'Très bon ! J’ai remplacé les framboises par des pépites de chocolat ', '2021-11-22T18:11:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 49336a63-492d-4974-adc2-dd72d116e7c0, 'Je les ai trouvé fades et pas assez dorés... la recette " financiers au bon goût d''amande " préconise une cuisson à  240 pendant 5 minutes puis 15 minutes à 180 et ils ressortent plus dorés. En rajoutant de l''extrait d''amande amère cela permet d''avoir le goût d''amande et celui des framboises !', '2018-03-04T07:24:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, b4074547-ea6d-4723-bfa4-40df076635c1, 'Excellent. Je n''avais pas assez de poudre d''amande et j''ai complété avec de la poudre de noix. J''ai diminué un peu le sucre. ', '2022-07-23T16:06:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, b16029cf-9ffc-4fd1-afed-c9b627a09e1d, 'Une recette simple et efficace pour un résultat excellent ! J''ai essayé en remplaçant les framboises par des myrtilles et tout le monde a adoré ! Merci beaucoup ! ', '2020-04-21T15:25:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 0d93be47-2d8c-4fa5-88ad-6f0c2f63ac59, 'Mes enfants adorent !', '2019-12-05T07:29:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 50229053-b13b-430c-bc1f-68b3706ce027, 'Très très bon !  !  !', '2019-09-02T00:22:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, d6904665-f6d1-4344-a87e-5b3fbc8f8be5, 'Super bon, tout le monde a adoré !', '2019-04-02T09:40:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 1baa5144-fb36-4c36-b7c6-d6b45ec3788f, 'Je rajoute du sucre vanillé et je monte les blancs en neige, quand à la cuisson je laisse mon four à 200°C, un vrai délice.', '2019-03-04T15:59:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 5ddd485a-98ab-4b69-8890-3685b013ef8d, 'Nickel.', '2017-10-16T20:13:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 2e2a83ad-6687-430f-b60a-de29b0db975b, 'Très bon et facile ! Avec 2 framboises par financier, ça le fait aussi !', '2017-08-28T12:16:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, a1fa056a-64f6-4154-ad2e-4a62fb850fdd, 'Delicieux. Essayez toutefois de bien choisir vos framboises car si elles sont acides cela peut gâcher le goût.', '2017-06-28T18:09:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 618b3f07-ce6d-4a3d-a657-6bdfdce676d0, 'Mon fils l''a fait seul et ses financiers ont eu beaucoup de succès.... recette suivi à la lettre ... seul bémol il sèche très vite ', '2017-06-05T20:10:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 24cb08e5-71d1-4c10-acce-b11db0c482f3, 'Trop sucre a mon gout. A tester avec moins de sucre. J''avais pas de framboise... mais fraises et abricots ca va bien.', '2017-05-26T20:22:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, e2f20deb-f2b6-419a-ba4b-831951900b7a, 'Juste excellent ! Recette suivie à la lettre.', '2017-02-04T18:20:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, fb019413-797f-4f30-a49a-f3711fd8dc3b, 'Excellent ! super bon et la cuisson top !', '2016-08-18T11:33:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, b2466079-a7be-424d-a143-05551091866b, 'Recette suivie de A à Z....rapide et délicieux! !', '2015-11-09T22:09:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 4800c7e8-9f99-4729-b504-4bf74d2f995f, 'J''ai mis moitié de sucre et seulement de la poudre de noisettes. C''est excellent et très rapide. À refaire!', '2015-10-20T23:00:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 140b3b8f-627d-480a-8d71-8af0f3e19d21, 'Délicieux et rapide! J''ai mis moitié farine moitié maïzena, moitié amandes, moitié pistaches hachées fin et seulement 60g de sucre!', '2015-08-15T00:50:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 3180c029-c6cb-49d8-ba8b-412b1f6eb49a, 'Tout bonnement excellent ! ', '2015-06-15T15:37:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 073d70f4-48dc-46d8-8cc6-3afcb2a5e9a6, 'Très très bon ! Je n''ai mis que de l''amande et j''ai ajouté de l’arôme car sans cela la framboise prend le dessus. L''alliance amande/framboise est juste top !', '2015-03-27T19:57:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 10814dc4-ea8d-40e2-a444-0eba3990703b, 'Excellente recette facile à réaliser. j''ai mis du beurre salé et du coup moitié de sucre. un régal. j''ai réalisé une vingtaine de pièces', '2015-03-05T17:12:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 29974e13-24e5-40bc-a643-59c8e09a3e4a, 'Trop délicieux mes enfants ont adoré. À refaire sans hésiter ', '2015-02-16T21:22:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 28c1e002-112f-42d6-8c41-ddd941ac12d1, 'C''est LA recette que je fais à chaque fois que j''ai des invités ! Super simple (même pas de blancs en neige !). Je prends des framboises émiettées surgelées que j''intègre directement dans la pâte avant cuisson : c''est un délice ! ', '2015-01-27T22:03:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 42150b80-3c50-4bd6-9ce7-c32e7ce1ced3, 'Recette délicieuse !!! A refaire sans hésiter.', '2014-12-20T18:03:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 9692ea7d-dcaf-446d-a9d9-bce7304aeb29, 'Très bon !', '2014-11-17T22:39:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, c3345d3b-4b26-45be-adf0-0b2883af7430, 'Super bon ! J''ai ajouté des pépites de chocolat blanc et je mets moins de sucre..', '2014-09-29T17:18:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, db49b73f-a5d0-455f-bec6-a6dc1f5bf563, 'Recette sympa ! Résultat comme sur la photo mais juste un bémol le goût de l''amande est effectivement masqué par la framboise ! A tester malgré tout !  ', '2014-08-05T21:26:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 7ddddc67-c835-47f7-962f-2b84acb244bb, 'Excellent, très bonne recette ! Je n''ai mis que 100 g de sucre.', '2014-03-22T19:10:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, cd6f7b6b-cc60-40b6-943f-d5a637a24a68, 'C''était la première fois que j''en faisais et c''est une réussite ils sont délicieux, à faire et à refaire merciiiii ! Caam', '2014-01-04T18:19:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, d672053f-b559-4d18-855e-6f490213a87e, 'Top ! J''ai mis seulement 100g de sucre glace en revanche et que de la poudre d''amande.', '2014-01-04T09:29:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, d0b75aa8-192b-435e-acd3-9b57b5286a79, 'Une chose à dire !!!! Excellentissime  Je les ai fait avec le tout amandes.', '2013-11-27T16:52:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 1b70b077-757d-4816-a09b-072b1ccf9ee2, 'Très bonne idée la recette de financiers revisitée avec des framboises, bien que ça ne ressemble pas trop, au final, à des financiers (le goût de l''amande étant masqué par le fruit). Peut-être à essayer en torréfiant la poudre d''amande pour exhaler la saveur, et en ne prenant que de la poudre d''amande au lieu du mélange amande et noisette...', '2013-10-17T20:55:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 8a75c0a7-2cd0-4d31-acf0-78a8f5ff1bea, 'J''ai fait des financiers pour la première fois, je ne savais pas quelle recette prendre vu toutes celles proposées sur internet et j''ai finalement opté pour celle-ci, sans regrets !!  Elle est excellente, première fois et je réussi directement, les financiers sont bien moelleux et dorés, la framboise apporte une touche de fraîcheur et d''originalité, idéale pour les chaudes soirées d''été. Vraiment je la recommande.', '2013-07-24T23:46:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229810, 90ce4170-a1e7-4c26-982c-12b8372b6b8f, 'Super recette, je l''ai faite d''amandes, une première fois avec des framboises et la deuxième fois avec des fruits rouges ! Divin !', '2013-07-22T13:02:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, 6493aff3-fca7-4535-9bac-275563086e55, 'Fait et refait avec différents fruits', '2017-03-01T17:06:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, 8eb784e5-faad-476a-92fa-d62b1e89afba, 'Bon sans être non plus exceptionnel. Pas trop long à préparer.', '2022-12-26T11:12:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, 7e175a85-548d-420b-b8f6-e4d234a5f809, 'Oh punaise c''est une tuerie.... Par contre j''ai divisé les proportions par 2 pour le même nombre de personnes de façon à ce que ce soit pas écoeurant. Avec les bananes c''est vraiment trop bon. Je retiens la recette.', '2016-12-14T21:57:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, d858730f-3056-45c3-9f82-82f2163ce1af, 'Top, top, top rapide, léger à la fin du repas et délicieux', '2015-12-24T14:49:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, 8aa5c77a-148c-4c51-bd87-f1196035191f, 'Dessert frais et léger. Néanmoins, je mettrai un peu moins de mélange yaourt/mascarpone par rapport à la quantité de fruits.', '2014-07-15T18:26:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, 13195259-f414-490d-be5e-1722d06c8311, 'C''était vraiment très bon ! J''ajouterai peut être un yaourt de plus la prochaine fois, pour alléger un peu plus. Je l''ai un peu modifié de la manière suivante : j''ai remplacé les fruits frais par une salade de fruits au sirop en boite. J''ai ensuite trempé des boudoirs dans le sirop des fruits puis je les ai disposé contre la paroi de la verrine "façon Charlotte" puis j''ai ajouté la salade de fruits au centre.  Une vraie réussite !', '2012-09-11T17:37:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, b23d7d47-caec-47da-a4df-9ee7609fb8fb, 'Excellent, facile à faire, frais et léger !!! Cela m''a permis de faire manger certains fruits que mon fils refusait de goûter. J''ai utilisé des pêches à la place des kiwis (j''en avais pas). J''ai utilisé une boîte de 250 g de mascarpone pour 3 yaourts nature et ajouté 1 sachet de sucre vanille. En verrine c''est beau aussi ! Merci pour cette recette.', '2009-07-02T00:54:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, 7af41f4f-7dcd-4eed-86c3-9899509cd172, 'Très bonne recette au mascarpone, ingrédient qui peut quelque fois être un peu lourd ; ici, le yaourt apporte la légèreté souhaitée. Je conseille les fruits rouges plutôt que les fruits jaunes (ou verts !!).', '2008-06-10T21:50:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, 658108f2-8c72-46c3-9dfa-695557e483b1, 'Génial, tout le monde adore et me demande la recette, à faire et à refaire!!! ', '2008-05-09T11:51:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, a1e817ef-468a-492b-b84f-7626477718fc, 'Très bon, très frais... rien à redire, juste se régaler. Merci Elodie.', '2008-04-13T16:01:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, e637904e-a762-4fdc-90bf-0dd20340ef9e, 'Très bonne recette à déguster bien frais pour l''été. Certes il ne faut abuser du mascarpone car cela peut vite devenir lourd mais cela se laisse bien manger.', '2007-07-09T16:42:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, bfb5bc89-213f-42ca-98be-cc1f1413e44d, 'Dessert agréable à manger. Cependant, je conseille de mélanger le mascarpone à du yaourt O%, sinon gare à l''effet écoeurant (d''autant que les parts sont copieuses).', '2006-11-25T22:05:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, 8cf8a667-58ee-4fe6-825b-df1494442cba, 'Une excellente recette, rapide, délicieuse et légère. Je la conseille après un repas un peu "lourd". La présentation est sympa, elle a beaucoup plu à mes invités. Pour ma part j''ai mis des fruits rouges juste décongelés car je n''avais que ça comme fruit!', '2006-03-07T12:01:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, 674cd865-0f7f-40d3-8803-63611dde8da1, 'Très orginal! Tout le monde a eu du mal a deviner les composants. Mais tout le monde a apprécié!', '2005-12-20T17:19:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, 0f6ba5a7-434d-460a-a444-f36ac3a9db12, 'En plus d''être rapide, simple et pas trop coûteux, ce dessert est vraiment excellent. Je l''ai testé sur des ados (amis de mes frères) pour le "goûter", il se sont régalés, j''aurai d''ailleurs dû en faire plus... ', '2005-09-15T11:00:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, bc20ef46-03f3-4080-a77f-7ca7d1b4898b, 'Super bon et très léger aprés un repas, tous les invités ont apprécié. J''ai mis aussi quelques fraises pour donner un peu plus de couleurs. ', '2005-03-29T11:55:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, 7df02ccc-6e36-4fcc-9d5c-88e85d13ca6b, 'Un dessert absolument délicieux qui a ravi petits et grands! Léger et très frais. A tester de toute urgence!!!', '2005-02-20T17:32:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28300, 34b161f7-d353-4a86-bd50-0c26cdf2b9c2, 'J''ai suivi la recette, mais j''ai remplacé les fruits par une cuillère de miel liquide: délicieux, très frais et léger en fin de repas!!', '2004-06-20T18:44:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19111, b596b7b6-d666-4bf5-80fc-78cf3c1569ec, 'Super bon ! J''ai juste remplacé le lait demi-écrémé par le lait de coco.', '2022-10-25T10:21:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19111, 57997145-f28f-44ff-b5b9-5bf0de3fc410, 'Excellent !   A refaire !', '2020-01-18T13:17:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19111, ec7f517e-f681-4039-9aec-75b2f19ab6e4, 'Le mélange banane avocat est délicieux! J''ai également essayé cette recette avec du lait d''amande douce à la place du lait, très bon aussi.', '2016-10-01T19:06:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19111, 18e8cdfa-2e68-4918-8464-0cab5418debe, 'Le mélange banane-avocat est très bon. J''ai mis du miel à la place du sucre et c''est excellent.', '2019-03-15T11:35:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19111, 0a9e4944-8e6c-4fb5-b969-c41bf6ffdc62, 'Pour ma part je ne mets qu''une banane un avocat 1l de lait entier 100 g d''amandes et je remplace le sucre par des dattes un vrai délice.', '2019-03-11T13:19:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19111, e3b6dc7d-b3e2-4783-b42a-39f19976300f, 'Surprenant pour moi qui ne consomme jamais d''avocat. Je n''ai pas ajouté de sucre et c''était bon ainsi. Idéal pour le petit déj.', '2015-03-13T08:24:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19111, eaa9452b-c1b6-46a0-b0d0-64c07301102e, 'Délicieuse recette ! Parfaite aussi pour utiliser des bananes que l''on n''a plus envie de manger car un peu trop noires ou molles. ', '2014-10-30T12:03:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19111, 9aa24f24-bd5f-4567-a9e9-ad8a10568a0a, 'Très bon ! Pour ceux qui ont peur de tester le lait d''avocat seul, le mélange avec la banane est une alternative !', '2014-05-10T13:29:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58917, 6634b01a-c5a6-4ca4-afde-9f5eb3674bd2, 'Alors c''est clair que c''est super bon, et super simple et rapide ! Le seul petit Hic, c''est que les fraises rendent énormément d''eau... Mais sinon excellente recette!', '2008-06-19T20:20:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73586, a7bf88e6-51e7-4935-8b88-2dcffb12ccf6, 'Délicieux ! J''ai fais découvrir la banane plantain à mes filles. Elles ont adoré ', '2021-01-31T14:04:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73586, 5de1fd10-b927-447e-9861-71cf75c9cee2, 'Recette parfaite, j’ai pris des cuisses et arrière cuisses au lieu des blancs ce qui nécessite un peu plus de cuisson. J’ai suivi la recette à la lettre pour les bananes (j’ai légèrement saupoudré de cassonade) délicieux. Tout le monde s’est régalé ?', '2019-03-09T20:52:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73586, 27a7e6b9-8ad7-4185-a85d-84ecfd874027, 'Plat très agréable, facile et tes goutu,  les bananes très bien cuites. Merci! 
', '2018-09-26T06:18:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73586, c316747d-605e-4e94-add6-ba5b4ccc10fa, 'Délicieux, facile à préparer, la cuisson du poulet était parfaite. Plat plein de saveurs sans être "piquant".', '2018-09-12T10:32:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73586, 46afc18c-4dcc-4482-90ea-b653fb6a7464, 'J''ai choisi cette recette pour les bananes plantain. C''était une cuisson parfaite, nous nous sommes régalés.', '2016-08-28T16:06:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73586, 206a5d0f-8c30-4dec-aa9d-688e49134d44, 'Pour ma part j''ai rajouté du lait de coco car je trouve cela plus onctueux.', '2016-02-15T20:07:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73586, 54a73133-a626-4e8e-b425-1ed2fdb7a712, 'J''ai dû louper une étape, nous avons trouvé ce plat immangeable...', '2013-03-25T07:57:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73586, ae21d567-5883-4efb-b1de-ef319b637340, 'Très bonne recette ,je n''avais jamais fait de colombo, la recette est facile, j''ai juste laissé mijoter plus longtemps. Mes invités se sont régalés. Merci beaucoup.', '2013-01-20T11:58:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73586, 0515032a-55f4-4921-a7fe-49e6aef19d72, 'Excellence recette ! Et facile à préparer. Mes bananes plantains étaient peut être un peu trop sèches, j''essaierai de prolonger leur cuisson à l''eau la prochaine fois !', '2013-01-13T20:04:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73586, d315015f-b3c0-475e-bd19-3184a9c3a81b, 'Très bon, on s''est régalés merci !', '2012-06-04T20:41:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73586, e92df72c-a81a-43cd-a06c-c0f29abe5b04, 'Très réussi ! Simple et super bon ! Merci pour cette recette !!!', '2010-04-24T15:50:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61087, 26941a3b-58c4-45a2-bb86-27e8d9637b3c, 'Simple et bon. Personnellement, j''ai ajouté 2 CC de sucre vanillé, mais la sucre n''est pas indispensable. ', '2012-04-21T17:16:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61087, 9fff25d2-0be7-4ee6-b28a-00cbfc6beeed, 'Bien, bonne idée mais trop sucrée', '2011-09-11T20:27:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31815, 84716a20-e7af-4bbc-95df-eb7163398dba, 'Très bon. J''ai fait la pâte à pain moi-même, en rajoutant 2 cuillères à soupe de sucre (je pense que ce n''était pas suffisant). J''ai rajouté un peu de beurre sur les bananes qui n''étaient pas très mûres, avant de faire cuire le gâteau. En rajoutant du chocolat après la cuisson, c''est bien meilleur !', '2008-03-02T21:09:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228569, b5f1008a-d429-472f-8cb2-643dfde2742e, 'Bon mais pas si exceptionnel.', '2019-12-06T08:19:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228569, 0a333b24-dd94-4c7a-90a3-6c6e805088fe, 'Sans Nutella que du chocolat, la pitchoune qui se trouve dans mon ventre a l''air d''apprécier.', '2018-01-18T23:40:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228569, 675affb4-31d1-493e-9d31-ad32af1b3322, 'Je doit être trop gourmande!! J''ai mis trop de Nutella, ça a débordé. C''est pas mauvais, mais je ne referai pas.', '2016-02-21T15:41:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228569, 58fcd6fe-0ef0-4b41-bf4a-add99b505ff8, 'Très bon ! Je l''ai faite avec une pâte à pizza toute prête. ', '2015-09-12T16:15:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228569, d6196115-197b-46fc-bf6f-418704bb39b6, 'Original et vraiment sympa, petite faim s''abstenir', '2014-03-26T23:06:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14002, ffb4c409-509b-4a1e-9ca2-32afa9be1364, 'Ne pas hésiter sur la quantité de macarons, qui absorbent le beurre fondu.', '2008-04-27T12:59:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, bfaeaf47-d3b5-4b3d-adfc-f33521d10b6a, 'Excellent ! Les enfants adorent', '2020-04-11T17:46:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 1fab768f-69ed-495f-9c50-205a267cb9f9, 'J''ai mis 5 bananes bien mûres que j''ai recouvert de noix de coco.
Pour la pâte, j''ai mis 200 g de chocolat. 
Un délice', '2019-06-30T14:00:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, b462c33d-ae84-42f7-be09-e4a4ecb8ad3e, 'Excellent simple et rapide ! Recette suivi au pas mais j''ajoute parfois un sachet de levure et je le fait dans un moule à manquer pour un gâteau plus aérien. ', '2015-08-12T15:16:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 9884780e-4beb-4afa-8337-08464f7cf3c3, 'Excellent...tout le monde a aimé !', '2015-07-10T02:19:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 1e16aeea-6d34-4fda-b60e-fd802d060c25, 'Même si mon gâteau n''a pas la même tête que sur la photo, c''est un vrai régal', '2014-10-09T16:04:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, aa3c2be5-0032-47f7-a90a-1e606770c626, 'Dur dur de faire l''hélice quand les bananes ne sont pas trop de la même longueur sinon délicieux.', '2014-05-10T23:49:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, e783be95-c389-4038-8566-b98bfc77907f, 'Étant donnée que je surveille ma ligne, j''ai mis à peine de beurre et de sucre (surement 15 g de chaque pas plus). N''ayant pas de poudre d''amande, j''ai ajouté du chocolat ainsi qu''un œuf et ce gâteau était excellent, peut être à peine trop cuit à mon goût, la prochaine fois je le ferai moins cuire.', '2012-01-30T22:05:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 5826cae1-71dd-43a3-bd79-7218dcf6eee9, 'Génial : vite fait, peu de vaisselle et surtout délicieux ! A la place d''un moulin, nous avons écrit "2012" avec les bananes et les enfants ont adoré ce "gâteau de nouvel an" !', '2012-01-02T22:54:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 4d0b95d9-86af-4c4d-a3f2-8a9839fad3e1, 'Super dessert inratable, meilleur encore le lendemain et avec un cœur fondant !', '2011-05-10T12:27:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 12e53956-dce0-4b36-901c-e5173ab2e1c4, 'Bien bon mais dur d''arriver à un moulin à vent visuel !', '2010-06-24T22:25:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 7a8a0e74-824d-4eae-82cf-61318a027330, 'Pour moi, qui n''aimait pas le goût de la banane cuite ce fut un délice. J''ai choisi les bananes pas trop mûres. A refaire', '2010-03-27T10:41:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 9fa68c9f-a569-4b0b-9c8a-d449d05880db, 'C''est une très bonne recette, suivez-la à la lettre et vous ne serez pas déçu. En plus c''est rapide alors... tous en cuisine !! Merci', '2010-03-14T20:02:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, bf2ecc87-780e-41fc-9c98-590ac9239e96, 'Recette à garder précieusement, ma fille l''a adoré! Nous n''hésiterons pas à le refaire souvent.', '2010-01-26T17:51:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 1899dc59-0a70-4b23-a976-ad4a3b273c9b, 'Excellent gâteau ! Nous l''avons ramené chez des amis, il est parti en 5 min. Je n''ai rien changé à la recette mais ai ajouté 5 min de cuisson en plus avec un four à chaleur tournante.', '2009-12-06T14:36:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, fa11898a-2b10-4ded-a77d-bcc19485365e, 'Un régal aussi bien chaud que froid! J''ai mis du papier sulfurisé dans le fond du moule et ça s''est démoulé tout seul.', '2009-02-13T15:45:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 121037f2-cd9f-46dd-8c88-b5ee8b7ced6f, 'Mariage excellent de la banane et du chocolat, et très léger.', '2009-01-03T16:21:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 8794e613-027b-4dc5-b191-29ea0681075c, 'Bon mais il faut aimer la banane cuite, alors j''ai fait la même recette mais avec des poires, excellent!!!', '2008-11-18T19:39:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, a7e0967f-3433-4423-9ddb-1fe5f984c4aa, 'Je l''ai fait tôt le matin pour le soir : pas de problème. Rechauffé au micro ondes et servi avec une crème anglaise le résultat est très bien. La feuille de papier sulfurisé au fond du plat m''a permis de servir correctement les morceaux. Goût très agréable en ajoutant de la vanille. A refaire!!', '2008-11-13T09:45:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 163f68aa-876c-4b15-a869-14fa24ca3451, 'Très bon, cette recette est géniale, c''est un peu difficile à bien ranger les bananes pour un joli rendu mais l''essentiel c''est le goût et là...aucun souci!', '2008-10-24T19:59:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 15557320-7ae4-48e1-a4e1-ca24e02fb214, 'J''adore le chocolat! J''adore la banane! J''adore la poudre d''amandes! On était si proche de la perfection que je me suis dit, c''est le moment ou jamais de l''atteindre! J''ai rajouté de la cannelle et de la vanille en poudre!!! Verdict: miam !! Par contre, j''ai beurré outrageusement le moule, mais ça n''a pas suffit pour démouler. Mais apparemment pas d''hélice chez moi, on voyait à peine les bananes par transparence... Gâteau différent et "léger".', '2008-10-01T13:26:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 049178a7-712c-462b-9b0e-8fbbeca9c3b4, 'Excellente recette! Le mélange de bananes et de chocolat est surprenant de légèreté! J''ai mis de la noix de coco à la place de la poudre d''amande: délicieux!', '2008-09-28T18:52:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 352744f8-9cdd-4a7b-82fa-0a2171105a55, 'Excellent! Ne surtout rien changer à la recette, elle est parfaite comme ça.', '2008-09-19T18:59:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 61bfc77d-f927-4d3a-a2a9-3b15e73175ab, 'Très bonne recette, qui a eu du succès et peut convenir avec d''autres fruits habituellement associés au chocolat.', '2008-09-03T10:07:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 1891f107-2a72-4d74-8ed1-5002042d1a6c, 'Excellent et très fondant, la prochaine fois je remplacerai les bananes par des poires.', '2008-08-15T15:53:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, cc6b20ea-35dd-452a-8c4e-74d21b4fe21b, 'Très moelleux, surtout lorsqu''on le déguste tiède! ', '2008-07-27T11:02:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, df3e7e8d-1ae0-4cc0-a385-d04873d07dac, 'Je l''ai faite pour l''anniversaire de ma fille (6 ans), ça a plus à tous, même a mon mari qui d''habitude n''aime pas le chocolat ! En plus c''est simple à faire !!!', '2008-04-05T20:29:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, fedf607f-4385-468c-b781-43a369b460a0, 'Très simple à faire, original, vraiment très bon....rien que du bonheur! Et en plus, en utilisant du papier sulfurisé, il n''y a aucun problème de démoulage et le gâteau est joli!!! Que demander de plus?!', '2007-11-08T12:04:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 8db3699d-3e40-4696-b1e5-d351b6b4503d, 'Franchement excellent, mais 5 mn de cuisson suplémentaires sont nécessaires dans mon four à chaleur tournante', '2007-10-04T21:17:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 4664db18-1d48-4737-b4ad-a5f42fc218ed, 'Super gouter assuré avec ce gâteau! Par contre moins de sucre, pour plus de saveur.', '2007-09-14T18:15:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 8f5e6248-d141-4f80-8ad5-e85ce41d3ed3, 'Un pur délice!!! et très simple à réaliser. fondant à souhait, léger...bref, une tuerie !!! mes convives l''ont mangé ac de la chantilly. moi, je l''ai savouré tel quel. la prochaine fois, j''essaye ac des poires ou alors je remplace la poudre d''amandes par de la noix de coco râpée. En tout cas, merci pour cette délicieuse recette.', '2007-09-02T20:20:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 67edc79e-14f7-42ab-b069-17df7c662b86, 'Succulent, un vrai régal. Le chocolat bien prononcé, et les bananes ajoutent une note fruitée et un délicieux côté fondant.  Mais ne vous laissez pas abuser par les quantités indiquées : quand on aime, c''est pour 4 personnes. Et encore ', '2007-08-10T22:21:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, e7504703-8b2d-45f8-95db-925888f82269, 'C''est vraiment succulent, moelleux à souhait et la banane très fondante. Merci pour cette recette!', '2007-04-19T23:39:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 2a3dbae6-83bc-4ceb-9aaa-c3108ce68698, 'Délicieux et facile à faire... un vrai fondant au chocolat à la banane. A mon avis, à essayer aussi avec d''autres fruits (poires par exemple). Bravo pour cette recette!!', '2007-03-19T13:26:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 214811d0-4a79-4286-b1b6-2b960ba85a53, 'Même s''il n''était pas aussi beau que la photo (je me suis trompée de sens dans la pose des bananes), c''était succulent. J''ai respecté la recette à la lettre et je l''ai fait cuire dans un moule à tarte en silicone au diamètre assez petit. Résultat : démoulage parfait, texture humide et moelleuse à souhait. Beau succès. A tester avec un peu de rhum, et avec d''autres fruits (poires par exemple), car la base chocolat est très bonne. Merci!', '2007-01-13T11:43:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 7bbd66a0-53e9-4cfa-b2f7-4a0595762c2c, 'Pas besoin de décorer le gâteau c''est très joli!! Et très bon!', '2006-12-06T18:00:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, b272fa30-ac14-4e68-9759-888422e5d582, 'Très joli, moelleux et délicieux. Par contre, mon gâteau était friable, donc c''était pas facile de faire des parts. Mais ça ne nous a pas empêché de le finir en moins d''1 journée! A refaire!', '2006-05-01T20:32:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, ab9c1fad-0074-4e2e-a009-ef7d533cbe9f, 'La plupart de mes gâteaux ne passent pas 24 heures. Celui-là n''a pas passé la demi-journée, préparé à 16h, il a été fini vers minuit... Délicieux, et je dois avouer que je l''avais fait surtout par curiosité. Quelle bonne surprise...', '2006-04-01T22:22:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, a0ce3825-f2df-4231-8d99-f888cfe99301, 'Extra! Pour les fans de chocolat! Par contre je n''ai pas réussi à le démouler... mais tant pis pour le moulin, c''est de toute façon trop vite mangé!', '2006-03-30T23:21:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 6c57afee-312a-4400-96d6-70576e9ac937, 'Excellente pâtisserie, facile à faire et délicatement parfumée. La première fois je l''ai faite pour utiliser des bananes un peu trop mûres. Il m''arrive de remplacer la poudre d''amande par de la poudre de noisette (suivant les disponibilités du placard!) et je rajoute un peu de rhum. A refaire !', '2006-02-14T19:34:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 52512b54-5a1c-42ee-baed-8bfc3e4e2b1d, 'Tout le monde adore sauf moi qui n''aime pas le goût prononcé de la banane cuite.', '2005-12-27T19:35:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 0f5ab275-1d1a-4dee-acea-389e3916d97f, 'Très beau, et très bon! Je n''avais pas d''amandes, alors j''ai remplacé les 60 g prévus, par 30 g de pralin. Miam!', '2005-12-12T22:44:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 0e37c6db-b577-4ce3-8b68-9be2ecf4eb6e, 'Parfait, un véritable délice. La preuve, mon ami en a mangé la moitié en un après midi...alors qu''il n''est pas amateur de gâteau. Très bonne recette que je conseille!', '2005-10-09T16:20:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 3dc44de0-d077-4133-87ba-8cd7cba12ca4, 'J''ai suivi la recette à la lettre la 1ère fois puis je l''ai testé une 2nde fois en mettant des poires au sirop à la place des bananes. On a trouvé ce gâteau très bon.', '2005-10-05T15:54:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, d883a357-afa6-4271-97f5-add837bb01c0, 'Très bon, mais je trouve que les desserts avec de la banane sont meilleurs chauds. ', '2005-09-26T18:54:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 53c82fe9-7d18-47c4-a51f-a085fcaa5bc3, 'Délicieux, tout le monde a adoré, même mon tout petit de 2 ans, il s''est régalé!', '2005-08-09T20:02:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, a204acb7-358e-480f-9dd5-d042cc39590f, 'Recette testée lors de la rencontre toulousaine et faite par l''auteur, et je n''ai qu''un mot: parfait!', '2005-07-05T16:37:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 40b8a6cf-6352-44c4-ba98-91793a4fe5c7, 'Très facile et très bon! Un grand succès à la maison.', '2005-05-31T10:54:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 3062f39d-bf9e-469b-b507-fefc4427b85d, 'C''est trop bon;-))) Le chocolat et les bananes sont vraiment fondants ! A essayer pour tous les amateurs de banane-chocolat !', '2005-02-22T11:52:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, be48ffa6-246e-4c45-8f1e-b29fc2641231, 'Ce gâteau est délicieux et le moulin fait son effet auprès des invités.', '2005-01-23T15:10:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 878f48ae-7fb9-4243-87f2-59d27c659434, 'Très bon gâteau, une fin digne pour des bananes en fin de course. C''est moelleux et léger à la fois, et avec un soupçon de rhum, le mélange des saveurs est parfait!', '2004-11-02T14:25:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, fecd5afa-4009-4d02-b45e-601d94fec8b6, 'Avis donné par Flora (5ans 1/2). J''ai adoré faire ce gâteau avec ma maman car j''aime le chocolat et les bananes, et en plus c''était très joli.', '2004-09-26T20:04:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, b720b989-3239-4067-a959-4d95559b649f, 'Très bon, ce gâteau est très goûtu grâce au mariage chocolat et bananes. Je l''ai fait dans un moule à tarte plus petit (25cm) mais à bord un peu haut, il était parfaitement rempli. Sur les conseils des autres testeurs, j''ai battu mes oeufs en neige. Enfin, esthétiquement, ce gâteau fait son petit effet. Je vais le refaire très bientôt!', '2004-09-03T12:26:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 09de767c-605f-4cc5-99b4-d703eff92e98, 'Hmmmm!! Excellente recette, idéale pour liquider de vieilles bananes. Je me suis permis de mettre un oeuf en plus car ils étaient petits et j''ai battu les blancs en neige ferme. Le résultat est moelleux, humide, pas si bourratif que cela. Par contre, la prochaine fois, je mettrai une lichette de rhum, je trouve que ça manque.', '2004-07-18T20:22:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 58aac160-b3ba-47bc-955e-46c7b5c0b1ed, 'J''ai testé et le goût est super, mais j''ai trouvé ça un peu lourd (tout en ayant accompagné ce gâteau avec de la crème anglaise). Peut-être que j''aurais dû fouetter un peu plus les blancs d''oeufs? Quant au démoulage, impeccable avec le papier sulfurisé pendant la cuisson. Pour conclure, je dirai... A refaire!', '2004-05-08T16:05:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 7056799d-89d2-46f9-b9c5-47639493b705, 'Vraiment très bon! Encore meilleur après 1 ou 2 jours au frigo, à mon avis... Refait pour Pâques avec un nappage chocolat noir: on perd le côté joli des bananes en rosaces et c''est un peu plus lourd, mais c''est très bon pour les accros au chocolat!', '2004-04-13T11:16:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 9ab95574-7b30-4b01-ab38-6d17d1b2f42f, 'Ce gâteau est délicieux, la pâte est délicatement parfumée à la banane. Mais effectivement, celle-ci est en proportion insuffisante, peut-être faut-il doubler les quantités ou au moins multiplier par 1,5? Pour le démoulage, papier sulfurisé obligatoire!', '2004-04-01T22:15:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 0df5e151-c28d-4a8b-9f1b-3c9490476ebc, 'La dimension du moule indiqué convient pour les bananes, mais la quantité de préparation est insuffisante pour couvrir le tout. Peut-être faudrait-il ajouter un peu plus de farine et un parfum, rhum ou fleur d''oranger, de manière à rendre la pâte amandes-chocolat plus souple? Le démoulage est périlleux: les bananes ne devraient pas toucher les bords du moule afin d''être mieux enrobées et d''être mieux prise dans la pâte. Mais que c''est bon tout de même! Ca donne envie de recommencer...', '2004-03-28T18:18:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 8865ead1-4558-4516-bb86-a69001845104, 'J''ai fait ce gâteau à la St Valentin... Mon mari a tout mangé, nous avons adoré!', '2004-03-20T15:49:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, 8c70ac08-eaae-47b1-abe0-4350ae0a5ff2, 'Tout le monde a adoré ce gâteau étonnamment léger qui sort de l''ordinaire.', '2004-02-28T11:25:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20462, a4417ec1-09ae-49e6-bed0-cb0661f79bcb, 'C''est bon. En effet l''association banane-chocolat est très bonne et malgré toutes apparences ce n''est pas lourd. En plus c''est joli! A refaire. Attention au démoulage...', '2004-01-19T18:22:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31132, 7fcb5f54-bca4-49e4-959e-c6bd9fd2f6d5, 'C''était très bon au goût, et même ceux qui m''ont avoué après ne pas aimer le sucré-salé, en ont repris!!! Par contre, c''était un peu gluant, et la préparation est longue et fastidieuse ( faire les gnocchis un a un, et les décoller ensuite les uns des autres, nous a pris un après-midi à deux) Mais c''etait très bon!', '2008-04-10T20:57:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31132, 31cfa5b2-08fd-44e7-be32-74fc1a6585b0, 'Moi aussi j''osé et quel regret!!! Tout est parti à la poubelle...C''est peut-être tout simplement une question de goût donc si ça vous tente, testez...', '2007-01-14T11:49:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31132, 91b27934-e473-4d9d-8ed2-346419afe7b4, 'J''ai osé et je ne l''ai pas regretté! Avec un peu de curry et gratiné au parmesan, c''est un plat original et délicieux! Idéal aussi pour utiliser des bananes un peu mûres.', '2006-05-04T21:13:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22030, faa44849-54e7-470c-8584-1aad74042f24, 'Délicieux avec de la sauce au chocolat ', '2021-05-09T08:28:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22030, 5d8e2041-174d-49e0-8ca2-4d7c52d0e8c9, 'Très bonne recette appréciée par les petits-enfants mais à sortir du congélateur au moins 4 heures avant car elle est meilleure - pour nous - en mousse froide.', '2016-11-13T11:51:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22030, 14adbd67-fa36-400b-a3d9-812ec52c537a, 'C''est délicieux. Un dessert léger. Sur le dessus j''ai ajouté du chocolat en poudre.', '2012-12-31T20:30:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22030, 7f5ac072-ce98-4be0-b18f-42b5713727c9, 'C''est très bon mais un peu trop sucré je pense. De plus je rajouterai de la gélatine pour que la mousse se tienne mieux car je trouve qu''il vaut mieux la manger "fraîche" mais pas encore congelée.', '2007-07-06T19:48:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22030, 594c9e0f-2fed-4420-b9dc-cab567ff5b95, 'Avec quelques copeaux de chocolat pour la décoration et deux feuilles de gélatine dans la crème de banane pour une texture plus solide, elle a fait l''unanimité! On peut réduire la quantité de sucre pour mieux savourer le goût de la banane.', '2007-01-22T10:26:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22030, e55db6d5-f772-4a2a-b7c1-4a653b7a550d, 'Trop top, l''acidité du kiwi avec la douceur de la banane! Je conseille vivement de déguster avec le coulis...Merci pour cette recette simple et délicieuse.', '2006-09-25T11:36:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22030, efc6e75d-6c75-401d-b631-4e5680166153, 'En suivant scrupuleusement toutes les indications + les commentaires, j''ai quand même été déçue : pourtant j''aime le citron, les bananes, la mousse et la glace mais ensemble...bof :o(', '2006-09-09T14:01:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22030, b26765f3-0e02-49cb-93f0-4f3990793d13, 'Je fais cette mousse depuis des années mais... au citron! La seule différence est que je mets un peu plus de jus de citron et pas de bananes.  C''est super bon, rapide, léger et original.  Super facile pour les goûters d''enfants. ', '2006-08-07T17:58:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22030, cc43ea9a-c6ee-441f-8c8e-dae6df4077d3, 'Le dessert a été apprécié, je l''ai fait la veille et mis au congélateur comme indiqué, par contre j''ai été obligé le lendemain de le sortir du congélo 4 heures avant le dîner car la mousse était de la glace...j''ai peut-être raté une étape ?!', '2006-04-02T22:50:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22030, 811f8c4a-40ae-4b8c-bc80-b6c7e432df3b, 'J''ai essayé avec un coulis au chocolat chaud : 150 g de chocolat pâtissier (4 pers), et du lait dans une casserole, remués consciencieusement. Le contraste du chocolat frémissant sur la mousse glacée est une réussite!', '2006-02-28T10:46:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22030, 00900e61-c03e-4995-9e9a-908a6e089ac0, 'C''est un délice! Tout le monde a adoré, petits et grands.', '2005-11-17T19:09:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22030, 77ff4989-c38d-4544-bf25-cb87295bc940, 'Si facile et délicieux. Un dessert à faire pour le lendemain et à présenter dans des petits ramequins, c''est plus jloi!', '2005-05-08T14:42:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22030, 91d7f85f-c39d-45bd-a80f-beb6df527b84, 'Tout le monde a adoré. J''ai remplacé le lait concentré non sucré par du sucré (sans mettre le sucre en poudre). Cela marche très bien comme ça et on m''en a redemandé. Merci!', '2005-01-31T18:35:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22030, 108b1c4c-c979-4c52-a47c-d66caf19c6a9, 'Dé-li-cieux, oh oui je n''ai eu que des bons échos de cette mousse légère et qui finit parfaitement un repas. N''ayant pas de place, j''ai mis certaines ''mousses'' au frigidaire, cela en a fait des sortes de milk-shake que certains ont même bu à la paille! Pour les quantités, avec 6 bananes au lieu de 4, cela fait un dessert pour 10 personnes. Attention à ne pas mettre trop de citron!', '2003-08-26T13:21:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50797, aa0e489e-b337-4520-a4b5-6fe3c937925d, 'Très bon mélange de fruits. Je l''ai réalisée avec du vitpris plutôt qu''avec du sucre à confiture et j''ai ajouté un petit verre (à moutarde) d''eau pour la cuisson. J''ai écrasé la banane avec une passoire à gros trous ainsi, elle était bien répartie dans la mûre sans vraiment épaissir. A refaire dès que possible !', '2013-08-26T19:45:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50797, 5868f6a6-22c0-425e-a7aa-54f53b6363e5, 'Excellent mélange mais faut ajouter pas mal de liquide sinon c''est une compote très épaisse.', '2010-10-29T14:42:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20788, 45d0b1c0-659a-479c-8cd0-29ade5ea0308, 'Bonne recette, j''ai remplacé la crème par du fromage blanc que j''avais en trop. Juste un peu trop sucré à mon goût : je ferai mais avec moins de sucre', '2009-03-22T18:41:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20788, e3b00a81-cc67-46b1-b7e1-3d2419410eb8, 'Tarte délicieuse, je n''ai pas mis de poudre d''amande car je n''en avais pas. C''était très bon comme ça, surtout à la sortie du frigo pour l''été... miam miam.', '2008-07-11T13:08:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20788, 721b8bf1-4658-4daa-8a3d-f41b20af9f83, 'Bonne recette, je l''ai faite avec une enfant qui n''avait jamais cuisine : simplissime. A refaire', '2007-09-25T01:02:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347901, cc22ddff-72bc-4c62-ab44-9cc37230ef7c, 'J’adore c’est délicieux 😻👍🏽', '2023-03-12T17:05:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35227, b173ef79-0e43-41d3-b721-a1cf72a492c6, 'Je mets seulement 3/5, car les mesures ne sont pas assez explicites. le gâteau était un peu gras, la prochaine fois, je mettrai moins de beurre. Sinon le principe banane-cannelle est excellent!!! Le parfum de la cannelle est très agréable, que ce soit au goût, ou à l''odorat! Merci pour cette recette...', '2005-12-07T17:18:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35227, 97c9b58a-f409-4f92-9326-b24fb9930c93, 'J''ai suivi la recette à la lettre, mais la pâte me semblait très épaisse. Peut-être est-ce que ça doit être le cas ? Bref de peur que ce soit compacte, j''ai ajouté du lait et un peu plus de crème fraîche. C''est un régal, et ça sent la cannelle dans toute la maison!', '2005-09-14T16:47:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, b234feb9-1756-4585-b1af-2b1c9306ec7f, 'Premier crumble et ce fut une réussite !! ', '2015-09-09T13:13:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 0b104bd7-855e-40ed-bb54-6b53c6f79984, 'Très bon. Servie tiède avec crème pâtissière. ', '2014-06-04T19:11:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, a4aae3f1-969a-4cff-b754-2020d4320891, 'RECETTE DELICIEUSE. Mon premier CRUMBLE. Seulement 2 bananes, à compoter dans le four avec un peu de cassonade, puis les pommes avec 2 cuillères à soupe de miel, saupoudré de chocolat râpé juste avant la fin de la cuisson, servi avec une boule de glace vanille à l''ancienne. DESSERT DE ROI !! Merci !', '2013-11-24T15:56:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 9aa83120-81d9-4775-a3c6-645f0cab6077, 'J''ai fait cuire les fruits à la poele avant avec de la vanille. Excellente recette. Merci.', '2013-02-19T23:22:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 64892299-ec54-4dd8-816a-a6159d34c0ed, 'Premier crumble pour moi aussi et réussi. Merci à vous !', '2013-01-16T20:05:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, cbb7866d-add0-498b-9e27-4451a1c9ec90, 'Bon dessert mais pas transcendant ... peut être trop simple à mon goût, j''ai ajouté de la cannelle. Et puis surtout : ce n''est pas un dessert pour 4 personnes mais pour 6 voire 8 ! ', '2012-12-03T15:15:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, bfeeb750-52a6-45ef-89ff-9f7dc9935c1a, 'Excellent !', '2012-12-02T14:04:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, dbf2c609-6d8c-4636-a368-11b875be1889, 'ce crumble est vraiment très bon et facile à faire.', '2012-11-15T15:52:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 5175bf0c-1825-4ba2-9fb4-fcfe6e5a49d5, 'Bon dessert accompagné d''une boule de glace à la vanille. Mes invités ont apprécié ! ', '2010-03-14T18:23:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 9fb17feb-b09e-4313-9a77-51cf87436afd, '1er essai de crumble : très réussi. Temps pour faire compoter les pommes et les bananes, plus long (15 + 15 + 15mn), nous avons avons "écrasé" à la fourchette après le 2ème temps au four et avant de mettre le sablage. Un peu long mais cela valait la peine de patienter.', '2010-01-12T15:16:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 9126a533-3dc2-4da2-aa84-8a71ea05f4d1, 'En tant que débutant en cuisine, j''ai parfaitement réussi cette recette très simple. Pour ma part j''ai ajouté 2 clémentines qui donnent un peu d''acidité et j''ai mis du calvados plutôt que du rhum. Délicieux!', '2008-11-16T14:39:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 94150b3e-1480-4fbb-bdbc-c6c88558f4fd, 'Très bon mais un peu long à préparer.    A la fin, il faut rester à côté du four sinon ça brûle .          ', '2008-06-01T16:17:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 2c87d6dd-b4e8-4619-9ee3-9f630d11eda5, 'Enfin une pâte de crumble qui est normale... Super le crumble a fait l''unanimité... excellent!', '2008-05-30T05:04:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 2641a968-7efc-488e-833d-e8578a193e12, 'Très bon et facile à réaliser ! Merci pour cette recette !', '2008-05-02T18:03:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 8199c213-0b98-477a-9094-3846382449e0, 'Je vie en Martinique donc ici beaucoup de bananes. En tant qu''alcool, j''ai mis que du rhum & à la place de la poudre d''amandes, j''ai mis de la poudre noix de coco ; très bon!!!', '2008-02-13T15:52:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, d19f0482-cf75-47a4-89ec-009cb50c71d1, '1)simple à réaliser. 2)Rapide. 3)La prochaine fois, je vais rajouter des abricots.', '2008-02-06T22:01:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, e4971209-69e5-4ecf-9964-81032d1a4d4d, 'Excellent le mélange pomme banane.  Je n''avais pas de poudre d''amande, donc je l''ai remplacé par de la farine. J''y ai ajouté des raisins (trempés dans le rhum). Et j''ai fait un caramel à la creme fraîche à ajouter par dessus avec en accompagnement une boule de glace au chocolat. Tout le monde a adoré.  Une recette simple que je referai. ', '2007-05-24T21:04:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 10dd5c61-9577-4192-8fea-b8186c6e718f, 'Excellente recette de dessert. Le mariage de la poudre d''amande avec le reste est vraiment délicieux. Tout le monde à adoré. Par contre, je n''ai mis que du rhum comme alcool.', '2007-01-17T18:51:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 468d8547-f2f0-4c88-ba1b-596e6fdd2f21, 'Proportions bien suffisantes pour 6-7 personnes. J''ai remplacé l''anisette par une boisson anisée sans alcool. Excellent: tout le monde a aimé.', '2006-12-28T18:00:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 908b621e-3b0f-4a97-b193-6d33ba21a895, 'Très bonne recette, la pomme et la banane se marient bien et ça a plu à toute la famille! Je n''avais pas de Marie Brisard ni de rhum, j''ai mis du Cognac (mais moins!) et c''était très doux quand même. Un régal, expérience à renouveler! ', '2006-11-05T18:41:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, daf678be-295b-4001-b1d6-18c5bc5f9802, 'Très bon, j''ai 14 ans et c''est mon premier crumble. Toute la famille a adoré, délicieux, simple, et les ingrédients sont faciles a trouver !!!', '2005-05-03T15:26:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 6860ae31-ead3-4e60-bc40-345913f37559, 'Pas mauvais, change des crumbles aux fruits rouges et aux pommes.', '2003-03-06T11:18:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 96e5f128-ec64-4d66-892b-65670b72af47, 'Délicieux, le fait de laisser le mélange pendant une heure reposer donne un aspect croustillant lors de la cuisson au crumble. J''ai rajouté des pépites de chocolat.', '2003-03-05T09:26:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, cc0b9dc0-39fe-49e2-8f58-81ce3e21aba8, 'Très bon, même si j''ai évité l''alcool et ajouté de la cannelle. Avec une glace à la vanille...', '2002-12-26T11:45:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 196e03c5-ef31-4c41-baeb-6013ddc1c2f4, 'Très bons, même si je n''ai pas mis d''anisette ou de Marie-Brizard.', '2002-11-14T10:33:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, d71551e1-5390-4ce6-ac77-d6a8d08af945, 'Excellent! Une texture très réussie pour un dessert au goût équilibré et savoureux.', '2002-07-28T17:05:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13850, 85fd1ff1-2133-4174-80fe-b13713a05bff, 'Très bon mais je préfère le mélange farine/sucre au mélange amandes/sucre, plus croquant.', '2001-06-05T13:19:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16998, ad125a10-a281-49b5-a6cb-e2d5ac3eb4df, 'A refaire mais sans la boîte de coulis je trouve que ça gâche tout le goût du curry et de la coco. Très bonne recette comme même. Merci.', '2020-09-02T22:10:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16998, 56abbfe1-3884-48c6-ae9f-d789bc66d591, 'Très bonne recette ', '2019-05-21T11:37:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16998, a081f4aa-483c-4623-8ed3-927e340311fb, 'Très bonne recette facile à faire tout le monde a apprécié.      facile à faire plat très apprécié', '2016-11-03T15:45:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16998, ae2d57f0-3ae9-4269-8d66-18f777aa9f73, 'A la place du curry, j ai mis de la poudre de Colombo, c''est délicieux.', '2015-05-14T14:12:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16998, 4cd292b4-0f01-4d99-99b2-c7b91acef8f1, 'J''ai fait ce plat avec des manchons de dinde. Tout le monde a aimé', '2015-01-21T16:09:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16998, cc1d67cb-2dfb-4368-a850-48b1c3f29946, 'Absolument délicieux. ', '2014-06-28T16:52:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16998, 8d580c80-63c6-4dbc-92e9-94757e1f0c03, 'Bon, facile à préparer, léger et très coloré. Une réussite.', '2014-03-31T12:34:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16998, f1cc277a-f463-4290-8262-d916e4488070, 'Un plat délicieux, je le sers lorsque j''ai du monde et je n''ai encore trouvé personne qui n''ai pas aimé çà !  Très facile à préparer à l''avance, il se réchauffe très bien. Et pour un repas délicieux, cela permet de mettre ensuite un dessert un peu moins léger tel un bon fondant au chocolat. J''ai eu aussi l''occasion de le réaliser sans les yaourts pour une personne intolérante au lait. La sauce est moins crémeuse mais tout aussi délicieuse ! Petite astuce pour les poivrons, je prends du surgelé, petits pois en boîte (une petite suffit) et aussi mangue en conserve (et bien oui, pas le choix parfois) ! Donc un vrai 5/5 ! ', '2010-06-01T12:29:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16998, fea4250a-d3df-421f-9e96-7fbcc4d989e1, 'sublissimo, superbe recette trop facile et trop bon, milles merci', '2010-02-26T10:38:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16998, 67fd72a0-b8d5-476d-ab84-3fcb0eab558c, 'Excellent ! J''ai mis un pot de saint Moret pour enlever l''acidité des yaourts et ai ajouté 1 petite cuillère de cannelle, gingembre, cumin puis des noix de cajou et des raisins. A faire et refaire, les invitées sont reparties avec les restes !!! (j''avais vu un peu grand )', '2009-01-30T18:17:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16998, 20f4bdbf-85df-48bb-8e82-eb4f44130a2d, 'Original et joli dans l''assiette, c''est un plat agreable à manger. Merci. ', '2008-09-21T19:36:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16998, 37cb2673-9b8f-4f7b-a13a-b640dfa8833a, 'Bravo! Les recettes aussi simples, diététiques et saines sont beaucoup trop rares. On parle tous les jours de gens obèses et on ne fait rien pour y remédier ou simplement pour varier le quotidien des gens "moyens".', '2006-06-09T15:15:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169445, d5ebc7e5-fccb-460c-96fa-4370f5d392ff, 'Joli mais fort ! On a remplacé le jus de banane (pas trouvé en magasin) par du jus d''ananas.', '2014-02-22T14:49:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169445, 7b18cd72-3617-41b1-8ff1-5c57408f8a05, 'Parfait pour un apéro ', '2015-07-29T21:26:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169445, 9156d488-a1a4-4dd6-8728-0434c08ea5c7, 'Excellent !!! Petit conseil de préparation : frapper la vodka, le jus de banane et la curaçao dans un shaker avec de la glace, verser dans un verre et allonger ensuite avec la limonade, pour un résultat bien frais !', '2014-02-01T16:21:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169445, b3541579-db3a-4813-9bf9-c25d1f16b990, 'Trop bon, on a adoré, merci', '2013-11-24T20:37:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169445, a164b14c-1143-46ea-9d10-576f4acdb0dc, 'Très bon cocktail réalisé avec du jus de poire : goût moins original.', '2013-01-08T23:15:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169445, 938e3e96-034b-4d04-b64a-66d179d4a374, 'Très bon !!! Ca change des cocktails avec de la limonade et on sent bien le jus de banane. ', '2012-11-01T19:36:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169445, 7849e598-940e-4477-a091-c68322401724, 'Tout le monde a adoré !', '2012-09-01T02:08:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169445, 65b582ba-9484-4415-86b7-9e3847fbd599, 'On adore tout simplement et un grand succès lors des apéros ! Bien frais... Miam ! ', '2011-06-17T20:42:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169445, 2cb04ee9-8171-440b-b0f5-9e05a6608e33, 'On fait souvent ce cocktail à nos apéros étudiants et on apprécie toutes ! Ça change !', '2011-05-08T10:41:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169445, cb8b2fa4-7be3-4952-8fcf-406fd3eef769, 'Le goût est très particuliers. Il faut aimer ! ', '2011-02-19T19:15:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169445, 49868b88-f5dc-400b-b50e-8d34f0dc5c5d, 'C''est joli, c''est bon et ça change des cocktails habituels ! J''ai ajouté dans chaque verre deux bonbons bananes. Et on peut faire le préparer à l''avance pour plusieurs dans un saladier et verser la limonade au dernier moment.', '2010-11-15T13:24:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67701, 87245601-2735-4f0c-afbc-2aee1712105c, 'Je connais cette recette, mon mari nigérian nous la prépare de temps en temps. Un peu calorique, mais ça cale bien quand on a très faim !', '2013-03-20T18:30:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, fe90f344-06d0-4713-9103-88ecef17fc13, 'Très bonne recette, un peu lourd mais délicieux.', '2019-11-26T14:15:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, 0f0f0ed8-60a9-4fc5-84ac-2946757b4878, 'Pour une version plus légère j''ai remplacé le mascarpone par du yaourt (c''est tout ce que j''avais dans mon frigo) mais à mon avis du fromage blanc aurait été encore plus adapté. j''ai adoré cette la marmelade de bananes, en même temps je suis une fan de banane sous toutes ses formes :) ', '2015-02-14T11:34:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, 19d82369-1a6e-47d2-a94d-7cb8a664ef29, 'Je n''aime pas la banane en général mais là j''ai été séduite et mes convives aussi. ', '2015-02-08T20:05:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, dd4c701a-b9b6-4ba6-96da-a2ab43b0b31b, 'On n''est pas vraiment fan. Trop lourd, trop pâteux. Bof bof. ', '2015-02-04T19:51:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, 7b5a09b3-221e-46d8-a7e1-2f1b62a98cd3, 'Galette lourde mais vite fait. Meilleure quand il s agit de vraies crêpes sur une billig bretonne', '2015-02-03T20:26:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, 1b21ab1d-d64b-42d9-a9b2-25f1f37e33e9, 'La vache ! C''est de la crêpe ! ', '2015-02-03T10:02:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, b7f9f2ab-657e-48aa-8728-78175df91ff5, 'Les enfants et les grands se sont régalés !', '2015-02-02T19:40:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, b203be49-e4ba-4d4c-9994-0955a1502894, 'Vite fait, bien fait !', '2014-10-20T09:41:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, 2316c151-6523-4b13-a0a1-b473f161b846, 'J''ai adoré mais par contre j''ai trouvé ça lourd.. j''ai peut-être abusé sur la mascarpone ^^'' Perso j''ai encore préféré les déguster le lendemain.. très bonne recette.', '2013-03-12T15:25:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, 1a887f9e-2a99-4cab-a4f2-54c9185fa407, 'Facile à faire, vite faite. Mais deux par personne cela est suffisant et à manger le midi plutôt que le soir mais je les referai !  ', '2013-03-04T20:39:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, dfceb974-8d15-4ac3-a632-226a04dbbba3, 'Recette adoptée, les enfants ont adoré.', '2013-03-03T18:37:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, 5fb65afe-7aa7-4669-8f43-a8cfbce8863b, 'Très bonne recette, à refaire sans hésiter !', '2013-02-21T21:51:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, b6c42910-edbf-491d-a884-a5e42c6dbc87, 'Étant allergique aux bananes, je les ai remplacées par des pommes. Tout aussi bon ! on peut également utiliser des poires... !', '2013-02-21T12:20:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, 525085de-db51-444a-8095-544597be6b57, 'Elles sont trop bien, mon papa a adoré. Merci beaucoup !', '2013-01-03T19:33:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, 3452f353-5a65-4d75-8ac1-5c2e01fdb667, 'Elles sont superbes !! Je les préfère tièdes, même sans chocolat !! Hhummm... Merci !', '2011-01-11T14:44:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, e35cd0c9-201d-4130-9ad2-08555b84521d, 'Dégustées également lors de la rencontre lorraine, et refaites pour mes petits fils lors d''un goûter..gros succès! Ils ont dévoré! :-) Merci pour cette recette simple et délicieuse!', '2006-09-14T20:23:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42851, 8f810a3c-0167-4c7b-ac37-9930f344b4cd, 'Goûtées lors de la rencontre lorraine. Ont fait l''unanimité dans la famille. Merci Dirda pour cette excellente recette.', '2006-05-29T16:43:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57137, c4f1fcba-738b-456e-85dc-e29a59d1625a, 'Merci pour la recette, c''est facile et rapide a faire, mes enfants m''on aider par contre j''ai mis 200 grammes de chocolat et 1 yaourt, 10 mn à 180°c pendant 10 mn avant de rajouter mes tranches de bananes et remis 25 mn, le gateau est moelleux et le chocolat reste un peu coulant.
', '2020-06-27T22:29:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57137, 3540dc51-df92-4852-a9bb-11b0f9a4d790, 'Gâteau très bon. J’ai mis deux bananes écrasé (car trop mûre) directement dans la préparation et deux autres couper en rondelles au dessus. J’ai mis de la crème fraîche à la place du yaourt et une tablette entière de chocolat. En délice 🥰', '2023-10-13T13:09:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57137, 1c37b580-1047-4c79-9dba-82d646d56070, 'Très bon gâteau 😋 comme je n''avais pas de yaourt nature j''ai fais avec du yaourt à la vanille : exellent !!! Je l''ai laissé cuire plus longtemps ', '2023-08-29T21:30:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57137, 3aaea2dc-fb4b-42b7-8c9f-e2117fcc54c8, 'Une bonne recette, mais j''ai été déçue car je trouve qu''on ne sent assez ni la banane ni le chocolat. La prochaine fois, j''augmenterai la dose de chocolat et je le ferai cuire moins longtemps (à 180/200°C)', '2011-02-06T12:54:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57137, 78b52bee-3959-40c8-ac28-ffadb02b1d12, 'J''ai bien aimé le mélange banane chocolat, avec une bonne crème anglaise c''était pas mal du tout. Toutefois, j''ai effectivement du augmenter la température (180°) car ça ne cuisait pas du tout. La prochaine fois j''ajouterai aussi un peu de sucre ou du rhum pour relever le goût.', '2009-08-14T10:50:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57137, 3d4418a2-ebb0-4255-b293-98bf2229a9c0, 'Très bon et très léger, super simple à réaliser. Merci pour cette bonne recette.', '2008-12-04T12:29:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57137, 9f791175-b9b7-4137-ad0b-0692936dcaef, 'Pas mauvais mais les bananes (même apres avoir suivi les indications) tombent dans le fond du gâteau et le gâteau est donc bien difficile à demouler. A réessayer et laisser cuire un peu plus peut être.', '2008-04-11T16:38:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57137, 5435ebd8-dd78-4d5a-8b20-94e7c9999ba0, 'C''est une très bonne recette (et plutôt simple!!)! Mais j''ai seulement quelques petits détails à ajouter !! Le four doit être un peu plus chaud !!  Détail personel : La Déco : moi j''ai fait un glaçage au chocolat (chocolat fondu) et après, j''ai découpé en rondelles une banane et j''ai disposé ces rondelles sur le glaçage !! C''est très beau et c''est tout autant délicieux !!!  MERCI pour cette recette !!', '2007-10-21T14:00:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57137, 6f29bfe1-d6c3-4866-9644-b997e2a18fde, 'Comme annick j''ai rajoutée de la craime fraîche à la place du yaourt c''est divin et j''ai même rajoutée de la noix de coco en poudre dans la pate et ce gâteaux à la fin est excellent regalez vous ', '2007-10-04T19:01:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57137, a70fba1e-833d-4607-a529-9518fd68d48c, 'Très bonne recette, le gâteau est bien moelleux, je l''ai réalisé avec de la crème fraîche à la place du yaourth, on s''est régalé!', '2007-09-14T17:54:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58714, 4336b716-f7b2-4d3d-b68f-3013c194860d, 'J''ai suivi les conseils et utilisé des palets bretons. Ne pas hésiter à laisser un peu de caramel sur les bananes sinon c''est un peu sec. Du coup, un peu de sucre vanillé dans des petits suisse nature c''est suffisant. Très bon, facile et rapide !', '2016-11-16T20:18:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58714, ddecf1fc-4d48-46cc-88ab-f6dfa703f3f8, 'Très bon et très jolie présentation', '2010-10-28T01:24:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58714, 45f5b7b3-38d1-47bb-9146-06f9a6c1e740, 'Très bon et très facile! Par contre j''ai utilisé des gâteaux bretons, ce qui était très bon également. A faire et à refaire !', '2008-03-09T21:49:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58714, 0ca084f5-4e4b-42a8-a1de-4f000fe9dac4, 'Pas mal mais il faut mettre plus de bananes dans la verrine que de gâteaux (les palmiers n''ont pas trop de goût, préférer des gâteaux bretons ou à la noix de coco) Merci pour cette recette.', '2007-11-25T10:34:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62104, 5fa99c40-d055-45a2-8f2c-4dceeb254a34, 'C''est super bon !', '2014-09-10T14:06:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62104, d6ea3a69-e7f1-42cb-878d-15cd975d5a47, 'C''est assez spécial, il faut aimer le sucré-salé ! Mais c''est tout de même pas mal, on oserait pas faire le mélange mais j''ai bien aimé. J''en referai certainement !', '2011-05-17T00:21:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212057, 4c1872e3-d252-4e74-9fb1-2f577e4e8ae1, 'Super bon', '2017-05-14T20:42:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212057, 68e19316-84cf-4693-b2b0-2ec0f2489746, 'Succulent. Les gosses ont adoré et ma femme qui n''aime pas la glace m''en redemande.', '2011-09-04T22:08:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15086, 3cb0f72c-dd41-40ae-ba6b-d15dcf4984f8, 'Je découvre les bananes plantain avec cette recette que j''ai faite avec de l''huile "classique", et j''en suis très satisfaite ! Je l''ai faite avec du riz, et pense la refaire la prochaine fois en rajoutant du poulet afin d''augmenter la proportion d''éléments salés dans le plat', '2015-05-28T23:07:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15086, 5c67ffe6-4c42-49ec-b34c-f864513afce0, 'Superbe superbe superbe! Très bon, très simple et encore une fois, très très bon!! Merci pour la recette! La seule difficulté est de trouver des plantains, ou des grosses bananes... car avec les petites, ça brûle vite, on arrive moins facilement à la texture attendue.', '2008-09-27T01:32:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15086, 5dc73ebc-ec19-4d37-b86e-f2d03cda5824, 'C''est également un plat camerounais, avec du bon poulet braiser et du riz, c''est excellent!', '2008-04-18T21:18:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15086, 22d6c7c8-183f-4557-a000-beb3a3a1ce10, 'Typique plat ivoirien, appeler ALOCO. On le déguste avec un bon poulet braisé (ou sinon un poulet rôti fera l''affaire). Recommander pour ceux qui ne comptent pas leur calories!  ', '2007-12-29T14:58:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15086, 218cf2b9-aeb7-48ad-b33b-3e0b9f858d15, 'Super bon! Les bananes sont bien dorées c''est un régal. J''ai bien épongé sur papier absorbant après la cuisson et j''ai salé les bananes. En revanche je n''ai pas utilisé d''huile de palme mais de l''huile pour friture classique.', '2007-07-19T13:36:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15086, 8ad4fb45-d41a-439d-b4a9-fc7a32d0cffe, 'Je coupe les bananes en tous petits morceaux et je les "égoutte" sur du paier absorbant après cuisson... miam !', '2007-07-11T19:41:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15086, 6ada6d08-53d4-4d05-bfec-abf27ffeea30, 'Rien de meilleur surtout accompagné de sauce au pili-pili !', '2004-12-22T20:52:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15086, b4fa0756-f6b4-447b-8d0b-b1d995d6dec5, 'On peut réaliser cette recette avec n''importe quelle huile végétale. C''est excellent !!! Attention cependant car, sucrée, les bananes grillent vite ! ', '2003-09-01T19:37:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530231, bda347d6-da6c-424c-9b5a-00b7d56942fa, 'Très bon c''est un régal pour ce qui aiment les plats épicés ', '2022-01-27T01:49:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336035, f0f118e5-8106-435f-8664-6b1dbad178b2, 'Miam! Un gâteau délicieux. Je n''ai pas mis de bicarbonate et c''est franchement très bon sans. J''ai coupé la banane en petit dés et je ne regrette pas. Franchement, top! ?', '2020-04-12T18:03:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336035, 269d980b-1fd9-46bf-bb52-b596f720819a, 'Cette recette est très bonne est super moelleuse mais attention la personne qui a écrit cette recette s''est trompé ou n''a pas été claire dans les mesures de bicarbonate de soude ! Il faut mettre une demi cuillère à café, surtout pas plus ! Je pense que les mauvais avis viennent de cette confusion, car le bicarbonate est comme la levure, on ne peut jamais en mettre qu''une petite quantité.', '2020-02-26T14:21:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336035, b6459f2f-97bc-4f86-8318-4184302a2d87, 'Gâteau immangeable, impossible à cuire et je crois que le bicarbonate a tout gâché !', '2019-03-24T16:23:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336035, 8290568b-9d1d-46c6-9f5d-125a76e2ff26, 'Wow je suis bluffée par cette recette ! J''ai suivi exactement la recette et j''ai fait cuire dans des plus petits moules à muffins, ça ressemble a des soufflés c''est aérien, super moelleux. Merci pour cette recette !', '2019-02-18T09:36:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336035, 57513554-fcdf-416e-b408-7bf02d079a9b, 'Gâteau difficile à cuire au goût très peu prononcé. On ne l''a pas terminé.', '2017-06-10T17:41:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336035, bc5123eb-cb00-4f94-bf3e-075356f6b24a, 'Je n''ai pas utilisé de chocolat mais ajouté de la noix de coco râpée. J''ai gardé les proportions tout en remplaçant le lait par du yaourt (1/2), c''est délicieux.', '2017-04-11T04:01:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336035, d985a284-ed6b-4df8-8014-98f90ab66874, 'Délicieux ! J''ai réduit le sucre de moitié, tout le monde a aimé.', '2017-03-06T18:11:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336035, fadf9d45-aaf4-44c0-a429-b7aea52745b9, 'Super bon, moi qui n''aime pas la banane cela se marie très bien. J''ai testé avec et sans la banane, une tuerie. Par contre sans bananes j''ai mis 200 g de chocolat noir. Merci pour la recette.', '2016-09-30T14:14:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 9ab33038-1e7b-4226-a012-d06e1a5fabbb, 'Delicieux et simple. J''ai beaucoup apprécié cette recette et l''ai refaite plusieurs fois ! Juste, je mets la banane en milieu de cuisson comme décrit dans d''autres commentaires.', '2021-03-03T14:40:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, b7cae864-98c1-489e-96c7-be59760097b8, 'J''ai ai adoré cette recette ! C''était vraiment bien. (en plus j''ai aidé maman à la faire. Elisa) ', '2017-02-22T20:42:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 791092dd-144a-4a23-9685-f51a787b4650, 'C''est excellent ! La prochaine fois je doublerai la dose de fruits. Ma fille a adoré. ', '2016-06-25T00:16:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, c2dae805-82c2-4611-8523-38de4dd559bf, 'Il manque un peu des épices que j''ai rajouté puis effectivement ai mis la banane en fin de cuisson, c est pas mal mais un peu trop liquide à mon goût!', '2014-11-16T14:19:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, b94a6442-14bf-466b-bd8c-9e8eda240150, 'Très bonne recette appréciée énormément par mon mari et les enfants. Ne pas hésiter à ajouter un peu d''eau plusieurs fois au fur et à mesure de la cuisson pour que ça n''attache pas. Mettre le double de quantité de pommes et de bananes. Mettre les bananes à la moitié de la cuisson (mais elles se démontent un peu quand même). Ne pas hésiter à ajouter une bonne quantité de raisins secs. Ne pas oublier de faire griller les amandes et de les ajouter au moment de servir, ça apporte un vrai plus. comme les bananes se démontent pour la présentation il suffit de faire un puits de riz dans chaque assiette et de mettre la sauce au centre avec les amandes au dessus. Ou deux dômes un de riz avec les amandes et un de sauce. Cette recette est également très bonne avec du boulgour ou des céréales méditerranéenne de chez Tipiak', '2014-11-02T17:28:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, b1d0c5bd-35bf-41da-9c64-bc8cf7da8287, 'Très bon mais la prochaine fois, je diminuerai un peu la dose de curry. J''ai ajouté un peu de piment, extra.', '2011-09-21T18:08:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 6b8161cb-f293-4d1f-879a-06860e543fb2, 'Bof ! C''est bon au goût (j''ai aussi ajouté des raisins secs, c''est d''ailleurs ça qui a donné le plus de goût). Mais la texture eau + farine c''est vraiment pas top !', '2011-05-28T15:19:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, a24c8cf6-edda-45a3-92ef-7b7ac9591172, 'Je l''ai faite hier soir, vraiment excellent. Très agréable au goût et facile à préparer. Ma famille a adoré. Merci.', '2011-02-09T17:49:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 9b5779c9-836a-4ec7-9a02-958730c1c97b, 'Bien mais j''aurai du suivre les commentaires et ajouter les fruits un peu avant la fin, ils avaient fait de la bouillie et perdu du goût !', '2011-01-29T14:44:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 271a7bd0-ffcf-4d8f-8896-b21c1cd1f9db, 'Extra - recette suivie à la lettre et c''était parfait - j''ai zappé les amandes à la fin je n''en avais pas - juste peut être la prochaine fois mettre la banane en fin de cuisson - recette à garder - merci', '2011-01-25T13:51:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, da7313ad-1d0d-4be9-8571-91ac1ae51aac, 'Extra ! J''avais un peu peur de la dose de curry, mais c''est ce qu''il faut, c''est parfait ! J''avais remplacé les pommes par des poires et j''ai mis les bananes vers la fin. Je referai cette recette. La sauce est onctueuse et parfumée à souhait.', '2010-12-09T00:31:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 71a8111a-e69c-4708-baf0-29deaaf66c59, 'C''est excellent !!! Facile, rapide... j''adore et ma famille aussi !! Je ferai à nouveau, c''est certain. Merci pour cette recette.', '2010-11-14T19:18:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, d331a530-4350-4c95-b04a-0a72ab71af13, 'Très bon, mais j''ai oublié de mettre les amandes. Je tacherai d''y penser la prochaine fois.', '2010-06-16T22:34:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, fd7a4e57-9be8-42c8-9c65-10862d32aa30, 'Recette simple et excellente. A servir en toute occasion. Merci !', '2010-05-10T19:28:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 8945b413-27ac-47c0-bc3f-8fda66aabec8, 'Génial super bon je ne m''en passe pas j''ai même essayé avec de la crème en supprimant le concentre de tomate et c''est pas mauvais du tout', '2009-04-20T20:54:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 80fac3e4-d12e-474f-b537-1f9929a14128, 'Tout simple et très bon ! Parfait !', '2009-04-09T00:17:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 682e35b6-5b54-4dbb-8a36-0f9a942f5492, 'Moi qui ne suis pas fan de sucré-salé, j''ai adoré sauf que je n''ai pas mangé les bananes qui, à mon goût, sont trop sucrées. Par contre, c''est vrai que je les ai faites cuire au dernier moment. J''ai servi ce plat à mon mari avec des patates douces et il a trouvé cela excellent.', '2008-12-11T14:35:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 2afb0a67-fd44-47a4-9b30-c7e370837918, 'Mes invités ont kiffé!!!!! Tout simplement un grand plaisir gustatif et d''une simplicite enfantine...', '2008-11-13T01:16:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 4f133cbd-8150-42b3-a6dd-9995a2375c3f, 'Très bon plat, non c''est même un explosion de saveur, ce mélange salé/sucré! Ma famille était très contente du résultat. Très rapide à faire et super simple.', '2008-07-02T19:44:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, e33a5bc4-a69b-4e7d-a4dd-d3a0f03e8dad, 'Super bon!!! J''ai mis 2 bananes et une grosse poignée de raisins secs comme conseillé par les internautes !! A refaire les yeux fermés !!!', '2008-07-01T15:19:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 4775bdef-f63c-455f-b056-0542a297bced, 'Délicieux et gourmand avec le  mélange sucré salé. Plat aussi bien familial que convivial ! J''ai rajouté une banane et une pomme pour qu''il y ait plus de sauce.', '2008-02-08T19:31:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 5ec5e2ca-fbbf-4011-beb9-dec205493adc, 'J''ai ajouté une cuillère à soupe de sucre roux ainsi qu''une poignée de raisins secs pendant la cuisson. DELICIEUX', '2007-08-31T07:12:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, b9e02301-3e23-4866-8437-b016e1f6b7d4, 'Très bonne recette. Très facile à réaliser. J''ai utilisé de la pâte de curry et c''était fameux!!! Merci.', '2007-03-12T12:42:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, f4542508-d196-4c72-b779-77817bc41ded, 'J''ai pris des blancs de poulet au lieu de cuisses, c''était très bon! On a particulièrement apprécié les amandes grillées.', '2007-03-06T18:20:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 87ad4ee6-3be1-49c2-a0e2-90f1c529bfac, 'J''ai vraiment été déçue, on ne sent même pas la banane ni la pomme, elles sont réduites en compote...rien d''extraordinaire.', '2007-02-11T15:21:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 0c8399aa-4c1b-4083-b652-37e0d30fbbba, 'Merci pour cette recette simple et délicieuse. Mon homme a apprécié et en redemande déjà!!', '2007-01-09T17:02:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 66b087e8-52af-46b9-9a3a-09427c91bbd1, 'Franchement excellent, succès assuré, même les enfants aiment : génial. J''ai déjà passé la recette et ce fut également une réussite. Je l''ai suivie à la lettre et c''est très bon ainsi. Très très facile à réaliser, encore merci de ce franc succès.', '2006-12-08T15:03:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, dbe6b981-6eb1-48ce-8fdb-b1af6f1973ba, 'Excellente! J''ai ajouté un peu de noix de coco râpée dans la sauce! Je conseille cependant de ne mettre les bananes que vers la fin, sinon elles finissent en bouillie!', '2005-12-12T11:15:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, fe98c46c-20b5-42db-8db9-6cc6e3ecfeec, 'J''ai ajouté 1/2 boîte de tomates pelées, des champignons et au dernier moment, une cuillère à soupe de crème fraîche. Un vrai régal!', '2005-04-26T20:11:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22526, 469b3e3f-4e55-4c81-956a-cda99d2929d1, 'Délicieux, comme au resto indien  et vraiment facile à faire', '2004-12-30T19:43:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, 2cc596ad-0da6-42a1-8277-54b0c738e633, 'Toute la famille s''est régalée. J''ai saupoudré les bananes (4) de sucre roux et fait flambé au rhum. Je n''ai pas mélangé avec la crème et au montage une couche de bananes, une couche de crème caramel (2 cuillères à soupe) et une couche de palets, à renouveler 2 fois. Je n''ai pas retrouvé ce goût de beurre dont certains parlent.', '2016-04-17T16:51:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, 3dc7a2e8-717d-4dc4-a45f-18feee1b0fd1, 'Le goût se rapproche du banoffee...Du coup je n''ai pas été vraiment été étonnée.', '2015-11-09T18:30:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, fec53916-ba01-43e2-8482-88aa2c6babea, 'Simple et très bon, tout le monde s''est régalé. ', '2014-11-09T14:43:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, 9c0acb43-521d-44b5-aab6-0921b0b50fb1, 'Les bananes ont cuit au lieu de dorer et cela ressemblait plus à de la compote, la prochaine fois j''essaierai à feu plus vif. Sinon j''ai intercalé une couche de mélange chantilly noix de coco au milieu de la verrine pour que cela soit moins sec. L''ensemble était plutôt bon, mes invités ont apprécié.', '2014-03-07T13:14:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, df743ff4-1ec6-410e-b346-fa547a97df11, 'Très facile et délicieux ! ', '2014-02-20T10:30:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, 9bbfcd6a-c0ae-41f7-8d54-ee056c24b41c, 'Excellent ! c''est la première fois que je fais cette recette et je pense qu''il faut mettre une banane par personne. Il faudrait du coup augmenter la quantité de rhum.', '2014-02-08T18:27:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, a114617b-9a72-49a9-8423-bc132aeb97ba, 'Rapide, facile et délicieux...un vrai régal !!! ', '2014-02-05T15:06:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, 2aeb0256-345e-4a8c-870e-433eaf4f8fcf, 'Désolée de faire baisser la note, mais j''ai été très déçu par ce dessert tant par sa texture, le côté sec et lourd à la fois. Il manque une touche de fraîcheur c''est sûr! ', '2014-01-21T08:11:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, 9a5e56ba-15c3-4c6b-b708-5a19338af57f, 'Un délice ! Je les ai servi chauds avec la chantilly mise au dernier moment !', '2010-07-05T15:06:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, fb8646d6-d04c-4c97-be8a-a58a896c71cf, 'Désolée, je vais faire chuter la moyenne mais moi je suis déçue de cette recette. J''ai respecté les proportions, fait la chantilly moi-même; à la préparation, tout sent bon, on se dit qu''on va se régaler, et à l''assemblage, au final, c''est très lourd. La recette ne précise pas si on doit laisser au frigo ni combien de temps. J''ai mis au frais 2 bonnes heures, mais le beurre des bananes qui refroidit...bonjour la lourdeur. On n''a pas du tout senti le goût de la crème caramel, complètement écrasé par celui du mélange bananes-beurre. A refaire...mais en changeant plein de choses.', '2009-03-01T11:26:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, fe32bad6-e5f7-42c8-b370-0a0f46897dbc, 'Super facile, et ça se mange sans faim! à tester rapidement!', '2009-01-26T21:17:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, 4260702a-2076-4392-a267-0dcfdca1302e, 'C’est vraiment très bon! Et unique en son genre. Pour faire la crème de caramel, j’ai utilisé un fond de confiture de lait + crème liquide + caramel + sel (on fait ce qu’on peut !). Choisir des bananes mûres, les miennes qui n’étaient pas très mûres, étaient un peu trop fermes. Ne pas hésiter sur le rhum, on le sent à peine. Ces proportions m’ont donné 4 verres « à moutarde » pleins.', '2006-02-21T12:46:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, ce9130b6-6329-4167-aff2-df847a431288, 'Quelle merveille... J''ai juste doublé les quantités de banane (pour pouvoir faire une deuxième couche banane/biscuit, avant la chantilly). Allez-y les yeux fermés!', '2005-11-04T08:13:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, d4d0d894-1cd2-4021-843a-89aa94cde124, 'Rapide, simple, et surtout super, super bon!!! Merci pour la recette. Perso, j''ai rajouté une boule à la vanille sur le dessus, accompagné d''une chantilly maison à la vanille.... A refaire.', '2005-10-30T09:50:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, 8446efc3-276b-468e-917e-1d77cd7200c8, 'Très apprécié, c''est un dessert qui a charmé l''ensemble de mes convives. Merci.', '2005-10-27T23:48:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, 9dbd71d5-daae-4226-977a-c509da615fe9, 'Un délice!!! J''ai mis un peu plus de crème de caramel (pas obligatoire, mais c''est tellement bon), et nous nous sommes régalés. Merci Vali!', '2005-09-20T12:45:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35744, 91f57ed7-828c-4f3f-a1fc-4ad89999421e, 'J''ai goûté à ce petit miracle chez la créatrice herself! Dieu que c''est bon!! Et le jeu de mots, très fin aussi: Ker.. aïbes!!! :oD', '2005-03-22T15:50:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, b51c17f0-c704-49fc-8c36-7b9e26f50c90, 'Très bonne idée. J''ai juste remplacé la maïzena par de la poudre d''amande, le fructose par de la cassonade (1 pot), et j''ai mis 1 sachet entier de levure, coupé 2 bananes en rondelles et ajoutées à la fin dans la pâte. Et pour finir, le petit sachet de sucre vanillé versé sur la pâte avant d''enfourner 35 minutes, thermostat 6. Miam !', '2015-01-14T09:43:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 1c38ee15-433a-47fc-9867-f046b583394d, 'A peine sorti du four, les enfants se sont régalés. J''ai suivi les conseils des commentaires et changé un peu la recette = fromage blanc à la place du yaourt et sucre roux à la place du fructose; la prochaine fois j''utiliserai de l''édulcorant liquide (je suis au régime). Je suis super contente qu''ils soient aussi réussis (j''ai utilisé des moules à muffins et mini cakes). Merci Marmiton !!', '2010-10-24T19:25:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 6440f32e-fa0f-406a-a25b-aefe2123479b, 'Pas mauvais mais je pense avoir raté pour la levure car lors du deuxième essai le cake a littéralement explosé dans le four !', '2011-05-03T13:29:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 73d8d843-251a-44d4-8c8c-65dd49066827, 'J''ai testé la recette avec 2 bananes. Malheureusement, je n''avais pas doublé la quantité de tous les ingrédients et le cake est retombé mais c''est facile à préparer et il avait un bon goût.  ', '2010-08-18T15:57:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 6ebb998d-e691-463c-84a4-0ebb14478bba, 'Très bonne recette pour les diabétiques. J''ai mis 2 bananes en suivant les conseils des commentaires et j''ai ajouté de la levure mais le gâteau est quand même retombé. Or mis ce petit détail il était très bon !', '2009-08-22T01:09:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, e895684f-b863-48d3-bbdd-0bb91ad54260, 'Trop bon! personnellement je n''ai pas ajouté de cannelle, j''ai mélangé la banane avec du rhum et mis le sachet de levure en entier. Le résultat était parfait. j''ai fait cuire la pâte à gâteau dans des petits moules à muffin et nous nous sommes ré-ga-lés !', '2009-02-26T22:02:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 5fbe0d14-6af3-487c-bf21-4e106cf0187c, 'Très moelleux effectivement. J''ai mis un sachet de levure, donc ça a aidé. Par contre, j''ai eu du mal avec les grumeaux en mettant les ingrédients dans cet ordre. Je pense qu''il faudrait mettre : bananes, puis yaourt, puis œufs, puis huile, puis sucre, puis maïzena, puis farine et levure… Mais c''était quand même très bon, et c''est vrai il y a une certaine ressemblance avec des muffins. La prochaine fois, je ferai dans des moules à muffins pour le petit déj''. Merci de cette recette…', '2008-10-04T22:56:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 87b04d25-9204-4d38-842d-36d5d383e877, 'Très bon, moi aussi je mets 2 bananes que j''écrase dans un peu de rhum et je force sur la cannelle!', '2008-06-21T23:52:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 873cf970-e92c-46ab-ad5f-8113549f4c50, 'La recette me semblait simple... Résultat: après cuisson, très bien, mais en refroidissant, une catastrophe... Le cake était ratatiné et non cuit à l''intérieur... Immangeable!', '2008-03-06T19:45:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 247cb3fa-6da7-42dc-be7f-9344918baaec, 'Délicieux et rapide! J''ai suivi quelques conseils précédents : j''ai mis 2 bananes que j''ai écrasées dans 2 cuillères à soupe d''eau de fleur d''oranger (j''essaierai avec du rhum la prochaine fois). Seul bémol, l''aspect, le cake était un peu raplapla. La prochaine fois je rajouterai 1 sachet complet de levure chimique et je prendrai un moule un peu plus petit!', '2008-02-11T20:45:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 6b685fc2-5f82-429b-bb8a-e489b8887776, 'Le résulat est assez bon, mais j''ai réduit le temps de cuisson à 30 minutes... ', '2007-08-12T20:58:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, fbc4e262-8b77-4a14-8a7a-c382537616fa, 'Je l''ai fait avec deux pots de farine, un pot de sucre au lieu de la maizena et le fructose pour mon copain qui doit prendre un peu de poids. Mais le résultat est tout aussi excellent! J''ai pas hésité à mettre une bonne dose de cannelle, ça parfume c''est super bon. J''ai du coup essayé aussi avec des pommes, délicieux par contre j''ai dû rajouté 1/2 pot de sucre car ce n''est pas aussi sucré que la banane.', '2007-03-24T17:58:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 98c78814-394c-489d-b205-8f1105c51c78, 'C''est une très bonne recette, très facile à faire. J''y ai ajouté des petits morceaux de pommes. Je compte aussi ajouter des raisins secs la prochaine fois.', '2006-09-15T13:51:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 8b812238-0b82-4d34-934c-7978b144f971, 'Pour un cake de régime, il était très bon. J''ai eu peur qu''il ne soit pas assez cuit mais cela à permis qu''il ne soit pas trop sec. Merci pour la recette.', '2006-05-03T17:56:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, a2683e37-eb40-4099-a434-5e4c9c05b88c, 'Je m''y suis peut être mal prise, mais le résultat n''étais vraiment pas fameux : pas de goût et sec.', '2006-04-19T14:14:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 23076768-7522-4a98-979b-8ab6de9b2c9e, 'Sucre bio + pépites choco + moules à muffin = un vrai délice pour le goûter, extra-moëlleux. Ca renouvelle le gâteau au yaourt.', '2006-03-19T18:10:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 733faeb0-7211-45b1-8aa6-0dd035dc8625, 'C''est bon mais pas exceptionnel... Avantage: rapide à faire pour le petit déj.', '2006-03-17T17:38:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 57dab516-ea41-44e6-9a38-50a85e403c40, 'Comme je n''avais pas de fructose, j''ai mis à la place 1/2 pot de cassonnade. C''était absolument délicieux, croûte croustillante et coeur fondant. Recette simplissime (je suis nulle et j''ai réussi!).', '2005-10-06T02:06:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, beb42a14-1457-46e8-be8b-2eaf36475cf3, 'Ce cake est délicieux et très léger. J''ai également utilisé la pâte dans des moules à muffins pour le petit déjeuner...', '2005-05-10T17:39:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 13f52105-eb28-4716-b80a-7ddf3c94d4e7, 'J''ai arrangé la recette en mettant du sucre cassonade, moitié farine et moitié maizena, un pot de poudre d''amandes, une cuillère de fleur d''oranger pour écraser la banane, et une deuxième banane dont j''ai intercalé les rondelles entre les couches de pâte. Résultat très bon.', '2004-12-29T09:21:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22904, 7baca029-fca6-4895-8ae7-bac93f0603eb, 'Ce cake est décevant: trop spongieux et un peu sec, bien qu''arrosé de rhum à la fin de la cuisson.', '2003-06-22T15:25:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45004, 7389d2df-3f14-4c56-8c5b-7e04549b66da, 'Bien ', '2017-06-01T22:09:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45004, a4c71a3d-d2f8-4c68-9e35-cfe7d12ea8f0, '2 bananes, 1 kiwi, 2 yaourts vanille, 1 yaourt nature (pas de fraises).', '2016-08-07T14:19:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45004, 1e49d3b2-453c-4af9-8e25-0b262a90f0f1, 'Moi, j''ai servi ce milkshake en dessert. ça change, et mes enfants ont adoré!', '2009-02-15T14:00:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45004, d012d518-a030-460c-a2eb-f5d94c8571b6, 'Très bon mais je rajoute du sucre et j''enlève un peu de lait, autrement c''est une excellent idée pour commencer la matiné.', '2006-08-30T20:12:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45004, 944185b5-5817-445c-a5f9-3f6cafeacc5c, 'Boisson idéale pour le petit déjeuner, c''est frais et plein de vitamines et c''est l''occasion de manger des fruits.', '2006-04-24T23:18:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48500, f6ba57b7-a350-4b54-b201-946a626f9381, 'Confiture faite à plusieurs reprises avec cette recette. Excellente ! Même pour les sceptiques ! ', '2022-03-10T09:26:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48500, 9ee0f3aa-482c-4925-ab64-455f66f0e5ac, 'très bon ', '2021-05-24T17:52:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48500, c8f986b0-2355-4ec6-accf-cd6679ad14c5, 'Un régal. Fait avec la moitié de sucre.', '2019-12-15T17:24:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48500, 6635b0da-05dd-4210-af64-3038b198b512, 'Bonjour excellente recette j''ai juste fait cuire 30 min, Et mixer la texture avant de la mettre en pot. Hummmmm!!!! ', '2018-09-02T12:44:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48500, c4e7e9cc-677c-4cb8-be15-2d7a066e78cb, 'Excellente ! J''ai également ajouté de la vanille.', '2018-08-04T13:09:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48500, c1d31e71-d47e-4d77-8370-dcf63eb8954b, 'Délicieuse !! Je vais acheter des bananes !! 500 g de sucre pour un kilo  !! Le top !!', '2016-06-29T19:18:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48500, bfbbfbfd-527d-47d7-9d23-38eb94b08898, 'Merci pour la Recette !', '2015-02-22T08:51:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48500, e46ca0fd-4c51-4f8b-a28a-364e8077ef73, 'Excellente recette, j''ai divisé la recette en deux pour essayer mais la prochaine fois je la double ! J''ai également ajouté de l''extrait de vanille et c''est trop bon.', '2013-02-27T22:55:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48500, 0dbd1952-c9e5-4429-bdca-54dbc46b13c3, 'Dé-li-cieuse et facile ! J''en referai, et cette fois plus qu''un pot car elle part très vite !', '2011-11-03T04:40:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48500, 37048c98-1ed7-4498-816e-09ed21a43aff, 'Dommage qu''il n''y ait pas de 6 !!! Merci beaucoup pour cette recette simplissime et délicieuse (moi qui ne suis pas fan de la banane, je l''adore !!!). J''ai ajouté une gousse de vanille et une cuillère de miel... mais je ne trouve pas les mots... le citron lui donne un goût acidulé !!! Moi qui vit en Guyane ou les bananes sont à profusion, je sais désormais quoi en faire !!!!', '2010-08-18T17:42:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48500, 08b7f21f-5bd1-489b-b22a-506ad084c9e6, 'DELICIEUX ! La confiture a gardé une jolie couleur crème. Les bananes n''ont pas noirci. Je n''ai mis que 500 g de sucre pour 2,5 kg de bananes, et encore je lui trouve un goût très sucré. Par contre je l''ai faite mijoter 1 heure... La petite touche de rhum et de cannelle lui procure un petit "goût de reviens-y"... d''ailleurs je file en savourer une tartine.', '2009-01-04T12:19:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48500, b87d01e7-0be7-42aa-8419-6519cbe0aa19, 'Un mot: EXCELLENT! Ni trop sucrée, ni trop peu. une des meilleures confitures maison que j''ai réalisée! Merci!!', '2008-06-05T15:37:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48500, 864ac03d-f470-4800-853f-b4ca52289464, 'Elle est super bonne! Je me lance depuis peu dans la confiture et c''était une réussite !!  Je pense par contre mettre un peu plus de cannelle la prochaine fois. Va être refaite très bientôt !!', '2007-08-30T19:15:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48500, 7507642d-9417-492b-89b7-15bcca4d1734, 'Excellente. Une partie de l''eau s''évapore à la cuisson ce qui donne un goût parfait, ni trop sucré ni pas assez. Parfait pour ajouter dans un yaourt en dessert!', '2007-08-26T19:16:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48500, 64ef4660-8553-4358-83ea-7302a2ce8de3, 'Délicieux. 12 bananes=1 kilo décortiqué pour vos courses. Et la banane se décline en bio et équitable. Le plus long est de couper en rondelles.', '2006-10-29T19:59:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, d06b0ea3-0c7e-4ee3-b113-fc89ac7dbd0b, 'Vraiment pas très bon, bananes cuites = molles.', '2019-08-29T13:52:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 74b993e8-d7d4-45e9-995a-f9545158895c, 'Petit truc : choisissez des bananes les plus mûres possible, le plat est beaucoup plus savoureux et on peut diminuer le temps de cuisson à 20 minutes.', '2008-04-11T19:17:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, de811f77-96ce-4870-be98-ab439fe235e9, 'Rapide, on peut aussi le faire chauffer au micro ondes, et très bon...il y a différentes variantes possibles, la banane se mélange bien.', '2007-09-09T22:19:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 9c816568-4c18-49ed-812b-5fa3a9f3df94, 'Se fait également au micro-ondes ', '2023-10-30T19:16:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, fc29545c-0b32-4713-9691-1705ae8b6068, 'Aussi bon que facile à préparer. Miam.', '2017-04-15T19:20:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 19b9ca0f-3305-4dde-b57c-914e5a6f1596, 'Simple et bon.', '2016-09-14T13:19:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, ecc86bc9-562e-416f-aa87-23eece85dffd, 'J''adore la recette, c''est très bon, merci ', '2016-03-17T21:26:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 7fe73a03-3ccd-4051-9508-f00658ac9ad2, 'Recette allégée avec du fromage blanc à la place de la crème fraîche...', '2016-02-05T19:13:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 4ee9c186-c38f-4e1a-ad7a-836c17cf37b6, 'Les enfants n''aimant pas trop les poireaux au jambon, j''ai mis les 2 bananes au jambon dans mon plat de poireaux au jambon ! Résultat très bien ! ', '2015-10-30T22:08:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 619bca46-5887-4218-ac6b-5290160b2334, 'En faisant caraméliser les bananes dans le beurre avant de les mettre au four, je trouve ça encore meilleur. ', '2014-09-15T18:21:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, ad7164ef-262d-41ee-89fa-63d9dc25fdc2, 'Nous avons adoré cette recette "étrange" ! Nous avons suivi les commentaires précédents : nous avons ajouté une tranche de lard fumé sous le jambon puis, recouvert les bananes de crème fraîche au fromage râpé, pour les faire gratiner ! Un vrai régal, qui change !', '2014-09-03T23:32:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 4434b13b-0066-4abc-abe7-ba04f4a4772d, 'Excellente recette pour les amateurs de sucré-salé !!! Ma petite touche perso : 2 tranches de lard fumé sur la banane (dessus-dessous) le tout roulé dans une tranche de jambon. Testé par mon chéri, ma belle famille et les amis : que des compliments et des assiettes vides !', '2014-06-22T18:27:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 97a527b5-f5c6-4a30-86c4-f57f4785e844, 'Très bon plat, j''hésiterai pas à le refaire ! Ma mère aussi a adoré ! Merci Marmiton pour vos belles recettes.', '2013-03-20T13:55:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 82b52621-8adc-43c7-8176-5e9abafe0f78, 'Délicieux ! Tartiner la tranche de jambon d''un peu de moutarde pour casser le coté sucré.', '2013-02-25T15:16:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 8de04412-d350-4ea4-b30b-192596c28fb3, 'J''ai adoré mais je n''ai pas mis de fromage, ni de crème pour que ce soit moins lourd. Avec de la salade, c''est génial : bon, simple et rapide.', '2013-02-18T23:11:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 872e328a-9ef6-4894-93a6-16b7077e0268, 'J''avais mis beaucoup d''espoir dans cette recette, malheureusement, nous avons été déçu ! Peut-être la refaire avec des bananes plantains et en effet de la moutarde et du paprika, mais pas tout de suite, encore trop déçue !', '2013-02-03T12:16:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, f365c430-68cd-40aa-bce4-e85dfeb50344, 'Mes 3 enfants (de 3 à 9 ans) y ont a peine touché : c''est vrai que l''aspect n''est pas très appétissant et le jambon a séché au four... dommage !', '2012-02-07T20:24:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 712b9c04-64dd-48c6-bb2a-fd87153d1914, 'C''est super bon ! J''en fais régulièrement ! Je le conseille !', '2011-07-23T00:02:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, bb19512e-e2cf-4f6a-94fc-ef4677acd7c9, 'Mes gars ont fait un peu la tête devant l''inconnu, mais, pour ma part, j''ai trouvé ce plat excellent et je le referai pour moi toute seule (na !).', '2010-10-10T16:04:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 5877b1c7-3b2e-4758-b0a1-44f9a74acc2b, 'J''enroule mes bananes dans le jambon et je verse un appareil dessus (2 œufs, crème, lait, gruyère ou comté râpé et cannelle) puis 1h au four. Extra !', '2010-04-19T15:37:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, dcbc8590-9e69-495e-9782-6600f76815b2, 'Super recette pour ceux qui aime le sucré salé, en  plus c''est une recette hyper rapide à faire ! Nous aimons tellement cela qu''on en mange 1 fois par semaine avec une salade.', '2010-03-11T12:21:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 7626fc9c-b62a-4a71-88c1-b6c532012503, 'Idéal pour les soirs sans envie de cuisiner ! A réésayer avec le paprika et la moutarde.', '2008-11-20T23:06:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 2beee86c-7bee-4f51-af88-9b7c4ad0af3c, 'Recette originale, ou je dirais plutôt, spéciale. Ce n''est pas mauvais, mais on ne peut pas dire non plus que ce soit bon. A essayer, mais pour moi, à ne pas retenter.', '2008-11-15T12:16:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, f99599bc-e6a3-4271-92df-1402a4de9ec2, 'Non et non, franchement écoeurant, à la limite du mangeable. Même mon fils de 5 ans a tiré au coeur dàs la première bouchée, en sachant qu''il mange de tout sans rechigner.', '2008-09-27T21:05:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 8aab12b9-53e1-4d6a-beb9-67e579096945, 'J''ai gouté cette recette que j''ai trouvé... suprenante. A la fois écoeurant et pas si mauvais. J''ai fini mon assiette, mais je n''en referai pas dans le futur...', '2008-09-17T12:48:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 1f5e5caf-6ff2-45b3-ba1b-3ca027cee2e4, 'En effet, c''est une très bonne recette: j''ai remplacé le paprika par du curry pour un goût plus intéressant. Très facile et pratique pour tous les jours, mais pas recommandé pour un dîner un peu formel. ', '2008-06-04T13:00:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, a1fff4b9-d4e9-46f8-b4a2-b4d71988ca39, 'Je connais cette recette depuis longtemps. Ma maman appelé cela des bananes en pyjama je trouve que c''est un titre bien rigolo pour faire découvrir cette recette aux enfants. Rapide, simple et délicieux, histoire d''utiliser les bananes qui s''ennuient dans la panière à fruits !', '2008-02-27T22:28:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, c125fa2d-7f07-4392-9822-d2fed4bea984, 'Un seul mot : Bravo! Mon mari est souvent perplexe devant les nouveautés sucrées-salées, mais là, il a été conquis. J''ai suivi le conseil : paprika saupoudré sur les bananes et moutarde étalée (légèrement) sur le jambon. Cela n''est pas du tout écoeurant et très original. Comme quoi, on peut surprendre avec des choses très simples !', '2008-01-13T23:01:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, fa2c04f3-4e4c-4b1f-82a3-9716c22647ef, 'J''ai essayé et adoré ce mélange sucré-salé, c''est super je le referai car rapide à préparer et pas cher en ingrédients.', '2007-11-17T13:55:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 2080b065-70d5-48e9-b319-c5e3cbcb71c6, 'Très très bon !! Par contre j''avais fait 2 bananes par personne, et cela faisait beaucoup car ça devient vite écoeurant !!! A faire avec du riz, c''est génial !! Merci pour cette recette, simple et rapide quand on n''a pas le courage de cuisiner, ou que les placards sont vides... :)', '2007-11-12T01:00:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 9972de07-53f1-4f65-b449-6b0f38d9c962, 'J''ai testé avec du bacon, rapide, simple et délicieusement bon.', '2007-02-15T14:51:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, e99a35cb-120a-49d1-9676-4bf210208107, 'Je fais cette recette depuis longtemps avec du paprika mais j''ai rajouté la moutarde et c''est super... Merci', '2007-02-03T18:29:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, eec3f36f-6ed1-4634-8e6d-85e3cbf1b8ee, 'J''ai également mis du paprika sur les bananes et de la moutarde sur le jambon, un vrai régal pour les papilles, surtout si on aime le sucré salé! J''ai fait une purée comme accompagnement... un délice ;) merci!', '2007-01-15T22:18:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, b0ba1ed6-d347-4fd4-939d-203be8b9f8f9, 'Ai pris le truc de Virginie: paprika + moutarde, le pied pour les sucré-salés!', '2006-12-12T17:35:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 39cc59f3-73ec-4690-b378-bfa44f0ff475, 'Original, très sympa, j''ai adoré et je le referai, car c''est ultra simple!', '2006-11-25T15:49:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 38f04e45-d255-44f9-9022-af19a9349d5d, 'Bon, je suis en train digérer. En s''inspirant des divers commentaires, on a saupoudré un dixième de pincée de paprika sur le gruyère râpé, et un soupçon de cannelle dans la crème (fraîche mélangée à du lait de coco, faute de crème liquide ou légère en stock). Nous, les adultes, on a bien aimé, mais les enfants n''ont pas apprécié du tout et après avoir goûté 2 fois, ont formellement refusé de continuer!', '2006-10-03T23:42:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 58506a8e-e98c-4486-8c1f-624db3875fba, 'J''adore! Je connais cette recette depuis longtemps et elle enthousiasme toujours autant. Moi selon les appétits, je sers le plat avec du riz ou une salade verte. ', '2006-09-17T11:40:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 590a4ff9-2310-44a7-b52c-9b43beaea074, 'Très bon, j''ai réalisé la variante de Virginie, essai très concluant. Simple, rapide, pas prise de tête. A refaire absolument !', '2006-08-19T14:48:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 224bc8dd-1be3-4d42-9cdf-8821beceecf4, 'Super simple, rapide et délicieux! Je le referai sûrement!', '2006-08-10T22:32:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 4571b0a9-f068-416b-a906-80dd2c44e10d, 'Ma mère nous faisait cette recette avec une variante: saupoudrer les bananes de paprika puis tartiner le jambon de moutarde. Ca change tout!', '2006-06-28T14:13:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, ee9a8813-1311-429a-bf18-310f6ebb2ee0, 'Recette simple, rapide et délicieuse que je fais depuis lomgtemps. On peut la faire avec des babanes mûres. Pour un soir où l''on désire ne pas cuisiner et c''est très bon.', '2006-06-17T08:05:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 651e16ac-d85d-4381-b0ef-7b59e233ac64, 'C''est merveilleusement bon! Merci pour cette recette simple, rapide, et originale!', '2005-09-22T23:16:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 1a2a62e3-df95-4c59-94c0-26e9f8b471a7, 'Très simple à faire, très original et délicieux!', '2005-03-18T17:05:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 5ac58d1f-f38e-496b-a801-ed78bd560607, 'Délicieux! On peut même mélanger une cuillère à café de cannelle et une de mélange gros-sel/poivre concassé à la crème!!!', '2003-07-10T11:09:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 03e3acd1-0137-4116-b3a2-9bcdc437ab48, 'Pour ceux qui aiment le  melange sucré-salé. J''adore. Cuire avec une bonne dose de fromage et de crème fraîche, puis verser la sauce sur une purée de pommes de terre, je me régale. J''ai fait ça à des amis sceptiques et ils ont tous adoré.', '2003-02-04T12:39:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18489, 2e3683b1-f7a9-4991-9861-1c2ed881b36f, 'Très surprenant!! Pas très bon pour moi... ', '2002-10-16T20:44:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, 4bed4302-2bd6-4359-a051-bfab5aa9d88b, 'Pour ceux qui disent que le gateau est plat malgré la levure, essayez donc sans ? Je remplace le lait par du lait de noix de coco et la poudre d''amande pqr de ka poudre de noix de coco. Tout ça parce que la 1ère fois que j''ai voulu le faire, je n''avais pas de lait, ni d''amande. Par contre, je monte les blancs en neige ce qui permet d''alléger le gâteau, les bananes étant un fruit "lourd"  Je rajoute aussi, 2 autres cuil. De lait pour mixer les bananes, puisque il faut le lait au début de la recette afin de tout mélanger et, des fois une pointe de fleur d''oranger. Je verse le tout dans un moule a tarte et enfourne 30 min. Ce qui en fait un flan plutôt qu''un gâteau. Pour l''été, une fois refroidi au frigo. Bref, UN VRAI RÉGAL ?', '2020-08-13T12:08:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, f1b62332-ba20-4562-825d-5b3daa8f7861, 'Bon', '2023-06-10T17:09:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, a0d8cd52-6afc-441e-9697-f41020872235, 'Très très bon. J’ai cassé une demi tablette de chocolat en morceaux et ai ajouté le chocolat en plusieurs couches dans le moule. ', '2021-02-17T23:57:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, 0dcadb3c-b334-43a1-9588-68a324735b84, 'Je trouve que le gâteau est bon mais il est pâteux et pas assez sucré et une texture bizarre. Si je peux donner une ou deux astuces, ajouter du sucre et couper les bananes en morceaux. Donc voilà pas terrible ! ', '2017-03-08T20:29:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, 726366b7-13ed-4824-8f55-f4e768145c75, 'Suivant les commentaires mis 3 oeufs puis à mon instinct 1 pot de yaourt pour remplacer le lait et la crème fraîche. Et 3 petites bananes, 125 g d''amandes effilées et 125 g de poudre d''amandes. Très facile à réaliser et très bon. J''ai même congelé les 4 tranches qui restaient.', '2017-01-17T22:55:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, 4a5621d7-dd56-4a1b-97a1-83f876b97259, 'J''ai mis 3 oeufs mais j''aurais dû aussi ajouter du sucre. Bref pas extra!', '2016-03-31T16:13:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, bd5c5270-7fcf-4ae8-88c8-f722e409b076, 'J''ai moi aussi rajouté un peu de rhum arrangé à la banane et j''ai ajouté des noix que j''ai mixé avec les bananes et un peu de crème fraiche, allégée bien sur !! Je dois dire que je suis assez contente du résultat, très facile et très rapide', '2010-03-28T19:39:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, 0ec6dfc1-f3d2-4eff-85b4-e3b81fbd33a3, 'j''ai remplacé la poudre d''amande par un sachet de noix de coco et ajouté un peu de rhum brun... EXCELLENT!!! ', '2009-03-15T19:04:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, d302a91c-e71f-4219-90a7-7ddabf3e19ac, 'Je l''ai fait, il est vraiment délicieux! Mon seul regret : il n''y avait pas marqué le nombre de personnes sur la recettes, alors j''ai eu un tout petit gâteau qui s''est mangé en 20 minutes. Mon conseil, c''est de doubler les doses et de surtout ne pas le laisser plus que 45 minutes.', '2008-03-30T16:02:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, f931f3f0-87ea-4822-987c-38d59a754707, 'Ne faites pas comme moi, la première fois, j''ai oublié les oeufs!!! Forcément, le goût était spécial...', '2007-05-07T23:42:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, 590edbf5-9289-4b7a-b0b2-c968eb4d76a6, 'Rajouter de la canelle, c''est délicieux! ', '2007-05-04T13:56:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, 75d9747a-5cea-415f-9532-d593a5829639, 'Ce gâteau est pâteux, nous n''avons pas aimé.', '2006-11-26T20:35:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, 69814b5b-8527-4919-bed0-09037a18a874, 'Recette sympa et vraiment rapide. Pour ma part j''ai ajouté quelques dés de pommes, de la cannelle et quelques pignons grillés: une merveille!', '2006-07-06T16:58:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, b1f30bb5-0489-4cfb-8c1b-1a24868c198d, 'Gâteau très sec... Recette rapide, mais pas terrible!', '2003-11-28T11:34:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, 9fc06d73-30b6-4a55-9a16-b2a00a220d02, 'Je n''avais pas assez d''amande en poudre, j''ai mélangé avec des amandes concassées et j''y ai rajouté de la cannelle.', '2003-11-09T19:27:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, 00dda91f-c432-4e67-9abf-6ecc32c02e93, 'Excellent! Facile et rapide à faire. En plus léger à digérer.', '2003-05-16T17:34:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, f3d0f68b-7e10-4461-b0e2-c499d0ae3472, 'Très bon et très léger, je l''ai fait avec du chocolat, et je l''ai parfumé avec quelques gouttes de vanille. Merci pour cette excellente recette facile et rapide à faire.', '2002-12-03T19:17:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, b8280b42-dac6-450a-8ae3-52a9582569c9, 'Réalisé avec mon loulou de 3 ans. Très agréable à faire et très bon. Merci pour cette recette.', '2002-10-16T23:43:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, 98a73efd-df0c-439f-bbc5-0f0efa72392b, 'Avec de la cannelle, ca relève le goût de la banane...', '2002-10-15T15:10:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15961, 17a8a5b4-3037-47f9-adf5-8b4e682f3605, 'Pas mauvais du tout, facile à faire!!! J''ai remplacé la poudre d''amandes par de la noix de coco râpée et des pépites de chocolat, les grands et les petits adorent!', '2002-04-25T11:19:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (225188, 415eb22c-572b-4765-ac94-0de6415cd32b, 'C''est léger et appétissant, je le conseille. Par contre réduisez la cuisson, ou couper les fraises en 8 car le jus de fraise s''est transforme en sirop.', '2018-06-02T04:58:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (225188, 31a7dbde-656c-4a5d-8f67-94da882a59bf, 'Bon, muffin moelleux et léger ', '2012-08-08T15:06:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (225188, b5cc0658-511f-4c99-96b0-6c730c284ac7, 'Très bons ! Il y a juste la cuisson que j''ai diminué.', '2012-07-20T12:11:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12939, 20bf6d36-0ff6-4af1-87b7-521739b423ee, '8/10 de la part de mes invités. J''ai mis 2 bananes. ', '2022-02-06T19:03:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12939, 0da81004-13d8-443b-80a2-a32d5d15ccb2, 'Bonjour, je viens de faire cette recette, avec quelques modifications, nous n''aimons pas le sucré salé, j''ai donc suivi la recette sans les fruits. Excellent, comme je suis en Provence et j''ai la chance d''avoir du basilic dans le jardin j''ai mis quelques feuilles et c''était délicieux. Merci Marmiton  5/5 pour cette recette', '2015-11-27T16:19:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12939, b46b8556-3669-4881-99a0-f9c48c471f60, 'Délicieux ! J''ai triplé la quantité de crème (légère...), ajouté un peu de lait en fin de cuisson pour allonger un peu la sauce, saupoudré de gingembre pour adoucir l''amertume du curry, mis une pomme entière et seulement 3 ou 4 tranches d''ananas. Servi avec du riz basmati. Les enfants ont adoré ! Je referai cette recette pour recevoir. Merci !', '2014-04-16T16:36:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12939, 8546493e-c7ae-4884-92e0-6075cd2dd9ab, 'Excellent', '2013-10-29T20:06:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12939, 2a51912a-b933-42e2-81ba-242913150a98, 'Plat très simple à réaliser et très bon. Le mélange sucré / salé est délicieux. De plus, c''est une recette idéale lorsqu''on reçoit des invités car on peut laisser mijoter sans risquer de rater la cuisson !', '2009-08-16T18:26:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12939, 7fe70dd8-65e5-4c85-909f-af6e6baeb0bd, 'Plat très apprécié! Je mettrais toutefois moitié moins d''ananas.', '2004-12-19T13:48:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12939, 72e69873-b7a1-4664-9c0c-c74735e94032, 'Excellent fait au wok, pour le tenir au chaud.', '2003-02-23T20:26:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12939, 1ef70c0b-0670-459f-a987-11698fcd04f9, 'Excellent avec les bananes! Une vraie réussite!', '2003-02-02T11:58:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12939, 6f6f7433-04a3-4a3b-a116-40748d0f138e, 'Délicieux. En revanche, je n''ai pas mis de banane, mais j''ai rajouté une pomme, qu''il faut faire cuire plus longtemps que prévu (environ 15 mn). Peut se faire avec de la volaille.', '2002-05-20T19:51:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12939, e38d8169-99a3-4ec0-87c7-3285a5e99965, 'J''adore', '2000-12-24T17:01:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336779, 167182fb-dad4-46b4-a1fa-9536242f3df4, 'J''adore cette recette ! Géniale pour passer une banane un peu trop mûre. Recette gourmande qui cale jusqu''au soir 👍🏻', '2022-04-04T15:25:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336779, c6759797-7a28-486b-901c-333020323e83, 'Super bon et facile à faire !', '2020-02-24T23:27:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336779, aae69848-e578-46e9-888c-d379e3cf3143, 'Facile, très rapide et en plus très bon ! Pour ma part, j''ai remplacé le sucre glace par du sucre vanillé.', '2019-07-29T11:01:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336779, 0c5a1e9d-af5b-4f39-bdc5-cf6e2ab65320, 'Excellent, simple et très rapide ! Bien faire dorer sur toutes les faces.
Pour ma part je préfère les saupoudrer de sucre en poudre une fois sortis du feu, encore meilleur !', '2017-06-08T14:05:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336779, adae30af-7e7d-4b14-93e4-d6ae23ec7e3a, 'Excellent!', '2016-08-03T04:51:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336779, bcbb449b-ddfe-40c2-a961-8aef68003a56, 'Trop bon j''ai pas flambé et j''ai mis du miel à la place du Nutella (j''en avais plus)', '2015-11-16T01:12:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336779, 862e31dc-aa98-4525-8634-5bcfd08e9831, 'Super bon ! Sans être Flambées mais très très bon Flambées aussi. Je referai sans hésitation. Merci.', '2015-06-17T22:09:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336779, 5720a3de-7e71-4206-875b-2aba70acd6a2, 'Trop bon!!! je les ai fait flamber avec un bouchon de rhum pendant la cuisson, c''était encore meilleur! !!', '2015-05-30T17:21:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336779, b44941ab-66f9-4802-b850-b0416b6d81c1, 'Parfait ! ', '2015-05-20T18:54:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336779, 6f9f4c01-4636-4e83-b332-d8d80f744b4d, 'Un régal.  Merci.', '2015-05-10T21:28:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336779, cfe79390-6dd4-499a-83a6-bddcb8fcf79e, 'Méga bon ! En plus super rapide à faire !!!', '2015-05-04T16:37:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336779, f5c8d2ba-f764-4cda-b097-e477fb9889fe, 'Super bon ! Personnellement je l''ai fait à ma façon mais merci pour l''idée ... J''ai opté pour mes tranches de pain  aux petites de chocolat et avec du Nutella sans les bananes  et j''ai suivi la recette à la lettre. J''ai fait la "cuisson " avec de l''huile. C''est le même principe que du pain perdu en gros ! Merci ', '2015-05-03T00:02:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, e50357ec-bee0-4830-b074-315d989f1010, 'Gâteau très bon et facile à faire !', '2022-02-17T10:41:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, a8ab89c4-0724-40de-b142-3f65f02704e6, 'Jai fait quelques changements car j''avais du beurre de cacahuètes et franchement  c''est top ! Muffin super bon, moelleux et avec un subtile goût de banane !', '2021-08-23T23:06:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 16ffba3d-d295-40a0-a1ef-631dddce4bcc, 'Bon gâteau rapide à préparer, apprécié par tous.', '2018-04-26T04:42:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, b3f2f944-f6b4-4209-8e9d-5ffdd150f9ea, 'J''ai mis 2 bananes et seulment 100g de poudre et beaucoup beaucoup de pépites de chocolat. Un délice et des muffins qui ne sèchent pas. Merci !', '2017-06-23T01:15:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, bd5732b6-9293-411e-9f95-5eb247dbd67f, '
Sous forme de Muffins avec des pépites de chocolat et des noisettes grillées concassées : délicieux !

', '2017-06-08T20:43:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 55d85551-656d-4f6d-ba5c-765016411ed2, 'Les faire en muffins c''est mieux et je rajoute des pépites de chocolat une tuerie.', '2016-08-20T14:35:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 155bcca6-9c06-474e-b829-6f532fa974ad, 'Très bon mais laisser cuire plus longtemps. Fait avec du sucre blanc !', '2016-03-20T10:31:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 86662d9d-d8d7-4bd4-9e1c-5e9d09d4033c, 'Fait avec 2 bananes, 90 g de sucre et 50 g de beurre. Mis de la maïzena au lieu de la farine pour sans gluten. Cuisson 20-25 min à 150°C dans des moules individuels. Recette simple et excellente. 2 amies sont reparties avec la recette. (Ajout de quelques copeaux de chocolat à la pâte). ', '2016-02-29T01:07:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 3ae65493-0a36-450c-882c-ddb10776e6da, 'Un incontournable pour les amateurs de bananes et idéal pour finir les dernières bananes qui traînent. Personnellement, je ne mets que 80g de sucre et 4 bananes bien bien mûres, du coup, le sucre des fruits suffit, d''autant que bien souvent, j''ajoute des pépites de chocolat (mon fils l''aime avec des pépites, alors que je le préfère "nature") A la place de la poudre d''amande, vous pouvez mettre de la noix de coco mais c''est un peu plus écoeurant. Le mix amande-noix de coco (90g amande le reste noix de coco) fonctionne bien. Une CS d''alcool de banane peut lui donner un peu plus de caractère. Cela fait 4 ou 5 fois que je le fais, à chaque fois, il disparaît à la vitesse de l''éclair ! Merci pour cette recette aussi facile que délicieuse.', '2015-07-26T14:26:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, aa87a64f-249e-4dad-9c57-a7a75a4edc32, 'Petit délice très apprécié par tout le monde. À refaire et à recommander.', '2012-11-07T21:37:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 05805217-876e-4526-a7d5-6b948e249954, 'Il est parfait,  un régal! ', '2023-08-29T21:56:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 90668644-f758-45d5-9993-04f7ca50acb6, 'Facile rapide et bon', '2023-03-21T21:10:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 02996517-2072-45be-8c6f-95b88c649622, 'Top👌🏼Délicieux 😋😋', '2022-03-08T17:48:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 92e02d29-219d-4d04-83ea-0882ced212e6, 'recette très simple et délicieuse. j’ai remplacé les 150g de sucre par 100g de sirop d’érable + ajouter 2 cuillère à soupe de lait + myrtilles. ', '2021-05-08T06:02:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 3fd23153-8e98-4fa9-97fa-bb23527663bb, 'Tellement bon .. je rajoute un peu de chocolat soit par un chocobon au fond du moule ou avec une petite cuillère de pâte à tartiner et tout le monde en redemande ', '2021-04-29T19:55:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 53e6c8f7-f4e6-4440-b402-9e21b60fed51, 'Excellent et tres moelleux
', '2021-03-07T15:46:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 52752231-b163-4ff3-8135-6b78e88bd890, 'Vraiment délicieux en muffins ! J''ai rajouté une demi cuillère à café d''arôme d''amande amer et 20 g de pépites de chocolats noirs à la préparation, et n''ai mis que la moitié du dosage en sucre roux. A déguster encore  chaud 10 min à la sortie du four. Moelleux et fondant un vrai délice !', '2020-10-01T13:05:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, b5b70b33-c723-4ed0-9a8a-3f9d85bbab9e, 'Très bon muffins, pas secs du tout, un vrai régal ! Avec seulement 60g sucre non raffiné, ils ont disparu en moins de 10mn! Merci pour cette recette si rapide.', '2020-04-06T16:49:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 4c585252-38a8-4ecc-a4ae-c9bbcf5dafba, 'Très bonne recette que je fais régulièrement, mais je mets moitié moins de sucre 75grs, je remplace le beurre normal par du beurre cacahuète et pour finir avant d''enfourner je rajoute des pépites de chocolat. On a pas l''impression qu''il y a de la banane dans cette recette. Je le fais dans un plat rectangulaire, ça va aussi.', '2018-12-27T11:39:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, e6ecf316-922d-4ca3-ae3b-d848b11d5593, 'Super recettte, perso je mets la moitie de poudre d amandes, et la moitie de poudre de noisettes
Je soupoudre de graines de courges avant de mettre au four, un vrai succes a toutes les occasions  ! 
Merci pour cette valeure sure !', '2018-02-04T12:31:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, ef970d88-2f5e-4c44-bcf4-193f447cca19, 'Recette un peu bourrative...', '2017-02-13T18:24:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, ace45a3b-af64-4670-b16c-af70fbdc6da7, 'Très bon avec 100 g de sucre et 4 petites bananes de Guyane bien mûres.', '2016-06-10T22:11:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, a433947f-cac9-400d-8045-e88b716bf5ca, 'Très bonne recette. J''ai utilisé 2 bananes et 115 g de sucre. 30 min au four chaleur tounante à 150 C. Un régal', '2016-04-23T16:42:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 3f4fb78d-a533-4fbc-bebe-887fa07ef7b4, 'Super bon! Avec seulement 100 g de sucre et un sachet de sucre vanillé!!', '2015-12-16T22:39:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, fc363ff5-8a3b-4a59-b8f4-d5d8eb82e7cf, 'Comme indiqué dans les commentaires, je n''ai mis que 100 g de sucre (ce qui est largement suffisant) et remplacé la farine par de la farine de riz complète (j''en suis fan). Cuit dans de petits moules, 30min. Dé-li-cieux !', '2015-11-11T17:51:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 58de4597-13d3-4e18-9a25-4c83f973ab25, 'Super bon avec 100 g de sucre ! J''ai utilisé des petits moules à cake, cuisson 20 minutes !', '2015-11-08T22:46:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 22aafab7-d863-462d-a5dd-9ef7b68fcf85, 'Excellent recette ! Très facile, à refaire !  Je n''ai mis seulement que 100 g de sucre comme conseillé dans les commentaires et c''était suffisant ! Et aussi ? 30 min de cuisson ! ', '2015-10-25T21:55:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 4b7225eb-cb79-4d95-916e-85e8b7124576, 'En un mot: dé-li-cieux!! ', '2015-04-17T17:03:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 2e9d69af-ce98-429a-bbaf-5743b662cec6, 'Merci beaucoup pour votre recette 4/5', '2015-04-06T01:07:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 0e9757df-6213-4a0c-ba7e-d9936c10a753, 'Un délice ! Comme conseillé dans les commentaires précédents, j''ai mis moins de sucre (100g, ce qui était largement suffisant). J''ai fait des petits gâteaux individuels et j''ai donc réduit le temps de cuisson (25 min à 150°C). Cette recette va faire partie de mes favorites.', '2015-03-20T12:26:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, d2846287-f78b-4c16-aed1-8efce7b899f8, 'Très bon goût par contre les miens n''ont pas levé comme le font mes muffins d''habitude, j''ai pourtant suivi la recette à la lettre !', '2015-02-28T10:47:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, d48d21ba-6369-44fe-ab0a-73d8ff576e8d, 'La recette préférée des enfants ! Merci !', '2015-02-19T17:53:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 7a293178-6069-4685-93bb-b6b00fff8adb, 'Très bon, moelleux et facile à faire ', '2015-01-20T12:55:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 4962b411-a0bf-4f5f-bbc9-c6a8eda4a953, 'Delicious ! Je ne mixerai pas les bananes la prochaine fois.  Merci pour cette recette. ', '2015-01-02T20:07:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, e42273c7-1dfe-424d-b8b4-c3ff1bb7937c, 'Recette parfaite... En effet mettre un peu moins de sucre à mon goût ! A refaire, un régal ', '2014-11-29T06:46:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, c15248e9-50dc-401c-9d5b-bbc2b8603ea1, 'Je n''ai mis que 100g de sucre et ajouté un peu de jus de citron. Parfaitement équilibré ! une régal. merci.', '2014-11-18T16:48:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 2673a1db-46a0-448d-ba7a-81d723ce0bae, 'Excellent, j''ai effectivement mis moins de sucre, 2 bananes bien mûres j''ai fait en muffins, j''en ai rempli 12 et mis 30 min à 150°C. Moelleux et un goût subtile. Je la refais tout le monde a adoré, merci pour cette recette.                                                         ', '2014-10-06T11:10:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, bd807fb6-cd4d-416b-a0b7-1c519be2092b, 'Bonne recette, mettre un peu moins de sucre peut être, mais à refaire sans hésitation ! ', '2014-05-30T17:39:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 24d597ac-585a-4de2-ac24-40e2fcdf2dc2, 'Très bon mais ajouter une banane.', '2014-01-24T18:13:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 793b3572-b745-4926-8b66-49662353bb0a, 'Bonne recette, très moelleuse, j''ai mis 90 g de sucre et rajouté à la fin des framboises. Par contre je pense qu''un demi sachet de levure est suffisant.', '2013-10-02T14:16:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, fe1c10a0-f90c-4636-8ab4-81cd2855adf7, 'Je n''ai mis que 2 bananes, mais c''était parfait! Vite fait, bon fait!', '2013-09-30T20:35:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, f4090972-edba-4258-a48e-edbff25e5ea3, 'Très bonne recette, Assez moelleux, j''ai rajouté des pépites de chocolat.', '2013-09-02T12:55:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 7bcf31af-c6fb-46e0-b79f-05ea54d8c5ba, 'Mes convives ont apprécié ! J''ai diminué la quantité de sucre et je pense diminuer aussi celle de beurre la prochaine fois... ', '2013-06-02T02:41:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 44949276-16ed-41f1-a2d6-b844a67698f3, 'Super à refaire !!! Par contre j''ai mis que deux bananes.', '2013-04-21T23:38:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 66be4db2-9cc7-426b-84a2-344305bdd78b, 'Un pur régal. Gâteau aéré et léger malgré la banane. À alléger un peu en sucre cependant (100g suffisent amplement). J''ai mis moitié noisettes en poudre, moitié amandes en poudre. Je garde cette recette dans mes favoris ! ', '2013-03-03T21:53:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 83b3898e-6e59-4eea-9c75-d54e56903043, 'Très bonne recette, simple et rapide.', '2013-02-26T20:23:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 66d40908-5409-45d3-b5e8-6bca13c56c8f, 'Facile, rapide, délicieux et léger. Permet d''utiliser des bananes déjà bien mûres ! J''ai réalisé 12 petits gâteaux avec une dose de pâte. J''ai testé également en ajoutant quelques pépites avant cuisson et ça ne gâche rien ! NOTE : j''ai mis 90 g de cassonade au lieu de 150 g et cela est suffisant.  ', '2013-02-09T18:12:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, e1c37d8b-c53a-4847-bc81-5b61ed59f592, 'Très bon, très moelleux. Les petits gâteaux se gardent plusieurs jours dans une boîte sans sécher du tout.', '2012-09-19T21:24:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 4ff9c971-e4f5-48a7-a524-d1a02ab11780, 'Miam miam. Très bonne recette. Tout le monde a adoré, même les plus petits. J''ai quand même diminué la quantité de sucre : 75 g au lieu de la quantité indiquée et c''est très bien comme ça et j''ai aussi nappé le gâteau avec du chocolat de couverture. Il a été dévoré aussi rapidement qu''un battement de cil. A refaire très souvent.', '2012-08-06T04:15:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, c857bbc3-b2f1-4932-94ef-2cb22594c1a3, 'J''ai remplacé les amandes par des noisettes éffilées, 2 cuillères à soupe de crème fraîche et 2 bananes. On obtient un gâteau très onctueux avec un goût de pralin et bananes. ', '2012-07-01T17:29:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 84586c7c-fb08-4238-b4d3-eec507d95a58, 'Un délice. J''ai ajouté un peu de cannelle et à la place de la banane j''ai mis de la pomme mais la prochaine fois je ferai avec banane. Un vrai régal !! ', '2012-06-23T23:13:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, cbc0f1c4-13c9-40d3-a321-6eef819f663e, 'Excellent mariage des 2 saveurs bananes et poudre d''amande. En plus, cela change des desserts classiques.', '2012-06-02T21:08:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 880b0567-e9ee-423f-8612-f223fa36e8c1, 'Très bonne recette!', '2012-04-15T20:51:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 9fa2398b-d209-4965-86dc-c42c6ffd9d6a, 'mon homme s''est régalé; pour ma part j''ai trouvé ça un peu bourratif...', '2012-03-31T15:08:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 377ed5bc-b3d0-4f0a-94c6-9e2835d2f420, 'Rapide et bonne. A faire la prochaine fois en ajoutant 1 cuillère à soupe d''eau de fleur d''oranger.', '2012-03-08T12:03:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 4ff93742-a388-4824-bb00-569cb2ba5da8, 'Super recette, goûteuse et moelleuse !', '2012-02-06T09:33:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, ab974ae6-b3f1-4559-b8cd-55dc4cfc7220, 'Fait avec 2 bananes trop mûres et cuit 30 min à 180°C. Mon mari en a mangé 3 de suite !', '2012-01-19T22:10:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 5f5f8485-c378-48ca-8b7a-7a4d85f101dc, 'Super simple à préparer aussi rapide à être déguster. Fait avec 2 bananes bien mûres. Tout le monde s''est régalé même mon fils qui n''aime pas les fruits en a repris. Je mets dans mes recettes préférées.  ', '2011-12-08T17:13:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 31660c4d-8b3b-4989-92d8-cb1dc8b28538, 'C''est délicieux ! J''ai pu utiliser mes 3 bananes trop mûres puis comme je n''avais pas d''amandes en poudre, j''ai concassé des amandes effilées, ça a donné un petit côté croquant.', '2011-11-14T10:25:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57979, 641fc77b-c2e5-4c8d-ab21-91e839bc4be5, 'J''ai rajouté des amandes effilées sur le gâteau. Il est excellent !!!', '2011-07-31T17:10:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, 4d05f49f-1630-4b64-9144-7c7eee4556f2, 'je fait et refait ce rhum arrangé avec 1l rhum blanc 50°- 70 cl rhum ambré 40° +  bâtons cannelle - étoiles badiane - gousse vanille + 1 ananas - 1 orange - 1 citron + 20cl sucre canne - c''est un régal au bout de 2 mois minimum et tous mes invités me demande la recette', '2021-03-12T19:04:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, e8dc293e-07b9-4ce5-b22f-ae2facebef0f, 'Excellent a refaire', '2020-12-31T00:32:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, 818b8c6c-268c-4da2-a0a2-9c038398cd19, 'Afin de conserver le rhum arrangé longtemps, je mets de la vanille, éventuellement de la cannelle et des zestes d''agrume comme l''orange, le chadek (quand j''en ai)... ou alors de graines de caféier ou de cacaoier. ', '2010-08-17T17:12:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, bbe511be-28c3-4c13-9f1b-fed782fd6a22, 'De retour de vacances de la réunion j''ai eu envie d''essayer cette recette en y mettant banane, ananas, fruit de la passion canelle et vanille ... Un délice mais il faut laisser veillir plus longtemps. Merci pour la recette.', '2009-12-05T17:41:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, f4d2abfb-e6b2-4768-96a5-73a7fdc2b908, 'Il faut beaucoup de fruits, et de bonne qualité et patienter beaucoup plus longtemps...', '2005-08-17T21:57:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, 3a841487-6124-4c7e-ba33-2600f40d3470, 'Plus c''est vieux, plus c''est bon... Ca marche aussi super bien avec des pruneaux.', '2002-09-06T22:04:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, bddc1f5c-bec2-424c-8473-593dff4a01b3, 'Super recette. Avec un rhum blanc 40° martiniquais (j''adore Maison La Mauny) c''est parfait.', '2020-01-07T16:46:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, 04f78358-33c2-42e7-95af-61bbab777113, 'Très bonne recette, goûter au bout de 1 mois et demi. À refaire.', '2019-12-14T07:36:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, bda99919-33c4-4266-8117-2793d6bdf2ac, 'Inciser la gousse de vanille en 2 pour libérer son arôme.', '2019-02-14T22:23:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, a0ab8170-0a38-4efe-bc5d-471cdd38a21f, 'Très bonne recette. J''ai ajouté des pruneaux, quelques tranches de clémentine et de la mangue. Il faut compter au moins 3 mois pour que le rhum prenne une belle couleur ambrée. C''est la quatrième fois que j''en fais avec toujours autant de succès !', '2014-02-08T18:16:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, 871d9e6f-06b0-44e9-b763-560a7aca6e5a, 'Depuis que j''avais trouvé la recette, je ne rêvais plus que de goûter...après quelques jours, nous avons goûté ce rhum aux fruits, quitte à être traités de gourmands. C''était très bon et très fin. (Peut-être un peu plus de vanille aurait été bien) Maintenant, nous laissons veillir un peu le reste! ', '2008-04-15T19:17:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, 475e745a-8257-4b2f-bd50-3801d24aef69, 'Parfumé à l''ananas c''est un délice, n''ayons pas peur des mots.', '2008-03-17T20:57:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, aeb17de0-43d6-427c-81e5-4d62c6de9804, 'J''ai essayé avec des pruneaux, le résultat est en effet exceptionnel !', '2004-09-26T22:57:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, ac19a70b-5e94-4d29-b0c4-cec93e12a06b, 'Comme tous les alcools blancs, on peut arranger  le rhum avec toutes sortes d''ingrédients plus ou moins exotiques: carambar, fraises tagada, etc. Selon les goûts bien sûr!', '2004-09-21T17:37:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, a602ac29-ba63-4198-98e2-bd12fbfe8e01, 'Petit plus: au lieu du mélange, faites un sirop (sucre de canne, vanille cannelle, zeste de citron vert muscade, eau) à mélanger avec le rhum et les fruits.', '2003-09-30T00:39:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, 0c6a20e9-aa1f-485a-a27b-ff7d45c914af, 'Variante : on peut faire macérer le tout dans une noix de coco, au lieu d''utiliser une bouteille en verre. Veillez à bien boucher l''orifice de la noix, afin de limiter l''évaportation du rhum... et attendre au moins 2 mois, le temps que l''alcool assèche l''intérieur de la noix.', '2001-06-23T21:03:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14074, 1494df52-3674-47a9-82aa-5c1d7fbe63c4, 'Dans ma recette, je mets un zeste entier d''orange, de la badianne, des raisins secs, canelle et vanille. A consommer avec modération...', '2001-05-08T17:45:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (319790, dc31faab-460f-46eb-ae47-1e5ea974c94e, 'Ce gâteau est très bon, il permet de finir un reste de céréales (j''ai mis des pétales de blé complet 120 g, des cornes flakes 50 g et des flocons d''avoine 30 g) ou des bananes trop mûres ! J''ai mis un oeuf entier et pas du tout de sucre (les bananes et le cacao (50 g de banania pour moi) le sucrent largement assez pour ma part). J''ai mis un peu moins de lait (il me restait 340 g et je ne voulais pas entamer une autre bouteille) et c''était parfait comme ça. Idéal pour le petit déjeuner.', '2016-04-08T17:40:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (319790, a30632e0-7bcc-45ed-ad9c-e1cdd9309e81, 'C''est facile mais dommage je trouve ça vraiment sucré.', '2016-08-26T15:21:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67870, a01507cd-8f01-46fc-8f07-945a87cf565d, 'Immangeable, il y a trop de café. Y aurait-il une erreur dans la liste, à essayer avec 2 cuillères à cafés et non 2 tasses à cafés.', '2008-04-16T23:34:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325081, 37d016f1-c815-45bc-9828-b3e2189d5eb1, 'Recette très gourmande, j''ai mis moins de beurre, pris du chocolat noir, ajouté une petite cuillère de rhum brun et utilisé une pâte feuilletée. 50 grs de beurre suffisent largement à mon goût. Au final délicieuse et rapide, il n''en reste plus... ??', '2020-10-06T22:10:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325081, 7d37e877-cf62-42a6-9050-3b4be40fa8a8, 'Très déçue par cette recette. La crème est vraiment très grasse et écoeurante (le mélange crème fraîche beurre dans ces quantités n''est pas une réussite !). J''ai ajouté 25 g de chocolat par rapport à la recette parce que 50 g me paraissait vraiment peu, mais le goût du chocolat est largement surpassé par celui des autres ingrédients, c''est dommage. J''ai également ajouté un sachet de sucre vanillé pour sucrer un peu la crème. Je ne referai pas cette recette.', '2014-10-19T12:31:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325081, c173856d-d962-436b-9ba5-26ed338b7c33, 'Un délice, mon nouveau dessert préféré !', '2014-08-20T21:16:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, e468c5a0-826a-4dbf-9052-9eeda762892e, 'Très bonne recette mais sans levure le gâteau est resté plat. Je vous conseille d''ajouter de la levure ! Autrement le gâteau est simple et rapide.', '2013-04-14T14:11:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, d692e17e-5e80-42bf-85d3-8602b650c068, 'Très bonne recette !!', '2023-06-02T07:45:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, c5ec3c38-b5ed-4560-86f1-98f513d93953, 'Recette parfaite ! ', '2020-05-02T20:56:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 2125becc-1987-4e24-9742-5a093054e524, 'Superbe gâteau, des convives toujours ravis.', '2019-11-17T15:16:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 1cea12be-bac8-45e3-a5e0-336207003394, 'Extra fondant une vraie réussite, j''ai juste ajouté des gros carrés de chocolat sur les bananes parce que nous sommes une famille très gourmande, et c''était un délice ! Merci.', '2018-11-23T19:51:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 19f24d63-face-42d7-bde6-7577b32b4bb1, 'Excellent gâteau pour les fans chocolat/banane ! En ce qui me concerne je double les quantités ce qui donne un beau gros gâteau délicieux !', '2017-01-21T13:07:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 8366eafd-179d-456f-a844-e02a6a4c7b55, 'Excellent gâteau. Je garde la base de ce gâteau pour en faire d''autres (mousse au Kinder a la place des bananes par exemple), car c''est la seule recette de gâteau au chocolat que je trouve pas sèche.', '2016-12-21T19:02:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 0ba40170-e2de-49fa-bfe8-03ed84894a33, 'Excellent ! Il a eu énormément de succès ! À tester avec d''autres fruits !', '2016-12-08T23:02:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 5427c59e-4516-4eda-8b55-33b82c5e89ef, 'Délicieux ! Ce gâteau est devenu un classique chez nous. Merci ! ', '2016-06-16T21:38:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, f1f98295-9a1d-4e1e-9c4d-9c03c0cfef8b, 'Les rondelles de bananes sont remontées à la surface lors de la cuisson, elles ont donc séchées et étaient dures. Je trouve la texture très lourde, très pâteuse.', '2016-03-14T15:45:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 824bd4c5-b764-4219-bde3-0d7d436f8924, 'Validé !', '2014-04-21T19:00:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, be931705-be83-4830-9e6a-57ec5ad33ab6, 'Vraiment très bon ! La cuisson était parfaite, toute la famille a adoré, je pense qu''on le refera souvent.', '2013-09-18T13:33:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 1d2ceab4-7850-4717-a9e0-b966fae87207, 'Excellent, j''ai juste ajouté un peu de levure. Merci', '2013-09-11T21:48:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, fe136702-25c8-43fc-aff9-df0100b964dc, 'Très bon gâteau sorti du frigo. Mes bananes n''étant pas très grosses, j''en ai mis 3. Par contre,il n''est pas très beau mais avec un peu de sucre glace, ça fera l''affaire !', '2013-08-20T13:15:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, f7883068-2c83-4419-aede-ed0585664ddd, 'Excellent !', '2013-03-04T16:48:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 57838371-5ad0-4499-9bdd-27e913ddb46d, 'Très bon !! Pour ma part,cette recette m''a permis "d''écouler" des bananes un peu trop mûres au goût de mes enfants !!!! Dans ce dessert,elles sont passées "comme une lettre à la poste" !!! En revanche,pour une texture plus légère et aérée, j''ai remplacé la farine par de la Maïzena...Effet moelleux garanti !!!! Merci pour cette recette', '2012-12-18T18:54:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 5f4cb8bf-f511-4624-8974-1a8166ac1a18, 'Nul... Il était tout liquide après 1h de cuisson.', '2012-11-24T18:51:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 257260c5-f133-404d-964d-7d0d07ceca78, 'Bon, à manger froid de préférence.', '2012-11-13T02:10:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, b1af6d2b-52fa-4adb-a6d3-95c804fd2162, 'Excellent, ça ressemble à un brownie pas très sucré. A tester avec une crème anglaise. Recette fondante, miam miam.', '2012-09-08T13:19:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, b28cba51-a24f-457f-92ae-663746824bf2, 'Décevant... Sans levure comment peut il ressembler à la photo ? C''est tout simplement un brownie à la banane avec plein de beurre... Et encore on ne sent que très peu la banane, le chocolat étant largement dominant !', '2012-08-25T16:03:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 6f0f83f8-50c0-447c-a537-b843b16578ee, 'Tel quel c''est assez lourd car le gâteau est très compact. Je l''ai refait avec un demi sachet de levure et les blancs montés en neige et c''est délicieux car beaucoup plus léger. Je conseille de le servir plutôt au goûter car c''est quand même assez copieux pour un dessert.', '2012-08-12T23:12:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 637c7ac5-9627-4781-ac67-2f1486403ff7, 'Un délice, nous avons adoré tous le monde en a repris, j''ai mis 100 g de sucre de peur que se soit trop amer pour les enfants, j''ai hésité à ajouter de la levure, heureusement que non ça aurai gâché tout l''intérêt de ce fondant... A refaire !', '2012-08-05T17:44:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 8ea41095-f401-4e93-92dd-6369ef655ead, 'Hmmmm super bon ! J''ai également mis moins de sucre et ajouter de la farine mais je pense que la prochaine je pousserai carrément jusqu''à 125g voire 150g pour que le gâteau soit plus consistant et moins "pâteux".', '2012-08-01T22:29:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, c9619ab4-1205-4f9e-94e0-65322b40dddb, 'J''ai fait la recette avec 3 bananes, la levure et temps de cuisson de 40 min à 150°C et bien avant de le servir je l''ai gouté par gourmandise et je l''ai trouvé un peu sec alors j''ai fait une sauce chocolat au lait vite fait avant de le servir à mes convives et là un carton ! ', '2012-04-11T11:31:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 754670ab-53c0-4095-a167-c9b4f429e5de, 'Excellent super bon recette respectée à la lettre mon mari a adoré ', '2012-03-21T21:10:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 2ca504dc-f56c-4393-84e3-4eaf0d7c86fc, 'Super bon, refait avec du chocolat au lait caramel, j''y reviendrai c''est sur!', '2012-03-20T18:35:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, ebda29ad-84bd-4756-a8c3-9ff56080e0ac, 'Grands amateurs de chocolat, ce gâteau n''a pas fait sensation. Très lourd pour une fin de repas. Pas sûre que je le referai.', '2012-03-15T19:07:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 36738e0d-22f1-4052-b234-83dc2dd913a4, 'Excellent et rapide à faire. J''ai mis deux bananes, ajouté un demi-sachet de levure et cuit le gâteau 40 minutes à 150 degrés. Ce gâteau est léger, moelleux et très bon. ', '2012-03-11T22:44:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 1f09d9d0-13aa-486f-b6f7-06d3c6a8c881, 'J''ai fait ce gâteau car les commentaires étaient excellents mais quelle déception ! La texture ressemble un peu à celle d''un flan et le goût n''a rien d''exceptionnel. Même mes invités, qui sont de gros gourmands, ne se sont servis qu''une part. Je ne le referai pas.', '2012-03-11T10:47:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 55015277-49d5-48bb-8b66-6ee1e1616351, 'Très bon ! Par contre, en suivant les conseils de Lysiane_14 je le trouve un peu plus sec (car moins de beurre?). Je l''ai refait avec la recette de base (+ une banane) c''est vraiment bon !!', '2012-03-08T19:19:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 0554012b-279d-45e7-ae85-cb2f6ff36917, 'Tout simplement excellent ! Le chocolat et la banane, tout ce que j''aime ! Ce gâteau est très facile à faire. Pour la cuisson c''est 150 degrés pendant 45 minutes et il sera très moelleux !! A refaire encore et encore ! ', '2012-02-29T01:42:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, c2892347-1aff-4cb2-8287-c7bab22adcc3, 'Très bon dessert !! J''ai suivi les commentaires de Lysiane_14 pour les ingrédients et c''était parfait. Merci !!', '2012-02-28T09:48:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 0b7790b3-74a3-4beb-90d2-90b6c539dcaa, 'Excellent dessert ! Meilleur froid que chaud. Attention aux commentaires ! Bien suivre la recette et les ingrédients, j''ai juste ajouté 1 sachet levure chimique et cuisson à 45 min. A refaire sans hésitation et sans modération..', '2012-02-12T13:09:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 94933860-0ec1-401f-b90e-bd3d87d5496a, 'Excellent ! J''ai suivi les conseils de Lysiane_14, pour le sucre, la farine et la levure, et ajouté 45 min de cuisson. Ça le rend moelleux et savoureux. Je le refais aujourd''hui, avec plaisir et gourmandise.', '2012-02-03T14:04:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 6dff84c0-9c77-4308-8823-c59b2d8c2618, 'Super recette, très facile à faire et grand succès ! J''ajouterai peut-être une banane la prochaine fois, mais c''est seulement une question de goût.', '2012-02-02T17:00:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 252c06fc-f2f4-454f-897f-879ae538253d, 'Nous avons beaucoup apprécié ce gâteau. Excellent, moelleux, à refaire en ajoutant de la banane. Merci.', '2012-01-29T18:08:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, e6344b10-07a7-4033-8d15-741e82c6751c, 'Pas mal mais très fort en chocolat, j''ai ajouté une banane supplémentaire et on ne sentait pas beaucoup le fruit par rapport au chocolat.', '2011-12-04T21:20:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 271d2126-2c14-4248-a142-ea6d7bf822b7, 'Gâteau moelleux et trop bon, j''ai modifié un peu les ingrédients en ajoutant de la levure chimique, et en réduisant le sucre à 80 g... Mon mari et mes enfants l''ont adoré... à refaire encore et encore, MERCI !!!!!', '2011-12-03T22:57:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, bce3d9bb-2e97-40db-af25-5807d2db19fb, 'Excellente recette ! J''ai suivi quelques conseils en ne mettant que 100 g de beurre et 60 g de sucre. J''ai ajouté 1 cuillerée à café de levure et mis 3 grosses bananes car j''ai fait se chevaucher les rondelles. Équilibre parfait entre le chocolat et la banane et entre les textures. Un gâteau qui va devenir un classique ! Merci.', '2011-09-24T19:38:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, d553dabe-901a-46af-a73e-f92ca37c5ab2, 'Vraiment délicieux ! Le cœur du gâteau était fondant, j''ai fait cuire 45 min, à refaire !', '2011-08-15T00:56:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, a5e42de0-29e6-4376-88b1-8cc3ae77fe9f, 'Très bon gâteau ce bananier j''ai juste réduit le chocolat à 150 g car on trouvait que le chocolat cachait trop le goût de la banane sinon c''est un très bon gâteau merci de nous avoir fait découvrir ce bon bananier ', '2011-06-29T16:31:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 60181eef-6b0c-4aa7-808c-5ecc7327b409, 'Très bon gâteau que j''ai réussi et j''ai refais 3 fois. J''ai juste modifié les ingrédients suite aux commentaires. J''ai mis 80 g de farine à la place de 50 g et ajouté 5 g de levure chimique. Un vrai délice !!!', '2011-05-13T21:57:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, a23770a2-2621-4c19-b81b-f7f664e1414c, 'J''ai fais cette recette aujourd''hui , j''ai tout fais comme il le fallait , mais le résultat n''est pas TOP du tout ! Je ne sais pas si il manque de farine ou de levure . Mais il ne tenait pas, il n''a pas gonflé. C''est un gros Flop pour moi. Malgré tout, le goût est super.', '2011-05-03T22:04:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 64271ea3-f681-4ff0-8f93-f7175e04659a, 'Fait dans des moules à muffin. Comme je dois faire très attention aux calories, j''ai remplacé le sucre par de l''édulcorant liquide, et le beurre fondu par de la crème liquide allégée que j''ai réchauffé et versé sur le chocolat. Couvrir avec une assiette, attendre puis remuer, technique rapide pour ne pas bruler le chocolat. Et le gout extra avec les bananes, miam. A refaire sans hésitation.', '2011-03-13T18:46:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, ab601d31-082d-4d9d-852e-f0e3d6547808, 'Très bon gâteau, à refaire, le goût, un peu amer, du chocolat se marie très bien avec la banane. ', '2011-02-15T10:48:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 021631d8-e135-43ea-b292-43da8eec1c47, 'Vraiment une superbe recette ! Je ne suis pas une grande "amatrice" de gâteau au chocolat mais là !!! Avec les bananes qui ont cuit à l''intérieur du chocolat... Terrible!', '2011-02-09T17:58:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, a40aa434-57ed-44a9-ba9c-42f931b1190d, 'Ben comme les avis étaient contradictoires sur la tenue du gâteau j''ai utilisé un robot pour bien mélanger la pâte, au final le gâteau était un peu tombé (rien à voir avec la photo) mais fondant, par contre je n''ai pas trouvé de goût aux bananes, à refaire peut-être avec des bananes très mûres', '2011-01-31T18:00:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, c7e339b7-6bc5-4495-84e6-421cd0fa3026, 'Un gâteau vraiment très très bon que j''ai plutôt assez bien réussi au goût de toute ma famille. Par contre je pensai qu''il gonflerait un peu plus mais aucun regret.', '2011-01-31T15:50:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, d1a67709-0e41-43fd-b0ff-c7da63949bd6, 'Délicieux, parfumé et très léger. A savourer avec une crème anglaise et c''est un dessert ou un goûter apprécié par toute la famille. Merci pour cette excellente recette.', '2011-01-29T20:25:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 457b836b-37fb-4a6c-94b4-3f2a219452d0, 'Parfait ce gâteau !!! Délicieux, vraiment ! Je le trouvais juste plus gros sur la photo...', '2011-01-21T18:07:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 6730c96a-1608-4651-a945-649f72d7ff44, 'Parfait ! Moi qui ne suis habituellement pas fan des gâteaux banane-chocolat, j''ai été conquise. Fondant à souhait, je pense quand même ajouter un peu de cacao amer la prochaine fois. Merci, je le referai sans hésiter !', '2010-11-15T21:11:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 84f1a18f-17d0-4227-87ba-c8d6a8223f5f, 'Il ne me restait qu''1 banane pour 2, alors j''ai choisi de faire la recette dans un moule en silicone pour muffins en réduisant tous les ingrédients par deux... Par "superstition" j''ai ajouté une cuillère à moka de levure... Et j''ai obtenu 8 muffins excellent, moelleux à souhaite avec un trés bon équilibre choco/banane... Super recette, apparemment inratable merci.', '2010-10-31T14:15:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 20205e75-b3b9-4f95-968e-f5b19651d087, 'Moelleux à souhait, très bon équilibre entre le chocolat et la banane... Une recette à faire et à refaire, sans aucune hésitation !', '2010-09-05T23:11:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 51d741df-80d4-42e2-b332-4ef9cfa74557, 'J''ai pris le temps de bien suivre tout à la lettre - le gâteau est devenu excellent ! Je suis surprise de voir qu''il y a des personnes qui ne l''ont pas réussi, chez moi il a fait l''unanimité, je l''ai refait 2 fois dans la même semaine. Le secret est sans doute dans la préparation minutieuse et dans le bon mixeur, car si les ingrédients ne sont pas bien mixés, le mélange n''est pas lisse et retombe après cuisson. Moi je n''ai pas eu ce problème !', '2010-05-05T16:10:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 0d40ddc5-ea90-4d4e-8fa4-1873cb19a31a, 'Moi aussi le gâteau est retombé. Mais ça n''a pas gâché son goût qui était tout à fait bon.', '2010-04-22T20:46:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, a89334ec-9130-42fd-93f7-18441df5ae02, 'Recette rapide et très facile, le mariage du chocolat avec ces morceaux de bananes fondantes est excellent ! Par contre j''ai rajouté 5 min de cuisson.', '2010-03-21T09:23:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, f03b08f5-4554-43e7-931f-793c1d66128c, 'Ce gâteau est un fondant vraiment délicieux et très facile à faire avec un peu de soin....Il faut mélanger parfaitement le chocolat fondu dans le beurre fondu lui aussi , puis les œufs un par un en battant bien, puis le sucre et la farine tamisée ..... Comme dans les recettes de fondant au chocolat .... Je donne ces précisions pour corriger les commentaires sévères de ceux qui n''ont pas su faire ce gâteau et ont mis des mauvaises notes injustifiées ! Ce n''est pas la recette qui cloche , c''est que la préparation a été mal faite ou les composants modifiés.....', '2010-02-18T17:46:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 2849f0bf-00be-4f58-ad65-df09ac603698, 'Il y a quelque chose qui ne va pas dans cette recette ou je ne l''ai pas bien comprise?! Le gâteau ne ressemble à rien, il n''est pas monté, dès que j''ai mis les œufs j''ai trouvé la consistance bizarre. En plus le beurre est resté en surface dans le mélange... Enfin c''est vraiment pas une réussite pour moi. ', '2009-09-30T03:59:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, 96c8f43f-6a54-42c2-a059-780a22bc820b, 'Gâteau fait et refait avec plutôt trois ou quatre bananes, quantité très bien supportée et quelques minutes de cuisson supplémentaires. Tiède c''est comme ça que je le préfère.', '2009-07-29T15:12:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15382, a1d73fe0-3540-4a91-810f-1190ddaadcf7, 'La recette a fait son effet, belle présentation. Avec 70 g de sucre et 70 g de farine, 100 g de beurre et du rhum. Cuisson 30 min à 180°C (thermostat 6). ', '2009-07-06T15:13:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12225, 60a3d19d-c093-4875-96c7-9e1d40378dc2, 'Il faut essayer de ne pas cuire le chocolat, cela dénature son gout.', '2008-12-30T17:54:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12225, ddc0e675-734f-4a28-b951-806e2b81399e, 'Trop de chocolat à mon goût...', '2005-04-24T19:04:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88114, 4f1bf091-b628-45e7-9f03-c10177129b1f, 'C''est super simple à faire et vraiment très bon. Je la refais régulièrement !', '2013-02-08T15:21:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88114, a816dfd8-c431-4e31-8b5d-d7b7dcf4e42a, 'Je les connaissais cuites à la poêle, j''ai testé les bananes rôties au four. Plus facile, plus présentable, et les bananes se délitent moins qu''à la poêle. Bref, très bien !', '2012-12-25T14:13:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88114, 90f34766-170a-4913-91dd-61fdfd7f9f62, 'Personnellement, j''adore cette recette ! Je la fais souvent, c''est un régal ! J''oublie parfois le gingembre, mais ça n''est pas dramatique. Je remplace la plupart du temps le citron vert par du citron jaune. Le jus restant, je m''en sers sur des crêpes, c''est délicieux !', '2009-11-25T01:47:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 849cc22c-6a42-4eec-bb5c-b26146478267, 'Le goût est au rdv ! Mais je rejoins d’autres avis, la texture de la pâte est trop molle à cause de la banane et ça fait plus une texture gâteau ou muffin que cookie. Cependant ça reste délicieux. ?', '2023-10-31T10:42:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, e1e15cec-e5c5-4429-8a05-661ae9bf0a61, 'Peut-être que pour certains ce ne sont pas des cookies car ils manquent de croustillants, mais le goût est là. ', '2021-05-07T20:07:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 83694ae1-73e7-4d42-954f-1cd818545c9c, 'Cela ressemble plus à des pancake mais le goût était incroyable ! J''ai remplacé la vanille par du sirop d''érable ! Et je recommande vivement !!', '2020-12-13T07:37:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, c3194eb1-d40e-48aa-b09a-de1934510aba, 'Très bonne recette, mais nous avons oublié l''oeuf 😅 et c''était parfait !', '2023-10-08T16:06:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, e0f2d2c0-d983-426b-9dbf-d913ca806061, 'Un peu trop sucré pourtant j''en ai mis moins que dans la recette, et cookies non croustillants mais ils se laissent manger', '2023-08-17T02:49:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 9447de57-da5c-4dcb-b7cc-68585b65ec93, 'J''ai mis du sucre de stevia à la place du vrai sucre et mis la moitié de chocolat, c''était largement assez sucré. Résultat 240 calories aux 100g ', '2023-05-18T13:51:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, b02c1bf6-0ce6-4b2a-bc24-66d19d8ef9db, 'Avec noix, noix de pécan, cajou, amandes incroyable', '2023-03-02T17:15:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, f93835ae-bf1f-4e16-ad74-be5928741fe9, 'J''ai ajouté 3/4 cuillères à soupe de farine et j''ai pratiquement pas mis de sucre. Ça ressemble plus à des scones qu''a des cookies. Ça reste très bon !', '2022-09-19T20:55:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, d0cc536c-91da-4557-977b-1b94b2f8ff50, 'Excellent, j''adore ! Je rejoins les autres sur le fait qu''ils soient mou mais cela ne me dérange pas', '2022-09-19T14:43:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, b1c47ccd-057e-432d-b34a-48ff60751d29, 'Le goût est au rdv ! Mais je rejoins d’autres avis, la texture de la pâte est trop molle à cause de la banane et ça fait plus une texture gâteau ou muffin que cookie. Cependant ça reste délicieux. 😋', '2020-08-25T00:00:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 791dc6a5-6248-4f36-97a6-5721d5678360, 'Trop mous pour des cookies.', '2019-11-23T07:26:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 6caef6e0-6e43-4fbf-809a-5e06ee940095, 'Bon, mais absolument pas des cookies. Mous et pas du tout croustillants.', '2019-11-04T14:32:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, b81ad309-a8ce-4b8a-a396-f292628b0b29, 'Un peu mou, recette parfaite pour faire des muffins !', '2019-08-15T08:07:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, cc71c3e3-7dcc-4bd7-8de3-d7a7aaa60058, 'J''ai modifié la recette qui était bien grasse : j''ai enlevé le beurre, mis un sachet entier de levure, 100 grammes de flocons d''avoine et 60 grammes de farine. Au final c''est super bon et on adore pour le goûter.', '2019-06-10T18:48:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, c75361ef-5861-41ec-9076-5b0392446d81, 'Personnellement j''ai adoré la texture extra je savais ce que cela donnerait avec les bananes, idéal pour le petit déjeuner.', '2018-12-23T16:11:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 1dcffddf-6971-4834-9354-8923bd2ce2d3, 'Pas convaincue par la texture. Ce ne sont pas des cookies.', '2017-10-08T00:46:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 39b8deca-bd87-41f9-a25c-ce1cbcaa4cba, 'Ayant préféré mettre du cacao en poudre au lieu des pépites j''ai été surprise par l''aspect de la pâte j''ai préféré tout verser dans un moule. En tout cas c''est super bon je testerai la prochaine fois avec des pépites pour une meilleure consistance.', '2017-07-19T17:20:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 4ef97504-84b9-4d8e-a8c2-3334c107e160, 'TROP BON ! À refaire !', '2017-04-29T10:22:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 1abbc90b-7cc4-4c5b-8fa2-8afa3523842e, 'Une recette devenue un grand classique !', '2017-03-26T19:24:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 7dff3806-5981-4c59-8ddb-29a138c01d3c, 'Plus proche du muffin que du cookie. Mais la recette est excellente !!', '2017-01-21T21:55:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, a698a18d-2326-4d5e-a256-63eb0c84e750, 'J''ai suivi la recette à la lettre et oui, ils ont la forme de cookies, oui ils ont une odeur gourmande mais non ce ne sont pas des cookies ! J''ai laissé cuire un peu plus longtemps espérant que le roi du croquant soit avec moi mais rien à faire, les gâteux sont mous... ', '2015-06-22T00:40:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 327a6763-4742-43c2-8ea2-58e03d8037f4, 'Très bons à la sortie du four mais déjà trop mous et ça s''arrange pas le lendemain. De plus ils sont un peu lourds à digérer (ajouter un peu de bicarbonate à la place du sel?). Bref ce sont des petits gâteaux assez bons mais ce n''est pas ce que je voulais en tapant "cookie" dans ma recherche. Serait-il possible de changer son intitulé ?', '2015-02-24T08:07:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 02a0acf1-3acf-4b22-8975-d2204f65449b, 'C''est un très bon biscuit tendre et moelleux son parfum banane est exquis. Mais à mon sens, ce n''est pas un cookie. Un cookie devrait être sablé, cassant... Ça n''enlève rien au bon goût de ce biscuit', '2014-11-04T08:17:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 79df3bfc-77e2-42b6-aa1f-f80d2bce1253, 'C''est vraiment délicieux !! Grâce aux commentaires j''ai adapté la recette et le résultat est convaincant. Voici mes petits changements 200 g de farine, 110 g de sucre, 50 g de noix de coco râpée, cuisson 12 à 14 minutes à 180°C chaleur tournante en fonction de la taille de vos tas. Mais SURTOUT faire refroidir les cookies sur une grille c''est ce qui leur donne leur croustillant. Les conserver dans une boite métallique. Bien sûr, ils restent légèrement moelleux au centre c''est top', '2014-10-22T00:03:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 3b9eb0ce-a3b9-4479-aa3a-50745da939fe, 'Pour ma part je les ai trouvé délicieux à la sortie du four, et plutôt réussi visuellement, mais quelques heures après, ils étaient déjà tout ramollis, ils se conservent mal (je les ai pourtant mis dans une boite hermétique). Il faut aussi bien surveiller la cuisson, ils crament assez vite. Mais l''association banane chocolat est quand même très bon !', '2014-07-26T14:42:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, c3472d16-7841-4e6e-86de-0fee6bc188d4, 'Très bons, moelleux, se marie très bien au chocolat, simple. Un vrai régal. Je n''hésiterai pas à la refaire, encore et encore ! Chez moi, on a apprécié !', '2014-07-10T01:12:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, c6b261bc-14e0-4099-a9a6-987a908c505f, 'Excellent car moelleux à souhait ! Tout le monde a adoré et avait du mal à s''arrêter !', '2014-07-06T19:39:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 6998244b-c9cb-4bc8-b15b-dea681a8915c, 'La petite famille subjuguée par le goût de la banane et le moelleux des cookies a adoré. PS: pour la cuisson de mon four à chaleur tournante, il m''a fallu 13-15 min avec 190°C. ', '2014-05-04T21:42:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, c5d22662-cd8a-439f-bc08-5cd94eb44ba7, 'Très bon ! J''ai cuit un tout petit peu plus longtemps: environ 10 minutes. ', '2014-04-06T18:53:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 04ea387c-6b65-47a2-b34f-41fdbc48a6df, 'Très bonne recette', '2014-03-25T21:07:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, c9a0f902-a0db-460b-825c-a0bd6a9a6f7f, 'De très bons cookies ! Mais la prochaine fois, j''ajouterai un peu plus de pépites de chocolat que ce que je n''en ai mises.', '2014-02-23T18:51:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 422d0f64-420a-4b8a-bd3f-27dbc3f6dd58, 'Bon petit gâteau, ressemble à un cookie mais pas au goût ! J''ai mis le four à 200°C mais ça n''a pas ce coté croustillant. Facile à faire et se laisse manger quand même.', '2013-11-14T16:56:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 582e76a5-62ea-40db-a145-1f562b3a19de, 'Bonne recette, mais il faut réduire la quantité du sucre.', '2013-10-04T23:52:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, b5fca045-6161-48a6-a2f3-42fcd5736c4e, 'Très simple, rapide, bon et moelleux', '2013-09-02T23:44:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 4b5e538d-b95d-4fc6-8cf0-38f09a32004d, 'Très savoureux, ma fille de 2 ans en réclame encore... A faire avec bananes très mures, c''est encore plus parfumé. ', '2013-08-15T14:53:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, c1481c12-e33e-4cbb-9f68-42007708169d, 'Cette recette est juste géniale! J''ai respecté tout les ingrédients (sauf la vanille que je n''avais pas) et les quantités. Je n''ai eu aucun problème à travailler la pâte. J''ai obtenu 36 cookies. 7 minutes au four à 190°C et c''est impeccable ! C''est effectivement plus simple sur du papier sulfurisé. ', '2013-06-18T19:53:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, e21be1f1-7a48-4c36-972d-dbfcd1caa91b, 'Très bon ! Super car on sent bien les bananes. Merci !!! ', '2013-04-24T21:21:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, d0995487-9857-4c01-8c97-24dae41e1634, 'C''est parfait ! Je trouve ça vraiment très bon (j''ajoute une sauce au chocolat avec).', '2013-03-28T08:44:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 9df41a18-3dc3-480f-aec7-5e645f32cd32, 'Un délice, moelleux et savoureux.', '2013-02-12T10:06:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 06ef1ea3-d515-44f7-ba03-2dfcfde6f3be, 'Moelleux et léger, tout le monde a adoré mes cookies. Le gout de banane dans un cookie est tout simplement délicieux ! Très bonne recette à faire et à re-faire !', '2013-01-31T23:56:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 86d04485-91f9-4493-b122-63e6b28cc952, 'J''ai fait cette recette en suivant les modifications apportées par Piero23 et se fut un vrai succès ! Des cookies à la banane qui ont la texture des cookies traditionnels. J''ai mis ma préparation au frigo (filmée) pour les faire cuire au dernier moment. Une fois froide, la préparation est beaucoup plus facile à travailler à la main.', '2012-12-10T15:22:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 99337a33-2e14-488e-ae8c-b614ae00f78e, 'On n''arrive pas à les faire un peu plus durs. Changé le temps de cuisson, la température de cuisson, rien à faire, c''est mou, mais çà reste tout à fait savoureux au gout.', '2012-11-29T16:32:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 9cfc9614-286f-463c-871e-745d8775e612, 'Ces gâteaux sont super bons, on sent bien la banane, mais ce ne sont pas des cookies. Il n''y a pas le côté croustillant du cookie, au contraire, ils restent tout le temps moelleux.', '2012-11-07T20:02:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 0ff4cef1-ee72-4c77-8734-248f0cad0e88, 'J''ai remplacé le chocolat par de la noix de coco, je suis d''accord ce ne sont pas de cookies mais c''est très bon et ils leur faut plus que 6/7 minutes de cuisson', '2012-11-02T16:05:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, a9805cab-0825-4f89-be82-f10d669e495a, 'C''est très bon. Le côté moelleux n''est pas dérangeant, au contraire. Prenez des bananes bien mûres c''est plus facile à écraser et ça a plus de goût.', '2012-10-06T14:36:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, e630c3e7-8d98-467d-9485-b919553c5e12, 'Ce ne sont pas des cookies. J''ai fait trois tournées, j''ai fait cuire trois fois différemment et jamais je n''ai eu le croustillant des cookies. Le goût est bon mais sans plus', '2012-04-29T21:50:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 99ef123a-246c-4891-a361-4cdac9c60bf2, 'Très bonne recette et facile ! J''ai mis juste moins de beurre (60 g).', '2012-04-24T23:11:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 21c53db3-5aa6-4ecf-a7db-d48d4cae3464, 'Ils ne sont pas aussi croquants que des cookies mais ils sont tellement bons, légèrement moelleux au milieu que l''on oublie ce détail. ', '2012-04-19T22:45:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 39cab8d6-37c7-4642-a534-6b773c9334bd, 'Excellent pour l''idée de la banane. perso ça ressemblait à de vrais cookies : 1 seule banane passée au mini hachoir 200 g de farine, 65 g de beurre, 90 g de sucre et une douzaine de carreaux de chocolats dessert en éclat. la banane rend la pâte impossible à manipuler à la main: bien vu pour la technique des 2 cuillères. j''obtiens 2 douzaine de petits cookies, très bon', '2012-04-15T21:09:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, e1a04100-e85d-470a-bd38-c36b7e8f2d26, 'La recette est excellente mais soit il faut les faire vraiment petits ou les laisser cuire une dixaine de minutes de chaque côté car c''est vraiment trop mou !', '2011-11-18T12:25:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 02a9d2d5-bf3b-42bb-a5bd-bc8a7ca25dbf, 'Je trouve la recette bonne, cependant à chaque fois que je les fais, les cookies sont mous et pratiquement pas croquants ! Comment ça se fait ? Pourtant  et je les dispose sur la plaque et les cuis comme indiqué dans la recette, puis je les laisse bien refroidir. Je pourrais peut-être les cuire plus longtemps mais ils risqueraient de brûler...', '2011-06-08T17:22:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 4baa9a22-59ae-440b-be4d-cf9b31984c28, 'Recette facile et rapide à faire, pour un excellent résultat ! Les cookies sont délicieusement parfumés, on sent vraiment bien le goût de la banane. N''ayant pas d''arôme vanille, j''ai remplacé par un sachet de sucre vanillé, et j''ai dû doubler le temps de cuisson indiqué (mais j''ai un four qui ne chauffe pas fort). Recette que je referai avec plaisir ! ', '2010-08-02T00:39:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 14a7d948-3fb1-4033-af19-89e9eeac92ec, 'Esthétiquement c''est plutot reussi! La cuisson est parfaite. En fait, j''ai mis la note de "pas mal", car c''est plus une question de goût. La banane donne un arôme un peu fort aux cookies...', '2009-10-11T19:36:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, f7727c17-9986-473e-87b7-7027dde06086, 'Excellents ! La banane ne se sent pas trop passée la cuisson, reste subtile et goûteuse à la fois ! En revanche, je confirme les commentaires laissés jusqu''à présent, la texture n''est pas du tout celle de cookies, mais plutôt de madeleines. Même mous, ils restent cependant très bons et ont été dévorés. Succulents tout juste sortis du frigo le lendemain aussi !', '2009-07-21T01:10:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 0c1df9e7-ba81-4265-ab74-d803d96ccd63, 'C''est bon, mais finalement dans des moules à madeleines ce serait des madeleines... et pas des cookies. Je referai le recette sans hésiter, mais sous forme de madeleine c''est sur. Merci en tout cas !', '2008-12-16T14:21:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, e8b6ef32-a137-4bce-92fc-2e3977e58caf, 'Le goût n''est pas mauvais, mais ce ne sont pas des cookies, il faudrait réviser le titre. Après les commentaires j''ai rajouté plus de 100 g de farine mais il y a peu de différence...C''est dommage.', '2008-08-28T16:00:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 827805e2-efdb-4f0b-bb24-01cf3a2ba67c, 'Très bonne recette cependant ils ont plus la consistance de muffin que de cookies. ', '2008-08-19T21:28:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, be858dd3-8b9c-431d-88e6-d168bca8d15d, 'Très très moelleux voire trop ! Niveau goût la banane masque le reste mais ça reste tout de même très bon !', '2008-04-12T13:25:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 9efd05a9-9ea7-4e77-91b9-958afa531be5, 'Très bon, très moelleux mais ce sont plus des mini crêpes que des cookies, ce n''est pas du tout croustillant sur les bords... enfin à part ça on s''est tous régalés!', '2007-01-26T18:27:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21674, 4a822cb2-9cc1-489e-ac23-f24d24ebdfb4, 'Super recette, rapide et efficace, à refaire! Très bien pour liquider les bananes oubliées. Pour éviter d''avoir quelque chose de trop mou, j''ai mis un peu plus de farine (200 g) et j''ai cuit les biscuits dans un four un peu moins chaud (150°C). Du coup, ça prend quelques minutes de plus, mais au moins, ça crâme moins vite et ça croustille un peu.', '2006-11-21T22:46:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392556, cecda9a9-fb33-4a86-b65d-0be5384bda6b, 'Très bon si on aime les gâteaux sans sucre ajouté ! Je mettrai plutôt de la farine d''épeautre que de la maïzena, plus "granuleuse" pour un crumble et j''avoue préférer le beurre ou la margarine dans une version végétale . L''ajout des poudres (amandes, coco, noisettes) fonctionne très bien avec n''importe quels fruits.', '2020-07-03T11:06:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (328286, 011cb83f-62ce-46b8-92c1-7608174dce83, 'Vous pouvez passer votre chemin... vraiment ...', '2014-10-19T02:30:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58118, 5e75efb7-9f27-49b1-89f5-ad031ce8070f, 'Faite plus d’une fois, excellent !', '2023-03-11T16:51:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58118, 888d584b-be1c-4990-8bdd-119c9e44b7f5, 'Très bien ', '2022-02-27T06:23:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58118, 8c687af6-ad18-4c8d-bfe5-bbc5500a4289, 'Très facile à faire à condition évidemment d''aimer la noix de coco râpée. Recette à garder en mémoire, surtout lorsque nous sommes nombreux à table. Vraiment excellent.', '2014-05-25T12:06:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12414, 063fe617-7017-4089-81cf-a02ee436ceae, 'Manque de moelleux, trop compact, et oubli des bananes dans la composition....', '2015-04-28T16:37:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12414, 3af380e2-22ff-4d7c-8706-eeb27c71b69f, 'Très sympa! Je n''ai pas fait ça dans des moules à muffins, mais des moules un peu plus petits. De cette facon le gâteau semble moins sec. J''ai soupoudré d''un peu de sucre et de gingembre avant d''enfourner. Quant aux bananes je les ai coupées en petits morceaux et intégrées au dernier moment. Prendre des bananes pas trop mûres de façon à ce que les morceaux ne deviennent pas purée lors du mélange!', '2007-04-30T14:21:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12414, f917690f-785a-4d79-9ad6-229622cd0467, 'Un peu déçue de cette recette. Les muffins sont compacts et pas assez sucrés. On va dire qu''ils tiennent au corps!! L''alliance banane - gingembre n''est pas des plus heureuses, mais ça c''est une affaire de goût perso. Il ne faut évidemment pas oublier d''ajouter de la banane ecrasee à la pâte puisque ce n''est pas dans l''ennoncé de la recette. Je reessaierais ces muffins, peut-être avec plus de lait pour davantage de moelleux et plus de miel ou de sucre.', '2007-02-11T11:18:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12414, 3f207e40-620f-429e-984c-6987b57941c2, 'Une chose à dire: dé-li-cieux!!! Suite aux précédents commentaires, j''ai réalisé les muffins en mettant de la levure et en utilisant de la farine avec levure incorporée, du coup ils étaient très moelleux. De plus j''ai mis des petits morceaux de gingembre confit et j''en ai réalisé une partie avec des pépites de chocolat en plus !!! A la sortir du four, c''est vraiment un pur régal !', '2006-09-16T18:23:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12414, 863b881d-48bb-4cfb-9dd7-665ec9ee5dda, 'Délicieux, mais n''oubliez pas d''ajouter les bananes (elles ne sont pas dans la recette)lol. A servir avec une glace au gingembre.', '2006-08-28T11:32:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12414, 4b286907-c887-4c30-8c42-764419b11e39, 'Pas assez de sucre à priori. J''en rajouterai un peu plus la prochaine fois.  En tout cas c''était très bon.', '2006-08-15T20:49:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12414, 0a6b5073-f2bf-4e49-9a15-1d0d22c62cad, 'J''ai utilisé de la farine normale à laquelle j''ai ajouté un demi-sachet de levure et une pincée de bicarbonate de soude,résultat les gâteaux ont bien levé et la texture est légere. Et pour les rendre plus gourmands, j''ai rajouté des morceaux de gingembre confit. Parfait!', '2006-05-08T22:52:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12414, f8b34ef6-cea6-4b2b-b042-7333145bd742, 'Mes premiers muffins!! Réalisés avec de la farine ordinaire, certains avaient encore quelques grumeaux de farine en sortant du four... Toutes les recettes de muffins que j''ai consultées disaient tellement de ne pas trop remuer que j''ai peut-être pas assez remué!!! Malgré ce détail, ils étaient excellents... Donc recette à refaire pour que ce soit parfait!!', '2005-02-24T11:02:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12414, 122749ad-fa47-477e-8121-2f4ecd605861, 'Trèès compacts. Pas mauvais, mais pas extra non plus. Je réessayerai en remplaçant la farine fermentante par de la farine + levure. Le miel, ça plombe bien un gâteau...', '2004-10-11T14:14:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12414, d59c1f77-faad-462d-ac36-86f9a9f58905, 'C''est pas mal ! Mais faut aimer le gingembre !!! J''essayerai la prochaine sans gingembre ! Sinon dans l''ensemble, très bonne recette, bonne texture ...', '2004-03-06T20:06:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12414, 39c9f5ee-8de8-485f-bbbe-088e0d5421c9, 'Ces muffins sont super et très originaux! Je conseille aux amateurs de ces petits gâteaux de les déguster chauds, accompagnés d''une crème anglaise.', '2003-10-29T16:07:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12414, 42bf3eef-1c9f-4a61-9858-75f81b27d780, 'Les muffins se démoulent très bien, sont très jolis. Quant au goût, j''avoue avoir été un peu déçue, les avoir trouvés un peu compacts. Ai-je commis une erreur dans la préparation?', '2002-07-23T14:13:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12414, 88859f9f-f87f-4e0e-90c0-5cbca95cec6a, 'Ces muffins sont délicieux car très moelleux et peu gras. Truc gourmand: rajouter quelques pépites de chocolat... Un délice!', '2001-12-10T11:06:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229056, d6595b9b-6cdb-43dd-ab89-86ac3a8b212f, 'J''ai utilisé un sachet de levure et cuit à 180°C (thermostat 6). Il faudrait ajouter plus de confiture de lait pour bien le sentir et plus de bananes ! Le gâteaux était léger et délicieux ! ', '2017-03-09T09:47:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229056, f39e8d26-ca75-40d5-96f7-f27bbd1cc58b, 'Que de bons ingrédients ! Bon goût mais manque de moelleux. A refaire avec 1 sachet entier de levure et une cuisson à 180°C afin de trouver le moelleux d''un gâteau au yaourt !', '2014-03-30T23:39:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (343954, ed6c86d6-c37e-490a-92a0-78f0b04b516e, 'Avec cassis très bon.', '2022-03-31T07:58:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32510, 1cc4871f-ef3a-42e0-b908-c7d6df9f3b05, 'Très bon, j''ai ajouté des raisins secs... Toute la famille s''est régalée !', '2013-11-09T00:07:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32510, c2bcc95e-384b-4086-be86-8e3a72a6218a, 'Ce gâteau est bon, mais pas exceptionnel. Peut-être faut-il mettre plus de bananes ou de pruneaux.', '2006-09-29T07:18:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32510, f63e7826-c6b2-4782-817c-933dd10f4307, 'J''ai bien aimé...A déguster également bien frais, le goût des fruits ressort encore plus.', '2005-05-26T00:21:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32510, 5f9c1205-5ee0-4bef-b791-c1c6bd746562, 'Très bon. Banane et pruneaux se marient bien. Je n''avais ni sucre brun ni margarine, j''ai donc fait avec sucre et beurre. Toasté avec du chèvre c''est effectivement délicieux!!', '2005-04-02T16:34:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36137, 3a983065-21e7-47a7-b1ac-5cce02542291, 'Petit dessert tout simple et vite fait pour cuisine familiale. J''ai mélangé avec des quartiers d''orange et de la cannelle avant d''enfourner. Tout le monde a aimé.', '2008-02-19T22:44:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42212, ad9fab10-a133-46f6-94e0-a888120a8379, 'Nous avons aimé.. mais sans la banane puisque certains ont dit "NON pas de banane s!" Merci pour la recette.', '2012-01-05T19:56:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42212, 9eb6ce39-36b6-458b-94b3-c8df43917a0e, 'J''ai voulu tester et j ai en fait gâché 2 beaux morceaux de cabillaud pourtant réelle adepte du sucré- salé je ne comprend pas l''engouement des personnes qui ont laisse les précédents commentaires ....la banane je veux bien à la limite mais le cacao était vraiment de trop ............', '2008-04-15T00:19:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42212, 7072276d-1c45-4c8e-ac7a-46011de1836a, 'Original, voire incongru mais j''adore!! J''ai fait la recette telle qu''elle a été écrite mais avec du cabillaud (dans ce cas réduire un peu le temps de cuisson). Merci !!', '2008-03-14T23:42:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42212, 0d5b031a-3bfd-4bb9-b6a0-2b6ad885f17a, 'Délicieux, même pour ceux qui n''aiment pas trop le mélange sucré/salé. Le lait de coco est vraiment indispensable. ', '2007-09-19T21:20:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42212, 74c57f5b-4b22-4edb-b866-6b49765cfe0b, 'C''est super bon! Quelle surprise !  Facile, rapide, et délicieux. Tout ce que j''aime. Merci.', '2007-07-01T19:24:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42212, 6d30294e-ee68-4178-a4a2-76722709f81e, 'Un délice! Si vous aimez les bananes, si vous aimez le sucré/salé... une autre idée du poisson !!', '2006-08-23T16:43:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42212, 313cd1d1-8779-4a79-8fd0-3dcc3f6ca74d, 'Pour tout les amateurs de salé/sucré, à essayer sans hésitation. Très osé mais très bon. Personnellement j''ai fais cette recette avec le poisson et je n''ai pas mis de cacao. ', '2006-03-10T19:04:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72921, 6e3bffe6-35e6-4730-9672-6452b6e9596b, 'J''ai mis moitié eau, moitié Pulco et j''ai mis la moitié du sucre c''est Nickel', '2022-07-04T15:33:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72921, d17619f8-984b-417e-866b-f2af965aaaf5, 'Très  bon  j''ai mis 3 bananes et la moitié d''eau  et moins de sucre au bout de 2 heures je l''ai mixé encore une fois puis 4 heures au congelateur super, délicieux ! merci', '2021-08-20T18:52:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72921, ff6c2b6f-1df2-43b6-a7f3-6c3cfef01b08, 'Délicieux, moitié moins d''eau et trois bananes pour ma part !! Peut être un peu plus onctueux avec un peu de lait.. a essayer ! ', '2016-02-08T04:59:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72921, a096d4a6-b839-43a7-8497-412087790d51, 'Bonne recette, facile à faire, mais il faut moitié moins d''eau. J''ai rajouté le jus d''un citron et du zeste, ce qui m''a bien plu. ', '2015-06-13T22:37:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72921, d56c2bd7-01bf-4e36-9044-83c40060c2bc, 'Très facile ! Excellent ! Également mis 25 cl d eau, sucre glace et sans œuf ni citron, 2 bananes ! Un régal ;)', '2014-04-16T02:53:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72921, f8b28b9a-67b9-44df-b196-9e94a0927f57, 'Avec une banane en plus et la moitié d''eau, c''était très crémeux. Tout le monde s''est régalé ! N''hésitez pas à utiliser cette bonne recette.', '2013-07-31T11:04:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72921, 203447d3-9654-47c7-98bb-3815e067dcc1, 'Je n''ai mis que 25 cl d''eau et pas de citron, mais j''ai mis un petit peu de concentré de sirop de banane, super rafraichissant !!!', '2010-07-17T22:03:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72921, b9557ebc-815a-4eda-bb05-5b636b2d9836, 'J''ai suivi les commentaires et tout le monde a aimé. top top top, merci', '2008-12-31T23:57:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72921, 458d0488-5cd3-44ee-aada-120cc95334f4, 'Vraiment très bon, suite au commentaire j''ai divisé l''eau par 2 et c''était parfait...Merci. ', '2008-08-05T00:18:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72921, 92a803a1-9b30-418f-9213-742876ae1091, 'Diviser la quantité d''eau par 2, autrement le résultat est beaucoup trop liquide.', '2008-08-01T16:02:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166892, 8c94b552-cede-4d2c-8b92-83ac20768981, 'Je l''ai goûté tout juste préparé, excellent, rien à redire... Mais après les 2 heures au frais, la banane a donné un très mauvais goût, à la fois âpre et un peu amer, pourtant mes fruits étaient mûrs à point. Je pense qu''il vaut mieux mettre tous les ingrédients au frais et préparer le smoothie au dernier moment, ou bien ajouter en plus quelques glaçons avant de mixer.', '2010-05-14T01:55:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166892, c827f2d1-1282-4ac4-8bbf-fc8f6852b7fc, 'Top! J’ai mis moins de miel, et remplacé le jus d’ananas par un peu d’eau! C’était nickel ', '2020-04-30T19:00:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166892, 50a51e92-a909-4130-b89a-e2596fc9ca66, 'Parfait avec glaçons et juste 2 kiwi.', '2020-01-06T03:36:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166892, 85aab826-85d5-4378-99ce-dbcac6d2ca1d, 'Trop bon et idéal pour commencer une journée vitaminée ', '2019-11-16T09:14:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166892, bb7c1368-e257-4bdd-8977-d2fd1d59faa0, 'Super bon. Pour ma part j’ai mis des glaçons et du sirop d’agave au lieu du miel. ', '2018-05-07T09:21:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166892, f068620a-8f8d-4075-9c99-ba3d86856dbe, 'Super ! Pour ma part je n''ai mis qu''une banane et j''ai ajouté des glaçons avant de mixer. ', '2017-02-14T15:55:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166892, 16503712-a706-470b-8585-a528b44fd3fc, 'Délicieux à refaire.', '2016-06-26T12:26:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201340, 56392753-6f23-4188-b2bf-035a49fb7df9, 'J''ai adoré. D''ailleurs toute ma famille a adoré. Remplacer le chou-fleur par des pommes de terre. Un délice.', '2016-11-12T22:55:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201340, df7039cd-8541-4c71-8ab3-d9c6995a81c4, 'Excellente recette ! Assaisonné au maximum avec les épices de la recette. Et du coup, c''était délicieux. Génial avec le chou fleur ! ', '2021-10-30T22:27:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201340, 53e9334d-ee34-43c7-b30b-d69c6fa77c2b, 'Recette très facile à faire. Cuisson parfaite mais un bémol car malgré le suivi de la recette, je trouve que le tout manque de saveurs, peut être devrait on ajouter d''autres épices ou le faire avec de l''agneau ? ', '2015-11-22T18:22:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201340, 20da88e7-53b1-4659-9417-f1a56daab317, 'Facile à faire mais il faut bien deux bonnes heures de cuisson pour que la viande soit moelleuse! être généreux sur les épices! ', '2015-09-20T10:52:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201340, c1c8583f-528a-40b8-889a-6b41e4417dd8, 'Le tajine de Hanane est un régal pour les papilles. Pour moi, le meilleur tajine jamais mangé. J''aimerais connaître cette cuisinière qui pourrait peut être faire Top Chef.', '2014-03-05T20:51:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201340, 5fae68d3-9a9c-491a-ba84-b1aad80ae986, 'Du filet mignon, des courgettes, des pois chiche, des pommes de terre.. cette variante était délicieuse. ', '2013-08-22T12:50:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201340, 31d2a289-0985-48d0-9292-05880dc0ec9a, 'Très bon. J''ai mis des pommes de terre.', '2013-03-11T15:19:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201340, 99a485f4-279e-4f95-a9d5-b850d584be88, 'Juste parfait !', '2012-05-30T14:38:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201340, c2f9daf9-71f1-42ff-b78e-c51e0cefc24a, 'Désolée, je n''ai pas aimé.', '2011-12-19T15:22:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201340, de573101-b596-4bf5-be3f-6b49dcbdf811, 'Vraiment bon !!!! Toutefois j''ai augmenté le temps de cuisson, deux bonnes heures et je n''ai pas mis de bouillon cube (j''en avais pas).', '2011-11-22T22:03:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201340, 40e77100-6331-4aa8-b397-1327a40e63cf, 'Super recette, facile à élaborer ! Je l''ai accommodé avec des carottes et des fonds d''artichauts. L''heure et demi de cuisson a été trop légère, j''ai du en ajouter une grosse demi heure ! Excellent tajine, merci Hanane.', '2011-09-12T00:01:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201340, 053e2fc3-f9ca-42a3-9858-5b7b089121ea, 'Très bonne recette. C''est la 1ère fois que je faisais un tajine et c''était une réussite. C''est très facile mais la préparation est longue. Je l''ai fait à l''agneau avec des pommes de terre et des carottes (sans semoule car les pommes de terre suffisent) et j''ai ajouté quelques pruneaux (mon mari adore). Mes invités se sont servi 2 voir 3 fois pour certains...', '2011-08-29T11:54:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, 54e56e0b-6417-4ce5-8b7e-f587e423988e, 'À ne surtout pas faire, impossible à retourner.', '2019-08-05T08:54:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, 4978a6e5-da83-4c1f-b9fc-cd3a40d44450, 'Très bon et rapide; Cette recette permet d''utiliser les bananes trop mures. Je fais cette recette régulièrement.', '2018-01-17T09:16:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, 23e0f229-245e-4fc0-9f3a-b242cffa05a0, 'Recette suivie à la lettre, facile à faire avec des enfants par exemple. Petite suggestion : un bouchon de rhum arrangé vanille pour donner plus de goût. Pour la cuisson, mettre un couvercle large sur la poêle et aucune difficulté pour retourner la crêpe car le dessus est ainsi presque déjà cuit. ', '2014-05-03T20:30:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, acc40dc8-8360-4ff6-a297-5fc46fe3190c, 'Avec une pâte à crêpes sans sucre et aromatisée au rhum. Les bananes sont bien assez naturellement sucrées. Une réussite !', '2023-01-29T17:52:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, c0c55715-81b1-4c02-9aa1-112214fb06fe, 'Très bonne recette ! Pour "8 personnes", mettez un 3ᵉ œuf et 60 cl. Étalez la pâte à crêpe en mettant la louche en contacte avec la poêle.', '2022-02-19T16:42:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, 1021ab5b-bbfb-4105-8805-69f51e786942, 'Très bonne recette ! J''ai mis 30 gr de sucre de canne et 1 sachet de sucre vanillé, et cela me semblait encore fort sucré. Pour le reste: Parfait et adoré par les enfants !', '2020-09-22T23:52:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, 3ae748af-8491-4ed8-893c-daffbd523ccb, 'Excellente recette que j’utilise souvent. On peut aussi ajouter des framboises dans la pâte crêpe. ', '2018-05-29T11:48:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, 0926d387-3ff6-4256-8d04-22b6283f9971, 'J''aime ça !', '2018-05-28T06:26:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, fc300920-717d-4a85-9bea-c226a20ba964, 'Parfait, je mettrai juste un peu moins de sucre !', '2016-09-06T01:26:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, bf405314-8e9e-4143-b33e-6cd42c8b46ad, 'Vraiment bon ! Mais j''ai opté pour une seul banane à la place de deux ', '2016-04-16T12:50:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, 625e4468-2046-4a47-a24c-cf789576ca6d, 'J''ai testé cette recette puisque j''avais des bananes trop mures. Au début, c''était de la charpie, impossible de retourner la "crêpe", ça collait à la poêle. Ça commençait mal ! Puis, il faut trouver "LA" technique qui convient. Une poêle bien huilée et ne surtout pas vouloir faire comme des vraies crêpes mais plutôt des pancakes. Et là, avec un temps de cuisson approprié, ça roule et ça se retourne tout seul avec une pelle à tarte. Niveau saveur, il faut bien entendu aimer la banane. ', '2016-02-02T21:42:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, cc1b4ea4-19c2-40c2-baf3-83cce6b8faaf, 'On peut faire la même recette avec des pommes râpés, trop bon !', '2016-01-31T17:27:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, 485bb45c-84a4-4a1f-a3da-99fe3459380c, 'Délicieux. On s''est régalé. ', '2016-01-11T18:09:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, 9f4e3967-6791-4f35-aeb5-aed2557fdf9c, 'C''est plutôt des pancakes que des crêpes. Je n''ai pas eu de pb particulier à les démouler. Avec ces proportions j''ai fait 7 pancakes. C''est bon mais ça sent bien la banane (surtout avec 1/2 bouchon de rhum brun :))', '2015-10-11T13:37:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, 5baf49d7-2e55-41ca-a39f-87c46228c35b, 'C''est bon mais les crêpes sont beaucoup trop difficiles à retourner et manipuler. Les premières étaient un peu comme de la purée et pas assez cuites. Je pense que des pancakes à la banane, au lieu de crêpes, seraient meilleures.', '2015-02-07T12:52:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, eebf4faa-f84e-440f-a3df-42bf89b8894f, 'Parfaite ! avec un peu de rhum pour les adultes, sans pour les enfants. Tout le monde s''est régalé et ça permet de ne pas jeter les bananes trop mûres. merci', '2014-10-25T10:20:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, a86b78a9-d4e9-439b-a5b1-b67492b6b164, 'Délicieux ! Effectivement un peu compliqué à retourner. Lles enfants ajoutent du nutella dessus', '2012-07-12T18:19:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, 081cb8dc-6d86-4d8e-97e3-9dc9321c6c32, 'Recette intéressante. Bien faire attention à ce que les bananes soient très mûres car sinon c''est pas bon, il y a comme un goût de "vert" dans la pâte et ça gâche tout. Je conseille aussi d''ajouter plusieurs verres d''eau, ou un demi-verre de bière car sinon la pâte est trop consistante.', '2012-02-12T17:56:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, 19ec7986-f923-4a8c-8dc6-3065c5478fcb, 'Extra bon !!!!!!!!!!!!!!!! Et pour la retourner, un petit peu plus de cuisson et ça se retourne tout seul !!!! Mes enfants ont adoré !!!', '2011-06-22T18:50:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57030, 0d0ef2e0-4ff4-4a08-bc39-f0b41b34c607, 'Original très bon et facile à faire, j''ai épaté tous mes amis. A refaire...', '2010-10-21T16:28:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222990, e1113b81-98ff-4c54-b56b-e5375a9d186b, 'Rien à ajouter, tout simplement excellent ! ', '2014-03-28T03:07:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222990, 32191868-d6ab-466e-8645-f2f94e8d7b05, 'Très bonnes proportions résultat final excellent.', '2013-05-09T15:20:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83817, 677ad719-7c50-48cf-a618-51f785a69ddb, 'Une très bonne recette. Je l''ai essayée 2 fois avec un succès et des félicitations de mes invités.', '2009-04-10T22:31:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24411, d39c94c9-8cd8-4ebe-87bb-295fbb3f8ba3, 'Y a comme un loupé niveau proportions…. Mon cake n''a quasiment pas levé.', '2022-03-27T20:36:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24411, 6afa212d-551b-4282-abfc-84e74836dd9e, 'Recette au top ! J''ai remplacé les raisins par 50 g de noix de pécan et c''était très bon :)', '2014-08-03T21:18:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24411, 3241241c-2cae-4e49-9809-565c9f8a284d, 'Juste trop bon ! J''ai moi aussi préféré utiliser 125g de farine et 125g de Maïzena, et 2 oeufs pour plus de légèreté. Un gâteau très léger et très parfumé : c''est un franc succès ! Je n''ai pas écrasé les bananes car je trouve que les écraser leur enlève toute leur saveur, j''ai donc préféré les couper en rondelles. À refaire !', '2014-04-23T19:36:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24411, a60ffacd-18eb-4f68-b64f-362bf5fde465, 'Excellent ! Il me restait deux bananes trop mûre, et je suis tombé sur cette recette. J''ai fait quelques modifications : 125g de farine et 125g de maïzena, j''ai imbibé les raisins dans le rhum et j''en ai également rajouté un peu dans la préparation. Je l''ai cuit 35 min à 180°C et je l''ai encore laissé 10 minutes à four éteint. Un succès total !', '2014-02-05T12:36:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24411, f9666043-5020-4c9b-bb38-c27207488dac, 'Super recette ! Grâce aux commentaires, j''ai ajouté un œuf et pour le rendre plus léger, au lieu des 250 g de farine, j''ai mis 125 g de farine et 125 g de maïzena ! Résultat parfait ! A refaire, c''est un délice ! J''ai bluffé mes invités qui s''attendant à quelque chose de lourd et indigeste !', '2013-12-18T17:51:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24411, f9f974b9-5a64-4709-8819-815161fa18db, 'Facile à préparer et délicieux.', '2013-01-06T23:56:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24411, 3d2f9ccc-71df-407d-8665-bf17fe051127, 'J''ai beaucoup aimé ce cake "énergétique" que j''emmène en montagne. Il est juste sucré comme il le faut et on apprécie son goût de banane (je n''en n''ai mis que 2, j''essaierai avec 3 la prochaine fois). Il se coupe facilement et peut se manger sans problème le lendemain. Merci pour cette recette.', '2009-01-04T21:19:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24411, 6178454f-46fc-4a78-ba0a-68b102504f56, 'Bravo à ceux et celles qui ont réussi à faire un cake mangeable à partir de cette recette. Perso, suivie à la lettre sauf noix en poudre. Résultat: immangeable. Juste un oeuf pour 250 g de farine.J''avais djà un doute. Je n''appelle pas ça un cake, mais un pain étouffe-chrétien. Quel gâchis. Dommage...', '2008-09-28T23:39:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24411, f70912d8-7d0e-4d3a-bcdd-b777694a8406, 'J''ai fait ce cake sans noix ni canelle, et j''ai mis 3 bananes. C''est délicieux et contrairement à ce que je pensais, ce cake n''est ni lourd ni écoeurant... A REFAIRE!', '2008-05-08T12:05:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24411, aa0e95c5-0e4f-4d79-81a6-2492a3d6ae35, 'Sans noix et avec 1 yaourt à la place de la crème mais parfait quand même!', '2008-03-24T18:29:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24411, 1a06fd51-7062-45d3-a721-adf8c08cc6e6, 'Je n''ai mis que 2 bananes, c''est largement suffisant pour parfumer et j''ai oublié de laisser tremper les raisins. Néanmoins, recette appréciée par tout le monde, petits et grands.', '2008-01-29T13:29:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24411, dfb7be44-5862-4383-a86c-c051457d602b, 'Très bon, les filles en redemandent !!!', '2007-12-31T15:10:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24411, d4c719cf-4a11-49ed-992d-b3e3e0bd1329, 'Un délice. Comme on n''est que deux à la maison, on en a mangé toute la semaine! Au goûter, au petit déjeuner... Il se conserve très bien.', '2007-11-27T19:51:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24411, f5e13a7c-535a-4f44-8dad-83138a0a3d3a, 'Très bon ; j''ai juste diminué la dose de sucre, mis des raisins frais et légèrement moins de bananes.', '2007-10-24T11:03:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24411, e383778a-c0af-4ed3-9b77-1d84ed2f19df, 'J''ai remplacé les raisins par des pépites de chocolat et mes collègues ont adoré! La prochaine fois, j''en ferai un pour moi toute seule.', '2007-09-21T21:39:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43951, 1fc8657a-21ac-46e7-98c0-70816e30c6d2, 'J''ai oublié le rhum et, même nature, l''association banane-avocat est superbement incroyable ! Excellent! Grand succès à table ! Merci', '2016-09-15T13:13:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43951, 0e2b08d3-dc37-40ac-9a8a-d2577d9f7f54, 'Le mariage avocat/banane est top !', '2012-09-18T19:52:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43951, c09faf3f-fc53-4dd6-acbd-9274b4fe21e6, 'C''est marrant à essayer par rapport aux ingrédients, çà se mange mais je n''en ferai pas des folies', '2010-11-27T08:32:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43951, cef85041-53f5-47f0-b462-5d07f561f793, 'Ma fille vient de nous faire ce dessert : surprenant ! A l''évocation des ingredients nous etions plutot sur la defensive. La couleur vert pomme est surprenante. La consistance en bouche est tres agreable. La banane ne domine pas trop, mais efface l''avocat. A essayer !', '2009-10-28T22:06:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43951, ad8ea981-7fae-4eeb-8dc0-92a93a187b68, 'Excellent dessert! Je mets aussi 2 bananes pour 1 avocat, et ajoute de la noix de coco en poudre dessus, cela cache l''oxydation inévitable apparaissant pendant le temps de pose au frigo. Bon moment passé entre amis, à faire deviner les ingrédients qui composent ce dessert.', '2006-10-12T11:24:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43951, 4a325cd3-7cdf-4872-8aa1-d71985bb69f2, 'C''est très bon! Moi, je rajoute de la noix de coco râpée, juste avant de servir, et c''est pas mal non plus!!!', '2006-04-07T19:52:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43951, a5e8ea14-a531-447f-86bd-312459267ff8, 'Pas mal du tout! Petite douceur onctueuse et ultra simple qui permet de varier les desserts, au quotidien comme pour un dîner d''amis. La banane a cependant tendance à dominer, surtout lorsqu''elle est très mûre. A la deuxième tentative, je n''ai mis que 2 bananes pour 1 (gros) avocat et j''ai rajouté le jus d''1/2 citron vert pour relever un peu le tout. ', '2006-02-02T15:58:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224527, ccc1fa61-07fd-47f7-ae39-39d99b73bc29, 'Excellent !! J''ai ajouté quelques framboises écrasées pour apporter un peu d''acidité. ', '2014-08-17T00:37:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224527, a4eb9bf5-effb-4b74-bef8-ee75d001deec, 'Une tuerie !!!!! J''ajoute un peu de miel', '2013-11-25T02:48:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224527, 4588a727-41f8-43ff-82a5-a157cccfedfc, 'Testée et approuvée ! J''ai mis 3 pommes, 2 bananes et 1 poire avec un peu plus de pâte. J''ai ajouté également un peu de cannelle, je vous le conseille ça donne un goût délicieux. Avec de la chantilly faite maison, un petit plus et un vrai régal. Bien sûr avec modération. Bon appétit !', '2012-04-28T19:43:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, 5235929d-dce1-44b4-ae27-97346023a809, 'Délicieux !!! Idéal pour un goûter car très riche. Excellent aussi avec des poires.', '2013-10-27T12:59:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, 42c14d85-5b50-49f7-8fd9-9b9f5c8e8a27, 'Moi suis plutôt salé que sucré et fondant, mi cuit ou moelleux au chocolat, je voulais changer de registre cette fois en choisissant cette recette. Quelle belle surprise ! Une vraie réussite avec des pommes à la place des bananes (moins sucré). Toute la tablée a adoré. Merci encore', '2010-06-22T10:48:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, 3a3ac53f-d668-410d-b610-5350cb0d3076, 'Recette testée par mon beau père et goutée par nous! Un régal!! Dessert très copieux alors pour en profiter au maximum à déguster après un repas léger.', '2008-02-03T12:35:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, 81197fa7-44e5-44e4-87b6-980f762a852f, 'Très bonne recette! J''ai simplifié en utilisant de la frangipane prête à l''emploi (ou on rajoute seulement de l''eau) ;-). J''ai aussi utilisé du chocolat aux noisettes, ça va trrrrèèès bien!!', '2007-01-30T11:35:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, 4e3618f2-b72b-445a-a6b7-7776dfec6694, 'Très bonne recette. Après un repas léger de préférence.', '2006-07-24T12:27:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, 45240971-13b5-418d-9f7c-2440d4413e00, 'Le goût est délicieux, toutefois cette recette est beaucoup trop riche en matière grasse et rend la tarte un peu écoeurante. A refaire, avec moins de beurre (et/ou de crème), en ce qui me concerne, et ça sera vraiment parfait!', '2006-03-16T15:09:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, 91843f2d-c1d6-469b-b4f9-5c24f2903c67, 'Avec des lamelles de pommes rissolées, cette recette "Tarte frangipane aux pommes et chocolat" se révèle une variante délicieusement plus acidulée !', '2005-04-07T17:20:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, d7259a1f-0996-4e51-b073-3da8aacccaa3, 'La meilleure alliance banane/chocolat en tarte que je connaisse... malgré le fait qu''elle cale drôlement bien, elle n''a pas duré longtemps!!', '2005-04-04T22:02:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, f4002e78-6bf8-42ce-868d-6e10d402d628, 'Trop bonne!! Réduire la quantité de beurre car sinon c''est trop gras. Tout le monde a adoré!', '2005-02-16T19:35:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, 3b4a8831-17b2-4c02-9696-82e698de8e33, 'Délicieux! Peut-être un peu trop sucré... A déguster chaud avec une boule de glace!!', '2005-02-02T18:22:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, 877a042c-d5e7-40ea-aaa6-ea785287be06, 'Tout le monde a aimé mais personne n''a pu terminer sa part ! Cette tarte est bonne au goût mais un peu "lourde". A déguster pour 4 heures plus qu''en fin de repas.', '2005-01-24T16:10:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, 6e62c469-1270-45ef-b987-8a53700449b5, 'Délicieuse ! Rien de plus à dire. Comme je n''avais pas de chocolat praliné, j''ai utilisé du chocolat noir pâtissier et ça a été un régal.', '2004-11-18T12:42:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, 52727189-c33b-47c4-a997-0c165f8e808c, 'Tarte très appréciée une fois que j''ai compris comment éviter que le chocolat et la crème d''amande ne se mélangent (parce qu''alors là, c''est pas beau!!).', '2004-11-11T15:38:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, 5a7189b2-5bf7-42d2-a2de-651b10044402, 'Merveilleux!! Splendide... Tout le monde a adoré à la maison et cette tarte n''a pas survécu bien longtemps. ;) Encore meilleure chaude car le chocolat est bien fondant (je la passe 15 secondes au micro-ondes lorsqu''elle est refroidie).', '2004-10-21T22:56:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, 058094a1-b089-460e-a781-8b96be87abfe, 'Très bonne. Peut-être un peu trop sucré pour moi, mais à faire absolument, c''est un vrai régal! Merci pour cette recette.', '2004-10-21T19:36:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, 4a3b01e6-dca9-49aa-89e4-4cd7d183473f, 'Très bonne! Merci pour cette recette!', '2004-04-04T18:50:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22610, 110d5183-1c62-4a19-9586-7967f6300338, 'Tarte vraiment délicieuse. Nous nous sommes tous vraiment régalés. A essayer sans attendre!!!', '2003-05-27T23:34:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39742, 03332c3d-490e-4af9-a0ac-36cc242ccdc7, 'Le goût est bon, mais les rondelles de banane ont tendance à noircir, et l''ensemble est finalement un peu sec.', '2014-03-19T12:45:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, 063e2396-97a6-4849-9fc1-62ee2367385e, 'Ce plat est divin ! Ce mélange de la banane caramélisée avec du riz, de la chipolata, du poivron, et de l''oeuf... c''est juste délicieux ! Mon fils de 5 ans adore aussi ! Merci pour cette recette.', '2016-03-30T17:28:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, 3c1e017a-f52c-407c-bc5a-23cc2678ccee, 'Très bonne recette ! J''ai mélangé le tout (riz, sauce et légumes) et j''ai ajouté les bananes et les saucisses par dessus. ', '2021-06-17T19:43:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, d75b7aff-619a-48fc-af10-1a4f737108eb, 'Facile, très bon.', '2020-03-07T02:35:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, d50570d1-486f-493a-9fa1-f86eb0336381, 'Bon mais beaucoup de travail par rapport au résultat. Je ne referai pas', '2019-05-23T23:09:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, 331f9c91-c553-44bd-8fed-9f9190890534, 'Un plat au top ! Super bon, savoureux.
Pour gagner du temps au niveau de la préparation, je mets au hachoir les poivrons, les oignons et l''ail : un gain de temps considérable.Et les bananes je choisi des bananes plantains mures et c''est excellent.', '2017-07-25T23:51:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, eea802a2-45fd-4527-b264-e83bbfc5c221, 'Très bonne recette, un peu copieuse par contre. Les différents ingrédients se marient parfaitement.', '2015-09-13T16:37:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, 2c5de971-102b-42e4-b283-83bac51856d4, 'Entièrement d''accord avec FloGaleo. Trop de travail pour le résultat même si c''est un bon plat aux saveurs originales.', '2014-11-09T14:17:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, 143baed3-12bd-44fc-b7fe-fd0b06e3ac95, 'Je ne serai pas aussi dithyrambique que les autres ! Un peu déçue par ce plat. Ce n''est pas mauvais, mais je trouve que c''est un plat long à préparer (et beaucoup de vaisselle puisqu''il faut tout cuire dans des poêles/casseroles séparées !) pour un résultat décevant. Si je refais cette recette, je remplacerais les bananes douces par des bananes plantain bien mûres et frites dans l''huile. ', '2014-07-21T14:27:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, 921512fb-8753-46d0-8329-11e2e83874cd, 'THE recette de marmiton. C''est devenu mon plat préféré mille mercis d''avoir partagé cette recette de fooooolie ! ', '2014-07-03T04:03:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, e79f338c-09a1-418a-aee8-03375b3e1baf, 'Une recette étonnante et excellente.', '2013-11-23T18:22:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, 0cd7abd7-beb0-4caa-8527-872fb8711ba7, 'Excellent, exotique, rempli de saveurs qui se distinguent et surprennent car elles s''accordent plutôt bien.', '2013-06-29T21:29:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, b899c20c-62a3-4f47-a6f5-971d5a0bb7e1, 'Bon et rapide.', '2012-09-26T02:18:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, e44c1b18-b2e3-42f2-bf5a-68b89727ed7d, 'Super bon plat, c''est vraiment exotique avec la banane mais oui il faut faire des tranches assez épaisses car ça devient vite bouillie. Sinon c''est assez copieux lorsque l''on met tout mais c''est très bon comme ça !', '2012-06-05T23:36:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, cce86d5f-a4e7-40c6-a30a-6a061fdc3005, 'Mes parents ont adoré, ainsi que moi même. La chipo et l''oeuf au plat se marient très bien...cependant le mélange sucré/salé avec la banane est assez spécial. Très bon, et à consommer au moment d''une grosse faim.', '2009-11-15T15:14:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, ae2ba187-5f29-4847-958e-6e1862a94b1d, 'J''ai beaucoup aimé, mon homme aussi... Nous sommes tous deux d''origine africaine mais nous avons trouvé ce plat "exotique" ! Facile et rapide ! Merci', '2009-11-12T01:36:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, 31e36dd5-ba32-42be-be0a-b7b7236eacbd, 'C''est vraiment très bon! Bien sur il faut aimer la banane grillée. Je l''ai servie à part comme cela chacun a fait son mélange comme il veut. Personnellement je trouve que sans la banane cela perd de son intérêt mais chacun ses goûts! ', '2008-10-07T00:28:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, f37ade6d-012b-48f6-a0e5-ff24862e9828, 'Effectivement, c''est original, voire même spécial, mais c''est délicieux!! A réserver toutefois aux amateurs d''exotisme et aux grands mangeurs. Merci Ly-lou.', '2008-10-02T23:37:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, f0d61625-eb7d-4497-9212-4efff8f937d7, 'Cette recette, sans la sauce en ce qui me concerne, est une de mes recettes d''enfance préférées. L''association "Riz + banane + saucisse + oeufs" est étonnamment divine.', '2007-03-09T14:12:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, 1baaa8f6-7ec8-4e24-977b-548d2eecbb31, 'Détonant! Super recette originale mais faut avoir grand faim :o)', '2005-11-10T11:02:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, 5a6bb7b7-bcd8-4e6b-b449-94735d075e65, 'L''association saucisse-banane-tomate est assez surprenante et pas terrible au goût. Je ne la recommencerai pas.', '2005-03-04T20:07:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, ab479fd4-cd0a-40fd-b036-73d5fcf06378, 'Très bon! Mais très copieux, j''ai servi sans les oeufs!!! J''ai eu aussi un petit problème avec les bananes, je les ai coupées en 2 dans la longueur. La prochaine fois, j''essayerai en tranches assez épaisses.', '2004-09-02T18:15:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, 099735da-eb52-4291-aa62-98c38e789988, 'C''est bon!! (même sans les saucisses, pour les végétariens)', '2004-06-25T13:51:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16811, d3dd407e-ccfd-425b-9e42-f07b93d01e94, 'Très bonne recette facile à faire! J''ai fait cuire le riz avec la sauce aux poivrons et j''ai ajouté 2 fois et demi son volume d''eau dans un wok.', '2003-11-01T15:51:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25051, 449298a6-df40-4c4c-a060-d979a768242e, 'Compote préparée avec un fond d''eau lors de la cuisson puis une fois sortie du feu, j''ai ajouté de la vanille liquide. 
Je n''ai rien mis sur le dessus de la tarte. Elle est excellente. Elle n''a pas duré plus de 3h !', '2022-04-17T20:24:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25051, 4c21da88-d54b-4680-a8b6-e24466909f93, 'Recette excellente, particulièrement savoureuse !', '2017-03-13T14:26:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25051, 82f3a842-8cec-43d5-8161-a67f996b1d8c, 'Un délice cette tarte ! Trop bon. J''ai utilisé en tout 40 g de sucre. Ma chérie et moi nous sommes régalés. Merci ', '2014-05-11T03:15:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25051, 7a1be529-3383-40e4-bbeb-36365f00c2e3, 'Très bonne. Une goutte de rhum ne serait pas de trop. Délicieuse.', '2014-03-18T21:38:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25051, 957af551-f972-4162-a6b0-dc042e7cb57e, 'C''est un classique pour moi depuis plusieurs années. Je n''avais jamais pris le temps de mettre un commentaire, c''est chose faite ! Tarte ultra simple et délicieuse... A faire sans hésiter.', '2011-06-01T20:15:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48563, 5b787b9f-2473-46a1-985a-e522e35dcf7b, 'Recette simple et délicieuse, mais pour ma part je conseille aussi de cuire les fraises à la poêle (j''ai fait cette recette 2 fois, la 1ère sans problème et la 2ème fois les fraises ont rendu de l''eau). J''ai mis un peu plus de crumble et c''était top !', '2013-05-20T21:06:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48563, 20d1ca5f-e5a9-4603-9934-7d26110b3bb3, 'J''ai mis le double de pâte pour la même quantité de fruit (parce que j''aime beaucoup la croûte dans le crumble !) C''était un succès, tout le monde a aimé et il en est pas resté une miette !!', '2012-06-26T11:54:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48563, 67e5c627-eee1-4776-91e4-20a554d120f2, 'Il est très bon et mes fraises n''ont pas rendu d''eau. Par contre j''ai remplacé la noix de coco râpée par des noix de pécan broyées et c''est super bon.', '2009-04-28T15:06:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48563, e4b0dcf4-f215-4ef6-a62d-ea1913b70d30, 'J''aime le mélange fraise-banane, mais les fraises ont rendu beaucoup d''eau à la cuisson et du coup, le crumble se transforme en pâte gluante... Pas vraiment le crumble croustillant que j''attendais. La prochaine fois j''essaierai de faire revenir les fraises à la poêle avant ou alors d''imperméabiliser les fraises du crumble par une voute en rondelles de bananes... A suivre...', '2008-05-05T01:37:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48563, 65803bfd-1c1d-421e-856f-1ea6ee2def00, 'Dessert facile à réaliser et très rapide. Je n''avais pas de noix de coco mais j''ai rajouté des amandes effilées sur le dessus. Nous nous sommes régalés.', '2007-06-04T15:56:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48563, 42b4c7f9-9673-4e43-8e81-535aac44874c, 'Le mélange des fruits et de la noix de coco est très agréable et cette recette est vraiment facile et rapide à réaliser. Par contre les fraises chaudes c''est un peu spécial ! Mais en laissant refroidir c''est parfait.', '2007-05-25T00:54:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48563, f65bebe6-8fab-4f44-9daf-eb00b5990d1e, 'Toute ma petite famille a adoré. Merci pour cette recette originale.', '2007-05-10T13:21:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48563, e7fb19f9-376a-4d89-a9df-ea4fa3daf4be, 'Très très bonne recette : rapide, facile et à la fois fondante et croustillante ! La noix de coco donne un goût subtil exotique. ', '2007-05-09T22:15:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35542, 478be631-1985-48f7-8393-7ff90eb58c4c, 'Excellent moelleux!!! Idéal quand les fruits sont très murs!!je referai cette super recette!', '2021-06-07T23:54:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35542, e983f283-0f40-4a5f-8876-5d6c1735ba94, 'J’ai mis une pomme, une poire et une banane. Le cake est moelleux et délicieux ! ', '2019-08-19T10:13:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35542, 4a0629ff-c5d9-4f76-bce8-0fdc90b9a9c4, 'Tres bonne recette !', '2016-05-21T23:34:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35542, 196a86d0-81fe-441b-8d2e-2a56938591ad, 'Je n''avais pas de poire donc pour moi c''est un cake pomme-banane. Pour le sucre j''ai fait moitié sucre blanc et moitié sucre roux. Respect des doses et temps de cuisson. Cake savoureux qui ne reste pas longtemps dans l''assiette. La prochaine fois j''essaye avec de la noix de coco. Quoi qu''il en soit merci pour cette recette.', '2010-08-14T16:09:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35542, 81b9f9eb-15d7-4d67-b1d3-8a2302cefed2, 'Une très bonne recette, que j''ai néanmoins légèrement modifiée : j''ai ajouté 1 œuf, une cuillère à café de miel et un peu de lait et j''ai choisi comme fruits : une banane, deux poires, une pomme + 100 gr de chocolat dessert, le tout coupé en petits morceaux.  Le cake est moelleux à l''intérieur et croquant à l''extérieur.  C''est une recette que je referai, j''en suis certaine.', '2010-01-24T18:09:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35542, ffeab6e2-3a9b-4d94-8b0d-f2caadacfc66, 'Moi qui ne suis pas très douée pour les desserts je trouve que c''est facile, rapide et bon!', '2007-04-17T16:51:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35542, d87a6435-bb26-434e-972b-8d446948fa9b, 'Très bon, j''ai mis des poires en boîte et rajouté 2 cuillères a soupe du sirop des poires ainsi que des morceaux de chocolat!!!! Un délice!!!!!!!!', '2006-08-21T00:24:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35542, 4572158f-2d76-4899-9993-1c82463289a4, 'Bon mais vraiment sans plus.', '2006-04-11T11:01:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35542, 817fbe84-72a4-41bf-81a9-45027a43ea08, 'Bon et léger, mais je n''ai pas mis les fruits en premier mais par dessus le mélange oeufs, farine...comme ça les fruits s''enfoncent et tout est melangé.', '2005-06-07T19:34:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62980, c7b31d3d-9786-43aa-93b3-ebe5bf1e1c10, 'Très bien mais réduire les quantités : 100 g de chaque (sauf framboises, voire augmenter leur quantité)! Possibilité d''ajouter au fond spéculoos et saupoudrer le dessus de poudre de spéculoos', '2014-04-28T20:11:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62980, 27c5b7a2-91fd-4bce-a534-fd0954f2de42, 'Un vrai régal. J''ai doublé la quantité de framboises. Merci pour cette recette qui deviendra un de mes classiques.', '2010-02-07T21:23:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62980, dd79a19e-0204-4f23-93d2-665e679bb3ed, 'Super recette ! Le sucrée de la banane se marie très bien avec l''acidité des framboises... J''y ajoute même des pignons de pins avec la couche de framboises... Et un petit conseil n''hésitez pas à mettre plus de framboises et à faire un plus gros plat, ce crumble est également délicieux, le lendemain, bien froid !', '2009-04-17T17:18:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 6d584a8a-1b7e-418e-9b3e-13ee7d291314, 'J''ai ajouté quelques morceaux de chocolat noir et une cuillère de rhum ! Très bon chaud ou froid.', '2017-08-09T13:35:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 9d734289-106c-44ef-afde-518af75d7a3b, 'Délicieux. Faire griller 5 minutes au four sous le gril, encore meilleur. Je n''ai pas rajouté de sucre dans l''appareil à tarte car mes bananes étaient très sucrées car bien mûres.', '2020-06-28T23:51:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 1178e4fa-62d2-4733-ae49-0378c139a7f2, 'Je n''ai pas mis que de la noix de coco car je n''aime pas tellement ça donc j''ai ajouté de l''amande amère. Très bon !', '2011-04-28T15:04:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, b0d8e58c-aac5-4c41-88c4-71cc376a9369, 'Recette originale et délicieuse', '2025-09-21T13:13:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 7f298d30-dff8-4482-98eb-d8d56cde8592, 'Très bon et facile à faire', '2022-05-15T21:56:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 4c2a51b1-60cd-4af8-9f50-8474a1eb7116, 'Avec des petits morceaux de chocolat et une dizaine de minutes de cuisson en plus... Très sympa !', '2019-08-25T18:12:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 9b193748-390f-4eb9-a154-0cb8ab69f664, 'Délicieux', '2016-02-27T15:58:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 9212609d-5142-48ce-a4ae-0bdd31e585da, 'J''ai enlevé gingembre cannelle et j''ai ajouté du sucre vanillé de Madagascar juste extra !', '2015-09-10T01:40:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 33f89785-344c-42a5-bd36-97dccc129fd4, 'Mieux avec de la vraie crème entière et une pâte feuilletée. Ne pas oublier le citron comme moi ! Je la referai.', '2015-02-08T18:13:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, cffe44d4-16d3-44b4-87af-91acb6cda742, 'J''ai été très agréablement surprise par le goût de cette tarte = très bonne !', '2014-12-29T23:34:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 42b658c7-8b86-40b1-b25d-c3f601d45d08, 'C''est bon mais le gout gingembre/cannelle est trop prononcé. La prochaine fois je ferai avec moins ou carrément sans. Par contre avec 30 mns de cuisson c''est parfait. ', '2014-10-27T07:25:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, f692930a-7b5b-4022-87ec-19d993f11f90, 'C''est très bon  ', '2014-09-26T17:57:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 7c39dcc1-6275-43a1-b9e1-b3c21e809958, 'Tout simplement délicieux ! Le mélange des saveurs est très réussi. ', '2014-03-13T22:05:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 69dbbd3a-8a50-4810-8e30-0ef1db8f3c49, 'Déçue également ', '2014-01-05T19:27:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, a07a2cf3-e434-4c7e-ad12-4e05bc82d6f1, 'Très déçue !  Moi qui adore la banane et la noix de coco, j''ai trouvé que le goût n''était pas bon et absolument pas harmonieux. A en voir les commentaires si positifs, je me dis que j''ai certainement dû rater quelque chose quelque part, même si je pensais avoir suivi la recette à la lettre...', '2013-08-30T13:02:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 3d383898-8307-40a2-af85-02dd562cda8c, 'Avec 80 g de sucre de canne, 2 cuillères à soupe de rhum, le jus d''un demi-citron et 30 min de cuisson, le résultat est top. Merci pour cette version d''utilisation de la banane.   ', '2013-06-24T17:12:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, e2be0a99-f3a3-4cfc-bded-39b9006f1f36, 'Super un régal, rien à changer ', '2013-04-14T16:21:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 37910b76-f93b-4fd4-8f07-7268eb5c8ef3, 'Super recette ! J''ai remplacé la crème par du lait concentré et je n''ai pas mis de sucre. Merci ! :)', '2013-02-25T16:48:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 96632f21-e9a4-4b58-af1a-8cf5daabe455, 'Il est trop bon !!! Merci', '2013-01-06T17:48:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, b86bf852-a19f-4959-a92d-06590d0a5e58, 'Un vrai régal ! Avec les bananes et la coco râpée du jardin... hum ! Un délice. Je n''ai pas mis ni de cannelle, ni de gingembre (je n''en n''avais pas) mais j''ai ajouté dessus un filet de caramel au beurre salé liquide... Une merveille !!', '2012-08-17T09:01:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 00b86c93-eb70-4f3d-bb8c-1095397b4f6c, 'Moi j''ai fait une tarte à la banane et citron réussie apparemment et faut aimer me mélange.', '2012-05-19T23:03:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, bd64793e-d11b-4a79-868d-ea786a8cb706, 'Bonne recette avec 80 g de sucre. J''ai ajouté un peu de nutella fondu dessus, un vrai régal.  ', '2012-03-02T18:51:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, aa88d81d-a1b1-439b-acbc-72e799b081bb, 'Déçu déçu par cette recette pourtant si bien notée. Résultat fadasse, pourtant j''ai suivi de nombreux conseils des internautes.', '2011-07-10T19:01:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 86bb89f9-81b9-46ca-b686-8dc6a3fd200e, 'Excellent. J''ai ajouté du rhum et mis 80 g de sucre de canne. Par contre, je n''avais pas de gingembre. Mes invités ont beaucoup apprécié. A refaire régulièrement. ', '2011-05-29T06:20:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, a9a75fb6-ba25-4c9b-8252-2b0ef22b9656, 'Très simple à faire. J''ai remplacé la crème fraiche par la crème soja et la noix de coco par la poudre d''amande. Excellent.', '2011-01-21T11:45:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, a398566f-7b50-4aa0-a4b8-1b587de028c2, 'Excellent... rien à dire... hmmmmm. J''ai juste mis 80 g de cassonade', '2010-11-16T17:22:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 215d4ca1-9acc-447d-9ff1-e79aaefc6547, 'Très très bon. Sans gingembre et un tout petit peu de cannelle. Mon mari et mon père (difficiles pour les gâteaux) ont apprécié, ma mère et ma grand mère ont adoré ! Je la referai !', '2010-10-06T21:32:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 8d3aafd5-a9f0-4885-adf3-09eca6d734f4, 'Les invités ont tous aimé. Personnellement, j''ai trouvé que c''était un peu trop sucré. Je retenterai l''expérience avec moins de sucre et moins de gingembre je pense. Ca reste une recette que je conseille !', '2009-10-26T12:06:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 6733f12c-da1d-42bf-8ed2-561e6d3cb1ab, 'Excellent ! Je l''ai faite 2 fois (testée à la Martinique par 30 personnes). Même ceux qui n''aiment pas la banane en ont mangée. J''ai remplacé la cassonade par du sucre de canne roux. Merci !', '2009-08-25T20:10:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, cc2c1129-0199-4384-bc84-812e296fc07f, 'Délicieuse, fondante et légère !! Je n''avais qu''une pâte feuilletée et pas de crème fraiche donc 4-5 grosses cuillères soupe de fromage blanc  20% et je n''ai pas hésité sur la noix de coco !!! Je n''ai mis ni cannelle ni gingembre mais ça n''a pas manqué ! Parfait en dessert d''un barbecue !! ', '2009-08-23T02:47:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 3b8a5efe-0bd5-4baf-bc0a-98ea476cb3fc, 'Un régal ! J''ai également ajouté des pépites de chocolat mais n''ai pas mis de cannelle... ', '2009-05-24T21:37:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 8d256a7a-3e41-465f-8d77-d239bd481758, 'Excellente tarte et très facile et rapide à faire...pas écœurante du tout comme je le craignais,et puis j''avais des bananes à utiliser rapidement à défaut de les jeter. j''ai rajouté quelques pépites de chocolat (celles que l''on utilise pour les cookies) c''est très joli et ça apporte un bon contraste', '2009-04-05T20:44:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 67770709-906e-483e-b584-4ab28e640038, 'Je l''ai faite avec une pâte sablée, délicieux.', '2009-01-04T12:52:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 8ce7c3ce-b66b-41f0-a5d0-88f23791aacc, 'J''ai testé cette recette avec succès : je n''ai pas trop forcé sur la cassonnade, j''ai ajouté du sucre vanillé et de la fleur d''oranger à la préparation. Un résultat qui a beaucoup plu à tout le monde!', '2008-11-12T18:25:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 478e955d-a6e6-45c7-b4e1-c1acc4564b6d, 'Simple à réaliser, cette recette à laquelle j''ai ajouté un peu de chocolat râpé est tout bonnement délicieuse. Le goût à peine prononcé des épices donne une note toute particulière à ce dessert qui recueille les compliments.', '2008-11-01T17:19:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 4948d7d4-b3cc-4b95-814e-b4ed4da23f71, 'Excellent! J''ai suivi les conseils de tout le monde : 30 min de cuisson, une lampée de rhum et quelques morceaux de chocolat à cuire... mon épouse qui n''aime pas trop les bananes a adoré !', '2008-08-17T11:02:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 4ec21f49-1b7c-4f5d-a482-3a50cae9a2b9, 'Très bonne idée de recette simple et rapide. J''ai cherché une recette pour utiliser mes bananes et je suis très contente d''avoir choisi celle ci. J''ai aimé l''association de la banane et de la noix de coco. merci!!!', '2008-08-14T21:30:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 75020090-14b1-4f29-bac4-26a82dd093e9, 'Plutôt bon, même pour moi qui ne suis pas très fan des bananes. Change de la sempiternelle tarte aux pommes.', '2008-07-28T18:13:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, af4513c5-3c06-4466-b346-a41a9902f0e3, 'Facile à faire, je ne perdrai plus mes bananes trop mûres. Surprenant à la première bouchée mais très très bon.', '2008-05-11T10:47:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 6e19329f-9831-4fb0-bf9c-17f66fcdc579, 'C''était délicieux, la prochaine fois j''incorporerai des pépites de chocolat à la préparation.', '2008-05-05T23:01:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 19a97347-fd2e-429c-9e55-e1fcb3fb10ea, 'J''ai mis plus de bananes et du sucre blanc à la place. Miam miam... Par contre j''ai oublié le rhum... ce sera pour la prochaine fois.', '2008-04-08T17:59:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 61bc7c1a-f21d-43d5-8378-e0669c84ec7d, 'Simple et légère, cette recette est un bon moyen d''utiliser des bananes trop mûres. Je conseille également de la déguster froide, elle n''en sera que meilleure. Merci pour cette super recette!', '2008-03-17T03:17:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 3bc2c08f-d724-4e73-83c3-0afcccde5072, 'Tarte excellente! Je vous recommande de la manger froide.', '2008-02-04T12:34:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, e05c0129-ba49-494e-851e-d48fb5837dbb, 'Excellent! Beau mariage équilibré des goûts! Il faut 10 minutes de plus de cuisson, j''ai mis un peu plus de gingembre et de cannelle. En tous cas merci!', '2007-11-17T21:34:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 28fb7f72-df45-4425-a59c-26b22ee9b690, 'Un vrai régal! Moi qui ne suis pas une fan de la banane, j''ai vraiment apprécié cette tarte! Je l''ai faite avec des petites bananes des Antilles (banane figue) et de la noix de coco fraîche... Succulent! Tout le monde en a repris et j''ai pour obligation de la refaire assez régulièrement! La légèreté de la tarte est surprenante; je ne m''attendais pas à cela avec les bananes. Bravo!', '2007-09-05T19:41:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 17bf9c84-4cdd-4ba9-88a6-7645fc7f3182, 'Très fondante... meme les non fans des bananes ont adoré. Je n''avais pas de citron, j''ai arrosé de rhum.', '2007-05-08T23:14:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, f517374e-2127-45f0-b7f4-fbcd84fb8460, 'Rapide, super bon et change un peu.', '2007-05-07T15:34:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, cc896e78-18f9-4acf-8bc1-a1468bfad291, 'Très bonne tarte. Prévoir peut-être un petit peu plus de temps de cuisson. J''ai également mis du rhum qui se marie très bien avec la banane et mis 1 bonne cuillère à café de cannelle et de gingembre au lieu de la 1/2 cuillère indiquée. C''est vraiment excellent!', '2006-12-09T18:39:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 36a9456c-71b0-41e6-9a7b-74b4fb629388, 'Très jolie tarte pour recevoir des amis au goûter et en plus, elle est très bonne, sucrée à souhait, parfait pour faire le plein de magnésium!!!', '2006-12-03T18:49:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 74fb0680-01e5-471c-936d-50bf5e4fe13f, 'Délicieux et en plus facile et rapide... Bravo!', '2006-10-18T20:37:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 92af1137-1dec-437c-b8f6-838a1ee578bd, 'Je n''ai mis que deux bananes et c''était suffisant. Par contre la prochaine fois je les arrose de rhum, çà manquait de parfum.', '2005-03-15T12:31:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 33b90c48-ff94-44f2-9075-d397b23090f2, 'Mon époux était contrarié ces derniers temps et je lui fait de bons petits plats dans ces cas-là. Cette recette est formidablement bonne! J''y ai ajouté des morceaux de chocolat noir et mon époux a retrouvé le sourire...', '2004-09-23T11:08:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, 999fb2ee-aff5-4da9-92d3-decd92f6d07e, 'Très bon. Tiède avec un soouçon de chantilly, mon mari a adoré.', '2004-03-10T22:50:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17713, ab8b5be4-d0fa-404b-8040-46f60527b03b, 'Très bonne recette! Je n''avais plus de noix de coco et j''ai mis de la poudre d''amandes à la place et rajouté du jus de citron sur les rondelles de bananes pour relever le goût... C''est bon!', '2002-12-11T17:19:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336396, a2e07205-f825-43f4-a780-3a7390002c5c, 'Merci pour ceux qui n''ont pas de machine.', '2017-03-20T20:06:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52639, 2a1d0d75-5ee0-412d-8980-652030c1f96b, 'Tres bon', '2021-05-01T15:09:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52639, 905e1648-bbe4-4eef-a73f-d6e0fa5a2590, 'Bonjour moi j''ai changé les bananes contre la noix de coco et du chocolat caramel un délice', '2021-04-17T14:37:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52639, de19314d-ca6a-4f21-907b-80555450be0e, 'Effectivement super simple à réaliser ; j''ai mis plus de bananes que sur la recette par contre, sinon ça aurait été trop sec.', '2013-12-26T15:00:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52639, 65769415-a8a8-4820-a291-a7af64cf6ced, 'bof bof... la banane en morceaux ne ressort pas vraiment. Avec le nappage, il devient écœurant.', '2012-12-03T23:18:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52639, 8df0cb32-18ec-4feb-9827-23494bfc6d21, 'Recette simple et rapide, un vrai délice ! ', '2012-05-17T19:44:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52639, 544f079a-7512-43df-b256-8083b8c4190b, 'Super facile à faire et délicieux !! En plus on peut le décliner de plusieurs façons; moi j''ai échangé les bananes contre une compotée de mandarines ou carrément j''ai fourré au praliné... bref je peux plus me passer de cette recette qui a beaucoup de succès auprès de mes convives !!! Merci beaucoup !!', '2010-12-28T20:58:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253985, 955a5df8-0a1e-47f7-bf98-c4e42f3ece68, 'Bonne recette mais muffins un peu secs à mon goût. Comme d’autres je n’ai pu faire que 12 muffins avec les quantités indiquées pour 20.', '2023-04-02T09:00:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253985, 211224fa-41d2-42dd-8a54-63e92ed50d48, 'Excellent ! !!!! ! Recette parfaite! Pour faire 6 muffins j’ai mis les doses pour 10 et c’était parfait', '2021-04-29T21:55:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253985, fe4c5d6c-002f-4d01-8492-9510df07266a, 'Très bonne recette !', '2017-12-09T18:29:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253985, 25777cab-46d9-46d3-9484-933a98cc70a5, 'Top  !!  ils ne sont pas trop sucrés. Je les ai fait pour le goûter... mon homme en redemande !', '2016-10-04T16:17:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253985, ea531bf3-8f88-40fb-9ba5-af247ed8ac5d, 'Excellente recette ! Rapide à faire. J''ai pu faire 13 muffins de taille moyenne. J''ai laissé 20 minutes à 180 degrés.', '2015-08-20T00:17:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253985, 735322fe-0e1b-49c6-9fff-901693343fdf, 'Recette réussie !! ', '2014-03-27T23:51:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253985, 71f07adf-a7dd-4c50-b07c-c4af1f233f5f, 'Excellente recette.  ', '2014-03-06T14:27:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253985, 813213c1-0789-4753-b11f-34c62b319bae, 'Très bonne recette, les muffins sont excellents. J''ai mis 3 bananes qui étaient bien mûres, pas de lait du tout et coupé un peu la farine avec de la maïzena. Ils déchirent comme disent les jeunes !', '2014-01-08T19:48:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253985, 4a25cb0a-03b1-4246-aca8-863c5543b892, 'Bonne recette facile à réaliser et au résultat sympathique. J''essaierai de la refaire en ajoutant une banane supplémentaire à la recette. Si non avec les quantités indiquée je ne suis parvenue à faire que 12 muffins.', '2013-12-08T17:27:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83292, 876ecd49-1388-45bc-a512-7dba2f21e294, 'Super crumble.', '2020-05-09T15:39:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83292, a6a3ebb7-9bef-48d5-882b-e46451be6a1a, 'Cette recette que j''ai respectée à la lettre est un pur délice ! La pâte à crumble est excellente.', '2013-12-02T16:08:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83292, 4e97d7ec-811f-4248-a9fd-9abb8d667983, 'Le crumble était agréable, mais la pâte peut-être pas assez cuite, et je préfère avec le sucre roux. Mais très bon quand même, les fruits caramélisés sont de vrais régals !', '2012-02-19T16:06:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83292, f7cebb8f-15ac-4ea9-a0f8-f891941b76a6, 'Je n''avais pas de bananes, je les ai remplacées par des poires bien mures et ajouté quelques pépites de chocolat, un régal !', '2011-06-19T16:46:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83292, 62b1785e-4b8c-4346-bed5-05f2d0d21fe4, 'C''était très bon, il ne manquait que la glace à la vanille, la prochaine fois, je ne l''oublierai pas ! J''ai juste mis 3 bananes au lieu de 2 (j''adore les bananes).', '2010-06-27T01:27:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83292, ad545323-a397-41e4-9308-980e7446f37d, 'Que dire de plus à part, très bon et très facile à faire ! Je recommande vivement pour les gourmands !', '2010-02-26T00:11:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83292, eb7c8487-7733-4760-a8ed-09a2e0a00f64, 'Très bon. J''ai rajouté des pépites de chocolat dans la pâte à crumble et j''ai mis un peu de cannelle quand j''ai fait revenir les fruits.', '2009-06-19T15:40:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83292, 1720334c-127f-42e7-afab-d59b491dc582, 'J''ai rajouté un peu de cannelle et de rhum et réduit de moitié le temps de cuisson et un vrai régal prêt en quelques minutes seulement. Recette à refaire absolument !', '2008-12-30T14:46:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83292, 57d33da5-2541-45eb-957f-fd3154b45ed1, 'Dessert à faire et à refaire. Personnellement, je ne mets que du sucre roux et je rajoute quelques copeaux de chocolat aux fruits... un délice !', '2008-12-29T00:38:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83292, f8d5e479-6e8f-4665-a0d0-1cf890bf6f62, 'Recette très classique pour un résultat savoureux. J''ai sacrifié à mon péché mignon en remplaçant 50g de farine par 50g de poudre de noisettes. Ce faisant, je suis resté dans la couleur "automnale" de la recette...', '2008-12-20T08:58:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, d2ff3c5d-8910-4178-9053-a233c7e2921b, 'Moi, j''ajoute le curry dès le départ, et je remplace une partie de la crème par du lait de noix de coco ! Applaudissement de mes convives !', '2012-05-15T20:07:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, 38eef9a5-f618-4450-9eef-4df2b358ab74, 'Recette appliquée telle quelle. C’était excellent. Très facile, original avec des saveurs un peu exotiques. Je l’ai ajouté à mes favoris et la referai prochainement. Merci.', '2023-01-01T07:53:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, 84fbd720-906b-48fd-9c6e-d6985d812efe, 'Excellent ', '2022-03-09T06:33:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, c94afad2-c9e5-4076-95f2-e61402e231c0, 'Très agréablement surprenant ', '2021-01-05T23:22:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, 8d8ba60e-a8f5-4a24-b4ff-a7b4922a9770, 'Tres bon, original', '2020-05-07T16:07:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, 3f83bd86-0584-48f4-be21-953786158a9b, 'Top ! J''étais un peu sceptique mais j''ai testé et c''est franchement très bon je recommande cette recette.', '2018-12-20T21:32:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, b59cf606-c168-4ee0-8e52-3ec1b8dd91b9, 'Nous avons mangé ça en famille et tous le monde a adoré ! Je conseil vraiment cette recette !', '2018-08-15T07:00:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, ea43db8f-27db-40d9-9a12-d81bb88a71d6, 'Mon Dieu que c''est bon!  Mon compagnon est plus mitigé mais il n''aime généralement pas les plats sucrés-salés. J''ai juste mis plus de crème pour avoir plus de sauce.', '2017-08-22T17:19:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, 1eaf7872-f3fd-4de0-9c9a-01ca5964252f, 'Trop bon.', '2014-12-24T18:23:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, 47bc4254-5ac8-49b5-b926-c110c32e6598, 'Top ! Un vrai régal !!!', '2013-03-06T17:50:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, 1a4bd15d-835f-4781-894d-9dba40a48899, 'Très facile et original. Je n''ai rien changé à la recette, c''était parfait.', '2013-01-14T00:21:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, 30262aea-fa6a-4ad7-9861-c0efe751470c, 'J''ai suivi la recette et c''est un délice ! Le mariage banane, curry, crevette est très surprenant, mais quel délice...', '2012-08-16T18:24:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, a346f895-7df4-4b45-bb0e-5d9f05d1d845, 'Testée au pré-réveillon 2012 top avec ananas et banane, inspiration pour la lasagne thaï du 8/01/12.', '2012-01-10T21:21:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, b9b58f2e-1e8c-4a91-afc8-fb7d602f24e0, 'J''ai trouvé cette recette très surprenante et très originale... A refaire', '2011-11-07T18:06:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, 02870616-8469-4f0d-a91e-021b941df7ad, 'Très facile à réaliser, le goût est surprenant ! Un délice.', '2010-12-29T09:49:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, 06c30008-1251-46c1-8ba6-4fdac4b48875, 'J''ai suivi la recette à la lettre et franchement c''était très bon. J''ai ensuite fait la même recette mais j''ai remplacé les bananes par des ananas et là...un vrai délice. Merci pour cette recette', '2010-04-26T15:50:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, 36be50fc-09fc-4f26-b41c-d6fc643288f1, 'Dé-li-cieux! Rien à dire...', '2009-12-08T20:43:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, bf4be794-d5c6-4384-82f7-5fdfeca07621, 'Délicieuse recette originale. Je n''ai utilisé qu''une seule banane et n''ai pas lésiné sur le curry pour relever la sauce. ', '2009-07-04T16:52:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, c4176f2d-33ef-4da5-b5ee-a5559b9a12f4, 'Très goûteux avec des bananes bien mûres !', '2008-12-24T20:34:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, 736daaf1-4dbe-48f6-bb5e-67734e1c82d0, 'Délicieux, j''ai gardé la recette de base et j''ai rajouté une cuillère à soupe de noix de coco râpée à la réduction de vin blanc. Au moment de servir j''ai rajouté mes scampis crus à la préparation, 250 ml de crème allégée et 1/3 de barquette de fromage frais maigre aux fines herbes pour lier (les scampis rendant leur jus). Le reste a été gardé comme suggéré. En cinq minutes mon entrée était prête et j''ai surpris mes invités par cette recette légère et aussi originale que facile à faire. ', '2008-09-22T13:42:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, c142c637-35dd-4218-bfb2-5072b00b28a8, 'Je connais cette recette depuis une bonne dizaine d''années et je surprends toujours mes invités par cette délicieuse recette qui s''adapte aussi avec des tagliatelles, riz et spaghetti. ', '2008-02-05T17:38:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, 2acbeae6-8c2c-45cc-be62-dce686124532, 'Cette recette est à tomber par terre pour toutes les personnes qui aiment un peu d''exotisme dans leur assiette, rien à retirer, ni à ajouter, c''est tout simplement délicieux!!!!', '2007-08-22T14:47:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, c1a05e5d-b0c0-40af-8ed6-9eba83bf4610, 'Original, facile, excellent en tout sens.', '2005-04-04T21:59:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12623, 9d8dbb69-24ea-4a51-8982-6248a49e51f1, 'Recette super facile et en plus très bonne. A recommander.', '2003-05-21T20:50:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82248, 65b6ce91-ff12-4cc9-8f2b-5d0f395541c3, 'Rapide à faire et délicieux!!! Je l''ai fait avec de la glace à la vanille.', '2008-11-12T14:36:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84574, 8acd11c7-3d19-4bea-be5a-219d87ff41cd, 'Un dessert très bon qui a un énorme succès...', '2013-07-25T02:31:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84574, 6c15cf81-9d77-4551-8fb2-758afa39e326, 'Bon dessert ! Pour le dosage, 1 cuillère = pas trop grosse si on utilise une cuillère à soupe (sinon c''est écœurant, trop de crème). J''ai allégé en coupant le mascarpone avec un peu de fromage blanc.', '2012-02-12T15:54:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84574, bbd0ef13-aaf8-4ef8-a1eb-5b1dbd8de13c, 'Super bon, super facile à faire et de sur-croix succès assuré.', '2011-09-14T19:26:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84574, 9ad5c9a8-92e6-404b-b680-79b9fae554bf, 'Super bon et super facile à faire. Ayant une petite qui adore les desserts, j''ai remplacé le rhum par un peu de café pour faire tremper les boudoirs. Merci pour cette recette. A refaire', '2010-01-27T12:21:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84574, 9be6cd04-c82c-4071-8d56-5546cdae0f77, 'Succès garanti !! Pour un dîner plus formel, toutefois, retirer les bonbons aux fraises.', '2009-05-12T21:14:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64491, c84e5621-8f92-4a8c-9ef4-ea19b59a7de3, 'Très facile à faire et vite fait et délicieux !', '2022-11-18T16:28:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64491, 2481a659-e006-431c-b632-db50ea05da69, 'Je suivi les conseils : mettre moins de creme et de sucre. Parce qu''on est tres gourmand, j''ai ajouté des pépites de chocolat.
On s''est régalé!', '2018-03-01T10:53:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64491, 8325e4d5-3c01-4b74-9163-f1752170f549, 'Très bon dessert.
Diminuer toutefois le sucre à 70g cela suffit amplement. Personnellement j''ai mis du lait de coco et du miel à la place du lait et de la cannelle.
Excellent !!!', '2017-08-12T11:36:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64491, 4a1297c4-3f57-4de8-931e-627373e14e92, 'Super bonne. 20 cl de crème suffit, tout le monde a adoré. Excellent moyen de cuisiner des bananes trop mûres.', '2015-12-22T08:40:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64491, 78d53236-fbac-4c14-a7e0-d355dcd509bd, 'C''est très bon, mais 20 cl de crème suffisent. Il serait aussi intéressant de booster le goût de l''amande avec quelques gouttes d''extrait. C''est aussi un peu trop sucré, mais ça, c''est mon goût personnel.', '2008-09-04T01:14:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309354, af754011-9e24-4dcd-872c-0f2196787c47, 'Délice, cette recette porte bien son nom !', '2013-10-07T14:11:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50293, 4240d082-cc60-4537-88fb-84211889ec24, 'Je n''ai pas du tout aimé la sauce caramel hyper sucrée et écoeurante...je trouve que ça tue vraiment toutes les autres saveurs (notamment la banane qu''on ne sent pas du tout).', '2008-11-04T23:52:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50293, dea23f77-6ad4-49e9-94a1-673941562930, 'Un vrai régal pour les amateurs de cheesecake! Je n''ai pas fait la sauce au caramel parce que nous n''aimons pas ça et que ce cheesecake est excellent nature. Ou, vous pouvez l''accompagner d''un coulis de framboises, plus subtil. Je n''ai mis que 2 bananes, suffisant à notre goût. Merci pour cette recette que j''adopte !', '2008-06-17T12:08:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50293, f42b8073-ad1f-4397-ac98-aad20e8e193b, 'Ce dessert n''a pas été apprécié: trop lourd, la cannelle est trop prononcée et pour certains la crème caramel est écoeurante!!', '2008-05-21T18:50:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50293, ab1359bc-2acd-4a69-8794-93096377fbc3, 'Avis très mitigé après sondage chez mes invités... Magda a adoré et surtout la sauce caramel; nono n''aimait pas du tout ce côté sauce caramel (goût trop beurre salé); goût de banane pas assez prononcé.', '2008-05-16T20:50:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50293, 4d52928c-eb91-4d66-8e15-28edb69cad28, 'Pas assez de fromage ! Trop léger !', '2008-05-02T01:10:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50293, 06bcb421-d5bb-4a95-8df4-776918d6a8d9, 'Le goût de la banane est peut être trop prononcé mais la sauce aux caramels est un pur délice ! ', '2008-04-21T21:39:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21438, d9d38e8a-f656-4085-bb27-ebf1456e3124, 'Le milk shake, c''est avec de la glace, pas du fromage blanc, du yaourt ou je sais pas quoi d''autre! De la creme glacée, du lait. ', '2018-08-14T08:33:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21438, 274d5b46-9e17-4ff2-a060-b27526169451, 'Délicieux Milk-shake mais encore meilleur avec une cuillère à soupe de compote en plus.', '2011-02-02T19:43:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21438, 60c9e016-82f5-4b53-90b6-4c0ddd55e569, 'J''ai remplacé le fromage blanc par du yaourt velouté, fraises et sucre. Là, il faut vraiment goûter, le mien était (trop) peu sucré…', '2005-03-25T15:31:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21438, 6b69d7b0-8e57-425d-9b37-66db99cac495, 'Moins de lait! Et certains m''ont demandé du sucre en plus... Sinon, ça doit être top avec les modifications! ;-)', '2003-03-16T20:22:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21438, 7f3b595f-78db-4019-9605-fd9529fb9fe1, 'Je l''ai fait avec de la banane et j''ai été assez déçue: le goût était fade et la texture trop liquide. Peut-être avec moins de lait et un autre fruit?', '2003-03-15T17:08:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 943dadd5-1db3-4265-854f-02faef926985, 'A D O R E !
Je n''aime pas la pâte sablée alors j''ai utlisé une pâte feuilletée. J''ai ajouté du rhum dans la préparation de l''appareil et de la coco rapé sur le tout avant cuisson un régal.', '2018-04-17T06:47:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, d0569fe0-24e8-4fdc-adea-e8e30d5b645c, 'Bonjour pour se qui ont un four à gaz je vous conseille de la faire cuire🕙 15 min et 15 min en cuisson de la pate et de rajouter de là noix de coco.', '2023-01-15T10:30:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 67ccfa84-2c42-4824-ad02-deaa0876c8ad, 'Pour ceux qui ont un four un gaz, il vaut mieux mettre 35 minutes de cuisson car au bout 15 minutes la préparation n''avait pas encore pris 😉', '2022-09-10T15:29:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, c0e7c711-145c-479f-9733-f188c6072caa, 'Très bon, fait avec 2 sachets de sucre vanillé et 20 cl de crème fluide allégée, 10 pour le chocolat et le reste avec les œufs et le sucre, je vais l''essayer avec des poires fraîches que j''aurai précuites dans un sirop avec de l''aspartam et une petite goutte de rhum de la Réunion ', '2020-11-03T13:39:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, a3ecbede-95e9-4b1d-926a-0cf81034bc15, 'Faites avec une pâté brisée. Un délice !!! Merci pour la recette !', '2020-06-30T21:05:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 78f1d4cf-c423-4b10-9eb9-b0f8b9ddc949, 'Pas fan des appareils avec œuf, j''ai quand même essayé cette recette aux vues des excellents commentaires. Et bien déçue ! J''ai mélangé crème et chocolat mais cela faisait quelque chose de liquide, ne mettre que du chocolat aurait été meilleur ; Quant à l''appareil avec œuf, je n''en avais pourtant mis que 2 avec crème et sucre mais cela donne un côté flan que je n''ai pas aimé.', '2017-08-06T18:20:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 20e9ba1e-f1fb-4dd6-b3db-f747baf577ed, 'Je fais cette tarte depuis des années, quiconque y a déjà goûté me la demande à chaque occasion. Je préfère pâte feuilletée ou brisée et je mets 2 oeufs. Je ne cuit pas la pâte à blanc mais rajoute 10 min de cuisson. J''ai doublé le chocolat une fois mais ce n''était pas aussi réussi. Merci pour cette recette !!!', '2017-07-09T00:55:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, a4b905f8-2967-494e-be11-7843b9ba5cc7, 'Tarte délicieuse et "inratable" .... Elle fait à chaque fois l''unanimité ! Je fais la pâte brisée moi même ... J''ai ajouté 10 minutes de cuisson.  Encore meilleure le lendemain ... Je recommande cette tarte ! ', '2015-10-13T23:07:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, c3613cb6-2ed6-4464-b8e4-fa9596ae3831, 'Très bon, même les enfants ont aimé', '2015-07-17T09:48:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 0c7bcc7e-6939-42a8-817a-33787a98a90c, 'Excellente... J''ai juste mis 200 g de chocolat et 1 sachet de sucre vanillé en plus... Ma petite famille s''est régalée.', '2014-12-12T00:23:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, aa10dfda-c48a-4ad4-9a09-4d62d0caa719, 'Excellente avec 200 g de chocolat au lieu de 100 et pas de lait crème liquide à la place un peu plus de cuisson aussi 30 minutes et j''ai fait pré-cuire ma pâte avant !', '2014-02-10T12:43:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, fc036834-02ce-447c-aba6-cc500af486a1, 'J''ai fait moi même la pâte sablée à partir d''une recette Marmiton qui a cuit 10 min avant à 180°C et après j''ai monté ma tarte avec 150 g de chocolat au lieu de 100 et j''ai mis les 3 œufs comme conseillé, j''ai remplacé le lait par de la crème liquide 30% et la tarte a cuit 30 min à 190°C et encore 20 min à 90°C car la pâte sablée en avait besoin. C''est un délice tout le monde a adoré et certains m''en on commandé pour refaire chez eux !', '2013-08-20T15:48:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 695c190f-e1e3-482c-8e35-88700b0c1633, 'Après avoir lu plusieurs commentaires, finalement j''ai fait un mix et mis de ma patte, c''est à dire : 1 pâte feuilletée, pour le fond de tarte j''ai utilisé 200g de chocolat Noir pâtissier et 10 cl de crème légère épaisse (ce qui évite que le fond soit trop coulant), j''ai coupé 5 petites bananes en tranches assez épaisses et les ai disposées sur le chocolat. Enfin, le mélange du dessus, j''ai utilisé 2 œufs, 10 cl de lait, 10 g de cassonade + 1 sachet de sucre vanillé, et une bonne giclée de rhum brun arrangé à la vanille. Puis, une dizaine de minutes de la fin de cuisson, je saupoudre la tarte de cassonade pour que ça caramélise légèrement... Suite à la dégustation, je n''ai eu aucune plainte !', '2013-06-30T01:59:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, c724fcd2-0edb-43c4-ba48-e923ec01b290, 'Recette suivie à la lettre, la tarte a été très réussie. Aujourd''hui je recommence avec de la coco râpée. Par contre, il faut bien laisser refroidir la tarte, voire la laisser au réfrigérateur avant de déguster sinon la couche de chocolat est trop liquide. ', '2023-07-01T13:12:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, e6a63005-e9ff-457b-adab-12aaae95123b, 'Parfait. La première fois, je me suis trompée : j''ai mélangé chocolat et préparation (oeuf, lait, sucre). Malgré cette erreur c''était aussi très bon 😉', '2023-03-15T17:58:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, e339cf98-e3d8-4b0a-a502-2528b0ce9638, 'Indications simples. Je recommande cette tarte, succulente. Meilleur avec des bananes bien mûres donc assez molles.
Nous avons adoré.
Merci beaucoup', '2022-03-09T16:27:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 55d1ec72-79af-4930-9f5e-192506850b93, 'J''ai rajouté des carrés de chocolat au dessus et remplacé les 10cl de lait par les 10cl restant de crème liquide très bon', '2022-01-19T23:52:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 85ec514b-eb0c-49fd-a9f5-9d42d0c196f0, 'Top', '2021-05-11T12:27:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, a9109802-de14-4ce1-8558-1f97c674fa67, 'Super Bon! ??', '2021-02-24T18:38:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 57ee38eb-0d2e-49bb-8194-2b3cb5b62210, 'Je pense que ce serais certainement meilleur si on mélange le chocolat avec la dernière préparation plutôt que de la mettre par dessus car sa donne un mauvais goût d''omelette. Du goût personne n''a aimer.. .', '2021-02-10T21:26:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 466ebbb2-b2e5-4992-a380-ddec8820f211, 'Tres bonne et facile à faire', '2020-12-10T18:41:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, f7cc26ef-7ab7-4f57-ad71-563e6d4540b3, 'Je rêvais de cette tarte en voyant les commentaires mais finalement la tarte est fade, très déçu j''ai suivi la recette à la lettre.', '2020-11-19T22:32:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 2fe609b4-8733-430a-87a8-5112fc816775, 'Une tuerie ! Nous n’étions que 2 mais elle a été engloutie en une journée ? Je valide ++++', '2020-10-28T15:49:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 0d333018-c05f-457e-9df5-90128551cfec, 'Une tuerie !', '2020-10-07T14:10:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 400cba3b-4cc1-4ca0-a1e5-80b2b847731d, 'Très bien, très rapide à moindre coût. ? ', '2020-04-23T18:01:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 9f385f97-02bb-474a-bff8-7d8ec719a56b, 'Moi aussi 150g de chocolat noir et de la cassonade à la place du sucre Trop bonne tarte', '2020-04-13T16:55:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, ef0faf56-9ad5-4779-bf3e-a1f9fa1450c1, 'Approuvée à l''unanimité !!! Recette sans modification. Un vrai régal.', '2020-04-09T18:59:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, b1d27062-8d51-447c-bd5a-c7e292cc0e2a, 'Mes enfants ont adoré', '2020-04-07T22:51:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 3d15791d-c49a-4562-b16b-5b68c4e32476, 'Mettre au frigo avant de déguster !', '2018-07-14T10:44:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, fad3bfe4-3dc3-4fac-9e8d-d7a0c2d9d334, 'Je vous conseille de mettre 150g ou 200g pour le chocolat.', '2018-02-02T02:00:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 0703d83e-c2af-4764-ab24-bb42ceddc12d, 'Un peu de mal avec la préparation style omelette que l''on verse sur la tarte. Cela a trop gout d’œuf.. 
Abstraction de cette partie ma recette est bonne !', '2017-08-18T11:43:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, a049e46b-ec1f-425f-b9a4-c93ecab45aca, 'Vraiment sympa !!', '2017-02-19T20:20:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 4f8b2a9b-0969-4f09-a6ed-027d3033d5cb, 'J''ai suivis la recette à la lettre en divisant les quantités par 2 sauf le chocolat et le résultat était au top ! Un régal.', '2016-11-10T01:19:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 1c6cf943-5007-4015-b0d2-45325b8103f4, 'Excellente super cette recette !', '2016-09-25T21:45:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 1336627d-9908-424a-af46-13137cba7eb7, 'Un pur bonheur pour les papilles ! La cuisine n''est pas mon dada mais je me régale à préparer cette tarte simple et rapide. Merci à Marmiton ainsi qu''aux internautes qui laissent leurs avis.', '2016-07-14T17:33:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, aa5c61e7-3955-4878-8a7a-3309a10114c7, 'Excellente ! Miam. Par contre si vous utilisez des gros oeufs je conseille de n''en mettre que deux! ', '2016-06-09T00:44:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 3a444522-7f57-44e3-a1ec-3e8cb508dc57, 'Excellente recette !!! Un régal pour toute la famille. ', '2016-05-10T23:54:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 6cd9947c-a436-493f-912e-6ebe1b220737, 'Mes invités ont adoré. Excellente recette et très simple.', '2016-05-10T19:10:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 7dab51dd-1e83-45ed-a319-46e6d7c21547, 'Très bon dessert mais personnellement je mets moins de sucre et plus de chocolat.', '2016-05-06T11:48:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 1cdea9ad-6d05-43c0-8900-2a6a0e11816c, 'Je fais cette recette depuis longtemps et je mets une plaque entière de chocolat, que j''utilise seul pour bien marqué la différence entre l''amertume du chocolat avec le gout déjà sucré des bananes. Pour l''appareil je mélange les œufs et la crème rien de plus.', '2015-12-02T18:18:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, ca906a04-2aa5-4190-9e03-8d0b50357d94, 'Très bonne, à refaire. J''ai fait la pâte sablée moi-même et j''ai ajouté dix minutes de cuisson.', '2015-11-17T12:29:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, a4bfc569-0e9e-4f7a-acd9-5abb14f319d2, 'Excellente recette A faire et refaire', '2015-11-13T21:21:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, db74ea72-fc94-4869-85c1-c9458a0426ef, 'J''ai suivi une première fois la recette à la lettre résultat bon mais pas top. pour une recette au top (à mon gout) : 200 g de chocolat avec 20 cl de crème liquide entière, remplacer le lait par 20 cl de crème liquide entière et ajouter 1 oeuf. ', '2015-11-13T13:21:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, adf1506e-f008-4fd8-8ff8-61aebb26f119, 'Nickel ! Rien à ajouter, parfait', '2015-11-08T14:02:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 94b79cb2-0ecf-4724-bb0d-cfbdf592fa5f, 'J''ai suivi la recette à la lettre,  mais j''ai juste rajouté effectivement 10 minutes de cuisson. C''est super bon ! Je recommande !', '2015-10-18T22:34:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 733f2aaa-df5c-4617-87bb-a62c779f0e6d, 'Très bonne et facile recette. Je me suis régalée. J''ai juste fait la pâte sablée moi même. A déguster tiède.  Merci pour cette recette. ', '2015-10-07T16:31:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 2d3333e9-8cba-4e5a-b043-71b60f446075, 'Parfaite après quelques modifications ! J''ai mis de la crème épaisse directement à faire fondre avec le chocolat et j''ai utilisé ce qui restait de crème pour le dessus de la tarte. Je n''ai pas mis de lait pour qu''elle ne soit pas liquide. J''ai également ajouté un bouchon de Calvados dans le chocolat ce qui a été grandement apprécié ! Enfin, 10 minutes avant de la sortir je l''ai légèrement saupoudré de sucre pour caraméliser le dessus. UN RÉGAL !', '2015-05-04T21:40:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 89d6c811-de6e-463d-99d3-1b9ad9f6905e, 'La cuisine et moi ne sommes pas tres amies, mes plats et desserts sont toujours ratés; mais j''ai, malgré tout, voulu essayer cette recette, et là.....c''est une réussite totale !!!! j''ai suivi la recette à la lettre, un vrai régal ! j''ai mis plus de temps à la préparer que mes convives à la manger ! je reprend enfin gout à la cuisine donc un grand Merci ! ', '2015-05-01T16:45:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, bd043209-2d5b-4de7-9126-779cd23d7ef2, 'Très bonne ! Cependant, la prochaine fois je cuirai le fond de tarte avant et j''ajouterai 10 minutes au temps de cuisson. Mais excellent !', '2015-03-13T07:22:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 876b0ee3-f2c9-4c67-a5b6-e4e78907ac7b, 'Un délice', '2015-02-11T20:17:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, ca18e426-3e64-4b5f-874a-83aea8e2dd13, 'Super bon et très facile. J''ai utilisé une pâte feuilletée et le résultat est très délicieux !', '2015-01-09T23:17:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, f7ad390e-8360-4324-9894-b4852e4cb8c3, 'Super recette !!! Je l''ai faite hier soir et dégustée ce matin légèrement tiède ! Un régal !', '2015-01-03T12:04:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, bf7b27e2-7c83-434d-8660-cc3facd17351, 'Très bonne recette. Suivi à la lettre. C''était très délicieux pour une première fois que je l''ai faite à refaire. ', '2014-11-15T02:03:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 3300b217-5026-4c21-b38b-b5cccce57efb, 'Un vrai régal ! Je l''ai testé avec une pâte feuilletée car je n''avais rien d''autre et des bananes très mures, le top ! Les proportions sont parfaites ! Merci pour cette recette.', '2014-11-11T20:37:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 858c43d0-dcee-49c5-99df-44219049827d, 'Très bonne recette, j''ai essayé avec de la pâte brisée et le résultat est super ', '2014-11-03T21:45:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 356eafd7-a5b7-48b7-a748-86350d2d7a15, 'Super facile, j''ai remplacé le chocolat par du praliné et ajouté quelques pépites de chocolat. J''ai aussi fait précuire la pâte à blanc avant et rallongé la cuisson à 30 min mais ça ça dépend des fours! en tout cas excellent!!', '2014-08-27T22:29:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, b6d3b7cc-2916-48ed-add2-74c9cff8ad6d, 'Délicieux et facile à faire !!!! ', '2014-08-08T00:29:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 021a8ec1-a49b-4faa-8a17-c838e3d2ada6, 'Super pour ne pas gaspiller les bananes dont la peau noircie. Gourmande, j''ai retenté la recette en doublant la quantité de chocolat, mais du coup on ne sentait plus beaucoup les bananes. Je préfère donc la recette sans modification. ', '2014-07-26T02:28:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 0fff1f0b-3178-4d86-be16-4b1be8dd9e2c, 'Très bon! Je l''ai fait cuire 1 demi heure par rapport à mon four. Nous l''avons mangée tiède. Impeccable!!! ', '2014-04-13T19:45:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36989, 4229b806-f0a7-4bdd-889b-ce34ca52c8b5, 'Très bonne tarte Choco-banane par contre j''ai fait cuire un peu la pâte avant. ', '2014-03-11T19:00:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53349, f9757c5f-ffb3-4bb6-b601-fed9f99f3b2a, 'Un délice! Bon, je n’avais pas de crevettes, seulement les pétoncles, mais c’était délicieux pareil ! Et j’ai ajouté 2 piments oiseau séchés😋', '2023-02-07T01:52:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53349, f1a8598a-3b82-4bd3-9251-0dfeac734cb7, 'Délicieux sans banane et tomate !!! à refaire !', '2015-04-01T20:37:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53349, d1d2479d-fccf-4298-945e-b12ee5e113c3, 'J''ai un peu changé la recette car je n''avais pas de bananes, ni de crevettes!!! Mais juste avec les noix de pétoncles, le lait de coco et les épices, c''était très très bon !!! ', '2008-05-23T02:01:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53349, 8209e0de-7718-45ec-a01b-b1df09aef1f0, 'Une excellent idée pour une entrée, la banane donne un petit plus mais on peut faire sans. Plat parfumé à souhait qui a fait l''unanimité.', '2007-09-09T00:20:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53349, 0b6baa52-87d7-4698-a911-87acce08ad79, 'Excellent merci.', '2019-02-07T22:47:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53349, f67a9a33-4443-45fa-9d4b-d308340761a5, 'Excellent, à refaire sans hésiter. J''ai dû rajouter un peu de sel et de poivre mais c''est vraiment une question de goût.', '2010-01-25T17:18:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53349, c8701eb8-368e-484c-8cdc-042f27adb424, 'Rapide et facile à faire. Je n''ai pas mis de banane (question de goût). Mais par contre, j''ai rajouté de la menthe qui se marie très bien avec le plat.', '2009-03-03T17:23:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53349, 39a0b5bf-5864-4534-a9d4-94bd16becb82, 'Assez bon mais un peu décevant car trop fade, pour mes papilles du moins. La prochaine fois je me replongerai dans un livre de cuisine indienne pour voir ce que je pourrais y rajouter pour relever le goût. En tout cas, j''ai regretté de ne pas avoir de la coriandre fraîche sous la main. Préférer les crevettes fraiches aux crevettes surgelées trop caoutchouteuses (à moins que ce soit une cuisson excessive qui les ait rendue ainsi). Ah sinon les bananes, c''est une super idée.', '2009-01-01T08:37:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338321, 935dc272-2f48-4852-929f-e16bbf937353, 'J’ai ajouté deux bananes au lieu d''une, et je les ai écrasées au lieu de les couper, c’était excellent !', '2022-11-10T20:16:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338321, a14ff556-2879-42be-bf15-b77cd8fb5aa4, 'Super recette 😋 Je l''ai faite avec une banane plantain un peu mûre.
Ces pancakes se mangent nature !', '2023-01-29T21:51:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338321, 2bf1d9b1-e1e9-4e7b-9a63-84eb243f7c32, 'J ai mis 2 bananes au lieu d une et pas de rhum (à cause des allergies). J ai mis le tout ensemble dans un blender, une tuerie ! 
Merci pour la recette.
Avec un peu de sirop d érable pour moi par dessus et nature pour les autres, au top.', '2023-05-11T17:49:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338321, c7beea95-de20-445c-b186-bad937d0237f, 'Délicieux, je mets aussi les bananes écrasées à l’intérieur de la préparation. On peut les manger aussi bien natures qu’avec du Nutella 😉', '2023-01-06T23:46:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338321, af20465c-4db4-47e5-bf98-f3d2a74b5db8, 'Très bonne recette! J''ai mis les bananes directement dans la pâte, cuisson rapide alors attention à ne pas trop les brunires ', '2020-05-10T14:45:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338321, 747f711e-7d94-463e-bbb7-a61c81fae96a, 'Juste une tuerie... La prochaine fois, j’écraserai la banane avec le rhum pour plus de facilité. En tout cas un vrai délice, ça change des traditionnels pancakes et mon mari a adoré...', '2015-09-27T13:05:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338321, 56219e8c-cc48-492e-a3a3-0aa95c0df9e0, 'Très bon, bien légers ! ', '2022-10-02T08:34:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338321, f85ac475-1ef6-4993-999f-39e3d625fefe, 'Bofbof', '2020-04-16T21:07:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338321, 47f9df32-182e-4839-9220-3a5b3d51a66d, 'Délicieux !!!', '2019-06-18T03:13:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338321, 1e2640e5-d528-4dd5-8452-d2011f5d2054, 'Personnellement j''ai mis les bananes directement dans la préparation et j''ai donc mixé le tout. C''est excellent.', '2019-06-16T20:30:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, c0db2ab2-9f36-403d-8075-6a06e46e5f1f, 'J''ai mis moins de farine et 1/2 banane en plus. J''ai utilisé un yaourt à la vanille et donc j''ai mis beaucoup moins de sucre. J''ai utilisé 150 g de chocolat pâtissier et non du nappage. Délicieux mais encore un peu trop sucré. ', '2022-05-29T15:04:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, 335e86bd-8ac8-402e-9874-d589a5f4dbae, 'Je réalise cette recettes tous les vendredis un régal merci.', '2020-12-29T04:58:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, 9f9782a4-322d-4da5-980d-027ace1b1244, 'Très bon,  essai concluant !', '2020-02-29T17:39:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, 190dfe11-7f3f-4b23-b5a4-5c8b4625dca2, 'Recette simple, gâteau moelleux, 50 min de cuisson four normal et hop facile à demouler.
J''ai juste rajouté des noisettes mixées grossièrement dans la pâte chocolat (car banane noisette et chocolat c''est l''alliance de choc pour moi!!) 
Je le referai en mettant un peu moins de sucre.', '2017-06-12T15:27:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, 522630a6-9ee3-4c4b-bd22-82fe3ebd6175, 'Excellente recette ! Famille !', '2015-12-02T00:46:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, dbf45c59-fd3c-4add-808c-c9158e485eec, 'Excellente recette, même en divisant la quantité de beurre par 2 ! Les enfants et les grands (de la crèche ou va ma fille) ont adoré...', '2014-12-20T01:47:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, c8a0ddcc-1728-40ca-b172-ca0a7913244b, 'Excellente recette. Petit conseil pour avoir moins de mal a préparer la pâte : j''ai d''abord mis 1/3 des blancs en neige et j''ai délayé le tout rapidement, en vue d''assouplir la préparation. Ensuite j''ai incorporé le reste des blancs, délicatement. Puis j''ai suivi les étapes suivantes de la recette. Finalement, j''ai obtenu un gâteau très moelleux, pas écoeurant et où l''on retrouve le gout de la banane sans excès. Recette à conserver et à refaire !', '2014-08-23T00:12:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, e59578c7-07df-4584-93a3-fb533e7e0f06, 'Délicieux à l''unanimité !', '2014-01-14T16:50:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, 9738dc9f-5a4d-4e84-9612-ee00573c9fd9, 'Excellent, tiède ou froid, il a fait un tabac !', '2013-08-24T11:47:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, 64395725-5996-4205-af87-e03adbbe9107, 'Effectivement la pâte devient compliquée à mélanger mais ça reste faisable. Je n''ai pas réussi à faire des couches donc j''ai tout mélangé. Expérience réussie, il a fait un carton ! ', '2013-08-21T18:55:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, 14667b2d-235c-40e3-804f-177667a3159a, 'Tout le monde a apprécié. Très bonne recette !', '2013-05-04T16:04:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, c37ba0aa-1053-4f36-881a-fcc115b67969, 'Très bon, on sent bien le goût de la banane. A refaire !', '2013-05-02T22:31:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, d9c2273f-6c94-42c8-a108-6dc7400449eb, 'Super moelleux. À refaire.', '2013-03-17T15:22:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, ccd13811-fae8-4941-b7f1-6f29294cf3bc, 'Le mélange est très dur ce qui rend difficile d''y intégrer les œufs en neige. Pour ce qui est du mélange avec le chocolat, dur également donc difficile à étaler sur le mélange banane. Une fois cuit, très dur à couper, il se défait. Je ne referai pas cette recette', '2013-03-10T17:57:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, 150126aa-7a03-4785-a43e-256d3d9e09e0, 'Bonne recette. Toutefois, j''ai mis moins de sucre et de beurre. Je la referai c''est sur !', '2013-01-20T18:13:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, c600467a-de99-4115-89ba-b549b5a795da, 'Très bon. A recommencer.', '2012-09-07T21:36:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, edd33270-68ae-4425-b4c7-7c9cc51d7bf0, 'J''ai adoré faire cette recette, un véritable jeu d''enfant qui a ravi mes convives.', '2012-05-25T23:04:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, 01b4b18e-876d-40b5-a370-1c0bf157b28d, 'Super recette, je la referai avec plaisir pour mes frères et soeurs moi qui n''a que 12 ans. Très facile merci beaucoup', '2012-03-09T20:57:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, 4aef8bde-ee83-4fc7-a1e6-0e57e499f569, 'Recette facile et cake excellent ! J''ai cependant réduit le dosage de sucre.', '2011-06-19T13:12:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, d90e7d46-9f27-44c4-865f-09ebbb3e89e0, 'J''ai mis une brique de lait de coco à la place du yaourt et du lait ainsi que du nutella à la place du chocolat...Hmmm... Un vrai régal !', '2009-10-17T22:30:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, d68abfc5-ccbd-40b6-90a1-74de290c2406, 'J''ai parfaitement suivi la recette / c''est pas mal, les enfants ont aimé et nous sans plus. Par contre facile à faire et très présentable.', '2008-12-10T17:24:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, eb1dd7be-4106-43e6-b027-0149d587144b, 'Très bon gâteau qui a ravi mon homme et nos amis!', '2008-09-11T13:44:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, b8b824b3-8559-4d8f-bfe8-a97c241718b9, 'Résultat correct mais avec plus d''1h de cuisson dans un four à chaleur tournante et en divisant la quantité de sucre par 2 (sinon la pâte est trop épaisse pour incorporer les blancs d''oeufs en neige)', '2008-02-25T21:42:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63794, ce746146-94bc-47a8-806a-1ce70f3cdac2, 'Mes enfants ont adoré et en réclament encore. Merci.', '2008-01-15T18:42:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33135, 90a340b0-795f-4306-9733-8c225ce78f9c, 'Pas mal, on a bien le goût de la banane et de la confiture de figues. Simple à faire.', '2005-10-02T02:44:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80949, 9ae1bee0-d03f-4211-9b68-c330b4c7e076, 'Ultra classique.', '2011-09-17T23:33:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24485, f774674f-e9bd-4c37-b030-7a338c9f9f9e, 'Aie aie aie c mon second crumble que j''ai confectionné, c une première pour moi. . Mes boys ont adorés et moi dont. J''ACHÈTERAI PLUS A LA BRIOCHE DORE LOL... FINI', '2020-04-18T09:23:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24485, cd2035e3-2a8d-4f16-bbcc-b6e233baa17f, 'Mon dessert préféré.
Je mets plus de fruits et diminue la quantité de pâte.', '2020-04-16T14:38:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24485, 176fdcc3-0ac1-49c1-8a50-754bd54c60d3, 'On a adoré avec les enfants.', '2017-11-02T12:45:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24485, 7be0bd8e-0070-43f7-a021-edffeb712818, 'J''adore, c''est trop bon.', '2016-12-03T18:56:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24485, d1b6fa4e-c256-45ab-931b-043952f2efa7, 'Pas super super !!!', '2013-01-26T21:53:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24485, a186f3c7-4af3-41a0-829d-12093a0d76ba, 'Très bon avec de la crème anglaise.', '2012-11-16T17:19:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24485, 71afcbf6-949d-42b5-93eb-314d2910966c, 'Trop sucré, trop pâteux... recette vraiment décevante... dommage les ingrédients paraissaient appétissants mais le résultat n''y est pas du tout... ', '2010-02-14T17:11:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24485, 6ca5eb21-edc0-44c1-8bad-02880030121e, 'Un délice, surtout avec une boule de vanille! Par contre je conseille de mettre 2 sachets de sucre vanillé pour la cuisson des fruits et de bien attendre qu''il soit tiède avant de le manger.', '2005-08-04T19:27:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24485, 3bd7f1a2-60a2-483f-a4b0-d239764fb386, 'Très bon mais beaucoup trop sucré. Ne pas rajouter les 100g de sucre dans les fruits. Bien respecter les doses pour le chocolat: pas plus de 120g. Pour les fruits, je n''ai utilisé que 3 poires et 3 bananes.', '2004-01-24T00:18:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24485, a4b5f89b-439e-4fe1-adfd-bb99995ccc23, 'C''est un dessert qui a du goût, certes, mais il est vraiment lourd, trop riche. La prochaine fois, je me contenterai d''un crumble poire chocolat.', '2003-10-24T13:24:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39335, 30314bc0-b17b-4ae9-b297-61c34b31e618, 'Ce punch est vraiment excellent, il a eu un grand succès auprès de mes convives!!!', '2008-06-06T21:08:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39335, 9fa4ed78-74bc-4f87-87c7-6ebe4afdb392, 'Un vrai délice.  Je pensais en avoir fait de trop, et finalement, il n''y en avait plus une goutte!!!  J''ai gardé une demi banane et un morceau de mangue que j''ai coupé en dés, ainsi qu''un kiwi coupé en dés également, j''ai ajouté le tout au punch... C''est excellent !!!', '2008-05-21T20:33:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81418, eb4da43e-4c4d-4418-b205-6c828f59639e, 'Trop, trop bon, la recette est désormais copiée... encore meilleure à la fraise !', '2010-07-19T00:04:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81418, e4a3bb96-6471-4f9a-ae50-456288e234a1, 'Cette recette a été publiée après notre validation à l''unanimité générale: Dé-li-cieux!  ;-p ', '2008-10-02T16:30:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20956, 0a4cee5d-81c1-4da9-9b8f-e03f2658bf44, 'J''ai diminué la quantité de sirop de sucre. Le goût de banane est bien prononcé.', '2010-03-06T16:18:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20956, eeb2bb81-1404-49da-b255-5f4e8a123266, 'Bravo et merci, c''est délicieux et simple, mais je suis d''accord avec le commentaire précédent : moins de sucre et d''eau pour le sirop.', '2009-05-21T02:30:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20956, 620183a8-7e28-4405-8b3e-7c5d02e08fb0, 'La glace est excellente, mais un peu trop sucrée à mon goût. Avec 250 g de sucre et 20 cl d''eau pour le sirop, c''est amplement suffisant. De plus, il vaut mieux laisser macérer les raisins beaucoup plus longtemps (surtout s''ils sont très secs au départ).  A conseiller aux amateurs de bananes.', '2007-12-02T18:01:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82847, c03228ec-2205-42ed-bc6b-e4b9b65f27de, 'Ne pas mettre de lait froid ! Cela coupe la cuisson du chocolat et le rend "granuleux" et solide. Pour moi, il n''y avait pas assez de chocolat... Mais sinon l''association est très bonne.', '2011-03-15T20:46:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82847, cad99084-8412-4d87-b3bc-24377a8304a6, 'Fait avec un chocolat noir quel régal de plonger sa cuillère au fond des verrines le mélange des saveurs est une réussite. La prochaine fois je mettrai un peu moins de farine. Merci', '2010-01-29T11:36:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, a835ba61-1acf-4842-8450-6f53b4f3c9d2, 'C''est tellement bon, merci.', '2022-09-06T17:05:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, f1f66b97-fbb5-49c9-8ec4-c7598c8b5df4, 'Miam !', '2021-11-14T11:43:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, c4db07f3-4e15-463d-8ee3-3675d51ab7f7, 'Super un régale juste j’ai recouper mes quartier en deux car ça me paraissait bien gros mais super !!', '2021-05-18T13:37:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 19410574-1395-469e-87ad-92d319f09f1c, 'Testée hier soir et approuvée (on peut y aller mollo sur le sucre effectivement, surtout dans la pâte à crumble). Un peu de cannelle pendant la cuisson des pommes et c''est toute la cuisine qui embaume !', '2018-07-18T09:05:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, a074918a-ce1b-40a7-a5e1-4d7549ad9146, 'Très bon même en zappant la pré-cuisson des pommes que j''ai utilisées crues coupées en cubes. Il est inutile de les précuire avec du sucre car les bananes et la pâte à crumble sont déjà assez sucrées.', '2016-11-24T14:16:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 5af7681a-83e3-4eca-8086-e05956f9bd37, 'Hyper bon, mais avec moins de sucre, car un peu trop sucré pour moi 🤩 Mais sinon, top !', '2022-10-28T22:11:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 6d836150-5655-4cf7-8e71-7280f46195dc, 'Super recette qui a fait l''unanimité ! Délicieux et vraiment simple', '2021-05-04T16:24:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, db67436b-d500-4c76-9ff2-f3f5db76c75a, 'Recette très simple à faire, j''ai mis de la canelle pendant la cuisson des pommes, un pur délice ! ', '2021-02-19T15:22:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, b41f1426-6138-49fe-aced-81d594e0355e, 'Excellente recette, je n''ai pas mis de sucre avec les pommes et je l''ai réduit de moitié pour la pâte à crumble.  Tout le monde en redemande !!!!!!', '2020-11-26T16:24:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 3397b8ae-ca90-42e0-994d-bbc7c5c69aa0, 'Super bon ! C''était mon premier crumble et tout le monde a adoré ! J''ai juste suivi les conseils et retiré 50g de sucre dans les pommes et dans le crumble et ai rajouté les bananes à la fin de la cuisson des pommes ! Un régal ! ', '2019-11-14T11:00:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, ed0b5bdd-515d-46b2-96db-b8c098aefd78, 'Recette super facile à réaliser. J''ai également mis moins de sucre dans la pâte et je n''ai pas fait l''étape de cuire les pommes avec le sucre avant.', '2019-03-18T06:42:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 61f0e6da-e6c9-4391-95ba-02d037d561f1, 'Je l''ai préparé comme préconisé avec moitié moins de sucre et 1/3-2/3 de farine de blé noir c''était vraiment très bon. Merci pour cette bonne recette.', '2018-02-27T13:21:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 324f9d41-ee4a-462c-8f97-de7ef8d29b48, 'J''ai doublé les quantités de fruits et supprimé le sucre à la cuisson des pommes, mais délicieux !! A refaire très vite ', '2017-02-14T16:59:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 5995b703-a571-46f9-8175-6635d07f2f36, 'J''ai réalisé ce crumble, j''ai enlevé 50 g de sucre aux pommes et 50 g à la pâte à crumble. Il était encore trop sucré.. La prochaine fois je mettrai encore moins de sucre.. Mis à part ça très bonne recette.', '2017-02-04T17:41:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, e6ebf5ac-fb09-4391-9c40-742ece8cfaf6, 'Je mettrai moins de sucre et pour la farine j''ai mis 50 g de blé noir et le reste de la farine normale c''était excellent.', '2016-10-17T15:28:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 6120add8-2872-4a86-b6d7-bd588b8dbd2d, 'Très bon (je mettrais un peu moins de sucre la prochaine fois par contre).', '2016-02-27T22:03:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 5ef4a4c3-f47a-4f28-ba40-67d98903b4e8, 'Vraiment délicieux, avec une petite sauce au chocolat. J''ai juste mis 50 g de sucre en moins et une petite banane en plus.', '2016-02-19T21:03:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 530547e7-7cf1-4603-bd2c-c8626c08fc50, 'Très bonne recette! Merci.', '2016-02-07T01:09:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, e9d9b638-7025-4a81-8e5f-4d362a884b80, 'Un vrai délice, mettre un peu moins de sucre comme il est indiqué dans les commentaires. Bien couper les pommes en quartiers (faire des fines tranches). Donc bon dessert ! ', '2015-10-25T15:39:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 985cdc7a-7598-43e3-89f1-ed3b48ca9729, 'J''ai goûté de meilleures recettes de crumble...mais pas mal quand même!', '2015-09-30T21:24:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 7cdc46d1-d635-4a8c-9e3f-8a598345bff5, 'J''ai mis moitié sucre pour les fruits et la pâte la deuxième fois et du coup excellent dessert   ', '2015-08-12T18:56:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, bd19f336-cfe7-46e0-99b9-15067f7c792a, 'Recette très bonne mais un peu trop sucrée ! Mettre moins de sucre dans les pommes et pour la pâte 100g de sucre et de farine', '2015-07-18T21:57:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, d4b8929b-4883-4736-ba4b-150fc8374e02, 'J''ai mis moins de sucre sur les pommes et mis du sucre de canne complet pour la pâte. C''était délicieux !', '2015-04-20T20:29:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, f0470523-f35e-4f37-a7d8-7498e4f3b4fb, 'Très bonne recette, mais il faut vraiment diminuer le sucre. J''ai également fait cuire les bananes dans la même casserole que les pommes. ', '2015-03-05T18:42:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, cc4d76db-73dc-4dc1-99ce-85900a759b53, 'Réduire les portions de sucre', '2015-02-17T11:23:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 8d20a177-0d12-4586-b45a-7c0a9d372a71, 'Extrêmement simple et excellent : la banane apporte un vrai plus dans la recette.', '2015-02-15T19:36:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, bff5fdf2-9523-4100-8be6-c204b49b85bf, 'J''adore, 1 de mes classiques depuis quelques temps. ', '2014-12-23T18:35:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 826c63e2-26fb-407b-9d5d-bd1c1608d229, 'Excellente recette ! Très simple et rapide à réaliser. Je n''ai pas mis de sucre dans les pommes et presonne ne s''en est plaint.', '2014-11-30T19:41:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 3ff5945b-fa1e-4463-ba22-6785fde97e51, 'Très bonne recette, dur de ne pas se resservir ! J''ai également réduit le sucre à mélanger aux pommes, 50 g au lieu des 100 g indiqués. ', '2014-11-16T23:35:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, b910f144-20d4-4a1a-976e-8e5fddcaf9d3, 'Trop bon', '2014-10-26T19:24:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 989fc3d9-53d5-46c5-9d57-9a87cdc70395, 'Je n''avais jamais fait de crumble avant, mais c''est ultra simple ! Et même sans sucre roux c''est un délice ;)', '2014-07-03T18:04:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, d29ff68e-bdb2-4bcf-a092-0bcf9b96d53d, 'Super recette très rafraîchissante ! J''ai aussi mis moitié de sucre avec les pommes. Et j''ai rajouté de la menthe avant de mettre la pâte crumble. Un délice recommandé par ma famille ! :-)', '2014-05-20T02:04:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, bff3825c-53e9-4d6a-b10e-54463edd2e21, 'Très simple et très bon ! J''ai suivi les conseils pour le sucre, tout le monde s''est régalé. Merci !', '2014-05-05T13:54:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 17448ad2-436c-490b-9def-fb043d3586aa, 'Un pur délice !!! A refaire sans hésiter ! ', '2014-04-28T22:54:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 6c2ee367-da7f-4af9-a455-4c4096f1e84c, 'Excellent et les pommes sont très moelleuses. Recette faite un très grand nombre de fois depuis !', '2014-04-25T21:09:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 0c8b87fa-29b5-4405-9d2e-baf89f879da4, 'C''est délicieux. Le crumble aux pommes ou avec d''autres fruits cela se marie très bien . Mes amies et ma famille ont adoré. Merci !  ', '2014-04-17T02:12:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 0df97fd4-1e45-4a77-bc25-778622b732aa, 'Très bon. Je les fais ce week-end. En effet la dose de sucre faut la diminuer !', '2014-03-30T19:21:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 4de040ae-fcc8-4f29-a71e-667ae502632d, 'Très bon et très facile à faire. Je le fais souvent. ', '2014-02-09T16:23:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 2961ea43-0c1c-49c8-97af-c2e647aa732f, 'Très bon crumble, facile, rapide et à refaire ! On peut effectivement diminuer un peu la dose de sucre', '2014-02-04T13:15:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 0ed0d71b-f09d-4736-aba1-d7f2ba58e4d6, 'Super, je le réalise à chaque fois que j''ai des invités.', '2014-02-02T10:53:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, eb6d3e9e-3233-48b6-b0ab-dd2ac4902463, 'J''ai fait cette recette une fois à des amies et depuis on me la réclame. Je mets juste moins de sucre dans les ingrédients (50 g au lieu des 100 g). Délicieux !', '2014-01-14T07:41:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 590a8e20-b0da-4161-9f02-fc4cbb98004a, 'J''ai adoré. C''est devenu mon dessert de tous les jours. ', '2014-01-05T16:50:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, e5ccc091-905d-4729-91ef-34deedb3288a, 'Un excellent crumble !!! A fait l’unanimité! Je l''ai servi chaud avec de la glace vanille aux pécans ! Merci marmiton!!!', '2014-01-01T11:18:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 83147eb6-ebb8-4f7d-99d9-176aebfbe7d6, 'Recette très sympa, rapide facile et pas chère ! Un peu trop sucrée à mon goût hormis ça, pour une 1ère c''était parfait ! ', '2013-12-11T20:15:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, a8788873-eec2-414b-96f7-5df2cfc79ce1, 'Excellente recette, mais un peu trop sucrée ! 50 g de sucre en poudre sur les pommes, c''est bien assez suffisant voir même encore un peu trop.', '2013-12-03T14:28:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 8b7b56d4-4098-469c-91ce-4b616b8d49bb, 'Recette très bonne ! Je n''ai pas précuit les pommes, je les ai mises dans mon moule avec le crumble et j''ai cuit le tout à 180°C 30 minutes. Un délice, merci pour cette recette !', '2013-11-26T23:54:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, c42630d9-1fab-4c06-9b0e-a9adfd353f66, 'Facile et délicieux !!!! Que demander de plus ?', '2013-11-09T13:04:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 1b1c7a7f-01c1-4d7f-ac1c-dee41efb4e72, 'Très bonne recette. Une réussite à chaque fois. ', '2013-10-25T12:40:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, c867f735-eb69-4dc5-b364-aa2fc6979c17, 'Un délice ! Par contre j''ai pris de la cassonade pour les pommes (50 g au lieu de 100 g), je n''ai pas mis de citron et j''ai ajouté les bananes à la cuisson des pommes. J''ai aussi mélangé la pâte avec mes mains pour obtenir un mélange sableux plus correct. Un vrai régal.', '2013-09-22T14:23:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 1b797b6d-c39d-4b03-a027-d8ebb26c142a, 'Super recette c''est très bon ! Le sucre n''est vraiment pas nécessaire et il peut être remplacé par le sucre vanillé donne une légère touche exotique  !', '2013-07-24T13:45:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, f879e795-cf28-462c-bdea-cbfb045f71ce, 'Délicieux !!! j''ai juste mis seulement 50 g de sucre dans la préparation des pommes et pour le crumble 100 g de farine mais à part ça un délice à refaire !', '2013-06-09T00:21:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, cace83a2-5e56-4ecb-bbe8-60975d9e43aa, 'Super... mais avec 25 g de sucre dans les pommes !', '2013-05-31T17:36:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 8c72063c-9a59-4b71-a1bb-60bf2df329df, 'Excellent ! Ce fut un franc succès ! ', '2013-05-29T05:17:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 41fcb476-8889-4ca6-bff5-6cf14214db02, 'Bon dessert! Je n''avais que 3 petites pommes et 3 bananes (le tout très mûres), j''ai oublié la cannelle. Le jus de citron donne un goût acidulé super sympa. Je conseillerai aussi de ne pas ajouter de sucre et de prendre un "petit" plat à gratin.', '2013-05-22T21:30:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, e76768ca-64fc-4800-90b3-740f8d494d52, 'Très bon, mais trop sucré !', '2013-05-01T22:12:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, a4bdc129-51d4-4f26-86f1-9cbc16d4ccdc, 'Très bonne recette ! Facile à préparer. Pour la préparation des pommes, on peut ajouter un peu de cannelle, ou alors mettre une cuillère à café de miel.  Mes colocataires adorent en tout cas ! Merci.', '2013-04-22T19:06:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 6fec2414-2dde-4ea0-bf12-ee2aa79ca842, 'Beaucoup trop sucré !!! Mettre beaucoup moins de sucre la prochaine fois et utiliser des fruits plus acides comme les fruits rouges ou la rhubarbe !', '2013-04-08T19:15:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 4eadbc4e-3896-4d48-a257-76f24cc81aaa, 'Très bonne association des goûts. J''ai mis plus de cannelle que prévue. j''ai fait mariner les bananes dans le citron vert et j''ai utilisé les pommes grises du Canada, ce sont des pommes un peu acidulées qui réduisent très bien en compote (donc mettre peu de citron avec les bananes). Sans hésiter : à refaire ! ', '2013-03-11T20:29:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, fe4025e5-0f51-498a-b1f6-188fb0472365, 'Bon mais trop sucré...', '2013-03-05T18:04:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21498, 431e33ad-f73b-4723-bd93-8ea8f9f76df5, 'Délicieux !J''ai vraiment testé plein de recettes de crumble et celle-ci est de loin la meilleure ! Je n''avais que 3 pommes et 2 bananes et c''était quand même parfait ! La quantité de pâte était parfaite (en plus d''être très bonne !). Par contre je n''ai mis que 25 g de sucre dans les fruits et c''était quand même bien sucré, voir caramélisé après la cuisson au four... Hum ! A refaire !', '2013-03-01T16:37:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 35f08d52-35b6-4c21-9dea-7c8bf9d23bb5, 'Moi je creuse la pomme, je rempli avec de la confiture et du beurre et la pose sur une tranche de bon pain avant de l''enfourner. Un vrai régal car le pain caramélise.', '2015-01-18T10:00:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, b235f289-e0b3-4339-9235-f1cf45d586b5, 'Personnellement, je creuse la pomme et y insère un peu de poudre d''amandes, puis du miel crémeux de lavande. Je termine par une noix de beurre saupoudrée de cannelle. 1 verre d''eau au fond du plat. J''enfourne 30 min à 180°C et le tour est joué ! C''est à tomber par terre.', '2014-11-22T21:47:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, e195a4f4-2ba8-448f-85d5-43030a2cd091, 'Top pour la cuisson, j''ai juste ajouté au centre des pommes un mélange de spéculoos écrasés, beurre et confiture de mangue et saupoudré de cassonade. Mes 2 hommes se sont régalés !', '2014-11-23T22:35:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 9c989782-b56d-4f9c-9faf-3cc2b8e02878, 'Une noisette de beurre en plus et c’est divinement bon ', '2022-01-03T16:09:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, d6456dea-3564-4738-9ea0-d60d573ef725, 'J''ai ajouté dans chaque pomme une cuillère de raisins secs, du miel, une cuillère de sucre, une noisette de beurre et j''ai saupoudré de cannelle. Un vrai délice.', '2020-04-22T21:17:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 789a730a-c967-4635-98f0-88fe77575a65, 'J''ajoute quelques gouttes d''extrait de vanille dans le trou avant de mettre le sucre. Encore meilleur !', '2020-01-26T20:04:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, bfb4c3a2-5738-4e1c-bd94-7cc0725d2b7b, 'J''ajoute de la cannelle !', '2018-03-10T12:37:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, d8fdda77-7eae-45e6-88c3-4958511c34bf, 'Très facile à faire, et très bon ! Très pratique lorsque l''on est étudiant et qu''on a pas forcément des tonnes d''épices et d''ingrédients sous la main. ', '2015-01-14T21:25:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 4b16bcff-9cfe-401e-b313-dbbd20c76c90, 'Simple & facile, un délice ! ', '2014-02-23T17:58:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, a7494266-2891-44c8-80a2-ae5fb9971a9e, 'C''est bof mais facile à en faire un délice... Ajouter à l''intérieur en remplacement du trognon : gelée de groseille ou de ce que vous voulez, framboise abricot. Mettre un peu de beurre salé sur le dessus+ sucre vanillé et cassonade. Une rasade de kirsch ou d''alcool fort. ET DE LA CANNELLE ! Je mets une heure à 150°C. Promis, ce n''est pas de boulot mais vous m''en direz des nouvelles !', '2013-10-23T19:18:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 4b3266ca-5154-41c4-8ceb-58b08ca6c66a, 'Merci, recette simple sans miel ni créme fraîche, merci beaucoup.', '2006-02-22T11:48:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 5abde566-44df-45b4-a4a2-c156cd353062, 'Tres facile et bon', '2021-11-15T13:39:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 242d2674-ce6f-45a3-bccd-9f1e37a5e905, 'Bien dorée c''était super bon', '2021-05-10T22:02:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 19fccb12-9c02-4ec4-b167-229ca4a19672, 'C’est encore meilleur avec de la confiture', '2021-04-18T12:17:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 8a53b92a-a4e1-4e88-8597-942eaf7d90c3, 'Pour ma part, j''ai pelé et enlevé le trognon des pommes.. Posé dans un plat. J''ai soupoudré avec du sucre (quelques unes avec en peu de la cannelle). Mis de l''eau au fond pour faire un petit sirop 😉.. Couvert le tout et au four à 150-180°C, chaleur tournante pendant 20 à 25 minutes (un peu plus en fonction de la variété de la pomme).. UN RÉGAL.. Bisous. ', '2021-04-10T12:28:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 8e7342a9-5445-4dd1-9a9e-567ca949fe07, 'L''eau a transformé les pommes en compote qui baigne dans un jus aqueux; C''est mangeable mais ça n''a rien à voir avec des pommes au four !', '2020-12-05T17:13:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 9119b2e4-47f5-4e6c-91e7-22e4f17a8e2f, 'C''est bon !', '2020-04-30T21:27:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 33924524-9755-42fd-8b12-3b4c64b033a5, 'Excellent ! Je mets parfois de la cannelle pour ceux qui aiment ça !', '2020-02-24T23:29:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, d9ff89db-1f20-438f-837d-335dbd189ce0, 'A la place de l''eau, je verse un verre de vin rouge.', '2020-01-27T11:54:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 2639d4e5-e602-48ee-abb0-6e6770cb5520, 'Bonne recette. Simple et efficace.', '2019-10-27T09:15:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 3e0e465f-f103-4c10-aa92-ad7ebf76cd31, 'Pour ma part la pomme n''est pas dorée, j''ai suivi la recette... déçue.', '2018-11-30T02:25:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 6ea4975a-2841-49d9-bb0f-3320b312ce43, 'C''est également ma recette... simplissime et excellente !  Je confirme !', '2018-05-23T09:02:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 25c79cea-3e28-40f3-ab69-1eaca49d9c4c, 'Mes pommes n’étaient pas cuites ! Mais la douceur de l''accompagnement était bien agréable. Je n''avais pas de noix normales alors j''ai utilisé des noix de pécan, c’était très bon aussi.', '2018-05-13T15:14:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, d99776eb-a697-4adf-ade9-d2dcb60df3df, 'Tellement facile, tellement bon !  !', '2018-02-22T20:04:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, e04a3890-3aa0-4a71-a13a-c3e953cf4dd4, 'C’est super bon ! J’ai creusé la pomme et j’ai mi du miel dans le fond, raison par dessus et encore du miel au dessus ! Un petite lichette de beurre et après j’ai saupoudré de sucre. Le mieux serait des les mettre dans des petits ramequins car la pomme fond un peu... Je pense 25 min c’est pas mal.', '2017-10-21T16:08:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 2f8d24f3-fea9-4d66-bc55-076f541787a1, 'Ca me rappelle le bon dessert que ma mère me faisait souvent et c''est vrai que c''est bon !', '2017-08-31T21:26:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, ff7306aa-e6cb-4dd2-b134-219b83c4f100, 'J''ai mis du beurre dans le trou et du lemon-curd parsemé de cassonade et de cannelle, cuire 40 mn à peu près miam ! miam ! ', '2016-12-20T21:16:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 0ed6704b-dc7c-4dd8-8c76-cfbd9c9a7985, 'Très bon, il faut juste prendre les pommes de la même taille et pas trop grosses. Ce que je n''ai pas fait.', '2016-09-21T21:44:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 3ae2a47e-0f8d-4aa0-b15e-e9cc5eac25c8, 'Recette essayée et à éviter ! Si l''on se contente d''équeuter la pomme sans retirer le trognon la pomme ne cuit pas à coeur. Il est dit dans la recette de saupoudrer de sucre mais il n''accroche pas sur la peau. D''où l''intérêt de creuser le centre pour y mettre un peu de beurre avec du sucre.', '2015-12-21T15:31:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, ec46c479-2b76-4b8a-aaa6-e0263cf4a04a, 'Super recette, moi j''ajoute un morceau de beurre au milieu', '2015-09-20T21:38:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, dfe29ccb-57c7-4f1c-adb8-d803e4044d2b, 'Pour ma part, j''ai mis de la crème de caramel au beurre salé dans les pommes, saupoudrées de cannelle et 30 min de cuisson mais à 220 °c. On les a mangées avec de la glace vanille et on s''est régalé.', '2014-10-17T23:16:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, f0cf15d6-e15e-44bb-b0d3-d9b7f929b96a, 'J''ai mis de la gelée de coing (maison), du beurre salé et du sucre. Très simple, très bon.', '2013-10-16T18:01:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 52474873-e5f1-4a72-bcc7-95304e4d880d, '30 minutes à four 180°C ce n''est pas assez. Les pommes n’étaient pas du tout dorées. Je referai cette recette avec un four plus chaud et pendant plus longtemps. ', '2013-05-19T22:37:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 60813f39-c648-442a-906d-73f18da63fb9, 'Une touche de beurre demi-sel pour ceux qui aiment le sucré salé, juste un régal !', '2013-03-30T16:17:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, c622fb99-6d27-443f-86e7-8fdf284b90ea, 'J''ai préparé des pommes au four pour midi avec un peu de beurre, de sucre vanillé (maison) et et du coulis de fruits rouges.', '2013-03-12T12:46:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 5cbd55ec-729c-4be3-9309-daac0974101a, 'Pas terrible ! 30 min à 180°C pour des golden ce n''est pas suffisant. Je suis déçue.', '2012-10-31T22:19:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 1f053f62-73e8-41af-9961-c3210359933e, 'La prochaine fois je remplacerai la cannelle par des amandes effilées et laisserai les pommes un peu plus longtemps au four, je l''ai faite avec des granny smith', '2012-07-14T15:56:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, fb78a9bd-41b4-4f98-8ef4-caa99911ab84, 'Très bon ! A la place du sucre on peut mettre du miel ça parfume bien', '2012-06-10T23:52:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 18cba098-ee05-463c-a0a7-b1cfd2e9a18f, 'Surveillez bien la cuisson. Je me suis laissée dépasser par le temps la 1ère fois et je me suis retrouvée avec de la compote dans mon plat ! Sinon : simple et goûteux', '2012-03-11T01:48:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 4dce22f8-181b-4cf8-b858-9b33c69eb530, 'Je viens de faire ce dessert facile et délicieux ! J''ai suivi les conseils : du pain au fond du plat et j''ai mis de la gelée de framboise maison au cœur des pommes.', '2011-11-08T13:47:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 8500153d-88ae-47d0-9dd4-44ccdcbac466, 'Un délice. Très simple à faire et un dessert savoureux... Les enfants ont adoré.', '2011-10-16T16:05:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, f060f315-8d8c-4603-8427-4a864ec5994c, 'Avec une pointe de cannelle c''est encore meilleur', '2010-11-12T13:20:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 612709f6-97f4-418b-95cd-413ca5008f7e, 'Un vrai délice ! Simple mais tellement bon ! Merci', '2010-04-18T20:47:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 816583a0-1a1f-47ed-8fee-6e12e6bc2c18, 'Cette recette me rappelle les pommes au four de ma maman... Que du bonheur !!', '2010-04-03T21:37:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, c3e1b0d9-61d0-4be6-b90c-08b7febbb937, 'C''est effectivement une recette simple et délicieuse...  Moi je fais comme ma mère... La pomme creusée est posée sur une tranche de pain ou encore mieux de brioche, et je mets dans le creux de la pomme un peu de beurre (que je coupe avec le vide pomme, comme ça il a la même taille) et du sucre. Pour mes copains invités, je rajoute un peu de calvados, histoire de...', '2009-10-28T12:50:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, b8c08d50-7bfe-4784-b56b-06a61eb3ea6f, '2 pommes chacun ; avec le trognon enlevé, et de la cassonade ; le tout au four 20 minutes.  L''eau au fond du plat mélangée au sucre a permis de caraméliser les pommes : un vrai régal! Un dessert extra, light et très rapide à faire. Merci.', '2009-01-22T09:58:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 21035976-059b-486a-8dd5-0744c18db4cd, 'Comme j''ai un bébé, j''ai juste coupé les pommes en tranches afin qu''il puisse en manger. En plus, la cuisson a été super rapide. Toute la famille s''est régalé. A refaire régulièrement. Un grand merci !', '2008-12-04T14:20:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 132887f1-f70e-4666-9348-fadb1545d86a, 'Ca va. Ce qui est vrai c''est que c''est simple, mais c''est quand même meilleur avec de la confiture (groseille par ex.).  Sinon merci pour le coup des fourchettes !', '2008-11-05T20:19:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 8bb52cf5-e842-4e92-ac81-417c65b2ab29, 'Problème au niveau du temps de cuisson. Je mettrai le four moins fort la prochaine fois et je les laisserai plus longtemps. Un peu déçue.', '2008-10-26T13:46:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 559da86c-ba37-497b-9f7e-d57f57ee830f, 'Tout simple et tout bon ! ', '2008-02-15T15:27:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, e73c8b0f-36f7-483f-9095-3d45efe1e3bd, 'A la place du sucre en poudre je mets de la cassonnade et de la cannelle, c''est plus que délicieux et tellement facile... ', '2008-01-25T13:32:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 7edce7c3-605b-446c-abb9-9c8d8d5f7985, 'Une recette simple et délicieuse. Parfaite quand des copains viennent diner. J''ai ajouté quelques noix pour le goût. Et la prochaine fois je mettrai plus d''eau au fond pour avoir plus de jus! ', '2007-05-07T13:05:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, a54232c3-4258-435a-8150-9b99289bf09c, 'Rien à redire. Délicieux et très facile. ', '2007-03-25T14:12:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, e3703ce0-bb9a-42b0-a270-6798891262c8, 'Enfin quelque chose de simple et de délicieux, parfait pour tenir un équilibre alimentaire sans faire d''excès !!!!!', '2007-02-19T20:57:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 49a45de9-e0e8-4d8f-9e59-1cad065aa2fd, 'Tout simple et très bon! Merci.', '2006-11-24T13:01:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 8b8b6e68-82b8-4d70-868b-5ab341306fdd, 'Je viens de réaliser cette pomme au four toute simple pour mon dessert. Un seul mot: dé-li-cieux!', '2006-11-07T21:52:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 9488af01-c953-4685-af7d-453a69ba9d17, 'Enfin une recette facile et délicieuse. C''est un désert sans chichi et convivial. Merci! ', '2006-04-07T22:20:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 081d4358-6f0b-4ca7-9aca-2898dc0ec805, 'Je cherchais un dessert facile à faire à base de pommes pour ne pas gâcher les quelques pommes qui me restaient, je crois que j''ai trouvé...', '2005-06-07T13:14:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, c43cfe43-f6b3-44ea-9343-033372e4a0e4, 'Très simple et bon!', '2004-11-11T18:43:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, f109706d-c35e-460b-9516-0bf6404b0ffc, 'Oui!!!! La recette d''antan sans 36 autres ingrédients que l''on n''a pas forcément sous la main un dimanche soir... :o) Merci!!! Mettre le four à 180°C (350°F) pendant 30 minutes et c''est parfait.', '2004-10-11T06:49:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56255, f37de85f-085f-43c4-b1e4-ca4c878c282b, 'Recette originale est très bonne! La prochaine fois je mettrais encore plus de bananes ?', '2021-01-02T21:40:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56255, 14a4f781-ba63-47ce-8c6e-fe29a455cab6, 'Rien à dire c''est très bon', '2008-01-20T01:04:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59241, 2b4eb1ee-6ba2-427d-ad6b-ef7b2c62e7db, 'Tout simple, rapide pour un goûter avec sa nièce adorée (par exemple !)...', '2011-08-06T03:32:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325575, e1449021-77b7-4424-b9d3-1f8189849516, 'Trop bon, merci Anne-Sophie ! Un vrai régal ! Je n''ai pas mis beaucoup de sucre dans la chantilly/mascarpone et cela n''en était que meilleure ! Je recommande cette recette.', '2020-11-08T15:04:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325575, 3b0eed9c-044a-4614-b7a3-938539eaba9f, 'Un super dessert facile a réaliser si on suit méthodiquement la recette. Ensuite, c''est un délice..!', '2018-06-04T20:01:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61335, f4da5eb8-6172-4dd6-b1b1-fbde7348bc5e, 'Excellent !', '2014-04-06T19:11:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34577, 9a57a522-dd9d-4855-ad5e-f5a92f004d72, 'Après avoir pris connaissance de certains avis, j''ai fait quelques changements : J''ai beurré les toasts, puis j''ai mis sur le beurre de la fleur de sel et sur les rondelles de bananes du poivre du moulin. Le résultat est excellent!!! Un grand merci, bien à vous. Dandecazals.  ', '2013-12-14T17:39:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34577, 1231a450-daf7-4803-b017-f52230625cb9, 'Surprenant et original. De préférence, coupez les toasts en 4, et ajoutez du poivre, grossièrement concassé entre les bananes et le râpé.', '2005-12-19T18:04:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34577, 84ee0525-16bb-4ce3-93ea-d3436459c087, 'Trop bon. Et super vite fait. J''en ai fait une partie en suivant la recette et l''autre en ajoutant sur le pain de mie avant la pause des bananes de la crème fraîche. Hummm', '2019-04-10T23:48:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34577, 92fc098d-4a9b-48f0-8c21-79f770f2952b, 'Excellent avec le beurre sur les toasts, la fleur de sel sur le beurre et le poivre du moulin sur les rondelles de banane. Je vais la refaire régulièrement.', '2015-01-24T18:49:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34577, 148e817a-6e6d-4d80-861b-c42dca340a5e, 'Pas terrible mais si vous raffolez de sucré salé cela devrait vous plaire', '2009-11-07T19:03:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34577, 3aaa4dde-1e20-450f-900d-30fc8366f5c1, 'Parfait ... il n''y en a jamais assez. ', '2008-09-20T19:52:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34577, 1411befe-1f62-4455-a47d-19eb637ffab0, 'Pas mal, oui, mais il y manque un peu de jus de citron, un peu de fleur de sel, un peu de ...?', '2008-08-10T22:23:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40138, f7afa704-83fd-43ca-97cc-5338162f67c3, 'A EVITER ! Des quantités trop importantes, un dosage très approximatif, un résultat peu goûteux et trop sucré. Une recette suivie à la lettre et pourtant...', '2016-05-05T22:17:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40138, 3e1a4935-93b5-4725-8196-970ce1ff2c4e, 'MIAM!! Très bon !! Pour avoir deux gâteaux, il faut se tromper dans les proportions,  En cuisine, 1 "tasse" = 20 cl, soit la moitié de ce qu''on appelle une "tasse" en France (qui est en fait un mug). Très bon gateau, vite fait, vite mangé !', '2007-08-07T17:26:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40138, 4c9f78f0-8f14-45be-b4bb-7ee544013888, 'Très décevant. Le goût de l''ananas est complètement écrasé par celui de la banane, et pourtant je n''en avais mis que 2. Les proportions sont énormes et donnent deux gâteaux dans un moule de 25 x 12 cm.', '2006-01-30T11:39:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392226, 0ecda95a-abb7-4a51-a9f5-3c3122c69369, 'Trop bonnnn! J''ai mis moins de beurre et juste un peu de sucre vanillé à la place de la vanille et du sucre. À refaire ! ', '2021-03-11T19:32:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392226, 5ae72732-d0c8-4f29-beea-a0278cdcbc22, 'Très bon !! Moelleux et fondant !!
Je n''ai pas mis de bicarbonate et jai mis du lait et non du butter milk...
A refaire sans hésitation ', '2020-10-17T16:29:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24728, 551aa24b-077e-4af1-a222-025036a4b91d, 'Côté goût ça va, mais côté aspect pas du tout ! C''est beaucoup trop liquide et franchement ça présente mal. J''ai ajouté deux sachets d''agar-agar mais ça n''a pas fait grand chose. C''est plus proche de la soupe que du flan. C''est bon mais c''est globalement décevant !', '2015-12-27T14:20:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24728, e2b8b7d5-eaf5-4340-9a0b-7490bd64535d, 'En suivant les commentaires précédents, j''ai aussi ajouté 2 c. à s. de maïzena et j''ai fait cuire les gratins pendant 30 minutes. Le résultat est excellent !', '2010-02-08T19:09:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24728, 6fb6e810-aecd-42fe-b584-d3c1f1570335, 'Très bon à condition d''aimer la noix de coco, attention présentation médiocre, je confirme qu''il vaut mieux pour les yeux faire des ramequins individuels', '2009-12-27T21:52:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24728, cfc225ee-ed2d-4306-a1d7-838ffaf7ac8b, 'Excellent! J''ai rajouté un peu de maïzena au mélange lait de coco, rhum, oeufs et crème. J''ai saupoudré la cassonade sur le dessus du plat juste avant de faire gratiner (le reste peut être préparé à l''avance).', '2008-03-16T16:57:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24728, 94ac54be-59da-4922-a08b-f750b9150999, 'C''était super bon, un régal! Tout le monde a adoré!!!', '2007-11-17T13:55:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24728, 8a914512-cc06-4cd7-a0ff-2860d92da192, 'J''ai fait ce dessert avec des pommes et des bananes mais c''était effectivement trop sucré et cela ressemblait plus à une soupe, consistance trop liquide donc désagréable à manger! J''aurais préféré une consistance de flan et non de lait sucré...', '2007-10-04T01:14:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24728, 2c548a0f-e9f3-4e4e-8cdc-9531a07df361, 'Je n''ai pas du tout réussi à faire gratiner, un  peu embetant pour un gratin. Le résultat n''était donc pas très présentable mais c''était quand même très bon au goût...', '2007-08-29T17:03:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24728, a68d6564-3584-4267-afa4-b843621b5616, 'Bonne recette. Le goût est sympa : le rhum, la coco, la cassonade se mélange bien. Avc les doses initiale c''est un chouilla trop sucré. Par contre, la "sauce" est beaucoup trop liquide. Je  réessaierai en la faisait cuire un peu à la casserole avant car là cela ressemble plus à de la soupe qu''à un gratin (je l''ai fait dans un grand plat). Donc, gout OK, visuel ca va, mais texture trop liquide...', '2007-08-07T22:10:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24728, 2ddb12fb-59b7-460a-b24e-1b6b20d69b10, 'Excellent, peut-être un tout petit peu trop sucré, 50 g de cassonnade suffisent à mon avis. Merci.', '2007-02-07T17:17:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24728, bfedaac1-5072-4d93-9a50-59047420fc54, 'Dessert rapide, bienvenu après un copieux repas et qui met une touche d''exotisme. 10 min suffisent amplement pour le gratiner. J''ai remplacé les poires par des kiwis.', '2007-02-05T23:28:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24728, 3a7b754c-8a89-4aef-b56d-522c83b57129, 'Je craignais que l''on ne goûte trop le lait de coco, mais absolument pas. Recette super facile à réaliser, qui peut d''ailleurs être préparée à l''avance, mais couvrir les fruits du lait aromatiser de tous les  ingrédients au moment de gratiner. Perso, j''ai remplacé le sucre par du sucre vanillé, ce qui donne une petite touche encore plus parfumée. Je referai!', '2007-01-03T19:15:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24728, ff2c094b-8516-4833-9a1e-f6133d986ab5, 'C''est très bon, mais je pense que 15 min sous le grill c''est un peu trop, au risque de voir brûler son gratin! J''ai aussi eu un petit problème avec mon lait de coco qui a "tourné", ce qui ne change rien au goût mais c''est moins présentable! ', '2006-03-14T23:53:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24728, f4727168-002f-48f4-9fc6-7add5211845d, 'Servi au réveillon de Noël: léger et excellent après un "bon" repas, avec mangue, banane et ananas. A tester aussi froid, en "soupe".', '2005-12-26T11:27:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24728, 4739b22e-8ead-4791-b72b-4ff405ddc61e, 'Mangue, ananas, kiwi, pommes un peu de rhum du sucre et du sucre vanillé... Le tout doré au grill durant 10mn (dans un plat à gratin beurré).', '2004-03-22T19:34:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, c7919d66-dace-472c-92d5-c0d570e0218c, 'Quelques soit le niveau de cuisson (de normal jusqu''à un goût caramélisé) c''est super bon ! ', '2017-06-14T08:26:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, 2cfe71ae-da18-40f4-bdff-601388b35a3b, 'Une recette originale, qui change des confitures traditionnelles. A petite dose cependant !', '2011-07-10T12:40:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, 62f4842f-e639-48ac-b149-95cee36bd2c7, 'Super bon pour accompagner le pain perdu que j''ai préparé !', '2021-12-20T18:59:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, 41b33c97-dc9f-4059-9394-d4c3bc1b76b8, 'Juste trop de sucre. Pour 2 bananes et 2 pommes, 50 grammes suffisent amplement. J''ai ajouté un peu de noix de coco râpée.', '2017-08-07T21:30:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, 8f6dc021-64b3-4e31-a215-d02c65533bfa, 'Merci pour cette recette qui est parfaite! J''ai mis pour ma part un sachet de sucre vanillé et un bouchon de sirop de rhum pour que ce soit moins fort que le vrai (alcool) et donc pas la fleur d''oranger. ', '2016-07-24T18:22:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, 33438036-5c65-434a-a31b-7b5850490ea5, 'Délicieuse confiture; pour ma part je n''ai pas mis de rhum.', '2016-04-13T10:16:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, d74e2380-813b-4ddb-91fb-f5b3e60820aa, 'Délicieuse confiture. En ce qui me concerne, je prépare les fruits la veille au soir, je les laisse macérer dans le sucre après les avoir arrosés de jus de citron et je les fais cuire le lendemain.', '2013-09-30T14:35:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, 380a84d5-516f-4b27-923b-c2da311eb3f3, 'Confiture originale et testée pour la première fois ! Vu que je n''avais pas de fleur d''Oranger j''ai saupoudré ma préparation de cannelle ce qui fait ressortir le rhum, vraiment bon...', '2013-09-26T18:34:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, 336a631d-2653-4f9b-beac-964a40f938e5, 'Testé pour la 1ère fois. Surprenant et encore inconnu à refaire', '2011-05-06T11:03:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, c91e738b-f77b-4ce6-8b4e-bd86c25cd092, 'Franc succès avec cette recette de confitures, je profite de la faire quand j''ai des bananes qui commencent à trop murir et j''ajoute aussi également des raisins secs.', '2011-04-23T18:54:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, 8fd14df2-f4b5-4d6c-9e98-1310487265bc, 'Recette déjà réalisée à plusieurs reprises et toujours avec beaucoup de succès au moment de déguster.La dernière fois,j''ai rajouter quelques raisin secs 15 min avant la fin de la cuisson. Sympa.', '2010-09-22T18:17:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, 12f06b2b-3259-467e-9f9f-a5b9ed8e9140, 'Recette excellente, la fleur d''oranger est une très bonne idée!!  Je l''ai fait avec ma machine à pain et le résultat est génial!', '2008-11-15T20:46:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, 88c88f2a-579a-4eb8-b43a-6932353f09d0, 'Confiture excellente, j''ai mis moins de sucre, et pas de rhum, (petits-enfants). Nous adorons, j''en referai.', '2008-10-12T22:09:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, 2afc5faa-2cf1-4b52-9dcf-a2a94dffde32, 'Excellente recette .....cette confiture est un régal....j''ai utilisé moins de sucre', '2008-08-18T13:52:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, c02c8b57-5865-421a-ae64-2897566b1a97, 'Je me suis trompé de bouteille et j''ai mis de l''eau de rose à la place. C''était excellent aussi. La recette passe dans mon carnet.', '2007-10-28T16:28:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, 01ba4663-57be-4e0c-b393-c5f84a9edc10, 'Un régal! J''ai remplacé la fleur d''oranger par une gousse de vanille fendue en 2, que j''ai retirée avant de la mettre en pot... Depuis, chaque matin j''ai l''impression d''avoir les îles sur ma tartine !', '2007-08-18T20:31:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, aacda5d1-0cf4-47a8-90cf-28042dc2676c, 'J''ai suivi les conseils de Marion, et je n''ai fait cuire ma confiture qu''1 heure, à feu très doux... De plus, je ne l''ai pas mixé, j''ai préféré garder son aspect "grossier", plein de morceaux, que j''ai disposé sur des tartines de pain perdu, le tout servi tiède, délicieux!', '2006-09-08T11:41:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, c5e35b22-b764-401f-9ced-46b724c3f38e, 'Merveilleux avec un peu moins de banane. A manger avec des crêpes.', '2005-09-29T18:56:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, b1e4c985-9e9e-47aa-820a-e6f2fd0d15f9, 'Le goût est pas mal du tout, mais au bout d''1 heure, la confiture est déjà très épaisse. Faire cuire vraiment très doucement.', '2005-08-16T18:26:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36268, 33640079-30c0-48bd-b0e8-11196652e027, 'Très bon. J''ai mis une pomme de plus pour moins sentir la banane que l''on sent déjà bien... Et une gousse de vanille en plus!', '2005-04-16T20:04:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47193, c076efeb-bdf7-4417-a0d8-4d1702f3b40e, 'Très bon mais beaucoup de travail pour le résultat visuel.', '2010-02-28T09:55:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47193, 271ed4f5-1868-42f2-9993-e97ded456923, 'Ecoeurant avec du nutella, ça passe beaucoup mieux avec du "vrai" chocolat fondu.', '2009-08-23T00:29:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47193, 99339a75-d767-40dc-b00f-01cce8635135, 'Enfantin et très bon. Je l''ai fait pour le gâteau d''anniversaire de ma fille pour l’école, ils n’ont pas laissé une miette ;) ', '2006-09-28T20:03:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43358, 1e94f0b2-3517-4a51-8e3e-baaaef7d4bf4, 'J''ai cuit d''abord la pomme (de texture plus dure), ensuite j''ai ajouté la banane et l''ananas. Ce n''est pas mauvais, sans plus.', '2020-03-28T10:05:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43358, cbf8f82f-14dc-4142-a35b-5734798a8d2c, 'J''ai adapté avec riz-basmati, pas de banane et un mélange lait de coco/crème/eau au lieu du lait. En accompagnement des queues de langoustes à la tahitienne, un régal à Noël.', '2011-01-04T20:22:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43358, 8e6c4538-2945-4c2b-8420-6fe24e81742c, 'Délicieux et facile à faire. J''ai utilisé du riz ordinaire, j''essaierai avec du Basmati la prochaine fois.', '2006-11-04T20:31:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, 82a6d37d-6600-4458-9916-e14e0514fde0, 'Je trouve ça super de transformer un plat salé en un plat sucré !', '2012-08-06T14:26:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, 84af03c9-8c64-443e-acdb-00728693c238, 'Trop bon, facile à faire et vraiment excellent. De plus la sauce peut servir à plein d''autres desserts pour tout ce qui est gâteau sec. ', '2012-01-02T20:59:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, 89e236d6-90be-4bf0-a123-60e312483c48, 'Trés bon et original! Au vu des commentaires, j''ai juste changé la garniture, crème patissière au chocolat, bananes dorées au beurre, et pas de sauce avec juste un peu de chantilly! C''était parfait!', '2008-10-05T13:57:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, ca7f403a-54b7-49c0-89a3-02ecd238247f, 'Très bon mais trop long à préparer. Effectivement, beaucoup trop de chocolat, on peut facilement diviser par 2 la quantité.', '2007-08-17T16:53:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, 311256bf-5901-4082-9a1a-bfb9a520abec, 'Le goût n''est pas mauvais en soi mais il y aurait des modifications à faire ! Déjà, la garniture au chocolat est trop liquide, et coule quand on roule le nems. Et puis c''est bien trop lourd et trop gras ! 200 g de buerre + beurrer les feuilles de brick ça fait beaucoup. D''ailleurs, il me semble que les feuille de brick ne conviennent pas, il faudrait des galettes de riz comme pour les vrai nems... Bref il faut remanier cette recette !', '2007-07-11T11:12:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, 630706a2-95df-4b7e-8fe5-e5dce19f93ab, 'Recette testée, c''est très bon!!! Je conseille à tous.', '2006-12-03T15:40:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, b329025a-ed84-4d7e-a9b0-4ed9ef5a108d, 'Très bon, j''ai suivi le conseil de remplacer le miel par du sucre, et très bon, tout le monde en a repris. Il faut peut-être diminuer la quantité de chocolat, mais sur le goût rien à redire.', '2006-05-29T12:09:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, 1234e8e2-7d50-4ae8-a56d-6195c64d5ec0, 'Tout simplement délicieux!!', '2006-03-08T15:52:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, dfa1047f-70b5-479e-88e6-c7d3d0f7ea71, 'Très bon! Ma maman qui n''aime pas beaucoup les desserts en a même repris!!! Sinon, la prochaine fois je tenterai sans miel, ce n''est pas trop mon truc... Je remplacerai tout simplement par du sucre. Et je suis d''accord avec ce qui a déjà été dit précédemment: on peut réduire un peu les proportions de garniture du côté de la sauce chocolat. J''ai également beaucoup aprécié l''effet chaud/froid de cette recette entre les nems et la sauce vanille/canelle. Je la garde dans mon carnet, celle-là!', '2005-10-26T04:01:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, 751331a8-747c-4b1f-abda-c97b27fce423, 'Très bon voire excellent, si on met 2 nems par assiette, ce n''est pas trop lourd. Il manque peut-être un peu de crème et 1/3 de la garniture chocolat suffit amplement. C''est un peu long à préparer mais c''est un dessert qui fait beaucoup d''effet.', '2005-10-25T16:16:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, 2bfad771-6380-4ea7-821c-8ebc0e3e9ab9, 'C''est vraiment excellent et en plus très beau lorsque l''on dresse les assiette, dommage que cette recette soit si longue à préparer...', '2005-04-14T13:53:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, 3afdd576-7247-4aa2-b895-07b80a923fbc, 'Moi j''ai trouvé ça délicieux ! J''ai même essayé avec des ananas à la place des bananes et c''était tout aussi délicieux !', '2005-04-09T16:47:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, d10f0fb6-313c-4ea0-838a-5cfc366345e8, 'Goût particulièrement désagréable (certainement dû au mélange miel/banane). Dommage...', '2005-02-10T22:58:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, cca5b51b-08af-420a-a3e6-511dd7b32ed1, 'Un régal... Je désespérais d''arriver au bout de la préparation mais ça vaut vraiment le coup, et je referai la recette... Bravo en tout cas pour l''idée qui peut être adaptée en de multiples variantes avec d''autres fruits par exemple... des clémentines ?!', '2004-12-26T02:30:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, 6781e41d-3663-4825-8fab-2a46d311fd27, 'Délicieux et vraiment très original. En terme de proportions, je pense que 2/3 de la garniture au chocolat suffisent.', '2004-12-23T15:17:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, 2da98db4-d93f-4c97-a9e4-157e832641e6, 'Je confirme le commentaire précédent. Long, mais tellement bon !!! A refaire sans modération. Bravo !!!', '2004-12-07T17:05:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14035, 4a3df78d-5ce6-42e3-9ca1-dd356215a617, 'Excellent, même si c''est long à préparer.', '2001-09-10T00:43:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391531, 2b26c49b-f346-47e0-b491-91c30beca988, 'Vraiment très bon. À refaire.', '2020-01-17T09:36:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347075, 5f20bf0d-689d-47ad-948a-7a025a8bde02, 'Très bon et facile toi le monde s''est régalé !', '2020-10-01T16:42:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347075, 54eb7f75-7ddd-4a9e-8c27-6ca6ea7accf9, 'Ma famille a adoré très rapide et facile à faire.', '2020-09-03T13:36:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26033, 0852b7ee-bf31-4e84-92ea-3192df57194d, 'Dommage, le melange porc / échalotes / lardons est bon, cependant les bananes vertes ne sont pas très bonnes à mon goût. C''est très bourratif et peu goûteux ! Je réessaierai avec d''autres légumes.', '2018-05-16T09:31:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65562, eae558e0-a7f4-49f1-8e1f-ac015f772e38, 'Cette recette est excellente, j''en ferais tout le temps si je pouvais, mais j''essaie de garder la ligne  ', '2017-02-27T19:58:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65562, 53e3d116-415d-4efb-989e-77fc0c79a435, 'Excellent, succulent. On le refera. ', '2017-02-25T17:46:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65562, 60eeeee9-a395-4ec7-910a-6cb630314049, 'La pâte sablée à base de poudre de noisettes (faite maison) était excellente très goûtée. La pâte à crumble idem. Certes, ce dessert ne se distingue pas par sa légèreté mais le contraste fondant de la banane et du nutella avec le croquant du crumble est super. A manger avec modération.', '2017-01-29T20:26:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65562, 143c284f-e9b3-4c69-ad39-c4adb51a34fb, 'La pâte à crumble est vraiment excellente. Après c''est une question de goût concernant le mélange nutella/banane. C''est un peu lourd après un repas, je la conseille au goûter!!', '2008-07-03T12:47:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 4165c9c0-fa9c-4abb-a1e3-63488c637020, 'Un vrai régal... Merci pour la recette', '2020-03-27T13:29:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 7400b4ab-3d70-4dea-b4a3-025791135833, 'Super recette ! Toute la famille a adoré et je le refais souvent même en dessert pour mes invités qui en redemande ! Merci !', '2012-02-17T20:17:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 057e3ad5-166f-4c22-b75b-30d5698c04fc, 'Super bon crumble, j''ai enlevé 80g de sucre et rajouté un peu de farine car le crumble n''était pas assez grumeleux :) Mais trop bon!

', '2021-12-01T17:49:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, ee172df7-4bb4-496b-9416-99eef090f20e, 'Trop bon!', '2021-05-02T12:33:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, c35fb017-4134-4807-bcf2-e20d8b78188e, 'Crumble excellent, recette très facile à faire. ', '2021-03-14T17:34:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 9bff645b-5284-4e97-a7d8-e31b426d2ad8, 'Mon gâteau préféré. Super simple à réaliser, il fait toujours l''unanimité !
Pour une version plus ''légère'' du quotidien, je mets un peu moins de chocolat, de beurre et de sucre et plus de farine.', '2018-05-25T12:46:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 865a6f5e-64ca-4917-8e3f-99cce0bdc1a8, 'Très bonne recette ! Je n''ai mis qu''une banane pour 4 pommes sinon le goût banane est trop prononcé. Un regal, super facile à realiser et tout le monde aime ! Merci', '2016-11-25T16:15:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, ee0b118c-1ee0-4245-beac-ffe8a53f2d44, 'J''ai suivi la recette à la lettre, ce que je n''aurais pas dû. Trop de morceaux de sucre ou de farine. Attention à bien lire les commentaires afin de ne pas se louper avec les quantités ! ', '2016-01-11T18:11:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 0cc3cd7d-93a1-48b0-9a5f-b930daf17439, 'C''est excellent mais il faut mettre moins de sucre et moins de chocolat ! ', '2015-11-04T21:31:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 76a53c61-1bb3-4e84-9973-bc8941902501, 'Un régal ! ', '2014-12-31T13:37:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, be6efb87-f5c6-4098-8983-4b554a3d17f5, 'Recette bonne mais vraiment trop sucrée. ', '2014-11-06T00:58:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, f8363e8d-d21b-41f2-9fdd-76046ae14963, 'Super bon, mais moins de beurre, moins de sucre, moins de chocolat (mis 3 barres).', '2014-09-09T04:59:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, fa3249ae-ff1e-41d5-b98e-28335ff01878, 'La recette est excellente, mais j''ai improvisé le crumble : farine, poudre d''amende, galets bretons, et là, c''est.... A TOMBER !', '2014-08-02T23:03:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, a4181342-8b89-46a8-ba86-be1a42a13108, 'Tres bonne recette ! C''est mon premier crumble et bien je le referais sans hésitation :)', '2014-05-12T16:36:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, bb8fe39e-1aa2-4a46-8149-17137501dc16, 'Mettre 100 g de farine et ajouter de la poudre d''amande. Mettre la pâte pendant 1 heure au frigo.', '2014-04-23T14:12:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 112a3d6a-112e-4b38-b6ee-9dfce0d51119, 'Délicieux et facile à réaliser. Parfait pour tous les gourmands !', '2014-04-11T22:49:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, bc3013a6-e664-4259-80b6-c4552b46d55e, 'Un DÉLICE !! J''ai suivi la recette à la lettre ! Succulent ! Tous les convives ont adoré. Je fais régulièrement cette recette et c''est un régal à chaque fois !', '2014-03-27T16:17:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, cd2444bf-f539-42ae-bf13-eb5836f5d6b8, 'Bonne recette. Je n''ai mis que 70g de chocolat et 70g de sucre mais ça restait encore un peu trop sucré. Attention de ne pas prendre des bananes trop mûres car je pense que le côté trop sucré vient aussi de là. A présenter dans des petites cocottes individuelles avec une boule de glace vanille c''est le top !   ', '2014-03-26T18:16:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 15d35670-bad5-498f-9e5a-dabad86e77cc, 'Bonne recette pour accommoder rapidement le fond de son panier à fruits mais attention à la quantité de chocolat qui peut facilement être réduite de 30 à 50%.', '2013-08-03T16:24:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, dedf57e4-9d16-44bb-9a6a-f2c8228851e7, 'Hummmmm un délice j''avais que 2 bananes donc j''ai fait avec, mais la recette extra bonne ', '2013-07-03T21:39:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 8c63f762-9693-4817-a32c-b59d14c55395, 'Hummmmm un délice j''avais que 2 bananes donc j''ai fait avec, mais la recette extra bonne ', '2013-07-03T21:39:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 0415120d-d1e7-408c-936a-35da48e8d8cc, 'Miam ! C''est délicieux! Je l''ai préparé avec ma fille de 7 ans et elle a adoré aussi ! A refaire très vite !!! ', '2013-05-26T13:12:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, cd888f56-f410-418b-8ba5-162b54729c99, 'Bonne recette, simple et efficace. Pour la touche exotique, j''ai remplacé 1/3 de la farine par de la noix de coco râpée. Ca donne une pâte à crumble plus légère.', '2013-02-10T16:17:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 02254551-a0d2-4eb8-a6f9-961b4c212c9e, 'Dessert facile, rapide et excellent J''ai réduit la quantité de chocolat que j''ai râpé suite aux différents commentaires et c''était nickel !', '2012-11-23T13:37:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, eb811793-6c28-4824-92f8-d12d8a7b695f, 'J''ai testé pour la toute première fois un crumble. C''était délicieux. Seul bémol, je pense que mes fruits étaient trop gros du coup je n''avais pas mis assez de chocolat à mon goût. J''adapterai mieux mes proportions la prochaine fois et je le ferai dans des verrines en terre cuite. Je recommande cette recette ultra simple rapide et délicieuse !', '2012-07-15T02:22:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, bbd4b48f-c081-4539-8633-6d1df263ba78, 'C''était très bon ! J''ai trouvé qu''il y avait un peu trop de chocolat mais mon copain non, à adapter selon  les goûts !', '2012-06-14T16:01:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 9f5d76c6-b8f0-4264-a0fb-97c31aab3b94, 'Très bonne recette, mais la prochaine fois je mettrai un peu moins de chocolat car je trouve que le goût dominait un peu trop (avis perso). En tous cas, tout le monde s''est régalé !', '2012-05-27T10:37:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, b0ae0193-b513-44f6-bda2-637ece67ae4d, 'Très bon', '2012-05-08T10:31:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 5542d5e4-5b53-47a7-8f25-ef6ac63c5042, 'Un régal ce crumble. Je suis fan ! Et je ne suis pas la seule à la maison !', '2012-04-03T01:00:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, efb6dbae-6f55-4038-8058-84868f1dd800, 'J''ai d''abord cuit les morceaux de pomme à la poêle avec un peu de beurre, un sachet de sucre vanillé et une pincée de cannelle. En fin de cuisson j''ai ajouté les bananes en rondelles trempées dans le jus de citron. Pour le reste j''ai suivi la recette. Tout le monde s''est régalé !', '2012-03-17T16:52:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 20854816-f916-40d0-b313-52f3fbbb9809, 'Un délice ! Aussi bon chaud que froid, merci pour cette recette !', '2012-03-17T16:49:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 2a9092d2-040f-4a21-9ae0-13531e4903fd, 'Délicieux ! Tout le monde en a repris.  ', '2012-03-10T16:53:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 3e38d8da-8515-477f-9d04-dd9fc9b8d134, 'Mettre plus de farine ce n''est pas assez granuleux', '2012-03-03T02:14:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, bc73c470-ac45-4f4e-a072-24d1fb160c04, 'Premier crumble et c''est une réussite ! Encore meilleur froid.', '2012-03-02T09:59:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 8ddb82da-3954-48e1-af2e-62fdcd72bdf0, 'C''est un excellent crumble ! A refaire, j''ai modifié les doses à la place de mettre 100 g de chocolat j''en ai mis 200 et à la place de mettre 90 g de farine de sucre et de beurre j''ai mis 80 g. MERCI !', '2012-03-01T16:37:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, bd39e62f-9c7b-4e6b-9225-b1e54ac03612, 'Super recette, facile et rapide ! Elle fait partie maintenant de mon carnet ! Merci !', '2012-03-01T12:00:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, b45c1792-bd27-4299-92fb-6432b3b6f1f9, 'Super bonne cette recette, j''ai ajouté de la noix de coco râpée, comme conseillé dans las commentaires précédents et c''est un régal !!!', '2011-12-01T20:40:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 8539722d-4741-416d-8f70-2bca6caaf4df, 'Mon premier crumble: un régal, merci beaucoup !', '2011-04-26T01:05:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, baba1dfe-64b2-4d4d-8aca-3cb9a4075d10, 'Pour ma part, c''était très bon. On l''a mangé froid faute de four. C''était vraiment dommage car les pommes, la banane et le chocolat chaud c''est vraiment très bon!', '2011-03-07T14:39:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 7afac4fc-c612-4009-8802-c6d83fa254ae, 'Merci pour la recette très bien ! Comme suggéré par myriamrennes, j''ai ajouté de la noix de coco dans le « sable » et c''était très bon, très discret. Un détail : les fruits ont beaucoup rendu (ou le gras du chocolat ?), j''ai dû égoutter chaque part que j''ai servi. Rien de grave, ça ne change rien au plaisir de la dégustation.', '2010-12-15T14:21:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, d059de43-9f65-4bb1-9579-3e7075e8fdce, 'Je n''ai mis que 60 g de beurre (mon toubib m''en sera gré) et ajouté de la noix de coco râpée au crumble. Suite à un premier essai que nous trouvions un peu trop écœurant (et pourtant ma chérie est une inconditionnelle de cette douceur), j''ai également divisé par 2 la dose de chocolat que j''ai râpé sur les fruits à l''aide d''un couteau économe. Avec ces quelques aménagements c''est devenu l''un de nos desserts préféré. Merci.   ', '2010-11-29T19:56:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, def0bf32-d031-4d14-8cd4-b6f175720e4f, 'Très bon. Il me restait 2 pommes et 1 banane 1/2. J''ai mis 100g de chocolat (mixé comme dans la recette) et pour le crumble j''ai pris 1OOg de farine, 50g de beurre, 80g de sucre. J''ai fait 6 coupelles et on s''est régalé. j''en referai...', '2010-10-21T22:41:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, c33fb49a-92c3-4419-9ec2-839942cdab1a, 'Très bon crumble même si je ne suis pas fan de l''alliance fruits/chocolat en général. Les dosages sont parfaits ! J''ai choisi de mettre les 3 chocolats (noir/blanc/lait)que j''ai râpés (économe). ', '2010-10-05T20:22:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 46631929-aa49-4a87-abb9-55102d349b94, 'Très bonne recette réalisée à la lettre avec du chocolat patissier coupé à l''aide d''un économe. Il n''est rien resté!', '2010-09-22T00:43:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 1dbd476b-a395-4b3f-9c5b-3259888209e6, 'Je fais ce crumble depuis quelque temps et, honte sur moi, j''avais omis de le noter. C''est vraiment très bon, mais pour encore plus de gourmandise, j''ajoute de la noix de coco râpée dans le "sable". Merci pour la recette.', '2010-05-07T00:10:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92642, 6da78df7-3f4f-4887-a9b1-d1ccaf919264, 'Merci, j''ai remporté un très grand succès avec ce crumble, mais malheureusement, je n''ai pas pu le goûter...', '2010-02-02T12:05:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166731, ecd2ef14-9585-43f9-b9c6-56f007b69a0e, 'Très bon, je vous l''assure. Merci pour la recette.', '2019-10-23T08:41:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166731, 847150f7-5b2e-4586-9a2e-573ec28d9847, 'J''ai suivi la recette et mon plat était tout simplement un régal. Merci beaucoup mon mari a adoré ?', '2019-09-22T14:45:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315623, 9295f75e-5c62-4163-b75b-13201bda8918, 'Le goût du caramel est un peu bizarre dans le gâteau ! ', '2014-04-16T17:45:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315623, 172a2c44-a0e7-468a-a9f1-b4c0135c7e70, 'J''ai fait un caramel maison. C''est bon mais sans plus. Bonne recette pour se débarrasser des bananes un peu trop mûres.', '2014-04-15T15:29:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37089, 36757eda-076b-4e00-98a3-c84e8c0b7852, 'Je l''ai fait avec du jambon de poulet rôti, c''est fou comme ça se marie bien avec la banane ! À décliner en apéro avec des tronçons de 2 cm enroulés de lanières de jambon !', '2012-07-15T20:51:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, de0191dc-1f98-4b6b-822d-e0f20392e510, 'Très bon avec 20 g de sucre en plus. ', '2013-11-12T08:05:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, f7829b5e-238c-4b7a-a5a4-90612420cd39, 'Ce n''est pas du tout un clafoutis, mais plutôt un muffin. Bourratif.', '2013-01-18T21:21:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, 791ad487-56d4-4e82-a217-dfbd905df19d, 'Pas spécialement la texture d''un clafouti, mais efficace tout de même. Un peu trop gras et trop sucré, j''essaierai avec moins de sucre surtout la prochaine fois. Demande aussi un peu plus de cuisson. J''ai recuit 2 min au micro onde pour finaliser.', '2013-01-13T21:16:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, c9f78870-4a93-4ad0-9363-3830a4840067, 'Bon dessert mais qui, d''un point de vue consistance, ressemble plus à un muffin ou un cake qu''un clafoutis. Doit être très bon également avec d''autres fruits (à la place de la banane).', '2012-04-30T18:39:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, b02135d8-b3a1-4a8a-bb40-8f13fa762e21, 'Peut se faire également avec de la farine de sarrasin pour les intolérants au gluten.', '2012-03-19T18:29:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, 43ff2050-f50f-4507-883b-8d1239c35159, 'Trop bon, on l''a mangé ce soir en dessert. Ma fille qui n''est pas fan de noix de coco a adoré.... Par contre, pas de goût de bananes, donc j''ai mis des tranches de bananes à côté dans l''assiette et de la chantilly sur le gâteau (car pas l''aspect d''un flan)... c''était un régal, à refaire avec plus de bananes... Merci pour la recette', '2012-03-11T22:32:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, 8686093e-c19b-42c2-b905-95d7e5ece028, 'Excellente recette, un régal ce clafoutis banane coco', '2011-01-17T22:56:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, 82b89d72-1d9b-4268-b9ce-876d61fce561, 'Vraiment délicieux et original! Par contre, la prochaine fois, je mettrai plus de bananes (4) car on ne les sent pas beaucoup..', '2010-10-22T19:47:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, 822c53db-5767-43f5-87a0-df07824615e6, 'Avec une boule de glace vanille, c''est excellent ! Le gâteau a été dévoré. A refaire sans hésitation.', '2010-04-14T22:32:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, 619c8467-c9db-42b1-8c8a-a1253431be2a, 'Bonne recette. Merci', '2010-03-28T13:50:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, 1eaee4c6-ac67-4e5b-9185-f70bdc65391f, 'c''est vrai il ne ressemble pas à un clafoutis mais à un gâteau. Mais vraiment excellent même lorsque l''on n''aime pas top la noix de coco ', '2010-03-20T21:11:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, 0914b21f-356c-4ee7-a5e6-45ca596c76c9, 'C''était super bon... Mais c''est vrai que ça ressemble plus à un gâteau !!! J''ai rajouté des pépites de chocolat sur le dessus pour la couleur...et le gout forcement !!', '2009-07-18T15:30:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, adff5ccf-2e9a-4693-ad76-d6bd81cbc31a, 'cela prend vraiment 15 min maxi et c''est un vrai régal ! avec un café ... mum ! vivement conseillé', '2009-06-22T18:45:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, 5accf474-7520-4428-8cdc-7ab7b8ff7c24, 'Je l''ai fait en y mettant un peu moins de sucre et en mélangeant tous les ingrédients en même temps. Comme dit Sandrine, la texture est plutôt celle d''un gâteau au yaourt, mais vraiment délicieux ! Mes félicitations !', '2009-05-27T13:14:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, 6e28314a-13b1-497d-a0a8-446e0adfd1ec, 'Un régal !!! A refaire. Par contre la texture est plus proche d''un gâteau que d''un clafoutis, mais ça ne gâche pas du tout le plaisir !!!', '2009-04-07T21:10:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, 66ad484b-f62a-4509-a191-c7624ec04670, 'Je mets 3/5, car en respectant la recette et les commentaires, mon résultat fut un gâteau façon gâteau aux yaourts à la banane et à la noix de coco plus qu''un clafoutis. Mon gâteau n''avait rien de cette appellation qui veut dire pour moi fond dur et flan dessus. Je pense que l''appellation n''est pas adapté, après le gâteau est très bon mais on est forcement déçu quand cela ne ressemble pas à ce que l''on attendait. Merci et à bientôt sur une autre recette!!!', '2008-03-29T12:01:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, e8d05b60-4f60-42ab-9e10-429626cf9fcc, 'Très bon goût de banane et noix de coco.', '2008-01-12T11:07:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, 5fd7a223-ec96-4f73-875b-61d94c26826e, 'Excellente recette! J´ai remplacé le sucre par de la stevia et cela en fait un dessert très peu calorique :)', '2007-07-30T22:09:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, ca501245-2b9c-4988-847d-cc1bdfeaf44b, 'Excellente recette, qui a fait l''unanimité de mes collègues! Je l''ai d''ailleurs diffusée! Merci!', '2007-03-15T14:05:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, e4865403-4701-4710-a00b-2502ff1471b0, 'En deux mots : divinement succulent! Très léger et délicieux à la fois, je l''ai fait en version light avec du beurre allégé et du sucre édulcoré de cuisson et le résultat fut très réussi ! Merci pour cette recette. ', '2007-02-15T09:31:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, a6b5a6f3-d67e-4a28-8ca9-a3ff252d5e0d, 'D''enfer, super bon, j''en ai même fait d''avance et mis au congélateur, où va la gourmandise (hein).  ', '2005-08-24T14:17:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36253, a48f7ada-505c-4759-b51c-3fc1ea8c8228, 'Bonne recette pour un petit dessert sympa. Les quantités sont un peu trop grosses : pour 2 j''avais divisé par 2, mais c''était trop ; j''aurais pu faire 4 parts.', '2005-05-15T18:18:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29122, 16440bb8-57d8-4b77-8a0d-8ff504270ec3, 'Très bonne recette ! Accompagnée d''une boule de glace vanille et un petit spéculoos, rien à dire ! J''ai mis une seule petite cuillère de cannelle et c''est largement suffisant à mon avis. Appréciée de tous, à refaire !', '2011-10-02T09:28:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29122, 5c213f3a-6120-4bef-b054-72d9c0dfb0c7, 'Très bonne recette ! Facile à réaliser et appréciée par tous. La mangue n''était pas mûre et je l''ai remplacé par des kiwis. Parfait aussi ! Et je confirme les quantités indiquées sont pour 4 et non pour 2... Merci en tous cas pour cette recette.', '2011-05-16T23:08:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29122, ac447575-ebd9-4083-8906-dbc93804fa1f, 'Frais et léger! Ce dessert a été très apprécié par mes invités après un plat un peu lourd. Je l''ai servi avec une glace à la vanille maison et un biscuit à la noix de coco.', '2011-04-04T10:24:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29122, 6e57257b-98a6-44cf-99bf-7795a32fc3bd, 'Je sers cette papillote de fruits accompagnée d''un coulis de fruits rouge (ou seulement de fraises) et de crème anglaise dans des petits verres. Succès assuré. ', '2011-03-01T20:17:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29122, 0f163c6b-84d7-4365-8ada-3b27107bf60d, 'Simple et délicieux. Quantités pour bien 3/4 personnes : je n''ai mis qu''une banane et remplacé les oranges par des kiwis, pour mettre un peu de couleur ; idéal avec une boule de glace vanille pour l''effet chaud/froid, et des sablés à la noix de coco pour faire écho aux saveurs tropicales.', '2009-12-26T19:17:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29122, b4b75afa-c3bc-4cee-b1b8-7ba64ef1c412, 'Excellent, les épices se marient à merveille avec les fruits. Les quantités sont assez importantes mais c''est aussi très bon froid le lendemain...', '2006-08-18T14:25:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29122, df653a5b-724a-40be-bbed-02f7f8216a37, 'Recette très originale et très bonne. C''est une sorte de salade de fruits, mais chaude. Par contre, le goût de la cannelle prend le dessus par rapport à la vanille. Il faudrait en mettre un peu moins. Idéale après un repas très lourd.', '2006-08-13T21:17:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29122, 5c23fac6-7cd5-4d80-9e62-b12f852fc303, 'Ma famille a adoré, mais moi je n''ai vraiment pas aimé...et le pire c''est que je sais même pas pourquoi, parce que tous les ingrédients me plaisent, normalement...Mais y avait un truc qui clochait...peut être que je trouverais la prochaine fois que je le fais.', '2006-06-05T16:28:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29122, ed7d57c9-c2c8-4aad-879a-642e94827217, 'Top avec des biscuits glacés, surtout après un repas lourd! Je mettrais par contre moins d''orange dans la papillote, et du sucre pour éviter le goût un peu acide.', '2006-05-30T18:15:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29122, 75f58fdd-4d4a-43c4-84a3-a0c21a00a79d, 'C''est une recette excellente pour manger des fruits, la mangue a un goût... sublime ! Je n''ai pas eu le courage de les mettre en brochette, la prochaine fois !', '2006-05-22T20:35:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29122, a9cda9c5-d30d-42a0-8afd-b9de54b8da19, 'Délicieux, avec une boule de glace vanille, j''ai fait effet! A refaire! Toutefois, cette recette n''est pas pour 2 personnes, mais largement pour 4, avec de très belles portions! ', '2006-04-05T11:56:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29122, 1422aea8-1836-4422-9357-05063e3de681, 'Divinement bon! Mes invités ont a-do-ré. J''ai simplifié la fin de la recette en ne mettant pas les fruits en papillote mais simplement au four dans un plat à gratin à 140°C.  Bien mettre les deux gousses de vanille pour parfumer les fruits. Servi avec des petits financiers au thé matcha, c''est un régal!', '2006-04-03T01:06:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29122, 3cea807a-9add-4d04-af5b-4962df837d40, 'Mmm... un véritable délice!!! Très bonne idée après un repas entre amis par exemple où souvent les convives n''ont plus faim pour un dessert plus lourd (gâteau ...) c''est délicieux, facile à faire, on en mangerait tout le temps !!! Merci pour cette recette !', '2006-03-31T20:45:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29122, 285ce85c-82a3-4e78-9ca6-53ce63cc9ce2, 'Délicieux et léger après un repas un peu copieux, j''ai toutefois ajouté une pincée de muscade et un peu de poivre et n''ai mis qu''une cuiller à café de cannelle. A refaire.', '2006-03-04T12:22:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21362, ecd4e662-330f-437b-8c2a-f399cc22db8a, 'Miam', '2021-10-10T13:52:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21362, 19af9aed-78c3-426e-8acd-0e6ad291ac23, 'Flambé au rhum. Je n''ai pas aimé, les bananes deviennent de la purée...', '2020-04-26T14:42:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21362, e7bd4181-d806-4fce-9ade-cb1dc85618c4, 'Simple et toujours bon. Meilleur encore avec des bananes bien mûres ', '2019-05-16T13:56:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21362, c49c366b-35d3-446a-905c-c5fb89307f71, 'Très bien quand on n''a pas le temps. Tout le monde a aimé !', '2018-03-17T12:13:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21362, 7acbf40a-9d7b-461b-a7af-a70c31fe9f84, 'Simple et efficace... parfait avec une boule vanille en plus et une petite sauce chocolat ', '2017-05-23T00:53:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21362, b327bbf8-4467-49ca-ad63-a36f4279bce9, 'C''est excellent aussi pour garnir une crêpe.', '2017-03-21T21:29:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21362, 85abea7d-7178-4d2c-b8c6-6a3f16feffea, 'Excellent même si c''est un peu sucré, j''ai mis 1/2 sachet de sucre vanillé et quelques copeaux de beurre... Un délice, simple à réaliser !', '2011-05-26T21:48:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21362, 9b10002a-f622-491e-bfd7-38d90e1fd044, 'Vous pouvez y ajouter un sachet de sucre vanillé ou servir avec une boule de glace vanille... Ca aussi, c''est délicieux! ;o)', '2003-03-10T14:30:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21362, 07c50df3-a68c-499f-baad-2247f7a573b4, 'Exellent et très facile à faire. Toute la famille a adoré.', '2003-03-08T12:48:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, f3fbf6ce-a4c1-4478-a043-6f924f9aacbc, 'Super recette à refaire, les enfants ont adoré.', '2022-01-15T19:52:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, f0a8f5e9-f22d-4be0-9f1c-1c27cb1eb004, 'Que dire a part excellent !  !', '2018-08-27T17:46:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, a15cc4a8-e333-4b60-b355-b1b88d1516bb, 'Excellent !  !  ! Je n''ai eu que des compliments et tout le monde a trouvé l''idée de la banane audacieuse et très bonne ! Merci pour cette idée de recette !', '2018-08-12T16:32:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 3c5af814-2c2d-469d-bda6-68dbc7e59fbb, 'Le porc etait excellent ( tendre ) mais l''association avec la banane n''a plu à aucun de nos invités et à nous non plus.', '2017-06-20T15:47:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 0d7044d8-42e9-4ae7-9c0f-27fe81fbd3c5, 'Vraiment délicieux ! Je la fais souvent et c''est un succès à chaque fois. Tout le monde me demande la recette. Par contre je ne met pas de poivron, ça gâche le fondant du reste.', '2014-09-21T20:22:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 75d6760d-a1b3-48ad-89e7-98f9ce463b12, 'Brochettes appréciées des amis. Ils en redemandent pour la prochaine soirée.', '2014-09-11T20:30:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 6f6018c0-1210-4fb7-b7ad-7f12c5b93f21, 'Très bon, excellent même. Le mariage du filet mignon et de la banane c''est top !', '2014-09-06T00:38:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, e9a7b0bd-fd6a-4a3b-9f33-74ddbc32e697, 'Brochettes originales et appréciées de tous mes amis. Viande très gouteuse et moelleuse, car je l''avais fait marinée la veille. Cuites à la plancha, ces brochettes furent un délice. Je referai cette marinade avec d''autres viandes. Merci pour cette merveilleuse idée à la quelle je n''aurais pas pensé !!! Mariage sucré/salé réussi !!!', '2014-06-09T19:35:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 0601450d-c528-471d-8ecb-81d9cd94b3c7, 'Waw, excellentes ! Et tout le monde a adoré les bananes :-) Merci !', '2013-08-22T13:59:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, eb8f45b3-9f67-46fd-b582-a1ccac99d26a, 'Idéal aussi au barbecue !', '2013-05-27T10:59:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 351970d6-f9ff-45ad-ab27-e0b3525058ad, 'Très bon et doux, ajouter du piment.', '2011-09-17T19:10:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 4785512c-f7f4-4ca4-814d-f6db64ee9042, 'Très bon, un vrai régal pour un barbecue entre amis.', '2011-06-20T11:58:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 6f05353d-777f-49fa-a5a4-704d0834764f, 'Bravo pour cette recette !!', '2010-11-17T17:22:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, fcc1ae05-b254-46a9-99f2-e8efc3dddc21, 'Juste excellent... Cela change des brochettes traditionelles !', '2009-09-20T12:18:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 2e59a169-3448-4d99-b213-00b699442b4f, 'Délicieux', '2009-07-26T10:25:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 051ac4a9-7028-41a2-9d4a-c5b819d2c64f, 'Long à préparer mais délicieux ! Bravo pour cette recette bien équilibrée en saveurs.', '2009-06-07T14:26:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, c72e0059-0186-4d4a-ab29-90da6a28db9b, 'Un moment de bonheur : une délicieuse touche sucrée salée qui se marie à merveille avec l''acidité de la marinade. Et en plus très simple à préparer!', '2009-01-25T14:51:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 04de53c2-0495-4617-a7fb-a0765dd85867, 'Original! J''ai fait cuire une partie au four et l''autre au barbecue; petits et grands ont beaucoup apprécié. Je l''ai accompagné de quinoa et tomates provençales. Merci.', '2008-08-10T21:51:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 1c48e5b3-6831-4ef0-af9a-93fe66cac5ad, 'L''idée de la banane est excellente! Tous les invités ont été surpris et emballés ! La banane s''est très bien tenue à la cuisson au barbecue.', '2008-05-26T12:38:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, e5bca1c2-10c0-4cfb-83a2-fa7ce0dd98e1, 'Tout le monde a été épaté par cette recette sucré-salé et la présence de la banane. C''était vraiment excellent! J''ai aussi essayé la recette avec du magret de canard à la place du filet mignon, c''était aussi bon.', '2008-05-13T15:50:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 939a7f67-d5dc-45f2-beaa-1af6d82e61a2, 'Un mélange sucré-salé divin... Je ne savais pas quelle taille donner aux cubes de viande. J''ai fait environ 15 morceaux dans 1 filet mignon, c''était parfait ! La prochaine fois, je ferai 5 ou 6 tronçons dans la banane (au lieu de 4).', '2007-11-01T15:07:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 4e8fe702-7ac6-4a3f-993d-e87f2f614ad0, 'Délicieux !!! Original et facile à faire, mais bien choisir sa viande tendre et non grasse ! mes invités ont adoré malgré l''étrange présence de la banane qui m''avait surprise.', '2007-09-26T17:29:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 8aa17029-1799-4547-8ac3-344d13ce9d3a, 'D''abord, pour les nuls comme moi, il faut couper le filet mignon AVANT de le faire mariner. (...ben c''était pas marqué, alors je me suis rendu compte de ma bêtise après!) Sinon, c''est bon, facile et original. Je réessayerais avec du fromage en plus la prochaine fois. ', '2006-05-07T15:08:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 2e4406b9-c2c0-494d-9956-db1231f26e0d, 'Je l''ai fait au four, j''aurais dù le faire au barbecue. J''avais mis 2 sortes de poivrons mais j''ai trouvé la déco encore fade (aux yeux). Le filet mignon est excellent!!', '2005-11-30T18:58:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 38f5c970-d61d-4482-bd52-ebfd171b43d4, 'Délicieux mélange de sucré-salé, on s''est régalé!  Merci ;o)', '2005-06-30T11:09:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 6bedbf55-3a82-4389-9936-9eced9e14fd2, 'Très bon!!! Merci pour cette sympathique recette!!!', '2005-04-11T14:07:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12684, 235a4829-53ea-4dc4-b301-73f43490251c, 'Facile à faire, et délicieux (je l''ai préparé au barbecue)! En plus, ce plat présente très bien.', '2005-03-30T21:13:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18498, 56d2bd42-ed7d-4f0f-a082-651086d8372b, 'Délicieux. J''ai déjà cuisiné cette recette plusieurs fois, je ne m''en lasse pas.  Plat mijoté facile à réaliser (une fois trouvées les bananes plantain). Je dois ajouter un peu de liquide, comme conseillé; la dernière fois j''ai mis le jus d''une orange, c''était délicieux.', '2011-02-10T15:45:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18498, 78703fd9-e712-4743-a1c6-3942289f3e9a, 'Très agréable, surtout avec des œufs brouillés. Cette recette doit pouvoir accompagner formidablement du poisson cuit à la vapeur... mais cet essai sera pour une prochaine fois...', '2006-05-08T00:57:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18498, 304e5a90-f86e-4691-b218-bb5e82a4005a, 'J''ai bien aimé, servi avec des oeufs brouillés. J''ai mis des aubergines parce que je n''avais pas de courgettes sous la main. Seul souci, patates et plantains ont commencé à attacher, il faut mettre du liquide dès le départ et ne pas les cuire à sec.', '2004-04-19T00:03:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18498, 0dfca758-df49-482a-87e7-31c787de2f6e, 'Déçue, je m''attendais à un plat plus relevé.', '2003-05-02T18:51:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, 33936a25-42e0-4c04-a5bf-50a0bcf2a0b4, 'Excellent ! J''ai remplacé le kiwi par des fraise et ajouté des Lichis... Juste succulent et sans sucre ajouté ! Un vrai délice.', '2021-01-16T16:17:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, e4786d36-d530-4b67-b52c-790fd21c9a16, 'Après une soirée raclette, tout le monde a adoré cette salade de fruits. Les proportions sont bonnes et la petite touche de cannelle est le petit plus qui fait toute la différence. ', '2015-11-14T11:16:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, 2571dbda-2797-4ffa-bb18-f8d536516f92, 'Rien à redire c''est très bon, un autre fruit de serait pas de refus du style une poire mélangé avec un chouia d''alcool de fruits!', '2012-02-10T10:43:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, cf78e204-1631-4557-8c99-7b12a841ec97, 'Très bon ! J''ajoute un peu de rhum dans ma salade de fruit, servir bien frais ! ', '2014-12-25T00:54:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, da0577a7-9043-4956-948e-d716c3a3d231, 'Super bonne ! J''ai suivi les conseils, pas de pommes. Pour 6 personnes, j''ai mis 2 poires, 4 petits kiwis, 3 mandarines, 1 mangue, 1 banane et 2 oranges pour le jus, un petit peu de jus de citron et la cannelle comme prévu, vraiment très bon !', '2013-12-08T02:42:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, 420ee595-007d-4e7e-b1fd-ac53e743b0c5, 'Très bonne salade. Personnellement j''ai fais le sirop pour la salade moi même avec les pelures de la Mangue.😋', '2023-02-19T13:00:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, 58568118-755e-4320-8016-aea005355f17, 'Trop bon je recommande ', '2023-02-16T12:00:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, a80e51a1-bd2f-414d-a059-0759d0195cee, 'Recette suivie à la lettre et c''est un vrai délice. Merci !', '2023-02-14T17:47:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, e57786c5-2b28-4c6f-a405-481da1937265, 'Délicieux', '2020-04-21T23:50:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, b4de8b2a-e86c-4b53-92cb-5870139f2dae, 'Super ', '2020-01-02T03:44:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, 767ebf0e-8a32-462a-9a61-d4703959805e, 'Très digeste après un repas copieux ', '2015-12-31T14:18:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, 2aba71ea-f824-4c99-a682-1b7607490c0f, 'Bien, quelques gouttes de kirsch c''est un plus ! Et un peu de sucre en poudre roux. ', '2014-12-07T14:50:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, 0a8d6fd8-4a55-47c9-8df4-6a256041d1d9, 'Faite avec de l''ananas à la place de la mangue, sucrée juste comme il faut avec seulement les fruits, très bien pour une fin de repas légère.  ', '2014-11-05T00:29:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, c0d1957d-6b4a-4c4b-a35e-22c8b6546a3d, 'Trop bon !', '2014-08-30T13:01:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, 134512b9-6839-4849-8b8c-cab09ca34c78, 'Ne rien changer, je la fais souvent quand j''ai du monde et si je n''ai pas le courage de faire un gâteau', '2014-07-10T08:40:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, 980eb0cb-e781-45e9-a840-3fede8e138f4, 'Excellente salade de fruits pour un dessert léger!', '2013-12-10T20:59:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, 3c3767a3-3d9e-4df5-a30c-07c4ebda5fa5, 'Super frais et agréable a manger. Je n''ai pas mis de pommes par contre j''ai ajouté un peu de rhum et deux étoiles de badiane, un délice. ', '2013-01-29T19:25:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, f7d725cd-3889-4c71-bf1d-7bd0b6e530f1, 'Vraiment délicieux !', '2012-12-19T21:26:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, 70170ffd-4f09-4b93-acf9-2d5fab593788, 'Dessert frais et léger. Idéal après les repas un peu trop caloriques de la saison froide. Pas de sucre, juste ce qu''il faut de cannelle et pas de pomme !', '2012-11-19T12:32:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, 50d1cd99-3de1-4ac9-8acc-ed05af03f5b6, 'Réalisée avec ce que j''ai trouvé : raisin blanc, pomme granny, kiwis, banane. Une orange pour faire le jus. Je n''ai pas mis de cannelle car je n''en suis pas fan mais j''ai mis une bonne cuillère à soupe de fleur d''oranger : à renouveler !', '2012-10-27T08:57:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, 6a72a3a5-482d-4723-b378-d2e4ad29e1bf, 'Dessert assez sympa et frais. En revanche j''ai suivi la quantité de cannelle recommandée peut-être à tort. Un peu plus ne serait pas de trop.', '2012-04-08T18:52:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, e56c2dc3-34f1-4f33-9dee-432de5db8401, 'Un véritable délice, une invité est même partie avec la recette. Elle est très rafraîchissante et le fait qu''on ajoute pas de sucre, c''est super.', '2011-11-15T09:45:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, ea3a45ed-d624-4b31-8f68-070010a3130a, 'Très bon et rafraichissant ! Par contre, je préfère ne pas mettre de pomme qui a une texture très différente des autres fruits : cela fait donc un peu bizarre et ça n''apporte pas une saveur indispensable à cette salade de fruit. A la place, je mets une banane en plus. ', '2010-04-11T12:33:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86644, 8d834abf-2c78-4bd6-a704-3369cd46205d, 'Cool !!', '2010-02-08T16:15:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14147, 62fb1b30-0edc-45ef-8536-bc6d24468998, 'Super bon, meilleur avec de la cannelle', '2015-01-20T18:49:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14147, 74783c8c-2beb-4d3c-a89a-6e557458d00f, 'Idéal pour utiliser les bananes un peu mûres. Très rapide, facile, économique. Cuit en plats individuels. Bon, même sans flamber.', '2006-02-14T13:56:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14147, 5e763e99-197e-40ba-924f-a241fe4fdb3e, 'C''est simple et très bon! J''ai choisi des bananes mûres et mis de la cannelle en bonne quantité pour augmenter la saveur des bananes... c''est aussi très bon froid et non flambé. A tester...!', '2005-09-24T14:50:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14147, 83f38677-3a10-4730-85d7-cf36a712ecc0, 'Très bon mais le goût de la banane ne ressort pas suffisemment. J''ai flambé les bananes avec de la cassonade et non le gâteau. Pour une jolie présentation, faites cuire dans de petits ramequins.  ', '2004-11-29T13:22:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14147, e6168ea0-446d-48ea-977f-61758d5f6a0d, 'C''était très bon. Merci pour cette recette facile à faire! J''ai juste fait une petite modification: un des verres de lait a été remplacé par un verre de lait de coco et j''ai rajouté de la noix de coco râpée. Ca n''était pas mauvais!', '2004-08-19T16:11:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14147, 253f21f4-d6ed-4629-9615-51e572f71de1, 'Je l''ai réalisé avec des bananes mûres. Après l''avoir saupoudré de sucre vanillé, 20 minutes environ de cuisson supplémentaire et le rhum flambé, très important! Simple et délicieux... Bravo!', '2004-08-15T13:12:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14147, 2e0fb1a5-0a1f-4fa9-b40f-6581afff9d8c, 'Je n''ai pas mis de rhum, j''ai mis 8 cuillères à soupe de sucre. Prendre un plat rond anti-adhésif et bien faire caraméliser! Meilleur tiède.', '2004-06-17T09:55:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14147, 63ae2953-cf6b-42d5-8877-6293969f2fd5, 'Ne pas prendre des bananes trop mûres. Pour avoir plus de goût, ajouter de l''essence de banane!', '2004-04-29T00:20:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14147, 56b5a8da-23fc-4797-8a9d-dac9557a5b72, 'A faire avec des bananes très mûres (tigrées) et cuire dans des ramequins individuels pour une jolie présentation.', '2003-12-24T20:41:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14147, 9a39c5a9-0d6b-4726-b6f4-532e10bd38ca, 'Un peu déçus, nous n''avons pas trouvé trop le goût de la banane, peut-être parce qu''elles sont cuites...', '2003-11-14T21:56:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14147, ac738310-a7de-49c0-aa3c-7ff9fed4216b, 'J''ai testé samedi dernier. J''ai trouvé cela moyen mais mon mari a adoré, même froid le lendemain. C''est vrai qu''il faut augmenter le temps de cuisson.', '2003-11-14T16:00:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14147, fd5d8ff0-fa3a-4442-b54d-1671a3cf42c9, 'C''est à en tomber par terre! Un petit plus: saupoudrer avec 1 ou 2 sachets de sucre vanillé au lieu du sucre comme indiqué. Génial pour étudiant ou dessert vite fait et économique.', '2003-11-01T18:34:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14147, 9dd1b5d8-2bc8-4816-8838-f3c040d0ebe9, 'Super recette, les 20 minutes de cuisson supplémentaires sont effectivement indispensables, en prenant la précaution de protéger le clafoutis avec une feuille d''aluminium pendant les 3/4 de la cuisson. Petit plus, pour ce délicieux dessert pour les gourmands, rajouter une goutte de vanille liquide dans la pâte et servez accompagnée d''une boule de glace vanille, si le coeur vous en dit.', '2003-10-24T23:42:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14147, 7348aa8d-0a43-425d-926d-1f11e79901c5, 'A mon goût, il faut 20mn de cuisson en plus. Ce dessert est excellent, apprécié des petits et des grands.', '2002-08-17T13:47:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 5b21df35-0eb0-4e75-9fda-8a6faca10d74, 'J''ai mis du cacao Nesquik à la place du sucre, des pépites de chocolat noir et des cerneaux des noix.
C''est une tuerie ! Ce muffins sont vraiment super moelleux ! ! Pour ceux qui aiment un peu plus sucré, n''hésitez pas à mettre un peu de sucre quand même en plus.', '2024-02-17T21:14:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, bb7be39b-0677-4eb9-b6cd-13b43061aedf, 'J''adapte la recette selon s''il me reste 2-3 ou 4 bananes trop mures. J''intègre 1 carré de chocolat coupé en 4 dans chaque muffin et seulement 30g de sucre et sans bicarbonate. Déjà fait de nombreuses fois, c''est très bon.', '2021-07-23T14:25:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 30ed00e0-69ce-471c-8022-1c3e8e6c30a5, 'J''ajoute un demi carré de chocolat noir dedans ! C''est très bon et fondant comme il faut un mini gâteau ! Tout le monde les dévorent.', '2019-01-14T20:45:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, a1d6187d-0a69-444d-840b-556851b2d13f, 'Délicieux, idéal pour utiliser des vieilles bananes, nous avons rajoutés un carré de chocolat noir dans chaque muffin. Un régal pour le goûter !', '2022-07-20T16:46:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, da689724-fd89-4469-9bf1-21a1fd4c73d4, 'Excellent, ils sont bien moelleux et goûtent bien la banane ', '2022-06-29T16:11:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 40975d3d-2f26-4bba-b978-585766d3562c, 'Excellente recette ! Je n''avais pas de bicarbonate, j''ai ajouté un demi carré de chocolat noir au milieu de chaque muffin : un régal 😋', '2022-06-26T15:17:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, b5747ced-a25a-413d-9dad-92fa5110681e, 'Excellent et rapide ', '2021-12-03T16:17:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 2f8c40d4-eb31-46f6-acfc-f85e0d9a138a, 'Recette au top. J''ai cependant diminué la dose de sucre (pour 300 g de farine, au lieu de mettre 150 g, j''en ai mis 100 et cela mérite d''être encore diminué).
Pour les personnes qui souhaitent diminuer leur consommation de sucre, diviser par 3.', '2019-07-21T08:26:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 10291447-dda1-49be-892e-10188a98c086, 'Très bon, moelleux à refaire ', '2023-11-07T16:29:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 7af86d53-927d-4426-aedc-3c7ea755b8a2, 'Merveilleux ! Je ne m''attendais pas à ce que ce soit si moelleux, si délicieux ! J''ai fait la recette pour 6 en rajoutant 36 carrés de chocolat noir, blanc et lait, j''ai pu obtenir 12 muffins', '2023-11-02T08:53:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 7133d0c1-4294-44dd-bf75-f6931a9d8265, 'Facile à faire, rapide et un peu délice. Moelleux à souhait, parfait, rien à y changer! Je referai c''est sûr. Merci.', '2023-05-09T06:21:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 8c407740-d2db-49d2-946e-a5b06c101415, 'Je n''ai pas mis de bicarbonate et c''était très bon, et facile à faire ', '2023-05-05T13:03:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, e97afd5b-4d34-45db-94d1-b13f944c9ecf, 'J''ai ajouté d''autres ingrédients comme de la cannelle et cacao non sucré; surprenant', '2023-04-15T03:33:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, fb0264aa-562a-4531-978e-4e57e243fb20, 'J''y ajoute des pepites de chocolat et des noisettes moulues. La recette est vraiment bonne, les muffins sont moelleux et délicieux à la sortie du four.', '2023-02-13T20:47:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 5acd366f-1dc7-45be-a580-48e582a3dadf, 'Délicieux j''ai ajouté une cuillère à café de pâte à tartiner dans chaque muffin. A refaire 👍', '2022-06-30T17:48:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 9f4d6b76-e4b0-4d37-9e41-29c6900b6f6b, 'Fait, refait et rerefait et toujours un succès chez les grands et les petits!', '2022-06-08T20:16:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 7435b07c-7201-44cf-9e98-16eafc0ec968, 'Super recette! Le goût et la texture sont parfaits. J''ai juste rajouté des pépites de chocolat noir pour la gourmandise 😉', '2022-04-03T17:20:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 751aafd1-496b-42d3-b620-e299f3493fbf, 'Très bonne recette. Facile et rapide. Le muffin est très léger. J’ai ajouter un carré de chocolat au milieu et servi tiède. ', '2021-01-25T17:41:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, f594d5b1-6985-46db-a5a1-031e37589339, 'Excellente recette. Les muffins étaient délicieux ! Très légers malgré la banane qui alourdit toujours un peu, avec un bon goût prononcé de banane hyper moelleux... Un régal ! J''ai juste suivi les conseils des autres utilisateurs, en diminuant à 60g le sucre et en faisant moitié-moitié farine et maïzena. Un régal que je garderai comme base pour les prochaines tentatives avec d''autres fruits.', '2020-10-02T18:13:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, a108be2f-82b3-405f-bbcc-04dc54b8f6d6, 'J''ai voulu changer de ma recette habituelle et j''en suis très déçue. On sent trop le bicarbonate.', '2020-01-10T10:56:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, bb335e35-efbe-4086-92aa-b209bf1c31a0, 'J''ai mis 50g de compote de pomme à la place d''un oeuf, il faut donc cuire un peu plus longtemps. J''ai également diminué de moitié le sucre. À refaire sans hésiter !', '2019-12-11T00:04:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, af975c77-9c08-42c0-a347-09e670ab592f, 'J''en ferai cette semaine, je ne manquerai pas de vous donner des nouvelles. Les muffins se conservent combien de temps ? (ce sera pour le goûter de louloute et je compte les faire en une seule fournée). Merci à ceux/celles qui prendront le temps de me répondre.', '2019-10-28T08:36:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 6b23ee24-7dce-4920-8ec6-b3b6f7406255, 'Une tuerie. 4 pistoles de chocolat au milieu du muffin ou des pépites de chocolat et mettre 13 min à 180°C ou 17 min dans un moule à gâteau en silicone à 180°C. C’est la meilleure des recettes à la banane. Gâteau très moelleux et pas sec. ', '2019-08-28T05:15:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 394c1dd0-38b1-4e0e-a8d8-047f706c6333, 'Très bonne recette. Les gâteaux sont moelleux. Je n’ai pas mis de bicarbonate de soude et je n’ai mis que 50 g de sucre mais la prochaine fois, j’en mettrai encore moins.', '2019-08-27T10:37:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, c44f8993-ea72-4bf8-afdf-0ea6c9651b8c, 'Très bien pour recycler des bananes bien mûres !!!', '2019-02-19T06:51:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, bdddf3cc-a6cd-4b39-8a2c-83e52daea2bb, 'Muffins moelleux. J''ai ajouté des pépites de chocolat. Un délice !', '2018-12-07T06:42:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 83a6050e-53ba-4ebb-af0d-c339c155cdbc, 'Recette suivie à la lettre, la texture est parfaite ! Très légère!
Un peu déçue pour le gout trop peu prononcé de la banane !', '2018-05-20T05:08:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 5203ff1a-4a88-4b73-b828-d5e0885b89a4, 'Excellent ! Super moelleux, pas trop sucré et vraiment le goût de banane ! J''ai pris des bananes bio pour avoir plus de goût. J''ai mis presque un sachet de levure car je n''avais pas de bicarbonate et ça fonctionne très bien ! Je vais les garder pour la base de tous mes muffins !', '2017-03-11T19:16:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 3e5a5b4d-7459-4cf7-b92c-c4cd856a62b5, 'J''adore cette recette ! Les muffins sont toujours très moelleux. Parfois je la suis à la lettre, d''autres j''ajoute des petit morceaux de chocolat ou une cuillère de crème de spéculos au centre... Merci pour cette recette facile et savoureuse !', '2016-08-04T19:33:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, ca734279-e766-4dd4-a431-14ff4b28d075, 'Top recette et bonne alternative au banana bread quand il vous reste des bananes trop mûres. Muffins très moelleux et avec un carré de chocolat glissé au centre avant la cuisson cela devient un vrai petit dessert gourmand. Merci !', '2014-06-29T00:35:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, f2bcd32c-4c7a-4573-b3ab-a658078871af, 'J''aime ', '2023-11-04T17:37:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 126056eb-a5bf-4b15-bd5b-372272144955, 'je remplace le beurre par 50g d huile de coco c''est extra!', '2023-10-31T12:13:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, d2541a8d-794f-48f0-b5f6-066cff56bfd3, 'Je les ai refaits 2 fois en 10 jours!!!!', '2023-10-29T10:18:27+01:00');
