INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 9b9d7e32-f4cc-47d4-8689-b1bcebd58665, 'Très bon 😍😍', '2023-04-05T12:28:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 5a7cbda1-900b-4def-b2b2-1de65d5552cf, 'Super recette !!! Délicieuse ! Pour la glace je préfère vanille noix de pécans caramel beurre salé . ', '2023-02-26T12:09:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 91c40913-a734-4d82-bc5c-08b77b8ef942, 'Super mais il faut doubler la dose de pâte à crumble pour que cela recouvre bien toutes les pommes mais recette top !', '2022-12-20T19:00:52+01:00');
