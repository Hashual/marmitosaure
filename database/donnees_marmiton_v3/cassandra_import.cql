INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 8ad0824c-fa4a-48c2-b04e-0db0af54c3f0, 'J''ai faut l''erreur de réaliser cette recette sans lire les commentaires avant ... Dessert lourd, trop sucré et crème trop liquide. Je retenterai avec moins d''oeuf et du fromage blanc.', '2021-05-02T18:02:04+02:00');
