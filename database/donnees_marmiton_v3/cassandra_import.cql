INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 4aed27ee-45eb-42e0-a06a-5547ea40650e, 'Bonjour, pour des enfants petits et très très très grands, un régal', '2022-03-28T12:48:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 9ebd24e5-f6f0-4ee6-8e2b-e8ed9bc295bd, 'Excellent! Je ne met que 2 bananes, 100g de sucre, et je rajoute des pépites de chocolat 🤩', '2021-05-20T20:10:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 779a2821-0ad3-4802-ac60-5de9538036a4, 'Super recette réalisée plusieurs fois!
Je mets seulement 100g de sucre, cest suffisant car les bananes mûres sont deja tres sucrées. 
Pour le reste, je suis tout comme indiqué.
Possibilité de rajouter des pépites de chocolat, 1 sachet de sucre vanillé, des noix... c''est à votre guise.
Régalez vous 😋
', '2021-05-01T11:01:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 42a1988f-abbd-40d8-958e-976034b91057, 'Aspect extérieur magnifique par contre à l''intérieur je ne sais pas pourquoi il est pas cuit du tout ! ! ! J''ai fait tout à la lettre et non mis en chaleur tournante... Nouvelles essai avec cette recette beh je vais rester sur ma première recette là je suis déçu :( tant pus. Bravo à ceux et celles qui l''on réussi...', '2021-04-14T23:41:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 287b59d3-43a6-4f86-9d67-ed5a7fa70d8f, 'Pour faire le cake en peu plus tropical j''ai ajouté des amandes écrasées et aussi coco et j''ai changé le Sucre pour la cassonade. Muy rico ! !', '2021-04-03T10:29:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 4736fbf2-8fec-4c02-9c6a-837e0632788a, 'Très bonne recette , facile à réaliser . Le cake est très moelleux . Je conseille de diminuer la quantité de sucre , un peu trop sucre à mon goût ', '2021-02-26T15:31:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 632ff255-0dc6-432f-9243-d48f93a7d0eb, 'Recette parfaite ! (Fait en muffins)
Personnellement je n''avais que 2 bananes pour ces mesures. C''est parfait je n''en mettrai pas 3 car comme ça la pâte est parfaitement légère et moelleuse, avec un goût dous de banane.
J''ai aussi ajouté des pepites de chocolat et des framboises, c''est DÉLICIEUX. Pour le temps de cuisson c''est 35 min à 180°C pour les muffins.
BON APPÉTIT', '2021-02-14T11:28:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 164714fe-98a4-42ec-8701-123f9fecd65d, 'Pour ma part, je n''ai mis que 100 g de sucre, largement suffisant avec des bananes bien mûres. J''ai rajouté des morceaux de noix et des pépites de chocolat. Délicieux. On refera, c''est sûr. Les noix donnent un peu de croquant. ', '2020-10-01T22:23:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 88f6694d-eb09-48e8-936e-57337350880b, 'Recette très facile et rapide à faire, et c’est très bon ! Possible de ne mettre que 100g de sucre sans dénaturer la recette.', '2020-01-19T10:46:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 92cd28c0-fde6-421f-a737-9359f186622a, 'Gâteau très compact et pas cuit à l''intérieur même en allongeant le temps de cuisson.', '2019-10-12T15:21:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, ed46cf9f-ade8-4218-b144-dca65bc20b0a, 'J''ai réalisé ce gâteau en ne mettant que 100g de sucre et je le trouve parfait ! Très moelleux, super bon ! Je recommande', '2018-12-29T05:03:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 1fa4695c-7cb3-4166-9dc1-7229c249c972, 'Très bonne recette ! J''ai mis que 100g de sucre et ajouté une pincée de bicarbonate pour une meilleure texture. Il manque peut-être un tout petit peu d''aération dans le gâteau. Mais bon c''est un régal, et c''est vraiment facile !', '2018-09-09T10:56:48+02:00');
