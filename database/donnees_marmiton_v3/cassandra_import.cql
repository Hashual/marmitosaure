INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339648, 9dec0ad0-7f1b-4b71-80a2-9c12b9ee3976, 'Vraiment très bon !', '2017-09-06T08:59:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339648, 1012b400-d35c-475a-9615-3f939b12ecf9, 'C''est délicieux, moins de sucre 100 gr ', '2017-08-19T13:08:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 8341ecaf-647a-43ee-8b6e-1e9a0dfa2501, 'J''adore !! Je n''ai mis que 3 oeufs et la texture est plus compacte... avec 4 oeufs c''était trop liquide. Sinon j''ai remplacé les fraises par des framboises. 
Je prépare la crème a base de mascarpone plusieurs heures à l''avance et je la mets au frigo. Je dresse les verrines au dernier moment comme ça les biscuits sont encore croustillants et c''est meilleur !', '2018-10-27T03:00:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 36853da0-3634-416e-bcc8-c668181ce830, 'Facile et rapide,  j''ai ajouté quelques feuilles de basilic sur les fraises ', '2023-09-12T11:33:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 35413f8a-667a-4854-b3ab-30d805a00cb1, 'C''est un pur régal en la réalisant avec 3 oeufs, moins de sucre. C''est frais, de jolies coupes à savourer...😋😋😋', '2023-05-13T22:14:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 40643d27-3077-4a5c-a94a-bc249b7078fd, 'Tres jolie et tres bon. Je garde cette recette dans mes favoris. Merci -', '2023-05-19T23:16:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, d995f6f7-bd53-402b-b589-7c16951e054d, 'Je prépare le dessert la veille. Un véritable délice pour vos papilles', '2022-04-21T15:40:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 1a91fa6e-947c-46ab-b803-3e3ec1c850b2, 'Excellent ! ', '2022-04-17T10:48:22+02:00');
