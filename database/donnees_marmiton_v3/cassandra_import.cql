INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, c90408fe-7bc8-4d6f-aae8-5e5f8484167b, 'Excellent 😋😋😋', '2023-06-27T15:33:53+02:00');
