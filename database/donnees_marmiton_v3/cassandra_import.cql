INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 3a8112d9-cd62-4764-bd01-ab261611fb46, 'Très bien avec seulement 150g de sucre de canne au lieu de 200g. Sans le sirop le cake est rafraîchissant !', '2022-01-30T21:47:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 397dd66c-1075-494e-966e-5e75dc5416f4, 'Top! ', '2022-01-30T14:58:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, bdc76fa4-35e2-4149-81b1-9467e68762f8, 'Vraiment très bon par contre je n''ai mis que 150g de sucre et le jus d''un citron vert dans la pâte. Même les enfants ont adoré', '2021-12-04T16:19:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 8b382ea3-a6aa-490d-a93b-40a18c84779e, 'Ça fait 118g de sucre en poudre !', '2021-11-13T18:03:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 9099ca6f-ef65-45c9-9aa3-e9e0a8605cf4, 'Bonjour, j’ai remplacé le zeste de citron, par des gouttes d’huile essentielles de citron Bergamote au goût fin et subtil.', '2021-08-10T15:05:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, a7ed8f48-4703-48b4-9d84-ce91270fa51d, 'Très bonne recette. Je l''ai un peu modifiée en mettant le zeste de 2 citrons ainsi que le jus d 1 citron, et j''ai remplacé une partie de la farine par des noisettes mixees. Un délice ! ', '2021-05-23T22:18:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 29bd0918-2d42-4f29-a3e5-b84560e1ab9b, 'Goût très bon mais texture beaucoup trop compacte alors que la recette a été très bien respectée, dommage! ', '2021-03-24T23:22:21+01:00');
