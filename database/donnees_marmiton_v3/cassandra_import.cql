INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 5875842d-f8e0-4efd-8009-e66543cb8f8f, 'Pour le goûter, j''ai fait ce milkshake et il était dé-li-cieux ! Ma mère et ma soeur l''ont également approuvée. Recette TOP, simple et rapide: D', '2020-05-12T17:19:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 8bb89440-110c-4c5a-b9f4-c66add83a65c, 'Délicieux !', '2020-04-19T20:14:03+02:00');
