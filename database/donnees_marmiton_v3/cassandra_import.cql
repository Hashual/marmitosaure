INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 295baf9a-150c-40aa-bdd1-9f079af79558, 'Très bon ! J''ai mis plus de pommes de terre et seulement 4 tranches de jambon. Et plus de crème ! :)', '2021-03-21T19:49:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 23b31b49-56aa-45d5-93c5-ee48cfef1bb7, 'Très bon, mais il manque beaucoup de crème fraiche', '2021-02-07T10:57:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 40281bb2-502d-4fdc-a8c0-55d89a816561, 'Pas mal mais un peu long à faire. La prochaine fois je pense éplucher et couper les patates avant de les faire cuire.. . ', '2021-01-21T23:35:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 490aa01a-b6ad-49ee-9418-868ee09f10ad, 'Excellente recette! La moutarde relève agréablement le plat! C''est LA recette que je fais à tout les coups dorénavant!
Merciiii ', '2020-12-15T01:06:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 3b6c04fc-70f6-4204-9c88-001237c55155, 'Très bonne recette, facile à réaliser. A refaire. J''ai ajouté qq carottes coupées en rondelles et qq blancs de poireau. Trop bon ! Merci !', '2020-10-27T15:05:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, e4288f0b-5871-4de6-a72f-eb5c8fe40943, 'J''ai essayé la recette sans la moutarde et avec des lardons de volaille car je n''en avais pas à disposition... une merveille. Super facile à réaliser et bon à manger , mon fiancé en redemande ! À refaire. ', '2020-07-02T21:40:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 3e224705-2345-4fda-98d6-779fcc2ea502, 'EXCELLENT AVEC CETTE TOUCHE DE MOUTARDE', '2020-04-19T22:23:31+02:00');
