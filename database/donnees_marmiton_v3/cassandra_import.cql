INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92486, 36fdb373-2e83-4d52-ad45-a9f072029e19, 'Super bonne la meilleure tarte aux pommes que j''ai pu faire', '2023-03-25T07:23:56+01:00');
