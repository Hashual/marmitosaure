INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 947095b8-2f97-4f6a-a645-48e0efafd45a, 'Réussi', '2019-05-25T04:51:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 88ed1a7d-78a2-48e8-8946-f429fc3d7f15, 'Bonne recette, les enfants ont adorés et le papa aussi. La crème est liquide mais ils ont aimé comme ça. ', '2019-05-14T07:46:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 8f5aa9de-0402-43cf-9b09-ec6e217eb670, 'Pas genial cette recette.', '2018-12-19T18:23:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 8b7a5680-4b9a-4903-ad4b-82655185955a, 'Trop bon ! Je rajoute cependant un fond de mixture spéculoos/jus de fraise dans le fond, encore meilleur !', '2018-08-25T18:10:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, df84bd10-3cfb-4c08-b226-8483f3397021, 'Bonne recette, j''ai suivi l''avis des commentaires en mettant 3 oeufs et 70g de sucre c''était parfait !! Merci !', '2018-07-07T05:14:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 4fe0a44f-29e3-4e0b-b0a7-5a018fbe9282, 'Très bonne recette moi qui n''aime pas le tiramisu café j''ai adoré cette recette je la referai souvent.', '2018-06-07T19:15:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 8668c1f4-8d0d-40e8-b8da-2658ae6f119b, 'Une tuerie !', '2018-06-06T14:06:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 529432b1-8c76-42ef-9e45-67351959f11d, 'Super recette ! ', '2017-08-08T18:37:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 3eff4935-e829-4d70-8bbe-4846ab64024f, 'Recette très facile et fraiche. J''ai seulement mis 3 oeufs et 70 g de sucre. Rien à changer pour le reste.', '2017-04-21T11:55:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, a95b153c-3c14-43c6-a0b3-e7354898e545, 'Déçu! J''ai l''habitude d''en faire j''ai suivi cette recette pour changer et nous avons pas aimé le goût des œufs c''était jaune mon tiramisu le spéculoos et devenu mou.... je ne referais pas cette recette! ', '2017-03-31T16:53:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 79d599dd-34b2-4362-8976-754ea271f8dd, 'Bien, sans plus.', '2016-08-08T16:37:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 7d31c9e6-131a-40e6-b354-9f5c516633b4, 'Jolie présentation mais dessert vraiment trop lourd ! ', '2016-07-24T18:38:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 7f7dab72-198e-415b-9d04-2c4d186222c7, 'Mes spéculoos sont devenus mous... mais sinon tout était délicieux ! ', '2016-05-13T18:10:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 5b93bbe2-6a0d-46b8-abdb-1606af226141, 'Très bonne recette que je garde. J''ai remplacé le coulis par 500 gr de framboise mixées (y rajouter un peu de sucre si les framboises ne sont pas trop sucrées). On peut aussi filtrer ces framboises pour éviter les grains mais pas indispensable. Je rajouterai une feuille de gélatine pour un résultat un peu plus ferme. On s''est régalé et très bel effet.', '2018-04-04T21:40:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, b44f6225-7ffe-4582-89cc-33dd1423aa5f, 'Excellent. J''ai mis 9 feuilles de gélatine et 850 g de fromage blanc. J''ai ajouté des biscuits à la cuillère trempés dans du jus d''oranges pressées dans le fond et autour.', '2016-11-20T15:09:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 164dfcba-64be-4e02-9213-4e8dd7d694df, 'Une vraie recette savoureuse, qui peut être refaite avec plein de parfums différents. C''est une de mes recettes de base pour les mousses. Merci pour cette recette !', '2015-12-11T18:34:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 77e46c12-fec7-4182-90a7-997e6cbf2c9a, 'J''ai suivi la recette à la lettre... Juste mis un fond en génoise, quelques framboises entières dans la préparation  et fait avec un cercle et un ruban ... 2h au congélateur puis au frigo, démoulage et tenue parfaite... Heureusement j''avais des témoins... Sinon ils auraient cru que je l''avais acheté...', '2013-09-08T17:29:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 9add05a4-c5f8-49c3-9cf9-27264de931d5, 'Réalisé avec une génoise en dessous et un miroir gélifié framboise au dessus... juste PARFAIT !!!!! Du coup quelques framboises en déco au dessus mais pas plus !!!!!!!!!!', '2013-01-22T18:03:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 5960e7cd-b50f-43e1-9fdf-7306b7a875b7, 'Mon fils me le réclamait depuis des mois, je croyais que c''était très compliqué à faire, mais non ! Comme Corine j''avais mis des biscuits à la cuillère (seulement dans le fond) mais je les avais un peu trop humidifié, en fait je pense qu''il suffit de 4 cuillères à soupe de sirop par dessus. J''ai utilisé du coulis de framboise surgelé et des fruits rouges surgelés pour décorer le dessus. Truc en plus, j''ai un moule dont on peut enlever le tour d''un simple déclic... Pratique! Bon, c''était super, super, bien moins compliqué que je ne pensais et tout le monde a cru que c''était un gâteau de pâtissier. Le plus : fromage blanc moins calorique que la crème fraiche ! ', '2011-03-06T20:08:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, fdc8a3f1-731c-40e5-a984-a9fa0f398754, 'Excellent, c''était mon premier bavarois et il a super bien réussi!!! Je l''ai fait à la Mangue (2) et c''était delicieux. De plus il est léger: j''ai calculé les calories contenues dans cette recette et comparé avec une à la creme: 980 contre 1900! Le compte est bon, la recette adoptée ;). Merci.', '2007-01-04T21:57:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 9469dea0-0b30-4105-a5a8-e2f5619ef9fa, 'J''ai ajouté une petite génoise de 1 à 2 cm, au fond du bavarois pour qu''il se tienne bien. Et je l''ai nappé de gelée de framboises.', '2006-01-09T07:24:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 3f3a27c7-4b03-4fe8-9870-a420e30e694e, 'Très bien ! Pour la mousse 1/3 mascarpone 2/3 fromage blanc et bien sûr des biscuits cuillères pour maintenir l''ensemble ', '2015-06-27T00:26:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 2af4f986-ea11-4877-9f25-deefbeef1d40, 'Testé aujourd''hui et vraiment déçue! Le bavarois est hyper liquide je vais devoir tout recommencer, avec de la crème cette fois, plus calorique mais au moins je suis sûre que ça tiendra! Là tout l''appareil a débordé du cercle à gâteau malgré un biscuit préparé en bas... Beaucoup d''énergie et de temps gâché pour rien...', '2015-02-21T15:23:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, ce520b31-8baf-4354-92d4-841a9d127be4, 'Facile à faire et très léger, je le refais souvent.', '2014-11-22T15:01:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, c40ff0bf-8b1c-4b87-afc4-a710af6ccae2, 'La dose de gélatine est parfaite mais il n''est pas précisé que le coulis est déjà sucré ! J''ai dû ajouter du sucre au jugé dans mon coulis de framboises maison :/ ... J''ai aussi mis 150g de chantilly au mascarpone pour seulement 350g de fromage blanc : onctuosité bienvenue pour contrebalancer l''acidité . J''ai coulé le bavarois (dans un moule à charnière) sur un disque de génoise pistache et j''ai zappé les fruits du dessus parce que j''avais utilisé mes 2 paquets de framboises surgelées dans le gâteau ! Joli et très bon après une nuit au frais.', '2014-01-17T08:54:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 00df50cb-ccf5-4281-9803-fb7a42dba8a3, 'Extra bon ! Et facile à faire ! Je l''ai fait pour noël... nous étions 20, j''en ai fait deux et c''était trop ! Ça fait de beaux gros desserts ! J''ai mis la photo de mon bavarois. J''ai choisi de mettre des biscuits de reims en contour, je les ai trempés légèrement dans le sirop de framboise (boite de framboise au sirop, mamet). Ensuite j''ai versé au milieu l''appareil bavarois et je l''ai fait la veille. Au frais. Ça a bien pris. Et le démoulage s''est bien passé, avec un moule avec tour amovible. J''ai divisé la dose de citron par deux, comme conseillé. J''ai fait mon bavarois avec des brisures de framboises surgelées. J''ai fait du coulis avec et ensuite mon bavarois. Top ! N''hésitez pas !', '2013-12-27T11:32:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 79b9bc3c-8530-4032-96bb-202749fc6ef4, 'Un vrai délice, tenue parfaite... recette adoptée.', '2013-08-01T15:16:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 3d1b430b-9e6b-4ad2-a05d-c56d41446d7f, 'Très bon et rafraichissant en été car pas de cuisson ;) J''ai mis les framboises entières dans la préparation du bavarois pour un peu de consistance et je l''ai mis au congélateur une dizaine de minutes après l''avoir démoulé pour qu''il tienne. Parfait ! ', '2013-07-31T22:26:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 56cad7ad-ac2c-4087-a1df-a257367a7cd0, 'Dans la recette, on ne parle pas des biscuits roses de Reims, comme cela apparaît sur la photo. Je l''ai donc fait sans, mais c''était excellent quand même.', '2013-07-29T21:05:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 57d9a8e3-ff94-44af-bc03-f8bb708da447, 'Miam !', '2013-07-26T18:32:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, cc15ddc5-5258-4f0e-b3cc-274961102027, 'Le goût parfait mais la tenue !! Même en doublant la gélatine après 5 min de démoulage, l''appareil s''écroule !! Je pense qu''il est impératif de chemiser le moule de biscuits pour un peu de tenue.  ', '2013-01-02T17:44:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 7d1a56e8-fbb4-4497-84e8-9502facf7672, 'Succès garanti ! Pour ma part, j''ai fait un fond de tarte avec 10 cuil à soupe de farine, 6 cuil à soupe de lait autant de sucre, autant d''huile et 1 paquet de levure chimique et mis mon bavarois dessus. J''ai par ailleurs remis pour la déco des framboises mixées. Très frais et très bon aussi et pas trop calorique.', '2012-06-04T12:56:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 79c73177-fe94-4008-9311-2a1bf0d2c3ac, 'J''ai testé cette recette hier midi, c''était très bon, le hic pour ma part, c''est que cela manquait de consistance, ce n''était pas assez ferme...', '2012-04-02T17:01:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 7abf56ae-d278-471d-88d7-bd942f7a9aed, 'C''était tout simplement excellent ! Ayant un moule de 24 cm seulement, j''avais de la préparation en trop. J''ai tapissé le fond de mon moule de boudoirs légèrement imbibés de jus de framboises et c''était vraiment délicieux. Merci pour cette recette !', '2011-07-17T13:19:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 51bc0bbe-311f-4bea-9b15-0511410c0dae, 'J''ai réalisé le coulis avec des fruits rouges mélangés décongelés. Attention à ne pas trop sucrer le coulis si vous le faites vous-même. J''ai mis des biscuits à la cuillère dans le fond de mon moule en silicone ; aucun problème au démoulage ! Je n''ai pas ajouté de fruits sur le dessus, il m''a semblé que ça allait faire trop.  A faire et à refaire, surtout en été, succès garanti ! J''ai bien envie de tester avec des fruits exotiques.', '2011-06-18T17:52:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 0bb4d8e6-602c-4822-8bdc-654f3371f04e, 'J''ai réalisé la recette en divisant les proportions pour 4 personnes (avec 1 seul œuf et 1 seul citron). J''ai utilisé des framboises surgelées. J''ai tapissé mon moule avec des biscuits à la cuillère, trempés dans le jus des framboises allongé d''eau. Et c''était top ! Tout le monde s''est régalé. Merci pour cette recette simple, rapide et très efficace !   ', '2009-05-20T00:22:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 001a60dc-f871-47c6-8358-0514819f1fd6, 'Réalisé avec des mûres et une autre fois avec des framboises, ce fut à chaque essai une réussite. J''ai suivi les conseils "marmitonautiques" (moins de citron). Enfin un bavarois qui se tient(et qui se démoule!) sans abus de gélatine. Il ne me reste plus qu''à tester d''autres fruits.', '2008-02-29T18:45:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, fc5c5b07-3c70-41e3-890e-add874d865c3, 'C''est vrai que le fromage blanc allège le bavarois mais il reste tout de même un peu écoeurant. De plus je l''ai fait pour un anniversaire et impossible de le démouler. Dommage.', '2007-06-07T18:07:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 4bf398b6-4686-424c-b806-269af79a2525, 'Je suis d''accord avec un avis précédent: beaucoup trop citronné. 1/2 citron devrait suffire.', '2005-09-10T20:46:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 00a3e664-a534-46e7-b1a3-de0f412c86a9, 'Très facile à réaliser et impossible à rater. Un régal pour mes invités et une satisfaction de réussite pour moi. A tester pour toutes occasions et pour les problèmes de "démoulage" je fais prendre le bavarois dans des coupes rondes en alu achétées dans le commerce. Une présentation individuelle qui fait de l''effet, servie avec une gaufrette ronde coupée en deux et plantée dans le bavarois on croit voir arriver un voilier....Merci pour cette recette!', '2005-05-16T20:33:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, dbc6ad5a-5087-4b7f-9053-7b2883b74689, 'Plus facile à faire qu''au premier abord! Un peu de mal à démouler (mais je débute) et au final un gâteau vraiment délicieux! :-)', '2004-07-27T19:05:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, c1e7ecb3-947b-4346-be11-98e9a98f2b0e, 'Dessert frais et léger, d''une simplicité enfantine pour un résultat toujours étonnant.   Je l''ai fait avec du fromage blanc à 20% (doit pouvoir se faire avec du 0%) et des brisures de framboises surgelées (je n''avais pas de coulis). En revanche, mes feuilles de gélatine doivent être plus grandes parce que même avec seulement 5 feuilles, on la sent trop.', '2004-04-28T08:38:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 8ad4ac1e-ba1a-47f8-8406-2a8d735bbc33, 'Résultat moyen: le goût du citron était trop prononcé par rapport à celui de la framboise (je n''en mettrais qu''un) et j''ai eu des problèmes de démoulage.', '2004-01-31T21:02:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 0431f52c-c282-43c6-af63-ea2f8fb747f6, 'Absolument délicieux, pas du tout écoeurant et léger comme tout. Rien à redire!! J''ai également essayé avec du coulis de mûre, c''est tout aussi bon.', '2003-08-26T19:12:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, adba46ad-54cb-4358-93d5-abc14a22700b, 'Excellente recette rapide à préparer (et à manger !!). Faire le coulis de framboises soit-même ne prend pas beaucoup  plus de temps, ça vaut le coup, c''est bien meilleur.', '2002-09-20T22:16:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16382, 6a84c569-7018-42ba-b83f-86c824332289, 'Mis dans un moule à charlotte, mon bavarois avait fière allure, mais surtout il était délicieux...', '2002-06-25T19:08:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, 52d026fd-46f5-412d-9b11-8342ebb8c908, 'Recette qui change des cookies au chocolat. 
J''ai remplacé le sucre par 100g de sucre cassonade, c''était largement suffisant. Et recette faite avec des framboises surgelées mais qui avaient degorgés depuis la veille donc parfait ! 
J''ai mis les framboises une fois que je façonnais les cookies juste avant de les poser sur la plaque. Un délice !', '2020-11-21T16:39:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, ebccfdc7-6656-4a66-8eb6-5ef020d15d16, 'Une tuerie ! Comme indiqué dans les commentaires, j''ai mis moins de sucre que dans la recette et j''ai ajouté les framboises au dernier moment sur les cookies sans les mélanger à la pâte.', '2019-02-18T03:23:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, 6f238559-5297-4613-aa82-e99e49b9ccaf, 'Super recette ! Très facile, mais un peu long de disposer les framboises dessus afin qu''elles ne s''écrasent pas, alors j''ai fini par tout mélanger. Resultats : j''ai préféré les cookies avec les framboises sur le dessus car ils sont plus croustillants et sont un peu plus goutus et acidulés. Ceux dont j''avais mélangé le tout ont mis plus de temps à cuire, les framboises surgelées rendant beaucoup d''eau, mais très bons aussi. Et pour finir, j''ai egalement suivi les commentaires et mis que 200 grammes de sucre.', '2017-07-04T20:48:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, a7736d20-6665-4e4f-9ab5-6e2ba6e9a0e2, 'Ces cookies sont délicieux, en revanche je vous conseil de ne pas mettre les framboises directement dans la pâte, car cela les réduits en bouillie. Ce que j''ai fait c''est que j''ai étalé la pâte sur la plaque de cuisson puis ensuite j''y ai mis des morceaux de framboise que j''ai coupé au préalable, et je pense que c''est bien mieux comme ça.', '2017-06-28T20:25:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, fb01206b-4e82-4475-a327-01fbc4d40fad, 'J''ai suivi certains conseils en ne mettant que 200 g de sucre dont 150 g de sucre blanc et 50 g de sucre roux, un sachet de sucre vanillé au sucre de cannes...j''ai aussi ajouter des pépites de chocolat blanc (200 g mais ça fait un peu de trop, mes cookies faisaient trop sucré et ne se sont pas étalés à la cuisson. J''ai dû aplatir moi-même pour les autres fournées...je recommande donc 100 g ou 150 g pour les plus gourmands pas plus !) pour ma part j''ai totalisé 50 cookies et ils n''étaient pas petits ! ', '2016-12-01T15:38:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, f4e8c9fb-ddd3-4bd0-958e-0158f9c8ab37, 'Excellent. Ces cookies sont très parfumés avec les framboises fraîches du jardin. Ce n''est pas nécessaire d''ajouter d''autres ingrédients pour se régaler. A refaire sans hésitation.', '2015-08-20T16:47:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, bee4a925-db27-43cc-bb3e-de29f47afe08, 'Excellent ! J’ai mis 180g de sucre et c’était amplement suffisant. C’est la 1ere fois que je fais des cookies je les ai trop rapprocher il faut vraiment laisser de l’espace encre les boules de pâte. Je n’avais pas de beurre j’ai mis de la margarine mais je crois que ça a rendu le cookie trop mou ou mettre moins de gras la prochaine fois. On a mis les framboises au dessus mais on aurait pu les mélanger à la pâte car elles étaient surgelées donc plus résistantes.
Le résultat est que la recette est quand même très bien puisque l’on s’est régalé !
', '2024-01-30T13:13:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, 8a52090e-d424-4d91-9d18-fd75b5fdc10a, 'Délicieux,
Avec des framboises du jardin 
Une recette que j''ai trouvée il y a plusieurs années, et est devenue incontournable
Merci beaucoup pour le partage 
', '2023-06-22T17:16:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, 30e2405f-3784-4c72-bba1-53fff04c84ff, 'Une tuerie ! Je n''ai mis que 150 g de sucre.', '2023-04-02T19:06:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, 64b42192-b19b-4616-af28-822522f9a4a1, 'Super et facile
', '2020-08-22T18:25:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, 171756e6-2307-4864-8282-605e09e6bd03, 'J''aurai du lire les commentaires... très sucré ! Mais bon ! La prochaine fois je diviserai par 2 je pense le sucre.', '2019-12-27T08:21:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, 8c13ae2e-c030-4de1-8904-6063b345bdcf, 'Excellent, j''ai suivis les commentaires, j''ai mis seulement 180 grammes de sucre et rajouté des pépites de chocolat blanc ! J''ai mis les framboises dans mes petites boules de pâte a cookie et non directement dans la préparation afin d''avoir des framboises entière ! Un vrai délice j''en referais !', '2019-05-18T04:23:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, 4c58afbe-73b6-4a43-88d5-431ef4ca49f2, 'Excellente recette où j''ai mis du beurre de cacahuète à la place du beurre. Nous nous sommes régalés.', '2018-11-25T02:14:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, 7d7aa3af-d554-4d58-81c1-b98f723e9f78, 'Les cookies sont délicieux ! J''ai écouté les conseils et ai mis moins de sucre, 200 g suffisent amplement même pour une personne qui adore le sucre comme moi. J''ai ajouté quelques pépites de chocolats noirs pour la deuxième fournée ! ', '2017-03-22T04:07:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, 2242e29b-2fd1-43f5-b257-691ceec93fe2, 'Super cookies ! Ne pas trop mélanger une fois que les framboises sont ajoutés car elles vont être détruites. J''ai ajouté de la confiture au centre, Miam ! ', '2017-03-18T14:06:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, ef942976-7635-4da9-b1ca-4ba7cb3d1f26, 'Très bon. Mais je trouve que la cuisson s''est pas ça. Obligé de mettre plus de temp. Et pour les façonner, difficile avec la framboise qui s''écrasait. Le goût très bon.', '2017-02-09T08:28:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, fd095b4f-7386-4194-9937-ef62099b2bbc, 'Recette très simple à réaliser. Pour cette fois j''ai remplacé la framboise par des pépites aux trois chocolats. Mes enfants ont adoré...', '2016-10-13T17:51:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, feb082ec-eca7-450d-b8dd-41fed58c3d2c, 'Excellent avec des framboises du jardin c''est un délice.', '2016-07-16T19:53:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, ea77bea8-5c96-4ac4-9e4d-46c54726d807, 'Très bon ! Et tellement facile à faire. J''ai lu les commentaires et ai diminué la quantité de sucre à 150 g (j''ai en fait un mélange sucre + vergeoise). Par contre, j''ai ajouté des pépites de chocolat blanc. Un grand MERCI pour cette recette !!!', '2016-06-26T15:31:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, 0f70ef56-905c-4fad-b4c1-7d77b95fee37, 'Super bon !!!!! C''est une très bonne recette bien faite et les cookies sont vraiment bons.', '2016-05-21T17:10:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, cae28985-025d-4448-b065-7c675944604a, 'Super bon ! Aucune modification.. une tuerie ils sont moelleux, miam ! Je referai', '2015-11-16T20:55:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, dafe940e-cd46-464a-a5db-817611d1059e, 'Vraiment vraiment très bon ! Juste un peu trop sucré, donc je mettrai moins de sucre la prochaine fois et on verra... en tout cas c''est addictif !', '2015-10-08T00:13:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, f5ff0922-0a62-4f4d-bd27-e0ed24625cef, 'C''est vraiment une tuerie ces cookies !!! top top top !!!', '2015-06-09T13:44:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, f891038f-1bf0-4cef-b6d0-6074dd854196, 'Miam, j''ai ajouté des copeaux de chocolat noir ! ', '2014-10-01T16:22:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, 514e6f79-a1a6-48ad-b75c-8bcb82e1b3b6, 'Parfait ! Précision pour celles et ceux qui n''ont jamais fait de cookies : Ça s''étale en cuisant ! Ne serrez pas ! Et aussi, quand on les sort, ils sont encore mous. C''est normal. La pâte durcit en refroidissant. J''ai lu dans les commentaires que la plupart d''entre vous ne mettez que 200 gr de sucre. J''essaierai la prochaine fois. Moi j''ai mis de la vergeoise à la vanille pour moitié + le reste de sucre (un sucre poudre dans lequel je laisse des bâtons de gousses de vanille en permanence, pour vanillier le sucre ni vu ni connu, doucement-tranquillement.)', '2014-06-28T23:52:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, 5cd38c23-d2ff-4f21-b43e-deacb198229a, 'J''ai fait fureur... J''ai mis seulement 200 g de sucre, mais du sucre roux et j''ai ajouté 1/2 tablette de chocolat blanc en morceaux. A refaire absolument ! Merci encore.', '2014-06-21T12:06:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, ddafe79b-e3ea-488e-9158-04ede35cfa96, 'J''ai mis 200g de sucre et j''ai laissé cuire quelques minutes de plus. C''était très bon j''en referais !', '2014-05-29T18:40:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, cdaa92e5-c7f9-49f6-ace6-274e9e4bcfaa, 'Délicieux ! Je m''en sert même pour faire des cookies au chocolat et j''adore !', '2014-05-03T20:25:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, 1f0d2fc9-70b0-4293-80a2-8fbad9ab07c4, 'Je ne mets que 200 g de sucre mais en revanche j''ajoute un peu de sucre glace sur les cookies en fin de cuisson, sinon c''est absolument délicieux...', '2014-03-14T15:50:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228774, 125e35bc-15b0-4347-af21-38b1b0178bfa, 'Un vrai délice', '2013-02-19T18:24:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223633, 4579b18f-d0bf-4c70-8189-bd0e22c1ac43, 'Vraiment très bonne recette, merci !', '2015-12-05T20:40:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223633, df0f63b6-8556-4d72-a6cb-5b03cc5375b4, 'Très bonne recette ! J''ai testé en mettant une framboise fraîche dans chaque muffins, excellent !  Peut être un peu trop cuits (pas assez coulant à l’interieur). ', '2015-07-19T18:23:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223633, c5fdaaf0-9e17-411e-9c5d-ad3185339063, 'J''ai testé et j’espère qu''ils vont être bon je vous en dirai des nouvelles. ', '2015-04-17T14:57:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223633, be881735-74ec-4efe-b5b3-96c2d38a254c, 'Juste parfait. Absolument rien à redire. J''ai mis des framboises fraîches au milieu : un délice.', '2014-07-01T21:22:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223633, 19bb8e74-7e61-4f9b-8892-320950b2de66, 'J''ai juste remplacé la confiture de framboises par une de fraises maison et réduit le temps de cuisson à 9 minutes pour encore plus de coulant...  Par contre, il faut bien faire refroidir pour les démouler proprement et surtout éviter qu''ils éclatent !', '2014-06-03T12:16:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223633, 9f211f03-7137-4030-8b83-d3d6249c4f3c, 'Une vraie réussite. J''ai mis un peu moins de beurre (environ 70 g). J''ai mis 2 framboises à l''intérieur et un tout petit peu de confiture. Servi tiède, c''est un régal.', '2013-08-08T12:39:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223633, a383911b-29e9-4400-9f0e-d4098d55f935, 'Très bonne recette. Nous l''avons réalisé avec de la margarine à la place du beurre, en moindre quantité. Une cuillère à café de confiture est largement suffisante, à déposer après avoir rempli aux 2/3 le moule, sinon la confiture tombe au fond.  ', '2013-05-30T02:07:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223633, af7e8cce-d4af-4d8d-b734-b5862001cc72, 'Excellent et facile!', '2013-01-18T14:25:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223633, dd501798-0532-418d-aca1-3ae8c39b669c, 'Recette facile, résultat extra !', '2012-08-17T00:08:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223633, 11b8e66b-e844-4cc2-b9bf-f31b5db1c2b2, 'Très bon et très facile à réaliser ! A la place de la confiture j''y ai mis des framboises', '2012-06-12T23:49:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223633, 7032b71a-7bcd-4eaa-8213-21e0f93df82a, 'Facile à faire, pas cher et surtout trop bon.', '2012-05-02T14:49:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223633, 59878190-b46b-467c-b275-06999dbebb7f, 'Un vrai délice !!! Ne pas hésiter à mettre une bonne couche de confiture ! Miam !', '2012-04-22T23:10:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 1be945bd-38f8-4ce0-94ad-b19a5fc96e35, 'Très belle recette, gourmande', '2023-11-05T10:48:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, fc9f2ffe-df58-431d-8980-13a27ed69976, 'Très très bon👍', '2023-03-29T05:18:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 7c9f14b6-bc24-4497-9c73-3524023bf539, 'Très facile mais il y a des informations incomplète.', '2022-01-30T16:05:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, e32f1bad-9a1d-41dc-addd-33db810d2086, 'Gâteau facile à réaliser et succulent.😊', '2021-10-17T19:34:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, ea349193-b6f9-4323-87a5-8be5a101a513, 'Absolument excellent ! ', '2020-06-15T14:00:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, b4570bcc-7cbe-4f95-a550-e3fb5ed6f928, 'Très bon, prévoir le beurre mou', '2020-03-29T15:17:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, a0213642-d13c-407f-b8fa-942f5556e34e, 'Déçu car on ne sent pas le goût du caramel, le gâteau n''est pas mauvais en soi mais il manque de saveurs.', '2018-05-13T11:00:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, a0fe84dc-1918-41f9-b00b-1250453b8063, 'Excellent tout simplement !', '2017-10-03T15:16:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 863ab203-4234-497e-b8e8-f36589a0423c, 'Vraiment très bon, notamment avec du beurre salé. Perfect !', '2017-09-16T20:43:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 3f1945a1-e1b5-4434-b7b6-21bff89e98b7, 'Caramel brulé.... pâte hypra épaisse... j''ai dû me tromper quelque part ... du coup j''ai ajouté du lait pour détendre la pâte et fait un caramel normal auquel j''ai ajouté du beurre à la fin puis mis les pommes avec... déçu car j''ai bien galéré.', '2017-02-09T20:44:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 60501828-2a91-4293-b0ae-5c7b2fd6d1c1, 'Recette faite à la lettre, sauf pour le rhum, le gâteau est finalement léger et très très bon.', '2016-12-21T14:06:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 9670aa64-4198-4557-8314-125f3049ad83, 'Recette fabuleuse ! Par contre, j''ai baissé les quantités de sucre de la pâte et de la sauce sinon ça faisait beaucoup ! ', '2016-02-10T09:18:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, da5fe597-b261-428b-963c-01360d593191, 'J''ai juste ajouté un caramel dessus pour la présentation et le croquant. Excellent et facile à faire. ', '2016-01-29T10:56:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 90aa324a-3e2a-48d9-a6f5-a337c67572fc, 'C''est un dessert riche mais excellent car très fondant.  Je le referai. ', '2015-12-08T21:13:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, a35b28e5-7993-48ab-97cb-20b7350d1dc6, 'Délicieux et facile à faire, les enfants ont adoré. ', '2015-10-03T12:19:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, e877939c-96e3-439e-bb08-d7704d7bbf04, 'TOP! J''ai utilisé du beurre salé pour le caramel et du beurre doux pour la pâte. Très bonne recette que je referais surement.', '2015-09-27T13:45:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 0ca5544a-76dd-4cd1-ac36-7b3e02448e96, 'Succulent et un véritable plébiscite des convives !', '2015-09-24T20:45:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 3c8636e3-4498-41bb-819d-9aa3a90d750d, 'Merci à l''auteur de cette recette. C''est un très bon gâteau très facile à faire et tellement bon !', '2015-03-21T20:52:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 8c4e977c-1b4e-477c-9eb4-4e38d5fe9657, 'Trop bon ', '2015-01-25T16:11:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 0f18c6b6-b6dc-4722-a251-8d1c0ac7e3eb, 'Moi je dis wow ! quel excellent gâteau ! j''ai bluffé mes convives ! dommage que je n''avais pas de beurre salé, je suis certaine que c''est excellent avec. J''ai remplacé la cannelle (question de goût) par de l''eau de fleur d''oranger avec laquelle j''ai également parfumé la pâte à gâteau ainsi que la "sauce"   ', '2014-10-09T20:46:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 2f64bab0-a855-4020-9866-9b7ca491bced, 'Je suis débutant je n''étais pas sûr du résultat mais ma famille a adoré. ', '2014-10-05T20:23:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, b05cc863-cca8-4d61-9110-56c48b7a4f93, 'Ce gâteau semblait tellement bon sur la photo... J''ai été déçue...  Rien à dire sur les pommes et la "sauce" mais concernant la pâte,  elle avait une consistance très épaisse et avait le goût d''un flan. Dommage... ', '2014-08-07T19:59:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 949ffea6-f979-4f4d-8cf0-27dc9e8707c2, 'Une vraie tuerie! !!!! A faire et à refaire ', '2014-08-03T17:28:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 80ab73a5-1efb-4184-a6a5-b61385006e5d, 'Je n''ai pas eu la patience d''attendre que le gâteau refroidisse.... tiède c''est déjà excellent. J''ai suivi les proportions de la recette et je n''ai pas trouvé que c''était trop sucré.', '2014-06-29T18:51:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 6cfd6c6b-3d14-4524-9457-ea317f6a3c49, 'Succulent... petit point négatif : la pâte du gâteau est un peu sèche car les pommes sont au fond... mais ça nous a pas empêché de le dévorer ! Merci ', '2013-04-15T23:33:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 2ff6e602-fecb-456c-985e-ef0f50e9f91e, 'Super recette mais un peu trop riche. La prochaine fois je remplacerai la crème par du lait. Pour le nappage, j''ai mis moins de sucre et j''ai ajouté un œuf. Un grand merci pour cette recette.', '2013-01-01T20:11:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 4c8e013a-8413-440a-946a-d285a98a33ba, 'Excellente recette !!! C''était délicieux ! A refaire absolument !', '2012-12-19T19:53:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 20c767ae-c9f8-4eab-b58b-f74fbdcd08c8, 'Délicieux. Je n ai mais que 50 g de sucre et c''était parfait !', '2012-11-24T21:52:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, a82e9bbc-03e0-4b99-a1d5-558d97bfa842, 'Excellent !', '2012-10-23T01:10:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 93d7d1be-f8b1-4c47-9a06-c038f796cb44, 'C''est délicieux, le caramel est à faire avec du beurre salé bien sûr, et sans la sauce à la fin c''est aussi très bon ! (ça évite peut-être que ce soit trop sucré). Pour les sans gluten, avec de la farine de riz c''est parfait, et en remplacement de la crème liquide : crème de soja ou lait d''amande (mais attention de ne pas faire une pâte trop liquide)', '2012-08-30T12:49:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, fe0bfa32-f4df-4e6e-9e8d-a2096d10efae, 'Super recette ! Goût exquis.', '2012-07-07T13:20:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 21de5034-e358-42b7-b2ba-6f49b2c11d62, 'Topissime !!! J'' ai mis 2 grosses cuillères à soupe de caramel au beurre salé dans la poêle, au lieu de faire mon caramel (gain de temps). Du coup, je n''ai mis que 80 g de sucre dans la pâte. Je l''ai fait pour le goûter, mais en dessert, tiède avec une boule de glace vanille, je crois que les invités tombent à la renverse.', '2012-04-04T20:14:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, aac0ef90-5e49-4110-a5af-adb932a9b4e5, 'Parfait pour un goûter réussi !!!', '2012-03-04T17:41:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 4a1ce6c7-cca3-4d52-a5db-d1b4d873f9d1, 'Trooooop bon !!!! J''avais de pommes mais pas envie de faire une tarte donc j''ai choisie un gâteau. J''ai mis 100 g de sucre et j''ai trouvé que c''était un petit peu trop encore. J''ai oublié de salr mon beurre et je n''ai pas mis de Rhum. Un délice j''ai justement dosé la cannelle. Mon chéri a adoré également. Un préférence pour moi quand c''est tiède. Hummm vivement mon prochain achat de pommes !', '2011-12-24T19:32:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, be46a2b0-f76a-439b-95ee-700c433c2f32, 'Délicieux', '2011-12-07T00:44:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 3524cbe0-37b3-4d1f-bf24-9c68f128dcbf, 'Excellent ! Ressemblerait un peu à une tatin.... comme commentaire : ne pas oublier le beurre sale ou ajouter du sel à chaque portion de beurre. Meilleur tiède. Merci.', '2011-11-29T11:01:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, e213cf05-af3b-4480-961e-b13aa338608a, 'Excellent ! Tout le monde adore !', '2011-10-30T17:34:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, fc15a9b0-3595-4bac-8b79-0a7acd1e486e, 'Très bon gâteau, ma famille a aimé. Je le referai. merci pour cette recette', '2011-10-25T15:05:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, d52d7485-5288-40e8-9d94-18998bb7b211, 'Délicieux ! Vraiment très bon ! Je le conseille... Avec du beurre salé évidemment, ou bien du sel !', '2011-10-05T00:01:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 0e826be8-f136-43e9-bce5-9433930f9c7d, 'Super Recette ! tout le monde a adoré ! Le Caramel au beurre salé quel régal ! On est breton ou pas... Toutes les copines veulent la recette !', '2011-09-17T22:21:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, ff93fc48-d7c7-4b44-84ae-e3400a8bec3a, 'Très bonne recette, le gâteau a été dévoré, cependant petit bémol : mettre du beurre salé pour avoir un caramel salé ! Merci, à refaire très vite.', '2011-03-20T10:11:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 39338641-d2ab-4da6-b321-1c87346aa89d, 'Très bon et facile à réaliser!', '2011-03-09T19:11:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 2cb41f1f-72ca-46d5-b187-1ea01989bc8a, 'Trop bon ! Ça a été difficile d''attendre qu''il refroidisse...', '2011-02-13T17:50:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, b86fa629-b033-446e-8c6e-a848f7b7d487, 'Mon deuxième est au four... Cette fois-ci je l''ai fait avec des pommes, poires et une banane qui traînait, et je crois que j''ai mieux réussi le caramel, mais le premier était délicieux et a disparu avant même de refroidir... A refaire avec des variantes ! ', '2011-01-23T19:38:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 9140eef8-7b4c-46b1-a0a9-4ede34d96e18, 'Je l''ai fait avec de l''ananas pour une soirée, tout le monde a adoré !', '2010-05-29T09:43:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, ed662054-b468-43cf-9d25-1f8ce463249c, 'Je ne mets que 3, oui c''est bon mais pas exceptionnel, accompagné de crème anglaise "maison" c''est un plus.', '2010-04-19T09:56:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, fc07e972-d58f-4852-9674-027740ddcda4, 'Très bon gâteau. Important de le servir froid ! Je me demande cependant toujours pourquoi il s''appelle "au caramel salé" !', '2010-04-07T10:26:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 27155f62-8857-4708-832f-ba227f7d3542, 'Super recette, ce gâteau est vraiment excellent. A recommander à tous.', '2010-03-07T21:03:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 3273d6b1-bdd2-4c0d-859f-0ca8dcb53a7f, 'C''est une très bone gâteau. Mon beau-père a été ravi. C''est vraiment très bon mais pas diététique. Pour une fois, cela vaut le coup de faire une petite entorse. Recette qui doit être bonne avec des poires aussi.', '2009-11-09T16:16:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 70e332f1-fcb7-4601-95ea-6f1cb788a000, 'Très bon gâteau, un délice qui a séduit petits et grands. Je vous le conseille, c''est le meilleur gâteau aux pommes que j''ai mangé.', '2009-08-30T20:07:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 9192ab71-82b0-4e4d-8888-7629341f50fe, 'Merveilleux !!! Je le servirai la prochaine fois "tiède avec une boule de glace vanille". Tant pis pour le régime !!! ', '2009-08-26T15:02:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, ee14edff-23c3-43b7-95e2-88cb6db0132e, 'Très bon gâteau, j''ai bien suivi la recette, mais sans alcool, et je n''avais que de la crème fraiche épaisse mais ce fut un vrai délice ! Malgré le beurre salé, on pourrait encore saler un peu plus le caramel pour plus de gout ! Le démoulage a été impeccable, miam !', '2009-06-01T00:44:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, e90d077a-9115-492a-bf1a-638d09f67333, 'Excellente recette !  Je l''ai faite sans alcool et avec pommes+poires car je n''avais pas assez de pommes. Par contre, je ne comprends pas en quoi le caramel est salé?', '2008-11-10T10:55:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 449121a3-961a-49f2-9f8c-3f497ba8f13f, 'Délicieux! Les pommes ainsi cuites donnent un goût fruité au gâteau fabuleux! (J´ai ajouté le rhum directement dans la poêlée de pommes).', '2008-10-05T01:24:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 7a818577-28bc-4e1e-9d9e-1677819b80f0, 'Gâteau excellent. Nous ne sommes pas amateurs de gâteau avec de l''alcool et de la cannelle donc à la place du calvados, j''ai mis du jus de pommes et à celle de la cannelle, j''ai mis de la pudre d''amandes.J''ai eu un franc succès avec ce dessert. Vivement conseillé par les amateurs de dessert.', '2007-09-30T20:37:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 556ebc2d-515f-449a-9169-8319b41a39a2, 'Pas besoin d''être une pro pour préparer un bon gâteau suivez la recette et vous ferez des heureux. Moi personnellement j''ai rajouté une cuillère de rhum dans la pâte, excellent pour avoir une pâte plus lisse et j''ai mis les pommes dans la pâte et versé ensuite dans mon moule beurré.', '2007-02-28T17:21:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 4d7786f3-0be7-4f31-84d5-973eb79c4d34, 'Ce gâteau est excellent, à déguster tiède ou alors bien froid. La préparation est très facile, le plus délicat est de faire le caramel qu''il ne faut surtout pas toucher pendant qu''il se fait, attendre patiemment. J''ai utilisé trois grosses pommes et un moule à manqué de 24 cm de diamètre. J''ai un peu prolongé la cuisson, mais en m''étant assurée que le gâteau ne dore pas trop en le recouvrant d''une feuille de papier alu. Pour le look et le caramélisé du dessus, je conseille soit de ne pas le démouler, soit de le faire dans un moule à fond amovible et de le laisser à l''endroit.', '2007-02-23T10:37:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 7c7c65f2-92b0-4b72-84ff-e4936425ae7b, 'Parfait!!! Encore une recette qui va devenir une référence. Malgré tout un peu plus de sel ne nuira pas et effectivement il faut bien beurrer le moule et la présentation sera impeccable. Ma fille a adopté cette recette et un (jeune) neveu l''a emmené pour que sa maman (talentueuse cuisinière) la fasse régulièrement !!', '2006-11-19T12:58:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 2e17ed61-2b44-41f8-b11f-9032c227a5ec, 'Excellent! Par contre, effectivement, le démoulage n''est pas du gâteau... Bien graisser le moule. Recette à garder précieusement !', '2006-07-12T17:57:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40689, 6e273eab-f895-479b-9137-5be00fa7129d, 'Un délice... Merci beaucoup. C''est facile à faire et très bon!', '2006-03-17T14:10:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, ba7f6036-b3ae-4278-bfc1-8d52ee5a0965, 'Très bon avec quelques aménagements, seulement 150 g de sucre et de beurre.', '2022-10-22T18:22:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 981b1e74-76e2-4ec4-a475-6e898a1f4de6, 'J''ai suivi les conseils 150 g de beurre et de sucre. Délicieux !', '2022-10-30T09:26:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 8cced6eb-06ae-409a-b6d6-f7c27929c7fa, 'Excellente recette, que je connais depuis mon enfance (merci maman !) dans une légère variante. Le rhum est supprimé ainsi que les noisettes, le beurre réduit à 200 g et à la sortie du four ajouter au pinceau du sirop d''érable puis saupoudrer de sucre glace. ', '2013-11-22T12:08:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, d2cf7a3a-b48a-4b04-ad82-c1f5d96d93e2, 'Je le recommande, il est délicieux.', '2022-09-24T10:40:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 7e358143-398c-4dd1-8f79-7559e5e22aba, 'Je l''ai fait avec des pommes bicolores et moins de cannelle. Délicieux, facile à faire et donc parfait !', '2021-12-18T15:52:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 5bede0dd-a6f6-464f-b403-ba9169b5ed08, 'Un délice ! Fait avec des poires. A peine 30 minutes de cuisson et il est parfait fondant au centre...', '2020-10-03T01:20:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, fae5135e-6bb6-4096-81e8-8ebb97573b61, 'Très bonne recette ... Je recommande fortement 🤪', '2023-10-16T13:30:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, d16553e7-980a-4b06-aaca-49c52d84ab30, 'Très bon ! Bon équilibre rhum/pomme/cannelle/chocolat. Je le referai très vite !', '2023-09-24T21:32:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 6cb9a7d1-ed0f-439a-9dda-bb97b709b448, 'Super 👍', '2023-06-03T18:08:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 6183bf76-ba35-4b20-b78b-4373edfbc1d3, 'Un succès auprès de tout le monde, attention quand même à ne pas abuser sur le sucre et le beurre.', '2022-07-24T13:46:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, ee256ea4-b867-409b-b558-265629c2d4b4, 'Excellent, mis 180g de beurre et de sucre', '2022-05-22T16:21:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 15a6d8a2-09ef-4b90-bbd3-b133bbc38b5e, 'Je le fais régulièrement et il a toujours autant de succès. Je réduis simplement un peu le beurre et le sucre.', '2022-04-02T17:28:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 53006642-ba7e-403d-a863-46cbf7d21231, 'Un vrai délice,  je les ai fait en muffins. Tout le monde s''est régalé. À refaire sans hésitation ', '2022-03-15T15:38:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, d40ff491-2327-4646-ade4-6d6e3f028dc5, 'Excellent... même avec 30 grammes de beurre en moins.', '2022-03-04T02:14:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 89ee8bce-87e0-4faa-8718-f0b9beb19ee8, 'Ce gâteau est un délice. Je le réalise très souvent sans rien modifier de la recette. Une tuerie ', '2021-05-13T06:15:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 0471b4e6-04c7-48fe-8d9f-25ed1859dd49, 'J ai mis juste 100g de sucre et 75g de beurre c''était délicieux et ça suffisait ???', '2021-02-26T23:27:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 22c18f87-e291-43b6-b888-311921a863db, 'Très bon sans modifier la recette. Parfait et tres facile ', '2021-02-08T20:57:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, e4403b0c-31ab-48b6-a37f-e610b676adba, 'Je l’ai fait un peu moins sucré. 200g sucre. 200g beurre. Mis un petit pot de compote de pommes pour compenser. Résultat très bon! Bravo.', '2020-10-11T20:11:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 4b1ff671-e976-4273-a44d-a3cc2e57f06b, 'Trop bon !  !', '2020-04-24T16:51:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 0fb6c743-cadd-48af-a7a5-437222d1f13e, 'Très très bon ! A refaire sans hésiter.', '2018-11-29T20:18:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 5ed8182f-d5fc-4afe-b621-fb305f8d51a2, 'Une tuerie dont on me demande régulièrement la recette. 
Je met une tablette de chocolat à pâtisserie en morceaux, seulement 2 pommes, c’est suffisant, et moins de sucre aussi. 
Pour la cuisson ce qui est indiqué est trop léger.', '2018-03-03T04:25:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, fbbd154d-220d-48b2-870d-e3207487b5f1, 'J''ai suivi la recette, mais pour 2 personnes, c''est une réussite et un régal, moelleux je le referai !', '2017-12-16T18:11:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 427a9b73-1a6b-4aaf-8b71-9bf273f77dae, 'Facile et surtout excellent.', '2017-10-07T21:32:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 4583666c-2405-4aad-b6ec-19e02d97b78c, 'Excellent.', '2017-03-15T20:27:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, d592ab61-40e7-4160-b93f-18ab152052dd, 'Très bon gâteau, j''ai utilisé des pépites de chocolat et la cuisson 3/5min à 180°C.', '2017-01-23T21:27:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 687efa23-b490-4952-8f28-dd449eddc87f, 'Recette délicieuse et moins lourde que ce qu''il n''y parait. Par contre peut être est-ce mon four qui vieilli mais j''ai due faire cuire presque 1h. Petite touche perso déco j''ai ajouté dessus des amandes effilées avant cuisson ;)', '2015-01-24T16:20:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 170aa129-8e42-4523-b79d-4c3c58bc297d, 'Et hop, une fois encore, je refais ce gâteau qui plait à chaque fois. Ma variante :  - 200 g de beurre - 200 g de sucre - Pommes : je préfère les boskoop ou les canada plus fruitées et bien meilleures en goût - 100 à 125 g de noisettes - 2 cuillères à soupe de cannelle moulue Le chocolat peut être en pépite ou même fondu dans l''appareil. Bref, quelle que soit la variante, ce dessert est toujours une réussite. Merci.', '2011-12-03T10:31:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 0c871280-bc77-467c-8df6-407029f976ce, 'Très bonne base de recette que j''ai arrangé à ma façon en réduisant la quantité de beurre (175 g), de sucre (175 g) et de rhum (1 cuillère à soupe). J''ai remplacé les pommes en morceaux par des pommes râpées et les noisettes moulues par des noisettes concassées. Un régal!', '2011-03-05T11:44:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 49322a44-b3b1-4b7a-879a-f1836f8291b1, 'Très bon gâteau. J''ai mis seulement 150 g de beurre. La cuisson s''est avérée assez longue : au moins une heure à 175°C chaleur tournante, mais il est délicat de ne pas brûler la surface.', '2011-01-01T13:20:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 5840fd31-40e2-455f-9771-7de4c24efcf8, 'Très bon gâteau, je l''ai fait plein de fois en grand et même en petit façon muffin, merci énormément pour cette recette !!', '2010-09-02T00:11:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 3b7b2695-a45f-498f-acf1-f88d0277bfdb, 'Très bon gâteau ! Je ne mets que la moitié du beurre et la recette reste excellente... Merci', '2010-07-27T13:44:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, c9ba07f5-40dc-4d73-921e-b1b873015fa7, 'Gâteau délicieux avec ses différents composant qui le rendent fondant avec la bonne quantité de beurre. Bien apprécié, il est consistant et moelleux, ajouté d''un parfum pour une meilleure saveur. Merci pour cette bonne recette !', '2009-11-12T10:46:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 6525c692-a153-4127-9223-95a628cde75c, 'Dé-li-cieux !! A faire et refaire. Les différentes saveurs sont difficiles à définir et rendent ce gâteau intéressant.', '2009-03-22T23:10:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, afe89728-db5e-4651-86e3-900ae61b7336, 'C''est délicieux ! Ma variante : 180 g de sucre, 200 g de beurre, 4 pommes et surtout... 100 g de chocolat au lait ! Délicieux, très aérien... à refaire très vite !', '2008-10-26T18:31:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 59728d13-5c77-4a21-beaf-fca263d74c33, 'Très bon!!! J''ai mis du whisky à la place du rhum car je n''en avais plus. Petits et grands ont adoré. Recette à refaire absolument.', '2008-04-26T17:24:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, f9a77165-e74b-432d-a2cc-79d955651c10, 'Gâteau énorme! Calorique mais très bon et moelleux, un peu moins de beurre serait recommandé.', '2006-03-17T18:56:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, a964ecde-4e3e-44a3-ace9-93a1d0b23be7, 'Dessert assez bourratif, mais servi avec une crème anglaise c’est excellent!', '2005-04-10T14:44:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36022, 798a3fdb-4265-495e-9f31-a809a1c874b2, 'Excellent. Je n''ai mis  que 200 g de beurre et 200 g de sucre, et 1 cuillère à soupe de rhum. C''était très bien, très moelleux. Tout le monde a apprécié!!', '2005-04-05T00:53:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, e12c941c-63b6-4469-8d1d-a04728f088b0, 'Très beau gâteau et aussi très bon. ', '2016-02-11T20:52:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, 471180b3-efc9-48bd-bfcf-30dc661aa7a7, 'Super recette, la Charlotte est délicieuse à refaire encore et encore !', '2015-05-17T10:11:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, 8a9357bc-d434-4824-a4cd-7be9652f31ab, 'J''en suis à ma troisième (une crème de marron + mousse au chocolat poire, une framboise + bavaroise framboise et celle-ci donc mais avec une confiture d''orange amère). A chaque fois une réussite : belle présentation, bonne tenue à la découpe et bon goût. mes observations : 1)Il me faut bien plus de 45 min pour tout faire.  2) je pense qu''il est plus opportun de mettre du film alimentaire à la place de l''huile. 3) les deux fois où j''ai la génoise uniquement avec de la farine (pas de fécule) j''ai l''ai trouvée meilleure. Je découpe la génoise en tranches de moins d''un centimètre avec une petite pulvérisation d''un mélange eau+cognac avant la mise en place. 5) Je pense qu''il ne faut pas hésiter à mettre un poids sur une semelle en carton sur le fond du gâteau. 6) la recette à la mousse au chocolat, poire et crème de marron de ce même site me semble plus explicite. ', '2015-02-08T19:56:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, 0fa83aeb-5b8c-4872-9d2e-eb0ebc191e58, 'Assez déçus du résultat malgré tous les avis qu''on avait vu avant... Effectivement le gâteau est épatant visuellement mais très déçus du gâteau en terme de saveurs. Le gâteau est très lourd avec toute cette génoise et s''écroule dès qu''on le coupe (horrible à servir dans l''assiette !!). Je pense que je le referai mais pas sous ce format là mais plutôt dans un moule à manquer ou moule à tarte avec génoise/confiture dessous (tranches très fines), biscuits rose de Reims sur les côtés, crème au milieu et fruits frais sur tout le dessus. Dans le format présenté, il faudrait sinon réduire la taille des tranches de génoise (au mois de la moitié) et en faire beaucoup moins, éventuellement l''imbiber du jus des fraises, beaucoup plus de crème en y incorporant des fruits.  J''ai également tenté le format individuel dans des verres et avec des framboises (cf photo) mais beaucoup trop lourd aussi... Il faut vraiment réduire la génoise et rajouter beaucoup plus de fruits frais dans la crème.', '2014-05-25T19:52:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, 5699259a-2f1c-43d0-9fe0-9ac5d546978d, 'Beau et très bon. Frais et léger.', '2014-03-16T20:22:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, e0cb88e7-5d53-4221-86dc-db5392bd4100, 'Très bonne idée de dessert ! Frais et savoureux. En gardant les mêmes saveurs : bavarois coco, biscuit puncher citron et roulé confiture fraise', '2013-10-27T23:50:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, c52e1fa2-9f64-40c5-b128-8d9e47dbf54b, 'Très bon dessert qui a été apprécié de tout le monde, jolie présentation, digne tout droit sorti de chez le pâtissier. Pour ma part, assez de sucre, merci pour cette recette.', '2013-05-09T18:10:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, a8e3e121-7809-441f-a2fe-4d81b4206407, 'Très jolie présentation, mes amis ont aussi cru que ce gâteau venait de chez le pâtissier. Très bon aussi. J''ai ajouté du sucre dans la crème. A refaire, il a eu beaucoup de succès !', '2012-06-04T00:58:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, bc10ded9-1c9a-4ed4-8fba-0a547b441755, 'J''ai bien aimé ! Petite suggestion : mettre de fines lamelles de fraise sur le biscuit avec la confiture, pour donner encore plus de fraîcheur.', '2012-02-01T02:13:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, 5a34ecc5-b575-4e08-a9ea-6e367c7694a2, 'Délicieux - très belle présentation. Il faut effectivement remettre un peu de sucre à la préparation.', '2011-07-17T19:46:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, 8f0ed7bd-e09a-40e2-b004-3ed3731c2a79, 'Très bon, très joli. La crème manque un peu de sucre, je vais la recommencer.', '2011-06-24T19:23:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, 058816a3-4486-4de3-bfc6-959580603c4b, 'J''ai épaté mes convives avec la présentation de ce gâteau. J''ajouterai un peu de sucre à la crème liquide avant de la battre. Sinon rien à dire très beau et très bon.', '2011-05-10T17:54:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, 50746499-d02d-48b0-9a2d-12f45a8b364f, '5 parce que c''est le maximum ! Vraiment bluffant, tous ceux à qui je l''ai faite m''ont dit que c''était digne d''un pâtissier... Un peu long mais ça vaut vraiment le coup, c''est magnifique, pas trop sucré, délicieux. J''ai décoré avec des fraises et des copeaux de chocolat blanc et... wahouuuu !!!', '2010-08-23T21:14:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, 65149a15-06cd-46e7-a149-0de1c416d3fa, 'Je tire mon chapeau pour les explications et la présentation de ce gâteau. J''ai juste été un peu déçue par les saveurs - pour moi le goût de noix de coco est trop prononcé, c''est un petit peu lourd. Mais il a tout de même été apprécié par mes invités. ', '2009-07-25T23:26:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, f24e762d-a9bd-492d-8c43-22e56a73ae09, 'Superbe ! Visuellement, la charlotte est magnifique et a fait beaucoup d''effet à mes invités. Au niveau du goût, c''est très léger et pas trop sucré. Personnellement, j''ai ajouté des fraises dans la mousse. Pour le biscuit roulé et les biscuits rose, je les imbibe d''un mélange eau et kirsch. ', '2009-04-24T12:48:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, f0a20387-975f-4c01-baa6-e02ff1faace1, 'Recette très bonne. En plus très légère. A la place de la crème à monter en chantilly, j''ai pris une bouteille de chantilly toute prête et à la place de huiler le plat pour faire la composition de la charlotte, mettre du film étirable à la place. Bonne dégustation.', '2009-01-16T16:22:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, 014bdc16-0574-4fa0-b103-bb2fe7d5d743, 'J''ai fait ce gâteau pour un anniversaire avec une déco avec des fraises, des fleurs et feuilles en pâte d''amandes (achat supermarché) et chantilly. Le gâteau était vraiment très beau et vraiment très bon aussi. Bonne recette. Tout le monde a adoré, moi j''ai rien changé à la recette elle est parfaite comme cela.', '2008-12-01T13:10:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, 810baee2-2640-459f-a984-b5e7f240051a, 'Excellent! Très léger et peu sucré, idéal après un bon repas ! J''ai trempé mon biscuit roulé dans du sirop de citron car je n''aime pas l''alcool. Par contre j''ai eu assez d''un seul biscuit roulé pour un moule de 22 cm, mais pas assez de mousse, enfin il en manquait un tout petit peu... Merci pour cette recette.', '2008-05-30T20:06:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, c5cca674-da5d-48bf-b36c-d68965e734b8, 'Pas trop difficile à faire et vraiment exquis! Pour un anniversaire, c''est parfait. Tout le monde a adoré, et en plus, c''est un beau gâteau. Merci.', '2007-11-14T17:05:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, 093acf5d-398c-41a0-b408-623afc0596c2, 'Simplissime et rapide à faire et le résultat est impressionnant. Je n''ai pas mis les zestes mais on ne sentait plus le citron vert! J''ai rajouté un peu de crème chantilly pour le décor... Bluffant!', '2007-06-23T20:54:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34873, c0f279fc-a029-4293-b869-83b05f7224e5, 'Facile à réaliser. De l''avis de mes invités : excellente. Cependant on me conseille de supprimer le zeste de citron qui couvre le goût de la noix de coco. A refaire sans hésiter.', '2006-07-19T07:13:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, a6cf30bc-7dab-4d71-80be-4a22259b2cb5, 'Vraiment très bon et très facile à faire. ☺', '2019-10-26T20:28:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 28dc7792-ac7d-465b-a547-ca9b001dc1f4, 'Très belle recette réalisée pour l anniversaire de la fille. Le coulis mangue/passion se trouve chez picard. J''ai fait une autre génoise avec des amandes trouvée sur le site eryn et sa folle cuisine. Et j''ai terminé par un miroir mangue/passion ! Merci du partage !', '2018-03-10T18:57:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, a4bb888c-a381-4f41-92ae-4694ffd2c0a9, 'C''est divin !!! Les mousses se tiennent et sont délicieuses mais je n''ai pas fait cette recette-la de génoise mais une autre de marmiton. J''ai mis un seul blanc d''oeuf en neige pour les 2 mousses et elles étaient bien aérées.  Je n''ai que 13 ans et pourtant c''était extra et je n''ai eu que des compliments. A refaire ! ', '2016-07-31T02:17:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, cd07c435-82a7-4c66-b83e-5a4be1ee3959, 'Comment réaliser un dessert simple en ayant l''air d''un pro !', '2015-12-30T09:08:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 6544dce1-a724-4556-9d03-ee0bcce88bf1, 'Super recette ! Pour un moule à manquer de 26cm doubler la dose pour les mousses. Pour la finition, j''ai rajouté de l''eau pour que la gelée soit plus liquide du coup pas besoin de se prendre la tête à étaler et le résultat est nickel.', '2014-05-11T21:24:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, b39d526e-3d33-4987-9999-14534f4b1661, 'Très bien. Simple à faire même si un peu long car j''ai fais les coulis "maison". J''ai utilisé la recette Marmiton "la génoise ultra rapide" car c''est celle que j''utilise toujours désormais. Pour le coulis mangue passion j''ai mis 2 pots de compote mangue passion + 1 yaourt et j''ai mixé le tout pour obtenir un coulis impeccable. J''ai glacé le dessus avec un peu de coulis de framboises auquel j''ai ajouté de l''agar-agar pour l''effet miroir. Je referai ce dessert qui est très léger et très frais.', '2011-07-28T11:37:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 11a2d978-f366-4aac-90d3-7a079a03512e, 'Les mousses sont aérées, légères et très peu sucrées, facile à réaliser mais qui demande du temps si on fait soi-même les coulis.', '2022-12-23T17:02:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 4ce801bb-135b-4795-917a-89edde31ac16, 'Délicieux ', '2021-01-07T21:20:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 68cd30ec-14e4-42ad-bb17-cc2f0fb454e5, 'Délicieux et très léger', '2019-08-08T18:48:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 8b60fbb2-885f-45cf-a328-8aab3acc4aa2, 'J''ai fait  cette recette ce week-end, super bon, à refaire, très réussi', '2019-06-09T12:07:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 789ecc09-8d94-4669-b30c-33f1740861f7, 'Cette recette est très simple et assez rapide elle est très bonne et très légère, elle donne un résultat très joli et très satisfaisant: J''adore', '2018-12-30T18:10:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 94da545f-1877-49ca-80b5-a19f662398ba, 'Super top la recette rien à dire. Premier essai et bien réussi. Effectivement léger, peu sucré, j’adore et mes convives aussi ont adoré. Merci.', '2018-07-29T13:10:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, b5fc7902-db12-4696-9be0-eff1278a689e, 'Super recette, facile et très bonne ! ', '2017-03-26T15:35:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 4e455629-241e-4df7-a54c-9d9af622e650, 'Super bon et pas trop sucré !', '2016-12-31T17:27:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, b4293532-3346-4b16-89a2-138490c02a18, 'Très Bon en petite part, mais vite écœurant. Je tenterais avec un peu moins de crème je pense. Attention, j''ai attendu "que cela refroidisse" comme demandé pour le coulis. Malheureusement mon coulis s''est figé avant que je le mélange avec la crème ! Plus qu''à recommencer...', '2016-11-14T15:15:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 1fbaf497-0743-44ab-8ef1-601871f84547, 'Merci pour ce gâteau, j’ai un anniversaire de prévu, je vais épater mes invités. Votre cuisinière qui nous fait voir ces bonnes recettes en vidéo elle est au top et très agréable. Bonne soirée, et merci encore pour ces bonnes choses.', '2016-08-16T19:09:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, c8be4e20-86cd-473d-b592-ffd7ae4f1e36, 'Génial. Les mousses sont excellentes, elles tiennent parfaitement, la recette est parfaite. Succès garanti à table.', '2016-06-01T16:16:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, f36d5b4a-df98-4cd4-8a32-1afe140b2634, 'Très très bon vraiment et facile à réaliser léger et frais termine parfaitement un repas familiale.', '2016-05-07T15:08:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 1049b910-72ef-4f2b-9206-dc7b2f79fe72, 'Gâteau qui prend un peu de temps mais qui ne présente pas de difficultés et qui en jette vraiment. Je l''ai réalisé avec un coulis framboise et abricot et en ajoutant comme conseillé un blanc en neige dans chaque mousse.', '2016-04-30T11:34:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, dd473037-ba11-444c-a605-bab6991dffba, 'Au top', '2016-02-26T14:29:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, c88d6fab-477f-47e9-bfb4-47fa45845ec8, 'Top la recette !! Je n''ai pas trouvé de coulis de fruits de la passion alors j''ai remplacé par une chantilly (crème liquide montée en neige avec du sucre vanillé) avec des morceaux de fraises que j''ai mis au dernier étage juste avant le miroir. Ensuite j''ai utilisé la même crème chantilly pour les bords. Un régal!!', '2015-12-06T21:15:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, e1bfc27c-5ade-4b35-89ba-b4e2ffe4be78, 'Très très bon mais il s''est un peu cassé la figure. Attention, ajouter plus de gélatine ', '2015-10-23T17:18:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 5a9c963d-cfc4-42ab-8614-fc7d870ee49d, 'Génial ! Je n''avais pas de coulis de fruits de la passion, donc j''ai fait à la place une mousse au chocolat, et j''ai ajouté un blanc d''oeuf dans la mousse de framboise (d''après de nombreux commentaires). Le résultat est parfait, c''est délicieux et super beau ! ', '2015-05-24T16:00:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 72dbb74f-ebd7-424c-a5e7-d017e7ad1671, 'Un délice léger bienvenue en fin de (gros) repas ! Tout le monde pensait que je l’avais pris à la boulangerie !', '2015-04-06T20:10:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, fc13a413-86a2-469b-a6cf-3869b8062507, 'Très bon. Fait avec du coulis de framboises et du coulis d''abricot/mangue. Les mousses se tiennent très bien. Pas besoin de blanc d''oeuf pour ma part. A refaire sans hésitation et à décliner avec pleins de parfums différents. ', '2015-02-02T12:31:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 4ec2b593-3269-4abd-8fad-d2a1385ba005, 'Après deux essais, j''ai fait ce dessert pour Noël. Succès garanti ! J''ai rajouté un blanc d''œuf par mousse comme conseillé. J''ai fait des ronds individuels à l''aide de ruban pvc ! ', '2014-12-26T14:15:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 0ce01db2-7df4-4b6a-b031-386a1f421394, 'Top ! J''ai suivi la recette à la lettre. Le résultat envoie du rêve aux convives ! Léger et facile à réaliser ! J''ai juste un peu rater le glaçage...', '2014-11-24T00:06:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 4468b04b-f6d0-4e86-8076-6b3254a1659d, 'Superbe recette, ne rien changer.', '2014-10-19T18:27:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 73e70c2f-78af-42de-84c4-a202592a2a30, 'Excellent très simple à faire, comme certains j''ai ajouté un blanc d''œuf en neige dans chaque mousse. Pour compléter le flacon de coulis de mangue passion, j''ai mixé des mangues en conserve.', '2014-09-22T19:58:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, b9396583-8247-4eee-b0a4-6a30639903d3, 'Superbe ! J''ai testé la recette pour la 1ère fois, un régal, pourtant je ne suis pas fan des gâteaux. Mais là il est léger et frais, on ne m''a fait que des compliments ! Et ça prend un peu de temps à préparer mais c''est simple à faire. Petit bémol, les deux couches de mousse fruits n''étaient pas bien séparées dans mon gâteau, la prochaine fois je laisserai plus longtemps mes mousses au frigo avant de le dresser !', '2014-08-25T14:01:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 2557618e-5598-4caf-930f-72bde8d2e966, 'Super recette.', '2014-06-29T06:15:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 2afb307b-b7de-4c49-a624-5c5293484c63, 'Très bon, frais et assez facile à réaliser.', '2014-05-08T17:58:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 1db81e41-3335-429f-8e2c-4666c224a02e, 'Beau et très bon. Léger et pas trop sucré. ', '2014-03-16T20:15:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, e63a6eda-4fb1-4916-ba54-deea9bc35b4b, 'J''ai fait ce gâteau pour la fêtes des grands mères. J''ai acheté du coulis de framboise et mangue passion, j''ai mis 3 feuilles de gélatine et j''ai ajouté un disque de génoise au dessus de la 2eme couche de mousse pour "casser" le côté mousse. Le résultat était super bon, pas trop sucré pas trop lourd, niveau visuel top. Ma famille n''en revenait pas et ma mère a qui j''ai envoyé la photo ne croyait pas que je l''avais fait moi. Je referai cette recette sans soucis. Un de mes desserts préférés. ', '2014-03-04T16:25:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, a37cd913-d907-4045-bc63-b36cda6ad80d, 'Excellent ! J''ai également ajouté un blanc en neige par entremets. Par contre, je trouve que la framboise prend le dessus sur la passion. Recette de base parfaite à décliner avec d''autres coulis.', '2014-01-11T22:37:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 472d5726-a6e4-446f-835f-f81027f0529e, 'Belle recette bien expliquée. Je l''ai faite avec une seule couche de mousse en cuisant la génoise directement dans le plat. Grand succès. Merci !', '2014-01-01T20:18:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, c1ac9649-366b-421b-851e-1b6f2186f741, 'Délicieux je dois la refaire pour le jour de l''an. Moi j''ai utilisé un moule rectangulaire et franchement parfaite :-)', '2013-12-27T09:54:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 33e62683-e31e-4fc7-91cd-1375890c0126, 'Merci pour cette recette, elle porte bien son nom, on s''est régalé, à refaire', '2013-11-19T18:54:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 39c34397-a5a0-4628-a88f-88540d896ed2, 'Digne de mes 40 ans ! En doublant les proportions de la génoise et des mousses de fruit, j''ai pu dans un cercle à dessert ouvert à 23cm de diamètre faire un dessert pour 16 personnes. Pas mal hein ! ', '2013-11-18T15:58:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 6ce0a656-0c83-40a4-a879-832267da439e, 'Facile à faire et bon effet à table ! Je referai ! D''ailleurs j''ai même mis une photo de mon gâteau (celui avec les roses une blanche, une rose avec feuilles verte). ', '2013-11-10T22:51:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 0eecf396-97cb-46ec-84e8-11504440f665, 'J''adore c''est trop bon, à refaire', '2013-10-16T02:01:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 16a6276e-2037-415f-b76d-471a523126dd, 'Bluffant et facile à réaliser en utilisant un moule à charnière et surtout en laissant bien refroidir les coulis avant de les mélanger à la crème et de les laisser prendre environ deux heures au frigo avant le montage, voir avant de mettre la crème framboises au dessus de celle à la mangue. En décor des roses en pâte d''amande maison, des framboises fraîches et des fraises tagada autour sur le plat. Sur la tranche j''ai collé des patiences roses et mauves en alternance (sorte de demi macarons) et effectivement mes invités ont cru que le gâteau venait de chez le pâtissier !', '2013-08-28T02:15:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, dcc77ad6-cddd-41c7-947f-7c7f53070788, 'Très facile à faire. Pour ma part, en guise de décor j''ai fait une couronne de framboise sur le dessus. Un régal.  J''ai également coupé la génoise pour en mettre entre les deux mousses.  De plus je ne l''ai pas fait, mais la prochaine fois je mettrai deux feuilles de menthes ciselées dans la mousse de framboise.', '2013-08-22T23:02:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 1346c23d-1f6f-48ce-b2a2-09a36188cc2d, 'Un peu long à préparer. Il faut commencer la veille... Mais ça vaut largement le coup ! On a suivi les autres commentaires et on a rajouté un blanc en neige dans chacune des mousses. Glaçage avec de la confiture de cerise maison et décoré avec des copeaux de chocolat blanc. Très frais et léger en fin de repas, avec une boule de sorbet mangue. Bonne quantité pour 8 personnes.', '2013-07-21T12:19:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, d17a8e97-0b40-4ea3-b9c6-0144c234f289, 'Un des meilleurs desserts jamais testés sur Marmiton. Simple à faire, léger dans le goût, parfait pour une fin de repas copieux. ', '2013-05-06T10:58:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, bcd83387-4f3f-4ecc-b5ff-ab24057662d8, 'Merci pour cette recette. Je n''ai fait que la génoise et mousse de framboises avec pleins de framboise dessus : ça fait pro et c''est très bon. A essayer tout de suite.', '2013-04-20T20:09:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 4049495e-d3ed-4a14-b7c1-5a9d1573ef1c, 'Un délice ! Recette suivie à la lettre résultat aussi beau que bon !!', '2013-02-10T23:59:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 72a8c846-6a93-46d9-9e1a-15a28ec7bfc2, 'Tout simplement génial !', '2013-01-20T20:39:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, ae5b6020-94c0-4bca-b79c-b4bcd754e265, 'Un délice ', '2013-01-06T19:59:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 6907dd36-797f-4776-86f8-6ca61786fed9, 'Quel succès avec cette recette !!! Merci ', '2012-09-02T20:57:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 8e893014-9535-4cd8-ac2b-180cbd5b74b1, 'Un très bon dessert, facile à faire et qui peut vraiment faire très "élaboré". Je n''ai utilisé que du coulis de framboise et je n''ai pas fait de décor; malgré ça c''était tout de même très bon et très joli.', '2012-04-14T12:34:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, cf545f13-074d-42ed-bbd2-da5354258253, 'Un chef d''œuvre !!! Une des 2 meilleures recettes de ma vie ! Mes invités ont adoré et grâce à ça, je vais pouvoir faire un stage de cuisine dans un restaurant ! J''ai juste mis de l''abricot à la place des fruits de la passion, excellent quand même !', '2012-03-18T12:06:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, f591b501-3f2f-47e6-a01a-f05d9b6d63a5, 'Un dessert digne d''une pâtisserie. Recette parfaite, rien à modifier ! Merci', '2011-08-26T22:47:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, e56fe502-0522-495e-98fc-997e3d439406, 'Parfait, rien à changer ! Frais et léger. Super dessert d''été ! Merci beaucoup.', '2011-08-21T00:18:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, a87580a4-8823-4db4-95a1-4deccfca3d7b, 'Une explosion de saveurs et de fraîcheur pour ce magnifique dessert très simple à réaliser. Faute de coulis, j''ai utilisé du sorbet mangue-passion, 2 feuilles de gélatine et un blanc d''œuf en neige par mousse. J''ai décoré le tout avec des copeaux de chocolat blanc et des minis macarons faits maison. Merci pour cette recette, c''était parfait.', '2011-04-12T15:41:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, b23178a2-3b53-42ef-af82-fe417f037805, 'J''ai fait ce dessert pour Noël et il a été très apprécié. N''ayant pas trouvé de coulis de fruits de la passion, j''ai acheté un sachet de mangues congelées coupées en tranches. J''en ai mis deux de côté, et mixé les autres avec 50g de sucre roux. Puis j''ai coupé en petits morceaux les deux tranches que j''avais gardées avant de les incorporer dans la mousse. Bien sûr il faut attendre que la 1ère couche prenne avant de mettre la seconde. J''ai aussi mis des copeaux de chocolat blanc dans la mousse framboise. Résultat, un gâteau un peu long à faire, mais très facile et délicieux. Il est très beau à voir et fait son petit effet, surtout si on fait la rose en pâte d''amande. Et surtout, il est très léger, donc parfait pour finir un repas copieux, comme souvent pendant les fêtes !', '2011-01-01T21:38:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 2b32ba60-b3b7-474a-a262-a2d47c2c8fa4, 'Délicieux ! recette très claire et bien expliquée.  ', '2010-12-25T23:40:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 0d4e0b54-2110-4c24-8381-096babbcf78b, 'Très bon, j''ai juste remplacé le glaçage en fin de recette par 4 fines crêpes qui tapissent le gâteau, la sensation sucrée est moins forte... A refaire.  ', '2010-12-19T14:05:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 4a3e690d-1390-47fc-9bc0-baf0971c1fe3, 'La génoise, parfaite. 1ère mousse faite avec fruits exotiques (pas assez solide), la 2ème mousse aux framboises trop liquide, j''ai donc ajouté une feuille de gélatine et devenue trop lourde, la framboise est tombée dans la 1ère mousse, c''était pas présentable, j''ai donc fait une mousse chocolat pour recouvrir et cacher cette horreur, quand j''ai démoulé, tout s''est écroulé, ça ressemblait à du bloubiboulga, impossible à servir. OK le mélange fruit exotique/framboise/chocolat noir, faut aimer mais je n''en serais pas arrivée là si la recette avait fonctionné. Fou rire au démoulage et grimace à la dégustation. Mais peut-être est ce de ma faute. Au vu des autres commentaires, je recommencerais quand même avec d''autres goûts et sans y mettre mon grain de sel.', '2010-11-11T20:06:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34156, 2c5a74ff-3d0e-4c81-bb52-04145b94c42e, 'UN VRAI DELICE! super bon, je l''ai fais avec du chocolat blanc et des framboise, trop bon. c''est vrai que cela en jette!!! il est beau, il est facile à réaliser quoique un peu long, mais cela en vaut la peine. j''ai hâte de le réaliser avec d''autres parfums. je le conseille à ceux qui veulent faire un dessert qui en mette plein la vue!', '2010-11-07T00:10:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 3cc934f9-2f9b-4187-b685-5848938a70d0, 'J''ai trouvé ça super bon et je l''ai coupée au couteau électrique, ça va tout seul (vraiment chapeau!!!)', '2008-09-22T21:24:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 97a0000d-6d1f-426d-ba8b-8dca5ba8b71f, 'Super bon ', '2022-04-18T20:57:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 551f4c0a-440a-4f19-b3f2-fe037395a433, 'Fait sous forme de tarte, c''est aussi simple que bon !', '2015-11-20T15:20:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 08131ca8-3fb3-40c2-a0f3-d0c832fa28c4, 'Délicieux :)', '2015-03-26T20:13:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 4de70b9c-40a7-431c-8007-f719ae3839ec, 'Rien à dire, ce dessert est excellent ! Je pense que 2 niveaux c''est suffisant par contre il ne faut plus que 660 ml de crème pâtissière, et 2 barquettes de fraises. ', '2013-08-01T19:29:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 6dd3a624-59c9-4670-8c0c-60d97a159cf0, 'Super bon !', '2013-02-12T18:31:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, eba4467c-6e29-4de5-a2e2-41b6984512c9, 'Excellent, mais 2 pâtes suffisent si on utilise les chutes pour le milieu.', '2012-07-28T18:21:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, c9ca3a31-2de2-466b-91c3-be1da72c0e07, 'Effectivement, 2 épaisseurs suffisent et le couteau électrique fait des miracles ! J''ai alterné les fraises et les framboises, et j''ai remplacé le glaçage par une crème fouettée décorée de fraises et framboises. Dessert plébiscité par les gourmands !', '2010-07-01T23:31:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 39c4144d-47c0-4300-aeb5-45d0c5b0f10a, 'C''est en effet facile et très bon, mais par contre, 3 étages c''est trop. Deux suffisent. Il faut couper les fraises assez épaisses sinon on ne sent pas assez leur goût. La pâte doit être très très fine car même en la piquant bien, elle gonfle et nourrit un peu trop. La présentation fait beaucoup d''effet(j''ai coupé avant de cuire la pâte en portion individuelle).', '2009-02-15T16:37:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 6c1ed71d-d011-4010-90b9-735971ffd8f2, 'Délicieux! Je l''ai fait avec 2 pâtes feuilletées (mais 3 étages) (c''est bien suffisant pour 4 personnes) puis remplacé le sucre glace par le glaçage. Je le referai avec plaisir !', '2008-06-29T22:57:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 97a182f1-9294-436b-adae-cba6d12abcfc, 'Trop trop bien ce dessert! Super facile, super beau, super bon! Merci les marmitons, ma famille s''est régalée.', '2008-06-15T21:44:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, c6552b5e-9450-4df7-87c3-44b2385c8bc9, 'Il est vrai que cette recette est super facile à faire et en jette au niveau présentation, j''ai terminé la décoration par des fraises coupées par moitié, des roses et feuilles fait en pâte d''amande, et entre les fraises un peu de vermicelle au chocolat, çà à fait le plus grand effet pour le gâteau de fêtes des mères.', '2008-05-25T15:17:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 254229b2-cd24-462d-8e35-b406d2591a44, 'Très bonne recette et facile à faire. J''ai juste rajouté un peu plus de crème pâtissière. A refaire sans modération, toute la famille à adoré.', '2008-05-07T18:05:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, fc28063a-b651-4121-8789-3586ab62e50c, 'Très facile et très bon. A refaire!', '2008-03-31T00:04:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, a48298ac-9cd8-4bd4-8e8e-e2539fcff051, 'Un délice! je l''ai fait avec des framboises. pour le dessus, un glacage au sucre avec quelques framboises tout autour... du plus bel effet!', '2007-08-12T02:46:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, df499b25-19f2-41a5-8bc6-96e442e1cd45, 'Pour faciliter la découpe et ne pas trop "écraser" le gâteau, utiliser un couteau électrique, le résultat est super : très bon et très beau.', '2007-05-01T22:52:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 5dd9b969-4f5b-433d-aa1f-dfdb5f7c2c17, 'Très simple et excellent. Coulis/sirop maison avec 5 grosses fraises, eau et sucre glace. Présentation digne du pâtissier. A faire et refaire.', '2007-04-16T13:04:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 83e679b9-970a-4a9b-8425-8acbc09a5e10, 'Original mais il faut y passer du temps! J''ai rajouté du sucre glace et javoue qu''une pointe de chantilly n''aurait pas été de refus!!', '2007-03-14T01:02:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 5ae99602-6ae5-4da2-8a13-04245cc62707, 'Absolument délicieux! Frais et léger, je l''ai fait avec des fraises cet été et avec des abricots au sirop (bien égouttés) cet hiver. J''ai suivi les conseils et fait des mille-feuilles individuels.', '2007-01-15T13:40:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 74c98bb0-43b6-4ae0-b44f-c69f8798c9a5, 'Du plus bel effet et très simple à réaliser. Par contre je me permet de donner la recette de la creme patissiere pour les novices : 1 l de lait entier, vanille, 120g farine, 150g de sucre 2 oeufs et 4 jaunes. Faire bouillir le lait vanillé, mélanger les autres ingrédients les rajouter au lait chaud et remuer sur feu doux jusqu''à épaississement. Pour le décor j''ai juste saupoudré de sucre glace et mis des 1/2 fraises tout autour, un régal !', '2006-06-13T17:26:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 314a0657-2d52-4382-a9d3-fe236e7d238f, 'Je n''ai pas fait de glaçage mais je l''ai remplaçé par de la confiture à la fraise. Un régal! Et en plus, c''est super beau!', '2006-06-07T16:00:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 0002cee7-26e4-4e57-94ed-08071dc287b5, 'Pour une débutante comme moi, c''était réussi et j''ai eu des compliments. Par contre, même en piquant la pâte, il faut bien penser à l''aplatir en cours de cuisson pour qu''elle ne gonfle pas de trop.', '2006-05-31T23:07:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, c2a38f33-6c5c-49dd-b38d-6396ef161c35, 'Ce gâteau est un régal et il est très simple à faire. J''ai bien sûr utilisé une recette de crème patissière de marmiton.  Le seul probleme que j''ai eu a été la déformation des carrés de pâte feuilletée à la cuisson. Quelques bords se sont relevés ce qui a rendu le montage plus difficile. Peut-être n''ai-je pas assez piqué la pâte avant de l''enfourner? En tout cas, je le referais ce mille-feuille!', '2006-05-31T18:44:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, fc8f557a-8da6-4fd1-8394-199dfc327938, 'Miam, c''est excellent! En meme temps, avec autant de bonnes choses dedans, comment faire autrement?', '2006-05-21T22:30:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, f49417f5-434b-4ea9-b429-85df9494366c, 'Très bon. Avant de cuire la pâte, je l''ai découpée en petites portions pour que ce soit plus facile. J''ai fait mon glaçage avec du sucre glace, du jus de fruits et un peu de colorant rouge (facultatif). La crème patissière ne doit quand même pas être trop épaisse, autrement c''est trop difficile à étaler. Le dessert est haut et pas facile à manger, mais c''est tellement bon!', '2006-05-18T16:21:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 1df55507-1995-4ee3-b999-a3bab92ee831, 'Trés bon, facile à réaliser.', '2006-05-05T20:30:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, df6a4fa3-b057-4724-ac85-27beba8c8fc9, 'Parfait; j''ai découpé la pâte en rectangles avant de la cuire pour faire des portions individuelles. Je n''ai mis que 2 couches de pâte, sinon c''est trop haut et difficile à manger. Ce fut un régal pour tout le monde; à refaire tout l''été...', '2006-05-01T17:12:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, de7046ce-eda1-4ced-a843-81c2f35bb347, 'Simple, délicieux et une présentation qui fait son effet. J''en ai fait un aux fraises et un autre aux framboises. Un délice! Merci pour cette recette. ', '2006-04-30T18:13:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 98134edd-a7a5-4a9c-86bb-628327bf8964, 'Recette très facile à réaliser et qui en jette! Par contre, étaler la crème pâtissière lorsqu''elle est tiède. Je re-testerai mais avec des framboises.', '2006-04-26T21:56:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 799c8fd8-dd2f-409f-847c-c33707f347a7, 'Super recette, très facile et excellente!!! J''ai utilisé 3 pâtes feuilletées rondes, prêtes à dérouler et j''ai découpé ce mille-feuille comme un gâteau... Tout le monde a adoré, par contre 500g de fraises me paraît un tout petit minimum : prévoir plutôt au moins 750g...', '2006-04-25T12:54:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 1b25175c-f353-462f-b54c-518732300bef, 'Avec toutes ces super notes, je vais le faire dès que les fraises seront belles dans le commerce! Par contre, comment fait-on le glaçage maison? Merci.', '2006-04-20T16:47:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, b0bc8cf1-9956-473c-93d2-65352b99e163, 'Très bon, coût raisonnable, inratable. J''ai contourné la difficulté du service en prédécoupant la pâte avant la cuisson et en réalisant ainsi des mille-feuilles individuels.', '2006-03-31T20:40:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 139a0388-3a6a-4cd6-9bcd-b611e7293d04, 'Ce dessert était très réussi: très belle présentation qui fait son effet, et très bon en plus. J''ai utilisé 2 pâtes feuilletés rondes et je les ai coupées une fois cuites en carré et utilisé les bouts de découpe pour l''étage du milieu. Avec des recettes comme ça, ça devient facile la pâtisserie!', '2005-06-20T12:45:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, d35284f0-0a93-40fb-85d2-3ca5de12389f, 'Très bon mais il faudrait essayer avec des feuilles de filo, pour que la pâte soit plus fine...', '2005-06-06T17:27:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 7b382d78-0bb2-49cc-82c2-375abb75dd89, 'Aussi bon pour les yeux que pour le palais!', '2005-05-28T21:50:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 5c15e1a9-6588-4e3c-ba3e-0999810629b5, 'Miam, miam: avec une crème pâtissière maison (recette sur marmiton of course), des fraises parfumées, c''est divin! Bon, j''ai acheté les pâtes feuilletées (trop long à faire en ce qui me concerne), mais le résultat est super joli, appétissant et bon. Attention cependant au découpage qui est vraiment galère. Prenez votre mille-feuilles en photo avant !', '2005-05-27T21:31:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 45a98b54-d354-4124-9d30-ef95374bad86, 'Délicieux et si facile à faire qu''il ne faut pas s''en priver. Super beau et bon ce millefeuille. Par contre le découpage ouille!', '2005-04-22T21:01:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 05a0159f-e94c-4d48-9425-d9af5f3ff722, 'Délicieux. J''avais fait MA pâte feuilletée en plus.  Ca a plu à tout le monde! C''est vraiment trop bon. J''en referai!', '2005-04-18T20:15:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, e5109240-f376-4237-a316-fad2cc2cdfec, 'Tout à fait délicieux! Peut se faire de façon light en faisant soi-même la crème pâtissière avec un édulcorant à la place du sucre et du lait écrémé et en remplaçant le glaçage par une déco faite de fraises et feuilles de menthe. Peut dans ce cas servir de dessert si l''on est diabétique (à titre exeptionnel, toutefois).', '2005-04-16T00:02:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, c6ededa7-4384-455d-91a5-edceb4a3d348, 'Vraiment délicieux! Mon mari et mes enfants ont adoré. Pour la déco, j''ai mis quelques fraises découpées et entières. Par contre, je n''ai utilisé que 2 pâtes feuilletées. Après les avoir fait cuire, j''ai découpé les bords ronds pour obtenir un carré. Je me suis servi des découpes pour faires la pâte du milieu.', '2004-05-29T15:26:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, a4646c3d-34f0-42ed-b346-6b11ea26451d, 'Très facile à réaliser, très bon et très frais ! Très belle présentation. Les invités ont adoré !', '2004-05-10T11:25:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 091da989-5ca4-450c-ab09-2e54a7c74627, 'Très bonne recette! Un brin d''originalité dans un repas, avec une superbe présentation qui  résiste tant bien que mal lors de la découpe... Après tout c''est le sort d''un mille-feuilles! Mais le gâteau reste présentable et surtout délicieux!!! Une pâte feuilletée et demie suffit pour faire un mille-feuilles pour 4 personnes.', '2004-04-26T23:19:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, c7592717-f66f-48b2-9b91-4d8322cfb7ce, 'Un régal! Facile et rapide, ce dessert fait un sacré effet auprès des invités.', '2003-07-08T16:23:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17140, 02af1968-11ee-442e-988e-1a27909d72ba, 'C''est très bon.', '2002-08-22T20:59:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84332, 05931144-c467-4373-9466-6d44c4314bb0, 'Un délicieux dessert très gourmand et à la fois très léger.', '2019-12-19T00:51:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84332, 03dfc7af-ed5f-477c-8904-91bcfd2c4efc, 'Bon dessert mais pas besoin de blanc d''oeuf...', '2018-04-12T10:51:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84332, ddfe55f4-68bc-4c4f-b683-c6f5a413d992, 'Bonne recette, très légère, surtout après un bon repas. Chantilly montée au siphon, mes convives ont apprécié. A refaire.', '2015-03-29T19:38:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84332, 82cd1a60-bcca-44f2-aeb7-34606b5a0dc9, 'Très bonne recette. La prochaine fois, je ne mettrais pas de blanc d oeuf, ça ne sert à rien. J''ai rajouté quelques fraises coupées en petits morceaux dans la 2 ème couche de framboises. Bien mettre le spéculoos sur la dernière couche. 2 heures au frigo suffisent si frigo bien froid. ', '2014-05-01T15:00:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84332, 90201307-9aff-486e-978d-61f7f46d398f, 'Ça a fait l''unanimité, très très bon ! J''ai suivi les conseils des internautes : j''ai mis 2 blancs d''oeufs, j''ai mis plus de crème (60cl) mais j''en avais un peu de trop, peut être que 40 cl suffirait. J''ai mis quelques morceaux de fraises sur le dessus. Je l''ai préparé quelques heures à l''avance et ajouté le spéculoos émietté au moment de servir pour garder le croquant. En faisant comme ça, on peut également préparer la veille. Seul petit bémol, il manquait du sucre (peut être parce qu''on met plus de crème) Je l''ai servi dans des coupes à glace avec un spéculoos entier planté dedans. C''est sûr, je le referai !', '2013-07-17T20:38:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84332, cba00cbd-6b18-4abf-8c1d-4953bed2c733, 'Super bon!!! Merci.', '2013-06-15T12:33:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84332, 5a76eacc-4a4b-49ea-a975-197f1a85d0b9, 'Excellent !! ', '2012-09-23T15:32:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84332, 8b53848c-f928-4084-a127-7b083d4fb740, 'Très bonne idée de dessert frais après un repas copieux. ', '2012-01-31T16:05:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84332, 4635b4f7-d48a-4465-93e2-d3325c8de024, 'Très bon dessert par contre je mis de la fraise et 2 blancs d’œuf et un peu plus de crème entière, attention faire des portions pas trop grand cause mascarpone très bourratif, mais quel régale et surtout frais.', '2011-10-13T00:21:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84332, 4f6a1de6-2ba0-48d3-bbfe-efd20dfbf94c, 'C''est très très bon et pas compliqué. Préparer maximum quelques heures à l''avance, sinon les spéculoos deviennent tout mous (éviter de faire la veille).', '2010-03-28T16:13:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84332, 743074b0-2243-4cd6-9f3e-b2d4a0637bdf, 'Bon recette, simple et facile!!! Mousse assez aérienne (j''ai mis 2 blanc d''œuf en neige au lieu d''un seul) et j''ai sucré un peu plus le mélange a base de mascarpone ... très frais, un bon désert d''été ! Je le referai avec des fraise au lieu des framboises car je les préfère !', '2009-05-02T13:25:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84332, cd3660a7-9723-4a78-98bc-d009098d9976, 'C''est trop bon!!!', '2009-03-01T13:49:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84332, 07cdbc5c-f0cd-4323-917d-10c52926944e, 'Personnellement, je ne prépare mes verrines qu''à la toute dernière minute pour y ajouter le crumble de speculoos afin qu''il reste croustillant.', '2009-02-26T18:47:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84332, c1736e1c-4e93-4aa9-a9b8-d10febc87c9d, 'Petite erreur dans la recette concernant la crème liquide entière : il faut 60 cl de crème liquide et pas seulement 1 briquette...', '2009-02-26T18:27:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, f28d0ef5-7310-4fbd-8b1c-26789da744d6, 'Recette réalisée pour les 9 ans de ma fille (préparée la veille), avec beaucoup moins de sucre et beaucoup plus de framboises. J''ai fait 2 gâteaux (moules de 26 cm) au lieu de couper un gâteau dans l''épaisseur. J''ai donc doublé les proportions, mais mis seulement 50 g de sucre en tout pour les deux gâteaux. Avec le pralin et le chocolat, ça me semblait largement assez. J''ai fait la mousse au chocolat avec 6 oeufs et 200 g de chocolat à cuire (à 70%), sans sucre. Et j''ai mis 400 g de framboises (300 au milieu dans la mousse au chocolat, 100 dessus pour la déco). Je n''ai pas mis de nappage au chocolat: avec la bonne épaisseur de mousse au chocolat et les framboises qui dépassaient au bord, c''était super joli et appétissant, alors j''ai juste mis les 100 g de framboises et du sucre-glace pour décorer le dessus.  Résultat: un gâteau énorme (en tout 12 oeufs,  400g de framboises, 400g de chocolat, 200g de pralin, 200g de beurre, 80g de farine, 50g de sucre et un peu de levure), beau, très si', '2015-06-23T00:13:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 4c6de4cb-a528-4257-bdb1-4f05f739d153, 'Recette illisible le 06/02/22. Les ingrédients sont superposés sur les 2 dernières cases. Donc on ne peut lire la quantité de farine et de framboises par exemple. Les étapes: on ne sait pas quelle quantité de chocolat faire fondre avec le beurre: 75g? Ou 100+75g?  Etc… 
', '2022-02-06T10:34:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, bb498b1f-c1be-4b00-bcb6-3b5a99e880a2, 'Excellent . Jai doublé les doses du gâteau pour  qu''il soit haut. Sauf les oeufs jen ai mis 5 et 150 g de sucre. C''était impec. Pas du tout écoeurant ( javais peur) je le referai. ', '2021-01-24T20:41:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, fc0ec799-eda6-4fa3-8eb9-fb56f8d72807, 'Ce gâteau est super. Je dois le faire à chaque anniversaire. ', '2016-11-12T18:03:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 7ba625a7-04d4-4c81-8a91-b795a522ee55, 'Facile à  faire et excellent. C''est un gâteau au yaourt avec du chocolat qui a servi de support à la  mousse. Le goût et la texture sont différents et meilleurs à  mon avis.', '2016-10-08T23:43:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 1f16710d-1e26-456d-859f-384ce30d09a9, 'Super bon gâteau à faire !', '2016-09-25T12:12:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 63329cd4-b91d-4ae4-af3a-5d2bbbd05806, 'Bonne recette, je n''ai fait qu''une génoise, j''aurai dû en faire 3 afin de ne pas couper (trop friable en raison du pralin) et pas assez crémeux à mon gout. il faut faire plus de mousse. ', '2015-02-08T09:15:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 8508fec8-8cfc-43f8-888a-19ff5439242f, 'Super gâteau, on vient de le déguster : une tuerie. J''ai fait trois génoises, le gâteau faisait 22cm. J''ai remplacé les framboises par des fraises, je l''ai laissé 10h au frigo puis je l''ai garni et 2h après on l''a dégusté. Tout le monde a adoré et mon chéri était très content de son gâteau d''anniversaire pour ses 27 ans... Merci pour cette recette.', '2015-01-25T19:40:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, f7547bc9-1cce-43f3-ac27-4aad77e2c88b, 'Je l''ai choisi pour les 3 ans de ma puce, je l''ai même couvert de pâte à sucre, super bon, grand succès auprès de ma famille, par contre j''ai fait en deux gâteau au lieu de couper. Merci !', '2014-11-21T17:08:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, a547e90b-e937-4f4f-8083-ba86ca4c8546, 'Miam-miam, très bonne recette.', '2014-07-13T19:02:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, a0499beb-8693-4bed-95f5-1783814120ee, 'Gâteaux très agréable délicieux , la seule chose : c''est difficile à couper en deux autrement facile à faire lancez-vous ! et régalez-vous !', '2013-10-11T15:52:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 2dd34389-01b2-460a-be5a-f4afd168430b, 'C''est vraiment trop chocolat pour nous, manque de framboises. Il faudrait peut être remplacer la mousse au chocolat par une mousse de framboises. Par contre le biscuit au chocolat est délicieux ! Je l''ai refait tout seul !!', '2013-02-16T12:03:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, b7da51fe-41e5-4610-81e4-72c8b9c684f5, 'Tout le monde l''a aimé, je l''ai fait pour les 4 ans de mon fils un régal. Je n''avais pas de framboises et je les ai remplacées par du coulis ! Génial ! A refaire.', '2012-08-07T14:40:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 6dd227c8-951f-4fb4-92bc-1d783e91954a, 'Mes amis étaient ravis. Merci.', '2012-07-27T08:48:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 41aa9607-6bc2-477e-882a-0e9195090375, 'Facile à faire c''est vrai. Difficile à couper par le milieu pour le fourrage et manque un peu de framboises. ', '2011-12-11T20:57:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 46e479a2-497d-434e-8ee3-4ae606e334c7, 'Moi qui ne suis pas douée en pâtisserie, j''ai été ravie de cette recette. Vraiment très bon. A préparer la veille pour une meilleur tenue. Augmenter aussi les proportions pour le nappage.', '2011-12-02T13:51:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 2bce7b8e-b687-4103-87a7-0bc928ddc28a, 'Un vrai délice, rien à redire, tout le monde a adoré.', '2011-09-16T19:21:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, e7d80f2e-2ba7-4444-8653-c3d0f96dd4a4, 'Très bon ! Pour le nappage, je me suis servis de 100 g de chocolat + 40 g de beurre. Le gâteau est bien meilleur s''il est préparé la veille pour que le glaçage et la mousse aient le temps de se figer. Il est trop liquide (à cause de la mousse au chocolat) et beaucoup moins bon si servi le jour même. Merci pour la recette !', '2011-09-07T10:46:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, b61f91e0-3119-4c5c-93e9-b5406a43b3a7, 'Un vrai délice !', '2011-07-06T15:30:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 94f66252-bd4f-41e4-a8de-e36b9bbbbc5a, 'Une bonne recette. J''ai fait ce gâteau pour l''anniversaire d''un ami et il était ravi, il a été le sujet de conversation principal pendant 15 minutes non-stop ! Quelques suggestions / remarques : Je ne mets habituellement pas de sucre dans la mousse au chocolat, et j''ai réduit les quantités de sucre dans la gâteau à deux sachets de sucre vanillé (20g), largement suffisant. La prochaine fois, je ferai le double de mousse au chocolat car il n''y en avait pas assez à mon goût. J''ai eu du mal à couper le gâteau car il n''a pas gonflé du tout, mais un goût de glaçage et on ne voit rien !  Quelques framboises sur le dessus pour décorer, et ce gâteau en jette !! ', '2011-04-20T22:31:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, e30119c6-d47a-4048-bae5-080712ad330e, 'Très bon. Moi aussi j''ai superposé deux gateaux de tailles différentes. Au niveau déco, après le nappage au chocolat,j''ai ajouté sur le tour des 2 gâteaux des demi-macarons à la framboise et à la pistache en alternant, et du vermicelle multicolore sur le dessus. J''ai parachevé la déco avec une fontaine d''étincelles et des batonnets lumineux.', '2010-10-19T10:34:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, ceeaa232-aa35-4e62-9c2e-257b68f21f77, 'Je l''ai fait pour l''anniversaire de mon fils mais j''ai voulu faire 2 gâteaux et le résultat visuel était passable. Le gâteau sur le dessus était trop lourd et a fait couler la mousse choco-framboise tout autour du gâteau. Il aurait sûrement fallu un cercle de pâtisserie pour le maintenir... Mais bon, il était quand même bon quoi qu''un peu bourratif avec les 2 gâteaux.', '2010-08-07T16:46:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 4509576a-fd30-4635-8e32-40afe29b32a2, 'Je confirme faire 2 gâteaux pour que tout se passe pour le mieux... et un peu moins de beurre !!', '2010-07-29T19:26:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, de7a9ca3-0547-45b6-8173-cd886da80acb, 'Excellent ! Je n''avais pas de framboises et j''ai utilisé des fraises. Pour la déco, j''ai recouvert le chocolat de fraises également. Très beau et très bon !', '2010-05-01T19:25:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, f2b84b6e-3bb8-4685-a4e1-ef6f170d794a, 'Super ! Rien de tel pour ravir tout le monde, à condition d''aimer le chocolat bien sûr. Pour la déco, j''ai fait un calque de "oui oui" pour ma petite fille et j''ai poudré de sucre glace. Lancez vous ! ', '2010-04-01T12:54:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, fe8dd353-683e-4d7a-9021-a5eef963cb7d, 'J''ai fait ce gâteau pour l''anniversaire de mon chéri! Il était tout simplement super bon! Par contre, j''ai doublé toutes les proportions histoire d''avoir un immense gâteau d''anniversaire et remplacé le nappage au chocolat par une crème chantilly avec 5dl de crème entière, un paquet de soutien crème, et 3  sachets de sucre vanillé! Miam! :) En doublant les proportions, j''aurais quand même dû coupé le gâteau en trois au lieu d''en deux parties, ça aurait été plus joli et j''aurais pu y mettre toute la mousse chocolat.', '2010-02-09T18:42:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, a985ff5d-ac4c-4159-b000-7e2fbccba88e, 'Rien à dire sinon hum, délicieux... Sinon pour le moule rond ou rectangulaire, peut importe, le tout c''est de se rappeler que vous allez couper le gâteau en 2 donc ne pas prendre un moule trop grand sinon c''est pas top pour l''épaisseur....', '2009-09-25T21:09:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 562c9972-5c5e-4e37-953f-7afe129fd0b5, 'Evitez cette recette si, comme moi, vous êtes une apprentie pâtissière. Il me manquait une info capitale pour la réussite du gâteau... la taille du moule. ', '2009-09-13T16:27:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, a75c46e7-ebef-4683-a28e-584f815f1e4a, 'Très bon gâteau qui présente bien. J''ai coupé le gâteau en deux sans difficulté. Pour la mousse au chocolat j''ai mis 125 g de framboises est la prochaine fois j''en mettrai 200 g. Pour le nappage j''ai mis 75 g de chocolat pour 3 cuillères à soupe d''eau et une de lait mais la prochaine fois j''en ferai un peu plus pour pouvoir napper les côtés qu''on ne voie pas que le gâteau est coupé, une framboise sur le dessus quelque heures au frigo est c''est parfait. Merci pour cette recette que je referai.', '2009-08-07T16:36:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, f978c62f-5811-4d7c-a03c-402d2c1242d5, 'Excellentissime !!!! Tout le monde a adoré !!!!! J''ai remplacé le pralin par de la poudre d''amande, également très bon. Merci pour cette recette !!!', '2009-07-12T22:51:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 6ae17915-88a7-4012-819a-59ddd2bb6ca0, 'Super! J''ai fait 2 génoises comme les autres et effet garanti!!!A refaire avec des fraises cette fois!!!', '2009-03-18T19:07:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 59f286c7-b746-46cd-8316-2be29cce033c, 'Délicieux! J''ai fait un seul gâteau, car il avait gonflé suffisamment. J''ai réduit la quantité de beurre (75g), remplacé les framboises par des poires fraîches. J''ai ensuite nappé avec du chocolat au lait (200g) sans ajouter d''eau pour qu''il soit bien croquant. Et pour finir j''ai disposé quelques tuiles de Carambar. C''est un gâteau moelleux et finalement assez léger. Grand succès (de 12 mois à 60 ans)', '2009-03-06T10:05:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, cd6d9369-8b45-4141-a49a-1eec6332b7da, 'Très bon! Présente bien et simplissime ! J''ai suivit les conseils des testeurs et j''ai fait 2 gâteaux, diminué les proportions de sucre. J''avais peur que ce soit un peu "sec" mais le praliné allège le côté tout choco. Et j''ai mis 125g de framboises au lieu de 75g. Et la prochaine fois j''essaierais avec 200g.', '2009-02-24T00:02:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 90c57e83-8d14-4fa0-89ae-9569251ded91, 'Excellent ! Superbe résultat, j''ai suivi les conseils des avis et j''ai fait 2 gâteaux ! Très beau rendu, j''ai décoré le tout avec le reste de framboises et des confettis et j''ai ajouté des mikados ! Effet garanti !', '2008-11-01T22:43:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, fb03c638-51ca-49cf-961a-47226beb4456, 'Très, très bon ! C''est la 1ère fois que je l''ai testé. Le résultat était au-dessus de mes espérances. Mariage chocolat/framboise, vraiment délicieux !', '2008-10-29T14:34:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, ea7f1cbb-9b1a-4801-ac0b-c346b2c61d15, 'Super bon, mais j''ai fait deux gâteaux que j''ai mis l''un sur l''autre. Bel effet pour l''anniversaire de mon fils ce gâteau à deux étages !!!', '2008-04-21T20:17:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 6941c7e7-a0c8-48b1-be7c-bba55d2b10f7, 'EXCELLENT!!! ', '2007-09-22T13:40:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, ce281f20-b453-48c3-8006-1b1ddff032f7, 'Effectivement le gâteaux est très facile à faire mais comme il a été déjà dit il vaut mieux faire 2 gâteaux car ils ne sont pas très épais et seraient difficiles à couper en 2. Très bonne recette.', '2007-07-14T16:02:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55637, 69ac8b77-769b-47d3-9b65-f4f14e59f459, 'J''ai préféré faire 2 gâteaux et les superposer après en intercalant la mousse au chocolat et les framboises, car il est difficile de couper le gâteau en deux. Pour l''anniversaire de ma fille, tout le monde a apprécié, j''ai ajouté sur le gâteau des framboises en décoration.', '2007-06-18T00:55:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 38024492-0116-48de-8eab-ae353fb24cda, 'J''étais très motivée mais très déçue du résultat. Trop sucrée et écoeurant. Il faudrait faire des modifications, et je préfère passer à autre chose. Mon mari et moi avons goûté une part et jeté le reste. Vraiment dommage!', '2021-02-08T14:28:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, d332b22d-562b-4061-9564-895529cd3c28, 'Super recette ! ', '2018-06-16T05:54:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 64d141e1-bf13-4e83-a160-86cc78ee794c, 'Super bon la mascarpone étant plus compacte ça doit être plus facile.', '2016-07-17T16:56:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 1b3d1d4c-d6e4-40a8-85a7-0745eeceed3c, 'Cette recette est parfaite juste il faut oser.
J''ai remplacer la crème  fraîche épaisse  par crème  fraîche  liquide  battue additionnée  de mascarpone.
Je trouve la crème  fraîche épaisse  surette.
A refaire', '2020-06-06T18:58:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 23d6d7c9-cf4a-47f3-8d14-112e9a91bb69, 'Délicieux !! A refaire !', '2019-04-25T04:04:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, ece13d9c-c5f3-45d6-8193-0129e3c40d08, 'Excellent dessert !', '2018-09-15T22:20:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 6764f304-4191-4bde-8ae9-28b74795bb09, 'J''ai réalisé cette recette 2 fois. La première avec de la crème fraîche comme indiqué dans la liste des ingrédients et l''autre avec de la mascarpone. Ça n''a pas tenu avec la mascarpone, trop liquide. Préféré avec la crème. Au lieu de rouler la pâte, je l''ai coupé en 3 pour en faire un millefeuille. Beaucoup moins compliqué pour le montage ! Le plus long, c''est de découper les fraises en petits morceaux. Sinon, c''était une tuerie ce dessert ! Plus rapide pour le manger que pour le faire !', '2018-06-14T05:14:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, ac8f8eb2-cd08-4076-ba8b-c7c580856c2d, 'Excellente recette testée avec des framboises, je la referai avec des fraises.', '2018-06-05T13:42:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 86e257d5-c9ab-48bf-9c02-dcdfcbe81c60, 'Une tuerie !
Tout le monde a aimé !', '2018-05-27T04:21:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 512a0d90-ce9c-44d9-babf-9981fff27762, 'Excellente recette, facile, rapide, originale. Un délice ! Merci.', '2017-09-10T00:23:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 341220ce-8d09-48e9-8ecf-4d1310dd72b8, 'Préparation assez longue mais cela vaut le coup ! J''ai réalisé ce gâteau pour l''anniversaire de ma petite fille et j''ai remporté un franc succès ! Présentation superbe et c''est délicieux. Un énorme merci pour cette recette que je referai sans aucun doute.', '2017-08-09T21:43:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, abe63cbc-d415-4ee4-b73d-f3ae81764653, 'Facile, bon, très très bonne recette !', '2017-06-24T20:07:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 289930fb-a865-4c72-8ca0-0e3200c24b58, 'Suculent ! tout le monde a adore ! a refaire. jai recouvert la buche avec de la creme. trop bon !', '2017-05-13T10:42:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, dde4093b-fbc9-44a0-9a3b-a3d684109b6a, 'Délicieux  !un peu difficile à rouler car la meringue est fragile.. A refaire en tout cas.. J''ai mis des pistaches concassées ainsi que dans la crème l''essence de pistache et vanille ,  ', '2017-05-11T19:59:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 6da92961-b426-4d81-a92d-bfe3d16aae77, 'Recette facile à faire et délicieuse ! ', '2017-05-11T15:03:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 5d96d4c2-3c03-405d-8c16-796bdc39ae11, 'Exceptionnelle, très bon la température un peu élevé 220°C suffisent largement et le rouler encore un peu tiède, merci.', '2017-03-26T18:29:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 1f87fc83-84ff-4e2b-877f-47ced74cc3db, 'Super. ', '2016-08-21T09:59:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 366e4526-e229-4a4d-bab8-a6e86dd1738c, 'Nous avons adoré ! Le craquant des amandes, le moelleux de la meringue et la fraîcheur des fraises ... J''en referai c''est sûr ! J''ai mis 250 g de sucre mais avec plus de blancs d’oeufs (6 ou 7 je pense) et c''était très bien comme ça. Je n''avais pas de vanille liquide donc j''ai mis une gousse. Finie le lendemain, c''était encore meilleur.', '2016-07-19T19:05:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 871866ca-4d89-45a1-a5c6-fe38f18ba682, 'Très bon dessert, je l''ai trouvé meilleur le lendemain que le jour même donc perso je ferai la veille. J''ai mis à 220°, les amandes effilées étaient bien grillées', '2016-06-24T11:24:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, cbcde357-2287-4f17-82f1-9f70ab0e347e, 'Excellent, à faire et refaire. Moi aussi, j''ai remplacé la crème par du mascarpone et mis que 200 g de sucre', '2016-06-23T23:09:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, dec33ab1-2408-4e0e-b522-2402c2131f75, 'Une tuerie... toute la famille a adoré ', '2016-06-20T12:12:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, db1a119e-82f5-43c1-b8ad-9ae2d5902e7f, 'Très bon dessert frais et léger, idéal en été. Je mélange la vanille et la crème un peu avant de préparer le dessert pour que la crème prenne bien le goût de la vanille.', '2016-06-13T21:46:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 31c32596-49a1-4376-9617-8da517d01dbb, 'Merci pour cette recette ! je remplace juste la crème fraîche par du Marscarpone ! un délice ! ', '2015-05-17T14:29:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 28652564-7f1f-4e0e-b13f-f22ef4bed7ab, 'Un vrai délice. au bout de 3 fois montage parfait sans raté ! j''adore ', '2014-08-08T20:13:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, e382fc26-c865-4b46-906e-6540fa9e7cc8, 'Perso je n''adopte pas cette recette ....', '2014-07-09T19:52:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, d9fc943e-307e-44d3-a29c-bab9fcbea82f, 'L''une de mes recettes fétiches !! L''essayer c''est l''adopter. Merci pour le partage tout le monde adore il n''y a jamais de restes ! ', '2014-06-09T00:01:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, a7f82b41-48e9-4b41-b1e1-c3053dc3b5d9, 'Merci pour cette fameuse recette. Je l''ai faite plusieurs fois et toujours autant de succès. ', '2013-09-15T09:29:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 341c13d8-3ab1-4f8a-bfbe-db3f890388a0, 'Sublime et délicieux ! Pas très dur à faire en plus mon mari m''en a redemande !!!', '2013-07-25T16:31:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, aa39aa4c-9220-4fc8-b2a7-8d72599b946d, 'Un pur délice, belle harmonie de saveurs et de textures. ', '2013-06-16T17:09:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, b7e115b4-db8d-4d3d-88aa-16cc433572e5, 'Très, très bon. Littéralement scotchés par cette recette si simple et ce résultat !', '2013-06-05T00:34:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 28bf2acc-81e1-4b6d-a333-ded592163a3e, 'Génial tout le monde a aimé, c''est très facile à faire et c''est super bon. C''est frais pour l''été, d''autant qu''on peut mettre les fruits qu''on veux.', '2013-06-03T20:12:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 6666a58a-a3e0-4fdd-a080-1ad66131e43b, 'Excellent. C''est facile à faire.', '2013-05-20T20:21:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, b233241c-faac-47ea-a464-614c2a661ef3, 'Gâteau excellent, facile à faire à part le démoulage de la meringue qui est délicat à faire. Aussi très bon avec des abricots faute de fraise.', '2013-05-19T22:47:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 24b01867-8ef5-40ae-9342-7c8b7917a802, 'Plutôt que de mettre la meringue dans un plat de service, retournez la sur du papier sulfurisé, c''est plus facile à rouler ensuite. Pensez à garder de la crème fouettée pour la décoration du gâteau.', '2013-05-18T18:55:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, f37e78fc-d237-4bd0-97db-41ab2e309e4a, 'J''ai utilisé 20 cl de crème liquide, que j''ai montée en chantilly avec 30 g de sucre glace et un sachet de sucre vanillé. Mieux vaut effectivement rouler la meringue encore tiède. C''était très très bon ! Nous avons adoré. Meringue dorée et moelleuse, c''était extra !', '2013-05-09T00:28:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 15bf3872-2bfb-4000-bbcd-6350a8c4895d, 'Excellent mais encore meilleur après une nuit au frais.', '2012-12-15T21:39:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 8697b46b-dd57-4cac-92ed-de82e96c0c29, 'Gâteau très beau et assez facilement réalisable. Mais à réaliser le jour même car il s''écrase rapidement (à cause du jus des fraises). A refaire.', '2012-09-14T11:44:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 70d94314-44a2-4432-8f30-c45e8221f58c, 'Je déteste les gâteaux d''anniversaire débordant de crème.... Donc celui-ci est devenu l''officiel ! Tout le monde se régale quand je le fais. Par contre, je ne mets pas de crème fraîche mais je fais une chantilly à la vanille (250 ml de crème liquide entière bien froide + 30 ml de sucre à la vanille). Un vrai régal. ', '2012-07-21T13:41:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 4574ca85-2aef-42f0-9048-a598ca0fa71c, 'J''ai suivi la recette au pied de la lettre et pour ma première meringue, tous les invités se sont régalés. Merci !', '2012-06-13T10:46:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, db132634-a663-4275-9c1f-ddc4c3a9771e, 'Quel régal et quelle présentation ! Vraiment magnifique. C''est un super dessert que nous avons tous adoré, meilleur le jour même, car le lendemain les amandes ne sont plus aussi croquantes.', '2012-05-22T06:52:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, ac389eb5-1c1f-47dd-bd3d-562af4d7927e, 'Sublime !!!!!! Mon mari qui en général n''aime pas les desserts a apprécié celui-ci. Facile à faire, original, succulent. Avec des framboises il doit être aussi délicieux. Effet garanti', '2012-05-21T12:46:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, aa40c27d-35ec-4be4-b0fd-54f61867a616, 'Absolument délicieux ! je me suis lancée dans cette recette sans trop savoir à quoi m''attendre... j''ai raté ma première meringue (du coup je me retrouve avec 8 jaunes d’œufs !) qu''il faut en fait monter bien ferme avant d''ajouter le sucre (bon à savoir pour les débutants en meringue... !) puis la cuisson (alors four à chaleur tournante : 6 min suffisent à 220°) puis 8 min à 160°. Rouler la meringue quand elle est encore tiède, sinon elle casse !! J''ai épaté mes invités, c''est super léger, super bon, à décliner avec tous les fruits d''été ! merci beaucoup !', '2012-05-20T14:51:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 68c44ffe-87e5-4a69-bf35-c82c8283448c, 'Je viens de réaliser ce dessert pour midi avec des fraises de mon jardin. Très facile à faire et vraiment délicieux ! Aussi beau que bon ! De quoi ravir toute ma petite tablée.', '2012-05-14T17:51:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 53436f80-927a-444b-b6fa-6ac55c71c92c, 'Tout simplement divin. Ce dessert a fait l''unanimité plus d''une fois.', '2012-01-12T22:57:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, fde31760-67be-43f4-9185-0b0d28e2ad85, 'Vraiment bon, présentation super, c''est devenu une de mes recettes pour épater les amis. C''est juste parfois un peu périlleux de rouler la meringue.', '2009-08-01T08:57:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, e52132ba-3dcb-47ad-bf41-0a785ca86af5, 'Dessert très léger et rapide à faire; je n''ai pas mis d''amandes et que 20 cl de crème mais super réussi quand même!', '2008-08-24T12:33:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 178c86a3-5883-4d18-87ff-e136b5415699, 'Dessert qui a une présentation magnifique! Mes amis n''en revenaient pas! Et j''ajoute qu''il est encore meilleur après une nuit au frais!', '2008-07-03T12:54:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 93874d1d-cf51-465a-97c1-d578117abf48, 'J''ai craqué pour cette recette, c''est un véritable délice.. de plus, elle est facile et rapide à réaliser !! Tout le monde à la maison a adoré !   ', '2008-04-20T18:56:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60079, 0b9e60bb-dfac-4bb3-92e5-54306c9ace03, 'Merci beaucoup pour cette excellente recette! Ce mélange de fruits et de meringue est sublime. Ce dessert "glisse" tout seul à la fin d''un repas!', '2007-09-09T18:01:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62875, abfa57a3-1455-4af8-a390-17568cb751a3, 'Tout simplement excellent !! N''ayant pas trouvé de jus de framboises, j''ai utilisé du coulis de fruits rouge et c''était parfait ! Merci beaucoup !', '2013-11-05T17:50:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62875, c9ae91a0-4b5a-4d06-bc3d-f8776b15fc97, 'Grandiose!! Je n''ai toutefois pas utilisé la génoise proposée par Rodolphe mais une recette de gâteau ultra léger au champagne que j''ai trouvé plus festive pour le réveillon !! La crème se tient bien, les framboises avec la fleur d''oranger forment une union très heureuse !! Mille mercis pour la recette.', '2008-01-01T15:36:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62875, ff60ad22-21c0-4183-a3e6-dcf0eb1ae512, 'Validé ! C''est trop bon.', '2021-09-04T11:18:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62875, f3ca184c-de39-43d2-b032-6245b0628216, 'Excellent, c''est frais léger ! Mes enfants ont adoré mon mari me donne 10/10 ! pratique lorsqu''on a des invités car peut se faire la veille ! ', '2015-09-20T17:13:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62875, df5b1a07-2127-4cdc-b948-60111932611c, 'Vraiment délicieux ! C''est très frais et très léger. Le gâteau se tient bien. Tous les invités ont adoré (et moi aussi!). Je le referais sans aucune hésitation en suivant toujours la recette à la lettre ! Merci encore !', '2011-06-14T10:33:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62875, 7bbaa130-2c69-4702-8132-4e341e53e352, 'C''est enorme! J''y ai passé beaucoup plus d''une heure en tout mais cela valait largement la peine : aussi beau que bon. Si vous avez du monde à épater (on le croirait sorti d''une boulangerie), du temps devant vous (la veille) à faire sans hésiter !! ', '2007-11-11T20:32:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29221, ed6599c5-2766-457e-a0b1-a663eddb6c1d, 'Un peu fastidieux à faire ... si l''on veut déposer le chocolat de façon uniforme sur chaque fraise avec un pinceau de cuisine ! Déçue par le goût en bouche, le chocolat noir à pâtisser est trop amer ...  ', '2016-03-29T20:40:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29221, 551b8621-f2d5-46c7-99a5-1d7cbc400403, 'J''ai fait moitié chocolat blanc et moitié noir. Le nappage avec le blanc est peu plus délicat. C''est joli et très bon, évidemment il faut des fraises bien parfumées et fermes. Je garde la recette. Merci', '2015-06-14T11:09:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29221, 51b4bd6c-58ee-4390-8b87-5fc71b8c24b4, 'Bof, pas mauvais mais sans plus de préférence, à faire avec du chocolat au lait je pense que ça serait moins fade.  ', '2014-05-02T23:33:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29221, c0f06cd6-7700-49d1-8ffe-a59e4e8bdb73, 'Réalisé avec de belles gariguettes et de plus j''ai suivi les conseils de "marignan" en les déposant sur un lit de sauce aux kiwis. Effet visuel réussi et résultat gustatif intéressant. De plus très simple à faire, nous sommes fans. ', '2014-04-25T20:35:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29221, 685a4a08-fbb9-4db4-a558-3e84234db6c1, 'Oui excellente recette, je l''ai faite avec les 2 chocolats, esthétiquement la présentation était jolie et les 2 goûts excellents ', '2012-06-01T11:14:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29221, 2bfa1d43-2393-4219-8c57-0abe3fdd52e6, 'J''ai testé "amour de fraises" le jour de Pâques. Rien à redire, ma petite touche personnelle est simple : j''ai mixé des kiwis avec un jus d''un demi citron et du sucre glace. J''ai mis cette "soupe épaisse" dans le fond de mon plat et j''ai posé mes fraises dessus.', '2011-04-24T17:33:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29221, 18fa1c0f-2e28-40a7-af99-6a5705b78567, 'Facile à réaliser, jolie présentation, et quel délice ! J''ai mis du beurre demi-sel pour ajouter un petit quelque chose.', '2011-04-18T19:36:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29221, 92e0cdc6-df47-424b-86c6-00d5934822f9, 'Tout simplement délicieux, seul regret : ça se mange trop vite !!', '2008-05-16T20:32:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29221, 6cebaab8-e6e3-4630-83cd-1a729e2b29bd, 'Simplement délicieux! La fraise se marie mieux avec du chocolat blanc, donc j''ai fait la recette avec du chocolat blanc et un peu de crème fraîche(liquide et light) : résultat sensationnel!! la présentation n''est pas évidente, alors la prochaine fois je l''essaierais en tarte aux fraises!', '2006-04-14T18:03:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29221, f4abc065-b99c-47e0-a002-1aa718e8073d, 'Super bon, pas compliqué mais un peu long si il y a beaucoup de fraises. Il faudrait essayer avec du chocolat blanc.', '2006-03-01T12:48:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29221, 797e51ff-cf07-4b2e-a3fc-a33c730dac07, 'C''est encore bien meilleur avec du chocolat blanc (d''une bonne qualité) mais il ne faut pas mettre de beurre dans ce cas, juste un peu de crème liquide pour bien que le chocolat fonde sans grumeaux.', '2005-04-13T21:37:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29221, 5b5135ca-2c5a-4c26-aa0f-e284c48ce3c0, 'Recette très facile et excellente pour les amateurs de fraises. Je n''ai pas eu de problème avec le nappage au chocolat (mais j''ai utilisé beaucoup + de fraises que dans la recette) et je n''ai même pas utilisé de cure dents (de toutes facons, le chocolat durcit au réfrigirateur).', '2005-04-04T01:32:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29221, 9f6e44c4-c8d9-4880-8b7c-d95ccb221c8a, 'C''est très bon, mais pas très présentable et un peu fastidieux pour recouvrir correctement les fraises.', '2005-02-14T17:09:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29221, 6b32a9ec-e829-491d-badf-b456ac2d7730, 'Il n''y a pas de doute, c''est exquis... Mais de là à dire que c''est rapide... Pour ma part, j''ai trouvé ça plutôt laborieux... Je le referai sûrement, mais un jour où j''aurai de la main-d''oeuvre à la maison pour m''aider!!!', '2004-08-18T20:23:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, cd8deeab-c5d1-40c4-a190-a47197a00f05, 'Excellent, à refaire. La cuisson est un peu plus longue qu''indiqué ', '2014-10-03T21:17:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 4078fac3-d7d5-4b83-8862-ef6c9385e352, '400g de framboises ont suffit pour ma part. Je l’ai laissé un peu plus longtemps à cuire (1h), et j’ai fais les 2 tiers de crème d’amande (ça faisait trop sinon). Résultat, tout le monde est ravi ! et le gâteau est délicieux.', '2021-10-02T22:16:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 12da0e52-0156-4942-8a16-9d6a06f53c7b, 'Cela me semblait un peu trop calorique, alors j''ai remplacé le beurre dans la crème d''amande par un fromage frais à 0%. Très bon et plus léger. Excellente recette.', '2015-02-02T10:10:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 7dae6211-e248-4b41-ad8f-3fec37354013, 'Très bonne recette, je la préfère froide car c''est alors moins acide. J''ai utilisé des framboise surgelées. Et j''ai mis 1 heure à cuire.', '2014-12-01T20:39:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 62fea5fb-0bfe-44d8-a94e-50c4167d0481, 'Très très bon ! ', '2014-05-01T15:13:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 9759ab89-bbc1-4854-a700-ee1cb916d946, 'Excellent !! Très bonne recette et pour le goût j''ajoute une gousse de vanille, les amis et la famille en redemandent', '2014-02-11T19:41:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, fb7b7bef-a235-4817-9c2c-42bf0c534c3a, 'A contre sens de tout le monde c''est rare après tant d''éloges : ce n''est pas bon, bien trop pouf pouf, absolument pas raffiné du tout avec cette superposition de pâtes. Mieux vaut le crumble tout seul. Cette tarte est déclinée sur plusieurs types de fruits, ayant testé l''abricot et la framboise, c''est décevant et ce sera définitivement non plus jamais. Pour ceux et celles qui insistent, froide c''est encore pire, car cela est gras.', '2012-07-09T20:06:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, bb0b098a-19cc-4790-a437-7593f9e8f8e2, 'Bof bof trop c''est trop je trouve que le crumble en lui même c''est déjà lourd mais alors là avec de la poudre d''amande en plus et une pâte c''est beaucoup trop lourd ', '2011-09-19T20:11:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, e60e11f1-a243-4043-b31c-1ec5542c44c0, 'Très bon. Fais avec une pâte sablée maison, des fruits rouges surgelés et une crème pâtissière. Précuire le fond de tarte à blanc. Très belle présentation.', '2011-06-13T23:15:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 78eaf6f6-0f2c-4ab5-b22f-e2c30bca652b, 'Merci pour la recette que j''ai essayée aux framboises surgelées, aux fruits rouges surgelés (mis sans décongeler avant...), aux mangues, aux pommes et toujours avec le même succès et la même satisfaction ! Bon puis ça parait évident mais je l''ai quand même testé pour vous, cette tarte ne supporte pas le transport !', '2011-05-12T19:36:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, b0001fe5-f4f2-46ab-8ce0-77ef35b28102, 'Bonne tarte mais sans plus car un peu lourde. J''avais ajouté quelques pignons de pin dans la pâte à crumble. Nous avons testé tiède mais nous l''avons préférée bien fraîche. A vous de voir. J''avais utilisé des framboises surgelées. ', '2011-04-20T18:46:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, db4f66b6-b461-4e79-b48a-57c62b22f083, 'Très bonne recette, facile à réaliser. Merci.', '2011-02-10T17:18:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 316bf2ba-aec7-4cf6-b671-01a2b3aa8f62, 'Les parfums amandes et framboises se marient vraiment bien. Par contre, j''ai eu un problème de cuisson. Heureusement la tarte est restée présentable mais je pense qu''il serait préférable de faire précuire d''abord la pâte sablée avec la crème frangipane, et ensuite remettre au four avec les framboises (et quelques morceaux de mangue) avec la pâte à crumble (à laquelle j''avais mélangé quelques amandes effilées grillées). A refaire, c''est sûr.', '2010-07-07T16:12:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, b132a56b-bbd2-470d-96d5-d62de41c4b34, 'Très bon mais un peu bourratif !', '2009-12-27T23:15:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 55acc507-f75c-4498-a3a4-b171ffa44d67, 'Très sympa cette tarte !', '2009-07-16T23:54:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 15e521b7-6c23-4e83-a220-8d2a3c9e0b24, 'Délicieuse. Je rajoute un peu de chocolat noir fondu sur le fond de la pate. C''est encore meilleur!', '2009-04-14T20:57:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, fba10e2e-2dc9-423a-a3c3-244770763f90, 'Tout simplement excellente : je l''ai essayé avec un mélange de fruits rouges surgelés... Divin!', '2009-02-24T18:50:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, c294ae64-7782-459b-a00b-992f62798d7b, 'Un peu déçue, j''ai trouvé ce gâteau très lourd alors que la framboise est si légère, bon, mais je ne le retiens pas dans mes recettes.', '2007-09-15T11:58:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 29c40b53-6817-49c2-8b07-4849277c8b80, 'Très bon!! Cependant un peu trop de crème d''amandes et le temps de cuisson était un peu court.', '2007-07-05T01:03:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, d0715eab-94a6-45f8-ae14-83b7a4d30e5b, 'J''ai réalisé la tarte avec facilité et j''ai utilisé des fruits de mon jardin, des framboises, groseilles et cassis ce qui fait un très bon mélange! A ravit les papilles de toutes la famille.', '2007-06-30T20:05:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 1bbd6f4d-b10d-4910-b231-a78c5b971e0a, 'Très belle présentation pour peu de fatigue pour les framboises et la pâte que j''ai acheté dans un magasin de surgelés.. je regrette seulement que le détail du crumble ne soit pas dans la recette, car étant novice j''ai dû trouver une autre recette pour savoir comment faire la préparation du crumble ! N''hésitez pas, vous pouvez vous lancer les yeux fermés !', '2007-06-04T22:37:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, e6c8c93c-1b6d-44dc-aa3c-0aab21590a58, 'Facile à réaliser! Et très bon !!! ', '2007-04-02T20:55:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 04152833-fe84-4498-8dd1-5ebada720b37, 'Très bonne recette, à essayer de toute urgence! Succès garanti.', '2007-03-29T15:24:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 02b5bc17-d1fc-4d9d-a5c1-1f3b079233ac, 'Tarte très bonne, mais j''essayerai une prochaine fois avec un fond de crème pâtissière et un peu de poudre d''amandes. Je n''ai pas eu assez de framboises, alors j''ai rajouté des fruits rouges surgelés (mais décongelés). Ne pas hésiter à faire la pâte sablée soi-même, le résultat n''en sera que meilleur.', '2007-03-22T17:56:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 829dbc62-64ac-4877-8a4b-e81cb2f8466a, 'Je mettrais même 6/5 si c''était possible!! Recette excellente, rien à changer si ce n''est réduire un peu la quantité de crumble. J''ai suivi la recette à la lettre, c''est très facile. Je la referai très bientôt sans hésitation. N''hésitez pas à l''essayer, succès garanti!', '2006-10-15T22:29:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 875b133e-333c-4cea-8834-32ad079d984e, 'Excellente et facile à faire. Que demander de plus?', '2006-09-26T16:27:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 901b9a46-0be7-4d95-a4ce-4f8bc8aa6c11, 'Cette tarte est un pur délice! Pour ma part, je double la quantité de crème d''amande, c''est encore plus moelleux! Merci pour cette recette.   ', '2006-09-10T16:22:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, d41c5a7c-b196-4446-87d4-28296df0b85a, 'Tarte délicieuse, très facile à réaliser. Peut-être un peu trop riche en beurre tout de même et il faut mettre davantage de fruits pour faire bien ressortir leur arôme. Beaucoup de succès en tout cas!', '2006-08-14T00:51:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 7c1d4375-410e-4cb0-ae0c-d1defee29a5f, 'Vraiment très bonne. A chaque fois que je fais cette recette: succès garanti! Je mets un peu plus de cuisson pour que la pâte d''amande soit bien cuite.', '2006-08-02T13:32:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 3471cec5-8804-4de1-a92a-44c9c49fac6a, 'Cette recette est parfaite, il n''y a rien d''autre à rajouter!', '2006-07-03T19:40:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 085c1241-6e38-4154-a42c-6219a6fd3933, 'Délicieuse cette tarte ! Et rapide à faire ! Elle met en valeur l''arôme des framboises. Je vote pour !', '2006-06-30T20:00:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 5b8ba0fa-1a28-4153-930a-9b38c974625b, 'Recette très facile à réaliser. Je l''ai faite avec un mélange framboise-Myrtille préalablement bien décongelé. Le résultat était superbe et absolument délicieux. Succès garanti pour cette tarte facile à faire!', '2006-06-19T10:25:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 3da29207-41dc-4188-9890-2009fa290b0e, 'Tout simplement merveilleux! J''ai mis aussi des groseilles et rajouté au crumble le reste de pâte en petits morceaux. A recommander!', '2006-06-17T21:37:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 1a7ad326-249b-46a9-bf07-4fd8b6ed434e, 'Excellentissime. Cette tarte est parfaite  et semble effectivement sortie de chez le pâtissier...', '2006-04-28T17:17:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, e72ad517-8e64-43c0-97e6-20db3938dec9, 'Rien à dire! Cette tarte est vraiment très bonne ! Moi qui ne suis pas très douée pour les desserts, en voilà un que j’ai réussi sans aucun problème. Sans problème avec des framboises surgelées, mais décongelées à l’avance ! Bravo et merci encore pour cette recette !', '2006-04-11T14:30:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, abcdb0fc-9157-4dab-bcf8-d712da6824ff, 'Super bon.', '2006-03-11T14:54:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, cf6d57cc-a808-4b90-8232-e1cdbd5ddd3e, 'Fabuleux, merveilleux!! On croirait que je l''ai acheté à la boulangerie, mais non c''est bien moi qui l''ai fait!', '2006-01-15T00:40:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, af0f8ef7-eec6-40a2-8a35-b8883a939a3d, 'Parfait. J''ai rajouté de l''arôme d''amande amer dans la crème d''amande et un peu de vanille liquide dans la pâte à crumble.', '2005-12-18T13:34:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 24320f2d-a56c-4732-89e5-94d446619948, 'Su-per! Ultra-rapide à réaliser, et résultat délicieux !', '2005-12-04T19:43:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 61d141a0-04bd-46db-ad65-1c4dfd4c88c1, 'Je l''ai faite pour une réunion de famille, la tarte n''a pas fait 10 secondes... Un pur délice!', '2005-11-07T18:06:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 8ed349c5-99ec-429f-90c0-720164e295d3, 'C''était délicieux! J''espère en déguster une autre, bientôt... ', '2005-10-02T17:28:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 0c353fdd-1f60-4402-a6e5-34938717cfcc, 'Excellente et facile à confectionner, mais ne lésinez pas sur les fruits. Moi même, j''ai ajouté quelques myrtilles.', '2005-09-15T22:25:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 17bc2044-25c5-4cfd-8d80-b77fdacbed8d, 'Rien à redire, elle est vraiment excellente!', '2005-09-13T19:32:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 28dad08f-bf5d-482f-80d2-375a568c74e8, 'Trop bonne, facile à faire. Je l''ai servie avec une boule de glace à la vanille, un délice...!', '2005-08-12T20:19:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 0cce0f77-bc97-4691-b434-3d0c3a97e17b, 'Excellent et très facile : j''ai remplacé les 100g de beurre pour la crème d''amande par de la crème fraîche. Un délice.', '2005-07-19T22:10:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 2b6c3b5b-1d16-4663-a709-a77e9ac03dd7, 'Très bon mais j''ai pris des framboises du jardin, elles étaient acides ce qui ne donnait pas très bon goût à la recette, je pense qu''il faudrait laisser les framboise mariner dans du sucre avant!!', '2005-07-03T14:10:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, bbe9dd4f-6ab9-4ccc-b9d5-fcdcbda309c7, 'Délicieux! J''ai fait mi fraises-mi framboises et tout le monde a adoré.', '2005-06-14T22:57:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, 89240d1e-3ed0-4ab8-9244-741c74a18b68, 'Je l''ai fait avec des fraises et c''était délicieux il n''en restait plus une miette. Réalisation très facile, à conseiller à tous les gourmets!', '2005-05-03T17:51:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, a5db64b0-78e5-4a9f-ac12-d7cb34e866a1, 'Parfaite mais je mets plus de 500g de framboises ;)', '2005-05-02T19:15:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, b2590001-df06-4e53-98b3-f3e4605bbd13, 'Excellent. Rien à ajouter ni retirer. Simple, rapide et efficace ! Merci.', '2005-01-26T19:39:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34252, bc713680-1b73-4d80-9425-9ba6bc666645, 'Elle est très très bonne, mais il y a un peu trop de crème à l''amande et ce n''était pas cuit au milieu.', '2005-01-23T22:05:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 55f371b3-a014-4974-b31b-5a9582e2783d, 'Chez nous on appelle ça les râpées 
On peut rajouter des carottes râpées, des oignons !', '2018-02-28T13:20:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 6d62707e-9fd2-4004-a255-1b5e05a4e8fa, 'Très bon on appelle cela chez nous des criks ', '2023-01-09T17:37:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 7c2d6d19-1870-4bf3-831d-257224c4b940, 'La même recette que ma maman me faisait quand j''étais petite et que je continue à faire maintenant, sauf version sucrée que je ne connais pas. On peu ajouter à la pomme de terre râpée de l''oignon râpé ou de la courgette râpée, de la carotte râpé, ou un mélange ail_persil. A servir avec une salade et une grillade ou un steak.Miam', '2015-05-22T15:15:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 9a1a2712-02ab-4061-adce-a63f4c3ba96e, 'Super bon !!! Pour ma part j''ajoute un oignon ça relève un peu le goût et je mets un peu de noix de muscade. Excellent... A refaire sans hésitation.', '2013-03-20T11:48:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 58367b14-3e7e-4ecf-8e91-3c3d8dd01629, 'Moi, je rajoute en plus de votre recette : de la chapelure, un peu de semoule de blé, des herbes, oignons puis je mixe le tout.
On mange cela avec de la crème fraîche épaisse.
C''est un délice (chez moi les enfants et amis adorent).', '2022-05-05T15:30:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 2178f47f-ae8f-4291-8d6e-f38d2492dd70, 'Super avec un fromage frais (chèvre ou ail et fines herbes... ) pour la version sucrée avec de la fleur d’oranger.... ?', '2021-01-16T19:32:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 8b2805c4-84bf-428c-9431-08b865ad7c64, 'Je suis polonaise et je précise qu''il ne faut pas râper finement la pomme de terre, mais la réduire en bouillie. Je le faisais avec une râpe héritée de mon arrière grand-mère, mais pour ne plus m''user à la tâche, j''utilise maintenant mon blender en y mettant les pommes de terre coupées en dés et je mets l''oeuf aussi pour permettre au blender de ne pas peiner à broyer les pommes de terre. Bon appétit ;-)', '2018-03-08T11:51:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 33a4ac81-b254-43d1-9128-30143409ff2e, 'Oh la la une vieille recette de mon enfance du côté de ma grand-mère maternelle polonaise ! En version sucrée c''est un délice !!!', '2017-03-09T22:45:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 9dbcb4f8-bebd-419c-b453-e0168592dbbc, 'Merci pour cette recette qui m''a rappelé des souvenirs d''enfance. J''ai ajouté du persil car ma maman en mettait !', '2015-06-21T14:47:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, d85df212-6a8b-424d-9322-335933087d07, 'J''adore cela me rappelle les restaurants aux US. Il faut bien les cuire 10 minutes et utiliser une forme pour qu''elles soient rondes...', '2015-06-17T18:56:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 7bb3fc33-bf5a-4fb3-8e44-a549b5ec7318, 'Belle découverte. J''y ai ajouté des oignons blanchis.', '2015-05-27T12:19:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 926065e5-0c86-4186-bd7e-1c30842ad5e7, 'Cette recette est en réalité d''origine biélorusse, elles sont super bonnes !', '2015-05-20T19:13:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 782daecb-b7a4-475c-8666-8dae23a40fa0, 'Voilà exactement la recette de ma maman adorée que de plaisir de redécouvrir ce bon goût MERCI.', '2014-11-12T17:20:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 05984bcb-a7b7-4727-81b3-e33c8f2cef26, 'Accompagnement idéal froid avec du saumon fumé !', '2014-07-02T15:06:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 27fb1c6d-ac58-4895-900f-78ee00938b86, 'Très bonne et facile à faire tout le monde à apprécier ', '2023-09-30T12:05:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 2d471db1-9a72-4aa3-98bd-6e2369e68cf5, 'Très bon les enfants adorent', '2023-03-22T15:22:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, bfe16996-6e59-4a48-84b8-5c612b869d5f, 'très bonne recette un régal 😋', '2023-02-20T19:40:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 8324d627-0789-43df-921e-1f810526a817, 'Ma mamie en cuisinait (j''ai 70ans), j''en fais encore, nature + épaisse avec une viande en sauce, fine petite et bien grillée avec des lardons et une salade.', '2023-01-01T08:48:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 9245bd94-3aa9-441e-962a-88e1bb8b434d, 'Très bien ', '2022-03-21T11:40:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 6fb5d247-d73d-4ec0-959b-c21cca472e1c, 'Ma mère les faisait aussi avec la même recette', '2022-03-17T17:10:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, f442148f-6511-484d-887d-3d97fb787c61, 'Délicieux', '2022-03-15T18:59:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, c3a73234-903e-425f-954d-4a6ef3cf12a7, 'Très bon ', '2022-02-16T01:37:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, fc020645-ea4a-4259-8b14-8591a0355feb, 'Facile rapide et très bon dans un burger
', '2022-01-17T12:45:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 993f149d-c2e4-45db-ac29-10081f03bae6, 'Top', '2021-11-23T00:03:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 6bf597a5-c671-417e-92fa-ee23f98c8027, 'Très bon !  !', '2019-08-22T20:57:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, ee49298d-9df6-4a4d-afec-7a8fd93302e8, 'La recette que ma maman me faisait au goûter ... Un délice sucré. 
Évidemment réduire la pomme de terre en purée, pas simple du tout ...', '2019-05-22T03:10:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 991c5c7c-b3b0-4082-a4fa-561efb9c3912, 'Recette très simple a réaliser savoureuse, et qui permet de varier l''emploi traditionnel de la pomme de terre.', '2016-10-11T11:51:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 1ab2a654-ee8d-4e23-961c-428cc8fbda64, 'Galettes croquantes et fondantes à la fois, un régal, on est vite rassasié par contre. J''y ai ajouté un mélange de coriandre/persil, et une pointe de curry. Très bon.', '2016-10-02T13:37:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 0e3c566d-6bf6-4ceb-9017-433845d7ff1e, 'Extrêmement bon ! A ravie a tout le monde', '2015-10-05T20:28:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, cb05d02f-7843-4ace-92c6-c59953bf29f0, 'Très bonne recette, à refaire très vite ! ', '2014-11-13T22:17:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, aff90234-5b0f-4c4a-9d25-ac43ee6347f6, 'Très bon on peut ajouter ce qu''on souhaite en épice et même champignons excellent humm ', '2014-10-27T14:37:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 6e42de53-e021-4429-bc4c-864c97dc1f5b, 'Très bon', '2013-04-27T18:36:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 46c12476-3cc0-4aba-a1b1-db2404883172, 'J''ai fait une seule galette pour 2 en ajoutant un peu d''oignon mais j''étais un peu perdue pour le temps de cuisson. Accompagne bien des grillades.', '2010-09-03T17:39:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 72ea5c75-3253-4fff-a570-2e846676a00a, 'Je trouve ces galettes assez bonnes, mais il faut rajouter quelques ingrédients pour rajouter du goût, comme du parmesan ou du jambon par exemple...', '2010-04-12T22:58:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, af11c30f-0822-4cc0-ab65-46497fe7dde2, 'J''ai gagné des points auprès de mon polonais à moi :) Super facile à faire! Je les ai cuite dans de l''huile d''olive. C''est super facile à faire et ça donne un effet terrible. Merci :)', '2009-10-21T23:44:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, cee26d9b-c98b-4ae6-81d7-db21f8cd74a1, 'Très bon, j''ai ajouté du parmesan et des allumettes de jambon pour les enfants. Mon premier fils qui est très difficile a adoré !!', '2009-08-17T19:24:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 5b651040-4f52-4261-835b-403698e95ff1, 'J''ai adoré et ça m''a complètement renvoyé aux repas familiaux de mon enfance ! Mon fils de 2 ans a lui aussi adoré, surtout saupoudré de sucre...', '2009-03-21T14:41:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 0684d451-b472-47d2-93f8-d9fc16e1be7f, 'Je mets les pommes de terre râpées à égoutter quelques minutes dans une passoire avec un peu de comté ou de gruyère râpé, c''est pas mal aussi.', '2008-11-15T19:25:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, d8f4a48d-5b8c-4874-b3ef-73e4e12c74c4, 'J''adore ces petites galettes. C''est exactement la recette que nous avait faite des amies Tchèques. Avec une pincée de marjolaine dans la préparation. On peut aussi ajouter quelques lardons allumette. Seul bémol d''un point de vue pratique, c''est plus fastidieux que ça en a l''air.', '2008-05-18T14:16:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, adfc9e0c-a8c6-47b1-8c18-29211afa7eb0, 'Vraiment bon. J''étais assez préssé pour faire à manger, cette recette est vraiment simple. Elle me rappelle les galettes que ma mamie me fait. Alors merci de la ressemblance de la recette ', '2007-12-19T14:00:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 1c561a59-3b75-4c98-89c6-85742bf24578, 'Miam Miam, super bon, rien à rajouter, aussi bonnes qu''au Pays!', '2007-05-01T19:26:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 3934e1bb-ecc4-4ffe-ada4-7cebb3b33553, 'Excellente recette! Servie avec une salade verte et une grillade c''est parfait. Simple, rapide et bon...j''adore.', '2006-11-27T00:36:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 00bc4683-db08-4cb1-bae9-b3b38c2eb8d8, 'D''après mes voisines polonaises et hongroises, un excellent remède contre le mal du pays!! Encore meilleur avec plus de pommes de terre, quelques oignons râpés et accompagné de yaourt aux herbes et/ou de ketchup. Mmmmm...', '2005-02-09T00:23:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 5e22f03c-582a-4aa1-8a8a-e84c79ca9d96, 'Pour les galettes salées, rajouter un oignon râpé et déguster avec du fromage blanc à l''ancienne avec fines herbes, sel, poivre.', '2004-02-22T11:29:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 317f7ead-8183-4377-a2ad-741fb55dc096, 'Tout d''abord merci pour cette recette qui a régalé mon ami et moi aussi d''ailleurs... La recette est fidèle au souvenir que mon ami a de celle de sa grand-mère polonaise.', '2003-11-11T11:16:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14804, 59b054e6-16b2-4659-95d2-6061308f5c02, 'Pour des galettes croquantes, effectivement, il faut utiliser une cuillère, mais si on veut une galette plus tendre, alors il faut faire cuire la masse complète dans une grande poêle (c''est alors qu''on peut fourrer la galette au jambon, etc...). Si vous optez pour les galettes croquantes, petit conseil: servez les, chaudes, avec de la compote de pommes (froide). C''est divin!!!', '2001-09-09T16:14:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, 71cb7c12-b5af-49a6-82eb-52c93a65aaeb, 'Le sirop est top mais c''est vrai que le yaourt n''est peut être pas si adapté que ça ! Mais c''est bien frais après un bon repas !', '2013-07-10T12:04:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, 8ae19cfa-8170-4700-8310-c4bb6a769074, 'Pas mal mais un peu trop le goût du yaourt.', '2013-04-21T17:23:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, 19eb0293-b029-469d-94d2-e76ad7401b69, 'Délicieux. J''étais sceptique au départ pour le vinaigre balsamique. J''avais tort, c''était très bon. ', '2012-10-30T15:06:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, cdadf36e-ca67-407e-acd9-8783f01da12a, 'Délicieux, rapide et léger (avec de l''édulcorant et du yaourt à 0%). Recette adoptée, et selon moi, passer le jus des fraises au chinois n''est pas nécessaire. J''ai ajouté du spéculoos broyé parce que je n''avais pas de pistaches. C''était tout de même très bon.', '2012-05-08T01:36:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, 5a469941-c168-4a47-8a38-bde9909c7191, 'Merci pour cette très bonne recette !! Les invités ont adoré ! J''ai suivi les conseils et j ai mis du biscuit écrasé au fond et du sucre dans le yaourt. J''étais sceptique pour le vinaigre balsamique mais ça donne un très bon goût, vraiment délicieux !', '2012-03-05T01:42:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, 6453ea09-936e-46f6-b09f-0f6a7fc1ee90, 'vraiment délicieux et avec trois fois rien!! J''ai mixé mes fraises pour épaissir mon coulis et n''ayant de fromage blanc, j''ai utilisé des yaourts nature!! à refaire absolument!!', '2012-02-27T21:50:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, 5f59ebc2-b6ea-491f-92ea-3da050717e70, 'On a beaucoup apprécié ! J''ai mis un peu plus de sucre. Les pistaches donnent un très agréable goût aux verrines. Merci !', '2011-04-17T22:28:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, bf08a83f-fe83-40ff-a73d-e29660a01ad6, 'Excellente recette et très facile à faire... encore bravo !!', '2010-07-19T19:50:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, 5ce84180-9e04-41a3-ad15-71bafad7e4cb, 'J''étais sceptique avec le vinaigre mais je suis vraiment emballée, c''est vraiment très bon et fin même sans les pistaches que je n''avais pas', '2010-06-18T10:53:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, e45a2743-e32c-449f-969e-9a1db6ace1cc, 'Très bonne recette, j''ai ajouté une couche de boudoirs cassés au fond, et à la place des pistaches, j''ai fait une chapelure avec le reste de boudoirs. Excellent très frais, à préparer quelques heures avant la dégustation pour garder le croquant des boudoirs !', '2010-05-31T18:58:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, 1b31ef4b-9964-41ba-b746-52da98e8b5a0, 'Excellent. Très simple et très bon. Je n''avais pas de yaourts alors je les ai remplacés par du fromage blanc battu. Je n''avais pas de pistache non plus alors j''ai décoré avec une feuille de menthe. Dessert réussi!', '2009-05-05T18:52:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, f48eb5f6-97d0-492b-9397-c693dda9f5fd, 'Un seul mot : excellent!!!  Yaourt trop liquide ? Pas de problème :  Ajouter une feuille de gélatine  dans le mixer et le tour est joué ! Recette hyper rapide, goutteuse et très rafraichissante.. Une merveille !', '2009-03-06T11:01:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, 2e470875-d18e-4a5e-ad71-a3c9441d4240, 'J''ai adoré ce dessert! Comme j''avais entamé aussi une boîte de lait de coco, j''ai mis la fin dedans ce qui a donné un bon goût à la mixture de yaourt. Sur le dessus j''ai décoré avec de la menthe et pas de la pistache, pas mal aussi !', '2008-05-14T13:49:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, e5367211-bdd8-4eb4-aa9a-114e5bf9630c, 'Dessert très bon, mais un petit bémol pourtant car le yaourt était trop liquide, ce qui rend la présentation moins jolie, et c''est moins agréable à manger! je referai ce dessert avec des petits suisses, je pense que ça se tiendra mieux! En revanche, super idée les pistaches! C''est original et bon! ', '2008-05-12T17:18:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, 060d524f-6693-4aed-8de6-1ec08cbe9e6f, 'Recette facile. Dessert très frais. Avec 1 barquette de fraises, j''ai fait 4 verrines par contre compter 2 yaourts pour 2 verrines. Je n''avais pas de pistaches sous la main mais c''était excellent. On s''est régalé.', '2008-04-30T20:50:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, 773091d4-0e05-47ce-a58a-5cd625c430af, 'Super bon. J''ai rajouté du sucre au yaourt et un peu sur le dessus des fraise au final. A refaire sans hésitation.', '2008-04-06T11:35:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, 55fd4de2-f086-4ea6-93ec-53df196075fe, 'C''est très bon et présentable. Au lieu de presser les fraises pour recueillir le jus, j''ai mixé le sirop une fois cuit. Ça le rend plus épais. La prochaine fois j''en ferai plus.', '2008-04-05T19:44:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, 53539eea-1ac5-4753-975c-3c2b65ee7405, 'J''avais acheté des yaourt non sucrés et ça faisait trop fade: j''ai rajouté (dans les 4 yaourts) 2 c. à soupe de sucre et 3 sachet de sucre vanillé et des copeaux de chocolat. Très bonne recette, merci, mes invités été ravis!', '2008-03-24T11:32:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58018, a7231445-943f-4ce3-843e-077b2e5d71fd, 'Très bon et léger. En revanche, et c''est dommage, il manque un peu de sucre dans le yaourt. Pourtant je ne suis pas une fan de sucre!!', '2008-03-21T14:38:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 7aeaa1db-c1e0-4479-8a63-cab7e6edb198, 'Très très bon !!! ?
Je n''ai pas ajouté de glaçons comme se sont des framboises surgelées. 
', '2021-02-12T18:31:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 7175147b-0c0c-4cbc-9b7b-94565aacf361, 'Recette testée ce soir, tout le monde a aimé. Par contre avec des framboises surgelées, les glaçons sont inutiles, ils ajoutent des petits éclats croquants par vraiment agréables. Cependant le goût est excellent !', '2015-07-13T02:03:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 72a6ba14-4791-4039-87d1-13a7a7674924, '🫶🏼', '2023-05-26T21:36:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 3f7c90cb-5726-4437-b62e-60a26f486040, 'Avec des framboises congelés pas besoin de glaçons.
Super bonne recette, bien évidemment on peut la faire avec d''autres fruits :)', '2020-04-01T15:34:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 993b759d-34b0-437e-a15d-0709342734c7, 'Je n''ai mis qu''une étoile car le millier de pépins est vraiment désagréable à boire. En revanche, si on prend le soin de filtrer les framboises avant d''y ajouter le lait et de remixer, ça vaudra 5  étoiles.', '2019-05-21T00:45:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, b5b0915e-8de4-4f4e-b1b2-359ccf1444cc, 'Délicieux !', '2016-07-22T17:23:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, d4f95e09-cff7-4e45-8d31-31feaf2f4451, 'Simple mais excellent !!!!!', '2015-12-23T00:18:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, f55e830b-1ff9-4759-8ca0-f9f89798d277, 'Très bon je n''ai pas mis de glaçons mais j''ai mis un peu moins de sucre et j''ai mis une boule de glace à la vanille.', '2015-07-14T19:47:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, f91e81ac-d874-47c3-929d-9b3bc33bce92, 'Très bon, j''adore !!', '2015-05-05T20:44:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, e0a0a909-3efd-42ae-83ff-fb6ba911bd2a, 'Super, rien d''autre à dire. Je garde la recette de côté !', '2015-04-13T18:34:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 416906fc-be59-4d9b-9259-bf0a9f133d52, 'Très bon, je n''ai mis que 4 glaçons par contre. J''ai suivi les conseils et ajouté 2 gouttes d''arôme vanille. A refaire car simple et rapide.', '2015-04-07T18:55:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 9beadaed-4b44-450f-890d-581a20c8ab01, 'Très bonne recette.  Comme les framboises sont déjà congelées, ce n''est pas la peine d''ajouter des glaçons.', '2014-09-21T13:02:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 53e35d7e-d501-419a-920d-b4a345e04888, 'Très bon ! Toute la famille adore ! Demain, j''essaye avec un mélange de fruits rouges. ', '2014-07-30T20:37:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, fb6cc2fa-1a4d-4bba-8dfc-6150b4e89789, 'Excellent !!! Perso, j''ajoute un peu de sucre et pas de glaçons. Avec les framboises congelées, c''est bien froid. Idéal pour cet été !!', '2014-07-18T16:32:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 87d05302-e224-42c7-9561-765adbe0a271, 'Délicieux ! J''ai dû ajouter un peu de sucre. Mais ça reste très bon !', '2014-07-16T21:26:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 5d9b3619-b683-4cdf-b626-88dc92871f7e, 'Il est délicieux, mais c''est dommage qu''il y ait plein de petit morceaux de framboises. ', '2014-07-03T16:19:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 61455a3c-97f9-46c0-8057-5cadfa082500, 'C''est pas mal... mais y a trop de mousse... et je n''ai pas de glaçon donc j''ai laissé refroidir dans le frigo pour voir... après c''est à voir.', '2014-05-11T16:41:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 535a949f-5ee5-4f16-b9d0-20ac0ce7fd35, 'Testé à l''instant, excellente recette super simple et rapide, perso j''ai juste rajouté un peu de vanille en poudre et diminué la quantité de glaçons !', '2014-03-15T17:25:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 6a8c14cd-ab9b-4ad3-94c6-bce9346c3f01, 'Très agréable. J''ai ajouté un peu d''extrait de vanille pour rehausser le goût.', '2013-06-10T13:34:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 37644cd3-f53e-4810-a19c-f73b256c6aab, 'Très bon.', '2013-03-02T08:11:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, ed93abe9-a071-4712-8cfd-ea036e46c1f7, 'C''est excellent seulement je ne sais pas si c''est la qualité de mes framboises ou non, mais les petites graines du fruit sont trop nombreuses et cassent la texture agréable du milk-shake.', '2012-06-02T16:23:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, d4ea55b9-d780-47f2-a8fa-f892449d7fd3, 'Trop le goût de l''eau avec les glaçons et pas assez de milkshake.', '2012-04-29T23:42:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, aaa12473-8842-459e-a577-8b2f03409ee3, 'Très bonne recette, j''ai adoré !', '2012-04-14T10:01:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, f2f42984-f2ff-49d5-bfa9-f1eb27b3b065, 'Excellent !!!! ', '2012-03-16T18:34:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, ab0b720f-bbdb-4b94-a587-8e4b20a3b8c9, 'Super !!!! Ma fille a adoré !!', '2011-09-11T00:01:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, e32dab97-dd5b-446c-9425-771e3abb873d, 'Ma nouvelle recette fétiche, je cherchais depuis longtemps une recette de milk-shake facile et sans crème glacée, celle-ci est parfaite, et surtout, elle est sucrée juste ce qu''il faut.', '2011-09-08T07:40:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, e05494d6-fd3a-4da0-914f-a8a75db6b755, 'Testé et goûté à l''instant : délicieux milk-shake ! proportions parfaites - merci !', '2011-02-06T17:46:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, f6170c38-341a-49fb-9e76-0e9f25bc25ce, 'Simplissime et délicieux !! Proportions parfaites des ingrédients. J''ai juste rajouté un petit sachet de sucre vanillé.', '2010-07-15T05:57:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, b6c717a0-9079-4731-b770-86504eae3dfe, 'Magique les enfants ont adoré !!', '2010-07-06T18:12:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, cfe72fac-78cd-4c77-9107-445a9683733a, 'Excellent ! Je n''avais pas fait de glaçon : j''ai mis de la glace à la vanille et c''est extra !', '2010-05-02T01:24:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 89501b38-0a26-4624-98d9-228bdc3abe58, 'Rapide, bon et forte impression au gouter des enfants !', '2010-01-27T15:14:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 684c7dac-de36-4c62-bcc5-acb127fbed0a, 'J''ai utilisé des framboises fraîches de mon jardin, et c''était super bon! Tout le monde en a repris. Seul souci : il n''y en avait pas assez :)', '2008-08-24T23:40:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, 7190e52c-0c95-458c-a540-e0603cf1ecfb, 'Super bon! j''ai mis des framboises fraîches, du lait à la vanille et de la glace à la framboise à la place des glaçons! Résultat extra, mes enfants ont adorés et moi aussi', '2007-08-20T18:02:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, ec1f95d9-bcaa-44b0-ab43-1a4c19846d6e, 'Bof! J''ai eu un souci avec mes glaçons qui ne voulaient pas être mixé! Et il manquait un peu de sucre! Je réessaierai quand même avec de la glace pilée et un peu plus de sucre.', '2005-11-06T14:52:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, ea4e0b2f-2533-4880-ac7d-640439da0288, 'J''ai fait une petite modification: au lieu d''utiliser du lait et des glaçons, j''ai pris du lait concentré non sucré très froid : la consistance est parfaite, crémeuse à souhait, et on en redemande. La prochaine fois (très bientôt), j''essaie avec de la banane.', '2005-06-04T00:59:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22004, f7eb10b6-e078-499e-8f8b-6642e2f77cf2, 'Vraiment délicieux!! Facile et rapide... Bravo!', '2004-08-10T18:32:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 172edff4-e3b2-42a0-88d2-d9743130ebcf, 'La recette de ma grand-mère ! Elle laissait égoutter les pommes de terre râpées pour récupérer la fécule, (jamais de farine ni d’œuf), ajoutait - un peu - de poireau à la place de la ciboulette et nous dégustions nos galettes avec une compote de pommes du verger en guise de dîner. Miam !', '2019-04-04T14:09:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 7d6f823c-5a0d-461f-9b85-ee57c402c841, 'Très bonne recette ! Avec ciboulette, emmental et oignons frits. Pas besoin de farine...il suffit de râper les pommes de terre et ne pas les rincer et ça se tient très bien. Cuites 5 min à la poêle puis 15 min au four avec tranche de comté à 180°C.', '2017-03-22T22:15:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 924cf634-4f00-480a-a684-34b3875fe98a, 'Attention à bien les faire à 1cm car sinon fini en purée 😁 sinon recette qui plaît à toute la famille 🥰', '2023-04-06T20:29:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 970d1f30-9929-487d-9210-1ac956353ce7, 'Super bonne recette ! 
Avec un œuf en plus pour ma part et des lardons !', '2021-11-28T13:41:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, b744b61e-7b02-44a8-a3e6-776449953673, 'Très bon. J''ai mis 2 oeufs et moitié farine moitié maizena pour lier.J''en ai fait plusieurs fournées: une "nature", une avec pomme de terre - courgettes, un mélange pomme de terre -courgettes-tomates, pomme de terre -carottes et même avec de la laitue! Simple et complet. Parfait!', '2015-08-15T22:02:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, af25792d-aea1-45c6-bf5e-62f6b7bed578, 'Excellent, rapide et pas cher ! 
', '2023-01-26T17:27:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, de14a1a8-0ad0-482c-af76-e63159d29c63, 'Très facile et très bon. Tout le monde a adoré. Perso, j''ai mis du paprika et pas de ciboulette.', '2023-01-07T00:19:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 4ac5f7c7-e7ba-42c3-a065-8f8c22867133, 'Je l''utilise dans un hamburger fait maison en les confectionnant un peu plus large égale à la taille du pain. Un régal.', '2022-04-14T07:24:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 909162a1-d4ce-40ed-ae49-6862620d1fc0, 'Top et facile à faire !', '2021-12-28T18:52:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, d834de86-f8d3-490c-af8a-83ff3273584c, 'Un vrai délice, à refaire absolument ! (j''avais rajouté des lardons pour une recette un peu plus gourmande) ', '2021-06-28T15:16:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, a7534788-3fcd-4eed-b5da-1d86a3fbe314, 'J''avais râpé mes pommes de terre avec une grosse râpe et pour façonner les boulettes j''ai cru que j''allais galérer mais pas du tout, j''ai fait comme il est dit dans un commentaire j''ai pris un écumoire et ça a bien tenue, très bonne recette, je n''ai rien changé, je la referai avec plaisir.', '2016-11-11T18:54:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 8d8129fc-08d3-48c0-b303-6e29530a12d0, 'Mettre moitié pommes de terre moitié courgettes râpées, bien essorer les légumes râpés avant de rajouter les autres ingrédients plus un peu de curry. C''est délicieux !', '2013-12-02T19:43:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 0c248e6d-1353-4b00-bd1e-c3905eba9f78, 'J''ai rajouté 2 gousses d''ail et remplacé la ciboulette par du persil. Être généreux en huile et c''est très bon !', '2013-02-22T00:18:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 9bdadba1-6821-4ca1-b996-b1b72075b6be, 'très bonne recette c''est la première fois que j'' en fais mon fils se régale. perso j''ai rajouté du thym et du curry et cumin pour relevé le goût merci pour la recette.', '2023-09-03T13:16:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, a7f59604-e778-4524-baa3-2e820a826f91, 'très bonne recette, le résultat est comme voulu en suivant la recette je conseille ', '2023-04-27T19:35:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 3d95b2df-ef10-4705-8e8c-f9377b81613d, 'Cool ', '2023-03-31T01:09:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 5871a504-4a6e-49eb-ae31-32088f097bcc, 'Encore meilleur avec des patates douces :))', '2022-12-27T13:59:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 55378a86-f165-4d0e-b7bb-c46dca7f1496, 'Très bon', '2021-12-26T22:51:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, da8cc685-7567-4569-a880-5eef34e4c808, 'Excellent 👏', '2021-12-13T13:05:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 7e6eb072-2317-47aa-a8c4-16ac9abdc1a3, 'Bien et assez rapide !', '2021-09-09T16:52:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 7ebf63c3-bf34-4388-aa42-906169e8d2eb, 'Super bon 🥰', '2021-05-24T19:43:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, d4d4565b-57f7-4722-8e16-bccbc484c7ab, 'Très simple et très bon', '2020-04-03T12:32:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 94684954-af65-464a-9dfe-a6bd8ddb7a3b, 'Pour 5, j''ai mis 12 pommes de terre que j''ai râpées gros, salé et poivré pour ensuite mettre dans une passoire pour faire dégorger. J''ai rajouté 2 oignons et 2 cuillères à soupe de farine semi complète et bcp de thym. Toute la famille a apprécié.', '2019-03-14T11:40:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 385bc12b-ad92-4ec5-a2a4-4970684afabf, 'Délicieux j''ai remplacé la ciboulette par le persil  ', '2016-07-26T20:39:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 4d92ce30-e232-447c-84f9-dbbb8ca72dda, 'Superbe recette.', '2016-06-02T00:13:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, fb0d6ae9-02c5-414b-b129-dd48f4cb5164, 'Bonjour à tous. Temps de cuisson à surveiller car 10 min trop long. Petite astuce pour faire les galettes prendre deux écumoires c'' est beaucoup plus simple et efficace. Bon ap. Annie', '2015-10-27T12:38:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, fb14cd2f-f310-435c-a34c-f197a53bac40, 'Ça ne marche pas pour moi ... ', '2015-10-22T15:22:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 8b7a1562-0e9b-491e-b64d-7a1a4d6a96db, 'J''ai bien aimé ça, petite astuce pour ceux (rare) qui ne le savent pas déjà, rappez vos pommes de terre tôt le matin, mettez les dans un torchon attendez de devoir finir votre préparation, les pommes de terres ont noircies ce n''est pas grave, tordez le torchon et l''eau sort le noir aussi. Bonne dégustation.', '2014-12-21T11:57:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 239ad612-9955-4a95-bbe4-10aabcadf9a1, 'C''est bon mais j''ai essayé sans farine et c''est meilleur encore !', '2014-07-30T15:08:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 0500be0a-6b95-4c98-b5b1-7a023b5eaf7e, 'Très bon mais la prochaine fois j''ajouterai d''autres herbes (de Provence, p. ex.).', '2014-05-03T21:56:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 71eaef55-aa87-4821-8701-5c1dfcbebbab, 'Ces galettes de pommes de terre sont très bonnes accompagnées de compote de pommes...', '2013-12-02T19:06:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 8ae40c45-3ea7-48b0-a0e1-01496cf32ff2, 'Délicieux ! Réalisé avec de l''aneth dans le mélange et servi lors d''un brunch ! Un petit truc, si vous ne voulez pas que vos pommes de terre collent trop durant la cuisson, rincez les après les avoir râpé !', '2013-03-23T02:22:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, ca5645dd-3dd8-4bad-b72b-de61695010ab, 'Très bon mais j''ai eu un peu de mal à la cuisson pour que ça ressemble à quelque chose de sympathique à déguster.. ', '2013-03-20T21:29:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 18af5e43-712c-4418-b527-cffc0eafc3b3, 'Recette faite à la lettre mais on dirait que quelque chose est ou a raté... Hormis le fait que quand j''ai essayé de les retourner, deux se sont cassées (plus d’œufs et farine la prochaine fois) et bien je trouve le goût des oignons trop prononcé (donc moins la prochaine fois). C''était une première pour moi de faire des galettes de pommes de terre et je recommencerai certainement. ', '2013-02-12T23:05:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 07e94432-d8dc-4a40-88eb-f24c044c138d, 'Fait ce jour de temps froid. Simple à réaliser. J''ai ajouté du piment d''espelette pour relever le goût. J''essayerai avec du fromage râpé. ', '2013-02-04T18:23:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 5c120b0a-2ba3-4c3f-8cbe-62a8d59d6d33, 'Très bon :D Mais on peut rajouter un peu de noix de muscade. A refaire ;)', '2010-06-28T22:29:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, d181ec06-c701-4796-9e55-285a4da18add, 'J''ai fait cette recette ce midi, et les ai faites au four dans des moules en silicone et c''est très bien, il faut mettre un peu plus de sel car c''est fade.', '2010-04-14T19:58:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 0d4682b1-783b-4161-a718-5a3a291f9e94, 'Pas mal du tout. J''ai fait dégorger les pomme de terre après les avoir râpées en ajoutant du sel et en les laissant reposer dans une passoire. Cependant, j''ai eu un peu de mal à faire des galettes compactes. Ne manque-t-il pas quelque chose pour y remédier ?', '2009-01-27T19:02:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 405655e1-7666-432d-9f06-d63da0a39f8c, 'Excellent! Mais attention à la cuisson: commencer dans une poêle bien chaude pour saisir les galettes (et qu''elles n''absorbent pas trop d''huile) puis réduire le feu, afin de les faire cuire en douceur, sinon l''extérieur est trop cuit avant que l''intérieur ne soit tendre. Accompagnées d''une salade et de jambon de parme... Un vrai délice !', '2006-04-17T05:00:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, dbe08398-19fe-41ce-aa4b-40844c9294d9, 'C''est très bon ces galettes de pommes de terre !', '2022-09-11T19:18:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 504efaed-a46f-45cd-9904-87456b3cd8d7, 'Très bonne recette ! J’ai mis 1 patate douce en plus des pommes de terre, cela fait des galettes plus colorées et un doux mélange de saveurs !', '2021-04-15T13:59:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 4b221c1a-f3b1-4f97-9c0c-b1ce8cd01de8, 'C''est extrêmement fade. Pourtant j''ai assaisonné avec sel, poivre, épices, persil... J''ai peut-être loupé quelque chose.', '2020-10-19T22:45:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 633707e6-f9df-41dc-9554-47489fdf389c, 'Très très bon !', '2020-10-14T14:54:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, e65a7c8c-daec-4abe-a0ed-886d0db7f4e1, 'Très bonne recette,simple et efficace !', '2020-07-01T14:11:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, cb05063a-8d26-462d-ae4e-c7a76bb8a61b, 'Très bon !', '2019-12-16T21:39:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, efc19f24-24a0-40fb-a176-a9cb69d2f75b, 'Très bonne recette, j''ai rajouté une courgette, un poivron, paprika et curcuma excellent !', '2019-10-25T12:51:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, dba0f618-995e-4a70-90c8-e0f5e70afb5f, 'Au top ! Rien à redire', '2019-08-18T01:50:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 8131f29d-45d4-44a2-b262-905026351a5b, 'Les pommes de terre , ce n''est pas la peine de les râper, faite-les cuire dans l''eau et écrasez-les avec une fourchette.....!!! Un vrai régal.', '2019-04-04T14:12:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 9cb6ec3b-3dad-4f9e-8857-c22313d2faa8, 'Mettre beaucoup de ciboulette pour obtenir du goût. Avec 1 oeuf 500 g de pomme de terre et 1 cuillère de farine est suffisant.', '2019-01-08T14:38:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 527fe2b8-6fa5-4b14-be48-874904fc7832, 'J''ai mis beaucoup trop de farine car je ne vois pas comment on peut les aplatir dans la poêle sans coller au doigts.', '2017-08-01T15:21:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, d0238cd6-e0a5-48f9-b7fc-cc5258418163, 'Très bonne recette la prochaine fois j''y ajouterais du fromage râpé ', '2017-06-18T22:19:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 0873bef5-689b-4d71-afb7-d149949d6afd, 'Bonne recette de pommes paillasson', '2015-08-04T03:20:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 30b49433-799b-421c-b6f3-9be0cbb4d4cf, 'J''ai pas trop bien réussi, à mon avis il fallait plus d’œufs et de farine !', '2015-07-12T20:14:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 8fbb2c8c-2a7e-4648-ab81-c1197098a775, 'Très bon ! Déjà refait avec des légumes type carotte, courgette...', '2015-04-26T18:37:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 1e5387d6-0571-4e34-86c6-94ad846ab9ea, 'Testé mais cuite  dans un gaufrier avec une tranche de saumon fume + une salade verte delicieux', '2015-03-31T13:10:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 8a9a7465-f575-42dd-9a57-c4fcc0ea8f5d, 'C''est une recette typique des polonais : ils ajoutent de la crème fraîche pour les déguster.', '2014-08-12T22:47:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 3cc6a9a7-ed2d-4452-a691-0be960476f51, 'Je l''ai faite. C''est une nouvelle façon d''accommoder les pommes de terre. Un régal pour ma famille. A refaire volontiers', '2014-06-06T13:56:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, 8b5163b5-8b17-4b68-84ec-f71d095b1e55, 'Très bon', '2013-12-13T16:18:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, a0b4b88a-1300-4f90-b4dc-4f846d1db562, 'C''est bon, j''ai ajouté une courgette coupée en petits morceaux et une 3ème cuillère de farine. C''est très bon également.', '2013-12-08T04:59:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12315, ffc9b432-c308-4f84-a052-9ba3e2159ab9, 'Je vais faire cela pour ce soir hum quel régal avec une salade.', '2013-12-05T15:07:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201187, cf0a44fc-d3af-4584-a202-7e7aa8375174, '👍🤩', '2021-07-08T21:25:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201187, 9ded0fa0-3443-4964-b36e-b6dfca9bbab6, 'Je me régale !', '2021-07-08T17:55:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201187, b52f7f45-6b82-41b2-ba51-6ee849bc3e12, 'Top et rapide', '2021-07-08T16:36:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201187, 97f34e4f-81ba-4135-ab20-81a1a8add1a8, 'Waw', '2021-07-08T10:51:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201187, c880ee66-ddda-4fcc-b121-d0224a51ab7a, 'Délicieux !!!', '2013-05-11T20:34:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 01acf694-1498-44b4-8956-100ab99f8816, 'Dommage qu''il n''y est pas assez de beurre car il devrait y avoir autant de beurre que de farine', '2024-03-04T23:37:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, ba2746a9-7985-4491-8e5c-aef19fe892e0, 'Délicieux ', '2021-05-09T17:35:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 799e9e6c-f4c0-45a7-9c18-e657f064ee99, 'Une tuerie!!!!!', '2021-02-23T00:28:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 3724ea5e-4e80-4014-bba0-f8f5ba49c186, 'Des quantites juste ce qu''il faut et un regal en bouche , merci pour cette recette ', '2020-04-18T23:43:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 6b172b57-07bf-4a30-99c3-21ff236fb960, 'Délicieux ! Même moi qui déteste les framboises j''ai trouvé ça délicieux ', '2015-02-06T23:01:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 1d1edd15-23db-4105-854e-c3eb4207e541, 'Tiède, avec une quenelle de glace vanille c''est une tuerie ! Le crumble est super bien dosé, pas trop gras, je conseille quand même le caramel maison qui prend 5 minutes et je confirme, les proportions sont pour une dizaine, moi j''ai divisé par deux !', '2015-02-01T13:43:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 437b5d9d-63fe-49f8-97c2-6579067c4726, 'Délicieux ! Même mon fils qui n''aime pas les pommes en a redemandé... Je n''ai pas mis de poudre d''amandes, cela préserve le côté croquant de la pâte et c''est moins riche.', '2013-11-19T19:15:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 63ad4fc2-d3cb-4447-8d60-6136ed73566b, 'Excellent dommage que ce ne soit pas très présentable. J''en ai donc fait dans des ramequins individuels. Même cuisson, pas de cannelle pour nous nous n''aimons pas, attention les framboises congelées rendent un peu d''eau, et la prochaine fois j''en mettrai 300g au lieu de 200g. ', '2013-10-05T17:12:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 9f6bd360-fc5d-4545-a9f9-12766cda0696, 'Très bon !', '2013-09-18T15:49:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 4daded6e-9e43-4fdb-ade3-bc18de61ba0c, 'Le mélange des textures et des saveurs... Miam ! Vraiment excellent ! De saison, privilégiez les framboises mûres, mes framboises surgelées ont rendue beaucoup d''eau. Autrement, il y en a bien pour 4 personnes, mais il va falloir assumer...!', '2013-06-09T19:33:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, fb641221-4e25-4e1d-af91-54d9cfa63498, 'J''ai oublié la crème et j''ai remplacé la poudre d''amande par des noisettes. Très très bon. Cette recette m''a réconciliée avec le crumble que je trouve trop sucré d''habitude.', '2013-03-24T07:03:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, ad5efa8c-ad8f-4816-8f8d-7313069172b8, 'Excellent !!!', '2013-03-06T17:48:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 3c19563f-67cb-4b41-84fa-33d64b474c6b, 'Super bon ! Mais j''ai légèrement modifié la recette : j''ai mis moins de pommes et un peu plus de framboises, j''ai fait caraméliser les pommes dans du beurre et une cuillère à soupe de cassonade (au lieu du caramel liquide) et j''ai ajouté les framboises quelques minutes en fin de cuisson pour que les arômes se mélangent bien. Et j''ai ajouté une boule de glace vanille sur mon crumble tiède (on est gourmands ou on ne l''est pas !) au moment de servir ! Un franc succès, à refaire sans hésitation !', '2012-10-07T22:26:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 14bdb577-ae51-4850-9cca-22f5691f39ba, 'Sans crème fraîche, ni caramel liquide ce crumble est aussi très bon ! Accompagné d''une boule de glace vanille tout simplement, mmh. Par contre avec de telle quantité il y en a facilement pour huit/dix personnes.', '2011-04-22T17:44:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, d9a5cdff-e535-451e-a136-20d7f6dcd0ed, 'C''est un délice. J''ai mis des framboises surgelées de mon jardin, les pommes aussi d''ailleurs, j''en referai car nous avons beaucoup aimé ce mélange des saveurs, canelle, amande ; enfin essayez vous ne serez pas déçus. Moi je garde cette recette.', '2010-10-21T09:30:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, bb5f799b-2086-4811-81ef-011ae00423fe, 'Très bon dessert, rapide. Mes invités ont adoré, à refaire.', '2010-10-03T16:34:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, e673a021-50c9-4c2b-affd-eb5b1817dbef, 'Vraiment bon ! Mon premier crumble. Sympa à faire avec les enfants. J''ai fait caraméliser les pommes dans le plat qui a servi de moule et j''ai ajouté les framboises en fin de cuisson (j''ai eu la main lourde sur les framboises mais qu''importe) Merci pour la recette.', '2009-10-11T19:29:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 726af36a-d00b-4822-92ee-b89f34a888d3, 'Un vrai délice! Tout le monde a adoré. J''ai fait revenir les pommes avec de la cassonade faute de caramel et j''ai utilisé 300g de framboises surgelées. Par contre, je n''ai pas mis de la crème. Bonne recette de la pâte.', '2008-12-05T18:41:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 14f51b4e-96dc-443c-9ea7-1ce4abd20cbe, 'Ce crumble est très bon, par contre je n''avais pas de pommes avec j''ai remplacé par des poires en conserve. Pour le caramel je l''ai fait moi même (sucre et beurre). Je n''ai pas mis autant de sucre (75 g) et j''ai mis 170 g de framboises.', '2008-04-27T22:19:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 606462ad-4080-4d03-a057-4bac8cbe0a21, 'Très réussi. J''avais pas de framboises alors j''ai mis des fraises à la place et j''ai rajouté des bananes trop mûres qui traînaient ! J''ai mis un petit peu de jus de citron pour relever l''acidité des fraises (le goût des bananes prime trop sinon!). Bon appétit. ', '2007-03-12T00:44:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 1d5a2b26-0bf4-4825-84b1-2d00db097767, 'Tous mes invités m''ont demandé la recette, c''était excellent... merci!', '2006-10-08T23:28:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, cccc1d9e-f97c-42a7-8d61-711d4ef98634, 'Un régal! J''ai adoré, et ma famille aussi! J''ai mis aussi du sucre cassonade comme le précédent commentaire. Comme mon plat était grand, j''ai multiplié les doses par 1.5 (donc 2 sucres vanillé, etc). Je le conseille, vous allez adoré ! Dessert très riche, mais une pure merveille. Merci !', '2006-09-14T16:04:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, ae5666e2-cbbc-42cf-b8d4-6dedfd027461, 'Le mariage pomme, canelle, framboise quelle merveille, j''ai juste flambé les pommes au calvados pour mon mari et je les ai fait cuire dans des ramequins individuels. Super bon.', '2006-03-26T18:38:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 174b6683-483c-46ee-b340-8d665e4c5386, 'Génial! Toutes mes copines ont adoré, et elles sont exigeantes. J''ai mis de la cassonade à la place du sucre. Je referais c''est sûr.', '2006-03-10T13:41:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 72b4efe4-11f8-454f-a1e2-d2d2b4a124b2, 'Très bon, bonne présentation. Je n''avais pas de caramel alors j''ai fait revenir les pommes dans un peu de sucre. A refaire.', '2006-01-28T20:37:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 8554d59b-d69a-40f8-af20-677c33b9c156, 'Les commentataires à table étaient: "à tomber", "TOP", "super". Bref, le meilleur crumble jamais goûté! Bravo !  ', '2006-01-28T09:54:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, c3288191-8528-4f01-8af4-9bdf9b61a7ee, 'Mes enfants, Marine et Tanguy, ont adoré le goût sucré-croquant-acidulé... Mais il faut dire, que je n''ai mis que 4 pommes, 400 g de framboises, et la crème pour le moelleux.', '2005-11-27T20:45:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, c0df0a70-98a4-4f36-ab1d-5125a0ac4426, 'Vraiment exquis! Chaque ingrédient donne un goût encore meilleur au gâteau !!! Je rajouterais éventuellement un tout petit peu plus de framboises mais... cela dépend des goûts !!!', '2005-11-11T14:25:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 82943539-a853-485f-994d-bdd9b1988691, 'Le mélange pomme-framboise est excellent. J''ai utilisé des framboises fraîches et servi avec de la glace vanille (pas trop sucrée), c''était divin... Pour la pâte, j''ai utilisé ma recette fétiche!', '2005-11-05T12:01:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 85669113-d673-476b-a23e-778d0aa5735c, 'Très bon et très facile, mais pour 4 personnes, on peux diviser les proportions par 2. Je n''ai utilisé que 4 pommes et cela suffit. A déguster tiède!', '2005-10-29T13:28:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 2d8dce84-2b1f-4108-931f-0834432db4d3, 'Un délice, tous le monde était ravi.', '2005-07-18T02:07:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 94c7cb12-2793-4507-962f-bdac0aa022e7, 'Très bon. Mais 4 pour les temps et unités. Trop de beurre, ce qui ne facilite pas l''émiettage de la pâte... 100 ou 80g doivent suffire. Diminuer la chaleur du four et rallonger le temps de cuisson de 15-20 mn pour cuire la pâte en profondeur et éviter que ça brûle.', '2004-07-11T14:24:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 0fb87e12-478f-4d1a-81a1-2a896a66619e, 'Simple et bon.', '2004-07-07T17:28:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30031, 6c2a105e-8c3a-4a5a-9127-dccffdb81775, 'De tous les invités (nous étions 10), la majorité a donné 5/5 sauf un à1 4/5 à cause des fruits rouges... Question de goûts! Cela m''a permis aussi de faire connaître Marmiton à mes amis.', '2004-07-05T16:15:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 1da01564-e154-4c1f-a54f-653ed4bfb61f, 'Très bon', '2020-05-22T12:49:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, fe2f8183-0780-4bbe-b7f4-0d9456ddcc77, 'Excellent', '2020-04-22T22:22:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 388ccacc-e814-4885-b2e7-d992c95cd5b6, 'Ultra bon et tous les convives adorent. Facile, rapide. Le plus long est l''épluchage des pommes.', '2019-10-26T07:35:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, ef502746-cc0a-4712-ae38-d9db0913b524, 'Un de mes desserts préférés! Je ne mets que 130 g de farine et j''ajoute 60 g de muesli au pépites de chocolat pour plus de gourmandise. Et j''utilise des fruits rouges surgelés passés au micro-onde quelques min.', '2016-02-13T17:01:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 8ccd567e-0d15-46c8-b340-b177ce73d560, 'Magnifique! Réalisé avec pommes + poires + mélange de fruits rouges. Pour le crumble: 100 farine/ 100 sucre / 100 beurre + noix si on en a. 60 g de choc suffisent à mon avis. Plutôt 40 min de four à 180°. Merci pour cette excellente recette!', '2015-10-22T23:48:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, c7070058-f47f-46f4-8908-27183ce8c056, 'Très bon crumble, fait vendredi soir, on a adoré, merci ', '2015-06-01T00:16:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 9a30fd4c-0a66-471b-9f59-5f1cf63c16d7, 'Super super bon j''ai également fait revenir les morceaux de pomme avec du beurre et je n''ai pas mis d''autre fruit car je n''en avais pas mais c''est juste un délice !!! Recette que je garde et que je referai !   ', '2014-10-01T18:41:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 0b77cdb1-15ef-4be9-9ee9-56489fa32c39, 'Délicieux ! Nous venons de déguster ce crumble et il est très très bon. Je l''ai fait avec des pommes et des myrtilles. J''ai poêlé les pommes avant avec de la cannelle et j''ai saupoudré le moule de poudre de noisette pour éponger le surplus de liquide. A faire et à refaire.', '2014-01-12T21:03:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 773949d8-e21d-40d2-895a-9b6602baeceb, 'Très bon rien à changer.', '2013-09-21T13:58:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 277b73bc-6c4e-44c9-a108-51fbf5a4bbd9, 'Franchement SUPER sachant que je n''ai que 12 ans et demi c''est super bon et en plus facile à préparer. Par contre moi j''ai chauffé mon crumble pendant 30 minutes. Il était super bon tout le monde a aimé ', '2013-04-25T19:34:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 0816407b-dc4c-4abb-bddd-514252399a3f, 'Je n''ai pas trouvé de framboises dans mon commerce de quartier alors j''ai ajouté des poires aux pommes Canada que j''ai fait revenir au préalable dans une poêle bien beurrée..et c''était vraiment excellent ! Tout le monde a adoré !', '2012-11-05T14:46:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 546a7d8c-f90a-4d6f-9dd4-38d5f54e6433, 'Tout simplement dé-li-cieu-se !!! Portions trop petites pour notre gourmandise... j''ai mis moitié moins de chocolat.', '2012-08-09T16:27:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 715db9ac-4682-4ed6-8073-ca40c0be1f10, 'Très simple et gourmand.', '2012-07-17T15:02:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, b5ec8373-5c4c-4aa7-b3e3-1da120237f04, 'Facile à faire et vraiment délicieux, mes invités l''on dévoré. J''ai eu un succès fou avec, merci pour cette recette.', '2012-07-06T20:40:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, e50e047a-de31-4aec-a5c8-d8facf7e248d, 'Bonne recette, facile à faire. Je n''ai pas de chocolat et ai fait revenir mes pommes à la poêle avec du beurre avant pour un côté fondant.', '2012-06-24T12:23:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 5220e910-a5a7-44f8-826b-8e0acc0c401c, 'Suite aux précédents commentaires, j''ai réalisé le crumble avec 225 g de farine, 125 g de beurre, 100 g de chocolat, et un peu moins de sucre. J''ai cependant mis 4 pommes, et fais décongeler mes framboises la veille pour éviter qu''elles dégorgent dans la préparation. Au four à 210°C pendant 30 min, un vrai régal. Merci pour cette recette originale.', '2012-02-19T19:35:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 989fbb7d-65b5-48f3-8c42-84ea70cec81f, 'C''est trop bon, ma fille adore, permet de manger des fruits', '2012-01-05T19:42:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, f29e44a0-f698-4ecd-9415-22d13011d2fb, 'Cette recette est très simple à faire. Je n''avais pas assez de framboises et j''ai ajouté d''avantage de pommes !! Excellent ! Mais mon chocolat s''est trop mélangé à ma pâte mais c''était quand même super bon !!! Je referai cette recette avec plaisir ! ', '2011-12-26T20:33:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 58b16cfe-626c-4e64-a192-11527d7d9c5c, 'Excellente recette ! N''ayant pas de framboises, j''ai mis plus de pommes et respecté les autres proportions. C''était trop bon !', '2011-11-14T16:47:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 14af37b0-4a8a-4718-86c1-49f99c8fc58a, 'Très bonne recette. Le chocolat donne le côté gourmand. On s''est régalé.', '2011-10-17T14:25:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 09306d4d-17a5-4936-a1a1-b5862ab05208, 'Mes invites ont adoré et c''est une recette que je recommande et que je referai !!!', '2011-10-09T13:55:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, a5628985-c7cc-4a46-8d50-73ffc807d804, 'Facile et très bon !!!', '2011-10-03T22:11:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 910ae060-41a6-4f58-a283-08c99168c720, 'J''ai réalisé la recette avec des framboises surgelées et j''ai obtenu une confiture ! A voir si le résultat est fort différent avec des fraîches. Le crumble a fondu et coulé dans la "compote". C''est de plus très acide au goût malgré que j''avais ajouté un petit peu de sucre aux framboises. Une vraie déception.', '2011-09-19T23:39:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, fde82c63-87b0-4a08-a5ae-e55744a829ef, 'Dans votre crumble ajoutez-y de la poudre d''amande le résultat ne sera pas comparable.', '2011-06-30T01:28:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 9c5c2c6c-b115-4821-bd87-6b42316486ba, 'J''ai adapté en suivant les autres commentaires. J''ai mis le triple de pommes et un bon paquet de framboises avec des congelées c''est parfait aussi surtout en plein hiver. Je n''ai mis que 100 g de chocolat et ça suffit largement. Résultat un vrai régal. Plus de fruits et moins de pâte car ça reste tout de même un dessert aux fruits. A refaire sans hésitation.', '2011-02-13T18:42:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 90b74485-9f70-4ab2-b7f9-712498e249ae, 'Très bon mais trop chocolaté !!', '2010-09-13T22:33:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, ce2ecc4d-72c6-4165-95ca-2b1d54825461, 'Très bon et cela change du crumble traditionnel! Pour ma part, j''ai réduit la farine à 225g, et le beurre à 125 g, c''est suffisant et le résultat était parfait. On en mange moins que d''ordinaire car composé de chocolat, et c''est tant mieux pour la ligne! Recette originale pour utiliser nos pommes autrement qu''en compote! Merci', '2010-09-13T12:58:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 1c487a7e-6894-49e6-ae43-4b3f00df97cf, 'On a adoré ! Merci. A refaire !', '2010-07-22T23:21:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 2c092f96-3451-40b5-893f-9072b127b825, 'Très très bon et très facile à faire, les enfants adorent faire cette recette, et c''est encore meilleur dans des ramequins.', '2009-11-08T17:35:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, ca7c2db4-7e69-4a70-8789-46dd80e672b4, 'Excellent ! J''ai fait revenir les pommes et mis un petit moins de sucre. Super idée le chocolat dans la pâte... servi juste tiède vraiment extra.  ', '2009-06-07T18:53:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, c29e0342-f0d2-4f41-a900-7c2eeee8fd83, 'Très facile à réaliser, et un régal pour grands et petits. Astuce: servez-le en verrine ou ramequin pour une présentation dans l''air du temps', '2009-04-16T16:54:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, f25dc497-c303-4dd3-8d04-9ad9f540be4c, 'Trop sucré, aucune originalité, les invités n''ont pas fini leur assiette.', '2008-10-20T16:24:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 7bfab32b-806f-46e6-95a5-59a7bc31c9d4, 'Vraiment très bon! Toute la famille s''est régalée. ', '2008-10-01T17:18:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 0990bd9a-f783-467c-a4b1-afa9350587dd, 'Très bon, surtout tiède... Par contre je n''est pas mis toute la garniture mais + de framboise.', '2008-05-15T21:52:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 59c25786-4813-41b4-a98b-b47acc40e446, 'Succulent! J ai mis le plat sur la table, et aprés dix minutes il n y avait plus rien !! Forte des commentaires précédents, j ai divisé par deux la quantité de pâte à crumble pour la même quantité de fruits. Craignant l''acidité des pommes (granny) et des framboises j''ai saupoudré les fruits de sucre vanillé. Mille mercis pour la recette.', '2008-04-18T01:09:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 215ce9b1-5d9d-4e7c-993a-955909cc601a, 'DELICIEUX !!! Cela fait 6 ou 7 fois que je le fais et c''est un dessert qui plaît toujours autant, entre amis, en famille, malgré l''aspect peu présentable c''est un succès. Un peu tiède.. Un régal !', '2007-11-13T16:48:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, f74b4da2-ede4-4d2b-bf9c-685be86190b4, 'Delicieux! Testé sans framboises car je n''en avais pas sous la main mais extra avec 5 pommes et choco  mais la pâte a un peu de mal à cuire donc je l ai mis un peu plus longtemps! Trop long pour la dégustation!!!!!!!!!!hi', '2007-10-01T21:43:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, e793c7f7-8370-4cda-811b-01457884e702, 'L''idée d''ajouter des pépites de chcolat est une excellante idée mais par contre un conseil ne prenez pas de royal gala pour faire le crumble car elles ne sont pas fondantes à la fin de la cuisson.', '2007-08-19T04:50:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, f5ff6782-90ba-4f42-a56c-025305de8220, 'Recette pas mal mais ca manque un peu de fruits et il y a trop de beurre pour la pate à crumble. ', '2007-08-14T13:14:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 6d7ae0c4-40d2-419a-8b37-e11b6dd56d45, 'Génial! J''ai réalisé cete recette avec des framboises surgelés parceque j''ai décidé de faire cette recette au dernier moment. Personne n''a rien vu. Délicieux', '2007-08-06T12:51:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 1b604f7a-bd79-468d-8bb9-ced126dfaffe, 'J''avais l''habitude de faire des crumbles, mais cette idée de rajouter des petits copeaux de chocolat, c''est tout simplement génial! Croquant et fondant à la fois...hummm !', '2007-05-10T00:33:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 9f5f6aaa-2ca2-4cfa-9d40-a4ac22a8e2a8, 'Recette géniale (faite 3 fois). Un mélange de douceur et d''acidité excellent. J''ai juste mis un peu moins de chocolat et essayé avec des framboises surgelées (cet hiver), c''est le top!!! Merci beaucoup pour l''idée...  ', '2007-05-05T11:57:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 54fb9d9d-1208-449d-b420-9f6a8b52119a, 'Avec ce crumble, aucune fausse note possible. Vous ravirez tout le monde avec une recette simple et délicieuse. Merci de la recette!!!', '2006-03-17T20:11:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, b25234a1-aee7-473b-be77-430d0d5b8a1e, 'Hummm l''odeur du chocolat qui fond dans le four, j''adore. Par contre la recette mérite 2 pommes de plus, sinon ça fait beaucoup de pâte pour peu de fruits...', '2005-11-29T15:16:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 865031d2-6e18-4c62-9fe2-4185a01f5a27, 'Tres bonne recette! Cependant il y a un peu trop de chocolat dans la pâte, heureusement que j''en avais mis moins! Et aussi un peu trop de beurre, mais sinon le goût est excellent!', '2005-10-08T17:20:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 9acee0db-8002-4f92-9dd7-03be7d2b687e, 'J''ai fait le crumble sans les framboises. C''était excellent. Pour info: température du four : 210°C.', '2005-05-09T21:19:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 0e939bb5-b272-40a7-b694-087b1ad887ed, 'Franchementn ce dessert est vraiment un régal! Je l''ai fait dans des ramequins individuels, nous nous sommes tous régalés! Merci pour cette recette!', '2005-04-21T21:01:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, f1f0b463-4502-47d5-b1ee-85af5a0997d5, 'Pas très bon, à moins d''aimer le gloubiboulga très sucré!', '2003-11-14T12:09:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, 56b3b58b-3eac-48fb-8acc-305cd4959122, 'Génial! Je ne suis pas une pro des gâteaux, mais mes collègues en sont tombés amoureux!! (sans framboise)', '2003-11-03T18:30:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, c9ed733c-9a82-4ed4-b8dd-dd869e52cac7, 'Tout à fait délicieux ce mélange pomme, framboises et chocolat.', '2003-07-14T15:29:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16651, e6c3b9ee-767c-4377-8feb-767a13b17faa, 'Je n''ai fait ce crumble qu''avec des framboises... C''est excellent !!', '2002-08-08T15:31:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71617, 65503cf0-10df-4b7e-a0b6-27064fc5bf9e, 'Super recette ! Je l''ai préparée pour l''anniversaire de ma soeur ! Très simple à réaliser et relativement rapide. Ravis!', '2016-04-02T20:54:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71617, 694fd352-ead8-4ef8-a17d-3142e3c69084, 'C''est très bon', '2014-12-06T10:31:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71617, 7af77fc2-fd74-4d7d-b87d-1a4926d7e8bd, 'Super ! Cela manque juste un peu de sucre dans la chantilly. Je n''ai pas mis le chocolat au frigo et c''est nickel pour l''étaler ', '2014-06-12T13:25:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71617, 5dfda75d-f72e-4f87-a6ab-e3c90cc63663, 'Pas mal du tout même si un peu sec. Peut-être l''ai-je laissé trop longtemps dans le frigo ?', '2013-07-12T01:21:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71617, 151cc316-9bde-4a27-b125-0203c867e194, 'ça aurait pu être un joli gâteau mais la recette n''est pas assez bien expliquée. En effet, il faudrait dire s''il faut couper le gâteau dans la largeur pour faire les deux rectangles égaux. Ensuite, dans la partie ingrédient, vous ne faîtes pas mention des biscuits. Du coup, mon gâteau est un peu bizarre. J''espère que le jury sera indulgent avec moi ce midi', '2012-05-08T14:27:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71617, 96668ff0-e9ff-48fd-89db-8fc3cd669e28, 'Pas mal du tout, mais la prochaine fois, je couperai le gâteau en trois biscuits égaux pour que ce soit moins sec. Et attention à ne pas laisser la crème au chocolat trop longtemps au réfrigérateur, sinon impossible à étaler.', '2011-06-07T16:04:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71617, 2e9fddd0-333f-4137-8054-9f5ac9c67514, 'Excellente recette ! Personnellement j''ai mis le surplus de chocolat en glaçage tout autour du gâteau puis j''ai ajouté la chantilly et les fraises par dessus pour la décoration. La prochaine fois j''essaierais de couper le gâteau en trois biscuits égaux pour pouvoir mettre plus de fraises et de chocolat à l''intérieur.  ', '2010-09-06T18:05:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71617, e95010b2-9162-4b68-87b5-4f97cec3e3c2, 'C''est excellent. J''avais juste un problème pour bien étaler la crème chocolat, sans que cela coule partout. Mais je n''avais pas fait refroidir ma crème au frigo. Je pense que c''est une étape essentielle pour ce gâteau.', '2010-07-15T00:28:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71617, 58e62c43-8dfa-4969-ba4e-95f9fe5f3db5, 'Un vrai régal !!! Pour ma part, j''ai remplacé la chantilly du dessus par un glaçage au chocolat (100 gr de chocolat noir, une cuillère à soupe de crème fraîche et 30 gr de beurre). Toute la famille en redemande !!!', '2010-06-21T22:16:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71617, 024a8e99-317f-4da2-8a36-d93c3378427b, 'Ce gâteau est très bon, je l''ai fait pour toute ma famille et il ont adoré.', '2010-04-07T16:01:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71617, 096365bb-2421-45c2-9f40-629db89b9f08, 'Très bon, facile, mon fils, qui voulait un gâteau au chocolat et aux fraises pour son anniversaire, a été ravi !', '2009-05-22T18:50:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71617, 29bc2c0b-ac7a-48d0-89f3-1ccbd9847f17, 'Un vrai régal!! Il a fait l''unanimité au goûter d''anniversaire de mon fils!', '2008-06-16T17:43:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 976257fe-1d0e-472a-bf23-018cd19dbb3c, 'Super recette! Je les ai pochées à la douille sur du papier sulfurisé et mises au four à 200°C, à dorer, moins gras et tout aussi moêlleuses.', '2016-03-03T11:47:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 486b409d-93a1-4fe0-a6ea-e83e9208ca41, 'Excellente recette, j''ai doublé les doses  et suivi la recette à la lettre. J''ai fait des boulettes au début mais ça prenait trop de temps donc méthode cuillère...', '2019-04-06T19:25:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 6d2b306e-1480-4623-b4c9-ae303fffae5b, 'Génial. Tendres dedans et croustillantes dehors, laissez bien monter en température l''huile, testez d''abord avec un petit bout de pain, ça doit crépiter. Jetez du sel dessus avant de servir.', '2023-01-01T16:27:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 4705604a-91a3-4576-a006-8e7c8a61af56, 'Recette que je fais depuis plus de 20 ans, j''ajoute un peu de comté râpé, laisser reposer 1h, je prends 2 petites cuillères pour former les boules, ça va beaucoup plus vite... Je prends une sauteuse et 1l d''huile, j''en fais une dizaine et répète l''opération, attention à la température de l''huile. Sans oublier de prendre des pommes de terre pour purée.', '2022-12-24T05:46:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 4e66c3b0-d56a-4528-9b80-5bee3e8a2afd, 'Perte de temps et d''argent... recette mal expliquée ou mauvaises proportions!! Tout a finit a la poubelle!', '2018-05-15T11:26:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, bd4c3127-fc11-49e6-90fe-c605bb516aae, 'J''ai tenté la cuisson au four et la friture, je trouve que le bon goût de la préparation est plus prononcé au four, mais que la friture apporte du croustillant... bonne recette, merci !', '2016-08-20T22:49:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 98721799-9b76-4e72-820c-1567a75de780, 'Elles sont sacrées chez et ne se dégustent qu''à Noël.
Héritage de ma mémé nous les formons à l''aide de 2 petites cuillères, directes au bain de friture.
Ainsi nul besoin de poche à douilles ou encore de fariner des boulettes qui effectivement peut rendre la confection des "p''tite patates " beaucoup plus difficile.', '2023-12-29T20:26:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, cc5a604e-8721-40c3-9b64-0eabbc305d44, 'Facile et résultat top! Peut être adapter les quantités à la baisse!
 ', '2023-05-21T13:31:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 68d8f78e-1fdf-49df-bcca-b04fc998b3f7, 'Excellente recette ! Merci. C''est la première fois que je cuisinais des pommes dauphines et c''est un succès !', '2021-01-11T13:25:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, deddc0ff-e329-4458-8713-edd4e1020242, 'Merci d''avoir partagé cette recette. J''ai respecté les doses. Une certaine appréhension car je n''avais jamais fait de pâte à choux. Finalement la recette est simple à faire. Et c''est tout simplement délicieux. Tout le monde a adoré ! Ces pommes dauphines sont bien meilleures que celles achetées dans le commerce.', '2020-05-08T10:40:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 7e6d28ae-6b94-4219-9f34-c9f50bfd3410, 'Je trouve qu''il ne faut que 3 œufs et moins de farine.', '2019-12-22T10:43:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 1d7d998a-cfcb-495a-8d00-d73c755bfb49, 'Bof bof', '2018-12-28T08:37:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, cc76fe42-1a77-4e81-b836-c38be6e96651, 'Très bonnes j''ai utilisé la cuisson au four c''était parfait !', '2018-08-21T14:14:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, ecf3829c-9373-4327-b5db-1a74ac25f740, 'Un vrai désastre ! Perte de temps et d’argent... tout a fini à la poubelle ! Recette mal expliquée ou mauvaises proportions: pâte à choux trop liquide malgré le fait d''avoir suivi la recette a la lettre ! Ce que je ne comprends pas ce sont tous les commentaires positifs! Mystère mystère!!', '2018-05-14T11:31:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, dc95cd63-9312-4b3c-aecb-defbfd54f0c0, 'Meilleurs que les surgelés des grande surface. Peuvent-être préparés en avance et réchauffés au micro-ondes, c''est toujours aussi bon.', '2017-02-27T21:41:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 9905578e-c04a-4275-a887-7b2c3fe80c0e, 'C''est exactement la recette de ma grand-mère ! J''en fais avec elle depuis que j''ai 10 ans, cette recette est parfaite ! Pour ceux qui se demandent pourquoi elles explosent, c''est simplement une question de température de l''huile de friture : quand le bain est trop chaud, elles se durcissent trop vite dehors et l’intérieur pousse en cuisant et déchire la croûte. ', '2017-01-18T17:14:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 25e20732-df08-4002-9b77-670774e99868, 'Très bonne recette un vrai régal. J''ai suivi les commentaires et je n''ai mis que 3 œufs dans la pâte à chou.', '2016-08-19T11:10:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, dbe3f8bf-69c0-41c0-9750-1dd1954a99ff, 'Elles sont bonnes et c''est facile à faire. Des recettes comme ça encourage à choisir de faire la cuisine maison plutôt que d''acheter des produits industriels pleins de conservateurs et d''additifs.', '2016-08-13T17:22:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 195abce0-d036-4c86-bb6a-660e6c223ff5, 'Quel délice !! J''ai fait fureur avec ça... même si la conception est un peu longue (je n''ai pas de friteuse), c''est vraiment excellent, rien à voir avec ce qu''on trouve dans le commerce !', '2016-04-04T08:36:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, b522eccd-6d26-4f82-ba80-033084e8f3e3, 'C''est excellent mais assez gras. Le gros souci est le maintien au chaud en cours de cuisson. J''ai doublé les quantités compte tenu du nombre de convives et malgré deux bassines de friture, difficile de servir chaud. Résultat, les premières ramollissent et dégorgent d''huile. Un peu déçue car au sortir de la friture (et laisser refroidir deux minutes) c''est vraiment divin. Si quelqu''un a une technique imparable pour conserver chaud et gonflé, je prends. ', '2016-03-28T11:02:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, e16ef181-2728-4ec0-a786-6a4cfdccdc0d, 'Super bonne, je n''ai rien modifié à la recette, par contre, j''ai une technique pour les faire en boule sans en avoir plein les doigts, il suffit de prendre deux cuillères et de mettre directement dans la friteuse.', '2016-03-20T17:30:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, c90aff00-3343-493d-8f89-d0aae1c923f1, 'Ben pour moi c''est un raté ! J''ai fait avec 670 g de purée, est-ce que ça vient de là ?! Je ne sais pas. Déjà pour faire des boulettes c''est pas évident la pâte n''est pas assez consistante, j''ai fait avec 2 petites cuillères. De plus dans la friteuse c''est beaucoup trop gras et écœurant. J''ai dû continuer la cuisson au four, pas top non plus. Je pense que j''aurais dû me baser à certains commentaires à savoir : 3 œufs dans la pâte à choux et moins de purée. Je réessaierai la prochaine fois.', '2014-10-30T21:16:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, b4172f1c-2d0e-4081-ac03-006d99349b9a, 'Super facile, et vraiment bien meilleures que les congelées ! A faire et à refaire, peuvent se faire à l''avance et se congeler, et se réchauffer au four, encore meilleures.', '2014-02-01T09:19:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 4a5d4007-6b15-43a0-967b-5acaed52bf37, 'J''ai tenté mais les proportions n''étaient pas adéquates. Trop dense en pommes de terre. Je ne retenterais pas. ', '2012-11-23T17:57:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 8ba9ba88-5639-4601-8cf9-f5e3b0d4e6d1, 'Parfait !!!!', '2023-05-16T11:17:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 9a24f586-aae6-4d2c-b8c3-cc1a73923ecd, 'Beaucoup trop liquide ! C’est une vraie pâte à crêpes ! Maximum 3 oeufs !!!', '2023-04-02T12:55:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, de2286bb-9179-429f-9f2b-70b5000a3bb2, 'Très bon.', '2022-12-25T20:12:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 976de5fe-2c5e-4878-a08a-da3e298b663f, 'J''ai mis 2 œufs au lieu de 4, ajouté un peu de farine, remplacé l''eau par du lait et ajouté de la noix de muscade, du poivre noir et du persil. Délicieux !', '2022-12-24T18:03:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, e47a4881-8f87-4cbe-bd33-0461fb63398a, 'Très bonne recette !', '2022-12-22T09:33:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, cff2c0c3-f06f-4744-b13d-e6f30135c21e, 'Franchement pas bon. 
Je n''en referais pas. ', '2022-03-10T13:37:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 2d8c520f-9702-4f3a-929f-49595df11690, 'Très bonne ', '2022-03-09T13:56:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 93fce366-f0da-4227-bdd0-12c270a91f7f, 'Bon, mais on sent beaucoup la friture :/ (aussi, c''est en très grande quantité)', '2022-03-05T13:29:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 5b3877e9-c61e-472b-af56-d5d9ed960928, 'Très bon j''en referrai', '2022-02-24T15:47:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, b9c011f3-8e7d-437b-9047-fb636a2a61d4, 'Super bon, léger.', '2022-02-20T12:34:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, c66cff9a-4136-495b-9a0f-584a5e3d23fe, 'C''est ok. ', '2022-01-30T17:36:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 6e04645e-59f3-46b1-91d9-1c95f8f0913e, 'Super facile à faire. Hyper bon. ', '2021-12-28T18:33:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 59c959b5-f5f8-43db-bcb6-ff7dda3d2e40, 'Super recette ! Biens meilleures que les industrielles 👌', '2021-12-12T17:40:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 3bd363b9-f435-424f-ab55-a28699696a00, 'Cela fait 2 fois que je la fait excellent on en mangerais sans faim !!!?', '2021-02-25T13:10:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 46bb8366-64ab-4d0d-9de9-fece2ff2f7b9, 'Simple et un excellent goût.', '2020-12-23T21:45:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, fdc6edea-3a99-46ba-a048-fbed8f267847, 'Les pommes dauphine de mon enfance, telles que ma grand-mère les faisait. Excellentes ?', '2020-12-20T17:36:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 8b3a9229-1d44-466f-9f7c-7bf91b9441c9, 'Très bonnes , j ai suivi la recette et impec,  à refaire ', '2020-05-09T15:01:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 602967a3-d396-4fd6-a91d-3f74afdb4c3c, 'Farcie avec un morceau de bûche de chèvre et d’herbes de Provence ', '2020-04-13T10:32:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 5cc45360-c515-48b9-bcde-76f397f1b005, 'Super recette, c''était divin ! En sorti de cuisson quelques minutes sur du papier absorbant pour faire dégorger le surplus d''huile puis transvaser dans un plat avec une feuille d''aluminium pour le maintien au chaud, saler au fur et à mesure. C''était long, c''était dur (la pâte à chou) mais elles étaient par-faites !', '2019-09-14T22:56:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, cf20b554-18ee-413d-b29d-5aac3d324292, 'Je me suis lancée pour le repas de Noël avec beaucoup d''appréhension car je n''avais jamais fait de pâte à choux. J''ai utilisé trois œufs et un bain de friture à 175°C. Un peu long mais le résultat en vaut vraiment la peine.', '2019-01-08T10:12:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 42fb63e4-2277-4ecf-90ef-e53492bc8d5c, 'Recette parfaite pour des pommes dauphines savoureuses. Pour celles qui les ont trouvées trop grasses car gorgées d''huile, c''est parce que l''huile n''était pas assez chaude... Il faut une huile à 180° pour réussir les dauphines.', '2017-06-06T17:59:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 1c48bc2f-946e-4ce0-b60b-6eae445fcfd2, 'Je ne comprend pas pourquoi mais mes pommes dauffines ce sont gorgées d''huile à la cuisson. Résultat, c''etait super gras! donc écoeurant !!', '2017-01-01T12:57:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, bb4edf17-6c63-4c3e-b78a-6cfb1b1573da, 'Super recette ! Pour ma part j''ai fait deux bains d''huile pour la cuisson, résultat elles restent super croustillantes.', '2016-11-09T21:21:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 3b57daba-4bef-4add-b035-1aad36a01c60, 'Tout simplement excellent !!', '2016-11-03T14:11:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 6fd1371c-fb9d-4343-8323-d89107479f1f, 'Super rendu. Pas compliqué mais un peu long. J''ai fait avec 800 g de pommes de terre mais la même quantité de pâte à choux. J''ai formé à la poche à douille avec un embout en étoile. Ça fait pommes duchesse. C''est super beau et bon!  ', '2016-04-17T13:48:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 9f6e5b1d-93a6-4d2d-8962-073dd841ac83, 'Comment dire... c''était plus des galettes que des vraies pommes dauphines... ! Décevant... ', '2016-03-11T22:40:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, d27bc125-278f-484e-9ee3-5064fc5acce1, 'Excellent. ', '2016-02-24T12:45:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 4427c82e-12b2-4a21-94f2-b7c89f9b1007, 'Très très bon... et facile à faire... Rien à voir avec les surgelés !! A refaire. ', '2016-02-04T14:31:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 77435d01-142b-4d54-b168-e9ba6294718c, 'Hyper simples à faire !  Je viens d''en goûter une. Un délice ! Fini les pommes dauphines surgelées insipides. Merci pour la recette !!! ', '2015-12-31T18:36:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, ddc7fe5e-9448-4868-972a-13af2c3bd759, 'Au top!!', '2015-12-30T08:43:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, d9a0698b-9a4e-4205-9049-cb1ab7fb9b62, 'Alors je vais vous donner l''astuce : j''ai fait la préparation la veille et j''ai mis les petites boules dans un plat fariné.  Le lendemain je les ai fait cuire juste avant de les servir. Excellent ! Tout le monde s attendait à du surgelé et ils ont été bluffés ! ', '2015-11-26T19:48:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 58e425d0-1bc8-4231-b481-cb413e1a3994, 'Tout simplement très bon même si ce qui est un peu fastidieux c''est la réalisation des petites boules ', '2015-09-21T15:22:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 420007c7-99a7-46a7-a4d3-ef144a864c28, 'Super recette ! Un très bon repas de famille ! Reste maintenant à essayer de les précuire en amont pour les remettre dans la friteuse au dernier moment ! Recette faite avec trois oeufs seulement ! Merci !', '2015-03-22T14:20:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 075a2b72-938a-447b-a5bf-371061ae5c63, 'J''ai réalisé cette recette avec un mélange carottes pommes de terre avec 500g de purée au total. C''est délicieux. Pour ce qui se demandaient pourquoi elles "explosent" parfois a la cuisson, il me semble que ça arrive quand elles sont trop grosses', '2015-03-08T17:59:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 4fe06e58-a087-4545-a6f6-9f2dfe098ca5, 'Légères croustillantes et moelleuses - Tout le monde a adoré. Il faut bien respecter les proportions. J''ai préparé ma pâte la veille et l''ai laissé reposer toute la nuit. Cuisson à 175° dans la friteuse. Un vrai délice à refaire.', '2015-01-15T22:08:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22232, 0c3c3a85-1c8c-44ad-a8d0-a6be29851062, 'La forme est à améliorer mais le goût y est... Génial !', '2014-12-28T20:21:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, fba11974-3bbc-400a-857c-7d3e63eb5d77, 'Bien cette recette mais pour les "2" de lait c''est quoi ? 2 décilitres (soit 20 cl) ? C''est ce que j''ai supposé mais si quelqu''un a la version exacte je suis preneur...', '2020-04-05T14:01:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 92b15f70-cebe-4c07-90c2-edff9e0b8cd0, 'Recette dé-li-cieuse ! Je n’en fait que la moitié, avec 330 g de framboises, ce qui fait 250 une fois les graines éliminées. Mais je passe les framboises (en purée, chauffées) au tamis avant d’ajouter le sucre (50g) et gélatine —3 g de gelatine en poudre (je ne trouve pas de feuilles aux US) dans 1c d’eau, 75g de crème fouettée et 1 blanc d’œuf monté en neige. En moins de 4h les verrines sont prêtes, et nous à nous régaler !', '2021-01-23T21:30:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 223663d8-a9f7-427c-8413-12a6b1a06e01, 'Excellent! Sans les pépins, si possible c''est mieux.', '2021-07-25T20:29:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 904e07d2-fb2e-4eeb-8552-1ca8540642e4, 'Très bonne recette mais il ne faut vraiment mettre que 2 feuilles de gélatine seulement', '2022-03-14T12:51:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 5779d541-9cd2-4c4b-9c18-b916c6598e77, 'Très bonne recette ! Je l''ai utilisé dans un entremet et elle a magnifiquement prise. J''ai mis un peu trop de lait (je pense que c''est 2cl et pas 20). À refaire dès que possible !', '2020-06-05T20:40:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, e7621281-42ac-40ee-a4f9-5fb5564ba136, 'C''est très bon, mais la recette ne dit pas d''enlever les pépins des framboises alors qu''à mon avis il est important de les retirer pour que ça ne soit pas désagréable à manger. Je n''ai pas utilisé de lait. La crème se tient très bien après une nuit au frigo.', '2016-02-28T06:17:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 0ab3c993-2c09-4293-97aa-233a8802165b, 'Suite aux nombreux commentaires liés à la quantité de gélatine, je me suis penchée sur la question et j''ai constaté que le poids variait selon les marques. Pour ma part, j''ai utilisé 6 feuilles de gélatine, soit 6 grammes.  J''ai remplacé la crème fouettée par 400 g de Gervita, ajouté 60 g de sucre et incorporé les jaunes d’oeufs également. C''était plus que parfait ! ', '2015-08-05T19:24:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, cc35be12-bcb2-4271-964b-decc76f15fde, 'Utilisez 2 feuilles de gélatine, 3 c''est trop', '2022-12-24T21:19:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, b2ec40d7-3d9e-4693-8509-c4dd47b81d0b, 'Excellente recette !
On c''est régalé!', '2020-06-27T14:01:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, e437a1bd-886d-4add-8edf-7cfc74d4bed4, 'La mousse est décevante je pense que je rajouterai de la crème fraîche pour donner plus d''onctuosité et de tenue.', '2020-01-08T06:05:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, ecdb9b2f-6b93-4ea3-ab2c-0fa0bb47975f, 'Un jus de citron quand les fruits sont trop sucrés', '2019-09-27T18:11:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, b5547c1f-b110-4de3-bc42-fca386f1d5c5, 'Recette effectuée avec des fraises, pensez à bien bien les réduire en purée ! Sinon la mousse tient très bien et elle n''est pas très sucrée !', '2019-04-29T10:21:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 2493f745-e186-431d-b409-5da1f1db38a5, 'Cette mousse va très bien pour faire une bûche de noël avec une génoise. Elle est très légère et facile faire.', '2018-12-23T10:55:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, af47e9c2-8417-4c4f-9e1f-7ab882b6527d, 'Mousse facile a réaliser. Pour une première mousse tout le monde s''est régalé et à mon grand étonnement hyper légère', '2017-12-27T22:15:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 03e16ad9-f998-4456-ac4a-c4c294962401, 'Je viens de faire cette recette... et cette mousse est parfaite contrairement aux commentaires de certains ! Elle n''est pas du tout écœurante et on la mange sans faim ! à refaire sans hésiter !', '2017-08-17T00:02:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 7366fa18-6b6f-4d34-9fe2-672b48c63a2c, 'Très bonne recette  Ça a plus à tout mes invités  Bravo !', '2017-04-15T16:53:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, a281b09f-9442-4459-bb3e-d1ef12ae0107, 'J’ai suivi ce dessert, la mousse aux framboises, à la lettre, un vrai délice ! Mes invités ont bien aimé. Merci pour vos bonnes recettes. Depuis que je connais Marmiton c''est un plaisir de cuisiner vos recettes.', '2016-09-09T12:47:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, b692c9cb-42c7-4cbf-8aa1-db5080492603, 'Super mousse, j''ai remplacé la crème fraîche par du mascarpone, j''ai utilisé 3 feuilles de gélatine, la mousse était parfaite, à refaire.', '2016-01-21T14:17:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 6bbf43ee-c401-4753-be10-795efa2481a8, 'Vraiment déçue par cette recette. Après plus de 12h au frigo ça n''a pas du tout la consistance d''une mousse. Je ne vais pas oser servir ça à mes invités. Dommage :(', '2015-12-31T14:18:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, ffe14635-7312-4d31-b94f-691306a9a0d7, 'Mousse pas prise du tout ! Pourtant j''ai déjà fait des mousse aux fruits... A mon avis il ne faut pas mettre de framboises surgelées...', '2015-12-31T11:28:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 79fd8de2-b597-47ee-a144-7318f3d88068, 'Il y a un erreur de frappe dans la recette : 3 feuilles de gélatine (= 6 feuilles que l''on trouve généralement dans le commerce) Je suppose que c''était plutôt 3 feuilles = 6grammes. Le passage au tamis est préférable pour ne pas avoir de petits pépins dans la bouche. La mousse est bonne mais devient vite écoeurante à mon goût. Il est préférable de les mettre dans des petits ramequins.', '2015-12-15T14:10:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 1325812b-3e23-4ad4-bb48-9c8be37d075f, 'Pour la première fois, je suis très contente d''avoir fait cette mousse. Mon homme s''est régalé. ', '2015-11-24T18:31:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 41b3a11a-2e9a-4c3d-b12b-5072d69f3808, 'Ma crème fraîche normale n''a pas monté. personnellement, je mets de la crème liquide et très peu voire pas de lait. Sinon, mousse un peu écœurante à mon goût.', '2015-11-06T09:02:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 613e57b5-bcde-4e38-8e6a-df669529aae2, 'Miam !! ☺', '2015-08-01T13:29:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, bee34fb5-c9d5-4688-a6be-0a2360969e64, 'Très bonne recette, hyper simple à faire pour un résultat extra! J''ai suivi les conseils des marmitonautes : j''ai diminué les quantités de gélatine et de sucre et c''était nickel. A refaire!', '2015-07-07T12:08:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 26b78c3d-4ba0-46a3-affe-19e7b5457ba9, 'Superbe recette mousse bien léger mais qui tient... J''ai doublé les quantités pour faire l''appareil pour ma charlotte au fraises en une heure il y en avait plus ! Merci', '2015-06-10T11:16:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 91f01919-2031-4fcd-b41b-97d8ed724813, 'Pour les personnes du Québec vous pouvez remplacer la crème fraîche par de la crème à fouetter 35% et je n''ai pas mis les 2 cuillères à soupe de lait. Cette mousse était tout simplement géniale !', '2015-03-09T17:07:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 0ac69900-ff3b-4da4-b830-2e7dcab87d53, 'Excellent. Pour un kilo de framboises surgelées, je n''ai mis que 130 g de sucre et 4 feuilles de gélatine que l''on trouve dans le commerce. Je n''ai pas réussi à monter la crème avec le robot malgré la crème semi épaisse, alors comme le conseillait un internaute, j''ai pris du fromage blanc 3% et le résultat était impeccable et allégé en plus.', '2014-12-27T17:01:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 91706244-12c4-4022-a512-6a8936e5b92f, 'Recette très simple et pas trop chère et succulente à refaire pour Noël mais il me faudrait un accompagnement qui se marie bien avec...', '2014-12-10T19:05:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, b8156130-1896-49cd-903d-b51ab7023d66, 'Super recette. J''ai opté pour des verrines individuelles. Pour 300 g de framboises, j''ai ajouté 1 feuille 1/2 de gélatine. La texture et le goût étaient parfait. Je le referai c''est sûr. C''était délicieux.', '2014-11-18T15:40:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 0d934464-209d-4248-8bc2-dceb91c36b1b, '4 feuilles de gélatine suffisent et à servir avec un voile de framboises ou de fruits rouges.', '2014-11-10T17:15:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 8ad76e75-fad3-41c7-95ec-4068f963e935, 'Avec 6 feuilles de gélatine, la texture est trop gelatineuse, ça ne fait pas mousse.  ', '2014-10-25T18:42:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, c9674221-a6c4-4507-8b57-b3bc5a67d16e, 'Très bonne recette ! Mes invités ont adoré. J''ai respecté les quantités sauf pour la gélatine car je n''ai mis que trois feuilles.', '2014-10-22T22:33:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 525d51e3-a06a-4e44-8e07-19c8ac0574f2, 'J''ai été assez déçue de cette recette. Elle me paraissait assez simple et sympathique. Mais à priori, il ne faut pas prendre n''importe quelle crème "normale" : avec une crème entière mais apparemment trop liquide, ça n''a pas vraiment fonctionné. C''était aussi trop sucré à mon goût. Et la gélatine n''a pas bien pris, donc j''ai eu une sorte de mousse mais avec des "morceaux" bizarres. Bref, ce n''était pas mauvais au goût mais loin d''être une réussite... Ça ne m''a pas bluffé autant que le laissaient présager les commentaires et les photos. Je réessaierai peut-être...', '2014-10-22T19:25:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 72eb8e09-2f8a-4095-a55a-e29d16eed774, 'Très bonne recette ! J''ai été agréablement surprise. J''ai utilisé de l''agar-agar et ai respecté les proportions données pour tout le reste.', '2014-10-20T00:43:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, de88991e-4663-4a10-b58c-173e4f313355, 'Absolument parfait ! Très bonnes proportions et le visuel est garanti quand les verrines arrivent à table !', '2014-10-06T12:53:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 9e21a720-662b-469c-8a16-89d74f8cce7a, 'Pour ma part, ça a été un échec. Le goût était top mais la texture n''avait rien d''une mousse mais plutôt d''une crème dessert épaisse...', '2014-08-11T10:17:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 05c64af8-6736-4c44-8a3b-03d040d60a48, 'Très bonne.', '2014-06-30T18:21:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 56382c86-94ae-4924-86bb-fdb97afde6c3, 'Très bon mais la prochaine fois je mettrai 3 et non 6 feuilles de gélatine du commerce, pour que ce soit moins solide. ', '2014-06-29T20:00:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 5a57ef1f-bbd8-4f43-b7e1-5fd4c0acafd3, 'Très bonne recette .... ', '2014-06-27T18:44:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 74951c4b-8bd0-4729-b5a4-9aa5b6c03fc8, 'Je l''ai fait dans des verrines. Parfait ! Tout le monde a adoré. Recette rapide, excellente et qui fait son petit effet .', '2014-06-27T10:31:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 4935f08d-17de-46af-a8a3-8fd58206aac4, 'Excellente recette ! Mes invités on tout mangé même mes enfants ont adoré ils me demandent à chaque fois qu''il y a des invités d''en refaire !  ', '2014-06-22T17:57:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, c6d0ea4f-765b-46fc-9d6d-ab40a92f24ec, 'Encore meilleure avec du gruyère ! Sinon délicieuse !!!', '2014-06-21T18:40:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 9a76bb44-b628-49d8-ada2-db054d264713, 'Excellente recette très facile à faire ! La mousse est légère et aérienne.', '2014-06-20T10:14:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 5972553c-8606-48f6-92a7-f5f7ecfa31ff, 'Nickel, très contente du résultat', '2014-03-25T20:56:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, d579760a-2bbe-4c3e-921f-f0ed68be9dec, 'Excellent. J''ai utilisé des framboises du jardin que j''avais congelées. Après une rapide décongélation au micro ondes, j''ai passé le tout au moulin à légumes grille fine, et utilisé le jus obtenu. Attention à la quantité de sucre. Je vous conseille de goûter. Pour ma part j''ai mis 120 g de sucre et du fromage blanc à 20% à la place de la crème. 3 feuilles de gélatine du commerce et 2 blancs d''oeufs en neige, effectivement difficiles à incorporer. Résultat parfait, après une nuit au frigo. Fait dans des verrines. Merci pour cette recette et les commentaires de tous', '2014-01-13T12:50:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 83f3b419-8877-4273-868d-b8b2176b5b98, 'En ce qui me concerne, j''ai doublé les doses mais ne me suis servie que de 7 feuilles de gélatine, et c''était déjà beaucoup. Je pense n''en mettre que 6 voire 5 la prochaine fois et cela devrait être largement suffisant. Pour le reste, j''ai pris le temps d''enlever les pépins, sans regrets car le résultat était EXCELLENT ! A refaire vite !', '2014-01-09T13:52:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 8d9ae24e-994a-4da8-818a-352c73350f2b, 'Dessert délicieux et qui a été apprécié de tous, notamment par sa légèreté et sa fraîcheur pour finir un bon repas. Ma seule appréhension était d''incorporer les blancs en neige dans la préparation de framboise. Mais avec patience et délicatesse ça fonctionne.', '2014-01-05T16:48:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 8de51a1b-9690-483e-ba96-916336263c58, 'J''ai fait la mousse et ce fut une réussite. Je m''en suis servie pour faire une génoise fourrée avec et glaçage avec coulis de fruits rouges avec 2 feuilles de gélatine. Tous mes invités ont été bluffés.', '2013-06-20T14:21:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, fe1ed3e7-6f0b-45a3-8e30-73e437319fa6, 'Alors au vue des commentaires, je n''ai mis que 3 feuilles de gélatine et plus de 12h au réfrigérateur. Hélas mes mousses n''ont pas pris... ça n''a pas fait joli mais le goût y était !! Elles ont fait sensation malgré une présentation super moche. Je les avais servi avec un petit moelleux au chocolat. Les 2 associés, un pur délice !  A refaire avec 4 ou 5 feuilles de gélatine !', '2013-05-31T18:27:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, d41bbfef-4c90-4036-a24b-c8fffee85aa0, 'Très bon. Mais effectivement il faut se contenter de 3 feuilles de gélatine achetées dans le commerce, c''est largement suffisant. Merci pour les conseils que j''ai pu lire avant de faire la recette.', '2013-05-23T14:24:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 5987e269-6ebc-42a5-a9ad-ed0689efa44a, 'J''ai mis 6 feuilles de gélatine c''était trop pâteux. C''est ce qui était conseillé dans la recette (3 feuilles de gélatine = 6 feuilles que l''on trouve généralement dans le commerce). La prochaine fois, j''essaierai avec 2 ou 3, ça sera nickel.', '2013-03-10T13:20:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, d10ad302-9be3-42a4-8c23-70ce1979f88d, 'Bonne recette ! Attention aux portions au moment de servir ! Beaucoup trop copieux à mon goût. En effet, j''aurais du suivre le conseil et enlever les pépins car cela gâche tout lors de la dégustation. Recette conseillée. ', '2013-02-17T10:48:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, df198e05-5069-43da-a6c6-bc6dd82d5cfa, 'A défaut de framboises, j''ai mis des fruits rouges. Très bon et simple à réaliser. Accompagnée de biscuits au citron, un délice!', '2013-01-22T00:31:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 36799c9b-c1cc-4f98-964f-111bf661cfdb, 'Concernant le goût, rien à dire, c''est vraiment délicieux. Mais pour la consistance, 6 feuilles de gélatine, c''est trop, ma mousse était limite "caoutchouteuse". Et il vaut mieux passer le jus extrait des framboises au tamis pour se débarrasser des pépins.', '2012-12-27T23:36:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 8ecb1e6d-c543-40c8-afdf-2ab407045028, 'Génial ! Recette très bonne, qui a plu à mes invités et à mon fils de 2 ans 1/2 ! Par contre, j''ai enlevé les pépins. La prochaine fois, j''essaierai en ajoutant du coulis de framboise et avec une feuille de gélatine en moins ! Un peu compact, mais très léger ! A refaire !', '2012-12-26T10:19:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, b8264ded-d594-4958-a46f-a019603b5c6b, 'Je viens de la réaliser elle est excellente !!', '2012-12-24T13:18:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, e0179435-0cf2-4538-af31-1048d18f28f4, 'Vraiment délicieuse ! Un seul conseil, ne faites pas les fainéants et enlevez les pépins, ça n''en sera que meilleur !', '2012-09-13T22:47:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 42a839c5-0966-41da-83db-ee78693b50e5, 'Excellent tout simplement', '2012-07-12T12:42:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12358, 112c25a4-5c49-48ae-ac64-09ba4503236d, 'Mes invités ont adoré le goût de ces verrines. Jolie présentation. J''ai ajouté un peu de citron. Mais à mon regret, ma mousse était très liquide. Je n''ai utilisé qu''un sachet de gélifiant (n''ayant pas trouvé de feuilles de gélatine), et 4 blancs d''oeufs. J''ai eu du mal à incorporer le coulis de fraises (car je n''avais de framboises) aux blancs d''oeuf. Comme il y a avait des grumeaux j''ai dû passer le tout à nouveau au fouet électrique. Si vous avez des conseils infaillibles pour la réussir, je suis preneuse.', '2012-06-14T21:12:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, bb810dcc-edf3-46ac-97c5-3eba98a2acd3, 'Parfait pour un dessert pas très copieux ', '2021-03-18T21:59:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 410b27f5-da9d-4888-80e6-0c7ceaeb9400, 'Un délice pour le palais… D’autant plus délicieux que la saison des fraises bat son plein !!!', '2022-05-18T16:11:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 53eab5d3-197f-43b7-aa35-4074aca7b7ad, 'Très bon dessert je recommande !', '2020-04-22T02:17:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 436a8aa4-3553-4f1b-91cf-880beac6eab1, 'Recette très simple a réaliser mais délicieuse et fraiche ! J''ai pris des fraises congelées. J''ai mis plusieurs couches de speculoss fromage blanc et fraises dans cette ordre car j''en avais fait pour un batillon malgré la grosse quantité ça passe tous seul a refaire le must a faire en eté bien sur mais toute l''année aussi !', '2018-03-02T17:02:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 06671f49-069d-4d2a-9b72-7c646015cd41, 'Très très bon. J''ai ajouté des cookies au chocolat au fond de la verrine.', '2014-07-25T18:52:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, b6cfe11b-ad5a-4410-be12-ea01453065a0, 'Excellente recette ! Par contre j''ai également ajouté du sucre et un peu de citron et c''était top !', '2014-06-20T01:51:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 109229e8-a7d3-4c86-971c-83e0927e6fdc, 'Très bon. J''ai ajouté du sucre et une seule couche de spéculos suffit, le goût étant très prononcé. A refaire !', '2014-05-21T20:36:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, a7dd2a42-9dfb-4c55-a844-0d7f22ae2caa, 'Très bon, j''ai rajouté un peu de sucre pour ma part :)', '2014-05-01T20:09:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, babbf7f5-08bb-427d-aa75-1c55ca7cb1ec, 'Dessert très frais et agréable. J''ai mis à peine un peu de crème fraîche avec le fromage blanc. Bien mettre la dernière couche de spéculoos au dernier moment pour garder le goût croustillant.', '2014-03-23T23:11:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 7b5e1b1f-a6c2-4ff8-af8a-471ca964d097, 'Recette très sympa ! A la place des fraises, j''ai mis des abricots. Au top ! c''etait délicieux.', '2013-05-24T23:33:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 46e675ca-6b9d-4c28-8179-991fd8e52c7f, 'Personnellement je n''avais pas assez de fraises alors je les ai coupés en tous petits morceaux au lieu d''en faire un coulis et c''était un pur délice, mais je pense qu''il est préférable de pas trop attendre après les avoir fait pour que le spéculoos garde tout son croquant.', '2013-05-17T00:27:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, e8707864-3b4e-4e58-a257-f1f58134ab76, 'Excellent ! Recette respectée en ajoutant juste un peu de menthe hachée entre la fraise et le fromage blanc. Mélange très agréable ! Par contre, je me suis dit que la prochaine fois, je ferai une couche de spéculoos plus fine en bas car on a plus envie de finir par la touche fraîche du fromage blanc et de la fraise. A refaire !', '2013-05-09T00:11:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 0c758e0e-0465-46e8-899c-79c599a26d27, 'Très bonne recette sauf que j''ai ajouté sur le fromage blanc un peu de confiture à la fraise afin de donner une note sucrée au fromage blanc car sinon c''est un peu fade.', '2012-04-29T11:21:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, b9aebfb7-1f73-4f3d-b5d0-d89962e616af, 'Comme nous ne sommes pas des fans du fromage blanc, je l''ai remplacé par du flan à la vanille. Toute la famille a apprécié!', '2012-04-16T11:13:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 38dacd99-6363-4b33-8624-fbf05ee552bc, 'Fabuleux ! Je les ai mis au frigo à peu prés 2 h avant de les manger. La saveur des biscuits s''est fondue dans le fromage blanc. Miam !', '2012-01-29T17:42:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 58275e35-ee59-45f6-b01c-8c7b2ee0a399, 'Je fais le même type de présentation, mais avec des framboises (fraîches ou surgelées); je sucre légèrement le fromage blanc et j''ajoute un jus de citron. La famille a voté 5/5 à l''unanimité !', '2008-05-06T22:59:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 67c34cd2-bc37-4e58-8187-73b94791610d, 'C''est juste délicieux et à la portée de tous !', '2022-05-22T08:06:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, bf7d6036-3bb2-44ec-9ebc-d0e9ed7b05d7, 'Dessert facile à réaliser. Frais et gouteux, le visuel est superbe.', '2022-04-24T09:01:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 9841bbfa-9ca2-433c-9595-c5c2e42baf65, 'Simple, rapide et excellent !', '2020-07-29T00:24:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, a059bf9f-eff4-4966-8094-1c2be4aae8ec, 'Recette réalisée par mon fils de 10 ans. On a juste rajouté un peu de sucre dans le fromage blanc. A tester avec d''autres fruits car c''est un délice !', '2020-04-23T23:33:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 9fcc9711-12a0-4154-a781-261c948493c2, 'Recette très simple et bonne. J’ai remplacé le fromage blanc par un gervita nature. ', '2020-04-22T12:52:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 396c9435-3bdc-4c1b-a1bc-eeb214848a13, 'Très bien je recommande. Recette fraiche et légère après un repas trop riche. ', '2017-06-25T16:18:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 686d9634-5389-4e9d-8d0e-adf308c00cbc, 'Dessert apprécié pour sa fraicheur et sa légèreté. Veillez à choisir des fraises bien mures. Recette à partager ! ', '2017-04-30T20:59:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, ecdd5b18-8b1e-4f6e-a982-f25eaccee03d, 'Très bon ! N''ayant pas de fraises je l''ai fait avec de la confiture de fraises !', '2016-09-16T19:05:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, bd4be9e7-febe-4198-a627-cfb6a375b2d3, 'C''était très bon et très frais parfait pour terminer un repas ! ', '2016-05-01T19:39:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 5cd665a2-40e3-45a8-9e2e-3923d8dc3b1b, 'Recette très bonne. Il faut juste ajouter un peu de sucre dans le fromage blanc, mais sinon impeccable !', '2016-01-02T10:10:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, f3cdf4ec-f06e-4f38-8bb2-7f570b7ca209, 'Recette très bonne je n''ai pas mis autant de spéculoos et j''ai acheté directement du coulis de fraise en magasin et j''ai essayé aussi avec du coulis d''abricot mangue c''était encore meilleur et il faut sucrer le fromage blanc sinon c''était excellent ', '2015-07-24T16:05:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 955ea206-9890-4617-8aec-667d6988086c, 'Très bon en sucrant le fromage blanc', '2015-06-03T10:34:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, dff1067c-ea82-4eac-b2cc-a2785a337402, 'Excellent ! Pour 2 j''ai utilisé 6 spéculos, un yaourt blanc et une quinzaine de fraises. ', '2015-05-06T15:06:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, f4a97d99-5e79-4130-9952-af19420516e7, 'Franchement je suis assez déçu : pas de saveurs exceptionnelle pourtant j''adore les speculoos et les fraises mais bof ! ', '2015-05-03T15:40:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, fffd32af-ee58-4559-b18b-d909b165b6c4, 'Excellent je l''ai fais quand j''ai eu des convives et ils ont adoré, je le refais se soir pour la saint Valentin ', '2015-02-14T13:30:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 4da65161-69cb-4ddc-b73b-35bf09a23ac2, 'Excellente recette !!!! Réalisée 2 fois et toujours un succès !!!! Très léger comme dessert ! Je recommande cette recette !', '2015-02-11T15:16:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, f5bf2c09-8ccf-4843-b7d7-0134ce9959d3, 'Excellente ! Je n''avais pas de fraises donc je les ai remplacées par des bananes caramélisés (avec du rhum vanillé).', '2014-08-01T08:24:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, efa04fe3-cf21-4e6e-8806-a6ece0f73106, 'Excellent !! ', '2014-07-26T17:59:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 7d0cd2d4-6914-40bd-bca3-f862df9c3e89, 'Simple, rapide, économique et trop bon !! J''ai simplement ajouté une cuillère à soupe de sirop d''érable dans le fromage blanc ainsi qu''un sachet de sucre vanillé dans le coulis de fraise.', '2014-06-21T12:36:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 6d913baa-e0d4-4ae2-b97f-227db1aad423, 'Si on ajoute un peu de jus de citron et de sucre (quantités à ajuster selon votre goût), c''est encore meilleur !', '2014-05-24T18:30:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 2bf18b59-0163-4c49-89d2-b83af3a6a1ca, 'Réalisation facile ! C''est très bon !', '2014-04-29T01:37:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, d54b9139-cd09-4682-a581-5453340700d9, 'Frais, léger, peut-être ajouter du sucre pour les amateurs mais pour ma part impeccable. Merci pour ce régal.', '2014-04-16T09:28:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 8d1c24f2-2929-4522-9dae-5c1b7261e585, 'Une recette très simple à faire et super légère. Il faut la faire au dernier moment.', '2014-04-13T14:26:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 8234d53c-d93b-4de5-9aa1-407c20c238a7, 'Délicieux, léger et vite fait en plus ! ', '2014-04-01T23:13:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 480baddd-fff7-4414-b5bc-05d9f61ede1d, 'Très bon et simple à réaliser. Je le fais aussi dans un grand plat. Peut se faire avec tout fruit, j''ai testé: figolu, banane, chocolat : grand succès !', '2014-03-02T19:41:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, c5586115-d237-4311-a2b8-588e3064e092, 'C''est léger, frais et super rapide à préparer. A refaire.', '2014-01-31T15:15:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 19fdb31a-1e2d-4335-9622-ac2fd4204c84, 'Léger, frais. En fin de repas, même après un repas un peu "chargé", ce dessert passe très bien. Je suis maintenant obligée d''en faire systématiquement dès que c''est le moment des fraises sous peine de me faire disputer !!! Excellent.', '2014-01-04T17:21:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, bcfce0e7-e17c-44aa-bc09-c9778ff23031, 'Miam miam! Très bon dessert tout le monde s''est régalé. Je l''ai fait avec des framboises et j''ai mis un sachet de sucre vanillé dans le fromage blanc pour adoucir l''acidité des framboises. Je réduirai légèrement la quantité de speculoos la prochaine fois sinon excellent! ', '2013-10-06T12:42:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, ccd87fca-781e-44bc-8325-5916de53e8f8, 'C''est facile à faire, c''est frais... mais ça n''a aucun intérêt gustatif. A vous de voir, moi je ne la referai pas.', '2013-09-20T00:52:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 7c76d808-d281-48cd-9b15-1ff16bebb017, 'Très bon simple à faire mais fait son petit effet ! ', '2013-09-07T23:18:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 411af44b-1c8f-4400-bb61-f4ec20166a2d, 'Super frais excellent ! A refaire merci pour la recette....', '2013-09-06T17:09:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, c24879e9-84f2-459c-ad6a-3bb42e6cc5b3, 'Pas super. Personne n''a vraiment aimé, je ne conseille cette recette à personne, nous avons jeté la moitié des verrines !', '2013-08-09T19:01:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 731d9101-cf1f-4547-a5e0-137e2b9eb961, 'Excellent ! Je ne suis pas bec sucré, mais j''ai mangé cette verrine avec délice ! J''ai remplacé les fraises par des framboises que j''ai juste coupées en morceaux. Je n''avais pas de fromage blanc, alors j''ai sucré un yaourt brassé à ma convenance. J''avais préparé les verrines à l''avance, et si la première couche de spéculoos s''est ramollie au contact du yaourt, la dernière couche, ajoutée au dernier moment, a apporté suffisamment de croquant. C''était parfait !', '2013-08-02T21:11:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 83bb4b8d-51e5-455a-a0b2-4b647e29c075, 'Vraiment délicieux, vite fait et facile ! A tester par tous ceux qui aiment les spéculoos !', '2013-06-12T21:44:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 6102ac47-bfeb-454f-aaeb-b9edcb58c2fb, 'Excellent je le refais dès que j''ai des invités.', '2013-06-12T13:21:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 166dde1f-2f56-4270-ade3-698481b30442, 'Fait avec ma fille de 6 ans ! avec les fraises coupées en morceaux pour plus de croquant, et yaourt sucré (pas de fromage sous la main) un délice vite fait et bluffant à la portée de tous !', '2013-06-09T12:49:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, c803f782-11b6-4cb6-afbb-63212c4275b4, 'Excellente recette ! Super rapide à faire et très facile et pourtant mes invités étaient bluffés ! Merci pour la recette !', '2013-05-31T19:33:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, e6e3937b-41cc-448d-90a3-b4b8e7cff815, 'Je mélange des blancs d''oeuf en neige dans le fromage blanc. Cela allège l''ensemble. ', '2013-05-30T18:44:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 82ecec49-2b98-4ccb-98de-8a4bf75bf4a1, 'Rapide, léger, frais et délicieux, que demander de plus ?', '2013-05-21T17:26:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 301526cf-4eee-4d1f-a8ce-c0be159577ba, 'Un délice ! Très simple et rapide à réaliser, j''ai juste légèrement sucré le fromage blanc.', '2013-05-21T15:32:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 35b54d29-4b13-43d6-9a33-48aedf32cf66, 'Très bon dessert !!! Je n''ai rien modifié et c''était vraiment délicieux ... J''ai ensuite fait la recette avec des framboises et des petits beurre avec des spéculos et idem un régal !! Merci pour la recette.', '2013-05-20T16:55:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 98282cb4-f4e6-438f-9ddb-4d7941e5c06a, 'Trés sympa et bon. Juste pour que ce soit moins liquide pour pouvoir transporter en voiture et éviter que ca se renverse, j''ai fait moitié fromage blanc et moitié philadelphia.', '2013-05-17T17:17:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 056329d0-90d6-40c5-b9d8-805a56fb31cd, 'Recette rapide et facile à faire : les enfants étaient très fiers de leurs "œuvres". Aussi bon que beau : à refaire donc, avec d''autres variantes...', '2013-05-16T00:48:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70168, 146cc87d-3096-4879-b742-c392871ab0ec, 'Excellent attention de le faire au dernier moment sinon les biscuits se ramollissent.', '2013-05-08T22:56:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 86e7efbc-e66d-48e0-8ff7-eebbdfda6e25, 'Délicieux et frais. J''ai cependant remplacé la marmelade par un jus d''orange pressé. À  conseiller. ', '2015-05-31T21:00:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 209704b1-fd4c-4fbe-9d5f-4d594e0fca6e, 'J''ai remplacé la marmelade par de la confiture de fraises et le résultat est parfait. Très bonne recette, à conseiller.', '2014-09-28T15:29:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 135385dc-7612-46c8-aaf2-5a6de19407c2, 'Très bon ! Ma suggestion : servir avec quelques quartiers de fraises ou des framboises à la nage.', '2011-06-18T20:30:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 62b4c7c2-4956-4f09-9335-9a92b4cbd079, 'Vraiment très bon. Pour éviter les grains, je l''ai passée au tamis. Le tout servi dans une verrine avec une paille! Vous n''avez plus qu''à déguster.', '2011-03-14T16:52:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, b5632c43-7baf-4cb1-af93-22ecc4768bb2, 'Tout simplement délicieux et si léger, onctueux... Ne pas hésiter à incorporer plus de marmelade que prévu et de vraiment bien mixer le tout. Je l''ai proposé avec un quatre quart aux pommes: parfait!', '2004-04-04T12:47:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 8a7e4d71-a1ae-43a0-b637-cd6bb3d2d055, 'Très frais.
', '2023-05-25T22:40:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 78dc518b-464e-48bc-aa18-eefdeb3b9a85, 'Délicieux et très simple', '2021-04-21T01:54:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, e27ba8bf-f8b0-4034-a608-048a73e200f7, 'Très bon et frais parfait pour accompagner un fondant au chocolat... j''ai respecté la recette... j''ai juste ajouté quelques framboises entière avant de servir...', '2018-04-15T05:30:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, bebfae5e-33e0-4c4e-bc6a-4cecb927e0d0, 'Facile à faire et vraiment très bon !', '2017-06-18T17:31:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 4238dc89-268e-4160-a6f3-0ecc8b9706c8, 'Délicieux avec un peu de menthe ! ', '2016-06-19T23:21:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 3e50871d-6833-4608-9d5b-6123aa7f0521, 'J''ai ajouté quelques feuilles de menthe pour accentuer la fraîcheur. Excellent !', '2013-04-21T12:23:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 69c1efa7-a226-4d79-af29-fb1eed03a012, 'C''est très bon  ', '2011-05-20T02:19:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 75da0f1d-66ae-4919-9188-a30cb00a286c, 'Toute la famille a aimé avec la glace à la vanille, je n''ai pas mis la marmelade mais c''était bon quand même.', '2010-04-18T21:51:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, a536b009-29c5-4010-ae54-90b965b0dcfc, 'Très bonne, j''ai mis de a confiture d''abricot et de la liqueur de pêche.', '2009-05-22T03:04:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, c1bbfea1-b6fa-482f-b4b7-87fbbedde952, 'C''est vraiment très bon, facile et rapide à faire.', '2009-03-07T19:38:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 3ddc0aae-de89-4db8-953f-5ba8c1017485, 'Très simple, très bon. Une réussite!', '2008-05-14T21:02:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 91c4af1e-2051-40e3-ab81-5a2226668dfe, 'Très simple et très bon. Préférez la faire en été, elle sera d''autant plus appréciée (et abordable).', '2008-02-10T20:30:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, c04fbbf7-bd56-4939-a8be-c34cf2f9bd46, 'Délicieux, tout le monde a beaucoup apprécié ce dessert très rafraîchissant et goûteux.', '2007-07-06T18:35:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 749f1096-e5a1-4284-b516-9efc98b2400a, 'Tres bon ! Et j''ai servi cette soupe avec des beignets de carnaval. Tout le monde a apprécié ! A refaire avec beaucoup de plaisir.', '2007-03-11T15:02:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 436e7aac-06ec-44ec-924c-d7ee57ddfbc3, 'Parfait! Je n''avais pas de marmelade et de citron et le résultat est quand même concluant.  Je la verrai bien accompagner un gâteau au chocolat ! Miam miam.', '2006-07-30T20:14:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 249ad647-27a7-4718-be0b-aad3265f1330, 'Avec de la chantilly c''est encore plus onctueux!!!', '2005-08-27T01:17:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, bffd3a37-1116-4a1c-9c05-9abeab880a2a, 'Parfait, très frais, un délice avec de la glace à la vanille.', '2005-06-29T00:43:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, c7c729b9-351a-410d-a8a2-bccf32e306f1, 'Tout simplement délicieux! C''est frais et c''est un régal. J''ai juste remplacé la marmelade d''oranges par de la gelée de groseilles, c''était très bon, servi avec les sablés faciles (recette marmiton)... Tout le monde a adoré! Merci pour cette recette!', '2005-06-13T17:29:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, 0e714a9d-0a37-49a3-b12e-3214c680ca0f, 'Remplacer la marmelade par un peu de martini blanc, servir comme une soupe en dessert avec en décoration une fraise coupée en tranches dans chaque assiette, et une boule de glace vanille.', '2005-04-26T15:49:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18527, d988ce8c-3a2a-4ac4-8387-cebaaad51533, 'Très bon, mais reste cependant un accompagnement, tout du moins avec cette recette.', '2003-04-16T22:15:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, d3bf38b4-e5fb-48ed-9356-7b46dcae6f98, 'Excellent ! Bien moelleux. Je l''ai cuit 25 min à 190°C.', '2011-12-04T23:44:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, dc42455e-7196-4000-b2fc-95a8e549a76e, 'Nous avons adoré. 
Pris dans les avis: pommes au fond du moule, moins de sucre et incorporer 2 blanc d''œufs montés en neige.
Un régal ', '2023-01-21T20:26:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 45acd04f-59ed-48e8-993d-8ae839326e49, 'Je profite du contrôle des commentaires pour signaler que l''une des photos n''a rien à voir avec la recette... ', '2017-03-18T12:17:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 1ccff50d-ef66-46c5-8a70-9222d51b666d, 'Délicieux avec 120 g de sucre, 1 cuillère à soupe de fleur d''oranger à la place du rhum, faire revenir les 4 pommes avant à la poêle avec de la cannelle et/ou de la vanille en poudre et arroser à la sortie du four avec du jus de pommes. ', '2008-11-27T12:41:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 1d27201d-f828-457e-b86c-483825325076, 'Bien, il plaît beaucoup à toute la famille. Rapide à faire d autant plus !', '2023-11-10T18:51:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 5e60811f-77d1-4066-bdc3-694a2e8271b2, 'Très bonne recette. Je la garde dans mes favoris ! ', '2023-08-10T20:13:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 92cce660-cc12-4e3d-b262-637d3afaa0a5, 'Tres bon gateau ! Merci beaucoup pour ce partage', '2020-04-30T00:10:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, fe58c8ca-fead-4c03-afd7-ecb866b93ab9, 'J''ai doublé les doses pour 1 plus gros gâteau, enfin presque, car j''ai mis moins de sucre (180g),et moins de farine (180g),puis j''ai ajouté 1 perle de lait. Résultat : Gâteau fondant, généreux en pommes sans être trop sucré.', '2020-01-12T16:57:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 7e03bcf7-dbe7-47f5-8a45-01cba2dc5010, 'Simple, rapide et excellent ! Je l''ai fait une fois aux pommes et une fois aux poires. Les deux : très bons.', '2013-10-21T20:31:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 840a8d7c-4afb-41fe-a1d6-8ac05bc0a828, 'Très bonne recette, et inratable. Je ne mets pas le rhum.', '2013-08-16T20:48:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 6f427ede-1ed4-44bc-929a-613fb92ebc78, 'N''aimant pas trop le sucre, j''ai réduit la quantité à 100 g comme conseillé > résultat parfait ! Moelleux, pas sec du tout.', '2013-07-09T19:48:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 1d67e1e2-4e39-42f7-bf70-ee4278f5ef62, 'Délicieux, facile et surtout rapide à faire! J''ai suivi les conseils en mettant 100 g de sucre et j''ai doublé les doses et temps de cuisson pour avoir un gâteau plus gros. J''ai rajouté 1 cuillère à soupe de cannelle en poudre. Merci pour cette excellente recette.', '2006-12-10T09:31:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, ab5038d3-a2ff-4cf5-b249-5f3806cdadf3, 'Une recette géniale, très simple et délicieuse. J''ai multiplié les doses par 2 pour avoir un gâteau plus gros et le temps de cuisson par 2 aussi. Pas de surprise, excellent et super facile, un gâteau effectivement très moelleux!', '2006-12-03T16:47:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 55cb70d7-1df3-456e-9bae-9cea242322df, 'Très bon ', '2023-04-25T16:02:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 077cfc62-94ff-4e74-8c58-d695df06c3b1, 'Moi au fond de mon moule, j''ai bien beurré et ajouté des pommes que j''ai caramélisées sur le feu avec un peu de sucre.', '2022-11-11T21:05:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, c6909e29-7886-4994-87e2-ba6cf68f7da7, 'Très facile à réaliser et super bon !', '2022-10-29T03:54:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, b10063fe-dbf8-47b0-b759-eff94c558a8e, 'Très moelleux, fait avec des poires au sirop. Toute la famille s''est régalée!', '2020-04-25T18:18:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 0aa93a46-85ba-4181-beb7-f246bd3ff2e6, 'Excellent !!! Après cuisson, j''ai laissé le gâteau dans le four 15 min sans le faire exprès... il était donc toujours dans un four chaud...et bien  cet oubli a fait de ce gâteau une pure réussite !!! A faire et à refaire !', '2020-04-09T14:14:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, b45ab50b-6c4a-4716-9592-5feab6c2bb4b, 'Recette facile et rapide. J''ai juste ajouté 2 blancs d''oeuf montés en neige pour qu''il soit plus épais et aérien. J''ai mis 4 pommes chantecler... je la garde celle-la, merci pour le partage...', '2017-02-21T22:26:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 308353c6-56ba-4c20-9592-68e2fdff1fe3, 'Je n''ai pas mis de rhum. J''ai doublé la farine, la levure et les oeufs car grand plat mais ai mis 100 ml de lait et n ai mis que 100 gr de sucre et 2 grosses pommes granny en petits dés. un régal !', '2015-03-27T13:44:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, ce126e81-0415-40b6-ba09-dce5b3d45612, 'Recette fortement appréciée par le chéri. je n''ai rien changé si ce n''est un peu plus de lait que prévu, comme cela était conseillé en commentaires. Et une pincée de cannelle en plus car j''adore ça. Je réessayerai avec des pommes caramélisées.', '2015-02-16T00:02:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, cdc04959-b1fa-415f-a506-24d3b561a908, 'Très bon ! Moelleux, mais pas vraiment léger ! Avec 100g de sucre et 5 cuil. de lait comme mentionné dans les commentaires. Du coup, laisser cuire plus longtemps. ', '2014-06-08T19:42:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 375c8c1a-dd83-483b-9e59-d216b7264c30, 'Très bon et léger.          ', '2014-04-11T13:59:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, e2fa40b4-ae93-4df2-84ac-19b0a6576533, 'En ayant respecté le temps indiqué, le milieu n''était pas cuit. La prochaine fois, je réduirai la température et n''augmenterait le temps d''eau moins 15 min ', '2014-03-05T18:57:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, a2b36941-8cca-4182-b22a-f6f9d4353b17, 'Excellent, pour le rendre plus moelleux je mets un maximum de lait et augmente le temps de cuisson du coup.', '2013-12-12T19:15:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, de2114eb-3934-4069-b586-2c81990c4733, 'Très bon ! J''ai ajouté 1 oeuf et remplacé l''huile par 50g de beurre. Rendu vraiment moelleux, ça se mange très bien, c''est un régal... je garde cette recette.', '2013-11-08T21:30:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, f8d2de89-187e-4c31-83e0-44a9cb91c83c, 'Trop sucré, pas vraiment la texture du moelleux que je connais, cependant il est bon et se laisse manger sans difficulté.', '2013-06-29T22:36:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, f62cf8d3-6aee-4594-96cd-c0a75aac9f6d, 'Très bon <3 ', '2013-05-19T18:49:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 9bc4a5d8-e096-4345-bdb6-307dfc390087, 'Simple et délicieux ! Avec ou sans rhum !', '2013-05-18T12:26:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 57255acd-93f2-4cc8-8e15-badc846aea3a, 'Super bon, j''ai suivi à la lettre la recette. Je la recommande.', '2013-03-09T18:07:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, d08a0f94-a42c-413b-bdf4-6c79e98824be, 'J''ai suivi les conseils : j''ai doublé les doses pour 3 pommes. J''ai ajouté du sucre vanillé. Pas mauvais !', '2013-02-25T09:20:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 0785313b-f9be-46a4-9eef-7a0a596c6435, 'Effectivement, en ne changeant rien, c''est très bon !!! La prochaine fois je ne mettrais qu''un tout petit peu moins de rhum, les enfants ont trouvé le goût trop prononcé.', '2013-02-20T11:13:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, f188c93a-db00-40a6-88fa-12c8b42ffdca, 'Vraiment très bon ! Recette approuvée par toute la famille !', '2012-12-10T17:22:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 973ae534-25f6-4297-b755-b7adbbe207c2, 'Ce moelleux est délicieux et je n''ai rien eu à changer à la recette proposée.', '2012-11-04T10:31:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 69995856-fd2e-472b-8d41-a3cc09224330, 'J''ai gardé la recette de base tout en l''ajustant. Je m''explique, j''ai fait un caramel avec 100 g de sucre auquel j''ai adjoint 25 g de beurre en fin de cuisson. J''ai ensuite passé les pommes coupées en quartier dans ce caramel puis les ai mis (caramel inclus) dans un moule carré de 23 cm préalablement chemisé. J''ai ensuite préparé la pâte tel qu''indiqué dans la recette mais avec 100 g de sucre uniquement et je l''ai versé sur les pommes. Le résultat est bon mais un peu sec. De plus, j''ai été limite sur la quantité de pâte. Heureusement qu''avec la cuisson elle a levée et recouvert les morceaux de pommes caramélisés. La quantité de sucre était nickel malgré le caramel, mais il faut dire que mes pommes étaient un peu acides. La prochaine fois, je mettrai plus de liquide pour donner plus de moelleux au gâteau.', '2012-10-16T18:56:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, d5ea5b7a-f496-4d3c-908f-6325de1f8b04, 'Très simple à faire et tellement bon. Que demander de plus. Je l''ai fait avec des pommes mais peut être fait avec d''autres fruits. Recette que je conserve naturellement.', '2012-08-05T12:09:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, db18bffe-ef55-40bf-846b-0f55e745a990, 'Excellentissime !!! Rien à changer !! Merci beaucoup ! ', '2012-06-27T00:07:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, d58a7f03-2a34-4165-8b0a-4f24794ffd89, 'Délicieux ! J''ai testé plusieurs moelleux aux pommes (dont les recettes sont sur le site), il les bat tous de très loin ! En plus il est super rapide à faire et économique !', '2012-06-01T21:28:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 969bdd47-c599-4c14-b8e9-b0e20425a5d4, 'très bonne recette. moi j''ai fait caraméliser les pommes avant de les mettre dans la pâte !', '2012-04-15T19:20:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 5402c839-260f-4547-bd07-387625cdcacb, 'Trop bon... Rapide et facile à faire. ', '2012-04-02T19:59:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 188379c7-2283-4b01-b615-f9b10fb0e27e, 'Rapide, simple et excellent... Bref, à faire et à refaire.', '2012-01-22T22:05:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, db68c0d2-d4b5-4d92-8a5d-e19e4194deb5, 'Très bon gâteau, moelleux à souhait, et tellement facile à réaliser ! Je l''ai fait plusieurs fois avec différents fruits pour varier les plaisirs (bananes, poires...) et j''ai remplacé le rhum par un peu de vanille liquide.  ', '2011-12-24T22:40:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 729034f0-01d7-4911-8af2-a5c32f1de8d9, 'J''ai réalisé seulement la pâte pour faire un fond de gâteau en ne mettant seulement que 100 g de sucre et 2 cuillères à soupe de rhum, le gâteau est très moelleux et léger, cuisson : 10 min à 210°C.', '2011-04-26T17:26:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 6857d081-da1c-4b57-947e-6fcafd386453, 'Délicieux, j''ai ajouté 2 poires, les pommes ont été caramélisées au caramel au beurre salé avant d''être ajouté à la préparation! C''est un régal!', '2011-04-08T00:37:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 183e3e4d-1b54-495b-babc-6a5154fe26fe, 'Très très bon ! J''ai juste réduis la quantité de sucre (100 g) et doublé la dose de rhum pour plus de goût. Excellent ! A faire et refaire...', '2011-03-16T19:32:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, dfbb1dca-0a04-4e6e-91ac-46ea45beb9e3, 'Trooooop boooonn, fait sans rhum, excellent quand même. Merci !!', '2010-04-11T13:17:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 09dbde8c-c315-4398-b202-b74adcc0283d, 'Ce gâteau est bien moelleux mais assez fade à mon goût.', '2010-03-16T15:53:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, f079d2d4-dd1f-4e0d-b833-d26280bc9940, 'Ce gâteau est délicieux : il se mange aussi rapidement qu''il se fait. En suivant les commentaires précédents, j''ai mis 100 g de sucre et fait cuire à 190°C. ', '2010-03-14T21:02:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 23f2b645-947d-40dc-bda7-e1d8b77d0ec9, 'Très facile à faire et délicieux. Le gâteau est réussi à tous les coups', '2009-11-02T15:44:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, dba75bfc-b954-495a-b297-cf43fdea44d3, 'Très bon gâteau même si je ne mets pas 5 car nous l''avons dégusté en même temps que des muffins aux poires et aux pépites de chocolat qui étaient sublimes... (et que je note 5! cqfd)', '2008-11-01T21:44:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, cdb704cc-8f93-4db2-9332-b21a5a2561c0, 'Bonne recette: rapide et simple. J''ai mis, comme d''autres, 100g de sucre, remplacé l''huile par de la crème liquide et le rhum par du calvados.', '2008-07-06T22:05:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 8aa597a6-4042-4a10-8645-2e0ae2866f89, 'Excellent! Je l''ai fait hier soir et ce matin disparu... Du coup à refaire et rerefaire... Par contre j''ai mis 4 belles pommes car, personnellement, je préfère quand il y a beaucoup de pommes et il a cuit pendant 35min ! Merci pour cette super recette.', '2008-06-12T17:22:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 7bdff1c7-fa3a-4786-8e88-77910f81e0bd, 'Recette simplissime et délicieuse. J''ai mis une cuillère à soupe de muscat pour la parfumer et c''est étonnant ce que ça change ! C''est délicieux!!! ', '2008-04-05T19:18:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 19d5a2cc-ef9d-4d5b-875c-0386039c8f5f, 'Très bon. Très rapide et très facile à faire. Très pratique pour des invités de dernière minute car ce sont des ingrédients simples que nous avons en général dans nos cuisines... Merci pour la recette.', '2008-02-11T12:51:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 5d04e977-4363-4589-a044-a69c55be500e, 'Délicieux. Je fais la recette régulièrement et toujours le même succès. C''est tellement agréable de faire plaisir avec simplicité!!! Merci.', '2008-01-20T20:13:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 5535991e-3d22-4d0d-91a4-e24f1e3546e1, 'Super  rapide, super économique, super moelleux, super bon... J''ai juste ajouté une cuillère à soupe de liqueur de pomme (type manzana).', '2007-11-16T22:41:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, ef893d5a-e454-4a70-bb05-c99f4346ac26, 'Délicieux!!!! Je le fais souvent et il a toujours autant de succès. En plus, c''est super simple, je vous le conseille vivement.', '2006-12-02T21:36:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 3eef36b5-19f8-4b3b-81f9-e616a032e4a2, 'Excellent! J''ai suivi la recette, j''ai mis tous les ingrédients dans le robot (sauf les pommes ), puis j''ai rajouté les pommes. En y ajoutant les conseils de Maud, pour avoir un plus gros gâteau. Temps de cuisson qui double aussi. On obtient un super gâteau, qui se mange très vite!!! MMmmmmh, il me rappelle aussi le gateau aux pommes de ma grand-mère!  Merci pour cette recette que je rajoute à mon carnet !!', '2006-10-28T17:36:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, e90c692b-c5f8-475e-bb92-7595189454b5, 'J''avais un peu peur de sentir le goût de l''huile mais... pas du tout! Mon mari et ma fille (pourtant si difficile) ont adorés! Très bon, pas difficile et rapide...J''ai adopté et la famille aussi. Il n''a pas fait la journée!', '2006-10-20T20:00:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19824, 1d796aa5-3fcc-4c85-a916-0519358d6b85, 'Très facile et vraiment très bon. J''ai mis moins de sucre comme conseillé dans un des commentaires.', '2006-07-05T18:10:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 740b938c-521f-4b19-864f-05bcaf3164a2, 'Recette suivie à la lettre, très bon résultat 👍', '2023-05-02T13:39:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 9c440f20-fca3-450d-a07e-d1905c0e758c, 'Super bon🥰', '2023-04-25T16:48:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 98a56f91-a722-49db-b807-3c846c6e971b, 'Excellent !!!! Et super facile même pour moi qui suis nulle, vraiment très nulle, en pâtisserie.', '2017-01-14T08:50:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, f5581241-75ac-4138-983d-10345e6f75c4, 'Bonne recette simple a réaliser', '2023-05-30T18:08:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 61c32570-903f-43c0-b454-cea4febcc807, 'Délicieux avec un peu moins de sucre et de beurre pour le glaçage.', '2022-11-06T12:08:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 03bfa10e-e5d8-444c-97df-eb97338d6b24, 'Super bon et léger !', '2022-10-27T19:54:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 014155e6-66e9-463e-ba80-27af684b7c93, 'très bon ; serait encore meilleur moins sucré et moins gras - il suffit de limiter le glaçage - encore meilleur avec les pommes au fond', '2021-05-23T12:03:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 04a68ebc-7a5e-429c-835f-abe7d9757415, 'Beaucoup trop sucré et gras à mon goût. Mais le reste de la famille a aimé', '2021-03-27T20:46:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 0bbcd5f9-7302-4e37-8443-825d48c92f65, 'Super moelleux ? j''ai doublé les doses et juste nappé à l''œuf et sucre vanillé.
À refaire sans hésiter ', '2021-03-12T22:42:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 234f0768-973c-4d21-b1ec-a4c7c40a5fa8, 'Beaucoup trop sucré', '2020-11-13T17:30:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 993cf493-4aff-4651-afb4-418e706a9cba, 'Mon gâteau a le goût de l''oeuf... Peut être dû au glaçage ?! J''ai bien suivie la recette pourtant, je sais pas pourquoi. (Et trop sucré +++).', '2019-03-12T17:27:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 331bf145-ab3a-4cfb-a19d-b7d276a24670, 'Un peu sec, j''ai goûté meilleur.', '2016-08-23T18:37:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 3dfff296-ab2c-4ef3-a680-ede17ab4603e, 'Pour ma part je mets un peu de calvados dans la pâte. Gâteau qui a un énorme succès.', '2016-07-20T21:49:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, e22d8933-b4cc-4206-aa10-69389d34ff88, 'Excellent, c''est un super bon gâteau. Facile à faire !', '2016-04-16T23:02:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, c951a3de-be38-4ec1-8281-57076833fc91, 'Excellent mais j''ai rempli le moule de pommes et j''ai doublé les doses !!!!!', '2016-03-20T17:55:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 8df99d2c-d623-4879-9869-ef88c1667a09, 'Je l''ai fait ! Délicieux ! Par contre j''ai augmenté les dosages de 2 cuillères pour un moule à manqué de 26 cm. J''ai également fait revenir mes morceaux de pommes dans un mélange sucre et beurre et j''ai fait flamber avant d''incorporer à la pâte. C''est une idée toute personnelle car il est délicieux tel que dans la recette.', '2015-11-27T18:50:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 1874ba38-9ca6-496a-ad0b-2a356728a06a, 'J’ai aimé le faire et le manger, mon fils a adoré, mon mari ,plus difficile, l''a trouvé fin et moelleux ', '2015-05-11T15:18:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 82202d5b-138c-459b-949f-72b87d1bba52, 'Top top ! J''ai fait 1,5 fois les doses pour un moule à gâteau rond. J''appréhendais les mesures à la louche, enfin à la cuillère, mais en fait le résultats est juste parfait ! Aéré, pas trop sucré. Je n''ai pas fait le glaçage.', '2015-02-04T22:05:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 83f5a371-82da-43bf-a184-c34755d769b6, 'J''ai fait cette recette sans faire le glaçage et dans un moule à cake, c''était génial ! Vraiment délicieux', '2015-01-20T12:37:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 5327f8da-a09a-40d3-8445-b7cd702067f9, 'Très bon mais la prochaine fois je mettrai moins de sucre sur le glaçage ', '2014-11-07T22:37:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 0a4dc9b2-3ebf-43a4-abcf-803d43780559, 'Un régal. J''ai également augmenter les doses de 2 cuillères à soupe et la prochaine fois je mettrai moins de beurre pour le glaçage... Ma fille adore !', '2014-10-27T17:24:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, cf3c694b-69e3-46dd-8b4f-c0ec7f93ac01, 'Très facile et toujours très bon  ', '2014-10-08T15:47:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 8f5ad639-8107-4bd6-85ed-dcc90343a045, 'Wow ! Excellent ! Pas trop sucrée malgré le glaçage, une recette bien proportionner ! Attendre un peu plus de 5 min (7min pour ma part) avant de mettre le glaçage. C''est une recette simple, appréciée et redemandée par tout le monde : à vite refaire !', '2014-10-06T17:58:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 2214f818-6e7c-4076-926f-76868fe3dd2d, 'Trop bien, y a même pas besoin de balance !', '2014-08-26T13:43:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, fb7ed0f2-d6fb-4ae5-a409-629d06594f07, 'Juste un mot : EXTRA  ', '2014-08-12T20:47:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 01667a6f-6908-4697-99f6-d827b130c57b, 'En panne de dessert, j''ai testé ce moelleux sans le glaçage. Il est pas mal du tout, il dépanne bien si on a envie d''une note sucrée. Par contre, il n''est pas si moelleux que ça. J''apporterai des modifications à la recette originale afin de voir si je peux le rendre encore plus moelleux. Je garde cette recette sous le coude à présent.', '2014-07-31T23:06:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, dc11d230-bee8-4fd2-a89c-d1b9a3b554b2, 'Un délice, les ingrédients sont très justement proportionnés et le résultat n''est pas trop sucré, mais attention : impérativement doubler les quantités pour éviter un résultat ridicule. Badigeonner le glaçage au pinceau pour répartir correctement sur tout le gateau car les quantités pour le glaçage sont un peu trop importantes. Ce gâteau fera partie sans aucun doute de mes recettes maison', '2013-11-18T10:26:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 9cb501c2-99a7-47b2-a645-a98e9f05428c, 'Très bonne recette ! Je l''ai faite avec glaçage puis sans glaçage et elle est très bonne sans glaçage. Pour le glaçage j''ai diminué le sucre sinon il aurait été trop sucré et j''ai aussi attendu plus de 5 min pour le mettre sur le gâteau car il n''était pas encore assez cuit. Merci marmiton pour ce délicieux gâteau !!! ', '2013-10-30T20:17:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, e1294986-865c-4426-818a-5497400ea9fd, 'Très bon gâteau, attention pour le glaçage il faut réduire les ingrédients sinon ça déborde !  ', '2013-10-09T15:42:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 93d22e56-6d82-41bd-a02b-4f34678d133c, 'Merci pour cette recette, je viens de le goûter après l''avoir préparé, bon gâteau, mais j''ai rajouté 2 C à S pour tous les ingrédients, et j''ai bien fait sinon il aurait été très plat. Et en ce qui concerne le glaçage, je l''ai étalé au pinceau, sinon il aurait été trop gras, donc j''ai diminué les mesures par 2. ', '2013-09-19T20:16:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, f2d215c8-69d9-4dd2-8061-ac668202e453, 'Je l''ai testé aujourd''hui au travail...mes collègues n''en ont pas laissé une miette ! Durée de vie de ce gâteau : 5 min... Merci un régal ! Petit clin d''oeil à la Bretagne : j''ai remplacé la moitié du beurre par du beurre salé', '2013-09-10T22:30:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 183937dd-68ba-4a44-9742-bd132f86a62c, 'Recette délicieuse. Elle fait partie de mon top 10 ! Je la fais régulièrement car j''ai beaucoup de succès avec. J''ajoute une cuillère à soupe de cannelle dans la pâte à gâteau ! Merciiiii pour cette recette', '2013-05-05T11:40:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 58fc48c2-89ed-47d4-9cb2-f262b08de557, 'Merci pour cette délicieuse recette facile et pas chère. Mes enfants et moi avons eu une très bonne surprise en goûtant le gâteau. Pour le glaçage, j''ai diminué le sucre et le beurre et c''est parfait ! Merci encore !', '2013-04-04T20:42:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, f14bf3c5-e73b-42e8-bbdc-6f34658aab24, 'Gâteau excellent, facile à réaliser. Le temps de cuisson n''est pas bon : j''ai dû le cuire environ 30 min avant de mettre le glaçage puis encore 10 min pour que le tout soit bien cuit. Si vous mettez le glaçage trop tôt, il s''enfoncera dans le gâteau.', '2013-03-10T16:38:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 53e1c68c-d00c-40d5-ade5-57eb795105f6, 'Excellent ! Il faut lire 25 à 30 min de cuisson et non pas 5 min sur la recette. J''ai déjà fait cette recette plusieurs fois et avec des poires à la place des pommes. Un vraie régal. Merci pour votre recette !', '2013-02-05T14:32:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 815bfbbb-6c36-48ec-acb1-243bc9a227bf, 'Recette essayée plusieurs fois et toujours avec succès mais en modifiant passablement les quantités: il faut doubler toutes les quantités pour la pâte et ajouter 1 à 2 pommes. Pour le glaçage: 120 g beurre, 150 g sucre, 1 oeuf, 1 sachet sucre vanillé. Cuisson: 40 mn à 200°. Délicieux.', '2012-10-24T16:03:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, f075284a-959e-45ac-96d6-ceae34ef316d, 'Honteusement moelleux ! J''ai seulement ajouté de la cannelle sur les pommes, et mis moitié jus d''orange et moitié rhum dans la préparation et pour le glaçage.', '2012-10-15T12:16:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 900c6a57-36e4-45d1-b64a-a3ae8bef88c2, 'Trop gras, gâteau tout ras plat plat, super déçu. Il faut utiliser un petit moule à manquer. Pour le glaçage beaucoup trop de beurre, très écoeurant, il faut diviser les denrées. Pas aimé du tout.', '2012-08-02T03:48:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 0ae16f6c-9db2-4867-9abf-37cf3a30691f, 'Il est bon et moelleux par contre j''ai mis si une cuillère d huile et pour le glaçage j''ai divisé par 2 le beurre et le sucre et il n était ni gras ni trop sucré juste ce qu''il faut. A refaire et il est hyper rapide.', '2012-06-21T23:14:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, f5264fc8-fa63-4aff-ab7c-fb029c3d2d95, 'Bien moelleux et le glaçage donne le côté craquant. Délicieux, à refaire.', '2012-05-10T13:03:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 82194282-847d-468f-8b6c-58b9a66f8411, 'Je n''ai pas du tout aimé ce gâteau, trop le goût d''oeuf et même en aimant le beurre, il fait assez gras donc écœurant, même les enfants n''ont pas aimé. Bien déçue', '2012-05-09T12:55:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, c3430b8c-8713-4e75-a9b7-699a9d2db382, 'Très bien même sans glaçage, par contre, la prochaine fois je mettrai moins de sucre', '2012-03-21T22:27:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 631155dc-a9bb-42b3-bfb2-69b5e84e3026, 'Je viens de faire ce gâteau raté pour ma part la pâte est trop fine car le moule était trop grand il est aussi trop gras ! Néanmoins je le recommencerai avec moins d''huile et de beurre et dans un moule plus petit !', '2012-03-05T21:16:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, f6f51763-37b1-4870-9b03-8e6f7a56b3d5, 'Et bien je vais jouer les rabats-joie en trouvant que ce gâteau n''était franchement pas terrible. Le glaçage est vraiment trop gras. C''est la vrai que la recette est très rapide, je vais peut être ré-essayer en allégeant ce glaçage qui casse tout le gout des pommes et du biscuit.', '2012-02-09T12:34:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 3c235132-ac0a-416c-b638-63a4d19fc65a, 'Ça fait la deuxième fois que je fais ce gâteau, il est vraiment bon, j''ajoute 2 cuillères de farine au lieu de 5 et 1 cuillère à soupe d''huile au lieu de 3 car trop gras au sinon ! Merci Marmiton ! ', '2012-01-20T22:16:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 7dffc9f6-44bd-4a8b-80a2-cea981517373, 'Que dire !!!! Juste excellent, super à faire avec ma fille de 3 ans 1/2.', '2011-11-26T18:48:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, e1827096-5c71-426d-8e05-0561dbc8e3aa, 'Joli résultat à la sortie du four. Simple et rapide, juste un peu trop sucré, mais j''ai néanmoins adoré et dévoré... miam ! ', '2011-11-16T17:04:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 282c9b4a-c770-4aac-935e-f4a73b6e3f12, 'Effectivement il n''y avait pas assez de pâte j''ai donc utilisé un petit moule. J''ai fait cuire le gâteau 20 min. Les doses de sucre sont parfaites mais j''aime les gâteaux très sucrés.', '2011-08-31T22:13:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 1f288c21-812d-43d7-9d40-a44642395201, 'Gâteau très facile à faire et qui a fait l''unanimité !', '2011-06-12T18:17:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 13d1350c-5489-40d0-9ca5-1150a9ba5d93, 'Merci pour cette bonne recette. Gâteau facile à faire. J''ai doublé les proportions (sauf pour le sucre). C''était très bon.', '2011-05-23T20:53:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 5c03847f-c449-43cd-9e25-c94dbe55416c, 'Le glaçage est un peu trop sucre pour moi mais le gâteau est délicieux merci !', '2010-12-23T18:34:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 00cf9e2a-5ff5-4e3c-bba9-8c54d6b7f96c, 'Après avoir mélangé tous les ingrédients, j''avais tellement peu de pâte que j''ai décidé de la verser dans un petit moule. Du coup, le centre n''est pas assez cuit et le glaçage trop! Je reste cependant persuadée que cette recette peut être vraiment bien. Je vais la refaire en doublant les doses et en utilisant un moule de taille standard. J''aurais bien aimé avoir plus d''indication sur le temps de cuisson.', '2010-02-02T23:07:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 8b0343f2-034a-41af-b09b-37b5ad954b96, 'Le glacage a un goût d''oeuf très prononcé.', '2009-03-26T18:00:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, e140c7be-2705-42a7-8bef-c59f1e4c3610, 'Excellent! et le mot est trop faible ! Un moelleux et ce croustillant dessus .... Un régal, et tellement simple à faire, par contre j''ai doublé les doses pour un gâteau encore plus gros ! Merci pour cette recette virginie.', '2009-02-21T17:58:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, df30c362-d3d0-40c4-870c-f61b844c35c6, 'Excellent, vraiment! Très facile à réaliser.', '2009-02-17T16:05:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 4eb1c00f-25c2-486f-93f1-7b15e7bb69e8, 'Très bon gâteau avec moins de sucre pour moi, un peu de rhum dans le glaçage, vraiment une réussite.', '2009-02-14T12:04:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, dd98373c-ef81-422d-a6fe-c2c29d264d9d, 'Un gâteau très léger et super bon! Je n''ai pas fait le glacage, mais très bon quand même! Merci pour cette recette!', '2008-10-17T20:23:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, e3b8f8b6-9859-47aa-be2c-628e046b64e7, 'Très bon gâteau facile à faire et apprécié de tous... Le glaçage termine tous le gâteau avec sa petite note de caramel! Merci et régalez-vous...', '2008-10-15T13:07:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, 7e16b493-72ac-4e7b-b1ca-66a63ef26e5c, 'Vraiment facile à réaliser (sauf que j''aurais vraiment apprécié d''avoir une meilleur notion du temps de cuisson). Je l''ai réalisé 2 fois : une fois avec la quantité de sucre préconisée (c''était un peu trop sucré) et une 2ème fois avec un peu moins de sucre (et cette-fois là gâteau aurait mérité d''être un peu plus sucré). Donc, je diminuerai (mais très peu) la quantité de sucre la prochaine fois. Si, comme moi, vous doublez la quantité de pâte, serrez bien les tranches de pommes pour qu''il ai bien le goût de pommes. Très bon. Merci pour cette recette. ', '2008-10-07T15:14:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32831, b789b21d-23f8-4ab1-84fd-0354c3759d20, 'Très léger, idéal pour une fin de repas. Facile et rapide à faire.', '2008-08-19T14:34:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 760c0932-b1ce-4f32-9534-55164ec32486, 'Pour plus de gourmandise je rajoute des pepites de chocolat. Je rajoute aussi les pommes à la fin sur le dessus pour qu''elles ne tombent pas toutes en bas.', '2018-10-11T09:33:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 14ae45f4-7ed0-4d9e-96be-fbcb5c73b46d, 'Super recette. Prévoir un temps de cuisson plus long', '2021-11-27T17:15:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, b55d1a5c-3daf-498a-bb5a-ac3670fc670a, 'Une tuerie. Le meilleur cake aux pommes pour ma part.', '2018-03-10T13:17:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, d543eff0-4dbe-46bb-b0fe-5b2b6b2831c9, 'Super recette ! Comme indiqué dans d''autres commentaires, j''ai mis 150 g de sucre. ', '2017-03-15T15:59:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 39f2f6d8-0ed8-48f2-b208-cb5afef2ba31, 'Excellent, moelleux; j''ai mis 150 g de sucre au lieu de 200 g et 35 minutes au four. Top top ! Je le referai.', '2015-10-11T23:00:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, e973f439-489f-440d-92e8-9fc8764c1d13, 'Pas de goût, fade. je déconseille ', '2015-09-10T03:09:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, d98e11fa-d517-491e-a082-633113088ef5, 'Excellente recette ! N''ayant plus de cassonade j''ai utilisé du sucre vanillé, 3 paquets de 7.5 g chacun et j''ai également mis moins de sucre, 140 g suffisent. Pour la cuisson j''ai suivi les conseils et j''ai mis au four chaleur tournante 180 degrés 35 minutes. Au top !', '2015-05-10T22:13:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, c2cd707b-3697-499f-a1a5-0816e03e1822, 'A l''ajout de la cassonade et malgré le fait que les pommes aient cuit un peu avec...la pâte est devenue un peu liquide. Le cake était bon mais un peu effet mouillé...', '2015-04-17T12:25:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, f40163b2-dbda-40ed-b4c7-fceefc32b8ad, 'Je mets un 3/5 à la recette telle qu''elle est décrite. Le gâteau est moelleux mais pour moi, il est trop sucré et il a beaucoup de mal à cuire; d''ailleurs, il y a des parties qui n''ont pas cuit. Je le referai mais en mettant moins de sucre, cette fois-ci. ', '2015-03-11T19:08:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 1b096727-b4b0-4db5-8961-b0878d296a99, 'Délicieux !!!', '2015-02-10T12:46:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, ba06a618-340f-496c-90ae-0a923cd66c00, 'J''ai juste mis 150g de sucre à la place des 200g indiqués, ainsi qu''une cuillère à café rase de cannelle (10g me paraissant, comme à d''autres, vraiment trop, mais c''est simplement une question de goût), et c''était parfait, moelleux et fondant à souhait. A peine cuit, sitôt dévoré, et l''on me demandait déjà de le refaire !', '2014-12-14T20:04:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 4a37507a-7632-4afc-9ed1-93be853143b7, 'J''ai fait un malheur avec cette recette :) merci beaucoup !  ', '2014-11-08T15:59:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 5f33fa60-4048-4b2c-bf3b-5b238015e441, 'Excellent ! ', '2014-11-04T20:44:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 2f02bbe4-ee8f-4561-ae4c-fbb499c277d5, 'Délicieux !  J''ai mis beaucoup moins de cannelle que conseillé et ça goûtait quand même encore fort la cannelle.  Je le referai sans hésitation. ', '2014-10-04T22:48:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, a83160eb-60e0-414d-a7d0-f82e6c8b0fcc, 'J''ai apporté les modifications suivantes: au lieu des 200 g de farine, mettre 150 g de farine et 50 g de maïzena et seulement 150 g de sucre ', '2014-05-03T22:08:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 910a80c1-259a-422f-9b19-328a2645061a, 'C''est vraiment trop bon !', '2014-04-27T00:45:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 98756baf-6310-4931-bb83-db32edeecad2, 'Parfait, excellent. ', '2014-03-29T15:35:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 75d195bc-1e58-4b8e-9c80-c7c214216a5b, 'Une tuerie ! On s''est régalés !  Je n''avais pas de sucre roux, j''ai mis du sucre en poudre normal, et c''était tout de même excellent.  J''ai aussi mis moins de cannelle, car 10 g cela me semblait énorme, chacun peut en mettre à sa convenance, il suffit de goûter la pâte avant cuisson :)  Il est moelleux à souhait et s''accompagne parfaitement avec une boule de glace vanille, miam !', '2014-03-12T19:56:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, fd0e1502-c723-42b5-86d9-43e0578ea3ae, 'Excellent. Merci pour cette recette.', '2014-03-01T18:46:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, fd51dfb8-890a-4fdc-854d-9875a9d3057b, 'Délicieux ! On sent vraiment bien la cannelle, j''adore !', '2014-02-22T22:03:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 38aed7c0-5616-4972-8338-7a32143e5f36, 'Suivant un conseil donné en commentaire, j''ai plutôt fait cuire à 180°C. C''était un très bon conseil car, même comme ça, mon four n''étant pas à chaleur tournante (traditionnelle), le haut a légèrement brûlé. Sinon, excellent.', '2014-01-20T18:54:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 5dc00e90-b244-4df2-8c6e-8b922449b3cb, 'Très bonne recette ! Les enfants ont adoré ! J''ai moi aussi mis moins de sucre et de cannelle ; et je verse le jus de cuisson des pommes sur le cake à la sortie du four (elles rendent leur jus lors de la cuisson avec la cassonade) ça le rend encore plus moelleux.', '2013-12-05T18:39:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 65d3bb8d-ef91-40b6-a91c-01a7b39726f8, 'Très léger, très bon, j''ai lu les commentaires et mis moins de sucre (180g). J''aurais même pu en mettre moins, parce les pommes sucrent déjà le gâteau, mais c''est mon avis, les enfants ont adoré !!!', '2013-09-15T13:09:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 2992afad-8257-4a5c-9ff8-fbfa49f7c52a, 'RAS tout est conforme à l''idée qu''on se fait avec la photo ou en lisant la recette ! Très très bon dessert !!!!', '2013-09-05T02:35:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, b5e426cf-3a83-429b-bced-699d41f6b8f0, 'Très bon mais je ferai quelques modifications pour la prochaine fois: Moins de sucre, moins de beurre et le four moins chaud (180°C suffisant). Je chipotte, un délice quand même...', '2013-07-05T13:12:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, ecb31812-df33-4c4a-b947-9bedf3d86793, 'Je l''ai faite : un régal. Par contre, j''ai pas mis autant de sucre et j''ai caramélisé les pommes avec du sucre roux. Huuum ', '2013-05-03T18:01:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 8605e317-f9ae-4fc8-a41e-a03163e8e9df, 'Excellent c''est peu dire... Une tuerie c''est le mot exact pour ce gâteau moelleux et délicieux à souhait. Je vous le conseille vivement.', '2013-04-23T00:05:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, f6dfe2b7-48f8-4a82-8ec3-d784178632da, 'Délicieux ! Facile à réaliser. Rien à dire de plus ! Merci pour la recette.', '2013-03-16T16:39:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, ec3aca81-2357-4fad-9375-3d43841bca89, 'Parfait !! Au goûter, avec 8 enfants de tout âge, ils ont tout dévoré. Je n''ai pas mis de cannelle, je l''ai remplacé par de la vanille. Encore chaud, c''est au top !', '2013-03-11T14:57:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 221c3575-9790-4d13-83fa-72a54a58502f, 'Avec un petit moule, j''ai divisé par deux les proportions, et à cause du silicone, le dessous du gâteau collait... Mais bon, pas grave le gâteau était délicieux !!! Merci.', '2013-02-28T20:03:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 6ac73c70-1c00-476e-8ec4-931b67bf618d, 'Excellente recette, j''ai mis 3 œufs, un sachet de sucre vanillé et une pincée de bicarbonate. Trop bon, à refaire.', '2013-01-05T13:40:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 37176342-cc42-4c3c-ad1f-09d988351669, 'Délicieux tiède ! Par contre, je l''ai cuit à 190°C pendant 30 minutes.', '2012-11-12T19:25:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 17e6ee5a-9b32-42cd-8c6e-f738ad13aac7, 'Je l''ai fait il y a deux heures et mon homme et moi luttons pour ne pas le finir avant demain matin ! Vraiment très bon ! J''ai juste préféré mettre moins de sucre (150 g) et j''ai ajouté des petits morceaux d''abricot sec ! Un vrai délice ! ', '2012-11-04T19:51:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, e89356c7-fb2c-4d70-968e-b4b1a60fb398, 'Fait partie de mes grands classiques depuis plusieurs années ! Merci !', '2012-10-30T11:31:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 56346e56-11f8-481c-8663-fed241117111, 'Je viens de faire ce cake et il est parfait. Merci pour cette super recette !  ', '2012-10-28T15:17:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, edc7d1f6-c09b-4ac1-9bc4-32bd361f1114, 'Trop bon ! Néanmoins, la prochaine fois je mettrai un peu moins de sucre, mais bon ça c''est une question de goûts...', '2012-10-22T19:49:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, b3ba0d0c-86f1-4e43-bfad-09b4837b8f36, 'Certes cake très très bon, pour ma part je pense qu''une pomme en plus et la moitié moins de cannelle est parfait... Régalez-vous. ', '2012-10-21T17:48:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, d5c116f4-a0ad-4f61-aeb0-ff1c5b8805f1, 'Impeccable, tout le monde a adoré. J''ai cependant réduit la dose de cannelle en ne mettant que 5g au lieu de 10, et c''était vraiment suffisant. Mais bon, après c''est une question de goût.', '2012-10-19T20:53:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, e3227d36-a09f-4a71-8717-86fd84990b63, 'Excellent et très rapide à faire. Il m''a juste fallu rallonger le temps de cuisson (environ 40/45 min en tout).', '2012-10-08T14:04:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, add6b11c-bdf7-41cf-9e1d-0a2f27980108, 'J''adore les gâteaux à la pomme ! Juste quelques modifications. D''abord, je me suis aperçue au dernier moment qu''il ne me restait que 50 g de beurre, mais pas de panique ! Je les ai incorporé directement dans la cuisson des pommes que j''ai fait caraméliser en saupoudrant de sucre de canne et un filet de citron. J''ai également mis de la cannelle à ce moment là et j''ai laissé mijoter jusqu''à ce que les pommes soient bien caramélisées et cuites. Pour préparer l''appareil, je n''ai mis que 150 g de sucre, et un petit filet d''huile. Au final, un gâteau plus léger car moins de sucre et un sachet entier de levure, donc bien gonflé ! Et des pommes ultras fondantes !', '2012-09-25T14:25:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, cf232175-f759-4b7c-867e-505340f0eb14, 'Juste trop bon, il a "disparu" en 2 temps 3 mouvements!', '2012-09-22T14:48:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, f14aa5cd-1164-44a8-9e81-0df163c519f8, 'Très simple à faire et très bon. Astuce : enfariner légèrement les pommes avant de les mélanger à la masse. Elles ne tomberont pas au fond du moule.', '2012-09-15T19:13:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 2c60ea65-f532-4dbc-ab1a-40b0a0d56770, 'Très bonne recette j''avais des pommes à finir !! Et bien excellent et facile merci !!', '2012-05-05T21:07:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, dfa00c44-5edc-4bd0-b92d-565a0758d009, 'Attention 200 degrés c''est trop fort et le cake noircit', '2012-04-23T19:09:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 671eee9c-b49f-4209-8830-ee58080ee2e0, 'Je ne connaissais pas du tout les recettes de Marmiton. J''avais envie d''un cake aux pommes qui me rappellerait certaines saveurs d''antan eh bien, je suis agréablement surprise par cette recette. Délicieuse, les pommes sont fondantes, le cake est bien gonflé !!! A refaire, c''est évident ! Merci !', '2012-03-25T22:41:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 0d5f8b58-43f6-40f4-aa69-03de597a6639, 'Vraiment bon... mais il y a un peu trop de cannelle à mon goût. La prochaine fois, je réessaye avec 5g au lieu de 10.', '2012-03-19T22:00:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 171e0e8c-6811-4df8-a455-93713cb8a93c, 'Très bon gâteau. Sauf que les pommes sont tombées au fond du moule. Et je ne sais pas s''il serait possible de les fariner après la caramélisation, comme on le fait pour les fruits confits. Le dosage en cannelle se fait en fonction de son goût personnel, du plus discret au plus prononcé. A recommander', '2011-12-22T10:27:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 42334273-3e8c-4ee6-a1c1-418dbbdb9bc9, 'Recette extra pour un cake fondant grâce aux pommes caramélisées. La cassonade ajoute un vrai plus ! Cela fera désormais partie de mes classiques !', '2011-09-29T16:50:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 10b3bf84-7957-4a0a-9395-0f174f4d061b, 'Très bon, mais j''ai remplacé la cannelle par de la vanille ! A couvrir à mi cuisson car le dessus cuit très vite par rapport au cœur.', '2011-05-02T17:37:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 4ae6a0d2-86ee-487b-a4c6-99bdc3104650, 'Délicieux!!! Je l''ai fait sous plusieurs formes : nature (sans pommes), j''ai remplacé les pommes par des framboises dans le fond du moule et je sers avec un coulis de framboises frais, remplacé les pommes par du jus de citron, en grand cake ou en muffins... Je mets toujours du sucre vanillé et un peu moins de sucre. Il a toujours du succès qu''importe la manière dont je le prépare!', '2011-04-07T22:03:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 8f262d27-6017-422b-9c81-5c108e538d51, 'Très bon, hyper facile !! Un gâteau gonflé, très équilibré aux niveau des saveurs. Merci', '2010-09-03T19:43:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 14e5cd78-094d-451b-bdfa-ac9330d8a9f5, 'Super recette. Je n''ai juste pas mis de cannelle (personne dans la famille n''apprécie vraiment cette épice)', '2010-07-24T21:47:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, cbd7c72c-6998-40e8-a301-71f5e8e3c4e7, 'En un mot : exquis ! D''un moelleux, d''un goût à faire pâlir les plus grands chefs ! A faire et refaire !', '2010-04-25T19:41:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 54b658f0-46da-44cb-9980-84a951c2ab90, 'C''est devenu un classique pour mon ami ! Il ajoute un peu de liqueur de calvados, c''est excellent !', '2009-08-11T20:40:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 6714b092-0f8d-4809-80de-757637a4e95b, 'Très bonne recette que je fais sans cannelle car tout le monde n''aime pas cette épice. Délicieux quand même !', '2009-07-16T20:00:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, cc15f8ae-64a0-4ca9-a3d8-b54c5a0f52da, 'Un peu déçue par ce cake, bien que j''aime beaucoup le mélange pomme cannelle, mais là j''ai trouvé beaucoup trop sucré, et pourtant j''ai réduit de moitié la quantité de sucre, et également la quantité de cannelle; bref trop écœurant à mon goût.', '2009-01-24T18:28:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 8bf25e12-5102-47e1-b16b-cce664f5f365, 'Je n''ai mis qu''une demi cuillère à café de cannelle, et déjà le goût était prononcé. A par ça, rien à redire, même les enfants ont aimé le mélange pommes/cannelle.', '2009-01-15T15:07:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, f426aa57-8209-4b35-a460-6e3e314f3cdd, 'Un peu trop de farine et de sucre à mon goût. Je n''ai donc mis que 50 g de sucre et 150 g de farine. La prochaine fois je panacherai farine et maïzena. Du coup, je n''ai mis que 3 oeufs. Ça sent délicieusement bon.', '2008-12-09T23:24:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, 9d0d3b8e-3e40-41d6-ac0b-c61f3c84edbb, 'Vraiment une super recette! Le cake est savoureux, tout le monde s''est régalé. J''ai dû le refaire 2 jours plus tard! J''ai remplacé la 2ème fois la cassonade par du sucre vanillé, c''était parfait aussi!', '2008-05-08T12:07:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33143, a819d54e-a668-487e-be68-c04c1f1a6961, 'Très facile et en plus super bon. Moi j''ai juste rajouté des amandes effilées sur le cake avant le cuisson.', '2008-04-10T22:30:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, 048e8ca9-4c00-408d-ba29-90881c87645e, 'Trop bon!!!!', '2020-06-06T20:05:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, 06adf708-e522-492f-be0c-2b27877a21b7, 'Super recette je la fait à chaque fête des mères. Il faut utiliser du colorant en poudre pour que la couleur tienne la cuisson', '2015-05-30T20:27:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, 9bb21145-12ce-4080-8e97-1a41bbed0515, 'Excellent !! Ca a fait un tabac et c''était un grand plaisir de le faire. Mon macaron n''était pas parfait mais le goût y était. Je n''ai pas réussi à avoir cette même couleur. Mon gâteau à la cuisson palissait. Bizarre mais en tout cas je referai sans aucune hésitation. ', '2015-01-28T14:37:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, cf826a73-f650-4fd9-a777-cc49e0bcfc7d, 'Très bien ! A refaire ! Merci !', '2014-03-30T20:45:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, cd776bd9-f90d-4dc4-b353-bce9d56ca698, 'Bonne recette, cependant impossible de trouver de l''arôme de rose, j''ai dû me rabattre sur de l''eau de fleur d''oranger et du sucre vanillé, le résultat était bon quand même. Autre soucis le dosage du colorant qui n''est pas précis : en partant d''un appareil très rouge j''ai obtenu deux macarons rose pâle.... Mais dans l''ensemble ce gâteau à eu beaucoup de succès même si il était moins beau que la photo.', '2012-11-29T17:58:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, 73b68f71-828d-43fc-a804-8d5495bb58b3, 'Excellent ! C''était la première fois que je faisais un macaron ; j''ai suivi cette recette à la lettre mais lorsque j''ai coupé la pâte en deux (pour faire le dessus et le dessous) il y a eu un côté plus fin que l''autre, la deuxième fois j''ai fait 2 pâtes et j''ai eu comme résultat un beau gâteau de macaron délicieux ! Merci pour la recette bien expliquée ! La prochaine fois je mettrai plus de colorant !', '2012-10-15T00:28:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, 53fec697-1fc5-4394-812a-2351875387c2, 'Exquis ! Dommage, je n''avais pas d''arôme de rose, je suis sure que ça aurait été encore meilleur... Par contre, difficile à couper il faut s''armer de patience.', '2012-08-14T18:18:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, b904690c-7e6d-4f2c-bbdf-8c118a11f094, 'Magnifique, merveilleux, long mais ça vaut la peine. Il était comme l''exemple. Merci.', '2011-04-04T20:50:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, 0ee9869d-1439-408e-a2b8-e18e5ec87d65, 'Très bon !!! Et très beau mais tout de même peut-être pas pour les débutantes... Il faut vraiment bien suivre les explications. J''ai fait plusieurs petits macarons au lieu d''un seul grand. Avec le reste de Litchis et de framboises j''ai fait une petite soupe à laquelle j''ai ajouté quelques gouttes d''arôme rose et une cuillère de chantilly juste posée (celle que j''avais préparé pour les macarons). Je l''ai servie dans de petites tasses à café dans la même assiette. Mes convives ont adoré !!!', '2010-12-26T21:16:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, a675f8d0-332d-4d56-a53d-666c4c7c1382, 'Mhhh délicieux... bien que mes macarons étaient un peu fendus... La prochaine fois, j''ajouterai plus d''arôme de rose et plus de colorant... J''ai juste mis une cuillère à soupe de sucre dans la chantilly pour éviter que le tout ne soit trop sucré... Merci pour cette recette.', '2010-08-31T10:12:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, 19f9151b-346f-4ec1-812d-49bb17971a94, 'Recette parfaite. A première vue, on peut être effrayé par la taille du texte, mais ces explications sont très utiles et le résultat est épatant. Un dessert non seulement délicieux mais également magnifique, réalisable même si l''on n''est pas expert en cuisine, ni équipé comme un chef.', '2010-05-18T00:10:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, e84d71bb-99b9-4c1c-b0c9-c611ff4ea991, 'Presque comme l''Ispahan dont je suis fan... Pas compliqué, à décliner (moi j''ai essayé pistache/fraise)...', '2010-05-09T11:22:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, 66602628-7b8a-4d9d-abfd-d7db1ae4ced7, 'Malgré ce qu''on pourrait croire, facile à faire, l''astuce du carrelage m''a permis de gagner beaucoup de temps, c''était très bon, la prochaine fois je mettrais plus de colorant, au four, le rose a viré au marron clair (je ne les ai pourtant pas fait brulé !) merci pour la recette, je la note dans mon carnet, mes enfants ont adorés!', '2010-03-23T11:19:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, 889f689b-6cf4-488f-babe-b010010420c8, 'J''ai testé et même plusieurs fois. Un vrai délice ... comme quoi pas besoin d''une cuisine de chef pour réussir un excellent dessert plein d''originalité et faire une super impression. Recette à recommander. ', '2009-10-18T20:27:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, 2bb9bfbf-2422-4118-917a-d1be2fcfa470, 'Après plusieurs tentatives toutes ratées, avec votre recette j''ai obtenu des macarons réussis et du premier coup!! Recette et explications parfaites!! Merci merci merci, enfin !!', '2009-05-02T23:11:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, d0869932-3933-4373-98d2-31cb48183131, 'J''ai entendu dire qu''il était difficile de réussir ses premiers macarons, je confirme...mais très bon goût cependant.', '2009-04-27T11:10:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, 72967377-f58a-424b-950c-7e12cdff0c21, 'Cette recette est excellente!! Je l''ai faite également à la pistache et avec des framboises. C''est très réussi!', '2009-02-12T18:53:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, 0c04a618-1005-4454-826d-27d4524cf71c, 'Un vrai délice! un peu fastidieux la première fois mais ça en vaut la peine! pas d''arôme de rose donc j''ai juste ajouté du coulis de framboise dans la crème fouettée. Merci pour cette recette. ', '2009-02-08T20:42:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, 83003708-0bb5-457d-a03b-0e97cc55de9b, 'Une très bonne recette que je recommande particulièrement, surtout pour les fêtes ou un anniversaire !   Tous mes invités se sont régalés et ont été surpris par un dessert aussi original.   Merci pour le contenu si détaillé, ça m''a vraiment permis de réussir une si bonne recette. Je n''avais pas d''arôme de rose, ni de colorant. Mais j''ai remplacé par l''extrait de vanille qui était très bien aussi.   Je mettrais bien en ligne la photo de mon macaron rectangulaire !', '2008-12-28T19:41:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65922, 67341b54-9c7d-412d-9130-73f1ca4a8e53, 'Excellent, c''est la première fois que je faisais un macaron, je ne pensais pas le réussir mais les explications étaient tellement bien faites que j''ai été très contente du résultat.Un petit bémol quand même, il est très difficile à découper.  ', '2008-12-28T12:52:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, c68d9a5b-0c4c-480b-a951-1203174a21bd, 'Association incroyable ! 
Par contre j''ai mis moins de beurre (environ 75g). Au lieu de 6 pommes j''en ai mis 4 et j''ai fait le tout en dés, comme pour un crumble classique. C''était un succès ! ', '2023-06-16T07:51:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 1c350806-ae82-4d06-b6d9-24266b440f7e, 'Excellent !  ! Je mettrai plus de speculoos la prochaine fois.', '2020-06-02T23:02:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 5282ecce-4c33-499c-8fbb-5ac83356fed1, 'La pâte est un peu trop riche en beurre. J''en mettrai que 75 g la prochaine fois! ', '2016-06-10T19:59:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, ed557e82-35f1-4b18-b53d-fe66341c9745, 'Le mélange pomme-rhubarbe-fraise-spéculoos est la plus belle chose qui puisse vous arriver dans la vie. Merci !', '2015-09-14T01:56:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 4618f485-2bec-4c31-8a82-b4398453fe1b, 'Excellent on s''est régalé ! Je n''avais pas de fraise, donc j''ai mis de la confiture.', '2014-09-01T23:32:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, ff57e57b-f754-42a4-83e7-2534934046e6, 'Juste excellent. Vraiment attendre que ce soit tiède avant de déguster. J''ai mis un peu moins de beurre pour le crumble et c''est tout aussi bien. ', '2014-06-11T01:26:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 894f480a-8245-4621-9f0f-30497e2943f9, 'Très bon! Tout le monde a adoré! Je l''ai fait dans des ramequins individuels. Par contre, c''était trop chaud en sortant du four. Il vaut mieux les cuire pendant le repas afin que cela soit tiède au moment d''être servi.', '2013-05-19T17:47:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, ed4f5613-75c8-45da-8a98-23d687152903, 'super recette. mais très sucrée. même les personnes qui n''aiment pas la rhubarbe ont adoré ', '2012-07-18T18:40:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, b54b0148-c677-4be9-a5ab-25f32b21e1bb, 'J''ai modifié la recette : j''ai fait compoter 4 pêches et 6 abricots et j''ai ajouté à la pâte une cuillère à soupe d''amandes en poudre. J''ai remplacé le beurre doux par du beurre salé aux cristaux de sel. Un vrai délice !!! Avec une boule de glace vanille c''est juste divin !', '2012-07-15T12:19:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 5e5a5b4b-5f56-49ad-98d8-d362c8eb7fe7, 'J''aime. Cette pâte à crumble !! A tomber. Je garde précieusement cette recette.', '2012-05-09T12:31:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 149dcb83-36db-40bb-84c1-76448af622dd, 'Délicieux, c''est mon dessert de l''été que je fais et refais avec la rhubarbe du jardin ! Par contre, je ne mets pas forcément de pommes (en tout cas 1 ou 2 suffisent) et je présente le crumble de façon traditionnelle dans des ramequins individuels. Un vrai succès !', '2011-08-25T21:01:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, bff8aabc-029c-471d-8426-622e699696a4, 'J''ai réalisé la recette sans fraises (elles avaient été mangées entre temps!). C''était très bon aussi. Une bonne manière de manger de la rhubarbe. Pour la pâte du crumble les proportions étaient un peu justes pour 6 crumbles individuels, j''ai dû refaire de la pâte avec moitié d''ingrédients pour finir les deux derniers.', '2011-04-26T00:12:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, c8efa3bc-597b-4aa9-abaa-fd83c9dd3c9c, 'Je vis aux US, alors j''ai trouvé des gâteaux secq au gingembre et à la cannelle ("ginger cookies" - commun aux US). Cuisson à 460F. Très bon, "give an edge to your typical crumble".', '2010-09-07T05:30:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 893651a7-8bd1-43a6-bfa4-64cf7e1c84c9, 'J''ai utilisé un grand plat et mis 2 pommes et 500 g de fraises et 4 tiges de rhubarbe => trop trop bon !!', '2010-07-08T00:52:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 12919e1b-a10e-4fc9-9831-0551a463905a, 'Mon mari a beaucoup aimé et moi aussi. La pâte crumble aux spéculos, excellent !', '2010-07-06T17:10:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 20e408b3-5463-469e-b358-8f7f41f4b874, 'Un délice ! ', '2009-11-16T13:38:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 7b472459-c394-48ec-851e-8416512e9077, 'Excellent également avec des galettes bretonnes à la place des spéculoos !', '2009-08-19T00:15:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 28440679-adf9-489c-a92c-0b9b7bc982b4, 'Tout simplement excellent !  Je l''ai mis dans un plat, j''ai donc augmenté la garniture. ', '2009-05-21T21:02:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 8e339160-f031-4800-bfa5-ca1fa25ac9b6, 'Pas de rhubarbe fraîche en magasin, je me suis rabattue sur une compote Grand-mère. Et pas le temps de présenter dans les pommes donc tout coupé. Le résultat est quand même bien fameux. Merci!', '2008-06-17T17:50:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 543d1f19-c9df-429c-b915-c5fa007ce7b1, 'Excellent mélange de saveur... Mais ma rhubarbe était en compote, du coup niveau présentation bof! J''ai sûrement eu un problème technique.', '2008-06-01T19:57:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 77d273ee-5049-4810-8f99-26a6e36299fd, 'Délicieux, + léger que le crumble classique , la cannelle donne un +++++ Très fin.', '2008-05-30T14:12:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, cc98966e-0255-4913-8e08-ca1aeba59e03, 'Pour 6 petits ramequins, j''ai utilisé 3 pommes, 150 g de fraises et je n''ai pas trouvé de rhubarbe donc j''ai fais sans. Pour la pâte, j''ai effectivement fais avec 50 g de beurre et 20 g de sucre.J''ai aussi fais revenir les pommes 15 minutes dans un mélange mi-sucre normal mi-sucre vanillée. Ce fût un régal !! J''ai laissé cuire 30 minutes. ', '2008-03-02T18:31:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, e6d7a09b-315b-4ac1-921a-8e8088dcbd47, 'Très bon. J''ai écrasé grossièrement les spéculoos et c''était très bien.', '2007-09-12T14:39:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 6f37dcd2-efd1-448c-8ebe-fcc9b98cf504, 'Excellent, tout le monde s''est régalé.', '2007-09-03T11:22:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 018a37c6-c2ec-482e-a15d-aa65eaf451f4, 'Pour la pâte: 50g de beurre et 20g de sucre suffisent sinon rajouter de la farine et des spéculoos. j''ai essayée avec une compote pomme nectarine et vanille: délicieux.', '2007-08-26T19:57:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, f99dd793-554d-49d7-a3ea-8151254490e6, 'J''ai essayé cette recette hier et toute la famille s''est régalée !!! Merci pour cette idée.', '2007-05-02T16:59:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 00b6bbc2-d46c-49a0-856e-04ec962c2e57, 'Encore un 5/5! Original , facile, et savoureux!', '2006-06-04T12:41:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, e73d1a0a-30c4-48be-9e3f-5c3d6346df2a, 'Un dessert vraiment idéal. Très facile à faire, original, et absolument délicieux... J''ai remplacé la rhubarbe par des poires... Une réussite.', '2005-09-28T13:04:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, f51a8c46-6538-4105-ac4a-61ea6259c12c, 'Délicieux et la présentation impressionne!', '2005-08-28T16:54:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 7c7f274a-bd6b-41e2-bd3b-5478f157852c, 'Tout simplement extra, les spéculos donnent un goût qui change des crumbles ordinaires, tout le monde a adoré!!', '2005-05-21T17:07:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 64cb6092-579b-4751-923c-60c36fb3c79c, 'Un vrai délice. Par contre, je l''ai fait dans un plat à gratin et j''ai trouvé qu''il y avait beaucoup de fruits pour pas assez de miettes. Sinon, excellente idée les Speculoos dans le crumble!', '2005-03-24T19:46:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30908, 11814c65-b11b-4b51-a816-d467eec3ac91, 'Très bonne idée d''incorporer des speculoos dans une pâte à crumble!', '2004-11-12T14:02:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 8d1e0b4d-f14d-413b-8ad0-9052e8395643, 'Super gâteau moelleux et qui fait plaisir à chaque fois !!', '2023-10-21T19:59:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 657c0cbf-90a1-4b17-90a0-68bc5c6d7ca5, 'Excellent, pour ma part ,pour 5 personne ,j''ai mis que 3 pomme cela suffit largement , le tout cuit 40 min à 190° en chaleur tournante', '2023-07-27T15:55:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 9f97115b-191b-401c-8b43-3470186173d9, 'Pommes dessous et dans la pâte. Super gâteau de "tous les jours".', '2022-04-26T09:56:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 56526db1-16fc-48a9-b561-51ee2ff20005, 'Super recette ! Toujours un succès chez nous 
', '2022-01-10T12:44:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, f030e9bb-6a4f-4d0e-8c1c-74590ce82e22, 'Faire revenir au préalable les pommes dans un peu de beurre, puis ramener cuisson a 35° pour plus de légèreté', '2021-12-12T07:42:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, ddcadc41-9080-4872-81bf-20edd8d581e6, 'Délicieux ! J''ai fait cuire les pommes pendant 5 minutes dans un  peu de beurre, mais la prochaine fois je les mettrai directement dans le plat juste pour comparer. A service encore chaud avec une glace. Sinon, cette recette fera partie de mes favorites sans aucun doute.', '2020-11-17T11:48:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 829002c6-c213-4dc1-94e0-2fc89f3a8b3c, 'J''ai fais cuir les pommes dans du beurre avec un peu de cannelle. C''est une merveille ', '2020-06-19T23:13:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 76c03784-6bb5-469a-8170-846064acdf9a, 'Très bon et moelleux je n’ai juste pas mis le citron. Simple et léger en bouche', '2020-04-22T16:02:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 487ae143-d34a-4826-9e49-2f0518c683d6, 'Recette très simple mais j''ai suivi certains commentaires: j''ai fait cuire mes pommes dans du beurre en préalable. Puis quand elles ont commencé à devenir fondante je les ai saupoudrées de cassonade. Je les ai laissées cuire encore un peu. Un délice !!', '2019-10-06T05:22:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, bd632a5b-d617-43c4-80f9-606b31607f78, 'Excellent, simple et tout le monde aime !', '2019-01-27T06:36:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 22965bc6-f35f-464f-8c74-25c7576a1507, 'Super ! Je viens de le faire et l''ai goûté: Un délice Merci Marmiton', '2018-02-19T19:12:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 619c82e2-1ffd-48f3-906b-b2918d39b153, 'J ai rajouté une pomme et augmenté un peu les autres ingrédients, rajouté de la cannelle et des pépites de chocolat , en respectant à la lettre la recette je trouve que y a pas assez de pomme et pas assez de pâtes (je l''ai pas fait dans un moule à cake mais dans un large rectangulaire).', '2016-12-18T17:51:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 7c37fe0f-7285-440b-9da9-4744a5b5b42f, 'Fait ce matin , mis que 150 gr de sucre sinon je n ai pas modifié la recette et résultat : cuisson excellente 50 minutes pile... à refaire sans hésiter ', '2015-05-10T14:43:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 440e35d0-5e6d-4bed-8e88-94b0e140df1f, 'Super recette ; facile à faire, rapide et délicieuse!!! Pour faire le gâteau plus léger j''ai enlevé le beurre et il est resté parfait!', '2015-02-15T16:50:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 4816f640-2519-4b8a-b78f-7e6b5bbc8f83, 'Trop bon. A refaire merci maman.', '2014-09-27T15:17:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, d68727e2-dd72-468d-8a67-437bb7cd69f0, 'Très bon mais un peu trop de beurre à mon goût. Deux pommes suffisent.', '2014-04-25T15:13:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 6ea990cc-e7cd-4ab9-abd4-a8fae9a3f3e2, 'Très bon et très moelleux.', '2014-02-09T17:51:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, aec03f1a-65f8-43cb-908b-cdfee05623cd, 'Un régal tout simplement. 2 pommes ont largement suffit. Cependant pour le citron, j''ai testé le jus d''un citron entier et c''est un peu trop : la 1/2 suffirait, voir le zeste', '2014-01-19T16:38:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, ecc8b7b6-8402-489a-84b4-64da2e6ac5b5, 'Très bon même si j''ai ajouté de la maïzena pour être sûre de remplir mon moule à manquer, et pour alléger la pâte par la même occasion. Le démoulage ne fut pas aisé avec les pommes cuites en rosace au fond du plat, mais au final le résultat est plus esthétique! C''est très rapide à faire pour un repas entre amis improvisé et qu''il n''y a plus grand chose dans les placards et le frigo!', '2013-11-03T16:44:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 0686279a-875c-4cbf-b2d0-ff2a47534d33, 'Trop trop bon tous le monde s''est régalé; les proportions sont parfaites ! Hummm un vrai régal merci pour cette recette facile et rapide ! je l''ai faite avec ma fille de 3 ans qui adore faire des gâteaux mais elle n''aime pas en manger. Et là, elle en a un peu pris, c''est dire ! ', '2013-09-29T22:48:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, bb3f3643-fdc8-4650-9777-1166e4a3053c, 'Je n''ai mis que 80 g de beurre et de sucre (nettement suffisant) j''ai ajouté les quelques cerises sèches qui me restaient (mais des raisins secs peuvent faire l''affaire) ainsi qu''un reste de noisettes (que j''ai pilées). J''ai mélangé l''ensemble des ingrédients avant de verser dans le moule pour la cuisson  : excellent ! Temps de cuisson parfait', '2013-05-17T20:58:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 74099faa-6c2e-4ef7-b139-563574cbdcde, 'Gâteau super bon, simple et rapide à faire. Il est à conserver dans son carnet de recette, à refaire !', '2013-03-08T19:25:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 32872b1c-9264-4820-91e8-7e0df350165c, 'Très bon avec moins de beurre et en faisant caraméliser les pommes et en les incorporant à la pâte. N''aimant pas l''alcool dans les gâteaux, j''ai mis un peu de fleur d''oranger.', '2013-02-19T09:04:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 471b9331-5c04-41e9-ab8a-30f5f2df27cb, 'C''est trop bon', '2013-01-25T22:40:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, b915c5f6-282a-4865-be36-7d85ebf512b3, 'Vraiment bon, avec de la cannelle et moins de beurre ! ', '2013-01-19T18:52:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 54ab9ee7-8ab2-4f52-b2b0-4b471e5cb467, 'Chez moi nous l''avons adoré, on m''en réclame encore un pour aujourd''hui. J''ai suivi les commentaires, en diminuant grandement le beurre (ma mère et moi ne digérons pas le "trop gras") et en augmentant le reste de quelques grammes.', '2013-01-16T14:12:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, d0aba482-ca81-4894-afe4-382a58f74cba, 'Bof, à plus refaire ! Très pâteux.', '2012-12-12T18:50:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 67858397-1f71-437f-bb3e-cb2209a214ea, 'J''ai testé, c''est super bon et surtout facile. Même pour les débutants.', '2012-11-29T02:48:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 7857ebf2-0b30-463c-9e09-93991c6cce04, 'Au début j''étais très méfiante car premièrement pour moi un gâteau ça ne peut pas être avec des fruits et secondement l''image ne donnait pas très envie... mais maintenant que j''ai testé cette recette je la fait tout le temps, elle est excellente, vraiment surtout en hiver j''adore et toute ma famille également même les plus difficiles ! Je vous la conseille vivement !', '2012-11-24T17:45:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, fcd82ca2-1b56-4e33-b237-ae0045382d6c, 'Délicieux ! J''ai respecté les proportions à la lettre et le résultat ne nous a pas déçu. Merci pour cette recette simplissime.', '2012-11-17T19:46:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 654262bf-c3c6-4ba5-b5ae-197429c43b32, 'Wahoouu Excellent !', '2012-10-22T14:49:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 0e626779-53f5-44a8-994f-b499a1a98309, 'En fait, le gâteau est bon, mais la cuisson a été complètement ratée chez moi. Le gâteau était trop cuit au-dessus et pas assez au fond. Je referai cette recette en baissant le thermostat et peut-être en ajoutant une feuille d''aluminium sur le dessus.', '2012-10-18T00:23:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, d5d17ffd-e877-4da1-bd31-1e37dfe6be36, 'Très bonne recette ! J''ai ajouté de la cannelle et de l''alcool de litchi ! A refaire encore et encore.', '2012-10-07T21:10:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, ba4d9bfb-580b-47f8-b4ca-380a401c1338, 'Très facile, rapide et vraiment bon. J''ajoute à la pâte un mélange de quatre épices. Un franc succès. Merci pour cette super recette.', '2012-10-07T13:00:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, b6d0e485-dbf2-459f-b713-97962ae786a3, 'C''est l''un des desserts qui est le meilleurs que je n''ai jamais mangé, tout le monde a adoré !!!!!!!!!', '2012-09-30T17:07:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 01d8dc15-cc27-4226-a5ff-e10d9a71cb2c, 'Grosse déception ! ', '2012-07-23T14:43:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 039b8de4-3cb7-4242-8246-671db8145e82, 'J''ai fait ce gâteau en suivant les commentaires, j''ai diminué le beurre et multiplié par 1.5 pour mettre dans un moule à manqué. Il est effectivement moelleux mais il n''a rien d''exceptionnel par rapport aux commentaires élogieux. J''ai mis le zeste d''un citron et on sentait plus le citron que la pomme. Mais ça reste un bon gâteau !', '2012-06-25T21:51:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, afa71296-910f-476b-ba7d-b67c43b88698, 'Merci pour cette délicieuse recette !', '2012-05-09T01:12:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, cb64101d-f873-4d67-874e-d7c2d3583d7b, 'Gâteau excellent, je le fais pour la 5ème fois et à chaque fois les invités le trouvent très bon ! Pour ma part je met seulement 70g de beurre et un peu plus de levure. Idéal pour un gâteau fait sur le pouce !', '2012-05-08T15:02:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, f514a9df-ab7a-4bba-a60d-a2b0364e4589, 'Excellent !', '2012-05-05T12:10:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 4e1ababe-5df6-45aa-a4cc-8cbe526b5bd7, 'Comment un gâteau aussi simple et facile peut être aussi délicieux et bon ? Vraiment bravo une vraie réussite merci pour cette recette !', '2012-05-04T23:27:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 0f12deb3-1b9f-4f10-91f5-108fcc634d8a, 'Très bonne recette. Pour ma part, j''ai ajouté 1/4 de lait car je trouvais la préparation trop collante. Mon homme en a repris 3 fois.', '2012-04-30T22:09:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 34502ca4-c529-4509-8717-ff457e45baf6, 'Tout simplement parfait.', '2012-04-23T23:37:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 64e16670-579a-4a7b-967e-81b5ed77c3cb, 'Excellent fondant très fondant, délicieux. J''ai ajouté de la cannelle et vanille en poudre, un régal !', '2012-04-19T21:21:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, fe753529-25d0-4204-a34a-754d512417a1, 'Excellent fondant, rapide à exécuter !', '2012-04-14T14:45:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, e3e882c2-c3cc-4fec-9fd3-7da1b38ec157, 'Tout simplement parfait ! Simple, rapide et apprécié de tous.', '2012-03-15T08:56:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, fedaa2f0-e2ab-43bf-bf28-07773f147da9, 'Excellente recette. Un vrai régal ! Nous avons mis 80 g de beurre, et respecté toutes les autres proportions, le tout dans un moule à manqué. C''était parfait. Un seul inconvénient : ça se mange trop vite... A refaire très prochainement.', '2012-02-07T10:07:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, ca988b1d-0bba-4fd5-b537-65eb90835c23, 'Fameux... Il me restait quelques petites pommes dans mon compotier et j''ai voulu faire un dessert simple et rapide !!! J''ai ajouté juste un peu de cannelle il est délicieux ! Idéal pour un goûter ', '2012-01-15T20:57:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, a704ab45-7548-4d12-8012-ef61dff97c77, 'Très bon gâteau, mais 80 g de beurre devraient en effet suffire. N''oubliez surtout pas le jus et le zeste de citron, c''est vraiment un plus ! J''ai aussi mélangé les cubes de pommes dans la pâte. En multipliant les quantités par 1,5, j''ai rempli un moule de cake de 24 cm.', '2011-11-27T17:37:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 81bca80b-3107-42c5-9873-b3ac6ba1c57d, 'Très bon....mais un peu gras, prochaine fois, je ne mettrai que 50 g de beurre', '2011-11-26T20:03:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 21b93b12-4c06-4636-96f8-ca1cefa550e0, 'Excellent! !! Les enfants qui n''aiment pas forcément les gâteaux ont adoré le préparer et....le manger !!!', '2011-11-26T18:45:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 8f91a7c9-d702-44f0-b983-470f9ebd01c1, 'Gâteau très facile à faire, le résultat est très bon et apprécié de tous. Merci pour votre recette.', '2011-11-05T13:02:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, d8a2a350-ad58-45f1-ae5f-e30a2e9c0c58, 'Très bon gâteau mais la prochaine fois je mettrai peut être moins de beurre.', '2011-10-31T15:56:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 241bc449-4fea-4973-9694-1c07703cd148, 'Excellent ! j''ai mis 2 c/s de grand Marnier dans la pâte, servi avec crème anglaise !', '2011-10-25T10:45:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 2c5878df-27e2-4993-8512-e511d11b2f95, 'Franchement cette recette est superbe, un seul truc, je mettrais moins de beurre. Gâteau moelleux, bien gonflé, sucré... Je me suis permis de mettre un peu de sucre vanillé dans le plat avant les pommes ça a caramélisé, un petit plus de gourmand. Mari et enfants étaient super contents !', '2011-10-17T18:15:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 8cb5f95f-88f8-4448-9b82-61e18adb1d5e, 'Super bon !!! On a tous adoré !!! A refaire !!!!!!', '2011-10-09T21:36:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 9cc1d6fc-59bf-4485-b4ec-cbf7ca6d1d99, 'Très rapide et facile à préparer, le gâteau est très moelleux. La prochaine fois, j''essaie avec un peu de cannelle.', '2011-09-08T07:03:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 98efd85d-0fc0-4744-8ff2-7ddd3407e44d, 'J''ai adoré mais mon homme trouve qu''il y a trop de beurre (il n''aime pas ça) et ma fille ne l''a pas fini : trop acide parce que j''ai opté pour le jus de citron. Donc ça dépend des goûts mais moi je me répète : j''ai adoré !', '2011-07-14T22:33:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, 4351815c-7002-4d04-b0ed-ce86349ba9d0, 'Excellent ! J''alterne des couches de pommes avec la pâte.', '2011-06-23T20:02:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22846, fd91d5bd-1e7a-47f8-8255-5fcf4ec48ef3, 'Déçue de cette recette. Bon mais rien d''exceptionnel !! Gâteau plat, prévoir de doubler les quantités.', '2011-06-05T19:21:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 94d2bd7a-5648-41cf-98ad-ee49805e8cd8, 'Très bonne sauce et viande moelleuse', '2020-12-30T19:26:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 2c152c77-cbcd-4e72-ba81-2841550bc1e7, 'Excellente recette. J''ai poché le chapon de pintade avant de l''enfourner. J''ai pelé les pommes et les ai coupées en deux. Cuites dans une poêle avec le calvados et le sucre pendant 20 minutes. J''ai remis les pommes et leurs jus dans le plat et réchauffé au four le chapon de pintade avant le service. Je l''ai testée deux fois pour Noël, toujours une réussite, les convives ont adoré ! Merci.', '2017-01-06T21:11:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, ebd3571b-de03-4fd9-8b47-5bb5c1197b60, 'Fait pour ce Noël, les invités ont adoré et nous aussi ! Nous avons cuit les pommes dans l''huile du chapon et du jus de pomme, c''était excellent, très fondante. Merci.', '2016-12-28T12:06:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 30b0ba93-b758-45c0-af60-928d534f8f38, 'Excellent, avec une bonne pintade fermière moelleuse à souhaits. Un régal comme plat pour un Noel réussi ', '2016-01-15T23:46:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 2ba9566e-859d-40b9-8c10-2046ac7e4a40, 'Fait à la lettre à Noël, c''était délicieux.  Du coup,  je réessaye avec un simple poulet.', '2016-01-03T14:11:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, cc82b78f-0e25-41c8-8493-b01dd7be259c, 'Très bonne recette, simple à réaliser. J''ai seulement mis moins de calvados (la moitié) ; les pommes étaient suffisamment parfumées. Mes invités ont apprécié. ', '2015-12-30T14:49:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, e8aba37a-33be-4c02-bc70-3fc00cee0e08, 'Très bonne recette. Le mélange pommes marrons est un régal. A refaire sans hésiter.', '2014-02-09T11:45:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, a801f84d-b0c4-4f8b-870f-6db5ac0decbd, 'Parfait.', '2022-12-22T13:52:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 16d18a20-d992-4e81-8e1e-1bd3eb139d82, 'A servir avec un vin jaune du Jura : c’est parfaitement coordonné !', '2021-01-24T18:41:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 273a4dcd-565f-45e8-bcf1-6d38e478efa2, 'Suivi recette, pas de calvados car enfant. 
Farce normale +gesier, foie de la pintade + échalotes hachees.
Mis 30'' avant la fin pommes et chataignes.
Delicieuse. Merci pour ce partage', '2020-12-25T13:38:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 3159a84a-9042-4c7c-aedf-0c7a598650e2, 'Je fais cette recette pour le réveillon de Noel 2020, fan de marmiton merci.', '2020-12-21T01:06:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 63562ac1-be97-430d-b495-61729433d377, 'l''accompagnement châtaignes pommes est très bien avec la pintade chaponnée, je les ai ajouté dans le plat de cuisson 1/2h avant la fin de cuisson - pour la cuisson 2h à 180° - J''avais fait une farce avec gésiers et foies de volailles + porc 1 oignon du persil 1 oeuf et du calvados - recette faite pour ce réveillon du 1er janvier ce fut un régal que des compliments de mes invités - à refaire sans hésitation.', '2020-01-04T17:29:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 31888fde-da7b-4da2-b92a-963fa74b665d, 'Recette quasi suivie à la lettre, j''ai juste mis les châtaignes directement dans mon plat au four une dizaine de minutes avant de servir. Un régal, merci pour cette recette.', '2018-12-25T02:49:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 71319603-ec6c-4491-8a6e-fd9d7d23413b, 'Très bonne recette. Facile à réaliser. Afin de gagner du temps, j''ai ajouté les pommes au four dans un plat séparé avec un peu d''eau avant la fin de cuisson de la pintade. Ce plat a eu beaucoup de succès pour Noël. Les pommes en particulier qui contrastaient bien avec les châtaignes plus sèches.', '2016-01-10T19:45:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 9de4fe6c-e8a1-4e73-add4-523af56bb4b3, 'Super recette. Mes invités se sont régalés. Bonne idée que de profiter du surplus de gras pour réchauffer les châtaignes. Je n''avais pas de Calvados donc j''ai déglacé au Cognac. La caramélisation des pommes est longue et j''ai ajouté une cuillère à café de sucre roux pour accélérer e processus. La pintade n''est pas sèche et on sauce les assiettes. Merci de cette recette !', '2016-01-06T23:35:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, b1d3d26f-9860-48f1-b514-d710e5de9d30, 'Délicieux ! La tablée a adoré. J''ai juste remplacé les châtaignes par des topinambours : 5 min à la poêle dans un peu de beurre, puis je les ai ajoutés à la cuisson de la pintade pendant 30 minutes et les ai laissés avec la cuisson des pommes 20 min environ.', '2015-12-26T15:00:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, f910d5b8-b3a6-4e23-8d96-28875c34ae54, 'Excellent !!! La seule différence que j''ai introduite par rapport à la recette, c''est que j''ai utilisé des châtaignes ramassées cet automne dans la forêt pour faire une purée après les avoir fait revenir dans un peu de beurre. J''ai aussi rajouté une larme de calvados, de la sauce de cuisson,...', '2015-05-16T17:36:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, da721ef7-b8ec-4863-b164-b66ed754d629, 'Délicieux - j''ai farci la pintade avec une farce à la chair à saucisse classique (chair à saucisse + pain de mie + crème fraîche + cognac), pour le reste j''ai suivi la recette.', '2015-03-03T15:39:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 3846a550-ae86-4931-adac-b0f895a55af3, 'Excellent. Surtout bien arroser régulièrement pour que la volaille ne sèche pas (toutes les 7-10 min) et pour éviter que les marrons soient secs, les faire tremper 10-15 min avec le jus de cuisson avant de les faire chauffer. J''ai aussi ajouté des abricots secs avec les oignons. ', '2013-03-31T23:07:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, ca4d10c2-0c42-482a-8572-753a63dee38b, 'Volaille très parfumée et tendre à souhait.', '2013-03-11T13:19:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, bd7e2486-8ec9-48ab-959a-9bff1d4286a7, 'Recette très gourmande ! Que j''ai réalisée en cocotte, car j''ai eu peur que ce soit trop sec, avec du vin blanc ! En fin de cuisson, j''ai ajouté les marrons dans le jus des pintades, découpées entre-temps, et remise au chaud avec le tout... Les pommes fruit à part sautées au beurre. Je n''ai eu que des compliments, merci !', '2012-12-27T21:32:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 749419eb-e01e-4e33-a18e-4bfdbd739bf0, 'J''ai réalisé cette recette en cocotte et c''était excellent.', '2012-12-26T04:05:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 4587960b-1e6e-4748-8109-11ddb4ab24ed, 'J''ai suivi la recette : pintade très tendre et je l''ai accompagnée de choux blanc braisé : les goûts se marient bien. A refaire.', '2012-03-02T15:04:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 739da2db-0485-49c8-b363-a7e1981eed11, 'Je viens de faire cette recette, et nous nous sommes vraiment régalés. J''ai chauffé mon four à 180°C pour ne pas dessécher la pintade. Très bonne recette.', '2012-01-01T18:20:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 988035b4-4584-43d0-b979-8c45789d531b, 'Bien suivre la recette, les pommes avaient un petit goût de calvados, cuisson un peu longue mais c''est un plat que j''ai fait en deux parties le matin - arrêt - finir la cuisson une heure avant l''arrivée des invités, j''ai fait en plus une purée de patate douce. Bonne année 2012 !', '2012-01-01T17:52:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 4ceac69c-0d05-48d7-a985-63093119a0a7, 'J''ai respecté la recette : la pintade était toute sèche malgré l''arrosage régulier et seule une partie de la chair était parfumée. Les pommes n''ont pas cuit du tout, j''ai du les mettre à cuire à la sauteuse en catastrophe. La prochaine fois je ferai cette recette en cocotte et les pommes en sauteuse ce sera bien plus moelleux.', '2011-12-28T12:16:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 038ce5c6-b640-475d-9e91-86fdc46913c3, 'Parfait il faut 1 pomme par personne et 1/2 pot de marrons. Rien à dire', '2011-12-25T14:16:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, e9c2e515-8b1a-4dc7-8bfd-82f9944914e9, 'J''ai fait la pintade dans une marmite, craignant qu''elle ne soit trop sèche au four. Je l''ai découpée avant de la cuire et j''ai retiré la peau ce qui rend la volaille moins grasse.  Cuisson avec du chou blanc émincé puis ajout des pommes en quartiers puis les marrons. Les 3 légumes fruits vont très bien avec la pintade, le tout était excellent. ', '2011-11-06T18:48:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 690e33cc-362c-4097-bc3b-34927c094017, 'Nous nous sommes régalés à Noël ! A la place du sucre roux, j''ai mis de la cassonade. J''ai mis une conserve de châtaignes que j''ai fait réchauffer dans la sauce au calvados. Les pommes étaient délicieuses, et la pintade était moelleuse. J''ai rajouté des haricots verts en fagot. Un plat très festif et simple !', '2008-12-29T19:18:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 8af29b4b-13f1-4194-929d-8f4b8e7dca3d, 'La pintade et les pommes étaient bonnes, seulement les châtaignes étaient trop cuites et donc trop dures! La sauce n''était pas terrible non plus ... J''étais légèrement déçue, mes invités aussi ! ', '2008-10-11T21:00:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 3ac1fe0d-4cd7-4786-983c-452cadc62d36, 'Très bonne recette. Je n''ai rien changé!', '2008-06-09T15:22:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 6f4986f1-2107-4418-bb3a-ac202dfe398a, 'Plat festif et délicieux. J''ai déglacé au vinaigre de cidre', '2007-12-28T12:47:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, d9ed60be-26b4-4e6d-83c6-c9d2625f8636, 'Bravo! Nous nous sommes régalés! Enfin une pintade moëlleuse et vraiment festive qui a fait l''unanimité!!! Merci. Timia.', '2007-11-24T13:59:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 290210d9-42cb-46af-9c22-bc17665d21b8, 'Tès bon. La pintade n''était pas dessechée. J''ai rajouté quelques abricots secs.', '2006-02-22T01:25:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, e41c1fdf-e4ff-4d13-9e93-4de0eb0adf12, 'Nous nous sommes régalés avec cette pintade (non chaponne) venue tout droit de la ferme ! Pourtant je déteste le sucré-salé, mais là, le côté sucré est très discret. Moi aussi j''ai mis les chataîgnes directement à chauffer dans le plat, et dans la précipitation du repas de nouvel an j''ai oublié muscade et sucre roux sans que ça ne manque au plat selon moi. A refaire...', '2006-01-02T10:45:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, f73a8532-d1a4-4524-9626-55c24599bd5e, 'Recette festive délicieuse!! Voici les quelques touches personnelles que j''ai rajoutées : j''ai fait chauffer les châtaignes dans le plat de cuisson de la pintade, et j''ai farci cette dernière avec de la chair à saucisse agrémentée de persil, petits morceaux de champignons et de châtaignes...', '2005-12-17T13:59:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 19770316-a017-4988-8f1c-d57dc4c43a0c, 'C''était délicieux! La pintade n''était pas désséchée. Le petit coup de calva dans la sauce avec les pommes était très bien vu! Bien prendre des pommes un peu acides.', '2005-11-20T02:00:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34179, 890ca0f5-4ef8-4d02-8dff-61564e418269, 'C''était très bon. Rien à dire.', '2005-10-30T09:22:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 7891bd80-396b-49cb-b4d9-7972b4dac245, 'Très bon, suivant certains commentaires j''ai mis 120 g de beurre, 80 g de sucre, 150 g de farine et 100 g de maïzena, 3 pommes et le jus du citron. Je le referai souvent !', '2016-11-06T17:18:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 3dc0d545-351d-4407-94aa-521aff9807c6, 'Excellente recette. J''ai mis 4 pommes, un sachet de levure.100gr de beurre et sucre.
Le résultat est léger et moelleux ! Absolument délicieux', '2019-04-07T10:52:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, dc3b4bd8-aa38-4da8-a2dd-7a4a1478deb7, 'Très bon cake ! Sur les conseils des autres marmitonautes, j''ai mis 150 g de farine, 100 g de Maïzena, 100 g de beurre et 100 g de sucre en poudre. J''ai utilisé à la fois le zeste et le jus du citron, ainsi que 3 pommes (au lieu de 2). Enfin, j''ai cuit pendant 1 h à 180°C (chaleur tournante). Ce cake est très frais, un vrai régal !', '2016-02-08T21:34:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 78efc988-7746-4291-9b6c-010ffb464425, 'Délicieux. J''ai diminué la quantité de sucre', '2022-07-14T10:02:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, b5101c3b-cbb7-41e6-acbf-5bd2fb27c356, 'Très bon, pour ma part j’ai rajouté un œuf en plus et j’ai remplacé le zeste de citron car je n’en avais pas, par une cuillère à soupe d’eau de fleur d’oranger. ', '2022-07-10T17:57:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 3217b7d7-1e9d-4933-82e0-f2898bd49978, 'Tres bon cake surtt pour le petit déjeuner je n ai mis que 70g de sucre e un peu de cannelle ', '2020-05-09T20:07:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 0e5a6a45-dc12-4f73-9990-0c7a07d3d817, 'Sur ma photo le cake n''est pas encore cuit mais la recette de base de la pâte est délicieuse ? ! Personnellement j''ai diminué la quantité de sucre (complet de préférence) et rajouté un peu de miel ? ainsi que de la purée d''amandes, le jus et le zeste du citron ? Hâte de le déguster', '2019-03-12T22:05:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 1205133a-aded-45cc-81e1-874eb4622b17, 'Trop pâteux et pas assez cuit. Après avoir passé en revue les autres commentaires je vais réduire la proportion de beurre et de sucre et le cuire 1 heure  !', '2018-09-07T07:10:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, a9adab7c-e7d5-476f-8d26-417de55aeaa7, 'Tout simplement excellent et si moelleux !', '2017-03-19T13:23:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, f727a53f-cfb0-4f50-9d21-cbcaeb68909b, 'Excellent rien à changer merci pour cette recette ', '2015-10-05T19:58:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, f2d675c1-0995-48f2-a15e-0281325d83c6, 'Je pense que je l''ai réussi parce que tout le monde aimé', '2023-08-30T20:37:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, c1b2cdb3-c756-478d-abb2-38450e7b6fb5, 'Je n’avais pas de citron mais j’ai mis quelques gouttes d’extrait. Il est resté parfait pendant plusieurs jours ! ', '2023-03-20T08:07:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 9a85c800-68e7-431d-bbe7-0515612c02f8, 'Un délice ce gâteau !!!!', '2022-11-24T01:22:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 5877c3ac-0094-403c-949c-be95f14b460f, 'Gâteau facile à réaliser, la préparation est rapide avec peu d’ingrédients. Première réalisation de ce gâteau pour ma part, je n’avais pas assez de beurre, je n’ai mis que la moitié de 180 g, donc 90 g. Le résultat est parfait, fondant à l’intérieur et croquants à l''extérieur, validé par toute la petite famille, un régal pour les goûter et pour un petit déjeuné.', '2022-03-23T18:54:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, d9f8ceac-a19a-46da-b311-09dd080f247d, 'Ça doit être appétissant ', '2022-02-16T01:21:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 2d49979d-b4e6-428d-a174-6bed26454b87, 'Tres bon .j adorre', '2022-01-12T12:07:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, b896b93d-8938-467f-8410-1da763bf1383, 'Assurément j''ai raté quelque chose.... J''ai écouté les commentaires et mis 80g de sucre et 120g de beurre, le cake n''était pas assez sucré et la pâte était trop dense. Résultat un cake bourratif. A refaire mais avec les quantités proposées à l''origine', '2021-11-19T09:14:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 0ace2022-7e46-413f-aeb9-c14753c35e2b, 'Très bon, fait avec moitié farine complète/moitié farine fermentante, 120g de beurre, 80g de sucre roux et 3 pommes.', '2021-11-04T16:46:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 8b1d9368-8c9c-419b-b580-a99b94952355, 'Super bon, et bien moelleux ! Le mien est même resté fondant à l''intérieur, bien que craquelé sur l''extérieur... (mon four n''est pas très puissant, c''est pour cela) J''adore et c''est modulable avec tous les fruits de saison.', '2020-06-02T00:17:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 0f514a4a-87bb-443f-a898-c40cd8a4c003, 'Ce cake n''a pas eu vraiment de succès auprès des enfants. Le mélange pomme citron n''est pas vraiment une réussite.', '2020-05-25T20:54:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 102257a8-f4a5-4b03-814a-6ced4f91ce35, 'Excellent cake avec les modifications apportees par les internautes : 100g de beurre, 100g farine + 100g maizena et les blancs battus en neige.
A faire et à refaire !', '2020-05-05T22:54:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 256d9c49-41bc-4d99-b0ac-516d8cca9492, 'Très bonne recette j''ai suivi certains commentaires je n''ai mis que 120 g le beurre et 80 grammes de sucre, pour moi c''est suffisant. J''ai mis un peu plus de pommes j''en avais cinq petites que j''ai fait macérer dans le jus de citron et du rhum', '2020-05-04T15:06:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 446c18ef-427d-4e1b-b8ca-b67616adf744, 'J''adore. Je rajoute une pomme de plus. J''ai testé en mettant moins de beurre mais c''est bien moins bon donc je ne recommande pas de changer la recette. Par contre, je la fais dans un moule à manqué, je préfère.', '2020-01-13T19:40:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, a1f38c97-0b54-4912-8589-f12e4bf7caf6, 'Excellent ! ', '2019-11-30T09:43:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 1d061c30-1e20-4ba1-8bdf-d61d205f3d36, 'Très bon mais avec 200g de farine, 100g de beurre et 90g de sucre; Ai mis le jus du citron', '2019-02-24T13:33:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 3d8c7e1b-29d6-44da-b08b-b0bce9def89b, 'Très bonne idée de recette mais un peu trop sucrée pour moi !', '2019-02-03T08:05:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 69591ab8-3769-4c88-940d-fbc0dc3e02df, 'Excellent gâteau j''ai juste réduit les proportions de beurre et de sucre.', '2019-02-02T00:08:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, fc2d8177-3037-4c49-8655-d66d222b7a02, 'J''ai suivi à la lettre la recette, gâteau très bon, frais, à refaire !!!', '2018-10-20T10:45:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 0214ad87-18be-4e0b-8ac8-c0fe36abe043, 'C''est un bon cake mais effectivement il est un peu sec.', '2018-10-02T08:14:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 604fc239-ad38-46e5-b567-bac1067bebfc, 'Excellent.  Diminuer le sucre !', '2018-09-29T05:23:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 65793e5d-1673-4d88-868c-a2c1b0a25be4, 'En lisant les commentaires, j’ai également ajouté le jus du citron ! ', '2018-02-16T02:11:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 90fb5d6f-b5a5-48c4-9b75-53b04bcb3547, 'Excellente recette !  ! On peut même mettre un peu moins de sucre.', '2018-01-31T17:57:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 5a6c4e83-573b-4f51-a0b4-10d021ce2e21, 'Très bon ! Zeste et jus utilisé ! Temps de cuisson parfait.', '2017-09-30T16:42:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 1d4133da-9476-447b-9e52-0c23e9a04f90, 'Excellent. Fais pour le goûter et il n''en reste plus qu''un seul morceau! ', '2017-03-19T22:41:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, be59e67c-f588-4d7f-b194-b7cdcfce2c85, 'Très bon. Zeste et jus du citron utilisés. Bien parfumé. Rien à changer dans les proportions. A refaire sans hésitation.', '2017-02-25T00:30:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, dc876feb-6f66-4888-a6ea-1286d2456f3b, 'Excellent. J''ai mis 3 pommes, le jus et le zeste du citron. Le zeste aurait peut-être suffit, mais le cake était malgré tout très bon.', '2017-01-14T19:38:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, af41e91a-71d3-409a-a6a0-235d96732831, 'Pour un peu de décoration j''ai mis des petites lamelle de pomme dessus !', '2016-11-19T14:40:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 290d8ace-0f6a-4e93-ad45-b21c3756069e, 'Trop lourd...trop gras...trop sucré...à revoir les proportions mais le mariage pomme citron...juste excellente idée.', '2016-11-14T08:55:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, a17041ee-11fe-4226-b2eb-f422410cb529, 'J''ai mis 3 pommes que j''avais fais marinées dans le jus de citron et un peu de cognac. Cuisson 1 h chaleur tournante 180 degrès.', '2016-11-08T19:21:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 277be9bb-3051-4fde-b8de-0471813e1c57, 'Excellent j''ai juste mis moins de beurre j''ai coupé la farine avec la maïzena et je sépare toujours les blancs d oeufs que je monte en neige avant de les incorporer... résultats parfaits et un moelleux à tomber par terre !', '2016-11-02T20:45:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 33212c91-cf86-4ed7-ad17-400e6ec42036, 'Hyper bon ! Je n''avais pas de citron alors j''ai mis le jus d''une orange pressée à la place + des petits morceaux d''orange confite. Un peu de poudre de vanille et c''était vraiment delicieux et très moelleux ! Facile, rapide et inratable ! ', '2016-09-25T00:28:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 3a2bdd7e-0deb-43fa-867d-9cbd0503d4be, 'Délicieux avec des pêches. Pour le sucre, moitié de sucre blanc et moitié de panela (sucre de canne non raffiné), ce qui donne un bon goût de caramel.', '2016-07-03T12:00:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 3a2eda33-edeb-49a3-8bbb-229f63c35f8b, 'Excellent ! Très moelleux, j''ai juste diminué le beurre...', '2016-03-28T13:15:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 122bbe5b-aa3e-4a8d-88e8-7a9f291ef205, 'Facile à faire. J''ai ajouté un zeste de citron pour ceux qui aime encore plus l''acidité ! ', '2016-02-21T23:08:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, acaf38cf-76a3-494f-8cf8-c10bdc7419a0, 'Très bon !', '2015-11-23T16:59:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 21c6c12f-9331-43fb-b242-1902af838302, 'Excellent dessert, j''ai fait la recette comme indiquée, juste un peu moins de sucre, un oeuf en plus et un sachet de sucre vanillé, à refaire !!!', '2015-11-22T18:26:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 25257c34-f094-4c90-b1d5-55082d1fb006, 'Nous n''avons apprécié ce cake. J''ai mis 3 pommes marinées dans le citron mais le cake était trop sec.  ', '2015-11-15T09:46:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 1903465b-a23c-4af3-b458-48f034f5a032, 'Je suis un peu déçu car je n''ai pas écouté les commentaires pour mettre moins de beurre. On le sentait trop. J''ai mis 4 pommes que j''ai fait mariner dans le citron. La prochaine fois je mettrai moins de beurre et peut-être un peu de beurre salé. ', '2015-10-29T20:14:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, b9e8d507-4344-43d2-8bf7-1912c0598716, 'Excellent ! 100 gr de sucre seulement et 3 pommes au lieu de 2.', '2015-10-26T19:51:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 33682433-d113-4442-8afc-1594cb926924, 'Très bien, le cake aux pommes est facile.', '2015-10-24T16:15:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 72253d8e-030d-47b4-bae2-b5fcb1e0433b, 'Dessert facile à faire, très bon avec un cidre rosé, bonne dégustation à tous !', '2015-10-18T13:17:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, bf9ee0b6-5800-4db5-8325-28f58506189d, 'Excellent tout le monde m''a demandé la recette ', '2015-10-11T23:32:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 287269b2-73a5-4ecb-961e-df72a3de5b8a, 'Déçue par ce cake. Lourd malgré le lait que j''ai ajouté car la pâte était trop épaisse. En plus on sent beaucoup le beurre. ', '2015-10-11T22:20:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, b49522fe-ba22-41ff-a3e4-72123cfec457, 'Très bon. Peut-être un peu gras à cause du beurre. J''ai rajouté le jus du citron dans les pommes. Un régal...', '2015-10-11T19:11:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, c78a1276-1ffc-46d8-90c6-5225133dc471, 'Fais avec un citron vert. Il est vraiment très bon !', '2015-06-10T18:31:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 34a82584-5c34-468e-8fde-05cf1cad2d63, 'Ce cake est une vraie tuerie ! J''ai juste ajouté un peu plus de citron : le zeste entier et le jus du citron. Je crois que ça va carrément devenir ma recette de cake préférée ! ', '2015-04-05T23:57:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 3ff130be-8d9e-4531-a778-8512611a0ab6, 'J''avais suivi quelques modifications proposées mais du coup, j''ai trouvé qu''il y avait trop de citron ! On ne sentait pas assez les pommes. Et j''ai franchement dû allonger la cuisson...mais bon, mon four est pas jeune ! Mais c''est bon quand même !!', '2015-04-02T02:25:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 9fb610f5-096a-47fa-8777-d1ce77aa061c, 'Excellent', '2015-03-10T19:48:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, 4eb68cc5-d105-44f2-b3fb-2ec99132678e, 'Une très bonne recette. J''ai ajouté un demi jus de citron et 2 cuillères à soupe de lait résultat c''est délicieux', '2014-10-20T01:00:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20738, b980911b-5c3d-4725-96ea-ad8bb6672ce2, 'Nous avons suivi la recette à la lettre ... Cake réalisé avec mon fils...  C''était parfait... Petite touche personnelle car nous aimons cela : nous avons remplacé 20 gr de sucre par deux sachets de sucre vanillé ... Merci pour cette bonne recette de cake.', '2014-09-13T06:17:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, 2bd99e2f-eb32-4999-9499-183b7b1749a6, 'Pour les inconditionnels du bonbon. Je referai mais en remplaçant les tagadas par de la confiture de fraises....', '2018-06-10T11:59:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, cf68fc97-eeb7-4bcf-b0df-7150c16d7d43, 'J''ai laissé mes roulés au frigo la veille du montage puis je les ai tranchés au couteau électrique et j''ai obtenu de belles tranches fines, sans problème de "collage".. ', '2015-05-15T11:44:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, 377656cc-c83c-44fe-9336-00f5f3d0f524, 'Un succès ! Même les "anciens" ont apprécié cette "Charlotte girly" 💖', '2022-03-12T08:44:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, 51661543-6b7e-411f-948d-2f1eee656fcd, 'J''ai pris cette recette pour la génoise, juste un conseil 50 g de farine suffisent largement après moi j''ai mis de la confiture aux fruits rouges avec un appareil avec mascarpone et sucre vanillé oeuf plus léger avec des fraises fraîches.', '2016-07-22T22:10:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, 67cd186b-8df1-46e2-a9a6-3ff571852492, 'Nous avons adoré, c''est super bon, on sent bien la fraise tagada et la mousse est succulente!', '2016-01-24T13:09:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, 2d2a1a54-f2fa-474d-81ea-a8846cde9797, 'Très jolie présentation et goût acidulé sympa grâce aux fraises tagada', '2015-06-26T00:35:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, 03239116-6c24-4c63-943e-98cc16140d41, 'Facile à réaliser... Très beau....et surtout excellent !!!', '2014-11-25T13:23:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, 70e6b8ca-db1b-472b-87b1-8bc434ffa728, 'Facile à faire et pas mauvais. Ma petite famille et moi ont adoré. A faire et à refaire :-)', '2014-05-16T14:47:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, c88b834a-9305-424a-9575-428bdb292540, 'Excellent vraiment très bon roulé, un peu galére à couper mais on s''en sort avec un couteau bien propre et fin. Je vais essayer de faire une variante avec mousse fruit de la passion et à la place des tagadas des bonbons "bananes " !!', '2013-06-20T23:24:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, 29059e82-c329-4e9e-af4f-43be24425172, 'Déçue par l''absence de goût des fraises tagada. Très galère à découper car les roulés ne tiennent pas assez avec la mousse !', '2013-04-04T19:12:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, cdcd30f7-0d97-493a-8540-46a6852e2f84, 'J''ai adoré cette recette. Tout le monde a aimé, dommage qu''il n''y en avait pas plus. Je vais la refaire pour l''anniversaire de ma fille. Je suis sûre qu''elle va adorer !', '2012-08-17T14:57:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, 4f0c90c7-aa7e-45c4-a55b-8e402195e813, 'L''idée du gâteau roulé est très bonne, mais on ne sent pas assez le gout des tagadas du coup j''étais un peu déçue... Par contre les proportions ne sont pas adaptées : avec les proportions de la mousse de fraises il faut faire deux gâteaux roulés et cela fait un gâteau pour 12 (ou diviser la mousse par deux avec un seul roulé). Cela reste une recette très bonne et qui fait son effet ! ', '2011-05-25T12:36:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, ec957362-e3aa-4c36-b533-1f67cd54c094, 'Excellente recette qui a ravi petits et grands ! Je n''avais pas fait assez de biscuits et j''ai donc complété avec des biscuits roses de Reims : Que de compliments ! Merci pour cette recette.', '2011-03-26T15:09:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, c5670934-2ff4-497b-8629-bec30fbc90ed, 'Très bon, j''ai remplacé la mousse de fraise par du fromage blanc et des fraises coupées en morceaux. Par contre ne surtout pas remplacer les fraises tagada par autre chose car c''est ce qui fait toute l''originalité en plus c''est un délice.', '2010-10-01T17:36:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, 2a755b8d-34f9-4518-841f-a2bc4d5e4eb3, 'Tout à fait remarquable! Je me suis un peu battu à étaler l''appareil à "Tagada". Succés garanti au près de vos hôtes. Tous à vos cuillères !', '2007-09-18T20:03:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, 9493decc-4464-44b7-9fb5-577dc97b6093, 'Merci pour cette recette qui fut un succès ! Et merci pour cette idée ingénieuse de faire un biscuit roulé en guise de socle de présentation. ', '2007-06-19T18:07:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, ff9081de-e0bf-45ae-8ee2-6b789dc4a922, 'Je suis surprise qu''il n''y ai qu''un vote, c''est excellent. J''avais un peu peur que le sirop de fraise tagada soit écoeurant mais pas du tout. Pour une première charlotte je suis très satisfaite.', '2007-02-15T16:47:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38610, 40e36461-ebe6-4c0a-89c1-1f4a4bf2bfce, 'Bravo, super bon, frais et très léger. le goût  des fraises tagada n''est pas trop prononcé ; je crois qu''il ne faut pas les remplacer par autre chose. J''ai fait un seul gâteau roulé pour une grosse charlotte et j''ai complété la base de celle-ci avec des biscuits cuillers. Très belle présentation : avec des feuilles de menthe et quelques fraises, le tour est joué. Digne d''un grand pâtissier ! Tous les invités se sont régalés.  ', '2006-05-23T02:05:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, ec4fd1c8-2f01-4b62-8e0c-e48c0ad26f16, 'il est bon de mettre les pommes de terre râpées dans une passoire et de les presser légèrement pour évacuer leur eau !', '2021-09-22T20:25:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, f00ef67e-96f1-4108-896f-a29d99f61405, 'Mes galettes quand j’étais petite 😊
Bon il faut bien sortir le jus et mettre plus de farine et 2 oeufs et ne pas hésiter sur le sel 
Moi j’ai mit beaucoup d’ail et un gros oignon rouge et mélangé avec du persil 
Mon mari était trooooop content de cette recette 
Sinon merci beaucoup ', '2022-01-17T21:18:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 6c44f230-653a-4466-bb5b-17699704e597, 'Très bonne recette ! Ne pas hésiter à mettre 2 oeufs et un peu plus de farine ils se tiendrons beaucoup mieux à la cuisson. J''y ajoute au choix des carotte râpées (céleri ou poireau), excellent les enfants mangent des légumes et adorent ça !! Pour ma part je les prépare l''après-midi, les entrepose sur papier sulfurisé et plaque du four. Plus qu''à les réchauffer le soir, elles seront du coup moins grasse et cela permet de manger chaud et tous ensemble !', '2019-03-19T07:07:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, e16635c5-0994-41ed-a081-99ad482f5c5a, 'J''en ai fait hier. On ne saupoudre pas de persil! On mélange le persil avec la préparation! Les formes n''ont que peu d''importance. Si ça ne ressemble pas à la photo, c''est que vous n''avez pas absorbé le surplus d''humidité et ça va plus ressembler à des galettes de rusti de formes variés mais ça peut être sympa également.  Ce n''est pas trop gras si vous épongez sur un essuie-tout. De toute façon..en Alsace on aime manger des calories et on y rajoute souvent des lardons! Avec une salade verte le soir, c''est top!   L''allégé n''est qu''un phénomène de mode pour les sédentaires. Manger équilibré sans se priver et bouger permet de se défouler sur les plaisirs de la table sans se priver.    ', '2015-09-05T16:54:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 3fe02ac8-1826-4600-abd3-9dff774b616c, 'Un régal. Servies avec du fromage blanc et du saumon fumé.', '2021-12-23T19:47:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 681a7f9d-6c3e-435f-8d6e-2909e5eeffdf, 'Un régal depuis ma jeunesse moi qui ai 71 ans ', '2021-07-28T13:52:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, ccb7fc90-2427-491a-910d-a7417429f15c, 'La préparation proposée est vraiment une base. En fait, il est possible de relever le goût en y ajoutant d''autres herbes selon votre souhait: Ciboulette, persil, poureaux et même de la menthe... C''est comme cela que l''on fait en Lorraine. Sinon pourquoi pas essayer avec du curry, du piment par exemple. C''est vraiment tres ouvert et au gres grès de l''imagination de chacun.', '2017-10-14T16:48:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 021d424a-a466-4076-b672-27210ccd0b5b, 'J''ai fait cuire les galettes dans moule à gaufres. Superbe !', '2020-01-22T08:34:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 44d52b63-5139-45d7-adce-d54eea178f5f, 'Il y a de la noix de muscade dans la recette originale, ainsi qu''un oeuf pour faire tenir la préparation. Et le persil se met également dans la préparation. Très bon avec du bibelaskäse (fromage blanc ail fines herbes sel poivre et crème fraîche).', '2019-09-29T22:18:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 54d6f48f-dd1b-4767-a9fe-88d2b623ae0d, 'Recette ultra facile ! Cela permet de découvrir une nouvelle façon de cuisiner les pommes de terre !
Petit conseil : faire attention de bien prendre une poêle qui n''accroche pas !', '2020-06-10T20:45:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, a9ec806b-e9ba-4c13-8bec-ebf480e956fe, 'J adore en accompagnement, ou repas complet en ajoutant lardons et fromage à raclette ou tartiflette avec beaucoup d''oignons !  !  !', '2019-10-03T12:54:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 35c0ecd6-f995-4b5b-8c98-112b9abe9ba4, 'Délicieux ! J''ai juste rajouté de la coriandre et du paprika !', '2019-05-17T19:13:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, d3c0c803-fd14-4a20-b18d-4c3887db323b, 'Poids des légumes plutôt que le nombre !!!!!!', '2019-03-19T02:37:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 7a03157a-a1bd-426e-861f-ed6cad4a9d74, 'Je dois être nul , moi au bout d''a peine 2 minute de cuisson mes galettes étaient toutes noires :(', '2018-05-05T01:33:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 1930f42e-bb89-4303-8c45-b223d4ee0d66, 'EXCELLENT.  Je les referai sans hésiter. J''ai ajouté un peu d''ail déshydratée que j''avais sous la main.', '2018-04-17T11:27:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 346e41ba-87ee-408c-9c7c-c75aadf7b804, 'Très bonne mais un peu trop grasse je vais les refaire mais avec moins d’huile dans la poêle pour que les galettes ne baignent pas dans l’huile !', '2018-02-05T07:02:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 84489ff4-7b20-48bc-b724-c0b886bb2d8f, 'Moi j''y met des lardons fumés... C''est gourmand !', '2017-10-14T14:37:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 61c7f628-a015-4576-96fb-9e29fe2f7548, 'Un régal, mon chéri a adoré et moi aussi. J''ai juste fait des petits tas et ajouté gruyère râpé et un peu de chapelure. Super bon et beaucoup de goût contrairement à certains commentaires il suffit juste d’assaisonner la préparation et ça a du goût.', '2016-10-16T22:17:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, f1a649ac-d377-456f-b72c-198d392da902, 'Recette élaborée plusieurs fois et toujours appréciée mais attention, je mets de l''huile au fil de la cuisson et non pas autant que demandé dans la recette. Mon petit plus : hacher du persil et une gousse d''ail et le rajouter au mélange des pommes de terre. ', '2016-02-07T23:03:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 3d43f99b-0c04-49e7-8f12-cecbe91d8b8b, 'Ce sont mes premières galettes et j''ai été ravie du résultat tant esthétique que par le goût ! J''ai mis un peu de cumin et le persil dans la préparation, 2 œufs et 3 cuillères à soupe de farine car j''avais 5 très grosses pommes de terre. Le dosage été très bien comme ça ! Servie avec du saumon fumé et une sauce raifort, crème fraiche, fromage blanc et citron ! Un délice !! Ma fille à adoré !', '2010-02-07T14:46:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, c9f3f733-adb7-4b52-a3a8-16ee7c7a811c, 'Les galettes sont trop gorgées d''huile. Cela gâche malheureusement le goût. J''ai retenté la recette en les cuisant au four. C''est sensiblement plus long, mais nettement meilleur (au goût et pour la santé).', '2009-01-16T22:40:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 4b77a4c7-d3df-45c3-b8a3-da37c005a62c, 'Vraiment excellent. Il faut surtout bien les faire cuire, à feu doux environ 15 min. Une fois dans l''assiette, je lui rajoute dessus une petite sauce (fromage blanc, citron, sel, poivre et aneth) et je recouvre le tout d''une belle tranche de saumon fumé. Avec une salade c''est un régal. A essayer sans tarder...', '2008-02-11T15:12:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 18cdceac-e215-4852-a10b-553ec9c588a1, 'Très bonnes galettes de pommes de terre. N''oubliez pas, après avoir râpé les pommes de terre, d''enlever l''eau en les pressant très fort entre vos mains. Je n''ai mis qu''un seul oignon et c''était très bien. Cuisson sur feu moyen pendant 10 minutes de chaque côté. Miam!', '2005-11-12T10:52:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 5535c942-d83e-49d5-8094-13a7a4e900ca, 'Le régal des petits et des grands.', '2001-07-25T02:07:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, ebfbed44-82a0-412d-a2ca-8a34ff6e640b, 'Un régal et surtout un délicieux souvenir d''enfance!', '2001-04-23T18:05:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 20084265-60d9-47d7-964c-6e2cd3d54bd4, 'C''est si facile avec la bonne recette.', '2022-11-14T19:30:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 81dd4947-193c-4574-a7ba-f5cbbdd34de4, 'Très simple à faire, ne pas hésiter à bien assaisonner avec des épices ou bien en incluant du fromage râpé à la préparation, on peut laisser libre court à notre imagination !', '2019-09-14T11:50:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, db6675e8-498b-4032-a36b-62b289a77eb9, 'Très bon en accompagnement d''une viande. En effet, il faut rajouter des épices pour majorer le goût. J''ai également rajouté un oeuf et de la maizena pour que l''ensemble se tienne bien.', '2019-06-25T22:27:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, c79c0934-85ac-4d7f-9931-50c7be4b6429, 'Pas concluant... ', '2019-03-19T09:03:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 2a5d8bd0-8d70-4e2d-ac99-c336163bdc9f, 'Simple, rapide et bon ! ', '2018-06-12T14:34:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, b12e55df-b788-42be-8672-7d60db769adc, 'Très bonne recette, les galettes sont bonne mais j''ai ajouté un oeuf en plus. J''ai sur fait cette recette avec des carotte et c''est super bon. ', '2018-03-11T12:17:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, e3796c10-7051-4efe-802d-435cce9c9c0c, 'Mmmhhh! Bien assaisonné, avec un peu de chèvre râpé...', '2018-02-14T12:32:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, e6e92318-8754-4656-847d-58fbe59167ba, 'Très bon. Il me restait deux carottes que j’ai mélangées aux pommes de terre, excellent. Merci', '2017-10-20T22:35:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 67dccd07-3892-4087-b903-fa28597e20c6, 'Galettes excellentes, comme les faisait ma grand-mère Strasbourgeoise, j''en redemande...', '2017-09-17T12:19:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 4b9a2e33-7ccd-4179-8721-face338a7e50, 'Très bon et simple. Ce qu''il me fallait pour le repas de ce soir avec mes cuisses de poulet a la moutarde !', '2017-08-16T00:14:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, ce63291d-7708-44da-8539-e2f7eaf5d206, 'Très bon ajouter muscade persil  3 cuillères à soupe de farine oignon ail !', '2016-09-15T07:47:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 5ac29945-0f4d-4cca-a090-0e9b6253673b, 'Un peu grasse et pas tellement de goût je m''attendais à mieux.. ', '2016-03-30T04:01:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 6d63e7fb-1e33-4fd0-89f0-440c06251d9c, 'Bon mais je trouve qu''il manque quelque chose dans la préparation, c''est fade..? peut être des épices !', '2016-03-02T01:09:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 288d773c-89ca-4b63-b41f-3caa0cfc7d65, 'Je trouve cette recette peu convaincante. Outre des difficultés à la cuisson à cause de la forme des galettes, je trouve le goût de friture trop prononcé. Il m''a été nécessaire de rajouter beaucoup de sel et de créer des petites sauces à côté pour tremper les galettes. Bref, beaucoup de temps passé pour une recette que je ne renouvellerai pas.', '2016-01-02T12:02:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 6379725d-cecb-41be-986b-54d4f6568cb0, 'Une saveur inoubliable. Ne pas avoir peur de mettre de l''huile dans la poêle pour ça puisse frire', '2015-11-21T16:19:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 5aa84fa0-194e-45fa-8902-05a134dd5d7d, 'Recette très bonne, mais mon résultat ne correspondait pas à la photo !', '2015-07-16T17:23:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, ffd63864-3bc5-4474-99d9-b3043197b08c, 'Très bon et je l''ai réussi sans problème ', '2015-03-14T10:04:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 88fac704-d72c-45a3-b025-38aff3676df7, 'Très contente de cette recette à refaire ', '2015-01-04T13:35:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 49c19306-7ff4-46d5-bf56-86aea3bdfded, 'J''adore, très bon ! Fait en petites quantités vue que je mange tout seul. 2 petites pommes de terre, un demi oignon, une cuillère de farine, 1 oeuf, sel-poivre. Un régal !', '2014-11-04T16:23:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, fae050d6-df48-4805-8a71-bad40c859ce2, 'Très bon mais gras...', '2014-10-14T15:25:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 4de8cd9b-25d9-4c0f-8a72-cb9f1f9d1956, 'Très bonnes mais aussi très grasses... L''odeur de l''huile a embaumé la cuisine... ', '2014-10-07T14:49:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, d55b73ee-c92d-46cc-9425-cdfe429ef7e7, 'J''adore !', '2014-08-18T19:34:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 673f6041-6ccf-41fa-99a0-0e6a6f4e10a3, 'Excellente recette, nous nous sommes régalés.  ', '2014-05-18T21:26:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, c4d90b1e-d862-4dd6-9b34-5b1e4ee3def1, 'Bonne base de recette. Pas assez de sel. Et ne tient pas très bien à la cuisson. Dommage. ', '2014-01-20T14:47:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, dc221a01-6c2a-4832-9b18-e0ea3d03f6fd, 'bonne recette, j''ai mis 2 œufs et 3 cas de farine, du gruyère et du reste de fromage à raclette, par contre ce n''était pas assez salé, mais bon quand même !', '2013-04-10T17:24:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 63f8ab8d-2189-43d2-b507-a057aaef70f4, 'J''ai ajouté du comté râpé et de la muscade. Un régal !', '2012-08-15T00:31:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 0d496361-e78e-4299-b514-869a35dba76d, 'Bonne petite recette, mais j''ai rencontré un soucis d''eau dans mes pommes de terre râpées. J''aurais dû les compresser et bien mieux les essorer dans du papier absorbant, sinon, impeccable. On peut rajouter ce que l''on veut en épices, herbes, c''est très bon. A refaire. ', '2011-02-24T18:06:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 4a571d60-bf36-4835-9e97-125902590127, 'excellente recette. mais j''y ai apporté quelques modifications : j''ai rajouté 1 ouef, 2cs de farine et de la muscade... et j''ai rajouté surtout 4 navets rapés (des petits) et 2 échalotes.  pas grand chose mais ça change tout !!! un vrai régal  !!', '2009-06-18T22:24:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 84b577de-1cba-438d-8647-05707ffccab8, 'J''ai fait la recette telle que - j''ai une grosse galette dans une poêle avec de la graisse de canard - Avec une salade et une tranche de jambon - un excellent repas pour le dimanche soir', '2009-06-15T13:33:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 9f23a911-ee38-45f0-81fd-33831461e6dd, 'Très bon! Par contre j''ai mis 3 cuillères à soupe de farine.', '2009-05-08T22:42:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, ba85703b-9951-41e0-89cd-49b6fb630673, 'Moi j''ai mis du gruyère et une cuillère de crème fraîche et j''ai fait qu''une seule grosse galette dans ma poêle ça fait sensation avec un bon rôti a mon goût par contre pour retourner la galette faut trouver un couvercle sans rebord sinon elle sera pas bien ronde...', '2009-01-29T20:52:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 63b3ef75-b747-47f4-9307-258611b91766, 'Évidemment d''origine alsacienne, j''en ai mangé soit avec une soupe de légumes salade verte ou salade de tomates. Ça s''appelle chez nous des " râpés de pommes de terre " à mettre sur un essuie-tout pour éponger la graisse', '2009-01-29T18:39:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 14b01f81-85d1-48fc-809d-da4ad937af85, 'Excellent! Chez nous on appelle ça des crêpes de pommes de terre. Personnellement, j''ajoute le persil dans la mixture et pour que cela soit plus léger, je les pré-cuis la veille à la poêle, je les dispose sur du papier absorbant et je finis la cuisson le lendemain au four.', '2009-01-29T08:24:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 24561cf8-746f-42b7-9d86-314e0bf7f3c6, 'Excellente recette. J''ajoute aux oignons une échalote pour le parfum. Au lieu de frire dans l''huile, j''utilise de la graisse de canard, beaucoup plus digeste et, c''est paradoxal, moins grasse. Consommées en accompagnement de bouchées à la reine, mon fils et moi, nous nous sommes régalés. Encore merci.  ', '2009-01-24T13:43:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11830, 47fcd35c-50a3-42d0-aae6-2e4a1b74bf07, 'En Lorraine, elles sont mangées avec une soupe aux légumes épaisse... ', '2008-10-28T16:56:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, cdf2be5e-10c0-4db8-8661-05f1753ad328, 'Excellente recette ! J’ai remplacé les fraises par des framboises et ajouté des morceaux de spéculoos dans le fond des verres. Je n’ai eu aucune difficulté pour la mousse au chocolat blanc. Tout le monde s’est régalé et me demande régulièrement d’en refaire.', '2022-12-20T21:59:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, faab80b8-702d-4e4d-8490-0f70f781c785, 'Comme d''autres, dès que j''ai incorporé les blancs en neige, texture granuleuse et très dur. J''ai reessayé 3 fois.', '2020-11-11T20:30:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, a1651dcb-54d0-4c23-b090-49f42774c3e2, 'Comme cela est souvent signalé par d’autres personnes, ce n’est pas une recette fiable car au moment d’incorporer les blancs d’œufs, tout est devenu très granuleux. C’est extrêmement décevant car la réussite de cette recette semble très aléatoire, ce qui en fait donc une mauvaise recette. Sa notation sur Marmiton n’est pas sans m’étonner. Mieux vaut ne pas la retenir et passer à une autre recette directement.', '2021-04-05T12:23:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, 477dac47-5714-4b01-9946-67ecd0a1a533, 'Très bonne recette je recommande', '2020-04-12T13:48:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, 264dea66-a224-470f-a6c8-275343274179, 'Délicieux.', '2019-03-17T05:47:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, 854164ae-9252-4c6f-95a7-77ca895754d3, 'La mousse au chocolat est juste sublime.', '2017-09-16T22:29:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, a29b7683-db14-4b21-92ba-2846c9ac51e7, 'Excellente recette ! Faite en garniture d''un gâteau à base de génoise à étages, c''est une tuerie.', '2016-12-17T23:55:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, cec5fed1-8618-4781-b1c5-a55ed858da00, 'Très déçue. Je l''ai faite 2 fois et les 2 fois ça a tourné à la catastrophe dès l''introduction des blancs en neige. Je ne comprends pas pourquoi la texture devient granuleuse et la mousse devient dure et... autre chose que de la mousse. J''ai essayé avec du chocolat blanc dessert une fois et avec du blanc classique la fois suivante et ça n''a rien changé. Si quelqu''un a un conseil car d''après les commentaires ça a l''air d''aller pour presque tout le monde.', '2016-09-22T15:09:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, 97a9ebe4-eecf-471e-8fd9-b18538fa1a3e, 'Délicieuse recette !!!!', '2016-04-26T15:25:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, cf3498a9-d710-4f5b-9dfa-41ef5fc37b3e, 'Excellent! On sent bien le chocolat. J''ai mis du caramel au beurre salé à la place des fraises, c''est super!', '2016-01-06T13:12:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, 11d5fe4a-8bf8-48e2-9b92-e6d4803d4aa5, 'Très bonne recette et en plus pas écœurante du tout !!!', '2015-12-04T00:21:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, f285c466-0fae-4e97-a4e4-071c8191e0cf, 'Très bonne recette, merci !', '2015-08-14T19:06:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, 46f1e18d-14fc-447a-ad67-58cc1b9b278f, 'C''est la première fois que je réussis aussi bien une mousse au chocolat blanc ; recette parfaite !! Elle restera ma recette de base pour une mousse au chocolat blanc avec ou sans fraises. Il n''est pas nécessaire d''ajouter de sucre par contre.', '2015-03-29T20:07:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, 10387daf-44e4-4674-b334-f0097b3f0ad3, 'Parfait ^^', '2015-03-13T15:03:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, 15899553-945b-453b-baae-6ebd9ed9a1f9, 'La texture est parfaite! ne pas mettre de sucre en effet, ça n est pas nécessaire. ', '2015-02-13T22:01:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, a7dc9755-8ec5-40b0-8c89-beb06585fe51, 'Excellent, léger, tout le monde a énormément apprécié. La seule chose : je n''ai pas mis le sucre. ', '2014-11-09T01:29:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, c39d07d8-6ec5-45de-9ec2-8e240625e38c, 'Très bonne recette légère et gourmande, à compléter avec un biscuit dans le fond de la verrine et des framboises', '2014-11-01T11:08:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, a29d51eb-857d-4697-aa95-99523ce9a755, 'J''ai ajouté des palets bretons au fond des mes verrines, un délice !!!    ', '2014-05-23T17:37:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, b4dce25c-54eb-433b-8305-0fbdd15970b1, 'Très belle mousse mais je l''ai trouvée écoeurante. Je n''ai pas sucré les fraises. A refaire avec du chocolat noir peut être. ', '2014-05-14T19:30:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, d396d4c7-be05-44c8-a75c-15e27b37855c, 'Très bonne recette ! Mon compagnon est fan de chocolat blanc, il a adoré ! Je l''ai servi sur un lit de fraises découpées et je n''ai pas sucré les fraises car le chocolat blanc est déjà assez sucré à mon goût...', '2014-04-17T17:48:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, 3f24e8d3-cd78-4b28-8355-6c98f2eb1ba6, 'Trop bon et tellement léger', '2013-04-27T21:18:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, cac73393-7075-4d3b-9103-4e80c373dab2, 'Très déçue, ma mousse était nickel, jusqu’à ce que j''ajoute les blancs en neige ! Je la referai mais seulement avec la crème fouettée. Merci. PS : le goût n’était pas mauvais mais la texture granuleuse et elle était toute dure.', '2013-04-08T16:33:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, 2c6c36d5-27ea-4956-9cc0-31ef63c7e066, 'Mousse excellente ! Un délice.', '2013-03-11T00:00:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, 784f5cb0-d946-4e77-95fb-39a546ef193b, 'Très bonne mousse. Je l''ai présentée en mille feuille avec des rond de feuille de brick beurrées et cuite au four deux minutes et agrémentées de fraises. Très beau résultat. Merci', '2012-08-21T17:07:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, faa20296-4949-4604-9add-525222f0b150, 'En fond de verrine, des petits cubes de brownie tout chocolat, des framboises à la place des fraises et des copeaux de chocolat noir intégrés dans la mousse au chocolat blanc. Un succès !', '2012-07-30T11:41:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, 2ee23e99-da4c-4412-82ec-31946ee8987d, 'Consistance parfaite ! Je l''ai faite la veille au soir pour le diner, elle était parfaite ! Le goût est la, on retrouve bien le gout du chocolat blanc, c''est très agréable, surtout pour les gourmands ! ', '2012-04-10T12:45:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, bc3d174d-e3b4-4263-94f6-f34b275c1aa5, 'Délicieux. J''ai ajouté un feuille de gélatine pour plus de fermeté. Et j''ai mis un coulis framboise sur le fond. Miam !', '2012-03-02T19:04:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, a8c40693-cede-4185-acc1-47768a0b2630, 'Un vrai régal !!! Merci', '2012-02-29T18:30:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, 1cdba7ee-6fbe-4a92-80de-caadaa68b5fb, 'Je n''avais pas de chocolat blanc. Je l''ai donc remplacé par du noir à dessert. Et c''était parfait ! Mes invités ont trouvé très original d''ajouter les fraises et ont adoré. Merci pour la recette.', '2011-09-17T13:08:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, aa809b17-24b8-4ce6-89c6-9b55838f3104, 'La recette de la mousse est simplissime, le résultat parfait, et peut-être qu''un blanc d''oeuf en plus ajouterait un peu de légèreté. A essayer de toutes façons.', '2011-06-14T10:17:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, fc8e7356-5675-45f7-99e3-0f25bb57cec7, 'Bravo !!! Nous nous sommes régalés ! A faire et à refaire ! Rien à ajouter et rien à ôter ! A la sortie du réfrigérateur, la mousse avait une tenue parfaite ! Ce dessert peut être consommé après un repas copieux car sa texture ne plombe pas. A essayer sans faute ! J''ai utilisé le micro-ondes pour faire fondre le chocolat.', '2011-05-24T00:37:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, 7addb3b0-2fc7-4e2e-8fd6-45326fdd54ec, 'Juste délicieux !', '2011-05-07T21:19:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, bd8cbb4d-2e91-492a-9c36-36aaf04bd42d, 'J''ai ajouté une feuille de gélatine (ramollie dans de l''eau puis fondue dans le lait chaud) pour une mousse plus ferme, ainsi qu''un peu de zeste de citron vert. J''ai présenté la mousse dans des verres sur un lit de fruits rouges surgelés (dégelés au préalable). J''ai servi avec des rochers coco maison émiettés dessus et c''était délicieux : merci pour cette recette.', '2011-01-30T12:15:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, 56047f83-67f8-4dc7-9c3f-a0be0ef7d1c6, 'J''ai ajouté des palets bretons émiettés et je les ai faits la veille, un délice', '2010-09-13T08:37:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169067, c8ab6249-875c-4642-84b8-bbcaa21cf4d2, 'J''ai réalisé cette recette avec des framboises et non des fraises... La mousse est vraiment très bonne, on a vraiment le goût du chocolat blanc, un vrai délice !', '2010-09-01T15:26:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37608, 9ed3ceca-00db-42fc-9fad-c9704849c8a1, 'Vraiment très bon et facile ! Je l''ai fait avec des framboises surgelées que j''ai égoutté pendant la décongélation. A refaire très vite!', '2012-06-30T15:53:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37608, 2e939a6c-5c31-4b07-8843-1f11d82ee21a, 'Cette recette est très simple et absolument délicieuse. J''ai essayé aussi avec des framboises et de la mangue, à la place de la fraise, très bon aussi.  ', '2007-10-14T13:16:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37608, 4bf79525-cb03-41d5-8845-385e033a2f69, 'Super bon et original. Je ne sais pas pourquoi j''ai eu envie de battre les blancs en neige (à la main, pas trop ferme), mais du coup, j''ai eu de quoi faire le double de pistachiers, et je ne le regrette pas. A refaire plein de fois.', '2007-06-14T18:19:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37608, 9918a6a3-db64-49cf-894a-22560f97b58a, 'Le mariage des pistaches et des fraises est idéal. On obtient un petit gâteau frais, léger, parfumé, il est encore meilleur le lendemain je trouve. Merci marielle pour cette recette excellente.', '2007-03-12T16:01:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37608, 90e0006e-0000-4ac9-9df0-02691b39e386, 'Proportions idéales , goût sublime, il ne faut rien changer à la recette si ce n''est que l''on peut éventuellement remplacer les fraises par un autre fruit. J''ai mis des abricots moelleux car les fraises en hiver ça court pas les rues. Cuits dans des moules à muffins en silicone en forme de coeur, c''est du plus bel effet. Merci Marielle.', '2007-01-21T21:37:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37608, 66e9167c-6440-4c60-b9fa-f0d01f6d3f0d, 'Délicieux, gourmand et frais. J''adore!', '2005-11-09T21:08:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 44a06351-1a00-4794-b559-afaef8a7ad33, 'Excellent, un délice, comme à chaque fois que je suis cette recette !', '2023-12-08T00:15:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, bac6c304-d8ed-4fc3-8e60-493c5ed42e9c, 'Top. Je l’utilise à chaque fois
', '2023-11-12T13:14:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 7b0d0658-5d6b-4385-b6ab-770890be03f7, 'Super facile et trop bon !!', '2023-11-12T11:34:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 31060ec1-f181-4847-99fa-0a6eb90c4e08, 'Excellent, c’est le meilleur !
Je conseille par contre de doubler les doses de la pâte seulement sinon elle ne recouvre pas toutes les pommes.', '2022-04-17T11:14:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 0fe51d8b-6c24-4146-a808-eb03df310a3f, 'Bonne recette, lorsque je fais un crumble aux pommes je fais cuire toujours mes pommes dans du beurre avec un peu de sucre. Aussi je n''est mis que 125 gr de cassonade dans la préparation du crumble. ', '2023-05-30T15:33:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, f9f6bbe2-87b1-415a-8c1a-2bd2581fe545, 'Personnellement, on met moitié farine moitié poudre d''amande. Du beurre salé bien sûr. Toute la famille en raffole !', '2019-02-14T16:12:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 846e37fa-f17e-40d4-9745-ee3527c1f4de, 'Très facile à faire mais j''ai réduit le beurre et le sucre. Pour 150 gr de farine, 75 gr de beurre et 80 gr de sucre sont à mon goût suffisant. ', '2023-01-28T15:29:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, ae863742-3d5b-4032-ad97-1d1644a51ff6, 'Excellent dessert
Pour les nuls comme moi, super facile à faire ', '2023-01-14T15:39:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 8e17c5df-5ccf-4a3d-b41a-f0bf0a6a96c1, 'J''ai ajouté des châtaignes et j''ai remplacé la farine de blé par le sarrasin. Excellent ! Juste penser à baisser le four à 180°C au moment de la cuisson pour éviter que ça brûle.', '2022-10-16T20:36:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, f969ee73-6f2e-473c-a8d1-956a6ca9e86b, 'Facile à faire et délicieux. J''ai mis un peu moins de sucre (environ 70 g) et ça m''a semblé suffisant.', '2022-09-14T14:38:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 608bccc2-73f3-452b-abfd-a5d0cf43f955, 'Un régal. Je fais revenir les pommes dans du sucre du beurre demi-sel et du rhum et je réduis le beurre dans recette. J''ai conquis le coeur du fils de mon conjoint (et du coup mon conjoint 😄)', '2022-02-11T21:20:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, a865d963-3e0b-4ee0-9009-21167ce33620, 'Excellente recette ! J''ai fait revenir les pommes dans une poêle avec le citron et le sachets de sucre vanillé. La pâte à crumble est parfaite. Merci pour cette recette', '2021-11-29T13:43:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 3ac10113-b2ce-4fcd-b4e1-3e19650cc0aa, 'Je n''aime pas la cannelle donc je l''ai remplacé par un liqueur de yuzu.
Beurre salée obligatoire !
Un régal pour les papilles et les lèvres lippues', '2023-11-12T10:00:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 5b109149-d940-43df-b63e-9db17b5e83d4, 'Excellent ! La meilleure recette de crumble. Le citron fait tout. Personnellement, je mets souvent des pommes, poires, bananes et raisins secs. Une tuerie !', '2023-08-27T11:30:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 2e7919f6-942d-4b69-9df6-ad1be3f4d824, 'Un régal ! Mes invités ont adoré !', '2022-12-22T19:26:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 927dd457-6ef8-4fcc-a26f-995ed5bb6116, 'J’ai juste une seule chose à dire : UN RÉGAL !!!!!', '2022-12-09T22:03:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 651a042c-b746-4b26-ae21-17afbc0bd90b, 'Toute la famille adore ! Nous avons mis des pommes acidulées pour que le mélange avec la base de crumble sucrée soit équilibré.', '2022-12-04T20:15:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 9207d4a2-8900-489f-9dec-b24a0019aecd, 'L''une de mes recettes préférée. Tout parfait, je diminue juste de quasi la moitié de sucre. ', '2022-09-27T13:50:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, f008e41f-3cfc-4867-87bc-4915c080db20, 'Le mélange pomme/citron avec de la cannelle n’est pas très agréable...', '2022-09-14T14:57:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 715ef9e5-7a93-42ea-a7c6-b37da462d84a, 'Le meilleur crumble! (Je réduis juste un peu la quantité de sucre) ', '2022-04-25T12:47:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 60d5a53e-1cfa-4199-938e-ccc213b869a2, 'Magnifiquement bon ! Recette très simple et rapide j’adore, j’ai rajouté des petits bout de Toblerone pour finir un colis de chocolat pas présent sur la photo', '2022-04-04T22:43:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 4d905b00-57a3-41aa-83a1-484bcd29bbe7, 'Un succès à chaque fois ', '2022-03-20T11:51:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 93c00f93-37ea-4864-bb9b-d035a00c1a1a, 'Génial, je rajoute qq fruits rouges en plus pour le fun et avec un peu de glace vanille c''est un véritable délice', '2022-01-28T14:37:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, d7d305f4-4f1a-42f3-8a97-d7e924d03174, 'Cette recette est une tuerie. Je n’utilise plus que celle-ci pour mes Crumble. 🥰 j’ai fait également plusieurs variantes : avec des poires et avec des fruits rouges. Miam ! Deux petits plus au choix : ajouter au dessus des fruits, avant la pâte, des biscuits spéculos broyés ou du chocolat blanc coupé en morceaux. Top top top merci pour cette recette devenue un classique de ma table 🧑‍🍳', '2021-12-25T13:46:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, a0386ff0-5db1-4fd1-859b-34bdbdb8343f, 'Ma recette fétiche du crumble !
Parfaite !', '2019-11-30T06:51:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 838e05a2-acda-406b-9e27-107130e77801, 'Un délice, j''ai fait pomme banane ! Par contre le citron je l''ai mis à la fin sur la pâte et bien ça lui donne un goût acidulé aussi ! Trop bon ', '2023-11-07T22:05:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 259fc481-943a-47d7-83ac-ea355073d2a4, 'Excellent, je l''ai servi avec une boule de glace vanille bourbon tout le monde a adoré !!!', '2023-11-05T12:40:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 490beaf8-1523-4ee7-a78f-9647e2ff4ce5, 'Super!👍👍', '2023-11-04T11:24:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 38793e6c-2924-4d70-a04c-286b27312d9c, 'Très bon, j''ajoute un peu de poudre d''amandes dans la pâte, et je sers tiède avec de la crème fouettée. Pas de restes ! ', '2023-11-01T12:39:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 2fba899a-3042-48d2-9840-77a0cf90ecdb, 'Un classique réalisé depuis maintenant 5 ans minimum ', '2023-06-28T01:14:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 1818b8af-d82b-4b6f-a5f4-1bbd2075f681, 'Super recette,  j''ai allongé le temps de cuisson à 1h en tout jusqu''à ce que les pommes soient fondantes, une tuerie', '2023-06-02T06:30:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, b2b4f56f-34f3-4d44-b0b3-8535e8e5ee0c, 'Délicieux, merci. Néanmoins je réduirais bien la quantité de cassonade la prochaine fois ;) Pour ma part, j''aime bien ajouter une pâte brisée dans le fond pour que ça ressemble davantage à une tarte. Et je me demandais... mais d''où vient ce nom de recette rigolo? :P', '2023-03-26T16:58:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 3c1eb8ab-b5cf-4405-9923-e353f5572fd1, 'Très bonne recette, excellente. J’ai diminué la quantité de sucre et doublé la quantité de la pâte.', '2023-03-11T23:23:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, daccf913-e4ed-4437-8afb-dc53c5c9d3b7, 'Excellente recette. Comme conseillé dans certains commentaires, je fait d''abord cuire mes pommes (en général des royales gala) avec un peu de cannelle et un dé à coudre de rhum.', '2023-03-09T08:56:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, bf657bc7-516c-4485-9379-d0493463de1f, 'J ai fait comme conseillé dans certains commentaires et réduit la quantité de cassonade. Je n''ai pas mis de cannelle non plus car à la maison, on aime pas ça 
Le résultat est succulent, je recommencerai dans pas longtemps lol', '2023-01-29T21:47:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, d15f9f06-48da-4edf-a400-aba8c7820d99, 'Parfait sauf que je fais l’impasse sur la cannelle.', '2022-10-06T17:30:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, f4e32601-6ba5-464e-9897-cb12f2e6c55b, 'Super recette ! J’ai juste mis un peu moins de sucre et c’était très réussi ! ', '2022-08-29T14:22:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, e42029d6-1336-4f79-b32c-8fd694521da0, 'J’ai suivi la recette et j''ai mis le four à 210 pendant 30 minutes, mais ça a cramé ! Je le mettrai à 190 la prochaine fois….', '2022-07-12T21:27:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 19201c1a-c762-4941-b7f8-fab45a56aa0d, 'Top', '2022-05-28T14:08:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 66ffe9aa-c105-4146-8b6a-f2440c2d668a, 'Miam ! Facile à réaliser et jamais déçue ', '2022-04-11T20:21:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, c6473e63-660a-4fdb-a9ae-2eef50faa699, 'Tout le monde en redemande !!! J''ai suivi les conseils précédents... moins de cassonade, mélange 100 g de farine /100 g de poudre d’amandes. ', '2022-04-09T17:10:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, e7e7c850-9808-4ad7-9d2c-301a89c53422, 'Formidable. Je fais à chaque fois cette recette, et c''est une réussite à coup sûr ! Je mets juste 20 g de sucre de moins 😉', '2022-03-21T20:55:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 7681fff5-bc0d-4dde-942d-8ca7a2ba8b86, 'Super recette. Je rajoute 5 min de plus à la cuisson et j''ai mis 115gr de sucre au lieu de 150gr.', '2022-03-13T13:51:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 51e09b79-2b85-4e06-a089-21205b9d9bf7, 'J''ai mis sur 100 g de sucre pour la pâte, c''est suffisant !
Très bon 👌 et rapide à faire pour un gouter en famille un dimanche 😊', '2022-02-20T14:48:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 7e6b4e89-94ab-495e-9faf-7b00ca73d540, 'J''ai ajouté une poire et des carrés de chocolat.. Un délice ! ', '2022-02-13T17:22:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, c3c347f8-9836-4afe-8274-e9a29a9197ca, 'Délicieux! J’avais peur qu’il n’y ait pas assez de beurre mais c’était parfait ', '2022-01-29T09:58:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 2ea643a3-6a60-4171-b792-c7aaec7a04db, 'Il a fait l''unanimité. ', '2021-11-29T19:40:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, d0834683-fb4c-496f-a6fc-d5db8196f1d6, 'J''ai doublé les quantités pour la pâte à crumble et rajouté un peu d''eau de fleur d''oranger, émietté des biscuits au gingembre, et de la poudre d''amandes et c''est délicieux ! ', '2021-11-14T16:43:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 1998f48b-29c6-4a06-923b-b5721b4dd612, 'Cette recette est parfaite ! ', '2021-10-27T13:20:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, c755d852-dd54-4863-83bf-2748b4aa604d, 'Excellente recette, simple et inratable !', '2021-06-17T17:15:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 4d4446d5-f115-4a2a-b21f-d777a80c421d, 'J’ai fait la recette avec du sucre complet de canne BIO Ethiquable, c’est fantastique ???', '2021-01-24T20:55:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 10cd5cf7-745f-45fb-95aa-f4227baf6fe7, 'Je la refais encore et encore et tout le monde adore !!', '2020-09-11T18:26:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, acd299dc-0dee-4b7f-84ab-8acc410c006f, 'C''est succulent !  !  !', '2020-04-13T23:30:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 983be6cd-0c12-406c-897d-73ac106027d5, 'Super recette !', '2020-04-11T18:29:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 9afff640-b855-4f0e-a7a0-1c082412de76, 'Super recette ! Je la fait depuis des années maintenant et tout le monde m''en redemande. Étant alsacienne, je mets la surdose de cannelle. Un petit défaut de chez nous.
Merci pour cette recette. Niveau pommes, je prends toujours les reinettes grises Canada. Régalez vous bien.', '2020-04-02T18:12:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 8131f067-9ddd-4f44-acfc-9aa151b67657, 'Ma recette de crumble préférée.', '2020-03-31T07:36:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, 3fc2f0ed-ca6e-47d0-b399-c786851f8746, 'Délicieux !  !', '2020-03-29T16:21:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, ed2daa8f-13fe-48f2-abdc-56de8c7d9b59, 'Tres bonne recette !! ?', '2020-03-24T11:57:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, fc2c6d52-b8f1-401e-959c-49f4209324cd, 'Délicieux aussi avec du beurre demi sel ❤️', '2019-11-16T17:04:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (10534, b9e0fa28-f766-4150-8e3d-7e9a12376cc5, 'Super crumble ! J''adore merci pour cette recette.', '2019-10-20T11:45:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 2645de93-c6b7-4f7b-bef9-5c8dd22e7ddd, 'Très bon , mais deux petits soucis chez moi, beaucoup beaucoup beaucoup trop sucré. Tellement sucré que sa caramélise, et du coup, ça rend le crumble mou, plus que croquant, très soif à la dégustation, et le temps de cuisson est un peu trop long, ce qui accentue l’effet caramélisés, et mon crumble a légèrement noirci. Je dirais que 15/20 minutes gros maximum aurait largement suffit. Et 125 g de sucre. ', '2023-12-07T21:47:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 2c6eb0f8-b133-4691-9ee5-6f1edd9ba752, 'Très simple, il faut juste mettre moins de sucre !', '2018-09-02T03:21:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 5e9c712e-aed8-46ae-a2c0-396d3901b2c9, 'Beaucoup trop de sucre ! Couper les pommes plus petit et pas besoin de les faire revenir. 2 cuillères à soupe de sucre avec les pommes suffisent. Et 120 g de sucre mélangés au beurre et à la farine est largement suffisant.', '2018-12-07T12:54:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 9601d33d-aa7e-4ec1-9586-0ad081014d33, 'Je n''ai pas du tout sucré les pommes, j''ai juste ajouté la cannelle et j''ai utilisé des pommes elstar. Pour la partie crumble j''ai remplacé 30 g de farine par de la poudre d''amandes complètes et mis la 1/2 de sucre seulement ', '2024-01-21T13:47:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 6c16bd47-1fcd-4a68-90c1-e3b91b872c9b, 'Beaucoup trop sucré même en n''en mettant 100g à la place de 250g. 
', '2023-10-31T14:21:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 5c3d69dd-5d3b-4e2b-aa97-93543ecea9f3, 'Affreusement sucré. On a l''impression d''avaler des cuillères entières de sucre. 125g avec les pommes + 125 g dans la pâte à crumble... Y''a un gros problème de surdosage. ', '2021-02-16T09:58:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 31a3b868-9249-420e-a3ee-927fd95cb908, 'J''adore cette recette, cependant je remplace la farine traditionnelle par de la farine brune et je rajoute du sucre vanillé. Un délice !', '2019-10-27T18:44:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 60dc1c51-7c5b-45cb-b37f-ad8b6c5c0d12, 'Crumble 10/10 avec la boule de glace par mon jury des plus objectif. Merci à @flaviemrch pour son commentaire qui m’a permis d’adapter au mieux la température du four : je confirme 180 est parfait (thermostat 6 et non 8) 
Bon crumble à toutes les grands mères en ce jour de fête ✨', '2023-03-05T22:29:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, f4174a55-dd95-452a-9b51-a00b3ac868cf, 'Beaucoup trop sucré. Meilleur avec du sucre de canne pour le crumble.
', '2021-12-09T15:17:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, eb8dd354-c6a5-4930-8deb-0c74b8d702ad, 'Super recette! J''ai fait cuire les pommes dans du beurre, puis rajouter seulement 50 grammes de sucre pour les faire confits... et le jus d''un 1/2 citron sur les pommes avant d''ajouter le crumble. 50min à 170-180° à chaleur tournante pour que le crumble soit croustillant et légèrement bruni. Délicieux! ', '2020-07-19T23:52:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 69c5ddc3-d16f-41a9-bdea-6eefdaf0f370, 'Super recette, par contre je n''ai mis que 150g de sucre et c''est largement suffisant ?', '2020-04-17T17:11:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 8b39d042-fb0f-40a2-a9d8-792f512e2004, 'Super ! Trop bon, j''adore. Merci pour la recette.', '2020-03-01T06:40:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, c838788d-4c7f-49a1-acac-80a205398087, 'Parfait trop bon !!! On s''est régalé !', '2020-02-07T07:08:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 058fb532-9cad-4795-8d4b-84b5ee02f704, 'Très simple à réaliser et tout simplement délicieux. Je l''ai réalisé avec des Pommes Chantecler J''ai aussi diminué le sucre de 100 g.', '2019-12-14T19:06:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, b3742994-fe4f-4958-9b76-4c8cc9ce2c27, 'Bonne recette mais qui a besoin d être rééquilibrée. 125 g de sucre pour la pâte ça suffit largement il faut doubler les pommes ou diviser la pâte sinon trop de pâte. J''en ai jeté.', '2019-11-14T08:56:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, a9d45348-d0f6-4dca-9905-a1632fa815fc, 'La meilleure recette que j''ai trouvée. Un vrai délice.', '2018-10-31T03:00:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, aa592215-1538-4164-bf11-e4272176fe34, 'Superbe recette très bonne et assez rapide. On s''est régalé', '2018-10-28T10:15:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 35b461fb-06f1-405f-87a5-44165d84c591, 'Super recette ! C''est délicieux. Merci beaucoup !', '2018-10-06T07:59:30+02:00');
