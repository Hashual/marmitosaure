INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, 440e54fd-b943-4428-85f9-35b3923348f5, 'Super boulot !!! Ca donne trop envie', '2016-06-13T21:46:45+02:00');
