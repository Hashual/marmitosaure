INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 3ef00d0f-8553-4c90-8956-37667fbde923, 'Très bon ! J''ai eu très peur au début de la recette, l''appareil du gâteau paraît très épais mais j''ai quand même voulu essayer. Un vrai délice ! J''ai quand même supprimé 30 g de sucre dans ma crème.', '2022-10-28T16:35:39+02:00');
