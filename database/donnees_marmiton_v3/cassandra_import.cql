INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 44bdfb2a-af0f-4274-97c0-b7b397329cbc, 'Parfait crumble aux pommes accompagné d''une boule de glace à la vanille. C''était succulent je le referais volontier. Mes invités se sont régalés 😉🍰👍🏻', '2021-12-03T21:08:20+01:00');
