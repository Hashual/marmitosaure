INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, 8c09f9ae-c40c-448c-a8e3-43cffd121b5c, 'Un délice pour les papilles et le moral. merci. je referai, rien que pour le sourire de mes petits loups. ', '2015-02-14T21:23:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, 0da65c02-611e-4ed9-8c82-852018a36aa3, 'Trop bon facile à faire !!! J''ai remplacé les bananes par des pommes et je n''ai pas mis de levure.', '2015-02-14T19:34:58+01:00');
