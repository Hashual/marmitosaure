INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 9fc4ec78-3b61-4d1e-a78d-c6615454b2b6, 'Vraiment très bon, rapide d''exécution, il faut juste prévoir un plat à bords hauts. Merci pour cette excellente recette.', '2020-07-02T19:27:20+02:00');
