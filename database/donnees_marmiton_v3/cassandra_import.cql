INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37128, 5f43fb43-61f9-4c33-839d-dfee6c9712ac, 'C''était très bon,délicieux ', '2022-01-10T18:02:47+01:00');
