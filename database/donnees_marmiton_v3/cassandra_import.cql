INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 59620b16-366d-4de5-96b8-8e938a56e4b5, 'Un régal ! Tous les convives ont demandé la recette :-)', '2021-11-05T22:08:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 8bad4594-c857-4c52-a786-1dc63273db5d, 'J''adore ce gâteau ! Je ne fait plus que celui ci en gâteau aux pommes 🤤 ...c''est un délice merci pour ce partage de recette 👌🏽', '2021-08-26T14:31:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 05d731f7-1c69-473d-b04d-5d9a57ca62e9, 'ce gâteau est incroyablement bon, j’ai doublé la recette puisque nous étions nombreux, j’ai également saupoudré de cannelle sur de moule pour donner un léger goût, par contre à manger par petites parts car il est très consistant ', '2021-06-24T20:45:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 9f7463db-be4e-4de5-b098-81b020c40fd5, 'Mon gateau aux pommes. Juste parfait', '2021-05-12T17:33:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, bba128c0-16c7-47d4-87e5-18092536afe4, 'Mon gâteau est sorti à moitié liquide du four, je ne comprends encore pas pourquoi ! Pourtant il y a tellememt de commentaires positifs. . Je voudrais bien une vidéo de la recette ', '2021-03-01T13:39:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, f1f1624e-e821-40e0-ae5d-51b261e6eb5e, 'Trop de sucre - trop de beurre dans le nappage. On peut diviser par 2 les quantités.', '2021-01-18T17:49:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 25675cd9-d8b3-41ff-828d-2673ed010575, 'Excellent mais je divise par deux le beurre et le sucre pour la crème ', '2020-11-30T13:59:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, d7363be3-6e7f-40fb-a7b1-a69758794955, 'Tout simplement génial ! à refaire sans modération...', '2020-10-23T12:50:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 721d50eb-e225-43a3-9bdc-a059b029f8d5, 'Tout simplement excellent', '2020-10-22T01:06:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, aaccfffa-15dc-4994-9aae-19a2314ce22b, 'Extra bon', '2020-10-21T00:51:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 8b48c315-7942-4831-8d29-776c753a39d9, 'Excellent !', '2020-10-20T18:20:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, de56659f-e988-4e99-8491-c83d6ce08c63, 'Je rajoute quelques quartiers de figues qui s''accordent parfaitement avec la preparation
', '2020-10-09T21:28:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 799b970b-73a8-426c-aeb5-fadbd4037179, 'Excellente recette ! J''ai mis un peu moins de sucre et moins de beurre. Même mes enfants pas fans de desserts aux fruits ont adoré !', '2020-10-07T20:31:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 2f191f80-2be5-4fcd-b05b-8f06879ae8c0, 'Delicieux. Je double les doses pour la pâte.', '2020-08-06T20:52:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 2f1a4cdd-be64-4889-8392-2eaf2cd46123, 'Délicieux mais... Calorique', '2020-07-25T14:47:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 5b5ccdd5-41ed-4b7f-8e41-26f6b6439a0b, 'Je le refais tres souvent 
Une de mes meilleures recettes a present!', '2020-07-11T10:17:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 664d3c3c-69b2-42f7-96ce-283b9fe1a0b1, 'C''est la deuxième fois que je fais ce gâteau et il fait un carton, pour ma part je met un peu de vanille dans le gâteau et un peu de rhum dans la préparation du dessus, mais ça c''est uniquement pour les gourmand ? !! ', '2020-05-14T12:57:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 54ad8cae-008b-44d2-8a14-5dc6d40526c2, 'Délicieux ! Toute la famille en raffole... C''est devenu une incontournable gourmandise du weekend ??', '2020-04-01T11:29:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 360e5f50-24de-4a60-95d7-5dee870cd812, 'Tout simplement délicieux, je l''ai réalisé 3 fois ! C''est devenu mon gâteau aux pommes. J''ai retiré du sucre, dans les 2 préparations (30 g) car je trouve que les desserts sont souvent trop sucrés.', '2020-03-30T18:35:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 33f6679e-03e9-4a3e-8d37-32dc0eac3d89, 'J''ai juste ajouté un peu de rhum et comme je n''avais pas de pommes je les ai remplacées par des poires. Tiède, c''était un délice ! Excellente recette, merci de l''avoir partagée !!', '2020-01-18T07:19:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, e5222fe8-6a9f-4de6-9a75-d872995dd9d2, 'Délicieux...  Je l''ai refait avec des poires. Nous nous sommes régalés.', '2019-12-24T10:12:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 7c8053fc-78a7-4d48-9dda-f4c299073412, 'Très bon gâteau !  J''ai suivi les commentaires. ''ai diminué légèrement les quantités de beurre et sucre pour la crème. Un succès !', '2019-11-09T11:48:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 47792978-d48d-4ce6-98f0-b4b319f90ff8, 'Trop bon ! Un peu gras tout de même mais ça vaut le coup.', '2019-10-16T13:17:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, e9a152ed-cf54-46a7-b842-387d485ad878, 'Simple à faire, le plus gros de votre temps sera de peler les pommes ! Un conseil, cidre doux, faire mijoter plus longtemps qu''une heure ! Perso j''ai opté pour de la cassonade au lieu de la cannelle, et accompagné d''un filet de jus de citron ! Déglacé au cidre et miel avec une bonne crème fraîche, un régal ! ', '2009-06-07T16:13:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, f726fe2d-0507-46b2-8dda-5e2cb25c9390, 'C''est vraiment bon 😋', '2022-10-05T19:02:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, f21090cb-3f28-431d-8cc8-261797984d25, 'Testé et approuvé. J''ai mis 5 cuisses de poulet, 5 pommes, une boîte de lardons et trois oignons pour 75 cl de cidre. Mais ça a été goûté et approuvé !', '2022-10-04T18:42:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, f25bf06f-a15f-48e7-813e-d6838a6ef779, 'J’adore, les pommes sont mises à 20 minutes de la fin pour éviter de les retrouver en compote.', '2022-05-25T21:32:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 2884ca28-eeeb-4b41-a088-e5f906999bf5, 'Délicieux!.... merci pour ce partage... à faire et à refaire', '2020-12-02T14:04:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 747fedc4-d290-4f16-a465-5636c68f1aa1, 'Trop top : facile et délicieux. J''ai suivi la recette à la lettre ; nous nous sommes régalés, la semaine suivante j''ai mis des cuisses de poulet à la place des filets. Encore meilleur !! ', '2017-03-10T13:00:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 6c5448a1-564c-4b66-8945-572364894003, 'Moi qui ne suis pas très cuisine, j''ai testé cette recette mais avec des cuisses de poulet, et c''était excellent !! ', '2017-02-14T20:34:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, b8dfd3f3-5c2c-473e-9b56-a17aeb3cd17c, 'J''ai un peu triché en prenant du filet de porc plutôt que du poulet. J''ai suivi les conseils précédents et ainsi ajouté les pommes 20 minutes avant la fin et j''ai mis toute la bouteille de cidre. J''ai lié la sauce à la fécule. C''était délicieux. La sauce est onctueuse et pas trop sucré. Les pommes fondantes mais pas en compote. ', '2016-09-18T00:11:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, b1f541fa-1fb8-4224-a440-041597461601, 'Délicieux !!!!!!!!!! ', '2015-12-09T23:15:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 6c57dd22-05f0-4672-b22a-94dff247b9d6, 'Excellent super réussi ! Ils ont adoré... Trop contente !', '2015-10-11T15:40:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, ee0766f1-a70c-4c6d-9f03-7cb6d69a5bf8, 'Délicieuse harmonie des saveurs cidre, pommes, échalotes et lardons qui rehaussent le poulet. Merci pour vos excellentes recettes, aussi claires qu''inventives.', '2015-03-18T12:28:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 9f7fc920-28b1-4191-9dab-b1ded1f9773e, 'Trop bon, merci !', '2015-03-06T10:34:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, d978f1ad-78d9-44d9-8e68-ceb25daf6a4c, 'Vraiment excellent ! Ne pas passer sur la phase finale avec le caramel et la crème fraîche, ça vaut le coup. Merci', '2015-01-03T13:03:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, c91c10ae-8523-4eb9-a04c-26910b57ba27, 'J''ai mélangé 2 recettes de poulet au cidre, donc j''ai en plus flambé le poulet au cognac, mis une bouteille entière de cidre et j''ai ajouté des champignons et du gingembre. Une fois cuit, j''ai mixé la sauce et je l''ai lié avec de la maizena. J''ai servi avec un mélange de "céréales et légumes secs" (en grandes surfaces rayon riz etc). Franchement c''était super bon, à refaire.', '2013-04-19T15:52:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 6cada4d4-1b69-46a5-8bf2-1b8a8a3c1e42, 'Très bonne recette, merci.', '2012-05-20T18:02:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 7af502c3-7e56-45d4-aef1-b4a893f8c3ca, 'Vraiment facile à faire, original (j''adore la cannelle) et excellent ! Je l''ai accompagné de pommes de terre cuites à la vapeur.', '2011-11-28T18:29:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, bc3f85ea-ed0b-4ab7-825f-baad72b357f4, 'Très, très bon ! Et facile à faire. Mon coloc et moi recommandons cette recette, qui en plus est peu coûteuse. Merci !', '2011-09-05T23:28:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 3093c5e6-9e68-4699-9714-771fc761d68f, 'Une recette vraiment facile ! La sauce caramélisée est vraiment un délice. Je conseille plutôt un poulet avec blanc et cuisse pour que cela moins sec.  Ajouter des petites pommes de terre primeur et ce sera un diner parfait.', '2010-04-05T15:24:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 7b1a24d9-e67d-496b-851b-1e1a35ba9595, 'Voila une recette originale et qui change. Ras le bol du poulet au citron et du poulet grillé....servi avec des pommes de terre et un bon verre de cidre Normande bien sûr.', '2009-11-11T18:53:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 4f840b66-6014-4052-99e2-a6a3c4ec3eec, 'Simple à réaliser et qui remporte un grand succès. Merci', '2009-05-07T22:44:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, c69bb784-1523-48e0-b51d-8674b77631a5, 'On sent trop le cidre... vraiment très moyen. Par contre le poulet est très tendre.', '2009-03-16T11:14:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 58f5df28-ed35-41b7-95ca-31484e300198, 'Mes invités se sont régalés. J''ai mis 1 bouteille et demi de cidre, car j''avais un très gros poulet. C''était succulent. Merci!', '2008-11-10T14:45:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 3473b640-d0f3-4b46-984c-c24c0c840ef9, 'Recette réalisée avec des escalopes de poulet et des lardons nature. Délicieux, j''ai coupé mes escalopes en petits morceaux et diminué bien sûr le temps de cuisson (environ 1/2 h maxi) et j''ai fait revenir les pommes avec poulet et lardons pendant 5 min. A refaire sans hésitation. Merci à l''internaute.', '2008-03-10T16:34:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 36c3cf3a-465e-4fa8-8eb0-1049202aaa23, 'Breton d''origine, pour moi il faut absolument rajouté de l''eau de vie de cidre après avoir fait revenir les échalottes et déposer le poulet. Cela donne un goût incroyable à la recette!Je met aussi une bouteille entière de cidre et un pot entier de crème, mais bon on est gourmand...', '2007-10-01T12:53:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 24903d69-1a1b-4857-90f6-bd23b0f903c0, 'Trop bon!! Par contre j''ai mis toute la bouteille de cidre pour avoir encore plus de sauce.....les pommes ont fondu en cours de cuisson mais ont laissé un très bon gout....avec de la polenta c''est parfait.....je vais en refaire très vite.', '2007-09-12T13:44:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 70c8eb37-cdf3-4d36-b86e-74f342b3fde1, 'Délicieux! Simple, rapide et succès garanti ! Il faut juste penser à mettre les pommes vers la fin de cuisson, comme conseillé. Idéal pour les grandes tablées : cela mijote tout seul !', '2007-04-13T12:36:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, af527ddb-e4af-48f0-99f8-c8f98d05610b, 'Délicieux et très facile à faire. J''ai suivi la recette à la lettre sauf pour les pommes que j''ai rajouté 20 min avant la fin de la cuisson et je l''ai servi avec des champignons. C''était mon 1er poulet au cidre et ce fut une réussite. A refaire très vite.', '2007-03-20T10:48:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 79f23945-1d51-4c44-a55b-3377b8ab64f7, 'Excellent!!! Mais faire moins cuire le poulet si il est en morceaux et rajouter les pommes à la fin.', '2007-02-18T16:53:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 7a8987ab-9613-4d74-9288-70000a9126b7, 'Très bon et facile à faire! Seul bémol : il faut effectivement rajouter les pommes juste avant la fin de la cuisson si on ne veut pas avoir de la compote.', '2006-11-29T17:08:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, d6934edf-d47b-477c-952a-1f837333225b, 'Recette facile et délicieuse, il suffit de suivre la recette à la lettre; les proportions sont parfaites! La sauce est divine, même avec moins de crème (10 cl) et les saveurs sucrées/salées sont présentes mais discrètes. Pour le temps de cuisson, il faut évidemment adapter selon le poulet choisi! Je mettrai juste un petit bémol sur la cuisson des pommes, car je voulais des quartiers de pommes et non de la compote! J''ai coupé les pommes en 4 et elles étaient cuites en 10 min, en les posant sur le dessus du poulet; donc ne les ajouter que dans les 15 dernières min de cuisson, si vous voulez une jolie présentation. Il suffit de les surveiller et les retirer de la casserole dès qu''elles sont à votre convenance. Servi avec des pâtes, l''alliance pommes/pâtes est parfaite. ', '2006-10-15T21:07:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 7c45649e-fcc4-41fb-bfa4-e713ee652fc2, 'Très bonne recette. Je l''ai servi avec des tagliatelles, tout le monde a apprécié.', '2006-05-22T20:07:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, e1c33d6b-7e26-45d7-a890-7b3c1017ab40, 'Excellente recette. J''ai juste rajouté des carottes pour avoir plus de légumes et servi avec des pâtes. Tous les convives ont adoré et m''ont félicité. Merci beaucoup.', '2006-05-10T18:26:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 6c775b51-c2ac-4c2b-ad58-07e8d06d0f08, 'Excellent! Les pommes donnent un petit goût sucré bien agréable.', '2006-01-14T15:41:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, f8950b99-41db-4a10-8401-65ef040b3895, 'Très facile à faire. En cocotte minute, réduire le temps de cuisson à 30 mn. Servi avec de la semoule de couscous et raisins secs. Un délice!', '2004-05-28T20:00:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 8f93f0a0-eff2-4ad9-9d87-106f87702200, 'Délicieux... J''ai testé la recette pour des amis et on s''est régalés. La recette est facile à réaliser.', '2004-05-24T10:51:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 2c59118a-7530-4faa-91c4-e21e302ba704, 'Ce plat est délicieux. N''ayant pas beaucoup de temps, je l''ai fait en cocotte minute. Seulement attention, en autocuiseur il y a moins d''évaporation qu''en cocotte fonte et à l''arrivée j''avais trop de sauce, trop de liquide. Je l''ai fait réduire. Mais la prochaine fois, je le ferai dans une cocotte en fonte...', '2003-11-23T17:16:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 257613ca-c447-4e3f-85d6-1ce911e16f43, 'Il faut prendre une cocotte en fonte et non une cocotte minute.', '2003-03-24T18:47:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, d2a5ef67-b40e-4d8a-9193-54fd09b06e5a, 'Très bonne recette, facile à faire, sans prétention, mais qui a beaucoup de succès. Cependant la durée de la cuisson du poulet est à revoir.', '2002-09-14T21:43:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 8e672901-04d4-4d23-853e-4a5860785d1f, 'Même sans les lardons et avec du cidre doux, servi avec des pommes de terre nouvelles, c''est UN VRAI REGAL!!!', '2002-05-24T21:27:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, a71e2de1-050f-415c-be44-bb01cfb2caed, 'Vraiment délicieux!! Je l''ai servi accompagné de tagliatelles fraiches et d''une fricassée de champignon, un délice!!', '2001-11-26T15:37:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, 66af2246-0068-4032-a5dc-09b820f49835, 'J''ai mis des cuisses de poulet. J''ai d''abord doré les cuisses et j''ai enlevé le gras avant de suivre votre recette. Merci!', '2001-11-04T17:20:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15104, ab4bccef-3fa2-462f-a9c0-3727e0a3285e, 'Excellent et très facile, mais attention: si vous optez pour la cocotte, réduisez la cuisson à 1/2 heure car en 1h, le poulet est beaucoup trop cuit. Surtout si vous le faites revenir avant!', '2001-10-21T22:47:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, 02f0de14-8eef-4cf9-8160-c352fd65c5f0, 'Une des meilleures confitures de fraises jamais goûtée, faites avec les fraises du jardin, le gout et la nature des fruits sont préservés. ', '2017-08-27T02:25:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, 882e078d-e374-4657-803d-913b78cbe91f, 'Cette recette est un bonheur pour toutes celles et ceux qui n''ont pas envie de passer 10 h devant leurs marmites et en plus ça marche pour tous les fruits. Je rajoute du agar -agar 30 secondes avant la fin de la dernière cuisson et nickel. merci !', '2014-07-20T13:03:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, fdeac506-7226-4deb-a080-67800f7f637d, 'Recette facile à faire, rapide et excellente!', '2013-03-26T13:54:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, 52da3b6b-bf1a-42a8-9453-d3139cdd2baa, 'Vraiment délicieuse, tout le monde se régale !', '2012-07-26T22:33:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, c9d8ede5-d5f3-405c-9399-743aefdb914d, 'J''ai trouvé cette recette lors d''une panne de gaz, préparation pour confiture prête. C''était 900 g de prunes avec 700 g de sucre à confiture et 2 jus de citron. J''ai mis 12 minutes au départ (plus de volume donc plus long pour obtenir l''ébullition) puis 6 min. C''est génial !!! Pour éviter les débordements, j''ai mis mon récipient dans un autre plus grand, comme ça, ça déborde mais ne se perd pas...', '2010-09-02T22:20:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, 5d0e1709-da6e-47a5-b852-571ba211a8c7, '2 pots vite faits et bien faits ! Je réduis juste la quantité de sucre et ajoute un peu d''agar agar (1 cuillère à café) pour les 30 dernières secondes de cuisson. C''est simple et c''est bon ! Merci pour cette recette !', '2010-08-04T13:16:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, 33efba45-6dbc-4d7c-a527-db4a2b8b49eb, 'Parfaite, cette confiture est vite faite et a un goût exquis. Ces quantités m''ont permis de faire 2 pots. (Attention que cela ne déborde pas en cuisant, il faut donc prendre un contenant très grand.)', '2009-05-10T12:05:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, ff5744bb-92bd-42ca-a250-c500dd976572, 'Bonne consistance, du goût et vite fait. Merci!', '2008-10-20T18:11:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, 373f5f27-8680-4736-86d3-ccd54f6695d6, 'Parfaitement parfait! N''ayant pas de sucre gélifiant sous la main, j''ai mis 450 g de sucre en poudre et un sachet de vitpris. Tout juste assez pour faire 2 pots classiques. Attention aux débordements: j''ai pourtant pris un contenant de 2.5 litres et ça a débordé! Mais la confiture est si excellente!', '2008-06-14T20:18:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, f5d809c1-5f04-48d9-a1e3-3fac163517b1, 'Le top! Préparé super rapidement et en plus tout le monde adore! J''en fais que les pots sont déja finis!', '2008-06-05T11:00:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, 34742f6e-2ae7-4109-a230-3ce46ff1530b, 'Assez d''accord avec Florence: ça ressemble plutôt à de la confiture industrielle. Facile à faire et rapide, en revanche.', '2004-10-10T16:17:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, 2b1705da-4a73-407d-adb7-e948504039be, 'Absolument fabuleux et ne demande pas beaucoup de temps.', '2004-06-30T18:07:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, 79ee31b6-bd24-410d-8d93-563f3590975a, 'Une recette de confiture super bonne. J''ai essayé avec des groseilles: temps de cuisson égal, pas de citron, passer à l''étamine, pas de beurre... Et vous avez une gelée de groseilles impeccable!', '2004-06-29T19:39:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, acaf7b93-443b-43e7-b3ee-e5a01fb27407, 'Très rapide et bon, mais à mon goût, ça ressemble plus à une confiture du commerce qu''à de la confiture maison à cause (d''après moi) de la texture gélifiée... Mais je réessaierai avec moitié sucre normal, moitié sucre spécial confiture. ', '2004-04-12T11:56:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, 59816865-69e7-4e41-9795-5ffc175c142e, 'J''ai essayé et j''ai adopté... Tout simplement délicieux!', '2004-03-14T20:18:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, 69209e96-98bf-41c4-9028-c44dfc6752e0, 'Super! Rapide et délicieuse...', '2004-03-11T20:20:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, 75d08a29-5c83-4405-97ac-899784a601b7, 'Le résultat est excellent avec une préparation et une cuisson ultra rapide. J''ai réalisé cette confiture avec des framboises surgelées préalablement décongelées. J''ai réduit les proportions : 35% de sucre et 65% de fruits (au lieu de 50/50), c''est très bien car moins sucré. Attention tout de même à ne pas trop écraser les fruits car à la cuisson les framboises ont tendance à fondre. Si vous préférez une confiture avec des morceaux de fruits, inutile de les écraser. Je conseillerais également de prendre un saladier assez grand et surtout avec des rebords assez hauts : en effet, lors de la cuisson, la confiture monte en bouillonnant. Si le saladier est trop petit, risque de débordements dans le micro-ondes ... Encore une dernière précision : avec 400 g de framboises, j''ai rempli un pot à confiture + 1/4 d''un second. La prochaine fois j''essaie avec des myrtilles, je vous ferai connaître le résultat ! Bonne dégustation.', '2004-03-06T14:10:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, 78e07f08-e135-438e-8ac9-0ea8d801ad80, 'Je suis contente d''avoir trouvé cette recette et je me suis régalé, ainsi que mes petits enfants.', '2002-05-29T17:33:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15002, de72cae4-ff54-4769-a726-ce9f24e9c068, 'Facile, rapide et résultat excellent.', '2002-05-26T21:33:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, f7e53525-9be1-432c-ad77-85176f216503, 'J’ai remplacé la biscotte par une petite tranche de pain d’épices', '2022-05-07T14:54:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, c89aa3f4-ac9b-44aa-83d7-e2a7f6f32ea1, 'Biscottes : bof. Cuisson : comme d''autres et malgré avoir réduit la température les pommes ont éclaté. Goût ...', '2023-11-03T14:13:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, ce3df797-3232-410a-b411-79641faa9407, 'Pour ma part, j''y rajoute un peu de miel et je mets du beurre salé. Une tuerie.', '2023-01-19T14:18:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, a3245ba5-a0a7-41b3-a983-e1849886d35a, 'J''ai juste rajouté un peu de vanille. Un délice cette recette toute simple 🧑‍🍳', '2021-11-20T13:23:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, c94d6bf8-3fb6-4549-a36f-09422741414f, 'Je mets dedans un carambar 😃', '2021-11-17T13:26:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 48f94bf9-f8e0-4072-a800-6bc3cecd9b96, 'Très bonne recette. Je mets du beurre demi sel et du sucre de canne, une tuerie ! ', '2023-05-18T22:10:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 744b6d78-e001-49f3-9ec5-f62995371f97, 'C''est aussi la recette de ma maman et de ma grand-mère, excellente. ', '2023-01-19T17:27:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 3488d00a-ab40-44ce-bbec-1115300852b6, 'Bonne recette', '2023-01-15T20:38:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 737b9cf4-1a3f-4302-8504-621a0d0da59d, 'Excellent et extrêmement rapide à faire mais à la place de la biscotte, j''y préfère une tranche de mie de pain.', '2022-11-25T16:58:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 7b9b97e9-d566-409b-9eff-02aa429e580e, 'Très bonne recette, personnellement, j''ai rajouté un peu de caramel liquide sur chacune des pommes et à la place du sucre poudre du sucre vanillé. Merci !', '2022-04-07T15:52:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 30020168-c771-4c2d-947b-aac9d2885c8d, 'Très bonne recette, je suis vraiment contente du résultat. En effet, comme cela a pu être indiqué il faut inciser les pommes (avec une fourchette de préférence), personnellement j''ai ajouté du sucre à la place du trognon, une noisette de beurre, de la cannelle et de la muscade.', '2017-04-30T21:55:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, a351bacc-8a6e-47ec-8117-e7d737ecd8cf, 'Très bon ! J''ai posté le résultat de la recette (voir photo). Pour ne pas que la pomme éclate, il faut inciser légèrement la pomme ou la piquer avec une fourchette. j''ai rajouté une pincée de cannelle : le plat automnal parfait !', '2013-12-19T14:08:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 6cfad11d-92a9-4a77-8554-7130322dc94f, 'C''est très bon ', '2022-04-16T17:17:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 15004fa5-6910-4e14-ba7a-abd42350aa1a, 'Excellent ! Je n''avais pas de beurre et pas de pain ni de biscottes.. . J''ai tout simplement vidé les pommes, j''ai ajouté de la crème fraiche allégée, de la poudre d''amandes, de l''Amaretto, un peu de sucre, je les ai posé sur du papier sulfurisé légèrement huilé 30 mn a 210°... Délicieux ! à refaire avec d''autres ingrédients ! Merci pour cette recette simple et gourmande ', '2021-04-23T20:28:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 3444af5c-a175-4935-9f04-4eeef1b5edd3, 'Mmmmmm, vraiment très très bon. Une fois les pommes évidées, mettre une noisette de beurre, de la confiture de framboise puis saupoudrer généreusement de sucre brun et déposer chaque pomme sur une tranche de brioche et enfourner..... ', '2012-11-22T21:46:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, f60a907b-f5fc-4f97-b5be-59700bb61696, 'Excellent et facile à faire... Je l''ai proposé accompagnée d''une boule de glace à la vanille : nos invités ont adoré!', '2006-11-29T15:13:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 4a457c9a-db63-4673-bda9-aa81fe993c31, 'Enfin une recette d''antan simple, succulente et de surcroit pauvre en calories!! A coup sûr ce dessert réjouira les papilles de petits et grands (attention, pas plus de 25 min, sinon les pommes éclatent!).', '2006-10-18T11:49:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, a4ae113f-eca6-4309-bb59-fb0a7967aa85, 'Ce qui ne va pas dans cette recette c''est que la pomme n''a pas assez de goût. Dommage.', '2005-09-18T01:41:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 343ad481-2fdd-4d0c-bbf4-7407f5b09b15, 'J’ai rajouté de la cannelle en poudre délicieuse recette ', '2023-10-29T14:26:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 44a64b0f-f96c-40c5-9ef8-b8e762fef1e0, 'Trop fort le four à 220 au bout de 15 min les pommes commencent à s''éclater ', '2023-10-19T19:16:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, ef982b2e-09b4-4a85-9a5e-48286f08c13a, 'Trop trop bon ! ', '2023-03-11T20:25:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 2539748d-30ea-47e5-b2fb-ae1f8a90a49d, 'Excellent! Merci pour l''idée de la biscotte qui s''imprègne de jus de pomme, de sucre, et de beurre, c''est très très bon ! ', '2023-02-18T22:03:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, ee665a7b-a054-4034-9c2a-1517ca7a4c8f, 'Trop bon', '2021-10-30T17:34:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 235574ef-5444-4fda-98c3-62ba207e3b8e, 'Excellent merci pour cette recette !', '2021-10-24T10:58:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 2ce90e60-693c-42b9-abd5-2ca101d7ba9f, 'Recette très facile. Je mets du lait Nestlé sucré à la place du sucre. ', '2021-05-09T12:11:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 94f17c95-94a8-4f75-bd9e-fa4caa60e523, 'Trop bon merci marmiton !!!', '2021-01-03T16:19:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 5e4b1f4f-9c8b-4c3e-a6c8-6082ae2f3fa0, 'Très simple à faire et délicieux ', '2020-10-27T14:09:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 5fe60106-9606-45eb-be74-d33bcacec187, 'Nous ne savons plus quoi faire de nos pommes du jardin. Là je tombe sur cette recette plus que simple est quelle le surprise: Le résultat est excellent !  Ça n''est certainement pas la dernière fois que je fais cette recette !', '2019-12-23T21:21:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 40352adc-5971-4af4-b220-fe525cc5334b, 'Excellent avec du sucre fin.', '2018-02-02T12:49:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 57b5eba5-c083-4853-be1b-70c604185a6c, 'Pour ma part, 220°C et la peau de ma pomme a brulé, tout comme le sucre qui était au fond de mon plat. J''ai dû descendre à 170''C et là ma pomme est devenue une boule de mousse de pomme. Je ne comprends pas que je sois le seul parmi tous les commentaires à avoir eu une pomme qui brûle....', '2016-11-18T23:53:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 167e1392-7665-4350-ba20-b377ae442dcf, 'Un délice, même froides.', '2015-03-01T21:51:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, e0e7d6a0-da91-4f29-9d89-adcf68a42c24, 'Bonne recette facile à faire et ultra rapide, à lancer avant le repas pour être juste chaud pour le dessert.  On peut remplacer les biscottes par des tranches de pain un peu sec et tapisser le fond du moule. Avec le beurre qui fond et le sucre, ça donne une sorte de pain perdu délicieux.  J''ai laissé jusqu''à 30-35 minutes car les pommes golden étaient fermes au départ. Tout le monde s''est régalé !', '2014-09-03T22:37:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, d6d8e9a4-16fe-475e-a46b-13f8c739f1b5, 'Très bon dessert qu''on peut faire de façon improvisée, ou pour utiliser des pommes qui s''abîment. Comme suggéré dans un commentaire, j''ai mis de la confiture de fraise dans les trous. Je n''avais pas de brioche mais la prochaine fois, je prévoirai afin de remplacer les biscottes. Par contre, attention à la variété de pommes qu''on utilise, certaines restent dures, au lieu de devenir bien fondantes.', '2014-04-13T19:05:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 345f21b2-fca7-4a76-81b3-144a26ae5688, 'Cela fait 2 fois que j''en fais mon mari adore !!! très bonne recette vite prête !!', '2014-02-08T20:46:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 87f1a75d-bf96-496f-ba99-6eaffc9875c9, 'Très facile à faire et très très bon ! Je l''ai faite avec du pain de mie car pas de biscotte. Je la fais régulièrement et toujours avec autant de bonheur !', '2013-12-19T13:47:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 00e0c546-ded3-47ca-b0ab-d0de935c81d2, 'Très bonne recette.', '2013-03-09T21:12:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 43ccbae3-3437-430d-88c8-678f41c6c9fe, 'Très bon dessert, peu coûteux et facile à faire, les enfants ont aimé', '2011-01-21T20:50:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 28d39579-e32c-44ce-812d-fe5bb7e27025, 'C''est bon, juste un problème, elles ont eclaté. La prochaine fois, je les laisserai moins longtemps, elles avaient bon goût et la biscotte aussi, je la referai.', '2010-04-28T21:49:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, a42da490-105b-4169-abf2-1aec7aadd491, 'Pour ma part je rajoute une cuillère de gelée de cassis ou autres ( de fruits rouges) c''excellent avis aux amateurs.', '2009-02-05T19:48:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 15052a3a-2ca7-4e7e-a3b2-0c9f99c8168d, 'Très bon. Grande gourmande que je suis, j''ai rajouté un petit carré de chocolat dans chaque pomme après cuisson. ', '2008-12-14T20:20:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 0b083f11-2799-4606-854d-2236c5e39ed6, 'Super simple et rapide à faire pour un excellent dessert qui évoque toute mon enfance !!!!', '2008-12-08T09:58:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, f261e39a-6dcd-47a2-ab3c-8f64c35dc8cc, 'Vraiment délicieux et facile : j''ai essayé avec la biscotte et aussi avec une tranche de pain briochée... Je pense que juste l''équivalent d''un sachet de sucre vanillé (env 8g) est suffisant par pomme sinon c''est bien trop sucré et c''est dommage de perdre le goût de la pomme (on mange bien assez de sucre comme ça)', '2007-01-31T16:24:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 0b471aee-c46c-4e78-9ef3-558f70da4ca4, 'Pas génial avec de la biscotte.', '2006-11-24T18:26:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, f8967e07-0e27-4b58-983b-bf0585882efe, 'Vraiment très bon et facile à faire, je n''avais pas de biscottes, je les ai remplacées par des tranches de pain de mie et c''était vraiment super, je ferai souvent cette recette.', '2006-11-14T16:00:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 172d7628-edca-4335-ae21-7b2196b00ddb, 'Excellent, j''ai remplacé les biscottes par du pain de mie, devenu caramelisé. Les enfants qui ne rafollent pas de desserts aux fruits ont adorés. A manger tiède de préférence. Bravo et merci pour cette recette toute simple.', '2006-10-30T12:10:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, fb4aeca0-02c9-46a8-8c9a-b4b0e9326c6c, 'Recette très simple à réaliser (mon fils de 6 ans m''a aidée). Un vrai régal pour petits et grands. Astuce : j''ai remplacé les biscottes par des cracottes. N''hésitez pas à bien beurrer le plat.', '2006-10-03T21:43:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, e5cca78b-6601-40ba-8a95-da7d59fabb49, 'Simplement divin... J''ai mis du pain de mie à la place des biscottes, et c''était vraiment délicieux. A mon avis, avec du pain brioché et une boule de glace vanille.... Avis aux amateurs!!', '2006-01-11T14:30:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 89b04fe6-9236-412c-a2e2-8d0b8756a303, 'Simple et délicieux!!', '2005-11-14T09:39:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 2e802957-f725-4e9c-acb5-40c6b9bfe0ff, 'Un vrai régal! Un dessert simplissime, rapide et qui régale les papilles.... Je l''ai fait un dimanche pluvieux: on s''est régalé !', '2005-10-04T10:21:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 2b20d61f-b6d7-4ddd-9ea7-621ad1d9a0be, 'Très facile, trop bon, à essayer sans attendre, vous ne serez pas déçus! ', '2005-10-01T02:18:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, a586728b-e56b-4eef-8c43-58876a0fdc20, 'Délicieux! Les enfants sont en train de déguster leur pomme et l''odeur embaume toute la maison. À faire sans hésiter.', '2004-10-27T18:34:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28963, 78d51ca7-1706-4deb-87fd-e135e781a3ca, 'J''espère que 5 est bien la meilleure note car cette recette est absolument délicieuse !!! et très facile à faire !!! J''ai juste remplacé les biscottes par des tranches de pain de mie et c''était très bon aussi !! On s''est tous régalés et la tranche de pain sur laquelle le caramel à la pomme avait coulé était tout simplement... succulente ! A essayer absolument!!!', '2004-10-17T04:43:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, c4413a30-f8ae-424a-9ea9-ff018ba26c70, 'Très bon, avec moins de sucre et j’ai ajouté des raisins conflits dans du thé. Un délice 😋', '2023-05-07T14:29:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, a043149c-03d4-48bb-bef6-576af307862c, 'Le petit délice de mon chéri!! Avec moins de sucre, il est encore plus savoureux. 😍', '2023-05-01T14:26:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 1b3cf085-17dc-45c6-a001-59b4c07d034a, 'Excellent, ai ajouté du rhum et de la cannelle, juste un bémol concernant les pommes qui montent dans l''appareil et restent à la surface', '2021-05-13T21:40:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 58793511-b411-4258-96ec-782415163b42, 'Très très bon, j''ai juste eu un mal de fou à le démouler', '2022-04-10T13:35:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, b35f7978-4cec-4f92-8456-86b5fdf6e8ec, 'Parfait, j'' ai fait la recette pour 6 personnes et je n''ai rien modifié', '2021-12-02T15:21:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 1484d33f-29d9-4705-980c-0848a897b781, 'Top 🔝 ', '2021-08-03T18:38:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, a319faee-c81b-41c0-9c31-353ffba24807, 'Excellent et simple et rapide.', '2021-02-22T22:09:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 72faa9d3-aa6d-465a-94bc-b0cc2155e753, 'Excellent et très vite fait', '2020-11-06T17:04:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 87a57579-0d9d-41f8-a44d-485e3fba8c88, 'Recette adoptée. Vite fait, mais encore plus vite mangée. Alors maintenant, j''ai décrété que j''aurais un marmiton qui coupe les pommes et moi qui fait le reste. Synchronisation parfaite !... De notre côté, on met un petit peu moins de sucre, du rhum brun en plus et de la cassonade au fond du plat.', '2020-05-10T20:04:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, d84230e5-f7fa-4f94-a8f8-a8cb1f9c7565, 'Excellent ! J''ai fait comme la recette du Far aux pruneaux,j''ai laissé reposer la pâte,pris les mêmes proportions mais pour les pommes,je les ai caramélisé avec de la cassonade ! Un délice !  !', '2020-04-26T20:20:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, d40e05ce-e59e-4c0b-8edd-d4aeeb250cfd, '3 oeufs et 100 g de sucre et c''est encore trop, 1 seul sachet de sucre vanillé. Les pommes sont remontées à la surface. A refaire avec des pruneaux car le far est très bon.', '2018-11-07T18:40:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, f8229207-0e5b-4b04-8136-b3105c9cb8e0, 'Très bon et léger ', '2016-12-05T11:49:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 36528423-64d1-4d76-b14f-69f0900e1551, 'Simple et délicieux, un peu de rhum en plus et c''est tout', '2016-03-19T11:33:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, c575af22-2b0c-40e8-87c1-3e9d527bff54, 'Je cherchais un gâteau simple et rapide et je n''ai pas été déçue ! Je n''avais pas de crème fraîche liquide mais de la crème fraîche épaisse a fait l''affaire, j''ai mis beaucoup moins de sucre : 80 g de sucre de canne au lieu des 120 g annoncés et c''était parfait. Cuisson un peu plus de 45min. MIAM !!!', '2016-01-27T12:19:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, acbe12e9-c274-403d-b8e1-10bf1275fbd5, 'Au top ! Tout le monde adore. C''est une valeur sûre !', '2015-11-11T12:43:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 112dee51-596d-4cfa-aac5-b1fb60b6f128, 'Parfait... Facile... Très bon ! Perso j''ai coupé les pommes en petits morceaux... ', '2015-09-13T20:08:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 65f9b3d2-3a72-4d2d-8422-5b68e2282649, 'Un succès à chaque fois, approuvé par des bretons c''est pour dire !', '2015-02-19T21:00:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 45aa27c4-f3e8-4863-9d20-3fed5a9419ca, 'J''ai fait cette recette avec seulement 2 oeufs et de la crème légère. Le résultat est très bon et agréable ', '2015-01-25T19:53:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, b7a7426e-f4fe-4bdd-b34c-d6290d4be701, 'Recette parfaite, rien à dire. Seul truc rigolo : les pommes sont toutes remontées à la surface. Mais à part ça, tout était nickel. Le gateau est parti en moins de temps qu''il n''en a fallu pour le dire.', '2015-01-11T20:09:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, d95c881f-606c-4508-88a7-e9b492e3c9ba, 'Superbe recette. Moi j''ai ajouté de la cannelle et de la vanille liquide. ', '2014-11-16T22:36:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 7463f9cd-3a20-4d71-9f89-6e64d01b32ba, 'Excellent !!     ', '2014-11-11T10:40:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 4f7fc431-df65-4cea-b1dc-60a6c565ceb2, 'Délicieux, je n''ai pas mis de crème et j''ai laissé cuire 1 heure.', '2014-05-22T19:39:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 859af846-d083-41eb-b287-2d0d1382a833, 'Recette très facile, très bonne, impossible de la rater ! Même pour un novice en cuisine !  ', '2014-05-03T19:18:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 7163d8f3-3cfa-4d50-b085-1468e7b801d5, 'Délicieux ! Et en plus très facile à faire', '2014-02-27T22:07:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, cdc9d4a9-fea0-4348-b339-19c0e4fa2fa5, 'Félicitations !! Parfait équilibre entre chaque ingrédient. Dégusté tiède, ce "Far" est un dessert savoureux et original.  Merci beaucoup.....', '2014-02-26T20:17:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 5f5b7ad7-10ee-4214-9733-a7a4bf79eb93, 'Excellent ! Par contre, je l''ai fait cuire une heure. Recette adoptée par toute la famille. MERCI.', '2014-02-17T20:27:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 58eeb393-c20d-4dd3-b948-10071bcfb910, 'Super bon ! Merci !', '2014-02-03T22:00:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 3a636c6c-5e1e-4141-a036-2d4de8d4c046, 'Un délice ! Merci, recette adoptée ! ', '2013-06-10T00:53:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 6d0202a5-5bbf-443d-92a5-e8dac4ed0698, 'Trop trop bon ! Le plus, c''est quand on fait frire des petits morceaux de far le lendemain dans un peu de beurre... C''est un vrai régal !! Mon copain qui n''est pas très dessert en redemande !', '2013-05-25T18:26:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 42915488-b482-48f5-9065-b74984ba2b3c, 'Délicieux et rapide à faire. Je diminuerai le sucre la prochaine fois. Je l''ai fait version pomme/pruneaux c''était très bon !', '2013-04-29T21:32:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, f63eca68-7ac3-422e-83f1-406057257b4a, 'L''essayer c''est l''adopter. C''est excellent, j''ai mis 2 pommes et demies car petites pommes et un petit bouchon de rhum pour aromatiser. Merci pour cette recette !', '2012-09-25T18:22:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 7297d535-5c5f-49b4-9f13-4ee5c542e9b1, 'Un délice !!! Je l''ai fait pour combler l’appétit des Bisounours en retour d''un match de Handball et elles ont adoré ! facile à réaliser et vraiment goûteux, je recommande !', '2012-05-14T13:33:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, c0507925-29f9-4495-8823-2ef3cc55fd9e, 'mes pommes sont remontées à la surface  je l''ai fait dans de cassolettes mais ça n''en est que plus esthétique  arôme vanille à la place du sucre vanillé au top pour les régimes !', '2012-05-01T15:06:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, e29a0999-90a8-4f3e-945e-9811749d992b, 'Super recette, pour une touche d''acidité pomme verte et pour un peu plus de gout pas de sucre vanillé mais de l''extrait de vanille avec un peu de rhum. Simplement divin... merci.', '2012-01-18T14:45:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 695bd2f0-d4b5-43f7-8ed4-d1c09919013c, 'Super : en revanche je n''ai mis qu''un seul sachet de sucre vanillé, pour ma part cela suffit amplement. Pour celles qui souhaitent faire caraméliser le sucre au grill avant de servir, deux ou trois minutes suffisent ! Faites pas comme moi : 5 minutes et tout le dessus de mon far en est ressorti limite brulé ! Mais très bonne recette et très rapide à faire ! Un soupçon de cannelle est recommandé.', '2010-08-07T02:30:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, ad5c5e58-4da6-4356-816e-e32541845d0a, 'Léger et savoureux, il ne donne qu''une envie, celle de se resservir.', '2010-07-12T23:07:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 86761cc7-0d0b-4ead-8eb0-41c9e09b2918, 'Très bon, je n''avais plus de crème, je l''ai remplacée par un yaourt nature, je n''ai mis que 3 œufs et 1 seul sachet de sucre vanillé. A refaire !', '2010-03-29T23:02:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 458d3dd7-89ba-4343-a730-fd7bc4874215, 'Nous n''avons pas apprécié, trop fade avec la pomme. Mieux avec des pruneaux !', '2010-03-13T21:14:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 43ef5875-bb31-4c76-b7a3-302278706868, 'Recette très facile à réaliser et le résultat est excellent.', '2010-02-14T19:25:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 1e80ed1e-c781-45dc-b29c-3b56c2955881, 'Recette facile à réaliser et économique ! Ce far breton a plu à toute la famille. Je la recommande aux mamans pressées qui pourront faire plaisir à leurs chérubins !', '2009-08-22T09:28:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 4ecbd48d-8878-4eea-8092-cea3ad8e14ff, 'Recette facile à réaliser et économique ! Ce far breton a plu à toute la famille. Je la recommande aux mamans pressées qui pourront faire plaisir à leurs chérubins !', '2009-08-22T09:28:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, b6ea2b2c-92ac-4eff-95e7-ad0c609d8c01, 'Excellent! j''en fais souvent...', '2009-01-10T17:20:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, b236655c-fe2d-4fac-941e-b56ba221160e, 'Super facile à faire et drôlement bon, les gourmands m''en réclament souvent maintenant merci pour la recette!!!', '2008-11-11T18:35:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 99849f22-555f-4bd5-948b-cdac4008fc7f, 'Recette facile et résultat sympa! Rien à redire malheureusement. Mon sucre au fond du plat a un peu trop caramélisé mais c''est de ma faute je l''ai laissé 5 minutes de trop !! Merci pour cette recette!', '2008-10-12T15:51:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 2c17e88e-2616-4b2f-8c68-195909a40f56, 'Merci beaucoup c''est une recette simple et très bonne. ', '2008-02-23T14:28:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, 1c4c8702-c473-43c6-9779-08b418d1e4e4, 'Excellent rien à changer! Merci.', '2007-12-26T15:23:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, ef5c7f7b-8fa8-4824-b27c-6a990382a5c0, 'Délicieux, vite fait, et 3 oeufs ont suffit largement.', '2007-11-28T17:31:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55150, efbecf31-47f7-47fa-9e87-045de0948815, 'Excellente recette ! Je n''ai rien changé, on s''est régalé.', '2007-10-21T16:56:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, ea7bdc52-ebd3-4be8-a330-bd3bd71354a8, 'Très bonne recette et très simple, mais après l''avoir testée pour ma part je le referai mais avec des pommes caramélisées, du miel et une touche de paprika juste sur le chèvre.', '2016-03-14T14:10:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 724d4ccc-6935-49a5-aadb-ddc529c8ab26, 'Très bon, j''ai badigeonné les pommes de miel pour plus de gourmandise', '2022-04-10T17:14:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, b522389e-d61b-49fe-a7f0-773cce7381ac, 'Miam ! Ces feuilletés ont eu un succès fou autour de la table. J''ai lu consciencieusement les commentaires en amont, et j''ai suivi la recette en ajoutant de l''herbe de provence et du miel sur le chèvre, en plus de la ciboulette. J''ai fait des variantes aussi poire-chèvre, pomme-chèvre et mélange pomme-poire-chèvre. Un REGAL ! Par contre, lorsque je la referrai, je ferai des chaussons plus grands: Comme c''est fastidieux de préparer d''aussi petits feuilletés ! Servis avec une salade et vous avez une entrée du tonnerre.', '2020-12-26T01:46:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, bf2f4c3a-0a19-40f4-9908-288e135e1973, 'Recette super, que j''ai fait pour un apéro.  Perso : pas de pomme, à la place, une demi cuillère à café de miel. Quelle super idée ! Ah oui et avec juste une salade verte c''est parfait également !', '2013-09-30T15:38:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 05e10135-fcc7-471d-9d61-fb3c2c2fbff7, 'Pas trop mal sans être exceptionnel pour autant ... un peu fade à notre gout, malgré le fait d''avoir fait revenir les pommes dans un peu de beurre et de miel comme préconisé dans les commentaires. A refaire peut-être avec des poires pour comparer... ', '2009-07-21T21:02:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 155796ba-2446-41b7-af9d-9d9f184224ba, 'Très bon. J''ai fait revenir les pommes à la poêle et ai fait des petits chaussons plutôt que la superposition en hamburger qui est fastidieuse à faire.', '2007-01-02T22:57:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 5f221aba-081e-4735-9abf-1e2f2f64abe2, 'Très bonnes recette, mais j''ai mis du camembert à la place du chèvre, et fait cuire 20 min à 180°, c''était excellent ! Servi avec un peu de mesclun', '2024-02-28T18:51:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 7eaa97b9-5eac-4f26-b1fb-26411189af82, 'Vraiment très bon et facile à faire !', '2022-10-15T22:35:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 36bc25d8-e255-4e1b-a4bc-e2afd0059486, 'Super recette ! J''ai fait des grands chaussons à la place de petits.', '2022-10-08T20:15:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, a8432581-324e-4214-b4dd-914f8edf12b2, 'J''ai ajouté une touche de miel sur le dessus dans l''assiette.', '2020-11-13T19:41:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, cc2886fa-039a-4171-8f2a-ea0dc672e4d1, 'Très bon et frais ! J''ai également fait avec des pommes et du camembert ! Merci.', '2016-10-19T23:56:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, e4df84e9-4705-4054-8221-87e1f3527bf7, 'Très belle présentation, et les feuilletés ont fait l''unanimité ! À refaire.', '2015-12-05T19:59:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, dd03c355-050b-48c9-a3c3-301af237d216, 'Testé avec des amies. La préparation est facile et le résultat est là. Nous avions rajouté un peu de miel.', '2015-11-25T19:26:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, d2c5d16b-6e81-44ac-b731-8aac600c672d, 'Facile et succulent ! Très bonne entrée appréciée par les petits et les grands.', '2012-09-30T19:42:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 62ff1448-162d-4bb1-b1eb-f325e12e6479, 'Très bon, facile à faire, et ça fait de l''effet. Je la fais souvent à mes invités. Il faut effectivement prendre quelque chose de plus grand qu''un verre (au moins un verre à whisky), j''essayerai avec un petit bol la prochaine fois, comme indiqué dans les commentaires.', '2011-11-26T15:45:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 25b47207-eecd-42b2-9d46-e17b5893b9c8, 'Un peu trop de pâte à mon goût, à refaire avec des feuilles de brick, façon aumônière.', '2011-11-05T18:44:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, c6703329-d7fd-4f6e-99f5-8ef225b325cf, 'Mes convives ont adoré ! J''ai aussi essayé avec une tomate et des herbes de Provence parsemées sur le dessus. Ajoutez un peu de fleur de sel pour finir...', '2011-07-05T11:17:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, ee8b2e14-050f-44e3-afbf-80f5d990018f, 'C''est absolument délicieux ! Le mariage pomme/chèvre est une réussite. Tous mes convives ont été "bluffés". De plus, grâce au jaune d''œuf bien étalé sur le dessus, mes feuilletés étaient dorés à souhait.  Et puis, point important, c''est vraiment simple à préparer et quel résultat !!!!', '2010-05-18T14:06:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 278edfdc-5b32-44db-9f18-d3e189d0bb13, 'Vraiment entrée très facile à faire et délicieuse. J''en referais sans souci mais cette fois-ci aux pommes. Je conseille cette recette !', '2009-11-22T20:03:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 6714fc7c-3609-42e0-9075-9fc163dd01ad, 'Pas mal et facile à réaliser, j''ai essayé de remplacer les pommes avec des poires. La prochaine fois, je ferai la recette originale avec les pommes car les poires ne donnaient pas beaucoup de goût.', '2009-09-24T13:54:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 909a2b73-696e-4f4a-838a-5b81c8bc0e43, 'Il n y a qu''un mot excellent et bien suivre la recette pas de problème, très fin c''est une superbe entrée, merci encore et bon appétit les amis !!!', '2008-11-05T19:45:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, b013c95b-2011-41a4-92f7-6b99c2e8c896, 'Bien, sauf que le mélange sucré-salé ne convient pas à tout le monde.', '2008-10-03T15:25:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 0a7e4ede-a8c7-4716-8791-ab0cb01b9f58, 'Gros succès avec cette entrée simple à réaliser. A recommander', '2007-12-02T13:13:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, f4f7bbb9-add2-4094-8667-638d021b5239, 'Ne pas hésiter à découper des ronds de pâte assez grands pour y mettre une fine tranche de pommes car sinon, le goût de celle-ci est masqué par la pâte feuilletée. Ultra simple à réaliser, même par des enfants!!', '2005-02-28T12:23:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 07c0fc48-c5c7-4d91-892e-43fb19e6ed56, 'La pomme prend trop le pas sur le chèvre selon moi.', '2023-03-29T21:21:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, ef15fc28-bcf1-47a8-917b-d4c53445234b, 'Parfait merci pour cette recette extra rapide et efficace.', '2022-04-23T13:02:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, a7a6eef5-0fa6-4aba-92e9-22a007aebc1f, 'Juste parfait !!! recette a suivre à lettre et tout est parfait.😛😛😛', '2022-01-22T23:22:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, ab464d38-83b4-4399-8bc8-e25cbf95bad0, 'Je vais essayer ', '2022-01-09T06:16:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 11e5fb84-4066-4a2d-a461-9a19eb1c9c2e, 'Très bon, servi le soir avec une salade. ', '2020-06-05T00:07:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 0aa00d0b-d6e8-46f7-8a38-4684a33f0314, 'Vite fait et délicieux avec une salade !', '2020-04-02T17:19:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, c0fd9f41-10d2-46e7-a247-c4370e86f93e, 'Facile à faire et très bon !!!', '2019-02-12T09:19:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 3adb99a1-d313-4a28-919e-6e8dddeaadd3, 'Recette faite excellent !', '2018-10-03T03:03:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 838fbf5c-002d-4065-8be2-34c5ca8739af, 'Top top ! Tout le monde en raffole chez moi !', '2017-04-28T18:00:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 561b3fa4-38f2-4be3-a29c-d491d438f68e, 'Mmmmmmm ! trop bon !', '2016-09-28T09:15:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 361a60b4-71ce-4e09-8f9e-58baef036b79, 'Trop bon !', '2016-04-18T20:16:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, ee210c00-37a3-42da-ab11-5f9b7e3bdd1f, 'Préparé à l''occasion d''un diner accompagné d''une salade verte. J''ai fait un grand chausson comme une calzone, j''ai mis tous les ingrédients sur une moitié de pâte et refermé avec l''autre moitié. J''ai utilisé du chèvre frais. On sent bien la pomme. Il faut aimer le sucré-salé.', '2015-11-27T11:19:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 97a9d90c-60ba-44d6-9d9b-e90157549807, 'Une bonne idée en accompagnement d''une salade, j''ai rajouté un peu de miel ! Par contre mes feuilletés ne sont pas restés fermés, la prochaine fois j''essaierai sous forme de chausson !', '2014-05-16T09:55:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, b37c8d2a-37ce-49c6-8690-39f09fafe1c2, 'Très bon et très simple ! Merci !', '2014-04-19T13:55:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, a1377502-c3ee-41fc-8938-1b9d27a00d23, 'Excellent, pour une entrée plus raffinée, ajouter une tranche de truffe fraîche entre la pomme et le chèvre. Un vrai régal...', '2013-12-28T16:46:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 32b19391-c50f-46fe-8c6d-bef114429935, 'Magnifique, rien à redire...', '2012-06-17T14:15:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, ff38fd26-ade9-41b2-84be-6a3012c35d48, 'Une entrée que je fais régulièrement, tout le monde adore. Excellent aussi avec du miel sur le chèvre à la place des herbes...', '2012-01-21T19:56:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, dc531300-0016-49e8-9175-2521b6ac7fef, 'Très bonne recette !', '2011-10-28T20:32:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, ecbb113a-fcb8-4467-b3fa-418939ef3361, 'Pas mal, et surtout pas très difficile à faire et plutôt original. Il faudra que j''ajoute peut-être un peu de miel à l''intérieur la prochaine fois. Et pour la pomme, il en faudrait plus car je ne l''ai que peu sentie, mais pas facile avec la place qu''il y a dans ce feuilleté si l''on suit les mesures de la recette, avec le verre. Feuilleté pas évident à fermer, mais c''est un coup de main à prendre j''imagine !', '2011-09-16T16:30:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 97a091b5-7fa4-4c5b-85f9-2195afa88aa4, 'Recette toute simple et bonne. J''ajouterai pas mal d''herbes.', '2011-03-02T10:51:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, bc42e008-6d89-4f4b-b7f0-72e548cf75c4, 'Simple et très bon ! Plusieurs variantes possibles...Un snack idéal pour les enfants.', '2010-11-15T18:34:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 6cab65c6-4e7c-4a5c-80fe-02aa335fe5c7, 'Excellent. J''y ai ajouté quelques lardons.', '2010-09-28T18:42:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, fa1056c7-3516-4418-9399-1ac857acf071, 'Bonne petite entrée, assez légère et agréable à manger. Il manque peut-être un petit quelque chose pour relever le goût, une autre épice ? Cela ne m''empêchera pas de la refaire (et de tenter de nouvelles versions), les invités ont apprécié.', '2010-08-22T02:38:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, c2969113-60e5-40c7-b085-cc971f39a1dd, 'Simple et délicieux, je l''ai refait plusieurs fois et c''est le succès assuré !', '2010-07-24T14:39:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 83088310-2178-4816-9c86-b598a753f134, 'Super bon, facile à faire et à présenter joliment ! A refaire absolument même à ceux qui ne sont pas très "chèvre". ', '2010-04-09T20:55:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 30ef0a0b-76df-4376-815a-808df9ff0c7f, 'Très bon', '2010-02-19T22:21:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, a03b3a47-e008-4ad6-99f4-c496f15800e0, 'Recette excellente, super facile à faire et qui plaît à tout le monde. Personnellement, j''ajoute un peu de miel liquide dans l''assiette et là, ce plat prend toute sa dimension.', '2009-12-20T14:56:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 7c523d81-c0b2-4797-88b1-a5ad3edf30a9, 'Je m'' attendais à autre chose ! Faire des ronds de pâte feuilletée plus grands (avec bol par ex) sinon à peine assez grand pour souder le tout, sinon de petite portion de fromage et pomme.', '2009-11-19T12:13:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 6ed7fb7c-eae9-42d1-99c3-e8b6916d00af, 'Rien d''exceptionnel', '2009-11-15T18:53:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 2d343842-5c27-484d-b3f8-62ffae0c29a7, 'Parfait et j''ai ajouté un peu de miel la 2ème fois, pas mal du tout... des amis enchantés sont partis avec la recette en poche et l''ont cuisinée à divers repas  ! ', '2009-11-07T08:59:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 971e3d56-94b1-456e-811d-2e6048b1324d, 'Recette très jolie visuellement et très bonne avec une salade verte et quelques pignons de pin. Toute la famille s''est régalé !', '2009-09-12T00:19:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, f1594733-591f-454a-b908-5e80d41b801a, 'Très facile à faire et très bon, le tout du plus bel effet dans l''assiette, que demander de plus ?!', '2009-06-14T16:07:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 184d3d31-b913-4a28-8286-eb6cb3a21e71, 'Délicieux, j''ai fait la recette avec une buche de chèvre frais aux herbes de Provence et un peu de miel dessus. Merci pour cette recette.', '2009-05-25T21:06:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 8edad345-f08f-405b-8408-7a4c04e29fdb, 'Recette très sympa. Il faut juste prévoir des ronds de pâte feuilletée plus grands que les cercles de pomme : c''est bête, mais ça évite les surprises des cuisinières pas douées. Le petit coup de jaune d''œuf et les herbes de Provence ou le cumin-pavot ajoutent une touche délicate.', '2009-05-10T21:06:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 4d4136c3-ddad-4e18-8b0d-0c6be3ee925f, 'Un vrai régal, mais par contre assez galère à préparer. J''ai suivi les conseils des unes et des autres, en faisant le rond du dessous plus grand, en humidifiant les bords pour une meilleure adhérence entre, et en faisant caraméliser la pomme au préalable. Par contre, la prochaine fois, je mettrai directement la pomme et le morceau de chèvre sur le plus grand rond pour plus de facilité. J''avais oublié de mettre les herbes de Provence mais c''était délicieux. Des petits feuilletés accompagnés d''une salade est parfait pour une entrée. A refaire. Merci.', '2009-04-30T20:38:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28846, 532aaaf3-f334-441f-b3d7-b48c9ceae12f, 'Mon mari a fait la moue mais une fois dans l''assiette il a bien aimé bon mélange de saveur.', '2009-03-18T23:20:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, dc292218-1452-4926-97d6-19fed71397e9, 'J''ai mis 100g de sucre au lieu de 120g, et c''est pile poil ce qu''il faut 👍 

Aussi, je n''avais pas de fraises, mais ça marche très bien avec des morceaux de bananes 🤤 Merci pour cette recette, c''est top !', '2022-03-17T19:59:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, a6a05b12-9fdb-4e8b-ba2e-96142dfc705b, 'Le goût des fraises prend totalement le dessus sur la mousse de thé vert si subtile... Aucun intérêt au niveau des saveurs !  Autrement, j''ai utilisé de l''agar-agar (gélifiant naturel à base d''algues), beaucoup plus sain que la gélatine (composée d''os de porc bouillis).  ', '2008-05-27T22:59:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, ed972d1b-b4c2-4820-8d40-d33994a4378c, 'Je me suis servie de la recette de la mousse de thé vert pour faire un dessert vert-blanc-rouge. J''ai mis une gélatine au lait et à la vodka entre la mousse de thé vert et les fraises (mais en coulis cette fois) et tout le monde a adoré. Mon petit frère m''a même redemandé récemment que je lui refasse "le dessert vert"', '2006-09-12T16:54:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, e3d6b027-a439-4b39-90ac-78a3b4cbece1, 'Tout le monde a adoré cet excellent dessert. Mes amis m''en reparlent encore! 5/5 !!!', '2006-08-25T21:33:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, 8a4d83b7-ac4e-4d1a-91a9-437f080eb539, 'Excellent! Le thé vert matcha est un investissement, mais le petit pot dure longtemps. Je rajoute quelques pignons de pin en déco, qui donnent un peu de croquant à l''ensemble. C''est frais, c''est léger, et tout le monde adhère!', '2006-07-18T16:51:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, 9ae10cb4-e66a-4f6b-86d4-0c6cf88ccb4a, 'La recette est bien expliquée et le dessert se présentait bien, mais je n''ai pas énormément apprécié. Outre le fait que je trouve le mélange thé/lait/sucre un peu écoeurant, le résultat est assez surfait. C''est bon mais j''aurais préféré les fraises natures ou en sabayon. Je retenterai avec de la vanille, pour voir si le résultat me convainc plus.', '2006-06-22T03:41:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, bd06b100-c16e-412f-930b-7780a5bf6d54, 'N''ayant pas de thé matcha, ni même de thé vert, je l''ai fait au darjeeling. Par contre je n''ai mis que la moitié de la quantité de sucre indiquée c''est à dire 30 g. Avec des fraises toutes fraîches du jardin, un vrai bonheur.', '2006-06-16T01:41:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, a9a1e6b0-4b4e-4be2-99aa-adbad78306fb, 'J´ai goûté cette recette chez une amie. C´etait très bon, fraises et thé vert se marient parfaitement, mais je dirais un peu trop sucré peut-être...', '2006-06-14T21:32:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, 11e85af1-1ebe-432e-9e67-af1dadd55a5f, 'Recette originale et sympa.', '2006-06-13T12:09:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, 58b2cbe7-2290-458f-9237-bfbf9fb4a330, 'Très bon! Je n''avais pas de thé vert, j''ai juste mis un peu d''extrait de vanille dans le fromage blanc, c''est un peu moins original mais c''est délicieux ! ', '2006-06-04T19:42:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, dd2607ab-29b5-45be-beec-df91124c22bc, 'J''ai fini par trouver du thé maccha mais c''est très onéreux pour un effet visuel et non gustatif. J''ai modifié cette recette en ajoutant sur les fraises du coulis de groseille, j''ai pressé un jus de citron que j''ai chauffé légèrement pour faire fondre la gélatine puis j''ai mélangé avec du fromage blanc pour faire la mousse. J''ai décoré avec des feuilles de menthe, c''est moins coloré mais plus abordable.', '2006-06-04T01:05:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, 6ccd3208-bd03-49c3-982a-d52396080361, 'J''ai adoré : le goût du thé matcha est très présent et se marie parfaitement avec les fraises. J''ai servi ces verres avec de fines tuiles aux éclats de noisettes. Tout simplement parfait.', '2006-05-28T13:55:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, cb3dce51-dea3-486a-84d2-11591efd1683, 'Délicieux, frais, léger pour terminer le repas sur un nuage... J''ai pas trouvé de thé matcha alors j''ai utilisé du thé vert nature en sachet. Ça parfume bien aussi.     ', '2006-05-27T11:39:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, 87b842f5-dab8-4ad8-8bdc-8287a4ff2670, 'EXCELLENT ! très léger, très frais, parfait pour toute les saisons !', '2006-05-24T18:54:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, 9b9395a5-ce01-404d-9937-ef018b00f94c, 'Délicieux et bien frais. Etant végétarienne, j''ai remplacé les feuilles de gélatine par de l''agar-agar (gélifiant végétal à base d''algues rouges). Merci pour cette recette!', '2006-05-16T23:38:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, 631dd153-f559-464f-9a86-bf010ebd2eb0, 'Vraiment excellent et original! Cela rendait exactement comme sur la photo !  A refaire absolument pour épater ses invités et finir par un dessert léger... ', '2006-05-15T16:48:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, 4039bc36-7739-48c5-b4c1-02c9396640d2, 'C''est bon mais c''est un dessert très cher. Ce thé matcha, j''en ai le prix encore sur l''estomac!', '2006-05-09T12:43:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, ccb0619c-3c83-44b6-b88a-9836cf21379e, 'Délicieux!Très frais, très léger, j''ai eu beaucoup de succès. Par contre je n''ai pas trouvé de thé vert "en poudre" donc j''en ai acheté du "normal" (en vrac) et je l''ai fait infuser dans le lait: ça a très bien fonctionné! ', '2006-05-08T15:32:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, 52f9f6a2-8c88-431f-bcd7-477fad4116db, 'Très bonne recette, belle présentation, mes invités ont apprécié.', '2006-05-04T19:41:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, c1006553-c65a-4460-8d54-c79f919706e6, 'Dessert original, léger, facile à réaliser et très bon. Merci pour la recette.', '2006-04-24T23:18:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, 8867830a-3861-4931-9bff-872cfb625cf9, 'Très bonne recette qui présente joliment bien. Le plus difficile fut de faire 3 magasins de thé pour trouver du thé matcha. Je n''ai pas eu de soucis, contrairement à Marielle, pour mélanger les blancs délicatement avec une petite spatule. Pour accompagner cette recette, j''ai réalisé des tuiles au thé matcha en adaptant cette recette http://www.marmiton.org/recettes/recette.cfm?num_recette=36021 J''ai ajouté une cuillère de thé matcha à la composition et j''ai recouvert d''éclats de pistaches avant d''enfourner.  Merci pour cette recette très originale que je referai sans problème car c''est léger, frais bon et beau', '2006-03-26T14:48:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37801, fcf55b69-df32-4f27-b282-fc58215ff3b0, 'Mmhhh... que c''est bon, et beau! J''ai fait la recette avec du vrai sucre et du fromage demi-écrémé. J''ai juste eu un problème avec mon blanc en neige qui ne voulait pas s''incorporer à la préparation. J''ai donc fini par tout mélanger sans précaution. Est-ce dû à la gélatine ? Ai-je fait une erreur ? La prochaine fois je mettrai un peu moins de fraises pour mieux faire sentir le goût du matcha. En tous cas, à refaire !', '2006-02-18T22:09:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 44842d46-1f38-4b50-9444-f58b923673f2, 'Très bon ! J''ai modifié les proportions comme conseillé dans les commentaires. J''ai donc mis 3 pommes, 100 g de sucre, 100 ml d''huile, 200 g de farine et 4 càs de lait. J''ai gardé le reste des proportions pour 6 personnes et cuit environ 50 min à 180°C.', '2022-11-20T09:03:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, bd3e82aa-85cd-4f19-9110-78bf4ba7f8b6, 'Ma mère et moi adorons cette recette, que nous modifions parfois, en rajoutant des cranberries ou des figues, ou encore en remplaçant les noix par des noisettes... selon notre envie au final :) 

Par contre, nous réduisons l’huile à 100 ml, le sucre à 100g, la farine à 200g et uniquement deux pommes, comme le conseillait certains commentaires auparavant. 

Il est très facile à faire et vraiment délicieux à manger, alors ne vous retenez pas ;)', '2021-05-16T12:22:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 5f15b42a-9857-4ebe-a26a-64fbd80907e4, 'Très bon', '2023-03-25T14:55:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, ba1efc93-b013-4c0a-926b-2a20e344b6a1, 'Excellent, un régal, à refaire pour les gourmands et tant pis pour les kilos !', '2022-09-28T13:43:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 422044b4-fc60-4979-9f8b-ccd138af0019, 'Super bon', '2023-05-01T18:04:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 2309e205-d8ed-44ba-8182-f49e0a8dee44, 'Pas assez cuit au centre après une heure de cuisson. La prochaine fois, j''utiliserai 2 moules pour la même quantité de pâte. J''ai mis 150 g d''huile, 150 g de sucre et un yaourt nature. Très bon quand même.', '2022-10-02T12:31:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 693da9c9-f416-421f-9f4c-100abbdb302f, 'J''ai pris en compte les expériences  seulement 2 belles pommes. 100 gr de sucre. ,100ml d''huile. 200 gr de farine. Un filet de lait pour assouplir la pâte   Excellent. Il se tenait bien.', '2020-10-24T20:12:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 40cb30a1-2e55-4cc5-82b2-5fa387b3ec05, 'Il était bien judicieux de noter que la pâte  était difficile à mélanger mais une fois refroidi et déguster le lendemain,  quel délice ! J''ai suivi les commentaires concernant la quantité de sucre. Je le referai et servirai avec une crème vanille.', '2020-10-03T11:58:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, b9a12b36-6ccd-4684-8f3c-5ffeeb4f2eef, 'Très bluffant, rapide à faire et très bon. Avec un peu moins d''huile c''est aussi bon.', '2023-03-23T16:31:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 8d531e75-2c58-4d6e-9035-234d953e8606, 'Très bon avec modifications: moins d’huile (120ml), moins de sucre (150g) et j’ai utilisé du sucre brun. J’ai mélangé la farine 175g normale/75g complète. ', '2021-09-30T22:49:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 0a7e5f4c-87c4-46f1-a04c-eaf0e0a0bb11, 'Très réussi', '2021-09-25T15:28:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, ed614cb6-ab8a-4916-8eb4-0cf28408c544, 'Fait avec 5 pommes, et seulement 50 g de sucre. Très bon, léger pour finir un repas sur une note sucrée ! ', '2017-01-29T18:43:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 902aa4f5-c076-4094-b6d9-35cbf44e680a, 'Grosse déception!!! J''ai pourtant bien respecté la recette... Consistance humide (même le lendemain ou le surlendemain), un peu écoeurant, présentation très moyenne...', '2005-02-14T14:56:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, e583e9d2-3d45-4997-b91c-4fea63f6ddca, 'Très déçue... Au dire des commentaires, j''y allais les yeux fermés, mais la magie n''a pas opéré du tout. Gâteau fadasse, huileux, mietteux... Décevant au possible!', '2004-08-09T19:05:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 046fefd7-f92c-45fe-9feb-995c72618418, 'Très bon pour une première fois mais friable et un peu sec à mon goût, je rajouterai du lait la prochaine fois. ', '2023-10-25T16:24:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, c1a4eb9d-64e9-4d71-b088-5adad3d9a803, 'Délicieux ! J''ai bien sûr apporté comme beaucoup quelques modifications : 100ml d''huile, 80ml de lait pour + de moelleux, et 150g de cassonade à la place des 200gr de sucre classique. J''ai haché finement les noix dans la pâte et gardé une petite partie pour la déco. Idem avec les pommes : 2 pommes coupées en dés dans la pâte et les deux autres en fines lamelles que j''ai disposées en quinconce au-dessus de la pâte. J''ai saupoudré le reste des noix hachées finement par-dessus ainsi que de la cassonade. 1h15 de cuisson à 180°C pour mon petit four. Je referai cette recette, en variant le type de noix, et peut-être avec d''autres fruits, ou quelques pépites de chocolat pour la gourmandise ! 😉', '2023-10-15T19:48:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 295ff30b-3676-4691-b427-5b131b8ee3ab, 'Bien aéré et très gourmand. Mais à la découpe, mon gâteau s''émiettait.', '2023-03-17T18:30:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 81f2405c-2e0a-4be4-abcb-e7f1b146b06b, 'Excellent. J''ai remplacé en partie l''huile par du beurre, moitié moitié et j''ai mis plus de noix. ', '2023-02-16T21:59:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 67b236dd-afd7-42c4-ac36-8b41a0d7ee0c, 'Excellent gâteau, je n’ai mis qu’une cuillère à soupe d’huile et remplacé par du beurre. ', '2023-02-06T12:26:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 03bf2112-0445-4b12-8612-00c58ec8f78a, 'Il est vraiment très bon !', '2022-10-26T11:58:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, b8177286-308d-4316-9fc6-0838fb2ab4c1, 'Très bon gâteau moelleux , à refaire sans hésitation 😋', '2022-05-18T20:24:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, a53b8402-9ad4-4357-b93e-2b6a38521cfe, 'Excellent ! J’ai juste rajouté un yaourt nature car je trouvais cela un peu trop sec. 😋', '2022-04-20T13:20:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, cbccfed8-ca44-43c0-bbea-31579d50b9d8, 'Parfait 😋', '2022-04-07T13:12:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 29b6bfdc-b8d0-419a-a4d3-f80c44d5c956, 'Top', '2022-03-19T16:44:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 7a23f35e-2e12-44f7-8331-9aba79834ff0, 'Très facile et bon', '2022-02-16T19:55:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 689c1bd7-ac1d-4d61-8304-abe52364dffc, 'Délicieux ', '2022-02-03T18:45:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, f71c6e0d-4895-4666-bc45-1b5bd65fc37f, 'Ce gâteau est très bon mais trop friable. Dommage', '2022-01-18T10:33:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 833341b5-919f-448d-b303-e90c02226fa8, 'Super gâteau j’ai bien suivi les informations dans les commentaires. Il était bon, par contre très friable...j’ai sûrement mis trop de noix. Je vais le retenter sans attendre !', '2021-12-13T16:37:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 064b09ff-1303-49f7-a975-56f1541fd478, 'Délicieux ! Un classique chez nous, on me demande la recette à chaque fois ! ', '2021-12-10T03:44:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 127d113c-e493-4045-ab55-60f582eb7667, 'Un délice !



', '2021-12-07T19:22:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, ce8ac4d0-55b7-46f8-b793-dce74a5c4292, 'Mis 3 pommes, 100 g de sucre et 1 sachet de levure entier. Gâteau très moelleux, mais qui ne se coupe pas très bien.', '2021-11-24T11:48:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, e55cd446-ed02-4508-a80b-6d7e12c69856, 'Trop bon', '2021-11-14T18:06:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, e64a7411-8a72-40e6-ba33-9254e773a147, 'Très bon peut être un peu sucré 👍', '2021-11-11T18:03:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, adc7be58-58d5-4176-a3fe-fa2275c8f717, 'Recette parfaite les enfants on adoré ', '2021-10-13T12:03:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 061f40b4-516b-4deb-8192-d8f949dc81c4, 'J''adore.  Meme mon conjoint adore alors qu''il n''aime pas du tout la cannelle. Je referai sans hésiter !', '2021-07-17T14:20:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 3f39aa35-919a-4f99-a448-08984bc6c466, 'Super bon mais en mettant moins d’huile et moins de sucre .... et après on adapte en fonction de l’humeur ... noisette .... cranberries ....', '2021-05-16T14:59:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 01edfdda-8f54-4a24-8db9-40c446dd6456, 'J''ai fait cette recette ,elle  est extra 😋😋tout le monde ces régalé 👍👍je ne regrette pas .', '2021-05-11T13:26:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 31494ffe-a8a3-4d79-957d-9ed95e51e475, 'J''ai utilisé de la margarine, aussi bon ! Merci', '2021-02-21T19:36:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, b99f9d28-83b5-4ea0-a4e6-82970705e8ad, 'J’ai mis plus de pommes : Très bon ! Ça change du chocolat...', '2020-12-20T18:34:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 1d2cc141-ec09-430c-bd0c-a78a5adcc190, 'J''ai suivi la recette à la lettre  Réduire la quantité d''ingrédients car ça sort du moule à cake Goût fadasse, mouillé à l''intérieur', '2020-12-16T00:13:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 4bb9644a-2034-442f-81c0-047231cf7d47, 'Super bonne recette! J’ai adoré. J’ai mis 3 pommes au lieu de 4', '2020-12-13T17:36:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 8020ef5a-a4d1-46ad-b7f0-1f9297fde405, 'Excellent ! J’ai suivi la recette mais je n’avais que 2 pommes. Un vrai délice ', '2020-11-22T10:45:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, d120d87f-33b8-40e4-8a2f-69c70f5e7504, 'Excellente recette !! J’ai juste changé la quantité de sucre (100g) et c’est juste parfait !! ', '2020-11-14T16:58:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 0ca40426-9839-4b1b-adc9-2ad3f7842ab6, 'Beaucoup de succès. Suivant les recommandations précédentes, j’ai les quantités d’huile et de sucre', '2020-10-12T01:05:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, ea3be614-5566-483f-becc-043bd89245e1, 'Succulent ! Je n''ai mis que 150g de sucre.', '2020-10-03T16:01:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 9a343b70-1a44-49da-80b8-8dfd89229a3a, 'J''ai complètement oublié de rajouter des noix mais c''est tout de même excellent !  ! J''ai rajouté de la compote de pomme et j''ai mis une poire à la place des pommes, devenue bien moelleuse à la cuission (environ 45 minutes avec un mini-four donc compter moins avec un four à chaleur tournante). Ne pas hésiter à mettre beaucoup de cannelle si on aime ça ainsi que d''autres épices de Noël (gingembre, muscade... ). J''ai mis un mélange de farine T80 et T65.', '2020-10-02T16:05:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 1033784d-e7b0-4201-96c4-8695f544fd1b, 'J''adore ! J''ai mis des noisettes à la place des noix que j''ai concassé. A manger tiède, un régal.', '2020-10-01T15:56:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 65cf9c2d-f1de-4126-a882-6b9d8945efd2, 'Très bon gâteau. J''ai utilisé moins du sucre, et qu''une seule pomme qui était assez grande. Il y a un peu trop de l''huile alors j''ai ajouté encore environ 30g de la farine. 200°C, 60 minutes, voilà. ', '2020-09-26T15:02:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 6dc3608f-1c10-461c-8181-d60c21b64c1e, 'Une grosse tuerie ! Je l’ai réalisé pour un repas dominical chez mes parents et tout le monde a adoré. J’avais que 2 pommes sous la main donc moins compact que prévu mais c’était excellent si bien qu’on me le redemande tout le temps !! Merci beaucoup pour cette recette', '2020-07-06T23:00:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 74003a12-0372-421b-a26e-2c28be5debfe, 'J''ai mis 3 oeufs pour une cuisson de 45min. Fleur d''oranger aublieu de la cannelle. Super bon et bien moelleux!', '2020-05-04T19:46:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 369e711d-454e-42e3-ae73-12ae50f10656, 'Super bon, un peu moins de sucre', '2020-04-30T19:21:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 3ec8a401-e0ae-4a6c-a152-3d6d5036c7d6, 'Super recette !!
J''ai juste oublié le sucre vanillé
Se sera pour la prochaine fois !!
Merci', '2020-04-24T10:18:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 6ce5e0ba-e875-4255-85bf-445836b328be, 'Très bon, surtout avec la cannelle ', '2020-04-23T23:11:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, a5b5cf80-2fd1-479b-822a-1a04a9408ee5, 'Pour ma part j''ai diminuée le sucre et l''huile. Résultat mes enfants ont adorés. Je recommande ce gâteau sans hésiter', '2020-04-19T11:34:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, fd9abb76-4c3a-4ac5-b092-825b94957507, 'Délicieux et apprécié par tous', '2020-03-16T20:31:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 337f153a-57fe-42c5-9381-a905856c1992, 'Facile à faire et tellement bon ! Toute ma famille approuve cette merveille, une des meilleures recettes de gâteau que j''ai goûté !', '2019-12-29T11:49:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 09da0da9-d151-492b-ab7b-09e1b084e877, 'Un délice ! Je mets un oeuf de plus pour éviter que ça s''effrite, de la farine d''épeautre, 100 grammes de noix (à ne pas hacher trop finement), 150 g de sucre et 150g d''huile. Il est meilleur tiède.', '2019-12-12T21:31:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, 51b9ae7b-b96b-42e3-ab6d-c6686407e0b5, 'Trop d’imprécisions dans la recette, 4 pommes comment ? Petites, moyennes, grosses ? Vu le résultat avec 3 pommes de 140/150g... environ 1h de cuisson, c’est quoi environ. Parce qu’à 180 degrés, ça ne va pas donner le même résultat... bref certains se retrouvent avec un crumble, d’autres diminuent drastiquement les quantités d’ingrédients. Bref, c’est un peu n’importe quoi.', '2019-12-11T06:33:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, dff54d1f-85dc-406c-bbca-dcdb08f6e0b5, 'C''est TOP ! J''ai mis seulement 150g de sucre, 2 pommes Canada, j''ai remplacé le huile pour 1,5dl de huile d''olive et j''ai ajouté plain d''amour. Excellent !!', '2019-12-04T10:56:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16982, d13edc00-a762-4d0b-864a-9b163151d6cb, 'Très très bon. J’ai simplement réduit les quantités de sucre et d’huile. ', '2019-12-03T09:51:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71873, d950a8ad-5c65-4130-9d62-f7f3c6d2d92d, 'Recette faite plusieurs fois et c''est à coup sûr un succès ! Je remplace juste les boudoirs par des spéculoos et je fais moi même la chantilly (meilleur et plus léger). C''est un pur délice d''été !! Vraiment merci pour cette bonne idée de recette !', '2010-07-16T11:36:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71873, 2b262cd6-10b2-4999-a258-039694fcf0ac, 'Parfait, même sans sucre.', '2022-04-08T15:46:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71873, 7f9b2604-197c-443b-be19-2f453101a42f, 'Parfait, merci !', '2018-05-29T12:56:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71873, a5295a56-655b-4bff-96d3-b3f39b9821e7, 'Très rafraîchissant ! Recette idéale pour l''été et très rapide à préparer.', '2014-07-28T19:14:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71873, f6661925-247b-4fb1-a32d-76d7c1a67ebb, 'Délicieux ! Je n''ai pas sucré la crème chantilly, les fraises ayant déjà été sucrées. J''adopte cette recette !', '2011-07-06T16:02:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71873, 89c86a26-e5bd-45c1-ae7b-e603f1a17020, 'Très bon, la prochaine fois j''essaye avec des spéculoos....par contre avec 500g de fraises j''ai fait 6 verrines !!!!', '2011-04-30T13:28:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71873, ebb63584-23a9-444a-ba68-fe0799e9eebc, 'Simple et très bon, j''ai fait avec des spéculoos rien à redire !', '2010-08-15T17:30:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71873, 5b9ddf8d-1c46-4099-aa36-5e8ed6ea1320, 'C''est délicieux, juste super ! Je vous remercie mille fois pour cette recette.', '2010-05-28T23:35:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71873, b4d7dc44-0a41-4cf9-ade2-57f97b7d8bf2, 'Très bon, mais j''ai mis des spéculos à la place des boudoirs et en ai fait 2 couches pour sucrer un peu le tout, très bon !', '2010-05-25T13:13:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71873, a2cbdbae-3d0f-4ebe-9622-7212eb9978a3, 'Excellent, vite fait et tout le monde aime. Après un bon repas, ce dessert est très léger.', '2010-04-08T11:51:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71873, d376d4a1-4262-42ba-87d4-f1b95571d76c, 'Trop bon ! Pas cher et léger après un bon repas ! Extra ! Bien mettre au frais ! Plait aux petits comme aux grands !', '2009-07-22T00:16:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71873, e505404e-8a2a-4614-8a6c-195c5d972386, 'Très facile à faire, très joli, ça a beaucoup plu à mes invités qui se sont régalés.', '2009-07-04T17:31:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71873, 77f43a04-128d-4db8-90d9-d3065c4019ed, 'Un délice! Dessert rafraîchissant et léger avec des fraises ou des framboises.', '2008-06-29T03:03:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71873, b7574f51-41ee-444d-8be5-510e683b5191, 'Très bon! Mais la prochaine fois je mixerai moins les fraises pour mieux les sentir.', '2008-06-18T22:40:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37130, 44111552-49dd-494f-95d5-c46859ba08df, 'Lait concentré remplacé par crème fraîche. Nappage ajouté. C''est vraiment un délice.', '2017-02-05T21:46:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37130, 12dbba39-5eb1-4ed1-9a88-63dabe922a54, 'J''adopte. J''ai utilisé une pâte brisée toute prête et de la crème fraiche pas allégée. Super super bon. La prochaine fois je prévoirai un nappage. ', '2014-02-25T17:32:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37130, 43055e65-d554-4968-bb64-d4dea9420845, 'Faite dans un moule à bords hauts et avec du kiwi jaune au lieu de kiwi (vert). Savoureux et frais à la fois.', '2011-06-07T22:06:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37130, fb693949-a171-4aba-9804-569efbaf41a0, 'J''ai remplacé la pâte brisée par une pâte feuilletée toute prête (j''étais un peu en retard) et le lait concentré par du fromage blanc. J''ai ajouté un jus de citron dans le mélange. Très bonne cette tarte façon cheese cake, et encore meilleure le lendemain !', '2010-04-25T23:32:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37130, 6a35eaf5-1542-4308-b933-09994ce60f77, 'Cette tarte est vraiment délicieuse et facile à faire!', '2006-06-24T19:39:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37130, 0237c0ab-3417-4943-95d1-779eac488cff, 'C est très simple à réaliser et très bon car il n''y a pas trop d''appareil donc c''est un dessert très léger.  Il mérite tout de même un peu de nappage pour lui donner plus d''esthétisme.  A refaire... ', '2006-04-27T23:17:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 02077671-e25f-4946-814d-794706982968, 'J''adore cette recette. Mais 30 mn de cuisson à 180°C ça suffit pas. A chaque fois je me fais avoir et je rajoute 15 mn ou 25 mn.', '2023-11-05T18:50:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, a143537f-58a4-42df-8951-96d76ad920a4, 'Pas la température du four ', '2022-04-25T19:28:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, c1dea289-23a0-4f60-9d42-92cd5fb8bda8, 'J''ai précuit 10 minutes à 200°C mes tranches de pommes (sous un peu de cassonade) sur la pâte à blanc, puis 30 minutes à la même température avec l''appareil ne contenant que 80 g de sucre (j''ai aussi saupoudré de cassonade avant d''enfourner le tout). Vraiment bonne !', '2022-12-11T14:05:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, fda3b44b-942f-41a0-9dc8-cc1e46538020, 'Ils sont bien gentils mais 30 minute à combien ?!!', '2022-01-31T18:26:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, f7a2c3ab-c3ff-48d7-8db5-3d76b91c95f7, 'Dommage qu’il manque la température du four, mais sinon super recette !', '2022-04-07T17:38:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 3c02aaec-6e71-44fd-bb94-b20da302fd95, 'Super recette ! 
Je vais la faire pour la deuxième fois, la première était un délice !
Pour la cuisson, j’ai fait 40 minutes à 200 degrés 
Super recette, on adore', '2022-02-16T17:16:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, fcaafe57-7402-4488-84d5-aceb4373b8a2, 'Un véritable délice ! Personnellement, j''ai ajouté 50 g de poudre d''amande et quelques pincées de cannelle, oui je suis (très) gourmand :-)', '2022-10-07T15:24:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, d6da743d-9499-42d2-a2b2-79570b5a4ffd, 'Pas de tarte aux pommes alsacienne sans une cuillère à café de cannelle.', '2022-09-18T17:12:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, b675a906-8f70-4b5e-8b41-4e9ceccc8133, 'Très bonne tarte. Je diminuerai légèrement le sucre la prochaine fois. Pour la cuisson, j''ai fait 40 min à 200°C.', '2021-12-05T10:29:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, cc720fa8-9d43-4674-97c8-91b7a4cdd5d8, 'Génial mon frère Coco l''a réussie extrêmement bien.
Recette parfaite ', '2023-05-07T20:47:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 7b8ccd88-7319-42ad-a62b-693e5373a373, 'Très bonne.
J''ai juste réduit la quantité de sucre de moitié.
Tout le monde a adoré.', '2022-12-03T17:42:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 4d6c1881-d1ca-49b8-a940-1b5b33293a71, 'J''ai diminué de moitié la quantité de sucre et ai remplacé la vanille par de la cannelle c''est parfait :)', '2021-11-14T20:12:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, e3eb2643-8fc8-453e-a076-2412374c02fe, 'Super recette! Pas une grande patissière et recette simple à faire. Très beau résultat et très bonne. Juste 80g de sucre et cuisson 45min à 180°. Merci beaucoup.', '2021-05-01T18:13:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 69721248-2cd9-48f1-9bf4-363ef2beff24, 'Cette recette est superbe ;-) tout le monde se régale à chaque fois !! :-) Dommage de lire des commentaires négatifs sur cette recette, bien sûr il faut faire attention aux grammes de sucres pour ceux qui y sont sensibles, pour le reste tout est très simple à faire et n’exige pas 50 min de cuisson comme j’ai pu voir! Il suffit juste de bien vérifier la température de son four et d’avoir les bons ingrédients :-) Bon appétit à tous !', '2018-04-07T04:14:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 9ae0cd4b-4d6c-423f-bd41-23b8f9397047, 'Délicieuse ! J''ai ajouté une fine couche de poudre d''amandes sur le fond de la tarte, cela a donné un bon goût et une belle onctuosité.', '2022-10-09T22:42:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, a58f9808-da5d-4fe1-87d4-4ef9f5cf790f, 'J’ai ajouté de la compote en fond de tarte. J’ai suivi les commentaires et mis 70 g de sucre, mais la prochaine fois je n’en mettrais que 50 g. J’ai ajouté des amandes effilées. Recette facile, peu d’ingrédients et vraiment bonne !', '2022-10-09T17:57:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 05fa6d77-afdf-4064-a89f-24dc338c81f9, 'Rajouter de la cannelle hummm ', '2022-04-01T15:31:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, db467b98-703d-4a11-af5a-32dae0186e4a, 'Facile et delicieuse', '2021-12-12T12:27:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 723b6e55-76ed-4c42-abf0-57449abd7895, 'Facile et très bonne. Pour ma part, je l''ai cuite a 180° pendant 40 mn.', '2018-09-26T21:14:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 404924d5-d87b-417b-9e5c-7f6b45d7c293, 'Délicieux,
un zest de cannel, poudre d''amande et de la vanille fraiche.. .', '2024-01-01T01:53:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 897fe69e-40c4-4c30-a252-2fd1cf11adac, 'Encore meilleure avec une pâte brisée vite faite maison trouvée sur le site ! ', '2023-10-21T14:52:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, ece8aae1-c29b-45b0-8e92-21f210caa963, 'Nous avons utilisé des pommes gala et mis 50g de sucre, mais c’était un peu trop sucré à notre goût. Cuisson 40 min à 180, puis 10 min à 200.', '2023-09-30T17:29:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, de54dbea-b7f6-40c3-a769-6e02cfa08347, 'J''ai variés les fruits après plusieurs tartes réussies en remplaçant les pommes par les mirabelles. Essayer avec de la crème fraîche de brebis c''est délicieux et pratique pour les intolérant au lait de vache.', '2023-07-23T09:05:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 0fc3a372-9d28-4214-b8ab-d10c9e4b6322, 'Super bon ! Petit bonus: la déguster avec une boule de glace et un peu tiède! ', '2023-03-15T18:28:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 8bd51b00-eb28-4bd7-a34a-378229cd2d86, 'Super bonne j’ai ajouté de la cannelle , une pincée de muscade et mis 50 g de sucre.
Délicieuse ', '2023-02-09T17:35:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 11a6f805-defa-4949-823c-09705106f307, 'Très facile mais effectivement avec 50 g de sucre.', '2023-01-03T12:50:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, f61ce466-6e10-480b-ba13-39783139132d, 'Première fois que je réalise cette tarte, excellente. Je conseille de faire la pâte plutôt que de l''acheter toute faite, elle y gagne en saveur. ', '2022-10-11T11:15:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 7af284d4-b4cb-4350-a511-065f82a8efb3, 'Recette très facile de compréhension. Merci Marmiton.', '2022-10-01T22:46:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 16b39e0f-76a0-4bbc-ba4b-465c50ccdf02, 'Parfait mais 70 gr de sucre sont largement suffisant.', '2022-01-30T17:46:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 6d087109-b862-4d72-b480-2c9e1c942155, 'Très bonne et simple, j’ai réduit le sucre à 80g et mis de la crème liquide ', '2021-10-27T16:59:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 2c16af2c-eb7f-419c-a33d-d7d990c28d07, 'Excellente recette que je fais depuis des années ', '2020-10-03T17:09:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 26333bae-5cb4-4616-901d-b6fd180120ef, 'J''ai mis 5 pommes, 3 oeufs, moins de sucre, cuisson 180°C pendant 45/50min et de la cannelle en sortant du four, tarte succulente !', '2019-09-28T22:06:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, c666ee8a-5fa8-4088-9d6e-7d958bfe616a, 'Excellente recette.
Je mets juste un peu moins de sucre.
C''est une valeur sûre.', '2018-09-01T03:13:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 94bc33d4-c51e-4564-9892-867bcf3e1fa1, 'Avec un peu de cannelle <3 super !', '2018-08-15T12:27:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, fd6e74cc-6deb-44c2-af0c-98042b4a2da8, 'La recette est géniale , la tarte est trop bonne! Merci Team marmiton', '2023-10-15T16:36:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, cca010ee-f811-4112-8136-6fc351755a47, 'Elle sent terriblement bon ! J''ai mis des pommes bicolores, juteuses à souhait et sucrées... y''a plus qu''à déguster !', '2023-10-12T20:39:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, aa320a14-472a-4611-96b8-9a5e78ce50fb, 'La meilleure recette de tarte aux pommes de tous les temps ! Je la fais à chaque fois que j''en ai l''occasion et tout le monde se régale. Je ne met que la moitié du sucre (50gr) ce qui est amplement suffisamment. Je sepoudre la tarte de cannelle avant de l''enfourner. Un regal ! ', '2023-10-11T19:19:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, a4c88dd8-27f4-4a00-8bf4-5c52d83ab2e1, 'Délicieux! 50g de sucre était presque trop au final avec les pommes que j''ai utilisées. Même sans les "roses de pommes" et avec 3/4 pommes coupées en lamelles le résultat était vraiment très tres bon. Merci pour cette recette!', '2023-09-10T20:30:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 1a0b7f57-fcf8-4e00-b2a2-bc45eb0ab10c, 'Recette très facile et super bonne. Je mets 70 gr de sucre on peut en mettre seulement 50 gr, J''ajoute un peu de rhum negrita, de l''arôme vanille liquide et des amandes effilées sur le dessus. oh top par contre dans mon four c''est cuisson 1h.', '2023-05-15T19:51:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 5868f35f-2ede-4945-af39-816da20c23bd, 'Plutôt bon mais que des golden certainement meilleurs qu''avec des pommes bicolores. ', '2023-02-12T14:35:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 6ffae67e-f050-4501-baf8-92335ae0f146, 'Vraiment délicieuse 
', '2023-01-25T19:19:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, f2ef5985-0b72-41cb-9f01-b25e564f6592, 'Mon chéri a adoré !!', '2023-01-20T16:29:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, e2c2558b-254a-4316-a055-12abad25ebe8, 'Très sympa, j''ajoute un peu de poudre d''amande par dessus et diminue un peu le sucre.', '2022-12-25T11:44:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 4d088071-dfea-4481-8fe6-bc75473c27ab, 'Trop bonne !', '2022-11-17T16:41:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 1ee1ac19-cdf2-43af-a054-7d9579b2ccfe, 'J’ai adoré ! J’ai suivi les conseils des commentaires et n''ai mis que 50 g de sucre au lieu des 100 g préconisés dans la recette et le dosage était parfait 👌🏻', '2022-11-12T15:56:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 3df53bab-c5d8-47dd-808f-b28de7f21b04, 'Je ne mets que deux sachets de sucre vanillé à la place du sucre et une cuillère à café de mandarine Napoléon ou du Rhum Négrita brun. À vous de juger ! ', '2022-10-23T15:33:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 7eaac9a2-d3d5-404f-a785-789c549ae4fd, 'Très bon mais avec moins de sucre.', '2022-10-22T19:04:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 85de26e7-572f-4abb-ab05-6f2f8555ef50, 'Super recette. 50 g de sucre suffisent. J''ai mis un peu de confiture d''abricots au fond de la pâte. On s''est régalé !', '2022-10-13T21:50:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 72b29991-81f3-463a-8a24-32b8e7bc6ee8, 'Comme indiqué dans la recette, avec plus de pommes un délice.', '2022-09-13T19:56:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 0bb16c9f-7852-499b-8b19-067cc226b650, 'Super, je mets de la crème de soja à la place de la crème fraîche et j’ajoute 3 cuillères de maïzena.', '2022-06-26T01:25:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 792a3657-1d43-4ec2-8380-077350955f21, 'Facile et excellente ', '2022-06-02T19:41:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 784947c6-08cd-4d2b-ae9a-7301eef61044, 'Super recette !🤩🤩', '2022-04-02T16:40:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 08a2c681-e5da-4876-9380-4587da82d6f2, 'Un vrai ❤️ délice bravo ! ', '2022-01-18T18:01:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 0784e67f-ed83-417b-9c91-745553932187, 'J’adore cette tarte je crois que c’est la meilleure que je ai mage de toute ma vie 🥰🥰🥰', '2021-11-03T15:10:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 40d73ba5-7717-42fd-abb1-e817a5fd58aa, 'Même si la recette n''est pas très claire, le résultat est excellent.', '2021-10-06T13:29:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 80a02f42-0bb8-41ff-9878-47c210a06064, 'Excellente tarte, j''ai juste réduit le sucre (70 g). Recette à refaire sans aucun problème. ', '2021-05-16T13:05:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, 904840aa-eebe-47c9-8c79-7400a5dda09c, 'J’adore ! Simple à réaliser et en plus c’est super bon !!! J’ai mis un peu de sucre de canne au-dessus des pommes ! Pépites 🤩🤩🤩', '2021-04-15T21:34:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, ee4bd09b-bd05-4b33-91f0-160fe69b3461, 'Avec un peu de cannelle le goût est encore plus que parfait..
', '2021-04-09T13:55:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, aee52bf9-b318-4ce6-8206-20103418707a, 'La recette est bonne, mais le temps de cuisson indiqué est beaucoup trop court! Au bout de 30 minutes la pâte n''est pas cuite, la préparation encore liquide... sans parler du fait que la température du four n''est même pas indiquée et qu''il faut regarder la vidéo pour le savoir... ', '2021-01-24T21:43:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11457, be7551d9-ed34-46d6-822f-1a06c84339cc, 'La recette n’est pas très bien expliquée et la pâte met du temps à cuire, la tarte à passer presque 50 minutes au four. Malgré l’avoir fait deux fois je suis toujours déçu ', '2021-01-20T17:42:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70807, c14417f3-98cf-4150-8743-401c5e868414, 'Très bon et hyper simple à réaliser ! ', '2021-07-22T22:35:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70807, 35802c23-e1bf-4ada-844a-2ae8adbc0f32, 'Un vrai délice. Tout le monde a adoré.', '2017-05-24T22:29:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70807, e7c8d3e4-acd3-46fe-84bf-16675314d8c0, 'Rien à redire, on s''est jeté dessus et il n''en restait plus !', '2010-06-27T00:17:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70807, 7a8a1453-89d4-429f-b475-967ec7faf8a3, 'Très bon mais on peut mettre moins de sucre et un peu moins de banane car leur goût prédomine.', '2009-09-11T09:13:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70807, 2ee72fc8-da3e-4226-93f7-25e97e77e065, 'Délicieux ! Même avec moins de bananes que le préconise la recette, le goût des 2 fruits est vraiment présent et bien distinct. ', '2009-06-10T18:23:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70807, 4ca5d15b-1024-4021-9478-d31003e09d3f, 'Très bon et rafraîchissant! J''ai juste mis 100 g de sucre de canne au lieu de 150.  ', '2009-04-19T14:22:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, a2580f63-7c8b-4c94-89a9-35b1dad385e1, 'Délicieux ! Le moelleux est parfait ! J’ai remplacé la liqueur de fruits rouges par de l’amaretto. Très bonne recette, merci !', '2019-05-10T07:02:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, 768ade1a-8941-40aa-8673-4123692ed99b, 'Excellent 😋', '2022-06-15T13:32:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, c3ced9f3-aa45-4287-873b-c688ed1bf5c3, 'Excellente recette je mets moins de sucre mais ca cestjuste une question de goût. Je mets du cognac a la place de la liqueur et je mets une framboise fraîche sur le dessus et non à l''intérieur. Cest un pur régal .merci pour la rectte que lon peut décliner à l''infini. ❤❤', '2021-03-20T18:05:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, 942b5544-0ad9-4ef0-b2ff-b473acebd2a9, 'J''ai mis de la vanille liquide à la place, et un peu moins de sucre et aucun sirop/liqueur...  un délice moelleux à souhait pas sec du tout démoulage sans aucunes difficultés !', '2016-02-29T16:38:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, 2dac2c91-05b8-4c7c-bb12-44b965d8d438, 'Pour ne pas avoir à démouler, j''utilise des petits moules à muffin en silicone et des caissettes en papier.', '2013-05-01T19:14:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, d13e88e8-1610-474f-bdf2-a04ecd161574, 'J''ai utilisé cette recette pour faire moitié de muffins aux framboises, et l''autre j''y ai ajouté du chocolat : le résultat est étonnant vu que ceux aux framboises sont très moelleux (ajout d''un peu de lait dans la pâte) et ceux au chocolat sont secs et un peu durs. Ils ont cuit en même temps pourtant. ', '2012-11-26T19:41:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, 8c135592-b596-43b4-886d-d038b3ce2610, 'Excellente recette, bravo. Je voulais juste préciser qu''étant intolérante au gluten, j''ai juste remplacé la farine de blé par de la farine de riz et c''est vrai que j''ai essayé des pépites de chocolat à la place des framboises, c''était sublime. C''est donc une recette de base où l''on peut varier les ingrédients à l''infini. Je mets du sucre complet et des oeufs bios car je suis une puriste, mais quelque soit la façon, merci au créateur de cette recette car elle est vraiment géniale, facile à faire, économique, rapide à cuire, encore plus rapide à manger. En bref que du pur bonheur. merci encore.', '2006-08-02T14:10:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, fad1e51f-37aa-443c-b744-73dca141e1f8, 'Je fais ces muffins dans des moules à muffins grand format que je remplis à ras bord: ça donne des énormes muffins comme chez starbucks, pas trop cuits (20 à 25 min de cuisson), et attention ne pas trop mélanger le mélange des ingrédients solides et liquides, c''est le secret! C''est délicieux!', '2006-01-22T13:15:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, 2a9e705f-8544-4564-a6b4-59c066a19afb, 'Super bon ? ? ? ', '2023-10-31T17:53:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, 9388eb08-fc56-4a02-abfc-f9a54a56e813, 'Très bonne recette. ', '2023-09-12T16:06:46+02:00');
