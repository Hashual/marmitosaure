INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, de93c8dc-e3a8-49d1-b2b2-7e302cd8f76c, 'Recette sympatique, j''ai mis très peu de sucre étant des pommes du supermarché, et le sablé du crumble était très fin (avec 100g de sucre dedans).', '2022-09-16T17:31:08+02:00');
