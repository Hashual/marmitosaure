INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 20b561fa-dc25-4623-8969-2c580357a42a, 'D''une grande simplicité et ça fait le bonheur de la famille.', '2020-01-28T15:58:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 8727bfab-44fc-4773-ae76-2a0e99685cb5, 'Facile et bon !', '2019-08-27T03:07:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 862b8ed9-cda8-4e34-b897-bf261428117d, 'très bonne recette, simple et efficace', '2019-05-17T00:51:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, c310855c-4db6-4435-b43d-2338e172278d, 'Excellente ! A refaire, tellement meilleur que celles achetées en grande surface.', '2018-02-23T11:49:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, e2b5c46b-b07d-44e3-ad61-26a53180bc77, 'Toute simple mais tellement bonne cette recette !', '2018-02-17T07:42:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 45f1bb8c-38e1-4c29-b7d3-5c0541976b85, 'Parfait c''était très très bon. Merci pour le partage de la recette.', '2017-09-25T23:50:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, dc50bcb2-8289-48f1-b634-8be1ef05a402, 'Très bonne recette... et tellement facile à réaliser ! Je confirme que l''idée du Tupperware est aussi excellente.
Merci !', '2017-06-25T10:03:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, c5988af9-4852-4b74-9d6b-b67a68d00f39, 'Enrobées d''huile et remuées au bout de 20 min  fait avec des pomme de terre nouvelles : tres bon', '2017-06-06T00:13:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 603e06ea-e860-488a-b832-55cf8ae6e23a, 'Très bonne idée ! Encore meilleure avec une petite marinade au préalable (huile d''olive + épices ou herbes diverses).', '2016-10-20T14:02:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 334c88a3-75e8-4a77-a52e-b0491cff4349, 'Mon fils aîné m''a demandé quelle marque c''était !!! Tout le monde a adoré, après les avoir faites mariner avec huile d''olive curcuma et herbes...', '2016-10-02T14:23:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, bff18b1d-2472-4a67-bb3a-39814c86403d, 'Super!!! A refaire avec les commentaires des autres, la prochaine fois je fais mariné mais comme ça c''est top aussi merciiii !', '2016-09-13T19:03:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 8ea0158a-8290-4f87-b850-b346bc2aac26, 'Super bon avec une petite sauce aux fromage blanc. ', '2016-07-15T13:03:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, e2e70b20-ec84-4297-8fc5-65c8706f7cc3, 'J''ai épluché les pommes de terre et fait mariner dans de l''huile d''olive avec du thym sel et poivre et c''était très bon.', '2016-05-06T17:47:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 35877373-e39b-4dad-8286-cc98b061fd63, 'Très bon', '2016-04-22T18:08:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 9bf2a6a6-b9fa-4fa8-8974-5bb9edd74ed4, 'Excellent !', '2016-02-17T09:44:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 294c1cf8-39d7-4b77-9b68-ccd39f8310c7, 'Facile rapide et très bon ! ', '2015-12-22T01:34:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, d9c297fb-e266-4248-803c-7a94c1b167b4, 'Super ! Hum.', '2015-11-08T21:52:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, e66ca248-03bb-41c1-97c7-fdc15698bdab, 'Super simple mais qu''est ce que c''est bon ! Un peu de sel, un peu d''huile d''olive avant d''enfourner : un régal !', '2015-09-13T18:38:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 4d4605fc-4669-4cac-850f-e7ce87204110, 'Mis du vin blanc en fond de plat, des lamelles d''oignon pour plus de goût, fait avec filet de julienne frais. Par contre je pense que la prochaine fois ce sera avec une béchamel avec de la muscade, cela liera mieux le plat et apportera plus de goût que la crème fraiche.', '2019-03-30T15:19:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, bb92c32d-444c-48d5-8f7c-84418c9217cc, 'Délicieux ! J''ai mis moitié colin d''alaska et moitié saumon et j''ai précuit les pommes de terre. J''ai rajouté une fine couche de saumon fumé avant la dernière couche de pommes de terre. Vraiment très bon. Le gratin se marie bien avec des carottes', '2020-05-01T11:05:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, f14166a0-561a-4ef2-a1f8-ce8f98ad6a81, 'Rapide, facile et mes enfants adorent ! Ma fille de 7 ans m''en redemande souvent ! ', '2013-02-20T10:53:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 992d41d9-00da-47bf-af34-f010f3151f81, 'Très bien ! facile, rapide et bon. J''ai fait cette recette avec des filets surgelés, dont je n''apprécie pas le goût et je ne savais quoi en faire... J''en rachèterai !', '2012-11-23T14:29:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 70cb4ce7-e4e4-49c2-a360-169e328aba9d, 'Je me suis trompée en faisant la recette. J''ai fait une béchamel au lieu de mettre de la crème. Résultat : excellent, les enfants ont adoré.', '2009-12-01T23:45:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 8d348d91-78f8-4732-8892-c6c20369f65f, 'Rapide, simple et vraiment très bon. Mieux vaut précuire les pommes de terre ... J''ai également fait la recette avec moitié colin / moitié saumon et c''était très réussi. Pour la crème ce n''est pas trop et j''ajoute du gruyère entre les couches !', '2009-11-04T13:03:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, cae52004-2e3d-49be-ab3e-f60a5385d55d, 'Le temps de cuisson est trop juste, ou alors il faut utiliser des pommes de terre précuites avant de découper les lamelles. ', '2023-02-24T20:19:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 83436a38-4344-4c3e-91c9-a2012900551a, 'Délicieux mais trop de crème fraîche à mon goût :)', '2021-04-09T12:45:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, e3bdc784-a4ef-4a88-8143-e4ff76f0990d, 'Très facile avec les ingrédients des placards et très bon. J''ai mis du thon émietté colle poisson et rajouté un oignon coupé en rondelles et tartiné de crème fraîche après avoir mis le persil. ', '2020-08-02T14:10:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 08a1d580-f701-4574-8507-7196ae13007b, 'Fait avec du saumon et du cabillaud, j''ai ajouter quelques herbes aromatiques et des carottes pour donner un peu plus de goût !', '2018-09-10T04:05:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, df5d0954-7746-434a-8571-34dde287ef99, 'Très bon.', '2016-05-09T22:00:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 944c2139-3b05-4b91-a753-ad3d1b27f2c2, 'Pas beaucoup de goût, hélas. Je ne la ferai plus.', '2016-01-10T07:01:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, b2df587c-8cd8-4ce2-8ad2-7c23dea28838, 'Voila vient d’être mangé et très apprécié même de ma fille de 6 ans pas trop poisson ! J''ai précuit les lamelles de pdt a la crème et assaisonné de poivre, sel, muscade et de l''aneth. ', '2016-01-05T18:36:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, aa0fc12d-5627-4b0b-8e5d-fa4520eecab5, 'Le gratin manquait un peu de goût pour ma part. ', '2015-10-30T22:02:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 62c08b3b-8657-4bdd-ad9b-63bd84038d88, 'Fait avec du cabillaud et du haddock. Parfait :) ', '2015-01-29T09:38:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 2c749869-e14c-4d52-8468-46bde72d335b, 'C''est le meilleur moyen que j''ai trouvé pour faire manger du poisson à mon fils de 3 ans... simple et rapide.. en revanche, le goût reste un peu simple pour un plat d''adultes... je mets moins de crème qu''indiqué.', '2014-02-14T16:39:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 7857a85c-c780-45fa-991e-475a99b655de, 'Recette simple mais très bonne... J''ai mis juste un peu de vin blanc. Pour la crème fraîche,c''est la liquide/fluide pas de l''épaisse.', '2013-01-20T21:02:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, e92cd6ca-e495-4742-bcbd-09fa9a5086b6, 'Trouver et changer de menu de jour en jour afin de contenter chaque personne et si possible de les satisfaire gustativement n''est pas chose aisée. Et ce n''est pas avec ce plat que j''ai pu atteindre cet objectif. En effet, rien d''extraordinaire, même plutôt banal !', '2012-09-28T10:14:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, cf0ae879-1a07-4fc0-bf0c-24bee2cd8bf6, 'Très bon ! J''ai fait revenir du colin surgelé dans un court bouillon. J''ai mixé carotte, brocolis, poivron, échalote et oignon. Fait revenir ce mélange dans une poêle avec du vin blanc. Ensuite, j''ai mis le poisson dans un plat ,mis des rondelles de pomme de terres par dessus, ma préparation mixée, j''ai ajouté du vin blanc, de la crème fraiche et du gruyère ! Au four 45 minutes !', '2012-04-04T10:25:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 4d64efe1-8511-459a-ab22-004dde66358c, 'Très facile, j''ai suivi les conseils des internautes.', '2011-09-21T14:25:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 1e6b40fd-d8a5-4b56-9998-9dcfcb551c09, 'Effectivement super simple et très bon... mes enfants ne mangent habituellement pas de poisson mais là, un régal. Une vraie réussite. Merci pour cette recette !! Pour info,j''ai mis crème fraîche et lait pour que ce soit moins sec.', '2011-07-26T19:59:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, c3221d51-ab31-45f4-8bb1-3174215e2899, 'Bonne recette et j''ai suivi l''un ou l''autre conseils : j''ai ajouté des carottes en lamelles, du vin blanc à la place du second pot de crème, du basilic et du poivre. Excellent repas très facile ! ', '2011-06-30T16:22:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, e1a08e1c-56bb-4030-aa34-6f9583e66962, 'Très facile et rapide, mais moi qui aime bien les repas un peu relevé, un peu d''épices ne serait pas du luxe.', '2011-02-14T15:09:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, fcd045d9-093a-4085-ac88-e0339dae1fa2, 'Très bonne recette qui permet de manger du poisson même si on n''est pas trop fan !', '2011-02-05T19:12:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 525b67bb-c4d4-4738-8bad-7e664651cd38, 'Au lieu du court bouillon je l''ai remplacé par du citron !! Huuum et pour la crème fraiche j''ai ajouté un peu de lait car elle était épaisse. J''ai mis des herbes de Provence, du basilic, du sel et du poivre !!! Super bon ', '2010-11-09T20:41:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 2f899f7a-61a3-441a-bffe-d5fac9297ac7, 'Une première pour moi : un régal, pas fade du tout, en accompagnement une salade huile d''olive et vinaigre balsamique un mariage parfait avec le gratin de poisson. Cuisson 1h au micro-ondes fonction gratin.', '2010-10-29T12:53:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 6a04b6da-1beb-4d95-9652-446425ed0de2, 'Bonne recette mais trop sec, meilleur avec du vin blanc dans la crème fraiche... !', '2010-05-25T22:01:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 5037a1e1-684e-43f1-93c5-2f9f79cf1793, 'Fade, fade, fade... Même en ajoutant des carottes et des panais !', '2010-03-29T16:33:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 0ba4d10e-a8a3-442d-98d1-8868ce8fce46, 'Excellent, avec 20 cl de vin blanc, 10 cl de crème et du fumet de poisson. ', '2010-01-31T20:36:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 662adc53-59a5-462e-8f48-a621b740dba7, 'Pour éviter le problème des pommes de terre pas cuites, je les ai précuites 15 minutes à l''eau et les ai coupées ensuite en lamelles. Pour faire un repas complet, j''ai cuit en même temps que le poisson des rondelles de carottes. Ensuite, dans plat four en couches successives- pommes de terre - carottes - poisson - pommes de terre - assaisonnement - crème de soja et fromage. Yesss, les enfants ont mangé du poisson. Merci pour cette recette.', '2008-12-16T15:40:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 4478363d-2b94-4af6-8eb2-f18148ab7da6, 'Super recette j''ai mis 20 cl de crème fraîche et 10 cl de lait. Dans cette crème battue j''ai rajouté un peu de noix de muscade et environ 2 cuillères à café de concentré de tomates ça relève un peu. Après ça cuit tout seul.  ', '2008-12-11T12:29:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, ad75da63-58e7-4616-b85d-d16217c744e6, 'Super, j''ai fait manger du poisson à ma petite famille, tout le monde s''est régalé, merciiiiiii ! Pour la cuisson, 40 min trop juste, les pommes de terre n''étaient pas cuite, il faut compter un peu plus d''1 heure.', '2008-12-01T12:15:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 59352dd4-0a11-4c7a-b617-ea08a4c57051, 'Très bon! J''ai mis un peu de curry dans la crème et un peu de sauce tomate. Délicieux, et en plus cela permet de manger du poisson un peu plus par semaine. J''en ferais sans problème. Merci pour cette recette.', '2008-10-16T18:07:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 15670cfb-e308-44f4-ae7d-44228bb4137b, 'Un délice!!! J''ai rajouté des pavés de saumon, tout émietté, rajouté de la muscade et mélangé avec la crème... j''en salive encore!!', '2008-09-21T17:29:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 97565f5f-d9a5-4b3c-bdff-71f8b598a7d7, 'Je n''avais pas de crème, j''ai remplacé par 2 yaourts nature et du beurre, et c''était très bon et facile. J''avais aussi ajouté un reste de saumon fumé et 1/2 oignon émincé.', '2008-09-15T17:18:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, cf6b6e60-9c98-4636-a5b5-7d185b6df5e9, 'Super bon, pour ma part j''ai fait cuire en papillote 2 pavés de saumon à la poêle, je les ai émietté puis déposés sur les pommes de terres, miam très très bon ...', '2008-08-30T22:24:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, d7a3d0f0-2378-4f4a-ae1b-813f532abbee, 'Un régal, vite fait, a fait l''unanimité chez les grands et les petits', '2008-04-11T20:58:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, b9546161-399e-4658-8dd3-eca2df18af23, 'Très simple et bon!! A refaire!!', '2008-03-05T17:09:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 129e3262-cb2f-4efb-b84e-5c67d6931033, 'Simple, pratique, sans surveillance. Suivre la recette à la lettre, très bon.', '2008-01-18T15:49:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, affc45bc-d96d-4084-9163-232a461e6951, 'Très bon et facile à faire. Idéal accompagné d''une bonne salade verte.', '2007-10-24T15:50:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 76ed8d72-fab9-4abc-933c-6166493dd013, 'Delicieux! J''ai mis une boîte de champignons avec son jus et de la muscade dans la crème (20cl creme liquide, 20cl lait), on a fini le plat à 2 adultes et 2 petits !', '2007-10-05T03:33:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 290fe7f8-6815-4d4c-a80d-d33d11fe1115, 'J''ai réalisé ce gratin avec quelques modifications. J''ai coupé les pommes de terre en rondelles plus fines, mis moitié crème moitié lait, et un peu plus de lait pour marier légèreté et onctuosité. Le temps de cuisson est parfait, avec préchauffage.', '2007-06-05T14:15:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 7e4c87a8-f263-4c8c-998a-e4f937ab26de, 'Merci pour cette recette qui m''a permis de faire manger du poisson à ma fille. Je rajouterais juste un peu plus de crème fraîche, car le poisson était un peu sec.', '2007-05-27T12:18:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, a8cf59bb-c284-459d-ac90-52fa4d164f0e, 'Très bon avec quelques modifications. J''avais peur que les pommes de terre ne soient pas assez cuites ainsi, je les ai donc faites pré-cuire à l''eau bouillante auparavant. Puis 2 x 20 cl de crème fraîche ça me semble beaucoup trop, j''en ai donc mis 1 seul et ai ajouté 10 cl de lait. ', '2007-01-21T21:28:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 56e662aa-3090-4141-ad52-806fe22f984d, 'Très bon avec un peu plus de crème fraîche et un soupçon de noix de muscade, un régal!', '2006-05-29T16:48:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 27f782cf-73ea-487b-9238-0d72736c39c9, 'Génial...facile, rapide et bon. Mes enfants ont adoré! A refaire !', '2006-05-14T15:13:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, f885c582-2d96-4334-8f3a-96ab97adf4da, 'Je viens de me mettre à la cuisine, et c''est l''un des premiers plats que je réalise. Les explications simples m''ont permises d''obtenir un résultat très satisfaisant. En effet, mes amis ont beaucoup apprécié ce plat: ils en ont redemandé même mais malheureusement il n''y en avait plus! La seule différence par rapport à la recette est que j''ai mis du bon poisson frais (du perroquet).', '2006-01-28T09:03:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 2a9faa30-1dcc-4adf-bca3-727497d8d257, 'Ce gratin est un vrai délice et en plus, c''est un repas complet et facile à faire. J''ai rajouté des champignons et pour relever, du fumet de poisson dans la crème fraîche.', '2005-09-25T23:10:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 9b7da687-825d-486e-8c76-6175ef97fbf1, 'Etant cuisinier dans une crèche, j''ai fait cette recette aux enfants et à ma grande joie, les assiettes étaient vides! Merci, je la referai à mes petits copains!!!', '2004-11-20T00:24:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, 3551b7ed-ef43-494c-9027-b9505f196881, 'Ajouter des tomates, c''est encore meilleur!', '2004-09-23T10:15:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17718, f2dfad05-06c6-499c-bfb8-a9fccd8c9a1a, 'C''est pas mal comme recette mais c''est un peu lourd,il faudrait remplacer la crème fraîche par quelque chose de plus léger. Ca manque de légumes.', '2003-05-14T11:14:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57774, 4a2284d3-0ffc-40d7-bb06-3f7c4518ca5d, 'Le mariage des carottes, du poisson (filet de colin), le fromage frais, la bûchette de chèvre, les échalotes ainsi qu''une touche de gruyère râpé, fut un régal pour TOUTE LA FAMILLE.', '2012-10-21T22:20:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57774, a75e5e62-a837-46d5-a41b-9d9739932fc7, 'Je n''ai pas l''habitude de cuisiner du poisson et cette recette est parfaite pour débutant. J''ai mis du fromage de chèvre (bûche) et je me suis régalée ! Pour moi, cette recette est excellente.', '2012-03-15T13:11:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57774, 7213081d-8fea-4af2-b175-579cea41f7db, 'J''y allais à reculons et c''est absolument délicieux !!!', '2011-06-24T00:49:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57774, 27cdeeee-4a82-44ec-aba5-669fe90172d5, 'Très joli plat à la sortie du four et vraiment délicieux. J''ai mis 1/2 fromage de chèvre frais en plus et ajouté du persil. Le seul point "négatif", mais là c''est vraiment subjectif : la texture n''est pas celle qui me plait le plus. Mais je recommande quand même cette recette qui a l''avantage de faire manger aux enfants (qui ont raclé le plat) à la fois du poisson et des légumes.', '2011-03-17T16:03:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57774, 05e839a5-13dd-48bf-86f4-b76e5869f0e0, 'Très bon pour un soir avec du riz car c''est un peu en juste en quantité pour de bon mangeurs.', '2011-03-11T21:00:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57774, 8b728a38-5e2c-4073-a2dd-6b756a9a3caa, 'Facile, très bon, tout le monde aime : les petits, les grands. Merci pour cette recette.', '2009-04-03T13:50:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57774, d402d7bd-3607-4f0c-908d-f608132d2117, 'Excellent, à refaire sans hésiter.', '2009-02-25T21:54:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57774, 9ed72255-3cf4-41ae-9547-b4eb010cde0d, 'Rien à redire, juste à se régaler!!! Merci pour cette recette! ', '2008-06-06T23:38:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57774, ed02e0d6-bcf8-4670-8e22-db1699e673e7, 'Bravo pour cette recette. Nous nous sommes régalés, y compris les réticents du poisson! Nous avons remplacé le thym frais par du basilic. Avec de la brousse allégée, c''est un plat parfaitement diététique et un vrai délice. Merci !', '2007-10-23T11:55:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, d170a58a-b6bf-4514-bf95-9c668593bd00, 'Bon gâteau, j''ai suivi les commentaires précédents, à savoir 150 gr de sucre au lieu de 200 gr, le jus d''un citron dans la pâte et pour le nappage 80 gr de sucre avec le jus de 2 citrons.', '2022-02-28T11:55:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 1d8c991e-0541-4667-a15c-00a6dcec156d, 'Alors c’est la pire recette que j’ai pu essayer. II a trop de farine, le gâteau à failli tuer mes convives. Si vous souhaitez tuer votre belle mere n’hésitez pas à le faire. ', '2023-12-01T22:16:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 11c60d7a-d043-41a0-b975-09d1a5ec9d82, 'J''ai adoré la recette. J''ai mis un jus de citron dans la pâte.', '2024-01-05T15:49:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, fe426c2e-1236-4343-928e-d68d9ea65cf4, 'Gâteau très léger. Moi, j''ai rajouté un jus de citron dans la pâte avant de rajouter les blancs en neige. Ainsi, le goût du citron est bien présent.', '2023-11-19T21:50:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 0ca25ffb-ac09-410e-a5a5-07aa39585ed5, 'Avec un yaourt et moins de beurre +1/3 maïzena et 2/3 farine. dommage que l''option "mon grain de sel" n''existe plus sur Marmiton, c''était bien pratique...', '2023-01-18T18:02:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 1ac073a9-4ccc-4d7c-abc7-ead06529450e, 'Délicieux mais encore meilleur avec 2 citrons et leurs jus à l’intérieur du cake !', '2018-08-15T04:11:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 053d5abe-db11-491d-b49e-fa69489670ae, 'Bonne recette, ne pas hésiter à rajouter des tranches de citron confits.', '2023-12-09T12:35:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, c9508124-0c2b-4ef9-852b-25dbe8ad1c5d, 'Cake au citron testé, mon reproche, c''est trop de farine donc très sec, niveaux zeste de citron pas de goût du citron, j’ai rajouté du jus de citron, mis à part ça, il est bon !!!', '2023-10-31T15:23:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, b5ed93d5-82b0-4e32-959e-0090d4408cd0, 'Une tuerie 😀 Ça fonctionne très bien avec le four solaire !', '2023-01-30T19:14:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, e72ab62d-cbc8-4132-86f1-220003648e2e, 'Bonne recette, mais 200 gramme de sucre c’est beaucoup trop ! J’en ai mit 140 et c’était très bien. Je vous conseille aussi de mettre le jus de citron directement dans la pâte, et d’en rajouter en plus du jus du citron que vous avez utilisé.', '2021-12-20T17:45:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 02cbbaa0-a335-4629-9caa-1c30fbb5becc, 'jai remplacé le beurre par une banane écrasée et un filet d''huile de tournesol et c''était délicieux ! aussi une petite astuces : pour avoir plus de goût de citron frotter les zestes avec le Sucre !', '2023-08-27T19:57:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 0942fa0a-1acb-4272-a00c-146bced9a976, 'Excellent. Si l’on nappe le cake d un sirop de citron, je trouve raisonnable de baisser la quantité de sucre dans kff ère cake, le sirop sucre pas mal en bouche. Il fait équilibrer. C’est mon avis. J ai mis 150 g au lieu de 200 g de sucre. ', '2023-08-20T16:14:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 144fced6-c80b-43fc-b7da-4dd1f8cc2934, 'Super cake ! Meilleure recette que j’ai jamais trouvé avec saveur au citron ! Hyper moelleux et la saveur de citron est juste. Je recommande vivement !!!👍👍', '2023-05-01T21:12:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 1eebe496-be0f-4e0b-af7b-a6ffb6deff0b, 'Très bon ! J''ai suivi les avis des autres et j''ai mis un peu moins de sucre. Le sirop apporte beaucoup de moelleux au cake, à ne pas louper ! J''y avais ajouté quelques feuilles de basilic pendant la cuisson avant de filtrer le tout au chinois.', '2022-08-23T22:29:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, d2ca5e5a-9229-4749-b012-ca2af1599dda, 'Très bonne recette à réaliser, mais pas assez explicite concernant les citrons ! Par ex elle ne spécifie pas qu''il faut les presser avant de les râper', '2022-03-19T19:35:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 5823aa1d-a486-4819-a9b7-ad4f6349dac8, 'Très bon. Un jus de citron dans la pâte et napper de sirop fait avec 80 g de sucre et 2 jus de citron à laisser bien cuire. Pour les amateurs de citron...', '2022-02-20T12:56:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, acd99b88-f3f7-4279-99e9-a9196d74ed39, 'Super bon ! J''ai mis 180 g de sucre et 1/2 (jus) citron dans le cake. Merci.', '2019-09-11T18:39:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 96c53cb0-77da-4c08-bab2-7eede5a050d2, 'Délicieux, j''ai juste mis 150 g de sucre et c''est parfait.', '2019-03-18T11:23:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 212c499e-ad97-4fd8-b474-c4e8f479541a, 'J''ai mis 150 g de sucre et le jus et zeste de 2 citrons pour que ça goûte beaucoup... excellent !', '2018-11-29T10:22:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 19e568a9-fbcd-426a-83ad-62a3b127f55a, '150 gr de sucre suffisent. Par contre je mettrai 2 citrons la prochaine fois.', '2023-10-08T17:51:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, abc6b40d-9307-45e6-9b1e-4f594f84b91e, 'Très bon , simple et rapide .', '2023-07-30T10:40:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 45588c65-4c01-422c-b6c8-0d2e1d6f33b8, 'Recette facile !', '2022-10-16T15:00:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 5c0ccaca-fd33-4d9b-b509-000e56aa9b1f, 'Très bon ! Je n’ai pas mis de citron et j’ai mis des framboises congelés et pépite de chocolat. 5/10min de cuisson supplémentaire. C’était délicieux ', '2022-06-29T20:04:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 5031ade0-82c3-4bbf-9e22-230fc6e08280, 'C''était très bon, parfaitement dosé, nous avons adoré', '2022-02-24T17:12:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, f2c70f9b-02bc-4574-ab50-87cc9b7b26cd, 'J''adore', '2022-02-05T14:26:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 38f03d21-f3ae-4588-ab27-7194f1a2957d, 'Très bien avec seulement 150g de sucre de canne au lieu de 200g. Sans le sirop le cake est rafraîchissant !', '2022-01-30T21:47:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, d9efe6bf-ebdf-4517-93b0-6b4cbbe4828f, 'Top! ', '2022-01-30T14:58:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 4cb1fcde-69d9-4d51-bd77-a9cca43ae149, 'Vraiment très bon par contre je n''ai mis que 150g de sucre et le jus d''un citron vert dans la pâte. Même les enfants ont adoré', '2021-12-04T16:19:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 39583b40-c822-4cd8-a91a-a615303dda7e, 'Ça fait 118g de sucre en poudre !', '2021-11-13T18:03:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, ecea58e8-8179-4718-9188-64c78c5a5267, 'Bonjour, j’ai remplacé le zeste de citron, par des gouttes d’huile essentielles de citron Bergamote au goût fin et subtil.', '2021-08-10T15:05:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, b2305915-809e-4b80-85bd-e6c33eed8618, 'Très bonne recette. Je l''ai un peu modifiée en mettant le zeste de 2 citrons ainsi que le jus d 1 citron, et j''ai remplacé une partie de la farine par des noisettes mixees. Un délice ! ', '2021-05-23T22:18:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, d4ec70e4-efe2-4178-9c74-6264ff229e38, 'Goût très bon mais texture beaucoup trop compacte alors que la recette a été très bien respectée, dommage! ', '2021-03-24T23:22:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 448ce2ba-3ea1-4b5c-9a62-a6b866744ce6, 'J’aime bien faire ce cake il est délicieux et facile à faire ', '2021-01-07T09:00:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 576d3793-7031-4fd1-8913-c10118f39361, 'Excellent ? ', '2021-01-03T13:41:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 02e8503e-677c-4778-ac53-ed032e91801a, 'Facile à reproduire et délicieux !', '2020-12-29T22:32:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 73e23f13-f7e7-4985-b37d-36720c8fdd6d, 'Excellente recette. J’ai du la faire au moins 5 fois! Ma famille l’adore !', '2020-06-15T11:36:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 2adb5279-e206-48f2-8cd3-a1aefb4189eb, 'Excellente !! 😀 Rien à rajouter ', '2020-04-21T15:02:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, d0c25219-fb02-4664-a045-372addf579e5, 'Merci pour cette excellente recette. J’ai compilé les modifications indiquées dans les commentaires. 
Pour la pâte : 150 g sucre seulement, et moitié maïzena moitié farine, le jus d’un citron (un peu moins pour que la pâte ne soit pas trop liquide). Pour le jus : 100 g de sucre et le jus de 2 citrons et un peu plus. J’ai fait des trous partout pour imbiber de façon homogène. 30 min à 180°C. Délicieux !', '2019-12-15T09:45:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 41b2a0db-84ef-4335-8df6-08c9a7c05cf5, 'Très bon cake même sans sirop. J''essaierai de le remplacer par un peu de jus moins sucré. Il est très vite consommé de toutes façons.', '2019-12-14T10:51:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, f5d77d93-7283-4f9b-8cc8-6229af9b7561, 'Excellente recette appréciée par tous !
J''ai tout de même fait quelques petit changements :
Pour le cake: 150 g de sucre 
Pour le sirop : 10 sucres', '2019-05-30T03:45:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 6d13710e-54cf-4bc3-b340-3d68be4056f6, 'Excellant ! Pour ma part j''ai mis 100 g de sucre et 75 g de beurre pour la pâte et 100 g de sucre pour le sirop. Tout le monde a été conquis.', '2019-04-30T18:54:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, af7ea8d2-d54d-4f7b-ae0b-b1eab099353a, 'Excellente recette. J''ai apporté quelques modifications à la recettes : j''ai mis seulement 100 g de sucre + j''ai ajouté le jus d''1 citron directement dans la pâte + zestes de 2 citrons + 1 sachet de levure entier (alsa). Pour la sirop : le jus du deuxième citron.', '2019-04-20T19:50:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 4390ad32-2164-4f3b-b740-42f93f35dd66, 'Top !
', '2019-02-24T07:38:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 4d019d5b-7b44-4c13-b28c-0d784dfcf91f, 'Délicieux pour ceux qui aiment le citron comme moi, je l''ai préparé plusieurs fois et ma famille adore vraiment. (J''ai mis 2 citrons au passage).', '2018-08-13T17:37:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 2b6aa5db-8516-4505-b4d4-9d0ed6cb9342, 'Superbe recette ! J''ai juste mis un peu moins de sucre (150g), et ajouté un peu de jus de citron dans la pâte avant cuisson comme le conseillent certains commentaires et c''est délicieux ! Un gâteau bien moelleux comme on les aime !', '2018-07-09T05:30:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 533a3059-9417-4b73-90b5-52db7403a625, 'Délicieux cake moelleux. J''ai retiré un peu de sucre question de goût. Pour le glaçage, j''ai mis 40 g de sucre glace et le jus d''un citron. ', '2015-10-07T13:11:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 5b1290c8-bc53-4c95-bbec-1d96b4e523f3, 'Très bonne recette, pour ma part fait avec farine de blé complete et parfumé au kirsch, excellent ', '2023-11-04T17:41:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 0812b299-7079-4214-bf06-018992141130, 'Super recette ! Tout le monde a adoré ce cake délicieux !!!', '2023-05-17T05:24:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 21bc147c-276b-4703-b649-dc7c8ad46643, 'Excellent. ', '2023-05-12T11:48:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 6e453adf-8ae2-4229-ad70-526aef3aeeb8, 'Excellent !', '2023-04-12T06:29:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, e43944fa-e5ce-4b35-b489-a1a9d6424cb7, 'Très facile à préparer et délicieux à déguster. ', '2023-03-31T17:32:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 0bdcbbe9-fe2f-448d-ba6b-9ea16d6aeb53, 'Excellent, moelleux, miam un délice! Mais sucré!

', '2023-03-09T21:56:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, aba701e6-fa0d-4e76-97f5-66ea1a9c1fd5, 'Très bonne recette, le gâteau est léger et super bon !', '2023-03-07T21:07:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 32ad5099-d209-4194-a200-bb291e17eacb, 'Super bon.  Très facile 
Très réussi 🙃', '2023-03-03T07:24:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 27889621-1248-403b-b339-e00814b0fbef, 'Simple, efficace… et surtout excellent.. je recommande!', '2023-02-22T19:06:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 3ec474d4-b543-4ed6-a331-315bdff777c0, 'Le cake est bon mais le sirop le rend beaucoup trop sucré. Je réduirai la quantité de sucre dans le sirop la prochaine fois.', '2022-12-22T18:22:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, c0d4e1dc-3e40-43d4-ab7d-06bcd895de2b, 'Très bon, juste un peu trop sucré ', '2022-07-09T10:12:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 5a023715-6b0b-4143-8326-f09da584a061, 'Une excellente recette, je gagne du temps et le résultat est identique en battant les œufs en omelette ! Temps de cuisson à revoir 40/45 m, th 200', '2022-06-19T08:12:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 2378d5fd-0b30-4e2f-a7d2-48b08b0b7559, 'C’est la meilleure recette de cake au citron! Facile et très bon! Il suffit de suivre la recette à la lettre.', '2022-05-07T19:32:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 29b8cf43-e4e2-48b6-8f32-e3b0777bd84b, 'Super cake ma famille a adoré mon père veut que j''en refasse et ma mère en a repris', '2022-02-18T17:07:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 37dadc3b-34d6-46d0-a193-377254d004d7, 'Très bon, facile et rapide à préparer. Nous avons tous adorés. Fait avec poireaux et pommes de terre, du curcuma, délicieux. ', '2022-10-28T14:50:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 48b09f2e-cc0f-4538-9e4e-16d65238d996, 'Pas très savoureux.', '2016-06-04T14:58:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, cab5297e-90bf-41cd-b89d-c45256d4a16a, 'J''ai ajouté 1/2 carotte et 1 pomme de terre, légumes tous précuits et revenus ensuite dans l''huile. Très agréable à manger !', '2016-03-24T18:06:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, d7dafb74-cf0b-4ec6-ae2b-bc4e9c7e6c1a, 'Très bonne recette. J''ai rajouté des pommes de terre entre les poireaux et les filets de poisson. Le tout servi avec une salade verte. Et, comme épice j''ai mis : curcuma et curry. ', '2015-11-08T14:39:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 2f5f4794-fa26-4bbf-89a2-db237be52111, 'C''est très bon !', '2015-01-14T12:15:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, b88624da-90f3-4f45-9c22-4f828f27e5da, 'Très bon, mais prévoir le double pour deux personnes. N''ayant pas d''autres poireaux, j''ai comblé avec des 3 bonnes carottes et des champignons de Paris émincés (environ 200 g) que j''ai fait cuire en même temps que les poireaux et franchement on s''est régalé ma copine et moi (elle en a même redemandé alors qu''elle n''aime pas trop les poireaux). ', '2013-05-28T01:32:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 3cef4cfd-8525-40cb-8e97-ceccf190a012, 'Super trop bon !!!!', '2013-04-16T17:46:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 8dda2380-5b87-4f27-9773-b22dd23753db, 'J''ai adoré ! Et en plus, c''est simple à réaliser. Petit bémol : la quantité de crème prévue dans la recette est trop optimiste pour couvrir la préparation.', '2012-05-26T00:33:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 8f4e35ca-24ef-41b1-a9f6-675f14c6a52b, 'Très bon ! J''ai cuit les poireaux et des pommes de terre à l''eau bouillante salée avant de les faire revenir dans l''huile et la crème.', '2011-07-04T14:48:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, bf5e1b79-d310-478c-a4c7-88bed811e015, 'Ça y est ! Je l''ai enfin faite cette recette sauf que ce n''était plus la saison des poireaux... Donc j''ai fait la recette à la lettre en les remplaçant par des endives et c''était excellent ! Je referai au bon moment pour les poireaux la prochaine fois. Merci pour cette bonne recette !', '2011-05-12T23:40:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, a35173ff-b141-4648-a13e-f63047702ec5, 'Très très bon ! J''ai ajouté carottes et pommes de terre râpés en gros morceau et c''était un régal ! Vite préparé, vite dévoré ! Je garde la recette pour la mettre dans mes "classiques"', '2011-04-22T22:09:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, d2bc83ff-182b-4c19-a82a-9385a3fcdb88, 'Super recette pour ceux qui aiment le poisson, les poireaux,... mais n''ont pas d''idées pour les cuisiner ensemble ! Je n''ai pas mis de chapelure, mais c''est tout de même délicieux.', '2010-03-13T15:46:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 9babd467-296a-4367-979d-723e559c50b1, 'Super bon ! J''ai aussi remplacé la chapelure par du picodon en lamelles car je n''en avais pas sous la main. Un vrai délice. J''ai aussi mis de la crème 3%. J''ai eu peur quand j''ai vu l''eau que ça rendait en fin de cuisson mais au final, ça n''a pas gâché la recette (j''ai enlevé un peu de liquide avant tout de même...). Merci ! ', '2009-11-14T15:13:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 03162509-5ab9-4218-a14f-f720372aa815, 'J ai adoré! J ai remplacé l''échalote par un oignon. J ai ajouté une tomate et du paprika. Tout simplement exquis avec du cabillaud et 20 min au four!', '2009-10-31T16:02:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 1e0ff890-a278-461f-8e8b-8280ff65c532, 'Simple et efficace!', '2009-01-09T22:08:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 2a49341e-e18c-4e41-b4d4-586364deee62, 'J''ai suivi la recette en choisissant du curry. J''adore: c''est une façon très pratique de profiter de l''excellente association entre poisson blanc et poireaux.', '2008-12-15T10:40:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, f9b8bdad-18fe-4b15-9e6d-a30a7dc47b21, 'Génial! J''ai moi aussi ajouté une carotte grossièrement râpée par personne, ainsi qu''une demi dose de safran : exquis! Merci!', '2008-10-22T01:50:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, ecd4cb17-78cb-4d55-9154-c0b05a28cf4e, 'Très bonne recette, facile à préparer et tout le monde a adoré! Même ma fille de 4 ans fâchée avec les légumes...', '2008-09-17T13:33:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 456842e9-c274-4a75-bbd5-3f2238d907cd, 'Très bon, j''ai également rajouté des carottes râpées gros avec les poireaux et oignons, tout le monde s''est régalé !', '2008-03-19T21:05:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 5054b348-044b-4e6e-9cc8-1ee4a8933ea3, 'Franchement! C''est épatant, pas long à préparer! Merci, nous nous sommes régalés, recette que je garde sous le coude!', '2008-02-27T18:53:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 3bb8a792-20f1-4b73-9c48-e35644ada43d, 'C''est exquis! J''ai rajouté des carottes râpées avec le poireau et l''échalote.', '2008-02-01T14:17:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 7421f831-d5ef-42de-95e5-4e1f9299b8cd, 'Excellent. ', '2007-06-25T17:36:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 30214f69-4bc9-438b-b003-5493280fb96d, 'Excellent! Je le fais dans des ramequins individuels et je rajoute de la chapelure dessus. Ça fait des minis gratins.', '2007-03-04T15:58:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, b52e8ccf-ec67-44d4-b823-3f91a2149960, 'Délicieux et ça change. ', '2007-02-24T18:08:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 2865c2a7-56c9-466f-b0e6-cd1011d94ace, 'Recette rapide et excellente. Le plus : une cuisson du poisson ''à l''étuvée'' sous les légumes qui le rend moelleux à souhait. ', '2007-01-05T15:54:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, fb31bc8e-51b6-43d3-b6b8-87e4ae99f3c4, 'Facile, vite fais et très bon, y''a rien à dire de plus!', '2006-05-17T19:58:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, b5aa3121-8c39-42bc-8aa6-ea41d3963d84, 'C''est très bon et léger, j''ai utilisé des dos de cabillaud et j''ai servi avec du riz sauvage. ', '2006-01-06T20:06:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 92d1a16c-fb75-40c6-a409-67253cb7d46b, 'Très bon, et facile à faire. Rien à redire.', '2005-12-14T11:11:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 2028d366-754c-4f1a-89f2-1e7a90fb641b, 'Recette vite faite, simple et excellente. Je ne savais pas que les poireaux pouvaient donner un aussi bon goût!!!! A refaire.', '2005-10-27T16:56:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, d584bffc-d2a9-4b73-9f94-38a43910d15c, 'Super recette. J''ai utilise du Curry comme épice et c''était très bien. Je l''ai présenté dans des ramequins individuels (attention temps de cuisson un peu plus court) et ca a fait de l''effet!', '2005-10-13T01:51:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, e47dc0a9-5aa3-4d3e-b976-19d4e3f6d55c, 'Je suis une nulle en cuisine et bien mon ami était ravi. Alors merci.', '2005-09-11T17:15:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 00f2bfd8-9d1d-4c45-8f83-2f529415eca7, 'Je l''ai fait avec du curry et j''ai mis un peu moins de poireaux et c''est tout simplement délicieux !!', '2005-05-15T16:06:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, c9ca9c5d-bc27-4882-934d-ab58044b8d5a, 'Un régal, les gens se sont tous resservis!', '2005-02-21T14:20:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 659b2861-c650-4b41-807f-1acb5b60ce76, 'Mmmmm, simple et bon, parfait pour un soir de semaine. J''ai remplacé le curry par de la moutarde. Merci pour cette recette !', '2005-01-08T21:40:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, bf9514ca-1997-4e8c-8161-ff00e71e0cf0, 'Merci pour cette recette, je viens de finir et c''était très bon!!', '2004-11-22T22:19:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29466, 97ee5d18-ec1a-4a77-b919-acc8ac2ef643, 'Très bon. Pour 2 personnes, j''ai utilisé 3 poireaux, 30 cl de crème et au lieu de mettre de la chapelure, j''ai mis 1/2 crottin de chavignol en lamelles.', '2004-06-01T12:20:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528917, 9b485394-ffae-4488-8e73-afb942ed478a, 'Trop bon', '2023-09-30T00:17:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82624, bfe023f9-0c2c-4e0e-a83d-8b0c77ab1b2e, 'Très bien.', '2016-10-09T13:16:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82624, 2b4cc0dc-11ac-45dd-962c-0fcf15965293, 'Nous n''avons pas du tout aimé en suivant exactement les indications. Le fond est trempé, le poisson est fade. Je pense qu''il faut décongeler aussi le poisson et faire fondre l''échalote !!!!', '2015-01-23T20:29:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82624, 3d1e708e-5712-4515-840f-1b578e7b59ca, 'Excellente recette !!! Je n''avais pas d''épinards donc j''ai mis une sauce tomate et nous nous sommes régalés !!! Merci pour cette recette ! ', '2014-06-26T18:36:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82624, 30a08f4f-50d2-4a69-bbfe-50d1a069bea1, 'Vraiment délicieux ! J''ai remplacé le cabillaud par du saumon : encore plus tip top ! Avec une pâte feuilletée, on a d''autant plus l''effet du chausson. Bravo pour cette recette !', '2013-02-13T15:58:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82624, b1594415-91b2-45df-b56a-1feb0ea6099b, 'Très bon ! Fait en tourte parfait...juste pas pratique à la découpe donc privilégier le chausson. ', '2012-06-16T14:17:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82624, f4d01c17-ef9f-4bbf-b91f-d5189d36d685, 'Super facile, super bon, je vais passer la recette à des amis !', '2012-02-18T10:59:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82624, 67b16fae-578f-443b-b671-5ad63b81ec1b, 'Excellent, j''ai mis du fromage ciboulette/échalote car j''avais déjà fait une recette la veille avec du chèvre, tout simplement succulent... Super idée ces chaussons...', '2012-02-13T22:20:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82624, 6a10d69b-6188-4cfe-9c9e-adeb738ed28a, 'J''ajoute une bonne pincée de 4 épices dans les épinards, cela relève bien le plat!', '2010-01-19T19:31:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82624, 73f2dd5a-eb68-4296-8611-0883c14521bd, 'Nous avons adoré ! Pratique pour le soir, tout en un !', '2009-05-20T11:35:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82624, b0125a52-7000-486e-a1d9-1d0d283a5961, 'Bon mais ça manquait un peu de goût. Peut-être faudrait-il ajouter une herbe genre aneth qui va bien avec le poisson. Sinon je n''avais pas mis assez de chèvre dedans.', '2008-11-07T11:52:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, fd9c67d9-b06b-4771-9030-61f6c5afa2ab, 'Excellent ! merci pour cette recette que j''ai un peu modifié en mettant de la pâte de curry rouge (1c. à soupe) et de la purée de piment rouge (2c. a café). J''ai aussi ajouté 1 carotte coupée en copeaux à l''économe en même temps que les tomates. et j''ai ajouté des gambas et queues d''écrevisses (cuits a part) au poisson. Servi avec riz parfumé (thaï) cuit vapeur a l''autocuiseur. c''était le top !!', '2013-01-17T17:33:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, e4a9bb0a-8782-40bd-acbc-46b8350d884d, 'Excellent !', '2024-02-27T00:46:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, a0fb28e8-7808-4a46-b8fd-eb91fc9715f5, 'C''était excellent.', '2019-07-15T12:21:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, bb717aa8-3ee3-4a59-baad-892b74509564, 'Testé ce week end. J''ai mis dos de cabillaud et haddock qui s''accorde parfaitement avec le lait de coco. Pas de pré-cuisson du poisson taillé en gros morceaux et jeté dans le mélange pour les dernières minutes de cuisson. Attention, pas besoin de saler si on utilise du haddock. J''ai acheté de la crème de coco plutôt que du lait. La sauce est onctueuse ... Cette recette est un délice rapide et goûteuse ..... Je la referai souvent.', '2017-01-10T08:21:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 915607af-b2ae-4582-8e26-cca064da13c5, 'Excellent ! j''ajouterai quelques précisions au niveau des dosages : - citron vert : le jus de 1 citron vert - lait de coco : 500 ml - mettre un peu plus de curry que de curcuma (2 pour 1).  ', '2016-01-31T15:41:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 09ae5be2-860a-4b2f-98bf-fbaf371dc35b, 'Excellent. Goût relevé. J''ai mis comme épices un mélange tout prêt de "Colombo". Extra ! ', '2015-09-16T08:32:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 8aea08a7-df06-4501-be65-f6baa202cdd5, 'Très bonne recette. Merci !', '2014-11-02T14:48:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, c0c0b502-8c1f-4db5-9dfd-84ddeb998e71, 'Toute la famille a bien aimé servi avec un riz basmati. Je n''ai pas mis de poivron vert et gingembre, ni citron vert. J''ai remplacé le poivron rouge par des poivrons piquillos en bocal coupés en lanières. J''ai mis du gingembre en poudre. Très bien épicé. Je referai avec des invités la prochaine fois et du citron vert !', '2014-10-02T00:49:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, d018dd42-c714-42fe-818c-4a248e194e00, 'Extra ! A la place du poivron, j''ai ajouté de la courgette et quelques épices sur le dos de cabillaud (ail, herbes de Provence et échalote). Je recommande vivement !  ', '2014-09-24T23:29:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 4950b2fe-120f-4fd1-8420-438ac5cf224d, 'On a adoré !!   Pour le poisson, j''ai mis du cabillaud: cuit à la vapeur à part et ajouté à la fin de cuisson de la sauce avec le jus qu''il a rendu. Comme je n''avais pas de curry, j''ai mis des feuilles séchées de curry. Pour le gingembre, c''était en poudre, et le piment, c''était du doux. J''ai ajouté de l''ail en poudre en plus des 2 gousses. J''ai mis une bonne quantité de chaque épice. Et comme ça à déjà été dit, il ne faut pas hésiter à bien saler, car sinon c''est trop fade. Une fois bien salé, c''est un régal ! Hop ! Direct dans mon cahier de recette !', '2014-07-18T21:55:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, f01bbced-6a00-44a8-9367-65d294a961fa, 'Très déçue, personne n''a apprécié, le goût de coco est trop prononcé et la sauce est archive-fade, bref je ne la referai plus.', '2014-07-14T10:52:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, c346fa8e-9333-40b9-8eb6-a327e817e237, 'C''était trop bon ! Cela a eu beaucoup de succès ! J''ai mélangé un peu avec la recette :curry de poisson; c''est une recette à refaire !', '2014-04-25T18:58:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, af44539e-da6b-4bb7-ba0b-83d074231af0, 'Merci, très bon, très parfumé', '2014-03-24T21:12:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, c50351d2-f83f-4705-981d-2a5eb8c2e476, 'Vraiment très très bon.   ', '2014-03-16T16:50:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 08106b12-1158-49cd-b34f-f40df4e4eeab, 'Recette excellente testée et retestée plusieurs fois. Moi je sers en accompagnement des bananes rôties à la poêle, salées, poivrées et sous poudrées de piments d''Espelette au moment de servir ! C''est excellent ! ', '2013-10-25T17:55:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 9ff271fe-b82e-40e0-9bec-b2fd87ea2a54, 'J''ai adoré cette recette.  Un vrai délice', '2013-10-17T18:09:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 4a95115a-22b7-4a30-a507-c90ff839777d, 'Bonne recette originale. J''ai par contre dû improviser n''ayant ni poivrons, ni citrons vert (remplacé par du citron jaune). Le goût du citron était peut-être du coup un peu trop prononcé. ', '2013-01-26T21:01:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 06397ad8-c9df-4cb2-b5c5-1fd7295a849e, 'Je sors de table, j''y serais bien restée car cette recette est délicieuse, je dirais même divine. Qui l''a inventée ? Je l''ai faite avec de la corvina (poisson a chair blanche bien connu en Espagne et excellent). J''ai suivi la recette à la lettre, c’était bien relevé par le curry et le piment sèche, mais vraiment c’était delicieux. A refaire et à refaire.', '2012-12-18T00:41:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 46a8fcb1-f22d-400d-b2cc-185bcee888c5, 'Simple, rapide et bon. Pour ma part, je mettrais plutôt le jus d''un 1/2 citron. C''était un peu acide. J''ai donc rajouté un peu de sucre. Tout le monde s''est régalé. Merci', '2012-04-15T20:28:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, f89ec030-8f00-4ea8-a593-b22d312310e4, 'Fabuleux, j''ai suivi exactement la recette sauf pour la cuisson du poisson: cuisson directe (filets de saumon) dans la poêle, 12 min. Recette à faire absolument.', '2011-12-21T00:46:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, f0570632-1cf2-453a-ba46-cf104979ef52, 'Juste génial, merci !', '2011-11-23T19:07:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 45fcc6ef-0e53-479c-8ca9-4c812e266189, 'Très bien mais je n''ai pas cuit le poisson (pangasius) avant mais juste cuit dans la sauce les 10 dernières minutes. Le choix du curry importe ', '2011-11-20T19:20:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, c143e85d-6e55-4083-8adb-6379fd3dd9a1, 'Très savoureux. Il faudrait dire le poids de gingembre, un beau morceau c''est trop vague. Moi j''ai forcé sur le volume, résultat "ça arrachait" ! Mais à refaire.', '2011-10-02T22:18:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 317c207b-325c-4818-bcab-d68b5ff6a8b1, 'Recette très rapide et très simple, à tester absolument. Moi je l''ai faite avec du Colin...tout le monde a adoré !', '2011-09-03T11:53:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, ee3ac290-db1c-4215-863c-49bd6e9554ab, 'Excellent plat. Attention à saler correctement. Cuire le poisson au four avec de l''huile d''olive par dessus, puis rajouter dans le wok. Mettre de la coriandre.', '2010-11-25T13:05:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 3342c965-2c4e-4e48-9160-de7c31dc05c4, 'Recette pleine de senteur et de saveur. Je l''ai réalisé avec des darnes de cabillaud et les invités ont trouvé cela très bon.', '2009-03-29T20:47:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 548c7bdc-792c-4af3-a6db-2b625ebfcc6b, 'Excellente recette pleine de saveurs. Comme poisson, j''ai utilisé du pangasius qui garde une bonne consistance après cuisson. Par contre, je ne l''ai pas précuit. Et comme poivrons, j''ai utilisé un rouge et un jaune (question de goût) et c''était vraiment très bon. A conseiller!!!', '2009-03-18T17:23:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 52323616-f0cf-49b8-84eb-5d33236cd92b, 'Parfait, fait avec de la lingue, prévoir mini 150 g par tête, une pincée de cumin et curcuma, bonnes proportions, bien pour 5 personnes (voire 6). ', '2008-12-08T14:07:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 7b91034c-9f46-4b5d-a0ee-883ae3c50a5c, 'Bien bon et simple. Je l''ai fait avec des pavés de saumon, je n''avais pas de gingembre donc je n''en ai pas mis, et j''ai eu la main un peu lourde sur le citron vert. Effectivement, ne pas hésiter à forcer sur les épices pour bien relever...', '2008-10-14T23:34:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, d198686f-3e20-4260-b57e-b34742072911, 'Délicieux, mes invités ont tous aimé ! Je l''ai fait avec des dos de cabillaud que j''ai fait pré-cuire au four avant de les mettre à finir de cuire dans la sauce. Ils se sont un peu effrités mais le plat était tout de même très présentable.', '2008-06-05T23:35:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 035d1c4c-535b-4125-aba6-87e0e39b1c91, 'Bon. Je conseille de prendre des filets de poisson (cabillaud ou saumon), de les faire cuire en entier sur les deux faces puis de les couper en morceaux et de les ajouter tout à la fin à la préparation. Autrement, si le poisson est cuit déjà coupé, il s’effrite. Par ailleurs, à la place du gingembre frais, j’ai mis ½ ccuillère à café de gingembre moulu et c’était très bien. Le jus de citron vert a correspondu à 6 cuillères soupe et c’était très bien aussi. Je conseille de prendre du riz rond en accompagnement pour qu’il absorbe bien le jus du plat (qui comporte pas mal de sauce!). Je mettrais également de la coriandre en feuille soit dans la préparation (à ajouter tout à la fin, avant de servir) soit dans une coupelle à part pour que ceux qui aiment puissent se servir. Bien saler le plat autrement cela paraît fade!', '2006-06-11T16:55:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 134d56d2-02a3-454c-a7db-dad6f889d04b, 'Très très bon, ne pas hésiter à mettre plus de curry, épices...pour que le goût soit très relevé. Vous pouvez même préparer la sauce et faire revenir le poisson à l''avance, puis tout réchauffer 10 min avant de servir. (le poisson sera cuit parfaitement)', '2006-04-03T17:17:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 06103538-a24d-4bab-8b03-e36646f3e9d5, 'Très bon, le mélange de saveurs est assez subtil. Je n''ai mis qu''un citron et c''était bien assez!', '2006-03-22T21:45:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44090, 71ada034-f2a0-40a5-b597-f95d8a13bb2a, 'Cette recette est tout simplement superbe : excellente au goût, simple et rapide à faire. J''ai mis du curry en bonne proportion mais je n''avais pas de lait de coco que j''ai remplacé par de la crème fraîche liquide, ajoutée seulement 2 à 3 minutes avant la fin de cuisson. Je l''ai bien sur servi avec du riz. Je compte en refaire souvent et cette fois-ci avec du lait de coco!', '2006-01-27T23:59:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (372829, 64e0cf5b-1c5b-4ef2-b9fa-f8e93a21398d, 'Très bon et original ! j''ai ajouté un peu de ketchup et sauce burger.', '2022-07-08T11:20:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37209, 44cde66f-c580-4c6e-b520-7496f2f2ab64, 'Super simple à faire. J''ai suivi les conseils et rajouter du fromage râpé. Top !', '2017-02-22T20:42:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37209, b124ada0-0e9e-48b7-bc05-9bfe7675d80f, 'A refaire ! Vite faite ! Pratique lorsqu''on rentre tard.', '2015-02-02T21:14:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37209, 8800024b-bbe0-4cb7-924f-ddc4aa06a08b, 'C''était très bon, à refaire, j''ai ajouté du gruyère râpé, à refaire !!!', '2014-12-18T21:24:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37209, b586ab49-e022-4dab-9ea0-aafebd508460, 'Excellent... On en redemande...', '2013-03-07T14:06:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37209, ea0ed9e1-354b-4451-bae2-80b0eb033dac, 'J''ai mis une ratatouille maison et du gruyère sur le dessus pour faire gratiner c''était délicieux.', '2011-01-24T21:56:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37209, 9a7c2218-ba06-4f5c-8da7-62906f4a54b1, 'Rien à redire. ', '2009-08-26T20:47:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37209, c9f14f4f-4355-4cb9-8dc5-5df980610e86, 'Cette recette est très bien mais encore mieux avec une bonne ratatouille fraîche.', '2006-09-02T19:11:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37209, d9662233-6b13-4407-b049-38dab9714cad, 'Quelle bonne recette. Fait avec ratatouille maison. Merci.', '2006-07-27T21:40:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37209, 4d5bf860-52a0-4868-b8c2-92e522cc2643, 'Simple, rapide et bon!', '2005-11-20T20:07:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20240, 3874b0c4-34ba-4e3e-969f-941a36606bea, 'Délicieux et léger en entrée ou plat de résistance le soir avec une salade...j''ai nappé les tranches servies avec une sauce crème au paprika...tout le monde a adoré. Merci pour cette recette.', '2014-12-31T00:35:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20240, 1fcec009-f71c-4567-be67-b886c0a736e4, 'Excellente. Je mets aussi 3 poignées de julienne de légumes congelée, ce qui permet d''avoir des légumes avec le poisson. Mon fils de 3 ans adore!', '2006-03-08T12:50:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20240, 56901ca6-3ea7-4b4c-bce2-886b542164a2, 'Excellente ', '2021-06-30T22:20:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20240, 0b4bf861-26bc-404f-a056-01ac67860d94, 'Deuxième fois que je le fais est toujours un vrai délice... Merci pour cette recette facile et rapide', '2015-05-09T19:21:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20240, 89715565-3ca6-4848-9310-9bb1b71e1ebc, 'Rapide et facile à préparer. Délicieux avec de l''aneth à la place du persil.', '2010-01-03T11:40:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20240, 0a62a435-8d7f-4da9-80ab-c0061c69b1ab, 'Recette plusieurs fois testée toujours sans persil. C''est très bon.', '2009-07-08T12:11:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20240, f10450ea-afb3-4431-93e5-7c0346ffaf84, 'Excellent. Je l''ai essayé chaud avec une sauce bisque de homard, crème fraîche et ciboulette. Un régal', '2008-03-20T19:25:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20240, 7e188264-23e2-4763-af9f-5e86682c1405, 'Très bon : j''ai utilisé du thon et du saumon fumé. Mes invités ont beaucoup aimé.', '2008-03-03T13:12:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20240, c1be9123-63f6-4768-a883-f697c26a9dd8, 'Très bon, très rapide et simple à réaliser. Par contre pour la cuisson, c''était un peu juste : il faut bien compter 45 min à 1 h.', '2005-01-25T13:09:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20240, 82881da6-f9b2-4062-af92-442539dc4a61, 'Excellent, enfin une recette à base de poissons, très facile et très rapide qui plaît à toute la famille: à refaire, m''a-t-on dit!!!', '2004-06-09T15:35:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20240, 6e950ff2-2ea1-4d88-8a90-93fc42538fff, 'Un plat très rapide et très simple à préparer. Attention à ne pas trop saler car avec le court bouillon, ce n''est pas nécessaire. Idéal pour un dîner sur le pouce, et puis, c''est une autre façon d''apprécier le poisson.', '2003-08-07T18:40:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20240, 63fb2b62-061a-4b75-b1b0-ef5e082cb2f5, 'Recette un peu salée à mon goût, mais bien qu''elle tienne plus de l''omelette soufflée que du pain, elle est délicieuse, facile à faire, rapide... Bref, à essayer absolument! Très pratique pour employer des restes de poissons. On peut avantageusement remplacer le sel par du fumet de poisson, à raison d''une cuillère à soupe rase.', '2003-03-01T19:13:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, c8ec8e53-5960-4832-827c-b51e50bb091e, 'Bonjour très bonne recette, j''ai juste rajouté poireaux, carotte et en poisson: Lotte et cabillaud et crevettes !', '2018-03-01T13:54:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, fd98a121-848d-417d-bd16-3997387e821c, 'Recette facile et très bonne, réalisée avec du congre (le morceau était gros, faire cuire un peu plus longtemps).
J''ai suivi les conseils et ajouté poireaux et carottes, miam miam !', '2024-01-06T10:59:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, c1805ef2-2d98-419d-84bb-f22d5648580a, 'Très bon 
J’ai rajouté quelques carottes et de l’ail ', '2023-03-19T08:56:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 3874297d-11ef-4860-b7d7-3d39ca1ef62e, 'Délicieux.', '2018-12-05T18:53:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, b77ea240-635e-465a-8b16-d97bb4ae38bc, 'Très bon ! J''ai réalisé la recette avec du cabillaud et remplacé les champignons par des poireaux que j''ai fait revenir avec un oignon. Je n''ai pour ma part pas fariné le poisson et c''était délicieux accompagné de riz. A faire !', '2018-08-01T14:24:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 516b9cfb-5a9b-402a-adec-5f4796fa2a68, 'Délicieuse recette, à tester absolument ! ', '2023-11-20T11:23:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 748b6aac-ca31-4cab-8fc8-6e2979e47594, 'Pas trop fan du poisson mais j''ai aimé !', '2022-11-07T16:16:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 5caae418-69ff-4c14-b1c0-c2bd86184f33, 'Blanquette qui fait l''unanimité. Je rajoute des carottes , plus de crème et de vins blanc que je laisse mijoter environ 45 minutes et je met le poisson à la fin', '2020-04-26T22:56:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, e5874b10-eb0b-4c7a-a140-eebd7c33b207, 'Excellent. Tout le monde a aimé. J''ai doublé les doses pour la sauce et ajouté des carottes et des poireaux coupées en petits dés.', '2019-05-21T09:46:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 80153f28-f350-4056-bd08-c4f22a89c281, 'Rapide, facile, délicieux... Je la réalise régulièrement et on ne s''en lasse pas !', '2019-01-19T10:05:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, aeffc22e-8a88-44dd-a53a-8691f087167c, 'Très bon, réalisé sans vin blanc! ', '2018-05-28T09:40:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 10c241ef-2aab-442f-baef-47b2a8bb56a0, 'Bon, mais je pense aussi que la prochaine fois, je ne farinerai pas les poissons.', '2018-03-01T23:02:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, f6fcca82-77d0-4a19-aba7-96b955b266d7, 'J''ai fait cette recette ce midi, très bonne, j''ai ajouté une carotte et un blanc de poireau, c''était délicieux ainsi que quelques crevettes que j''avais fait revenir à la poêle avec un peu de piment doux pour plus de goût. Bien faire réduire le vin blanc et je conseille de cuire les rondelles de carottes à part avant de les mettre dans la blanquette si vous souhaitez en mettre bien-sûr!', '2017-01-02T19:01:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 3f7023ae-c13b-449b-8984-6928c413723f, 'Fait avec du poireau et du fromage frais pour alléger la recette, c''est parfait !', '2023-11-27T12:47:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, e50a384b-9ecf-4129-9379-a225c4117a1b, 'Délicieux j''ai rajouté des carottes super bon et facile à faire ', '2023-10-02T20:54:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 699d0564-3407-45db-bcd6-f904cd85c810, 'Très bon, j’ai rajouté mes verts de poireaux finement émincés et du basilic !
', '2023-09-28T08:37:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, c87f3a1d-f9fe-4db3-875c-ce16205375a1, 'Très bonne recette et facile à réaliser. Pour cause d''intolérance au lactose je l''ai réalisé avec de la sauce de soja et c''était goûteux.', '2022-11-04T19:04:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 4c3eda77-340c-41d2-852e-3cdbfbf55a93, 'J’ai ajouté  des rondelles de carottes ! Super bon ! ', '2022-10-18T21:19:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 94b97cdb-5b17-479e-8301-6409ae7c6bd2, 'Recette très facile à faire. Toutefois, la prochaine fois, j''ajouterai des câpres pour réhausser le goût du poisson.', '2022-09-16T13:10:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 10a7b072-3e1d-45f4-91ed-19b899700332, 'Facile à réaliser, très bon. J''ai rajouté 1/2 chorizo doux et fait avec du dos de lieu noir. À refaire !', '2022-06-19T19:35:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 9ef191c1-a460-4ddb-8a46-25b607e4c674, 'Très bon et rapide 
', '2022-01-16T20:00:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 118f671e-86f2-43e4-b8d4-ad910be76775, 'Super. J''ai suivi les conseils des autres : ajouter carottes et des crevettes. Un avis cependant : 20mn de cuisson, même très doux, après l''incorporation du poisson, se sont révélés excessifs ; le poisson s''était délité. ', '2021-03-26T13:23:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 50fa1697-0756-468d-a3f5-4185deb201c9, 'Délicieux ! J''ai utilisé des darnes de cabillaud et des champignons frais. Un régal ! Merci.', '2021-02-04T19:21:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, f48c4abb-2f4c-4446-9467-8cd63c11c1a1, 'Super recette. Merci. Pensez à rajouter un peu de vin blanc.', '2020-01-19T11:27:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, f976c5e5-1cd5-497f-b8c9-8d339fed0443, 'Recette faite ce midi, très bonne. J''ai salé un peu plus et ajouté du gingembre et un filet de citron car trop fade servi avec du riz créole c''est super !', '2019-12-04T14:43:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 80c02930-89e7-4f9d-9ffd-ad8fc8765ccd, 'Très facile à réaliser et succès garantie !', '2018-10-07T14:12:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, dd69af21-f2f8-4334-8d7d-693471a2b1b7, 'Excellente recette! Merci!!! J''ai mélangé 2 sortes de poissons (pangasius et saumon que j''avais dans mon congélateur) et y ai ajouté quelques scampis, ail et gingembre aussi. Tout le monde s''est régalé ! Encore merci !', '2018-04-09T09:45:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 69658417-5409-4c59-85d5-49b54a593bbd, 'C''est très bon. Pas de champignons mais des poireaux et carottes et augmenté le liquide avec de l''eau pour faire plus de sauce. Lieu et pavé de saumon ont cuit 10 mn. Merci', '2018-02-16T02:41:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 979c80fe-7265-4ef2-82e2-c7b2bc0b7970, 'Rapide, facile, et bon j''ai ajouté quelques petites noix de st jacques (mise sur la fin pour ne pas qu''elles soient trop cuites) c''était super !', '2017-05-08T14:06:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 82120035-b54e-4130-99da-807fb20936e1, 'Bonne recette ! C''était ma première expérience de blanquette de poisson et nous avons aimé. Seule remarque; 20 min de cuisson une fois le poisson ajouté c''est bien le temps à respecter je pense. Ne faites pas comme  moi ! Ayant un petit peu oublié la cocotte sur le feu (peut être 30 min) même à tout petit bouillon le poisson était bien sûr trop cuit.', '2016-06-13T23:28:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, aa7ed929-d411-478c-8c7d-3d85357404d0, 'Bon plat. J''ai ajouté avec les filets de cabillaud,  des pavés de saumon, du lieu et des crevettes avec deux cuillères de maïzena pour lier la sauce. Un régal ! ', '2016-01-07T22:55:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 669ca4e0-8ef3-43a7-8cce-1fd29bd4fc47, 'J''ai suivi les commentaires, j''ai mis deux blancs de poireau et deux carottes et ajouté le poisson en morceaux (un filet de cabillaud et un de truite)  15 min avant la fin. A refaire', '2015-11-18T20:12:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, ab421c44-a183-4f5f-8770-8179c09077f5, 'Très bon plat. Cependant, il est préférable d''assaisonner le poisson avec un peu de sel et de poivre et le faire dorer légèrement dans du beurre, avant de commencer la cuisson des oignons et autres légumes éventuels. Les morceaux de poisson dorés donnent plus d''allure au plat et le rendent moins triste. Parsemer de persil et servir avec des morceaux de pomme de terre bouillis. Miam !', '2015-10-14T22:35:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, e3baa278-e128-4a1c-8e08-7e008b2238d0, 'Je l''ai faite pour la première fois hier soir alors que nous étions dix et a priori tout le monde s''est régalé. J''ai mis comme poisson de la julienne et du saumon car cela me faisait moins cher et que j''aime tout simplement ces poissons !!! Ce fût une vrai révélation pour tout le monde, a conserver.', '2013-07-21T17:40:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 7da22bcb-5ffa-4acd-9f14-bf14f937a56a, 'Nickel, on m''en redemande. Merci.', '2013-04-10T11:04:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 37ded1aa-008c-446c-9a4f-8aee52fc3a7c, 'Très bonne recette! Une façon simple de cuisiner le poisson. ', '2009-10-09T23:12:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 96f58fec-eae5-442b-bda5-d205ef2d23e0, 'Très bonne! Pas fans de poisson à la maison mais cette recette nous donne envie d’en remanger! 
Ici on sert la blanquette avec du riz😊', '2023-10-10T18:51:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 3ae01e82-8e06-4f4a-aee1-1d19254a1383, 'Je vais là cuisiner merci ', '2023-09-20T16:08:25+02:00');
