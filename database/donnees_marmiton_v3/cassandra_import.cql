INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (88247, 'Tourbillon de passion, bananes et spéculoos', 'fruit de la passion, fromage blanc, spéculoos, banane, sucre', '30 min', ['Mettez le sorbet dans un saladier pour le faire ramollir.', 'Pendant ce temps, réduisez les speculoos en miettes (pour ne rien perdre, versez-les dans un sac de congélation et fermez-le avant d''écraser les biscuits avec un rouleau à pâtisserie ou, à défaut, une bouteille en verre).', 'Une fois le sorbet mou, ajoutez-y le fromage blanc (et le sucre si vous en mettez).', 'Remuez bien le tout.', 'Versez la préparation dans le bol du mixeur et ajoutez-y les bananes coupées en lamelles.', 'Mixez le mélange pendant quelques minutes et laissez-le reposer dans le réfrigérateur 2h au minimum.', 'Servez ce tourbillon bien frais avec des biscuits et régalez-vous !'], ['Couteau de chef', 'Spatule', 'Louche'], ['entrée', 'banane', 'Tourbillon de passion', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'spéculoos', 'cuisine', 'bananes et spéculoos', 'recettes', 'speculoos', 'boisson', 'fromage blanc', 'fruit de la passion', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:26:33.115543', [{'ingredient_id': 'd17fe7b0-34ad-4b74-b07b-43314668aa48', 'quantite': '50 cl'}, {'ingredient_id': '0e3dfbf0-b440-41c2-8519-c5443f2a7225', 'quantite': '30 cl'}, {'ingredient_id': '05d2a1e5-f0ae-4b80-bba5-f90b5c8abca5', 'quantite': '250 g'}, {'ingredient_id': '73c05733-c8f9-4eef-864c-b7dd22bb1435', 'quantite': '2'}, {'ingredient_id': '27f0d467-97d0-4034-9431-5841e27495d2', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (337307, 'Muffins banane-chocolat-pralin', 'oeuf, beurre, crème fraîche liquide, farine, sucre en poudre, levure chimique, banane, chocolat, pralin, sel', '10 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Faire fondre le beurre. ', 'Dans un saladier, mélanger la farine le sucre et la levure. ', 'Faire un puits et y ajouter les oeufs, le beurre fondu et la crème fraîche.', 'Bien mélanger jusqu''à obtention d''une pâte homogène.', 'Ajouter les pépites de chocolat et le pralin. ', 'Bien mélanger.', 'Couper la banane en petit dés (pas trop fin pour qu''ils ne s''écrasent pas lorsque vous les mélangerez à la pâte). Les ajouter à la pâte et mélanger doucement.', 'Remplir les moules à muffins au 3/4.', 'Mettre au four pendant environ 15 min (le temps peu varier de quelques min selon le type de four).', 'Sortir du four et laisser refroidir.', 'Démouler les muffins.', 'Déguster.'], ['Fouet', 'Moule à tarte', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'chocolat', 'Muffins banane-chocolat-pralin', 'facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'pralin', 'farine', 'dessert', 'plat de résistance', 'muffin', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:26:36.837776', [{'ingredient_id': 'c4bd6eb2-be9f-4954-b1a4-702876cdaea5', 'quantite': '2'}, {'ingredient_id': '5f5f7f30-be28-4706-8d7f-cbfe187a1187', 'quantite': '50 g'}, {'ingredient_id': '0ff2de94-98ca-48c4-abff-3435c79823ba', 'quantite': '20 cl'}, {'ingredient_id': '887bb76d-d2d4-408e-9925-85476153df18', 'quantite': '10 cuillères'}, {'ingredient_id': 'f1b432e0-3ce7-44fb-9626-6ba31f8660fa', 'quantite': '8 cuillères'}, {'ingredient_id': '445aa308-c07d-4624-b361-ea83765385db', 'quantite': '1'}, {'ingredient_id': 'c00b7fb4-f8ec-47cb-ab6b-ca8665bef7c0', 'quantite': '1'}, {'ingredient_id': '022d570a-6f52-4b57-b675-c7746fd730be', 'quantite': '100 g'}, {'ingredient_id': 'c5d7c2ae-7bc6-43e9-ad41-b6242e6e20a4', 'quantite': '100 g'}, {'ingredient_id': 'be40ffb9-b6da-499f-8572-7f512b86e259', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33770, 'Mon smoothie à San Francisco', 'banane, orange, framboises, myrtilles, fraises, lait de soja, gingembre, cannelle', '2 min', ['Mettez le tout dans un blender et laissez quelques secondes afin d''obtenir une jolie émulsion.'], ['Casserole', 'Balance de cuisine', 'Fouet', 'Louche', 'Mixeur'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'framboises', 'bon marché', 'rapide', 'plat', 'myrtilles', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'orange', 'lait de soja', 'cannelle', 'smoothies', 'Mon smoothie à San Francisco', 'cocktail'], 'Boisson', 272802c8-70bc-4bd0-bbca-c6da6a9be441, '2025-09-26T16:26:40.474452', [{'ingredient_id': '966e622b-3bf9-4e1b-82c5-b22754eebc8d', 'quantite': '1'}, {'ingredient_id': 'a569800d-b429-4db0-92d5-2063f06fab01', 'quantite': '1'}, {'ingredient_id': '72a437de-002c-46f4-bf96-5f4a2c01f9bf', 'quantite': '1'}, {'ingredient_id': '6b0e5570-642a-4947-b3aa-b4006068c7a1', 'quantite': ''}, {'ingredient_id': 'c418ed83-2382-4487-9d59-35df2a52880d', 'quantite': ''}, {'ingredient_id': 'c6822a17-8e25-4bc0-af53-a2d407d7847a', 'quantite': '20 cl'}, {'ingredient_id': 'b51de977-f555-4823-93f8-22c2d646c707', 'quantite': '1'}, {'ingredient_id': '3d076b92-0778-45ca-a4ed-e514b2426967', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (305069, 'Banane au jambon et lait de coco', 'banane, jambon, lait de coco, crème fraîche épaisse, gruyère râpé, sel, poivre', '10 min', ['Mélangez la crème et le lait de coco et étalez la moitié de la crème dans un plat à gratin.', 'Enroulez les 4 tranches de jambon autour des 4 bananes en enroulant 1 tranche de jambon autour d''1 banane à chaque fois et dressez dans le plat.', 'Nappez le plat avec le reste de crème coco, salez, poivrez et parsemez à votre convenance de gruyère râpé.', 'Enfournez au four à 180°C (thermostat 6) et laissez bien gratiner.'], ['Casserole', 'Économe'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche épaisse', 'jambon', 'sel', 'confiserie', 'testées', 'Banane au jambon et lait de coco', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'gruyère râpé', 'dessert', 'plat de résistance', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:26:44.114273', [{'ingredient_id': '054df0f5-4dfc-43ec-a1c9-ad3ce4273189', 'quantite': '4'}, {'ingredient_id': 'e6a8957e-40cb-45c2-aff0-a7e5d2ffd081', 'quantite': '4'}, {'ingredient_id': '7bdd77e7-26a2-4600-be10-20ca499b1cb8', 'quantite': '20 cl'}, {'ingredient_id': 'f302c754-23bf-4a73-94b6-cb0edc8fc8c2', 'quantite': '20 cl'}, {'ingredient_id': '8d76f5bb-d935-49ab-80c9-7d4951a82d2c', 'quantite': '50 g'}, {'ingredient_id': 'e98e46bd-063b-4568-a3f6-35168d55549f', 'quantite': ''}, {'ingredient_id': '7e48d129-e428-4c42-95bc-2174ea29ba50', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (307596, 'Tarte choco-bananes de Titi', 'chocolat noir, beurre, lait, crème, oeuf, banane, citron, beurre, sucre, jaune d''oeuf, eau, farine', '30 min', ['Couper le beurre en morceaux et le mélanger en l’émiettant entre les doigts avec la farine. Blanchir le jaune d’œuf avec le sucre en le délayant avec l’eau. L’ajouter à la farine et modeler une boule. Ajouter de l’eau ou de la farine au besoin.', 'Étaler dans un plat à tarte sur du papier sulfurisé et cuire à blanc durant 15 minutes à 180°C (thermostat 6).', 'Dans une casserole, porter à ébullition, le lait, la crème et le beurre. ', 'Verser cette préparation sur le chocolat préalablement coupé en morceaux dans un saladier et mêler le tout avec un fouet jusqu’à ce que le chocolat soit complètement fondu. Ajouter les œufs et mélanger.', 'Verser l’appareil sur votre fond de tarte et cuire à feu doux, 160°C, pendant 10 minutes. ', 'Couper la banane en fine rondelle, frotter le citron sur chaque face et les disposer sur la tarte. Servir avec une pointe de chantilly.', 'Vous pouvez également les détailler à l’emporte pièce. (photos jointes)'], ['Planche à découper', 'Passoire', 'Verre doseur', 'Batteur électrique', 'Presse-agrumes'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'oeuf', 'plat', 'tarte à la banane', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'moyen', 'beurre', 'Tarte choco-bananes de Titi', 'lait', 'cocktail'], 'Dessert', d62ab5e2-e37a-454f-8e38-6d8afa22ebd2, '2025-09-26T16:26:48.745003', [{'ingredient_id': '51d3e8ae-1465-469f-9dc7-12d8dc3e20a7', 'quantite': '125 g'}, {'ingredient_id': '21d9f468-3361-4329-953b-a5966ae5eec2', 'quantite': '15 g'}, {'ingredient_id': 'e9380483-50e3-49d1-b5dd-16b99292edb8', 'quantite': '20 cl'}, {'ingredient_id': '33736ddc-35e0-4a9c-b86f-634838b34dd2', 'quantite': '20 cl'}, {'ingredient_id': '28c61c6d-e589-4811-89e7-ce5b9f6c49a4', 'quantite': '2'}, {'ingredient_id': 'e38920a7-e447-4e27-99c8-eb946032fde7', 'quantite': '1'}, {'ingredient_id': 'd631d6a4-a948-4949-86ac-7717dec1bc39', 'quantite': ''}, {'ingredient_id': '1094e5ea-bc1b-442c-a277-c23f66b9acbc', 'quantite': '125 g'}, {'ingredient_id': 'e79da643-2998-4a81-8e86-bb37425cd710', 'quantite': '80 g'}, {'ingredient_id': 'cbbb9af5-612c-4802-9014-d393dc74a9c5', 'quantite': '1'}, {'ingredient_id': '785a851b-697e-43e2-b793-2ec8fdd17dc2', 'quantite': '5 cl'}, {'ingredient_id': '52b99f1f-973c-44b8-a974-6ff6573207ff', 'quantite': '280 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72723, 'crumble multifruits', 'framboises, banane, pomme, beurre, cassonade, amandes en poudre, farine', '20 min', ['préchauffer le four à 210°, thermostat 7.', 'Dans un plat à tarte en grès ou céramique, couper en rondelles et étaler les bananes, puis les pommes en petits quartiers. Parsemer les framboises par dessus.', 'Dans un saladier, mélanger la farine, la cassonade et la poudre d''amande.', 'Ajouter le beurre coupé en dés et mélanger avec les doigts: on doit arriver à un genre de pâte sablée.', 'Saupoudrer ce mélange sur toute la surface du plat et mettre au four 20 min.', 'La pâte du dessus doit être dorée et croustillante .'], ['Rouleau à pâtisserie', 'Râpe', 'Pince de cuisine', 'Couteau de chef', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'très facile', 'framboises', 'bon marché', 'amandes en poudre', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'crumble multifruits', 'pomme', 'autres crumbles', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:26:52.384130', [{'ingredient_id': '26c777a9-ffaa-4cef-8696-7d9650f9d74e', 'quantite': '500 g'}, {'ingredient_id': '9cd304ee-881e-4a87-965b-f0714e4bc825', 'quantite': '2'}, {'ingredient_id': '250ff04c-9245-4236-856b-6184bb264d8f', 'quantite': '2'}, {'ingredient_id': '8223cbcf-9a88-49da-bca7-55af252c804b', 'quantite': '100 g'}, {'ingredient_id': 'd2e82259-8d3f-48f3-9fb5-974bcebf07e0', 'quantite': '100 g'}, {'ingredient_id': 'f1996869-2fbc-4856-b004-d53d188bc420', 'quantite': '70 g'}, {'ingredient_id': 'f85754e6-adfe-4e47-82a3-db30a239872b', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50945, 'Crumble de mélanie', 'pomme, banane, poire, cannelle, sucre vanillé, miel liquide, beurre, jus de citron, cassonade, farine, beurre', '35 min', ['Eplucher tous les fruits, les couper en morceau (pas très gros).', 'Faire d''abord revenir les pommes dans une poêle avec 2 noix de beurre, au bout de 5-6 min ajouter les poires puis en dernier les bananes.', 'Faire revenir le tout en ajoutant le jus de citron, la cannelle, le sucre vanillé et le miel liquide.', 'Pendant ce temps préparer la pâte sablée : mettre dans un saladier la farine, la cassonade et le beurre fondu, mélanger à la main de préférence de façon à former une boule de pâte (si elle s''éffrite un peu c''est normal car il faudra l''éffriter pour le crumble).', 'Une fois les fruits cuits (ne pas les faires dorer, il faut juste qu''ils soient cuit), beurrer un moule carré de préférence ou 6 petits moules.', 'Y introduire les fruits puis émietter la pâte sablée dessus de façon à les recouvrir.', 'Enfourner à four chaud (180°C - thermostat 6) pendant 30 min environ de façon à ce que la pâte dore légèrement.'], ['Verre doseur', 'Râpe', 'Casserole', 'Presse-agrumes', 'Économe'], ['miel liquide', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'poire', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'jus de citron', 'autres crumbles', 'beurre', 'cannelle', 'cocktail', 'Crumble de mélanie'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:26:56.049085', [{'ingredient_id': '9f4aa6bd-4381-4a27-a5ac-7f8fe6d8e55f', 'quantite': '3'}, {'ingredient_id': '08efcd94-d1ca-45e7-91f3-2dc78251a247', 'quantite': '2'}, {'ingredient_id': '6355fd31-a8bb-4f1e-b88d-7a4fe4c0123f', 'quantite': '2'}, {'ingredient_id': '282c77e4-d7c3-4168-8e80-9e28b06f4685', 'quantite': '2 cuillères'}, {'ingredient_id': '53551709-65bd-4400-b5eb-4456779d71bd', 'quantite': '2'}, {'ingredient_id': '4a8e8f80-15e5-45a4-a980-a0f7b23e89b3', 'quantite': '1 cuillères'}, {'ingredient_id': '5106563e-b8aa-4f95-abd8-f65f4d4ead42', 'quantite': '2'}, {'ingredient_id': '8beb2ff5-97db-4746-8d54-f90b0e3836cf', 'quantite': ''}, {'ingredient_id': '284ffd48-7382-46c3-af08-ad43ab6bba60', 'quantite': '250 g'}, {'ingredient_id': '8c720f9a-74d1-4a5e-a53d-2222f593e7cf', 'quantite': '150 g'}, {'ingredient_id': 'e9a19b9d-0fb9-4a07-820e-0c44c691c323', 'quantite': '125 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42459, 'Punch délicieux', 'rhum, jus de banane, goyave, jus d''ananas, jus d''orange, jus de citron, vanille, sirop de sucre de canne, vanille, poivre', '10 min', ['Dans une cocotte, versez tous les ingrédients. ', 'Fermez le couvercle, et laissez macérer pendant 12 h... ça n''en sera que meilleur! ', 'Si vous n''avez pas le temps de le laisser macérer, ce n''est pas grave : il sera délicieux quand même!'], ['Louche', 'Rouleau à pâtisserie', 'Couteau de chef', 'Tire-bouchon'], ['sirop de sucre de canne', 'entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'assez cher', 'goyave', 'très facile', 'rapide', 'plat', 'jus de banane', 'recette', 'cuisine', 'Punch délicieux', 'recettes', 'boisson', 'vanille', 'punch', 'dessert', 'plat de résistance', 'jus d''ananas', 'jus de citron', 'jus d''orange', 'poivre', 'cocktail'], 'Boisson', 7140332d-5c63-4432-8259-50b5e24ef7ae, '2025-09-26T16:27:02.625582', [{'ingredient_id': 'a09e5f1d-62c9-4d11-8d50-08701691c968', 'quantite': '1 l'}, {'ingredient_id': '7904b6af-4c01-4424-ba3e-8256c33200cc', 'quantite': '1 l'}, {'ingredient_id': '9427bc02-c790-47e7-b9ff-1d1fde6696bb', 'quantite': '1 l'}, {'ingredient_id': 'ef34c267-aacb-423c-b22c-5dea07c127c2', 'quantite': '1 l'}, {'ingredient_id': 'fd1db031-119a-4498-a43a-48011fb0350f', 'quantite': '1 l'}, {'ingredient_id': '69c5f2f4-0c8f-4096-b2f8-c39c9d262458', 'quantite': '1'}, {'ingredient_id': '1bcab176-d9f4-4406-86c2-510bf92116be', 'quantite': '1'}, {'ingredient_id': '092c7cd8-edb6-4f02-bb60-25ddeefa91f4', 'quantite': '2'}, {'ingredient_id': '5e9e741f-947c-4669-9613-ace98952e2b2', 'quantite': '4 cuillères'}, {'ingredient_id': '729070c5-d4a8-4265-84b4-81420bef2034', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61889, 'Gâteau banane et amande', 'yaourt nature, yaourt, yaourt, yaourt, yaourt, oeuf, banane, sucre vanillé, levure chimique', '15 min', ['Préchauffer le four à 200°C (thermostat 6-7).', 'Ecraser les bananes dans un saladier, ajouter les oeufs battus puis le sucre, la farine, la poudre d''amande, l''huile, la levure, et le sucre vanillé et le yaourt. ', 'Bien mélanger.', 'Verser cette préparation dans un moule à manquer beurré et fariné.', 'Enfourner pour 30 minutes de cuisson environ.'], ['Casserole', 'Passoire', 'Râpe', 'Pince de cuisine', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'levure chimique', 'yaourt nature', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'gâteau à la banane', 'Gâteau banane et amande', 'cocktail'], 'Dessert', f9871d99-ab79-432b-9dc8-ad8c6d80f89b, '2025-09-26T16:27:06.250551', [{'ingredient_id': '8b9e8082-d539-4554-aa83-6ab0b9ae855a', 'quantite': '1'}, {'ingredient_id': '34f86e4b-fc2c-4f07-9304-1f7ca27bf01f', 'quantite': '2'}, {'ingredient_id': '528643d7-7a4a-4fe0-9bc6-802a99e0a716', 'quantite': '1'}, {'ingredient_id': 'a630c05a-c9fb-495b-8e55-d93bf6b088ba', 'quantite': '1'}, {'ingredient_id': 'a70b33a1-0ae9-456c-8012-6d91154834eb', 'quantite': ''}, {'ingredient_id': '344c336e-eb1d-4d79-a22a-d19549990fce', 'quantite': '2'}, {'ingredient_id': 'b3afc574-da9b-4380-8698-6afd025b6ad4', 'quantite': '2'}, {'ingredient_id': '1ebedba9-4b99-4cd7-a837-c259c690e40a', 'quantite': '1'}, {'ingredient_id': 'a5535171-6960-42b9-927d-6b617284d87a', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (334457, 'La salade de fruits exotiques', 'grenade, litchi, ananas, mangue, orange, banane, groseilles, citron', '60 min', ['Prenez votre grenade, coupez-la en deux puis en quatre. Égrainez-la. (Cette opération peut durer un certain temps ...)', 'Réservez ces graines dans un petit bol.', 'Enlevez la coque des litchis et le noyau puis coupez la chair de chacun en quatre ou en huit (comme vous le voulez). Réservez aussi dans un petit bol.', 'Ôtez le chapeau et l''écorce de l''ananas puis découpez en petits dés. Réservez.', 'Prenez votre mangue et enlevez-y la peau. Découpez d''abord autour du noyau puis coupez la chair obtenue en petits dés. Réservez.', 'Épluchez l''écorce de l''orange, prenez vos quartiers puis coupez en petits dés. Réservez.', 'Enlevez la peau des bananes et découpez-les en rondelles.', 'Lavez vos groseilles et réservez les petites boules.', 'Dans un grand saladier, versez tous les ingrédients et pressez le demi-citron.', 'Bon appétit !'], ['Râpe', 'Passoire', 'Rouleau à pâtisserie', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'groseilles', 'dessert', 'plat de résistance', 'moyen', 'citron', 'orange', 'ananas', 'salade de fruits exotiques', 'litchi', 'cocktail', 'grenade', 'La salade de fruits exotiques'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:27:11.420447', [{'ingredient_id': '65e16fe2-7dc7-458e-86a8-226504c9a892', 'quantite': '1'}, {'ingredient_id': 'f6f71196-bc7d-4bb9-b201-35b9e445cdd4', 'quantite': '20'}, {'ingredient_id': '37e0e552-9ea5-4f95-aa4f-03ca9dd186b2', 'quantite': '1'}, {'ingredient_id': '9a44d306-339a-4551-b95f-a50b81b6f79c', 'quantite': '1'}, {'ingredient_id': 'd72c6d8a-51c0-4daa-b403-76f0c5c1d446', 'quantite': '1'}, {'ingredient_id': '6435f394-fbb4-477d-94e3-dc33907f2744', 'quantite': '2'}, {'ingredient_id': 'f5d204f3-32a3-4649-8782-011e4fa91f28', 'quantite': '125 g'}, {'ingredient_id': '1e6bf806-5f8f-4661-aa38-8a3668644da3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (340455, 'Force Dix - la pâte de fruits qui affronte la tempête', 'banane, pâte de dattes, crème de marrons, banane, farine, miel', '40 min', ['Émincer les bananes séchées en fines lamelles avec une bonne dose de patience. Les mélanger avec les bananes fraîches écrasées, laisser une nuit à température ambiante.', 'A feu vif dans une casserole délayer la pâte de dattes dans le miel et mélanger pour éviter de trop caraméliser, environ 8 min - 12 min.', 'Hors du feu délayer cette pâte avec la moitié de la crème de marrons, laisser refroidir.', 'Reprendre le mélange de bananes, verser dans le bol du mixeur: mixer à pleine vitesse pour ne plus avoir de morceaux.', 'Ajouter la farine dans le mixeur et mixer à nouveau.', 'Ajouter le mélange à la pâte de dattes (pas trop chaud), mixer.', 'Utiliser la 2e moitié de la crème de marrons pour "délayer" le reste de pâte collée à la casserole, l''incorporer au reste du mélange et mixer jusqu''à homogénéisation finale.', 'Aplatir la pâte entre deux feuilles de cuisson antiadhésives, entre 1 et 1,5 cm d''épaisseur.', 'Garder la pâte entre les feuilles pour cuire au four 30 min à 130°C.', 'Après cuisson laisser tiédir, puis retirer la feuille du dessus pour découper la plaque de gâteau en petites portions de 15 par 30 mm, ou 20 par 40.'], ['Râpe', 'Mixeur', 'Fouet'], ['crème de marrons', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'Force Dix - la pâte de fruits qui affronte la tempête', 'testées', 'bon marché', 'plat', 'moyenne', 'recette', 'pâtes de fruits', 'cuisine', 'miel', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'cocktail', 'pâte de dattes'], 'Confiserie', f9e4db68-6c57-4d48-bf02-1b00915675fa, '2025-09-26T16:27:16.542801', [{'ingredient_id': '9ab07aa6-ee87-4451-8531-92089ee4f2a3', 'quantite': '200 g'}, {'ingredient_id': '0ec14f42-ce43-4d0d-9411-e39fcffe5efb', 'quantite': '300 g'}, {'ingredient_id': 'f5c4f759-316d-4e2c-9c8f-6e26b0cbc990', 'quantite': '500 g'}, {'ingredient_id': 'a448af1b-550e-4cfd-8da4-cf5c7b4baf34', 'quantite': '2'}, {'ingredient_id': 'c89ef1da-faec-40c9-a6f3-70c9509ea182', 'quantite': '80 g'}, {'ingredient_id': '7d58bbf5-5d69-42cb-bc49-bf445e392214', 'quantite': '80 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335732, 'Gâteau régime sans matière grasse', 'maïzena, farine semi complète, banane, édulcorant, fromage blanc, arôme vanille, oeuf', '10 min', ['Préchauffez four à 180 degré.', 'Écrasez les bananes en purée.', 'Mélangez tous les ingrédients.', 'Possibilité d''ajouter amandes, noix, pommes...', 'Enfournez 50 min à 1 heure.', 'Laissez refroidir.'], ['Planche à découper', 'Couteau de chef', 'Fouet', 'Casserole', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'maïzena', 'bon marché', 'Gâteau régime sans matière grasse', 'oeuf', 'plat', 'édulcorant', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'arôme vanille', 'farine semi complète', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:27:20.076875', [{'ingredient_id': 'fbb4bf43-3e3f-4894-9037-7f44c815e31b', 'quantite': '120 g'}, {'ingredient_id': 'd783cbc2-7801-45cc-aea1-ac0fd16af77a', 'quantite': '70 g'}, {'ingredient_id': '6e1b687c-03ae-4dec-a1c0-ec4fe2c5933d', 'quantite': '2'}, {'ingredient_id': 'd6f8f71f-6d17-4d2a-bfc8-4ee023e09b6a', 'quantite': '10 g'}, {'ingredient_id': '23367c1f-2c5d-47c0-bae8-60874e53d9fc', 'quantite': '100 g'}, {'ingredient_id': '2b24bafc-7589-4252-a23c-dcf877902d16', 'quantite': '1 cuillères'}, {'ingredient_id': 'a07575df-017a-41d2-ab39-c16fb4d03649', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (253858, 'Muffins moelleux banane et Nutella', 'farine, levure chimique, oeuf, sucre, beurre, sucre vanillé, petit suisse, lait, banane', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Fouetter les oeufs avec le sucre en poudre et le sucre vanillé. ', 'Ajouter ensuite le beurre fondu toujours en fouettant pour ne pas cuire les oeufs.', 'Ajouter les petits-suisses et le lait.', 'Ajouter ensuite la farine et le sachet de levure.', 'Mettre 1 cuillère de pâte (1/3 du moule), y insérer une rondelle de banane.', 'Déposer une cuillère de Nutella sur le dessus et recouvrir d''une cuillère de pâte. Mettre au four et laisser cuire 20 minutes.'], ['Batteur électrique', 'Rouleau à pâtisserie'], ['Muffins moelleux banane et Nutella', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'petit suisse', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'muffin', 'beurre', 'sucre', 'lait', 'cocktail'], 'Dessert', b07b179b-5aae-4675-84fd-d76d302aeaa6, '2025-09-26T16:27:23.951240', [{'ingredient_id': '8f940821-67f1-4e1b-bfb1-8551c48a42db', 'quantite': '420 g'}, {'ingredient_id': '5b88e0ea-c3c8-48a2-8ce7-7bff988d7a8a', 'quantite': '1'}, {'ingredient_id': 'e2992046-bce6-4ad0-b852-d7471645c9cd', 'quantite': '3'}, {'ingredient_id': 'a3272010-98b9-41d2-9b7d-8c7831612d7e', 'quantite': '150 g'}, {'ingredient_id': '0fcc6a86-ae97-4527-bc8b-f47891b92cc1', 'quantite': '150 g'}, {'ingredient_id': '3c047d2f-a4a1-4a47-8635-28416a86a92f', 'quantite': '1'}, {'ingredient_id': '611d8198-93cb-4f68-995a-3caacd993051', 'quantite': '3'}, {'ingredient_id': '53934b88-32c5-4917-9e4f-3985f0e2c351', 'quantite': '15 cl'}, {'ingredient_id': '014cd073-b142-488c-b6c1-2095d91da05d', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (64112, 'Cake à la banane de ma mamie (super simple !)', 'banane, sucre, farine, beurre, noisettes, levure chimique, oeuf, rhum', '10 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Mélanger le beurre ramolli, les 2 œufs, le sucre, les bananes écrasées, la farine, la levure, les noisettes en poudre et le rhum.', 'Beurrer un moule à cake.', 'Verser la préparation dans le moule et cuire 40 à 50 min à four chaud.'], ['Râpe', 'Presse-agrumes', 'Verre doseur', 'Tire-bouchon', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'Cake à la banane de ma mamie (super simple !)', 'recette', 'noisettes', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:27:30.717797', [{'ingredient_id': 'bf90992b-29c2-4997-a00c-b0b9f1b0c884', 'quantite': '3'}, {'ingredient_id': '485cba48-421b-4216-91a4-6c27c25c8680', 'quantite': '200 g'}, {'ingredient_id': '9df1ba47-9f80-4b1b-bd86-9f3e26b2d058', 'quantite': '200 g'}, {'ingredient_id': 'eb750ba9-273a-42ba-888f-6bc334656c39', 'quantite': '100 g'}, {'ingredient_id': '93ab760e-aa18-4b5e-8630-4bf3d9511ed0', 'quantite': '65 g'}, {'ingredient_id': '3463da20-ff1c-4283-bf64-d42098e430ae', 'quantite': ''}, {'ingredient_id': '4bc89f01-f7fa-4e54-b1c7-cb0c335fe055', 'quantite': '2'}, {'ingredient_id': '68653d7a-91ea-4fb8-8c20-20d4b7448903', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57195, 'Verrine banane fraise', 'banane, fraises, spéculoos, crème chantilly', '10 min', ['Coupez les fraises en morceaux et les bananes en rondelles.', 'Ecrasez la moitié du paquet de speculoos dans un torchon de façon à en faire une poudre.', 'Alternez bananes, fraises et speculoos dans les verres, couvrez et placez au frigo pendant 1h30 (environ le temps d''un repas).', 'Au moment du dessert sortez les verrines et recouvrir de crème chantilly.'], ['Spatule', 'Louche', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'fraises', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'dessert', 'Verrine banane fraise', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:27:34.358519', [{'ingredient_id': '34a93872-b693-4da3-b7ba-e9923d904695', 'quantite': '4'}, {'ingredient_id': '398fdd64-e48c-4be5-9d3c-42729f4d9e7c', 'quantite': '500 g'}, {'ingredient_id': 'd367e2a6-de6c-4eb1-838d-207fd9726cbb', 'quantite': '1'}, {'ingredient_id': 'c5ccee90-a347-49f8-bdec-882ef4b0cf68', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24372, 'Gratin de bananes', 'banane, beurre, farine, lait, fromage râpé, muscade, poivre, sel', '30 min', ['Eplucher les bananes, les couper en tranches dans le sens de la longueur (environ 3 tranches pour une banane). ', 'Faire frire ces tranches dans de l''huile, les égoutter au fur et à mesure. ', 'Avec le beurre, la farine et le lait faire une sauce béchamel, la parfumer avec une belle dose de muscade. ', 'Alterner les tranches de bananes et la sauce béchamel dans un plat à gratin. Terminer par une couche de fromage râpé. ', 'Mettre au four 210°C 10 à 15 mn.'], ['Tire-bouchon', 'Râpe', 'Batteur électrique', 'Pince de cuisine', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'Gratin de bananes', 'muscade', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'poivre', 'lait', 'cocktail', 'fromage râpé'], 'Accompagnement', e84d3972-a4d7-4c81-92b9-5fdcac6a4ba3, '2025-09-26T16:27:38.161107', [{'ingredient_id': '0f17bb52-1d92-4085-99bb-421c8d18975a', 'quantite': '6'}, {'ingredient_id': '41b64ee9-0227-4135-bf6e-8d3113ccd9cb', 'quantite': '50 g'}, {'ingredient_id': 'daf37d77-80d3-4162-b6dc-39b285c6eed1', 'quantite': '3 cuillères'}, {'ingredient_id': '0ce5f4bb-3ca8-4ed7-b0ce-3f38d3073889', 'quantite': '1 l'}, {'ingredient_id': 'f1130a4b-f5f0-4f69-94b3-7b4437205c4e', 'quantite': '150 g'}, {'ingredient_id': '289ee537-6de8-4643-b06a-3343c0517ad5', 'quantite': ''}, {'ingredient_id': '8eb19079-c140-4df5-ac37-ea5bed30ed8a', 'quantite': ''}, {'ingredient_id': 'a414aed7-2d7f-44d1-839c-c2cb09017489', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315408, 'Smoothie ananas, banane, coco', 'banane, fromage blanc, ananas, sirop d''érable, lait de coco, lait', '5 min', ['Mixer une minute au moins à vitesse maximum l''ananas, la banane, le fromage blanc et le lait de coco. Ajouter le sirop d''érable selon le goût. ', 'Ajouter du lait pour obtenir la consistance souhaitée (on peut aussi utiliser davantage de lait de coco et pas de lait).', 'L''ananas surgelé permet d''éviter les glaçons qui diluent la boisson.'], ['Rouleau à pâtisserie', 'Louche', 'Balance de cuisine'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'coco', 'sirop d''érable', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'Smoothie ananas', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'ananas', 'lait', 'smoothies', 'cocktail'], 'Boisson', 7628b823-d15d-4e4d-bcdd-7c0913556eb4, '2025-09-26T16:27:41.798948', [{'ingredient_id': 'e5e212b9-2407-4b52-93e7-eea4b86738dd', 'quantite': '1'}, {'ingredient_id': 'b4b28d4b-7b61-4c7f-b047-df43a6e4e7b8', 'quantite': '100 g'}, {'ingredient_id': '819b1b05-d077-41e8-8363-9acc69dcc6bc', 'quantite': '100 g'}, {'ingredient_id': 'bc2be18b-9528-4b37-85ec-619e548e252d', 'quantite': '2 cuillères'}, {'ingredient_id': '0b60ea60-f4ef-4240-94fd-38233ea2f636', 'quantite': '20 cl'}, {'ingredient_id': '8bc43028-94c8-48b0-a6b0-490aa806a87b', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (201501, 'Mousse chocolat noir-banane en verrines', 'chocolat noir, banane, fromage blanc, lait, oeuf, sel, sucre', '35 min', ['Faites fondre seul le chocolat noir dans une casserole à feu doux.', 'Sur du papier sulfurisé, déposez ensuite des traînées de chocolat noir d''environ 3 cm de largeur.', 'Utilisez entre 1/4 et la moitié du chocolat et réservez au réfrigérateur.', 'Battez les blancs en neige avec une pincée de sel dans un saladier.', 'Ajoutez le sucre en mélangeant doucement avec une cuillère en bois.', 'Dans un autre saladier, mettez les bananes épluchées et coupées en morceaux.', 'Écrasez-les à l''aide d''une fourchette puis ajoutez le lait.', 'Mélangez à nouveau et ajoutez ensuite le fromage blanc et le chocolat restant puis mélangez au batteur.', 'Il faut laisser un petit peu de grumeaux pour une texture plus mousseuse.', 'Ajoutez au mélange les blancs en neige en mélangeant doucement avec la cuillère en bois.', 'Une fois que le mélange est homogène, recouvrez le saladier de film alimentaire puis réservez au réfrigérateur pendant 20 min minimum.', 'Versez une couche de mousse dans les verrines, ajoutez les morceaux du chocolat qui s''est un peu durci, et recommencez l''opération.', 'Vous pouvez réservez au réfrigérateur ou servir.', 'Bon appétit !'], ['Louche', 'Casserole', 'Pince de cuisine', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'mousse au chocolat', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Mousse chocolat noir-banane en verrines', 'fromage blanc', 'dessert', 'plat de résistance', 'chocolat noir', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:27:46.517978', [{'ingredient_id': '39ab2dde-b4bf-4bc0-8063-dd32cab74ebd', 'quantite': '200 g'}, {'ingredient_id': 'cbdb887e-91b7-4208-ab4e-2eea9f7b74d6', 'quantite': '2'}, {'ingredient_id': '98877382-a6ce-4d9b-99cd-0cac84229aaf', 'quantite': '100 g'}, {'ingredient_id': 'fcdc06ff-685b-48b1-a072-3728253d873a', 'quantite': '10 cl'}, {'ingredient_id': '32f1601d-d809-4876-88a8-a032b61498eb', 'quantite': '2'}, {'ingredient_id': 'f10c46ca-6335-44ed-b98a-233a6f8ae4b9', 'quantite': '1'}, {'ingredient_id': '1f9dfd1f-fb63-4390-a9ee-721b42f504cf', 'quantite': '25 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37616, 'Samossas aux fruits', 'brick, pomme, banane, mandarine, kiwi, orange, sucre roux, cannelle, margarine', '15 min', ['Presser l''orange, épluchez les fruits et les couper en petits morceaux. Les mélanger dans un saladier et saupoudrer de sucre, cannelle et arroser du jus de l''orange pressée.', 'Laisser mariner 30 minutes (mettre le four à chauffer pendant ce temps sur 180°C - thermostat 6) puis former des samoussas avec la préparation au centre (2 par personnes). Les dorer avec un peu de beurre fondu.', 'Placer à four chaud pendant 15 à 20 min, les retirer du four dès qu''ils sont dorés, servir avec une boule de glace, c''est un régal !'], ['Couteau de chef', 'Planche à découper', 'Poêle', 'Casserole', 'Batteur électrique'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'mandarine', 'bon marché', 'plat', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'margarine', 'dessert', 'plat de résistance', 'pomme', 'orange', 'cannelle', 'Samossas aux fruits', 'cocktail', 'sucre roux'], 'Dessert', 942ee8b5-6671-41bd-97f6-9752ff5c0461, '2025-09-26T16:27:50.074382', [{'ingredient_id': 'c4959435-c236-4316-a73c-ab8c1bc4aa30', 'quantite': '6'}, {'ingredient_id': '47c7e0c0-ed3e-45d9-b4db-7782534f90dc', 'quantite': '1'}, {'ingredient_id': 'e3d96bb2-a50f-4079-aed4-23af99466a58', 'quantite': '1'}, {'ingredient_id': '287374b5-4005-4c6b-8245-de9355b2a367', 'quantite': '1'}, {'ingredient_id': '03c299fa-9782-4400-a0cb-9404ca036b3a', 'quantite': '1'}, {'ingredient_id': '03b7c2db-f9f0-4329-a19a-7957c16d506a', 'quantite': '1'}, {'ingredient_id': '1935c507-1833-4a34-9e2a-3f1098f984b6', 'quantite': ''}, {'ingredient_id': '9e2d6e76-d513-40c8-a57d-6c8f0eff5865', 'quantite': ''}, {'ingredient_id': '3cd41534-7fbd-4faf-8505-b6aee2e96852', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528314, 'Banana bread healthy et rapide aux pépites de chocolat', 'farine, banane, sirop d''agave, oeuf, graines de chia, levure chimique, compote, pépites de chocolat, sel, sucre vanillé', '20 min', ['Préchauffer le four à 180°C (thermostat 6). Dans un saladier, verser la farine, les œufs, le sirop d’agave, la compote de pomme et mélanger énergiquement. ', 'Ajouter ensuite les graines de chia, la levure, le sucre vanillé, la banane coupée en rondelle et la pincée de sel puis mélanger à nouveau. ', 'Pour finir, incorporer les pépites de chocolat et mélanger une dernière fois. La pâte doit être homogène. ', 'Mettre la pâte dans un moule en silicone ou un moule préalablement beurré. ', 'Enfourner pour 20min.'], ['Économe', 'Poêle', 'Casserole', 'Mixeur', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'Banana bread healthy et rapide aux pépites de chocolat', 'facile', 'oeuf', 'sirop d''agave', 'plat', 'pépites de chocolat', 'recette', 'compote', 'cuisine', 'recettes', 'graines de chia', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'moyen', 'cocktail'], 'Dessert', 2091b988-b5eb-46c3-868d-d81308de4f2c, '2025-09-26T16:27:53.516788', [{'ingredient_id': 'a4ac13fb-7c25-43b4-acd8-bc9694f2b7ac', 'quantite': '200 g'}, {'ingredient_id': '39245e72-381e-4b9d-b37d-2a402fe25eb9', 'quantite': '1'}, {'ingredient_id': '9e1edec4-0daa-4636-9d8b-4693db72afc4', 'quantite': '3 cuillères'}, {'ingredient_id': 'a630037f-0689-4d1c-afb8-72adfc764579', 'quantite': '2'}, {'ingredient_id': 'c96bbd57-b5bf-4b7d-83d8-28b807ed7e63', 'quantite': '20 g'}, {'ingredient_id': '0060be1b-63c1-4b7d-bd6a-c1b702d4b8df', 'quantite': ''}, {'ingredient_id': '4f50895b-8193-4a2e-a702-7b8be799b108', 'quantite': '200 g'}, {'ingredient_id': '9fc73d4c-9bf7-4c5d-a31c-aab6162a2025', 'quantite': '100 g'}, {'ingredient_id': '4c1c1deb-c4d0-43ec-b263-67ffe47423f6', 'quantite': '1'}, {'ingredient_id': '878df83f-9a27-421d-927d-bd9c9334f740', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40119, 'Glace aux fruits de la passion et banane', 'fruit de la passion, banane, sucre en poudre, jaune d''oeuf, crème, crème, jus de citron', '15 min', ['Vider la pulpe des fruits, passer au tamis pour récolter le jus. ', 'Ajouter la banane finement écrasée. Ajouter le jus de citron et la crème à 15%. ', 'Battre le jaune d''oeuf avec le sucre. Fouetter la crème à 30%. Mélanger le tout et mettre dans la sorbetière pendant 40 minutes. ', 'La glace est meilleure lorsqu''elle est servie dès qu''elle sort de la sorbetière.'], ['Ouvre-boîte', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'jaune d''oeuf', 'sucre en poudre', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'fruit de la passion', 'dessert', 'plat de résistance', 'jus de citron', 'moyen', 'Glace aux fruits de la passion et banane', 'glace à l''italienne', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:27:57.097961', [{'ingredient_id': 'd394449b-4297-4538-b802-a95eaa71c7a1', 'quantite': '12'}, {'ingredient_id': '1e696a6e-34f1-43c3-bfe5-4d44d5396d77', 'quantite': '1'}, {'ingredient_id': 'c3ae3da6-ffea-4bd7-aee3-117e66398340', 'quantite': '70 g'}, {'ingredient_id': '84afd82f-6f1e-47d0-a2de-245e53a05883', 'quantite': '1'}, {'ingredient_id': '499277f7-3a31-40ab-a3a0-fad7adc4b647', 'quantite': '15 cl'}, {'ingredient_id': '9c87a9cb-818a-452e-a870-6780539a9317', 'quantite': '5 cl'}, {'ingredient_id': '3c38018d-c569-4938-a3f6-cbccff9c393d', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (90711, 'Gâteau tout simple Chocolat Banane', 'farine, beurre, sucre en poudre, chocolat noir, levure, oeuf, banane, sucre vanillé, lait', '15 min', ['Mélangez la farine, les 2 sucres et la levure.', 'Creusez un puits et ajoutez les 3 oeufs et le beurre fondu.', 'Vous obtenez une pâte assez compacte.', 'Faites fondre le chocolat au bain-marie ou au micro-ondes.', 'Ajoutez le chocolat à votre pâte. Ajoutez du lait jusqu''a ce que la pâte ait la consistance d''un gâteau au yaourt.', 'Coupez les bananes en petits morceaux et ajoutez-les à la préparation.', 'Beurrez et farinez un moule (sauf si il est en silicone) et versez votre préparation au trois-quarts du moule.', 'Enfournez à 180° C (thermostat 6) et laissez cuire 30 minutes.', 'C''est prêt.'], ['Spatule', 'Casserole', 'Pince de cuisine', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'Gâteau tout simple Chocolat Banane', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre vanillé', 'beurre', 'gâteau au chocolat', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:28:00.774709', [{'ingredient_id': '666b2778-8cc8-4aa8-9efb-a01837c6d490', 'quantite': '250 g'}, {'ingredient_id': 'a645bff4-aea6-4fbb-898a-8a9dcdaf46c8', 'quantite': '200 g'}, {'ingredient_id': '517d08cb-3f29-45ca-8bf7-fa46516e6ac1', 'quantite': '100 g'}, {'ingredient_id': '1bcb8eb3-dcc4-4ed6-9e4d-c8250ba5f9bb', 'quantite': '200 g'}, {'ingredient_id': 'db704aae-cdf1-4e10-80ba-9560c0488303', 'quantite': ''}, {'ingredient_id': '66a24d2d-cfa1-40e6-9269-72f57d2b9cf8', 'quantite': '3'}, {'ingredient_id': '6f860264-b574-4a7f-b4b1-edeec57599b9', 'quantite': '2'}, {'ingredient_id': '6e147e55-180b-4bf3-a475-79598c4fbcfe', 'quantite': '1'}, {'ingredient_id': 'cb2bce87-e40e-47b9-b471-68cb4e04f00b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (344028, 'Cocktail détox pêche/ananas/orange/banane', 'pêche, jus d''orange, ananas, banane', '5 min', ['Dans un blender, déposer d''abord les deux fruits coupés avec le jus de l''ananas si vous utilisez une boîte du commerce (ou un peu du jus de pêche ou d''orange s''il s''agit d''un ananas frais).', 'Mixer rapidement (30 sec, à vitesse moyenne).', 'Ajouter les jus d''orange et de pêche (compléter jusqu''au repère un litre si nécessaire).', 'Mixer 1-2 min à vitesse forte.'], ['Râpe', 'Pince de cuisine', 'Balance de cuisine', 'Mixeur', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'Cocktail détox pêche/ananas/orange/banane', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'ananas', 'jus d''orange', 'pêche', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:28:05.554260', [{'ingredient_id': '2a27d211-02e4-4b9e-ac49-2b82dc633473', 'quantite': ''}, {'ingredient_id': '755a5b73-0732-48ca-93bd-dfe7285b86fa', 'quantite': ''}, {'ingredient_id': 'b88e619e-305e-43c6-ae79-1e1d54bec665', 'quantite': ''}, {'ingredient_id': 'c6245f97-cb56-44ea-985f-db745a036069', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12601, 'Confiture bananes chocolat', 'banane, sucre, chocolat pâtissier, eau, jus de citron', '30 min', ['Peler les bananes et coupez-les en rondelles de 1 cm d''épaisseur.', 'Dans une bassine à confiture, mélanger les rondelles de banane, l''eau, le sucre et le jus de citron. Porter au frémissement. Verser  dans une terrine. Ajouter le chocolat en copeaux et mélanger jusqu''à ce qu''il soit fondu.', 'Couvrir les fruits d''une feuille de papier sulfurisé et réserver au frais pendant une nuit.', 'Le lendemain, porte cette préparation à ébullition en remuant continuellement.', 'Mixer très finement la confiture. Maintenir la cuisson à feu doux pendant cinq minutes en remuant toujours. Ecumer soigneusement.', 'Redonner un bouillon. Vérifier la nappe. Mettre en pots aussitôt et couvrir.'], ['Tire-bouchon', 'Pince de cuisine', 'Rouleau à pâtisserie', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'Confiture bananes chocolat', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'sucre', 'cocktail'], 'Confiserie', f4200638-cfb2-4a80-b9f1-fd790f9b0f2f, '2025-09-26T16:28:09.221848', [{'ingredient_id': '9ad6e4f1-253a-4a3f-803e-09d64c16549d', 'quantite': '1 kg'}, {'ingredient_id': 'acfa4bdd-0352-4312-b60d-bc5c6b39222b', 'quantite': '750 g'}, {'ingredient_id': '5b2a09ea-fe14-4ea6-9fa6-3c8f16294d1a', 'quantite': '250 g'}, {'ingredient_id': '37d989de-3db8-4c0d-868e-d1455a05f297', 'quantite': '30 cl'}, {'ingredient_id': 'fb7b29fc-5b80-45e7-81ea-fd1cc2bf1aad', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (383753, 'Crème de banane au Cooking Chef', 'banane, crème fraîche, yaourt à la grecque, cassonade, jus de citron, sucre vanillé', '5 min', ['Épluchez, puis coupez les bananes en petits morceaux. Déposez-les dans la cuve de votre Cooking Chef. Arrosez de jus de citron, ajoutez le reste des ingrédients, puis mixez avec le blender sur la sortie ultra rapide / 30 sec / 0 °C /  vit. 1 à max. ', 'Dégustez immédiatement ou placez au frais pendant 15 minutes maximum.'], ['Rouleau à pâtisserie', 'Pince de cuisine', 'Poêle'], ['yaourt à la grecque', 'banane', 'entrée', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'Crème de banane au Cooking Chef', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'jus de citron', 'cocktail', 'crème dessert'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:28:14.969937', [{'ingredient_id': '5fb38a2a-0ecc-4f3b-820c-21c174388530', 'quantite': '4'}, {'ingredient_id': '790c4f83-5568-4e2a-8d0e-a9fc417e3bdc', 'quantite': '2 cuillères'}, {'ingredient_id': 'b7de7291-74cf-4fea-8a1e-4cfe2f79c8b0', 'quantite': '2 cuillères'}, {'ingredient_id': '33be7216-d8eb-4313-98a7-447f02ae0446', 'quantite': '2 cuillères'}, {'ingredient_id': '24927b83-ea95-4e54-8f56-5e5dc6745faa', 'quantite': '2 cuillères'}, {'ingredient_id': '34c8fb57-3042-4aaf-bff5-6bc72b0540a9', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (224698, 'Bananes au chocolat faciles au four à micro-ondes', 'banane, chocolat en poudre, sucre en poudre, sucre glace', '5 min', ['Épluchez les bananes et coupez-les en rondelles, mettez-les dans une assiette creuse allant au four à micro-ondes.', 'Répartissez les 10 cuillères de chocolat sur les bananes et saupoudrez le tout de sucre en poudre.', 'Ajoutez le sucre glace, mettez le tout dans un four micro-ondes à pleine puissance pendant 1 minute et servez tiède.', 'Bon dessert !'], ['Rouleau à pâtisserie', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre glace', 'chocolat en poudre', 'cocktail', 'Bananes au chocolat faciles au four à micro-ondes'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:28:18.681911', [{'ingredient_id': 'c45c9cc9-b404-47d6-ba3f-0c8cb57d8b8d', 'quantite': '2'}, {'ingredient_id': '741a83c6-4317-4ed7-86e8-55b18dfae4a5', 'quantite': '10 cuillères'}, {'ingredient_id': 'b68cc39e-5572-41cb-9cd7-574c3ccba331', 'quantite': '3 cuillères'}, {'ingredient_id': 'fd6f5914-c255-4825-a3cf-8a94408322e6', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (59373, 'Tarte aux fruits d''été', 'pâte sablée, kiwi, banane, nectarine, fraises, framboises, pomme, amandes, beurre tendre, oeuf, sucre glace, lait, vanille, oeuf, sucre en poudre, farine', '30 min', ['Préchauffez le four à 200°C (thermostat 6-7).', 'Etalez la pâte sablée dans un moule à tarte, piquez-la avec une fourchette, puis retournez les bords.', 'Préparez la frangipane, faites revenir la poudre d''amandin (ou d''amande) dans une poêle jusqu''à ce que la préparation brunisse.', 'Réservez-la dans un bol et ajoutez le sucre glace, mélangez.', 'Dans un saladier, travaillez le beurre jusqu''à obtenir une pâte molle puis, incorporez le mélange amandin (ou amande)et sucre, au beurre.', 'Ajoutez-y l''oeuf et continuez à mélanger.', 'Etalez la frangipane sur la pâte sablée et enfournez pendant 20-25 minutes (la pâte doit être dorée).', 'Préparez la crème pâtissière, versez le lait dans une casserole, avec la gousse de vanille (préalablement fendue dans sa longueur) et portez-le à ébullition.', 'Dans un saladier, mélangez les oeufs et le sucre, ajoutez la farine. Dès que la préparation est un peu mousseuse, versez une partie du lait bouillant, bien mélanger. Enlevez la gousse de vanille, puis renverser le tout dans la casserole avec le reste de lait.', 'Sur feu fort, remuez sans cesse jusqu''à ce que la crème épaississe. Réservez-la dans un saladier propre.', 'Dès que la tarte frangipane est cuite, étalez la crème pâtissière dessus et laissez-le tout refroidir à température ambiante, le temps de couper les fruits.', 'Coupez les fruits (sauf les framboises) en petits dés et disposez-les sur la tarte.', 'Terminez en disposant les framboises de part et d''autres sur la tarte.'], ['Rouleau à pâtisserie', 'Râpe', 'Fouet', 'Balance de cuisine'], ['', 'amandes', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'beurre tendre', 'nectarine', 'facile', 'framboises', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'fraises', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'vanille', 'dessert', 'plat de résistance', 'pomme', 'sucre glace', 'lait', 'Tarte aux fruits d''été', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:28:23.465713', [{'ingredient_id': 'b18010ad-1851-4190-ad39-0f05551f61f0', 'quantite': '1'}, {'ingredient_id': '12c929f1-e9ca-4960-a99d-0a71388dcfa2', 'quantite': '1'}, {'ingredient_id': '485f8694-3b9f-48f7-86d1-88690dfb5da3', 'quantite': '1'}, {'ingredient_id': 'b36cab1f-021b-4de9-a8a1-687c21694817', 'quantite': '1'}, {'ingredient_id': '67fe67dc-8810-4c3a-a388-fac26a63173c', 'quantite': '10'}, {'ingredient_id': '3baecf0a-e7c1-4623-a290-e9811eed4cd9', 'quantite': '10'}, {'ingredient_id': 'b0378832-570a-42a1-b573-e6beff7c1d75', 'quantite': ''}, {'ingredient_id': '3779a684-a90c-4551-af78-5ebc1c7cca88', 'quantite': '60 g'}, {'ingredient_id': '4b08fc15-0523-4b13-8e41-e174d1c27ff3', 'quantite': '50 g'}, {'ingredient_id': '9f6960d0-5bd7-4e32-98e0-34deefe5f6a5', 'quantite': '1'}, {'ingredient_id': 'd9639ddb-2c33-41d2-b30b-9d353bb2aaf1', 'quantite': '60 g'}, {'ingredient_id': 'cbc61f7f-c1af-4195-965b-15297b7d7225', 'quantite': '50 cl'}, {'ingredient_id': '72ca0001-5102-4445-879b-080722b6e06f', 'quantite': '1'}, {'ingredient_id': '750b6740-5ba3-4597-bcf7-b7e5d29481d4', 'quantite': '2'}, {'ingredient_id': '0fc9e9fd-2107-4305-bb7f-f91697f200da', 'quantite': '100 g'}, {'ingredient_id': '38f48d44-71ff-41a7-b425-fd4486634966', 'quantite': '40 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23868, 'Bananes séchées', 'banane', '5 min', ['Peler les bananes, les couper en rondelles et les mettre dans un plat allant au four (attention à ce qu´elles ne se superposent pas) et mettre dans un four pas trop chaud (thermostat 2 ou 3), puis les laisser cuire environ 1h30.', 'C''est tout simple, mais long!!'], ['Tire-bouchon', 'Planche à découper'], ['', 'bon marché', 'boisson', 'recettes', 'banane', 'entrée', 'recettes de cuisine', 'Bananes séchées', 'plat', 'dessert', 'confiserie', 'recette', 'testées', 'plat de résistance', 'cocktail', 'cuisine', 'très facile'], 'Confiserie', 306a20a9-bf04-4d13-a0d2-8db5ed800c5a, '2025-09-26T16:28:27.017229', [{'ingredient_id': '1df8d62a-e1e6-40f8-b9c6-4560ddc1e328', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335108, 'Moelleux banane noix de coco', 'banane, lait, lait de coco, sucre, vanille, oeuf, farine, noix de coco', '5 min', ['Mélangez tous les ingrédients, versez les dans un plat à four pas trop grand et faites cuire 30 minutes à 150°C (thermostat 5).', 'Vérifiez la cuisson, le gâteau doit rester moelleux. Servez tiède, avec éventuellement du caramel.'], ['Passoire', 'Couteau de chef', 'Tire-bouchon'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'vanille', 'dessert', 'plat de résistance', 'Moelleux banane noix de coco', 'gâteau à la banane', 'noix de coco', 'lait', 'sucre', 'cocktail'], 'Dessert', 8601891e-a188-442b-b5e0-8c285de31146, '2025-09-26T16:28:30.624953', [{'ingredient_id': 'fcba42f0-9a35-4154-884d-f46cf90649dd', 'quantite': '3'}, {'ingredient_id': '02403b23-da6f-43ee-937b-51b0f401540c', 'quantite': '30 cl'}, {'ingredient_id': '29c1b6b2-5354-4722-b2af-fb261f6c32bb', 'quantite': ''}, {'ingredient_id': 'd3fc2aa1-6a17-43df-9a04-4af0012ae735', 'quantite': '2 cuillères'}, {'ingredient_id': '2501d16b-d881-48a7-97c4-7db3838c6a8e', 'quantite': ''}, {'ingredient_id': '2c1a8c41-7d76-49db-a1b6-a6135d4d8f10', 'quantite': '1'}, {'ingredient_id': '4d58f856-d173-40b6-8f41-36597ad8c28b', 'quantite': '3 cuillères'}, {'ingredient_id': '9136601e-b916-4cb9-b6cc-4427cb36055b', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (223335, 'Tarte aux bananes et compote pomme banane', 'pâte brisée, banane, compote, sucre roux, cannelle, jaune d''oeuf, lait', '25 min', ['Coupez les bananes en rondelles.  ', 'Préparez le fond de la tarte avec une des pâtes : piquez-la avec une fourchette.  ', 'Versez la compote et ajoutez les rondelles de bananes en formant des couches.  ', 'Versez la cannelle et le sucre sur la dernière couche.', 'Coupez la deuxième pâte en lanières de 1cm de largeur.   ', 'Formez une grille sur la tarte avec les lanières.', 'Battez le jaune d''oeuf  avec une cuillerée à café de lait ou de l''eau.  ', 'Badigeonnez la grille avec cette préparation.  ', 'Placez la tarte au four pendant 35-40 min, 210°C (thermostat 7).'], ['Pince de cuisine', 'Mixeur', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'compote de pomme', 'bon marché', 'plat', 'jaune d''oeuf', 'Tarte aux bananes et compote pomme banane', 'recette', 'compote', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cannelle', 'lait', 'cocktail', 'sucre roux'], 'Dessert', 74df75ca-e7c0-4a2d-9359-144e43bf8b18, '2025-09-26T16:28:34.217611', [{'ingredient_id': '5080ce38-286a-43c1-9e70-22ddf291f845', 'quantite': '2'}, {'ingredient_id': 'f482336b-8ac1-4ef0-ac69-72a6fded7f40', 'quantite': '6'}, {'ingredient_id': '6db0eb23-be54-43bc-bd0c-8caddfbdf4d8', 'quantite': '2'}, {'ingredient_id': '0e667f88-81a4-4e5c-aea1-217ffa9fb7f7', 'quantite': '1 cuillères'}, {'ingredient_id': '96c7623c-54f8-48fb-bc1e-2c047de882bf', 'quantite': '1 cuillères'}, {'ingredient_id': '15028545-cc68-4525-af10-c6347bcdd6a3', 'quantite': '1'}, {'ingredient_id': 'abad73b9-3326-4323-bb4b-969b45425b60', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (86934, 'Smoothie vite fait bien fait', 'banane, pomme, kiwi, orange, crème fraîche, eau', '10 min', ['Pelez les bananes, les pommes et les kiwis.', 'Coupez les bananes en petites rondelles, ainsi que les pommes et les kiwis, mettez-les dans le blender.', 'Ajoutez le jus de l''orange, la cuillère de crème fraîche et une cuillère à soupe d''eau.', 'Mixez le tout dans le blender à puissance maximum.'], ['Ouvre-boîte', 'Verre doseur'], ['entrée', 'banane', 'kiwi', 'crème fraîche', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'orange', 'Smoothie vite fait bien fait', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:28:37.739737', [{'ingredient_id': '943224b3-e4b3-47f2-8705-2fe8e18a01c6', 'quantite': '2'}, {'ingredient_id': 'a3840cff-f1b2-44da-b510-bc3a2ea6ee92', 'quantite': '3'}, {'ingredient_id': '17df7d61-cdea-4282-82ad-eff3e2192eea', 'quantite': '2'}, {'ingredient_id': '99eef804-cda5-4e0d-bf90-5b8772fa4149', 'quantite': '1'}, {'ingredient_id': 'bfb8d01b-7428-4c7f-959d-55bf4ba92050', 'quantite': '1 cuillères'}, {'ingredient_id': '20c24ced-10cd-495b-a1af-5f680e355e12', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (80711, 'Smoothie de fruits aux fraises', 'yaourt, banane, poire, pêche, coulis de framboise, mangue, fraises, framboises, fruits, édulcorant', '15 min', ['Décongelez les tranches de mangue et le coulis de framboise.', 'Epluchez la poire, la pêche et la banane et coupez-les en morceaux.', 'Mixez tous les ingrédients, à l’exception des fraises et des framboises, jusqu''à l''obtention d''un mélange homogène.', 'Lavez et coupez les fraises en quatre, en réservant 4 petites fraises entières pour la décoration.', 'Versez le smoothie dans des verres à cocktail, répartissez les quartiers de fraises dans chaque verre, mélangez. ', 'Placez au réfrigérateur au moins pendant une heure.', 'Au moment de servir, décorez d’une fraise et de quelques framboises.', 'Servez très frais.', 'Nota : on peut varier les fruits en fonction de la saison et des goûts.'], ['Ouvre-boîte', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'Smoothie de fruits aux fraises', 'testées', 'poire', 'très facile', 'framboises', 'rapide', 'plat', 'mangue', 'fraises', 'édulcorant', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'pêche', 'fruits', 'cocktail', 'coulis de framboise'], 'Dessert', 5670c526-5fe5-481b-b821-d08290876160, '2025-09-26T16:28:41.472994', [{'ingredient_id': '4e488621-da01-47d7-a39c-f7ff0750fc29', 'quantite': '1'}, {'ingredient_id': '3503301e-a3b1-4336-8be0-de1893802bff', 'quantite': '1'}, {'ingredient_id': '69376858-65e9-45f5-96a6-aefe215768d3', 'quantite': '1'}, {'ingredient_id': '853d9d2f-c4b1-42a1-b8d9-8f9f38081f60', 'quantite': '1'}, {'ingredient_id': 'e8995dc2-3dc2-4554-bca6-c7f74fc9bf6b', 'quantite': '1'}, {'ingredient_id': '7bcb53f1-701f-4b62-bc64-65e07dc100d3', 'quantite': '2'}, {'ingredient_id': '031afa2c-6057-4918-896f-c74930c041fb', 'quantite': '250 g'}, {'ingredient_id': '7ea12449-3b8e-4415-91b2-a32f47d7d6a8', 'quantite': ''}, {'ingredient_id': 'd8d27620-8213-493a-a9d7-990bb6a83213', 'quantite': '10 cl'}, {'ingredient_id': '95b66035-4241-4d69-9cb1-94a09c0574c3', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (359685, 'Milkshake pêche-banane vegan', 'banane, pêche, boisson aux amandes, grenade', '10 min', ['Epluchez les bananes et coupez les en morceaux.
Lavez les pêches, dénoyautez-les et coupez-les en morceaux.', 'Mettre les morceaux de pêches et de bananes dans un mixeur, ajoutez le lait d''amandes et mixez.', 'Versez le contenu dans des verres et placez-les une trentaine de minute au congélateur pour déguster bien frais.', 'Préparez la grenade pour accompagner votre milkshake.
Dégustez votre milkshake avec les grains de grenade !'], ['Presse-agrumes', 'Planche à découper'], ['entrée', 'banane', 'boisson aux amandes', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'Milkshake pêche-banane vegan', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pêche', 'smoothies', 'cocktail', 'grenade'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:28:46.564344', [{'ingredient_id': '0e6d5047-3645-48e7-a3b3-c8fa194cbfea', 'quantite': '2'}, {'ingredient_id': 'fec1798a-4b56-4d38-b68d-3ec49ccbae0a', 'quantite': '5'}, {'ingredient_id': '0c2217af-9bde-4703-b0f1-ce1ee51f625d', 'quantite': '20 cl'}, {'ingredient_id': 'ba51a309-5faf-4775-8df8-8862ec9aea30', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (59189, 'Petits soufflés à la banane', 'banane, amandes en poudre, sucre, maïzena, farine, oeuf, jaune d''oeuf, amandes effilées, lait, Liqueur, crème, jus de citron', '20 min', ['Mélanger farine, maïzena et poudre d’amande dans un saladier et faire un puit.', 'A part, blanchir les oeufs et 2/3 du sucre et arroser du jus de citron, puis incorporer dans le puit.', 'Mélanger jusqu''à obtention d’une pâte épaisse puis ajouter petit à petit le lait en continuant à mélanger.', 'Ecraser une banane dans le même bol que pour blanchir le sucre, verser une cuillère à soupe de liqueur de banane et incorporer la mixture formée dans la pâte en continuant le mélange.', 'Mettre le reste du sucre dans la pâte en mélangeant activement, puis une cuillère à soupe de liqueur de banane et une fois celle-ci dissoute dans la pâte, ajouter une cuillère à soupe de crème de whiskey en mélangeant activement.', 'Continuer à mélanger la pâte jusqu’à ce qu’elle devienne fluide et lisse, puis laisser reposer entre 30 minutes et 2 heures au frigo.', 'Couper les 3 bananes restantes en rondelles - réserver une demie banane coupée - et placer les morceaux au fond des ramequins.', 'Sortir la pâte et y ajouter les morceaux de la demie banane en mélangeant le tout puis laisser reposer 5 minutes à température ambiante.', 'Préchauffer le four à 210°C (thermostat 7).', 'Verser à parts égales la pâte sur les rondelles de bananes dans les ramequins pour les recouvrir intégralement. Saupoudrer les desserts avec les amandes effilées et placer au four pendant 20 minutes.', 'Baisser le thermostat à 180°C (thermostat 6) pour encore 5 minutes.', 'Sortir du four et laisser refroidir les desserts pendant 5 minutes à l’air libre.'], ['Ouvre-boîte', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'maïzena', 'amandes en poudre', 'oeuf', 'plat', 'jaune d''oeuf', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'jus de citron', 'moyen', 'Liqueur', 'sucre', 'lait', 'amandes effilées', 'cocktail', 'Petits soufflés à la banane'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:28:51.930182', [{'ingredient_id': 'a2b031b7-97ed-4249-af2f-071baddb0d85', 'quantite': '4'}, {'ingredient_id': '3fee65b2-3451-48f2-bf48-aba4bda14665', 'quantite': '80 g'}, {'ingredient_id': 'fad6f6f3-4f63-4e73-859f-52f802ca5f74', 'quantite': '70 g'}, {'ingredient_id': 'b977877d-f173-42a3-b608-7e8f7adb916a', 'quantite': '60 g'}, {'ingredient_id': 'f6ae47cc-e833-4042-a411-3d458608e586', 'quantite': '30 g'}, {'ingredient_id': '36fd1dfd-1a34-43c2-b799-4582ee49a9d4', 'quantite': '1'}, {'ingredient_id': 'cbaaaf6a-4f0d-4c50-a17b-06f9a44ccfb4', 'quantite': '1'}, {'ingredient_id': 'e4684f56-1526-42fe-bbee-3fafde077354', 'quantite': '40 g'}, {'ingredient_id': '925c4bc2-1678-421c-80f5-3d5c8bf2a252', 'quantite': '15 cl'}, {'ingredient_id': '6f20c830-e0ff-4185-b915-7f09b4acc35f', 'quantite': '2 cuillères'}, {'ingredient_id': 'bf4fe1fc-f3b6-44c0-a7d8-67a48f557e8f', 'quantite': '1 cuillères'}, {'ingredient_id': 'e94254e8-501b-4030-9228-68745481656f', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (95191, 'Tiramisu parfum strudel ultra rapide', 'pomme, banane, raisins secs, cannelle, épices, biscuits à la cuillère, fromage blanc, miel', '45 min', ['Pour la compote : ', 'Peler et couper les pommes et bananes en petits morceaux.', 'Les faire cuire à feu moyen pendant 10 à 15 min, en rajoutant les raisins et les épices. Normalement, les fruits auront juste commencé à compoter et seront légèrement caramélisés.', 'Réserver cette préparation', 'Pour le "tiramisu-strudel"', 'Dans un petit plat à charlotte ou à tiramisu, placer une couche de cuillères (il n''est pas nécessaire à mon sens de les faire tremper au préalable. Si cet aspect croquant ne plaît pas, il est toujours possible de les tremper dans un peu de sirop au rhum. Il suffit pour cela de faire chauffer, dans une casserole à feu doux, de l''eau, du rhum et du sucre)', 'Recouvrir les biscuits de fromage blanc dans lequel on aura incorporé le miel.', 'Remettre une couche de boudoirs et la recouvrir de compote, des boudoirs à nouveau et une couche de fromage blanc,...', 'Et ce, jusqu''à épuisement des ingrédients.', 'Ensuite, laisser au frigo pendant 30 minutes (ou plus si vous avez le temps)'], ['Pince de cuisine', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'épices', 'confiserie', 'testées', 'très facile', 'Tiramisu parfum strudel ultra rapide', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'strudel', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'raisins secs', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:28:57.410526', [{'ingredient_id': 'dff27cfe-ed1c-4fdd-995f-039d33a595ce', 'quantite': '4'}, {'ingredient_id': '2c147e07-9b09-4a6c-9460-e9073c53313f', 'quantite': '3'}, {'ingredient_id': '892367d7-a113-4013-b011-bf5d745b3f52', 'quantite': '100 g'}, {'ingredient_id': '5cc0776a-1804-480b-9b51-6729cc463a99', 'quantite': ''}, {'ingredient_id': '712c7568-528d-4e80-a78d-9d43eba850c4', 'quantite': '4'}, {'ingredient_id': '2667ef50-7e33-42d6-99f4-2d39eec179b1', 'quantite': '20'}, {'ingredient_id': '839f30c0-356d-48c3-b651-a18c632c9018', 'quantite': '400 g'}, {'ingredient_id': 'e25bb365-f79b-4ea6-a3c6-9de29e5df3fb', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62163, 'Gâteau à la banane sans oeuf ni lait', 'margarine, cassonade, banane, miel, levure chimique, farine, maïzena, chocolat, cannelle', '10 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Battre au fouet la margarine et le sucre.', 'Ajouter le miel tiédi au micro-ondes puis les bananes écrasées à la fourchette.', 'Incorporer la farine tamisée avec la maïzena et la levure puis la cannelle et les pépites de chocolat.', 'Cuire environ 40 minutes au four.', 'Le gâteau est cuit lorsque la pointe du couteau plongé dans le gâteau ressort sèche.'], ['Fouet', 'Pince de cuisine', 'Moule à tarte', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'levure chimique', 'chocolat', 'facile', 'maïzena', 'Gâteau à la banane sans oeuf ni lait', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'farine', 'margarine', 'dessert', 'plat de résistance', 'moyen', 'cannelle', 'cocktail', 'oeufs au lait'], 'Dessert', 7dea048d-fa5e-4ba7-b52f-f36665327e1a, '2025-09-26T16:29:01.295257', [{'ingredient_id': '774b4c69-a6ce-4471-a32c-5ff9e4cbea81', 'quantite': '125 g'}, {'ingredient_id': '4180d0a2-192d-4efe-998a-8e297d5995c5', 'quantite': '140 g'}, {'ingredient_id': 'c5bc6181-7b53-421a-a45b-caba70a368eb', 'quantite': '2'}, {'ingredient_id': '0241599f-770d-45e8-b497-1a6d9d604576', 'quantite': '1 cuillères'}, {'ingredient_id': '7fa3fd22-08e3-443d-914a-a452976fe8e4', 'quantite': '1 cuillères'}, {'ingredient_id': 'a2d4fb44-a975-4aa9-ab1f-e24162e79d1c', 'quantite': '150 g'}, {'ingredient_id': '36ee5637-cbd0-4989-a5f0-ed536fce3de9', 'quantite': '50 g'}, {'ingredient_id': 'e6665f51-2519-4adc-8f7b-b0b5a27b7caa', 'quantite': '100 g'}, {'ingredient_id': 'b02b5d7a-ffad-4aba-bd5d-8a6a14ede863', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (91040, 'Tiramisu nutella banane', 'mascarpone, sucre, Nutella, jus de banane, oeuf, biscuits à la cuillère, cacao, banane', '15 min', ['Séparer les blancs des jaunes.', 'Mélanger les jaunes avec le mascarpone, bien remuer. Après avoir battu les jaunes d''oeufs avec le mascarpone, ajouter le sucre.', 'Monter les blancs en neige bien ferme, les incorporer délicatement au mélange à base de mascarpone.', 'Couper la banane en deux et réserver au frais.', 'Couper l''une des moitiés de la banane en petits dés.', 'Dans le fond des verrines, disposer une rangée de boudoirs imbibés de nectare de banane, ensuite mettre le nutella à l''aide d''une cuillère à café et quelques morceaux de banane. Terminer par le mascarpone.', 'Réserver au moins 3 h au frais.', 'Au moment de servir, saupoudrer un peu de cacao en poudre.'], ['Moule à tarte', 'Balance de cuisine', 'Mixeur', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'confiserie', 'Tiramisu nutella banane', 'testées', 'biscuits à la cuillère', 'facile', 'bon marché', 'cacao', 'rapide', 'oeuf', 'plat', 'jus de banane', 'recette', 'cuisine', 'recettes', 'boisson', 'Nutella', 'dessert', 'plat de résistance', 'tiramisu', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:29:06.265229', [{'ingredient_id': '5be39b40-e523-4389-b498-ea9d96f748ff', 'quantite': '250 g'}, {'ingredient_id': '8b2534a9-62f0-4266-a595-12fd5f3cd8eb', 'quantite': '40 g'}, {'ingredient_id': '2170a104-7611-4ca6-9d1b-efeab2170d10', 'quantite': '50 g'}, {'ingredient_id': 'e4db582b-a893-4b67-a520-04854745e9e4', 'quantite': '15 cl'}, {'ingredient_id': '946cdfb5-fdec-4f0c-a528-b366da4857f1', 'quantite': '3'}, {'ingredient_id': 'de11b0c4-99cc-4865-8e45-0cd1062da753', 'quantite': '20'}, {'ingredient_id': 'c5863112-a9e2-4867-a006-d9af2e49de99', 'quantite': '20 g'}, {'ingredient_id': 'be075623-19c6-46b1-9d06-a4ceccc372bd', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (35767, 'Fruits gratinés au cointreau', 'pomme, poire, banane, abricot, raisins secs, jaune d''oeuf, crème liquide, lait, sucre vanillé, cointreau, beurre, amandes en poudre', '20 min', ['Préchauffer le four à thermostat 6/7 (200°C).', 'Eplucher les fruits, les couper en petits dés.', 'Couper les abricots secs en quatre. Etaler la margarine sur le fond et les parois du plat à gratin, puis y déposer les fruits, ainsi que les fruits secs.', 'Dans un saladier, mélanger les jaunes d''oeufs avec la crème liquide, le lait, le sucre vanillé et le cointreau.', 'Verser la préparation sur les fruits, saupoudrer la poudre d''anande sur la préparation.', 'Mettre au four pendant 15 minutes et finir de gratiner sur position grill pendant 5 minutes, en surveillant bien!'], ['Pince de cuisine', 'Moule à tarte', 'Rouleau à pâtisserie', 'Batteur électrique', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'abricot', 'poire', 'très facile', 'amandes en poudre', 'plat', 'jaune d''oeuf', 'recette', 'Fruits gratinés au cointreau', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'cointreau', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'moyen', 'beurre', 'raisins secs', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:29:11.166616', [{'ingredient_id': '7ccee183-573e-4bda-b3e3-9730e89696a1', 'quantite': '1'}, {'ingredient_id': 'f528a7ea-c965-4ae9-80e9-474756c1ad13', 'quantite': '1'}, {'ingredient_id': '5060cd09-ea38-484e-9148-a3c222bd1322', 'quantite': '1'}, {'ingredient_id': '2a97edfa-f03c-475f-9c5a-78d8211014ab', 'quantite': '6'}, {'ingredient_id': '7f2ff204-62b9-4067-9963-05c859295c60', 'quantite': '1 cuillères'}, {'ingredient_id': '6debe005-3ada-489d-95e9-8206eeb429f4', 'quantite': '2'}, {'ingredient_id': '241e2728-c7a7-4fb9-84a7-48609de5a476', 'quantite': '10 cl'}, {'ingredient_id': '4bef4497-265f-4f48-8dcf-0e0746a53f70', 'quantite': '10 cl'}, {'ingredient_id': 'bfe65d21-7cfc-4d82-91c5-3740e289ace2', 'quantite': '1'}, {'ingredient_id': '5084c187-05c8-43d8-8a10-d730c8be884a', 'quantite': '1'}, {'ingredient_id': 'c2878087-7c3c-4b58-a808-88362ebfebaa', 'quantite': '20 g'}, {'ingredient_id': '79705a36-5234-4519-82c5-1eb2ea02c92b', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (201474, 'Crumble à la parisienne', 'biscuit sablé, café, sorbet melon, banane, fraises, sucre', '20 min', ['Commencer par faire fondre le beurre dans une casserole.', 'Mixer les biscuits. Y ajouter le beurre fondu.', 'Mettre le mélange dans des petits ramequins et laisser reposer 2 à 3 h au réfrigérateur.', 'Couper ensuite la banane et les fraises en lamelles. Dans une poêle, faire revenir les fruits avec du sucre afin d''avoir un côté caramélisé.', 'Une fois les fruits prêts et chauds, prendre les ramequins et y déposer une couche de sorbet (sorbet melon est le meilleur mariage qu''il soit). ', 'Ajouter sur le dessus les fruits chaud et déguster en prenant les 3 couches du dessert.'], ['Casserole', 'Mixeur', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'biscuit sablé', 'facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'café', 'cuisine', 'sorbet melon', 'recettes', 'boisson', 'dessert', 'Crumble à la parisienne', 'plat de résistance', 'autres crumbles', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:29:16.220516', [{'ingredient_id': '8c15786c-2d81-4e7f-9da1-1633171d7c71', 'quantite': '10'}, {'ingredient_id': '5300754f-aa96-4462-89d3-a9e6441975dc', 'quantite': '2 cuillères'}, {'ingredient_id': 'e9cd4f9c-371b-42e3-8d33-bcce81c63f55', 'quantite': ''}, {'ingredient_id': 'c9beff56-ab88-40a4-a8a6-cb7fc158b276', 'quantite': '1'}, {'ingredient_id': '8ef4ccd6-13a6-4bec-b2dd-17b71bf635fe', 'quantite': '6'}, {'ingredient_id': '97c1137d-2430-4fd8-800e-f9b4a926b62d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530520, 'Bircher exotique', 'yaourt nature, fruit de la passion, banane, noix de coco rapée, corn flakes', '10 min', ['Verse le yaourt dans un bol. Coupe les fruits de la passion en deux et vide-les dans le bol.', 'Mélange-la avec la préparation passion/yaourt. Ajoute la noix de coco.', 'Mélange. Enlève la peau de la banane et coupez-la en rondelles.', 'Puis, pour finir, mélange doucement les corn flakes avec la préparation, pour ne pas qu''ils se cassent.'], ['Rouleau à pâtisserie', 'Batteur électrique', 'Couteau de chef', 'Ouvre-boîte'], ['entrée', 'banane', 'Bircher exotique', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'corn flakes', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'fruit de la passion', 'dessert', 'plat de résistance', 'Muesli', 'cocktail'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T16:29:20.983399', [{'ingredient_id': '87351537-b895-47af-87c9-7d33df88cad4', 'quantite': '1'}, {'ingredient_id': 'dd885b35-b8d4-4eb6-9882-6a32c80e7d36', 'quantite': '2'}, {'ingredient_id': '182013ad-3776-4b12-af1b-19aa1845c84c', 'quantite': '1'}, {'ingredient_id': '3c6ce59e-611b-415b-ae4e-c11da35366ce', 'quantite': '1 cuillères'}, {'ingredient_id': '89626e1a-05ee-462e-ad74-a53690bbbf43', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43685, 'Crumble pommes bananes', 'farine, sucre roux, beurre, pomme, banane', '10 min', ['Malaxer le tout avec les doigts, de façon à obtenir une pâte homogène et mettre au frigo pendant 2 h.', 'Sortir la pâte du frigo.', 'Eplucher et découper en quartiers (ou en morceaux) les pommes et les bananes. Les disposer en couches, dans un plat allant au four.', 'Emietter la pâte avec les doigts sur les fruits, et mettre au four 40 min environ.'], ['Économe', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'crumble aux pommes', 'plat', 'Crumble pommes bananes', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'cocktail', 'sucre roux'], 'Dessert', 91de31d9-0f42-4b79-a971-eb1a3ad1adcb, '2025-09-26T16:29:24.689800', [{'ingredient_id': 'b714dd6c-2e4d-4f99-afdf-99d3211ecef7', 'quantite': '100 g'}, {'ingredient_id': 'a29a5c17-5bb3-45b1-969a-e58ac3e0a2cf', 'quantite': '100 g'}, {'ingredient_id': 'c03dc418-0b20-4419-af08-efe1037a7267', 'quantite': '75 g'}, {'ingredient_id': 'ec33aab1-74fc-441a-9eea-7ebe12491e07', 'quantite': '4'}, {'ingredient_id': 'f707550b-a4d1-461e-b40d-a8dcee2d6ae0', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70895, 'Gâteau Choco-bananes', 'farine, maïzena, oeuf, levure, sucre, huile, lait, rhum, chocolat pâtissier, banane, pomme', '15 min', ['Mélanger au fouet électrique dans un saladier : farine, maïzena, levure, oeufs, sucre, huile, lait et rhum jusqu''à obtention d''une pâte épaisse et lisse. ', 'Eplucher les fruits et les couper en dés.', 'Préchauffer le four à 180°C (thermostat 6).', 'Beurrer un moule et y déposer les fruits. Recouvrir du chocolat coupé en carrés puis de la pâte.', 'Faire cuire environ 45 minutes.'], ['Poêle', 'Moule à tarte', 'Mixeur', 'Balance de cuisine', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'maïzena', 'bon marché', 'oeuf', 'plat', 'recette', 'chocolat pâtissier', 'levure', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'pomme', 'sucre', 'lait', 'cocktail', 'Gâteau Choco-bananes'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:29:28.442655', [{'ingredient_id': '9d479041-d3a8-4d65-aa44-7bf37f7a74d1', 'quantite': '200 g'}, {'ingredient_id': 'ad3fc39b-de28-417e-8ca6-f738c77e6b25', 'quantite': '50 g'}, {'ingredient_id': 'd65d0669-46dc-42f3-b1d5-8668f2b60d42', 'quantite': '2'}, {'ingredient_id': 'e9c5352f-c9f0-4a00-b50e-9968978ad764', 'quantite': '1'}, {'ingredient_id': 'f2b90ca1-05f8-4193-9393-173200206671', 'quantite': '200 g'}, {'ingredient_id': '810acd4c-0747-4731-8487-d9b053cccd92', 'quantite': '10 cl'}, {'ingredient_id': 'a077d104-597e-4f8d-a184-c93b6a15fa86', 'quantite': '10 cl'}, {'ingredient_id': 'a880f1fc-1748-478a-af58-70fde4542cfe', 'quantite': '1'}, {'ingredient_id': '02399b6a-6187-4855-98cf-0eeb5cd5cce3', 'quantite': '200 g'}, {'ingredient_id': 'c7e2df9c-1c3b-4f89-ba52-732f95b54e72', 'quantite': '2'}, {'ingredient_id': '5ee28700-3b29-4358-9ea2-4423a7dfc443', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (309999, 'Smoothie banane & cacahuètes', 'banane, beurre de cacahuètes, miel, lait demi-écrémé', '5 min', ['Éplucher les bananes, les couper grossièrement et mettre au blender.', 'Ajouter le beurre de cacahuète, le miel et le lait.', 'Bien mixer le tout au blender, les servir et déguster !', 'Vous pouvez aussi ajouter de la glace pilée ou mettre au frais 10 min.'], ['Poêle', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'beurre de cacahuètes', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'Smoothie banane & cacahuètes', 'dessert', 'plat de résistance', 'lait demi-écrémé', 'smoothies', 'cocktail'], 'Boisson', cb899660-f95d-4f7c-ba83-41cdde2a8b9a, '2025-09-26T16:29:31.935255', [{'ingredient_id': 'be4f3c02-1f4b-40da-bef5-34e22c3ec046', 'quantite': '2'}, {'ingredient_id': '81cb5c63-0871-4bf4-a9b5-3e108e9653a6', 'quantite': '2 cuillères'}, {'ingredient_id': '3a4b6f88-bcb1-4fa9-8dbb-2e1e79194dd8', 'quantite': '4 cuillères'}, {'ingredient_id': '868968de-15c5-4607-84c9-1ab419e6b8cd', 'quantite': '30 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530426, 'Bouchées bananes, beurre de cacahuète by estellecooking', 'huile de coco, beurre de cacahuètes, noix de cajou, chocolat pâtissier, banane', '15 min', ['Coupez les bananes en deux dans le sens de la longueur.
puis coupez en 3 ou 4 morceaux selon la taille de vos bananes, pour faire des bouchées.', 'Sur la face plate, tartinez ces morceaux de beurre de cacahuète. parsemez de noix de cajou préalablement concassés. déposez sur du papier sulfurisé. Puis mettre au frais quelques minutes.', 'En attendant, faite chauffez au micro-onde ou bain marie, le chocolat pâtissier avec l''huile de coco, pour un rendu plus fluide.', 'Prenez les bouchées du réfrigérateur, puis enrobez-les du chocolat fondu à l''aide de deux fourchettes. ', 'Les remettre sur le papier sulfurisé, et réserver au frais 20/30min pour le chocolat durcir.', 'Déguster ! :) '], ['Ouvre-boîte', 'Louche'], ['noix de cajou', 'entrée', 'banane', 'Bouchées bananes', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'beurre de cacahuètes', 'rapide', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre de cacahuète by estellecooking', 'huile de coco', 'autres confiseries', 'cocktail'], 'Confiserie', 8dd027cb-6af7-445f-9238-31e5fa57ca5a, '2025-09-26T16:29:37.613890', [{'ingredient_id': '321908ad-6221-4942-9588-81ba09cbb1ca', 'quantite': '1 cuillères'}, {'ingredient_id': '798888e6-0aaf-4626-b450-1974a40d4f4a', 'quantite': ''}, {'ingredient_id': '22ade445-6c2e-4797-b013-852c37f67c7b', 'quantite': ''}, {'ingredient_id': 'b63e6fdd-cb6c-4836-812e-6b7be9e8ad4a', 'quantite': '200 g'}, {'ingredient_id': 'e227050a-00e9-4ef9-b6eb-eb2236513297', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (312729, 'Gâteau multifruits', 'fromage blanc, sucre, farine, oeuf, beurre, levure, sucre vanillé, banane, pomme, jus d''orange, rhum, coulis de framboise, sucre glace, crème fraîche, jus de citron', '20 min', ['Préchauffez votre four à 180°C (thermostat 6).', '1. Le gâteau', 'Mélangez tous vos ingrédients (dans l''ordre de la liste) dans un grand saladier.', 'Versez dans un moule préalablement beurré', 'Enfournez pour 25 min de cuisson', '2. Le glaçage', 'Mélangez les ingrédients du glaçage jusqu''à obtention d''une pâte lisse.', 'En recouvrir le gâteau froid à l''aide d''une spatule.'], ['Couteau de chef', 'Tire-bouchon', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'fromage blanc', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'beurre', 'jus d''orange', 'sucre', 'cocktail', 'Gâteau multifruits'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:29:43.056576', [{'ingredient_id': '4cc8ca8a-05c1-4071-9e71-e1b7d402ebc4', 'quantite': '1'}, {'ingredient_id': '57bf3a40-ecaf-40ae-b322-cd25ce609d27', 'quantite': '2'}, {'ingredient_id': '8930d7ce-014a-4cb4-86c7-613bee9c581d', 'quantite': '2.5'}, {'ingredient_id': '08e15c15-09cd-4686-938b-1fb9e83cf071', 'quantite': '2'}, {'ingredient_id': '99152b02-c314-4629-b959-5bc184b9092c', 'quantite': ''}, {'ingredient_id': '6cdac880-7c48-4013-b225-bb5ce997c204', 'quantite': '1'}, {'ingredient_id': '478f3a23-8c78-442f-a269-61835c6ea4a9', 'quantite': '1'}, {'ingredient_id': 'fb0adafa-3d9c-4f3d-b2cd-7d67cbc32d65', 'quantite': ''}, {'ingredient_id': '818b92e6-fd92-49ac-bf4d-9f06751a0fbe', 'quantite': ''}, {'ingredient_id': 'cdbd51d9-c7ec-4aed-953b-96bac3b73ef8', 'quantite': '1.5'}, {'ingredient_id': 'f71af508-0244-491a-8583-ef5760f528a7', 'quantite': '1'}, {'ingredient_id': '59ea16d8-fc17-48c8-9219-a812fe5283bb', 'quantite': '1'}, {'ingredient_id': '9f6ff553-d9f3-4522-a2be-c208d707f36e', 'quantite': '60 g'}, {'ingredient_id': 'b4426050-4caa-412c-a8dc-750f18efb7ad', 'quantite': '2 cuillères'}, {'ingredient_id': '98fdc855-5d70-46a0-aa4b-2ae0da7db33b', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (69756, 'smoothie multifruit aux épices', 'fraises, framboises, banane, kiwi, citron, pomme, gingembre, cannelle, glaçons, menthe', '15 min', ['Couper les fruits en morceaux (kiwi,bananes,fraises,framboises)et les passer à la centrifugeuse (faut devez obtenir une consistance assez épaisse).', 'Y ajouter le jus choisi et le jus de citron, mixer. ', 'Au dernier moment ajouter la menthe, les épices et les glaçons. Mixer!', 'C''est prêt! Bon appétit!'], ['Casserole', 'Rouleau à pâtisserie'], ['gingembre', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'menthe', 'framboises', 'bon marché', 'rapide', 'plat', 'fraises', 'smoothie multifruit aux épices', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'glaçons', 'citron', 'cannelle', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:29:47.824892', [{'ingredient_id': '28c4c52c-b05c-4de9-8871-8a7161de127e', 'quantite': '150 g'}, {'ingredient_id': '088efade-bb58-473b-939f-52f41eea1426', 'quantite': '100 g'}, {'ingredient_id': '50e13503-e8f0-42f4-bf2a-540794cc352c', 'quantite': '2'}, {'ingredient_id': 'cb34b9a5-6032-42a5-9057-c61a6d3297cc', 'quantite': '1'}, {'ingredient_id': '0baad460-a7e8-4a80-8d5b-f24aa2310a69', 'quantite': ''}, {'ingredient_id': 'e743f80e-e3a4-41f1-a939-26e8e5483723', 'quantite': '25 cl'}, {'ingredient_id': '6fe9f9ad-e557-4f81-a063-c075670e10ac', 'quantite': '1'}, {'ingredient_id': '06eaf061-88b5-4a54-839c-70493df176a3', 'quantite': '1'}, {'ingredient_id': 'bb6561e1-5eb0-4538-b12c-aa2b139347c7', 'quantite': '5'}, {'ingredient_id': '4ea07a01-d4bc-4dad-ac9d-1305b104e333', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (39395, 'Cocktail multvitaminé', 'orange, pamplemousse, raisin, pomme, fruits rouges, orange, banane, pamplemousse, kiwi', '30 min', ['C''est déjà fini!', 'Sauf qu''il faut attendre que la préparation rafraîchisse, avant de pouvoir la déguster! ', 'Allez, un peu de patience !'], ['Poêle', 'Pince de cuisine', 'Râpe'], ['', 'raisin', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'fruits rouges', 'recette', 'cuisine', 'recettes', 'boisson', 'Cocktail multvitaminé', 'dessert', 'plat de résistance', 'pamplemousse', 'pomme', 'moyen', 'orange', 'cocktail'], 'Boisson', 7ca4f273-560c-4b0b-aa9f-a41454529dce, '2025-09-26T16:29:51.566426', [{'ingredient_id': 'ad02b0a4-13a9-4a1b-83f1-53839b9b2306', 'quantite': '1 l'}, {'ingredient_id': 'ec66a40b-8340-4a28-b7b4-0615944661d6', 'quantite': ''}, {'ingredient_id': '400b2ab5-68df-459c-9c2a-66a6f10180b0', 'quantite': ''}, {'ingredient_id': '823912da-f1f2-42b2-80b9-e7795ee4c597', 'quantite': ''}, {'ingredient_id': '612525b8-3d95-403a-8db9-ec558838f20b', 'quantite': '2'}, {'ingredient_id': '4e9bcd2e-508f-4032-8d2b-ccac96a541a2', 'quantite': '3'}, {'ingredient_id': '05086ead-7bb8-43e8-8f80-3fbd31919685', 'quantite': ''}, {'ingredient_id': '51959c31-178c-452f-b2fc-3e0fd7d0f5de', 'quantite': ''}, {'ingredient_id': '92db289e-6c1d-4802-83d9-423039b1e283', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16275, 'Punch antillais', 'rhum, jus d''orange, jus d''ananas, jus de banane, clou de girofle, muscade, cannelle, citron vert, vanille', '15 min', ['Mélanger le tout et laisser macérer 3-4 jours.'], ['Râpe', 'Casserole', 'Poêle', 'Couteau de chef'], ['entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'muscade', 'très facile', 'rapide', 'plat', 'jus de banane', 'recette', 'cuisine', 'recettes', 'boisson', 'clou de girofle', 'Punch antillais', 'vanille', 'punch', 'dessert', 'plat de résistance', 'jus d''ananas', 'moyen', 'jus d''orange', 'citron vert', 'cannelle', 'cocktail'], 'Boisson', 633608e6-3a76-4ac5-8759-bf18e371b2a7, '2025-09-26T16:29:57.609143', [{'ingredient_id': '4812b718-610f-4f10-ad5d-5a04f4768007', 'quantite': '1 l'}, {'ingredient_id': '291e29f0-52ed-4501-8d94-45b56f0d704c', 'quantite': '1 l'}, {'ingredient_id': '7d8a43b6-9c62-4ae4-b658-bb13c8a82e28', 'quantite': '1 l'}, {'ingredient_id': '89c2fbc1-81dd-4d51-80ef-665d0fcc85d9', 'quantite': '1 l'}, {'ingredient_id': '454423dd-92a5-4fc4-976c-f8afd6c8eac0', 'quantite': '6'}, {'ingredient_id': '61fd0493-f831-4bde-b0a9-6f524e41df59', 'quantite': ''}, {'ingredient_id': 'f207a0ee-b88a-4354-9038-4382105778cf', 'quantite': ''}, {'ingredient_id': '213f830a-6d36-4e50-a9da-f122ee782735', 'quantite': '1'}, {'ingredient_id': '661a0700-564c-4091-a471-914041fa392d', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (223466, 'Cupcake à la Banane', 'oeuf, beurre, farine, sel, sucre, levure, banane, lait, pâte à tartiner', '15 min', ['Mélanger les œufs et le sucre, au fouet de préférence. Le mélange va devenir un peu mousseux, et blanc.', 'Ajouter le lait, la farine, le beurre fondu, la levure, le sel.', 'La pâte est homogène. Ajouter enfin les bananes écrasées.', 'Verser dans les moules, maximum aux 2/3.', 'Mettre au four pendant 20 min à 180°C (thermostat 6), l''intérieur va rester moelleux (pas cuit).', 'Ensuite, glacer avec de la pâte à tartiner au chocolat avant de déguster.'], ['Pince de cuisine', 'Moule à tarte', 'Fouet', 'Planche à découper', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'Cupcake à la Banane', 'cupcake', 'sucre', 'lait', 'cocktail', 'pâte à tartiner'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:30:01.113147', [{'ingredient_id': 'adfe3180-a2dc-4aa7-888a-1bff764f9f4c', 'quantite': '2'}, {'ingredient_id': '580f52b7-869f-497c-9d3c-446acd011c34', 'quantite': '40 g'}, {'ingredient_id': '55dd2d26-4e3e-4d40-88ab-d7fb9effe37d', 'quantite': '90 g'}, {'ingredient_id': '40457a10-9cf9-463a-be3d-7635a61bc3d2', 'quantite': '1'}, {'ingredient_id': '2b454224-65b2-4935-95d3-67e9c8543fb0', 'quantite': '45 g'}, {'ingredient_id': 'e28bdb94-2351-4ed9-9f62-de63683c6b3b', 'quantite': '1 cuillères'}, {'ingredient_id': '6c110fb6-49f4-400d-a204-2248d5efd127', 'quantite': '3'}, {'ingredient_id': '5d8ce7db-a349-450f-af09-facfcca2aa82', 'quantite': '1 cuillères'}, {'ingredient_id': '84bb13a5-067a-4db4-a9e4-37f539d02262', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42061, 'Tarte à la banane façon crumble', 'pâte brisée, compote, banane, farine, sucre, amandes en poudre, beurre', '15 min', ['Prechauffez votre four à 220°C (thermostat 7-8).', 'Faites cuire la pâte à blanc, pendant 10 min.', 'Etalez la compote sur la pâte.', 'Epluchez, et coupez les bananes en rondelles, puis disposez-les sur la compote.', 'Dans un saladier, mélangez la farine, le sucre, la poudre d''amande, et le beurre.', 'Répartissez le crumble obtenu, sur les bananes.', 'Placez votre tarte à mi-hauteur, et faites dorer 10 min.'], ['Batteur électrique', 'Mixeur', 'Spatule', 'Fouet', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'amandes en poudre', 'plat', 'tarte à la banane', 'recette', 'compote', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'Tarte à la banane façon crumble', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:30:04.744637', [{'ingredient_id': '53cd14a0-673b-4aa0-8807-0b1ffaa7f296', 'quantite': '1'}, {'ingredient_id': '26761fef-37ad-4e40-9dd4-000960a5585e', 'quantite': '200 g'}, {'ingredient_id': 'eee06c0b-2ad4-472d-b6fc-e1f517362d77', 'quantite': '3'}, {'ingredient_id': 'c2036888-c7d2-437a-843d-6a52f7506b0b', 'quantite': '90 g'}, {'ingredient_id': 'b4ff5866-ffb8-44ca-9da0-ab5623509667', 'quantite': '50 g'}, {'ingredient_id': '7a882c65-0fb0-41a5-a2c1-9cefafcc642d', 'quantite': '50 g'}, {'ingredient_id': '9d9c123d-eb76-4a42-8ac2-d8bb92c55840', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (49677, 'Brochettes de fruits chocolatées', 'chocolat noir, banane, nectarine, kiwi, ananas', '25 min', ['Couper les fruits en morceaux assez gros.', 'Alterner les morceaux sur 4 pics à brochettes en bois, puis réserver au réfrigérateur.', 'Faire fondre le chocolat au micro-ondes avec 1 cuillère à  soupe d''eau (plus si nécessaire pour que le chocolat ne soit pas trop pâteux).', 'Avec 1 petite cuillère, napper chaque brochette de chocolat fondu et remettre au réfrigérateur jusqu''à ce que le chocolat durcisse.', 'Déguster.'], ['Pince de cuisine', 'Rouleau à pâtisserie', 'Louche', 'Râpe', 'Presse-agrumes'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'nectarine', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'ananas', 'Brochettes de fruits chocolatées', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:30:08.623044', [{'ingredient_id': '8dec749f-d1a1-43d0-a05c-d9b0b19df86d', 'quantite': '150 g'}, {'ingredient_id': 'b0de9c6b-0eb7-4405-8461-2746ab8fd437', 'quantite': '1'}, {'ingredient_id': '6783f98e-ee55-4a1d-ace3-ea4057ed37ca', 'quantite': '2'}, {'ingredient_id': 'f11ebf35-2a4e-4a85-bf46-61f5cdcb941c', 'quantite': '1'}, {'ingredient_id': 'e0b422ff-7f22-4d5c-a082-d1a03ce0da4c', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81534, 'Tiramisu à la banane et à la noix de coco', 'mascarpone, sucre, banane, noix de coco, café, spéculoos, oeuf, sel, sucre vanillé', '30 min', ['Monter les blancs d''oeufs en neige ferme avec la pincée (petite) de sel.', 'Ecraser les bananes et les mélanger aux jaunes d''oeuf et au sucre. Incorporer le mascarpone.', 'Ajouter la noix de coco et le sucre vanillé.', 'Ajouter délicatement les blancs d''oeuf battus en neige.', 'Ecraser les spéculoos.', 'Pour un tiramisu (familial):', 'Tapisser de façon homogène le fond d''un plat à gratin avec la moitié des biscuits écrasés.', 'Arroser avec la moitié de la tasse de café.', 'Verser la moitié de la préparation.', 'Recommencer l''opération en gardant l''équivalent de 3 cuillères à soupe de biscuits émiettés, qui sera ajouté en décoration finale. (Il est possible d''ajouter une petite quantité de chocolat en poudre)', 'Pour 8 tiramisus individuels (verrines ou verres à vin),', 'les quantités sont chronologiquement:', '- 2 à 3 cuillères à café de spéculoos', '- 2 cuillères à café de café', '- 2 cuillères à soupe de préparation', '- 2 cuillères à café de spéculoos', '- 1 cuillères à café de café', '- 2 cuillères à soupe de préparation', '- 1 cuillère à café de spéculoos', '- 1 pincée de cacao', 'Laisser au minimum 2h au réfrigérateur, une nuit entière c''est encore mieux !', 'Bon appétit !'], ['Poêle', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'Tiramisu à la banane et à la noix de coco', 'recette', 'café', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'tiramisu', 'noix de coco', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:30:12.384501', [{'ingredient_id': '419d8c47-6ec7-4317-a21a-1a37d9ded57e', 'quantite': '250 g'}, {'ingredient_id': '1d9136b3-b4f0-414e-8a80-4b7f657bdcc5', 'quantite': '75 g'}, {'ingredient_id': '914b3d2a-1f05-4989-8659-b3c42a60f071', 'quantite': '2'}, {'ingredient_id': '1825799a-9058-40ba-b631-640bea6bde87', 'quantite': '100 g'}, {'ingredient_id': '4b28769e-f520-49a1-9f0f-8abda7caf3ec', 'quantite': '1'}, {'ingredient_id': '1390136a-20fc-46aa-8d59-efa210739599', 'quantite': '1'}, {'ingredient_id': '4417f572-0c2b-4fd7-ae86-d244c187e8a7', 'quantite': '3'}, {'ingredient_id': '6a5124d7-cba6-475f-83bc-bf7511f325de', 'quantite': '1'}, {'ingredient_id': '8e518624-33a7-4653-93b3-e9144d9fcd69', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (53116, 'Farandole de fruits secs au mascarpone', 'banane, pruneau, abricot, figue, muscat, miel, cannelle, amandes, mascarpone, crème fraîche, sucre roux, muscat', '20 min', ['Découper les bananes en rondelles et les fruits secs en cubes à l''aide d''une paire de ciseaux.', 'Les mettre dans un grand bol et les recouvrir avec 20 cl de muscat, afin que les fruits soient imprégnés; réserver au frais.', 'Mettre le mascapone dans un grand bol, aajouter la crème fraîche, le sucre et les 10 cl de muscat; bien mélanger au fouet. Réserver au frais.', 'Sortir les fruits du frigo après 15 min de macération et verser le tout dans un wok, à feu fort et sans couvrir, afin que le muscat s''évapore. ', 'Y ajouter les cuillères à soupe de miel et la cannelle et laisser mijoter jusqu''à obtention d''une sauce épaisse et jusqu''à ce que les bananes aient rétréci un peu et soient toutes molles.', 'Préparer quatre bols, couvrir le fond de la préparation fruitée et recouvrir ensuite d''une couverture épaisse du mélange à base de mascarpone. ', 'Alterner les couches, pour des coupelles hautes; ou faire juste une couche de chaque, si les coupelles sont plates et larges.', 'Recouvrir le tout de noix ou amandes grillées (facultatif).', '7) Bon appétit!'], ['Râpe', 'Couteau de chef'], ['', 'amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'pruneau', 'abricot', 'très facile', 'rapide', 'figue', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'muscat', 'moyen', 'Farandole de fruits secs au mascarpone', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:30:16.177102', [{'ingredient_id': 'f65f5744-26f5-47eb-b8a5-ed00a0c4e421', 'quantite': '2'}, {'ingredient_id': '8f5c0f1e-2113-4290-96b7-05bf0f1c8808', 'quantite': '12'}, {'ingredient_id': 'd30d3b84-b87e-4127-87cf-b2737d4f1487', 'quantite': '12'}, {'ingredient_id': '3033842b-77b2-4b1e-927f-6c5f8fc7ca9f', 'quantite': '12'}, {'ingredient_id': '20dd391e-5925-49ce-a283-9339a25d5082', 'quantite': '20 cl'}, {'ingredient_id': '7fbd6285-b2ba-4569-ae9b-44288a73e03e', 'quantite': '3 cuillères'}, {'ingredient_id': '428e8e99-d77c-4d59-9527-1450bc79eccd', 'quantite': ''}, {'ingredient_id': 'b925d161-d76a-420d-9622-1dddad053eb6', 'quantite': ''}, {'ingredient_id': 'd3aa7e83-53c9-465c-87ee-166754b3b46b', 'quantite': '500 g'}, {'ingredient_id': '8af73010-133c-4b38-a3fa-00e65ec4f95d', 'quantite': '15 cl'}, {'ingredient_id': 'bdcc5f1f-60f1-4b9c-9ffe-0d188cc98684', 'quantite': '20 g'}, {'ingredient_id': 'fa235d93-1c64-4501-9354-add540302f05', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (537164, 'Banana bread au Airfryer', 'banane, oeuf, farine, levure chimique, cannelle, sucre, sel, huile de coco', '10 min', ['Pelez les bananes et écrasez-les à la fourchette dans un grand saladier. Ajoutez le sucre Rapadura en poudre ainsi que la cannelle et mélangez.', 'Cassez les deux œufs dans le saladier et mélangez à nouveau en incorporant la farine progressivement. Ajoutez une pincée de sel et remuez jusqu’à l’obtention d’un appareil homogène.', 'Graissez un moule à cake avec un peu d’huile de coco (si vous n’en avez pas, utilisez une huile neutre). Versez l’appareil à banana bread dans le moule. Placez le moule dans le Airfryer et faites cuire à 180 °C durant 30 minutes. Laissez tiédir avant de servir.'], ['Spatule', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Banana bread au Airfryer', 'sel', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'huile de coco', 'cannelle', 'sucre', 'cocktail'], 'Dessert', dd203e43-1007-44d2-9a85-09c8363d1742, '2025-09-26T16:30:21.288865', [{'ingredient_id': '8c71039d-e023-4196-ab5e-8e621b20a3d4', 'quantite': '3'}, {'ingredient_id': '65522c56-7910-4aa8-a43a-59070db73cf3', 'quantite': '2'}, {'ingredient_id': 'bcff671e-3e7d-4585-97f0-092fc59bd279', 'quantite': '150 g'}, {'ingredient_id': '4ff1f62d-60c0-472c-88ff-9ac5fa577971', 'quantite': '1 cuillères'}, {'ingredient_id': '34ad5a14-4842-4fdf-a2ae-f4162c99c57a', 'quantite': '1 cuillères'}, {'ingredient_id': 'c47ae314-367a-4595-a936-3d3fc40f907f', 'quantite': '1 cuillères'}, {'ingredient_id': '6e41e78a-815b-47ff-90aa-d89413070fa2', 'quantite': '1'}, {'ingredient_id': 'f0fe9dcd-f1a5-4856-8a00-0c59c5c83a18', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81405, 'Pain aux bananes et noix', 'beurre, sucre brun, oeuf, farine, levure chimique, sel, lait, banane, extrait de vanille, Noix concassée', '20 min', ['Chauffer le four à 180°C (thermostat 6). Beurrer un moule à cake.', 'A l''aide d''un batteur électrique, mélanger le beurre et le sucre jusqu''à obtenir une crème homogène. Ajouter un oeuf, mélanger soigneusement puis ajouter le deuxième oeuf. ', 'Ajouter ensuite la moitié de la farine mélangée à la levure chimique et au sel. Ajouter le lait puis le reste de farine.', 'Ecraser les bananes et les incorporer dans la mixture avec l''extrait de vanille et les noix. Verser le mélange dans le moule et lisser la surface avec une spatule.', 'Cuire durant environ 1 h jusqu''à ce qu''un couteau inséré ressorte propre et non collant. Protéger la surface avec du papier cuisson si elle brunit trop vite.', 'Laisser refroidir dans le moule au moins 20 min avant de démouler. ', 'Saupoudrer de sucre glace. Couper en tranches épaisses et servir chaud ou à température ambiante.'], ['Moule à tarte', 'Pince de cuisine', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'extrait de vanille', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'sucre brun', 'dessert', 'plat de résistance', 'Noix concassée', 'beurre', 'lait', 'cocktail', 'Pain aux bananes et noix'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:30:24.897397', [{'ingredient_id': 'd51d8937-c0a9-49a4-b015-19e5fd8cc403', 'quantite': '125 g'}, {'ingredient_id': '540f16a9-77f6-4f5f-b1c4-2c0a9fc6351a', 'quantite': '175 g'}, {'ingredient_id': '7b81456e-7467-4662-9719-f8e6065d4f37', 'quantite': '2'}, {'ingredient_id': 'bb573f4a-177c-46f7-a07c-d220710b4076', 'quantite': '280 g'}, {'ingredient_id': '80ff9617-ee29-4611-9569-2a922e095a42', 'quantite': '1'}, {'ingredient_id': '056fc0db-5956-476e-80b3-c186ed691152', 'quantite': '1'}, {'ingredient_id': '49eb0298-7dc7-4fec-a3fe-9e135cd78323', 'quantite': '125 ml'}, {'ingredient_id': 'f3bf20bb-22f3-4c08-a529-aaf3ec9163f0', 'quantite': ''}, {'ingredient_id': '33fb3a6a-09b4-4a79-bef8-1c9ff7aa73db', 'quantite': '1 cuillères'}, {'ingredient_id': 'f87e9de3-6611-4fd1-8195-431f35dde6b0', 'quantite': '75 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (227918, 'Crumble banane-chocolat aux flocons d''avoine', 'banane, chocolat noir, flocons d''avoine, farine, beurre demi-sel, cassonade', '10 min', ['Préchauffez le four à 180°C (thermostat 6).', 'Dans un saladier mélangez tous les ingrédients du crumble.', 'Emiettez cette pâte du bout des doigts. Pelez les bananes et détaillez-les en rondelles. Coupez le chocolat en petits morceaux. Répartissez les bananes et le chocolat dans 4 petits ramequins. Saupoudre zde pâte à crumble.', 'Enfournez et laissez cuire 20 à 25 min. Servez tiède ou froid.'], ['Fouet', 'Ouvre-boîte', 'Passoire', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Crumble banane-chocolat aux flocons d''avoine', 'crumble banane', 'testées', 'cassonade', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'beurre demi-sel', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'flocons d''avoine', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:30:28.822406', [{'ingredient_id': '3155e7fa-2aa5-41f5-9a7a-7c10d7b835f4', 'quantite': '2'}, {'ingredient_id': 'b45747c7-a272-40f3-b6f6-360744c34754', 'quantite': '100 g'}, {'ingredient_id': 'e33284b5-accb-4bfc-ad8b-f499f60c20d2', 'quantite': '80 g'}, {'ingredient_id': '0ef292dc-728b-43b2-b654-3fdb6a4b4aa5', 'quantite': '80 g'}, {'ingredient_id': 'b144d542-ff86-4e12-a814-63e296527e65', 'quantite': '80 g'}, {'ingredient_id': '949bc5ba-3679-4dfc-b1e4-7e1a8f4955d1', 'quantite': '80 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (221087, 'Verrines surprise en chocolat', 'oeuf, spéculoos, crème dessert à la vanille, banane, clémentine', '15 min', ['Mettre les œufs surprise au congélateur 15 à 20 min. En attendant, émietter spéculoos.', 'Couper la banane (la moitié suffit largement) en fines tranches puis les découper en 4 quartiers.', 'Préparer un couteau avec une lame très chaude et sortir les œufs. Couper le haut de l’oeuf afin de pouvoir extraire la surprise.', 'Mettre l’équivalent d’un 1/2 spéculoos au fond. Ajouter 2 cuillères à café de crème dessert à la vanille.', 'Déposer une dizaine de quartiers de banane au dessus de la crème. Terminer par un quartier de clémentine... et voilà !', 'Reste à déposer l’oeuf sur un coquetier, sortir vos plus petites cuillères et faire déguster !', 'A décliner à l’infini avec d’autres biscuits, crèmes et fruits. Jamais les enfants n’auront autant aimé les verrines !'], ['Verre doseur', 'Batteur électrique'], ['', 'crème dessert à la vanille', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'rapide', 'oeuf', 'plat', 'Verrines surprise en chocolat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'clémentine', 'dessert', 'plat de résistance', 'moyen', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:30:34.319470', [{'ingredient_id': '96d39b68-ae93-483b-b38b-dbf0f503cbab', 'quantite': '8'}, {'ingredient_id': 'ca0aa868-5a0e-4136-ab38-a7ec4232368a', 'quantite': '4'}, {'ingredient_id': 'e6e085eb-315a-408c-a373-01304825659d', 'quantite': '350 g'}, {'ingredient_id': '821da982-0cd0-4052-93a4-ec4bbb9055c2', 'quantite': '1'}, {'ingredient_id': '7af7fc1f-ee23-4320-b18e-8782cc63a1fb', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (347963, 'Sucettes de fruit au chocolat', 'banane, kiwi, chocolat pâtissier, noix de coco rapée', '10 min', ['Eplucher les fruits et les couper en rondelles épaisses. ', 'Faire fondre le chocolat au bain-marie ou au micro-ondes. ', 'Piquer les rondelles de fruits sur des pics en bois, tremper dans la chocolat fondu et parsemer de coco râpée. ', 'Laisser durcir avant de déguster.'], ['Poêle', 'Casserole', 'Passoire'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Sucettes de fruit au chocolat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:30:37.919835', [{'ingredient_id': 'e45f1f0d-cf4a-4f03-9f43-defc173d58f2', 'quantite': '1'}, {'ingredient_id': 'c16535ab-dad6-42e8-80c7-ceac41c1f788', 'quantite': '1'}, {'ingredient_id': '3994758d-90aa-4234-9006-ac3d17895192', 'quantite': '150 g'}, {'ingredient_id': '9764d782-9b38-4dbe-a923-060abd654e69', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65736, 'Cake Yaourt Banane et Noix de Mike (Banana Walnut Yogourt Cake)', 'yaourt, compote, farine, sucre de canne, huile, oeuf, levure, sel, noix', '10 min', ['Mélanger le yaourt, la compote, les 3 oeufs, le sucre, l’huile, la levure, le sel, et en dernier la farine.', 'Mixer le tout.', 'Préchauffer le four entre 160°C et 180°C (thermostat 5-6) (tout dépend de vos habitudes, de votre four, le mien est à chaleur tournante, et je règle la grille à mi-hauteur, en ne chauffant que le bas).', 'Bien huiler le moule, et c’est parti !', 'Pour la cuisson, approximativement 20 à 30 minutes, en fait c''est au test du planter de couteau !', 'P.S. : Si comme moi vous avez un four assez puissant, pensez à surveiller le dessus du cake afin qu’il ne brûle pas, ne pas hésiter à le recouvrir d’une feuille de papier d’aluminium.'], ['Passoire', 'Louche'], ['entrée', 'recettes de cuisine', 'yaourt', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'compote', 'cuisine', 'levure', 'noix', 'recettes', 'boisson', 'huile', 'farine', 'sucre de canne', 'autres cakes', 'dessert', 'plat de résistance', 'Cake Yaourt Banane et Noix de Mike (Banana Walnut Yogourt Cake)', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:30:41.705040', [{'ingredient_id': '8d701b93-cf17-4ff8-b885-03f5a3b5e9c4', 'quantite': '1'}, {'ingredient_id': '66c90a92-a030-42c7-83bf-d763425a14b2', 'quantite': '1'}, {'ingredient_id': '644e2436-4e82-4004-89ec-3c98fd26aff9', 'quantite': '3'}, {'ingredient_id': '3c5e9d56-dfd7-4ae1-b5ea-edf16ad333f9', 'quantite': '2'}, {'ingredient_id': 'a7711e1b-f076-4892-bb1d-af23b3fa2f57', 'quantite': ''}, {'ingredient_id': '24daa2a5-818c-4ee7-9e34-7c69bce6d1db', 'quantite': '3'}, {'ingredient_id': 'c6d01d32-b3c8-42da-a69b-c9422077340d', 'quantite': '1'}, {'ingredient_id': '678dfecb-f459-432a-b37e-0a5969cc3081', 'quantite': '1'}, {'ingredient_id': 'b067c4b8-8617-4f5d-b7b8-ba7eb171a9eb', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530495, 'Banana p''tit déj', 'fromage blanc, banane, cacao, sucre en poudre, noisettes', '5 min', ['Coupe la banane en fines rondelles.', 'Mélange le chocolat, le sucre, le fromage blanc et les bananes.', 'Ajouter quelques noisettes et tranches de banane.'], ['Économe', 'Mixeur', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Granola', 'très facile', 'bon marché', 'cacao', 'rapide', 'plat', 'sucre en poudre', 'recette', 'noisettes', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'Banana p''tit déj', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T16:30:46.664289', [{'ingredient_id': '82160644-5e17-4b96-b2e7-9ccc300400a3', 'quantite': '25 cl'}, {'ingredient_id': '8c7da9f9-da60-4bf3-b1cb-6386fb2130ab', 'quantite': '1'}, {'ingredient_id': '26f15ffe-b6b4-4356-8156-c16a36c3c922', 'quantite': '2'}, {'ingredient_id': '913245b7-3dac-49c1-9f5e-e1fb5609eb4c', 'quantite': '2 cuillères'}, {'ingredient_id': '803207b9-9394-4099-bc49-a1a619054e28', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (44815, 'Crumble au miel', 'farine, sucre roux, beurre, pomme, banane, mangue, noix de coco rapée, cannelle, miel liquide', '15 min', ['Dans un saladier, mélanger la farine, le sucre, le beurre coupé en petits dés, et la noix de coco râpée.', 'Malaxer le tout, jusqu''à obtention d''une sorte de gros sable.', 'Beurrer un plat.', 'Disposer au fond du plat, les fruits coupés en petits morceaux, la cannelle et le miel.', 'Recouvrir le tout avec la pâte.', 'Enfourner 15 à 20 min, à th 6-7 (200°C).', 'Laisser refroidir, et déguster le crumble tiède... avec une boule de glace à la vanille et de la chantilly.'], ['Moule à tarte', 'Mixeur'], ['miel liquide', 'Crumble au miel', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'noix de coco rapée', 'dessert', 'plat de résistance', 'pomme', 'autres crumbles', 'beurre', 'cannelle', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:30:50.354695', [{'ingredient_id': 'eee5fba1-4572-48c0-b7af-40510c1f3dcf', 'quantite': '200 g'}, {'ingredient_id': '83d2c25d-1191-4c2f-bc9c-a6125182f22c', 'quantite': '100 g'}, {'ingredient_id': 'd231540f-fa04-4d11-95a0-1773cc91a25d', 'quantite': '100 g'}, {'ingredient_id': '1f8783e8-250b-4f16-ac29-db14cfc23f80', 'quantite': '2'}, {'ingredient_id': '6d9fac93-3c24-4c94-beff-255886a12332', 'quantite': '2'}, {'ingredient_id': '0f57fa20-3ffc-4c22-9ca2-4b9b53da6a26', 'quantite': '1'}, {'ingredient_id': 'fa2fb174-5087-471b-bcc1-a7e9a3c8b78e', 'quantite': '1 cuillères'}, {'ingredient_id': '1afe823a-cbf2-49ad-a2d8-b12f4903006c', 'quantite': ''}, {'ingredient_id': '4845269c-7d33-4d3e-aec5-eb3eb3e1bd38', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528573, 'Tartelettes sans sucre banane chocolat', 'banane, chocolat noir, yaourt, cacao amer, noix de coco rapée, datte, flocons d''avoine', '10 min', ['Mixer les flocons d''avoine, les dattes dénoyautés et la noix de coco râpé jusqu''à obtenir un mélange compact.', 'Étaler finement avec les doigts dans des fonds de tarte individuels.', 'Placer au frais pendant minimum 3h.', 'Écraser la banane et la mettre dans une casserole avec le chocolat en poudre, le chocolat noir et le yaourt. Faire fondre à feux doux.', 'Verser la ganache dans les fonds de tarte et placer au frais pendant 15min.', 'Décorer, et c''est prêt !'], ['Passoire', 'Verre doseur', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'cacao amer', 'confiserie', 'testées', 'tarte', 'rapide', 'plat', 'moyenne', 'Tartelettes sans sucre banane chocolat', 'recette', 'datte', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'chocolat noir', 'moyen', 'flocons d''avoine', 'cocktail'], 'Dessert', 03516cbf-1178-4cab-9794-39f566889cf7, '2025-09-26T16:30:55.360732', [{'ingredient_id': '38c9bf85-69fd-4ac1-83d2-73a0af91f2d1', 'quantite': '1'}, {'ingredient_id': '246820ed-d55e-400f-810b-8e4457f99d66', 'quantite': '100 g'}, {'ingredient_id': 'd52dce7c-3d44-4965-a4bd-9f9b5ae7214b', 'quantite': '2 cuillères'}, {'ingredient_id': '5d651fef-2cf2-47e7-a2f9-09e8e22bec9e', 'quantite': '2 cuillères'}, {'ingredient_id': '6a769c80-c409-40f0-bcc5-915f5bcbb683', 'quantite': '75 g'}, {'ingredient_id': 'dd4e3e61-9614-43a0-acbd-b34870fe9875', 'quantite': '200 g'}, {'ingredient_id': '69921129-21eb-4574-991a-6ab1fcd31f59', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (172508, 'Banane au nutella', 'banane, Nutella, crème chantilly', '5 min', ['Épluchez et coupez votre banane en rondelles.', 'Faire fondre 1 à 2 cuillères à soupe de nutella (selon votre goût) dans un récipient adapté au micro-ondes  environ 10 à 15 secondes.', 'Faites ensuite couler le nutella sur les rondelles de banane.', 'Pour les plus gourmands, ajoutez de la chantilly par dessus.'], ['Rouleau à pâtisserie', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'Banane au nutella', 'Nutella', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:30:58.915964', [{'ingredient_id': 'b3f38058-4888-4eb7-bd42-699f1efa4888', 'quantite': '1'}, {'ingredient_id': 'e358f3b1-85a6-4cdd-ad68-51ea0b2b1b6b', 'quantite': '1 cuillères'}, {'ingredient_id': 'eaf1fec8-5da7-4ecc-b202-e6510bf79ed9', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (80003, 'banane grillée à la confiture', 'banane, confiture', '5 min', ['Coupez la banane en 2 dans le sens de la longueur. ', 'Faites-la chauffer à la poêle. ', 'Lorsque les 2 côtés sont légèrement grillés, éteignez le feu et recouvrez la banane de confiture. ', 'Laissez chauffer la confiture quelques secondes et servez. ', 'A manger chaud!'], ['Fouet', 'Louche', 'Balance de cuisine', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'confiture', 'testées', 'banane grillée à la confiture', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:31:04.295667', [{'ingredient_id': '6ef5794b-817c-4b0a-990d-0cd247e18bd7', 'quantite': '1'}, {'ingredient_id': '484ebe47-d34d-4291-b7f2-764f388cad62', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (69048, 'Salade de fraises, kiwis, bananes, citron', 'fraises, kiwi, banane, jus de citron, sucre glace, menthe', '15 min', ['Equeuter et laver rapidement les fraises, les égoutter et les couper en morceaux.', 'Eplucher et couper les kiwis, faire de même avec les bananes.', 'Mettre tous les fruits dans un joli saladier (transparent). Mélanger avec le jus du citron et un peu de sucre glace au moment de servir.', 'Décorer de feuilles de menthe.', 'Servir très frais.'], ['Ouvre-boîte', 'Moule à tarte', 'Passoire', 'Batteur électrique'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Salade de fraises', 'menthe', 'bon marché', 'kiwis', 'rapide', 'bananes', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'citron', 'sucre glace', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:31:07.698008', [{'ingredient_id': '72680619-e898-4c30-a50b-a3a4598eb970', 'quantite': '1'}, {'ingredient_id': 'c9d0c9bf-f12e-44aa-991b-9b012bf51203', 'quantite': '3'}, {'ingredient_id': 'e3c2604b-c4f5-4380-a5bd-bafccddbe47c', 'quantite': '2'}, {'ingredient_id': 'b2cf9524-24c7-4ffe-a0ac-95d80889ea59', 'quantite': '1'}, {'ingredient_id': '102e0e0a-da42-41a0-806d-40c704e3a4dc', 'quantite': ''}, {'ingredient_id': '9afb6385-8420-4b69-bdad-4c2eec0386e0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50869, 'Milk-Shake Banane Nutella', 'banane, glace vanille, lait, yaourt nature, chocolat en poudre, Nutella, glaçons', '5 min', ['Dans un blender ou un mixer, déposer les bananes préablement coupées en morceaux.', 'Ajouter le lait, le chocolat en poudre, le Nutella, le yaourt,  la glace ainsi que les glaçons.', 'Mixer le tout pendant environ 2 minutes.', 'Server dans de grands verres et laisser reposer quelques instants, pour qu''une légère mousse se forme.', 'Petite astuce : si la pate à tartiner colle trop à votre cuillère, faites la réchauffer un peu au micro onde.'], ['Moule à tarte', 'Tire-bouchon', 'Verre doseur', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'Nutella', 'dessert', 'plat de résistance', 'glaçons', 'lait', 'Milk-Shake Banane Nutella', 'chocolat en poudre', 'cocktail'], 'Boisson', 103637ef-6749-442a-8ab6-b012e0d89834, '2025-09-26T16:31:11.479938', [{'ingredient_id': '7bafecb1-fe5e-4e65-8c51-06c4eff13438', 'quantite': '2'}, {'ingredient_id': '058a1e8b-30a4-4c5b-97ac-6840f9bbe4f1', 'quantite': '4'}, {'ingredient_id': '9695c9c1-50cc-4d8c-8b3b-f158c0f672a0', 'quantite': '30 cl'}, {'ingredient_id': 'd2b93139-b599-4c65-bc81-79da0ebabe3a', 'quantite': '1'}, {'ingredient_id': '2bdedfa5-bdcd-4ea6-bf0e-5a0720e1dcf5', 'quantite': '5 cuillères'}, {'ingredient_id': '5a3cf568-19f4-4f1c-80d6-e07c686ea2b8', 'quantite': '1 cuillères'}, {'ingredient_id': 'ac155069-65ec-4075-a629-30bdf53b7c63', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32343, 'Tarte à la banane meringuée', 'pâte brisée, oeuf, sucre, lait, vanille, banane, amandes, chocolat', '30 min', ['Etalez la pâte. Garnissez-en le moule avec le papier sulfurisé et piquez-la. ', 'Faite cuire le fond de tarte pendant 15 mn environ à 200°C (Th 6). ', 'Pendant ce temps préparer la garniture. ', 'Faites infuser la vanille liquide dans le lait chaud. Battez 1 oeuf entier + 2 jaunes (ne jetez pas les blancs !) avec 50 g de sucre. ', 'Ajoutez les pépites de chocolat et les amandes puis les bananes coupées en petits morceaux. Versez le lait bouillant sur ce mélange. ', 'Remplissez le fond de tarte précuit avec la garniture. Faites cuire à nouveau 20 mn à 220°C (Th 7). ', 'Pendant cette cuisson, préparez la meringue en mélangeant délicatement 65 g de sucre au 2 blancs d''oeuf battus en neige. ', 'Etaler cette meringue sur la tarte et repasser au four 5 mn à 220°C (Th 7). ', 'Servez froid. ', 'BON APPÉTIT !!'], ['Moule à tarte', 'Ouvre-boîte'], ['amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'oeuf', 'plat', 'moyenne', 'tarte à la banane', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'moyen', 'sucre', 'lait', 'Tarte à la banane meringuée', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:31:15.351718', [{'ingredient_id': 'b1fd8803-87a7-4241-a7a6-c44e3fbc8ee3', 'quantite': '300 g'}, {'ingredient_id': '421f48b3-a450-47f1-82ed-348135d642c9', 'quantite': '3'}, {'ingredient_id': '80caf5b1-a803-4756-91d5-3e7cf85b24d8', 'quantite': '115 g'}, {'ingredient_id': 'e0e9b6aa-b3bf-4dfa-913f-bcf5f288e621', 'quantite': ''}, {'ingredient_id': '57e8562b-3967-4213-8e94-ef2a35e88b57', 'quantite': '1'}, {'ingredient_id': '0897ff52-c70c-49e5-8cbb-8e28f5294b64', 'quantite': '3'}, {'ingredient_id': 'a752f139-05ba-41fa-b005-d5f26892d052', 'quantite': ''}, {'ingredient_id': 'c605d587-0672-42d7-a387-c20402a3433d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29639, 'Gâteau des îles Marquises', 'crème, rhum, sucre vanillé, cannelle, citron, sel, farine, banane, jaune d''oeuf, noix de coco rapée, sucre en poudre', '25 min', ['Plusieurs jours avant, avoir conservé la crème du lait bouilli.', 'Lui ajouter ensuite quelques cuillères de rhum, le sucre vanillé, un peu de cannelle, le jus du demi-citron, du sel, puis la farine. Bien mélanger jusqu''à obtention d''une pâte épaisse.', 'Etaler la pâte au rouleau sur 1/2 cm d''épaisseur. Découper deux ronds de la même taille que la tourtière utilisée. Poser un premier rond de pâte au fond du moule.', 'Couper les bananes en rondelles et les mettre au fond de la tourtière. Couvrir de la seconde partie de pâte et fermer ou joindre les bords des deux pâtes en pinçant.', 'Dorer du jaune d''oeuf, saupoudrer de noix de coco râpée et de sucre en poudre. Cuire à four moyen, à 180°C (thermostat 6) pendant 45 min.'], ['Verre doseur', 'Couteau de chef', 'Balance de cuisine', 'Économe', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'facile', 'Gâteau des îles Marquises', 'plat', 'jaune d''oeuf', 'crème', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'noix de coco rapée', 'dessert', 'plat de résistance', 'sucre vanillé', 'moyen', 'citron', 'cannelle', 'cocktail'], 'Dessert', 44fb1604-25dc-4438-9bc5-9e051696c298, '2025-09-26T16:31:20.259704', [{'ingredient_id': '7250f6e2-bfed-4b4e-abfc-84f6d9c59ece', 'quantite': ''}, {'ingredient_id': '7d738415-91bd-47d3-9d8d-b5885eabdb23', 'quantite': ''}, {'ingredient_id': 'da0314cb-3bb6-4c0b-9c0b-b4f71d22b4e8', 'quantite': '1'}, {'ingredient_id': 'f64594c7-f39b-4c16-a334-a3c9c87926b2', 'quantite': ''}, {'ingredient_id': '639c5e62-c874-4667-8986-c78719165896', 'quantite': ''}, {'ingredient_id': '1662ecea-76b2-423f-8316-56998edf338a', 'quantite': '1'}, {'ingredient_id': '651a701a-39ae-4fe4-bb2e-254c4367c724', 'quantite': '50 g'}, {'ingredient_id': 'dd414825-21e3-4904-be22-ee4feebaf18d', 'quantite': '3'}, {'ingredient_id': '33fcac38-da0a-412d-8ee3-1a409a09228c', 'quantite': '1'}, {'ingredient_id': '88586b8a-f94b-4d7f-8a51-fcbd1cebf590', 'quantite': '30 g'}, {'ingredient_id': '3e7227a7-9e57-4eba-a4e2-1fe6d824b67a', 'quantite': '30 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (224414, 'Cake aux fruits secs exotiques', 'beurre, levure, sucre roux, oeuf, farine, lait, banane, fruits secs, noix de coco rapée', '20 min', ['Préchauffer le four à 160°C (thermostat 5).', 'Beurrer un moule à cake. Chemiser de noix de coco.', 'Fouetter ou mixer au robot le beurre et le sucre pour obtenir un mélange clair et crémeux puis ajouter les 3 œufs entiers un par un en fouettant sans cesse (ou en gardant le mixeur en marche).', 'Puis, incorporer la farine, la levure, bien mélanger au robot-mixeur.', 'Ensuite, ajouter le lait et la banane en morceaux.', 'Incorporer 100 g de noix de coco râpée, puis les fruits secs (réserver 40 g de fruits secs).', 'Verser le tout dans le moule et saupoudrer de noix de coco restant.', 'Cuire 1h à 160°C.', 'Au bout de 30 min, on peut ajouter par-dessus les fruits secs restants (pour éviter que tous les fruits tombent au fond du moule).', 'Démouler tiède.'], ['Spatule', 'Verre doseur', 'Râpe', 'Moule à tarte', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'fruits secs', 'Cake aux fruits secs exotiques', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'noix de coco rapée', 'dessert', 'plat de résistance', 'beurre', 'lait', 'cocktail', 'sucre roux'], 'Dessert', 1ca8ca44-caa6-41d1-b80a-7e158042c32d, '2025-09-26T16:31:23.882161', [{'ingredient_id': '08121615-7f26-48ac-8e87-c0569bcd40c3', 'quantite': '100 g'}, {'ingredient_id': 'bd0a553c-c944-422d-85c6-59bb866d5b14', 'quantite': '1'}, {'ingredient_id': '1ec1fc90-40a1-4a28-a9ff-ded6b4707740', 'quantite': '75 g'}, {'ingredient_id': '410a647b-7869-4308-ae21-2c87d2f1c283', 'quantite': '3'}, {'ingredient_id': 'a7cec058-a82d-4d1f-b7b8-cbfd915ed89b', 'quantite': '125 g'}, {'ingredient_id': 'a4c2aa7b-538f-4443-bd9a-de06b48072df', 'quantite': '30 cl'}, {'ingredient_id': '35fff08c-2285-4e6f-9687-b073b3dd3c73', 'quantite': '1'}, {'ingredient_id': '1f1d50b0-aba6-4bb0-bd4d-df0ce1a1e065', 'quantite': '100 g'}, {'ingredient_id': 'e7c02e1a-ae7c-4b23-8055-8371159145be', 'quantite': '120 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38159, 'Brochettes des îles sole et Saint Jacques', 'noix de saint-jacques, sole, lard fumé, banane, citron vert', '5 min', ['Faire tremper les noix de st jacques dans du lait pendant quelques heures (facultatif mais bien meilleur).', 'Enroulez des morceaux de sole dans le lard ou le bacon.', 'Sur un pic à brochette, intercalez : banane (avec la peau), noix de jacques, citron vert, sole lardée, banane, noix ...', 'Faire griller de tout les côtés au barbecue !'], ['Couteau de chef', 'Mixeur', 'Râpe', 'Planche à découper', 'Batteur électrique'], ['sole', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Brochettes des îles sole et Saint Jacques', 'testées', 'assez cher', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'noix de saint-jacques', 'plat de résistance', 'saint-jacques', 'citron vert', 'lard fumé', 'cocktail'], 'Plat principal', 9ea19c7c-6368-4370-9d0f-9a171528928f, '2025-09-26T16:31:27.484632', [{'ingredient_id': '185fc0fd-96b4-495e-a792-e186b62b0b55', 'quantite': '3'}, {'ingredient_id': '001d201f-45e6-4aa3-b04f-10e2c77e9ac8', 'quantite': ''}, {'ingredient_id': '5fe6d0e0-2030-4bbe-8f4e-44613676d281', 'quantite': '1'}, {'ingredient_id': '4282b017-9cbd-46bd-be22-60dd6e298d27', 'quantite': ''}, {'ingredient_id': 'aaecc1a4-bf8c-4fe9-a2b0-6da92a8978b9', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (527853, 'Mugcake léger et sans gluten chocolat banane', 'banane, oeuf, farine de châtaigne, chocolat en poudre, bicarbonate', '2 min', ['(La préparation s''effectue dans le mug qui sera utilisé lors de la cuisson et de la dégustation.)', 'Écrasez la demie banane. Ajoutez-y l''oeuf et les deux CAC de farine sans gluten. Battez le tout à l''aide d''une fourchette jusqu''à obtenir une texture sans grumeaux de farine.', 'Une fois la texture désirée obtenue, ajoutez les trois CAC de chocolat en poudre et la levure.', 'Mélangez le tout : la pâte doit avoir une texture élastique, obtenue très rapidement grâce au chocolat.', 'Placez le mug au micro-ondes pendant 01 à 02 min.', 'Voilà, vous pouvez déguster votre mug cake, léger, idéal pour un goûter ou un dessert gourmand sans complexe ! À manger chaud !'], ['Planche à découper', 'Presse-agrumes', 'Moule à tarte', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'Moelleux au chocolat', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'farine de châtaigne', 'Mugcake léger et sans gluten chocolat banane', 'chocolat en poudre', 'cocktail', 'bicarbonate'], 'Confiserie', b2797ebc-5f06-4325-96e1-146b0b2830f0, '2025-09-26T16:31:31.059059', [{'ingredient_id': '04cc9228-2c05-4c9c-b324-636004172e16', 'quantite': '1'}, {'ingredient_id': '2d6195f0-03d0-41c6-a472-afc1cf21ae15', 'quantite': '1'}, {'ingredient_id': 'b835597f-f6c5-4dcb-ba0b-994c839c3228', 'quantite': '2 cuillères'}, {'ingredient_id': 'c5daee38-e729-4abe-9cb2-7b3ead8e4d7f', 'quantite': '3 cuillères'}, {'ingredient_id': 'eb76cdef-17c1-47ea-a0b6-c6b34f1cbf97', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21200, 'Gâteau chocolat banane', 'chocolat noir, beurre, banane, sucre, oeuf, farine, levure', '20 min', ['Préchauffer le four à 180°C. ', 'Ecraser les bananes. ', 'Dans une terrine, travailler 175 g de beurre avec le sucre. ', 'Ajouter les oeufs et la purée de bananes. ', 'Incorporer la farine puis la levure, jusqu''à obtention d''un mélange homogène. ', 'Faire fondre le chocolat et les 25 g restants de beurre. ', 'Graisser légèrement un moule à cake. ', 'Verser un quart de la pâte dans le moule, puis arroser d''un tiers du chocolat fondu. ', 'Refaire cette opération 2 fois, et terminer par une couche de pâte. ', 'Faire cuire environ 1h.'], ['Pince de cuisine', 'Casserole', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'beurre', 'Gâteau chocolat banane', 'gâteau au chocolat', 'sucre', 'cocktail'], 'Dessert', 12bd5278-7de6-4069-96ac-df63df9b86d4, '2025-09-26T16:31:36.804028', [{'ingredient_id': '1a916348-c6d0-4481-9456-2f5257624c30', 'quantite': '200 g'}, {'ingredient_id': 'f73cf3e5-052b-4419-b950-ef8f0f9cd340', 'quantite': '200 g'}, {'ingredient_id': '1fd3b068-1951-4a0e-a680-db3153adaa2e', 'quantite': '2'}, {'ingredient_id': '6b9ef1ee-844b-4750-ad9a-ffb0b39a0e6b', 'quantite': '175'}, {'ingredient_id': '81ac3922-b55e-4c87-ae2d-eeea37fecbee', 'quantite': '3'}, {'ingredient_id': 'c8c162b7-95a5-407b-a577-57999fb09f25', 'quantite': '250 g'}, {'ingredient_id': 'c5b7659d-8895-4543-8bcc-acf0d983e972', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30141, 'Crumble pommes, bananes et framboises', 'farine, sucre en poudre, beurre, cannelle, pomme, banane, framboises', '15 min', ['Dans un saladier, malaxer avec les doigts, la farine, le sucre, une cuillère à café de cannelle et le beurre ramolli pour en faire ''du sable'' et faire reposer le tout une heure au réfrigérateur.', 'Dans un plat allant au four préalablement beurré, mettre les pommes coupées en cubes, les bananes en rondelles et les framboises.', 'Ajouter la cannelle, recouvrir de pâte et mettre au four préchauffé à thermostat 6/7 (200°C) pendant 30mn.', 'Servir chaud, accompagné d''une boule de glace à la vanille.'], ['Batteur électrique', 'Planche à découper', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'framboises', 'bon marché', 'crumble aux pommes', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'bananes et framboises', 'pomme', 'beurre', 'cannelle', 'Crumble pommes', 'cocktail'], 'Dessert', bd0a8f4e-cb52-4634-acac-e494a4bf48fd, '2025-09-26T16:31:40.328714', [{'ingredient_id': 'd0b2e405-2761-4cc4-8b3c-0a7a1f6cf28c', 'quantite': '200 g'}, {'ingredient_id': '9ca10d15-9b6f-460d-89dc-5b950303757d', 'quantite': '180 g'}, {'ingredient_id': '59945691-08c7-4041-a14b-925e5c1f2113', 'quantite': '125 g'}, {'ingredient_id': '6dad11b8-986a-43d5-ac45-510ed6da57ef', 'quantite': '2 cuillères'}, {'ingredient_id': 'c8dd5322-43f2-4eed-8f20-ea374300c31f', 'quantite': '3'}, {'ingredient_id': '5ddb1325-990e-44f3-905a-8e8b4a919904', 'quantite': '2'}, {'ingredient_id': 'dea952ae-9e8b-4359-955b-294f5487632f', 'quantite': '250 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43536, 'Ragoût antillais', 'filet mignon, jus d''orange, vin blanc, huile d''olive, poivron rouge, ananas, banane, champignons de Paris, citron, raisins secs, oignon, ail, farine, thym, romarin, muscade, curry, poivre, sel, huile d''olive, noix de coco rapée', '120 min', ['La veille, préparer une marinade :', 'Mélanger le jus d''orange, le vin blanc, le thym, le romarin, la muscade, l''ail, et un peu d''huile d''olive. ', 'Ajouter la viande coupée en petits morceaux, et mettre au frais toute une nuit.', 'Faire chauffer les raisins dans un peu d''eau avec 2 zestes d''orange ou de citron pendant 3 min.', 'Sortir la viande de sa marinade, l''éponger. Garder la marinade. ', 'Faire revenir la viande dans 2 cuillères à soupe d''huile d''olive, après avoir fait dorer l''oignon. ', 'Laisser cuire 5 min, saupoudrer de farine et de curry. ', 'Mélanger, et verser la marinade filtrée + 1 verre d''eau. Mijoter à couvert 45 min.', 'Pendant ce temps, faire revenir les champignons émincés et les poivrons détaillés en dés.', '10 min avant la fin de cuisson de la viande, ajouter les champignons, les poivrons, les raisins et l''ananas en morceaux. ', 'Mixer les bananes avec le jus du citron et 1 cuillère à soupe de curry.', 'Ajouter la moitié de la mousse de banane au ragoût. Saler, poivrer.', 'Servir chaud, accompagné de riz Basmati avec le reste de mousse à part, puis saupoudrer de noix de coco râpée pour le décor.'], ['Balance de cuisine', 'Moule à tarte', 'Couteau de chef', 'Ouvre-boîte', 'Pince de cuisine'], ['', 'entrée', 'banane', 'Ragoût antillais', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'muscade', 'facile', 'ail', 'vin blanc', 'plat', 'recette', 'cuisine', 'poivron rouge', 'recettes', 'oignon', 'boisson', 'romarin', 'farine', 'huile d''olive', 'noix de coco rapée', 'dessert', 'plat de résistance', 'filet mignon', 'moyen', 'thym', 'champignons de Paris', 'citron', 'ananas', 'raisins secs', 'jus d''orange', 'poivre', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:31:44.083468', [{'ingredient_id': '9b759621-7ad5-4c5e-ae9e-7e0f7b5b0884', 'quantite': '400 g'}, {'ingredient_id': '85552b38-6485-4010-aeeb-89262ba060b7', 'quantite': '30 cl'}, {'ingredient_id': '8f662bd5-56df-45ea-84bd-be0ff73d659f', 'quantite': '10 cl'}, {'ingredient_id': '30da3882-adcf-4f85-b455-4a2da641ad42', 'quantite': '5 cuillères'}, {'ingredient_id': 'dd67ffce-b605-4565-bc58-6fd28e2139c8', 'quantite': '1'}, {'ingredient_id': '0b4b039e-fffe-4e91-a3f3-d67d418118ef', 'quantite': '150 g'}, {'ingredient_id': 'd4f728d4-3bad-43ca-b954-0284c2df110d', 'quantite': '3'}, {'ingredient_id': '1f805ebd-9fd0-418e-8945-0bdde446230e', 'quantite': '100 g'}, {'ingredient_id': '33d4ebc5-a779-4f1a-9800-bfee13c0fa49', 'quantite': '1'}, {'ingredient_id': '0eee44bb-f8ac-45fb-bd92-6b27376e9628', 'quantite': '2 cuillères'}, {'ingredient_id': '73d5d795-97bf-4ba1-a9d3-06a6ad7eae78', 'quantite': '1'}, {'ingredient_id': 'c1e16cb6-348e-4d55-94a2-4d4e1fbb0337', 'quantite': '2'}, {'ingredient_id': 'fe586366-c241-4ab5-8f5b-ff1afb397304', 'quantite': '1 cuillères'}, {'ingredient_id': '4cb2e335-dc77-41a5-96d6-748853c6e6c7', 'quantite': ''}, {'ingredient_id': '722d0116-6a03-492f-987e-53461f21ec8c', 'quantite': ''}, {'ingredient_id': 'a7f0a994-5e2d-4d1c-8751-1cef2065c581', 'quantite': '1 cuillères'}, {'ingredient_id': '8810a573-8acf-444d-aba0-81609cd01805', 'quantite': '2 cuillères'}, {'ingredient_id': 'b1a8e2f1-6796-4c12-92bb-ba7fd447243e', 'quantite': ''}, {'ingredient_id': '2942d383-a055-4fad-a746-f934e73f0ff5', 'quantite': ''}, {'ingredient_id': '0a8590fd-2a41-45dc-8e86-f3b94db636d6', 'quantite': '5 cuillères'}, {'ingredient_id': '2d8c4a7f-b7e1-48f4-82a7-83fd2fcacfaa', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315037, 'Panna cotta à la banane vanillée, coulis de mangue', 'banane, crème liquide, gélatine, vanille, sucre, mangue, citron', '15 min', ['Mettez les feuilles de gélatine à ramollir dans un bol d''eau froide.', 'Ouvrez et grattez la gousse de vanille avec la pointe d''un couteau pour récupérer les graines.', 'Mettez la gousse et les graines dans une casserole avec la crème et 110 g de sucre. ', 'Portez à ébullition et laissez bouillir 2 min en remuant au fouet.', 'Hors du feu, ajoutez les feuilles de gélatine égouttées et mélangez.', 'Epluchez les bananes, coupez-les en morceaux, puis ajoutez-les dans la casserole avec le jus de citron.', 'Retirez la gousse de vanille et mixez le tout pour obtenir une crème lisse.', 'Laissez tiédir et versez la préparation dans des ramequins. Placez-les au moins 4h au réfrigérateur pour les faire prendre.', 'Pelez la mangue et coupez-la en morceaux. Mixez-la avec le reste du sucre pour obtenir un coulis. Placez-le au frais.', 'Déposez le coulis sur la panna cotta au dernier moment.'], ['Pince de cuisine', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'panna cotta', 'bon marché', 'rapide', 'plat', 'mangue', 'coulis de mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'Panna cotta à la banane vanillée', 'vanille', 'dessert', 'plat de résistance', 'citron', 'gélatine', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:31:48.786464', [{'ingredient_id': '9ac3245a-7f19-433e-8ec7-b52624e7e9cc', 'quantite': '2'}, {'ingredient_id': '7a3d2a08-ca9b-4685-b981-48e7d707ef12', 'quantite': '70 cl'}, {'ingredient_id': '02676bad-dddd-4077-b009-1bc86e4d3d9b', 'quantite': '2'}, {'ingredient_id': '4cfd6141-2aed-4df8-8a43-f8f7eb4ba713', 'quantite': '1'}, {'ingredient_id': '4f0c1498-c5ac-4004-9998-ea33cc3e60f7', 'quantite': '160 g'}, {'ingredient_id': '0d0a3702-41f1-427e-b591-2b38c99c4d95', 'quantite': '200 g'}, {'ingredient_id': '78288fae-20a7-40da-af7e-8420d0a77b51', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13388, 'Mousse de banane', 'banane, poire, petit suisse, crème, sucre en poudre, jus de citron', '20 min', ['A préparer 3 heures à l''avance.', 'Ecraser les bananes à la fourchette avec le jus de citron.Ajouter les petits suisses et le sucre. ', 'Mélanger au fouet, ajouter la crème. Battre ou mixer la mousse encore quelques instants.', 'Peler les poires et les couper en petits dés et les mélanger à la mousse de bananes. Mettre le tout à rafraîchir au réfrigérateur.'], ['Mixeur', 'Louche', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'petit suisse', 'testées', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'crème', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'mousse fruits', 'Mousse de banane', 'cocktail'], 'Dessert', a6246406-9752-4bd1-a211-48e113174a0a, '2025-09-26T16:31:53.509325', [{'ingredient_id': '59c0b989-3580-4f4c-a50b-70450b73e04a', 'quantite': '2'}, {'ingredient_id': '9e9210e8-be72-48ed-bc27-2a90f0a04ceb', 'quantite': '2'}, {'ingredient_id': '2f66853f-ea30-4e4d-959f-9948a9fd9410', 'quantite': '4'}, {'ingredient_id': '665adea4-ff0c-48a1-84ce-879b2e099239', 'quantite': '2 cuillères'}, {'ingredient_id': '7fd0dd48-09f4-461a-9fca-10114cd7e4fd', 'quantite': '3 cuillères'}, {'ingredient_id': '23a1bf3f-856b-4e08-815d-051ebc402955', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (41240, 'Chausson banane Nutella', 'pâte feuilletée, banane, Nutella', '10 min', ['Préchauffer le four à 220°C (thermostat 7-8).', 'Etaler la pâte feuilletée sur une plaque en métal ou dans un plat qui va au four. Etaler une fine couche de Nutella sur la moitié de la pâte. ', 'Couper les bananes en fines rondelles et les disposer sur le Nutella. ', 'Une fois le Nutella et les bananes mis sur la pâte, la refermer de façon à ce que ça face un demi-cercle et placer le plat ou la plaque dans le four à 220°C pendant 30 minutes.'], ['Passoire', 'Mixeur', 'Tire-bouchon'], ['Chausson banane Nutella', '', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Nutella', 'dessert', 'plat de résistance', 'pâte feuilletée', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:31:57.060449', [{'ingredient_id': '1d6793d2-8de8-4a5c-820a-822ed0720a33', 'quantite': ''}, {'ingredient_id': '7dfbd071-a147-4887-8c22-6520313560a6', 'quantite': '2'}, {'ingredient_id': '7897d5ca-cb41-46b3-947b-b2cbed814658', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (227704, '"Le" Banoffee sans gluten', 'beurre tendre, maïzena, amandes en poudre, sucre roux, oeuf, banane, lait concentré sucré, agar-agar, mascarpone, sucre en poudre, oeuf, sel, agar-agar', '120 min', ['Mélanger au mixer tous les ingrédients pour faire le biscuit qui servira de fond de tarte et le cuire 15 min au four à 190°C (thermostat 6) dans un moule à manquer que vous aurez au préalable beurrer.', 'Pendant ce temps, mettre la boite de lait concentré sucré au bain marie dans une casserole pendant 2 h sans oublier de la retourner au bout d''une heure et de rajouter de l''eau régulièrement.', 'Une fois le fond de tarte cuit, le laisser refroidir un peu. Ouvrir la boite lait concentré sucré en faisant attention de ne pas se brûler et diluer le toffe obtenu au fouet avec 1/2 sachet de agar-agar. L''étaler sur le fond de tarte. Laisser refroidir  et disposer les bananes coupaient en rondelle de taille moyenne.', 'Dans un moule, diluer au fouet le mascarpone le sucre et les deux œufs montés en neige et le reste du agar-agar. Étaler la préparation sur la garniture et mettre au frigidaire pendant deux heures avant de servir.'], ['Fouet', 'Ouvre-boîte', 'Spatule'], ['', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'beurre tendre', 'facile', 'maïzena', 'bon marché', 'amandes en poudre', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', '"Le" Banoffee sans gluten', 'dessert', 'plat de résistance', 'cocktail', 'sucre roux'], 'Dessert', d62ab5e2-e37a-454f-8e38-6d8afa22ebd2, '2025-09-26T16:32:00.687040', [{'ingredient_id': 'f50cc80b-10f9-45e8-aa98-cda02aab0813', 'quantite': '150 g'}, {'ingredient_id': '779b456d-6c8e-4418-b75f-dd1cc034b138', 'quantite': '250 g'}, {'ingredient_id': '8b872864-ef4f-4910-8e03-28713e6dc2cd', 'quantite': '50 g'}, {'ingredient_id': '13f714fe-f777-4450-ac5b-4b3127b285e2', 'quantite': '40 g'}, {'ingredient_id': '26c0d10e-9956-4738-a9aa-478cc1eaefab', 'quantite': '3'}, {'ingredient_id': '8d4a0381-3b73-411f-a028-d1f02ba53205', 'quantite': '4'}, {'ingredient_id': '324e9502-2379-4b13-ab6d-f798d347d33c', 'quantite': '400 g'}, {'ingredient_id': '27232f46-86cf-4588-b6ea-325df265a648', 'quantite': ''}, {'ingredient_id': '5b532f5b-88ce-44fb-a21e-132f573023a8', 'quantite': '375 g'}, {'ingredient_id': '4ea63c65-38fe-4bdc-9727-bae32a9f90cb', 'quantite': '40 g'}, {'ingredient_id': '82c954c5-9478-41d9-8c62-28c7f12fa9a9', 'quantite': '2'}, {'ingredient_id': 'f92698d7-72aa-4fbd-ab1a-81e0a5ffe326', 'quantite': '1'}, {'ingredient_id': 'c001c4c0-879c-49c5-b4ea-93047083a9b5', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (82770, 'Cocktail glacé tropical', 'jus de citron, jus exotique, banane, glace à la mangue, coulis de framboise', '5 min', ['Mixez tous les ingrédients (sauf le coulis) jusqu''à ce que le mélange soit bien onctueux.', 'Décorez votre verre d''un peu de coulis, et versez votre préparation dans ce même verre.'], ['Passoire', 'Poêle', 'Moule à tarte', 'Tire-bouchon'], ['', 'jus exotique', 'glace à la mangue', 'banane', 'entrée', 'recettes de cuisine', 'Cocktail glacé tropical', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'moyen', 'cocktail', 'coulis de framboise'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:32:05.422032', [{'ingredient_id': 'a8c74845-a9b3-478f-b1ec-89d8390dd1bd', 'quantite': '10 cl'}, {'ingredient_id': 'e4d45c7b-bc40-4338-8e5c-e50795f47c69', 'quantite': '10 cl'}, {'ingredient_id': '79433d4b-fb8c-4e70-bc52-2a6147fbedab', 'quantite': ''}, {'ingredient_id': 'c73a6f96-8ee5-4ae7-b47d-be75a6bb3be7', 'quantite': '100 g'}, {'ingredient_id': 'a4fd9fd3-c863-47cd-9319-3f99b3b9b031', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21415, 'Gratin léger d''ananas et bananes meringué', 'farine, sucre, rhum, crème, jaune d''oeuf, blanc d''oeuf, oeuf, banane, ananas', '15 min', ['Mélanger la farine, le sucre, les jaunes d''oeufs, les oeufs entiers, le rhum et la crème. ', 'Beurrer un plat à gratin. ', 'Installer rondelles de bananes morceaux d''ananas en deux ou trois couches. ', 'Verser la préparation dessus. ', 'Cuire pendant 25 à 30 mn à 180-200°C au début et baisser en milieu de cuisson à 160°C. ', 'Battre les blancs en neige avec le sucre comme lorsqu''on prépare une meringue et étendre cette meringue sur le gratin. ', 'Cuire 10 à 15 mn à 160°C, le temps de dorer légèrement la meringue. ', 'Se mange chaud ou froid.'], ['Verre doseur', 'Tire-bouchon', 'Râpe', 'Rouleau à pâtisserie', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'jaune d''oeuf', 'Gratin léger d''ananas et bananes meringué', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'ananas', 'sucre', 'blanc d''oeuf', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:32:09.070334', [{'ingredient_id': '5d7bc624-a997-41df-b708-a4aab5cb1fdd', 'quantite': '3 cuillères'}, {'ingredient_id': '9ff6d7c0-b61b-4da2-b370-297f1e3a433a', 'quantite': '3 cuillères'}, {'ingredient_id': 'efcfb2cf-28c8-48a7-97e7-545637cbc6ca', 'quantite': '2 cuillères'}, {'ingredient_id': '81271531-c117-4221-bac3-5663926f1a79', 'quantite': '2 cuillères'}, {'ingredient_id': '2b6925ac-f603-4c18-9c4d-681bf57e8c38', 'quantite': '3'}, {'ingredient_id': '7c4c4ded-96cd-4f92-b24f-71bb821606a2', 'quantite': '3'}, {'ingredient_id': '5dbef3e8-9fc7-4380-8aa3-70be0344113f', 'quantite': '1'}, {'ingredient_id': 'be84871b-58db-443b-abe6-c9b59aaaeafa', 'quantite': '2'}, {'ingredient_id': '192bb2b4-f081-4d5b-a970-cf4e9f74756c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (39705, 'Brochettes antillaises', 'ananas, orange, banane, citron, sucre en poudre, cannelle', '30 min', ['Couper l''ananas en quatre, retirer l''écorce et la partie fibreuse centrale. Couper la pulpe en gros dés.', 'Peler les oranges, et détacher les quartiers.', 'Peler les bananes, les couper en grosses rondelles, et les arroser d''un peu de jus de citron.', 'Verser le sucre et la cannelle dans un saladier, ajouter les fruits et mélanger délicatement.', 'Enfiler les morceaux sur les brochettes, en alternant les fruits.', 'Faire dorer au barbecue, assez loin des braises, en retournant assez souvent.'], ['Balance de cuisine', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'orange', 'ananas', 'cannelle', 'cocktail', 'Brochettes antillaises'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:32:13.816654', [{'ingredient_id': 'a37fba04-68a8-4429-9d26-9079e2672898', 'quantite': '1'}, {'ingredient_id': '969c1858-3378-4980-81c7-707db5d2d6b7', 'quantite': '2'}, {'ingredient_id': 'c783fe2e-50da-4a6d-9856-61a1e5d93c3a', 'quantite': '3'}, {'ingredient_id': 'd7571d82-b61c-47c8-9891-c3a43658835e', 'quantite': '1'}, {'ingredient_id': '5404285d-2e16-4329-a329-7d54b62192a2', 'quantite': '250 g'}, {'ingredient_id': '4d9c7014-d076-4eab-bc11-3851fd28553a', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336365, 'Semoule gourmande à la banane', 'semoule, banane, oignon, sucre, poivre, cannelle, sel, citron', '20 min', ['Faire revenir les oignons dans une poêle avec un peu d''eau et de matière grasse, ainsi que 2 cuillères à soupe de sucre en poudre.', 'Couper la banane en petits dés, les asperger de citron.', 'Mélanger les morceaux de bananes avec les oignons. Ajouter 2 cuillères à soupe de sucre en poudre, 1 pincée de poivre, 1 pincée de cannelle et 2 pincées de sel.', 'Pendant la cuisson, préparer la semoule.', 'Les oignons et les morceaux de bananes doivent être fondants lorsqu''ils sont prêts, et commencent à caraméliser.', 'Dans un saladier, mélanger la semoule avec le mélange, vous pouvez ajouter un morceaux de beurre (1 noix environ).', 'Servez et dégustez !'], ['Moule à tarte', 'Spatule', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'semoule', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'citron', 'poivre', 'sucre', 'cannelle', 'cocktail', 'Semoule gourmande à la banane'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:32:18.822198', [{'ingredient_id': 'f78952d1-f7da-475f-80eb-4ac66731ca11', 'quantite': '150 g'}, {'ingredient_id': 'b1fba197-6921-4319-a81a-d4dec56031ba', 'quantite': '1'}, {'ingredient_id': 'd8ca5b54-62bd-4f70-850e-a02b36b47d39', 'quantite': '1'}, {'ingredient_id': 'c88281d5-86b8-41d6-beef-3cfff27ad923', 'quantite': '4 cuillères'}, {'ingredient_id': '65a591ab-6c3f-4276-9095-e82cdba29547', 'quantite': '1'}, {'ingredient_id': '55fafd16-56f5-4f40-b763-5ff59f4e1446', 'quantite': '1'}, {'ingredient_id': '0fb6def7-f4ca-408e-a605-f8b49f1e4902', 'quantite': '2'}, {'ingredient_id': '89b4e252-5c9e-4e0e-8a66-206ab00dfba6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (49366, 'Glace banane parfumée à la cannelle', 'banane, crème, citron, sucre glace, vanille, cannelle', '10 min', ['Dans une terrine, mettre les bananes coupées en rondelles avec le jus de citron.', 'Un coup de girafe, de blender ou de mixer, brrrrrrrrr!!! Et on a une mousse onctueuse de bananes que l''on sucre avec du sucre glace, mais pas trop, on re-vérifie le sucré de la préparation à la fin.', 'Dans une autre terrine, monter la crème au fouet.', 'Incorporer délicatement cette chantilly à la mousse de banane. Mélanger, puis ajouter la vanille et la cannelle. Vérifier s''il faut ou non rajouter du sucre!', 'Et hop dans la sorbetière.'], ['Rouleau à pâtisserie', 'Fouet', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Glace banane parfumée à la cannelle', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'citron', 'sucre glace', 'cannelle', 'glace à l''italienne', 'cocktail'], 'Dessert', b07eb0f5-9464-408a-bc24-d8f9c0cdd859, '2025-09-26T16:32:22.589825', [{'ingredient_id': 'ee77a18a-54a3-42ae-82b2-55aa2feed2d0', 'quantite': '4'}, {'ingredient_id': '32fe77ec-d34a-454f-94d0-4976804ac881', 'quantite': '30 cl'}, {'ingredient_id': '06cb1792-cdf5-4222-88c8-54aefc7870d8', 'quantite': ''}, {'ingredient_id': '1acbbb09-2fd7-4d6d-97d6-d6761c6812ec', 'quantite': ''}, {'ingredient_id': '3aa2882f-b941-44d6-a647-8839d2b069c1', 'quantite': '1 cuillères'}, {'ingredient_id': '91bb25e2-80d5-4eb6-85b8-513504c6079a', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52418, 'Flan glacé aux pommes', 'pomme, raisins secs, cerneau de noix, oeuf, yaourt, citron, cannelle, gingembre, mélange 4 épices, citron confit, cassonade, banane', '10 min', ['Faites gonfler les raisins dans de l''eau très chaude.', 'Faites une compote très sèche avec les fruits frais épluchés et coupés en morceaux moyens arrosés du jus de citron.', 'Cela peut être réalisé en 10 minutes au micro-ondes.', 'Pendant le temps de cuisson de la compote, battez les oeufs en omelette.', 'Ajoutez-y le yaourt, les fruits à coques, les épices et éventuellement le citron confit.', 'Mélangez la compote avec cette base.', 'Sucrez avec de la cassonade si le mélange est trop acide.', 'Cuisez le tout au bain-marie ou au micro-ondes (environ 20 minutes à puissance moyenne).', 'Il faut que les oeufs soient pris.', 'Vous pouvez également si vous êtes très gourmands réaliser un caramel au fond du moule avant de verser le mélange compote-oeufs.', 'Servir bien froid.'], ['Mixeur', 'Économe'], ['gingembre', 'entrée', 'banane', 'citron confit', 'recettes de cuisine', 'cerneau de noix', 'yaourt', 'confiserie', 'testées', 'cassonade', 'facile', 'bon marché', 'Flan glacé aux pommes', 'oeuf', 'plat', 'recette', 'mélange 4 épices', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'citron', 'flan', 'raisins secs', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:32:26.236447', [{'ingredient_id': 'c5dbad84-0ccf-4a0e-bdbb-a69be6bdca88', 'quantite': '5'}, {'ingredient_id': '40ff4e47-74df-4d84-98aa-2385fa4abb2d', 'quantite': ''}, {'ingredient_id': '809ec2e6-1030-4ffe-91da-5ae1ae9ea71c', 'quantite': ''}, {'ingredient_id': '565d0117-5ea0-49a4-aa7b-778f1409d5d8', 'quantite': '2'}, {'ingredient_id': '09a5fd4d-716b-4c75-b674-854bf9d46909', 'quantite': '1'}, {'ingredient_id': '271bb97e-b8c3-4a15-937e-320072a47557', 'quantite': ''}, {'ingredient_id': '5a037213-4ac3-49e1-9e2e-dc64483e8fef', 'quantite': ''}, {'ingredient_id': 'e4945ec5-75a0-4fbe-9e48-9843091673dd', 'quantite': ''}, {'ingredient_id': 'b9b1dfda-d65c-4f76-95f1-f7e4b27ff23c', 'quantite': ''}, {'ingredient_id': 'fdc2010e-2c36-4095-bff7-6a8dbeb54cb2', 'quantite': ''}, {'ingredient_id': 'eb11e0b6-cc13-4e9a-b58d-231126dbcc0e', 'quantite': ''}, {'ingredient_id': '0282044f-333c-4afc-8c0f-f25f47ef1b7e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (171863, 'Smoothie exotique du paradis', 'fruit de la passion, banane, orange, citron vert, framboises', '5 min', ['Passer à la centrifugeuse (au presse nectar) la pulpe des fruits de la passion, les framboises puis les bananes.', 'Presser les oranges et le citron vert et les ajouter au premier nectar.', 'Mélanger le tout et déguster très frais.'], ['Batteur électrique', 'Tire-bouchon', 'Poêle', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'framboises', 'rapide', 'plat', 'recette', 'Smoothie exotique du paradis', 'cuisine', 'recettes', 'boisson', 'fruit de la passion', 'dessert', 'plat de résistance', 'moyen', 'orange', 'citron vert', 'smoothies', 'cocktail'], 'Boisson', 94e07f1d-f0c1-403f-b29b-dbf65090e825, '2025-09-26T16:32:30.724858', [{'ingredient_id': 'a13d0b6c-c39d-4d11-8bff-dd30d6fc18eb', 'quantite': '6'}, {'ingredient_id': '16c9e43c-cf45-49cb-b325-d589b417ad00', 'quantite': '2'}, {'ingredient_id': 'c0fca497-4cf9-48fe-bd69-3dca76d9b9d9', 'quantite': '3'}, {'ingredient_id': '9cf60330-14ce-4c9a-8b8d-92e9f9eede82', 'quantite': '1'}, {'ingredient_id': 'eecee133-445a-48c3-b027-d8084999ed57', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530775, 'Crêpe soleil aux fraises', 'farine, lait, eau gazeuse, oeuf, huile de tournesol, fraises, banane, myrtilles', '20 min', ['Dans un saladier verse un verre de farine, puis casse les œufs un à un, rajouter ensuite un peu de lait puis de la farine puis à nouveau du lait et ainsi de suite.', 'Ajoute enfin l''huile et l''eau gazeuse.', 'Laisse la pâte reposer 1h.', 'Lave les fraises, enlève les queues et coupe-les en 2.', 'Coupe la banane en tranche.', 'Demande à un adulte de te cuire 10 crêpes avec la pâte.', 'Place une crêpe dans une grande assiette, Avec les moitiés de fraises, fait le tour pour dessiner un soleil. Place 2 rondelles de bananes pour faire les yeux et aligne les myrtilles pour dessiner la bouche. Il ne reste qu''a en ajouter 2 sur les bananes pour terminer les yeux.'], ['Poêle', 'Planche à découper', 'Ouvre-boîte'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'eau gazeuse', 'recette', 'cuisine', 'Crêpe soleil aux fraises', 'recettes', 'boisson', 'farine', 'huile de tournesol', 'dessert', 'plat de résistance', 'crêpes sucrées', 'lait', 'cocktail'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T16:32:34.435380', [{'ingredient_id': '6d3e2deb-796a-4960-9e71-93a2b775c64b', 'quantite': '2'}, {'ingredient_id': '404ead1d-705d-4c3c-9bd0-dad93f3c165d', 'quantite': '2'}, {'ingredient_id': 'cf8bc346-df69-430d-8504-18978a7640f7', 'quantite': ''}, {'ingredient_id': '17ff9fd5-35d1-4393-8a57-9a9998c5dae8', 'quantite': '2'}, {'ingredient_id': '3d227928-3bc9-49a7-83ef-511014252afc', 'quantite': '1 cuillères'}, {'ingredient_id': 'f86b5ef8-8dab-4044-ae58-d58442b408d0', 'quantite': '250 g'}, {'ingredient_id': 'c9da7e4d-b0e2-4b07-962d-26d893e67ba2', 'quantite': '1'}, {'ingredient_id': '840f9068-5a5d-4101-bf1e-f8e9c4f4d897', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335772, 'Gâteau à la banane', 'farine de blé, sel, sucre en poudre, levure, banane, citron, oeuf, lait, beurre, sucre glace', '25 min', ['Préchauffer le four à 150°C (thermostat 3). ', 'Dans un saladier, mélanger le sucre, la farine, le sachet de levure et de vanille, et une pincée de sel. ', 'Mettre le mélange de côté. ', 'Peler les 3 bananes et les couper en rondelles. Puis verser dans un mixeur les bananes, le jus de citron, les oeufs, le lait. ', 'Faire ramollir le beurre puis l''incorporer à ce mélange.', 'Reprendre le mélange effectué dans le saladier et l''ajouter à la préparation du mixeur. ', 'Mélanger le tout de façon homogène.', 'Prendre un moule à gâteau, le beurrer et le fariner. ', 'Verser la pâte dans le moule et enfourner le tout.', 'Laisser le gâteau refroidir puis le décorer à votre façon en y mettant la banane restante que vous découperez en rondelles.', 'Vous pouvez aussi le saupoudrer de sucre glace.'], ['Balance de cuisine', 'Verre doseur', 'Presse-agrumes', 'Couteau de chef', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'Gâteau à la banane', 'cuisine', 'levure', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'farine de blé', 'gâteau à la banane', 'beurre', 'citron', 'sucre glace', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:32:37.930455', [{'ingredient_id': 'ab0940db-5706-4af3-9849-ef84ca8053e9', 'quantite': '240 g'}, {'ingredient_id': '93526ff3-0b14-43ff-8bf1-92d51f67f120', 'quantite': '1'}, {'ingredient_id': '261372bd-5b7f-4b19-951b-40fb03f43672', 'quantite': '200 g'}, {'ingredient_id': '69391833-421d-41f6-8df8-3063194fad34', 'quantite': '1'}, {'ingredient_id': '9fd8be74-804d-4b72-bebf-94b66e1522ba', 'quantite': '4'}, {'ingredient_id': 'e3fce5c9-93ce-4a54-8ff1-5d979118bdc7', 'quantite': '1'}, {'ingredient_id': '2ccc0c36-3cb8-4e4a-bbaa-9aeb2c2590b5', 'quantite': '2'}, {'ingredient_id': '0dde4717-844e-4fb5-b079-35c9240b69e7', 'quantite': '10 cl'}, {'ingredient_id': '081653e2-7e2f-4385-a9db-ed668d5055a1', 'quantite': '170 g'}, {'ingredient_id': '0569d1c8-b056-455a-bad7-8c9eae60948d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26021, 'Pudding de riz aux bananes', 'lait, riz, sucre, oeuf, beurre, banane, pomme, raisin, fruit confit, rhum, sucre', '45 min', ['Faire tremper les raisins dans le rhum.', 'Faire pocher le riz 3 minutes à l''eau bouillante. L''égoutter, puis le faire cuire 1/2 heure dans le lait bouillant.', 'Préchauffer le four à 150°C (thermostat 5).', 'Préparer un caramel avec les 10 morceaux de sucre et en garnir l''intérieur d''un moule à charlotte.', 'Couper les bananes en rondelles et en disposer sur le caramel.', 'Incorporer au riz le reste des fruits coupés en morceaux, le sucre, les oeufs, le beurre fondu, les raisins et le rhum. ', 'Verser dans le moule.', 'Faire cuire pendant 45 minutes. Démouler. Manger froid.'], ['Fouet', 'Spatule'], ['raisin', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'oeuf', 'plat', 'recette', 'Pudding de riz aux bananes', 'cuisine', 'recettes', 'boisson', 'pudding', 'dessert', 'plat de résistance', 'riz', 'fruit confit', 'pomme', 'moyen', 'beurre', 'sucre', 'lait', 'cocktail'], 'Dessert', f08fce9d-e064-45b0-8358-1a7394971b1d, '2025-09-26T16:32:42.600909', [{'ingredient_id': '5a574ec3-93cd-45cd-ac55-54e6fc365326', 'quantite': '1 l'}, {'ingredient_id': 'dcaad8b4-4867-4e80-a843-2a78351f2470', 'quantite': '200 g'}, {'ingredient_id': 'f92f1ece-4393-490d-84d4-a59171b9b3bc', 'quantite': '150 g'}, {'ingredient_id': 'a43baf7c-5534-4e36-99c5-8e0ba26fb605', 'quantite': '3'}, {'ingredient_id': 'aecad364-64f5-490e-8f51-ff2d4ea31114', 'quantite': '60 g'}, {'ingredient_id': 'fb4a659b-d1a7-4dcb-99f2-8d7d99d1da87', 'quantite': '6'}, {'ingredient_id': 'ac8742f5-cc84-41ec-9304-8e708c9fcdcd', 'quantite': '3'}, {'ingredient_id': '424c777c-d4e1-488b-b0b2-cbf09bcdff3d', 'quantite': '50 g'}, {'ingredient_id': 'cc47231a-eb18-4f39-91c5-fca03872ce09', 'quantite': ''}, {'ingredient_id': '707830f8-0b88-4b7c-bf76-9f0f3313edf5', 'quantite': '2 cuillères'}, {'ingredient_id': 'e38e5da0-6794-40f2-af63-6b6103bf43fc', 'quantite': '10'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (531809, 'Bananes écrasées facile', 'banane, yaourt nature, cassonade, citron', '2 min', ['Épluche et écrase grossièrement avec une fourchette dans une assiette.', 'Verse le yaourt puis le sucre.', 'Ajoute un peu de citron, si tu veux. Mélange tout.'], ['Mixeur', 'Louche', 'Balance de cuisine', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'yaourt nature', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'Bananes écrasées facile', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'compote de banane', 'cocktail'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T16:32:46.951531', [{'ingredient_id': '27ec947a-c3cd-41fd-8120-b2e1ed808c1f', 'quantite': '1'}, {'ingredient_id': '8e015e28-b243-4731-94b0-56434668ddf9', 'quantite': '1'}, {'ingredient_id': '6689d826-3b66-480a-82b7-ada7baeb89cf', 'quantite': '1 cuillères'}, {'ingredient_id': '3113e4eb-c47c-4d84-a7c4-b72d77fef7e0', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37358, 'Salade de fruits glace vanille', 'ananas, papaye, banane, pomme, amandes, rhum, kiwi, glace vanille, tuile aux amandes, sucre de canne', '15 min', ['Détailler tous les fruits (sauf le kiwi) en petits cubes, ajouter un verre (15 cl) du mélange des deux sirops de fruits (ananas, papaye), le rhum et les amandes un peu broyées. Bien mélanger.', 'Mettre au réfrigérateur au moins 30 minutes. ', 'Sortir la glace du congélateur et la garder au frais 15 minutes avant de servir.', 'Eplucher le kiwi, le détailler en rondelles un peu épaisses.', 'Présentation : ', '"Glacer" des coupes à dessert en mouillant le bord qu''on passe ensuite dans le sucre de canne.', 'Verser la salade de fruits délicatement, décorer avec la rondelle de kiwi qu''on aura coupée jusqu''au rayon et fait tenir "en éventail" sur le bord de la coupe, poser une belle tuile aux amandes sur un côté. ', 'Ajouter 1 ou 2 boules de glace vanille selon la gourmandise des convives, servir. ', 'Bon appétit :)'], ['Ouvre-boîte', 'Rouleau à pâtisserie', 'Batteur électrique', 'Louche', 'Poêle'], ['amandes', 'entrée', 'banane', 'papaye', 'kiwi', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'Salade de fruits glace vanille', 'plat', 'recette', 'tuile aux amandes', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'glace vanille', 'dessert', 'plat de résistance', 'glace à la vanille', 'pomme', 'ananas', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:32:50.628882', [{'ingredient_id': 'd5c41615-8d63-4cb7-bedf-c3d47c94d4df', 'quantite': '400 g'}, {'ingredient_id': '202e6d10-8b87-4171-865a-b59c45557a56', 'quantite': '400 g'}, {'ingredient_id': '723c5788-3ed2-43aa-af72-9f0f67b2cd24', 'quantite': '1'}, {'ingredient_id': 'a0af6c39-6c86-43fa-9dd7-8c112bb74ebc', 'quantite': '1'}, {'ingredient_id': '31c1e22f-edd5-4218-863f-25e608a9a80f', 'quantite': '2 cuillères'}, {'ingredient_id': 'e0d30cf6-0b01-4229-adea-796ad01a4e06', 'quantite': '3 cl'}, {'ingredient_id': '465422ff-e08a-4cbb-afd1-9059303f1e23', 'quantite': '1'}, {'ingredient_id': '2c8e9e16-f5b0-44f6-95a2-cba8eacf43a3', 'quantite': '900 ml'}, {'ingredient_id': '7e9a0325-e710-42e0-8940-71c0eaefa9ae', 'quantite': '4'}, {'ingredient_id': 'eb3af2f0-c885-4f8a-a09f-107958f70527', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (80238, 'Tarte semoule, banane, coco', 'pâte brisée, semoule, lait, sucre, banane, noix de coco rapée, cannelle', '20 min', ['Faire bouillir le lait dans une casserole, et ajouter le sucre en remuant doucement lorsque le lait est chaud.', 'Incorporer la semoule en pluie en remuant toujours. ', 'Retirer du feu et laisser gonfler la semoule.', 'Allumer le four à 200°, thermostat 6-7. ', 'Ecraser les bananes avec une fourchette et les incorporer avec la noix de coco râpée à la semoule. Remuer l''ensemble avec un fouet.', 'Dérouler la pâte dans un plat à tarte et la faire cuire pendant 10 min.', 'Verser la préparation dans le moule à tarte et saupoudrer de sucre et de cannelle. Enfourner à four chaud 20 min.'], ['Passoire', 'Poêle', 'Verre doseur', 'Casserole', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'coco', 'très facile', 'bon marché', 'Tarte semoule', 'semoule', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'cannelle', 'lait', 'sucre', 'cocktail'], 'Dessert', d05a6a11-a528-43b0-bf76-cbb3bafe2edd, '2025-09-26T16:32:54.285088', [{'ingredient_id': 'ccebaf95-5f67-48c8-94c0-3a7fdde077aa', 'quantite': '1'}, {'ingredient_id': '86d74673-a1b7-4e59-a4fc-cc26726f6dfa', 'quantite': '200 g'}, {'ingredient_id': '94e0b47c-1dec-40fc-afdb-b1dbd10d1c2d', 'quantite': '30 cl'}, {'ingredient_id': 'f438be09-de34-4438-9540-79cd9a6cbeed', 'quantite': '100 g'}, {'ingredient_id': '258d6407-6ea3-4d6f-bb62-e02d5cd9ad75', 'quantite': '2'}, {'ingredient_id': 'af8f2410-76bd-4550-a739-8e56a421fcf0', 'quantite': '75 g'}, {'ingredient_id': '11b0016e-2455-4677-b93c-51ab214bac23', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (60466, 'Crunchy de yaourt glacé fruité', 'yaourt nature, banane, citron, cerises, abricot, fraises, miel, sucre de canne, corn flakes', '15 min', ['Mixez la banane avec le jus de citron et la pulpe.', 'Mélangez avec le yaourt que vous aurez préalablement brassé (pour le rendre onctueux).', 'Versez dans 4 coupes (résistante au froid).', 'Procédez dê la même façon avec les autres fruits : ajouter 1 cuillère à soupe de sucre de canne ou de miel selon les goûts.', 'Placez les coupes au réfrigérateur.', '1 heure avant de servir, placez les coupes au congélateur.', 'Juste avant de servir, brassez doucement les yaourts pour éliminer les paillettes formées sur les rebords.', 'Parsemer chaque coupe de céréales émiettées.', 'Servez et régalez-vous.'], ['Ouvre-boîte', 'Économe', 'Moule à tarte', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'corn flakes', 'abricot', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'sucre de canne', 'dessert', 'plat de résistance', 'Crunchy de yaourt glacé fruité', 'citron', 'cocktail', 'cerises'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:32:58.958381', [{'ingredient_id': '6e9370e9-98ef-482e-85fe-f45e30f0239b', 'quantite': '4'}, {'ingredient_id': '219938e0-48da-487b-8b02-cde6368063bd', 'quantite': '1'}, {'ingredient_id': 'fd04fe41-bba6-4a3b-88ad-1751aca60323', 'quantite': '1'}, {'ingredient_id': '4e924d9a-a9c3-4e6c-8f86-851dc5592e7e', 'quantite': '1'}, {'ingredient_id': '2dcac3d9-5da7-44aa-8a0a-950dc2402166', 'quantite': '1'}, {'ingredient_id': '83185530-2348-4481-bb01-defd81e2cd03', 'quantite': '5'}, {'ingredient_id': 'c40faa97-391f-42f8-a582-7d5d5029c4ce', 'quantite': ''}, {'ingredient_id': '20cc3f28-4c44-4584-b452-ad1695c6f6eb', 'quantite': ''}, {'ingredient_id': '687e4277-35b7-44cc-b706-d695de66d45e', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335539, 'Cheesecake banane passion', 'spéculoos, beurre, fromage frais, crème fraîche, oeuf, sucre, banane, citron, fruit de la passion, sucre', '20 min', ['Écrasez les biscuits spéculoos dans un saladier et les "piler" pour les émietter. Ajoutez ensuite du beurre fondu et mélangez. ', 'Posez dans un moule et tassez bien (mettre du papier sulfurisé au préalable), et réservez.', 'Écrasez les 3 bananes avec le jus de citron, puis ajoutez dans un saladier avec le sucre, les oeufs, le fromage frais et la crème.', 'Mixez le tout, puis versez dans le moule pardessus le mélange biscuité.', 'Enfournez à 160°C pour 50 min (1h selon la puissance du four).', 'Sortez le moule et laissez refroidir à température ambiante, puis ensuite mettre au frigo.', 'En attendant, préparez le coulis : couper les fruits de la passion et mettre dans un récipient la pulpe et les graines avec le sucre. ', 'Faites chauffer 1 mn au micro-ondes. ', 'Laissez refroidir également puis nappez le gâteau avec.', 'Gardez au frigo au moins 5h.', 'C''est prêt !'], ['Casserole', 'Poêle', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'fromage frais', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'fruit de la passion', 'dessert', 'cheesecake', 'plat de résistance', 'citron', 'beurre', 'Cheesecake banane passion', 'sucre', 'cocktail'], 'Dessert', d5bc4fbd-23e8-4232-a76d-6f15e38d5cd4, '2025-09-26T16:33:03.226778', [{'ingredient_id': 'be692f99-1247-4f20-8a30-9e1c113672b4', 'quantite': '260 g'}, {'ingredient_id': 'd5dcfe16-e63e-43c1-b8e7-c58e2b659148', 'quantite': '80 g'}, {'ingredient_id': '20ff2a1e-7e4a-41d9-b961-6358f00fb1a4', 'quantite': '500 g'}, {'ingredient_id': '5f6a1624-9d5d-46ae-8952-ab267c66114c', 'quantite': '20 cl'}, {'ingredient_id': '8173e91c-e7fd-4aed-9917-135ce80113b7', 'quantite': '3'}, {'ingredient_id': 'ab9f1d50-f21a-4ed9-8733-d22f1fda2485', 'quantite': '100 g'}, {'ingredient_id': 'a26464b8-f5a1-4110-9ce4-e9c6c6aba134', 'quantite': '3'}, {'ingredient_id': 'f7b8abff-f49e-4f81-9475-1c3ae7299082', 'quantite': '1'}, {'ingredient_id': '72cc8ab6-0ca0-415d-a0c1-909d8f49ca69', 'quantite': '5'}, {'ingredient_id': '15545fae-9587-4eb3-9302-88aa4cca18df', 'quantite': '5 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315135, 'Dinde facile à l''indienne sucrée salée', 'blanc de dinde, oignon, pomme, poire, banane, beurre, noix de coco, curry, crème fraîche, sel, poivre', '40 min', ['Faire revenir la viande dans une sauteuse, puits la mettre dans un saladier.', 'Faire revenir les oignons, les pommes et poires. ', 'Ajouter le curry, 2 verres d''eau. Faire cuire pendant environ 10 min.', 'Ajouter la noix de coco, les bananes, le sel et le poivre. ', 'Faire cuire pendant environ 20 min à feu doux.', 'Mixer la sauce. Ajouter la viande (bien la séparer avant de l''ajoute à la sauce), puis y ajoute la crème fraîche au dernier moment avant de servir ', 'Servir avec du riz ou des pâtes.'], ['Planche à découper', 'Couteau de chef', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'plats indiens', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'blanc de dinde', 'pomme', 'beurre', 'noix de coco', 'poivre', 'curry', 'Dinde facile à l''indienne sucrée salée', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:33:08.773349', [{'ingredient_id': 'c27a2787-80e7-4d3c-810d-041e0993eada', 'quantite': '800 g'}, {'ingredient_id': 'ec0a0206-825a-4ec1-a265-fa5e391813a9', 'quantite': '2'}, {'ingredient_id': '895f861e-b2e4-4b88-8ddf-e5a1ae548243', 'quantite': '2'}, {'ingredient_id': '6bf6f23c-826c-4e29-a754-52599ebc8962', 'quantite': '2'}, {'ingredient_id': '21d45520-3000-4255-94e4-8f438fddaca4', 'quantite': '2'}, {'ingredient_id': '3ecb7e06-8e7d-4633-b4b5-ef023bb811b6', 'quantite': '500 g'}, {'ingredient_id': '48789b83-6757-42af-b713-936e9a86580f', 'quantite': '2 cuillères'}, {'ingredient_id': '2e25df8f-aff0-45ce-99c8-6d46be8ec6b2', 'quantite': '4 cuillères'}, {'ingredient_id': '0340da65-5702-44f7-9a15-faac01db894b', 'quantite': '4 cuillères'}, {'ingredient_id': '8cb39f68-dc1a-4747-8419-6c6ba622ec3c', 'quantite': ''}, {'ingredient_id': '0ad8b197-e557-4f9a-873e-9358055c8c08', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (538215, 'Mini fondants banane chocolat au Airfryer', 'chocolat, banane, oeuf, levure chimique, flocons d''avoine, noix', '10 min', ['Mixez la banane et les œufs dans votre robot mixeurs jusqu’à obtenir une texture bien mousseuse (ou écrasez d''abord la banane à la fourchette avant de la mélanger avec le reste des ingrédients). Incorporez ensuite la farine tamisée et la levure en continuant de mélanger.', 'Ajoutez 50 g de chocolat haché ainsi que 40 g de noix concassées, puis versez la pâte dans des moules à muffins adaptés à votre Airfryer, puis enfournez à 160°C pendant 25 minutes.', 'Une fois cuits, sortez-les du Airfryer et laissez-les refroidir. Faites ensuite fondre le chocolat restant et nappez-en la surface si vous le souhaitez. Parsemez du reste des noix hachées et dégustez.'], ['Économe', 'Presse-agrumes', 'Tire-bouchon', 'Mixeur', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'noix', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Mini fondants banane chocolat au Airfryer', 'flocons d''avoine', 'cocktail'], 'Dessert', 457ed674-3013-4b62-aca1-05c3aacc16f5, '2025-09-26T16:33:14.440324', [{'ingredient_id': 'f3735fdc-837f-4c82-b7d6-d0787e081fa3', 'quantite': '100 g'}, {'ingredient_id': 'e87cbb74-f58d-4e54-8d3e-77b8d8c23a43', 'quantite': '2'}, {'ingredient_id': '99ea26f1-b841-4483-8c92-4e1056893126', 'quantite': '4'}, {'ingredient_id': 'a4c8994c-21df-4926-b2a5-e266a07e1de1', 'quantite': '2 cuillères'}, {'ingredient_id': '2ec8a584-10f3-4a40-811d-c0c3fdb91b1e', 'quantite': '150 g'}, {'ingredient_id': '73d9d7b9-cbad-4c77-b7ea-be5b919f3d14', 'quantite': '60 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73600, 'Un amour de smoothie ...', 'banane, abricot, fraises, pomme', '10 min', ['Couper les fruits grossièrement (attention toutefois à ne pas avoir de trop gros morceaux, difficiles à passer au mixer). ', 'Les passer au mixer à grande vitesse.', 'Ajouter le jus de pommes autant que nécessaire pour fluidifier un peu le mélange.', 'Servir frais dans des verres transparents décorés avec les fraises.'], ['Batteur électrique', 'Balance de cuisine'], ['Un amour de smoothie ...', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'abricot', 'très facile', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:33:18.151227', [{'ingredient_id': '18c76435-2c54-453f-805e-dbc31d6fe358', 'quantite': '2'}, {'ingredient_id': '482f6cbe-18ef-421c-9e5d-11b336df2cc7', 'quantite': '5'}, {'ingredient_id': 'd3679748-ca99-4143-80f0-b72f68c5f375', 'quantite': '100 g'}, {'ingredient_id': 'a386fad6-4baf-4661-969f-0ecb936707bc', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228752, 'Milk-shake blanc multivitaminé', 'mangue, banane, nectarine, glace au chocolat, lait entier, fraises', '10 min', ['Dans un mixeur/ou/blender mixer tout les ingrédients ensemble. ', 'Vous n''avez plus qu''à déguster assez vite !'], ['Râpe', 'Casserole', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'nectarine', 'facile', 'bon marché', 'lait entier', 'rapide', 'plat', 'mangue', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Milk-shake blanc multivitaminé', 'glace au chocolat', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:33:23.248914', [{'ingredient_id': '6cbfee55-abd2-4aa3-9694-3ed030a47773', 'quantite': '1'}, {'ingredient_id': '713ca6e8-3862-4f38-950c-54553fcd1e5b', 'quantite': '2'}, {'ingredient_id': '87017e4d-15fb-4cc6-bab6-c16aa4e2f4b5', 'quantite': '2'}, {'ingredient_id': '265499d6-b517-4681-8e59-aa1bb72c5d95', 'quantite': '4'}, {'ingredient_id': 'ba6dadbd-3969-46e1-b58f-d460cab2a607', 'quantite': '25 cl'}, {'ingredient_id': '8243326f-d045-45a1-b803-24d1ce48b716', 'quantite': '12 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (47429, 'Bricks aux 3 fruits', 'pomme, banane, ananas, brick, beurre, sucre roux, rhum, glace vanille, Coulis de fraise, fraises', '30 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Plier en 2 les feuilles de brick, et les disposer dans 1 ramequin, pour qu''elles prennent 1 forme ronde et découper aux ciseaux le surplus (pour éviter que la feuille soit trop haute). ', 'Les badigeonner de beurre fondu, et enfourner jusqu''à ce qu''elles soient légèrement dorées; réserver.', 'Couper les pommes et ananas en dés. ', 'Chauffer le beurre, ajouter pommes et ananas; et saupoudrer de 2 bonnes cuillères de sucre roux.', 'Dès que les pommes et ananas sont cuites, rajouter les bananes et le rhum et laisser cuire en faisant attention que les bananes ne deviennent pas de la purée.', 'Présenter les bricks dans 1 assiette, avec les fruits cuits dedans. ', 'Rajouter 1 boule de glace vanille (par exemple), et verser du coulis de fraise dessus et parsemer l''assiette de quelques fraises, pour finir.'], ['Économe', 'Pince de cuisine', 'Spatule', 'Râpe', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'Bricks aux 3 fruits', 'plat', 'fraises', 'recette', 'brick', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'ananas', 'cocktail', 'Coulis de fraise', 'sucre roux'], 'Dessert', 7187a63c-1cbc-4ce9-9a14-c16383c0ee3a, '2025-09-26T16:33:26.899802', [{'ingredient_id': '37e100d5-2d5b-4a56-9a5d-a4150db3988f', 'quantite': '3'}, {'ingredient_id': '4d0255d4-895a-4f0c-8c61-0f6dbe2cf3b7', 'quantite': '4'}, {'ingredient_id': '1ce60111-8ed7-4f58-8996-e5134a088871', 'quantite': '1'}, {'ingredient_id': 'ad1d92fc-90be-46b7-818b-1c03fe90babb', 'quantite': '6'}, {'ingredient_id': 'ad41c26b-bca5-451c-b29b-b7a3ced5befd', 'quantite': '25 g'}, {'ingredient_id': '03b1d266-22f6-4ab5-ae6e-2c7cddc511ee', 'quantite': ''}, {'ingredient_id': '4c24b620-e4b6-4536-9e2d-a8bb8ff62f35', 'quantite': '1'}, {'ingredient_id': '807c110e-3a5f-410d-91f9-5cbcbb175735', 'quantite': ''}, {'ingredient_id': '63070a9c-6244-4dde-badf-1689d1095453', 'quantite': ''}, {'ingredient_id': '1f32847d-aeca-4296-b90c-375de36ff98a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23501, 'BANANES AU BARBECUE', 'banane, sucre en poudre, crème liquide, glace vanille', '5 min', ['Préparer le barbecue, mettre les quatres bananes dessus, les faire noircir sur chaque face environ 5 mn. ', 'Pendant ce temps préparer le caramel. Une fois celui-ci roux y mettre la crème liquide. ', 'Fendre la peau des bananes sur la longueur, mettre le caramel à l''intérieur, accompagner d''une boule de glace vanille.'], ['Spatule', 'Presse-agrumes', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'glace vanille', 'dessert', 'plat de résistance', 'BANANES AU BARBECUE', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:33:32.569421', [{'ingredient_id': '5b750279-d591-4d50-ad81-5dec61093c22', 'quantite': '4'}, {'ingredient_id': '6f9465f0-8145-4754-a13c-c4cc911cd5e7', 'quantite': '200 g'}, {'ingredient_id': 'd035145c-2759-4c79-ad80-14dd4924e742', 'quantite': '20 cl'}, {'ingredient_id': '7bc8facf-a1ce-4157-a9f5-e88ebcc803bf', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (60376, 'Délice de petits beurres aux fruits', 'petit beurre, lait, banane', '10 min', ['Mettre le tout dans un mixeur et mixer jusqu''à l''obtention d''une sorte de crème liquide.', 'Réserver au frais, servir dans des verres avec une paille.'], ['Presse-agrumes', 'Pince de cuisine', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Délice de petits beurres aux fruits', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'petit beurre', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:33:36.170028', [{'ingredient_id': '341dacd6-15eb-4caf-a523-03f19a423fe6', 'quantite': '1'}, {'ingredient_id': 'e2f5207a-9a7e-4ebd-b3ef-cbce9654e956', 'quantite': '30 cl'}, {'ingredient_id': '72e6b894-d9d0-455a-a470-f6089a39471f', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (533439, 'Cake à la banane par Laurent Mariotte', 'farine, sucre, levure, oeuf, banane, rhum, beurre, beurre, sel', '10 min', ['Mélangez le sucre, le sel, la farine et la levure.', 'Faites fondre le beurre dans une casserole.', 'Battez les œufs en omelette. Écrasez deux bananes à la fourchette dans un saladier.', 'Mélangez tous les ingrédients pour bien les amalgamer et ajoutez le rhum.', 'Versez la pâte dans un moule à cake beurré. Coupez la dernière banane en deux dans la longueur et disposez sur le dessus de la préparation.', 'Laissez reposer 1 heure au réfrigérateur.', 'Préchauffez le four à 170°C puis enfournez pour 1 heure. Dégustez tiède.'], ['Couteau de chef', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'Cake à la banane par Laurent Mariotte', 'rhum', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', 8e8b1cbe-79ac-44e1-9f8c-aa8b7b63a6da, '2025-09-26T16:33:39.666568', [{'ingredient_id': '73bf0353-8996-4e08-8ee9-3012c0299aaa', 'quantite': '150 g'}, {'ingredient_id': '847700bc-8424-4575-b86f-3e3ad6ba88bb', 'quantite': '125 g'}, {'ingredient_id': 'e9b65c06-e933-41f4-ae14-2fd0b98f90ba', 'quantite': ''}, {'ingredient_id': 'a2b39895-974f-4dcc-8451-3ebfac33936f', 'quantite': '2'}, {'ingredient_id': '09b617fe-ed22-4839-a235-ca714cb635dd', 'quantite': '3'}, {'ingredient_id': '9d5abd08-a8b4-4729-860e-8a7e27bbbf4e', 'quantite': '2 cuillères'}, {'ingredient_id': 'f19f0bdd-85ac-4a00-8eac-517030d4b611', 'quantite': '100 g'}, {'ingredient_id': 'e5314a71-8cc4-4582-aecc-f6eaa5e5f89d', 'quantite': ''}, {'ingredient_id': 'dc48f302-d1ba-494b-acbc-6ba426cef0e5', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13107, 'Licuado de Platano (Mix de Banane) (Mexique)', 'lait, banane, sucre, cannelle, vanille, glaçons', '5 min', ['Mixer tous les ingrédients sauf la cannelle.', 'Servir dans des verres et saupoudrer avec la cannelle.'], ['Rouleau à pâtisserie', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Licuado de Platano (Mix de Banane) (Mexique)', 'vanille', 'dessert', 'plat de résistance', 'glaçons', 'cannelle', 'sucre', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:33:43.328340', [{'ingredient_id': '22e2bc12-f2c4-4bdd-87bf-287c52759125', 'quantite': '200 ml'}, {'ingredient_id': '13e6833e-c06c-4600-8746-230d3839bb63', 'quantite': '1'}, {'ingredient_id': '2213041e-8ead-44cf-ad3a-5d17344b7f19', 'quantite': '2 cuillères'}, {'ingredient_id': '11099556-3366-4969-8c06-1f202bd4b153', 'quantite': ''}, {'ingredient_id': '04494988-48d3-422b-8647-bb119cfab5ef', 'quantite': ''}, {'ingredient_id': 'a219fc3d-8a9f-4181-8b6a-19c43f1761db', 'quantite': '7'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (227883, 'tiramisu banana split', 'mascarpone, oeuf, sucre, biscuits à la cuillère, banane, chocolat noir, crème liquide', '45 min', ['1. Faites fondre le chocolat au bain-marie, une fois fondu ajoutez la crème et mélangez pour obtenir un chocolat liquide.', '2. Séparez le jaune d''œuf du blanc, et battez le blanc en neige.', '3. Ajoutez le sucre et le mascarpone aux jaunes d''œufs et fouettez bien pour obtenir un mélange mousseux.', '4. Ajoutez délicatement à ce mélange les blancs montés en neige.', '5. Coupez la banane dans la largeur puis dans la longueur afin d''obtenir 4 moitiés de banane et coupez en petit morceaux.', '6. Mettez les biscuits cuillères dans vos petites verrines (petite verrine = moitié d''un verre), ajoutez par dessus les morceaux de banane, puis le chocolat et enfin le mélange.', '7. Mettez au frais pendant au moins 2h (plus vous mettez longtemps, et plus ça sera bon) puis dégustez.'], ['Moule à tarte', 'Rouleau à pâtisserie', 'Poêle', 'Râpe'], ['entrée', 'banane', 'tiramisu banana split', 'recettes de cuisine', 'mascarpone', 'confiserie', 'testées', 'banana split', 'biscuits à la cuillère', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre', 'cocktail'], 'Dessert', 506d5283-fda2-4eb2-88ec-6dc50edbcf4d, '2025-09-26T16:33:48.302886', [{'ingredient_id': 'eec8778b-e007-4f0e-ab33-d818202b0b5d', 'quantite': '125 g'}, {'ingredient_id': '23bcc650-cfa9-441c-95bb-33d3305f3b05', 'quantite': '2'}, {'ingredient_id': '4a196da3-ea6a-4d2b-a8e6-7f377ddac596', 'quantite': '100 g'}, {'ingredient_id': 'a87a887a-b62d-45d1-9ab7-a3c116e27788', 'quantite': '4'}, {'ingredient_id': 'a60fc89f-f32d-4e8d-ab30-090f40ac119d', 'quantite': '1'}, {'ingredient_id': 'e3c3218a-7674-442f-a965-6889ae4dbda4', 'quantite': '100 g'}, {'ingredient_id': 'a01d7df1-eda4-4920-9c95-b160c455f81e', 'quantite': '15 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65398, 'Tarte gourmande banane - chocolat', 'pâte feuilletée, banane, chocolat praliné, sucre roux, extrait de vanille, rhum, citron vert, beurre salé', '10 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Dérouler la pâte, la placer dans un moule puis la piquer à la fourchette.', 'Disposer des rondelles de bananes sur toute la surface de la pâte.', 'Saupoudrer de sucre roux et d''un peu d''extrait de vanille.', 'Découper à l''aide d''un couteau des copeaux de chocolat pralin et les répartir sur toute la tarte.', 'Ajouter des copeaux de beurre (6-7) sur les bananes.', 'Verser le rhum sur la tarte.', 'Mettre au four pendant environ 25 minutes (que les bananes dorent légèrement).', 'Servir chaud avec un filet de citron vert.'], ['Presse-agrumes', 'Tire-bouchon', 'Passoire', 'Moule à tarte'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'extrait de vanille', 'très facile', 'beurre salé', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Tarte gourmande banane - chocolat', 'pâte feuilletée', 'citron vert', 'chocolat praliné', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:33:51.908552', [{'ingredient_id': 'efbe840d-cdcd-47af-a790-effb1f64300a', 'quantite': '1'}, {'ingredient_id': '933b13da-c111-46ea-b7f0-2c91ebab6503', 'quantite': '3'}, {'ingredient_id': '0dfb29c1-ff0b-4181-8f91-5c4a1466c2c2', 'quantite': '8'}, {'ingredient_id': '55023e6f-3cd5-436e-bad9-eb3fc7d618e9', 'quantite': '1 cuillères'}, {'ingredient_id': 'c323fd2b-09e1-49e9-a48a-2ee0aaf1a7bf', 'quantite': ''}, {'ingredient_id': '79afd890-ca66-4c2a-a13e-c1e63b044cbe', 'quantite': '3 cl'}, {'ingredient_id': '3b89e58e-64a3-48eb-919a-e5beaee218bb', 'quantite': '1'}, {'ingredient_id': '212c03d1-3a5e-4d92-adc8-463b50b0c7f8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11556, 'Bananes des îles craquantes', 'banane, brick, noix de coco rapée, citron vert, beurre, sucre en poudre', '60 min', ['Commencez par éplucher les bananes, fendez-les en deux dans la longueur.', 'Râpez tout le zeste du citron vert, mélangez-le à la noix de coco râpée.', 'Badigeonnez une plaque à pâtisserie avec du beurre fondu, disposez dessus les feuilles de brick, badigeonnez-les de beurre et coupez cette feuille en deux.', 'Mettez sur chaque moitié et en partant du bord une demi-banane, saupoudez-la sur toute sa longueur du mélange de noix/citron, enveloppez-les dans la feuille de brick en roulant comme une cigarette.', 'Sur le feu moyen,faites chauffer une grande poêle anti-adhésive, faites-y fondre 30 g de beurre, disposez-y les bricks de banane et faites-les bien colorer tout autour. Lorsque les bananes sont cuites, roulez-les dans du sucre.', 'Taillez en biais en 3 morceaux, disposez en 6 par assiette et accompagnez de crème au chocolat/vanille et des feuilles de menthe ou de sorbets aux fruits des îles. '], ['Rouleau à pâtisserie', 'Couteau de chef', 'Passoire', 'Louche', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'bon marché', 'rapide', 'plat', 'moyenne', 'sucre en poudre', 'recette', 'cuisine', 'brick', 'Bananes des îles craquantes', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'beurre', 'citron vert', 'cocktail'], 'Dessert', dd57052c-47f7-4121-a5e5-899171a7411c, '2025-09-26T16:33:55.571128', [{'ingredient_id': 'f6950f01-481c-4629-85f4-a1040c0fe640', 'quantite': '4'}, {'ingredient_id': '37794a4e-026a-491c-b7b6-a831682fdaed', 'quantite': '4'}, {'ingredient_id': '0a351a1e-af9b-48bf-a738-5c46f41449fc', 'quantite': '80 g'}, {'ingredient_id': '44fd84cb-9352-4f12-a760-826639103f65', 'quantite': '1'}, {'ingredient_id': '60b141d1-010a-4455-9ae3-359fc1229f78', 'quantite': '50 g'}, {'ingredient_id': '8d8ed3c1-7d96-4a68-83ea-dc7268571658', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (87238, 'Banana-split à la créole', 'banane, sucre en poudre, noix de coco rapée, ananas, lait de coco, rhum, glace, chocolat, crème fraîche', '30 min', ['Faire fondre le chocolat au bain marie avec 4 cuillères à soupe de lait de coco et la crème fraiche.', 'Ouvrir la boite d''ananas, bien égoutter les morceaux et réservez 10 cl de sirop.', 'Verser le reste du sirop dans une assiette creuse.', 'Mélanger le sucre en poudre et la noix de coco râpée dans une assiette.', 'Peler les bananes, les tremper dans le sirop de l''assiette creuse, puis les rouler dans le mélange sucre-noix de coco.', 'Disposer une banane par assiette.', 'Faire chauffer le lait de coco restant à feu doux; dès que le lait est homogène, ajouter le sirop réservé et le rhum.', 'Répartir le lait de coco au rhum dans les assiettes ou dans une petite verrine puis ajouter les morceaux d''ananas d''un côté.', 'Disposer une boule de glace à l''opposé des morceaux d''ananas et napper le tout de coulis de chocolat au lait de coco ou disposer le chocolat dans une verrine.', 'Servir aussitôt.'], ['Pince de cuisine', 'Râpe', 'Couteau de chef'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'Banana-split à la créole', 'rhum', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'glace', 'noix de coco rapée', 'dessert', 'plat de résistance', 'ananas', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:33:59.418961', [{'ingredient_id': 'b0966a43-68ad-4876-bda0-ab89ed9f62dd', 'quantite': '4'}, {'ingredient_id': '445596f7-7869-4d45-84c6-662152b55f9f', 'quantite': '4 cuillères'}, {'ingredient_id': '0f1d8812-5b13-43b4-aab5-9e24b298d087', 'quantite': '4 cuillères'}, {'ingredient_id': '6a2f77b9-fe74-4851-a84c-87042f299184', 'quantite': '340 g'}, {'ingredient_id': 'f8b8fa91-9be8-44fe-9181-d61681789f30', 'quantite': '20 cl'}, {'ingredient_id': '58fc0abe-123e-404c-a95c-d7a808cfdb83', 'quantite': '2 cuillères'}, {'ingredient_id': '5706725b-db2a-4a9e-a16c-89b2aa4a5335', 'quantite': '50 cl'}, {'ingredient_id': '5a2e8c14-b774-45e6-b6ca-a49447111690', 'quantite': '100 g'}, {'ingredient_id': '338f6bb9-d9de-481a-81b9-b4f1216e3863', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (173177, 'Verrines chocolat-banane', 'banane, boudoir, chocolat noir', '10 min', ['Éplucher et couper la banane avant de la passer dans un mixeur.', 'Mettre la purée obtenue au réfrigérateur en attendant de servir.', 'Faire fondre le chocolat dans une casserole à feu doux.', 'Émietter les boudoirs au fond de deux verrines, ajouter la purée de banane puis le chocolat fondu par dessus.', 'Bon appétit !'], ['Rouleau à pâtisserie', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Verrines chocolat-banane', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'boudoir', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:34:03.072628', [{'ingredient_id': 'aa5b76a5-5f11-40d5-93ad-0658e56ed513', 'quantite': '1'}, {'ingredient_id': '4564ce0f-53f3-4733-a7ba-3fa5460686ec', 'quantite': '2'}, {'ingredient_id': '79ded4ef-1727-4f70-aafb-dbdaf3b14c6a', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (338237, 'Salade de fruits façon Judy', 'menthe, vanille, sucre roux, miel, mangue, banane, pomme, kiwi', '20 min', ['Dans une casserole remplie d''eau, mettez le sucre roux et la menthe. Laissez bouillir et refroidir.', 'Découpez les fruits en cube et placez-les dans un saladier avec la gousse de vanille, excepté la mangue.', 'Faites revenir dans une poêle la mangue et le miel et laissez refroidir. ', 'Lorsque tout est à température ambiante, mélangez les différentes préparations et réservez au frais durant une nuit.'], ['Pince de cuisine', 'Couteau de chef', 'Spatule'], ['', 'Salade de fruits façon Judy', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'menthe', 'facile', 'bon marché', 'plat', 'mangue', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'pomme', 'cocktail', 'sucre roux'], 'Dessert', b0847156-8ee4-432b-98ed-b409cd643e5e, '2025-09-26T16:34:07.973828', [{'ingredient_id': '51694bef-d1e0-4487-9f04-9f784d2a9a06', 'quantite': '6'}, {'ingredient_id': 'ed8989a1-e10f-4f7a-bba5-8564f7e57632', 'quantite': '1'}, {'ingredient_id': '93210edb-c187-4a8a-9b2a-5cc4fcc8bf11', 'quantite': '40 g'}, {'ingredient_id': 'f9199d55-394d-44ce-a61c-92403b4a70c4', 'quantite': '10 g'}, {'ingredient_id': '4307a0c5-408a-4583-a806-fd010a682caf', 'quantite': '1'}, {'ingredient_id': 'c5778fe3-3cf0-40e8-845f-c85462cae660', 'quantite': '2'}, {'ingredient_id': 'a4bb3769-78ff-4b80-adef-442c0066c675', 'quantite': '2'}, {'ingredient_id': 'cef7be4c-633c-4f42-8242-3d88f2cd163d', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (340081, 'Smoothie pomme-citron', 'banane, pomme, sirop de citrons, sucre', '10 min', ['Couper les pommes et les bananes grossièrement. Mettre le tout dans un mixeur/blender (ne pas garder la peau de la banane, mais garder celle de la pomme pour donner un gout acidulé à celle-ci, bien sûr, enlever les pépins.)', 'Ajouter les cuillères de sirop de citron. Vous pouvez le remplacer par du jus de citron et ajouter quelques pincées de plus de sucre pour donner le goût sucré du sirop de citron.', 'Mixer le tout, et surtout, vérifier que toutes les pommes sont bien mixées, et qu''il ne reste pas de gros morceaux. ', 'Avec un petit mixeur, vous pouvez obtenir un aspect de compote qui ne dérangera en aucun cas la dégustation. ', 'Il ne vous reste plus qu''à boire ce smoothie. On peut ressentir le goût de la pomme et du citron.'], ['Balance de cuisine', 'Ouvre-boîte', 'Mixeur', 'Économe', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'sucre', 'smoothies', 'sirop de citrons', 'cocktail', 'Smoothie pomme-citron'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:34:12.590060', [{'ingredient_id': '0bf4a4fb-ca4a-4edc-9cc2-ebe771bb95e8', 'quantite': '3'}, {'ingredient_id': '586683cc-c17c-4e4c-8b69-8e3a45a448ba', 'quantite': '3'}, {'ingredient_id': '98d666be-85f1-4e72-94de-d66658b7168a', 'quantite': '3 cuillères'}, {'ingredient_id': '2750ccc2-5175-4dfc-918a-f62daf1ddfb8', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (51050, 'Tiramisu banane café, génoise au chocolat', 'café, banane, chocolat noir, farine, chocolat noir, amandes, mascarpone, sucre, oeuf, oeuf, sucre', '60 min', ['Prévoyez de préparer ce plat la veille de préférence.', 'Préchauffez votre four à 180°C (thermostat 6).', 'Préparez votre génoise : ', 'Battez le sucre avec les jaunes d''oeufs puis ajoutez la farine, les amandes et le chocolat rapé.', 'Mélangez en soulevant la pâte pour bien l''aérer.', 'Montez les blancs d''oeufs en neige et ajoutez-les délicatement au mélange précédant.', 'Beurrez un grand plat rectangulaire, y verser la pâte, laissez cuire 30 minutes. ', 'Vérifiez la cuisson, laissez refroidir sur une grille.', 'Pendant ce temps, préparez la crème mascarpone : ', 'Fouettez à la fourchette les jaunes d''oeufs et le sucre, ajoutez-y le mascarpone et bien homogénéiser.', 'Montez les blancs d''oeufs en neige et ajoutez-les à l''appareil précédant.', 'Sur les 100 g de chocolat noir restant, prélevez 2 carreaux (à raper pour la déco du dessus) et faites fondre le reste.', 'Coupez la génoise refroidie en 2 dans le sens de l''épaisseur. Placez l''une des tranches dans le fond du plat, versez lentement la moitié du café refroidi dessus pour l''imbiber (plus ou moins selon les goûts).', 'Répartissez la moitié de la crème au mascarpone, puis les bananes coupées en rondelles et enfin le chocolat noir fondu.', 'Recouvrez de l''autre partie de la génoise (plus les miettes dues à la découpe), imbibez du café restant puis de reste de crème mascarponse.', 'Finissez en râpant les 2 carreaux de chocolat sur le dessus du plat (ou saupoudrez de chocolat en poudre non sucré si vous en aimez l''amertume).', 'Réfrigérer au moins 6 heures.'], ['Planche à découper', 'Passoire', 'Ouvre-boîte', 'Fouet', 'Moule à tarte'], ['amandes', 'entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'confiserie', 'génoise au chocolat', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'café', 'cuisine', 'recettes', 'boisson', 'Tiramisu banane café', 'farine', 'génoise', 'dessert', 'plat de résistance', 'chocolat noir', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:34:16.302344', [{'ingredient_id': '5f414af6-d3e6-4def-9c3d-b0ec069f55b3', 'quantite': '10 cl'}, {'ingredient_id': '3c36a9ea-f400-4509-9b69-ef5c3610d9bd', 'quantite': '3'}, {'ingredient_id': '55d550d3-f103-4b7b-bd3e-a9452372c712', 'quantite': '100 g'}, {'ingredient_id': '93234f48-2012-4274-b41e-cab2ccd203cb', 'quantite': '100 g'}, {'ingredient_id': '084617c8-80de-4c7b-b5f3-fe534a8f07b9', 'quantite': '50 g'}, {'ingredient_id': 'd6c02d54-537d-4f52-b882-e406f46b9a81', 'quantite': '50 g'}, {'ingredient_id': '77ef5933-dc76-4641-99b8-4309d437b490', 'quantite': '250 g'}, {'ingredient_id': 'e9e20fa1-7635-4bc9-b299-c180518069ea', 'quantite': '100 g'}, {'ingredient_id': 'e75a9ea4-0cb3-4ac2-856e-65b418a457ec', 'quantite': '3'}, {'ingredient_id': '2982c4f6-b1ca-4b00-9639-3fd2dfd6a071', 'quantite': '3'}, {'ingredient_id': '88c431bd-e25b-4633-b0d7-2548745801de', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56145, 'Salade exotique  fruits et crevettes', 'mâche, crevettes, banane, kiwi, avocat, tomates cerise, rhum, sucre en poudre, beurre, crème fraîche, yaourt, huile d''olive, jus de citron, jus d''orange, vinaigre balsamique, ail, sel, curry', '25 min', ['Disposer la mâche dans des petites assiettes ou des coupes à glaces (sympa pour la présentation).', 'Couper l''avocat et le kiwi en dés et déposer sur la salade.', 'Décortiquer les crevettes et les diposer autour de la coupe ou de l''asiette.', 'Eplucher les bananes, les couper en rondelles et les mettre dans une poêle avec du beurre à feu vif.', 'Les faire sauter (elles ne doivent pas finir en compote),faire flamber avec un peu de rhum, ajouter le sucre pour la caramélisation et après avoir attendu qu''elles soient devenues tièdes, répartir sur les assiettes.', 'Ajouter les tomates cerises coupées en 2 pour la déco et n''ajouter la vinaigrette qu''au moment de servir.', 'On peut agrémenter de quelques grains de maïs  pour la couleur ou quelques quartiers d''agrumes (pamplemousse, clémentine) pelés à vif.'], ['Presse-agrumes', 'Balance de cuisine', 'Casserole'], ['entrée', 'banane', 'kiwi', 'crème fraîche', 'recettes de cuisine', 'yaourt', 'rhum', 'sel', 'confiserie', 'testées', 'avocat', 'cocktail', 'facile', 'bon marché', 'Salade exotique  fruits et crevettes', 'ail', 'rapide', 'plat', 'sucre en poudre', 'recette', 'salade avocat', 'mâche', 'cuisine', 'recettes', 'boisson', 'huile d''olive', 'dessert', 'crevettes', 'plat de résistance', 'jus de citron', 'beurre', 'vinaigre balsamique', 'jus d''orange', 'curry', 'tomates cerise'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:34:19.989889', [{'ingredient_id': 'eca738f4-0e87-4148-bbc5-04fe246a31fe', 'quantite': '1'}, {'ingredient_id': '7686d893-81a3-4dd7-8c6d-f78de84bbd61', 'quantite': '6'}, {'ingredient_id': 'a44272e1-38dc-48c4-ad4a-2491dd90c4d6', 'quantite': '3'}, {'ingredient_id': '0ab939ed-67f5-4078-85c4-dde47b14aab4', 'quantite': '2'}, {'ingredient_id': 'c31f0cd0-e401-476a-99da-cfd969fbfa68', 'quantite': '2'}, {'ingredient_id': '061ba9a3-94ae-4c4f-b09e-41d872d8b587', 'quantite': ''}, {'ingredient_id': 'bbb4661d-967b-42ab-8245-47c622904b91', 'quantite': '1'}, {'ingredient_id': 'ef711ca4-df18-4a1b-ac35-d3e7d70daad6', 'quantite': '1 cuillères'}, {'ingredient_id': '4c0bf357-58cf-42f4-93bc-c696b5e7aa25', 'quantite': '20 g'}, {'ingredient_id': 'e510982b-7da7-42e3-9212-5218efe98eea', 'quantite': '3 cuillères'}, {'ingredient_id': 'ffec1250-a6f8-4655-83a2-700d68f6536d', 'quantite': ''}, {'ingredient_id': '37d6a3d1-5c0c-452e-b521-85128c282402', 'quantite': ''}, {'ingredient_id': '97307117-a901-4560-b570-ba796647f865', 'quantite': ''}, {'ingredient_id': '66acd8a2-4b78-45d9-b61e-9da6eefd6cc6', 'quantite': '2 cuillères'}, {'ingredient_id': 'ddac8754-d799-47ee-801b-b80f241aa166', 'quantite': '1 cuillères'}, {'ingredient_id': 'a415c95a-3e9a-47ac-8686-4846674bf0f3', 'quantite': '1'}, {'ingredient_id': '86b6b59d-8e97-475a-975d-a513aaab92e6', 'quantite': ''}, {'ingredient_id': '01ae44ae-a1c2-433a-9029-9ed42bfd4361', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (535033, 'Cake bananes, noix de pécan, pépites de chocolat', 'farine, beurre, rhum, vergeoise blonde, levure chimique, oeuf, banane, noix de pécan, pépites de chocolat', '20 min', ['Dans un robot, mettre le fouet et melanger le beurre et la vergeoise jusqu''à avoir un mélange homogène.', 'Incorporer les œufs petit à petit.', 'Enlever le fouet du robot, mettre la feuille  puis ajouter la farine et la levure', 'Ajouter les bananes coupées en petits dès, les pépites de chocolat, les noix de pécan et le rhum et mélanger, toujours avec la feuille du robot, jusqu''à ce que tout soit bien mélangé.
On ne doit plus voir de morceau de banane.', 'Préchauffer le four à 170°C, mettre la pâte dans le moule qui aura été beurré et fariné, enfourner, descendre le four à 150°C et cuire 1h'], ['Rouleau à pâtisserie', 'Passoire', 'Moule à tarte'], ['Cake bananes', 'entrée', 'banane', 'vergeoise blonde', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'levure chimique', 'noix de pécan', 'facile', 'gâteau', 'oeuf', 'plat', 'pépites de chocolat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'cocktail'], 'Dessert', e8670bd7-30d8-4b06-ad7e-40dc72eae3a5, '2025-09-26T16:34:23.627577', [{'ingredient_id': 'a556b843-2284-4fec-b7b0-4aa8907247a8', 'quantite': '240 g'}, {'ingredient_id': '3a934395-1c30-43d2-9a3e-4e78408129a9', 'quantite': '150 g'}, {'ingredient_id': 'b655d2cd-6b0d-4fa1-b928-4e5d767ac1b8', 'quantite': '3 cl'}, {'ingredient_id': '245ae61d-3a51-42d3-8bc6-cf685a1ba888', 'quantite': '120 g'}, {'ingredient_id': '0f52f457-b4c1-4919-adc7-fe674faff3d1', 'quantite': '1'}, {'ingredient_id': 'cfa86cc6-794d-4517-9ccc-6dd9796b3e06', 'quantite': '2'}, {'ingredient_id': '9ad98d3d-42dd-40cf-879b-d6bbfdc6fcde', 'quantite': '3'}, {'ingredient_id': '2b0f7d41-6db2-470a-97cc-3e611821df26', 'quantite': '80 g'}, {'ingredient_id': '2776f618-abcd-4d8f-81d6-81edbc63e0f4', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (67043, 'Confiture de bananes frecinettes à l''orange verte', 'banane, sucre, orange, citron vert, vanille, cannelle, rhum', '10 min', ['Couper les bananes en rondelles ainsi que l''orange verte.', 'Ajouter dans une casserole les fruits coupés, le sucre, le jus du citron vert, la cannelle et la vanille.', 'Laisser cuire 45 minutes à feu doux en remuant fréquemment.', 'Ajouter sur le feu le rhum blanc.', 'Mettre en pot..... et déguster.'], ['Mixeur', 'Râpe', 'Pince de cuisine', 'Rouleau à pâtisserie', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'plat', 'recette', 'cuisine', 'recettes', 'Confiture de bananes frecinettes à l''orange verte', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'moyen', 'orange', 'citron vert', 'cannelle', 'sucre', 'cocktail', 'confiture d''orange'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:34:28.110203', [{'ingredient_id': 'cf66ebb9-456d-43e9-801a-5992d5833e56', 'quantite': '800 g'}, {'ingredient_id': '5dc2ed84-2ea3-4de5-b460-751af4d6e867', 'quantite': '500 g'}, {'ingredient_id': '98fe6c40-d14e-4360-826c-752772c36f9e', 'quantite': '1'}, {'ingredient_id': '5afbe5f8-1b3c-4bab-8784-23ca29f10fe0', 'quantite': ''}, {'ingredient_id': '6304fb13-f61e-43f3-ae51-89b5c75a467f', 'quantite': '1'}, {'ingredient_id': 'ca0cc205-79ab-4de8-988a-7b8edb6c9126', 'quantite': '1'}, {'ingredient_id': '862825d5-d8c0-4cb4-8e69-8964a56de9b1', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73543, 'Crumble poires bananes et pépites de chocolat', 'banane, poire, farine, beurre, amandes en poudre, sucre en poudre, gingembre, chocolat', '10 min', ['Préchauffer votre four à 180°, thermostat 6.', 'Eplucher les fruits puis les couper en rondelles et en dés.', 'Faire le sablé en mélangeant du bout des doigts beurre, farine, poudre d''amande, sucre et épices. Rajouter les pépites une fois que la pâte a la consistence d''une grosse semoule.', 'Disposer les fruits dans un plat et répartir le mélange sablé sur ces derniers.', 'Enfourner 20 min.', 'Servir avec une boule de glace!'], ['Râpe', 'Économe'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'poire', 'très facile', 'bon marché', 'amandes en poudre', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'autres crumbles', 'beurre', 'cocktail', 'Crumble poires bananes et pépites de chocolat'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:34:31.617293', [{'ingredient_id': 'ab5cbe46-e3ce-4eff-ad4b-0c7cbe60c198', 'quantite': '2'}, {'ingredient_id': '9ce63950-52d2-4499-b767-5fa1a360a946', 'quantite': '6'}, {'ingredient_id': '31ff76f8-5e21-498c-abc6-62c436d220c1', 'quantite': '100 g'}, {'ingredient_id': 'f215f955-9543-402d-886b-9d4b8c2faa73', 'quantite': '100 g'}, {'ingredient_id': '37e7ed81-3814-4706-a6f6-a7e95764dd0b', 'quantite': '60 g'}, {'ingredient_id': '6984faee-1728-4fec-9652-91c8f8427f46', 'quantite': '100 g'}, {'ingredient_id': '3a2100d3-0391-46e1-ad8d-d1bdd480f88f', 'quantite': '1 cuillères'}, {'ingredient_id': 'b16c2f47-f128-497b-8e30-fcc4ea3b471e', 'quantite': '125 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34628, 'Smoothie aux fruits', 'banane, fruits, mangue, kiwi, framboises, abricot, pêche, ananas, prune, lait écrémé, soja, glaçons', '5 min', ['Dans un mixer, mettre tous les fruits coupés en gros morceaux (pelés et dénoyautes bien sûr). La banane est essentielle pour avoir une bonne consistance. ', 'Les fruits surgelés donnent une boisson fraîche instantanée. ', 'Ajouter le lait et mixer. ', 'Verser dans deux verres.'], ['Poêle', 'Pince de cuisine'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'soja', 'confiserie', 'lait écrémé', 'testées', 'abricot', 'très facile', 'framboises', 'bon marché', 'prune', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'Smoothie aux fruits', 'dessert', 'plat de résistance', 'glaçons', 'ananas', 'pêche', 'fruits', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:34:36.215362', [{'ingredient_id': '750d38ef-ccf7-4b4e-b572-4b09508f69cf', 'quantite': '1'}, {'ingredient_id': '3aae2e7b-8553-4a2f-9b98-747e0790c646', 'quantite': ''}, {'ingredient_id': '67e97154-5ad9-4211-9395-3dac3e5b95d1', 'quantite': '1'}, {'ingredient_id': '5a699abb-62ad-4e68-b2c1-9c3e4c271aed', 'quantite': '2'}, {'ingredient_id': 'e46c4a1c-ecb1-4e0e-ae60-965d2954266e', 'quantite': '1'}, {'ingredient_id': '648ee37a-8a96-49dd-9682-ca4c882bbd8a', 'quantite': '2'}, {'ingredient_id': '413e4f03-a07d-4738-88dc-6a7f48626b16', 'quantite': '1'}, {'ingredient_id': '22a63dd4-eb6e-49e8-b384-c9b153130d2c', 'quantite': '1'}, {'ingredient_id': 'b582c836-4d04-4cd2-bd95-b7cbd570ed3b', 'quantite': '3'}, {'ingredient_id': '2f68cab6-048c-4a8b-8373-d25852790d4d', 'quantite': ''}, {'ingredient_id': 'b8fa7b5d-b4a2-4d70-a24e-9f6e3f2a8545', 'quantite': ''}, {'ingredient_id': 'abd3ceb9-9374-4023-aa7e-b908bb058c90', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (88433, 'Crumble pépites de chocolat à la banane', 'farine, sucre, sucre vanillé, levure, beurre, banane, chocolat noir', '15 min', ['Préchauffez votre four a 180°C (thermostat 6).', 'Dans un récipient, mélangez la farine, le sucre, la levure et le contenu du sachet de sucre vanillé de façon à ce que le mélange soit homogène. ', 'Découpez le beurre en petits dés et ajoutez-le au mélange. Mélangez le tout avec vos mains pour que ça forme des grains (n''hésiter pas à ajouter du beurre si vos grains sont trop petits). ', 'Emballez le chocolat dans un torchon propre et cassez-le en morceaux avec un marteau.', 'Mélangez le chocolat ainsi brisé au reste de la préparation.            ', 'Beurrez votre moule, découpez vos bananes en rondelles. ', 'Disposez-les dans le moule et recouvrez-les de pâte à crumble. ', 'Faites cuire votre crumble pendant 30 minutes à 180°C (thermostat 6).'], ['Spatule', 'Verre doseur', 'Ouvre-boîte', 'Fouet', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre vanillé', 'beurre', 'Crumble pépites de chocolat à la banane', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:34:42.005188', [{'ingredient_id': 'bb8006ad-6b0c-4624-a44d-ce39d1f979ef', 'quantite': '200 g'}, {'ingredient_id': '27d2d8d6-d713-468b-88ba-74b36d398730', 'quantite': '100 g'}, {'ingredient_id': '8ae6c423-a014-43e6-9356-ee99214c94b7', 'quantite': '1'}, {'ingredient_id': '45b55a33-7eb8-4f66-92ef-19d79361e29c', 'quantite': ''}, {'ingredient_id': '1d34e98c-405a-4fc5-9c8b-2c10802bc94a', 'quantite': '120 g'}, {'ingredient_id': '64abfd3b-0743-4f1b-a873-2702f2889f7a', 'quantite': '4'}, {'ingredient_id': '13289f1c-b0f5-436a-96c2-f57609c5929c', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169446, 'Les 3 fruits délicieux', 'fromage blanc, fraises, pomme, banane, perles multicolores, biscuits à la cuillère', '30 min', ['Découpez en 4 vos pommes . Ensuite découpez vos quarts en fine tranche . Dans des coupelles , disposez 1/4 de pommes que vous avez découpé .', 'Déposez 3 cuillères à café de fromage blanc sur vos pommes . ', 'Découpez les bananes . Déposez les tranches de bananes en sorte que cela recouvre votre fromage blanc . ', 'Mettez du fromage blanc sur les bananes de faire en sorte que ça les recouvre . ', 'Déposez 5 fraises au bord , dans chaque choupelle   . ', 'A la fin il devrait vous restez une banane , une pomme et des fraises . Mixez tout ces ingrédients avec une cuillère à café de fromage blanc . Une fois mixez , versez-en par dessus le fromage blanc de vos coupelles . ', 'Rajoutez des perles multicolores .', 'Laissez reposer vos desserts au frais quelques minutes .', 'Et bon appétit !'], ['Rouleau à pâtisserie', 'Balance de cuisine', 'Planche à découper', 'Batteur électrique', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'biscuits à la cuillère', 'facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'perles multicolores', 'plat de résistance', 'pomme', 'Les 3 fruits délicieux', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:34:46.960794', [{'ingredient_id': '65009eeb-82fe-4617-838a-90a733fae19c', 'quantite': ''}, {'ingredient_id': '9f83c1fc-24d2-41f9-99a6-840804785ea0', 'quantite': '35'}, {'ingredient_id': '3c0e01b9-c57f-4d93-a06e-2f7ec68257b8', 'quantite': '2'}, {'ingredient_id': '5ce16fcd-794b-456c-ad7a-b09d54aac30b', 'quantite': '2'}, {'ingredient_id': '4d1a0eac-eb17-4f40-b303-20bea9fd6ea6', 'quantite': ''}, {'ingredient_id': '85599b3b-771a-43ae-9193-31c3f42163d1', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27475, 'MARMELADE DE FRUITS', 'ananas, kiwi, banane, fruit de la passion, cassonade, mangue, goyave, citron', '20 min', ['Eplucher les kiwis, les bananes, papayes et l''ananas pour les mettre dans un saladier. ', 'Ajouter la cassonade, les 2 jus de citron, laisser macérer 3 heures au frigo. ', 'Mettre tous les fruits et liquide de macération dans une cocotte. ', 'Laisser cuire doucement 15 mn. ', 'Servir frais avec du fromage blanc.'], ['Mixeur', 'Casserole', 'Tire-bouchon', 'Poêle', 'Verre doseur'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'goyave', 'facile', 'bon marché', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'fruit de la passion', 'dessert', 'plat de résistance', 'MARMELADE DE FRUITS', 'citron', 'ananas', 'cocktail'], 'Dessert', 90a52d13-477e-48dd-8238-336465ab5163, '2025-09-26T16:34:51.881979', [{'ingredient_id': '7c884061-c4a5-41df-bee7-cf80be13449d', 'quantite': '1'}, {'ingredient_id': '60e19971-f576-463d-850d-bd6c7dd9b5ee', 'quantite': '4'}, {'ingredient_id': '41af6d4f-e1b3-4e25-b30a-536fb9f44e8e', 'quantite': '2'}, {'ingredient_id': '993460da-ea28-4ade-89bf-3277e478b653', 'quantite': '4'}, {'ingredient_id': 'c6612c25-ab35-49dd-8128-d2de5eb0d53d', 'quantite': '250 g'}, {'ingredient_id': '16a7eca8-bfe7-40df-b4c7-856bacebc188', 'quantite': '1'}, {'ingredient_id': 'f31f3711-9e73-4b24-b121-876659210ade', 'quantite': '2'}, {'ingredient_id': '215cecc5-3d75-4332-a90a-49188c7e2c0b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336608, 'Gambas à la banane et au lait de coco', 'gambas, banane, jus de citron, échalote, oignon, vanille, lait de coco, poivre de Cayenne', '10 min', ['Couper les bananes en 2 puis en dés et les parsemer de jus de citron.', 'Faire revenir les échalotes et les oignons émincés à l''huile d''olive.', 'Ajouter les gambas, cuire 3 min à feu doux.', 'Ajouter les gousses de vanille fendues, les graines à part. ', 'Saler et poivrer.', 'Ajouter les bananes, cuire légèrement.', 'Ajouter le lait de coco, laisser chauffer à feu doux.', 'Ajouter le poivre de Cayenne.', 'Retirer les gousses de vanille.', 'Servir avec des pâtes ou de la ciabatta. '], ['Louche', 'Casserole', 'Mixeur', 'Moule à tarte', 'Balance de cuisine'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'gambas', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'vanille', 'dessert', 'crevettes', 'plat de résistance', 'jus de citron', 'moyen', 'poivre de Cayenne', 'Gambas à la banane et au lait de coco', 'cocktail', 'échalote'], 'Entrée', 8746d963-b075-4713-8e54-0b5d9f898701, '2025-09-26T16:34:56.461101', [{'ingredient_id': '6f11dcd9-956c-457a-a76f-a89cb4b72ebd', 'quantite': '20'}, {'ingredient_id': '3df48767-6773-4f35-8337-44c64f90360b', 'quantite': '2'}, {'ingredient_id': 'b4752a08-3c34-41c9-b150-6b9952bc10b7', 'quantite': '1'}, {'ingredient_id': '09b8454c-628d-481e-8a51-77d2eac4476f', 'quantite': '2'}, {'ingredient_id': '91b1d9f4-182c-4469-9209-066dbce02472', 'quantite': '4'}, {'ingredient_id': '52a802bf-2cc5-4fa6-8504-6561ba7c8c89', 'quantite': '2'}, {'ingredient_id': 'd153425c-abe5-4f21-bf95-441a61927a46', 'quantite': '250 g'}, {'ingredient_id': '9fb7b93a-243b-419e-9d17-76f1406542c9', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315206, 'Whoopies choco banane', 'chocolat noir, beurre, oeuf, cassonade, levure chimique, sel, cacao, banane, fromage frais', '30 min', ['Matériel nécessaire :', '- poches à douille rondes', '- mixeur ou moulin à légumes', '- papier sulfurisé ', 'Préchauffer le four à 190°C (thermostat 6/7) puis faire fondre le beurre avec le sel (sans faire mousser) environ 3 à 4 min puis ajouter le chocolat en morceaux et fouetter pour obtenir un mélange homogène.', 'Remplir au 2/3 une poche à douille et disposer sur plaque de cuisson 40 petits cercles (pour 20 petits) ou 20 grands (pour 10 grands).', 'Enfourner 10 min et laisser refroidir hors de la plaque de cuisson.', 'Mixer ou passer au moulin à légumes les bananes et ajouter le fromage et le sucre. Bien mélanger, puis remplir au 2/3 la poche et garnir la moitié des coques, ensuite assembler les whoopies et mettre au frigo 1 h minimum.'], ['Verre doseur', 'Batteur électrique', 'Économe'], ['', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'cassonade', 'levure chimique', 'cacao', 'rapide', 'oeuf', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'moyen', 'beurre', 'Whoopies choco banane', 'cocktail'], 'Dessert', adcc8e89-ec1e-4f9c-8760-375c1bb56272, '2025-09-26T16:35:01.071142', [{'ingredient_id': 'edfd8f42-269e-4167-b20b-9a16335683d9', 'quantite': '120 g'}, {'ingredient_id': '51d9c616-7776-409d-9055-8dc1eaba6f1e', 'quantite': '100 g'}, {'ingredient_id': '258d73bb-1e00-4e11-8838-4a3a5ce4a695', 'quantite': '2'}, {'ingredient_id': 'ddc12561-fb41-483a-86ab-c5adc09cc2c4', 'quantite': '100 g'}, {'ingredient_id': '67ff5847-2e52-4033-b133-adfedb3132ff', 'quantite': ''}, {'ingredient_id': '67711f54-b78a-4b9f-bcff-2476371f300e', 'quantite': '1'}, {'ingredient_id': 'ac65d3c7-f82b-4269-a21d-22ca607e49ef', 'quantite': '1 cuillères'}, {'ingredient_id': '7f3696d2-4f1b-4c5b-b564-b2f6f16c483c', 'quantite': '2'}, {'ingredient_id': '42bf9615-0110-4a29-b579-4303deb5246d', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (348087, 'Gâteau orange et banane', 'orange, banane, citron, farine, sucre, sucre vanillé, levure, eau de fleur d''oranger, beurre, oeuf', '25 min', ['A l’aide d’un couteau, pelez l’orange et le citron, recueillez la pulpe en enlevant la peau des quartiers. Essayez d’émietter la pulpe sans trop l’écraser et recueillez le jus avec la pulpe.', 'Dans un saladier, mélangez avec soin la farine, le sucre, le sucre vanillé et la levure.', 'Préchauffez le four à 180°C (thermostat 6).', 'Ajoutez au mélange les oeufs puis le beurre fondu, puis l’eau de fleur d''oranger.', 'Une fois la pâte bien lisse, incorporez la pulpe et le jus de l’orange et du citron.', 'Ajoutez à la préparation les bananes coupées en dés.', 'Versez la préparation dans un moule à manqué préalablement beurré puis enfournez pour 30 minutes de cuisson.', 'Au bout de 30 minutes, baissez le four à 160°C (thermostat 5) puis laissez cuire pour 30 minutes supplémentaires.'], ['Couteau de chef', 'Batteur électrique'], ['entrée', 'banane', 'Gâteau orange et banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'gâteau à la banane', 'beurre', 'citron', 'orange', 'eau de fleur d''oranger', 'sucre', 'cocktail'], 'Dessert', b3e2ab0c-67bb-4b03-a1b8-512cd9823492, '2025-09-26T16:35:04.784520', [{'ingredient_id': 'f249b429-3fa6-4d3b-bd76-8dee5a06aa66', 'quantite': '1'}, {'ingredient_id': '9515fb5a-f065-42f1-b80f-f237f173118c', 'quantite': '2'}, {'ingredient_id': 'ecda6fc2-ac67-43cb-9668-c5a568c52747', 'quantite': '1'}, {'ingredient_id': '7a006eb7-323e-4d0d-b155-9ab3b1505add', 'quantite': '100 g'}, {'ingredient_id': 'fb9968be-d722-4394-aa65-25ba341be60a', 'quantite': '150 g'}, {'ingredient_id': 'bd8e051c-89fe-4697-9b57-d09425c9c745', 'quantite': '2'}, {'ingredient_id': '672ee20d-4e14-415c-8c75-1d704b739304', 'quantite': '1'}, {'ingredient_id': '918ea19a-063f-4bdd-b623-107f8806e8af', 'quantite': '1 cuillères'}, {'ingredient_id': '7b01cdb6-1c6a-4713-b8ff-307a722842cd', 'quantite': '50 g'}, {'ingredient_id': 'f387fd9a-0e74-4a8e-bf80-229555cf5c0b', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12140, 'Porc à l''indonésienne', 'échine de porc, oignon, ail, poivron rouge, poivron vert, banane, tomate, gingembre, curry, pousse de bambou, poivre, sel', '30 min', ['Coupez le porc en gros dés, faites revenir lentement et doucement les morceaux.', 'Hâchez finement les oignons que vous ferez revenir avec la viande, puis ajoutez les tomates épépinées et concassées en morceaux.', 'Coupez en fines lamelles les poivrons et ajoutez pour qu''ils rissolent.', 'Quand tous les ingrédients sont revenus, couvrez-les d''eau, salez et poivrez.', 'A mi-cuisson, ajoutez le  gingembre (1/2 cuillére à 1 cuillére à café), puis la même quantité de curry, l''ail, les pousses de bambou.', 'A la fin de la cuisson, rectifier l''assaisonnement puis ajoutez les rondelles de bananes.'], ['Verre doseur', 'Casserole'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'échine de porc', 'sel', 'confiserie', 'testées', 'plats indonésiens', 'poivron vert', 'facile', 'ail', 'tomate', 'plat', 'recette', 'cuisine', 'poivron rouge', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'pousse de bambou', 'poivre', 'Porc à l''indonésienne', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:35:08.367831', [{'ingredient_id': '2d77d055-4339-45c5-a800-2c9b9d10107d', 'quantite': '1 kg'}, {'ingredient_id': 'c8555a31-0834-4b72-af99-3d98c9a3653b', 'quantite': '4'}, {'ingredient_id': '68c18c3c-c59c-474e-8bc0-484486d87265', 'quantite': '1'}, {'ingredient_id': '0c98b46c-6219-48d0-861a-09f2b6da772d', 'quantite': '1'}, {'ingredient_id': '74e975bc-8a57-4a4c-a443-7480818a86e5', 'quantite': '1'}, {'ingredient_id': 'c36a518d-df49-42ab-82e1-1cc03e30f6ed', 'quantite': '2'}, {'ingredient_id': '907efd24-89f4-4cd4-b764-595284c5adc2', 'quantite': '3'}, {'ingredient_id': '15885742-e9bd-4a19-a29f-b8d44b689a16', 'quantite': ''}, {'ingredient_id': '832dc58a-b202-4db2-afcc-f381b3ac24ff', 'quantite': ''}, {'ingredient_id': '4752ec87-7664-4fcc-94a5-a64febd214fa', 'quantite': '230 g'}, {'ingredient_id': 'f2b6feec-ddea-4af9-9f24-b41b1594ea07', 'quantite': ''}, {'ingredient_id': '62653bc2-85e8-44cd-94e7-0cd0d1bf139f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228113, 'Muffins à la banane légers', 'banane, oeuf, sucre, maïzena, farine, petit suisse, sel, levure chimique', '5 min', ['Faire blanchir les oeufs et le sucre avec une pincée de sel. Ecraser les 3 bananes et les ajouter au mélange. Ensuite, tamiser la farine, la maïzena et la levure dans la préparation. Ajouter le petit suisse.', '> Petit plus : ajouter un peu de vanille.', 'Mettre la préparation dans des petits moules en silicone. Four à 180°C (thermostat 6) pendant 15-20 minutes (à surveiller)', 'Bon appétit !'], ['Presse-agrumes', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'petit suisse', 'testées', 'levure chimique', 'facile', 'maïzena', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'muffin salé', 'Muffins à la banane légers', 'sucre', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:35:11.929677', [{'ingredient_id': 'a107f343-1b48-4ffa-8d27-a46f55c04b55', 'quantite': '3'}, {'ingredient_id': '123591e1-1d9e-49a0-a767-2579e6f9de60', 'quantite': '2'}, {'ingredient_id': '63dfa41e-2e76-4dcf-bec9-b65559fdf1ef', 'quantite': '75 g'}, {'ingredient_id': '892196db-719d-4354-bd61-6bbd1acfcf37', 'quantite': '25 g'}, {'ingredient_id': 'a21edaf1-e5de-4431-918b-5b8517134974', 'quantite': '175 g'}, {'ingredient_id': '9f1b4ddb-c543-4733-b706-b71579e452b1', 'quantite': '1'}, {'ingredient_id': '1e8e0f95-43a6-4ac1-83ea-e325c83f127a', 'quantite': '1'}, {'ingredient_id': 'c1a8b282-227e-46b8-b48c-22957149059a', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66812, 'Papillotes de poisson à la banane', 'poisson, banane, citron, poivre, sel, sucre, huile d''olive', '3 min', ['Faire chauffer le four à 200°C (thermostat 6-7).', 'Mettre dans une feuille de papier d''aluminium le filet de poisson.', 'Le saler et le poivrer selon votre goût.', 'Le recouvrir du citron, de la banane coupée en morceaux.', 'Saupoudrer de sucre (pas trop), mettre un mince filet d''huile.', 'Refermer le papier d''aluminium.', 'Enfourner 20 min environ (contrôler que le poisson est cuit car la cuisson dépend du poisson).'], ['Batteur électrique', 'Couteau de chef', 'Rouleau à pâtisserie', 'Presse-agrumes'], ['entrée', 'Papillotes de poisson à la banane', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'poisson en papillote', 'cuisine', 'recettes', 'boisson', 'poisson', 'huile d''olive', 'dessert', 'plat de résistance', 'citron', 'poivre', 'sucre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:35:15.609199', [{'ingredient_id': '6d124cf8-f0be-416b-95cb-b8d18659891f', 'quantite': '1'}, {'ingredient_id': 'e1e08d61-b16f-4c8e-8b13-5f124baa6a4f', 'quantite': '1'}, {'ingredient_id': '9181cce5-e9a0-4321-9603-a720073353be', 'quantite': '2'}, {'ingredient_id': '310bc9b2-9d25-48a1-9edb-4e20c9210745', 'quantite': ''}, {'ingredient_id': '080ae2e7-ee1a-4c9d-a19a-d74d87819ee0', 'quantite': ''}, {'ingredient_id': '91e4a71c-8c6b-44fa-a2fc-7580270ffd4f', 'quantite': ''}, {'ingredient_id': '50a38db2-63ae-4508-8f1a-0614c4f1e69b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (218265, 'Salde de fruits à la noix de coco', 'banane, papaye, pomme, noix de coco rapée, miel, jus de citron', '15 min', ['Peler la papaye et la banane puis les couper en morceaux.', 'Couper la pomme en petits morceaux sans peler la peau.', 'Mêler tous les fruits dans un saladier. Arroser de jus de citron et de miel. Saupoudrer ensuite de noix de coco râpée.'], ['Louche', 'Presse-agrumes', 'Rouleau à pâtisserie', 'Mixeur', 'Spatule'], ['', 'entrée', 'banane', 'papaye', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'recette', 'cuisine', 'Salde de fruits à la noix de coco', 'miel', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'pomme', 'jus de citron', 'moyen', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:35:20.391931', [{'ingredient_id': '46882279-12d2-4fb0-aaf3-6bfe665b28ea', 'quantite': '1'}, {'ingredient_id': '7bcf86be-63f8-43a3-952f-d8a41226d182', 'quantite': '1'}, {'ingredient_id': 'f677dba4-c0d0-4722-a557-a292a6b63d5f', 'quantite': '1'}, {'ingredient_id': '92386631-8ba0-4289-8eeb-48cd4bdf5561', 'quantite': '4 cuillères'}, {'ingredient_id': '6d7e702f-d143-4db8-93df-43a69a9b82f6', 'quantite': '2 cuillères'}, {'ingredient_id': '9c4cece3-343d-4e81-9874-8bca84470ede', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52470, 'Tarte aux bananes flambées au rhum', 'pâte sablée, lait concentré sucré, banane, oeuf, farine, beurre, cassonade, rhum', '20 min', ['Préchauffer le four à 210°C (thermostat 7). ', 'Coupez les bananes en rondelles, puis faites-les revenir dans le beurre chaud, et saupoudrez de cassonade. ', 'Lorsque les bananes sont bien dorées, versez le rhum et faites flamber immédiatement; laisser refroidir. ', 'Dans un saladier, mélangez les œufs, la farine et le lait concentré sucré.', 'Étalez la pâte dans un moule à tarte, puis piquez-la avec une fourchette. ', 'Versez ensuite la préparation dedans, puis disposez les bananes sur le dessus. ', 'Enfournez pendant 20 à 30 min à 210°C.'], ['Râpe', 'Tire-bouchon', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'cassonade', 'facile', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'lait concentré sucré', 'boisson', 'farine', 'dessert', 'plat de résistance', 'Tarte aux bananes flambées au rhum', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:35:23.957990', [{'ingredient_id': '7d01409f-af5e-4489-a522-8b3f41bb6457', 'quantite': '1'}, {'ingredient_id': '401b8067-98a3-41ff-ab85-61e8f5eb68e4', 'quantite': '400 g'}, {'ingredient_id': '59e37d88-e145-4d9b-b9b4-70c47b8d8cc2', 'quantite': '4'}, {'ingredient_id': 'e2b3a3ec-140a-4554-b6c2-8028b1a950f0', 'quantite': '3'}, {'ingredient_id': 'f55cb2d4-098a-40bd-b01d-c9a3f304f4e3', 'quantite': '1 cuillères'}, {'ingredient_id': 'a44092c0-109f-415f-b7f7-1df4d38a2a87', 'quantite': '20 g'}, {'ingredient_id': '29d5e8f3-6068-446e-a1ed-f2f5ff366283', 'quantite': '40 g'}, {'ingredient_id': '3afe896b-5319-4051-b14c-6d609b0f01d3', 'quantite': '50 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (310599, 'Crumble gourmand à la pomme, banane et raisins secs', 'pomme, banane, chocolat noir, citron, raisins secs, cannelle, beurre, farine, sucre roux', '40 min', ['Préchauffer le four à 210°C (thermostat 7).', 'Éplucher, épépiner et couper en quartiers les pommes.', 'Couper les bananes en rondelles.', 'Mélanger les deux et les disperser équitablement dans un plat. Ajouter les raisins secs.', 'Couper le chocolat en carreaux et placer ces derniers dans le mélange pomme, banane.', 'Saupoudrer de cannelle (à volonté ou à petite dose selon les goûts). Enfin, presser le citron et verser le jus.', 'Préparer ensuite la pâte à crumble.', 'Mélanger l''ensemble des ingrédients jusqu’à obtenir un mélange "sableux".', 'Ajouter pour finir, cette pâte au dessus de la garniture de manière a bien tout couvrir.', 'Enfourner alors le tout pendant environ 25 min.', 'Servir tiède ou froid.'], ['Louche', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Crumble gourmand à la pomme', 'chocolat noir', 'banane et raisins secs', 'pomme', 'citron', 'raisins secs', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:35:28.606932', [{'ingredient_id': '831c1550-d0bc-492b-be3e-86fd51352dc6', 'quantite': '8'}, {'ingredient_id': 'b0aff7d1-5cfb-4489-93e2-5418eb667a08', 'quantite': '3'}, {'ingredient_id': '9ba944ab-8317-4647-8bce-1c1d1400307c', 'quantite': '100 g'}, {'ingredient_id': '01734f08-ee21-4862-86d3-f23f8e955505', 'quantite': '1'}, {'ingredient_id': '92675d3d-0073-496b-9830-6872344811fc', 'quantite': '50 g'}, {'ingredient_id': '84887b98-d9d7-48a2-9174-c19d81135a65', 'quantite': '1'}, {'ingredient_id': '243346eb-db9a-43e2-acf8-339783679935', 'quantite': '100 g'}, {'ingredient_id': 'db9ab59d-2f4e-4ddf-8aaf-2ce05da35dec', 'quantite': '150 g'}, {'ingredient_id': '507cd8f3-f902-458b-96ed-348212ecd779', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345052, 'Gaufre brunch, bacon, banane et sirop d''érable', 'gaufre, banane, sirop d''érable, bacon', '5 min', ['Trancher les gaufres en deux dans la largeur.', 'Découper la banane en rondelles.', 'Disposer les rondelles sur une des moitiés de gaufre.', 'Recouvrir avec les tranches de bacon.', 'Poser la deuxième moitié de gaufre par dessus.', 'Napper de sirop d''érable et déguster.'], ['Moule à tarte', 'Planche à découper'], ['', 'bacon', 'banane', 'entrée', 'recettes de cuisine', 'banane et sirop d''érable', 'confiserie', 'testées', 'très facile', 'sirop d''érable', 'bon marché', 'Gaufre brunch', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'gaufre', 'dessert', 'plat de résistance', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:35:33.264401', [{'ingredient_id': '17ca413b-8740-4b4c-9084-cb59400a33f3', 'quantite': '2'}, {'ingredient_id': 'f8e17735-d88f-4912-8db3-4a9acd7822f8', 'quantite': '1'}, {'ingredient_id': '12b504de-1f32-44cf-9820-503c55d8c6d5', 'quantite': '1'}, {'ingredient_id': 'b72ae87e-aeec-424a-a2ce-d19155e03170', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (112817, 'Gourmandise choco/banane', 'banane, chocolat en poudre, fromage blanc, chocolat noir, cassonade', '5 min', ['1) Ecraser la banane et la mélanger au sucre jusqu''à obtenir un mélange homogène et souple', '2) Mélanger le fromage blanc et le chocolat en poudre, puis rajouter la "pâte de banane" et les pépites de chocolat', '3) Remuer jusqu''à ce que ce soit souple et fluidifié', '4) Mettre au réfrigérateur de une bonne heure avant de servir', 'Bon appétit !'], ['Balance de cuisine', 'Poêle', 'Tire-bouchon', 'Presse-agrumes', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'Gourmandise choco/banane', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'chocolat noir', 'chocolat en poudre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:35:36.986989', [{'ingredient_id': '7bd1bedf-9c4a-49b8-a8a4-e26a0a3b81db', 'quantite': '1'}, {'ingredient_id': '177d52fa-0c53-49f1-ae2e-cfee69ddf5ed', 'quantite': '5 cuillères'}, {'ingredient_id': '41f49d29-ef22-4bd4-89ba-130e76382f27', 'quantite': '250 g'}, {'ingredient_id': 'dacf88dd-325c-4e88-9c08-00f0b8fcc007', 'quantite': '50 g'}, {'ingredient_id': '187c7952-fb25-42c7-8d24-d16683d9e970', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (224655, 'Smoothie vert kiwi épinard banane', 'kiwi, banane, gingembre, épinards, basilic, lait d''amande, graines germées', '5 min', ['Coupez banane, kiwi, gingembre et insérez-les dans votre blender. Mixez une première fois. Ajoutez y le basilic et remixez. ', 'Ajoutez les pousses et les 20 cl de lait d''amande. Mixez le tout pendant quelques minutes et dégustez !'], ['Mixeur', 'Louche', 'Fouet', 'Presse-agrumes'], ['gingembre', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'lait d''amande', 'facile', 'rapide', 'plat', 'basilic', 'épinards', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'graines germées', 'Smoothie vert kiwi épinard banane', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:35:41.613622', [{'ingredient_id': '451ce84b-fd5b-4318-bc98-1639aeeaa7bd', 'quantite': '1'}, {'ingredient_id': '53a6df65-b036-4883-a3d6-c2c43eb27798', 'quantite': '1'}, {'ingredient_id': '9cd72b84-23d5-472d-9dce-a1e11877f6a8', 'quantite': '1'}, {'ingredient_id': '6ef007f2-70ac-429a-84c6-ac9725ef46cc', 'quantite': '2'}, {'ingredient_id': 'cd2aa925-3499-46b7-bd38-2874cc0951ea', 'quantite': '5'}, {'ingredient_id': 'fb50efa7-93d8-4421-885e-1735dc624aa0', 'quantite': '20 cl'}, {'ingredient_id': '7c70f35e-fad2-4991-990b-1023915507a9', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (218142, 'Velouté de kiwis gold', 'orange, fleur d''oranger, banane, kiwi, citron vert', '10 min', ['Presser l''oranger et mettre le jus dans un saladier. Ajouter l''eau de fleur d''oranger.', 'Éplucher et mixer les kiwis avec la banane.', 'Mixer les fruits assez finement.', 'Mélanger cet appareil au jus d''orange et mélanger soigneusement en fouettant.', 'Répartir le velouté dans des coupelles.', 'Décorer éventuellement avec une tranche de citron vert.', 'Mettre au frais au minimum une heure avant de servir'], ['Fouet', 'Presse-agrumes', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'Velouté de kiwis gold', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'fleur d''oranger', 'orange', 'citron vert', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:35:46.222504', [{'ingredient_id': '9119edd2-e0e8-4709-98b5-aa9eb3855a2d', 'quantite': '1'}, {'ingredient_id': '9c7f763f-bdc2-4d01-abfc-81317a719730', 'quantite': '1 cuillères'}, {'ingredient_id': 'b4f1588c-a9a3-4ec9-84e8-edf0c53a7243', 'quantite': '1'}, {'ingredient_id': '25ad516c-8c90-498f-b7d8-0a69c8654a3c', 'quantite': '4'}, {'ingredient_id': 'd157d518-27ca-4350-924b-6f227ab42e73', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (44064, 'Crumble aux coings', 'pomme, coing, banane, framboises, farine, vergeoise brune, beurre', '30 min', ['Préparer la pâte : ', 'Mélanger la farine et le sucre, puis ajouter le beurre bien froid coupé en tous petits morceaux, et travailler du bout des doigts jusqu’à obtenir un mélange sableux. ', 'Laisser reposer au frigo environ 30 min.', 'Éplucher et couper les fruits en morceaux. Faire cuire les morceaux de coings à la casserole, dans un fond d’eau pendant environ 10 min : les morceaux doivent céder à la fourchette, sans s’écraser complètement.', 'Couper le feu, et ajouter les autres fruits dans la casserole. Remuer délicatement, pour bien tout imprégner du jus des coings.', 'Verser les fruits dans le plat à gratin, recouvrir des miettes de pâte.', 'Enfourner à four préchauffé à 180°C (th 6), pendant 40 min environ.', 'Déguster tiède ou froid, accompagné de chantilly.'], ['Casserole', 'Moule à tarte', 'Économe', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'coing', 'testées', 'facile', 'framboises', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'autres crumbles', 'Crumble aux coings', 'cocktail'], 'Dessert', 6be77821-b0c5-484f-8070-e790de2a6978, '2025-09-26T16:35:49.792426', [{'ingredient_id': 'ab3ee8c7-3ef7-4d6e-8960-b6bf17e09314', 'quantite': '1'}, {'ingredient_id': '8fbc1ac3-a9da-41b2-a7d2-bf1a1476d105', 'quantite': '2'}, {'ingredient_id': '176ac9b3-c52a-4f9e-b5c5-ee5e0519f01f', 'quantite': '1'}, {'ingredient_id': '4a720f0d-47a2-4af5-ae39-667a7d85ee25', 'quantite': '150 g'}, {'ingredient_id': '07fbb317-00e2-40ba-a5c2-240a82564175', 'quantite': '200 g'}, {'ingredient_id': 'd3f551c0-e2b6-498a-91e9-446c595747d0', 'quantite': '120 g'}, {'ingredient_id': 'd68ef150-cb7d-4824-bfa2-60b14097249f', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (347728, 'Crumble banane chocolat speculoos revisité façon glacé', 'banane, sucre glace, lait, crème liquide, chocolat, biscuits secs, farine, beurre, sucre, banane, cannelle, sucre', '30 min', ['Préparation de la glace. ', 'Peler les bananes et les couper en morceaux. Mixer dans un blender ou un mixeur. ', 'Ajouter le sucre glace, le lait et la crème. Mixer jusqu''à l''obtention d''un mélange bien homogène. ', 'Verser dans les moules à cookie cup et placer au congélateur (minimum 2h).', 'Préparation de la pâte à crumble. ', 'Préchauffer le four à 180°C (thermostat 6).', 'Mélanger la farine, les speculoos, le sucre et le beurre. La pâte doit être sableuse. ', 'Répartir sur une plaque recouverte de papier cuisson et enfourner 20 minutes. ', 'Couper les 2 bananes restantes en cubes et faire revenir à la poêle avec un peu de beurre, le sucre et la cannelle. ', 'Démouler les cups de glace et y verser des cubes de bananes. Emietter la pâte à crumble sur le dessus.'], ['Louche', 'Casserole', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'chocolat', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'Crumble banane chocolat speculoos revisité façon glacé', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'sucre glace', 'lait', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:35:54.644016', [{'ingredient_id': '470c56ce-0060-4d26-8ac4-eaf879ebb2d7', 'quantite': '4'}, {'ingredient_id': 'a41cd0d6-2ec8-438d-99a5-126a670eb17b', 'quantite': '90 g'}, {'ingredient_id': '7a8485cd-157b-4cc9-bfdf-6a063a3eff7b', 'quantite': '25 cl'}, {'ingredient_id': 'debf017f-d8cc-48fb-b81b-8e2b3f6a6c63', 'quantite': '15 cl'}, {'ingredient_id': 'aa3788a4-e097-42a2-8ced-692d6028ce89', 'quantite': '80 g'}, {'ingredient_id': 'e57ee7b2-0f5f-47ed-9355-9e85e9cdfcb5', 'quantite': '8'}, {'ingredient_id': '799bb7f3-986b-4233-8b94-225050a603ca', 'quantite': '100 g'}, {'ingredient_id': '0ee977bf-688a-485f-9805-887807a839ee', 'quantite': '100 g'}, {'ingredient_id': 'a0d4dfc2-982a-40ac-bd15-960abd902187', 'quantite': '60 g'}, {'ingredient_id': 'a5c803d8-aa3b-47f2-bb2d-87e55a3e75b0', 'quantite': '2'}, {'ingredient_id': 'cc95cd75-fbbe-47dc-9382-0f7e9038158b', 'quantite': '1 cuillères'}, {'ingredient_id': 'd529675a-3461-4dc3-93b0-d4ea79263140', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68123, 'Mousse de bananes aux fruits rouges', 'banane, fruits rouges, crème fraîche, citron, sucre vanillé, blanc d''oeuf', '10 min', ['Couper les bananes en rondelles. Les mettre dans un mixer avec le jus des citrons, la crème fraîche et le sucre.', 'Mixer et mettre dans un bol. Monter les blancs en neige ferme, les incorporer à la préparation de bananes.', 'Mettre les fruits rouges choisis dans le fond d''un verre, puis la mousse à la banane.', 'Décorer avec quelques fruits rouges ou une feuille de menthe fraîche.', 'Réserver au moins 6 h au frais avant de servir.'], ['Mixeur', 'Poêle', 'Passoire', 'Casserole', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fruits rouges', 'recette', 'cuisine', 'recettes', 'boisson', 'Mousse de bananes aux fruits rouges', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron', 'mousse fruits', 'blanc d''oeuf', 'cocktail'], 'Dessert', 1ba49b27-9a50-4f46-8710-100aad751106, '2025-09-26T16:35:58.266075', [{'ingredient_id': 'b2928708-46e9-4aca-b6cf-85eb716f24b2', 'quantite': '10'}, {'ingredient_id': '8495b287-a03a-4047-859f-9706f80e34df', 'quantite': '600 g'}, {'ingredient_id': 'f67ec47a-7d0e-4e17-86ed-8ba6598342da', 'quantite': '6 cuillères'}, {'ingredient_id': '7c87409d-a181-4283-8a70-e6e1c4eedc4f', 'quantite': '2'}, {'ingredient_id': '94fcab8b-d11d-4dae-ab75-c68b77fb5e82', 'quantite': '2'}, {'ingredient_id': 'df921b20-bfe7-40d6-b21e-533430908f45', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (80008, 'verres de banane et kiwi façon crumble', 'banane, kiwi, gâteaux', '15 min', ['Emietter les gâteaux, écraser la banane, et couper les kiwis en demi-rondelles.', 'Disposer des miettes dans le fond de chaque verre, puis verser la compote de banane. ', 'Recouvrir d''une couche de gâteaux, puis disposer les rondelles de kiwis, et terminer par des miettes de gâteaux.', 'Décorer d''une rondelle de banane et/ou de kiwi. ', 'Servir frais.'], ['Économe', 'Spatule', 'Passoire', 'Poêle', 'Râpe'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'verres de banane et kiwi façon crumble', 'confiserie', 'crumble banane', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'gâteaux', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:36:01.912226', [{'ingredient_id': 'c9766b55-4028-44d0-bd33-254f10856458', 'quantite': '1'}, {'ingredient_id': '91cbb2c9-8f1c-46de-810c-4055c5d2dd46', 'quantite': '2'}, {'ingredient_id': 'a9bdf759-3860-494d-923d-cf88ed428c17', 'quantite': '10'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73672, 'Smoothie aux fruits et petit gervais', 'pomme, banane, fraises, fraises', '10 min', ['Passer la ou les pomme(s) à la centrifugeuse.', 'Mettre le jus de pomme, le petit gervais au fraise surgelé, la banane et les fraises dans le mixeur.', 'Mixer le tout et déguster immédiatement.'], ['Ouvre-boîte', 'Économe', 'Planche à découper', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'Smoothie aux fruits et petit gervais', 'dessert', 'plat de résistance', 'pomme', 'smoothies', 'cocktail'], 'Boisson', d656913a-9242-45df-a9c9-bceb63f394b5, '2025-09-26T16:36:06.472974', [{'ingredient_id': '412bcc49-7ce7-4829-9eaf-545c67c24820', 'quantite': '2'}, {'ingredient_id': '2de498b9-79a3-4731-b441-bed7475d2698', 'quantite': '1'}, {'ingredient_id': 'c88ceb23-c83a-48c3-a9f9-cfa0b20eab97', 'quantite': '5'}, {'ingredient_id': '3b1c26b8-fa23-4c30-b374-a54f5ce39b06', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530458, 'Banane au jus d''orange et cannelle', 'banane, orange, cannelle', '5 min', ['Couper la banane en rondelles dans une assiette creuse, puis l''écraser avec une fourchette.', 'Presser la moitié de l''orange et verser le jus dans l''assiette.', 'Banane au jus d''orange et cannelle.'], ['Passoire', 'Balance de cuisine', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Banane au jus d''orange et cannelle', 'recette', 'compote', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'orange', 'cannelle', 'cocktail'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T16:36:11.392687', [{'ingredient_id': 'ce069c6d-fb63-47ed-813f-b49aff3a4302', 'quantite': '1'}, {'ingredient_id': 'bd59c8bb-0294-4c0d-9e07-520a1626dded', 'quantite': '1'}, {'ingredient_id': '3cdf9d20-9de9-4027-ba7d-480124575784', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (231991, 'salade de fruits d''automne au rhum', 'ananas, banane, pomme, rhum, citron, cannelle, sucre vanillé, miel', '15 min', ['Eplucher et couper en dés l''ananas.', 'Couper les fruits en morceau et les mettre dans une coupe.', 'Préparer le jus avec le citron, le miel, la cannelle, le sucre et le rhum. ', 'Verser le jus dans les coupes de fruit, mélanger et voilà c''est prêt et délicieux!'], ['Spatule', 'Batteur électrique', 'Passoire', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'salade de fruits d''automne au rhum', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'citron', 'ananas', 'cannelle', 'cocktail'], 'Dessert', edc61f4b-4048-41d5-81fb-467d367804e4, '2025-09-26T16:36:16.119099', [{'ingredient_id': '384cb956-f4ac-4b8c-b3e4-090dcdf05029', 'quantite': '1'}, {'ingredient_id': '51ef2a94-cc04-4b7e-9580-097cc0163fb7', 'quantite': '2'}, {'ingredient_id': '5ac6ea86-f3c1-4d2e-93eb-fee04139eb3b', 'quantite': '3'}, {'ingredient_id': 'd9fca7b2-7e4d-4f00-95d3-fd74dbea4239', 'quantite': '2 cuillères'}, {'ingredient_id': 'c7154826-b549-485b-b8fd-019827756c17', 'quantite': '1'}, {'ingredient_id': '1086b3c5-26ac-4c5b-87ae-d79056ecd7a7', 'quantite': '2 cuillères'}, {'ingredient_id': '4ad422b5-1560-4084-a55a-3f7d91a5da01', 'quantite': '1'}, {'ingredient_id': '50c9b5ad-e60f-432e-a2ed-2ac3b14103d2', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (229136, 'Poêlée mexicaine aux oeufs', 'oeuf, poivron, oignon rouge, ail, maïs, banane plantain, tomates pelées, fromage râpé, huile d''olive, sel', '15 min', ['Faire bouillir une casserole d''eau salée. Couper le poivron en 4 larges rondelles de 3cm bien droites. ', 'Epépiner et les mettre 1 min à blanchir dans l''eau bouillante avant de les égoutter.', 'Emincer l''oignon, l''ail et le reste du poivron. Mettre 2 cuillères à soupe d''huile dans une poêle pour y faire revenir à feu fort l''oignon et l''ail d''abord,  puis à feu moyen le reste du poivron émincé et la banane plantain coupée en rondelles de 1cm maxi.', 'Quand les oignons sont tendres, ajouter le maïs et mettre le contenu de la poêle sur une moitié, et sur l''autre moitié déposer les rondelles de poivron blanchies. ', 'Retourner une fois les rondelles de poivron et y déposer délicatement un oeuf dans chacune, ajouter 1 cuillère à soupe d''huile si besoin dans le fond de la poêle. Saler selon votre goût. A feu doux, continuer de cuire la partie émincée en retournant régulièrement les bananes. Découper les tomates entières. Les y ajouter aux légumes. Quand les blancs des oeufs sont quasi cuits déposer dessus une cuillère à café de fromage râpé.'], ['Tire-bouchon', 'Spatule', 'Presse-agrumes', 'Planche à découper'], ['', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'tomates pelées', 'facile', 'bon marché', 'ail', 'oeuf', 'plat', 'recette', 'cuisine', 'oignon rouge', 'recettes', 'boisson', 'huile d''olive', 'poivron', 'dessert', 'plat de résistance', 'banane plantain', 'maïs', 'cocktail', 'fromage râpé', 'Poêlée mexicaine aux oeufs'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:36:21.094155', [{'ingredient_id': '7761e1bc-8165-4340-9fc8-c89857fc6660', 'quantite': '3'}, {'ingredient_id': '4eb8d21f-8c54-4161-bb7f-ff484ed6417d', 'quantite': '1'}, {'ingredient_id': 'd2f2eb3e-e00e-40b4-896a-2121f5213670', 'quantite': '1'}, {'ingredient_id': 'cf00f960-4cd6-4fa4-8951-4db7466547ac', 'quantite': '1'}, {'ingredient_id': '9d82383f-fece-4fa5-a939-e88c08a86406', 'quantite': '300 g'}, {'ingredient_id': '41943c5e-ff50-416d-98bc-943ae91a98c4', 'quantite': '1'}, {'ingredient_id': 'bbc05f38-5b76-48c2-823a-e8a97c898cc9', 'quantite': '200 g'}, {'ingredient_id': 'dac4fa5f-14eb-433f-ad97-70114283594a', 'quantite': '2 cuillères'}, {'ingredient_id': '793582c9-cd96-4ccd-9f33-dc1455fb4f36', 'quantite': ''}, {'ingredient_id': '64bb6660-8855-4101-acd1-f98dc53e1f81', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (347289, 'Cocktail banane paradis', 'Liqueur, Liqueur, vodka, jus de banane', '5 min', ['Si possible placer les bouteilles au frais au préalable, ou au moins le jus de banane.', 'Mélanger l''ensemble des ingrédients, au verre ou dans une bouteille propre et vide si vous préparez une grande quantité : multipliez par 5 pour obtenir 1 litre de cocktail.'], ['Passoire', 'Moule à tarte', 'Planche à découper'], ['', 'vodka', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Cocktail banane paradis', 'rapide', 'plat', 'jus de banane', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'Liqueur', 'cocktail'], 'Boisson', db1e8309-fc83-4959-8ba2-2522dbe00b64, '2025-09-26T16:36:27.432624', [{'ingredient_id': '5bd8d8c6-aef1-4d4e-b5ca-1f9fa4fa01e5', 'quantite': '4 cl'}, {'ingredient_id': 'fbbafa37-0891-4d09-9f81-1f5a8894cc59', 'quantite': '3 cl'}, {'ingredient_id': '9184d284-4fb2-45d0-ae07-43034d76107f', 'quantite': '1.5 cl'}, {'ingredient_id': 'ba3c9684-7c33-4064-847a-29ba706c1e2f', 'quantite': '9.5 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (53909, 'Gâteau pralinés, banane et crème passion', 'praliné, margarine, banane, sucre, jus de fruit de la passion, farine, maïzena, oeuf', '15 min', ['Préchauffer le four à 180°C (Th 6). ', 'Battre les jaunes avec le sucre et 10 cl de jus en mousse. ', 'Faire fondre la margarine avec les pralinés à feu doux, les ajouter au mélange précédent. ', 'Ajouter la farine, la maïzena et les blancs montés en neige très ferme. ', 'Couper la banane en rondelles et les disposer au fond d''un moule à tarte beurré; verser la pâte dessus et enfourner pendant 45 min.', 'A la sortie du four, entailler le gâteau avec la pointe d''un couteau un peu partout et verser les 10 cl de jus restants sur toute la surface. ', 'Laisser le gâteau refroidir et s''imbiber du jus. Servir avec le "passion fruit curd" (cf recette).'], ['Verre doseur', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'maïzena', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'margarine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'banane et crème passion', 'jus de fruit de la passion', 'sucre', 'cocktail', 'praliné', 'Gâteau pralinés'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:36:32.202838', [{'ingredient_id': 'c5b60d49-4ff3-4532-b430-53f44277b335', 'quantite': '100 g'}, {'ingredient_id': '51a86cf9-781a-45c9-bf03-4c412d5bbfbf', 'quantite': '80 g'}, {'ingredient_id': '085b20c4-509e-4a64-8d5a-88edc72f8102', 'quantite': '1'}, {'ingredient_id': 'b83c8d4e-b6d1-47b7-b3a6-2641cfbf4e71', 'quantite': '1 cuillères'}, {'ingredient_id': '88396fc2-e6df-4361-8004-bcb041d2b7c9', 'quantite': '2 cl'}, {'ingredient_id': 'f3c34347-c14c-4391-ab8e-b557f22482cd', 'quantite': '2 cuillères'}, {'ingredient_id': '6de6664a-6417-4eab-8322-c84cb70509f5', 'quantite': '1 cuillères'}, {'ingredient_id': 'cc74cac0-9cd9-43ad-b036-739625db6c72', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55469, 'Coeur de glaçe flambé', 'chocolat noir, glace vanille, crème fraîche, banane, pomme, beurre, rhum, sucre semoule', '30 min', ['Prévoir un moule moyen en forme de coeur ou 2 petits, pour des portions individuelles, film alimentaire.', 'Placer un morceau de film alimentaire dans le moule en coeur et étaler (le + vite possible) une couche de glace vanille d''environ 1,5 cm d''épaisseur, remettre au congélateur 3h minimum, quand la glace est bien durcie, démouler le coeur en le retournant sur une assiette et soulever délicatement le film et enfin réserver au congélateur...', 'Faire fondre le chocolat au bain marie, ajouter 1 cuillère à soupe de crème, un petit morceau de beurre et procéder de la même façon que la glaçe pour façonner le coeur, laisser bien prendre au frigo avant de démouler, réserver...', 'Couper la pomme et la banane en morceaux, faire fondre légèrement dans le beurre et le sucre, ensuite flamber et réserver à température ambiante.<p>Battre le reste de crème fraîche.', 'Au moment de servir, déposer le coeur en chocolat sur l''assiette, recouvrir de farce flambée puis du coeur en glace et décorer le tour du coeur (à toute vitesse) de crème fraîche.', 'Bon appétit !!'], ['Verre doseur', 'Économe', 'Tire-bouchon'], ['', 'entrée', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'Coeur de glaçe flambé', 'bon marché', 'rapide', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'chocolat noir', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:36:36.829893', [{'ingredient_id': '680a84ef-47f8-4579-8327-5996c8a326db', 'quantite': '300 g'}, {'ingredient_id': '717c4532-6e42-4f41-a2cc-3c7491a586c7', 'quantite': '30 cl'}, {'ingredient_id': '76e73618-4831-47d2-8bc3-02a584e1422a', 'quantite': '30 cl'}, {'ingredient_id': 'f239732f-9120-4a8a-956b-d0f3a0f3a6d7', 'quantite': '1'}, {'ingredient_id': '5a143bf7-4093-4702-9566-f591fc4b6597', 'quantite': '1'}, {'ingredient_id': '53531370-4829-48b9-850d-02e35fe4592c', 'quantite': '5 g'}, {'ingredient_id': 'bea38b25-1020-424b-a373-b28de78572ac', 'quantite': '2 cuillères'}, {'ingredient_id': 'd9bc1b1e-079f-405b-afaf-6c3291461b68', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (91955, 'Gâteaux choco-banane', 'yaourt, yaourt, sucre, chocolat noir, banane, oeuf, lait, levure', '10 min', ['Tout d''abord, beurré les moules.', 'Puis,dans un saladier, mélanger ensemble les yaourts, la farine, le sucre, les oeufs, le lait et la levure pour obtenir une pâte bien lisse.', 'Ajouter dans cette pâte le chocolat en poudre et mélanger bien.', 'Couper les banane en rondelles et écraser la moitié de celle-ci, puis ajouter-les à la pâte et mélanger.', 'Mettre la préparation en faisant bien attention à répartir les banane dans les moules.', 'Enfourner les moules dans le four thermostat 5 (180°C) pendant 20 min et laisser refroidir environ une demi heure à température ambiante.'], ['Mixeur', 'Fouet', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'Gâteaux choco-banane', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre', 'lait', 'cocktail'], 'Dessert', 4a01a6a1-41fc-4370-acc6-e71b9c7e4a31, '2025-09-26T16:36:40.530260', [{'ingredient_id': 'da79db70-4318-4152-89f3-5538e863989d', 'quantite': '2'}, {'ingredient_id': '41b44989-c8cc-498a-a1bc-17fafb062553', 'quantite': '3'}, {'ingredient_id': '8ef396ef-eb14-44a0-89e4-8ea6d11f36f4', 'quantite': '2'}, {'ingredient_id': '834eaf2b-b42b-4ae9-b1bc-dda2c7bafb02', 'quantite': '1.5'}, {'ingredient_id': '00ef2810-b04f-4312-99b0-0a1f538135df', 'quantite': '1'}, {'ingredient_id': 'b55078fb-85e9-4cc7-ae9f-83d69ecef1c8', 'quantite': '4'}, {'ingredient_id': '22fdc7c8-47f1-4785-b8d0-5a061280d199', 'quantite': '2'}, {'ingredient_id': 'bc93f146-6df3-4b17-aa04-02b49d741ae3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (305587, 'Confiture oranges, pommes, bananes et grand marnier', 'orange, pomme, banane, sucre, eau, grand-marnier', '150 min', ['Peler tous les fruits et les couper en petits morceaux.', 'Mettre les fruits dans un saladier avec la moitié du sucre et les laisser macérer pendant 2 heures.', 'Au bout d''une heure 30 minutes, en parallèle, faire le sirop avec l''eau et le sucre sur feu doux.(thermostat 4).', 'Quand le sirop est fait, ajouter les fruits macérés avec leur jus et mettre sur un feu un peu plus fort.(thermostat 5)', 'Au 1er bouillon, ajouter les 3 cuillères à soupe de Grand Marnier et laisser cuire durant 1h30 au moins.', 'Remuer de temps en temps.', 'La confiture est prête quand le sucre se cristallise sur l''assiette ( perle de sucre )', 'Puis mettre en bocaux (attention aux brûlures!), mettre les couvercles et laisser refroidir.'], ['Planche à découper', 'Rouleau à pâtisserie', 'Spatule', 'Passoire', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'bananes et grand marnier', 'pomme', 'orange', 'grand-marnier', 'pommes', 'sucre', 'Confiture oranges', 'cocktail', 'confiture d''orange'], 'Confiserie', 0d5b6c69-c05b-4bf0-9f99-85809ca437d5, '2025-09-26T16:36:44.183086', [{'ingredient_id': '772517f9-6d7e-481b-8f64-d8ba800d0e58', 'quantite': '500 g'}, {'ingredient_id': '704cab82-437f-4eba-ab85-0fed2086c972', 'quantite': '300 g'}, {'ingredient_id': 'a267c086-edaf-4532-8f68-855b7705ae96', 'quantite': '200 g'}, {'ingredient_id': '729707fb-3f2e-4713-a74e-d44ebe94396a', 'quantite': '800 g'}, {'ingredient_id': 'fb950a47-4851-4442-a9b0-785012524dea', 'quantite': '1 l'}, {'ingredient_id': '467846ef-29f0-401d-a2e4-a0e29b20fbf2', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (535224, 'Cheesecake aux agrumes et spéculoos', 'sirop d''agave, cream cheese, eau de fleur d''oranger, yaourt à la grecque, oeuf, Confiture d''orange, orange, spéculoos, banane', '15 min', ['Réduisez les biscuits spéculoos en miettes et mélangez- les avec les bananes écrasées. Enfoncez le mélange dans un moule à gâteau (assez haut) sur du papier sulfurisé et laissez cuire 10 minutes dans un four préchauffé à 180°C.', 'Pendant ce temps, mélangez le yaourt à la grecque et le cream cheese. Ajoutez les oeufs, le sirop d''agave et l''eau de fleur d''oranger. Mélangez et ajoutez la préparation sur le dessus de votre pâte. Faites- cuire 45 à 50 minutes à 150°C. Laissez refroidir 30 minutes dans le four, la porte du four ouverte puis 30 minutes à l''air libre (le cheesecake aime refroidir progressivement) avant de le laisser reposer au frais quelques heures.', 'Décorez votre cheesecake : ajoutez la confiture d''orange sur le dessus, puis découpez en rondelle les agrumes de votre choix (orange, citron, pamplemousse) et ajoutez-les sur le dessus. Découpez et servez! '], ['Rouleau à pâtisserie', 'Presse-agrumes', 'Moule à tarte', 'Batteur électrique', 'Louche'], ['Confiture d''orange', 'yaourt à la grecque', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'sirop d''agave', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'cream cheese', 'Cheesecake aux agrumes et spéculoos', 'dessert', 'plat de résistance', 'orange', 'eau de fleur d''oranger', 'cocktail'], 'Dessert', e90d7a21-ebe1-4fbf-89d7-f6457786ca9c, '2025-09-26T16:36:48.800961', [{'ingredient_id': 'fecde694-f6ae-48c8-95cf-ed38cef67641', 'quantite': '40 g'}, {'ingredient_id': 'd376d890-6fbe-48aa-8edc-e9896eb5ac0b', 'quantite': '300 g'}, {'ingredient_id': 'c5b0965d-4c6d-41c2-a5cd-a186eba80501', 'quantite': '1 cuillères'}, {'ingredient_id': '5f3717e8-c838-4cfb-9890-c0619c4fe9d7', 'quantite': '400 g'}, {'ingredient_id': '03d8f300-1c8c-4454-bf99-3b745ea4e505', 'quantite': '2'}, {'ingredient_id': '437bc3b4-87e8-423a-a332-f9a7a683d7db', 'quantite': '50 g'}, {'ingredient_id': 'e2edd423-fa91-4236-b426-6fe7f667aa22', 'quantite': '1'}, {'ingredient_id': '09d3d1f2-d712-4413-a2db-a079ddefcd04', 'quantite': '150 g'}, {'ingredient_id': 'd455c261-ff81-4e80-9949-ab1b71014015', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (51938, 'Compote à la banane, à l''ananas et au kiwi', 'banane, ananas, kiwi, eau', '15 min', ['Epluchez bien l''ananas, et découpez-le en dés.', 'Coupez également les bananes et le kiwi (sans les peaux) en dés.', 'Faites cuire à feu doux (thermostat 2) avec un peu d''eau; remuez régulièrement. ', 'Lorsque les fruits sont très mous, mixez-les ou écrasez-les.', 'Laissez refroidir et dégustez.'], ['Casserole', 'Économe', 'Presse-agrumes', 'Tire-bouchon'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'cocktail', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'ananas', 'compote de banane', 'Compote à la banane', 'à l''ananas et au kiwi'], 'Dessert', 0850024d-24bc-4542-b815-b194bfbe4b80, '2025-09-26T16:36:52.353618', [{'ingredient_id': '146ef1c6-e646-4b15-a1bf-1ef2f9fb659d', 'quantite': '2'}, {'ingredient_id': '43d077c4-0db1-4c58-91dd-648adf12e184', 'quantite': ''}, {'ingredient_id': 'a6e47f50-6a35-4b58-906e-195dd158927c', 'quantite': '1'}, {'ingredient_id': '12e91c65-1e85-446e-a8cd-9e403aaf64f1', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (86816, 'Gâteau banane express simplissime', 'banane, oeuf, sucre, sucre vanillé, levure chimique, farine', '10 min', ['Mixer les bananes avec les oeufs et le sucre juqu''à obtenir une mousse.', 'Rajouter petit à petit les autres ingrédients.', 'Transférer la préparation dans un moule à cake et enfourner 35 minutes à 180°C (thermostat 6).'], ['Mixeur', 'Planche à découper', 'Couteau de chef', 'Fouet', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'Gâteau banane express simplissime', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'gâteau à la banane', 'sucre', 'cocktail'], 'Dessert', 1102044b-6cfc-43f0-adc7-4ea5ac2db769, '2025-09-26T16:36:56.985807', [{'ingredient_id': '5ce6efdc-00f3-4d1f-a741-86f3bb947557', 'quantite': '3'}, {'ingredient_id': '81f74f96-123a-4634-ad0d-077ecfc71dd5', 'quantite': '2'}, {'ingredient_id': '72d39362-433d-4d68-8f3f-9e1a09c378bc', 'quantite': '100 g'}, {'ingredient_id': 'c022da45-2069-4e95-920a-44a65b3d00d8', 'quantite': '1'}, {'ingredient_id': 'fef0ef10-87bb-4c69-a8fe-66de907a35c3', 'quantite': '1'}, {'ingredient_id': '738d1222-7f1b-4fbd-8d75-e6eec01377f0', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30034, 'Tarte banane et nutella', 'banane, pâte brisée, Nutella, oeuf, sucre vanillé, sucre, lait', '10 min', ['Etaler le nutella sur la pâte brisée et placer ensuite la pâte dans le moule (si vous préférez, vous pouvez faire l''inverse en plaçant d''abord la pâte dans le moule, puis en éalant le nutella.', 'Couper les bananes en rondelles et les disposer sur le nutella.', 'Battre les oeufs en omelette, y ajouter le sucre, le sucre vanillé et le lait et verser le tout sur les bananes.', 'Enfourner 30 mn à thermostat 6 (180°C).'], ['Poêle', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'Nutella', 'dessert', 'plat de résistance', 'sucre vanillé', 'sucre', 'lait', 'Tarte banane et nutella', 'cocktail'], 'Dessert', 2ca132a2-8e9e-4dfa-b145-233d3385dffe, '2025-09-26T16:37:01.578528', [{'ingredient_id': '605e8393-1d38-445f-a94b-5abbed56971f', 'quantite': '4'}, {'ingredient_id': 'e54b9112-50dc-466d-a0a8-1aea4ad6de79', 'quantite': '1'}, {'ingredient_id': 'a9aeca2c-ef2d-442f-b6ed-afa818ad2384', 'quantite': ''}, {'ingredient_id': '5eeb3347-8e1f-40ff-b7c7-b1bd1fdb2fdc', 'quantite': '3'}, {'ingredient_id': 'b2712f56-f5a1-4b59-a27f-1e4865a40d94', 'quantite': '2'}, {'ingredient_id': 'a686ab26-9710-4f5a-929a-bd12cd815750', 'quantite': '100 g'}, {'ingredient_id': 'fa68db3c-b4aa-4d9a-8ff7-287afa31d8ea', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (219150, 'Papillotes de banane au gingembre', 'banane, citron vert, gingembre, sucre en poudre, eau, cannelle', '25 min', ['Éplucher le gingembre et le couper en fins bâtonnets. Dans une casserole, faire bouillir l’eau avec le sucre et y ajouter le gingembre pendant 15 min.', 'Préchauffer le four à 210°C (thermostat 7).', 'Couper les bananes en rondelles épaisses, arroser du jus d’un citron.', 'Couper le 2ème citron en fines tranches.', 'Couper la cannelle en 2 dans le sens de la longueur. ', 'Découper 8 feuilles de papier sulfurisé. ', 'Dans chaque papillote, répartir les tranches de citron et les bananes. Arroser du sirop de gingembre. Ajouter le gingembre égoutté et la cannelle.', 'Enfourner 10 min et manger tiède.'], ['Râpe', 'Batteur électrique', 'Planche à découper'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron vert', 'Papillotes de banane au gingembre', 'cannelle', 'cocktail'], 'Dessert', a95a03a6-de69-4672-9c8e-bc4e6556c86e, '2025-09-26T16:37:05.266215', [{'ingredient_id': '6590a9b8-b4b2-45a0-8070-b96d117a43f8', 'quantite': '4'}, {'ingredient_id': '1441f61b-6f20-4bc3-98b8-103d1bc102b6', 'quantite': '2'}, {'ingredient_id': '98815ea5-5784-4af1-abb6-628de3a3aa00', 'quantite': '50 g'}, {'ingredient_id': '47d56173-35d0-4d1f-9c1f-49b669bd3651', 'quantite': '100 g'}, {'ingredient_id': 'edda318c-14cd-4d10-ad1a-16f621eded2b', 'quantite': '10 cl'}, {'ingredient_id': '36d9d3ed-9917-4316-b46f-6ecbd792382f', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (331840, 'Gâteau choco bananes noix de RobinCook', 'chocolat, sucre, oeuf, farine, noix, banane, crème liquide, sucre glace', '30 min', ['Préchauffer le four à 200°C (thermostat 6-7).', 'Faire fondre 200 g de chocolat.', 'Ajouter le sucre, les oeufs, la farine et mélanger.', 'Couper la banane en tranches et disposer les tranches dans le moule sur tout le tour.', 'Verser l''appareil dessus (j''ai pris un moule coeur et 3 petits ramequins)', 'Mettre au four pour 18 minutes de cuisson.', 'Quand le gâteau est un peu refroidi, glacer le tour et coller des cerneaux de noix. Pour faire le glaçage : faire fondre les 100g de chocolat restants au bain marie. Glacer aussi le dessus sans cacher les rondelles de bananes qui apparaissent. ', 'Enfin, au moment de déguster, monter la crème en chantilly avec le sucre glace (j''ajoute quelques gouttes de colorant rouge) et la verser dans une poche à douille.', 'Décorer le gâteau avec la chantilly et déguster !'], ['Verre doseur', 'Balance de cuisine', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'gâteau aux noix', 'testées', 'chocolat', 'facile', 'bon marché', 'Gâteau choco bananes noix de RobinCook', 'oeuf', 'plat', 'recette', 'cuisine', 'noix', 'recettes', 'boisson', 'crème liquide', 'farine', 'dessert', 'plat de résistance', 'sucre glace', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:37:10.063141', [{'ingredient_id': 'b2a7844c-35fa-4f49-b759-ff7dc300b01c', 'quantite': '300 g'}, {'ingredient_id': '76510aa6-9c00-42a6-80a6-d6ae322b62e0', 'quantite': '160 g'}, {'ingredient_id': '384c04c5-e209-4ba1-885c-bd96d15e8165', 'quantite': '6'}, {'ingredient_id': '41af04d8-70f4-482a-bd8b-384558c0b6ee', 'quantite': '2.5 cuillères'}, {'ingredient_id': '270811f0-3973-4747-94e9-e8aca9eaee73', 'quantite': ''}, {'ingredient_id': '01deea7f-22ca-4be2-b81e-0c326a54f8e1', 'quantite': '1'}, {'ingredient_id': 'f0d04139-d138-4b6c-a336-08378db05680', 'quantite': '20 cl'}, {'ingredient_id': '22833672-f699-4a29-ab1f-9b5e850e0466', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68203, 'Mousse framboise banane', 'banane, framboises, lait, glace vanille', '10 min', ['Mettre tout simplement tous les ingrédients dans un bol.', 'Mixer jusqu''à obtention d''une pâte homogène.', 'Mettre au frigo au moins 4 heures.', 'Décorer avec des zestes d''orange.', 'Déguster.'], ['Ouvre-boîte', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'framboises', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'Mousse framboise banane', 'dessert', 'plat de résistance', 'mousse fruits', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:37:13.622627', [{'ingredient_id': 'f1507596-bc1e-40cc-b9f1-1e63716ed469', 'quantite': '2'}, {'ingredient_id': 'a4430056-070e-4c3b-bd76-9369e89664b4', 'quantite': '200 g'}, {'ingredient_id': '06eb4168-1ba6-4ddb-b442-1a10b4ef49cf', 'quantite': '40 cl'}, {'ingredient_id': '67a2c196-aafa-412c-9b6d-d2676f145d59', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24791, 'Bananes à la vanille flambées au rhum', 'banane, sucre, beurre, vanille, eau, rhum, sucre', '15 min', ['Éplucher les bananes et les couper dans le sens de la longueur sans les séparer. Mélanger le sucre, le beurre et la pulpe de vanille grattée, et en farcir les bananes fendues.', 'Beurrer un plat et y placer les bananes. Ajouter l''eau et recouvrir de sucre.', 'Mettre le plat au four à 150°C (thermostat 5) pendant 30 min. ', 'Chauffer le rhum dans une casserole et le verser dans le plat. Flamber et servir.'], ['Louche', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'Bananes à la vanille flambées au rhum', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', e5593688-f6aa-4f2a-86fd-9a7ff79acfe6, '2025-09-26T16:37:17.172845', [{'ingredient_id': '58b1f379-c3eb-4f8c-b950-a8a069a01951', 'quantite': '8'}, {'ingredient_id': '67562d55-42ae-4cb3-8ee0-0f17a8031ed5', 'quantite': '50 g'}, {'ingredient_id': '4e984a9c-bc1b-41bf-9033-4b293c400ac0', 'quantite': '50 g'}, {'ingredient_id': 'ea3c938f-ba63-478a-9833-89be5585b0af', 'quantite': '1'}, {'ingredient_id': 'a5039ae8-721f-4c26-9a7c-92500bccdc45', 'quantite': '2 cuillères'}, {'ingredient_id': '0e3d839b-b5c1-4ec7-bdc2-cb1c4184163f', 'quantite': '4 cuillères'}, {'ingredient_id': '36630d99-bfe9-49ea-b8e1-861a051971d4', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (87322, 'Crumble pomme banane kiwi', 'pomme, banane, kiwi, beurre, sucre, farine, sucre vanillé, amandes en poudre, jus de citron', '15 min', ['Faites chauffer votre four à 220°C (thermostat 7-8).', 'Dans un récipient, mélangez la farine, le sucre, la poudre d''amande et 100 g de beurre ramolli, jusqu''à obtention d''une pâte sablée. ', 'Faites une boule et réservez.', 'Pelez et coupez en petits morceaux les fruits et répartissez-les dans un moule à gâteau.', 'Ajoutez les sachets de sucre vanillé, jus de citron et quelques petits morceaux de beurre (30 g environ).', 'Mélangez le tout.', 'Émiettez la pâte sablée sur les fruits.', 'Enfournez et laissez cuire 30 min.'], ['Couteau de chef', 'Passoire'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'très facile', 'bon marché', 'amandes en poudre', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'Crumble pomme banane kiwi', 'plat de résistance', 'sucre vanillé', 'jus de citron', 'pomme', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:37:20.780082', [{'ingredient_id': '0a504b91-c4a5-4996-b077-ad67611de573', 'quantite': '3'}, {'ingredient_id': 'edba1b67-3618-48c3-a00f-818b65a9e8fd', 'quantite': '2'}, {'ingredient_id': 'caef0b9e-29f7-45ee-b41d-ae625424eed6', 'quantite': '4'}, {'ingredient_id': '1bcd2251-fa0e-433b-9cb2-1a697366f0fd', 'quantite': '130 g'}, {'ingredient_id': '1cd545c7-652b-46d7-82b0-02ed7bbde975', 'quantite': '100 g'}, {'ingredient_id': 'd24c0bf8-1c4f-4151-80ab-150b1af34949', 'quantite': '100 g'}, {'ingredient_id': '5aed2f18-56cb-42ce-bc72-959139a5023a', 'quantite': '2'}, {'ingredient_id': '42dd09e0-9ad2-4acd-9f8e-01c610fc5af2', 'quantite': '3 cuillères'}, {'ingredient_id': '87d84201-656a-49a8-9c5b-d59027d09026', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (44044, 'Poulet ananas et bananes', 'poulet, chipolata, lard fumé, ananas, banane', '15 min', ['Faire rôtir le poulet normalement. ', 'Faire griller les chipolatas.', 'Faire dorer les tranches de lard à la poêle.', 'Ajouter du jus de cuisson du poulet dans la poêle, et y faire dorer les tranches d''ananas et les bananes.', 'Faire réduire la sauce.', 'Découper le poulet, et servir accompagné des fruits et de maïs en épi ou de riz blanc.'], ['Planche à découper', 'Rouleau à pâtisserie', 'Batteur électrique'], ['', 'poulet', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'chipolata', 'facile', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Poulet ananas et bananes', 'dessert', 'plat de résistance', 'moyen', 'ananas', 'lard fumé', 'cocktail'], 'Plat principal', 8a32273c-4404-40d9-9f00-0ccf26c37027, '2025-09-26T16:37:24.228725', [{'ingredient_id': '5aa8fb91-cb72-4ae8-8e7b-38c42d85a1aa', 'quantite': '1'}, {'ingredient_id': '4e6da6b1-b628-4cdf-b362-9451e979ca79', 'quantite': '6'}, {'ingredient_id': '9386dff6-3675-41b0-ae60-136c0269a113', 'quantite': '6'}, {'ingredient_id': 'b350965b-fcf7-4403-91a3-f68151fab57d', 'quantite': '6'}, {'ingredient_id': '27e0f0fd-d002-4abe-a54e-28f43d5bdcf7', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46826, 'Crumble pommes - bananes à la noix de coco', 'banane, pomme, citron, beurre, sucre, cannelle, noix de coco rapée, amandes, farine, sucre roux', '30 min', ['Epluchez vos fruits, épépinez les pommes; et coupez le tout en petits morceaux.', 'Pour faire un caramel roux, faites fondre les 25 g de beurre avec le sucre.', 'Ajoutez les morceaux de fruits, et laissez cuire quelques minutes en mélangeant délicatement.', 'Ajoutez une pincée de cannelle, puis versez la préparation dans un plat ou dans des ramequins allant au four.', 'Mélangez la noix de coco, les amandes, la farine, les 50 g de beurre et le sucre roux avec le bout des doigts pour obtenir une pâte sableuse.', 'Déposez cette pâte sableuse sur les fruits, et enfournez pendant 20 à 25 min, à 180°C (th 6), jusqu''à ce que le crumble soit bien doré.'], ['Ouvre-boîte', 'Mixeur', 'Fouet', 'Batteur électrique', 'Couteau de chef'], ['amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'crumble aux pommes', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'Crumble pommes - bananes à la noix de coco', 'noix de coco rapée', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'citron', 'cannelle', 'sucre', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:37:27.791860', [{'ingredient_id': '20028338-ac73-4174-8560-16a15ffcb0de', 'quantite': '2'}, {'ingredient_id': '48227b0a-503f-4fef-a662-20892bb4858e', 'quantite': '2'}, {'ingredient_id': '5774a473-0ca9-47a6-92db-5123b0dc2e4a', 'quantite': ''}, {'ingredient_id': '5186501e-4b11-4a5d-814b-33f91b100101', 'quantite': '25 g'}, {'ingredient_id': '68831c4c-1f55-4095-b74f-bb51a233760e', 'quantite': '40 g'}, {'ingredient_id': '3a31b394-a145-4abe-a8cd-b3319b5e904e', 'quantite': '1'}, {'ingredient_id': 'fa9566a0-3a42-4adb-b47d-acb481307e46', 'quantite': '50 g'}, {'ingredient_id': '20048645-f0a2-410c-8e2a-5042a899be30', 'quantite': '50 g'}, {'ingredient_id': '557ad826-d637-4680-86ad-e095547cc670', 'quantite': '50 g'}, {'ingredient_id': 'bc7dc32c-fa4e-4909-a10d-dc3735419e05', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46037, 'Petits moelleux choco-coco-bananes', 'oeuf, sucre semoule, farine, levure, sucre vanillé, beurre demi-sel, chocolat noir, noix de coco, banane, rhum', '20 min', ['Préchauffer le four à 180°C (th 6).', 'Faire fondre un petit morceau de beurre dans une poêle, y déposer les rondelles de bananes saupoudrées de sucre, et les faire revenir 5 minutes.', 'Dans un saladier, fouetter les oeufs et les sucres jusqu''à ce que le mélange blanchisse, ajouter la farine et la levure.', 'Faire fondre le chocolat et le beurre quelques minutes au micro-ondes, et l''incorporer au mélange. ', 'Ajouter les bananes caramélisées, la noix de coco et le rhum; mélanger.', 'Répartir la préparation dans 4 ou 5 petits ramequins allant au four, et les faire cuire 10 min environ, le coeur doit rester fondant! Servir tiède...'], ['Balance de cuisine', 'Mixeur', 'Économe', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'Petits moelleux choco-coco-bananes', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'sucre semoule', 'beurre demi-sel', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre vanillé', 'noix de coco', 'cocktail'], 'Dessert', 2195f859-e5da-44f8-8536-1e0e605819fd, '2025-09-26T16:37:31.289419', [{'ingredient_id': '5c841a54-8f24-4cb7-b2a1-b01420786cd6', 'quantite': '4'}, {'ingredient_id': 'e39463f7-88ad-452f-ab7a-0c66297c58e2', 'quantite': '100 g'}, {'ingredient_id': 'c5214498-5c0f-49b1-b24a-ee12fc13bd36', 'quantite': '100 g'}, {'ingredient_id': '4643dc4a-729a-4895-9535-bf95671a25a0', 'quantite': ''}, {'ingredient_id': 'dfdbeb2e-7342-4afe-a73f-17a388ef10c9', 'quantite': '1'}, {'ingredient_id': '848906eb-968a-43e9-bfed-f087e344e017', 'quantite': '100 g'}, {'ingredient_id': '13b4e8ca-407c-4a14-bcf8-e94384821dc6', 'quantite': '150 g'}, {'ingredient_id': '8d377ade-a116-4dfc-a3e9-0bf08c6c0a68', 'quantite': '50 g'}, {'ingredient_id': 'f9337b85-0d78-4b55-ace7-0efd72935d53', 'quantite': '2'}, {'ingredient_id': '2ef21e90-793f-4811-b016-011b08bbcec2', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (304996, 'Mugcake', 'beurre, chocolat, oeuf, lait, sucre, farine, caramel au beurre salé, noix, amandes, noisettes, banane', '8 min', ['Dans un mug, coupez le chocolat en morceaux et ajoutez le beurre en morceaux. Passez le tout 30sec au micro-ondes (1mn à 1000 watts pour moi). Mélangez avec une fourchette, afin de finir de faire fondre le chocolat et lisser le mélange.', 'Ajoutez le sucre, mélangez puis ajoutez l’œuf, le lait et enfin la farine en mélangeant bien après chaque ajout. Vous pouvez ajouter une garniture si vous le souhaitez: caramel au beurre salé, morceaux de bounty, noix, amandes, noisettes, rondelles de banane…', 'Cuisez le gâteau dans son mug pendant 45sec à 1mn au micro-ondes à puissance max 1000 watts selon la puissance de votre four et la consistance voulue (1mn30 pour moi, c’était bien cuit mais encore coulant sur les côtés).'], ['Fouet', 'Verre doseur', 'Couteau de chef', 'Planche à découper'], ['amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'mugcake', 'caramel au beurre salé', 'recette', 'noisettes', 'cuisine', 'noix', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'Mugcake', 'beurre', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:37:38.232538', [{'ingredient_id': 'c576c70d-c38b-4b43-940d-ef71acd2dbb5', 'quantite': '35 g'}, {'ingredient_id': '77ca7690-e768-4b3f-b8c6-01e02b182b80', 'quantite': '40 g'}, {'ingredient_id': '49597d8d-ab1a-4a7f-9317-370f6f44d832', 'quantite': '1'}, {'ingredient_id': 'a5ed1f96-6e00-40b6-82c5-988dd3a01b38', 'quantite': '2 cl'}, {'ingredient_id': 'd436dd63-c5c4-4ae1-be9a-4f84203ba556', 'quantite': '20 g'}, {'ingredient_id': '58070649-bd08-4dc9-908f-4cfcd221125f', 'quantite': '20 g'}, {'ingredient_id': '87736f88-dd20-4f28-a342-a43199e62347', 'quantite': ''}, {'ingredient_id': 'b4cfbea1-ed23-45f1-a772-9f850b0710d0', 'quantite': ''}, {'ingredient_id': 'f3033dbe-9c1e-4651-9491-c2137bcccaa3', 'quantite': ''}, {'ingredient_id': 'b0c6970f-7db4-44c5-aef6-a7f432979a7a', 'quantite': ''}, {'ingredient_id': '878f361e-9f20-437e-b3fe-b8687afb8c71', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (80348, 'Aumônière Banane-Choco', 'brick, banane, chocolat, poudre de noisette', '10 min', ['Mélangez dans un saladier tout les ingrédients.', 'Remplissez de garniture la feuille de brick.', 'Fermez-la à l''aide d''un petit bâton de bois ou avec de la ficelle de cuisine.', 'Mettez au four 8 min à 180°, thermostat 6.'], ['Économe', 'Verre doseur', 'Fouet', 'Tire-bouchon', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Aumônière Banane-Choco', 'chocolat', 'très facile', 'bon marché', 'rapide', 'plat', 'poudre de noisette', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:37:41.730625', [{'ingredient_id': '21702e4a-4cdd-4942-9085-3a9b06771fa2', 'quantite': '2'}, {'ingredient_id': '00674290-e549-404d-b812-713f99a8e28c', 'quantite': '2'}, {'ingredient_id': '38a1d8b6-11a7-4b8c-be3d-ba77a56510a8', 'quantite': '70 g'}, {'ingredient_id': '64c87456-6a2e-4cc7-b7d1-f57b71ddc233', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66681, 'Salade de fruits légère et... originale', 'clémentine, pomme, banane, carotte, sucre', '10 min', ['Dans un saladier, éplucher et couper en petits morceaux la banane, les clémentines et la pomme.', 'Râper grossièrement la carotte.', 'Ajouter le sucre. ', 'Bien mélanger et mettre au réfrigérateur au moins une demi-heure avant de manger pour obtenir un peu de sirop au fond.'], ['Moule à tarte', 'Poêle'], ['entrée', 'salade de fruits originale', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'carotte', 'très facile', 'bon marché', 'rapide', 'plat', 'Salade de fruits légère et... originale', 'recette', 'cuisine', 'recettes', 'boisson', 'clémentine', 'dessert', 'plat de résistance', 'pomme', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:37:46.269710', [{'ingredient_id': 'dd4836f1-e08a-45c7-95b2-dd1e082866a8', 'quantite': '2'}, {'ingredient_id': '980c6f9a-2ebd-4b41-94c3-8b9aa25bfb3e', 'quantite': '1'}, {'ingredient_id': 'cbfab521-5f5f-4a8a-adb4-70898d163683', 'quantite': '1'}, {'ingredient_id': '8efad4c6-cb62-4006-9f19-46e0bf9ae39d', 'quantite': '1'}, {'ingredient_id': 'ee63a247-ee11-4362-afbf-98b70d9a5c0f', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (305221, 'Smoothie au kiwi et à la banane', 'kiwi, banane, sucre, sucre vanillé, eau, glaçons', '10 min', ['Mixer simplement le tout et on obtient un smoothie délicieux.'], ['Économe', 'Presse-agrumes', 'Fouet', 'Couteau de chef'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'glaçons', 'sucre', 'smoothies', 'cocktail', 'Smoothie au kiwi et à la banane'], 'Boisson', cc399723-818e-461c-9b9a-dbcaa9aa3241, '2025-09-26T16:37:49.817007', [{'ingredient_id': '8813888f-91c2-47b6-9aa5-6c41b2c7e330', 'quantite': '2'}, {'ingredient_id': '4dad9295-e857-4da7-bce4-4a8ccaf2bb83', 'quantite': '1'}, {'ingredient_id': 'eb0e06a1-722f-4980-a672-8e0e77e45628', 'quantite': '1'}, {'ingredient_id': '0587a9c0-bb0d-42ed-8a45-bcd78de456c9', 'quantite': ''}, {'ingredient_id': '19a63cb8-5cbc-43ec-b115-4d93939c7d4c', 'quantite': '7 cl'}, {'ingredient_id': 'be314d97-2d04-4e04-b071-66566b75b2b1', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (343018, 'Feuilleté au chocolat et bananes', 'pâte feuilletée, chocolat, banane, oeuf', '10 min', ['Étaler la pâte feuilletée.', 'Mettre la plaquette de chocolat au centre de la pâte.', 'Couper la banane en rondelles. Puis mettre sur la plaquette de chocolat.', 'Couper en lamelle les bords de la pâte. Puis renfermer les bandes de la pâte sur la tablette de chocolat en croisant comme des lacets.', 'Battre un oeuf et badigeonner la pâte. Disposer sur une plaque avec du papier cuisson.', 'Cuire dans un four à 200°C (thermostat 6-7) pendant 15 minutes.'], ['Pince de cuisine', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'Feuilleté au chocolat et bananes', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'cocktail'], 'Dessert', 5b9b212d-89a0-46e4-bc40-b2fe11a11a55, '2025-09-26T16:37:53.465655', [{'ingredient_id': 'cca3fa61-4d3b-4056-8b8c-f6cc72abc1f0', 'quantite': '1'}, {'ingredient_id': '12c985a0-078b-42b2-889b-b20b3fa3bd27', 'quantite': '1'}, {'ingredient_id': '950ae86b-a2b1-487d-a8d2-7cc7c2508129', 'quantite': '1'}, {'ingredient_id': '7e22831e-a5cc-4e35-b10f-3033af555887', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (86881, 'Smoothie Kiwi Banane Amélioré', 'kiwi, banane, abricot, citron, yaourt brassé', '2 min', ['Éplucher la banane et les kiwis.', 'Découper en petits morceaux la banane, les kiwis et les abricots.', 'Verser dans le blender le yaourt puis les fruits.', 'Ajouter le jus de citron.', 'Mixer.'], ['Économe', 'Râpe', 'Couteau de chef'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'yaourt brassé', 'confiserie', 'testées', 'abricot', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'smoothies', 'cocktail', 'Smoothie Kiwi Banane Amélioré'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:37:57.057718', [{'ingredient_id': '928511d2-8802-43bb-8b6a-ba4530466914', 'quantite': '2'}, {'ingredient_id': '4bbcc000-9605-4678-988c-5b7888bd2486', 'quantite': '1'}, {'ingredient_id': '7976eb19-d2d7-49a1-995f-4daebeba7866', 'quantite': '4'}, {'ingredient_id': '851fc607-aec6-4004-808a-93546aa7e1ea', 'quantite': ''}, {'ingredient_id': '45e9b90f-3ff7-43ac-b073-212aeff31c37', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (49797, 'Glace extra light à la banane (sans sorbetière)', 'banane, cannelle', '10 min', ['La veille (au minimum 3 h avant), éplucher les bananes et les couper en gros tronçons (environ 3/4 cm). ', 'Emballer les bananes dans du film alimentaire, et mettre au congélateur.', 'Lorsque les fruits sont congelés, les sortir du réfrigérateur; et laisser à température ambiante 10 à 15 min. ', 'Mettre ensuite ces morceaux dans le bol du mixeur et ajouter la cannelle en poudre. ', 'Mixer le tout, jusqu''à ce que le mélange soit onctueux et homogène.', 'Disposer dans des ramequins ou verrines, et éventuellement saupoudrer de chocolat noir râpé.', 'Servir immédiatement la crème glacée (ou remettre un peu au congélateur si l''on souhaite une consistance plus glacée).'], ['Verre doseur', 'Ouvre-boîte'], ['Glace extra light à la banane (sans sorbetière)', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cannelle', 'glace à l''italienne', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:38:00.619194', [{'ingredient_id': 'cafdb504-da5d-432c-912d-4d814b5b8465', 'quantite': '2'}, {'ingredient_id': '9563db9b-f200-4967-80f9-4ff45b83a81f', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40528, 'Tarte tatin mirabelles et bananes', 'pâte feuilletée, banane, mirabelle, caramel, beurre demi-sel', '15 min', ['Tapissez un moule à tarte de caramel liquide. ', 'Coupez les prunes en deux et dénoyautez-les. Posez-les au fond du plat, coeur côté caramel. Recouvrez bien tout le fond!', 'Enlevez la peau des bananes, et coupez-les en rondelles. Disposez-les par dessus les prunes. les fruits doivent former un dôme.', 'Parsemez le dôme de petits copeaux de beurre (pas indispensable mais ça donne du moelleux).', 'Recouvrez avec la pâte feuilletée, en calant bien celle-ci entre les fruits et les côtés du plat (elle doit suivre la forme du dôme). ', 'Faîtes un trou au milieu de la pâte, afin que la vapeur s''échappe pendant la cuisson.', 'Enfournez à 200°C (thermostat 6-7). La tarte doit cuire environ 30 min. Elle est prête lorsque la croute est bien dorée et que les fruits bouillonnent dessous.', 'Retournez le moule sur un plat de service, dès sa sortie, en prenant garde au jus des prunes qui pourrait couler.', 'Servez chaud, tiède ou froid, avec une boule de vanille ou de pistache.'], ['Tire-bouchon', 'Passoire', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'Tarte tatin mirabelles et bananes', 'caramel', 'bon marché', 'plat', 'recette', 'mirabelle', 'cuisine', 'recettes', 'beurre demi-sel', 'boisson', 'tarte Tatin', 'dessert', 'plat de résistance', 'pâte feuilletée', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:38:04.298645', [{'ingredient_id': 'fa3eabca-399e-4fd7-888e-a03537939638', 'quantite': '1'}, {'ingredient_id': '70243ba2-479b-4f91-807c-46b3489eb9e3', 'quantite': '2'}, {'ingredient_id': 'de5875f8-3b33-40e3-99da-1c9c0baec154', 'quantite': '400 g'}, {'ingredient_id': '9fffac34-4629-49cc-92c5-8629ed256a3f', 'quantite': ''}, {'ingredient_id': '8e72e632-ab6a-4fa0-976a-0cba82bbd0ee', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (25932, 'Punch fruits exotiques-banane', 'rhum, banane, fruits exotiques', '5 min', ['Mélanger les ingrédients. Laisser reposer au moins 24 h au frais. ', 'Préparé une semaine à l''avance, il n''en sera que meilleur.'], ['Fouet', 'Économe', 'Râpe', 'Verre doseur', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'fruits exotiques', 'recette', 'cuisine', 'recettes', 'boisson', 'punch', 'dessert', 'plat de résistance', 'moyen', 'Punch fruits exotiques-banane', 'cocktail'], 'Boisson', 1bd85a35-defa-43e9-9185-66557c4dab76, '2025-09-26T16:38:08.862486', [{'ingredient_id': '0b1545ec-2e35-4e22-ba47-591bdcb836e8', 'quantite': '70 cl'}, {'ingredient_id': 'c306cf0f-f262-44b4-89d2-ef9f75f1ab18', 'quantite': '1 l'}, {'ingredient_id': '5e8c3923-43c8-499a-9ad0-8c1acc0b13af', 'quantite': '1 l'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46275, 'Banoffee Cheesecake', 'lait concentré sucré, biscuit, beurre demi-sel, banane, mascarpone, sucre, vanille, blanc d''oeuf', '180 min', ['Mettre la boîte de lait concentré au bain-marie pendant au moins 2 heures (ne pas oublier de refaire le plein d''eau régulièrement !) ', 'Retourner la boite à mi-cuisson pour bien unifier le toffee.', 'Réduire les biscuits en miettes (ne pas laisser de trop gros morceaux).', 'Faire fondre le beurre et mélanger avec les biscuits.', 'Etaler sur le fond d''un moule à charnière, sur un fond de papier sulfurisé beurré, en appuyant bien. Mettre au frigo.', 'Au bout de 2 heures de cuisson, sortir la boîte de lait de la casserole, laisser refroidir un peu, puis ouvrir la boite, verser dans un saladier et bien mélanger pour enlever les grumeaux.', 'Etaler le toffee ainsi obtenu sur le fond de biscuit, puis y déposer les bananes coupées en rondelles.', 'Mélanger la mascarpone et le sucre, avec l''essence de vanille, puis y incorporer vigoureusement les blancs d''œuf montés en neige.', 'Etaler la crème sur la couche de bananes et mettre au frigo jusqu''au service.'], ['Verre doseur', 'Fouet', 'Casserole', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'confiserie', 'testées', 'facile', 'plat', 'biscuit', 'recette', 'cuisine', 'recettes', 'lait concentré sucré', 'beurre demi-sel', 'boisson', 'vanille', 'dessert', 'Banoffee Cheesecake', 'cheesecake', 'plat de résistance', 'moyen', 'sucre', 'blanc d''oeuf', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:38:13.549264', [{'ingredient_id': '9f9b59eb-39b1-4859-a137-b8147c6bf1d4', 'quantite': '1'}, {'ingredient_id': 'b834c597-004e-4239-aa13-9d24ad574f1b', 'quantite': '150 g'}, {'ingredient_id': '69567f48-58df-4c9b-a810-ba83113bf30b', 'quantite': '100 g'}, {'ingredient_id': '8d5a5991-8f8c-4925-a692-6f0aa3864684', 'quantite': '3'}, {'ingredient_id': '4545ff26-4e2a-4460-9ea2-696111da4841', 'quantite': '250 g'}, {'ingredient_id': 'e9da0d6c-b3ae-4e14-bfb7-716d0ebecee4', 'quantite': '100 g'}, {'ingredient_id': 'abda4036-20a1-491d-b84e-edd2a476113d', 'quantite': '1 cuillères'}, {'ingredient_id': 'c44427c9-a50c-4e4e-b67f-8acff4bcea1d', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (312344, 'Poulet sucré-salé', 'poulet, banane, pomme, oignon, raisins secs, cube de bouillon, poudre de colombo, piment, miel, riz basmati', '30 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Mettre le poulet dans un plat.', 'Découper un oignon et l''intégrer dans le plat.', 'Assaisonner le plat de colombo, de piment d’Espelette, de sel et poivre.', 'Le badigeonner légèrement de miel puis d''huile.', 'Rajouter deux verres d''eau (à surveiller pendant la cuisson et en rajouter au cas où).', 'Enfourner dans le four pendant au moins 1 h (le retourner toutes les 20 min et l''arroser de la sauce).', 'Pendant ce temps là, éplucher les pommes, les découper assez finement puis les faire cuire à feu doux dans une poêle au beurre avec une cuillère de miel.', 'Dans une autre poêle, ajouter le 2ème oignon découpé, faire frémir puis ajouter du riz basmati.', 'Attendre 2 min puis ajouter deux verres d''eau, un cube de bouillon (poule pour ma part).', 'Assaisonner le bouillon de colombo, de piment d’Espelette et laisser mijoter 15 min environ.', 'Découper les bananes en rondelles, les ajouter avec les pommes... laisser cuire à feu doux.', 'A la cuisson du riz, aucune eau ne doit rester. Sortir la poêle du feu, rajouter les raisins secs.', 'Puis ajouter le tout dans une seule et unique poêle et mélanger.', 'Laisser le feu au minimum le temps de la fin de cuisson du poulet.', 'Découper le poulet et récupérer la sauce pour la servir.', 'Et voilà, bon appétit !'], ['Louche', 'Rouleau à pâtisserie', 'Batteur électrique'], ['', 'poulet', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'riz basmati', 'cocktail', 'facile', 'bon marché', 'Poulet sucré-salé', 'plat', 'recette', 'cube de bouillon', 'piment', 'cuisine', 'miel', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'raisins secs', 'poudre de colombo'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:38:18.122419', [{'ingredient_id': '2e319608-10a7-46b3-9ed8-b9da9ec8a2ae', 'quantite': '1 kg'}, {'ingredient_id': 'a961aab3-fc00-459a-9693-a3aed2f12ed2', 'quantite': '3'}, {'ingredient_id': 'ccb7fe63-9a30-487f-aee5-30f296975bcc', 'quantite': '4'}, {'ingredient_id': 'a199dbd3-8e5e-425e-88a7-4e457a7e3a0a', 'quantite': '2'}, {'ingredient_id': '74310cad-4b91-4f3a-8df3-ceafb20bda81', 'quantite': '30 g'}, {'ingredient_id': '4f6585d7-b015-4892-b9c7-9fd6ca218e23', 'quantite': '1'}, {'ingredient_id': 'b8be961a-f8ad-4a8f-b3ae-8e96579e99f2', 'quantite': '4 cuillères'}, {'ingredient_id': '7181e894-361b-44b6-9f87-33dc1639e8ab', 'quantite': '1 cuillères'}, {'ingredient_id': '2d5f4be3-f4b3-43db-9060-3677a507c3d1', 'quantite': '2 cuillères'}, {'ingredient_id': '5f195a81-a70e-4348-a6bc-924a051fb63b', 'quantite': '400 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (167908, 'Crème dessert avocat banane', 'banane, avocat, jus d''orange, petit beurre, jus de citron, yaourt nature, sucre glace, extrait de vanille liquide, vermicelles', '10 min', ['1)dans un blender mettre :', '- les deux bananes coupées en rondelle,', '-l''avocat coupé en morceau,', '-2 biscuits grossièrement cassés', '-50 ml de jus d''orange', '- un yaourt nature 125g', '-3 cuillères à soupe de jus de citron', '-une cuillère à café d''extrait de vanille liqude', '2) mixer le tout jusqu''à obtention d''une crème lisse et onctueuse sans morceau.', '3) gouter et rajouter selon votre goût du sucre glace jusqu''au goût souhaité moi j''en rajoute à 70 g.MIXER de nouveau pour mélanger le sucre.', '4) c''est pret! verser la préparation dans de jolies coupes à dessert ou verrines et disposer sur le dessus des vermicelles colorés un petit biscuit"palmier" et un petit parapluie en papier pour la déco.', '5) se régaler!!!'], ['Pince de cuisine', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'extrait de vanille liquide', 'confiserie', 'testées', 'avocat', 'Crème dessert avocat banane', 'yaourt nature', 'très facile', 'vermicelles', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'jus d''orange', 'petit beurre', 'sucre glace', 'cocktail', 'crème dessert'], 'Dessert', 6984a68b-12a8-46c3-81db-6d1d694b1454, '2025-09-26T16:38:21.772444', [{'ingredient_id': 'a52f7e6b-cdc1-4b7a-9559-f6063df013b3', 'quantite': '2'}, {'ingredient_id': '57e70a13-fae3-41c3-aac0-ba913cfc1d08', 'quantite': '1'}, {'ingredient_id': '6f0bff30-5bdc-466c-87d7-a2df6a850bc7', 'quantite': '50 ml'}, {'ingredient_id': '6f8593c7-e513-41bf-b67a-60ed51fabec8', 'quantite': '2'}, {'ingredient_id': '0a892389-24c9-4625-b84d-ca9efaaf6d84', 'quantite': '3 cuillères'}, {'ingredient_id': 'b9fbb84e-fd93-4a9e-be1f-009a709aefb9', 'quantite': '1'}, {'ingredient_id': 'a3c70369-ae97-4cc8-9a49-fd4a0dd57fdb', 'quantite': ''}, {'ingredient_id': '57d7fd5c-1b75-47d3-870b-040dea72d706', 'quantite': '1'}, {'ingredient_id': '32fb08ff-174e-42c1-8dc5-1d14e159afdb', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (51644, 'Bananes flambées No Mendah (Nouvelle-Calédonie)', 'citron, banane, miel, raisins secs, jus d''orange, cannelle, extrait de vanille, beurre', '5 min', ['Eplucher les bananes et les fendre en deux, dans le sens de la longueur; les arroser de jus de citron (ça empêche de noircir). ', 'Dans une sauteuse, faire fondre le beurre pour y faire dorer les demi bananes sur le côté plat, puis les retourner. ', 'Répandre sur chaque banane, une cuillère à soupe de miel. Répartir les 4 cuillères à soupe de raisins et arroser avec le rhum; flamber le rhum. ', 'Saupoudrer de cannelle et de vanille, verser le jus d''orange, et laisser cuire.', 'Servir dans une coupe, avec une boule de crème glacée vanille et deux demi bananes de chaque côté; c''est encore meilleur!'], ['Poêle', 'Économe', 'Fouet', 'Balance de cuisine', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'extrait de vanille', 'rapide', 'plat', 'moyenne', 'Bananes flambées No Mendah (Nouvelle-Calédonie)', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'citron', 'raisins secs', 'jus d''orange', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:38:25.384300', [{'ingredient_id': '57a68cc0-5ef4-4be7-9295-5ebf46ccf85e', 'quantite': ''}, {'ingredient_id': '512df9dc-bb8a-4cd9-96ed-6407a34ee6b7', 'quantite': '4'}, {'ingredient_id': 'e3a4f980-90f4-4661-9729-c6c795d0756d', 'quantite': '8 cuillères'}, {'ingredient_id': 'c16d7235-4fee-4bc5-963d-efa2bf31f1f2', 'quantite': '4 cuillères'}, {'ingredient_id': '5c881e3d-fe5e-48b6-946e-e80e3c5a2837', 'quantite': '30 cl'}, {'ingredient_id': 'ff776ecb-26bd-4074-85f2-d3c00bedf81e', 'quantite': '2 cuillères'}, {'ingredient_id': '91b5cfce-87bc-4a70-9ace-286c7419a75d', 'quantite': '2 cuillères'}, {'ingredient_id': '2a617ce2-b550-4aa1-b8a7-31d4b599602e', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (25207, 'Bananes à la gelée de groseilles', 'banane, gelée, sucre vanillé', '10 min', ['Éplucher les bananes et les couper en deux dans le sens de la longueur. "Tailler" le dessous pour qu''elles tiennent bien à l''horizontale et creuser le coeur à la cuiller pour faire un petit canal que l''on recouvrira de gelée de groseille. ', 'Saupoudrer d''un peu de sucre vanillé. ', 'Passer quelques minutes à four chaud pour que le sucre caramélise et que les bananes soient fondantes.'], ['Poêle', 'Économe', 'Rouleau à pâtisserie', 'Casserole', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'gelée', 'sucre vanillé', 'Bananes à la gelée de groseilles', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:38:28.995877', [{'ingredient_id': 'bea8bdf2-ae67-409d-abf1-4dc19431d0d9', 'quantite': '4'}, {'ingredient_id': 'e9ae45fa-ac03-40f1-ad34-4b9cc2677ab3', 'quantite': ''}, {'ingredient_id': 'c5cd7c8f-67b5-49e4-8051-91c0b3f3c0e5', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15401, 'Crème de banane au fromage blanc', 'banane, kiwi, citron, sucre en poudre, crème fouettée, fromage blanc', '20 min', ['Fouettez la crème en chantilly avec la ', 'moitié de sucre.', 'Pelez 4 bananes et écrasez la chair à la fourchette ou au presse-purée. Arrosez de la moitié du jus de citron.', 'Mélangez la purée de banane avec le fromage blanc et le sucre restant. Incorporez délicatement la crème battue à ce mélange. Ajoutez éventuellement un peu de sucre ou de citron, selon le goût.', 'Versez dans des coupes à dessert et gardez au frais.', 'Au moment de servir, coupez la dernière banane en rondelles et arrosez-la du jus de citron restant. Coupez le kiwi également en rondelles. Garnissez les coupes de rondelles de banane et de demi-rondelles de kiwi disposées en alternance.'], ['Casserole', 'Poêle', 'Moule à tarte', 'Batteur électrique'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'Crème de banane au fromage blanc', 'sucre en poudre', 'crème fouettée', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'citron', 'cocktail'], 'Dessert', b901c41f-36bc-4242-b52e-19f65259eeef, '2025-09-26T16:38:32.471925', [{'ingredient_id': 'cbb79779-d23c-42f6-af0f-a036484ac257', 'quantite': '5'}, {'ingredient_id': '4d4e7855-db0e-4db4-9810-f38edf1e65e3', 'quantite': '1'}, {'ingredient_id': '1290fb81-a85f-4d7b-967c-7690b63bda9e', 'quantite': '1'}, {'ingredient_id': '47ec3b9d-319f-486a-9c19-08a77280feb8', 'quantite': '100 g'}, {'ingredient_id': 'a17765a9-9523-4d5a-a7b3-3b080336e8d6', 'quantite': '20 cl'}, {'ingredient_id': '1b8044b0-71a2-41d9-ac4a-f130711008ac', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (69281, 'Le pavlova', 'blanc d''oeuf, sucre en poudre, maïzena, vinaigre de vin, crème fleurette, sucre en poudre, sucre vanillé, crème chantilly, framboises, kiwi, banane, abricot, jus de citron', '25 min', ['Dans un grand saladier, fouettez les blancs en neige très fermes.', 'Ajoutez la moitié du sucre en fouettant plus lentement. Lorsqu''il est bien incorporé, ajoutez le sucre restant, fouettez jusqu''à ce que vous obteniez un mélange très ferme et brillant.', 'Ajoutez le vinaigre puis la maïzena en la saupoudrant sur toute la surface. Mélangez doucement au fouet à main en soulevant la masse.', 'Sur une feuille de papier siliconé, dessinez un cercle de 25 cm de diamètre. Déposez-la sur votre plaque de cuisson.', 'Versez la meringue au milieu et étalez-la doucement jusqu''à 6-8 mm du cercle dessiné (elle gonflera en cuisant).', 'En étalant la meringue, veillez à ce que les bords soient plus hauts que le centre, en formant un creux qui recevra la garniture.', 'Mettez au four préchauffé à 170-180°C (thermostat 6) et laissez cuire 1 h 30 environ. L''extérieur doit être sec et croustillant et le coeur cuit.', 'La meringue aura pris en cuisant une légère couleur jaune paille un peu claire. Sortez-la du four. Décollez la meringue du papier lorsqu''elle est encore tiède.', 'Lorsqu''elle est froide, transférez-là sur un grand plat de service. Ne vous inquiétez pas si elle se fendille, vous la dissimulerez avec la crème.', 'Mettez tous les ingrédients de la chantilly au moins 1/4 d''heure au réfrigérateur.', 'Versez la crème bien froide dans un saladier bien froid lui aussi, fouettez-la pour la rendre ferme et mousseuse. Juste avant la fin, mélangez le sucre, le sucre vanillé et le fixe-chantilly.', 'Ajoutez-les à la chantilly, finissez de la monter.', 'Remplissez-en la meringue, en dessinant des tourbillons avec le dos d''une cuillère.', 'Garnissez de framboises, de tranches de kiwi, de rondelles de bananes trempées dans le jus de citron et de moitiés d''abricots (ou tout autre fruit). Les fruits rouges sont de plus bel effet.', 'Mettez le gâteau au réfrigérateur.', 'Quand il est bien frais, présentez le pavlova entier et découpez-le en parts.'], ['Balance de cuisine', 'Spatule', 'Pince de cuisine', 'Moule à tarte', 'Batteur électrique'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'pavlova', 'facile', 'maïzena', 'bon marché', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'vinaigre de vin', 'boisson', 'dessert', 'plat de résistance', 'blanc d''oeuf', 'cocktail', 'Le pavlova'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:38:40.418181', [{'ingredient_id': '2cc483bd-40ab-4ee0-804d-65ac2a2e0eb3', 'quantite': '4'}, {'ingredient_id': '5fe99ee8-8e01-4f28-a870-42cf179734da', 'quantite': '225 g'}, {'ingredient_id': '08998186-6844-490b-83a9-8b62b54f24ac', 'quantite': '1 cuillères'}, {'ingredient_id': '56a987cf-c0d4-43ea-8535-2984b063368b', 'quantite': '2 cuillères'}, {'ingredient_id': 'b491bdb9-e92e-4da3-8953-ad457b2182ca', 'quantite': '45 cl'}, {'ingredient_id': '52b537e1-b424-4836-9415-49f2333932e2', 'quantite': '50 g'}, {'ingredient_id': '18035afd-2dac-4dea-819c-0593dc6054e2', 'quantite': '1'}, {'ingredient_id': 'd52aabf4-e769-4df7-acf8-531cc58a6f74', 'quantite': '1'}, {'ingredient_id': '27d36793-0c3e-4b73-ae3e-0cd4c18679f8', 'quantite': '125 g'}, {'ingredient_id': '21141b8f-35d8-4ea3-b07e-ba79d3f8eec1', 'quantite': '1'}, {'ingredient_id': '182f0813-7515-4b08-8f9c-bdfd0984f20b', 'quantite': '2'}, {'ingredient_id': '3ecab249-064f-42a6-9a80-9aeab4d13ea8', 'quantite': '4'}, {'ingredient_id': '2c30b374-e2c1-4f9d-9a19-238f5d9ad4b4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (53461, 'Brownie fondant chocolat bananes', 'chocolat noir, sucre, farine, oeuf, beurre, banane', '20 min', ['Préchauffez le four à 150°C (thermostat 5).', 'Faites fondre le chocolat au micro-ondes avec un peu d''eau.', 'Faites fondre le beurre.', 'Battez les oeufs avec le sucre énergiquement et ajoutez-y le beurre fondu.', 'Rajoutez la farine puis le chocolat fondu et remuez bien.', 'Détaillez la banane en petits dés et incorporez-les délicatement dans la pâte.', 'Enfournez pour 30 minutes de cuisson, pas plus.'], ['Rouleau à pâtisserie', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'fondant au chocolat', 'plat de résistance', 'chocolat noir', 'beurre', 'Brownie fondant chocolat bananes', 'sucre', 'cocktail'], 'Dessert', e84f0b0e-4a7b-4c36-a37c-6c6f1c62c082, '2025-09-26T16:38:47.104449', [{'ingredient_id': 'eb233e5e-eae0-4039-995e-b3de0fdfda5a', 'quantite': '200 g'}, {'ingredient_id': 'ed6e9008-867a-4e72-bfe6-8b6c062d2905', 'quantite': '120 g'}, {'ingredient_id': '597f0d2d-9f2c-489a-b5d5-a1df4ce098eb', 'quantite': '70 g'}, {'ingredient_id': '53be97c9-e7d0-470f-bc42-d541e27c8710', 'quantite': '3'}, {'ingredient_id': '68bc475b-a9a4-4c84-a42b-a04c3ce0576b', 'quantite': '120 g'}, {'ingredient_id': '41761865-3ebf-4bdd-917f-2ae90d8c78ff', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81321, 'Filets d''acoupa en papillote', 'acoupa, banane, patate douce, épinards, orange, huile d''olive, gingembre, sauce soja, crème fraîche, origan, poivre, sel, muscade', '20 min', ['Préparez la marinade : ', 'Huile d''olive, gingembre râpé, sauce soja, gingembre râpé, orange pressée et son zeste, poivre et très peu de sel (sauce soja en contenant déjà).', 'Passez les filets d''acoupa dans la marinade en les retournant plusieurs fois, couvrez et mettez au frais pendant 3 heures.', 'Faites cuire à la vapeur patates douces et bananes plantain environ 20 min (les cuire séparément).', 'Dans une autre casserole, faites cuire les épinards dans un peu d''eau, ajoutez un peu de muscade en poudre, du sel et du poivre.', 'Préparez des grands morceaux de papier aluminium.', 'Quand les légumes sont cuits, coupez-les en rondelles épaisses d''1 cm. Disposez, sur le papier alu un lit de patates, un lit de bananes, puis un lit d''épinards.', 'Versez une bonne cuillère à soupe de crème fraîche ou soja.', 'Posez alors les filets d''acoupa à peine égouttés. Salez et poivrez.', 'Refermez la papillotte et posez sur le grill environ 25 min.', 'Ouvrez et dégustez.'], ['Rouleau à pâtisserie', 'Casserole', 'Tire-bouchon', 'Batteur électrique'], ['', 'origan', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'patate douce', 'muscade', 'très facile', 'plat', 'épinards', 'recette', 'cuisine', 'recettes', 'boisson', 'Filets d''acoupa en papillote', 'huile d''olive', 'dessert', 'plat de résistance', 'acoupa', 'moyen', 'orange', 'poivre', 'cocktail', 'sauce soja'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:38:50.703568', [{'ingredient_id': '5545ae17-4e53-457b-bf95-33153c913f02', 'quantite': '4'}, {'ingredient_id': 'f8a83feb-9cc3-4505-a454-cd53f7476b02', 'quantite': '2'}, {'ingredient_id': '1690938e-9a95-4771-a1e1-2e930cd4848b', 'quantite': '2'}, {'ingredient_id': '457de829-2f58-458c-b09d-3c260c8df335', 'quantite': '200 g'}, {'ingredient_id': '0ff53079-047c-4a94-943b-97e4f9c60e9c', 'quantite': '1'}, {'ingredient_id': 'ecf650fe-13c5-442e-995b-c137c1b3765b', 'quantite': '4 cuillères'}, {'ingredient_id': 'd9a61861-1881-4377-9aaf-a4924978aef0', 'quantite': '2 cuillères'}, {'ingredient_id': '88b486a7-a767-4433-85c9-fd09574d4473', 'quantite': '2 cuillères'}, {'ingredient_id': '73884568-867c-4347-be9c-0636c4ee3cb3', 'quantite': '4 cuillères'}, {'ingredient_id': '9f7196fc-44a3-42f1-b987-ae0cd9891e42', 'quantite': '1 cuillères'}, {'ingredient_id': '8f98887e-7d6f-4f80-b864-aadfe9c8223a', 'quantite': ''}, {'ingredient_id': '27a515e4-4b30-4975-a43b-1776dd160c45', 'quantite': ''}, {'ingredient_id': '3e2f3ee0-d738-4c2a-b814-05b107383d91', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530518, 'Banana split', 'banane, chocolat noir, glace vanille, glace fraise, glace au chocolat, crème chantilly', '10 min', ['Coupe les bananes en deux, et dispose-les dans une assiette (2 moitiés par assiette).', 'Fait fondre le chocolat au micro-ondes.', 'Pendant ce temps, préparer les boules de glaces et les disposer (1 de chaque parfum dans chaque assiette).', 'Ensuite, verse le chocolat fondu sur les boules de glaces, puis ajoute de la chantilly autour des bananes.'], ['Verre doseur', 'Mixeur', 'Râpe', 'Presse-agrumes', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'glace fraise', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'glace vanille', 'dessert', 'plat de résistance', 'chocolat noir', 'autres glaces', 'Banana split', 'glace au chocolat', 'cocktail'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T16:38:55.114258', [{'ingredient_id': 'e3d371cc-175c-4b09-a8c3-57db46a7db25', 'quantite': '6'}, {'ingredient_id': '5974b04d-be4e-4886-9c27-a9d8e69b621b', 'quantite': '200 g'}, {'ingredient_id': '51902f46-b053-401d-b5d5-60460d91fd60', 'quantite': ''}, {'ingredient_id': '481554bf-2cde-43a7-9fb4-3c663aeac68e', 'quantite': ''}, {'ingredient_id': '54eb5059-3069-46ce-adc4-52a178e60f1e', 'quantite': ''}, {'ingredient_id': '60c2952e-035a-4743-b3cc-12641596832c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (311738, 'Bananes croustillantes au beurre salé', 'brick, banane, sucre roux, beurre demi-sel', '5 min', ['Coupez les feuilles de bricks en quatre bandes (celles du milieu auront bien la forme de bandes, celles des extrémités seront arrondies sur un des côtés, ce qui n''est pas gênant, il faudra simplement vous arranger pour rattraper le coup au moment du pliage ! )', 'Coupez les bananes en rondelles pas trop épaisses (1/2 cm environ).', 'Sur chaque bande, déposez 4 rondelles de bananes, saupoudrez de sucre roux et ajoutez une pointe de couteau de beurre salé. ', 'Pliez en forme de triangle (il existe des vidéos sur internet et même sur marmiton qui expliquent la technique).', 'Enfournez 10 min à 200°C (thermostat 6-7) sur du papier sulfurisé. Dégustez tiède.'], ['Râpe', 'Économe', 'Louche'], ['Bananes croustillantes au beurre salé', '', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'brick', 'recettes', 'beurre demi-sel', 'boisson', 'dessert', 'plat de résistance', 'cocktail', 'sucre roux'], 'Confiserie', e7a340be-9496-4374-84c0-48f837bfee74, '2025-09-26T16:38:59.650881', [{'ingredient_id': 'b94b6b67-151f-4f82-a120-7ef4a83da196', 'quantite': '4'}, {'ingredient_id': '901c147c-5d2a-4000-a5ac-024f60036463', 'quantite': '2'}, {'ingredient_id': '106c3939-9459-4b9b-8593-03fae5cfde27', 'quantite': '50 g'}, {'ingredient_id': 'ac589480-f8f4-4251-bec4-e0eeeac267f5', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14861, 'Sabayon de fruits exotiques à la menthe et Clairette', 'mangue, ananas, fraises, kiwi, banane, kumquat, fruit de la passion, papaye, groseilles, Clairette de Die, oeuf, sucre de canne, crème fleurette, menthe', '20 min', ['Détailler les fruits en petits morceaux, vider les fruits de la passion avec une cuillère à café, ôter les graines des kumkats mais ne pas enlever leur écorce...mélanger le tout délicatement et réserver au frais dans un saladier avec un film plastique dessus.', 'Préparer le sabayon. Confectionner un bain-marie à feu moyen. Séparer le blanc des jaunes, ne garder que les jaunes. Verser les jaunes dans le cul de poule (ou deuxième casserolle) du bain-marie, ajouter le sucre et battre énergiquement jusqu''à obtention d''une solution mousseuse et légèrement blanchâtre (en veillant bien à ne pas porter le mélange à ébullition). Réserver.', 'Dans une casserolle, verser la bouteille de Clairette, couper les feuilles d''un demi-bouquet de menthe en morceaux, les mettre dans la Clairette et porter à ébulition.', 'Remettre le bain-marie des jaunes d''oeuf sur feu doux et, sans cesser de battre, verser l''infusion de Clairette... Il va se produire alors une émulsion, le mélange va prendre du volume, de la consistance, en l''espace de 3mn...', 'Ajouter alors la crème fleurette, battre encore 2 mn environ et réserver.', 'Remplir des ramequins des fruits exotiques, et les démouler dans une assiette creuse. Remplir le tour de l''assiette du sabayon.', 'Décorer le dessus avec un physallis ouvert de ses feuilles, et mettre une grappe de groseilles sur le côté, c''est magnifique !', 'Servir aussitôt.'], ['Pince de cuisine', 'Moule à tarte', 'Râpe', 'Tire-bouchon'], ['entrée', 'banane', 'kiwi', 'papaye', 'recettes de cuisine', 'confiserie', 'testées', 'assez cher', 'crème fleurette', 'menthe', 'oeuf', 'plat', 'mangue', 'fraises', 'recette', 'cuisine', 'recettes', 'Clairette de Die', 'boisson', 'groseilles', 'sucre de canne', 'fruit de la passion', 'Sabayon de fruits exotiques à la menthe et Clairette', 'dessert', 'plat de résistance', 'difficile', 'kumquat', 'ananas', 'sabayon', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:39:04.589423', [{'ingredient_id': '4d91a4a6-fbd9-46a8-9227-efd032d47582', 'quantite': '1'}, {'ingredient_id': 'cee4eef0-9385-41d2-b676-ec61ecae0508', 'quantite': '1'}, {'ingredient_id': '86a6bbcd-fe39-4df8-a3c9-8f76a7e7db4a', 'quantite': '250 g'}, {'ingredient_id': 'e6ebd878-aa3c-445f-9d9c-ac2702838f69', 'quantite': '2'}, {'ingredient_id': 'cbdf6fcc-361c-4423-908a-db774d5a41da', 'quantite': '3'}, {'ingredient_id': 'f5eadf45-7aa3-439b-8f18-30e17a11924a', 'quantite': '3'}, {'ingredient_id': 'eaefb89c-9f72-464d-a427-fdece2092c53', 'quantite': '3'}, {'ingredient_id': '656a6f2c-8f0f-454e-9536-1924b537716e', 'quantite': '1'}, {'ingredient_id': '4ad2f534-4546-4f9d-bde1-70eef16f4b57', 'quantite': ''}, {'ingredient_id': '1d3ff7f1-5bc7-467f-adca-7d5c2f00698e', 'quantite': '1'}, {'ingredient_id': '2e18475a-6d0d-43c9-8796-184cbd7dcfc9', 'quantite': '12'}, {'ingredient_id': '22bb0c2c-1967-4466-a724-8481cd69bf7c', 'quantite': '1'}, {'ingredient_id': 'c52a0641-a146-45f5-9e65-e80eb95c3560', 'quantite': '10 cl'}, {'ingredient_id': 'e6fcc945-440a-47f7-b1c9-1a90aea9a8b5', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (531155, 'Cocktail Tropicorne', 'jus d''orange, rhum blanc, lait de coco, banane, glace pilée', '15 min', ['Mélanger le rhume blanc, le lait de coco, et le jus d''orange. Filtrer le mélange pour éliminer les dépôts solides de coco.', 'Mixer la banane avec un mixer plongeant, et introduire le mélange de rhum/coco/orange au fur et à mesure tout en continuant de mixer.', 'Mettre de la glace pilée au fond du verre et y verser la boisson. Décorer avec une rondelle d''orange par exemple ou des copeaux de noix de coco sur le dessus.
', 'Servir frais. Bonne dégustation !'], ['Pince de cuisine', 'Poêle', 'Rouleau à pâtisserie', 'Batteur électrique', 'Fouet'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Cocktail Tropicorne', 'très facile', 'bon marché', 'rapide', 'plat', 'cocktail rhum', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'rhum blanc', 'jus d''orange', 'cocktail', 'glace pilée'], 'Boisson', e9d619fc-6adb-46ce-9e93-6b2770081323, '2025-09-26T16:39:09.459502', [{'ingredient_id': '719d54c1-e2ca-4892-ad85-5b222f292cd7', 'quantite': '10 cl'}, {'ingredient_id': '93c30bba-0187-43e9-9f0b-870580295692', 'quantite': '5 cl'}, {'ingredient_id': '3f54465f-7920-430a-a653-1e490cd7edaa', 'quantite': '5 cl'}, {'ingredient_id': 'c4d99f52-2069-4e2d-896a-597110026e85', 'quantite': '1'}, {'ingredient_id': '663533cc-83f4-40ab-8b84-97d80fc5195c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16007, 'Pavlova', 'blanc d''oeuf, sucre, vinaigre, maïzena, crème liquide, sucre glace, fraises, framboises, raisin, pêche, nectarine, banane', '20 min', ['Battre les blancs en neige très ferme. Ajouter le sucre peu a peu. Battre encore. Ajouter le vinaigre et la Maizena. Battre encore. Le mélange doit etre tres ferme et brillant.', 'Mettre sur une plaque très très légèrement huilée (mieux encore, l''équivalent francais du ''non-stick baking paper''). On doit le mettre en forme de cercle assez haut (8 à 10cm).', 'Cuire au Four à 130°C pendant 1h15.', 'Laisser refroidir. Mettre au frigo. Une heure avant de servir, monter la crème en chantilly en ajoutant le sucre glace, répartir sur la meringue et disposez les fruits par-dessus.'], ['Batteur électrique', 'Verre doseur', 'Planche à découper', 'Moule à tarte', 'Poêle'], ['raisin', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'pavlova', 'très facile', 'nectarine', 'framboises', 'maïzena', 'bon marché', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'Pavlova', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'pêche', 'sucre glace', 'sucre', 'blanc d''oeuf', 'vinaigre', 'cocktail'], 'Dessert', 53b1482f-f325-44d5-b02f-ad2e61a4044d, '2025-09-26T16:39:16.232424', [{'ingredient_id': 'ca5bdd8a-3d1a-4368-905d-499f9252e1cb', 'quantite': '6'}, {'ingredient_id': 'd661b879-38c0-4696-9dca-a3bf2133a270', 'quantite': '340 g'}, {'ingredient_id': '016f4c4c-60a4-432a-a600-0fd37b71b294', 'quantite': '1.5 cuillères'}, {'ingredient_id': 'cda0a4d8-7502-4cde-834e-a73390993197', 'quantite': '1.5'}, {'ingredient_id': 'ca30c95d-63cc-4fe3-91b1-e16803e157b9', 'quantite': '25 cl'}, {'ingredient_id': '0fde5ffc-75a9-48f2-a1fc-77b213197da7', 'quantite': '25 g'}, {'ingredient_id': '25164ebf-130f-492d-a4df-4830f5d5e67d', 'quantite': ''}, {'ingredient_id': 'd597445f-4581-480f-8359-b44f9264fa58', 'quantite': ''}, {'ingredient_id': '7138bcc2-7c45-4efe-a0e7-83717eafb685', 'quantite': ''}, {'ingredient_id': '71f85622-f42e-415c-9255-ff9549c3d733', 'quantite': ''}, {'ingredient_id': '5ab6b674-38da-42af-89b8-68301e847f1e', 'quantite': ''}, {'ingredient_id': '1591bde3-7463-44df-9d9e-74b62777cd93', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26325, 'Charlottes aux bananes et à la noix de coco', 'biscuits à la cuillère, rhum, confiture, banane, citron, crème fraîche', '30 min', ['Découpez les bananes en rondelles, citronnez-les.', 'Diluez le rhum avec autant d''eau. Trempez-y rapidement les biscuit à la cuillère et tapissez le fond et les parois d''un moule à charlotte.', 'Garnissez ensuite de confiture de noix de coco, rondelles de bananes, et biscuits imbibés, jusqu''à le remplir. Terminez par  une couche de biscuits.', 'Posez une assiette et un poids par-dessus. Laissez 1 nuit au réfrigérateur.', 'Peu avnat de servir, démoulez la charlotte et décorez de dômes de Chantilly faits à l''aide d''une poche à douille et de rondelles de bananes.'], ['Passoire', 'Casserole', 'Spatule'], ['', 'Charlottes aux bananes et à la noix de coco', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'confiserie', 'confiture', 'testées', 'biscuits à la cuillère', 'facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'citron', 'cocktail'], 'Dessert', 90e2e626-05cc-4057-8cc4-1c2e1bf6677d, '2025-09-26T16:39:19.942394', [{'ingredient_id': '6e4fa95c-46c8-4308-9c99-0cd7f77f6866', 'quantite': '30'}, {'ingredient_id': 'f150e7c1-a8b6-42f2-89c0-7a65d43a593e', 'quantite': '10 cl'}, {'ingredient_id': '93e508f4-5998-4f79-a5a7-d1464ea41862', 'quantite': '1'}, {'ingredient_id': '08644181-e4b7-4886-909c-13e92ffb6feb', 'quantite': '3'}, {'ingredient_id': 'c1c7232d-a6d0-473f-852d-3f8c2588d839', 'quantite': '1'}, {'ingredient_id': '5c7562e7-12b1-43b2-832d-1301dfc1a406', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (67602, 'Tarte chocolat banane caramel', 'petit beurre, beurre tendre, banane, chocolat, sucre en poudre', '30 min', ['Mettre les petits beurre dans un sac congélation et les écraser au rouleau à pâtisserie.', 'Mettre la poudre obtenue dans un saladier, y rajouter le beurre et 50 g de sucre. Mélanger avec les doigts afin d''obtenir un mélange homogène.', 'Etaler la préparation dans un plat à tarte et réserver au réfrigérateur pendant 30 minutes pour durcir la pâte. Ensuite, cuire la pâte 10 à 15 minutes au four à 180°C (thermostat 6).', 'Couper les bananes en rondelles, les mettre au frais.', 'Verser le sucre restant dans une casserole à fond épais avec 2 cuillères à soupe d''eau. Laisser chauffer à feu doux jusqu''à ce que le sucre devienne liquide. Incliner légèrement la casserole mais ne pas remuer.', 'Plonger les bananes dans le caramel et les retourner afin qu''elles soit couverte de caramel. Verser le mélange sur la pâte (on peut récupérer les bananes caramélisées à l''aide d''une écumoire pour éviter d''avoir trop de caramel).', 'Faire fondre le chocolat au micro onde, l''étaler sur la tarte et laisser refroidir. Réserver au frais et déguster !'], ['Pince de cuisine', 'Moule à tarte'], ['entrée', 'Tarte chocolat banane caramel', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'beurre tendre', 'chocolat', 'facile', 'caramel', 'bon marché', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'petit beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:39:23.672639', [{'ingredient_id': '0eaeffd5-eee3-4c91-8848-b827895089a0', 'quantite': '175 g'}, {'ingredient_id': '2b11ef21-b5ed-42c4-a686-1db88b10c790', 'quantite': '75 g'}, {'ingredient_id': '363be1a5-3b5f-4baf-84b4-f1f19a56e13b', 'quantite': '4'}, {'ingredient_id': '7e1dc171-d208-4235-9865-f1dca99d3e8e', 'quantite': '200 g'}, {'ingredient_id': '3f57a7f7-75f8-4910-9f5a-c50f6073f6ac', 'quantite': '250 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (82580, 'Crumble hivernale', 'pomme, banane, figue, sucre vanillé, beurre salé, sucre en poudre, farine', '15 min', ['Eplucher les pommes et les couper en petits morceaux, ôter la peau des bananes, les couper en rondelles.', 'Laver les figues et ôter la pointe du haut, faire de petites tranches.', 'Mettre tous les fruits coupés dans une casserole avec les 2 sachets de sucre vanillé à feu moyen pendant 15 minutes, couvrir et réserver.', 'Préchauffer le four à 200°C (thermostat 6-7).', 'Dans un bol, faire fondre le beurre, ajouter le sucre, puis la farine pour obtenir comme du sable (mélanger avec une fourchette ça marche très bien).', 'Verser les fruits mi-cuits dans un plat allant au four et ajouter le "sable" émietté par dessus.', 'Mettre au four pendant 30 minutes (vous pouvez les 5 dernières minutes mettre sous le gril pour obtenir une belle croûte dorée!!).', 'A déguster tiède et sans modération!!'], ['Planche à découper', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'beurre salé', 'bon marché', 'figue', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'autres crumbles', 'cocktail', 'Crumble hivernale'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:39:28.218207', [{'ingredient_id': '708f9b7a-4077-44c6-b3a2-5051dea057ba', 'quantite': '6'}, {'ingredient_id': '20b9198a-87ee-4d79-9fb6-842f51630a59', 'quantite': '3'}, {'ingredient_id': '63687fcd-d7f0-4b3e-b342-f5cd392c3e8c', 'quantite': '4'}, {'ingredient_id': '2ccb6bcc-0853-4cf2-b952-fa350dee46ab', 'quantite': '3'}, {'ingredient_id': 'a386baa1-3cff-40a9-aae4-80d8844ebcb9', 'quantite': '70 g'}, {'ingredient_id': 'f54e72b3-bb7c-4912-9984-bc7c51b88275', 'quantite': '100 g'}, {'ingredient_id': '17c126cb-7614-4e1c-b779-403d473532cb', 'quantite': '120 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (171775, 'Croustillants à la banane', 'brick, banane, beurre, sucre semoule, crème chantilly', '10 min', ['Préchauffez votre four à 180°C (thermostat 6).', 'Épluchez les bananes, coupez les en 2 dans le sens de la largeur puis en 2 dans le sens de la longueur.', 'Vous obtenez ainsi 8 morceaux.', 'Placez les morceaux dans une assiette, saupoudrez-les de sucre semoule et ajoutez par dessus une petite noisette de beurre. ', 'Passez au micro-ondes pendant 2 min pour les ramollir un peu.', 'Faites fondre le restant de beurre au micro-ondes dans un ramequin.', 'Pendant ce temps, préparez les feuilles de brick.  Si elles sont rondes, coupez les bords pour en faire des feuilles rectangulaires.', 'Une fois le beurre fondu, badigeonnez les feuilles avec. Disposez les bananes comme vous le souhaitez sur les feuilles, puis refermez-les en enroulant les feuilles sur les bananes. Vous obtenez une sorte de nem.', 'Faites cuire vos croustillants pendant 10 min à 180°C (thermostat 6). Vérifiez bien la cuisson : les croustillants doivent être légèrement dorés.', 'Disposez sur une assiette, avec un peu de crème chantilly.'], ['Pince de cuisine', 'Rouleau à pâtisserie', 'Fouet', 'Verre doseur', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'brick', 'Croustillants à la banane', 'recettes', 'sucre semoule', 'boisson', 'crème chantilly', 'dessert', 'plat de résistance', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:39:31.836534', [{'ingredient_id': 'f5c69b64-0f7f-41b6-b7ef-da7880c5ef9c', 'quantite': '4'}, {'ingredient_id': '7effe21b-5716-4596-b24b-416ab76cee73', 'quantite': '2'}, {'ingredient_id': '915565ca-d8ce-4406-b8a2-b2764b97eda5', 'quantite': '1'}, {'ingredient_id': '91021570-0f73-43c1-92eb-acb619ccc8e9', 'quantite': '50 g'}, {'ingredient_id': '91448bce-3db5-4d45-b9b4-7468274bb930', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56501, 'Sorbet orange banane à la cannelle', 'orange, citron, banane, sucre glace, cannelle', '15 min', ['Presser les oranges et le citron.', 'Ecraser les bananes à la fourchette avec un peu de jus, ou les passer au mixeur.', 'Mélanger le jus d''orange et de citron, les bananes, le sucre et la cannelle. ', 'Laisser prendre en sorbetière ou mettre au congélateur en sortant de temps en temps le sorbet pour le fouetter, jusqu''à atteindre la consistance voulue.'], ['Ouvre-boîte', 'Tire-bouchon', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'sorbet', 'dessert', 'plat de résistance', 'citron', 'orange', 'Sorbet orange banane à la cannelle', 'sucre glace', 'cannelle', 'cocktail'], 'Dessert', b9d21f47-64bf-4b9f-9ea9-c0273587d644, '2025-09-26T16:39:36.810146', [{'ingredient_id': '073453a1-6e7b-4d89-97c4-908af04b57b1', 'quantite': '6'}, {'ingredient_id': '18365606-046a-4440-864d-2008e7dcdc6c', 'quantite': '1'}, {'ingredient_id': '6562d0ae-3260-4c08-8f61-56f3212889c5', 'quantite': '2'}, {'ingredient_id': 'ebd3ce67-a078-4ff2-9a10-30af52a8aa2f', 'quantite': '100 g'}, {'ingredient_id': 'b6fe1d14-1b57-49ec-bb56-7f0acd888bce', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57994, 'Tarte prune-banane', 'prune, banane, beurre, rhum, pâte feuilletée, sucre vanillé, oeuf, crème fraîche, lait, sucre', '15 min', ['Préchauffé votre four à 180°C (thermostat 6).', 'Abaissez la pâte feuilletée dans un moule.', 'Coupez en morceaux les prunes et la banane.', 'APPAREIL N°1 : Faire fondre le beurre dans une pôele.', 'Y mettre les fruits.', 'Ajouter 1 sachet de sucre vanillé.', 'Une fois que c''est bien doré, répandre le rhum et flamber.', 'Verser l''appareil n°1 dans le moule chemisé et réserver.', 'APPAREIL N°2 : Dans un bol, battre les oeufs.', 'Incorper le sucre vanillé, le sucre, la crème fraîche et le lait.', 'Verser l''appareil n°2 dans votre plat à tarte.', 'Enfourner votre tarte et laisser cuire 40 min.'], ['Balance de cuisine', 'Louche', 'Planche à découper', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'confiserie', 'testées', 'facile', 'prune', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'Tarte prune-banane', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'sucre vanillé', 'moyen', 'beurre', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:39:40.457974', [{'ingredient_id': 'b1dd5b17-f350-4165-9829-6437e29208b3', 'quantite': '4'}, {'ingredient_id': 'a6b1be21-9da1-4aa0-9dfd-467466f35baa', 'quantite': '1'}, {'ingredient_id': '081b33a5-d5e3-4932-832f-71a957e2aeec', 'quantite': '10 g'}, {'ingredient_id': '4179925e-4a35-4526-9360-abd313e75756', 'quantite': '5 cl'}, {'ingredient_id': '795b37df-2192-4864-a061-38d784571d12', 'quantite': '1'}, {'ingredient_id': '05935632-09fd-47e1-aac7-a9051c091359', 'quantite': '2'}, {'ingredient_id': '9b08e14c-3885-4300-be45-c616656d94de', 'quantite': '2'}, {'ingredient_id': '5dcd9829-0920-426b-a5c9-e418c77659ee', 'quantite': '10 cl'}, {'ingredient_id': 'e45d17f7-6ed6-4469-887c-935c12d9b8bb', 'quantite': '10 cl'}, {'ingredient_id': '880b753f-f36d-420b-9b6e-8875290a4139', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29473, 'Milk shake panaché aux fruits', 'banane, kiwi, avocat, pomme, lait, sucre en poudre', '10 min', ['Mettre tous les ingrédients dans le bol du mixer et mixer le tout.', 'A servir très frais.'], ['Balance de cuisine', 'Casserole', 'Économe', 'Moule à tarte', 'Passoire'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'avocat', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'Milk shake panaché aux fruits', 'lait', 'cocktail'], 'Boisson', bb65e336-1d76-4458-b44d-ddba2133e3b6, '2025-09-26T16:39:43.974639', [{'ingredient_id': '571ab7b6-3fa3-4d05-9b8d-4cb71d2ddb5e', 'quantite': '1'}, {'ingredient_id': 'b029d01d-88ee-4838-aa1f-49b50df8b9d5', 'quantite': '1'}, {'ingredient_id': 'bb884584-882d-41b9-8074-16cdc7944d2a', 'quantite': ''}, {'ingredient_id': 'eda14fcb-9d42-4913-b079-ba225e59e43f', 'quantite': ''}, {'ingredient_id': 'cef424be-ae2b-443a-8609-30798f00ee19', 'quantite': '20 cl'}, {'ingredient_id': '052325ec-a99f-4754-9483-cacc3f9574a5', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392548, 'Toast d’avocat sucré, garni de fraises, pomelos, bananes, oranges et citrons de corse confits, menthe fraîche par Pierre Hermé', 'beurre demi-sel, beurre, sucre glace, fleur de sel, jaune d''oeuf, farine de châtaigne, fécule de pomme de terre, citron confit, sucre, eau, avocat, jus de citrons verts, zeste de citron, gingembre, banane, sucre de coco, poivre, avocat, kiwi, pomelo chinois, poivre, zeste de citron, menthe, citron confit, orange', '30 min', ['Commencez par préparer la pâte : Tempérez les beurres.', 'Tamisez ensemble la farine de châtaigne et la fécule de pomme de terre.', 'Faites cuire l’œufs dur (10min dans de l’eau, refroidir,
décortiquez, tamiser), faites refroidir puis passez-le dans un tamis moyen.', 'Dans la cuve du batteur muni de la feuille, mélangez les ingrédients dans l’ordre, en donnant le minimum de corps à la pâte. Coupez-la en deux, étalez
la moitié de la pâte en forme de tartine, filmez et réservez au réfrigérateur.', 'L’autre moitié, façonnez-la en un rouleau, détaillez des sablés de 1 cm d’épaisseur, disposez sur une plaque revêtue d’un papier cuisson et cuisez les a 180°C pendant 22/25 minutes. Laissez refroidir. A
goûter avec le café.', 'Prélevez des zestes de citron jaune et faites-les confire dans un sirop 50 g de sucre et 200 g
d’eau pendant 20 minutes.', 'Le lendemain, étalez la pâte à sablé breton à la farine de châtaigne à 6 mm en forme de tartine pour 4/6 personnes.
Cuisez 25 minutes à 170/180 °C, laissez refroidir.', 'Préparez ensuite la garniture : Prenez les avocats bien mûrs, coupez-les en deux, videz la chair à l’aide d’une cuillère et
mettez dans le mixer. Ajoutez le zeste et jus d’un citron vert, une cuillère à café de gingembre râpé, une banane coupée en gros morceaux, 20 g de sucre de coco, 1 g de poivre noir sarawak frais moulu. Mixez rapidement.', 'Etalez la crème ainsi obtenue sur toute la surface du sablé en faisant un rebord de 1,5 cm tout autour.', 'Pour les finitions : détaillez 2 avocats en fine lamelles, citronnez.', 'Détaillez deux kiwis en fines lamelles. Coupez deux pomelos, retirez la peau et prélevez les segments individuellement. Détaillez des fraises en lamelles.', 'Disposez joliment les fruits sur la crème d’avocat à la banane, assaisonnez de poivre noir sarawak, de zestes de citron vert frais râpé, de menthe ciselée, de zestes de citron confit, de lamelles d’orange confite.'], ['Rouleau à pâtisserie', 'Tire-bouchon'], ['entrée', 'recettes de cuisine', 'pomelos', 'confiserie', 'testées', 'garni de fraises', 'Toast d’avocat sucré', 'menthe fraîche par Pierre Hermé', 'bananes', 'plat', 'moyenne', 'oranges et citrons de corse confits', 'jaune d''oeuf', 'recette', 'cuisine', 'recettes', 'beurre demi-sel', 'boisson', 'dessert', 'fleur de sel', 'fécule de pomme de terre', 'plat de résistance', 'farine de châtaigne', 'moyen', 'beurre', 'sucre glace', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:39:48.677983', [{'ingredient_id': 'c2a55e33-4d66-4a23-8d4c-219845bf6f51', 'quantite': '200 g'}, {'ingredient_id': 'be825891-e8fa-4efd-af66-4e44e92ab65d', 'quantite': '75 g'}, {'ingredient_id': 'd2400fac-a5d0-45bd-bcbc-aa8554436460', 'quantite': '90 g'}, {'ingredient_id': '10915a7b-58f6-42e1-b05c-7c9b11ae3d92', 'quantite': '1.5 g'}, {'ingredient_id': 'db89d6c7-7ccb-4f5d-8baa-b43e8a317ece', 'quantite': '10 g'}, {'ingredient_id': 'cb58440f-fbbd-4903-bdc6-88e27cc8005b', 'quantite': '265 g'}, {'ingredient_id': '1a52e721-22fd-4223-ad5c-7f3c713baa21', 'quantite': '50 g'}, {'ingredient_id': '83e50a81-2e31-4ca1-80c2-704fc55b5de6', 'quantite': ''}, {'ingredient_id': 'edbd76dd-38c1-4f5e-aac8-a57b16e54c39', 'quantite': '50 g'}, {'ingredient_id': 'ca5e0fcf-8599-4ad9-a94a-f37447f848ed', 'quantite': '200 g'}, {'ingredient_id': 'ab8feb6b-e423-42b9-a8d4-e34a9d24854d', 'quantite': '3'}, {'ingredient_id': '5454b96e-dd44-4735-a91a-ebe5f799d9fe', 'quantite': '1'}, {'ingredient_id': '249cf21f-2076-48bd-bb09-0c87964b0a27', 'quantite': ''}, {'ingredient_id': 'b776cf7d-bd32-4ce9-b152-4cc9a89f8179', 'quantite': '1 cuillères'}, {'ingredient_id': 'a5f7aadf-f12c-4434-ba5d-da6508c30e6a', 'quantite': '1'}, {'ingredient_id': '0af0a3ef-2e95-4070-b003-cdca3c1e7a28', 'quantite': '20 g'}, {'ingredient_id': '5f0446b9-0ef2-4f11-a515-4eacfe1c43b7', 'quantite': '1 g'}, {'ingredient_id': '4e62b939-05cb-41a4-aca2-0bbb87c5e34b', 'quantite': '2'}, {'ingredient_id': 'a8c83622-aea8-4b13-96db-b08b2aa11f5a', 'quantite': '2'}, {'ingredient_id': '7feb71a7-f783-4b70-ad4f-650a710139ff', 'quantite': '2'}, {'ingredient_id': '99b795fe-e236-404e-864a-86a6ad9b171e', 'quantite': ''}, {'ingredient_id': '58825863-cae3-4e5e-a965-3cb8d17e2c7b', 'quantite': ''}, {'ingredient_id': '62d806e0-f232-4939-a046-792234af2e2a', 'quantite': ''}, {'ingredient_id': 'be49b90f-015e-4286-afb7-1f32e2406baf', 'quantite': ''}, {'ingredient_id': '12150b02-9720-412d-be30-6bd84bb13f49', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (529099, 'Lasagnes de bananes plantain', 'paprika, oignon, sel, tomate, eau, mozzarella, coriandre, viande hachée, poivron rouge, concentré de tomates, origan, banane plantain, poivre, sucre, huile d''olive, piment vert, ail', '20 min', ['Couper les bananes en tranches d''environ 2 à 3 mm. Les mélanger avec 6 cl d''huile d''olive et 1 c.à.c de paprika. Saler légèrement. 
', 'Cuire 20 à 25 min à 190°C mode chaleur tournante les bananes dans un four préchauffé. 
', 'Faire revenir l''oignon dans 2 c.à.s d''huile. Ajouter la viande hachée, l''ail, 1 c.à.c de paprika et 1 c.à.c de sel. Cuire environ 5 min, puis réserver.
', 'Dans le même wok ajouter 1 c.à.s d''huile, faire revenir 2 min le piment et le poivron puis ajouter la tomate, saler légèrement et poivrer. Cuire quelques minutes et ajouter le concentré de tomates et le sucre. Bien mélanger. Ajouter la viande et les herbes aromatiques.
', 'Ajouter l''eau et laisser mijoter 10 mn. 
', 'Montage des lasagnes : mettre une couche de plantains, recouvrir de viande, de béchamel et de mozzarella. Renouveler l''action 2 fois.
', 'Cuire les lasagnes pendant 15 à 20 min à 190°C en mode chaleur tournante. Servir chaud.'], ['Rouleau à pâtisserie', 'Balance de cuisine'], ['mozzarella', 'origan', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'eau', 'testées', 'concentré de tomates', 'très facile', 'bon marché', 'tomate', 'paprika', 'ail', 'plat', 'viande hachée', 'recette', 'cuisine', 'poivron rouge', 'recettes', 'oignon', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'banane plantain', 'piment vert', 'Lasagnes de bananes plantain', 'coriandre', 'poivre', 'sucre', 'cocktail', 'plat unique'], 'Plat principal', 87e76c0c-91ce-4472-b4d9-6a5844a30451, '2025-09-26T16:39:53.128639', [{'ingredient_id': '3cb51e21-099b-41a7-aaf4-723143e898a5', 'quantite': ''}, {'ingredient_id': 'e837fd03-4917-4f35-802d-808fab335a6e', 'quantite': '2'}, {'ingredient_id': 'edff7b07-c429-4dd9-b5bc-8f81319d1746', 'quantite': ''}, {'ingredient_id': '7aa7d1ed-f8fe-49fb-b67e-f4da8777e332', 'quantite': '2'}, {'ingredient_id': '1d31223f-bea8-45c6-949e-b9aa402fd019', 'quantite': '1'}, {'ingredient_id': '53221f8a-d959-4493-a6d3-61bdca04a561', 'quantite': '2'}, {'ingredient_id': 'a571a743-74ad-4288-8229-f2eaef523417', 'quantite': '1'}, {'ingredient_id': 'b8a0ca19-9b98-4a9e-8675-7f8221c7d891', 'quantite': '400 g'}, {'ingredient_id': '5770fd4d-d991-4c08-93c9-7601f20e1329', 'quantite': ''}, {'ingredient_id': '02b0b2c0-5abe-456f-b7ba-34f71c419f98', 'quantite': '70 g'}, {'ingredient_id': 'bdb9dbe2-97da-4a76-af66-b483301247a6', 'quantite': '1 cuillères'}, {'ingredient_id': 'de778c9f-d2b5-44e6-a18d-942256614f9e', 'quantite': ''}, {'ingredient_id': 'def6bbf5-d913-4626-9111-a479f560b8af', 'quantite': ''}, {'ingredient_id': 'ecdb0470-d554-4dcb-a727-26d20ab846a2', 'quantite': ''}, {'ingredient_id': '7ce637af-8733-4dc6-9fa6-b48cd36ba1e7', 'quantite': ''}, {'ingredient_id': '345a5f77-04a8-43e0-b8ae-f01650c2cf89', 'quantite': '1'}, {'ingredient_id': 'eaeddf92-761b-4d36-839a-23afb4ddb70f', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46191, 'Cake à la mousse de marrons et à la banane', 'banane, sucre en poudre, sucre roux, oeuf, farine, levure chimique, marrons, beurre', '10 min', ['Couper les bananes en petits morceaux. Les faire revenir avec du beurre et 20 g de sucre roux.', 'Dans une jatte, battre les oeufs et le sucre. Lorsque le mélange est mousseux, ajouter la farine, la levure, le marronsuiss et 80g de beurre fondu.', 'Lorsque le mélange est homogène, ajouter les bananes et mélanger. ', 'Verser l''appareil dans un moule beurré et cuire 40 min dans un four à 180°C (thermostat 6).'], ['Louche', 'Tire-bouchon', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'marrons', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'beurre', 'cocktail', 'sucre roux', 'Cake à la mousse de marrons et à la banane'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:39:56.723763', [{'ingredient_id': '5fbdc316-8c55-4f09-88af-67c74e5131eb', 'quantite': '3'}, {'ingredient_id': '379e1dfb-648b-40a9-bfe6-d5fbdca42d79', 'quantite': '160 g'}, {'ingredient_id': 'b8393b87-018a-43e6-8a82-74d59bb09573', 'quantite': '20 g'}, {'ingredient_id': 'a771949c-2411-4eb5-98c4-674aacbe9a9a', 'quantite': '3'}, {'ingredient_id': 'c8b385b9-0e81-42a7-952c-c804b5947fff', 'quantite': '200 g'}, {'ingredient_id': 'e6fdc8f8-d4bd-42fa-b358-492366d6926e', 'quantite': '1'}, {'ingredient_id': '1599187f-3a70-43a8-997c-d35c3c9126b2', 'quantite': '1'}, {'ingredient_id': 'f9a661c1-bc01-4522-831f-89216ff88154', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528062, 'Petit pot pomme banane', 'pomme, banane', '5 min', ['Rincer, peler, épépiner et couper la pomme en cubes.', 'Peler les bananes et les couper en morceaux.', 'Cuire la pomme et les bananes à la vapeur pendant 15 à 20 minutes.', 'Mixer le tout en ajoutant un peu d''eau jusqu''à obtenir un velouté sans morceaux.', 'Empoter dans des petits pots avec couvercle et laisser refroidir. Servir à température ambiante. À conserver au réfrigérateur jusqu''à 48h maximum, ou au congélateur jusqu''à 1 mois.'], ['Couteau de chef', 'Batteur électrique'], ['boisson', 'bon marché', 'entrée', 'banane', 'recettes de cuisine', 'cuisine', 'plat', 'dessert', 'compote de banane', 'confiserie', 'recette', 'testées', 'plat de résistance', 'cocktail', 'pomme', 'Petit pot pomme banane', 'recettes', 'facile'], 'Dessert', df2f0fd6-df7c-49bb-ab68-3c66297c9ea5, '2025-09-26T16:40:00.270684', [{'ingredient_id': '361e3cf3-a716-4d32-b8c0-5f90ea332fc0', 'quantite': '1'}, {'ingredient_id': '9d3b6201-6337-49fd-a2c4-1893e45686e0', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (334653, 'Gaufres banane caramel', 'farine, sucre, oeuf, beurre, lait, sel, vinaigre, sucre en poudre, eau, banane', '10 min', ['Commencer par faire la pâte à gaufres.', 'Pour cela, mélanger la farine, le sucre, les jaunes d''oeufs et le beurre ramolli. ', 'Délayer peu à peu le tout en y ajoutant le lait, mélanger jusqu''à ce que le mélange soit bien homogène. ', 'Battre les blancs en neige avec une pincée de sel et les ajouter au restant en remuant délicatement.', 'Laisser reposer la pâte quelques minutes le temps de faire le caramel.', 'Mettre le vinaigre + le sucre + 12,5 cl d''eau dans 1 casserole. ', 'Faire chauffer à feu vif environ 15 min. ', 'Quand le caramel blondit, baisser un peu le feu et ajouter très, très, très doucement 25 cl d''eau froide (attention aux éclaboussures). ', 'Refaire chauffer 1 min à feu vif.', 'Cuire ensuite les gaufres dans un gaufrier légèrement beurré.', 'Les gaufres encore tièdes, napper-les généreusement de caramel puis décorer avec des rondelles de bananes. ', 'Servir immédiatement.'], ['Moule à tarte', 'Casserole', 'Batteur électrique', 'Spatule'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'bon marché', 'Gaufres banane caramel', 'rapide', 'oeuf', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'gaufre', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'lait', 'cocktail'], 'Dessert', f23b2d26-8582-4f8d-980b-0b886ad3f1d9, '2025-09-26T16:40:05.147318', [{'ingredient_id': 'e1d557ed-a392-43e7-a1b1-795762819df7', 'quantite': '200 g'}, {'ingredient_id': '7fc7b180-776e-4cf2-b00d-f568823f338b', 'quantite': '30 g'}, {'ingredient_id': '886db603-491c-4bd3-902d-4a2c1050c008', 'quantite': '3'}, {'ingredient_id': '842bf5be-6bce-4141-8bee-fb192a727cd6', 'quantite': '20 g'}, {'ingredient_id': '783035d2-3271-4396-a6a4-926fd00d8167', 'quantite': '25 cl'}, {'ingredient_id': '3aa54288-072c-4e07-9041-016d68d78968', 'quantite': '1'}, {'ingredient_id': '77f5cb78-4d33-4256-add8-e29540e8c1eb', 'quantite': '1 cuillères'}, {'ingredient_id': '671f9cdc-49c7-4129-b2d0-869b89879c59', 'quantite': '500 g'}, {'ingredient_id': '408ea21b-8e7b-4b7b-9b2d-25ac98a779d6', 'quantite': '12.5 cl'}, {'ingredient_id': 'd50a1580-ae7a-4d3b-8df4-c9c5123a8d04', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22225, 'GLACE MALAGA A LA BANANE', 'banane, rhum, crème liquide, sucre glace, raisins secs', '10 min', ['Faire macérer le raisin sec avec le rhum la veille. ', 'Mélanger la crème fluide avec le sucre. ', 'Mettre les bananes dans le shaker et ajouter les 2 cuillères à soupe de rhum ainsi que la préparation crème sucre, et les raisins. ', 'Faites tourner 5 mn. ', 'Faites congeler la glace 5 ou 6 h.'], ['Couteau de chef', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'raisins secs', 'sucre glace', 'GLACE MALAGA A LA BANANE', 'glace à l''italienne', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:40:08.883302', [{'ingredient_id': '7660d9b7-eb6d-4bc8-a07e-d4dc1f5184a2', 'quantite': '2'}, {'ingredient_id': 'd8c88ccb-3149-4eed-82f0-7524a69a3218', 'quantite': '2 cuillères'}, {'ingredient_id': 'dbbdb0ed-8f15-439e-bf5d-6c07f67cfe53', 'quantite': '25 cl'}, {'ingredient_id': 'c14bb424-7462-4bc6-9499-c9349e95183f', 'quantite': '180 g'}, {'ingredient_id': '6e4cc603-ca82-487e-8a5c-25bda29472e2', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (54922, 'Choubanana', 'banane, yaourt nature, sucre en poudre', '15 min', ['Ecrasez les bananes à la fourchette et mettez les dans un saladier.', 'Rajoutez les yaourts, mélangez.', 'Mettez le sucre et remélangez.', 'Mettez 15 min au frigo.', 'VOILA C''EST PRET.'], ['Couteau de chef', 'Économe', 'Planche à découper', 'Louche', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'Choubanana', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:40:12.382424', [{'ingredient_id': '764a670f-da08-4f76-88f7-ab5b5b201f57', 'quantite': '4'}, {'ingredient_id': '426489ab-4ee0-43e6-bc8a-16a29fd242bb', 'quantite': '4'}, {'ingredient_id': '4f242dd7-aab5-480d-a0cb-c4f21fa0e642', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (41590, 'Réveil tonique kiwi banane', 'kiwi, banane, confiture de fraises', '5 min', ['Éplucher le kiwi et le couper en petits morceaux dans le bol. ', 'Peler la banane et la découper en rondelles et mettre aussi dans le bol. ', 'Écraser le tout avec une fourchette pour éliminer le plus de morceaux. ', 'Ajouter les 2 cuillères à soupe de confitures de fraises et mélanger.', 'A déguster tout de suite ou à placer au réfrigérateur 5 min pour plus de fraîcheur.'], ['Pince de cuisine', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'confiture de fraises', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Réveil tonique kiwi banane', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:40:15.931876', [{'ingredient_id': '3e58ebfb-db03-42d6-89ab-780b8b92cd23', 'quantite': '1'}, {'ingredient_id': '33c03820-e129-4660-9f9c-3a91407c8fe4', 'quantite': '1'}, {'ingredient_id': '86cca0b4-27b5-4468-93fe-d1118304c9ca', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (318786, 'Gâteau au yaourt et morceaux de banane', 'levure chimique, yaourt, huile, sucre, farine, oeuf, banane', '13 min', ['Préchauffez le four  à 180°C (thermostat 6).', 'Mélangez tous les ingrédients, sauf les bananes, dans un saladier.', 'Quand vous avez obtenu une pâte lisse et homogène, coupez 1 banane et 1/2 et mettez les morceaux dans le saladier avec la pâte. Gardez le reste de la demi banane.', 'Mélangez en faisant bien attention à ce que les morceaux de bananes ne se cassent pas.', 'Versez votre pâte dans un moule et faites cuire à 180°C (thermostat 6) pendant à peu près 30 min. Vérifiez que, en plantant votre couteau dans le gâteau, la lame en ressorte sèche. ', 'Si elle ressort sèche, c''est que votre gâteau est cuit !', 'Démoulez-le une fois refroidi ou laissez-le dans le moule. Reprenez le bout de banane qui vous restait. Coupez-le et mettez les morceaux sur le gâteau en guise de décoration.'], ['Mixeur', 'Planche à découper', 'Pince de cuisine', 'Spatule', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'Gâteau au yaourt et morceaux de banane', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:40:19.519949', [{'ingredient_id': '8f6b142e-d98c-433f-97ff-0d7bbf74d36e', 'quantite': '1'}, {'ingredient_id': '7aef733f-9543-4664-819f-4f11118a94cd', 'quantite': '250 g'}, {'ingredient_id': '29f54c23-c353-4b79-87d5-81ae33986f3f', 'quantite': '10 cl'}, {'ingredient_id': 'b0590095-9943-4c0a-b679-1aa151225df4', 'quantite': '335 g'}, {'ingredient_id': '7ce9ea19-d09b-41c8-87bc-19e927f98772', 'quantite': '350 g'}, {'ingredient_id': 'afb6a4fe-db1f-4eaa-82a3-cde1f3a20112', 'quantite': '3'}, {'ingredient_id': '57f510e5-a9fe-46fd-a495-deeb09bfd676', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530057, 'Banana bread vegan aux pépites de chocolat', 'lait d''avoine, huile végétale, pépites de chocolat, farine de blé, banane, amandes, levure chimique, amandes en poudre, sirop d''agave', '15 min', ['Commencez par préchauffer votre four à 175 °C (chaleur traditionnelle). Puis, écrasez les trois bananes à l''aide d''une fourchette. 
', 'Ajoutez le sirop d’agave, l’huile végétal et le lait végétal. Mélangez le tout.', 'Dans un saladier, mélangez la farine, la levure chimique, la poudre d’amandes et la fécule de maïs. Versez ensuite le mélange à base de bananes. 
', 'Ajoutez les pépites de chocolat et les amandes concassées. 
', 'Huilez un moule à cake et versez la pâte. Épluchez la dernière banane et coupez-la en deux dans la longueur. Déposez-la sur le gâteau en décoration.', 'Vous pouvez ajouter un peu d''amandes en décoration. 
', 'Pour finir, faites cuire au four pendant 35-40 minutes.'], ['Mixeur', 'Spatule', 'Planche à découper', 'Économe', 'Couteau de chef'], ['Banana bread vegan aux pépites de chocolat', 'amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'cakes', 'très facile', 'bon marché', 'amandes en poudre', 'sirop d''agave', 'plat', 'pépites de chocolat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'huile végétale', 'plat de résistance', 'farine de blé', 'lait d''avoine', 'cocktail'], 'Dessert', c88180ad-a956-44f6-b81c-cf19752f7ec6, '2025-09-26T16:40:23.128374', [{'ingredient_id': 'f2fdd928-d2ad-431e-9bff-660e8117cc4e', 'quantite': '100 ml'}, {'ingredient_id': '7d4ae1ed-0cae-48a9-b209-ec3e99f56b87', 'quantite': '100 ml'}, {'ingredient_id': '6effc107-24af-46a5-8b2c-d452827c2600', 'quantite': '70 g'}, {'ingredient_id': '43908566-08dc-44b2-b1a3-4697bfc24d77', 'quantite': '160 g'}, {'ingredient_id': 'c20289e0-74c5-4be3-ba01-9de837e8883f', 'quantite': '4'}, {'ingredient_id': 'cc534f00-181b-433a-950b-08cb667727a5', 'quantite': '40 g'}, {'ingredient_id': '4ffbde6b-9abe-4163-a448-ed5854c400ef', 'quantite': '8 g'}, {'ingredient_id': '4b040f0f-c204-443a-9c69-c14aa99f9538', 'quantite': '60 g'}, {'ingredient_id': 'c4312d12-9ddc-4ea7-bed4-72c5d4bacb62', 'quantite': '40 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17094, 'TOURTE AUX FRUITS', 'pâte feuilletée, banane, crème fraîche, cannelle', '15 min', ['Découper la pâte en 8 . ', 'Eplucher et couper en morceaux les fruits. ', 'Répartir les morceaux de fruits sur 4 morceaux de pâte. ', 'Ajouter la crème fraîche et la cannelle sur les fruits. ', 'Recouvrir avec les morceaux de pâte restant pour former un chausson. ', 'Mettre au four 180°C pendant 20 mn. Servir tiède.'], ['Moule à tarte', 'Économe', 'Louche', 'Presse-agrumes', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'TOURTE AUX FRUITS', 'pâte feuilletée', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:40:27.492590', [{'ingredient_id': '9452acb0-d9ba-4a31-8aa3-db9fab73e56b', 'quantite': ''}, {'ingredient_id': 'cd0adf68-4704-4edd-9cc6-7699080db492', 'quantite': ''}, {'ingredient_id': 'c4ec90cf-8e5e-47bd-94f5-b58dc6d2a691', 'quantite': '15 cl'}, {'ingredient_id': 'a410850a-6758-42bd-9856-b402c7e2c0e1', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (330547, 'Smoothie pomme banane gingembre', 'banane, pomme, gingembre, eau, citron, céleri branche', '10 min', ['Smoothie très rafraîchissant découvert par hasard.', 'Peler, éplucher et couper les fruits en gros morceaux, les mettre au blender (mixer) 1 à 2 minutes.', 'Servir dans des verres.'], ['Ouvre-boîte', 'Verre doseur', 'Planche à découper', 'Couteau de chef', 'Économe'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'céleri branche', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'Smoothie pomme banane gingembre', 'plat de résistance', 'pomme', 'citron', 'smoothies', 'cocktail'], 'Boisson', 6ff99feb-9e87-46bb-8b08-9c356aa5f615, '2025-09-26T16:40:31.061002', [{'ingredient_id': 'f228ed85-1f74-476d-8d18-47aa650d7b4b', 'quantite': '3'}, {'ingredient_id': '6f8b2037-dc12-4420-8c6d-11a5e803a3aa', 'quantite': '2'}, {'ingredient_id': '55f16a7c-2a65-48fc-a4df-2388001e81ee', 'quantite': '3'}, {'ingredient_id': '5df36775-2845-453c-a5cb-4142f486e93d', 'quantite': '40 cl'}, {'ingredient_id': '9b3faf55-bd6c-41d3-b843-343d6635c292', 'quantite': ''}, {'ingredient_id': '907600f6-677c-4e5d-a22f-0b836a4f78d0', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32499, 'Chèvre chaud aux miel et aux bananes', 'crottin de chèvre, banane, raisins secs, miel, huile, nouilles chinoises', '15 min', ['Mettre à cuire les nouilles. ', 'Mettre le miel dans un bol et les raisins dans un autre. ', 'Passer les crottins dans le miel puis dans les raisins. (Si vous n''arrivez pas à bien enduire les crottins de miel vous pouvez utiliser un pinceau). ', 'Faire chauffer l''huile dans une poêle (ou un wok) à feu moyen. Profitez-en pour couper les bananes en deux. ', 'Faire cuire les crottins environ 3 mn en surveillant. ', 'Mettre les bananes et retourner les crottins. Faire cuire 6 à 7 mn en retournant les bananes au bout de 3 mn. ', 'Servez en mettant les nouilles autour des crottins.'], ['Planche à découper', 'Poêle', 'Spatule', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Chèvre chaud aux miel et aux bananes', 'confiserie', 'testées', 'crottin de chèvre', 'facile', 'bon marché', 'nouilles chinoises', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'huile', 'dessert', 'plat de résistance', 'raisins secs', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:40:34.661047', [{'ingredient_id': 'b9bd0e73-d92d-4213-b439-e891839d5a45', 'quantite': '8'}, {'ingredient_id': '16d585fa-e32f-445e-96cf-19fd1872e257', 'quantite': '2'}, {'ingredient_id': 'ac02206a-a88b-4df0-b015-2c9fe21436d3', 'quantite': ''}, {'ingredient_id': 'e44e538d-1a2c-4a17-8a27-408cf8d20101', 'quantite': ''}, {'ingredient_id': 'a5dcf613-028c-436c-be77-c8d59a13a440', 'quantite': ''}, {'ingredient_id': 'b6a79f27-3750-48f1-a698-c7583899352b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (329657, 'Banana Tequilada (cocktail)', 'jus d''orange, Pisang, téquila, curaçao, lait, glaçons', '10 min', ['Placer les ingrédients dans un shaker avec 2 ou 3 glaçons.', 'Bien agiter jusqu''à ce que le mélange soit frais, et servir dans un verre à cocktail contenant des glaçons.'], ['Fouet', 'Économe', 'Ouvre-boîte', 'Verre doseur'], ['', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'Banana Tequilada (cocktail)', 'facile', 'téquila', 'Pisang', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'moyen', 'jus d''orange', 'lait', 'cocktail', 'curaçao'], 'Boisson', 9156d488-a1a4-4dd6-8728-0434c08ea5c7, '2025-09-26T16:40:39.184373', [{'ingredient_id': 'bef7ada1-58dc-435e-a5ae-249edf44600a', 'quantite': '10 cl'}, {'ingredient_id': '12dc05b2-7cf8-453b-be2e-526b65e25a69', 'quantite': '6 cl'}, {'ingredient_id': 'bd450cdf-4a6f-470a-832f-9c9956dc3cc0', 'quantite': '2 cl'}, {'ingredient_id': '65c73b45-3b0b-40a9-b6b8-8f93181d09ff', 'quantite': '1 cl'}, {'ingredient_id': '7d76bd4b-a9d3-4479-8e1d-ee2b5029267b', 'quantite': '1 cl'}, {'ingredient_id': '44271528-42c2-43ed-8b4e-a9b2cf9fc989', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (535051, 'Makis de crêpes chocolat, coco et banane flambée', 'citron vert, farine, lait, huile de pépin de raisin, oeuf, cacao en poudre, sucre, crème de coco, poudre de coco, chocolat blanc, rhum ambré, beurre, sucre roux, poudre de coco, banane', '20 min', ['Préparation pâte à crêpe blanche : mettre chaque ingrédient dans le bol du mixeur et mixer.', 'Préparation pâte à crêpe cacao : prélever environ un tiers de la pâte et y ajouter le cacao puis mixer.  Mettre cette pâte au cacao dans un récipient a sauce à fine ouverture ou dans une poche à douille.', 'Préparation pâte à tartiner chocolat coco : au bain marie, faire fondre le chocolat. Réchauffer la crème de coco dans le bain marie. L’ajouter au chocolat en remuant énergiquement pour bien l’incorporer. Enfin, ajouter la poudre de coco.', 'Réalisation des crêpes bicolores : sur feu moyen, faire chauffer une grande poêle à crêpes huilée. Couler la pâte à crêpe blanche et répartir sur toute la surface de la poêle. Quand elle commence à cuire, depuis le centre de la crêpe, réaliser une spirale où tout autre motif avec la pâte à crêpe cacao. Laisser cuire une minute puis retourner. Répéter l''opération pour les autres crêpes.', 'Préparation bananes flambées : dans une poêle sur feu moyen, faire fondre le beurre, puis ajouter le sucre et le jus du demi citron vert. Éplucher les bananes et les disposer dans la poêle. Les faire caraméliser dans la sauce en remuant délicatement et en les arrosant. Quand elles prennent une jolie couleur dorée, ajouter le rhum et faire flamber. Les arroser du jus. Les disposer sur une assiette et les rouler dans la poudre de coco.', 'Réalisation des makis : disposer une banane et demi sur le bord de la crêpe côté pâte à tartiner et rouler. Découper en tronçons et repartir sur un plat. Les makis sont prêts pour la dégustation.'], ['Moule à tarte', 'Casserole', 'Rouleau à pâtisserie'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'Makis de crêpes chocolat', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'crêpes sucrées', 'coco et banane flambée', 'citron vert', 'cocktail'], 'Dessert', d2575996-6b14-4484-a6fa-441393bb88d0, '2025-09-26T16:40:43.798624', [{'ingredient_id': '6c13b65e-c055-43b8-b100-82ad2b43a9be', 'quantite': ''}, {'ingredient_id': '46312ae4-9f44-42c6-8560-484d73a8fa35', 'quantite': '60 g'}, {'ingredient_id': 'b5df52f1-567b-4b0f-b1ae-9251d7ef4b2a', 'quantite': '125 ml'}, {'ingredient_id': '9cbd8c5a-db6a-4c15-ace5-32507fda9957', 'quantite': '13 g'}, {'ingredient_id': '202cc152-297b-4888-89b2-eda3726eaa70', 'quantite': '1'}, {'ingredient_id': '9ab84277-e7fa-4e07-8ac2-0561a54c433d', 'quantite': '2'}, {'ingredient_id': '392bfc11-7f6d-4cd9-a83d-d07036c1d52a', 'quantite': '1'}, {'ingredient_id': 'a04d97d2-b97c-4596-9bcc-c6bef5536107', 'quantite': '50 g'}, {'ingredient_id': '1fddbd39-6dab-42bd-a482-a485a88d89c2', 'quantite': '20 g'}, {'ingredient_id': 'b2e68ced-0ea9-4be0-9eff-24c352fc13d9', 'quantite': '100 g'}, {'ingredient_id': '75712700-0d05-4c5b-a781-7d54be6552a4', 'quantite': '12 cl'}, {'ingredient_id': '63d1b909-d1e7-43bb-822d-29c9e885cd2f', 'quantite': '20 g'}, {'ingredient_id': 'bc24b1cd-fee6-4a17-8258-704fc65e1007', 'quantite': '25 g'}, {'ingredient_id': '5c2974ca-e491-4e3f-bd30-944db8ec4964', 'quantite': '20 g'}, {'ingredient_id': '4bf8eddf-448e-4882-8eac-004bd8fb366f', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (219614, 'Dessert aux fruits et au chocolat en verrine', 'framboises, pomme, chocolat, beurre, kiwi, banane', '30 min', ['Peler et couper en petits morceaux les fruits sauf les framboises.', 'Mixer séparément les pommes, les kiwis et la banane.', 'Faire fondre le chocolat avec un petit peu de beurre.', 'Mettre dans chaque verrine un fond de chocolat fondu, puis le recouvrir de la "purée de banane", ensuite une seconde couche de chocolat fondu, puis de la "purée de kiwi", encore une couche de chocolat fondu et enfin la "purée de pomme".', 'Pour la décoration, mettre une framboise sur chaque dessus de verrine.'], ['Poêle', 'Verre doseur', 'Fouet', 'Pince de cuisine', 'Spatule'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'framboises', 'bon marché', 'rapide', 'Dessert aux fruits et au chocolat en verrine', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:40:47.396412', [{'ingredient_id': '9612eea1-56f9-4342-81c3-e6273f92ecf7', 'quantite': '4'}, {'ingredient_id': 'a35776a5-70b4-4348-bc1b-ba934988d083', 'quantite': '2'}, {'ingredient_id': '1de1aa48-d9b6-4837-84a4-439b37d9e0f0', 'quantite': '16'}, {'ingredient_id': 'd7dcefea-e425-41c4-a38e-b747155e08fb', 'quantite': ''}, {'ingredient_id': '0a6386a7-b7c7-48ea-a285-3197e3a0d946', 'quantite': '2'}, {'ingredient_id': '299e551b-53f6-4683-b881-81b957284b98', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40896, 'Pain de la saint martin', 'farine, banane, levure de boulanger, beurre, sucre roux, raisin, poudre de noisette, oeuf, lait, écorces d''oranges confites, quatre-épices, sel', '50 min', ['Faire chauffer le lait dans une casserole. Tamiser la farine dans un saladier faire une fontaine au milieu, effriter la levure de boulanger et verser le lait.', 'Pétrir le tout et laisser reposer 30 minutes dans un endroit chaud.', 'Incorporer le beurre, le sucre, le sel, 1 oeuf entier et 1 jaune.', 'Former un boule, recouvrer d''un linge et laisser doubler de volume.', 'Mettre les bananes à macérer dans le jus de raisin (environ 10 min). Egoutter.', 'Les mélanger avec les noissettes, l''écorce d''orange et les 4 épices.', 'Préchauffer le four à 200°C (thermostat 6-7).', 'Abaisser la pâte sur un plan de travail fariné en lui donnant une forme rectangulaire.', 'Puis déposer le rectangle sur une plaque à pâtisserie avec une feuille de papier sulfurisé dessous.', 'Recouvrir le milieu avec l''appareil à la banane.', 'Entailler la pâte débordante en diagonale afin de confectionner des croisillons en alternant droite et gauche.', 'Badigeonner de jaunes d''oeufs et laisser cuire 25 minutes. ', 'Déguster...'], ['Spatule', 'Mixeur', 'Fouet', 'Planche à découper'], ['', 'raisin', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'Pain de la saint martin', 'testées', 'facile', 'oeuf', 'plat', 'poudre de noisette', 'recette', 'cuisine', 'écorces d''oranges confites', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'quatre-épices', 'lait', 'levure de boulanger', 'cocktail', 'sucre roux'], 'Dessert', 845d49fe-29c6-4e07-ae87-408c6a9bfe4a, '2025-09-26T16:40:55.744400', [{'ingredient_id': '5d209008-9d29-46c7-b660-f195252bad61', 'quantite': '400 g'}, {'ingredient_id': '4e50937c-f2be-4fe9-aeb8-0ba398c33b6b', 'quantite': '200 g'}, {'ingredient_id': '958dbc04-ed49-4f44-9234-9b7adcece485', 'quantite': '30 g'}, {'ingredient_id': '23e4d7d6-b976-4795-8e84-95af3fec2f90', 'quantite': '70 g'}, {'ingredient_id': '4697dbd9-6bbc-4525-a173-7e932d99f9d3', 'quantite': '40 g'}, {'ingredient_id': '224522c1-bdb3-4feb-9572-ffdfc1233447', 'quantite': '13 cl'}, {'ingredient_id': 'd1fd0d7b-6042-45b8-ba59-a1d3677e1d5b', 'quantite': '80 g'}, {'ingredient_id': '5ba178c3-4462-44e8-8ffc-c1c7d540c5a1', 'quantite': '1'}, {'ingredient_id': '730ddf26-1e9d-4aa7-80e6-297c00d7ba01', 'quantite': '15 cl'}, {'ingredient_id': '06ecd543-c589-471c-abe2-5877b53f5d35', 'quantite': '50 g'}, {'ingredient_id': '431083ae-6557-405b-8e98-5d9341abc3ac', 'quantite': '1 cuillères'}, {'ingredient_id': 'bd043ce4-9143-43b5-a495-2836cc68d787', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52822, 'Mousse au chocolat sur compote de banane au grand marnier', 'banane, eau, sucre vanillé, grand-marnier, gingembre, chocolat pâtissier, beurre, sucre, oeuf', '40 min', ['Mettre le chocolat coupé en morceaux et le beurre à cuire au bain-marie. ', 'Pendant qu''il fond, préparer un sirop avec l''eau et le sucre vanillé. Puis, y ajouter les bananes coupées en rondelles et le gingembre râpé. ', 'Lorsque les bananes commencent à "compoter", ajouter le Grand marnier, et laisser cuire 10 min à feu doux avec un couvercle; réserver.', 'Dans un saladier, batter les jaunes d''œufs et le sucre. Puis, ajouter le chocolat fondu. ', 'Monter les blancs en neige et les incorporer au mélange chocolat.', 'Pour finir, remplir des verres aux 2/3 avec de la compote, er terminer avec 1/3 de mousse. Placer au réfrigérateur pendant 3 à 4 h.'], ['Pince de cuisine', 'Casserole', 'Poêle', 'Économe', 'Rouleau à pâtisserie'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'facile', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'moyen', 'grand-marnier', 'compote de banane', 'cocktail', 'Mousse au chocolat sur compote de banane au grand marnier'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:40:59.397830', [{'ingredient_id': 'd4414567-f620-4405-8790-3a80d816ddf1', 'quantite': '4'}, {'ingredient_id': '8c60b81d-5308-4c7e-81f5-cba1d36319cd', 'quantite': ''}, {'ingredient_id': '546ca1ef-6eff-4021-9300-632e83c04c0e', 'quantite': '1'}, {'ingredient_id': 'b2ba2ec2-244b-47b6-95e1-25d0b122a4ba', 'quantite': '4 cuillères'}, {'ingredient_id': '22e9edf6-8283-4db9-b4d5-965b71143141', 'quantite': '3 cuillères'}, {'ingredient_id': '0f629eb9-8ca1-4a82-b93b-abb7b119db0a', 'quantite': '100 g'}, {'ingredient_id': '2dbd79f0-eebf-4836-9835-2058c339b47d', 'quantite': '30 g'}, {'ingredient_id': 'f4b5bce1-058d-433a-b936-ef846f0d6c80', 'quantite': '60 g'}, {'ingredient_id': '66ac526f-fbea-4762-bd9c-3a7df9a50b53', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (44287, 'Salade de fruits chaude', 'sucre vanillé, vanille, rhum, mangue, orange, banane, citron', '20 min', ['Mélangez les jus, le sucre vanillé et la gousse de vanille préalablement fendue dans sa longueur ainsi que le rhum dans une casserole suffisamment grande pour contenir les fruits en suppléments.', 'Coupez les fruits en morceaux identiques et les incorporer au jus.', 'Couvrez et laissez macérer 2 à 3 heures dans un endroit frais(surtout pas au réfrigérateur).', 'Avant de servir faites chauffer à feu moyen pendant quelques minutes, en faisant attention à la préparation.', 'Retirez du feu lorsque le jus frémit.', 'Dressez l''assiette en y ajoutant pour les gourmandes 1 boule de glace à la vanille et 1 biscuit.'], ['Casserole', 'Pince de cuisine', 'Ouvre-boîte', 'Batteur électrique', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'sucre vanillé', 'moyen', 'citron', 'orange', 'Salade de fruits chaude', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:41:03.117937', [{'ingredient_id': 'f91b4c4e-e9f5-475d-9512-93f98489a216', 'quantite': '1'}, {'ingredient_id': '1e60ede1-f7ee-41cc-ae41-9ef0c2f7c175', 'quantite': '1'}, {'ingredient_id': '00940e19-7280-41d2-9462-f0278199ad60', 'quantite': '1 cuillères'}, {'ingredient_id': '1058857c-d5d9-4c64-b603-bb86eea163c8', 'quantite': '1'}, {'ingredient_id': 'a4f948a6-3211-459b-b873-03a54f3a57e4', 'quantite': '2'}, {'ingredient_id': '635d660a-30de-4a81-b351-e58e4c1c9b03', 'quantite': '1'}, {'ingredient_id': '81d7e5b0-3237-4792-a6f8-ab0149261277', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (174406, 'Chutney de banane', 'banane, vinaigre, sucre, gingembre, sel, épices', '135 min', ['Coupez les bananes en très petit morceaux. Faites mariner tous les ingrédients ensemble dans un saladier pendant environ 2 h.', 'Ensuite, faites cuire à feu très doux pendant assez longtemps (cela peut prendre deux bonnes heures de cuisson) en remuant régulièrement. ', 'Quand vous obtenez une consistance de marmelade/confiture, réduisez en purée les derniers morceaux de banane qui auraient résisté à la cuisson en remuant énergiquement à l''aide d''une spatule.', 'Versez immédiatement la préparation dans un bocal à confiture et une fois bien fermé, retournez-le et laissez le tout refroidir complètement, en général une bonne journée et c''est parfait !', 'Attention : cette recette est très sucrée, n''hésitez pas à enlever 100 g de sucre si vous cherchez des saveurs plus acides, et jouez avec les épices selon votre goût !'], ['Passoire', 'Râpe', 'Pince de cuisine', 'Presse-agrumes', 'Spatule'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'épices', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Chutney de banane', 'dessert', 'plat de résistance', 'sucre', 'vinaigre', 'cocktail'], 'Sauce', 074fe913-3b35-40dc-9fba-3a69de87ecd2, '2025-09-26T16:41:06.626854', [{'ingredient_id': '8ecd4c9d-72d9-4e0e-bbb7-34797a594013', 'quantite': '1 kg'}, {'ingredient_id': '471565a7-07e7-4c34-a608-e5b61af20183', 'quantite': '25 cl'}, {'ingredient_id': 'f62e9920-6e8b-4178-838e-fd240cae93e8', 'quantite': '300 g'}, {'ingredient_id': '32a81ada-a469-4ec8-ba3d-317e97c79e53', 'quantite': '1 cuillères'}, {'ingredient_id': '7656c17d-67bf-4a44-9b1a-a1886fb9501e', 'quantite': '1 cuillères'}, {'ingredient_id': '640aa526-c1f2-4ae1-959b-6ed1292ea400', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335279, 'Compote pomme banane au micro-ondes', 'pomme, banane', '5 min', ['Couper en petits morceaux les pommes et les bananes. ', 'Les disposer dans un plat creux. ', 'Faire cuire environ 10 min jusqu''à obtention de la consistance voulue au micro-onde en remuant régulièrement.'], ['Batteur électrique', 'Mixeur', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'compote de pomme', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Compote pomme banane au micro-ondes', 'dessert', 'plat de résistance', 'pomme', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:41:10.076397', [{'ingredient_id': '6534b7f4-6d39-473c-813f-a4767e345a61', 'quantite': '4'}, {'ingredient_id': 'aeb82fd9-5fec-44d5-80e9-bb451c97effa', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (229089, 'Sorbet exotique pamplemousse banane coco', 'pamplemousse, citron, banane, miel, noix de coco rapée', '15 min', ['Râper le zeste du citron dans un saladier, ajouter sa pulpe et celle du citron.', 'Couper la banane en morceaux et la mettre dans le saladier avec le reste des fruits. Ajouter le miel et la noix de coco avec 10 cl d''eau.', 'Mixer le tout et verser dans un bac à glace avant de le mettre au congélateur.'], ['Couteau de chef', 'Moule à tarte', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'Sorbet exotique pamplemousse banane coco', 'boisson', 'sorbet', 'noix de coco rapée', 'dessert', 'plat de résistance', 'pamplemousse', 'citron', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:41:14.918981', [{'ingredient_id': 'c1d5eb13-87fa-40d4-99c3-b4c0168e0ede', 'quantite': '1'}, {'ingredient_id': 'ca40b4da-011d-4a4d-bc5b-309a32cbcaf4', 'quantite': '1'}, {'ingredient_id': 'f4bba02d-e026-4b25-a073-f44f8562507d', 'quantite': '1'}, {'ingredient_id': '3bab13be-d084-4117-af8b-0f0a1fdb03c9', 'quantite': '4 cuillères'}, {'ingredient_id': '29f80e0c-4451-4ae7-80d8-e37483b318e0', 'quantite': '5 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30151, 'Crème de banane aux petits-suisses', 'petit suisse, banane, sucre, crème fraîche, kirsch', '10 min', ['Ecrasez les petits-suisses et les bananes puis mélangez au reste des ingrédients.', 'Répartissez la crème dans des coupes individuelles et conservez au frais jusqu''à la dégustation.', 'Accompagnez cette crème de biscuits secs.'], ['Fouet', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'petit suisse', 'testées', 'facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'sucre', 'kirsch', 'cocktail', 'Crème de banane aux petits-suisses'], 'Dessert', 1288a011-4ef8-46ce-bcec-8e726dbbb24b, '2025-09-26T16:41:18.512671', [{'ingredient_id': '99f9af13-e4c1-4f97-96c3-e185371685e3', 'quantite': '4'}, {'ingredient_id': '702ecbbb-7935-477e-8d33-3a9ccc76cd83', 'quantite': '3'}, {'ingredient_id': 'e33b2507-63a1-4b77-8f23-dfa7e336cd08', 'quantite': '3 cuillères'}, {'ingredient_id': '2e45f791-9e1b-45ff-a1ff-aa2f06b31217', 'quantite': '2 cuillères'}, {'ingredient_id': 'e56e3694-ada1-4420-82f0-6f8a27cba52c', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24644, 'Médaillons de cerf flambés', 'cerf, poivre, sel, beurre, cognac, banane, cerises, kirsch', '10 min', ['Dénoyauter les cerises, ou les mettre à égoutter s''il s''agit de cerises en boîte. ', 'Faire revenir au beurre les médaillons de cerf dans une grande poêle à frire à feu assez vif pendant 4 mn par côté environ. Les réserver au chaud sur un plat. Déposer le Cognac par gouttes parsemées sur les médaillons. ', 'Peler la banane et la couper en 4 . ', 'La faire cuire à feu doux avec les cerises, dans la poêle ayant servi à la viande. Ajouter une noisette des beurre. Faire mijoter 2 à 3 minutes (les fruits ne doivent pas tomber en compote). ', 'Pousser délicatement les fruits vers le bord en prenant bien garde de ne pas les écraser. Déposer les médaillons au centre. ', 'Dans une petite casserole à part, faire chauffer (sans porter à ébullition) le kirsch. Le verser rapidement sur la viande et faire flamber immédiatement.'], ['Moule à tarte', 'Verre doseur', 'Planche à découper', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'assez cher', 'très facile', 'cerf', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Médaillons de cerf flambés', 'beurre', 'poivre', 'gibier', 'kirsch', 'cognac', 'cocktail', 'cerises'], 'Plat principal', b32afcce-52d4-4dd6-b8d8-cc285a00a121, '2025-09-26T16:41:22.208564', [{'ingredient_id': '412e9563-5246-4538-bd13-029f6fdffc8f', 'quantite': '8'}, {'ingredient_id': '792f8e78-38ae-4fb2-a627-80f071e37ab3', 'quantite': ''}, {'ingredient_id': '1c8216ee-774e-4fb4-9571-cf0de0ec2e15', 'quantite': ''}, {'ingredient_id': 'd3bc3bc9-7bc6-4758-8e99-c173d2f2628a', 'quantite': ''}, {'ingredient_id': 'e2290530-a94b-4b64-a2af-8000112090c4', 'quantite': '2 cuillères'}, {'ingredient_id': '4cf2898d-8401-48d3-9d11-3ec19c39e073', 'quantite': '1'}, {'ingredient_id': '93ba41d5-b5b9-4b8b-b726-2cd6e5db6d49', 'quantite': '1'}, {'ingredient_id': 'ad9271da-705d-4868-8c72-2cc6569e3124', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14774, 'Salade de fruits antillaise', 'melon, pastèque, pomme, banane, fruit de la passion, abricot, ananas, sirop de sucre de canne, cannelle', '30 min', ['Coupez tous les fruits en petits morceaux dans un saladier. Ajoutez le fruit de la passion.', 'Mouillez avec le sirop des ananas en boîte et rajoutez du sirop de sucre de canne à la vanille jusqu''à la hauteur des fruits.', 'Ajoutez une pincée de cannelle et remuez.'], ['Spatule', 'Batteur électrique', 'Louche', 'Ouvre-boîte'], ['', 'melon', 'sirop de sucre de canne', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'abricot', 'très facile', 'Salade de fruits antillaise', 'pastèque', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'fruit de la passion', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'ananas', 'cannelle', 'cocktail'], 'Dessert', da2e6123-c561-4867-97cf-e454e0b107e7, '2025-09-26T16:41:25.632700', [{'ingredient_id': 'b453fb7b-9c3c-4b20-8148-8200e247eb59', 'quantite': '1'}, {'ingredient_id': '29f49660-ffc5-4db0-a919-230655157628', 'quantite': ''}, {'ingredient_id': 'cb290967-f16c-43f0-9ea2-cdfe669c5bc7', 'quantite': '1'}, {'ingredient_id': '02cd93e4-8d37-49b3-b874-54d0149f3d5d', 'quantite': '2'}, {'ingredient_id': 'c2d25e42-d3ad-4291-a395-053f026f213e', 'quantite': '1'}, {'ingredient_id': '3a067a81-f9ee-4b8c-b2f4-2b48a4534980', 'quantite': '1'}, {'ingredient_id': '029a21fd-868b-4c8f-8791-45b40f990eee', 'quantite': '1'}, {'ingredient_id': '25f77a03-efa2-4ea3-a04e-0628140949d8', 'quantite': ''}, {'ingredient_id': '96477ba2-d813-48b0-a216-3fa11a8194fb', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46325, 'Salade de fruits frais et secs', 'pomme, poire, banane, orange, mangue, grenade, litchi, framboises, fruits secs, sirop, cardamome', '25 min', ['Epluchez et coupez en dés pommes et poires, en rondelles la banane. ', 'Coupez en 2 ou 3 les quartiers d''orange ou de clémentine, en dés la mangue, en 2 les litchis (ou longans).', 'Egrenez la moitié d''une grenade (la totalité si c''est une petite). Coupez en 3-4 morceaux les fruits secs de grosse taille (figues, dattes, abricots, poires).', 'Mettez tous vos fruits dans un  saladier, sans oublier les framboises. Mélangez bien.', 'Arrosez de sirop léger (celui des litchis par exemple s''ils sont en boîte) et saupoudrez de cardamome. ', 'Laissez reposer au moins 20 minutes au frais (en général on la prépare avant le repas donc elle a le temps), de façon à ce que la framboise colore d''un jus rose léger l''ensemble de la salade et que les fruits secs absorbent du jus pour devenir plus tendres.', 'Pensez à sortir la salade du réfrigérateur 5-10 minutes à l''avance pour qu''elle ne soir pas trop froide sous la dent.', 'Servez tel quel ou avec une glace à la vanille.'], ['Pince de cuisine', 'Ouvre-boîte'], ['entrée', 'salade de fruits originale', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'framboises', 'cardamome', 'rapide', 'plat', 'mangue', 'fruits secs', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'Salade de fruits frais et secs', 'moyen', 'orange', 'sirop', 'litchi', 'cocktail', 'grenade'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:41:29.248390', [{'ingredient_id': '66fe2bd1-3e2f-45e6-94f4-9e15749128d5', 'quantite': '2'}, {'ingredient_id': '7386a12c-c08a-4719-8113-ba60398ecd9e', 'quantite': '2'}, {'ingredient_id': '49c76d56-8234-4862-82bd-852266a7741d', 'quantite': '1'}, {'ingredient_id': '00776bcb-dacc-4e40-b00c-0caf65dfb096', 'quantite': '1'}, {'ingredient_id': 'd1f1b853-dc85-4bea-9ec4-f1101670a902', 'quantite': '1'}, {'ingredient_id': '6a0bc944-ebc0-4f03-816a-841068c5fcb8', 'quantite': ''}, {'ingredient_id': 'e6c6149a-288e-452a-ba6f-7b24c6ce33cd', 'quantite': '200 g'}, {'ingredient_id': 'ba65108d-0c4c-4e46-8fcf-69cdd27af0d9', 'quantite': '150 g'}, {'ingredient_id': '425ee5ea-f858-4a2a-9cb0-a12ae0db1061', 'quantite': '2'}, {'ingredient_id': 'eb872c02-5536-4637-b28f-12550a4e88e7', 'quantite': '4 cuillères'}, {'ingredient_id': '5eeae432-0db8-4010-b357-d4baa0540f00', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (41723, 'Tarte banane framboises', 'pâte sablée, framboises, banane, oeuf, crème, sucre', '15 min', ['Etaler la pâte dans un moule à tarte.', 'Découper les bananes en rondelles, et recouvrir la pâte.', 'Eparpiller les framboises sur les bananes. Saupoudrer les framboises de sucre.', 'Préparer la garniture en melangeant les oeufs, le sucre, et la crème.', 'Verser sur les fruits.', 'Mettre au four 45 min, à 200°C (thermostat 6-7)... Verifier la cuisson!', 'Attendre que la tarte soit froide pour la manger.'], ['Passoire', 'Fouet', 'Balance de cuisine', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Tarte banane framboises', 'testées', 'très facile', 'framboises', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'tarte à la banane', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', 147c5b45-de20-4aec-85db-756324fd177c, '2025-09-26T16:41:35.100562', [{'ingredient_id': 'b49fef66-6c63-4851-8fbc-d4f4688efe2b', 'quantite': '1'}, {'ingredient_id': '6ac0825d-323c-4a41-b966-94303b900439', 'quantite': '200 g'}, {'ingredient_id': 'f1463217-389d-4952-be3c-9b6aa9e8871c', 'quantite': '2'}, {'ingredient_id': '1f50af1d-b90c-4a00-aeed-4217994469ee', 'quantite': '2'}, {'ingredient_id': 'a1cfd51a-98db-4e33-8d01-a74f0f037a76', 'quantite': '40 cl'}, {'ingredient_id': '74c596d4-998d-4aca-92a5-7b54a7b35b10', 'quantite': '120 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28265, 'Brioche aux fruits et fondue aux chocolats', 'brioche, lait, beurre, cacao, sucre semoule, sel, pomme, banane, kiwi, fraises', '15 min', ['Faire bouillir le lait, puis mettre sucre, cacao, beurre coupé en dés, sel. Porter à ébullition et laisser mijoter pendant 15 à 20 mn à feu réduit et remuer de temps en temps. ', 'Vider l’intérieur des brioches avec un couteau pour le tour puis une petite cuillère pour le milieu, ne pas trop gratter. ', 'Faire des petites brochettes de fruits avec pommes, bananes, ananas, kiwis, fraises etc.... ', 'Environ 4 brochettes par personne. 1 grande brochette = 2 petites en les cassant. ', 'Préchauffer le four puis mettre les brioches pendant 3 mn pour qu’elles sèchent un peu et soient chaudes. Mais il ne faut pas qu’elles changent de couleur. ', 'Verser la sauce chocolat qui doit être onctueuse et bien chaude, il faut que la sauce enrobe bien une petite cuillère. Bien garnir les brioches de sauce mais pas à ras-bord. ', 'Servir les brioches pleines de chocolat chaud dans une assiette, et mettre autour les brochettes de fruits. ', 'Et bon appétit.'], ['Couteau de chef', 'Poêle', 'Pince de cuisine', 'Spatule'], ['brioche', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'cacao', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'autres brioches', 'beurre', 'lait', 'Brioche aux fruits et fondue aux chocolats', 'cocktail'], 'Dessert', 85409162-3c1a-4d68-8952-e811ed2c7a8b, '2025-09-26T16:41:38.885030', [{'ingredient_id': '183a217a-d2d0-4259-a294-dc94614a2004', 'quantite': '4'}, {'ingredient_id': 'c8f72efb-fd50-49de-a5e5-2ba7d547be8e', 'quantite': '1.25 l'}, {'ingredient_id': 'e76153e6-ba26-4813-b280-d77b24c18492', 'quantite': '300 g'}, {'ingredient_id': 'dfbe1293-2577-40e5-b69a-3858c4b56231', 'quantite': '125 g'}, {'ingredient_id': 'a812ef9e-5c75-417a-8415-7882ea176592', 'quantite': '250 g'}, {'ingredient_id': 'a5403bed-95ce-4918-b577-9e660463c85a', 'quantite': '1'}, {'ingredient_id': 'bd50e72f-25e7-488d-8d4e-f8a4340db07b', 'quantite': ''}, {'ingredient_id': '0a8b4ad6-bfed-4375-9e9c-a909be297d44', 'quantite': ''}, {'ingredient_id': '9dfc1b19-43a1-463f-ae8f-de00ade35527', 'quantite': ''}, {'ingredient_id': 'b1dc8e63-b637-4bc5-89ca-492b15ccd052', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (340774, 'Jus banane raisin', 'banane, raisin noir, jus de citron, sirop d''érable, eau', '25 min', ['Commencer par couper la banane grossièrement dans votre saladier. Enlever la peau et les pépins des raisins puis les mettre avec les bananes, verser le sirop d''étable (ou le sucre) avec vos fruits puis mixer le tout en ajoutant l''eau au fur et à mesure. Finir par le jus de citron pour relever les saveurs.'], ['Ouvre-boîte', 'Batteur électrique', 'Passoire', 'Spatule', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'Jus banane raisin', 'très facile', 'sirop d''érable', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'raisin noir', 'cocktail'], 'Boisson', 25244e5d-49dd-4166-977f-4ac162ea971a, '2025-09-26T16:41:42.404454', [{'ingredient_id': '69717375-07e5-4398-9cd0-7c2570f3eda7', 'quantite': '1'}, {'ingredient_id': '6b116f6e-56d8-4925-b329-f793a806f9ab', 'quantite': '1'}, {'ingredient_id': '25e2e513-e831-445a-b2c3-9e3a0332fc66', 'quantite': '1 cuillères'}, {'ingredient_id': '3931a2df-42a2-4e1a-a3dc-523b200eab66', 'quantite': '3 cuillères'}, {'ingredient_id': 'f2e3e623-a7a5-44cd-a455-82904a2f8167', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (92594, 'Moelleux  Banane-chocolat', 'farine, beurre demi-sel, banane, oeuf, sucre, amandes, levure chimique, chocolat noir', '15 min', ['Écrasez les bananes dans une assiette à la fourchette. Dans un récipient mettre le sucre et le mélangez avec le beurre puis ajoutez les œufs, puis les bananes, la farine, la levure et la poudre d’amende. Puis incorporez le chocolat (ou les pépites). Ajoutez des amandes entière si vous voulez puis enfournez à 180 degrés pendant 40 minutes.'], ['Moule à tarte', 'Couteau de chef', 'Planche à découper', 'Économe'], ['amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'Moelleux  Banane-chocolat', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'beurre demi-sel', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'gâteau au chocolat', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:41:46.948356', [{'ingredient_id': '96dce9ae-d269-4853-8491-3dcd555967af', 'quantite': '150 g'}, {'ingredient_id': 'd154c15e-0dbe-4dea-9d5a-a842de4a74f3', 'quantite': '140 g'}, {'ingredient_id': '2e854dcf-3a83-489a-a766-22fbb3187526', 'quantite': '3'}, {'ingredient_id': '2ae38d6c-bf77-43d9-9c5c-fc54b4e4cdaf', 'quantite': '3'}, {'ingredient_id': 'da431a25-accf-400c-bf55-b2e135f93c1b', 'quantite': '80 g'}, {'ingredient_id': '7dea2b03-9f94-400f-b13f-70d8860d797f', 'quantite': '100 g'}, {'ingredient_id': '0e243dac-e334-4e94-94e8-86595cc55611', 'quantite': '1'}, {'ingredient_id': '163c33a8-1b3e-4a0f-8f0a-98e13548369e', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29060, 'Tarte aux bananes', 'pâte feuilletée, banane, crème, farine, jaune d''oeuf, sucre, rhum, sucre glace, marmelade d''abricot', '30 min', ['Préchauffez le four à 180°C (thermostat).', 'Etalez la pâte dans un moule à tarte et faites cuire à blanc 15 minutes. ', 'Saupoudrez le fond de la tarte de 50 g de sucre semoule. ', 'Coupez la moitié des bananes en rondelles et écrasez l''autre moitié. ', 'Mélangez la crème, le reste de sucre, les trois jaunes d''oeufs, la farine et 4 cl de rhum. Battez bien. Incorporez la purée de bananes et nappez-en le fond de tarte. Disposez dessus les rondelles de bananes restantes.', 'Délayez la marmelade d''abricots avec le reste de rhum et nappez-en le dessus de la tarte.', 'Enfournez pour 20 minutes de cuisson. Saupoudrez de sucre glace puis passez 2 minutes sous le gril du four.'], ['Verre doseur', 'Couteau de chef', 'Tire-bouchon', 'Économe', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'marmelade d''abricot', 'Tarte aux bananes', 'plat', 'tarte à la banane', 'jaune d''oeuf', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'pâte feuilletée', 'moyen', 'sucre glace', 'sucre', 'cocktail'], 'Dessert', d846a03b-0d02-48a9-af8e-0cc8dc90e233, '2025-09-26T16:41:50.420655', [{'ingredient_id': '5e2836b8-e1ff-4264-a31b-efad710d3e29', 'quantite': '200 g'}, {'ingredient_id': 'df50618f-5008-4070-95c3-1ab18b093cd1', 'quantite': '6'}, {'ingredient_id': 'e6d0df1a-697e-464d-930f-b3d54068f931', 'quantite': '10 cl'}, {'ingredient_id': '42167cf5-f6d0-4717-a9e9-33c0c0d0eacc', 'quantite': '2 cuillères'}, {'ingredient_id': '35424888-3acd-4316-9709-a89e46c70443', 'quantite': '3'}, {'ingredient_id': 'da2b83ad-3616-4786-bc41-474dc7b0fc60', 'quantite': '150 g'}, {'ingredient_id': '6ec18913-1b63-46b0-bfb8-fec44d54e6a6', 'quantite': '5 cl'}, {'ingredient_id': 'cb722826-41f7-45f3-b29b-89dfadb344eb', 'quantite': '2 cuillères'}, {'ingredient_id': 'c330521d-16e4-44a8-b71f-94568051de9f', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36627, 'Tarte tatin à la banane épicée', 'farine, beurre, sel, eau, banane, sucre en morceaux, gingembre, cannelle', '40 min', ['Faites la pâte brisée : dans un saladier, mettez les 4 ingrédients, puis mélangez rapidement et formez une boule. Gardez au réfrigérateur le temps de préparer le reste (30 minutes, c''est l''idéal!).', 'Préchauffez le four à 200° c (th 6-7).', 'Préparez le caramel dans une petite casserole en versant sur les morceaux de sucre quelques gouttes d''eau pour les humecter légèrement. Portez à ébullition sans remuer et laissez caraméliser. ', 'Une fois le caramel doré (mais pas trop foncé pour éviter l''amertume), versez-le dans un moule à manqué en faisant tourner le moule dans vos mains pour le répandre sur toute la surface.', 'Pelez et coupez les bananes en deux dans la longueur.', 'Déposez les bananes uniformément sur le caramel et saupoudrez le tout de cannelle et de gingembre.', 'Etalez la pâte brisée au rouleau en farinant le plan de travail si besoin. Recouvrez les bananes de la pâte brisée, rentrez les bords vers l''intérieur à l''aide de vos doigts et faites quelques trous dans la pâte à l''aide de la pointe d''un couteau.', 'Enfournez. Laissez cuire environ 30 minutes.', 'Retirez du four, laissez reposer 2 minutes et démoulez. ', 'Servez tiède ou froid.'], ['Ouvre-boîte', 'Balance de cuisine', 'Couteau de chef', 'Batteur électrique'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'tarte Tatin', 'farine', 'dessert', 'plat de résistance', 'beurre', 'cocktail', 'Tarte tatin à la banane épicée'], 'Dessert', 69297d9d-1a59-4225-aa7e-6ff0da85dc1e, '2025-09-26T16:41:55.215140', [{'ingredient_id': 'e81bea14-dee2-4d1d-b484-8255806f2a8d', 'quantite': '125 g'}, {'ingredient_id': '280f0a8a-8899-46ad-8bc9-53db111c9c37', 'quantite': '60 g'}, {'ingredient_id': 'db93b9a9-4bfd-4cf2-b339-98e7c9ce23e2', 'quantite': '1'}, {'ingredient_id': '43e3a5c1-e13e-4802-a18d-053ec3cf8621', 'quantite': '2.5 cl'}, {'ingredient_id': 'b84b3af7-6d63-40d7-8f18-ab6180104243', 'quantite': '3'}, {'ingredient_id': '62272a11-3a0e-43fe-82e0-369aa749d004', 'quantite': '80 g'}, {'ingredient_id': 'c8a72402-40e6-43b9-ac0c-38eca731c668', 'quantite': ''}, {'ingredient_id': 'd6fc3100-4c55-4c5a-9132-6ecb4e8ed021', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336859, 'Trovi ya nadzi (banane aux coco) recettes Mahoraise', 'banane, lait de coco, viande, sel', '20 min', ['Il faut commencer par couper la viande en petit morceau puis la faire cuire dans de l''eau et beaucoup de sel. ', 'Pendant que la viande et en train de cuire, éplucher les 18 bananes, les couper en 4, puis les rincer et les mettre dans une grande marmite. ', 'Une fois la viande prête l''ajouter dans la marmite à bananes, bien étaler, ajouter un tiers d''eau et laisser quelques minutes jusqu''à ce  qu''il n''y ait plus beaucoup d''eau.  ', 'Verser ensuite le lait de coco dans la marmite, laisser mijoter, vérifier si c''est bien salé, couvrir puis laisser mijoter pendant quelques minutes . ', 'Servir dans une grande assiette.'], ['Économe', 'Ouvre-boîte', 'Mixeur', 'Couteau de chef', 'Planche à découper'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'Trovi ya nadzi (banane aux coco) recettes Mahoraise', 'sel', 'confiserie', 'testées', 'facile', 'viande', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:42:00.306235', [{'ingredient_id': 'a66c6428-d5fc-41ef-bcc0-83a8eeaa39a7', 'quantite': '18'}, {'ingredient_id': '6119134b-4062-4615-9daf-e22c561628a8', 'quantite': '4 l'}, {'ingredient_id': '81a3fb3e-039b-4868-a0db-95f6ecd0615d', 'quantite': '1 kg'}, {'ingredient_id': 'fe8e69dc-14d7-4eac-a950-c66bcd3b296b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21900, 'Bananes aux raisins flambées au rhum', 'banane, orange, raisins secs, rhum, cassonade, sucre vanillé, beurre', '10 min', ['Faites tremper les raisins dans le rhum.', 'Epluchez les bananes, coupez-les en deux dans la longueur. ', 'Faites chauffer le beurre dans une poêle, faites-y dorer les bananes sur chaque face.', 'Saupoudrez des sucres, ajoutez les raisins secs égouttés. Versez le jus d''orange et le rhum et portez à ébullition.', 'Flambez et servez. '], ['Ouvre-boîte', 'Passoire', 'Poêle', 'Râpe', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'cassonade', 'facile', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'moyen', 'beurre', 'orange', 'raisins secs', 'Bananes aux raisins flambées au rhum', 'cocktail'], 'Dessert', fd0961f3-5e3d-4208-850d-e5dd9eb790ed, '2025-09-26T16:42:04.064207', [{'ingredient_id': '302898dc-d283-47fc-96b9-9521829731bb', 'quantite': '4'}, {'ingredient_id': '165d7da9-4f18-486b-a11c-d5bc5545e5db', 'quantite': '1'}, {'ingredient_id': '113560b5-a6ca-45a3-80a0-bb7921557505', 'quantite': '100 g'}, {'ingredient_id': '8031a9da-8481-4747-a44e-7469b317eb33', 'quantite': '10 cl'}, {'ingredient_id': '44b6f933-ab81-499b-a56c-6028d2d87949', 'quantite': '2 cuillères'}, {'ingredient_id': '966fbb13-8ef3-447a-9b99-3c5f064e642d', 'quantite': '1'}, {'ingredient_id': 'a5dc972a-6d26-498f-9f2a-7a2f8df5028c', 'quantite': '30 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166301, 'Verrine compote et spéculoos', 'pomme, banane, spéculoos, fromage blanc', '20 min', ['Écraser les spéculoos', 'Mettre la poudre de spéculoos au fond de chaque verrine (environ 2-3 spéculoos par verrine)', 'Mettre le fromage blanc par dessus la poudre de spéculoos (jusqu''à la moitié de la verrine)', 'Couper les pommes et les bananes en petits dés dans un plat.', 'Faire cuire les fruits au micro-ondes jusqu''à obtention d''une compote.', 'Rajouter la compote aux verrines ', 'Pour la décoration rajouter un spéculoos coupé en deux et une tranche de bananes au dessus de la compote.'], ['Tire-bouchon', 'Ouvre-boîte', 'Presse-agrumes'], ['Verrine compote et spéculoos', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'speculoos', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'pomme', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:42:07.539317', [{'ingredient_id': 'edc1e08e-8878-488d-b06c-0789f2fd2e67', 'quantite': '4'}, {'ingredient_id': 'ca47bfc7-b203-4bb1-bcb3-1b1e44284db4', 'quantite': '2'}, {'ingredient_id': '7c7feed2-7439-4cad-b146-18405eb51682', 'quantite': '12'}, {'ingredient_id': '69608f9d-e821-4f1f-9dff-4daeb75b408d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (371879, 'Pancakes healthy', 'oeuf, banane, flocons d''avoine, boisson aux amandes, levure', '0 min', ['Dans un saladier, mélanger les flocons d''avoine, la levure, l''oeuf et la banane bien mûre écrasé.', 'Ajouter la boisson aux amandes et bien mélanger.', '(Si vous avez le temps, laissez reposer 30 minutes à 1h.)', 'Cuire les pancakes dans une poêle bien chaude avec un peu d''huile ou de beurre. Cuire environ 2 minutes de chaque côté.'], ['Tire-bouchon', 'Planche à découper'], ['entrée', 'banane', 'boisson aux amandes', 'recettes de cuisine', 'confiserie', 'testées', 'pancake', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'levure', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Pancakes healthy', 'flocons d''avoine', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:42:12.459830', [{'ingredient_id': '0626c534-2f36-4f1b-9c53-838a6419b7b4', 'quantite': '1'}, {'ingredient_id': '7450e536-1114-4d03-b933-82ad9a7aa3d1', 'quantite': '1'}, {'ingredient_id': '94dc7624-ec61-4cf4-8ea3-21431d5fab39', 'quantite': '70 g'}, {'ingredient_id': '6ce79f54-ef7f-446e-b12d-e6366ae15683', 'quantite': '2 cuillères'}, {'ingredient_id': 'f3895499-733d-4b62-b735-ddf842c42ae0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (344279, 'Banane, chocolat à tartiner, fluff et chantilly', 'chocolat à tartiner, banane, fluff, crème chantilly', '5 min', ['Éplucher la banane, puis la couper en rondelles.', 'Mettre le fluff dans le fond d''un bol.', 'Déposer les rondelles de bananes sur le fluff.', 'Recouvrir de chocolat à tartinée ou du nutella.', 'Mettre de la chantilly par dessus et régalez-vous.'], ['Louche', 'Râpe', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'fluff', 'fluff et chantilly', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'chocolat à tartiner', 'boisson', 'crème chantilly', 'Banane', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e5afd8de-d612-4eac-9ef9-648e57549941, '2025-09-26T16:42:18.854318', [{'ingredient_id': 'b797adbd-55c8-4162-a00b-26f77c52e95c', 'quantite': '1 cuillères'}, {'ingredient_id': '2f7af7a2-ee39-4fca-8003-f3e27ceeb410', 'quantite': '1'}, {'ingredient_id': '9917051a-2344-49c6-9b03-9c77d09c94d4', 'quantite': '1 cuillères'}, {'ingredient_id': 'd0c33f43-0b66-49eb-9186-8a629847f8ba', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (167371, 'Fondue de fruits au chocolat', 'chocolat noir, lait, poire, pomme, banane, kiwi, mandarine, ananas', '20 min', ['Egouttez l''ananas et coupez-le.', 'Epluchez les autres fruits et coupez-les en morceaux moyens.', 'Mélangez-les et répartisez-les dans 4 coupelles.', 'Dans une casserole, à feu très doux, laissez tiédir le lait.', 'Puis ajoutez le chocolat coupé en petits morceaux.', 'Mélangez au fouet jusqu''à obtention d''une crème onctueuse.', 'Servez immédiatement à table.', 'Chacun trempe les fruits dans le chocolat à l''aide de brochettes ou de piques en bois.'], ['Verre doseur', 'Pince de cuisine', 'Économe', 'Passoire'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'facile', 'mandarine', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Fondue de fruits au chocolat', 'dessert', 'plat de résistance', 'chocolat noir', 'pomme', 'ananas', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:42:24.282141', [{'ingredient_id': 'f7b40861-4c5e-4de1-a374-35ce28c87a57', 'quantite': '200 g'}, {'ingredient_id': 'b1b6434a-371a-47af-ae58-27685f963aa5', 'quantite': '1'}, {'ingredient_id': 'd4bb353c-14fb-4a84-a933-8a2a04123836', 'quantite': '2'}, {'ingredient_id': '35f0b360-0962-4593-95af-d80ea6bb0f73', 'quantite': '2'}, {'ingredient_id': '19d54553-ac36-4866-a592-d778477508b6', 'quantite': '2'}, {'ingredient_id': '63231691-6ccb-42d2-b11e-a7c333ab5aea', 'quantite': '2'}, {'ingredient_id': '3b25ddec-049f-4625-8326-c4b2223d2437', 'quantite': '2'}, {'ingredient_id': 'f281b615-53d1-42cf-afc6-57307e19f3df', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (223532, 'Beignets de bananes plantain de Pati', 'banane plantain, sucre vanillé, farine, huile de friture', '15 min', ['Éplucher les bananes et bien les écraser.', 'Y ajouter le sucre vanille et incorporer en mélangeant entre chaque cuillerée la farine.', 'Bien malaxer le tout afin d''obtenir une consistance assez homogène.', 'Confectionner de petites boulettes et faire frire.', 'A déguster chaud ou froid.'], ['Tire-bouchon', 'Balance de cuisine', 'Mixeur', 'Couteau de chef'], ['entrée', 'recettes de cuisine', 'beignets salés', 'confiserie', 'testées', 'huile de friture', 'facile', 'bon marché', 'plat', 'Beignets de bananes plantain de Pati', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'banane plantain', 'sucre vanillé', 'cocktail'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:42:27.743479', [{'ingredient_id': '7e02758a-a424-415c-b1f5-a70b400c4ec9', 'quantite': '4'}, {'ingredient_id': '4d66cf37-296c-4db3-b780-8174645eded8', 'quantite': '1'}, {'ingredient_id': '11d94e74-c120-425b-914a-4e5d18987ed0', 'quantite': '5 cuillères'}, {'ingredient_id': '00cd0e5f-1588-4d10-a8db-9d61c2d39130', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36422, 'Mousse banane et kiwi', 'banane, crème fraîche épaisse, blanc d''oeuf, sel, sucre, kiwi, menthe', '5 min', ['Mixer les bananes avec la crème fraîche.', 'Battre les blancs en neige et les incorporer à la préparation.', 'Peler les kiwis et les couper en rondelles, puis chaque rondelle en 4 morceaux.', 'Remplir les verres avec la mousse, puis ajouter les kiwis. ', 'Décorer avec la feuille de menthe.', 'Vous pouvez varier en remplaçant les kiwi par des fruits rouges ou autres, suivant ce que vous avez dans votre frigo (framboises, fraises, etc.).'], ['Spatule', 'Poêle', 'Râpe', 'Balance de cuisine'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'crème fraîche épaisse', 'sel', 'confiserie', 'testées', 'très facile', 'menthe', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Mousse banane et kiwi', 'dessert', 'plat de résistance', 'mousse fruits', 'sucre', 'blanc d''oeuf', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:42:34.495897', [{'ingredient_id': '4a2ee651-0782-466a-8b0f-02a9b2463dbf', 'quantite': '3'}, {'ingredient_id': 'a3501f60-86d8-493e-afc4-afa2642fdc9c', 'quantite': '10 cl'}, {'ingredient_id': '21437c94-854f-43db-ac3a-92dc1059839c', 'quantite': '2'}, {'ingredient_id': 'dadfa5aa-7573-456c-b741-2a9a14ff6ce3', 'quantite': '1'}, {'ingredient_id': '7fb1afae-e718-48b3-80d8-98e2e3062b4b', 'quantite': '2 cuillères'}, {'ingredient_id': 'ecf06af7-f6b9-41bc-a3aa-3f75fe76934b', 'quantite': '4'}, {'ingredient_id': '43abcbe3-ff37-4125-85de-edb03939801d', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (221062, 'Compote pomme, banane, orange', 'pomme, banane, orange, vanille, cassonade', '10 min', ['Peler et couper les pommes et les bananes en morceaux.  ', 'Fendre la gousse de vanille afin d''en extraire les graines. ', 'Presser les oranges. ', 'Mettre les fruits, la vanille, le jus des oranges et la cassonade dans une casserole.', 'Faire cuire à feu doux pendant environ 15 min (les fruits doivent être fondants).', 'Écraser à l''aide d''un presse-purée si vous aimez les morceaux ou passer au mixer.', 'Vous pouvez déguster la compote tiède ou froide.'], ['Pince de cuisine', 'Tire-bouchon', 'Casserole', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'Compote pomme', 'confiserie', 'testées', 'cassonade', 'facile', 'compote de pomme', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'pomme', 'orange', 'cocktail'], 'Dessert', 795cbc01-6457-428d-a884-f761e2efe095, '2025-09-26T16:42:38.081479', [{'ingredient_id': 'e481f12a-68dc-4ef0-b703-c32c9f5654f7', 'quantite': '3'}, {'ingredient_id': 'c64d3a48-0ef9-4a36-b807-a06f7a579155', 'quantite': '2'}, {'ingredient_id': '19178c91-ff50-439c-b705-aa4661f2b2b5', 'quantite': '2'}, {'ingredient_id': 'a7b8d079-063d-4e66-ada8-3ec4e0d46253', 'quantite': '1'}, {'ingredient_id': '86c98eeb-8939-47e7-8cc8-8b53cea91d2c', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (537979, 'Cake moelleux banane chocolat au Thermomix', 'farine, levure, sucre roux, sucre vanillé, banane, beurre doux, pépites de chocolat', '10 min', ['Ajoutez le sucre roux, le sucre vanillé, le beurre ramolli dans le bol du Thermomix. Fermez avec le couvercle et lancez 1 minute en vitesse 4. Ajoutez l’œuf via l’ouverture du couvercle. Mélangez 30 secondes supplémentaires en vitesse 4.', 'Pelez les bananes et coupez-les en rondelles. Ajoutez-les dans le bol du Thermomix. Mélangez 30 secondes en vitesse 5.', 'Mélangez et tamisez la farine avec la levure. Ajoutez dans le bol du Thermomix. Mélangez 20 secondes en vitesse 5. Versez les pépites de chocolat. Lancez le Thermomix en sens inverse, vitesse 3 durant 30 secondes.', 'Transvasez cet appareil dans un moule à cake légèrement graissé. Mettez à cuire 45 minutes dans un four préalablement chauffé à 180°C. Laissez tiédir avant de démouler.'], ['Planche à découper', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'pépites de chocolat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'Cake moelleux banane chocolat au Thermomix', 'plat de résistance', 'sucre vanillé', 'beurre doux', 'cocktail', 'sucre roux'], 'Dessert', 2247cab4-4d10-4cd7-b718-46759e63791b, '2025-09-26T16:42:43.017940', [{'ingredient_id': '701ec66e-b62e-4c93-9548-e53e0a87346f', 'quantite': '110 g'}, {'ingredient_id': 'fbcd5f33-3d4b-4709-9d68-9465d3a701f8', 'quantite': '1'}, {'ingredient_id': '9f9929d9-fa0f-4c8b-8115-35583bb993ab', 'quantite': '50 g'}, {'ingredient_id': 'd8c480bc-4019-4be9-98e8-71912bff1530', 'quantite': '1'}, {'ingredient_id': '2aaa7888-6aba-4e4d-96f3-42292744155b', 'quantite': '2'}, {'ingredient_id': 'cf28c121-b729-4f37-8ad4-0bc443c00827', 'quantite': '50 g'}, {'ingredient_id': '8b261c50-757b-40ec-aeef-d2d0ff82809a', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (212252, 'Clafoutis bananes et fraises', 'farine, sucre, oeuf, lait, beurre, banane, fraises', '15 min', ['Préchauffez le four à 180°C (thermostat 6).', 'Mélangez la farine, le sucre, les œufs, le lait et le beurre fondu.', 'Au fond d''un plat beurré, mettre les bananes coupées en rondelles et les fraises et verser la préparation dessus.', 'Enfournez pendant 30 à 40 minutes.'], ['Moule à tarte', 'Balance de cuisine', 'Spatule', 'Économe', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'Clafoutis bananes et fraises', 'oeuf', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'clafoutis', 'moyen', 'beurre', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:42:46.571468', [{'ingredient_id': '5aa683c1-05df-40a3-8246-ff792c090143', 'quantite': '90 g'}, {'ingredient_id': 'c4827722-a7f5-4c72-907e-91e65ccab839', 'quantite': '80 g'}, {'ingredient_id': '688d6f93-b5a1-441c-ab19-1c474f0c2379', 'quantite': '3'}, {'ingredient_id': 'dc9462a6-c597-4935-8c73-f612c0a614d6', 'quantite': '25 cl'}, {'ingredient_id': '7c00e728-047c-46bb-a2de-e0c125bb95e9', 'quantite': '60 g'}, {'ingredient_id': '2df2aa3c-20bf-4950-8088-acc79749b713', 'quantite': '3'}, {'ingredient_id': '679824fa-9eeb-4b76-ba7e-7fe1b053e7b0', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (219199, 'Verrine fromage blanc, pomme, banane et spéculoos', 'banane, pomme, fromage blanc, spéculoos, sucre, vanille, citron', '15 min', ['Peler les pommes et les découper en morceaux. ', 'Faire chauffer une casserole et y jeter les morceaux de pommes.', 'Ajouter ensuite une cuillère à soupe d''eau pour qu''elles n''accrochent pas.', 'Incorporer les graines de la gousse de vanille et un peu de sucre puis couvrir.', 'Ne pas trop remuer pour conserver les morceaux de pommes entiers. Retirer du feu dès qu''ils sont mous et caramélisés.', 'Pendant ce temps, découper la banane en rondelles (pas trop fines).', 'Les tremper dans le jus de citron puis les mettre à rôtir dans une poêle. Ajouter un peu de sucre. ', 'A mi-cuisson, retourner délicatement une à une les rondelles de bananes sans les écraser. Retirer du feu dès qu''elles sont caramélisées.', 'Effriter ensuite les 5 spéculoos avec les doigts puis réserver.', 'Remplir les verrines d''une 1ère couche de fromage blanc. Ajouter une bonne couche de bananes. Etendre une couche de fromage blanc. Ajouter une bonne couche de pommes et terminer par les spéculoos écrasés.', 'Laisser au frais jusqu''au service.'], ['Passoire', 'Louche', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'speculoos', 'boisson', 'fromage blanc', 'vanille', 'Verrine fromage blanc', 'dessert', 'banane et spéculoos', 'plat de résistance', 'pomme', 'citron', 'sucre', 'cocktail'], 'Dessert', dd2aa2ad-bba1-413b-ac8a-a279b207e50b, '2025-09-26T16:42:50.087992', [{'ingredient_id': '408ee330-aa81-44d6-9f75-05f4e208913b', 'quantite': '2'}, {'ingredient_id': '13b187ef-0cc4-41d6-b036-d272cd17ad45', 'quantite': '2'}, {'ingredient_id': '81e4e6ca-015f-433e-ab0b-8ebe2f72eb6b', 'quantite': '250 g'}, {'ingredient_id': '1f2a4e85-057c-463f-9d9a-37bd3c3abcba', 'quantite': '5'}, {'ingredient_id': '266d2f22-0ea9-4756-a933-a090f506527f', 'quantite': '1 cuillères'}, {'ingredient_id': 'ab17fd8a-c64e-4ac1-859f-e5b17cbf0cca', 'quantite': ''}, {'ingredient_id': 'd03e892d-6821-476a-9357-b19305b1d193', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11296, 'Curry de poulet aux fruits verts', 'poulet, pomme, banane, curry, yaourt, citron, oignon, huile d''arachide', '20 min', ['Lavez le citron et râpez son zeste au-dessus d''un saladier dans lequel vous aurez préalablement mis les morceaux de poulet.', 'Coupez le citron en 2, pressez-le et ajoutez son jus dans le saladier. Mélangez et laissez reposer 30mn.', 'Pelez les oignons et hachez-les. Versez le yaourt dans un bol et lissez-le à la fourchette. Pelez pomme et banane. Retirez le coeur de la pomme. Coupez la pulpe des 2 fruits en petits cubes.', 'Egouttez les morceaux de poulet et épongez les. Faites chauffer l''huile dans une sauteuse anti-adhésive et faites-y dorer les morceaux de poulet 10 min, en remuant sans cesse avec une spatule. Retirez les de la sauteuse, mettez-y oignons, pomme et banane et mélangez 2 min. Poudrez de curry et remuez 1 min.', 'Ajoutez le yaourt et les morceaux de poulet. Mélangez. Couvrez, laissez cuire 45 min, à feu doux et à demi-couvert.', 'Au bout de ce temps, retirez les morceaux de poulet de la sauteuse. Versez la sauce dans le bol d''un robot et mixez 1 min, jusqu''à obtention d''une sauce lisse et veloutée. Versez la sauce dans la sauteuse, ajoutez les morceaux de poulet et réchauffez-les 2 min à feu doux.'], ['Tire-bouchon', 'Économe', 'Louche', 'Balance de cuisine'], ['poulet', 'banane', 'huile d''arachide', 'entrée', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'curry de poulet', 'plat', 'moyenne', 'Curry de poulet aux fruits verts', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'citron', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:42:53.726781', [{'ingredient_id': 'db849d24-3b50-43b6-aae9-098c82a973b8', 'quantite': '1'}, {'ingredient_id': '220195b6-a0ba-473a-bb69-10efa8293c73', 'quantite': '1'}, {'ingredient_id': 'adcf7530-7080-4f06-9436-30e8d4c0566c', 'quantite': '1'}, {'ingredient_id': 'd875f0c9-0096-4b18-a01d-acb7f9bc7528', 'quantite': '2 cuillères'}, {'ingredient_id': '0b766646-e45b-4e45-a1ed-cd183abaa797', 'quantite': '3'}, {'ingredient_id': '8028646b-d9d0-4449-87e2-89ba356c2f57', 'quantite': '1'}, {'ingredient_id': 'e7e9b342-40b9-4f01-b88b-36521d3b2cfb', 'quantite': '2'}, {'ingredient_id': '4a67c434-834b-459e-9033-68755b24becc', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530279, 'Brownoffee', 'beurre, farine, mascarpone, levure chimique, cacao amer, crème fleurette, chocolat, banane, fleur de sel, caramel au beurre salé, oeuf, sucre roux, crème de whisky (baileys)', '30 min', ['Préchauffer le four à 180°C. Faire fondre le chocolat en morceaux et le beurre au bain-marie. ', 'Dans un saladier, fouetter les oeufs et le sucre jusqu’à ce que le mélange blanchisse. Ajouter le beurre et chocolat fondu et mélanger. ', 'Ajouter ensuite les poudres tamisées et une pincée de fleur de sel. ', 'Mélanger puis verser la préparation dans votre moule. Cuire 15min.', 'Une fois refroidi, garnir d''une fine couche de caramel puis de rondelles de banane. ', 'Fouetter en chantilly la crème, la mascarpone et le Baileys. Etaler joliment sur le bronwie et déguster sans attendre.'], ['Mixeur', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'cacao amer', 'confiserie', 'testées', 'levure chimique', 'chocolat', 'crème fleurette', 'facile', 'gâteau', 'crème de whisky (baileys)', 'oeuf', 'plat', 'caramel au beurre salé', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'fleur de sel', 'plat de résistance', 'Brownoffee', 'moyen', 'beurre', 'cocktail', 'sucre roux'], 'Dessert', ddb2fd3c-624e-4082-be0d-2f154b27d2ba, '2025-09-26T16:42:58.298894', [{'ingredient_id': '1bbd0b11-f6db-4158-9e8e-54cdcf994892', 'quantite': '100 g'}, {'ingredient_id': 'e8a4828d-bec1-4d3f-b2e0-90ffb6c4a745', 'quantite': '100 g'}, {'ingredient_id': 'b444dce3-eb54-41ea-ba0e-b359610627f1', 'quantite': '1 cuillères'}, {'ingredient_id': 'bd710592-c95e-493c-8cfe-263df6a9dcab', 'quantite': ''}, {'ingredient_id': '5cf108f7-129b-42df-946a-9d1041aa118e', 'quantite': '20 g'}, {'ingredient_id': '0d0f7bb2-2af1-4f10-b960-9135b7715a7b', 'quantite': '250 ml'}, {'ingredient_id': 'c4b7aec9-10d4-4dd7-a5f3-f534acd389b7', 'quantite': '165 g'}, {'ingredient_id': '04a43c0d-a6b2-4bcd-a63a-e71e09c64db2', 'quantite': '1'}, {'ingredient_id': 'd7c2466b-664c-4177-acd5-1218daeac504', 'quantite': '1'}, {'ingredient_id': '35864ccb-7861-4264-95d7-88d38e3fb629', 'quantite': '4 cuillères'}, {'ingredient_id': '64493f41-865e-48ad-9b5e-65bbb21c7ae0', 'quantite': '2'}, {'ingredient_id': '6ef8770c-fbc2-412c-a973-26b62ac311c3', 'quantite': '170 g'}, {'ingredient_id': '77749d01-b55b-44fb-81b0-7752d623f57c', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (309594, 'Crème dessert à la banane et à la poire', 'banane, poire, petit suisse, crème, sucre, sucre en poudre, jus de citron, sirop de sucre de canne, Liqueur', '20 min', ['A préparer environs 3 heure à l''avance.', 'Écraser les bananes à la fourchette avec le jus de citron. Ajouter les petits suisses et le sucre (en poudre et gélifiant).', 'Mélanger la préparation au fouet.', 'Incorporer le sirop de sucre de canne et la liqueur de banane.', 'Ajouter la crème. ', 'Battre ou mixer la préparation encore quelques instant.', 'Peler les poires et les couper en très petits dés. Les mélanger au reste de la préparation.', 'Mettre le tout au réfrigérateur pendant environ 3 heures.'], ['Couteau de chef', 'Planche à découper', 'Pince de cuisine'], ['sirop de sucre de canne', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'petit suisse', 'testées', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'crème', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'Crème dessert à la banane et à la poire', 'dessert', 'plat de résistance', 'jus de citron', 'Liqueur', 'sucre', 'cocktail', 'crème dessert'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:43:04.205933', [{'ingredient_id': '8f6efeb8-f8bd-4d21-925b-84d926678989', 'quantite': '3'}, {'ingredient_id': '730fa06b-1cb8-4385-a965-ee45d6fb1259', 'quantite': '2'}, {'ingredient_id': 'db258d16-0da9-4886-b130-ca0fb0efe0c8', 'quantite': '4'}, {'ingredient_id': 'bba8e2a9-a1d5-4936-b315-8b7862f1c4ce', 'quantite': '2 cuillères'}, {'ingredient_id': '679d4643-7101-4b97-a88e-830e3b01d26a', 'quantite': '3 cuillères'}, {'ingredient_id': 'a05d3dd7-bb6d-4077-b12c-8f53652074a5', 'quantite': '1 cuillères'}, {'ingredient_id': 'e3c3ec94-4f9f-4ece-a9a8-8a9251b4f2ef', 'quantite': '1 cuillères'}, {'ingredient_id': '6b11a862-bdd1-46a7-b89a-8ac69153317d', 'quantite': '5 cl'}, {'ingredient_id': '141916f1-dc5a-4b6b-962b-8784d81d4c62', 'quantite': '2 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (35716, 'Délice de poulet à la banane', 'escalope de poulet, banane, lait de coco', '30 min', ['Découper vos escalopes de poulet en morceaux d''environ 3 cm de côté. ', 'Faire préchauffer une poêle beurrée et y introduire les morceaux de poulet. Quand la viande commence à dorer, ajouter le lait de coco et la moitié de vos bananes préalablement coupées en rondelles assez épaisses. ', 'Laisser réchauffer le tout 5 mn à feu moyen, mélanger régulièrement pour faire fondre les bananes et assaisonner à votre goût (sel poivre et eventuellement piment en poudre). ', 'Ensuite ajouter les rondelles de bananes restantes et servir immédiatement.'], ['Pince de cuisine', 'Économe'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'escalope de poulet', 'recette', 'Délice de poulet à la banane', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:43:07.956744', [{'ingredient_id': '267bc5b3-9568-4476-9289-e28476f60076', 'quantite': '4'}, {'ingredient_id': '949add78-1b7e-4628-85a7-95abb4f6d76c', 'quantite': '4'}, {'ingredient_id': '36f0c320-b144-411c-b7bf-e922225e4a19', 'quantite': '500 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528828, 'Tarte à la banane de Clara', 'pâte feuilletée, banane, crème fraîche, oeuf, lait, rhum, cannelle, noix de coco rapée', '20 min', ['Préchauffer le four à 170°C.', 'Dans un saladier, écraser 2 bananes afin de les réduire en purée.', 'Ajouter la crème fraîche, l''oeuf battu, le lait et le rhum. Bien mélanger jusqu''à obtenir une préparation homogène.', 'Etaler la pâte feuilletée dans un moule à tarte puis verser la préparation dessus.', 'Couper les 2 bananes restantes en rondelles puis les déposer sur la tarte.', 'Saupoudrer de noix de coco et de cannelle Enfourner pour 45 minutes environ.
Se déguste tiède. Bon appétit !'], ['Casserole', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'confiserie', 'testées', 'facile', 'Tarte à la banane de Clara', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'pâte feuilletée', 'cannelle', 'lait', 'cocktail'], 'Dessert', bd10a2af-5113-44c6-9b2b-8a9a0f2c2bf4, '2025-09-26T16:43:13.255852', [{'ingredient_id': '714b3fbf-a882-4c71-9c7b-66f6be7fe5d7', 'quantite': '1'}, {'ingredient_id': 'a941e91e-6a0c-4356-9081-c344e3cc3fc5', 'quantite': '4'}, {'ingredient_id': 'a437c8d8-6953-4c4d-ae7f-25dbf3a45c70', 'quantite': '15 cl'}, {'ingredient_id': '52f337b1-2d08-4eaf-9a16-c3a5c420e414', 'quantite': '1'}, {'ingredient_id': 'd6192ff5-1b8b-4a28-ba7c-ace156405db3', 'quantite': '300 ml'}, {'ingredient_id': '90e7a2bc-5c81-4255-8588-29d4c4dba382', 'quantite': '1 cuillères'}, {'ingredient_id': '57ac94ed-8c8e-4a5a-8b9b-2fcae7afe6fa', 'quantite': ''}, {'ingredient_id': '48d7f8be-6bc1-4da8-9f7c-73d89de8eedf', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (531388, 'Smoothie banane, pêche et abricot', 'pêche, abricot, banane, lait, glaçons', '7 min', ['Mixer la banane et un demi abricot avec quatre glaçons et une demi cuillère à soupe de lait.', 'Ajouter le reste des abricots et la pêche dénoyautées avec les 4 autres glaçons et le lait. Mixer le tout.'], ['Ouvre-boîte', 'Verre doseur', 'Mixeur', 'Presse-agrumes', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'abricot', 'très facile', 'bon marché', 'pêche et abricot', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'pêche', 'lait', 'Smoothie banane', 'cocktail'], 'Boisson', ba1bd0fb-22a4-43be-8b62-0a8d64349d26, '2025-09-26T16:43:16.879399', [{'ingredient_id': '6bbf181e-a64c-465d-b50b-c14a152c0b5b', 'quantite': '1'}, {'ingredient_id': 'f1e94e19-26df-446b-9830-c71ace35d7d6', 'quantite': '1.5'}, {'ingredient_id': 'e58bae48-fe6d-4811-b810-6e0d484e57f5', 'quantite': '1'}, {'ingredient_id': 'aeb46f8c-674f-4928-b67b-68a85d27e840', 'quantite': '1.5 cuillères'}, {'ingredient_id': '6a3666ed-b0d4-479d-8300-d44ee6a3d1bd', 'quantite': '8'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (93368, 'Purée de bananes vertes (ti-nains)', 'banane, lait, beurre, gruyère râpé, oignon, petit piment, persil, pieds, citron, thym, sel, muscade, ail', '30 min', ['Lavez et épluchez les bananes dans de l''eau citronnée. Faites-les cuire dans de l''eau légèrement salée. Lorsque les bananes sont cuites, égouttez et écrasez à la fourchette ou au moulin à légumes. <BR> Dans une poêle, mettez un filet d''huile d''olive, et faîtes revenir les oignons émincés, le persil , la cive, l''ail, le tout hâché, le thym effeuillé . Poivrez et mettez une grosse pincée de noix de muscade. Mettez , ainsi que le piment doux préalablement finement haché. <BR> Faites fondre le beurre dans le lait chaud dans 1 grande casserole et incorporez-le progressivement à votre purée de bananes vertes. <BR> Ajoutez le contenu de la poele; Mélangez le tout et verser dans un plat.Recouvrez de fromage râpé. Placez le tout au four. Retirez-le lorsque c''est bien doré !'], ['Couteau de chef', 'Rouleau à pâtisserie', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'petit piment', 'testées', 'Purée de bananes vertes (ti-nains)', 'muscade', 'très facile', 'bon marché', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'gruyère râpé', 'dessert', 'persil', 'plat de résistance', 'citron', 'thym', 'beurre', 'purée', 'lait', 'cocktail', 'pieds'], 'Accompagnement', 6733f12c-da1d-42bf-8ed2-561e6d3cb1ab, '2025-09-26T16:43:20.772718', [{'ingredient_id': '8f837705-0269-497a-a7ef-910634b8f761', 'quantite': '8'}, {'ingredient_id': '2d57fbc8-55e0-4423-80e2-007f69a0d84a', 'quantite': '30 cl'}, {'ingredient_id': '487cdec9-49e7-45ee-83e3-138a0e497140', 'quantite': '100 g'}, {'ingredient_id': '5d079a4c-c3bd-4b82-ab09-7e0fe4f0bb71', 'quantite': '100 g'}, {'ingredient_id': '045ec920-6af1-408e-91bd-bb8b1652ab4c', 'quantite': '2'}, {'ingredient_id': 'e6efc4e9-edcc-4de5-966f-1a8f4cbe077b', 'quantite': '1'}, {'ingredient_id': '7768e454-7f0e-4d59-831e-68baa8f25bef', 'quantite': '2'}, {'ingredient_id': 'd07d798b-4077-4e47-845f-481ca061cc96', 'quantite': '3'}, {'ingredient_id': '7c83f811-4777-41e9-9466-7b23578aa6c0', 'quantite': '1'}, {'ingredient_id': '036ae47b-ea86-47d8-9e3e-da283e1aec04', 'quantite': ''}, {'ingredient_id': '2544f12a-d598-46ab-ac61-c0cddaf4fec1', 'quantite': ''}, {'ingredient_id': '40f403ea-25ef-46c6-b7f4-42064b11e0a1', 'quantite': ''}, {'ingredient_id': 'cde54031-82af-4c6b-9ef2-0a14b9d6282b', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392470, 'Pain suédois, crème d''amande et chocolat de Pierre Augé', 'petit pain suédois, beurre, sucre semoule, vanille, oeuf, amandes en poudre, farine, citron, banane, chocolat noir, fleur de sel, amandes', '12 min', ['Préchauffer le four à 180 degrés (thermostat 6).', 'Mélanger le beurre et le sucre dans un cul de poule jusqu’à obtenir une pâte bien blanche.', 'Ajouter l’œuf entier et bien mélanger.', 'Une fois bien incorporé, ajouter la poudre d’amande et la farine qui va venir stabiliser la crème à la cuisson.', 'Râper le zeste du citron dans la préparation.', 'Venir napper le pain de la crème, 1 cm d’épaisseur environ', 'Découper la banane en rondelles régulières, légèrement en biais.
Déposer les morceaux de banane sur la crème.', 'Enfourner pour 7 min de cuisson.', 'La crème va gonfler et les bananes vont dorer
Concasser les morceaux de chocolat pour en faire des gros copeaux
Ajouter une petite pincée de fleur de sel sur le dessus et les quelques bâtonnets d’amandes.'], ['Louche', 'Ouvre-boîte', 'Planche à découper', 'Presse-agrumes'], ['amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'amandes en poudre', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'Pain suédois', 'farine', 'vanille', 'dessert', 'fleur de sel', 'plat de résistance', 'crème d''amande et chocolat de Pierre Augé', 'chocolat noir', 'moyen', 'citron', 'beurre', 'petit pain suédois', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:43:26.731333', [{'ingredient_id': '15dadc75-19f8-46eb-8659-22932f617afe', 'quantite': '1'}, {'ingredient_id': 'fb2e910e-4f4e-4d70-a7b4-788a42b15d8d', 'quantite': '50 g'}, {'ingredient_id': '6ddbfc84-2a8e-463c-9471-d1df4305310d', 'quantite': '50 g'}, {'ingredient_id': '4c0c3efd-ef02-49bf-a9e9-0da0e5848601', 'quantite': '1'}, {'ingredient_id': '036473e3-a6b6-473b-93af-b11a344cd992', 'quantite': '1'}, {'ingredient_id': 'd23f903d-b745-4290-ad6b-e65df091864a', 'quantite': '50 g'}, {'ingredient_id': 'd9c5e589-cbe4-42c4-9e27-f3b1ea3ace6b', 'quantite': '25 g'}, {'ingredient_id': 'a5fcd9a9-9753-4742-9fa7-bfff2a68e530', 'quantite': '1'}, {'ingredient_id': '310a2201-87c9-4a54-9492-65c033dfc2fd', 'quantite': '1'}, {'ingredient_id': '793b2385-e7a3-4ae9-b359-3e465566f9d5', 'quantite': ''}, {'ingredient_id': '4ee55d8e-9008-4b8a-9b73-9c1b8d3112f8', 'quantite': '1'}, {'ingredient_id': 'df13b91a-616b-47ef-8393-dd551a3051b9', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21279, 'Croustillants de banane au gingembre', 'banane, brick, gingembre, sucre en poudre, beurre', '10 min', ['Eplucher les bananes. Les couper en deux, puis fendre chaque morceau en deux dans le sens de la longueur.', 'Faire fondre le beurre à feu doux dans une sauteuse. Déposer les bananes dans le beurre bien chaud et saupoudrer de sucre. Laisser caraméliser deux minutes de part et d''autre. Les bananes doivent garder leur tenue. Retirer du feu. ', 'Etaler chaque feuille de brick sur le plan de travail et la diviser en 4. Y répartir le gingembre râpé. Poser un morceau de banane sur la pointe d''un quartier de feuille de brick et l''enrouler comme un nem. Au besoin, coller le rabat de pâte avec un peu de beurre de cuisson des bananes. Répéter l''opération avec le reste des bananes. ', 'Remettre la sauteuse sur feu moyen, en rajoutant un peu de beurre si nécessaire. Faire dorer les bananes emmaillotées dans le beurre bien chaud. ', 'Servir sans attendre.'], ['Ouvre-boîte', 'Tire-bouchon', 'Balance de cuisine', 'Rouleau à pâtisserie'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'cocktail', 'Croustillants de banane au gingembre'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:43:30.487593', [{'ingredient_id': '4feee926-8515-4609-8a0f-91934ec02b07', 'quantite': '4'}, {'ingredient_id': '774f2ba1-4252-4fe4-a4c6-9dc19df5781b', 'quantite': '4'}, {'ingredient_id': '82ec04c3-3df0-4e73-8133-2798d3a50090', 'quantite': ''}, {'ingredient_id': '9cb4ad9e-491f-4619-9bcd-0072e541fe8e', 'quantite': '4 cuillères'}, {'ingredient_id': '38425a0b-ba64-4282-9f95-04c043f506f9', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20904, 'Gâteau à la banane facile', 'banane, sucre, beurre, farine, oeuf, levure', '15 min', ['Faire ramollir le beurre et le battre avec le sucre.', 'Ecraser les trois bananes et les ajouter à la préparation précédente. ', 'Incorporer ensuite la farine, les oeufs et la levure.', 'Mettre la préparation dans un moule à gâteau beurré et mettre au four Th 7/8. ', 'Laisser cuire 30 à 40 mn.'], ['Économe', 'Louche', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'Gâteau à la banane facile', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'beurre', 'sucre', 'cocktail'], 'Dessert', 13eca722-8d5d-4e46-980c-d4a831cb6419, '2025-09-26T16:43:35.319392', [{'ingredient_id': '5ccdb533-fb5d-432f-9e19-d2ec6e52d39e', 'quantite': '3'}, {'ingredient_id': '1206e50a-2f6f-4e24-8b02-dba7d09e42ac', 'quantite': '200 g'}, {'ingredient_id': '5bbc803b-57d6-4730-bd99-2d3221c5125e', 'quantite': '200 g'}, {'ingredient_id': '5a7b61d9-8585-47f7-918f-678a789ed853', 'quantite': '250 g'}, {'ingredient_id': 'c62656c6-b8de-4b64-a580-b348f7416890', 'quantite': '3'}, {'ingredient_id': 'e4515a03-b0df-4e8c-8ddd-9dfb6b422d7f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18319, 'Tarte à la banane facile (sans beurre)', 'banane, oeuf, sucre, pâte feuilletée', '15 min', ['Mettre les bananes dans un mixeur avec le sucre et les jaunes d''oeuf. ', 'Mixer. ', 'Monter les blancs en neige ferme. ', 'Incorporer les blancs à la préparation. ', 'Mettre la mousse de banane sur la pâte. ', 'Enfourner à 210° pendant 20 à 30 min, la tarte doit avoir une couleur brunâtre. ', 'Bon appétit.'], ['Moule à tarte', 'Balance de cuisine', 'Tire-bouchon', 'Batteur électrique'], ['Tarte à la banane facile (sans beurre)', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'sucre', 'cocktail'], 'Dessert', bce8d101-ceb0-4c7b-b294-d7686d7eee67, '2025-09-26T16:43:39.088814', [{'ingredient_id': 'c8452f7d-e41f-433f-95fb-c04b80706216', 'quantite': '3'}, {'ingredient_id': '48eb1d6d-11e9-4b1b-95f3-02d274f66c5b', 'quantite': '3'}, {'ingredient_id': '1d247eda-8313-4f34-80aa-9bceb573d350', 'quantite': '80 g'}, {'ingredient_id': '9459a571-c8d7-4d18-a1ca-7e034d74f2b7', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27673, 'Curry de riz aux fruits', 'riz, beurre, bouillon de volaille, oignon, ail, céleri, pomme, banane, raisins secs, citron, crème fraîche, yaourt, curry, poivre, sel', '40 min', ['Faites tremper les raisins secs dans de l''eau chaude.', 'Hachez l''oignon, l''ail, le céleri et la pomme.', 'Faites-les blondir dans une cocotte dans le beurre chaud.', 'Ajoutez le riz, le curry, du sel et du poivre.', 'Remuez, laissez le riz devenir transparent et versez le bouillon chaud.', 'Couvrez et laissez cuire 15 minutes.', 'Ajoutez alors les raisins secs, la banane coupée en rondelles et laissez cuire encore 10 min.', 'Mélangez très délicatement en ajoutant le jus du 1/2 citron et la crème fraîche puis servez.', 'On peut saupoudrer de noix de coco ou d''amandes effilées grillées avant de servir.'], ['Passoire', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'yaourt', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'ail', 'plat', 'bouillon de volaille', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'plat de riz', 'dessert', 'plat de résistance', 'riz', 'pomme', 'citron', 'beurre', 'Curry de riz aux fruits', 'raisins secs', 'poivre', 'curry', 'cocktail', 'céleri'], 'Plat principal', e51a0ba2-c614-4910-a1bb-664affd7fb3a, '2025-09-26T16:43:42.771120', [{'ingredient_id': 'a0c3f8b5-7bb0-4667-9b90-c8235e8b984d', 'quantite': '400 g'}, {'ingredient_id': '2732f85a-f14a-466a-8295-b8f448786995', 'quantite': '80 g'}, {'ingredient_id': 'cb67065a-2617-4ab5-b836-5a74cff95ada', 'quantite': '75 cl'}, {'ingredient_id': '2e7b35b0-cf8b-45b3-b25b-29f29c792ebd', 'quantite': '1'}, {'ingredient_id': '71803efb-440c-42ee-90cd-2e10cf0f9c26', 'quantite': ''}, {'ingredient_id': '7f7e4691-8c4c-4ec1-b7ed-ea52516a780e', 'quantite': '1'}, {'ingredient_id': '9d133d4a-89ac-4445-b126-1bbd0ff05df6', 'quantite': ''}, {'ingredient_id': '70341faf-9608-409d-85ae-b4996830e91a', 'quantite': '1'}, {'ingredient_id': '85632392-8c45-406a-8e55-6223c516c3f1', 'quantite': '2 cuillères'}, {'ingredient_id': 'bd0222af-c7c0-4b64-962f-3af8c33f74f8', 'quantite': ''}, {'ingredient_id': 'a0467f8d-c186-4943-9e31-35a4f6ad0d38', 'quantite': '3 cuillères'}, {'ingredient_id': '88ab1409-9ff7-4366-a1f9-ad08fa242141', 'quantite': ''}, {'ingredient_id': 'e3551a47-38a5-4d93-9c37-bbcab34d9fe0', 'quantite': '2 cuillères'}, {'ingredient_id': '587af00b-df77-4199-8ffd-656238fba63e', 'quantite': ''}, {'ingredient_id': '76843658-c07a-4364-b3db-b2bb7c19a02c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (229284, 'Mousse aux fruits et au tofu', 'tofu soyeux, pêche, fruits rouges, banane, sucre, blanc d''oeuf, biscuits à la cuillère, lait', '15 min', ['Mettre le tofu soyeux, le sucre et les fruits dénoyautés et pelés dans un mixeur/blendeur. Mixer jusqu''à obtenir un mélange crémeux. Réserver dans un saladier.', 'Battre le blanc d''oeuf en neige ferme (il doit coller à la cuillère). L''incorporer délicatement au mélange tofu/fruits.', 'Tremper les biscuits à la cuillère dans du lait (parfumé de fleur d''oranger ou autre selon vos goûts).', 'Mettre les biscuits au fond des coupes et recouvrir de la mousse aux fruits.', 'Mettre au frais 1h minimum.'], ['Poêle', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'biscuits à la cuillère', 'facile', 'bon marché', 'rapide', 'plat', 'fruits rouges', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'mousse fruits', 'Mousse aux fruits et au tofu', 'pêche', 'sucre', 'lait', 'blanc d''oeuf', 'cocktail', 'tofu soyeux'], 'Dessert', 7c3946ce-2f41-4b9b-9e10-7c627b19b65b, '2025-09-26T16:43:46.470237', [{'ingredient_id': '38c985fa-7305-41b8-bbfa-e07b3bfedbbf', 'quantite': '200 g'}, {'ingredient_id': 'd69225e6-3100-4e26-9d36-f10a9ab03c69', 'quantite': '200 g'}, {'ingredient_id': 'c818587e-0c15-4b2c-b8cb-53ef2750534c', 'quantite': ''}, {'ingredient_id': '53635415-d4d7-4b16-a862-687775bb1dcc', 'quantite': ''}, {'ingredient_id': '588990e4-3ace-4dcc-b254-d78d53b125bb', 'quantite': '50 g'}, {'ingredient_id': '0b964b3d-cab5-4095-8a68-4fd142c5fd0f', 'quantite': '1'}, {'ingredient_id': 'c0c2469d-dd71-46ce-9188-02129545c259', 'quantite': '4'}, {'ingredient_id': '12bcb53d-c5c8-4c39-aa9c-45fb882a5b92', 'quantite': '5 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530418, 'Croque-Monsieur Banane, chocolat', 'banane, chocolat, pain de mie', '15 min', ['Prendre 1 tranche de pain de mie, mettre le tiers ou la moitié de la banane coupée en rondelle.', 'Râper le chocolat (avec l''aide d''un adulte) et le mettre sur les rondelles de banane.', 'Mettre l''autre tranche de pain de mie dessus.', 'Disposer soit dans la machine à croque-monsieur ou soit dans le four toujours avec l''aide d''un adulte.
 
 Cuire 5, 10 min thermostat 6 ou 7 (180°C).'], ['Ouvre-boîte', 'Spatule', 'Économe', 'Planche à découper', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'autres gâteaux', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'Croque-Monsieur Banane', 'boisson', 'dessert', 'plat de résistance', 'cocktail', 'pain de mie'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T16:43:50.054210', [{'ingredient_id': 'c2bc2bf0-435e-4919-b6b8-9a6303f49445', 'quantite': ''}, {'ingredient_id': '517c0f2a-21ef-4925-b757-d8e722cc0545', 'quantite': '2'}, {'ingredient_id': '5c98790d-b636-4b40-b014-eaf201c713aa', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530608, 'Purée de banane', 'banane, lait, sucre', '5 min', ['Écrase une banane dans une assiette dans un grand bol.', 'Ajoute le lait et le sucre, et mélange.', 'C''est prêt !'], ['Mixeur', 'Râpe', 'Spatule', 'Pince de cuisine', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'compote', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Purée de banane', 'sucre', 'lait', 'cocktail'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T16:43:54.738765', [{'ingredient_id': 'ae3f33b0-69ba-467e-97a0-0a17d2d6266d', 'quantite': '1'}, {'ingredient_id': 'b992f6fc-62d8-406c-ab3a-dac1f09f5a99', 'quantite': '10 cl'}, {'ingredient_id': 'b7db4864-647f-4adf-8395-01954c02c111', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530909, 'Gâteau au fruits et chocolat de Ben', 'farine, levure, pomme, beurre, kiwi, lait, banane, poire, chocolat, sucre', '25 min', ['Mélanger le sucre, la farine et la levure.', 'Éplucher les fruits et les couper en morceaux.', 'Rajouter le lait.', 'Pendant ce temps, faites fondre le beurre et le chocolat.', 'Faire chauffer votre four à 180°C et mettez-y la préparation pendant 15 minutes.', 'Mettez les éléments dans un saladier et rajouter le sucre glace.', 'Mélangez le tout.', 'Sortez la préparation du four et rajoutez par dessus le mélange de beurre, chocolat et sucre glace.', 'Remettez le gâteau au four pendant 15 minutes.'], ['Louche', 'Râpe', 'Batteur électrique', 'Verre doseur', 'Spatule'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'poire', 'facile', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'Gâteau au fruits et chocolat de Ben', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'beurre', 'lait', 'sucre', 'cocktail'], 'Dessert', 95d9b424-202a-44f9-9d01-f1f060be8d46, '2025-09-26T16:43:59.490183', [{'ingredient_id': '468e71c9-dc03-4491-a03b-5bdef8a5d950', 'quantite': '6 cuillères'}, {'ingredient_id': 'c063eddb-8e33-4067-8498-86e255e52d2f', 'quantite': '1'}, {'ingredient_id': '070355d8-2a24-476e-8ddc-d0331ff1dc73', 'quantite': '2'}, {'ingredient_id': '642bdb0b-3afa-4a42-80f9-2868e2db21bc', 'quantite': '35 g'}, {'ingredient_id': '367022fc-d12e-4df1-93bb-05fac7241080', 'quantite': '3'}, {'ingredient_id': '66c02f09-0115-4469-8534-61b85c9451d2', 'quantite': '3 cuillères'}, {'ingredient_id': 'dc3fc086-2f7e-4090-90e0-eda6775a62e4', 'quantite': '1'}, {'ingredient_id': '959fd159-f407-4689-9cf3-3d204f55492a', 'quantite': '2'}, {'ingredient_id': '9c24518d-6564-4a30-9cdf-45c05cd36aaf', 'quantite': '40 g'}, {'ingredient_id': '0c63a70e-add1-414e-a216-8ada1092ced4', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (54636, 'Goûter rapide à la banane', 'banane, sucre, baguette', '5 min', ['Couper le pain en rondelles.', 'Ecraser la banane dans une petite assiette à l''aide d''une fourchette pour obtenir une sorte de purée.', 'Mélanger ensuite avec un peu de sucre, puis tartiner un peu de purée de banane sur une rondelle de pain.', 'Vous pouvez aussi manger la purée juste à la cuillère.', 'Bon appétit.'], ['Presse-agrumes', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Goûter rapide à la banane', 'baguette', 'sucre', 'cocktail'], 'Dessert', e83879b1-abe6-4428-9dc5-9882ccda3f86, '2025-09-26T16:44:03.273408', [{'ingredient_id': '8c83ce2c-075d-4f1b-bcff-5ad7b65de4ba', 'quantite': '1'}, {'ingredient_id': '6d4e79ba-a839-4534-9c1f-5a2f3c1f0936', 'quantite': ''}, {'ingredient_id': '54c37af2-1aa5-4dac-97ca-2348ab140e26', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335225, 'Gâteau rhum banane façon cuba', 'banane, rhum, sucre en poudre, levure chimique, oeuf, farine, beurre, sel', '15 min', ['Mélanger le beurre avec le sucre jusqu’à l’obtention d’une crème onctueuse.', 'Casser les oeufs en séparant les blancs des jaunes. ', 'Incorporer les jaunes au mélange beurre-sucre.', 'Écraser la chair des bananes avec un presse-purée, les ajouter à la préparation ainsi que le rhum. Bien mélanger. ', 'Incorporer ensuite la farine avec la levure.', 'Préchauffer le four à 210°C.', 'Monter les blancs en neige ferme avec une pincée de sel et les incorporer délicatement à la préparation, en soulevant la masse.', 'Verser la pâte dans un moule à cake et mettre au four à 210°C.', 'Laisser cuire 50 min. Après 10 min de cuisson ramener le thermostat à 160°C.', 'Laisser tiédir avant de démouler.', 'Déguster une fois refroidi.'], ['Passoire', 'Tire-bouchon', 'Ouvre-boîte'], ['entrée', 'banane', 'Gâteau rhum banane façon cuba', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'levure chimique', 'facile', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'moyen', 'beurre', 'cocktail'], 'Dessert', de676beb-d29a-42af-972c-58bf070fded7, '2025-09-26T16:44:06.814026', [{'ingredient_id': '8c926e70-1cf7-44af-ac5e-6bef5adbeb0b', 'quantite': '5'}, {'ingredient_id': 'a244f72f-7daa-47bf-8c19-938ff9ba70a1', 'quantite': '3 cuillères'}, {'ingredient_id': '51588b5a-8224-449f-8dde-4f9d4a9972f3', 'quantite': '175 g'}, {'ingredient_id': '2da54290-0549-41b0-9270-74a599c40dbc', 'quantite': '1'}, {'ingredient_id': '599e01af-c698-403f-a50c-2a52d4fa8531', 'quantite': '4'}, {'ingredient_id': '10e43cfa-419f-4d2a-a187-ed8f12ae9475', 'quantite': '150 g'}, {'ingredient_id': '8f848cd2-bda0-4a12-b955-39cc2516f076', 'quantite': '150 g'}, {'ingredient_id': '6f07d512-3029-42b2-8853-b0cd8eccd4c8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (59443, 'Smoothie au yaourt et aux fruits', 'yaourt, banane, framboises, fraises, lait écrémé, glaçons', '5 min', ['Mettez tous les ingrédients dans le blender, en finissant par le lait.', 'Mixez pendant 30 secondes (au moins) à forte puissance, une fois les glaçons broyés, versez le mélange dans un grand verre et dégustez !'], ['Presse-agrumes', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'lait écrémé', 'testées', 'très facile', 'framboises', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'Smoothie au yaourt et aux fruits', 'smoothies', 'cocktail'], 'Boisson', a4a47b1e-64e7-4201-841e-bc8586facfe4, '2025-09-26T16:44:10.272039', [{'ingredient_id': 'dd84468a-0731-45b9-b737-f9339b200fd7', 'quantite': '1'}, {'ingredient_id': '38cc5c21-a632-4f7d-b222-3ca562e35943', 'quantite': '1'}, {'ingredient_id': '4b1fb0b7-d6ae-4722-aaad-39243c93014f', 'quantite': '1'}, {'ingredient_id': '37a96d0d-d329-4476-b2ef-0dcb856a7984', 'quantite': ''}, {'ingredient_id': 'd816a195-db3a-4ac2-bb6c-9f9f49fb12e8', 'quantite': '1'}, {'ingredient_id': 'afb11a1a-a3d4-4fa1-b0fe-8f5c0652dabf', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52762, 'Minestrone de fruits frais', 'eau, sucre, vanille, banane, mangue, kiwi, citron vert, fraises, framboises, menthe', '20 min', ['Dans une casserole, verser le sucre, l''eau et les gousses de vanille fendues dans la hauteur.', 'Porter à ebulition et laisser cuire à petits bouillons durant 5 minutes.', 'Retirer la vanille et gratter l''intérieur des gousses pour récupérer les graines et les ajouter au sirop.', 'Ajouter la menthe finement émincée et laisser refroidir.', 'Placer la préparation au frigo et laisser infuser au moins 1 heure (plus c''est encore mieux).', 'Pendant ce temps, éplucher la banane, la mangue, le kiwi et les détailler en petits dés.', 'Les plonger dans le sirop à la vanille.', 'Râper le citron pour n''utiliser que le zeste et l''ajouter au minestrone.', 'Passer les framboises et les fraises à la centrifugeuse puis incorporer le jus obtenu à la préparation.', 'Verser en soupière et servir dans des assiettes creuses.'], ['Râpe', 'Pince de cuisine', 'Fouet', 'Spatule'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'menthe', 'facile', 'framboises', 'rapide', 'plat', 'mangue', 'Minestrone de fruits frais', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'moyen', 'citron vert', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:44:13.836372', [{'ingredient_id': 'c95d5b27-5422-44d6-a38a-da64091ccf82', 'quantite': '50 cl'}, {'ingredient_id': 'b6a122a2-0e00-445f-9b8b-de292fea05d5', 'quantite': '80 g'}, {'ingredient_id': '328ab4ff-834b-4e72-82d8-58e56f69af18', 'quantite': '3'}, {'ingredient_id': '49038f3f-10d5-4cad-b64e-e9df466219f1', 'quantite': '1'}, {'ingredient_id': '5a571328-f182-4d3a-ac19-42b32df9ad61', 'quantite': '1'}, {'ingredient_id': 'e1b81cda-9315-4c9e-8264-85127f3fc407', 'quantite': '1'}, {'ingredient_id': '14a62bf9-4adb-44b7-aaa6-0b4fa8f7c393', 'quantite': '1'}, {'ingredient_id': '0747a233-a0df-41c5-a469-266ca7f87b19', 'quantite': '125 g'}, {'ingredient_id': 'f48fe460-a91e-4a1f-9f6c-8d0ae3ed4b90', 'quantite': '80 g'}, {'ingredient_id': '8f8544de-81a6-4f8d-81aa-ed37cf39e56d', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (340745, 'Muffins à la cannelle de Clara', 'oeuf, farine, beurre, sucre vanillé, sucre en poudre, arôme fleur d''oranger, banane, cannelle, lait, levure chimique', '20 min', ['Faire fondre le beurre au bain-marie. Pendant ce temps, mélanger le lait et les oeufs. ', 'Ajouter le beurre fondu puis la farine, la levure et le sucre. Mélanger.', 'Ajouter le speculoos émietté, l''arôme de fleur d''oranger et la banane coupée en rondelles. Mélanger.', 'Remplir les empreintes de ce mélange et mettre au four pendant 15 minutes à 200 degrés (thermostat 6-7)'], ['Passoire', 'Râpe', 'Ouvre-boîte', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'Muffins à la cannelle de Clara', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'arôme fleur d''oranger', 'muffin', 'beurre', 'cannelle', 'lait', 'cocktail'], 'Dessert', 49b9027b-d324-4278-a0c8-c5b82d656ae2, '2025-09-26T16:44:18.845833', [{'ingredient_id': 'c0a02668-f731-4071-8a52-79cc24009324', 'quantite': '4'}, {'ingredient_id': '2b8220d1-bf01-4d17-bfc1-2be0637f4ef4', 'quantite': '250 g'}, {'ingredient_id': '6e57d749-582b-4224-8ea2-d8429bce3376', 'quantite': '125 g'}, {'ingredient_id': 'b2d18624-271b-4976-8f6f-efc9d611a07b', 'quantite': '1'}, {'ingredient_id': '66821ce9-08fa-47dc-8eb1-99359530f20a', 'quantite': '50 g'}, {'ingredient_id': '0a86ef06-833a-4b47-9d49-1fdc8c757b3c', 'quantite': '2 cuillères'}, {'ingredient_id': '5c4845b6-e0fa-4cc2-ba56-95590289f625', 'quantite': '1'}, {'ingredient_id': '3feaf4fd-019a-453c-b59f-3b0d4a2818e9', 'quantite': '4 cuillères'}, {'ingredient_id': '76017458-4983-4770-a213-0b4a7f5dc786', 'quantite': ''}, {'ingredient_id': '6f623a1c-6197-4299-87b4-4c5bf136a584', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13294, 'Sangria bien fruitée', 'vin rouge, vin rouge, vin rouge, triple sec, cognac, grand-marnier, vanille, citron vert, orange, banane, poire, pomme', '15 min', ['Mélanger le tout.'], ['Mixeur', 'Spatule', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'sangria', 'boisson', 'vanille', 'vin rouge', 'dessert', 'Sangria bien fruitée', 'plat de résistance', 'pomme', 'moyen', 'orange', 'grand-marnier', 'citron vert', 'triple sec', 'cognac', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:44:23.534703', [{'ingredient_id': '51d4c43c-c9ad-4bd6-b1b7-6cc4bc519125', 'quantite': '225 cl'}, {'ingredient_id': 'bac3545e-5d79-4c3d-beac-696907f6cde9', 'quantite': '225 cl'}, {'ingredient_id': '68511db5-e496-4623-845a-384c6de00bea', 'quantite': '225 cl'}, {'ingredient_id': '07d84aa2-1dfa-4742-b3b2-bb8f9b45f19a', 'quantite': '75 cl'}, {'ingredient_id': '6f9b0812-46ec-46b1-b1f0-e0f66ec7a7b4', 'quantite': '105 cl'}, {'ingredient_id': '0b4a75fd-5d45-4586-b214-3449df1f410d', 'quantite': '30 cl'}, {'ingredient_id': 'b4987933-a7b4-45b7-9044-57a0db007a5b', 'quantite': '3'}, {'ingredient_id': '0471e6b9-d3a4-4ecb-92b1-fd4573390b5f', 'quantite': '2'}, {'ingredient_id': 'f154e723-e870-4071-8607-432d4301fa56', 'quantite': '10'}, {'ingredient_id': '3cda60b5-89b5-453f-ade5-2f4994eb90d9', 'quantite': '10'}, {'ingredient_id': 'e67e0c3f-decf-455c-9303-c4bc7b8f84c3', 'quantite': '9'}, {'ingredient_id': '28163d2c-22a2-4e42-98a8-333d4ab95b0b', 'quantite': '9'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81661, 'Pommes douceur de Nathalie', 'pomme, banane, gelée, beurre, crème chantilly', '15 min', ['Eplucher et couper les pommes en quartiers assez épais.', 'Faire fondre 20 g de beurre dans une grande poêle, y mettre les quartiers de pommes et les faire dorer de chaque côté (sucrer légèrement si les pommes sont trop acides).', 'Disposer les quartiers de pommes dans des ramequins (type ramequins à crème brûlée), étaler la gelée de mûre.', 'Eplucher et couper la banane en rondelles (environ 12 rondelles), les faire revenir dans le beurre restant. Les répartir sur les pommes.', 'Décorer avec un peu de chantilly.', 'NB: on peut aussi saupoudrer de cannelle (pour ceux qui aiment).'], ['Couteau de chef', 'Planche à découper', 'Spatule', 'Passoire', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'Pommes douceur de Nathalie', 'dessert', 'plat de résistance', 'gelée', 'pomme', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:44:27.097034', [{'ingredient_id': 'c9064052-4fae-43f4-9df1-9f05d7cb87ff', 'quantite': '4'}, {'ingredient_id': 'c33b0361-c044-4454-b82d-01d68c33a782', 'quantite': '1'}, {'ingredient_id': '39ed08c2-03fb-4fd4-a982-53b8e99c765f', 'quantite': '4 cuillères'}, {'ingredient_id': '209d41b6-f88e-4f19-a0a0-573661a3dfae', 'quantite': '30 g'}, {'ingredient_id': '6add2dd9-f8c2-4523-a108-f7a7b8f68b88', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392339, 'After sex', 'vodka, crème de bananes, jus d''oranges, sirop de grenadine, sucre', '0 min', ['Réalisez la recette "After sex" directement dans le verre.', 'Verser les ingrédients en complétant avec le jus d''oranges dans le verre rempli de glaçons et agiter avec une cuillère à mélange. Finir en déposant la grenadine et le sucre dessus.', 'Servir dans un verre de type "tumbler".'], ['Mixeur', 'Moule à tarte', 'Râpe', 'Presse-agrumes'], ['', 'vodka', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'crème de bananes', 'jus d''oranges', 'sirop de grenadine', 'sucre', 'cocktail', 'After sex'], 'Boisson', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:44:31.436462', [{'ingredient_id': 'c0df8f34-4609-420b-a0f3-9558844d2a0b', 'quantite': '3 cl'}, {'ingredient_id': 'cff739ab-2bc0-49a8-99c2-683f52a4b0f8', 'quantite': '2 cl'}, {'ingredient_id': '0ec37016-88c5-47d5-9cc7-516e9e66d021', 'quantite': ''}, {'ingredient_id': '54a58330-50ce-46d7-95a7-230d95312b31', 'quantite': ''}, {'ingredient_id': 'dc14b18d-40dd-4923-96d6-a6e1e53734b7', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17858, 'Poulet au curry', 'cuisse de poulet, oignon, banane, pomme, concentré de tomates, ail, margarine, curry, poivre, sel', '15 min', ['Saler, poivrer et enduire le poulet de curry. Le faire dorer dans la cocotte où on aura préalablement mis la margarine. Ajouter les oignons émincés et faire cuire ainsi 5 mn. ', 'Ensuite, ajouter le concentré de tomate, l''ail et la moitié des pommes et bananes coupées en gros dés. Laisser de nouveau cuire environ 10 à 15 mn et mettre le reste des fruits (en faisant de la sorte, on retrouvera les morceaux dans la sauce). Refaire mijoter 10 mn. ', 'Servir avec du riz à l''eau.'], ['Poêle', 'Mixeur', 'Verre doseur', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'concentré de tomates', 'très facile', 'bon marché', 'curry de poulet', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'cuisse de poulet', 'oignon', 'boisson', 'margarine', 'Poulet au curry', 'dessert', 'plat de résistance', 'pomme', 'poivre', 'curry', 'cocktail'], 'Plat principal', bc718e44-7a02-4ece-8800-eeef34e563f3, '2025-09-26T16:44:34.969668', [{'ingredient_id': 'dd45d9b3-4dee-4864-a43f-bc6668616e50', 'quantite': '4'}, {'ingredient_id': '9bb640ce-5c2b-4503-bafe-c53c706ba808', 'quantite': '2'}, {'ingredient_id': 'd2aa92ff-7a30-4a7a-b42e-5a2681ac61b6', 'quantite': '2'}, {'ingredient_id': 'b49aa483-4109-46e7-a773-365bb2fa93b1', 'quantite': '2'}, {'ingredient_id': 'abc479b8-3dd9-4973-9c2b-11ba393a06ca', 'quantite': '1'}, {'ingredient_id': '442cf090-13d8-40f4-bf24-016e79cf83b5', 'quantite': '1'}, {'ingredient_id': '6d54b434-d8ac-444b-a4be-8cdf9a0fd6e7', 'quantite': '1 cuillères'}, {'ingredient_id': '49a07251-7684-4cee-a0c6-2b7ec471a0bb', 'quantite': ''}, {'ingredient_id': 'a13ede06-61eb-49f1-a738-a75937e4f8ed', 'quantite': ''}, {'ingredient_id': 'f2e366f9-8a29-4104-b1ab-921d5ce48b25', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (533821, 'Cookies moelleux et légers aux pépites de chocolat', 'huile, banane, pépites de chocolat, levure chimique, maïzena, farine, miel de fleurs', '10 min', ['Mélanger tout dans un saladier au fouet : farine, maïzena et une demi banane écrasée,  ainsi que 2 cuillères à café de miel , un demi sachet de levure chimique et 8 cl d''huile', 'Une fois la préparation prête, mélanger avec une cuillère puis déposer sur du papier cuisson afin de donner la forme à vos cookies. Y déposer les pépites de chocolat.', 'Mettre dans le four chauffé au préalable à 180 degrés pendant une durée de 10 minutes, tout en surveillant la cuisson (voir selon puissance four).', 'Une fois que c''est cuit, il ne reste plus qu''à déguster.'], ['Couteau de chef', 'Ouvre-boîte', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'maïzena', 'bon marché', 'rapide', 'plat', 'pépites de chocolat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'miel de fleurs', 'cocktail', 'Cookies moelleux et légers aux pépites de chocolat'], 'Dessert', ea96f069-4d84-4570-8942-87897b5f487b, '2025-09-26T16:44:38.571853', [{'ingredient_id': 'b9602fd3-208c-49ef-ab49-ae650df872b2', 'quantite': '8 cl'}, {'ingredient_id': '49194396-884c-4ad7-a077-a6c5ee9d015d', 'quantite': '1'}, {'ingredient_id': '24583f7e-cc5b-4f04-a9de-68706e2ff33a', 'quantite': ''}, {'ingredient_id': 'fe0d72ac-000f-42c7-8624-c4b06c7f6b42', 'quantite': ''}, {'ingredient_id': '78c4d092-a815-487b-b0be-c5f81671aa6e', 'quantite': '75 g'}, {'ingredient_id': '027b8292-4b2f-4d2d-8dd2-1802dcee97ce', 'quantite': '75 g'}, {'ingredient_id': '363b1d25-c11c-48e6-9061-8224007bb596', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345360, 'Pizza pastèque tendance', 'pastèque, banane, fraises, melon, pêche, myrtilles, noix de coco rapée', '20 min', ['Découper la pastèque en deux.', 'Faire des (grosses) tranches de environs 1.5 cm (le plus dur est fait !) et couper 8 parts.', 'Recouvrir de fruits préalablement lavés et épluchés (place à la créativité).', 'Déposer les rondelles de banane, puis des quartiers de fraise, des morceaux de melon, pêche et quelques myrtilles. Saupoudrer de noix de coco râpée.'], ['Tire-bouchon', 'Balance de cuisine', 'Passoire'], ['', 'melon', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'pastèque', 'rapide', 'plat', 'myrtilles', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'Pizza pastèque tendance', 'noix de coco rapée', 'dessert', 'plat de résistance', 'pêche', 'cocktail'], 'Dessert', 35ff9679-08d0-4f2f-8b82-22df25115e90, '2025-09-26T16:44:43.242735', [{'ingredient_id': '1b522810-fcf1-49c3-90ee-9e2b3ab79c5d', 'quantite': '1'}, {'ingredient_id': '24f8ddb3-20b3-4d01-a437-b83050d98849', 'quantite': '1'}, {'ingredient_id': '29509ecd-c377-4b50-aae0-e9abb0d3f69f', 'quantite': '5'}, {'ingredient_id': 'fdaf36c6-b769-4d24-b329-b85f24f6585e', 'quantite': ''}, {'ingredient_id': 'cbbd5915-b220-40e1-8504-2c6d39811a2a', 'quantite': '1'}, {'ingredient_id': '503b78ec-d147-4f31-af4f-bd3d1a81f821', 'quantite': '100 g'}, {'ingredient_id': 'b763c872-8416-4d7b-8606-6e8e493ad3d4', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56513, 'Açai sans Açai (banane framboise)', 'banane, framboises, glace vanille, lait, muesli', '5 min', ['Coupez 2 des bananes et les mixer avec les framboises, ajoutez le lait au feeling (mais il ne faut pas que ce soit trop liquide sinon il faut le manger à la paille )!', 'Mixez le tout.', 'Ajoutez la glace à la vanille à la préparation puis mixez.', 'Versez le contenu dans un joli bol, versez le muesli dans un petit récipient à côté (comme ça si les gens n''en veulent pas on force personne).', 'Coupez en rondelles la dernière banane et posez dessus (déco).', 'Et voilaaaaaaaaaaaaaaa ! Bon appétit !! :-D'], ['Fouet', 'Couteau de chef', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'muesli', 'très facile', 'framboises', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'Açai sans Açai (banane framboise)', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:44:46.809273', [{'ingredient_id': 'da79d070-eca7-466b-a9ec-702e0c75f6d2', 'quantite': '3'}, {'ingredient_id': '150ea563-d3ce-4be0-8a94-a9e240320eea', 'quantite': '150 g'}, {'ingredient_id': '52ae91db-2ed7-4625-9c40-09427f589303', 'quantite': '2'}, {'ingredient_id': 'f2fce053-c0ba-4de1-8798-a72bf3597d3c', 'quantite': ''}, {'ingredient_id': 'cba37eaa-d3d7-4ebf-8d51-9f5434f3a908', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (312215, 'Risotto aux champignons : la vraie recette', 'champignon, riz, huile d''olive, beurre, bouillon de légumes, vin blanc sec, Parmesan, oignon, ail, échalote, persil, sel, poivre', '45 min', ['Il existe sur la toile deux écoles du risotto aux champignons, à savoir celle du champignon qui cuit dans le riz, et celle des champignons poêlés ajoutés à la dernière minute. Ayant longtemps pratiqué les deux recettes, je souhaitais vous communiquer la mienne :', 'Séparer les champignons en deux (préférer des cèpes) : une partie servira à élaborer le bouillon et cuira avec le riz. L''autre partie sera poêlé au dernier moment pour la présentation et mettre en avant le champignon tout en conservant une texture ferme.
Emincer un petit peu d''ail, d''échalote et de persil séparément et réserver.', 'Nettoyer les champignons et les couper en morceaux.', 'Faire blondir dans une casserole un demi-oignon émincé dans un mélange de beurre et d''huile d''olive.', 'Ajouter et poêler les champignons.', 'Ajouter du bouillon de légumes ou de poule (assez pour nourrir le risotto).', 'Laisser mijoter le bouillon pour qu''il s''imprègne bien du goût et des saveurs des champignons.', 'Chauffer une nouvelle casserole (qui accueillera le risotto), ajouter un peu d''huile d''olive et de beurre que vous ferez blondir.', 'Ajouter le riz carnaroli et remuer jusqu''à le rendre translucide (attention à la température, le riz ne doit pas coller).', 'Déglacer avec un verre de vin blanc sec. Continuer à remuer pour que le riz n''adhère pas et laisser réduire l''alcool.', 'Verser une louche de bouillon que vous avez laissé mijoter et continuer à remuer constamment jusqu''à l''absorption totale du riz.', 'Réitérer l''étape 11 jusqu''au point de cuisson (préférer al dente).', 'Juste avant la fin, faire fondre du beurre et un peu d''huile d''olive dans une poêle tout en remuant le risotto.', 'Faire blondir l''échalote émincée dans la poêle puis ajouter l''ail (attention à ne pas le brûler).', 'Faire poêler les champignons tout en remuant le risotto, assaisonner et ajouter le persil émincé en fin de cuisson avec un tour de moulin à poivre puis réserver.', 'Assaisonner le risotto juste avant la fin.', 'Ciseler du persil et en parsemer au dessus.', 'Dresser le riz dans des assiettes creuses. Placer soigneusement sur le haut les champignons poêlés.', 'Servir avec un tour de moulin à poivre et du parmesan.', 'Le gras du beurre va s''opposer au salé du parmesan et à l''amertume du cèpe en arrière plan. Les puristes privilégieront un rouge italien d''âge moyen avec une structure légère mais à la fois ronde et consistante. Personnellement, je préfère un blanc sec minéral un peu évolué au accent de sous-bois. Un bourgogne fera parfaitement l''affaire. Bon appétit'], ['Batteur électrique', 'Râpe'], ['Risotto aux champignons : la vraie recette', 'champignon', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'cocktail', 'bon marché', 'semoule', 'ail', 'pâtes', 'moyenne', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile d''olive', 'vin blanc sec', 'dessert', 'persil', 'riz', 'plat de résistance', 'beurre', 'poivre', 'bouillon de légumes', 'Parmesan', 'échalote'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:44:53.649327', [{'ingredient_id': '0004b6d6-188d-410e-be53-d13abae8931b', 'quantite': '250 g'}, {'ingredient_id': '09cb9fc1-ee48-48c6-b69b-671373902678', 'quantite': '200 g'}, {'ingredient_id': '0a20c374-17ce-47fe-8b91-4e70c9204ac9', 'quantite': '1'}, {'ingredient_id': '29637d64-b25c-491a-b325-198adedd5655', 'quantite': '1'}, {'ingredient_id': '5839fc3b-d518-453e-af6d-96c056bc2623', 'quantite': '1'}, {'ingredient_id': '478f11d4-011f-4db7-a270-93d6a24c01d8', 'quantite': '20 cl'}, {'ingredient_id': '02af6f12-d426-457d-b8e9-e567be4c6792', 'quantite': '1 cuillères'}, {'ingredient_id': '74191219-9605-440c-9f8a-6cd8d6f0651b', 'quantite': '1'}, {'ingredient_id': 'c0b2fdea-280a-42ce-9f11-7793f99e682c', 'quantite': '1'}, {'ingredient_id': '3abb0058-a0e0-4dc8-aebe-a8cd30cbfabf', 'quantite': '1'}, {'ingredient_id': 'e4c38f4c-0371-4fcd-9cb9-d0c2b228d77e', 'quantite': '2'}, {'ingredient_id': '269bffbe-6e70-42d0-9538-dcdc5f6af76d', 'quantite': '1'}, {'ingredient_id': 'f9c623b4-ca67-44ec-808f-87cc23350d5c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37453, 'Gratin de pommes de terre fondant', 'pomme de terre, fromage râpé, crème fraîche, beurre, ail, poivre, sel', '15 min', ['Épluchez et coupez en fines rondelles les pommes de terre.', 'Frottez le plat à gratin avec la gousse d''ail.', 'Disposez successivement les rondelles de pommes de terre, le gruyère râpé et la crème, salez et poivrez. Recommencez jusqu''en haut du plat pour finir sur une couche de pommes de terre.', 'Ajoutez une noix de beurre.', 'Faites cuire à 200°C (Thermostat 6) pendant 50 min puis 5 min à 240°C (Thermostat 8).', 'Dégustez aussitôt.'], ['Mixeur', 'Louche', 'Économe', 'Verre doseur', 'Batteur électrique'], ['entrée', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'Gratin de pommes de terre fondant', 'autre gratin de pommes de terre', 'facile', 'bon marché', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'poivre', 'pomme de terre', 'cocktail', 'fromage râpé'], 'Accompagnement', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:45:00.142502', [{'ingredient_id': '527ee60c-33bc-4532-80e0-633e1686d8c3', 'quantite': '1 kg'}, {'ingredient_id': 'd12fc5a1-548c-4061-8ece-f105231ea15c', 'quantite': '60 g'}, {'ingredient_id': '10161626-2bba-494e-9be9-c92dd5403054', 'quantite': '25 cl'}, {'ingredient_id': '7c08d8b4-53e6-46b5-b12e-f843868388a2', 'quantite': '30 g'}, {'ingredient_id': '2208ef2a-d3b5-45f4-bee3-f733ac77a86b', 'quantite': '1'}, {'ingredient_id': '64290695-b9ac-4a6c-8991-f278238dac51', 'quantite': ''}, {'ingredient_id': 'b714d87d-b175-4792-8b38-47dc9a8b76a3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (312890, 'Cupcakes bananes flambées nutella', 'oeuf, beurre, sucre, farine, levure, lait, banane, cassonade, rhum, Nutella', '20 min', ['Prévoir des caissettes en papier.', 'Commencer par faire revenir vos bananes dans 10 g de beurre. Ajouter la cassonade. Quand elles sont bien cuites, verser le rhum et faire flamber. Bien écraser les bananes et réserver.', 'Mettre le four à préchauffer à 180°C (thermostat 6).', 'Dans un saladier, mélanger les jaunes d’œufs et le sucre. Quand le mélange est bien blanchi, ajouter la farine et la levure. Cela fait une pâte compacte comme le crumble. Ajouter ensuite le lait et le beurre. Bien mélanger.', 'Battre les blancs en neige et les incorporer à la préparation délicatement. Cela permet à vos gâteaux d''être plus légers.', 'Enfin, ajouter les bananes.', 'Mettre les caissettes dans votre moule à muffins et ajouter la préparation. ', 'Vous pouvez choisir de faire un coeur au nutella en remplissant à moitié de pâte puis ajoutant une cuillère à café de nutella et en terminant par la pâte.', 'Enfourner environ 20 min.', 'Sortir du four et laisser refroidir avant de démouler. Décorer ensuite le cupcake avec le nutella.'], ['Casserole', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'cassonade', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'Nutella', 'dessert', 'plat de résistance', 'beurre', 'Cupcakes bananes flambées nutella', 'cupcake', 'sucre', 'lait', 'cocktail'], 'Dessert', 22fd6189-8936-43aa-b6fb-040e5d8803b8, '2025-09-26T16:45:03.848877', [{'ingredient_id': '68ada4d6-028b-4e3f-a720-3a6fb05a1bed', 'quantite': '2'}, {'ingredient_id': '0179cea3-0169-4190-b43a-37dc9ad90f7f', 'quantite': '110 g'}, {'ingredient_id': '94d10331-ca59-41af-b0fb-bea3a841ce5a', 'quantite': '150 g'}, {'ingredient_id': 'c56de78b-b7f4-44d4-acf3-91cb758a5667', 'quantite': '200 g'}, {'ingredient_id': 'c25a6a19-1f5c-469c-afbd-0f2b1a808d6c', 'quantite': '1'}, {'ingredient_id': 'b60fa2c5-5950-43b8-a0d1-f3df8b3e8da4', 'quantite': '5 cl'}, {'ingredient_id': '882b9a24-f55d-4400-ac4f-8d520af973df', 'quantite': '2'}, {'ingredient_id': 'eaa7d53e-9ff4-4875-8389-b1a23618268f', 'quantite': '2 cuillères'}, {'ingredient_id': '613f0a3c-3342-469f-903a-6b1165e0e872', 'quantite': '2'}, {'ingredient_id': '7be185c6-8bd5-4a49-9062-7653cd90c022', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (175423, 'Chocolat instantané en poudre maison', 'sucre, chocolat noir, beurre, farine, banane, miel, sucre vanillé, rhum', '10 min', ['Casser le chocolat en morceaux.', 'Écraser, émincer les fruits (le plus fin possible).', 'A feu très doux (essayer de rester en dessous de 70 degrés), faire fondre le beurre et le chocolat, ajouter la farine, mélanger, ajouter le sucre. ', 'Mélanger, et après le reste suivant vos envies (fruits, miels, alcools, vanille ou non).', 'Laisser à feu très doux du début à la fin, c''est cuit quand c''est tout sec.', 'Laisser tiédir, et mixer pendant quelques minutes.', 'Mettre en récipient en plastique ou métal refermables.', 'Laisser refroidir complètement avant de refermer.'], ['Presse-agrumes', 'Rouleau à pâtisserie', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'plat', 'Chocolat instantané en poudre maison', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre vanillé', 'moyen', 'beurre', 'sucre', 'cocktail'], 'Confiserie', e787fb8b-ee50-4cbe-be85-5933d605ff19, '2025-09-26T16:45:09.111551', [{'ingredient_id': '099e4d35-ed56-4d8e-bb15-7bb44d8baaf2', 'quantite': '650 g'}, {'ingredient_id': '07b419e3-ab6d-4eaf-b8a0-e2d72717512a', 'quantite': '200 g'}, {'ingredient_id': '6c4f16e5-1b02-4e7b-8a46-98fb64dece91', 'quantite': '1'}, {'ingredient_id': '977447d2-0ce0-49cc-8248-8dff7066d075', 'quantite': '100 g'}, {'ingredient_id': '819963fc-5d36-4e7f-b968-b54c6987977a', 'quantite': '1'}, {'ingredient_id': '6debcc46-6cdf-4891-ad77-e87a602af568', 'quantite': '3 cuillères'}, {'ingredient_id': 'f6c958fe-9541-4676-8d35-d8ea871754f6', 'quantite': '3'}, {'ingredient_id': '0e16243a-eeb9-4c83-aa73-b6721f37a2b4', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20805, 'Lassi à la banane', 'banane, yaourt nature, yaourt, sucre en poudre', '5 min', ['Mixer tous les ingrédients dans le bol d''un robot. Servir frais. '], ['Économe', 'Pince de cuisine', 'Louche', 'Moule à tarte', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Lassi à la banane', 'cocktail'], 'Boisson', d2b12279-d397-4596-b21e-eb59bc2c82ea, '2025-09-26T16:45:13.674247', [{'ingredient_id': '35e1ef18-b89d-432e-a8bd-ed20f62e2128', 'quantite': '1'}, {'ingredient_id': '734f4ccb-b5b4-4ea4-a009-2f6348982b3f', 'quantite': '1'}, {'ingredient_id': '60a32ecd-f029-4f08-a5a7-9ac2071286ca', 'quantite': '1'}, {'ingredient_id': '44e7d1b8-7a3b-4555-8fe1-f086ee69d0c7', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62616, 'Bananes rôties au jambon cru', 'banane, jambon cru, cannelle', '15 min', ['Coupez chaque banane en 3 morceaux égaux.', 'Sur chaque tranche de jambon que vous aurez coupé en 2 dans le sens de la longueur, posez un tronçon de banane et roulez-le avec le jambon.', 'Fixez avec une pique en bois.', 'Saupoudrez de cannelle.', 'Passez au four à 200°C (thermostat 6-7) 10 min, en surveillant, pour que le jambon soit croustillant.'], ['Tire-bouchon', 'Râpe', 'Rouleau à pâtisserie', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'jambon cru', 'recette', 'cuisine', 'recettes', 'boisson', 'Bananes rôties au jambon cru', 'dessert', 'plat de résistance', 'cannelle', 'cocktail'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:45:17.213936', [{'ingredient_id': 'e1675b89-141f-4a36-ae75-5dd2819f7381', 'quantite': '4'}, {'ingredient_id': '8c9b20b2-ad9f-4ac9-8972-0ca5497d29e1', 'quantite': '6'}, {'ingredient_id': '70a7f698-093d-4d31-a801-6b281b986061', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24418, 'daube de bananes', 'banane plantain, sucre brun, sel, vanille, muscade, lait de coco, cannelle', '20 min', ['Voici un succulent dessert créole très facile à faire et qui ravira tous les gourmands. ', '1) Epluchez les bananes, les couper en deux et encore en longeur. ', '2) Prendre une casserole bien grande et profonde. Disposez les feuilles de cannelle (ou les bâtonnets) au fond. ', '3) Placez les morceaux de banane sur les feuilles de cannelle. ', '4) Ajouter le sucre. ', '5) - puis le sel. ', '6) - la muscade, la vanille. ', '7) - puis le lait de coco. ', 'Cuisson :', 'Les bananes doivent être pratiquement recouvertes par le lait de coco. ', '8) Monter à ébullition rapidement et laissez bouillir environ 10 mn à feu assez vif. ', '9) Puis diminuez le feu et cuisez encore 25 mn ou jusqu''à ce que le lait ait considérablement réduit. Laissez quand même un peu de sauce dans la casserole pour arroser les bananes. ', 'Enfin, voila une vraie daube ! ', 'Au total, la cuisson prend environ 35 à 40 mn. N’oubliez pas que pour une bonne daube il vous faut une casserole assez épaisse. Il faut aussi cuire la daube sans la couvrir (les plats au lait de coco perdent leur goût s''ils sont cuits couverts...)'], ['Rouleau à pâtisserie', 'Mixeur', 'Batteur électrique'], ['', 'lait de coco', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'muscade', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre brun', 'vanille', 'dessert', 'plat de résistance', 'banane plantain', 'daube de bananes', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:45:20.816052', [{'ingredient_id': 'cbe24347-7757-40f4-836c-c7517639c42f', 'quantite': '3'}, {'ingredient_id': '82ad7d05-a3e8-4b3b-a69f-8d5a9f30421a', 'quantite': '3'}, {'ingredient_id': '289bfea9-f061-4a87-bba4-9fb6bb29a821', 'quantite': '1 cuillères'}, {'ingredient_id': '304bda36-e27d-4e2e-8fb6-05bf8b8c8dd3', 'quantite': '1'}, {'ingredient_id': '6f67811d-0017-490c-800f-f9099df53f1f', 'quantite': '1'}, {'ingredient_id': 'e89d4dfa-cf63-40c0-9a3f-a6ce9eccbc1d', 'quantite': '1'}, {'ingredient_id': 'ebedf6c2-91e3-4dfa-abcb-0445f8a45ddc', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (165963, 'Compote de fruits', 'pomme, poire, banane, mandarine, lait, sucre', '35 min', ['- Pour la première couche de compote : épluchez la poire,coupez-la en morceaux puis réduisez-la en compote au mixer, si ce n''est pas assez réduit, battez les derniers morceaux de poire avec environ 4 cL de lait. Versez cette première couche dans une verrine ou autre récipient de votre choix. ', '- Seconde couche : épluchez la pomme, coupez-la en quartiers, réduisez-la en compote au mixer et battez-la avec 4 cL de lait s''il reste trop de morceaux; versez cette deuxiéme couche sur la première.', '- Troisième couche : "épluchez" la banane,et coupez-la en petits morceaux, battez-la avec 4 cL de lait et versez le tout sur les deux premières couches .', '-Dernière couche : épluchez la mandarine, séparez ses quartiers et coupez-les en deux ( avec les doigts, ça va très bien ) et battez-les . Ajoutez cette couche à la verrine.', '-Mettez le tout au frigo et servez quand vous voulez !', '*Si les couches sont trop acides, n''hésitez pas à sucrer à votre convenance.', 'Bon appétit !'], ['Casserole', 'Louche', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'mandarine', 'bon marché', 'rapide', 'plat', 'recette', 'compote', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'Compote de fruits', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:45:25.737372', [{'ingredient_id': '375361d6-62e9-420b-ad61-c624da7f5848', 'quantite': '1'}, {'ingredient_id': 'accc03cf-8354-408d-a4c1-b2cf7d68f675', 'quantite': '1'}, {'ingredient_id': '47ce30a6-d33e-4071-bb11-15d0e5b039b4', 'quantite': '1'}, {'ingredient_id': '51357aa0-8eb2-47d0-a52b-512dbaa623e5', 'quantite': '1'}, {'ingredient_id': 'fc3bd4b6-8a7c-493c-8d8e-992728102890', 'quantite': '16 cl'}, {'ingredient_id': 'f20df7a7-a68c-48cb-ba87-24be9369f08b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15882, 'Gâteau à la banane et à la chantilly', 'biscuit, sucre semoule, beurre, fromage blanc, crème épaisse, banane, citron, sucre semoule, oeuf, gélatine, crème chantilly, banane, citron', '35 min', ['Préparer la pâte : passer les biscuits à la moulinette, jusqu''à obtenir une poudre fine.', 'Faire fondre 50 g de beurre dans une casserole à feu doux. Beurrer un moule à manqué à fond amovible de 20 cm de diamètre et étaler la pâte en l''aplatissant avec les doigts.', 'Mettre au réfrigérateur.(Prévoir 4 h de réfrigération)', 'La garniture : Faire ramollir la gélatine dans un bol d''eau froide, puis l''égoutter et la faire fondre dans une petite casserole à feu doux avec 2 cuillères à soupe d''eau froide en remuant. Laisser tiédir. ', 'Couper les bananes pelées en morceaux. Laver le citron, l''essuyer et râper la moitié de son zeste au-dessus d''un bol de mixer. Couper le citron en 2 et en presser la moitié. Verser le jus obtenu dans le bol, ajouter les morceaux de bananes et faire marcher l''appareil jusqu''à obtenir une pâte lisse. Casser les œufs en séparant les blancs des jaunes.', 'Battre les jaunes d’œufs au fouet à la main. Ajouter la gélatine tiède sans cesser de battre, puis incorporer le fromage blanc, la crème fraîche, la purée de bananes et la moitié de sucre; continuer à fouetter jusqu''à obtenir une crème lisse. Battre les blancs d’œufs en neige très ferme, ajouter le reste de sucre en continuant à battre pendant 1mn et incorporer délicatement à la préparation.', 'Sortir le moule du réfrigérateur et y verser la préparation. Lisser à l''aide d''une spatule. Mettre à nouveau au réfrigérateur et laisser prendre 4h.', 'Au moment de servir, démouler le gâteau. Décorer de rosaces de crème chantilly. Presser le citron. Peler les bananes et les couper en rondelles. Arroser celles-ci de citron, puis les glisser entre les rosaces de crème.'], ['Mixeur', 'Presse-agrumes', 'Balance de cuisine', 'Moule à tarte'], ['entrée', 'Gâteau à la banane et à la chantilly', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'biscuit', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'dessert', 'plat de résistance', 'gâteau à la banane', 'beurre', 'cocktail'], 'Dessert', 6ec3b636-f1ce-47b3-aaaa-7ca7b1dc6ffc, '2025-09-26T16:45:30.645143', [{'ingredient_id': '2a191155-46e6-4fbd-a446-35c0b930b085', 'quantite': '100 g'}, {'ingredient_id': '4110e982-be8e-4634-b444-b88d9eed1d55', 'quantite': '50 g'}, {'ingredient_id': '4e4cb23a-09b1-4bbb-88b8-3cbe59cef771', 'quantite': '60 g'}, {'ingredient_id': 'c235529d-657e-40b8-9310-cefe60db8eca', 'quantite': '250'}, {'ingredient_id': '3f1232ac-46ed-4312-902d-38d63b172b78', 'quantite': '1.5'}, {'ingredient_id': '6a1131fc-a900-417e-9a05-9ef70eac3743', 'quantite': '2'}, {'ingredient_id': '4ff3061f-5445-4ef0-860c-3941707c28f5', 'quantite': '1'}, {'ingredient_id': 'b5a313ed-7c23-4ac7-9fad-b94fce6dd51a', 'quantite': '100 g'}, {'ingredient_id': 'db5c9853-8cbc-4113-a12c-35b8c924bd8d', 'quantite': '2'}, {'ingredient_id': '6995aac9-3d17-460e-bc8a-ba82c55739e2', 'quantite': '4'}, {'ingredient_id': '56eefa84-eb28-4a93-8628-96107223edff', 'quantite': '1.5'}, {'ingredient_id': 'fee16030-3416-4ca7-ae8b-b4c47199cf07', 'quantite': '2'}, {'ingredient_id': 'e8655f32-cd11-47bb-bf22-9de70e89856b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61876, 'Fruits en papillote', 'pomme, poire, banane, orange, jus de citron, sucre vanillé, gelée, sucre', '15 min', ['Préchauffez le four à 225°C (Thermostat 7-8).', 'Lavez les fruits. Pelez l''orange à vif, taillez-la en cubes. Pelez la banane, coupez-la en rondelles épaisses.', 'Pelez les pommes et poires, coupez-les en cubes et citronnez-les aussitôt pour éviter qu''ils ne noircissent.', 'Posez le mélange de fruits sur le côté brillant des feuilles aluminium.', 'Ajoutez la garniture choisie.', 'Fermez les papillotes et disposez-les dans un plat allant au four.', 'Faites cuire 20 minutes.', 'Servez aussitôt.'], ['Couteau de chef', 'Verre doseur', 'Pince de cuisine', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'gelée', 'sucre vanillé', 'jus de citron', 'pomme', 'Fruits en papillote', 'orange', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:45:34.382898', [{'ingredient_id': '7ce657da-4158-4ef8-8697-be0b3d647dc5', 'quantite': '2'}, {'ingredient_id': 'ebe9736d-8cbd-4fce-ace8-0b9affc936b5', 'quantite': '2'}, {'ingredient_id': '0c52d444-b4f2-49ee-9d9c-aea1c50c0336', 'quantite': '2'}, {'ingredient_id': '64b5d594-964c-4b8f-a063-cf5cac24d74b', 'quantite': '1'}, {'ingredient_id': '343be152-9f15-4c8c-9534-f13f3480d1fc', 'quantite': ''}, {'ingredient_id': 'a0aac368-e224-48c1-8c3b-b507fd8169f6', 'quantite': ''}, {'ingredient_id': 'cf80b78a-2a20-440c-844f-8d629a12c628', 'quantite': ''}, {'ingredient_id': '6c84f48c-8951-4a3e-8875-67628224794d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (229840, 'Banoffee en verrines', 'sablés, banane, chocolat noir, mascarpone, oeuf, beurre salé, beurre doux, sucre, crème liquide, extrait de vanille', '40 min', ['Mixer les sablés.', 'Dans une casserole verser le sucre, chauffer jusqu’à obtenir un caramel blond. Verser 5 cl de crème tout en fouettant jusqu’à dissolution complète du sucre puis, hors du feu ajouter le beurre salé coupé en morceaux.', 'Mixer une banane et mélanger au caramel ; réserver.', 'Fondre le chocolat au bain-marie, ajouter le beurre doux en petits dés et le reste de crème liquide ; réserver.', 'Casser l’œuf, séparer le blanc du jaune. Mélanger le mascarpone + 1 cuillère à soupe de sucre, le jaune d’œuf et l’extrait de vanille. Monter le blanc en neige et l’intégrer au mascarpone ; mélanger doucement.', 'Dans 4 verres déposer les sablés écrasés, tasser. Couper les 2 bananes restantes en rondelles et les mettre sur les sablés. Couvrir de caramel à la banane puis de la préparation au mascarpone. Lisser et terminer avec 1 quenelle de ganache au chocolat. Réserver au frais.'], ['Râpe', 'Presse-agrumes', 'Mixeur', 'Couteau de chef'], ['Banoffee en verrines', 'entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'banoffee', 'confiserie', 'testées', 'extrait de vanille', 'facile', 'beurre salé', 'bon marché', 'sablés', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'chocolat noir', 'beurre doux', 'sucre', 'cocktail'], 'Dessert', 8aae38d8-4884-4657-9478-baa134058554, '2025-09-26T16:45:38.673416', [{'ingredient_id': '5325cb42-9564-42f6-8a33-de156621fd22', 'quantite': '6'}, {'ingredient_id': '5997efa5-5123-4eed-90f9-d75a00e74ec0', 'quantite': '3'}, {'ingredient_id': 'd753e2c1-cdca-4655-a135-ef445c940aef', 'quantite': '50 g'}, {'ingredient_id': '536c7f06-2850-45b7-9f2b-a75cd81e518d', 'quantite': '150 g'}, {'ingredient_id': '6b0a63e1-8c12-4514-a189-b5d04999df85', 'quantite': '1'}, {'ingredient_id': '31a417ec-450f-4e8e-a367-8ea52a8b5b53', 'quantite': '25 g'}, {'ingredient_id': '7893fa28-93a6-43ab-bbb2-721d99903dec', 'quantite': '15 g'}, {'ingredient_id': '863cf6f2-deb5-48d1-8679-ad9893546558', 'quantite': '75 g'}, {'ingredient_id': '8efd475c-6137-4c2e-bbab-b683cc165833', 'quantite': '7 cl'}, {'ingredient_id': 'caf59169-6cdd-4ef7-8e0a-b961018f559e', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29755, 'Bananes surprise', 'banane, jus de citron, noix de coco, sucre en poudre, crème fraîche liquide, huile, amandes effilées', '10 min', ['Pelez les bananes, coupez-les en deux dans le sens de la longueur et aspergez-les de jus de citron.', 'Dans un bol, mélangez la poudre de noix de coco, le sucre et la crème fraîche.', 'Préchauffez le barbecue ou le gril du four.', 'Enduisez chaque demi-banane du mélange à la noix de coco et déposez l''autre moitié par dessus.', 'Déposez les bananes sur des feuilles de papier d''aluminium, enduisez- les du reste de mélange coco et saupoudrez-les d''amandes effilées.', 'Refermez l''aluminium, sans trop serrer pour former une papillote.', 'Déposez sur la grille du barbecue encore chaud ou du four.', 'Retournez après 2 mn. Au bout de 5 mn environ, les bananes sont moelleuses.', 'Servir dans leur emballage avec une boule de glace vanille pour les amateurs.', 'Pour les gourmets, aspergez les bananes d''un peu de liqueur de bananes ou de mandarine (ou ajoutez au mélange coco).', 'Vous pouvez faire cuire les papillotes dans un four préchauffé à 180/200°C pendant 8 à 10 min sans les retourner.', 'Essayez, c''est surprenant en fin de barbecue avec des amis.'], ['Verre doseur', 'Moule à tarte', 'Économe', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Bananes surprise', 'très facile', 'rapide', 'plat', 'sucre en poudre', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'huile', 'dessert', 'plat de résistance', 'jus de citron', 'moyen', 'noix de coco', 'amandes effilées', 'cocktail'], 'Dessert', b006189c-35d8-4961-adfa-4ed07e78d65d, '2025-09-26T16:45:42.325832', [{'ingredient_id': '7017fe17-2025-449a-b524-ea1b7bf28089', 'quantite': '4'}, {'ingredient_id': '695c985d-ab00-406a-9a21-a0ee5e3066ce', 'quantite': '4 cuillères'}, {'ingredient_id': '6a8a5d0d-916f-41db-9317-a502ff65bdc2', 'quantite': '50 g'}, {'ingredient_id': '284b69e7-eaa2-4e29-af9d-a02a1ff06b38', 'quantite': '50 g'}, {'ingredient_id': 'd9079bc5-1497-4289-9d64-e9bc9c5bae19', 'quantite': '3 cuillères'}, {'ingredient_id': 'a7011dd1-a644-41b7-b4ad-81966d113c25', 'quantite': '1 cuillères'}, {'ingredient_id': '6c61537d-9469-44dd-a5bd-86a44d33ad16', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (337347, 'Smoothie kiwi banane fraises', 'kiwi, banane, fraises, jus de citron, miel', '10 min', ['Pelez les kiwis, et la banane. Coupez les fruits (banane, fraises et kiwis) en rondelles (grossièrement, de toute façon le tout sera mixé).', 'Versez dans un mixer, sans oublier le jus de citron vert et le miel. Et en dernier les kiwis.', 'On mixe et le tour est joué !'], ['Moule à tarte', 'Râpe'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'smoothies', 'cocktail', 'Smoothie kiwi banane fraises'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:45:46.397623', [{'ingredient_id': '818becdd-124d-461e-a2ed-518df1cf6bba', 'quantite': '5'}, {'ingredient_id': 'dd68998d-34cb-4e59-b505-9fd371030f34', 'quantite': '1'}, {'ingredient_id': 'a14e0475-2734-4408-83c3-ee277b58a7c0', 'quantite': '10'}, {'ingredient_id': 'b0cb1480-63b5-4242-8539-234b2596a1f7', 'quantite': '5 cl'}, {'ingredient_id': 'fe3c89e0-310f-44f6-8827-77db42a46c25', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (63713, 'Chausson pommes bananes au thym', 'pâte feuilletée, pomme, banane, miel, Fleurs, thym, beurre, amandes effilées, jaune d''oeuf', '15 min', ['Allumer le four à 200°C (thermostat 6-7).', 'Couper les bananes en tranches et les pommes pelées en lamelles.', 'Dans une poêle, faire revenir dans du beurre les pommes puis les bananes, jusqu''à l''obtention d''une consistance molle mais pas encore en compote. ', 'A la fin de la cuisson, retirer du feu, rajouter le miel, le thym finement haché, et les fleur de lavandes (peu car beaucoup de parfum).', 'Ajouter la moitié des amandes.', 'Beurrer un peu la pâte feuilletée, déposer des amandes sur la moitié du disque, puis la préparation pommes-bananes. Replier la pate sur elle même pour former un chausson en soudant bien les bords.', 'On peut aussi faire 4 chaussons individuels.', 'Badigeonner de jaune d''oeuf délayé dans un peu d''eau, courvrir du reste d''amandes.', 'Faire 25 minutes au four préchauffé à 200°C (thermostat 6-7).'], ['Râpe', 'Planche à découper', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'Fleurs', 'dessert', 'plat de résistance', 'pâte feuilletée', 'pomme', 'beurre', 'thym', 'Chausson pommes bananes au thym', 'amandes effilées', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:45:51.656990', [{'ingredient_id': 'bea8ce41-c956-4cfb-a751-d89d299b176d', 'quantite': '1'}, {'ingredient_id': 'd4558272-45bb-4081-b8be-4b6ad03b3170', 'quantite': '3'}, {'ingredient_id': '6ca91378-8e63-4e0e-b20e-f81922636bc6', 'quantite': '2'}, {'ingredient_id': '4dd1752c-83c4-4bf2-9262-ce9c71345ffb', 'quantite': '2 cuillères'}, {'ingredient_id': '2270d1a1-01b7-41da-af8f-45643e99b3be', 'quantite': ''}, {'ingredient_id': '655ba24a-39a1-4036-a3d4-6ea9c44b3983', 'quantite': ''}, {'ingredient_id': '98b5fa34-c192-47e7-aef3-03ca52b4418b', 'quantite': ''}, {'ingredient_id': '5469fb9a-0695-4d57-92ff-5b7d0acc2ffe', 'quantite': '1'}, {'ingredient_id': '74d8c594-bf2e-4b12-9ff0-e803449af689', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56753, 'chocolat-banana', 'chocolat, banane, biscuits à la cuillère', '10 min', ['Faites fondre le chocolat pendant à peine 1 min.', 'Pendant ce temps écrasez les 4 bananes puis, ajoutez le chocolat.', 'Ajoutez-y les 4 biscuits à la cuillère, écrasés en tous petits morceaux.'], ['Tire-bouchon', 'Casserole', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'biscuits à la cuillère', 'très facile', 'chocolat-banana', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:45:55.196777', [{'ingredient_id': 'ba20e207-93d8-471f-a6c4-42901106d93d', 'quantite': '120 g'}, {'ingredient_id': 'b0b98a02-5bda-4d64-9ccd-9e0bf343c0ea', 'quantite': '4'}, {'ingredient_id': 'f62805c1-7c49-4cce-bf21-bc9452c94cee', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61994, 'Porc des îles aux bananes et à l''ananas', 'côte de porc, ananas, banane, noix de coco rapée, cube de bouillon, curry, margarine, poivre, sel', '10 min', ['Tailler les côtes de porc en cubes.', 'Les faire revenir dans une sauteuse ou une grande casserole avec la margarine pendant deux minutes.', 'Ajouter le jus d''ananas et un verre de bouillon chaud, saler, poivrer.', 'Ajouter une banane en rondelles et la noix de coco. Couvrir et laisser mijoter 12 minutes environ à petits bouillons.', 'Ajouter les morceaux d''ananas, la deuxième banane en rondelles, la pincée de curry et poursuivre la cuisson 3 min.', 'Servir avec du riz.'], ['Tire-bouchon', 'Batteur électrique', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cube de bouillon', 'cuisine', 'Porc des îles aux bananes et à l''ananas', 'recettes', 'boisson', 'noix de coco rapée', 'margarine', 'dessert', 'plat de résistance', 'côte de porc', 'ananas', 'poivre', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:45:58.958428', [{'ingredient_id': '814a56fb-0102-4e85-bd12-745907d40ba4', 'quantite': '4'}, {'ingredient_id': '912c1928-bf1f-4e0b-8605-6710c8a8dade', 'quantite': '1'}, {'ingredient_id': '1e75a3b3-d543-4540-b527-6038b011f813', 'quantite': '2'}, {'ingredient_id': 'af7614e7-6464-4fda-b23f-c451f8faf4fa', 'quantite': '1 cuillères'}, {'ingredient_id': '740b4c05-21d6-49a5-9ce3-9a56088b237e', 'quantite': '1'}, {'ingredient_id': '43f45146-1085-4f88-bdb4-c7343a97e5c6', 'quantite': '1'}, {'ingredient_id': '1fa43fbc-b575-41d1-969c-a9bba7966619', 'quantite': '1 cuillères'}, {'ingredient_id': 'dbed9475-cde4-44bb-981c-a0c88e0274be', 'quantite': ''}, {'ingredient_id': '6236952a-0225-425b-aafa-bc8798a5764b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15030, 'Banane au chocolat (micro-ondes)', 'banane, cacao', '2 min', ['Couper la bananne dans la longueur.', 'Placer le fruit dans une assiette. Saupoudrer de cacao.', 'Mettre au four à micro-ondes pleine puissance pendant 1 à 2 minutes. C''est prêt!'], ['Couteau de chef', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'cacao', 'rapide', 'plat', 'Banane au chocolat (micro-ondes)', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:46:02.856849', [{'ingredient_id': 'd93137c6-e8bb-42fd-95ba-dcccd349c94a', 'quantite': '1'}, {'ingredient_id': '7dbd7ef4-2006-47ee-81c9-6e50d604c570', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56235, 'Liqueur des iles', 'orange, citron, clémentine, banane, jus d''ananas, sucre semoule, alcool pour fruits, lait', '30 min', ['Piquer à la pointe d''un couteau tous les fruits et mettre dans un bocal pouvant contenir 3 litres.', 'Ajouter le lait le sucre, le jus d''ananas , le litre d''alcool et', 'mettre à macérer durant 3 mois en remuant le bocal tous les jours jusqu''à dissolution complète du sucre.', 'Attendre trois mois : filtrer, presser légèrement les fruits, passer au chinois.', 'C''est un régal !'], ['Moule à tarte', 'Balance de cuisine', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Liqueur des iles', 'testées', 'très facile', 'alcool pour fruits', 'rapide', 'plat', 'recette', 'liqueur', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'clémentine', 'dessert', 'plat de résistance', 'jus d''ananas', 'moyen', 'citron', 'orange', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:46:06.538590', [{'ingredient_id': '36b0c6fb-eae8-4597-accf-69081a5234dc', 'quantite': '1'}, {'ingredient_id': '40a98d5e-5e5c-476a-9db6-98938422b4bd', 'quantite': '1'}, {'ingredient_id': 'fe11dfea-d5ba-4e3e-89b4-043541e4d16d', 'quantite': '1'}, {'ingredient_id': '98d2e914-3129-4dc2-b22f-ec5f6d55bed4', 'quantite': '1'}, {'ingredient_id': 'bda128de-e5e2-4712-9950-1d24b33069a6', 'quantite': '20 cl'}, {'ingredient_id': '05ff0521-8b48-40ab-a5fb-2eed2b11cdbf', 'quantite': '1 kg'}, {'ingredient_id': '2c67ecfe-5dab-4e23-bec1-55171eb77dd3', 'quantite': '1 l'}, {'ingredient_id': 'dd9365fc-a0e2-464c-a8c6-44a981eb63ed', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (232040, 'Fondant nutella banane', 'banane, Nutella, sucre, farine, beurre, blanc d''oeuf, levure', '30 min', ['Préchauffer le four à 200°C (thermostat 6-7).', 'Séparez les blancs des jaunes d''œufs.', 'Avec un fouet électrique, montez les blancs en neige et mettez-le de coté.', 'Versez la farine dans un saladier et ajoutez le sucre et la levure.', 'Faites fondre le beurre au micro-onde, puis ajoutez le dans le saladier.', 'Incorporez les blancs en neige dans le saladier et remuez.', 'Coupez les bananes en rondelles.', 'Beurrez le moule, ajoutez les bananes dans le moule, versez la préparation.', 'Enfournez pour 10 à 12 minutes. '], ['Fouet', 'Couteau de chef', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Fondant nutella banane', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'Nutella', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'blanc d''oeuf', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:46:10.278034', [{'ingredient_id': '7cd10299-9285-4ac3-9df2-255f9e3bf661', 'quantite': '2'}, {'ingredient_id': '083afcae-76e0-4189-8672-b8b5a4ccd255', 'quantite': '30 g'}, {'ingredient_id': '8f88520f-8294-49a8-ac87-98ab6ee23bdb', 'quantite': '75 g'}, {'ingredient_id': '102a859c-f1b3-4f54-a28c-2489ce848454', 'quantite': '150 g'}, {'ingredient_id': '5473d0b3-ddaf-4f52-aa03-43539e56a643', 'quantite': '50 g'}, {'ingredient_id': '239e00d1-6896-43e7-8d28-0d7b3b5bd23f', 'quantite': '4'}, {'ingredient_id': 'f8ba080d-f1c3-408f-93c7-e2d431e45145', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (332555, 'Petit-déjeuner Automnal', 'petit suisse, banane, pomme, clémentine, noix, miel, petit pain suédois', '15 min', ['Dans une assiette à dessert, écraser la banane et le petit-suisse, pour obtenir le savoureux mélange : petit Suisse + banane écrasée.', 'Broyer grossièrement les cerneaux de noix et les ajouter au mélange précédent. Bien mélanger.', 'Disposer sur les contours de l''assiette les quartiers de clémentine. Trancher la pomme en lamelles et les disposer au centre du mélange, en cercle.', 'Bien répartir le miel sur toute l''assiette, avant de servir ce "petit-déjeuner", accompagné des petits pains suédois.', 'Bon Appétit !'], ['Ouvre-boîte', 'Batteur électrique'], ['', 'entrée', 'banane', 'Petit-déjeuner Automnal', 'recettes de cuisine', 'confiserie', 'petit suisse', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'noix', 'miel', 'recettes', 'boisson', 'clémentine', 'dessert', 'plat de résistance', 'pomme', 'petit pain suédois', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:46:13.842540', [{'ingredient_id': '08f23073-c0b2-45f7-8076-e1be0b7accc8', 'quantite': '2'}, {'ingredient_id': '729c13e6-0ded-4fa9-acd4-733b5eb078c8', 'quantite': '1'}, {'ingredient_id': '7f714327-71ac-429f-96c0-910f6d145a72', 'quantite': ''}, {'ingredient_id': '596f39d4-84c3-4fc5-80de-362abdb07adc', 'quantite': '1'}, {'ingredient_id': '58816fa5-4dab-4611-954c-7b684d280db5', 'quantite': '3'}, {'ingredient_id': 'a856f122-5068-429e-a388-c8f6fc3300f2', 'quantite': '1 cuillères'}, {'ingredient_id': 'bcaed320-16f3-4b68-9407-bae5ae129e50', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (217841, 'Poulet à la banane et aux lardons', 'banane, lardons, blanc de poulet, oignon, sel, poivre', '10 min', ['Faire revenir les lardons avec les oignons coupés en fines lamelles (pas besoin d''ajouter de la graisse, il y a celle des lardons).', 'Couper les blancs de poulet en petits bouts, les ajouter aux lardons/oignons.', 'Ajouter les bananes en grosse lamelles, laisser revenir une petite dizaine de minutes, saler, poivrer, déguster !'], ['Planche à découper', 'Casserole', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'Poulet à la banane et aux lardons', 'lardons', 'bon marché', 'plat', 'blanc de poulet', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:46:19.235390', [{'ingredient_id': 'a98b9f80-d404-4ae9-93db-13877db171e6', 'quantite': '2'}, {'ingredient_id': 'a510d0fc-39e9-437d-a22a-441c489646f6', 'quantite': '100 g'}, {'ingredient_id': '639bf36e-f150-4426-9167-c548b52cef4c', 'quantite': '3'}, {'ingredient_id': '998f8b7f-51e1-4804-b2e3-f362ee659ce1', 'quantite': '2'}, {'ingredient_id': 'feabf5c2-d8bc-418a-9d65-b0aaab13e01a', 'quantite': ''}, {'ingredient_id': '8e845726-9bc5-45b4-9fd9-6dfc07b598ad', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46443, 'Gâteau créole', 'oeuf, sucre semoule, sucre vanillé, farine, levure chimique, beurre, raisins secs, rhum, banane, ananas, sel', '15 min', ['Faire macérer les raisins dans le rhum, le temps de la préparation de la pâte.', 'Battre ensemble les oeufs, les sucres et le sel, jusqu''à obtention d''un mélange mousseux.', 'Ajouter la farine, la levure, le beurre fondu, et mélanger.', 'Incorporer à la pâte les bananes en rondelles et les ananas égouttés et coupés en morceaux, puis en dernier les raisins (avec le rhum).', 'Verser la préparation dans un moule à manqué beurré et fariné, et faire cuire environ 45 min à four moyen (180°C/th 6).'], ['Balance de cuisine', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'levure chimique', 'très facile', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'Gâteau créole', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'moyen', 'beurre', 'ananas', 'raisins secs', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:46:23.072387', [{'ingredient_id': '48d84da2-d5f4-47c2-a07c-6e91116cbff4', 'quantite': '3'}, {'ingredient_id': 'fac95455-f34a-4fac-8e80-74a7d04fcd88', 'quantite': '75 g'}, {'ingredient_id': '3d865b79-1ab0-44d3-9f8c-b39c6a3fd8c2', 'quantite': '1'}, {'ingredient_id': '04b816d7-4dbd-44a0-825d-8a107e443e7c', 'quantite': '100 g'}, {'ingredient_id': '026a03ca-b1cc-46fe-9822-30dc7dc04844', 'quantite': ''}, {'ingredient_id': '420301e1-2978-4b58-9489-0e177b5fcf1d', 'quantite': '100 g'}, {'ingredient_id': 'ff1f2df7-9cf8-4fe3-bd44-443f66aa2d77', 'quantite': '100 g'}, {'ingredient_id': '6a7ca917-13bc-49b9-9f81-9b1212d33064', 'quantite': '5 cl'}, {'ingredient_id': '3e7510e2-7af6-408f-8157-c7cf0a475b2e', 'quantite': '3'}, {'ingredient_id': '9881cdc9-8160-4a3b-b3e6-4cd504c80c60', 'quantite': '1'}, {'ingredient_id': 'b6a03ba9-1f52-47fd-b472-54e23cb487d8', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11099, 'Poulet à la moambé', 'poulet, huile d''arachide, oignon, poivre, sel, Pili Pili, laurier, Saka-Saka, riz, banane', '30 min', ['Couper le poulet en morceaux et le faire frire dans un peu d''huile. Saler et poivrer.', 'Mettre dans une casserole assez grande pouvant contenir le poulet avec la sauce.', 'Dans la poêle où a rôti le poulet, faire fondre un gros oignon émincé puis le rajouter dans la casserole avec une belle feuille de laurier.', 'Verser sur le tout la sauce moambe et mettre à feu doux.', 'L''ensemble doit mijoter tout doucement pendant environ 45 min (le poulet doit être bien cuit).', 'Assaisonner de sel et poivre selon votre goût et, éventuellement, mettre du pili pili (pour palais avertis seulement !).', 'Pendant la cuisson du poulet, vous noterez que de l''huile remonte à la surface : ayez soin d''en prélever environ une louche moyenne que vous ', 'verserez dans une petite casserole.', 'Faites-y fondre un petit oignon émincé et ajoutez le saka saka,une feuille de laurier, salez, poivrez et faites chauffer à feu doux (le légume est déja cuit quand il est mis en boîte).', 'Servir le poulet avec du riz pilaf, les légumes, la sauce (plus il y en a, meilleur c''est !).', 'Proposez des bananes en rondelles en accompagnement. Recette PAS LIGHT du tout, mais un vrai régal.'], ['Râpe', 'Moule à tarte', 'Pince de cuisine'], ['', 'laurier', 'poulet', 'entrée', 'huile d''arachide', 'recettes de cuisine', 'Poulet à la moambé', 'sel', 'confiserie', 'testées', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'Pili Pili', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:46:27.786282', [{'ingredient_id': '8f4fb3a4-2b14-4a43-b690-12bd7e8c5b59', 'quantite': '1'}, {'ingredient_id': 'c9fd3475-39ff-4eca-a837-034b663db5a6', 'quantite': ''}, {'ingredient_id': '268e3894-6170-45e0-b1e1-0f2af484e63a', 'quantite': '1'}, {'ingredient_id': 'e094d102-2d4d-4c80-b6f5-6ea304fc16fb', 'quantite': ''}, {'ingredient_id': '543c916a-b07d-42b0-8e39-d78521cc462b', 'quantite': ''}, {'ingredient_id': '67e18ac4-6155-4356-b937-7c230f6d8258', 'quantite': ''}, {'ingredient_id': '11485005-93ef-4c19-8647-e0b633ff074f', 'quantite': ''}, {'ingredient_id': 'bd9d7d6c-dd28-431a-b3d4-678a6080475a', 'quantite': '1'}, {'ingredient_id': '2ef696df-11f0-4b3f-be42-4f7869552f84', 'quantite': ''}, {'ingredient_id': '2f02cfea-857c-485f-a69d-c5f56f4b8b3b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56124, 'Gâteau léger à la banane, au chocolat truffé et aux noix', 'yaourt, yaourt, farine, oeuf, huile d''arachide, banane, noix, rhum, nappage chocolat, cannelle, levure, orange, sel, sucre glace', '15 min', ['Pour le matériel, pensez à 1 saladier, 1 fouet manuel (bien mieux que la fourchette, 1 couteau économe éventuellement.', 'Préchauffer le four à 160°C (thermostat 5/6).', 'Mettre le chocolat à fondre doucement au bain-marie dans un peu de lait.', 'Pendant ce temps, vider le pot de yaourt dans le saladier puis le rincer.', 'Avec le fouet manuel, mélanger le yaourt avec le sucre puis ajouter la farine et le sel.', 'Ajouter les œufs, l''huile, le rhum, le jus d''orange (et son zeste si elle n''est pas traitée), la cannelle (sauf si le chocolat est déjà épicé), la banane écrasée, les noix hachées (éventuellement grillées) et le chocolat truffé puis mélanger (rajouter éventuellement jusqu''à 1/2 pot de farine si c''est trop liquide).', 'Ajouter la levure et mélanger pendant 1 minute.', 'Préparer le moule : mettre du papier sulfurisé dans le fond puis verser l''appareil dedans.', 'Enfourner et cuire thermostat 6/7 pendant 1h environ (veiller à le couvrir pour qu''il ne brûle pas) sans ouvrir la porte du four.', 'Lorsque le gâteau est cuit (la lame du couteau doit ressortir sèche), le laisser refroidir sur une grille.', 'On peut saupoudrer de sucre glace.'], ['Batteur électrique', 'Tire-bouchon'], ['entrée', 'banane', 'huile d''arachide', 'recettes de cuisine', 'yaourt', 'rhum', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'Gâteau léger à la banane', 'recette', 'levure', 'noix', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'au chocolat truffé et aux noix', 'orange', 'sucre glace', 'gâteau au chocolat', 'nappage chocolat', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:46:31.445541', [{'ingredient_id': '563588ea-edae-4df0-b4e2-7c4e6ebe4d18', 'quantite': '1'}, {'ingredient_id': '2dcb458b-08c1-4baf-8cb8-5874d39f5b49', 'quantite': '2'}, {'ingredient_id': '3eeef7f9-a78f-4dee-87d3-19e1b684c7b9', 'quantite': '3'}, {'ingredient_id': '0cec0c30-77f6-409c-8095-729a343f5dc8', 'quantite': '2'}, {'ingredient_id': '58de4ba2-5fc4-4516-842e-4f63038551f4', 'quantite': ''}, {'ingredient_id': '166bfab4-6e2f-440f-9243-cc70927ee7a9', 'quantite': '1'}, {'ingredient_id': '79f49b00-666c-45a7-9fd1-fab0bd477472', 'quantite': '10'}, {'ingredient_id': 'b18320ac-21d3-4530-9cf2-bd69827b21c4', 'quantite': ''}, {'ingredient_id': '5cb66597-e369-47f7-9877-8f9d1cc59884', 'quantite': '100 g'}, {'ingredient_id': 'e8014228-60ac-40be-8408-05aa855a7d02', 'quantite': ''}, {'ingredient_id': '2a320102-7078-4961-90f0-4e53bcebccf5', 'quantite': '1'}, {'ingredient_id': 'a4ab14de-57f1-4956-9cae-75ccfaa5691b', 'quantite': ''}, {'ingredient_id': '7e7954d9-d46f-406d-a07a-6cfa4ef0b921', 'quantite': '1'}, {'ingredient_id': 'c42fea2c-2de8-4d9e-b3a1-d76a9ac60413', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68951, 'Tarte chocolat purée de banane', 'banane, sucre, chocolat noir, oeuf, beurre, pâte sablée, cannelle', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Faire fondre au micro-ondes le chocolat et le beurre, ajouter 1 cuillère à soupe d''eau.', 'Ajouter le sucre, l''oeuf entier et les deux jaunes d''oeufs. Tout mélanger.', 'Etaler la pâte au fond du plat allant au four.', 'Ecraser les bananes, les étaler sur la pâte, mettre une pincée de cannelle.', 'Ajouter la préparation au chocolat !!!', 'Enfourner pour 25 minutes de cuisson. Voilà, c''est prêt.'], ['Râpe', 'Spatule', 'Poêle'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Tarte chocolat purée de banane', 'dessert', 'plat de résistance', 'chocolat noir', 'beurre', 'cannelle', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:46:35.078323', [{'ingredient_id': 'b321f78f-36bc-4867-a173-722a66ecb2dc', 'quantite': '3'}, {'ingredient_id': 'dd82fc43-e1a6-45ef-a782-03371176d81b', 'quantite': '30 g'}, {'ingredient_id': '2c1f1eb9-afd4-47e2-889d-cb17e8ae7c45', 'quantite': '200 g'}, {'ingredient_id': '41d59db1-f80e-4d41-a61d-0fc0ed67a161', 'quantite': '1'}, {'ingredient_id': '48d69951-1ef0-49f2-a9a8-4e8b43e0aaa5', 'quantite': '100 g'}, {'ingredient_id': '1c1b451d-2cd4-4364-ba8a-b4cc0a4b5022', 'quantite': '1'}, {'ingredient_id': 'c53ae7c0-10b2-451f-a429-36528a0282ba', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55479, 'Pâtes à la banane', 'tagliatelles, banane, crème, piment, poivre', '10 min', ['Faire cuire les pâtes. Préparer une sauce avec les bananes écrasées, un peu de crème, du poivre et quelques graines de piment.', 'Attention, la sauce ne doit pas vraiment être liquide!'], ['Pince de cuisine', 'Batteur électrique', 'Mixeur', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'Pâtes à la banane', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'crème', 'recette', 'piment', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'poivre', 'tagliatelles', 'cocktail', 'autres pâtes'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:46:38.697384', [{'ingredient_id': '505377f9-50b2-4f36-b400-819e7c15635b', 'quantite': ''}, {'ingredient_id': 'b31ddc58-cbe5-4932-9ec4-c64c63df7469', 'quantite': '2'}, {'ingredient_id': 'e048158d-ea26-44ea-b5a6-ffbb494abbe2', 'quantite': ''}, {'ingredient_id': '36a14ab8-b72b-4956-8352-db4907c9c082', 'quantite': ''}, {'ingredient_id': 'b897d5df-790d-46c4-b8e4-6c7fcd8183fd', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169798, 'Gâteau au yaourt rhubarbe - banane', 'yaourt nature, oeuf, sucre, farine, huile, sucre vanillé, levure, rhubarbe, banane', '10 min', ['Pour info, on utilise le pot de yaourt vide comme pot "mesure"', 'Nettoyer la rhubarbe et la couper en petits dés, éplucher et couper la banane en rondelles.', 'Préparer la pâte à gâteau : vider le pot de yaourt dans un saladier, y mettre les œufs et les sucres, mélanger bien l''ensemble au fouet. Ajouter un pot de farine à la fois, en mélangeant bien entre chaque pot pour éviter les grumeaux. Ajouter l''huile, mélanger, mettre la levure.', 'Verser les fruits sur cette belle pâte et mélanger délicatement.', 'Verser dans un moule à manqué ou à cake, préalablement huilé.', 'Faire cuire environ 40 min à 225°C (thermostat 7-8).'], ['Mixeur', 'Balance de cuisine', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'rhubarbe', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'Gâteau au yaourt rhubarbe - banane', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'gâteau à la banane', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:46:42.336013', [{'ingredient_id': '3cf83ce0-df8b-40b6-967a-6d6daedc9483', 'quantite': '1'}, {'ingredient_id': 'f5a9cb3b-bb6a-4dc3-8d3b-32b49d0ad685', 'quantite': '3'}, {'ingredient_id': '5cc5bdf1-2845-4977-88c9-f3418841fb33', 'quantite': '2'}, {'ingredient_id': '7b90208e-5710-435a-ab62-cfa2c2224353', 'quantite': '3'}, {'ingredient_id': '17d969c2-6555-4daa-b7e1-372c21a15326', 'quantite': ''}, {'ingredient_id': 'e9476997-f9d3-4183-9f9c-79c98dcc34b6', 'quantite': '1'}, {'ingredient_id': 'c7baeb0d-7c99-42d4-94d8-65b58cadbb75', 'quantite': '1'}, {'ingredient_id': '5ba6cab5-4e42-465e-824a-f8b28b9efa3c', 'quantite': '5'}, {'ingredient_id': '6f878baa-c239-4a9b-863d-758187920e95', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27384, 'riz rouge et bananes au lard', 'banane, lard, oignon, riz, coulis de tomate, ail, huile d''olive, moutarde, herbes de Provence, poivre, sel', '15 min', ['Faire revenir l''oignon émincé dans l''huile dans un wok ou une petite cocotte. ', 'Eplucher les bananes et les enrouler dans les tranches de lard badigeonnées de moutarde. Les faire cuire à feux très doux dans une poêle avec un peu d''huile. ', 'Ajouter l''ail dans le wok, ainsi que le coulis de tomate, 2 tasses d''eau et du sel. Porter à ébullition. ', 'Ajouter le riz, couvrir en laissant entr''ouvert, mélanger de temps en temps et laisser mijoter 20 mn à feu très doux. ', 'En fin de cuisson ajouter les herbes de Provence et assaisonner suivant votre goût. ', 'Servir bien chaud accompagné des bananes au bacon.'], ['Passoire', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'herbes de Provence', 'oignon', 'boisson', 'lard', 'plat de riz', 'huile d''olive', 'dessert', 'plat de résistance', 'riz', 'moutarde', 'poivre', 'riz rouge et bananes au lard', 'coulis de tomate', 'cocktail'], 'Plat principal', 122749ad-fa47-477e-8121-2f4ecd605861, '2025-09-26T16:46:45.980060', [{'ingredient_id': '4dbacf03-f940-478e-aeb9-547daeb8aefb', 'quantite': '4'}, {'ingredient_id': '936b780a-414e-40e2-b792-f03d27157794', 'quantite': ''}, {'ingredient_id': 'ccbb6181-382e-430b-939e-062a6e795774', 'quantite': '1'}, {'ingredient_id': '29144166-6a23-4dfb-b07d-d29dbe3230ca', 'quantite': '1.5'}, {'ingredient_id': 'f47098f5-58f1-4ef7-9017-66ec9fedc783', 'quantite': '1'}, {'ingredient_id': 'dfc0ac77-2e77-4a1a-bac5-31d96b5e111d', 'quantite': '1'}, {'ingredient_id': 'ef85e0b8-c16a-461a-9c03-ff0e8df0a3c6', 'quantite': ''}, {'ingredient_id': '4663ec73-c3ad-4304-b8f8-6300a8e2f05a', 'quantite': ''}, {'ingredient_id': '1ed64a67-ac3f-457f-9338-6ad002a30b43', 'quantite': ''}, {'ingredient_id': 'a01cd4a9-e1d7-47d9-8ecb-9d9316d58850', 'quantite': ''}, {'ingredient_id': '106d0b84-c85b-41d2-9d76-09dcb10db627', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13498, 'Milkshake glacé à la banane', 'banane, lait, glace vanille', '5 min', ['Par personne, mixer une banane bien mûre avec un verre de lait et une boule de glace à la vanille.'], ['Presse-agrumes', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Milkshake glacé à la banane', 'glace vanille', 'dessert', 'plat de résistance', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:46:51.800121', [{'ingredient_id': 'fffd3939-2c64-4075-9524-2dae6b77ed98', 'quantite': '1'}, {'ingredient_id': '9657f627-9c71-4eb1-a9af-d42354366850', 'quantite': '40 cl'}, {'ingredient_id': '3eaefaa3-d6c7-4b34-b480-ec1c0007a10c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528653, 'Gâteau à la banane moelleux', 'beurre doux, sucre, farine de blé, oeuf, lait, arôme vanille, banane, levure chimique, chocolat noir', '20 min', ['Préchauffer le four à 180°C.', 'Faire fondre le beurre.
Ajouter le beurre et le sucre dans un saladier et battre au fouet.', 'Ajouter le lait et mélanger. ', 'Ajouter la farine, la levure chimique et l''arôme de vanille puis mélanger.', 'Ajouter les oeufs et mélanger. ', 'Écraser les bananes à la fourchette puis les incorporer à la préparation. (Les bananes doivent être bien mûres).', 'Facultatif: ajouter des pépites de chocolat noir.', 'Mettre au four à 180°C pendant 30 minutes. '], ['Passoire', 'Poêle', 'Balance de cuisine', 'Verre doseur', 'Louche'], ['entrée', 'banane', 'Gâteau à la banane moelleux', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'facile', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'farine de blé', 'chocolat noir', 'arôme vanille', 'gâteau à la banane', 'moyen', 'beurre doux', 'sucre', 'lait', 'cocktail'], 'Dessert', 5df54465-08a8-4be6-835d-5314c85d7101, '2025-09-26T16:46:57.474347', [{'ingredient_id': '97c4720a-0399-440c-bc5a-e4dd73c297e8', 'quantite': '100 g'}, {'ingredient_id': 'd828d689-2a7d-44cb-8d33-56fcb8bfba69', 'quantite': '100 g'}, {'ingredient_id': 'efea1179-81b9-41d5-a9d6-9a2afc5a8c5b', 'quantite': '200 g'}, {'ingredient_id': 'c3e0c95b-bf9b-435f-9b54-6804e8c52236', 'quantite': '3'}, {'ingredient_id': 'c175addd-e1db-45cd-98d8-b8e9974e8e97', 'quantite': '10 cl'}, {'ingredient_id': '8cef388c-5e1e-4811-bbe6-0911f0a86b5a', 'quantite': '1 cuillères'}, {'ingredient_id': '4deff86a-fa1d-4885-b9fb-23a30537658d', 'quantite': '2'}, {'ingredient_id': '3f3688f5-e2c5-4cf8-a73c-f7e11c5f15ab', 'quantite': '1'}, {'ingredient_id': 'b08fe4b2-629c-47ac-86ea-c2910bfec590', 'quantite': '40 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36286, 'Bûche à la banane et au chocolat', 'biscuits à la cuillère, crème dessert au chocolat, oeuf, banane, café, crème fraîche, lait, crème dessert au chocolat', '30 min', ['Pour la bûche:', 'Préparer une mousse au chocolat avec le chocolat et les oeufs:', 'Faire fondre le chocolat avec 4 cuillères à soupe d''eau, séparer les jaunes des blancs. Battre les blancs en neige ferme.', 'Mélanger le chocolat avec les jaunes. Incorporer délicatement les blancs au mélange et réserver au frigo 4h minimum. (vous pouvez la faire la veille pour un déjeuner ou le matin tôt pour un dîner)', 'Tremper les biscuits cuiller dans le café.', 'Tapisser les côtés d''un moule à charlotte ou un moule à cake, pour ce dernier, couper les bouts qui dépassent et tapisser le fond du moule avec les bouts découpés.', 'Disposer une couche de bananes en rondelles, puis une de mousse au chocolat etc, jusqu''à ras bord. ', 'Finir avec une couche de biscuits.', 'Pour un moule à cake, passer un plat long sur le moule pour tasser la bûche et mettre au frigo pendant environ 3 heures.', 'Pour la sauce, juste avant de servir:', 'Faire fondre le chocolar avec le lait.', 'Ajouter la crème fraîche et réchauffer doucement la sauce.', 'Napper la bûche ou la charlotte démoulée de cette sauce.'], ['Passoire', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'biscuits à la cuillère', 'très facile', 'bon marché', 'bûche au chocolat', 'rapide', 'oeuf', 'Bûche à la banane et au chocolat', 'plat', 'recette', 'café', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'crème dessert au chocolat', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:47:03.851211', [{'ingredient_id': '047d75e8-d06f-41b4-a1b5-8d4278b94ce1', 'quantite': '20'}, {'ingredient_id': '9b345360-707f-4b98-8891-08b8a08be260', 'quantite': '100 g'}, {'ingredient_id': 'f2b30546-5afa-41f2-a32e-fc5a358b82a6', 'quantite': '3'}, {'ingredient_id': '9417ccb6-bc36-4db1-81a8-4444fe3e9846', 'quantite': '4'}, {'ingredient_id': '5fd0d6ca-4f65-4231-befb-0fa3317ef8ff', 'quantite': '20 cl'}, {'ingredient_id': '263b34e4-6401-4be4-b743-9b470039c180', 'quantite': '3 cuillères'}, {'ingredient_id': '53ed124c-bc2a-41e2-96f9-b4fa886f2d94', 'quantite': '2 cuillères'}, {'ingredient_id': 'fab0954b-19db-4e28-90bd-0f47d6ae3125', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (71909, 'sancocho', 'cuisse de poulet, manioc, banane plantain, pomme de terre, oignon, tomate, bouillon de poule, cumin, poivre, sel, Fines herbes, huile d''olive, colorant alimentaire, coriandre', '15 min', ['Dans un fait-tout, faire revenir l''oignon coupé en petits dés dans l''huile d''olive, ajouter les tomates également coupées en petits dés. Assaisonner avec sel, poivre, cumin, herbes et le cube maggi. ', 'Ajouter les cuisses de poulet et le yucca coupées en morceaux après avoir enlevé la peau et la nervure centrale. ', 'Ajouter 2 tasses d''eau et laisser cuire 10 à 15 min.', 'Ensuite, ajouter les pommes de terre coupées en rondelles d''1 cm de large, laisser cuire encore 5 min puis ajouter la banane plantain verte cassée en  assez gros morceaux. Laisser cuire encore 5 min. ', 'On peut ajouter un peu de colorant alimentaire pour donner au plat une jolie couleur. ', 'Enfin ciseler un peu de coriandre fraîche au dessus du plat.'], ['Pince de cuisine', 'Tire-bouchon', 'Mixeur'], ['', 'bouillon de poule', 'entrée', 'recettes de cuisine', 'Fines herbes', 'sel', 'confiserie', 'testées', 'cumin', 'facile', 'tomate', 'plat', 'recette', 'colorant alimentaire', 'cuisine', 'recettes', 'cuisse de poulet', 'oignon', 'boisson', 'manioc', 'huile d''olive', 'dessert', 'plat de résistance', 'sancocho', 'banane plantain', 'moyen', 'coriandre', 'poivre', 'pomme de terre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:47:07.552943', [{'ingredient_id': '5bec6a71-5658-4fbe-85b5-12902443313a', 'quantite': '4'}, {'ingredient_id': '5d8ee618-0de3-4b9f-9935-bc6b973cbecd', 'quantite': '1'}, {'ingredient_id': '4c2eb59e-3686-441a-985a-06da7b4d13e9', 'quantite': '1'}, {'ingredient_id': '001c9565-d744-45e9-8036-12c81237595b', 'quantite': '3'}, {'ingredient_id': '4ecdd58e-95ae-417d-acd2-a662add83004', 'quantite': '1'}, {'ingredient_id': '86cb875f-2df1-4660-b64d-b931e8599912', 'quantite': '2'}, {'ingredient_id': 'e656cfeb-0a65-43f4-b779-768621ac651b', 'quantite': '1'}, {'ingredient_id': '75e2d2d5-4f72-4b67-aa2e-ef29a5b4343b', 'quantite': ''}, {'ingredient_id': '254307cb-fcd6-47cd-bede-08d352a87e67', 'quantite': ''}, {'ingredient_id': '78a385f2-c969-4f21-9a68-c38d8603bf63', 'quantite': ''}, {'ingredient_id': '5ef151f4-68e3-4d1f-b1ea-d739793e8848', 'quantite': ''}, {'ingredient_id': '39982539-5923-4d9f-bc76-18bec183a8f7', 'quantite': '2 cuillères'}, {'ingredient_id': 'acb5a458-6a2e-4e5e-9203-5115ec640915', 'quantite': ''}, {'ingredient_id': '4feab9c4-7166-46c5-88f1-4a312eecb1ef', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14381, 'Gâteau à la banane et aux épices', 'yaourt nature, farine, sucre, sucre roux, beurre, levure, oeuf, cannelle, mélange 4 épices, banane', '10 min', ['Mélanger tous les ingrédients (sauf la banane) au batteur (la pâte est ainsi plus lisse) ', 'et incorporer la banane coupée en morceaux. ', 'Verser dans un plat à cake et cuire à thermostat 6-7 pendant 40 mn.'], ['Pince de cuisine', 'Tire-bouchon', 'Râpe', 'Batteur électrique', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'mélange 4 épices', 'cuisine', 'levure', 'recettes', 'boisson', 'Gâteau à la banane et aux épices', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'beurre', 'cannelle', 'sucre', 'cocktail', 'sucre roux'], 'Dessert', 028895c0-12c3-4bc7-a818-8a6617175349, '2025-09-26T16:47:12.456973', [{'ingredient_id': 'c20fdc9b-0eb7-47a4-81e1-dd6979905672', 'quantite': '1'}, {'ingredient_id': '2762a73f-7e59-4825-9fa8-24f2111f3248', 'quantite': '3'}, {'ingredient_id': '72cd5f88-c1f6-4fab-addd-6a7591f240a2', 'quantite': '1'}, {'ingredient_id': 'c80a9f0e-737a-4389-8453-be17c833ff85', 'quantite': '1.5'}, {'ingredient_id': 'f9233b1a-591a-4036-b9f5-a5d7a56d8937', 'quantite': '50 g'}, {'ingredient_id': '72a7c873-537a-4993-b949-97124954c39b', 'quantite': ''}, {'ingredient_id': 'ccf7d090-ca0c-425c-bb46-0cb3309dd612', 'quantite': '3'}, {'ingredient_id': 'a66e6e5e-a961-40d9-8efe-fbc3301ddd99', 'quantite': '3 cuillères'}, {'ingredient_id': '28f96c8f-92bb-4f8b-934d-1dd3b140ba55', 'quantite': '2 cuillères'}, {'ingredient_id': 'a4a79997-84da-4f22-a907-4e70493e4de8', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (194391, 'Verrine poire banane pépites de chocolat', 'poire, banane, beurre demi-sel, crème allégée, sucre vanillé, cassonade, chocolat, crème chantilly, vermicelles', '20 min', ['Éplucher les fruits puis couper les poires en dés et les bananes en rondelles.', 'Mettre une noix de beurre dans une poêle et le faire fondre.', 'Ajouter les dés de poires et les rondelles de bananes dans la poêle.', 'Éparpiller la moitié du sachet de sucre vanillé sur les fruits et les faire revenir.', 'Si ce n''est pas suffisamment sucré (selon les goûts de chacun), ajouter une cuillère à café de cassonade.', 'Dans un bol, verser la crème légère, puis mélanger l''autre moitié du sachet de sucre vanillé.', 'Dans des verrines, alterner le mélange poires-bananes tiédis, une cuillère de crème légère sucrée, des pépites de chocolat.', 'Arriver à la fin, ajouter de la chantilly, puis, pour la décoration, ajouter des vermicelles de chocolat.'], ['Couteau de chef', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Verrine poire banane pépites de chocolat', 'cassonade', 'chocolat', 'poire', 'facile', 'vermicelles', 'bon marché', 'rapide', 'plat', 'crème allégée', 'recette', 'cuisine', 'recettes', 'beurre demi-sel', 'crème chantilly', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:47:16.125130', [{'ingredient_id': '4b931e0a-8f14-40b8-a90d-9aa379706ba3', 'quantite': '3'}, {'ingredient_id': '39136e3b-0afe-44ca-bdf0-501bc5d0cbd8', 'quantite': '2'}, {'ingredient_id': '8df4b7e0-f75e-4be1-8fad-14f751bc22fd', 'quantite': '1'}, {'ingredient_id': '75977a0c-195c-4012-80dd-aa46c46dcae3', 'quantite': '10 cl'}, {'ingredient_id': '6bd466e8-9858-4c3e-aa64-86295d4f342c', 'quantite': '1'}, {'ingredient_id': '26639483-c768-4c9e-a238-0d353bb396e9', 'quantite': '2 cuillères'}, {'ingredient_id': '9c898f89-e54a-4689-9be7-0e2e85a5b9c1', 'quantite': '1'}, {'ingredient_id': '36f482ba-8746-4296-9777-61db9d79ebaf', 'quantite': ''}, {'ingredient_id': 'b9bd3cc3-3595-438d-9f78-102b19faa9f6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28088, 'salade de fraises aux bananes', 'fraises, banane, orange, citron, sucre en poudre', '5 min', ['Lavez les fraises, séchez-les puis équeutez-les. ', 'Couper les fraises en deux ou en quatre si elles sont grosses. ', 'Pelez les bananes et découpez-les en fines tranches. ', 'Arosez les bananes avec le jus de citron. ', 'Pressez l''orange. ', 'Dans un saladier, mélangez les fraises, les bananes, le jus d''orange et le sucre. ', 'Mettez au réfrigérateur jusqu''au service.'], ['Planche à découper', 'Louche', 'Spatule', 'Couteau de chef', 'Râpe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'salade de fraises aux bananes', 'dessert', 'plat de résistance', 'citron', 'orange', 'cocktail'], 'Dessert', 76d9105a-accb-424b-becd-d6ac24ee18a1, '2025-09-26T16:47:19.815751', [{'ingredient_id': '5a338ca6-a2f7-4ec0-bee9-7188aade6ab7', 'quantite': '500 g'}, {'ingredient_id': '9d080afb-a016-44ba-8265-4ceac975676e', 'quantite': '2'}, {'ingredient_id': '24774138-f0af-46b5-a65a-624a7d9bce0c', 'quantite': '1'}, {'ingredient_id': '0b3b6c90-6bd5-4a16-9228-51e45d244fe1', 'quantite': '1'}, {'ingredient_id': 'b4a73bb2-5bdd-41da-b61c-e891d01e2a76', 'quantite': '80 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (194228, 'Amuse-gueule boudin noir-banane', 'boudin noir, banane, pain, gruyère râpé, sel, poivre', '10 min', ['Préchauffer le four à 200°C (thermostat 7).', 'Disposer les tranches de pains sur une plaque de four.', 'Placer ensuite les tranches de boudin sur chaque taost et 2 rondelles de banane préalablement découpées. ', 'Parsemer de gruyere râpé et enfourner (position grill) environ 10 min.'], ['Poêle', 'Spatule', 'Rouleau à pâtisserie', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'gruyère râpé', 'Amuse-gueule boudin noir-banane', 'dessert', 'plat de résistance', 'poivre', 'pain', 'bouchée ou amuse-bouche', 'cocktail', 'boudin noir'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:47:26.190635', [{'ingredient_id': '9cb9d1ec-eb33-4d43-9a4b-bd548a164c0a', 'quantite': '4'}, {'ingredient_id': '006531d4-ead1-4a89-968a-3156c070ec46', 'quantite': ''}, {'ingredient_id': '0aea1907-aff8-45ea-9fb6-c235c89a5c43', 'quantite': '4'}, {'ingredient_id': '9ee22cb7-8571-4d5d-96aa-18b8b7b98045', 'quantite': '1'}, {'ingredient_id': 'e476e283-83d4-4eab-a066-bf632d200d2c', 'quantite': ''}, {'ingredient_id': '76e72766-d148-42af-b384-1b8d45fb38af', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (230110, 'Porridge réconfortant du matin', 'millet, châtaignes, flocons d''avoine, banane, sucre, lait de soja, noix, vanille', '5 min', ['Mettre tous les ingrédients dans un bol, sauf les noix, mélanger, mettre 2 minutes au micro-ondes. ', 'Sortir, ajouter les noix, mélanger et déguster !', 'Terrible le matin quand il fait froid, ça réconforte, ça réchauffe, ça tient au corps et c''est peu calorique (attention à la dose de sucre tout de même).'], ['Spatule', 'Moule à tarte', 'Mixeur', 'Louche', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'Porridge', 'confiserie', 'testées', 'cocktail', 'facile', 'Porridge réconfortant du matin', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'noix', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'lait de soja', 'sucre', 'millet', 'flocons d''avoine', 'châtaignes'], 'Dessert', fbb8b217-7437-4d49-a178-7e68d04b7f7b, '2025-09-26T16:47:29.979799', [{'ingredient_id': '4a336c51-1a3c-4df4-8bf2-dd4eaf1c3459', 'quantite': '10 g'}, {'ingredient_id': 'bbeca893-a979-4034-abf0-1f76ddc1a9af', 'quantite': '10 g'}, {'ingredient_id': '1c2ce1f8-10de-4c4e-98b0-0909715b01ee', 'quantite': '15 g'}, {'ingredient_id': '53060acb-625e-400f-9561-6894d53e3717', 'quantite': '1'}, {'ingredient_id': '6ac83887-ef35-4ddc-840d-3353163309a9', 'quantite': '10 g'}, {'ingredient_id': '7abc918f-1f08-4e6b-9d24-252c65eb7785', 'quantite': '12 cl'}, {'ingredient_id': '4819c9f3-bcfe-4a3d-b9ef-bb18e1f595fc', 'quantite': '5'}, {'ingredient_id': '1c21a65f-b1b9-4a40-b379-175ce816e43b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33426, 'tarte inventée', 'pâte sablée, pomme, banane, figue, gingembre, raisins secs, noix de coco, oeuf, crème fraîche liquide, fond, sucre, jus de citron', '20 min', ['Etaler la pâte dans un moule à tarte. ', 'Couper les bananes en tranches, les pommes en morceaux pas trop gros, les figues en 4. ', 'Les mettre sur la pâte, arroser du jus de citron (léger). ', 'Saupoudrer de noix de coco et parsemer les mendiants. ', 'A part mélanger les oeufs avec le sucre le gingembre, crème fraîche et un peu de lait et verser cette préparation sur les fruits.', 'Passer au four, Th 180°C, pendant 35 mn.'], ['Râpe', 'Ouvre-boîte'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'pâte sablée', 'figue', 'oeuf', 'plat', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'fond', 'dessert', 'plat de résistance', 'jus de citron', 'pomme', 'raisins secs', 'tarte inventée', 'noix de coco', 'sucre', 'cocktail'], 'Dessert', 33b90c48-ff94-44f2-9075-d397b23090f2, '2025-09-26T16:47:33.648832', [{'ingredient_id': '6d96c868-a13f-4fd6-bb51-8b4a1180b74b', 'quantite': '1'}, {'ingredient_id': '51aaa664-5977-42d7-a517-d05649083424', 'quantite': '3'}, {'ingredient_id': '7b8ce57d-94e6-4670-9233-bb8c7272702e', 'quantite': '2'}, {'ingredient_id': '5751572a-6456-4b7b-b1f1-3a3d1bdfabd6', 'quantite': '6'}, {'ingredient_id': '5533ac55-b2e2-4887-a204-c3f59cf44392', 'quantite': '1 cuillères'}, {'ingredient_id': '032b1f73-d0a6-4ba0-be89-5b3ad9ae30a5', 'quantite': '1 cuillères'}, {'ingredient_id': 'de33b9da-07c1-45ef-b781-5e525a746f93', 'quantite': '1 cuillères'}, {'ingredient_id': '1ca0efb1-ccbd-4e1f-b51e-d97660755892', 'quantite': '2'}, {'ingredient_id': 'c31f2023-0632-4354-af2f-c9cdc6924985', 'quantite': '25 cl'}, {'ingredient_id': '86a068aa-44c4-4eed-b2e7-376eb1633d1f', 'quantite': '1'}, {'ingredient_id': '0c1ca60d-49e3-43ff-a6fc-7953838f3147', 'quantite': '4 cuillères'}, {'ingredient_id': '921133fa-d56c-40e1-be26-2ae6366e8a34', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (170323, 'Bananes fondantes au chocolat et pointe de caramel', 'banane, sucre, eau, chocolat', '10 min', ['Coupez les bananes en deux. Dans un bol faites fondre les 100 g de chocolat 1 min 45 dans votre micro-ondes. Dans une casserole ajoutez les 10 cl d’eau, à ébullition, ajoutez le sucre pour faire votre caramel.', 'Lorsque le caramel est prêt, mélangez avec le chocolat fondu puis ajoutez les bananes dans la préparation.'], ['Couteau de chef', 'Ouvre-boîte', 'Rouleau à pâtisserie', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'chocolat', 'facile', 'caramel', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre', 'cocktail', 'Bananes fondantes au chocolat et pointe de caramel'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:47:43.556407', [{'ingredient_id': '0b836e4f-3b5b-4cfd-9271-bc9386cd1c7d', 'quantite': '4'}, {'ingredient_id': '89017cb8-3521-41c0-b4ca-9ab8dc7684f2', 'quantite': '100 g'}, {'ingredient_id': 'b09e4452-e240-46a9-98ff-422401f72a15', 'quantite': '10 cl'}, {'ingredient_id': '5cc271c3-8fec-4b3c-a64b-258a00b742a9', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23111, 'rochers coco-banane-ananas', 'banane, noix de coco rapée, ananas, oeuf, sucre de canne, sucre vanillé', '20 min', ['Mélangez l''oeuf et le sucre dans un saladier. ', 'Ajoutez la noix de coco, et les bananes coupées en petits morceaux, malaxez le tout jusqu''à obtenir une boule à peu près homogène. ', 'Coupez les tranches d''ananas en très petits dés et incorporez les à la pâte. ', 'Sur une plaque, faîtes des petits rochers avec la pâte, et enfournez le tout à 200°C.'], ['Presse-agrumes', 'Casserole', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rochers coco-banane-ananas', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'noix de coco rapée', 'dessert', 'plat de résistance', 'sucre vanillé', 'ananas', 'rochers', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:47:47.375289', [{'ingredient_id': '90874f1e-e092-4979-b3ec-d6e006c0dc7f', 'quantite': '2'}, {'ingredient_id': 'ef172260-1850-4c7e-abe9-38b844e87f5e', 'quantite': ''}, {'ingredient_id': '19c0864f-77e3-4f83-a689-7976ffebf8f1', 'quantite': '5'}, {'ingredient_id': '8931bd41-badc-4fda-bfe6-8ec714783e83', 'quantite': '1'}, {'ingredient_id': '308182bb-c3bf-4cd4-b793-d0f69a64590c', 'quantite': '1'}, {'ingredient_id': 'df881675-d1b2-49f8-9c4b-3427cdbedefb', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (71159, 'Tatin bananes - rhubarbe', 'pâte brisée, banane, rhubarbe, sucre, citron, matière grasse, sucre vanillé', '20 min', ['Mettre le sucre dans une casserole avec le jus d''un citron et faire un caramel roux.', 'Pendant ce temps, couper les bananes en 2 dans la largeur et en 3 dans la longueur. ', 'Graisser le fond d''un moule à manqué. ', 'Y verser le caramel.', 'Y disposer les morceaux de bananes.', 'Mettre le four à préchauffer à 180°, thermostat 6. ', 'Eplucher la rhubarbe et la couper en fines rondelles, que l''on disposera entre et dessus les morceaux de bananes.', 'Saupoudrer de vanille ou de sucre vanillé. ', 'Couvrir avec la pâte et border le moule.', 'Mettre au four à 180°, themostat 6 pendant 25 min.', 'Attendre 5 min et démouler!'], ['Tire-bouchon', 'Batteur électrique', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rhubarbe', 'bon marché', 'plat', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'tarte Tatin', 'dessert', 'plat de résistance', 'matière grasse', 'sucre vanillé', 'citron', 'sucre', 'cocktail', 'Tatin bananes - rhubarbe'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:47:53.158936', [{'ingredient_id': 'cfc54639-f667-4225-9a20-47147fbf7d1e', 'quantite': '1'}, {'ingredient_id': '697f9d6a-f647-4728-9a92-2ad6f97115b5', 'quantite': '4'}, {'ingredient_id': '1b50d672-3426-4dd1-874e-52afc406a330', 'quantite': '5'}, {'ingredient_id': '9f419001-2e8d-4a61-8c7f-d91de45dbe51', 'quantite': '150 g'}, {'ingredient_id': '856a91c6-e85f-43aa-a831-68c9f825d3f0', 'quantite': ''}, {'ingredient_id': '75718626-f58f-43d4-a5f8-0495bd8465b6', 'quantite': ''}, {'ingredient_id': 'f7a703c3-f928-4bde-a219-0adfd4a60614', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (232991, 'Galette des rois banane-nutella', 'pâte feuilletée, banane, Nutella, oeuf, fèves', '10 min', ['Préchauffer le four à 210°C (thermostat 7).', 'Étaler une première pâte feuilletée sur la plaque de cuisson du four.', 'Éplucher puis couper en rondelles les 3 bananes et les répartir sur la pâte feuilletée.', 'Répartir équitablement le nutella sur les bananes (on peut le passer au micro-onde au préalable afin qu''il soit plus coulant et plus facile à étaler).', 'Disposer la fève en limite extérieure du disque de pâte pour avoir le moins de chance possible de la (ou les) couper au moment de servir la galette. ', 'Battre l’œuf entier et faire un cercle sur le pourtour de la pâte avec un pinceau pâtissier.', 'Dérouler le second disque de pâte et recouvrir la préparation.', 'Badigeonner la galette avec le reste d’œuf battu, dessiner les parts avec le dos de la lame d''un couteau (aussi loin que possible des fèves que l''on aperçoit encore quand la pâte est crue).', 'Après quelques minutes, repasser une couche d’œuf battu, puis enfourner pour une cuisson de 20 à 25 minutes selon le four.', 'Sortir la galette quand elle est bien dorée, et déguster tiède.'], ['Économe', 'Fouet', 'Spatule', 'Râpe', 'Louche'], ['', 'entrée', 'banane', 'Galette des rois banane-nutella', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'fèves', 'Nutella', 'dessert', 'plat de résistance', 'pâte feuilletée', 'cocktail'], 'Dessert', 37017970-bb07-459f-8251-825e47abadf7, '2025-09-26T16:47:56.759697', [{'ingredient_id': '318b02b9-8417-4c33-af6f-146b8479106c', 'quantite': '2'}, {'ingredient_id': '2e6d71e7-3482-4d3e-9a40-bebf09bdb165', 'quantite': '3'}, {'ingredient_id': '1e6362b2-bae8-400f-8be5-78cdccfec7d0', 'quantite': '3 cuillères'}, {'ingredient_id': '1db5c080-1bc3-42b1-80dc-53bd50fc679b', 'quantite': '1'}, {'ingredient_id': 'b10fb7d1-62bb-4e5a-9589-dde7815bd8ac', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (10557, 'Petits Gervais à la banane', 'carré gervais, banane, sucre en poudre, lait', '10 min', ['Dans une assiette creuse, écraser le petit gervais à la fourchette.', 'Rajouter la banane et l''écraser aussi.', 'Lier avec un peu de lait. La préparation ne doit être ni trop liquide ni trop épaisse. Mettre le sucre selon le goût de chacun.', 'C''est prêt et c''est très bon!'], ['Couteau de chef', 'Économe', 'Mixeur', 'Louche', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'carré gervais', 'dessert', 'plat de résistance', 'lait', 'Petits Gervais à la banane', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:48:02.533809', [{'ingredient_id': 'b6f72e9b-b753-417f-b2a1-16b49a78bd3d', 'quantite': '1'}, {'ingredient_id': '8cfc0e83-a55f-4e4c-ab61-2b057f512f37', 'quantite': '1'}, {'ingredient_id': '8ee25417-7323-4a72-a06e-722bbfbb845a', 'quantite': ''}, {'ingredient_id': '4392a898-16c8-4abb-bd23-8a2c7553dbde', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30309, 'Charlotte aux rondelles de bananes et aux raisins secs', 'biscuits à la cuillère, raisin, banane, rhum, oeuf, lait, sucre en poudre', '30 min', ['Faites tremper les raisins de Corinthe dans de l''eau tiède.', 'Mélangez 20 cl lait avec le rhum. Trempez rapidement les biscuits dans ce mélange et tapissez-en le fond et les parois d''un moule à charlotte. ', 'Enlevez la peau des bananes et coupez-les en rondelles. Disposez successivement des couches de bananes, de raisins et de biscuits. Terminez par une couche de biscuits.', 'Préchauffez le four à 180°C (thermostat 6).', 'Faites bouillir le reste du lait. Fouettez les oeufs avec le sucre puis ajoutez le lait bouillant. Versez dans le moule et laissez les biscuits s''en imprégner quelques minutes.', 'Faites cuire au bain-marie au four pendant 45 minutes et démoulez lorsque le gâteau est froid.'], ['Passoire', 'Fouet', 'Balance de cuisine'], ['', 'raisin', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'biscuits à la cuillère', 'facile', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'Charlotte aux rondelles de bananes et aux raisins secs', 'lait', 'cocktail'], 'Dessert', b651e113-4701-48dc-9330-afedf3a80d1c, '2025-09-26T16:48:06.151701', [{'ingredient_id': 'fb987d07-f901-4b9c-8f9b-1fafaee069d8', 'quantite': '300 g'}, {'ingredient_id': 'db41c817-8129-4f61-8d28-e63cce357f76', 'quantite': '25 g'}, {'ingredient_id': 'a10fdeeb-a8bd-4919-b568-934400907726', 'quantite': '6'}, {'ingredient_id': '71425ac2-cbaf-438f-8146-e72d7c15f0cb', 'quantite': '10 cl'}, {'ingredient_id': '8dabc0cf-250a-435c-9b9e-2c7b253cd803', 'quantite': '3'}, {'ingredient_id': 'e647aa3b-4099-461f-acd9-73e4e2a5e567', 'quantite': '40 cl'}, {'ingredient_id': 'cea22e2e-33e8-4046-b83c-3327fbf4c5b1', 'quantite': '75 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66832, 'Roulé des Tropiques', 'sucre fin, oeuf, farine, banane, sucre fin, rhum', '15 min', ['Battre les jaunes d’oeufs et le sucre fin pour obtenir un mélange mousseux. Ajouter la farine, du rhum et les blancs battus en neige.', 'Etendre sur une plaque et faire cuire 10 min au four à 160°C (thermostat 5-6).', 'Ecraser les bananes en purée avec le sucre de canne et du rhum.', 'Recouvrir la pâte de ce mélange et rouler. Réserver au frais jusqu''au service.'], ['Pince de cuisine', 'Ouvre-boîte', 'Passoire', 'Balance de cuisine', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'sucre fin', 'très facile', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'gâteau roulé', 'cocktail', 'Roulé des Tropiques'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:48:12.380046', [{'ingredient_id': 'e43769db-268b-4b4a-8492-68093adcf2b2', 'quantite': '250 g'}, {'ingredient_id': '2fe80783-6416-4b6e-801f-4608961b1a21', 'quantite': '6'}, {'ingredient_id': '94e4aa9b-d65c-4af2-855a-0d970750b786', 'quantite': '250 g'}, {'ingredient_id': 'b6c23538-7011-4280-a1b6-bc0bd43ac9ce', 'quantite': '8'}, {'ingredient_id': '974357b2-863e-4c9c-938e-6f5b37bad94e', 'quantite': '150 g'}, {'ingredient_id': '009694ce-9d6f-4c71-9271-5ed26c9ed716', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58846, 'Beignets à la banane de l''île Maurice', 'banane, oeuf, farine, sucre vanillé, levure chimique, cardamome, lait en poudre, sucre en poudre, lait, huile', '10 min', ['Dans un bol écrasez les bananes à la fourchette, ajoutez l''oeuf, la farine, la levure, le sucre vanillé, le sucre en poudre, les graines de cardamome', 'et le lait en poudre.', 'La pâte doit avoir une consistance assez molle mais pas trop non plus pour tenir dans le bain de friture, si elle est trop épaisse, ajoutez un peu de lait.', 'Faites cuire dans l''huile chaude et épongez sur du papier absorbant.', 'Une fois que tous les beignets sont cuits, arrosez de quelques pincées de sucre et servez.', 'Ces beignets sont meilleurs chauds ...'], ['Pince de cuisine', 'Ouvre-boîte', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'cardamome', 'rapide', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'beignets sucrés', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'lait', 'lait en poudre', 'Beignets à la banane de l''île Maurice', 'cocktail'], 'Dessert', 33b45207-cc6f-4089-9654-d3d980fb4a67, '2025-09-26T16:48:16.024984', [{'ingredient_id': '5d9f8d4b-a780-4d83-97c6-aafefec55b56', 'quantite': '2'}, {'ingredient_id': '747f7c3b-e619-4022-ab6f-6792430138e1', 'quantite': '1'}, {'ingredient_id': 'bf16f6f0-58e8-4595-8cd0-8f328d04595d', 'quantite': '200 g'}, {'ingredient_id': 'cea02038-28c9-40a4-a345-bc94e465dd48', 'quantite': '2'}, {'ingredient_id': 'aa83eddf-8775-42ec-8079-7f45833b70ff', 'quantite': ''}, {'ingredient_id': '741d2276-3bc7-4d4b-b77d-18d4a2f6ca85', 'quantite': '4'}, {'ingredient_id': '5de9c76d-1ca1-45a2-9378-b47fa272b3b1', 'quantite': '2 cuillères'}, {'ingredient_id': '1c466864-a1af-44fc-90f6-d4ab795382b8', 'quantite': '3'}, {'ingredient_id': 'bc838386-8305-4530-a13b-5f5575b2c2a8', 'quantite': '3 cuillères'}, {'ingredient_id': '6dc9e86f-1d53-4ff1-90f3-36d8130656d2', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57272, 'Délice de crêpes à la banane', 'banane, pâte à crêpe, Coulis de fraise, crème chantilly, vermicelles', '15 min', ['Faites une pâte à crêpe et faites vos crêpes bien dorée (c''est plus agréable à l''oeil).', 'Ensuite, couper les 4 bananes de moitié sur la longueur et mettez chaque demi banane sur une crêpe (côté plat sur la crêpe) que vous enroulerez après y avoir mis un peu de coulis de chocolat ou même nutella par dessus.', 'Disposez de préférence dans des plats individuels chaque part x 2(une banane complète soit deux roulés de banane/crêpes dans chaque plat) préalablement réalisée.', 'Puis vous pouvez selon votre goût, mettre un peu de chantilly puis un bon filet de caramel, de fraise ou chocolat sur chaque part et finir en parsemant de vermicelles multicolores.'], ['Casserole', 'Passoire', 'Économe', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'vermicelles', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'pâte à crêpe', 'Délice de crêpes à la banane', 'dessert', 'plat de résistance', 'crêpes sucrées', 'cocktail', 'Coulis de fraise'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:48:19.623661', [{'ingredient_id': '52883139-0aa2-430f-ab3b-4c6bba1957f2', 'quantite': '4'}, {'ingredient_id': '93ea02e1-14e6-48c0-bdcf-0ec1c43c214e', 'quantite': ''}, {'ingredient_id': 'f5277770-3713-457a-9e96-c45f7067998f', 'quantite': ''}, {'ingredient_id': 'a7404e46-35fb-43ac-8aba-ff826e1cb336', 'quantite': ''}, {'ingredient_id': '45a347d9-84ae-4394-b60c-37205648a30b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528639, 'Porridge ultra rapide aux fruits et granola', 'banane, flocons d''avoine, lait, framboises, eau, sirop d''agave, granola, myrtilles', '5 min', ['Pour le dosage des flocons d’avoine, du lait et de l’eau, j’utilise un petit verre d’eau. L’importance est de bien garder les proportions: 1 portion de flocons d’avoine pour 2 portions de liquide.', 'Écrasez la moitié de la banane dans un bol. Puis, versez les flocons d''avoine, l''eau, le lait et le sirop d''agave.', 'Faites cuire au micro-ondes pendant 2 minutes à forte puissance.  ', 'Laissez reposer quelques minutes. ', 'Coupez le reste de la banane en rondelles et déposez les sur le porridge. Ajoutez les framboises et les myrtilles puis parsemez de granola.'], ['Spatule', 'Louche', 'Fouet', 'Passoire', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'Porridge', 'confiserie', 'eau', 'testées', 'très facile', 'framboises', 'granola', 'bon marché', 'rapide', 'sirop d''agave', 'myrtilles', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Porridge ultra rapide aux fruits et granola', 'lait', 'flocons d''avoine', 'cocktail'], 'Dessert', c88180ad-a956-44f6-b81c-cf19752f7ec6, '2025-09-26T16:48:23.214568', [{'ingredient_id': '305523cd-6cdd-47e5-822b-53a9a67c5faf', 'quantite': '1'}, {'ingredient_id': '8ac4ce8e-1410-4a3b-a191-a0ac415dfef1', 'quantite': '1'}, {'ingredient_id': '80863e9b-3b08-4000-b4d2-69b00b2587f5', 'quantite': '1'}, {'ingredient_id': 'e9bc0bfb-13cb-413e-b161-1a842d6176c5', 'quantite': '1'}, {'ingredient_id': '840dd793-e3fb-449a-a7d7-4c52792d9389', 'quantite': '1'}, {'ingredient_id': '2ba67d05-20e3-427e-a32b-e0fc4135cc0d', 'quantite': '1 cuillères'}, {'ingredient_id': '12b40241-44c1-464c-8d2f-a7d2cc56a3d6', 'quantite': '2 cuillères'}, {'ingredient_id': '380997e7-b776-4254-b8aa-aeb451d0e0ba', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16497, 'Gratin de bananes au rhum', 'banane, citron, crème fraîche, sucre vanillé, rhum, sucre de canne', '5 min', ['Coupez en rondelles les 6 bananes et disposez-les dans un plat à gratin.', 'Arrosez avec le jus du citron. Mélangez la crème fraiche avec le sucre vanillé et le rhum.', 'Nappez les bananes avec cette préparation.', 'Mettez au four thermostat 7 (préchauffé) pendant 20 min.', 'Saupoudrez généreusement de sucre roux et passez sous le gril.', 'Se consomme chaud ou tiède.'], ['Batteur électrique', 'Moule à tarte', 'Ouvre-boîte', 'Balance de cuisine', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron', 'cocktail', 'Gratin de bananes au rhum'], 'Dessert', 249fcebe-2483-45ed-a894-7f4eadcaf142, '2025-09-26T16:48:26.915486', [{'ingredient_id': 'b4396424-6ad2-4287-8dd3-4409d11df721', 'quantite': '6'}, {'ingredient_id': '4e777c02-48e1-46eb-bcda-e31dcd15867c', 'quantite': '1'}, {'ingredient_id': 'c3791531-e6cd-4548-9e17-5a9af22c115c', 'quantite': '200 g'}, {'ingredient_id': '6d3cb444-302f-46c3-bacf-f5c34abe346f', 'quantite': '1'}, {'ingredient_id': '980a8f74-e3e1-4793-9f4a-7ac466b7c1c4', 'quantite': '4 cl'}, {'ingredient_id': '590d9f02-cdd9-4886-acff-cb70de4e3724', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (334950, 'Banane laitière vanillée', 'banane, yaourt, sucre vanillé, vanille', '5 min', ['Couper les 3 bananes en rondelles. Mélangez les yaourts au sachet de sucre vanillé. Mélangez le tout et ajouter une pincée de vanille. Servir le tout frais.'], ['Balance de cuisine', 'Mixeur', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'Banane laitière vanillée', 'plat de résistance', 'sucre vanillé', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:48:32.692679', [{'ingredient_id': '12e6f06d-c241-4f13-a06e-60f1a4bc4e9c', 'quantite': '3'}, {'ingredient_id': '8575c0a1-5855-42af-9385-1859fc2c7749', 'quantite': '3'}, {'ingredient_id': '1899264b-7030-45b0-b095-bf00152204fa', 'quantite': '1'}, {'ingredient_id': '4a23e461-836f-4061-8621-3e67c3282e70', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (168952, 'Super jus de fruits', 'orange, banane, kiwi, poire, pomme, fraises', '20 min', ['Epluchez les fruits et coupez-les en petits morceaux.', 'Mixez le tout et faites attention à ne pas laisser de gros morceaux.', 'Mettez dans des verres et c''est fini !', 'Ne rajoutez pas de sucre !'], ['Batteur électrique', 'Fouet', 'Planche à découper'], ['', 'entrée', 'banane', 'Super jus de fruits', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'orange', 'cocktail'], 'Boisson', b08fcafe-beec-4407-b974-5ee9f83371de, '2025-09-26T16:48:36.496435', [{'ingredient_id': '9f490f41-4ee7-4183-9c73-5f17bff9361b', 'quantite': '2'}, {'ingredient_id': 'bd46cbbb-002f-4d1f-a2ca-32abbf2a203b', 'quantite': '2'}, {'ingredient_id': '62690dc3-bb6b-4b4c-a38b-8ed0776c534f', 'quantite': '1'}, {'ingredient_id': '0d6dff16-1dbc-4c64-8ffe-04a58a12a673', 'quantite': '1'}, {'ingredient_id': '8bed229e-b673-41c0-94c1-a422d1cc9ecf', 'quantite': '1'}, {'ingredient_id': '29bbbe8e-3e2b-497e-9b62-2df8407f0e0b', 'quantite': '12'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (222808, 'Mousse de fruits onctueuse light', 'pomme, banane, poire, citron, fromage blanc, édulcorant', '15 min', ['Éplucher les pommes, les poires et les bananes.', 'Les découper en petits morceaux et les faire cuire dans une casserole à feu moyen.', 'Ajouter le jus du demi citron, le fromage blanc et le sucre.', 'Mélanger et cuire la préparation pendant une vingtaine de minutes.', 'Mixer et placer au frigo pour servir frais !'], ['Pince de cuisine', 'Fouet', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'édulcorant', 'recette', 'cuisine', 'Mousse de fruits onctueuse light', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'pomme', 'citron', 'mousse fruits', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:48:42.282989', [{'ingredient_id': '98065b40-760d-4206-84f9-cbdbc12a7f9a', 'quantite': '4'}, {'ingredient_id': 'b4846ba1-9d9d-4f9b-a65e-54c18f270c81', 'quantite': '2'}, {'ingredient_id': '9449a054-28d0-4c38-9e51-e7345ab56598', 'quantite': '2'}, {'ingredient_id': 'a30844c7-1d7d-42dd-ad33-f659f9789710', 'quantite': ''}, {'ingredient_id': '3ab0d9eb-8f11-40ff-a13b-f95fc59e6ac4', 'quantite': '2 cuillères'}, {'ingredient_id': '774b93b8-bf51-4bdc-aaff-d1a9a6bf6709', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335407, 'Banana mugcake', 'beurre, sucre roux, lait, farine, levure chimique, banane', '5 min', ['Commencer par faire fondre le beurre dans le micro-ondes puis ajouter 1 ou 2 cuillères à soupe de sucre en fonction de la maturité de la banane et de vos goûts.', 'Il faut savoir que plus la banane est mûre, plus elle est sucrée. Le conseil est donc de goûter votre banane pour adapter la dose de sucre à mettre.', 'Penser à bien mélanger avant d’incorporer la farine et la levure. Mélanger à nouveau.', 'Ajouter le lait. Puis bien mélanger afin d’homogénéiser la préparation.', 'Pour finir, écraser la banane dans la préparation. Attention à bien fondre la banane dans la préparation et broyer la banane pour ne pas avoir de grumeaux.', 'Passer le mug au micro-ondes entre 1 min 30 et 2 min selon la puissance de votre machine.', 'Si vous souhaitez faire un topping un peu gourmand, je vous conseille quelques petits copeaux de chocolat et des amandes effilées.'], ['Louche', 'Casserole', 'Balance de cuisine', 'Ouvre-boîte', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'rapide', 'plat', 'mugcake', 'recette', 'cuisine', 'recettes', 'boisson', 'Banana mugcake', 'farine', 'dessert', 'plat de résistance', 'beurre', 'lait', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:48:45.970491', [{'ingredient_id': '27205e9f-05af-4970-ba3f-98033a2fc1d3', 'quantite': '1.5 cuillères'}, {'ingredient_id': '111e8044-8f2b-4b6b-a06c-de2f1f5596cb', 'quantite': '1 cuillères'}, {'ingredient_id': 'fc82a66b-c5b2-40fe-aca0-1a30f1259a22', 'quantite': '2 cuillères'}, {'ingredient_id': '4a9b896d-f032-4a9a-8ba0-d6b9ab666355', 'quantite': '2 cuillères'}, {'ingredient_id': 'e41c32fb-ff74-4d8e-9b3c-d0afa19e6f1d', 'quantite': ''}, {'ingredient_id': '14e9fe83-43b9-4a84-a711-a28acd346d92', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (44063, 'Tarte à la banane et au beurre de cacahuète', 'biscuits secs, beurre, lait, maïzena, extrait de vanille, banane, sucre, pâte d''arachide, chocolat noir, chocolat au lait', '30 min', ['Réduire les biscuits en poudre au robot, les mêler au beurre fondu.', 'Tapisser le fond d’un moule (idéal : un moule à charnières), presser avec les mains, et faire cuire 10 min au four à 180°C (th 6). ', 'Laisser refroidir. (Variante : une pâte sablée cuite à blanc, c’est plus pratique si on n’a pas de moule à charnière, et c’est bon aussi).', 'Préparer la garniture : ', 'A la fourchette, écraser les bananes dans un grand bol, ajouter la maïzena, le sucre et l’extrait de vanille. ', 'Bien touiller, pour que le mélange soit homogène.', 'Faire chauffer le lait dans une casserole. ', 'Lorsqu’il est presque à ébullition, le verser sur le mélange maïzena-banane en mélangeant bien. ', 'Puis, reverser le tout dans la casserole, et cuire à feu très doux jusqu’à épaississement (ça va assez vite). ', 'Hors du feu, incorporer la pâte d’arachide. Laisser refroidir.', 'Montage du gâteau : ', 'Répartir la crème à la banane froide sur le fond de tarte. ', 'Recouvrir d’éclats de chocolat hachés au couteau, en mélangeant les 3 couleurs de façon artistique.', 'Laisser reposer quelques heures au frigo, avant de déguster.'], ['Passoire', 'Verre doseur'], ['entrée', 'recettes de cuisine', 'Tarte à la banane et au beurre de cacahuète', 'confiserie', 'testées', 'facile', 'biscuits secs', 'bon marché', 'rapide', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'cocktail'], 'Dessert', 6be77821-b0c5-484f-8070-e790de2a6978, '2025-09-26T16:48:49.620774', [{'ingredient_id': '61c95c9b-1164-48ec-894f-c14dcf246c7d', 'quantite': '200 g'}, {'ingredient_id': '33e11ff0-c6fe-4340-b6a2-37b5b85be018', 'quantite': '80 g'}, {'ingredient_id': '464c38a3-a529-41e1-b164-50a1034c61e6', 'quantite': ''}, {'ingredient_id': '3c992761-489b-4bd9-b8c8-783b1f360b0b', 'quantite': '4 cuillères'}, {'ingredient_id': '209b07e9-c9e5-44a0-8c74-c5c6f24ab99b', 'quantite': '1 cuillères'}, {'ingredient_id': '70eb1eb1-bfe5-405a-a6f7-4789c720ca9c', 'quantite': '2'}, {'ingredient_id': '586bc818-f6fc-43a6-b519-6ac0933ed619', 'quantite': '4 cuillères'}, {'ingredient_id': 'f88651dd-7b5a-4f97-b18d-cf9833b89942', 'quantite': '4'}, {'ingredient_id': '41c9c0ac-f398-4e20-935d-15fcff45b31d', 'quantite': '50 g'}, {'ingredient_id': '0fe7b323-a97d-474a-aa42-46bedcb84961', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27461, 'Salade Bob Marley aux fruits', 'pomme, fraises, banane, sucre vanillé, citron, crème chantilly', '15 min', ['Couper les pommes en quartiers. ', 'Couper les bananes en rondelles. ', 'Laver les fraises sans les équeuter, les équeuter après, couper les plus grosses en deux. ', 'Mélanger les trois fruits, ajouter une goutte de citron, le sucre vanillé. ', 'Quand c''est bien frais, servez avec de la chantilly.'], ['Fouet', 'Louche', 'Poêle', 'Casserole', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Salade Bob Marley aux fruits', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'citron', 'cocktail'], 'Dessert', a429e114-b583-4c8a-b925-b0171ecf5a15, '2025-09-26T16:48:53.107087', [{'ingredient_id': '51ae6c3a-9de1-4dc2-8a03-787516c683a6', 'quantite': '4'}, {'ingredient_id': 'aa5da927-2e7d-4952-a7a1-c0b3d439de6e', 'quantite': '500 g'}, {'ingredient_id': '1dbb59c5-54c6-45bb-9bd2-14af63fe17c9', 'quantite': '3'}, {'ingredient_id': 'f6fcaf00-f886-4181-9fbb-b0202b5be3bc', 'quantite': '1'}, {'ingredient_id': '5c35cb70-92ba-432e-9253-aee003c24385', 'quantite': ''}, {'ingredient_id': 'f345eab2-8751-4e5b-aae1-56d71c26d03d', 'quantite': '250 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65977, 'Punch gégé', 'rhum, rhum, jus d''orange, jus d''ananas, jus de banane, goyave, pamplemousse, jus de citron, sucre de canne, vanille, cannelle, girofle, poivre', '5 min', ['Mélangez tous les ingrédients dans un grand récipient et laissez macérer au minimum 12 heures. Temps de macération idéal 24 heures.', 'Servez très frais, avec des glaçons !'], ['Poêle', 'Rouleau à pâtisserie', 'Planche à découper', 'Couteau de chef', 'Casserole'], ['entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'assez cher', 'goyave', 'très facile', 'girofle', 'rapide', 'Punch gégé', 'plat', 'jus de banane', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'vanille', 'punch', 'dessert', 'plat de résistance', 'jus d''ananas', 'pamplemousse', 'jus de citron', 'jus d''orange', 'cannelle', 'poivre', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:48:58.316961', [{'ingredient_id': '00679f0b-aa53-43ac-8219-b9bde656f685', 'quantite': '2.5 l'}, {'ingredient_id': '3c1715c8-0f26-4723-b41e-4c13c0fcc79a', 'quantite': '1 l'}, {'ingredient_id': '3008e86f-22e8-4cad-8315-3ed231a5178a', 'quantite': '2 l'}, {'ingredient_id': 'eb73d954-b782-4260-8381-0120bc0ee922', 'quantite': '2 l'}, {'ingredient_id': '1a91c332-0bc2-43f0-8958-0db812e713cf', 'quantite': '1 l'}, {'ingredient_id': 'e3ddfe3d-2e15-4a4c-a602-f58b0e762cb6', 'quantite': '1 l'}, {'ingredient_id': 'adaac685-6174-4e8b-b991-da64d748b1ea', 'quantite': '1 l'}, {'ingredient_id': 'b2433d16-664d-45e9-8cee-0f7de75d3279', 'quantite': '20 cl'}, {'ingredient_id': '86daa6e5-92bb-4e8a-bba7-1d1f6c11b01e', 'quantite': '6 cl'}, {'ingredient_id': '8fc9901b-f86f-4e19-a855-927e26c4ffb3', 'quantite': '1'}, {'ingredient_id': '6c9fadee-dabc-4285-8832-e4bbb1e20046', 'quantite': ''}, {'ingredient_id': '61552b46-febc-4d9f-b990-8acf25432761', 'quantite': '6'}, {'ingredient_id': '2a107834-6f28-44d3-84da-3b9caff18fdf', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (45783, 'Milk-shake à la banane façon Algérienne', 'banane, lait, chocolat en poudre, sirop d''érable, sucre en poudre, café soluble, cannelle', '10 min', ['Coupez les bananes en tranches.', 'Mettez le lait dans le mixeur ainsi que les bananes, le chocolat, le sirop d''érable, le sucre et le café.', 'Mixez le tout.', 'Vous n''avez plus qu''à déguster...Vous pouvez éventuellement ajouter 1 pincée de cannelle pour plus de goût.'], ['Passoire', 'Rouleau à pâtisserie', 'Presse-agrumes', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'sirop d''érable', 'Milk-shake à la banane façon Algérienne', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'café soluble', 'cannelle', 'chocolat en poudre', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:49:02.192838', [{'ingredient_id': 'f66b05e7-8feb-488c-8df8-dc6b3561d596', 'quantite': '3'}, {'ingredient_id': '52225387-0d0a-4eb2-930d-a34ee6df1ea7', 'quantite': '1 l'}, {'ingredient_id': '374bd4f0-6f11-4366-b136-2e6b8f35d0c3', 'quantite': '250 g'}, {'ingredient_id': 'f78ec1dc-c667-468d-b25d-fca4ff717eeb', 'quantite': '2 cuillères'}, {'ingredient_id': '8f006193-4a04-47a1-9ed6-15395ff1af7b', 'quantite': '150 g'}, {'ingredient_id': 'e9b0bea0-3688-47e4-8183-ee467db28907', 'quantite': '1'}, {'ingredient_id': '9d8c6c57-399e-4138-a66f-0a7ccf48d663', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (325123, 'Salade de fruits rhum coco', 'pomme, banane, pêche, ananas, lait de coco, rhum, eau, sucre en poudre', '15 min', ['Éplucher et couper en morceaux la pomme et la banane, les mettre dans un grand saladier, ajouter les deux boîtes de fruits au sirop ainsi que le lait de coco.', 'Pour le sirop de sucre au rhum :', 'Remplir une petite casserole d''eau, ajouter le sucre et le filet de rhum, chauffer à feu vif jusqu''à ébullition.', 'Verser le liquide chaud dans le saladier, couvrir. Une fois le saladier refroidi, mettre au réfrigérateur minimum 1 heure.', 'Une fois sortie du réfrigérateur, bien remuer la salade avant de la servir car le lait se concentre en surface.'], ['Rouleau à pâtisserie', 'Couteau de chef', 'Tire-bouchon', 'Pince de cuisine', 'Verre doseur'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'eau', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'Salade de fruits rhum coco', 'ananas', 'pêche', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:49:05.910026', [{'ingredient_id': '675011db-db94-438f-907e-29278969827c', 'quantite': '1'}, {'ingredient_id': '3fcd36c5-12dc-4b33-9565-8eb9ba4a40d3', 'quantite': '1'}, {'ingredient_id': '87bc12e3-f4d0-4f6d-a61b-2418622e17b8', 'quantite': '400 g'}, {'ingredient_id': 'd81e22f1-384e-492b-af36-3b4480b2da13', 'quantite': '500 g'}, {'ingredient_id': '30f48312-af29-4038-93bd-c98e657c55dc', 'quantite': '20 cl'}, {'ingredient_id': '6df03113-4a0a-4ac7-bace-6d76fab11973', 'quantite': '5 cl'}, {'ingredient_id': '5207e14c-3020-4899-941e-90c32e1247f5', 'quantite': '20 cl'}, {'ingredient_id': 'b55271d3-d063-4d9a-b700-e3c8821784ba', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (82124, 'Far d''automne', 'farine, sucre, lait, oeuf, miel, pomme, banane, raisin, cerneau de noix, cannelle', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Mélanger les oeufs, la farine, le sucre, la cannelle, le lait, le miel, jusqu''à obtention d''une pâte à crêpe un peu épaisse.', 'Dans un moule beurré et fariné, déposer les pommes, le raisin, les cerneaux de noix, préalablement revenus dans du beurre et du sucre.', 'Recouvrir de la pâte, faire cuire 40-45 minutes au four à 180°C (thermostat 6).'], ['Passoire', 'Ouvre-boîte', 'Pince de cuisine'], ['raisin', 'entrée', 'banane', 'recettes de cuisine', 'cerneau de noix', 'confiserie', 'testées', 'très facile', 'bon marché', 'far breton', 'oeuf', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'farine', 'Far d''automne', 'dessert', 'plat de résistance', 'pomme', 'cannelle', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:49:09.659921', [{'ingredient_id': '365d5cab-737c-41e9-83c0-57800b9202e1', 'quantite': '200 g'}, {'ingredient_id': '7802e975-6df4-4414-8916-0f19227ea5d7', 'quantite': '150 g'}, {'ingredient_id': '790a76b3-6995-4cdc-a468-5e54ed418a66', 'quantite': '75 cl'}, {'ingredient_id': 'cf61d793-b454-43dc-bb96-dbdfe508d6c3', 'quantite': '4'}, {'ingredient_id': 'c79e92ab-f622-40a4-a58a-252edaad156e', 'quantite': '1 cuillères'}, {'ingredient_id': '4d44a9f0-f891-4580-9951-acd8c0d1b79b', 'quantite': '2'}, {'ingredient_id': '33de6e56-4c77-494c-ade6-deba077404b9', 'quantite': '1'}, {'ingredient_id': 'ea37ecd0-d7d2-41a8-8f2a-4a41e9652081', 'quantite': '1'}, {'ingredient_id': '12ddb5a6-d4d5-4a76-a73d-89d2ea2520a4', 'quantite': ''}, {'ingredient_id': '7c422fca-b93b-43e8-90b1-1038e6693754', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (217633, 'Suprêmes de poulet aux saveurs exotiques', 'poulet, banane, lait de coco, oignon, raisins secs, huile d''olive, cumin en poudre, sel, poivre', '20 min', ['Épluchez et émincez l''oignon et faites-le revenir dans une poêle avec de l''huile d''olive bien chaude.', 'Émincez les filets de poulets en fines lamelles et coupez les bananes en rondelles.', 'Ajoutez les poulets dans la poêle avec les oignons et laissez les dorer pendant 10 min environ.', 'Salez et poivrez à votre convenance.', 'Versez le lait de coco et parfumez de cumin en poudre, continuez la cuisson à feu doux encore quelques minutes.', 'Ajoutez les bananes et les raisins secs et laissez mijoter 2 min. ', 'Servez aussitôt.', 'Bon appétit !'], ['Planche à découper', 'Balance de cuisine', 'Poêle'], ['', 'lait de coco', 'poulet', 'banane', 'cumin en poudre', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'Suprêmes de poulet aux saveurs exotiques', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'raisins secs', 'poivre', 'cocktail'], 'Plat principal', ec1fb74f-020c-485a-a9bb-09d192c87a8e, '2025-09-26T16:49:13.455076', [{'ingredient_id': '5926469e-1544-4b4a-b0be-3b292a49802b', 'quantite': '4'}, {'ingredient_id': '0a2c8054-3e83-4ddc-a596-f72dee185841', 'quantite': '2'}, {'ingredient_id': 'f026635b-0df2-4896-89b7-b1df268b0791', 'quantite': '20 cl'}, {'ingredient_id': '704535b9-d0f3-4a45-87d1-e1732eb8380b', 'quantite': '1'}, {'ingredient_id': 'fc59c4d4-181f-4b09-bf42-f2a0f455f20e', 'quantite': ''}, {'ingredient_id': 'cbf61e22-b74c-4a3c-b252-a9d2d1794b0f', 'quantite': ''}, {'ingredient_id': '289f14c5-3d2f-4dac-a914-888ff9f921fd', 'quantite': ''}, {'ingredient_id': '48dd6133-6258-4bda-9aa5-d452cf928130', 'quantite': ''}, {'ingredient_id': '66d3155e-eaf2-4806-ba31-b9efff3008fa', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (330476, 'Tarte banoffee', 'banane, crème liquide, pâte feuilletée, confiture de lait, chocolat noir, sucre glace', '20 min', ['Préchauffez le four à 180°C (thermostat 6). Étalez la pâte feuilletée et garnissez-en un moule à tarte. Piquez le fond à la fourchette et posez par-dessus un disque de papier sulfurisé et des billes de cuisson (ou des haricots secs). Enfournez pour 15 minutes. Retirez le papier et les billes et poursuivez la cuisson 5 minutes. Laissez refroidir.', 'Montez la crème en chantilly à l''aide d''un batteur électrique. Ajoutez le sucre glace et fouettez à nouveau rapidement, puis conservez au frais.', 'Épluchez les bananes et coupez-les en rondelles. Râpez le chocolat noir. Garnissez le fond de tarte de confiture de lait, puis disposez les rondelles de banane sur le dessus. Recouvrez ensuite l''ensemble de crème chantilly, puis parsemez celle-ci de chocolat noir râpé.', 'Conservez la tarte au frais jusqu''à dégustation.'], ['Fouet', 'Batteur électrique', 'Louche', 'Planche à découper', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'banoffee', 'confiserie', 'testées', 'facile', 'bon marché', 'Tarte banoffee', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'confiture de lait', 'dessert', 'plat de résistance', 'pâte feuilletée', 'chocolat noir', 'sucre glace', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:49:18.986669', [{'ingredient_id': '85d115a1-74e0-46d1-a55e-1329906f8804', 'quantite': '2'}, {'ingredient_id': 'b1cd8e0a-7bc9-46b8-9f26-cec308dc9b3a', 'quantite': '20 cl'}, {'ingredient_id': 'e18d8e6f-7117-4dda-bcf7-2d418091327f', 'quantite': '1'}, {'ingredient_id': '3341ccef-12b5-488d-a41a-db266698b415', 'quantite': '150 g'}, {'ingredient_id': '6b306e37-80db-4f68-a410-f12b47325d2f', 'quantite': '50 g'}, {'ingredient_id': '5910047b-d929-4c5a-a9c9-5f5a91c6744e', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68390, 'Compote de fruits aux marrons', 'pomme, banane, mandarine, marrons', '20 min', ['Eplucher les pommes et les couper en moyens morceaux. Les jeter dans une casserole en y ajoutant la banane coupée en rondelles.', 'Ajouter une poignée de marrons en boîte, 6 ou un peu plus pour corser le goût de la compote, et ajouter aux fruits et marrons le jus de 3 mandarines.', 'Mettre le tout sur feu moyen pendant 20 minutes environ, les Pink Lady garderont ainsi de leur croquant (30 minutes pour des fruits moelleux).', 'Ajouter si besoin une cuillère à soupe d''eau pendant la cuisson.', 'Passer le tout au mixer à petite vitesse, pour ne pas tout écraser et tout agglutiner.'], ['Fouet', 'Spatule', 'Ouvre-boîte', 'Tire-bouchon', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'marrons', 'confiserie', 'testées', 'très facile', 'mandarine', 'bon marché', 'plat', 'recette', 'compote', 'cuisine', 'recettes', 'boisson', 'Compote de fruits aux marrons', 'dessert', 'plat de résistance', 'pomme', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:49:22.608732', [{'ingredient_id': '8dd33474-8aef-4fc8-b9bf-612761fe4689', 'quantite': '5'}, {'ingredient_id': '8e4bfb5a-592c-4952-a764-be7820f11d13', 'quantite': '1'}, {'ingredient_id': '554c1cba-7f3b-4401-8c11-e988ae1b7f21', 'quantite': '3'}, {'ingredient_id': 'e9bff104-ddd7-4f67-ba98-7576149aa9b2', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (84712, 'Compote pommes carottes bananes', 'pomme, carotte, banane, cannelle, gingembre, étoile de badiane', '10 min', ['Couper les carottes en petits dés.', 'Commencer à les faire cuire dans une casserole anti-adhésive avec un fond d''eau pendant 10 minutes environ.', 'Pendant ce temps, éplucher les pommes et la banane.', 'Les couper en dés.', 'Les ajouter aux carottes au bout des 10 minutes de cuisson.', 'Ajouter encore un fond d''eau de manière à ce que ça n''attache pas.', 'Ajouter les épices.', 'Laisser mijoter encore 10 minutes. ', 'Mixer et servir tiède ou froid.'], ['Fouet', 'Rouleau à pâtisserie'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'carotte', 'très facile', 'compote de pomme', 'bon marché', 'plat', 'recette', 'Compote pommes carottes bananes', 'étoile de badiane', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'cannelle', 'cocktail'], 'Dessert', 8fef437f-d31a-4811-a481-51b7ec461489, '2025-09-26T16:49:27.867040', [{'ingredient_id': '26f86d18-8375-473d-9a3f-893f541aadb6', 'quantite': '4'}, {'ingredient_id': '85f369ad-8bd3-4045-bad5-c08055a40611', 'quantite': '4'}, {'ingredient_id': '5022712f-3418-4a2a-98f6-022c94d30813', 'quantite': '1'}, {'ingredient_id': '33cb8cee-c93d-4e85-b811-0d8487daec96', 'quantite': ''}, {'ingredient_id': '330824f1-5852-45e1-b5f7-c8b6bb0573ec', 'quantite': ''}, {'ingredient_id': '04421a96-d57d-49ce-a5b3-ae1a6b664b2c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (59073, 'Gratin de fruits d''hiver à l''alcool de litchi', 'farine, sucre, sucre vanillé, beurre, jaune d''oeuf, liqueur de litchi, pomme, kiwi, poire, banane', '15 min', ['Pelez les fruits et coupez-les en gros morceaux dans un plat.', 'Arrosez-les de liqueur de litchi.', 'Mélangez les autres ingrédients pour obtenir une pâte granuleuse puis disposez la pâte sur les fruits.', 'Cuisez le tout 8 à 12 minutes dans un micro-ondes, position simultanément grill/micro-ondes puissance maximum.'], ['Râpe', 'Verre doseur', 'Ouvre-boîte', 'Balance de cuisine'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'facile', 'bon marché', 'rapide', 'plat', 'Gratin de fruits d''hiver à l''alcool de litchi', 'jaune d''oeuf', 'liqueur de litchi', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'beurre', 'sucre', 'cocktail'], 'Dessert', 0b652df1-a7ce-4bb0-97b9-08c40f266e0c, '2025-09-26T16:49:33.136475', [{'ingredient_id': 'fe027a8e-e8c5-4ea4-af51-684b8d380352', 'quantite': '70 g'}, {'ingredient_id': 'afc5d45f-3740-4f92-902b-7290288b2e34', 'quantite': '120 g'}, {'ingredient_id': '78d7f98e-2403-4cae-ac20-5fa075ce8aea', 'quantite': '1'}, {'ingredient_id': '2ed355ef-2bf6-4e44-acd9-a75351c5bef2', 'quantite': '40 g'}, {'ingredient_id': 'bce5f41a-1e99-4be2-a535-e77ca16140cd', 'quantite': '1'}, {'ingredient_id': 'fde8c101-abe3-43b9-aa42-feced9609988', 'quantite': '2 cuillères'}, {'ingredient_id': 'daa3dd6b-a7cb-4399-b3a3-cfbceadc4794', 'quantite': '2'}, {'ingredient_id': 'b497fb2b-a6ba-4c9a-8379-25db73792e96', 'quantite': '3'}, {'ingredient_id': '45d93807-fd9f-4170-b781-c1981030ea7e', 'quantite': '2'}, {'ingredient_id': '62ad87c8-e268-4b23-8ab3-6c2c6e55f0d2', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57973, 'Brochettes de fruits classiques', 'banane, pomme, poire, fraises, kiwi, ananas', '15 min', ['Prévoir des pic en bois.', 'Préparer et découper en carré les fruits.', 'Tout en variant les couleurs et textures les enfiler sur la brochette.', 'Piquer par la suite les brochettes sur un support, par exemple demi-ananas, demi pamplemousse, quartier de pastèque, melon...', 'Dessert rapide, sympa et flatteur pour les papilles!'], ['Rouleau à pâtisserie', 'Tire-bouchon'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'Brochettes de fruits classiques', 'dessert', 'plat de résistance', 'pomme', 'ananas', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:49:38.050284', [{'ingredient_id': '4f96d902-76c5-4f99-ba7c-6e5e616ec4ab', 'quantite': '500 g'}, {'ingredient_id': '282295e0-7069-485b-82f7-e071f7b3a2f5', 'quantite': ''}, {'ingredient_id': 'c8206dec-09ed-4eb2-8bae-5c5d9ce88e9b', 'quantite': ''}, {'ingredient_id': 'f4efb0db-e744-4952-bca0-35cc5dbb0e5b', 'quantite': ''}, {'ingredient_id': 'a418881d-a89e-4ec2-b1f0-4f323c37b0ef', 'quantite': ''}, {'ingredient_id': 'f06e44ce-023c-42f2-9cb9-a92f2700c96e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (223127, 'Fruits enrobés de chocolat', 'poire, banane, pâte à tartiner, langue', '10 min', ['Pelez et coupez les fruits.', 'Enrobez-les de pâte à tartiner au chocolat.', 'Mettez les fruits sur des cure-dents.', 'Déposez les fruits dans un plat et 10 min au réfrigérateur.', 'Dégustez avec les biscuits.'], ['Poêle', 'Rouleau à pâtisserie', 'Balance de cuisine', 'Économe', 'Spatule'], ['', 'Fruits enrobés de chocolat', 'entrée', 'banane', 'recettes de cuisine', 'langue', 'confiserie', 'testées', 'poire', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail', 'pâte à tartiner'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:49:42.809242', [{'ingredient_id': '18876cc6-0cc8-427e-a9b0-e4a86adbd8d5', 'quantite': '4'}, {'ingredient_id': 'a9fc1a6f-cd4b-483e-ad37-10fbe20ff1d9', 'quantite': '4'}, {'ingredient_id': 'aec39c2b-2e3c-4ea2-98cf-da034ae08573', 'quantite': ''}, {'ingredient_id': '0003097c-c259-4e24-8ada-f864a1517fc1', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (71256, 'compote pommes - bananes à la cannelle', 'pomme, banane, sucre vanillé, cannelle, eau, beurre', '10 min', ['Eplucher les pommes et les bananes, mettre le tout dans un fait-tout avec le sucre, le 1/2 verre d''eau et la cannelle. ', 'Laisser cuire 40 min environ à couvert à petit feu. ', 'Mixer. ', 'Laisser refroidir en ayant soin d''ajouter la noix de beurre. ', 'Vous pouvez l''allonger avec un peu d''eau si elle vous semble trop compacte. ', 'Mettre en pot de confiture. ', 'Elle se conserve au moins une semaine fermée et réfrigérée. ', 'Bon appétit !'], ['Couteau de chef', 'Fouet', 'Passoire', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'compote de pomme', 'bon marché', 'compote pommes - bananes à la cannelle', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'beurre', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:49:46.486792', [{'ingredient_id': '1c0ae588-41ff-44e3-843a-842d0e4a1201', 'quantite': '6'}, {'ingredient_id': '1cf7b1da-9391-4808-a231-df102cab7aa6', 'quantite': '2'}, {'ingredient_id': 'f38568f7-f1c2-495a-b08f-3cd52890300d', 'quantite': '1'}, {'ingredient_id': 'e4eead24-46da-4023-992c-992845e3ea59', 'quantite': ''}, {'ingredient_id': '40e7a485-bbde-4db6-a3a7-80ac68fe1b4b', 'quantite': ''}, {'ingredient_id': '12fd2a54-6d66-469f-8fb1-50df9c530a80', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24534, 'quatre quart aux bananes et aux amandes', 'farine, cassonade, sucre glace, oeuf, beurre demi-sel, levure chimique, banane, amandes en poudre, amandes effilées, rhum', '25 min', ['Faire préchauffer le four thermostat 7/8. ', 'Mélanger le sucre, la farine et la levure ensemble. ', 'Ajouter les oeufs battus avec le rhum. ', 'Faire ramollir le beurre et l''incorporer. ', 'Couper les bananes en morceaux et les écraser avant de les incorporer. ', 'Ajouter la poudre d''amande. ', 'Verser dans le plat à cake et au moment d''enfourner verser les amandes effilées sur le dessus de la préparation.'], ['Râpe', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'cassonade', 'levure chimique', 'très facile', 'bon marché', 'amandes en poudre', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'beurre demi-sel', 'boisson', 'farine', 'dessert', 'plat de résistance', 'quatre quart aux bananes et aux amandes', 'sucre glace', 'amandes effilées', 'quatre quarts', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:49:50.232753', [{'ingredient_id': '51f364f9-39a6-48b3-b8fe-8930d15c0d55', 'quantite': '250 g'}, {'ingredient_id': 'abe3d087-4ffa-47bd-9900-564a76365b64', 'quantite': '150 g'}, {'ingredient_id': '260e34be-fa8c-4067-b676-ff87efb85838', 'quantite': '100 g'}, {'ingredient_id': '9c88e80a-6173-4c5d-9ecd-ad575ecd8d20', 'quantite': '4'}, {'ingredient_id': 'fb464611-7ea7-4d4e-9f1e-ff8b163f5f4c', 'quantite': '250 g'}, {'ingredient_id': '6eed5dc7-b29e-482b-9d73-2c344204772c', 'quantite': '1'}, {'ingredient_id': '5c9ab305-f34a-4fec-b485-0e85a8d0f716', 'quantite': '3'}, {'ingredient_id': '2cd78337-215b-4f22-b6d4-e7fdb35dbc66', 'quantite': '100 g'}, {'ingredient_id': '537f685c-5575-4eda-ac50-7a24e78c37ac', 'quantite': '50 g'}, {'ingredient_id': '040898f9-14c4-4ebe-8410-d725593a0e34', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335552, 'Biscuits à la banane et aux dattes - Sans gluten, sans lactose', 'oeuf, farine de riz, sucre roux, noix de coco rapée, lait d''amande, datte, banane', '10 min', ['Préchauffer le four à 110°C (thermostat 3-4) en chaleur tournante (il est conseillé de ne pas dépasser cette température de cuisson en général, c''est bien meilleur pour la santé !)', 'Dénoyauter les dattes et les couper en petits morceaux. Réserver.', 'Battre l''oeuf dans un saladier.', 'Ajouter le sucre, puis le lait d''amande, la farine et la noix de coco (l''avantage de la farine de riz, en plus de ne pas contenir de gluten et qu''elle ne fait jamais de grumeaux !).', 'Ajouter la banane après l''avoir écrasée en purée.', 'Enfin incorporer les morceaux de dattes à la préparation. ', 'Garnir de petits moules à tartelettes ou à muffins en silicone et enfourner à mi-hauteur pendant 45 minutes.', 'Bon appétit !'], ['Balance de cuisine', 'Verre doseur', 'Mixeur'], ['Biscuits à la banane et aux dattes - Sans gluten', 'sans lactose', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'farine de riz', 'testées', 'lait d''amande', 'très facile', 'autres biscuits et petits gâteaux', 'oeuf', 'plat', 'recette', 'datte', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'moyen', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:49:53.854382', [{'ingredient_id': '2fa08695-fe5d-4fff-9126-4e57ba89bc62', 'quantite': '1'}, {'ingredient_id': 'ac0379a6-4aa9-4902-b939-ba67a94c1e2b', 'quantite': '200 g'}, {'ingredient_id': 'b6e549e6-036a-4609-bd14-0e230c26a9d5', 'quantite': '80 g'}, {'ingredient_id': '5905b028-5fc9-4a47-90f2-6d56d3a2ffeb', 'quantite': '60 g'}, {'ingredient_id': '232a2b21-2e3a-4bd5-bec2-5d00b78bb834', 'quantite': '10 cl'}, {'ingredient_id': 'ce1a45b0-bcfd-472d-a0ac-3e43a517a6c9', 'quantite': '10'}, {'ingredient_id': '1583422d-8e3e-4686-94bf-e9b6c62641fd', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (340287, 'Crumble pommes, bananes et framboises au chocolat', 'pomme, banane, framboises, farine, sucre en poudre, beurre, pralinoise, chocolat noir', '15 min', ['Préchauffez votre four à 180°C (thermostat 6).', 'Beurrez un plat à gratin. Lavez, pelez et coupez les pommes en cubes (à vous de choisir la taille. Plus vous les couperez petits, plus les pommes formeront une compotée). Enlevez la peau des bananes et coupez-les en rondelles pas trop fines.', 'Mélangez les pommes et les bananes et placez-les dans votre plat. Ajoutez les framboises dessus (facultatif).', 'Préparez la pâte à crumble en mélangeant la farine, le sucre et le beurre mou (le mieux est de mélanger avec les doigts). Ajoutez-y les 2 chocolats coupés en petits morceaux à l''aide d''un grand couteau. Vous pouvez bien sûr remplacer le mélange de chocolat et choisir de mettre à la place soit 200 g de chocolat noir, soit 200 g de pralinoise, ou encore de ne pas mettre de chocolat du tout pour un crumble nature (mais le chocolat offre un vrai plus gustatif).', 'Recouvrez les fruits de la pâte à crumble.', 'Mettez au four et laissez cuire entre 20 et 25 min. Personnellement, j''enfourne 20 min et je mets la position gril ensuite pendant 3 min (attention de ne pas faire brûler le crumble dans ce cas).'], ['Tire-bouchon', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'bananes et framboises au chocolat', 'confiserie', 'testées', 'facile', 'framboises', 'bon marché', 'crumble aux pommes', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'pomme', 'pralinoise', 'beurre', 'Crumble pommes', 'cocktail'], 'Dessert', 0cc2a4ab-7a9f-48f0-92ae-1b79b05cc982, '2025-09-26T16:49:57.385778', [{'ingredient_id': '38ac23d2-5591-4a48-9544-f5a911b04652', 'quantite': '5'}, {'ingredient_id': 'fc156812-b49c-491d-bfa7-f8a4edc2d0cc', 'quantite': '5'}, {'ingredient_id': 'c5babc67-9f45-4bd4-baa8-a9dc44155643', 'quantite': '150 g'}, {'ingredient_id': '928dc7b0-967d-43a2-95be-f4b5a12342c2', 'quantite': '250 g'}, {'ingredient_id': '1c96ef86-6b98-4838-a6bd-244ad6582376', 'quantite': '150 g'}, {'ingredient_id': 'f3180822-5a9b-400c-84e8-f7cce8a1013b', 'quantite': '150 g'}, {'ingredient_id': '1b4875a4-3916-4e4e-93f4-04d097369080', 'quantite': '100 g'}, {'ingredient_id': '25666b0e-d406-4ef5-9f92-764a42026631', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345356, 'Millefeuille de pancakes banane-chocolat', 'oeuf, sucre, huile, farine, levure, lait, banane, chocolat, noisettes', '15 min', ['Préparer les pancakes.', 'Faire fondre le beurre, dans une casserole à feu doux ou dans un bol au micro-ondes. ', 'Mettre la farine, la levure et le sucre dans un saladier. Mélanger et creuser un puits. ', 'Ajouter ensuite l''oeuf entiers et fouetter l''ensemble.', 'Incorporer le beurre fondu, fouetter puis délayer progressivement le mélange avec le lait afin d''éviter les grumeaux.', 'Laisser reposer la pâte au minimum 1 heure au réfrigérateur.', 'Dans une poêle chaude et légèrement huilée, faire cuire comme des crêpes, mais en les faisant plus petites. Réserver au chaud et déguster.', 'Faire fondre le chocolat au bain-marie.', 'Couper les bananes en rondelles. ', 'Tartiner un premier pancake de chocolat fondu et disposer des rondelles de bananes. Couvrir avec un second pancake et tartiner de nouveau de chocolat avant de disposer des rondelles de banane. ', 'Répéter l''opération une dernière fois avant de parsemer de noisettes.'], ['Ouvre-boîte', 'Passoire', 'Poêle', 'Planche à découper', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'pancake', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'noisettes', 'levure', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'Millefeuille de pancakes banane-chocolat', 'sucre', 'lait', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:50:01.097546', [{'ingredient_id': '3ae3ba24-5d43-4be5-a5b2-22098a4e6300', 'quantite': '1'}, {'ingredient_id': '626b76e4-6eb8-4314-981f-cd086bb32cd8', 'quantite': '1 cuillères'}, {'ingredient_id': '5d49991b-f9f3-4ed6-b17f-ba5408b5ffd9', 'quantite': '1 cuillères'}, {'ingredient_id': '72eebf86-9715-4837-8602-caf846944ad5', 'quantite': '150 g'}, {'ingredient_id': '9421c701-2bd5-40f0-aa6e-dae6a123679d', 'quantite': '1'}, {'ingredient_id': 'fe1f3216-ea8f-4c86-ac05-9a2e6eda7aa6', 'quantite': '20 cl'}, {'ingredient_id': '3458ee59-d787-4f07-9928-7c8b0d54b481', 'quantite': '2'}, {'ingredient_id': '2ca2c842-5e11-4c3d-a874-8885ed319e1f', 'quantite': '200 g'}, {'ingredient_id': '37121932-b259-4164-a30a-1a0b610ed1f6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (232374, 'Snoomfie, cocktail kiwi, carotte et banane de Bamako', 'kiwi, carotte, banane, sucre, beurre', '180 min', ['Passer le kiwi et les carottes préalablement cuites à l''eau dans un mixeur.', 'Mettre au congélateur durant 2 heures.', 'Faire dorer le beurre dans une poêle, y ajouter la banane coupée en rondelles. ', 'Les laisser cuire à petit feu en les parsemant de sucre. ', 'Laisser refroidir et mixer avec les kiwis et les carottes. ', 'Votre boisson est prête, vous n''avez plus qu''à la déguster avec vos amis.'], ['Presse-agrumes', 'Pince de cuisine'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'carotte', 'Snoomfie', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'carotte et banane de Bamako', 'dessert', 'plat de résistance', 'difficile', 'moyen', 'beurre', 'sucre', 'cocktail', 'cocktail kiwi'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:50:04.769080', [{'ingredient_id': '4708c497-a1e5-4768-8c50-11a53d4cb4f4', 'quantite': '1 l'}, {'ingredient_id': 'e0b7a2db-9133-4d06-8bfd-7e2b5a5fb365', 'quantite': '10 cl'}, {'ingredient_id': '2bd146ad-e914-4b32-9559-6857ae4524dc', 'quantite': '1'}, {'ingredient_id': '1b793aee-a338-42ac-a008-25b80e92b9c2', 'quantite': '100 g'}, {'ingredient_id': '617c8cba-1f51-459a-87fd-58af01e5ad8a', 'quantite': '30 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (219617, 'Crumble aux fruits exotiques (ananas, mangue, banane)', 'ananas, mangue, banane, citron vert, beurre, cassonade, noix de coco, sucre en poudre, pistaches, farine, cannelle, sel', '45 min', ['Dans le bol du robot, réunissez le beurre froid coupé en morceaux, la cassonade, la noix de coco râpé, les pistaches grossièrement hachées, la farine, la cannelle et le sel. ', 'Actionnez l''appareil par à-coup afin d''obtenir une texture de sable grossier. ', 'Préchauffer le four à 180°C (thermostat 6). ', 'Beurrez un plat à four et saupoudrez-le de 1 cuillère à soupe de sucre. ', 'Épluchez et coupez les fruits en dés. Arrosez-les du jus de citron et saupoudrez du reste de sucre. ', 'Mettez dans le plat, recouvrez de la pâte et faites cuire 25 min au four.'], ['Râpe', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'crumble banane', 'testées', 'cassonade', 'plat', 'mangue', 'moyenne', 'sucre en poudre', 'pistaches', 'recette', 'banane)', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'Crumble aux fruits exotiques (ananas', 'beurre', 'ananas', 'citron vert', 'noix de coco', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:50:08.277896', [{'ingredient_id': 'b479cc8c-20a7-4fa6-91d6-b0a15ff2f657', 'quantite': '1'}, {'ingredient_id': '746d21b7-5301-4c07-9ed0-18ca711b272c', 'quantite': '2'}, {'ingredient_id': '0a76b62f-43a4-424f-b762-fdeb72a6fa44', 'quantite': '3'}, {'ingredient_id': '3a899113-41ce-4e5f-9732-1362e759b020', 'quantite': '1'}, {'ingredient_id': 'fef985a4-90fb-4735-9096-19f334a040fa', 'quantite': '100 g'}, {'ingredient_id': '87c6a49d-479d-4707-8f52-cce0941cb175', 'quantite': '100 g'}, {'ingredient_id': '35b7421d-c9a1-419f-a4b7-ca347e79ad97', 'quantite': '60 g'}, {'ingredient_id': '78674d44-950d-4624-8f45-535b0bece42d', 'quantite': '40 g'}, {'ingredient_id': '16542bb5-18df-4b5b-8d8d-ce59d75af5eb', 'quantite': '40 g'}, {'ingredient_id': '091f5965-0542-4416-84ba-b69af27bfa67', 'quantite': '100 g'}, {'ingredient_id': '3ee28aff-a724-49c8-86d7-9f0edf65d23e', 'quantite': '1'}, {'ingredient_id': '8c0bc0d8-c959-4c8f-8fbc-b85c5e962a6c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (309943, 'Bacon de la puce (banane-bacon-miel)', 'banane, bacon, miel, sucre, noix de coco rapée, huile', '10 min', ['Couper la banane en trois tronçons égaux. Enrouler chaque tronçon d''une tranche de bacon épaisse puis les piquer avec le cure-dent afin de faire tenir le tout. Saupoudrer de noix de coco râpée, de sucre puis enrober le tout de miel. ', 'Huiler la poêle puis placer les Bacons de la puce dans la poêle afin de les caraméliser.  ', 'Servir chaud et bon appétit !'], ['Mixeur', 'Poêle', 'Batteur électrique'], ['', 'bacon', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'Bacon de la puce (banane-bacon-miel)', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'huile', 'noix de coco rapée', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:50:13.256363', [{'ingredient_id': 'feed8f32-fa2c-4039-a911-f04ad0a302a9', 'quantite': '1'}, {'ingredient_id': '1f18e3ec-65ba-4556-abf8-538d1c2785d8', 'quantite': '3'}, {'ingredient_id': 'a1055c4c-95e1-4a39-baa5-9fae9578ba70', 'quantite': '50 g'}, {'ingredient_id': '741f540f-fbf0-49ef-b9f9-48a1389816c1', 'quantite': '50 g'}, {'ingredient_id': '24ff8700-472a-4f80-a19c-d67fae91d964', 'quantite': '50 g'}, {'ingredient_id': '9137a205-3260-4c8f-b3e8-66416e6af595', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (63656, 'Rochers coco banane très faciles', 'noix de coco rapée, sucre, oeuf, banane', '5 min', ['Préchauffer le four à 210°C (thermostat 7).', 'Dans un saladier, battre le mélange sucre et oeufs jusqu''à blanchiment.', 'Ecraser la banane à la fourchette dans une assiette à part et l''ajouter au mélange précédent. Incorporer la noix de coco et tout mêler au fouet.', 'Former des petits rochers à l''aide de 2 cuillères sur du papier sulfurisé et mettre au four pendant 15 min (ils doivent avoir une jolie coloration un peu dorée). Laisser refroidir et déguster !'], ['Ouvre-boîte', 'Presse-agrumes', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'sucre', 'Rochers coco banane très faciles', 'rochers', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:50:16.808916', [{'ingredient_id': 'd862dc38-0d2a-4f26-97a2-7b66296d8410', 'quantite': '125 g'}, {'ingredient_id': '8f5b143b-7771-4c56-a148-7de80bd0d392', 'quantite': '125 g'}, {'ingredient_id': '27c53aff-7ada-470a-81c5-9bb2a2adfe62', 'quantite': '1'}, {'ingredient_id': '972cccb2-3e55-4d1d-b89d-c2755e190533', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (342811, 'Tarte choco bananes  facile', 'banane, chocolat, pâte sablée, lait, crème fraîche, sucre', '15 min', ['Faire fondre le chocolat avec le lait, dans une casserole (ou au micro-ondes).', 'Ajouter 3 bonnes cuillères de crème fraîche, mélanger, et verser sur la pâte.', 'Déposer ensuite les bananes coupées en rondelles  sur le nappage.', 'Mélanger les oeufs, le sucre et les 3 cuillères à soupe de crème fraîche restantes, puis le déposer sur le tout.', 'Mettre au four pendant 30 min à thermostat 6 (180°C).'], ['Balance de cuisine', 'Planche à découper', 'Verre doseur'], ['Tarte choco bananes  facile', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'pâte sablée', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:50:20.286392', [{'ingredient_id': '8f65ac80-988c-4a3a-9a74-a01b681377ac', 'quantite': '4'}, {'ingredient_id': 'b2853cbe-39b6-4ee8-9ec1-3f157d764e00', 'quantite': '100 g'}, {'ingredient_id': 'd40d369e-bb70-4c49-bf66-09b5315762b0', 'quantite': '1'}, {'ingredient_id': '4df1b919-072c-4eb8-abe2-12fd0fc77e05', 'quantite': '2 cuillères'}, {'ingredient_id': '50ea5265-3b39-4b68-9a20-e088450a6af7', 'quantite': '6 cuillères'}, {'ingredient_id': 'd2b10994-cd8b-4cf8-bc10-56a57c0dce5a', 'quantite': '70 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (112804, 'Pudding aux bananes', 'pain, biscuits secs, banane, lait, oeuf, sucre en poudre, raisins secs, beurre, gelée, citron, cannelle', '10 min', ['Mettez le four à chauffer à 210°, thermostat 6.', 'Versez le lait dans une casserole et faites le chauffer (mais non bouillir).', 'Emiettez le pain et les biscuits secs dans un grand saladier. Puis versez le lait chaud par dessus et laissez tremper 5 min.', 'Pendant ce temps, séparez les blancs d''oeufs des jaunes. Mettez les blancs dans un saladier et battez les en neige ferme.', 'Dans le saladier où trempe le pain, ajoutez le sucre, les jaunes d''oeufs et 5 cuillerées à soupe de gelée de groseilles. Mixez tous ces ingrédients.', 'Rincez le citron. Râpez-le pour en recueillir le zeste puis pressez-le pour recueillir le jus. Pelez les bananes puis écrasez-les à la fourchette avec le zeste de citron le jus de citron et la cannelle. Versez les bananes dans le saladier et mélangez-les aux ingrédients précédents.', 'Ajoutez les raisins secs et les blancs en neige. Veillez à les incorporer délicatement en remuant de bas en haut afin qu''ils ne" retombent" pas.', 'Beurrez un moule à manqué (avec un moule à charnière, c''est mieux car on peut démouler) puis versez-y la préparation. Enfournez et laissez cuire 50 à 60 min. Faites le test de la lame de couteau.', 'Sortez le pudding du four. Quand il est encore chaud, étalez sur le gâteau la dernière cuillerée de gelée de groseilles.', 'Servez le pudding tiède ou froid.'], ['Couteau de chef', 'Spatule', 'Râpe', 'Mixeur', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Pudding aux bananes', 'très facile', 'biscuits secs', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'pudding', 'dessert', 'plat de résistance', 'gelée', 'citron', 'beurre', 'raisins secs', 'cannelle', 'pain', 'lait', 'cocktail'], 'Dessert', d652a3b4-c7c3-4695-ab03-4fbc1ca7bf91, '2025-09-26T16:50:23.874647', [{'ingredient_id': '18f714c9-24cf-4a58-a237-7d726114223a', 'quantite': '150 g'}, {'ingredient_id': '884fa8b8-4a9d-46a0-9c72-9677fb00fd9f', 'quantite': '150 g'}, {'ingredient_id': '8120392d-bc94-4767-8048-8023057a9d98', 'quantite': '2'}, {'ingredient_id': '61895417-b97d-4a94-9b65-4388c8005629', 'quantite': ''}, {'ingredient_id': 'e54b28c0-bae3-4098-b2c0-d1ec6a5162e7', 'quantite': '2'}, {'ingredient_id': 'edbe09c4-dbc5-45f4-8563-179c7ead94e3', 'quantite': '100 g'}, {'ingredient_id': '77a9236b-d251-4248-aed2-f4cd3d4e3c88', 'quantite': ''}, {'ingredient_id': '915badfc-0b29-404e-bad8-fe3fd451418c', 'quantite': '1 cuillères'}, {'ingredient_id': 'e264bf0a-d137-42b7-b77b-66e6bf95eba7', 'quantite': '6 cuillères'}, {'ingredient_id': 'bb4faac7-176f-4852-9b0e-91430b8f12e3', 'quantite': '1'}, {'ingredient_id': '556b17c2-5f09-49dc-8511-9b300874e610', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (171586, 'Soupe à la carotte, tomate et banane', 'oignon, carotte, poivron rouge, banane, tomates pelées, margarine, cube de bouillon, cube de bouillon, eau, curry', '20 min', ['Couper les oignons et les faire revenir dans un peu de margarine jusqu''à ce qu''ils soient transparents.', 'Couper les autres légumes en petits morceaux (je laisse la peau du poivron) et les ajouter aux oignons.', 'Ajouter 75 cl d''eau, les cubes de bouillons et la boîte de tomates pelées au reste des ingrédients.', 'Laisser cuire plus ou moins 15 min dès ébullition.', 'Passer la soupe au mixer et ajouter le curry.'], ['Louche', 'Verre doseur', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'Soupe à la carotte', 'carotte', 'tomates pelées', 'très facile', 'bon marché', 'plat', 'tomate et banane', 'recette', 'cube de bouillon', 'cuisine', 'poivron rouge', 'recettes', 'oignon', 'boisson', 'margarine', 'soupe', 'dessert', 'plat de résistance', 'curry', 'cocktail'], 'Entrée', fd7a4e57-9be8-42c8-9c65-10862d32aa30, '2025-09-26T16:50:27.481508', [{'ingredient_id': 'e85d79a3-de28-4fb4-9ab2-4df65115ee44', 'quantite': '1'}, {'ingredient_id': '56425f3d-5026-4ac2-b0ed-20001b06c41f', 'quantite': '3'}, {'ingredient_id': 'f74cae23-f697-49ed-bf05-26ef6c5cec31', 'quantite': '1'}, {'ingredient_id': 'c2895564-3e7f-4115-8002-5c830dba0ee6', 'quantite': '1'}, {'ingredient_id': '24b66cb5-8064-4d50-a377-d8a4bb41f5d6', 'quantite': '400 g'}, {'ingredient_id': '48ae5602-8b96-403b-90c5-1d3be131881c', 'quantite': ''}, {'ingredient_id': 'f917f1f9-ea40-458d-80db-246b54e1ffe8', 'quantite': '1'}, {'ingredient_id': '8e0dbcb5-d0e2-4296-bafe-7663fa2663a0', 'quantite': '1.5'}, {'ingredient_id': 'ce870edb-753d-4de0-92ce-fab8f381da62', 'quantite': '75 cl'}, {'ingredient_id': 'ccb7b09e-093e-4566-b9c1-0d874bf33d20', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14160, 'Gâteau léger chocolat et banane', 'chocolat noir, lait, farine, oeuf, café, cannelle, banane', '10 min', ['Dans une casserole, faire fondre le chocolat avec le lait et le miel.', 'Le verser dans un saladier. Ajouter l''oeuf entier, la farine, la levure et la cannelle. Bien mélanger (rajouter du lait si nécessaire) et mettre les tranches de banane.', 'Beurrer ou huiler un moule a cake, verser la préparation et faire cuire a four chaud (180°C) pendant 20 a 25 minutes.'], ['Passoire', 'Moule à tarte', 'Mixeur', 'Planche à découper', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'Gâteau léger chocolat et banane', 'plat', 'recette', 'café', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'gâteau au chocolat', 'cannelle', 'lait', 'cocktail'], 'Dessert', 47c524e7-7dbc-4897-a860-26afcf700359, '2025-09-26T16:50:34.377543', [{'ingredient_id': '52b24ef6-295f-46d8-8e64-bc7e88e55163', 'quantite': '50 g'}, {'ingredient_id': 'b522b608-1412-466c-bbd0-cce8a086f8b4', 'quantite': ''}, {'ingredient_id': '2784db18-d321-4cc5-950d-0fbd3b62fa11', 'quantite': '100 g'}, {'ingredient_id': '3aad52d6-978d-4441-a600-4418fab8b9c9', 'quantite': '1'}, {'ingredient_id': '11ff862f-f0ba-431a-9717-04bf6813230b', 'quantite': '1 cuillères'}, {'ingredient_id': 'a7db1723-9a23-4654-b37b-1a4a892150a6', 'quantite': ''}, {'ingredient_id': '88782ad3-ed86-446f-909a-3f3ca3e09454', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42620, 'milk-shake banane/oranges (sans produits laitiers)', 'biscuit, orange, banane', '5 min', ['Dans un pot à milk-shake, mettre les biscuits et la banane.', 'Les arroser avec le jus des oranges frais, et mixer le tout. ', 'Voilà, il n''y a pas plus simple, vous venez de réaliser votre milk-shake sans produits laitiers! ', 'A déguster tout de suite.'], ['Balance de cuisine', 'Couteau de chef', 'Râpe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'milk-shake banane/oranges (sans produits laitiers)', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'biscuit', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'orange', 'cocktail'], 'Boisson', ca5c36e5-584b-4822-8be0-0b3283c89d39, '2025-09-26T16:50:38.171757', [{'ingredient_id': '6de7365a-d563-4d3c-a451-3f8276a14317', 'quantite': '4'}, {'ingredient_id': '43be6d15-8827-4454-bbc1-f1e3247dbfe8', 'quantite': '2'}, {'ingredient_id': '5c14962e-5c02-4b05-9037-8d2d701a15b9', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (45924, 'Coupe de crème au chocolat et ses surprises', 'crème dessert au chocolat, banane, spéculoos, pralin, crème chantilly', '5 min', ['Couper les bananes en rondelles, les disposer au fond des coupes.', 'Mélanger les crèmes dessert au chocolat pour que ce soit bien onctueux et en verser 2 par coupe, sur les bananes.', 'Planter 2 speculoos dans ce mélange et saupoudrer d''une cuillère à soupe de pralin par coupe.', 'Un peu de chantilly sur le dessus et hop, c''est prêt en 5 min pour un goûter ou un dessert improvisé !'], ['Balance de cuisine', 'Fouet', 'Verre doseur', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'pralin', 'dessert', 'plat de résistance', 'crème au chocolat', 'crème dessert au chocolat', 'cocktail', 'Coupe de crème au chocolat et ses surprises'], 'Dessert', c6f4c623-c88e-49e7-936e-5dd3191c14ae, '2025-09-26T16:50:41.865225', [{'ingredient_id': '973369f6-669c-40f4-b97c-ac0394000f4d', 'quantite': '4'}, {'ingredient_id': '155a6cd8-1147-4547-b36a-4b7f0bc011f8', 'quantite': '1'}, {'ingredient_id': '60fdb3d6-b7b3-4bd5-b8dc-f5f9eef97f3b', 'quantite': '4'}, {'ingredient_id': '4776747a-1013-4463-94ad-c9e3b97b8a8e', 'quantite': '2 cuillères'}, {'ingredient_id': 'a98e1867-06bc-4f83-b6c7-360acc867d63', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46077, 'Gâteau à la banane (avec machine à pain)', 'huile, oeuf, lait, farine, sucre, sucre vanillé, levure, banane', '10 min', ['Mettre les ingrédients dans la machine à pain dans l''ordre (liquides, farine, sucre et levure).', 'Choisir le programme gâteau de la machine.', 'Eplucher les bananes et les couper en rondelles. ', 'Mettre les bananes au premier signal sonore, ou lorsque la pâte est bien homogène (la machine doit continuer à tourner!).', 'Laisser la machine faire le reste...'], ['Fouet', 'Verre doseur', 'Batteur électrique', 'Couteau de chef', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'gâteau à la banane', 'lait', 'sucre', 'Gâteau à la banane (avec machine à pain)', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:50:45.259474', [{'ingredient_id': 'e880230c-a6ab-4047-a729-3e7b87826a2f', 'quantite': '200 g'}, {'ingredient_id': 'c7bfd2dd-9adf-4e33-95c6-b5dce002fc46', 'quantite': '3'}, {'ingredient_id': 'a6c8e51c-914a-48a7-bd24-0b9ad06c0b00', 'quantite': '4 cuillères'}, {'ingredient_id': 'bf743fa9-967d-457f-9508-5984e44f7329', 'quantite': '250 g'}, {'ingredient_id': '61fda96a-4acf-41bd-982a-4071fc830fd7', 'quantite': '200 g'}, {'ingredient_id': '53b63390-3eac-47ef-8248-8bbbce1810ab', 'quantite': '1'}, {'ingredient_id': 'b020b2d7-5360-4c05-a6f9-9e3600600600', 'quantite': '1'}, {'ingredient_id': '99dc1035-de56-4cf0-95d4-ad4ce0e579a3', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (87095, 'Crêpes banane-chocolat', 'crêpe, banane, beurre, sucre en poudre, chocolat pâtissier, crème fraîche, sucre en poudre', '15 min', ['Préchauffez le four à 180°C (thermostat 6).', 'Mettez du papier sulfurisé sur la plaque du four. ', 'Disposez une crêpe sur un côté de la plaque. ', 'Posez au centre de la crêpe une petite noisette de beurre et 4 rondelles de banane au-dessus. ', 'Saupoudrez légèrement de sucre en poudre (1/2 cuillère à café environ) puis refermez la crêpe en piquant un cure-dents pour faire tenir le tout.', 'Renouvelez l''opération 4 fois et saupoudrez toutes les crêpes de sucre en poudre.', 'Vous pouvez maintenant mettre la plaque dans le four et laissez 10 min environ en surveillant.', 'Pendant ce temps, faites fondre le chocolat dans une petite casserole à feu très doux, ajoutez la crème et le sucre. ', 'Mélangez bien jusqu''à obtenir un mélange homogène et lisse.', 'Lorsque les crêpes sont prêtes, disposez une crêpe au centre d''une assiette, enlevez le cure-dent, faites un liseré de chocolat dans l''assiette autour de la crêpe (c''est un exemple de présentation !).'], ['Fouet', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'crêpe', 'dessert', 'Crêpes banane-chocolat', 'plat de résistance', 'crêpes sucrées', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:50:50.057922', [{'ingredient_id': 'bd2bf5c2-421e-4da4-ab7e-a6e7720bc527', 'quantite': '4'}, {'ingredient_id': '54b760af-9863-474e-9f21-295fce735ae8', 'quantite': '1'}, {'ingredient_id': '0cb99e65-8071-49b5-85f0-128b20dab51c', 'quantite': '20 g'}, {'ingredient_id': '33cbd15b-1d11-46bc-8904-a0c1c59c4cd4', 'quantite': ''}, {'ingredient_id': 'b0816c29-4845-4c2b-a868-47391c02fbd6', 'quantite': ''}, {'ingredient_id': '4313536c-65af-422e-9761-60e08ffd0b1d', 'quantite': '10 cl'}, {'ingredient_id': 'af5ac115-0b48-476e-a5c4-732c318c228a', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (232586, 'Smoothie banane orange et yaourt', 'banane, orange, yaourt nature, glaçons', '5 min', ['Couper les bananes et les oranges en morceaux.', 'Mixer le tout dans un blender avec les glaçons et le yaourt nature sucré.', 'Bonne dégustation !'], ['Batteur électrique', 'Planche à découper', 'Râpe', 'Moule à tarte', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Smoothie banane orange et yaourt', 'glaçons', 'orange', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:50:53.531392', [{'ingredient_id': 'd1315845-5574-40ae-927b-fc19bd0c9936', 'quantite': '2'}, {'ingredient_id': 'd77276ec-a79f-4e95-b5d6-37a393c528d7', 'quantite': '3'}, {'ingredient_id': 'f5cb815b-d744-4d4f-9263-d6cf5fd087ec', 'quantite': '1'}, {'ingredient_id': '1554f06e-059d-489d-8c90-5947e1bbd3d6', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (231425, 'Muffins moelleux banane et orange, sans matière grasse', 'banane, orange, oeuf, sucre vanillé, sucre, farine, levure, raisins secs', '10 min', ['Écraser la banane dans un saladier.', 'Presser le jus de l''orange et l''ajouter à la banane écrasée.', 'Battre l’œuf et l''ajouter au mélange banane/orange.', 'Ajouter les sucres.', 'Ajouter farine et levure puis mélanger.', 'Terminer par les raisins secs.', 'Remplir des moules en silicone de petite taille (mini muffin, madeleine...)', 'Enfourner pour environ 15 minutes à 200°C (th 6-7) (dans mon petit four électrique)', 'Déguster froid ou tiède (encore meilleur selon moi)'], ['Économe', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'sans matière grasse', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'muffin', 'orange', 'raisins secs', 'sucre', 'cocktail', 'Muffins moelleux banane et orange'], 'Confiserie', fe0d6243-3bb3-41ab-847d-d291acbe37a3, '2025-09-26T16:50:57.143661', [{'ingredient_id': '369335d1-bde8-45fb-afbf-be63230d0599', 'quantite': '1'}, {'ingredient_id': '92069db1-be62-42b7-89fe-3ac3acc4f7f6', 'quantite': '1'}, {'ingredient_id': '8938571f-247b-42c0-8c7e-9ae68113829b', 'quantite': '1'}, {'ingredient_id': '3b264655-f4cb-4f9e-ba66-c9daa223bb53', 'quantite': '1'}, {'ingredient_id': '6c988a4c-3449-4289-9725-088166d2f37b', 'quantite': '30 g'}, {'ingredient_id': '782fe820-f969-4410-ae0f-aaf5165d5e13', 'quantite': '150 g'}, {'ingredient_id': 'aba15079-b7ff-4213-8775-c3348c4e3ddb', 'quantite': ''}, {'ingredient_id': 'cece9205-6e58-4432-b12d-a8ff449cc55c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20433, 'Tarte au chocolat, bananes et noix', 'pâte sablée, chocolat, banane, cerneau de noix, beurre, sucre, jaune d''oeuf, légumes', '15 min', ['Préchauffez le four à 170 °C (th.6). Abaissez la pâte puis foncez un moule à tarte avec celle-ci. Piquez le fond de tarte avec une fourchette, couvrez-le d''une feuille de papier sulfurisé et remplissez-le de légumes secs. ', 'Enfournez la pâte à "blanc" pendant 20 minutes puis retirez ensuite les légumes et le papier. ', 'Faites fondre le chocolat en morceaux au bain-marie avec une cuillère à soupe d''eau. Lorsqu''il est fondu, ajoutez le beurre en noisettes. Mélangez bien, laissez tiédir quelques minutes puis ajoutez les jaunes d''oeufs et le sucre. Réservez. ', 'Pelez les bananes et coupez-les en rondelles. Disposez-les sur le fond de tarte avec les cerneaux de noix. Réservez-en quelques-unes pour la décoration ainsi que quelques cerneaux de noix. ', 'Nappez la tarte de préparation au chocolat puis enfournez-la pour 20 minutes. ', 'Laissez ensuite refroidir. Au moment de servir, démoulez la tarte, décorez-la avec les rondelles de bananes et les cerneaux de noix réservés. ', 'Pour gagner un peu de temps, faites fondre le chocolat au micro-ondes avec le beurre et l''eau à pleine puissance pendant 1 minute. Vous obtiendrez un résultat très satisfaisant.'], ['Moule à tarte', 'Ouvre-boîte', 'Casserole'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'cerneau de noix', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'pâte sablée', 'légumes', 'bananes et noix', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'recettes', 'boisson', 'Tarte au chocolat', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:51:00.819149', [{'ingredient_id': '7ec42a50-da6e-41d3-be90-3401010fd245', 'quantite': '250 g'}, {'ingredient_id': 'ddaff5d5-4ede-4895-9436-2cc8277cc472', 'quantite': '250 g'}, {'ingredient_id': 'a258848c-393e-45f1-9dd4-cff5daae17d6', 'quantite': '5'}, {'ingredient_id': '37df4ec8-166b-4e15-aa63-600649beed4a', 'quantite': '100 g'}, {'ingredient_id': '30a50b6c-7fd6-42bc-9957-79fe791c97e7', 'quantite': '100 g'}, {'ingredient_id': '4cfbdee9-5f1b-4027-9c90-695f1d6b8ac9', 'quantite': '100 g'}, {'ingredient_id': 'ad1586b1-61ac-4368-ae63-efe73982922e', 'quantite': '2'}, {'ingredient_id': '8beb3859-0bf5-465c-a59f-a0b507106030', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12265, 'Curry de veau', 'sauté de veau, oignon, ail, tomate, lait de coco, curry, gingembre, chutney, noix de cajou, raisins secs, banane, ananas, safran, riz thaï', '30 min', ['Epluchez et hachez ensemble oignons et ail.', 'Faites revenir dans de l''huile d''olive.', 'Ajoutez le curry, puis les tomates.', 'Faites revenir la viande dans un autre ustensile, puis ajoutez-la au reste.', 'Ajoutez le lait de coco. Faites mijoter 30 mn.', 'Ajoutez le gingembre et le chutney, salez, puis faites mijoter encore 1h.', 'Servez avec riz thaï bien safrané et dans 4 bols :', '- noix de cajou', '- raisins secs', '- bananes en rondelles', '- morceaux d''ananas.'], ['Pince de cuisine', 'Râpe', 'Passoire'], ['noix de cajou', 'lait de coco', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Curry de veau', 'ail', 'tomate', 'plat', 'recette', 'sauté de veau', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'ananas', 'raisins secs', 'riz thaï', 'curry', 'viande à l''indienne', 'cocktail', 'safran', 'chutney'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:51:05.501026', [{'ingredient_id': 'bc036429-09d6-48d3-82e3-82e211cf30ed', 'quantite': '1.6 kg'}, {'ingredient_id': '72115697-5273-4c9a-ba82-177ee06e900d', 'quantite': '4'}, {'ingredient_id': '5d70012a-fa00-427e-939b-2b9c6955081b', 'quantite': '4'}, {'ingredient_id': '72ca885b-a050-4279-8c80-512cfa5a463c', 'quantite': '600 g'}, {'ingredient_id': '3d15a9b7-bc0e-4fa3-8748-896f27732f8d', 'quantite': '500 g'}, {'ingredient_id': '9a45c383-25a3-4d02-b2c6-fa49e272e903', 'quantite': '50 g'}, {'ingredient_id': '1d579522-c9eb-4496-a166-99e057535468', 'quantite': '15 g'}, {'ingredient_id': '74a96e8b-9efa-4701-9acc-522bfad3c1d4', 'quantite': ''}, {'ingredient_id': '4a364bdb-b0f8-4322-ad7f-505afedeab97', 'quantite': ''}, {'ingredient_id': '03191318-329f-41dc-9d19-6cea974ba5e2', 'quantite': ''}, {'ingredient_id': '915a13af-7c57-4347-88b5-37ccb7f558f4', 'quantite': '3'}, {'ingredient_id': '400dcd1c-8e62-4f88-80f0-7de4e1d92773', 'quantite': '1'}, {'ingredient_id': '84359bfd-2fcb-4ed4-a41e-8723b4daaeaa', 'quantite': ''}, {'ingredient_id': 'c0693360-5a16-43f3-8c85-58b739e2b852', 'quantite': '800 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (69360, 'Coupe cocobanananas', 'ananas, banane, sucre de canne, rhum, glace vanille, crème chantilly, noix de coco rapée', '10 min', ['Eplucher, couper l''ananas et les bananes en cubes et les saupoudrer de sucre de canne.', 'Faire caraméliser le tout dans une poêle antiadhésive.', 'Déglacer avec le rhum et mettre au frais.', 'Le moment du dessert venu, préparez 4 jolies coupes .', 'Garnir le fond de chacune de votre compote des îles. ', 'Déposer les boules de glace à la vanille, napper de chantilly et terminer avec une pluie de noix de coco râpée.'], ['Moule à tarte', 'Poêle', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Coupe cocobanananas', 'rhum', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'sucre de canne', 'glace vanille', 'noix de coco rapée', 'dessert', 'plat de résistance', 'moyen', 'ananas', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:51:09.108392', [{'ingredient_id': '3f13728e-3b61-45eb-b7d3-1dd7d261f24b', 'quantite': '1'}, {'ingredient_id': 'a6530b07-eab9-44ab-90c9-2ea8663d8df6', 'quantite': '2'}, {'ingredient_id': '01a060d5-19fa-4513-bf27-5cbba967d273', 'quantite': '2 cuillères'}, {'ingredient_id': '86a84217-bfa6-4c8f-bcfa-fe4c44b52593', 'quantite': '2 cuillères'}, {'ingredient_id': 'df9cc8ee-1c2d-46ce-8d29-e9f6e7068ce5', 'quantite': ''}, {'ingredient_id': '90a5a3cf-c97b-4368-a8e5-83428769a2c0', 'quantite': ''}, {'ingredient_id': 'd37e72ec-8d29-4938-abb9-5010c86e64f1', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (341935, 'Gâteau banane et Nutella', 'sucre de canne, cassonade, levure chimique, farine, yaourt, Nutella, banane, huile, crème semi-épaisse, oeuf', '20 min', ['Faire chauffer le four à thermostat 6 (180°C). ', 'Éplucher les bananes, puis les couper en tranches de taille moyenne. Conserver. ', 'Mettre dans un bol : la crème, les oeufs entiers et le sucre (cassonade). Obtention mousseuse. ', 'Ajouter la farine et la levure. Mélanger.', 'Puis incorporer l''huile dans la pâte, mélanger petit à petit jusqu''à obtention d''un mélange uniforme et lisse. ', 'Diviser la pâte en 2 parties, chacune dans un bol. ', 'Dans le bol 1 : mettre les bananes et mélanger sans les écraser. ', 'Dans le bol 2 : mettre les cuillères de Nutella, remuer jusqu''à obtention d''une pâte homogène.', 'Par la suite, mettre du papier sulfurisé le plat. Puis mettre le contenu du bol 2, repartir de façon égale. ', 'Ajouter ensuite par dessus le bol 1, repartir également de façon égale. ', 'Option : faire des trais de Nutella sur le dessus à l''aide d''une cuillère. ', 'Mettre le gâteau au four, 180°C pendant 40/45 minutes .', 'Manger tiède ou froid. ', 'Super bon accompagné d''un jus de fruit ou d''un smoothie maison.'], ['Louche', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'crème semi-épaisse', 'confiserie', 'testées', 'cassonade', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'sucre de canne', 'farine', 'Nutella', 'dessert', 'plat de résistance', 'Gâteau banane et Nutella', 'gâteau à la banane', 'cocktail'], 'Dessert', 41e14256-8e78-47a6-9ab6-2d67941efc67, '2025-09-26T16:51:12.674917', [{'ingredient_id': '38fee3fa-4c60-48be-9830-72bf3f22d863', 'quantite': ''}, {'ingredient_id': '398aedda-9879-473b-a3db-3c1efa8957f3', 'quantite': ''}, {'ingredient_id': '7aa0b2eb-f210-4159-ae9d-bbd19913d5bd', 'quantite': '1'}, {'ingredient_id': '149bbbf1-37c2-4889-b8d3-8f1802fc8310', 'quantite': '3'}, {'ingredient_id': 'f20d340e-c38b-4834-858a-7f6b0c30202f', 'quantite': '1'}, {'ingredient_id': '42b25564-5329-482e-b2f7-016853b36bae', 'quantite': '5 cuillères'}, {'ingredient_id': '6a96878f-629d-4fac-a0a8-257a2c3359db', 'quantite': '3'}, {'ingredient_id': '8e701b77-1d7e-4bab-be69-f4409065522e', 'quantite': ''}, {'ingredient_id': '2322be0e-fd89-4fa8-8e85-21eb08b11be6', 'quantite': ''}, {'ingredient_id': '09f29b40-75b0-4e3c-b092-e4162c8d30a0', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56705, 'Crème de bananes', 'banane, crème fraîche, sucre de canne, rhum, jus de citron', '10 min', ['Eplucher les bananes, les couper en petits morceaux pour qu''elles soient plus faciles à écraser à la fourchette ou au mixeur.', 'Verser dessus le jus de citron.', 'Les mettre dans un saladier et ajouter la crême fraîche, le sucre et le rhum.', 'Bien mélanger le tout pour obtenir une crême onctueuse.', 'Répartir dans des ramequins.', 'Décorer avec une cerise confite ou une framboise ou autre fruit.', 'Mettre au réfrigérateur pendant au moins deux heures.', 'Servir en dessert avec éventuellement un gâteau sec sablé.'], ['Casserole', 'Presse-agrumes', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'confiserie', 'testées', 'Crème de bananes', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'dessert', 'plat de résistance', 'jus de citron', 'cocktail'], 'Dessert', ce172b74-9ca3-4bbd-bcde-4ca1020bf15e, '2025-09-26T16:51:16.243568', [{'ingredient_id': 'b20904d1-ded2-4abd-b8b4-a206174e5827', 'quantite': '5'}, {'ingredient_id': '1f563766-0a92-4bf2-846f-5d6339467a72', 'quantite': '4 cuillères'}, {'ingredient_id': '4d50b2a9-7069-469a-afc9-781e1897d096', 'quantite': '2'}, {'ingredient_id': 'a240ac86-07eb-45b5-8800-e1ca06ac4dbc', 'quantite': '2 cuillères'}, {'ingredient_id': '7f31d4eb-8cfa-4c9a-8599-a4af5cf50c18', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (223605, 'Muffins au Banania', 'farine, oeuf, lait, sucre vanillé, levure, beurre, sucre, crème fraîche, sucre, cacao', '20 min', ['Mélangez tous les ingrédients (sauf ceux du fondant) puis remplir des moules en silicone à 1/4.', 'Pour le fondant, mélangez la crème fraiche, le Banania et le sucre dans une casserole. Chauffez à feu doux 5 min en remuant doucement.', 'Dans chaque moule mettre une cuillère à café de la préparation chocolatée et recouvrir de jusqu’à la moitie de la pâte.', 'Au four pendant 15 min a 180° C (thermostat 6).'], ['Spatule', 'Balance de cuisine'], ['Muffins au Banania', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'muffin', 'beurre', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:51:19.981228', [{'ingredient_id': '8f5edfc8-c3b7-4a54-be4a-edb97f338194', 'quantite': '120 g'}, {'ingredient_id': 'a3d044d9-6a99-47b5-8b90-5ec34b8a0684', 'quantite': '2'}, {'ingredient_id': '70c9390d-d2c7-4924-90e5-ca12edb1491c', 'quantite': '4 cuillères'}, {'ingredient_id': 'b406bd47-d622-4c2f-8f90-280a9432901f', 'quantite': '1'}, {'ingredient_id': '6735313b-6318-4cc5-a59a-34241f40302d', 'quantite': '1'}, {'ingredient_id': '267b16b9-e109-4995-9ace-0c11551b1838', 'quantite': '50 g'}, {'ingredient_id': '5b954a68-139a-4cfe-b8d2-ee06868c3b74', 'quantite': '60 g'}, {'ingredient_id': '88110ba7-2f07-48dc-ae1d-923b3d48a33c', 'quantite': '100 g'}, {'ingredient_id': '4bc4d1ac-a40c-452b-b189-fe2c19196fba', 'quantite': '1 cuillères'}, {'ingredient_id': 'd541fec4-e0b4-430c-b2fa-9cefbbf94c68', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36090, 'Velouté courgette banane (soupe)', 'courgette, banane, oignon jaune, lait, huile d''olive, cumin en poudre', '5 min', ['Emincer l''oignon et couper les courgettes en tranches sans les éplucher (ça donnera de la couleur au velouté). Les faire suer dans une casserole avec un filet d''huile d''olive.', 'Ajouter les bananes coupées en rondelles et arroser avec le lait. Ajouter une cuillère à café de cumin en poudre et assaisonner.', 'Porter à ébullition puis laisser cuire sur feu doux 20 à 30 min (les courgettes doivent être tendres).', 'Passer au mixeur ou au moulin à soupe. Servir bien chaud après avoir donné quelques tours de moulin à poivre.'], ['Spatule', 'Casserole', 'Louche', 'Économe', 'Pince de cuisine'], ['oignon jaune', 'entrée', 'banane', 'cumin en poudre', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Velouté courgette banane (soupe)', 'huile d''olive', 'soupe', 'dessert', 'plat de résistance', 'courgette', 'lait', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:51:23.519685', [{'ingredient_id': '5234cc4b-9e9c-4651-b133-643d8e78ab8d', 'quantite': '4'}, {'ingredient_id': '34f223ba-be7a-49e3-a775-76ce52358b32', 'quantite': '2'}, {'ingredient_id': '322116f9-c361-4229-bf62-9d666b1c481b', 'quantite': '1'}, {'ingredient_id': '48411d05-0413-40eb-9365-776050a53eb8', 'quantite': '75 cl'}, {'ingredient_id': 'c1d37c79-ff0f-4f9d-b6c2-42f985e9c461', 'quantite': ''}, {'ingredient_id': '65818f59-371c-4cc8-9832-fc43878acc55', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12127, 'Banane en robe des champs', 'brick, banane, jus de citron, chocolat noir, beurre, sucre roux, glace vanille', '20 min', ['Mettre le four à chauffer à 180°C.', 'Eplucher les bananes, puis les couper en deux dans la longueur et les arroser du jus de citron.', 'Réserver.', 'Faire fondre le beurre dans une poele (ne pas le laisser noircir). ', 'Dès qu''il est chaud, y déposer les 12 moitiés de bananes essuyées. Faire rôtir à feu moyen. Saupoudrer de la cuillère de sucre roux, faire caraméliser. Garder au chaud dans la poêle.', 'Couper les feuilles de brick en deux. Déposer au centre de chaque demi feuille de brick un morceau de banane. Le recouvrir avec la barre de chocolat.', 'Terminer par l''autre morceau de banane.', 'Enrouler la feuille de brick façon bonbon. Attacher avec de la ficelle de cuisine ', 'Mettre à cuire 12 minutes au four thermostat 150 ou 5. Déposer un bonbon sur chaque assiette', 'après avoir retiré les ficelles.', 'Compléter par une boule de glace à la vanille ou de la crème chantilly.', 'Si votre gourmpandise vous pousse au vice, je vous propose d''arroser la vanille ou la crème chantilly de chocolat noir fondu dans lequel vous aurez délayer une cuillère à soupe de crème fraîche.', 'Autre suggestion : remplacer le sucre roux par 1 cuillère à soupe de rhum ambré et faites flamber...Miam !', 'Bon pour le moral, excellent pour la ligne !'], ['Rouleau à pâtisserie', 'Économe', 'Poêle', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'chocolat noir', 'jus de citron', 'beurre', 'Banane en robe des champs', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:51:27.087981', [{'ingredient_id': 'c97ab1da-75de-4c98-ba38-3c542a18c305', 'quantite': '3'}, {'ingredient_id': '0f66d459-c9f2-4955-8727-025d016d7d30', 'quantite': '6'}, {'ingredient_id': '578f4220-0ec2-4439-b376-e2c52b487e52', 'quantite': '1'}, {'ingredient_id': '3b04cbfa-269e-41b6-ac32-ae0561faffcf', 'quantite': '6'}, {'ingredient_id': '51f01cb3-98cf-4578-927c-b5cef8e95383', 'quantite': '1 cuillères'}, {'ingredient_id': 'f3692e36-24d7-4801-b1b8-a9d4986b68ef', 'quantite': '1 cuillères'}, {'ingredient_id': 'dc22f74f-ecae-48a3-8dbd-de7b21149e07', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40008, 'Tiramisu bananes-chocolat', 'biscuits à la cuillère, mascarpone, oeuf, sucre, banane, chocolat noir, sel, rhum, eau, sucre', '20 min', ['Préparez le sirop en mélangeant l''eau, le sucre et le rhum. ', 'Puis laissez refroidir quelques minutes.', 'Ensuite, trempez les biscuits dans le sirop, et recouvrez-en le fond d''un moule.', 'Préparez la mousse : cassez les oeufs, en séparant les jaunes des blancs, et réservez-les dans deux jattes.', 'Fouettez les jaunes d''oeufs avec le sucre, jusqu''à ce que le mélange blanchisse, double de volume, et coule comme un ruban épais, lorsqu''on le soulève avec le fouet.', 'Battez le mascarpone à la fourchette. Ajoutez-le aux jaunes d''oeufs battus, et mélangez.', 'Montez les blancs d''oeufs en neige avec une pincée de sel. ', 'Lorsqu''ils sont bien fermes, incorporez-les, délicatement, à la crème au mascarpone. A l''aide d''une grande spatule, soulevez largement la crème, pour en recouvrir les blancs en neige.', 'Versez les 1/3 de la mousse au mascarpone dans le moule. Lissez avec une spatule. Recouvrir avec les bananes coupées en rondelles, puis avec le chocolat fondu. Versez le reste de la mousse, lissez à nouveau.', 'Placez le moule, au moins 4 h au réfrigérateur. Servez frais.'], ['Mixeur', 'Poêle', 'Moule à tarte', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'sel', 'confiserie', 'testées', 'assez cher', 'Tiramisu bananes-chocolat', 'biscuits à la cuillère', 'rapide', 'oeuf', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'tiramisu', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:51:31.714896', [{'ingredient_id': 'c01e3b73-1c71-4b7b-be30-3bc524578348', 'quantite': '20'}, {'ingredient_id': 'b40b1337-1bd2-4dc9-8f71-4f72a5fb1b9b', 'quantite': '250 g'}, {'ingredient_id': '4e09cf00-bdc1-41ea-804b-732955a6fa52', 'quantite': '3'}, {'ingredient_id': '27ff63c0-e909-400c-b36e-6268ece3d775', 'quantite': '150 g'}, {'ingredient_id': 'c0228e38-37d2-46b7-afa2-6f1e460db9ee', 'quantite': '3'}, {'ingredient_id': 'bf33f7e3-0986-4fc7-bef5-d5f868018729', 'quantite': '100 g'}, {'ingredient_id': '6eb2e085-bcb2-40cb-a74b-14c7bc14c72f', 'quantite': '1'}, {'ingredient_id': '0434bf82-4897-4fd2-ba0a-2948c72c4d78', 'quantite': '3 cuillères'}, {'ingredient_id': '143e577a-fe98-4c21-905e-108bc32cf7b0', 'quantite': '20 cl'}, {'ingredient_id': 'f74a7757-3e73-464d-8f56-55751ccc70bf', 'quantite': '60 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336534, 'Crème de banane au basilic', 'banane, ail, huile d''olive, basilic frais, sel, origan', '20 min', ['Couper les bananes en morceaux, de manière à pouvoir plus facilement les écraser à la fourchette. Couper l''ail en très fines lamelles et l''écraser avec la fourchette jusqu''à obtention d''une "pâte". Écraser les morceaux de banane de la même manière en y incorporant la "pâte" d''ail. Ajouter 3 cuillères à soupe d''huile d''olive, le sel et l''origan (quantité selon votre goût, mais attention de ne pas masquer le goût de l''huile d''olive et du basilic). A l''aide de la fourchette faire pénétrer l''huile. ', 'Écraser / mélanger jusqu''à obtention d''une crème onctueuse, sans plus aucune trace d''huile en périphérie. Couper menu les deux grosses feuilles de basilic et les ajouter avec la dernière cuillère à soupe d''huile d''olive. Écraser / mélanger jusqu''à obtention d''une crème onctueuse, sans plus aucune trace d''huile en périphérie.'], ['Mixeur', 'Poêle'], ['', 'origan', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'ail', 'rapide', 'plat', 'recette', 'cuisine', 'basilic frais', 'recettes', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'Crème de banane au basilic', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:51:36.264915', [{'ingredient_id': 'ee054e4e-2f92-430e-9d71-ce75d66bb0bd', 'quantite': '2'}, {'ingredient_id': 'a4ad22e2-b4a0-4075-9e09-6fd245b40897', 'quantite': ''}, {'ingredient_id': 'f2879300-0ea4-42ab-acc9-eb626054c244', 'quantite': '4 cuillères'}, {'ingredient_id': 'f25487c1-7b55-4e7c-90ff-7e6d8c37b86f', 'quantite': '2'}, {'ingredient_id': '4d15b21f-b62b-48a5-affd-5952fe0a0412', 'quantite': ''}, {'ingredient_id': 'e4742310-345a-4aa2-9238-a0379ea49ebd', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21472, 'GATEAU POMMES -BANANE RAPIDE', 'farine, levure chimique, sel, sucre fin, oeuf, huile, pomme, banane', '10 min', ['Mélangez tous les ingrédients dans l''ordre, ajoutez les 2 pommes râpées ainsi que la banane. ', 'Faite cuire dans un moule à tarte ou manqué de 28 cm de diamètre. Th 7 ou 210°C.'], ['Casserole', 'Spatule'], ['GATEAU POMMES -BANANE RAPIDE', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'sucre fin', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'pomme', 'gâteau à la banane', 'cocktail'], 'Dessert', fac5237f-b49e-4de8-9c84-e76b01382af7, '2025-09-26T16:51:40.937663', [{'ingredient_id': '04358ee8-dcff-4ed5-bc7b-9a2ada47c74a', 'quantite': '180 g'}, {'ingredient_id': 'e5bc173d-87a1-4f71-99f6-02a8917980d8', 'quantite': ''}, {'ingredient_id': 'e93a7069-a1eb-4dd5-ae28-ae9c309c3660', 'quantite': '1'}, {'ingredient_id': 'e1594d39-1b46-4d1a-bd02-88e23868d08b', 'quantite': '180 g'}, {'ingredient_id': 'f11ba4d3-74fb-4ecb-b465-55ba43a9fe62', 'quantite': '4'}, {'ingredient_id': 'a8bb2e85-268a-48af-9e8d-8ae9552ab6cd', 'quantite': '10 cl'}, {'ingredient_id': '4e2522c9-cae5-4f24-bc16-fadd9c24d330', 'quantite': '2'}, {'ingredient_id': '421f4297-9c08-402c-9d81-cd821c34a617', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27770, 'Tatin de frécinettes au miel de citronnier', 'banane, pâte feuilletée, miel, beurre', '10 min', ['Préchauffez le four à 210°C . ', 'Faites fondre le beurre dans une poêle épaisse à manche démontable (pour pouvoir passer au four) ou dans un moule spécial à tarte tatin. Ajoutez le miel, remuez et posez les bananes dans la poêle. ', 'Faites caraméliser les bananes à feu moyen 7 à 8 mn, en les retournant délicatement à mi-cuisson. Dès qu''elles sont légèrement colorées sur leurs deux faces, déroulez la pâte feuilletée, posez-la sur les bananes et rentrez les bords dans le moule. Enfournez pour 20 mn, jusqu''à ce que la pâte soit dorée. ', 'Sortez le moule du four, couvrez-le d''un plat de service, retournez l''ensemble d''un seul coup. Attendez quelques secondes avant de soulever le moule. ', 'Servez chaud, accompagnez éventuellement d''une boule de glace.'], ['Fouet', 'Mixeur', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'bon marché', 'plat', 'moyenne', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'tarte Tatin', 'Tatin de frécinettes au miel de citronnier', 'dessert', 'plat de résistance', 'pâte feuilletée', 'beurre', 'cocktail'], 'Dessert', 43e0e386-a25a-476a-9e6a-fb066f5fddd9, '2025-09-26T16:51:45.949812', [{'ingredient_id': '70fe45f8-08d3-4166-8fc4-91121f57ad6d', 'quantite': '15'}, {'ingredient_id': 'bd9d5d41-a984-4e11-91fc-ef1199407036', 'quantite': '1'}, {'ingredient_id': '629bc856-4dae-4c9e-8d78-d540723c8441', 'quantite': '6 cuillères'}, {'ingredient_id': '45c84e3d-6340-4091-ad85-8a544a7b3974', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (64271, 'Petits crumbles choco-banane', 'banane, galettes (bretonnes), chocolat noir, cassonade', '10 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Dans un bol, écraser les biscuits pour en faire une poudre grossière et y ajouter la cassonade.', 'Couper les bananes en rondelles et les répartir dans 6 petits moules à crème brûlée, parsemer du chocolat râpé, puis du mélange biscuits/cassonade.', 'Passer au four jusqu''à ce que le biscuit brunisse.', 'Servir tiède, avec éventuellement une boule de glace vanille.'], ['Spatule', 'Rouleau à pâtisserie', 'Mixeur', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Petits crumbles choco-banane', 'testées', 'cassonade', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'galettes (bretonnes)', 'dessert', 'plat de résistance', 'chocolat noir', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:51:50.441498', [{'ingredient_id': '9832ed14-73b3-46a5-977c-8040e4e6e862', 'quantite': '3'}, {'ingredient_id': 'd722df58-501b-4641-b9f8-f5a200452901', 'quantite': '10'}, {'ingredient_id': '6617ffad-fbfc-452e-a32c-07b67de17e0a', 'quantite': '2'}, {'ingredient_id': '57ee4eba-7875-4bbf-af78-e73ef6e0cc33', 'quantite': '6 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22902, 'charlotte banane-fraise', 'biscuits à la cuillère, fraises, banane, citron, crème liquide, sucre vanillé, gélatine, liqueur de framboise, beurre, sucre', '45 min', ['Faire ramollir les feuilles de gélatine dans de l''eau. Mixer 250 g de fraise en purée, éplucher 3 bananes que vous mixerez avec le jus de citron. ', 'Faire bouillir 200 g de sucre avec 5 cl d''eau, puis y incorporer la gélatine. Incorporer la purée de fraise à cette préparation. Mettre au frigo. ', 'Fouetter la crème en chantilly. Préparer un 2ème sirop avec 100 g de sucre + 40 cl d''eau chaude, parfumer d''alcool. ', 'Beurrer 1 moule à charlotte, tapisser de biscuits trempés dans le sirop à l''alcool. Ajouter à la crème chantilly 2 sachets de sucre vanillé. Incorporer 2 tiers à la purée de fraise, 1 tiers à la purée de banane. Mettre au frigo 15 mn. ', 'Remplir le moule avec ces 2 préparations en les alternant puis mettre au freezer durant 5 heures minimum. ', 'Démouler la charlotte et décorer avec les 50 g de fraises restantes et la banane.'], ['Râpe', 'Ouvre-boîte', 'Moule à tarte', 'Verre doseur', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'biscuits à la cuillère', 'bon marché', 'rapide', 'plat', 'moyenne', 'fraises', 'recette', 'cuisine', 'liqueur de framboise', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'sucre vanillé', 'charlotte aux fruits', 'beurre', 'gélatine', 'citron', 'charlotte banane-fraise', 'sucre', 'cocktail'], 'Dessert', 639bdeeb-909e-4fed-8976-e537c6664512, '2025-09-26T16:51:54.151653', [{'ingredient_id': 'a9e89eab-9767-4f17-ba4d-aaa1b95bdc77', 'quantite': '2'}, {'ingredient_id': '6eb964ca-3e61-41ca-8894-1496f9f4c79d', 'quantite': '300 g'}, {'ingredient_id': '6b7aeabf-539e-4896-b81d-c25437b507e6', 'quantite': '4'}, {'ingredient_id': '777f3885-f9de-4ffa-9332-7357acf9290a', 'quantite': '1'}, {'ingredient_id': 'ad91c7a3-69d5-4364-a764-4f6025b7cacb', 'quantite': '30 cl'}, {'ingredient_id': '6ea2b7cb-425a-4204-889e-4d857f4eb38a', 'quantite': '2'}, {'ingredient_id': '11c4683e-a785-4ba5-b5b5-24b36757c486', 'quantite': '3'}, {'ingredient_id': '4bc957a4-840a-4457-a3e7-b38547513c95', 'quantite': '2 cuillères'}, {'ingredient_id': '6e2bb740-c914-4803-8df0-3193ac260f54', 'quantite': '20 g'}, {'ingredient_id': '3205fd29-1cff-4bab-b192-5cacf719f822', 'quantite': '300 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530685, 'Glace vanille, banane et coulis de fraises maison', 'fraises, glace vanille, banane, crème', '15 min', ['Je lave les fraises et je retire les queues.', 'Je mixe les fraises dans le blender.', 'Je mets une cuillère à café de ce coulis dans chaque verrine.', 'Je coupe 2 rondelles de banane et j''essaye de les cacher dans le coulis', 'Je rajoute la glace à la vanille puis de la crème fraiche par-dessus pour ceux qui aiment.'], ['Balance de cuisine', 'Fouet', 'Planche à découper', 'Pince de cuisine', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'glace à la vanille', 'Glace vanille', 'banane et coulis de fraises maison', 'cocktail'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T16:51:57.979357', [{'ingredient_id': 'e9dd2711-2367-412d-8cb8-f5794496bad4', 'quantite': '500 g'}, {'ingredient_id': 'b587f064-19ee-405f-9bf0-8082a04d54e4', 'quantite': ''}, {'ingredient_id': '6489c377-dec8-4c77-8854-70f4a133ea34', 'quantite': '1'}, {'ingredient_id': '79747407-baf2-407b-a949-ed2036216f76', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335306, 'Roulade de banane au jambon', 'banane, jambon, gruyère râpé, sauce tomate', '10 min', ['Mettre le four à préchauffer à 180°C (thermostat 6).', 'Éplucher les bananes. ', 'Sur le jambon faire un lit de gruyère. Mettre la banane sur ce lit. Avec une seconde tranche de jambon, bien finir d''envelopper la banane.', 'Renouveler sur les 3 autres.', 'Les disposer dans un plat. Mettre la sauce tomate dessus. Mettre une bonne épaisseur de gruyère afin que ce dernier soit gratiner.', 'Mettre au four pendant 20 min.', 'A accompagner avec un peu de riz.'], ['Couteau de chef', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'jambon', 'confiserie', 'testées', 'Roulade de banane au jambon', 'sauce tomate', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'gruyère râpé', 'dessert', 'plat de résistance', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:52:02.558276', [{'ingredient_id': '7641b3e2-5959-4cc6-98e8-65d9f602fce8', 'quantite': '4'}, {'ingredient_id': '05950dd2-61a8-4a93-ad34-679a11758bed', 'quantite': '8'}, {'ingredient_id': '74909f90-b96c-42dc-be37-ff5454e3c18f', 'quantite': '1'}, {'ingredient_id': '79b5df2d-d541-4b8a-889c-de0f44ebe914', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22729, 'Fondue au chocolat et aux fruits frais pour 6 personnes', 'chocolat noir, beurre, banane, pomme, nectarine, poire, mandarine, pêche, crème chantilly', '20 min', ['Laver les fruits. ', 'Les éplucher. ', 'Les couper en morceaux (ni trop gros ni trop petits). ', 'Les mettre dans un saladier. ', 'Dans une casserole faire fondre le beurre et le chocolat à feu doux. ', 'Préparer des petits et moyens ramequins. ', 'Une fois le chocolat fondu, servir les fruits frais accompagnés du chocolat chaud avec une noix (ou plus pour les gourmands) de chantilly.'], ['Louche', 'Fouet', 'Mixeur', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'nectarine', 'mandarine', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'dessert', 'plat de résistance', 'chocolat noir', 'pomme', 'beurre', 'pêche', 'cocktail', 'Fondue au chocolat et aux fruits frais pour 6 personnes'], 'Dessert', d0acac02-035b-4de4-a233-c8a0ad28c289, '2025-09-26T16:52:06.235031', [{'ingredient_id': 'c32d4d43-0e31-4085-8ba7-c3c375a4f776', 'quantite': '300 g'}, {'ingredient_id': '48880e4e-cbfa-49f8-a383-3d1b968b433c', 'quantite': '1'}, {'ingredient_id': '087af0d2-2fe0-4932-9193-9de9ad0862a6', 'quantite': '2'}, {'ingredient_id': '2f348de1-7ba1-4365-9fcc-803849e7a74d', 'quantite': '2'}, {'ingredient_id': 'c02f628f-321e-4314-a9de-b05b25218d01', 'quantite': '2'}, {'ingredient_id': 'bf541d4d-6476-4e7f-b615-7e0fb5f6c3cf', 'quantite': '2'}, {'ingredient_id': '445d08fa-8701-4652-aa46-b5cbb76a9d7f', 'quantite': '2'}, {'ingredient_id': '19d01db9-af1b-4535-a81d-97830a6577c7', 'quantite': '2'}, {'ingredient_id': '04514a78-ae99-440d-a2e4-f86a461f84f4', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345181, 'Gâteau aux pommes sans sucre sans édulcorant', 'farine, levure, banane, pomme, compote, oeuf, yaourt nature, beurre', '15 min', ['Écraser la banane dans un plat.', 'Ajouter la compote puis le yaourt puis l''oeuf et bien mélanger.', 'Dans un grand bol mettre la farine avec la levure et mélanger.', 'Ajouter sur le mélange farine + levure le mélange yaourt, compote, banane, oeuf et mélanger jusqu''à obtention d''un mélange homogène.', 'Préchauffer le four à 180°C (thermostat 6).', 'Beurrer un plat de 20 cm de diamètre et verser la pâte.', 'Éplucher les pomme et découper les en fines tranches.', 'Déposer les tranches sur la pâte.', 'Éparpiller des petits morceaux de beurre sur le gâteau et enfourner 30 minutes.'], ['Mixeur', 'Économe', 'Tire-bouchon', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'compote', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'gâteau aux pommes', 'pomme', 'beurre', 'cocktail', 'Gâteau aux pommes sans sucre sans édulcorant'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:52:10.882432', [{'ingredient_id': '9f6fad13-0c0f-41f7-a5d3-856600223c93', 'quantite': '1.5'}, {'ingredient_id': '66747c28-8ee5-4b2c-966d-a07dd052df01', 'quantite': '1 cuillères'}, {'ingredient_id': '849069dd-807a-491b-9762-70a7d2a92f6e', 'quantite': '1'}, {'ingredient_id': '6b401f5f-aece-4c95-8122-ba1be46d8c54', 'quantite': '3'}, {'ingredient_id': 'da8b6889-7630-43f4-af49-0741703f179c', 'quantite': '100 g'}, {'ingredient_id': '80594a30-10a5-470d-afe5-d093d1b029e0', 'quantite': '1'}, {'ingredient_id': '52f171f4-c6ad-4e1e-8637-558637b1e4f9', 'quantite': '1'}, {'ingredient_id': '9884204e-ce12-4e26-a3d6-2e4e46126c50', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61299, 'Gâteau banane pamplemousse', 'pamplemousse, banane, farine, sucre vanillé, sucre, oeuf, levure', '10 min', ['Avant de commencer, préchauffez le four à 180°C (thermostat 6).', 'Epluchez le pamplemousse, puis coupez-le grossièrement dans un saladier, mixez-le.', 'Ajoutez-y le sucre, la farine, les oeufs, la levure et le sucre vanillé.', 'Beurrez le moule à gâteau, versez-y la préparation puis rajoutez les bananes coupées en rondelles.', 'Enfournez pour 40 minutes de cuisson en baissant le four à 160°C (thermostat 5-6) avant de mettre le gâteau au four.'], ['Râpe', 'Louche', 'Rouleau à pâtisserie', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'Gâteau banane pamplemousse', 'dessert', 'plat de résistance', 'pamplemousse', 'sucre vanillé', 'gâteau à la banane', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:52:14.651602', [{'ingredient_id': 'a83406ae-ab80-4eea-8faf-c32c7fd33b8b', 'quantite': '1'}, {'ingredient_id': '10b1894b-18c6-432c-ad33-0936186116f1', 'quantite': '2'}, {'ingredient_id': '440a3a0d-d828-4115-bb4f-b30aabf90693', 'quantite': '60 g'}, {'ingredient_id': '8df82aab-c490-4462-89a0-4d45cc6c2265', 'quantite': '2'}, {'ingredient_id': 'b989791a-8864-49d7-8593-46a76dbc738a', 'quantite': '120 g'}, {'ingredient_id': 'eee56553-fc12-4ca6-84d7-9c2666fce56b', 'quantite': '3'}, {'ingredient_id': '1e0f3a3e-e86d-487a-9f5e-9224d65ad526', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72590, 'Tarte à la crème fraîche façon Tiramisu', 'langue de chat, crème fraîche, crème fouettée, sucre glace, café, chocolat en poudre, banane', '15 min', ['Disposer les biscuits langues de chat au fond du plat à tarte. ', 'Préparer une tasse de café bien fort et mouiller les biscuits avec le café à l''aide d''une cuillère. Attention! Les biscuits ne doivent être ni trop secs ni trop mouillés.', 'Fouetter la crème liquide et quand elle commence à épaissir, ajouter le sucre glace. Ensuite, mélanger avec la crème fraîche.', 'Disposer la moitié de la crème obtenue sur les biscuits ramollis en l''étalant.', 'Découper les bananes en fines rondelles et les disposer sur la crème blanche.', 'Ajouter le chocolat en poudre amer à la crème restante et bien mélanger.', 'Etaler la crème au chocolat en dernière couche sur la tarte.', 'Mettre la tarte au frais pour quelques heures. Elle sera encore meilleure le lendemain.'], ['Poêle', 'Tire-bouchon', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'crème fouettée', 'recette', 'café', 'cuisine', 'recettes', 'Tarte à la crème fraîche façon Tiramisu', 'boisson', 'dessert', 'plat de résistance', 'tiramisu', 'sucre glace', 'langue de chat', 'chocolat en poudre', 'cocktail'], 'Dessert', a253346d-fb31-4259-8fa5-f47b9b8ea7e7, '2025-09-26T16:52:19.083670', [{'ingredient_id': '142291d5-f557-46c5-8408-6c79f87b2445', 'quantite': '1'}, {'ingredient_id': '5a03c980-5306-40da-8ba4-52b836ac47a8', 'quantite': '20 cl'}, {'ingredient_id': '61c32382-2bac-4d6b-9c05-1f4888974598', 'quantite': '30 cl'}, {'ingredient_id': '1e988a9b-4380-4184-aba9-4bc2fcfdee9f', 'quantite': ''}, {'ingredient_id': 'b762ac47-45e9-418a-9534-e299c27be43e', 'quantite': ''}, {'ingredient_id': '2f637375-96a3-4bb9-b8aa-88f1dc5f41bc', 'quantite': ''}, {'ingredient_id': '0821a5e2-b72d-42eb-830a-01bbf3d9c4a6', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (44808, 'Tarte tatin à la banane flambée', 'banane, sucre, pâte feuilletée, beurre, jus de citron, rhum', '30 min', ['Préchauffez le four à 200°C (th 6-7).', 'Dans un moule à tarte manqué, mettez le beurre, le jus de citron et le sucre sur le feu, et faites un caramel.', 'Epluchez les bananes, coupez-les en 2, dans le sens de la longueur; et', 'disposez-les dans le caramel, côté bombé vers le fond. ', 'Couvrez avec la pâte.', 'Enfournez à 200°C (th 6-7).', 'Démoulez, en retournant la tarte sur le plat. Et servez tiède.', 'Au moment de servir, faites chauffer le rhum, arrosez la tarte, et flambez.'], ['Tire-bouchon', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'assez cher', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'tarte Tatin', 'dessert', 'plat de résistance', 'pâte feuilletée', 'jus de citron', 'Tarte tatin à la banane flambée', 'beurre', 'sucre', 'cocktail'], 'Dessert', 78d80405-7cd2-4018-be0d-b1ab82b308a6, '2025-09-26T16:52:23.866457', [{'ingredient_id': 'f7281728-b165-482f-92e5-45131b9d31bb', 'quantite': '4'}, {'ingredient_id': 'c9de5af0-8203-4129-b245-7f6f1709998e', 'quantite': '200 g'}, {'ingredient_id': '50332ca4-3ffd-4270-950e-c5b2a8476d89', 'quantite': '1'}, {'ingredient_id': '737591fc-be8b-44eb-aaaa-5bdd05ac232c', 'quantite': '100 g'}, {'ingredient_id': '52edd306-0be0-4c59-ba3d-1600cc40f090', 'quantite': ''}, {'ingredient_id': 'd8678b1e-7dc8-4ee7-bbc0-ea5e081511f6', 'quantite': '5 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (224760, 'Smoothie fraîcheur pomme banane framboise', 'pomme, framboises, banane, yaourt nature, sucre, eau', '5 min', ['Épluchez la pomme et coupez-la grossièrement en morceaux.', 'Mettez-la dans un blender (mixeur) avec les framboises, la banane, le yaourt, le sucre et l''eau.', 'Mixez le tout... c''est prêt !'], ['Verre doseur', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'yaourt nature', 'facile', 'framboises', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'Smoothie fraîcheur pomme banane framboise', 'sucre', 'smoothies', 'cocktail'], 'Boisson', 65949031-e56f-4009-81ed-8e480fadc50d, '2025-09-26T16:52:27.554023', [{'ingredient_id': '80341510-813a-45ac-92a0-1dd7b008659f', 'quantite': '1'}, {'ingredient_id': '7d2b4980-5a39-4f9f-82e7-11525a0b790f', 'quantite': '5'}, {'ingredient_id': '3b3abd71-c698-4d9d-b723-4065efe69d42', 'quantite': '1'}, {'ingredient_id': 'bc101d27-8665-4757-8b4a-7490550aa7d1', 'quantite': '1'}, {'ingredient_id': '4d15606e-54d0-4d80-92bb-7b265d488a88', 'quantite': '1 cuillères'}, {'ingredient_id': '57c74c6c-a86e-4115-9d08-94d9c20c7abe', 'quantite': '5 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (49590, 'Gâteau pomme/banane au pastis', 'farine, sucre, oeuf, banane, pomme, sucre vanillé, pastis', '20 min', ['Préchauffer votre four à 210°C (thermostat 7).', 'Mélanger le sucre et l''œuf au batteur électrique jusqu''a obtention d''une pâte lisse, puis ajouter délicatement la farine tamisée et le pastis.', 'Dans un moule à cake, beurré et fariné, verser le ¼ de la pâte, puis ajouter les bananes rondelles de banane et les pommes découpées en gros morceaux par-dessus.', 'Saupoudrer de sucre vanillé et recouvrir du reste de pâte qui devrait à peine couvrir les fruits.', 'Faire basculer le moule de gauche à droite afin que la préparation descende jusqu''au fond du moule et enfourner à four chaud pendant 25 min.'], ['Casserole', 'Fouet', 'Moule à tarte', 'Économe', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'pastis', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'Gâteau pomme/banane au pastis', 'plat de résistance', 'sucre vanillé', 'pomme', 'gâteau à la banane', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:52:31.149972', [{'ingredient_id': 'aa993fa7-525b-4dcc-918c-eb9d7f384473', 'quantite': '125 g'}, {'ingredient_id': '1d792676-4910-4925-a131-03724e8eb4c1', 'quantite': '80 g'}, {'ingredient_id': '05a7834a-63e9-42bd-924b-8042e6075679', 'quantite': '1'}, {'ingredient_id': 'ffe20a39-a992-414c-b20a-5d8de3f1a84d', 'quantite': '4'}, {'ingredient_id': '21709acb-5e20-4170-b02d-bea963cf1795', 'quantite': '5'}, {'ingredient_id': '256ba212-7361-4031-90b7-fe1c6441c140', 'quantite': '1'}, {'ingredient_id': '45070667-f91f-4679-a4e0-092a35fd871b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315376, 'Smoothie végétalien', 'épinards frais, brocoli, banane, flocons d''avoine, beurre de cacahuètes, baies de goji, eau, fruits rouges', '10 min', ['Mixer dans un blender les épinards et les brocoli avec un peu d''eau, puis ajouter les flocons d''avoine, le beurre de cacahuètes, les baie de goji, la banane.', 'Ajouter quelques fruits rouges surgelés et plus ou moins d''eau en fonctions de vos envies.'], ['Mixeur', 'Tire-bouchon', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'brocoli', 'facile', 'bon marché', 'beurre de cacahuètes', 'rapide', 'plat', 'fruits rouges', 'baies de goji', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Smoothie végétalien', 'épinards frais', 'flocons d''avoine', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:52:34.788940', [{'ingredient_id': '1ef47c42-83e2-46a7-b290-72c3c6ffe2c2', 'quantite': '2'}, {'ingredient_id': '4b780701-d3ae-43d7-a2b8-b11740a96c1c', 'quantite': '4'}, {'ingredient_id': '8b97ea5e-65f3-466a-aa79-e56294a81f3e', 'quantite': '1'}, {'ingredient_id': '2065f12d-b82d-4dc2-b1d1-6fbca52b5a05', 'quantite': '1 cuillères'}, {'ingredient_id': 'e966aa2b-6665-4cea-be59-53ca9b041467', 'quantite': '1 cuillères'}, {'ingredient_id': '0c6232b9-d0e0-4602-b1c0-c746ddf3928d', 'quantite': '10'}, {'ingredient_id': 'a6e7f9a7-97ad-4684-9743-c0cd98296bf1', 'quantite': ''}, {'ingredient_id': '5b678ec6-30bb-4d0d-ae94-633fa259ec75', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36892, 'Croustillant aux pommes façon créole', 'brick, banane, pomme, chocolat, beurre tendre, rhum, sucre en poudre', '10 min', ['Dans un saladier, mettez les bananes coupées en rondelles, et les pommes en fines lamelles. Ajouter le rhum, et le sucre en poudre. Laisser mariner 1h au frigo. ', 'Coupez les feuilles de brick rondes en 2, beurrez-les sur la totalité.', 'Cassez les carrés de chocolat en tous petits morceaux et ajoutez les au mélange.', 'Déposez la farce sur la demi brick, et replier la feuille de brick en triangle. ', 'Dans une poêle bien beurrée (pour ne pas que les bricks collent), saisissez à feu vif les triangles rapidemment en les retournant recto verso jusqu''elles soient dorées et le chocolat fondu.', 'Ajouter une boule de glace vanille, ou de la poudre de coco sur les bricks pour satisfaire définitivement les gourmants.'], ['Mixeur', 'Spatule', 'Verre doseur', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'beurre tendre', 'chocolat', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'Croustillant aux pommes façon créole', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:52:38.459218', [{'ingredient_id': '2dbe293e-af3f-42d7-8cde-8296976dfe65', 'quantite': '6'}, {'ingredient_id': '0e336ab8-9669-4e30-8dd8-0ccffdb92c8c', 'quantite': '2'}, {'ingredient_id': 'f5e4f1ba-fa67-4e68-b2f9-9ed6a80a96b1', 'quantite': '2'}, {'ingredient_id': '81032bf4-2e29-4fd0-a4fa-05dc9157e533', 'quantite': '8'}, {'ingredient_id': 'ab9ffe8b-247e-47ef-a7ef-cb4289d3730c', 'quantite': ''}, {'ingredient_id': '9a0146b6-62cf-4b0f-9a92-3c5bbb36e990', 'quantite': '3 cuillères'}, {'ingredient_id': '85938f73-93f2-4a99-a001-6760b1765205', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (538433, 'Banana bread moelleux de Cyril Lignac', 'banane, sucre en poudre, beurre doux, crème liquide, fleur de sel, banane, banane, beurre doux, cassonade, oeuf, farine, levure chimique, noisettes', '15 min', ['Chemisez un moule à manquer avec du papier sulfurisé. Pelez les bananes entières et taillez-les en tranches fines dans la longueur. Disposez-les au fond du moule pour le recouvrir en remontant légèrement sur les côtés également.', 'Versez le sucre en poudre dans une casserole et faites le caraméliser à sec. Sortez du feu et ajoutez-y le beurre en mélangeant. Versez ensuite la crème et mélangez bien. Salez avec la fleur de sel. Mélangez puis versez dans le moule pour recouvrir toutes les bananes.', 'Déposez les 200 g de bananes très mûres dans un saladier. Écrasez à l’aide d’une fourchette. Ajoutez la farine tamisée préalablement mélangée à la levure chimique ainsi que le sucre. Mélangez bien. Faites fondre le beurre doux.', 'Cassez les œufs dans l’appareil à gâteau, commencez à mélanger et versez le beurre fondu. Intégrez les noisettes et travaillez l’appareil afin d’obtenir une préparation homogène. Versez cet appareil dans le moule et tapotez celui-ci pour bien répartir la pâte.', 'Mettez à cuire durant 45 minutes dans un four préchauffé à 155 °C.  Laissez reposer hors du four environ 30 minutes avant de démouler. Retirez le papier sulfurisé si nécessaire. Régalez-vous !'], ['Ouvre-boîte', 'Batteur électrique', 'Rouleau à pâtisserie', 'Tire-bouchon'], ['', 'bon marché', 'boisson', 'entrée', 'banane', 'Banana bread moelleux de Cyril Lignac', 'recettes de cuisine', 'plat', 'dessert', 'confiserie', 'recette', 'testées', 'plat de résistance', 'cocktail', 'cuisine', 'recettes', 'facile'], 'Dessert', dd203e43-1007-44d2-9a85-09c8363d1742, '2025-09-26T16:52:44.095028', [{'ingredient_id': '78fe15d9-f9d1-408b-971f-9e71ca2d614b', 'quantite': '3'}, {'ingredient_id': 'e0470dcc-d374-44e4-85ce-1772f6559d08', 'quantite': '100 g'}, {'ingredient_id': '882bd5bd-481d-421f-b48a-d74a7a6ebd7a', 'quantite': '13 g'}, {'ingredient_id': '7d236d3b-b1e2-43ea-963d-bb32c31492ab', 'quantite': '50 g'}, {'ingredient_id': 'cf3639d1-ae04-4421-8c8f-13196b5f9a5b', 'quantite': '2 g'}, {'ingredient_id': 'ea42f297-542a-4620-9524-9c3fafb76ff1', 'quantite': '200 g'}, {'ingredient_id': '542b3bba-6f4e-4dcc-8509-8afb2b5758c2', 'quantite': '200 g'}, {'ingredient_id': '4f05be1a-719e-4556-aa46-f6e962d3d37f', 'quantite': '100 g'}, {'ingredient_id': '7e0f5387-3fc0-48d3-86cd-17fcea3681d3', 'quantite': '150 g'}, {'ingredient_id': 'f3ca17f4-142b-4e17-97ec-c92a40c971a7', 'quantite': '2'}, {'ingredient_id': '138152a2-406f-4d2c-aa86-26b18571b151', 'quantite': '160 g'}, {'ingredient_id': 'f215e9dd-d02d-4527-8f1e-63d0aaae7f0d', 'quantite': '8 g'}, {'ingredient_id': '5e9e8099-0a59-4aa7-98a0-7012464e0c15', 'quantite': '70 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23608, 'Alcool de bananes', 'banane, alcool pour fruits, sucre', '40 min', ['Remplir le bocal avec les bananes coupées en rondelles. Mettre les morceaux de sucre et verser l''alcool.', 'Bien fermer et laisser macérer pendant 40 jours en retournant tous les jours le bocal.', 'Au bout de ce temps, passer la préparation au chinois ou au mixer pour un effet plus velouté!'], ['Économe', 'Passoire', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'alcool pour fruits', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Alcool de bananes', 'sucre', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:52:47.736974', [{'ingredient_id': '5df9e709-b8ab-4ce6-a6bb-450f6243d126', 'quantite': ''}, {'ingredient_id': '4c49c5f2-6f2e-4f6b-96e8-feefa0081e92', 'quantite': '1 l'}, {'ingredient_id': 'ffd6f401-1a5b-44f0-b07a-5979b66f1e83', 'quantite': '20'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (309780, 'Smoothie à la fraise', 'fraises, yaourt nature, banane, jus d''orange, glaçons', '5 min', ['Couper les fraises en deux après les avoir équeutées.', 'Ajouter la banane coupée en rondelles puis les yaourts.', 'Verser les glaçons et le jus d''orange (plus ou moins selon l’onctuosité que l''on veut obtenir). ', 'Pour ma part j''en mets un grand verre dans un premier temps puis j''en ajoute pour obtenir un smoothie crémeux que l''on peut boire à la paille gros diamètre).'], ['Fouet', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'Smoothie à la fraise', 'dessert', 'plat de résistance', 'glaçons', 'jus d''orange', 'smoothies', 'cocktail'], 'Boisson', c793f55f-04fd-4969-b96a-49bd7ce4aad3, '2025-09-26T16:52:51.316289', [{'ingredient_id': 'ac6126dc-26b6-4b3b-aea7-d047069867d8', 'quantite': '250 g'}, {'ingredient_id': 'bba13aa1-c815-4378-8751-70fe3d735c61', 'quantite': '2'}, {'ingredient_id': 'db56a61c-5ac9-4713-a4d8-14c224aba2cc', 'quantite': '1'}, {'ingredient_id': 'e0053d5b-6859-468f-8e8b-f818f8a1bb9a', 'quantite': '1'}, {'ingredient_id': 'eaffd19b-7d76-4630-9ba9-7268fbd327fe', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392519, 'Banana bread ultra-moelleux aux pépites de chocolat', 'farine, levure, bicarbonate, amandes en poudre, pépites de chocolat, noix, extrait de vanille, beurre, sucre, banane, oeuf, lait demi-écrémé, jus de citron', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Beurrer un moule à cake.', 'Mélanger le jus de citron et le lait, puis laissez reposer.', 'Dans un saladier, mélanger la farine, la levure, le bicarbonate,  et la poudre d''amandes.', 'Dans un autre saladier, battre le beurre ramolli avec le sucre au batteur électrique. Ajouter ensuite l''oeuf, et l''extrait de vanille et battez.', 'Réduisez en purée à l''aide d''une fourchette les bananes et incorporer-les au mélange beurre / sucre / oeuf.', 'Ajouter-y le mélange lait et citron et battez.', 'Ajouter progressivement votre préparation aux ingrédients secs, tout en mélangeant, ajouter les pépites de chocolat ou les noix à votre pâte.', 'Verser votre préparation dans le moule à cake beurré.', 'Enfournez 45 minutes à 180°C puis 10 minutes à 165°C', 'Sortez votre banana bread du four, laissez refroidir, démoulez, et dégustez !'], ['Presse-agrumes', 'Mixeur', 'Passoire', 'Louche', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Banana bread ultra-moelleux aux pépites de chocolat', 'testées', 'extrait de vanille', 'facile', 'bon marché', 'amandes en poudre', 'oeuf', 'plat', 'pépites de chocolat', 'recette', 'cuisine', 'noix', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'jus de citron', 'gâteau à la banane', 'beurre', 'sucre', 'lait demi-écrémé', 'cocktail', 'bicarbonate'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:52:54.965332', [{'ingredient_id': 'fda5cdfd-4fa3-44de-b141-1a9634d0b70d', 'quantite': '180 g'}, {'ingredient_id': '764ac1be-753c-4e83-b22f-36e29b34655c', 'quantite': '1 cuillères'}, {'ingredient_id': 'ec3dc1de-c072-4631-a3cb-61658ff34bec', 'quantite': '1 cuillères'}, {'ingredient_id': '76954fd0-9989-4894-9ccb-11735578055f', 'quantite': '2 cuillères'}, {'ingredient_id': '359e7fd7-af70-4a54-83bd-230609e8f67d', 'quantite': '80 g'}, {'ingredient_id': '8dfb9523-6a4f-4990-8029-f7e825c3f62e', 'quantite': '60 g'}, {'ingredient_id': '2e4359e5-2622-471c-8334-cb1b74e3d581', 'quantite': '3'}, {'ingredient_id': 'a079bbb7-c819-4144-ad7d-798e1c53ef65', 'quantite': '60 g'}, {'ingredient_id': 'f5e8aa13-6440-4f9c-ad28-b29211d0ab0f', 'quantite': '130 g'}, {'ingredient_id': 'be392f20-03bf-4dcb-b5ff-12d9a4e38542', 'quantite': '3'}, {'ingredient_id': '4dfb93d1-0b8a-401d-9670-cf6a6139724d', 'quantite': '1'}, {'ingredient_id': '71830465-04d5-4b0b-9234-bd153efd160f', 'quantite': '120 ml'}, {'ingredient_id': '59b8b000-0371-4c22-b30b-0605eb009a6b', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528319, 'Milkshake banana split', 'glace vanille, banane, lait, chocolat', '5 min', ['Coupez la banane en rondelles, placez celles-ci dans un verre mesureur (ou autre récipient) haut et fin.', 'Versez du lait dans le verre mesureur jusqu''à ce que les rondelles de banane soient recouvertes ( plus ou moins 20 cl).', 'Ajoutez la glace, mixez une première fois.', 'Ajoutez le chocolat fondu et mixez à nouveau.'], ['Couteau de chef', 'Rouleau à pâtisserie', 'Verre doseur'], ['entrée', 'banane', 'Milk-shake', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'Milkshake banana split', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:52:58.593622', [{'ingredient_id': 'a51e5136-d4de-4f34-a809-ee667b003685', 'quantite': '3'}, {'ingredient_id': 'e4af9507-0d42-475c-b589-97bbb6d591e3', 'quantite': '1'}, {'ingredient_id': 'ebe86e5c-c6c9-4355-abe1-b4b39a4b277a', 'quantite': '20 cl'}, {'ingredient_id': 'cf135897-9429-4ad6-924e-fd5f56809309', 'quantite': '15 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23925, 'Salade de thon à la banane (Tahiti)', 'thon, thon, banane, riz, poivron rouge, crème fraîche, curry, poivre, sel, huile', '15 min', ['Cuire le riz (mais attention, il doit rester ferme). Le laisser refroidir.', 'Émietter le thon. Découper les poivrons en petits dés et les bananes en rondelles.', 'Mélanger le tout et verser la sauce composée d''une grosse cuillerée de crème, d’une pincée de sel et de poivre, de 5 cuillères à soupe d''huile et de 2 de vinaigre.', 'Saupoudrer de curry.', 'Servir très frais.'], ['Poêle', 'Couteau de chef', 'Râpe', 'Mixeur', 'Louche'], ['salade de riz', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'Salade de thon à la banane (Tahiti)', 'cuisine', 'poivron rouge', 'recettes', 'boisson', 'huile', 'dessert', 'plat de résistance', 'riz', 'poivre', 'thon', 'curry', 'cocktail'], 'Entrée', 3d03bff1-62f4-47c5-8167-e23387299d7e, '2025-09-26T16:53:02.477459', [{'ingredient_id': '7d291233-7e1e-417d-9450-ff1ef6fe1802', 'quantite': '1'}, {'ingredient_id': 'c8748ca9-c52d-4d7e-8d45-833cf86f5473', 'quantite': '300 g'}, {'ingredient_id': '42f2b06a-ec01-4c09-8e49-261ee4aa31be', 'quantite': '3'}, {'ingredient_id': 'd63e7a3b-93f5-4f72-9215-0277e3d3325a', 'quantite': '100 g'}, {'ingredient_id': 'c7cff5f1-2cfc-4be6-99b1-7d879d601eb2', 'quantite': '2'}, {'ingredient_id': '57f8648e-cc69-4d23-ab2d-5196a8426b53', 'quantite': ''}, {'ingredient_id': '2d80d036-c687-40dd-954c-ffc5a580266a', 'quantite': ''}, {'ingredient_id': '245edbb9-24b6-430f-ae0f-cfdca85c766a', 'quantite': ''}, {'ingredient_id': '7ae19e88-6a00-4105-b450-4b0394b82ac2', 'quantite': ''}, {'ingredient_id': '4bfb6f44-9c19-4483-b8d5-4eb86ee09b67', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43079, 'Confiture bananes - fruits rouges', 'fruits rouges, banane, sucre', '30 min', ['Couper les bananes en morceaux.', 'Mettre les tous les fruits dans une bassine à confiture, et ajouter le sucre.', 'Faire chauffer le tout, à feu moyen, jusqu''à ébullition.', 'Lorsque la confiture épaissit, verser dans les pots, et les retourner jusqu''à total refroidissement.'], ['Râpe', 'Poêle', 'Ouvre-boîte', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'fruits rouges', 'recette', 'cuisine', 'recettes', 'boisson', 'Confiture bananes - fruits rouges', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:53:05.973372', [{'ingredient_id': '51f46384-52f0-4cd9-be1c-5cae04a2ab3d', 'quantite': '250 g'}, {'ingredient_id': '5542d12b-473a-43f2-bce1-4a00977f8ed3', 'quantite': '250 g'}, {'ingredient_id': '97d6f649-63bd-4cfe-bb8f-36980dbdbc6b', 'quantite': '300 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (314988, 'Tarte banane pâte à tartiner et éclat de chocolat blanc', 'banane, chocolat blanc, pâte à tartiner, oeuf, lait, extrait de vanille, pâte brisée', '10 min', ['Battre les œufs dans un saladier, ajouter le lait et l''extrait de vanille.', 'Sur le fond de tarte, disposer les bananes et quelques copeaux de chocolat blanc (que vous pouvez faire à l''aide d''un économe).', 'Napper de pâte à tartiner (la mettre près d''un endroit chaud pour qu''il soit plus facile à étaler)', 'Ajouter la préparation œuf lait vanille sur la tarte. Enfourné 20 min à 180°C (thermostat 6). '], ['Râpe', 'Spatule', 'Économe', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'extrait de vanille', 'facile', 'bon marché', 'oeuf', 'Tarte banane pâte à tartiner et éclat de chocolat blanc', 'plat', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat blanc', 'lait', 'cocktail', 'pâte à tartiner'], 'Dessert', f531f8a4-e67d-46b1-ab8e-2b1f89fe6805, '2025-09-26T16:53:10.905642', [{'ingredient_id': '176f14e1-8cb9-43f5-9442-d2da52aed572', 'quantite': '2'}, {'ingredient_id': '62fb4597-2cea-4aa7-8f3e-05b9211a48a1', 'quantite': '30 g'}, {'ingredient_id': '96f0b458-08e0-43f8-a350-c0ee65e53e4a', 'quantite': '3 cuillères'}, {'ingredient_id': 'b56aff43-f976-4461-84f3-f29d2868baed', 'quantite': '3'}, {'ingredient_id': 'bc4935ae-b0b8-44c0-85cb-5c94dc1aeec4', 'quantite': '60 cl'}, {'ingredient_id': 'f4a93dbd-d4a9-46fe-8612-6725c90ba706', 'quantite': ''}, {'ingredient_id': '9e780231-de93-4760-b726-bc89ac284f6c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38810, 'Poêlée de fruits au Nutella', 'poire, banane, beurre doux, Nutella, cacao, glace vanille', '5 min', ['Couper la poire en fines lamelles et la banane en rondelles.', 'Faire fondre une belle noisette de beurre dans une poêle anti-adhésive.', 'Ajouter les fruits, laisser fondre à feu moyen.', 'Quand les fruits sont tendres et commencent à colorer, ajouter quelques cuillères de Nutella.', 'Disposer dans des ramequins individuels avec une boule de glace à la vanille et saupoudrer le tout de cacao en poudre.'], ['Casserole', 'Fouet', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Poêlée de fruits au Nutella', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'cacao', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'Nutella', 'dessert', 'plat de résistance', 'beurre doux', 'cocktail'], 'Dessert', 7e7fa987-f141-450e-b17a-3b4bd1e421f7, '2025-09-26T16:53:14.612322', [{'ingredient_id': 'c551a908-7207-49ca-af8b-594cba53f457', 'quantite': '1'}, {'ingredient_id': '8ed3788f-efa0-4564-9b07-983995d04b07', 'quantite': '1'}, {'ingredient_id': '42b9d895-7145-44bc-ab63-e0f9399835e6', 'quantite': ''}, {'ingredient_id': '2c3b4b95-0d4b-4cf5-a79c-b96835e77a02', 'quantite': ''}, {'ingredient_id': '34aefce1-dc66-4d92-bf01-aa9b65a73fa3', 'quantite': ''}, {'ingredient_id': '41a1a27d-777e-4002-92f0-fcd917780dc6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (311313, 'Barres glacées chocolat banane speculos', 'chocolat, glace vanille, banane, spéculoos', '30 min', ['Faire fondre le chocolat pendant 1 minute au four à micro-ondes.', 'Dans des moules pour barres, à l''aide d''un pinceau, étaler le chocolat afin de ne plus voir le moule. Mettre ensuite le moule dans le congélateur pendant 5 minutes. ', 'Pendant ce temps, mixer la banane, les spéculoos et la glace.', 'Couler ensuite le mélange dans le moule au dessus du chocolat. Mettre au congélateur, 10 à 15 minutes.', 'Refaire fondre avec un peu d''eau, le chocolat s''il a durcit. Avec le pinceau, remettre un couche de chocolat.', 'Mettre au congélateur jusqu''à dégustation.'], ['Balance de cuisine', 'Fouet', 'Planche à découper', 'Verre doseur', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'speculoos', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'Barres glacées chocolat banane speculos', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:53:18.289792', [{'ingredient_id': '44a58c6d-b491-467a-80ea-3c7527401bb1', 'quantite': '100 g'}, {'ingredient_id': 'd62d68c9-1777-4fca-9e6e-910446a44a43', 'quantite': '1 cuillères'}, {'ingredient_id': '47bba75e-d5dc-4ea9-9eaf-3a7bea4c28f2', 'quantite': '1'}, {'ingredient_id': 'd2bbf8e0-3a42-4f4c-ac3d-91568c484131', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72280, 'Impromptu de bananes (omelette)', 'banane, oeuf, farine, sucre de canne', '10 min', ['Couper les bananes en rondelles et les faire revenir doucement dans une poêle avec du beurre.', 'En attendant, battre les œufs dans un bol, ajouter la farine tamisée et continuer de battre.', 'Verser l''omelette sur les bananes légèrement fondues et laisser prendre.', 'Saupoudrez ensuite de sucre roux.'], ['Mixeur', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'sucre de canne', 'dessert', 'plat de résistance', 'Impromptu de bananes (omelette)', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:53:23.277569', [{'ingredient_id': 'cd192ebe-4ff2-4c92-9b85-d648112a46c4', 'quantite': '5'}, {'ingredient_id': 'b78f78c0-9332-40d5-aaf6-b627f6ad6646', 'quantite': '2'}, {'ingredient_id': '33ad9c84-d139-4365-873c-a4189d598d9a', 'quantite': '1 cuillères'}, {'ingredient_id': '03bcfcc5-5e47-4de1-825b-f454f586db61', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392320, 'Rhum banane vanille', 'rhum blanc, banane, vanille', '0 min', ['Réalisez la recette "Rhum banane vanille" directement en bouteilles.', 'Couper les bananes en morceaux de 1cm d''épaisseur et les plonger dans le rhum. Fendre les gousses de vanille en deux dans le sens de la longueur et placer aussi dans le bocal. Couvrir avec le rhum blanc, fermer et laisser macérer deux mois. 

Ne pas s''inquieter si les morceaux de bananes ne sont pas complètement dissouts. Si le goulot de la bouteille est trop petit, couper les bananes dans le sens de la longueur plutôt qu''en tranches.
.', 'Servir dans un verre de type "".'], ['Poêle', 'Mixeur', 'Balance de cuisine', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Rhum banane vanille', 'très facile', 'rapide', 'plat', 'cocktail rhum', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'moyen', 'rhum blanc', 'cocktail'], 'Boisson', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:53:27.951462', [{'ingredient_id': 'bcddf1ec-d3e8-48ec-81d1-a688319e850e', 'quantite': '75 cl'}, {'ingredient_id': '337e9bc4-ac02-433d-a60f-d34d44ef06d5', 'quantite': '4'}, {'ingredient_id': '843c26d2-f634-4cdd-be84-008b4530bfa6', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (383752, 'Crème de banane au Companion', 'banane, crème fraîche, yaourt à la grecque, cassonade, jus de citron, sucre vanillé', '5 min', ['Épluchez, puis coupez les bananes en petits morceaux. Déposez-les dans la cuve de votre Companion. Arrosez de jus de citron, ajoutez le reste des ingrédients, puis mixez avec le couteau ultrablade / vit. 3 à 8 / 0 °C / 40 sec. ', 'Dégustez immédiatement ou placez au frais pendant 15 minutes maximum.'], ['Ouvre-boîte', 'Pince de cuisine'], ['yaourt à la grecque', 'banane', 'entrée', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'rapide', 'Crème de banane au Companion', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'jus de citron', 'cocktail', 'crème dessert'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:53:32.582963', [{'ingredient_id': '1a58edee-b937-4597-ba71-3317b703b461', 'quantite': '4'}, {'ingredient_id': 'e2d478a6-d14e-4ecb-9156-6caa7636f2ef', 'quantite': '2 cuillères'}, {'ingredient_id': 'a497b4e8-43d8-4687-81b6-8e3e8c803615', 'quantite': '2 cuillères'}, {'ingredient_id': '7457ddfb-489d-4d71-a70f-097c2775c053', 'quantite': '2 cuillères'}, {'ingredient_id': '6aef7018-211f-45ea-8b88-6f36d1a52419', 'quantite': '2 cuillères'}, {'ingredient_id': 'fa464a53-2ae1-43e4-81d5-dcefdd0b443c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55621, 'Plaisir de fruits en broche', 'mandarine, banane, fraises', '25 min', ['Commencez par éplucher tous vos fruits, coupez les en une seule fois.', 'Ensuite prenez de grands bâtons de brochette et enfiler vos morceaux de fruits dessus.', 'Si vous voulez vous pouvez faire tremper vos fruit dans du chocolat et les mettre au réfrigérateur.'], ['Spatule', 'Presse-agrumes', 'Batteur électrique', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'mandarine', 'bon marché', 'rapide', 'Plaisir de fruits en broche', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:53:37.044458', [{'ingredient_id': 'dc311687-241f-4a29-93aa-44b2f130d2b7', 'quantite': ''}, {'ingredient_id': '2dfd4898-0440-4078-8f5b-217f08ddaae2', 'quantite': ''}, {'ingredient_id': '9c31cf6e-ca0e-4d8a-87ac-4b83b31886ae', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336131, 'Délice à la banane', 'banane, farine, sucre en poudre, oeuf, beurre, lait, fromage blanc, rhum, sucre vanillé, levure chimique, cannelle, sel', '10 min', ['Faites fondre 80 g de beurre. Mettez la farine, la levure et 1 pincée de sel dans un saladier et creusez un puit. Cassez-y les œufs et mélangez au fouet en versant peu à peu le beurre fondu. Ajoutez le sucre en poudre, le sucre vanillé, le lait, le rhum et 1 pincée de cannelle.', 'Préchauffez le four à th. 6/7, 200°C. Épluchez et coupez les bananes en rondelles. Incorporez celles-ci à la pâte, ainsi que le fromage blanc.', 'Versez la préparation dans un moule beurré et enfournez pour 35 minutes. ', 'Dégustez tiède ou froid !'], ['Pince de cuisine', 'Balance de cuisine', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'fromage blanc', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'cannelle', 'lait', 'cocktail', 'Délice à la banane'], 'Dessert', 345c18f9-3371-42c0-a1da-09ca1eb38fcf, '2025-09-26T16:53:41.740209', [{'ingredient_id': '3de86894-381c-4827-9b68-a589338eb949', 'quantite': '2'}, {'ingredient_id': 'f3f3d449-e48a-40c9-ba0a-98263abbdf73', 'quantite': '150 g'}, {'ingredient_id': 'bf43a0a0-f8a3-4841-b483-db9eea8f6ac1', 'quantite': '90 g'}, {'ingredient_id': '8fe1e60f-e3b4-44da-9ff3-98609813c333', 'quantite': '2'}, {'ingredient_id': '4c975ce4-be4f-4d1d-b9fb-a4658d0b768c', 'quantite': '90 g'}, {'ingredient_id': '6a1522dc-5add-4461-96ed-9d0d528b3e76', 'quantite': '15 cl'}, {'ingredient_id': 'ffd86dda-f0ae-49bb-9a39-54131796f1bf', 'quantite': '2'}, {'ingredient_id': '6426cb9b-f1cc-4a6a-bdec-9180dab49acf', 'quantite': '1'}, {'ingredient_id': '0af7369f-79ad-4893-aab7-4e8f721f325b', 'quantite': '1'}, {'ingredient_id': 'bf5d128d-7324-420c-806e-0f505a9e2a37', 'quantite': ''}, {'ingredient_id': '10a66e73-5b56-4550-96b3-b0a368bac674', 'quantite': '1'}, {'ingredient_id': 'a139fdab-aa2a-4ef5-b23a-2ad20cd06016', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29968, 'Tarte tatin rhubarbe banane meringuée', 'pâte brisée, rhubarbe, banane, beurre, sucre, jus de citron, blanc d''oeuf', '25 min', ['Faire cuire les tiges de rhubarbe coupées en petits morceaux dans l''eau environ 5 a 10 minutes. Elles doivent être encore fermes quand on les retire. Les égoutter et saupoudrer de sucre en poudre.', 'Pendant ce temps, faire fondre le beurre, 100g de sucre et 1/4 de verre d''eau dans une casserole pour faire le caramel. Quand il roussit, le verser vite dans un plat allant au four (en étalant le plus possible).', 'Disposer la rhubarbe sur le caramel. Couper les bananes en rondelles et les disposer sur la rhubarbe. Arroser de jus de citron et éventuellement de sucre.', 'Mettre la pâte dessus et enfourner (environ 30-40 min à four moyen) jusqu''à ce que la pâte soit dorée.', 'Ensuite, vous pouvez monter une petite meringue sucrée, la disposer sur la tarte que vous repassez au four pour la faire meringuer!'], ['Spatule', 'Planche à découper', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'rhubarbe', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'tarte Tatin', 'dessert', 'plat de résistance', 'jus de citron', 'beurre', 'Tarte tatin rhubarbe banane meringuée', 'sucre', 'blanc d''oeuf', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:53:45.360049', [{'ingredient_id': '08f2f948-1cc3-4cad-84c6-90bcc1cd40f9', 'quantite': '1'}, {'ingredient_id': '7914718d-5169-44a6-8a88-c2c86ccc0262', 'quantite': '10'}, {'ingredient_id': 'a4f55169-bd0e-40b7-9cca-55149c491397', 'quantite': '3'}, {'ingredient_id': '58bd0bdd-e16c-4573-9a9e-1e4fcc2eced7', 'quantite': '50 g'}, {'ingredient_id': 'be981742-5b74-4c26-a7a2-c536da7cbe89', 'quantite': '100 g'}, {'ingredient_id': '30c15af3-41d3-4e78-87a5-048709877bd3', 'quantite': '1'}, {'ingredient_id': 'e44a4df6-cee4-4dad-9990-9ebca3b7d5af', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16722, 'Bananes Frites', 'banane, beurre, sucre semoule', '5 min', ['Peler les bananes, les couper en deux dans le sens de la longeur. Mettre le beurre à la poêle y faire frire les bananes 2 à 3 minutes de chaque côtés. Dresser sur un compotier, saupoudrez de sucre.Servir trés chaud. On peut dresser les bananes sur un lit de riz au lait chaud.'], ['Moule à tarte', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Bananes Frites', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'cocktail'], 'Dessert', 88c80ad6-752c-4c1e-ac16-3489ad6267e6, '2025-09-26T16:53:48.856192', [{'ingredient_id': '062c028e-36c0-4310-815c-3770c847abb0', 'quantite': '6'}, {'ingredient_id': 'b7e5455f-e948-4094-963a-372949306f83', 'quantite': '75 g'}, {'ingredient_id': 'ce2fb434-a465-4dfb-8fe1-202de0f9f261', 'quantite': '30 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22938, 'Irrésistible tarte banane et chocolat', 'pâte sablée, chocolat noir, sucre, oeuf, crème fraîche épaisse, banane', '25 min', ['Etalez la pâte dans le moule à tarte.', 'Faites fondre le chocolat à feu doux avec une cuillerée à soupe d''eau. Etalez le chocolat sur le fond de pâte. ', 'Coupez les bananes en rondelles assez épaisses et disposez les sur le chocolat, les unes contre les autres. ', 'Mélangez le sucre avec les oeufs et la crème. Versez cette préparation sur les bananes. ', 'Faites cuire 30-35 mn à 180°C.', 'A déguster tiède (quand le chocolat est encore fondant) ou froide.'], ['Ouvre-boîte', 'Tire-bouchon'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'crème fraîche épaisse', 'confiserie', 'testées', 'très facile', 'bon marché', 'Irrésistible tarte banane et chocolat', 'pâte sablée', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre', 'cocktail'], 'Dessert', 45e798d4-d4e4-433a-9b13-87a793f474e7, '2025-09-26T16:53:54.624047', [{'ingredient_id': '43d926f2-66ca-41b8-b227-c25a0a7bb7f0', 'quantite': '1'}, {'ingredient_id': '6490baba-837b-4095-a490-f451e0ecbf95', 'quantite': '100 g'}, {'ingredient_id': '829aff76-0c99-430a-89e4-fbbb79428d44', 'quantite': '100 g'}, {'ingredient_id': 'c244cece-1528-4699-962b-9da40a7eb63c', 'quantite': '4'}, {'ingredient_id': 'f839718b-834a-4b48-b50b-675408705313', 'quantite': '4'}, {'ingredient_id': '53dfb9f1-7524-452a-bb7e-e5d220eabfc3', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42319, 'Tarte crumble à la banane sur compote', 'pâte brisée, compote, banane, farine, sucre, poudre de noisette, beurre', '15 min', ['Faites cuire la pâte brisée à blanc à 180°C (thermostat 6) pendant 10 min. ', 'Mettez le beurre à fondre au micro-onde.', 'Pendant ce temps, dans un saladier, mélangez la farine, le sucre, la poudre de noisettes et le beurre.', 'Une fois la pâte cuite, étalez la compote sur le fond et ajoutez les bananes coupées en rondelle.', 'Puis répartissez le crumble obtenu dans le saladier sur les bananes.', 'Mettez au four pendant 15 à 20 min.'], ['Planche à découper', 'Balance de cuisine', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'Tarte crumble à la banane sur compote', 'confiserie', 'testées', 'facile', 'plat', 'poudre de noisette', 'recette', 'compote', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'sucre', 'compote de banane', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:53:58.078683', [{'ingredient_id': 'f02ba8eb-f12b-49d1-a642-10567fe2d0f4', 'quantite': '1'}, {'ingredient_id': '15034009-486a-455b-b0cc-ba5a215c80bd', 'quantite': '200 g'}, {'ingredient_id': '2772ac50-ce72-4503-865e-7bba865ee5d1', 'quantite': '3'}, {'ingredient_id': 'd9901afc-66c2-4679-8d64-c9c07a1f1087', 'quantite': '90 g'}, {'ingredient_id': '802813a3-8eb8-4e06-adc1-fe1da3e705f2', 'quantite': '50 g'}, {'ingredient_id': '53b76cc4-2de2-49dc-9d42-b65085bd5142', 'quantite': '50 g'}, {'ingredient_id': '6f97631f-18fb-46c2-b571-1396e3e7da33', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (49513, 'Salade d''avocat sucrée-salée', 'mûres, avocat, jus de citron, champignons de Paris, beurre, poivre, tomates cerise, pamplemousse, jus de banane, grenadine, kiwi, huile, bouillon de légumes, sel', '20 min', ['Lavez et essuyez les mûres.', 'Coupez les avocats en 2, épluchez-les après les avoir dénoyauté, puis détaillez-les en fins quartiers.', 'Mouillez-les ensuite de jus de citron.', 'Parez, lavez et coupez les champignons en 2.', 'Faites chauffer le beurre dans une poêle et faites-y étuver les champignons. Salez et poivrez.', 'Nettoyez, lavez et coupez les tomates en 2.', 'Ajoutez-les aux champignons et laissez-les macérer 3 minutes.', 'Sortez le tout de la poêle et laissez refroidir.', 'Incorporez les mûres et l''avocat.', 'Mélangez les jus, la purée de kiwis et l''huile ainsi que le bouillon de légumes.', 'Salez et poivrez.', 'Nappez avec la sauce et servez la salade garnie de tranches de kiwis.'], ['Fouet', 'Râpe', 'Planche à découper', 'Mixeur', 'Économe'], ['entrée', 'kiwi', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'avocat', 'cocktail', 'très facile', 'rapide', 'plat', 'jus de banane', 'recette', 'mûres', 'salade avocat', 'cuisine', 'recettes', 'boisson', 'huile', 'dessert', 'plat de résistance', 'pamplemousse', 'jus de citron', 'moyen', 'beurre', 'champignons de Paris', 'grenadine', 'poivre', 'bouillon de légumes', 'Salade d''avocat sucrée-salée', 'tomates cerise'], 'Entrée', 32ee6f56-69d6-426e-af92-5b42aff8b81e, '2025-09-26T16:54:03.068000', [{'ingredient_id': 'f6f1cded-3101-4091-b9b4-3730dd36e646', 'quantite': '200 g'}, {'ingredient_id': 'f33343b6-29cf-46ae-ace0-d917d46e4711', 'quantite': '3'}, {'ingredient_id': '581be088-0eb2-4e48-b949-b0086cab801e', 'quantite': '2 cuillères'}, {'ingredient_id': '0240fdd3-4349-46a3-848b-dd7421a450fe', 'quantite': '200 g'}, {'ingredient_id': '39582361-3898-4dda-8f7e-d4ddb23d9632', 'quantite': '2 cuillères'}, {'ingredient_id': '604fc1cd-f039-4207-a167-69187e2b1a6d', 'quantite': '2 cuillères'}, {'ingredient_id': 'd60a0f13-a70a-4821-9fc6-6f45859d82d6', 'quantite': '150 g'}, {'ingredient_id': '79593566-b2d6-4ca5-99cf-70ba595cde84', 'quantite': '4 cuillères'}, {'ingredient_id': '271d56a2-1965-43b6-b6ab-7de08a1a6858', 'quantite': '3 cuillères'}, {'ingredient_id': 'd56147d0-23f6-4052-a22f-00fcc2d2da73', 'quantite': '3 cuillères'}, {'ingredient_id': 'f289e433-f880-419d-952c-ed689efb9bb6', 'quantite': '3'}, {'ingredient_id': '073521c6-b8bc-49a2-94c6-8ee657e31114', 'quantite': '6 cuillères'}, {'ingredient_id': '2de1ba99-14e0-4373-b529-ac2b7ab0a6bc', 'quantite': '12.5 cl'}, {'ingredient_id': '8407c7fd-09c5-4558-8fca-5ff8c9f2aef1', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345844, 'Pudding chocolat banane vanille et graines de chia', 'lait de coco, miel, extrait de vanille, graines de chia, lait de coco, cacao, extrait de vanille, graines de chia, datte, banane', '15 min', ['Préparation du pudding vanille-chia.', 'Dans un bol, mélanger le lait, le miel et l''extrait de vanille. Bien mélanger jusqu''à dilution du miel puis ajouter les graines de chia. ', 'Mélanger et laisser reposer. ', 'Préparation de la mousse chocolat-chia.', 'Couper les dates en tous petits morceaux, jusqu''à l''obtention presque d''une pâte de dates. ', 'Mélanger le lait, le cacao et et l''extrait de vanille. Ajouter les dates et mélanger bien fort jusqu''à épaississement de la préparation. ', 'Ajouter les graines de chia, bien mélanger et laisser reposer. ', 'Dans un petit bol ou une assiette, écraser la banane à la fourchette jusqu''à l''obtention d''une purée. ', 'Montage du pudding.', 'Dans des grands verres, verser la préparation au chocolat jusqu''à mi-hauteur environ, ajouter 1 à 2 cuillère(s) de purée de banane et terminer par la préparation à la vanille. ', 'Il est possible de décorer les verres en râpant un peu de coco sur le dessus du verre et/ou en saupoudrant de cacao.'], ['Rouleau à pâtisserie', 'Presse-agrumes'], ['lait de coco', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'extrait de vanille', 'très facile', 'Pudding chocolat banane vanille et graines de chia', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'graines de chia', 'boisson', 'pudding', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:54:06.640049', [{'ingredient_id': '9b90904f-f717-4077-8708-c0eefd709053', 'quantite': '15 cl'}, {'ingredient_id': '03496a14-73c2-4839-ac29-35d9a9a53555', 'quantite': '2 cuillères'}, {'ingredient_id': '1f32670d-3df5-47ca-8967-1ce65c8b69a6', 'quantite': '1 cuillères'}, {'ingredient_id': 'a8a96787-537a-4916-82dc-37d7e6c3c9ab', 'quantite': '1 cuillères'}, {'ingredient_id': 'f9c1424f-28a9-4034-b41c-7fb36ea2605c', 'quantite': '15 cl'}, {'ingredient_id': 'e358a1c7-e94f-45fd-b7fd-cdda5d1f5464', 'quantite': '2 cuillères'}, {'ingredient_id': 'b545812f-b443-41d9-9178-88af23465f50', 'quantite': '1 cuillères'}, {'ingredient_id': '67e8db16-e38d-414d-bfb4-0e30b5dc96ad', 'quantite': '1 cuillères'}, {'ingredient_id': '4d3c2a44-fd4d-40e0-b1f6-9a913a56e584', 'quantite': '4'}, {'ingredient_id': '043b50e4-86d7-44d0-a3e5-dbf4564e2417', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (531074, 'Bowlcake façon Raffaello', 'banane, flocons d''avoine, lait concentré sucré, noisettes, noix de coco, oeuf, noix de coco rapée, extrait de vanille liquide, fromage blanc, levure chimique, chocolat blanc, crème semi-épaisse', '5 min', ['Mélanger ensemble les flocons d''avoine, la levure, la vanille liquide, la banane écrasée, le fromage blanc et l’œuf.', 'Verser la moitié de la préparation dans un bol. Verser au milieu 1 càs de lait concentré mélangée à 1 càc de noix de coco râpée et 2 noisettes grossièrement concassées.
Recouvrir du reste de pâte.', 'Cuire 2 minutes 30 s. au four à micro-ondes et attendre 2 minutes avant de démouler sur une petite assiette.', 'Faire fondre le carré de chocolat blanc avec la crème pendant 30 secondes et napper le bowlcake. Saupoudrer de noix de coco.'], ['Planche à découper', 'Tire-bouchon', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'crème semi-épaisse', 'extrait de vanille liquide', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'Bowlcake façon Raffaello', 'rapide', 'oeuf', 'plat', 'mugcake', 'recette', 'noisettes', 'cuisine', 'recettes', 'lait concentré sucré', 'boisson', 'fromage blanc', 'noix de coco rapée', 'dessert', 'plat de résistance', 'chocolat blanc', 'noix de coco', 'flocons d''avoine', 'cocktail'], 'Dessert', bc9cd607-3158-4b43-9b68-809d4b433fa6, '2025-09-26T16:54:11.031968', [{'ingredient_id': '2dccacd8-80f7-4881-9b56-bf1e4c2bf1b0', 'quantite': '1'}, {'ingredient_id': '17fae959-357f-43ed-abe3-f207e4ac1db8', 'quantite': '40 g'}, {'ingredient_id': 'c3769f41-b10d-4d1f-b11b-dd7548f61def', 'quantite': '1 cuillères'}, {'ingredient_id': '84a426ef-229d-477f-9c57-d6825076d5c3', 'quantite': '2'}, {'ingredient_id': 'c6f4d53c-9ab2-4bf4-98a7-daf4fd5e745c', 'quantite': '1 cuillères'}, {'ingredient_id': '4e7a36bc-46fc-4a0f-a307-8df993308406', 'quantite': '1'}, {'ingredient_id': '7416ef5c-52e2-4efa-be55-ec4f5eb1cd96', 'quantite': '1 cuillères'}, {'ingredient_id': 'd4c52cc7-c718-4595-84f4-c81e72f87168', 'quantite': '1'}, {'ingredient_id': '2febb840-d7ac-44bd-83f6-ba971f56b59f', 'quantite': '2 cuillères'}, {'ingredient_id': '58bfde96-f1f9-45fa-bf81-4eb9856cfc84', 'quantite': '1'}, {'ingredient_id': '358f1aad-2ceb-4d0e-bba4-29e499ac266b', 'quantite': '1'}, {'ingredient_id': '72340038-fd4d-4a21-a7d9-9e4c9fb8d327', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (87612, 'Crumble à la mangue et confiture de banane', 'petit beurre, beurre, confiture de banane, mangue, sucre en poudre', '20 min', ['Cassez les petits beurres en morceaux (astuce: mettez-les dans un sac plastique alimentaire, recouvrez le sac par un torchon et donnez des coups de marteau [sert aussi à détendre les nerfs !).', 'Une fois en miettes mélangez-les au beurre préalablement découpé en dés dans un saladier (gardez un peu de poudre de biscuits pour le fond des ramequins). ', 'Vous obtiendrez alors une pâte dite "sablée".', 'Beurrez les ramequins, déposez une légère pincée de sucre et tapissez le fond des ramequins de poudre de biscuits.', 'Ajoutez environ 1 cuillère de confiture de banane (ne pas étaler) dans les ramequins.', 'Découpez les mangues en lamelles et les déposer sur la confiture de banane de façon à ce qu''on ne puisse plus la voir.', 'Ajoutez la pâte sablée sur les mangues, saupoudrez de sucre.', 'Mettez-les au four 5-10 min à 240°C (thermostat 8).', 'A manger chaud avec une boule de glace vanille en accompagnement.'], ['Fouet', 'Casserole', 'Batteur électrique', 'Planche à découper', 'Louche'], ['entrée', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'confiture de banane', 'facile', 'bon marché', 'rapide', 'plat', 'mangue', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Crumble à la mangue et confiture de banane', 'beurre', 'petit beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:54:15.303761', [{'ingredient_id': 'ecb4c052-0c56-49b7-ba73-a9c1a714d7e4', 'quantite': '1'}, {'ingredient_id': '83049a63-3b35-4e8b-8a11-3e3e99fe4b81', 'quantite': '150 g'}, {'ingredient_id': 'a520bf63-b62c-4090-b67d-94c5323cfff4', 'quantite': '4 cuillères'}, {'ingredient_id': 'aa4ed84b-e287-48f6-beb3-868660d95c83', 'quantite': '250 g'}, {'ingredient_id': 'decd2f05-c9fe-44ce-b20b-a4c6db519e5f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (224459, 'Gâteau bananes et graines de sésame', 'banane, farine, oeuf, beurre, cassonade, levure chimique, sésame', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Fouetter les bananes écrasées avec les œufs.', 'Mettre le beurre et le sucre, mélanger.', 'Ajouter la farine mélangée à la levure.', 'Ajouter la moitié des graines de sésame, jusqu''à l''obtention d''une pâte onctueuse.', 'Beurrer le moule de votre choix.', 'Verser et saupoudrer de graines de sésame sur toute la surface.', 'Mettre au four durant 35 minutes.'], ['Presse-agrumes', 'Batteur électrique', 'Moule à tarte', 'Tire-bouchon', 'Poêle'], ['', 'entrée', 'banane', 'Gâteau bananes et graines de sésame', 'recettes de cuisine', 'sésame', 'confiserie', 'testées', 'cassonade', 'levure chimique', 'facile', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:54:18.887232', [{'ingredient_id': '90a5fb40-9aa6-47a4-ad0d-50903243e56d', 'quantite': '3'}, {'ingredient_id': 'a2bf2443-984b-43f2-b290-32743284b72c', 'quantite': '250 g'}, {'ingredient_id': '3466a196-0efe-4904-b230-c0069e7c1b18', 'quantite': '4'}, {'ingredient_id': '50837614-92ed-499a-8d60-2f99a8ea6a1b', 'quantite': '150 g'}, {'ingredient_id': 'aabf0902-51f4-4e51-bda3-a455239ed99d', 'quantite': '200 g'}, {'ingredient_id': 'ba08ea20-35f1-47d2-aaae-4d35f85f4fc5', 'quantite': '1'}, {'ingredient_id': 'e0c168f6-7787-454e-a008-6a5a5747c5a7', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (217261, 'Smoothie banane-orange', 'banane, orange, sucre, jus de citron', '5 min', ['Presser les oranges.', 'Mixer ensemble le jus d''orange, le sucre, le jus de citron et les bananes pelées jusqu’à obtenir un mélange homogène.', 'Servir bien frais.'], ['Presse-agrumes', 'Mixeur', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'Smoothie banane-orange', 'orange', 'sucre', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:54:22.373400', [{'ingredient_id': 'd563928f-e412-4f14-ac9c-0f1a0671b263', 'quantite': '2'}, {'ingredient_id': '6eaa24da-e00c-4104-af94-3af09b7cd80e', 'quantite': '2'}, {'ingredient_id': 'b8873f0f-084d-460d-a69c-07685a6b2836', 'quantite': '2 cuillères'}, {'ingredient_id': 'ff0024d7-7e38-4af8-b373-cb16e792edbf', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (527850, 'Duo mousse chocolat banane', 'oeuf, sucre en poudre, crème fraîche allégée, beurre, banane, jus de citron, sel, café en poudre, chocolat noir', '30 min', ['Versez la crème dans un récipient y ajouter 1/4 du sucre, passer le tout au fouet jusqu''à obtenir une consistance assez ferme et veloutée, puis mettre au frais.', 'Dans une poêle faire fondre une noisette de beurre et faire revenir les bananes préalablement découpées en rondelles ainsi qu''un filet de jus de citron, lorsqu''elles sont bien fondantes les sortir du feu et les passer au blender jusqu a obtenir une texture veloutée,versez le tout dans un bol et mettre au frais.', 'Dans un récipient mettre le chocolat avec 3 cuillères à soupe d''eau et passer 30 sec au micro-ondes, ajouter un peu de café soluble (environ une cuillère a café) bien mélanger ensuite.', 'Dans un bol mettre le beurre puis passer 20 sec au micro-ondes pour le ramollir, y ajouter la moitié du sucre restant fouettez le tout jusqu a obtenir une mélange légèrement mousseux,ajouter le tout au chocolat et bien mélanger.', 'Fouettez les jaunes avec le sucre restant, jusqu''à obtenir une texture légèrement mousseuse et ajouter le tout au chocolat. Bien mélanger l''ensemble jusqu''à obtenir une texture bien lisse.', 'Montez les blancs en neige avec une pincée de sel (plus facile au fouet électrique), incorporez les au chocolat progressivement sans trop les casser. Récupérez votre crème fouettée au frigo et incorporez 1/4 de celle ci à votre mousse au chocolat,une fois bien mélangé réservez le tout au frigo.', 'Récupérez votre crème de banane et incorporez la à la crème fouettée restante bien mélanger l''ensemble.', 'Dans une verrine (ou verre ou tasse) remplir à moitié avec votre mousse de banane puis le reste avec la mousse au chocolat (pour plus de facilité utilisez une poche à douille) et laisser le tout au moins 6h au frigo.', 'Bon appétit!'], ['Verre doseur', 'Passoire', 'Presse-agrumes', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'mousse au chocolat', 'rapide', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'café en poudre', 'dessert', 'crème fraîche allégée', 'plat de résistance', 'chocolat noir', 'jus de citron', 'beurre', 'cocktail', 'Duo mousse chocolat banane'], 'Dessert', b131f4d0-b3dd-4240-aad9-c439a5e8504f, '2025-09-26T16:54:27.036959', [{'ingredient_id': '3c9bb34f-ec4c-4a2d-8c2b-3c9af18062c4', 'quantite': '3'}, {'ingredient_id': '783819ee-34bc-4e6b-b8c3-51c6aa8184e9', 'quantite': '30 g'}, {'ingredient_id': '9eb7720a-9714-456e-97d7-fe73a3ffac04', 'quantite': '20 cl'}, {'ingredient_id': '47c9d5f2-4ec9-4abe-9acb-9b78ea21a5e0', 'quantite': '40 g'}, {'ingredient_id': '81158bca-bcdb-485c-8bc7-4e30ea710921', 'quantite': '3'}, {'ingredient_id': 'b68178fc-3a6b-4863-b0fc-d10a23db8854', 'quantite': '1'}, {'ingredient_id': '541f001b-83fb-4948-9e0d-b92f124a9c63', 'quantite': '1'}, {'ingredient_id': 'ecf7f7f1-c08c-419b-b003-c8ec17b0b9aa', 'quantite': '1 cuillères'}, {'ingredient_id': 'd38cf58e-f861-4bd7-9093-6b22959e362e', 'quantite': '120 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (308563, 'Bavarois banane-gingembre', 'banane, citron, gingembre, gélatine, sucre en poudre, crème fraîche liquide', '30 min', ['La crème doit être très froide, stockez-la au frigo en avance, vous pouvez même monter la chantilly sur bain de glace.', 'Mettez la gélatine à ramollir dans un bol d''eau tiède (ne pas prendre en compte cela si vous utilisez de l''agar agar).', 'Mixez ensemble les bananes coupées en morceaux, le gingembre pelé et le jus du citron. ', 'Chauffez cette préparation à feu doux avec le sucre et la gélatine jusqu''à dissolution de celle-ci, puis laissez refroidir (pour l''agar agar, veillez à chauffer jusqu''à ébullition). Attention toutefois à ce que le mélange ne gélifie pas...', 'Montez la crème en chantilly et incorporez-y la préparation de banane refroidie.', 'Répartissez dans des ramequins ou des cercles, puis laissez prendre au frigo au minimum 3h.'], ['Balance de cuisine', 'Rouleau à pâtisserie', 'Mixeur', 'Économe', 'Presse-agrumes'], ['gingembre', 'entrée', 'Bavarois banane-gingembre', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'bavarois', 'sucre en poudre', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'gélatine', 'citron', 'cocktail'], 'Dessert', e524c061-aeae-4243-a508-4e75e835e036, '2025-09-26T16:54:32.061168', [{'ingredient_id': '775a2ead-304f-40be-91d7-3e3f58b29a80', 'quantite': '500 g'}, {'ingredient_id': 'f978430c-9e4d-4187-b23d-87540a6cf5da', 'quantite': '1'}, {'ingredient_id': '244cfc90-081f-4d82-ad89-8b7eefcb63c4', 'quantite': '1'}, {'ingredient_id': 'a3b30e2c-eff7-4ef7-a411-4cef152c340e', 'quantite': '5'}, {'ingredient_id': '5f18edbf-da68-4c71-9bd8-0c8f94f16078', 'quantite': '50 g'}, {'ingredient_id': '08495915-a389-47a2-8c2d-5deacc782eaf', 'quantite': '50 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40812, 'Cocktail pétillant à base de rhum', 'jus de banane, jus d''orange, eau, rhum, sucre de canne', '1 min', ['Verser les jus en premier. ', 'Puis verser l''eau pétillante au citron.', 'Ajouter le sucre de canne, et mélanger légèrement avec une cuillère, pour casser un peu les bulles de l''eau gazeuse.', 'Servir immédiatement.'], ['Pince de cuisine', 'Verre doseur', 'Spatule', 'Mixeur'], ['entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'eau', 'testées', 'assez cher', 'très facile', 'rapide', 'plat', 'cocktail rhum', 'jus de banane', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'dessert', 'plat de résistance', 'Cocktail pétillant à base de rhum', 'jus d''orange', 'cocktail'], 'Boisson', 36fecee3-261b-4063-87c7-b83426a2870e, '2025-09-26T16:54:35.744208', [{'ingredient_id': 'd8b5e0b2-1d95-4ac8-9418-f3b3c6abfe43', 'quantite': '10 cl'}, {'ingredient_id': 'e8e5c7c1-61ff-4255-a2ab-4225463b21e1', 'quantite': '10 cl'}, {'ingredient_id': '9174ac0b-aebe-48d8-8245-2df48491532c', 'quantite': '6 cl'}, {'ingredient_id': '24fa7ef7-d84f-4a00-b228-1de111a0878c', 'quantite': '6 cl'}, {'ingredient_id': '8ee87088-ecbb-4d08-a6bf-4dd4f06b36cd', 'quantite': '3 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392215, 'Crumble Healthy à la poire et banane', 'poire, banane, sucre vanillé, huile de coco, farine complète, sucre de canne, amandes en poudre, beurre de cacahuètes, cannelle', '0 min', ['Commencez par éplucher et épépiner les poires, puis coupez les en petits dés. Pelez les bananes et coupez les également en petits dés.', 'Dans une casserole, faites fondre la c. à café d’huile de noix de coco puis ajoutez-y les morceaux de poire.', 'Ajoutez un peu d’eau (pour rendre la poire un peu plus fondante) et le sachet de sucre vanillé.', 'Lorsque les morceaux poire ont une consistance assez fondante, ajoutez les morceaux de banane, mélangez et laisser cuire 5 à 10 minutes tout en ajoutant de l’eau selon la consistance que vous désirez.', 'Retirez du feu, puis mettez le mélange de fruits dans les ramequins. Vous pouvez ajoutez quelques pépites de chocolat noir pour plus de gourmandise.', 'Pour le crumble: mélangez la farine, le sucre, la poudre d’amande ainsi que la cannelle puis ajoutez le beurre de cacahuètes. Mélangez le tout. Nous obtenons une matière assez poudreuse, travaillez la à la main afin de faire comme des « petits grumeaux » que vous allez parsemer dans les ramequins.', 'Enfournez à 180ºC pendant 15 minutes (adaptez la cuisson à votre four) puis sortez les ramequins lorsque le crumble est bien doré. 
Laissez reposer à température ambiante.'], ['Louche', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'facile', 'Crumble Healthy à la poire et banane', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'huile de coco', 'crumble', 'cocktail'], 'Dessert', ecf062c8-927d-440c-9789-fcd086149fb9, '2025-09-26T16:54:39.316705', [{'ingredient_id': '1034a91a-535b-4666-a380-80d41694072e', 'quantite': '5'}, {'ingredient_id': 'ed78f2d7-cde9-4b7b-87e9-aac3c120cf90', 'quantite': '2'}, {'ingredient_id': '7e9bc2e9-0261-4927-ad93-7fb68a1fa78d', 'quantite': '1'}, {'ingredient_id': '6a89716f-db78-4618-9ffe-6056c5b9ea3e', 'quantite': '1 cuillères'}, {'ingredient_id': '7155fb8f-9355-4b24-a1a2-a42dee52a6ce', 'quantite': '50 g'}, {'ingredient_id': 'e60661d3-362b-49b0-a00c-8f728b0b521f', 'quantite': '50 g'}, {'ingredient_id': 'e08d7fa1-6103-455f-89a9-77b42bf68f95', 'quantite': '50 g'}, {'ingredient_id': '77ac4f69-652c-4d57-a058-638d4c939a19', 'quantite': '80 g'}, {'ingredient_id': '2175f04f-8b0b-4e59-ab75-a704784a0814', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (328232, 'Smoothie mangue', 'mangue, curcuma, yaourt, banane, jus d''orange', '10 min', ['Dans un blender, combiner tous les ingrédients et mélanger jusqu''à consistance lisse.', 'Servir dans un verre haut avec paille métallique et quelques morceaux de mangue.'], ['Fouet', 'Économe', 'Casserole', 'Louche', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'facile', 'bon marché', 'Smoothie mangue', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'curcuma', 'dessert', 'plat de résistance', 'jus d''orange', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:54:42.771449', [{'ingredient_id': '2e5c52bb-ad59-4154-a4c4-88e6e615c969', 'quantite': '1'}, {'ingredient_id': '845f3959-596d-4aea-85e2-593ffd711ae3', 'quantite': '1 cuillères'}, {'ingredient_id': 'f0c2ed85-3403-4fca-95d2-abcc83e9a146', 'quantite': '4'}, {'ingredient_id': '7b99fa77-01f4-4f2a-a89a-7becdca08ac6', 'quantite': '1'}, {'ingredient_id': '91e98523-e6d7-4569-9acb-5c3f5816d491', 'quantite': '8 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (45506, 'Tarte biscuitée aux fruits', 'sablés, poire, banane, sucre roux, chocolat noir, bounty, extrait de vanille, beurre, oeuf, lait, rhum', '20 min', ['Préparer la pâte : ', 'Mixer les biscuits ensemble. ', 'Faire fondre le beurre. ', 'Mixer les bounty et le chocolat; et ajouter une cuillère d''extrait de vanille ainsi qu''un bouchon de rhum. Bien mélanger.', 'Répartir la pâte sur un plat à tarte, et bien l''étaler avec les mains, de manière à ce qu''elle forme un fond de tarte.', 'Mettre au réfrigérateur pendant 1/2 h.', 'Mixer la moitié de la banane et une poire.', 'Fouetter l''oeuf avec le sucre, un bouchon de rhum, le lait, l''extrait de vanille et les fruits mixés.', 'Déposer le mélange sur le fond de tarte bien dur, et couper le reste des fruits pour les mettre par dessus. ', 'Enfourner à th 6 (180°C), pendant 1/4 d''h environ (surveiller!).', 'Laisser refroidir, et placer au frigo jsuqu''au moment de la dégustation!'], ['Balance de cuisine', 'Rouleau à pâtisserie', 'Mixeur', 'Moule à tarte', 'Ouvre-boîte'], ['', 'Tarte biscuitée aux fruits', 'banane', 'entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'extrait de vanille', 'poire', 'facile', 'sablés', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'bounty', 'dessert', 'plat de résistance', 'chocolat noir', 'moyen', 'beurre', 'lait', 'cocktail', 'sucre roux'], 'Dessert', b173ef79-0e43-41d3-b721-a1cf72a492c6, '2025-09-26T16:54:46.378920', [{'ingredient_id': '0749de3f-2852-43bb-83b0-d8e76ac840d5', 'quantite': '200 g'}, {'ingredient_id': '340221f1-ccd1-46c9-ac2e-19a9cdc87993', 'quantite': '2'}, {'ingredient_id': '38c77dc7-3033-47fe-8914-c1f199a83f67', 'quantite': '1'}, {'ingredient_id': '514b6da3-fdc3-4b59-aad5-f5ec5416fc44', 'quantite': ''}, {'ingredient_id': '7f535718-6f45-47b0-abbc-5b265debf144', 'quantite': '70 g'}, {'ingredient_id': 'de12f8d9-a00f-4e7e-b722-04942e3f317e', 'quantite': '3'}, {'ingredient_id': '89ea081b-5840-4f18-a887-4b85800b1023', 'quantite': '2 cuillères'}, {'ingredient_id': '861c9620-39d1-4b18-a111-603466d86468', 'quantite': '60 g'}, {'ingredient_id': '53b949a8-ce62-4013-89ec-c697444a8220', 'quantite': '1'}, {'ingredient_id': '839c7e81-6008-4efe-8f92-07ec5b4f330c', 'quantite': ''}, {'ingredient_id': '20ffcb8b-d445-40cc-8a41-fec3a0f97dde', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13568, 'Tarte chocolat banane facile', 'pâte brisée, chocolat noir, brique, banane', '10 min', ['Dérouler la pate brisée dans un plat à tarte et la faire cuire à blanc (avec des haricots secs pour éviter qu''elle monte) au four pendant 20 mn à 180°C.', 'Une fois la pâte cuite, couper le chocolat en petits morceaux, et le faire fondre au bain marie avec la crème liquide.', 'Couper les bananes en rondelles assez fines, les étaler au fond de la tarte en conservant quatre ou cinq rondelles.', 'Recouvrir le tout avec le chocolat fondu et les rondelles de banane concervée pour la décoration.', 'Mettre au réfrigérateur quelques heures et servir frais.'], ['Spatule', 'Planche à découper', 'Poêle', 'Casserole', 'Verre doseur'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Tarte chocolat banane facile', 'bon marché', 'plat', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'brique', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:54:53.280945', [{'ingredient_id': 'c12d1b5f-4ee0-4fe9-bd3f-ce51676ae787', 'quantite': '1'}, {'ingredient_id': 'e212de9c-c2ba-4670-833e-9d42935ea2b5', 'quantite': '1'}, {'ingredient_id': '55071ef4-8bb0-43a8-b5b9-d153fabf6682', 'quantite': '1'}, {'ingredient_id': '779a3aa3-cbc8-47d0-870e-d301a6cf0175', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52726, 'Brick jambon banane', 'brick, banane, jambon, gouda, beurre', '10 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Couper les bananes en deux dans la longueur et à nouveau en deux pour obtenir quatre morceaux.', 'Envelopper chaque morceau d''une tranche de gouda puis d''une tranche de jambon.', 'Mettre le tout dans une feuille de brick et rouler la feuille comme pour confectionner des nems.', 'Mettre dans un plat à four et badigeonner d''un peu de beurre fondu.', 'Enfourner pour 15 minutes de cuisson.'], ['Ouvre-boîte', 'Passoire', 'Verre doseur', 'Presse-agrumes', 'Rouleau à pâtisserie'], ['Brick jambon banane', 'entrée', 'banane', 'recettes de cuisine', 'jambon', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'gouda', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:54:57.070732', [{'ingredient_id': '9c0bdf79-f40c-410d-80b6-c01fe831c3e8', 'quantite': '2'}, {'ingredient_id': '69b12ba4-7f4d-4b95-a22f-6bda30534fb3', 'quantite': '4'}, {'ingredient_id': '3431c425-8c98-4cbd-beee-7a57a1b534fd', 'quantite': '8'}, {'ingredient_id': '16b4fe98-4341-4f32-865c-954d9a6578e6', 'quantite': '16'}, {'ingredient_id': '5ad3f48e-81ac-48b7-8d7c-46377ba40864', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (59060, 'Croque-monsieur saveur banane et pêche', 'pain de mie, banane, confiture d''abricot, beurre', '2 min', ['Etaler une cuillère de confiture sur chacune des tranches de pain de mie.', 'Disposer des rondelles de bananes sur la confiture. Prendre une autre tranche, la beurrer des deux côtés et couvrir la première tranche fruitée avec.', 'Disposer les croque-monsieurs dans le four ou dans une machine à croques. Faire dorer.', 'Déguster tiède.'], ['Pince de cuisine', 'Ouvre-boîte', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Croque-monsieur saveur banane et pêche', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'confiture d''abricot', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'cocktail', 'pain de mie'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:55:00.645382', [{'ingredient_id': '9f822469-eee5-4090-a88b-0c2334c37447', 'quantite': '4'}, {'ingredient_id': 'd7896761-b788-4c49-82ba-7e544aefd378', 'quantite': '1'}, {'ingredient_id': '8716fee0-89d5-449b-8910-ad7d2d3c4b29', 'quantite': '2 cuillères'}, {'ingredient_id': '1c5a0f15-ede1-427a-8ace-cfef2f03e7b1', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27363, 'Tarte à la rhubarbe et aux bananes', 'pâte brisée, rhubarbe, banane, sucre, citron', '15 min', ['Etalez la pâte dans un moule à tarte beurré.', 'Pelez et coupez le bananes en rondelles, citronnez-les et recouvrez-en le fond de pâte.', 'Pelez et coupez la rhubarbe en petits morceaux, répartissez-les sur la tarte.', 'Saupoudrez de sucre et faites cuire 40 min au four à 210°C (thermostat 7).'], ['Spatule', 'Fouet', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'tarte à la rhubarbe', 'rhubarbe', 'facile', 'plat', 'recette', 'cuisine', 'pâte brisée', 'Tarte à la rhubarbe et aux bananes', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'citron', 'sucre', 'cocktail'], 'Dessert', ee74f832-4fe4-4de2-a344-5e3dee006f2e, '2025-09-26T16:55:04.480700', [{'ingredient_id': 'fbbd7a23-3e3b-469b-a39b-afab151eeaf0', 'quantite': '1'}, {'ingredient_id': 'cebf977f-22ab-4a55-ad4b-5a0fd6953db2', 'quantite': '500 g'}, {'ingredient_id': 'addc5167-139b-46ab-9109-761bcd4b6cc7', 'quantite': '2'}, {'ingredient_id': '06207bb2-2322-48f2-8a3b-d2c50ce2ac2b', 'quantite': '125 g'}, {'ingredient_id': '126e94e3-4a16-42ec-84b8-07909acbcb33', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (312052, 'Tarte aux poires pommes bananes', 'pâte sablée, pomme, poire, banane, sucre vanillé, brique, crème fraîche, oeuf', '20 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Mettre la pâte dans le plat à tarte. ', 'Éplucher les poires, les pommes et les couper en fines lamelles que l''on placera sur la pâte.', 'Éplucher les bananes et les couper en lamelles puis les ajouter aux pommes et poires.', 'Dans un saladier préparer la crème comme ceci :', 'Mettre l’œuf entier, la crème fraîche, la crème anglaise, la crème fraiche et le sucre vanillé puis mélanger le tout.', 'Verser la crème obtenue sur les fruits.', 'Placer le plat dans le four et laisser cuire environ 45 minutes à 180°C (thermostat 6). Sortir le plat et c''est prêt !'], ['Spatule', 'Batteur électrique', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'poire', 'facile', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'tarte aux pommes', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'Tarte aux poires pommes bananes', 'brique', 'cocktail'], 'Dessert', 62fc3150-3bda-4d37-97a2-3a9491cb5493, '2025-09-26T16:55:08.141569', [{'ingredient_id': '1d29543f-3ba0-43bb-8a28-28e4a1dc294b', 'quantite': '1'}, {'ingredient_id': 'b5988085-da38-41f8-ba8b-c354199e3f82', 'quantite': '2'}, {'ingredient_id': 'b8f180e9-6462-4229-8192-3792df70d43a', 'quantite': '2'}, {'ingredient_id': '106f4cbb-78d0-40dc-a36c-13590f9febd4', 'quantite': '2'}, {'ingredient_id': '19473f3f-57b5-4c36-8368-77a9d0a134ef', 'quantite': '1'}, {'ingredient_id': '9e8c0a41-15e7-4084-8d5d-4d0be1925b63', 'quantite': '1'}, {'ingredient_id': 'ab0ec02e-b830-4018-8d09-9ea34526a3d3', 'quantite': '4 cuillères'}, {'ingredient_id': '059e2f3a-8e01-46c6-b616-b38b6fb2b85c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43151, 'Gloubi banane-chocolat', 'banane plantain, pralinoise, sucre en poudre, yaourt à la grecque', '30 min', ['Faire chauffer les bananes avec la peau dans de l''eau (comme vous le feriez pour des pommes de terre), pendant une vingtaine de minutes.', 'Une fois la cuisson terminée, les éplucher, et les couper en morceaux.', 'Les passer au mixeur, avec le sucre en poudre et le yaourt à la grecque.', 'Faire fondre le chocolat au micro-ondes, avec une petite goutte de lait.', 'Rajouter le chocolat fondu dans le mixeur sur les bananes déjà écrasées, et re-mixer un petit coups.', 'Déguster immédiatement!'], ['Spatule', 'Louche', 'Batteur électrique'], ['', 'yaourt à la grecque', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'Gloubi banane-chocolat', 'plat de résistance', 'banane plantain', 'pralinoise', 'cocktail'], 'Dessert', 5cfbb9f4-1e02-44f6-8923-1dd23b4edc7e, '2025-09-26T16:55:11.777821', [{'ingredient_id': '1f62f1c7-a9fb-4442-8095-31bda41b9063', 'quantite': '4'}, {'ingredient_id': '574ded56-05dd-4e13-8233-afb69ecc2536', 'quantite': '100 g'}, {'ingredient_id': 'b750e34c-cb6a-4d8d-b974-e70a682bbc43', 'quantite': '1 cuillères'}, {'ingredient_id': '935a5f72-6f42-4382-a352-dad5d015b2b4', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (63520, 'Soupe aux bananes plantain et aux poireaux', 'blanc de poireau, banane plantain, bouillon de volaille, poivre, sel', '5 min', ['Mettre les légumes et le bouillon dans une casserole. Faire cuire à feu doux, jusqu''à ce que les légumes soient tendres. ', 'Passer au mixeur, saler et poivrer. Servir.'], ['Passoire', 'Verre doseur', 'Mixeur', 'Tire-bouchon'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'plat', 'bouillon de volaille', 'recette', 'cuisine', 'recettes', 'boisson', 'soupe', 'dessert', 'plat de résistance', 'banane plantain', 'Soupe aux bananes plantain et aux poireaux', 'moyen', 'blanc de poireau', 'poivre', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:55:15.329103', [{'ingredient_id': '185909b5-4e93-4c33-a90d-f9e390ecbd76', 'quantite': '1'}, {'ingredient_id': '41773140-f60f-45d5-b92a-5c75c79e0e38', 'quantite': ''}, {'ingredient_id': '63bbf09e-b1de-4d5d-a2db-fe44237ec8a3', 'quantite': '5'}, {'ingredient_id': 'f64eb717-9fc4-46f4-924f-f8fda4d54799', 'quantite': ''}, {'ingredient_id': '64c99380-975d-49c0-8260-5ae0e21cc385', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (331834, 'Pain de mie perdu Nutella/Banane', 'pain de mie, oeuf, lait, sucre vanillé, Nutella, banane, beurre, cannelle', '20 min', ['Etaler le pain délicatement avec un rouleau à pâtisserie (il ne faut pas l''aplatir complètement). Réserver.', 'Découper les bananes en petits morceaux.', 'Dans une poêle, faire fondre 10 g de beurre et y cuire les bananes jusqu''à ce qu''elles soient dorées. Ajouter une pointe de cannelle.  Réserver.', 'Prendre 2 petits saladiers. Dans l''un, mettre l''oeuf battu et dans l''autre le lait additionné de sucré vanillé.', 'Tartiner les tranches de pain de mie de Nutella. Ajouter quelques morceaux de bananes sur chacune et les rouler.', 'Faire fondre le beurre restant dans une poêle. Tremper les roulés d''abord dans le lait puis ensuite dans l''oeuf. Cuire à feu doux. Dès que les roulés sont bien dorés, les retirer de la poêle. ', 'Se régaler.'], ['Économe', 'Presse-agrumes', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Nutella', 'Pain de mie perdu Nutella/Banane', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'cannelle', 'lait', 'cocktail', 'pain de mie'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:55:19.058349', [{'ingredient_id': '27659dc5-cb75-4569-9d18-b692a5b7b3ab', 'quantite': '6'}, {'ingredient_id': 'ea09882b-de3c-488e-a3db-95a49048fbb3', 'quantite': '1'}, {'ingredient_id': 'b1f3c80c-2796-43fd-b0b1-0f5d4e95e45d', 'quantite': '20 cl'}, {'ingredient_id': '57b4f12f-49a3-4ff8-90f4-f20eb4792bd5', 'quantite': '1'}, {'ingredient_id': '9033f6cd-8b26-4150-95bc-2ccd571b6571', 'quantite': '6 cuillères'}, {'ingredient_id': 'f8578f42-1228-4c0b-b6a9-0d62a8fb8f98', 'quantite': '2'}, {'ingredient_id': '60615fe9-69fb-4ab2-a79c-b934abbb46c1', 'quantite': '40 g'}, {'ingredient_id': 'a1f5a77c-6204-487c-ac5a-7f1603172e3a', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38042, 'Beignets de bananes plantain', 'banane plantain, farine, sucre, oeuf, sucre glace, levure, lait, eau de fleur d''oranger, extrait de vanille, cannelle, muscade', '20 min', ['Epluchez les bananes et coupez-les en rondelles.', 'Placez-les dans une casserole avec 2 verres d''eau, faites cuire 5 à 10 min, égouttez et laissez refroidir et réduire en purée avec une fourchette. ', 'Préparez votre pâte, tamisez votre farine et la levure dans un saladier, incorporez le sucre, la cannelle, la muscade, vos oeufs et le lait, la vanille, la muscade, la cannelle, l''eau de fleur d''oranger. ', 'Ajouter votre purée de bananes à la pâte et mélangez bien le tout afin d''obtenir une pâte bien lisse.', 'Laisser reposer au moin 10 min.', 'Faites frire des petites boules de pâte à l''aide de 2 petites cuillères à café.', 'Déposez-les ensuite sur un papier absorbants pour bien les égoutter. ', 'Saupoudrez de sucre glace.'], ['Batteur électrique', 'Moule à tarte'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'Beignets de bananes plantain', 'extrait de vanille', 'muscade', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'beignets sucrés', 'farine', 'dessert', 'plat de résistance', 'banane plantain', 'eau de fleur d''oranger', 'sucre glace', 'cannelle', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:55:22.503069', [{'ingredient_id': '47b63ce4-0141-4b03-845b-7870569bfcb9', 'quantite': '3'}, {'ingredient_id': '791f1664-afd9-4014-8038-d623e351b320', 'quantite': '250 g'}, {'ingredient_id': '268fa8f0-a117-4811-a396-61e81e21ac73', 'quantite': '50 g'}, {'ingredient_id': 'f9fe9d24-ba49-4df0-8c00-216e8f0508f3', 'quantite': '3'}, {'ingredient_id': '766a3b73-c4ca-4c8a-ae96-09e976033e8c', 'quantite': '50 g'}, {'ingredient_id': 'a5b978e1-7d52-4a55-ad06-ec001e303132', 'quantite': '1'}, {'ingredient_id': '654b2017-ae84-40a1-b0ee-37b1fe66820e', 'quantite': '1'}, {'ingredient_id': 'b163ea24-2f7b-4df1-aafa-83f9fd5cf1aa', 'quantite': ''}, {'ingredient_id': '0b1f2971-9868-4793-aaff-dfd6809f63ec', 'quantite': '1 cuillères'}, {'ingredient_id': 'c664a910-f791-4ce5-bbbd-e4490d75708a', 'quantite': '1 cuillères'}, {'ingredient_id': 'a34b175b-67ad-4b34-95e2-31f5e56b20b4', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345302, 'Smoothie rapide et frais pour l''été', 'banane, jus d''ananas, lait de coco, raisin', '5 min', ['Mettre tous les ingrédients au frais 1h à l''avance.', 'Mettre tous les ingrédients dans un blender. ', 'Mixer jusqu''à ce qu''il n''y est plus de morceaux de banane.', 'Bon appétit.'], ['Rouleau à pâtisserie', 'Râpe', 'Batteur électrique', 'Verre doseur'], ['lait de coco', 'raisin', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus d''ananas', 'smoothies', 'cocktail', 'Smoothie rapide et frais pour l''été'], 'Boisson', 8354d119-1ad0-4d90-9b16-6c349c049a0c, '2025-09-26T16:55:27.075715', [{'ingredient_id': 'ae2810db-e416-4562-b626-8830436c6f5b', 'quantite': '1'}, {'ingredient_id': '208b7895-fc30-4246-a46d-954765cdf093', 'quantite': '40 cl'}, {'ingredient_id': '9505c926-04d3-4429-bfe6-7594d784dc7e', 'quantite': '20 cl'}, {'ingredient_id': '3597b400-156c-43f1-8dcf-a1c7bca0f633', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (87555, 'Béchamelle de bananes jaunes', 'banane, pomme de terre, oignon, lardons fumés, crème allégée, Parmesan, lait, farine, sel', '10 min', ['Epluchez les pommes de terre, coupez-les en morceaux (des cubes moyens) et mettez-les à cuire dans de l''eau bouillante salée. ', 'Epluchez les bananes jaunes et coupez-les en rondelles. Ajoutez-les à l''eau bouillante.', 'Pendant ce temps, dans une poêle légèrement huilée, faites dorer les lardons. Ajoutez par la suite', 'l''oignon haché. Laissez dorer puis verser la crème légère. Remuez et éteignez le feu.', 'Une fois les légumes cuits, égouttez et versez-les dans la préparation, ajoutez le verre de lait. ', 'Dans un verre, mélangez un peu d''eau avec la farine (on obtient une crème onctueuse), versez la dans la casserole.', 'Remuez et ajoutez du parmesan. Rectifiez l''assaisonnement si besoin.', 'Servez chaud.'], ['Poêle', 'Planche à découper', 'Râpe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'cocktail', 'facile', 'plat', 'crème allégée', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'lardons fumés', 'farine', 'dessert', 'plat de résistance', 'moyen', 'lait', 'pomme de terre', 'Béchamelle de bananes jaunes', 'Parmesan'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:55:32.759303', [{'ingredient_id': '3f0a1eb3-af5d-4493-9dff-25ed82db4b46', 'quantite': '5'}, {'ingredient_id': 'efc32a43-16b3-45bd-8da5-ffe35c503ee1', 'quantite': '4'}, {'ingredient_id': '77ef93aa-8833-47fa-92e4-61fca7212113', 'quantite': '1'}, {'ingredient_id': '50e7ae5e-9e43-4c0e-a35c-d43b45cab376', 'quantite': '200 g'}, {'ingredient_id': '4d2d84da-e4e6-4175-ba57-af1d8d846969', 'quantite': '200 g'}, {'ingredient_id': '5f60fc3c-e970-4bc9-b912-bcfa644ceb4e', 'quantite': '50 g'}, {'ingredient_id': 'b8405f2c-ff25-4d6b-a84e-dd3041f53352', 'quantite': '20 cl'}, {'ingredient_id': '8c62994f-ab65-46cc-bd29-688d764c2dae', 'quantite': '3 cuillères'}, {'ingredient_id': '0157f303-cfb7-4140-8d86-f18fef5e23c6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (531625, 'Bananes aux chocolats et pistaches', 'banane, chocolat, pistaches', '30 min', ['Faire fondre le chocolat au bain-marie.', 'Enlever la peau des bananes et les mettre sur une grille (prévoir une plaque de cuisson pour la mettre en dessous)', 'Écraser les pistaches grossièrement.', 'Verser généreusement le chocolat sur les bananes puis parsemer de morceaux de pistaches !'], ['Planche à découper', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'rapide', 'plat', 'pistaches', 'recette', 'cuisine', 'recettes', 'boisson', 'Bananes aux chocolats et pistaches', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', d342ad0c-d25a-4344-8d78-243962feb456, '2025-09-26T16:55:36.322866', [{'ingredient_id': '5e0a6f0d-cd09-4dde-b543-87c01b3796f2', 'quantite': '2'}, {'ingredient_id': '058df084-d18f-4b15-9b11-3d9e50a54f52', 'quantite': '200 g'}, {'ingredient_id': '27367176-5407-4cb0-8bd5-fd1e7a10a6d4', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50324, 'Boisson délice fraise banane orange', 'jus d''orange, yaourt, yaourt nature, fraises, banane', '10 min', ['Mixer les deux yaourts avec le jus d''orange puis incorporer les fraises et les rondelles de bananes congelées.', 'Lorsque le mélange est homogène, répartir dans deux verres.', 'Décorer de tranches d''orange posées sur le rebord du verre.'], ['Fouet', 'Planche à découper', 'Balance de cuisine', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus d''orange', 'Boisson délice fraise banane orange', 'cocktail'], 'Boisson', 0f6ba5a7-434d-460a-a444-f36ac3a9db12, '2025-09-26T16:55:41.035327', [{'ingredient_id': '5255f223-9682-4e38-b658-49aa50ced405', 'quantite': '15 cl'}, {'ingredient_id': 'ca728b7c-8678-43d7-9b57-14c987c68a45', 'quantite': '20 cl'}, {'ingredient_id': 'acd138a6-ca0e-4e78-9c92-a5c6785de1ca', 'quantite': '15 cl'}, {'ingredient_id': '2f14cef2-4b26-446e-b2f5-94052b05570a', 'quantite': '180 g'}, {'ingredient_id': 'a5e98365-3d90-4613-86bd-5f7f4c0b23a6', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36522, 'Le diplomate de Rachel ( série TV Friends )', 'biscuits à la cuillère, confiture, crème pâtissière, framboises, sauté de veau, petits pois, oignon, banane, crème chantilly', '30 min', ['Disposer dans un moule haut et rond dans cet ordre :', '- une couche de biscuits', '- une couche de confiture', '- une couche de crème pâtissière', '- une couche de framboises', '- une couche de biscuits', '- une couche de boeuf', '- une couche de petits pois et oignons', '- une couche de crème pâtissière', '- une couche de bananes', '- une couche de chantilly', '- du rhum (pour boire avec?)'], ['Rouleau à pâtisserie', 'Verre doseur', 'Mixeur', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'confiture', 'crème pâtissière', 'testées', 'biscuits à la cuillère', 'très facile', 'framboises', 'bon marché', 'plat', 'recette', 'sauté de veau', 'cuisine', 'recettes', 'oignon', 'boisson', 'crème chantilly', 'dessert', 'petits pois', 'plat de résistance', 'Le diplomate de Rachel ( série TV Friends )', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:55:44.625449', [{'ingredient_id': '27575485-25c0-453f-8350-45ed937b2251', 'quantite': ''}, {'ingredient_id': '3856eef6-051c-4642-ad3b-bde2ee5a7f4f', 'quantite': ''}, {'ingredient_id': '4f4d8be3-c06f-4636-abe9-9adc8321b0f6', 'quantite': ''}, {'ingredient_id': '86a626f1-1d8f-4daa-b2d0-d442724dadb5', 'quantite': ''}, {'ingredient_id': 'e0cda635-7810-4fd7-9d46-044018bd33d7', 'quantite': ''}, {'ingredient_id': '9754c832-0de5-4cb8-ae48-25dd3f62d738', 'quantite': ''}, {'ingredient_id': 'ccf20cec-082b-4147-95d9-49b2a1ec858d', 'quantite': ''}, {'ingredient_id': 'b7c612f3-8fa6-4596-a3f2-4449e463f967', 'quantite': ''}, {'ingredient_id': '5ad6ce7a-b3bd-41de-9df0-3aa9a1bb9683', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (223332, 'Cookies banane-poire', 'margarine, sucre, farine, levure, sel, banane, poire, oeuf', '15 min', ['Préchauffez le four à 200°C (thermostat 6) sur chaleur tournante.', 'Écrasez les bananes et la poire.', 'Dans un saladier, mélangez la margarine légèrement fondue, le sucre, le sel et l’œuf. ', 'Incorporez les bananes et la poire, mélangez un peu. Puis, ajoutez la farine et la levure. ', 'Sur deux plaques recouvertes de papier sulfurisé, placez des petits tas (environ une cuillère à soupe) bien espacés. ', 'Mettez au four (en deux tournées) durant environ 10 min. ', 'Laissez refroidir les cookies sur une grill. ', 'Dégustez !'], ['Économe', 'Presse-agrumes', 'Râpe', 'Passoire'], ['entrée', 'Cookies banane-poire', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'poire', 'facile', 'bon marché', 'cookie', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'margarine', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:55:48.266484', [{'ingredient_id': '027c203c-7864-44fb-ab4b-258f58997ce8', 'quantite': '50 g'}, {'ingredient_id': '55c39842-970d-4985-9824-1c32a652b28b', 'quantite': '175 g'}, {'ingredient_id': '63466d21-4e95-49a5-90fa-a8b7079d21e1', 'quantite': '200 g'}, {'ingredient_id': 'a594ddd2-a47a-417f-94dd-1f1c77258f1a', 'quantite': ''}, {'ingredient_id': '02267eee-e8f2-4f5b-a769-0b22daadd34a', 'quantite': '1'}, {'ingredient_id': 'f0005240-09b1-4733-9e8d-87c9b8579d09', 'quantite': '2'}, {'ingredient_id': '4d8419a5-547b-4f15-abc9-eed418a1900d', 'quantite': '1'}, {'ingredient_id': '100be5a8-c78f-418a-88a6-de9d9a85ee43', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (48894, 'Crème de banane', 'banane, crème fraîche, sucre vanillé, sucre de canne, citron', '5 min', ['Couper les bananes en petits morceaux et les mettre dans un mixer.', 'Arroser de suite avec le citron, et rajouter le reste des ingrédients.', 'Mixer le tout + ou - grossièrement selon votre goût.', 'A déguster tout de suite, ou servir frais.', 'On peut aussi congeler la crème et la sortir 5 min avant de consommer.', 'C''est délicieux !'], ['Pince de cuisine', 'Moule à tarte', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron', 'Crème de banane', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:55:52.983621', [{'ingredient_id': '50d5d36e-2969-4abe-a9bb-8d3f42fa3bd7', 'quantite': '4'}, {'ingredient_id': 'a01802fa-8ac2-45e4-9e70-c929fc915a79', 'quantite': '4 cuillères'}, {'ingredient_id': '90515a4b-d0ce-4292-b306-19a835cf4b70', 'quantite': '1'}, {'ingredient_id': '7c21a2fe-d554-4e44-a2cf-0f49a0306a2d', 'quantite': '2 cuillères'}, {'ingredient_id': '1e34f1db-3175-43c4-8dd5-a420e74b0ad4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336308, 'Smoothie banane mangue', 'banane, mangue, yaourt, jus d''orange, sucre roux', '10 min', ['Coupez les fruits pelés et dénoyautés en morceaux.', 'Mixez tous les ingrédients en ajoutant plus ou moins de jus d''orange, il sert à liquéfier la préparation et à lui donner la texture désirée.', 'Quelques minutes plus tard, vous voilà au soleil.', 'Versez dans des verre et dégustez immédiatement.', 'Parfait pour un matin énergétique !'], ['Casserole', 'Pince de cuisine', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'Smoothie banane mangue', 'dessert', 'plat de résistance', 'jus d''orange', 'smoothies', 'cocktail', 'sucre roux'], 'Boisson', 6e6c5616-f647-4cea-9928-21149d12dce0, '2025-09-26T16:55:56.593800', [{'ingredient_id': 'a24ef56f-90d8-49bc-9ee1-76ef898e8642', 'quantite': '2'}, {'ingredient_id': '2496c001-0069-4b1c-a994-45ee89558eae', 'quantite': '1'}, {'ingredient_id': '809bca3f-463d-4f8d-9fe2-fb2806ec4a17', 'quantite': '1'}, {'ingredient_id': '6909e49f-d274-4637-8722-e37d55361f98', 'quantite': '20 cl'}, {'ingredient_id': 'c9021197-b090-4ff4-9e12-3fc519979db2', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (220540, 'Tajine de porc au miel et banane', 'échine de porc, banane, citron, champignons de Paris, raisin, oignon, miel, cannelle, clou de girofle, feuille de laurier, thym, sel, poivre, ail, cumin, huile d''olive, beurre, vin rouge, eau, maïzena, semoule', '30 min', ['Faites revenir dans un plat à Tajine (en fonte de préférence) l''oignon émincé dans l''huile et le beurre.', 'Quand les oignons sont jaunes et tendres, mettez à revenir toujours à feu vif la viande préalablement coupés en cube de 1 cm de coté.', 'Quand la viande est dorée, mouillez avec deux verres de vin et un verre d''eau. Baissez le feu. ', 'Ajoutez 1 cuillère à café de cumin, 1 cuillère à soupe de miel, le laurier, le thym, le bâton de cannelle, le clou de girofle, l''ail écrasé, les raisins de Corinthe. Salez et poivrez.', 'Couvrez et laissez mijoter 30 min.', 'Pendant ce temps, égouttez et rincez les champignons, coupez les bananes en rondelles pas trop fine. ', 'Recouvrez les bananes de jus de citron.', 'Après 30 min, ajoutez une cuillère à café de maïzena, goûtez la sauce pour vérifier l''assaisonnement. Rectifiez si nécessaire.', 'Ajoutez les champignons et les bananes.', 'Couvrez de nouveau et laissez mijoter 10 min.', 'Accompagnez avec de la semoule ou des pâtes, présentez dans le plat à Tajine.', 'Bon appétit !'], ['Pince de cuisine', 'Moule à tarte', 'Presse-agrumes', 'Casserole'], ['raisin', 'entrée', 'banane', 'tajine', 'recettes de cuisine', 'échine de porc', 'feuille de laurier', 'sel', 'eau', 'testées', 'confiserie', 'cumin', 'facile', 'maïzena', 'semoule', 'ail', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'oignon', 'boisson', 'clou de girofle', 'huile d''olive', 'vin rouge', 'dessert', 'plat de résistance', 'Tajine de porc au miel et banane', 'moyen', 'thym', 'champignons de Paris', 'beurre', 'citron', 'cannelle', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:56:00.331405', [{'ingredient_id': '5022e70c-9cf3-4f7b-8770-db1314e00185', 'quantite': '4'}, {'ingredient_id': 'e551221a-5489-45a5-9cdf-8d1a8ef48c51', 'quantite': '2'}, {'ingredient_id': 'b3400b55-9aaa-4281-afa0-979187da8882', 'quantite': ''}, {'ingredient_id': '56383af2-bb65-4ad9-8e9e-a52a5aea3d9d', 'quantite': '1'}, {'ingredient_id': 'cf0d6f61-de1e-4100-b5de-483cdbde31ea', 'quantite': '30'}, {'ingredient_id': 'cf2bed99-8886-4bad-bea8-d1937a2272e8', 'quantite': '1'}, {'ingredient_id': '3fbf61b9-b543-4c90-8863-5e36060b5dc3', 'quantite': '1 cuillères'}, {'ingredient_id': '31b5d3d7-80ef-4664-a889-383f49806501', 'quantite': '1'}, {'ingredient_id': '6c9ef5b1-d3ad-48cf-b262-da236750ccc3', 'quantite': '1'}, {'ingredient_id': '13c9f370-2d1e-4ea1-8d26-55873a8adb9e', 'quantite': '5'}, {'ingredient_id': '2da5db3d-378f-4394-99f7-fe2b8fe6676f', 'quantite': ''}, {'ingredient_id': '04e18d8c-c2ca-4c81-a4cb-30f7a8434e3c', 'quantite': ''}, {'ingredient_id': '2f4ed704-9d9c-460f-b9de-7e75d2cb80ed', 'quantite': ''}, {'ingredient_id': '3c93a87d-c588-4a72-9bf6-94e38cc44352', 'quantite': '1'}, {'ingredient_id': 'fb63777b-2721-4c0d-94c1-8d6d544dc457', 'quantite': '1 cuillères'}, {'ingredient_id': 'b8875119-1e8c-4c5f-8848-1348b777d5f9', 'quantite': '2 cuillères'}, {'ingredient_id': 'bd5a3052-9d1e-4080-b431-1cc9e59f75d8', 'quantite': '20 g'}, {'ingredient_id': '5b1f976a-a97e-4a89-9e5d-c26ce6955095', 'quantite': '2'}, {'ingredient_id': '63a398f9-012c-4984-bd4b-11a2e30f0edb', 'quantite': '1'}, {'ingredient_id': '76089a6e-f98b-498a-ab2e-1ba35a7138f9', 'quantite': '1 cuillères'}, {'ingredient_id': '52c52b0d-7d0e-4b30-8603-1657ca5b323d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (231345, 'Crème à la banane citronnée', 'banane, petit suisse, lait concentré sucré, jus de citron', '10 min', ['On mixe le tout et on met au frais 3 à 4 heures.'], ['Râpe', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'petit suisse', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'lait concentré sucré', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'Crème à la banane citronnée', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:56:06.116164', [{'ingredient_id': '8e4f4d96-9684-4f42-a37e-c09386a3b5da', 'quantite': '6'}, {'ingredient_id': '34988a5c-098f-4ce4-a814-feb36599bea3', 'quantite': '8'}, {'ingredient_id': '29a70271-fce8-4ea6-a54d-526073766bc6', 'quantite': '8 cuillères'}, {'ingredient_id': '6af515ae-9a2f-4f77-956e-836a99a7bd96', 'quantite': '5 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (218602, 'Nuggets de morue hachée façon Cyphen', 'morue, banane, sel, poivre, oignon, piment, huile d''olive, farine de blé, farine de maïs, oeuf, chapelure', '45 min', ['Préparer la banane jaune en cuisson habituelle', 'Couper la morue sans arête,l''oignon...quelques fines tranches de piment en tenant compte de son intensité et de votre résistance d''estomac.', 'Mettre le tout dans un mixeur sans oublier sel, poivre,huile d''olive afin une sorte de hachis.', 'Étendre un film alimentaire sur une surface plane et propre puis déposer le hachis.', 'Faire un boudin régulier avec le film et son contenu.', 'Mettre au congélateur et surveiller de temps en temps en enfonçant légèrement votre doigt jusqu''à obtenir un état médian entre mou et dur.', 'Sortir le boudin et enlever le film !', 'Sur une planche, se munir un gros couteau et faire des tranches entre 1 et 1,5 cm. Faire chauffer une poêle à feu moyen.', 'A côté, préparer trois assiettes :', 'une assiette de farine( 65% maïs, 35% blé)', 'une assiette d’œufs battus', 'une assiette de chapelure', 'Effectuer la panure F.O.C dans l''ordre indiqué précédemment pour chaque tranche du boudin.', 'Faire la cuisson dans la poêle environ 10 min en retournant souvent jusqu''à un aspect doré ou ocre foncé.', 'Égoutter sur essuie-tout.'], ['Ouvre-boîte', 'Passoire', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'cocktail', 'rapide', 'plat', 'moyenne', 'recette', 'piment', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'moyen', 'morue', 'poivre', 'Nuggets de morue hachée façon Cyphen'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:56:11.868222', [{'ingredient_id': '937c0ddb-f42e-4813-81f0-cb3e8ad66dd1', 'quantite': '300 g'}, {'ingredient_id': '4c8562f0-46c4-4fb0-bdb5-73b6ccd2f2d0', 'quantite': '1'}, {'ingredient_id': 'f7f8af62-8f3e-482d-a3b1-ee85e5da698c', 'quantite': ''}, {'ingredient_id': 'e53f3b7c-423e-4176-96ff-e266c3d5783a', 'quantite': ''}, {'ingredient_id': '2e8e621f-03e7-4207-84d5-14bf185cc304', 'quantite': '1'}, {'ingredient_id': '5fb14b20-b3b5-48ad-85d1-6e8c2d50e34c', 'quantite': '1'}, {'ingredient_id': '1e03a8d5-7a7f-475e-8b4f-5d79f044459a', 'quantite': ''}, {'ingredient_id': '432e1a93-f351-42b7-80e5-13b873263f64', 'quantite': ''}, {'ingredient_id': '83ecadfb-1e7b-4eb8-b5fa-9f3a8aa43115', 'quantite': ''}, {'ingredient_id': '6aa5bb2f-8aa2-4f1d-b3ae-5e6ec3a7ac6a', 'quantite': '2'}, {'ingredient_id': '67b304d3-3130-47f9-850a-07a8d3e2d132', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27395, 'Tuiles à la banane', 'banane, sucre, farine, beurre, lait', '10 min', ['Ecrasez la banane, y ajouter le sucre, la farine, le beurre et le lait. ', 'Etalez en de fins disques sur du papier sulfurisé et cuire 15 mn Th 5/6 en surveillant. ', 'Laissez refroidir et décollez.'], ['Batteur électrique', 'Couteau de chef', 'Balance de cuisine', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'Tuiles à la banane', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'tuiles', 'sucre', 'lait', 'cocktail'], 'Dessert', c8812ff8-d528-4565-81d3-defd3240270c, '2025-09-26T16:56:16.749408', [{'ingredient_id': '9680a15a-bea3-4966-bf55-a8133e62781b', 'quantite': '1'}, {'ingredient_id': '66ad322d-a46c-4193-ad6c-159f530bc044', 'quantite': '30 g'}, {'ingredient_id': 'b52a16e8-088a-428f-8658-2088bb37cbd9', 'quantite': '10 g'}, {'ingredient_id': 'a667e4c2-63b4-4dc3-a708-f06ff48d42ce', 'quantite': '30 g'}, {'ingredient_id': '896f0f4c-07b7-401c-8d85-a00c63e93179', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11111, 'Mille-feuille à la banane', 'pâte feuilletée, banane, citron, rhum, crème fraîche, sucre, crème fraîche, carré frais, sucre, sucre glace, chocolat', '60 min', ['Etaler et couper la pâte feuilleté en 12 rectangle similaires, les dorer au jaune d''oeuf.', 'Les faire cuire au four à 200°C (thermostat 6-7) pendant 15-20 minutes.', 'Cuire le sucre en caramel, quand le sucre brunit, rajouter le rhum puis la crème fraiche hors feu.', 'Rajouter les bananes, faire cuire à feu doux 1 min en remuant délicatement les bananes.', 'Fouetter la crème fraîche, y rajouter délicatement le carré frais.', 'Sur les assiettes, déposer un rectangle de pâte feuilleté, mettre un peu de crème des bananes sans jus, refaire cela deux fois encore par assiette.', 'Autour du mille feuille, mettre un peu de jus, le saupoudrer de sucre glace et râper un peu de chocolat dessus.', 'Recommencer pour chaque assiette.', 'Bon appétit à vous.'], ['Moule à tarte', 'Verre doseur', 'Casserole'], ['boisson', 'bon marché', 'entrée', 'mille-feuille', 'Mille-feuille à la banane', 'recettes de cuisine', 'plat', 'dessert', 'confiserie', 'recette', 'testées', 'plat de résistance', 'cocktail', 'pâte feuilletée', 'cuisine', 'recettes', 'facile'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:56:20.415974', [{'ingredient_id': '39f32bc9-49d8-4b8e-9194-fa6795b4f57d', 'quantite': ''}, {'ingredient_id': '62ac8114-4e03-4b03-8116-611ea4a08f94', 'quantite': '4'}, {'ingredient_id': 'f107a555-f353-4f49-b4cf-2eec12f67832', 'quantite': '1'}, {'ingredient_id': '9f9c5160-a484-458b-afa2-931a18b86de0', 'quantite': '2 cl'}, {'ingredient_id': 'e01bb17e-9c5d-4169-99b1-650425de31bd', 'quantite': '25 cl'}, {'ingredient_id': 'bdd9df47-d649-4759-abb2-2f275ffa4d1e', 'quantite': '100 g'}, {'ingredient_id': '72a96754-a801-49b4-96be-b41de8ab1725', 'quantite': '25 cl'}, {'ingredient_id': '84fe8e98-cf4c-4692-ae2a-7e9090efa814', 'quantite': '200 g'}, {'ingredient_id': '6da89e83-67c7-4178-ac3b-a5a9960eb191', 'quantite': '50 g'}, {'ingredient_id': 'd89af8dd-ba26-4be0-ab20-baaf90cf5183', 'quantite': '10 g'}, {'ingredient_id': '9fc88aeb-6fcf-42ee-9c16-0a11cc7c7af2', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (53173, 'English trifle banane-chocolat', 'chocolat pâtissier, oeuf, sucre, crème de marrons, banane', '20 min', ['Faire fondre le chocolat au bain-marie.', 'Hors du feu, ajouter les 4 jaunes d''œuf et le sucre.', 'Incorporer les blancs montés en neige.', 'Au fond de 4 coupelles, répartir la banane coupée en rondelles.', 'Recouvrir d''une cuillère de crème de marrons.', 'Enfin, terminer le dressage par une grosse couche de mousse au chocolat.', 'Entreposer au réfrigérateur pendant 3 heures.'], ['Spatule', 'Fouet'], ['', 'crème de marrons', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'rapide', 'oeuf', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'English trifle banane-chocolat', 'dessert', 'plat de résistance', 'moyen', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:56:24.045044', [{'ingredient_id': 'e97c9227-4310-46b3-b5e7-f3257caf68bb', 'quantite': '100 g'}, {'ingredient_id': '6a9d9c3a-604c-4133-abd7-c4b633de024c', 'quantite': '4'}, {'ingredient_id': 'e501f612-0a8f-4269-844e-b2977fccc7bb', 'quantite': '3 cuillères'}, {'ingredient_id': '92cb8df7-a530-495d-82f8-37c51eac4c86', 'quantite': '100 g'}, {'ingredient_id': '8bc62698-e398-44ac-82b2-abf00936fc47', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (229684, 'Smoothie tropical (mangue-banane)', 'mangue, banane, sucre, lait de coco', '15 min', ['Peler la peau des mangues et mettez leurs chairs et leur jus dans le mixeur en jetant les noyaux. ', 'Ajouter tous les autre ingrédients dans le mixeur.', 'Maintenant mixer ! Votre smoothie est enfin arrivé. Servir avec des glaçons.', 'Bonne dégustation ! '], ['Fouet', 'Pince de cuisine', 'Verre doseur', 'Louche', 'Spatule'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'mangue', 'Smoothie tropical (mangue-banane)', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:56:27.683298', [{'ingredient_id': '40d52bfb-8d0d-4618-83ef-0368eec9ec3b', 'quantite': '2'}, {'ingredient_id': '55d72a0b-1d1b-46cf-a237-33ffdb386975', 'quantite': '2'}, {'ingredient_id': '213ef326-f2e1-405a-925b-357b3eadd816', 'quantite': '70 g'}, {'ingredient_id': '5ef94ab0-fdaa-453c-a38d-071632ce2b63', 'quantite': '15 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31986, 'Bricks fondantes au chocolat', 'brick, banane, poire, chocolat, beurre tendre', '10 min', ['Coupez les feuilles de brick rondes en 2, et beurrez-les sur la totalité.', 'Coupez la banane en rondelles, positionnez ces dernières en triangle sur un bord du demi cercle de chaque brick, et pliez.', 'Posez 2 carrés de chocolat à la suite, pliez.', 'Pelez la poire, coupez la en lamelles et mettez ces dernières à la suite.', 'Pliez au maximum la feuille de brick en triangle; si besoin, ajoutez du beurre.', 'Positionnez ces 4 triangles dans un plat à tarte (le bord de "fermeture" doit se trouver en-dessous).', 'Enfourner à 220°C (th 7-8) pendant 5 min, la brick doit être dorée et le chocolat fondu.'], ['Pince de cuisine', 'Tire-bouchon', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'beurre tendre', 'chocolat', 'Bricks fondantes au chocolat', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:56:32.405175', [{'ingredient_id': 'ec5b9f1b-fe77-4fe5-99e9-bdb9dd691c92', 'quantite': '2'}, {'ingredient_id': 'ca3d503e-3c11-41f3-b6db-131420db6d94', 'quantite': '1'}, {'ingredient_id': 'e4147de4-04ac-413a-8be4-beed44d8c2e9', 'quantite': '1'}, {'ingredient_id': '680c0213-4cfb-42d3-a8d0-5ed456ab5bdd', 'quantite': '8'}, {'ingredient_id': '01dc37b1-762f-4d1d-9078-793dd1df53d9', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72425, 'Cheesecake banofee', 'petit beurre, beurre, mascarpone, yaourt nature, crème liquide, sucre roux, banane, sauce chocolat', '30 min', ['Emiettez les biscuits. Faites fondre le beurre. Mélangez les miettes de biscuit au beurre. Etalez sur une assiette plate ou un dans un moule rond à fond amovible (la pâte doit faire environ 1 cm de haut).', 'Mettez l''assiette au frais pendant que vous préparez la garniture.', 'Mélangez le mascarpone, le yaourt et le sucre jusqu''à obtenir une pâte lisse. Fouettez la crème, puis mélangez-la au mascarpone.', 'Coupez une banane en tout petits morceaux et mélangez à la garniture.', 'Incoporez un peu de sauce chocolat (4 cuillers à café), mélangez doucement pour obtenir un effet marbré.', 'Etalez le mélange sur les biscuits. Recouvrez de tranches de bananes. Réservez au frais jusqu''au service'], ['Râpe', 'Casserole', 'Planche à découper', 'Poêle', 'Ouvre-boîte'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'Cheesecake banofee', 'recettes', 'boisson', 'dessert', 'cheesecake', 'plat de résistance', 'beurre', 'petit beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:56:37.261235', [{'ingredient_id': 'd3a5edec-059b-4c63-92aa-bdec88f40e17', 'quantite': '275 g'}, {'ingredient_id': '1733659a-72ce-4084-a43c-42dd930a1296', 'quantite': '100 g'}, {'ingredient_id': '6a621880-8b5d-4ba1-818b-18bd24955e8a', 'quantite': '200 g'}, {'ingredient_id': '8d27d579-1a65-4e1e-83c3-54b9dc8148e2', 'quantite': '175 g'}, {'ingredient_id': '47aba61d-e5e5-46a1-9264-b5d9a39ded33', 'quantite': '10 cl'}, {'ingredient_id': 'c7d88ff2-68e8-4b7e-89a5-ea335ed008d1', 'quantite': '50 g'}, {'ingredient_id': 'b2c0dbf8-146b-401c-9cd5-4624bee932f5', 'quantite': '2'}, {'ingredient_id': 'af619a14-3e55-4762-bffe-c59e23223c57', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (47675, 'Quiche aux fruits', 'pâte brisée, pomme, poire, banane, sucre, crème fraîche, amandes, raisins secs, oeuf, lait', '20 min', ['Installez la pâte brisée dans un moule à tarte simple sur une feuille de cuisson puis piquez la pâte à l''aide d''une fourchette.', 'Epluchez les pommes, les poires et les bananes puis coupez-les en petits morceaux.', 'Disposez les fruits dans une poêle sur une feuille de cuisson, faites dorer.', 'Disposez les fruits sur la pâte brisée.', 'Dans un saladier, mélanger les oeufs, le sucre, les raisins,l''amande en poudre, la crème fraîche et le lait.', 'Versez la préparation sur les fruits.', 'Faites cuire 30 minutes, au four à 180°C (thermostat 6).', 'Laissez refroidir. Et voila! Dégustez!'], ['Spatule', 'Couteau de chef', 'Presse-agrumes'], ['', 'amandes', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'poire', 'facile', 'oeuf', 'plat', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'raisins secs', 'sucre', 'lait', 'cocktail', 'Quiche aux fruits'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:56:40.874041', [{'ingredient_id': 'cf959ced-4ae9-40a7-a613-d77410c4c73a', 'quantite': '1'}, {'ingredient_id': '808a0397-bc48-45b7-b4ed-51c67ac3d060', 'quantite': '2'}, {'ingredient_id': 'c53e090f-4183-407b-b9c2-755b3637ca85', 'quantite': '2'}, {'ingredient_id': '06772ce2-80bf-45a1-8711-2c4a1e90380d', 'quantite': '2'}, {'ingredient_id': '1ef35713-687c-48a0-beee-57f9e3334e83', 'quantite': '1 cuillères'}, {'ingredient_id': 'e37439d4-8c64-4503-8829-d5564d0ab83e', 'quantite': '3 cuillères'}, {'ingredient_id': 'd77a4106-53e0-436e-945b-0c915bd707ff', 'quantite': '30 g'}, {'ingredient_id': '1922c12a-222a-49a9-b0fb-0a48424a452d', 'quantite': '1 cuillères'}, {'ingredient_id': 'c97091e8-a7a7-4ee9-ba52-a9902e1e4d2a', 'quantite': '3'}, {'ingredient_id': 'db442c38-7734-4427-bdc1-2e1ca888c211', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (80171, 'Smoothie banane-fraise', 'banane, fraises, fromage blanc', '5 min', ['Mettre tous les ingrédients dans le bol d''un mixer et en avant pour 3 min, le temps de réveiller les enfants!', 'Verser dans de joli mugs et servir avec une paille. Les ados adorent au petit déj!', 'On peut ajouter des cornflakes.'], ['Fouet', 'Passoire', 'Pince de cuisine', 'Moule à tarte', 'Poêle'], ['', 'entrée', 'banane', 'Smoothie banane-fraise', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:56:44.464504', [{'ingredient_id': 'cec4f544-6dd5-4f64-9502-67cb368bde10', 'quantite': '2'}, {'ingredient_id': '8838a005-997b-494a-a301-164d09e1754c', 'quantite': '15 cl'}, {'ingredient_id': '1e278561-93a4-44f9-8820-647bbc2a3025', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43482, 'Filet mignon au lait de coco', 'filet mignon, oignon, ail, banane, citron, gingembre, curry, brique, bouillon de boeuf, huile, poivre, sel', '10 min', ['Faire revenir dans une cocotte, la viande avec l''huile. ', 'Ajouter l''oignon et l''ail, mélanger, et laisser dorer 5 min. ', 'Verser ensuite le bouillon, le lait de coco, le gingembre et le curry. ', 'Assaisonner de poivre et de sel, couvrir et faire mijoter 45 min à feu doux.', 'Quand c''est presque prêt, faire fondre un peu de beurre dans une poêle. ', 'Couper les bananes dans le sens de la longueur, les arroser du jus de citron, et les faire cuire environ 5 min.', 'Servir le tout bien chaud, avec du riz basmati ou un gratin de patates douces...'], ['Poêle', 'Économe'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'bouillon de boeuf', 'Filet mignon au lait de coco', 'oignon', 'huile', 'boisson', 'dessert', 'plat de résistance', 'filet mignon', 'moyen', 'citron', 'poivre', 'curry', 'brique', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:56:49.014951', [{'ingredient_id': '6b2f2743-d962-47db-93e2-fab28282dbf7', 'quantite': '600 g'}, {'ingredient_id': '466b859d-3351-4470-93aa-01323b1b0149', 'quantite': '2'}, {'ingredient_id': '8c429307-9b61-4f7c-9187-f891661ce068', 'quantite': '2'}, {'ingredient_id': 'b5969d29-e2a1-475e-a0d1-36763f1b2912', 'quantite': '4'}, {'ingredient_id': 'c2f98d12-e0e7-4ad1-bd61-f631320cad2e', 'quantite': ''}, {'ingredient_id': '50038f41-c358-481e-9fb0-1998900d4fbc', 'quantite': '60 g'}, {'ingredient_id': '7b246492-0309-465b-9115-942a82fd126b', 'quantite': '1 cuillères'}, {'ingredient_id': 'ba5d61ba-7975-428d-8c49-025e2ed74cca', 'quantite': '1'}, {'ingredient_id': '95943cb0-4545-4251-ab64-277f8cf0e400', 'quantite': '1'}, {'ingredient_id': '877f3caf-8a29-4603-bc94-e9b57b09998d', 'quantite': '2 cuillères'}, {'ingredient_id': 'bd1ff799-b90b-48a6-b193-c48624770b5f', 'quantite': ''}, {'ingredient_id': 'dcc351b9-ad75-4a9d-862e-fd84b175d6d4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166488, 'Tiramisu coco aux fruits', 'mangue, banane, ananas, framboises, sucre, biscuits à la cuillère, fruits exotiques, jaune d''oeuf, sucre, mascarpone, lait de coco, noix de coco, crème liquide', '40 min', ['1) épluchez et découpez les fruits en petits cubes en retirant le coeur de l''ananas et mélangez-les dans un saladier (pas la peine de citronner, l''acidité de l''ananas empechera les autres fruits de noircir).', '2) écrasez les framboises avec le sucre à la fourchette pour obtenir un coulis. (en garder éventuellement quelques unes entières pour la déco)', '3) Battez au fouet les jaunes d''oeufs avec le sucre jusqu''à ce que le mélange blanchisse.', '4) Avec le fouet, battez le mascarpone avec la poudre de noix de coco et ajoutez le lait de coco.', '5) Mélangez doucement la préparation de jaunes d''oeufs et celle de mascarpone.', '6) Montez la crème liquide en chantilly.', '7) Incorporez cette chantilly petit à petit et délicatement à la crème mascarpone-coco.', '8) Trempez les biscuits dans le jus de fruits en les retournant pour bien les imbiber puis égouttez les.', '9) Versez le coulis de framboises dans le fond d''un grand verre, y ajoutez une couche de crème puis les biscuits coupés en deux (3 biscuits par verre), les cubes de fruits et une nouvelle couche de crème.', '10) Avec le dos de la cuillère, lissez la crème au ras du verre. Posez ensuite quelques framboises dessus et placez le tout au réfrigérateur jusqu''au moment de servir.'], ['Moule à tarte', 'Pince de cuisine', 'Passoire', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'biscuits à la cuillère', 'facile', 'framboises', 'rapide', 'plat', 'mangue', 'fruits exotiques', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'tiramisu', 'moyen', 'ananas', 'sucre', 'Tiramisu coco aux fruits', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:56:52.651212', [{'ingredient_id': '8a6fb83c-80a5-458b-b950-c0b7d83adf0d', 'quantite': '1'}, {'ingredient_id': 'acacf604-9bc2-4e57-9a46-defaa84e242e', 'quantite': '2'}, {'ingredient_id': 'aaa8cc46-3f0a-4b38-9c77-897572ef354b', 'quantite': '2'}, {'ingredient_id': 'c763ec8f-7fb0-4c3f-866f-17cd5d52fc4f', 'quantite': '2'}, {'ingredient_id': '641fc582-f519-4974-b9a4-e87437231516', 'quantite': '20 g'}, {'ingredient_id': 'd164a1d7-4473-4951-be7a-debaf37a9931', 'quantite': '12'}, {'ingredient_id': '44c89b2a-88e0-4651-81c0-67d5e2bd5340', 'quantite': '60 cl'}, {'ingredient_id': 'fa440ac7-bc6e-4f8e-9b9a-49ecb0d9d387', 'quantite': '2'}, {'ingredient_id': '54aa8ad4-c687-45f8-88b9-da86eeb621cc', 'quantite': '50 g'}, {'ingredient_id': 'beae4731-b257-413a-83f3-3f4c8a81140e', 'quantite': '200 g'}, {'ingredient_id': 'fee77ad9-6199-4ff0-a4a5-b12f2937ae3d', 'quantite': '50 g'}, {'ingredient_id': '7fa14d6d-f1f1-4145-a499-ea57a4ade71b', 'quantite': '50 g'}, {'ingredient_id': '2cbcbdcc-198d-482d-8d88-20e49c1bac6f', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11063, 'Confiture de banane', 'banane, pamplemousse, sucre, rhum vieux', '15 min', ['Peler les bananes et les arroser de jus de citron et mixer l''ensemble.', 'Dans une bassine, mettre la purée de banane, le jus de pamplemousse, le sucre et verser dessus 20 cl d''eau. Porter à ébullition.', 'Remuer pendant la cuisson. Tester la consistance. Ecumer, mettre le rhum vieux et mettre en pot.'], ['Poêle', 'Fouet', 'Planche à découper', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'rhum vieux', 'testées', 'Confiture de banane', 'rapide', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pamplemousse', 'moyen', 'sucre', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:56:56.201698', [{'ingredient_id': '878cb008-bfce-4199-982c-59950829bc2e', 'quantite': '1 kg'}, {'ingredient_id': '35897fae-bcb3-4984-a483-af9b9fa94afa', 'quantite': '1'}, {'ingredient_id': '4f93ae0e-b2b6-492e-9f05-dbd7e0e1e61a', 'quantite': '1 kg'}, {'ingredient_id': 'f4de762a-5c82-4ac8-8dc5-700f566254f6', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (229388, 'Muffins des îles de Carole', 'noix de coco rapée, sucre roux, farine, levure chimique, oeuf, banane, raisins secs, rhum, extrait de vanille, lait', '15 min', ['Faites gonfler les raisins dans le rhum et le sucre roux pendant 1h. ', 'Au bout de ce temps, préchauffez le four à 190°C (thermostat 6-7). ', 'Dans un plat, mélangez la farine, la noix de coco, les raisins, les oeufs entiers, le lait et la levure. Ajoutez quelques gouttes d''extrait de vanille et la banane coupée en rondelles. Ne pas trop mélanger.', 'Répartissez cette préparation dans les moules et enfournez pendant 12 à 15 min. Les muffins sont cuits quand une pointe de couteau passée à travers en ressort sèche.'], ['Passoire', 'Tire-bouchon', 'Fouet', 'Rouleau à pâtisserie', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'Muffins des îles de Carole', 'testées', 'levure chimique', 'extrait de vanille', 'facile', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'noix de coco rapée', 'dessert', 'plat de résistance', 'moyen', 'muffin', 'raisins secs', 'lait', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:57:02.073484', [{'ingredient_id': 'c2fec95e-1622-4f56-9181-f928fe4190fb', 'quantite': '100 g'}, {'ingredient_id': '585e5cd1-d108-456e-83e3-2b1cfd20fe8f', 'quantite': '100 g'}, {'ingredient_id': '61e10854-e007-419c-b2ff-f41b0f577aea', 'quantite': '175 g'}, {'ingredient_id': 'f8596a30-fae8-4e09-94bb-f7421667222d', 'quantite': ''}, {'ingredient_id': 'b9e45965-167b-4bbc-b717-c7fb7452a47f', 'quantite': '2'}, {'ingredient_id': '70d9a1ac-b401-4898-b496-ddc2f56709be', 'quantite': '1'}, {'ingredient_id': '909580f3-b8ea-4266-a2f1-23ab4fdede4c', 'quantite': '3 cuillères'}, {'ingredient_id': '78b899e8-4c69-419c-bc37-05fe966b6eb7', 'quantite': '8 cl'}, {'ingredient_id': '49fb0f6d-3d0f-4605-99b4-78254ba5b15d', 'quantite': ''}, {'ingredient_id': 'eafc315b-e1d4-4792-806c-3640f380d43d', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26566, 'Crêpes à la banane flambées', 'banane, crêpe, beurre, sucre en poudre, rhum', '15 min', ['Retirez la peau des bananes. Coupez-les en deux dans le sens de la longueur. Faites-les dorer dans le beurre bien chaud. Saupoudrez de la moitié du sucre et laissez-les caraméliser légèrement. ', 'Enroulez chaque demi-banane dans une crêpe.', 'Disposez les crêpes sur un plat qui ne craint pas la chaleur et saupoudrez du reste de sucre.', 'Faites chauffer le rhum et arrosez-en les crêpes. Flamber aussitôt.'], ['Verre doseur', 'Tire-bouchon', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'crêpe', 'dessert', 'plat de résistance', 'crêpes sucrées', 'moyen', 'beurre', 'cocktail', 'Crêpes à la banane flambées'], 'Dessert', 1e143b2b-93a7-46ff-9da5-5f33b34966e3, '2025-09-26T16:57:05.619992', [{'ingredient_id': 'cd35cd3c-5082-476f-bca7-45f8ee9e29f8', 'quantite': '6'}, {'ingredient_id': 'd29de010-2765-4e50-a2bb-41b14b6bad2e', 'quantite': '12'}, {'ingredient_id': '235f0a54-54df-492a-b0df-e408f7450f7a', 'quantite': '50 g'}, {'ingredient_id': 'ec03cc53-a085-47fd-afaa-ed044f6d0360', 'quantite': '100 g'}, {'ingredient_id': '1e7f8d6c-3ca5-49ef-aacf-5669fbda2dd0', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (311492, 'Caramel à la banane', 'sucre, chocolat blanc, beurre, banane, crème fraîche', '15 min', ['Faire cuire 150 g de sucre jusqu’à ce qu''il devienne liquide et qu''il ait une belle couleur ambrée.', 'Hors du feu ajouter la crème mélanger et remettre sur feu moyen pour faire bien fondre.', 'Ajouter le beurre et le chocolat blanc et incorporer hors du feu.', 'Ajouter la banane mixée au préalable.', 'Réserver au frais avant d''utiliser pour vos pâtisseries (très bon pour les macarons et les tartelettes).'], ['Poêle', 'Spatule', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'Caramel à la banane', 'caramel', 'bon marché', 'rapide', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'chocolat blanc', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:57:10.111053', [{'ingredient_id': 'af831484-46a5-4d4c-9948-a8b0a3a0e271', 'quantite': '150 g'}, {'ingredient_id': '3d152fd9-17e5-4550-8ce1-b18759056830', 'quantite': '100 g'}, {'ingredient_id': 'a6d38932-24a1-4f33-8200-552d8012f2ea', 'quantite': '50 g'}, {'ingredient_id': '89de04f7-854b-40e6-af01-ed2faf47967a', 'quantite': '1'}, {'ingredient_id': '17bbd8ac-dfcc-4397-b336-920afa199914', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (217149, 'Poulet en feuilles de bananier', 'blanc de poulet, feuille de bananier, ail, soja, miel liquide, lait de coco, sésame', '15 min', ['Peler et écraser les gousses d’ail.', 'Les mettre dans un saladier avec la sauce de soja, le miel et le lait de coco. Bien mélanger.', 'Coupez les blancs de poulet en deux, les mettre dans la marinade et mélanger de nouveau.', 'Couvrir d’un film alimentaire et réserver au frais 1 h.', 'Nettoyer les feuilles de bananier avec un linge humide.', 'Les couper en bande et les mettre à ramollir dans de l’eau chaude.', 'Préchauffer le four à 220ºC (thermostat 7-8).', 'Égoutter les blancs de poulet.', 'Poser chaque morceau de poulet sur une bande de feuille de bananier.', 'Plier la feuille de bananier pour couvrir le poulet et la fermer avec du raphia trempé dans de l’eau froide (pour lui éviter de bruler).', 'Déposer ces petits paquets dans un plat à four.', 'Faire cuire 25 min au four en les retournant et en les arrosant régulièrement avec le jus de la marinade.', 'En fin de cuisson, parsemer de graines de sésame.', 'Servir bien chaud accompagné de riz thaï.'], ['Économe', 'Casserole'], ['', 'miel liquide', 'lait de coco', 'entrée', 'recettes de cuisine', 'sésame', 'soja', 'confiserie', 'testées', 'facile', 'bon marché', 'ail', 'plat', 'blanc de poulet', 'Poulet en feuilles de bananier', 'feuille de bananier', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Plat principal', b5e3c001-0ecd-4a3f-aae4-36b3536231ff, '2025-09-26T16:57:15.441124', [{'ingredient_id': '28ab826a-5d2a-4e49-9a48-78bbdde4bd9f', 'quantite': '4'}, {'ingredient_id': '9a5bf24a-37e9-470d-82ce-07b8a853e91c', 'quantite': '1'}, {'ingredient_id': '10e5171b-781c-406c-be9b-8b3c01a84e1c', 'quantite': '3'}, {'ingredient_id': '090a0a60-be85-444c-870d-13bdcad765ef', 'quantite': '5 cuillères'}, {'ingredient_id': '7665e770-ccbf-44a3-bb4f-51ef9e2c482c', 'quantite': '3 cuillères'}, {'ingredient_id': 'e0eda374-cb86-4c98-b73b-1f34348d26d4', 'quantite': '20 cl'}, {'ingredient_id': 'b74f1e9f-fcda-4493-a5dc-e55436419697', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28744, 'Amok à la cambodgienne', 'poisson, citronnelle, échalote, petit piment, galanga, feuille de citronnier, épinards, chou chinois, basilic, nuoc mam, poivre, lait de coco, feuille de bananier, cacahuète grillée', '15 min', ['Couper le poisson en dés, saler avec 2 cuillères à soupe de nuoc mam (praoc mam au Cambodge), poivrer, réserver puis mixer: citronelle, galanga, échalote, feuilles de citronnier le plus fin possible (en Asie, on pile au mortier) et mélanger au lait de coco (utiliser la partie crémeuse). ', 'Préparer la papillote ou plusieurs individuelles, au fond : feuilles d''épinard, chou, batavia ou les 3 puis cacahuètes hachées poisson et verser le lait + aromates ; parsemer de filets de piment et de basilic, refermer bien hermétiquement', 'Cuisson vapeur 30 mn.'], ['Couteau de chef', 'Moule à tarte'], ['', 'lait de coco', 'entrée', 'recettes de cuisine', 'confiserie', 'petit piment', 'testées', 'facile', 'chou chinois', 'plat', 'basilic', 'épinards', 'feuille de bananier', 'recette', 'galanga', 'cuisine', 'recettes', 'boisson', 'poisson', 'nuoc mam', 'citronnelle', 'dessert', 'plat de résistance', 'moyen', 'Amok à la cambodgienne', 'poivre', 'feuille de citronnier', 'cocktail', 'échalote', 'cacahuète grillée'], 'Plat principal', 614a0887-ca9b-449b-861c-b0b227f79d74, '2025-09-26T16:57:19.199105', [{'ingredient_id': '5517bc0f-ecec-408a-8e80-f61f85e07297', 'quantite': '600 g'}, {'ingredient_id': 'de6df4bc-0080-40cc-90c9-bc160df8aa44', 'quantite': '1'}, {'ingredient_id': '49985f59-5de2-46f4-82bb-f86346d9f377', 'quantite': '1'}, {'ingredient_id': '8ae50643-98a1-4424-9bcd-414ddde3b33f', 'quantite': '1'}, {'ingredient_id': '4656997e-afc8-4b96-bed2-20e15d514cdb', 'quantite': '1'}, {'ingredient_id': '6087d7a0-f50f-4c1d-9280-d377982eae42', 'quantite': ''}, {'ingredient_id': 'a852f71b-f670-4fd7-b6d8-8edac70a103f', 'quantite': ''}, {'ingredient_id': 'e75a262a-7a65-4d8c-96f4-5661fb891ce3', 'quantite': ''}, {'ingredient_id': '0063912f-aa54-4aa9-accd-69cf7488bd13', 'quantite': ''}, {'ingredient_id': '545e79b5-a6ff-45aa-ba1a-13573b0c145b', 'quantite': ''}, {'ingredient_id': 'b39d34d8-1040-4e6e-b82a-a7e257386f57', 'quantite': ''}, {'ingredient_id': 'dadbc22e-557b-4d9c-b51e-d8d1e5747d19', 'quantite': '1'}, {'ingredient_id': 'a2481e60-1bcd-4d35-a4d6-64c00b6da6de', 'quantite': ''}, {'ingredient_id': '75e75d60-cbd7-449b-b1f9-d323a10d8b02', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (334118, 'Banana split à la glace au chocolat', 'chocolat noir, chocolat au lait, lait, sucre, crème liquide, crème liquide, banane, chocolat', '40 min', ['Casser le chocolat en morceaux et faire fondre au bain-marie. Verser le lait et le sucre dans le chocolat fondu et lisser le mélange avec une spatule. Retirer du bain-marie et laisser refroidir.', 'Monter la crème en chantilly et l''incorporer au chocolat. Faire prendre dans une turbine à glace ou verser dans un récipient adapté, en acier inoxydable de préférence, et placer au congélateur pendant 6 heures. Au bout d''environ 1 heure de congélation, mixer la glace à l''aide du mixeur plongeant, puis la remettre au congélateur. ', 'Pour le service, monter la crème liquide en chantilly. Peler les bananes et les couper en deux dans le sens de la longueur. Disposer sur des assiettes ovales les demis-bananes avec des boules de glace au chocolat. Garnir largement de crème fouettée et de sauce au chocolat.'], ['Batteur électrique', 'Couteau de chef', 'Économe', 'Râpe'], ['chocolat au lait', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'banana split', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'Banana split à la glace au chocolat', 'dessert', 'plat de résistance', 'chocolat noir', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:57:23.830873', [{'ingredient_id': '3a4e65a8-5a0f-4a71-9586-3a7b45878b9f', 'quantite': '75 g'}, {'ingredient_id': 'd94417ec-8e46-4b98-b00c-8bcec5fb3b40', 'quantite': '75 g'}, {'ingredient_id': '122a11b7-7532-45d4-b36d-2a664d0e9c9b', 'quantite': '17.5 cl'}, {'ingredient_id': 'ddb2aefb-2fdf-49b6-bd20-36fc877b2392', 'quantite': '100 g'}, {'ingredient_id': '4632ea5c-4b16-4967-b4ca-868631ce17db', 'quantite': '40 cl'}, {'ingredient_id': '91f21ca3-8512-44be-a7d6-2f496428e56f', 'quantite': '20 cl'}, {'ingredient_id': '4a190dda-3ab0-4df1-ac21-6ca61b8ae784', 'quantite': '2'}, {'ingredient_id': 'c116da83-b1bb-4722-bb55-0c14ef4fe878', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27464, 'Salade oranges / banane', 'banane, orange, sucre roux, baie moulu, citron vert, cannelle', '20 min', ['Eplucher les oranges et les bananes. Couper les quartiers d''orange en 3 ou 4 selon la grosseur et couper la banane en rondelle. ', 'Mettre dans un saladier. ', 'Saupoudrer de sucre roux, un peu de cannelle et des 5 baies moulues. Arroser copieusement du jus de citron vert. ', 'Remuer. ', 'Mettre au frais au moins une heure.'], ['Ouvre-boîte', 'Balance de cuisine', 'Rouleau à pâtisserie', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Salade oranges / banane', 'baie moulu', 'orange', 'citron vert', 'cannelle', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:57:27.246806', [{'ingredient_id': '0ee1a86d-92e1-4346-886b-d4c87e5ae25a', 'quantite': '2'}, {'ingredient_id': 'fad2dfd0-2cf9-4a5b-97a2-51b8ca463fc3', 'quantite': '2'}, {'ingredient_id': '185cb30e-8012-4e3c-b3f2-cfabe0fdff8f', 'quantite': ''}, {'ingredient_id': '9dd385ad-98ad-4eb8-85d7-8df9f65199b1', 'quantite': '5'}, {'ingredient_id': 'a4f6f3d5-6440-43dc-a837-84c7b2309edd', 'quantite': '1'}, {'ingredient_id': '60a29cf4-21c7-4b5e-b7ce-4cdde8261db4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61373, 'Clafoutis banane chocolat (par Darling)', 'farine, levure chimique, oeuf, lait, banane, chocolat pâtissier, beurre', '15 min', ['Mettre le four à chauffer à 200°C (thermostat 6-7).', 'Beurrer un moule à tarte, y ajouter les bananes coupées en rondelles de 1,5 cm environ.', 'Dans un saladier, faire un puits avec la farine, incorporer la levure et les oeufs. Bien mélanger.', 'Ajouter progressivement 40 cl de lait à la préparation pour éviter les grumeaux.', 'Faire fondre le chocolat à feu doux avec 10 cl de lait. Ajouter le mélange à la préparation précédante.', 'Verser sur les bananes. ', 'Laisser au four pendant 30 min à 200°C (thermostat 6-7).', 'Peut se déguster tiède ou froid, seul ou accompagné de glace ou de crème anglaise.', 'Pour la déco : ajouter du sucre glace ou des copeaux de noix de coco dessus.', 'Bon appétit !'], ['Balance de cuisine', 'Verre doseur', 'Poêle', 'Planche à découper', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'Clafoutis banane chocolat (par Darling)', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'clafoutis', 'beurre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:57:30.861630', [{'ingredient_id': '72de6cab-815f-43a1-8993-8ce96c8a0170', 'quantite': '250 g'}, {'ingredient_id': '8057094c-3045-4353-b4d4-419b20730a5f', 'quantite': '1'}, {'ingredient_id': '5f82b978-b447-4a77-94c8-9182658b9fe0', 'quantite': '3'}, {'ingredient_id': 'a31e974c-e11c-4d68-92a6-3a0aafb97b6e', 'quantite': '50 cl'}, {'ingredient_id': 'cb8e6a56-b1df-44a1-99cc-04e27cb7ed5b', 'quantite': '3'}, {'ingredient_id': 'aed3822e-ae95-48b0-88d5-b9659c95431e', 'quantite': '150 g'}, {'ingredient_id': '6c7feb01-d2de-4b1b-a719-4e01c820d658', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (82082, 'Curry de poulet à la noix de coco', 'cuisse de poulet, oignon, raisins secs, lait de coco, pâte de curry, huile, noix de coco rapée, pomme, mangue, banane, beurre, poivre, sel', '15 min', ['Pelez et émincez les oignons. Faites chauffer l’huile dans une cocotte et faites revenir les oignons jusqu’à ce qu’ils deviennent transparents.', 'Retirez les oignons et réservez-les. Faites dorer les cuisses de poulet, lorsqu’elles sont bien colorées, rajoutez les oignons. Ajoutez le curry, mélangez bien. Arrosez de lait de coco jusqu''à recouvrir les cuisses de poulet. Salez et poivrer. Faites cuire 1 h 15 environ. Pensez à ajouter les raisins un quart d’heure avant la fin de la cuisson.', 'Pendant la cuisson, occupez-vous des fruits : pelez-les, coupez les en lamelles épaisses. Faites les dorer dans le beurre et sur feu vif quelques instants.', 'Disposez le curry de poulet au centre d’un plat de service entouré des fruits dorés.'], ['Râpe', 'Mixeur', 'Ouvre-boîte', 'Louche'], ['pâte de curry', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'curry de poulet', 'Curry de poulet à la noix de coco', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'cuisse de poulet', 'oignon', 'boisson', 'huile', 'noix de coco rapée', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'raisins secs', 'poivre', 'cocktail'], 'Plat principal', 968dc5bb-b1e0-481e-8b1e-4306308d9f56, '2025-09-26T16:57:34.745784', [{'ingredient_id': '0d1901ee-01c4-49bc-b1d5-5f5c8b3eec6e', 'quantite': '4'}, {'ingredient_id': 'a8802893-7c60-4552-9d80-0ae045502f7c', 'quantite': '6'}, {'ingredient_id': '34838104-dce8-4215-8294-2634c4b45917', 'quantite': '120 g'}, {'ingredient_id': 'ee2b0880-d330-4310-805d-eb60ce4e4e6d', 'quantite': '20 cl'}, {'ingredient_id': '0e002c48-7b7d-46c0-94d2-45575142a0de', 'quantite': '2 cuillères'}, {'ingredient_id': '009d3254-d8ec-4ca3-a99b-e8628171a63c', 'quantite': '3 cuillères'}, {'ingredient_id': '1bcb1fba-fc4f-44eb-ade2-2dfab506b4f7', 'quantite': '2 cuillères'}, {'ingredient_id': 'd7d964ed-6f93-42c3-8b9e-4a66ca553795', 'quantite': '2'}, {'ingredient_id': 'efb31830-88c3-48c2-9943-41bc650ca964', 'quantite': '1'}, {'ingredient_id': '66c63df4-d953-465d-9040-480e8d3e75bd', 'quantite': '2'}, {'ingredient_id': '9093536d-82ae-48c6-b6bb-24b4a735b432', 'quantite': '1'}, {'ingredient_id': '26927011-5198-4c09-ba58-aeb30e63224b', 'quantite': ''}, {'ingredient_id': '41f7baf7-b4e3-4090-8d03-34fab24e7c88', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28681, 'Banana split à la tahitienne', 'glace coco, glace framboise, glace, chocolat pâtissier, framboises, banane, lait', '10 min', ['Chauffer le chocolat (dans une casserole ou au micro-ondes) avec un peu de lait pour le rendre coulant. ', 'Sortez les glaces du congélateur. ', 'Réchauffer au micro ondes les bananes coupés en 2 sur la longueur dans des coupes allongées si possible. ', 'Répartissez le chocolat chaud dans les coupes. ', 'Mettre une boule de chaque glace dans chaque coupe. ', 'Versez les framboises. ', 'Régalez-vous !'], ['Verre doseur', 'Couteau de chef', 'Spatule', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'banana split', 'très facile', 'framboises', 'bon marché', 'Banana split à la tahitienne', 'plat', 'recette', 'chocolat pâtissier', 'glace coco', 'cuisine', 'recettes', 'boisson', 'glace', 'dessert', 'plat de résistance', 'lait', 'cocktail', 'glace framboise'], 'Dessert', 38a8769b-0877-49a2-89bf-1b7fc72dc1ae, '2025-09-26T16:57:38.317933', [{'ingredient_id': '90d05b7b-9479-4ff7-b491-286ae2a814ef', 'quantite': ''}, {'ingredient_id': '3c4896d8-e236-441a-9bbf-ecc8bbadd34f', 'quantite': ''}, {'ingredient_id': '371d63a5-2976-4d26-b2cc-d2e4970a17e6', 'quantite': ''}, {'ingredient_id': '4ce6599f-db32-40a6-9457-4485c9081cf0', 'quantite': '1'}, {'ingredient_id': '8d72c45b-67a6-4006-aa01-ec1fe2da6051', 'quantite': '1'}, {'ingredient_id': 'eea31a03-3db3-4658-85cf-b1d93f2aacb3', 'quantite': '2'}, {'ingredient_id': '18ebe0be-efbe-44fa-84e7-ff9f23fb2fa1', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43080, 'Confiture framboises - pommes - bananes', 'framboises, pomme, banane, sucre', '30 min', ['Dans une bassine à confitures, cuire les pommes et les bananes coupées en morceaux, puis les écraser à l''aide d''un pilon à purée.', 'Ajouter les framboises, mélanger.', 'Ajouter le sucre, mélanger, et cuire à légère ébullition jusqu''à épaississement.', 'Verser dans des pots, et les retourner jusqu''à complet refroidissement.'], ['Verre doseur', 'Moule à tarte', 'Passoire', 'Couteau de chef', 'Mixeur'], ['entrée', 'banane', 'confiture de framboise', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'framboises', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'Confiture framboises - pommes - bananes', 'plat de résistance', 'pomme', 'sucre', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:57:41.802164', [{'ingredient_id': 'e0a03d0a-cab9-45b6-9175-e9b56f8d921f', 'quantite': '300 g'}, {'ingredient_id': 'ab43d1d4-cf8b-4776-a0e5-80726aeaa836', 'quantite': '250 g'}, {'ingredient_id': '1b2bb9f4-c247-4034-b1a1-de7e2b4f12c0', 'quantite': '250 g'}, {'ingredient_id': 'd2064720-4013-4a25-b328-bb91e4be43f6', 'quantite': '500 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72591, 'Smoothie vitaminé du petit-déjeuner', 'lait de soja, banane, kiwi, orange', '10 min', ['mettre dans un mixer les bananes coupées en morceaux et la chair des kiwis.', 'Presser les oranges et rajouter le jus dans le mixer.', 'Rajouter le lait de soja (il peut être nature ou vanillé).'], ['Moule à tarte', 'Pince de cuisine', 'Casserole', 'Planche à découper'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'Smoothie vitaminé du petit-déjeuner', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'orange', 'lait de soja', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:57:46.595687', [{'ingredient_id': '2e787435-552b-471c-9fd0-30551fec2107', 'quantite': '25 cl'}, {'ingredient_id': '5e21da79-d94d-44ed-b151-79230146cf4c', 'quantite': '2'}, {'ingredient_id': 'f3268c2f-992b-44fa-8aaf-eb3891909884', 'quantite': '4'}, {'ingredient_id': '752eb24b-2de6-4887-be69-c1513c3b37f2', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (195248, 'Salade de fruits d''hiver', 'poire, kiwi, banane, pomme, fruit de la passion, orange', '20 min', ['Épluchez et coupez les poires, la pomme, les kiwis, bananes en tous petits cubes.', 'Mélangez-les dans un saladier, ajoutez les fruits de la passion et les oranges pressées.', 'A vous d''adapter les fruits utilisés selon vos goûts, mais n''oubliez pas les fruits de la passion, ça donne une petite touche très appréciée.'], ['Balance de cuisine', 'Louche', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'Salade de fruits d''hiver', 'testées', 'poire', 'salade de fruits d''hiver', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'fruit de la passion', 'dessert', 'plat de résistance', 'pomme', 'orange', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:57:50.206579', [{'ingredient_id': 'd8d49217-db47-488d-8d63-d29deda0d8b3', 'quantite': '2'}, {'ingredient_id': 'fafbc962-f4ea-46cf-8030-104300e5cb94', 'quantite': '3'}, {'ingredient_id': '96cfbb2c-6e6e-4084-ba0f-a84e4fe926c6', 'quantite': '2'}, {'ingredient_id': 'b0414601-c66d-4332-8688-3d305d0a7877', 'quantite': '1'}, {'ingredient_id': 'de872960-cf7d-4aca-959a-a58c05a027c8', 'quantite': '2'}, {'ingredient_id': '372fca3d-382f-40bb-844d-24d57803d485', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (333649, 'Salade de fruits exotiques : kiwi, kakis, ananas et fruits de la passion', 'sucre roux, sucre vanillé, vanille, citron vert, fruit de la passion, banane, clémentine, kiwi, ananas, fraises, pomme, kaki', '60 min', ['Mettre 50 cl d''eau dans une casserole avec le sucre roux, le sucre vanillé, la gousse de vanille fendue en 2 et grattée pour récupérer les graines, le jus du citron vert et pour finir la pulpe d''un fruit de la passion.', 'Porter le tout a ébullition pendant 4 min et laisser refroidir en laissant la gousse de vanille infuser. Ne pas s''inquiéter si le sirop a l''air sucré car mélangé au jus que vont rendre les fruits cela s''adoucit.', 'Pour le reste on s''arme de patience et on découpe simplement tous les fruits en dés.', 'Je vous conseille de couper les fruits au-dessus de votre saladier pour récupérer un maximum de jus.', 'Pour une salade de fruits encore meilleure je vous conseille au niveau des fruits : la clémentine corse plus juteuse et sans pépins, l''ananas victoria, les fraises made in France (tout ceci est plus cher à l''achat mais bien meilleur). Pour les kakis, il faut qu''ils soit bien mûrs car c''est là qu''ils sont le plus sucrés.', 'Arroser les fruits de sirop et laisser infuser au moins 1 heure avant de servir.'], ['Tire-bouchon', 'Moule à tarte', 'Planche à découper', 'Ouvre-boîte', 'Économe'], ['kakis', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'ananas et fruits de la passion', 'fraises', 'recette', 'cuisine', 'kaki', 'recettes', 'boisson', 'vanille', 'fruit de la passion', 'clémentine', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'moyen', 'Salade de fruits exotiques : kiwi', 'ananas', 'citron vert', 'salade de fruits exotiques', 'cocktail', 'sucre roux'], 'Dessert', bd3defe0-6d54-4eb6-b845-6db67e3ffef9, '2025-09-26T16:57:54.946138', [{'ingredient_id': '5fbe223f-b1d5-445d-ad98-8713325bd0eb', 'quantite': '7 cuillères'}, {'ingredient_id': 'df130a07-5a3d-4e47-b77f-cc95cd0674a3', 'quantite': '1'}, {'ingredient_id': '031cc687-9f2e-4774-82a7-defd1df0378e', 'quantite': '1'}, {'ingredient_id': '92b5f8ff-7177-4271-83b1-42e454f80d18', 'quantite': '1'}, {'ingredient_id': '24c7e2a0-d65f-491e-b671-a6c7f806fc62', 'quantite': '5'}, {'ingredient_id': '3505d364-12ca-4132-8551-528f60e098ee', 'quantite': '2'}, {'ingredient_id': '60256b29-2a1d-4846-8dc9-deaac02d64e7', 'quantite': '4'}, {'ingredient_id': 'd2de1bd1-7eb8-4961-9e30-20d9dfdacb6c', 'quantite': '4'}, {'ingredient_id': '0fead121-466b-4da6-9d60-29b0b545a579', 'quantite': '1'}, {'ingredient_id': '6c136dd3-578c-436b-8974-ca2293ea8f59', 'quantite': '500 g'}, {'ingredient_id': '4c67efaa-90ec-4ad8-b489-415d47349d5d', 'quantite': '2'}, {'ingredient_id': '27b5b74a-b0b0-4c88-9ff3-08a42644e9b9', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (49045, 'Glace à la banane amande miel', 'crème anglaise, banane, miel, amandes effilées, rhum', '30 min', ['Préparer la crème anglaise à la vanille ou ouvrir la brique.', 'Mettre les amandes effilées dans une poêle et les faire griller sans huile (à sec).', 'Verser dans un saladier la crème anglaise, les bananes, le miel, le rhum (on peut mettre plus de rhum mais cela mettra plus longtemps à glacer) et les amandes grillées.', 'Mixer le tout avec un mixeur à soupe ou autre.', 'Faire  glacer dans une sorbetière, dans une machine à glace ou mettre simplement au congélateur dans un pot adapté.', 'Dans ce dernier cas, remuer de temps en temps la glace avec un fourchette pour éviter l''effet glaçon.'], ['Spatule', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'Glace à la banane amande miel', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'glace à l''italienne', 'amandes effilées', 'cocktail', 'crème anglaise'], 'Dessert', 6e29533c-0690-4492-9d42-9c4f536eda26, '2025-09-26T16:57:58.675004', [{'ingredient_id': 'd6df20f2-9320-495d-a883-c72ad1fa58f4', 'quantite': '50 cl'}, {'ingredient_id': '6fe3fd1a-ac0e-4100-b5ce-a5ddf1aee302', 'quantite': '5'}, {'ingredient_id': '6d071231-4d9c-4efb-837f-d7e3793ee8cf', 'quantite': '2 cuillères'}, {'ingredient_id': '725bd995-44af-419a-94c5-e80d0c623c32', 'quantite': '100 g'}, {'ingredient_id': '953835c7-d965-4f65-af48-7e8277980844', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392324, 'Sunrise blend', 'jus d''oranges, jus d''ananas, fraises, banane', '0 min', ['Réalisez la recette "Sunrise blend" au mixer.', 'Verser dans un mélangeur 1 tasse de glaçons, 9 cl de jus d''orange frais, 9 cl de jus d''ananas frais, 2 fraises fraîches et 1 banane. Bien mélanger pour obtenir une consistance crémeuse et passer dans un grand verre. .', 'Servir dans un verre de type "tumbler".', 'Décorer de fraises.'], ['Ouvre-boîte', 'Râpe', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'Sunrise blend', 'dessert', 'plat de résistance', 'jus d''ananas', 'moyen', 'jus d''oranges', 'cocktail'], 'Boisson', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:58:03.634563', [{'ingredient_id': 'c1b372d7-5658-4271-8e3a-f69c75190322', 'quantite': '9 cl'}, {'ingredient_id': 'e76a5a6f-131d-445a-baea-52d5202dc6c3', 'quantite': '9 cl'}, {'ingredient_id': '78bef51d-31dd-4f42-9a85-4e64fc5a6a3b', 'quantite': '2'}, {'ingredient_id': 'fcd184e5-2151-49ea-bda4-eac2759b2cc4', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23021, 'brochette de fruits pour barbecue', 'pêche, abricot, banane', '15 min', ['Il faut que la grille du barbecue soit bien nettoyée. ', 'Coupez les fruits en morceau, les enfiler sur les brochettes en bois en évitant de mettre deux morceaux d''un même fruit côte à côte.', 'Les saupoudrer de sucre roux, et passez les ensuite quelques minutes sur le barbecue pour les faire dorer.'], ['Planche à découper', 'Poêle', 'Couteau de chef', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'abricot', 'très facile', 'bon marché', 'rapide', 'brochette de fruits pour barbecue', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pêche', 'cocktail'], 'Dessert', 9d454ec6-6a1b-40f2-9c53-ed6bf0b24a8d, '2025-09-26T16:58:08.413090', [{'ingredient_id': '08a480f8-a4bb-4f66-b066-bd77b7e16d77', 'quantite': '2'}, {'ingredient_id': 'd111b5b5-b09f-4bfb-a346-045c9fc982f1', 'quantite': '4'}, {'ingredient_id': '1df59c34-f7a3-40cb-85d9-5cc87db647ab', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (310994, 'Tiramisu banane et gâteau Bastogne', 'mascarpone, oeuf, sucre, sel, banane, bastogne', '15 min', ['Mélangez les jaunes d''oeufs et le sucre jusqu''à ce que le mélange blanchisse. Incorporez délicatement le mascarpone.', 'Battez les blancs d''oeufs en neige avec une pincée de sel. ', 'Ajoutez les délicatement à la crème au mascarpone.', 'Écrasez les bastogne en petits morceaux et coupez les bananes en rondelles.', 'Dans un grand saladier, alternez les couches de Bastogne, de crème au mascarpone et de bananes, recommencez jusqu''à épuisement des ingrédients.', 'Couvrez le plat et placez au réfrigérateur au moins 2 heures.'], ['Spatule', 'Tire-bouchon', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'sel', 'confiserie', 'testées', 'Tiramisu banane et gâteau Bastogne', 'facile', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'gâteau à la banane', 'moyen', 'sucre', 'cocktail', 'bastogne'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:58:12.112920', [{'ingredient_id': 'de9b283b-c23b-4a89-a32d-ffd7026b4451', 'quantite': '250 g'}, {'ingredient_id': 'e2a53ed9-58df-46d2-a3de-a29e6189bd24', 'quantite': '4'}, {'ingredient_id': 'ec2dde6f-c4a7-4cb6-be4f-16d0e8b757eb', 'quantite': '120 g'}, {'ingredient_id': '9e915d05-5086-402c-a7cc-ca1f8decb3b8', 'quantite': '1'}, {'ingredient_id': '629d5f11-7971-4f84-a66a-3b2820408b28', 'quantite': '6'}, {'ingredient_id': 'c3ac2af7-5bbe-4b6d-a12b-65c6b19f8075', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26570, 'Riz grillé aux merguez et bananes', 'riz, merguez, banane, raisins secs, oignon, huile, cannelle, safran, gingembre, poivre, sel', '20 min', ['Faites tremper les raisins dans de l''eau tiède.', 'Pelez et émincez les oignons.', 'Découpez les bananes en tronçons.', 'Rincez le riz plusieurs fois à l''eau fraîche.', 'Faites-le cuire avec 2 fois son volume d''eau bouillante salée.', 'Faites chauffer l''huile dans une sauteuse, faites-y blondir les oignons puis ajoutez les bananes.', 'Laissez dorer puis retirez-les de la casserole ainsi que les oignons.', 'Egouttez bien le riz.', 'Faites-le revenir dans la sauteuse où sont revenus les oignons et bananes.', 'Remuez bien et ajoutez les raisins égouttés, la cannelle, le safran, le gingembre et le poivre.', 'Salez et remuez, laissez chauffer à feu vif.', 'Versez le tout dans un plat allant au four, répartissez les bananes aux oignons et les merguez piquées à la fourchette sur le tout.', 'Faites cuire sous le grill chaud environ 15 minutes (retournez les merguez à mi-cuisson) et servez.'], ['Verre doseur', 'Presse-agrumes', 'Rouleau à pâtisserie', 'Tire-bouchon'], ['gingembre', 'Riz grillé aux merguez et bananes', 'banane', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile', 'plat de riz', 'dessert', 'plat de résistance', 'riz', 'raisins secs', 'cannelle', 'poivre', 'cocktail', 'safran', 'merguez'], 'Plat principal', a36ccd86-5f6b-40cc-bbe8-03f1cbd0405c, '2025-09-26T16:58:16.915622', [{'ingredient_id': '2d66b21e-2ffb-474b-a8b2-837276453f79', 'quantite': '200 g'}, {'ingredient_id': '15d55fd3-3474-4c5d-9100-a1c19fcbe2aa', 'quantite': '8'}, {'ingredient_id': '4d373829-543d-4b39-a46e-6b60c556a3ae', 'quantite': '4'}, {'ingredient_id': '426a2d01-8d87-446a-9145-58b167b11764', 'quantite': '100 g'}, {'ingredient_id': '4cd3f7f4-b63a-414a-9e34-77acba04a709', 'quantite': '2'}, {'ingredient_id': '8606712c-e21f-4496-a4da-9ef8de1a3777', 'quantite': '10 cl'}, {'ingredient_id': 'be7dec1e-1354-4ad2-8bd1-86fda4a8a299', 'quantite': ''}, {'ingredient_id': '73d81247-f867-4933-8df1-00bd59b050cb', 'quantite': '1'}, {'ingredient_id': 'f528892e-247c-4478-bd28-c1dd8495523d', 'quantite': '1'}, {'ingredient_id': 'f13ff669-34c9-4b33-9179-239efc1bab8e', 'quantite': ''}, {'ingredient_id': '7d83c784-730a-4093-a236-00b82662c839', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72352, 'Rouget exotique', 'ail, huile d''olive, tomate, basilic, tomate, haricot, banane, noix de coco, pâte de curry, rouget, riz, cube de bouillon', '15 min', ['Emincer la gousse d''ail et la mettre à frire 1 min dans une petite casserole avec l''huile d''olive.', 'Ajouter les tomates découpées en morceaux, le basilic, le jus de tomates, les haricots, la banane coupée en tranches, la purée de noix de coco à la crème, et la pâte à curry verte.', 'Cuire à feu doux 20 min.', 'Dans une autre casserole, cuire le riz à l''eau 20 min, en ajoutant dès le départ le cube de bouillon au basilic.', 'Mettre les filets de rouget à cuire à feu doux dans une poêle (5 min de chaque côté).', 'Servir le riz et le rouget sur les assiettes, et napper de la sauce.'], ['Verre doseur', 'Casserole'], ['', 'pâte de curry', 'entrée', 'banane', 'recettes de cuisine', 'rouget', 'confiserie', 'testées', 'haricot', 'facile', 'tomate', 'ail', 'plat', 'basilic', 'recette', 'cube de bouillon', 'cuisine', 'recettes', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'riz', 'moyen', 'Rouget exotique', 'noix de coco', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:58:20.809031', [{'ingredient_id': '4001baa6-10e7-4303-bc43-ea4fe84ee4f1', 'quantite': '1'}, {'ingredient_id': 'eb8307cc-9f5a-484f-8932-dd204ff24e70', 'quantite': '2 cuillères'}, {'ingredient_id': '47240957-4461-494e-9bba-88513ff0c98b', 'quantite': '2'}, {'ingredient_id': '8bc046eb-e051-4a0b-b18e-fc4d2a2ccc77', 'quantite': '4'}, {'ingredient_id': '67c5a2fe-3f5c-4e63-b53b-0bc6a3a40c02', 'quantite': '25 cl'}, {'ingredient_id': '39d6c95a-63a2-4ab7-bdd1-3f468b48aeb6', 'quantite': '100 g'}, {'ingredient_id': 'a558dd65-856d-4839-9770-42f3efda2490', 'quantite': '1'}, {'ingredient_id': '15d76e28-adb1-461b-90ac-c3827e588a1b', 'quantite': '50 g'}, {'ingredient_id': '175e1b32-2910-4fd5-867d-8de094dea21d', 'quantite': '1'}, {'ingredient_id': '39283904-7f5b-415f-944e-ff02f2ac37a3', 'quantite': '4'}, {'ingredient_id': '7937d593-d08a-4f61-87a1-bfb5fe689b3d', 'quantite': '100 g'}, {'ingredient_id': 'e0c1bc1c-0632-48be-89d7-7bf07935bf53', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70925, 'Gâteau de crêpes chocolat-bananes à déguster sans fin !', 'crêpe, crème fraîche liquide, sucre semoule, chocolat noir, sucre glace, banane', '10 min', ['Placez vos 10 crêpes au frais pour qu''elles soient bien fraîches pour la suite.', 'Fouettez la crème au batteur jusqu''à obtention d''une crème bien onctueuse, ajoutez la cuillère à café de sucre semoule et fouettez de nouveau. Vous obtenez ainsi une crème chantilly maison.', 'Coupez 400 g de chocolat en dés et faites fondre au micro-ondes environ 1 minute (tout dépend de la puissance de votre micro-ondes et de la taille de vos morceaux de chocolat. Donc ayez toujours un oeil sur lui!)', 'Quand votre chocolat est fondu, prenez 2 cuillères de crème chantilly et mélangez la vigoureusement au chocolat pour faire baisser un peu la température de celui-ci.', 'Ensuite, versez ce mélange dans le reste de crème chantilly et mélangez doucement.', 'Ecrasez 3 bananes à la main et mélangez les à la chantilly au chocolat. Réservez un petit peu au frais le temps de couper en rondelles la banane restante.', 'Sortez les crêpes et la chantilly choco-bananes du frigo.', 'Prenez un plat un peu plus grand que le diamètre de vos crêpes et commencez à monter le gâteau : un peu de chantilly, puis une crêpe...et ainsi de suite (mettez une couche de chantilly égale partout sur la crêpe pour éviter les affaissements sur les contours par la suite!).', 'Lorsque le gâteau est prêt, faîtes fondre les 50 g de chocolat restant au micro-ondes et mélangez-le au sucre glace. Utiliser cette préparation comme glaçage.', 'Placez ensuite les rondelles de bananes en rosace sur le gâteau en décoration.', 'Placez le gâteau au frais pour que la chantilly durcisse un peu, au moins 15 minutes.', 'Régalez-vous !!!'], ['Balance de cuisine', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'Gâteau de crêpes chocolat-bananes à déguster sans fin !', 'crêpe', 'dessert', 'plat de résistance', 'chocolat noir', 'crêpes sucrées', 'moyen', 'sucre glace', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:58:24.686105', [{'ingredient_id': 'c08708d4-a43a-445f-bbf0-95ced1cbfbc6', 'quantite': '10'}, {'ingredient_id': '0924a4f3-83a6-4a5d-8815-597e6e91b1d3', 'quantite': '25 cl'}, {'ingredient_id': '62393420-5a8b-4e38-98c2-c137f7b486b1', 'quantite': '1 cuillères'}, {'ingredient_id': '6d4440f7-46a7-4558-be6c-c0d06c706422', 'quantite': '450 g'}, {'ingredient_id': 'b7a0dd68-7569-4e2d-ac63-093376107668', 'quantite': '50 g'}, {'ingredient_id': '8e86c1a9-bd85-438e-9d8e-dc7da8182e2c', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (64200, 'Pudding à ma facon', 'lait, brioche, pain au chocolat, croissant, Banania', '10 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Dans un plat, émietter toutes les viennoiseries.', 'Verser le litre de lait, mélanger.', 'Ajouter le Banania, mélanger à nouveau.', 'Laisser bien impregner. Rajouter du lait si nécessaire.', 'Verser dans un plat beurré allant au four, faire cuire entre 1 h et 1 h 15.'], ['Économe', 'Tire-bouchon', 'Presse-agrumes', 'Casserole'], ['brioche', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'Pudding à ma facon', 'très facile', 'croissant', 'plat', 'Banania', 'recette', 'cuisine', 'recettes', 'boisson', 'pudding', 'dessert', 'plat de résistance', 'moyen', 'pain au chocolat', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:58:29.994943', [{'ingredient_id': '82cd77b9-5b6a-485d-84bd-ed7a50f2c1ee', 'quantite': '1 l'}, {'ingredient_id': '600b19aa-4e65-41ef-848d-dadd3878f709', 'quantite': '4'}, {'ingredient_id': '4407b464-5659-4cc2-921e-95a516c2d4ba', 'quantite': '3'}, {'ingredient_id': '8178e4b2-ae8d-42e3-8ca9-0fc5a5711f77', 'quantite': '3'}, {'ingredient_id': '52554250-5f32-4720-ab87-c5e853e86221', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33608, 'curry de poulet banane et ananas', 'blanc de poulet, banane, ananas, lait de coco, garam masala, huile, sucre vanillé, poivre, riz thaï', '10 min', ['Découper vos blancs de poulet en lanières ; faites-les revenir dans une poêle avec un fond d''huile. ', 'Dans un wok, faites chauffer 4 cuillères à soupe d''huile (olive ou autre). ', 'Ajoutez le garam Masala ; remuez. ', 'Ajoutez les bananes coupées en rondelles et l''ananas découpé en cubes. Mélangez. ', 'Quand les fruits commencent à fondre, ajoutez le lait de coco et le sucre vanillé. Laissez mijoter en remuant de temps en temps. ', 'En fin de cuisson, ajoutez le poulet. Poivrez légèrement. laissez cuire encore 5 mn. ', 'Servez accompagné de riz basmati ou thaï.'], ['Louche', 'Mixeur', 'Passoire'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'curry de poulet', 'plat', 'blanc de poulet', 'recette', 'cuisine', 'curry de poulet banane et ananas', 'recettes', 'boisson', 'huile', 'dessert', 'plat de résistance', 'sucre vanillé', 'moyen', 'ananas', 'poivre', 'garam masala', 'cocktail'], 'Plat principal', 122749ad-fa47-477e-8121-2f4ecd605861, '2025-09-26T16:58:33.623694', [{'ingredient_id': '23ae0b42-a888-415a-b835-27cbc293897b', 'quantite': '4'}, {'ingredient_id': '0b2a10b3-7f93-4f95-88a3-74bc8c652cca', 'quantite': '5'}, {'ingredient_id': '61e3f642-3010-4b79-8bf8-94c8aedf61c4', 'quantite': '1'}, {'ingredient_id': '9dde016a-7f07-4c17-a754-bcd1194a320e', 'quantite': '500 ml'}, {'ingredient_id': 'dc2102fd-fd07-4280-aec0-4170b4e1f7c8', 'quantite': '2 cuillères'}, {'ingredient_id': '5dd705ce-a71b-46fa-8cbc-d5c854f2f9c4', 'quantite': ''}, {'ingredient_id': 'ed505533-8f1f-4e50-ad0d-a2d145e61d74', 'quantite': '2'}, {'ingredient_id': '68181b49-609c-4b30-b36e-c94c00907232', 'quantite': ''}, {'ingredient_id': '8b1bdd04-3126-45b9-811d-cfa05b0f9b69', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37615, 'Gâteau à la banane et sa sauce chocolat', 'banane, citron vert, sucre, sel, oeuf, levure, huile de pépin de raisin, farine, beurre, chocolat, crème, beurre', '25 min', ['Faire préchauffer le four à 180°C.', 'Ecraser les bananes (avec une fourchette) dans un saladier, incorporer le jus de citron et le sucre tout en continuant d''écraser.', 'Ajouter la pincée de sel, puis mettre les oeufs (entiers!), mélanger.', 'Ajouter la levure, l''huile puis la farine.', 'Faire fondre le beurre et l''ajouter au mélange.', 'Faire cuire le gâteau 35 minutes.', 'Pendant ce temps, préparer la sauce (vous pouvez, bien sûr, déguster le gâteau sans la sauce au chocolat):', 'Faire fondre le chocolat au bain-marie.', 'Porter la crème à ébulliton puis ajouter le beurre.', 'Verser ce dernier mélange dans le chocolat.', 'Servir la sauce avec le gâteau, tiède ou refroidi selon les goûts.'], ['Mixeur', 'Spatule', 'Économe', 'Tire-bouchon', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'huile de pépin de raisin', 'dessert', 'sauce chocolat', 'plat de résistance', 'Gâteau à la banane et sa sauce chocolat', 'beurre', 'citron vert', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:58:37.340567', [{'ingredient_id': '8c481710-7cff-4f2a-94a3-6abf74f3a97f', 'quantite': '200 g'}, {'ingredient_id': '01b194ad-ef36-47a1-b8ac-3524dd1f83b7', 'quantite': '1'}, {'ingredient_id': '906be67c-fb9f-4c6e-9203-1d1fd98bddd3', 'quantite': '200 g'}, {'ingredient_id': '01bb9de1-7102-477a-8106-3cc9a2d1197c', 'quantite': '1'}, {'ingredient_id': '8ecbc0e6-d8c8-4025-83c6-601122f50447', 'quantite': '2'}, {'ingredient_id': '77baa001-a5c9-4087-8b3f-6d525a0ddfdc', 'quantite': ''}, {'ingredient_id': '7ed90a26-078a-4388-9cca-5f70ed7c0f87', 'quantite': '1 cuillères'}, {'ingredient_id': '58e701d7-cfb2-4591-9c55-6df3e3759e28', 'quantite': '200 g'}, {'ingredient_id': '683645c6-81b6-47a8-8aaa-8571d3b5741f', 'quantite': '70 g'}, {'ingredient_id': 'd9efefc8-eaa6-4bbc-afc9-2080aa3feef7', 'quantite': '100 g'}, {'ingredient_id': 'c32d203f-9816-48bf-84a9-f8c1a0825d23', 'quantite': '100 g'}, {'ingredient_id': '30c6a54f-dd7a-4e51-a840-61ae6df6b174', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27165, 'Bricks aux bananes', 'banane, brick, sucre, fruits, châtaignes, huile de friture', '20 min', ['Couper les bananes en deux dans la longueur. Les assouplir en les écrasant légèrement avec le dos d''une fourchette. Hacher finement les fruits du jacquier.  ', 'Sur chaque feuille de brick, déposer une demi-banane, un peu de brisures de châtaignes et de sucre. Enrouler les feuilles sur elles-mêmes pour former 8 rouleaux. A l''aide d''un pinceau, souder les bords avec de l''eau.', 'Faire dorer les rouleaux de banane dans un wok ou sauteuse empli(e) d''huile de friture. Utiliser une écumoire pour les retirer puis disposer sur du papier absorbant.', 'Servir chaud.'], ['Planche à découper', 'Presse-agrumes', 'Râpe', 'Verre doseur', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cocktail', 'très facile', 'huile de friture', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Bricks aux bananes', 'fruits', 'sucre', 'châtaignes'], 'Dessert', bbdf1f5a-435b-48fa-ae97-4260fdd5cc34, '2025-09-26T16:58:41.880066', [{'ingredient_id': '4d6e35d6-ae5f-4d6c-8c11-a9a24237bc38', 'quantite': '4'}, {'ingredient_id': '96fc7b83-ba8b-458c-99df-242ab19f7194', 'quantite': '8'}, {'ingredient_id': 'a4572a16-127f-487f-8c3e-fe600b582067', 'quantite': '80 g'}, {'ingredient_id': 'f17a94fd-5e81-4139-8ec4-91bd3505df54', 'quantite': '60 g'}, {'ingredient_id': '489fe806-b03b-45a8-8dc4-2ae21392c0ad', 'quantite': ''}, {'ingredient_id': 'd73954e1-a083-46d4-b959-af2f61fb43de', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34372, 'Petites crèmes au caramel et lait de coco garnies de bananes', 'sucre, eau, lait, lait de coco, oeuf, jaune d''oeuf, cassonade, banane, beurre, menthe', '20 min', ['Allumez le four à 180°C et pendant qu''il chauffe, confectionnez un caramel. ', 'Placez le sucre en morceaux dans une casserole à fond épais, versez les 15 cl d''eau, faites cuire à feu doux jusqu''à ce que le sucre fondu prenne une couleur rousse. ', 'Pour homogénéiser, agitez le manche de la casserole. ', 'Versez le caramel dans le fond de 6 ramequins légèrement beurrés. ', 'Pour les crèmes : ', 'Versez lait normal et lait de coco dans une casserole, faites chauffer ce mélange à feu moyen jusqu''à ébullition. ', 'Pendant ce temps, placez les 3 oeufs entiers et les 4 jaunes d''oeuf dans une jatte. ', 'Ajoutez 100 g de cassonade et battez le tout jusqu''à ce que le mélange éclaircisse. ', 'Versez le lait bouillant, mélangez bien et filtrez au-dessus d''une jatte. ', 'Versez le mélange obtenu dans les 6 ramequins, par-dessus le caramel. ', 'Couvrez chaque ramequin de papier aluminium. ', 'Faites-les cuire au bain-marie dans le four (avec le papier d''aluminium) pendant 20 mn. ', 'Quand la préparation est cuite, laissez refroidir, puis placez au frais quelques heures. ', 'Avant de servir : ', 'Pelez les bananes puis coupez-les en rondelles. ', 'Faites-les dorer une minutes par face dans une poêle, avec un peu de beurre. ', 'Saupoudrez chaque face avec la cassonade restante. ', 'Démoulez le contenu de chaque ramequin sur une assiette. ', 'Décorez avec les rondelles de bananes encore tièdes et les feuilles de menthe fraîche rincées à l''eau. ', 'Servez sans attendre.'], ['Ouvre-boîte', 'Balance de cuisine', 'Fouet'], ['boisson', 'caramel', 'recettes', 'entrée', 'Petites crèmes au caramel et lait de coco garnies de bananes', 'recettes de cuisine', 'plat', 'moyenne', 'sucre', 'dessert', 'confiserie', 'eau', 'recette', 'testées', 'plat de résistance', 'cocktail', 'cuisine', 'moyen'], 'Dessert', 2d53d613-a6e9-41d6-8947-390927d43f3d, '2025-09-26T16:58:45.514690', [{'ingredient_id': '02624706-2a4d-46bc-992b-fbff5c735ad8', 'quantite': '20'}, {'ingredient_id': 'c3795806-7ec7-4f9c-9bc4-97e5825dcc4e', 'quantite': '15 cl'}, {'ingredient_id': '6e925a8c-e407-4763-8380-89254a3e4cc4', 'quantite': '40 cl'}, {'ingredient_id': 'bf97c460-33df-4659-bbd6-08402133e232', 'quantite': '40 cl'}, {'ingredient_id': '7fb1fd0a-08aa-480a-b831-3883176bf280', 'quantite': '3'}, {'ingredient_id': '66e5c873-3a3a-4c6c-a489-89cd22a8c8e6', 'quantite': '4'}, {'ingredient_id': '7a97fd2b-b610-4023-97c6-6f7bb85a0917', 'quantite': '120 g'}, {'ingredient_id': '3d6bdf4e-5536-4446-ada3-75dd4296d28b', 'quantite': '3'}, {'ingredient_id': 'cfaad0fd-3b07-4b33-95b2-ef04e7a784ed', 'quantite': '20 g'}, {'ingredient_id': 'a048e9d0-b384-4de4-89c9-5ed7683d2d8f', 'quantite': '12'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345314, 'Smoothie bowl aux framboises', 'lait de soja, banane, framboises, yaourt, cassis, miel', '5 min', ['Eplucher la banane et la couper en morceaux. Réserver quelques rondelles (4-5).', 'Réserver quelques framboises.', 'Dans un blender, placer le reste des framboises, la banane, le yaourt, le miel et le lait.  Mixer le tout. ', 'Verser la préparation dans un bol (ou une assiette creuse) et placer sur le dessus quelques rondelles de bananes, des framboises et des cassis. ', 'Déguster.'], ['Râpe', 'Louche'], ['cassis', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'Granola', 'très facile', 'framboises', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'Smoothie bowl aux framboises', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'lait de soja', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:58:50.260396', [{'ingredient_id': '27afcc68-3618-4200-9f29-df6137c02ce4', 'quantite': '5 cl'}, {'ingredient_id': 'a5167f00-75cd-4f75-8b05-22721529b068', 'quantite': '1'}, {'ingredient_id': '27e565fb-b3e1-4030-ab34-f92122d5fb65', 'quantite': '60 g'}, {'ingredient_id': '46b6468c-b689-48c1-9928-16124dcf847d', 'quantite': '1'}, {'ingredient_id': 'c8223f51-2082-4527-9068-c704cdc02f24', 'quantite': '1'}, {'ingredient_id': 'edd86f40-4d21-494a-9cd5-d6d1dbde3d25', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61301, 'Bananes vapeur mode antillaise', 'banane, sucre vanillé, rhum, noix de coco rapée, jus de citron', '5 min', ['Découper 2 belles feuilles de papier alu, couper les bananes en 2 et les déposer sur le papier alu (4 moitié par feuille).', 'Arroser d''un peu de jus de citron vert, saupoudrer de sucre vanillé (la moitié d''un sachet par papillote), verser une cuillère à soupe de rhum brun et en dernier saupoudrer de noix de coco rapée.', 'Mettre les papillotes ainsi fermées dans le panier vapeur de la cocotte minute et laisser cuire 7 à 9 minutes (selon l''état des bananes, si elles sont fermes, les laisser 9 minutes).'], ['Couteau de chef', 'Tire-bouchon', 'Verre doseur', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'sucre vanillé', 'jus de citron', 'Bananes vapeur mode antillaise', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:58:53.809098', [{'ingredient_id': 'e2b3b050-44dc-45d0-b263-a105072265ca', 'quantite': '4'}, {'ingredient_id': 'eee3bd1b-7e38-4e1d-a110-bdfb6e751401', 'quantite': '1'}, {'ingredient_id': 'f6cc45a8-e0e2-40d6-9596-f40a6ff06609', 'quantite': '2 cuillères'}, {'ingredient_id': '578138f1-fcfe-410b-b408-dd8f5deae0db', 'quantite': '2 cuillères'}, {'ingredient_id': 'f063c0e5-e288-4470-9ed8-bfe81ff49bcd', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58467, 'Punch aux deux rhums', 'rhum, rhum, sucre de canne, jus d''orange, fruits exotiques, vanille, cannelle, banane, ananas, mangue', '15 min', ['Mélanger tous les liquides ainsi que les gousses de vanille et la cannelle 48h à l''avance.', 'Découper et ajouter les fruits 1/2 journée avant de servir.'], ['Pince de cuisine', 'Râpe', 'Verre doseur', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'mangue', 'fruits exotiques', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'vanille', 'punch', 'dessert', 'plat de résistance', 'ananas', 'jus d''orange', 'cannelle', 'cocktail', 'Punch aux deux rhums'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:58:58.733713', [{'ingredient_id': 'c3aab3c4-c92f-4943-8125-33234baa3ccf', 'quantite': '1'}, {'ingredient_id': '9ec1c5eb-2c9a-4834-97e6-d64104c2dc08', 'quantite': '2'}, {'ingredient_id': '3e12b4ee-d16a-414a-b23e-5bf5fb45a569', 'quantite': ''}, {'ingredient_id': '5dffb1e5-0e12-4bf5-a04d-2c025cfe0315', 'quantite': '1 l'}, {'ingredient_id': '6830db0d-9e70-49e1-a0a0-b1d43cc2f52b', 'quantite': ''}, {'ingredient_id': '34e6de4c-ed33-4674-8dfe-73e024c6d263', 'quantite': '2'}, {'ingredient_id': '757358a4-120e-4275-8859-7c51fdaf8628', 'quantite': '1'}, {'ingredient_id': '0f68b1cd-7391-4334-8f95-1a2a7085e675', 'quantite': '3'}, {'ingredient_id': '70055dc2-6d97-4d0c-a77d-71ee37741ecc', 'quantite': '1'}, {'ingredient_id': 'c32f335b-cedf-4d86-a2ab-dfc28cc7ec34', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315465, 'Grand multi', 'banane, carotte, kiwi, gingembre, orange, ananas', '10 min', ['Tout mixer dans un mixeur.', 'Disposer dans des verres.', 'Bon soif !'], ['Mixeur', 'Râpe'], ['', 'gingembre', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'carotte', 'facile', 'bon marché', 'rapide', 'Grand multi', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'orange', 'ananas', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:59:04.076345', [{'ingredient_id': '76caa7ae-537d-4c90-b91c-5a2b68261a0e', 'quantite': '2'}, {'ingredient_id': '5dbd0a0c-b1cb-4770-a6b1-39cc78b611f7', 'quantite': '3'}, {'ingredient_id': '82b0a5f1-d629-4559-b2f4-df7b93b175e9', 'quantite': '3'}, {'ingredient_id': 'b2cd3a9c-0af3-4e28-87b1-f3a258fdde6e', 'quantite': '1'}, {'ingredient_id': 'a0ca334e-23a6-4136-bbe1-1bb91d274f47', 'quantite': '1'}, {'ingredient_id': '6d3607d3-8127-4531-a323-16e21c88ac4f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43133, 'Crumble fondant au chocolat blanc', 'poire, banane, chocolat blanc, farine, beurre, sucre', '15 min', ['Commencez tout d''abord par couper vos poires en morceaux.', 'Et répartissez-les dans un plat allant au four.', 'Disposez par dessus, les bananes coupées en rondelles, et les petits morceaux de chocolat blanc (à votre convenance). Réserver.', 'Dans un saladier, mélangez la farine et le sucre.', 'Puis, ajoutez le beurre en petits cubes et mélanger à la main de façon à former une pâte grumeleuse.', 'Emiettez cette pâte au dessus des fruits, de façon à les recouvrir.', 'Enfournez à 200°C (thermostat 6-7), pendant environ 30 min. Surveillez de temps en temps.'], ['Batteur électrique', 'Mixeur', 'Presse-agrumes', 'Casserole', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'Crumble fondant au chocolat blanc', 'plat de résistance', 'autres crumbles', 'beurre', 'chocolat blanc', 'sucre', 'cocktail'], 'Dessert', f9d32e16-dad5-4119-a7ce-a55dd724070e, '2025-09-26T16:59:10.122831', [{'ingredient_id': 'c5f148ed-ebf3-46eb-b8f7-f55a0644e579', 'quantite': '1'}, {'ingredient_id': 'd2030965-e281-41ec-bd66-13254849d332', 'quantite': '1'}, {'ingredient_id': '8535c762-b4cd-4b6e-a8f3-150de915f622', 'quantite': ''}, {'ingredient_id': '21da1f2b-ddef-4b1b-87f3-916b64e16407', 'quantite': '100 g'}, {'ingredient_id': '5eb314dd-f6f2-4288-8159-9de4016e60fa', 'quantite': '60 g'}, {'ingredient_id': 'c52b8969-3438-4ae8-baf9-4c88060cf57d', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57341, 'Tarte ananas et banane de Fred.S.', 'farine de châtaigne, farine, fécule de maïs, sucre, levure chimique, lait, beurre, ananas, banane, oeuf, fromage blanc, sucre, sucre vanillé, rhum', '60 min', ['Commencez par préparer la pâte à tarte, en mélangeant ensemble les farines, la levure et le sucre.', 'Ajoutez le beurre que vous mélangez à la farine.', 'Terminez par le lait.', 'Mélangez sans pétrir.', 'Rajoutez un peu de farine si besoin.', 'Formez une boule et placez-la au frais.', 'Pendant ce temps, épluchez l''ananas et coupez-le en dés.', 'Faites-le revenir dans une poêle pour lui faire rendre une partie de son eau (environ 10 minutes).', 'Vous pouvez ensuite ajouter le paquet de sucre vanillé et mélanger.', 'Récupérez votre boule de pâte et étalez-la puis disposez-la dans le moule à tarte.', 'S''il y en a trop, rabattez la pâte pour faire des bords un peu plus hauts et épais.', 'Si vous avez des vieux biscuits à la cuiller qui traînent, ou de la fécule de maïs, vous pouvez en mettre au fond pour absorber le jus des ananas.', 'Préchauffez votre four à 175°C (thermostat 5-6).', 'Epluchez les bananes et mixez-les.', 'Ajoutez le fromage blanc, le sucre, le rhum et les jaunes d''oeuf.', 'Mélangez bien bien.', 'Placez les morceaux d''ananas sur la pâte à tarte et mettez au four pour 10 minutes.', 'Pendant ce temps, battez les blancs en neige et incorporez-les au reste de la garniture à la banane.', 'Nappez de ce mélange les morceaux d’ananas et enfournez à nouveau pour 35 minutes (surveillez en fin de cuisson).', 'Servez tiède ou froid.', 'Les plus téméraires iront napper de chocolat fondu leur part de tarte!'], ['Batteur électrique', 'Planche à découper', 'Passoire', 'Économe'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'facile', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'farine de châtaigne', 'Tarte ananas et banane de Fred.S.', 'moyen', 'beurre', 'sucre', 'lait', 'cocktail', 'fécule de maïs'], 'Dessert', 09de767c-605f-4cc5-99b4-d703eff92e98, '2025-09-26T16:59:13.800929', [{'ingredient_id': '0fead3d3-c26c-45ed-83f7-3b14a1c9a6e6', 'quantite': '100 g'}, {'ingredient_id': '6ba1cc14-724d-4e47-961c-8df33d3a7c82', 'quantite': '150 g'}, {'ingredient_id': '7d46d61e-dd9c-4275-afba-e43c03d66197', 'quantite': '5 cuillères'}, {'ingredient_id': '93919df6-31d1-4e76-a1ce-a6a8d95c93fe', 'quantite': '2 cuillères'}, {'ingredient_id': '91158603-27af-46e6-b316-d754964f05ed', 'quantite': ''}, {'ingredient_id': '346d9ebe-a3fa-4d67-8cfd-0a00fa414837', 'quantite': ''}, {'ingredient_id': 'ce4f81a8-7079-4c1c-bf35-a0362bae3de5', 'quantite': '125 g'}, {'ingredient_id': '06b7d4d7-c19e-4e85-991a-579f5ab2fb46', 'quantite': '1'}, {'ingredient_id': 'e37a575d-c5c5-4c60-91a9-049a5b31eec6', 'quantite': '3'}, {'ingredient_id': '44da3244-ab7e-4cd8-92d5-faa5df48cc83', 'quantite': '3'}, {'ingredient_id': '5f9595d5-bc39-4308-9357-61273e5afbcc', 'quantite': '200 g'}, {'ingredient_id': '57b05c75-7e8e-4f82-a17e-b884457efd82', 'quantite': '100 g'}, {'ingredient_id': '1b53498b-cadb-44da-8aab-a378da0f3dca', 'quantite': '1'}, {'ingredient_id': '87cf3618-2b02-4f48-972e-36dd769a6c29', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27418, 'Chaussons du goûter à la banane', 'banane, eau, sucre, vanille, pâte feuilletée, jaune d''oeuf', '25 min', ['Eplucher les bananes et les couper en morceaux. ', 'Porter à ébullition le mélange eau + sucre + vanille. ', 'A l''ébullition, ajouter les bananes et laisser cuire 10 mn à feu moyen. ', 'Egoutter et réduire les bananes en purée. ', 'A l''aide d''un ou d''une grande tasse, former les "ronds", découper des rondelles dans la pâte feuilletée.', 'Garnir le centre d''une rondelle avec la marmelade de bananes refroidie, puis recouvrir avec une seconde rondelle. Bien mouiller le tour avec un peu d''eau, pour souder les deux rondelles entre elles. Replier les bords et les aplatir avec une fourchette (ça fait plus joli et ça tient bien ainsi). ', 'Dorer chaque chausson avec le mélange oeuf + lait à l''aide d''un pinceau. ', 'Faire cuire dans un four préchauffé à thermostat 6/7 (200°C) pendant 20 mn environ.'], ['Tire-bouchon', 'Batteur électrique', 'Pince de cuisine', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'pâte feuilletée', 'sucre', 'cocktail', 'Chaussons du goûter à la banane'], 'Dessert', 9ab95574-7b30-4b01-ab38-6d17d1b2f42f, '2025-09-26T16:59:17.500335', [{'ingredient_id': '1f5434ad-1bf1-40e0-a5ec-fd1e5d7881e0', 'quantite': '4'}, {'ingredient_id': '47dbef96-eab9-4488-b11a-3c4d7f813e8b', 'quantite': '35 cl'}, {'ingredient_id': '59cf7ad8-abf3-484c-9728-ec1ec54e6c12', 'quantite': '150 g'}, {'ingredient_id': 'ca3c4471-09bd-47ba-8da2-45456f7cce64', 'quantite': '1'}, {'ingredient_id': '82912cf7-e5a5-4688-b299-e8078f7cff08', 'quantite': '1'}, {'ingredient_id': 'ffb2c36b-fccb-4fb9-9e0c-6f32a3c8db21', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (165954, 'Raïta à la banane', 'banane, citron, yaourt, noix de coco rapée, cumin en poudre, lait de coco, poivre, sel', '10 min', ['1) Eplucher les bananes et les écraser à la fourchette en ajoutant le jus de citron. ', '2) Dans un bol,battre le yaourt et incorporer la banane écrasée,la coco râpée et le cumin en poudre.Mélangez bien,salez et poivrez.Ajoutez un peu de lait de coco (si vous en avez)afin d''obtenir une crème plus fluide. ', '3) Conservez au frais et servez.'], ['Fouet', 'Verre doseur', 'Balance de cuisine', 'Tire-bouchon'], ['', 'lait de coco', 'entrée', 'banane', 'cumin en poudre', 'recettes de cuisine', 'yaourt', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'citron', 'poivre', 'cocktail', 'Raïta à la banane'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:59:22.287621', [{'ingredient_id': '52784037-680b-4c6e-92e0-b3f7622c4bd8', 'quantite': '2'}, {'ingredient_id': 'ff0018bb-c79d-4e15-8dd3-99f82db0c73e', 'quantite': ''}, {'ingredient_id': 'af6f2844-e2eb-4d7b-a7c5-c7d32dbfbf09', 'quantite': '300 g'}, {'ingredient_id': '6ec5b729-e4f0-47b1-ab15-8490c4a1362b', 'quantite': '2 cuillères'}, {'ingredient_id': '2cc82ad6-7d2b-4e2d-894f-741fee6d6880', 'quantite': '1'}, {'ingredient_id': '37d4766b-73e0-4db2-aa49-0fb147d5b919', 'quantite': ''}, {'ingredient_id': '7894eb6f-9e61-4c51-abab-af8c6248262f', 'quantite': ''}, {'ingredient_id': '1f24d3bf-bea0-4f43-9328-719f382833bf', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27608, 'coup de fouet !', 'lait, banane, chocolat en poudre, oeuf, miel', '3 min', ['Mixer la banane avec le lait, ajouter le miel et l''oeuf. ', 'Re-mixer. ', 'Verser dans un joli verre. ', 'Saupoudrer de chocolat en poudre.'], ['Fouet', 'Couteau de chef', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'coup de fouet !', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat en poudre', 'lait', 'cocktail'], 'Boisson', 7e2626c5-cd60-40ee-86e4-e035509b868d, '2025-09-26T16:59:26.010453', [{'ingredient_id': '614f571a-40a1-43ef-8adf-e8c24ab4023b', 'quantite': '20 cl'}, {'ingredient_id': '0a7648ee-76e8-4caf-8e1b-69b0bc93f61c', 'quantite': '1'}, {'ingredient_id': 'e9ce7bcc-231e-4fa0-83d3-53e3a1ca2abc', 'quantite': '2 cuillères'}, {'ingredient_id': 'bc26512f-5db4-4ef1-b71d-1541c1fa1a99', 'quantite': '1'}, {'ingredient_id': '16fce48b-0ed4-4877-92a6-25ea3a5289b9', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13998, 'Crêpes chocobanane-fraise-chantilly', 'crêpe, pâte à tartiner, banane, confiture de fraises, crème chantilly', '15 min', ['Faire les crêpes comme on en a l''habitude.', 'Une fois les crêpes faites, bien chaudes, on enduit une face entière avec la pâte à tartiner.', 'Couper une banane en fines rondelles que l''on dispose sur la crêpe, face ''Nutella''.', 'Tout recouvrir de crème Chantilly.', 'Refermer la crèpe, qui logiquement prend la forme de la banane si l''on a bien disposé les rondelles.', 'Sur le dessus encore nu de la crêpe, déposer un petit filet de confiture de fraise.'], ['Râpe', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'Crêpes chocobanane-fraise-chantilly', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'confiture de fraises', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'crêpe', 'dessert', 'plat de résistance', 'crêpes sucrées', 'cocktail', 'pâte à tartiner'], 'Dessert', 1f4436a9-039c-4d29-be55-535d95be7491, '2025-09-26T16:59:29.584821', [{'ingredient_id': '3409c69d-7f15-4026-b3cb-14498167cca6', 'quantite': '4'}, {'ingredient_id': 'c0490328-df80-4684-a078-53247570257e', 'quantite': '200 g'}, {'ingredient_id': '930efcae-b838-4653-9f3a-7eeb12247023', 'quantite': '2'}, {'ingredient_id': 'f993fe4d-c460-4870-ac9d-a7552ea4ad6c', 'quantite': '4 cuillères'}, {'ingredient_id': 'f4394d03-e71d-40b9-99cf-2451eb6c2964', 'quantite': '125 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17610, 'Poulet au citron et aux  bananes', 'poulet, ail, citron, banane plantain, poivre, sel, huile d''olive, moutarde de Dijon, huile d''olive, citron, thym, poivre, sel', '15 min', ['Coupez les poulets en crapaudine en les ouvrant entièrement, de l''estomac à la jointure des ailes, sans séparer les deux moitiés.', 'Frottez-les avec l''ail et le citron, assaisonnez-les et huilez-les.', 'Faitez-les cuire de 30 à 40 mn à four chaud, en les retournant de temps en temps et en les badigeonnant d'' huile d''olive.', 'D''autre part, délayez la moutarde avec le jus des citrons, ajoutez l''huile, le thym et l''assaisonnement. Mélangez sur feu doux pendant 3 mn. Nappez-en le poulet. Découpez les bananes plantins en trois parties et faites cuire dans une cocotte (10 à 15 min). Mettez peu d''eau.', 'Après la cuisson, mélangez tout et remettez quelques minutes dans au four.'], ['Verre doseur', 'Balance de cuisine', 'Économe'], ['poulet en sauce', 'poulet', 'entrée', 'recettes de cuisine', 'Poulet au citron et aux  bananes', 'sel', 'confiserie', 'testées', 'facile', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'banane plantain', 'moyen', 'citron', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:59:33.216289', [{'ingredient_id': '7927f00a-b2c2-491b-a54e-652cdd258eb4', 'quantite': '2'}, {'ingredient_id': '066cb1be-606c-425f-8f31-fd269a02a58a', 'quantite': '2'}, {'ingredient_id': '692907c5-df92-4e1b-810d-1fd8c191e9d2', 'quantite': '1'}, {'ingredient_id': '0ed92c58-ec07-4e04-b658-8e4e27af5630', 'quantite': '7'}, {'ingredient_id': '248252c1-4372-48b0-aa55-6459335b57af', 'quantite': ''}, {'ingredient_id': 'bb8b782f-4454-4bfe-a9f1-b97d5f7f8043', 'quantite': ''}, {'ingredient_id': 'b45376a6-e0ca-4a77-8f3f-fd153f62e232', 'quantite': ''}, {'ingredient_id': '49c906c3-1e97-4d3f-af97-c503ee07025a', 'quantite': '1.5 cuillères'}, {'ingredient_id': '4b22c883-5044-4b75-a592-cd5da494130d', 'quantite': '3 cuillères'}, {'ingredient_id': '01d331ea-d548-425a-a01d-bcbecfa398a3', 'quantite': '2'}, {'ingredient_id': 'd551df2a-2934-4efd-aaac-57971da649d9', 'quantite': '1'}, {'ingredient_id': '23047b61-fabd-47f2-b678-050e876f087c', 'quantite': ''}, {'ingredient_id': 'd86b74d8-92b1-4337-95c8-e10fd2b7f0ea', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (67469, 'Gâteau au yaourt à la banane et aux noix', 'yaourt, sucre, oeuf, farine, levure chimique, huile, banane, cerneau de noix', '15 min', ['Le pot de yaourt sert de mesure.', 'Préchauffer le four à 180°C (thermostat 6).', 'Mélanger le yaourt, les sucres et les oeufs. Ajouter la farine et la levure tamisées. Bien mélanger jusqu''à obtention d''une pâte sans grumeaux. Ajouter l''huile, bien mélanger.', 'Couper chaque banane en 2 dans le sens de la longueur, puis encore chaque moitié en deux. Découper chaque partie en petits cubes. Les ajouter à la pâte.', 'Mixer les noix ou les hacher grossièrement et les ajouter à la pâte.', 'Beurrer un moule à manqué, y verser la préparation, et mettre à cuire pour 40 min.'], ['Louche', 'Planche à découper', 'Ouvre-boîte', 'Moule à tarte', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'cerneau de noix', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'sucre', 'cocktail', 'Gâteau au yaourt à la banane et aux noix'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:59:36.730189', [{'ingredient_id': '790f964f-5428-43a0-b21f-c896b2556ff9', 'quantite': '1'}, {'ingredient_id': 'ca3f9bbf-8590-4306-96af-d0f4cf80a3f7', 'quantite': '2'}, {'ingredient_id': 'baa074d6-f018-40d1-a90a-3491ba23db6c', 'quantite': '3'}, {'ingredient_id': '3be2de2a-7b2e-492d-9857-8f1861ad1682', 'quantite': '3'}, {'ingredient_id': 'c5fa2def-a12d-46e4-89d5-816cebd013c3', 'quantite': '1'}, {'ingredient_id': '782ff3d0-7a61-424e-a462-1c35165fc87c', 'quantite': ''}, {'ingredient_id': 'b3b92935-fa00-47f3-aca8-44c7dead3fee', 'quantite': '3'}, {'ingredient_id': 'a22847bd-a7cc-4c76-90f4-9a35007e748f', 'quantite': '125 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20050, 'délices pomme banane', 'farine, sucre, oeuf, lait, huile, pomme, banane, beurre, farine', '15 min', ['Mélanger la farine avec le sucre puis les oeufs. ', 'Mélanger en insérant le lait et ensuite l''huile. ', 'Quand la pâte est prête... préparons les fruits.... pelez les pommes et éplucher les bananes... les couper en petits morceaux. ', 'Ensuite préparer le moule.... bien le beurrer et ne pas oublier de la fariner légèrement.... ', 'Enfourner et laisser cuire 45 mn.'], ['Batteur électrique', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'délices pomme banane', 'sucre', 'lait', 'cocktail'], 'Dessert', 7341a7d7-d87c-4b95-8fae-547f6c2e1980, '2025-09-26T16:59:40.491622', [{'ingredient_id': 'c847c323-ea83-4de5-b7a5-e4031ffdd460', 'quantite': '250 g'}, {'ingredient_id': '662dbb00-fbaf-42d5-9f4a-0b42c7ed278c', 'quantite': '200 g'}, {'ingredient_id': '22f3f84d-8c75-4e19-8acc-51018eb6a21f', 'quantite': '3'}, {'ingredient_id': '84b1ffa7-c7bb-4428-887d-f774fef86774', 'quantite': '250 ml'}, {'ingredient_id': 'df6cc005-a706-4f92-9c1f-10cf895e359e', 'quantite': '150 ml'}, {'ingredient_id': 'b2c03e85-981e-4de1-82c7-e973a7d9c54c', 'quantite': '3'}, {'ingredient_id': '7e3c2e86-1000-416e-b89d-e42a995c454b', 'quantite': '2'}, {'ingredient_id': '02ec60e3-7ecc-4ac7-a8a3-6b55e5a79244', 'quantite': ''}, {'ingredient_id': '2227f754-27b5-4533-9d9c-1fcd7ea93562', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (49736, 'Crème de banane parfumée à la cannelle', 'banane, yaourt nature, lait, sucre vanillé, sucre semoule, cannelle', '10 min', ['Coupez les bananes en rondelles et déposez-les directement dans le bol du mixeur.', 'Versez ensuite tous les ingrédients dans le bol, puis mixez le tout de manière à obtenir un mélange plus ou moins homogène suivant les goûts.', 'Incorporez ensuite la crème dans un récipient à couvercle (du type ancien bac à glace) et placez-la au réfrigérateur.', 'Remuez-la de temps en temps dès qu''elle commence à se solidifier sur les bords : même très fraîche (cela reste une crème, pas une glace !).', 'Au moment de servir, versez dans des coupes et saupoudrez d''une pincée de cannelle.'], ['Balance de cuisine', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'Crème de banane parfumée à la cannelle', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'cannelle', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:59:44.089471', [{'ingredient_id': '6605d6ff-b5b3-44be-a58d-3d2fcc6611e3', 'quantite': '2'}, {'ingredient_id': '2712f915-f881-40d3-8b9f-95157bd7abef', 'quantite': '1'}, {'ingredient_id': '7602a023-5396-4847-b127-99cf116e7a2e', 'quantite': '1'}, {'ingredient_id': '31299e73-7ed0-4c01-a876-e911512d0ac4', 'quantite': '3 cuillères'}, {'ingredient_id': '3d3cb5c2-0c95-4c43-9cb4-2d7a0b1b08f3', 'quantite': '1 cuillères'}, {'ingredient_id': 'cdef2996-c8c2-4f5d-bfdf-39bd061c4893', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (19376, 'Tarte pomme-banane', 'pâte brisée, compote, banane', '15 min', ['Foncer le moule avec la pâte brisée sans enlever le papier sulfurisé mais en coupant ce qui dépasse. ', 'Piquer le fond à l''aide d''une fourchette. ', 'Recouvrir le fond de la tarte avec la compote. ', 'Couper la ou les banane(s) en rondelles pas trop épaisses et disposer par dessus la compote. ', 'Mettre à four chaud 30 à 35 mn.'], ['Râpe', 'Batteur électrique'], ['Tarte pomme-banane', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'tarte à la banane', 'recette', 'compote', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', 33b45207-cc6f-4089-9654-d3d980fb4a67, '2025-09-26T16:59:47.682658', [{'ingredient_id': '119b098e-cfa0-4964-b0c1-011a26b604d0', 'quantite': '1'}, {'ingredient_id': '5e00359d-c91b-4022-99b2-0fd6b821dc0c', 'quantite': '4'}, {'ingredient_id': 'c24168d1-35a4-44f3-98b4-d63ad4cf387b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (211740, 'Gâteau à la vanille et aux bananes flambées', 'oeuf, sucre fin, sucre vanillé, beurre, farine de blé, lait, banane, armagnac', '25 min', ['Mélanger les œufs avec le sucre. Ajoutez-y le beurre fondu et le lait.', 'Verser ensuite la farine dans le mélange petit à petit.', 'Beurrer un plat et y verser la pâte puis enfourner à 180°C (thermostat 6) pendant 20 à 25 minutes.', 'Pendant ce temps couper les bananes en fines lamelles et les faire revenir dans du beurre. Les saupoudrer de sucre et les laisser dorer 5 minutes sur chaque face. Les faire flamber.', 'Quand votre gâteau est prêt, disposer les bananes flambées sur le gâteau.', 'Pour plus de saveur et de goût, ajouter un peu de cannelle en poudre par dessus et quelques vermicelles de décorations.'], ['Couteau de chef', 'Presse-agrumes', 'Verre doseur', 'Louche', 'Pince de cuisine'], ['', 'armagnac', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'sucre fin', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Gâteau à la vanille et aux bananes flambées', 'dessert', 'plat de résistance', 'farine de blé', 'sucre vanillé', 'beurre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:59:52.408044', [{'ingredient_id': 'd4334824-7f04-4469-a2a2-9092a556d27d', 'quantite': '4'}, {'ingredient_id': '3ec149f4-1b82-4962-8d83-1fc42a7b1b6e', 'quantite': '100 g'}, {'ingredient_id': 'fe789aee-68dc-4a16-8166-1663edec9027', 'quantite': '2'}, {'ingredient_id': '02e66e83-0c5d-474d-9608-a574e99773e5', 'quantite': '100 g'}, {'ingredient_id': '319bc118-8545-4d5a-8739-6866aa4408b6', 'quantite': '70 g'}, {'ingredient_id': '61eb51f3-4b70-41f1-90c1-d7930513e8d4', 'quantite': '15 cl'}, {'ingredient_id': 'eb0ffb05-0172-48e5-8628-65b7273fa7ef', 'quantite': '3'}, {'ingredient_id': 'dfd056d1-e3e7-44cb-bbcd-a0f548b7e687', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (85802, 'Crêpe Banane chocolat', 'banane, chocolat, crêpe', '5 min', ['Préchauffez votre four pendant 10 min à 200°C (thermostat 6-7).', 'Épluchez la banane, faites une fente dans la longueur et insérez 5 carrés de chocolat. ', 'Mettez la banane au milieu de la crêpe.', 'Roulez-la et mettez-la sur un plat. ', 'Mêmes étapes pour la seconde crêpe.', 'Couvrez-les d''un papier aluminium pour éviter qu''elles ne sèchent trop.', 'Mettez au four environ 15 min.', 'Voilà, votre dessert est prêt : croustillant à l''extérieur et fondant à l''intérieur !'], ['Spatule', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'Crêpe Banane chocolat', 'recettes', 'boisson', 'crêpe', 'dessert', 'plat de résistance', 'crêpes sucrées', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:59:55.941783', [{'ingredient_id': '7588bcbd-a526-4532-90f5-366cac6b7053', 'quantite': '2'}, {'ingredient_id': '940e26e0-6c0d-4803-a755-dcd645d43394', 'quantite': '10'}, {'ingredient_id': '0381d4b4-36f9-412b-bcae-424f556ef57f', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (309227, 'Milk-shake aux fraises et à la banane', 'glace vanille, banane, fraises, lait, sucre vanillé', '5 min', ['Coupez la banane et les fraises en morceaux. ', 'Mettez les ingrédients dans le mixer pendant 30 secondes à 1 minute. Si le milk-shake est trop épais, ajoutez un peu de lait et mixez à nouveau.', 'Note : si vos ingrédients ne sont pas assez froids, vous pouvez aussi mixer un ou deux glaçons avant d''ajouter le reste des ingrédients.'], ['Ouvre-boîte', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'sucre vanillé', 'lait', 'Milk-shake aux fraises et à la banane', 'cocktail'], 'Boisson', 66de5cb6-60ee-4366-b680-abba72237423, '2025-09-26T16:59:59.386606', [{'ingredient_id': 'ab61ef6d-f807-44b7-95e4-39b8f7bcc5f1', 'quantite': '1'}, {'ingredient_id': '2bf9e443-5772-4dbb-ba34-3e0278513130', 'quantite': ''}, {'ingredient_id': '1b2449ed-d81f-4330-b580-fc920d81c7ee', 'quantite': '5'}, {'ingredient_id': 'dc2f36b8-21db-45fb-8c19-333b9576d702', 'quantite': '8 cl'}, {'ingredient_id': '0412649e-c698-433d-813b-3b6acc127966', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (171098, 'Quatre-quart aux bananes et miel', 'banane, oeuf, sucre, farine, beurre, sel, cannelle, miel', '20 min', ['Battre les œufs avec le sucre et le sel jusqu''à faire légèrement mousser. Ajouter petit à petit la farine en mélangeant bien.', 'Faire rapidement fondre le beurre dans une casserole et le verser sur la pâte. Bien mélanger.', 'Ajouter une banane (bien mûre) écrasée et un peu de cannelle.', 'Couper les deux autres bananes en rondelles assez épaisses. En disposer la moitié dans un moule à cake. Verser toute la pâte. Puis terminer en mettant le reste des rondelles de banane dessus.', 'Enfourner à four moyen pendant 40 min.', 'A la sortie du four, laisser tiédir un peu. Puis démouler.', 'Enfin, faites chauffer le miel à feu moyen avec une ou deux cuillères à soupe d''eau. Et verser sur le quatre-quart encore chaud.', 'Dégustez tiède... ou froid !!!'], ['Batteur électrique', 'Poêle', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'Quatre-quart aux bananes et miel', 'farine', 'dessert', 'plat de résistance', 'beurre', 'cannelle', 'sucre', 'quatre quarts', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:00:03.171877', [{'ingredient_id': 'ae065a40-fbcf-494f-9050-f20af4f12b7c', 'quantite': '3'}, {'ingredient_id': '1274dc9e-1198-42db-b50a-00b1a7dfc824', 'quantite': '4'}, {'ingredient_id': 'b0a8f117-ea40-4d11-96fc-c3f441e07c6d', 'quantite': '200 g'}, {'ingredient_id': 'dbf96c9b-8373-48a0-b010-794863debd72', 'quantite': '200 g'}, {'ingredient_id': '0ea6692f-3b9c-483b-8bac-7c2bc9e3f2ca', 'quantite': '200 g'}, {'ingredient_id': '3ddbba2f-8e5d-49c7-8626-eb3d676f3314', 'quantite': '1'}, {'ingredient_id': '7a1c5c01-bc36-4b78-a203-59928ff351d6', 'quantite': ''}, {'ingredient_id': '9777e64d-ddac-4579-afe8-e5793aee386b', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72844, 'pomme fourrée à la banane', 'pomme, banane', '5 min', ['Creusez la pomme avec un couteau puis écrasez la banane avec une fourchette.', 'Mettez la banane dans le creux de la pomme.', 'Mettez le tout dans le four environ 5 min à 180°, thermostat 6.'], ['Ouvre-boîte', 'Râpe', 'Casserole', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'pomme fourrée à la banane', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:00:08.970412', [{'ingredient_id': '0a84d6e5-e18f-4c28-afa9-90028b555121', 'quantite': '1'}, {'ingredient_id': 'e8a433a3-8e8b-43e7-a9a3-7231366e55b1', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (60441, 'Bananes glacées au citron', 'banane, sucre en poudre, jus de citron', '5 min', ['Couper les bananes en deux dans le sens de la longueur, sans enlever la peau. Les disposer dans une assiette, face coupée vers le haut.', 'Arroser de jus de citron et saupoudrer légèrement de sucre.', 'Mettre au congélateur pendant 20 à 30 minutes, et déguster immédiatement !'], ['Poêle', 'Râpe', 'Fouet', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Bananes glacées au citron', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:00:14.932875', [{'ingredient_id': '436a689f-e3ad-4ed7-998b-84a642af0547', 'quantite': '2'}, {'ingredient_id': '0f2f6315-0e84-4dec-b134-5048e3f027d6', 'quantite': ''}, {'ingredient_id': '8c7c5b82-ebdb-422b-bb46-319f5575529c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26705, 'Salade de fruits d''automne au Porto', 'raisin noir, raisin blanc, poire, pomme, banane, citron, sucre, porto', '15 min', ['Récupérer les grains de raisins.', 'Détailler les pommes et les poires en dés, les bananes en rondelles. Arroser de citron pour éviter qu''ils ne noircissent.', 'Saupoudrer de sucre et arroser de Porto.', 'Laisser macérer 2 heures au frais avant de servir.'], ['Tire-bouchon', 'Louche', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'porto', 'confiserie', 'testées', 'poire', 'très facile', 'Salade de fruits d''automne au Porto', 'rapide', 'plat', 'recette', 'raisin blanc', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'citron', 'sucre', 'raisin noir', 'cocktail'], 'Dessert', 1532e74c-664a-4b20-9147-198f897fb4e5, '2025-09-26T17:00:18.578336', [{'ingredient_id': 'ed988255-dbe1-429f-87f0-bccc2731ce89', 'quantite': '1'}, {'ingredient_id': '17675045-6697-4cee-a1a5-dcb6e06b5ae2', 'quantite': '1'}, {'ingredient_id': '0b3fcb39-2851-4bb1-bea8-b54fe6a333f5', 'quantite': '1'}, {'ingredient_id': '5f9deb3e-def3-4336-80e2-13da6edbff8f', 'quantite': '1'}, {'ingredient_id': 'ab77a022-b845-4b78-a985-31c519491487', 'quantite': '1'}, {'ingredient_id': '3667b5ae-8cde-41cc-b3bf-3d48acfaff22', 'quantite': '1'}, {'ingredient_id': '8dcf30c1-9b17-405c-ad19-1e35b644ece9', 'quantite': '40 g'}, {'ingredient_id': '4b2de16f-e9df-4b98-b7a0-207716b90c4b', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (83674, 'Crumble avec bananes très mures', 'banane, beurre, petit beurre, cassonade, chocolat noir', '3 min', ['Mettre dans le mixeur : biscuits, beurre, cassonade, beurre et chocolat. Mixer 2/3 coups pour garder quelques morceaux.', 'Écraser les bananes, les disposer dans des ramequins individuels et verser la préparation dessus.', 'Mettre au four 200 °c (thermostat 7) pendant 15 min.', 'Servir tiède.'], ['Presse-agrumes', 'Passoire', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'Crumble avec bananes très mures', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'autres crumbles', 'beurre', 'petit beurre', 'cocktail'], 'Dessert', 8b49e632-a3ae-40c9-9871-d19031b1e797, '2025-09-26T17:00:22.179192', [{'ingredient_id': '22f80b23-cb4c-4028-b371-adc30c42fdaa', 'quantite': '2'}, {'ingredient_id': 'b06f2f48-8793-4fc6-99e7-33b7f016e607', 'quantite': '2'}, {'ingredient_id': 'ee4a6e0f-7d85-43a4-959c-c7ae28e893a5', 'quantite': '6'}, {'ingredient_id': 'dba01cf0-6280-45f4-b3b6-325b2b6a029c', 'quantite': '1 cuillères'}, {'ingredient_id': '5860d67d-db07-4439-a2a1-3577b9750956', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (230786, 'Décliné de pommes en verrine', 'pomme, banane, pâte feuilletée, jus de pomme, citron, crème fraîche, agar-agar, sucre', '40 min', ['Étape 1 - Préparation du fond feuilleté des verrines ainsi que la tranche de pomme caramélisée :', 'Découper 4 cercles de pâte feuilleté de diamètre correspondant au fond de la verrine.', 'Disposer du sucre dans un ramequin et tremper les 4 cercle de pâte dans le sucre des deux côtés.', 'Disposer ensuite ceux ci sur une plaque de four garni d''un papier cuisson.', 'Découper 4 rondelles fines de pomme, les tremper des deux côtés dans le sucre et les disposer sur la plaque.', 'Enfourner alors 15 min th 2-3 (50°C). Au bout de ces 15 min, augmenter la température th 7 (210°c) pendant 10 min.', 'Sortir les feuillés et les tranche de pomme caramélisées et réserver.', 'Étape 2 - Préparation de la compote', 'Éplucher les pommes, les couper en quartier, évider le cœur et couper en petit morceau.', 'Les mettre a mijoter avec un peu d''eau jusqu’à ce que les pommes aient fondues.', 'Les écraser avec le dos d''une fourchette et réserver.', 'Étape 3 - L''émulsion de pomme', 'Dans une casserole, verser 20 cl de jus de pomme, le jus du 1/2 citron et les 2 g d''agar-agar.', 'Amener à ébullition et faire bouillir 1 min.', 'Ajouter les 20 cl de crème entière liquide et bien mélanger.', 'Mettre le mélange dans un siphon a chantilly et laisser tiédir. ', 'Une fois tiède, ajouter le gaz.', 'Étape 4 - Le dressage', 'Dans le fond de la verrine, disposer le feuilleté caramélisé.', 'Verser par dessus de la compote de pomme jusqu’à mi hauteur de la verrine.', 'Disposer la tranche de pomme caramélisée.', 'Terminer par remplir le reste de la verrine avec l''émulsion de pomme présente dans le siphon.', 'Dans un petit ramequin, écraser un fond de banane et ajouter par dessus de l''émulsion de pomme.', 'Agrémenter le dessert de décoration comme des copeaux de chocolat, ou des billes argenté...', 'Bon appétit !'], ['Batteur électrique', 'Spatule', 'Ouvre-boîte', 'Verre doseur', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'agar-agar', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'Décliné de pommes en verrine', 'jus de pomme', 'plat de résistance', 'pâte feuilletée', 'pomme', 'citron', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:00:28.138265', [{'ingredient_id': 'ba024824-c995-4c3e-9fe2-3a50793ca475', 'quantite': '5'}, {'ingredient_id': '62be6a3a-7594-4ca0-9d64-60a1a3fbdbc3', 'quantite': '1'}, {'ingredient_id': '58ecae73-e43a-47ef-8484-93a4625fd675', 'quantite': '1'}, {'ingredient_id': 'fdf55336-3fed-4791-94a8-70014b02cbcd', 'quantite': '20 cl'}, {'ingredient_id': '873ead91-7574-42a8-bfa7-8ee38f0c7b5e', 'quantite': ''}, {'ingredient_id': '7da0c5e1-1195-4f5a-bf0f-db8f057821b5', 'quantite': '20 cl'}, {'ingredient_id': '482a0bad-a609-4b7c-87be-48bf3f59e708', 'quantite': '2 g'}, {'ingredient_id': '2c2a83e1-e7d2-4cab-9d06-20baf464d11c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28522, 'Nems banane/chocolat', 'brick, banane, chocolat amer', '10 min', ['Badigeonner la feuille de brick avec un peu d''eau au pincau pour la ramollir légèrement. ', 'Découpez une moitié de banane en rondelles et les mettre en ligne sur la feuille de brick. ', 'Répartir 2 carrés de chocolat. ', 'Roulez la feuille de brick et lorsque vous êtes presque arrivé à la fin, rabbattez les extrémités au milieu et finissez de rouler pour pouvoir coincer la fin de la feuille dans le pli qui s''est formé. ', 'Placez sur une feuille de papier sulfurisé et enfournez pour 10 à 15 mn , 180°C. Sortir lorsque c''est bien doré.'], ['Planche à découper', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'brick', 'recettes', 'Nems banane/chocolat', 'boisson', 'dessert', 'plat de résistance', 'chocolat amer', 'cocktail'], 'Dessert', 74ccacc0-0365-4770-b5d8-8a1e8d2eac65, '2025-09-26T17:00:31.993046', [{'ingredient_id': 'dc1e1cec-b3a7-4ab1-b073-7cb9100b0561', 'quantite': '4'}, {'ingredient_id': 'c72bf901-fe4a-4146-90e2-26a67f2e4a91', 'quantite': '2'}, {'ingredient_id': '2783920b-e595-4d3e-b7b1-ffe458c5160e', 'quantite': '8'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (25611, 'Gratin de fruits au chocolat blanc', 'chocolat blanc, beurre, oeuf, sucre en poudre, farine, mangue, banane', '25 min', ['Faites fondre le chocolat blanc avec le beurre, au bain-marie ou au micro-ondes. ', 'Fouettez les oeufs au fouet électrique jusqu''à ce qu''ils soient bien mousseux. Incorporez le sucre tout en fouettant. Incorporez ensuite la farine et la préparation au chocolat blanc. ', 'Epluchez la mangue et coupez-la en cubes ; Epluchez les bananes et coupez-les en rondelles. ', 'Répartissez les fruits dans des plats à gratin individuels. Versez la préparation au chocolat dans chaque plat. ', 'Mettez à cuire à four chaud (210°C , Th 7 ) pendant 15 mn. Le dessus doit être doré. ', 'Laissez tiédir avant de servir.'], ['Mixeur', 'Râpe', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'Gratin de fruits au chocolat blanc', 'oeuf', 'plat', 'mangue', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'chocolat blanc', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:00:35.766136', [{'ingredient_id': 'b3810c40-7556-4cea-b115-57a7a23e272b', 'quantite': '200 g'}, {'ingredient_id': 'c01aec99-b1c2-478f-b9ae-a899288b6871', 'quantite': '80 g'}, {'ingredient_id': '80a1631d-b373-460c-8be4-9df53fba6e28', 'quantite': '4'}, {'ingredient_id': '3e4a1609-bb6c-4b79-8b90-b8ab00efe9de', 'quantite': '40 g'}, {'ingredient_id': '4d3914a0-7a08-4086-b275-514afc80e7b3', 'quantite': '40 g'}, {'ingredient_id': 'f7fdc388-92a5-4f8c-9bcc-2d9b1a5e344e', 'quantite': '1'}, {'ingredient_id': '9403f165-1212-469d-889b-e178b3cfc0ea', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (88665, 'Crème de tapioca sur bananes caramélisées', 'tapioca, sucre, lait, beurre, oeuf, banane', '15 min', ['- Faire le caramel :', 'Dans une casserole, mettre 80 g sucre à feu doux et le laisser se cristalliser puis devenir liquide. Ajouter le beurre. ', 'Hors du feu, ajouter les bananes tranchées dans le caramel. ', 'Dans des verrines, faire un lit de bananes.', 'Dans une autre casserole, mettre le lait et porter à ébullition. ', 'Verser les billes de tapioca et laisser réduire à feu doux 5 minutes.', 'Battre un œuf avec 100 g de sucre. ', 'Ajouter ce mélange au tapioca. Laisser réduire jusqu''à obtenir un mélange crémeux.', 'Verser cette préparation sur les bananes. ', 'S''il reste du caramel durci, le casser à l''aide d''une marteau à viande afin d''obtenir des éclats à parsemer sur la verrine.'], ['Batteur électrique', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Crème de tapioca sur bananes caramélisées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'tapioca', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:00:40.919128', [{'ingredient_id': 'c1d5afbd-a833-49cb-8baf-ad6ef5cc64e2', 'quantite': '4 cuillères'}, {'ingredient_id': 'c87f3a62-5245-4a2c-bffa-6731a5f0b89a', 'quantite': '180 g'}, {'ingredient_id': '0bbb8362-1aff-4962-a915-d2096ea1b524', 'quantite': ''}, {'ingredient_id': 'e000af41-4919-4860-834d-689ce47a1097', 'quantite': '20 g'}, {'ingredient_id': 'df941a23-74c8-4bb7-8dd7-11d4d6eeecbb', 'quantite': '1'}, {'ingredient_id': '917300f4-7db8-4e3f-942d-7fc3fe75befc', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (535102, 'Tarte tatin aux bananes caramélisées et citron vert', 'rhum ambré, beurre, sucre, banane, citron vert, pâte feuilletée', '45 min', ['Mettre le sucre et l’eau dans une casserole et faire chauffer jusqu’à ébullition, ajouter le rhum et un peu de jus de citron. 

', 'Verser le caramel dans le fond du moule. 
Préchauffez le four à 210 degrés. Eplucher les bananes et couper en 2 dans le sens de la longueur. Disposez-les dans le moule puis par-dessus recouvrir de pâte feuilletée. Mettre en cuisson pendant environ 30 min.  
Laisser refroidir un dizaine de minute avant de démouler.  '], ['Passoire', 'Rouleau à pâtisserie', 'Casserole', 'Batteur électrique', 'Planche à découper'], ['entrée', 'banane', 'rhum ambré', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'tarte', 'plat', 'recette', 'cuisine', 'recettes', 'Tarte tatin aux bananes caramélisées et citron vert', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'beurre', 'citron vert', 'sucre', 'cocktail'], 'Dessert', e4bf70ba-d25c-40b4-b80a-9418fc006e1b, '2025-09-26T17:00:46.097856', [{'ingredient_id': '9cd172e3-a64e-45ae-97fb-3a885228fc93', 'quantite': '30 ml'}, {'ingredient_id': '9204d4ab-7d65-494b-963d-13fca00d6f78', 'quantite': '30 g'}, {'ingredient_id': 'd3011058-72f6-49a9-85d5-b6763d205915', 'quantite': '150 g'}, {'ingredient_id': '7786cde2-17d2-483e-965e-302f2d656023', 'quantite': '5'}, {'ingredient_id': '5b096d89-1c5c-45be-b152-527d309814c9', 'quantite': '1'}, {'ingredient_id': '944a8d51-3b11-4fa9-a261-228e4308e819', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (227795, 'Tarte banana-pruneaux', 'pâte brisée, banane, pruneau, amandes en poudre, sucre, oeuf, yaourt nature', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Recouvrir un moule à tarte de papier sulfurisé puis y étaler la pâte brisée.', 'Dans un saladier, mélanger la poudre d''amande, le sucre et les deux oeufs. Ajouter ensuite le yaourt et bien mélanger le tout jusqu''à obtenir une consistance homogène. ', 'Verser le tout sur la pâte.', 'Découper les bananes en rondelles. Disposer ensuite les bananes et les pruneaux alternativement sur toute la surface de la tarte.', 'Enfourner le tout à 180°C et laissez cuire 25 à 30 minutes.', 'Bon appétit !!!'], ['Ouvre-boîte', 'Mixeur', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'tarte aux pruneaux', 'confiserie', 'testées', 'pruneau', 'yaourt nature', 'facile', 'bon marché', 'amandes en poudre', 'oeuf', 'plat', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'Tarte banana-pruneaux', 'boisson', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:00:50.664415', [{'ingredient_id': '900eb688-721a-4028-9aea-6bc7142fdba2', 'quantite': '1'}, {'ingredient_id': '13cbd2ae-a4de-4db4-ad12-d967c03b056a', 'quantite': '2'}, {'ingredient_id': '546495dd-023c-4b4a-851d-c52367dd226f', 'quantite': '250 g'}, {'ingredient_id': '1d22361b-8eb0-4f07-8157-7e7107da35af', 'quantite': '150 g'}, {'ingredient_id': '4bf1f23b-9b94-4708-ad8a-fa7e41696834', 'quantite': '120 g'}, {'ingredient_id': '756ea38a-1995-43e0-b7db-5376eebce103', 'quantite': '2'}, {'ingredient_id': 'd720961a-77ce-4cc7-ab4e-a2b061c32805', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (320410, 'Petites douceurs choco/banane', 'farine, sucre, levure chimique, oeuf, compote, banane, chocolat pâtissier', '25 min', ['Préchauffez le four à 180°C (thermostat 6). Dans un saladier, mélangez les oeufs et le sucre au fouet. Quand le mélange est lisse, ajoutez la farine avec la levure dans votre préparation, puis la compote. Réservez votre préparation.', 'Dans un bol, faites fondre le chocolat au micro-onde pendant 2 min. Pendant ce temps, découpez des lamelles de banane.', 'Dans des moules à mini-cakes en silicone (ou petites caissettes en papier), mettez une cuillère à café de pâte dans le petit moule et versez au centre une 1/2 cuillère à café de chocolat fondu. Avec un pic, faites des cercles en entrainant le chocolat avec la pâte (pour créer l''effet tourbillon une fois cuit), et couvrez avec une lamelle de banane.', 'A reproduire 24 fois.', 'Effet garanti!'], ['Fouet', 'Spatule', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'chocolat pâtissier', 'compote', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre', 'cocktail', 'Petites douceurs choco/banane'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:00:54.311507', [{'ingredient_id': 'a85ed4bd-3913-4029-be7e-2f9424e0cfe8', 'quantite': '120 g'}, {'ingredient_id': '537ea5cb-e707-4ec6-a991-d92dba0973eb', 'quantite': '60 g'}, {'ingredient_id': '7071129c-02f5-4c9e-a713-416842772311', 'quantite': ''}, {'ingredient_id': '8f71dc26-52dd-45b6-a249-b899803373a2', 'quantite': '2'}, {'ingredient_id': '0377d9cf-e39a-4661-8985-65211a1c32e7', 'quantite': '1'}, {'ingredient_id': 'f85cef5c-089c-4e3c-92d1-07059e6aa75e', 'quantite': '1'}, {'ingredient_id': 'c9326e7e-cdb4-48d7-a9ab-4ffa15090673', 'quantite': '8'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40442, 'tarte rhubarbe, banane, brugnon', 'pâte sablée, Confiture de rhubarbe, banane, brugnon', '30 min', ['Faire un pâte sablée (je recommande vivement<a href="http://www.marmiton.org/recettes/recette.cfm?num_recette=14540" class="lientexte" target="_blank">la recette de Clem_C</a>)', 'Prendre 4 petits ramequins à tartelettes. Après avoir déposé la pâte sur du papier sulfurisé (4 morceaux), déposer la pâte dans les tartelettes.', 'Faire cuire les tartelettes juste avec la pâte sablée pendant 5 minutes sur 200°C (thermostat 6-7). La pâte doit rester blanche et être à peine cuite.', 'Retirer du four, badigeonner de confiture de rhubarbe le fond. ', 'Ensuite, éplucher un brugnon et une banane. Découper en morceaux, puis mixer jusqu''à obtenir un liquide épais.', 'Verser ce mélange sur chaque tartelette.', 'Faire cuire au four encore 5 minutes, bien surveiller la cuisson pour que la pâte ne brûle pas.'], ['Verre doseur', 'Louche'], ['brugnon', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'tarte rhubarbe', 'testées', 'tarte à la rhubarbe', 'très facile', 'bon marché', 'pâte sablée', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Confiture de rhubarbe', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', dd2b66ae-7245-440c-b8b4-d9d691e00cb7, '2025-09-26T17:00:58.971542', [{'ingredient_id': 'f7d7b0e1-0c30-469f-acd5-3e170f9e8e7f', 'quantite': ''}, {'ingredient_id': '85dd0774-3e95-441b-a60c-90d6d8542bac', 'quantite': ''}, {'ingredient_id': '3bbe7d2d-0239-4944-b6d1-f6d29e8563a0', 'quantite': '1'}, {'ingredient_id': '0cc83159-53f6-4649-ae40-eaaea0b57602', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21039, 'Sangria de Madrid', 'vin rouge, soda, soda, sucre en poudre, orange, pomme, citron, banane, pêche, poire, abricot, cannelle, porto', '20 min', ['Tout mélanger, à préparer au moins la veille et garder au frais.'], ['Tire-bouchon', 'Couteau de chef', 'Fouet'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'sucre en poudre', 'recette', 'Sangria de Madrid', 'cuisine', 'recettes', 'sangria', 'boisson', 'soda', 'vin rouge', 'dessert', 'plat de résistance', 'moyen', 'cocktail'], 'Boisson', d7b53e43-6d7d-4d60-98ce-e12f58684f75, '2025-09-26T17:01:04.354717', [{'ingredient_id': 'c74309ba-1e6f-4074-877a-e1777b2cb399', 'quantite': '50 cl'}, {'ingredient_id': '5ec95c44-8462-432c-93de-14768d353087', 'quantite': '12.5 cl'}, {'ingredient_id': '64d0a754-9345-4e9a-8537-a9f30cc950f4', 'quantite': '12.5 cl'}, {'ingredient_id': 'd2cac864-5c33-4592-a07a-37b0e00b5bd8', 'quantite': '60 g'}, {'ingredient_id': '9afd154d-4cba-43ba-99f3-c72b24caefdb', 'quantite': ''}, {'ingredient_id': '3b3dd3b7-2262-41bd-a4db-6f4864e8e241', 'quantite': ''}, {'ingredient_id': '963dba12-000a-45e0-91a6-bf2457c9257b', 'quantite': ''}, {'ingredient_id': '1b04379e-5aaa-4205-8ef1-6f9013fb2128', 'quantite': ''}, {'ingredient_id': 'a5e9d7d8-6a7b-41a7-ae8e-5f4b189e7379', 'quantite': ''}, {'ingredient_id': 'db7ef537-ffeb-4ebd-83aa-4ec1eb6b7db1', 'quantite': ''}, {'ingredient_id': '3bb2be37-2a85-4361-9957-36a8a5880883', 'quantite': ''}, {'ingredient_id': '03bc7eae-93b1-4486-8089-bdf931e43ff5', 'quantite': ''}, {'ingredient_id': '9651f20d-2a7d-42bb-a799-eb60582b5ae7', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (331223, 'Smoothie poires & bananes', 'poire, gingembre, banane, lait écrémé, glaçons, cannelle', '10 min', ['Mixer les poires et la banane puis ajouter les glaçons, le lait et le gingembre. Mixer à nouveau. Servir saupoudré de cannelle.'], ['Fouet', 'Économe'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'lait écrémé', 'testées', 'poire', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'cannelle', 'smoothies', 'cocktail', 'Smoothie poires & bananes'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:01:07.946663', [{'ingredient_id': '684609ad-0908-40b8-b4e3-19df11638869', 'quantite': '2'}, {'ingredient_id': '47b61eaa-8535-4380-ab50-da8c5270eccc', 'quantite': '1 cuillères'}, {'ingredient_id': 'e89db62f-8f46-49f4-b900-2722f518e575', 'quantite': '1'}, {'ingredient_id': 'dcccc1b3-a94d-4ac1-a773-76a6332b1b28', 'quantite': '25 cl'}, {'ingredient_id': 'b2edbb51-82e6-45ad-bf81-c5ae664bb830', 'quantite': '10'}, {'ingredient_id': '851d9b23-29fd-43fd-b4e1-de2cab062c65', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21209, 'Flan aux bananes et aux oranges', 'lait, oeuf, banane, sucre roux, orange, vanille, rhum', '15 min', ['Fendre la gousse de vanille en deux et la mettre à bouillir avec le lait. ', 'Eplucher les bananes et râpez une orange pour obtenir quelques zestes. Réduire en purée au mixeur.', 'Préchauffer le four à 160°C (thermostat 5-6).', 'Fouetter les oeufs puis incorporer la purée de bananes puis le lait chaud.', 'Verser dans un moule à manqué ou dans un moule à charlotte. Placer au bain-marie. Enfourner pour 45 minutes de cuisson. Attention, l''eau du bain-marie ne doit pas bouillir mais frémir.', 'Laisser le flan tiédir avant de le démouler sur le plat de service. Découper les oranges et les bananes en rondelles et arroser de rhum avant d''en décorer le flan.', 'Servir tiède.'], ['Économe', 'Balance de cuisine', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'Flan aux bananes et aux oranges', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'moyen', 'flan', 'orange', 'lait', 'cocktail', 'sucre roux'], 'Dessert', 451f42c1-d752-40cd-abf8-f6432e1747ef, '2025-09-26T17:01:11.580376', [{'ingredient_id': 'f2d7def3-265f-4f31-a521-9153ead5b834', 'quantite': '75 cl'}, {'ingredient_id': '33028e9a-824a-4804-b3be-7c67f74e6725', 'quantite': '7'}, {'ingredient_id': 'a81cae31-aa8b-4406-b579-13b040e62fbb', 'quantite': '1 kg'}, {'ingredient_id': '7689264d-7a67-491c-8465-1a3cc3364134', 'quantite': '150 g'}, {'ingredient_id': 'ee0edced-c2c1-4b3e-b0f4-840dec6dbe6a', 'quantite': '2'}, {'ingredient_id': '593396ff-a84a-460e-8c99-497c7002f423', 'quantite': '1'}, {'ingredient_id': '969cfb48-cdb7-4895-aa5c-a2f2769a2a78', 'quantite': '3 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (344323, 'Petit cake anti-gaspi aux peaux de bananes', 'banane, oeuf, beurre, cassonade, farine, levure chimique', '15 min', ['Bien laver les peaux de bananes.', 'En couper les extrémités et les couper en morceaux.', 'Préchauffer le four à 180°C (thermostat 6).', 'Dans un récipient, mixer les peaux de bananes avec l''oeuf (cela aide à bien mixer).', 'Faire blanchir le beurre, tiédi au micro-ondes 40 secondes, avec le sucre.', 'Mélanger les deux préparations.', 'Ajouter la farine et la levure et bien mélanger.', 'Il est temps de verser la pâte dans un moule à cake, préalablement beurré puis fariné, jusqu''à la moitié de sa hauteur, cela suffit.', 'Enfourner pour 30 minutes maximum. Moi je ne le mets que 28 minutes.', 'Bonne dégustation!'], ['Tire-bouchon', 'Planche à découper', 'Louche', 'Mixeur', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'levure chimique', 'facile', 'bon marché', 'Petit cake anti-gaspi aux peaux de bananes', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'beurre', 'cocktail'], 'Dessert', 37d24571-2ee1-4d33-a473-b7af9bde9266, '2025-09-26T17:01:15.097780', [{'ingredient_id': '43763345-d9f5-406f-8cc0-ff1540859724', 'quantite': '3'}, {'ingredient_id': '494613ff-48dd-4c92-b07e-1be0d5c0074b', 'quantite': '1'}, {'ingredient_id': '55f8dae5-d46e-434b-a94d-83fe175182e5', 'quantite': '85 g'}, {'ingredient_id': '5ad75282-4e4c-4148-958a-77d959ee1235', 'quantite': '50 g'}, {'ingredient_id': '654a3d71-03c3-418b-a0cc-b21e7a8fc498', 'quantite': '80 g'}, {'ingredient_id': '6165bb0e-8e8e-4cc0-a9b4-73db2902dfdb', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (54314, 'Gâteau à la banane des îles Marquises', 'farine, beurre tendre, sucre, sel, sucre vanillé, noix de coco, cannelle, citron, rhum, banane', '20 min', ['Travailler le beurre avec le sucre, sucre vanillé, rhum, cannelle et jus de citron à la fourchette.', 'Incorporer la farine et le sel.', 'Ne pas trop travailler afin de ne pas obtenir une pâte collante.', 'Etaler la 1/2 de cette pâte dans votre moule de cuisson (directement).', 'Disposer les rondelles de bananes et recouvrir du reste de pâte.', 'Saupoudrer de coco râpée.', 'Cuire 35 min à four chaud (200°C - thermostat 6-7).', 'Se déguste tiède comme froid.', 'Toute la difficulté réside dans l''étalage de la pâte !'], ['Mixeur', 'Économe', 'Rouleau à pâtisserie', 'Tire-bouchon', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'beurre tendre', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'gâteau à la banane', 'citron', 'Gâteau à la banane des îles Marquises', 'noix de coco', 'sucre', 'cannelle', 'cocktail'], 'Dessert', 34e247c2-b1b3-46b5-ad8b-3a781e91cd3a, '2025-09-26T17:01:18.740059', [{'ingredient_id': '26578c1f-d8b9-41dd-a6ea-da88c69b4b56', 'quantite': '175 g'}, {'ingredient_id': 'f1eb124b-f209-4d89-9938-bfee4ec79457', 'quantite': '150 g'}, {'ingredient_id': 'be736512-7802-4efb-a9c0-3dfe162bcf7a', 'quantite': '150 g'}, {'ingredient_id': 'b0419482-0471-48d6-ade3-d5fb0da67826', 'quantite': '1'}, {'ingredient_id': '33ccec82-38d9-48be-881f-d347644fa619', 'quantite': ''}, {'ingredient_id': '5da619c7-a25a-4029-8c88-eba119a45ceb', 'quantite': '2 cuillères'}, {'ingredient_id': '2d1c1707-7914-4034-aa9f-d6a0937ad75d', 'quantite': ''}, {'ingredient_id': '82aff7f9-a01e-47f8-9cf9-a989a646cfa4', 'quantite': ''}, {'ingredient_id': 'f7e356b0-392a-4389-9a20-2d19269e7946', 'quantite': '2 cuillères'}, {'ingredient_id': '038f30f8-db49-4e70-a626-225cf5b1963d', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (91778, 'Verrine banane biscuit toute légère', 'banane, fromage blanc, sucre, cannelle, petit beurre', '15 min', ['Préparer le fromage blanc avec le sucre (ou l''édulcorant) et une bonne pincée de cannelle. ', 'Coupez les bananes en rondelles.', 'Ecrasez (dans un sac congélation ça évite les miettes) les petits-beurres.', 'Préparez les verrines en alternant ', '- une couche de fromage blanc', '- une couche de banane', '- une couche de biscuits écrasés', 'Terminez par un peu de chocolat râpé.', 'Réservez au frais.'], ['Mixeur', 'Tire-bouchon', 'Louche', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'autres biscuits et petits gâteaux', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'petit beurre', 'Verrine banane biscuit toute légère', 'cannelle', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:01:23.791267', [{'ingredient_id': 'b3bc50b8-6956-4a0e-a35a-7ec8385df041', 'quantite': '2'}, {'ingredient_id': '52aa2477-c6a5-4c42-a964-422a1490d040', 'quantite': '300 g'}, {'ingredient_id': 'c0eac083-7d07-4d8c-b3d1-dc1ba2ba8145', 'quantite': '4 cuillères'}, {'ingredient_id': 'ea4397fb-93e7-4808-9eb3-25ca695b5017', 'quantite': ''}, {'ingredient_id': 'b9a5f2d8-5b41-4981-9d67-c639878d4e90', 'quantite': '12'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62359, 'Soupe aux 7 fruits', 'banane, pomme, raisin, raisin, framboises, fraises, prune, mûres, noisettes', '20 min', ['Dans une assiette creuse, couper la banane en rondelles. Ecraser les rondelles pour obtenir une purée.', 'Eplucher 1/4 de la pomme, puis en couper environ la moitié. Couper le bout obtenu en tout petit bouts.', 'Ajouter à la purée de banane.', 'Enlever la peau des raisins (si vous n''y arrivez pas laissez la peau !). Ecraser les grains sans enlever les pépins. Les ajouter à la mixture.', 'Faire pareil avec les raisins verts.', 'Ecraser les framboises en conservant les grains. Mélanger avec la bouillie déja préparée.', 'Equeutter les fraises, les écraser et mettre les avec le reste de la prépartion.', 'Enlever le noyau de la prune. Couper la en morceau en essayant d''enlever la peau. Faire pareil que les autres fois : ajouter à la purée.', 'Ecraser les mûres puis mélanger avec la soupe.', 'Pour un effet croustillant, ajouter des noisettes concassées.'], ['Fouet', 'Râpe', 'Moule à tarte', 'Poêle'], ['', 'raisin', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'framboises', 'bon marché', 'prune', 'rapide', 'plat', 'fraises', 'recette', 'mûres', 'noisettes', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'Soupe aux 7 fruits', 'cocktail'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:01:28.618294', [{'ingredient_id': 'b39cde67-0c93-482f-bcbd-d7e424875b03', 'quantite': '1'}, {'ingredient_id': '154b2d8e-409a-4a72-ae8a-a10c21881d04', 'quantite': ''}, {'ingredient_id': 'c8721669-a135-46b4-92d7-91e2acf17ace', 'quantite': '5'}, {'ingredient_id': '4c539076-513f-43e6-8757-d5760c48818d', 'quantite': '5'}, {'ingredient_id': 'baa2da16-4cfe-48f7-a822-8c02f1a39e61', 'quantite': '15'}, {'ingredient_id': '3c7d50db-af5f-42f8-ba47-94e6acea8445', 'quantite': '10'}, {'ingredient_id': 'e485a907-9e42-4c6d-9bb0-d8420660d3cf', 'quantite': '1'}, {'ingredient_id': 'dd3ebbce-89ea-4c58-9aad-d5a14e34d8f0', 'quantite': '4'}, {'ingredient_id': '1ed7f5c1-27d4-488f-91b0-cd8c91856b68', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22162, 'Salade des îles aux fruits exotiques', 'papaye, ananas, mangue, kiwi, goyave, fruit de la passion, banane, sucre vanillé, rhum, cannelle', '15 min', ['Epluchez tous les fruits et coupez les en morceaux en récupérant leur jus dans un récipient. Mettez les fruits et leur jus dans un plat. saupoudrez le tout de sucre vanillé et de cannelle, versez le rhum. ', 'Servez votre salade des îles après l''avoir laisser un peu au frigo.'], ['Verre doseur', 'Rouleau à pâtisserie', 'Louche', 'Tire-bouchon'], ['entrée', 'banane', 'papaye', 'kiwi', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'goyave', 'très facile', 'bon marché', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'fruit de la passion', 'dessert', 'plat de résistance', 'sucre vanillé', 'ananas', 'cannelle', 'salade de fruits exotiques', 'cocktail', 'Salade des îles aux fruits exotiques'], 'Dessert', 53cf52e3-7c3b-4a3f-b472-728d05001b8d, '2025-09-26T17:01:32.269005', [{'ingredient_id': '1079c11a-b8dd-47e7-9e53-051afbf949d5', 'quantite': ''}, {'ingredient_id': '087b13c6-cbe8-4229-8f9d-90279b85820c', 'quantite': ''}, {'ingredient_id': 'eea6d107-5431-4d3e-9b69-81a28b32bf54', 'quantite': '1'}, {'ingredient_id': 'b4fd8c1c-cde7-4440-ba89-f4853e94ff2d', 'quantite': '2'}, {'ingredient_id': '0742c56f-031d-438a-8d7d-8e24f4901630', 'quantite': '1'}, {'ingredient_id': 'd641f56d-a25a-4ae0-9dfe-18bd3ce28ec0', 'quantite': '2'}, {'ingredient_id': '699084a7-e800-4111-912f-fe0800937423', 'quantite': '1'}, {'ingredient_id': '78c98e86-f316-441a-a120-069ca1df7dd4', 'quantite': '7.5 g'}, {'ingredient_id': 'b28669e7-ac5c-4b5c-8afa-5962bcf195bf', 'quantite': '3 cuillères'}, {'ingredient_id': 'd5ea6e3a-e449-4f43-a678-7efdc9b31388', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166751, 'Muffins au chocolat light sans oeufs', 'farine, cacao, sucre, sucre vanillé, sel, levure, nappage chocolat, banane, margarine, lait demi-écrémé', '10 min', ['1) Mélanger tous les ingrédients A)', '2) Mixer les bananes et rajouter les ingrédients B), mettre dans une casserole pour faire fondre le chocolat doucement', '3) une fois le chocolat bien fondu, incorporé le mélange au mélange sec 1)', 'sans trop remuer, la pâte doit rester un peu "grumeleuse". On peut rajouter des minis smarties à ce moment là.', '4) Mettre dans les moules à muffins avec des caisettes et faire cuire à 180° chaleur tournante pendant 10 à 15 minutes. Attention bien surveiller, dès qu''un peut planter un couteau sans que la pâte d''attache au couteau arrêter de suite la cuisson, enlever les muffins du moule et laisser refroidir'], ['Louche', 'Mixeur', 'Planche à découper', 'Pince de cuisine', 'Rouleau à pâtisserie'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'cacao', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'Muffins au chocolat light sans oeufs', 'muffin', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:01:35.886704', [{'ingredient_id': 'af50b71d-65b9-4a15-8553-3ece3de895f3', 'quantite': '300 g'}, {'ingredient_id': '1827e2bd-3e89-4565-9d14-2a766d7ea0c6', 'quantite': '40 g'}, {'ingredient_id': 'f0322462-5d05-45fd-a2d7-706e69021666', 'quantite': '70 g'}, {'ingredient_id': '3813c31f-a6ee-4ef1-a39d-3e5738190f79', 'quantite': '1'}, {'ingredient_id': '13ac55a7-1a67-474f-a90c-17786ac24dd8', 'quantite': '1'}, {'ingredient_id': 'b49f4932-4807-47e8-a4d2-c49f695ae5fe', 'quantite': '1'}, {'ingredient_id': '8491de5b-4925-4e98-8059-d1b872cde375', 'quantite': '100 g'}, {'ingredient_id': '5b06f54b-5556-418f-9c37-cb37648202eb', 'quantite': '2'}, {'ingredient_id': '9f58096a-399d-41f6-84c3-496cf61f7422', 'quantite': '5 g'}, {'ingredient_id': 'c17af690-a180-4447-bdcf-11655706fed5', 'quantite': '280 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34817, 'Confiture fraise - framboise - banane', 'framboises, fraises, banane, sucre', '10 min', ['Prévoir plusieurs pots de confiture avec des couvercles qui ferment hermétiquement. Ebouillantez-les (pots et couvercles) et retournez-les sur un torchon bien propre, juste avant de démarrer la préparation', 'Il vous faut 500 g de fruits préparés: ', 'Posez un grand bol sur votre balance et mettez-la à 0 . ', 'Rincez les framboises avec précaution et mettez-les dans le bol. ', 'Lavez les fraises, enlever le bout vert puis coupez-les en petits morceaux. Ajoutez aux framboises. ', 'Ajoutez la banane/les bananes par petits morceaux pour compléter les 500 g de fruits. ', 'Mettez les fruits dans une grande marmite avec le sucre à confiture et cuire selon le mode d''emploi indiqué (en général: jusqu''à ébullition puis 3-4 min à gros bouillons). ', 'Pendant la cuisson surveillez bien et mélangez de temps en temps pour éviter que ça colle au fond. ', 'Retournez vos pots de confiture et préparez une louche. ', 'Dès que la cuisson est terminée, versez la confiture dans les pots à l''aide de la louche. Attention, ils doivent être pleins jusqu''au bord ! ', 'Attention encore : les pots sont très chauds !!! ', 'Vissez bien les couvercles et retournez les pots (attention aux risques de brûlure). Laissez refroidir quelques heures avant de les ranger - ou d''attaquer le premier pot !'], ['Couteau de chef', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'confiture de fraise', 'testées', 'assez cher', 'très facile', 'framboises', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'Confiture fraise - framboise - banane', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:01:39.673499', [{'ingredient_id': '8ca51570-0423-4544-ac75-5dee2c7104c3', 'quantite': '200 g'}, {'ingredient_id': 'a6252458-79fc-4c21-825c-c2a5f063b5df', 'quantite': '200 g'}, {'ingredient_id': '4de7b892-9102-49f0-94f7-161a33b79d1d', 'quantite': '1'}, {'ingredient_id': '2a86dc34-03c4-48c3-9c7c-35692d5b96fb', 'quantite': '500 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61833, 'Smoothie aux mûres et à la banane', 'mûres, banane, yaourt, glaçons', '15 min', ['Mettre tous les ingrédients dans un grand saladier. Mixer le tout jusqu''à obtention d''un mélange onctueux.', 'Mettre au frigo au moins 1 heure avant de servir.', 'Boire à la paille, c''est encore meilleur !'], ['Couteau de chef', 'Moule à tarte', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'Smoothie aux mûres et à la banane', 'rapide', 'plat', 'recette', 'mûres', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'smoothies', 'cocktail'], 'Boisson', 07c4d3c7-3d18-489f-8274-e0ae3bcbcb71, '2025-09-26T17:01:43.335078', [{'ingredient_id': '719d80ac-f1ea-47f4-a3e0-3b17abbec3b8', 'quantite': '700 g'}, {'ingredient_id': '14dfa413-8095-4928-9a54-6aadf15e56e1', 'quantite': '1'}, {'ingredient_id': '58371a81-32cb-4d9e-80a4-5eccef037f7b', 'quantite': '3'}, {'ingredient_id': '298191b7-958c-4c32-8045-b2f609bbb8e3', 'quantite': '12'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (45935, 'Gâteau à étages coco et fruits', 'génoise, banane, kiwi, barre chocolatée, crème fraîche, sucre vanillé, noix de coco', '45 min', ['Préparez vos génoises ou achetez-les toutes prêtes.', 'Sur la première génoise, disposez de la chantilly et la totalité des bananes coupées en rondelles.', 'Recouvrez de la seconde génoise sur laquelle vous disposerez une couche de chantilly, puis la totalité des kiwis coupées en rondelles et les 5 bounty émiettés.', 'Faites revenir la noix de coco jusqu''à ce qu''elle devienne légèrement brune dans une poêle sans matière grasse. Remettez ensuite la dernière génoise sur laquelle vous mettrez le reste de chantilly recouverte de la noix de coco.'], ['Couteau de chef', 'Mixeur', 'Râpe'], ['', 'entrée', 'banane', 'kiwi', 'crème fraîche', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'rapide', 'Gâteau à étages coco et fruits', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'barre chocolatée', 'génoise', 'dessert', 'plat de résistance', 'sucre vanillé', 'moyen', 'noix de coco', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:01:47.774917', [{'ingredient_id': 'f3187bf3-c931-493e-84d3-fc904867bc80', 'quantite': '3'}, {'ingredient_id': '6bc4f3e5-aed1-4c7e-a94d-68af4add0d15', 'quantite': '3'}, {'ingredient_id': '1de8961a-8ac6-41f4-b629-3b1b51d406fa', 'quantite': '3'}, {'ingredient_id': '2e79fcb0-05e6-4834-9c01-c65e54a98674', 'quantite': '5'}, {'ingredient_id': '21cc923c-97ee-4734-bdf4-8ff44afdefdb', 'quantite': '60 cl'}, {'ingredient_id': '01a3fb58-8ece-41ab-ba71-a8ae6c9400ff', 'quantite': '1'}, {'ingredient_id': 'cbca660e-5789-46e6-904e-e01ae09a06c9', 'quantite': '250 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (348537, 'Crumble mangue banane abricot', 'mangue, banane, abricot, beurre, farine, sucre, miel', '19 min', ['Préchauffer le four à 210 degrés (thermostat 8).', 'Découper la mangue et la banane en petits cubes. Dénoyauter les abricots et les découper également. Placer les fruits dans un plat qui va au four. Rajouter une cuillère de miel et mélanger avec les fruits.', 'Mélanger le sucre et la farine.', 'Ramollir le beurre 15 secondes au micro-ondes.', 'Malaxer le beurre du bout des doigts pour le mélanger avec le sucre et la farine afin d''obtenir une pâte cassante.', 'Verser là pâte à crumble sur les fruits.', 'Faire cuire 30 minutes.'], ['Poêle', 'Verre doseur', 'Râpe', 'Planche à découper', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'abricot', 'facile', 'bon marché', 'Crumble mangue banane abricot', 'plat', 'mangue', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:01:53.011170', [{'ingredient_id': 'e9f9181f-78aa-4aa9-89d7-ec4919f9cdbc', 'quantite': '1'}, {'ingredient_id': 'bb97c903-757e-4216-9902-7c96a4128bae', 'quantite': '1'}, {'ingredient_id': '98b5c062-5bc2-4998-a921-5d5b8a21eb75', 'quantite': '4'}, {'ingredient_id': 'bf052433-71a8-4dad-86b9-ec1a8ea5b497', 'quantite': '125 g'}, {'ingredient_id': '8000ed81-1883-4251-b700-f8c735439e8a', 'quantite': '150 g'}, {'ingredient_id': '210df959-cd02-4f7d-85f3-32cae744ab96', 'quantite': '150 g'}, {'ingredient_id': '1a8bfa67-0e1d-4c9a-8c69-5538e32dd63e', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38448, 'Corolle pomme-banane', 'brick, pomme, banane, raisins secs, lait de coco, cannelle, gingembre, eau de fleur d''oranger, caramel, beurre, haricots secs', '15 min', ['Mettre les raisons à gonfler dans l''eau chaude + l''eau de fleur d''oranger pendant 1 heure (si vous pouvez) ou à défaut, le temps de la préparation.', 'Préchauffer le four à 180°C (thermostat 6).', 'Préparer les corolles :', 'Prendre deux ramequins (de 5 cm de hauteur environ) qui vont au four et deux feuilles de brick.', '(Les feuilles étant trop grandes pour faire les corolles, il faut recouper un disque en enlevant environ 4 cm de côté).', 'Badigeonner les feuilles de brick de beurre fondu. ', 'Les mettre dans les ramequins avec des haricots secs pour former les corolles. ', 'Mettre au four environ 6 min à 180°C (les feuilles doivent être dorées).', 'Sortir les ramequins du four, enlever les haricots secs délicatement pour ne pas casser la corolle et laisser refroidir.', 'Préparer la garniture:', 'Faire chauffer à feux moyen dans une casserole le lait de coco avec la cannelle et le gingembre.', 'Quand le lait est chaud, ajouter la pomme et la banane que vous coupez en petits morceaux ainsi que les raisins égouttés.', 'Laisser revenir environ 10 min. (il faut que la banane fonde mais que la pomme reste un peu croquante)', 'Garnir les corolles avec la compotée de fruits.', 'Verser un filet de caramel liquide sur le dessus.', 'Servir et déguster.'], ['Presse-agrumes', 'Planche à découper', 'Râpe'], ['', 'lait de coco', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'caramel', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'Corolle pomme-banane', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'eau de fleur d''oranger', 'raisins secs', 'haricots secs', 'cannelle', 'cocktail'], 'Dessert', a204acb7-358e-480f-9dd5-d042cc39590f, '2025-09-26T17:01:57.003477', [{'ingredient_id': '76b76ee5-db63-4e76-9265-d87f796082ff', 'quantite': '2'}, {'ingredient_id': 'ef924987-3af7-495f-aabc-4fa6ffe51646', 'quantite': '1'}, {'ingredient_id': 'c8d96225-fa5a-4d11-b508-1c22d64329bd', 'quantite': '1'}, {'ingredient_id': 'b8e8fd50-91bf-44b9-8c0b-c2b9b4f10728', 'quantite': '1'}, {'ingredient_id': '5ea4a036-09d8-4508-af4f-7d9a0726bc19', 'quantite': '20 cl'}, {'ingredient_id': '4ad72ab3-9436-484c-a55a-a19e35d07acc', 'quantite': ''}, {'ingredient_id': 'c3298170-9361-4127-835c-8c36973ccd40', 'quantite': '1'}, {'ingredient_id': '576c27ae-f409-4854-a741-e7ebb43d0ad6', 'quantite': '2 cuillères'}, {'ingredient_id': 'e97e870e-5e31-4ed3-8ec7-0166b3b3ec0c', 'quantite': ''}, {'ingredient_id': '5b2f0918-7f7d-4d90-9ccf-cf58fa09b38f', 'quantite': '1'}, {'ingredient_id': 'fdde6d27-7591-4986-a59e-092ff85008cd', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55768, 'Curry d''agneau à l''indienne à ma façon', 'gigot d''agneau, fruits, raisins secs, poudre de coco, lait de coco, oignon, pâte de curry, poivre, sel, coriandre en grains, ail, huile, cube de bouillon, chutney, noix de coco, banane', '30 min', ['Recette longue à décrire mais très rapide à faire!', 'Désosser le gigot et coupez-le en gros cubes.', 'On peut prendre de l''épaule mais il y a plus de gras et je trouve que une fois nettoyé ça revient plus cher!', 'Faire revenir la viande dans une cocotte ou un wok (qui peut aller sur la table) pour qu''elle dore bien.', 'Ajouter les oignons et faites dorer.', 'Puis rajouter le lait de coco ou le yaourt suivant vos stocks, les fruits coupés en cubes, les raisins, la poudre de coco, l''ail, la coriandre, le bouillon cube et deux ou trois cuillères à soupe de pâte de curry suivant votre goût.', 'Salez poivrez.', 'Ajouter un peu d''eau pour couvrir à peine la viande.', 'Laissez mijoter avec le couvercle à moitié mis.', 'Le jus doit être épais, mais pas trop, la viande doit presque se couper à la fourchette.', 'Ce plat est meilleur réchauffé.', 'Préparez les petits bols pour la table et les pots de condiments divers avec une cuillère à café dans chacun.', 'Servir bien chaud dans la cocotte avec du riz basmati après avoir goûté pour rectifier éventuellement l''assaisonnement.'], ['Mixeur', 'Moule à tarte', 'Spatule', 'Tire-bouchon', 'Rouleau à pâtisserie'], ['pâte de curry', 'lait de coco', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'plats indiens', 'ail', 'plat', 'recette', 'cube de bouillon', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile', 'coriandre en grains', 'poudre de coco', 'dessert', 'plat de résistance', 'moyen', 'gigot d''agneau', 'raisins secs', 'Curry d''agneau à l''indienne à ma façon', 'fruits', 'poivre', 'cocktail'], 'Plat principal', 6926d79e-faf8-42c9-bd86-79cdf6c9f287, '2025-09-26T17:02:00.618888', [{'ingredient_id': '7ec2dcdb-39ff-4d9b-bf2e-9b643789d7d3', 'quantite': '1'}, {'ingredient_id': 'ef1b452c-1336-4850-9d65-5151b0ba45f4', 'quantite': ''}, {'ingredient_id': 'ba636ab8-2b19-488b-aadf-3b05f16690e4', 'quantite': '1'}, {'ingredient_id': '0036dd5c-e5e5-4d5a-90e3-5c9d62f35e40', 'quantite': '4 cuillères'}, {'ingredient_id': '03881422-6a6c-4228-a00d-166ac38d790b', 'quantite': '1'}, {'ingredient_id': 'ac44a645-53fe-40e0-9566-377f0e1a0958', 'quantite': '300 g'}, {'ingredient_id': '30b41f4d-e255-4541-b567-e41bec08b0d0', 'quantite': ''}, {'ingredient_id': 'c01e854e-080a-441c-926b-7cae84fe1db6', 'quantite': ''}, {'ingredient_id': '3fa50b90-6012-499f-82bd-b3c364f4aff4', 'quantite': ''}, {'ingredient_id': '65c497f3-7488-4e58-bf11-74caf06ab3fe', 'quantite': ''}, {'ingredient_id': 'aaec4fc0-131e-4cff-ba21-34fd3d08976c', 'quantite': '1 cuillères'}, {'ingredient_id': '718d20ce-3ae9-4140-aeb1-4417a8e51ebc', 'quantite': ''}, {'ingredient_id': '1dbcc2fd-741f-4c61-87ca-aa3976e19974', 'quantite': '1'}, {'ingredient_id': '227181e9-86c2-405b-9469-9b6481ede11e', 'quantite': ''}, {'ingredient_id': 'ea79634a-6b7d-4abf-a54e-c45febebf730', 'quantite': '1'}, {'ingredient_id': 'dbe374b2-67a6-4a09-87f6-b807c473a802', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28280, 'Crumble griottes bananes', 'farine, beurre, sucre roux, rhum, griotte, banane, poire, pomme, sucre vanillé', '25 min', ['1) Préchauffer le four à 180°C.', '2) Préparer la pâte à crumble : mettre la farine et la cassonade dans un saladier. Mélanger.', '3) Faire fondre le beurre légèrement. Ajoutez le bouchon de rhum (ou de fleur d’oranger ou quelques gouttes d’arôme amande amère selon les goûts).', '4) Verser le beurre fondu dans la préparation farine/sucre. Mélanger à la cuillère et terminer du bout des doigts jusqu’à former des miettes de pâte. Rassembler les miettes en une boule et mettre au réfrigérateur le temps de préparer les fruits.', '5) Mettre les cerises dans le plat. Couper les bananes en rondelles, la poire et la pomme en cubes, et les ajouter aux cerises.', '6) Saupoudrer les fruits de sucre vanillé. Bien mélanger.', '7) Émietter la pâte sur les fruits de manière à les recouvrir entièrement.', '8) Faire cuire 35 min environ, jusqu’à ce que la pâte soit légèrement dorée.', '9) Laisser tiédir, voire refroidir.'], ['Casserole', 'Pince de cuisine', 'Rouleau à pâtisserie'], ['entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'Crumble griottes bananes', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'autres crumbles', 'beurre', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:02:04.480985', [{'ingredient_id': '829e5eb2-e291-42dc-9101-c8bf82dd99d8', 'quantite': '200 g'}, {'ingredient_id': 'cb96a352-3b40-4788-ac65-3484c6bea8f1', 'quantite': '120 g'}, {'ingredient_id': '0247f913-4eab-49ee-80b2-c36bf172f836', 'quantite': '110 g'}, {'ingredient_id': 'f9c6a1ca-ed5b-4c9e-a348-2de702c6db72', 'quantite': '5 ml'}, {'ingredient_id': '5d3cbadf-a138-45a2-9f7c-d15cd29c61e5', 'quantite': '200 g'}, {'ingredient_id': 'e684151f-9ae5-4c80-9ecf-117fd4a5ab4d', 'quantite': '2'}, {'ingredient_id': 'bc848e30-0ea1-41fe-91a2-a684a49defc2', 'quantite': '1'}, {'ingredient_id': '147e3604-22b6-4f34-9d98-a01011d3dcd1', 'quantite': '1'}, {'ingredient_id': 'a6aa5ff6-6439-4e22-8a3f-724f183e9339', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (39400, 'Melon farandole', 'melon, banane, sirop de fraise, citron, Chocolat smarties', '10 min', ['Dans des coupelles, mélanger des rondelles de banane citronnées, et des billes de melon. Napper de sirop de fraise, et parsemer de smarties.'], ['Râpe', 'Passoire', 'Poêle', 'Fouet'], ['', 'melon', 'sirop de fraise', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'Melon farandole', 'boisson', 'Chocolat smarties', 'dessert', 'plat de résistance', 'citron', 'cocktail'], 'Dessert', fecd5afa-4009-4d02-b45e-601d94fec8b6, '2025-09-26T17:02:09.524708', [{'ingredient_id': '2993e089-a0d1-4f6f-9eb9-8f433d2d10b8', 'quantite': '2'}, {'ingredient_id': 'e355ff48-1e67-4f62-8e1a-af789f6c1b8e', 'quantite': '2'}, {'ingredient_id': 'c98b9d49-808c-4abf-9efd-74b1d704c3df', 'quantite': '2 cuillères'}, {'ingredient_id': '6b52f9cd-afdf-498d-b083-27a1efbade0b', 'quantite': '1'}, {'ingredient_id': '38821681-210e-42c5-9ab0-ddb5374cbde6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (212926, 'Glace à la banane lègère', 'banane, yaourt nature, fromage blanc', '30 min', ['Sortir les ingrédients du frigo. Couper les bananes en morceaux et les mixer avec les yaourts et les fromages blancs.', 'Verser dans la sorbetière et laisser prendre environ 20 min (en fonction de votre sorbetière)', 'Si on aime la glace plus ferme, on peut la mettre un peu au congélateur pour la faire durcir.'], ['Pince de cuisine', 'Ouvre-boîte', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Glace à la banane lègère', 'fromage blanc', 'dessert', 'plat de résistance', 'glace à l''italienne', 'cocktail'], 'Dessert', cc5ba399-0afe-4a19-9ce1-55dfe00dc953, '2025-09-26T17:02:14.490400', [{'ingredient_id': '27b9e135-9268-4666-aa82-376bca9e529e', 'quantite': '3'}, {'ingredient_id': 'c48661b5-1722-4c15-abd7-8e940bde6253', 'quantite': '2'}, {'ingredient_id': 'a89de45d-ff84-48bb-be95-e69cd869935c', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28129, 'Salade des îles au rhum', 'mangue, banane, orange, litchi, kiwi, sucre de canne, rhum', '20 min', ['Éplucher les bananes, les mangues et les oranges.', 'Découper les bananes en rondelles, les mangues en dés et les oranges en quartiers.', 'Mélanger ces fruits dans un saladier, ajouter le sucre et le rhum. Laisser mariner au réfrigérateur pendant 2 heures en remuant régulièrement.', 'Peler les litchis et les kiwis.', 'Dénoyauter les litchis et couper en morceaux les kiwis.', 'Les ajouter à la salade de fruits et servir.'], ['Louche', 'Tire-bouchon'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'Salade des îles au rhum', 'sucre de canne', 'dessert', 'plat de résistance', 'moyen', 'orange', 'litchi', 'cocktail'], 'Dessert', a48f7ada-505c-4759-b51c-3fc1ea8c8228, '2025-09-26T17:02:19.019820', [{'ingredient_id': '78688888-ed0e-40fa-a5c6-28b7202067c2', 'quantite': '1'}, {'ingredient_id': 'aa201580-ca34-4c42-91bc-615e6bb4dcc8', 'quantite': '2'}, {'ingredient_id': '9aa657f1-0a9d-44f4-a2ad-c76c5315024d', 'quantite': '2'}, {'ingredient_id': '39356642-e10a-4406-a5ec-50c1da0b7aee', 'quantite': '8'}, {'ingredient_id': '46f6b759-02ae-4c7b-aa67-df8d803c580c', 'quantite': '2'}, {'ingredient_id': 'c1794fa4-18b8-4f29-98c6-9cb47a354dbb', 'quantite': '100 g'}, {'ingredient_id': '053d22ea-9468-4c4e-affc-74e8a1bf82b5', 'quantite': '8 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31220, 'Fromage blanc créole', 'fromage blanc, sucre, banane, noix de coco rapée, citron, rhum', '10 min', ['Mixer le tout. Il est possible d''ajouter ensuite des raisins secs trempés dans le rhum.', 'Servir en coupes et parsemer de granuler de chocolat.'], ['Tire-bouchon', 'Fouet', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'Fromage blanc créole', 'boisson', 'fromage blanc', 'noix de coco rapée', 'dessert', 'plat de résistance', 'citron', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:02:22.663684', [{'ingredient_id': '038e071d-d337-49d5-a215-92e1e0594140', 'quantite': '300 g'}, {'ingredient_id': '9af1501f-a0ce-473c-9d47-a2eaacb3fe8b', 'quantite': '3 cuillères'}, {'ingredient_id': 'f407f347-6ec0-456e-afd3-d8ade3aac14b', 'quantite': '2'}, {'ingredient_id': 'f4f2f886-2148-45a2-8c0c-44f3a623b4aa', 'quantite': '2 cuillères'}, {'ingredient_id': '119d958d-5777-4798-a206-e0510b37e040', 'quantite': '1'}, {'ingredient_id': '13a1d611-2b14-418a-9327-6f20b957f942', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345030, 'Fondant végétalien chocolat-banane', 'banane, sucre, chocolat, margarine, farine', '10 min', ['Préchauffer le four à 150°C (thermostat 5).', 'Éplucher la banane et la faire chauffer au micro-ondes pendant 30 secondes. ', 'Ajouter 100 g de sucre à la banane et fouetter à la fourchette.', 'Dans un autre récipient, casser 200 g de chocolat noir et ajouter la margarine végétale. ', 'Faire fondre au micro-ondes, puis verser le chocolat dans la banane et et sucre.', 'Ajouter la farine et bien mélanger.', 'Verser la préparation dans le moule (elle est assez compacte, il faut égaliser soi-même et choisir un moule assez plat). ', 'Faire cuire 25 minutes.'], ['Pince de cuisine', 'Rouleau à pâtisserie', 'Balance de cuisine', 'Spatule', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'margarine', 'Fondant végétalien chocolat-banane', 'dessert', 'fondant au chocolat', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', bfbf24d5-8051-4af0-a9a0-7233b29d623d, '2025-09-26T17:02:26.428559', [{'ingredient_id': '18732c46-49b1-40e1-a489-b94f628bdb5a', 'quantite': '1'}, {'ingredient_id': '24ec137f-dada-423b-95fd-6e8925111c58', 'quantite': '100 g'}, {'ingredient_id': '462b56a3-4ab3-44c2-87cc-a81d0a1ff6b1', 'quantite': '200 g'}, {'ingredient_id': 'defc2889-79fe-4f30-9167-b32077f075f7', 'quantite': '100 g'}, {'ingredient_id': '46b0a51e-3229-4508-8f1f-8c17893f3bb1', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50743, 'Gâteau tendre à la banane et aux noix', 'banane, farine, sucre, beurre salé, oeuf, noix, vanille, levure chimique', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Ecraser les bananes à la fourchette puis les mixer progressivement avec le beurre, le sucre, les oeufs, la vanille, les noix et le mélange farine-levure.', 'Verser la préparation dans un moule beurré et enfourner pour 50 minutes de cuisson.'], ['Passoire', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'beurre salé', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'noix', 'recettes', 'boisson', 'farine', 'vanille', 'dessert', 'plat de résistance', 'gâteau à la banane', 'sucre', 'Gâteau tendre à la banane et aux noix', 'cocktail'], 'Dessert', c32e1f36-6b50-4db1-a65c-5503722afdcc, '2025-09-26T17:02:30.192215', [{'ingredient_id': '89803e26-ba94-48bf-b374-aee944941a89', 'quantite': '3'}, {'ingredient_id': 'ba1c72d9-0cc4-49d6-aea3-1e1bfed0892d', 'quantite': '220 g'}, {'ingredient_id': '5067b16f-a295-4305-b90c-c3aceb9cb0ca', 'quantite': '100 g'}, {'ingredient_id': '7771206b-d12a-49d2-b6a3-148ba9a9df98', 'quantite': '100 g'}, {'ingredient_id': '55155f67-b0fe-481e-953e-4f749e7e7f00', 'quantite': '2'}, {'ingredient_id': 'ce806876-8ab0-4a34-91d6-dbbf280a8981', 'quantite': '50 g'}, {'ingredient_id': '204f7228-83be-477a-81e5-38b0e663bc7f', 'quantite': '1 cuillères'}, {'ingredient_id': 'e43e156d-ebde-4684-9346-08784cafbd6d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70407, 'feuilleté choco banane', 'pâte feuilletée, banane, toblerone, crème fraîche, jaune d''oeuf', '10 min', ['Préchauffer le four à 200c° (thermostat 6-7).', 'Diviser une pâte feuilletée achetée en supermarché en 4 parts égales et la présenter sous forme de carré.', 'Disposer 1/2 banane coupée en rondelles ainsi que 20g de chocolat tobberone dans chaque portion et en recouvrir chacune d''elles d''une cuillère à café de crème fraîche.', 'Refermer chaque part hermétiquement.', 'Récupérer le jaune d''oeuf et à l''aide d''un pinceau de cuisine, l''étaler sur la pâte.', 'Enfourner pendant 20 min en surveillant la cuisson.', 'C''est prêt à déguster chaud ou tiède selon les goûts.'], ['Planche à découper', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'recettes', 'toblerone', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'feuilleté choco banane', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:02:33.688410', [{'ingredient_id': 'dce00e64-2d4d-4962-970b-a24a6493f337', 'quantite': ''}, {'ingredient_id': '1a96ae4b-1bd6-4704-b966-d6722ebd26d2', 'quantite': '2'}, {'ingredient_id': 'b5a28ca3-b5d5-4ff1-bda1-d7c735060a04', 'quantite': '80 g'}, {'ingredient_id': 'd992503f-4672-4c2c-a5ff-0b265a6fd1d3', 'quantite': '4 cuillères'}, {'ingredient_id': '26bb1ed0-2d58-44df-bfac-0e484f02ee09', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (45911, 'Compote pommes bananes et noix de coco', 'pomme, banane, sucre vanillé, noix de coco, eau', '15 min', ['Peler les pommes et les couper en dés.', 'Couper les bananes en rondelles.', 'Mettre les dés de pommes, les rondelles de banane, les deux sachets de sucre vanillée, et les deux cuillères de noix de coco en poudre dans une casserole.', 'Ajouter les deux verres d''eau, et laisser réduire pendant 1 heure, à feu doux (remuer de temps en temps).', 'Une fois cuit, on peut la mixer (ou non), selon les goûts car il reste quelques morceaux dans la casserole.', 'Laisser refroidir, et déguster avec des galettes Saint-Michel ou tout autre accompagnement.'], ['Fouet', 'Casserole', 'Rouleau à pâtisserie', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'compote de pomme', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Compote pommes bananes et noix de coco', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'noix de coco', 'cocktail'], 'Dessert', e6170933-b878-4b60-b8e1-c70c558e02cc, '2025-09-26T17:02:37.278153', [{'ingredient_id': '29fa8aa2-de1b-45fe-9323-f6930495dc71', 'quantite': '5'}, {'ingredient_id': '9093b947-83d8-4f3a-bf35-367d90284326', 'quantite': '2'}, {'ingredient_id': '2bc4e5d6-3ecd-46bd-b047-1faaf3fe717d', 'quantite': '2'}, {'ingredient_id': '98360d3c-156d-4a13-a0a5-caac3dee3529', 'quantite': '2 cuillères'}, {'ingredient_id': '28560cc0-d1b7-45f6-8b82-cf41e593c5e1', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38765, 'Milkshake banane sur coulis de fraise', 'fraises, banane, glace fraise, sucre, lait', '10 min', ['Couper les fraises en petits morceaux et les écraser grossièrement avec le sucre, réserver.', 'Mettre dans un blender les bananes,les boules de glace et le lait. Mixer jusqu''à l''obtention d''un milkshake onctueux.', 'Prendre des coupelles de glace, mettre les fraises au fond et verser le milkshake. Réserver au frais au moins deux heures. ', 'Pour la décoration je rajoute des morceaux de fraises et de la chantilly. Un délice !'], ['Louche', 'Casserole', 'Batteur électrique', 'Râpe', 'Spatule'], ['coulis de fruits rouges', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'glace fraise', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'Milkshake banane sur coulis de fraise', 'dessert', 'plat de résistance', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:02:40.965274', [{'ingredient_id': '66c6b5e1-d967-4ea6-b938-e8384e623b2b', 'quantite': '1'}, {'ingredient_id': '8bf87f38-bdc5-46d8-843b-64468fa403cb', 'quantite': '2'}, {'ingredient_id': '0d0771fd-ebf5-4e9a-a5f0-35962e73ea56', 'quantite': '1'}, {'ingredient_id': 'bbe166b0-a7d1-4733-ad5c-9f2b607b5ba3', 'quantite': '2 cuillères'}, {'ingredient_id': 'b2481156-cbbc-4067-8e94-959088fc5641', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (25819, 'Confiture de rhubarbe à la banane', 'rhubarbe, orange, banane, citron, sucre en poudre', '20 min', ['Grattez et coupez la rhubarbe en petits morceaux.', 'Pelez les oranges à vif et découpez-les en rondelles.', 'Pelez et coupez les bananes en morceaux.', 'Dans une grande marmite, mettez tous les fruits (sauf les citrons) et portez à ébullition. Laissez cuire en compote environ 15 min en remuant.', 'Pesez la compote et ajoutez 800 g de sucre par kilo de compote.', 'Faites bouillir et laissez cuire 20 min en surveillant et en remuant de temps en temps.', 'Ajoutez le jus des citrons, laissez bouillir encore 5 min puis écumez et mettez en pots.'], ['Planche à découper', 'Louche', 'Ouvre-boîte', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiture de rhubarbe', 'confiserie', 'testées', 'rhubarbe', 'facile', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'citron', 'orange', 'Confiture de rhubarbe à la banane', 'cocktail'], 'Confiserie', 733162ae-3f33-4866-ae4b-a59a4b8ec14b, '2025-09-26T17:02:44.425979', [{'ingredient_id': '54a68b42-7f26-4f8d-90ac-36026ba2a7eb', 'quantite': '2 kg'}, {'ingredient_id': 'f4684ce7-b7e3-4e69-a42f-54b608729455', 'quantite': '6'}, {'ingredient_id': 'dbde529c-b8ee-4695-80ea-b759e2aac1c1', 'quantite': '6'}, {'ingredient_id': '035ddc54-3e03-4910-bfde-f6ed1c1fba91', 'quantite': '3'}, {'ingredient_id': '757ef73d-4db5-480c-828c-08106a9fcc42', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (53637, 'Escalopes de dinde à la banane', 'escalope de dinde, oignon, banane, crème fraîche, tortellini', '10 min', ['Hacher finement l''oignon, puis le faire délicatement roussir dans la poêle.', 'Faire saisir les escalopes avec les oignons; baisser le feu afin de ne pas les faire noicir.', 'Couper la bananes en lamelles et les rajouter dans la poêle; laisser cuire 2 min. Ajouter la crème et laisser cuire 5 min.'], ['Fouet', 'Pince de cuisine', 'Presse-agrumes', 'Balance de cuisine', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'escalopes', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'escalope de dinde', 'Escalopes de dinde à la banane', 'dessert', 'plat de résistance', 'tortellini', 'cocktail'], 'Plat principal', 9658acba-1f2e-4080-9b63-bef793350e2a, '2025-09-26T17:02:48.141206', [{'ingredient_id': '37de782b-34a9-4c4a-a0a9-e4c6ad5b5395', 'quantite': '2'}, {'ingredient_id': 'b55a153b-a9fd-454b-857d-c23c56e3bb3f', 'quantite': '1'}, {'ingredient_id': 'fba076e3-0867-4713-bc8a-364ddfc40ee6', 'quantite': '1'}, {'ingredient_id': 'b9aa35f2-5730-4c7b-bbcf-e6f943dcd257', 'quantite': '1'}, {'ingredient_id': '6e6b0c12-5536-4f58-b535-94198a677ee8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26429, 'Bananes au bacon', 'banane, bacon', '3 min', ['Coupez les bananes dans le sens de la largeur puis coupez chaque moitié en bouts. ', 'Enroulez chaque bout de banane dans un morceau de bacon et piquez le tout avec un cure-dent. ', 'Mettre les bananes-bacon sur une plaque et enfournez à four à température moyenne pendant quelques minutes. ', 'Le temps de cuisson est à surveiller car il ne faut pas que les bouts de banane soient réduits en purée ni le bacon brûlé. ', 'Régalez-vous !'], ['Louche', 'Économe'], ['', 'bacon', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Bananes au bacon', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:02:52.869742', [{'ingredient_id': '08bbbe71-577b-4e7d-9835-854e75b58799', 'quantite': ''}, {'ingredient_id': 'ebf8593e-a0dc-45d4-820a-4adfcd698a1b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28704, 'crumble pommes, poires et bananes', 'farine, beurre, sucre roux, chocolat, amandes, corn flakes, levure chimique, cannelle, poire, pomme, banane', '30 min', ['Dans un saladier, mélangez du bout des doigts, la farine, la levure, la cannelle, la poudre d''amande, une pincée de sel et le beurre coupé en morceaux. Après avoir obtenu des grosses miettes, ajoutez le sucre ainsi que les corn flakes concassés et continuez à mélangez sans défaire les miettes. Ajoutez en dernier les pépites de chocolat. ', 'Disposez les fruits coupés en morceaux dans un plat avec un peu de citron et éventuellement un peu d''alcool de votre choix puis versez votre mélange sur les fruits en comblant les trous. ', 'Mettre à cuire 35 à 40 mn dans le four préchauffé à 190°C . ', 'Le crumble se déguste de préférence chaud ou tiède, accompagné de crème anglaise, de chantilly ou d''une boule de glace.'], ['Presse-agrumes', 'Économe', 'Fouet'], ['amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'corn flakes', 'chocolat', 'poire', 'très facile', 'bon marché', 'crumble aux pommes', 'crumble pommes', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'poires et bananes', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'cannelle', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:02:56.607728', [{'ingredient_id': '7dd2edc7-6792-4e57-8567-8ea0ed1a1d7c', 'quantite': '225 g'}, {'ingredient_id': '7ba25e1b-fbde-4499-8e81-a2bdb03b844c', 'quantite': '125 g'}, {'ingredient_id': '42af14a2-5a55-4d75-9ec9-a486aad84a4b', 'quantite': '100 g'}, {'ingredient_id': '79f27563-dc50-4535-9ecb-eab9199f2522', 'quantite': '100 g'}, {'ingredient_id': 'bf194a19-cc91-46d8-862c-5ef5e69f9bc0', 'quantite': '100 g'}, {'ingredient_id': '9235b5f0-75f9-453e-9e22-63406925b648', 'quantite': '4 cuillères'}, {'ingredient_id': 'd4de6567-a123-40eb-89bf-98410d5a3054', 'quantite': ''}, {'ingredient_id': '869d781e-57af-4fb0-a5b7-dc8108bc1d73', 'quantite': ''}, {'ingredient_id': '29c2c137-cbee-4929-8c44-6dfcf404f19d', 'quantite': '3'}, {'ingredient_id': '8f506be4-d5c8-4f56-a853-845c3763756d', 'quantite': '3'}, {'ingredient_id': '3726a41c-655e-4801-b30d-dc725fb40888', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20573, 'bonbons piment de la Réunion', 'pois, cumin, cumin, gingembre, coriandre, oignon, petit piment, safran, coriandre, sel, poivre, banane, caloupilé', '10 min', ['Faire tremper la veille (env 12 h) les pois dans l''eau. ', 'Le jour même, enlever les peaux des haricots en pressant le grain entre le pouce et l''index. C''est la partie la plus laborieuse de la recette, je pense!!', 'Les égoutter, les passer au mixeur, vous devez obtenir une pâte fine. ', 'Mixer ensemble : piments, gingembre, sel, cotomili, caloupilé, cumin. Hacher finement les oignons verts.', 'Mélanger les épices pilées plus 1 cuillère à soupe de coriandre, 1 cuillère à café de cumin, les oignons verts, 1/4 de cuillère à café de safran, la banane écrasée et toute la pâte de pois du cap. ', 'Sur une feuille d''aluminium humidifiée, former des boulettes qui font l''équivalent d''une bouchée (3cm de diamètre). ', 'Aplatir en creusant un trou au centre de la boulette. ', 'Chauffer l''huile dans une poêle. ', 'Cuire les bonbons piments à feu moyen.', 'Laisser dorer chaque côté sans trop les "brûler".', 'Cet amuse-gueule se savoure chaud ou tiède, ou alors repassé au four si déjà froid (éviter le micro-ondes)'], ['Économe', 'Pince de cuisine', 'Ouvre-boîte', 'Casserole'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'petit piment', 'testées', 'pois', 'cumin', 'caloupilé', 'rapide', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'bonbons piment de la Réunion', 'coriandre', 'poivre', 'cocktail', 'safran'], 'Amuse-gueule', 68587123-4e52-419f-aa3f-5483839258ad, '2025-09-26T17:03:00.365997', [{'ingredient_id': 'fef99c90-8e69-40b6-a8f9-f8f0da24b7cd', 'quantite': '500 g'}, {'ingredient_id': '5f606730-6ccc-4338-8023-d18b07179bb3', 'quantite': '1 cuillères'}, {'ingredient_id': 'c9ecf537-a819-435e-9465-c7852e5635b5', 'quantite': '1 cuillères'}, {'ingredient_id': 'b558ff1b-aa3c-48b1-b565-6f517b4797f5', 'quantite': '10 g'}, {'ingredient_id': '39cb22e4-918e-43aa-8931-cfbb54707e7c', 'quantite': '1'}, {'ingredient_id': 'bd567b85-fa8f-432e-8a7b-9b59bd29083a', 'quantite': '1'}, {'ingredient_id': 'a1e118f0-0b90-4ec2-ab7f-936189b3260a', 'quantite': '10'}, {'ingredient_id': 'ddab5ffd-bda8-48cb-9802-888478f1660e', 'quantite': ''}, {'ingredient_id': '54fb26b2-b7d4-45b5-83d2-56e7cf1fe927', 'quantite': '1 cuillères'}, {'ingredient_id': 'c0b468e5-18a9-4e82-9685-39e17d6a404c', 'quantite': ''}, {'ingredient_id': 'b7a9f282-2ffa-4c37-8e16-e158663573a3', 'quantite': ''}, {'ingredient_id': 'a7dfaf60-21ef-4fa5-ad23-124ba59cd37b', 'quantite': ''}, {'ingredient_id': '1bc685ea-258e-4749-aeda-4f662664fe53', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16442, 'Bavarois à la banane', 'banane, citron, sucre, lait, jaune d''oeuf, sucre en poudre, vanille, gélatine, crème liquide, sucre glace, ananas', '30 min', ['Prévoir un moule à bavarois en couronne pour faciliter le démoulage.', 'Commencer par préparer la crème anglaise: faire bouillir le lait, mélanger vivement les jaunes avec le sucre et la vanille et mettre dans de l''eau froide les feuilles de gélatine. Verser dessus le lait chaud et mélanger aussitôt activement.', 'Faites cuire sans bouillir et tout en mélangeant. Il faut que la crème nappe la cuillère en bois.', 'Hors du feu, ajouter à la crème chaude les feuilles de gélatine préalablement ''essorées''. Filtrer ensuite le tout au travers d''une passoire fine, puis laissez refroidir.', 'Fouetter la crème fraîche en Chantilly en lui incorporant le sucre glace. Beurrer le moule à bavarois. Mixer la pulpe de bananes et le jus des citrons. Mélanger cette pulpe à la crème anglaise refroidie.', 'Pour finir, incorporer la Chantilly à votre préparation. Garnissez-en le moule jusqu''à 1cm du bord et laisser prendre au réfrigérateur 4 à 5 heures (ou 1 nuit).', 'Démouler enplongeant éventuellement le moule dans de l''eau chaude après avoir décollé les bords avec la lame d''un couteau.', 'Présenter avec des lamelles d''ananas au centre de la couronne, puis décorer de quelques feuilles de menthe.'], ['Pince de cuisine', 'Spatule', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'bon marché', 'plat', 'moyenne', 'bavarois', 'recette', 'cuisine', 'recettes', 'boisson', 'Bavarois à la banane', 'dessert', 'plat de résistance', 'citron', 'sucre', 'cocktail'], 'Dessert', 75cea94e-3cd5-4c30-b3c7-40e287377fa8, '2025-09-26T17:03:04.280670', [{'ingredient_id': 'd9dac28f-60bb-4815-833b-71f7110d35fc', 'quantite': '6'}, {'ingredient_id': 'e0a9d378-2c56-4453-b381-df7188f40e8a', 'quantite': ''}, {'ingredient_id': 'd8471fb8-f55b-4ee7-a119-e52cfab0bc6a', 'quantite': '50 g'}, {'ingredient_id': 'f590272e-70de-4182-8bef-1ed6b05f2ca7', 'quantite': ''}, {'ingredient_id': '7529d5ff-c520-40f0-afd2-b4f78d03235a', 'quantite': '4'}, {'ingredient_id': 'ed91d021-0385-4a2c-975b-cc2139d0185f', 'quantite': '50 g'}, {'ingredient_id': '8a5c6cf8-a121-46b3-9d15-6f38de4f71c5', 'quantite': '1'}, {'ingredient_id': '9237b87a-4f10-4eb8-9139-be233879ae96', 'quantite': '3'}, {'ingredient_id': 'a3e96bd5-37a0-45c8-9318-814a90719be3', 'quantite': '2'}, {'ingredient_id': 'd3773b95-6dfe-417a-b844-22e7dcef34dd', 'quantite': '2 cuillères'}, {'ingredient_id': '95d539e8-ad7a-40e8-b320-f5db253049ff', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (233014, 'Boules sablées banana pomme', 'pâte sablée, banane, pomme, jaune d''oeuf', '20 min', ['Détailler la banane en rondelles et la pomme en dés.', 'Préchauffer le four à 200°C (thermostat 6-7).', 'Etaler la pâte sablée et y découper à l''aide d''un verre un nombre pair de ronds de pâte.', 'Mettre les ronds de pâte sur une plaque à four recouverte de papier sulfurisé.', 'Sur chaque rond, disposer une rondelle de banane et 2 petits dés de pomme. Refermer la pâte sur les fruits pour fermer des petites boules de pâte. ', 'Badigeonner de jaune d''oeuf légèrement dilué avec quelques gouttes d''eau.', 'Enfourner pour 35 minutes de cuisson.'], ['Spatule', 'Verre doseur', 'Pince de cuisine', 'Rouleau à pâtisserie', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Boules sablées banana pomme', 'confiserie', 'testées', 'facile', 'bon marché', 'pâte sablée', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:03:08.732876', [{'ingredient_id': 'faa4e8e8-013b-45ad-a5be-c77c66a28fcc', 'quantite': '1'}, {'ingredient_id': 'cade2067-a862-4e2d-9dde-0575b05dfa61', 'quantite': '2'}, {'ingredient_id': '9c96460b-7d1c-4ead-bb8a-5aa08c93ec6e', 'quantite': '1'}, {'ingredient_id': '71512f26-bd80-43c9-abcb-6decc9dacf1d', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (173794, 'Charlotte nutella-banane', 'Nutella, oeuf, beurre, biscuits à la cuillère, banane', '10 min', ['Faire chauffer au micro-ondes à basse température le nutella et le beurre environ 30 à 40 secondes. ', 'Ajouter les 2 jaunes d''œuf et mélanger.', 'Battre les blancs en neige et les ajouter à la préparation précédente.', 'Tapisser un moule à charlotte avec les biscuits à la cuillère. Mettre la moitié de la mousse au nutella. Ajouter des rondelles de banane puis verser le reste de la mousse. ', 'Refermer avec des biscuits et mettre au frais quelques heures avant de servir.'], ['Mixeur', 'Poêle', 'Moule à tarte', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'biscuits à la cuillère', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Nutella', 'Charlotte nutella-banane', 'dessert', 'plat de résistance', 'charlotte aux fruits', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:03:12.331333', [{'ingredient_id': '0f3e937c-107b-42ac-95b0-0e5a3186715b', 'quantite': '100 g'}, {'ingredient_id': 'db8df5d3-5941-4a2d-b83b-8de59cb3f526', 'quantite': '2'}, {'ingredient_id': 'a7783f33-89ec-4c2e-b374-1275aed73ffb', 'quantite': '40 g'}, {'ingredient_id': '9f717f3d-d85b-4814-ae77-04e2382edfed', 'quantite': '24'}, {'ingredient_id': '31870d51-652e-40cd-a9d7-9b7c84a4c40f', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (313755, 'Délice pomme - banane - orange', 'pomme, banane, orange, jus de citron', '5 min', ['Pressez les oranges et réservez le jus. Lavez les pommes, épluchez-les.  Retirez le coeur et les pépins, puis coupez-les en petits morceaux, que vous mettez dans un blender. Faites fonctionner l''appareil par petites impulsions pour réduire les pommes en purée. Mouiller avec un peu de jus d''orange pour faciliter l''opération.', 'Épluchez les bananes, taillez-les en rondelles et ajoutez-les aux pommes.  Continuez à mixer pour bien écraser et faire mousser.  ', 'Complétez avec le jus d''orange et le jus de citron jusqu''à l''obtention de la consistance désirée. Mettez au frais jusqu''au moment de déguster.', 'Pour servir, versez la boisson dans de jolis verres.  ', 'Ajoutez éventuellement quelques glaçons.'], ['Casserole', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Délice pomme - banane - orange', 'dessert', 'plat de résistance', 'jus de citron', 'pomme', 'orange', 'cocktail'], 'Dessert', 4225c68a-bf82-4ff1-9e31-10240aef127e, '2025-09-26T17:03:16.815046', [{'ingredient_id': 'f25ad286-7a7e-4c86-8c1f-3162ef2308d1', 'quantite': '2'}, {'ingredient_id': 'd61960a7-cc4e-45c4-908a-92544b1c7011', 'quantite': '2'}, {'ingredient_id': '1dbf42bd-a808-4570-aaaf-55343141b2ab', 'quantite': '2'}, {'ingredient_id': '31f1ce9f-b6eb-445e-ac88-24592474c2f2', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21889, 'Beignets de banane, coulis aux abricot', 'banane, farine, levure de boulanger, sel, eau, huile, blanc d''oeuf, rhum, sucre, vanille, confiture d''abricot, huile de friture', '50 min', ['Délayez la levure dans 5 cl d''eau tiède. Couvrez et laissez ce levain patienter 10 minutes.', 'Coupez 6 bananes en 4 et arrosez de rhum.', 'Détaillez les autres bananes en rondelles et mettez-les dans une casserole avec le sucre, la confiture d''abricot délayée dans 10 cl d''eau, les graines et la gousse de vanille. Amenez à ébullition et laissez cuire 25 minutes à frémissement. Laissez refroidir, ôtez la gousse de vanille et passez au mixeur pour obtenir un coulis.', 'Préparez la pâte à beignets en mélangeant le levain avec la farine tamisée, le sel et 15 cl d''eau tiède. Fouettez la pâte puis ajoutez le reste d''eau et l''huile. Laissez la pâte reposer 45 minutes. ', 'Faites chauffer le bain de friture. ', 'Montez les blancs d''oeufs en neige avec une pincée de sel puis incorporez-les à la pâte. ', 'Confectionnez les beignets de banane au dernier moment. Trempez les tranches de banane dans la pâte et faites-les frire dans l''huile jusqu''à ce que les beignets soient bien dorés. Egouttez-les sur du papier absorbant et accompagnez du coulis abricot-banane.  '], ['Passoire', 'Verre doseur', 'Poêle', 'Planche à découper'], ['coulis de fruits rouges', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'eau', 'testées', 'huile de friture', 'facile', 'rapide', 'plat', 'recette', 'confiture d''abricot', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'vanille', 'dessert', 'plat de résistance', 'coulis aux abricot', 'moyen', 'Beignets de banane', 'sucre', 'blanc d''oeuf', 'levure de boulanger', 'cocktail'], 'Dessert', 8461cda4-e8c7-405f-ab26-2b37b64c49a2, '2025-09-26T17:03:21.475630', [{'ingredient_id': 'ec1472ea-fb24-4f0c-ae19-0652a4e52d14', 'quantite': '8'}, {'ingredient_id': '0f7d89b4-ccbe-47f8-bbcd-80477824c718', 'quantite': '200 g'}, {'ingredient_id': 'f5423f93-d811-4e13-875a-ad124fde3874', 'quantite': '20 g'}, {'ingredient_id': '9fcd3269-8dc0-4bd7-9c30-33534c0042da', 'quantite': ''}, {'ingredient_id': '6ee51fee-30bb-42f7-a842-69b7ee56c597', 'quantite': '25 cl'}, {'ingredient_id': 'c6ea8f4c-d305-42b7-a5d4-ea9ee59405d3', 'quantite': '3 cuillères'}, {'ingredient_id': 'f8851ebe-b9b0-45c5-b7d7-58cfc5531800', 'quantite': '2'}, {'ingredient_id': '13805cd0-5019-4633-a0b1-6704ccd2c5ae', 'quantite': '7 cl'}, {'ingredient_id': 'c9d744c4-de22-49f6-bc94-47e418b234d5', 'quantite': '4 cuillères'}, {'ingredient_id': '2c302f62-3d9f-40ee-b178-19aae1149ee2', 'quantite': '1'}, {'ingredient_id': 'aaf9da30-27d6-4d0b-8374-e5257249843e', 'quantite': '6 cuillères'}, {'ingredient_id': 'bf2a899d-9a18-484f-895c-15e30e6673d4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36818, 'Tartelettes à la banane, sauce chocolat', 'pâte feuilletée, banane, sucre en poudre, beurre, chocolat pâtissier, crème fraîche liquide', '10 min', ['Découper 4 petits cercles dans la pâte à l''aide d''un bol.', 'Couper en rondelles les bananes et les disposer sur les cercles.', 'Saupoudrer légèrement de sucre et ajouter quelques noisettes de beurre.', 'Mettre au four 10 à 15 min à 200°C (thermostat 6-7).', 'Pendant ce temps, préparer la sauce au chocolat : ', 'Faire chauffer la crème liquide. ', 'Découper le chocolat en petits morceaux, et le faire fondre doucement dans la crème à feu très doux.', 'Servir les tartes tièdes, avec la sauce chaude.'], ['Presse-agrumes', 'Casserole', 'Louche', 'Spatule'], ['entrée', 'banane', 'Tartelettes à la banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'sucre en poudre', 'recette', 'crème fraîche liquide', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'dessert', 'sauce chocolat', 'plat de résistance', 'pâte feuilletée', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:03:25.221484', [{'ingredient_id': '2534c8c1-c1e4-407a-a93e-a3dcedc8a634', 'quantite': '1'}, {'ingredient_id': 'e6789987-0c60-49b3-b18c-4c0293592121', 'quantite': '4'}, {'ingredient_id': '2b652b3c-92f3-472f-8100-5cf47903b81d', 'quantite': ''}, {'ingredient_id': '1e4517ea-18e8-4f38-88da-4d189a10d7ae', 'quantite': ''}, {'ingredient_id': 'd7feb63d-582c-4b8b-9a52-f997d8263602', 'quantite': '1'}, {'ingredient_id': '05b05481-eff1-4d78-92d9-eefd37ca29f9', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16261, 'Gâteau à la banane (sans beurre)', 'farine, sucre, oeuf, levure, banane, citron, cannelle', '15 min', ['Préchauffer le four à thermostat 5.', 'Dans un plat, mélanger les jaunes d''oeufs, le sucre et le zeste du citron râpé, puis fouetter jusqu''à blanchissement.', 'Ajouter la moitié de la farine, la levure, la cannelle. Ajouter les bananes coupées en dés et le jus du citron.', 'Ajouter le reste de la farine. Incorporer les blancs battus en neige.', 'Beurrer le moule et laisser cuire à thermostat 5 pendant près d''une heure.'], ['Couteau de chef', 'Fouet', 'Planche à découper', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'Gâteau à la banane (sans beurre)', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'citron', 'cannelle', 'sucre', 'cocktail'], 'Dessert', bdc3fd9f-f531-46be-92c3-d64daf5cedb8, '2025-09-26T17:03:28.803959', [{'ingredient_id': '7d97a185-7620-4067-a124-8ae37f01a490', 'quantite': '185 g'}, {'ingredient_id': 'd80cb727-caac-4a92-8ef9-ed251a50b3f2', 'quantite': '125 g'}, {'ingredient_id': '408ef873-91a8-48f8-9dc8-b868611ed7a1', 'quantite': '3'}, {'ingredient_id': '137c4162-a99e-4145-b6ba-fdbde026628e', 'quantite': '2 cuillères'}, {'ingredient_id': '5ed6d185-4164-4ab1-a0d5-fb2e5af8c1f0', 'quantite': ''}, {'ingredient_id': 'd6f16d60-27d5-4ddc-998d-9d41d2e7e2f3', 'quantite': '1'}, {'ingredient_id': '0afff471-3be1-494a-82b2-bc89f9038bcd', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26942, 'Confiture pêches - bananes de sandrine', 'pêche, banane, sucre roux, beurre, jus de citron', '10 min', ['Mélangez les fruits avec le sucre. Ajoutez un jus de citron. Laissez macérer une nuit. ', 'Faites cuire à gros bouillons jusqu''à apparition de l''écume. Ecumez. ', 'Ajoutez le beurre. Baissez le feu et laissez mijoter 20 min. ', 'C''est cuit lorsque le mélange fige immédiatement sur une assiette mise au congélateur. ', 'Passez grossièrement au mixer. ', 'Mettez en pots.'], ['Batteur électrique', 'Poêle', 'Presse-agrumes', 'Louche', 'Tire-bouchon'], ['', 'Confiture pêches - bananes de sandrine', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'beurre', 'pêche', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:03:32.434655', [{'ingredient_id': 'e85aa39c-aa82-485c-ae01-80e9813906ee', 'quantite': '1 kg'}, {'ingredient_id': 'b4821276-5858-4095-81c3-57467e46678c', 'quantite': '500 g'}, {'ingredient_id': '308ba44d-a3b4-40d1-92f8-6cda9e156485', 'quantite': '1.2 kg'}, {'ingredient_id': '63c50820-3dde-4cba-b0ba-cc9c121181c1', 'quantite': '1'}, {'ingredient_id': '46b04942-b74c-42e0-83d2-03e74688dff2', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (312835, 'Bananes flambées revisitées', 'citron vert, orange, banane, sucre, beurre, ganache au chocolat', '10 min', ['Éplucher les bananes et les couper dans le sens de la longueur.', 'Dans une poêle, faire chauffer le beurre et y mettre les bananes une fois que celui-ci mousse.', 'Ajouter le sucre en poudre.', 'Mettre le jus de citron vert.', 'Laisser caraméliser.', 'Dans un verre type cocktail, dresser les bananes coupées en morceaux en nappant de la sauce caramélisée. Saupoudrer de zeste d''orange.', 'Ajouter dessus une quenelle de ganache au chocolat (exemple : http://www.marmiton.org/recettes/recette_ganache-au-chocolat_17983.aspx)'], ['Mixeur', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'orange', 'citron vert', 'sucre', 'ganache au chocolat', 'cocktail', 'Bananes flambées revisitées'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:03:36.075321', [{'ingredient_id': 'e7ba4a7c-21a4-4416-8055-5b419aaf8fce', 'quantite': '1'}, {'ingredient_id': 'a2312a61-6919-4023-8b1a-eb03d4e527af', 'quantite': '1'}, {'ingredient_id': '06256ef4-757e-4fb7-a8aa-1f315b1797f5', 'quantite': '2'}, {'ingredient_id': 'e254d3e0-f1f6-4138-b39a-88b031e8e7c8', 'quantite': '20 g'}, {'ingredient_id': '354b92be-0f16-43f7-bc2f-88c146d6ff8a', 'quantite': '20 g'}, {'ingredient_id': '701e2a2a-f00c-4fe4-b127-6362acaf9b01', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (253712, 'Banoffee revisité', 'confiture de lait, crème chantilly, palets bretons, beurre salé, banane, citron', '15 min', ['Pour faire deux tartelettes Banoffee, il faut commencer par écraser les sablés bretons (à l''aide d''un rouleau à pâtisserie en les mettant par exemple dans un petit sac). ', 'Une fois écrasés, mélangez les avec le beurre salé fondu. ', 'Placez ce mélange au fond de deux moules à tarte et mettez au réfrigérateur quelques minutes.', 'Découpez ensuite la ou les bananes en fines rondelles. Faites couler du jus de citron afin qu''elles ne noircissent pas. Placez ces rondelles sur votre fond sablé.', 'Ajoutez ensuite la confiture de lait (avec une poche à douille c''est plus simple), placez le tout au frigo une quinzaine de minutes au moins.', 'Au moment de servir, recouvrir le tout de chantilly (soit toute prête, soit montée à l''aide de crème entière)!'], ['Casserole', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Banoffee revisité', 'facile', 'beurre salé', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'confiture de lait', 'palets bretons', 'dessert', 'plat de résistance', 'citron', 'cocktail'], 'Dessert', 94cc2194-8d05-46ee-a047-27f9f1dc5a1c, '2025-09-26T17:03:40.927664', [{'ingredient_id': 'cce01e8f-a5f4-4f54-8c09-3dab52ae3014', 'quantite': ''}, {'ingredient_id': 'dde3b5fd-1825-4400-92b2-fa75b5cd9af8', 'quantite': ''}, {'ingredient_id': '6dd8e9b4-4f85-499c-8e17-506eafdf4240', 'quantite': '70 g'}, {'ingredient_id': '400147bb-de18-4afd-907f-62c5a43c6034', 'quantite': '25 g'}, {'ingredient_id': '1c1ee49e-f296-43cd-b4c1-e9ab11bbcc39', 'quantite': '1'}, {'ingredient_id': '92fb4175-59d8-4b5e-a4ed-f0bd568f3e03', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (313976, 'Boule à pizza au chocolat et à la banane', 'pâte à pizza, chocolat, banane', '3 min', ['Préchauffer le four à 190°c (thermostat 6).', 'Former 6 petites boules avec la pâte à pizza.', 'Casser le chocolat en barre et la banane en 6 rondelles.', 'Mettre une barre de chocolat et une rondelle de banane dans une boule de pizza.', 'Refermer soigneusement, il ne faut pas qu''on voit le chocolat ni la banane sortir.', 'Mettre sur un plaque avec un papier sulfurisé et enfourner.', 'Il faut que les boules soit légèrement dorées et craquelées.'], ['Couteau de chef', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'pâte à pizza', 'boisson', 'dessert', 'plat de résistance', 'Boule à pizza au chocolat et à la banane', 'cocktail'], 'Dessert', 80f4e19f-ff18-46f8-99be-63cd7c13ce0f, '2025-09-26T17:03:48.210997', [{'ingredient_id': '9aa1b1a7-15ec-46c2-a0d3-ea763c4b26a3', 'quantite': '1'}, {'ingredient_id': 'aca8a847-9839-4098-8be2-a498afd2f85c', 'quantite': '1'}, {'ingredient_id': '5a909b07-b949-441a-b7da-4b3b070329e4', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (224280, 'Salade de fruits d''hiver chaude', 'mangue, clémentine, banane, kiwi, sucre', '20 min', ['Pelez la mangue et taillez-la en cube d''environ 2 cm. Réservez.', 'Épluchez les clémentines, séparez les quartiers en retirant bien tous les petits filaments blancs. Réservez.', 'Épluchez les bananes et les kiwis et détaillez-les en rondelles d''environ 1/2 cm (pas trop fines en fait). Réservez.', 'Faites chauffer à feu moyen une poêle non adhésive. ', 'Dès que la poêle est bien chaude, versez-y tous les fruits et remuez bien pendant 5 min environ. Il faut que les fruits soient chauds mais pas compotés.', 'Répartissez dans des ramequins, saupoudrez du sucre de votre choix et servez aussitôt.'], ['Passoire', 'Pince de cuisine', 'Mixeur'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'salade de fruits d''hiver', 'facile', 'bon marché', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'Salade de fruits d''hiver chaude', 'clémentine', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:03:56.830358', [{'ingredient_id': 'd667e74f-0e5c-4a92-890a-734d93782c59', 'quantite': '2'}, {'ingredient_id': 'e43d8fb7-707f-4324-a05b-b52af0fe4652', 'quantite': '4'}, {'ingredient_id': '8feede0f-ada6-4b33-89ae-2bcb7945faf5', 'quantite': '2'}, {'ingredient_id': '191cc2ed-9844-41fe-a3ac-f50a9e934d4d', 'quantite': '2'}, {'ingredient_id': '419af670-5f57-47b9-856a-c97593159f21', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26577, 'bananes au miel', 'banane, miel liquide, citron', '0 min', ['Mettre le miel à fondre dans une casserole (Tefal, c''est mieux, ou alors une petite poêle) avec le jus de citron. ', 'Quand le miel est liquide, ajouter les bananes coupées en deux dans le sens de la longueur. ', 'Faire tout doucement dorer les bananes dans le mélange, en les retournant de temps en temps (cela prend 5 mn pas plus). ', 'Servez tout de suite en nappant les bananes du miel citronné restant au fond de la casserole. '], ['Balance de cuisine', 'Ouvre-boîte'], ['', 'miel liquide', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'bananes au miel', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:04:00.407796', [{'ingredient_id': '3e74bc80-aaf6-424c-b4fc-50dd65045c19', 'quantite': '2'}, {'ingredient_id': '1aad0b71-71d2-4f72-af3a-3bb543ecd165', 'quantite': '3 cuillères'}, {'ingredient_id': 'a9755643-9a76-45b1-a532-ccd8b8a6b344', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52308, 'Tarte figue banane', 'figue, banane, pâte feuilletée, sucre en poudre, huile d''olive', '10 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Disposer la pâte feuilletée dans un moule à tarte.', 'Découper les figues en fines lamelles et les répartir sur la pâte de façon à la recouvrir totalement.', 'Couper les bananes et les répartir par dessus.', 'Saupoudrer de sucre en poudre.', 'Arroser d''un filet d''huile d''olive.', 'Mettre au four durant 30 à 40 minutes.', 'C''est prêt !!'], ['Presse-agrumes', 'Rouleau à pâtisserie', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Tarte figue banane', 'figue', 'plat', 'tarte à la banane', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'pâte feuilletée', 'moyen', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:04:04.122606', [{'ingredient_id': 'c743093e-85cb-4c95-b22d-a7d8274e3bc5', 'quantite': ''}, {'ingredient_id': 'a313fc00-e233-40f1-ba08-e48245b45fd6', 'quantite': '2'}, {'ingredient_id': '6c5411cc-b415-4643-803b-44f0b172754e', 'quantite': '1'}, {'ingredient_id': 'b314e0d2-6149-41b4-b5f0-f5666338ebd8', 'quantite': ''}, {'ingredient_id': 'fdbd0d80-8780-4bce-be94-7200be81696d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (382583, 'Moelleux chocolat banane', 'oeuf, lait, crème, farine, sucre, banane, chocolat noir, sucre vanillé, levure', '20 min', ['Faire fondre au bain marie le chocolat préalablement cassé en morceaux.', 'Mélanger les oeufs et le sucre.', 'Incorporer la farine et mélanger jusqu''à obtenir une pâte lisse et homogène. ', 'Incorporer le lait et la crème, et bien mélanger à nouveau.', 'Ajouter le sucre vanillé et le sachet de levure.', 'Ajouter la banane bien mûre en petit morceaux tout en l''écrasant avec le fouet.', 'Incorporer le chocolat fondu, bien mélanger.', 'De préférence chemiser un moule ou plat à tarte et y verser l''appareil.', 'Enfourner pendant une vingtaine de minutes.'], ['Économe', 'Fouet', 'Passoire', 'Pince de cuisine', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'Moelleux chocolat banane', 'plat', 'crème', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre vanillé', 'gâteau au chocolat', 'lait', 'sucre', 'cocktail'], 'Dessert', bba6539b-4301-4214-9e91-84954067bfbe, '2025-09-26T17:04:09.072060', [{'ingredient_id': '640d8c85-9324-435d-86db-4a9663fbc44d', 'quantite': '4'}, {'ingredient_id': '49fc5a9f-2a62-4d5c-bb84-32e38f1d3e2f', 'quantite': '12 cl'}, {'ingredient_id': 'acb6f2a4-ceff-4edb-83b6-5a92f5b972c4', 'quantite': '12 cl'}, {'ingredient_id': '975ad257-f689-443b-a826-208e49fa9905', 'quantite': '250 g'}, {'ingredient_id': '0a1ed0bb-5249-4a8d-acfb-d897962ef559', 'quantite': '100 g'}, {'ingredient_id': 'f39bb78a-e587-4aed-9f11-380e01cd017e', 'quantite': '1'}, {'ingredient_id': '924240a6-2464-4bda-a210-59f802a5e0b2', 'quantite': '180 g'}, {'ingredient_id': '04425e5b-a814-4c00-86b6-b603d4e0f897', 'quantite': '1'}, {'ingredient_id': '1fc0fe88-017c-454c-b89d-41245c3a93fb', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (89009, 'Tarte courgettes-bananes', 'courgette, banane, pâte sablée, oeuf, crème fraîche, gruyère râpé, poivre, sel, huile d''olive', '10 min', ['Préchauffer le four à 200°C (thermostat 7). Eplucher et couper les courgettes en morceaux. Les précuire dans une sauteuse avec une cuillère à soupe d''huile pendant 20 minutes à feu doux. Cinq minutes avant la fin de la cuisson y ajouter les bananes coupées en rondelles. ', 'Dans un bol, battre les oeufs avec la crème fraîche. Saler, poivrer.', 'Disposer la pâte dans un plat. Y étaler le mélange courgettes/bananes. ', 'Verser la préparation aux oeufs.', 'Enfourner à 180°C (thermostat 6) pendant 25 minutes. ', 'Recouvrir la tarte de gruyère râpé et ré-enfourner pour cinq minutes, le temps de gratiner.'], ['Moule à tarte', 'Casserole', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'tarte aux légumes', 'recette', 'cuisine', 'recettes', 'boisson', 'gruyère râpé', 'huile d''olive', 'dessert', 'plat de résistance', 'Tarte courgettes-bananes', 'courgette', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:04:12.838218', [{'ingredient_id': '17576b47-cf7c-4e6b-9038-50287fe276ac', 'quantite': '5'}, {'ingredient_id': 'a8d0a4ba-9a33-45c7-804e-be3836b57353', 'quantite': '2'}, {'ingredient_id': '6def7fe1-ba69-46c9-a51d-1e647633073a', 'quantite': '1'}, {'ingredient_id': '5ffa2e4c-b596-4ac4-b261-0d45d3bdb6cc', 'quantite': '2'}, {'ingredient_id': 'd84d967e-459d-4956-a6a2-36a1805925b2', 'quantite': '20 cl'}, {'ingredient_id': 'd77ec163-f0f2-47ed-add5-0c02c93d36ba', 'quantite': '50 g'}, {'ingredient_id': 'e96f8d29-d8a0-4303-90e4-fab00f6cc56b', 'quantite': ''}, {'ingredient_id': 'cdaa2b4d-979b-43f1-9136-64f6c423ad9c', 'quantite': ''}, {'ingredient_id': '6fa7ef64-1fe6-407b-bc41-e94fb97116fe', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (533753, 'Smoothie maté et fruits', 'thé matcha, banane, ananas, mangue, citron vert, glace pilée', '10 min', ['Faire infuser la yerba maté dans 10-15cl d’eau environ 5 minutes.', 'Dans un shaker/blinder, mettre les fruits entiers épluchés, le jus de citron vert, la glace pilée et le maté filtré.', 'Servir dans son récipient et déguster immédiatement !'], ['Casserole', 'Fouet', 'Planche à découper', 'Balance de cuisine', 'Batteur électrique'], ['', 'entrée', 'Smoothie maté et fruits', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'ananas', 'citron vert', 'thé matcha', 'cocktail', 'glace pilée'], 'Boisson', 3548b096-ffdf-4826-acef-7be0deaa75b5, '2025-09-26T17:04:18.941972', [{'ingredient_id': '012cf0d5-bfb5-4e5c-97f7-1e82aed3eff8', 'quantite': '10 cl'}, {'ingredient_id': 'b9ef0326-7a64-48a9-8872-b371d8b8a9e4', 'quantite': '1'}, {'ingredient_id': 'c0701443-d022-4525-acd6-917634fb3618', 'quantite': '100 g'}, {'ingredient_id': '22bcaa5d-85f4-483d-9dc6-9401e75639f1', 'quantite': '70 g'}, {'ingredient_id': '2d232aac-da5a-43c8-a5be-8d69557305cb', 'quantite': '1'}, {'ingredient_id': '77d646cb-3269-413c-890a-67151561e609', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42997, 'Apéritif rapide chorizo-banane', 'chorizo, banane, miel', '10 min', ['Couper le chorizo en tranches assez épaisses (1,5 ou 2 cm).', 'Couper les bananes en tranches de même épaisseur.', 'Dans une poêle chaude, jeter les tranches de chorizo, puis les tranches de banane. ', 'Faire dorer le tout, puis ajouter 2 ou 3 cuillères de miel (ou de cassonade, si vous n''aimez pas le miel).', 'Piquer 1 tranche de banane et une tranche de chorizo, pour chaque pièce...', 'Servir tiède!'], ['Couteau de chef', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Apéritif rapide chorizo-banane', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chorizo', 'cocktail'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:04:26.241573', [{'ingredient_id': '66ff994e-c1cb-41b1-8134-3ca8364f297b', 'quantite': '1'}, {'ingredient_id': '97fda568-7132-4110-b260-bf8de4ca9864', 'quantite': '3'}, {'ingredient_id': '7a1a4e42-7434-48ed-857a-d293480bc746', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (19858, 'Croque monsieur à la banane', 'pain de mie, banane, beurre, sucre en poudre', '15 min', ['Préchauffer le four à 180°C. ', 'Disposer les tranches de pain de mie sur une plaque pour le four. ', 'Beurrer légèrement les tranches. ', 'Couper des bananes en rondelles très fines les disposer à plat sur le pain. ', 'Saupoudrer de sucre en poudre. Recouvrir avec une tranche de pain. ', 'Beurrer à nouveau le dessus. Rajouter sur la ''tranche couvercle beurrée'' un nuage de sucre en poudre. ', 'Enfourner. Selon le goût, faire plus ou moins cuire. Il faut tout de même que les bananes soient cuites.'], ['Planche à découper', 'Louche', 'Pince de cuisine', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'Croque monsieur à la banane', 'cocktail', 'pain de mie'], 'Dessert', 87ab8150-0dc5-4f91-b095-7e065377cd61, '2025-09-26T17:04:30.529380', [{'ingredient_id': '317a178b-b998-4829-a8f4-7b965a0b0ffa', 'quantite': '1'}, {'ingredient_id': '229d9cec-3cd1-4b13-b50e-6965b4de780c', 'quantite': '4'}, {'ingredient_id': 'f265dc5d-17fb-4f5a-8b95-0153ae047254', 'quantite': ''}, {'ingredient_id': 'a6260519-9722-4ca9-86d3-571b84c50c04', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (84239, 'Tiramisu banane pain d''épice', 'banane, pain d''épices, mascarpone, crème, beurre, oeuf, sucre, jus de citron, rhum', '20 min', ['Coupez les bananes en rondelles et faite les revenir dans 10 g de beurre.', 'Coupez le pain d''épices en tranches et faite-le revenir dans 10 g de beurre, puis le tremper rapidement dans le rhum.', 'Mélangez le mascarpone et les oeufs dans un saladier au batteur.', 'Mélangez ensuite la crème et le sucre jusqu''à obtention d''une crème lisse.', 'Incorporez alors doucement le mascarpone au mélange.', 'Préparez votre tiramisu dans un plat ou en verrine, couche de mascarpone, couche de banane, couche de pain d''épices, mascarpone...', 'Laisser reposer 1h au frais!'], ['Pince de cuisine', 'Couteau de chef', 'Balance de cuisine', 'Rouleau à pâtisserie', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'pain d''épices', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'tiramisu', 'Tiramisu banane pain d''épice', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:04:34.244285', [{'ingredient_id': '53e56332-53fc-4e7f-9c85-13ed976b7244', 'quantite': '2'}, {'ingredient_id': '5afd3b24-300a-4b29-90ff-08c7ca9f46f0', 'quantite': '250 g'}, {'ingredient_id': 'bed94f4a-e363-463b-b808-d56f8c092073', 'quantite': '250 g'}, {'ingredient_id': '436f5c27-9cbb-40a1-91cf-1a853ec44140', 'quantite': '250 g'}, {'ingredient_id': 'ecab6ab6-696d-4494-8015-83db0f50018a', 'quantite': '30 g'}, {'ingredient_id': 'bac403e2-3d7f-4cdd-8351-40dafd5afa21', 'quantite': '3'}, {'ingredient_id': '7aa052e6-a8e1-492a-b2c0-c02ccef68247', 'quantite': '50 g'}, {'ingredient_id': '4e0a334e-6659-42d0-903b-b1dc68c1ffba', 'quantite': '25 cl'}, {'ingredient_id': '9c887d23-7b43-4688-b042-d10dcb82a4ca', 'quantite': '25 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (54639, 'Cocktail banane mangue', 'mangue, banane, citron, framboises', '15 min', ['Pelez les mangues, retirez le noyau et coupez la pulpe en dés.', 'Pelez les bananes, coupez les en morceaux et citronnez-les.', 'Passez au mixeur les mangues et les bananes.', 'Versez la purée obtenue dans de grands verres bien froids, complétez à volonté de nectar de framboise. ', 'Ajoutez des glaçons, servez aussitôt.'], ['Presse-agrumes', 'Balance de cuisine', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'framboises', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'Cocktail banane mangue', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'citron', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:04:39.378207', [{'ingredient_id': 'f0c21fad-ebb6-4c6e-b667-46843dd2eaf7', 'quantite': '2'}, {'ingredient_id': '6fb7d5aa-6884-4a33-bee2-58f6f46013fd', 'quantite': '2'}, {'ingredient_id': 'f1c0fd97-ca53-413d-acde-db48e6d88a21', 'quantite': '1'}, {'ingredient_id': '4cf9ffc9-7f3c-4672-823f-fccaca462a3c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (322743, 'Marquisette de Jean-Pat', 'pomme, banane, orange, citron, rhum, vin blanc sec, limonade, vin, sucre, cannelle', '30 min', ['Utiliser des fruits Bio si possible.', 'Mettre au frais la limonade et le mousseux au moins 12h avant de servir la Marquisette.', 'Laver les fruits et les couper en morceaux dans un grand récipient.', 'Presser les morceaux d''orange et de citron à la main.', 'Recouvrir de sucre.', 'Ajouter tout le vin blanc.', 'Ajouter le rhum et les bâtons de cannelle.', 'Laisser macérer 48 h en remuant régulièrement puis mettre au frais.', 'Au moment de servir, prélever 1,5 l de préparation et réserver dans un grand saladier.', 'Ajouter 1,5 l de limonade et 0,75 cl de vin mousseux.', 'Puis faire de même au fur et à mesure du besoin.'], ['Planche à découper', 'Couteau de chef', 'Tire-bouchon', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'vin', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vin blanc sec', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'citron', 'orange', 'limonade', 'Marquisette de Jean-Pat', 'cannelle', 'sucre', 'cocktail'], 'Boisson', 0537ed09-e04d-4523-bc4c-5bd34822e433, '2025-09-26T17:04:45.364403', [{'ingredient_id': '6e693e96-1b76-4060-ad63-07632d57ba6b', 'quantite': '2'}, {'ingredient_id': '59ff2951-d293-4335-92e3-3e94b4e8ee95', 'quantite': '2'}, {'ingredient_id': '23d1f363-d5fb-45fc-9c66-610c9a17beb3', 'quantite': '1.5 kg'}, {'ingredient_id': 'd11e9523-5a53-4bb7-89b5-c56be8d9029b', 'quantite': '5'}, {'ingredient_id': 'b99c34c2-4527-49c3-a0e4-c891d3049849', 'quantite': '75 cl'}, {'ingredient_id': '31b5c098-87c0-44f1-9f92-b602e21faf70', 'quantite': '4.5 l'}, {'ingredient_id': 'f0c05d28-74fb-4776-b3d1-0757a1d0c823', 'quantite': '4.5 l'}, {'ingredient_id': '131f3e5b-cf99-44d0-8a4f-d909d2e7e4bd', 'quantite': '2.25 l'}, {'ingredient_id': 'ee726142-b97c-4507-9db7-bdb6d34b190c', 'quantite': '1 kg'}, {'ingredient_id': '3992d7ca-d3ee-46c8-b0ea-2a20fd5c1f1a', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73579, 'Smoothies pomme banane coulis de framboises', 'pomme, banane, coulis de framboise', '5 min', ['Peler les fruits et les mettre dans le blender avec le coulis et 6 glaçons. Mixer le tout 1 min.', 'Verser dans des verres avec une paille.'], ['Moule à tarte', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'Smoothies pomme banane coulis de framboises', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'cocktail', 'coulis de framboise'], 'Boisson', 0ff2180b-9118-4038-9704-781dc7af9b48, '2025-09-26T17:04:48.969808', [{'ingredient_id': 'cbcc486a-2aa2-4d88-9169-32085452eed6', 'quantite': '2'}, {'ingredient_id': '19440cd4-b3e5-4706-9f4e-b015ca3fbe0c', 'quantite': '2'}, {'ingredient_id': 'bb396aac-9431-4f6e-b101-8fb0ccae7360', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33103, 'Gâteau jamaïque', 'biscuits à la cuillère, banane, orange, beurre, crème chantilly, chocolat, noix de coco rapée, sucre vanillé, lait, sucre, oeuf, vanille, beurre', '30 min', ['Préchauffer le four Th 6 . ', 'Commencez par émietter les biscuits et arrosez-les du jus de l''orange. ', 'Avec une fourchette, malaxez-les avec 60 g de beurre et répartissez ce mélange sur le fond de 4 plats individuels allant au four. Faites cuire 10 mn et laissez refroidir. ', 'Préparez la crème : ', 'portez à ébullition le lait avec la gousse de vanille fendue. ', 'Dans une jatte, fouettez les jaunes d''oeufs, le sucre et la farine, versez peu à peu le lait bouillant et remettez le tout dans la casserole. Laissez épaissir. ', 'Hors du feu, retirez la gousse de vanille et ajoutez le beurre. ', 'Fouettez les blancs en neige et les incorporer à la crème encore chaude. ', 'Ajoutez à la préparation refroidie, la noix de coco et les bananes en rondelles. Répartissez sur les biscuits. ', 'Fouettez la crème liquide très froide en chantilly avec le sucre vanillé et décorez-en les gâteaux. ', 'Prélevez des copeaux de chocolat à l''aide d''un économe et parsemez-en la chantilly. ', 'Servez très frais.'], ['Rouleau à pâtisserie', 'Balance de cuisine', 'Pince de cuisine', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'biscuits à la cuillère', 'Gâteau jamaïque', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'noix de coco rapée', 'dessert', 'plat de résistance', 'sucre vanillé', 'moyen', 'beurre', 'orange', 'cocktail'], 'Dessert', e99199a6-f3f1-47f2-ae92-fd1e4ffabad4, '2025-09-26T17:04:52.685321', [{'ingredient_id': 'f39d5536-62a5-47af-aaf7-16beeca1f512', 'quantite': '20'}, {'ingredient_id': '164251ef-1f77-40bb-a8ce-0568c7c5e957', 'quantite': '3'}, {'ingredient_id': '42fcced4-c7b2-4983-988d-68eac2e31172', 'quantite': '1'}, {'ingredient_id': '4a370c17-5f6e-4cec-a66a-2bd89257eb3f', 'quantite': '60 g'}, {'ingredient_id': '567cbacf-fbc0-4a79-978d-6925c583bc73', 'quantite': '25 cl'}, {'ingredient_id': 'a589e9fa-b186-4c67-b38b-7e4f9a40ce2c', 'quantite': '50 g'}, {'ingredient_id': 'a63f6d64-bbc3-4f8d-b510-9a63cee8408a', 'quantite': '20 g'}, {'ingredient_id': '4ed560d1-3ec1-4316-aee1-81ec4402b386', 'quantite': '1'}, {'ingredient_id': 'e8508457-a159-4a1e-b639-a92ad5303004', 'quantite': '50 cl'}, {'ingredient_id': 'b9f0901f-240e-4736-a95f-d66e0bbbc965', 'quantite': '125 g'}, {'ingredient_id': '251f4740-b9b1-44d3-ae5c-aeef5053bb82', 'quantite': '3'}, {'ingredient_id': 'f3006b69-790b-4f80-afd7-6bbdc9c0a832', 'quantite': '1'}, {'ingredient_id': 'f7bf31da-7f9e-4db6-83b6-66daf3e8e9cd', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30238, 'Bricks aux fruits', 'feuille de brick, pomme, poire, banane, fruits rouges, confiture d''abricot, crème chantilly, beurre, menthe', '10 min', ['Au centre d''une feuille de brick, mettre 4 à 5 lamelles de pomme, 4 à 5 lamelles de poire et 4 à 5 rondelles de banane (le tout superposépar couche de fruits).', 'Replier les côtés de la feuille de bricks sur les fruits,puis replier les bouts du rouleau obtenu et scellez ces 2 bouts avec un joint de beurre.', 'Dans une casserole, mettre la confiture d''abricots à chauffer 2 mn environ afin d''obtenir un sirop.', 'Dans une poêle, faire fondre un peu de beurre et y ajouter la feuille de bricks contenant les fruits et faire cuire 2 mn de chaque côté.', 'Mettre la feuille de brick au centre d''une assiette,badigeonner avec le sirop d''abricot afin de lui donner une jolie couleur,ajouter quelques fruits rouges (fraise, framboise,...), quelques touches de crème chantilly, quelques feuilles de menthe et servir aussitôt.', 'Il est impératif que les fruits étant dans la feuille de bricks soient non juteux mais vous pouvez remplacer ces fruits par des abricots, pêches ou autres.'], ['Balance de cuisine', 'Tire-bouchon', 'Économe', 'Louche', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'feuille de brick', 'poire', 'très facile', 'menthe', 'bon marché', 'rapide', 'plat', 'fruits rouges', 'recette', 'confiture d''abricot', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'Bricks aux fruits', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:04:56.374999', [{'ingredient_id': 'f74fc0fc-b281-4998-b940-30d9c21e76d7', 'quantite': '1'}, {'ingredient_id': 'b1510c40-6c0f-4109-80be-c3a78a064745', 'quantite': '1'}, {'ingredient_id': '6e1da721-3fd0-4420-a604-10effd25e6c5', 'quantite': '1'}, {'ingredient_id': 'f5cced6d-4b98-4d7c-bf75-7ffb11b3276d', 'quantite': '1'}, {'ingredient_id': 'f90939c0-a79e-4bd3-b8e5-2967b1a12789', 'quantite': ''}, {'ingredient_id': 'b8877d8c-ba75-4616-8f25-7829cf524350', 'quantite': '2 cuillères'}, {'ingredient_id': 'd00f3c5a-284c-49c8-87d5-46028d2e0986', 'quantite': ''}, {'ingredient_id': '88ba6791-d3b1-4482-a5d6-36694905af86', 'quantite': ''}, {'ingredient_id': '4fb070bf-c002-4217-b28e-5f70b8cb3cf2', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (344485, 'Sandwich de pain perdu au barbecue', 'pain de mie, fraises, banane, lait, oeuf, chocolat, arôme vanille', '20 min', ['Retirer la croûte du pain de mie (sauf si c''est du pain de mie sans croûte!).', 'Laver, équeuter et couper les fraises en dés. Éplucher et couper les bananes en rondelles.', 'Détailler le chocolat en morceaux.', 'Dans un saladier, mélanger le lait avec l''oeuf et la vanille. ', 'Tremper les tranches de pain de mie dans la préparation et réserver dans une assiette.', 'Sur la moitié des tranches de pain de mie, déposer du chocolat, des fraises et de rondelles de banane.', 'Recouvrir avec une tranche de pain de mie pour former un sandwich. ', 'Placer sur le grill et cuire 2 minutes de chaque côté.'], ['Moule à tarte', 'Ouvre-boîte', 'Râpe', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'Sandwich de pain perdu au barbecue', 'boisson', 'Pain perdu', 'dessert', 'plat de résistance', 'arôme vanille', 'lait', 'cocktail', 'pain de mie'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T17:05:01.175879', [{'ingredient_id': '6bff0f52-a5b9-4c5f-a553-bb48a7792f4e', 'quantite': '10'}, {'ingredient_id': '0679a319-3c2b-43e6-b87c-be00ab4e309f', 'quantite': '500 g'}, {'ingredient_id': '74f88201-1d63-42b2-917f-de0406c7a1b3', 'quantite': '2'}, {'ingredient_id': 'ab747a9f-db12-46c4-b9e6-6bde16acb453', 'quantite': '15 cl'}, {'ingredient_id': '148aa845-abb9-41d0-add5-4a24505510b1', 'quantite': '1'}, {'ingredient_id': '38543388-87c5-45dc-baee-993218c6f2b9', 'quantite': '200 g'}, {'ingredient_id': '4db4c40e-13c5-45f5-a06b-11da3d8b9a2d', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315648, 'Tarte compote de bananes et chocolat', 'chocolat, pâte feuilletée, compote', '20 min', ['Préchauffez votre four à 180°C (thermostat 6).', 'Étalez la pâte feuilletée dans un moule à tarte.', 'Piquez-la à l''aide des dents de la fourchette', 'Versez uniformément la compote de bananes.', 'Versez une cuillère à soupe d''eau dans le chocolat.', 'Faites le chauffer au micro onde pendant 1 min 30.', 'Laisser le refroidir puis verser le sur la compote de bananes.', 'Enfournez pendant 30 min.'], ['Couteau de chef', 'Presse-agrumes', 'Économe', 'Casserole', 'Balance de cuisine'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'plat', 'recette', 'compote', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'Tarte compote de bananes et chocolat', 'compote de banane', 'cocktail'], 'Dessert', cf8f1eb9-ab85-472a-9883-c4b78b4d6793, '2025-09-26T17:05:06.363960', [{'ingredient_id': 'da5348c6-d126-481e-a597-39a9f556b9a2', 'quantite': '150 g'}, {'ingredient_id': '69dcdc9e-62d4-483f-9ca3-1991a75805df', 'quantite': '1'}, {'ingredient_id': '803e4899-d0c6-4cc3-bac2-8e9c71366056', 'quantite': '300 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (224329, 'Banane choco-spéculos-chantilly', 'banane, pâte à tartiner, crème chantilly, spéculoos, miel', '5 min', ['Éplucher une banane et la couper dans le sens de la longueur (en 2).', 'La recouvrir sur la face plate de pâte à tartiner dessus puis de chantilly et de spéculos émiettés.', 'Enfin, ajouter un filet de miel sur les spéculos.'], ['Économe', 'Poêle', 'Pince de cuisine', 'Planche à découper'], ['Banane choco-spéculos-chantilly', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'spéculoos', 'cuisine', 'miel', 'recettes', 'speculoos', 'boisson', 'crème chantilly', 'dessert', 'plat de résistance', 'cocktail', 'pâte à tartiner'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:05:11.528629', [{'ingredient_id': '70ece683-fed0-473f-98bb-88c2beae2cee', 'quantite': '1'}, {'ingredient_id': '7af6db30-dcc3-4297-bbf2-6b66ad364cfb', 'quantite': '2 cuillères'}, {'ingredient_id': '0c25c8c8-fd0b-4a6e-91a0-9c94a298d024', 'quantite': ''}, {'ingredient_id': '5e8400e8-bec6-4d82-b42e-8cab831d073b', 'quantite': '2'}, {'ingredient_id': '47879806-0418-4f5f-8182-9410b598d081', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14781, 'Tarte banane et coco', 'pâte feuilletée, lait concentré non sucré, banane, noix de coco, oeuf, extrait de vanille liquide, sucre en poudre', '10 min', ['Préchauffer le four à thermostat 7 (220°C).', 'Dérouler la pâte dans le moule (conserver le papier de cuisson).', 'Ecraser 2 bananes et couper l''autre en rondelles.', 'Dans un saladier, mélanger le lait et les oeufs. ', 'Ajouter les bananes écrasées au reste des ingrédients. Verser sur la pâte et décorer avec les rondelles de banane.', 'Faire cuire 25 mn. ', 'Au moment de servir, saupoudrer de noix de coco en poudre.'], ['Économe', 'Couteau de chef', 'Tire-bouchon', 'Râpe', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'extrait de vanille liquide', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'tarte à la banane', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'Tarte banane et coco', 'dessert', 'plat de résistance', 'pâte feuilletée', 'lait concentré non sucré', 'noix de coco', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:05:15.172520', [{'ingredient_id': '5975e0ca-e72c-4961-8029-271a30ee03f6', 'quantite': '1'}, {'ingredient_id': 'd648b0c6-22d9-490e-8327-2319681c90ff', 'quantite': '1'}, {'ingredient_id': 'fb9101b9-cf03-4fe9-940c-f48634e52bf7', 'quantite': '3'}, {'ingredient_id': 'ac04fe7f-e1d9-4c8a-81ea-a16ef125e285', 'quantite': '50 g'}, {'ingredient_id': '22171bf0-0242-47ef-bbf0-17d13844085a', 'quantite': '3'}, {'ingredient_id': 'e1f7ed7e-5969-4ab8-bbef-ffeb83431a0c', 'quantite': '1 cuillères'}, {'ingredient_id': 'b807eab6-2028-4564-9a16-f57241832c5f', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (59619, 'Confiture banane chocolat de ma belle-mère', 'chocolat noir, banane, beurre, lait concentré sucré', '20 min', ['Eplucher et couper les bananes en rondelles.', 'Faire fondre 30 g de beurre dans une poêle et faire cuire les bananes à feu moyen pendant environ 10 min jusqu''à obtenir une purée.', 'Au besoin, on peut écraser les morceaux à la fourchette.', 'Pendant ce temps, faire fondre le chocolat avec 100 g de beurre.', 'Ajouter le lait concentré sucré et la purée de bananes au chocolat. Bien mélanger.', 'Verser la confiture dans les pots.'], ['Rouleau à pâtisserie', 'Balance de cuisine', 'Moule à tarte', 'Fouet', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'lait concentré sucré', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'Confiture banane chocolat de ma belle-mère', 'beurre', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:05:18.918947', [{'ingredient_id': '0c92edf7-c943-425f-a760-f100079f2ad0', 'quantite': '220 g'}, {'ingredient_id': '164eabda-e659-4901-bfa0-90242e4b8443', 'quantite': '450 g'}, {'ingredient_id': 'fd56b4cf-16d6-49e4-b528-81b8c7cbc6e2', 'quantite': '130 g'}, {'ingredient_id': '91e12373-befc-46b7-8573-0e4a23d99049', 'quantite': '400 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335985, 'Roulés choco banane faciles', 'pain de mie, pâte à tartiner, banane', '10 min', ['Roulez vos tranches de pain à l''aide d''un rouleau à pâtisserie pour bien étaler.', 'Étalez sur les tranches de la pâte à tartiner.', 'Coupez les bananes en rondelles fines.', 'Parsemez des rondelles de bananes.', 'Roulez en serrant bien.', 'Découpez chaque rouleau en 3 et servez !'], ['Spatule', 'Passoire', 'Économe', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'Roulés choco banane faciles', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail', 'pain de mie', 'pâte à tartiner'], 'Dessert', 64058412-561b-4ff9-b5cc-1d7809a3ef3e, '2025-09-26T17:05:23.354313', [{'ingredient_id': '86fd0dc0-7c51-4a9b-ac88-01772532defe', 'quantite': '2'}, {'ingredient_id': '8cfad3c4-fba6-4fe9-9180-81799251f826', 'quantite': '2 cuillères'}, {'ingredient_id': '1569bcb5-6f1c-4fc9-a3ee-e277915fa1fc', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52609, 'Quatre-quarts chocolat banane', 'oeuf, farine, sucre, beurre, levure chimique, sel, banane, chocolat', '15 min', ['Préchauffer le four à thermostat 7 (210°C).', 'Dans un saladier, mélanger la farine, le sucre, la levure et le sel et faire un puits. Incorporer les oeufs un à un, puis le beurre fondu.', 'Découper les bananes en petits morceaux (on peut aussi les passer au mixeur, mais le résultat sera un peu différent).', 'Mélanger les bananes et le chocolat à la pâte.', 'Beurrer un moule à cake et y déposer la pâte.', 'Mettre au four pendant environ 40 min (surveiller la cuisson avec la pointe d''un couteau).'], ['Râpe', 'Mixeur'], ['entrée', 'banane', 'Quatre-quarts chocolat banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'quatre quarts', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:05:26.958787', [{'ingredient_id': '79ef6abf-355c-436b-b788-3e2aeb67075a', 'quantite': '4'}, {'ingredient_id': 'cf7cd465-3e8b-4fe8-b147-5834e48e841c', 'quantite': '250 g'}, {'ingredient_id': '79039cac-1081-43be-b838-b3920363032d', 'quantite': '250 g'}, {'ingredient_id': '3711b18f-9c42-4958-ad37-1c246e66db3d', 'quantite': '200 g'}, {'ingredient_id': 'd7198152-0893-4377-a179-8d755ab303db', 'quantite': '1'}, {'ingredient_id': '489200d5-b14b-4a11-811f-929b42b7168d', 'quantite': '1'}, {'ingredient_id': '8d2c46bf-96ff-4eca-9a19-a098aaaf5d5b', 'quantite': '3'}, {'ingredient_id': '18c1c7f2-9450-4027-ba0c-9e969008b902', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (224761, 'Cocktail Orange/banane/passion sans alcool', 'jus d''orange, jus de fruit de la passion, jus de banane, sirop de fraise, sirop, glaçons', '2 min', ['Verser les 3 jus à quantités égales dans le verre (laisser environ 1 cm en haut).', 'Verser 1 trait de chaque sirop pour colorer le fond du verre.', 'Finir avec les glaçons et décorer avec une brochette de fruits frais !', 'Ajoutez une paille ou une touillette pour pouvoir mélanger le sirop au reste.'], ['Louche', 'Râpe', 'Casserole'], ['sirop de fraise', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'jus de banane', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'cocktail sans alcool', 'jus d''orange', 'jus de fruit de la passion', 'sirop', 'Cocktail Orange/banane/passion sans alcool', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:05:30.615049', [{'ingredient_id': 'a27fb3ea-372d-44d8-9685-81f568f82c34', 'quantite': '15 cl'}, {'ingredient_id': '52d32883-8050-40fe-a3bb-f3131b6c4a9e', 'quantite': '15 cl'}, {'ingredient_id': '1e016c2f-f981-48be-a617-7dfcf79fe898', 'quantite': '15 cl'}, {'ingredient_id': 'f53c9971-d954-475f-944e-e4d0d1c4afb3', 'quantite': '1'}, {'ingredient_id': 'f78a7094-e3cf-4b48-9b4c-3482225e7b8c', 'quantite': '1'}, {'ingredient_id': 'f6137a14-6a26-4f09-91d1-fd74e3a33274', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530449, 'Bananes au beurre', 'banane, sucre, beurre', '10 min', ['Dans une casserole, fais fondre le beurre à feu doux.', 'Verse le quart du beurre fondu dans le fond d''un plat à four.', 'Épluche les bananes et mets-les dans le plat à four.', 'Verse le reste du beurre sur les bananes et disposes le sucre par dessus.'], ['Poêle', 'Planche à découper', 'Fouet', 'Verre doseur', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'Bananes au beurre', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T17:05:35.118140', [{'ingredient_id': '92450586-d062-4dee-b502-c5a6b170e8f9', 'quantite': '4'}, {'ingredient_id': 'ae24f244-f141-4c8a-b450-70a86a2df46a', 'quantite': '120 g'}, {'ingredient_id': '5fd1fca3-8634-432e-96b4-0663efec5a7f', 'quantite': '25 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (312444, 'Milk-shake pomme, banane et kiwi', 'banane, kiwi, pomme, yaourt nature, lait, glaçons, sucre', '5 min', ['Mettre dans un blinder la demi banane, le kiwi et le quart de pomme éplucher.', 'Ajouter le lait, le sucre, le yaourt et les glaçons. Mixer pendant 1min30 niveau 2.', 'Votre milk-shake est maintenant prêt. Bonne dégustation.'], ['Passoire', 'Pince de cuisine', 'Presse-agrumes', 'Louche', 'Spatule'], ['', 'entrée', 'banane', 'banane et kiwi', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'glaçons', 'Milk-shake pomme', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:05:39.816386', [{'ingredient_id': '991134bd-e048-4ab2-bf07-4faf0301a6c9', 'quantite': '1'}, {'ingredient_id': '80055c4a-39cf-4cde-9cec-48c509522ca2', 'quantite': '1'}, {'ingredient_id': 'a0af0f93-333f-4556-a32f-47f5fe1aa897', 'quantite': '1'}, {'ingredient_id': '8029c0a4-51be-4757-84ee-f7190a77df8c', 'quantite': '1'}, {'ingredient_id': 'ce47ff81-afa3-4386-95c2-23fd8605582c', 'quantite': '25 cl'}, {'ingredient_id': '6b513329-d870-4308-99a3-d241227bf109', 'quantite': '2'}, {'ingredient_id': 'b92aed97-7474-4766-8a19-6fe0cf76525e', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30606, 'Tourte rosée à la banane', 'pâte feuilletée, banane, framboises, oeuf, sucre, crème épaisse', '20 min', ['1) Etalez une pâte feuilletée dans un moule à tarte. ', '2) Coupez les bananes en fines rondelles et disposez-les sur la pâte. ', '3) Répartissez les framboises sur les bananes. ', '4) Fouettez les oeufs avec la crème et le sucre. ', '5) Répartissez le mélange sur les fruits. ', '6) Recouvrez la préparation avec l''autre pâte feuilletée; soudez les bords des deux pâtes (utilisez de l''eau si besoin). ', '7) Piquez la pâte supérieure de quelques coups de fourchette et hop, au four, Th 180°C pendant 40-45 mn.', '8) Servez la tarte à température ambiante et régalez-vous !'], ['Tire-bouchon', 'Pince de cuisine', 'Casserole', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'framboises', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'moyen', 'sucre', 'crème épaisse', 'Tourte rosée à la banane', 'cocktail'], 'Dessert', 45e798d4-d4e4-433a-9b13-87a793f474e7, '2025-09-26T17:05:43.419498', [{'ingredient_id': '921bdd5b-e8e2-46d4-8be8-3c6794099c0d', 'quantite': '2'}, {'ingredient_id': '72b48d94-b855-4b89-9d60-a5d317ea5459', 'quantite': '2'}, {'ingredient_id': '18931ed9-adb2-4db1-9d7f-86a6c852b4dd', 'quantite': '340 g'}, {'ingredient_id': 'e29ba0bc-66a1-467d-b096-0cf1425d2456', 'quantite': '2'}, {'ingredient_id': '4c7a9d45-aa4c-4136-9f7e-4f14f526f508', 'quantite': '120 g'}, {'ingredient_id': 'e0f61047-2edf-4b7c-b990-559737652a06', 'quantite': '250 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17611, 'Mousse coco banane', 'banane, fromage blanc, édulcorant, lait de coco, lait de coco, noix de coco rapée, gélatine, blanc d''oeuf, extrait de vanille, jus de citron', '20 min', ['Faire ramollir la gélatine dans de l''eau froide. Réduire la banane en purée et ajouter la vanille et les gouttes de jus de citron. Bien mélanger. ', 'Fouetter le fromage blanc, l''édulcorant (ou sucre) et le lait de coco. ', 'Egoutter la gélatine et la fondre dans le lait de coco restant. Bien mélanger pour la dissoudre et l''ajouter au mélange précédent. ', 'Battre le blanc en neige. ', 'Incorporer dans la préparation au fromage blanc la purée de banane, le blanc en neige et enfin la noix de coco râpée. ', 'Verser dans des moules individuels et garder au moins 3 heures au frigo.'], ['Moule à tarte', 'Louche', 'Tire-bouchon', 'Couteau de chef'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'extrait de vanille', 'très facile', 'bon marché', 'rapide', 'plat', 'édulcorant', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'noix de coco rapée', 'dessert', 'plat de résistance', 'jus de citron', 'gélatine', 'mousse fruits', 'blanc d''oeuf', 'Mousse coco banane', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:05:47.131130', [{'ingredient_id': 'ec458fae-e8cb-4bc1-a66d-0e4bd238d0b8', 'quantite': '1'}, {'ingredient_id': '56de2bcb-f7d7-4554-8567-910f1e475f00', 'quantite': '100 g'}, {'ingredient_id': '00351952-097b-4d43-b3c7-ca1d133296f9', 'quantite': '1 cuillères'}, {'ingredient_id': '1f3b0d2a-eaaa-4690-b559-2f1456a6c346', 'quantite': '15 cl'}, {'ingredient_id': '36ff89b7-c60a-446c-8266-26dde35566ab', 'quantite': '2 cuillères'}, {'ingredient_id': '6e80d00e-359f-42e5-ad5b-f36ad4867547', 'quantite': '2 cuillères'}, {'ingredient_id': '89ac4c99-0cab-4200-97a1-7f6d26968572', 'quantite': '1'}, {'ingredient_id': '3d5baa66-3780-4663-8192-3f73ef905a3b', 'quantite': '1'}, {'ingredient_id': '892943d0-ddec-4f12-8687-31c49c287e40', 'quantite': ''}, {'ingredient_id': '13019245-1482-496e-a48e-d4896dc7ea8c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (309460, 'Smoothie multifruit', 'abricot, banane, fruits, glaçons', '5 min', ['Passez tout au mixer et dégustez (avec une paille) !'], ['Fouet', 'Louche', 'Tire-bouchon', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'abricot', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'fruits', 'Smoothie multifruit', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:05:50.663319', [{'ingredient_id': 'd46e9ec4-8c92-4273-9cce-591eb5cea0a8', 'quantite': '4'}, {'ingredient_id': '4d885207-f2fd-46e5-a3f7-d56609def999', 'quantite': '1'}, {'ingredient_id': '2857ef68-5c1b-433f-a33e-6e6fbda0a41a', 'quantite': '15 cl'}, {'ingredient_id': '4bceea9f-3dda-45ce-8aaf-eef74de5ed60', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (223303, 'Brochettes fruitées et vitaminées', 'pomme, poire, banane, raisin', '10 min', ['Éplucher la pomme, les poires et les bananes.', 'Les couper en gros dés ou en rondelles épaisses.', 'Enfiler tous les fruits en les alternant.', 'C''est prêt !'], ['Casserole', 'Fouet'], ['', 'raisin', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'facile', 'bon marché', 'Brochettes fruitées et vitaminées', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:05:55.376401', [{'ingredient_id': 'ec5d587c-e43c-4021-99bb-1eb72a3c9cc1', 'quantite': '1'}, {'ingredient_id': 'c1cbaef2-2057-4e91-a4b3-7b278e9642f7', 'quantite': '2'}, {'ingredient_id': '83c2a1a2-bf37-40b2-acb3-8f5663cedc88', 'quantite': '3'}, {'ingredient_id': '5e84ab6e-8bc0-43ad-8c20-77356f90779c', 'quantite': '8'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (91727, 'Tartelettes aux pommes sur compote de fruits', 'pâte brisée, pomme, banane, sucre, sucre vanillé, gelée', '30 min', ['- Peler et épépiner les pommes (sauf celles pour la déco), couper la banane en rondelles', '- Mettre les fruits dans une casserole avec les sucres et 1cs d''eau', '- Faire cuire une vingtaine de minutes jusqu''à obtenir une compote que vous pouvez mixer ou pas', '- Foncer vos moules à tartelettes avec la pâte brisée, piquer avec une fourchette', '- Remplir les tartelettes de compote jusqu''à 1/2 cm du bord', '- Couper les pommes restantes en tranches fines (1mm d''épaisseur) et les disposer en rosace par dessus la compote', '- Enfourner pour une vingtaine de minutes en surveillant, la pâte doit cuire mais les pommes de doivent pas brûler!', '- A la sortie du four, j''applique au pinceau un peu de gelée de coing réchauffée pour la rendre plus liquide, ce qui rend les tartelettes toutes brillantes.'], ['Pince de cuisine', 'Planche à découper', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Tartelettes aux pommes sur compote de fruits', 'testées', 'très facile', 'compote de pomme', 'bon marché', 'plat', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'gelée', 'sucre vanillé', 'pomme', 'sucre', 'cocktail'], 'Dessert', 1d602461-9c3d-4757-9c17-f205a683e04f, '2025-09-26T17:05:59.135529', [{'ingredient_id': '7da7cf9d-49f3-4dfb-b03e-73e1ec1a4570', 'quantite': '1'}, {'ingredient_id': 'e38c4a2f-a7fa-4ac8-9352-f924b681fa5b', 'quantite': '5'}, {'ingredient_id': 'c10f429e-47d0-4180-bb42-29c9c5350d65', 'quantite': '1'}, {'ingredient_id': 'a761ae1e-6482-4e7b-b9b8-e8a3d3dfe7eb', 'quantite': ''}, {'ingredient_id': 'aec1bfcd-5708-4040-b359-94612e016728', 'quantite': '1'}, {'ingredient_id': '5c87e1a6-5674-4852-9ab4-a6d9d538d0e5', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17701, 'Bananes au caramel', 'banane, caramel, amandes, raisins secs, pignons, beurre', '10 min', ['Pelez les bananes, mettez-les dans une poêle légèrement beurrée. ', 'Laissez-les cuire pendant 6 min. ', 'Au bout de 6 min, retournez-les, ajoutez le caramel et les raisins, amandes, pignons.... ', 'Laissez cuire jusqu''à ce que les bananes soient fondantes, mais pas en compote.', 'Servez aussitôt. Bon appétit!'], ['Balance de cuisine', 'Mixeur'], ['amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'caramel', 'bon marché', 'pignons', 'Bananes au caramel', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'raisins secs', 'cocktail'], 'Dessert', 4e952671-000b-4b93-b2d8-38a35286b25d, '2025-09-26T17:06:03.933663', [{'ingredient_id': 'ce04ae8a-87e4-4350-9a0d-459e047441fe', 'quantite': '4'}, {'ingredient_id': '0a2d047a-76be-4303-8f2b-ecceaa270c34', 'quantite': '2 cuillères'}, {'ingredient_id': 'fe4070a5-22e8-4cfa-9bb1-7432bd6c0ee0', 'quantite': '20 g'}, {'ingredient_id': 'db2eb24a-d9de-4111-be22-c485320c07a0', 'quantite': '20 g'}, {'ingredient_id': 'abcf4700-c115-4677-926d-e400ec13ed64', 'quantite': '20 g'}, {'ingredient_id': '0508bf4b-72c3-493d-a76e-d55790cb38ea', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50091, 'Eau aromatisée à la banane', 'eau, banane', '5 min', ['Verser l''eau dans un grand bocal.', 'Eplucher les trois bananes, puis les passer une à une au mixeur. Mélanger ensuite l''eau et le jus de bananes.'], ['Balance de cuisine', 'Casserole', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'Eau aromatisée à la banane', 'plat de résistance', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:06:08.407340', [{'ingredient_id': 'eba046bd-4337-41cc-bd7d-f9c3355d966c', 'quantite': '1'}, {'ingredient_id': '504dec23-ab88-4e00-9193-26b34ab955d2', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (225398, 'Salade fraises bananes au vin blanc moelleux', 'fraises, banane, orange, vin blanc, chocolat, vanille, citron, sucre, menthe', '10 min', ['Emincer les fraises et les bananes en fines rondelles, ajouter la vanille, le vin, le jus d''orange, presser un peu de citron, ciseler finement la menthe et faire des pépites de chocolat avec un couteau.  ', 'Sucrer et arroser de citron à votre goût.'], ['Louche', 'Spatule', 'Moule à tarte', 'Presse-agrumes', 'Planche à découper'], ['entrée', 'banane', 'gâteaux aux fruits', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'menthe', 'facile', 'Salade fraises bananes au vin blanc moelleux', 'bon marché', 'rapide', 'vin blanc', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'citron', 'orange', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:06:13.213579', [{'ingredient_id': 'd5aad939-55f9-4b22-b27d-32080e3898cb', 'quantite': '500 g'}, {'ingredient_id': '23e601a4-263a-47ed-b916-acc1c6b9b31e', 'quantite': '2'}, {'ingredient_id': '0602fb8a-5b5a-4cc9-a767-e26a16dec1f1', 'quantite': ''}, {'ingredient_id': 'd56c2710-d127-426a-852e-892256173ac6', 'quantite': '5 cl'}, {'ingredient_id': '82ad69ca-f33b-48d0-9e27-b93c109d71f3', 'quantite': '30 g'}, {'ingredient_id': '0ead2304-47c3-4b2e-ae3a-d685ac938631', 'quantite': '1'}, {'ingredient_id': '91b529a5-6b41-4dbd-912f-10ab648142b1', 'quantite': '1'}, {'ingredient_id': '64734b3e-ca25-4a86-b820-093263953ba8', 'quantite': ''}, {'ingredient_id': 'f19da4d4-98c1-4b1c-bf9e-a4dab8b165df', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65413, 'Dessert de soupe à la banane', 'banane, orange, citron vert, sucre, eau', '15 min', ['Faire chauffer l''eau avec le sucre, verser dans un saladier.', 'mettre le zeste de l''orange et du citron vert.', 'Presser l''orange et le citron vert, mettre dans le saladier.', 'Couper les bananes en fines lamelles dans le saladier.', 'Mettre à refroidir.'], ['Tire-bouchon', 'Presse-agrumes', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Dessert de soupe à la banane', 'orange', 'citron vert', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:06:16.872436', [{'ingredient_id': 'ef516c72-23f9-40d9-904b-a80482abdfa3', 'quantite': '6'}, {'ingredient_id': '1fcb0c1e-f461-4bf0-8a86-6b9cdd7001b5', 'quantite': '1'}, {'ingredient_id': '9c0869a4-b6db-419b-ba3c-1e1045b47360', 'quantite': '1'}, {'ingredient_id': '3a36c228-8222-490f-a969-75eac98c42cc', 'quantite': '100 g'}, {'ingredient_id': '0acd2bce-08e1-472b-a114-ab22f2297910', 'quantite': '200 ml'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (529401, 'Gâteaux bananes (beignets de bananes plantains)', 'banane plantain, oeuf, arôme vanille, sucre, farine de blé, huile, levure chimique', '15 min', ['Éplucher et couper les bananes en morceaux, puis écraser à la fourchette jusqu''à l''obtention d''une purée.', 'Ajouter l''oeuf, le sucre, l''arôme vanille (facultatif) et bien mélanger.
', 'Incorporer progressivement la farine et la levure puis recouvrir de cellophane ou d''un torchon. Laisser reposer la pâte 30 minutes.', 'Chauffer l''huile, puis commencer la cuisson des beignets. S''aider de 2 cuillères à soupe. Remplir à moitié la première et s''aider de la deuxième pour faire tomber la pâte dans l''huile. Dès qu''un côté commence à être doré, retourner les beignets pour qu''ils gonflent et finissent leur cuisson.', 'Mettre les beignets cuits dans un premier plat recouvert de papier absorbant. Changer de papier à chaque tournée. Mettre ensuite les beignets dans un deuxième plat recouvert de papier absorbant pour une absorption maximale de l''huile.', 'Déguster enrobé de sucre, avec de la pâte à tartiner ou encore avec une sauce tomate pimentée.'], ['Spatule', 'Casserole', 'Moule à tarte'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'beignets sucrés', 'Gâteaux bananes (beignets de bananes plantains)', 'dessert', 'plat de résistance', 'farine de blé', 'banane plantain', 'arôme vanille', 'sucre', 'cocktail'], 'Amuse-gueule', 87e76c0c-91ce-4472-b4d9-6a5844a30451, '2025-09-26T17:06:20.442281', [{'ingredient_id': 'be96614a-2d3d-4c97-b381-d669f17404f5', 'quantite': '4'}, {'ingredient_id': '536892de-ce8b-4453-a3a2-d3fc61d13d31', 'quantite': '1'}, {'ingredient_id': '3a8d892c-f6d4-410f-9bd6-854600ff7262', 'quantite': '1 cuillères'}, {'ingredient_id': 'edf5ad1b-4d31-4d71-b097-cfc8b97a7419', 'quantite': '60 g'}, {'ingredient_id': '39ce7a61-d391-4913-a60a-5cf77803d2cf', 'quantite': '200 g'}, {'ingredient_id': 'a8a6e201-6a8b-4945-8935-8d9259f0e00b', 'quantite': ''}, {'ingredient_id': '0261f223-3f28-48fd-88b2-6df6f3ef7ad6', 'quantite': '11 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31879, 'Filet mignon aux fruits (micro-ondes)', 'filet mignon, oignon, pomme, curry, paprika, poivre, crème fraîche, vin blanc, banane, sel, farine', '15 min', ['Couper finement les oignons. ', 'Les faire fondre 5 mn au micro-ondes dans un plat non couvert (température maximum). ', 'Couper les pommes en petits dés. ', 'Les mettre sur les oignons. ', 'Couper la viande en fines tranches. ', 'La poser sur les pommes. ', 'Assaisonner avec les épices (curry, poivre et paprika). ', 'Faire cuire au micro-ondes 5 mn couvert. ', 'Mélanger dans un bol le vin blanc, la crème, le sel et la farine. ', 'Verser sur la viande et mélanger. ', 'Recouvrir de fines tranches de bananes. ', 'Faire cuire 5 mn couvert.'], ['Fouet', 'Rouleau à pâtisserie'], ['Filet mignon aux fruits (micro-ondes)', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'paprika', 'vin blanc', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'farine', 'dessert', 'plat de résistance', 'filet mignon', 'pomme', 'poivre', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:06:24.152228', [{'ingredient_id': 'c91be229-27aa-46ec-b276-342fe968fd05', 'quantite': '300 g'}, {'ingredient_id': '679d6f45-ada8-4212-a780-f1b6bb7a22a7', 'quantite': '2'}, {'ingredient_id': 'a78269ed-2a81-47ff-be0f-b0b082d889a8', 'quantite': '1'}, {'ingredient_id': '7a46e09d-3063-4721-9d8c-bb190c8a2459', 'quantite': '1 cuillères'}, {'ingredient_id': 'f1ec7ee9-32d7-471f-adaa-86211e3aa2a7', 'quantite': '1 cuillères'}, {'ingredient_id': '6dc10c13-d1d2-4e42-8501-a960631b70bc', 'quantite': ''}, {'ingredient_id': '2d155c8e-c42a-403a-a323-147b9b20cc0a', 'quantite': ''}, {'ingredient_id': '8b515ab6-599b-4ecd-85e1-e988a07ae925', 'quantite': ''}, {'ingredient_id': '1a945c9d-df6d-4b3c-adc1-fea1581445fb', 'quantite': '1'}, {'ingredient_id': 'b11ce6f1-e9a5-4e33-8821-f057db9f63cf', 'quantite': '1 cuillères'}, {'ingredient_id': '3caa2999-ef37-4cd7-bae8-21b6e8b57e58', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528281, 'Cookies bananes-chocolat noir et flocons d''avoine sans sucre', 'banane, flocons d''avoine, chocolat', '10 min', ['Préchauffer le four à 180 °C / Thermostat 6.', 'Écraser la banane à l''aide d''une fourchette pour obtenir une purée bien lisse.', 'Ajouter les flocons d''avoine et mélanger.', 'Faire fondre le chocolat au bain marie et l''ajouter à la préparation. Bien mélanger.', 'Faire des boules (à l''aide d''une cuillère à glace c''est pratique !) d''environ 25g.', 'Déposer les sur une plaque recouverte de papier sulfurisé. Les aplatir légèrement.', 'Laisser cuire 25-30 min.'], ['Batteur électrique', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'cookie', 'plat', 'Cookies bananes-chocolat noir et flocons d''avoine sans sucre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'flocons d''avoine', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T17:06:27.719929', [{'ingredient_id': 'cb06550e-8452-4051-b520-83085cd51294', 'quantite': '1'}, {'ingredient_id': '4e75fdf8-1605-4391-b700-936271725bd7', 'quantite': '85 g'}, {'ingredient_id': 'd7f77051-6dfb-4872-9502-2fdb4b49d790', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22467, 'BANANES CHOCOLAT', 'banane, café, chocolat, vanille, crème fraîche, sucre en poudre, rhum', '15 min', ['Eplucher les bananes et les couper en rondelles dans un saladier, les saupoudrer de 2 cuillères à soupe de sucre et de 2 cuillères à soupe de rhum, remuer délicatement. ', 'Casser le chocolat dans une casserole et faire fondre à feux doux avec une goutte d''eau. Quand le chocolat forme une pâte lisse mettre la crème fraîche, 1 cuillère à soupe de sucre, la tasse de café fort, la vanille. Remuer le tout et verser cette préparation sur les bananes. ', 'Mettre au frigo.'], ['Louche', 'Couteau de chef', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'confiserie', 'testées', 'chocolat', 'BANANES CHOCOLAT', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'café', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', 2849e69a-bb71-4179-b41f-54ca750611b1, '2025-09-26T17:06:31.385682', [{'ingredient_id': '3432531d-15e0-4db3-8d2b-f1633755b2de', 'quantite': '4'}, {'ingredient_id': 'f67f5fb4-339f-4821-8c36-74e01a5474e3', 'quantite': '1'}, {'ingredient_id': '71aa5637-0b2f-41c2-aca0-296c439cea94', 'quantite': '125 g'}, {'ingredient_id': '7c87b7d9-3504-4390-aad9-fc537c04e5bf', 'quantite': '1 cuillères'}, {'ingredient_id': '89c28c32-5c54-4117-a6dd-d21487f2c4ba', 'quantite': '50 g'}, {'ingredient_id': '3d1d9b35-6de6-455e-aba0-77ddffebca6d', 'quantite': '3 cuillères'}, {'ingredient_id': 'b1474938-8577-4c8c-bbe8-38c3bbfb71c6', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43020, 'Gâteau au yaourt, bananes et chocolat', 'yaourt nature, yaourt, oeuf, sucre, sucre vanillé, farine, levure, banane, chocolat noir', '5 min', ['Préchauffez votre four.', 'Mettez tous les ingrédients au fur et à mesure dans un récipient.', 'Mélangez jusqu''à ce que la pâte devienne fluide (sans trop de grumeaux).', 'Découpez vos bananes en rondelles, hâchez le chocolat pour en faire des pépites puis ajoutez au mélange.', 'Enfounez à 150°C (thermostat 5) pendant environ 40 à 45 minutes (jusqu''à ce que le dessus soit bien doré).'], ['Planche à découper', 'Fouet', 'Presse-agrumes', 'Pince de cuisine', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'Gâteau au yaourt', 'yaourt', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'bananes et chocolat', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre vanillé', 'gâteau au chocolat', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:06:37.318660', [{'ingredient_id': 'b5077161-7de2-40cc-a21e-9d18413ae4a0', 'quantite': '1'}, {'ingredient_id': '0d15b621-5d99-4638-ac2f-0f1a26be208e', 'quantite': ''}, {'ingredient_id': '13da0d01-f0ad-4d9e-9036-9037ec6ad6aa', 'quantite': '2'}, {'ingredient_id': '209a3196-f1d7-4a22-beac-a181f27f342d', 'quantite': '2'}, {'ingredient_id': '1b3654ff-4afc-4b36-ad58-44a3d06df156', 'quantite': '1'}, {'ingredient_id': 'fe2777c3-f2cf-426a-b0c8-e51a6ff06a7e', 'quantite': '3'}, {'ingredient_id': '60163081-cc7a-47b3-9ab3-5cadd16ed8d7', 'quantite': '1'}, {'ingredient_id': '678347ae-903d-4ee3-9966-d35a02b83eb5', 'quantite': '3'}, {'ingredient_id': '52725994-5532-4723-b799-6b62d50355ea', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29858, 'Duo de mousses bananes et chocolat noir (7ème rencontre)', 'banane, oeuf, crème fraîche, sucre, gélatine, chocolat noir, oeuf, crème fraîche, sucre, boudoir', '150 min', ['Ustensiles :', 'L''usage d''un mixer-batteur me parait indispensable (ou alors mieux vaut avoir un sacré coup de poignet!)', 'Un joli tablier de cuisine (risque majeur d''éclaboussures)', 'Attention, prévoyez une grosse vaisselle après !', 'Préparation :', 'Découpez vos bananes en rondelles et faites-les revenir à feu doux dans une sauteuse. Faites bien évacuer le jus rendu par les bananes (sinon la gélatine sera indispensable). Laissez refroidir.', 'Prenez 2 saladiers : un grand et un moyen. Séparez le blanc des jaunes de vos oeufs : le jaune dans le grand saladier, le blanc dans le moyen.', 'Ajoutez le sucre aux jaunes et fouttez jusqu''a ce que le mélange blanchisse.', 'Ajoutez vos bananes cuites refroidies et mixez le tout.', 'Dans un autre saladier, versez la crème fraîche et fouettez-la fermement (avec le batteur, hein, sinon vous risquez la tendinite!).', 'Incorporez lentement la crème fraiche battue au mélange de bananes', 'Battez les oeufs en neige très ferme. Incorporez-les doucement au mélange. Ici, il est important de bien prendre votre temps.', 'La mousse de bananes peut vous sembler fort liquide. Celle-ci met longtemps à prendre. En cas de doute, l''ajout d''un peu de gélatine peut s''avérer utile (2 cuillères à café, diluées dans un fond d''eau, ou une feuille).', 'Remplissez à moitié vos verres avec ce mélange et mettez au réfrigérateur.', 'On recommence pour la mousse au chocolat: séparez le blanc du jaune de vos oeufs, le blanc dans un saladier moyen, le jaune dans un grand.', 'Ajoutez le sucre aux jaunes et battez jusqu''à ce que le mélange blanchisse.', 'Cassez le chocolat en morceaux et mettez-le au micro-ondes 40 à 50 secondes. Mélangez-le (ne pas se fier à sont aspect encore ''en tablette'', le chocolat peut-être fondu, mais avoir l''air encore en morceaux!!). Remettez-le encore 40 à 50 sec au micro-onde. Cela devrait suffire à le faire fondre. Mélangez-le.', 'Ajoutez-le au mélange oeufs-sucre. Mélangez le tout.', 'Battez la crème fraîche fermement (vous la voyez, là, la tendinite?).', 'Incorporez-la délicatement au mélange chocolaté.', 'Battez les blancs en neige très ferme. Incorporez-les doucement. Prenez votre temps!', 'Reprenez vos verres dans le frigo. Formez un ''plancher'' avec vos boudoirs sur la mousse de bananes. Si le coeur vous en dit, vous pouvez imbiber ceux-ci d''un alcool de votre choix, mais là, je ne me prononcerai pas, c''est selon vos goûts.', 'Versez la mousse au chocolat noir par dessus. Remettez le tout au frigo.', 'Le lendemain, vous pouvez déguster!'], ['Tire-bouchon', 'Spatule', 'Mixeur', 'Économe', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'rapide', 'Duo de mousses bananes et chocolat noir (7ème rencontre)', 'oeuf', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'gélatine', 'sucre', 'cocktail'], 'Dessert', 122749ad-fa47-477e-8121-2f4ecd605861, '2025-09-26T17:06:40.989055', [{'ingredient_id': 'eec99aa9-9a15-478e-9e19-64f47212746b', 'quantite': '6'}, {'ingredient_id': 'b0143646-5b4f-4c9c-b537-959f8b139265', 'quantite': '6'}, {'ingredient_id': 'b83eefba-06a2-4c5d-b76c-08ca18d58646', 'quantite': '20 cl'}, {'ingredient_id': 'e78b61f5-81eb-49fa-999d-107287e4850c', 'quantite': '125 g'}, {'ingredient_id': '20d0ab20-9bb0-4b9f-ba8e-6c90b5d968ef', 'quantite': ''}, {'ingredient_id': '247600aa-26a5-4563-99e3-35f53db44251', 'quantite': '300 g'}, {'ingredient_id': 'f97dd410-4a6b-4725-aebd-c57e44cd5b69', 'quantite': '6'}, {'ingredient_id': 'c670406d-64c3-46cc-ae77-d75f5ee449cd', 'quantite': '20 cl'}, {'ingredient_id': '7e9d66d4-e9bd-4711-8866-0cfe1088c05d', 'quantite': '150 g'}, {'ingredient_id': '7af87c61-597b-4b44-a6a8-85dbc811cd08', 'quantite': '16'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (92582, 'Chaussons à la banane', 'pâte feuilletée, banane, sucre roux, jaune d''oeuf', '10 min', ['1/ Préchauffez le four à 210°C.', 'Etalez la pâte feuilleté en un rectangle, découpez des carrés d''environ 8cm sur 8, découpez la banane en petits cubes.', '2/ Au milieu des carrés de pâte disposez quelques cubes de banane que vous saupoudrerez de sucre. Refermez le carré de pâte de façon à ce que cela fasse un triangle.', '3/ Appliquez au pinceau le jaune d''oeuf additionné d''une cuillère à café d''eau.', 'Enfournez 15 minutes au milieu du four.'], ['Balance de cuisine', 'Économe', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'Chaussons à la banane', 'cocktail', 'sucre roux'], 'Dessert', c532a5df-a6e1-4356-8b27-befb616dbd4e, '2025-09-26T17:06:44.646444', [{'ingredient_id': 'f800a1f2-e20a-4d33-bf08-c071cedbb73c', 'quantite': '1'}, {'ingredient_id': '7d144d77-70c1-4336-b144-3f11117fc82c', 'quantite': '1'}, {'ingredient_id': '52143793-a1dc-4354-a508-f7812feaecfa', 'quantite': '30 g'}, {'ingredient_id': '5df36628-c464-417e-b0f9-f25129c64ec3', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42979, 'Poulet épicé au beurre de cacahuète', 'blanc de poulet, légumes, tomate, oignon, ail, banane, beurre de cacahuètes, gingembre, piment, poivre, sel, tomate, citron, huile d''olive, piment', '20 min', ['Pour le poulet : ', 'Dans une casserole, faire dorer l''oignon dans un peu d''huile d''olive. Pendant ce temps, découper les blancs de poulet en dés. Les faire revenir 5 min avec l''oignon', 'Ajouter les légumes surgelés pour wok. Mélanger le tout jusqu''à ce que les légumes soient dégelés.', 'Ajouter, le gingembre, l''ail coupé en 4, la banane en rondelles, la tomate en morceaux, le piment de Sambale et le beurre de cacahuéte. ', 'Mélanger bien le tout.', 'Ajouter de l''eau du robinet jusqu''à hauteur du mélange. Couvrir et laisser mijoter à feu moyen-doux pendant minimum 1h30 heure. ', 'Mélanger réguliérement.', 'Pour l''accompagnement : salade de tomate piquante', 'Hacher l''échalote. Découper les tomates en tout petits dés. Mettre le tout dans un petit saladier.', 'Y ajouter le jus de citron, l''huile d''olive, le piment de Sambale et saler généreusment.'], ['Mixeur', 'Tire-bouchon'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'Poulet épicé au beurre de cacahuète', 'facile', 'bon marché', 'beurre de cacahuètes', 'tomate', 'ail', 'légumes', 'plat', 'blanc de poulet', 'recette', 'piment', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:06:48.371362', [{'ingredient_id': 'b52f7ded-a4c6-44b6-b20c-13bdefd3cbde', 'quantite': '4'}, {'ingredient_id': '7f37a9a0-12d8-44c5-a7ec-8508f825108a', 'quantite': '300 g'}, {'ingredient_id': 'fb7570a6-95f7-4b3b-9e86-d7ca2472e0aa', 'quantite': '1'}, {'ingredient_id': 'd5124406-fdbd-464e-b50a-c194c594b59d', 'quantite': '1'}, {'ingredient_id': '14ed6649-93ab-4075-bd32-324cbbf88489', 'quantite': '1'}, {'ingredient_id': '3a3ebca3-c626-44f1-9b9f-7c3c511371fd', 'quantite': '1'}, {'ingredient_id': 'acc90030-97bd-4ad7-85c0-d48269294ed3', 'quantite': '4'}, {'ingredient_id': '34408f6a-b275-4b66-b6ca-afbf21e4b471', 'quantite': '2 cuillères'}, {'ingredient_id': 'c65cfcba-93ea-4d8f-a691-60a1478d1c94', 'quantite': '1 cuillères'}, {'ingredient_id': 'dd830fac-0984-40cb-afe4-967fdc0aa3ee', 'quantite': ''}, {'ingredient_id': '98eb10fe-ea19-4ade-8387-1bd31845ac03', 'quantite': ''}, {'ingredient_id': '36d0b648-1cc3-4da5-92f2-b7845bd07312', 'quantite': '3'}, {'ingredient_id': '9a8baf49-5e7a-4659-94f9-e6d067012c3f', 'quantite': '1'}, {'ingredient_id': '44186b02-f74b-4fd2-8be6-489c55027df0', 'quantite': '1 cuillères'}, {'ingredient_id': '8b84e107-2753-4962-97d9-2c903b9efbc0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (94856, 'Compote de Célia', 'pomme, poire, banane, sucre, cannelle', '15 min', ['Epluchez les fruits. Les coupez en petits morceaux.', 'Les faire bouillir pendant 5-10min jusqu''à ce que les fruits tirent de l''eau.', '( pour accélérer la cuisson, recouvrez la casserole avec un couvercle )', 'Otez la casserole du feu, mélanger avec un fouet, ajoutez le sucre et la cannelle.', 'Laissez refroidir.'], ['Batteur électrique', 'Tire-bouchon', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Compote de Célia', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'cannelle', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:06:53.605696', [{'ingredient_id': '27c1ba7c-a40d-4673-9557-c2bb87c16466', 'quantite': '4'}, {'ingredient_id': 'cf945fbe-b9c1-439c-bb3a-92f03a473c99', 'quantite': '3'}, {'ingredient_id': 'ee416ffc-7284-436b-86f8-c8267fd268ca', 'quantite': '2'}, {'ingredient_id': 'c028f828-c9bb-43b0-87a5-4d340a554080', 'quantite': '50 g'}, {'ingredient_id': '5ee03f3e-3a07-4393-8013-636f6496cf07', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345136, 'milkshake à la banane et caramel fleur de sel', 'banane, glace, lait, citron, glaçons', '3 min', ['Couper la banane en tranches fines et la verser dans le bol du blender.', 'Ajouter les autres ingrédients et mixer le tout.', 'Il ne reste plus qu''à déguster !!!'], ['Casserole', 'Louche', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace', 'dessert', 'plat de résistance', 'glaçons', 'citron', 'lait', 'milkshake à la banane et caramel fleur de sel', 'cocktail'], 'Boisson', febe14a6-e8bf-48b1-9c34-5fa21bb10448, '2025-09-26T17:06:57.351424', [{'ingredient_id': 'e2a7d8a7-1151-460a-afc8-48a0246b5c16', 'quantite': '1'}, {'ingredient_id': 'e978c380-d4f0-4cc0-9348-8def02332c56', 'quantite': '2'}, {'ingredient_id': 'a0e765bd-072e-4fd1-965d-ebeb17f9b00e', 'quantite': '1 cuillères'}, {'ingredient_id': '42837a4c-9aa0-4dbd-a748-6ae168911174', 'quantite': '1 cuillères'}, {'ingredient_id': '168b4248-938d-4891-9c0a-952c886c39e5', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (49902, 'Gâteau coco bananes', 'oeuf, sucre, crème fraîche, farine, levure, sucre vanillé, beurre, noix de coco, banane', '10 min', ['Mélanger 2 oeufs avec 100 g sucre.', 'Ajouter 100 g crème, 125 g farine et la levure. Mélanger. Incorporer ensuite les bananes coupées en rondelles.', 'Verser cette pâte dans un moule beurré, et enfourner à 180°C (thermostat 6), pendant 20 min.', 'Le sortir du four, et ajouter par dessus la préparation suivante :', '1 oeuf + 50 g sucre + 40 g beurre fondu + 50 g noix de coco + sucre vanillé.', 'Enfourner pendant encore 20 min.'], ['Poêle', 'Pince de cuisine', 'Casserole', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'Gâteau coco bananes', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'noix de coco', 'sucre', 'cocktail'], 'Dessert', 1d880bc2-a155-46de-847d-6c48995721a0, '2025-09-26T17:07:04.344252', [{'ingredient_id': 'a42e8d77-52a5-4331-b676-8b82ddfe62b3', 'quantite': '3'}, {'ingredient_id': 'aac0d824-4fa9-4824-88e4-e2952ddfbded', 'quantite': '150 g'}, {'ingredient_id': 'a6cc0832-69e7-4c6d-885a-217369f4a9cc', 'quantite': '100 g'}, {'ingredient_id': '72be9bce-ce19-4176-a2a7-bc078543b646', 'quantite': '125 g'}, {'ingredient_id': '6ab4a988-4cc1-4e8a-be3b-fea2dada9485', 'quantite': '1'}, {'ingredient_id': 'a1c9decb-3ba2-4cd4-a658-ba0e828979ba', 'quantite': '1'}, {'ingredient_id': '778a0b3a-a5e8-40ae-ae1e-522014f76f1e', 'quantite': '40 g'}, {'ingredient_id': '7e07f5be-f7ea-44de-b29d-945473ee58b1', 'quantite': '50 g'}, {'ingredient_id': '575e9c4f-6d07-4f4b-8287-b9233e6e8b7d', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30655, 'Caviar de banane à la groseille', 'banane, sucre, jus de citron, gelée, yaourt nature', '5 min', ['Ecrasez les bananes en purée avec le sucre. Mélangez avec le jus de citron, la gelée de groseille et les yaourts.', 'Réfrigérez la crème obtenue pendant au moins 2 h.', 'Servez dans des coupes individuelles avec des langues de chat ou des tuiles aux amandes.'], ['Couteau de chef', 'Râpe', 'Planche à découper', 'Fouet', 'Batteur électrique'], ['', 'entrée', 'Caviar de banane à la groseille', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'gelée', 'jus de citron', 'sucre', 'cocktail'], 'Dessert', f2215ecb-d38d-4254-95c1-2f1f25a89fad, '2025-09-26T17:07:09.609884', [{'ingredient_id': '70f8393d-3a25-4eb6-96da-b31f38411387', 'quantite': '4'}, {'ingredient_id': '6b35b828-a0df-4501-a599-e6a7938d40de', 'quantite': '100 g'}, {'ingredient_id': '3115b518-43e5-48c8-8949-9aaf5db7da93', 'quantite': '5 cl'}, {'ingredient_id': '34e08e33-5da1-476a-bfed-2f42662a27b0', 'quantite': '8 cuillères'}, {'ingredient_id': '0a8e3424-1c51-40a2-a03e-d45337aedcef', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23215, 'Bananes au chocolat au barbecue', 'banane, chocolat noir', '15 min', ['Prendre chaque banane, garder la peau, faites une fente avec un couteau en évitant de les couper en deux. Mettre des carrés de chocolat dans la fente. ', 'Enveloppez-les chacune dans du papier aluminium, en formant une papillote. Les placer sur la grille du barbecue. ', 'Surveiller la cuisson : une fois le chocolat fondu, on peut déguster ce dessert.'], ['Verre doseur', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Bananes au chocolat au barbecue', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:07:15.561395', [{'ingredient_id': 'cded84f7-62d8-4f19-9983-9459a952d703', 'quantite': '4'}, {'ingredient_id': 'cb672e01-5302-4b00-8447-5a7ba2e95c3d', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46116, 'Tarte à la ricotta et bananes', 'pâte sablée, ricotta, banane, oeuf, sucre glace, pignons, cointreau', '10 min', ['Préchauffez le four à 200°C (th 6-7).', 'Disposez la pâte sablée dans le plat à tarte, en la piquant avec une fourchette, et laissez précuire pendant 15 min. ', 'Pendant le temps de cuisson, séparez les blancs des jaunes d''œufs et les montez en neige ferme. ', 'Fouettez les 2 jaunes d’œufs avec le sucre glace, puis ajoutez la ricotta et une goutte de Cointreau et incorporez délicatement les blancs en neige.  ', 'Étalez ce mélange sur la pâte précuite, et disposez dessus les fines rondelles de banane. ', 'Saupoudrez d’une poignée de pignons de pin et enfournez pendant 15 min.', 'Bon appétit !'], ['Louche', 'Mixeur', 'Balance de cuisine', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'pignons', 'Tarte à la ricotta et bananes', 'pâte sablée', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'ricotta', 'cointreau', 'dessert', 'plat de résistance', 'sucre glace', 'cocktail'], 'Dessert', a253346d-fb31-4259-8fa5-f47b9b8ea7e7, '2025-09-26T17:07:19.298874', [{'ingredient_id': '49b42d99-485f-4ff9-abcb-19cad895070a', 'quantite': '1'}, {'ingredient_id': 'cd0b07d8-b0a5-40ac-b234-02c0e719ef12', 'quantite': '250 g'}, {'ingredient_id': 'eb83bd1e-4ff9-4a07-8766-b48fb59b47bb', 'quantite': '2'}, {'ingredient_id': 'a7b1a6dc-3020-4daa-b489-0466828b7122', 'quantite': '2'}, {'ingredient_id': '7e90cda3-bcbe-457a-9b68-7813eed468cf', 'quantite': '60 g'}, {'ingredient_id': '38a71e38-884a-4a05-892a-a6c2781dd22f', 'quantite': '10 g'}, {'ingredient_id': '37f4acae-8c55-40e0-9541-6228a0cd6916', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (92567, 'Fondant à la banane aux pépites de chocolat', 'farine, sucre, oeuf, lait, huile, levure, sucre vanillé, chocolat, chocolat, banane', '20 min', ['Préchauffez le four à 180°.Mettre dans le récipient la farine, le sucre, le lait et les oeufs. Mélangez pour obtenir un mélange omogène. Puis y incorporez l''huile. Ecrasez la bananes, versez la dans le récipient accompagné des pépites de chocolat. Mettez la levure et le sucre vanillé. Remuez le tout, beurrez le moule et versez une petite partie dedans. Disposez les carrés de chocolat puis recouvrez avec le reste de la pâte. ', 'Faîtes cuire pendant 20 mn à 180°.'], ['Presse-agrumes', 'Balance de cuisine', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'farine', 'Fondant à la banane aux pépites de chocolat', 'dessert', 'fondant au chocolat', 'plat de résistance', 'sucre vanillé', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:07:22.942152', [{'ingredient_id': '183581a3-477b-4696-9797-49dfe590de6c', 'quantite': '250 g'}, {'ingredient_id': 'f5db13cb-c9ff-468e-ac2f-57a42465c315', 'quantite': '125 g'}, {'ingredient_id': '9cc7bbf6-3ef7-42c5-b87a-fc410858e244', 'quantite': '3'}, {'ingredient_id': 'c5799e6e-3ed1-4997-b061-5ef61dbae2b2', 'quantite': '100 g'}, {'ingredient_id': 'd9271730-c860-4884-bc64-c8f26298633d', 'quantite': '75 ml'}, {'ingredient_id': '0a0f7a37-ca5d-4aef-acbb-f0ffa38ecf88', 'quantite': '1'}, {'ingredient_id': '21b6fdb6-3fba-495f-865c-c852caf6ed34', 'quantite': '1'}, {'ingredient_id': 'bac7ff4a-c299-4d6a-b7cb-d03f4e52c2fb', 'quantite': ''}, {'ingredient_id': 'e6bfe938-07ea-4475-aa47-ebeecb0733fd', 'quantite': ''}, {'ingredient_id': '56126eb1-d479-4b01-a17e-a75f37ece417', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528193, 'Banana Bread Muffins', 'banane, sucre, oeuf, farine, levure, bicarbonate, pépites de chocolat', '5 min', ['Dans un saladier, ecraser les bananes avec une fourchette. La préparation ne doit pas forcément être lisse, il peut rester des morceaux !)', 'Ajouter le sucre et mélanger toujours avec la fourchette.', 'Ajouter l''oeuf et le battre avec la préparation toujours avec cette même fourchette.', 'Ajouter la levure, le bicarbonate et la farine et fouetter à nouveau avec la fourchette jusqu''à ce que la préparation soit homogène.', 'Ajouter vos pépites de chocolat et mélanger à nouveau !', 'Remplir vos moules à muffin préalablement légèrement graissés. Pour une option encore plus gourmande, remplir à 1/3, et incorporer une gourmandise supplémentaire (pâte à tartiner, confiture, purée d''oléagineux, selon votre envie!), puis finir de remplir le moule aux 2/3.', 'Enfourner pendant 25 à 35 minutes, jusqu''à ce que la lame d''un couteau inséré dans un muffin en ressorte bien sèche.', 'Déguster ces petits muffins ! Ils sont idéaux au petit-déjeuner afin de faire le plein d''énergie, et gourmands l''après-midi à l''heure du goûter !'], ['Spatule', 'Verre doseur', 'Ouvre-boîte', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'pépites de chocolat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'Banana Bread Muffins', 'gâteau à la banane', 'sucre', 'cocktail', 'bicarbonate'], 'Dessert', 5eeb2a62-40c6-43ab-b8f0-0cf5c000b2d9, '2025-09-26T17:07:26.847272', [{'ingredient_id': '879da55a-f314-4612-bc93-7763bdf4bab9', 'quantite': '2'}, {'ingredient_id': '4ddffa23-83d1-4421-adad-f2116f8aeb43', 'quantite': '20 g'}, {'ingredient_id': 'a3fd6510-c105-4c90-a57e-cc57e0470064', 'quantite': '1'}, {'ingredient_id': '0f51c95a-e7ad-4405-bbee-41be8f14f241', 'quantite': '90 g'}, {'ingredient_id': 'b98cfc72-a08c-45fe-945c-c18ed6bb32d4', 'quantite': '1'}, {'ingredient_id': '696a9b44-e090-4e22-a053-76b2950ed1ea', 'quantite': '1'}, {'ingredient_id': 'c277bc9c-949f-48da-b589-7e53b57df1a5', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (19354, 'Cocktail Ilona', 'rhum, liqueur de menthe, jus d''ananas, orange, jus de banane', '3 min', ['Mettre dans une bouteille les alcools, ensuite finir de remplir la bouteille avec le jus d''ananas et le jus de fruits, moitié moitié. ', 'Secouer. ', 'Servir très frais.'], ['Râpe', 'Couteau de chef'], ['', 'entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'jus de banane', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus d''ananas', 'Cocktail Ilona', 'moyen', 'liqueur de menthe', 'orange', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:07:30.703132', [{'ingredient_id': 'a0532513-418d-4575-97ff-3f7c4e148723', 'quantite': '15 cl'}, {'ingredient_id': 'c8ca2309-b070-40c0-8569-b34e1e51cc6d', 'quantite': '15 cl'}, {'ingredient_id': '89506e86-23b8-4f16-926c-9ea155684c88', 'quantite': '50 cl'}, {'ingredient_id': 'e50669d4-2a0d-4dc9-81b5-0b220d6d13d9', 'quantite': '25 cl'}, {'ingredient_id': '4551a3df-ac2a-4967-b284-442696d69c7a', 'quantite': '25 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (253602, 'Crumble de bananes caramélisées', 'farine, beurre tendre, beurre doux, cassonade, sucre, banane, sel', '15 min', ['Faire préchauffer le four à 190°C (thermostat 6-7).', 'Mélanger dans un saladier la farine, le beurre mou, la cassonade et le sel. ', 'Mélanger du bout des doigts pour obtenir une pâte grumeleuse et sableuse. ', 'Dans une poêle, faire fondre le beurre normal et y jeter les bananes coupées en rondelles. ', 'Ajouter le sucre blanc et laisser caraméliser. ', 'Une fois caramélisées, les répartir dans des mini-cocottes avec leur jus et recouvrir de pâte à crumble. Disposer sur la pâte à crumble un copeau de beurre et saupoudrer de sucre. ', 'Enfourner pendant 20 à 30 minutes. ', 'Il faut que la pâte à crumble soit dorée. Servir tiède.'], ['Rouleau à pâtisserie', 'Économe', 'Ouvre-boîte', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'beurre tendre', 'cassonade', 'facile', 'bon marché', 'Crumble de bananes caramélisées', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'autres crumbles', 'beurre doux', 'sucre', 'cocktail'], 'Dessert', 32237c67-fd82-4fe8-818a-7e3884f90721, '2025-09-26T17:07:35.846621', [{'ingredient_id': 'aad98ff6-4024-4a69-9e92-ab2d4fdd74c0', 'quantite': '125 g'}, {'ingredient_id': '9bda93e7-8e25-4401-9b54-63c4223fa942', 'quantite': '120 g'}, {'ingredient_id': '5b9a8542-1d56-4932-91f1-fbd6ffd5d3a8', 'quantite': '30 g'}, {'ingredient_id': '2c24b868-4333-407e-93d9-da12e0cc4d36', 'quantite': '60 g'}, {'ingredient_id': 'ebbe0dc5-975c-4c54-aa58-dc1fe52525a3', 'quantite': '30 g'}, {'ingredient_id': '071cfbb4-1024-4f6b-bf32-b2f48ec924a9', 'quantite': '2'}, {'ingredient_id': '5fa7f775-444c-421c-8cda-34156d4fcce2', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (253637, 'Cake à la banane et coulis de carambar', 'oeuf, sucre, beurre, farine, levure chimique, banane, carambar©, vanille', '20 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Mélanger le sucre avec les œufs.', 'Ajouter le beurre fondu, ensuite ajouter farine et levure.', 'Couper les bananes en rondelles ou petits morceaux et les ajouter au mélange précédent.', 'Ajouter un peu de vanille liquide (pour l''arôme) et bien mélanger.', 'Verser le tout dans un moule à cake et faire cuire 30 min thermostat 6 (180°C).', '5 min avant la fin de la cuisson planter 5 petits carambars dans le gâteau.'], ['Verre doseur', 'Mixeur', 'Planche à découper', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'Cake à la banane et coulis de carambar', 'boisson', 'farine', 'vanille', 'autres cakes', 'carambar©', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:07:41.330361', [{'ingredient_id': 'd69b10fe-a1eb-4f28-be71-28ab56872245', 'quantite': '2'}, {'ingredient_id': '55d46727-5d00-45a0-bdf9-4063ac0c9993', 'quantite': '80 g'}, {'ingredient_id': '808a43c2-5a50-47f4-8517-a51f68405cef', 'quantite': '100 g'}, {'ingredient_id': '43da2120-ffb3-4845-95a1-a610da5fb6c0', 'quantite': '140 g'}, {'ingredient_id': '647da24d-d940-4b04-8ec4-5bb21b435a96', 'quantite': ''}, {'ingredient_id': '9a211cd7-a39a-44a8-8383-98d598c4b5e8', 'quantite': '3'}, {'ingredient_id': '34b803d7-731e-494c-8ef0-cd5ea8a3c26f', 'quantite': '5'}, {'ingredient_id': 'bb3fc96e-6a00-4e0f-9bc7-1b7964b8e875', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50720, 'Crème de banane au rhum', 'lait, jaune d''oeuf, sucre semoule, sucre vanillé, rhum, banane', '5 min', ['Ecrasez les bananes avec une fourchette avec le rhum.', 'Faites bouillir le lait avec le sucre vanillé puis retirez la casserole du feu.', 'Battez le sucre et les jaunes d''oeufs jusqu''à ce que le mélange blanchisse.', 'Délayez alors avec le lait chaud et versez la crème dans une casserole.', 'Faites épaissir à feu doux tout en remuant à la spatule.', 'La crème ne doit pas bouillir.', 'Retirez du feu, fouettez encore quelques minutes et ajoutez alors les bananes en purée.', 'Mélangez bien et mettez au réfrigérateur jusqu''au moment de servir. ', 'Accompagnez de biscuits au chocolat.'], ['Pince de cuisine', 'Balance de cuisine', 'Tire-bouchon', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Crème de banane au rhum', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:07:44.931553', [{'ingredient_id': '32d97581-46d8-48b7-9247-4637cf13377a', 'quantite': '40 cl'}, {'ingredient_id': '15819366-7a90-433b-98f6-51ce7d4aebbf', 'quantite': '3'}, {'ingredient_id': '687c1213-b707-42f6-9c44-280faafcf519', 'quantite': '50 g'}, {'ingredient_id': '09018928-7a23-486b-be7a-c7f0b7cc6a32', 'quantite': '1'}, {'ingredient_id': '9abc92e7-96d8-444a-ba96-315ff534f795', 'quantite': '1 cuillères'}, {'ingredient_id': 'aa2fe2e6-5147-4ec4-ad29-e45ee211f7a2', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (343649, 'Smoothie exotique', 'mangue, banane, ananas, fruits, glace vanille, glace, jus exotique', '10 min', ['Coupez les fruits en petits morceaux, mettez-les dans le mixeur.', 'Ajoutez la boule de glace et la glace pillée', 'Mettez ensuite le jus exotique, mixez le tout.', 'Vous pouvez décorer votre verre avec une 1/2 tranche d''ananas. Verser le smoothie.', 'Bonne dégustation !'], ['Mixeur', 'Moule à tarte'], ['jus exotique', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'Smoothie exotique', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'glace', 'dessert', 'plat de résistance', 'ananas', 'fruits', 'smoothies', 'cocktail'], 'Boisson', ec8449c8-cb2b-4386-847a-cf3b0cd0e947, '2025-09-26T17:07:48.628764', [{'ingredient_id': '3911a1f2-2575-4eb8-bd37-f7cd27176f84', 'quantite': '1'}, {'ingredient_id': '0e863a64-73a6-4a5a-b0b1-32ef68e42d7b', 'quantite': '2'}, {'ingredient_id': '738e5371-14e8-44ff-bb1d-9535b82d144e', 'quantite': ''}, {'ingredient_id': '11ccbd38-4b25-487d-8742-1286ae6b6c34', 'quantite': '1'}, {'ingredient_id': 'a076cfa2-a497-4a74-8921-5835940064e9', 'quantite': '1'}, {'ingredient_id': '8561e084-0789-4ca8-a707-ea78c038880f', 'quantite': ''}, {'ingredient_id': '4cb3de0c-9c55-442e-af97-448ef0024951', 'quantite': '12 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26113, 'Galette-flan parfumée et fondante banane et anis', 'banane, sucre vanillé, rhum, lait, graines d''anis vert, sucre, beurre, farine, oeuf', '30 min', ['1) Ecrasez les bananes dans une assiette creuse avec les sachets de sucre vanillé et le rhum. ', '2) Faites fondre une grosse noisette de beurre dans une poêle, y verser la préparation et la cuire sur feu assez vif jusqu''à évaporation de l''eau (obtention en 10 bonnes minutes d''une pâte compacte brune et collante caramélisée). Réservez. ', '3) Préchauffez votre four Th 5 soit 180°C . ', '4) Dans une casserole, chauffez le lait avec le sucre et les graines d''anis. Retirez du feu. ', '5) Prélevez une partie du lait chaud pour diluer la pâte à la banane dans l''assiette creuse de départ. Reversez le tout dans la casserole que vous remettrez sur le feu. ', '6) A ébullition, hors du feu, jetez la farine en une fois et remuez vigoureusement, la pâte doit être très épaisse et collante. La reposer sur le feu quelques instants si elle est trop liquide. ', '7) Hors du feu, ajoutez les oeufs un à un. Bien mélanger. Vous devez obtenir une pâte très épaisse. ', '8) Versez la pâte dans un grand moule à manquer anti-adhésif (27 cm de diamètre). Cuire une petite demi-heure. ', 'Servir tiède ou froid.'], ['Verre doseur', 'Casserole', 'Louche', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'graines d''anis vert', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'flan', 'Galette-flan parfumée et fondante banane et anis', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:07:52.424403', [{'ingredient_id': '3f35da80-856b-4afb-8153-d605e349e240', 'quantite': '2'}, {'ingredient_id': '8142fc04-2b75-4be5-a021-a71751c16d77', 'quantite': '3'}, {'ingredient_id': 'fd2e482a-4092-456b-9103-4c69721190fb', 'quantite': '2 cuillères'}, {'ingredient_id': '121c275a-cce9-48cf-9b08-5e39c380c488', 'quantite': ''}, {'ingredient_id': 'a1a78608-e07a-4086-baf3-d47bb2deaa4e', 'quantite': '1 cuillères'}, {'ingredient_id': 'e53a5469-cfcd-4c83-8482-e49768a7aa03', 'quantite': '50 g'}, {'ingredient_id': '718712e8-b033-48ee-a1dd-05526d34286c', 'quantite': '70 g'}, {'ingredient_id': '0ad4ede3-2631-4876-ba8a-fd5ab0513c03', 'quantite': '130 g'}, {'ingredient_id': '8b47b916-ca85-409f-9f57-e29026c4df67', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (171495, 'Confiture à la banane et à l''orange', 'banane, orange, citron, sucre', '15 min', ['Éplucher les bananes, les couper en rondelles d''un demi-centimètre d''épaisseur. Presser les oranges et le citron.', 'Mettre les bananes et le jus des fruits dans une bassine à confiture avec le sucre.', 'Faire cuire à feu doux 20 à 25 min en écumant pendant le début de la cuisson et en tournant de temps en temps pour que la confiture n''attache pas au fond de la bassine. ', 'La préparation doit prendre une belle couleur rougeâtre.', 'Verser dans des pots et couvrir aussitôt.'], ['Presse-agrumes', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'confiture d''orange', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'orange', 'sucre', 'cocktail', 'Confiture à la banane et à l''orange'], 'Confiserie', fa32019d-10c3-4e29-b774-d7e60062c95b, '2025-09-26T17:07:57.749716', [{'ingredient_id': 'bce4c05b-1c99-4b7b-86f9-8a4868ca8fa1', 'quantite': '1 kg'}, {'ingredient_id': '0f1b2124-a6d9-4dfd-be55-e9084a351bf4', 'quantite': '1 kg'}, {'ingredient_id': '5d57d701-b0c7-4996-b555-f2022aceec6f', 'quantite': '1'}, {'ingredient_id': 'f93c6729-84fa-4148-903a-8bac0c0869b5', 'quantite': '800 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22297, 'crème de kiwis aux bananes', 'kiwi, banane, lait, oeuf, sucre, cannelle, caramel', '15 min', ['Verser le lait dans une casserole et porter à ébullition. Enlever du feu et laisser tiédir. ', 'Dans un saladier battre les oeufs en omelette, ajouter le sucre et la cannelle tout en continuant de fouetter. ', 'Préchauffer le four à 180°C ( therm 6 ). ', 'Peler et mixer kiwis et bananes. Verser la purée de fruits dans les oeufs sans cessr de remuer. Ajouter le lait tiède. ', 'Dans un moule à gâteau, tartiner de caramel les parois du moule puis y verser la préparation. La faire cuire au four au bain-marie 20 à 30 mn. Démouler et servir froid.'], ['Louche', 'Balance de cuisine'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'caramel', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'crème de kiwis aux bananes', 'cannelle', 'lait', 'sucre', 'cocktail'], 'Dessert', 53cf52e3-7c3b-4a3f-b472-728d05001b8d, '2025-09-26T17:08:01.514488', [{'ingredient_id': 'fdf6e731-3e1f-45bf-a0f9-ea83836c7efd', 'quantite': '6'}, {'ingredient_id': 'c3a42360-58af-4d52-8723-fa429f2c0c4e', 'quantite': '3'}, {'ingredient_id': '14d7fccb-2a3d-49f2-816d-4778a28d2868', 'quantite': '20 cl'}, {'ingredient_id': 'a741061c-1951-44ed-b9a6-cdaf65f5b209', 'quantite': '2'}, {'ingredient_id': '9516a247-ceaf-4970-875c-354facddd7f9', 'quantite': '100 g'}, {'ingredient_id': 'd4685caf-544b-4f2d-865a-a5159b34aafb', 'quantite': ''}, {'ingredient_id': '6b333f5f-cb39-4d01-a017-56a6e4d7bad4', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (222588, 'Crumble à la banane et à la mangue', 'mangue, banane, beurre, sucre, sucre vanillé, farine', '10 min', ['Préchauffer le four à 200°C (thermostat 6).', 'Beurrer un plat allant au four.', 'Couper les fruits en morceaux et les disposer dans le plat de façon homogène.', 'Disperser le sucre vanille sur les fruits.', 'Dans un saladier, mélanger le beurre, farine et sucre. ', 'Faire des petites boules. Les émietter ensuite sur les fruits sur toute la surface du plat.', 'Mettre au four pendant 30 à 40 min.', 'Laisser refroidir avant de déguster !', 'Bon appétit !'], ['Fouet', 'Poêle', 'Planche à découper', 'Presse-agrumes', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'facile', 'bon marché', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'Crumble à la banane et à la mangue', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:08:05.308468', [{'ingredient_id': '7f831b51-199f-4239-8649-0a157d537a89', 'quantite': '1'}, {'ingredient_id': '7141c6a1-3a7d-4d9b-9c49-22350c0ae21f', 'quantite': '2'}, {'ingredient_id': 'f7e3fbbe-c55f-4c21-a73e-3665b8affc45', 'quantite': '100 g'}, {'ingredient_id': '11470732-814a-4a50-b049-226d7ced48d3', 'quantite': '100 g'}, {'ingredient_id': '5e56e3ba-06b3-43f5-9e6b-d068fdaf4422', 'quantite': '1'}, {'ingredient_id': 'b8af6b16-f6b0-458c-aa29-2e41698b0bc3', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228098, 'Gâteau au yaourt Ananas/Banane', 'yaourt, farine, sucre, oeuf, huile, levure, ananas, banane', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Mettre tous les ingrédients dans un saladier puis mélanger.', 'Mettre la préparation dans un moule beurré.', 'Mettre au four pour environ 30 min de cuisson.'], ['Moule à tarte', 'Batteur électrique', 'Rouleau à pâtisserie', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'Gâteau au yaourt Ananas/Banane', 'facile', 'bon marché', 'oeuf', 'plat', 'gâteau à l''ananas', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'ananas', 'sucre', 'cocktail'], 'Dessert', a128ea1a-d1b1-4d5d-a105-12554e871c2c, '2025-09-26T17:08:08.959968', [{'ingredient_id': 'e733d505-76f3-43fd-aac7-06db03e18051', 'quantite': '1'}, {'ingredient_id': '650d9ecb-7f93-4499-8ea7-2e7523525123', 'quantite': '3'}, {'ingredient_id': '1465dc61-f345-415f-bd3c-d10d3940afdf', 'quantite': '2'}, {'ingredient_id': 'ee9e7670-2f99-4c64-8d80-b27fa49f8922', 'quantite': '3'}, {'ingredient_id': '99e92694-35db-47b4-bb28-4190f5a06af1', 'quantite': ''}, {'ingredient_id': 'fec8b19e-fcfa-4e23-90a0-a700bb19b531', 'quantite': '1'}, {'ingredient_id': '598b392f-13c6-4ca9-8310-2be6063885da', 'quantite': '1'}, {'ingredient_id': 'f94d7489-0e66-4807-bb0b-2c6cfebf601d', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (531810, 'Bananes au cacao', 'banane, chocolat, sucre, beurre, eau', '15 min', ['Coupe tes bananes en rondelles, mets-les dans la poêle. Veille bien à ce que l''un de tes parents soit à côté de toi pour faire cette recette.', 'Ensuite, ajoute le beurre, le sucre et l''eau.', 'Fais cuire au bain-marie le chocolat.', 'Après, mets les bananes dans des ramequins et le chocolat aussi.'], ['Casserole', 'Râpe', 'Louche', 'Balance de cuisine', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'chocolat', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Bananes au cacao', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T17:08:13.606122', [{'ingredient_id': 'b1cb8f03-ca26-4c1d-b2ce-c1975ca7b905', 'quantite': '3'}, {'ingredient_id': '25a4bc20-342b-4d8c-8c42-edcd51d2f620', 'quantite': '200 g'}, {'ingredient_id': 'f18f2ca0-6f57-48c9-b0c7-2d8c5a6f89a3', 'quantite': '1 cuillères'}, {'ingredient_id': 'd2eb0b2b-1bcf-4564-87d2-abf16b1efb35', 'quantite': '25 g'}, {'ingredient_id': 'abc59b40-e198-4ec4-9438-a6f6c9d42acd', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (39136, 'Dip de bananes plantains', 'banane plantain, tomate, ail', '10 min', ['Coupez la banane en très fines tranches (en enlevant la peau) et faites les dorer dans une poêle avec un filet d''huile d''olive en les salant. ', 'Mixez fin la tomate et l''ail. ', 'Quand les tranches de banane sont cuites servez-les séparées de la préparation de tomate et d''ail. ', 'Pour la manger il suffit de tremper les tranches dans la préparation.'], ['Casserole', 'Poêle', 'Moule à tarte', 'Planche à découper'], ['', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'ail', 'tomate', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'banane plantain', 'Dip de bananes plantains', 'moyen', 'cocktail'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:08:17.125370', [{'ingredient_id': 'dfd4f6ac-47a5-436b-8cab-34978b25ecb4', 'quantite': '1'}, {'ingredient_id': 'f124d943-81fb-4f98-bd88-2dbdb5b10ea2', 'quantite': '1'}, {'ingredient_id': '8ab6860f-4534-4b19-9ffc-1714af84dc40', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33361, 'Crumble fondant au chocolat et fruits d''automne', 'beurre, cassonade, farine, levure chimique, cannelle, pomme, banane, chocolat noir', '30 min', ['Dans une jatte, verser la farine, la cannelle, la levure et le sucre. Mélanger puis ajouter le beurre coupé en petits dés. ', 'Malaxer avec les doigts durant quelques secondes et émietter la préparation jusqu''à ce que des miettes se forment. Rajouter un peu de farine si la pâte est trop collante.', 'Peler les fruits, couper les pommes en gros quartiers et les bananes en rondelles assez épaisses.', 'Beurrer généreusement un moule à manquer, saupoudrer de sucre et y disposer les fruits.', 'Casser le chocolat en pépites (mettre dans un torchon et taper dessus au marteau, apr exemple) et les verser sur les fruits.', 'Ajouter la pâte uniformément sur les fruits et enfourner pour 15 à 20 min à four chaud (thermostat 8/250°C), jusqu''à ce que la croûte soit bien dorée.', 'Déguster tiède avec une boule de gace vanille.'], ['Verre doseur', 'Presse-agrumes', 'Louche'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'levure chimique', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'Crumble fondant au chocolat et fruits d''automne', 'boisson', 'farine', 'dessert', 'plat de résistance', 'autres crumbles', 'beurre', 'cannelle', 'cocktail'], 'Dessert', b80f9624-21dc-41c9-8a97-c152ad78559d, '2025-09-26T17:08:21.859662', [{'ingredient_id': 'c79c62ef-2ebc-49ce-ba34-e192112b6f0f', 'quantite': '100 g'}, {'ingredient_id': '2f1cfdc4-a253-445e-8153-4fb22462de8a', 'quantite': '150 g'}, {'ingredient_id': 'f747f0df-362a-4ef4-b902-2f0aca6a5e91', 'quantite': '100 g'}, {'ingredient_id': '86f4dd02-2201-4564-9766-4174b27b0932', 'quantite': ''}, {'ingredient_id': 'ffb1c87a-e940-4739-b86d-bc3d8a6a220e', 'quantite': '1 cuillères'}, {'ingredient_id': '025d3708-862a-4c3e-8299-3ec3eb72cf89', 'quantite': '4'}, {'ingredient_id': 'c88b474c-559c-4a6b-8f2f-1c950c323131', 'quantite': '3'}, {'ingredient_id': '3d1d1b4d-7be9-478d-9cdc-75abf96b7f4f', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (533293, 'Brownie chocolat banane noix', 'farine, sucre, chocolat noir, beurre, noix, banane, oeuf', '20 min', ['Préchauffez le four à 190°C. Cassez le chocolat en morceaux et faites-les fondre avec le beurre.', 'Cassez les œufs au dessus d’un saladier et fouettez-les avec le sucre.', 'Incorporer le chocolat fondu, et ajoutez la farine. Mélangez.', 'Pelez les bananes, coupez-les en morceaux et incorporez-les à la préparation.', 'Cassez les noix grossièrement et ajoutez les à la préparation.', 'Versez la pâte dans un moule carré ou rectangulaire (chemisé ou avec du papier cuisson), enfournez et laissez cuire 30 à 35 min. ', 'Laissez refroidir et dégustez ! Bon appétit :)'], ['Spatule', 'Presse-agrumes', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'noix', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'beurre', 'Brownie chocolat banane noix', 'sucre', 'cocktail'], 'Dessert', 699dcb03-6210-4355-bd62-1e00b2f40bc2, '2025-09-26T17:08:26.541165', [{'ingredient_id': '8352cb01-ae2e-438d-9def-70a30b635e39', 'quantite': '70 g'}, {'ingredient_id': '396ef999-17e8-4de6-b077-314ea96ddbb5', 'quantite': '90 g'}, {'ingredient_id': '2c28e671-949d-4f33-9a31-1922215d794f', 'quantite': '200 g'}, {'ingredient_id': '13c5fa87-6d0e-4665-a638-0a85826a0463', 'quantite': '120 g'}, {'ingredient_id': '9007ec0c-b606-4007-aaad-896860295065', 'quantite': '4'}, {'ingredient_id': '4a6b6387-0192-40b1-bd79-b2abbf8e4310', 'quantite': '3'}, {'ingredient_id': '34f98cde-49e5-478f-911d-8f25dd6b21d9', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52688, 'Purée de pommes de terre, carottes et banane', 'pomme de terre, carotte, banane, beurre, lait', '15 min', ['Peler les pommes de terre et les carottes, les couper en deux.', 'Faire cuire les pommes de terre et les carottes à l''eau bouillante, dans une casserole, pendant 15 à 20 min environ.', 'Pendant ce temps, peler les bananes et les couper en rondelles.', 'Les disposer dans un récipient adapté au micro-ondes, et faire chauffer pendant environ 1 min et demi à puissance max.', 'Quand tous les ingrédients sont cuits, les placer dans un récipient avec un peu de beurre et le lait, puis mélanger le tout avec un robot ou avec une fourchette.', 'Amis du sucré-salé, bon appétit !'], ['Moule à tarte', 'Économe', 'Balance de cuisine', 'Verre doseur', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'purée de pommes de terre', 'confiserie', 'testées', 'carotte', 'très facile', 'bon marché', 'carottes et banane', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'lait', 'Purée de pommes de terre', 'pomme de terre', 'cocktail'], 'Accompagnement', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:08:30.053115', [{'ingredient_id': '7ae159f1-a626-4884-9c6b-8c1c623bafce', 'quantite': '5'}, {'ingredient_id': 'a453f8a0-9406-4c5c-9005-a9e486823c22', 'quantite': '5'}, {'ingredient_id': '779b8ba9-aeb1-4640-aad8-56ab98c8f614', 'quantite': '3'}, {'ingredient_id': 'fd58b828-7797-4016-a980-706eadfd6d95', 'quantite': ''}, {'ingredient_id': '9b6beb81-9af5-4b52-b8c5-7f258618802c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27742, 'Bananes flambées au cointreau', 'banane, sucre vanillé, citron, beurre, cointreau', '15 min', ['Pelez les bananes, posez-les dans 4 carrés d''aluminium. Saupoudrez de sucre vanillé, arrosez de jus de citron. Déposez quelques noisettes de beurre sur les bananes. ', 'Faites cuire au four à 210°C (thermostat 7) ou sur le barbecue, pendant 10 min, de chaque côté.', 'Chauffez le cointreau. Ouvrez les papillotes, flambez le cointreau et versez-le dessus au moment de servir.'], ['Ouvre-boîte', 'Poêle', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Bananes flambées au cointreau', 'rapide', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'cointreau', 'dessert', 'plat de résistance', 'sucre vanillé', 'moyen', 'beurre', 'citron', 'cocktail'], 'Dessert', 91073c31-788a-41a3-a644-461064f47299, '2025-09-26T17:08:33.530690', [{'ingredient_id': '530a9294-8a49-4bd2-a794-9003d952ac8f', 'quantite': '4'}, {'ingredient_id': 'bce5b1ef-8cb9-4f3d-83fb-db028ab54be6', 'quantite': '30 g'}, {'ingredient_id': '63b1103a-0c21-4bb6-874b-8d49554a1480', 'quantite': '1'}, {'ingredient_id': 'bbe44fcb-3ab8-4d6e-8870-ea99fc5ba120', 'quantite': '50 g'}, {'ingredient_id': 'a47f8b1e-e8f3-4eff-b526-13026f69471f', 'quantite': '5 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (229940, 'Gâteau bananes, chocolat et noix', 'chocolat pâtissier, lait, miel, farine, levure, oeuf, cannelle, banane, noix, chocolat pâtissier, beurre, crème liquide', '15 min', ['Pour la pâte:', 'Préchauffez le four à 180°C (thermostat 6).', 'Faire fondre le chocolat avec le lait et le miel.', 'Une fois fondu, le verser dans un saladier.', 'Ajouter l''oeuf entier, la farine, la levure et la cannelle. Bien mélanger entre chaque (ajoutez un peu de lait si nécessaire).', 'Mettre les bananes coupées en rondelles et les noix concassées.', 'Beurrer un moule à cake, verser la préparation et faire cuire au four pendant 20-25 min à 180°C.', 'Pour le glaçage:', 'Faire fondre le chocolat, la crème et le beurre au  micro-onde et napper le gâteau.', 'Laisser reposer au frigo.'], ['Balance de cuisine', 'Poêle', 'Passoire', 'Pince de cuisine', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'Gâteau bananes', 'oeuf', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'levure', 'noix', 'miel', 'recettes', 'chocolat et noix', 'boisson', 'farine', 'dessert', 'plat de résistance', 'gâteau au chocolat', 'cannelle', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:08:37.215787', [{'ingredient_id': 'b9b473f1-0093-4d30-9d24-47159cac04d5', 'quantite': '50 g'}, {'ingredient_id': '6e444287-b32f-47ae-8f92-76c5d02fff84', 'quantite': '1 cuillères'}, {'ingredient_id': 'c5073b46-f8e2-4e57-8882-8c708dfc5d32', 'quantite': '1 cuillères'}, {'ingredient_id': '87d2f37f-2a6f-4750-a552-6f79867c7163', 'quantite': '100 g'}, {'ingredient_id': '8127e671-7da7-4bdd-8087-872175c149e0', 'quantite': '1'}, {'ingredient_id': 'ef8afe74-6efa-47e4-968b-e80a8bc70334', 'quantite': '1'}, {'ingredient_id': 'cf372919-1228-41f8-a74e-5c62e4682959', 'quantite': '1 cuillères'}, {'ingredient_id': 'b3719706-9a90-4a48-8053-4eea85962e82', 'quantite': '2'}, {'ingredient_id': '0adcace0-d258-48fe-97be-844a5df148c0', 'quantite': '100 g'}, {'ingredient_id': 'ec9edac8-a2cf-4118-a1c1-c0c9805e238e', 'quantite': '100 g'}, {'ingredient_id': '2ce9c77a-8bbf-46d3-b730-8303d673ae1e', 'quantite': '20 g'}, {'ingredient_id': '540652a9-9b89-49b8-88d4-881ea9fcac47', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (60024, 'Fondue au chocolat light au yaourt', 'fromage blanc, yaourt allégé, chocolat en poudre, sucre, cointreau, fraises, banane, pomme', '15 min', ['Passer au mixeur le fromage blanc, le yaourt, le chocolat, le sucre et la liqueur.', 'Verser dans un petit saladier et réserver au frais 30 min.', 'Couper les fruits et les disposer sur une assiette. ', 'Servir les fruits accompagnés du mélange au chocolat.'], ['Râpe', 'Ouvre-boîte', 'Planche à découper', 'Presse-agrumes', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'cointreau', 'dessert', 'plat de résistance', 'yaourt allégé', 'pomme', 'moyen', 'chocolat en poudre', 'sucre', 'Fondue au chocolat light au yaourt', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:08:40.842661', [{'ingredient_id': '885db768-997c-4131-ae8b-7973a34c5b37', 'quantite': '250 g'}, {'ingredient_id': 'fd6682f3-ab77-403a-818f-c57082258eb1', 'quantite': '1'}, {'ingredient_id': 'a1cf54d5-4c41-4757-84d3-5f12ba13fecb', 'quantite': '2 cuillères'}, {'ingredient_id': 'b66bc262-4a83-4d19-bc91-e2086484b7b6', 'quantite': '100 g'}, {'ingredient_id': '7b334310-4301-404b-9139-20be8485d6e8', 'quantite': '2 cuillères'}, {'ingredient_id': '7bb95c20-23c8-4281-8938-13145feae623', 'quantite': '250 g'}, {'ingredient_id': '93cc0b2f-7423-4434-baeb-556e88986db1', 'quantite': '2'}, {'ingredient_id': 'e91eb282-a946-441c-8618-58e0f1189be2', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (44427, 'Smoothie au lait de coco', 'jus d''ananas, lait de coco, banane', '10 min', ['Ecrasez les bananes en purée assez fine, puis les passer au mixer. ', 'Ajoutez le jus d''ananas et le lait de coco. Mixez de nouveau.', 'Et voilà, c''est déjà prêt!'], ['Râpe', 'Presse-agrumes', 'Spatule', 'Ouvre-boîte', 'Louche'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus d''ananas', 'smoothies', 'Smoothie au lait de coco', 'cocktail'], 'Boisson', 028b2f48-cc68-4ee8-8dbf-f899b22b0d9c, '2025-09-26T17:08:45.542514', [{'ingredient_id': '8451e347-ee79-4605-ac3a-8cc62d26faed', 'quantite': '1 l'}, {'ingredient_id': '63473376-eb93-45f1-96ad-dc5eecaa507e', 'quantite': '40 cl'}, {'ingredient_id': '0804d956-a11b-4703-8b64-f3168ea3b079', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (229510, 'Banana Bread sans beurre et sans oeufs', 'farine, sucre, banane, yaourt nature, levure chimique', '20 min', ['Préchauffer le four à 250°C (thermostat 8).', 'Dans un saladier, mélanger la farine avec le sucre et la levure.', 'Mixer 2 bananes jusqu’à les réduire en purée.', 'Les ajouter au saladier avec les yaourts et remuer. La pâte sera assez compacte et collante.', 'Verser une 1ère moitié de pâte dans le moule.', 'Écraser grossièrement les 2 autres bananes avec une fourchette pour garder des morceaux et les ajouter de manière plus ou moins égale, par dessus la pâte dans le moule.', 'Verser la seconde moitié de pâte et enfourner 35 min à 250°C.'], ['Presse-agrumes', 'Rouleau à pâtisserie', 'Balance de cuisine', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Banana Bread sans beurre et sans oeufs', 'confiserie', 'testées', 'levure chimique', 'yaourt nature', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', 2a984202-acbc-4ec3-add7-792a22cb33b3, '2025-09-26T17:08:49.090412', [{'ingredient_id': '51fd0516-78b9-4a2e-b66f-c4c30e408d40', 'quantite': '250 g'}, {'ingredient_id': 'a96176ff-ce37-4c98-8d98-0527b509cb76', 'quantite': '100 g'}, {'ingredient_id': '1cd40140-038b-4b46-826f-5f3020999ecd', 'quantite': '4'}, {'ingredient_id': 'e79ff1a0-f4ac-4ff9-9c49-578e7f4ea1e1', 'quantite': '2'}, {'ingredient_id': '8cf23b19-0dff-4c5f-b789-ca1eb8e5b31e', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73314, 'Milk shake banane choco', 'chocolat en poudre, lait, banane, glace pilée', '10 min', ['Mettre dans un blender les 2 cuillères à soupe de chocolat en poudre, le lait, la banane, puis ajouter la glace.', 'Faire tourner pendant environ 3 min à plein puissance.', 'Déguster immédiatement!', 'Bon appétit!'], ['Balance de cuisine', 'Poêle', 'Casserole', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat en poudre', 'lait', 'Milk shake banane choco', 'cocktail', 'glace pilée'], 'Dessert', f3544833-6b9c-41fa-8a9b-0d1a8c03106f, '2025-09-26T17:08:52.582615', [{'ingredient_id': '2a1d9c05-c184-4a71-b211-d1629d0873cc', 'quantite': '2 cuillères'}, {'ingredient_id': 'b38768a2-a8ca-4a50-b496-32cbfdf1a3fc', 'quantite': '6 cl'}, {'ingredient_id': 'f10b4e68-f3b2-4ac8-be33-ea7109a7aa37', 'quantite': '1'}, {'ingredient_id': '13e24fb1-35e2-4bbb-953c-2036f9a3b2d0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392219, 'Cake banane, chocolat, topping noisettes grillées', 'farine de blé, sucre, cacao en poudre, levure chimique, oeuf, huile de colza, banane, chocolat noir, noisettes', '10 min', ['Dans un récipient, mélanger la farine, le sucre, le cacao et la levure.', 'Ajouter les oeufs, l''huile, les bananes écrasées et le chocolat fondu. Mélanger bien.', 'Verser la préparation dans un moule rectangulaire ( 20cm x 10cm).', 'Ajouter un topping si désiré (noisettes grillées ou pépites de chocolat)', 'Enfourner pour 45 min à 180°C. Surveiller la cuisson à partir de 40 min. La pointe du couteau doit ressortir humide mais propre.'], ['Mixeur', 'Râpe'], ['entrée', 'banane', 'topping noisettes grillées', 'recettes de cuisine', 'confiserie', 'cacao en poudre', 'testées', 'levure chimique', 'cakes', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'noisettes', 'cuisine', 'recettes', 'boisson', 'dessert', 'Cake banane', 'plat de résistance', 'farine de blé', 'chocolat noir', 'sucre', 'cocktail', 'huile de colza'], 'Dessert', 62663b68-f458-4140-babf-482ef5ab66b4, '2025-09-26T17:08:56.133218', [{'ingredient_id': '55c60870-e805-49b8-87de-bbdab6f48668', 'quantite': '150 g'}, {'ingredient_id': '84f8930f-0c31-4914-908b-50207a09def0', 'quantite': '70 g'}, {'ingredient_id': '24e70772-ad34-4a6d-83ce-0b1454d5c9e2', 'quantite': '15 g'}, {'ingredient_id': '6cb20075-8b93-41b4-8d95-3c5db057a114', 'quantite': '5 g'}, {'ingredient_id': '54d25864-58bc-4daf-b69a-f9ce2d903d66', 'quantite': '2'}, {'ingredient_id': 'd0146c6f-cb56-4c54-ac00-4e6fa77d64aa', 'quantite': '60 g'}, {'ingredient_id': '07e2ba41-b936-4ed8-bb06-8c0d743cb6cf', 'quantite': '200 g'}, {'ingredient_id': '1c7b362c-15d5-4c5b-9cc3-1eabbf890e0e', 'quantite': '40 g'}, {'ingredient_id': 'b597e3b5-3d1d-4e1b-b240-c8719c109fb5', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81620, 'smoot-shake banane', 'banane, yaourt, jus d''orange, sucre vanillé, glace vanille', '5 min', ['Tout mettre bans de mixeur, jusqu''à ce que se soit liquide. Verser dans des verres.', 'Servir bien frais.'], ['Couteau de chef', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'sucre vanillé', 'smoot-shake banane', 'jus d''orange', 'cocktail'], 'Boisson', f09488bd-63a8-48ca-a0c4-60ad559e3307, '2025-09-26T17:08:59.677627', [{'ingredient_id': '100bc529-77ff-4447-80b0-943edd5abe6c', 'quantite': '1'}, {'ingredient_id': '28b6a7e7-f57f-47cd-9201-2a93dce2c8f4', 'quantite': '1'}, {'ingredient_id': '3968869a-5f06-4d49-a4df-4ee090272e4f', 'quantite': '1'}, {'ingredient_id': '0dc7e1dc-37d7-40a4-ab4d-b0b6ff9ddacd', 'quantite': '1'}, {'ingredient_id': 'e829636d-e70d-44b4-926c-a9ca794e6919', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12252, 'Flan pommes bananes express', 'pomme, banane, oeuf, crème fraîche, sucre, cannelle', '5 min', ['Dans un plat pouvant aller au micro-ondes, cassez les oeufs. Ajouter 3 c à s de sucre, la crème fraîche et la cannelle. Battre les oeufs.', 'Couper les bananes en rondelles et les pommes en petits morceaux. Mélanger avec les oeufs battus. ', 'Mettre à cuire au micro-ondes 5 min à puissance maximale.', 'Mélanger et remettre à cuire 5 min. Laisser tiédir quelques minutes et déguster chaud ou froid.'], ['Ouvre-boîte', 'Louche', 'Tire-bouchon', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'Flan pommes bananes express', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'flan', 'cannelle', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:09:04.515251', [{'ingredient_id': 'b6876110-1486-4d0c-a5a7-4dcdf6d68b4d', 'quantite': '2'}, {'ingredient_id': '7c405220-c694-4672-acec-2271778e8e6f', 'quantite': '2'}, {'ingredient_id': '8bb5caed-60bb-4139-b8ae-fc6ae7aeffad', 'quantite': '2'}, {'ingredient_id': '0f26db7d-4f92-4719-9209-db34cba00582', 'quantite': '1 cuillères'}, {'ingredient_id': '02d13783-2534-4cc1-a83e-6b180087a1f3', 'quantite': ''}, {'ingredient_id': '473a79ad-f15f-4d96-b972-a055a01e128c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (176140, 'Sandwich choco-banane', 'baguette, banane, chocolat pâtissier', '10 min', ['Mettre le chocolat à fondre dans une casserole. (Ou, à défaut, au micro-ondes).', 'Couper la banane en rondelles. La mettre à chauffer à la casserole (ou à défaut, une minute au micro-ondes).', 'Couper la demi-baguette en deux dans le sens de la largeur, puis dans le sens de la longueur.', 'Une fois que le chocolat est fondu, le tartiner sur deux des morceaux de baguette.', 'Répartir également les morceaux de banane cuits, et refermer les deux sandwich.', 'Bon appétit !'], ['Louche', 'Pince de cuisine', 'Tire-bouchon', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'baguette', 'Sandwich choco-banane', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:09:08.932929', [{'ingredient_id': '3b3471d2-bdab-4ca2-8ad7-f759b01007d8', 'quantite': '1'}, {'ingredient_id': '421f1a4b-5415-4e7d-8118-12171289c704', 'quantite': '1'}, {'ingredient_id': 'e51f4547-a87f-42e1-94ad-f4a289a55905', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70597, 'Sauté de porc sucré-salé au lait de coco', 'sauté de porc, oignon, ail, poivron rouge, tomate, banane, lait de coco, beurre, raisins secs, poivre, sel, curry, paprika, safran', '20 min', ['Faire revenir la viande dans une grosse noix de beurre, ajouter l''oignon émincé et la gousse d''ail hachée.', 'Une fois la viande dorée, ajouter le poivron lavé et vidé coupé en fines lamelles ainsi que les tomates coupées en quartiers et la banane en petits morceaux, remuer assez fréquemment.', 'Quand la banane a "fondu", ajouter des raisins si vous le désirez, et le lait de coco.', 'Maintenant à votre convenance vous pouvez insérer sel, poivre, curry, paprika et safran. Attention à ne pas trop recouvrir le goût de la viande...', 'Si besoin ajouter de l''eau jusqu''à recouvrir la viande et laisser mijoter à feu très doux pendant 20 min.', 'Servir avec du riz blanc.'], ['Casserole', 'Balance de cuisine', 'Couteau de chef', 'Spatule'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'Sauté de porc sucré-salé au lait de coco', 'testées', 'facile', 'bon marché', 'ail', 'sauté de porc', 'tomate', 'paprika', 'plat', 'recette', 'cuisine', 'poivron rouge', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'raisins secs', 'poivre', 'curry', 'cocktail', 'safran'], 'Plat principal', 8fec47c0-3723-4f03-865b-b09918574002, '2025-09-26T17:09:12.633460', [{'ingredient_id': '4dd89737-3399-4670-909f-d78e095d0960', 'quantite': '800 g'}, {'ingredient_id': '13040a2d-9a34-493d-935a-054bda61ad7b', 'quantite': '1'}, {'ingredient_id': '050c8d72-4b45-451a-a0e2-cac87738acec', 'quantite': '1'}, {'ingredient_id': '1bbb47a0-807a-4921-9213-6822bcfba152', 'quantite': '1'}, {'ingredient_id': 'aff5d0f6-5ce7-4cc3-9b05-695dcd40f979', 'quantite': '4'}, {'ingredient_id': '6eb17305-c3d2-44e7-bdee-91ff9f11d9af', 'quantite': '1'}, {'ingredient_id': 'c37a010d-b67f-4525-b408-a92cc709d265', 'quantite': '1'}, {'ingredient_id': 'b6cf31dd-56ea-4957-a42c-954c1befc404', 'quantite': ''}, {'ingredient_id': '44515601-5eac-4695-b41d-d3dcf4ff4a5b', 'quantite': ''}, {'ingredient_id': '04435bc1-8ffd-40b1-9c71-37f644ec2fab', 'quantite': ''}, {'ingredient_id': '4aca4325-e16e-4d15-8bc4-b3d75148a61b', 'quantite': ''}, {'ingredient_id': 'c628207a-2ba6-490f-a596-1f323104c741', 'quantite': ''}, {'ingredient_id': '59ed8585-68da-433e-8843-61c72a2c67cd', 'quantite': ''}, {'ingredient_id': 'baf5f119-8004-4a95-8a1c-168d6794fa58', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18149, 'bananes grillees  au barbecue', 'banane, sucre vanillé, rhum, glace vanille', '5 min', ['coupez les bananes dans le sens de la longueur avec la peau.', 'ajoutez le sucre vanille (1 demi sachet par demi fruit).', 'placez delicatement sur la grille du barbecue.', 'cuire 3 a 5 mn .', 'faire flamber; ajoutez 1 boule de glace et servir aussitot'], ['Poêle', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'bananes grillees  au barbecue', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'sucre vanillé', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:09:16.177558', [{'ingredient_id': '5f5911b1-3bdb-4fa1-8421-7e8aedc88a2b', 'quantite': '2'}, {'ingredient_id': 'a251ab46-a0b5-4d97-81bc-d6ed89add031', 'quantite': '2'}, {'ingredient_id': '87b48681-2705-428b-9408-efe1a5a7d5c4', 'quantite': '4 cuillères'}, {'ingredient_id': '054eb70e-743a-4f70-8285-68e8cf3dc76f', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (172341, 'Délicieuse salade de fruits exotiques au lait frais', 'mangue, papaye, banane, fraises, kiwi, mandarine, melon, litchi, lait entier, noix de coco rapée', '10 min', ['Pelez et épépinez les fruits.', 'Coupez les bananes en rondelles. Coupez les fraises en rondelle dans la longueur. Coupez les litchis en 8. ', 'Coupez les autres fruits en carré de même grosseur.   ', 'Séparez les quartiers de mandarine. ', 'Mélangez le tout dans un saladier, ajoutez la quantité de lait souhaitée (les fruits ne doivent pas ''baigner'' dans le lait, juste assez pour les recouvrir).', 'Saupoudrez de noix de coco râpée !'], ['Moule à tarte', 'Mixeur', 'Couteau de chef', 'Spatule'], ['melon', 'entrée', 'banane', 'papaye', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'Délicieuse salade de fruits exotiques au lait frais', 'très facile', 'mandarine', 'lait entier', 'rapide', 'plat', 'mangue', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'moyen', 'salade de fruits exotiques', 'litchi', 'cocktail'], 'Dessert', fa99f7ea-effb-417d-96a1-fa4a79ae4bac, '2025-09-26T17:09:19.731944', [{'ingredient_id': '50e423ff-e98a-4923-9229-cc7880d5335c', 'quantite': '2'}, {'ingredient_id': '7538c5f2-cce0-4dc6-8e26-93542292ed87', 'quantite': '1'}, {'ingredient_id': '43a16454-d831-46cb-87a7-f9dc0fdce6d3', 'quantite': '3'}, {'ingredient_id': 'bf4741d3-a4d5-4554-b9a7-efd021c024db', 'quantite': '12'}, {'ingredient_id': '32b78650-12fa-4ef4-911b-6974c88aebb5', 'quantite': '1'}, {'ingredient_id': '683e3a3f-a4f6-4423-baae-52be0d4cf0ab', 'quantite': '1'}, {'ingredient_id': 'baab33e9-8974-4df0-9c1c-2b54228d6fb0', 'quantite': ''}, {'ingredient_id': '029190ab-c255-4c4d-bcf9-f5b8bafb8009', 'quantite': '5'}, {'ingredient_id': '9e5ae755-e08a-4e2a-964f-df3db9289890', 'quantite': '1 l'}, {'ingredient_id': '93ae5ce9-f9ff-4d38-b3c8-21afd2695b0c', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228485, 'Fondant chocolat banane de Mia', 'chocolat pâtissier, sucre en poudre, beurre, oeuf, farine, banane, levure', '30 min', ['Dans un saladier, ramollir le beurre et le chocolat (au micro-onde en remuant de temps en temps).', 'Ajouter ensuite le sucre, les œufs, la farine, les bananes mixées et enfin la levure.', 'Chemiser le moule (beurrer, saupoudrer de farine et retourner le plat en tapant le fonds pour enlever l’excédent de farine).', 'Verser la pâte et enfourner pendant 40 minutes environs à 200°C (thermostat 6-7).'], ['Ouvre-boîte', 'Moule à tarte', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'Fondant chocolat banane de Mia', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'chocolat pâtissier', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'fondant au chocolat', 'plat de résistance', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:09:23.444735', [{'ingredient_id': '36524380-2d0e-4068-8c33-7f804a10535a', 'quantite': '200 g'}, {'ingredient_id': '4015ddf8-c378-4d37-9f5b-bbed60db988e', 'quantite': '200 g'}, {'ingredient_id': '113adfc9-cb44-42b4-82f6-e8b14cf2e82a', 'quantite': '200 g'}, {'ingredient_id': '91fc655a-dcb2-4640-b8e9-3b6fae73924b', 'quantite': '4'}, {'ingredient_id': '0d75011e-b8b6-430a-8df2-f4a19ca3e174', 'quantite': '150 g'}, {'ingredient_id': '5ef096a3-9429-454b-ba32-11e650c8e1b1', 'quantite': '2'}, {'ingredient_id': 'c51e0be5-8901-471d-a1db-d11a5c092d52', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42262, 'Crème de yaourt ensoleillée', 'Gervita, vanille, citron, miel, raisins secs, pamplemousse, poire, pomme, banane, raisin', '5 min', ['Mettre dans un bol, mélanger, et bon appétit!!!'], ['Mixeur', 'Verre doseur', 'Planche à découper', 'Pince de cuisine'], ['', 'raisin', 'entrée', 'Gervita', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'vanille', 'Crème de yaourt ensoleillée', 'dessert', 'plat de résistance', 'pamplemousse', 'pomme', 'citron', 'raisins secs', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:09:28.093398', [{'ingredient_id': '65895502-1c1b-4bf5-919d-fa1295d69ac3', 'quantite': '1'}, {'ingredient_id': '48dae209-21e8-40b5-a89b-01c8afe90dfc', 'quantite': '4'}, {'ingredient_id': '72a1a9dc-12b0-4ba8-851f-beec2787c152', 'quantite': '4'}, {'ingredient_id': '2a16691f-d5b5-4bea-9bbc-8fdb104e6407', 'quantite': '3 cuillères'}, {'ingredient_id': 'e6655ca2-2bc1-4d06-a642-c3aa854cb0aa', 'quantite': '5'}, {'ingredient_id': 'd9e7ea04-57ce-4ea3-8580-8a626750f45e', 'quantite': '3'}, {'ingredient_id': '26df31b5-9886-4b79-ab00-63d093efac3c', 'quantite': '3'}, {'ingredient_id': 'c7f3e7c1-992a-434f-8e5a-a6efb59df817', 'quantite': '3'}, {'ingredient_id': '695c0528-318b-4e99-8c88-650c1237eabe', 'quantite': '4'}, {'ingredient_id': '6af4624c-bc68-426c-a182-e28dabe1ec2c', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52149, 'Gâteau marbré choco-banane', 'farine, oeuf, sucre, beurre, lait, chocolat noir, banane, sucre vanillé, levure', '20 min', ['Mélanger la farine, le sucre et la levure.', 'Puis incorporer les oeufs un à un, le lait et le beurre fondu.', 'Répartir la préparation dans deux plats.', 'Dans la première moitié, rajouter la banane écrasée et le sucre vanillé.', 'Dans la seconde moitié, rajouter le chocolat que vous aurez fait fondre au micro-ondes avec un peu de lait.', 'Beurrer un moule à cake, puis verser moitié de la pâte au chocolat, moitié de la pâte à la banane.', 'Et recommencer.', 'Faire cuire au four préchauffé à 180°C (thermostat 6) pendant 40 minutes.'], ['Presse-agrumes', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'Gâteau marbré choco-banane', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre vanillé', 'gâteau à la banane', 'beurre', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:09:31.691955', [{'ingredient_id': 'e6de13ed-a349-41bb-8a9d-15aaefd80ab1', 'quantite': '180 g'}, {'ingredient_id': 'c1d6f927-9d51-4012-b67e-19b2a43c2a14', 'quantite': '3'}, {'ingredient_id': '694151d5-d611-4416-bca1-2fe6e39da393', 'quantite': '150 g'}, {'ingredient_id': '38ee366d-ae1a-423a-aff8-6ee76be0212b', 'quantite': '150 g'}, {'ingredient_id': '36ff9400-f87d-4667-bd3d-dfc7286fa2a7', 'quantite': '10 cl'}, {'ingredient_id': '9201e939-238a-4583-84fc-1aaf2930dd35', 'quantite': '100 g'}, {'ingredient_id': '90486a09-8b44-4333-a2af-682333663c39', 'quantite': '1'}, {'ingredient_id': '608b1647-9d33-40ac-943a-a4b026199536', 'quantite': '1'}, {'ingredient_id': '5c6e634c-17f6-408a-bb75-7bbcf122acaf', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (49630, 'Muffin bananes et pépites de chocolat', 'farine, sucre, beurre, amandes, levure, banane, chocolat, oeuf, extrait de vanille', '10 min', ['Préchauffez votre four à 180°C (thermostat 6).', 'Mélangez dans un saladier la farine, les amandes en poudre, les pépites de chocolat et la levure.', 'Battez 2œufs entiers avec le sucre dans un autre récipient.', 'Chauffez le beurre quelques minutes au micro-ondes.', 'Écrasez les bananes à la fourchette, puis incorporez la vanille, le beurre, et les bananes au mélange œufs + sucre tout en remuant.', 'Vous obtenez une pâte semi liquide que vous versez dans le premier saladier.', 'Mélangez juste assez pour obtenir une pâte homogène.', 'Beurrez vos moules à muffin et versez la pâte aux 3/4.', 'Enfournez 25 min à four chaud.'], ['Poêle', 'Planche à découper'], ['amandes', 'entrée', 'banane', 'Muffin bananes et pépites de chocolat', 'recettes de cuisine', 'confiserie', 'testées', 'extrait de vanille', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'muffin', 'beurre', 'sucre', 'cocktail'], 'Dessert', c1150c47-e860-4d00-9020-e9a56becb6c9, '2025-09-26T17:09:38.556749', [{'ingredient_id': '5ca9e8f3-6f19-4e72-b8b8-8f6d940fbf96', 'quantite': '250 g'}, {'ingredient_id': '9fb0d615-d5a0-4f69-aca8-f150240742cc', 'quantite': '150 g'}, {'ingredient_id': 'b86e5822-4f4c-4ab0-a6ba-439032c6cafb', 'quantite': '100 g'}, {'ingredient_id': 'c1777753-414d-49f1-ad8c-af5dc38a620f', 'quantite': '15 g'}, {'ingredient_id': 'fd01e460-213f-4e5b-995a-aea21de238a8', 'quantite': '1'}, {'ingredient_id': 'c5c44e5c-0e38-4bbb-8423-7492768f472e', 'quantite': '2'}, {'ingredient_id': 'f9b93eec-0063-4337-a5f4-2a4f37d8e49a', 'quantite': '100 g'}, {'ingredient_id': '8221efbc-8f8b-4b11-9c51-c20977aa6c54', 'quantite': '2'}, {'ingredient_id': 'ed78cefa-3b15-4af9-b9a3-e8a7bd92de93', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55809, 'Clafoutis Kiwis Bananes', 'kiwi, banane, farine, sucre, oeuf, lait, beurre, Liqueur', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Beurrer et fariner un moule.', 'Peler les kiwis et les couper en morceaux/rondelles.', 'Eplucher et couper les bananes en rondelles.', 'Déposer les fruits au fond du moule.', 'Melanger dans un saladier les oeufs entiers battus et le sucre, puis la farine et le beurre fondu, puis le lait et la liqueur.', 'Verser ce mélange sur les fruits puis enfourner environ 35 minutes (à surveiller).', 'Le clafoutis est cuit quand il est doré et plus liquide (il doit cependant rester souple).', 'On peut éventuellement rajouter quelques raisins secs, de la vanille, ou remplacer la liqueur de mangue par une autre liqueur (kiwi, litchi, pêche...).', 'Bon appétit!'], ['Économe', 'Passoire', 'Couteau de chef', 'Planche à découper'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Clafoutis Kiwis Bananes', 'farine', 'dessert', 'plat de résistance', 'clafoutis', 'beurre', 'Liqueur', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:09:43.329822', [{'ingredient_id': 'e7af2f75-e2f7-4e88-bcc2-1be741d49317', 'quantite': '3'}, {'ingredient_id': '874979fa-b27e-4842-8d3c-44cf025573ed', 'quantite': '2'}, {'ingredient_id': '5548cf77-0192-4bf1-897c-934b7dcd2dd1', 'quantite': '80 g'}, {'ingredient_id': 'fda87899-9cda-4736-84fd-a0e85fd0db50', 'quantite': '100 g'}, {'ingredient_id': '77b27f50-723f-4106-9c6d-d68089b8694e', 'quantite': '3'}, {'ingredient_id': 'febdb986-90ce-4f30-b285-33edcea052f9', 'quantite': '30 cl'}, {'ingredient_id': '0d13c326-69a0-4899-b342-1618b816d442', 'quantite': '40 g'}, {'ingredient_id': '2649a578-425f-4680-9a34-d75b74b5ad2a', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57194, 'Baby-cake banana', 'farine fermentante, chocolat noir, sel, sucre, oeuf, sucre vanillé, beurre tendre, banane, sirop d''érable', '10 min', ['Dans un saladier, préparer la préparation sèche en mélangeant les ingrédients de façon bien homogène.', 'Dans un autre saladier, battre, au fouet, les oeufs avec le sucre jusqu''à ce que le mélange blanchisse.', 'Ajouter le sucre vanillé, le beurre et le sirop d''érable.', 'Bien mélanger.', 'Ecraser les bananes à la fourchette et les incorporer au mélange.', 'Verser le mélange liquide dans le saladier contenant le mélange sec, mélanger délicatement et surtout très peu (c''est pas grave s''il reste des grumeaux... Ne pas les défaire).', 'Beurrer légèrement un moule à mini-cakes et remplir les alvéoles avec la préparation au 2/3 (ça va gonfler dans le four).', 'Déposer le moule dans un four préchauffé à 180°C (thermostat 6) et laisser cuire sans ouvrir la porte pendant 30 à 45 minutes (suivant les fours...).', 'Pour vérifier si c''est cuit, enfoncer la lame d''un couteau au milieu de la pâte et vérifier qu''elle soit sèche quand on la retire (les cakes doivent être bien dorés).'], ['Pince de cuisine', 'Râpe', 'Batteur électrique'], ['', 'entrée', 'recettes de cuisine', 'Baby-cake banana', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'farine fermentante', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:09:46.948962', [{'ingredient_id': '2b057493-ff11-4283-907d-17df60868b7d', 'quantite': '250 g'}, {'ingredient_id': 'a211d682-b09c-4c0d-9a04-28de0850772c', 'quantite': '100 g'}, {'ingredient_id': 'ff8caff7-f186-4a99-814f-6d5cefd37892', 'quantite': '1'}, {'ingredient_id': '002cb4cc-dd91-4767-8a0b-7e7df4126a54', 'quantite': '200 g'}, {'ingredient_id': 'f3a74d83-faa2-4d35-b4a6-b1f3fe12bd5d', 'quantite': '2'}, {'ingredient_id': 'ab248b43-50eb-492c-b16f-a57c77bea552', 'quantite': '1'}, {'ingredient_id': '89e9002b-79d1-47c0-803b-b1f527f352d8', 'quantite': '100 g'}, {'ingredient_id': 'b20f4ed4-54dc-480f-ad4b-15219ff897a5', 'quantite': '2'}, {'ingredient_id': '0d275be4-02ad-44c2-8b62-ac63f134f4d3', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (318895, 'Smoothie pomme banane coco vanille', 'pomme, banane, lait de coco, extrait de vanille, sucre vanillé, glaçons', '5 min', ['Pelez les pommes et enlevez les pépins.', 'Pelez les bananes.', 'Mixez l''ensemble des ingrédients (avec glaçons et sucre vanillé si nécessaire)', 'Dégustez !'], ['Ouvre-boîte', 'Rouleau à pâtisserie'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'extrait de vanille', 'Smoothie pomme banane coco vanille', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'glaçons', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:09:50.650460', [{'ingredient_id': 'fd91f7a8-30c2-4a6f-a2eb-206fc4c2078d', 'quantite': '2'}, {'ingredient_id': '35577c57-b491-44c9-81af-85fff47625ba', 'quantite': '2'}, {'ingredient_id': '8bf3c26e-4dc7-4e1f-9007-46e88ace4fe9', 'quantite': '20 cl'}, {'ingredient_id': 'ccf51b89-fe70-475c-9015-084832cbf665', 'quantite': '1 cuillères'}, {'ingredient_id': '5917e715-ea75-4817-96c7-a7217b8a3a5e', 'quantite': ''}, {'ingredient_id': 'dd2a5ba0-9b4e-4614-bcd3-648fe591cfee', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (343181, 'Génoise roulée à la banane et aux ferrero rochers', 'farine, sucre, oeuf, sucre vanillé, levure, banane', '30 min', ['Mettez à préchauffer le four à 180°C (thermostat 6).', 'Séparez le blanc des jaunes d''oeufs dans deux saladier. Montez les blancs en neige. Mélangez les jaunes avec le sucre. ', 'Ajoutez à cette préparation tour à tour le mélange farine-levure tamisé et les blancs en neige. ', 'Etalez la pâte sur la plaque sur du papier cuisson et mettez au four pendant 10 à 15 minutes.', 'Ecrasez les rochers à l''aide d''un pilon. Coupez la banane en deux.', 'Avant de sortir la génoise du four, humidifiez un torchon propre et étalez-le sur votre plan de travail. Une fois la génoise cuite, sortez-là et mettez directement sur le torchon et enroulez-la dedans. Une fois qu''elle a pris la forme, déroulez-la et garnissez-la de banane et de rochers ! Re-roulez-la par la suite et laissez reposer. Bonne dégustation.'], ['Mixeur', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'Génoise roulée à la banane et aux ferrero rochers', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'sucre', 'rochers', 'cocktail'], 'Dessert', 5ddf15e0-c78f-4df8-b2dc-2f3881bfa73e, '2025-09-26T17:09:55.889325', [{'ingredient_id': 'e79e45b7-f5d8-4aec-8eae-fb1d25fd0823', 'quantite': '120 g'}, {'ingredient_id': 'e08eba13-16a1-4295-b7aa-c92d6993ad96', 'quantite': '120 g'}, {'ingredient_id': 'ab41c95f-11d8-4923-a54e-97bf777bb879', 'quantite': '6'}, {'ingredient_id': 'b59960fc-4af3-4da8-a413-4bf4007ac9e5', 'quantite': '1'}, {'ingredient_id': '8202c88d-ddb6-4cf6-b304-1fbd20de5efd', 'quantite': '1'}, {'ingredient_id': 'bb55d93f-1276-4a4c-9fe0-3ce40c8c3efb', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166821, 'Cookies new yorkais', 'farine, flocons d''avoine, sucre roux, sucre semoule, beurre, cardamome, oeuf, banane, poudre de noisette, chocolat', '15 min', ['Dans un bol mettre la farine, les sucres, l''avoine et la cardamome ajoutez le beurre juste mou bien mélangez le tout (la consistance sera sableuse) ajoutez les œufs, malaxez puis agrémentez de la banane écrasée, des noisettes et des pépites de chocolat. Préchauffer votre four. ', 'A l''aide de 2 cuillères à soupe faites des petits tas sur une plaque graissée ou une plaque couverte de papier sulfurisé. Mettre au four à 180°c pendant 20 à 22 min selon le four.', 'Dégustez tiède avec une boisson chaude c''est un délice'], ['Planche à découper', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'Cookies new yorkais', 'facile', 'bon marché', 'cookie', 'cardamome', 'oeuf', 'plat', 'poudre de noisette', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'flocons d''avoine', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:09:59.550239', [{'ingredient_id': '0bde7f90-cb14-4978-a0ea-aab394b8f0c8', 'quantite': ''}, {'ingredient_id': '1184cf32-4ec3-4f06-8196-2587ced28fd9', 'quantite': ''}, {'ingredient_id': '19038d65-32ea-4252-a415-038faed61cae', 'quantite': ''}, {'ingredient_id': 'c04b9894-d84f-4017-9a2a-3771c924adfc', 'quantite': ''}, {'ingredient_id': '51b46087-8b91-4483-b28a-e418895ef1d6', 'quantite': ''}, {'ingredient_id': '78b0e133-714a-4638-ab1a-afeeb8175d6b', 'quantite': ''}, {'ingredient_id': '34ab7668-32c2-4eff-8f2c-0ba1af45d20f', 'quantite': ''}, {'ingredient_id': 'a818072c-3955-4d56-845c-05874951b809', 'quantite': ''}, {'ingredient_id': '7e939116-5fa8-4be7-b986-62a7db6e6ef4', 'quantite': ''}, {'ingredient_id': '8c7fc074-dfa3-4ac4-945d-3f833a717832', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (95194, 'Extra moelleux à la banane (sans matières grasse)', 'banane, oeuf, yaourt nature, farine, sucre, sel', '10 min', ['Préchauffer le four à 180°.', 'Mélanger dans un saladier le yaourt et les 3 oeufs.', 'Laver et sécher le pot (on le prend pour mesure), et ajouter 2 pots de farine avec levure incorporée, ou à défaut 2 pots de farine normale et 8Gr de levure chimique.', 'Mélanger le tout avec le sucre (il y en a peu mais c''est largement suffisant si vos bananes sont bien mûres car elles sont très sucrées).', 'Ecraser ensuite les 2 bananes à la fourchette et les incorporer à la préparation.', 'Mettre la pâte dans un moule à cake en silicone,', 'Enfourner à 180° pendant 45min, vérifier de temps à autre la cuisson à l''aide de la pointe d''un couteau.', 'Servir une fois le gâteau refroidi, accompagné de coulis de chocolat, qui se marie parfaitement avec la banane!'], ['Économe', 'Verre doseur', 'Pince de cuisine', 'Mixeur', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Extra moelleux à la banane (sans matières grasse)', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:10:04.075805', [{'ingredient_id': '1936f348-01d7-4a68-bad8-2a14a087a4cc', 'quantite': '2'}, {'ingredient_id': 'ac7c9623-8d77-4284-820c-0dffdec2352a', 'quantite': '3'}, {'ingredient_id': 'a784121f-d5b6-4482-9ba2-4c728f9adbf6', 'quantite': '1'}, {'ingredient_id': 'dc83c966-026a-4fe4-aaae-27a9dced2028', 'quantite': '2'}, {'ingredient_id': 'b663780e-630e-4151-9f11-12ff8505d267', 'quantite': ''}, {'ingredient_id': '8fb8fab6-7474-46a1-9fd3-0e54e7fb7ff8', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13994, 'Lait à la banane', 'banane, sucre semoule, lait, cannelle, glaçons', '10 min', ['Dans le bol du mixer, mettez les bananes pelées et coupées en morceaux et 1/2 verre de lait. ', 'Mixez par impulsions. Versez le lait, la cannelle et les glaçons.', 'Servez dans des verres réfrigérés.'], ['Balance de cuisine', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'Lait à la banane', 'cannelle', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:10:07.691932', [{'ingredient_id': 'd65ac828-061a-4cad-b042-310636475f9a', 'quantite': '2'}, {'ingredient_id': '0af8163a-6a46-4bee-baf1-2c72d0c51a6f', 'quantite': '3 cuillères'}, {'ingredient_id': 'fa4e85aa-6e41-48cd-b063-59a7d585b71a', 'quantite': '50 cl'}, {'ingredient_id': 'e7d35e72-aed6-4548-8135-25ed6eac6b34', 'quantite': '1'}, {'ingredient_id': 'f6626255-08ce-4b4f-bc88-b7e834498ef1', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (71266, 'Trifle (gâteau anglais)', 'biscuits à la cuillère, fraises, banane, pêche, poire, gelée anglaise à la fraise', '25 min', ['1) Disposez au fond d''un moule à cake vos boudoirs afin d''en tapisser le fond.', 'Puis mettez une couche de fruits frais que vous aurez au préalable épluchés et coupés en petits dés.', 'Remettez de nouveau une couche de boudoirs et ainsi de suite, jusqu''en haut de votre plat. Vous devez terminer par une couche de boudoirs.', '2) Faites fondre votre gelée comme indiqué sur le paquet et répandez-la sur le gâteau. ', '3) Laissez au frais pendant 2 heures minimum.', '4) Au moment de servir, démoulez votre gâteau dans un joli plat! Effet garanti!'], ['Casserole', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Trifle (gâteau anglais)', 'confiserie', 'testées', 'biscuits à la cuillère', 'poire', 'très facile', 'bon marché', 'rapide', 'gelée anglaise à la fraise', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pêche', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:10:12.237409', [{'ingredient_id': '5de19e0b-239f-4bae-8205-910058cb0a70', 'quantite': ''}, {'ingredient_id': '9518db1e-ce93-4dd2-8f13-b07b5fd1b8ea', 'quantite': ''}, {'ingredient_id': '0509ca8b-4436-4b65-b025-9f5ef8757cdc', 'quantite': ''}, {'ingredient_id': 'cc7ea444-58da-4db8-ad6b-32ca31b068c6', 'quantite': ''}, {'ingredient_id': 'b7e852f3-b268-433e-9e7c-42a210ebbe71', 'quantite': ''}, {'ingredient_id': '5dd0a31c-7d3d-4b95-831e-62cf2026ab78', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23575, 'Gâteau aux arômes', 'oeuf, yaourt, yaourt, yaourt, yaourt, levure, sucre vanillé, banane, citron, rhum vieux, chocolat pâtissier, vanille, citron, cannelle', '30 min', ['Dans un grand saladier, mettre les yaourts. Ajouter et mélanger l''huile, le sucre, la farine, la levure et le sucre. Battre le tout puis incorporer les jaunes d''oeufs. Faire monter les blans en neige et en même temps fondre le chocolat au bain-marie. Mélanger le tout avec les arômes et le rhum. ', 'Faire cuire au four Th 7 , puis décorer avec la banane et le caramel et remettre 5 mn.'], ['Louche', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'rhum vieux', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'levure', 'recettes', 'boisson', 'dessert', 'Gâteau aux arômes', 'plat de résistance', 'sucre vanillé', 'citron', 'cocktail'], 'Dessert', 8a48b339-152d-4800-b072-f85f49741a4c, '2025-09-26T17:10:16.017031', [{'ingredient_id': '49ea686a-d82b-41ef-a155-1898b7721b8b', 'quantite': '2'}, {'ingredient_id': '6d04c400-fc43-4012-87e1-b8a98d696f1b', 'quantite': '4'}, {'ingredient_id': '8e073297-94ec-4951-aa6d-f932824723ce', 'quantite': '3'}, {'ingredient_id': '577dc6fb-eaa2-4118-bd0e-ea530bfff2b9', 'quantite': '4'}, {'ingredient_id': '3321eb86-f874-48d5-a690-a38fa59a8847', 'quantite': '4'}, {'ingredient_id': '1a195d43-7ad6-4fa1-aaaf-3c52dcad0311', 'quantite': '2'}, {'ingredient_id': '228a852e-a020-4a62-a486-2377c2539852', 'quantite': '1'}, {'ingredient_id': '18fd868e-b1e9-4104-a8d4-3773d1b2c391', 'quantite': '1'}, {'ingredient_id': 'ceb508fd-5858-4965-af3e-d55d71defc20', 'quantite': ''}, {'ingredient_id': 'ca8e627c-664a-4f94-a700-574499dc0e07', 'quantite': ''}, {'ingredient_id': '0c7c5c8b-c7d9-4345-8f4a-80f63eecd06e', 'quantite': '1'}, {'ingredient_id': 'e7d6cf37-01d4-4d8a-9e7d-4ca4a3076f1c', 'quantite': ''}, {'ingredient_id': 'a72f9d3f-7f68-4d65-9353-e91776fa67c2', 'quantite': ''}, {'ingredient_id': 'bc905da4-59ae-464d-ab0d-a347e8194aa0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (218492, 'Crumble pêche, banane, caramel et chocolat blanc', 'beurre, farine, sucre, banane, pêche, caramel, chocolat blanc', '20 min', ['Préchauffer le four à 200°C (thermostat 6).', 'Préparation de la pâte du crumble :', 'Mettre le beurre, la farine et le sucre dans un saladier et mélanger le tout avec les doigts jusqu''à obtention d''une pâte grumeleuse. Garder la pâte de côté.', 'Éplucher les pêches et les bananes, les couper en morceaux et les disposer au fond d''un plat. ', 'Ajouter par dessus le chocolat blanc en morceaux ainsi que le caramel (plus ou moins 6 cuillères à café), pour finir déposez la pâte du crumble.', 'Enfourner 15 min à 200°C.', 'Bon appétit !'], ['Pince de cuisine', 'Fouet', 'Batteur électrique', 'Planche à découper'], ['caramel et chocolat blanc', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Crumble pêche', 'facile', 'caramel', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'chocolat blanc', 'pêche', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:10:20.704351', [{'ingredient_id': '8bf069c3-4482-4312-899f-71c6f4ad53b4', 'quantite': '80 g'}, {'ingredient_id': '7a8c8c1f-4fd5-4cd6-92aa-aeb1e2ef2d13', 'quantite': '150 g'}, {'ingredient_id': 'f1e689f1-2d15-4412-8cfd-cf81187e59be', 'quantite': '100 g'}, {'ingredient_id': '8c261468-65a2-451e-983a-fabcee6f3145', 'quantite': '2'}, {'ingredient_id': 'be9855be-6deb-450f-be2f-1602f3ce920f', 'quantite': '3'}, {'ingredient_id': '08a234a7-f7e0-41da-a67d-0adf15dcdadb', 'quantite': ''}, {'ingredient_id': 'f6192e2f-5417-4ae7-814c-e8a6debcf319', 'quantite': '60 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57895, 'Tarte ganache pomme milieu banane', 'pâte brisée, chocolat pâtissier, crème fraîche, sucre, pomme, banane, sucre vanillé', '10 min', ['Préparer vous même ou plus simple acheter à votre goût soit une tarte brisée ou sablée. ', 'Faire fondre 80 g de chocolat pâtissier soit au bain marie, soit au micro onde.', 'Faire préchauffer le four, à 180°C (thermostat 6) puis mettre votre fond de tarte jusqu''à ce qu''il soit doré mais qu''il ne gonfle pas trop puis laisser refroidir.', 'Pendant ce temps, mettre une cuillère à soupe de crème fraîche dans le chocolat fondu puis une cuillére à soupe de sucre.', 'Puis mettre dans votre fond de tarte au préalable cuit et légerement doré.', 'Pelez quelques pommes environ 4 ou 5, puis les découper en lamelles et les disposer à votre convenance selon votre créativité.', 'Ainsi qu''une demi banane, pareillement vous pouvez décorez selon vous.', 'puis mettre quelques minutes au four la tarte, le temps que les pommes cuisent légérement.', 'Une fois cela fait, sortez votre tarte du four et parsemez d''un sachet de sucre vanillé ou de cassonade brune pour rajouter un petit peu de goût.', 'Pour les gourmand(e)s et pour les créatifs, vous pouvez décorer avec une boule de glace (selon votre parfum), rajouter une crème anglaise...', 'Bon appétit !'], ['Casserole', 'Spatule', 'Ouvre-boîte'], ['ganache', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'Tarte ganache pomme milieu banane', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'sucre', 'cocktail'], 'Dessert', f0f418d9-0eeb-43e8-b887-34045ae9df2e, '2025-09-26T17:10:25.430197', [{'ingredient_id': '4838ef9b-c5d5-4b02-9379-bc5309ab933c', 'quantite': ''}, {'ingredient_id': 'a9233a46-576e-4fac-b3ce-ccbbd362f1f1', 'quantite': ''}, {'ingredient_id': 'd63a8933-3a23-47d5-aa17-6c2c6c143039', 'quantite': '1 cuillères'}, {'ingredient_id': 'c7006f3d-09ed-4b2b-a652-22bc4ca9bf02', 'quantite': '1 cuillères'}, {'ingredient_id': '6f7a1bd6-d3b6-4b30-8b66-5f2a1f8585d8', 'quantite': ''}, {'ingredient_id': 'fa4c6c74-7023-4c38-a58e-62f78eff3120', 'quantite': ''}, {'ingredient_id': 'f28bb916-9c70-4dda-b1f4-e15dd126c861', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37527, 'Papillotes de saumon aux épinards et à la banane', 'saumon, épinards, banane, crème fraîche, poivre, sel', '10 min', ['Préchauffer votre four à 200°C (Thermostat 6-7).', 'Etaler devant vous une feuille de papier aluminium.', 'Décongeler le pavé de saumon.', 'Egoutter soigneusement les épinards.', 'Empiler sur la feuille de papier aluminium :', '- les épinards', '- le pavé de saumon', '- saler et poivrer', '- la 1/2 banane', '- la crème fraîche', 'Refermer soigneusement la papillote et la disposer sur la lèche-frite dans laquelle vous aurez pris soin de verser un peu d''eau.', 'Faire cuire 30 min environ.', 'Servir dès la sortie du four et se régaler bien sûr !'], ['Presse-agrumes', 'Couteau de chef', 'Passoire', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'saumon', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'épinards', 'recette', 'poisson en papillote', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'poivre', 'cocktail', 'Papillotes de saumon aux épinards et à la banane'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:10:29.089829', [{'ingredient_id': '737b484a-a974-408a-a7db-1b98308f406c', 'quantite': '1'}, {'ingredient_id': '6353f4c3-6574-4d08-bbe8-c3a2ca6f27c6', 'quantite': '200 g'}, {'ingredient_id': '0ae6d2ee-b124-4e9c-b138-14111cddad64', 'quantite': ''}, {'ingredient_id': '9a0f1257-4b86-4488-9bf8-272ff22dc07f', 'quantite': '1 cuillères'}, {'ingredient_id': 'becaff20-c211-4073-9ff6-f378bdccfad5', 'quantite': ''}, {'ingredient_id': '1b536a8c-91a7-4415-adf6-e3cbf10022fe', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (225117, 'Gratin vitaminé fruité', 'pomme, poire, banane, étoile de badiane, chocolat au caramel, citron vert, crème fraîche allégée, vanille, noix de coco, amandes en poudre, beurre', '20 min', ['Coupez les bananes en deux dans le sens de la longueur.', 'Arrosez-les de jus de citron vert.', 'Mettez à dorer dans une poêle préalablement beurrée. Mettez la badiane (anis étoilé).', 'Vous pouvez ajouter du jus de citron et un peu d''eau pour plus de jus.', 'Coupez la pomme en petits cubes. Arrosez-les de jus de citron.', 'Retirez les tranches de bananes et disposez dans un plat individuel (style pour les crèmes brûlées) et mettez les pommes à cuire dans le jus des bananes.', 'Coupez les poires en tranches fines. Arrosez-les de jus de citron. Saupoudrez de la poudre d''amande sur les tranches.', 'Mettez une à deux tranches de poires dans le plat, puis une tranche de banane, puis quelques cubes de pommes cuites et dorées.', 'Parsemez de poudre de vanille.', 'Mettez sur le dessus un peu de crème fraîche allégée.', 'Saupoudrez de noix de coco en poudre.', 'Mettez au four à 180°C (thermostat 6) environ 20 minutes.', 'A la sortir du four, mettez les copeaux de chocolat sur le dessus.', 'Dégustez tiède accompagné facultativement d''un biscuit au chocolat.'], ['Batteur électrique', 'Verre doseur', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'facile', 'bon marché', 'amandes en poudre', 'plat', 'recette', 'étoile de badiane', 'chocolat au caramel', 'cuisine', 'recettes', 'boisson', 'Gratin vitaminé fruité', 'vanille', 'dessert', 'crème fraîche allégée', 'plat de résistance', 'pomme', 'beurre', 'citron vert', 'noix de coco', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:10:33.765722', [{'ingredient_id': '8b8e7765-a0d6-4ded-a064-139182a3063c', 'quantite': '2'}, {'ingredient_id': '01e0616b-38da-4600-8fdf-38269d657d90', 'quantite': '2'}, {'ingredient_id': '507a0b80-c4c8-4f85-a27f-8b99d1197618', 'quantite': '3'}, {'ingredient_id': '08a29618-e0d4-4e3b-840c-276f34f79a56', 'quantite': '3'}, {'ingredient_id': '54cec3d1-69b5-44f3-94b4-24d6b39c55e0', 'quantite': '20 g'}, {'ingredient_id': 'eb0eca97-2969-4ebe-b666-5a8440b1b536', 'quantite': '1'}, {'ingredient_id': 'fb44221a-20ca-4fed-a877-632db03153c9', 'quantite': '3 cuillères'}, {'ingredient_id': 'ff5bf304-a914-4d69-b2d4-d12c2155bed9', 'quantite': ''}, {'ingredient_id': '4b6e00fd-d697-45fa-8165-3e60e0c0aa80', 'quantite': '30 g'}, {'ingredient_id': 'c449fd4d-ceb6-48df-b335-f7ada79b7aa0', 'quantite': '30 g'}, {'ingredient_id': '597cb76f-16fe-40a9-8695-679a5523f96d', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21603, 'Crème de bananes à la hawaïenne', 'banane, citron, lait de coco, sucre, amidon, sucre vanillé, noix de coco rapée, crème chantilly', '20 min', ['1) Epluchez les bananes et coupez-les en rondelles. Arrosez-les d''un peu de jus de citron. ', '2) Déposez-les dans une casserole et recouvrez-les de lait de noix de coco. ', '3) Faites chauffer à feu doux jusqu''à ce que les rondelles de bananes soient ramollies. ', '4) Ajoutez alors le sucre, le sucre vanillé et écrasez les bananes jusqu''à l''obtention d''une crème presque lisse. ', '5) Délayez l''amidon de maïs dans un demi-verre d''eau. Ajoutez le mélange à la crème de bananes et remuez avec une cuillère en bois jusqu''à épaississement, sur feu doux. ', '6) Répartissez la crème de bananes dans des coupes individuelles. Laissez refroidir avant de mettre à rafraîchir dans le réfrigérateur. ', '7) Au moment de servir, saupoudrez de noix de coco râpée et décorez de quelques touches de crème Chantilly.'], ['Ouvre-boîte', 'Mixeur', 'Verre doseur'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'Crème de bananes à la hawaïenne', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'noix de coco rapée', 'amidon', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron', 'sucre', 'cocktail'], 'Dessert', 88686dda-f7dd-4a9d-bb6a-4401982b735d, '2025-09-26T17:10:37.418091', [{'ingredient_id': '32d4e781-0393-4fcc-bcc7-51960501fc05', 'quantite': '3'}, {'ingredient_id': 'dc11303d-eb1e-4962-bdab-0a7e53bbc358', 'quantite': '1'}, {'ingredient_id': 'e6c952cb-09a9-4530-a55f-fb070c59e379', 'quantite': '1'}, {'ingredient_id': '1e5113b6-8e85-4d41-88ee-0ea8eedb6d26', 'quantite': '3 cuillères'}, {'ingredient_id': 'c848b406-d21a-465c-ba8f-ff660120772c', 'quantite': '1 cuillères'}, {'ingredient_id': '6602be18-390f-48ce-aa9e-30db2d8a92f8', 'quantite': '7.5 g'}, {'ingredient_id': '6fc35dce-be9e-480a-85a0-a84302d42a09', 'quantite': '2 cuillères'}, {'ingredient_id': '5760d0fe-1670-4c31-ab49-87afb88d1413', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52729, 'Petit dessert gourmand banane-chocolat', 'banane, chocolat au lait, noix de coco, lait', '5 min', ['Coupez les bananes en rondelles dans une casserole.', 'Ajoutez le chocolat en petits morceaux ainsi que le lait.', 'Faites cuire à feu doux afin que les rondelles de bananes soient enrobées de chocolat.', 'Bien mélanger.', 'Une fois que le chocolat a fondu, retirez la casserole du feu et versez le mélange dans 6 petits raviers.', 'Laissez refroidir environ 30 minutes puis saupoudrez de poudre de noix de coco.', 'Mettez au frigo 3 à 4 heures, voir plus, pour que les bananes "trempent" bien dans le chocolat.'], ['Économe', 'Planche à découper', 'Presse-agrumes', 'Poêle', 'Mixeur'], ['', 'chocolat au lait', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Petit dessert gourmand banane-chocolat', 'dessert', 'plat de résistance', 'noix de coco', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:10:41.020850', [{'ingredient_id': '4f0b3229-1050-43ec-adeb-6bcb28ad7f01', 'quantite': '2'}, {'ingredient_id': 'b81ee0a5-42b3-4bd9-a1c3-c21b9d6cba7b', 'quantite': '2'}, {'ingredient_id': 'e3f4ec74-7694-4e7a-a45a-768fbc46e242', 'quantite': ''}, {'ingredient_id': '6c961666-fcb0-4353-8e10-1178ae233bc4', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228236, 'Crumble gourmand au pralin et sa compotée pommes-fraises-bananes', 'pomme, banane, fraises, sucre vanillé, beurre salé, cannelle, rhum, farine, pralin, amandes en poudre, cassonade, beurre salé, amandes effilées', '20 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Préparation de la compotée de fruits:', 'Eplucher et couper en beaux morceaux les pommes.', 'Les faire dorer dans une poêle avec une noisette de beurre. Saupoudrer d''un sachet de sucre vanillé et d''un peu de cannelle. Laisser caraméliser.', 'Ajouter ensuite les bananes coupées en rondelles (assez larges pour qu''elles se tiennent en cuisson).', 'Ajouter le deuxième sachet de sucre vanillé.', 'Le + : quand les pommes et les bananes ont caramélisées, les faire flamber avec du rhum.', 'Ajouter les fraises équeutées et coupées, mélanger délicatement, laisser cuire quelques minutes et suspendre la cuisson.', 'Pour la pâte :', 'Faire dorer à la poêle ou au four les amandes effilées.', 'Incorporer dans un saladier : la farine, le pralin, l''amandin, la cassonade et homogénéiser.', 'Ajouter ensuite le beurre ramolli et travailler aux doigts pour les puristes ou à la fourchette.', 'Ajouter à la pâte les 2/3 des amandes effilées grillées.', 'Dans un plat de cuisson : disposer au fond la compotée de fruits, ajouter la pâte à crumble et saupoudrer du restant d''amandes effilées.', 'Enfourner environ 40 min à 180°C (vous saurez que c''est cuit lorsque le jus des fruits crépitera et que le dessus du crumble aura doré).', 'Les + : servir tiède avec une boule de glace vanille saupoudrée de pralin.', 'PS : très bon le lendemain, tous les arômes des fruits ressortent.'], ['Moule à tarte', 'Mixeur', 'Balance de cuisine', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'beurre salé', 'crumble aux pommes', 'bon marché', 'plat', 'fraises', 'recette', 'Crumble gourmand au pralin et sa compotée pommes-fraises-bananes', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:10:44.700056', [{'ingredient_id': 'b94b798e-9b7f-4604-a6ef-323daccee1bc', 'quantite': '3'}, {'ingredient_id': '233ef65e-63f2-4179-8455-99d75f6b3330', 'quantite': '2'}, {'ingredient_id': '64ebb844-ad33-4650-9ec9-d5465da2f95d', 'quantite': '250 g'}, {'ingredient_id': 'fb403095-ebae-40fd-98af-b678f88422d2', 'quantite': '2'}, {'ingredient_id': '50be83ac-7cf7-44f0-b169-135b35492c0e', 'quantite': ''}, {'ingredient_id': '9305fc09-bee5-4507-b79c-986d52b1b969', 'quantite': ''}, {'ingredient_id': '4685dbf8-24ca-4a11-8c56-e91d31d83032', 'quantite': ''}, {'ingredient_id': '823cbfab-be0b-4a32-86bd-c92138c6f536', 'quantite': '125 g'}, {'ingredient_id': '151dfc7d-bfdf-454e-add1-8edbac69f506', 'quantite': '125 g'}, {'ingredient_id': '4494befd-8b64-49cd-abaf-6d43cbd1eb16', 'quantite': '125 g'}, {'ingredient_id': '4ba69647-d8e2-4372-bd83-5a40132eb813', 'quantite': '70 g'}, {'ingredient_id': '1bb37c58-e323-499f-b1e7-5e2ea303134e', 'quantite': '125 g'}, {'ingredient_id': '02cfad43-b3f0-420e-802a-16f0de9ab7a1', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (253880, 'Tarte à la banane de Noor', 'banane, pâte feuilletée, oeuf, sucre fin, crème fraîche liquide, farine', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Dans un saladier, écraser 3 bananes.', 'Y ajouter le sucre, la farine et les œufs.', 'Bien mélanger.', 'Verser petit à petit la crème fraîche liquide.', 'Une fois votre pâte dans le moule, ne pas oublier de la piquer et y verser le contenu du saladier.', 'Coupez les deux bananes restantes en rondelles et les disposer selon votre goût sur le plat.', 'Enfourner à 180°C pendant environ 30 min (jusqu''à ce qu''elle soit bien dorée).', 'Astuce : Piquer le milieu de la tarte avec un couteau pour vérifier si elle est cuite.'], ['Presse-agrumes', 'Poêle', 'Louche', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'sucre fin', 'très facile', 'bon marché', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'pâte feuilletée', 'Tarte à la banane de Noor', 'cocktail'], 'Dessert', 6a340f74-d034-4995-91a6-31255bf35017, '2025-09-26T17:10:48.259866', [{'ingredient_id': 'c9be7dae-c6cb-416c-8103-47ed46d51247', 'quantite': '5'}, {'ingredient_id': '7f08d44f-49f6-4ec1-9d63-9292b70608c2', 'quantite': '1'}, {'ingredient_id': 'a7209bde-5699-47f2-a659-9d09fb270c4c', 'quantite': '3'}, {'ingredient_id': 'b3e51607-09b2-4333-aa7b-f2055a5af3ba', 'quantite': '175 g'}, {'ingredient_id': '638ce04f-9875-46a1-9452-fb9c1ac0325f', 'quantite': '10 cl'}, {'ingredient_id': '941c8010-93b4-428f-8d0d-d1e916117c2f', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37853, 'Base pour milk-shake', 'glace vanille, miel, lait, yaourt, banane, biscuit', '5 min', ['Verser tous les ingrédients dans le robot et mixer pendant 1 minute. ', 'Verser dans un verre et déguster sans plus attendre !'], ['Économe', 'Verre doseur', 'Râpe', 'Rouleau à pâtisserie', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'Base pour milk-shake', 'très facile', 'bon marché', 'rapide', 'plat', 'biscuit', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'lait', 'cocktail'], 'Boisson', 9a5e56ba-15c3-4c6b-b708-5a19338af57f, '2025-09-26T17:10:51.840808', [{'ingredient_id': 'd1b3f5d7-ca6a-4deb-ae76-a6b8e08701cf', 'quantite': '1 cuillères'}, {'ingredient_id': '7928edfa-e7af-4ae1-b9b5-4786269419f6', 'quantite': '1 cuillères'}, {'ingredient_id': 'c868fb01-9e73-493f-aae0-1d3b70a431f1', 'quantite': '15 cl'}, {'ingredient_id': 'b99647bc-c8af-4261-9d07-2f23c88289fc', 'quantite': '90 g'}, {'ingredient_id': '020d9f85-0897-4a6f-9a67-ee4a414fe275', 'quantite': '1'}, {'ingredient_id': '4070a36a-13f3-48fc-a79a-35f390cca1ed', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72563, 'Bananes flambées au Cognac', 'beurre, banane, sucre semoule, cognac, cannelle', '15 min', ['Eplucher les bananes et les couper dans le sens de la longueur ou les garder entières.', 'Faire fondre le beurre.', 'Quand il crépite, faire revenir les bananes jusqu''à ce qu''elles soit dorées.', 'Saupoudrer de sucre et laisser caraméliser plus ou moins selon votre goût. ', 'Ajouter la cannelle.', 'Terminer en ajoutant le Cognac d''un seul coup pour les flamber (attention de ne pas vous brûler avec les flammes).', 'Une fois l''alcool évaporé, les flammes disparaissent: c''est prêt!', 'A manger tiède et aussitôt.', 'Bon appétit!'], ['Tire-bouchon', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Bananes flambées au Cognac', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'cannelle', 'cognac', 'cocktail'], 'Dessert', 83d3cc05-f57d-4fd7-9a56-74283f1be559, '2025-09-26T17:10:55.453552', [{'ingredient_id': '7053f198-e819-4937-b19f-7eb5feef38a3', 'quantite': '1'}, {'ingredient_id': '0e327da3-31a4-42b5-9110-22c735f24a73', 'quantite': '2'}, {'ingredient_id': '2ec469e0-ccda-4e9e-b9b1-5cea2909f333', 'quantite': '4 cuillères'}, {'ingredient_id': '2d1bb14a-41a6-4001-b197-acf8187c9cc8', 'quantite': '1'}, {'ingredient_id': 'e76a814a-bfc3-4b19-b66c-9bb8df795572', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (225403, 'Verrine pêche, banane et chocolat', 'fromage blanc sucré, spéculoos, banane, pêche, chocolat', '15 min', ['Egoutter les pêches. Les couper en cubes. Détailler la banane en rondelles et faire fondre le chocolat 40 secondes au micro-ondes avec un peu d''eau.', 'Montage des verrines :', 'Casser un spéculoos dans le fond d''une verrine, mettre 1 à 2 cuillères de fromage blanc, disposer les bananes et recouvrir de chocolat fondu, remettre du fromage blanc, du spéculoos puis les pêches et recouvrir de chocolat fondu, pour finir émietter une moitié de spéculoos.'], ['Spatule', 'Rouleau à pâtisserie', 'Louche', 'Économe', 'Pince de cuisine'], ['', 'entrée', 'Verrine pêche', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pêche', 'banane et chocolat', 'cocktail', 'fromage blanc sucré'], 'Dessert', d95bca41-5b72-49d7-bcca-acc88f8b461b, '2025-09-26T17:10:59.142075', [{'ingredient_id': 'c00e48ff-637b-404c-b30e-0c46cfd2a7ff', 'quantite': '600 g'}, {'ingredient_id': 'b87bbcbc-3e27-4f08-8abc-2b9482a2e6de', 'quantite': '15'}, {'ingredient_id': '4aaeaf37-abf3-46ab-a9bf-af30626c1062', 'quantite': '2'}, {'ingredient_id': '28c401d6-d469-4000-8097-361eefeb8bc8', 'quantite': '1'}, {'ingredient_id': '7b792dc9-9180-414e-ba60-da8acf0e4cde', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (344758, 'Petit suisse banane miel', 'petit suisse, banane, miel, sucre vanillé, jus de citron, crème fraîche', '5 min', ['Éplucher et mettre les bananes avec le jus de citron (pour éviter que les bananes noircissent) dans le mixeur avec tous les ingrédients. ', 'Mixer jusqu''à ce que tous les ingrédients soient bien mélanger. ', 'Mettre dans les verrines et au frais jusqu''au moment de servir.  ', 'Bonne dégustation'], ['Spatule', 'Mixeur', 'Moule à tarte', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'petit suisse', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Petit suisse banane miel', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'jus de citron', 'cocktail'], 'Dessert', 00735b48-d0b2-4f42-9abf-a71d5b2a4bb5, '2025-09-26T17:11:04.132591', [{'ingredient_id': '7ed91728-fd73-4470-b883-a4b825779847', 'quantite': '3'}, {'ingredient_id': '30640396-0f23-406c-af36-c3b9aa9325e4', 'quantite': '2'}, {'ingredient_id': '23268b10-7305-4251-94b6-04a62d1ec274', 'quantite': '2 cuillères'}, {'ingredient_id': 'e8c8b00b-cf1b-4025-a19a-822024b5c375', 'quantite': '1'}, {'ingredient_id': 'a074c62c-821d-4194-9e3d-bc8176cae451', 'quantite': '2 cuillères'}, {'ingredient_id': '55fa0532-1962-48b4-ac05-8915a7e9589a', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (48199, 'Smoothie à la banane et au miel', 'banane, miel, lait demi-écrémé, citron', '5 min', ['Tranchez la banane en gros morceaux, puis placez-la dans le mixeur avec le miel, le citron et le lait. ', 'Mixez jusqu''à l''obtention d''un liquide épais.'], ['Louche', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'Smoothie à la banane et au miel', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'lait demi-écrémé', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:11:10.789335', [{'ingredient_id': '760fab76-2458-4212-9150-86918cae3fdc', 'quantite': '1'}, {'ingredient_id': 'e3f88e3a-2690-4cea-a972-6729acfdc403', 'quantite': '1 cuillères'}, {'ingredient_id': 'ab19e87a-d7cb-423d-827d-15197ff8e687', 'quantite': '25 cl'}, {'ingredient_id': '1bd12885-0ff0-4c34-ad6a-31fe17420032', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73626, 'Barres bananes chocolat', 'beurre, sucre, oeuf, farine, levure, banane, beurre, cacao, sucre glace, lait', '30 min', ['Mélangez le beurre à température ambiante et le sucre.', 'Rajoutez les oeufs et la farine en versant alternativement une cuillerée de chaque. Vous devez obtenir une pâte lisse.', 'Rajoutez la farine puis les bananes écrasées. Mélangez bien.', 'Versez la préparation dans un moule rectangulaire de 20x30 cm recouvert de papier sulfurisé.', 'Faites cuire 25 à 30 min au four à 180°C (thermostat 6).', 'Laissez refroidir dans le moule.', 'Pour le glaçage : faites ramollir le beurre dans une petite casserole à feu très doux et ajoutez-y le cacao.', 'Retirez du feu et ajoutez le sucre glace en remuant.', 'Remettez sur feu doux sans cessez de remuer jusqu''à ce que le beurre soit fondu. Rajoutez éventuellement un peu de lait pour obtenir un glaçage lisse et liquide.', 'Etalez le glaçage sur le gâteau et laissez refroidir complètement.', 'Coupez-le ensuite en 16 barres. Elles se conservent jusqu''à trois jours dans une boîte hermétique.'], ['Louche', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Barres bananes chocolat', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:11:14.398082', [{'ingredient_id': 'e64f3be7-8540-4711-9a27-7f8c5e8b41ce', 'quantite': '175 g'}, {'ingredient_id': '7445735c-8ca8-4fc0-b53e-d5e3b3ac109b', 'quantite': '175 g'}, {'ingredient_id': '460bf64c-d0c0-4520-857f-8c957ae2f4f3', 'quantite': '3'}, {'ingredient_id': '1c922c3a-2c2b-4a40-91e1-d529ab388eb5', 'quantite': '250 g'}, {'ingredient_id': 'b4003585-b22e-4168-8af5-38c2efe30460', 'quantite': '1 cuillères'}, {'ingredient_id': '643807ab-c107-4b59-9ac5-ae209785721d', 'quantite': '2'}, {'ingredient_id': '4ee2b29c-c4f3-4b99-a2ef-98f435137394', 'quantite': '50 g'}, {'ingredient_id': '21147391-0f46-490c-9f90-c88e0644a963', 'quantite': '50 g'}, {'ingredient_id': '71c1e98c-6208-496e-b051-f11091d76321', 'quantite': '250 g'}, {'ingredient_id': '5521b7d6-a568-4679-96fd-fb92baf5157b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30536, 'Mousse banane et coco', 'banane, lait concentré non sucré, lait de coco, citron vert, noix de coco rapée, sucre', '30 min', ['Versez le lait concentré dans une jatte en verre et le placer 15 min au congélateur. Zestez le citron vert puis pressez-le.', 'Pelez les bananes et mixez-les avec la moitié du jus de citron. Ajoutez le lait de coco, la noix de coco râpée et le sucre. Mixez à nouveau pour que la purée soit bien lisse. ', 'Fouettez le lait concentré au batteur électrique pour qu''il devienne mousseux. Incorporez-le à la purée de banane.', 'Versez la préparation dans un plat ou des verres, parsemez de noix de coco râpée et de zestes de citron vert.'], ['Verre doseur', 'Batteur électrique', 'Presse-agrumes'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Mousse banane et coco', 'noix de coco rapée', 'dessert', 'plat de résistance', 'mousse fruits', 'citron vert', 'lait concentré non sucré', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:11:17.980076', [{'ingredient_id': '8cbd0f7b-25ea-46a1-925f-75875216a7fd', 'quantite': '3'}, {'ingredient_id': 'e300c2c8-1fab-4f1c-990a-be3d8e9d060a', 'quantite': '20 cl'}, {'ingredient_id': 'c2d4a3b1-8527-4210-b491-21fefa1d73c5', 'quantite': '10 cl'}, {'ingredient_id': 'ded615a4-f124-4046-82a3-2451e43de133', 'quantite': '1'}, {'ingredient_id': 'd6b1a9da-e05f-4c69-9694-a915a922eab3', 'quantite': '5 cuillères'}, {'ingredient_id': 'bf8452dc-e1be-4334-89ab-af6681ee4bc7', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315150, 'Soupe de fraise à la banane', 'fraises, banane, miel', '10 min', ['Coupez vos fraises et vos bananes grossièrement en quartiers, ajoutez le miel, mixez, dégustez !'], ['Planche à découper', 'Couteau de chef', 'Moule à tarte', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'Soupe de fraise à la banane', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', c532a5df-a6e1-4356-8b27-befb616dbd4e, '2025-09-26T17:11:22.402781', [{'ingredient_id': '5bdb9395-d85c-4b30-89e9-6d4282613768', 'quantite': '500 g'}, {'ingredient_id': 'b7608bfa-4d0b-4d6c-83c1-de819b081ce7', 'quantite': '2'}, {'ingredient_id': '1a5dedd9-a16c-4873-ba21-8c114d275b89', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29260, 'Tarte à la banane et aux amandes (5ème rencontre Marmiton)', 'pâte brisée, banane, sucre en poudre, oeuf, crème fraîche, arôme vanille, amandes en poudre, citron, amandes effilées', '15 min', ['Abaisser la pâte dans un moule à tarte. ', 'Piquer le fond et les bords à la fourchette. ', 'Dans un récipient, casser les oeufs et ajouter le sucre roux. Battre énergiquement quelques minutes. ', 'Dans un mixer, mixer les bananes, la crème fraîche, la vanille, le jus de citron et la poudre d''amandes. ', 'Mélanger les 2 préparations. ', 'Verser l''ensemble sur le fond de tarte cru. ', 'Répartir les amandes effilées sur le dessus. ', 'Faire cuire à four chaud Th 6/7 (180/210°C) pendant 25 mn (à surveiller).'], ['Batteur électrique', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'cocktail', 'facile', 'bon marché', 'amandes en poudre', 'oeuf', 'plat', 'tarte à la banane', 'sucre en poudre', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'arôme vanille', 'citron', 'amandes effilées', 'Tarte à la banane et aux amandes (5ème rencontre Marmiton)'], 'Dessert', 85cbbfac-4a74-4644-967d-399bef0f8492, '2025-09-26T17:11:26.265852', [{'ingredient_id': '5ee9e541-a536-4fa8-8311-f1834909026b', 'quantite': ''}, {'ingredient_id': 'bc41da00-7af1-40e4-8232-5ccbbcba6201', 'quantite': '4'}, {'ingredient_id': '8933ebf7-c398-4024-9b22-0a8ff99e401a', 'quantite': '200 g'}, {'ingredient_id': 'e85d3eea-bf88-4112-beee-6e53988a7bee', 'quantite': '4'}, {'ingredient_id': 'fbfa6b6a-5722-4bc1-83f2-6c92aa2b1c3c', 'quantite': '2'}, {'ingredient_id': '3b8d7c8e-694e-4e80-8514-3e08bc1c74fb', 'quantite': '1 cuillères'}, {'ingredient_id': 'd9493359-937b-4dab-aa23-c21252d36585', 'quantite': '2 cuillères'}, {'ingredient_id': '1d24818e-6ac1-4506-adcf-d5e0cc62e0c6', 'quantite': '1'}, {'ingredient_id': '41d49baf-b54e-430d-a81c-ee477848fedf', 'quantite': '30 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (217566, 'Délice à banane (cheesecake revisité)', 'banane, spéculoos, beurre, sucre, fromage blanc', '10 min', ['Émietter les spéculoos (ce n''est pas grave s''il reste des petits morceaux!)', 'Faire fondre 15 g de beurre puis l''ajouter aux spéculoos.', 'Verser le mélange dans le cercle (posé dans une assiette ou un support plat) et bien aplatir à l''aide d''une cuillère, le mettre au frigo.', 'Faire fondre le reste de beurre dans une poêle puis ajouter la banane préalablement coupée en rondelles.', 'Quand la banane commence à cuire, ajouter le sucre et bien enrober les bananes en remuant à l''aide d''une cuillère.', 'Vous devez obtenir des rondelles de bananes bien cuites et une petite sauce formée avec le sucre beurre et banane. ', 'Si c''est trop épais, ajouter une cuillère à soupe de crème liquide et laisser chauffer un peu.', 'Mettre les rondelles de bananes en les prélevant sur le fond au spéculoos.', 'Mettre le fromage blanc dans la poêle ayant servi à la cuisson et le mélanger avec la petite "sauce" formée.', 'Ajouter cette dernière couche par dessus en essayant de bien l''étaler.', 'Laisser au frigo au moins 30 min, 1h c''est mieux, puis retirer le cercle.', 'Vous obtenez 3 couches distinctes c''est très joli et d''après mon mari très bon ! (Il ne m''a même pas laissé le temps de prendre une photo !)'], ['Fouet', 'Poêle', 'Casserole', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'Délice à banane (cheesecake revisité)', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'cheesecake', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:11:31.085212', [{'ingredient_id': 'aa687114-5c3c-4d7e-8e2a-a5fc7a46ff5f', 'quantite': '1'}, {'ingredient_id': 'f5ae68fd-8885-4182-85d1-c53f886f73cb', 'quantite': '4'}, {'ingredient_id': 'f32509e4-9f5c-4fd6-9894-d659148effac', 'quantite': '20 g'}, {'ingredient_id': '455cf96e-cbeb-4222-8ce7-caad6c57229b', 'quantite': '2 cuillères'}, {'ingredient_id': '1d11a416-141c-4cbc-9bda-29e57d64f610', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12212, 'Bananes au lait de coco et perles de tapioca', 'banane, sucre, tapioca, lait de coco, vanille, cacahuète grillée', '30 min', ['Faire tremper les perles de tapioca', 'dans l''eau pendant 20 minutes. Egouttez et les mettre de côté.', 'Saupoudrer les bananes avec le sucre.', 'Verser le contenu de deux boîtes de lait de coco dans une casserole, faites  chauffer. ', 'Aux premières ébullitions, rajouter les perles de tapioca. Bien mélanger et laisser cuire pendant 15 minutes.', 'Lorsque les perles de tapioca sont devenues toutes transparentes, ajouter les bananes et le sucre. Faites cuire encore un peu plus de 10 minutes.', 'Eteindre le feu et ajouter la dernière boîte de lait de coco, remuer. Servir saupoudré de cacahuètes grillées et pilées.'], ['Batteur électrique', 'Mixeur', 'Rouleau à pâtisserie', 'Économe', 'Fouet'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'tapioca', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'sucre', 'Bananes au lait de coco et perles de tapioca', 'cocktail', 'cacahuète grillée'], 'Dessert', cd0f3851-dabe-4fda-ad6e-43585da553b6, '2025-09-26T17:11:35.679900', [{'ingredient_id': '046c2d0b-42f0-4605-92d9-1aeb9f28d336', 'quantite': '8'}, {'ingredient_id': '9a89f00b-6b6b-45f3-8717-b6d936271b40', 'quantite': '250 g'}, {'ingredient_id': '2b34d163-af29-4a90-8b8b-9b12615695cf', 'quantite': '125 g'}, {'ingredient_id': '798f72db-2d7f-4aa0-8c76-e85db84d9dcd', 'quantite': '3'}, {'ingredient_id': 'a75d109a-d9ac-4e85-844a-6a15eb406d48', 'quantite': '1'}, {'ingredient_id': 'ff8f6bd6-1b6c-4fda-9ee2-3944ddf0406f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81445, 'Mon smoothie énergie du goûter', 'lait entier, banane, chocolat en poudre, glaçons', '5 min', ['Mettre le tout dans le mixer et voilà un smoothie plein d''énergie pour le goûter de nos écoliers.'], ['Passoire', 'Tire-bouchon', 'Râpe', 'Moule à tarte', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Mon smoothie énergie du goûter', 'bon marché', 'lait entier', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'chocolat en poudre', 'smoothies', 'cocktail'], 'Boisson', b349cf63-98ea-4bb3-9eca-50a899a12f1f, '2025-09-26T17:11:39.186253', [{'ingredient_id': '505a300c-da66-41da-99c7-c02844cdb965', 'quantite': '1'}, {'ingredient_id': '958f4fb6-7025-4d0f-8197-03e28d2ee7b2', 'quantite': '2'}, {'ingredient_id': 'af5f591f-c6b9-425c-a9d9-65c990597aee', 'quantite': '3 cuillères'}, {'ingredient_id': '672200f6-aba5-4b80-9355-092ff66571b3', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (220495, 'Cake végétalien à la banane', 'sucre de canne, huile de tournesol, farine, levure chimique, sel, banane', '10 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Mélanger le sucre de canne et l''huile de tournesol jusqu''à obtention d''un mélange bien homogène.', 'Écraser les bananes dans un récipient séparé et les incorporer dans le mélange.', 'Ajouter la farine, la levure chimique et le sel. Remuer très énergiquement.', 'Huiler un plat pour cake, y verser la préparation.', 'Laisser cuire pendant 50 min au four comme un cake traditionnel.'], ['Râpe', 'Spatule', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'farine', 'huile de tournesol', 'autres cakes', 'dessert', 'plat de résistance', 'Cake végétalien à la banane', 'cocktail'], 'Dessert', beeb9ff0-c373-4861-bef9-d891b67b1521, '2025-09-26T17:11:42.741643', [{'ingredient_id': '27a75464-8685-45c7-a78d-8458549526de', 'quantite': '150 g'}, {'ingredient_id': '10361f7c-9b2c-4820-8252-e3293d7ba080', 'quantite': '70 g'}, {'ingredient_id': '453811d4-ed0f-4da7-bab7-b3049580a93c', 'quantite': '150 g'}, {'ingredient_id': '682ea8ea-b58b-46b8-93d1-f2c6d08ab541', 'quantite': '1'}, {'ingredient_id': '477e152c-c144-4b8b-9847-f67bcaeef8fb', 'quantite': ''}, {'ingredient_id': 'd52b5197-7cef-40dd-a6c6-ae10ea23d035', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81835, 'Nems banane-chocolat', 'chocolat noir, banane, jus de citron, miel, brick, beurre, jaune d''oeuf', '30 min', ['Préparez la garniture : ', 'Épluchez les bananes et coupez-les en rondelles. Arrosez-les de jus de citron. ', 'Dans une poêle, versez le miel et faites-le caraméliser à feu doux quelques instants. ', 'Ajoutez les rondelles de bananes et faites-les dorer jusqu''à obtention d''une purée caramélisée. Réservez.', 'Préchauffez votre four à 210°C (thermostat 7).', 'Préparez les nems:', 'Faites fondre le beurre au micro-ondes.', 'Détachez délicatement les feuilles de brick et coupez-les en deux. Badigeonnez-les de beurre fondu à l''aide d''un pinceau. Répartissez la purée de bananes au centre de chaque feuilles de brick et ajoutez un carré de chocolat sur les bananes.', 'Rabattez les 2 extrémités pointues et roulez sur lui-même.', 'Déposez les nems sur une plaque recouverte de papier sulfurisé. ', 'Dans un bol, battez les jaunes d''oeufs et badigeonnez chaque nems.', 'Mettez au four 10 à 15 min et surveillez.'], ['Râpe', 'Verre doseur', 'Passoire', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'Nems banane-chocolat', 'dessert', 'plat de résistance', 'chocolat noir', 'dessert au chocolat', 'jus de citron', 'moyen', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:11:46.211969', [{'ingredient_id': '123184e2-5aab-48a0-a813-13c99f52df94', 'quantite': '24'}, {'ingredient_id': '2941da95-6d2a-49aa-90be-89d214b9794c', 'quantite': '10'}, {'ingredient_id': '3e258ff6-2334-4f7a-9586-d26dfe611390', 'quantite': ''}, {'ingredient_id': 'ca4dcb87-f394-4b75-8739-1b70c99f901f', 'quantite': '10 cuillères'}, {'ingredient_id': 'd17c6ed6-dc06-47b7-89a2-ff834645ef54', 'quantite': '12'}, {'ingredient_id': '7fb2f219-e804-41b4-b367-ca4256be0d4a', 'quantite': '40 g'}, {'ingredient_id': 'dd387d53-7a46-44f0-b2c6-505082d81b19', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (89362, 'Tarte kiwi-banane et coulis de framboise', 'pâte sablée, kiwi, banane, oeuf, sucre vanillé, sucre en poudre, crème fraîche épaisse, coulis de framboise', '25 min', ['Sortez la pâte du réfrigérateur quelques minutes avant de commencer la préparation pour qu''elle soit plus souple. Déroulez-la dans un moule à tarte et piquez-la avec une fourchette. ', 'Dans un bol, verser la crème fraîche, le sucre vanillé. Cassez un oeuf entier et séparez le blanc du jaune de l''autre : le jaune servira à dorer les bords de la tarte. Ajoutez le blanc restant. Battez le tout et ajoutez le sucre. Vous devez obtenir une crème liquide. Mettez-la de côté.', 'Epluchez les kiwis et les bananes et coupez-les en rondelles, que vous disposerez sur la pâte en commençant par l''extérieur et alternant les ronds de kiwi et ceux de banane. ', 'Quand vous avez disposé tous les fruits, versez l''appareil en le répartissant sur la tarte et dorez les bords avec le jaune d''oeuf.', 'Faites cuire à four chaud à 160°C (thermostat 5-6) pendant 25 à 30 minutes. ', 'Juste avant de servir, vous pouvez verser du coulis de framboise sur la tarte.'], ['Couteau de chef', 'Mixeur', 'Verre doseur'], ['coulis de fruits rouges', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'crème fraîche épaisse', 'confiserie', 'testées', 'facile', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'Tarte kiwi-banane et coulis de framboise', 'cocktail', 'coulis de framboise'], 'Dessert', 5c616c36-e382-4a30-8fae-cb274ca27dd2, '2025-09-26T17:11:49.964595', [{'ingredient_id': '75458903-9586-494e-8f49-d243e56fa779', 'quantite': '1'}, {'ingredient_id': '2eedede1-6bd1-4818-9e5c-33ad93748c5a', 'quantite': '2'}, {'ingredient_id': '6796b71f-153e-4014-bee3-926537e5861e', 'quantite': '2'}, {'ingredient_id': '96978fae-a51f-4332-ad29-bf2e13cd3045', 'quantite': '2'}, {'ingredient_id': 'd8d88859-b02c-4653-9c2b-002b272c9b3d', 'quantite': '1'}, {'ingredient_id': '85d014b2-6153-4eba-8230-64ed133b0709', 'quantite': '30 g'}, {'ingredient_id': '514218a0-3e56-4e19-815d-0bff7d793d7e', 'quantite': '2 cuillères'}, {'ingredient_id': 'b8483ecb-6b95-4d94-bd55-fc7815a1d021', 'quantite': '5 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (67969, 'banoffee pie facile au mascarpone', 'confiture de lait, mascarpone, sucre, banane, spéculoos, petit lu, beurre, gros sel, cacao amer', '15 min', ['Concassez la moitié de chaque paquet de gâteaux dans une poêle avec le morceau de beurre et le gros sel.', 'Mettez au fond d''un plat, cela constituera le fond du gâteau.', 'Étalez la moitié du pot de confiture de lait sur les gâteaux.', 'Coupez les bananes en rondelles et mettez-les par dessus la confiture de lait.', 'Mélangez le mascarpone avec le sucre et recouvrez les bananes.', 'Saupoudrez de cacao amer et mettez au frais la veille au réfrigérateur. '], ['Planche à découper', 'Tire-bouchon'], ['gros sel', 'entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'cacao amer', 'banoffee', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'banoffee pie facile au mascarpone', 'boisson', 'confiture de lait', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'sucre', 'cocktail', 'petit lu'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:11:53.615795', [{'ingredient_id': 'a5fe58c5-d394-478f-88fc-ee9374be49f8', 'quantite': '125 g'}, {'ingredient_id': '92bff13c-ed46-4ba5-8593-b9e0fe9b848c', 'quantite': '250 g'}, {'ingredient_id': '7cbd356b-8a93-4ac1-a9a7-1c145a4916fd', 'quantite': '50 g'}, {'ingredient_id': '9b2f1b72-a99b-4d0f-8881-997172aac100', 'quantite': '3'}, {'ingredient_id': '365201d6-2e01-44fb-a499-3c852ae6b602', 'quantite': '1'}, {'ingredient_id': '0bb1dd33-fa91-4c21-ac64-d92c6d134c36', 'quantite': '1'}, {'ingredient_id': 'deb8fba5-d569-4e39-817c-a9806a727234', 'quantite': '1'}, {'ingredient_id': '86132c70-c476-40aa-93f1-24aad76303fe', 'quantite': '1'}, {'ingredient_id': 'ef848f7b-ebf1-48ab-8b58-868dac46ab9d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (219751, 'Beignet de banane façon créole', 'banane, farine, sucre, oeuf, rhum, vanille, amandes, huile', '15 min', ['Dans un saladier, mélangez le sucre, la farine, les œufs ensembles jusqu''à obtenir une pâte bien homogène.', 'Écrasez les bananes à l''aide d''une fourchette et ajoutez-les au mélange du saladier.', 'Ajoutez le rhum blanc, l''essence de vanille et l''amande amère. Mélangez le tout.', 'Faites chauffer l''huile et une fois bien chaude, réalisez des beignets avec la préparation à l''aide d''une cuillère à soupe. Répétez l''opération autant de fois que nécessaire.', 'Une fois prêt saupoudrez de sucre cristallisé ou sucre glace à votre convenance. ', 'Laissez refroidir un peu, pas trop, et savourez !'], ['Casserole', 'Pince de cuisine', 'Tire-bouchon', 'Presse-agrumes'], ['amandes', 'Beignet de banane façon créole', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'beignets sucrés', 'farine', 'vanille', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', 130749af-844e-4e73-9077-e645ef15e1d5, '2025-09-26T17:11:58.315276', [{'ingredient_id': 'e3c7bdd9-792a-4fe7-afd9-8a58a0f5def2', 'quantite': '3'}, {'ingredient_id': '0dbe6f84-8cd9-4566-a251-c9cac89bb4c0', 'quantite': '3 cuillères'}, {'ingredient_id': '3bed337b-0ca4-4775-8183-d5609626f3f0', 'quantite': '2 cuillères'}, {'ingredient_id': '40a8ab1e-b1d2-42b3-b460-be1e6c5fe5fb', 'quantite': '2'}, {'ingredient_id': '07c5f289-47e3-46cb-929e-c3c159ebb00d', 'quantite': '1'}, {'ingredient_id': '8586c053-2fb3-4e15-93f4-7612b8075165', 'quantite': '1 cuillères'}, {'ingredient_id': '8575e8be-74f0-492f-86e8-f3a2e01be041', 'quantite': '1 cuillères'}, {'ingredient_id': '40a34ef3-a375-4018-9c68-3b48ccb36a48', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (218399, 'Bouillie de flocon d''avoine (porridge) coco, banane, pomme', 'flocons d''avoine, lait, pomme, banane, noix de coco rapée, sucre roux, sucre vanillé, cannelle, rhum', '25 min', ['Couper les fruits en morceaux.', 'Mettre tous les ingrédients dans une grande casserole.', 'Mettre la casserole à chauffer en remuant de temps en temps.', 'Monter en température jusqu''à grosse ébullition (n''oublier pas de remuer pour que ça n''accroche pas au fond).', 'Une fois que c''est à ébullition, il faut maintenir l’ébullition pendant une minute sans cesser de remuer.', 'Une fois fait c''est près, il n''y a plus qu''à attendre que ça refroidisse un peu.', 'Je trouve que c''est meilleur tiède mais vous pouvez aussi manger très chaud (attention à ne pas vous brûler) ou bien froid.'], ['Ouvre-boîte', 'Presse-agrumes', 'Mixeur', 'Spatule', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'Porridge', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'Bouillie de flocon d''avoine (porridge) coco', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'cannelle', 'lait', 'flocons d''avoine', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:12:02.076944', [{'ingredient_id': '12e12e29-655c-4a06-a21e-edeb55ec777a', 'quantite': '2'}, {'ingredient_id': '7bd76dae-e636-4756-8baf-29950ea394fc', 'quantite': '5'}, {'ingredient_id': '2e87f484-8e1c-468f-ac06-afbcb15b0c30', 'quantite': '3'}, {'ingredient_id': '86ed4494-9de6-4923-ad76-7f141befbe68', 'quantite': '2'}, {'ingredient_id': '6928b1a4-6695-4627-9f18-5c4e23adee95', 'quantite': '1'}, {'ingredient_id': '24072912-79b0-4b12-bac7-2e9d1745bfb8', 'quantite': ''}, {'ingredient_id': 'a6409b36-1c8e-4110-b20a-02767d5ec510', 'quantite': '1'}, {'ingredient_id': '45cc3d8b-4749-42ff-a26f-875e667265a0', 'quantite': '1'}, {'ingredient_id': '8b187428-8371-471e-97d9-d2e536f949bd', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22477, 'Bananes au chocolat', 'banane, sucre vanillé, Liqueur, crème fraîche, chocolat, eau, sucre fin', '10 min', ['Epluchez et coupez les bananes en rondelles régulières.', 'Rangez-les dans un compotier.', 'Parfumez avec la liqueur et saupoudrez de sucre vanillé. Fouettez la crème fraîche avec le sucre fin en Chantilly. Faites fondre le chocolat avec de l''eau. ', 'Nappez les bananes avec la sauce au chocolat et garnissez au moment de servir avec la Chantilly.'], ['Pince de cuisine', 'Couteau de chef', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'eau', 'testées', 'chocolat', 'sucre fin', 'très facile', 'Bananes au chocolat', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'Liqueur', 'cocktail'], 'Dessert', 7e1e0bc0-ec7e-4609-9628-48dae32acd6a, '2025-09-26T17:12:05.650169', [{'ingredient_id': 'b4444672-87ab-414b-ade9-7aca55a08c01', 'quantite': '4'}, {'ingredient_id': 'ec422df4-3abf-4781-b14a-e3d18fd13ba7', 'quantite': '1'}, {'ingredient_id': '3cbd7ecf-d84d-4d9e-a9b3-caaaf73a00ab', 'quantite': '1'}, {'ingredient_id': 'c1a11557-a4f9-45fe-a2e4-e41d631053f4', 'quantite': '100 g'}, {'ingredient_id': 'd05e1765-b0ed-4846-8527-a59743ec0756', 'quantite': '100 g'}, {'ingredient_id': '3fff4b25-8bad-4c47-9c85-31940749d8bf', 'quantite': '3 cuillères'}, {'ingredient_id': '66c5e504-197c-4001-a130-eaa76dddda90', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (349039, 'Tarte banane, kaki et spéculoos', 'kaki, banane, pâte feuilletée, spéculoos, miel, cannelle', '20 min', ['Préchauffer le four à 190°C (thermostat 6).', 'Dérouler la pâte feuilletée sur un moule à tarte.', 'Piquer le fond et les bords avec une fourchette pour éviter que la pâte ne gonfle trop.', 'Peler les kakis et les couper en petits dés.', 'Couper les bananes en rondelles.', 'Disposer le tout dans un saladier, ajouter miel et cannelle et mélanger.', 'Briser les spéculoos (vous pouvez les placer dans un torchon et frapper au dessus à l''aide d''un rouleau à pâtisserie).', 'Les ajouter à la préparation et mélanger.', 'Étaler la préparation sur la pâte feuilletée en la répartissant bien.', 'Enfourner pour 30 à 35 minutes.'], ['Économe', 'Mixeur', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'tarte à la banane', 'recette', 'spéculoos', 'cuisine', 'kaki', 'miel', 'recettes', 'boisson', 'kaki et spéculoos', 'dessert', 'plat de résistance', 'pâte feuilletée', 'cannelle', 'Tarte banane', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:12:09.320778', [{'ingredient_id': '580e6028-a397-4ac3-97c4-72e4559e39c7', 'quantite': '2'}, {'ingredient_id': '7f576bb6-bba1-4984-b7d5-8f9a9d445eaa', 'quantite': '2'}, {'ingredient_id': '6f754a10-2aea-4a67-8f6e-08ee05df227a', 'quantite': '1'}, {'ingredient_id': 'daf9e45d-6835-45c6-9108-7098c5d72aba', 'quantite': '10'}, {'ingredient_id': '25c39c35-6134-4332-b3a9-cc0f4ba2af36', 'quantite': '2 cuillères'}, {'ingredient_id': 'c76604e6-c05a-4ca9-bdb3-2feeb99118af', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (69560, 'cake moelleux bananes - pommes et pépites de chocolat', 'pomme, banane, petit suisse, farine, sucre, beurre, oeuf, chocolat noir, levure, rhum', '15 min', ['Eplucher et couper la pomme et 1 banane en morceaux, faire cuire avec une cuillière de rhum au four à 200° pendant environ 10 à 15 min (le temps de préparer la pâte à cake).', 'Mélanger ensemble; les oeufs, le sucre, la farine, les petits suisse, le beurre fondu, 1 banane, la levure et enfin le chocolat en morceaux.', 'Sortir le plat du four, verser la pâte à cake par dessus les fruits et faire cuire à 200°C (thermostat 6/7) pendant 25 min.', 'Servir tiède! Bon appétit!'], ['Moule à tarte', 'Pince de cuisine', 'Balance de cuisine', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'petit suisse', 'testées', 'facile', 'bon marché', 'cake moelleux bananes - pommes et pépites de chocolat', 'oeuf', 'plat', 'recette', 'levure', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'chocolat noir', 'pomme', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:12:12.809261', [{'ingredient_id': '3534da03-ad6d-4357-a4c8-e5b8ec1e686d', 'quantite': '1'}, {'ingredient_id': '20356426-a528-4275-863c-1b9ce18861bb', 'quantite': '2'}, {'ingredient_id': 'a85cc330-59bf-47eb-a881-a956690638ec', 'quantite': '2'}, {'ingredient_id': '5b45ad42-71db-4a1f-a6ad-313945e251f7', 'quantite': '100 g'}, {'ingredient_id': '2e758590-bcdc-457b-b0a2-941f43db85a7', 'quantite': '100 g'}, {'ingredient_id': 'c002d130-d3f6-4a22-b496-fac53b7fab9e', 'quantite': '50 g'}, {'ingredient_id': '713037f4-d953-4516-ba51-7c8539a9d3b1', 'quantite': '2'}, {'ingredient_id': '1990b3b8-1a88-4c57-835f-e9fae76a44b4', 'quantite': '80 g'}, {'ingredient_id': 'cce2f2cb-52c1-4692-9ffb-84fac29c8c15', 'quantite': ''}, {'ingredient_id': 'b87d8670-e135-473b-b5bd-47bcfee3ceeb', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (86464, 'Poulet caraïbe', 'poulet, huile, poivron, oignon, bouillon de poule, farine, ananas, poulet, ketchup, curry, poivre, sel, banane', '30 min', ['Préchauffer le four à 230°C (thermostat 7-8).', 'Revenir le poulet dans une poêle avec l''huile, puis mettre dans un plat allant au four.', 'Faire brunir oignons et poivrons, ajouter au poulet.', 'Ajouter le bouillon de poulet au jus d''ananas.', 'Chauffer doucement la préparation.', 'Diluer la farine dans le jus d''ananas.', 'Ajouter le ketchup et le curry, saler et poivrer la préparation.', 'Déposer les morceaux d''ananas sur le poulet.', 'Arroser le poulet avec le jus d''ananas épicé.', 'Cuire 30 min au four.', 'Ajouter les morceaux de bananes coupés en rondelles.', 'Arroser les bananes avec le jus de cuisson.', 'Laisser cuire encore 30 min.'], ['Planche à découper', 'Presse-agrumes', 'Tire-bouchon', 'Casserole'], ['', 'ketchup', 'poulet', 'bouillon de poule', 'banane', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile', 'farine', 'poivron', 'dessert', 'plat de résistance', 'ananas', 'poivre', 'curry', 'Poulet caraïbe', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:12:16.471426', [{'ingredient_id': 'b63a89d8-1552-4388-b38e-62af95495bb0', 'quantite': '800 g'}, {'ingredient_id': 'aa1e78a3-5449-4f41-832a-3d04207f48fb', 'quantite': '3 cuillères'}, {'ingredient_id': '92559ce1-6656-401d-95c1-d3cab8ea97c1', 'quantite': '250 g'}, {'ingredient_id': '05c7fdfc-e098-494c-ac08-151e6d73a315', 'quantite': '125 g'}, {'ingredient_id': '3bd00b66-e73d-4f83-a6e1-daf42d558fce', 'quantite': '50 cl'}, {'ingredient_id': 'b701a6b5-5a5c-4f75-ac83-d59f22569b7d', 'quantite': '2 cuillères'}, {'ingredient_id': '7040f903-c5ee-4c8f-bd52-82651d74d9d7', 'quantite': '4'}, {'ingredient_id': '13eb2637-8798-4811-b9e8-6db515885cab', 'quantite': '4 cuillères'}, {'ingredient_id': '7d25211f-f5b9-4b5f-b2f6-1b3c1f1d517f', 'quantite': '2 cuillères'}, {'ingredient_id': '2ef91ab6-00f3-4352-a863-3378ca4dea92', 'quantite': '2 cuillères'}, {'ingredient_id': '55b10f33-c1f1-437f-9e8f-912f5f3471ec', 'quantite': ''}, {'ingredient_id': '48f4e7d4-62dd-4b06-81f1-2ef45821db8b', 'quantite': ''}, {'ingredient_id': '6423d01c-0c6a-4014-9d5f-2a70ae320031', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24758, 'Curry de poulet à la banane', 'blanc de poulet, crème fraîche épaisse, oignon, riz, banane, noix de pécan, crevettes, carotte, raisins secs, curry, cardamome, feuille de laurier, clou de girofle, cannelle, gingembre, poivre, sel', '60 min', ['Versez la crème fraîche dans une casserole. Incorporez-y les bananes hachées ainsi que 2-3 cuillères à café de curry (plus ou moins doux selon le goût de chacun). Laissez cuire le tout jusqu''à obtenir une consistance relativement épaisse et non liquide. Gardez au chaud. Salez et poivrez. ', 'Emincez les carottes en julienne et blanchissez les quelques minutes en veillant à ce qu''elles restent "al dente". Salez. Gardez au chaud. ', 'Commencez à cuire votre riz (à la créole de préférence), en y ajoutant dès le début de la cuisson le laurier, la girofle, la cardamome (4-5 graines suffisent) qui donneront une saveur étonnante à votre riz. ', 'Coupez les blancs de poulet en petits carrés de 3-4 cm de côté. Emincez finement les oignons. Faites revenir le tout dans une poêle. Une fois le tout doré, faites revenir les crevettes et noix de pécan quelques minutes (s''il reste encore de la place dans votre poêle !). ', 'ça y est ! Tout est désormais cuit. ', 'Il ne vous reste plus que la présentation et la dernière touche finale. ', 'Faites un petit tas de riz au milieu d''une assiette (à l''aide d''une tasse à café éventuellement). Placez autour tour à tour, le poulet (sur lequel vous saupoudrerez délicatement quelques minuscules morceaux de gingembre frais), les oignons, les noix de pécan encore chaudes. Vous pouvez éventuellement composer une étoile à l''aide des filaments de carotte (chacun d''eux partant du coeur de l''assiette). Les petites tâches jaunes de la sauce au curry et à la banane peuvent alors prendre place dans l''assiette .... ', 'Ajoutez-y quelques raisins secs trempés préalablement dans de l''eau chaude (afin de les faire gonfler). ', 'Bon appétit !'], ['Pince de cuisine', 'Moule à tarte', 'Rouleau à pâtisserie', 'Fouet'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche épaisse', 'feuille de laurier', 'sel', 'confiserie', 'testées', 'carotte', 'noix de pécan', 'facile', 'bon marché', 'curry de poulet', 'cardamome', 'plat', 'blanc de poulet', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'clou de girofle', 'dessert', 'crevettes', 'Curry de poulet à la banane', 'plat de résistance', 'riz', 'raisins secs', 'cannelle', 'poivre', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:12:20.145596', [{'ingredient_id': 'f95fda54-8d2c-4997-a36e-23877dfcd4f6', 'quantite': '4'}, {'ingredient_id': '3e50d5e5-208d-4c44-8976-df06f1e6dac5', 'quantite': '500 g'}, {'ingredient_id': '17f65412-52b0-4601-9ef5-9acc9896addb', 'quantite': '3'}, {'ingredient_id': '19da7882-2cb2-4784-8917-f4abb471dafc', 'quantite': '6'}, {'ingredient_id': '460f4230-9d25-4c38-a69c-2e0fded6c807', 'quantite': '2'}, {'ingredient_id': 'dc616b64-eed0-458b-9d59-e13a208c02dc', 'quantite': '150 g'}, {'ingredient_id': '03f0e3b8-ae64-4a6e-afc3-6a809c98970b', 'quantite': '150 g'}, {'ingredient_id': 'b97c808a-81b8-4213-9c51-5cb66274a1a5', 'quantite': '5'}, {'ingredient_id': '68aa3c41-7ca4-4a8f-89b0-dc0840ead6e3', 'quantite': ''}, {'ingredient_id': '307a80b1-2e11-454d-bad6-eee3dd4ea2e6', 'quantite': ''}, {'ingredient_id': '509070c3-080d-4325-853f-03aa2153d463', 'quantite': ''}, {'ingredient_id': '8a0f8fea-8094-493c-88f9-b6907dee094b', 'quantite': '1'}, {'ingredient_id': 'ab870387-6cc0-43ef-8b3c-855181d7ba21', 'quantite': ''}, {'ingredient_id': 'fbb96fc8-7bca-47d0-8085-880a6364f89a', 'quantite': '1'}, {'ingredient_id': '6be1bbe6-0328-4cb7-b5bf-8b873282f1da', 'quantite': ''}, {'ingredient_id': '0ef3e6eb-ddef-4856-8c95-f85c609ff16a', 'quantite': ''}, {'ingredient_id': '03f36823-c79b-42ee-b314-00fc2806247c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52041, 'Pudding au pain chocobanane', 'pain, banane, oeuf, lait, crème fraîche liquide, sucre, Nutella, beurre', '10 min', ['Préchauffer votre four à 180°C (thermostat 6).', 'Mettre 50 g de sucre au fond d''un moule à manqué beurré.', 'Disposer par dessus les tranches de pain (en les chevauchant si besoin, elles se tasseront avec le lait!).', 'Arroser de lait.', 'Mettre les bananes coupées en 2 dans la longueur au dessus.', 'Napper d''une couche de Nutella (épaisseur en fonction de la gourmandise !).', 'Verser sur la préparation le mélange suivant : oeufs battus en omelette + sucre restant + créme fraîche.', 'Mettre au four pendnat 30 min.', 'Bon Appétit.'], ['Spatule', 'Batteur électrique', 'Verre doseur', 'Poêle', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'Nutella', 'pudding', 'dessert', 'plat de résistance', 'beurre', 'pain', 'lait', 'sucre', 'cocktail', 'Pudding au pain chocobanane'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:12:23.734438', [{'ingredient_id': '5fa51fcb-4b4a-4830-b1c4-7e9782b3842b', 'quantite': '6'}, {'ingredient_id': '993a8952-4ec2-493c-8f5c-ff82548787ef', 'quantite': '4'}, {'ingredient_id': 'ee5fee10-7ade-4f9c-bdc3-cca82761c2e7', 'quantite': '3'}, {'ingredient_id': 'd224a356-96c2-4b8d-b8aa-654a95c113c6', 'quantite': '25 cl'}, {'ingredient_id': '6ea5fdda-a17b-4176-ad4e-7cf51f8824c8', 'quantite': '10 cl'}, {'ingredient_id': '0706b98d-221a-4421-b138-736d601c0643', 'quantite': '100 g'}, {'ingredient_id': 'aea4348c-834b-4b73-ab63-84fa68439397', 'quantite': '1'}, {'ingredient_id': 'f45ba77d-2908-42c4-85b2-71a3e954cbcc', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (89784, 'Chausson de boudin antillais à la banane', 'boudin antillais, banane, pâte brisée, quatre-épices, beurre, jaune d''oeuf', '15 min', ['Dans une casserole, ébouillanter les boudins afin d''ôter leur peau.', 'Couper les boudins en rondelles et les répartir au centre de la pâte préalablement piquée avec la fourchette.', 'Coupez les bananes en rondelles, les faire revnir dans une poêle avec la noisette de beurre, une pincée de mélange aux 4 épices.', 'Déposer la banane sur la pâte.', 'Plier la pâte pour faire un chausson, battre le jaune d''oeuf et l''étaler avec un pinceau sur les bords pour bien sceller et sur le dessus pour que le chausson soit bien doré.', 'Faire cuire environ 25 minutes à 220°C (thermostat 8).'], ['Râpe', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'boudin', 'confiserie', 'testées', 'très facile', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'boudin antillais', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Chausson de boudin antillais à la banane', 'moyen', 'beurre', 'quatre-épices', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:12:27.387666', [{'ingredient_id': '33f6fbd0-c243-4f75-b366-87f0944d483b', 'quantite': '6'}, {'ingredient_id': '4bc44070-c75b-471f-8827-65a038204179', 'quantite': '2'}, {'ingredient_id': 'e250f6d2-6333-433a-8463-449463184624', 'quantite': '1'}, {'ingredient_id': '634bba8a-6d51-411c-81cd-bb492465051b', 'quantite': '1'}, {'ingredient_id': '2f176bfc-14ac-4645-80ad-ac62e6ded7f1', 'quantite': '1'}, {'ingredient_id': '925029fe-51af-4d92-a898-3c8291f03418', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (537860, 'Banana bread au Thermomix', 'banane, farine, sucre roux, beurre doux, oeuf, levure chimique, extrait de vanille liquide, cannelle', '15 min', ['Coupez le beurre en morceaux et mettez-le dans le bol du Thermomix. Mettez à cuire à 80°C pendant 5 minutes en vitesse 1. Cassez les œufs dans le bol et versez le sucre. Mélangez 15 secondes en vitesse 3.', 'Mélangez la farine et la levure. Passez-les au tamis avant de les ajouter dans la cuve du Thermomix. Ajoutez l’extrait de vanille ainsi que la cannelle. Mélangez en vitesse 5 durant 1 minute.', 'Ouvrez les bananes et ajoutez la chair dans le bol du Thermomix. Mixez à 1 minute en vitesse 6. Votre appareil doit être bien homogène. Transvasez-le en raclant bien la cuve dans un moule à cake chemisé d’un peu beurre et de sucre roux.', 'Faites cuire 50 minutes dans un four préalablement préchauffé à 180 °C. Laissez refroidir avant de couper en tranches et de déguster.'], ['Spatule', 'Passoire', 'Râpe', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'extrait de vanille liquide', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'Banana bread au Thermomix', 'dessert', 'plat de résistance', 'beurre doux', 'cannelle', 'cocktail', 'sucre roux'], 'Dessert', dd203e43-1007-44d2-9a85-09c8363d1742, '2025-09-26T17:12:31.917283', [{'ingredient_id': '2c5233bc-fc1b-4667-9a67-17a03c4eaf70', 'quantite': '2'}, {'ingredient_id': '8620245f-62e7-4d87-9d3b-11e369d75260', 'quantite': '130 g'}, {'ingredient_id': '28535e0e-5db0-4f4c-9fa4-7a89ba17788e', 'quantite': '100 g'}, {'ingredient_id': '50c67b23-f102-4814-bc10-6514714ffe64', 'quantite': '80 g'}, {'ingredient_id': '332999de-5f14-4612-976c-0f393020d726', 'quantite': '2'}, {'ingredient_id': 'b4ffc520-b155-4637-aa80-7051b07e87b7', 'quantite': ''}, {'ingredient_id': 'c8ff08ef-83bd-4473-9415-e5dd206f61e0', 'quantite': '1 cuillères'}, {'ingredient_id': 'db0a67e9-fbf0-4392-953b-e990f3e24157', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52358, 'Curry de boeuf aux fruits', 'boeuf, oignon, ail, pomme, banane, citron, bouillon de boeuf, curry, cumin, poivre, sel, huile d''olive', '30 min', ['Coupez la viande en dés, la banane en rondelles, la pomme épluchée en dés et arrosez de jus de citron.', 'Emincez l''oignon et l''ail et faire fondre le cube de bouillon dans de l''eau bouillante.', 'Dans une cocotte faire revenir les morceaux de boeuf.', 'Lorsqu''ils ont pris de la couleur, les retirer et les mettre de côté.', 'Remettre de l''huile dans la cocotte puis faire revenir l''oignon, l''ail, les morceaux de banane et de pomme.', 'Laisser cuire 5 minutes, ajouter le boeuf, le curry, le cumin, la cannelle et 30 cl de bouillon environ.', 'Laissez cuire 2h30 à feu doux en ajoutant en cours de cuisson de l''eau ou du bouillon s''il en reste.', 'Servir avec un gratin de courgettes.'], ['Casserole', 'Passoire', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'boeuf', 'sel', 'confiserie', 'testées', 'cumin', 'facile', 'bon marché', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'bouillon de boeuf', 'oignon', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'pomme', 'citron', 'Curry de boeuf aux fruits', 'poivre', 'curry', 'viande à l''indienne', 'cocktail'], 'Plat principal', 2330946d-49e4-4bd2-a578-2608a2cf140e, '2025-09-26T17:12:35.569366', [{'ingredient_id': 'fb15bddc-2db5-40d2-98d7-8c74b315dafa', 'quantite': '800 g'}, {'ingredient_id': '05311709-0825-4fe1-8f5c-311796803bf6', 'quantite': '1'}, {'ingredient_id': 'cb4a577c-4226-4958-a661-6a9b7834fcb7', 'quantite': '1'}, {'ingredient_id': 'cc5d4be0-d3d5-43e5-a9ce-ad67bff7777e', 'quantite': '1'}, {'ingredient_id': '21de4b61-aa91-48fd-b754-36b1b3555ec8', 'quantite': '1'}, {'ingredient_id': 'c8e2516b-7bfc-4999-bb7e-11d1f6e462fd', 'quantite': '1'}, {'ingredient_id': '3c3d93c9-1bad-412c-aeb6-020870fba79e', 'quantite': '1'}, {'ingredient_id': '5504ac03-74a2-45b7-b75a-7961db5d40d4', 'quantite': '1'}, {'ingredient_id': 'db078c72-96fd-4b58-8e8c-104eaa54ed8c', 'quantite': ''}, {'ingredient_id': 'aa227d4a-c4bc-4525-9561-81fc90d33459', 'quantite': ''}, {'ingredient_id': '478e4875-d052-46fe-b8e0-07592b25668f', 'quantite': ''}, {'ingredient_id': 'ce13f149-ff70-4e5b-8157-78730a5a4cf8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14792, 'Bananes en robes des champs', 'banane, miel, chocolat noir, chocolat blanc', '25 min', ['Poser la banane sur une surface plate pour trouver le sens ou elle repose en équilibre.', 'Inciser le dessus de la banane sur la longueur (laisser tout de même quelques centimètres clos aux extrémités pour que la banane se tienne).', 'Extraire la pulpe du fruit, le réduire en purée à la fourchette.', 'Incorporer selon les goûts chocolat fondu, calvados (pour les parents), miel, crème fraîche, citron, etc.', 'Réintroduire le mélange obtenu dans la banane et faire chauffer au four.'], ['Fouet', 'Râpe', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'Bananes en robes des champs', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'chocolat blanc', 'cocktail'], 'Dessert', 78641e3e-e46a-405c-b71a-4c8c2c3afc9c, '2025-09-26T17:12:39.088156', [{'ingredient_id': 'd0faf65e-b248-4860-b5ef-42307a58f224', 'quantite': '6'}, {'ingredient_id': '934b7860-8c4f-4def-982c-88923511cedc', 'quantite': ''}, {'ingredient_id': '7e86ef56-c2a1-4dde-94da-837b394a4a8c', 'quantite': ''}, {'ingredient_id': '8aed9034-4d96-463a-950c-811e12e90258', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392267, 'Banana sprint', 'jus de bananes, sirop de citrons, oeuf', '0 min', ['Réalisez la recette "Banana sprint" au mixer.', 'Mélanger les ingrédients avec de la glace jusqu''à obtenir un mélange onctueux.', 'Servir dans un verre de type "tumbler".', 'Aucune décoration.'], ['Rouleau à pâtisserie', 'Spatule', 'Mixeur', 'Pince de cuisine'], ['', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'Banana sprint', 'facile', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'jus de bananes', 'sirop de citrons', 'cocktail'], 'Boisson', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T17:12:43.658094', [{'ingredient_id': '276886b4-4a68-44f2-b653-89ee2672a022', 'quantite': '10 cl'}, {'ingredient_id': 'f9382b68-c630-4df0-9101-293ed96ed5d9', 'quantite': '2 cl'}, {'ingredient_id': 'fe9e3821-c2b1-4c08-ba9f-f670554fee0f', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (212113, 'Crème aux cerises et aux mandarines', 'cerises, mandarine, banane, oeuf, lait, sucre, cannelle, maïzena, citron, sucre roux', '20 min', ['Battre les jaunes d´œufs et le sucre jusqu’à ce qu´ils blanchissent. Ajouter la maïzena et continuer à battre.', 'Faire chauffer le lait avec le bout de citron et la cannelle. Quand c´est bien chaud (sans bouillir), laisser de côté et laisser tiédir un peu.', 'Retirer la peau du citron et la cannelle.', 'Ajouter le mélange des œufs au lait et mélanger de nouveau. Faire chauffer doucement sans arrêter de mélanger jusqu’à épaississement. Retirer du feu.', 'Peler les fruits et couper en morceaux.', 'Disposer la moitié des fruits dans le fond des raviers (pouvant aller au four).', 'Recouvrir le tout de crème.', 'Décorer avec les fruits restants et saupoudrer de sucre roux.', 'Faire dorer quelques instants sous le gril et servir.'], ['Économe', 'Ouvre-boîte', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'maïzena', 'bon marché', 'mandarine', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'Crème aux cerises et aux mandarines', 'lait', 'sucre', 'cannelle', 'cocktail', 'sucre roux', 'cerises'], 'Dessert', 7dc811bc-14e5-459a-b205-0a479609e849, '2025-09-26T17:12:48.196892', [{'ingredient_id': 'd74bc250-ca28-4bc4-8462-dec51d0de9d8', 'quantite': '100 g'}, {'ingredient_id': '534773cb-0284-4a9d-8756-fb0766b30006', 'quantite': '2'}, {'ingredient_id': '8e0389e6-e4f9-4df5-9a62-5957f9f86b28', 'quantite': '1'}, {'ingredient_id': '7ee57bdd-1ccb-46c1-89ef-08d6b91399ca', 'quantite': '3'}, {'ingredient_id': 'e8fa83e2-9894-435e-858f-ae7e0d812b78', 'quantite': '25 cl'}, {'ingredient_id': 'e6208e3b-5118-46fc-99af-73b975b208a2', 'quantite': '50 g'}, {'ingredient_id': 'fe4c0434-2f9d-4855-bb05-082fc4d36ebb', 'quantite': '1'}, {'ingredient_id': '667e1d7c-df00-4de7-a543-7b875cf42b25', 'quantite': '15 g'}, {'ingredient_id': 'd495b781-07dd-4c9c-9f18-d0d21c7570cf', 'quantite': '1'}, {'ingredient_id': '32def350-523e-4c48-b28d-103275c181f5', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (47162, 'Verres aux deux chocolats', 'chocolat noir, chocolat blanc, beurre, oeuf, gâteaux, sucre, banane, pralin', '20 min', ['La mousse au chocolat noir :', 'Faire fondre le chocolat noir avec 20 g de beurre au micro-ondes, bien mélanger.', 'Dans un autre saladier, séparer le blanc des jaunes, puis incorporer 40 g de sucre au jaune d''œuf. Fouetter le tout, jusqu''à ce que le mélange blanchisse.', 'Incorporer la préparation au chocolat fondu.', 'Battre les deux blancs d''œuf en neige ferme, puis les incorporer délicatement au chocolat, en soulevant avec une cuillère.', 'Mettre à refroidir.', 'La mousse au chocolat blanc : ', 'Procéder de même, mais mettre seulement 20 g de sucre dans le mélange avec les jaunes d''œufs. Mettre à refroidir.', 'Le montage :', 'Emietter les gâteaux au fond des verres.', 'Disposer une couche de mousse au chocolat noir, ensuite 5 rondelles de banane, puis une couche de mousse au chocolat blanc.', 'Saupoudrer de pralin, et mettre au frais jusqu''à la dégustation.'], ['Mixeur', 'Planche à découper', 'Spatule', 'Économe', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Verres aux deux chocolats', 'facile', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'pralin', 'dessert', 'plat de résistance', 'chocolat noir', 'gâteaux', 'moyen', 'beurre', 'chocolat blanc', 'sucre', 'cocktail'], 'Dessert', fa78ac9a-dda6-4e9b-8e64-ff447a756995, '2025-09-26T17:12:51.806417', [{'ingredient_id': '1527b25a-fa9c-49c0-9123-eb19b4f87abe', 'quantite': '100 g'}, {'ingredient_id': '0f17ad73-c811-438c-b2e5-81601e340a71', 'quantite': '100 g'}, {'ingredient_id': '20a1a447-310f-4ea5-89d7-4c0f8510c143', 'quantite': '40 g'}, {'ingredient_id': '5a63f6ce-5726-467b-ac4b-cbe7f77076f0', 'quantite': '4'}, {'ingredient_id': 'b41d2989-2871-41a1-a607-d8eb452c93fb', 'quantite': '6'}, {'ingredient_id': 'e867ae3c-306f-4ca6-8598-6c7e65dca423', 'quantite': '60 g'}, {'ingredient_id': 'a9cead57-ab56-467b-9c84-68a5f3000d3a', 'quantite': '1'}, {'ingredient_id': '13fd7755-4c24-4e40-a6ba-37dc19c3550d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335672, 'Confiture kiwi, orange, pomme et banane', 'fruits, orange, miel, jus de citron, sucre', '15 min', ['Éplucher les fruits (enlever le cœur dur des kiwis), les couper en petits morceaux.', 'Couper quelques morceaux de peau d’orange en fines lamelles de 1 mm sur 2 cm de long (après avoir enlevé le blanc de la peau).', 'Dans un « fait tout » ; mettre un fond d’eau et les fruit ; écraser une première fois au presse-purée.', 'Faire bouillir, laisser cuire 30 à 40 min.', 'Ajouter le miel et le sucre. Laisser cuire à feu doux pendant (remuer régulièrement) 30 min / sucre à confiture ; 1 h  / sucre poudre. Écraser à nouveau ! ', 'Vérifier la cuisson en déposant un peu de confiture sur  une assiette.', 'Retirer du feu, mettre en pot avec une louche, fermer de suite les pots en fermant fort ; déposer à l’envers pendant quelques heures.'], ['Verre doseur', 'Couteau de chef'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'Confiture kiwi', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'pomme et banane', 'dessert', 'plat de résistance', 'jus de citron', 'orange', 'fruits', 'sucre', 'cocktail', 'confiture d''orange'], 'Confiserie', 3448144a-57ab-4c9b-a44a-1a5b0c0b49c2, '2025-09-26T17:12:55.371430', [{'ingredient_id': 'ce414547-2c1d-4ea5-b256-85f284338716', 'quantite': '2 kg'}, {'ingredient_id': '1f2ee273-750f-44a6-b11f-699995209657', 'quantite': '1'}, {'ingredient_id': 'ba087125-2cfe-4da1-98fa-0b7d591101b1', 'quantite': '2 cuillères'}, {'ingredient_id': '598cb8ee-3d27-43e8-8331-aa54164a9214', 'quantite': '15 cl'}, {'ingredient_id': 'f502bf33-fce7-44f4-aa2f-79c712c7060a', 'quantite': '1 kg'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42241, 'Le rêve du flamant rose', 'lait fermenté, banane, pêche, fraises, sucre, noisettes', '30 min', ['Laver et préparer les fruits.', 'Extraire le jus des fruits à l''aide d''une centrifugeuse (on peut broyer les fruits au robot, mais la boisson sera moins liquide).', 'Passer le gingembre au mixer.', 'Mélanger tous les ingrédients, et garder au frais quelques heures...', 'Idéal au goûter!'], ['Fouet', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'noisettes', 'cuisine', 'recettes', 'boisson', 'Le rêve du flamant rose', 'dessert', 'plat de résistance', 'pêche', 'sucre', 'cocktail', 'lait fermenté'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:12:58.911162', [{'ingredient_id': '60f99249-567f-4bc6-96dc-e616dc2f7ffd', 'quantite': '1 l'}, {'ingredient_id': 'bb3896a3-cc10-4732-84cb-03a99736caa1', 'quantite': '2'}, {'ingredient_id': 'd52ce634-860e-47fe-ab7f-948ebcc3b2ab', 'quantite': '3'}, {'ingredient_id': '2e4e7b71-8dc2-492f-a81b-abd6151c85d2', 'quantite': '250 g'}, {'ingredient_id': 'bdc2430b-45d3-4c8c-a6a2-94442fc19156', 'quantite': '50 g'}, {'ingredient_id': 'b0a4eacc-b42f-48ec-9807-1f96795e4778', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (339635, 'Cake chocolat-banane (vegan)', 'banane, sucre, sucre de canne, levure, sel, farine, huile de coco, huile, lait de soja, chocolat noir, cacao', '15 min', ['Ecraser les 2 bananes dans un saladier avec une fourchette.', 'Ajouter les sucres et mélanger. ', 'Faire fondre l''huile de coco et ajouter l''huile de maïs (ou ajouter 3-4 cuillère d''huile végétale).', 'Verser le sachet de poudre à lever et les carrés de chocolat fondue. ', 'Ajouter les 50 ml de lait végétale. ', 'Bien mélanger, ajouter la farine et le sel. ', 'Bien touiller et ajouter la poudre de cacao.', 'Cuisson à 200°C (thermostat 6-7) pendant 20 min.'], ['Poêle', 'Batteur électrique', 'Ouvre-boîte', 'Mixeur', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'cacao', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'sucre de canne', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'Cake chocolat-banane (vegan)', 'chocolat noir', 'lait de soja', 'huile de coco', 'sucre', 'cocktail'], 'Dessert', 0b9f87d6-e332-4ad4-be9e-976420a7d9d2, '2025-09-26T17:13:03.593298', [{'ingredient_id': 'a85df1fa-e92f-4297-95d8-cfc7504a2718', 'quantite': '2'}, {'ingredient_id': 'f8c829df-3ab6-41e3-8565-9e8586e7d6ad', 'quantite': '100 g'}, {'ingredient_id': 'b9a27975-ba41-4689-a1db-b09d88f9e850', 'quantite': '50 g'}, {'ingredient_id': 'bfa99341-3d39-4f64-a072-7c77b517533d', 'quantite': '1'}, {'ingredient_id': '372b07d9-499a-4e68-8437-e30024f83087', 'quantite': '1'}, {'ingredient_id': '3a3767eb-3a78-45af-831c-baaf28d34551', 'quantite': '150 g'}, {'ingredient_id': '63330638-883d-498b-82b7-439d08a416eb', 'quantite': '3 cuillères'}, {'ingredient_id': '1d5ceca8-b857-4d87-be49-cd238f958b02', 'quantite': '1 cuillères'}, {'ingredient_id': 'baac591d-c250-4529-b153-75a82c6868af', 'quantite': '5 cl'}, {'ingredient_id': '0e279e9b-544d-4946-ba69-d3dde728dad2', 'quantite': '80 g'}, {'ingredient_id': '837c2782-4da1-47a5-b240-38b3f96b44c1', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52809, 'Fruits grillés à la plancha', 'banane, pomme, beurre, miel', '15 min', ['Rien de mieux que quelques fruits de saison grillés, pour terminer un repas à la plancha !', 'N''épluchez pas les fruits. Coupez les bananes en deux. Évidez le trognon des pommes et coupez-les en tranches d''1 cm d''épaisseur.', 'Avec un pinceau, badigeonnez les fruits de beurre fondu et faites-les cuire sur la plancha préchauffée à 180°C (th 6), côté chair pour les bananes. ', 'Retournez-les après 7-8 min, puis badigeonnez-les au pinceau avec du miel, laissez encore 3 min côté peau.', 'Pour les pommes, retournez_les après 5 min, laissez encore 5 min et après les avoir badigeonnées de miel au pinceau, faites-les caraméliser brièvement de chaque côté.', 'Servez chaud.'], ['Presse-agrumes', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Fruits grillés à la plancha', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'cocktail'], 'Dessert', e504e299-1554-4ba6-ae14-918d75039d2c, '2025-09-26T17:13:07.210807', [{'ingredient_id': '70cbbfdd-66a5-4ab2-a3d9-99fb6d3c7687', 'quantite': '2'}, {'ingredient_id': '43afa8f8-695a-43b1-9696-4f0b9ef61382', 'quantite': '2'}, {'ingredient_id': '03330e5c-ab5e-41ed-9bac-198242dc314c', 'quantite': '20 g'}, {'ingredient_id': '8a0405e0-426b-446d-bf7d-1e797c4ffb85', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (312023, 'Punch planteur fruité à la vanille', 'rhum, goyave, jus de banane, jus d''ananas, fruits, sucre de canne, ananas, citron vert, pomélo, vanille', '30 min', ['Commencez par récupérer des zestes de citron et de pomélos.', 'Découpez l''ananas en morceaux et lever les suprêmes du pomélos (retirez la peau et découper en morceaux).', 'Mélangez les jus et le rhum dans un grand saladier avec le jus des citrons.', 'Récupérer les grains de vanille avec un couteau et ajoutez-les dans le saladier avec les gousses.', 'Ajouter les morceaux de fruits et laissez macérer quelques jours au réfrigérateur.', 'Dégustez !'], ['Louche', 'Rouleau à pâtisserie', 'Ouvre-boîte'], ['entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'goyave', 'facile', 'rapide', 'pomélo', 'plat', 'jus de banane', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'vanille', 'punch', 'dessert', 'Punch planteur fruité à la vanille', 'jus d''ananas', 'plat de résistance', 'moyen', 'ananas', 'citron vert', 'fruits', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:13:11.705642', [{'ingredient_id': 'ef045e1f-f25f-451c-802f-0ae5ad2e0e05', 'quantite': '1 l'}, {'ingredient_id': 'ac0c16d3-08de-4ee1-990c-46e408399a73', 'quantite': '75 cl'}, {'ingredient_id': 'e55e8ab0-163e-41ab-8721-5013f4371d10', 'quantite': '75 cl'}, {'ingredient_id': '58674100-8b84-4819-a899-6f40490f5db9', 'quantite': '75 cl'}, {'ingredient_id': '36fa90d1-2af4-462d-ab41-b797564efbc2', 'quantite': '1 l'}, {'ingredient_id': 'b5bf832b-a7db-4ed6-9d61-7d656ab3f13a', 'quantite': '25 cl'}, {'ingredient_id': 'bb0bfabd-6654-4650-b278-24d4937aff1d', 'quantite': ''}, {'ingredient_id': 'e4afa6f4-8586-4636-b7d3-e6d9c78cad4d', 'quantite': '2'}, {'ingredient_id': 'd5d4462f-6b10-46d7-a1a8-398a7ccf82cc', 'quantite': '1'}, {'ingredient_id': 'f145824e-a412-4efa-91bf-d2de9eee150d', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (533165, 'Gaufres feuilletées chocolat-banane', 'pâte feuilletée, chocolat, banane', '9 min', ['Découper 8 ronds de pâte feuilletée de même taille.', 'Détailler 100 g de chocolat en pépites et découper les bananes en petits dés.', 'Sur 4 ronds de pâte, répartir les pépites de chocolat et les bananes. Recouvrir d''un autre rond de pâte et souder les bords (en humidifiant légèrement).', 'Cuire au gaufrier.', 'Faire fondre le reste du chocolat et plonger 1/3 de la gaufre dans le chocolat fondu.'], ['Passoire', 'Verre doseur', 'Mixeur', 'Râpe', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Gaufres feuilletées chocolat-banane', 'dessert', 'plat de résistance', 'pâte feuilletée', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T17:13:16.241566', [{'ingredient_id': 'e11b4696-c005-41f3-9d96-a1a57a0f4142', 'quantite': '2'}, {'ingredient_id': '1d3c0271-db35-4734-a4e1-8747ed97430d', 'quantite': '300 g'}, {'ingredient_id': 'a68e992f-2354-45cf-b2c9-6ccbc2c7d90a', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56937, 'Riz créole (sucré-salé)', 'riz, oeuf, lard, poivron rouge, banane, ananas, oignon, beurre', '15 min', ['Faire cuire le riz à l''eau bouillante salée.', 'Faire revenir dans une sauteuse avec la moitié du beurre : le poivron coupé en lanières, l''ananas, l''oignon et le lard coupés en morceaux.', 'Dans une poêle à part, préparer avec les oeufs une omelette très mince et la découper en lamelles.', 'Les ajouter dans la sauteuse ainsi que le riz. ', 'Dans le beurre restant, faire dorer les bananes coupées en deux dans le sens de la longueur.', 'Servir le riz sur un plat en décorant avec les bananes.'], ['Râpe', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Riz créole (sucré-salé)', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'poivron rouge', 'recettes', 'oignon', 'boisson', 'lard', 'plat de riz', 'dessert', 'plat de résistance', 'riz', 'beurre', 'ananas', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:13:20.905594', [{'ingredient_id': 'beffca29-4c00-4230-b7ab-1b648770b5b2', 'quantite': '200 g'}, {'ingredient_id': '2f33f240-a72d-4a68-b38a-ed60f16e9df1', 'quantite': '2'}, {'ingredient_id': 'e9cadb46-aeeb-43d8-952f-07b103cd2402', 'quantite': '200 g'}, {'ingredient_id': '44ff1118-3350-45a7-8ade-db90a715c2b0', 'quantite': '1'}, {'ingredient_id': '686277b4-d753-4ac5-8fb1-ea6baebce251', 'quantite': '2'}, {'ingredient_id': '3951248a-0cfc-4180-89ab-5c214d0e3674', 'quantite': '1'}, {'ingredient_id': 'a134187f-12c3-4999-8165-11ea1077f189', 'quantite': '1'}, {'ingredient_id': '551fd79e-b5cc-42ca-b047-7a146f6cfdb7', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (323730, 'Cigares Coco, Banane et Chocolat', 'brick, banane, chocolat noir, noix de coco rapée, huile', '0 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Peler la banane et la couper en dés moyens. Réserver.', 'Commencer par mettre à plat la feuille de brick.', 'Couper la feuille de brick en 4. On obtient alors 4 « triangles ». Faire de même avec l’autre feuille de brick. On obtient en tout 8 « triangles ».', 'Disposer quelques dés de banane. Ajouter des pépites de chocolat et finir par une belle pincée de noix de coco râpée.', 'Rabattre la pointe de la feuille de brick sur la farce.', 'Rabattre les côtés de la feuille de brick puis rouler jusqu’au bout pour former le cigare. Afin de bien fixer la soudure, avec un pinceau et un peu d’eau, badigeonner le bord haut de la feuille de brick. Cela sert en général assez bien de colle et évite d’utiliser un blanc d’œuf.', 'Badigeonner d’un peu d’huile neutre au pinceau (un peu hein) et enfourner pour au moins 15 min à 180°C (thermostat 6).', 'Déguster tiède.'], ['Fouet', 'Moule à tarte', 'Spatule', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'huile', 'Banane et Chocolat', 'noix de coco rapée', 'dessert', 'plat de résistance', 'chocolat noir', 'cocktail', 'Cigares Coco'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:13:25.433347', [{'ingredient_id': 'b783f75e-a297-49cf-9085-20956acbaeaf', 'quantite': '2'}, {'ingredient_id': 'bcad3376-987a-4b59-ac4f-91691f34992d', 'quantite': '1'}, {'ingredient_id': '67ae71f8-0b94-41f2-9ef5-220c8a9912b7', 'quantite': '100 g'}, {'ingredient_id': 'dfc62f2e-2365-4f03-9983-04bc19f2548e', 'quantite': '2 cuillères'}, {'ingredient_id': '4b763a1b-cd74-44e9-9462-482d4b1bdf6b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (533846, 'Pancakes avec de la banane et sans œufs', 'sucre, levure chimique, farine, banane, lait, beurre', '10 min', ['Mélanger le sucre, la farine et la levure dans un premier saladier ', 'Écraser la banane à l''aide d''un fouet afin d''en faire une purée (une banane remplace 2 œufs)', 'Mélanger le beurre et la banane dans un deuxième saladier ', 'Ajouter le lait, la pâte doit être plutôt liquide ', 'Tout mélanger ensemble ', 'Se munir d''une (ou plusieurs) poêle(s) et faire les pancakes, à feu doux, tourner le quand on peut apercevoir des bulles '], ['Casserole', 'Ouvre-boîte', 'Passoire', 'Rouleau à pâtisserie', 'Moule à tarte'], ['', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'rapide', 'Pancakes avec de la banane et sans œufs', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', 0be9e233-eee9-425b-9d5b-f3fc36aae5a4, '2025-09-26T17:13:28.868664', [{'ingredient_id': '9883a6e2-9587-473d-97df-59e1f60f876e', 'quantite': '30 g'}, {'ingredient_id': 'd84fddd0-2d4b-4fdd-a76b-2404977e5231', 'quantite': '1'}, {'ingredient_id': '3127cd8b-7c10-4ec2-b4f1-17a1bd7e8519', 'quantite': '250 g'}, {'ingredient_id': '9dd5212c-459e-4683-afe4-876e601b4441', 'quantite': '1'}, {'ingredient_id': 'c6ff6cb1-900d-4e18-8a78-f248558597fe', 'quantite': '30 cl'}, {'ingredient_id': '02a497a3-1c60-47ab-97aa-babee0db98ac', 'quantite': '65 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62487, 'Tiramisù choco banane', 'banane, sucre en poudre, citron, crème fraîche, lait, boudoir, chocolat chaud, chocolat noir, lait, cacao', '30 min', ['Pour la crème banane :', 'Éplucher les bananes et les mixer (on peut les écraser si l''on a pas de mixeur). Ajouter le sucre et le jus de citron et mélanger. ', 'Ajouter le lait et la crème fraîche, mixer ou battre au fouet.', 'Pour les biscuits, les tremper dans les bols de chocolat et disposer dans le plat.', 'Recouvrir d''une couche de crème à la banane, puis d''une autre couche de biscuits imbibés.', 'Faire fondre une tablette de chocolat avec du lait, en recouvrir les biscuit puis remettre une couche de crème et saupoudrer de cacao. ', 'Mettre au frais.'], ['Passoire', 'Casserole', 'Planche à découper', 'Presse-agrumes', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'tiramisu', 'citron', 'lait', 'Tiramisù choco banane', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:13:33.388022', [{'ingredient_id': '9b7516fb-4106-4ab0-ad27-5ab4d4f1ab1f', 'quantite': '3'}, {'ingredient_id': 'a1b06fe2-768c-4ab0-8fe0-c61ade7fa5c4', 'quantite': '1 cuillères'}, {'ingredient_id': '829aceee-eef1-4f0d-9c00-5c46bfce6040', 'quantite': ''}, {'ingredient_id': '4cbf26ab-41e6-40a8-bca3-706f1a090241', 'quantite': '150 g'}, {'ingredient_id': 'bce42df6-32ad-4689-b050-b60e138721dd', 'quantite': '1 cuillères'}, {'ingredient_id': 'd84baea5-5421-41ba-8552-24e4f627d8b0', 'quantite': '500 g'}, {'ingredient_id': '38db915e-c8ff-443e-bb25-e1c6df3f54ef', 'quantite': '2'}, {'ingredient_id': '2eba6be1-a160-42bd-a065-a087df1f2baa', 'quantite': '200 g'}, {'ingredient_id': '7bb897fd-6ad1-4924-bdf5-a8418af46c3d', 'quantite': ''}, {'ingredient_id': '6eefc095-42ca-4bc3-a5f7-8ee988421b5d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13575, 'Cigares de banane caramélisés', 'banane, beurre demi-sel, jus de citron, sucre en poudre, sucre glace, Liqueur, brick, chocolat noir, crème fraîche', '10 min', ['Mettre 50 g de beurre à chauffer dans une grande poêle.', 'Quand le beurre devient noisette, y poser les bananes épluchées, coupées en deux dans le sens de la longueur. Les laisser dorer en les retournant.', 'Au cours de la cuisson, les saupoudrer de 50 g de sucre. Quand les fruits sont bien dorés, les arroser du citron et du rhum.', 'Laisser frémir pendant 2 minutes et éteindre.', 'Couper les feuilles de brick en deux, les badigeonner avec le reste du beurre fondu. Y déposer 1/2 banane cuite et un peu de la sauce confite. Rouler en cigare et fermer les extrémités (en papillotes) avec un morceau de ficelle à rôtir.', 'Poser les cigares sur une plaque à four, garnie d''une feuille de papier à pâtisserie. Les saupoudrer de la moitié du sucre glace et mettre pour 10 minutes à four chaud (thermostat 7). Ajouter le reste du sucre au bout de 5 minutes.', 'Sortir les cigares quand ils sont bien dorés.', 'Pendant ce temps, faire un coulis de chocolat avec le chocolat en petits morceaux, la crème et 1 cuillère à soupe d''eau.', 'Servir à l''assiette : 2 cigares (ne pas oublier d''enlever la ficelle) et sur le côté un peu du jus de banane, sans oublier le coulis de chocolat.'], ['Moule à tarte', 'Batteur électrique', 'Presse-agrumes', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'brick', 'cuisine', 'recettes', 'beurre demi-sel', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'jus de citron', 'Cigares de banane caramélisés', 'Liqueur', 'sucre glace', 'cocktail'], 'Dessert', af41765e-f864-4f6a-adbf-59c0b5326ce7, '2025-09-26T17:13:36.999338', [{'ingredient_id': '97dc6005-249a-4234-85c8-68d626d7d139', 'quantite': '4'}, {'ingredient_id': '111f4187-8f3a-4ed6-9be0-be243df8e475', 'quantite': '75 g'}, {'ingredient_id': '88182194-7bc5-40ee-afc0-42637b723708', 'quantite': '1'}, {'ingredient_id': 'dfc93e33-ea26-4b46-ba57-0714a0f591cb', 'quantite': '75 g'}, {'ingredient_id': 'aace77d1-8c1d-4af9-8298-76b1497d5798', 'quantite': '1 cuillères'}, {'ingredient_id': 'c39ea056-6392-4ac8-af3f-9bdccbb846ce', 'quantite': '1'}, {'ingredient_id': '6d03c75e-cf4c-4c12-a6b8-15741e2b919a', 'quantite': '4'}, {'ingredient_id': '3a9cf2c3-b50d-47f7-a39f-0385e3be4d6e', 'quantite': '100 g'}, {'ingredient_id': '078fe670-78b8-4b62-b08d-8e5c44c86c32', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (47685, 'Gâteau miam-miam', 'pomme, banane, copeaux de chocolat, farine, sucre en poudre, oeuf, levure chimique, huile, lait', '10 min', ['Dans un saladier, mélanger dans l''ordre : le lait, l''huile, les oeufs, le sucre, la levure, la farine. ', 'Beurrer et fariner un moule à manquer, y verser la pâte. Réserver.', 'Eplucher la pomme et la banane. Couper les fruits grossièrement, casser le chocolat en gros morceaux.', 'Mettre les fruits et le chocolat dans la pâte.', 'Enfourner pour 30 min, au four à 210°C (thermostat 7), surveiller le temps de la cuisson.'], ['Fouet', 'Rouleau à pâtisserie', 'Casserole', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'pomme', 'Gâteau miam-miam', 'copeaux de chocolat', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:13:40.769442', [{'ingredient_id': '7d14eabe-aedf-47ff-86e7-488101758322', 'quantite': '1'}, {'ingredient_id': '5ebec34e-48fa-48fb-ba41-93db870d58a4', 'quantite': '1'}, {'ingredient_id': '5b0f84b4-8333-4e50-9a11-4b9040769b83', 'quantite': '150 g'}, {'ingredient_id': '604afaeb-e938-41e4-aed0-284f86b45782', 'quantite': '200 g'}, {'ingredient_id': '4effe4a0-629d-4db6-b493-26f610d4524d', 'quantite': '150 g'}, {'ingredient_id': 'de0b325f-301e-4521-a43f-343a02f426de', 'quantite': '4'}, {'ingredient_id': '6357e1fb-dfc5-4045-929e-bf7f6ee42f2a', 'quantite': '1'}, {'ingredient_id': '52867863-38d7-422c-bb02-65bb67cf9618', 'quantite': '4 cuillères'}, {'ingredient_id': 'de914fae-f9f3-4377-ac08-9511b865b7ce', 'quantite': '5 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (60428, 'Poulet coco, banane, tandoori', 'escalope de poulet, crème de coco, tandoori, banane, tomate, amandes effilées, ail, oignon, citronnelle', '10 min', ['Couper le poulet en morceaux. Le faire dorer dans une poële pendant 5 min.', 'Rajouter la moitié de la brique de crème de coco.', 'Rajouter la tomate coupée en morceau, la 1/2 banane en rondelles, les amandes effilées, l''ail et l''oignon hachés.', 'Ajouter la citronnelle et une cuillère à café de poudre tandoori (ou de curry).', 'Laisser mijoter 5 à 10 min.', 'Servir dans les assiettes accompagné de riz.', 'Dans la même poële (non lavée avec un petit reste de la préparation précédente), verser l''autre moitié de crème de coco.', 'Laisser chauffer 1 ou 2 min en remuant (en rajoutant éventuellement un peu de poudre tandoori) et verser sur la viande et sur le riz (cela évite que le riz ne soit trop sec).'], ['Poêle', 'Rouleau à pâtisserie', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Poulet coco', 'bon marché', 'curry de poulet', 'tomate', 'ail', 'rapide', 'plat', 'escalope de poulet', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'crème de coco', 'citronnelle', 'tandoori', 'dessert', 'plat de résistance', 'amandes effilées', 'cocktail'], 'Plat principal', 112d3881-92fa-45f7-bd72-f56965328465, '2025-09-26T17:13:44.537373', [{'ingredient_id': '9e0c5ad0-7441-4633-9e00-e9f86ad4145c', 'quantite': '2'}, {'ingredient_id': 'f084904b-1659-483b-b4ed-15c6dc4598d7', 'quantite': '20 cl'}, {'ingredient_id': '9910bcfa-8157-4b8d-955e-0f0c9e39ae3a', 'quantite': '1 cuillères'}, {'ingredient_id': '56f1bdcc-646c-4532-a027-9ec8c35730b9', 'quantite': ''}, {'ingredient_id': '6b9ac5fd-2f6c-4bf9-b503-1cf979c78675', 'quantite': '1'}, {'ingredient_id': 'b8d6ce44-64dc-427c-b15c-430b2dc9c046', 'quantite': '1 cuillères'}, {'ingredient_id': 'ca4170ca-bbd1-465d-b985-c6a9e27d3e5b', 'quantite': '1'}, {'ingredient_id': '929e384b-30cc-4249-90c1-2bc8efd72aed', 'quantite': '1'}, {'ingredient_id': '769ed921-a15e-4484-b3a6-2771456f3c3f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13305, 'Croque-monsieur à la banane', 'pain de mie, banane, cannelle, gingembre, sel, lait concentré sucré, beurre tendre', '30 min', ['Tartinez toutes les tranches de pain avec le beurre.', 'Soupoudrez les tranches de sucre. Retournez les tranches sur la table.', 'Emincez les bananes épluchées. Disposez grossièrement les rondelles de bananes sur 4 tranches seulement.', 'Saupoudrez sur les bananes la cannelle, le gingembre, très peu de sel et un peu de lait concentré.', 'Recouvrez les tranches garnies avec les tranches non garnies.', 'Cuire les croque-monsieurs dans un gaufrier pendant 5 mn. Sevir chaud.'], ['Presse-agrumes', 'Poêle', 'Verre doseur', 'Passoire'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'beurre tendre', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'lait concentré sucré', 'Croque-monsieur à la banane', 'boisson', 'dessert', 'plat de résistance', 'cannelle', 'cocktail', 'pain de mie'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:13:48.151179', [{'ingredient_id': '3be8ac05-7c76-4bde-b889-e49607942823', 'quantite': '8'}, {'ingredient_id': 'c2541e2d-012b-4e8e-bf59-1383fcbc6d12', 'quantite': '2'}, {'ingredient_id': '214e2446-73f6-404a-aa63-a27a42a16827', 'quantite': ''}, {'ingredient_id': 'ba2c7d23-8e1c-447b-b923-f239f0ae9fd7', 'quantite': ''}, {'ingredient_id': 'f47a7eb4-e3ec-4255-a6d6-3f5cacfe63bb', 'quantite': ''}, {'ingredient_id': 'ec0a7778-e50b-48bf-a7da-83a5e6ca6455', 'quantite': ''}, {'ingredient_id': '2978f301-47d6-4685-a822-99ac186b29d5', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57974, 'Taboulé épicé', 'semoule, concombre, poivron rouge, tomate, champignons de Paris, banane, chorizo, feta, olives noires, persil', '30 min', ['Préparer les poivrons : les faire griller sous le grill du four pendant une dizaine de minutes.', 'Quand la peau est noircie, les mettre dans un sac congélation et le fermer environ 5 minutes.', 'Débarrasser les poivrons de leur peau brûlée et les rincer à l’eau claire.', 'Ou plus simplement, ouvrir un sachet de poivrons grillés surgelé. ', 'Faire cuire la semoule comme indiqué sur l’emballage.', 'La laisser refroidir.', 'Emincer les légumes en très petits morceaux (concombre, tomates, poivrons, champignons, banane), faire de même avec le chorizo (les tous petits morceaux relèveront la recette sans l’alourdir) et la féta.', 'Ajouter les olives.', 'Mélanger le tout, assaisonner avec de l’huile d’olive, du jus de citron, des herbes, du sel (légèrement) et du poivre.', 'Servir frais, décoré de rondelles de chorizo et de quelques olives noires supplémentaires.'], ['Batteur électrique', 'Pince de cuisine', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'olives noires', 'confiserie', 'testées', 'Taboulé épicé', 'facile', 'semoule', 'tomate', 'Taboulé', 'rapide', 'plat', 'recette', 'cuisine', 'poivron rouge', 'recettes', 'boisson', 'feta', 'dessert', 'persil', 'plat de résistance', 'chorizo', 'moyen', 'champignons de Paris', 'concombre', 'cocktail'], 'Accompagnement', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:13:52.682847', [{'ingredient_id': '3833b3a6-0d1c-4d80-b911-0d6df4242503', 'quantite': '1'}, {'ingredient_id': '8b7764c5-d76b-4483-bc2e-82b5f72a18a3', 'quantite': '1'}, {'ingredient_id': 'f64b9795-6017-4a27-b9d8-2b03c21ea6f7', 'quantite': '2'}, {'ingredient_id': '90289a9c-5b0d-44bf-93ac-78ef8e71e9ef', 'quantite': '4'}, {'ingredient_id': '48e5694a-88e9-4f12-a014-7630da34b922', 'quantite': '20'}, {'ingredient_id': 'a49f0b87-0ddd-49cc-bf2b-018182f4de24', 'quantite': '1'}, {'ingredient_id': '46609683-01bd-4148-9227-2709d2b21ed9', 'quantite': '1'}, {'ingredient_id': '1515c609-585d-4b8d-87d2-5711855aaf6a', 'quantite': '200 g'}, {'ingredient_id': '0aed2f09-bd57-44fb-a94a-ecc98f62dd0d', 'quantite': '30'}, {'ingredient_id': '02b2e98d-5c04-44ec-af8e-92e4859f30fc', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (221860, 'Punch ti bon', 'rhum, rhum vieux, poire, jus d''orange, jus de banane, muscade, clou de girofle, cannelle, vanille', '15 min', ['Dans un récipient de 5 L qui se ferme mettre :', 'les jus de fruits, le rhum (blanc/ambré), ajouter la noix de muscade râpée (1 bonne cuillère à café) ainsi que les clous de girofle et la cannelle.', 'Fendre délicatement la vanille sans l''ouvrir en deux avant de l''ajouter.', 'Laissez reposer au minimum 3 jours.', 'Se garde très bien sur une fenêtre/balcon.', 'Se bonifie avec le temps. Il est tout à fait possible de multiplier les quantités pour en avoir toute une année.', 'Se boit frais.'], ['Râpe', 'Planche à découper', 'Ouvre-boîte'], ['entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'rhum vieux', 'testées', 'muscade', 'poire', 'Punch ti bon', 'facile', 'rapide', 'plat', 'jus de banane', 'recette', 'cuisine', 'recettes', 'boisson', 'clou de girofle', 'vanille', 'punch', 'dessert', 'plat de résistance', 'moyen', 'jus d''orange', 'cannelle', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:13:57.144984', [{'ingredient_id': 'aea91d53-2593-47d0-8006-6ce8f1991d15', 'quantite': '50 cl'}, {'ingredient_id': 'cc62283b-d4cf-4c28-8680-e46cf080710c', 'quantite': '70 cl'}, {'ingredient_id': 'f137a4c3-2872-40f0-bc20-466ac363060b', 'quantite': '1 l'}, {'ingredient_id': '81b55da5-ff03-41f2-b2a8-09ca1947bc8a', 'quantite': '1 l'}, {'ingredient_id': 'e6ad1a52-8858-4753-9c7a-4f84899bd39f', 'quantite': '1 l'}, {'ingredient_id': '3e8ec344-31a1-4bc3-b3f4-863bffd880ee', 'quantite': ''}, {'ingredient_id': 'a74d6a83-0885-4d13-b6c2-a6711e6c7fa9', 'quantite': '4'}, {'ingredient_id': '27bc046f-e43e-47f0-a79b-2c04757adfb5', 'quantite': '1'}, {'ingredient_id': '50ab7f26-7b31-4d45-a904-32a6c4642dc5', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (80061, 'SALADE DE FRUITS AU CHOCOLAT BLANC', 'pêche, pomme, banane, framboises, sirop de fraises, chocolat blanc, crème liquide', '15 min', ['Eplucher et couper les fruits en morceaux, les mélanger, et les répartir dans des coupes individuelles. ', 'Verser sur chaque coupe 1 cuillère à soupe de sirop de fraise. ', 'Réserver les coupes au réfrigérateur. ', 'Au moment de servir, mettre la crème liquide dans une casserole, la porter à ébullition et la retirer du feu. ', 'Y casser le chocolat blanc et mélanger jusqu''à ce qu''il ait fondu. ', 'Verser le mélange chocolat-crème tiède sur les coupes de fruits frais et servir aussitôt.'], ['Rouleau à pâtisserie', 'Râpe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'sirop de fraises', 'très facile', 'framboises', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'pomme', 'chocolat blanc', 'pêche', 'SALADE DE FRUITS AU CHOCOLAT BLANC', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:14:00.846958', [{'ingredient_id': 'cec616ea-74de-4318-b6d0-4c053377193c', 'quantite': '4'}, {'ingredient_id': '98cfceb2-9968-4183-8cd3-1fc4ac97e06d', 'quantite': '2'}, {'ingredient_id': '91eba6a3-b55c-4365-844c-ac84e4e4c3c1', 'quantite': '2'}, {'ingredient_id': 'd54056c1-7515-427a-923d-5f6948cf14ac', 'quantite': '200 g'}, {'ingredient_id': '44964f5f-a9bd-49cb-ad1d-97f34e4fac2c', 'quantite': '4 cuillères'}, {'ingredient_id': '7013b270-7f42-40ef-bd79-13fd540bfc2f', 'quantite': '1'}, {'ingredient_id': 'd2e6c3dc-ddcb-43b2-b47c-fb1de07d7b55', 'quantite': '25 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (309082, 'Milk-Shake Pomme-Banane-Cannelle', 'pomme, banane, cannelle, sucre, lait, glaçons', '15 min', ['Éplucher la pomme. ', 'Couper la pomme et la banane en petits morceaux. ', 'Mettre les morceaux dans le Blender (ou mixeur), ajouter le lait, puis mixer.', 'Ajouter une à deux pincée de cannelle (ajuster la quantité selon le goût) et le sucre, mixer à nouveau.', 'Ajouter les glaçons, mixer.', 'Voilà, c''est prêt.'], ['Spatule', 'Batteur électrique', 'Rouleau à pâtisserie', 'Pince de cuisine', 'Passoire'], ['', 'entrée', 'banane', 'Milk-Shake Pomme-Banane-Cannelle', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'glaçons', 'cannelle', 'sucre', 'lait', 'cocktail'], 'Boisson', 22e88fde-7417-427a-bcb8-e0617b47c2e2, '2025-09-26T17:14:05.617656', [{'ingredient_id': 'ef929e64-f216-41a1-8f90-652e44c6fa1d', 'quantite': '1'}, {'ingredient_id': 'd0a9d457-f49c-4bef-bd03-528f20741914', 'quantite': '1'}, {'ingredient_id': 'a1fa2aae-68da-4137-8906-fcfb9b87ed73', 'quantite': ''}, {'ingredient_id': '40d80ff5-7900-47ac-9ae0-ecfe8310aea5', 'quantite': '25 g'}, {'ingredient_id': 'ee3cbb9c-d4c5-4e3b-b9a6-47502d5ae9ab', 'quantite': '50 cl'}, {'ingredient_id': '87e270e3-6e28-475a-8e88-f809b9f54e51', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42323, 'velouté de potimarron exotique', 'potimarron, banane, cardamome, gingembre, cannelle, poivre, sel, eau, lait de coco, noix de coco', '10 min', ['Couper le potimarron en cubes.', 'Dans une casserole mettre les cubes de potimarron, les rondelles de bananes, verser l''eau, le lait, ajouter les épices.', 'Porter à ébullition.', 'Couvrir et laisser mijoter à feu doux environ 20 min jusqu''à ce que le potimarron soit tendre.', 'Mixer et servir très chaud.'], ['Râpe', 'Tire-bouchon', 'Moule à tarte', 'Couteau de chef'], ['gingembre', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'eau', 'testées', 'très facile', 'cardamome', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'soupe', 'dessert', 'plat de résistance', 'potimarron', 'moyen', 'velouté de potimarron exotique', 'cannelle', 'poivre', 'noix de coco', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:14:09.190346', [{'ingredient_id': '9f4b0fdf-9afd-43ea-9ada-d3623dba0311', 'quantite': '1'}, {'ingredient_id': '2a9d933d-39ef-41ac-89a7-b16acfed382e', 'quantite': '1'}, {'ingredient_id': '69c22707-5503-4c40-9d7f-1366eeba6f7f', 'quantite': '3'}, {'ingredient_id': 'c05199ea-bfcc-43d8-ba18-ce665cdf40b1', 'quantite': '2 cuillères'}, {'ingredient_id': '81febf8d-ff67-4912-8364-b2d0373e1611', 'quantite': '2 cuillères'}, {'ingredient_id': '08926261-613a-4668-bd23-6b6ab6357838', 'quantite': ''}, {'ingredient_id': 'f1ed8329-670e-4be1-9fb7-05513bdafd5b', 'quantite': ''}, {'ingredient_id': '0d6517b8-ed55-422c-8bce-1a7b373dc26b', 'quantite': ''}, {'ingredient_id': '63052822-527f-4067-808a-1e330193d9c2', 'quantite': '20 cl'}, {'ingredient_id': '57dcaa55-e603-48b5-9dad-2a1001100311', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (83488, 'Base pour muffins sans matières grasses', 'muesli, farine, levure, sucre vanillé, compote, lait, oeuf, sucre, pomme, banane, raisins secs, pruneau, cannelle, chocolat', '10 min', ['Mélangez la farine, les céréales, la levure, le sucre ,la compote,  ajoutez l''œuf, le lait tiédi et les fruits que vous désirez.', 'Mélangez bien et répartissez dans des moules à muffins.', 'Cuire à 190°C (thermostat6) pendant 25 à 30 minutes.'], ['Louche', 'Batteur électrique', 'Balance de cuisine'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'muesli', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'compote', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'muffin', 'lait', 'sucre', 'Base pour muffins sans matières grasses', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:14:12.854827', [{'ingredient_id': 'd8b058f6-023c-4376-b3ac-65e51074e09d', 'quantite': '120 g'}, {'ingredient_id': '3967bfe8-a6e1-4985-92c1-f49649a2d1a4', 'quantite': '80 g'}, {'ingredient_id': '7489dd88-b18e-43b9-ac95-a8b38bb7b9df', 'quantite': ''}, {'ingredient_id': '362c9013-c126-4f47-b3bb-96dc7264400b', 'quantite': '1'}, {'ingredient_id': '14383226-e456-47cd-b92a-594409623df7', 'quantite': '125 g'}, {'ingredient_id': '9b75fd6d-ea4f-4f14-a6ba-5eddb62196e2', 'quantite': '25 cl'}, {'ingredient_id': '002ca1f8-a4a9-48d5-a1cd-6d422b3d782e', 'quantite': '1'}, {'ingredient_id': '7f706ccd-7a38-4aa9-bd9c-aae3333338c7', 'quantite': '5 cuillères'}, {'ingredient_id': '22c0f1ac-6727-4b5d-a344-1dcf33c21b82', 'quantite': '2'}, {'ingredient_id': 'b529d13c-66bd-44d3-8100-fc06be7cbd4b', 'quantite': '2'}, {'ingredient_id': 'addc2b73-9f32-4656-9526-bd509073457f', 'quantite': '50 g'}, {'ingredient_id': '930df33c-4e67-4150-ac20-4f16ceef913a', 'quantite': '12'}, {'ingredient_id': '6d788c5f-7fca-4c6a-9148-5efeadaff63e', 'quantite': ''}, {'ingredient_id': 'f3559f55-3ef5-45c8-87f9-43f6bcffddec', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58182, 'Flan banane sans lait', 'banane, oeuf, yaourt, sucre complet, agar-agar', '10 min', ['Mélanger les oeufs et le sucres dans un plat à soufflet.', 'Ajouter les bananes coupées en rondelles, le yaourt et (une pincée d''Agar-agar si vous en avez).', 'Mixer le tout, enfournez 40 mn à 180°C.', 'Le flan doit être bien ferme et doré sur le dessus.', 'Cette recette est un véritable succès, elle m''est venue en faisant un cake à la banane quand j''ai mixé les bananes avec les oeufs. Nous sommes intolérants au PLV, elle est donc parfaite pour les gourmands ne supportant pas le lait de vache.'], ['Planche à découper', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'agar-agar', 'très facile', 'bon marché', 'oeuf', 'plat', 'Flan banane sans lait', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre complet', 'flan', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:14:16.327499', [{'ingredient_id': '75f7270d-5fac-4310-b22a-0b004629dd17', 'quantite': '4'}, {'ingredient_id': 'bde87d2f-b9ba-4ede-8571-7e50adc0b2dc', 'quantite': '4'}, {'ingredient_id': 'cd98349e-5ac0-455d-a104-1c5ad4a8c5f0', 'quantite': '1'}, {'ingredient_id': '6de48ad3-2b24-4ab9-a83d-54a26b1f7f87', 'quantite': '4 cuillères'}, {'ingredient_id': '94f5ae9c-9ff0-4def-b1b6-5c1c53a7b8a6', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (49173, 'Boeuf  sauce cacahuète/ plantain', 'arachide, tomate, boeuf, oignon, ail, céleri, huile, sel, cube de bouillon, banane plantain', '20 min', ['Dans un premier temps, nettoyer, découper (en morceaux) et faire cuire la viande dans une cocotte.', 'Pendant ce temps, ôter les pellicules recouvrant les arachides grillées, (elles doivent être brunes).', 'Les écraser pour obtenir une pâte lourde et homogène.', 'Découper et écraser les tomates, un oignon et 2 gousses d''ail dans un bol mixeur.', 'Lorsque la viande est cuite, délayer la pâte d''arachide obtenue dans un peu d''eau tiède pour qu''elle ne fasse pas de grumeaux après.', 'Faire chauffer une cocotte  avec un peu d''huile, y mettre l''oignon préalablement découpé, ainsi que le reste d''ail.', 'Lorsque les oignons sont translucides, y ajouter 2 cubes d''assaisonnement émiéttés, la tomate écrasée, le céleri émincé, laissez cuire, et 15 min plus tard, ajouter au fur et à mesure que la sauce s''épaissit, la pâte d''arachide, et la viande.', 'Pendant ce temps, faire chauffer l’eau dans une cocotte et y mettre les bananes plantains épluchées  avec les 2 cubes de bouillon restant (le niveau de l''eau doit légèrement dépasser celui des plantains).', 'Laisser cuire à feu doux le tout pendant 15 min encore et rajouter le fond de votre viande.', 'Remuer pour que la sauce ne colle pas dans le fond.', 'Laisser mijoter 10 min, goûter et rectifier l''assaisonnement s''il y a lieu.', 'Servir avec du plantain.'], ['Casserole', 'Planche à découper', 'Fouet', 'Spatule'], ['', 'Boeuf  sauce cacahuète/ plantain', 'entrée', 'recettes de cuisine', 'boeuf', 'sel', 'confiserie', 'testées', 'tomate', 'ail', 'plat', 'moyenne', 'recette', 'cube de bouillon', 'cuisine', 'arachide', 'recettes', 'oignon', 'boisson', 'huile', 'dessert', 'plat de résistance', 'banane plantain', 'moyen', 'cocktail', 'céleri'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:14:19.984748', [{'ingredient_id': 'ad53f600-8afa-4940-a867-af9cd93226b4', 'quantite': '350 g'}, {'ingredient_id': 'cab6973c-8168-44f5-9f43-673db7a86c1c', 'quantite': '5'}, {'ingredient_id': '8582114e-8be7-490b-9a85-47a756ba8807', 'quantite': '1 kg'}, {'ingredient_id': '3d5faf7a-400d-4fa6-a087-ea9599d6084b', 'quantite': '2'}, {'ingredient_id': 'fa1d3f31-330b-45c1-8e0d-1c12ea9a9186', 'quantite': '4'}, {'ingredient_id': 'a54def60-94eb-4acb-ad81-425d4edba27d', 'quantite': '1'}, {'ingredient_id': '79a727ba-2382-46b0-a167-a757b952cb0f', 'quantite': ''}, {'ingredient_id': '1b5996d5-f735-4d80-bbd9-57bd6ec69f8e', 'quantite': ''}, {'ingredient_id': '9cb3c35a-9d83-49b3-a50f-123320e9276b', 'quantite': '4'}, {'ingredient_id': 'dfdc4c79-cec9-4b68-9ef1-1f26250bd63b', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62631, 'Salade de mangue et banane au lait de coco', 'mangue, banane, brique, sucre de canne, rhum', '5 min', ['Coupez la mangue et la banane en dés.', 'Versez le lait de coco dans un petit saladier ainsi que le rhum et le sucre. Mélangez et versez les fruits coupés.', 'Réservez au frais pendant 1h en mélangeant de temps en temps puis servez dans des coupelles en ayant saupoudré de noix de coco râpée.', 'Bonne dégustation! ;)'], ['Batteur électrique', 'Râpe', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'Salade de mangue et banane au lait de coco', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'dessert', 'plat de résistance', 'brique', 'cocktail'], 'Dessert', 8e7207a9-2f0a-4c2c-b4f7-3182dece5e8f, '2025-09-26T17:14:23.594496', [{'ingredient_id': 'c1d1702c-1eba-453e-806a-09c9e994af69', 'quantite': '1'}, {'ingredient_id': 'bdcbbb61-e21a-4bb5-b4b7-fc3fb630099b', 'quantite': '1'}, {'ingredient_id': '2ca184fe-3b15-4cc1-8bfa-3d8a95a5b975', 'quantite': '1'}, {'ingredient_id': '26eb103c-4eae-4ecf-b1b2-86e0e45417bd', 'quantite': '1 cuillères'}, {'ingredient_id': '7e27d7a1-63b4-4c61-8e6b-5e084b45d461', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (71538, 'Banane à la crème et réglisse', 'banane, crème liquide, réglisse, sucre de canne, beurre', '5 min', ['Mettre dans une petite casserole la noisette de beurre, faire dorer sur feu doux puis ajouter la crème liquide + le sucre.', 'Laisser mijoter pendant 5 minutes environ en remuant de temps en temps.', 'Pendant ce temps disposer dans une petite assiette creuse la banane coupée en rondelles.', 'Une fois la crème prête, la verser sur la banane et râper le bâton de réglisse à l''aide d''une râpe (du même genre que celui pour râper de la muscade par exemple) et parsemer la régisse râpée sur le dessert...la quantité reste à votre appréciation !', 'Servir tiède de préférence.'], ['Couteau de chef', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Banane à la crème et réglisse', 'testées', 'très facile', 'bon marché', 'réglisse', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'sucre de canne', 'dessert', 'plat de résistance', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:14:28.245543', [{'ingredient_id': '3ff4510e-d8b3-41e0-8fe3-e8c03a5d27e1', 'quantite': '1'}, {'ingredient_id': 'a0b90835-1fd7-409e-9d65-e6c7d06ebc32', 'quantite': '10 cl'}, {'ingredient_id': '2e25e040-7eb7-4ebb-8e7c-54967068e623', 'quantite': '1'}, {'ingredient_id': 'f75771d1-5347-425d-a990-2af4c71f7763', 'quantite': '1 cuillères'}, {'ingredient_id': '6d86f24f-2b2a-4089-b9b8-f4f5e05ce710', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (347168, 'Crumble banane spéculoos', 'sucre roux, farine, beurre, sel, banane, spéculoos, vanille', '25 min', ['Dans un saladier, émiettez les Spéculoos puis ajoutez-y la farine et le sucre. Mélangez le tout avant d''incorporer le beurre fondu. Mélangez à nouveau, puis formez une boule avec cette pâte.', 'Préchauffez votre four à 180°C (thermostat 6).', 'Beurrez votre plat ou vos ramequins.', 'Coupez les bananes en rondelles avant de les disposer au fond du plat (ou ramequins) puis émiettez la pâte au-dessus des bananes.', 'Enfournez pendant 20 minutes.'], ['Presse-agrumes', 'Spatule', 'Rouleau à pâtisserie', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'crumble banane', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'Crumble banane spéculoos', 'farine', 'vanille', 'dessert', 'plat de résistance', 'beurre', 'cocktail', 'sucre roux'], 'Dessert', e0a90d15-5b37-4fe9-a52f-13bd93290205, '2025-09-26T17:14:31.825026', [{'ingredient_id': 'c0b20345-29fa-42ce-a228-fc0a72b900bf', 'quantite': '30 g'}, {'ingredient_id': 'da3c98ee-7baa-4aaf-b1ce-622737b53557', 'quantite': '130 g'}, {'ingredient_id': '3ea12c7d-af8a-4c36-8492-1aea58f6ee50', 'quantite': '170 g'}, {'ingredient_id': 'df15521d-aa2f-4d06-8bde-46dbfecfee27', 'quantite': '1'}, {'ingredient_id': 'cc30e82d-5fe3-44e2-9a19-0eb6aaccf4ff', 'quantite': '2'}, {'ingredient_id': '9a1802be-0ec2-42d0-a4e4-04e8ebbf4fdb', 'quantite': '12'}, {'ingredient_id': 'bb8b61f4-30ae-4b48-963c-3ac06bfe1224', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (167920, 'Salade de fruits au lait de coco', 'banane, kiwi, brique', '15 min', ['Pelez les 2 kiwis et coupez-les en morceaux. Faites pareil pour les 2 bananes. Mettez les fruits dans un saladier et versez à peu près la moitié de la brique de lait de coco.', 'Mettez ensuite, une demi-heure au réfrigérateur.'], ['Batteur électrique', 'Planche à découper', 'Pince de cuisine', 'Presse-agrumes', 'Casserole'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Salade de fruits au lait de coco', 'brique', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:14:36.328948', [{'ingredient_id': '9faa89d4-23e8-47e0-95c9-d90e16eb9b83', 'quantite': '2'}, {'ingredient_id': '0f42e5ad-6106-4769-a0cf-f72891c0f7f1', 'quantite': '2'}, {'ingredient_id': '4a2ad869-8232-4b1b-8d9d-e2a2d8834657', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46211, 'Chips salés ou sucrés de banane', 'banane, sel, huile de friture', '2 min', ['Découper les bananes en tranches aussi fines que possible, bien les séparer. ', 'Les plonger dans l''huile bouillante en plusieurs fois, jusqu''à ce qu''elles soient bien dorées. ', 'Les disposer sur du papier aborbant et les saupoudrer de sel ou de sucre. ', 'Déguster, lorsque les chips sont froides.'], ['Mixeur', 'Passoire', 'Batteur électrique'], ['entrée', 'banane', 'chips', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'huile de friture', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Chips salés ou sucrés de banane', 'cocktail'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:14:39.888878', [{'ingredient_id': '3a4e58e5-ac29-4951-b060-2747912a0c96', 'quantite': '2'}, {'ingredient_id': 'bf520ee1-966a-4e95-a0b7-acdf3b7e5263', 'quantite': ''}, {'ingredient_id': '5d8214bf-d795-44dc-bb75-93deac5f31c8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (53472, 'Cake banane lait de coco chocolat', 'banane, cassonade, beurre, oeuf, sucre semoule, farine, levure chimique, beurre, noix de coco rapée, lait de coco, chocolat noir', '15 min', ['Préchauffer votre four à 180°C (thermostat 6).', 'Faire fondre la grosse noix de beurre dans une poêle et y déposer les bananes préalablement coupées en rondelles.', 'Saupoudrer de cassonade, mélanger délicatement puis laisser 5 minutes sur feu doux.', 'Laisser refroidir.', 'Dans un saladier, fouetter le sucre semoule et les œufs jusqu''à ce que le mélange blanchisse.', 'Ajouter la farine et la levure, bien mélanger puis ajouter le lait de coco, le beurre fondu, mélanger à nouveau avant d''y ajouter la noix de coco râpée, le chocolat et les bananes caramélisées.', 'Mélanger délicatement puis verser dans un moule beurré et fariné.', 'Enfourner pour 1 heure de cuisson et vérifier la cuisson avec un couteau car selon le four le temps peut être plus court ou plus long.'], ['Poêle', 'Pince de cuisine'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'farine', 'autres cakes', 'noix de coco rapée', 'dessert', 'plat de résistance', 'Cake banane lait de coco chocolat', 'chocolat noir', 'beurre', 'cocktail'], 'Dessert', 78213030-6aa9-4352-a435-345d723e2b02, '2025-09-26T17:14:45.633723', [{'ingredient_id': 'c9613fa1-7ede-4e64-beb0-41e04c2c63e4', 'quantite': '2'}, {'ingredient_id': 'b66fbb79-0771-4b07-9e21-3f9a2aa0d0e9', 'quantite': '2 cuillères'}, {'ingredient_id': '7c80c79c-bc41-4003-8716-c3b589f4e1a0', 'quantite': '1'}, {'ingredient_id': 'a622f5ba-278e-4466-a025-2910f60bff74', 'quantite': '3'}, {'ingredient_id': 'dd3c1662-0df2-4635-ac43-242070339a10', 'quantite': '120 g'}, {'ingredient_id': 'd13711b8-af27-4054-8bc1-2887508acf0b', 'quantite': '160 g'}, {'ingredient_id': 'aa622d20-89b6-4d05-9fd8-2cee68690641', 'quantite': ''}, {'ingredient_id': '71483269-1239-4c60-953b-8ea60238364e', 'quantite': '100 g'}, {'ingredient_id': 'ed3ffa14-97d8-4c29-afa9-3fb8da452f70', 'quantite': '60 g'}, {'ingredient_id': '8b0c3dd5-120d-4874-bebd-0c65412aeffa', 'quantite': '20 cl'}, {'ingredient_id': '6274a249-ac69-49a1-84f7-e9b7ffbd5eb6', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228136, 'Moelleux aux bonbons banane', 'oeuf, sucre, farine, bonbon, lait, levure, beurre, sucre glace, mascarpone, extrait de vanille, bonbon', '30 min', ['Préchauffez le four à 180°C (thermostat 6).', 'Faites chauffer doucement le lait pour faire fondre les 100 g de bonbons Banane. ', 'Faites fondre le beurre. ', 'Battez les œufs avec le sucre jusqu''à obtention d''une mousse onctueuse. ', 'Ajoutez le lait aux bonbons, le beurre fondu, la farine et la levure à la mousse.', 'Découpez les 12 bonbons Banane en morceaux.', 'Mettez des caissettes en papier dans des moules à muffins. Déposez une cuillère à soupe de mousse dans les caissettes. ', 'Déposez quelques morceaux de bonbons coupés dans chaque moule et recouvrir de mousse.', 'Laissez cuire au four pendant environ 20 minutes. ', 'A la sortie du four, laissez refroidir les moelleux sur une grille surélevée. ', 'Préparez la crème : ', 'Fouettez le mascarpone, le sucre glace et l''extrait de vanille. ', 'Quand les moelleux ont bien refroidi (environ 30 minutes), remplissez une poche à douille ou un sac congélation dont vous aurez découpé un côté, de crème et décorez les moelleux. ', 'Ajoutez un bonbon banane pour la décoration.'], ['Presse-agrumes', 'Tire-bouchon', 'Moule à tarte', 'Fouet', 'Pince de cuisine'], ['entrée', 'recettes de cuisine', 'bonbon', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'levure', 'cuisine', 'Moelleux aux bonbons banane', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'beurre', 'sucre', 'lait', 'cocktail'], 'Dessert', d028de1a-b830-4dcf-8653-06db2269735a, '2025-09-26T17:14:50.188432', [{'ingredient_id': 'a18db910-365b-4357-8b9f-b7fa32c82622', 'quantite': '2'}, {'ingredient_id': 'a01d232a-1fec-4ba1-93e2-f75e7e70fd03', 'quantite': '40 g'}, {'ingredient_id': 'd6741f11-666c-415a-a5a4-a505acf4496e', 'quantite': '80 g'}, {'ingredient_id': 'fb6e5ccb-a0fb-4f63-8b14-7b707de5e2d0', 'quantite': '200 g'}, {'ingredient_id': '22d15fcc-c1e4-4e61-b2f9-47bd2534cc4f', 'quantite': '10 cl'}, {'ingredient_id': '6f14c399-67a0-44e9-9d34-91f807d5639b', 'quantite': '1 cuillères'}, {'ingredient_id': '60c8cc40-d66f-44c8-a72f-25fa441aa3dc', 'quantite': '50 g'}, {'ingredient_id': 'b18511a1-322f-4133-a453-01361ded5a1e', 'quantite': '50 g'}, {'ingredient_id': 'd98789f1-a3dc-48aa-8180-7dce95f9efaf', 'quantite': '250 g'}, {'ingredient_id': '6fc1796e-9135-4217-a060-cd089dd1e81b', 'quantite': '1 cuillères'}, {'ingredient_id': '02a5e0a4-c48a-43f1-b01a-bb9351126d41', 'quantite': '12'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (48659, 'Bananes légères  vinaigrées', 'banane, airelles, vinaigre de framboise, menthe, crème fraîche, réglisse', '5 min', ['Séparez les bananes les unes des autres en faisant attention à ne pas endommager la peau.', 'Ouvrez la boîte d''airelles et égouttez-les en conservant leur jus.', 'Ecrasez les airelles à la fourchette.', 'Ajoutez le vinaigre et un peu de jus des airelles (1/3 de la boîte environ). Mélangez bien.', 'Vous pouvez ajouter une cuillère à soupe de crème fraîche.', 'Fendez légèrement la peau des bananes sur la partie intérieure (côté opposé au dos) à environ 1 cm de chaque côté du centre et fendez la banane au centre (sans traverser surtout) plus profondément.', 'Ecartez légèrement les 2 côtés et versez dans le centre une cuillère à soupe de sauce aux airelles.', 'Posez dessus une feuille de menthe et éventuellement un petit morceau de réglisse (environ 1 cm de long).', 'Posez les bananes sur la braise d''un barbecue.', 'Déguster.'], ['Rouleau à pâtisserie', 'Moule à tarte', 'Couteau de chef', 'Batteur électrique', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'Bananes légères  vinaigrées', 'très facile', 'menthe', 'bon marché', 'réglisse', 'airelles', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vinaigre de framboise', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', 2ff41596-cab8-4add-b421-e3fa2b66caa5, '2025-09-26T17:14:53.939298', [{'ingredient_id': '5a798790-1764-47cd-a729-d81f9277205a', 'quantite': '6'}, {'ingredient_id': '2279367b-82f5-4af0-b970-330842c02dbc', 'quantite': '1'}, {'ingredient_id': '8f3a2317-e87a-49d1-8277-a786c255433b', 'quantite': '1 cuillères'}, {'ingredient_id': '4f7b00d3-2205-4097-b8ae-fb5f760302d9', 'quantite': '6'}, {'ingredient_id': '9907d648-e839-4ee1-a4ea-ca53f7412cb8', 'quantite': ''}, {'ingredient_id': '6ab52d01-c770-4080-8a01-0835e49febaf', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (54936, 'Chaussons aux pommes, bananes et raisins secs', 'pâte brisée, pomme, banane, raisins secs, oeuf, sucre vanillé', '10 min', ['Etalez la pâte brisée de façon à pouvoir découper 4 disques de 15 cm de diamètre environ.', 'Pelez la pomme, coupez-la en petits cubes, épluchez la banane et coupez-la en lamelles, mélangez les 2 fruits et ajoutez-y les raisins secs.', 'Répartissez le mélange de fruits sur chaque disque de pâte et repliez en chaussons en soudant les bords.', 'Badigeonnez le dessus de chaque chausson avec l''oeuf battu en omelette.', 'Saupoudrez les chaussons de sucre vanillé.', 'Disposez les chaussons sur une feuille de papier sulfurisé et faites cuire au four préchauffé à 200°C (thermostat 6-7) pendant 20 à 25 minutes (les chaussons doivent être dorés).'], ['Planche à découper', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'Chaussons aux pommes', 'oeuf', 'plat', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'bananes et raisins secs', 'raisins secs', 'chausson aux pommes', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:14:57.539873', [{'ingredient_id': '63e7288e-b2f7-40da-887b-761ed2b47ccf', 'quantite': '250 g'}, {'ingredient_id': '14ed33ad-082b-4dd5-b895-5998d4d632c6', 'quantite': '1'}, {'ingredient_id': '673fd2f6-31eb-4be1-abd0-47ea4d1802b7', 'quantite': '1'}, {'ingredient_id': 'be75ed60-be5c-4f76-8564-ae359f9d010d', 'quantite': '50 g'}, {'ingredient_id': 'bb9dc5d4-5b48-4db7-88bd-7772a6dfb625', 'quantite': '1'}, {'ingredient_id': '591ccfeb-e163-4c61-aabf-172b6466b7c0', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (348246, 'Salade d''été aux fruits et au jambon', 'salade mélangée, jambon cru, melon, banane, feta, tomates cerise', '20 min', ['Commencer par laver la salade et les tomates cerises, puis les mettre dans un saladier. Ne pas ou peu essorer.', 'Prendre les tranches de jambon et les découper en lamelles. Les rajouter dans le saladier.', 'Ajouter la feta découpée en petits carrés au saladier.', 'Couper le melon en tranche puis en morceaux carrés ainsi que les bananes découpées en rondelles. ', 'Ajouter les fruits au saladier. Mélanger le tout. Normalement la fraîcheur des fruits et l''eau du lavage restante font qu''il n''y a pas besoin de vinaigrette !'], ['Moule à tarte', 'Poêle'], ['', 'melon', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cocktail', 'salade mélangée', 'très facile', 'bon marché', 'rapide', 'plat', 'jambon cru', 'recette', 'cuisine', 'recettes', 'Salade d''été aux fruits et au jambon', 'boisson', 'feta', 'dessert', 'plat de résistance', 'tomates cerise'], 'Entrée', 9f895881-2941-403b-8c02-1ac21b04ccf4, '2025-09-26T17:15:02.896713', [{'ingredient_id': '07f2d437-9e28-4b7f-9e75-8d2f92217aa7', 'quantite': '1'}, {'ingredient_id': 'f00f74b4-b9db-4345-9529-a72462d06013', 'quantite': '6'}, {'ingredient_id': 'ac62c86d-6e2e-42fe-b5ce-b39f44b8d241', 'quantite': '1'}, {'ingredient_id': '9bb1fbbf-9cc1-4924-9999-3fcbef2490bf', 'quantite': '5'}, {'ingredient_id': '253973b1-ada9-4296-82ef-79b84e6f4460', 'quantite': '1'}, {'ingredient_id': 'a664011b-c67b-4caa-add2-d7b74968fd67', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (59983, 'Crumble pommes bananes crème de marrons', 'pomme, banane, crème de marrons, farine, sucre, beurre, cassonade', '20 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Eplucher les pommes et les couper en fines lamelles. Couper les lamelles en deux.', 'Faire cuire à feu moyen avec les deux bananes coupées en fines lamelles dans une poêle pendant 10 minutes (rajouter un peu d''eau si ça accroche).', 'Ajouter ensuite la crème de marrons, réduire à feu doux et faire cuire encore 15 minutes en réduisant le feu. On doit obtenir une compote avec des petits morceaux de pommes.', 'Préparer en suite la pâte à crumble : mélanger la farine, la cassonade et le beurre ramolli et travailler grossièrement du bout des doigts.', 'Dans un moule beurré, mettre la préparation de fruits puis clairsemer grossièrement la pâte sur le dessus.', 'Faire cuire 20 minutes.', 'Déguster tiède avec de la glace à la vanille.'], ['Verre doseur', 'Passoire', 'Fouet'], ['crème de marrons', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'Crumble pommes bananes crème de marrons', 'pomme', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:15:06.609794', [{'ingredient_id': 'e2398119-83dc-465a-ac0c-7e882048086f', 'quantite': '4'}, {'ingredient_id': 'de71261c-d173-4001-88c0-45b42162dbb4', 'quantite': '2'}, {'ingredient_id': 'ba7d43c7-6c5b-4e81-a4e9-9f16a89946fb', 'quantite': '200 g'}, {'ingredient_id': '16390cbc-512c-45a0-84ed-afb725b2f63f', 'quantite': '150 g'}, {'ingredient_id': '25764683-6728-4945-b50d-8489f765ac0f', 'quantite': '75 g'}, {'ingredient_id': 'a95a8026-0522-4fcf-9dcc-6ffd551494fd', 'quantite': '75 g'}, {'ingredient_id': '5ef52a46-8f19-4dc6-86ad-ed6d37da3e34', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (84831, 'Bonbons banane nutella', 'brick, banane, Nutella, ficelle, beurre salé, glace vanille, chocolat, lait', '10 min', ['Découper votre feuille filo (ou de brick) en quatre carrés et faire, pour chaque carré :', 'Etaler une cuillère de nutella sur une bande centrale, disposer un quart de banane au bord et la rouler pour obtenir un rouleau.', 'Fermer celui-ci à l''aide de ficelle sur chaque côté et donner ainsi une forme de bonbon.', 'Badigeonner de beurre salé sur une plaque et faire dorer au four.', 'Pendant ce temps, faire fondre le chocolat avec un peu de lait.', 'Présentation :', 'Poser deux bonbons par assiette, les accompagner d''une belle boule de glace et décorer de quelques filets de chocolat chaud.', 'Bon appétit !'], ['Pince de cuisine', 'Batteur électrique', 'Moule à tarte', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'ficelle', 'beurre salé', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'glace vanille', 'Nutella', 'dessert', 'plat de résistance', 'Bonbons banane nutella', 'lait', 'cocktail'], 'Dessert', b23545e3-6992-40c6-bcba-48e76f9081a3, '2025-09-26T17:15:10.257256', [{'ingredient_id': '9b3a9657-54b7-40bb-a298-69028643e0bc', 'quantite': '4'}, {'ingredient_id': '4fb6fd03-e49b-4dc9-98ae-4617c8f1aeda', 'quantite': '2'}, {'ingredient_id': '6ff2564c-fe86-473c-8cb9-a496d99b703c', 'quantite': '8 cuillères'}, {'ingredient_id': '49be1da9-4baa-4ed8-9109-7ab00fe6afc4', 'quantite': ''}, {'ingredient_id': '7a8e4d44-6fab-4123-bd8c-19de5ba2a164', 'quantite': ''}, {'ingredient_id': '4c20c72c-a3f9-4376-a76d-ee9d8c1bb319', 'quantite': ''}, {'ingredient_id': 'f26cc35b-dc0e-4e80-974d-d1dea26debf0', 'quantite': ''}, {'ingredient_id': 'b6a92c02-119d-4826-8f6b-edd5829c5b35', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (217429, 'Gâteau et glaçage tout banane', 'farine, sucre, beurre, oeuf, yaourt, banane, citron, sucre vanillé, sucre glace, levure chimique', '30 min', ['Dans un saladier, mélanger la farine, le sucre, et la levure. Puis casser les œufs dans le saladier en les incorporant délicatement.', 'Mixer trois bananes avec le yaourt, presser le citron et ajouter le tout dans le saladier. Bien remuer. ', 'Beurrer un grand moule rond, puis y déposer la pâte. Enfourner le moule dans le four à 180°C (thermostat 6), pendant une demi-heure. ', 'Pendant ce temps, mixer un quart de la dernière banane et le mélanger avec un demi verre de sucre glace . Reposer le glaçage au frigo, et le napper sur le haut du gâteau quand celui ci est refroidi. ', 'Servir froid.'], ['Fouet', 'Presse-agrumes', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'gâteau à la banane', 'citron', 'beurre', 'sucre glace', 'sucre', 'Gâteau et glaçage tout banane', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:15:14.818184', [{'ingredient_id': '20143691-5fe4-439d-9af0-b9521e403c79', 'quantite': '200 g'}, {'ingredient_id': '537d824f-a6a7-420a-97aa-7d9096cf6650', 'quantite': '150 g'}, {'ingredient_id': 'ae66f54f-fdcf-4352-b029-b12182a638f5', 'quantite': '100 g'}, {'ingredient_id': '542fd093-5c6a-4bce-9bba-69c91c211c51', 'quantite': '4'}, {'ingredient_id': '702b03de-1753-41e8-8867-446fbba45531', 'quantite': '1'}, {'ingredient_id': '539d482c-c3e3-47e4-8b91-32d201a98321', 'quantite': '4'}, {'ingredient_id': '2239bd31-b1f2-459a-be4e-be1a070555cc', 'quantite': '1'}, {'ingredient_id': '3e6aa8a9-f1fa-44d1-9cdb-f2cc9a6bb66a', 'quantite': '1'}, {'ingredient_id': '1c81f9e0-7890-42bf-979e-086e31d33057', 'quantite': '1'}, {'ingredient_id': '5381aa6c-e374-4140-8e8a-a9fc078f3f97', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18812, 'Dessert glacé - bananes et mangues', 'mangue, banane, yaourt, sucre, blanc d''oeuf', '15 min', ['Lavez, pelez et coupez les mangues en morceaux en enlevant le noyau. ', 'Placez les morceaux dans le bol du mixeur. ', 'Ajoutez les bananes en rondelles. ', 'Réduire le tout en une fine purée puis additionner le yaourt et le sucre. Mettez un peu plus de sucre que votre goût car la congélation diminue un peu la saveur. ', 'Mettre la préparation dans votre sorbetière ou dans un plat allant au congélateur. Dans ce cas, lorsque la préparation est partiellement congelée, ajoutez le blanc d''oeuf battu en neige. Bien homogénéiser. Remettre au congélateur jusqu''à ce que le dessert soit pris. ', 'Servez le dessert dans des petites coupelles ou en accompagnement d''un fondant au chocolat, d''une tarte. En fait, c''est comme vous voulez.'], ['Verre doseur', 'Tire-bouchon', 'Batteur électrique', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'Dessert glacé - bananes et mangues', 'très facile', 'bon marché', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre', 'blanc d''oeuf', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:15:18.383845', [{'ingredient_id': '1b92ea0b-2b95-4808-9d55-77fbbea4f300', 'quantite': '2'}, {'ingredient_id': '5bb7837d-8383-4810-9ff2-6017d0203d0d', 'quantite': '2'}, {'ingredient_id': 'd10ba88b-11d5-4cf9-a99f-c03af6451674', 'quantite': '150 g'}, {'ingredient_id': 'a3be1be8-c668-41a1-b588-8ace5de9181b', 'quantite': ''}, {'ingredient_id': '5b8ad546-55a6-488c-92ed-0b07f062d2a1', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (83420, 'Tiramisu banane-framboise', 'mascarpone, oeuf, sucre en poudre, Petit brun, banane, coulis de framboise, fruits, cacao amer', '30 min', ['Battre les jaunes d''oeufs avec le sucre jusqu''à blanchiment.', 'Y incorporer progressivement le mascarpone, puis ensuite les blancs battus en neige.', 'Couper les bananes en petits cubes.', 'Ajouter le coulis de framboise.', 'Monter le tiramisu : une première couche de biscuits trempés au dernier moment dans le jus de fraise, une deuxième couche de banane à la framboise puis une troisième de crème au mascarpone.', 'Recommencer l''opération des trois couches une seconde fois.', 'Placer au frigo 24 heures avant la consommation.', 'Saupoudrer de cacao amer avant la dégustation.'], ['Louche', 'Presse-agrumes', 'Mixeur', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'Tiramisu banane-framboise', 'cacao amer', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Petit brun', 'tiramisu', 'fruits', 'cocktail', 'coulis de framboise'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:15:21.909958', [{'ingredient_id': '029bec37-fcdc-4992-b2f5-d01b68f97d14', 'quantite': '250 g'}, {'ingredient_id': '9da759ea-72cd-48b6-8fb2-8be078353749', 'quantite': '3'}, {'ingredient_id': 'b25a80f9-861c-43b9-89f2-1de0f065fddc', 'quantite': '50 g'}, {'ingredient_id': '14f3c045-f5e9-4b09-9ec7-31b8782f824a', 'quantite': '1'}, {'ingredient_id': 'e40922ff-b72e-4ded-9367-4676606c3da4', 'quantite': '5'}, {'ingredient_id': 'b43daf21-142e-4618-b72e-0b8fafe9d0b8', 'quantite': '5 cuillères'}, {'ingredient_id': 'a4820698-0844-4893-a4ce-f1eff7bbaf35', 'quantite': ''}, {'ingredient_id': '35127253-9076-47e0-a787-285c17e74bf9', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40337, 'Bavarois bananes citron vert', 'banane, gélatine, sucre, citron vert, citron, crème fouettée', '20 min', ['4 h de réfrigération sont nécessaires pour cette recette. ', 'Mixer les bananes, ajouter le jus de citron.', 'Prélever le zeste du citron vert et en extraire le jus. Ajouter à la banane mixée.', 'Faire tremper les feuilles de gélatine dans de l''eau froide, puis les essorer. Les liquéfier en les chauffant doucement au bain-marie, avec 2 cuillères à soupe d''eau. Ajouter à la masse et bien mélanger.', 'Laisser prendre un peu en remuant de temps en temps. Quand la masse commence à prendre, ajouter la crème battue et bien mélanger.', 'Verser dans un moule passé à l''eau et laisser prendre au frigo 4 h minimum.', 'Démouler en passant le moule sous l''eau chaude.'], ['Presse-agrumes', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'Bavarois bananes citron vert', 'plat', 'bavarois', 'crème fouettée', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'gélatine', 'citron vert', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:15:25.526575', [{'ingredient_id': '507b1548-cc16-44c8-ba2e-64aebc687bfe', 'quantite': '500 g'}, {'ingredient_id': 'cf4ed88b-03b3-4ce7-b4cf-f495cc0cc62e', 'quantite': '5'}, {'ingredient_id': 'e7b8b83c-4705-4e1b-ad96-9815c58c2a70', 'quantite': '30 g'}, {'ingredient_id': '22906306-d2c9-4a21-9343-2cfcacd4664c', 'quantite': '1'}, {'ingredient_id': 'ddf1421e-c377-483f-bd3d-f63e8d844e67', 'quantite': ''}, {'ingredient_id': '36295c12-e026-43d2-99f8-c8ac9e957e2d', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335054, 'Samossas chocolat banane coco', 'beurre tendre, sucre semoule, oeuf, noix de coco rapée, farine, chocolat noir, cacao, banane, beurre, feuille de brick, banane, sucre glace', '30 min', ['Préchauffez votre four à 210°C (thermostat 7).', 'Faites fondre le beurre et versez-le sur le sucre dans un saladier, mélangez pour obtenir une texture crémeuse.', 'Ajoutez un oeuf, mélangez, puis ajoutez la noix de coco et la cuillère de farine.', 'Une fois une masse homogène obtenue, mettez le deuxième oeuf puis mélangez.', 'A l''aide d''un hachoir, hachez le chocolat en miettes que vous ajoutez à la préparation avec le cacao en poudre.', 'Hachez également la banane jusqu''à l''obtention d''une crème, mélangez-la à la préparation.', 'Selon la sorte de feuille de brick que vous avez (ronde ou rectangle) faites des lamelles de 6 à 9 cm de largeur.', 'Faites fondre le beurre et badigeonnez les feuilles de brick à l''aide d''un pinceau.', 'Déposez une cuillère à soupe de la préparation sur le coin d''une feuille de brick puis une rondelle de banane et pliez en collant le bord à l''extrémité', 'Puis continuez le pliage de sorte à obtenir la forme triangulaire des samossas.', 'Fermez bien les samossas pour que la crème reste à l''interieur.', 'Mettez les samossas sur une plaque de cuisson antiadhésive.', 'Saupoudrez-les de sucre glace et mettez-les au four pendant 10 minutes.'], ['Économe', 'Rouleau à pâtisserie', 'Poêle', 'Batteur électrique', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'beurre tendre', 'facile', 'bon marché', 'cacao', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'farine', 'Samossas chocolat banane coco', 'noix de coco rapée', 'dessert', 'plat de résistance', 'chocolat noir', 'cocktail'], 'Dessert', 5a65b4be-53d7-43c5-bac9-4de821bd338a, '2025-09-26T17:15:29.015055', [{'ingredient_id': '646a14cc-6968-47c9-8724-e0b769fd2e18', 'quantite': '100 g'}, {'ingredient_id': '20b7ad21-d71e-4b30-9964-49809c59b499', 'quantite': '100 g'}, {'ingredient_id': 'f5f16b78-630d-4437-be37-45a316f17553', 'quantite': '2'}, {'ingredient_id': 'd4d636e7-fcd4-4426-89fb-e865e8cea6bc', 'quantite': '100 g'}, {'ingredient_id': '9d9941ed-158c-49a8-922c-616d49d22999', 'quantite': '1 cuillères'}, {'ingredient_id': 'dd1d4045-a46a-4a38-be44-80547584f5eb', 'quantite': '30 g'}, {'ingredient_id': 'fae9b8f1-8ca6-4eee-8395-2271cf067069', 'quantite': '20 g'}, {'ingredient_id': 'f4f321dd-dbdc-48cd-afbb-48d56772ac9b', 'quantite': '1'}, {'ingredient_id': '0b533ac0-45c7-4ebf-b9e2-e7f5706f7757', 'quantite': '50 g'}, {'ingredient_id': 'adf2d265-1d02-4de4-9cf2-9a4519de1186', 'quantite': '10'}, {'ingredient_id': 'dde6838d-25b0-4cb9-abac-ac9b24c053de', 'quantite': '2'}, {'ingredient_id': 'cc7cd68d-cebe-4c4f-834e-9d967de91982', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (171324, 'Cocktail Entregent', 'vin blanc, cognac, pomme, banane, poire, citron, sucre, vanille, cannelle', '15 min', ['Épluchez les fruits, coupez-les en petits carrés et placez-les dans un grand saladier.', 'Ajoutez les tranches du 1/2 citron sans retirer le zeste, le verre de cognac, le sucre, la vanille et la cannelle.', 'Laissez macérer le tout une heure. Ajoutez le vin.', 'Placez la préparation 2 h au réfrigérateur.', 'Dégustez !'], ['Spatule', 'Râpe', 'Ouvre-boîte', 'Batteur électrique', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'rapide', 'vin blanc', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'citron', 'cannelle', 'Cocktail Entregent', 'sucre', 'cognac', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:15:33.662658', [{'ingredient_id': 'f12e3a09-59ea-4e42-baf5-d2b4e643a992', 'quantite': '1'}, {'ingredient_id': 'fcb2bd3d-7649-4dfb-ac5a-f85336efe85b', 'quantite': '1'}, {'ingredient_id': 'f8d45086-4775-4251-b677-57a9418c9802', 'quantite': '1'}, {'ingredient_id': '4d54ac62-8b31-4fd2-b936-7854336809d2', 'quantite': '1'}, {'ingredient_id': '35c2c65c-3891-421e-8233-11fd84b46616', 'quantite': '1'}, {'ingredient_id': '8f5d7e1a-24ef-47ce-bcb2-ef9a7e8a7869', 'quantite': ''}, {'ingredient_id': '1c5e81ba-28dc-4eea-b295-4ed14585e018', 'quantite': '50 g'}, {'ingredient_id': 'ec2c121d-2b62-46d0-927b-45e6f665b06f', 'quantite': '1'}, {'ingredient_id': 'b2a7a8b7-0a2a-4dd7-903d-dfb7bac847aa', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (194818, 'Compote pomme, banane, kiwi', 'pomme, kiwi, banane, jus de citron, cannelle, miel, sucre vanillé, sucre, menthe, eau', '15 min', ['Peler et couper les fruits en morceaux puis les mettre dans une casserole à feu doux.', 'Ajouter l''eau, le miel, le jus de citron, le sucre vanillé, le sucre, la cannelle et la menthe et bien remuer.', 'Laisser cuire à feu doux pendant environ 35 min.', 'Enfin, mixer le tout, laisser refroidir et déguster.'], ['Mixeur', 'Tire-bouchon'], ['entrée', 'banane', 'kiwi', 'Compote pomme', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'menthe', 'facile', 'compote de pomme', 'bon marché', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'jus de citron', 'pomme', 'cannelle', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:15:37.428808', [{'ingredient_id': 'eedbeb05-c0e4-4aca-b703-06e9bd1e8aac', 'quantite': '3'}, {'ingredient_id': '12897a30-748e-4abc-bd68-6d79639f8fba', 'quantite': '4'}, {'ingredient_id': '5008a468-aa5a-4313-b3bc-d4ff1f83a610', 'quantite': '3'}, {'ingredient_id': '61812e09-a7d5-4fcb-af62-3b6c3a749850', 'quantite': '1 cuillères'}, {'ingredient_id': 'f10dfbbd-99cc-42b3-bac5-b51fd7cb116f', 'quantite': '1 cuillères'}, {'ingredient_id': '42602d91-4f87-4c1d-8b00-eb7fc7c7e4fc', 'quantite': '1 cuillères'}, {'ingredient_id': 'bb747be1-3dab-41e8-b9c7-884dff468952', 'quantite': '1'}, {'ingredient_id': 'dad366e8-4c6f-4b32-acb6-2a9f90ba3bdd', 'quantite': '1 cuillères'}, {'ingredient_id': '7dc30da1-c439-4caa-9e22-d118c868706e', 'quantite': '4'}, {'ingredient_id': 'b0e8ab8e-023a-42f8-b810-3e83ad77e74b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (63970, 'Smoothie ultra-simple banane-framboise', 'banane, framboises, yaourt, lait, sucre en poudre', '5 min', ['Mettre la banane coupée en rondelles, les framboises, le yaourt et le lait dans le bol d''un mixer.', 'Mixer pendant environ 1 minute.', 'Goûter et ajouter du sucre si besoin.', 'Verser la préparation dans un verre.', 'Décorer de quelques framboises.', 'Bonne dégustation =)'], ['Poêle', 'Planche à découper', 'Balance de cuisine', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'framboises', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'Smoothie ultra-simple banane-framboise', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'lait', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:15:41.041365', [{'ingredient_id': '9e1e519e-8344-45f9-a118-8180e78bbf49', 'quantite': '1'}, {'ingredient_id': '0989c6c5-788f-44bc-84fe-15b3aa484b8e', 'quantite': '1'}, {'ingredient_id': '2d071406-b6f3-44e2-989a-fcb193b7e99f', 'quantite': '1'}, {'ingredient_id': '7e8966cc-3f7f-4a53-ab43-7003f39eac09', 'quantite': '2 cl'}, {'ingredient_id': '7997e403-b91c-4dbe-ab77-fba134a5a47d', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22822, 'Cake à la banane facile et rapide', 'farine, sucre, banane, beurre, levure chimique, sel, oeuf, lait', '10 min', ['Mettre la farine dans un saladier avec la levure, ajouter une pincée de sel.', 'Dans un autre saladier mettre le sucre, l''oeuf, le beurre fondu, puis le lait.', 'Ecraser les bananes dans un bol à part.', 'Incorporer les bananes écrasées au précédent mélange (sucre, oeuf, beurre et lait). Bien mélanger au fouet électrique.', 'Verser le préparation dans le premier saladier contenant les ingrédients secs, et mélanger de nouveau.', 'Mettre dans un moule à cake.', 'Cuire pendant 45 min environ à 180°C.'], ['Batteur électrique', 'Presse-agrumes', 'Mixeur', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'Cake à la banane facile et rapide', 'beurre', 'sucre', 'lait', 'cocktail'], 'Dessert', 318ee308-2bcc-40ec-a8a3-1b817fdc6c6f, '2025-09-26T17:15:47.794671', [{'ingredient_id': 'aa17e3ec-050d-48dc-99bf-73de13e350d3', 'quantite': '200 g'}, {'ingredient_id': '41f06f3a-41b1-4a33-9111-5c5f6a072ef9', 'quantite': '150 g'}, {'ingredient_id': 'e66a88e3-3641-48f4-8292-37843dbdc8a2', 'quantite': '3'}, {'ingredient_id': '622082d7-cb15-4132-bf7e-8074382d4303', 'quantite': '50 g'}, {'ingredient_id': '34e9ac64-a651-432b-985f-c04bc7e27ffd', 'quantite': ''}, {'ingredient_id': '3651b0f5-bde1-4152-acfa-bee7f2370db4', 'quantite': '1'}, {'ingredient_id': 'c9dae9f1-f81c-45ae-9caf-d6d8ee8ef1b7', 'quantite': '1'}, {'ingredient_id': 'd1631d92-0d4f-4002-a74e-1461629f3d2b', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (253636, 'Gâteau à la banane et aux carambars', 'oeuf, farine, sucre, levure chimique, beurre, banane, extrait de vanille liquide, carambar©', '20 min', ['Mélanger le sucre avec les œufs.', 'Ajouter le beurre fondu, ensuite ajouter farine et la levure.', 'Couper les bananes en rondelles ou en petits morceaux. Ajouter au mélange précédent, ajouter un peu de vanille liquide (pour l''arôme).', 'Bien mélanger.', 'Verser le tout dans un moule à cake et faire cuire 30 min à 160°C (thermostat 5-6).', '5 min avant la fin de la cuisson planter 5 petit carambars dans le gâteau.', 'Pour faire un cake à la banane avec un coulant de carambars.'], ['Batteur électrique', 'Mixeur', 'Spatule', 'Ouvre-boîte', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'extrait de vanille liquide', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'carambar©', 'dessert', 'plat de résistance', 'gâteau à la banane', 'beurre', 'sucre', 'cocktail', 'Gâteau à la banane et aux carambars'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:15:52.508558', [{'ingredient_id': '0002608f-daaf-452a-b40e-b133ed17c3b8', 'quantite': '2'}, {'ingredient_id': 'f3bd828e-231b-4f95-a41f-a7b4c2319afe', 'quantite': '140 g'}, {'ingredient_id': '3b7366a0-4084-4b8a-9444-f85ff49f44d2', 'quantite': '80 g'}, {'ingredient_id': 'adc9b09e-1e99-4176-9c52-1f152f0f9908', 'quantite': ''}, {'ingredient_id': '7ccd7006-18a5-4b6b-a6f8-02ea7d69f601', 'quantite': '100 g'}, {'ingredient_id': '85d907bf-5ae2-4bf2-8b9a-5e55ad626f1a', 'quantite': '3'}, {'ingredient_id': '0d233012-a725-4812-9bbb-8a770128261b', 'quantite': ''}, {'ingredient_id': 'b7b6ca98-66cc-4ba4-885b-26368d5a0f9f', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530732, 'Banana Bread Healthy (Avoine - Chocolat)', 'flocons d''avoine, chocolat noir, banane, oeuf, lait végétal, levure chimique', '15 min', ['Dans un saladier, écraser les bananes avec une fourchette.', 'Ajouter les œufs, la levure et le lait puis mélanger à l’aide d’un fouet.', 'Incorporer ensuite les flocons d’avoine.', 'Coupez le chocolat en petits dés et l’ajouter à la préparation.', 'Verser la pâte dans un moule beurré. Enfourner 30 à 35min à 180°C en vérifiant avec la lame d’un couteau qu’elle ressorte sèche.'], ['Verre doseur', 'Moule à tarte', 'Couteau de chef', 'Économe'], ['', 'lait végétal', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'Banana Bread Healthy (Avoine - Chocolat)', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'flocons d''avoine', 'cocktail'], 'Dessert', 06e2809d-42e0-41f7-9f02-8752abc62c0c, '2025-09-26T17:15:56.094648', [{'ingredient_id': 'fb6ef942-7f2c-4526-ba97-8eca7ae30a0b', 'quantite': '150 g'}, {'ingredient_id': 'a1b47765-0fe0-4a97-9467-9c74213b2fad', 'quantite': '100 g'}, {'ingredient_id': '8c8105c2-4eb3-4c2d-9d90-84b392aee217', 'quantite': '3'}, {'ingredient_id': '48b78f6e-1b1c-4311-ac9a-da2155e215cf', 'quantite': '2'}, {'ingredient_id': '653d59dd-a7f8-4f29-ac58-272316e9466f', 'quantite': '15 cl'}, {'ingredient_id': '4b6bbd50-7c89-41df-a619-b49a050c4c5a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58887, 'Sorbet tropical', 'eau, sucre, banane, mangue, kiwi, blanc d''oeuf, rhum', '15 min', ['Préparez votre sirop avec 27 cl d''eau et 170 g de sucre. Vous pouvez ajoutez une cuillère à soupe de rhum.', 'Laissez refroidir votre sirop.', 'Epluchez la banane, la mangue ainsi que les deux kiwis. Mixez les fruits en purée.', 'Battez la moitié d''un blanc d''oeuf en neige bien ferme.', 'Mélangez le sirop refroidi, le blanc d''oeuf et la purée de fruits. ', 'Versez la préparation dans la sorbetière jusqu''à ce que la glace prenne. Mettez dans un bac à glace au congélateur et dégustez.', '(Il est préférable de réaliser le sirop la veille).'], ['Économe', 'Râpe', 'Planche à découper'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'Sorbet tropical', 'rhum', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'sorbet', 'dessert', 'plat de résistance', 'sucre', 'blanc d''oeuf', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:16:00.544750', [{'ingredient_id': 'd3594602-403c-4002-b689-619caf01f18e', 'quantite': '27 cl'}, {'ingredient_id': '0df6d66d-4448-4c7a-9489-6af3acc6d22a', 'quantite': '180 g'}, {'ingredient_id': 'fd46a742-cb61-4867-8501-5749969a18e2', 'quantite': '1'}, {'ingredient_id': '4894e6fa-0376-4dd8-bf07-5f151123b8d8', 'quantite': '1'}, {'ingredient_id': '65dfe230-c884-492e-9dec-df53db80ac7c', 'quantite': '2'}, {'ingredient_id': 'd102b565-27f6-4d46-bc17-7dafb5ec839b', 'quantite': ''}, {'ingredient_id': 'fbbcc2db-a12f-4850-a13c-a9d9b01940ce', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530589, 'Les Power Balls à la Banane de Simon Super Lapin', 'belle banane, super beurre de cacahuètes, jolies céréales, méga miel, extrait de vanille bien parfumé', '15 min', ['Commence par verser les céréales dans le saladier puis écrase-les à l''aide de tes mains.
Si tu veux tu peux utiliser le fond d’un verre en plastique pour bien les écraser.', 'Une fois que tout est écrasé prends la banane et coupe-la en morceaux à l''aide de tes mains, mets les morceaux dans ton bol plein de céréales.
Aaaah ça colle !! Rince-toi les mains après.', 'Ensuite, mets le beurre de cacahuètes dans une casserole et demande à tes parents de le faire chauffer pour qu''il ramollisse.
Une fois prêt, verse le dans ta préparation, et rajoute-y l''extrait de vanille.', 'Rajoute le miel puis mélange le tout, jusqu''à ce que ta préparation devienne bien compact et collante.', 'Place un torchon par-dessus ta préparation et laisse reposer la pâte pendant 30 min au réfrigérateur et pendant ce temps profites-en pour nettoyer la table.', 'Et voilà ! Une fois ta préparation refroidie, récupère là, pose la sur la table. Il n''y a plus qu''à faire des petites boules avec tes mains. 
Dépose les ensuite dans une assiette ou plat.
Ça a l’air trop bon ! J’ai trop envie d’en gouter une.', 'Tu peux aussi le faire avec des dattes, des framboises, ou encore des raisins secs
Voilà, tes boules d''énergies sont prêtes. Il ne reste plus qu’à les manger.
Si tu veux en garder pour tes amis, garde-les dans ton réfrigérateur.'], ['Passoire', 'Verre doseur', 'Économe', 'Ouvre-boîte', 'Râpe'], ['', 'belle banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'super beurre de cacahuètes', 'très facile', 'méga miel', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'extrait de vanille bien parfumé', 'dessert', 'plat de résistance', 'moyen', 'Les Power Balls à la Banane de Simon Super Lapin', 'cocktail', 'jolies céréales'], 'Confiserie', 7bc4a021-faf3-4b20-b21c-2b051af290e5, '2025-09-26T17:16:04.154901', [{'ingredient_id': '05f67f58-25cf-4697-9e93-458c67f8d27a', 'quantite': '300 g'}, {'ingredient_id': '462ad264-8666-4d77-9ebf-db5e82825314', 'quantite': '2.5 cuillères'}, {'ingredient_id': '145c2036-fc69-49a4-9002-c165d31f5e78', 'quantite': '125 g'}, {'ingredient_id': '3ba753a1-3743-4c25-9733-210d571030e1', 'quantite': '1 cuillères'}, {'ingredient_id': 'ca8f7442-bd45-4e60-b88d-715448a3b221', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58006, 'Poulet aux cacahuètes et à la banane', 'filet de poulet, lardons, champignons de Paris, banane, cacahuète grillée, crème fraîche, légumes, margarine', '30 min', ['Faire successivement revenir dans un peu de margarine les filets de poulet, les lardons, puis les champignons.', 'Pendant ce temps, couper les bananes en tranches pas trop épaisses.', 'Mélanger la crème fraîche avec la Sauce Exotique, puis y ajouter les lardons, les champignons et les bananes.', 'Mettre les filets de poulets dans un plat pour le four puis les recouvrir avec la sauce.', 'Mettre le plat au four pendant 15 à 20 mn à 225°C (thermostat 7-8).', 'Parsemer le plat de cacahuètes avant de servir.'], ['Planche à découper', 'Mixeur', 'Moule à tarte', 'Verre doseur', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'filet de poulet', 'très facile', 'lardons', 'bon marché', 'légumes', 'plat', 'recette', 'Poulet aux cacahuètes et à la banane', 'cuisine', 'recettes', 'boisson', 'margarine', 'dessert', 'plat de résistance', 'champignons de Paris', 'cocktail', 'cacahuète grillée'], 'Plat principal', 1e7477bb-10c9-4391-8228-9382afdf9341, '2025-09-26T17:16:07.766253', [{'ingredient_id': '4aa4cedc-d9df-4329-b002-1efd8efe2f96', 'quantite': '600 g'}, {'ingredient_id': 'a904c541-280f-4108-8c4c-203d263f2af5', 'quantite': '200 g'}, {'ingredient_id': 'adcc2dd4-84a5-484a-975f-780a224903d1', 'quantite': '200 g'}, {'ingredient_id': 'c4e691ea-430a-4209-a7f5-e54731d303ea', 'quantite': '2'}, {'ingredient_id': '3d1122ff-7e77-46fb-8791-2588d7c8f86c', 'quantite': '10 cl'}, {'ingredient_id': '5ee8cb25-5c76-438c-a2e6-a8ae958e130b', 'quantite': '25 cl'}, {'ingredient_id': 'd33b430c-3b54-475a-9724-2a8cee7bc563', 'quantite': '3 cuillères'}, {'ingredient_id': '074e7d05-1e5e-4b6b-bdc8-71c5326d9a6c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28195, 'Parfait glacé à la banane', 'banane, sucre glace, jus de citron', '15 min', ['Mixer la chair des bananes et ajouter le sucre glace et le jus de citron, jusqu’à l’obtention d’une crème onctueuse.', 'Verser dans un moule et le placer dans le congélateur pendant 3 h.', 'Remuer de temps en temps à la fourchette pour éviter les cristaux.'], ['Râpe', 'Planche à découper', 'Presse-agrumes', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'parfait glacé', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Parfait glacé à la banane', 'jus de citron', 'sucre glace', 'cocktail'], 'Dessert', 8461cda4-e8c7-405f-ab26-2b37b64c49a2, '2025-09-26T17:16:11.229674', [{'ingredient_id': '067701e0-6f57-4eb7-adbd-4754927f3b6f', 'quantite': '8'}, {'ingredient_id': 'a9ee5bab-6151-47f5-8ac8-9e21900d2daf', 'quantite': '250 g'}, {'ingredient_id': '0b1583fd-80bc-4d62-8d82-5e67065a3201', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43582, 'Tagliatelles en sucré-salé', 'tagliatelles, sauté de veau, oeuf, banane, poivre, sel, harissa, sauce soja', '50 min', ['1. Coupez les sautés de porcs en fines lanières. Salez, poivrez et faites-les cuires à la poêle.', '2. Préparez une omelette avec les oeufs (salée et poivrée). Quand l''omelette est cuite, coupez-la en fines lanières.', '3. Allumez et préchaufez le four à 150°C (thermostat 5).', '4. Faites cuire les tagliatelles dans une casserole d''eau bouillante salée.', '5. Pendant ce temps, pelez les bananes, fendez-les en 2 sur la longueur, et faites-les dorer dans une poêle avec du beurre. ', '6. Disposez le tout dans un plat allant au four (sauf bananes).', 'Ajoutez une pointe de couteau de harrissa, 4 à 5 belles cuillères de sauce soja, et posez les bananes par dessus.', '7. Enfourner à 150°C (thermostat 5), pendant environ 10 min.'], ['Planche à découper', 'Rouleau à pâtisserie', 'Passoire', 'Économe', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'Tagliatelles en sucré-salé', 'oeuf', 'plat', 'recette', 'sauté de veau', 'cuisine', 'recettes', 'boisson', 'tagliatelle', 'dessert', 'plat de résistance', 'poivre', 'tagliatelles', 'harissa', 'cocktail', 'sauce soja'], 'Plat principal', a53b00b0-8fcd-4d91-a4f5-87fef84a8a9c, '2025-09-26T17:16:15.918094', [{'ingredient_id': '9e11c7ca-92e2-46b6-8739-4c175fdc9be4', 'quantite': '500 g'}, {'ingredient_id': 'ed6538de-bf92-40eb-842f-2129790709fc', 'quantite': '4'}, {'ingredient_id': '12d7e320-0fee-4540-8f50-9a9abc6823a9', 'quantite': '4'}, {'ingredient_id': '98340357-5a79-470e-9083-21cdf9f315a3', 'quantite': '4'}, {'ingredient_id': '821770a0-acc5-4be8-b464-7debbfc04feb', 'quantite': ''}, {'ingredient_id': '28436d0d-7744-4d4a-956b-69bc47906a81', 'quantite': ''}, {'ingredient_id': 'fdaccee2-6f7c-4235-bc58-99041b4dd530', 'quantite': ''}, {'ingredient_id': '814cc759-e7f2-4db0-8c9c-dfd96dc95dbf', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55174, 'Tamales à la banane (tex-mex)', 'margarine, farine de maïs, lait concentré sucré, oeuf, levure chimique, banane, copeaux de chocolat, cannelle, jus de citron', '15 min', ['Battez la margarine en pommade avec la levure.', 'Ajoutez l''oeuf et un peu de lait concentré sucré en continuant à battre.', 'Continuez d''ajouter le lait concentré petit à petit, puis la farine petit à petit en battant toujours.', 'Vous devriez obtenir une sorte de crème bien épaisse que vous réservez de côté.', 'Dans un bol, coupez la banane en petits dés (environ 5 mm de côté), mélangez avec un peu de citron pour éviter l''oxydation.', 'Ajoutez le chocolat et la cannelle, mélangez bien.', 'Coupez une bande de papier sulfurisé ou aluminium d''environ 10 cm de large.', 'A une extrémité, déposez une bonne cuillère à soupe de pâte à tamales et étalez la en un carré d''environ 10 cm de côté sur 5mm d''épaisseur avec le dos d''une cuillère trempée dans l''eau.', 'Déposez une cuillère à café de farce à la banane et repliez le tout en un triangle.', 'Continuez d''enrouler le triangle dans le papier comme si vous faisiez un samossa.', 'Si vous n''y arrivez pas, faites des petites papillotes carrées, c''est tout aussi bon.', 'Procédez de même avec le reste de la pâte et de la farce.', 'Vous devriez obtenir au moins douze tamales.', 'Cuire les tamales 30 minutes au cuit-vapeur.', 'N''ayant pas de cuit-vapeur, je transforme une barquette de cuisson en aluminium en panier vapeur en le trouant à la fourchette.', 'Je verse de l''eau au fond d''une casserole où je place le "panier" en équilibre sur le rebord.', 'Je couvre, c''est presque aussi efficace.'], ['Batteur électrique', 'Fouet', 'Verre doseur', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'Tamales à la banane (tex-mex)', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'lait concentré sucré', 'boisson', 'margarine', 'dessert', 'plat de résistance', 'jus de citron', 'farine de maïs', 'copeaux de chocolat', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T17:16:19.553830', [{'ingredient_id': 'e2be8166-50b0-45ac-80f8-f1fcf4a16108', 'quantite': '80 g'}, {'ingredient_id': '93e7a309-1cd1-4dbc-84be-f2808e726097', 'quantite': '170 g'}, {'ingredient_id': '63e6724d-9845-4be6-b8bd-0adf2e2d4626', 'quantite': '130 g'}, {'ingredient_id': 'eaeedbe5-1058-40fc-9e9d-32476ff2ef11', 'quantite': '1'}, {'ingredient_id': 'bb78c404-9482-4c43-aff4-350b2d6621d3', 'quantite': '1 cuillères'}, {'ingredient_id': '05dd44c9-5f04-412e-bae9-6ed9a28bc28b', 'quantite': '1'}, {'ingredient_id': 'aca8e787-4994-4535-be37-29c2915d2278', 'quantite': '1'}, {'ingredient_id': '037cfa60-4c9e-409c-a8f6-023800e371de', 'quantite': '1 cuillères'}, {'ingredient_id': '9f10885f-292b-4e81-b4b0-a005865ee378', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37252, 'Miam miam de banane et flocons d''avoine pour bébé', 'banane, flocons d''avoine, fruits', '10 min', ['Faire pocher la banane ou la cuire à la vapeur.', 'Egoutter et garder le bouillon de cuisson.', 'Mixer la banane cuite, les flocons d''avoine, le jus de fruits et entre 5 à 7,5 cl de bouillon de cuisson selon la consistance désirée... ', 'Mieux vaut mettre le bouillon de cuisson petit à petit que trop en mettre et obtenir une compote trop liquide...'], ['Balance de cuisine', 'Verre doseur', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'Miam miam de banane et flocons d''avoine pour bébé', 'boisson', 'dessert', 'plat de résistance', 'fruits', 'flocons d''avoine', 'cocktail'], 'Dessert', 65f1c343-e8a1-4519-b861-374a46b9fa8e, '2025-09-26T17:16:23.114176', [{'ingredient_id': '14dd8793-6054-45b0-85c9-28495a7d9b77', 'quantite': '1'}, {'ingredient_id': 'b83a1f83-1fb9-44a6-ab0c-0a6a3c715584', 'quantite': '2 cuillères'}, {'ingredient_id': '96b5b6f2-5b9d-4a0e-919c-a38caa1263bb', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29471, 'Poulet sucré-salé à la banane', 'pilon de poulet, lard, oignon, tomate, poivron vert, banane, noix de cajou, piment de Cayenne, huile d''olive, poivre, sel', '30 min', ['Désosser les pilons de poulet. Rouler chaque morceau sur lui même et l''enrober d''une tranche de lard. Fermer avec un cure-dent.', 'Chauffer une cuillère à soupe d''huile d''olive dans une grande poêle assez profonde. Y mettre à dorer les morceaux de poulet en les retournant sur toutes les faces (4 mn).', 'Retirer le poulet et y mettre les oignons coupés en fines lamelles. Baisser le feu et faire légèrement compoter (5 mn).', 'Ajouter les tomates et le 1/2 poivron coupés en dés, puis laisser mijoter 5 mn.', 'Ajouter ensuite les morceaux de poulet, les bananes coupées en tranche moyenne, une pincée de cannelle, une pincée de piment et un peu d''eau. Couvrir et laisser mijoter à feu doux 20 mn.', '5 mn avant la fin de la cuisson, ajouter les noix de cajou grossièrement concassées.', 'Servir avec du riz blanc.'], ['Balance de cuisine', 'Verre doseur', 'Moule à tarte'], ['', 'noix de cajou', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'poivron vert', 'très facile', 'bon marché', 'Poulet sucré-salé à la banane', 'tomate', 'plat', 'recette', 'cuisine', 'pilon de poulet', 'recettes', 'oignon', 'boisson', 'lard', 'huile d''olive', 'dessert', 'plat de résistance', 'piment de Cayenne', 'poivre', 'cocktail'], 'Plat principal', f0271496-c566-4e33-a4e1-fad6ec651a1c, '2025-09-26T17:16:26.821825', [{'ingredient_id': 'ff3702aa-28bd-4af9-8255-e22606c7419f', 'quantite': '8'}, {'ingredient_id': '18045ffb-9c98-4aad-b437-39aa4b42d089', 'quantite': '8'}, {'ingredient_id': '08ee171d-99a1-4b57-b17c-bd46d631347f', 'quantite': '3'}, {'ingredient_id': 'f62f4ffd-e069-488a-850d-789a29ee71cd', 'quantite': '4'}, {'ingredient_id': 'a6a440da-4ca2-4b70-91a6-ce6d6ed5258a', 'quantite': ''}, {'ingredient_id': 'b7884e05-a2a5-4d1e-8056-1c6345c52b96', 'quantite': '2'}, {'ingredient_id': '1c68c66b-16f9-4fed-95fd-9364054efa8a', 'quantite': '2 cuillères'}, {'ingredient_id': '1dd9e346-f54d-4b8a-9d8e-0441e7a8b0dc', 'quantite': ''}, {'ingredient_id': '2c93b39a-e23b-4adc-b74f-502d304fda2c', 'quantite': ''}, {'ingredient_id': 'a60047ca-ca80-4671-91ab-83294f573607', 'quantite': ''}, {'ingredient_id': '44528316-7675-49b8-83c1-44c742b697ed', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33686, 'Pilaf de volaille à l''indonésienne', 'poulet, riz, pomme, banane, orange, ananas, oeuf, crème, oignon, carotte, échalote', '35 min', ['Cuire le poulet à l''eau salée aromatisée d''un oignon piqué, une carotte, un bouquet garni et 10 grains de poivre. ', 'Lorsque le poulet est cuit, le retirer et le laisser refroidir. Après avoir enlevé la peau et les os, découper la chair en dés de 2 cm, les passer au beurre avec un échalote et une pointe de poudre de curry. ', 'Cuire le riz dans 3 fois son volume d''eau salée. Le rafraîchir après la cuisson. ', 'Faites revenir au beurre (35 g) une échalote et une pomme hachée avec une cuillère à café de curry. Mélanger avec 45 g de farine et verser 1/2 litre de cuisson du poulet. Laisser cuire et rectifier l''assaisonnement. ', 'Au moment de servir, ajouter 1 dl de crème et un jaune d''oeuf à la sauce obtenue. ', 'Dressage: ', 'Beurrer une timbale. Tapisser l''intérieur avec une couche de riz de 2 cm d''épaisseur. Verser le poulet préparé. Recouvrir de riz et passer 1/4 heure au four. Demouler sur un plat rond. Verser la sauce dessus et garnir le plat avec des demi-rondelles d''ananas, les quartiers d''oranges pelées à vif et des rondelles de banane.'], ['Râpe', 'Planche à découper', 'Passoire', 'Casserole'], ['poulet', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'carotte', 'plats indonésiens', 'facile', 'oeuf', 'plat', 'crème', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'riz', 'pomme', 'moyen', 'orange', 'ananas', 'Pilaf de volaille à l''indonésienne', 'cocktail', 'échalote'], 'Plat principal', 256e261b-a0ce-4624-b6a0-779fae30ecf3, '2025-09-26T17:16:30.960796', [{'ingredient_id': 'f108ec0a-7bbe-40b9-a6ee-ef195c7d71af', 'quantite': '1'}, {'ingredient_id': 'b01f5524-15ad-428c-aa80-a90bf99c0145', 'quantite': '250 g'}, {'ingredient_id': '2193e6f6-11da-4ff7-9abf-75f898a5b3e5', 'quantite': '1'}, {'ingredient_id': '9ee39fc9-69f5-4b9b-b3e8-f6b2ebc1d895', 'quantite': '2'}, {'ingredient_id': 'b3438fa5-8a1a-4c7a-b5bc-3f92039d05b1', 'quantite': '2'}, {'ingredient_id': '948c8cf5-3147-4586-8f7f-1b6860bf911d', 'quantite': '1'}, {'ingredient_id': '9c70d89f-2f8f-4f4b-beed-56d0d640b7dc', 'quantite': '1'}, {'ingredient_id': 'b6fa97fa-afad-4ed5-ab5f-5fe371e4ebf9', 'quantite': '1'}, {'ingredient_id': '1da66e45-6296-428c-9321-ee4b6d181571', 'quantite': '1'}, {'ingredient_id': '5089adc5-cd85-4cd2-93bd-13807a2351f1', 'quantite': '1'}, {'ingredient_id': '1c7c446b-afa6-41ac-a3eb-680d73fab699', 'quantite': '2'}]);
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (328674, f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, 'Hum exellent  ', '2019-01-29T07:32:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 092d8eca-81fd-4837-a854-277ee216c4ea, 'Excellent quand on y met sa touche personnelle : en quartiers, en rondelles ou en bâtonnets, peu importe : épluchez, coupez, mettez dans un grand tupperware avec l''équivalent d''une à deux cuillères à soupe d''huile d''olive, sel, poivre, persillade, paprika ou selon l''envie (curry, etc...) et secouez ! Les pommes de terre sont bien imprégnées de tout. Disposez sur papier sulfurisé et au four 30 min à 180°C environ selon l''épaisseur de la découpe. Résultat : du goût, de la saveur, du moelleux, bref... un régal !', '2016-06-28T22:51:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, d22fc4ca-d5f0-47b4-9a99-b3fe4fa67d19, 'Parfait !! J’ajoute avec les pommes de terres toutes sortes de légumes : brocolis, carottes par exemple 
Puis filet d’huile d’olive, sel poivre et paprika fumé c’est juste un délice !! ', '2023-05-18T13:16:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 39d677f9-c64b-4bc1-9f15-dc78e050ba98, 'Simple, efficace et tellement bon !
J''ai mis dans un sac congélation avec huile d''olive et herbes de Provence on secoue et hop !', '2019-04-14T08:19:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 52df7a61-952e-4a58-8906-3907542a509a, 'parfait pour accompagner un BBQ, avec un filet d''huile d''olive et des herbes de Provence/ thym', '2023-05-24T19:44:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, caa82e6a-5ef6-4d8a-9968-a9747f23a5f0, 'Simple, mettre le fromage avant la fin de la cuisson. C''était très bon avec du reblochon.', '2020-09-23T15:45:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 629f4515-60b0-4e77-8cae-8e908f06a70f, 'Les pommes de terre au four, ou les pommes de terre "pouf" comme on dit à la maison. C''est un grand classique dans la famille pour accompagner les grillades de l''été. Dans l''assiette, on ouvre la pellicule bombée sur le dessus et on y glisse un peu de beurre... Humm délicieux. Les enfants adorent et les adultes aussi.', '2019-05-15T17:59:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, b872a2b9-f2b4-44c4-8030-62d9e7fe4a4c, 'Très bon ', '2023-03-27T11:24:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, db85a09a-009c-4fd4-86a1-84074a1f36db, 'Trop bon', '2023-02-05T21:27:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 4df8acf8-461a-40e4-b24e-066c0b43e1a1, 'Super !', '2022-10-28T09:31:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 2d382573-095e-40d7-b79e-fb15fbf3ee3c, 'Facile et excellent. À refaire.', '2022-09-18T13:55:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 88829301-f48d-4ecb-855b-358830010547, 'Simple et très bon', '2022-02-26T12:58:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 0404b30e-c86e-4417-9321-168a9312eb74, 'Facile, rapide et bon... Des invités à l''improviste, cela accompagne très bien une omelette !', '2021-09-13T13:12:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 12016f3e-583d-40dc-8cb5-3f7f3535038f, 'Parfait ! En réponse à Moulig_91 j''ai mis mon four entre 180 et 200° ( thermostat 6/7 )', '2020-08-20T19:25:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, e4fcffb0-d9ca-4785-9c89-0e007d5693dd, 'Excellent ! Avec une marinade huile d''olive et ciboulette, et un peu de gros sel. Temps de cuisson plus long avec mon four, 50 mn. Tout le monde s''est régalé. ?', '2020-02-09T03:34:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 6824e166-593d-429e-b388-8bb8ebe170c7, 'Excellent et facile ! Je plussoie l’idée du sac congélation, on met tout dedans, on secoue et hop ! Un bon repas prêt en 35 minutes. Avec un peu de parmesan râpé et de la crème fraîche, miam !', '2019-08-10T10:18:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 15cac1a4-10b4-4ba9-9940-8317d0095c5f, 'Pas mal, mais écrire "sans graisse"... Si ce n''est les 30% du fromage', '2019-03-28T13:15:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 79a6a259-9332-4e53-a861-86876b80a25b, 'Prendre plutôt des petites pdt pour 30 mns de cuisson et délicieux avec du saint nectaire (une bonne tranchette sur chaque)', '2019-03-15T14:09:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 67a29910-58c9-4a6b-b96a-3ca6a9ef633a, 'Excellente recette.  Un vrai régal simplissime ! A refaire  !', '2018-09-30T03:54:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 315213b8-d88b-4e05-a90f-c1983f208323, 'Super facile merci beaucoup ! Rapide et simple et surtout un régale.', '2018-04-07T13:52:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, a65cacb7-d9f3-41c2-8c3f-8749b9dceb36, 'Plus personne ne veut les pommes de terre autrement ! L''astuce de l''huile dans boite hermétique pour les enrober légèrement c''est top!  Bien rôties, c''est plutôt 40 minutes à 180°C.', '2017-01-26T13:15:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, bdb0e076-4668-485e-8944-e7fcbb4a31a5, 'Comme beaucoup d''autres personnes, j''ai, moi aussi, fait macérer les pommes de terre épluchées et coupées en grosses tranches avec huile olive, herbes de Provence, sel, poivre, épices diverses (curcuma, paprika), puis cuisson à 180°C (thermostat 6) pendant 45 minutes ....un pur régal! Merci pour cette recette. ', '2016-02-21T21:34:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 3fa4ef09-620c-4c63-880c-c890fb28b44d, 'J''adore, je la refais et la referai encore ! Je mélange dans un saladier pour plus de facilité comme indiqué dans un commentaire, bref j''adhère.', '2015-11-01T12:12:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, e2fc1831-6ce8-432c-860c-570c9c3707fe, 'Tout simplement excellent ! Avec un peu de fleur de sel en fin de cuisson et très bien pour accompagner une bonne viande rouge.', '2015-02-13T20:53:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 077a803f-7261-4f0f-a4bf-24bc9086ad96, 'Si vous souhaitez déposer une légère couche d''huile (je conseille l''huile de noix) sur vos pommes de terre, mettez-les dans un saladier fermant avec un couvercle ; y ajoutez une cuillère à soupe d''huile, fermez le couvercle et agitez vivement. Vous pouvez y ajouter des herbes, du gros sel, des épices...', '2014-11-18T19:07:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, e7e0a95e-de1f-41e3-9434-602ade953d6e, 'Une valeur sûre et simple à préparer. Meilleur avec un peu d''huile d''olives et des aromates. Pré-cuisson inutile. ', '2014-06-07T23:09:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, c985224a-b734-475c-97b0-d1c10914996a, 'Je fais toujours mes pommes de terre en casserole à l''eau ou sautées à l''huile dans une poêle, j''ai voulu changer pour les faire au four : bien meilleur. On sent bien le goût et rappel les pommes de terres traditionnelles de campagne servies dans les patateries (oui ces restaurants existent). Nature et pas une goutte de graisse, le top !', '2013-10-11T20:40:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, f22ea512-e2dc-4be7-93fb-3388f73df431, 'Une très très bonne idée d''accompagnement. A servir avec une sauce crème fraîche-ciboulette. TOP !', '2013-08-16T01:04:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 27082636-a9e4-4a2e-97cc-7401ceaefd04, 'Ha oui ! C''est vrai ! Je vais faire goûter aux enfants, c''est délicieux et ça change ! Merci', '2013-04-25T16:34:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 14cb265e-733f-4925-b3df-4a989763a1b9, 'Super bonne recette, je l''ai faite avec des truites (un régal) et j''ai rajouté de la persillade sur le dessus. La prochaine fois j''essaie avec le fromage.', '2009-05-08T22:20:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 2a274519-aac0-45e9-939f-c5fc1196465a, 'Très facile à réaliser et excellent. J''ai fait cuire 50 minutes à 200 degrés. Ce n''est pas gras du tout et c''est assez original.', '2008-02-14T21:54:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, bab0499f-cdcd-4256-946b-2a1f476f7a31, 'Excellent!  Pour ma part, j''ai ajouté une sauce à base d''oignons, d''ail, d''herbes et de crème fraîche.', '2008-01-18T21:55:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 15560e6a-4872-44de-859e-c2d1d50d9cca, 'Excellent! Tout bête mais vraiment bon. Les pommes de terre sont à la fois moelleuses et dorées. Nous les avons mangées avec des saucisses et du yaourt.', '2007-08-02T19:16:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 2839d3e3-9050-4f85-97de-a32601c72465, 'C''est croustillant à l''extérieur, onctueux à l''intérieur. A faire pour accompagner toutes sortes de roti.', '2007-06-03T16:27:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 46c2830b-1ed1-4d34-a95f-20ecf0cb446a, 'Délicieux 👍', '2023-10-30T12:40:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 3fa02a05-3b09-4837-b113-266f8b737dae, 'J aime ', '2023-10-09T06:41:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, f438e0d6-5074-4cb8-86af-e5b8d2c433be, 'Niquel❤️❤️❤️', '2023-03-06T16:36:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 3f6c6799-5234-4406-8421-b8e1fd09fbd2, 'Épatant ! Juste avec un peu de sel pour accompagner un plat en sauce. J’ai hâte d’essayer tous les trucs des autres commentaires. ', '2023-01-10T08:03:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, ab015389-2cc8-43ad-83ed-d2a91ce29498, 'Facile et délicieux.', '2021-08-22T20:57:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, bda66c3d-10aa-4b53-a65c-5ccb86777708, 'Temps de cuisson nécessaire beaucoup plus long qu''indiqué dans la recette (compter une bonne demie heure en plus au moins). ', '2020-12-12T21:41:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, ba1de9e0-3f7a-4cc9-b08b-f2e6a2ff3bb7, 'Moi je les vides je fais une purées avec la chair je rajoute du jambon et du gruyère je remets tout ça au four c''est super bon.', '2020-11-11T18:13:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 22647e7a-dcb0-41c5-b2e1-412764acfc88, 'Délicieux et économique !', '2020-09-20T21:54:25+02:00');
