INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 40cedd53-8e34-4345-abea-77cfb8d76519, 'Beaucoup trop de beurre et temps de cuisson pas du tout adapté.', '2020-11-07T14:41:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 22764db9-1d5b-4823-8438-26fe56f291fc, 'C’est super bon, au premier essai j’ai écouté les commentaires et mis 100g de sucre, pile poil ce qu’il faut. Parsemez les pommes de cannelle, c’est un délice! ', '2020-07-23T01:41:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 81cd0def-9fc1-4766-96c7-eb925a654795, 'Essayé et adoré ! Juste un peu moins de sucre mais un délice ! ', '2020-07-17T20:53:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, aaab099a-e1e4-4607-9f7a-094304797043, 'Diminuer un peu la quantite de sucre, mais sinon super bon et super facile!!! ', '2020-06-12T19:26:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, b3a75cb1-bc13-4c74-9cee-60df76498c8c, 'Recette réussie avec de la cannelle et un lit de raisins secs sous la pâte. Attention, pas de raisins sur le dessus car ils vont brûler. Recette à tenter également avec des fruits rouges.', '2020-04-22T21:10:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 3c4d120c-2f52-45f8-992b-488e16716b48, 'Super bon, cependant j’ai mis la moitié de sucre c’est à 150g j’ai remplacé par du sucre roux, et j’ai dû mettre 35mn à 180 degrés et pas 20mn.', '2020-03-29T17:54:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 3d1bfb3c-f8a7-4a28-8f65-c24053a02874, 'Mettre moitié moins de sucre effectivement mais très bon!', '2020-03-27T19:54:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 7fd235b9-6cbd-4717-a268-fb7f02e95290, 'J''ai fait la recette hier avec les quantites requises il faudrait mettre moins de pate a crumble sur le dessus !', '2018-09-27T10:21:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 9241e05e-6fa4-4f43-8b38-ab5459cf5dfa, 'Parfait on s''est régalé. J''ai suivi les conseils et ai mis 100g de sucre (roux pour ma part) et j''ai plus de carré de chocolat. Toute la famille a apprécié petit comme grand.', '2018-08-21T00:14:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 1d2ad5f1-1130-40e1-b8d3-979f5c31cb00, 'Très très bon et comme plus loin dans les commentaires: Juste la moitié du sucre !', '2017-11-28T22:34:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, f155c739-f46e-4926-8eb3-623039b04efc, 'Super recette facile à réaliser et très bonne !', '2016-10-26T18:46:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, f208399b-529d-43fb-8006-4c3f4874a675, 'Merci pour cette recette simple et délicieuse... Petits et grands étaient conquis! À refaire.. ', '2016-07-20T14:01:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 585a6af1-fc9f-4364-a4e3-522ab81e4172, 'Trop bon !!! Tout le monde a adoré, il seraiy bien de le refaire mais en divisant le sucre par 2.', '2015-11-29T19:54:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, c5b29d46-c78a-475d-bfde-ff544e22a01f, 'Super bon avec 100 g de sucre et 30 min de cuisson. A refaire !', '2015-09-12T16:48:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 9a3122a0-24b1-42b8-8971-c4351d65a0d4, 'Crumble excellent et tellement simple ! J''ai également mis moitié moins de sucre et on pourrait même en mettre moins avec le chocolat noir qui sucre bien !   A refaire encore et encore, merci pour la recette !', '2015-02-03T16:38:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 8b3a428f-a92b-480c-853f-1d05acfa6562, 'Recette délicieuse ! J''ai fait revenir mes pommes dans du beurre salé avant. J''ai ajouté deux sablés bretons dans la pâte c''est un vrai régal ! ', '2014-10-19T17:51:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 37569948-c1b8-4b54-b0ce-595ddf3e6b9f, 'Fait avec du chocolat blanc et moitié moins de sucre (je n''aime pas les desserts trop sucrés, je divise systématiquement par 2) : excellent ! On n''avait plus faim, mais on s''est resservis quand même !', '2014-06-02T00:12:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 982ec7ca-f5b9-4b07-952e-e419561d1dd8, 'Recette de base idéale, j''ai utilisé moitié sucre blanc, moitié cassonade belge ainsi que de la pralinoise pour le chocolat et je n''avais que 2 pommes mais ça allait. J''ai juste rajouté un peu de poudre d''amandes qui me restait à la pâte à crumble. Temps de cuisson nickel, recette facile à décliner, j''essaierai de la refaire dans des petits moules la prochaine fois. Se marierait bien avec une crème anglaise ou une petit boule de glace vanille, à tester plus tard ! Je recommande vivement cette recette facile qui en jette ! ', '2014-05-11T20:24:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 51e3f57d-c239-40ad-9060-dd32a1621208, 'C''était mon anniversaire et j''ai préparé ce crumble pomme/chocolat. Les petits comme les grands ont adoré cette recette ! Croyez-moi, je vais la recommencer... et pas qu''une seule fois !', '2014-04-29T01:58:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, d5d800e0-4c9c-4f46-9181-5652cd966445, 'Un vrai succès. Facile et excellent.  ', '2014-02-27T21:56:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, fd682e71-d100-4cd9-9f11-34cafaeeb17e, 'Voilà !! C''est fait et c''était vraiment super bon !!', '2013-12-01T19:02:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 0e4fe8e7-4a0e-4299-907a-85f86e863edb, 'Super bon ! Les enfants en redemandent encore et encore... Je recommande vivement. ', '2013-11-21T13:36:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, c68c3945-5592-45b3-9ac8-f5f622c4728c, 'Excellent. Un de nos desserts préférés...', '2013-10-09T20:29:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 6ddfd562-b773-45c2-aa8c-3a18e91aa502, 'Très facile à faire mais pas super bon. D''après moi.', '2013-06-26T18:18:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 8c23b343-f62f-4f8e-a618-fb8c44128d7b, 'très bon gâteau. léger et facile à faire.', '2013-03-10T20:33:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 9846bdd5-38b9-4146-86bb-87f89d34c1a5, 'Que c''est bon ! en plus c''est inratable !', '2012-12-11T21:53:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 166b3a4e-327d-4c14-b58d-ca55840cfee3, 'C''est une recette simplissime et tellement bonne ! Succès garanti, avec une poire en plus c''est succulent. Je fais régulièrement ce dessert à mes invités, un sans faute à chaque fois et le cœur surprise au chocolat épate tous le monde. A tester absolument !', '2012-01-29T21:27:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 72246bbb-863d-4d59-ae36-6a320a302cce, 'J''ai pris la liberté d''ajouter une cuillère de concentré de vanille, le jus de 3 mandarines, et du jus de citron dans les pommes !  Je vous conseille vraiment cette recette, elle est simple, facile, pas cher et rapide!', '2012-01-27T12:23:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 479c18b8-026b-4666-b451-2643d2696312, 'Délicieux ! C''est LE dessert pour les gourmands de fruits et de chocolat.', '2011-06-13T16:28:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, c7bacd22-8f46-49d8-bc94-5a5b0fd3eb95, 'Super bon ! J''avais plus de beurre alors j''ai mis 120 g de beurre salé et c''était juste excellent ! A refaire de toute évidence !', '2011-05-11T16:14:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 26449ea2-27f1-4251-9294-9196d224437b, 'Trop bon et très facile !', '2011-03-20T17:57:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, dd41d824-9e56-44d9-a46d-d80f20e640c8, 'Un vrai régal. Simple et délicieux. Le plus:avoir la surprise de tomber sur un carré de chocolat fondant. Ne rien changer.', '2010-11-16T18:01:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 5e69f28f-ee6e-49fd-92da-94d499ae3bab, 'Et encore c''est parce que je ne peux pas mettre un 6... c''est devenu le dessert de référence à la maison. D''une simplicité à toute épreuve, je rajoute un fond d''eau et je mets 30 au lieu de 20 min pour la cuisson, un véritable régal... merci !', '2010-04-24T00:00:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 110e7c6b-e46d-48dc-9033-d345eca8c480, 'Trop, trop bon ! Si je pouvais, je mettrais même 6/5 ! Délicieux tiède avec une boule de glace à la vanille.', '2010-04-13T18:08:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 8c329747-6611-44d2-b46a-dcbfaf0bdf87, 'Un délice ! C''est la première fois que je faisais un crumble et il était parfait. Rapide et très facile, une recette que je garderai sous le coude...', '2010-03-08T20:59:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, f647fe1c-2254-47f6-a883-c7f66379e4a3, 'Excellent, à refaire ! En grande gourmande, j''ai mis plus de chocolat, mais en fait, j''ai eu la main un peu trop lourde. La prochaine fois, je suivrai la recette à la lettre !', '2010-02-24T21:26:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 8ba4ae52-df6d-4a42-aa9a-3f18ba29fc59, 'Très bonne recette simple rapide et très appréciée de tous ;)', '2010-02-23T02:35:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 34925dec-289b-444f-9eb9-6b67e8807249, 'Très tès bon !  Par contre je n''ai pas eu le problème d''un trop plein d''eau...  J''ajouterai des pommes la prochaine fois pour diminuer quand même l''acidité.', '2009-12-17T09:46:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, ccd4fcf3-8d66-46cc-a2d9-efa39b177fa8, 'Très bon !', '2009-06-03T17:44:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, a1b321db-27cb-4316-95da-c8e1fb27feb3, 'J''ai rajouté deux pommes et la moitié de cassonade. Par contre, j''ai fait suivre les pommes avant. Si tout le monde a aimé. ', '2009-03-03T12:34:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, bfbc6856-8bb5-4468-9321-b0d34c0844c1, 'J''ai vraiment adoré et il n''y a pas que moi d''ailleurs, mais il faut le manger tiède c''est encore meilleur!', '2009-01-23T18:52:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 0dbb000e-0642-4767-af24-039d63f40355, 'Très bon, j''ai ajouté 2 cuillère à café de chocolat en poudre non sucré dans la pâte que l''on place dessus, c''est encore meilleur si on adore le chocolat!', '2009-01-12T20:52:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, e23036c4-10c5-4bd7-a60f-d0f5cb980cb1, 'Je viens d''essayer, et de goûter, c''est délicieux (le petit chocolat encore un peu tiède...hummmmm).', '2008-10-24T22:42:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 9dbce54b-6caf-429e-817c-267f8c0a36cf, 'Un très bon dessert, et surtout facile à faire. Idéal quand les placards sont un peu vides!', '2008-08-13T20:00:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 79e9bc6c-0c7a-494d-8981-fc969a975d7c, 'Bon gâteau, facile à faire !', '2022-11-16T07:26:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, b93ac60e-013a-4848-ad63-681670c43adf, 'Très bon gâteau, fait avec les pommes du jardin ❤ Excellent !', '2022-10-16T11:00:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, ace69de3-f573-4731-9a29-01498eac3c43, 'simple et bon! J''ai ajouté un peu de cannelle... ;-) ', '2021-03-29T21:59:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 99cb545c-98df-49b6-a169-6c3ef07deb50, 'Moitié moins de sucre et sans citron. Un régal. Par contre, nous avons mis 5 grosses pommes...', '2020-11-01T21:05:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, ac5778c1-916a-46d2-b4c8-75af567a3894, 'J’ai saupoudré les pommes de cannelle et je l’ai cuit 35 min. Vraiment très bon! Moelleux à souhait', '2020-09-27T15:52:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, fc251891-8e8b-45b5-957b-5ac93baff6b9, 'Très bon. Pour plus de légèreté, j''ai battu oeufs et sucre jusqu''à obtenir une mousse blanchie. Pour cette recette avec 3 oeufs, cela ne fait que 5 à 6 portions (8 pour des enfants !).', '2020-01-19T06:57:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 913ea889-03ab-48aa-9083-6c33a904c3d2, 'Vraiment pas terrible, temps de cuisson plus important (environ 40 minutes) et goût assez fade. Bien déçue', '2023-03-26T20:19:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, e53b62b5-e1d8-4cf2-9a41-d628f6d9554c, 'Je confirme, gâteaux délicieux, pas trop sucré et moelleux !', '2022-10-12T12:40:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 2189bf12-f575-47a2-b7e9-a8370105f339, 'J aime beaucoup les gâteaux aux pommes j en fais de temps en temps ', '2022-02-14T16:07:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, d6b43e96-0808-4924-9413-d94cb3120af4, 'Super ', '2021-11-16T01:50:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 4ad6b899-5aee-46c4-aab3-103c28b3e2a0, 'Bon gateau, facile à réaliser avec les enfants!', '2021-11-05T20:14:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 88eea4a2-5544-48ad-b4c6-ea80671ae8b1, 'C''est bon', '2021-05-10T11:30:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 3f24c7b8-d59d-4c29-81a3-9a4f5089647b, 'Super ! Tout le monde a bien aimé, bien mangé. Je l’ai fait avec des abricots en sirop et c’était très bon ! À refaire.', '2020-02-10T10:25:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 2cb4a5bf-d9b0-4fb5-8897-aadf94627a28, 'Super recette. Je fais ce gâteau très souvent... excellent !', '2019-09-24T12:51:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, a31b455a-03b3-419a-b35b-1dadce7e8122, 'J''ai remplacé le sucre par de la vergeoise blonde et c''était le top, j''y ai rajouté des fruits secs et c''était délicieux je pense que cette préparation peut s''adapter à bcp de mélange !
Je vais le tenter en mettant de la maïzena et du sucre de coco.... ', '2018-05-21T09:58:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 9f4550a1-972b-4e31-b6a4-81806745fa6f, 'Facile rapide et délicieux', '2017-12-24T18:20:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 7cee4b57-a596-4d97-a114-fef5be2a69c2, 'J''ai ajouté un sachet de sucre vanillé et je l''ai laissé 35-40 min au four et il était délicieux !!', '2017-05-18T20:52:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, ea702cbc-0eb2-4b2d-9a4b-98458d269dea, 'J''ai ajouté de la fleur d''oranger et des pépites de chocolat. Très bon, simple et rapide à réaliser, il peut être fait avec d''autres fruits. ', '2016-11-13T15:01:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, bbaa31c7-d9cf-4e39-95f7-e67fdb47d8e7, 'Rapport temps/résultat optimal pour un goûter improvisé amélioré ! Ne pas s''inquiéter si on a l''impression qu''il n''y a pas assez de pâte, elle gonfle bien à la cuisson. J''ai utilisé seulement deux pommes et rallongé le temps de cuisson (30-35 min)', '2015-08-30T19:07:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 250390c4-018e-4e95-a2d2-935bdb865902, 'Je viens de le faire ce matin. J''ai mis deux belles pommes mais pas de matière grasse. Simplement un yaourt au citron avec le zeste du citron râpé. Très light et quel délice !', '2015-03-28T16:22:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 29487015-17ed-4d87-a9fe-96219a8b335e, 'Top, tout le monde a adoré, j''ai ajouté un peu de rhum, de la vanille et cannelle c''était délicieux ', '2012-12-31T14:25:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 34cab9cc-65eb-46a6-867c-0139e92dec87, 'Simple, bon et moelleux. Parfait.', '2020-09-09T23:45:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, c3033dbc-d119-4223-a4bd-7e81729f0265, 'Vraiment excellent et recette facile', '2020-06-26T13:28:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 093f2316-8d8a-4168-b23a-9b287637aa0f, 'Bonne recette', '2020-05-17T11:21:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 2f17c902-3b65-4aa3-b576-abc281808e22, 'Excellent et hyper simple !! Merci.', '2020-03-05T17:32:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 0a2ebd63-ff58-42f5-a7dc-60418127f6b7, 'Très bon gâteau.', '2019-12-29T04:25:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 150106df-0bda-48aa-9c35-4defb9d39654, 'Le gâteau était très bon et bien moelleux un régal !', '2019-11-24T04:20:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 127bdd09-6fcf-4976-8fa6-c361659419f1, 'Super ! Moelleux, le gâteau n’est pas sec, parfait.', '2019-10-30T13:36:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 58b260a6-8398-46fa-8157-aaec7a12a131, 'Superbe et simple recette. Mes convives ont adoré !', '2019-09-03T01:13:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 8a5e5f0b-7b61-4492-97f5-4a15b6157387, 'Très bon, les pommes sont bien fondantes, la pâte moelleuse.', '2019-08-22T21:01:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 78913d9e-b720-40a5-be02-56c5dde560de, 'Très bon et rapide à faire. Et j’ai toujours tout à la maison donc c’est pratique pour faire un gâteau improvisé.', '2019-07-29T10:33:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 7323d3e6-8749-44c6-b399-6ade5ac30d75, 'Ce gâteau avait bon goût mais un peu trop sec.', '2019-06-02T06:15:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 6762de0d-56ae-4fd2-a9d9-afe1176e4b32, 'Délicieux...', '2019-04-09T05:02:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 72e003d7-4230-426d-9807-b882d32761cd, 'Très très bon.', '2019-03-27T02:46:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 41938ee0-f03c-428e-9d94-2869df67f866, 'Le gâteau n''a pas levé, très sec et s''émietté. Complètement raté !', '2019-03-18T09:41:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 02b4b26a-37ba-400f-ade2-c80947c68f87, 'Très bonne recette mes collègues on adoré,  à refaire', '2019-02-28T02:54:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 458d61e2-5f71-4c25-9499-7adb93930045, 'J''ai eu peur qu''il soit sec mais pas du tout il était vraiment bon, à refaire.', '2018-12-15T06:54:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 904693dd-9f25-46e9-b24d-9388a39980cc, 'Recette suivie à la lettre, bluffée, le gateau est vraiment moelleux. Dosage sucre parfait, le goût des pommes est présent. A refaire !!!', '2018-12-09T07:46:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, c2b61083-cb40-425d-958e-b51dd1ffbe78, 'Très bon et simple à faire, j''ai rajouté un peu de cannelle dedans, ça s''est très bien combiné !', '2018-10-11T06:49:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 9e31f141-7c1c-4ba9-bf3f-8fc13782b0ae, 'Excellente recette, facile à faire et gâteau super bon .', '2018-08-13T11:32:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, f2da2973-d707-4415-9c99-df9d69fede07, 'Gâteau très facile à faire, rapide et bon.
Excellent a tout instant, trés apprécié par mes convives.', '2018-06-07T07:58:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 7e72abcb-4c60-439d-8727-d462dfaf4c56, 'Très bon gâteau très simple mais c''est une valeur sûre. A refaire sans hésiter !', '2018-05-30T12:40:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 6c74b7c1-ac03-4b8b-8f5c-8955ad3df848, 'Bon !', '2018-05-04T07:51:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 23fbbe4d-4876-44a6-b8c6-953fec4e7c70, 'Recette suivie à la lettre. Excellent.', '2018-04-11T03:13:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, e9de357d-c83c-4a59-bd55-c06c1c59d1ef, 'Gâteau inratable, léger, un classique pour celles qui ont peu de temps !', '2018-03-31T16:36:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 644527aa-7ad9-4ba8-bf86-a8124fa80f4a, 'Excellent. J''ai cuit 30 min.', '2017-02-20T21:28:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 444d574e-f578-41b4-b482-df04cf3c35aa, 'Gâteau simple et rapide à faire. Il a plu à tout le monde !', '2016-10-26T18:52:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, a7a601a1-2c6a-4f01-8232-e9b636f07308, 'Rapide en effet et délicieux ', '2016-05-19T11:39:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 4005782f-ebd6-4193-8bd9-6e0a5b10087c, 'J''ai fait fondre le beurre à part dans un bol et j''ai ajouté à l''appareil, j''ai bien sur beurré le moule et j''ai surtout ajouté de la fleur d''orangé rien à redire TOP merci pour cette délicieuse recette très facile.', '2016-04-24T15:42:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 810f468e-9763-4ed9-9b3e-846c63d26e3f, 'Bon mais sans plus; de même 25 minutes ne suffisent pas du tout pour la cuisson donc je l''ai laissé le double. ', '2015-10-01T11:08:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 121a46ce-9529-42ea-af5a-9ce862fb37f2, 'J''ai bien respecté les quantités mais pensant que je n''aurai pas assez de pâte, car j''ai utilisé un grand moule à tarte, j''ai battu mes blancs d''oeufs en neige que j''ai ajouté en tout dernier. Le résultat était parfait ce gâteau était délicieux, je le referai, et je le recommande.', '2015-09-18T20:27:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, c500d1a4-92bd-463f-901a-45ca395a1e90, 'Délicieux. ', '2015-08-22T02:35:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 4506c5b6-d06b-4136-a1ef-ec3c8c050b61, 'Super recette !!! Gâteau délicieux, tout le monde adore ! Merci pour la recette !', '2015-07-25T19:16:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, dfd7b416-0d43-497a-9976-1bf41c26ac4a, 'Très bon, même ma fille qui n''est pas dessert l''a aimé. J''ai ajouté un peu de lait parce que la pâte était assez collante, et pour le sucre j''ai mis un sachet de sucre vanillé, 50g de sucre blanc et 50g de cassonade. Je n''avais pas de citron, j''ai remplacé par un peu de jus de citron.', '2015-03-20T19:16:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 5e25c896-a0d9-41fb-97a3-4ca43db8f1a9, 'C''était pas mal du tout ! Considérant les commentaires, j''ai ajouté un peu de lait et de la cannelle ! À refaire !', '2015-01-19T21:37:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 417f23cb-ac39-4da3-9cf5-1bfec172daa4, 'Parfait !! C''est un gâteau qui n''est pas très léger !', '2015-01-10T15:41:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, dfb91547-3010-4814-bb12-cb590acc67bd, 'Très bonne recette. Un succès à chaque fois !', '2014-12-17T16:35:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, be2c3de6-6b93-4710-abae-a6a20dc71dcd, 'Une de mes recettes préférées, une recette simple mais très efficace, toujours apprécié chez moi par les grands et les petits... Pour ma part j''ajoute moins de sucre mais chacun aime plus ou moins sucré. ', '2014-11-25T07:46:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, b7bd22be-8d1e-413b-8046-8b234cef0a34, '95 g de sucre + 2 sachets de sucre vanillé (15 g) et j''ai augmenté le temps de cuisson car insuffisant dans mon four. Le tout pour un résultat délicieux et à refaire sans modération !!!', '2014-11-17T14:31:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37577, 4f2d3de4-2e3b-469a-93a0-1b8e0029bf63, 'Oui c''est moelleux mais il manque quelque chose du sucre ou autre.', '2014-11-16T12:34:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 381b3582-8b18-403b-ae7f-2a4cb37684ab, 'Délicieux...
J''ai utilisé une pâte sable achetée et je l''ai précuite. La quantité est suffisante pour couvrir toute la tarte. Servir bien frais un régal.', '2019-08-15T10:42:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 86523644-1b90-4c09-96c8-d40898865a9f, 'J''ai suivi les conseils trouvés dans les commentaires et je l''ai faite avec une pâte sablée industrielle, des framboises surgelées, un peu moins de sucre que prévu, quelques gouttes de vanille liquide et c''était délicieux ! Merci pour la recette !', '2018-02-19T13:10:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 290c310a-94c7-4c2e-bcc3-f0c28edc5c92, 'J''ai fait une autre pâte sablée moitié beurre doux moitié beurre demi-sel. J''ai ajouté quelques gouttes de vanille liquide à la crème...  Et avant de mettre la tarte montée au frais, j''ai nappé le coulis au pinceau sur les fruits...je ne trouve pas les mots pour vous décrire le délice.', '2016-07-04T20:33:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, f20473d1-b338-4451-bf9e-89ee08571f29, 'J’ai suivi conseil et remplacé le fromage blanc par 1 yaourt grec et j’ai aussi remplacé le sucre par 80 g de chocolat blanc : un délice !', '2023-09-24T15:40:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 69ade19c-9e7b-4f83-b3ad-8d2de5b0dc1f, 'Super résultats et délicieuses saveurs ! La crème peut aussi servir pour de succulentes verrines framboises spéculoos ! 
', '2023-01-14T11:40:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 034221b0-64dc-4db6-b2fb-d0d004e80b5e, 'Délicieux ! J''ai rajouté un peu de confiture à la framboise sur le fond de ma tarte et j''ai utilisé des framboises surgelées !
Très bon, à servir tout de suite après préparation pour éviter que la pâte ne soit détrempée.', '2019-07-06T07:27:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 6548322d-32cc-402c-85b1-42d7f1f00beb, 'Super recette ! J’ai pris une pâte industrielle. J’ai rajouté une fine couche de confiture à la framboise sur le fond de la pâte avant de rajouter la crème par dessus. Un délice', '2019-05-23T19:10:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, ca5063e2-278a-4fdd-ae92-faf82b701d46, 'Recette parfaite, petite variante, ajouter un peu de bananes sur le dessus se marie très bien avec les framboises !', '2019-04-29T10:23:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 43e0ddee-b9e7-4919-b978-1b6737bf1c87, 'J''ai littéralement craqué dessus', '2019-03-17T04:41:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 00424729-96fe-4b22-868c-977d414ff0a8, 'Je fais cette recette avec une pâte feuilletée. Pour éviter que la crème mouille trop le fond de tarte, à mi cuisson de la pâte je tapisse le fond de tarte de confiture  de framboise (maison) et je laisse finir de cuire. La confiture caramélise un peu ce qui rend la pâte étanche et croustillante. Je suis plus généreuse en framboises (500 g). Pour la crème je mixe pas trop le mascarpone je trouve que cela le rend trop liquide. La prochaine fois je rajouterai le coulis cela me semble très appétissant.', '2015-06-21T23:57:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 169fce0b-2d7e-4432-81b9-d4236805b144, 'Excellentissime et ultra simple à faire, mais j''ai utilisé une pâte sablée toute prête car faire une pâte brisée avec juste de la farine et du beurre...', '2014-04-30T00:45:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 64b5aea6-7ddd-497b-af96-fa59e5ee4854, 'Délicieuse ! J''ai réalisé une pâte sablée (via une recette de marmiton, très facile à faire !) J''ai conservé ma tarte au frigo 48h. Elle était succulente. Je craignais que le mascarpone soit trop riche, trop lourd mais au contraire il était fondant, excellent ! Mes invités ont adorés ! A refaire.', '2012-10-01T16:09:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 6f6e5689-dd35-4b4c-aa9e-eb17b21ad1f6, 'Testée lors d''une soirée BBQ avec 12 amis... Elle a largement battu la mousse au chocolat ! Cette recette parfaite à fait sensation et tous le monde en parle encore.', '2012-08-25T16:10:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, c735e9f9-48e8-44ac-81bd-11bd123d06d6, 'Très frais et facile à faire. J''ai préféré faire une pâte sablée. Il n''en restait plus une miette. Le coulis de framboise apporte la dernière touche ! Merci pour cette recette.', '2012-06-03T22:05:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 1de1480c-48ef-4635-bc2a-a30e3282fe50, 'J''ai ajouté du zeste et le jus d''un demi citron vert à la mascarpone. C''est léger et frais. Tous mes invités ont été ravis et ont tout mangé alors qu''ils n''avaient plus faim !', '2011-08-15T15:54:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 673b18b3-1d85-40ee-a1f8-201cf4e5e297, 'Absolument excellente!! (et je suis vraiment difficile quand il s''agit de dessert...) , en revanche, le jus de citron est à retirer du coulis, trop acidulé sur une framboise qui l''est déjà par définition. La perfection étant de la servir avec une boule de glace vanille (maison) afin d''atténuer ceci. Petite astuce : rajouter un sachet de nappage pour tartes Vahiné, qui donne l''effet brillant des pâtissiers à vos tartes aux fruits.', '2008-11-25T16:16:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, da3ac155-29f0-4bbe-96b1-ab311008a04f, 'La crème au mascarpone est bonne. Cependant pour la pâte, farine et beurre ne suffisent pas, j''ai fais ma propre pâte brisée avec 300g de farine, 100g de beurre, 1 jaune d''oeuf, 1/2 verre d''eau et 1 pincée de sel. 500g de framboises sont nécessaires.', '2005-04-06T14:36:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, b339075a-0849-450d-92cc-ad83973c860a, 'Trooop bonne ! 
Avec moins de sucre et yaourt à la Grecque à la place du fromage blanc.', '2023-08-06T14:11:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 1716d961-aeb8-4d87-9f74-7676d23ad7e0, 'Pour la crème je mets 5, le reste je n’ai pas testé avec cette recette… J''ai également diminué le sucre de moitié car je n’aime pas trop sucré.', '2022-09-10T19:38:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 5293512e-ca18-495a-b04f-b6a4f12208fb, 'J’ai fait la pâte et l’ai mis au four mais était à mes yeux pas assez cuite, je l’ai donc remise au four quelques minutes j’ai maintenant l’impression qu’elle est trop cuite et elle a l’air de ne pas se tenir... à voir une fois finit à la dégustation, mais je pense qu’en effet une autre recette de pâte serait plus adaptée...', '2020-11-08T17:45:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 7404095b-a105-4088-a60d-b415db9f49c0, 'Pour la crème j’ai mis la moitié de sucre indiqué et pour la garniture le jus d’un demi citron au lieu d’un et c’était excellent. Je pense aussi qu’une pâte sablée serait plus adaptée.', '2020-08-22T16:22:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 1540525b-1960-4ea8-9422-69da8d19b526, 'La crème est juste parfaite ??', '2020-08-08T13:27:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 740b1ec8-f998-45e0-a670-6bda3bf0d2fa, 'Excellente avec un peu moins de sucre et la recette dela pate sablee de "the" tarte aux fraises', '2020-08-06T20:17:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, dbb279c8-af69-4108-a8b2-139a5d90e2bc, 'Excellent ! J''ai mis mi-mascarpone, mi-crème fraîche.', '2020-07-30T16:06:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, c12e368d-271e-42a7-b89c-49a3bd2a6cfa, 'Très bonne recette mets à la place de la crème comme nous a demandé j''ai mis de la préparation de flan et c''était tout aussi bon vraiment je la recommande', '2020-07-04T16:40:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 9407a518-aea8-4ec4-bcf9-4ec245b96772, 'Cette recette est excellente , la crème de fond de tarte est une tuerie. La quantité de framboise est insuffisante pour un moule de 30 cm. J''avais 400 g de framboises, je n''en ai pas eu assez pour faire un coulis.', '2020-06-09T18:14:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 41465810-a3aa-4280-881b-9d34ee814b6d, 'Vraiment un délice ! J''ai ajouté du jus de citron dans le mélange de crème comme certains l''ont suggéré et j''ai bien fait de le faire. Ça ajoute une bonne touche de fraîcheur !', '2020-01-30T05:01:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 010e3ef4-f68d-4bbd-9ca2-8bff7acca303, 'La quantité framboises est trop juste et le résultat un peu acide.', '2019-11-21T19:57:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, bf734662-4cb5-4385-bdb7-a4130b9ac9b9, 'Excellent.', '2019-04-22T11:42:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, f089cb05-994d-4b71-a4b5-faaabba7326a, 'La recette de la pâte avait un problème je pense, elle était trop sableuse et ne se tenait pas du tout dans le moule au moment de servir. Après l’appareil était bon, j’ai réduit la quantité de sucre comme disaient les commentaires à 80 g, ce qui était suffisant. Je suis donc mitigée et je pourrais refaire la recette en changeant juste la recette de la pâte.', '2018-07-19T11:09:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, af6b85f8-ee87-4d84-80c6-c280e031ffe9, 'Recette excellente et tellement facile à faire ! La crème au mascarpone est légère et accompagne parfaitement les framboises. A refaire très vite !', '2018-05-21T08:15:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 19cd6cf4-c0c1-4d6e-9b97-31cec5c10efa, 'Trop sucré pour moi. Et je comprends pas trop le concept du coulis à servir à part... sans compter qu’on a aucune explication pour réaliser la pâte sablée. J’ai dû suivre une autre recette. ', '2018-05-01T11:33:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 2d246a17-b1db-49ef-8e81-bc46f4a15d7f, 'Excellente recette !', '2018-04-14T11:32:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, dd9e0976-d5e1-4518-a310-1c4d62b30cb7, 'Un délice !', '2017-11-12T17:56:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 8e13890b-09c4-4263-9489-97515e7321c4, 'Excellente recette d''été : légère, rapide et facile à faire. Réalisée avec les framboises de mon jardin, la tarte n''a pas eu besoin de coulis selon moi, et je me suis contentée d''une pâte brisée industrielle (pur beurre, de bonne marque). ', '2017-06-18T13:57:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, cd69afd2-2d3b-4be8-85fd-a37e5a97b77c, 'Bon facile et rapide, à refaire ', '2017-05-19T11:38:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 12974eb3-c943-4278-a257-bd9669067194, 'Très jolie tarte et délicieuse.', '2017-04-30T11:17:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 8261f56b-0927-4c14-b093-b8a916dc2fda, 'Simple et délicieux !', '2017-04-17T18:04:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, d31ca72a-05a6-4533-a267-b4d7aeeae3db, 'Recette parfaite ! Tout le monde a adoré !', '2017-03-10T10:57:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, eae0e63f-4ded-4380-82d6-ab14c0eb81a0, 'Super bon mais comme un petit souci avec la pâte. Trop beurrée donc très difficile à étaler. Moi j''ai aimé, mais mon mari moins.', '2016-10-14T19:03:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 52f7d382-3d4b-4f6a-9a53-52c9141c89fa, 'Très bonne alternative pour les gens comme moi qui n''aiment pas la crème pâtissière ! En revanche je sucrerai moins l''appareil la prochaine fois. J''ai essayé avec une pâte sablée c''était très bon ! ', '2016-10-09T19:41:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 3c8d699c-4b07-4699-8a91-6d6e6008ac1b, 'Excellente!!!!', '2016-10-08T13:40:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 5a3ce833-7a81-48ae-bc6b-8db6657bf58c, 'Succès garanti ! La crème supporte très bien un peu moins de sucre, 80 g c''était parfait.', '2016-10-02T20:18:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 5747f3ff-48de-46e0-ac01-52e25b422095, 'Un vrai régal.  Je l''ai fait en tarte et je l''ai essayée en verrine avec du spéculos et c''est très bon aussi. Recette facile et rapide. ', '2016-09-21T23:19:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 027a570b-6035-4537-9db2-85a1942c7826, 'Trop bon ! Succès garanti ! Attention les ingrédients sont pour 4 personnes donc multiplier les ingrédients pour une tarte de 8 personnes… J''ai mis également des myrtilles et des fraises.  ', '2016-09-02T19:59:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, b6bad99f-babd-485e-9dde-0fed9e4d23c1, 'J''ai fait cette recette hier soir et quel délice ! J''ai impressionné tous mes invités ! A refaire encore et encore !', '2016-08-14T12:24:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 724ad8e3-a45b-40d8-980e-38c2146f3be9, 'Excellent j''ai mis du sucre vanillé à la place du sucre glace et j''ai ajouté des zestes d''orange et de citron vert plus des amandes que j''ai caramélisées. ', '2016-07-27T21:38:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 8cc8a581-3460-4ae1-ad2a-cd3ad6e8d06a, 'Je l''ai faite, excellent, merci pour cette recette. Demain je le fais avec des myrtilles.', '2016-07-23T21:14:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 94e06f42-5c5b-4a1c-b79f-30accd2a9035, 'Faite avec une pâte du commerce et des framboises surgelées. C''était délicieux. Le petit moins serait le coté acide de la framboise surgelée. A refaire avec des framboises fraîches.', '2016-07-20T21:09:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 0a8fe057-f1a3-4287-8268-f6d13334403c, 'J''ai fait avec pâte achetée en supermarché et j''ai ajouté dans le mélange mascarpone fromage blanc (7,6 %) du pulco citron et cela peut être fait avec n''importe quel fruit, myrtilles, fraises, mangue... (j''ai tout essayé...) c''est délicieux ... ', '2016-07-15T19:39:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 99d383af-2eea-4867-a86a-0539ccb4197d, 'Juste un mot : délicieux!  ', '2016-07-13T01:10:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 469e10bb-0360-41c7-8985-c4ed05afc707, 'Excellente recette d''été. J''ai mélangé des framboises et des mûres. Un régal.', '2016-07-11T20:27:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, dfbcf7fc-383c-4e6e-b914-35dad299a1f7, 'La pâte est très décevante : trop riche.', '2016-07-10T00:06:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 7418a909-81d9-4465-9c63-18d6c6cc4166, 'Très bonne recette faite en version individuelle, mes invités ont adoré.', '2016-07-07T18:38:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 4cea2f3f-af33-45bf-9429-35f0d0215e06, 'Extra, mon papa très gourmand agé de 84 ans m''a dit hier qu''il n''avait jamais mangé de dessert aussi bon ! J''ai suivi toutes les indications en utilisant des framboises surgelées. Merci', '2016-03-28T17:49:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 7706d172-8beb-4c2f-b5fb-cb496e69e03c, 'J''ai remplacé la pâte à tarte brisée par une pâte à tarte sablée et un blanc d''oeuf battu en neige dans la crème! Très bon ainsi.', '2016-03-20T18:39:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, a1f3c5ea-e380-4208-b33b-81f35c7577d3, 'La pâte est bonne mais la garniture à base de mascarpone est trop sucrée et trop riche... ', '2016-02-28T15:59:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, 614adbf2-0654-4c7d-9e7f-f20fa6077df6, 'Très bonne recette pour ma première tarte aux framboises, j''avais fait également une tarte aux fraises avec une crème pâtissière, et effectivement la crème à base de mascarpone et fromage blanc est parfaite et plus légère.  ', '2016-02-21T21:22:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, b7811382-71e1-44af-81d9-5b343872ea9d, 'Recette suivie à la lettre juste remplacé par des myrtilles : UNE TUERIE !!!!! délicieuse ', '2016-01-30T23:46:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17787, eefcff74-1769-4eea-888a-f10686e6218e, 'Un délice!! J''ai fait la pâte à tarte avec une autre recette mais la crème est juste parfaite !', '2015-11-23T17:47:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 3fa6c5d3-fc76-42f4-90dd-4bb6c2a00e53, 'Moi je creuse la pomme, je rempli avec de la confiture et du beurre et la pose sur une tranche de bon pain avant de l''enfourner. Un vrai régal car le pain caramélise.', '2015-01-18T10:00:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 3804fa9f-5c8a-42bb-9336-759f2c2b8ae8, 'Personnellement, je creuse la pomme et y insère un peu de poudre d''amandes, puis du miel crémeux de lavande. Je termine par une noix de beurre saupoudrée de cannelle. 1 verre d''eau au fond du plat. J''enfourne 30 min à 180°C et le tour est joué ! C''est à tomber par terre.', '2014-11-22T21:47:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 79a54929-d8b0-44e4-8986-fa9dcac19f30, 'Top pour la cuisson, j''ai juste ajouté au centre des pommes un mélange de spéculoos écrasés, beurre et confiture de mangue et saupoudré de cassonade. Mes 2 hommes se sont régalés !', '2014-11-23T22:35:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 2949a264-ed3e-48e0-b779-c75260d63722, 'Une noisette de beurre en plus et c’est divinement bon ', '2022-01-03T16:09:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 5f0d0105-2be8-47b9-8bdc-17b1415a0bdc, 'J''ai ajouté dans chaque pomme une cuillère de raisins secs, du miel, une cuillère de sucre, une noisette de beurre et j''ai saupoudré de cannelle. Un vrai délice.', '2020-04-22T21:17:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 44bf6e85-a00b-4f53-91c5-7d8ed351e63f, 'J''ajoute quelques gouttes d''extrait de vanille dans le trou avant de mettre le sucre. Encore meilleur !', '2020-01-26T20:04:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, f2358ee3-5421-419d-ace6-f3d10602da0d, 'J''ajoute de la cannelle !', '2018-03-10T12:37:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, bf9d0b15-5cf1-4f6a-9f53-401631227fcf, 'Très facile à faire, et très bon ! Très pratique lorsque l''on est étudiant et qu''on a pas forcément des tonnes d''épices et d''ingrédients sous la main. ', '2015-01-14T21:25:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 48f543af-9387-4c98-83ff-68d9f3f9bfb9, 'Simple & facile, un délice ! ', '2014-02-23T17:58:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 29bea93f-3508-440d-842d-99bce3107e7d, 'C''est bof mais facile à en faire un délice... Ajouter à l''intérieur en remplacement du trognon : gelée de groseille ou de ce que vous voulez, framboise abricot. Mettre un peu de beurre salé sur le dessus+ sucre vanillé et cassonade. Une rasade de kirsch ou d''alcool fort. ET DE LA CANNELLE ! Je mets une heure à 150°C. Promis, ce n''est pas de boulot mais vous m''en direz des nouvelles !', '2013-10-23T19:18:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 22f68d96-f89e-4d32-ab52-f5a847ee5bc6, 'Merci, recette simple sans miel ni créme fraîche, merci beaucoup.', '2006-02-22T11:48:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, d797580e-2529-48e5-8cf0-19a0fd740d8f, 'Tres facile et bon', '2021-11-15T13:39:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, fbd83e95-9a9c-41ac-8ec9-fb38a0d0bb97, 'Bien dorée c''était super bon', '2021-05-10T22:02:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 32780319-1eb8-41c8-a9b7-7124a8c89021, 'C’est encore meilleur avec de la confiture', '2021-04-18T12:17:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 0256760f-060f-43b1-99f7-ad87e54dfd86, 'Pour ma part, j''ai pelé et enlevé le trognon des pommes.. Posé dans un plat. J''ai soupoudré avec du sucre (quelques unes avec en peu de la cannelle). Mis de l''eau au fond pour faire un petit sirop 😉.. Couvert le tout et au four à 150-180°C, chaleur tournante pendant 20 à 25 minutes (un peu plus en fonction de la variété de la pomme).. UN RÉGAL.. Bisous. ', '2021-04-10T12:28:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 91002ceb-61a3-473d-b314-2b0e4569a3af, 'L''eau a transformé les pommes en compote qui baigne dans un jus aqueux; C''est mangeable mais ça n''a rien à voir avec des pommes au four !', '2020-12-05T17:13:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 18e84160-fd81-4e19-b04a-382bc74200e2, 'C''est bon !', '2020-04-30T21:27:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, e95ba07c-1237-482f-9a3e-f3ebcb498902, 'Excellent ! Je mets parfois de la cannelle pour ceux qui aiment ça !', '2020-02-24T23:29:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, b7cae553-54f1-444a-92cb-478c3097d736, 'A la place de l''eau, je verse un verre de vin rouge.', '2020-01-27T11:54:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, dc1d02c1-81c3-4538-9c5a-f8d19318349a, 'Bonne recette. Simple et efficace.', '2019-10-27T09:15:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, c2a07fe9-359a-4d6f-bc61-c9a9c9f3a69c, 'Pour ma part la pomme n''est pas dorée, j''ai suivi la recette... déçue.', '2018-11-30T02:25:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, db0b2fdf-2bc4-42d0-a611-65ede5c3a2ba, 'C''est également ma recette... simplissime et excellente !  Je confirme !', '2018-05-23T09:02:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 55e24b00-754d-4501-8940-57647ef17455, 'Mes pommes n’étaient pas cuites ! Mais la douceur de l''accompagnement était bien agréable. Je n''avais pas de noix normales alors j''ai utilisé des noix de pécan, c’était très bon aussi.', '2018-05-13T15:14:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, f1c1d199-9af7-4eb6-96c4-43f9118a0893, 'Tellement facile, tellement bon !  !', '2018-02-22T20:04:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, e2d504d8-31c1-4e74-a2b7-20878e8828a9, 'C’est super bon ! J’ai creusé la pomme et j’ai mi du miel dans le fond, raison par dessus et encore du miel au dessus ! Un petite lichette de beurre et après j’ai saupoudré de sucre. Le mieux serait des les mettre dans des petits ramequins car la pomme fond un peu... Je pense 25 min c’est pas mal.', '2017-10-21T16:08:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 5c97b5e7-0180-4fb7-81ad-f8eee8c9660e, 'Ca me rappelle le bon dessert que ma mère me faisait souvent et c''est vrai que c''est bon !', '2017-08-31T21:26:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, eee2abba-dd19-4aef-9b44-0902e33602f9, 'J''ai mis du beurre dans le trou et du lemon-curd parsemé de cassonade et de cannelle, cuire 40 mn à peu près miam ! miam ! ', '2016-12-20T21:16:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 393e36ed-a50b-4dc4-a4a6-8dd5c8d4bc63, 'Très bon, il faut juste prendre les pommes de la même taille et pas trop grosses. Ce que je n''ai pas fait.', '2016-09-21T21:44:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 8d83db01-63c5-40dc-87ed-db5d31b478c7, 'Recette essayée et à éviter ! Si l''on se contente d''équeuter la pomme sans retirer le trognon la pomme ne cuit pas à coeur. Il est dit dans la recette de saupoudrer de sucre mais il n''accroche pas sur la peau. D''où l''intérêt de creuser le centre pour y mettre un peu de beurre avec du sucre.', '2015-12-21T15:31:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 28b0e314-1630-4ee2-aad0-9df2250a9fba, 'Super recette, moi j''ajoute un morceau de beurre au milieu', '2015-09-20T21:38:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 81c4027c-62ec-473e-9212-9642c5c1b0f3, 'Pour ma part, j''ai mis de la crème de caramel au beurre salé dans les pommes, saupoudrées de cannelle et 30 min de cuisson mais à 220 °c. On les a mangées avec de la glace vanille et on s''est régalé.', '2014-10-17T23:16:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, e96dfa32-9b9a-4735-a204-2874594e3409, 'J''ai mis de la gelée de coing (maison), du beurre salé et du sucre. Très simple, très bon.', '2013-10-16T18:01:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 7bdafc5d-0649-48f8-8159-677d2d5097de, '30 minutes à four 180°C ce n''est pas assez. Les pommes n’étaient pas du tout dorées. Je referai cette recette avec un four plus chaud et pendant plus longtemps. ', '2013-05-19T22:37:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 54d6079a-6e8b-4f2f-986f-877de16c9e29, 'Une touche de beurre demi-sel pour ceux qui aiment le sucré salé, juste un régal !', '2013-03-30T16:17:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, a7b56332-ec48-48f4-9580-f0a982bbff50, 'J''ai préparé des pommes au four pour midi avec un peu de beurre, de sucre vanillé (maison) et et du coulis de fruits rouges.', '2013-03-12T12:46:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 4185fff1-faf4-4e6c-b998-be90fe63f42e, 'Pas terrible ! 30 min à 180°C pour des golden ce n''est pas suffisant. Je suis déçue.', '2012-10-31T22:19:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 0c707efb-a38f-4e90-928b-4fef0dafc698, 'La prochaine fois je remplacerai la cannelle par des amandes effilées et laisserai les pommes un peu plus longtemps au four, je l''ai faite avec des granny smith', '2012-07-14T15:56:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 55231fa6-20a9-4cc4-bbf5-6c8c4799aee3, 'Très bon ! A la place du sucre on peut mettre du miel ça parfume bien', '2012-06-10T23:52:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 69dbba9c-33a7-4cd7-b591-89df030f3221, 'Surveillez bien la cuisson. Je me suis laissée dépasser par le temps la 1ère fois et je me suis retrouvée avec de la compote dans mon plat ! Sinon : simple et goûteux', '2012-03-11T01:48:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, e764a824-2779-4014-a77a-bc47ce930570, 'Je viens de faire ce dessert facile et délicieux ! J''ai suivi les conseils : du pain au fond du plat et j''ai mis de la gelée de framboise maison au cœur des pommes.', '2011-11-08T13:47:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, a8710243-9da2-491c-8bb4-d1fc691f1b07, 'Un délice. Très simple à faire et un dessert savoureux... Les enfants ont adoré.', '2011-10-16T16:05:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, f6f51507-fca8-4b33-827e-e16f41288138, 'Avec une pointe de cannelle c''est encore meilleur', '2010-11-12T13:20:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, bc360d7c-f227-46ad-b3cd-5394d3f141ea, 'Un vrai délice ! Simple mais tellement bon ! Merci', '2010-04-18T20:47:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, c3ab5038-d093-465d-9691-cd32ee4d34c6, 'Cette recette me rappelle les pommes au four de ma maman... Que du bonheur !!', '2010-04-03T21:37:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, fd1c7bf3-7de6-4c03-8cda-77dfd8b9e9d6, 'C''est effectivement une recette simple et délicieuse...  Moi je fais comme ma mère... La pomme creusée est posée sur une tranche de pain ou encore mieux de brioche, et je mets dans le creux de la pomme un peu de beurre (que je coupe avec le vide pomme, comme ça il a la même taille) et du sucre. Pour mes copains invités, je rajoute un peu de calvados, histoire de...', '2009-10-28T12:50:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 14e18439-7b13-4a2e-bb9c-97f008f246db, '2 pommes chacun ; avec le trognon enlevé, et de la cassonade ; le tout au four 20 minutes.  L''eau au fond du plat mélangée au sucre a permis de caraméliser les pommes : un vrai régal! Un dessert extra, light et très rapide à faire. Merci.', '2009-01-22T09:58:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, e52ce50a-a198-4dde-91c5-e609a3dba48d, 'Comme j''ai un bébé, j''ai juste coupé les pommes en tranches afin qu''il puisse en manger. En plus, la cuisson a été super rapide. Toute la famille s''est régalé. A refaire régulièrement. Un grand merci !', '2008-12-04T14:20:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 6d608a99-6359-4078-84f9-4e411e8599b2, 'Ca va. Ce qui est vrai c''est que c''est simple, mais c''est quand même meilleur avec de la confiture (groseille par ex.).  Sinon merci pour le coup des fourchettes !', '2008-11-05T20:19:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, da35655e-4eb8-4a52-abb4-82b31ca80435, 'Problème au niveau du temps de cuisson. Je mettrai le four moins fort la prochaine fois et je les laisserai plus longtemps. Un peu déçue.', '2008-10-26T13:46:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 43681ed1-0bae-4b2b-aaa7-78d51e174ce4, 'Tout simple et tout bon ! ', '2008-02-15T15:27:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, b19b3816-8bea-4c0d-8c84-5c20f7ad7654, 'A la place du sucre en poudre je mets de la cassonnade et de la cannelle, c''est plus que délicieux et tellement facile... ', '2008-01-25T13:32:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, e2005273-13e7-40a7-8c21-e202d51449e4, 'Une recette simple et délicieuse. Parfaite quand des copains viennent diner. J''ai ajouté quelques noix pour le goût. Et la prochaine fois je mettrai plus d''eau au fond pour avoir plus de jus! ', '2007-05-07T13:05:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 66eedef0-e6d0-4806-b81a-7eb24340f247, 'Rien à redire. Délicieux et très facile. ', '2007-03-25T14:12:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 86039c1f-bd4f-40a2-80f3-9739a41dbf3a, 'Enfin quelque chose de simple et de délicieux, parfait pour tenir un équilibre alimentaire sans faire d''excès !!!!!', '2007-02-19T20:57:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 62b915a7-587f-4722-b18d-211111d935b2, 'Tout simple et très bon! Merci.', '2006-11-24T13:01:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 11823c25-d7ad-43a8-a6c7-91ed2a3f077e, 'Je viens de réaliser cette pomme au four toute simple pour mon dessert. Un seul mot: dé-li-cieux!', '2006-11-07T21:52:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, fc59ca51-c48d-41ef-a269-752271325036, 'Enfin une recette facile et délicieuse. C''est un désert sans chichi et convivial. Merci! ', '2006-04-07T22:20:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 8004b403-7f59-4afd-b343-3db9c6964a96, 'Je cherchais un dessert facile à faire à base de pommes pour ne pas gâcher les quelques pommes qui me restaient, je crois que j''ai trouvé...', '2005-06-07T13:14:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 64cabbea-2859-4d22-aa18-20b225589c90, 'Très simple et bon!', '2004-11-11T18:43:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20545, 088ccb31-56a4-41f9-a485-b83705efdf67, 'Oui!!!! La recette d''antan sans 36 autres ingrédients que l''on n''a pas forcément sous la main un dimanche soir... :o) Merci!!! Mettre le four à 180°C (350°F) pendant 30 minutes et c''est parfait.', '2004-10-11T06:49:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, cd09ef99-3503-45fb-9f2a-bcef91d38ebe, 'Super recette. Très simple à préparer. Idéal en fin de repas car léger. Je referai cette recette. ', '2014-07-02T01:11:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 51d632e6-22aa-4dfc-a260-6c4fe82eced8, 'Je fais exactement la même recette mais avec une crème pâtissière à la place du fromage blanc.  ', '2014-05-19T21:17:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 2805513c-e7fb-402e-aabe-4e1bb6055e90, 'Bonjour, est-ce qu''on peut mettre de la crème fraîche à la place du fromage ?', '2014-05-19T19:45:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, d697e8ab-9e60-4de9-ba7f-d70d128c7857, 'Ca m''a l''air très bien tout ça ! Mais qu''en est-il de la crème anglaise de la liste ? A mélanger avec le fromage blanc ? Merci de votre réponse. ', '2014-05-19T19:17:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 25c1ed81-6a1a-4a96-88f2-fa60efc002b3, 'Très bonne recette de charlotte pour sa légèreté due au fromage blanc. De plus, malgré mon scepticisme quant à la tenue de ce gâteau, j''ai eu l''agréable surprise de voir que celui-ci était impeccable au démoulage mais aussi au découpage. Idéal dessert à composer le weekend et à savourer en famille ! Merci beaucoup.', '2012-12-11T15:15:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 88dfe40c-a263-4f2f-a0d1-356fc6965b9e, 'Très bonne recette simple et fraîche, démoulage facile, proposé sans crème anglaise... Également testé avec des framboise... Merci', '2010-01-12T19:06:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 936b7c3f-3835-4530-8897-bafdc5e54a5d, 'J’ai essayé cette recette pour la première fois, je ne pensais pas que ma charlotte tiendrait au démoulage, j’ai mis, moitié mascarpone moitié fromage blanc, par contre j’ai cherché le poids en sucre, alors j’ai mis 40 g de sirop d’agave, tout le monde m’as félicité pour cette charlotte même ma sœur qui est une spécialiste des charlottes, merci pour cette recette ', '2022-07-03T20:56:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, ffe16e9b-8675-442c-a5ea-f2b621bbac9e, 'Elle est extraordinaire cette charlotte. Elle tient parfaitement au démoulage. Pas besoin de crème anglaise par dessus à la fin, elle se suffit à elle-même.', '2019-05-30T15:23:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 6bb6b082-a99f-43a0-8eb8-7f0f092210b9, 'J''adore. Léger, frais, facile à faire. Ma fille de 10 ans l''a fait souvent en été. Fromage blanc à 0% et sirop de fraise à 0% aussi. On a bonne conscience.', '2016-02-15T01:02:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, e117bd34-1159-4219-aefe-0ff9aefb7f63, 'Je n''ai pas encore réalisé la recette bien que j''en ai très envie... Elle a l''air appétissante. Mais je voudrais juste avant savoir à quel moment de la recette on introduit la crème anglaise mentionnée dans la liste des ingrédients mais non ajoutée dans la recette. Merci de bien vouloir préciser.', '2014-08-27T15:43:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 127be9a0-0942-4d6d-94e4-9bc45a2cec1d, 'Cette recette est vraiment top ! Je l''ai faite pour mes petits loups, ils ont adoré et en une heure, il n''en restait plus. J''ai trempé les biscuits à la cuillère dans 10 cl d''eau, mélangée à une petite pincée de sucre : pas d''alcool dans ma religion. Quant au fromage blanc, je l''ai remplacé par du mascarpone, c''était tout aussi bon !  Recette à refaire encore et encore ! ', '2014-08-18T19:38:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, cfe86921-ea08-4288-90dd-1e03f937194f, 'J''ai fait avec 500 g de fromage blanc à 0% et j''ai trempé les biscuits dans du sirop de fruit rouge 0cal, le résultat est léger et délicieux... Attention cette charlotte mériterait une ganache chantilly après démoulage (qui se réalise très bien) ', '2014-07-19T13:38:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, e0ae926e-0dd9-4707-bc51-61cdd803e0be, 'Excellente recette. Moi aussi j''avais des craintes quant à la tenue de la charlotte... Mais elle a bien tenu ! Pour ma part, j''ai trempé les biscuits dans du sirop de fraise 0 % de sucre coupe avec de l''eau... Cette charlotte a beaucoup plu à mon fils pour ses 9 ans et ses invités...', '2014-06-30T20:04:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 9a219c1d-f290-4abf-8585-d779078e153a, 'Super recette ! facile à faire et facile à démouler! ! j''ai trempé les biscuits dans du jus d''orange et c''était exquis. ', '2014-06-15T15:09:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, a7fb7aa9-9257-4c42-b226-b15cdd0f557f, 'J''ai remplacé le kirsch par du sirop de rose. Très frais. A refaire sans problème.', '2014-06-03T19:59:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, a3b587b9-80c3-4fd4-81fc-9f95c2fcb435, 'Très bonne recette et très facile à faire. Je recommande.', '2014-05-29T21:55:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 4ae73550-75be-407c-8678-50dbb7b06d42, 'C''est la meilleure charlotte aux fraises que j''ai pu mangé jusqu''ici ! J''ai suivi la recette à la lettre, à ceci près que j''ai utiliser du rhum (faute de kircsh) mais cela n''enlève rien à sa saveur. Pour répondre à certaines interrogations, le gâteau tient parfaitement au démoulage. Je conseille vivement cette recette !', '2014-05-26T23:16:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 154bd869-52ff-42da-bd42-90846ca1bd36, 'Super bonne recette pour la charlotte. J''avais déjà testé une autre recette avec de la crème fraîche, mais avec du fromage blanc c''est beaucoup plus léger ! Donc parfait pour le dessert quand on a bien mangé avant !', '2014-05-25T17:04:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 9a2015cf-9b3e-453c-a0d0-bca8146d932e, 'J''ai une question : est-ce que quand on la démoule, la charlotte tient bien ? Je trouve ce dessert très appétissant, mais ma crainte est de la voir s’affaisser...', '2014-05-20T15:06:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 6294cdd3-81a8-4149-8bf0-c5f0d00941b8, 'Excellente recette, peu d''ingrédients, ultra rapide et très facile, j''adore (acheter des fraise, où autres fruits de saison) 20/20, +++, (-:', '2014-05-19T22:13:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 6063c3eb-2dff-421d-9924-f6c6b678d94e, 'Oups une petite folie !!!', '2014-05-19T21:11:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 82024168-d678-4bdb-8160-976a2a52aaf1, 'Super, c''est vraiment à essayer.', '2014-05-19T21:04:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 43eec7ed-6e36-4c57-87eb-a944a8872da1, 'C''est un gâteau pour combien de personne ?', '2014-05-19T20:33:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, c981de11-e1ad-477f-8511-85d814d68508, 'Humm c est bon ça !', '2014-05-19T19:51:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, f4a3e615-42e9-4e5d-a50b-f2effb2d48ec, 'Moi j''aurais rajouté du sucre en poudre sur les fraises et un peu de Nutella sur les biscuits, mais sinon très bonne recette.', '2014-05-19T19:05:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 7be6e989-c84a-4450-9e7e-1dd70cb75f6a, 'Super rapide et très bon dessert frais après un copieux repas !', '2013-05-18T01:57:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 6348f71c-5842-4a4f-a4e0-483da6a74fa7, 'Délicieux ! La recette est simple et légère. Je l''ai faite avec du Calin auquel j''ai ajouté un peu de crème fraîche. Les invités ont beaucoup apprécié ! Merci beaucoup !', '2013-05-09T19:09:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, bac76139-6e58-4fac-83fc-6751e8c7267f, 'Simple, efficace... Très bon ! Facile à faire, pour un résultat impeccable... Merci !', '2013-05-05T19:21:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 1008fd36-3583-4190-9262-512268490448, 'Excellente, à refaire très vite !!', '2013-04-30T18:40:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 777fd283-4589-4ab5-8e7d-f4ab94e679be, 'C''est une recette super facile à réaliser super légère et super bonne. On peut la faire à tous autres fruits. Il y en a pour tous les goûts ! Bon appétit à tous.', '2013-04-16T21:09:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, e738d9bf-2129-4b1f-96bf-356c7eae22ab, 'Délicieux !', '2013-03-14T10:19:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, f38bc286-d482-41c9-8fa9-904b9aba2e86, 'Tip top en remplaçant les fraises par de délicieuses framboises et quelques pêches au sirop... à refaire !', '2012-11-22T19:40:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 910953dd-c6fd-46f1-b93f-db9087905b96, 'J''ai aimé sa fraîcheur et sa légèreté, j''ai utilisé un mélange de fruits rouges. Par contre en la coupant je trouve qu''elle n''est pas très présentable. Je la referai en portion individuel pour éviter cette contrariété.', '2012-11-04T21:21:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 4b940da5-2081-4843-89fc-87a623df9fc6, 'Une super recette : très bonne, ultra simple et qui épate les invités ! Ca va devenir un de mes classiques, merci :) A la place du kirsch, j''ai utilisé du sirop de fruits rouges (bien dilué). Attention à ne pas mettre trop de sucre, 2 à 3 cuillères à soupe suffisent. Afin de démouler facilement, mettre du cellophane au fond du moule. La crème anglaise n''est pas nécessaire.', '2012-07-20T22:15:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 08dca363-a362-45d6-b756-5b350efa09f3, 'J''adore, un vrai délice, très frais. Elle a très bien tenu, et c''est très gourmand même avec du fromage blanc 0%. Merci pour la recette que je garde précieusement.', '2012-06-18T00:31:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, d044e6e5-dda6-4316-92f6-7ed02515f535, 'Ce gâteau a fait l''unanimité ! Je l''ai mis dans un saladier avec du film étirable dans le fond et au-dessus... À refaire !', '2012-06-17T20:51:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 6afc3abb-ac2e-4261-92be-08b04a910926, 'Première charlotte faite avec votre recette. Un régal ! Toutefois, je mettrai un peu plus de sucre la prochaine fois... Merci pour cette recette facile à faire et vraiment très bonne.', '2011-06-23T16:21:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, a84a2130-63ff-4af9-bbec-bdfbd3b8cf65, 'Petite charlotte légère, idéale en fin de repas de fête ! ', '2011-06-01T23:50:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, e111d3f4-9ea1-4637-8ecf-f5ede6fdb087, 'Recette facile à réaliser et excellente... Tenue parfaite de la charlotte au démoulage, il m''a également fallu une trentaine de biscuits ! Merci...  ', '2010-04-05T10:15:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, cfa8ed04-95d9-4e24-905e-8d03c0270e3b, 'J''ai du utiliser également 36 biscuits. J''ai trempé les biscuits dans du jus d''orange au lieu du kirsch. La recette a été un franc succès. Démoulage impeccable. A refaire!', '2009-07-07T22:46:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, ec618b8b-75a7-4112-a893-ed455371e1b0, 'Excellent mais moi, il m''a fallu 36 biscuits. D''autre part j''ai trempé les biscuits dans du nectar de fraises (acheté !). C''est une suggestion ! C''était très bon ! J''étais contente de trouver une recette sans gélatine !', '2009-05-30T11:10:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 5081b590-6278-44ec-927e-3cd4117283d2, 'Très bonne recette, rien à ajouter, cela tiens très bien. Mais on a oublié de faire la crème anglaise. Merci beaucoup de cette recette', '2009-04-29T22:05:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, afb1f453-5288-4412-9e0b-187d9b060f86, 'Super bon ! Servi avec de la chantilly, du coulis de fruits rouges et des amandes effilées. Attention : pensez à placer le plat à charlotte sur un plateau pour éviter tous débordements intempestifs dus à la pose du poids durant 6 heures ! Merci pour cette recette ! ', '2007-03-05T12:20:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 0594ef1b-bcf8-45e7-964c-6dc3126c4abe, 'Très bon! Jl''ai servi avec un coulis de framboise. Bien laisser au frais, démoulage parfait grâce au moule Tupp. Ce dessert rencontre toujours un grand succès.', '2006-11-11T00:16:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, ddf1e618-a02b-4d5d-83ed-1dade613ab02, 'Ca a donné de la crème à la fraise, elle s''est bien cassée la figure.', '2006-06-15T18:48:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 96246db5-812a-40a6-ac29-8c7ba9f638a2, 'Très frais, très léger, dessert parfait. Je n''ai pas mis de kirsch et j''ai remplacé la crème anglaise par un coulis de fraises (fraises fraîches mixées avec du miel): vraiment délicieux et à refaire... De plus, très facile à faire.', '2006-06-11T16:24:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, bf7c9e12-b03f-43c0-a4a7-788af9e28e70, 'J''ai changé la donne avec des poires au sirop, leur sirop et de l''alcool de poires. Délicieux! Je cherchais une recette sans gélatine, et si on la laisse plus de 6h au frais, cette charlotte "tient" vraiment bien. J''ai oublié la crème anglaise (quelle bonne idée.), décoré le dessus et utilisé un moule à cake. Les invités se sont reservis!', '2006-06-09T17:34:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, db37b762-9b0c-41ac-8fd6-9bc5e8119fa4, 'J''ai fait cette charlotte aux fraises le week-end dernier, et elle était très bonne. Surtout avec les fraises du jardin. De plus elle est facile à faire. D''ailleurs j''en refais une pour demain.', '2006-06-09T14:00:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 53b25e3b-76cc-47a5-b79f-bda4224ab61a, 'Très facile et très bon. Pour le sucre, j''ai mis 80 g (en plus du sachet de sucre vanillé), c''était très équilibré. Comme je n''avais pas de crème anglaise, j''ai servi avec un coulis de framboises, c''était très réussi. A refaire.', '2006-04-27T09:41:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28852, 551bff39-58f9-4bcc-a1dd-f2e3099152fa, 'DELICIEUX!!! Très bonne recette, légère et parfaite pour l''été.', '2005-06-11T22:30:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 966e0d42-94f7-4440-b4e8-ff9110fa9899, 'Personnellement, j''ai rajouté un peu de vin blanc dans le plat avant de le mettre au four.', '2022-04-25T12:37:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 540171a3-0504-4786-b9f1-2c8a591bd82f, 'Bonne recette, jai juste ajouté du fromage pour gratiner au four.', '2024-02-14T14:38:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 5a3bc11d-8c27-4158-a409-6c459db7e3cc, 'Excellentissime... J''avais triplé  les doses car nous sommes 5 et heureusement car petits et grands, on en a tous repris ! A refaire très vite.', '2015-10-30T14:31:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, c9228469-4151-4058-b4dd-8a274b1078c0, 'Sympa recette complète et délicieuse ', '2022-03-08T19:56:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 455e4099-54d0-43cf-bbaa-43837484b036, 'Très bonne recette. Ne rien changer !', '2021-10-07T20:34:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 096e775d-8189-486d-97e7-d0e38d167084, 'J''ai fait une version sans lardons, faute d''en avoir chez moi. Une bonne recette de placard à laquelle j''ai rajouté un peu d''épices et du gruyère pour gratiner. A refaire.', '2020-01-28T12:36:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, ebbd2e01-4791-4635-95ec-48b9d474de1d, 'Pas assez de pommes de terre j''ai rajouté une carotte et sans échalotes j''ai mis un oignon et une gousse d''ail: Bon résultat ! Merci pour la recette. ?', '2020-01-21T20:36:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, a313a7b2-bfc0-40e0-978a-962f0debacea, 'Un délicieux mélange qui fait aimer les endives aux enfants comme aux adultes.', '2016-03-26T11:44:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, e3bf0e62-7e7f-4d64-88f3-327066c5b267, 'Merci pour cette excellente recette qui change un peu des éternelles endives braisées ou en béchamel. Ce repas est complet et très copieux pour 2 personnes. J''ai utilisé des lardons fumés qui donnent un peu plus de pep''s au plat.', '2016-03-03T08:50:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 5ef894eb-bc87-4744-b757-373883d90f83, 'Bonne recette. J''y ai mis des lardons de poulet à la place du porc et un peu de gruyère râpé sur le dessus pour gratiner, c''était très bon. Par contre petite parenthèse jsute pour reprendre quelques commentaires: on sent un peu l''amertume des endives mais c''est très léger, ça ne dérange pas. Je précise car certains ont écrit "aucune amertume", on ne s''attend donc pas à en avoir, la différence est tout de même importante pour les goûts.', '2016-02-21T23:37:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, ecafd4d4-0e6d-4698-8c88-e9fbec9e4982, 'Un régal ! Je n''ai pas fait attention aux portions j''ai fait à l''oeil, très bon. A refaire', '2015-11-06T20:22:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 8e654f86-67d4-4b3b-b2e0-de8ae6239b43, 'La recette est super. Moi j''ai remplacé les lardons par du saucisson. C''est délicieux. L''amertume n''est pas gênante. ', '2015-10-23T15:24:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, e5113bef-0e0c-4f52-9633-4ae26ac36887, 'Beurk, soyez objectifs dans vos commentaire, dans cette recette on ne parle pas de sucre qui masque l''amertume de l''endive. et simplement c''est pas bon sans fromage et une tonne de crème fraiche.', '2015-10-01T23:25:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, f4fda22a-bf40-4dda-843d-8ce9f679455b, 'Vraiment excellent ! j''ai remplacé les lardons par du bacon et je me suis régalée ! recette parfaite', '2015-02-21T13:41:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 9143797a-22a2-407d-8352-3d371e551c3f, 'Très bon, surprenant ! ', '2014-12-09T20:02:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 9e39bafa-ffc2-4f04-a3fc-8ba60b95b0d9, 'Excellent ! Tout le monde s''est régalé ! A refaire !!', '2014-11-27T21:22:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 2b0497a4-e2a6-4536-b119-a85ad2c32195, 'Très bonne recette que je garde dans mes favoris. Une nouvelle façon de cuisiner les endives avec des ingrédients simples.', '2014-11-25T21:28:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, ca100150-4d3b-40ed-bf9e-a02c58d15f19, 'Excellent ! j''ai ajouté des champignons et j''ai mis du bacon à la place des lardons. A refaire.', '2014-11-02T15:59:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 9b807087-1077-4bfc-8185-f18c2f4787f1, 'Trop bon, rien à dire de plus.', '2014-03-28T20:26:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, a977439d-f7e4-4c11-a0cf-3ba075cc39a7, 'Mon dieu que cette recette est succulente. Les endives et les pommes de terre, mais aussi les autres ingrédients vont très bien ensemble, j''ai sucré légèrement les endives et j''ai parsemé de fromage râpé avant de mettre le plat au four. Recette à refaire sans modération. Un grand merci. Bien à vous.  ', '2014-02-10T19:04:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, f0ecb7f9-9d6f-4d31-9fee-e068b04ed2f7, 'Merci pour cette recette que nous avons faite ce midi. J''ai suivi la recette à la lettre, rien à redire... Excellent ! Cela change des traditionnelles endives au jambon, en salade... Aucune amertume, on sent le gout des lardons mais juste ce qu''il faut ! Bref, merci et à refaire.', '2012-10-23T14:24:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, e6002299-4429-4b3d-9718-f69e1a8be7cb, 'Trop bon !!!! ', '2012-05-03T15:09:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 8a79a21a-13c3-4be7-aadb-5c90e4c47439, 'Un plat excellent ! J''ai adoré.  Le mélange endives, pommes de terre permet pour les plus petits d''apprécier un peu plus les endives. Je refais sans hésiter !', '2011-06-05T15:01:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 3aa7c3ec-5888-4cea-aebf-64ac9782a3a2, 'Très bon, on a adoré!!! Rien à dire! Les endives cuisinées de cette façon ça change! Rien à changer dans la recette!', '2011-03-29T14:07:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, b58c5127-934c-4468-80ae-b5e89e1b8569, 'Excellent ! A faire et à refaire.', '2011-02-24T16:05:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 128fa58b-68d6-44d3-a336-36451c8fab32, 'Que dire de plus que les autres internautes ? A part un grand WAHOU ! J''adore les endives, j''y ai ajouté du curry de Madras en fin de cuisson, quel régal ! Merci pour cette bonne idée !', '2011-01-05T20:25:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 06aca439-9aa4-4a20-9864-80602a72e85c, 'Bon, facile et pas cher', '2011-01-01T20:13:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, ed412553-8267-4e04-ad05-ed3b77af29fb, 'Un grand bravo !! C"est troooop bon et super facile !!!!! Merci pour cette recette !!', '2010-11-15T21:10:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, e2755f0e-8e8e-4a0e-9a08-9a3f927225a7, 'Recette à refaire car : simple, peu coûteuse et bonne. J''y ai ajouté un reste de jambon.', '2010-11-12T09:27:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, e22e554c-9f0a-4221-b7fe-9b26280d3d14, 'Excellente recette. Mon mari a beaucoup apprécié. Voilà une très bonne nouvelle façon de manger des endives. ', '2010-03-08T16:53:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 8d9203f5-e35c-4659-ac59-70e6783e35c4, 'Excellent, vraiment très très bon, mon mari et mes enfants n''aiment pas les endives, et bien ils en ont pris 2 fois, à faire et à refaire merci pour cette recette.', '2010-03-02T21:06:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 407db011-e46e-453d-9174-d251bcd98e37, 'Vraiment d.e.l.i.c.i.e.u.x !', '2010-02-17T22:07:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, e5914d13-c969-4199-bdde-89f7caace851, 'Testé ce midi et approuvé! J''ai suivi la recette à le lettre et ai mis le tout dans des petites cocottes. c''était chic et bon !', '2010-02-06T14:46:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, f2e86cae-aaf3-44e0-81d5-982df2307048, 'Une recette originale pour cuisiner les endives ! Un bon mélange qui se déguste très rapidement ! A refaire !J''ai alterné une couche de pommes de terre, une couche de mélange, et j''ai terminé par une couche de pommes de terre. ', '2009-12-08T11:50:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, a9ac9c5a-0554-472b-8433-1c86f66dc4e7, 'Voila une très bonne recette, cuisinée comme la recette l''indique toute la famille s''est régalée. A refaire sans problème ', '2009-11-15T14:20:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, dbde7af4-c448-444a-b604-d85de30ddddc, 'Nous avons mangé ça avec du jambon, c''était très bon. Nous qui n''aimons pas les endives avons léché le plat !', '2009-04-30T14:28:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 5f50cc8f-ff9d-44f5-8e3f-d8bc46a6be6d, 'Pour cette recette j''ai rajouté de la moutarde avec la crème fraîche pour ce qui aime les plats un peu relevé et j''ai rajouté du compté c''est super bon! A vous de tester.', '2009-04-06T11:19:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, f9c26239-2508-4d4f-80a6-dc6b7675d311, 'Très sympa et facile à faire, j''ai rajouté du sucre à la cuisson des endives pour les caraméliser. L''homme a plus que adoré!', '2009-04-02T13:45:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 452182eb-1584-4dad-b7ab-2f1da6864fb5, 'Très facile et excellent!', '2009-03-04T18:37:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 0fd3f7a1-c3eb-4ccb-8e89-7b2271433a11, 'Très bon, j''ai juste coupé les pommes de terre à la mandoline et les ai mises telles quelles dans le plat à gratin. J''ai également intervertit pommes de terre/préparation/pommes de terre... un peu plus de crème liquide aussi... A refaire absolument!', '2009-03-03T21:39:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, ae5d003a-dc7e-486e-b860-64a08a4d6839, 'Très bonne façon de manger des endives. Je n''ai rien changé à la recette. J''ai juste oublié un instant mes endives dans la sauteuse qui ont caramélisés... un délice ! A faire et refaire !', '2008-11-03T13:49:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 28564f28-7a40-47e6-b665-ab1c70b1e407, 'C''était très bon, à refaire.', '2008-03-27T21:45:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, d8656096-fd7a-4417-bdd3-50ac67249128, 'Excellent, j''ai rajouté du gruyère râpé pour faire gratiner, une bonne idée pour faire manger des endives aux enfants!', '2007-02-24T16:33:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, f1e8a447-4f31-46b4-891f-c0eb29db8996, 'Une bien bonne variation rustique de l''endive! C''est copieux sans être roboratif, on s''est régalés et c''est vrai que l''on ne sent aucune amertume.', '2007-02-15T23:21:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 134ca368-44aa-44e7-8acd-accfddb08867, 'Absolument délicieux. On ne ressent pas du tout l''amertume de l''endive. J''avais fait cuire mes pommes de terre en quartiers ainsi ça va plus vite. Tout le monde a adoré même ma fille de 10ans. Ca fait une recette de plus avec les endives. Que du bonheur.', '2006-12-02T20:03:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, 82d69801-bd40-48ea-abde-2f9b5fd17f3f, 'Excellent! A accompagner d''une salade verte. ', '2006-11-02T16:17:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45826, d18bbf10-04a4-40c2-8614-292c1aa92003, 'Délicieux, recette rapide et simple et en plus très bonne.', '2006-04-12T23:34:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 19599b96-5dbf-4445-bbbf-72ed28741eee, 'Facile et super bon ♡', '2023-10-31T16:15:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 56fa1898-16a8-438c-a77a-bd8c1d71c25e, 'tarte aux fraises maison avec crème pâtissière maison et pâte sablée maison, un régal', '2020-04-05T14:44:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 1a012dd1-3910-47d4-96a2-46bf03c40c3a, 'J’ai remplacé le sirop par de la confiture de fraises 🍓 
😋 parfait 👍 ', '2023-03-14T13:49:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 90ec7725-c638-43c4-8df7-5cc367a63d57, 'Simple facile excellente ', '2022-04-18T09:31:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 0f4c1471-4ed0-4c4d-9c53-047f53e16c12, 'Faite pour 12 personnes et c''était un régal ! Il me restait des fraises, que j''ai servies en salade avec le reste du coulis  (je n''ai pas pu trouver de gelée de fraises, mais la gelée de framboises va très bien aussi). A refaire !', '2022-04-13T12:23:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 7729775b-9337-45b8-b753-8d1fbf9db5eb, 'Superbe tarte faite par ma petite fille de 9 ans', '2021-05-09T11:58:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 325d1add-9eff-4420-b7fd-3e1a8b58da4a, 'Délicieuse! 😍😋', '2021-04-14T20:38:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 61e86114-3df6-447f-8d2d-55ab5dbd0ae4, 'Une tarte qui manque de richesse et de gout. Je vais essayer d''autres recettes et reviendrai :-) ', '2021-03-13T16:55:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, c85e8858-5450-402b-bcd8-2804d19cdb8c, 'Tarte aux fraises faite version crème patissière et pâte sablée maison. Parfait', '2020-05-09T18:36:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 2161c491-e963-4032-b991-d0b26b42c3ad, 'Recette très facile  , après j''adapte la quantité de fraises à la taille du moule , toujours de la crème pâtissière dans le fond  , un délice ', '2020-04-28T18:19:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 27449f50-5a25-496f-9c56-88ac4b4e3b59, 'Je je suis novice question tarte aux fruits celle-ci me paraît facile mais j''ai un souci je ne comprends rien à vous mathématiques pour la crème seule compréhension rajouter vanille et verser au fond du moule peut-être est-il possible de retrouver ces explications sur une autre page je vous remercie quand même car plusieurs recette sans facile simple d''explications peu coûteuse et à la portée de beaucoup et en cette période de pandémie je vous dit prenez soin de vous
', '2020-04-06T18:03:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, accfbdbb-041d-4c12-a284-79cf1de04c63, 'Moi et les tartes ce n''est pas le grand amour (toujours pas formidable) la une réussite,  j''ai fait moins cuire la pâte sablée et j''ai fait un coulis fraises/framboises pour manger avec, une crème pâtissière pour le fond de tarte, merci encore je me suis surprise moi-même.', '2017-04-30T19:34:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 35658b20-09d6-4490-b00e-a4dd6b3e3bd4, 'Tarte trop cuite : il faut surveiller la couleur pendant la seconde étape de la cuisson, peut-être que 5 minutes suffisent. Peut-être aussi que la pâte feuilletée serait meilleure car celle-ci se casse. Pour le reste très bien avec d''excellentes fraises.', '2016-04-25T11:35:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 929169e6-9a72-44e4-9883-e1d3427a693b, 'Pour moi aussi trop de fraises et pâte cassante car trop cuite. j''ai mis de la confiture de fraises au fond de la tarte. j''essaierai la prochaine fois de cuire la pâte moins longtemps. ', '2015-04-25T20:50:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, d1bd2094-e9f4-4075-b146-5404cd67c57b, 'Très facile pour un débutant, attention à la cuisson de la pâte qui ne doit pas être trop cuite ni trop fine,sinon elle devient cassante et ça gâche le plaisir. En ce qui me concerne, le coulis était plus compact le lendemain après une nuit au frigo...', '2014-04-19T18:39:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, d978a63e-5e60-4472-ae12-ff3c8afc2bb8, 'Excellente refaite 2 fois avec une pointe de sirop de menthe !', '2014-04-05T18:19:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 9eafdbcb-3a3d-4014-90b0-85dc54510903, 'C''était très bon, en plus les fraises étaient parfaites.', '2014-03-03T15:58:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 42270fe3-a9ad-4714-8167-37a4fcb4b430, 'La tarte avec la crème pâtissière est vraiment délicieuse.', '2013-06-19T11:04:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 866d810a-75aa-4730-a96e-283fade66d07, 'Très très bonne ! Je l''ai faite avec de la crème pâtissière mais sans gelée car je n''en avais pas, le résultat était très bon quand même, bien qu''à la fin ce n''était plus vraiment la recette originale !', '2013-05-24T23:45:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 8ada040f-6798-4ff4-9423-5da04d3f96b8, 'Très bon, je l''ai faite avec de la crème pâtissière, attention à bien étaler la pate pour ne pas qu''elle soit trop épaisse, excellent !!', '2013-04-29T00:22:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 05b1a97d-bb05-44ce-95b9-1a05a20c8dbe, 'J''ai divisé la quantité de fraises par 2. Pâte trop cuite et dure, malgré un temps de cuisson de 20 minutes en tout. Pas terrible, finalement !', '2013-04-15T12:20:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 246881de-cf40-40f1-804f-2df89a34ae67, 'Excellente tarte. Je l''ai faite avec une crème pâtissière... mon mari en redemande.', '2013-04-08T19:27:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, bda24ae4-4498-4d76-85e6-484838e443c8, 'J''ai mis les fraises à égoutter sur de l''essuie tout pendant que je faisais le coulis ce qui m''a évité le côté détrempé que j''ai lu dans plusieurs commentaires. J''ai ajouté un peu de citron dans le coulis car il était trop sucré. La pâte se casse quand elle est froide donc pas très facile à couper mais très bonne au goût. A part ça c''était plutôt réussi pour mon premier essai. Merci pour la recette. ', '2013-04-07T21:58:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, d8780df3-0b0a-4efa-b7c3-118aedd1b690, 'Super bon et facile !', '2013-04-07T11:53:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, dda387fd-81ce-4d24-854f-869e554f8079, 'Avec de la pâte feuilletée, c''est impeccable !!!', '2013-04-06T20:21:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, b701450d-bbe2-4d13-b265-0bf505653994, 'Très bonne recette, j''ai réussi ma première tarte, merci !', '2013-04-06T11:56:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 1dc7b4f2-f062-4019-8e31-8d373be09912, 'Excellente tarte, pour ma première tentative c''est une réussite ! Merci pour cette superbe recette.', '2012-07-30T01:48:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, bfee68cf-e47d-4978-bc11-afe174c425b3, 'Pour que la pâte reste croustillante, faites fondre du chocolat blanc que vous badigeonnerez sur le fond de tarte cuit. Cela fait une couche protectrice contre l''humidité de la pâtissière. ', '2012-06-05T14:40:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 24bee2d9-a751-4e05-a5a2-886bbe65a60f, 'Excellent, j''ai fait cuire ma pâte à tarte 20 min - elle était très croustillante - j''ai ajouté une crème pâtissière et les fraises. La pâte n''était pas imbibée.', '2011-06-15T09:35:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 30e174fd-01d6-4552-81f6-47ff2083dac0, 'Parfait avec une crème pâtissière.', '2011-06-13T19:26:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, c86eb262-c9b4-4958-8090-ac9b4bf5e173, 'J''ai suivi la recette sauf que je n''ai pas ajouté d''eau à ma gelée de groseilles, mais il faut la consommer aussitôt, sinon, la pâte s''imbibe trop et on ne peut plus couper la tarte.', '2011-06-13T13:21:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, a10fcf4c-b560-441a-a0af-d03ecc121d54, 'J''ai suivi les commentaires et ajouté une crème pâtissière. J''ai remplacé la gelée de groseilles par de la gelée d''airelles. Le petit coulis ajoute vraiment une petite note sympa. ', '2011-05-15T23:45:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 24ad99b7-70b1-4404-8550-3c65c5245e7f, 'Tarte complètement imbibée par les fruits et la gelée de groseille mélangée à un peu d''eau. Tarte imprésentable, en bouillie. Et pourtant fond de tarte bien cuit à part. Seule solution faire une crème pâtissière pour absorber le jus des fraises fraîches.   ', '2010-06-20T20:23:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 1eb40e2f-8b98-4b9f-8909-21729b7a0fef, 'Saison des fraises oblige et confitures en cours, j''ai remplacé la gelée de groseille par le suc de la confiture refroidie... Un vrai délice.', '2010-05-30T13:40:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, b289be5c-cc06-44ad-b8e7-88229b025541, 'Je ne suis pas très douée mais en suivant la recette à la lettre ça a été une catastrophe! Je n''ai pas mis de crème sur la tarte et certainement un peu trop d''eau dans la gelée de groseille. La pâte était cassante, les fraises imbibées. Je suis bien déçue en voyant tous les commentaires positifs...', '2010-05-17T10:28:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, bd672c69-1113-4fdf-b691-6a3cd982fbe9, 'La recette est très facile. Pour ma part, j''ai mis sur le fond de ma tarte de la crème pâtissière maison, mes fraises puis la gelée de groseilles... Fabuleux, à refaire !!', '2010-05-10T14:51:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 69acde5c-1ff4-4c11-bd25-bf3d0d240b84, 'Excellente avec une crème pâtissière allégée de Lisa ! J''ai juste oublié de faire cuire ma pâte avant, une fois les fraises déposées délicatement sur la crème, je m''en aperçois !! Tant pis j''enfourne 15 min, et bien ce fut quand même une réussite pour une première. Elle est meilleure que celles achetées chez le pâtissier, merci beaucoup.', '2010-04-20T23:13:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 2979c52d-6d8b-43e6-8e94-4fec3c8f25ee, 'Très bonne recette, j''ai adoré et ma famille aussi. A refaire !!', '2009-11-29T02:13:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, b480992d-45ef-47d6-ae71-3da14a9998b4, 'Très bon ! Ça change des tartes à la crème, elle était croustillante, mes invités ont apprécié.', '2009-07-04T17:34:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 621cb7f7-02ea-456e-87b5-409f04bc94c7, 'Super excellent, tout le monde a adoré, on recommencera.', '2009-06-10T19:59:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 02d293f5-75a8-454c-b350-e7b6f00ea749, 'J''ai pris une pâte toute prête; au fond de la tarte, j''ai mis un peu de crème pâtissière, ce qui améliore le goût, les fraises et le coulis de fruits rouges dilué dans de l''eau : je vais opter pour ajouter une feuille de gélatine, car l''on retrouve un trop "du liquide". Ce n''est pas trop grave, c''est extra !', '2009-06-08T18:57:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 400121a8-a00f-4c0f-9a17-42a4b0ebdda6, 'Super simplissime et elle a fait son effet. A refaire absolument !', '2009-05-25T22:13:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, d7fc03a0-af60-4274-b2f3-e2f49bd36b0e, 'Je fais sans crème pâtissière et j''ai suivi la recette à la lettre. Super et rien à dire.', '2009-05-19T03:54:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, ec83d8c7-de43-423d-92ce-73ddc62bfa24, 'J''ai essayé deux fois de la réaliser mais je ne suis pas très doué apparemment. Le temps de cuisson ou le thermostat me semble un peu long (étant donné que la première a brûlé). Dans tous les cas, 1kg de fraises c''est trop, à chaque fois j''ai utilisé 500g et il m''en restait. Enfin comme je l''ai dit, je ne suis pas très doué alors ...', '2009-05-07T11:44:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 0b4f1ce6-552f-4879-aaa7-d7f686796b6b, 'J''ai réalisé la recette avec quelques modifications, sur ma pâte j''ai posé mes fraises sur une crème pâtissière et j''ai réalisé un coulis de fruits rouges auquel j''ai ajouté une feuille de gélatine afin que la tarte se tienne que j''ai fait couler sur ma tarte, 1/2 heure au frigidaire et hop l''apparence est bluffante et le goût à la hauteur de mes espérances ! Merci', '2009-04-11T22:29:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, ec3db02b-4a19-48ef-9b56-a43a6eb30a62, 'C''était ma première tarte aux fraises et elle était excellente (j''ai quand même mis moins de sucre que prévu!)', '2008-08-26T20:24:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 9c145c82-d281-4211-be7d-c0e3a78130bc, 'C''était écœurant, je n''ai jamais gouté une recette pareille. Je rigole c''était très bon, j''ai adoré.', '2008-08-18T19:52:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, e8271455-ef55-4a7b-990f-9f7dc4c57ecb, 'C''est la première tarte que je prépare, quelle réussite! La prochaine fois, je mettrai un peu moins de sucre dans la crème pâtissière. Surpris quand mon épouse est revenue du travail, une demi tarte à été engloutie comme dessert!!! Vivement l''arrivée des mûres.', '2008-07-08T21:43:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, ac8d0985-823b-49f5-896c-3bfa60d50e6b, 'C''était très bon, mais j''ai arrangé la recette à ma façon. Très peu de coulis que j''ai appliqué sur chaque fraise au pinceau, une très légère couche de crème patissière sous les fraises... un régal même le lendemain (mais attention la tarte ne se tient plus aussi bien).', '2008-05-09T13:04:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, aaa6f76b-6db2-4af7-b2b2-f687025d769b, 'J''ai trouvé la recette facile et rapide. Ne pas mettre trop d''eau car le coulis serait trop liquide. Mes enfants ont adoré. Merci!', '2008-03-14T16:12:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 94dd6a8d-e83c-48a8-8ce7-8a6bd7d72c0e, 'C''est un délice, ces fraises sont trop bonnes avec la crème anglaise.', '2007-10-13T18:08:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 53cb1732-cfe2-45d6-a9a8-634884c9b03b, 'Mouais... je ne suis absolument pas conquise!!! le coulis est très liquide et a fuiS partout c''était légèrement catastrophique... ce n''est ni plus ni moins qu''un morceau de pâte avec des fraises!! ', '2007-08-03T00:39:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, c2363359-d37a-47d8-bcb1-b7fbbf0ee41f, 'Très bonne, même sans crème pâtissière! J''ai fait la pâte sablée et l''ai laissée refroidir. Je l''ai nappée de coulis, puis ai disposé les fraises et les ai recouvertes de coulis avec un pinceau. Tout le monde a adoré! Merci pour cette bonne recette facile et délicieuse!', '2007-05-27T00:44:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 3d5ce709-6a26-4229-b267-b8dce1d5a662, 'Super bon! De la poudre d''amandes dans la crème pâtissière...hummmmm.', '2007-03-24T20:23:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 97a2096a-0acf-4179-98e5-9fcf5e08cda8, 'Délicieuse, même avec une pâte sablée achetée prête à dérouler... Il n''en restait pas une miette!', '2006-06-27T17:26:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, b1e64c7c-7a97-4917-a574-c0bde4ae7325, 'Impec! (Avec de la crème pâtissière, c''est parfait).', '2006-05-31T10:19:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 520df95b-6b8d-44d0-ab51-81e6d21dc840, 'Tres facile et délicieuse. Comme pour toutes mes tartes, je fais cuire les fonds sur du papier cuisson , cela évite l''ajout de matière grasse. Sirop réalisé avec la gelée de groseille et un jus de citron (sans eau), succès garanti!', '2006-05-08T11:14:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, e69d0364-1dd5-4cee-883c-5174567ee458, 'Très bon, en ce qui me concerne, je l''ai faite avec une crème pâtissière et un nappage spéciale tarte... C''était très bon, très appréciée par nos invités, Merci...', '2006-05-02T15:27:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, 6a6f1f34-e096-4f04-9d86-cbfbed26cad7, 'En effet le titre le dit bien, très facile et tellement bonne. J''ai mis un fond de crème patissière, un régal!!  Bravo et merci pour cette recette super rapide.', '2006-04-13T13:06:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16846, b67c3281-61b3-4f13-8acc-c2ec9eb45c4e, 'J''ai utilisé un fond de tarte brisée du commerce, fait un fond de crème patissière et mis 500 g de gariguettes. Pas d''eau dans la geléé. Et le résultat était sublime.', '2005-05-21T16:14:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 65250f39-6e6c-41b1-825f-43d1e0fbc324, 'J''ai remplacé les pdt par des pdt douce et les carottes par des navets', '2020-12-23T13:36:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, f0cc86b1-6f8e-4bae-8787-cf317979d54d, 'Facile et efficace c''est parfait ! ', '2020-04-04T17:39:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 086e7608-601a-4121-8431-c560557961d5, 'Très bonne recette : j''ai remplacé les lardons par des paupiettes. Ce fut un régal 🙂', '2022-10-12T14:10:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, fffe1581-4ed7-4644-8bb3-1af3074ead80, 'Sympathique recette , y ai rajouté des panais et malheureusement pas de lardon sous la main !
On s''est régalé ...', '2022-03-15T09:39:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, e5f8788f-50fd-46a0-b0da-fa2fc5b7f8a1, 'Très bonne base de recette, le mélange d''épices est délicieux même sans les baies. Attention temps de cuisson erroné : 2 heures à 2h30 pour moi. 1 chou complet 10 carottes et 5 pdt pour notre version dans une grande cocotte. Juste attention ne surtout pas mettre le sel indiqué, le bouillon et épices suffisant. On peut même diminuer à un demi-cube si on ajoute une palette de porc en cuisson au bout d''1h pour moi mais c''était une petite palette ', '2021-02-27T17:39:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 4dc8e008-eb6b-4d6e-8c87-3338e472b800, 'Excellent plat, mon fils qui boude toujours un peu les légumes adore cette recette.', '2020-11-11T13:01:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 4fdf236c-5bfa-48c2-b2ff-75e249261d65, 'Un peu déçue car trop salé. Le bouillon cube suffit largement et je l''ai fait préalablement fondre dans le vin blanc + eau. Pas d''ajout de sel !', '2018-09-21T15:03:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, ab4fb527-faca-4ef1-a48d-524ff7f91d4d, 'Cette recette coincidait exactement avec mes restes de frigo et je ne suis vraiment pas déçue de l''avoir réalisée. C''était un délice. Merci beaucoup on s''est régalé !', '2018-05-09T13:09:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 1700fbca-c4cc-4e67-acb4-9d4f650fcd8d, 'Un des meilleurs plats de légumes que j''ai mangé, vraiment excellent ! Facile à faire, délicieux à déguster !  ! Je suis réconcilié avec les légumes !', '2017-10-18T19:20:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 91c99c00-a8c2-4169-8b87-42f29cae34bf, 'J''ai également ajouté les 2 navets qui restaient dans mon bac à légumes. Un vrai délice !! Mon fils de 3 ans a fini son assiette jusqu''au dernier bout ! Petite astuce : pour faciliter la digestion du chou, j''ajoute toujours quelques graines de carvi et en plus cela ajoute du goût !', '2016-12-13T20:55:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 8cdfe145-20a8-4c0f-b1e6-423e30e336eb, 'Exquis !', '2016-06-16T22:34:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, d7850262-59d6-4eb7-9de0-cde98c957528, 'Tip top, je n''ai mis que le vin blanc en ajout et avec les épices recommandés c''était un vrai délice...! Merci pour cette simple mais très bonne recette!', '2015-05-15T01:27:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 6d45b3a8-5e77-4704-91a8-35f5ad06cab9, 'Le temps de cuisson est sous estimé, effectivement, j''ai laissé au moins une heure. ', '2014-11-16T00:01:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, ba3eb4c7-70a1-4f4f-a831-c64f24f69b49, 'Recette réalisée ce jour. Cuisson un peu plus d''une heure trente, à feu doux. Un seul mot : GÉNIAL. ', '2014-11-05T14:17:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, a25ad0cd-a340-4a73-9ba4-fdf53633452a, 'Excellent', '2014-02-21T15:15:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 229388ab-b332-4ed6-8db5-4fc01d0b4b94, 'Simple et rapide à réaliser. Excellente potée, même sans les graines de coriandre et les baies de genièvre. Servie avec des saucisses de Montbéliard, un bon moyen de passer les frimas de l''hivers !', '2014-02-16T18:05:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, ce706d0e-d766-43d4-82f2-847b970e64ad, 'Très bonne recette ! Je n''avais pas de vin blanc donc je l''ai remplacé par 20 cl de bière blonde. Je n''ai pas mis les épices. C''était très bon, tout le monde s''est régalé !', '2014-01-26T22:46:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 7b5ce0ad-d4f8-47fe-9901-05a73da3c620, 'J''ai suivi la recette en ajoutant un gros morceau de petit salé et des diots, j''ai laissé mijoter sur feu doux pendant 1H30... Un délice !', '2013-12-01T21:10:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 0a558d82-3505-4c0e-b8d6-a6abee327344, 'Très bon mais nécessite au moins une heure de cuisson. ', '2013-11-17T14:32:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 29381dd7-d5b6-4614-a3f7-a7b28cb6b460, 'Excellente façon d''accommoder du chou. J''ai cuit le double du temps indiqué pour que cela soit un peu plus confit (vérifier impérativement le niveau de liquide en cours de cuisson pour éviter que cela n''attache). Petit truc pour ceux qui ont du mal à digérer le chou : ajouter une cuillère à café de bicarbonate de soude dans l''eau lors du blanchiment de celui-ci (valable avec tous les choux : frisé, rouge, de Bruxelles...).  ', '2012-12-05T13:57:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 022f7feb-c2b8-4e0c-a8d6-523588f30a6e, 'Mes beaux-parents font un potager et nous avaient offert une tonne de choux, pommes de terre et carottes. La recette tombait pile poil ! Bonne recette (lardons remplacés par du saucisson !) fondante et presque sucrée. Même ma plus jeune fille a accepté de manger les carottes, ce qui est un gage de qualité !', '2012-11-14T09:19:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, bb2df593-8066-4999-aaf3-56cbd948c009, 'Très bonne recette ! Je n''avais pas de vin blanc mais j''ai ajouté un peu de moutarde afin de relever la sauce et c''était pas mal... mais après avoir goûté le plat....ça aurait été meilleur avec le vin.', '2012-11-02T20:35:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 14082859-ca20-430e-843c-f1849dedb5a0, 'Cela fait plusieurs années que j''ai trouvé cette recette sur Marmiton. Je mange toujours ce plat avec autant de plaisir ! En général, je remplace les pommes de terre par des navets coupés en quatre. Parfois j''ajoute un poireau. Parfois, je mets un bâton de cannelle. Je fais cuire deux heures dans une cocotte en fonte à petit feu. ', '2012-02-12T15:17:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, b8b26b91-9389-4bb1-b594-2f5cc747ee92, 'A refaire absolument ! Un plat d''hiver complet et original ! Merci.', '2012-01-31T18:39:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, e58c6e7d-8916-4715-a120-940645e1aa40, 'Facile et trop bon !!!', '2011-12-18T20:03:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, e7cf267a-d144-4f7b-b64f-f1e2c617d9ed, 'Ayant adapté la recette pour deux personnes, j''ai trouvé la quantité de choux trop importante par rapport aux autres légumes, sinon le mélange d''épices avec les doses données est très harmonieux et vraiment très bon, je le referais avec un moins de chou.', '2011-02-02T10:20:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 96565259-8743-4815-b6fc-c7b8fa66d5e0, 'Cela fait plusieurs fois que je fais cette recette ; c''est un bon plat d''hiver qui permet de manger des légumes. J''y ajoute des poireaux et en viande je fais revenir des chipolatas à la poêle. C''est vrai les lardons donnent un bon goût.', '2010-11-30T11:25:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, b776ceea-78b6-4d35-ab09-1168ede0028a, 'Merci pour cette recette ! J''ai enfin pu cuisiner du chou que toute la famille a apprécié, y compris ma fille pourtant très réfractaire au chou... N''ayant pas d''oignon, je l''ai remplacé par du poireau. J''ai tout fait cuire en autocuiseur durant 15 minutes environ.', '2010-11-13T14:24:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 8b9f551f-f5fa-412e-ab1b-1b3b4e8844e7, 'Super recette! C''était vraiment très bon. Faute de lardons, on a mis du confit de canard c''est un délice surtout réchauffé le lendemain! merci pour cette recette idéale pour l''hier!', '2010-11-08T15:25:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, d5a9a241-b09e-4550-8071-ff3a719ee79b, 'Tout le monde s''est régalé ! Merci pour cette recette !', '2010-10-25T23:29:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 1c7e1b1d-0c4d-4392-aa33-125bf1d75341, 'Très bonne recette ! J''ai suivi les conseils d''autres internautes et j''ai mis deux saucisses fumées à la place des lardons. J''ai laissé cuire bien plus longtemps qu''indiqué, 45-50 minutes. C''est encore meilleur le lendemain réchauffé.', '2010-02-01T15:06:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 321a1e1a-bef6-485f-b88c-d9f3218f6016, 'je l''ai fait avec du chou blanc et j''ai cuit en même temps un rôti de porc fumé et c''était très bon.', '2010-01-10T17:54:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 09ec7d6a-b37c-4677-a1c4-254f0f8ebb55, 'En suivant les commentaires, j''ai remplacé les lardons par une saucisse fumée et fait cuire plus longtemps. Un plat complet que toute la famille a apprécié. J''ai pour ma part trouvé que le 4 épices et les oignons donnaient un petit côté sucré légèrement écœurant.', '2009-06-21T22:22:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 8ce8efdf-9fd5-4b70-b4b4-b633d32d351c, 'Très bon, pour ma part dès qu''il faut mettre de la coriandre en graines ou baies de genièvre. Je mets toujours dans une mousseline (compresse) je n''aime pas trouver les baies qui ne se mangent pas. Une recette pour redécouvrir les légumes que les enfants n''aiment pas parfois. Ne pas abuser des épices.', '2009-03-22T15:51:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, d5248218-b44d-4c92-ace2-0ef0a84c06c2, 'Très bonne recette, mon chéri s''est régalé. Par contre j''ai fait cuire une heure, la prochaine fois je couperai les carottes en plus petits morceaux car elles avaient du mal à cuire.', '2009-03-01T19:46:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 98bf2d0b-36a5-4e9d-9a30-ccf3f8bcbde3, 'Très bon, mes enfants sont fans.', '2009-01-27T19:59:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, f1fd27cb-0c0d-46d0-bc1d-f03fde9f9b41, 'J''avais un chou frisé dans mon panier bio...j''ai donc tenté cette recette et ce fut délicieux !!! Merci !', '2008-12-08T21:22:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 215f2ccc-ed1d-41f9-9423-36bc4b2eaee9, 'Tout simplement délicieux! Un simple demi chou pour nous et des saucisses fumées en lieu et place des lardons. J''ai laissé cuire 3/4 d''heure pour que le chou soit bien imprégné de sauce, c''était un régal. Merci pour cette recette !', '2008-10-25T16:02:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, f623bd61-15fa-4aaf-87cd-6e4735bc6fe9, 'J''ai adoré...', '2008-10-14T14:42:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 36738306-047c-4f5a-b971-851dbf60c6f8, 'Très bon, très facile à faire. J''ai oublié de faire revenir oignons et lardons, ayant ajouté 10 min avant la fin des saucisses faites maison cuitent préalablement au four.', '2008-04-17T18:15:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 37f48e6b-6010-4d38-888c-be1320c766b1, 'Excellent, très facile...tout le monde s''est régalé!', '2008-03-20T13:43:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, b683b1eb-a6cc-41a0-ad2c-4c26a7085922, 'Délicieux. Uune bonne idée pour faire le plein de légumes et quel bel assortiment que celui lardons-chou frisé !', '2008-02-24T14:48:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 949d3eec-d875-44c2-a1a7-5b93372b85b9, 'Simple et excellente potée.', '2007-12-20T23:52:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 7fef2d84-b3bd-4b10-a303-fb567944e936, 'Parfait! Ma famille a adoré, bien que la plupart d''entre eux m''aient annoncé qu''ils n''aimaient pas le chou!', '2007-10-20T22:14:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 28fd81c3-7373-4334-ba9f-9ac66a9a2bce, 'C''est vraiment très bon. Accompagnement recherché qui ravit tout le monde, les amateurs de légumes comme les plus réfractaires... Attention à ne pas trop forcer sur la coriandre qui risque de l''emporter sur le reste.', '2007-06-27T21:11:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 1f0c0222-ab78-4dc6-bd25-a2400d4986f7, 'Huuummmmm!!! Un délice!!! J''ai cuit à la cocotte minute car je n''ai pas de cocotte en fonte : 15 minutes en couvrant simplement, 10 minutes en mettant sous pression vapeur. J''avais rajouté une poignée de raisins secs et une pincée de gingembre. Le tout est fondant et divin...goût subtil...on en redemande!!! ', '2007-03-24T19:12:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, a9593d92-6bd2-4d27-abd8-4147a76ae844, 'Je faisais ce plat depuis longtemps mais sans le vin blanc, les graines de coriandre et les 4 épices : je suis conquise, je le ferai comme ça dorénavant. Merci beaucoup!', '2006-12-10T20:31:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 637081e3-0d6a-4e9c-b41b-52d61dee0909, 'Très bonne recette.', '2006-12-06T09:47:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, c60b2187-5247-44de-a030-e2c0e1d9a5aa, 'Délicieux, mais j''ai fait cuire bien plus d''une heure pour que le chou soit presque "confit".', '2004-12-08T21:31:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, ed5a6db1-7ebd-4c01-98e5-d96158075e83, 'Excellent !! Attention à ne pas mettre trop de 4 épices. Couper les pommes de terre en petits morceaux pour faciliter la cuisson. Faire cuire à couvert. Si comme moi vous n''êtes pas fan, penser à mettre les graines de coriandre et les baies dans une compresse pour la cuisson. Cela vous évitera de les trier en savourant votre plat..', '2004-11-05T14:23:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, 2542d534-2319-45ab-8aae-1c8ca931c491, 'Du plus petit (20 mois) au plus grand tout le monde s''est régalé.', '2004-02-25T14:16:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20457, c6a91839-eb0d-41a0-b1ac-00c51db4c85b, 'Excellent.', '2003-02-03T08:09:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35751, 70206260-ea89-46b7-aaf1-467c0d237ab1, 'J''ai fait un peu plus d''1 kg de rhubarbe et un peu moins framboises,et seulement 1 kg de sucre gélifiant. C''est délicieux !', '2013-05-04T13:15:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35751, 677dc086-87a1-4aad-8040-7bdf4a31238a, 'Très bon mais un peu liquide, sûrement dû aux framboises surgelées... il faut peut être les laisser décongeler avant pour les laisser rendre leur jus.', '2014-04-27T00:59:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35751, 9915c076-5607-4dd6-8d88-e9e7eabcf1c9, 'Un seul mot : EXCELLENTE.', '2013-07-12T14:32:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35751, f1e9d84a-d18c-48ee-bbaa-7a29b1dec9d6, 'Merci pour cette recette ! Ce sont mes 1ères confitures et elles sont parfaites et avec les pancakes de phyxie c''est juste à se damner. Comme d''autres, je n''ai mis qu'' 1 kg de sucre à confiture allegé sinon le reste de la recette a été suivi à la lettre.', '2011-09-24T22:06:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35751, 0ad9b5a2-4f9b-41a2-8f4e-03f92688e06f, 'Très bonne idée de confiture. La framboise et la rhubarbe s''associent très bien. J''ai mis 1 kg de sucre gélifiant pour confiture et 600 g de sucre cristal. La consistance est parfaite, ni trop compacte, ni trop liquide. Par contre, j''ai laissé cuire plus longtemps, une bonne 1/2 heure pour que les tronçons de rhubarbe réduisent bien. ', '2010-08-07T19:06:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35751, fa38d2e9-d883-4de4-b4de-f7fc765c7b57, 'Parfaite. Je viens de la faire, j''ai mis 1 kg de rhubarbe et 600 g de myrtilles congelées et 1kg de gel sucre. Sublime. Le goût de la rhubarbe est adoucie par les myrtilles un délice a refaire', '2010-06-13T18:41:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35751, 9daff0d2-db53-44ce-9fac-01a8de54423f, 'Juste un mot pour définir cette recette : "excellent" !', '2010-05-17T13:25:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35751, a07ad85e-5193-414d-8ee5-6f74378de26f, 'Sublime, je l''ai faite cet après-midi, j''ai mis 1 kg de rhubarbe, 1 kg de framboises et 1 kg de gel sucre pour confiture allégée; j''en ai fait 7 pots et un petit bol pour demain matin, j''adore ce petit goût acidulé. Merci pour cette délicieuse recette.', '2008-09-21T20:02:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35751, ec46a1e0-a201-4135-a056-6ffe7daef234, 'Simple et efficace. Je l''ai faite avec des fruits frais et le résultat en vaut la chandelle. Avis aux amateurs de tartines de confitures légèrement acidulés.', '2008-08-20T23:36:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35751, 363c3968-1ac8-46bc-be96-335f5d8d0b06, 'Parfait. Le rhubarbe ne se sent pas mais adoucit le goût de la framboise. J''ai mis 600 g de framboise, 600 g de rhubarbe pour 1.2 kg de gelsuc. Cela m''a fait 6 pots', '2007-08-06T14:51:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35751, 16453583-9fa7-4fd3-a005-0120d569ee5b, 'Di-vi-ne ! On pourrait même mettre un peu moins de sucre. Merci pour cette très bonne recette.', '2006-05-31T19:07:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, cedd9f69-e3ff-480b-a1ef-0b08bf8b7f59, 'Déçu par le goût.  Je m''attendais à ce que ce soit plus frais...', '2022-06-11T22:18:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, d275be19-5936-4d50-896f-17bef3d76ff8, 'Rapide à faire et excellente, je suggère plus de framboises ?', '2021-02-09T21:09:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, 4f8f2d14-9316-4c3f-8d15-bd103670ae38, 'Petite version végétalienne : remplacer le yaourt par du yaourt végétal à la coco, et du lait de soja à la place du lait de vache. Un délice !!!! ', '2020-12-12T12:21:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, e5504662-4ad9-4e78-9106-d8d252b1ebe4, 'Trop trop bon', '2020-11-01T16:13:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, 5a50c382-9586-4c35-ae58-6ccd92fdbfb4, 'Trop bon ces smoothies !', '2020-01-26T12:52:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, a75abf72-5652-4069-bf92-14d310aa46a3, 'Très bon. Très frais. Pour ma part, 2 poignées de framboise, pas de sucre, pas de lait et un yaourt bulgare. Merci pour cette recette bien utile quand les bananes mûrissent trop vite.', '2016-01-18T13:39:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, 67e5f75e-105c-4108-884d-6e486165abaa, 'Un régal ! Simple et rapide à la fois; à refaire !', '2015-07-10T18:47:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, 1857c805-c9e7-4e7d-aa1d-68834257e724, 'C''est trop bon', '2014-09-14T13:44:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, fc404e95-80e7-4a6c-92a6-b346d4bb092a, 'Recette simple et efficace. Pour ma part je n''ai pas rajouté de sucre, c''était très bon.', '2014-04-27T23:04:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, 145d3c3a-1db6-4ce7-97bd-1910d9d5466b, 'J''ai adoré, au lieu de mettre du sucre j''ai remplacé le yaourt nature pas un yaourt sucré ça suffit largement j''ai aussi mis trois glaçon et pour les pépins de framboises je l''ai passé au chinois ! ', '2014-04-27T18:30:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, 8386a6db-b3df-442c-8cce-da494f5fd6e7, 'Nous avons adoré ! Avec des framboises congelées, j''ai ajouté quelques glaçons... Une cuillère à soupe de sucre suffit, pour un côté pas trop sucré,  juste les petites graines des framboises peuvent déranger... Un bon dessert plein de fraîcheur dont les enfants raffolent.', '2014-03-22T11:06:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, aa57aa3a-be22-4ecb-b91b-9f0294e07f41, 'J''ai été un peu déçue par ce 1er smoothie.', '2009-04-01T16:04:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, 35265d09-82e8-416b-aa7b-4acbc82d3532, 'Délicieux et léger. Le goût de la framboise n''est pas trop couvert par la banane. J''ajoute toutefois un peu de lait de coco en diminuant la quantité de lait.', '2008-10-22T23:10:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (197431, 92e67746-ead9-45ff-9b99-a08b7ef7ebe9, 'Cuisson trop longue … plutôt sec.', '2023-10-14T21:12:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (197431, 0428821a-4f01-45ee-9a41-d322292df7cc, 'Très bon. 
Fait avec des framboises surgelées, j''ai laissé cuire un peu longtemps. ', '2021-09-18T14:58:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (197431, 980ca41b-cd10-4a18-9ad9-5e95fa418d32, 'Recette au top !!! J''ai mis une bonne épaisseur de framboises surgelées suivant les commentaires.... c''est parfait ! Merci pour cette recette ☺', '2018-05-08T09:01:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (197431, c1156dc6-ca5a-4d7f-8501-0fc2f8d54614, 'Pas tout à fait un brownies, plutôt un gâteau mais délicieux!', '2018-03-31T02:27:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (197431, 68c610ff-8a3a-4e60-963e-8cf0929c96ce, 'Super, mais ne pas hésiter à ajouter plus de framboises.', '2017-03-24T15:06:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (197431, 25e134e8-7a0d-4092-a5df-0c3781a954c6, 'J''adore.', '2016-03-12T13:15:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (197431, 5d36393d-c786-4a00-b4dc-49b3a98ddb9a, 'Trop bon mais la première fois j''ai trouvé que je n''avais pas mis assez de framboises', '2015-04-06T12:25:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (197431, 693513cb-81a1-41f9-8af4-a71e63ebf441, 'Wouah ! Recette vraiment top ! Ne surtout pas hésiter à mettre une bonne quantité de framboises, qui apportent une touche acide fantastique. ', '2014-11-20T19:39:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, 56756a62-c281-48ee-b4b7-b8d7a183e124, 'Super bon !!! Pour ma part, un peu sucré la première fois donc j''ai réduit à 90 g de sucre blanc et un seul sachet de sucre vanillé. Merci pour cette recette qui combine 2 de mes aliments préférés.', '2012-06-09T19:34:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, 7b3eda9b-fcb9-4652-8084-122b3b1d45b5, 'Facile, très joli et excellent. Tout le monde a adoré !', '2010-07-22T00:21:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, 9d45c8be-0636-44d9-aad2-c2e226782925, 'Excellent et a eu beaucoup de succès. Il faut trouver l''astuce pour éviter de mélanger rhubarbe et framboise (je ne l''ai pas trouvée) mais c''était tout de même réussi.', '2009-06-19T18:47:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, cbdd6409-4b73-4c29-b993-b2c436a1d55e, 'J''ai fait la recette avec mon fils de 3 ans qui a adoré (la faire et la manger). Super l''idée de séparer les framboises et la rhubarbe par des restes de pâte. Déco très réussie. A faire et à refaire.', '2008-06-21T08:17:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, 6f82da52-b48b-402c-83d6-c925e9007bd6, 'Très bonne recette! Je l''ai testée telle quelle avec des fruits frais et c''était très réussi! Même les enfants ont apprécié parce-que l''acidité des fruits est compensée par le sucre de la crème et par la douceur de la pâte.', '2006-07-23T11:29:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, 455bf1a5-a69c-4143-9107-a95a456b47af, 'Super cette tarte! Vraiment très bonne. J''ai utilisé des fruits congelés. J''ai mis la rhubarbe au milieu et les fruits rouges autour sans précautions spéciales et c''est vraiment très bon !', '2006-07-03T02:21:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, c800a7bd-3d08-46e0-9086-948c4e65b50a, 'La présence des deux goûts est plus agréable à l''oeil qu''au goût (la framboise a noyé l''acidité de la rhubarde dans mon cas) mais évite de faire 2 tartes, sinon c''est identique de faire les tartes séparées.', '2006-05-31T19:51:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, 71c9a536-9bf3-4911-93ef-6d7ef7c7966f, 'Délicieux, acidulé et gourmand! En effet le seul problème est de bien réussir à séparer les deux parfums, comme suggéré j''ai utilisé mes chutes de pâtes...', '2006-01-17T13:17:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, 9daba038-9b1e-4648-af09-31993defa879, 'Super bon, j''ai suivi les divers conseils et mis la rhubarbe au milieu et les framboises (entières) autour. J''ai séparé le tout avec un bout de papier sulfurisé que j''ai mis en cercle et que j''ai enlevé à mi-cuisson (quand tout était déjà "consistant"), ça a du mal à tenir au début (pâte très liquide), mais à la fin de cuisson, aucune trace du subterfuge ;-) merci encore', '2005-11-10T13:50:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, a2186981-3913-4983-b2eb-010e645916bd, 'C''etait tout simplement delicieux!!!', '2005-06-29T11:44:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, 38b36076-719d-45a9-9292-c720f0ce316f, 'J''ai remplacé la framboise par un mélange de fruits rouges et malgré une présentation un peu ratée, j''ai fait l''unanimité!!!! Très bon.', '2005-04-27T20:10:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, 8ec1812c-6ce9-41b3-8151-89461ef98c49, 'Il faut faire compoter doucement la rhubarbe, et puis bien séparer les deux parfums comme c''est indiqué, pour une belle présentation. En tout cas, c''est délicieux cette association.', '2005-03-15T22:43:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, 15ff9281-6674-47a8-abef-b3672c33cae7, 'Exellent! Pour ma part, j''ai séparé la framboise de la rhubarbe avec un morceau de pâte qu''il me restait.', '2004-07-08T17:59:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, c333ff71-6f77-4a09-8dd2-1c12f97a5e7d, 'Délicieuse! J''ai remplacé les framboises par des fraises et mis une fine tranche de pâte qui me restait pour faire la séparation. Je l''ai refaite une deuxième fois en replacant les 100g de sucre par 80g de fructose. Mmmh pour les papilles!', '2004-06-16T12:26:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, 1967864a-c98f-4d01-9459-fbd499e3e3b6, 'La tarte est très bonne au goût mais absolument pas présentable. Le rose et le vert se mélangent et à la cuisson l''ensemble devient marron! C''est vraiment affreux et c''est bien dommage car la tarte a très bon goût... Une suggestion: faire meringuer la tarte après la cuisson.', '2003-10-01T03:02:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, 8e3d00cb-f057-40c3-9b7a-fd0008637f2c, 'Mon mari est cuisinier, il a adoré... Pour ma part, j''ai utilisé une pâte feuilletée, j''ai placé la rhubarbe au centre et les framboises autour et jai ajouté une goutte de crème allégée avec les oeufs et le sucre. Acide juste ce qu''il faut... Divin!', '2003-05-07T20:07:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, 11fd977e-abee-4188-9974-460168516622, 'Bonne tarte, pas trop sucrée finalement. Pour pouvoir panacher les saveurs, faites des parts plus petites en alternant framboise et rhubarbe. Comme cela, vous goûterez aux deux saveurs à la fois!!!', '2002-09-02T11:28:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13534, b0df0301-4450-4a85-b1fe-e4abda03459c, 'Très bien! J''avais un peu peur de la teneur en sucre et je n''étais pas tres rassurée d''utiliser une pâte brisée au lieu d''une sablée pour cette tarte aux fruits. Mais le résultat était excellent, un goût juste et une très belle présentation. Je me suis démandée au dernier moment si je n''allais pas rajouter de la poudre d''amande dans le mélange sucre/oeufs...ce sera pour la prochaine fois!', '2002-05-18T22:49:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 103ab141-cb57-4b3b-bfac-fc3374d59ecd, 'Facile à réaliser (oubli du citron dans la recette) et délicieuse à manger.  Il faut simplement ne pas oublier de le sortir un bon quart d''heure avant de servir sinon, on a du mal à découper.  Merci de cette recette qui varie de la compote simple !', '2015-08-05T12:01:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 2772c805-699f-41cf-9917-59310ffa5a68, 'Un vrai régal ! Tout le monde aime même mes enfants et les invités qui n''aiment pas la rhubarbe ! Un grand merci. Une autre façon de revisiter la rhubarbe. J''ai modifié la recette en la passant en sorbetière pour éviter le givre et les petites imperfections notés dans les commentaires précédents. A recommander ++++', '2013-09-18T20:35:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 25d6b3e6-9cbb-4ef8-96b2-05800bd84126, 'Recette réalisée à la lettre, aucun soucis de texture. J''ai versé la préparation dans des moules à cannelés en silicone. Tout le monde a aimé même les réfractaires à la rhubarbe.', '2013-06-10T13:42:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 4eafbed3-b5b5-4407-865f-fa3f4ea6b7dd, 'Superbe ! Si vous avez un peu de temps, faire de la meringue avec les blancs et les déposer par dessus, et vous aurez un vacherin parfait à la rhubarbe.', '2011-05-06T18:46:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, b8b990fa-c23a-4e34-86b4-96dff56ba952, 'Porte bien son nom : c''est parfait. Glace réalisée dans des moules à cake en aluminium qu''on trouve en différentes tailles dans le commerce. Cela permet de faire de belles tranches. Bien pratique ce dessert qu''on prépare quelques jours avant pour moins de stress le jour J.', '2011-04-11T15:27:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, b40a5733-b2f1-48ec-bed9-b2ecc44988fc, 'Très bon et très facile à faire ! J''ai servi avec une crème anglaise pour couper un peu l''acidité, j''ai eu peur qu''elle ne soit augmentée avec le coulis de framboise. Ça va très bien ensemble. Merci !', '2010-07-10T16:44:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 549264cc-2b75-4d52-8017-5382b69d6f2e, 'Tout simplement délicieux. Pour une présentation plus soignée répartir la préparation dans des moules individuels (idéalement en silicone plus faciles à démouler)', '2009-11-21T23:01:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 181809b5-a0cf-413d-9cc5-ec99da731072, 'Merci pour cette recette. Je viens de réaliser cette recette pour la première fois ce soir pour mes invités ils ont été conquis et moi aussi j''ai de la chance d''avoir dans mon jardin de le rhubarbe et des framboises que je dis bio car je n''utilise aucun produit. Mais ce dessert quel délice, je vais faire comme beaucoup je vais en préparer à l''avance et hop au congel et encore merci pour cette délicieuse recette', '2009-08-30T01:57:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, c7155204-7d93-4625-aee9-6842036e86de, 'Un seul mot...parfait, je n''ai pas mis la maïzena ni le citron, pour la simple raison que superflu, la compote est assez épaisse une fois mixée et l''acidité me convient trs bien, j''ai doublée les proportions est moulé individuel, ça présente mieux sur assiette . Merci pour cette merveille !', '2005-06-07T22:14:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 1b2e6f6e-9db6-4cb9-aa9d-8350e7a05ab8, 'Mauvaise recette… c''est dommage parce qu’elle donnait envie mais quand on a essayé de le manger il était beaucoup trop dur et impossible à sortir de son moule… je ne referai pas', '2023-06-11T09:50:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 1491e6a1-f53e-42d8-b021-d8837c07dd8f, 'Parfait.', '2023-06-10T20:53:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, a7fee9c1-e169-4278-ac51-1ab4fdd0488c, 'C''est bon ', '2023-06-10T09:29:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 5e002180-065b-4dce-a615-72510b9574f1, 'Très appréciée et facile à faire !', '2018-05-28T11:40:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 34bcc65e-09b2-4220-b4ee-d18297c0b313, 'Même sans coulis c''est super bon !!! Très bonne recette, merci ! ', '2016-05-08T14:51:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 92bcc2e1-f2aa-4578-853b-c4832e247070, 'Un très bon dessert, très franchement, j''ai utilisé de la compote de rhubarbe comme je ne trouvais de tiges de rhubarbe.', '2013-06-11T20:34:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 6827cf41-48b5-418c-a685-a8525d1ece09, 'C''est vraiment très bon ! C''est vrai que la texture n''est pas homogène car l''intérieur reste assez dur mais le goût fait oublier les petites imperfections. J''ai ajouté des biscuits cuillères imbibés d''alcool de citron dans mon moule et j''ai sorti le tout presque 1 h avant de servir. Je le referai sans hésiter !', '2012-05-09T23:23:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 53557ff7-5dc2-4471-9129-475252cbdb83, 'J''ai testé, très bon goût citron-rhubarbe mais du béton au sortir du congélateur. Il faut la tronçonneuse pour le découper !', '2011-06-23T17:07:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, bc347303-41af-4ace-a6a1-e74c3387a45f, 'Extra ! J''ai juste diminué la quantité de sucre pour garder l''acidité de la rhubarbe et faute de citron, j''ai mis du zeste d''orange. C''était vraiment délicieux.', '2010-05-31T19:10:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 1518a532-ff71-4d23-912e-2e4d84d83d6d, 'Très bon, la glace ne prends que bien au-delà de 3 h dans un congélateur à -20°C.', '2010-05-31T13:31:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 12e56110-4f68-4841-b606-21decd7e2f5a, 'oui oui, exellent,j''ai congelé mais j''ai servi dégelé,çà se tient très bien et avec le coulis, la présentation est du plus bel effet', '2009-10-21T21:29:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, a80dafc2-b2ef-49b7-9fa9-8f608c3f185b, 'Très bonne recette! J''ai mis des fraises à la place des framboises. Et je n''ai pas mixé la rhubarbe, ça allait très bien ! Un régal !', '2008-07-15T14:42:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, b0057aa8-46ad-4c7e-9f6f-4f07ae5d55fd, 'Délicieux, original et prêt à l''avance: c''est une recette que je conserve précieusement! Par contre, je mets un peu moins de crème fraîche car je trouve que ça fait un peu "gras".', '2008-06-11T08:28:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, f0410c3c-98c8-4340-934a-674328a7c1e1, 'Excellent comme goût mais un petit problème de consistance, la glace était vraiment dure comme du béton!', '2008-04-19T10:09:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 39085886-1fb7-4ee5-875e-42360e0ca467, 'Très bonne idée! A refaire! En fonction de l''acidité de la rhubarbe il faut diminuer le volume de crème fraîche, sinon cela attenue de trop le goût du fruit!', '2007-06-01T19:48:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 5465de43-dc41-41db-9610-682cc83ef69a, 'C''est une recette très originale et qui permet d''utiliser la rhubarbe autrement qu''en tarte ! J''ai rajouté des biscuits à la cuillère dans le fond, après les avoir trempés dans un "sirop" de citron (jus de citron + sucre + eau). En ce qui concerne le zeste, je pense qu''il vaut mieux le râper, il passe ainsi inaperçu à la dégustation.', '2007-05-18T23:53:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 9b7b950d-bd57-490e-966d-b2ac90948891, 'Tellement bon! J''ai enfin trouvé de la rhubarbe et vraiment je n''ai pas été déçue! Très apprecié par tout le monde, servi avec un coulis de framboises (500 g mixés avec 100 g de sucre puis passés au coulis pour oter les graines). Un vrai délice!', '2006-04-27T17:56:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, f355c864-d720-4322-9946-2f918620dd3e, 'Une merveille!!! Depuis le temps que je voulais tester cette recette, j''ai enfin réussi à mettre la main sur de la rhubarbe à Singapour. J''ai fait ce parfait en portions individuelles et je peux vous dire que ces parfaits ont surpassé les rêves culinaires les plus fous que je faisais depuis que cette recette était sortie ! A savourer langoureusement avec un coulis de fruits rouges. Bravo Martine pour cette recette parfaite et sublime. Il ne me reste plus qu''à retourner au magasin ou j''ai trouvé ces fameuses rhubarbes pour remplir mon congelo de parfaits ;-)', '2005-09-26T10:04:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 8975cb28-a0ad-45d6-b4c8-c253fc5aff39, 'J''ai tout doublé pour 15 personnes. Je mettrais moins de citron la prochaine fois. Je l''ai mis dans des ramequins en aluminium pour une présentation individuelle démoulé avec un coulis de framboise autour, ce fut un frait délice même pour ceux qui n''aiment pas la rhubarbe. Merci!', '2005-08-08T10:39:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 84744cb4-4720-4d59-8ae0-783158770291, 'Très bon et frais, même pour ceux qui n''aiment pas la rhubarbe car le goût est discrèt. J''ai rajouté les 2 blancs montés en neige et je pense qu''il faut le manger pas complètement glacé, donc il faut le sortir à l''avance du congélateur.', '2005-06-21T15:21:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 6b161fad-9b50-4c95-a3a8-d12f07473edc, 'Le parfait à la rhubarbe est délicieux. J''avais fait un coulis de fraises fraîches pour accompagner mais j''ai trouvé que le goût de la fraise écrasait un peu trop celui de la rhubarbe. Mes invités ont pensé la même chose.', '2005-05-22T12:59:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 5139fc64-deb2-4866-a31d-f6a143d792bf, 'J''adore la rhubarbe et j''essaie tout ce que peut sortir de l''ordinaire. Ravie par cette recette qui a fait son effet devant mes amis. J''ai néanmoins mis le zeste d''un citon entier, c''est encore plus acidulée et très frais pour les desserts d''été. NB: le parfait est beaucoup plus glacé que sur la photo.', '2005-05-20T19:05:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, a52a196e-a276-4348-a11b-9c8fd2a1b31c, 'Je pense que j''ai raté une étape: il y a plein de glace dans mon parfait! Du coup, la texture est bof, mais le goût est sympa.', '2005-04-25T13:45:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 9731219f-4040-41cb-8ca1-2723eeb381a4, 'C''est très bon mais pas fantastique (mais ma rhubarbe manquait peut-être de goût?). Ca a l''avantage d''être rapide, facile, léger et pratique, car ça se prépare à l''avance.', '2005-02-05T16:41:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 042be7ca-edbe-4d4b-8fe7-c535f45bb040, 'Fan de rhubarbe, je n''ai pas pu résister à cette recette. Rafraîchissante quand il fait très chaud, cette glace est effectivement délicieuse avec un coulis de framboise ou de fraise du jardin. Essayée une 1ère fois au mois de mai 2004, j''en ai depuis préparée en grande quantité, congelée dans des moules à cake de 1 litre en alu. Pratique en cas d''invités suprise (ou non d''ailleurs), économique avec la rhubarbe du jardin, ce dessert a été vite adopté par tous.', '2004-09-09T15:36:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 5ff9d825-81c0-49f5-9c7a-96e6ad7ce4a5, 'A faire et à refaire, surtout n''hésitez pas!! Tout le monde a adoré. Merci...', '2004-06-24T19:19:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 8edf12f8-568e-4d1c-ac72-3a883540da58, 'Un de plus pour confirmer... Même sans le coulis, c''est un régal!', '2004-06-09T15:02:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 53412fd0-da34-49fd-8a78-0bab69c699eb, 'Dessert délicieux, beau et bien pratique car on peut le préparer à l''avance. C''est parfait!', '2004-06-07T17:22:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, d3b4f07f-e303-4eba-97db-b65d3509cc33, 'C''est très bon et en plus même les personnes qui n''aiment pas la rhubarbe apprécient...', '2004-06-07T13:51:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 0b198ac2-c4d6-483d-b06a-7f92339abad2, 'Une petite merveille! Je l''ai fait avec un coulis de groseilles bien sucré. Mes invités ont adoré et se sont servis plusieurs fois, c''est bon signe! Merci Martine pour cette excellente recette.', '2004-06-07T12:07:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 079ea92c-7540-4d17-9b7a-eacd39fba218, 'Très agréable, très frais, j''avais un peu peur, mais ce fut parfait. De plus, on peut le préparer à l''avance. Je l''ai servi avec un coulis de fraise.', '2004-06-02T13:32:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, a15886e1-651b-486b-bbb4-0310e278d290, 'Excellent dessert, que l''on peut réaliser à l''avance et très facile à faire. Les enfants ont beaucoup aimé! Comme accompagnement, des meringues (maison) font merveilles. Merci pour cette recette.', '2004-05-28T11:00:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 33bb618d-4150-4fe6-850b-ad1dc3130846, 'Délicieux! Un dessert d''une grande finesse au goût exquis. A faire et refaire...', '2004-05-23T19:08:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 2003f188-99b3-49bf-9c7d-bfd9f93b89f6, 'Facile à réaliser et très bon, mais j''ai trouvé que le parfum de la rhubarbe ne se sentait pas assez. A réessayer!', '2004-05-17T18:49:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, e4bc897f-9985-49a1-aac9-39d33735d834, 'Dégusté à la 5ème rencontre, j''attendais de l''avoir fait moi-même pour le commenter. Il mérite son nom: facile à réaliser, délicieux, jolie présentation avec le coulis. Ce dessert a toutes les qualités!', '2004-05-16T20:50:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, 023a94cc-3d81-4737-91c2-f9cdbd019c0b, 'Ce parfait est un véritable régal.  Pour la rencontre il a été servi avec un coulis de framboises. Les 2 parfums se marient à merveille. ', '2004-05-12T10:02:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29279, e8dd47c6-77f4-4fe2-900e-1379df239616, 'Heureuse de faire le 1er commentaire, Martine! Grâce à ta recette, j''ai pu combler mon mari, grand amateur de rhubarbe et épater le copain de ma fille, pas du tout adepte de la rhubarbe ! J''ai fait mon coulis avec quelques fraises qu''il me restait : EXCELLENT ! ET FACILE A FAIRE! Merci Martine ! ', '2004-05-11T11:38:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, c5382d2e-52e2-4e5f-bb5f-3a53086c4bfb, 'Faites avec une pâte feuilletée, 100 g de sucre, 125 g de coco et de la confiture allégée. Le résultat est bon mais je n''en ferais pas des folies...', '2008-10-06T15:22:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, b94b5f06-0631-4093-8581-012626c1c983, 'C''était très bon mais un peu trop sucré. j''ai suivi les conseils des autres marmitons en mettant tout le pot de confiture et ca fait beaucoup.', '2004-02-16T11:46:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 2a57064d-38ef-44ee-9abe-93ba9c24e7e4, 'Je l''ai trouvé excellente et croquante avec de la confiture fruit des bois. J''essaierais surement en mettant plus de confiture et moins du mélange noix de coco. Elle m''a duré trois jour et je ne me suis pas lassé.', '2019-04-25T09:40:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, c9998bcf-4627-4c90-9dc9-a5c581433bf1, 'Juste hyyyper bon ! et hyyyper facile ! Et pourtant je ne suis pas fan des tartes à la confiture... mais là hummmmm un délice ! (j''ai suivi les conseils en réduisant sucre et coco)', '2014-02-11T10:33:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 7eb38c2d-6be8-4e35-80c5-61a2308b4f26, 'Testée ce jour. Super facile à réaliser, belle couleur dorée. Bon mais un peu sec, peut être un peu de crème fraîche dans la pâte en plus.', '2013-12-08T16:21:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 73e1de4b-f137-4643-8ad0-db20d4c492ab, 'Je l''ai faite avec de la confiture de groseille faite maison et j''ai mis la moitié de la dose de sucre... Verdict ? Excellent ! J''en referai certainement car en plus c''est très simple à faire !', '2011-07-03T02:05:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, bdc820ec-2b30-4891-9e4b-bae1e2a78c2d, 'Facile, rapide...que demander de plus. N''aimant pas vraiment les œufs je n''en ai mis que 2 avec une cuillère à café de maïzena. A refaire. Merci', '2011-03-14T16:23:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 30ac48b4-80e1-4169-b5ec-9c2513cc7893, 'Miammmmmmm !! Facile à réaliser et succulente !', '2010-10-19T16:47:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, c916ae03-d877-4c6b-90a9-b37d1a750c92, 'Très bonne et très originale mais j''ai mis seulement 100 g de sucre et de noix de coco et je l''ai faite la veille. à refaire sans problème surtout pour les amateurs de coco !', '2010-03-29T09:07:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 2ef64ca5-1a97-425a-a082-d4e3eb5a7127, 'Génial!  je pense avoir mis moins de sucre car je ne mesure jamais, mais enceinte et gourmande, j''ai craqué... ', '2009-05-08T21:38:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, c9cb103b-bb8b-40e2-81e9-1e3b051cca49, 'J''ai suivi tous les conseils de internautes précédentes avec moins de sucre, moins de coco et une confiture allégée... Encore un conseil: laisser cette belle tarte de coté et ne la manger que le lendemain...bien plus savoureuse...J''ai trouvé que l''on ne sentait pas assez la confiture de framboise le jour même, la noix de coco étant trop prononcée. Bonne dégustation.', '2005-11-10T17:45:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 3b2b0e83-4210-4290-967b-e8acebef20e6, 'Excellente recette, que tout le monde a aimé. Je l''ai modifié en y mettant 100g de sucre et 100g de noix de coco, en utilisant une pâte sablée et en ajoutant des framboises fraîches sur le dessus. C''est encore meilleur et en plus cela fait une décoration.', '2005-10-12T15:47:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, e1e8e54d-9dee-427f-bf31-8855b16de1f3, 'Très très bonne!! Je l''ai faite sous forme de tartelettes et c''était parfait. J''ai suivi les conseils des internautes j''ai mis moins de sucre et 125g de noix de coco. Par contre, j''ai utilisé de la confiture allégée et j''ai mis le pot entier. Mon homme m''en redemande!!', '2005-04-29T15:21:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 79228b17-c7b2-4a1e-ad02-002e23595292, 'Trop de sucre, trop de noix de coco: le verre d''eau est le bienvenu après une part de cette tarte. Néanmoins, à la seconde tentative et en réduisant de moitié le sucre et en ne mettant que 75 g de noix de coco, ce fut délicieux et nettement moins écoeurant. Moi j''ai choisi de la confiture de cerises allégée : je vous la recommande!!!', '2005-04-24T17:36:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 9b949711-8526-4449-8128-20342087cb83, 'Délicieux mais un peu trop sucré, j''ai réduit le sucre de moitié... j''ai aussi ajouté une poignée d''amandes concassées grillées à sec à la confiture ... tip-top!!', '2005-03-24T18:48:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 04c254a3-0d6c-40b8-a2bc-9ef50f6bfa47, 'Délicieuse!!! J''ai testé avec confiture normale et allégée en sucre, je penche plus pour l''allégée, c''est moins écoeurant. Vous pouvez aussi largement mettre 3/4 du pot (ou le pot entier). Si vous achetez une pâte brisée toute faite, je vous conseille de prendre une pâte pur beurre, ça ajoute un petit plus! ^_^ La quantité de noix de coco indiquée est de 150g, on trouve dans le commerce des sachets de 125g, ce qui suffit amplement. Cette tarte n''a jamais fait plus d''un repas... Eh oui, vos invités vont certainement vouloir se resservir!', '2005-02-07T22:10:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 7f7b9771-93a6-4196-b761-650a79fc1c6d, 'Je conseille de mettre moins de sucre et d''utiliser de la confiture allégée aux abricots.', '2004-12-20T13:10:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 5f2dc086-4abe-4f8f-830f-e474a2db1f02, 'Tout le monde a aimé.', '2004-11-12T19:09:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, fd7de268-8713-4771-a3e5-e1c288b0ed37, 'Une recette excellente, quoique légèrement trop sucrée, j''ai réduit le sucre la 2ème fois. Je l''ai réalisée avec de la pâte feuilletée que je n''ai pas fait précuire, cela me semblait plus "léger" que la pâte brisée. Tout le monde a adoré, enfants et mari, et me la réclame une 3ème fois.', '2004-11-04T22:51:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, cfdc19e6-8875-4d49-a5f5-0c870e9a0d3c, 'Très bon! J''ai suivi les conseils et j''ai fait précuire la pâte. La prochaine fois, j''essaierai plutôt avec une pâte sablée.', '2004-07-10T15:23:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, e268dea1-ebc9-426f-b1c0-c238f1cffaf0, 'Excellent et facile à faire avec les enfants!', '2004-04-13T11:15:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 8f8ebc42-3e8f-4758-bad5-f7cf010b09e4, 'Excellent! J''ai suivi les quantités données et la tarte était parfaite.', '2004-04-08T17:26:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 96c864a0-e1f7-4b22-b14a-f711540bbc9b, 'Délicieuse et tellement facile... Merci!', '2004-03-11T11:41:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 59ca124e-f55c-44bc-994c-d3de36f57a0f, 'C''était bon, mais précuire la pâte avant 1/4 d''heure avec du papier sulfurisé dessus et des pois chiche pour cuire le dessous et pas le dessus. Ajouter ensuite la confiture et la préparation, puis mettre à cuire à nouveau.', '2004-01-21T12:32:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 15470663-87a4-472e-9a7d-e7aa20fd6d16, 'C''est très bon  et très facile à réaliser, mais j''ai mis tout le pot de confiture et pas seulement la moitié.', '2003-12-04T10:31:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, a1cbfc49-3bbc-4045-9881-0d60d0b41985, 'Très bon. Nous en étions ravis, merci!', '2003-11-29T17:06:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20064, 2b356e5c-687e-40a5-84f3-bf4042e54002, 'Facile et rapide, cela commence bien. Des ingrédients que l''on a en général en réserve. En plus, cette tarte est très bonne. Je la recommande donc. Mais je l''essaierai la prochaine fois avec de la gelée, pour éviter les grains de framboise.', '2003-03-22T21:35:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 9112efac-3753-4574-929f-22ab1112c310, 'Je conseille de faire l''inverse avec l''accompagnement... L''étaler sur la pâte,  puis déposer les pommes dessus... Cela évitera à cet accompagnement de noircir...', '2021-10-31T15:14:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 75c2bf44-9a2b-4ceb-a4dc-01d6f0c0b3f0, 'Délicieux ! 
Pour la préparation j''ai suivi les bons conseils en commentaires, donc j''ai ajouté un peu de lait (indispensable), un fond de compote de pomme, et quasiment doublé les quantités (sauf le sucre) : 40g de farine, 2 oeufs, 100g de beurre, 100g de sucre, 125g de coco. Puis 25-30 minutes de cuisson à 200°C.

(remarque : la photo de présentation ne correspond pas tout à fait à la recette...)', '2021-04-04T14:43:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 57ea0f8f-9f33-40cc-9bc1-ff903ac4d058, 'Une tuerie ! Avec une pâte sablée, une fine couche de compote dans le fond et 200 ml de lait de coco mélangés à ma préparation c''est exquis !! À refaire', '2019-01-24T09:31:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, e812c872-3a4f-4d40-a733-4056acccb9d7, 'J''ai saupoudré les pommes d''un peu de cannelle. Très bonne recette. Succulent. ', '2023-11-07T13:25:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 95ce1ad3-9ff7-495c-bb7f-e39b5c3463a8, 'Pour ma part, je l’ai laissée à 180 degrés 20 minutes, c’était parfait!', '2023-01-29T20:42:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, cf108c79-2a99-45c3-8e83-95f750f98cb1, 'Je la fais toujours de cette façon : pâte feuilletée, tranches de pommes fines et le mélange beurre fondu avec sucre et sucre vanillé, l'' œuf, 1 briquette de lait de coco et coco râpé, zeste de citron vert. Au four à 180°C pour moi pendant 40 à 45 minutes et surveiller à la fin (papier alu sur le dessus) et c''est délicieux 😋', '2023-01-13T10:41:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 01a95885-6263-427e-9fdf-4775f5bdc153, 'Super bon !', '2022-10-13T13:00:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, b3f5cd72-e46c-4656-9ee4-a02102bd8847, 'J''aime bien, cela fait penser à une tarte "crumble" avec la noix de coco ! Sans sucre ajouté, les pommes l''étant déjà.', '2021-11-22T14:27:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 420f2f85-bcd6-4a27-82bd-426d14214091, 'Un délice, très appréciée. Ajouter un lit de compote de pommes en fond de tarte.', '2020-11-03T13:41:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, c8e282e3-b918-424a-a450-34eeed56e116, 'Un regal, a refaire.', '2020-07-05T14:59:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 7fb5af32-dbc9-4f5a-90d1-1909359cf32a, 'Avec une pâte sablée et un peu de compote de pommes sur les pommes avant de verser la préparation a la noix de coco, un délice !', '2018-04-11T10:00:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 1b29bea7-3dbe-472b-88c2-4ba7a2f2a713, 'Un délice. Rien à changer', '2022-04-21T06:27:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 5ba3797e-3a40-4198-8cae-5e5141b65d97, 'Sa fait un dessert assez sympa tout se qui est au pommes j aime ', '2022-02-04T21:45:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 7d045fad-00cc-4963-a1f0-16ab9bad48bd, 'Je la ferai', '2021-11-23T20:35:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 64a2d88a-eab8-4818-a56c-0e7e341cbcf6, 'Bon !', '2021-10-07T19:41:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 3d9ab7fd-dee5-4357-a79d-d8700f0f0559, 'C''est parfait... Ma tarte a fait l''unanimité. Je vais la refaire. Merci Marmiton', '2021-08-02T10:03:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, a6e2fc29-861c-49d7-9102-c5bce5882285, 'Pâte trop sèche, il faut ajouter du lait ou un yaourt.
Tarte cramée si on respecte les 40 minutes...
J''ai du la retirer au bout de 25 minutes,  déjà trop tard. Grrr
Je n’ai mis que 80gr de sucre, mais la noix de coco est omniprésente, on ne sent pas les pommes, et c''est sucré. 
Pas top cette recette, modifiez là !
', '2021-04-23T15:40:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 24aa3ced-ae06-4228-b979-37a061f2492b, 'Excellent !!!', '2021-03-17T19:20:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 54477fb8-5613-4b6c-9f12-a7572926c1b3, 'Trop bon et super facile a faire ', '2020-10-30T16:46:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 0f02d720-6486-4441-977d-807d5128a455, 'Super recette, rien à changer; Beau mélange de saveurs  Voir mes photos sur: Magarrive95. Canalblog. Com', '2020-05-01T17:50:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, e65b4ba7-55aa-4090-86e6-68eedf35562a, 'Excellent !
J''ai utilisé une pâte sablée, saupoudré de la cannelle sur les pommes, et rajouté du lait, du rhum et de l''extrait de vanille.', '2020-03-30T23:28:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 16c6f08c-8ac6-462a-9ab1-431487e14a68, 'Très bon le mariage des pommes et de la noix de coco mais seulement 60g de sucre. A refaire.', '2020-03-30T17:50:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, e5d8389a-8483-4889-968a-bd32828564b1, 'Si vous aimez les pommes et les rochers à la noix de coco, cette tarte est faite pour vous.', '2020-01-15T16:53:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, c5d8bc3a-d410-4e97-8024-068c0cf6b432, 'Très bon. ?', '2019-11-10T02:36:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 6f3e9364-12a2-466c-a297-26b5aee8dbed, 'Délicieux et esthétique !', '2019-10-29T03:00:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 1b542b5f-7f5f-4a35-8a1c-df3553c9d54d, 'J''ai rajouté un peu de lait de soja.', '2019-10-13T07:58:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 0517c94a-73d8-4ae2-a242-bed6bdbefada, 'Conquise par ce dessert à servir de préférence un après-midi.', '2019-08-15T20:02:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, cf41d276-f2df-4100-8cb0-309e2bcdf180, 'Très bonne recette facile à faire', '2019-06-15T12:04:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 70e2c4e6-447b-4554-b0ac-8b70351664bf, 'Recette simple à réaliser. Je vais la refaire mais avec de la pâte feuilletée.', '2019-03-07T02:44:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, cd8aca74-e7af-4936-b7ca-fcf1a606e08f, 'Réduire la quantité de sucre et 25/30 minutes de cuisson suffisent.', '2019-02-07T05:10:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 90f40e3e-f797-4572-a56d-8fd19a8e6748, 'Délicieux mais un peu trop de noix de coco à mon goût.', '2018-11-09T12:41:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 8f81cd79-db68-4717-923c-37f87c83eba3, '40 minutes de cuisson est un peu excessif. 20 à 30 minutes suffisent, le gâteau en est moins sec.', '2018-09-02T06:32:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 76f43aaa-9c6e-4439-a83a-38580562efb1, 'Super bon, petite variante, j''ai mis un peu de compote sur la pâte puis mis les pommes et pour finir dans la preparation j''ai ajouté  du lait d''amande.  Tout le monde a adoré.
Merci pour cette super recette !', '2018-03-17T01:50:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, e36256c3-fd04-402a-8e89-9dddb794588f, 'Très bien mais faire attention au temps dans le four !', '2018-03-05T04:37:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 66528fc2-3d14-4842-b6a7-502f61156717, 'Super bon personnellement je remplace le beurre par un yaourt du coup recette plus légère.', '2018-02-25T07:30:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, a28f4a7a-2369-4f1b-be03-dd4b9a70ec10, 'J''ai suivi les conseils, j''ai rajouté un peu de lait un vrai délice. Merci.', '2018-02-25T03:15:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, e7af8e67-33be-4902-b79f-d5b60f6a4c46, 'J''ai mis 4 cuillères à soupe d''huile de tournesol à la place du beurre et autant de lait. Cuisson 40 minutes à 200C. Excellent !', '2018-02-21T09:55:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, adf614c4-2448-4b0e-89da-1a64afc881bf, 'Très bon !', '2018-02-14T08:53:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 7811dad4-3837-4143-8e22-0b038057eeed, 'Excellente tarte pas seche du tout mettre le four à 180° pendant 45mn pour éviter de faire cramer la pâte.', '2018-02-11T03:07:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 2dc7b5ff-f932-4c8a-929d-571aa6d746c7, 'N''ayant sous la main ni noix de coco, ni poudre d''amande, j''ai utilisé à la place les noix ramassées à l''automne et avec un peu de miel par dessus : une tuerie ! ', '2017-04-07T15:26:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, fe09ee81-c143-4d55-b247-8cec522bcc70, 'Un vrai délice !! J''ai remplacé par de la poudre d''amandes et ajouté quelques cuillères à soupe de lait. A refaire sans hésiter ! ', '2017-02-14T21:58:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, a2f2b03f-93a1-4605-912f-41147ba91c5f, 'Absolument délicieux. En effet il faut prendre un peu des astuces des uns et des autres. A commencer par diviser le beurre par 2. Ensuite ajouter un peu de lait pour avoir une pâte plus fluide et pour finir 20 min de cuisson c''est largement suffisant.  ', '2016-10-16T14:56:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, a260d815-3a24-416e-8c70-b326228351e7, 'Excellente et surprenante...cela fait 3 fois que je la fais en 15 jours et tout le monde adore. J''ai fait comme dans certain commentaires j''ai ajouté une couche de compote et dans la préparation j''ai mis du lait et un peu de rhum. J''essayerai cet hiver avec les pommes grises...', '2016-08-06T16:26:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, cf9ec086-03c1-4eab-aea8-93d8e5ecd619, 'Excellent. Surtout avec une pâte sablée maison (avec 35 g de noix de coco dans la pâte) et un coco du jardin. ', '2016-07-14T21:07:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, efbf6ba4-5c53-40d6-9b46-1dfd7e16111c, 'Voici une tarte aux pommes qui apporte un peu d''originalité à la tarte traditionnelle. Savoureuse et correctement sucrée, seule la cuisson des pommes demanderait un peu plus de temps!', '2016-04-02T11:23:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, c55133fa-85ad-41ee-8868-a9f24d8dc1ab, 'Bof le mélange pommes coco n''est franchement pas une réussite,  je n''ai pas trouvé ça bon.', '2015-05-31T19:59:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 925d5846-8f77-4dde-b262-7b891693cc11, 'Très bon. J''ai suivi les commentaires des internautes:  2 compotes étalées sur la pâte et j''ai remplacé le beurre par du lait... 25 minutes de cuisson à 210°C suffisent, j''ai laissé la tarte dans le four pendant son refroidissement  ', '2015-04-04T21:10:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 74ebabcb-6a89-440b-be53-2849ba17d6ac, 'Trop bon je l''ai refait avec du lait de coco et de la noix de coco râpé ', '2015-03-08T10:51:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, dd9180b2-faf2-43cb-9758-4ab5ad2e91b6, 'Je ne pourrais pas gouter la recette aujourd''hui : 40 min a 210°C c''est beaucoup trop!!! Ca a brulé!', '2015-02-26T17:05:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 77672b6e-458c-40d0-a953-7b3420ab3e84, 'Excellent et très simple. ', '2014-12-12T20:33:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 4000ae3c-db9e-433e-968f-abd7a02af774, 'Très bonne recette en écoutant les autres commentaires j''ai rajouté 10 cl de crème liquide, et j''ai mis 2 couches de pommes en rondelles pour plus de gout pomme. Le mélange pomme-coco est mieux équilibré et j''ai eu assez de mélange pour étaler à faire et à refaire avec les pommes du jardin bien sûr !', '2014-10-17T12:25:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 8835850d-2ed0-459e-89cf-431e29af60a1, 'Tarte excellente et consistante, j''ai ajouté une compote de pommes maison avec un peu de cannelle, par dessus j''ai recouvert de lamelle de pommes et ensuite le mélange avec la noix de coco, j''ai du ajouter une petite goutte de lait car difficile à étaler avec la cuillère ... Recette ajoutée à mon carnet et à refaire. ', '2014-10-02T19:11:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 493334d3-7661-41ea-bfe9-061b84620e40, 'Sublime ! Personnellement, j''ai ajouté : - lit de compote de pommes sur la pâte - 20 g de cassonade - amandes effilées en décoration Et j''ai également remplacé le beurre fondu par 15 cl de lait. Cuisson, effectivement, de 40 min et superbe effet doré obtenu avec 5 min de plus !', '2014-08-24T19:16:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 3bf45b82-2b92-4b87-831a-99f59ab8c25d, 'Délicieux, très bonne recette ! A refaire !', '2014-08-20T13:33:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 350d8e93-f2c9-4f49-8d18-9b020527a2f3, 'Super bon ! Finalement pas trop sucré avec les 100 g de sucre. Rajout d''un tout petit peu de lait pour que la préparation soit légèrement plus liquide mais c''était vraiment pas nécessaire, la texture de la préparation peut surprendre par son épaisseur mais le résultat est parfait. Cuit seulement 25 min à 210°C. Merci pour cette recette qui change de la classique tarte aux pommes. ', '2014-06-30T20:29:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 3dc9e66f-1a64-4035-9857-18575393f58e, 'Très très bon ! 25 minutes au four, attention car la préparation à la noix de coco cuit très vite !', '2014-04-25T09:06:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 1f889725-5b7f-4975-8414-71b5ce7c38fa, 'Délicieux !', '2014-04-14T13:45:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 9b4bb691-dd8a-4b5e-b551-d0bbb0bdb588, 'Recette facile à réaliser, délicieuse, à refaire avec moins de sucre. ', '2014-01-28T08:15:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, 21e0064c-ddb5-4cfc-a7d2-161db9819ab2, 'Très bon. Les invités en ont redemandé !    ', '2014-01-25T08:52:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18921, b31c4fb2-4b32-4ca3-8285-8c1769b772f9, 'Très bon rien à dire rien à ajouter tous mes invités ont adoré.', '2013-09-07T00:37:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 5d4b8029-835d-42de-ac6d-56599cc9711a, 'Très bonne recette mais pas la peine de faire revenir les oignons dans une autre casserole le faire dans la même moi j''ai fait revenir les oignons ensuite j''ai rajouté le chorizo et j''ai rajouté les pommes de terre et j''ai mis de l''eau comme dit  dans la recette.
Et en toute fin de cuisson j''ai rajouté une à deux cuillères à soupe de crème fraîche un vrai délice tout le monde a adoré merci pour votre recette', '2023-10-08T19:19:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 010f6f89-0eed-401c-b280-ea721cf51bab, 'C''est tout aussi facile de faire revenir les oignons et de tout ajouter par dessus ensuite. Ça fait une gamelle de moins à laver.  ', '2022-04-20T12:08:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, ebe568ec-91ea-47fc-b063-a15f08c7b2bf, 'J’ajoute de la tomate et des poivrons 
', '2022-03-31T07:42:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 1073a6f5-6b84-4c85-a668-1f632f5906a4, 'Faut plus compter 1h de cuisson que 30 minutes ', '2023-11-09T12:27:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 85236559-26a4-4cee-b4e7-6e88f5fef35b, 'Facile et excellent. J''y ajoute 2 poivrons, un cube de bouillon et un bouquet garni.
La seule difficulté est le temps de cuisson.', '2023-05-16T19:59:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 1745d67d-6610-4364-8cee-7a992edfb26c, 'Recette très simple et économique. Très bien pour accompagner un poisson à chaire blanche. ', '2023-11-11T11:06:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, dd68bb8c-f690-46fb-9d8b-caea8b6032ff, 'Délicieux ! Je conseille de garder le bouillon pour plus tard, afin d''agrémenter des pâtes ou de faire une petite soupe, surtout si vous avez ajouté des herbes et du cubor a l''eau comme je l''ai fait 😋. ', '2023-06-29T16:40:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 08737fe9-2904-4d3f-93f6-45787fee2a19, 'Excellent! J''avoue y avoir ajouté un peu d''épices telles que paprika et piment de Cayenne aimant les plats bien relevés à la maison !', '2023-02-06T12:09:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 70399d4d-6b30-43af-a518-1ddc7edcff4c, 'Étonnamment délicieux ! J’ai ajouté quelques filaments de safran délayés dans le bouillon et une petite poignée d’olives noires pour “hispaniser “ la recette. Un peu de basilic juste avant de servir, pour la nécessaire touche de fraîcheur et vous avez un plat haut en saveurs qui fait l’unanimité.', '2022-12-04T15:22:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 9bbcab82-7e21-4d24-8059-8fb1a2ffd70f, 'Cuisson faite à la tajine, au top! Avec une salade verte c''est un plat parfait pour un soir d''hiver.', '2019-11-05T08:06:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 3b487916-9b98-49ad-9c83-3d74dd41236a, 'Très facile, rien à surveiller, pas cher, goûteux; J''ai ajouté un oignon (soit 2 au total) et une gousse d''ail que j''ai hachés et fait revenir dans la graisse du chorizo avant d''ajouter les pommes de terre puis l''eau. Bien moins difficile à faire que la tortilla et pas d''huile. J''ai fait cuire à petit bouillon à feu découvert. Je n''ai pas compté le temps mais j''ai attendu que toute l''eau soit évaporée. Je referai.', '2019-10-04T15:44:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, f6c26a4f-320d-42ae-9394-cb172097aca4, 'Les pommes de terres sont fondantes à souhait. Comme nous adorons le chorizo, nous en avons mis un peu plus que d’indiquer sur la recette 😋 une tuerie qu’on refera.', '2022-11-06T13:12:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 2f7b2e3b-9702-4741-a69a-8f4f035655f6, 'Très bon et pas cher. ', '2021-12-03T21:14:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 398bab44-c030-4e38-a6c0-d5ae40e3a75b, 'Persillade, cumin, paprika... on ajoute ce qu''on veut, c''est simple et délicieux !', '2019-05-03T08:43:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 7cd6e772-e84a-4e7f-96c1-0ed53ea1d9c6, 'Bonne recette, surtout pour les amoureux de chorizo ! Je n’ai rien rajouté de plus que ce que la recette indique et cela avait beaucoup de goût ! Le chorizo donne plus de saveur à tout les légumes et au plat en général. Un plat réconfortant. Je recommande sans hésitation, pensez-y les jours de grand froid! ', '2018-09-15T12:29:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, d2ab663c-250d-4a38-abf9-275673ac1ba9, 'Trop  bon rien a ajouter je suis occupée  de le manger un régal !', '2018-04-02T12:02:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, bd8e4736-be01-45f9-9e81-32ff0e5b2e71, 'Excellent ! Mon grain de sel, "un peu de paprika " en plus ', '2023-04-16T11:24:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, d9b77f29-b791-4ef8-80aa-886585d2f455, 'C''est un plat succulent .', '2023-02-13T17:05:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 1105827c-d9d9-495c-8623-cfb74d6912f3, 'Simple et très bon, j''ai juste rajouté un peu de paprika à la recette 😊', '2023-02-01T00:05:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 7a9bae58-baa7-4ef7-b48d-2fd6c022acb8, 'Très bonne recette qui change des plats de tous les jours, j''ai juste ajouté une petite branche de thym ! À refaire !', '2022-11-04T12:47:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 53aa5410-9bd3-4fcd-a049-b3833354eaa2, 'Bonne recette, j''ai suivi les conseils des avis précédents en mettant du paprika et c''était super !', '2022-10-27T18:15:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 499de977-8f3f-4556-ac95-531528e9196b, 'Simple à réaliser et très bon. Ce plat va devenir un classique ici. ', '2022-10-22T19:20:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, e5fcda62-7704-4feb-a576-e929dd4e98bc, 'Super bon et goûteux ! Ajout de paprika pour nous, un délice et le lendemain encore mieux que la veille 😊 Plat que nous dégusterons encore !', '2022-10-10T21:31:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, d1eedeea-a5d0-4a84-bb10-ef0f6e48a1c5, 'Nickel c''est pas cher et facile à faire ça change ! Justement ça reste assez simple au niveau du goût aussi mais ça donne un peu d''originalité aux patates, le chorizo a donné du goût et un peu de piquant sans cramer tout le système digestif pour autant', '2022-01-21T12:58:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, bb48c6c7-e721-486a-9362-cc93428df222, 'Pas mauvais, mais probablement parce que j''ai laissé couvert les 30 min il y avait beaucoup trop d''eau. Dommage.', '2018-11-26T09:59:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 1c3cfcf7-1e71-4dd8-9f6f-7c0b851792a4, 'Très bonne recette! J''ai rajouté des petits morceaux de carottes, un vrai régal. Je fais cette recette souvent ', '2015-02-26T17:17:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, df0f0a51-6106-41c6-8f9d-d381bdc39e9a, 'Excellent,  je l''ai fait à la cocotte minute, 15 min avec beaucoup moins d''eau et laissé mijoter pour que les pommes de terre finissent d''absorber l''eau en trop. C''était parfait, à refaire sans hésiter ! ', '2014-11-16T23:12:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, fc6511d5-4ba7-4368-80fd-dc75054802fa, 'Recette simple et efficace. 
Je rajoute des olives, du concentré de tomates, et un bouquet garni.
Une variante avec de la saucisse de morteau...
Plat apprécié par tous ! 😁', '2023-05-12T18:17:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 218184e6-f3f5-4ff7-9ffb-2c7345834600, 'Très bon mais par contre ça m’a pris 1h30 de cuisson et pourtant j''étais au max et l’eau il y en avait toujours assez.', '2023-03-15T14:48:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 1cd167f9-cbcc-4f5d-9497-25089f276345, 'Merci pour la recette. C''était très bon. ', '2023-02-01T22:10:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 38f05c25-7ab7-428f-8992-86ccb3787909, 'Facile à faire et très bon ', '2023-01-18T19:07:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 8cbbbf6c-ba92-4443-8216-7c0131d97067, 'Toute la famille a adoré, super bon !', '2023-01-17T14:06:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, df3a3451-43e6-4fee-9d3c-7fccd0ac1887, 'Super bon et facile !', '2022-12-17T17:23:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 540b660f-2d38-482b-bc44-49248e51d846, 'Très bon !', '2022-11-19T15:10:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 576ae6c1-57bd-401e-9b87-428c35124447, 'C’est savoureux, il faut bien penser à assaisonner.', '2022-11-14T09:06:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 6a7b1f50-230b-40b9-9a69-32904541343d, 'Facile, très bon !', '2022-11-10T02:08:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, cd76ea8b-2db7-4981-ae3e-54215c7dfa8f, 'Au top 👌🏻', '2022-11-09T00:27:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 83fecee7-93bc-4f1d-9781-8cc201402826, 'Excellent. Nous avons ajouté du chou.', '2022-11-05T16:56:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 7f207738-fe8f-4a5f-b4c5-89597a28f8bd, 'Trop bon !!!', '2022-03-12T19:54:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 9e5b1f93-d72c-4f10-969f-14063cb71c76, 'J''ai kiffé', '2022-01-29T18:16:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, da4d5769-9479-4b14-b06f-2f2e8dcd4299, 'J''ai bien suivis la recette. C''est assez fade, pas très savoureux. Le chorizo perd en saveur et le piquant ressort très fortement. Nous avons mis de l''emmental pour améliorer le goût... 
', '2022-01-17T20:31:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, a627d204-5138-49c6-9900-8c5c8e2e9d7b, 'J''ai du mettre un peu trop d''eau, mais sinon c''est bon.', '2021-11-27T21:55:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, c2d7d0fa-3d09-479e-ad60-5854d1ee473d, 'J’adore trop bon et facile ! ', '2021-01-31T20:29:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 687de79a-093d-4297-a174-1faf8340de6a, 'La même recette mais cuisson au four !', '2018-03-15T11:56:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, d4478692-c0f8-48eb-b137-993d4b008561, 'J''aime le faire régulièrement, parfois même avec des carottes.', '2017-01-16T14:20:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, b335ec91-fa33-425c-8c78-44efc34c39c1, 'Très bon et facile à faire. Personnellement en couvrant d''eau et pour une cuisson d''1/2h comme dit dans la recette, je chauffe à découvert et à feu moyen pour que le plat absorbe bien l''eau et ne brûle pas dans le fond. Je referai régulièrement !', '2016-01-17T13:25:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 2af02423-5d57-4c9f-991a-46c27e74d961, 'Excellent, j''ai rajouté du curry. ', '2015-12-26T18:20:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 18c4ae5d-8cb5-4184-9853-46db971c21ea, 'Très très bonne recette ! Mais comme beaucoup de plats copieux c''est encore meilleur le lendemain !', '2014-11-26T22:46:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 463c2004-7263-41aa-9c4c-8021d15cd1f5, 'Recette qui passe haut la main dans mon carnet. J''ai ajouté un poivron et une boite de tomates pelées pour relever. J''ai également doublé la quantité de chorizo.  C''est un plat comme je les aime : très rustique visuellement et un goût à se damner. ', '2014-11-18T12:56:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 8cb87d41-6bf2-4f00-8c55-6b0be486f85e, 'J''ai ajouté quelques champignons et un poivron, un vrai régal !!! La prochaine fois je mettrai un peu d''olives. ', '2014-11-16T21:13:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 244fe459-42b2-42fd-ab7d-432449812fbe, 'Super recette, la même qu''en Espagne, je recommande ! :)', '2013-11-03T11:05:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 435e79bd-a4d2-4e5f-8741-025b9ef5b95d, 'Très bonne recette qui a déjà fait ses preuves chez moi... Pour la servir à des invités je la présente dans des petites cassolettes individuelles avec du gruyère râpé, le tout passé sous le gril quelques minutes avant de servir. Faire attention à la "force" du chorizo car ça peut devenir assez épicé. ', '2013-03-13T18:17:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, fb9a1764-6f5c-42a8-8a28-490a1ac286d0, 'C''est très bon mais il faut absolument que tout réduise au maximum car le jus absorbe tout le goût du chorizo. Donc s''il est trop liquide c''est pas facile à manger.  Petit truc pour ceux qui (comme moi) ont une sauce toujours trop liquide à la fin de la cuisson : sortez les ingrédients et faites réduire la sauce à part avec une cuillère à soupe de Maïzena ; ça assure un certain velouté.', '2010-12-05T12:34:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 41ef1524-be90-42d7-bb91-6192c4715be7, 'Très bonne recette : un ragoût d''excellente facture, à condition de faire cuire longtemps (il faut que tout se réduise). J''ai également ajouté du cumin, ce qui donne la touche particulière au plat.', '2010-10-02T12:58:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 3503ce4e-d305-4fc0-a62a-bdb1df589153, 'J''adore et j''adhère !!! Généralement j''en prépare plus pour avoir le plaisir de le faire gratiné au four le lendemain ! Merci pour cette recette !', '2009-04-30T02:22:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 5589edb9-c61e-4309-a1a1-93bf6cea993e, 'Très bon! Facile à réaliser! La présentation n''est pas extra (car ça fait ragoût) mais toute la famille a aimé. Je le referai, c''est sur. Merci pour cette recette.', '2009-02-18T18:47:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 2202666e-58e4-4223-961e-1805f769ccc7, 'Pas facile de savoir quelle texture il faut obtenir. Mais après 1 h 15 de cuisson et un peu de cumin en plus, on s''est tous régalé.', '2008-01-12T19:27:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, b9b6af7b-a883-470a-9d3a-fd535436ecbb, 'Alors, je ne sais pas vraiment à quoi ça doit ressembler mais une chose est sûre c''est que le plat disparaît en très peu de temps. J''ajoute un peu de fromage pour apporter un petit goût suppléméntaire. Mon homme adore cette recette et me la réclame! Je pense que la prochaine fois, je présenterais en plat individuel. Ne pas hésiter à mettre quelques herbes arômatiques.', '2007-09-13T22:22:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, 997ebd05-3a0f-44c9-9bf6-22bce3cb9aa9, 'Je recevais 12 personnes... j''ai multiplié par 3, c''est dommage qu''il n''y ai pas eu de surplus. Ca a plu a tout le monde! Très simple, possibilité de cuire au dernier moment, idéal! J''ai ajouté des herbes de Provence et mélangé avant de servir pour casser un peu les pommes de terre et ainsi épaissir la sauce.', '2006-11-16T11:40:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36555, ca6f2d61-5a27-4a2c-8146-28827bfe16d9, 'Un vrai délice!', '2005-05-08T23:25:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230015, c1f7249b-a62c-4bab-93cf-3b75bd2c7660, 'J’ai fais moitié fromage blanc et moitié mascarpone, un régal', '2021-07-28T18:21:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230015, ad6a6221-9bcf-403a-bb43-6ed5c06cfa65, 'Recette réalisée 3 fois, un délice ', '2021-07-05T10:50:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230015, 5df05b07-7e68-4c4f-b465-798d4553b1a1, 'Recette parfaite ! Je n’aime pas les cheesecake et celui là est incroyable ! Crème légère, j’ai rajouté à l’intérieur pleins de framboises surgelés !', '2020-04-24T16:03:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230015, 55cd5d81-5dc8-48d7-917d-89d7219e9ffb, 'J''adore cette recette et mon entourage également. Elle devrait être la recette originelle du cheesecake ! Merci pour son partage.', '2019-08-26T10:20:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230015, 631d4808-b170-4484-8b95-7f1847a9e498, 'Les quantités sont énormes !!! Mais sinon, plutôt pas mal au niveau du goût et de la tenue à la dégustation ! Mais pas spectaculaire !', '2019-05-21T09:06:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230015, 24b16d85-b9da-4327-8427-8415218c7978, 'Recette parfaite. J''ai effectué un miroir sur le dessus à base de coulis de framboise et de 2 feuilles de gélatines. Petites déco sur le dessus à base de fruits rouges. Rendu impeccable.  Attention toutefois aux quantités trop importantes.  J''ai utilisé 500 g de fromage blanc, 440 g de chocolat blanc et la moitié de spéculos ', '2016-11-02T21:11:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230015, a5f9852e-3da9-4dd0-86c9-3d1d3f2e3921, 'J''ai également divisé les quantités et le temps de cuisson par 2 et c''était une réussite ! Merci pour cette belle recette que je referai pour épater mes convives à coup sûr. ', '2016-03-13T09:07:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230015, 51ff511a-ae35-4be7-8ad6-aa0ed8f88eb9, 'Je l''ai fait mais j''ai fait cuire le gâteau au bain-marie comme ça le spéculoos ne brûle pas... C''était délicieux....', '2014-06-28T20:15:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230015, 78a7b43f-63e1-4de8-9221-9614dfd1cf04, 'Suites aux précédents commentaires, j''ai divisé les quantités par deux ainsi que le temps de cuisson, j''ai par contre été généreuse sur les framboises et c''était très bon. Le plat n''a pas fait long feu...', '2014-03-24T12:20:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230015, dd5b1d1a-e646-4431-b44b-88caa3793efe, 'Très bon mais soit il faut prévoir 2 moules ou diviser la recette par deux car au bout d''une heure, le gâteau n''était pas cuit (encore liquide au milieu) ! J''ai doublé le temps de cuisson mais du coup les spéculoos était trop cuit.', '2014-03-02T21:01:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230015, 8a8e2c4e-1ce6-4af3-8ec9-964de2cb1d5b, 'Les quantités sont très bien, suite au commentaires je n''ai pas mis toute la quantité de spéculoos, mais là je vais la refaire en respectant à la lettre la recette. Je n''ai eu que des félicitations à propos de mon cheesecake !', '2014-02-28T19:46:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230015, 7719250e-32b3-40fc-b410-fd6ea992468e, 'Superbe recette j''ai d''ailleurs ajouté une photo. Pour ma part je n''ai utilisé 200 g de chocolat blanc et utilisé du fromage blanc à 0%. J''ai également fait un coulis framboise maison auquel j''ai ajouté de grammes d''agar-agar pour napper le cheesecake. Quelques framboises pour décorer le dessus et le tour est joué. Mes collègues l''ont adoré et trouvé très léger. Je le referai très très vite merci.', '2014-02-20T21:51:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230015, 1a8d8e9c-a5c1-4431-b571-cfc5f22c0545, 'Les quantités sont vraiment trop grandes, il faut largement les diviser par deux... Ou sinon, prévoir deux plats car un seul ne suffit pas ! A part ça, la recette n''est pas mauvaise, mais ce n''est pas non plus transcendant...', '2013-04-14T21:44:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230015, 17686e50-3581-4271-add1-eacdb2daf376, 'Tout simplement délicieux ', '2013-02-18T08:00:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, a1cd8135-805c-4c19-a64a-044a6dbf230e, 'Seulement 2 kgs de sucre c''est largement suffisant. Ma 1ère fournée j''ai trouvé qu''elle avait le goût du melon ; la 2ème fournée qui a cuit plus longtemps alors là c''est carrément le goût de la crème de marron vanillée; je la garde précieusement pour la refaire chaque automne quand je trouve des potirons entiers à 2,50 euros et des  pommes à 95 cts le kilo; à chaque fois j''ai fait 8 pots de confiture. Merci pour cette recette.', '2013-11-24T17:23:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, bab68043-7b9c-4977-b0f2-cfa4ffce98c4, 'Super et original! J''ai choisi de la faire avec du sucre cristallisé, j''ai ajouté pas mal de gingembre frais râpé,du rhum et de la cannelle... Et j''en ai fait mes petits cadeaux de Noël de ''fauchée'' en coiffant les pots de tissu mordoré!', '2004-01-21T18:57:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, cded76e1-c532-4a34-8741-1f5d5e4e3763, 'Excellente recette mais mettre uniquement 2 kg de sucre et cuire avec 1 baton de cannelle + 1 jus d''orange.', '2022-12-10T19:28:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, e7c51181-0eee-4fc7-8e25-8f933687ea3f, 'Très bon, j''ai suivi les commentaires et mis moins de sucre et mis une touche de cannelle: Un délice.', '2019-11-07T22:24:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, bb265734-9802-4478-81a2-6968b487e820, 'Délicieux et vite fait. Mettre moins de sucre, et cuire plus longtemps. épice: Noix de muscade/vanille.', '2018-09-14T10:55:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, a2c6ddb3-324b-42d0-8348-1e77bb68ea71, 'J''ai suivi les commentaires : Moins de sucre plus de vanille et un soupçon de cannelle. Tous le monde en redemande...', '2017-11-03T11:08:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 4b0d2f7b-2a42-44b2-a9de-e2c03be48e5d, 'Très bonne recette qui est appréciée par mon entourage. J''ai cuit les pommes dans du beurre  et un mélange de 4 épices (1 càc). Top !!!', '2017-05-27T23:26:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 9c719835-2520-4eea-9b1e-3ff3bdaa41e4, 'J''ai suivi les conseils et j''ai diminué la quantité de sucre à 700 g pour 1 kg, c''est bien suffisant. Ajouter de la cannelle et fait cuire un peu plus d''une demi heure. Niveau goût ici on n''est pas fan.', '2016-10-10T14:16:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, c3182349-7aca-4f40-aa59-7ece0d9aa4d4, 'Très bonne et surprenante dans un gâteau roulé DELICIEUX.', '2016-02-21T12:59:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, c6f9d5b3-a3c6-410b-a1ef-af68d54e5150, 'Aïe Aïe Aïe.....Je l''ai goutée encore chaude et je me suis dit : bof, voire même pourquoi je me suis donné tant de mal pour un truc aussi fadasse! Je l''ai goutée froide et là, je me suis dit, c''est une tuerie! J''ai mis 2kg de potiron, 800 gr de pommes et 2 kilos de sucre cristallisé. Cuite 45 minutes, avec 2 gousses de vanille et un soupçon de cannelle, je la referai avec plaisir. Merci  ', '2015-11-19T15:34:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 49b3a3bc-ec96-4ddd-adab-9e9b10118b05, 'Recette respectée + cannelle : trop trop bon, comme dirait une amie qui a goûté "c''est tout un poème...".', '2015-11-10T18:48:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 89ef85c0-5471-46a6-97ed-ce8a040593b8, 'Excellente idée. J''ai remplacé une partie des pommes par un coing, et comme suggére par un internaute, seulement 2kg de sucre. Excellent résultat avec que des fruits du jardin ! En plus, même pas besoin de vitpris pour que cela prenne. Je vais garder cette recette pour les années à venir. Merci beaucoup!', '2015-10-11T12:12:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 54213692-5f44-4002-a97e-01702edda6ca, 'Très bonne merci ', '2015-10-05T19:54:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 4eb189e7-f097-443a-bd7c-2b5bdc1e756b, 'Très appréciée. J''ai mis le même poids de pommes et de potiron et ai réduit un peu le sucre (800 g pour 1kg de fruits). Pour relever un peu le goût j''y ai ajouté un peu de cannelle en plus de la vanille.', '2015-04-11T18:36:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 40364232-7b00-467c-97c3-531e3b74a372, 'Confiture très originale, qui rapporte bien le goût du potiron en bouche puis l''acidulé de la pomme.  J''ai juste réduit la dose de sucre au 2/3 de ce qui est écrit.', '2014-09-02T01:17:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 058d710c-9dae-448f-b182-79f01f040314, 'Mon époux tient des chambres d''hôtes. Cette confiture au petit-déjeuner aiguise la curiosité et est appréciée.', '2013-11-30T17:16:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 22a4ae61-792f-4fa3-8495-e68350602f53, 'Parfaite! Ma balance m''a lachée juste avant, donc j''ai fait à vue de nez...j''ai épicé avec un mélange à speculoos. C''est tellement délicieux, jamais je n''aurais imaginé préparer une confiture si exquise. Merci.', '2012-10-24T18:09:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, a4c13125-71a2-4cd4-a2d9-fed85451bbf9, 'Il faut mettre moins de sucre et ajouter un bâton de cannelle et le tout est originale pour le plaisir des petits et des grands', '2012-03-03T18:31:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 5d4b01f2-5418-4432-a2ae-83462198caaf, 'Très agréable au palais j''ai trouvé cette confiture originale et de saison surtout. J''ai mis un peu moins de sucre et ajouté un peu de cannelle. Je suis très satisfaite du résultat. J''en ai fait profiter une amie qui a adoré.', '2012-02-13T19:03:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 1a21d503-624f-488c-984c-6570b2cd3992, 'Excellente confiture, j''ai mis 1 kg de pommes,2 kg de potiron, deux gousses de vanille, de la cannelle (1 cuillère à café) et du gingembre. J''ai rajouté deux citrons entiers, coupés en petits dés, je l''ai juste passée au presse purée après l''avoir laissée refroidir et réchauffée pour la mettre en pot.   ', '2011-11-20T22:05:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, d0a4c3a8-a9ae-4021-9320-93229eafa277, 'C''était mes premières confitures et ce fût réussi ! Parfait !', '2011-11-20T16:45:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 2da69d58-605a-4202-a51a-8a7f0469494a, 'Super ! J''ai mis plus de 2 kg de potiron, 6 pommes épluchées, fait bouillir le tout avec un bâton de cannelle et un petit morceau de gingembre frais.  J''ai mixé le tout en enlevant un max d''eau et ajouté une gousse de vanille fraiche, laissé le bâton de cannelle et ajouté un peu moins de 2 kg de sucre... 1 heure de cuisson en remuant, c''est phénoménal !!! Merci Marmiton !!!', '2011-10-28T19:46:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, be6a5e62-539e-42f8-a58c-e0905eddf3a7, 'Le goût de cette confiture est tout à fait intéressant et plutôt sympa ! J''ai ajouté la cannelle et le gingembre, ce qui rajoute au goût fade du potiron. Le goût de la cannelle étant assez fort, 1 càc suffit.', '2011-10-24T17:45:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, b3b572d3-ceb7-4756-bd79-3ff99a2063d6, 'J''ai mis 500 g de sucre bio par kilo de fruits, j''ai utilisé le potiron variété "cul de singe", de la vanille et de la cannelle, ce fut excellentissime ! J''en ai offert quelques pots et tous m''en ont redemandé, je l''ai refaite avec de la citrouille et ce n''était pas aussi gustatif !', '2011-03-26T19:20:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, ce86d442-aecb-48eb-864a-ea22f3f4f4cf, 'Je n''ai pas mixé pour une confiture plus compacte et j''ai suivi les commentaires pour les épices : bâton de vanille + cannelle + gingembre (pas plus de 2 cuillères à café) qui relèvent le goût un peu fade du potiron. A tendance à rester un peu liquide, ajouter du Vitepris, faire bouillir 3 minutes avant de mettre en pots aussitôt. Excellente confiture pour garnir un gâteau au yaourt par exemple.', '2010-12-14T13:08:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, ba99de86-6897-49b0-9c64-7ecfd0cd2258, 'Un peu trop sucré. Je l''ai légèrement poivré avec un peu de gingembre et ai ajouté quelques kiwis en fin de vie. Confiture ou accompagnement de viande blanche.', '2010-11-13T20:41:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 991c0b08-ba30-4d33-ab7a-9feb05d80844, 'Extra, je ne cuis pas avant et je prends un sucre blond spécial confiture c''est super. Variante encore plus goûteuse avec une courge butternut... hhuuummm', '2010-10-05T16:23:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 12f826ee-5a10-4068-b80c-3e4a70419fad, 'Une recette qui a fait sensation autour de moi, tout le monde a adoré et a été bluffé lorsque j''ai annoncé le potiron comme ingrédient principal. Par contre, la pectine de la pomme n''a pas suffit à donner une texture assez solide, j''ai donc ajouté après refroidissement de l''agar agar puis remis à ébullition 2 min pour la mise en pot, texture parfaite. Vivement la saison prochaine que je refasse le plein. Merci !', '2010-05-19T08:56:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 8f9d20b7-6b5f-49b7-9c75-f900b45132f3, 'J''ai fait de la place dans mon congélateur et il me restait de la citrouille. Je l''ai décongelée et faite la recette. Parfait pour des petits déjeuners et goûter tout en douceur. Les enfants adorent et ça change !', '2010-03-14T22:18:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, e70f2bdf-5f89-4bce-bb85-c2bf87439b55, 'Résultat surprenant : même les personnes qui n''aiment pas le potiron ont apprécié!', '2010-01-31T13:22:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, e13d462f-e579-4949-addc-e12cce4d1833, 'J''ai remplacé la vanille par de la cannelle. Je n''ai pas mixé les fruits mais les ai écrasés avec un presse-purée. Cette confiture est délicieuse !', '2009-12-06T20:14:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 3760afca-e9bb-497b-b852-4de072130fbe, 'Bonne recette mais non moi plus je n''ai pas cuit le potiron à l''eau, mais mis à macérer avec les pommes, sucre, vanille, j''ai ajouté du vite-pris et tout mixer. Je vais en refaire avec d''autre épices car le potiron est fade. ', '2009-11-02T10:09:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 05c1fc31-120e-4719-acc8-a34c89000205, 'Mes premières confitures est c''est une réussite. J''ai mis u sucre spécial confiture, ce qui permet de gagner du temps pour la cuisson. La prochaine fois, je vais essayer de ajouter de la cannelle ou un peu de rhum. ', '2009-10-17T21:08:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 94ea20b2-f059-474e-881d-75393613cae4, 'Je n''ai pas fait cuire à l''eau le potiron ,je l''ai mélangé avec les pommes cuites ,du jus de citron ,j''ai ajouté des épices (vanille,cannelle, 1 clou de girofle ). Je fais toutes mes confitures avec du confisuc ou gel suc ,ce qui réduit la cuisson à environ 5mn à gros bouillons. On peut aussi ajouter d''autres agrumes.', '2009-02-18T19:22:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 29f2e794-22f9-4a35-8454-6daabfc8ffb6, 'Je m''attendais à plus de saveurs, plus de goûts.', '2008-11-30T16:27:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 6328ccb4-570d-4dbd-a733-c57bd9eb7c68, 'Facile à faire et vraiment très bon. A refaire.', '2008-11-25T15:06:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 5a6bf7f9-516c-46d0-a95f-abb03040c01d, 'Très surprenant. Mais délicieux quand même. J''ai ajouté de la cannelle pour donner un petit goût en plus. Une très bonne recette pour utiliser les pommes et les potirons du jardin !', '2008-11-23T13:26:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, d85ac6b9-b734-4857-adec-342b422ece3c, 'La confiture de potiron sans les pommes est tout aussi bonne et pour les amateurs de cannelle y faire tremper un bâton pendant la cuisson relèvera cette confiture... ', '2008-11-22T21:42:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 6914179e-67b0-4027-b6f8-a107345ca643, 'Surprenant et délicieux, avec comme un petit goût de miel, mais la prochaine fois, je mettrai moins de sucre et ajouterai citron et orange, ou fleur d''oranger.', '2008-11-14T20:10:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, f470b864-47f0-48ea-b3b5-21fc7d90cd31, 'Ma première confiture !!! Fille d''une américaine, j''avais l''habitude de la tarte pour thanksgiving... J''ai essayé d''autres recettes avec du potiron mais là... Quelle découverte !!! Recette facile et délicieuse. du pain, du beurre, ou même un croissant. J''essaierais bien la version compote pour accompagner une viande blanche... Mille merci d''avoir élargi mon monde culinaire.', '2008-11-06T00:01:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 07e6236f-1d64-4486-88f6-a90e7bdb1605, 'Très original ! J''ai mis du sucre en poudre et j''ai laissé mijoté un peu plus longtemps la préparation : ma famille a trouvé le goût original et ils ne s''attendaient pas à ce goût !! Je la referai.', '2008-11-04T15:54:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 28f853cd-68bc-47ad-ac47-241e536ee0ad, 'Jolie couleur! J''ai suivi les avis : ajouter cannelle, du jus d''1orange et un jus de citron. Très bon. Merci pour la recette!', '2008-10-28T17:22:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, a221819d-33a4-4319-ba2a-8216e857c1d5, 'Excellente recette que j''ai déjà faite en 2007 et 2008. Je ne mixe pas les ingrédients, aimant une texture moins "lisse". Pour raccourcir le temps de cuisson, j''utilise du sucre gélifiant. On peut mettre moins de sucre et ajouter un peu de cannelle moulue à la place de la vanille si l''on préfère. Servi avec du foie gras, succès garanti ! ', '2008-10-27T12:22:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 96ee2c27-58b4-4f76-a23a-4923fd8f77c2, 'J''ai fait goûter aux gens qui n''étaient pas potiron. Ils ont adoré. Apparement difficile de trouver cette association. Sa couleur séduit! ', '2008-10-22T18:06:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 320f8db9-408f-4106-a95d-e9fc7646a821, 'Je l''ai amené à l''école pour la semaine du goût pour des enfants de 8 et 9 ans, beaucoup m''ont demandé la recette. Sinon j''avais ajouté un peu de cannelle.', '2008-10-21T12:38:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 1ddc7498-9dab-4999-8ba8-8f82c5c44e1f, 'Merci pour cette recette. J''ai distribué presque tous mes pots et les avis sont unanimes : original et délicieux !', '2008-04-08T12:07:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, de05dca3-a97c-410c-9800-ba3d704cc48a, 'Excellente confiture. Le goût n''est pas très prononcé (c''est celui de la pomme qui prédomine) mais plaît à tout le monde. Pour obtenir un goût plus prononcé, j''ai ajouté de la cannelle et de la fleur d''oranger. A essayer de toute urgence...', '2007-11-23T11:05:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 37da14e4-d20d-4f97-b631-ec89f386077d, 'J''ai pelé et coupé en petits morceaux 4,4 kg de potiron, rajouté 2,2 kg de pommes (à couper aussi en petits morceaux), 4 kg de sucre, cannelle, 1 petit verre de rhum. Par contre pour la cuisson, j''ai tout fait cuire dans ma bassine en cuivre à petit feu 4 heures environ et ai mis en pots (19 pots).', '2007-11-06T21:00:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, b3b369bd-4081-4350-bbb1-282410481186, 'Surprenant, mais très bon! Le potiron reste discret et le goût rappelle celui du coing. Pour la cuisson, après passage au mixer, j''ai mis 2 sachets de vitpris, ce qui raccourcit le temps de cuisson, et 2,5 kg de sucre seulement. Economique (avec la récolte du jardin) et d''une belle couleur, elle a tout pour plaire cette confiture ! Merci pour cette recette.', '2007-11-02T17:02:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, a7f3c068-4614-4083-803b-5c2a2675b778, 'Si on pouvait mettre plus je le ferai. Le mélange potiron-pomme est vraiment réussi. Excellente confiture.', '2007-02-22T17:25:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 742eb076-e88b-40b7-96dc-2c24464398fd, 'Délicieux! Mes premières confitures et c''est une réussite. Mon mec a adoré et le goût est vraiment surprenant! J''ai mis 2 gousses de vanilles pour rehausser le goût et j''ai utilisé du sucre cristal. Je me suis servie de la recette pour faire des cadeaux de Noël originaux : un joli pot, un morceau de tissu, un ruban doré et le tour est joué!! Merci pour cette recette originale et surtout délicieuse !!!', '2006-12-21T16:44:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 257338b2-5e81-4fb2-b738-3665d3f20e9d, 'Bravo pour cette recette. Je ne réussi pas toujours les confitures mais cette recette est facile à réaliser et le résultat est excellent.  Malgré il ne faut pas oublier d''égoutter le potiron après sa cuisson. Pour ma part j''ai rajouté dans la confiture durant la cuisson l''intérieur des pommes que j''ai mis dans un petit linge. La pectine de la pomme fait prendre plus vite la confiture. Bravo.', '2006-11-14T11:29:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 4a63a7da-88e4-413a-979c-5e0e352257cc, 'J''ai fait la recette telle quelle et c''est délicieux.', '2006-11-02T21:24:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 4f2bba45-025f-4be9-a7af-91468f53f65b, 'J''aime assez bien que je ne sois pas vraiment pour le potiron sucré. C''est bon sur les tartines. Par contre ne me demandez pas de la manger à la petite cuillère.', '2006-09-06T01:07:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 61c591d4-f278-4a5e-a71c-a849d63bf5af, 'Excellente. Quelques petites modifications, j''ai ajouté le jus d''une orange et d''un citron, une gousse de vanille coupée en petits morceaux, de la cannelle et enfin j''ai diminué la quantité de sucre (2 kg au lieu de 3kg). Elle se mange sur du pain, dans un yaourt ou à la cuillère.', '2005-11-03T00:44:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 17ec18d0-5fb6-466e-aeee-d825a70c03db, 'Les avis furent partagés. Les anti-courges n''ont pas été spécialement séduits. Cela reste tout de même une recette originale!', '2004-12-16T11:10:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 9b4d40fa-d750-4616-afbb-11ecfe2126f7, 'Saveur et texture étranges, mais délicieuse. J''ai rajouté du jus de citron, du rhum et de la cannelle.', '2004-11-08T17:37:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, ff55e47a-aa11-45f1-ab5e-5d94a3a4f837, 'Très bonne confiture, mais un peu trop sucrée... Je n''ai mis qu''1kg de sucre à confiture (cuisson rapide) et la prochaine fois, je mettrai un peu moins de sucre (en poids) que de purée de légume et fruit obtenue.', '2004-10-25T17:38:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 63130db8-366e-40dc-9a63-7c60e22e2797, 'Recette très simple, même lorsqu''on fait de la confiture pour la première fois. J''ai juste utilisé du sucre cristallisé et augmenté la quantité de fruits (1,2 kg de fruits pour 1kg de sucre), délicieux!', '2003-11-01T10:06:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15286, 6297d686-f8ca-4009-ba70-29b9a9f82082, 'Confiture surprenante et originale à la veille d''Halloween. J''ai rajouté quelques noisettes torréfiées que j''avais en stock.', '2003-10-30T17:14:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 0d82f00a-a040-4184-afe4-48990e28fb9a, 'La pâte beaucoup trop liquide ça m’en a mit partout, pourtant recette suivis à la lettre. ', '2021-05-16T13:07:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 0016f185-b76d-4ae6-9113-e7d0b5a43785, 'Gâteau réussi ! Réalisé avec des framboises surglees. Respecté la recette au gramme prés. Gros succès !', '2021-03-28T22:14:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 1eef652b-9204-44dc-8c49-4884a8a6246b, 'Très déçu de la recette je n’ai pas du tt obtenue le même résultat coulant alors que j’ai tt respecter à la lettre les gâteaux coulant le flan moyen pas assez de chocolat blanc pour ma part inexistant les 250g je suis déçus ...^^', '2021-02-26T00:18:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 8b4c4af7-0d41-48b8-82fd-0e844a40b59f, 'En effet c''est magique, léger et délicieux !  ! Pour ma part réalisé avec des mures cueillies cet été et congelées. Un régal !', '2020-12-13T18:17:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, bbd8d469-f115-4521-901b-9a9b51cbebb1, 'Une merveille ! Je n''ai mis que 100 g de beurre et de sucre et 50 mn à 180° pour un four à  chaleur tournante. Vraiment à  tester, un vrai delice.', '2020-06-14T22:36:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 3e31d813-0e38-4fa1-9c12-bb23df7bd474, 'Recette parfaite !', '2020-03-29T20:47:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, d11adfa8-475c-4260-b71a-dce62e593a9d, 'Fait avec des fraises. Une réussite. Seul bémol on sent pas assez le chocolat blanc.', '2019-01-07T15:02:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 0496e981-04d3-45c4-9d2a-b1e6a9325881, 'Excellent et facile à faire ! Je conseille de suivre les commentaires : 300 g de framboises, 100 g de beurre et de sucre. J''ai laissé cuire jusqu''à ce que le dessus soit doré (soit plus d''une heure), et j''ai bien eu mes 3 couches !!  J''avais laissé reposer 4h avant de déguster mais en effet : il est tellement meilleur le lendemain, je conseille de faire la veille par conséquent ! ', '2016-06-16T14:05:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, c4176fca-ee84-4234-9ad7-d499bb6618c7, 'Malgré que j''ai respecté les étapes à la lettre, le gâteau est beaucoup beaucoup trop liquide... Il s''est effondré en sortant du moule malgré + de 6h au frigo ! En augmentant la température du four peut-être y a-t-il de meilleurs résultats ? Très déçue en tout cas, il était inmangeable et a fini à la poubelle...', '2023-06-18T20:17:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, f558f928-0145-466d-a583-491eb2a02415, 'Excellente recette qui a fait l''unanimité auprès de mes convives ! ', '2023-06-08T18:59:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, eb82fa28-72c3-448b-9d43-1dd79f761fe2, 'Vraiment très bon et très simple à faire ! Je recommande vivement. ', '2023-01-28T17:27:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 9da00665-39ff-4cc5-bfc2-fcddf35300fd, 'Facile et délicieux, pas trop sucré. À refaire.', '2022-12-18T20:58:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, ea281b2c-ca1a-46c4-983a-790ac77a938f, 'Spectaculaire ! Je n’y croyais pas tellement la pâte semblait liquide, mais c’est un régal et une réussite totale. C’est qui est dur, c''est d’arrêter d’en manger…', '2022-02-27T17:57:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, a5ed9d0b-7c39-4a6e-9368-166045160e2d, 'Au top vraiment jolie en plus', '2021-11-29T15:10:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 5b4eea03-2f20-432d-aab7-8e524a7f08dd, 'Réussite totale.  J''ai bien obtenu les 3 couches . Modifications apportées : 100 g sucre 100 g beurre et 45 mn à 180°. Mon mari est resté bouche bée !', '2021-06-02T12:29:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, c0695076-6e62-441c-aa15-622757950058, 'J''ai respecté la recette à la lettre. 50min à 150 ce n''était pas suffisant. J''ai rajouté 30min et après une nuit entière au frigo le milieu est liquide. Déçue... ', '2021-05-01T08:57:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, b5e69b8d-706b-4f77-a858-eb9ca1cfd9d8, 'super recette ', '2021-04-28T00:26:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 0122071f-7730-4ac0-b04b-3796a48cfd8f, 'Nous n’avons pas eu le résultat attendu, juste 2 couches sur trois, gustativement : trop de lait et pas assez de chocolat blanc. Très décevant, recette à revoir complètement, la cuisson à revoir aussi, juste joli visuellement. ', '2021-01-18T12:07:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 9b93ba02-9631-4027-8da7-222c03bc79b3, 'Très bon', '2020-11-08T02:13:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 9c777b36-33fa-49b9-b85e-7a82f20ef09f, 'Je suis assez mitigé sur cette recette car cela n’a pas du tout le rendu comme sur la photo de présentation cela ressemble à un flan je ne suis pas fan du tout.', '2020-10-13T19:02:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, e0b0e265-ecd6-4da2-a05e-de635739a1cb, 'N''a pas eu le même rendu que la photo. Je l''ai fait au chocolat au lait faute de blanc sous la main. Je le referais car je crains que ma première fois n''etait pas au top. Peut etre un manque de cuisson car les differentes textures, plutôt bof. Malgre tout c''etait bon.', '2020-05-02T18:58:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 3b22c30a-351c-45e5-8866-44eaca5352ef, 'Tres facile a faire. 
Beau et un délice. A refaire ???', '2020-04-04T20:07:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, babb483d-1c9a-4dda-be7b-dd95776441b0, 'Un goût d''œuf très prononcé qui ne vaut pas forcément la peine.', '2019-12-26T12:29:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 630adea9-7fe3-4553-8071-dda30cb1f486, 'Mon four à buggé... Du coup il s’est retrouvé à 180 au lieu de 150 ! J’ai mis le minuteur pendant une heure et je me suis aperçu du changement de thermostat que 8 min avant la fin de la cuisson ! Je l’ai sorti immédiatement et mes trois couches était bien présente gâteau réussi !! Donc 50 min à 180*C c’est parfait avec mon four en chaleur tournante. Recette faite au chocolat au lait à la place du blanc avec 100 g de beurre et de sucre pour moi.', '2019-04-22T11:58:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, a7a9168a-a63a-4a45-8f3d-68d57c9ea507, 'Une totale réussite pour mon premier essai! Concernant les ingrédients, j’ai suivi les commentaires précédents, mon gâteau a cuit dans un moule en silicone 1h a 150 et, la pâte me paraissant trop molle, quelques minutes supplémentaires a 120 en fin de cuisson. Mon gâteau ressemblait à la photo et a remporté un franc succès. Merci beaucoup pour cette recette.', '2018-03-11T13:38:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, aaf188f7-dd3e-4fb2-a266-9d3bf6a40fec, 'Pas top, je referai pas. Cuire plus longtemps.', '2017-07-02T16:42:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, ec4bd048-7ea1-4f00-ae2f-e0cf78b1288f, 'Succès total ! Délicieux, c''est mon 2ème gâteau magique, j''avais fait le nature la 1ere fois. Les framboises apportent une note de fraicheur. La prochaine fois, je le mettrais 5 min de moins au four, mais ca, ça dépend du four de chacun ', '2017-05-29T00:15:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 73fccc8c-6fad-4f19-886b-12f3b6df52ed, 'Déçu du résultat', '2017-02-25T23:46:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 4a791b75-074f-49bd-8d8f-d0be9b132006, 'Très bon ', '2017-02-10T18:14:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, a5020a81-02fd-4a19-9d6c-c8afb34b751a, 'Je vous conseille de modifier la recette l''ajout de farine n''étant pas mentionné dans l''élaboration du gâteau. ', '2016-11-05T20:33:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 4a081f7e-b51a-4059-852e-4debcffd78f9, 'Comme dans les commentaires précédents, moi non plus je n''ai pas eu les trois couches mais un gros flan aux framboises. Pourtant je l''ai réalisé à la lettre, déçu.', '2016-09-11T13:29:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, b7a6adbe-91ba-4646-b73d-3ae56d9d29ac, 'Trop au top ce gâteau je le fait à toute les sauces chocolat noir, fruit de toutes saisons. C''est parfait.', '2016-07-17T17:32:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, e118b52c-f626-463c-aec1-cc07593a5bec, 'Juste délicieux !', '2016-05-24T00:08:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, f43505e1-b3de-4f54-81ef-8b69a89eaefe, 'Délicieux est le mot parfait pour ce gâteau !', '2016-04-18T20:15:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, e883c562-bd37-486f-b0e4-30cdb9fbe9ed, 'Excellent en mettant effectivement plus de framboises et plus de chocolat blanc.', '2016-04-02T15:12:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, b1f492b3-3f37-4e91-baeb-e6f3aef5ccdd, 'Recette suivie à la lettre sans résultat. Pas de gâteau magique en vue, juste un flan à la framboise. Je suis vraiment déçu. je ne le referais pas.', '2016-03-23T07:45:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 39f035b6-09fd-4b6f-b38f-93fa12cf1406, 'J''ai suivi à la lettre la recette, y compris les durées et températures préconisées. Je suis très déçu du résultat. Il n''y a que deux couches, les framboises sont sur les bords. Personnellement je n''aime pas du tout le goût ni la texture. Je trouve le flan très lourd et malgré tout le chocolat blanc le goût ne me plait pas du tout. Mettre tout ce gras, ce chocolat et ce sucre pour ce résultat, pour moi ça ne vaut pas le coup. Je ne referai pas.', '2016-03-05T22:55:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, a9ab723d-8c6c-4e68-9827-e03161edb408, 'Malgré les commentaires j''ai voulu tester cette recette et je n''ai pas été déçue. J''ai suivi les conseils : 100g de sucre, 100g de beurre et 300g de framboises. Pour la cuisson j''ai hésité à ajouter un peu de temps car d''habitude je dois toujours rallonger mais pour le coup 50 min à 155°C en mode traditionnel et c''était parfait. J''ai bien eu 3 belles couches quasi équivalentes. Le gâteau se tenait très bien et était délicieux. Il a fait l''unanimité. ', '2016-02-28T17:41:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 44c5d30c-d6a7-4773-b376-3ffae1f0e50d, 'Une tuerie ce gâteau !!! Suivi à la lettre il est parfait je l''ai fait avec des framboises congelées.', '2016-02-22T00:42:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 2587fb77-4f37-4ae4-8d12-b343b5364b1a, 'Recette faite vendredi pour samedi soir. Très bien pour finir un repas, dessert qui glisse. Il avait peut-être cuit quelques minutes de trop car il y avait plutôt deux consistances au lieu de 3 (crème ressemblait au flan) mais très frais. Servi avec un dessert au chocolat pour trancher. Miam !!', '2016-02-08T11:26:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 7248862b-9b98-4df7-a23f-1bb50628deb6, 'Très bon et simple à faire ! les 3 couches étaient bien présentes, mon mari a été épaté ! A refaire sans hésitation ! ', '2016-02-06T21:00:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, a0df4e58-fee8-425d-8b55-7dc2e05f53c8, 'Terribleeee !!! Merciiii !', '2016-02-05T22:01:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, bfba4a49-2a9b-4216-87c1-bd44ca5bc528, 'Gourmand et pas trop lourd... Super recette. J''ai suivi les conseils: moins de beurre, 50 g, 200 g de chocolat blanc et 300 g de framboises surgelées. j''ai allongé la cuisson de 10 min. un régal !', '2016-01-24T22:01:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, f04b527d-d00b-4bd6-bb50-da192f448732, 'Très bon gâteau fait avec moins de sucre. J''ai même essayé le gâteau magique chocolat et banane toujours une tuerie', '2016-01-20T18:18:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, a59e0600-7847-44e8-af71-d374411bdb38, 'Je l''ai fait ce week-end, il a fait l''unanimité. Avec plus de chocolat blanc et un mélange fruits rouges congelés. Super !', '2015-11-23T18:53:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, ba84981d-bc20-4c37-8f20-714500af6e98, 'Ayant vu les ingrédients, j''ai réduit en beurre : -50 gr., en sucre :-30 grammes et seulement 150 grammes de chocolat blanc.  Résultat super : pas trop gras ni trop sucré (juste ce qu''il faut) ; à consommer frais. ', '2015-11-15T17:02:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 12bfb72d-0560-48e1-a8e2-e7ae39b01360, 'Déçue !!! Pour un gâteau d''anniversaire plutôt raté !!! Doré sur le dessus, tremblotant, pas de soucis !!! Par contre, celui-ci reste liquide après plusieurs heures au frigo (gâteau fait la veille). Four à 150°C ce n''est pas assez fort, il faut au moins 180°C.', '2015-11-01T16:47:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, dd3e1a8a-b24a-4ef5-b098-a470a4bbdef0, 'Testé pour un anniversaire avec une déco en glaçage blanc et pâte à sucre en réduisant les doses de la recette. Très bon retour de la part des invités ! Attention tout de même, la cuisson se joue vraiment à pas grand chose !', '2015-10-23T17:04:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, fabeff83-b1c9-4ced-ab1e-6cbdc8905f5a, 'J''ai fait cette recette mais je suis déçue, 50 mn ce n''est pas assez, le milieu etait tout liquide et ce n''était pas présentable... dommage pour moi ', '2015-10-12T11:14:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, effd1c82-2795-41a6-bb2a-e4ab275db948, 'Vraiment délicieux et les 3 couches sont bien présentes à la vue et au palais.', '2015-09-13T15:30:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, ccd230f1-53bd-463d-834a-3c9c1ae14ffe, 'Délicieux mais effectivement il faut qu''il soit bien froid pour pouvoir distinguer les différentes couches. Toute la famille s''est régalée.', '2015-09-04T13:08:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 3e54b091-bfc9-4842-87a3-c50479dcb402, 'Un peu déçue : ce n''est pas mauvais mais loin d''être un gâteau magique : on ne perçoit pas vraiment les différentes phases, ça fait plutôt un flan, assez lourd.', '2015-08-30T16:48:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 387960c5-b39b-4753-8e68-de8436695f8d, 'J''ai fait ce gâteau avec des fraises au lieu des framboises et c''était tout simplement délicieux.', '2015-08-24T12:35:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 6e7ed5b9-09e8-42a4-a710-3185256b85c8, 'Super recette elle a fait le plus grand effet lors d''une soirée ! Par contre ne rêvez pas vous n''aurez pas le résultat de la première photo où le gâteau est présenté. A vos fourneaux :-)', '2015-07-26T15:25:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 56bea5c6-b068-45b4-96b1-d3c68dc5cc52, 'Très bon !', '2015-07-05T18:16:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 589309c3-1103-44f2-b04b-add9ad4e9974, 'La cuisson était bonne, les 3 couches présentes. Le goût du chocolat blanc est quasi absent. Cela ressemble fortement à un clafoutis mais en plus onctueux tout de même. Pas déçue mais pas conquise non plus !', '2015-06-22T13:17:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 58dc764d-830a-44d7-8276-60bffa08b256, 'Facile à faire, l''amertume des framboises donne un bon goût cependant trop compacte et limite écoeurant... 1ere et dernière pour ma part.', '2015-06-13T23:16:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, e68d3c29-854d-44a0-a44e-1b76242c3591, 'Très frais et on retrouve les 3 couches! 1h au four avec les framboises surgelées. Simple et reussi!', '2015-05-28T23:02:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, d5558509-78d7-4acb-a6c9-1eb9c591817d, 'Super bon  et 3 couches. Recette à garder...', '2015-05-20T22:05:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325186, 66085880-12b1-465c-8c44-34c2f27a07eb, 'Très bon. Tout le monde a aimé.', '2015-05-19T03:27:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (313814, 868eae39-c950-4222-b19c-c340df9dcd54, 'Pour une première tous le monde c’est régaler et j’ai seulement 16 ans. J’ai tous fais moi même et suivis les conseil de certains commentaires sur la gélatine dans les mousse et je pense mettre 2 feuille et demi de gélatine la prochaine fois au lieux de 2 car ma bûche c’est légèrement affaissée. Par contre on a eu du mal à décollés le gélifié de framboise donc si vous avez des conseils je vous remercie ', '2020-12-25T02:53:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (313814, 4072ee88-d0b5-4fc7-bc6f-17221728d2f8, 'Très très bon, mais le démoulage est assez complexe ! ', '2020-12-24T11:43:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (313814, dbdd5d57-5191-40ec-bd15-108f599dda9e, 'Recette sympa et simple. Bonne pour 11 personnes. 
Tout le monde a adoré. 
Très léger et frais.', '2018-12-25T07:27:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (313814, e88469ec-807e-4c6b-895a-a8cc3f04cfee, 'Très bonne recette même pour une première. Je l''ai faite pour Noël puis pour le nouvel an mais en modifiant quelques choses la deuxième fois, j''ai remplacé la dacquoise par une génoise (goût personnel) et ayant trouvé la texture des mousses un peu trop compacte j''ai réduit à 2 feuilles de gélatine par mousse et ça fonctionne très bien. La bûche se tient parfaitement mais les mousses sont plus légères. A faire la veille pour être tranquille. Je déconseille cependant d''incorporer la gélatine au coulis de framboises avant de le passer au chinois mais de bien d''abord passer son coulis au chinois puis APRÈS le faire réchauffer et incorporer sa gélatine, ça rend l''opération beaucoup plus facile si on est un peu long et que le coulis prend dans le chinois ... ', '2017-01-02T00:17:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (313814, c01a35ae-0055-4430-b616-e3262bac8354, 'Très bonne recette malgré quelque difficultés au démoulage ! J''ai ajouté une fine plaque de chocolat entre la mousse et le biscuit. ', '2016-12-25T15:05:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (313814, 53832059-a098-450b-b38e-a98e6f2b153f, 'Excellent! Un vrai succès. Tout le monde en redemande. ', '2019-12-31T12:22:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (313814, 2c9c295d-33d9-4967-ba22-cb9dc262d6e1, 'Très bien.', '2017-02-18T15:13:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (313814, 4546fb22-4a34-455a-b3f8-5dfe19f6118c, 'Une petite tuerie !! J''ai gardé la majorité de la recette mais j''ai remplacé la mangue par une mousse de chocolat blanc. C''était tout simplement à tomber !', '2017-01-06T22:44:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (313814, 6296c992-f582-4a01-9449-2f1f9a717fae, 'Au top !  Faites 2 fois, dont une variante framboise-chocolat, tout le monde en redemande !', '2016-01-24T21:47:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (313814, d1a87b0c-9a9a-419b-9503-1a2872b10da6, 'Magnifique, réalisation facile, très beau rendu et très bon !!!', '2015-10-28T00:04:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (313814, f8791482-74f7-4535-a4f8-9e3fde273b3a, 'Merci beaucoup pour ce partage ! Première bûche et un franc succès auprès de mes 12 invités. Dessert léger et frais à la fois.', '2014-12-27T18:18:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (313814, a58ef31f-e52c-4ad8-8c98-098f6c6e37be, '1ère bûche réalisé et franchement tous le monde s’est régalé et visuellement très belle! 
J’ai quelque peu changé la recette en remplaçant la mousse de mangue par une mousse chocolat noir et j’ai mis un insert génoise nature et un sablé breton pour le bas de la bûche. 
Retirer la feuille de Rhodoïd de la gelée framboise m’a fait quelque frayeur car ce n’est vraiment pas simple à retirer mais ouf j’y suis arrivé! 
Lancée-vous, vous ne saurez pas déçu! ', '2021-12-25T23:08:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (313814, f16c14ef-5406-46f2-9095-88ab1fa94114, 'Très bonne recette premier coup un régal pour tous mes invités ', '2015-02-15T10:33:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, e5f34a4f-f503-4f47-97ca-c8154becdf22, 'Délicieux, par contre j''ai mis un peu plus de biscuits... ', '2023-05-28T15:38:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 83f751c4-3208-4ef9-a5a2-eb912942e9de, 'Trop bon ! Trop facile ! Excellent pour l''été ! ', '2020-09-17T20:27:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, f932d389-a475-4981-a297-6a3adacd35d5, 'Réalisée plusieurs fois avec toujours autant de succès mais avec : - biscuits cuillères de qualité (environ 40/45)  - sucre vanillé (15 gr) - gariguette (ou fraise des bois) Réalisée la veille car doit être placé longtemps au frais pour une tenue correcte. C''est léger et frais.', '2017-04-27T13:23:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 805a7c2d-57ba-4ccd-b5d7-4f509a02fce2, 'Cette charlotte fait partie de mes classiques et on peut la réaliser avec les fruits qu''on veut !', '2023-05-14T00:45:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 1f353d79-5bd9-48df-a0e1-9fa173513e33, 'Délicieux.
Je mixe des fruits rouges (achetés surgelés) aux pots de gervita et je trempe les biscuits cuiller dans le reste du coulis de fruits rouges mixés allongé à l’eau.
Un régal !', '2022-05-28T16:59:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, bb942168-6d42-4d69-977d-82b0720698c4, 'Excellent dessert. Tout le monde s''est régalé ', '2022-04-15T16:27:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 67311417-5b97-485c-b92b-4a8e3ec42759, 'J’ai toujours pensé que pour faire une charlotte il fallait être un pâtissier aguerri je ne sais pas pourquoi en tout cas le mythe viens de s’effondrer c’est un RÉEL jeu d enfant à décliner à tous les parfums je VALIDE rien à changer le Gervita donne un aspect mousseux . Petite précision si c’est pour le jour même ce n’est pas nécessaire de le mettre 24 h au frigo le congèle quelques heures puis le sortir une heure avant dégustation et le mettre au frigo ????', '2020-05-08T04:43:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 8671de28-2eae-41c2-92b7-1b479bb7bf5e, 'Un délice ! Tout le monde a adoré. Merci pour cette recette facile, rapide et qui enchante les papilles.', '2016-05-30T09:02:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, bd4a5180-7393-4679-a8ed-6d1254568213, 'Super recette ! Je viens d''en faire 2 et tout le monde a adoré! J''ai sucré les fraise 2 heures avant pour qu''elles forment un sirop. J''ai trempé mes boudoirs dans ce sirop ! Résultat au top. Je n''ai pas sucré mes gervita du coup ! ', '2016-05-30T00:21:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, bc0c8ac8-8a13-4fec-8595-54982ddfaecb, 'Tout simplement excellent. N''ayant pas d''alcool de fruits, j''ai imbibé les biscuits avec de l''eau et sirop de fraises. Merci pour cette recette simple, rapide et surtout très bonne.', '2015-06-17T23:14:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, a89245d3-2200-4a89-9ee9-84de4a911661, 'J'' ai adoré cette recette, mes parents aussi... Très facile a faire : à refaire.', '2014-04-27T19:30:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 30248a8a-0c8f-4898-8cad-a9cf4444deaa, 'Je l''ai faite avec 30 boudoirs et de l''alcool de coco ! Je n''ai eu que des compliments...merci pour la recette démoulage et tenue parfaite en plus...', '2011-07-07T21:48:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, a6759442-e81c-4506-94cd-36c743515aa0, 'très facile et délicieux', '2020-08-11T19:40:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, a0009987-4986-4b00-aa31-108ddacb88f8, 'Excellente recette ! Rapide, facile, peu sucrée, tient très bien. À faire la veille.  Testée en version fraises/framboises en sucrant à peine les gervita avec du sucre vanillé.', '2019-10-13T06:34:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 4fbcc77e-7c6a-4841-9938-e151d0893e88, 'J''ai fait un mélange crème fraîche / mascarpone / sucre... Trop bon mais penser à la faire au moins 24h avant pour une bonne prise.', '2019-05-07T19:32:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, bb242cb8-55d8-43bd-935e-de09404146b2, 'Excellente
Rien changé, très bonne tenue.
24h au frigo !', '2019-05-05T10:45:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, ec15caa6-c1de-4084-943b-71867cf5b2e7, 'Très facile à faire, légère on a adoré. J''ai trempé les boudoirs dans du jus de cerises (bocal de mon jardin) c''était très bon.', '2019-04-15T18:54:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 251c0c71-a061-4360-a07a-a22f9f240c90, 'Super facile et rapide à réaliser ! Et très très bon !', '2018-06-06T11:17:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 2caf08e8-709f-44df-a803-c559e340db11, 'Super simple et excellent on s''est régalé !', '2018-06-05T09:53:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, c5b6a33b-dbbc-4920-bf21-e0bcac0a4399, 'Juste une tuerie. Très légère très bonne je la referai.', '2017-06-16T01:50:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, ae0f7f8a-6b18-475a-886b-0603a4ea64c2, 'Très bonne recette ! Facile et rapide ', '2017-05-28T19:51:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, bb660cf7-f5a1-486f-bc16-0412b7c50f41, 'C''est vraiment bon mais je trouve que le Gervita donne un arrière-goût acide...', '2016-07-26T00:42:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 0b1675bb-0b8a-40d1-bd82-ebdc1dd88f05, 'Cette charlotte est un délice, je conseille de la faire la veille pour un meilleur goût et une bonne prise.', '2016-06-22T10:36:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, f8ab0ace-648d-4aa3-8a5e-828498e5d776, 'Une réussite !!! Avec 8 gervitas et une grosse barquette de fraises !! Trop bon.', '2016-05-01T11:55:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 0f6c625a-b731-47da-a3b8-dfe994d14fb4, 'Délicieuse ! J''ai mixé des framboises fraîches que j''ai mélangé aux gervitas. Elle ne s''est même pas écroulée quand je l''ai coupée.', '2015-08-19T15:41:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 58e6fbc3-1dfc-4fe8-924b-e34567dcbe7c, 'J''ai mis deux boîtes de boudoir 5 gervita (4 gervita à la fraise) 500 g de fraise et j'' ai trempé les boudoirs dans 20 cl de lait sans aucun alcool. Une vraie réussite.', '2015-07-18T12:50:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 112135fa-4980-40c9-84d1-513c7c5dfcf8, 'Très bon J''ai ajouté à l''appareil:  - 4 feuilles de gélatine  - 3 blancs en neige ', '2015-06-28T15:27:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 1e3b092a-de42-49f5-9963-854267638238, 'Super, je la recommande.. Quatre fois faite et toujours réussi... Un délice facile à faire. ', '2015-06-19T19:00:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 39c55e87-567b-459f-99dd-8113ef5c679a, 'Cela fait plusieurs fois que je fais cette recette. Facile à faire et excellente et pas trop sucrée ! ', '2015-05-31T13:01:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, c4a25efa-7649-4b85-afc1-253946f80495, 'Un excellent dessert, simple et parfait pour le printemps (fraîcheur). En effet, le Gervita est une excellente idée ! Pour ma part, j''ai un peu trop imbibé les boudoirs de rhum (ce qui a été d''ailleurs super bon...) ce qui a provoqué... Une chute de mon gâteau... Mais peu importe,  le résultat en bouche était fabuleux !!!', '2015-05-16T12:19:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 4226298a-6787-4d59-b2ec-9fdb7118d2d3, 'Délicieuse ! Prendre des Gervita sur lit de fraises c''est meilleur, couper les fraises en brunoise, et pour le sirop : 20cl eau  60g de sucre  liqueur de fraise. Je l''ai ensuite décorée de fraises et de perles en sucre brillantes, le tout agrémenté de quelques bougies et ça fait un magnifique gâteau d''anniversaire dont il n''est pas resté une miette !!! à refaire !', '2015-05-11T14:53:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 3ec4cda4-2dab-4879-8e9d-3343be7ec26f, 'Cette recette est impossible a faire, 30 boudoirs c''est trop peu vraiment decu', '2015-05-02T17:55:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 44918a98-081f-4088-a5cb-0e43a00260ff, 'Parfaite.. très bonne légère et très facile à réaliser.  :-) ', '2015-04-27T20:24:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 0181be99-5a67-49e2-b6a5-d1aa8c30c8cb, 'Parfaite ! Simple à faire et légère. Tout le monde en a redemande. Le gervita est une excellente idée. ', '2015-04-26T11:22:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, e973e9c4-6f49-4b4a-8de7-1e66048d441e, 'Plutôt bonne recette, facile à réaliser et très présentable pour finir un repas en beauté. Ceci étant, je n''ai pas utilisé de film plastique, comme recommandé pour la préparation de la charlotte, et elle s''est impécablement bien démoulée! ', '2015-02-17T15:32:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 4d28db62-1270-4d43-b6fe-e2bddddcd284, 'Simple et efficace !!  J''ai ajouté de l''arôme de fraises, c''était délicieux', '2015-01-02T02:03:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, da277da3-1c86-47b8-8f3a-5bb0945c8f0d, 'Une recette rapide, légère et qui en met plein les yeux ! J''ai mélangé les fraises aux gervita c''était très bien. Avant, j''utilisais du fromage blanc. Le gervita donne un aspect un peu mousseux et de la légèreté.', '2014-07-20T19:31:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, e4c3f2cd-906f-4ef1-be6f-9d2000c1ad5d, 'Simple, rapide, très bon... et ça tient !!! Super recette en laquelle vous pouvez avoir confiance.', '2014-07-14T17:46:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 03117be6-1f65-4a80-94fb-12ca93991254, 'Quel bonheur je n''avais jamais réussi une charlotte jusqu''à cette recette !!! Un véritable bonheur gustatif, je l''ai faite une première fois avec des fraises fraîches et des pêches au sirop et le restant des fruit j''en ai fait un coulis. Et je viens d''en refaire une à l''instant avec des fruits rouges surgelés. Mon homme, qui n''est pas très gâteau, m''en réclame sans arrêt. Merci beaucoup pour cette recette.', '2014-07-12T15:48:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 6db11b6e-d906-47c2-9376-84a46bbee999, 'J''adore cette recette, je la fais avec un moule tupperware.', '2014-07-12T11:56:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 0768bf8d-a05e-45d6-ab94-693e96766750, 'J''ai fait tremper mes boudoirs dans un mélange jus d''orange + Cointreau, 5 pots de Gervita, 30 boudoirs.  Je l''ai décorée avec un coulis de fraise et quelques pistaches. Démoulage parfait. Mais peu de goût, hormis celui du coulis, et la texture du Gervita est malheureusement bien moins aérienne et onctueuse que celle de la chantilly. Très déçue par le résultat.', '2014-07-01T14:32:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 5d804580-b0f9-4cc1-9b14-321db333b796, 'Parfait. J''ai mis seulement 4 pots type Gervita et j''ai fait tremper mes biscuits dans du kirsh ', '2014-06-10T17:22:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, a31ebf93-6edd-43ab-a996-f88c1b8917da, 'Un régal et en plus très rapide à faire !!', '2014-06-07T21:30:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 5846403f-80db-4abe-9108-c904c3ce26aa, 'La charlotte aux fraises et très bonne et très facile à faire. Au début j''avais peur que la charlotte s’écroule mais en fait non, donc je suis très contente !', '2014-06-02T00:06:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 5697e1b6-5f9b-4f8c-a7ae-7e77b37e581a, 'Excellente recette et d''une grande facilité. J''ai utilisé des biscuits roses de Reims. Parfait aussi.', '2014-06-01T22:12:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 0176c23a-7579-46a2-95ec-2c8440ffb107, 'Extra cette recette, simplissime, rapide et excellent.', '2014-05-21T23:28:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 68daf0ba-e44a-4c3f-89ac-7db91068d96c, 'Attention à commencer d''abord par le tour avant le fond pour les boudoirs sinon 30 ne suffisent pas. A refaire et refaire !', '2014-05-17T16:39:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 11f3ccc0-9833-45b4-96ec-65d8f6ccb8e9, 'Simple, léger et délicieux.                  ', '2014-05-12T17:00:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 72dd3c57-c39a-42a5-9095-4d6d7a0ccb8f, 'Pour une première charlotte, j''ai fait un tabac avec cette recette. Simple et rapide. Attention à mettre de la garniture plus haut que les biscuits, sinon la charlotte risque de tomber.', '2014-05-04T13:53:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 014c2c7e-1b21-4c94-b43d-7351b1a44047, 'Assez bonne charlotte, le résultat est bluffant on dirait presque de la chantilly ! Effectivement 4 pots suffisent amplement. Par contre, 30 boudoirs ce n''est pas assez et je pense que le rendu serait meilleur avec des biscuits à la cuillère. Bref recette que je garde dans mes favoris. ', '2014-04-25T20:09:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, fa54d8a2-13e1-483c-9075-d4aef4f381ae, 'Très bonne, j''ai remplacé par une crème mousseline à base de mascarpone.', '2014-04-22T20:37:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, e7b93a67-e03b-4b78-8264-e373b0eba6f4, 'Un vrai délice ! La charlotte est très facile à faire et se démoule facilement. ', '2014-03-16T20:57:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, f1e87352-4dc0-46a6-aa07-0df698467f7e, 'Un vrai délice.  ', '2013-12-11T23:20:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 1c497ec1-c44f-4b7a-8c03-4d0dc2d22add, 'Enfin je me suis lancée et ce fut un succès. Très simple et délicieux, léger. Tellement que j''en ai refais une petite le lendemain. Je n''ai pas trempé les biscuits mais les fraises avec un peu de citron et mis du sucre vanillé sur les fraises et pas dans le gervita.', '2013-10-01T14:44:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, b206dfa6-23d2-4a5b-9b4c-01455a88df0b, 'Accueil mitigé pour cette charlotte. 3 pots de Gervita suffisent largement et au demeurant, cette idée que j''ai trouvé au départ astucieuse n''a pas été si concluante : ce produit n''a pas beaucoup de gout. Seul avantage : je n''ai jamais préparé une charlotte aussi vite.', '2013-08-23T18:33:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, d1da58d4-4033-454b-a112-b8cdad818dd0, 'Démoulage impeccable. Goût excellent. Je vais la refaire avec des framboises. Rapide et peut se faire à l''avance sans soucis. J''ai trempé les fruits dans un sirop fait à base du jus des fraises, jus de citron, arôme vanille, sucre vanillé.', '2013-08-09T19:38:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 5f132f05-1bcf-4a76-8164-05ae5445623c, 'Excellente recette !', '2013-07-21T02:30:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, e0615da4-6f32-4ba6-8194-c5af68185a1a, 'Excellente recette astucieuse (l''idée du Gervita est très pratique). J''ai pour ma part utilisé des biscuits à la cuillère Bonne Maman : à n''en pas douter ce sont les meilleurs, ils donnent une texture sympa avec les petits morceaux de sucre et leur goût vanillé ne gâche rien.', '2013-06-26T18:02:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, 424ecf00-cd3a-420a-9042-372001cec691, 'Cette recette est très bonne, mais trop bonne. Pour que ce soit moins lourd je ne mets pas les boudoirs sur les côtés, et la charlotte tient quand même.', '2013-05-31T20:16:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22075, a06c8060-a020-4112-a244-aefc226c0b69, 'Bonne recette. Par contre, il ne sert à rien de mettre un film dans le moule... La charlotte se tient très bien et elle est délicieuse.', '2013-05-30T20:52:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344021, 8de1057e-7d33-456f-ba26-fed383479c1c, 'Avec des fruits de saison pour varier et preparer une boisson pour toute la famille et economique. Je rajoute selon l''humeur cocombre, basilic, menthe fraiche, écorse de citron, d''orange (non traites) pendant au moins 12h. Je filtre et fait gazer l''eau.', '2018-08-16T07:01:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344021, c6861a28-955a-45f2-acaa-2c46d5cfa993, 'Super !', '2018-05-31T10:49:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344021, 8da02890-2090-496d-8807-c27c5d22758a, 'Excellent !!!', '2018-05-11T04:03:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344021, 753605b5-65ae-410e-ba9d-c8cd3ba3e7a5, 'Très rafraîchissant ! ', '2016-06-08T22:08:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344021, 3e18e5bc-3d1f-4c8e-bf1e-e6cea68d0e56, 'Pur régal !', '2016-04-13T18:33:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344021, 1d9ea064-b176-462c-a0c1-2122c9e5c1d8, 'J''adore cette boisson ! On peut varier bien-sûr ! Mais quelle fraîcheur ! Merci.', '2019-06-05T04:29:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 9136ee26-1d1d-4aa1-b8c6-6c2936f8ccb0, 'Vu les commentaires : j''ai mis seulement 70g de sucre, pas d''huile mais 30g de beurre et 100g de fromage blanc. J''ai battu les blancs en neige et cuit 45 min à 180°C. Je suis très contente, pas gras et pas trop sucré ', '2017-01-31T13:57:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 9986dfe4-ff68-4db3-82cb-cc4c8fdbffca, 'Excellent. J''ai suivi les avis. 6 kiwis. Moitié huile moitié lait', '2022-05-01T14:56:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 6d3e3005-c024-4498-b908-7249c12d89ac, 'Un délice ! Je mets plutôt 1/3 de verre d''huile et rajoute 1/3 de verre de lait, un peu de cannelle... Testé à l''ananas également, le top ! ', '2022-04-17T02:25:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, e084b5b6-1b93-44b3-9725-f516aeb3ecac, 'Très bon gâteau ! Léger et moelleux à souhait. 
J''ai mis 6 kiwi, 1 pomme, 70 g de sucre et remplacé l''huile par du fromage blanc.
Un régal !', '2019-04-15T07:45:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 0cc7082b-bd2b-4340-8739-4c08ab31f7e2, 'Super bon ! J''ai ajouté un yaourt a l''ananas (qu''on ne sent pas du tout) à la place de l''huile et ai battu les blancs en neige. Je n''ai aussi mis qu''une pomme et 4 kiwis et l''ai cuit plus longtemps. Le seul problème c''est que les fruits tombent au fond et c''est donc dure de démouler mais ce n''est qu''un détail. Le gâteau à l''air d''avoir 3 consistances différentes : le haut comme un gâteau normal, aérien, le milieu comme un sorte de flan et le dessous, les fruits. En conclusion, ce gâteau est parfait ! ', '2015-08-19T22:41:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, f5ba7c40-c8e8-4053-bfaf-40a9b5e75277, 'Excellente recette, faite avec 100 g de fromage blanc à la place de l''huile, 70 g de sucre et 1 sachet de levure. Gâteau très moelleux, se mange tout seul ! Merci. ', '2015-07-19T22:05:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 353f32c9-3b3f-4ea6-b265-7482d73b9abd, 'Très bon gâteau ! j''ai mis plus de kiwis, 1 sachet de levure et j''ai moi aussi remplacé l''huile par un yaourt à la vanille à 0%.', '2013-12-22T21:34:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 516059f3-e442-4808-8646-91e2d80a76ea, 'Simple, rapide, bon ! J''ai ajouté une goutte de rhum et j''ai mis seulement un filet d''huile. Pour les fruits, j''ai mis 4 kiwis, 1 pomme et une moitié de banane. J''ai ajouté aussi quelques pépites de chocolat. Mangé tiède c''est un régal !', '2012-11-18T17:10:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, fa9e177f-0f20-4869-a08e-2cdb80b5b08c, 'Délicieusement moelleux.', '2023-06-25T07:32:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 2c05a032-645c-4c11-b000-3fc999c82a0d, 'Merci pour cette recette ', '2023-06-11T07:00:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 84d8b2a6-2a51-4a15-99d4-609ed7a49848, 'Excellent, agréable surprise par la présence du kiwi pour les convives ', '2023-02-24T12:42:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 63b9a131-43ec-4863-92c3-0173265ecd36, 'C''était excellent avec les kiwis du jardin.', '2022-11-25T16:09:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, a7231565-0b76-425a-8370-8a224dfd3f9f, 'J''ai réduit les quantités, mais trop réduit la levure... À refaire malgré tout car tiptop pour terminer les fruits avant qu''ils ne deviennent trop vieux ! Ai rajouté un peu de mélange 4 épices et nickel, je recommande +++', '2022-02-19T20:28:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 8da462b5-dbd4-4ada-80c8-78a78b91ddc2, 'Pas trop sucré, très moelleux, pas gras. Obligé de le finir à deux, tellement c''est bon.  Merci pour cette recette', '2017-02-19T19:38:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 056315ea-f5c2-4f86-8b17-22e6ec256f76, 'Bon gâteau, à la place de la pomme j''ai mis de l''ananas, j''ai pas mis d''huile parce que l''ananas a permis de désépaissir la pâte directement, j''ai quand même ajouté 3 cuillères à soupe de maïzena pour à la fois alléger le gâteau mais aussi pour éviter que se soit trop liquide. Après la cuisson, j''ai pris le reste de l''ananas que j''ai mélangé avec deux cuillères à soupe de sucre roux, j''ai ensuite transformé cela en compote que j''ai ajouté en étalant le tout au dessus de mon gâteau encore chaud, et pour terminer j''ai mis sur le dessus en plus de la compote d''ananas, quelques morceaux de kiwi. Un délice !', '2016-04-30T21:44:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, c28026a2-b6a2-469d-98dc-a14a046c2507, 'Parfait! J''ai mis 4 kiwis au lieu de 2 et 50g de beurre à la place de l''huile.  C''est excellent, je referai avec plaisir !', '2016-03-11T21:19:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, a423488c-bdd3-4889-9ec9-866911e026bb, 'Succulent ! Gâteau léger et absolument délicieux. Tout le monde à aimer et en redemande. Simple, rapide à refaire très vite.', '2014-11-15T12:45:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 5bfa1410-ec8c-49d7-b5fb-13525dae2518, 'Bon gâteau. Moelleux et aérien. J''ai procédé à quelques modifications : j''ai remplacé les pommes par des bananes et j''ai ajouté des pépites de chocolat blanc et noir. J''ai également remplacé l''huile par de la crème liquide pour alléger la préparation. Je referai !', '2013-04-19T09:10:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 124303c4-feb8-4471-87b2-dcf84a577bfc, 'Facile à faire. Tout le monde a adoré, à refaire !', '2013-02-22T20:34:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, a08e4e13-049e-4192-ac1a-eeacf0f8a0a9, 'Pas mal, j''ai remplacé l''huile par un yaourt.', '2013-02-01T18:28:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 3e2a5ddb-ad37-493f-8f06-ee6e1b0602d7, 'Dessert léger... Et le mariage pommes- kiwis, délicieux...', '2013-01-20T12:03:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 8a6ce324-6425-411c-8b97-4ccdf2ece37b, 'Parfait', '2012-11-26T23:40:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, f3014b73-8bb6-4caa-8085-78d0561adbdb, 'J''ajoute des copeaux de noix de coco sur le dessus avant la cuisson ! Exquis !', '2012-06-16T13:06:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 94c84ecb-2e0d-446d-ae3f-9a3301ce8cfa, 'Facile et rapide à faire avec quelques fruits : il me restait justement des kiwis et des pommes ! Toute la famille a adoré, car pas trop lourd.', '2012-04-20T20:26:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 70f03fbf-2a94-4c31-9e05-7f68c178b598, 'Très facile et rapide à faire, le dosage est bon, on s''est régalé ! ', '2012-04-10T22:36:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 5c390410-8e13-4ec4-9b35-94f0d8e1667f, 'Sympa : bon gâteau vite fait et inratable. J''ai remplacé l''huile par un peu de beurre fondu et ajouté un bouchon de rhum brun. Cuisson 35 min à th6 et les petits dés de pommes étaient encore un peu fermes. La prochaine fois je double les proportions et le fais cuire dans un moule à manqué.', '2012-03-18T17:57:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, ca9ef827-2be5-4aa7-bbab-3c1dbd32d487, 'Un délice. J''ai mis un yaourt 0% a la place de l''huile. Top, tout le monde adore !', '2012-03-08T20:42:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, f3856b50-99bf-4559-b66f-5b89282967e9, 'J''ai fait ce gateau hier soir il est excellent meme un peu tiéde trés facile à faire et à réussir j''essaierai moi aussi avec pommes bananes  ', '2012-02-05T09:50:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 53a6b95d-a2c3-45eb-8d1b-7fe51c5a52c9, 'Facile, pas cher, les proportions sont parfaites, le temps de cuisson impeccable, ce gâteau est inratable, très bon encore un peu chaud.', '2012-01-22T17:53:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 416d7aee-a6f4-4866-8aaf-67a589d90d9a, 'Gâteau tout simplement excellent. J''ai cependant réduit la cuisson de 5 à 10 minutes pour obtenir un gâteau onctueux. Réalisé en 10 minutes, avec des ingrédients simple qu''on a à portée de main. Il régale toute la famille.', '2011-04-20T23:06:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 8b00d49f-efd9-41c7-81fd-1c3380ab0c08, 'Il me restait 4 kiwis trop acides et 2 pommes et je ne savais pas quoi en faire. J''ai donc suivi la recette et les commentaires qui parlaient de monter les blancs en neige et de mettre un yaourt blanc à la place de l''huile et c''était délicieux. Tout le monde a adoré. ', '2011-01-04T17:42:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, c8700d3e-d11b-4fe5-853b-d8848e05a9a0, 'Pour ma part, j ai troqué l''huile contre un yaourt brassé. Le gâteau est bon ; quoiqu''un peu compact mais il se démoule très mal même dans un moule en silicone.', '2010-06-20T10:12:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 398986e8-3434-4f4e-b676-d9666f22a93a, 'Je viens de faire le gâteau en changeant quelques petits trucs : j''ai troqué les pommes pour une banane (on fait avec ce qu''on a) et le mariage de l''acidité du kiwi avec la douceur de la banane est plutôt sympa. J''ai mis un peu moins de sucre car la banane en contient déjà et j''ai monté les œufs en neige ce qui rend le gâteau très léger. Enfin, j''ai saupoudré de noix de coco râpée et d''un peu de sucre avant de passer au four. Super !', '2010-05-18T20:33:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 8c5b8604-f520-4a07-9c51-a4e12ba2b08c, 'Très bon gâteau avec un goût, un peu acide, bizarre mais bon !', '2010-04-02T19:30:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 0fa831c0-8700-479b-971c-6c8f2c2f5e99, 'Excellent gâteau ! Mes enfants l''aiment beaucoup ! Je remplace le 1/2 verre d''huile par un 1/2 verre de crème, c''est plus léger.  ', '2010-03-24T11:07:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, a261c7c6-26ce-4b61-99c9-9e3e4711ea71, 'J''ai suivi les conseils des internautes à savoir utiliser 5 kiwis et une sachet entier de levure, ainsi qu''un yaourt, en plus des ingrédients indiqués. Le tout est très bon et très léger. A garder sous le coude.', '2010-03-22T12:08:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, cb2d6172-cfcc-4a6d-b6a6-5b50d1d60fa4, 'Recette très simple à faire et facile. J''ai également ajouter un yaourt blanc et j''ai remplacé le sucre par du sucre de cannelle, très bon !', '2010-03-17T14:45:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, a694e4c1-ba28-458f-9ba3-f835d4e66560, 'Excellent gâteau toute ma famille a adorée, le kiwi apporte un peu d''acidité ce qui est délicieux et j''ai mis un kiwi de plus.', '2010-03-14T15:10:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 3c9f5d28-83cc-4e83-887a-3499d6aa5bc5, 'Très bon gâteau ! Merci pour la recette. J''ai quand même ajouter un pot de yaourt nature pour qu''il soit plus moelleux.', '2010-03-12T19:06:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 9145014c-9e33-449d-98db-35cda3f34ae0, 'J''ai fais ce gâteau ce soir. C''est un délice, par contre j''ai mis plus de kiwi que sur la recette : j''en ai mis 4 ou 5 je sais plus mais j''ai gardé les 2 pommes. Delicieux !', '2010-03-10T22:28:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, cd5df7b8-e5c6-4ab5-9970-a25409689ba2, 'Merci pour cette recette. Ce gâteau est vraiment excellent. Vite, je l''enregistre dans mon carnet de recette.', '2010-02-08T14:39:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, a3293ed5-0208-4d1a-9ee4-ed8b5350beb3, 'Très bon gâteau, rien à redire', '2009-11-22T16:15:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 9ab85169-9b5f-4468-aa90-70c3bba2c869, 'Bonne recette, pour ma part j''ai ajouté un yaourt et mis un sachet de levure entier.', '2009-10-05T16:31:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, a5650e21-a459-4802-a5ad-a46506b5e68f, 'Déçue par rapport aux commentaires, 1/2 sachet de levure n''est pas assez, le gâteau était archi plat, j''ai ajouté 1 kiwi à la recette.', '2009-04-28T17:05:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 3752a01e-07ba-45cc-911e-0de5b89ab0cb, 'Pour une fois que je réussis un dessert, quel bonheur ! Frais et léger, je n''hésiterai pas à le refaire ! Merci pour cette recette.', '2009-03-20T23:46:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 079ad76d-7c4e-4bad-82d6-c77dbca78b4c, 'Mes enfants ont adoré!!! et moi aussi! je l''ai fait dans un moule a cake et j''ai mis 3 kiwis et 2 pommes !! mes enfants viennent d''en manger la moitié !!! merci pour cette recette !! ', '2009-02-24T17:34:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 5ff79605-0a3a-4238-ac0d-ebc29f0cb2ff, 'Très bon, j''ai ajouté 1 kiwi. Très léger en plus.', '2009-02-02T13:55:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 4aaff2f5-8b13-4f5d-bc4b-68f00e693e8d, 'Tout simplement exquis!!! J''ai bien respecter le temps de cuisson mais j''ai mis un papier sulfurisé dans mon plat, le démoulage fut très facile et la présentation extra.', '2009-01-29T17:30:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, b6fc7e40-84f6-4d65-9972-7df67255949b, 'Très facile à réaliser, très bon, je mets un kiwi de plus et une pomme de plus également;', '2009-01-18T10:36:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, e7ec9355-dea9-48f2-8bfa-68e0f54723ff, 'Je voulais faire un gâteau avec des kiwis...recette trouvée et adoptée ! On s''est régalé ! Rien à changer, merci !', '2008-11-30T13:37:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 0f1e3a33-b7c2-43e1-998a-d610435b1d0d, 'Le mélange kiwis - pommes est très bon (un kiwi supplémentaire peut être le bienvenu). Recette réalisée avec 80g de sucre. J''ai utilisé un moule à manqué ordinaire, du coup le résultat était plutôt plat (hauteur environ 2cm). Je ne sais pas si le gâteau devait "monter" plus. La prochaine fois, j''utiliserai un moule de diamètre inférieur pour un résultat plus épais.', '2008-11-26T11:12:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71350, 019d9188-39d3-4d96-89aa-467cdb6e39df, 'Rien à dire, à part EXCELLENT !', '2008-11-09T15:30:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39814, 89716124-b98d-4118-9ea8-dce055903e62, 'Vraiment très bon, proportions parfaites. Je n''ai pas mis de citron mais davantage de vanille afin de souligner encore plus la subtilité de la poire.', '2017-07-27T08:09:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39814, 362a9c83-67ba-440d-9778-7016c9484bdc, 'Merveilleuse recette, super bon c''est un vrai délice. Je n''avais pas de poires alors j''ai remplacé par la même quantité de mangues .Merci à toi.', '2009-07-04T20:57:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39814, a0b8ba7e-9588-4efb-b2ca-5deb724d4c7f, 'Faite en mai et découverte/dégustée en septembre avec des amis sur des crêpes : un délice! Plus un dessert de fruit qu''une confiture ou une version "sophistiquée" de la confiture. A refaire, sans hésiter.', '2008-10-12T09:01:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39814, dd09e262-8647-4ce0-aedc-48b1eb2a2a39, 'Un régal chaque matin...', '2007-09-12T18:53:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39814, 31982454-a152-44e0-a3e1-0f9f2960ad25, 'Bonne confiture, mais on ne sent pas beaucoup le goût des poires.', '2006-05-22T19:58:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39814, bab0e46b-caa6-44f9-ab99-989426d7fae1, 'Mélange très réussi :-) Le goût est trés agréable en bouche. J''ai reessayé cette recette en remplaçant la vanille par une cuillere à café d''arôme amande amère, le résultat est très bon :-) Merci.', '2006-02-20T15:12:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, bc26789a-3164-48fd-8642-0844a4a0503b, 'Problème dans les quantités. ', '2022-09-24T19:42:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, f88a79d2-c458-45c3-b0f7-12074e6ba32a, 'Très franchement, je ne comprends pas la note de cette recette.
Les proportions ne sont pas bonnes, il y a beaucoup trop de farine, obligée d''ajouter un oeuf puis de la crème fraiche pour que la texture soit assez souple pour intégrer les fruits. Le goût est cependant correct et agréable après cuisson. 40min pour notre four.', '2019-09-25T07:51:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 842c8079-b26b-46f2-8373-15d19e9936ab, 'Bien trop compact pour intégrer les fruits. J''ai dû rajouter de la crème liquide et de la vanille liquide pour que ce soit plus souple. Il cuit, donc je ne peux pas commenter le goût. Ah et je n''ai aussi mis qu''une pomme, j''ai estimé que cela ferait trop deux pommes et deux bananes. À voir. ', '2024-02-10T11:44:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, a4b19efe-8877-4237-9108-0bc46b534236, 'Très moelleux et léger. Tout le monde a adoré !', '2022-12-24T13:58:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 50b41ca3-9091-4138-9f2c-77fb2990723f, 'J''ai adapté la recette car trop de farine ...
J''ai ajouté du lait, de la cannelle et du rhum pour le goût. J''ai écrasé les bananes.', '2019-05-08T09:12:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 8637058c-3196-4f39-9e3a-dbd30392fc9e, 'Fait avec 3 oeufs, 200g de farine et 100g de sucre comme conseillé dans les commentaires. J''y ai ajouté un peu de cannelle et de miel. C''est un régal ! Je garde la recette bien précieusement, à refaire sans modération.', '2019-02-27T05:09:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 600f61d0-a805-4284-9707-8a9c3531c8d2, 'Très bon mais pas assez de liant, j''ai dont rajouté un œuf et un peu de fromage blanc (à défaut de lait) ', '2023-11-09T16:10:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, cbff5618-f112-49d7-84f1-31ec812f26c3, 'Absolument délicieux et moelleux. J’ai ajouté 10cl de lait. Avec  des noix hachées grossièrement et une grosse pomme et deux bananes. A refaire.', '2023-03-15T13:45:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 685ea8af-4e90-4fc9-883b-3e5509891ec8, 'Miam-miam ', '2023-03-05T14:56:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 5ea48ccc-cffe-4bb7-b228-25fcaaa2c286, 'Ça fait plusieurs année que je fais ce cake, je fais le mélange au fouet et en effet la pâte paraît trop dense mais je mélange à la cuillère les fruits et je n''ai pas besoin d''ajuster les doses et c''est juste un délice et très moelleux ! Je vous assure, essayer de suivre la recette, c''est une réussite. ', '2023-02-01T17:34:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, c25f7924-4548-4480-b2d7-8288916deada, 'Excellent, très moelleux, encore meilleur avec un peu de farine complète et de cannelle.', '2022-05-20T09:04:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 848dbb52-7446-4ee4-86db-ff6c951217bc, 'Très bon cake! J’ai cependant modifié les quantités en mettant 50gr de poudre d’amande à la place de la farine et 100gr de sucre avec un sachet de sucre vanille ?', '2021-01-30T19:11:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 2b82179f-3ac6-4113-a0c1-c3a2b7b3ecdb, 'Très bon cake ! Je l''ai fait avec plein de fruits et fruits à coques différents et c''est toujours un délice !', '2020-12-28T14:58:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 355ff877-ec56-46a7-b607-34a24c6dd6db, 'Bon gâteau. La texture n''est pas trop moelleuse par endroit mais peut-être est-ce du au fait que j''ai un peu trop travaillé la pate. J''y ai rajouté quelque pépites de chocolat. Nous avons bien aimé. Merci.', '2020-11-16T21:15:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, f2e7b439-5cfc-4f50-af2e-986263b0d525, 'Cake pas du tout moelleux. Il est beaucoup trop serré. J’ai pourtant rajouté du lait. Il y a beaucoup trop de farine. Il est fade et pourtant j’ai flambé les bananes au rhum.', '2020-10-04T20:31:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 21d411ac-2279-4c60-bb2f-6a689f2304a4, 'Merci pour cette recette, j''ai également mis moins de sucre et de farine. + rajout d''un peu de lait et de cannelle : ) ', '2020-10-04T16:55:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, f9187758-f1ae-414a-9ede-38b1df6e7a25, 'Çe ne sera pas 5 étoiles pour moi car j’ai du rajouté du lait (trop de farine). Cependant le goût est très agréable et a plus a tout le monde.', '2019-12-23T20:59:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 1dad8d24-d733-4aa7-9567-5b31a6e54c17, 'Bonne recette juste rajouté 1 oeuf, et mis la levure avant la farine. 
Je l''ai réalisé plusieurs fois : pomme, pomme poire, pomme banane, bref compatible pour toutes sortes de combinaisons. Merci. ??', '2019-10-31T02:33:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, efd0ff3b-82b1-4051-b727-832362232420, 'Excellente recette ! Réalisée en diminuant le sucre et ajout de lait comme indiqué dans les commentaires précédents.', '2019-06-01T12:29:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, a09dae16-daab-4c11-8a2d-300440376669, 'J’ai rajouté un peu de lait pour rendre la pâte plus souple, le cake était délicieux et hyper moelleux ', '2019-05-16T05:03:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 2f70a437-ec9f-4f83-9060-133f2762dc16, 'J''ai rajouté 100 ml de lait, 50 ml de rhum et 100g de noix. DÉLICIEUX !', '2018-03-09T11:18:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, dfa3a45e-82b9-49c6-9566-85485b47123a, 'Inspirée par les différents commentaires précédents, j''ai fait caraméliser mes fruits avant de les incorporer à la pâte : résultat concluant !', '2017-08-15T12:06:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, d304b1f9-3ce8-4aad-90bf-502c37cc3ff4, 'Recette très bonne déjà faite, un régal...mais je ne mets pas de pommes 🍎 ', '2023-04-25T21:48:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 2f51d146-d331-4e56-a12f-02b63a53b29e, 'Un délice, mes proches se sont régalés !', '2022-09-08T17:17:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, e20788ff-e69e-4743-ab4c-775cc6c5521e, 'Excellente recette. J''ai mis du sirop d''agave et un carré de chocolat noir.', '2022-08-15T20:11:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, a6a0378b-daf8-4df0-885c-50fd586c85fd, 'Très bon 
', '2022-06-07T20:33:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 8982b2c5-0173-4e92-a3b8-0595daef80d2, 'Moi aussi j''ai ajouté 10cl de lait et .... des pépites de chocolat !! Très bon', '2022-02-06T14:23:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 9106e2ad-61a2-4bb4-abe3-0d30df7caf8a, 'C''est parfait à mon avis', '2021-12-14T17:11:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, f64f83ed-b801-47da-b16f-305e1f1dbb95, 'J''ajoute 10 cl de lait supplémentaire', '2021-11-24T23:59:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 1cceb87b-9559-4208-91ae-a0d225e77f9b, 'Super recette, ça fait plusieurs fois que je la réalise, les enfants adorent', '2021-02-09T16:21:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 5578c454-abf0-4755-87b7-75764be10073, 'Testé aux mirabelles en modifiant la recette 3 oeufs 200g de farine 75g de sucre 75 g de beurre 1 sachet de levure et 2 cuillères à soupe de fleur d''oranger. Vraiment bon et moelleux ', '2020-09-06T22:01:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 68b56800-0a25-402d-9f01-0e24ff1c4ad6, 'Je l''ai fait en suivant les commentaires.
100g de sucre
200g de farine
Un peu de lait
Un peu de cannelle 
Un délice ', '2020-04-22T00:09:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, f4320817-6bb8-43c3-bd24-8b9647bb6fba, 'Super moelleux et super bon !!
Pour un cake sans gluten: 100g de farine de riz (ou de châtaigne) + 90g de poudre d''amandes (ou 2 cuillères à soupe de maïzena).
Le petit plus pour un cake ultra moelleux: laisser finir de cuir four éteint les 20mn dernières minutes.', '2020-04-02T17:48:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 4cbf5f6e-c364-4c1f-a024-ad734d1c2894, 'Pâte trop dure. J''ai du rajouter du lait. Je déconseille cette recette', '2020-04-01T18:43:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 29d8b32a-a827-4c8e-bef5-306f38a4399e, 'Recette facile à effectuer, cependant les dosages ne sont pas du tout proportionnels et j''ai dû ajuster pour que la consistance de la pâte soit correcte (seulement 200g de farine, ajout d''un oeuf et de 15 cl de lait)', '2020-03-29T10:26:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, dc25d1e1-b0c5-4eb4-af90-78d8d256eb6f, 'Très bonne recette :) ', '2020-03-26T12:10:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, ceebdd98-ae37-42e4-a768-5ad1529cf8fe, 'Excellente recette. J''ai également rajouté des pépites de chocolat, à refaire.', '2019-12-05T07:27:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, cee86735-fd43-4a24-b89f-25b9ab759cde, 'Excellente recette, très moelleuse !
Je recommande !
Essayée aussi avec un peu de poudre de noisette et 2 gouttes d''amande amère à la place des bananes', '2019-05-26T01:36:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 670be6d6-0444-4ecd-be57-dd7dfe2b54fa, 'Mes enfants ont adoré, j''ai rajouté un peu de lait (200 ml) sinon, rien à dire, vraiment excellent.', '2019-05-12T07:25:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 9bac2af7-ebf2-4740-8d90-d7318a4dfd02, 'Cuit en cocotte au four : cela rallonge juste le temps de cuisson pour un rendu moelleux sans croûte', '2019-03-15T12:57:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 1995bfcf-e99a-447e-bfff-49429f45f949, 'Moi qui ne suis pas fan des gâteaux sans chocolat, celui-ci m''a bluffé ! Il est simplement à tomber, tout le monde chez moi a adoré, merci !', '2019-02-04T06:19:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 85f08ce2-60f8-4826-959a-f97dc53713f9, 'Très moelleux avec 2 bananes et 3 pommes. 100 g de sucre ont suffit. Par contre ajout de lait dans la pâte.', '2018-11-11T00:27:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, ff3e3819-9625-4380-ab78-05f70a67a4b5, 'Il a fait un malheur auprès de mon copain à refaire sans hésitation !', '2018-09-20T09:50:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 1c36750d-e1da-4730-97fb-ba85c6c7bbf4, 'Grand succès chez nous! Même ma fille qui est tres difficile avec les gâteaux aux fruits a adoré! J ai juste rajouté un peu de lait, mis uniquement 100gr de sucre et 1h de cuisson!', '2018-04-23T11:51:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 9273e3b4-3637-43dc-8c10-70608590a865, 'Peu compact au début mais finalement le cake est excellent. J''ai ajouté des noix.', '2017-11-04T14:26:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 11d4ea60-3051-4b21-922d-ef03784b0320, 'Un cake parfait, moelleux, aéré... J''ai mit 150g de sucre pour qu''il soit moins fade, 5ml de lait et le tour était joué ! Je valide cette recette marmiton, tout le monde s''est régalé.', '2017-11-01T21:57:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 91da8c83-930e-41a1-9850-650680d76d3d, 'Très bon. J''ai mis une pomme et une banane, un vrai plaisir.', '2017-10-25T22:35:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 8f4e9d29-1a8f-49ae-a8de-22fdfa003a25, 'Bon gateau. Un peux fade en gout et j''ai du rajouté un peu de lait. On devrait le dire dans la recette mais sans dose comme ça, tout le monde peux choisir si il en veux ou pas.', '2017-06-02T09:21:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 335f89be-5fdd-44a8-bc88-5e77c7336a61, 'Excellent. Testé avec pommes, bananes et noix. j''ai ajouté 5 ml de lait mais finalement pas sûr que ce soit utile même si au début la pâte semble assez épaisse. je réessayerai sans.', '2017-05-26T23:10:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, ac344c73-2697-4c70-af94-733c1fbc1c9d, 'Tres bonne recette. Pas besoin d''ajouter du lait si on ajoute progressivement la farine. Je l''ai ajouté en 4 fois. Gateau tres moelleux. A refaire', '2017-05-21T22:06:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 8e9fd5cf-a336-4c06-a700-dec2d5cffea9, 'Très bon et moelleux!', '2017-05-08T20:25:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, b41daaf3-a4fd-44cd-95d1-3b3c3238affc, 'Gâteau succulent ! J''ai mis les trois : pommes, bananes et noix. Hyper moelleux. On s''est bien régalé. Je l''ai gardé 5 jours, pour le petit déjeuner.', '2017-03-22T17:44:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, d57f6030-5ed3-4725-9c70-d3766ae683e7, 'Super bon et moelleux! Avec les bananes, pommes et noix, ce gâteau a eu un énorme succès!', '2016-12-18T11:13:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, e498afba-d3a1-455d-8fb7-a5c47a912ac9, 'Hummmm j''adore', '2016-11-22T17:22:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 9d25941b-fc97-4399-ac2d-d177f860823f, 'Super bon, toute la famille l''a adoré. J''ai aussi ajouté un peu de lait. Trop trop bon', '2016-10-17T22:44:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 74468bf4-a6bf-43a7-a39a-7de2728e3a13, 'Je trouvais intéressante cette recette de cake pas trop grasse ni sucrée mais je suis déçue par le goût assez fade...', '2016-08-11T22:13:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 9e7d8171-4d95-4c6b-bc42-8417531758ef, 'Super recette, mais bien calante !!', '2016-06-24T14:46:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 5718f2d7-4301-4cc7-ac5a-03a7b09d398c, 'Superbe recette!! Et pourtant je ne suis pas pâtissière, cake ultra moelleux gourmand... un délice à tester absolument par contre il faut ajouter un peu de lait à la pâte.', '2016-06-11T22:20:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 505943f7-6232-4e99-ae79-395113d3752e, 'J''ai dû ajouter une assez grande quantité de lait (d''amande) pour obtenir une pâte onctueuse. Après les 100 premiers grammes de farine, la pâte était tellement sèche et craquelée que j''ai dû improviser. J''ai cru avoir loupé une ligne dans la recette, mais non. Avec cet ajout, le résultat était délicieux ! ', '2016-06-08T11:29:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 84df5c29-5c0c-43f9-b2d8-0c43ff328e80, 'Je n''avais que 2 oeufs dans le frigo, alors j''ai choisi cette recette. Je ne suis pas déçu, moelleux au coeur et croûte craquante. Je suis gourmande alors j''ai ajouté juste des pépites de chocolat. Trop trop bon.', '2016-05-23T19:06:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 7fdec43b-d2c3-48e3-8f40-713c6f1443f2, 'Recette facile, validée à la maison, gâteau très bon, moelleux, moi je l’ai mis à 180 et après 25 /30 minutes j’ai vérifié avec un petit pic en bois, nickel, merci pour cette recette facile ', '2024-03-10T10:49:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 0fc2dc44-9583-40cb-9266-1e8fb2df0776, 'Très bon gâteau !', '2024-03-05T16:15:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 97a27993-b3dd-48c8-9cf3-9b1a5d3f39cb, 'J’ai monté les œufs en neige et n’ai pas mis de levure chimique. Pour remplacer l’huile, j’ai choisi de mettre 25g de beurre. Un peu trop de sucre (recette faite après la mise à jour du dosage). Délicieux. 
Merci pour cette recette. ', '2023-11-04T20:50:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 22f40a53-4a85-4ff7-bc16-62b9cdaaaedc, 'Avec moins de sucre, 70 g pour moi, un peu de rhum et de cannelle c''est parfait. Merci.', '2018-10-24T09:07:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 04db64aa-e37d-4a2a-96c7-bd7e1e4a78a8, 'Pour ma part, je mets 100g de sucre, 4 pommes, je remplace l''huile par 100g de beurre, 1 sachet de levure chimique et c''est un véritable délice !! Tout le monde adooore cette recette !! J''ai fait la même recette avec des poires et c''est juste "wahouuu" !! À refaire !!!', '2019-03-17T08:45:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, e9c37b7f-eb97-4af3-bc4d-e184c2120a9d, 'Très bonne recette, j''ai juste apporté ma touche perso, j''ai mis du rhum et de la cannelle. 25 minutes de cuisson à four chaleur tournante.', '2019-05-15T16:32:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 12a2a9ea-5186-4c22-8b3c-7d2721ff2a7d, 'J''ai mis moitié farine/moitié maïzena, 50g de sucre, 70g de beurre au lieu de l''huile et 1 poire + 1 pomme. Très bon', '2019-04-26T12:19:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, d9768cbf-9155-4dcd-88c9-887997915099, 'Super gâteau !! J''ai personnellement ajouté une pomme en plus et saupoudré de cannelle avant cuisson. Un régal merci.', '2018-12-18T02:22:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 498d04cf-a3a5-44ec-acae-d084a95cc540, 'Très bonne recette mais trop sucré à mon goût. Je l''ai refaite avec 60 g de sucre : parfait.
Testé aussi avec de la cannelle ou de la fleur d''oranger. Délicieux.', '2018-07-25T03:31:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, b70823bb-8932-4dcb-8396-0a82090830cc, 'Fait pour 10 personnes, j''ai juste réduit la quantité de sucre et rajouté de la cannelle. Gâteau très moelleux, c''est un succès. ', '2023-11-04T21:35:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 3d5ba1ca-b648-449b-bf87-ece989a9d3ca, 'Très bonne recette, cependant j’ai réduit le sucre à 100g, j’ai aussi blanchis les œuf avec le sucre au préalable ainsi que remplacer l’huile par le lait pour un texture plus moelleuse 
', '2022-06-16T19:57:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 9eb8743b-5112-41f2-ab6e-81e136fca95c, 'J''ai mis moins de sucre (70 g) , un yaourt 0% et un bouchon de rhum. C''est un très bon gâteau.', '2018-11-18T11:29:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 8cf73c6f-8421-41ca-abc6-bed8b38f866e, 'Mettre 100 g de sucre et 80 g de beurre !', '2016-11-18T16:23:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 60274f1b-f564-4d9c-af9d-dc6a556ff88c, 'Bonjour très bonne recette je recommande. ', '2023-12-06T00:45:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 07fe2ed2-39cd-4104-96f2-31e1077804b6, 'Très bonne recette nous avons tous adoré seuls petits remarques: il ya trop de temps de cuisson mais gateau étaient très dorés et le termostat 5/6 n''est pas égale à 160°c mais à 180°c', '2023-11-15T17:42:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, bd5b93b1-34bd-4e81-84ed-8a30c27bc102, 'Excellent. J''ai monté les blancs en neige pour encore plus de légèreté.', '2023-11-01T10:50:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, e4a016ed-bc0d-40d7-b631-632a9ee37e86, 'Un régal, mais trop sucré. Je n''ai pas regardé les commentaires avant. Je vais le refaire avec moins de sucre car il est excellent et simple à réaliser. 😊', '2023-04-23T20:24:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, ff3db595-e597-4354-a861-4d21f90e88ca, 'Très bon gâteau aux pommes et super facile à faire. J''ai remplacé l''huile par 60 g de beurre.', '2022-05-28T11:15:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 7eb73c47-0676-4638-b7db-11b61556a626, 'Bon et facile. Fait avec 120g de sucre, 100g de beurre à la place de l''huile et des poires. Cuit dans un moule à cake une bonne heure. Je le referai.', '2021-10-25T20:06:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 7377dae3-38ef-4ebe-bf76-48d7eafacaa7, 'Je rajoute 100 g de beurre.', '2018-12-09T13:09:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 6e0fe3bd-4d5e-4b69-9109-d006a083bf1c, 'Excellente recette, attention au sucre en effet j''ai mit que 100g au lieu de 120g et ça suffit largement. J''ai ajouté une cuillère à café de fleur d''oranger !', '2018-05-18T11:29:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, fd1db319-b8fd-45f0-8f4b-66a0a3222512, 'J"ai remplacé le beurre par de la compote de pomme maison et diminué la quantité de sucre. Très bon et léger. Merci.', '2018-03-30T21:38:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 00e638f6-e513-47c1-b858-1be015c80306, 'super facile je l''ai aussi fait avec des cerises et un coulis de caramel sur le dessus', '2023-04-15T11:51:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 3f70b794-edf4-449d-ac7f-65b812338ee1, 'C’est devenu un classique du week-end. Il est parfait, souvent avec beaucoup plus de pommes qu’indiqué et parfois avec en plus des poires. Très fondant, à déguster tiède ou froid.', '2023-01-07T10:13:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, f42b97dd-9a9f-45ea-873c-98d1aa041e33, 'Très bon gâteau, j’ai juste mis 2 pommes et ajouté 15 min de cuisson.', '2022-12-31T17:31:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 8bef944c-290e-4707-bc24-d6e66e84e033, 'Bonne recette. Je la fais sans huile et à la place des pommes, je mets 100 g de pépites de chocolat et 3 bananes mûres en rondelles. Un délice, mais dommage, les bananes et pépites tombent au fond le temps de la cuisson.', '2022-12-23T11:16:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 7912afe5-a3ac-4876-a2c9-0eaf9e84fdb0, 'Excellent ! J’ai réalisé la recette pour 10 personnes, nous sommes 5 gourmands… Avec seulement 150 g de sucre, 2 sachets de levure et le même temps de cuisson. Gâteau pas trop sucré, très moelleux, un vrai délice. 
Je le recommande vivement ;)', '2022-12-11T17:30:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, fce87c55-f1cf-46ac-8808-defb05c7a5bd, 'Superbe, recette au top ! Le gâteau est juste délicieux. J’adore 🤩🤩♥️♥️♥️', '2022-11-27T17:54:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 5861d794-4446-4f11-83e9-486e6a3b6c9c, 'Punaise !!! Nous l''avons englouti. Très bonne recette. J''essaierai avec d''autres fruits pour voir.', '2022-11-24T01:23:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 08e7fe8d-9ece-4212-b0fb-e4e121a03888, 'Gâteau hyper simple. J''ai mis 100 g de sucre et j''ai réduit le temps de cuisson à 40 min en chaleur tournante 🔀🔅', '2022-11-23T16:18:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 9b6e8428-46a2-4fd5-95fd-ec90aad44b7b, 'J''ai fait plusieurs petits gâteaux !', '2022-11-21T21:24:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 40bb97ed-fe5c-4e61-9192-e37d49049a04, 'Super !! Très vite fait, avec 75 g de sucre, 1 sachet entier de levure et 100 g de beurre en remplacement de l''huile, et quelques pépites de chocolat parsemées avant de cuire, résultat parfait, dégusté encore tiède. Un excellent gâteau qui a fait l"unanimité. Merci pour cette recette, à refaire sans hésiter.', '2022-11-16T14:16:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 0e0f6987-4f78-4edb-a957-385a6c88dd86, 'Excellent gâteau j''ajoute une cuillère à café de miel et de la cannelle. Une tuerie ❤❤❤', '2022-11-09T13:41:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 0596ffcf-7f4f-4437-bc84-5bb1f9982721, 'Recette très simple et rapide ! J''ai juste ajouté une cuillère à café de cannelle pour ceux qui aiment :)', '2022-10-20T15:31:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, b1f740ac-d762-40bb-9b09-0bde5de97a74, 'Excellent ! Je diminue néanmoins la dose de sucre à 70 g et le temps de cuisson à 30 min. C''est largement suffisant.', '2022-09-17T08:54:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, e7cb5b3b-e8d4-46a9-be2a-7ed036749ac5, 'Délicieux, avec un peu de cannelle c''est parfait', '2022-07-03T14:40:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, ae69990a-c759-4460-88e6-16e57b7b08e9, 'Mon gâteau aux pommes préféré !', '2022-04-20T18:41:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 08a68892-bc8d-4ec1-a1d9-b610eacb9fb7, 'Parfait ! Tout le monde l’adore! Je mets juste plus de pommes 
', '2022-03-27T11:03:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, da6e8a6b-e5f1-4df5-b684-f53edbbe6e3e, 'Bon c''est mangeable, mais ceux de ma maman sont meilleurs, elle me dit qu''elle rajouterait du lait... Il n''a pas gonflé tout raplapla 😢', '2022-03-23T22:00:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 31c7ae87-bd2a-4466-a6ea-c6c428f9c19d, 'Super gâteau ! Nous nous sommes vraiment régalé ma famille et moi. Excellente recette.', '2022-01-22T08:28:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 7dabe184-eef7-4aa6-b4ce-1aeda22b3877, 'Je fais cuire les pommes à la poêle avec un peu de beurre et de la cannelle avant un régal', '2022-01-13T08:19:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, f0ce707f-20ab-4e68-8a8e-bb67db31e1d4, 'Super recette, merci. Le gâteau est délicieux. Je l''ai cuit à 180°', '2021-11-02T18:23:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, be7b4e6e-a731-4dc6-adea-5bfa7f91756f, 'Recette extra. J''ai étrenné mon épluche et vide-pommes, Super ! À refaire souvent car très rapide.', '2019-12-02T10:26:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, ca1fcc20-0603-4411-b749-f2b847f93989, 'Très bon ! J''ai remplacé l''huile par 75 grammes de beurre et ajouté de la cannelle.', '2019-10-28T09:30:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 13ff967b-852d-4de5-8f7d-1d28854bef95, 'Excellent ! J''ai remplacé l''huile par 60 de beurre demi sel fondu, mis 100g de sucre au lieu de 120, 2 petites pommes en plus, coupées en petits dés, et un oeuf en plus car ils étaient petits. Un régale ! A déguster avec une boule de glace vanille', '2019-10-05T13:57:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, c9f9f52c-6da1-4ca8-949b-19f137b7c158, 'Recette au top, pour ma part j''ai fait cuire mes pommes avec du sucre roux dans une poêle. Du coup, la cuisson au four était plus rapide : 15/20mn à surveiller en plantant un couteau dedans.', '2019-05-19T09:47:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, d89aa653-4745-4190-b471-792a2cc89da9, 'Super bon et moelleux. J''utilise de la cassonade (90 g) et je saupoudre d''un peu de sucre et cannelle sur le dessus avant d''enfourner. Très bonne recette !!', '2018-11-28T11:33:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 13ec4efd-1768-4b24-bedc-271704bb76b1, 'Très bonne recette. J''ai juste rajouté un peu plus de pommes et une grosse pincée de cannelle et c''est encore meilleur.', '2018-09-30T10:47:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 03209070-cc0e-4a2a-9044-1de38b63d8a3, 'Très bon j''ai remplacé l''huile par du beurre et mis un peu de rhum.', '2018-03-25T23:34:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 718efbe6-7c53-4444-b890-8ecb2be6d68d, 'Excellent ! J''ai remplacé l''huile par du beurre et j''ai rajouté des spéculos !', '2018-03-15T13:42:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 09157f58-81c2-45ba-a899-5e3b53dc6b52, 'Excellent ! Et très moelleux ', '2023-11-06T11:54:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 7510bd25-909b-4432-b030-e95f4c984b5e, 'Un succès à chaque fois pour toute la famille et un gâteau qui reste moelleux le lendemain ', '2023-10-22T18:25:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 15849e4e-c050-4559-990e-d40298656fda, 'Gâteau très bon, facile et rapide à réaliser. Pour 6 personnes, je n''ai mis que 80 grs de sucre et 3 grosses pommes reinettes.', '2023-10-19T19:19:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, ae6a6622-22d2-405a-a5b8-96c018448069, 'Trois pommes ce n''est pas assez, j''en mettreis 2 de plus ! ! !Mais il est très bon !', '2023-10-13T17:06:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 2c6cafe3-a165-4d80-b88a-bc32f4ab5231, 'Très facile à faire et très moelleux. J’ai ajouté du jus de citron frais sur les pommes en dés et un peu de cannelle dans la préparation. Délicieux!', '2023-10-09T13:55:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 0d5ce797-1294-47f6-8609-07ea9c23e8dc, 'tres tres bon les convives en redemandent', '2023-10-09T13:39:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 0501084e-fa48-4a64-ba39-dc480137a94c, 'Bien moelleux, très facile à faire. 
j’ai fais la recette pour 8 personnes au lieu de 6 pour éviter qu’il soit plat dans mon moule rond 26cm. 
Pour le sucre, j’ai mis 100g au lieu de 160g. 
Et huile de tournesol car j’ai pas de colza et ça fait bien l’affaire. 
Super gâteau, on s’est bien régalé ! 

Ps: j’ai ajouté cette recette dans mes favoris. Elle est top ! ', '2023-10-08T14:57:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, e8956b86-b773-4dc3-b5f1-a148a20d533e, 'Excellent! Rapide, efficace 👍🏽', '2023-08-02T16:34:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, d109afe9-26e4-4ae0-b73d-54342c7960b4, 'Rapide à réaliser et délicieux à déguster ! 
Voici ma version : 
J’ai mis 75 gr de sucre ( largement suffisant), j’ai parfumé les pommes à la cannelle, j’ai ajouté un yaourt grec (à la brebis) pour le moelleux et j’ai mis 2 cuillers à soupe d’huile d’olive (pas forcément utiles vu le yaourt grec).
Enfin j’ai nappé le dessus du gateau avec des éclats de pistache.
Je referai ce gâteau réalisé en moins de temps qu’il ne faut pour le dire et qui a été dévoré par mes amis.
', '2023-07-22T21:58:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13493, 1ab8a5bb-168f-4737-ba14-024555373508, 'Merci pour cette recette très facile à faire. J''ai suivi les conseils : j''ai mis 60g de beurre, 80 g de sucre, 2 grosses pommes rouges. J''ai rajouté de la cannelle, des noix et une lichette de rhum. Un régal ', '2023-05-21T12:03:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 3e3815be-7b09-4a11-be09-3080c4b60061, 'Une petite merveille, cette tarte réalisée avec une pâte sablée . Avant de déposer mes gariguettes sur leur lit de mascarpone, je les ai roulées dans quelques gouttes de sirop à la rose. Ce parfum subtil fait “chanter “les fraises. J’ai eu beaucoup de compliments, toutes générations confondues.', '2023-04-05T11:29:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 87567964-02e5-46f5-a7ed-ade86c34e217, 'Recette vraiment facile, légère et délicieuse ! J''ai ajouté, comme indiqué sur des commentaires, du zeste de citron, et une cuillère de yaourt nature pour aider à mousser le mascarpone qui était trop dense, compact, pour la marque achetée. Un régal !', '2022-10-17T20:53:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, febaec90-b6f9-44ab-9a4c-27086ecb1f0c, 'N aimant pas le mascarpone je le remplace par du fromage blanc , et je mets un peu d amandes en poudre c''est délicieux ', '2023-04-09T09:44:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, e2c418fd-d367-4678-a990-04fceecfe8f2, 'Cette tarte est délicieuse, voici mes modifications : je fais moi-même un pâte sablée, et pour la mousse mascarpone, je la mets au frigo plusieurs heures pour qu''elle prenne comme une mousse au chocolat et ensuite je garnis ma pâte avec la mousse et les fraises. ', '2014-07-05T14:03:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, e858f434-33bd-4868-bc81-2a1d389f87ea, 'Super simple a faire , pas trop sucrée au niveau de la crème …. Je recommande 🍓', '2022-02-11T22:32:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 1c2d1250-03b7-4701-8d24-9a74c6cedd5f, 'J''ai mon petit péché a chaque fois... la chantilly !!!!!!', '2021-03-27T18:16:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 9fe9b9fc-4edd-4532-a4a1-464b4f24731b, 'Excellente recette ! Ajouté un peu de zest de citron vert pour plus de fraîcheur ! Je referai l''année prochaine à la saison des fraises :)', '2022-08-21T14:10:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 9161e94d-c7e1-472e-9f11-72a2b560235e, 'J''ai mis un jaune d''oeuf avec la mascarpone et battu 2 blancs d''oeuf en neige. Ça fait plus de mousse et c''est très bon. J''ai fais une pâte sablée sans gluten. on s''est regalé', '2015-07-04T15:36:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 66e55dff-cd91-4440-b1cc-149f9a29d08a, 'Super recette pour ma part j''ai utilisé une brique de crème fraîche au mascarpone que j''ai battu en chantilly avec un peu de sucre, un régal et c''est plus léger. ', '2015-06-12T22:37:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 4dca7764-6fc6-42b2-81bc-c09f2c9e6eb1, 'Moi je l''ai fait mais j''ai trouvé qu''il n''y avait pas assez de crème donc j''ai ajouté 1 deuxième paquet de mascarpone et j''ai fait 1 coulis de fraise que j''ai mi sur la tarte et le reste que je vais servir avec. ', '2015-05-08T01:12:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 0fd67318-fe96-494d-bf38-caf38cbfc742, 'Pâte sablée maison, 400g de mascarpone, 2 blanc d''oeuf en neige, de l''extrait de vanille et plus de fraise. j''ai donc maintenant la recette idéale de la tarte aux fraises ! Elle a eu un succès fou !', '2013-06-24T14:17:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, dc9e0845-0940-4451-8e6a-08087695e6cf, 'Pour 6 personnes, j''ai mis 700 g de fraises coup ça en deux . 
Et j''ai rajouté des framboises et de la noix de coco râpée. 
Unanimité autour de la table et effectivement très légère ! 
', '2022-06-26T22:42:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, f5d26a5c-fee0-4c27-839d-548c1d978773, 'Avec des zestes de citron vert dans la crème au mascarpone, c''est encore meilleur! se marie également très bien avec une mangue.', '2015-06-06T13:50:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 7a9cb8dc-2f0f-440d-991d-e211de240a7b, 'Excellente tarte, très légère, je l''ai faite avec une pâte sablée.', '2013-06-24T00:59:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, a39b30d0-5954-4382-a1f6-6dd97427b384, 'Très bon 

