INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, fbe525d9-7812-4062-85a5-5c66bc3fc310, 'Tres bonne recette si on diminue vraiment le sucre enlever au moins 100g (50g pour la cuisson des pommes et 50-75 gr pour la pate suffisent largement)', '2021-03-15T23:45:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 4c768952-33c6-4c83-83cd-96b4492f9198, 'Cuit 25 minutes au thermostat 8 comme indiqué, le crumble a cramé. Mauvaises indications de cuisson. ', '2021-03-12T20:33:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 4cabb3d1-1890-41f9-9594-f5f12222f9ab, 'Je mets du sucre roux beaucoup loins sucré.  Et autant de beurre que de farine, aussi une pincee de sel. Sinon d''accord avec la glace vanille,  un vrai régal....
', '2021-02-27T20:01:19+01:00');
