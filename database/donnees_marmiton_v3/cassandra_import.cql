INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, 421809fd-147f-4ec0-bde1-b7361bd51925, 'Très bonne recette mais 200 g de chocolat un peu trop écœurant. La prochaine fois je n''en mettrai que la moitié. ', '2015-02-15T12:47:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, 1bbe1528-ce85-4460-869c-97fe6ff45cab, 'Vraiment simple à réaliser et nous nous sommes même laissés tenté par des plus gros morceaux de chocolat pour plus de coulant ! Mon copain a adoré !!', '2015-02-15T01:43:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, bc6dd8be-0b76-4ec3-8395-9e6f1f6995ee, 'Très déçu parce que très sec. Je préfère avec de la pomme et sans le chocolat.', '2015-02-15T00:22:12+01:00');
