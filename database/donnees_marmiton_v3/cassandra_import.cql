INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 9d27b7e5-6240-43dc-9525-3f89bf98716a, 'Miam ! Parfait ! Et idéal pour utiliser les bananes un peu trop mures. Bravo excellente recette.', '2023-10-03T02:27:09+02:00');
