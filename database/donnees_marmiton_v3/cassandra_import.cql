INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, b098b2e2-9af8-4e9e-aee8-5939069ad64f, 'Très bonne recette. Rien à dire', '2022-04-15T11:05:23+02:00');
