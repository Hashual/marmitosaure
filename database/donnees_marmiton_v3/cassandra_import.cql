INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 0375af87-eb32-406d-86bd-f82617692f3c, 'J’ai adoré je recommande ce smoothie j’adore 5 étoiles👏', '2022-02-27T15:34:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 07cd3c2f-7031-4479-a86e-4650f03bc354, 'C''est bien dosé et c''est bien frais... Je le referai volontiers', '2021-08-23T17:22:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 05c4557e-fa6e-41c2-ac58-4996a7dcefaf, 'Super bon', '2021-08-14T15:24:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 7e2c2e1f-8aff-4fe7-a6c4-02cb7464bf69, 'Vraiment la meilleur recette de smoothie au monde !  !  !  !  !  !  ! Avec des fraises du jardin c''est meilleur', '2020-05-08T13:56:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 46fd067e-5357-4613-81d9-20693dac95bb, 'Très très bon et facile à réaliser, avec des fraises surgelées pas besoin de glaçon :) ', '2020-04-25T18:24:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 30818b05-f477-488f-9a0f-5e20e5a2235c, 'Super dessert.
Il faut le servir bien frais et c''est excellent. ', '2020-04-24T19:32:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 82e45b3b-67be-4385-a183-f29268600a96, 'super', '2020-04-17T14:20:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 804fc670-475f-4ab3-bdd9-b3c80db15053, 'Très bon ', '2020-04-15T23:33:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 331ebf8b-817b-440a-9cb1-4a9c3d0f7af9, 'Très bien, merci.', '2020-03-20T22:15:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, a4c2c61b-fad2-4bfd-b4a9-fd9307898ace, 'Avec des fraises surgelées, pas besoin de glaçons. Quelques gouttes de citron et 2 bananes. Super bon. Merci Marmiton.', '2019-07-10T14:06:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, cec0d108-31ca-4d81-9261-de2173f42230, 'Trop bon et succulent', '2019-07-09T14:25:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 7b24ec18-c766-4edd-81c2-9dc58d3a0894, ' c''est bon. ', '2019-05-18T09:04:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, a8d52344-e2b4-4b2e-8e0e-5a1648a0cd2a, 'très bon, mais pour mieux sentir tous les ingrédient, j''ai mis 2 bananes pour 250 grammes de fraises et 3 glaçons, et un peu de sucre après avoir gouté, car mes fraises n''étaient pas assez sucrée', '2019-05-13T10:05:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 5c251d1d-930c-49a2-82ef-165e4088f040, 'Tout le monde a adoré. Merci beaucoup.', '2018-06-08T11:14:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, a07f982d-8cae-4756-a1dd-a7d1ae99a296, 'Les proportions ne sont pas terribles.  On ne sent pas les fraises et il y a trop de glaçons qui rendent le smoothie peu onctueux. Pourtant l''idée est bonne car l''association bananes fraises est parfaite', '2018-05-21T07:31:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 5ed856cf-2515-46d4-ad3b-977c8e0261a2, 'Merci beaucoup pour cette très bonne recette ! Je l''ai un petit peu retouchée car je ne sentais pas assez la banane et que les fraises étaient trop acides. Du coup, 3 bananes pour 500g de fraises, un petit peu de lait et une touche de cassonade belge. Merci encore ! ^^', '2017-10-04T16:39:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, a6d1c136-8740-48dd-8193-5572efc80c4c, 'Trop peu pour 4 !!!! Mmmmm.... on en redemande tellement c''est bon !!! ', '2017-06-04T19:31:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 1e7e64ea-e971-437a-a9ac-f90731419965, 'Très bon sans sucre !!! 1er smoothie réussi Merci marmiton ', '2017-05-17T18:56:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 72f19ade-a953-4b52-b443-9f299887fab8, 'Très facile à réaliser, on dirait qu''on mange un nuage... à la fraise ! Avec une pointe de citron et quelques feuilles de menthe, c''est parfait !', '2016-05-29T17:11:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 0982e54b-4ccb-4605-97ce-f75670ef1fce, 'Super bon et rafraîchissant.', '2016-04-17T18:52:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 9ad1fc66-3a15-48f0-b601-8deceaac5255, 'Très simple et très bon !', '2015-09-08T18:52:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 6933a7c8-e7ce-45c0-9cd5-d9421555571e, 'Délicieux mais avec une petite boule de glace cela rapporte fraîcheur et douceurs !', '2015-06-08T23:23:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 5e33370d-d40c-4e56-b934-627fa72709f3, 'Que c''est bon, même trop bon et si simple, à faire vite avant qu''il n''y ait plus de fraises sur les étals ', '2015-06-07T20:15:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, b9f78d0a-b2f7-4116-87c2-a6e466319d91, 'Avec trois gros glaçons c''est parfait.', '2015-04-10T19:02:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 2ff0de86-021f-4d18-af1e-8923ab4e3c58, 'Très bon aussi sans banane et avec du sucre vanillé.', '2015-03-06T00:38:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 947105f5-186c-4e58-a065-6f1a2822cbd1, 'Super bon !', '2014-12-21T09:13:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, f80b1e94-07c6-46aa-a9ee-ba09c0b6f526, 'Parfait !!', '2014-07-03T14:25:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 836dd0b8-0319-4181-a412-6b1fcfbba477, 'Très frais, rafraîchissant, on adore !', '2014-06-05T23:48:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 4b8f02f5-7ea3-418c-9d24-06b7ec7d53ba, 'I love smoothie ! Je viens de le faire c''est un délice !', '2014-05-31T12:04:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 15af06be-0540-4dbc-8690-cb949bd0f714, 'Vous pouvez aussi mettre une orange à la place de la banane, cela donne un petit goût très sympa !!!', '2014-05-24T11:33:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 4fce48eb-2276-4751-9a1c-b1cdf95797ef, 'I love It !', '2014-05-01T12:56:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 26ed9c5d-5212-4607-8f7e-4aa7e9d2ec9d, 'Très bonne recette, je viens de la faire à l''instant ! Très vitaminée, parfaite juste avant une séance de sport ', '2014-03-28T18:54:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 2872f856-8520-4de5-8e05-a54b322af62d, 'Un concentré de fraîcheur et de vitamines !!! Merci pour cette recette très simple et très facile à faire !!!', '2013-04-18T16:50:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 23559548-57ac-4b15-91b0-6bc89b3ab604, 'Une excellente recette !!! Je la referai avec plaisir.', '2013-03-17T20:46:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 4a1f7fbb-43cf-4ad5-88e7-19d213e61df8, 'Excellente recette !! A consommer sans  modération !', '2012-05-20T20:40:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, db02c0d8-ec3c-4eb4-81ce-a2adcd01d80b, 'Merci pour cette recette facile et très bonne ! A refaire... ', '2011-10-15T16:18:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, db6266cc-42fa-4b55-ab0c-08731ad72be7, 'Frais, délicieux, tout ce qui faut pour un été réussi !!!', '2011-08-02T18:46:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 3376c9ed-1261-42f6-a32d-9a1526807802, 'Parfait', '2011-07-18T23:12:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 40c7767a-5b49-450d-86c8-7e2c663fd945, 'J''ai mis 500 g de fraises, un sachet de sucre vanillé et une banane. J''ai pu servir 2 mugs remplis. Excellent, c''est facile à faire et en plus on se régale.', '2011-04-06T15:50:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72189, 07bbe0ca-ff90-4325-95a9-b9a989ab5b7c, 'Délicieux ! Par contre, je n''ai pas mis la banane. Tout le monde a adoré !!!', '2010-04-10T18:07:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51116, 7e548eb4-8c4b-4083-9e35-7f19a8302a11, 'Tout simplement FORMIDABLE ! (Excepté la présentation un peu "écrasée"). Un vrai bonheur en bouche !!!', '2009-06-27T16:01:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51116, 68e6b942-49e5-4a16-88dc-f343b0cf4828, 'Excellent, ma petite touche personnelle, un carreau de chocolat noir, avant de mettre le caramel. Trop bon.', '2008-04-28T18:44:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51116, a369d36e-1d19-49fd-9c9f-81b5b9a63dd9, 'Ca a l''avantage d''être rapide et bon mais ce n''est pas très joli à présenter. A la sortie du micro ondes, j''avais de la purée de bananes coco-caramelisée.', '2007-03-17T22:51:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51116, 55073f48-fdda-4f2d-af2a-c00aeea63776, 'Trop bon....!!!! J''ai rajouté avant de fermer les papillotes quelques gouttes de Malibu...un délice!', '2007-01-29T18:12:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51116, 52120052-96e4-4813-8200-abeee46a74dc, 'Rapide, simple et bon.', '2006-11-23T12:07:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, e4309b5f-e41b-4a1a-b80d-18d59b36bee9, 'Super gâteau, j''ai mis le jus de deux citrons avec le zeste et 50 g de chocolat fondu.
Il était tellement bon, il n''a pas fait la journée. Merci pour cette recette.', '2022-06-08T19:49:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 1b84dcdb-deff-4c83-9f97-ae225c87f776, 'Recette délicieuse. Par contre, j''ai remplacé l''huile par du beurre fondu, c''est meilleur.  La prochaine fois, je ferais une couche de chocolat, citron, chocolat, citron, chocolat.  Je la referai, c''est sûr', '2014-04-10T20:20:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 19b35981-ce0f-4aee-8c51-58c397744ee2, 'Très bon gâteau !', '2016-12-19T17:51:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 2f948a69-57a6-4e31-8df2-711237c67324, 'J''aime beaucoup je viens de tester cette recette elle est démentielle. ', '2016-12-18T19:23:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 40fc4276-23d5-4ff4-b760-51a6e0554913, 'Ce classique revisité est très facile à faire et délicieux. Les goûts citron et chocolat vont très bien ensemble. Et j''ai effectivement mis 250 gr de farine et 150 gr de sucre, un jus de citron et 60 gr de chocolat noir corsé fondu plutôt que du banania. Délicieux. Le temps de cuisson est parfait et le résultat joli pour les yeux, bon au goût. Par contre je mettrai du beurre la prochaine fois plutôt que de l''huile. Mais ceci reste un goût personnel.', '2013-05-09T13:44:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 2497237b-8fd9-480a-9f73-ec1e84ca641d, 'Moyen. J''ai mis du chocolat fondu. Le gâteau est assez sec et la partie chocolat a pris le dessus sur la partie citron pourtant j''ai bien partagé en 2 parties. Donc on ne sent pas le citron. ', '2013-02-06T12:45:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 879f9cda-8256-40c2-ba92-eb8621ccab41, 'ATTENTION!!!!! A ne pas faire, ça n''a pas de goût. Allez en voir une autre sans tester celle-ci, c''est sur, je ne la referais jamais: même avec de la pâte à tartiner dessus c''est mauvais... Sérieusement, avant de mettre des recettes sur marmiton il faudrait que les gens les essaient. Si vous n''aimez pas la personne qui vient manger chez vous, faites lui ce gâteau, vous serez sur que jamais vous n''aurez à l''inviter de nouveau.', '2013-02-03T10:22:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, ddbb64ab-84fc-4977-a8e0-b8ccd16c6aef, 'J''avais lu les commentaires... et j''en ai tenu compte pour les modifications (jus d''orange à la place du citron, chocolat à pâtisser à la place du chocolat en poudre, rajout de farine pour épaissir la préparation côté orange...). Bref, un gâteau hyper simple à faire mais qui a cuit, cuit, cuit très longtemps et qui a eu une consistance très bizarre pour la partie basse (genre flan très dur !). Verdict : je ne le garde pas dans mes recettes car on ne sent absolument pas l''orange et la texture est trop particulière.', '2012-03-22T20:33:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 7928a09b-0dfa-486a-8939-b10712ec4d23, 'Voilà, j''ai suivi la recette et le résultat nickel, les filles étaient contentes. PS : j''ai mis moins de sucre.', '2012-02-01T12:54:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, a85d829a-1169-4a80-81a7-07776f89127c, 'Pour ma part, j''ai testé cette recette en y apportant quelques modifications ! Je n''ai pas mis de citron, le mélange me paraissait bizarre ! A la place du banania, j''ai mis du vrai chocolat que j''ai fait fondre au micro-ondes avec 5 cl de lait, et au lieu de mettre 300 g de farine je n''en ai mis 250 g, le gâteau est plus fondant et pareil pour le sucre j''ai mis 150 g au lieu de 200 g ! Le gâteau est excellent ! Essayez comme ça et vous verrez !', '2011-09-24T16:41:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, f2c63914-20f6-4263-82b7-fb9dbbf03411, 'Pour la partie chocolatée, il faudrait faire fondre du vrai chocolat pour donner plus de goût.', '2011-09-15T22:01:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, c727dfbc-0d59-49ba-89a6-e9fafffd0c54, 'Le résultat visuel est excellent, mais le banania n''est pas assez "fort" et le goût est un peu fade. Je réessayerai avec du cacao en poudre plus corsé.', '2011-05-28T16:38:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 66d4c259-68d1-4e41-9e83-7a5c47b9124b, 'J''ai mis 50 g de chocolat noir fondu avec un peu de lait et un gros citron avec pulpe. La pâte au chocolat étant plus compact, j''ai ajouté du lait pour la liquéfier un peu. La cuisson était un peu plus longue + 10 min à 200°C. Le résultat est sympa, l''effet marbré était très réussi. Je pense qu''en remplaçant le jus de citron par le jus d''orange ça doit aussi être très bon. ', '2011-05-25T17:26:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, fb440b3f-eca3-4fca-b31d-3857704619cb, 'Mes enfants et mon compagnon n''ont pas aimé. Pour ma part, le citron je ne trouve pas que ce soit une bonne idée. J''étais très déçue car la recette me semblait simple et rapide... Mais pas terrible. Tant pis ! Merci quand même.', '2011-05-23T11:03:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 119bb824-bd6f-483c-ba77-246f6057762c, 'Je pense qu''il vaut mieux mettre du beurre que de l''huile, car l''huile donne un goût de cake salé plutôt que sucré. Pas terrible.', '2011-05-18T16:10:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 6b76c2c1-fe3c-40be-874e-b737027fbb46, 'Au lieu de faire fondre le chocolat, je l''ai râpé grossièrement. Bonne recette. C''était très bon. ', '2011-02-07T13:15:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 889c34c5-5a66-4cc1-bad2-c95a7a1205f3, 'Je ne pense pas avoir manqué une étape et pourtant, la pâte au citron est beaucoup plus liquide que celle au chocolat. Résultat : je me retrouve avec tout le chocolat concentré au milieu, au lieu de rester en différentes couches. Enfin à part ça, le gout reste sympa.', '2010-03-30T09:12:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, ebf91795-4d8c-484a-be0b-aa70ebf379a5, 'J''ai essayé cette recette en ne mettant pas de citron. Je dois vous avouer qu''elle est excellente. Les proportions sont bonnes et le gâteau reste moelleux même 2 jours après sa conception. Merci !', '2010-02-16T11:58:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 678e4dc6-9ae3-4c2a-b85d-3b64e3234b2b, 'J''ai peut être loupé quelque chose!. Quoi qu''il en soit je ne le referai pas. Le citron rend un goût amer mais le gâteau est moelleux.', '2009-12-28T21:36:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 9dbaa4b7-5095-48bf-a407-705ecd2f55cd, 'Bonne recette, on sent bien le goût du citron contrairement à d''autres ! Par contre, la pâte est très liquide, il faut ajouter + de farine surtout dans la pâte citron !!! ', '2009-08-28T19:06:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 3aad86c9-721d-48b0-a23b-f1921b1e2f85, 'Moi je trouve cette recette superbe ! D''ailleurs je l''ai mise dans mes favoris et en plus je trouve que ce gâteau n''est pas coûteux du tout !! Et c''est quand même meilleur que d''acheter en magasin ! Car vu le temps que l''on fait pour le faire franchement faut pas se priver ! Et c''est tellement mieux de dire que c''est nous même qui l''avons fait ! Mais j''avais essayé avec du chocolat fondu mais ça ne donne pas le même résultat ! Donc moi je me fis maintenant à cette recette  ', '2009-04-07T13:36:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 7f3d9c23-435a-4421-b874-2c48e3fc50dc, 'La consistance est parfaite, le rhum ajoute un petit goût. Peut-être que du vrai chocolat à la place donnerait plus de parfum et de goût ? En tout cas merci pour cette recette ! ', '2008-12-08T00:00:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, a6384adf-accc-4a8a-adc5-e73bac2ac16c, 'Ayant perdu ma fameuse recette de marbré, j''ai utilisé celle-ci et j''ai juste modifié l''essentiel, le chocolat!! Puriste et ne considérant pas le chocolat en poudre comme un vrai chocolat, j''ai preferé faire fondre 100 g de chocolat dessert dans un fond de lait, et j''ai dû moi aussi rajouter un peu de lait dans la pâte choc pour avoir la même consistance que celle au citron. Sinon, les proportions sont parfaites!', '2008-10-10T20:04:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, cf1e590a-7ca9-47f2-ba75-bced05bfe111, 'Délicieux ! A refaire bientôt, tout le monde a aimé. Par contre j''ai eu un peu de mal à faire le marbrage à cause du citron trop liquide... Mais sinon rien à redire !', '2008-05-03T21:58:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, c505ec8a-833a-421b-af23-ae486e45b75e, 'Très bonne recette. Juste un petit problème de consistance entre le citron et le chocolat. Pour y remédier, la première fois j''ai rajouté de la farine. La deuxième fois j''ai utilisé du jus de citron concentré. Et avec des pépites de chocolat entre les marbrures, c''est encore meilleure. Demain je l''essaye dans des moules individuels.', '2008-02-27T19:37:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, d07d0668-ecf9-4be1-8293-b3409c2da8e3, 'Très beau marbré ; moi non plus je n''ai pas mis le rhum et ce fut très bon.', '2007-12-20T16:04:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 2e9999a6-2757-4637-919e-19c0ad75f9bb, 'J''ai préparé ce gâteau et l''ai fait goûter, tout le monde m''a dit qu''il était très moëlleux et à refaire. Merci pour la recette.', '2007-10-23T14:28:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, 63a86acb-3506-49d7-a8b3-f802bd87b2ba, 'Rapide et délicieuse cette recette de marbré. J''ai battu les blancs en neige pour que le gâteau monte bien et c''était parfait!', '2007-07-29T17:42:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, d22d7c2f-32cf-45bb-8b37-973ff0bca453, 'Très bon et facile à faire. Le citron va très bien avec le chocolat. Par contre je n''ai pas mis de rhum je trouvais qu''il y avait assez de goûts différents. ', '2007-06-26T13:30:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46598, b4b3caf7-7741-4ad5-9a9a-0a59d2631545, 'Ultra moëlleux ! A refaire. Je dirais que c''est plutôt pour 6 personnes. ', '2007-05-03T17:42:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, d2ce767f-a2ab-46ac-ad1b-5d4fb521a872, 'Fait avec du cacao non sucré et une touche de sucralose et de lait écrémé. Ma minute de plaisir sans être troooop coupable !', '2021-06-18T14:24:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, 84923063-8a33-4179-b759-6037d3079bce, 'J’adore c’est devenue un rituel tout les matins je me fait un petit smoothie. Je conseille. Gros coup de cœur sur cette recette ', '2021-05-23T14:59:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, 5ac8439a-3534-4684-a159-94ef2439d373, 'Super ma fille et moi avons beaucoup aimé !', '2022-11-02T16:39:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, 62ec6f74-a990-4915-a935-88f13b1195b5, 'Vrai régal ✨️✨️', '2022-07-04T20:20:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, 495c7bfd-4266-4da1-bcf5-c00ede55eada, 'Ça marche pas du tout', '2021-06-28T17:04:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, d1652268-d414-4a2e-a8d5-17b23368e45c, 'Délicieux ? ', '2021-01-27T12:17:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, 8e3edd7b-2254-4e84-b607-5749f413e07b, 'Très bon pour la première fois ', '2020-05-05T02:47:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, f0a82995-4206-4edb-8857-5b971df1362d, 'Je n''ai pas aimé.', '2016-08-01T19:54:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, 988fca4c-db77-4750-b240-6c9486c644bb, 'Délicieux !', '2015-10-20T20:43:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, d0b11658-44fe-47c3-8ae8-bb94f52e6e90, 'Simple et bon ! Que demander de mieux ?!', '2014-08-19T18:22:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, bb4bf99b-d50d-4bab-aca5-d30cb23fb64a, 'Moi non plus j''ai pas aimé le goût ! j''ai ajouté une cuillère de miel mais en vain.. déçu', '2012-04-19T20:49:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, 3b64e4ee-3f65-4370-a310-7ef8f6f938cb, 'Très bon smoothie un goût de trop peu !', '2011-09-06T19:48:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, 49838479-84fa-4fa1-977d-4eb8c216ea0f, 'Je n''ai pas apprécié le goût.  ', '2011-05-15T23:59:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, 0a2a3ec4-3b05-4fa9-99a3-436023620625, 'Premier smoothie réalisé, c''est vraiment un délice !!!!', '2011-05-09T18:40:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, 11d59fa3-21de-4698-9a7f-196fe4ae51f3, 'Bien... Avec une cuillère (ou 2) de miel... Excellent !', '2009-07-05T07:44:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, 859c113f-0191-4eca-980e-b52103d6c01c, 'Bon smoothie mon fils a aimé je recommencerai avec d''autres fruits.', '2009-01-23T19:48:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, 2f036156-b632-4797-9c12-2ddb73335c27, 'Ce smoothie a complètement répondu à mes exigences même s''il n''a pas fait l''unanimité au près de mes frères et sœurs =)', '2008-08-16T18:45:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, a79cab33-6237-4d74-bcd1-9b9db0e2db26, 'Les gourmands se régalent...Facile et très rapide à réaliser. ', '2008-07-27T20:13:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, 780ec471-6771-440f-a321-391d3d14efe0, 'Bonjour, moi au lieu des glaçons je mets de la glace à la vanille ou aromatisée.', '2008-07-13T22:18:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72513, b349cf63-98ea-4bb3-9eca-50a899a12f1f, 'Premier smoothie et premier succès auprès des enfants! Merci beaucoup!!!!!', '2008-07-05T19:00:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530543, fa45596f-5230-41ed-adf2-0f92860afaaa, 'On dirait plus un flan qu’un cake ...c’est tout dur à l’intérieur ça fait comme un flan. Résultat vraiment pas terrible. ', '2021-04-15T23:24:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530543, eac49226-7554-42f4-bce4-98333358f9f1, 'Vraiment extra, les enfants ont adoré !', '2022-10-25T00:10:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530543, 12bd042d-9ac7-44d6-844f-455e807e4250, 'Nul, mauvais, répugnant.
À l''intérieur quasi du flan.
À l''extérieur tout noir.
Malgré le suivi parfait de la recette, celle-ci est mauvaise, ce n''est que mon avis, mais c''est horrible, écœurant et de mauvais conseils.', '2022-02-28T17:35:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530543, 05bc0fed-c02e-46d7-8572-dd2295a95bd5, 'Excellent j''ai suivi exactement la recettes..Ce cake est moelleux+++un régal !!!', '2021-06-07T23:40:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530543, 8dd3e9b3-9bfb-4352-b674-41e4b902abf4, 'Très bon cake mais manque de cuisson ! J’ai mis 40 minutes à 200°C et il manque encore un peu. ', '2021-04-13T17:06:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20129, 8b6bd1d9-2c90-44b7-80ed-204288137a1a, 'A l''unanimité recette excellente. L''association de tous les composants est parfaite. A refaire à la prochaine occasion. Un grand merci. Bien à vous. Dandecazals. ', '2013-10-29T16:02:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20129, c96759cf-b67c-4851-a308-8ab6bf192d76, 'Autant j''aime l''association sucré salé, mais là, c''est simplement pas bon. je préfère un gratin d''endives au jambon mmmmmmm... c''est trop bon', '2009-03-25T18:15:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20129, e9df8245-b2cc-4f85-a1d0-bece7193d45e, 'Recette bien connue de mon mari belge!!! Il rajoute du paprika avec le mélange tomate-crème fraîche. ', '2008-09-06T17:45:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, bfe0eed3-1308-4996-8205-6a9b186f1fe4, '10 cl suffisent pour créer la base du sirop (sinon vous allez y passer des "plombes" pour rien). Je déconseille d''ajouter à cette base la cannelle et le gingembre qui seront dénaturés par une longue chauffe. Au final, ça déchire !', '2019-06-18T17:36:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 85018908-d5fa-48b8-bf72-7e7266d43136, 'Une TUERIE !! La 1ère fois, ça a été très long de faire évaporer l''eau pour obtenir un sirop bien nappant, la seconde j''ai mis que 5 cl d''eau pour gagner du temps. Pour la vanille, j''ai triché en mettant de l''arôme. Pour le Rhum (attention détail qui tue) j''ai mis 15 cl de Rhum arrangé Isauthier "Banane Flambée". J''ai mis le rhum tôt pour faire évaporer l''alcool. Il ne reste que la note flambée qui déchire.', '2019-03-10T15:13:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 4b6bbaf9-957b-4357-8eb4-d5c24d6238a0, 'J''ai mis 500g de sucre pour 2 kg de bananes. Recette excellente, elle va a merveille dans un gateau roulé, dans des crêpes ou simplement sur des tartines. Merci pour la recette.', '2018-10-08T11:50:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 2c8a2498-bd6e-41f2-8f0b-ece42f228136, 'Recette superbe !!! J''adore ! Pareil, j''ai mis 300g de sucre (j''ai fait pour 500g de Bananes). C''est juste excellent, ça se mange à la petite cuillère... Miam ! ', '2018-09-18T12:24:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 7c1e4d70-bc21-475f-b9ed-6d10b8867048, 'Une tuerie !
Une de mes confitures préférée....
(J''ajoute juste un tout petit peu d''agar-agar et je mets du gingembre frais, rapé env. une cuillère à soupe)', '2017-06-20T15:18:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 762b5e62-62b9-4ad0-8171-054f8bca879e, 'Très bonne confiture ! Avec 1. 3kg de bananes (poids pelé) j''ai pu faire 6 pots dont un très grand. Pour ce poids j''ai mis 4 jus de citron vert, 800g de sucre cristal, 4 gousses de vanille, 30cl d''eau et 10cl de rhum ambré.
Une fois le sirop prêt (5min), il a fallu à peine 15 min pour que la confiture soit prise. Elle est excellente. J''avais mis des bananes Cavendish. ', '2021-01-23T21:04:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 7a2dbee5-1a33-421d-b356-cb5b1f9e1507, 'Je retrouve (enfin) la recette de ma confiture préférée que faisait ma Mamie. Comme elle, j''ai ajouté les zestes d''une orange et d''un citron avant de me servir de leur jus (donc pas de citrons verts). Un régal!! ', '2016-03-06T19:06:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 1966f902-884e-4a13-97e2-07c7b08bae1b, 'Tout simplement excellente ! Je ne mets que 600g de sucre et 20 cl d''eau par kilo de bananes. J''en refais sans arrêt  et  toute l''année... c''est divin !', '2015-09-07T22:55:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 4a0af41d-a223-4e7c-9761-c98ba3483e45, 'J''ai mis deux citrons jaunes à la place des verts et le rhum dans le sirop en début de cuisson pour que l''alcool s''évapore. Le résultat est excellent.', '2015-05-16T19:48:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 9cc1d9ec-d44d-45ea-b70d-da3683655a3e, 'Encore meilleur avec un peu moins de sucre (600g) et un seul citron vert. Je n''ai pas mis de gingembre (j''en avais pas) et j''ai mis le rhum pendant la cuisson + l''équivalent d''un bouchon juste avant la mise en pot. A refaire.', '2014-05-04T19:54:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, dc873a3d-f8df-4cf6-b92b-c22e31c7bf47, 'Un régal. Mais heureusement que j''avais lu les commentaires et mis moins de sucre (50%  par rapport au poids des bananes coupées) et 1dl d''eau seulement. Mon sirop a été rapidement à la bonne "consistance" en fin de cuisson (pour ne pas l''altérer)  plutôt que du gingembre en poudre j''ai mis environ 50g de gingembre confit recoupé très fin + le rhum...banane, gingembre, rhum c''est l''assemblage parfait!', '2023-09-07T07:55:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 0dadde01-d0e6-421b-a5bc-ac27bf8e339b, 'Délicieux, mais un peu trop liquide même en diminuant la quantité d’eau, obligée d’ajouter des feuilles de gélatine.', '2022-12-05T14:43:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, ef6295c2-3a5b-4bb8-b40e-34e717589a01, 'Dégustée ce matin avec une brioche et du beurre,  un régal : j''ai fait la quantité pour 2 pots avec 300 g de sucre, 1 cuillère à café de gingembre frais, 500 g de banane et le reste des ingrédients. Délicieux 😋', '2022-10-02T13:17:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, ca199e5b-e512-4058-9e10-f703a721106f, 'J''ai mis un peu moins d''eau et de sucre pour le sirop, des bananes très mûres et un peu de pommes et de kiwi. Excellent.', '2022-01-22T21:29:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 1c519795-2a11-46e8-a837-1bdc9d602f79, 'Je l’ai faite sans rhum. Excellent. ', '2021-04-24T16:34:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, aadc0c4b-a53e-4ec3-a0a7-447799d0de05, 'J''ai mis que 500g de sucre et il faudrait mettre aussi moins d''eau car trop pour obtenir la texture. Sinon super bon et évite de jetter des bananes limites pourries ;-) ', '2021-01-08T18:45:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, f73d0665-dbbf-4c7b-8120-e76e6df2abe2, '550 grammes de sucre suffisent et 1.5kilos de banane rendent la confiture moin liquide. Ci non tres bon', '2020-04-16T15:05:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 9aceadb1-aecc-4968-825b-86c8e4e4d5b3, 'Exquise !
', '2019-03-15T07:34:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, ffaae326-41af-4f93-833b-161ac46b8f21, 'Super ! On sent tous les ingrédients et le mélange est parfait. J''ai mis le rhum avec le sirop également. Merci pour cette recette !', '2018-09-17T05:32:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 9ba9ae60-b73f-4083-9071-9b369e15d515, 'Recette originale de confiture, excellent. J''ai également mis moins de sucre. ', '2015-11-25T08:44:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 081bda6a-ef3b-44ba-859c-77ca4f9bdec6, 'Excellent ! J''ai limité la quantité de sucre à 600 g. C''est largement suffisant avec des bananes très, très mures. Une autre version avec 2 citrons au lieu de 4 et sans rhum, elle a plus goût de banane, les enfants la préfèrent, moi j''aime les 2. Une 3ème version on remplace à poids égal, une partie de la banane par un ananas très mur, on laisse le rhum : sublime !', '2013-09-13T15:30:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, b8588f52-e6f5-42dc-af18-70e2cd1fe6cd, 'Délicieusement exquise, j''ai mis moins de sucre aussi et du gingembre frais, cette confiture nous fait voyager avec toutes ses saveurs subtiles.', '2010-10-13T22:36:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 4caacb71-ebb2-4638-8003-a6981211234c, 'Elle est délicieuse. On retrouve tous les arômes en bouche. Ma soeur qui n''est pas fan de bananes à adoré. Par contre j''ai modifié la quantité de sucre pour 500 g de bananes j''ai mis 200 g de sucre et j''ai mis le rhum au tout début pour faire le sirop. A refaire', '2009-04-25T10:10:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, d869a191-6176-437d-a0ef-856ae5df3ac5, 'Merci Anne pour cette bonne recette. Je l''ai faite avec 700 g de sucre pour 1kg 300 de fruit et par goût personnel, moins de vanille mais plus de gingembre. ', '2005-01-14T21:55:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, e16ee81b-5864-45d5-b5e0-d7e9b3ddd819, 'Délicieuse confiture où le citron vert transforme subtilement l''acidité de la banane cuite. Le bas prix de la banane compense aussi le coût de la vanille ! Pour faire joli, j''ai mis les gousses de vanille et les morceaux de bâton de cannelle dans les pots.', '2004-02-24T11:17:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 67744708-8290-457d-a318-003172c92ffd, 'J’ai contre balancé l’excès de sucre avec le citron pour avoir l’équilibre.
Sinon c’est un délice.', '2023-02-25T20:02:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 8532aadd-0b6d-4abd-8363-d57ee7eb15e3, 'Une tuerie ! Avec des bananes bien mûres,  les mêmes dosages en épices et en rhum,  c''est fabuleux... De surcroît, très simple et très rapide !', '2022-09-26T21:10:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 5531112c-6a98-410b-9bcc-6bd484009986, 'Excellente recette !', '2022-09-20T01:56:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, ed689ec5-179b-4e8f-b4e4-4f4113195b13, 'Déjà très bonne fraichement faite!! J''ai ajouté le zeste d''un citron dans la préparation et des pépites de chocolat dans 1 pot.', '2022-07-20T21:30:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, ad494e58-6afc-4d1a-8c8a-3e689da5f296, 'Alors là... je suis bluffée ! Cette confiture est tout simplement excellente ! J''ai mis un peu moins de sucre, 25 minutes de cuisson.', '2020-12-23T13:51:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, aa20970b-8f6b-48fa-ad09-7a9af852feea, 'Trop sucrée donc j''ai du rajouter 1cs de vinaigre, et il faudrait faire chauffer le rhum avec le reste
Sinon elle est bonne ^^', '2020-07-29T23:23:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 37d7d2fc-475b-4b55-b521-698f222d6146, 'Recette facile à réaliser, goûteuse et antigaspi !  Je m''en suis servi dans des beignets au levain un délice. ', '2020-05-01T21:10:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 57b02567-7e11-4ecc-bbdf-0616b9be4ce3, 'Cette confiture remporte toujours un grand succès.
', '2020-02-16T03:00:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 462efcde-2255-4d86-aaac-ff954fd9f06d, 'Tout le monde adore !', '2018-08-25T21:04:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, fe00e0d2-3794-458f-bdf4-7c67b409698e, 'J''en ai déjà goûté, et c''était succulent. Mais lorsque je l''ai faite, c''était complètement raté, mes bananes étaient dures. Je ne sais pas pourquoi.', '2015-10-17T21:11:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, db311128-72cf-43d6-b44e-3d770664f543, 'Excellente confiture, sur les tartines du matin ou au cours d''une soirée crèpes. Merci pour ce régal', '2014-11-26T20:19:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 011c7293-854c-4366-b4e2-093dc27e2cb0, 'Extra ! Ma première confiture maison : c''est parfait et très facile. Mettre moins de sucre pour accentuer le goût du citron. J''ai également mis le Rhum pendant la cuisson. J''ai fait un petit pot avec du cacao en poudre et un petit pot sans. Les deux sont délicieux !', '2012-08-28T21:18:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 8e190f83-1cc5-43c1-9b8c-421f3945982c, 'Bon mais trop sucré à mon goût, peut-être car j''ai utilisé des bananes bien mûres... Parfait dans du fromage blanc.', '2012-02-22T10:46:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 6bbb5370-23c2-41e2-8e1a-ea33e6311445, 'Sublime recette. J''utilise des bananes trop mûres ou sur le point d''être jetées. Je ne mets ni cannelle ni vanille pour simplifier. C''est à tomber !', '2011-12-29T14:32:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, e7e0dd6a-3cab-4858-9793-f50e67aef358, 'Ultra rapide, j''ai fait pour 2kg de bananes, en 45 min, tout a prit souhait et en pots, un délice aussi dans de la faisselle ou fromage blanc, miammmm ! UN GRAND MERCI !', '2011-10-12T00:34:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 9290892e-189d-4eae-891e-986c6da43c71, 'Elle est super bonne ! Je recherchais ce goût depuis que j''avais acheté un pot de confiture de bananes bio dans un salon, il y a quelques années... Comme beaucoup, j''ai mis moins de sucre : 500 g de sucre de canne complet.', '2011-05-21T20:16:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 6394f3d5-6dd2-4c91-9950-a03070713717, 'Superbe et délicieuse recette. J''ai essayé 2 fois et  chaque fois elle se durcit au réfrigérateur malgré mon réfrigérateur.', '2010-08-26T17:44:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, b3836040-0120-4992-8b97-b06dcd425cf2, 'Je n''avais pas de gingembre, mais cette confiture est super bonne. J''ai juste ajouté du vitepris pour ne pas la cuire 25 minutes.', '2009-09-23T23:07:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 52e5b824-cd0d-459f-90d8-beb6bd2c4165, 'C''était la première fois que je faisais de la confiture, et elle fut parfaite !!! Avec des crêpes, quel délice !', '2009-06-10T22:12:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, ceaad540-41b5-4549-a40f-6e1a677de9a0, 'Ne sachant pas ce qu''est le sucre brun (jeune cuisinière), j''ai mis 400 g de sucre fin et 100 g de cassonade. Je trouve que cela suffit amplement. Mais le résultant est sublime, un véritable délice.', '2009-06-02T13:30:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 8ef6380b-041f-466c-b647-8e236f9d22a0, 'Vraiment super, excellent, merci beaucoup pour cette recette !', '2009-05-24T22:49:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 282965b8-0800-430f-85d8-73ed737a9e9b, 'Parfait', '2009-04-30T15:11:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 8f04c6d1-4e05-43a3-a817-1be85e79e499, 'Beaucoup beaucoup beaucoup trop sucrée. J''en referai en réduisant la quantité de sucre.', '2008-11-11T17:09:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 3b3c8795-2635-4d39-bef0-20015e6c4674, 'Cette confiture est une pure merveille. A chacune sa variante, je remplace l''eau par un mélange de jus pressés maison orange et pamplemousse et pas de gingembre. Et si j''ai peu de temps P.. Citron vert et G.. viennent à mon secours. Ce délice en seulement 7 min de cuisson. N''hésitez plus!!!!!', '2008-07-27T22:07:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, fbc23904-3a18-4c52-8157-9a5b9b2f887b, 'Très bon et très simple. Effectuée sans rhum et avec beaucoup beaucoup moins de sucre.', '2008-06-25T17:15:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 03f535c8-00f9-4f34-941a-981dc444e228, 'Très bonne confiture. Attention néanmoins à ne pas mettre trop de rhum sinon au lieu de mettre en valeur la banane, ça la couvre.', '2008-03-27T19:25:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 8c4f3f76-b76a-4d31-ac63-5a5c9131e693, 'C''est vraiment super bon !! J''ai mis aussi moins de sucre que dans la recette; avec la cannelle et le rhum c''est parfait... Un vrai régal pour les papilles des petits et des grands.', '2008-03-22T12:27:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 2d7223d3-c525-4e67-8388-2dcec4249663, 'Pour ceux qui aiment les bananes, cette confiture est un délice et qui plus est original. Je n''ai quasiment pas mis de cannelle, un peu de rhum et voilà. Le tout cuit avec moins de sucre que ce qui était préconisé dans la recette. Gourmandise sans excès donc.', '2007-10-07T22:21:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 7657a7b2-2ed0-4bd6-829b-086d7b171428, 'Parfaite est le seul mot qui me vient à l''esprit ! Une explosion de saveurs à faire et à refaire ! Merci pour cette recette favuleuse !', '2007-06-12T09:39:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, a357777b-d5fc-48b3-a8ae-b4de9ffbb23b, 'Ex-cel-lent. Très fin. A faire en toute saison!', '2007-01-26T18:35:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 6028bbd4-1fd7-44a8-a434-2e717659e576, 'Cette recette est délicieuse en tout temps, car moi j''adore les bananes, alors cette recette m''en fait profiter encore plus.', '2007-01-15T01:55:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 4151a04c-fa10-40cf-8e98-2bd782eee780, 'Je confirme : tout le monde adore, même ceux qui ne sont pas fanas de banane. Et la petite lichette de rhum à la fin, c''est du 100% pur plaisir des papilles! Et n''ayez aucune crainte, même les enfants pourront manger cette confiture et apprécier comme les grands ce bon petit goût de rhum, il suffit juste de diminuer légèrement la dose !', '2007-01-07T13:46:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 316ea85d-eb7d-43fa-b7ef-80103cca2d3a, 'Oh là là que c''est bon!!! J''ai tenté pour mes paniers de Noël et heureusemant qu''il en reste pour nous!! Par contre, avec 1,5 kg de bananes (et proportions respectées), je n''ai fait que 4 pots de 37,5 cl et il me reste une coupe... Alors je ne sais pas! J''ai eu un peu peur car j''ai mis un moment à obtenir le sirop, mais finalement j''ai patienté et ça a marché! Cette recette est une merveille.', '2006-12-21T11:47:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, 0ca3b7df-48bf-41af-a350-b8864475ee12, 'Un régal! J''ai remplacé les gousses de vanille par de la vanille liquide. La prochaine fois, j''essaierai sans le rhum.', '2006-12-10T20:51:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26941, bf5e1333-0eb0-42ac-86dd-6965b2d67721, 'Un véritable délice!! J''ai adoré et les personnes à qui je l''ai proposée, d''abord sceptiques, ont beaucoup aimé! Par contre, je mettrai un peu moins de sucre la prochaine fois.', '2006-11-29T18:50:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 72d4743a-d521-4473-af48-0c34f8422cba, 'Satisfaits ! Différente des traditionnelles recettes de tarte au chocolat.', '2021-01-05T20:03:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 1a022995-0faf-49f2-a7e1-e6749468de09, 'Délicieuse ! A faire et à refaire sans rien changer.', '2016-07-03T14:16:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, be22b3c2-ca7f-402d-b7e2-1e80697adad4, 'Un vrai délice. Recette simple et bien équilibrée en termes de goût et de sucre. Nous qui adorons la banane et le chocolat, encore une bonne façon d''allier les 2. Mes enfants de 2 ans ont adoré également. J''ai suivi la recette à la lettre et c''était parfait. Merci !', '2015-08-09T19:48:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 934830f1-a211-4250-afcd-e26f02f20c9f, 'Un délice ! j''ai fait une mousse classique quatre œufs 150gr de chocolat noir. Avec une pâte maison 200 g de farine deux c.a.s de sucre 80g de beurre et un peu d eau. parfait ! ', '2014-12-22T22:07:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 3129e40e-3c24-4731-8354-2471d493f9f8, 'J''adore ce dessert, recette à suivre sans rien changer ! ', '2014-08-21T22:19:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, b60ed6c7-af5b-4c7a-a0aa-3267cca603ed, '3 à la maison et personne n''a aimé. On a même été jusqu''à jeter la tarte... C''est vraiment dommage mais c''est pas du tout le genre de tarte à laquelle je m''attendais.', '2014-06-29T22:17:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, c4526b35-bef7-47a3-bcd1-e0ae099939d1, 'Avec des amande effilées grillées dessus...hum super recette!', '2014-06-15T02:31:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 10685892-1a2b-4968-ae4b-e6d1b1e01833, 'Si on aime la banane on ne peut qu aimer cette tarte ! Les bananes sont fondantes et le chocolat moelleux. A refaire, sans rien changer !', '2014-04-22T18:56:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, ead30b60-f4ca-437c-b7c2-85356b9a68a8, 'Moi qui n''aime pas trop la banane, avec ce dessert, je me suis régalée.', '2014-02-02T18:10:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 13dfbce6-7f28-4062-96c3-9c66565e2e8b, 'Cette recette est une tuerie ! Elle a été dévorée par toute la famille ! A faire et à refaire !', '2014-01-26T20:47:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, d419d1a2-71e4-47bb-809d-bb746bb472f8, 'Très bonne recette, merci beaucoup. Je me suis inspirée des commentaires et j''ai ajouté 1 œuf et 50 g de chocolat. Un délice !', '2014-01-08T19:09:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 0d467223-8b3b-4d85-ae6d-ab0bb7173826, 'Un régal !', '2013-09-20T15:22:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, f092ae70-14c9-4801-9016-4464b6eb60ee, 'Excellent, tout le monde a adoré !', '2013-06-10T13:19:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 91d04c5e-624a-44b3-b188-a14cb9095285, 'J''ai suivi les commentaires et j''ai mis 3oeufs et 150g de chocolat. Le résultat a fait sensation auprès de nos amis.', '2013-03-03T17:23:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 797c887f-0dc8-4a5e-a007-557abb94fde7, 'Perso, pas de sucre à ajouter. Les bananes sont déjà assez sucrées par elle-même et la mousse au chocolat aussi... Mais, c''est affaire de goût. Merci !', '2012-10-02T06:20:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 2c3fc33e-7b3e-482d-8c89-11cdc458ebe4, 'superbe ! Rien à redire !', '2012-07-22T23:54:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, d69df7d0-6f9d-4d4e-b1d2-3b36e62bd5c5, 'Recette géniale. C''est en train de devenir un de mes classiques !!!', '2012-05-19T23:01:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 0de33503-b205-4728-9469-4443308816c5, 'Délicieuse ... j ai ajouté un œuf et 50 g de chocolat. Et j''ai mélangé le sucre avec les jaunes avant de les mettre dans le chocolat. J''ai mis de la cannelle en poudre sur les bananes lors de la cuisson. Un délice!', '2012-04-16T00:49:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 66cc073b-da38-4891-bb37-52809abacd66, 'La tarte est vraiment bonne et délicieuse après quelques heures au frigidaire !! A chaque fois c''est un succès !', '2011-11-12T12:09:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 6e5480d2-4396-4822-8c44-1a9641ecfc93, 'Tarte Excellente. J''ai mis moitié chocolat au lait, et moitié chocolat noir. Pour la banane, j''ai préféré la faire cuire dans un fond d''eau. Délicieux, facile et rapide : la recette idéale !', '2011-10-22T13:55:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 28641969-612b-4109-8d09-2edfd7764b3f, 'Voila je viens de réaliser cette fabuleuse tarte mais une fois le beurre et le chocolat fondu il fallait ajouter le sucre. Moi ma mousse faisait toute granuleuse alors à mon avis d''abord battre les jaunes d’œufs avec le sucre ensuite verser la préparation chocolat + beurre puis les blancs d’œufs. Un régal !!!!!!!!! Salut à toutes et à tous les chefs en herbe', '2011-10-07T13:41:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, a3a9059d-5f5f-46bf-816e-29816e93827a, 'Simplissime à faire, et très bon, pourquoi s''embêter ? La quantité de mousse au chocolat étant légèrement insuffisante pour bien napper les bananes, je l''ai faite avec 3 œufs et 150g de chocolat.', '2011-08-27T16:38:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, fd79f205-9a48-495f-979c-ab54e84ab99c, 'Très bonne et légère. Essayez de résister jusqu''au lendemain pour la manger, la consistance est meilleure !', '2011-06-27T23:03:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 32a55284-27a0-4b2a-b067-b23645ea2fcf, 'Un vrai régal !!! Facile et rapide... Étant très gourmande,j''ai ajouté un peu de chocolat et 1 œuf, ainsi qu''une pincée de cannelle avec les bananes. Je l''ai faite la veille au soir pour le lendemain midi. Tout le monde a aimé... Bon appétit !', '2011-04-12T00:36:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 4b0325f6-e270-4ec6-a9fb-e992843135f7, 'Vraiment trop bonne !!! J''ajoute de la noix de coco râpée  sur le dessus. Tout le monde adore !', '2010-12-04T18:42:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92462, 10d6ad51-7320-49f3-8c6c-148f765b02c2, 'Excellente recette. Une tarte banane-chocolat légère que tout le monde a adoré et redemande !', '2010-08-26T21:29:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43911, 85f95c31-3280-4778-bd96-4b92885a3ea0, 'Personnellement je trouve que les proportions sont bonnes (mettre plus de chocolat écrase le goût des autres ingrédients). Par contre j''ai tapissé le fond de tarte de poudre d''amandes pour absorber le jus rendu par les poires et j''ai saupoudré de sucre de canne à mi-cuisson pour caraméliser légèrement. ', '2015-10-31T10:31:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43911, a0e1b455-5187-415e-b69d-25fb5d8646db, 'J''ai fait 200 g de chocolat au bain-marie pour et pour la déco du vermicelles de couleur !!  Voili voilou à plus et merci pour cette recette bien sympathique !!', '2010-10-13T18:35:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43911, 6cd86174-a955-4c01-9535-88d202651f93, 'Tarte bien sympa, il faut simplement mettre 200 g de chocolat car 100 g c''est un peu juste. Tout le monde à bien aimé.', '2008-03-28T18:39:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43911, a344eea2-4a1c-4c1e-a931-a04fcaf188c4, 'Vu mieux, tarte plutôt raplapla. A éviter avec des invités, à faire plutôt en dépannage en famille ou avec les enfants!', '2006-09-25T00:03:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43911, 8543c03e-1d48-4868-a448-8fdc75cf2049, 'Bonnne tarte.', '2006-04-09T17:12:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43911, 20fb0bb5-5ba3-4d2f-92d5-4191f018d25c, 'Excellente, et simplissime! Merci pour cette recette! Je pense que la prochaine fois que je la ferai, je ferai légèrement pré-cuire mon fond de tarte à blanc car j''ai eu un peu de mal à "sécher" le fond en fin de cuisson. J''ai également ajouté un peu de sucre roux sur les fruits pour les "caraméliser". Nous l''avons goûtée tiède avec le chocolat encore un peu coulant, et froide le lendemain avec le chocolat durci...les deux se défendent, avec une petite préférence pour le froid, car la tarte se présente mieux.', '2006-03-19T11:07:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169143, 68bde40a-bade-41ef-a64b-01cacf9111b9, 'Ne vous en privez pas, c''est délicieux! J''ai juste eu un problème de taille de casserole. J''ai donc fait réduire les tomates à part dans un peu de jus de cuisson. Ensuite, j''ai rallongé avec un peu plus de jus (il y en a plus qu''il n''en faut) et ajouté du persil et de la coriandre. La sauce tomate a été servie dans une saucière.', '2011-04-04T11:45:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169143, eb7fb05c-8ffc-40dc-a15f-9c1fe429c9b9, 'Enfin une recette de bougna ! Je l''ai faite sans céleri et j''ai fait revenir la viande et les oignons pour plus de goût... On s''est régalé... ', '2010-10-03T00:30:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 9b4bf020-44fa-4c12-913b-853c9c4e15ba, 'rapide, délicieux, et bon marché ', '2022-06-19T14:35:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 5abc1d2d-97b4-4585-8524-fd5a925adcf6, 'Excellente recette ! Faite avec un peu de crème fraîche et sans sucre vanillé. Un pur régal ! Merci pour la recette', '2022-06-18T14:36:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, ccbfbf9c-aad5-4904-b80e-c7337b7ca293, 'Excellente ! J’ai suivi les commentaires et ajouté un peu de crème fraîche. Les enfants en raffolent !', '2018-08-04T10:41:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 79d545a0-aeca-4718-aaae-0e64b5f3f450, 'Excellent ', '2015-08-15T23:25:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, a2027224-2a10-4315-9a43-edb043e81de0, 'Délicieuse! C''est vrai qu''il faut avoir un mixeur solide!', '2015-08-06T02:39:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, c934b9e9-f6b3-4f4b-9e0a-66899b43880c, 'Excellent !  J''adopte cette recette, le résultat est parfait. .', '2015-07-13T23:39:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, e7770bd5-515b-43f0-a573-bb18a48fa273, 'Excellent !!! J''y ai ajouté du lait et de la crème car mon robot n''arrivait pas à mixer... Et vu la quantité j''ai mis deux sachets de sucre.', '2015-03-17T17:23:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 0e8fdb9e-aba3-48db-beb9-63582457711b, 'Frais, sain, bon et rapide. Parfait quand on a des bananes farineuses ou trop mûres. J''ai fait ma flemmarde en utilisant un mélange de fruits rouges déjà surgelé. Et en ajoutant 100 g de fromage blanc on obtient un effet un peu crémeux... mais light ! A refaire.', '2014-09-27T19:04:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 73f4ea53-9d6a-4cf0-aab5-a9009eea00d1, 'Je fais la même recette depuis un moment déjà avec mon thermomix sauf que je ne mets pas de sucre vanillé. Je goute avant la fin et si ça n''est pas assez sucré je mets du Sirop d''Agave.', '2014-09-15T21:48:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 0989f10b-954c-4ba6-9c9e-91b781c01a2e, 'Dessert de dernière minute excellent ! A refaire  ', '2014-09-15T20:39:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 2f85ee28-9149-4f66-9d67-9d049e17f804, 'Super ! Rapide et délicieux !', '2014-09-15T19:06:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, f2c3b8bd-7084-43ef-a0b5-b55174e5e4eb, 'Pratique quand on a des bananes trop mures ! Je congèle et quand on a envie d''un dessert vite fait !! J''ajoute simplement pour mixer un ou deux yaourts natures maison. Pratique pour le régime !!', '2014-08-24T16:06:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 0bad8c3a-b798-4055-afde-b7d1e5355454, 'J''ai trouvé la recette excellente même si pour moi le goût de banane était un peu présent et que pour moi il fallait un peu plus de sucre voila sinon merci beaucoup', '2013-09-16T20:54:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 9d5e7429-1ea0-474a-a7cd-70d16dc7a2e6, 'Divin! A faire et refaire sans complexe. En tant que diététicienne je la recommenderai à mes patients.... J''ai utilisé des framboises surgelées et j''ai décoré de riz soufflé et de morceaux de fraises. j''essayerai de la décliner...', '2008-05-29T04:11:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 4a26e193-3ba1-439b-af9c-a61078e65608, 'Délicieux!! Encore meilleure avec de la crème fraîche liquide 0%.', '2007-04-20T19:52:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, a1b7feb7-0d9f-4c57-a407-2de7183cea82, 'C''est simple et très bon bravo! Parfait l''été, rafraîchissant.  Merci de nous l’avoir présenté! ', '2006-04-26T16:42:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, a919c543-96dc-4297-92dc-c5f810db4a3a, 'Excellent ! J''ai ajouté quelques zestes de citron, 2 oranges, j''ai mis 2 l de jus d''orange et 1/2 litres de jus de fruits de la passion, pour le vin j''ai mis du sidi brahim. Par contre le sucre est indispensable...', '2015-09-07T22:02:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, bdd9637f-f98b-4d7f-823d-993c3f149a24, 'Une sangria très appréciée. Un barman professionnel m''a même dit que c''était la meilleure qu''il avait gouté. J''ai gardé les doses indiquées en rajoutant une petite bouteille de vanille liquide, un peu de cannelle en poudre et 1L de limonade. En fruits, j''ai mis 2 pommes, 2 bananes et 2 oranges avec le jus. J''ai également ajouté 50 g de sucre en poudre. J''ai tout fait la veille au soir. Cela m''a donné de quoi ravir une vingtaine d''invités.  A noter que j''ai enlevé tous les fruits et resservi le reste 1 semaine après. Tout aussi réussi.', '2008-09-14T18:19:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, 99b67484-1439-41c7-8e9a-a0a7ea543555, 'Super!!!! J''ai rajouté d''autres fruits comme des raisins et des kiwis. Mes invités ont adoré.', '2008-09-09T17:55:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, 316dabb4-1f16-40a8-b473-cd7ef11741f1, 'Je cherchais depuis longtemps une recette de sangria et en voila une que je vais renouveller cette année; je la prépare dans une bouteille de 5l d''eau ce qui me permet de la conserver facilement au frigo; je n''utilise que trois bouteilles de vin et ajoute trois bâtons de cannelle. Excellente recette!!', '2008-05-08T14:41:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, 4ef45855-263f-4270-bb78-a0e283ab57e6, 'j''ai rajouté du sucre mais pas d''eau.', '2019-03-27T14:26:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, 02b62ecc-40e0-4582-868e-e920e0f78377, 'Très Bien (rhum indispensable) !', '2013-11-10T19:32:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, 6ec9c7a3-4fa1-49bd-9446-06572dc3115e, 'Très bonne recette ! Nous avons congelé les restes et c''était excellent aussi après décongélation ! Merci !', '2013-03-01T22:17:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, 37c375b4-8e7e-4513-b3b3-aca4fed732ae, 'Très appréciée ! A refaire.', '2012-12-03T20:28:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, 29df9fd0-8c12-41dd-b250-bd6c89922c14, 'Excellente recette ! Elle a fait fureur mais j''ai ajouté 100 g de sucre quand même !', '2012-09-09T16:53:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, d3dbe21d-4509-414f-9241-6cda1d68650a, 'Parfaite. Je l''ai réalisée en grosse quantité pour la fête de l''école : 60l, tout est parti en 2 heures !!! ', '2012-06-30T10:51:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, 9ea0bfac-5c0f-4cfb-90c9-7e727bdde3c1, 'J''ai ajouté 1 orange + zestes et zestes de citron, et 2 cuillères à soupe de sucre de canne liquide.', '2010-05-07T12:47:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, ebc0d56e-0f25-4773-b40d-6a3f39aa3e57, 'Rien à ajouter', '2009-08-17T17:23:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, 965698fe-f7f2-46a1-b3d8-e4ba416962b5, 'J''ai ajouté aussi des pommes et un peu de sucre; ça a fait un tabac!!!!! A renouveler.', '2008-07-11T16:42:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, fb0bb604-af77-499a-b00e-162a14c72638, 'Une excellente recette!', '2007-08-13T20:04:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, c4279302-f52a-4e36-8a2c-4147a90cc37b, 'Très bonne recette! J''y ai mis kiwi, pomme et banane.', '2005-09-09T17:45:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, da83552a-eea8-4d6b-9d93-bcd7874b76ba, 'Excellente recette. A refaire sans hésiter. Cela change des sangrias et des punchs.', '2005-05-11T14:46:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, b5e0e91f-71c1-43f6-b294-a191f99b2ce2, 'Recette excellente. J''ai rajouté des oranges et leur zeste. Ca change de la sangria habituelle et ça a beaucoup plu.', '2004-10-18T17:02:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, b67eff6d-0985-4084-ac06-0c49f0c3bb69, 'Excellent, mes invités ont adoré!! J''ai aussi rajouté un peu de sucre et des oranges.', '2004-08-23T15:38:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, 2190e1d9-4cf9-4cc7-957d-06d32d731416, 'Excellente mais un peu fade. Il manque du sucre. J''ai ajouté des oranges pour qu''il y ait plus de fruits. Un vrai succès!', '2004-06-09T13:32:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19908, 0e2bbd85-4071-49be-b858-0373d7e53e4a, 'Succès garanti! Le rhum arrangé doit y être pour beaucoup... Toutefois, à consommer avec modération.', '2004-03-18T10:21:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222925, 9b540ccf-28a6-431c-93fc-46a80fea451f, 'Il faut mettre une grosse couche de confiture de lait sinon ça ne se sent pas suffisamment.', '2012-02-19T20:10:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28649, cdafcc82-70ea-457b-8ffa-2494bdefe751, 'Très bonne recette, super simple à faire. Le citron et l''orange apportent une petite pointe d''acidité qui équilibrent très bien la douceur de la banane.  Par contre avec les quantités données je n''ai fait qu''1 pot 1/4 et j''ai rajouté 5 min de cuisson au micro-onde. A essayer absolument pour les accros des fraises/bananes!', '2006-06-20T21:50:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (174836, 994b29a8-c8aa-4643-9855-452e01c75fd2, 'Un délice, merci pour cette recette succulente !', '2011-07-16T15:46:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (341878, d8d7e08b-b888-48d4-a147-0d25a3212b13, 'Bonne recette', '2023-04-20T16:31:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (341878, 4c2658ab-27d6-40e2-aaf1-c88c9137deef, 'Bonne recette ! J’ai mis moitié moins de sucre et remplacé le cacao par des pépites de chocolat noir. Les cookies sont, par contre assez mous, mais le goût est très bon !', '2022-10-20T19:35:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166733, 2daf5dd3-dbe8-4f64-a77d-e3a18401583f, 'La recette est très simple et bonne. Pour ceux qui n''aiment pas la viande; essayez avec du poisson !', '2018-05-15T04:06:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95509, e238b09a-c5fb-4cef-bd37-2bc9ec1bae54, 'J''ai mis des noix au lieu des noisettes, de la maïzena au lieu de la fécule de pomme de terre. Par contre, il a cuit 50 min à 170°C dans un moule à cake.', '2019-05-06T21:39:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95509, b27a46cf-abc7-4913-9d48-447d9acf7a70, 'Gâteau très moelleux qui a eu du succès. Toutefois 100g de sucre c''est beaucoup trop à notre goût - 50g suffisent ! ', '2023-10-27T21:50:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95509, 81b450cf-873d-4318-b278-09dce4374482, 'Super recette de gâteau sans gluten et lactose : léger et goûteux. N''ayant que 2 bananes, je l''ai adapté en modifiant les autres ingrédients.', '2023-01-07T20:21:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95509, 66d62e25-f418-4607-8c35-ac28ec000e57, 'Un gâteau sans lactose et sans gluten super moelleux et avec un vrai goût de gâteau ! Je l''ai fait à de nombreuse reprises, toujours un succès et apprécié de tous !', '2020-11-07T19:28:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95509, 7e46c353-50ac-42d3-9a87-b56a47d1a789, 'Sincèrement j''ai beaucoup aimé la consistance ultra moelleuse...
Je n''ai pas mis de sucre et le sucre de la banane m''a suffit, gout personnel car ma mere aurait préféré qu''il y en ait un peu.
Sans matiere grasse ni rien, le top. J''ai mis 125g de poudre d''amande. Un petit régal.', '2020-05-03T21:15:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95509, df11cdbd-86e5-4b4a-aeda-a2c7ce817939, 'J''ai remplacé une des bananes par 130g de fraise et... osé ne pas mettre de sucre ! C''était vraiment très bon. J''ajoute que j''ai monté les blancs en neige pour ne pas mettre de bicarbonate.', '2018-05-28T11:36:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95509, 4e958ae4-3f24-463b-8b01-7b9bae39dd01, 'Gâteau raté. Je ne saurais dire pourquoi... J''ai mis de la facule de tapiica. Le gâteau était croustillant a l''extérieur et a l''intérieur pas trp cuit. Ca n''avait pas la texture d''un gâteau.', '2018-05-21T22:59:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95509, 29ca614e-2f8a-4e91-b827-790eed23c39e, 'Délicieux ! Je mets des amandes à la place des noisettes et de la maizena comme fécule ! ', '2018-02-06T09:55:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95509, dfcd55b8-11a3-4334-ac6b-0a71159de915, 'Recette rapide, facile et moelleuse, elle a beaucoup plu.', '2017-09-10T20:12:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95509, cc616aae-c8ac-4220-ab60-716cb77df8d4, 'A la recherche de recette sans gluten qui ont le véritable gout de gâteau. Mission réussie. Gâteau parti en 2 min chrono.', '2017-07-17T09:43:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95509, c457eab0-7bd9-43ef-81ec-c8ca6e843e4b, 'Super recette, dessert léger. Le mélange banane-noisette fonctionne super bien ! Un cake qui ne sèche pas, même sans matière grasse !', '2016-04-21T17:03:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95509, 7d03ac60-e6f0-4bbe-9354-d3b1de9acb24, 'J''ai changé la fécule de pomme de terre pour de la Maizena et fait un mélange 1/2 noisettes + 1/2 amandes en poudre.  Le goût est vraiment très bon !  A faire la veille pour que la banane parfume vraiment le gâteau. ', '2015-07-29T14:01:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346964, 2b8a6bb3-da32-489c-9110-b68fc2d76052, 'Excellent !
Je n''ai pas fait la décoration de coeurs sur le dessus (je n''avais qu''une pâte sablée), mais la tarte en elle-même est excellente, je garde la recette, merci !', '2017-08-28T14:30:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346964, e602565c-32e4-49d7-af08-597d546f6435, 'Je n''avais plus qu''une seule pâte toute faite à la maison donc pas de petits coeurs sur le dessus. Par contre pour le reste j''ai bien respecté la recette et c''était juste trop bon !!!! A refaire sans hésiter !', '2017-02-15T11:34:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346964, 30be023c-5062-4c49-b89d-18691ad06382, 'Beau mais pâte pas cuite ', '2017-02-14T21:42:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36648, f53fc2f7-7452-455c-80d5-8b204c2abe7e, 'J''ai suivi la recette, en suivant les conseils d''une internaute : j''ai fait deux petites fentes dans lesquelles j''ai glissé 2 carrés de chocolat noir. Au sortir du four, j''ai arrosé de Baileys (je n''avais pas de liqueur de café) : résultat excellent, même aux dires de mon conjoint pourtant sceptique avant d''avoir goûté, n''étant pas fan de bananes cuites.', '2014-10-28T22:15:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36648, 9574b986-5ec4-4ac0-ae3d-c32eb5bccc81, 'Très bien servi en accompagnement de boudin blanc, avec le contraste noir et blanc...', '2010-04-28T21:24:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36648, 9b9b19d3-3d7b-43a0-ba69-b0e39cd9fc40, 'Merci pour cette idée! Génial quand on a peu de moyens ou d''ingrédients pour faire des desserts !', '2009-05-08T06:35:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36648, ca99cdf3-1491-4624-a85c-094dbc19adc7, 'Excellent. J''ai juste fait une fente avec un couteau dans la peau et dans la banane, puis j''y ai glissé 4 morceaux de chocolat noir par banane... un délice sans complexe.', '2009-04-24T00:32:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36648, 932219c1-d725-4ca5-b79b-6060de35015a, 'Nous, on adore! Pour les servir, j''enlève une "languette" de peau et chacun met ce qu''il veut de sucre et de cannelle en poudre.', '2009-01-24T21:28:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36648, 3539fad7-bd87-4d52-b7c1-ad3cf5f59e5c, 'Parfait ! Facile et rapide avec du chocolat noir fondu, tout simplement... et c''est tout de même moins calorique que cuites dans du beurre. Les enfants adorent la présentation originale.', '2005-05-18T23:40:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, 8db22975-6798-445b-b03d-4e3591ca83a8, 'Très bon et beau gâteau, les invités ont cru que je l''avais acheté tellement il était beau, au niveau du gout j''ai pris les bouts de bananes restant mis en bouilli avec le citron et ajouté à la pâte comme proposé et délicieux, la banane donne un gout de frais et l''amande de la douceur quand au chocolat c''est la cerise sur le gâteau. A refaire encore et encore car délicieux.', '2011-09-28T22:13:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, 76cc2208-a33a-4405-ada9-544292683638, 'J''ai adoré le goût ! Mais je trouvais que c''était un peu sec quand même. ', '2008-05-30T02:31:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, 35bd5e52-5adc-416f-afed-4e4098fd50ce, 'Pas mal mais il n''était pas trop à notre goût...mais certains peuvent bien apprécier !!', '2007-06-15T20:08:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, 01ec7634-db13-479c-a768-cf733f93f187, 'Un gâteau très apprécié !', '2007-03-18T14:41:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, 7e7ffbdb-509d-4a40-87e6-e65d0e295bea, 'Très bon!!! J''ai ajouté des morceaux de banane dans la pâte mais ça faisait trop de banane par rapport au goût du chocolat, donc la prochaine fois je choisirai entre la belle fleur ou les morceaux! Sinon comme beaucoup de testeurs je n''ai pas mis de fleur d''oranger mais c''était pas plus mal je pense.', '2006-11-25T21:57:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, eb0d272c-e3b4-43c2-a29e-79e453920e63, 'C''est un délice des yeux et des papilles! La fleur de banane est un peu longue à construire, mais une fois le coup de main pris, ça va tout seul ! J''en ai déjà fais deux, et j''en referais ! C''est un bon petit gâteau qui peut être servis pour de grandes occasions (repas de famille) car il fait très bonne présentation.', '2006-08-30T20:56:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, 9db1727a-f452-470b-b247-fea4773fe0e8, 'Très bon! Mais dommage qu''il ne gonfle pas plus.Pourtant j''ai rajouté un sachet de levure.... peut être un peu plus de fleur d''oranger pour que le goût ressorte?...et surtout.Ne pas le mettre au frigo en attendant de le déguster car il a peu durci... ', '2006-08-20T19:48:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, 5e484307-7a79-40aa-a8ac-d375115058d2, 'Forte des conseils des autres internautes, j''ai laissé tomber la banane mixée ainsi que la fleur d''oranger. J''ai ajouté un peu de lait au chocolat pour un aspect plus liquide et la masse a mieux coulé dans les interstices. Résultat génial.', '2006-05-19T15:40:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, d46142a5-72b6-4bb7-bd86-176514e61e13, 'C''est beau et bon! J''ai mis une tablette entière de chocolat noir 70% (200 g) et remplacé la fleur d''oranger par 2 cuillères à soupe de cannelle.  Résultat parfumé et fondant, on retrouvait bien une note de banane dans tout ce chocolat ! Conseil :   Bien vérifier la cuisson au couteau (qui doit ressortir sec). ', '2006-04-25T19:54:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, b4c82500-ddc8-4fab-8931-6a350c281d50, 'Excellente recette et présentation impeccable. J''ai aussi eu quelques difficultés à positionner les bananes mais au final réussite totale.', '2006-01-25T14:15:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, d1af6637-d48f-49ac-83df-21ed9b29319f, 'Je trouve ce gâteau très bon et très beau, bien qu''ayant eu quelques difficultés à disposer les bananes!!', '2005-08-01T14:09:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, eca2a957-758a-454e-8ae6-56a6c9946d00, 'Joli mais je trouve que le goût du chocolat n''est pas assez présent. Et un peu sec.', '2005-05-18T19:15:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, 9646f6b1-6c9d-4398-b1a1-bbf0a8778da1, 'Pas facile de faire la fleur avec des bananes pas toujours de la bonne longueur. Outre la jolie présentation, on a été déçu par le goût: l''opposition chocolat/bananes n''est pas franche et la fleur d''oranger rajoute une saveur supplémentaire pas nécessaire. Au final, le gâteau était plutôt lourd et pas très apprécié de mes invités.', '2005-04-25T14:16:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, 140299fd-4196-479b-af37-fc6314062172, 'J''ai eu du mal à faire la fleur, mes morceaux de banane étaient soit trop longs soit trop courts ! La prochaine fois, je ne mettrai pas non plus la banane mixée car on ne sent plus le chocolat, et j''essaierai avec des poires !', '2004-12-27T11:11:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, 75240a2f-9daa-45a6-b6a8-411b02cdb8f2, 'Dessert facile, joli et bon. Par contre, je n''ai pas rajoutée de banane mixée et j''ai mis de la noix de coco.', '2004-12-18T10:45:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, 7a63ee08-55ca-4b49-b1eb-2fcbed3347a8, 'On en prends plein les yeux au démoulage, mais on est un peu déçu à la dégustation. Un peu lourd et pas assez le goût de banane. J''avais pris du chocolat noir à 75% et des grosses bananes, je retenterai avec des bananes ''exotiques'' plus petites et plus goûteuses. 6/5 pour la présentation!', '2004-11-20T14:19:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, c0c4e879-8b1f-4a33-87cc-3b749185b90a, 'Belle présentation et beau mariage banane/chocolat. Je n''ai pas mis la banane mixée: gâteau très bon.', '2004-09-08T19:52:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28873, 041abe6a-302b-43fa-bd68-44fadb07fef9, 'Très jolie présentation, mais gâteau un peu trop lourd. Trop de banane à notre goût. A réessayer sans ajouter la banane mixée, pour une opposition plus franche chocolat/banane.', '2004-05-16T15:23:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, 61f3fa03-d5b5-45c6-bccd-a9f5afcde763, 'Pour la cuisson des bananes plantain (qui ne sont pas celles qu''on mange en tant que fruits!!!): on les plonge dans l''eau bouillante en conservant la peau. Elles sont cuites dès que la pulpe semble vouloir sortir de la peau...Laissez tomber vos auto cuiseurs et vos minuteurs, ça dépendra de la banane (sa maturité ...) Il faut penser à prendre des bananes déjà mûres, avec des tâches noires dessus, si vous les prenez vertes, le gratin sera effectivement fades. On recherche quand même un léger goût sucré! ', '2009-04-19T17:55:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, 23340255-b6a2-4c7a-b0f0-ef515160c01e, 'Top recette je rajoute juste lardon et gingembre en poudre sinon c''est délicieux ', '2023-07-22T01:33:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, 540986ae-a61b-4885-87ca-7a1933e79bc9, 'Au top', '2020-04-12T02:57:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, a30d80c2-6fc1-4386-a829-ee111d3b8358, 'Moi j''ai rajouté des petits lardons. Petits et grands ont très bien apprécié. À refaire, mes doudous ont dit !', '2019-12-02T07:28:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, 20c4720e-01bd-4680-b682-0eef51155eab, 'Délicieux ! Merci !', '2018-09-05T14:30:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, 8e82b16a-bae0-4c84-8423-dfb530bdaa2d, 'Moi j''ai fait frire les bananes que j''ai coupée préalablement en rondelles. Cela accentue le goût sucré de la banane jaune.', '2017-10-04T18:53:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, f72d5e23-ac9a-470b-8b36-7c30818d44b4, 'Très bonne recette. Merci pour le partage.
J''ai juste dû cuire les bananes jaunes plus longtemps.', '2017-08-29T04:00:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, 0f26a53e-abad-4aa9-ae28-d4fce5b84a7c, 'J''ai écrasé les bananes en purée pour la consistance.', '2016-05-29T17:05:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, 3844d235-bd9d-484f-91ef-234a06936958, 'Je confirme pour les bananes mures, ayant déjà expérimenté cette recette. J''ai gouté la première fois cette recette en Martinique et je vous conseille sa variante en rajoutant du curry a la béchamel un délice.', '2012-07-09T21:27:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, bf84901a-5d2d-402d-a19a-a8b0cc1e43b0, 'Super....juste j''ai mixé les bananes jaune....délicieux...', '2012-06-06T13:34:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, d520c4dc-32d5-478f-9b4c-ec00215f9a22, 'Recette délicieuse ! Choisir des bananes très mures pour l''onctuosité et le goût.', '2011-08-15T01:56:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, 687b4453-3550-4155-ae1f-a707fa5d3c3e, 'C''est bon mais c''est quand même assez spécial. A réserver aux amateurs de sucré-salé (d''ailleurs ne pas hésiter à saler !)', '2011-04-21T17:37:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, a5076f55-972b-4a3c-9515-0a90df8c9062, 'C''est plutôt bon, mais je confirme que les bananes doivent être de préférence mures.', '2010-06-08T13:26:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, 9ee1c43e-c2d3-4f03-8709-726d3e78270c, 'Facile à faire et on peut y ajouter la touche qu''on préfère (lardons, dés de jambon, viande, ou nature etc...) Un plat peu coûteux et bourratif !', '2009-08-07T20:49:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, 33583129-aec4-4d26-91d4-ede0bc491084, 'Recette très facile à réaliser ! Cependant, il faut mettre des bananes plutôt mûres pour ceux qui aiment le fondant des bananes et leur goût riche !!! Si vous mettez des bananes juste jaunes et trop dures votre gratin n''a pas de goût et les bananes sont fades.', '2009-07-20T20:01:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, 23b1908c-c08c-44cd-b756-7ff7515c8c12, 'Était-ce un problème de bananes ? (pas assez mûres)? Ou simplement un "légume" auquel nous serions réfractaires ?(nous n''avions jamais mangé de banane plantain). Malgré une cuisson OK grâce aux commentaires (soit 5 bonnes minutes à l''autocuiseur), nous avons trouvé cela sans grand intérêt, plutôt fade...', '2009-02-26T20:55:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, 4afc2910-6062-4ea5-9318-3ee094570147, 'Effectivement c''est très bon. J''ai suivi les conseils et j''ai laissé cuire les bananes une vingtaine de minutes.', '2008-12-14T18:49:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, f6cf2d95-22e2-4a31-967c-88e3478b554e, 'Attention à bien prendre des bananes mûres et à ne pas hésiter à cuire plus de 5 minutes. Pour ma part, j''ai ajouté un peu de muscade. Excellent!', '2008-10-18T16:01:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, 9df8973e-8ac3-411d-ab59-c25e412132d4, 'Effectivement, la cuisson des bananes est trop courte : j''ai bien cuit 5 minutes, mais à l''autocuiseur ... A part ça, c''est très classique comme gratin. Mais qu''est-ce que c''est bon !', '2008-04-21T19:54:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32749, 87a3ce82-0bed-4333-9e9f-00b13212c86c, 'Résultat non satisfaisant, après 20 min de cuisson des bananes. La recette serait sûrement bien meilleure, en coupant et en cuisant préalablement les bananes, 20 min à l''autocuiseur. Mieux vaut des bananes trop cuites que pas assez!', '2005-10-16T18:31:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84439, c2fc4ff1-17a7-494c-9f31-9a63d4124ccd, 'Très bons gâteaux, pour ma part je les ai fait cuire 20mins à 180°C. par contre j''ai une petite préférence pour ceux aux chocolat! Je vous les recommande.', '2020-02-23T06:26:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84439, fd8af8d2-68f5-4c68-82a2-9f8c941a636a, 'Pour ma part j''ai ajouté du lait et remplacé le beurre par de l''huile. Cuisson 20 min à 180°C.', '2016-11-06T16:49:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84439, cc88a7c5-1516-4664-a9a7-6a23510cc57b, 'Bonjour  alors pour l''avoir testé je pense qu''il y a trop de farine, le résultat est bon mais très sec voir même très lourd. Je pense que ces proportions sont celles des scones. En tout cas ce ne sont pas des muffins légers.', '2010-09-22T14:36:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84439, f86623df-b715-4e5f-a1b6-90552058ede9, 'Délicieux ! Je n''aime pas trop la banane donc j''ai mis du jus de 2 citron a la place dans le 3eme tier de pate, tres sympa. Mais mes préférés sont ceux a la pomme !', '2009-06-15T15:57:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (254001, 39207aad-45b2-4125-bb58-7501575feedf, 'J''ai mélangé le beurre fondu et les bananes en rondelles sans faire revenir à la poêle. Pour le reste, j''ai suivi la recette, et c''est très bon (le jour suivant, les bananes ont noirci, mais cela reste mangeable).', '2019-11-03T09:38:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (254001, 4d1813cf-8dc5-4f1e-9087-215a6fede1bc, 'Très bonne recette faite sans rien changer parfait !!!!', '2019-04-04T06:40:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (254001, 6af43c5b-a187-407e-8ff7-92a0f9afaec0, 'Très bon, personnelement je met plus de chocolat et de lait.
J''utilise du lait de coco a la place du lait  et de l''huile de coco a la place du beurre pour rajouter du gout et éviter la crème !', '2018-06-30T08:05:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (254001, 0de439da-5ae5-44b6-a523-c856b9573a75, 'Excellente ! J''ai tenu compte des commentaires des internautes et j''y cuit la pâte à blanc et ajouté seulement 1 oeuf.', '2016-11-07T09:37:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (254001, ea848b34-624e-42d6-9527-2fb15d7c3e7a, '20 g de sucre et 4 carambars concassés à froid à la place. et crème liquide légère au lieu du lait. Parfait.', '2016-01-29T23:45:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (254001, 9f82e2b6-a082-48ac-9cfb-567bdf736cc8, 'Délicieuse ! ', '2015-05-16T22:54:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (254001, d69aecd4-ef79-4921-81c5-2f43c06f9968, 'Délicieux franchement j''adore j''lai faite pour mon anniversaire (j''ai 15 ans). Ma touche perso : des fraises mmmmmh.', '2014-05-10T16:49:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (254001, 2061d5f1-678b-4007-8637-00abd9b6c736, 'Délicieuse ! Simplissime ! Ma touche perso : mélange oeuf divisé par deux et sucre diminué, pâte cuite à blanc, crème liquide plutôt que lait avec le chocolat. Un régal...', '2014-01-13T16:09:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168090, d7a1baad-eea0-4f49-a1dc-65f104309e4c, 'Très facile à préparer. Très bon, agrémenter d''une boule de sorbet à la noix de coco.', '2015-06-27T11:53:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 2aecf3ad-0096-4976-96e8-d43d5429ce94, 'Whouaho !', '2023-01-05T20:55:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 0ab095fd-6830-4c75-9ddc-227c7774b28c, 'Délicieux
', '2022-01-20T17:11:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, a7a9f2a7-add0-44cf-86c8-48b90629b16e, 'Succulent ', '2021-11-07T11:34:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 50aca9be-cee8-4349-af71-3278e69ed917, 'Excellent, mes enfants ont adoré!!', '2020-09-12T18:43:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 778ebb1c-76d3-4ac8-a728-7474ebb54377, 'Ma nouvelle soupe préférée. Mon fils de 5 ans en reprend 3 fois et celui de 19 mois adore aussi. Mon mari est moins fan mais je la fais au moins 1 fois par semaine. Je mets souvent du lait de coco à la place de la crème. ', '2016-03-19T13:50:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 259a84db-28ae-4971-b864-43eed6fde070, 'Je viens de la faire, mon mari et les enfants ont adoré. On ne sent pas beaucoup la banane (j''en ai mis 3) mais ça donne une très bonne consistance. A refaire', '2015-12-28T23:26:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, a999fdfb-453e-4292-84bf-75a9c4db8d34, 'Un régal... j''ai adoré cette soupe... le gout de banane très présent (pour ceux qui disent qu''il n''y a pas de goût de banane moi perso j''ai pris des bananes très mûres limite noir foncé)! je vais la refaire sans hésitation j''ai juste remplacé la crème simple par de la crème de coco', '2015-08-04T08:52:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, e3c20e80-c1d6-4e05-b975-0be1d2118c25, 'Très bonne recette aux saveurs exotiques, souvent mangée au Brésil ! ', '2015-04-25T23:34:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 3e1c029d-61e4-4a9a-8a2c-bcd94e7c6ed3, 'Assurément ma découverte de l''année ! Je ne connais pas une seule personne à qui j''ai fait goûter cette soupe qui ne l''ait aimée. L''association sucré-salé-épicé est super !!!', '2013-02-23T19:02:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, f269803e-67ed-45c4-a0b9-de6263209181, 'Très très bon et original !', '2012-05-05T12:06:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, b84a51ab-f6d1-4594-92de-bb88daf536a1, 'J''ai fait cette soupe il y a 3 semaines et j''ai adoré. une pure merveille pour les papilles. Merci.', '2009-01-07T16:25:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, fe924b7d-4461-4efe-82fb-218b09bfaefb, 'Je viens à l''instant de faire cette soupe, un seul mot à dire dé-li-cieux. La prochaine fois j''ajouterais une pointe de sucre pour l''acidité des tomates. Merci pour la bonne recette!', '2008-10-09T15:39:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 1987d267-75b6-4d9c-b7cb-a09686d72454, 'Je dirais juste: "UN PUR DELICE" avec peu de choses, recette réussie même froide en amuse-bouches dans de jolis petits verres.', '2008-06-23T19:37:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, fc76851e-ec75-4ac5-a1e6-9d04ed8db6e7, 'Délicieux mais j''ai mis une banane en plus, et l''arrière goût est un vrai délice.', '2007-12-04T15:47:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 6ab525a2-bd45-4e15-9494-4af64f6873d5, 'Super tout le monde a adorer mais avec des tomates fraîches c''est encore meilleur', '2007-08-11T12:44:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 7bea39cb-d871-48cd-ba8a-4bc08750785e, 'Je viens de réaliser cette soupe en suivant bien la recette et la quantité d''ingrédients. J''avais déjà goûté cette soupe en apéritif et c''était délicieux ! Ici, j''ai dû la jeter, on ne goûtait que la banane....Peut-être faudrait-il diminuer la quantité de bananes et rajouter des tomates et des oignons ? ', '2007-06-16T18:10:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 50f697a3-2888-4945-b737-c12192eab75f, 'Il faut l''essayer même si l''association peut paraître étrange, c''est très très bon et la consistance est parfaite.', '2006-10-05T17:14:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 978b57c0-003d-40b0-a2a1-bab91150706a, 'Nous avons beaucoup aimé, le goût de la banane surprend au premier abord mais on devient très vite accro. Mon mari qui râle dès qu''il y a de la soupe a adoré.', '2005-10-27T22:02:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 81a13a0a-7a39-4c38-b22d-5af5c2e75526, 'Désolé mais nous n''avons pas apprecié l''association de ces 2 fruits.', '2005-10-07T11:07:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 94c378d5-78cc-4529-a8ff-cb9cd89a8ab4, 'Délicieux. Ma touche personnelle: je fais revenir 2 oignons avant d''ajouter les autres ingrédients. Sinon c''est encore meilleur avec des tomates fraîches, et une pointe de couteau de piment de Cayenne ajouté juste avant de servir relève merveilleusement ce potage. ', '2005-09-11T21:44:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 37393efd-6735-4f97-b954-f72126678c35, 'Délicieux!!! Enfin une soupe originale... tout mes convives ont adoré, même mon mari qui, ordinairement n''aime pas la soupe. A garder précieusement!', '2005-05-24T21:52:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 1de90c94-f82f-4a49-9cf8-77c533ae4df4, 'Bouh ... C''est bizarre, douceâtre, le goût de banane est assez fort. Pas trop aimé. Peut être faudrait il relever avec du Tabasco ?', '2005-01-20T12:18:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29924, 36e9c26b-093e-4526-a472-929ff117c88e, 'Excellent! Tout le monde s''est régalé... Les bananes apportent un petit goût spécial, exotique et très agréable. A réserver quand même aux amateurs de ''sucré-salé'', dont nous sommes.', '2004-11-05T18:04:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, e24c078b-4981-4d17-81a2-d1162b99dc90, 'Je trouve que le goût du thon est beaucoup trop fort et "tue" celui de l''avocat et de la banane. Je réessaierai en remplaçant le thon par du crabe, des crevettes ou du surimi. De même je remplacerai la vinaigrette moutardée par un mélange citron + huile d''olive, par exemple. Pour la salade verte j''ai utilisé de la sucrine, qui convient très bien.', '2017-06-23T07:17:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, 1f6eec57-7d3d-46ff-b5fd-fc70b39f1ba7, 'Super bon :) J’ai fait la sauce avec la mayonnaise.', '2021-04-10T12:01:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, 481bf838-0979-4274-a90e-452061776718, 'Oui bien pour un soir.', '2017-06-21T15:30:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, 4ba12380-69d9-4916-9616-17effd7a225e, 'J''étais plutôt sceptique mais le mélange banane avocat est vraiment étonnant, avec du vinaigre balsamique c''est très bon aussi', '2016-05-18T21:36:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, 56538d8c-9bd9-4307-9039-c7989317458a, 'Huuumm !!', '2016-01-26T18:36:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, 7afee3a8-a392-4a7d-812e-391706fa381b, 'Effectivement ça passe très bien ce mélange !', '2015-09-03T02:01:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, 05c992b4-b47e-4fbf-957c-4c13a10306c3, 'Super salade', '2014-11-26T20:18:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, 1a72657d-6252-402a-a13b-3b773bc69291, 'N''ayant pas de thon, je l''ai remplacé par 6 bâtonnets de surimi hachés au couteau et assaisonné d''une vinaigrette à base d''huile de noix et de vinaigre balsamique. Nous avons bien aimé ce mélange au départ improbable.', '2014-04-26T14:55:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, b00cf8ae-d708-4895-82b4-eaf5bf847875, 'C''est absolument délicieux. J''avais pris du thon avec une petite sauce pimentée en plus du thon au naturel et la banane a adouci le premier. Parfaite harmonie entre les différents ingrédients  de cette salade. A refaire sans hésiter', '2014-04-09T22:03:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, 76f1161a-0302-4765-b04e-f65a2a89fb4b, 'C''est délicieux, même sans la salade !', '2013-10-16T20:52:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, 2ec1d371-2ebc-48ab-aca4-bd1135a2a4fc, 'C''est simple, original, facile, fait en 5 min, très bon et surprenant jusque dans le nom. Que demander de plus ?!  Mes invités en parlent encore plusieurs jours après, ils sont bluffés. Merci !', '2013-08-28T00:53:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, fc9266d6-de1b-43ef-b19a-c58533effc30, 'Très bonne salade. La banane donne l’originalité du plat. J''ai mis de l''huile d''olive et de l''huile de colza. Nous nous sommes régalés.', '2012-07-16T13:23:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, e5f62e01-5340-4240-b17f-5047134e58e9, 'J''adore ! Frais, complet et délicieux.', '2011-04-12T15:59:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, b1e63858-34ee-4f9f-8396-7e69c4125fcc, 'Bonne petite salade qui change de l''ordinaire. Étant un grand fan du sucré/salé et la découverte de nouvelles saveurs, je suis quand même légèrement déçu par le manque de goût de cette recette... pourtant j''ai suivi les conseils "Huile de noix/Balsamique". Une bonne salade originale, sans plus...', '2010-09-08T16:06:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, f2737aeb-f7ce-4f16-aa89-75a86bb6e6fb, 'Bonne salade; je n''ai pas mis de banane car je n''en avais pas, mais j''ai rajouté une tomate. Ressemble un peu à la salade niçoise sans les poivrons. ', '2010-08-12T14:48:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, 890c4fbb-d651-425a-a334-af47bf976f13, 'Très bonne salade, facile et rapide à réaliser.', '2010-06-18T15:55:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, 2510df79-e0cf-4e3f-aeb4-e85aeae54865, 'Une recette originale et bonne ! J''ai suivi les conseils d''un internaute en mettant de l''huile de noix et du vinaigre balsamique.', '2010-04-18T17:38:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, f1629c37-1b30-40fe-806e-7384d0578186, 'Très bonne recette, mon homme en redemande! ', '2009-12-08T17:52:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, 47d6f4fe-5c52-4fd1-8d00-d0557426b06d, 'Heureux mélange sucré-salé!! Mon homme et moi avons adoré. Merci chouchou !!', '2009-01-12T23:58:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, 97d5f004-6427-4ed8-9a82-9ebc1bdb3263, 'Voilà une excellente recette que je vous recommande vivement. J''ai également mis de l''huile de noisette, un vrai régal.', '2008-06-02T14:32:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, 17943dd1-8a1e-4b67-982a-2bcf56d0655d, 'Un vrai délice, pourtant je ne suis pas salé sucré. Merci.', '2006-12-03T20:37:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17267, dc3412ed-4b6b-43f3-931f-17598fc63b18, 'Cette salade est une merveille! J''ai mis de l''huile de noisettes et du vinaigre balsamique, c''était parfait ! Un délice...', '2006-11-13T19:31:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73192, 940c6873-2040-40f2-be31-ed5cdb935c19, 'Pas très bon', '2022-05-12T07:06:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73192, 741c1173-ede6-4d76-9112-d2c8348cae9b, 'Très bon ! Si vous n''utilisez pas de mixeur je conseille de passer la banane au tamis pour éviter d''avoir des morceaux.', '2020-05-26T19:33:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73192, feace552-596b-45df-a495-52deda2f19a8, 'pas très bon', '2020-05-05T14:31:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73192, 53a01e6a-3409-43d3-bc7c-c97909037b9e, 'Bon mais un peu lourd', '2020-05-03T20:48:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73192, 47a70823-038a-4bb7-8b0e-94f912d416d4, 'Il était bon mais un peu lourd. Sinon délicieux ! ?', '2020-01-18T11:05:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73192, 6e0c93be-a8aa-4c98-a9bf-7a5071178388, 'Très bonne recette. ?', '2020-01-03T11:22:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73192, de9f7bf7-77f6-4ba8-9a9e-cef8e3d122e5, 'Pas bon.', '2019-08-28T04:07:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73192, fe06732a-dbd9-43df-94b1-d80f61c5a939, 'Et un smoothie épais à la banane comment on fait.', '2017-01-12T11:12:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73192, 6395c14d-15a9-46c8-ae46-42fd43f9f318, 'Pas très bon, franchement c''est plus un milkshake qu''un smoothie.', '2016-08-25T10:40:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73192, 6cf8dd27-559b-449e-ac68-9a9fb797953a, 'Pas très bon ce mélange, j ai été déçu du résultat. On devrait mettre 1 banane complète et une banane et demie et moins de lait.', '2016-01-12T01:58:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73192, e8be8d2c-b98c-4540-90c9-b210c04a879c, 'Pas super, je l''ai trouvé super lourd, j''avais rajouté de la poudre de noix de coco, mais trop lourd !', '2015-03-23T19:11:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73192, e051d566-8e02-489e-86cb-f6224f091fdc, 'Mauvais', '2015-01-02T23:14:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73192, a5c5851d-4c2d-4515-aeed-fad33fe2f2f1, 'Très bon, n''ayant pas de mixeur je l''ai fait à la fourchette, c''est un peu plus long mais pas très différent. Pour que ça soit un peu plus frais j''ai ajouté un glaçon.', '2013-10-27T15:19:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73192, 3bfcad78-aa3b-45c2-98bd-7670d9f84127, 'Très bon. Pour ma part j''ai ajouté du coulis de framboise, hum un délice.', '2013-03-13T22:02:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73192, e004ce81-24a6-4d5f-b49b-caee54e4d036, 'Très bon mais j''ai ajoutée du chocolat en poudre.', '2010-02-11T16:51:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, b952afc1-84c4-46b8-a13e-a670e2be3c1c, 'Délicieux !! C''est vite fait et sans trop de matière grasse !! Je n''avais pas de banane et de chocolat en poudre, mais je les ai remplacé par du cacao en poudre pur et du sucre glace. J''ai aussi ajouté des glaçons dans le mixer. Vraiment à faire !!!', '2015-02-26T18:31:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, ca3f7092-7023-4866-9826-f9c984bc3d88, 'Excellent ! Vraiment parfait ! A la place du chocolat en poudre, j''ai mis des carrés de chocolat à cuire! Ca marche aussi! Très bonne recette !  ', '2013-06-17T15:01:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 5489b470-e108-42a0-a1a3-18e75b3b4a5d, 'C''est très bon ! Pour ma part, j''ai doublé les doses : 2 bananes, j''ai seulement mis 4 cuillères de chocolat en poudre, 70 cl de lait et j''ai ajouté 2 cuillères à soupe de crème liquide ! Délicieux !', '2012-05-23T16:40:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, b0b39b1d-86d2-4ac8-a958-553a75208a6a, 'Top !', '2023-11-10T09:27:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, afe0e881-b117-4e11-89d1-3f3f8c491001, 'Très bon et facile à faire ', '2023-11-06T17:33:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 5cc63db0-d5e7-4322-b66d-870b40b6c59e, 'Déçue. C’était juste un lait chocolaté ', '2022-05-26T16:56:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 446433b9-c5e6-4949-8891-7a760c847f5d, 'Moi je l''ai fait sous forme de glace pour ça j''ai juste mis le milkshake dans des moules à glace', '2020-04-05T14:25:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 680d833e-9996-4736-9da6-7b63be655abe, 'Déçue. Le chocolat et le yaourt sont trop prononcés par rapport à la banane. ', '2016-06-14T00:25:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 23bc3d9d-f8d7-40e2-baba-7cb94e3137fb, 'Très bon et hyper facile à faire', '2015-03-13T16:45:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 44257855-91d2-4c36-ac97-8e4956e332f1, 'Trop bon, faites le vite !! NOTE 20/20', '2014-09-19T15:56:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 7ed47029-ed5b-4321-bf55-1bfb00b41fe6, 'Très bon mais trop de chocolat à mon goût et j''ai mis un yaourt sucré donc je n''ai pas ajouté de sucre.', '2014-07-24T18:03:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, d4853649-a362-4b7a-bcb7-d537c7374976, 'C''est très bon ! J''ai sans doute mis trop de chocolat en poudre car mon milk-shake est tout brun.', '2012-11-07T19:47:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 7a480e8e-d391-4938-a100-8983908c4aa7, 'Très bon', '2012-09-23T14:28:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, b10a20f2-40ab-4647-bc79-935b9b0cfd3e, 'J''aime bien mais au lieu de chocolat en poudre pour les gourmands ajouter du nutella', '2012-07-14T17:30:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, ee3a7edf-523a-4d40-ad83-8f3c55992ef5, 'MIAM !!!', '2012-07-13T03:08:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 980c1f0a-2c9e-44c3-8f10-9516b6db305e, 'Très bon. A refaire.', '2012-06-19T12:51:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 93cc36c7-6d31-4f54-91f9-cd3b9a217791, 'C''est trop super bon', '2012-03-23T00:34:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 1c907a9d-fbac-4d49-a018-83fb41874537, 'Super recette !!!', '2012-03-19T19:15:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, f742c362-5ef3-4a09-8f07-4fda3d5b0708, 'J''ai adoré, mais je vous conseille de ne pas mettre des trop grosses cuillères à soupe de chocolat ! Après c''est trop chocolaté, enfin moi j''ai trouvé... Mais ça n''empêche que c''est super méga trop bon !', '2012-03-11T18:02:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 5c280544-0198-4c5a-91b9-8bd2986bc78c, 'Pour alléger nous avons remplacé le yaourt par de la glace à la vanille (150 g + deux glaçons) et avons ajouté de la cannelle. Succès garanti !!', '2011-11-13T15:20:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 86b4d18a-b92e-4bf8-a180-723844a94bca, 'J''adore c''est très bon', '2011-07-09T17:58:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 5d1828c6-ca2a-42a3-8318-87c5f0d2daf0, 'Extra au p''tit déj ça nourrit et ça abreuve tout bien. J''adore.', '2010-11-12T20:52:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 6b94c1d4-f6fc-4f97-956d-376ad46a24d3, 'Ça fait 25 minutes que je l''ai ingéré et...toujours pas digéré !!! Un peu trop lourd à mon goût et sûrement  meilleur frais car là...bof bof Bref je suis très déçu par ce premier milk shake mais nous sommes le vendredi 13...j''aurais plus de chance la prochaine fois!!!! (j''espère!!!)   En tout cas les proportions sont idéales.', '2007-04-13T18:57:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, c030ce31-7068-4e0e-af4e-893185f35fec, 'C''est très bon! Je conseille pour le goûter de vos enfants. Mon conseil : remplacer le chocolat en poudre par cinq carrés de chocolats!', '2007-02-10T14:23:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 0f70f5cf-7112-4962-acd9-25189b45d808, 'Très bon et très frais. C''est en effet meilleur avec les petits morceaux de banane ajoutés...', '2006-07-27T15:52:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, a1d23955-f266-4387-83c8-7531f6bfaafa, 'Testé avec un yaourt à la fraise, mmmmm.', '2005-12-22T23:12:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 21d06370-e252-4874-9f13-9ead5dd6bd91, 'J''ai bien aimé mais je pensais que ça allait être un peu plus épais quand même, mais bon ça se boit très bien.', '2005-10-30T21:01:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 442c27f3-af0b-4f4d-b2ea-c2864f3e0a9e, 'Délicieux !!! Les petits morceaux de banane sont la cerise sur le gâteau !!!', '2005-06-09T20:10:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, f160c033-3db4-4f30-a836-9c8d32c94554, 'Très bon très frais. J''ai remplacé le sucre vanillé par de l''édulcorant et ajouté des fraises (de saison!). On sent l''été approcher!', '2005-04-16T15:25:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, 754cb9a3-13c4-457a-adcd-16accc61b98d, 'Pas mal du tout! On peut rajouter une banane et c''est super pour le petit déjeuner (car pas très rafraîchissant quand même).', '2005-03-27T21:32:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31575, c2d32588-6b14-469c-b3ee-0e30b46edd5a, 'Très bon, surtout frais!', '2005-03-03T20:48:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44348, 4fc394a6-6b64-4a09-8c64-5bd6082eea36, 'Bonne tarte. Attention, un peu difficile de tout mettre dans une seule tarte (surtout avec ananas frais).', '2013-05-31T02:23:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44348, b3972f7d-178a-4bde-8731-75f536826679, 'Très bonne, bien nourrisante mais il y a trop de liquide, la tarte collait au moule. J''en ai profité pour acheter de l''ananas en boîte et garder le jus à boire en accompagnement, ainsi que le jus de cuisson des abricots ;-)', '2008-01-29T17:21:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44348, 7d47098b-80e4-4baf-bbbf-382b386677a4, 'Excellente recette, très agréable, aux parfums d''hiver. J''ai utilisé moins de crème, car mon moule ne pouvait accueuillir les quantités indiquées. Donc la prochaine fois, je ferai la crème avec un oeuf, 10 cl de lait, le rhum (ben oui...) 1 sucre vanillé et 40 g de sucre (c''est ça ou le rhum...). Merci Sissi!', '2006-02-13T21:41:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90533, e4f9633d-31bd-470e-9782-1923d6ae80ba, 'Gâteau express pour un petit goûter !', '2009-11-22T01:13:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90533, baa17cb4-0018-4227-ad63-d0f11c56fe7f, 'Le gâteau n''est pas très grand mais très facile à faire et absolument délicieux!', '2009-10-28T20:11:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90533, f8cacfbf-2f9a-413c-9d9a-43056b564a8d, 'Un bon petit gateau pour le goûter. ', '2009-10-22T22:12:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11015, a868e70e-bf91-47aa-909c-f7b2bc3bc58b, 'Succulente recette et facile à faire ! Les proportions sont correctes et surtout ne pas oublier de saupoudrer de sucre roux, sinon la tarte est toute pâle, mais cela n''enlève pas son goût !! Les enfants étaient ravis et en redemandent ! J''ai aussi ajouté du rhum de la Réunion, excellent !!!! Merci pour cette recette !', '2008-12-04T15:14:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11015, d62c1122-853d-415d-b31d-347e33182274, 'Recette facile et bien plus délicate qu''il n''y paraît! Nous l''avons mangée tiède le premier jour, et le lendemain arrosé d''une sauce chocolat chaude et d''une boule de glace : à chaque fois, c''était très bon !', '2008-03-29T16:14:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11015, 873fb05d-69ce-409d-8800-7eb957482992, 'Muuuuuummmmm! Un délice!', '2006-04-24T18:15:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11015, 33b10bee-86da-4985-85c4-c6e4223dde31, 'Très simple à réaliser et délicieuse.', '2006-01-21T23:59:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11015, cdc489fd-f915-437e-92f9-806965f14843, 'Tout simplement délicieux. Je n''avais que 4 bananes mais très très mures (tellement que personne voulais les manger). Nous l''avons mangé froide et c''était un vrai régal. ', '2005-06-03T17:12:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11015, e3d7dc60-2099-4c07-9b49-942954fc6843, 'C''est délicieux, mais trop riche et pas forcément digeste. A éviter en fin de repas.', '2004-10-04T12:24:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11015, c2967ae2-592a-42cb-bed2-bb93a39bceec, 'DE-LI-CI-EUX!!!  Rapide et facile...  j''ai utilisé des bananes trop mûres, quelle saveur !  J''ai juste rajouté 2 cuillers à soupe de sucre.  Une bonne recette !', '2004-09-16T16:26:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11015, 7e5aefb1-2bbb-4391-b252-379c3e1f6691, 'Très bon.', '2002-08-26T10:30:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11015, 9f51ed94-290d-43d1-8613-f1e77b61a8b6, 'Bon, mais très très lourd . La pâte n'' est pas bien cuite!!', '2002-08-25T13:26:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11015, d4a190b8-8438-4c4c-93c1-02a9320b7faa, 'C''est facile,rapide à réaliser, très bon et très présentable.', '2001-09-20T17:18:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11015, bc2d07df-30aa-43bc-8cd0-cc2e9cc59e3d, 'Très bon, tout le monde s''est régalé. Pour une recette ''allégée'' prendre de la crème à 8 pour cent et du ''faux sucre'' qui résiste à la cuisson.', '2001-05-10T09:52:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32673, f1fe7d8a-aec9-49e5-8c6b-0f18cdcad81c, 'Vraiment excellent !', '2022-06-27T18:27:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32673, 27cf1172-5b52-421e-a79a-2775fffc5f9f, 'J’adore ce plat vénézuélien, je le prépare de temps en temps chez-moi ', '2021-02-26T18:48:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31004, b7cd35d1-e575-4307-8a42-f3559cd85ed1, 'Tout simplement excellente ! J''ai utilisé des kiwis verts et du sucre semoule auquel j''ai ajouté un jus de citron pour la pectine. Je n''aime pas les morceaux donc j''ai mixé avant de mettre en pots. A refaire !', '2013-05-29T12:34:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31004, ef9257b8-415b-44c2-b033-69363d9ba643, 'Délicieuse, cette confiture ! Je n''ai pas ajouté de beurre, non plus.  Sinon, au micro-onde, c''est super facile!', '2005-09-07T18:05:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31004, 5395bbcc-ad63-47a1-8d07-17a4023dfe12, 'J''ai mis du rhum à la place du malibu, et je rajoute une 1/2 pomme par recette pour une ajonction de pectine. Le beurre n''est pas essentiel mais peut donner une touche spéciale s''il est salé.', '2005-08-29T21:55:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31004, 66af1803-3474-4785-8999-103c662b84ee, 'Question de goût bien sûr, mais je n''ai pas aimé.', '2005-08-28T19:03:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31004, b06a873b-0764-4d16-bfc9-ae2d47d4bdee, 'Excellent!! Trop bon!!! Délicieux!!! Je l''ai faite avec des kiwis verts (je n''ai pas trouvé de jaunes), des bananes assez mûres, un peu de coco râpée et un bouchon de malibu... Résultat parfait, beaucoup de saveur... A retenir!!!', '2005-04-02T16:25:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31004, d3833511-413f-40fd-b3fc-d1013ca4aad8, 'Mon premier essai de confiture. Je n''ai pas mis de beurre à la fin et j''ai donné un coup de mixer pour éviter les gros morceaux. C''est réussit, ma fille s''en régale !', '2004-12-27T10:12:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64248, e618e155-3c4e-4400-858b-5ccfeaa9a71e, 'Très bon et si simple ! Même sans noix de coco !', '2012-02-26T18:25:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64248, 52ad2e8f-5e2f-4e33-a46c-6a69d5cef1ec, 'Que dire si ce n''est la réplique de ma fille de 13 ans.... c''est une tuerie, trop de la balle, tu peux m''en refaire ! A faire et à refaire sans hésitation. Merci pour cette délicieuse recette simple et rapide.', '2009-08-20T15:14:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64248, 330f3505-eb9b-49c2-894e-1089ab49183b, 'je mets du miel à la place du sucre et du fromage blanc à la place de la crème fraiche. J''en mange presque tous les jours.', '2023-02-04T14:08:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64248, f9c0e3a9-9b69-4cec-a006-0d3e26efd98b, 'Très bonne recette. Je rajouterais un peu de noix de coco et je mettrais 1/3 de chocolat en moins', '2020-05-09T22:48:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64248, c8ebc09b-80aa-4b45-a1ad-0b5c34e9f3a0, 'J''ai suivi la recette à la lettre et mon fils vient de me dire que "c''est plus bon que la banane au cacao" ', '2013-10-28T16:52:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64248, 5f2b7823-4772-40cf-8cde-24d6f64d8178, 'Fait avec des carrés de chocolat au lait et du nutella, sans noix de coco. Une tuerie !', '2011-08-01T19:31:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64248, 338657a0-96d2-45ea-9322-e63a4e379dea, 'Miam ! Très rapide à faire et vraiment excellent !!! ', '2010-09-30T00:49:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64248, 7ccb9299-336f-42e6-afe7-aa4ae0d9397f, 'Facile, rapide et bon. A refaire sans hésiter.', '2009-03-05T22:48:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64248, a3767ac2-bb9a-4ba8-b83b-a3170f50d91c, 'Super bon!! De plus la banane ne se disloque pas à la cuisson et reste très présentable. J''ai décoré de vermicelles multicolores, tous mes invités ont adoré !! Merci Florian.', '2008-04-07T00:37:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 2f851f6d-fc28-4825-a49c-76d336e3dbf0, 'Une recette simple et efficace. C''est moelleux et très bon, j''adore 👍', '2023-07-29T13:42:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 5bbd4638-8e26-4f13-8651-8267efac9df5, '👍🏻', '2022-11-04T10:32:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 815fcd25-9f64-4b6c-953c-1b85fa5f0d62, 'Sans abricot et avec 3 bananes, ma femme me dit que c''est les meilleurs que j''ai jamais fait... Et c''est vrai qu''ils sont délicieux !!! Je recommande ++++ !!! ', '2022-03-31T16:47:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 59d293d4-fcf6-448f-a2fb-c90fd1e6c0b8, 'Très bonne recette. J''ai mis seulement la banane et du chocolat. C''est délicieux.', '2021-12-05T18:07:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 0e878114-915d-4553-abb7-41d84e25d7c9, 'Bjr
Super recette. Je n''ai pris qu''une banane et 6 abricots et ai remplacé les pepites de chocolat par 3cc de chocolat en poudre non sucré, et ai aussi diminué un peu le sucre. On se régale.', '2020-05-16T19:44:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 54f65894-6803-4d12-95df-0b2cc7178750, 'Je les ai fait sans abricot parce que je n’en avais pas,c’est parfait, ils gonflent bien et délicieux.', '2020-05-04T21:06:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, dfee9a08-6095-40b0-8162-b188f34b2334, 'Excellent mais je n''ai pas mis les abricots et j''ai mis un peu moins de sucre', '2016-08-02T15:48:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 6bba0b58-6b59-4a81-b21b-db5c85e71132, 'Très bon muffins ! J''ai, en vue des commentaires, mis deux œufs au lieu d''un, ce qui est très bien. Et niveau chocolat, j''ai ajouté 100 g (car j''en suis friande !!!) et enlevé les abricots. Les invités sont toujours comblés.', '2012-09-26T03:41:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 469c43db-9c0c-4ae0-b5e4-a2925847478b, 'J''ai testé cette recette, je l''ai trouvé pas mal, la consistance du muffin est parfaite par contre les abricots sont de trop (ne va pas avec banane et chocolat) : avis de 8 convives. Merci', '2011-08-21T23:10:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, dbfdb1f6-8a4f-495f-a074-d2fb0238d67e, 'Avec deux meufs et un peu moins de sucre, c''est vraiment excellent ! Un régal !', '2011-08-18T12:05:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 1cbf0aa0-7185-483f-936d-f041444b7cc2, 'Très très bon ! Fait selon les précédents commentaires avec 100 g de chocolat et 2 œufs. Je n''aime pas trop la cannelle, je l''ai donc remplacée par de la vanille en poudre.', '2011-08-04T01:02:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 068e77d6-0ac0-4a20-a445-d2b8cce39da6, 'Délicieux !!! J''ai ajouté un œuf et un sachet de sucre vanillé. Recette de saison, vraiment à faire actuellement !', '2011-07-20T21:20:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, b748d447-72d2-4acf-acc9-0513b4dfa600, 'Ils n''ont pas assez gonflé à mon goût mais bon ils étaient quand même délicieux ! Mes proportions : 1 grosse banane, 6 abricots secs, 2 œufs et 1/6 de cuillère à café de cannelle. 20 min à 180°C (thermostat 6) position gâteaux. A refaire sans hésiter pour accompagner un thé.', '2011-07-14T21:54:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, f116870e-2186-45cd-98e5-5bdd78e864dc, 'Très bonne recette ! Juste sortis du four et j''en ai déjà mangé un ! Quel régal ! Merci.', '2011-04-28T19:11:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, f3e6b2e4-adfd-4c2f-9b0e-ca46c3da8183, 'Très bonne recette, je confirme c''est rapide, facile. Mon mari s''est régalé !', '2011-02-28T21:40:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, ff338f73-d726-4393-88ca-c9f89cc3cdd3, 'Délicieux, ma femme m''a laissé avec nos jeunes fauves le mercredi apm dernier, je leur ai fait cette recette... Ils ont tout dévoré, quel succés! Votre recette est adoptée par toute la famille.  J''ai mis 2 oeufs, un peu plus de chocolat environ 80 g. 20 minutes 180°C (thermostat 6). Encore merci!', '2010-10-21T06:23:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 451b1d95-094b-4378-a395-31f65f669995, 'Sans les abricots et la cannelle, c''était aussi délicieux. J''ai mis des pépites de chocolat, ce qui donne un joli visuel. J''ai ajouté 10 min au temps de cuisson.', '2010-10-17T00:02:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 4780480f-5674-4342-a6d8-0db641de2211, 'Très bonne recette mais j''ai changé les proportions, j''ai mis 2 œufs et 100 g de chocolat car j''en raffole. Attention à ne pas couper les abricots en trop gros morceaux. Un régal !!', '2010-08-17T23:41:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 835435ba-97f2-4e74-b0c1-b02b184b4384, 'Recette excellent ! Mais j''ai du mettre 2 oeufs au lieu d''1 et est remplacer une partie de la farine par du cacao en poudre ! Somme toute la recette est rapide et facile.', '2008-12-09T16:52:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, d750d108-21f3-4205-8a61-a09ea0985230, 'Excellent ces muffins! Moelleux et goûtus :-) Je n''ai pas mis d''abricots mais j''ai ajouté un oeuf. Total 12 muffins au bout de 20 minutes de cuisson à 180°.', '2008-05-28T21:05:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, b6841865-46a6-41aa-a275-f94d0f08098c, 'Très bon. Comme d''autres internautes, je n''ai pas mis d''abricots et j''ai incorporé deux oeufs au lieu d''un. La prochaine fois, j''essaierai avec des pépites de chocolat. Texture parfaite !', '2008-04-23T22:37:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, c6e8e6d8-4e94-428c-8653-d1fdbf3a06cf, 'Super bon, facile et rapide. Cette recette est devenue la recette fétiche de mon fils et de ses copains. Ils cuisinent leur goûter eux-mêmes.', '2008-04-04T19:09:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 0bbf096f-4aa3-4309-a0a6-f021c5685d65, 'Parfait !! Un vrai régal, la recette est facile, il n''y a rien à modifier, juste à se régaler. Merci.', '2007-12-04T19:10:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 198e54d3-a159-4697-8c1f-587cad363de7, 'Effectivement, la texture est mieux avec 2 oeufs. Je n''ai pas mis de bananes mais des morceaux d''abricot. Petit déjeuner sympa.', '2007-05-13T13:56:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 0dc6876f-eca7-416d-a93a-02508fb0bf83, 'Génial, ça part trop vite! J''ai mis 2 petits oeufs. Cela m''a donné 6 gros muffins et 15 bouchées. Je n''ai pas mis d''abricot.', '2007-04-01T21:28:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, 6d253795-f478-47c7-9af0-6b52b757e6b3, 'Délicieux tout simplement, par contre je n''ai pas mis d''abricot. En tout cas j''en referais avec différents fruits. Merci pour la recette.', '2007-02-04T15:47:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49170, bce6bb0e-10f9-413d-ba75-e134dcd3128d, 'C''est vraiment excellent!! Moelleux, très bon, facile à faire ! Je recommande vivement cette recette que j''ai déjà décliné avec tous les fruits que j''avais sous la main... et c''est toujours aussi bon !', '2007-01-15T18:28:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66263, 6e45b7ac-581a-4014-b13a-6ba858728c57, 'Nous avons beaucoup aimé cette recette !', '2019-02-24T03:23:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66263, 54aa469b-feea-4d46-afc2-e5b99252b29f, 'Avec une petite cuillère de Nutella par dessus, un régal. J''ai aussi utilisé des bananes un peu trop mûres. ', '2017-06-17T15:09:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66263, 8283761e-eb5b-4ad7-854d-fef7eb9ccf39, 'Trop bon!!!  Je mets du sucre vanillé dessus, un régal !!!', '2008-03-15T21:15:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66263, 14bf5b29-9a9f-44e7-a184-6b1cc81a87b5, 'J''ai trouve ça un peu fade, pourtant j''ai mis assez de sucre.', '2008-02-05T07:12:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66263, a8c1f707-fcb3-434d-abb9-e4af8aa30c80, 'Idéal pour utiliser des bananes un peu trop mûres que personne ne veut manger! En plus c''est délicieux!!!', '2008-02-04T20:50:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13022, 16ea99bf-6deb-4260-8b6c-4410b1d00b52, 'Très bonne recette, il est vrai, on en mange pas des tonnes mais originale !! Sur des crêpes ou des gaufres, un régal !!! J''ai mis du chocolat en poudre et donc moins de sucre et mes bananes étaient déjà très sucrées . Mes collègues au boulot sont ravies !!! Parfait pour les paniers cadeaux !!!', '2010-09-23T23:54:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13022, 12e75d33-f963-416d-8bb7-23d29c0a9a65, 'J''ai fait cette recette sans le chocolat pour essayer nature, j''ai trouvé ça bon, mais beaucoup trop sucrée, je vais réessayer avec moitié moins de sucre.', '2004-09-29T14:32:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13022, 0553eb29-b0d3-4828-9d34-2e130a5f5156, 'Excellent, mais écoeurant si on abuse...', '2001-10-04T13:23:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (232280, 0a26002e-5ee9-4f64-9c7d-6e61e130567c, 'Très déçu par cette recette, le pain d''épices est très sec, la banane dans la pomme n''a pas vraiment d’intérêt... J''aime épater au moment du dessert mais là c''était plutôt l''inverse !  ', '2014-12-17T12:01:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (225249, 7c323fd5-fb7a-4af5-bc1c-49a08c2c150f, 'Délicieux. ', '2016-05-01T17:11:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (225249, b62dcbc0-50d3-4d79-a4c2-daf8a6f47f81, 'Surprenant et délicieux. Merci !', '2013-01-13T00:31:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65181, c7a53005-4614-4c31-8365-ff281c1bf98d, 'Excellente recette et très facile pour un dessert léger et coloré.', '2017-11-05T13:17:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65181, 7f163d19-ebcf-4515-9818-f5a63c50b33a, 'J''ai ajouté quelques raisins secs, un délice !', '2014-12-09T08:43:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65181, f290956b-4201-4c84-9eb1-1ec48fe91501, 'J''ai mis du fromage blanc vanillé, c''est délicieux !', '2014-09-01T20:11:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 4fe58c06-8d3a-4558-a8d5-236499a1b3a0, 'bon avec slt 125gr de sucre ..de préférence tiède ...a tester avec pepites chocolat', '2023-10-24T19:41:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 53528b8c-ecf5-495a-96b1-849dc53812be, 'vraiment très bon. merci. j’ai ajouté des pépites de chocolat ?', '2020-07-29T13:45:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 9a0a9829-91fe-496c-a404-4091a05525b0, '125g de sucre, pépites de chocolat... parfait ', '2020-04-08T18:32:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, be30bc9f-4c3f-47ca-927c-806dd6e7e402, 'J''ai pas résisté : du rhum et une gousse de vanille.
Croquant sur le dessus, moelleux à l''intérieur.  Englouti en 2 temps 3 mouvements. 
Merci pour cette recette.', '2019-11-02T09:58:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 58e79ddb-9c13-4eac-8333-cfb9892a9be1, 'Mon petit plus c’est de prendre des bananes très mûre ou de les laisser mûrir pour plus de goût je l’ai déjà fait en ajoutant du chocolat benco et c’est un délice on le redemande à tout les coups excellent !! ', '2018-10-05T04:35:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 38295b7b-6aa6-47cd-9c9b-c560262ebcd9, 'J’ai mis 4 bananes et 45 mins seulement au four. C’était parfait. La prochaine fois je ne mettrai que 150g de sucre. Très bonne recette merci.', '2018-03-26T12:20:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 3fd332b6-eff7-4539-85d6-d7ca5e0e980f, 'Super recette !', '2018-01-21T19:05:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, e240f51e-9a77-4f83-a6f2-f24561d5497a, 'Bravo pour cette recette simplissime et excellente ! Je l''ai réalise dans des petits ramequins individuels et j''ai simplement raccourci le temps de cuisson à 30 minutes pour une température de 160°. J''ai obtenu des petits cakes moelleux et aériens.   ', '2017-04-16T01:07:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 54cb6659-14c2-45cb-9546-5140f996000d, 'Super recette ! Le gâteau est moelleux et goûteux ! Et en plus c''est super simple.. je vous le recommande !', '2016-09-25T15:41:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, f631aec5-ebe1-4a64-ae03-09dea34b0e1c, 'Super bon gâteau, j''ai ajouté moins de sucre et pas trop écrasé les bananes pour avoir plus le goût. J''ai également ajouté un peu de rhum.', '2016-04-30T15:11:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, f625bbbb-6e3e-4b34-b07b-f2047618c3de, 'Top avec  45 min de cuisson. ', '2016-02-09T21:58:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, e46c5194-fa4e-44fb-b3bc-d7d433af7ad1, 'Très bon et mœlleux, 30 min de cuisson suffise ensuite j''ai éteint le four mais laisser le gâteau dedans 20 min, par contre le goût de la banane reste léger, je me demande si la prochaine fois j''essaierai avec 4 bananes.', '2016-02-05T18:22:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 1000997f-15a5-4ebb-8ffe-aa1888403ea1, 'Trop simple tout le monde peut le faire.', '2015-09-16T10:44:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 3b94b313-1c1f-48ea-a29a-ea8f555ff134, 'Excellente recette. Je le fais très souvent ! Merci', '2014-10-11T00:48:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 8da4839e-d79e-4c07-b947-6466eefe5445, '30 mn de cuisson suffisent amplement. Sinon super bon !', '2014-07-22T20:24:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 895d84d9-c5ac-465d-a04c-34ead05b2164, 'C''est tout bonnement délicieux ! J''ai suivi la recette à la lettre ou presque car n''ayant pas de sucre roux j''en ai mis du blanc... Pas besoin d''ajouter du lait il est très moelleux tel quel :)', '2014-05-27T23:41:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, da4fc627-c5cd-487a-84aa-7c36a7fdd738, 'Pas sec du tout, se laisse manger très facilement. Mais moi aussi j''aurais dû mettre un peu d''alcool (rhum?) pour relever un peu le goût...', '2013-01-21T19:57:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, ad3b2861-686e-4e6d-9dd6-22da91511063, 'J''ai ajouté du schnaps et des pépites de chocolat : délicieux ! Le gâteau n''a pas fait long feu !', '2011-12-01T04:13:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 9987ff56-d8de-4b91-92af-1859f7310d85, '2 gâteaux à une semaine d''intervalle : bravo !', '2010-10-28T19:38:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 8676a396-bead-4ed5-be60-ab768a646368, 'Surprenant,  j''ai failli moi aussi ajouter du lait car j''avais peur que ce soit sec, mais il n''en est rien, un peu sucré tout de même.', '2009-08-15T13:45:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 54eab85e-96d5-42d9-b4a4-b595cf5031b8, 'Délicieux, j''adore la couleur grâce au sucre roux. J''ai rajouté un peu de lait car la pâte me semblait un peu sèche. La prochaine fois, je le laisserai un peu moins longtemps au four (45 min doivent suffire).', '2009-06-30T19:34:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 6a16f070-f1b8-4b57-825d-bd9ed8c947d9, 'Ce gâteau est très simple et très bon, il se garde bien moelleux plusieurs jours dans de l''aluminium.', '2009-04-17T19:33:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, a0f86250-5e5b-4d7a-ba9a-0f66245a9923, 'Adapté selon les commentaires, c''est-à-dire avec ajout d''un peu de rhum, de pépites de chocolat, et cuit seulement 40 minutes. Testé dans un restaurant, succès total ! Je le conserve parmi mes favoris, surtout que cette recette est archi simple ! Merci... ', '2009-04-09T18:32:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 8c4fd8bb-e537-4be5-809f-e1f6b0b0dc4e, 'J''ai ajouté des morceaux de chocolat et personnellement j''ai apprécié ce gâteau. Mais mon mari, pas du tout! Il lui reproche une consistance de pudding! Alors tant pis, je cherche encore une recette de gâteau à la banane qui plaira à toute la famille! Merci pour cette recette! ', '2008-10-26T00:54:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 27089353-dae7-46a5-900c-51ad4717dbfd, 'Je l''ai goûté froid et j''ai trouvé ce gâteau beaucoup trop compact, limite lourd. Dommage...', '2008-07-26T15:21:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 7cc0c0d8-c04a-4d77-ad1f-6754def507bf, 'Délicieux et si facile !!!! Mon mari adore...il ne mangerait que ça. J''ajoute des pépites de chocolat (une demi-tablette de chocolat noir que je casse...les morceaux sont + ou - gros, hum !) Et quand il sort du four...encore meilleur ! Et si éventuellemnt il en reste... ne pas hésiter à le réchauffer. Merci beaucoup et bravo !', '2007-12-19T15:45:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 673ba17a-1b1d-4cb3-93ba-d2e2a2311a08, 'Vraiment très bon et original ! Par contre, j''ai rajouté un peu de lait à la pâte : la consistance me paraissait vraiment trop sèche, et j''ai bien fait. Chaud c''est un régal...', '2007-11-18T19:23:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 397f8cd4-b337-47ba-b176-23e4842ab799, 'Ultra rapide, ultra facile et super bon! Le gâteau est parti en une journée! J''y ai rajouté des petits morceaux de chocolat noir (je suis très chocolat), c''était un délice! Tiens je vais le refaire ce soir je pense..', '2007-10-23T17:04:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 363636e8-fe28-429f-b9c8-d6e8a1f869ac, 'Un seul mot wawwwwwww, il est génial!Enfin un gâteau à la banane léger et délicieux! Une recette a recommandé à tous.', '2007-07-23T19:26:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, fd6a40aa-f550-4b55-8241-d2db969c11c8, 'Excellent! Très moelleux, les enfants ont adoré. J''ai rajouté un peu de lait pour délayer la pâte. A refaire!', '2007-03-31T00:41:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, b2ffa6f9-66b7-426b-a15e-e2bf29d59aec, 'Merci pour cette recette, toute simple et appréciée!', '2007-01-05T19:42:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 9db234e3-5836-49d7-a689-f80563070fde, 'Super recette. Je l''ai servi dans une crème anglaise avec quelques filets de chocolat chaud pour la déco ... tout le monde a été épaté!!!', '2006-11-21T11:27:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 472ee046-df97-47ec-a677-26f3810d41c7, 'Très bon gâteau, à faire et à refaire! J''ai diminué la durée de cuisson car au bout de 40 min mon gâteau était bien gonflé et brun :o) Merci pour cette recette!', '2006-07-23T21:13:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, b06adb4d-1d11-4cf5-8d22-9db6a4fed0e4, 'Très bon gâteau à la banane. Il est vraiment moelleux et souvoureux. J''ai mis de la cannelle qui se marie très bien avec la banane et un peu de rhum comme indiqué, un véritable régal!', '2006-05-31T17:21:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, cbe0364a-ac52-479c-873c-063b952fdc0c, 'Vraiment succulent et très simple. N''hésitez pas à mettre du rhum. ', '2006-03-14T15:21:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 5c2fa25a-8e9f-4262-8b95-58003b8d48bb, 'Un délicieux gâteau... avec très peu de beurre! La pâte est légère, moelleuse, très parfumée et ce gâteau se conserve très bien sans se déssécher. L''essayer, c''est l''adopter! Félicitations, Eric.', '2006-02-10T17:13:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, dd3a6f46-083b-4454-b89a-8b3376a50328, 'Excellent! Très moelleux et avec une pointe de cannelle et de rhum brun... Mmm, un régal! Essayez vite!', '2006-01-30T18:47:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, 516e6799-1e9c-4bc6-a230-c81d798b7c21, 'Excellent, très moelleux, et pas trop lourd pour un gâteau à la banane. J''étais un peu inquiète, en voyant la consistance de la pâte, avant l''ajout des bananes, car c''est plutôt compact, mais c''est normal! Merci pour cette recette.', '2005-10-27T15:20:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, a827387a-0b9d-4798-9b09-7a0e18b46b89, 'Très léger et agréable au goûter, encore meilleur lorsqu''on y ajoute un peu de cannelle et une cuillère à soupe de rhum brun.', '2005-05-16T16:36:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33735, fcc83e8b-4c0b-47f9-9133-b2144446e133, 'Très moelleux et léger ce qui pour un gâteau à la banane est un bon point. Plutôt pour 8 personnes. ', '2005-01-14T11:01:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (308808, 6d9962ad-8010-4a78-8b0e-4df18e938775, 'Il faut préciser la quantité d''eau, car la pâte devient beaucoup trop liquide !!!', '2022-11-13T11:40:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (308808, 662bd3aa-7c9f-44ad-b1d2-ce28ffc437d9, 'Ça se mange mais nous avons été déçus. Je ne referai pas cette recette', '2015-12-01T12:00:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (308808, 86aa3bd0-1b32-4a77-9b04-6bedb3643611, 'Très bon, croustillant dehors, fondant dedans. Pas trop sucré, on sent bien la banane. On les avale les uns après les autres sans s''en rendre compte !', '2014-02-16T20:40:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (308808, 74b23989-cb58-4687-9b3a-da9c8009beaa, 'Cochon ! Vraiment délicieux ! La mascarpone donne un effet fondant à tomber à la renverse. Même mon mari qui n''est pas chocolat a adoré. ', '2013-11-25T01:09:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36132, d0568776-0612-4440-99b7-7c40c18e772b, 'Simple rapide et super bon!!! Pour ne pas salir mon grille pain, je les ai cuit dans la machine à croque monsieur.', '2009-03-08T13:13:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36132, 51b3f368-7c89-4f25-a8b1-f66999fbcc94, 'On peut également les passer au four à la place du grille-pain.', '2008-05-12T17:04:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36132, fec459a7-60c9-4455-9e36-52bf122a57ef, 'Délicieux...J''ai testé avec des prunes en attendant les bananes...C''est un remix du toast au nut'' en meilleur...et en plus ça fait déculpabiliser (ben non, c''est pas un toast au nut'', c''est un toast aux fruits :)) Merci :)', '2006-09-03T19:09:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36132, 89fdb80f-eb59-47a6-b7cb-630c253b9b55, 'Rien à dire, c''est excellent! Parfait pour combler le petit creux de l''après-midi et ceci avec un simple grille-pain.', '2006-08-29T20:00:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36132, c684c5fc-ee7f-493a-af08-f6bbf06d1d3f, 'Trop génial cette recette, facile et délicieux, il suffit d''un peu de banane et de nutella.', '2005-11-10T07:57:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, acb45f43-eff7-425a-9ebf-e3d3214e553d, 'Alors moi je fais des "bananes au jambon" depuis tout petit et on adore. Je les fais a la poele quand je n''ai pas le temps. Ça caramélise les bananes dans le beurre et les sucs de jambon se melangent a la crème et au fromage. Je ne mettais pas de moutarde ni chapelure jusque lá mais je suis sûr que c''est delicieux.
', '2020-11-15T10:38:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 32b2dbeb-34c0-41db-b5ed-b1d01d3298a4, 'À refaire mais avec des bananes plantains (goût sucré beaucoup moins prononcé) et une béchamel.', '2016-04-29T22:21:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, f1584168-c50b-4a4f-b6b8-5667ea6ccf80, 'Bien que surprenante, l''association banane-jambon passe très bien mais la banane est trop présente et fait que la recette devient vite écoeurante. Je referai avec plaisir, mais en divisant cette fois la quantité de banane par 2 (au moins).', '2016-02-18T11:43:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 8ef2e0d6-c729-4c65-8986-ead88c4cf608, 'J''aime bien la banane, mais là j''ai été déçu par cette recette. J''ai trouvé ce mélange écoeurant... heureusement que je n''ai pas salé, comme indiqué dans la recette. Personne n''a voulu de mon plat, j''ai dû me taper les 4 portons tout seul. Je la retire de mon carnet de recettes. En revanche, je pense qu''avec des endives ou des coeurs de céleri (ou de fenouil) cela serait génial, à mon avis.', '2014-08-19T22:38:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 250cd688-8a29-44c0-a652-e095f96cef5e, 'En un seul mot terrible ! Si vous avez que de la crème fraiche épaisse, vous pouvez la rendre liquide avec un peu de lait ! C''est très fin, la moutarde crée un équilibre avec la puissance sucrée de la banane. Copieux ! J''en ai mangé deux j''en pouvais plus !', '2012-04-18T23:06:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, edb7d2dd-8a24-4d2b-bcd0-a97eb781d5da, 'Très très bon mais mes loulous eux n''ont pas aimé.', '2012-04-12T22:46:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 06214d4e-a651-419f-bba8-bb15cc1b73df, 'Enfin je trouve le vrai nom de cette recette donnée comme ça à l''oral entre 2 portes... Merci. Rien à redire...', '2012-04-04T00:14:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 90ba8ee2-cc5a-4c93-b847-5b69b8eedb60, 'Lassée des bananes flambées et des endives roulées au jambon, et ayant quelques bananes un peu mûres (contrairement à ce qui est indiqué dans la recette !) j''ai testé ce plat. C''est effectivement très bon, surtout si on apprécie le sucré/salé.  J''ai laissé au four 15 min et zappé la phase "gril". Bien enduire de moutarde pour obtenir un goût prononcé.', '2012-01-31T16:49:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 928c75ac-99f4-402a-9118-3bfc671a1adc, 'Je suis pourtant fan du sucré salé, et les mélanges improbables ne me font pas peur, mais je n''ai pas du tout aimé cette recette là (que j''ai suivie à la lettre) J''ai trouvé ça mauvais et très écœurant, je suis contente de l''avoir testé en solo !', '2011-11-06T21:02:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 27ef1472-b6ba-460a-bef0-3851f966a08d, 'Excellent, et très facile à réaliser. Ne pas prévoir de grosse entrée ni de dessert lourd, car c''est effectivement très copieux.', '2011-07-17T23:42:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, e9dba498-15cd-495c-a18c-567e702ec505, 'Sceptique au vu de la liste des ingrédients, mais très bon.', '2011-03-13T17:59:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, d65592ae-1b87-4b92-af5b-fe845dd27262, 'Surprenant, très bon mais un peu (beaucoup) lourd.  Repas qui tient au corps et pourtant recette réalisée un peu différemment. Bananes entières roulées dans une tranche de jambon sur laquelle j''ai mis un peu de moutarde, placées dans le plat avec la crème, saupoudrées de fromage râpé et mis au four.', '2010-12-03T12:46:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 738bbc43-b7cf-4ed1-aba8-2bc44d9ae895, 'Excellente surprise, pourtant j''étais plutôt sceptique...', '2010-11-16T13:47:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 380825c6-b380-4f2d-b7ce-0140f59ce4d1, 'J''ai testé la recette le 18/9/2010. perso, j''ai adoré mais mes enfants (9 et 11 ans) n''ont pas du tout aimé. Dommage, peut-être la nouveauté...', '2010-09-19T13:18:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 01e32c07-e6e6-4743-86d4-9f1b50ff158f, 'Mélange original et très bon, que je referais avec plaisir. Je n''ai utilisé que 3 barriques de crème fraiche et moitié moins de fromage râpé aussi. A défaut de four, j''ai utilisé le micro ondes pour faire fondre le fromage et chauffer le tout.', '2009-12-02T01:08:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, b90b25c7-bc49-48e6-b4d1-cf68066a7e6c, 'Rapide, pas cher et bon.', '2009-03-08T05:42:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 053af25b-9199-4322-a82d-13e7f5fc61ad, 'Trop bon. Rien à dire même pour les enfants. Merci.', '2008-04-06T14:19:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 77bd1899-3a41-433b-89bb-ae63efaf5275, 'A essayer absolument, difficile de deviner le goût avant d''y avoir gouté! Ne pas hésiter sur la moutarde qui contraste avec le sucré de la banane. Je n''ai pas mis beaucoup de crème fraîche, pas mis de chapelure ni de beurre et c''était délicieux!', '2008-01-11T22:35:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, a6620d6c-20d7-4e7a-addc-4c5574167bf3, 'Délicieux ! Avec un mélange sucré-salé assez surprenant...', '2006-07-12T22:11:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, b53120f8-bacf-408d-9e47-570ce8d26190, 'Très bon. Néanmoins mieux vaut ne pas trop en manger, ça cale vite! Le mélange sucré salé est stupéfiant.', '2006-06-09T16:43:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, da35b32f-6735-45aa-b377-9ffc80cb3c70, 'Un mélange sucré-salé surprenant et délicieux. Je l''ai réalisé avec du jambon cru. C''était très bon. Merci pour cette recette !', '2006-05-28T15:43:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 86a9ace8-93a5-4ab7-93f0-78f4082a6d7d, 'Ce plat est un délice! J''avais prévu 5 bananes et on a tout dévoré à "2 et demi". Ma fille de 4 ans s''est régalée et nous également. C''est facile, rapide et franchement succulent. Recette à refaire encore et encore.  Merci beaucoup !', '2006-05-13T21:21:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 8e30d258-c944-4897-9872-ee7fbc8d1bd8, 'Merci et bravo pour cette recette, elle est délicieuse. Facile et rapide à faire.', '2006-02-21T20:14:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 315cc6d7-b18c-460c-a870-fc90a9ee381d, 'Sceptique à l''énoncé de la recette, ce fut une divine surprise lors de la dégustation de cette entrée originale et savoureuse. Un grand bravo! Pour toute la tablée, ce fut un régal.', '2005-02-27T14:52:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 4cdf9209-bb23-446a-86fa-2548b3693bd7, 'Pas mal... Mieux vaut prolonger la cuisson si on veut des bananes fondantes.', '2004-12-15T21:35:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21619, 235a5a65-fbd5-4b2e-8626-d783c8c54883, 'Très simple, très bon... J''ai ajouté un peu de curry. Invités surpris et contents.', '2003-06-12T12:16:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73861, c9246134-b4e4-41a1-aa9a-39dade8fed1f, 'Simple, rapide et très bon', '2023-04-15T13:54:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73861, 474db1c7-ede0-4de9-aab1-69239ca87111, 'Un délice. Le mélange bananes/chocolat peut faire peur (réputé assez "lourd") mais ce gâteau est très léger. Je l''ai fait pour ma part avec 120g de chocolat pâtissier coupé en morceaux. C''est encore meilleur servit tiède, le chocolat fond. A refaire sans hésiter.', '2017-07-26T11:27:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73861, cba01a4b-b863-4cb2-b53a-271fe28c0ace, 'Il y avait du monde et j''ai fait cette recette avec des morceaux de chocolat noir a la place des pépites une tuerie. Une des meilleures recette que j''ai jamais faite ! (Léo 8 ans et demie )', '2017-05-25T22:00:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73861, afb16288-d0d2-41b4-b567-d6f8c12f9987, 'Une tuerie !', '2016-10-31T20:35:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73861, 331c5bd1-9ae9-420d-b3b6-c46c8bbb2d81, 'Vraiment délicieux!', '2016-02-18T11:56:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73861, 6393bca8-8db6-4b71-a5fa-a24ece3b73b7, 'Excellent !! Identique à la photo, fait avec une tablette de chocolat ', '2016-02-11T12:58:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73861, 75741be4-45ae-4acc-ad19-3d0d0916779b, 'Je l''ai fait plusieurs fois et il est vraiment délicieux, tout le monde l''a adoré !', '2015-07-31T17:04:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73861, ce6cec76-6c09-41f5-a8d3-cc0ed205b66a, 'Excellent. Ce sont les enfants qui  l''ont fait, un régale. Et avec une crème anglaise ça va être encore meilleure', '2015-02-14T13:57:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73861, 93902ed6-7d15-4825-9062-07abc98b9d58, 'Simplement délicieux !', '2014-01-21T16:00:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73861, a5dfd701-0f81-4c6d-acc3-f67754712c2c, 'Très bon !', '2013-11-03T16:34:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73861, 0d6c9282-ec1b-402c-8ab1-9feb6b5887db, 'C''est très bon mais avec de la crème anglaise c''est meilleur', '2012-06-25T00:51:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73861, 6c0a021f-e725-4eec-9ba7-5704dd4b57bd, 'Ça fait plusieurs fois que je fais cette recette et elle est géniale. J''écrase les bananes à la fourchette. Les proportions sont les bonnes : j''ai essayé de les changer mais il y avait soit trop de chocolat soit trop de bananes... Je le fais dans un moule à manquer car je trouve que la cuisson est plus facile. Ce gâteau rencontre tout le temps un franc succès et mes amis en redemandent. Ça détrône et de loin le traditionnel gâteau au chocolat !', '2011-09-28T14:30:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73861, f222b614-2bfd-45d5-b64e-0faa863b2dc2, 'Très bon! J''ai mis seulement 100 g de sucre et 100 g de beurre et fait cuire dans des moules à muffins individuels et c''était parfait!', '2008-09-21T23:22:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, 4506c58a-6b48-4eab-93b0-3fa334e8ff04, 'Excellent dessert. J''ai changé quelques éléments de la recette, 2 kiwis, 2 bananes et je fais fondre les 100 g de chocolat dans le lait. ', '2013-04-05T14:35:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, 33450823-c59d-48fb-80fd-2dedd48e11df, 'Très bon !', '2024-01-30T21:24:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, b75c5da9-894b-4ced-8b5b-fb750a19b4a3, 'Très bonne recettes, voir juste moins de sucre avec le chocolat blanc qui est déjà assez sucré ', '2021-04-28T19:51:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, 4382c069-df9d-4812-a070-5505b7a1dc17, 'Très bonne recette. Par contre mettre 1 tablette entière de chocolat blanc. Ma petite famille me réclame 1 fois par semaine ce délicieux clafouti', '2019-01-30T22:06:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, 35318f1a-883c-480b-889f-ae444cc0005c, 'Excellent! Dommage qu''on ne sent pas le chocolat blanc. Je mettrai toute la tablette la prochaine fois! ', '2017-04-10T21:44:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, 69bfbc50-729e-4b0e-9715-ca252dba95b7, 'Très bon mais effectivement le temps de cuisson est trop court, au moins 60 minutes voire plus ! ', '2015-12-21T19:51:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, 36351f18-373a-4a13-b6a9-afd9be5d3999, 'Super bon ! En revanche, je n''ai pas du tout senti le goût du chocolat blanc. J''ai également mis 2 kiwis et 2 bananes. La prochaine fois, je testerai les proportions proposées par Stille.', '2015-07-02T13:53:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, f5e34e96-7382-4814-b517-8ef465b73fc6, 'Très bon cependant c''est assez bourratif. Conseil : c''est encore meilleur le lendemain. ', '2013-08-30T21:37:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, 02ee1df7-a382-42ea-946c-493635502c6f, 'Je n''avais pas de bananes alors j''ai mis plus de kiwis, et ai suivi le reste de la recette à la lettre : très bon !!! Tout le monde a adoré, merci pour cette recette, déjà dans mes favorites !', '2013-01-05T17:39:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, a8356981-d3e2-46c1-a37a-745bd0528e1d, 'C''est sympa mais bourratif ! Le kiwi et la banane se marient bien ensemble. Par contre je n''ai pas l''impression de sentir le chocolat blanc. J''ai apporté des modifications à la recette, à savoir 3 œufs entiers, 2 bananes moyennes, 2 beaux kiwis mûrs, en lieu et place des 130 g de sucre, j''ai mis 60 g de sucre blanc, 60 g de sucre roux (ce qui apporte un petit goût sympa en plus) et 2 sachets de sucre vanillé, 60 g de beurre au lieu de 40 g. J''ai fait cuire environ 1 h (mais en surveillant) à 190°C du coup c''est bien ferme, car quand c''est trop crémeux je trouve que ça pèse sur l''estomac.', '2011-12-30T23:51:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, e3336e35-c536-4f92-a11d-c620404b242a, 'Cette recette m''a donné envie de mettre un commentaire : excellent !!! Frais, très simple à réaliser. Tous mes invités ont été conquis ! J''ai mis 2 bananes par contre et à la 2ème réalisation, je n''ai pas mis les copeaux de chocolat blanc car je n''avais pas trouvé ça très esthétique au 1er essai. A refaire ! ', '2011-07-07T19:57:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, 5884b033-3bfb-4f11-aec6-5f3ab349b2c6, 'Super bon et très facile ! On m''a déjà demandé 2 fois la recette. Pour ma part, 3 œufs suffisent. Par contre, j''ai mis 2 bananes et 3 kiwis. Un délice, je l''ai déjà fait 3 fois. Merci pour cette recette.', '2011-04-27T12:32:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, ce335748-759e-436e-8cfa-7bd9b751821b, 'Et voilà la recette qui m''a décidée à mettre pour la 1ère fois un commentaire. Excellent dessert et une bonne manière d''utiliser les bananes. Je le referai c''est sûr ! Je n''avais que du toblerone blanc et le résultat était parfait. ', '2011-04-25T13:38:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, 9efb06e8-d584-4a65-88e7-88a861547e46, 'Ne changez rien c''est un régal !! Prenez juste des kiwis bien mûrs et cuisinez réaliser le comme indiqué. Merci pour cette recette...', '2010-02-05T12:31:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, 5f73b115-28ea-4a08-9283-61d1e299c9e6, 'Très bon ! Par contre, j''ai mis deux bananes et deux kiwis.', '2010-01-21T18:21:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, ecc3cc4f-d6b4-4567-8fd3-0f840a88e50e, 'SUPER bon ! A refaire, mais je rajouterai un petit verre de rhum qui se mariera bien avec la banane et le kiwi, sinon à essayer aussi avec d''autres fruits, mais surtout garder la recette de la pâte, un délice ! Bravo et merci pour cette recette.', '2009-06-01T22:30:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, 5dc5e610-31a3-4605-bd0d-6a92a3fbd671, 'C''est recette est absolument délicieuse et très facile à réaliser. Elle a fait l''unanimité auprès de mes invités. J''ai simplement mis moins de kiwis et plus de bananes (2 kiwis, 2 bananes).', '2009-05-31T00:47:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, 38a5b19c-8b27-450d-9dba-0bbf2f82dc88, 'Petit bémol : on ne sent pas beaucoup le chocolat blanc mais très bon cependant.', '2009-05-04T12:53:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, a28464f3-e65a-4c3c-8022-fd6a8afcfdbb, 'Waouh !! Excellent, si je pouvais mettre la note de 6 je la mettrais !! Simple à faire, léger ! A refaire !', '2009-03-25T17:30:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84460, 2af0baad-2f55-4309-bbdf-e0bb90be7a87, 'Facile à faire et très bon. Je n''ai mis que 3 oeufs au lieu de 4 et 2 bananes au lieu d''une.', '2009-03-09T14:25:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223564, 0b9521ce-333e-448f-bae5-48f5a044ac81, 'Résultat peu appétissant : aspect un peu sec, bananes noircies et meringue raplapla. Goût très moyen.', '2012-04-08T12:27:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339904, 0fed6e11-d80b-4ef6-9980-1de0a2be9525, 'Excellente association de saveurs que je n''aurais jamais tenté de moi même.  Je recommande et je la referai volontiers. Merci.', '2021-09-12T22:57:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (231123, 008f8d6c-10f1-44a7-a9d6-255a8d1b0747, 'Ce n''était pas bon', '2015-02-04T19:18:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25327, 13bc6ccd-691a-42ed-87b1-8cace174e2bb, 'L''expérience satisfaisante est là. J''ai mis des fraises et bananes comme indiqué. Fameux tiède Marmiton ! Je vais tester à température ambiante.', '2022-05-16T13:59:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25327, d68a7622-760d-4997-b467-8f392eb6c023, 'Très bonne recette! Mon sabayon était bien mousseux mais manquait un peu ''de corps'', mais mes invités ont adoré.', '2003-12-20T10:39:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51547, 85ca2bb8-0529-40f2-b14f-ab4dd0d48b00, 'Le seul problème dans cette recette, c''est l''huile de lin...et c''est vraiment pas bon! Mais, c''est la vraie recette du Dr Kousmine. Pour ma part, j''ai remplacé l''huile de lin par de l''huile de germe de blé, ce qui au goût est vraiment incomparable et qui a les mêmes vertus...essayer, c''est l''adopter !', '2006-11-07T13:56:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (310850, df4f2882-6342-48e5-a1a8-447138718e13, 'Facile à faire et très bon', '2020-05-25T17:20:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (310850, bf97905f-15ac-4043-85f3-e23530afd524, 'Un délice ... mes enfants ont adoré ! Ça change du lait classique. Servir bien frais ', '2017-02-27T01:24:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (310850, a47bdfc9-0e3e-48af-a132-dc8201ca7190, 'J''y ai ajouté 3 carrés de chocolat pâtissier au praliné, un délice.', '2014-07-10T18:43:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (330245, 8d3d2e06-1ed7-4176-ad28-60f982218f52, 'Délicieux. Je le referai !', '2021-08-03T13:44:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 3190a8f3-dfe2-42b7-b5cd-dcdcca07709f, 'Problème dans les quantités. ', '2022-09-24T19:42:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 0b78a7c2-41c5-431a-a2db-ded4ed4166e6, 'Très franchement, je ne comprends pas la note de cette recette.
Les proportions ne sont pas bonnes, il y a beaucoup trop de farine, obligée d''ajouter un oeuf puis de la crème fraiche pour que la texture soit assez souple pour intégrer les fruits. Le goût est cependant correct et agréable après cuisson. 40min pour notre four.', '2019-09-25T07:51:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 605b14e8-7be0-47ab-9110-0cd9c8b65d2f, 'Bien trop compact pour intégrer les fruits. J''ai dû rajouter de la crème liquide et de la vanille liquide pour que ce soit plus souple. Il cuit, donc je ne peux pas commenter le goût. Ah et je n''ai aussi mis qu''une pomme, j''ai estimé que cela ferait trop deux pommes et deux bananes. À voir. ', '2024-02-10T11:44:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, c48f6a31-64c9-4d97-993f-6013b07689e3, 'Très moelleux et léger. Tout le monde a adoré !', '2022-12-24T13:58:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 2fb62051-9e4a-45f8-9c9d-5696f384a7db, 'J''ai adapté la recette car trop de farine ...
J''ai ajouté du lait, de la cannelle et du rhum pour le goût. J''ai écrasé les bananes.', '2019-05-08T09:12:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 802411b5-f58a-47bb-8843-e03f43fd441d, 'Fait avec 3 oeufs, 200g de farine et 100g de sucre comme conseillé dans les commentaires. J''y ai ajouté un peu de cannelle et de miel. C''est un régal ! Je garde la recette bien précieusement, à refaire sans modération.', '2019-02-27T05:09:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 74efd677-8201-48e5-9b63-52fad340d46a, 'Très bon mais pas assez de liant, j''ai dont rajouté un œuf et un peu de fromage blanc (à défaut de lait) ', '2023-11-09T16:10:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 78619463-0d5d-415e-82c0-7891a426e387, 'Absolument délicieux et moelleux. J’ai ajouté 10cl de lait. Avec  des noix hachées grossièrement et une grosse pomme et deux bananes. A refaire.', '2023-03-15T13:45:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 27cbbabf-38e9-4cb8-9c40-20ca26dd585e, 'Miam-miam ', '2023-03-05T14:56:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 0820abf5-d7cd-4620-bba3-b795740c1a08, 'Ça fait plusieurs année que je fais ce cake, je fais le mélange au fouet et en effet la pâte paraît trop dense mais je mélange à la cuillère les fruits et je n''ai pas besoin d''ajuster les doses et c''est juste un délice et très moelleux ! Je vous assure, essayer de suivre la recette, c''est une réussite. ', '2023-02-01T17:34:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 26c55e9e-7776-443a-af41-06167c2f29ec, 'Excellent, très moelleux, encore meilleur avec un peu de farine complète et de cannelle.', '2022-05-20T09:04:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 984b69a4-7de0-4a04-81a8-a6c599725542, 'Très bon cake! J’ai cependant modifié les quantités en mettant 50gr de poudre d’amande à la place de la farine et 100gr de sucre avec un sachet de sucre vanille ?', '2021-01-30T19:11:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 818e01b8-6e55-4a05-8312-1f761f885910, 'Très bon cake ! Je l''ai fait avec plein de fruits et fruits à coques différents et c''est toujours un délice !', '2020-12-28T14:58:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 6d066b50-ef1f-4a1c-a114-aa88607cfb2c, 'Bon gâteau. La texture n''est pas trop moelleuse par endroit mais peut-être est-ce du au fait que j''ai un peu trop travaillé la pate. J''y ai rajouté quelque pépites de chocolat. Nous avons bien aimé. Merci.', '2020-11-16T21:15:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 66586ecb-a79e-4fc3-a50c-63f22e4396c3, 'Cake pas du tout moelleux. Il est beaucoup trop serré. J’ai pourtant rajouté du lait. Il y a beaucoup trop de farine. Il est fade et pourtant j’ai flambé les bananes au rhum.', '2020-10-04T20:31:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, a2d74565-0a8e-45d1-b93b-f0ad21c74e32, 'Merci pour cette recette, j''ai également mis moins de sucre et de farine. + rajout d''un peu de lait et de cannelle : ) ', '2020-10-04T16:55:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 953ab7e7-e70a-4def-bcb3-a911824a8475, 'Çe ne sera pas 5 étoiles pour moi car j’ai du rajouté du lait (trop de farine). Cependant le goût est très agréable et a plus a tout le monde.', '2019-12-23T20:59:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, b5898612-ea70-46d5-a4ba-5fe4cf953475, 'Bonne recette juste rajouté 1 oeuf, et mis la levure avant la farine. 
Je l''ai réalisé plusieurs fois : pomme, pomme poire, pomme banane, bref compatible pour toutes sortes de combinaisons. Merci. ??', '2019-10-31T02:33:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 3d12c636-4f24-42c4-8d63-f08c81817880, 'Excellente recette ! Réalisée en diminuant le sucre et ajout de lait comme indiqué dans les commentaires précédents.', '2019-06-01T12:29:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, e20ab24f-af35-4414-93bc-b6a65f7bc0df, 'J’ai rajouté un peu de lait pour rendre la pâte plus souple, le cake était délicieux et hyper moelleux ', '2019-05-16T05:03:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 205634c7-478f-4f39-a0bf-897a51d14347, 'J''ai rajouté 100 ml de lait, 50 ml de rhum et 100g de noix. DÉLICIEUX !', '2018-03-09T11:18:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, b7115c09-d4e3-4aad-87a6-253d64d41185, 'Inspirée par les différents commentaires précédents, j''ai fait caraméliser mes fruits avant de les incorporer à la pâte : résultat concluant !', '2017-08-15T12:06:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 6137036c-df14-44d6-be58-f575443c8be2, 'Recette très bonne déjà faite, un régal...mais je ne mets pas de pommes 🍎 ', '2023-04-25T21:48:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 9f2e7201-d83d-4296-ab8b-271c433857e6, 'Un délice, mes proches se sont régalés !', '2022-09-08T17:17:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, d45de144-5744-418b-b8f4-1c8a2b36b459, 'Excellente recette. J''ai mis du sirop d''agave et un carré de chocolat noir.', '2022-08-15T20:11:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 68c00c6a-ba2a-4dd1-b374-3a633109871b, 'Très bon 
', '2022-06-07T20:33:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 748de91f-ae68-450e-83bc-2d2fe740cf0b, 'Moi aussi j''ai ajouté 10cl de lait et .... des pépites de chocolat !! Très bon', '2022-02-06T14:23:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, bcf4b128-62c0-4396-b1be-d68b2f8953c7, 'C''est parfait à mon avis', '2021-12-14T17:11:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 5b4c92dc-8c03-4028-ba2b-edcfb777bad5, 'J''ajoute 10 cl de lait supplémentaire', '2021-11-24T23:59:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 3be2dd06-1831-4e6e-9e4c-3df1015470ab, 'Super recette, ça fait plusieurs fois que je la réalise, les enfants adorent', '2021-02-09T16:21:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 5caf79ce-d3f4-490a-9823-be48078c3d7c, 'Testé aux mirabelles en modifiant la recette 3 oeufs 200g de farine 75g de sucre 75 g de beurre 1 sachet de levure et 2 cuillères à soupe de fleur d''oranger. Vraiment bon et moelleux ', '2020-09-06T22:01:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 36c7ebdb-e0a7-431a-842d-075829182abc, 'Je l''ai fait en suivant les commentaires.
100g de sucre
200g de farine
Un peu de lait
Un peu de cannelle 
Un délice ', '2020-04-22T00:09:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 1395e7bd-1134-4c99-b511-7805634a7e1d, 'Super moelleux et super bon !!
Pour un cake sans gluten: 100g de farine de riz (ou de châtaigne) + 90g de poudre d''amandes (ou 2 cuillères à soupe de maïzena).
Le petit plus pour un cake ultra moelleux: laisser finir de cuir four éteint les 20mn dernières minutes.', '2020-04-02T17:48:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 240ff6e8-1683-4480-8385-7b07526a79cf, 'Pâte trop dure. J''ai du rajouter du lait. Je déconseille cette recette', '2020-04-01T18:43:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, eaac9406-012d-438f-ae74-80104b0e82ce, 'Recette facile à effectuer, cependant les dosages ne sont pas du tout proportionnels et j''ai dû ajuster pour que la consistance de la pâte soit correcte (seulement 200g de farine, ajout d''un oeuf et de 15 cl de lait)', '2020-03-29T10:26:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 4d99614e-3c74-461d-b819-b8636801544d, 'Très bonne recette :) ', '2020-03-26T12:10:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 2a38830e-d01d-452f-a918-8fa613ce696c, 'Excellente recette. J''ai également rajouté des pépites de chocolat, à refaire.', '2019-12-05T07:27:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 2a2986e5-6cab-44f5-867d-4f04bb730ae9, 'Excellente recette, très moelleuse !
Je recommande !
Essayée aussi avec un peu de poudre de noisette et 2 gouttes d''amande amère à la place des bananes', '2019-05-26T01:36:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 143d77fd-08f5-4d84-ae28-ea940462beee, 'Mes enfants ont adoré, j''ai rajouté un peu de lait (200 ml) sinon, rien à dire, vraiment excellent.', '2019-05-12T07:25:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 6d265090-e265-4d43-b638-dcd1e48c81fb, 'Cuit en cocotte au four : cela rallonge juste le temps de cuisson pour un rendu moelleux sans croûte', '2019-03-15T12:57:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 0b91c787-e2fa-4c21-9518-a75faf7cb5e8, 'Moi qui ne suis pas fan des gâteaux sans chocolat, celui-ci m''a bluffé ! Il est simplement à tomber, tout le monde chez moi a adoré, merci !', '2019-02-04T06:19:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, a18c4439-a859-419e-8a4a-961a44a03d5b, 'Très moelleux avec 2 bananes et 3 pommes. 100 g de sucre ont suffit. Par contre ajout de lait dans la pâte.', '2018-11-11T00:27:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 2a359a4d-5d9e-46ba-874a-8996a96774f7, 'Il a fait un malheur auprès de mon copain à refaire sans hésitation !', '2018-09-20T09:50:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, c11da11b-6ea2-4979-8496-a7eb4916e421, 'Grand succès chez nous! Même ma fille qui est tres difficile avec les gâteaux aux fruits a adoré! J ai juste rajouté un peu de lait, mis uniquement 100gr de sucre et 1h de cuisson!', '2018-04-23T11:51:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, c239a17c-d048-401d-9f04-69e3e61e4ccb, 'Peu compact au début mais finalement le cake est excellent. J''ai ajouté des noix.', '2017-11-04T14:26:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 5400fc05-fd6e-4c06-86f6-cb185b043c7b, 'Un cake parfait, moelleux, aéré... J''ai mit 150g de sucre pour qu''il soit moins fade, 5ml de lait et le tour était joué ! Je valide cette recette marmiton, tout le monde s''est régalé.', '2017-11-01T21:57:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 00fd2884-5bef-42a3-87ff-2f68466f3d12, 'Très bon. J''ai mis une pomme et une banane, un vrai plaisir.', '2017-10-25T22:35:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 63133fd2-5308-44b7-94b3-4293e745f880, 'Bon gateau. Un peux fade en gout et j''ai du rajouté un peu de lait. On devrait le dire dans la recette mais sans dose comme ça, tout le monde peux choisir si il en veux ou pas.', '2017-06-02T09:21:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, e3c04d88-c660-4b37-ad6e-5ab4ebf33b0c, 'Excellent. Testé avec pommes, bananes et noix. j''ai ajouté 5 ml de lait mais finalement pas sûr que ce soit utile même si au début la pâte semble assez épaisse. je réessayerai sans.', '2017-05-26T23:10:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 9cab52b6-f395-499b-be81-ff0176ff9464, 'Tres bonne recette. Pas besoin d''ajouter du lait si on ajoute progressivement la farine. Je l''ai ajouté en 4 fois. Gateau tres moelleux. A refaire', '2017-05-21T22:06:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 13403dd3-345e-4c18-a263-bc63609e4918, 'Très bon et moelleux!', '2017-05-08T20:25:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 103de902-3c19-4766-92f2-bab1322fff1a, 'Gâteau succulent ! J''ai mis les trois : pommes, bananes et noix. Hyper moelleux. On s''est bien régalé. Je l''ai gardé 5 jours, pour le petit déjeuner.', '2017-03-22T17:44:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, e9f1c18c-c52f-4ed8-be43-efdf1c893741, 'Super bon et moelleux! Avec les bananes, pommes et noix, ce gâteau a eu un énorme succès!', '2016-12-18T11:13:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 0cb7dfe9-8bcb-4a4f-9c95-5ae180b7df9f, 'Hummmm j''adore', '2016-11-22T17:22:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 64314070-ef37-4612-a245-c16f1ac7f2dd, 'Super bon, toute la famille l''a adoré. J''ai aussi ajouté un peu de lait. Trop trop bon', '2016-10-17T22:44:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, b6830c82-0626-4457-8602-ffd922de8dd3, 'Je trouvais intéressante cette recette de cake pas trop grasse ni sucrée mais je suis déçue par le goût assez fade...', '2016-08-11T22:13:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 84e0b054-c531-41d1-87fd-a6495cb57599, 'Super recette, mais bien calante !!', '2016-06-24T14:46:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, de58b1c1-fab8-4bf1-b21b-7052217ae3f3, 'Superbe recette!! Et pourtant je ne suis pas pâtissière, cake ultra moelleux gourmand... un délice à tester absolument par contre il faut ajouter un peu de lait à la pâte.', '2016-06-11T22:20:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 1ec7e6a2-f3f8-455e-b4cf-732a1a331d5d, 'J''ai dû ajouter une assez grande quantité de lait (d''amande) pour obtenir une pâte onctueuse. Après les 100 premiers grammes de farine, la pâte était tellement sèche et craquelée que j''ai dû improviser. J''ai cru avoir loupé une ligne dans la recette, mais non. Avec cet ajout, le résultat était délicieux ! ', '2016-06-08T11:29:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31434, 92ffc36e-49fe-4118-9084-6793c7361cdc, 'Je n''avais que 2 oeufs dans le frigo, alors j''ai choisi cette recette. Je ne suis pas déçu, moelleux au coeur et croûte craquante. Je suis gourmande alors j''ai ajouté juste des pépites de chocolat. Trop trop bon.', '2016-05-23T19:06:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30411, a816c957-896c-4c7e-81bf-036706a69f06, 'J''ai incorporé 2 bananes mixées à la pâte et la dernière, coupée en rondelles, répartie sur le dessus du gâteau. Réalisé dans un moule de 20 cm de diamètre, ce qui m''a donné un gâteau un peu plus épais (rallonger la cuisson d''une vingtaine de minutes, selon son four). Du coup mon fondant était bien moelleux et délicieux.', '2020-12-11T15:44:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30411, 051d559c-11a0-4747-9ed8-bc1f4f0eada1, 'Gâteau très fondant, pas trop sucré et délicieux! J''ai écrasé les bananes que j''ai incorporées à la préparation.', '2020-11-06T21:51:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30411, cea17555-fc55-4fbb-afa2-d25bc44e318a, 'Délicieux dessert. Adultes et enfants ont adoré. J''ai mis 2 cuillères à soupe de cannelle. Je recommande vivement.', '2018-08-20T12:10:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30411, 2e4c18ba-271d-4815-b004-c75ca6d4ac23, 'Un seul mot : excellent ! Je cherchais un gâteau à la banane qui ne soit pas sec, trouvé, cuisiné, testé et adoré ! Je le mets dans mes recettes favorites ! A refaire encore et encore !', '2016-01-31T18:10:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30411, 7fa5a00f-a1d4-49e7-8f56-2d33a973c34b, 'Très bon. Ma variante : au lieu de poser les rondelles sur le dessus, j''ai incorporé 3 bananes en purée à l''appareil. Pour un moelleux parfait. ', '2015-02-09T02:27:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30411, 721877b1-9d88-433a-aa9d-c0b462e862db, 'Excellent gâteau pour ceux qui aime la banane cuite! Avec de la chantilly une merveille!', '2008-03-25T14:14:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30411, 8e95070d-93e6-4e6d-a55a-5064f3c63e91, 'Ça change des gâteaux au yaourt ! Très bon servi avec de la chantilly.', '2008-02-06T11:37:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30411, 6f4471ff-526c-4c71-bc4c-08c86c293c6b, 'J''ai peut-être raté quelque chose c''est fort possible mais je me suis retrouvée avec un gâteau genre gâteau que l''on fait dans le nord de la France avec les restes de pain. Pour moi, si le couteau ressortait sec, c''est que c''était cuit, j''ai pourtant eu une couche guère légère plutôt compacte, pas mauvaise mais vraiment sans plus. Je suis preneuse de l''astuce pour réussir.', '2005-08-05T01:07:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30411, 00aa1d35-e923-4f09-94f4-cd7bfbabb127, 'Rien à dire! C''est très bon. J''en referai surement !', '2005-07-25T20:59:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30411, 99ee5d48-f537-4409-baac-0c1cfcd405ba, 'Gâteau très léger et idéal après un repas copieux. Deux grandes bananes suffisent et il est vrai que le gâteau est assez plat, mais c''est quand-même délicieux.', '2004-10-19T13:00:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30411, 47f14448-5a17-4c45-90d6-054e417057a6, 'Plutot bof... le terme "fondant" est mal approprié, la texture étant quand meme consistante, mais surtout sans surprise. La banane étant un fruit lourd j''espérais quelque chose de plus raffiné ! Gâteau banal.   ', '2004-10-12T17:21:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30411, 384567d8-c796-4344-804b-e79d884b6fab, 'Très léger en effet, mais je n''ai utilisé que deux bananes et c''est suffisant. Une bonne recette après un repas japonais un peu copieux!!! ;-)', '2004-09-05T11:15:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30411, 33249bf8-fa10-48a7-ad3c-c2c97dd1528d, 'Je confirme, ce gâteau est excellent: très moelleux et léger. La cannelle apporte une touche agréable. Je n''ai personnellement mis qu''une banane (car je n''en avais plus!) et c''était très bon comme ça! A noter que le gâteau est assez plat, mais ce n''est pas gênant du tout.', '2004-08-24T20:21:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21708, 06745d8a-5d79-41aa-9db3-6955de7a45ff, 'J''ai eu beaucoup de difficultés à éviter les grumeaux (j''ai été obligée de recommencer et mettre directement la farine dans le lait bouillant), pour un résultat plutôt commun. Le déssert donne l''impression de manger des bananes flambées avec un gâteau. Alors pour la vaisselle et le temps que ça prend, il était plus simple de faire des bananes flambées.', '2008-10-01T11:14:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49263, 7bf72857-9b62-4010-916b-2bb6388aeaf9, 'En version diététique, j''ai testé orange + banane + carotte.', '2007-05-23T23:32:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65001, d8d11db7-ed76-498f-9771-ff48f345ec68, 'Amélioration à donner : une fois les feuilles de gélatine bien molles, je les ai mises dans la banane préalablement mixée. Pas rajouté de sucre. Puis j''ai mis le tout dans une casserole sur le gaz afin de lier la banane à la gélatine. J''ai remué tout le temps de la chauffe afin que ça ne brûle pas et n''accroche pas. Sauce tout juste tiède --> direct dans les verrines au frigo. Une fois durci, j''ai mis le chocolat noir, puis j''ai fait une chantilly maison que j''ai ajouté par dessus. De bas en haut : 1) 1/2 gâteau à la cuillère 2) sauce banane 3) chocolat noir 4) 1/2 gâteau à la cuillère 5) chantilly 6) pralin + rondelle de banane.  Mettre au frais avant de servir pour que le chocolat durcisse ! Un délice !', '2014-03-22T12:37:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65001, d84f49f9-7d19-45f2-b06d-d98e5806d176, 'Cette recette est bien mais : la gélatine que je trouve s''incorpore à une préparation chaude ou tiède donc j''ai dû chauffer la préparation. Il y a à mon goût trop de crème, j''ai utilisé pour 4 verrines 40 cl de crème légère et 4 bananes pour plus de goût.', '2009-04-15T17:08:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65001, 08c111b7-c163-4618-9599-feea7c48f067, 'J''ai essayé avec la gélatine (mais elle ne devait pas être assez fondue!),  mais c''est quand même une bonne recette. Je n''ai par contre mis que 60 cl de crème dans mes bananes et 20 cl dans mon chocolat. Avec des vermicelles colorés c''est très joli.', '2008-08-04T20:17:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65001, ca4a942e-eb01-445c-a676-7f26380ad15f, 'Très bonne recette très simple et rapide. Je n''avais pas de gélatine, du coup j''ai mis moins de crème fraîche et plus de bananes ! Et c''était délicieux ! Idéal pour épater les amis !', '2008-06-04T20:24:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (232284, 71e71957-0b00-4be4-bde5-35ef81a7768b, 'Je connais cette recette mais au lieu de la maizena, je mets de l''amidon , sans rajout de sucre et en accompagnement je mets du lait de coco   ', '2013-11-19T15:27:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (326709, 7a5789f9-5cfc-4888-8a56-59cb2f81b94f, 'Super, légère avec beaucoup de goût elle est très bonne. Super facile à faire j''adore !!', '2016-03-01T17:11:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230172, e3ca9ef6-809c-456b-8650-31479d933ca2, 'Je suis une fana du crumble classique aux pommes mais là je dois avouer que celui-ci est succulent, les saveurs se marient très bien ensemble, ce n''est pas écœurant. Très très bon, à refaire !!!', '2013-02-23T18:12:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60762, 5dbce9a3-4979-40c5-b1aa-c34b960b926b, 'Très bonne recette, une subtile variante, très appréciée, légume très consommé en Guadeloupe.', '2018-11-19T02:24:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60762, 3afb49ee-1f39-489f-a67f-315ab55c1649, 'Non.  C''est pas mauvais. C''est bof ', '2013-01-23T21:53:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60762, 0c9cfa7f-3049-4034-bca0-dff768e851a1, 'Désolée, j''ai pas du tout aimé ! Pourtant les mélanges sucrés/salés j''adore ca mais là...', '2011-03-25T20:55:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60762, 1e01fa89-9483-4db8-9aed-f6dbf483382b, 'Vraiment très surprenant ! Un délice j''étais pourtant très septique, à gouter c''est trop bon', '2010-03-11T21:56:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71981, e2823d97-6d0c-4ca6-ab8d-d8d69ed1ca44, 'Un régal ! Très fondant et surtout très surprenant avec son cœur au nutella ! La banane le rend moins écœurant, c''est donc une très bonne idée ! Toute ma petite famille est fan de cette recette et moi aussi !', '2010-04-10T17:55:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70114, d21aa3e2-b695-4724-adbb-86b18ca29a14, 'Succulente ! La famille la classe au top. Faite avec 4 bananes et cuisson 30mn. ', '2020-06-22T15:18:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70114, 6ab1f31f-17d2-4c1a-b981-1f1a3db4fbd5, 'Vraiment sympa, variante avec de la noix de coco dans la crème !!! Délicieux', '2013-07-06T23:36:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70114, 58ccf125-7a04-47c4-9f61-c17be5e4d9f3, 'Je l''ai fait en tartelettes, c''est vraiment trop bon ! Encore meilleur avec une pâte sablée maison !', '2013-03-01T01:06:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70114, dc33d0cd-6604-43ae-a9df-74c7aadf7f58, 'Excellent !! Tout le monde a adoré !!', '2012-07-15T01:00:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70114, 86247749-b3f6-408b-90d7-99625b55c059, 'Super bon ! Pour varier, j''ai ajouté un peu de noix de coco râpé sur le chocolat et 1 cuillère à soupe de rhum avec le mélange oeuf, très bon ! ', '2012-05-17T02:44:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70114, 6c57f082-feef-41bc-ac98-890342371c1b, 'Trop bon, un régal, les enfants en réclament ! ', '2011-10-31T15:10:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70114, eef02f0a-aa2a-41c8-8e34-98bd12245766, 'Délicieux, tout le monde a adoré. J''ai râpé mon chocolat comme je n''avais pas de pépite sous la main. Et dans l''ordre j''ai déposé la compote (mélangée à un sachet de vanille) banane, ma crème, saupoudré de canzone et j''ai recouvert le tout de mon chocolat râpé de manière uniforme. Un régal.', '2011-07-27T11:41:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70114, 735eeb42-4f4d-47f0-8e2f-2bf65b281ac7, 'Excellente tarte moelleuse et légère, les enfants l''ont adoré et m''en réclament. A refaire à la lettre !', '2010-04-03T13:55:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70114, 7067d7e1-959f-4c5c-8406-9ea15529ef4c, 'Recette légère, pas chère et inratable. Tout le monde a adoré, c''est vrai que c''est encore meilleur tiède.', '2010-03-31T00:09:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70114, a4d6c3c6-d6d5-42e8-afbd-9774d9c3ee4f, 'Très bonne tarte, la prochaine fois je mettrai les bananes sur les pommes/vanille/cannelle, puis je napperai avec l''oeuf/crème, et je n''ai mis que 50 g de pépites de chocolat. Cette recette sera refaite.', '2009-08-26T14:47:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70114, 01a74977-e786-4410-bbf7-b3c06f7d9c29, 'Nous avons beaucoup apprécié ce dessert qui malgré son apparence, est léger. Je le referai, peut-être en râpant du chocolat noir, plus tôt que mettre les pépites', '2009-06-06T22:11:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70114, 2567f78d-9a4f-482e-88cd-909e7f38ec4a, 'Moi j''ai trouvé cette tarte vraiment délicieuse. Tout le monde a aimé. Merci pour cette idée de recette que je vais refaire assez souvent.', '2009-06-01T00:00:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70114, a74e2aed-21af-48af-9148-7f31af3da0ea, 'Très très moyen... Mes enfants, qui adorent la banane et le chocolat, ont carrément boycotté ce dessert pas très présentable... ', '2008-07-07T17:33:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70114, d2efcec0-50a7-4cf1-bdc0-19246da40264, 'Très bonne tiède avec une boule de glace à la vanille.     ', '2008-05-31T19:15:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217623, 0f95bab9-cf4e-4089-88ee-42a783669dcf, 'Vraiment délicieux ! Le mariage est idéal, on sent vraiment les goûts, la texture est parfaite et c''est rapide à faire ! Je l''ai faite avec du chocolat noir dessert et la dose de sucre de la recette, excellent ! ', '2013-11-11T13:52:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217623, 77e17211-2d06-4804-85d2-f4ba0cfec9c5, 'Une glace pareille, c''est rare ! La texture est parfaite, et le goût (un peu trop sucré pour certains, tout de même) met en valeur la banane. Je n''aimais pas la glace à la banane, me voilà réconciliée avec ce dessert !', '2013-07-21T21:53:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217623, 26637001-d70e-40ed-948e-15ec05a03a11, 'Excellent ! Glace onctueuse et crémeuse. Le chocolat blanc adoucit le goût plus prononcé de la banane. Parfait pour utiliser des bananes un peu trop mûres. Par contre j''ai mis beaucoup moins de sucre car le chocolat blanc est déjà sucré... Mes filles ont adoré ! À refaire ABSOLUMENT !', '2013-06-23T18:18:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217623, c493cbca-f3bd-4d6e-a64a-191e1b87d4ad, 'Un pur délice, ce dessert est parfait ni fade ni écœurant, on sent aussi bien le chocolat blanc que la banane... hummmmm ! Merci pour cette recette ! J''ai mis du lait demi écrémé et après j''ai mis la préparation dans des petits moules en silicone, à refaire !!!', '2011-12-18T11:27:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48469, 4791456d-fbf4-4509-a923-04dde33c0a8f, 'Facile, pratique et bon.', '2016-04-25T11:52:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48469, 1a308c0e-a7a8-47cc-87d8-3dcc7c63f8e2, 'Servi dans des coupes avec glace vanille et coulis de fruits rouges... Très bon dessert, simple à réaliser et à servir très frais.', '2010-03-13T16:37:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48469, 23207cdd-97ba-44f5-8fcf-55932372aff3, 'Whaou ! Super recette, c''est tout simple, c''est très frais et léger et ça en jette un maximum ! La présentation est superbe dans les moitiés d''ananas. Parfait pour finir un repas un peu calorique. J''ai mis pêle-mêle : ananas, litchis, mangue, framboises, banane, pomme, kiwis et coulis de framboise. Merci pour cette belle et bonne recette.', '2010-01-05T16:56:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48469, b3ad9257-7f5e-4281-b07c-e841ad97d44e, 'Original et très bon.', '2007-04-18T18:02:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48469, 7a705fdd-8077-4b87-a300-e13cafb37767, 'Trop bon! Trop facile à faire, et joli en plus, et ça fait une idée de déco originale sur la table !', '2006-08-10T13:31:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38369, d09eb35a-b045-44da-9207-7261a1abe763, 'Très bonne recette ! 120 g de sucre suffisent à mon avis. J''ai suivi exactement la recette, j''ai juste mouliné à la fin pour un rendu plus lisse ! Tout le monde a apprécié !', '2011-04-20T17:11:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38369, 6480bd6f-77b9-48a6-9c5b-4a7e5ca1e463, 'Un peu liquide, mais délicieuse, en respectant les proportions de sucre indiquées.', '2023-05-07T18:16:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38369, d3c86a86-89d1-43c1-b56b-5fba480f7db4, 'Même pour un détracteur de la rhubarbe , c''est excellent !', '2021-06-30T18:02:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38369, e450710d-03c6-4f70-b24f-17ad87997352, 'Beaucoup trop sucré, dommage. A refaire avec moitié moins de sucre je pense...', '2019-05-28T19:01:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38369, fa933a58-b261-4e5a-a4d4-416bec2942f7, 'Délicieux ! A refaire avec ou sans meringue.       ', '2014-07-04T18:55:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38369, 5ae188dd-ced0-4e34-b234-e2d57e14db15, 'Un régal. J''ai finalisé la recette en plaçant la compote dans des ramequins, recouvert de meringue ! Un délice ! Mon chéri qui était septique à la rhubarbe a trouvé cela délicieux ! La meringue pour 4 personnes : 2 blancs d''œufs à battre en neige. Ajouter 60 g de sucre et faire devenir les blancs brillants et fermes. Enfourner au four grill très chaud le temps de dorer la meringue.', '2010-05-24T15:26:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38369, 7a846557-b090-4d5e-b0f3-9505db326125, 'Excellente recette, je l''ai faite avec du sucre complet bio et pas de sucre vanillé car le sucre complet a déjà un goût particulier. J''ai mis de la confiture de fraise car pas de figue. C''est succulent !', '2010-04-27T15:59:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38369, 0e7b30be-b3a2-4b29-ace8-d8d6ecef9736, 'Pas de confiture de figues, j''ai ajouté de la confiture d''abricot. Compote bonne même si la note acidulée est bien présente.', '2008-05-15T00:04:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38369, ffeaf697-137a-4281-8214-c2853743bc71, 'Très bonne recette qui sort de l''ordinaire la compote de rhubarbe. Les saveurs douces et sucrées de la banane et de la figue se marient à la perfection avec l''acidité de la rhubarbe. J''ai donc mis un peu moins de sucre que sur la recette.', '2007-07-06T12:41:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38369, 17284012-ae94-4702-8255-032815d0d315, 'Très facile à réaliser. Meilleure qu''à la casserole. ', '2007-06-19T20:40:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38369, 99aadb17-b3db-40c4-a970-c09b6ac1e2a5, 'Excellente, facile à réaliser, pas du tout acide, seul bémol: avoir un four pyrolyse pour tout nettoyer!!!', '2006-06-07T14:45:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38369, d84d69df-8d45-4c38-8acd-15675716fb76, 'Très bon.', '2006-02-11T13:41:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38369, a9309646-f4d5-45f2-8545-b20529930b3c, 'J''ai suivi la recette en divisant les proportions par 2 (pour tester). Nous l''avons trouvée trop acide. Je n''avais pas mis de confiture de figues car je n''en avais pas. Ceci explique peut-être cela.', '2005-12-26T17:18:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38369, 80f71df8-ea48-4f8d-830d-d27e7644ea67, 'Excellent, vivement conseillée, surtout pour le côté acidulé de la rhubarbe et de l''orange.', '2005-09-06T16:53:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38369, 16a291bc-c508-48c4-a921-aedfd8db76ce, 'Très très bon... ', '2005-09-05T17:15:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309367, 3b31512c-54a0-486b-8ec0-24edbfe4adb1, 'Moi je trouve que cette recette est plutôt pas mal, mon gâteau est très réussi et plutôt bien aéré.', '2016-06-01T08:26:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309367, 6ca101af-ceca-4426-ae74-3e19149b712b, 'Il y a beaucoup trop de farine à mon goût ! Le gâteau était trop compact. En faisant la préparation, au moment d''ajouter la quantité de farine, même le batteur ne suivait plus ! En plus 500 g de farine pour un moule à cake ça me parait disproportionné !  Donc je vais refaire la recette avec la moitié de farine, et voir le résultat...', '2013-07-06T12:26:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54409, 1c2a44d7-47de-4f1e-a5ed-33722d29f431, 'Un délice et devenu un classique quand je reçois, les invités sont toujours surpris tellement c est bon, et me demandent la recette !
Merci pour cette excellente et simplissime recette', '2020-10-19T21:12:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54409, 93870722-6737-42b5-b026-910d8750343f, 'Excellent, très frais', '2023-10-29T08:13:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54409, d073fdc9-e7df-4a69-93bb-a572121b8501, 'Excellente recette', '2022-07-01T15:20:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54409, 69f17bce-faeb-4712-951a-f075d505a4ff, 'Original et très bon. Très frais.', '2020-08-17T23:52:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54409, 8eb463d7-c9ac-4fe0-9782-a74c6ad55b61, 'En suivant vos commentaires, je n''ai mis que 60g de sucre, c''était parfait pour faire glisser à la fin du repas du réveillon de Noël. ?', '2019-12-27T09:23:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54409, 7fdad4f5-e91b-4ad1-a5a4-e45f72d0d5e2, 'Trop sucré à mon goût, mais agréable manière de changer des bananes classiques.', '2019-10-20T02:08:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54409, adc8dd95-76b4-481c-84c6-fb8f431832ec, 'Très bon et très frais ! Possibilités d''ajouter des épices types gingembre. Servir très froid !', '2014-05-06T09:24:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54409, 5d293942-1565-4a96-9900-0f1e62f111ec, 'Le sirop aux agrumes est un délice. Il faut faire mariner les bananes vraiment longtemps pour qu''elles soient bien imprégnées.', '2014-02-16T18:33:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54409, 04c6bdfe-09d9-4ac2-8787-abe66bcc45ba, 'Simple et EXCELLENT. Frais et savoureux, voilà pour caractériser cette recette.', '2012-09-24T18:29:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54409, 1829209c-a484-4e7e-9f95-eb05e16271ef, 'SUCCULENT... Je n''ai eu que des compliments, tous ont voulu connaître la recette, et c''est tellement facile à faire! Essayez-là...', '2008-01-04T10:46:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58439, fd571ee2-a993-49bf-bde6-d5216afa7515, 'Dessert super bon, frais et original. Ne pas faire ce que j''ai fait, à savoir présenter ce dessert dans un grand plat et non pas dans des coupes individuelles. Au moment du service, le tiramisu ne ressemble plus à rien dans l''assiette et ne donne pas envie !', '2011-12-10T11:17:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58439, 6f1536d7-5719-49c8-af42-b7ae188fdbca, 'Ma mangue n''étant pas assez mûre, je me suis permise de faire flamber mon assortiment de fruits au rhum, ce qui a donné un très bon goût. Problème : les boudoirs (remplacés pour la couleur par des biscuits roses de Reims) étaient totalement mous et sans saveur. J''ai personnellement ajouté des petits morceaux de biscuits concassés sur le dessus pour donner un peu de croquant, manquant à cette recette. La crème est parfaite.', '2012-04-15T15:10:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58439, bb095262-8c01-4475-bfcd-46c45c817469, 'Bon dessert, j''ai pris un ananas frais et des mangues au sirop cela passe très bien après un repas copieux. Coulis framboise acheté tout prêt. En revanche, j''ai regretté l''aspect des boudoirs trop mous la prochaine fois je mettrai des biscuits spéculos pour le croustillant. J''ai coupé un fruit exotique en forme d''étoile sur la verrine pour soigner la présentation. A refaire car léger.', '2012-01-01T23:24:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58439, 5de269c7-7943-4b33-9a46-f591ec194cbc, 'Merci pour ce dessert très frais et très léger. Délicieux après un repas chinois!!! J''ai rajouté des kiwis, et les bananes ont un peu noircies. Et le rhum, je l''ai mis dans le jus de fruit qui a servi a imbiber mes biscuits.', '2008-03-03T09:37:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58439, e93569b2-8b0b-4ff6-95f4-c4715ac1674e, 'Extra la présentation dans des verres à pied fait un super effet. Un petit ananas suffit. Le mariage avec la mascarponne et parfait. Mes invités ont adoré et moi aussi. Je le referai. De plus après un repas asiatique c''était idéal... et léger en plus.', '2008-01-07T20:25:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (308800, f54b9952-d783-446a-8114-4a2df3725d91, 'Un régal ! Tout simplement ! ', '2015-05-26T21:44:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14953, 6d529731-ac1b-4d0d-aaf2-d5db6b0acea5, 'Délicieux ! Les fruits rouges donnent un côté acidulé tandis que les bananes sucrent et adoucissent le mélange. Les fruits surgelés sont une bonne astuce pour rendre le smoothie très frais et remplacer les glaçons ; si vous n''utilisez que des fruits frais, ajoutez donc des glaçons ! Ayant confectionné ce smoothie de 4 personnes pour moi toute seule (mouahaha), j''attends d''en boire la moitié puis j''ajouterai du lait pour en faire un milkshake !', '2014-07-16T14:07:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14953, ae48e8cf-c407-4343-a3af-7cd1897eb1cb, 'Je l''ai essayé ce matin avec ma belle-mère: je n''ai mis qu''une seule banane et rajouté 2 cuillères à soupe de sucre. Le hic c''est que mes fraises (fraîches) avait trop de pépins... Mais recette excellente ;)', '2008-06-26T19:27:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14953, 3640158b-bb19-4b42-b21e-7e19c79b61e5, 'C''est super et hyper bon! Au gré de sa fantaisie on peut le faire avec n''importe quel fruit. ', '2008-04-15T17:22:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14953, 75c588c7-c700-4f7a-a65d-c08c1ffe4183, 'Génial j''ai surpris tout le monde en me ramenant à une aprem entre copines et le pire c''est que je me suis faite enguirlandée parce que j''en avais pas fais assez !! Par contre moi, j''ai tout fait avec des fruits frais et des glaçons ! Un vrai délice', '2008-04-09T21:48:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14953, 06f62a42-d633-4f82-be1f-388a08d797d8, 'Comme Gaelle, je préfère les smoothies au lait qui sont moins acides. Cependant, c''est une boisson vitaminée qui donne un vrai coup de fouet les matins d''hiver .', '2007-12-30T01:55:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14953, fe29ae05-43f0-465e-b41f-fedeff0fd9ad, 'J''ai testé avec du lait et un yaourt, et bien on a tout fini d''un trait.', '2007-10-06T16:05:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14953, 24c4f05c-95b4-4fb2-b603-db97d2b51fb8, 'J''ai réalisé cette recette avec des framboises surgelées, du jus d''orange et du melon. C''était bon, mais je préfère les "smoothies" avec du lait, qui sont plus doux.', '2006-08-22T22:53:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14953, fda9cb7b-b3ae-4a88-a845-acabe913e12b, 'J''ai essayé avec le jus de fruits, c''est bon,  mais moi j''en fais aussi comme je les ai vu faire à Boston, c''est moins sucré, avec 200 g de fruits surgelés (fraise, framboises etc )+ 1 yaourt nature, 1 petit verre de lait froid, un peu  de sucre (ou édulcorant ), je mixe le tout... Délicieux en cas de canicule et plus léger qu''une glace!', '2006-07-04T11:17:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14953, 4fb5cd0e-a457-4238-9d2e-25fc487dc495, 'C''est délicieux, on met tous les fruits, on mixe, rien de plus simple ; et quand il fait chaud, c''est la seule chose à faire pour se désaltérer !!', '2005-07-17T19:20:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14953, 3e1182db-0acc-42d5-905b-07f338f17339, 'Je vien de déguster avec deux de mes petits-enfants. C''est très bon et frais.', '2002-03-27T17:23:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14953, e14a4d14-4eda-449a-88cf-0514104346cd, '...et on peut ajouter, pour plus de mousseux et de légèreté, un verre à moutarde de lait de soja!', '2001-10-11T21:19:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, c6f2ed35-bb6d-4fe4-a14c-3fee0636f0b9, 'J''ai mis du beurre salé en place du beurre doux et remplacé la moitié du sucre blanc par de la cassonade. Mettre aussi la pate au réfrigérateur pendant 1h avant de l''inserer a four chaud pour garder tout le moelleux a coeur en fin de cuisson. Un must familial !!!', '2023-11-05T11:09:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 9d04d415-e62b-4711-9e82-2cee3a302075, 'Trop de sucre je meurs', '2024-02-22T21:35:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 506c6703-8ece-4d37-846d-bde98df5914c, 'Version modifiée parfaite !
125 g de sucre, 20 cl de lait et 45 min de cuisson à 150 °C.', '2022-02-18T11:13:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 4df455c2-8466-42af-b2cc-c09c7ee16036, 'Franchement super la recette mais au vu des commentaires j’ai changé les doses 
- 100g de beurre 
- 125g de sucre 
- 1 sachet de levure ( pour un gâteau bien gonflé) 
- 180 degrés pour 30 minutes 
Et le rendu et top, assez sucré, moelleux et très léger
Vous pouvez voir le résultat sur une des photos ( c’est un gâteau saupoudré de sucre glace avec une part coupé qui apparaît plus loin derrière en flou )', '2023-04-20T12:13:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 06a854a7-47ae-47a0-af70-465c4ea2aa37, 'J’ai fait la recette pour 6 personnes, j’ai pu nourrir toute ma famille affamé du bled… En plus de ça, on a l’impression de mangé un moelleux au sucre… Si vous souhaitez le diabète, je vous recommande vachement cette recette.', '2023-06-14T16:17:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 85093604-0e36-4441-b417-9c830b8e23ef, 'Très bon ! Pour cette 2ème fois j''ai suivi les conseils en commentaires, 200 ml de lait et 90 g de sucre. Nous l''avons trouvé meilleur, moins sec et moins sucré ! 👍', '2021-08-22T18:56:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, e3977604-8bdd-4614-ac93-3a8825660907, '125 gr pour le sucre, la farine et beurre plus facile à retenir pour refaire la recette 😉', '2021-08-22T15:20:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, d3f18f0b-36e4-4523-bc27-d14287a7b2f8, 'C est un délice😍😍🤩🤩,juste j ai diminué la quantité de sucre à 125 g seulement, c du top du top. Merciii', '2023-07-24T19:33:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 1530045b-2da9-4eab-85e5-15fddf28ebec, 'Le gâteau est une réussite, mais beaucoup trop sucré ! La moitié suffirait largement. 
La durée de cuisson est suffisante sinon il ne serait pas assez cuit', '2022-05-05T21:39:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, a15dfa86-4564-4712-9e72-0dfc7919be02, 'Gâteau trop sucré!! Vouliez-vous qu’on attrape le diabète???? Je suis vraiment déçu, car c’était un gaspillage de temps et d’argent', '2022-03-21T01:28:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, f162a76c-eaab-4cdc-9213-47f9c4e555e1, 'Un delice, j’ai suivi les commentaires en ajoutant un verre de lait, mis seulement 100grs de beurre, 100 grs de sucre. Cuire 30 minutes a 165 degrés. 
Moelleux et savoureux! ', '2022-01-30T17:44:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 118cac93-0239-44b8-9548-8886a4acfaf2, 'Pour moi c''est la meilleure recette de moelleux, inratable. Néanmoins je vous conseille de réduire la quantité de sucre.', '2018-11-26T11:32:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 8961ddd9-09b5-4cb6-b3d0-6e336d388528, 'Très bonne recette mais beaucoup trop de sucre. Je mets moitié moins et c''est très bon.', '2023-02-28T18:10:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 708f67b7-e8dc-44a4-8bf9-3619646ed7a6, 'Très bon, mais pour ma part je n''ai mis que 125 g de sucre.', '2022-10-29T07:29:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, fe56ac1d-5a54-4a09-a255-c9448c5b1303, 'Vraiment pas bon, très mauvaise recette.', '2022-09-17T23:09:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, a149c49b-114d-49e6-b742-55f4fe9cbca3, 'Très bonne recette. J’ai mis moitié moins de sucre (et je trouve que c’est encore trop sucré). Je n’ai pas monter les oeufs en neige et le gâteau est quand même monté. Super efficace et rapide à faire', '2021-11-08T00:23:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 61f4d0a3-e0a0-4dfa-980c-680dc1148bff, 'Jai ajoute 1 verre de lait et diminue le sucre a 125g
Cuisson a 150° pendant 45 minutes 
Et le resultat est top ! Gateau tres moelleux ', '2021-02-18T17:14:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 993591cf-34c9-47bc-b4b6-154925e30f46, 'Merci pour la recette. Nos invités ont adoré !! J''ai cependant suivi les conseils précédents et n''ai mis que 170 g de sucre au lieu de 250 g. Et bien sûr une pincée de sel dans le chocolat fondu (au bain marie) pour relever le goût ! Idem pour la cuisson, un tout petit peu moins que 30'', avec un papier d''alu au dessus les 10 dernières minutes pour éviter qu''il ne soit éventuellement trop cuit. Et saupoudré de sucre glace ... A refaire très prochainement !  : -D', '2019-03-30T00:47:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, d04f4b58-4b1d-4733-86fb-824b0d2798fa, 'J''ai suivi les commentaires et j''ai mis 130grammes de sucre car 200grammes c''est beaucoup trop.Très bon je le fait tout le temps?', '2023-10-31T17:41:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 4c4e772f-2c71-43ce-9ee8-7cb483ca7e57, 'Trop bon', '2023-06-13T17:20:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, abe7362a-3913-42f9-a523-492da21d7127, 'Top', '2023-06-11T10:06:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 5f56d6bb-7e05-452b-af38-0466dcefa32e, 'Merci pour cette recette, la meilleure selon moi. Je n’utilise qu’elle et tout le monde adore 
', '2023-05-26T15:15:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, aca82856-b921-4ab2-b9d9-c539290f3235, 'Excellent mais la levure doit mieux préciser 
Mais très bon 
MERCIII MARMITON', '2023-04-15T22:35:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 33ec891e-97fe-4cc5-b925-5e6bf86ea911, 'Super moelleux au chocolat mais trop sucré à mon goût, la prochaine fois je mettrais moitié moins de sucre. Je recommande cette recette !', '2023-02-20T14:36:37+01:00');
