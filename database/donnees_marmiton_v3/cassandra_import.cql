INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, dc9b081c-3a41-45ca-bd1f-c57520896bc1, 'Très bonne recette, bien équilibrée ! J''ai personnellement mis un peu moins de sucre et de beurre. Mon fils en redemande.', '2013-06-24T20:17:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, 2386fae5-0597-491e-8501-3a731778a1ac, 'Bonne recette, à refaire !', '2013-04-25T21:13:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, 99563d90-87e8-4abb-9bda-45addfaa6a41, 'Excellente recette ! C''ai utilisé des framboises surgelées (avec un peu de sucre en plus sur les framboises) Très facile à faire !', '2013-04-14T12:38:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, c888f176-45fe-4dba-972f-b4536f162dd5, 'Excellents, moelleux et pas trop sucrés, pas de liqueur j''ai mis un trait de grenadine (mais je crois que ça n''a pas apporté grand chose) et je les ai fait dans des moules à muffins.', '2013-03-24T17:50:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, bcbfa5a2-9883-4b45-88a8-7a1e7fae0035, 'Hormis le manque de sucre, mais ça c''est une question de goût, ce fût un délice. Très moelleux. A refaire sans hésiter.', '2013-03-02T17:45:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, 1e715741-4545-4e2e-995e-f2d1620e6c3c, 'Excellent, à faire ou à refaire pour la pause thé.', '2013-02-25T19:34:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, 89588449-a8d6-4221-96de-aeafce876634, 'Muffins tous petits, pas très savoureux ', '2013-02-10T21:20:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, a69a4df8-500d-4904-9e31-f355367ec557, 'Faute de liqueur, je n''en ai pas mis. Par la suite, j''ai eu un petit peu de mal avec le démoulage. Cependant, le résultat fut sans appel : excellents petits gâteaux, la texture très légère et le goût est parfait. Merci pour la recette.', '2013-01-01T18:00:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, 23c6f1d6-dd83-4fa1-8989-72aa6ffc92cf, 'J''ai bien aimé, j''ai ajouté un peu de sucre sur les framboises surgelées avant de les incorporer au reste. Très bon. ', '2012-11-11T17:29:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, 538eeddb-916b-481c-a671-94dd55c4585b, 'Un délice ! Par contre je n''ai pas fait le mélange en plusieurs fois, c''était plus simple et ça a très bien marché puis je les ai mis dans des moules à muffins. ', '2012-11-02T12:40:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, 69b45d9e-bc33-48b2-bf98-3eccc4fb0a1c, 'Merci Aurélie pour ces muffins excellent tout le monde s''est régalés ! Vivement les prochaines fournées !', '2012-10-15T12:55:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, dbec7669-541b-4e2a-a187-ce24a0e8e76d, 'J''ai utilisé des framboises congelées, très bon!', '2012-09-20T23:21:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, d20aff2b-9186-4891-88bb-75bbd9ee26e0, 'Très bonne recette ! La pâte a un très bon goût. J''ai doublé la quantité de fruits car j''avais 300 g de mûres sous la main et c''est excellent ! Sinon, le temps de cuisson et les proportions sont parfaites. On peut même mélanger les ingrédients l''un après l''autre dans un même saladier, ça fonctionne très bien (et ça simplifie :-)... un grand MERCI pour cette recette !', '2012-08-22T09:25:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, 7b9cac78-6892-4568-aa00-c04b8b4cb319, 'très facile à faire et un super résultat si on respecte les temps de cuisson. Conseil : ajouter plus de framboise que ce qui est indiquer.', '2012-06-15T00:54:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, db503c33-6313-4c07-91d4-2862cd978fde, 'Pas mal , mais peut être aurais je du sucrer les framboises (surgelées )? ', '2012-06-03T19:29:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, b94c9b57-9245-4457-acf3-62ca1f5a67c8, 'Trop sec et pas du tout moelleux.', '2012-05-08T18:26:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39470, d499b3d2-0230-4d3c-a9a5-5058d4a55e55, 'Super recette, tout simplement !', '2012-03-06T21:44:23+01:00');
