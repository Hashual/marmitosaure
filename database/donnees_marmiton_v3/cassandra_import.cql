INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, cae6b602-0815-46a6-87dd-d6889d4354b5, 'Je n''ai pas mis de sucre de canne, ni de jus de citron mais j''ai rajouté deux verres de sirop de fraise et 1l de jus de passion car pour moi il était trop fort en goût.', '2019-12-31T01:28:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, ce351e54-cbd8-4464-bc38-a6a028fcf314, 'Excellent ! Cette petite merveille se boit très bien. Tout le monde a adoré, je recommande chaudement.', '2019-12-06T19:29:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 13881bc7-2b1d-40e6-a584-8a481a5a34a4, 'Un délice à coup sûr !', '2019-10-23T10:07:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, e2dcdb4f-8ec9-4b87-aca0-8f20c0295b6b, 'Parfait... Réalisé pour les 20 ans de ma fille... Tout le monde a adoré. J''ai ajouté des fruits en morceaux : Orange, banane, pommes, raisins, pêches, ananas.', '2019-09-01T22:38:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 41195fdd-e756-4796-91cc-f99e8fa8f2d2, 'Très bonne recette !!
Je n''avais pas de gousse de vanille alors je n''en n''ai pas mis et je n''ai pas ajouté le sucre liquide car c''était parfait sans !! Tout le monde a adoré !! Nous avons fait moitié de la préparation, soit environ 15 verres.', '2019-07-28T01:40:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 68c449b4-1d09-442a-b912-61ce6fedc58e, 'Excellente recette, vraiment délicieux !', '2019-07-07T10:57:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 5fb2d2c7-6230-4c6c-85b2-57fda9cebddd, 'Excellente recette suffit largement pour 25, pas trop sucrée et très goûteuse. Je la referai !', '2019-06-01T23:13:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 42c892da-a7ec-460b-9597-ab54ffc404c5, 'Pas de sucre de canne pour ma part car je trouve les jus de fruits suffisamment sucrés et après je trouve que c’est beaucoup trop sucré. ', '2019-05-25T14:18:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 86e9f4d7-fa4e-4a09-af69-7c6360258269, 'Excellent ! N''ayant pas de sucre liquide et vanille liquide, j''ai mis de la vanille en poudre et du sucre vanillé et c''était très bon. Je l''ai laissé mariner 2 jours. Un régal !', '2019-05-05T10:14:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 0f7663cf-c552-4f64-970e-5b1a0b2b8b1e, 'Excellente recette, après en avoir testé plusieurs c''est notre préférée !', '2019-03-02T09:20:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, ecb046d1-4def-4f17-adf0-ecfdb3b2d7e7, 'Je fais ce punch à chaque occasion. Impossible de le rater. C''est trop bon ! Par contre je ne mets ni poivre ni cannelle. Encore meilleur quand il est préparé plusieurs jours à l''avance.', '2018-12-23T06:12:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, a3e2a176-6510-4e4b-a44f-3126b44d3757, 'Super, pas trop fort et bon !', '2018-10-08T09:54:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 0ec721f4-dc2f-4b14-8064-45ac8f3efd82, 'Recette parfaite ! Tout le monde adore je suis vraiment ravie d''avoir vu cette recette !', '2018-07-16T04:01:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 4d427645-1af1-4218-9d14-a582e99bbb39, 'Il porte bien son nom. J''ai mis du rhum a 50° et c''était excellent. Merci pour cette recette.', '2018-05-16T03:06:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, bbb53561-0a7d-444c-b970-c27f454521f9, 'Délicieux !', '2018-02-28T18:51:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, de6a3655-b461-499d-8a01-8034615c3648, 'Délicieux. Se garde une bonne semaine. Il est meilleur jour après jour !', '2017-08-05T19:35:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 3bbdd753-be55-4e09-8296-3b3d9ae75374, 'Très bon !', '2017-07-20T22:25:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61889, 4fa432e5-6eba-4e51-a477-0a6bddfe1303, 'J''ai juste un peu plus cuit l''intérieur en mettant du papier aluminium sur le dessus pour pas le brûler... Peut-être est-ce du à mon four !
Sinon très bon, j''ai même ajouté des pépites de chocolat pour que ce soit plus gourmand... ', '2018-11-04T07:38:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61889, eeb83241-f9ca-4ab7-8fcb-dc46c2652296, 'Bon équilibre entre la banane et l''amande. J''ai remplacé l''huile par du beurre (un peu moins qu''un yaourt).', '2013-06-09T23:45:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61889, 80d12988-4209-48ee-ba56-6171b70d5abe, 'Très facile à faire, ma fille l''a fait toute seule (sauf la cuisson)', '2013-04-27T13:00:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61889, f237912f-98da-4392-9964-2ae6331f5911, 'Pas mal. J´ai obtenu une texture entre le flan et le cake, et comme il y avait beaucoup de pâte, j´en ai fait aussi des petits.', '2008-01-26T23:30:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335732, 794b7d88-44b0-4121-b3ba-5a52977f6a8d, 'J’ai adapté la recette ! Mais le gâteau est très bon et léger ! Un régal !', '2022-02-27T16:45:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253858, acf293d4-9507-428a-a3ec-77e16bae16d8, 'Très bonne recette ', '2023-12-13T09:20:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253858, 323b7a6c-7d0d-418a-b222-ec13f0635f61, 'Trop bon, mais ne tardez pas à les manger, ils sèchent assez vite à mon goût.', '2022-03-30T08:19:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253858, e3e52a60-a25c-4de7-a6bb-3393fd7f1ea1, 'Ma recette préférée de muffins! Je mets des rondelles de bananes, et des morceaux de tablette de chocolat. Le mélange est parfait entre la pâte, la banane et les morceaux de chocolat.', '2020-06-13T13:02:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253858, a353ffcb-a154-4511-b0ab-21ba1cc38943, 'Très bonne recette qui fait l''unanimité ! En suivant les commentaires, je n''ai mis que 350g de farine, 1 rondelle de banane dessus et dessous la noisette de nutella et mixé une banane dans le lait..resultat garantie!', '2020-05-02T18:46:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253858, fed49373-67e1-4d3c-97d1-c2c406799fcd, 'Excellents ! Super recette mais prévoir un peu moins de farine, 350g c''est parfait.', '2018-10-27T17:37:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253858, fef8f97e-867d-493e-92d7-8ec2d13f3bc2, 'Très bonne recette !! Ça régale tout le monde. 
J''ai juste utilisé 350 g de farine et toutes les autres quantités c''est nickel.', '2018-10-21T02:37:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253858, ed8a657e-1edc-484c-8b1a-c2b9e40a1f5b, 'Mettre moins de farine, davantage de pâte à tartiner. Délicieux car pas trop sucré, peut même être décoré avec la pâte à sucre sans que cela soit écœurant.', '2018-02-06T02:16:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253858, 5e9275b8-dc1f-47cc-8f83-a47e305dc3df, 'Super recette ! 370 g de farine suffisent amplement. J''ai aussi mixé une demi banane avec le lait pour donner un goût un peu plus prononcé à la pâte !', '2014-11-27T21:19:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, bd2b26a9-ebb3-470d-824e-3325ecdd5b72, 'Excellent même sans noisettes ! J’en referai c’est sûr, merci pour la recette ', '2022-03-05T18:02:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 9e4208b0-0435-422d-9e1a-88e74a007d6d, 'Très bon et facile', '2021-03-21T10:39:16+01:00');
