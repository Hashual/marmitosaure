INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 99c131de-ded0-4079-afb1-d9d8d4ed8f93, 'Délicieux et facile à faire ', '2023-03-26T15:44:13+02:00');
