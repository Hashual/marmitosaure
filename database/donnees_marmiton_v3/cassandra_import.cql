INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, ecde15e9-b79e-494b-a995-e942d5c30707, 'Excellent, on fait des cakes banane pour passer les trop mûres celui-ci est exceptionnellement léger', '2022-04-29T20:50:46+02:00');
