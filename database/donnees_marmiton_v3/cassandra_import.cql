INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 3c2f1ae1-46db-402b-8add-78834923cdb9, 'D''une grande simplicité et ça fait le bonheur de la famille.', '2020-01-28T15:58:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, bd14bad4-ca79-490d-a17c-66855946d0d7, 'Facile et bon !', '2019-08-27T03:07:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 7aa4a6f5-1c4b-439e-b075-d7d96386100a, 'très bonne recette, simple et efficace', '2019-05-17T00:51:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, d85df988-8b76-45e3-b8b3-ec9724726e7f, 'Excellente ! A refaire, tellement meilleur que celles achetées en grande surface.', '2018-02-23T11:49:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 4360da41-0aac-4a94-bccd-dc97d2f9cae0, 'Toute simple mais tellement bonne cette recette !', '2018-02-17T07:42:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, dfc1fdd4-76b5-4ced-ba54-2534787e214e, 'Parfait c''était très très bon. Merci pour le partage de la recette.', '2017-09-25T23:50:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 983e04f1-21ea-4251-a7c7-5aadc4771d2b, 'Très bonne recette... et tellement facile à réaliser ! Je confirme que l''idée du Tupperware est aussi excellente.
Merci !', '2017-06-25T10:03:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 26790294-c1d6-4517-a243-2eb54ddf877c, 'Enrobées d''huile et remuées au bout de 20 min  fait avec des pomme de terre nouvelles : tres bon', '2017-06-06T00:13:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 0b9499a7-0ab4-4192-b9b9-eeeac7581825, 'Très bonne idée ! Encore meilleure avec une petite marinade au préalable (huile d''olive + épices ou herbes diverses).', '2016-10-20T14:02:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 0871fa0a-ef58-4a00-9bbd-05dad48e179a, 'Mon fils aîné m''a demandé quelle marque c''était !!! Tout le monde a adoré, après les avoir faites mariner avec huile d''olive curcuma et herbes...', '2016-10-02T14:23:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 789e7646-1681-43b7-9683-8fcc0757d900, 'Super!!! A refaire avec les commentaires des autres, la prochaine fois je fais mariné mais comme ça c''est top aussi merciiii !', '2016-09-13T19:03:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 882772a7-8d3e-4051-a73a-4a426c651d31, 'Super bon avec une petite sauce aux fromage blanc. ', '2016-07-15T13:03:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 7af39309-319e-4783-aff0-e42ad8eee065, 'J''ai épluché les pommes de terre et fait mariner dans de l''huile d''olive avec du thym sel et poivre et c''était très bon.', '2016-05-06T17:47:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 083cbe66-109a-469e-9534-47b389217c88, 'Très bon', '2016-04-22T18:08:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 0996c2c2-e1b0-4ec4-8a49-75254f2405c3, 'Excellent !', '2016-02-17T09:44:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, d2fb8266-eb38-406f-81c3-2f3a44965ed3, 'Facile rapide et très bon ! ', '2015-12-22T01:34:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 2e19b772-f0d8-4ecf-b432-3748035dd978, 'Super ! Hum.', '2015-11-08T21:52:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 8f2d6aa2-96df-467f-8e02-4f00f7e298cd, 'Super simple mais qu''est ce que c''est bon ! Un peu de sel, un peu d''huile d''olive avant d''enfourner : un régal !', '2015-09-13T18:38:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, 6989a865-62b1-406a-a034-d47acc8584ab, 'Au-delà l’oubli du lait, les pancakes n’étaient pas moelleux avant que je rajoute un peu de levure, absente de la recette. Il faudrait peut-être plus d’étapes mieux expliquées et la consistance est trop liquide !', '2022-05-26T17:23:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, bac10b28-cc3b-47de-ad3d-70cc8837a0c7, 'Pancake avec un reste de bananes mûres, c''était excellente pâte très moelleuse', '2022-02-20T18:56:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, 6df9ccd5-8c39-4852-8c09-2447a62e7704, 'Beaucoup trop liquide et la recette est mal expliquée, on ne sait pas quand on doit mettre le lait.', '2020-04-17T10:12:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, f94a5550-56bb-483c-8e56-d0e58606df68, 'Adoptée ! Avec 3 bananes écrasées. Merci ;) ', '2020-03-30T23:00:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, da704c3a-5573-45f0-a2bf-ed222ec95fab, 'Avec 2 bananes pour les gros gourmands et c''est un délice ! Ma moitié en raffole a n''importe quel moment de la journée. ?', '2019-12-03T12:20:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, 75bef87c-5e99-4c3d-9e3b-f7294284b555, 'Validée à 100%.', '2019-10-17T17:44:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, 459ba1b2-392f-44f3-a5a3-bfca5452c37d, 'J''ai juste mis 20cl de lait et 1 banane entière, et ils sont délicieux !', '2019-06-25T08:42:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, bbce1a6b-b0a5-4ca0-a92d-2af14e0014fd, 'J''ai remplacé le lait avec du lait végétal (amande), mixé une banane entière au lieu de la moitié d''une. Cette recette est super :)', '2019-01-31T07:58:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, 3ddbfcaa-bd28-43cb-b2ec-753429068dad, 'Étant intolérante au lactose j’ai remplacé le lait par du lait de coco et je n’en suis pas déçue ! Ces pancakes à la banane sont délicieux, bien moelleux et en en faisant de petits on peut en avoir une vingtaine ce qui est génial pour une grande famille.', '2018-08-18T09:54:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, 310b75e9-c596-47fc-aef2-7a1c9fce52c6, 'Ne pas hésiter à essayer cette recette de pancakes. Je les ai faits à la banane et ils sont très bons, tout le monde les a appréciés et en redemandent. ', '2016-04-15T17:52:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, 11edd4b9-488c-4fa6-a053-06e61a1c980f, 'J''ai ajouté quelques flocons d''avoine, les enfants se sont régalés ! J''ai mis un peu moins de lait également.', '2016-01-26T19:58:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, 12ed9f82-2889-4c87-b91f-8cf2fa6f8393, 'Super recette que je conseille à tous ! Très facile à réaliser, surtout lorsque l''on a un blender. Par contre, personnellement, j''ai bien mis 25 cl de lait et deux bananes très abîmées et c''était tout de même délicieux ! J''ai réussi à en faire une dizaine assez épais. Et je vous garantis que ça tient dans l''estomac après ! Par contre, si vous regardez les indications de la recette, ils ont oublié de mettre le lait. Mettez-le petit à petit entre la farine et les bananes et ce sera parfait. Bon app'' ! ', '2015-09-27T22:26:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, 481a5d68-db88-4f84-ad76-2aa494219f8a, 'Excellent !', '2014-06-01T14:19:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, cdf5c586-edfd-4b7f-a0f9-5c5c712f1c2d, 'Je l''ai faite avec de la banane, et un tout petit peu moins de lait que dans la recette, comme c''était conseillé dans les commentaires. Un délice, tout simplement parfait, tant au niveau de la texture que du goût. Merci beaucoup !', '2014-01-28T14:20:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, 876d46c0-c323-49d3-b8b3-f3ec1ba4cd98, 'En râpant les pommes c''est un délice !', '2013-10-28T07:26:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, 0b76668c-859a-4d48-9e28-afdd2c0c2f85, 'J''ai suivi à la lettre la recette, c''est parfait ! Rapide à faire, facile à cuire et impeccable pour le petit déjeuner du dimanche matin.', '2009-04-05T09:01:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, 7efc7028-93d6-4b41-ba62-9fc2522f51cf, 'Je trouve effectivement qu''il y a trop de lait... mais effectivement avec les bananes ça rajoute du goût. pâte pas assez épaisse à mon goût : à voir, j''ai rajouté de la levure ; je remettrai à cuire dans 1/2 heure! ', '2009-04-02T17:07:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, 0254cbf2-a3d2-4235-a116-fc9a3bd90b25, 'Très bon, on a adoré en dessert, à refaire !', '2008-12-29T23:11:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52321, f72e66db-33c8-4b08-bc1e-1ed48c552aab, 'Délicieux!!! Recette très rapide, je n''ai même pas laissé reposer la pâte et c''était très bon! Par contre j''ai mis un peu moins de lait qu''indiqué.', '2008-03-09T16:34:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41915, cad3ce10-c9e0-4c55-8692-2a3e6a19cba9, 'Super, merci ! Faute de temps, j''ai fait avec une pâte du commerce (feuilletée), c''était très bien aussi ! Même sans bananes (pour mon chéri qui ne les aime pas) ! On a du faire quelques modifications : temps de précuisson trop long, temps de cuisson aussi : au bout de 30 min sur la grille la plus basse pour ne pas dorer trop vite, le crumble était bien cuit et la pâte presque trop cuite (malgré le jus des fruits). Je ne m''attendais pas à avoir une pâte qui tienne sous le poids des fruits, c''était une bonne surprise ! Aussi, on met moins de beurre : pas nécessaire pour pommes, cuites à feu doux et avec le sucre qui caramélise un peu elles étaient déjà très parfumées ! (cuisson qui réduit le liquide rendu au four, je retiens l''astuce pour les prochaines tartes!). On a fait un crumble classique : 150 g farine, 75 g beurre, 60 à 80 g sucre. Donc pas de repos au frais. Les proportions pâte/fruits/crumble sont parfaites ! En prime : la double gourmandise de 2 desserts en 1. La pâte et le cr', '2012-04-12T01:08:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41915, 94bbee48-2c38-4739-b000-c2abedb5a0f4, 'Très bon, j''ai ajouté du chocolat coupé grossièrement au fond. Par contre, le côté "tarte" n''apporte rien à mon avis. La prochaine fois, je le ferai sans pâte, juste les fruits, du chocolat et le crumble !', '2011-12-07T02:27:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41915, f4df9980-5cd6-4760-9fd0-f8d89cc56fa5, 'Recette délicieuse, j''ai ajouté des pépites de chocolat avant la cuisson... Exquis. Le crumble manquait juste un soupçon de croustillant mais cela restait délicieux tout de même.', '2011-09-25T00:04:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41915, 66e3cdd1-be4a-4559-9bd0-674340ebbdbe, '3 belles pommes suffisent...avec une boule de glace vanille, c''est juste délicieux...', '2008-10-23T13:21:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41915, a1136fc8-ac8b-4c5e-9c3e-d06c3c9c499e, 'Une bonne recette pour un dessert d''automne mais le crumble était un peu dur (cuisson trop longue ou trop de cassonade ?). J''ai choisi des raisins qui tiennent bien au four (muscat italien rouge)et la prochaine fois je ferai une pâte brisée maison bien meilleure!', '2007-10-02T18:08:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41915, ee380d17-b059-4e27-8aa7-bdfcac120eb7, 'Mmmm...', '2006-10-29T23:38:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41915, 323fda1f-95e0-4174-a8c4-ba090629564e, 'Délicieux, j''ai adoré ce dessert. Je n''ai mis que des pommes et j''ai servi accompagné de glace vanille, les convives ont tous aimés.', '2006-04-11T00:36:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (89392, 7b1c6cb5-5309-44a9-927e-2107406a4c43, 'Le chocolat n''était pas assez liquide et ne s''est pas répandu comme je l''aurais imaginé sur les fruits. Le mélange fruits crus/crumble, bof ... Je ne referais pas ou avec une crème au chocolat plus liquide.', '2009-10-17T16:36:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (89392, c9b9b934-2d06-4b2d-a3f4-180009185424, 'Super bon ! J''ai remplacé le chocolat par de la pâte à tartiner aux noisettes et on s''est régalé avec mes deux enfants !', '2009-10-03T13:20:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60670, c5b67193-1637-478f-933c-b4ccff43189e, 'Impeccable, un franc succès en dessert de Noel', '2017-12-27T10:50:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60670, 5c36c6f2-d65a-45c7-99d6-6b9d2e96c47c, 'Super ! Seule différence avec la recette ci dessus, j''ai remplacé les fraises par de la clémentine et quelques noix. Un vrai délice. A refaire !', '2011-12-21T19:51:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60670, 4e539977-2a40-49c1-92dc-36a53fc96250, 'Je l''ai faite hier avec un ananas frais, j''ai mis du sucre en poudre - sucre vanillé et un peu de cannelle. A refaire.', '2008-06-23T20:33:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60670, 9ada7b62-40b9-4a04-ae42-18e519622eba, 'Comme je n''avais que des cubes d''ananas au jus, j''y ai ajouté un peu de coulis de framboises. Salade de fruits classique.', '2008-05-17T17:46:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345352, cdbd30de-c3f3-4805-8d8f-22ee33b6de70, 'Bonne idée de rainbow smoothie même s''il est un peu volumineux et que la mâche ou les épinards pour la couche verte c''est un peu bof comme idée ! Je l''ai remplacé par du kiwi et un peu de colorant vert ça allait très bien !', '2019-08-26T03:12:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, b6fcd473-c205-4e50-9a59-afa19c58a0a1, 'Excellente recette ! J''ai mis 100 g du sucre et 75 g de beurre, c''était parfait ! En revanche je pense que le goût du citron dépasse le goût de banane, je testerai la prochaine fois avec moins de jus de citron.', '2018-10-30T17:26:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 765afb04-479e-467d-a023-bb9bcd779492, 'Je n avais pas de jus de citron mais c est quand même réussi et super bon. Vu la consistance, j en ai fait 8 parts gourmandes 😉', '2023-08-25T18:38:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 5b5cfcc5-eafe-4dcb-8796-fd353b1a8b62, 'Excellent ! Je l’ai réalisé avec mes enfants, ils ont adorés ', '2023-05-10T21:59:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 4dda7541-f5fd-4f56-88c7-0dcd32dc4835, 'Très bon cake auquel j''ai simplement ajouté 80 grs de chocolat concassé,  effectivement 100 grs de sucre est suffisant,  45 min au four à 200 degrés.', '2020-12-10T17:44:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, c479859e-bf42-4bad-a900-eed48a67a3dd, 'Très facile. Super bon et une bonne manière d''utiliser les bananes trop mûres ', '2020-03-27T20:12:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 5e615c5c-8f6e-457d-8b7e-c9c158f0e045, 'Très bon gâteau, j''avais une banane bien mûre que j''allais jeter, elle a donc été réutilisée.100g de sucre sont en effet suffisants.', '2020-01-05T17:26:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, ff06f8de-697f-4620-8052-50686446fec6, 'Recette excellente tout le monde a aimé à la maison, j''ai mis 2 bananes et 100 g de vergeoise à la place du sucre.', '2018-11-10T10:54:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 893b9dd6-1a2f-4efd-b3a6-daad0361372f, 'Délicieux. Apprécié par la famille, fini par les collègues! Il a nécessité un temps de cuisson plus long. Attention, le couteau ne ressort pas sec, même cuit...', '2004-10-05T23:14:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, e5c9b740-82ac-4b78-ae46-ce3d3f77c309, 'Recette au top ! J''ai un peu modifié en fonction de mes "fonds" de placard. Il ne me restait que 75g de sucre roux. J''ai ajouté le sucre vanillé et trouvé du cacao pur légèrement sucré. Au final, j''ai séparé ma pâte en deux et réalisé une version marbrée. Je n''ai pas mis de citron mais une cuillère de lait pour respecter la proportion de liquide. Une autre fois, je testerai avec un chouillat de rhum.. .', '2024-01-21T20:04:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 18138486-048b-4918-a693-6d2abfaa110d, 'Très bon banane+citron, Mais, beaucoup trop sucré, c''est un peu dommage, si je le refais, je ne mettrai que 100 grammes.', '2023-02-26T20:53:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 0dc837c1-5cd5-4a7e-ac2f-40453c8fb906, 'Excellent ', '2023-01-31T16:35:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, f1ececf5-2f3a-4486-bb3b-28f68d92ae03, 'Le petit goût de citron se marie parfaitement avec la banane !', '2022-12-03T17:24:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 93dbaa15-be5f-4011-ba37-dfc6dac748f9, 'Avec des pépites de chocolat et cuit dans des moules à cannelé pour en faire des bouchées.', '2022-11-30T08:52:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, a3ab581d-5366-46e2-b778-153e0f726343, 'Bonnes proportions pour 6 personnes Par contre, j''ai réduit de 100 g le sucre dans la recette.', '2022-09-22T17:39:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 0e685163-c8ff-40ca-92fc-3d0f8cf53ac6, 'Goûté parfait!', '2022-07-10T16:07:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 451688f4-e208-497f-9f85-67cf9cacbd13, 'Excellent !!  Avec un peu de cannelle...', '2022-06-10T10:42:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, b6ba944b-5edc-4b8d-aefd-9e5c4d266d91, 'La prochaine fois, je mettrai un peu de rhum', '2022-05-05T21:03:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 7ca49969-11e2-49f3-842c-b2d3f71cf56a, 'Délicieux ', '2022-01-19T19:42:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, b880aa8f-2510-43c1-aff8-c8e90d0e65f4, 'Super bon  !!  A refaire  sans hésitation  ..', '2022-01-06T14:31:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 68c9c243-ac8f-4199-bdf2-b2cd9cbc93dd, 'Super bon !!!! ', '2021-11-11T15:52:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, c9450b33-f133-405e-8614-a1e5e26a6be9, 'Très bon gâteau, je n''ai mis que 100 g de sucre et monté les blancs en neige. Tout le monde en redemande !!! 😀😀😀', '2021-10-14T13:04:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, be52f5e9-0439-464c-ab4f-bcff37062e09, 'Très bien. J''ai mis : 2 bananes, 2 oeufs, 90g de farine (mix T65 + complète), 1 yaourt et je n''ai pas rajouté de sucre, les bananes étant bien mûres et sucrées. J''ai mis des épices (cannelle, muscade).', '2021-05-26T22:47:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, cb444544-d3a0-4ce1-957d-a7ab5c4ff662, 'Une tuerie ! J''ai mixé les bananes et monté les blancs d''oeufs en neige. Gâteau moelleux et fondant, le citron se marie très bien avec la banane
', '2021-05-23T16:43:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 874937ea-b6f6-4ad2-ae6b-fc93f68bf8a5, 'Toute la famille a adoré ! A refaire sans hésiter.', '2021-04-21T23:37:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 0688d19b-4e29-4954-8ba9-f37d9004f74f, 'J''ai suivi les conseils en diminuant le beurre 75g, et le sucre 100g, je n''ai pas mis le citron.
Gâteau très moelleux, un délice.', '2021-03-14T16:42:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 896abc94-01a7-4989-b0fb-17f672c8cbd0, 'Succulent ? ', '2021-03-14T11:56:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 1aca57fc-ce9e-4b26-84f8-662433be8f6f, 'Excellente recette inratable. J’ai également mis 100 g de sucres, c’est suffisant. ', '2021-03-07T10:44:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, a1bdfbf9-3012-4704-adf1-e45cd2f9c7ec, 'Excellent !', '2021-01-18T07:18:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 41797293-b611-40b6-9c39-260b717ada1e, '???', '2021-01-01T19:01:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 4646a63a-87e5-4cbd-8dcf-846378516c7c, 'Recette testée plusieurs fois lorsque j''ai des bananes mures, une réussite à chaque fois!', '2020-12-12T16:36:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, bbed6034-05a7-4abc-ad95-c62e6ad0c7f4, 'Excellent. Très moelleux, mon mari a adoré. Avec du chocolat fondu dessus, ca devrait être encore meilleur. 
', '2020-12-02T17:16:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 8e3d0e42-7544-4d51-8cde-bdcbc4f79289, 'Excellente recette, j’ai eu un résultat parfait. Merci', '2020-11-21T02:00:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, a5855bb0-0fe2-47d6-b41d-97aca9791c1b, 'Très sympa', '2020-11-09T14:23:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, dd5dc513-f063-4c87-81d9-bfe5c793bcad, 'Recette excellente je recommande ', '2020-11-08T18:17:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, fbf5b161-fa73-4439-bcbc-3d1e979678e3, 'Super recette, mais je n''ai mis que 140g de sucre, ce qui est largement suffisant ( surtout si vous utilisez des bananes mures)', '2020-10-08T16:17:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 570ceae4-a6fb-4453-b365-4ab74f086d9f, 'Très facile et rapide ! Très bon aussi avec moitié moins de sucre, un peu moins de beurre et un peu de poudre de noisettes.', '2020-07-02T16:01:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, af7309e1-a693-4704-a878-2769586238ce, 'Une super recette à garder, tout le monde s''est régalé! Par contre, si vous êtes au régime, passez votre chemin...;-) A tester avec moins de beurre et moins de sucre mais parfait comme ça !', '2020-06-20T19:48:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 1e8cca2b-e9f2-41c1-9c1f-cc7899952709, 'Facile a faire et excellent.', '2020-06-04T13:05:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 1acc0fdb-02f4-4221-a29a-d35679ac013f, 'Juste parfait !  !  ! Ultra moelleux avec un bon goût de banane. Je n''aurais pas pu trouver mieux. Je garde la recette. Gâteau à refaire et re refaire ! Par contre, comme conseillé dans les commentaires précédents j''ai utilisé que 100g de sucre et j''ai supprimé le citron. Après c''est juste une histoire de goût. Bref, merci Marmiton !', '2020-05-26T19:46:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 29d72094-e4b0-4692-8f8d-b51acc600af6, 'J''ajoute un peu de rhum et de l''extrait de vanille c’est super bon !', '2020-05-18T18:11:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, ed792b8d-dfa0-4c98-8849-f37ff7cdb8d0, 'Très bonne recette, je recommande ! ', '2020-05-13T20:20:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 9de0977e-0ac0-42df-90bb-18ca15b9df1c, 'Gateaux super leger et moelleux a l interieur , j ai rajouter de la poudre de noisette dans la recette ,un pur delice .', '2020-05-08T14:11:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 9b552839-1ff5-4e83-ad04-d1f73c9d0e14, 'Excellent ! J''ai ajouté de la noix de coco râpée.', '2020-04-27T01:19:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 0c78904a-7340-4979-9524-d9630f505511, 'J''adore ', '2020-04-18T21:43:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, c1850f85-6f03-406a-8ff2-bf89d63b05c3, 'Alors il vient de sortir du four, juste trop beau, 180° chaleur tournante, j''ai PAS mis de zeste de citron car il etait traité le mien et ca aurais fais trop de citron comme dis dans les autres avis plus bas. J''ai mis 75g de beurre, et 100g de sucre car la banane fais deja le sucré + un sachet de vanillé et de la cannelle. J''ai mis que 2 bananes Le couteau ressort sec et il est moelleux. Plus qu''à gouter mais a devrait aller !', '2020-04-08T16:53:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 1a951e60-fe73-4f81-9dbf-aa9c14ad993d, 'Très simple à faire et délicieux.', '2020-03-30T17:17:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 8997e365-9b04-4a9e-8efe-902a0b949340, 'Délicieux mais bourratif.', '2020-03-30T14:59:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 98ff5d74-6e20-4dee-8cdb-0c7d9c89797b, 'Excellent, on en fait a chaque occasion. Je rajoute 5 cuillères à soupe de coco râpée. ', '2020-03-29T11:39:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 868ca203-4eda-4d89-8384-7f6adeff4a1f, 'Excellent ! A manger aussi bien chaud que froid.', '2020-02-23T02:56:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 3aac15a8-1902-4712-a0d7-d09f9b381bce, 'J''ai rajouté du lait autrement trop embêtant à mélanger. Autrement excellente recette.', '2020-01-23T07:22:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 65637d48-7630-45fa-a9a1-438d77759e20, 'Très bon cake. Pas gras et facile à faire. Vraiment excellent !', '2020-01-06T15:55:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 12df91c3-5702-4b22-82fc-0eec28cab4c2, 'Délicieux,  parfait pour le petit dej.', '2020-01-05T08:36:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 33e8e57f-1349-4338-b9ba-2fc2f71b0521, 'Une très bonne recette ! Je n''ai mis que 150 grammes de sucre mais j''ai ajouté des pépites de chocolat et un peu de noix pour le décor.', '2019-11-24T17:36:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 9d611a66-aa32-48fb-9b38-17201c1ed650, 'Franc succès!! Excellente recette, en revanche j’avais rajouté des pépites de chocolat , chocolat/banane toujours un mariage heureux! Peut être un peu moins de beurre la prochaine fois? Mais une prochaine fois c’est sûr il y aura !', '2019-11-06T12:00:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 13128be8-2495-4188-a9b4-1dcbf42e9864, 'Excellent !!! Le goût prononcé de la banane est contrebalancé par le citron. J’ai ajouté des pépites de chocolat à la fin de la préparation, avant de verser dans le moule et de faire cuire.', '2019-10-22T03:39:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 9fbf7fea-cfe0-4b49-ad5d-9ade51424712, 'Super cake ! Ni sec ni bourratif !
J''ai diminué a 75g de beurre et 100g de sucre, et c''est bien suffisant à mon goût. Merci pour cette recette.', '2019-10-01T09:59:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, f1a07363-fc5a-4d06-b304-4455bfc656a8, 'Très bon avec moitié moins de sucre et des pépites de chocolat en plus! Merci pour la recette !', '2019-09-26T07:54:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 6dd712a0-a12e-456b-b857-4a11b5c3582e, 'Recette juste top. Je l''ai faite plusieurs fois et elle est toujours aussi délicieuse. On m''en demande toujours la recette.', '2019-06-28T13:17:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 201339f1-603e-40bd-823a-2f58727914d3, 'Très bon, moelleux à souhait, et très simple à faire ! Seul changement à la recette : moins de sucre (150 g). Et le temps de cuisson est à adapter en fonction du four (chaleur tournante, etc...) : ici, 40 min ont suffi.', '2019-06-15T03:10:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16499, 018169e0-880d-4a1d-b7fb-225d50e49458, 'Délicieux ! J''ai remplacé le citron par 1 cuillère à café d''arôme à la pistache mais j''aurais pu en mettre 2. Cuisson parfaite, gâteau moelleux. Je referai cette recette !', '2019-05-29T03:30:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (332606, 78af136d-44e4-47ce-9a12-0fc879ce940f, 'Une recette sucrée-salée qui fait voyager toute la tablée ! Un délice !', '2019-01-11T11:15:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (332606, 7e1e15a1-b834-4f31-b239-f185d86921df, 'Recette originale et bonne. Je referai...', '2016-06-07T01:42:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (332606, 069777be-044a-4659-ada8-2d6f7786ce9b, 'Recette originale, simple et très bonne.', '2016-02-28T19:03:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12016, f7569cd0-9eeb-427e-878a-40f0d23e2e8a, 'Je n''avais pas vu qu''il ne fallait pas mixer donc cela a donné la soupe qu''on voit sur la photo, pas tout à fait veloutée car il reste des morceaux de lentilles. La recette a été différemment appréciée selon les membres de la famille, moi j''ai bien aimé mais pas adoré. Je ressaierai sans mixer la prochaine fois ! ', '2014-03-17T00:03:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12016, 2d52900b-2d0d-43b0-94ad-8c601b689d31, 'Vraiment bizarre comme goût, on a pas aimé.', '2014-02-09T19:12:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12016, 3b364a34-af6e-48f8-a9c7-eafd6903f9e9, 'Très bonne recette de soupe en plat principal! Mariage original. Un peu plus de cuisson pour ma part, pour que les lentilles soient cuites. Passer au mixeur c''est aussi bien pour ceux qui préfèrent les veloutés!', '2007-01-05T22:06:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12016, 7e6eb6c8-4963-46f4-9448-3e5ddc94bc0e, 'Original et suscite l''étonnement...Pas très joli et peut-être un peu copieux, je propose de passer la moitié au mixer, pour faire une crème avec des morceaux, le goût n''en est que plus mystérieux et la texture plus riche...', '2006-03-02T03:52:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12016, e1642e28-b429-41a8-ac49-05a800f4fe3a, 'Le goût est très intéressant, à mon avis c''est une très bonne recette pour faire aimer la soupe aux enfants ;)', '2006-02-17T11:10:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12016, 5fa9310d-6443-4a0c-8d67-f185cd2a3965, 'Excellent, le goût est surprenant, vaut la peine d''être essayée.', '2006-01-12T21:11:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12016, 9eb459f0-0eb5-47f9-92ca-4e0afa9158d2, 'Pas mal du tout! Pour accentuer un peu le goût douceâtre des bananes plantains, on peut aussi ajouter des carottes revenues avec un peu de sucre ou de miel. Par contre, je préfère doser directement mon curcuma et mon gingembre (ingrédients principaux du ''curry''). Plat consistant, qui devient vraiment complet avec de grosses crevettes ou quelques morceaux de porc... Mérite réflexion...', '2005-12-22T12:07:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12016, 76418de6-02fd-49a6-80e9-6cc7265b642c, 'A première vue, pas très appétissante. Mieux pour l''oeil servie dans une assiette rose. Soupe surprenante, les goûts se dévoilent peu à peu. Vaut la peine d''être tentée.', '2002-12-04T13:36:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31042, 5a933ba5-b496-400d-8a1e-d057668527bf, 'Recette au top ! J''ai juste diminué le temps de cuisson par rapport aux degrés (210). Un peu de poudre de coco sur le dessus et le tour est joué ! Les fruits ne sont pas retombés donc parfait.', '2017-01-09T19:04:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31042, 7999eebf-0395-41f0-9d8a-753165edd059, 'Deçue ! En général je ne raffole pas des gâteaux avec bananes, mais j''en ai déjà fait plusieurs fois avec de bien meilleurs résultats. Pas beaucoup de gout et un peu lourd.', '2014-04-27T03:18:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31042, 1fc28723-5792-4b31-aab3-a8f2f829d1c2, 'Bon je n''ai pas mis de banane et la version en 100% mangue est excellent : cela a ravi les invités.', '2010-09-26T13:09:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31042, ce20e6a9-14ae-4ae0-9688-b90a692f3904, 'Malgré les talents du cuisinier (ce n''était pas moi mais il a toute ma confiance...) ce cake a malheureusement fini à la poubelle! Un arrière-goût étrange et pas très agréable (la banane peut-être?) a eu raison de la persévérance de plusieurs testeurs. Dommage, la prochaine fois on misera sur une valeur sûre, la tarte au citron par exemple!!', '2008-03-29T12:30:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31042, 6b39ff55-0e10-49c5-8a89-dce990740541, 'Très bon, très moelleux et original !', '2007-12-30T20:17:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31042, 022d1542-9ae2-456d-98e1-9cb57d7639f2, 'J''ai mis 1 seule mangue pour 2 bananes, et bien c''est pourtant le goût de la mangue qui prévaut. Bref un cake très moelleux et exotique avec une touche de noix de coco.', '2007-06-21T21:45:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31042, c5538696-4108-497b-b4c1-4c6b057ac5b6, 'Très, très bon et moelleux. J''ai remplacé 50g de farine par de la coco râpée, l''huile d''olive par du beurre fondu, et le sucre blanc par de la cassonade. Délicieux avec une pointe de cannelle!', '2007-03-11T13:51:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31042, a850381f-305a-43a4-af6d-00a6c5eef394, 'Pas mal, cake "exotique" original. J''ai moi aussi ajouté de la poudre de coco, ce qui renforce le côté exotique. Même avec des mangues très, très fortes en goût, c''est vrai que la banane a tendance à prendre le dessus : doser donc selon vos goûts. Les fruits sont mixés, préférer une autre recette si vos mangues sont tres belles...', '2005-10-30T11:46:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31042, 9d3e1b2f-451c-4c2f-9b77-0ec1c89a909b, 'Pas mal du tout, l''aspect est super, il manque juste une épice pour lui donner un peu de relief... Attention toutefois: la banane a tendance à dominer.', '2005-04-01T18:03:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31042, 01427549-0dc7-40db-b8f1-4b51e0dd90d4, 'Tout s''est effectivement bien passé et les fruits n''était pas au fond du cake. Je préconise de baisser un peu la température du four, parce que 45mn à 210°C, c''est vraiment beaucoup. J''ai testé avec mangue + kiwis et mangue + poire. En tous les cas, c''est un cake très moelleux et pas trop sucré. ', '2004-11-18T16:59:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31042, ab2ae0bc-bff0-4256-bfec-233a58227928, 'Excellent, je le trouve meilleur tiède. Merci pour cette recette!', '2004-10-20T20:01:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31042, b8c818ef-5c80-4cb2-9cf5-3ae0ed667f5e, 'J''ai même ajouté un peu de noix de coco dans la pâte, délicieux et original !', '2004-09-19T19:10:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228157, 82a4d3c7-1060-428c-8796-320dd64e0cb7, 'C''est délicieux. Super simple à préparer pour un bon petit déjeuner.', '2013-10-06T22:49:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12788, a3d39658-c07f-4633-8630-671ea6a6803c, 'Est-ce une version de notre national poulet dg? Si oui drôle d''idée de le faire avec de la banane verte et des oeufs.', '2008-10-01T03:21:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12788, 007bc619-561a-49d4-aaaa-feb40027aeb6, 'Pour éplucher plus facilement les bananes vertes, tremper les environ 30mn dans de l''eau additionnée d''huile après avoir entaillé la peau, celle-ci se décollera comme par miracle !', '2007-07-19T00:20:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12788, 497fb45e-aa83-4906-b485-6cad650dde5c, 'Très bon!  Mais j''ai pas trop aimé découper le poulet cru. Sinon, j''ai fait la recette avec nos bananes à nous :-) Dans la sauce, j''ai rajouté un petit piment.', '2008-01-27T19:55:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12788, 58afcdd0-2af0-4e89-9c80-8bd6466243d8, 'C''est délicieux!!! Par contre (et là c''est simplement une question de goût), je ne le referai plus avec des bananes vertes, je n''ai pas aimé, elles sont trop amères. Sinon le poulet avec la sauce est vraiment très très bon!', '2003-11-14T23:40:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219630, 205a3f4d-77bf-4137-abe3-aa8d26b80304, 'J''ai fait ce crumble dans une pâte feuilletée. Super ! mon chéri a adoré ! je referai cette recette mais avec 2x plus de bananes et moins d''appareil.', '2014-07-04T18:04:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219630, 0cd9980f-506b-4872-baff-58cd87704b84, 'Vraiment facile est très bon!', '2013-01-19T18:04:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22677, 283e8803-704d-416f-b6a9-8e738c01678a, 'J''ai écouté les commentaires disant qu''il fallait ajouter une banane et bien je trouve cela trop fort. Le goût de banane est trop présent, et pour le citron à mon goût il n''a pas lieu d''être.', '2016-12-31T22:12:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22677, fbcb767f-0a65-4491-ae17-c43e6d662cb2, 'Bien qu''il y ait beaucoup de saveurs différentes, l''ensemble est très bon ! J''ai suivi les commentaires et ai ajouté une banane de plus et un peu de rhum. Je la referai avec plaisir ! Merci pour cette recette !', '2012-09-25T23:18:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22677, f6e347e5-9289-4bd9-b7e3-ad5fdd0a1be9, 'Je la fais depuis quelques temps, rien à dire : excellent ! ', '2012-03-11T14:21:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22677, e42e237b-73b4-4880-8fbe-cb8e96b17fe9, 'Je connait ce gâteau depuis plusieurs année mais il y a quand meme quelles que variantes avec cette recette : je met 2 bananes 100g de noix de coco râpée   25 cl de crème liquide  et aussi un peu de rhum mais moi j''enleve la canelle  C''est une excelente recette et elle fait souvent un tabac mais c''est vrai que apres un repas il ne faut pas se servire une trop grosse part!!! Mais moi je ne résiste jamais à ce gateau ...!  Bonne Dégustation   ', '2007-08-29T22:39:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22677, 67fa9479-cd11-40a3-b1da-f0f819510099, 'Excellente cette tarte! Très facile et rapide à réaliser! J''ai juste changé quelques ingrédients : n''étant pas friande de chocolat noir, je l''ai remplacé par du chocolat au lait et j''ai supprimé les bananes!! ', '2006-11-14T11:05:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22677, 828264e6-a44c-444f-9dd5-deb141d39d15, 'Facile à faire et recette originale.  moi, je préfère tiède quand le chocolat est encore fondue, mon copain lui quand tout est froid et le chocolat craquant!', '2006-08-01T19:22:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22677, 29a8c326-2edf-434f-b846-bd0ad0eb9960, 'Pour ma 1ère tarte bananes-chocolat, j''ai trouvé cette recette absolument délicieuse. J''ai ajouté une banane en rondelles sur la pâte brisée, et un peu de rhum arrangé avec la cannelle et le sucre vanillé. J''ai respecté les 100 g et la cuillère de crème, comme conseillé dans un commentaire.', '2005-12-03T19:57:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22677, b82a0b83-4c35-4597-b344-b063c93a3211, 'Cette tarte est très bonne, mais avec les proportions indiquées, on sent très peu le goût de la banane et beaucoup le chocolat... Donc je suis d''accord avec Aurore, il faut mettre une banane de plus dans la garniture (ou alors suivre le conseil indiqué et rajouter des bananes en tranche sur la pâte!) et un peu moins de chocolat pour le nappage.', '2004-08-25T09:07:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22677, 0949dafd-14e6-4b07-b1e1-272ceefeced0, 'C''est un gâteau délicieux, mais je le proposerais plus facilement pour un goûter... Car après un repas, il est quelque peu lourd...', '2003-08-03T14:38:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22677, 07fcfe26-745e-439e-980d-f3e8416aad07, 'Cette tarte n''est pas mauvaise mais:<BR> - il faut au moins deux bananes, sinon il n''y a pas assez de garniture<BR> - une cuillère de rhum me semble indispensable!<BR> - j''ai remplacé le beurre par une cuillère de crème fraîche<BR> - 100 g de chocolat noir et une grosse cuillère de crème suffisent amplement pour le nappage.<BR> Enfin, on sent beaucoup beaucoup trop le miel au détriment de toutes les autres saveurs subtiles de cette tarte. C''est dommage!', '2003-08-02T22:09:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (531072, 2dd4f294-5c8a-404c-a25d-7ece64541fb0, 'Superbe recette pour une diet assurée !!
', '2023-01-19T17:35:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (531072, 1fa1ea3c-9a0d-4deb-94b0-91403307228d, 'Trop trop bon ! Nous nous sommes régalés !', '2022-03-20T15:01:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54524, b4c3c126-44a1-45fa-a758-ae081f63192a, 'Gâteau très simple et rapide, avoir un peu d''expérience en pâtisserie, ne pas mettre trop de bananes ni faire de gros morceaux', '2014-04-17T19:09:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54524, 12e37c09-1c82-45a7-aca9-26fd0bd5ae07, 'Tout d''abord, je trouve que celui qui a proposé cette recette était un peu pessimiste : Il m''a fallu moins de 3h pour le préparer.  Alors, du point de vue du goût , je n''ai pas été déçu. C''est un gâteau à tenter et je pense que vous ne serez pas déçu non plus. (Notez qu''il y a un goût de banane prononcé, à ne pas faire pour ceux qui n''aiment pas la banane). ', '2009-11-08T17:03:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54524, 82af3a0d-e00c-450c-b180-9f7e81578aa6, 'Très bon gâteau !! Facile à faire. J''ai ajouté du rhum brun dans la crème pâtissière; excellent !! ', '2009-03-20T20:22:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54524, b305172b-69b5-4fe3-919e-937ebc2c6b0c, 'C''est une recette qui est longue, mais le résultat en vaut vraiment la peine.  J''adore également le jeu de mot du cuisinier (bonne année = banne anniée = bananier).  Vive la banane! Vive le chocolat!', '2008-05-09T17:53:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 07a1b520-d0b0-4b7f-8fc8-f86e7a0a5af7, 'J''ai fait la recette en ne mettant absolument aucune goutte d''eau, ni sirop de quoique que ce soit et c''était excellent... Le jus des fruits suffit, notamment les oranges, l''ananas et les fraises, à rendre la salade pas "sèche" du tout... Au demeurant, je suis très étonnée qu''un site tel que le vôtre indique de mettre un litre d''eau, c''est énorme !!!! On parle bien de SALADE de fruits, et non pas de SOUPE de fruits... ', '2014-02-24T13:18:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 300c2498-66b2-440e-98b4-31a489b9f7c1, 'A la place de l''eau je mets du jus d''orange frais ou en bouteille et du sucre de canne avec un  filet de rhum blanc. Délicieux', '2013-08-18T12:00:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 203af708-8c7a-42ed-a60d-3580df0743ca, 'Faite avec des fruits frais hormis l''ananas ( mis le jus de l’ananas dans l’ensemble),rajouter un (gros)bouchon de Kirsch,pas de sirop. 
Vraiment excellent, a refaire rapidement. ', '2023-07-14T14:18:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 5fbe5ce9-9bd3-4881-9c4a-902303661219, 'Extra, mes invités ont voulu la recette !', '2022-05-28T17:00:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, eb8ed82c-216a-4643-9a64-02687f7cac2e, 'Très bonne salade de fruits, moi j''ai mis du soho en alcool qui va très bien avec les fruits', '2012-06-01T12:48:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, d6afe9b5-edd4-41cb-ad0f-cef120e00888, 'Pas mal ! Alors moi, je l''ai faite la veille au soir, donc elle avait déjà 24h : top nickel et encore mieux le jours suivant ! Touche perso : plus d''eau et un peu moins de sirop (selon la marque certains sont très sucrés) et faire chauffer le jus avec la vanille et la cannelle !', '2009-01-02T21:42:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, f9a8a45f-068e-4ed1-a405-6987308d5219, 'Très facile à faire et très bonne ', '2023-08-16T18:33:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 3f9cce4c-db63-446a-939d-d5b8b1137fcd, 'Facile et délicieux. Par contre tout réside dans la qualité des fruits. Ils doivent être bien mûrs.
', '2023-07-22T18:23:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, d6f8f3ad-c3ff-4643-bc06-c043257e1b10, 'J''ai acheté que des fruits frais, donc pas de sirop, je vais faire un sirop avec du sucre roux et de l''eau et ajouter un petite goutte de rhum. ', '2023-03-04T19:35:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, bde544f7-ea3e-4252-b2e1-8d13531f55ba, 'Un régal, mon dessert a fait sensation. Vraiment très simple et frais pour un été chaud. ', '2022-05-20T16:41:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, a9d84ca7-9304-4e41-bd9a-dbf8b3dc1aaf, 'Excellente salade de fruits 

', '2022-05-15T11:15:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 13c4c12d-390e-4c55-9fac-2abe3e11954f, 'Parfait le goût est spécial ', '2022-04-02T07:52:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 127922ff-2251-42c5-895e-bc20b7a405db, 'Très simple et rafraîchissant ', '2022-02-19T11:36:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 16208dd0-adda-42d6-b8b9-23b452279a86, 'Très frais , je fais régulièrement cette recette', '2020-08-11T20:05:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, b6c1c51a-965e-4582-b8ee-9a3e5d3fa77e, 'Moi j''ai mis  2 oranges est 2 poires est j''ai mis fruit rouge sodasreming 115G de sucre 5 gramme de canelle est s''est très bon', '2020-07-08T14:56:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, dd01edff-58f1-4605-bdfc-f157e740a0c9, 'Très bon', '2020-04-21T23:49:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 975c4b4f-a408-4384-a3bf-898a8874be7a, 'Recette réalisée avec du jus d''orange comme seul ajout liquide.', '2019-06-23T21:36:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 2dd38912-0e01-4d5f-97f9-5a3b54605973, 'Parfait avec le sirop de fraise et la cannelle, réservée au frigo la veille encore meilleure le lendemain.', '2018-08-31T15:59:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 43fd4cec-6e1f-47d1-b8c4-a744ac7df147, 'Une très bonne recette tous mes amis aiment quand je ramène le plat !', '2018-05-11T19:45:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 2e6dfa2c-a6b8-47b9-9b6e-016d81081955, 'Super, sans bananes et sans eau.', '2016-08-22T20:38:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 67133490-2a35-42da-a8ec-ff8fffbd0913, 'Bien meilleure sans pomme et sans orange ! Le sirop de fraises : très bonne idée ! ', '2016-07-01T22:28:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 3e513736-4b31-40a1-8b6e-eb51f0fc876f, 'Excellente recette, rien à changer. J''ai mis des fraises, des bananes, des pêches, des oranges et un ananas, du sirop de fraises, de la cannelle en poudre, le sucre et l''eau. Simplement délicieux. Merci pour cette recette.', '2016-05-10T13:38:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 8226d830-ba0f-4e97-bb27-55b3299030be, 'Recette réalisée pour le dessert pour le réveillon de Noël après une fondue savoyarde. Résultat épatant: salade très rafraîchissante. J''ai utilisé: bananes, ananas Victoria (plus goûteux), kiwis, pommes, mangue, oranges, fruits congelés cet été du jardin (groseilles, framboises et mûres sauvages), un bâton de cannelle et un de vanille, sirop de grenadine de qualité et 2 cuillères à soupe de Kirsch. La prochaine fois j''essaye avec du Soho pour voir. Mes convives ont apprécié. ', '2016-01-02T11:10:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 080bdc76-0a1b-413e-b958-127a68e2858e, 'Vraiment très bon. J''ai mis pomme, banane, kiwi, fraise, framboise, sucre vanillé, jus de citron. Je n''ai pas mis de cannelle. A refaire !', '2015-08-22T15:04:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 7e3afb44-97f3-4b4a-867d-3c8075d52d7f, 'Parfait a refaire mais j''ai fait avec les fruits aux prix raisonnable poires pommes bananes fraises kiwi mandarine framboises une boite d''ananas nature aux jus d''ananas +jus de fruit rouge+ sucre au goût pas de vanille ni cannelle 4/5', '2015-04-19T01:36:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 404fdd18-d404-4cfe-b497-0bbc13646cc3, 'L''avantage de mettre un litre d''eau pour faire le sirop (ça ma paraissait beaucoup aussi), c''est que les fruits sont encore plus moelleux et SURTOUT avec le sirop qui reste on peut faire un excellent punch en ajoutant l''alcool de son choix.... Excellent ! ', '2015-02-04T11:36:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, b002c7eb-0205-49a5-8148-600e8db6c0e8, 'Rien à changer, vraiment très bon.', '2014-07-10T08:38:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, c109c1d1-95e8-41eb-be30-5727d85a1a8d, 'Excellent  ', '2014-02-20T21:51:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 79c973ed-ab76-4ce0-a351-0b073e318ea8, 'Très très bonne recette ! L''idée de mettre du sirop de grenadine est juste super. À refaire sans hésiter !', '2013-08-19T19:03:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, a1db19e7-6f10-43f8-9887-f84ce180e757, 'Recette très facile à réaliser et délicieuse à déguster ! Réalisée avec des fruits d''été et servie un jour de grande chaleur, les invités en ont redemandé ! A refaire.', '2013-07-31T21:48:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 1eb747de-57da-4e70-8421-7fad731d296d, 'Un petit air d''ailleurs, d''exotisme grâce à ce mélange de fruits frais, un filet de rhum blanc... je la recommande !', '2013-06-30T05:36:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 2acdca25-c7af-4617-b241-86ffd0aea15f, 'Je l''ai déjà faite plusieurs fois et elle a toujours autant de succès ! Enfin, je varie un peu... Je garde la base pour le jus et je mets les fruits dont j''ai envie ! Ce soir j''ai même remplacé le sirop de grenadine par du sirop de cranberries... Hummmm !!!', '2013-03-16T01:28:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 95bb3aa5-a48c-4378-a37d-8a9475b219fe, 'Oui, c''est bon mais au vu des commentaires, je m''attendais à mieux. Rien d''exceptionnel', '2011-11-17T17:13:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, fe52fb26-67b7-4b83-8cc8-0b476853a1ae, 'Mais quel bonheur ! C''est vraiment tout simple, et c''est un délice ! Sincèrement, j''en ai fait pour 8 alors qu''on était 4, comme ça il m''en restera pour les prochains jours et pour le coup j''en suis ravie. Il manquait du sirop alors à la place on a mis 20 cl de planteur et 80 cl d''eau. Mais vraiment, trop trop bon. Je garde la recette avec un grand plaisir.', '2011-09-19T01:44:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 057c0e93-67b6-49ad-97b1-46b7518acfc8, 'Très bonne salade de fruits que j''ai réalisée en suivant exactement les proportions. J''ai utilisé la grenadine de mon enfance : celle qui laisse langue rouge ! Tous mes amis et leurs enfants ont aimé ! ', '2011-07-31T18:06:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, f3aaf0d5-6754-4e91-ab90-0b00e5417f12, 'J''ai préparé la salade de fruit en suivant exactement la recette, 24h en avance. La combinaison de fruits était bonne mais la salade était beaucoup trop sucrée. Je conseille donc d''augmenter la quantité d''eau et de diminuer la quantité de sucre.', '2010-07-26T12:16:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, aacf83c5-a8b1-40a6-88a7-ae99b2d1a106, 'Moi qui adore les fruits, je dois dire que je me suis régalée ! Et pas seulement moi. Nous étions une quinzaine de personnes et tout le monde a adoré ce dessert rafraîchissant que j''ai servi avec une brioche. Les enfants avaient des mines réjouies et se sont servis 2 fois. Je l''avais fait la veille. Vraiment très bon, à refaire !', '2010-01-24T14:06:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72039, 91bbb6f5-526c-4fde-bdc4-1dee5f86785e, 'Géniale! Le sirop était excellent et mes invités étaient enchantés!', '2008-07-21T20:06:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 9e6699fb-0478-41bb-84ab-95277554e756, 'Bonne recette, facile et rapide à faire ! Comme mes bananes étaient un peu abîmées, j''ai du en enlever certaines parties, mais j''ai compensé avec un pot de compote pomme/poire (100 g) et un peu de farine en plus. Le résultat : un gâteau super moelleux ! ', '2013-03-15T10:32:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 9dcf9f48-9614-4c00-9fa0-da916a1b79e8, 'Mon mari adore et me suggère de rajouter une banane supplémentaire pour le prochain ', '2023-09-26T13:09:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, f9a04500-925f-43c4-af02-e19f35d80f6e, 'Je le fais pratiquement chaque semaine, un délice 
', '2022-03-31T16:40:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 5b9adf5b-6810-4af2-8d25-0f6f91902745, 'Bon et surprenant par la texture! Vous avez oublié Marmiton de mettre la dose du sel dans la recette!! J''y ai mis une pincée dans le doute! Merci pour cette recette! 







', '2021-04-15T00:26:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 36a969e5-9574-4f3f-b7c1-28ecdf8b211d, 'Excellent j’ai ajouté une pomme et des graines de courges et pignon de pain, vraiment très bon sa tient au corps pour le petit déjeuner c’est parfait ', '2021-01-30T22:08:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, ea5830e2-868c-4253-9b92-e393e6a08b15, '?.', '2020-08-20T20:27:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, a2323345-637a-4fec-ac55-184fc42055b4, 'J''ai tenté la recette sans sucre ni beurre. Bah ma foi c''est pas si mal. J''ai saupoudré de pépites de chocolat noir c''était top. Peut-être un peu trop de farine en proportion du coup. La prochaine fois j''en mettrai un peu moins ou j''ajouterai une banane', '2019-08-14T09:40:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, c7e39b67-9c5b-4029-944d-c45414af73e3, 'J''ai utilisé 3 bananes et seulement 35min de cuisson. Vraiment délicieux!!', '2018-03-17T09:52:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 1b48111b-ee5c-46d6-99e8-9667048c6263, 'Exellent et très simple, le gâteau qu''on me réclame souvent.', '2018-02-12T09:17:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 8501d636-e819-4170-b09d-6a74936d855b, 'Un régal !', '2017-10-29T20:00:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 281be752-0dbd-4ff3-af90-b7dc57b9bee7, 'Excellent ', '2017-05-14T22:54:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, e9b3d9f8-db36-4386-92e9-1794036da0dc, 'Très bonne recette, mais je l''ai faite a ma sauce, moins de sucre, plus de bananes, moins de beurre... moins calorique pour moi, ça a fait un malheur, ils ont adorés ! merci ', '2015-02-05T10:49:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, ba204bce-f98e-4b5c-acc4-1e79f8cd63c4, 'Excellente recette ! J''ai pour ma part ajouté des cerises confites en morceaux et c''était très bon !', '2014-11-29T17:56:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 235aa110-c079-48c7-b241-ff30c8587ad9, 'Excellent. J''ai ajouté de la noix de coco râpé. Les enfants ont tout dévoré !', '2014-11-05T10:46:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 56eb8f95-fff4-4e36-8565-a2fa28d7d2a7, 'J''ai utilisé de la farine complète et du fructose c*nderel pour un gâteau plus diététique. 30 minutes de cuisson seulement et un résultat excellent et très moelleux, qui "tient au corps" ;-) Comme mon moule à cake n''est pas très grand, j''ai pu faire en plus 3 petits cakes individuels que je n''ai cuit que 15 mn, ils serviront au petit déjeuner. Je refais cette recette dès que j''ai des bananes en trop !', '2014-08-15T16:54:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 0b332258-286d-4db5-bf16-8d790a3a2898, 'Je ne comprends ! J''ai suivi la recette et ai apporté les modifications conseillées... mais c''est vraiment pas bon. Le gout des bananes est trop prononcé, c''est lourd, serré et écœurant. Déçue, je ne le referai plus. Et pourtant, il ressemble à la photo de la recette !', '2014-07-03T04:07:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 80282be2-c3d5-46e1-aaf4-5245e731bdd3, 'Excellent avec 5 bananes même noires et moins de sucre (100 g) et moins de beurre. Et oui pour la ligne', '2014-06-11T20:09:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, dc3cbc5b-b5a6-4a60-96d8-2791afac6da8, 'Succulent, bien moelleux. J''ai suivi les commentaires en ajoutant des pépites de chocolat, un mélange de 4 épices, 2 bananes de plus. Pour les 130g de sucre : j''ai mis moitié cassonade, moitié sucre blanc. ', '2014-03-27T23:47:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 6736e109-edc8-4725-8e23-1f6e2a53b558, 'Très bon... moins lourd que le cake banane.', '2013-09-08T17:10:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, bdc831ea-2de2-4505-92f5-fcf465e8ae55, 'Excellent, très moelleux ! Cela manque peu être un petit peu de croquant sur le dessus, mais très simple et super rapide...je vous le conseille.', '2013-05-12T22:53:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, e5917407-ac65-4504-80bd-f727e72767ca, 'J''ai rajouté 100 g de pépites de chocolat, mis à part cela j''ai suivi exactement les proportions et c''était très réussi !', '2013-04-22T00:34:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 78936e87-c9f7-47be-aa71-993fc33291d9, 'Simple et bon. J''ajoute une banane de plus, utilise 100 g de sucre roux et le résultat est delicieux!', '2012-07-07T10:49:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 6b08c585-51ca-4ac8-be92-1e74aea9d48c, 'Très bon gâteau, j''ai suivi les remarques: 4 bananes bien mûres et quelques pépites de chocolat. J''ai également ajouté un peu de mélange 4 épices. Cuit dans moule à cake: très moelleux et pas sec du tout (temps de cuisson normal) A refaire sans hésiter! ', '2010-10-24T11:20:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 4af48108-2f27-4fb4-83eb-ac4126bc35f3, 'Facile, rapide et délicieux (d''ailleurs, il n''y en a déjà plus). A tester sans hésiter.', '2009-08-09T05:03:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 5e7bc5cb-99f2-479b-b5df-a3ae76a103b4, 'J''ai un peu modifié les proportions de la recette : 250 g de farine, seulement 100 g de sucre et surtout 100 ml de lait de coco. Du coup j''ai fait cuire pendant une bonne heure, à 180° pendant 45 min puis à 150° à la fin. Et ça a donné un bon gros gâteau délicieux, mouillé et savoureux !', '2009-04-18T16:51:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 2d623775-2b13-43e1-84d6-3a370083eacc, 'Très bon, recette faite sur le pouce, grands et petits ont adoré !! La prochaine fois j''essaierai avec des pépites de chocolat en plus. ', '2009-04-10T03:44:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, fb942ff8-2611-408a-a21e-fc4898f28ad9, 'Très bon, cependant la prochaine fois, je rajouterai ´1 ou 2 bananes car je m''attendais à plus de goût de bananes.', '2008-10-11T13:38:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 0df6c208-cdfd-46e3-9bb9-c07bbcee6263, 'Délicieux ! Un conseil :ajouter aux bananes écrasées avec une cuillère à soupe de crème fraîche de façon à obtenir une mixture homogène !', '2008-04-14T21:05:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, d1c69b0c-caa5-4206-87a1-adcf371d3897, 'Pour que cela soit moins sec, nous l''avons laissé moins de temps au four.', '2008-03-21T22:50:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, a818ef15-b5a9-4512-84cb-1df6e8aae88b, 'Trop bon! Moelleux à souhait. J''ai rajouté un peu de noix de muscade. ', '2007-05-08T00:21:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 82a196f6-66d3-418f-85f2-4104440068dc, 'Très bon gâteau, à faire comme indiqué dans la recette sans rien changer. Super rapide à faire et très présentable pour proposer à des invités. Merci.', '2007-03-23T10:49:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 74243c5b-268e-427b-a36c-3599faae2b0c, 'Utiliser des bananes très mûres. Il sera plus moelleux.', '2006-06-07T02:48:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 06df3c15-c148-4c43-897c-ea42c34064d2, 'Très très bon et très moelleux! Simple à faire, parfait avec des banannes très mûres. Merci pour cette recette !', '2006-06-05T22:54:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23809, 576290e7-c4bf-4613-b52f-9c8b419e1fcd, 'Très bon quoique un petit peu sec.', '2004-03-08T17:42:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 0a7cef6e-3b16-4776-94ed-698c4070454d, 'Excellent gâteau fait avec 2 bananes tres mûres et 120 g de sucre. Moelleux à souhait je referai sans hésiter ! ', '2021-08-23T17:23:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 34e47c8a-1366-4289-ac5b-60cb954f172b, 'Excellent. J’ai mis de la noix de coco et du rhum dans la pâte et un peu moins de sucre.
', '2023-05-21T12:49:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, c5186df0-3c0c-497b-9ef2-1582bd785663, 'très original, délicieux ! pour la cuisson j''ai du le laisser 10 mns de plus', '2023-02-05T19:15:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 9ab11e84-d811-41ae-9f92-fb7858cf289a, 'Je fais cette recette de cette manière : 75g farine d''épeautre + 75g blé. 70g de beurre et 100 g de sucre. 2 bouchons de rhum. De la vanille. 2 càs de jus de citron. 4 cas noix coco, 2 bananes', '2021-09-07T16:15:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 63582307-2d6c-4eb7-a1ce-b9a03f017d49, 'Excellent , dosage 120 gr sucres, 130gr beurre , ajoit coco dans la pate en plus, rhum et chocolat', '2021-04-06T22:34:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 1aa45fe4-4419-4689-9d58-31eda521efa8, 'Délicieux à refaire', '2020-12-05T14:57:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 05b04a2e-6949-47cc-af46-50a783de5463, 'Excellent ! Facile et rapide à réaliser. Je n'' avais pas de noix de coco... j'' ai rajouté 2 cuillères à soupe de rhum.', '2020-04-01T20:05:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, d1a04e3f-f738-4e48-8f84-5a4c5f3d49f8, 'Très bon !!! Tout le monde a adoré. Merci pour cette recette !', '2019-02-13T10:02:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 40681427-afe4-49aa-8f87-0baf8c28f0df, 'Vraiment excellent et airé ! 
J''ai ajouté de la noix de coco en plus dans la pâte :)', '2018-04-25T11:11:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 5a6c6169-8958-4a69-93b5-912e8160076a, 'Recette très simple et rapide. Tout mes invitées apprécient ce gâteau je me lasse pas de le faire souvent..', '2016-10-30T07:48:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 9e9a90b3-3d81-4fa6-849f-07485d6894f2, 'Excellent je l''ai quasiment mangé à moi toute seule!', '2015-10-18T19:04:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, b759c5d9-5ff0-48d9-a90b-cf92e80906c7, 'On sent fort le goût de la banane, malgré le fait de n''en avoir mis que 2.  Je pense qu''une serait suffisante, cela dépend si les personnes préfèrent avoir un goût de banane léger ou fort. De plus, je conseille de saupoudrer de noix de coco une fois que le gâteau est sorti du four car l''ayant fait avant de l''enfourner, la noix de coco jaunit en cuisant et perd son aspect blanc de noix de coco. A part cela, le gâteau a une bonne consistance.', '2014-07-22T11:50:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, f0a9174e-0c39-4847-835f-66c29866fda4, 'Par-fait! Même sans noix de coco! Merci !', '2014-04-16T21:29:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 4edba126-fe9e-4d12-80d8-a4147f301550, 'Il sentait tellement bon dans le four que j''en ai fait un second... mais alors quel regret il était affamé :( Pourtant recette respectée à la lettre... dommage.', '2013-12-21T09:39:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, c27ee294-a5d5-4a0c-b2c7-6bc398e9b0d7, 'Recette faite avec moins de beurre et de sucre car j''ai ajouté un  yaourt à la noix de coco avec morceaux et j''ai mis que deux bananes. Gâteau très riche et bourratif mais très goûteux !', '2013-09-07T19:24:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 05ba3b62-b7d0-4992-b47f-7fef8c4b55dc, 'Correct, peut-être en allégeant la pâte ça serait meilleur car un peu bourratif ainsi. ', '2013-09-02T17:45:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, a6ee40d8-9e8a-4b2e-b58b-9925fd299f75, 'Bien apprécié. Mélange étonnant à bien y regarder, mais vraiment sympa.', '2013-06-25T12:37:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 8b57b6b0-1951-4e56-b96e-9dbc7d7facda, 'Faite avec 1 banane et plus de coco, par contre avec moins de beurre je pense que se serait mieux.', '2013-06-09T19:27:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, acf55646-da55-4930-9d1e-58587100e5e5, 'Recette facile ! J''ai ajouté plus de noix de coco puisque c''est un goût que j''apprécie tout particulièrement. Par contre, deux bananes sont, pour moi, de trop... Le gâteau est très écœurant... J''essayerai avec une la prochaine fois !', '2013-05-15T15:39:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 282a7437-df67-4d9f-b614-37c85bd5f02e, 'Tout simplement excellent, un vrai régal. 90 g de sucre suffisent. Bon appétit !', '2013-05-05T19:36:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 6c70c6ca-160c-4c2e-8dbc-55454ddafbdf, 'très bonne recette, j''aimerais juste que la pâte soit un peu plus légère !', '2013-03-28T20:27:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 69944e44-8f94-4da2-aa63-642ff5532d8b, 'Je n''ai pas mis de coco sur le dessus avant la cuisson, mais après pour décoration. J''ai réservé une partie de la pâte pour faire un second petit gâteau sans banane, seulement coco. J’allégerai en sucre la prochaine fois (NB j''ai utilisé du rapadura, et non du sucre raffiné). Très simple, très rapide et très bon en tout cas. Les deux versions (avec ou sans banane) ont eu du succès ! A refaire.', '2013-03-16T22:51:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, c7dc015c-7172-4b3f-8ce6-446b54d86e77, 'Simple, rapide, efficace... J''adore ! Et pas que moi ! Merci !', '2013-03-14T22:52:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 02aea65b-5d16-4c30-a40f-a850fd59937c, 'Simple a réaliser et très moelleux. Dans ma préparation je n''ai mis que 75 g de beurre et seulement 100 g de sucre c''est suffisant. J''ai mis 3 bananes du chocolat et de la noix de coco râpée. Cette recette étant simple à réaliser j''en ai refait un la semaine suivante en mettant 500 g de fraises à la place des bananes. A refaire !', '2013-03-13T14:50:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 75c89ed9-0fcb-4ce2-bb2a-94780f8731cf, 'très bon est moelleux, je n''ai pas mis la noix de coco dessus mais dedans!! ', '2013-03-08T10:42:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 374b8ecc-c37f-4770-a2b7-a7dd80fb5b65, 'Très bonne idée de gâteau. Personnellement je l''ai fait cuire 20 min, il est loin d''être sec ! J''ai remplacé le sucre par de la cassonade et j''ai mixé les bananes avant de les ajouter.', '2013-03-02T17:58:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 5c60b654-d0ae-4df4-9975-9060b53308ab, 'Très bon ... Très moelleux. A refaire sans hésitation.', '2013-02-24T11:31:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, a3dab517-3a83-4cdc-95ff-851197e0953d, 'Moi j''ai essayé avec cette recette et pas au top. Il faut ajouter du sucre ou c''est assez fade en bouche.', '2013-02-19T01:55:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 16b1da0d-30f7-4796-b976-426b5cdff20c, 'Je le fais pour la 2ème fois et j''adore ! Par contre, 80-90 g de sucre suffisent surtout si les bananes sont sucrées, d''ailleurs j''en ai mis 5 petites !', '2013-02-17T18:47:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 8b6963ff-d76a-4543-bbbf-005ad0cc9732, 'Très bon ! J''ai mis un peu plus de beurre et un peu moins de sucre. Le goût de la banane n''est pas trop prononcé, idéal pour mon homme qui n''aime pas trop ce fruit.', '2013-02-11T14:28:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, e0687372-d9f4-4583-91ed-cafce33c0d1b, 'Inattendu et vraiment très bon. Pas bourratif du tout, je l''ai fait juste cuit au centre limite mi cuit.', '2013-02-03T21:00:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 507aa9e3-8dba-41b8-b517-a7ba2adfc901, 'Délicieux !!! ', '2013-02-02T14:13:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, d3049045-f584-4f4f-bce2-c30ef5223936, 'Mes bananes étaient trop dures, ça n''a pas plu à ma famille ! ', '2013-01-31T08:26:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 1d605033-dee1-4bb9-be92-f73995d3ca40, 'Excellent gâteau, à manger tiède de préférence. Je n''ai mis que 60 g de sucre et 100 g de beurre, en revanche j''ai utilisé 4 bananes, (3 pour la préparation) et j''ai ajouté un peu de rhum. La prochaine fois, je le servirai avec un peu de sauce au chocolat chaud. ', '2013-01-30T10:47:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 2a68daef-c3ed-4651-90f5-833278289825, 'Gateau bon, mais le goût de la banane est un peu caché par la coco mais très bon. ', '2013-01-30T09:19:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, cc413797-318b-4e19-8535-faa10435cdd4, 'J''ai jouté des noisettes, c''est excellent !! ', '2013-01-29T19:50:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 3ad6d0d0-62b7-4a22-a3e6-f83e24e6973e, '90 g de sucre suffisent. Ajouter 7 cuillères à soupe de coco dans la pare.', '2013-01-28T19:38:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 618c86ae-91b0-41a0-b9bb-1b5e58f60790, 'Super bon, j''ai ajouté un peu de lait de coco. ', '2013-01-28T16:40:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, f599f15a-6f0e-4eb4-95e8-ba77637b81c7, 'Bof ! J''ai trouvé ce gâteau plutôt sec, peut-être parce que j''ai mélangé la noix de coco à la pâte. Je ne le referai pas', '2013-01-28T14:50:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 614fdfd6-f3e8-4bd3-865b-b4ba55279bc0, 'Gâteau facile à faire et en plus très très bon. Merci.', '2013-01-28T11:04:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 525fa8f6-6c62-4dd7-9e4c-10a922403fce, 'Trop bon !!!! Rapide a faire. Le plus long, c''est attendre qu''il refroidisse pour le déguster !!!! ', '2013-01-28T01:41:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, d9374059-35b4-4e73-b3a3-928747b60b47, 'J''ai fait ce gâteau pour l''anniversaire de ma fille et je ne le regrette pas. J''ai suivi les conseils et je n''ai mis que 100 g de sucre, par contre j''ai mis une cuillère à soupe de noix de coco râpée ainsi que des pépites de chocolat dans la préparation. Résultat : un vrai délice.', '2013-01-27T19:03:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 77a74d8a-f12b-4abb-b4ed-33242718e137, 'Gâteau très sec. Je n''ai pas du tout senti le goût de la banane. Je pense que demain matin à tremper dans le café ça peut passer mais bon !!!', '2013-01-27T01:34:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, e7814509-c8a8-4b97-8ba3-f64a340036ee, 'Merci beaucoup pour cette recette simple rapide et délicieuse. Enfin un moyen de se débarrasser de ces bananes trop mûres que mes ados refusent de manger.. 100 g sucre sont suffisant comme le suggère les commentaires. Bravo ! ', '2013-01-26T14:59:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, f2023155-3fec-452b-9fef-11996fc22e15, 'Rien à dire : excellent, très goûteux, très moelleux, parfait !', '2013-01-26T08:54:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 148ca7ec-8dfa-47e3-8699-a8486971de08, 'Vraiment délicieux ! J''ai plus l''habitude de la banane associée au chocolat, mais avec la coco c''est super. Je le trouve juste un peu sec... Avec une petite crème coco, ça doit être exquis !', '2013-01-25T18:41:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, aac150ff-21ab-44dd-8c11-093633ed0a31, 'Bof, bof... ', '2013-01-25T10:50:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, f92b705e-f51b-4bc3-8b88-d74c285c5063, 'Très bon gâteau... A gardé dans son livre pour quand les bananes sont bien mûres.', '2013-01-25T08:00:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, c3f46d75-aea5-4832-9c42-8e6b1085b3a3, 'J''ai beaucoup aimé ce gâteau. Je le referai car l''association banane et noix de coco est dès bonne. La noix de coco apporte un petit croustillant à ce délicieux gâteau.', '2013-01-24T23:44:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 5500c034-9cbf-4bee-aa64-e24db94f47e0, 'Un conseil : mélangez la noix de coco à la pâte plutôt que de la saupoudrer par dessus, parce que ça brûle et du coup on a plus le goût de la noix de coco. A part ça, c''est un vrai délice !! ', '2013-01-24T20:35:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 7da7bc3b-571f-4d4e-8416-90f03af2604e, 'Très bon, léger et moelleux ! (perso : j''ai ajouté 2 cuillères à soupe de rhum, j''utilise du sucre fructose -donc moitié moins- Je remplace le beurre par du fromage blanc à o%).  Pour le prochain, j''essaierai avec du lait de coco ou de la crème de coco ! ', '2013-01-24T16:33:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, ef7e8095-2ed6-4d34-9c09-7d982e37b264, 'Super, je n''ai rien changé et il était très bon !', '2012-12-23T22:07:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 29e70b33-aeb6-46df-8328-c2b61e91a18b, 'Très bon gâteau... J''ai diminué la dose de sucre, puisque les bananes étaient bien mûres. J''ai ajouté de la noix de coco à la pâte aussi (2 cuillères à soupe mais je pense que j''aurais pu en ajouter un peu plus). Servi avec une boule de glace au chocolat ou à la crème c''est encore mieux. ', '2012-12-15T10:20:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 2fdaa9f7-6d82-4f7b-a4c2-59305c049750, 'Facile et délicieux ! A refaire sans modération...', '2012-12-02T16:19:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, cf39119c-ffde-4c60-b894-bb120e930264, 'Bon mais trop sucré. On ne sent pas le goût de la noix de coco, dommage !', '2012-11-28T18:20:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 8aae38d8-4884-4657-9478-baa134058554, 'Assez déçue par cette recette malgré les commentaires : en effet j''ai suivi les conseils en ajoutant un peu de noix de coco dans la pâte et là c''est vraiment TROP SEC ! De plus la noix de coco sur le dessus a aussi tendance à brûler ! J''ai pourtant baissé la température du four à mi-cuisson et sorti le gâteau presque 10 min avant la fin ! Je ne pense pas que je le referai.', '2012-11-26T14:45:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 2a1a993d-9e36-417a-9186-e4fa3bb3358b, 'J''ai réalisé cette recette pour la seconde fois. Je ne m''en lasse pas, c''est tout simple... mais tellement bon. J''ai ajouté un bouchon de rhum, de la noix de coco et des pépites de chocolat noir dans la pâte. La prochaine fois, je tenterai des pépites de chocolat blanc. Je vous recommande cette recette !', '2012-11-04T22:23:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 669ef6cf-e03f-4659-9070-489e95ea3319, 'Vraiment très bon moelleux ont a adoré', '2012-10-04T07:59:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 993e3bdb-feae-496f-b880-669c7eddb848, 'Super gâteau, j''arrête pas de le refaire mais avec 100 g de sucre, 50 g de beurre et 50 g de lait de coco. J''ajoute 1 cuillère à café de graines de pavot (ça donne l''impression que ce sont les graines de bananes !)', '2012-06-27T12:59:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65962, 9a601768-5dc2-4f57-bd89-7d26d5b46407, 'Fait pour la fêtes des pères, mon papa a adoré alors qu''il est assez réticent quand c''est moi qui fais la cuisine. Pour ma part, j''ai suivi les conseils et n''ai mis que 100 g de sucre et j''ai trouvé ça encore trop sucré. J''ai mis 5 cuillères à soupe de noix de coco dans la préparation, 2 bananes et quelques pépites de chocolat. ', '2012-06-17T14:38:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (218553, 000f027e-d1de-477e-8c67-3c9200c8e67d, 'Très bon, mais personnellement, j''ai rajouter 2 boules de glace vanille. Une tuerie. ', '2020-07-19T18:08:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (218553, 5857e04a-ff34-4447-9b96-1dad09b18bbd, 'Comme nous sommes nombreux j''ai mis trois golden moyenne deux bananes une cuillère a soupe de sucre de la vanille liquide et 30 cl de lait noisette amande. Les enfants ont adoré.', '2018-06-03T09:23:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (218553, 08245de8-35e0-4981-9836-317d72f34b4f, 'Bien, je n''ai pas mis de sucre et ça reste très bon.', '2017-10-09T01:01:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, 3ab15458-3d1a-4823-98d3-b7b7a8a91040, 'Merci d''avoir fait tout ce travail pour que chacun se régale.
Vivement ma prochaine soirée pizza
', '2023-08-11T17:30:50+02:00');
