INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, b9fd8ad6-9853-442f-8f53-d134fc49147d, 'Super recette et vraiment bonne !', '2022-11-26T18:07:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 8234f39b-3c9f-4025-aa5c-6731a1a7d262, 'J’ai adoré. Très bonne recette ❤️', '2022-10-24T16:42:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, df98c35e-cb44-4866-a113-fa805138142a, 'Un régal !', '2022-10-18T19:06:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, e5526a25-ff25-4fba-af61-f962c313f0c4, 'Je le fais au beurre demi-sel, or, je n''ajoute pas de sel et met un paquet entier de levure (qui de base gonfle moins quand c''est mélangé avec)', '2022-10-01T16:05:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 07b84c6f-2269-4391-be9b-6b8faf47aa33, 'Très bon ! Fait avec 120 g de beurre (je n''en avais pas plus dans le frigo), 80 g de sucre dont un sachet de sucre vanillé et sans gingembre (j''ai oublié de le mettre)', '2022-05-23T13:59:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 66efd805-2741-4862-b89b-f087e95e90fe, 'J''adore ', '2022-04-04T15:49:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, bf52c398-01f3-4091-9101-f2ca5613fc65, 'Top j’adore cette recette je l’ai fait plusieurs fois, et l’ai adaptée farine semi complète, sucre de coco un peu moins de beurre. Et une variante avec de la poire à la place de la banane c’est  aussi délicieux !', '2022-02-03T21:58:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, f1040bed-e4bd-4af2-a2f6-151aaa8d40d4, 'Tout le monde adoré ! J’ai mis moins de beurre et de sucre et c’était tout autant délicieux ! 🤗', '2021-11-20T15:06:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 4cbcd9c5-c6c4-4b7b-866b-be7df4562aad, 'Excellent ! j''ai suivi la recette, bien moelleux, c''est un régal.', '2021-08-01T16:20:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, efc490ea-0a02-436a-81c5-3a8b254d79ee, 'Ce cake est à tomber par terre ! J''ai simplement allongé ma cuisson de 15 mn à 180C, diminué le sucre (100 gr) et le beurre (150 gr) et le tour est joué !', '2021-04-11T18:53:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, b12d17d6-2901-4d93-84af-4f2e6bada1b8, 'J’ajoute encore soit des noisettes concassées soit moulues et parfois une banane coupée en deux dans le sens de la longueur pour la déco sur le cake 😍', '2021-03-22T20:35:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 7334acc4-2d17-4740-9668-e709ce133add, 'super bon et facile à faire!', '2021-03-08T19:24:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 31b8e4e6-d3a9-46b7-8c28-3402038c215d, 'Je n’ai pas mis de gingembre par choix c’est tout simplement excellent !!! ', '2021-01-19T16:59:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 9b82cda3-2485-425c-8c9a-9faaba26e14b, 'Facile et super bon ?', '2020-11-12T17:56:51+01:00');
