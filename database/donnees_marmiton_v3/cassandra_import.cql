INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 730123f3-da85-49b1-8515-a32242976d53, 'Très bonne idée ! Encore meilleure avec une petite marinade au préalable (huile d''olive + épices ou herbes diverses).', '2016-10-20T14:02:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 6346a5d6-9b50-42a7-97ad-9eb968745777, 'Mon fils aîné m''a demandé quelle marque c''était !!! Tout le monde a adoré, après les avoir faites mariner avec huile d''olive curcuma et herbes...', '2016-10-02T14:23:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, fef58598-1e28-40fd-a94d-d63c4673ea89, 'Super!!! A refaire avec les commentaires des autres, la prochaine fois je fais mariné mais comme ça c''est top aussi merciiii !', '2016-09-13T19:03:49+02:00');
