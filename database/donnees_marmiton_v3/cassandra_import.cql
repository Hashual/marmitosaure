INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, b0de5a50-4c1a-4ccc-b2c7-eb6d40e1c8b9, 'Reçu de la famille pour repas du soir. J''ai pris des champignons frais. Excellent. Ils ont tous adoré !', '2022-02-20T21:43:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 3274eba0-ec29-469b-92dc-035d059da2ba, 'Génial, je rajoute toujours un knorr de champignon, dans toutes mes recettes de champignons', '2021-12-02T08:45:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 46b577fa-a6db-4480-9b3b-383f64c48596, 'Recette excellente ! La prochaine fois, je la présente dans des mini-cocottes !', '2021-11-01T14:42:52+01:00');
