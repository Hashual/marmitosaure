INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86226, 5a637672-bb15-448a-b000-728aa4782594, 'Avec 1 paille pour faire classe et sinon c''est super bon.', '2020-04-08T15:30:23+02:00');
