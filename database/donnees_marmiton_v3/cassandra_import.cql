INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, df633688-693e-4880-8dee-d2ae5d15b5e9, 'Super recette, facile et bonne 👍🏻j''ai rajouté une barre de chocolat coupé en morceaux et bah top ! 👍🏻', '2021-10-31T20:39:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 91468dcd-8104-4b4d-b82e-2701732eaa0a, 'Super recettes ! Je n''avais plus de levures, jai mis 2 bananes et du lait d''amande a la place du lait, pas de beurre et c''etait super 👍', '2021-08-15T15:58:47+02:00');
