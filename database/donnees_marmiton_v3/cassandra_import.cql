INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, 66aac341-7554-49d2-8c5b-5747c857a274, 'Très bonne recette ! Juste remplacé la cannelle par un sachet de sucre vanillé. Parfait !', '2018-09-15T00:59:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15265, cd335945-e82e-41b6-a6e0-77eb3af5d912, 'Tout le monde a adoré ! J’ai mis un sachet de sucre vanille et beaucoup moins de sucre que la quantité annoncée. J’ai terminé par la suggestion d’une boule de glace vanille : un régal ! J’ai ajouté un filet de sauce caramel !', '2018-08-23T03:56:14+02:00');
