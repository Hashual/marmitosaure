INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, 1ea1b748-52f7-4346-bd62-daa2be4ead09, 'À la lecture et commentaire, j''ai rajouté 75 grammes de fromage blanc et j''ai enlevé 20 grammes de sucre. Un délice', '2020-06-08T00:22:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46774, a407a88b-db5f-4048-8f3c-d2ae38b0f6f6, 'Super recette....rapide. Attention aux fraises qui dégorgent un peu...', '2019-07-19T04:16:22+02:00');
