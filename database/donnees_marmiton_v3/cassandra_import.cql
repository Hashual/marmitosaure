INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164973, e43a1f80-5abb-4ae8-a459-cdba5c0eef93, 'Très bonne recette, dommage que ce ne soit pas les vrais noms des pizzas...', '2012-09-03T13:52:25+02:00');
