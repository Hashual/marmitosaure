INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169362, a2750f71-e6e9-489d-8632-09767a761582, 'J''ai modifié un peu la recette en faisant revenir les aubergines à la poêle au préalable. Mes adeptes du burger ont été conquis et même plus que repus parce qu''un seul par personne leur a effectivement suffit alors que pendant la préparation tous comptaient en dévorer deux. Merci. ', '2012-02-15T18:47:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169362, 95ab2b84-ef53-471f-bb07-97c7c366e28b, 'Super recette, j''ai fait une petite modif : pour le bun supérieur, j''ai ajouté un glaçage au blanc d''oeuf et saupoudré de graines de sésame pour donner un visuel sympa', '2019-03-30T07:55:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169362, 9057af3b-7375-4b9a-b789-07a910635acd, 'On s''est régalé, super cette recette, merci.', '2017-05-03T13:57:09+02:00');
