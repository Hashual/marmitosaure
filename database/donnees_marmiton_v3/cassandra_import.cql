INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 17d3510a-054c-4a29-b58a-d71f6d0c0939, 'Épatant ! Juste avec un peu de sel pour accompagner un plat en sauce. J’ai hâte d’essayer tous les trucs des autres commentaires. ', '2023-01-10T08:03:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 7344f838-caf2-47ad-ae38-91e33861e48b, 'Facile et délicieux.', '2021-08-22T20:57:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, a33c96ab-33e7-428e-8e26-b387054d910e, 'Temps de cuisson nécessaire beaucoup plus long qu''indiqué dans la recette (compter une bonne demie heure en plus au moins). ', '2020-12-12T21:41:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, fd75f2c6-f5a0-4b24-82f3-0cfca92246c9, 'Moi je les vides je fais une purées avec la chair je rajoute du jambon et du gruyère je remets tout ça au four c''est super bon.', '2020-11-11T18:13:40+01:00');
