INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, dc51986b-cdc8-4d53-9d43-ce8e3c68306b, 'Mille merci a vous pour cette recette qui simplement est le meilleur gâteau qui soit. ', '2020-10-21T09:05:07+02:00');
