INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, e964063f-e6bb-4195-8fdd-c829df08b84a, 'Très bon gâteau avec des modifications apportées. J''ai mis 50 % moins de sucre et c''est parfait.', '2022-10-02T11:13:59+02:00');
