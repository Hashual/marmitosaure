INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24946, 4892792f-b9a7-495b-bcca-debdafc4919f, 'Délicieuse recette. J''ai remplacé 50 g de farine par 50 g de poudre d''amande, un délice.', '2019-02-10T14:34:03+01:00');
