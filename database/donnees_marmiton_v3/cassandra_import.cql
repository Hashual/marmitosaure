INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 6c3b3f5b-f073-4659-827a-310909c8eaff, 'C''est très bon ! Mais la sauce est très liquide je pense zapper le lait la prochaine fois.', '2019-09-18T10:53:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, e59df930-03f0-436d-9d6e-3fd79a96b381, 'Excellente recette. Même pas le temps de faire cuire ma seconde tournée de madeleines que les enfants avaient quasiment tout mangé. Un vrai régal.', '2019-04-29T06:11:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 064c1c0f-c662-48fd-a806-1cfc766bb2fb, 'Excellent ! Super idée de badigeonner les lardons (pris à la place du jambon) de moutarde...
Par contre, si jamais on ne met pas de lait (je n''en avais pas), prendre garde à cuire les pommes de terre presque complètement au préalable.', '2018-11-03T03:54:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, c2ec1967-977f-4f92-868c-9f68faddefa4, 'Même si j''ai oublié le lait et pas mis d''oignon c''était bon !', '2018-10-21T17:15:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 93049e2f-28da-4d26-923d-5716ec1afbed, 'Délicieux avec quelques champignons en boite en alternance avec les pommes de terre (histoire de mettre un peu de légumes).', '2018-04-15T21:52:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 3df46527-c2f3-4b98-aed2-75af6cbaef4e, 'Fait avec des lardons et c’était très bon, tout le monde a aimé.', '2017-10-26T23:30:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, c9b26c73-5804-4de0-82f0-68cffec01547, 'Très bonne recette au top', '2017-10-05T12:16:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, a2ee7f38-015b-4660-8161-41577f03451c, 'Très bon. Mon conjoins est difficile et il a vraiment trouvé ça très bon. 
Il y verrait bien des olives et champignons en plus. 
A essayer donc.', '2017-08-10T00:08:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 2582773d-f07e-4fdc-802e-bcb7460ca891, 'Je viens de tester cette recette, j''ai juste remplacé le jambon par les lardons que j''ai fait revenir avec et de la moutarde.  100% réussie, même mon fils de 3 ans a adoré. A refaire, Merci', '2017-05-19T00:06:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 858b59f6-a7fc-4672-9b60-1824c1d4b58b, 'Je retrouve le goût de ma Normandie. À suivre attentivement, attention à la cuisson, j''ai du mettre 20/25 minutes de plus au four. Sinon au top. J''ai modifié la recette pour ma part et j''ai directement mis les oignons pour la cuisson au four, j''ai sauté l''étape de la poêle ce qui me permet de garder le goût des oignons dans le lait/crème fraîche. ', '2017-01-28T23:13:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 3f37df39-4fac-437a-91a8-139941324b3d, 'Un bon plat d''hiver ! ', '2016-11-30T13:55:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 92167da0-0d8c-4f4c-a06b-5b7e90d9d560, 'Très bonne recette mon mari a adoré ! ', '2016-11-19T12:08:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, f8308846-70bd-44e3-a9b4-369e21bd6143, 'Bonne recette appréciée de tous, à refaire...', '2016-06-18T21:21:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 6267d6c0-cced-4278-8244-f6588cf8f26a, 'Très bonne recette. Je n''ai pas mis de moutarde et j''ai mis 150 g de fromage avec 20 cl de crème fraîche épaisse ! ', '2016-06-18T20:49:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, ba35a1ee-ee6e-4280-a51d-3a30fd9897a3, 'Nous avons tous bien apprécié cette excellente recette.', '2016-06-17T22:45:37+02:00');
