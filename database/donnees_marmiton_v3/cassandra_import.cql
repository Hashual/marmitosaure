INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 441199d2-700e-4312-be8c-33a413e6b972, 'Excellente!!! A refaire, c''est vraiment un pur régal, je n''ai pas mis l''oignon pour ma part, car certain en ont une intolérance. C''était délicieux tout de même.', '2019-04-22T03:10:11+02:00');
