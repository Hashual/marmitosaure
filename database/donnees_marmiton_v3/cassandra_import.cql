INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, e346fc9f-da6c-44ad-9d97-da95ceba5198, 'Trop bon', '2023-02-26T18:54:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, f9140fa7-1c9c-4df1-971e-8d350e47d2f1, 'Excellent ! Une légère variante, j''ajoute des champignons crus en milieu de cuisson du riz, ainsi que ceux cuits par dessus une fois l''assiette dressée !', '2022-11-15T11:04:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 2857dcc2-3acd-4499-abcd-d8e2a9d877f5, 'Super bon merci !!!', '2022-11-04T12:10:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 0b8748b6-7654-4225-9293-ebb9a3cbd02f, 'Recette réalisée avec des champignons de Paris (je n''avais que ça) : c''était un régal ! ', '2022-10-27T12:49:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 528012b3-0d80-447d-8e93-3fa96936c1f9, 'Super bon !! Merci pour la recette ! 👌', '2022-10-19T20:26:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 32db5811-008f-46e0-878c-78a535c53308, 'Juste une tuerie !!', '2022-10-05T12:40:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 2010c7b0-4265-47fe-8959-a4228eec3b0f, 'Magnifique ', '2022-06-26T11:44:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, b0afd198-ec5a-4bc2-9018-eb8d5b3fe543, 'Première fois de faire le risotto. Ça marche bien mais c’est pas mon plat préféré.', '2022-04-07T19:21:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 1477e115-bd90-4fc7-8f76-bc809c462b94, 'Merci . Vraiment top . Recette simple efficace , le goût est la ! Je suis de la team « cuisson des champignons à côté » 😉', '2022-02-09T20:17:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, ecf628ce-f706-4a14-8090-63977bc93fde, ' Merci de cette recette " facilaréaliser"', '2022-01-30T14:42:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, ee8b5d81-992b-4a28-ac95-acc54135a370, 'Un must!
', '2021-12-27T20:24:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, cace918b-2ae1-4201-a306-64a8792bedf9, 'Excellent ! Je fais souvent cette recette et c''est toujours une réussite, je met juste des cubes de mozza à la place du parmesan car je n''aime pas ça ^^', '2021-11-25T12:12:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 494d8f2e-e83d-4733-90e5-69733930a82c, 'Tres bon :)', '2021-07-02T14:01:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, c647f6ec-d18e-4b0d-a539-1c8bbbde2051, 'Excellent! Rien à redire :)', '2021-04-03T13:22:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, f76836e1-2cf9-4d8a-b90d-f024997fa3ab, 'Très bonne recette. Je le fais quand j’ai des invités et ils se régalent à chaque fois! ', '2021-02-28T14:33:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, d2ee2a4a-c537-4cda-b5d6-aefc2ad718e1, 'Très bon', '2021-01-24T10:03:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 8a9920e6-97f3-4a53-ac94-4fb2dd6a723d, 'Simple et délicieux !', '2021-01-06T21:11:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 662b7b0a-4896-46d8-b1e5-61d9306f586b, 'Je n''avais pas d''ail mais quand même très bon ! A refaire ', '2020-12-02T21:23:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 101b5215-fbe8-41ef-840a-95199e571cdb, 'J’ai adoré , rapide est simple à faire ', '2020-11-21T19:37:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, a18d940e-b57b-48ab-9b38-fec1888d8abe, 'Un délice ! J''ai suivi un conseil en faisant avec 150g de champis pour 250g de riz. J''ai mis tous les champis après l''oignon comme indiqué dans le commentaire. Nous nous sommes régalés ! Un super plat végétarien de plus à ma liste !', '2020-10-21T16:01:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 8b7babbf-533d-42cc-87ce-196443c51c70, 'Delicieux rien a dire ?', '2020-09-07T22:41:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 4f7e01e5-7712-4934-b0ee-dccf2332f888, '2e fois que je fais la recette... Et c''est toujours un délice et facile à faire. N''étant pas cuisinière, si j''y arrive tout le monde le peut. Juste côtoyer d''avance l''ail et les échalottes en avance pour ne pas être pris de court.
Tout est respecté ni plus ni moins. ', '2020-06-04T11:57:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 884340ba-5c63-4e06-bc07-4611cc303d45, 'J''ai adopté et simplifié cette recette. Tous les champignons vont dans la casserole juste après les oignons, puis j''ajoute le beurre, le riz, je déglace au vin blanc, je laisse évaporer et j ajoute le bouillon en quatre cinq fois. Mes proportions: 1 oignon, 150g de champignons,250g de riz, 20g de beurre, 5cL de vin blanc, 1L de bouillon.', '2020-04-28T15:54:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 2d7ba727-c462-4aae-a1ff-456590fbbc1b, 'Bonne recette ! En revanche j''ai imbibé le riz plus de 11 fois. Il n''etait pas al dente mais cru.', '2020-03-01T08:21:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 6fbc1204-e6ea-4395-9303-fa74dbc260e1, 'Excellent.', '2020-02-29T06:44:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 359972ee-92e5-4039-9df4-f3038f778e1c, 'Pire recette, perte de temps, trop de vaisselle pour un tel résultat ! Le riz est cramé au bout de 2 secondes, trop d’ingrédients et une quantité astronomique de beurre surtout pour un résultat qui laisse plus qu’à désirer...', '2020-01-18T23:16:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 35de5334-a772-465a-b59c-4f711daecce1, 'Très bonne recette que je fais assez souvent ! Plus envie de manger du riz blanc.', '2019-11-12T16:31:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 6fb16109-bca9-427c-8cb3-f60c4036ebb7, 'Nous avons entamé la recette ainsi qu''une bouteille de rouge et nous sommes étonnés de voir autant de commentaires positifs alors qu''ils nous a fallu 4 casseroles et toute notre concentration.', '2019-04-28T22:23:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, e5eed80d-1427-4682-95f2-edfdbcdaae42, 'Vraiment excellent !', '2019-04-22T03:17:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 275d2ccf-cf7b-4bfc-94d7-a1563860b90c, 'Très bon.', '2019-03-17T05:49:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, b734eefe-9fe9-419a-9aeb-078f5985471b, 'Parfait !', '2019-02-18T16:39:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 347c5d1e-1c33-4486-87e9-469c1074fe29, 'Excellent ! Par contre j''ai mis un camembert de campagne à la place du gruyère, c''est tout ce que j''avais et une petite brique de crème entière. J''ai couvert avec du papier alu, baissé la température à 195 et mis le four en chaleur tournante pendant 1h. ', '2024-01-06T14:51:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 711995af-b45c-483d-ba8d-1c730aecb7fd, 'Gratin non pas fondant mais plutôt croquant.. Les pommes de terre ne sont pas cuites après 50mn de cuisson. Alors qu''elles ont été coupé de la manière la plus fine à la mandoline. Tout ça pour ça.. un conseil : faite cuire vos pommes de terre à l''eau au préalable.', '2021-10-31T13:07:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 71907707-62f0-4fc7-b3f2-a97da33222c4, 'Il n''y a aucunement besoin de cuire les pommes de terre avant, car c''est tout le secret de cette recette... les pommes de terre sont fondantes grâce à la cuisson dans la crème. Préférez la crème fraiche liquide et recouvrez les pommes de terre tout en suivant à la lettre la recette! À servir en accompagenement d''un roti ou de saucisses de toulouse.', '2021-01-10T13:11:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 8faebd1a-b0b6-45dd-b32e-a2bc44360b96, 'J''ai fait précuire mes pommes de terre à la vapeur au vu des commentaires précédents. Pour le reste, j''ai suivi la recette (35 min de cuisson seulement du coup). Une merveille !', '2019-04-29T13:38:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, b47ab0a1-99fb-4f31-b4c9-8076ba438a1e, 'Bonsoir. Pour avoir une bonne cuisson il faut que les pommes de terre soit recouvertes complètement... Pour ma part un mélange lait, crème fraîche, sel et poivre... Un délice à chaque fois. ?', '2023-10-31T11:24:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, f1698a9f-7b83-4144-8915-6cea941d0818, 'Recette simple à préparer et delicieuse ', '2023-07-31T18:45:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, c25176f3-6f0b-404b-b733-6ac5904b9f29, 'Faire cuire à l''eau les pommes de terre avant.', '2019-09-08T12:48:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, ffabe57a-705a-4778-9188-4940449e9f09, 'Il faut vraiment faire cuire les pommes de terre avant à l''eau ou au mieux dans du lait. J''ai ajouté du persil et du parmesan et un peu plus de crème pour que les pommes de terre soient bien fondantes.  Un régal.', '2019-03-22T04:45:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 40618562-ccc3-49f6-9f93-abdde368c95e, 'Le goût est là mais clairement cuisez les patates à l''avance ! Le gratin a mis 2h à cuire en ayant fait des tranches fines ! ', '2018-10-26T12:03:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, e42dd0ca-809a-40be-9126-aea9e79fc1cf, 'Déjà testé et le résultat tellement concluant que je le refais dimanche prochain.  
J''ai émincé les pommes de terre au robot et le gratin était super fondant et bien plus léger qu''avec une béchamel ', '2023-09-11T16:13:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 79d89157-b329-484b-abb6-cfff857626eb, 'Un régal ', '2023-05-07T17:17:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 15b3d5ed-c47e-4f61-9b87-04933476feb0, 'Excellente recette ! Pour ma part, je fais une béchamel et j''ajoute le gruyère râpé dedans en remplacement de la crème et c’est excellent, même ma fille adore !', '2022-10-20T11:26:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, b95252f7-47fb-4bb3-ad07-692f8d5ed18f, 'J''ai fait cuire les pommes de terre avant pour que la cuisson soit plus rapide, sinon vous pouvez accélérer la cuisson en ajoutant un petit peu d''eau dans votre plat', '2021-05-23T20:35:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, b9d2871b-78e7-4d8f-919b-fdd20707f630, 'Je viens de la realiser... un succès! ', '2017-08-26T16:22:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 66c02461-7302-4bc1-83b7-b7ce2d3415b2, 'Franchement je ne regrette pas le résultat, c’est délicieux 😋😋', '2023-01-03T13:33:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, eb332cfd-9353-473b-aaf3-8d3f8675c27f, 'C''est une bonne recette. Je l''ai déjà testée !', '2022-11-22T06:57:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 76f457eb-be82-44a2-8ed2-418b9889600a, 'fondant et délicieux, recette simple et efficace à accommoder à sa facon (pour moi un peu d''oignon et d''aligoté, miam miam...)', '2021-10-03T11:30:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 450bd0ff-032d-4203-b4fc-82bb6026055e, 'Au lieu de cuire les pommes de terre mettre le gratin au micro ondes pendant 5 à 10 min selon puissance et terminer au four traditionnel afin qu''il dore.', '2019-04-18T14:47:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 6d50ba14-7ead-4a4b-9a2e-72468bb85fa1, 'Excellente recette ! J''ai coupé les pommes de terre en lamelles très fines et rajouté un peu de lait entier et du fromage râpé sur le dessus...', '2017-10-07T22:13:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 749a0221-1ed6-4101-9cfa-498a0b98b8cb, 'Excellente recette faites à plusieurs reprises, j''ai ajouté de la cancoillotte à l''ail avec la crème fraîche. Pour que le dessus du gratin ne soit pas trop cramé j''ajoute le râpé en dernier et un filet d''huile d''olive et je ne cuits que 45 minutes à 200°C puis 5 min à 220°C. (Pour 4 personnes vous pouvez augmenter les quantités).', '2016-10-12T01:35:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 0a0e9fa9-dd2e-48d3-be12-ac399cd770e1, 'Un vrai délice !!! Simple et rapide !! Merci pour cette recette !! Comme proposé dans un précédent commentaire, j''ai mélangé à la crème fraîche du paprika, du sel, du poivre et un bouillon (cube émietté). ', '2014-09-07T23:23:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 47c5d81f-a651-4316-8d4a-6d076b843e5e, 'Très bonne recette ! Facile à réaliser ', '2023-10-11T11:36:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, a6f2ad81-b49a-42bc-bf9d-080948a95151, 'Je fais aussi la version sans crème donc avec un bouillon de légumes à la place ', '2023-05-01T12:02:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 5600c548-ff27-4878-b710-f129625db42d, 'Bonne recette. J''ai mis de fines tranche d''ail à chaque couche mais pas de beurre, c''était au top.', '2023-03-10T07:39:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 78de0fea-4dc5-4c8a-95b2-ca69684b343d, 'Vraiment bon !', '2022-11-08T18:20:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, ac659fa7-9fb3-4ca0-b5d7-44f75254f165, 'N''importe quoi... Pommes de terre pas cuites, et cramées sur le dessus.', '2022-03-21T21:14:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, e245f8fb-77d0-40ba-806f-a4a4153411ea, 'Un pur délice ! A refaire 😊
', '2021-12-30T17:39:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 5005bec3-d65a-4a56-b356-a1db21c6aae8, 'Excellente recette J ai rajouté des allumettes de bacon  juste divin  et fondant à refaire', '2021-06-05T09:00:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 1a2be28f-82f1-48bc-9141-bda136036768, 'Très bon, simple et efficace. Par contre le temps de cuisson de 55 minutes indiqué est en réalité beaucoup plus élevé mais cela doit dépendre des fours.', '2021-01-09T20:29:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, f9cc737a-80e7-4c84-bc31-a989f5845866, 'J''ai fait cuire des PDT dans le lait et l''eau durant 15 mn, ensuite j''ai suivi la recette, c''était excellent.', '2020-11-20T13:58:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, beaa1606-2026-469d-8a4b-f56a619fd324, 'Bonsoir. Pour avoir une bonne cuisson il faut que les pommes de terre soit recouvertes complètement... Pour ma part un mélange lait, crème fraîche, sel et poivre... Un délice à chaque fois. 😉', '2020-11-03T19:05:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 91b3b05a-135b-4e47-a223-e6e4752cfb63, 'Plat excellent', '2020-09-18T17:47:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 4ab2812e-a825-4236-a0f2-9818051f1f44, 'Recette simple et rapide pour jeune couple. 
Un vraie délice ! ', '2019-10-13T10:02:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 126203ed-1a33-4c89-819d-27842490452b, 'Je coupe mes pommes de terre à la mandoline comme ça, cela fait des tranches très fines donc cuisson plus rapide. Je mélange crème et lait que cela fasse plus onctueux.', '2019-04-27T11:23:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, dbed493b-118d-4ecc-8406-23b449069c3e, 'Top j''ai utilisé du parmesan !', '2019-03-29T07:49:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, baf7da7c-e24c-47f8-b432-c60fc032b27b, 'Cette recette manque cruellement de sel, mes enfants étaient très déçu de ma réalisation ! Par ailleurs les patates étaient toutes crues et brûlées par dessus alors que javais respecté le temps de cuisson. . Des progrès sont attendus !', '2018-10-09T20:56:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 17cdef20-4254-4369-b028-ddb56c46d557, 'Très très bon!!!!', '2018-08-08T07:47:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, c1e69bf7-d495-4a2e-863e-60579790eb1a, 'Un succès  !', '2018-03-04T10:25:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 4675de4b-35ad-4f65-b3e8-25f025049848, 'J''avais utilisé  à tort de la crême épaisse, à mi cuisson j''ai ajouté du lait et pour finir un peu de muscade. C''était très bon.', '2017-08-11T14:48:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, f6cb0df8-eade-435a-862b-46fa7b6a5fdc, 'Delicieuse recette !  ', '2017-07-16T11:09:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 402c90e9-8ca4-4ae4-ad18-bb64ec272e11, 'Réalisée ce soir. J''ai utilisé de la crème soja. Franc succès, très bon et à refaire. ', '2017-07-15T00:15:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 92c7e659-60b6-48dd-be53-2afbd8c438a5, 'Un delice ! ', '2017-05-21T12:08:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, a24052cc-ba82-4af5-9992-0f9589f5fbe8, 'J''ai ajouté un oignon que j''avais fait revenir à la poêle avant, et par contre j''ai du augmenter les quantités de crème fraîche et de gruyère râpé. J''ai suivi les autres commentaires en faisant un peu cuire mes pommes de terre avant. Très bon !!', '2015-10-07T14:32:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 5e99c727-92a9-41c5-9e24-f0e8e8f303e9, 'Très bon ! Avec 2 oignons répartis dans les couches des pommes de terre, quelques lardons ça et là : un régal ! Je recommande vivement ce gratin vraiment fondant !', '2013-01-21T17:44:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 3037e80f-38c4-478a-a164-0c9461493ce1, 'J''ai suivi la recette à la lettre et c’était excellent ! Je n''ai pas hésité à rajouter des lardons pour un petit côté salé.', '2012-06-04T05:14:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, be67a58a-5252-4a4a-bd2f-c0c38d8dedde, 'C''est bien la première fois que je réussis un gratin sans cuisson préalable des pommes de terre. Le résultat est vraiment excellent. J''ai suivi à la lettre la recette. J''ai juste ajouté de la muscade. A refaire.', '2011-08-24T01:16:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 99d21c51-02d7-4ef9-8ea1-c7ba7c7b92cd, 'Délicieux, très fondant.', '2007-04-05T22:26:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 6aac8a4f-a384-4e19-ad49-84a5f35d148b, '1er gratin que je fais moi même, était-ce la chance du débutant??? En tout cas très bon !', '2005-12-28T17:14:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 21bbcd97-b567-4c15-9777-f0d5ac1e568b, 'Très simple et tellement Bon !!!!!', '2023-10-07T11:54:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 701b2303-f338-415f-bc93-6a096a3528a0, 'une touche de noix de muscade et quelques feuilles de laurier vont très bien dans le gratin 😉 à vous de voir et de goûter surtout 😋', '2023-10-07T11:04:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, a13adc71-dbe1-4bc8-9abb-582dbefa2ab3, 'Super recette, j''adore tout simplement ', '2023-05-02T00:29:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, c81b0974-27a4-4d2c-9c9d-c252abc99e6d, 'Top', '2023-05-01T14:15:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 58ac3e6f-6674-42bb-9741-0244ffe1e70f, 'Quelques unes de mes pommes de terre étaient crues … du coup je pense que la prochaine fois je les ferais cuire un peu avant. 
Sinon très bonne recette, je n’ai pas mis de beurre par contre.', '2023-03-11T20:00:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 4f8837e9-33df-45ac-9c5b-681bd325b170, '45 g de beurre ça n''est pas une noix de beurre !!! je suis très gourmande, mais 45 g c''est beaucoup trop !!! sinon excellent 😋', '2023-02-22T12:14:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 8d00ff4e-14c9-438d-b194-88d1e20f0a8d, 'Succulent et peu onéreux !', '2023-01-30T18:24:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 2891ac8d-12db-430d-9158-c78bda360062, 'Excellent 🥰', '2022-07-09T20:01:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, d7620c24-9da8-402d-aeb9-a86920e88184, 'Excellente recette rapide et goûteuse adoptée par toute la famille merci', '2022-04-13T17:51:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 59b3a298-1bb4-4d81-b17b-62a04df25608, 'Recette simple et rapide ! Excellent.', '2022-04-06T14:35:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 45644233-9a63-4a34-9b63-b367a884913f, 'J''ai ajouté un peu de poudre de muscade et quelle belle recette simple, goûteuse et efficace. J''adhère 5 ☆', '2022-02-25T18:12:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37453, 3e0ce328-7ef9-40f0-a30c-e2bf23c5a2cc, 'Très très bon', '2022-01-16T21:44:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312890, caea1a79-7230-436f-b320-7173b148365d, 'Parfait ! Merci pour votre recette. 👍', '2022-02-09T19:03:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312890, 2ec5054c-b1a5-4a4b-b34f-f217e6deae10, 'Super recette !  Vraiment très moelleux ! Je me suis trompé dans la recette, j''ai fait cuire les bananes avec tout le sucre et j''ai ajouté mon mélange à la fin dans le robot, ça a super bien mouliné les bananes ! Tous mes invités on adoré. Par contre, si vous aimez le goût de la banane on peut en ajouter 1. ', '2016-06-18T16:05:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312890, 3b2aecc5-e09d-4609-938b-ad37e3722d5d, '5 cl de lait c''était juste, j''ai du en ajouter ', '2015-12-18T22:16:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312890, 20b41b09-c22f-4dd9-82f7-928dc49ec718, 'Vraiment top, deux fois que je fais cette recette et deux fois que c''est un succès. Excellent. ', '2015-01-03T16:32:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312890, 164cd730-2c41-42f3-b0c4-050accb31d8f, 'Onctueux mais il manque une pincée de sel', '2014-10-12T14:46:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312890, 31add086-9c7e-4444-852f-2af0347f1cef, 'Excellent, ça fond en bouche. Franchement, rien à redire.', '2014-04-26T21:35:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, b7cad049-f920-443a-b08c-2fb7434192c8, 'Les commentaires m''ont bien aidés. L''extrait de vanille était bienvenu, le lait à la place de l''eau aussi. A refaire.', '2016-01-24T13:04:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, eab360f9-3854-4b79-b5b7-fa2bc92cd850, 'Tout simplement délicieux !!! J''ai fait comme certains commentaires l''ont conseillé : j''ai remplacé l''eau par le lait et j''ai ajouté également de l''extrait de vanille liquide pour remplacer le sucre. Une vraie tuerie !!!!!', '2016-03-22T11:15:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, 9b72f138-7cfb-40bb-ae3f-6fed4ae3ea32, 'J''ai tenté mais décidemment je ne connais pas de meilleure recette que celle que je fais : 1 banane bien mûre, 1 yaourt nature, l''equivalent d''1 yaourt en lait, des glacons, 1 pincée de cannelle. Commencez par mixer le yaourt et le lait puis ajoutez la banane et les glacons en dernier. Versez le tout dans 1 grand verre avec 1 paille et saupoudrez d''un peu de cannelle.', '2007-02-28T18:37:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, 8af7457e-63e0-40e3-890e-0257de62f90b, 'Super, les enfants adorent', '2019-02-01T05:02:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, 4eb5800e-e380-4bbd-904e-2e73c465fb90, 'Très bon et en plus vite fait ! J''ai mis un peu de vanille liquide à la place du sucre et du lait à la place de l''eau.', '2014-05-18T21:57:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, 83d41762-ff5a-4d50-9145-fa34dd489a9e, 'Absolument délicieux ! Petite touche personnelle : j''ai mis la moitié d''un sachet de sucre vanillé en plus d''une cuillère à café de sucre. Merci pour cette recette !', '2014-03-12T23:10:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, cbf631cb-e804-451a-95c3-18bf5a5d9118, 'Super bon! avec un yaourt a la grecque nature et une banane très mure(complètement noire),pas besoin de sucre.', '2009-01-04T16:48:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, d5b00f9d-3891-4b21-bf02-cf0baf8b59ef, 'Bien, mais pas assez le goût du yaourt à mon goût, je n''ai pas retrouvé celui que je buvais à Bali. J''ai mis du lait 1/2 écrémé à la place de l''eau.', '2008-07-10T18:15:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, bac9731b-509e-4974-ab00-e722fd919d80, 'Super bon et léger, j''ai remplacé yaourt nature par du yaourt 0% à la noix de coco et je n''ai pas mis de sucre !', '2007-10-28T12:52:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, e4916412-6ade-4575-8666-37d8f46e6b39, 'Meilleur à mon goût en remplaçant l''eau par du lait demi-écrémé et plus de sucre. ', '2007-06-21T08:58:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, 534db53e-24a3-4828-b609-bfeda0fe7f8f, 'Mon chéri l''a fait en ajoutant une demie boule de glace à la vanille, une cuillère à café de nutella et un tout petit peu de jus de citron. Il a adoré.', '2007-06-09T21:23:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, ac708dba-69d3-4d33-9f3d-b1eb28791ba2, 'J''ai essayé avec du lait fermenté. Je crois malheureusement que ma banane n''était pas suffisamment mûre et j''ai du rajouter beaucoup de sucre. je réessaierai avec du yaourt et une banane... noire!', '2007-01-25T15:09:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, b406b97e-d0f4-4aa9-ae28-61f9e48a117d, 'Très simple et rafraîchissant.', '2006-06-18T18:30:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, ef2dbd4c-55ff-4893-a374-84a8a24f876e, 'C''est vraiment super bon. J''en ai fait pour la première fois pour accompagner un curry, et maintenant j''en fais quasiment toutes les semaines. J''adore ça au goûter.', '2006-03-31T11:46:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, 3311c02f-4253-494f-96fd-a2c0b6431369, 'Ce lassi est délicieux et pas du tout épais. Personnellement j''ai utilisé un yaourt à la banane donc pas besoin de sucre. A refaire :-)', '2006-02-17T12:16:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, 47c5b08d-e4ef-44ef-a3bb-99f3f63165e9, 'Je l''ai preparé avec des bananes pas très mûres, et en y ajoutant donc plus de sucre, le résultat n''était pas terrible. La boisson était très épaisse et le goût toujours un peu acide. Alors attention à bien laisser tigrer les bananes quelques jours!', '2006-02-03T17:06:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, 9d2aff09-9bf9-45a9-9077-ac63029dcfdf, 'Très bon, comme dans mes souvenirs d''un restaurant indien.', '2005-06-09T22:26:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, c410cd0e-7ab6-4f0c-a91b-cfb82a2b09f7, 'Parfait, fait tel quel sans rien changer pour tout un repas indien, un petit plus réussi qui nous a fait beacoup de bien!', '2005-05-06T23:34:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, bd466d94-6868-46c7-bdae-c643e4cd928a, 'Très bon et encore meilleur à la mangue. Je rajoute des épices, cannelle, gingembre, cardamone, selon ce que j''ai sous la main et ce dont j''ai envie.', '2005-04-04T03:43:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, e588d88a-e10b-4cfe-91bf-db54a2ffc178, 'Génial, on dirait un milkshake, les calories en moins ! C''est très goûteux en plus.', '2004-12-08T20:43:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20805, d73f7a11-b991-4759-ab76-69f0e11d5fd4, 'Très bon! Ma fille me le réclame depuis que j''en ai fait lors d''un repas indien...', '2004-09-14T12:17:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62616, e1801da0-1b5d-445d-b2bc-e8a0379529f1, 'Pas mal, je l''ai fait avec de la poitrine fumée.', '2020-05-15T23:23:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62616, 331ea762-98cd-49d9-85c9-aa9a0f305985, 'Nous avons aimé, peut-être à essayer aussi avec du bacon ? Merci.', '2016-02-07T20:37:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62616, acc970ff-a9a0-4679-827b-f984b0557f71, 'J''adore', '2022-06-23T18:48:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62616, 737a43df-d3cf-4a9e-ba05-821b9fa1cb20, 'Trop bon 😋😋😋!', '2022-02-14T16:54:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62616, e41e0feb-7695-473e-a9af-a4c222996251, 'Original', '2020-06-08T01:23:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62616, 765fd49e-e34b-4f1d-83d1-718332f2fa26, 'Très déçu, aucun caractère, très fade, je ne referai pas.', '2016-07-02T21:41:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62616, 65165af5-a452-45ae-8091-4cc4ad633e4f, 'Un grand classique à la maison, depuis longtemps. Pour varier les plaisirs, il nous arrive de remplacer le jambon cru par du lard fumé ou de la viande des grisons, et dans ces cas là c''est sans cannelle', '2016-02-05T08:41:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62616, c8df0cc6-67bb-45ab-8b6a-1be37a38cdcf, 'Très bonne association ! ', '2016-02-21T23:07:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62616, 74e3aa6e-efea-420a-a6b3-0f47cf989d5e, 'C''est une recette facile et souhaiterai la réaliser pour des amis.', '2016-02-05T19:52:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62616, 9b886183-e737-491c-84de-a117775ef067, 'Très bon !', '2016-02-05T18:50:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62616, 37ea5371-fa76-48f3-ada1-8c33908fa095, 'Vraiment excellente recette, je la fait très régulièrement et très volontiers!', '2013-02-10T23:02:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62616, 24224154-b085-47d6-8e65-1b6779faad6e, 'Recette succulente testée pour le réveillon du 24 décembre et tout le monde a adoré. Ne pas faire de tranches trop épaisses (jambon ramené du sud ouest donc à couper soit même), simplement délicieux', '2010-12-25T23:31:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62616, 5d44b785-a989-4ce8-92a3-e7c5352157fb, 'Très très bon ! Le mélange est vraiment harmonieux, pas écoeurant du tout, c''est super. Et on ne peut plus facile !! J''ai laissé entre 15 et 20 minutes au four pour que le jambon croustille comme il faut, et nous nous sommes régalés ! ', '2007-10-28T16:21:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24418, 2112f6ca-ef45-40fc-a465-7c77a9fd6a9d, 'Les bananes restent effectivement un peu trop fermes malgré le temps de cuisson assez long. Mais le goût est assez agréable. On peut peut-être se contenter de bananes classiques avec un temps de cuisson plus court.', '2016-01-22T21:16:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24418, cd96368d-35cb-43f9-8d59-59eb51bcd91b, 'Très bon !!! Je l''ai fait avec une seule banane (les bananes plantain coûtent cher en Métropole) !!! Et j''ai mis plus de sucre, 2 cuillères à soupe pour une banane. Temps de cuisson : 15 min.', '2013-04-07T18:46:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24418, 731dbba8-d453-4443-8cfe-527b0f67e4aa, 'Je trouve ça assez bon malgré un manque d''acidulé. Je vais de ce pas acheter deux citrons verts pour apporter une touche acide à ce dessert. De plus, le temps de cuisson était pour ma part plus court que celui indiqué d''au moins 10 min et mes bananes sont largement cuites, certaines commencent à faire de la bouillie. Ce n''est donc pas hyper présentable, mais pour une daube, je m''en doutais un peu. Et avec ce temps de cuisson raccourci, j''ai encore pas mal de sauce, elle n''a pas réduit suffisamment mais ça c''est pas vraiment un souci. Quant à la dose de sucre, mes cuillères n''étaient pas énormes, mais les bananes étant bien mûres, deux cuillères voire même un seule bien bombée auraient suffies.', '2006-09-19T18:16:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24418, 207d736a-fb31-4486-9056-6e31e0ecefde, 'Ecoeurant et immangeable! ça ne ressemble à rien, j''ai pourtant bien respecté la recette, j''ai augmenté le temps de cuisson car c''était cru ! Peut-être qu''il manque des explications à cette recette ? Quel gaspillage !!!', '2006-02-07T08:36:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24418, c35ee407-e9a7-4de9-a007-935737a1b8c4, 'Immangeable. Les bananes sont restées très farineuses, même en doublant le temps de cuisson...Elles étaient pourtant mûres. Je réesayerai avec des bananes classiques.', '2005-03-25T22:10:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61876, a9e5acbb-96bd-4deb-aabb-80e4d645e5a7, 'Bonne recette pour utiliser des oranges. A servir chaud avec une glace de boule vanille.', '2009-12-12T14:29:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229840, 31c4c40d-7ac3-47a7-a745-90065fdf9bd5, 'Très bonne recette que j’ai réussi du premier coup , j’ai aussi rajouté la crème liquide par cuillères en remuant bien entre chaque et utilisé 100g de sucre pour 6 portions. Pas de sucre rajouté au mascarpone. J’ai mis des speculoos au lieu des sablés , et c’était délicieux, pas trop sucré ! Merci je referai cette recette !', '2021-08-16T13:09:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229840, 8b74391e-a25b-4b0b-872e-a5908bcded93, 'C''était vraiment excellent, tout le monde s''est régalé ! J''ai juste raté la ganache au chocolat, qui s''est re-solidifiée et le beurre s''est séparé de la ganache qui était un peu dure et élastique comme un caramel.. bizarre, mais à part cet incident, que du bon.', '2016-10-28T00:06:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229840, 53d01776-9344-4a16-8d9a-be8f1d14701f, 'Recette parfaite mais j''ai dû refaire de la crème au mascarpone car je n''en avais pas assez. Sinon, pas de problème particulier pour faire le caramel à la banane et pourtant je n''ai jamais fait de caramel moi-même avant. Pas encore dégusté mais je pense que c''est excellent. Pour finir la déco de mes verrines, j''ai ajouté un peu de pralin. ', '2016-04-22T15:30:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229840, 28d655d5-3606-4eee-bbc3-abfb91c5b9a1, 'Excellent ! J''ai suivi la recette à 100% et rien à dire, à part que vous devez la tester.', '2016-01-01T22:50:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229840, 0f0e4959-56dd-48d5-92ce-17603a86b387, 'Parfait ! Comme la marque de mes petits pots qui ont donné un très beau rendu. J''ai juste acheté la confiture de lait (plus rapide) et mis le reste des biscuits émietté s sur le dessus (des palets bretons) à refaire !', '2015-10-11T14:26:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229840, 12c95b74-be50-4e40-891b-17ec4254a229, 'Un véritable succès ces petites verrines!  A tel point que tous les invités m''ont demandé la recette. Petite modification lors de la préparation du caramel car après deux tentatives ratées j''ai préféré remplacer le caramel par de la confiture de lait (j''ai triché je l''ai acheté toute prêt). J''ai également mélangé mes sablés mixés à une banane mixée. Merci encore pour cette recette !', '2015-06-20T01:12:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229840, a9b83022-ecb9-44e9-ada5-97ec2ae7afaa, 'Très bon, très léger et frais. J''ai retrouvé le goût du Banoffee que j''avais goûté en magasin, en mieux bien sûr puisque fait maison. Merci pour cette recette.', '2013-04-08T00:48:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229840, bc05dc23-c964-48e8-a980-d80a9566333b, 'Super facile à faire et délicieux !! Un régal 👌🏼', '2021-05-16T10:57:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229840, d642c7e6-9473-4d36-b987-1ef3bab3e46c, 'Absolument excellent !
Juste faire attention lors de l''ajout de la crème dans le caramel, je pense qu''il faut la tiédir et l''ajouter par petite quantité.
Et sucrer le moins possible la mascarpone car le reste est très sucré !
Recette parfaite pour un résultat délicieux !
Merci beaucoup ', '2020-12-16T22:57:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29755, 204c7062-e419-422e-a474-67a9fdcebe6b, 'Très bon et très simple à préparer. Dans la papillote, j''ai ajouté des raisins secs qui avaient macéré dans du rhum à l''orange. Le chocolat fondu remplace avantageusement la glace à la vanille.', '2005-01-21T14:34:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29755, 5cc30cef-ea51-4ac6-bed4-7dfc7d94d8ad, 'Un dessert très bon, facile et surtout très rapide, idéal en cas de dîner improvisé !', '2011-05-12T13:25:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29755, 6473f885-bf5a-4a87-a53b-f8a1c54c5063, 'J''ai trouvé cela sans intérêt. c''est un peu fade et lourd. Personne n''a terminé son dessert.', '2010-04-26T15:12:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29755, eff9d193-fe04-4c81-81af-26b16098544d, 'très bon ! on a rajouté des copeaux de chocolat pour rehausser le goût.', '2010-03-26T15:53:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29755, 92c77686-2945-4153-ba49-6862417a3248, 'Je trouve cette recette bonne mais elle n''est très sucré.', '2005-09-04T20:05:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29755, b8f6681c-7a6e-4612-bf8f-fa64ad2a5fe6, 'Très bon! Je l''ai fait au four, mais peut-être faut-t-il laisser sous le grill, car sinon les amandes et la préparation ne dorent pas...', '2005-01-29T14:31:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29755, 6ab8499a-fb5e-4a03-b80e-cf19cacb0c43, 'Délicieux, original, simple! Personellement, j''y ai ajouté du rhum, c''était extra! Je pense qu''avec des pommes et une touche de cannelle, ça ne devrait pas être mauvais non plus! J''essaierai la prochaine fois.', '2004-07-25T09:29:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29755, 0021f034-85db-4d66-84ee-6aef548927e2, 'Délicieux! Facile! Tout le monde m''a demandé la recette.', '2004-07-17T16:35:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29755, 4758e1d3-c1f3-4a86-90f7-44eb76d60986, 'Vraiment délicieux!!! Je n''avais pas d''amandes effilées, mais j''ai saupoudré les bananes de cannelle à la place, c''est super bon! Recette géniale et à refaire souvent, merci!', '2004-06-18T10:06:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, 1645e0ae-1dae-42e2-8c55-bdc268d91ee7, 'Très bon  j''ai juste rajouté un yaourt au lait de coco nature pour donner de l''onctuosité et casser l''acidité ', '2023-06-14T14:28:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, bc1c04f3-e673-4411-9f4d-7ec13ee7c799, 'Très bon mais ne pas mettre de citron (trop acide)', '2022-05-06T14:17:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, 30b66c31-5b44-40f1-977b-41a933bfa223, 'Facile, frais, délicieux ', '2020-04-20T15:52:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, edeed975-e95c-45bd-8abb-20b1d892ce9f, 'DÉlicieux et Rafraîchissant .?', '2020-04-10T15:20:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, f9b1268c-97f6-4669-8a50-bc011c6e0a47, 'Recette très sympa, goût excellent, mais préparation un peu trop épaisse. J''ai ajouté des glaçons et un peu d''eau en plus.', '2019-09-01T12:14:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, 3c72edbc-6b58-407b-88ba-d677a0c516cd, 'J''ai ajouté une poire et des glaçons. Excellent, merci pour la recette', '2019-06-27T18:06:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, 6efae185-6354-48f1-adc9-80ac16a9620d, 'J''ai doublé les quantités pour 2 personnes. Le jus de citron frais  apporte vraiment ! Un yaourt et 30 minutes au congélateur.  Excellent ! ', '2019-04-27T12:26:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, ca2d79aa-4bcb-46d0-936c-7affc6ae1d4b, 'Jai rajouté un yaourt et c''est top ! Bonne recette ', '2017-05-08T10:56:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, aa2aedeb-3e21-4508-852d-db00a0667494, 'Pas de fraise mais j''ai suivi la recette quand même très bon ! Pour donner un coup de frais, j''ai mis 10 petite minutes au congélateur ! ', '2017-03-23T21:00:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (337347, 83e7a77c-51e3-48d1-ae40-24fb0539f7d6, 'Juste excellent ! Un vrai régal ! ', '2016-05-26T10:52:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56753, 9a241a56-beaf-4c91-8f5b-9880d66b4de0, 'Très bon simple et facile à faire !!! J''ai juste remplacé les gâteaux en miettes par des spéculoos en poudre... A faire en 2 secondes', '2010-09-08T21:03:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61994, 110ba5dd-00c3-4f26-bd2b-9466e2d5d527, 'Superbe recette, effectuée sans noix de coco et ai ajouté quelques gouttes de viandox lors de la cuisson du porc. Pas de boîte de conserve, j''ai utilisé un demi ananas frais coupé en dés. Tout simplement génial, ma femme qui n''aime pas l''ananas, a mangé son assiette sans grimaces et m''a glissé un grand à refaire ! Un grand merci.', '2019-04-02T10:28:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61994, b8e0cbe2-8f69-4842-bf38-f66dc8215abe, 'Pas de noix de coco mais mis plus de curry. Fait avec un riz basmati. Délicieux ', '2017-05-02T14:10:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61994, 80f48cab-ca70-44a4-8d50-7efa142cbd78, 'Recette que j''adore que je refais facilement et régulièrement.', '2016-05-22T14:24:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61994, c4b3e65e-01e0-4f32-bbfd-9ecbb517fc40, '5/5 ! Et pourtant je suis difficile... Je n''avais pas de noix de coco mais même sans ce fut délicieux. Je l''ai accompagné de purée de pomme de terre maison, le tout se mariait ensemble à merveille.  J''ai mis à la place du curry que je n''aime pas, du 4 épices, et j''ai utilisé 2 cubes de Kub''or délayé dans 25 cl. Ce n''était pas fade du tout ! Je pense qu''ajouter de la sauce soja viendrait dénaturer le plat et surtout enlèverait le goût subtil de l''ananas. De plus c''est un sucré salé qui plairait sans doute aux non initiés car ce n''est pas un extrême du genre. Pari exotique relevé !', '2011-12-31T20:23:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61994, b7a0fb95-b9c6-45fd-814f-2b07727bf6df, 'Contrairement à ce que je pensais c''était fadasse, j''aurais du écouter le conseil de la sauce soja !', '2011-12-04T18:55:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61994, f5364caf-5f9a-41e5-b09a-4c8eb59c36b2, 'Le mélange porc, bananes et ananas est délicieux. J''ai rajouté de la sauce soja et un peu de piment pour relever le tout. A refaire pour son originalité! ', '2007-11-05T23:56:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15030, d93482a1-169b-448b-b030-8e077095006a, 'C''est simple mais rapide et délicieux pour le gouter des enfants. Par contre pour éviter la bouillie je mets juste 50 secondes.', '2012-09-28T18:58:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15030, 8d4b1de6-df54-4c9e-b9c3-f6427a110519, 'Un grand classique de nos desserts !', '2022-11-17T20:12:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15030, 7f164204-ca4b-466f-b2e4-fee331ac6286, 'C''est très bon. J''ai coupé une banane en dés, mis 1 cuillère et demi de Nutella et 1 min au micro ondes. Ca permet de garder les morceaux entiers. En plus c''est très facile. ', '2014-12-21T15:41:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15030, 234ee4ff-53fd-4c5e-b290-79a1af038d97, 'Super simple et rapide a faire. Et comme m''a dit mon fils de 6 ans : "hum ! c''est bon ce truc là !"', '2011-03-04T13:54:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15030, 86efd38a-f9e6-4dcf-a51f-1968c44f9ab9, 'Tout simple, mais tellement bon! Je cuis la banane nature 2 min au micro-ondes, puis j''ajoute 2 morceaux de chocolat noir sélection et éventuellement des éclats de noix, noisettes, cacahuètes... ', '2010-01-19T15:28:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15030, 075f7c04-1cce-4be9-baaa-56dacac1ec96, 'Ok, je savais que ce ne serait pas présentable, j''étais prévenue...mais pour le goût, je suis franchement déçue, c''est du niveau de la purée de bananes pour bébé... En fait, c''est juste une banane chaude...faut pas être trop exigeant pour en être fan !', '2007-11-18T16:16:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15030, bf1f11b7-64f4-4486-a0e5-68431155bdf2, 'Très facile et très bon, merci beaucoup pour cette idée !', '2007-10-14T23:37:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15030, d37626e2-e43c-4abf-a369-6755bd64c5a9, 'C''est super bon et pourtant si simple !! J''ai tout de même épluché ma banane avant de la mettre dans le micro ondes.', '2007-03-19T23:25:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15030, c823bb1c-213f-4a55-b074-72a991121c9a, 'Miam miam, un vrai régal et très simple à faire. J''en ai fait avec des morceaux, c''est plus fondant. Mais au cacao, c''est pas mal non plus.', '2007-02-12T21:35:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15030, 27c72ee0-5198-43e5-8541-8cd21aaf10de, 'C''est très bon, il ne faut que deux ingrédients et c''est très rapide. Même un enfant peut la faire.', '2006-03-03T17:56:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15030, d5f3d791-8e52-4c16-831a-459002ff0b06, 'J''ai mis trois petits carrés de chocolat can....l crisp le long de la fente de la banane... En effet, c''est peu présentable vu que la peau noircie, mais c''est tellement bon... Je dirais même excellent!', '2005-11-21T09:21:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56235, 2bb57e3c-2296-41e9-a128-3b32c422f2bd, 'Génial', '2016-06-11T18:20:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56235, 7c0f188b-225d-4c8c-9487-14832b53e578, 'C''est une très bonne recette , très agréable à boire entre ami, et très simple à faire', '2007-09-11T15:49:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (232040, d6d50340-2072-465b-8e05-83a9ded5b713, 'Très bon gâteau. J''ai utilisé les jaunes d''oeufs et mis 5 cuillères à soupe bolbées de nutella. Une vraie réussite !', '2021-01-06T17:44:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (232040, 2aff90ce-566e-4cfb-91cc-c1db9d64875b, 'J''ai suivis la recette mais n''ayant que 2-3 cuillères de nutella restantes, j''ai ajouté la moitié d''une tablette de chocolat. Nous nous sommes régalés!!', '2016-06-08T18:39:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (232040, 3dba85fa-198f-4131-b0b6-d9c7317c776e, 'Je n''ai pas osé le laisser fondant par crainte de le rater. Donc plus de temps de cuisson et ça a donné un merveilleux gâteau..', '2015-02-01T02:13:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (332555, f2e60117-1736-44e4-8faa-3cd2cb4a5ad8, 'J''adore !', '2017-04-30T20:20:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46443, ce1d873e-af79-4e8a-bfa0-e6dcf51721d8, 'Très bonne recette, mes invités se sont régalés !', '2015-10-11T20:23:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46443, d5e7be96-919d-4007-b12b-92ddb9c3d586, 'Gâteau mangé le jour même, très bon et très moelleux, à refaire', '2016-10-26T13:33:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46443, dac0ae4d-5ef2-44fc-95f9-c623593fe732, 'Que c''était bon ! Je n''avais que du rhum arrangé avec des feuilles d''orchidées de la réunion. Délicieux !!!!', '2015-03-23T21:55:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46443, 03112fe1-4d69-462e-9b89-06e711ba5653, 'Très bon gateau. J''ai légèrement modifié la recette en ajoutant de l''extrait de vanille de la réunion.De plus j''ai fait un caramel ou j''ai disposé les rondelles d''ananas ( très bel effet) Le gateau devrait être un peu plus moelleux', '2015-02-11T09:13:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46443, 0e0e040f-be95-482f-9691-45396a322be6, 'Excellent ! Mon mari en a repris 3 fois d''affilé lol, j''ai rien changé dans la recette, tout était parfait (cuisinière novice). ', '2014-12-22T11:39:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46443, 3214f7a5-880f-45cb-9a68-d7a92d7374dc, 'Je l''ai préparé la veille. Les bananes ont malheureusement un peu noirci. Mais le gâteau a été apprécié ! Je le referai.', '2010-09-26T22:59:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46443, 3a8b98a4-df04-443a-b154-cf4fb1cdd09e, 'Attention à ne pas faire la recette avec des ananas frais. En effet, contrairement à ceux en boîte, ces derniers contiennent des enzymes qui "coupent" les liaisons de l''oeuf... Le gâteau reste bon mais n''est vraiment pas facile à démouler ou à manger.', '2010-05-07T22:52:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46443, f8443696-e299-4e82-83e7-186c5bcdf679, 'J''ai divisé par 3 les ingrédients. Même en le dégustant seulement quelques heures plus tard (sans l''avoir entreposé au frigo), la banane noircit légèrement. Contrairement aux avis précédents, je trouve qu''il est moins bon le lendemain. J''ai servi avec un peu de crème anglaise et un peu de coulis de framboise. Pas mauvais, mais je ne le referai pas.', '2009-04-13T13:59:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46443, 72678f4a-2c8a-427d-8b3c-319315153b1a, 'J''ai personnellement mis 3, mais énormes, bananes à côté de la boîte d''ananas, 175 grammes de farine et quand on ne vit qu''à trois il en reste pour plusieurs jours, délicieux et économique. Accompagné d''une crème anglaise, c''est à tomber à la renverse.', '2007-04-10T13:35:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46443, dcd2e903-6597-4e43-9a06-3d04de53000a, 'Je l''ai fait la veille pour le lendemain, tout le monde m''en a fait compliment! Facile à faire et délicieux.', '2006-11-13T15:37:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46443, 9319d49c-5617-4147-b669-df6b4aa66e09, 'Délicieux! J''ai tout de même réduit certains ingrédients : un peu moins de beurre, seulement deux bananes et 1/2 boîte d''ananas (soit 5 tranches) et 70 g de raisins secs. J''en referai, c''est sûr !!', '2006-11-13T11:23:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46443, 8d24297f-748e-44c1-99e9-a1ee03e606db, 'Excellent! Je pense néanmoins que la quantité de beurre pourrait être diminuée d''au moins 1/4... A faire et à refaire tellement c''est bon (pour adultes uniquement, il a une "belle" dose de rhum).', '2006-07-29T13:03:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46443, fc2b69b7-fc06-48dc-89ec-edf591a47cdd, 'Trés bon, nous nous sommes régalés. Ca change des gâteaux aux yaourts, merci pour cette excellente recette.', '2006-05-16T20:26:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, daabe672-c0bd-4ac5-8181-9720208aeaf1, 'J’adore ! J’ajoute des cacahuètes pilées au dressage.', '2023-06-04T09:50:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, e434ab58-79d9-4d0f-8768-f91678d99a4b, 'Excellent ! Personnellement j''ajoute encore d''autres fruits (ananas, clémentine, pomme, poire...) environ 30 minutes avant la fin de la cuisson.', '2022-10-02T23:12:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, b48af3ba-7636-4263-8fd9-10c91bf5e7de, 'Moi pour le pili, je récupère l''huile de palme qui flotte pendant la caisson + oignon coupé + pili pommé dans une petite casserole. Laisser cuire doucement. Pour le saka-saka, j''ajoute du poisson seché ou du rouget surgelé et pour atténuer le gout fort du saka-saka j''ajoute de l''épinard.', '2018-09-26T17:14:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, ec1cd3a1-b2b9-4304-bc3b-7a7768249da3, 'Quand j''en trouve, j''utilise des bananes plantains. Et aussi de l''huile de palme.', '2011-07-31T11:14:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, 2b5be5bc-990e-4739-92cd-0318fad8757d, 'personnellement, je fais revenir le poulet dans de l''huile de palme. A part, je prépare un mélange d''oignons, de tomates et de beurre de cacahuète avec un petit peu d''eau et un cube de bouillon de volaille. Ce mélange est ensuite ajouté au poulet. Je présente le plat accompagné de riz, de noix de coco râpée, d''ananas et de cacahuètes.  ', '2009-05-12T12:48:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, 9f0293b2-b929-4e81-9f06-7ee672977be1, 'Excellent ce plat mais effectivement c''est de l''huile de palme et pas d''arachide... Sinon parfait. Moi j''ajoute aussi de temps en temps des morceaux frais de noix de coco en accompagnement. ', '2009-04-18T23:14:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, f68b57b8-663f-4c33-9984-414450002825, 'On peut ajouter des poivrons rouges', '2009-04-18T15:44:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, 9b210c6a-5210-4ca8-97cf-e500a5947350, 'Très bonne recette que je fais depuis toujours... petit conseil : la faire le jour avant! ', '2009-02-13T17:37:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, eefad573-42e9-41d4-897b-d8d377b6d2db, 'D''abord, moambé signifie le chiffre 8 ... Il faut dire : moambe ... Détail. Et puis, tant qu''à faire, il faudrait trouver de la vraie moambe ! On arrive à en trouver en boîte ... Et alors, pas d''huile d''arachide ! De l''huile de palme ! Il suffit de prendre l''huile qui remonte quand on chauffe la moambe. C''est de l''huile de palme. Pour le reste, ça va.', '2008-09-18T23:45:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, 8af02b74-4141-4f41-a154-673877b5a434, 'La moambé, une recette de famille, un vrai délice! Je procède de la même manière que la recette de base et à table, je présente des raviers avec des oignons fraîchement hachés ainsi que des arachides (cacahouètes grillées et salées)également hachées et des bananes cuites à la poêle (dans un peu de matière grasse) Recette absolument pas diététique et ainsi encore moins!', '2008-04-11T14:33:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, dcd1e4b9-0a50-4cbb-824b-a4cd4f2d12fe, 'Après 50 ans passés en RDCongo, c''est toujours de cette façon que je fais la moambe, mais je trouve qu''elle est encore meilleure avec une poule au lieu du poulet. Elle peut mijoter plus longtemps sans avoir du potopot dans la casserole! Pour le saka-saka ou sombé chez nous, j''y ajoute de la sauce de moambe et de l''ail.', '2007-12-30T09:10:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, 59f579af-1805-4f3d-849a-34f5162810ea, 'Pour le pili pili, en fonction des amateurs, un demi flacon de whisky, une trentaine de graines entières de pili pili séchées, laisser macérer (ça se garde des années), et servir goutte à goutte sur le plat des amateurs... Attention ne pas boire si c''est trop fort : mangez du pain et ne lécher pas la cuillère ! Perso, je suis la recette de base, et j''ajoute les bananes coupées en deux 20 min avant la fin de la cuisson (pommes également bienvenues). Pour le riz, pas de riz gras, mais 1 dose de riz et 2 d''eau, petite pincée de sel, et cuisson jusqu''à évaporation sans remuer (attention, vers la fin de la cuisson, bien remuer pour ne pas risquer d''accrocher le riz. ', '2007-11-08T18:17:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, f9dfb9cd-306c-43e0-9ff4-1ad8b26aafce, 'Pas light, en effet, mais un régal...Peut être préparé à l''avance (comme tout plat mijoté) donc, vous ne devrez pas rester aux fourneaux alors que vos invités se trouvent dans une autre pièce... ', '2007-09-29T12:14:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, 2da057c1-052c-472b-a31c-eeed7310ecf9, 'Pour les bananes, j''ai utilisé des bananes plantins trouvées à Matongue, le quartier africain de Bruxelles. J''y achète aussi la moambe surgelée, plutôt qu''une boîte.', '2007-08-26T23:25:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, 6804fa78-09ea-43a4-86f4-47b55834a086, 'Version congolaise : ajoutez à l''oignon 2 ou 3 tomates coupées en rondelles. Pour ce qui est du saka saka, y ajouter 2 louches de moambe, ce qui relèvera le goût. Et enfin, les bananes peuvent être coupées en rondelles et frites avec un peu de beurre.', '2007-01-26T22:50:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, bcbc4a6f-d46a-4171-8bae-cd36e7da8e84, 'Je mets moi aussi du pilchard dans mon saka-saka et j''y ajoute une bonne cuillère de beurre d''arachide, cela donne du moelleux au saka-saka, et bien sûr servir avec tous les fruits de là-bas en accompagnement, qui rafraîchiront la bouche après le pili-pili. Butamu!!!!', '2007-01-14T20:40:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, 3ed0108f-28bc-4fce-97b2-47faa3507acc, 'Ouais...c''est un vrai régal mais ne chipotez pas, seulement accompagné de bananes et éventuellement de mangues mais par pitié pas de poires! Et le saka-saka (aussi appelé sombè (en swaéli) avec l''huile de palme et de l''oignon et assaisonné sans plus...', '2007-01-09T18:32:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, 3a5d0edb-b52a-46fa-a9e5-1d9085cd09c2, 'Si je peux me permettre, dans la recette ''katangaise'', on utilise de l''huile de noix de palme (la moambe étant de la noix de palme pilée), dans laquelle on fait revenir le poulet avant d''ajouter la moambe.', '2007-01-05T21:57:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, d56f4473-0883-4343-b006-6ac216ddcaaa, 'Ce plat je l''adore (en hiver). J''y ajoute 2 bonnes cuillères à soupe de pâte d''arachide et 2 tomates fraîches. Je remplace le saka-saka par des épinards parsemés de cacahuètes hachées, le tout accompagnés de fruits frais (ananas, poires, bananes et mangues). Je prépare aussi une huile piquante la veille, en laissant macérer un piment dans de l''huile chaude. Un délice!!!', '2006-11-21T13:34:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, 6a518038-41a8-4ba2-9997-459ec6a4b2ca, 'Je suis parvenu à retrouver des goûts et parfums qui me rappelèrent d''heureux souvenirs zaïrois. Quant aux amis à qui j''ai fait découvrir ce plat, ils en redemandent déjà...', '2006-03-21T23:34:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, 72b1e45b-052a-42f7-af25-613ab7e461b8, 'Trop bon! A refaire sans hésitation! Recette suivie à la lettre, car c''était une première + le conseil de pierre pour le saka-saka.', '2006-01-17T14:45:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, b921d11c-aa1b-43e3-b4f0-9dc72f744622, 'Pour le saka saka (pundu à kin ;o) ): ajoutez une courgette coupée en petits dés, une boîte de pilchards sauce tomate et de l''huile de palme en plus de l''oignon et laissez mijoter très longtemps (je rajoute 1/2 boite d''eau et je laisse evaporer doucement) le saka saka sera beaucoup moins amer (il faut assez bien d''huile de palme)', '2005-04-14T12:25:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, cfadde10-2499-4339-96a1-26cdf7c1debb, 'La moambe n''est prête que lorsque la chair se détache aisément et complètement des os.', '2004-06-05T13:48:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, f1c45ce8-37e6-4a59-b000-db02d61904f8, 'Nous rajoutons, pour la grande joie de tous, d''autres fruits: ananas, pêches, kiwis, noix de coco, mangues (comme dans le Kasaï). Je remplace souvent le saka par des épinards assaisonnés avec un peu d''huile de palm et de pili... (mais ça, c''est purement personnel).', '2004-04-24T11:31:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, 4f9d5c16-8838-4b6e-8e67-92dfd812ab44, 'Pour le saka saka, j''ajoute de l''ail et un peu de crème. Je n''utilise pas d''huile d''arachide, mais de l''huile de palme.  Je la trouve en grande surface et a l''aspect de graisse très orangée. Elle donne au plat un parfum très particulier.', '2003-11-16T16:33:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, addb3357-0f99-4f26-aced-efc16f0cf994, 'Délicieux et plein de souvenirs de coopération au Congo... Nous préférons un riz blanc, plus léger que le pilaf et nous ajoutons au saka-saka (ou mpondou en lingala) des arachides pilées fin: cela relève un peu la fadeur du manioc. C''est comme là-bas, dis...', '2002-09-29T20:49:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, 9b892348-eff1-45c6-93d5-8c68dc608296, 'La recette donnée correspond à celle que nous pratiquions en Afrique en utilisant simplement des palmes fraîches. Nous complétions simplement par une sauce piquante préparée avec quelques cuillers de sauce mélangées à quelques grains de pili pili écrasés. Attention: quelques gouttes dans le riz suffisent, mais cela délie les langues!', '2002-01-01T16:21:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, 017cbbc6-ce2c-4406-b6f8-5584af1d5773, 'Comme je n''aime pas le piment, je mets du poivre à la place dans la sauce. Mais dans mon manioc, pas de piment! Certains mangent du piment parfois ...par défi! :-)', '2001-11-03T18:24:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, 3c50cbfa-e36c-4b4d-9591-31b6a72fea81, 'Suggestion : personnellement, j''ajoute une pointe d''ail au saka-saka, comme on le fait parfois pour les épinards.', '2001-06-10T19:18:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11099, d165586d-aa5c-42b4-b411-896361b2bf1e, 'Je fais cette recette regulierement. Avec l''huile recupérée a la surface, je prépare une sauce assez relevée à base d''harissa et de pili-pili et j''accompagne ce plat de cacahouètes.', '2001-04-18T17:25:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56124, 9d71f237-60e9-4f29-b972-f45e92fb77c5, 'j''ai rajouté une banane, un kiwi et mis plus de chocolat, très bon résultat! cuisson 50 min, merci pour cette recette qui change', '2021-04-03T14:12:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56124, 1b18fe82-67aa-4133-9b6b-ad92e5c9d3d0, 'Je l''ai fait pour l''anniversaire de mon fils. J''ai rajouté muscade et vanille pour relever le goût par rapport au commentaire précédent.  Personnellement j''aime beaucoup, je ne sais pas si c''est léger, mais c''est bon!!', '2009-02-06T02:20:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56124, f4b74fae-a131-4e5c-9d80-d4bf38b4b452, 'J''ai été déçue, j''ai trouvé ce gâteau fade, j''ai suivie la recette à la lettre du moins je le pense car les explications sont succinctes.', '2008-05-21T13:24:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68951, 94958821-6ca9-4ce0-9339-a97b9d62842e, 'Excellent !', '2022-11-16T15:27:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68951, 387e2ac7-fea2-4ec5-8d4f-751113d76fac, 'Simple et ultra facile à faire ? ??', '2021-02-15T19:58:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68951, f9f9357c-cb95-48ec-a245-e151a5ee2ee0, 'J''adore... recette faite plusieurs fois... un régal.', '2019-10-09T07:04:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68951, b48f84c8-c179-42eb-aa83-9f9505e64396, 'Trop bon ! A refaire', '2017-06-13T15:55:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68951, b6202cb2-fc78-475b-a9ed-701e30272e62, 'Elle est trop trop trop bonne !', '2016-12-01T17:17:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68951, b48ef5ac-0d8f-4c94-9afd-84e7536003d4, 'Hummm Miam Miam !! (rien à dire de plus) !!', '2016-05-22T12:04:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68951, cb92cead-720b-4613-bc25-a6c65495ce3a, 'Très bon dessert. J''ai peut-être versé le chocolat un peu vite sur les bananes, du coup, au milieu, il n''y avait presque que du chocolat. La prochaine fois, j''en mettrais surement un peu moins et il sera mieux réparti. Vraiment c''est une excellente tarte... tout le monde en reprend! ', '2010-03-06T09:40:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68951, 3cd9f772-617f-4def-bab9-9f9321109936, 'Vraiment très bon, a remporté un franc succès. C''est idéal pour passer des bananes un peu trop mûres. Je n''ai pas hésité à mettre beaucoup de cannelle sur les bananes, ça donne vraiment un très bon parfum. Je n''ai mis que 80 g de beurre et c''était parfait.', '2010-02-10T00:03:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68951, 6e249faf-428d-4a5a-92b8-61051eb77cc3, 'Première tarte que je fais... et grâce à cette recette, je dois dire qu''elle n''est pas mauvaise, et même bonne (et vraiment facile à faire, même pour une débutante comme moi). ', '2009-03-03T18:31:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68951, 896fdf47-9106-45fa-84a9-3015687be38f, 'Les amateurs de chocolat noir adoreront! Elle est très bonne. Mais la prochaine fois, je mettrai des amandes effilées dessus pour rendre la tarte plus croustillante.', '2008-07-05T20:23:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68951, 13cf8ed9-56ab-4862-9b9a-364b0354ec02, 'Délicieuse...bonne proportion, rien à changer. Merci !', '2008-04-06T12:13:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55479, 5b008bf3-0ff9-41ac-903c-60bf8447d647, 'Moyen, j''ai ajouté des lardons pour avoir un peu de viande...', '2011-10-08T19:31:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55479, eabb1b79-57b2-4e03-9abd-1d1766507c1f, 'Vraiment sans intérêt... Ça n''est pas dégoutant mais c''est fade, et la consistance laisse vraiment à désirer, je ferai plutôt des pancakes avec mes prochaines bananes trop mûres !', '2011-09-20T11:19:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55479, 266bc7e1-533d-4dd5-868b-16feebc5ca96, 'La banane se marie bien avec les pâtes. Par contre, je conseille d''écraser les bananes avec un robot, puis d''ajouter la crème. De plus, j''ai ajouté des pignons de pains pour donner du croquant. ', '2009-12-13T14:00:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169798, e7c87856-1fbb-4989-86f2-8fdaf657fe3f, 'Bon aussi sans banane et au lieu de l''huile du beurre !', '2011-09-24T19:32:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169798, 7ae0668a-caa3-44a7-882c-10c4ce5dba1d, 'Recette suivie à la lettre. Délicieux, mais finalement on sent plus le goût de la banane que celui de la rhubarbe.', '2011-06-04T17:37:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169798, fef7f26c-b343-4828-ac5c-1958746cd268, 'Toute la famille a adoré ce dessert.', '2022-05-27T21:59:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169798, 34c85dbb-1b6b-4587-8f94-fd3dd424d85d, 'Je viens de faire la recette, en utilisant des moules à mini-muffins et en adaptant le cuisson en conséquent. J''ai aussi eu peur que ça fasse trop de rhubarbe et n''en ai mis que deux bâtons. A refaire, en tout cas, merci !', '2011-05-03T00:18:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27384, 10c21e53-fe3a-45e3-b353-7aa4f994bb8d, 'Eh bien ça nous a rappeler la Thaïlande.
C''est vraiment très bon et simple â faire.
N''hésitez surtout pas â démarrer la cuisson des bananes en même temps que le riz, â feu très doux.', '2020-10-18T15:39:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27384, fcfd28f2-7113-471f-8b6b-6a380131bd63, 'Mon mari etait très réticent sur le mélange banane-lard mais au final, il a adoré! Les enfants en ont mangé jusqu''a la dernière miette!Merci.', '2009-08-30T22:11:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27384, e302b5d0-7283-4697-a8ef-b62b7a8b6ee5, 'J''ai refait cette recette et c''était un délice! La première fois, j''avais eu peur de mettre trop de moutarde, mais finalement, il ne faut pas hésiter, c''est ce qui donne ''du coffre'' à cette recette.', '2005-02-04T21:11:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27384, 516714b4-6dae-4fbe-b695-32055063aa38, 'Super bon ! J''ai juste préféré mettre un oignon rouge.', '2004-11-21T16:52:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 18bf2e3a-5c42-48ae-a55b-9bc8dc359ecd, 'Beaucoup trop pour 1 personne, il faut mettre moins de lait ', '2020-05-31T17:51:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, e9cff37d-60d0-40f8-a7e7-cf24898f259f, 'Lait banane glaçon ni plus ni moins. Proportions selon les besoins et c''est moins calorique qu''avec de la glace !', '2016-10-10T20:44:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, e9b1f940-f677-46ab-b1a8-359224590549, 'Excellent, je mets un demi-verre de lait par personne.', '2022-09-08T21:27:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 34c20216-9ee0-4faa-a477-c1184958fa43, 'Je confirme il faut mettre beaucoup moins de lait', '2021-06-18T16:35:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, b91e9ddc-adb5-42aa-91c9-cfc923968a7d, 'Plutôt bon on sent bien le goût de la banane. Je n’avais pas de glace à la vanille alors j’ai mis de la glace à la framboise. ', '2020-05-26T20:01:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 13c9e8af-decd-48f2-a944-07b58c1eb100, 'Très bien ! J''ai suivi la recette et j''ai remplacé la vanille par de la fraise, c''était excellent et crémeux.', '2018-02-09T08:17:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 25d4da83-a89a-485d-8ad1-c5c1a754f7b7, 'Excellent 👍👍', '2022-09-11T16:30:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, d7953635-9212-426f-9086-466a227995dc, 'Très bon. Un dessert simple et rapide à faire au quotidien.', '2022-03-17T17:44:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 0cafa62e-4198-45aa-bb3e-e44258dfc870, 'Excellente recette, de bon matin cela nous tiens en forme pour toute la journée.', '2017-01-04T11:28:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, e230e001-c715-4601-a28e-51be69627358, 'Très bon mais j''ai mis moitié moins de lait et en faisant la quantité pour 3 j''avais assez pour 4 personnes.', '2016-07-27T14:04:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 6e36684f-9b20-4462-9b89-a4b8f37a469e, 'Délicieux classique ! Je n''y ai mis qu''un demi verre de lait. ', '2016-04-14T00:10:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, dc8dc910-f63e-4f50-8c27-9457885a4454, 'Excellent ! Bonne proportion. Un régal.', '2015-09-09T18:45:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 926d8393-83cf-4420-bf1a-00cb72874fb0, 'Très bonne recette, bon je n''avais pas de glace à la vanille, mais c''était très bon. Par contre j''ai mis moins de lait et j''ai adoré !', '2014-10-19T20:39:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, bc54e982-8734-4fa6-b9e0-623add1d7065, 'Délicieux, j''ai juste mis un peu moins de lait et un peu plus de glace par gourmandise !', '2014-05-17T22:30:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 6786a576-e1e9-420b-b5db-e8b41d83c8a1, 'C''est bon mais très liquide. J''ai préparé pour 2 personnes avec 3 bananes et 3 grosses boules de glace. La prochaine fois je mettrai moins de lait pour avoir plus le goût de la banane et plus de consistance.', '2014-05-08T20:51:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 60531e94-9dfd-474f-8ea7-7f2b74d6c51b, 'Trop trop bon avec des bananes bien bien mûres pas eu besoin de sucre après avoir goûter un verre !!', '2013-10-05T23:19:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 3106806e-78fe-439d-91c1-3dc36f1034a5, 'Excellent et très simple ! Perso, je rajoute 1 sachet de sucre vanillé pour une quantité ajustée à 3 bananes et je trouve ça top. Le fait de laisser le mixeur faire son travail pendant une bonne minute permet de créer la petite mousse sur le dessus !', '2013-02-22T22:00:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 52e94d4b-0d31-4f5a-bf30-b4653a8cf84a, 'Très bon, très frais ! J''ai ajouté du sucre en poudre car pas assez sucré à mon goût !', '2012-04-23T23:31:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 8038ca7d-b4eb-4c82-ae9e-ae8c2fdc976d, 'Certes, bon et facile... mais ce n''est pas trop ça pour ma part', '2012-04-02T21:03:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, e8253888-b574-4492-8943-c036085013e8, 'Excellent tout simplement !', '2012-03-11T17:37:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 73851e55-03c0-44a7-802f-c6936a3539a5, 'Bien, manque de goût', '2012-01-08T17:46:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, f74929d9-f848-413a-8240-0ce90bbe6dab, 'Excellent, tout simplement, et assez sucré à notre goût.', '2011-08-02T17:45:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 609f5edf-428b-466d-ab7d-c7a42d4c2bb0, 'Très bonne recette, très rapide : parfait !', '2011-06-20T11:58:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 42d886ef-0f68-4e8d-9648-ffb7de9eb5a6, 'Très simple et très bon. Suffisant pour 2 verres.', '2010-12-17T18:55:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 027e401f-d13c-477d-b15a-c00a04929204, 'Fait avec du lait 1/2 écrémé sortant du frigo, et de la glace vanille / noix de pécan d''une grande marque que je ne citerai pas... ;-) Excellent ! ', '2010-09-29T16:44:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, ba287b9d-2606-441c-b095-5e6f04d5782b, 'Respecter le dosage préconisé pour pas que ça devienne un milk-shake vanille à la banane ! Pour ma part j''ajoute 1/2 sachet de sucre vanillé. Mieux vaut prendre du lait bien frais du frigo. Des bananes bien mûres donnent un meilleur goût.', '2010-09-27T23:52:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, a01942f5-a571-4ceb-b70c-ae65999744be, 'Pour ma part j''ai ajouté 3 morceaux de sucre car ce n''était pas assez sucré ! Très bon mais pas assez frais !', '2010-07-29T16:46:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, af77aa5a-87b9-4dad-b9bb-3a394f65f563, 'Très bon, mais moi j''ai mis moité moins de lait et une boule de glace de plus ....', '2010-06-28T19:29:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 4e3de2cc-c079-4253-aaeb-21b2717b78ad, 'Je n''avais pas de glace à la vanille, je l''ai donc remplacée par de la glace à la noix de coco, c''est délicieux ! ', '2010-06-26T16:01:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 5b6cff84-57af-4f01-bc22-984a1702ff3a, 'J''ai tout suivi à la lettre : c''est vraiment délicieux ! Pas besoin de rajouter de sucre à mon avis... Merci pour cette recette  !', '2010-05-17T11:50:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 96e0087f-62ad-475b-a0ac-a890e70ae044, 'L hiver quand il n y a plus de glace au congélateur je mets une spécialité laitière a la vanille et supprime le lait + 5 à 6 glaçons dans le blinder. ', '2010-03-01T12:35:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, ee809635-9587-40db-be4b-211362f9f115, 'Très bon ! Merci !', '2009-08-11T01:33:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 09c6071e-f025-45c4-b438-ffce9debabc1, 'Très bon, j''ai suivi les conseils d''une internaute, j''ai mis les bananes au congélateur (comme ça elles étaient coupées à l''avance) et au dernier moment j''ai tout mixé sans ajouter de sucre et c''était très bon. Il en restait que j''ai mangé le lendemain et toujours aussi bon', '2009-08-04T01:39:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 3f82558e-8f82-4707-9201-36c4c79c3177, 'Je partage l''avis d''un autre personne, il faut plus de glace à mon gout.', '2009-02-01T18:47:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 7dfbeb96-79d6-4e06-855e-e12ab691da41, 'A rajouter un peu de sucre vanillé, c''est encore meilleur avec!', '2009-01-12T15:10:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, d2c8cb64-e47d-4c5e-a7bc-e4ac60524c71, 'Cette recette prête en 5 minutes est tout simplement divine pour le goûter. Je rajoute 1 cuillère à café de miel. Le parfum de la banane est vraiment sublimé par ce mélange mousseux!', '2008-08-07T16:47:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, c0afcacb-f7ad-4f07-8219-bbebfe0bb0d1, 'Excellentissime! A mixer au dernier moment pour garder le côté frappé. A faire avec des bananes très mûres et pas besoin de rajouter de sucre... Merci!', '2008-05-26T00:54:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, e9570f0a-357a-4775-bcb6-3641e5857ffb, 'Petit conseil : il faut congeler vos bananes. ', '2008-04-21T02:32:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, bc9f49c1-700f-41e4-81fe-67af5ffea798, 'Hypra simple et délicieux.', '2008-01-26T18:04:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, a7d4905e-8989-40f3-aca9-a2cccde37719, 'Remplacer la boule de glace vanille par de la glace fraise-melba. Excellent.', '2008-01-13T18:45:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 470f4262-7085-473b-a4fa-bd82c4d6ee3d, 'Très simple, excellent! J''ai mixé avec quelques glaçons, pour que le mélange soit très frais.', '2007-08-15T00:23:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 168dbb27-e6d7-4c1c-9f8c-fb0738a32d88, 'J''ai suivi scrupuleusement la recette : délicieux !', '2007-02-17T20:55:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 50be2369-6bdb-4748-96e1-af4dbfc5d9e1, 'Quel régal! J''ai remplacé la glace par quelques gouttes d''extrait de vanille (ça parfume et c''est plus light) et j''ai ajouté 3 glaçons. Résultat: milk-shake au top (goût extra et consistance idéale), mon mari a adoré, je crois que je vais devoir en refaire très souvent...', '2006-09-25T17:35:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 2b266fe5-c44f-44ae-a8be-30909acd3aef, 'C''est pas mal du tout. Il faut selon moi rajouter un peu de glace.', '2005-10-08T20:09:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 23984c00-aefc-4420-a308-3cefd4c5df42, 'Ma version personnelle comporte un peu de sucre vanillé et de l''oeuf (1 pour 2 bananes) et pour un effet top je bats le blanc en neige et l''incorpore ensuite au mélange, miam, c''est top! Pour ceux qui font attention à leur ligne, la glace vanille est supprimable et on obtient quelque chose de nourrissant qui remplit bien et sans trop de calories.', '2004-05-08T03:21:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, 35e956e5-d24d-4d55-b037-8c922d07d1d2, 'Génial!', '2002-08-31T17:43:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13498, bd1fa48b-89bc-4902-b978-e0476893c04a, 'Succulent, mais je rajoute 1 cuillère à café de sucre.', '2002-06-25T12:29:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, e74eb216-f589-45f8-8768-d0cf278a9e31, 'J''ai tenté cette bûche car l''alliance choco banane me paraissait très attractive ; je fais donc la mousse au chocolat la veille pour le lendemain midi ; le jour J, je monte ma bûche dans un moule à cake car pas de moule à charlotte et je me dis "mais comment tout ça va bien pouvoir tenir ???" (j''avais des boudoirs mous qui se tenaient comme ils pouvaient); ça me paraissait illusoire, à ce moment là, d''aboutir à un résultat correct ; je me rends compte que je n''ai pas assez de mousse au chocolat pour aller jusqu''en haut, je coupe donc les booudoirs à hauteur de ma dernière couche et tout ça au frigo. A ce moment là, je réalise que j''ai complètement oublié de tremper mes biscuits dans du nectar de banane, comme je l''avais prévu ! Je suis défaite mais ne croyant pas trop au résultat, je fais avec. Au final, mes invités ayant amené eux-mêmes des bûches, nous l''avons goûté très tardivement et là, surprise : un démoulage nickel et un goût fantastique ! Je craignais la mousse au chocolat sans', '2014-12-26T10:16:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, 3cc18e18-870a-4208-8d71-241aa2a4d9e0, 'Cela fait 3 Noëls que je fais cette recette. Toujours un succès mais parce que je remplace la banane par de la poire ! Et que je trempe les biscuits dans du nectar de poire. C''est une tuerie.', '2020-12-23T19:16:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, 10116215-7002-41a0-8a2f-067ef50172a2, 'Très très bonne bûche mais je vous conseillerais de faire la mousse de chocolat 2 fois.', '2014-12-30T17:01:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, 0fe45de7-48b1-4daf-ad98-63743e3aa50e, 'Super simple alors que j''appréhendais un peu... J''ai choisi en forme buche dans un moule à cake, en mettant les boudoirs côté fariné vers l''extérieur, et en trempant à peine le côté intérieur dans le café... Pas besoin pour moi de doubler la quantité de mousse (j''en avais trop en doublant)... Léger et très bon!', '2008-12-21T12:06:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, e232216e-fe30-4c39-a7e8-fb9d81f34826, 'A refaire ! Ma famille a adoré ! j''ai mis 200 g de chocolat et 6 oeufs pour plus de mousse au chocolat, et pour que ça aille plus vite, un petit tour au congélateur, c''était exquis !', '2007-10-21T16:06:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, 1bb28777-908e-4b04-bbdc-8885e554f8f8, 'Fantastique! Mari et enfants se sont régalés, quant à moi... mmmmmmh Parce que c''est jour de fête j''ai rajouté de l''amaretto dans le café ! Dans le moule à cake cela nous fait une bûche mémorable !!', '2006-12-26T00:15:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, 19ff0537-9c84-4a2c-a64d-abd1486b06e5, 'J''ai fait cette recette pour Noël et je l''ai trouvé un peu sèche.. . Peut être parce que je n''ai pas fait la sauce ?', '2021-01-24T09:48:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, 0a83d78d-ff5b-490c-a569-bd9104676baa, 'Très bonne bûche ! J''ai utilisé 200 g de chocolat au lait pour la mousse et 4 œufs. J''ai aussi imbibé les biscuits de jus de banane. Tout le monde s''est régalé !', '2014-12-29T02:21:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, 1797dccd-9814-4cef-a296-277629d61cca, 'Ma première tentative était un peu ratée, tout s''est écroulé! Pour ma deuxième tentative, j''ai suivi la recette sauf que j''ai directement monté ma buche.  Je n''ai pas laissé la mousse prendre au frigo et c''était parfait. Je n''ai pas mis le glacage et j''ai imbibé les biscuits avec du nectar de banane, c''était délicieux!!! ', '2013-01-01T18:04:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, 939818d3-fdeb-46ec-8536-40367c8c1885, 'Délicieuse bûche !', '2012-04-07T14:02:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, 3884dbc6-1274-4093-a3fb-f3211580237c, 'Cette recette est excellente, simple à faire, rapide... Rien de plus à ajouter Je la garde dans mes recettes préférées bien sûr.', '2011-12-27T15:50:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, f45cd4c9-a93c-4968-b0b8-fab1eb1d2f90, 'Recette réalisée pour Noël, bûche très légère et vraiment délicieuse, parfaite pour conclure un repas, elle a cartonné ! N''aimant pas le café, j''ai suivi les commentaires et j''ai mis du jus de banane à la place, ça allait vraiment très bien. Merci pour cette recette !', '2010-12-29T13:33:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, a4c65947-fa38-4f9f-8ac1-19d5043a7f44, 'Très bonne bûche, c''est la préférée de mon fils Hervé. Le chocolat et la banane font un merveilleux mélange. Je prévois un peu plus de biscuits. Excellent!', '2008-01-17T19:57:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, 9afc710a-bc75-4e13-85fb-1219becfaf88, 'Très bon. Je l''ai faite dans un moule à cake pour avoir la forme bûche, pour la servir à Noël. Par contre, je l''ai servie sans sauce, je la trouvais déjà assez riche!!', '2007-01-04T18:28:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, baccae28-8cdc-418b-b036-c14b6949e456, 'J''ai dû louper quelquechose. La bûche n''avait pas de consistance, les biscuits étaient trop mous. Je ferai une nouvelle tentative puisque d''autres cuisto ont réussi!', '2007-01-03T12:55:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, d964bef4-4440-4a1a-aa1d-c2c0bc512660, 'Je l''ai fait pour Noël dans un moule à cake pour la forme de la bûche. Un régal. Mais j''ai dû doubler la dose de mousse au chocolat pour remplir mon moule, du coup je n''ai pas fait la sauce au chocolat chaud de peur que cela soit trop écoeurant. Tout le monde a adoré.', '2006-12-28T10:29:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, 3eecddbc-0aef-4273-8137-8bb5d290e110, 'Délicieuse cette bûche!! Tout le monde a apprécié et quelle satisfaction de faire le dessert de Noël soi-même!!', '2006-12-26T15:04:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, 6caec5f5-93cb-4231-9661-070b5d04d4a4, 'Je n''ai jamais voté pour une recette, mais là, ça vaut le coup! Vraiment délicieux et pour une autre version, trempez les biscuits dans du jus de banane, les invités ne sauront plus laquelle choisir, vraiment excellent!', '2006-12-26T09:19:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, 1ed51ab2-b7cc-4065-b6b6-4b9c334484ec, 'Bûche ou charlotte, quelle importance? De toute façon, c''est un régal!', '2006-04-01T18:40:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, 5b458cff-abcf-4aa0-b1d3-7b5979116539, 'J''ai fait cette recette pour Noël et tout le monde a adoré. C''est vrai que ça fait plus Charlotte que bûche à priori mais faite dans un moule à cake et nappée de la sauce chocolat on y croirait ! Une précision: pour ceux qui n''aiment pas le goût du café diluez-le beaucoup...', '2005-12-29T14:07:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36286, 3adc7ad9-2ceb-4450-bbdf-9be21f9c59dd, 'Super recette, mais c''est plus une charlotte qu''une bûche de Noël...', '2005-11-16T11:36:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71909, 9ea12aa2-4d12-4778-b0dd-bd8c77bd8406, 'Merci pour cette recette qui change, plutôt fidèle et que j''ai un peu complétée. Le sancocho de gallina est une "poule au pot" colombienne au bouillon jaune, qui se fait à la cocote minute parce que les poules de là bas sont coriaces : on ajoute successivement les ingrédients du plus dur au début, au plus fragile à la fin. Si on ne veut pas que le bouillon soit trouble, il faut faire cuire les pommes de terre à part dans l''eau salée mélangée avec du colorant alimentaire (spigol curcuma), avant de les remettre dans le plat. Il n''y a pas de tomates, ni de cumin ou de fines herbes, y ajouter 2/3 carottes et des épis de mais frais coupés en tronçons. On sert avec de l''avocat frais coupé, du riz et un aji verde (piments verts égrainés déveinés, cébettes ou oignons tendres sans les fanes , coriandre fraîche , jus de citron vert, le tout ciselé très très finement et un peu d''eau et du sel). ', '2014-06-22T00:56:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71909, 1d11d3a3-dffd-4c01-863e-7684776486c9, 'Manque un peu de finesse...', '2011-08-25T04:34:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 675d9d5a-b6ea-4e48-9ea1-1fbbdc1f7815, 'Un vrai bonheur ce gâteau ! Par contre, je mets une dose de sucre blanc + une dose de sucre blanc et sachet de sucre vanillé et 2 bananes 🍌 car j’utilise un yaourt au sucre de canne. Les autres ingrédients sont bien quantifiés, c’est pas trop sucré. Je recommande ! Dans un moule spécial Noël (genre sapin), c’est top pour la fin d’année !', '2022-12-20T17:02:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 1f5598a0-4928-4784-ba5e-d109194ea45e, 'Délicieux!', '2021-03-27T15:07:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, e368ea97-0f1e-49db-b810-0c56cddfb17c, 'J''ai suivi les conseils, j''ai donc mis moins de sucre, moins d''épices et 1 banane de plus.  C''est un bon gâteau mais un peu compact. À refaire avec une touche de rhum la prochaine fois !', '2019-11-30T08:15:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, a4948594-9e5e-47e4-9f6a-9b9da0ddc608, 'J''adore cette recette ! Pour les épices j''utilise un mélange tchaï et un peu de cannelle et une goûte de rhum. Je préfère le faire cuire dans des moules à muffins ça rend super bien, plus moelleux !!', '2019-03-03T12:48:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, f352bd73-1ca9-4508-bef1-14e6caef408d, 'Très bon tres moelleux surtout encore tiéde.', '2018-03-08T10:01:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, f8f07520-57e5-4d88-abb7-5dda7bc753a5, 'J''ai mis deux bananes. Excellent ! Bien goutu.', '2017-03-21T14:39:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, ad98ed94-563b-4fd4-9f9f-4d871941085e, 'Excellent gâteau, merci pour la recette. Fait avec un  yaourt noix de coco, des épices à pain d''épices (2 cuillères à café), un peu de gingembre frais râpé, pour cause d''ingrédients manquant. J''ai mixé la banane et le tout, ce qui doit changer la texture de ce gâteau (un peu pâteux) mais j''aime beaucoup ! Je retenterai avec des morceaux de chocolat concassés. ', '2017-01-07T18:13:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 64873d5d-7965-4ad6-bf71-af1c4511ddaf, 'Une vraie tuerie.  Je le referai ;-) ', '2013-11-20T19:46:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 3198eaf1-b7ee-4e8b-95b9-3c46b51d392d, 'Pas mal du tout, je n''ai mis qu''un pot de sucre (amplement suffisant), j''ai écrasé la banane au presse purée et monté les blancs d’œuf en neige. La cannelle et la banane se marient bien sans que l''un ne camoufle l''autre. Bon gâteau de petit dej''. ', '2013-11-10T15:47:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 115be0cb-e442-4461-95f8-ea462964bb6b, 'J''ai trouvé cela beaucoup trop sucré !!! Je n''ai pourtant mis que 2 pots de sucre. 1 ou maxi 1 et demi serait peut-être mieux. la banane amène déjà du sucre. Le reste est parfait.', '2011-05-16T15:26:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, fbcc5b01-d6bf-4a98-bd8d-67bc114917d2, 'Très bonne recette. Par contre, je n''avais pas d''épices, alors j''ai mis de la vanille à la place, j''ai ajouté du rhum, mis un pot de maïzena au lieu d''un pot de farine et j''ai écrasé 3 bananes pour que le gâteau ait bien le goût de banane ! Le tout dans un moule à cake et il me restait un peu de pâte alors j''en ai fait des mini-cakes avec des pépites de chocolat en plus ! Huum un vrai régal !', '2011-04-03T13:27:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, aa444e34-14b8-48e9-8683-d65d93b701d4, 'Délicieux ! J''ai réduit les quantités d''épices comme conseillé et doublé la quantité de bananes (ne pas hésiter à tripler si les bananes sont petites). Pour éviter que les bananes ne coulent au fond du gâteau pendant la cuisson, il suffit de les fariner après les avoir coupées en morceaux. :-)', '2011-01-04T10:57:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 85900676-f1a3-4324-af28-aa5e464ddc82, 'Très bon gâteau, très simple à faire, la banane est mon fruit préféré donc j''ai adoré mais pour une personne qui aime ce fruit juste comme ça, cela peut-être un peu écoeurant.', '2010-09-23T18:44:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 6024a1df-c36f-45d3-b12e-5b1c742b8374, 'J''ai adoré la texture de ce gâteau (j''ai remplacé un pot de farine par de la maïzena). Les bananes étaient tombées mais on peut pas tout avoir. J''ai fait ce gâteau avec ma nièce de 4 ans pour le gouter avec tout ses cousins et... verdict : bah j''aime pas la cannelle ! Pfff, les enfants ! Tant pis y''en avait plus pour les grands !', '2010-04-12T00:49:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, cf50b698-2442-45bd-abed-bf973366a525, 'Très très bon ! Par contre, je laisse toujours les bananes en morceaux, au lieu de les réduire en purée... et il m''arrive d''ajouter des clémentines ou de la pomme... Miam ! ', '2009-12-23T20:09:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 514db68c-e442-43b8-82a2-49eae9e113cc, 'Nous avons aimé. J''ai mis 3 bananes bien mures et les épices. Et la prochaine fois je mettrai aussi un peu de rhum.....', '2009-04-06T19:15:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 0983c646-fd29-44a8-bece-de1df630f1a2, 'Vraiment super! j''en ai fait plusieurs fois, au goûter ou au petit déj, un vrai bonheur !! je n''avais pas de 4 épices, j''ai donc mis du gingembre, de la cannelle, du cumin, et de la muscade... mélange étonnant se mariant très bien avec les bananes !  Cake pas sec du tout !', '2009-02-20T17:26:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 7eea3937-4351-468a-b3d6-cfe1d1ec65b0, 'Très bonne recette, j''ai mis juste 2 cuillères de cannelle et écrasé 2 bananes. Malheureusement, cela n''a pas suffi à éviter la migration des bananes vers le bas...', '2008-10-21T20:03:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, d20c5925-cd1b-4d4d-892e-607c4b90d9bf, 'Mélange troublant et raffiné pour ce gâteau! N''étant pas une adepte des 4 épices, je  n''ai mis qu''1 cuillère à café. Le gâteau a fait l''unanimité à la maison et pour le goûter de l''école!', '2008-09-07T19:12:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 6127bbcc-3fa4-4f9a-be07-dd27161ce975, 'Très bon cake, rapide à préparer et qui change du traditionnel gâteau au yaourt aux zestes de citron! Ne pas hésiter à mettre toutes les doses indiquées d''épices, cela ne fait pas trop, mais juste ce qu''il faut quand on aime l''exotique!', '2007-04-15T11:36:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 5a4853be-8876-41d5-87d7-2efbf6ae96a3, 'Facile comme tout...inratable et délicieux! J''ai mis 2 bananes mixées et un peu moins d''épices car le gâteau était destiné à des enfants: il était quand même très parfumé. Je referai avec délice !', '2006-09-22T22:11:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 7b666625-582d-43c2-a69a-5cefafa832c3, 'Original, les enfants ont aimé.', '2006-07-26T20:57:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 512868c4-ca18-4bbb-9639-17e96d8152eb, 'Très bon et facile à faire! Même sans les épices (que je n''avais pas dans mes placards) c''était délicieux !', '2006-03-01T17:59:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, eef3a64d-8a69-434f-902d-28665359db77, 'Très bon, c''était un régal.', '2006-02-18T13:19:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 0a6bcae4-38bb-453c-ac12-7c8ac1b836b1, 'Excellent et succulent. Facile et rapide à faire au robot mélangeur. Une seule banane, mais quelques gouttes d''essence de bananes pour plus de goût!', '2005-12-15T22:09:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 810bb46f-d50a-47aa-beb8-447992677091, 'Très rapide et moelleux... Le goût de la banane est très prononcé.', '2005-12-04T21:46:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 34a3d484-3652-4ad6-a083-a9a0e8878090, 'Je fais ce gâteau régulièrement (la version "plus de bananes, moins de cannelle"): nous l''adorons au petit déjeuner! A déconseiller à ceux qui aiment les cakes ultra légers, les autres par contre n''en laisseront pas une miette. ', '2005-10-04T18:56:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, a1aad0da-5c51-4048-b423-486a9c20a923, 'Bonne idée, mais ne pas mettre une overdose de bananes (3), car il devient lourd et compact. L''idée des épices n''est pas mauvaise, mais modérer.', '2004-11-01T12:20:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 76cbd30c-75b7-45c8-a683-510a860db512, 'J''ai suivi vos conseils. Avec 2 bananes écrasées et un peu moins d''épices, c''est très bon!', '2004-03-20T15:31:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, a996e119-2d03-45d2-8105-7c1a372d351d, 'Excellent mélange de saveurs. 1,5 cuillère de cannelle suffit. J''ai égalemant mixé la banane (j''en ai mis 1,5) avant d''ajouter les autres ingrédients. Vraiment très bon!', '2003-07-02T23:17:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 5dc5503c-ab8c-4791-a0ee-e2004a8c1dd0, 'J''ai mis 2 bananes en morceaux et il faut un peu moins de cannelle. Les temps de cuisson ne correspondaient pas.', '2003-01-30T12:22:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 5ecda48f-ee01-415a-9b0a-7124a70ac9d0, 'J''ai suivi le conseil d''élodie et j''ai mixer les bananes. J''en ai mis 3 au lieu d''1. Il faut dans ce cas augmenter le temps de cuisson, mais c''est tout simplement génial. Je vais essayer avec du chocolat pour le rendre un peu mois sec.', '2003-01-15T17:27:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, cece6436-50a1-4cdd-b013-b3dcdf05c71e, 'Tout simplement excellent! A mon avis peut aussi bien se faire sans banane.', '2002-07-17T18:07:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 267dae6c-14fd-4116-83b3-a1455688ac3c, 'Très bon, mais je pense qu''il vaut mieux mixer la banane.', '2002-02-17T11:22:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, 0c6b6275-38e8-4a3f-8d0c-2d6a7a7f0091, 'Simple à faire et délicieux ! Merci...', '2002-01-13T18:28:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14381, bf8faf05-39d1-4ddb-a9ee-15ab6addf470, 'Un gâteau très moelleux et très simple à réaliser. Une saveur originale. On peut y rajouter quelques tranches de banane caramélisées sur le dessus.', '2001-08-29T16:24:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194391, 381d6420-62d2-4257-9142-db530cfb4016, 'Cette recette est excellente. Je l''ai fait pour 6 personnes environ 2 heures avant et j''ai simplement ajouté la crème et les vermicelles de chocolat à la dernière minute.', '2011-12-05T15:01:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28088, 97e61156-0111-40f2-b976-e91a72ad71ee, 'Bonne salade de fruits, mais rien de particulier à signaler.', '2011-06-26T22:24:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28088, ca98d463-4efc-4946-aba2-6d4efb726a78, 'Ressemble beaucoup à l''habituel salade de fraise. Le jus d''oranges laisse espérer un goût qui change, mais rien ne se passe. Bon, mais sans plus!', '2006-03-14T14:04:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28088, dcf3a9c7-dc84-41fb-9d0b-7107c6e76e7e, 'Pas mal, très rafraîchissant... La prochaine fois, j''essaierai avec les feuilles de menthe!', '2005-05-08T18:46:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28088, fca6b0b0-dacb-4c11-8501-dc68c3fbe2f2, 'Très bon, et très facile a préparer. J''ai suivi le conseil d''Eleonore en ajoutant de la menthe fraîche.  ', '2005-04-24T23:34:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28088, 893406d0-832f-401c-a8c5-e1fd579f829d, 'Très bon! Un vrai délice... J''ai ajouté des feuilles de menthe hachées.', '2004-05-23T20:33:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230110, b34ee091-dbd7-42b6-804f-aaa97e80192e, 'Génial !', '2022-04-12T10:18:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230110, f04eee83-d554-456a-a9f0-120faa6414cc, 'C''est excellent ! J''ai adoré et j''ai rajouté un peu de framboises. Merci beaucoup pour cette recette.', '2022-04-11T22:11:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (230110, 32498b19-912e-4d49-b5aa-3fbca2e3898c, 'C’est un délice merci


', '2022-04-11T10:56:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33426, b1630698-def3-448c-bf54-0049c3cbdb87, 'Très bonne tarte. Je n''ai pas mis de coco, ni de lait ni de gingembre et les figues étaient surgelées. Association délicieuse ! Merci. ', '2022-04-21T17:07:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33426, 84b141a1-29b7-4a10-8079-5748e9da85b6, 'Délicieuse ! Approuvée par un mari difficile...', '2016-03-10T14:18:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33426, 58cd1cf8-a397-4265-bf82-e32cc5588259, 'Bonne recette mélangeant pommes et bananes: la tarte tient au corps. Les enfants ont adoré et cela a été l''occasion de découvrir la figue sèche. En revanche, le goût du gingembre est non identifié après cuisson (intérêt ?).', '2005-11-05T19:23:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23111, ab080d55-838e-4784-bc0e-40b507301816, 'Un délice, mais j''ai mis des dés d''ananas frais, c''est quand même meilleur!', '2003-07-01T16:03:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (232991, 3a5ad02a-94b0-4c53-840b-24595b55be8e, 'Un délice et si facile à préparer.  
J''ai remplacé le Nutella par du chocolat 75%. Délicieux ', '2021-01-13T20:47:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (232991, 4b70b37d-5f3b-4c61-b002-21a823ad386d, 'Excellente recette.', '2017-03-08T12:46:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (232991, 3dab2822-10d7-4131-8e2d-e9f13a74fd82, 'Très bon.', '2016-06-18T18:51:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (232991, 52ad118f-1f2c-4fad-a853-298cd3c1f3c9, 'C''est trop bon, à refaire ', '2015-01-18T14:27:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30309, 60d9089e-bed0-4ceb-a33a-312be90d0460, 'Très bon !', '2020-04-16T16:57:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30309, f4328dfb-efec-4e0b-812b-ff25d771b77a, 'L''essayer, c''est l''adopter !', '2014-02-05T21:19:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30309, b332356b-10dd-4742-8a2e-0cde47f8125d, 'Très bonne recette ! 30 min de cuisson suffisent, mes biscuits étaient un peu secs. Pour un dessert sans alcool, j''ai trempé les biscuits dans les 20 cl de lait dans lequel j''avais fait fondre 30 g de sucre vanillé.', '2013-11-26T10:36:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30309, 01b1d98b-c5e5-41d3-a5a4-437509861dae, 'Délicieux', '2013-07-09T23:01:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58846, 2c84e37f-0b6d-4a69-8995-c930833575ab, 'En comparant avec les beignets que j''ai mangé à l''île Maurice, je pense qu''il faudrait plutôt 3 bananes un peu plus de lait, un peu moins de cardamome (sinon on ne sent plus le goût de la banane qui est plus doux que celui de la cardamome).', '2014-01-19T17:05:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58846, 206309aa-f779-471e-9ba6-024acd935ac1, 'Déçue, pas assez sucré et je n''ai pas senti le goût de la banane (peut-être parce que mes bananes n''étaient pas mûres), je la referais avec 3 bananes et plus de sucre.', '2010-11-12T22:44:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58846, 87ec2424-4d85-41fe-afd8-e32f8df8c8dc, 'Un seul mot excellent... Je ne connaissais pas la cardamone, je l''avais acheté car souvent dans les desserts on en met et j''ai testé... Ce petit goût délicieux. Moi qui n''aimait pas la banane cuite, j''ai adoré.', '2010-10-15T21:50:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58846, d8d837b4-7f0a-463f-a062-6c0d4f266980, 'Excellent ! Les Beignets à la banane ont été un succès ! Ma note est un 5/5 ! Recette à refaire !', '2009-09-15T23:39:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58846, 7be1aa46-f392-443e-aae5-8bffa356b8e6, 'Très bon!!.. je les ai fait avec 3 bananes vraiment très très mures (au lieu de les jeter) et j''ai ajouté de la cannelle et de la muscade... et sans levure car je n''en avais pas... ', '2009-05-06T04:26:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58846, 45e1dc9e-95c8-46ad-879d-cb2caf2654d2, 'Très bonne recette. 1 banane de plus pour le goût et le tour est joué! ', '2007-10-06T20:53:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58846, d53295b8-0e8f-4c7d-9c21-85095e52c0cb, 'Super, j''ai retrouvé la recette des beignets de banane que j''ai mangé à la Réunion! Je n''ai pas mis de cardamome ni de lait en poudre mais j''ai rajouté un peu de rhum charette. La prochaine fois je mettrai un peu plus de bananes. Sinon excellent, ils n''ont pas fait long feu !!!!!', '2007-10-03T12:56:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57272, 9cd32356-a375-4fd1-8974-4e70cc900c11, 'Trop bon. Miam miam ! ', '2014-04-25T15:10:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528639, cbfd9b4d-a0f3-47c9-a5c9-247ffb475b22, 'Super rapide a faire et parfait au petit déjeuner. ', '2022-01-30T11:02:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528639, 7966d90d-abf5-42a4-801d-ff039191a6a4, 'J’adore ! ', '2023-07-01T23:59:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16497, 89ce7af9-8332-4e46-a747-159b204786da, 'J''ai un peu modifié la recette de base en y ajoutant de la levure chimique et 2 oeufs. Par contre le sucre que j''ai saupoudré généreusement dessus à trop sucré le dessert. Sinon le dessert aurait été au top.', '2016-05-30T20:51:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16497, 19a9c0c4-feab-4f97-995d-78000cfd3710, 'Oui, la crème a coagulé avec la cuisson, donc le petit lait s''est formé et c''était immangeable.', '2008-01-27T10:54:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16497, b652de5d-cb89-4e44-adb6-b7c688680d1c, 'C''était très bon. Nous l''avons mangé chaud, un pur régal. Merci.', '2006-02-19T12:38:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16497, bfd72cd8-3965-43cf-acaa-0088b27e783f, 'La crème a coagulé, donc c''était très liquide et aussi trop sucré...', '2004-03-26T14:47:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16497, 619de787-01da-450a-bc50-ad2eadb770a3, 'Très déçue. Mélange un peu écoeurant.', '2004-03-23T11:05:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16497, bf97f231-69aa-4f23-999d-d4b12a03e3b2, 'C''est vraiment délicieux. J''ai fait des ramequins individuels et j''ai rajouté un peu de cannelle à la crème.', '2003-11-06T12:51:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16497, 6eda6697-bb4d-4172-a4e4-a9286fbc9739, 'Rapide à réaliser et très bon dans des petits ramequins individuels. J''avais oublié le citron, mais tout le monde c''est régalé. Préférez la crème allégée, c''est peut-être moins lourd...', '2003-05-01T22:55:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16497, 8d4e6cc5-5e77-4650-860c-da132220ea3e, 'Très bon et très léger, malgré les bananes. J''ai réaliser ce dessert dans des ramequins individuels.', '2003-03-08T13:53:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168952, 959cb410-74bb-44af-9167-4e5bb2c18971, 'Excellent.', '2019-04-25T02:54:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168952, a10928fc-e92c-4058-be16-db42c67fcf00, 'Recette faite pour le goûter. Tout le monde a adoré. Je recommande.  J''ai juste doublé les quantités des fruits pour avoir plus de jus. A boire très frais.', '2019-04-23T07:47:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168952, 73ec98a9-db36-4e15-8670-b6d8bea59ec6, 'Simple, rapide et très bon ! Mais a plus une texture de smoothie que jus de fruits (peut être dû à la banane).', '2019-04-23T03:17:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168952, 3781b92f-d791-4b3c-8ec0-76ec9cbdfa94, 'C''est un bon jus, pleine de beaucoup de vitamines.', '2019-04-23T02:37:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168952, 076c9b47-426d-4450-add7-83b4fc89976f, 'Très facile a faire et très bon ', '2017-03-28T21:40:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335407, 9e4f1257-7e6b-42f3-bff7-3601816ad211, 'Très bon, j''ai rajouté une cuillère à soupe de sucre et de farine ainsi qu''un carré de chocolat noir à la sortie du micro ondes', '2021-08-29T16:53:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335407, 95b00784-467c-4889-a6bf-c7b4e120038b, 'Très déçue ! Pas cuit du tout malgré plusieurs passages au micro ondes', '2020-05-31T18:36:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335407, 0bf4ed7e-e3c4-4c42-a1fc-330cc1aef0a3, 'N’est pas du tout cuit, très pâteux et j’ai du y ajouté dû flocons d’avoines pour rattraper le coup ! Si je pourrais y mettre 0 étoile je le ferais', '2020-05-23T01:19:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335407, af1c7996-e4dc-4c7c-93fa-7b8c0156ef38, 'Il faut mettre plutôt 3 cuillères à soupe de farine, sinon le mug cake colle et ne cuit pas.', '2020-04-18T18:41:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335407, f6054457-f33c-4b63-8b67-c2f6dba7e452, 'Bonne texture, goût léger mais agréable. ', '2019-07-18T04:29:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335407, 0244c915-6146-4b7d-9405-6e94dda807b8, 'Sans banane c''est super bon aussi !', '2018-12-17T12:18:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335407, f473bdd3-068c-4288-98e7-a41e9ea78c8a, 'N''a pas du tout cuit, n''est pas du tout monté...', '2018-10-19T18:54:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335407, 1c043fe5-6aec-4afe-af2f-d1efdc415faf, 'Très bon ! J''ai mis un oeuf à la place de la levure chimique, c''était délicieux avec le topping chocolat.', '2017-01-16T16:19:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335407, 83058c33-7947-47b0-9f68-b52adba21361, 'Super déçue. Tout est à revoir.', '2016-03-04T13:24:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335407, f0b2bda0-617c-48ee-8636-a589a8fdd7d1, 'Bonne base de recette, je la referai avec une banane entière pour mieux sentir le goût. Bonne texture pour un mug cake. ', '2016-01-11T18:19:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335407, 75810ec7-6c56-4005-9e12-3ec2c6a9a248, 'Très déçue par cette recette, pas assez le goût de banane. Pas assez cuit, trop pâteux.  ', '2015-11-11T22:41:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44063, d3ba3db8-6a71-4825-bc71-594ad8d59cd6, 'J''ai essayé, mais ça n''est pas ce que j''attendais... Dommage!', '2006-09-05T12:50:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44063, e9718d92-7f40-4b35-96b7-c0457f6b0da8, 'Catastrophe! Il est impossible de faire une "croûte" qui tienne avec des biscuits et du beurre, cela se saurait... En désespoir de cause j''ai tout mélangé: les ingrédients de la "croûte" (qui ressemblait à de la chapelure) et la garniture. J''ai mis au frais et cela m''a donné une sorte de gâteau-pudding assez mangeable. Si je le refais, ce sera comme une tarte classique, avec une pâte feuilletée.', '2006-02-20T11:00:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27461, 876ae109-8b19-4172-9185-23e0ee9da8aa, 'Parfaite, j''ai coupé les fruits en rondelles et je les ai placé dans un emporte pièce. A déguster avec un coulis de fraise et de la chantilly.', '2013-05-28T00:17:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27461, 7741930d-915b-40cb-bb76-0b2f1204bc39, 'Pour 6 personnes, je n''ai mis qu''1 pomme granny, 4 bananes, 500 g de fraises et 1 grappe de raisin noir, 2 sachets de sucre vanillé et le jus d''1/2 citron. Ce fut parfait!!!! En plus avec de la chantilly, quel régal!!! Merci beaucoup pour cette recette.', '2012-05-27T19:34:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27461, 2bb34a29-c178-4eb0-8b9f-9372c4855859, 'Très bon ! J''ai tout de même rajouté de l''ananas, des kiwi et 2 bouchons et demi de rhum. Saupoudré de sucre vanillé et au frais !', '2010-04-18T18:08:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27461, 710c45ba-1c76-4e0f-9862-56b8ba2c7d92, 'Très bonne recette. Un vrai succès pour une première.', '2010-04-09T21:54:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27461, a9cb1562-4161-48ce-be00-abde1f7a1573, 'Excellente recette de saison facile et rapide à faire. Très rafraîchissante et subtile avec un nuage de chantilly en accompagnement!', '2006-05-31T11:25:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27461, 9803ccc5-79e7-43c1-b4db-816e1550536c, 'Pour les couleurs Bob Marley, vous avez oublié le noir! (rouge, jaune, vert, noir), il faudrait donc rajouter des raisins noirs...', '2004-02-23T11:20:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27461, 139f5b67-8bfe-428e-b3b9-0534cf94b91f, 'Aime bien cette petite salade!!!', '2004-02-21T19:12:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27461, bace45bc-dba6-4fd4-aaec-28d012bcedf1, 'Encore meilleure avec de la Chantilly maison!', '2004-02-21T18:17:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45783, ac538724-65d2-4255-9e2d-8886a0ff0eb0, 'Je viens d''essayer votre recette, je suis déçu car mes invités n''y ont même pas touché...! Merci!', '2007-05-13T15:09:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45783, 1307bc38-0ecc-40f0-b5fe-71fb8555c385, 'Moi j''ai mis que le lait, les bananes, le sucre et la cannelle; c''est déliciceux quand même! ', '2006-05-15T19:55:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45783, 3a3a1649-5dbf-431f-9631-a942d96380a8, 'J''ai oublié le sucre et c''était très bon comme ça! Je vous recommande de l''essayer.', '2006-04-02T00:03:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325123, c47e39d3-d82c-4bfd-929c-92356182bd2b, 'Une salade de fruits originale et délicieuse.  Faite avec du rhum blanc... et plutôt 10 cl que 5 cl...', '2014-08-26T23:45:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (325123, 4f46cc44-b672-4964-86ef-3314e7797cba, 'Excellente ! J''ai même rajouté des litchis au sirop et des mangues au sirop car j''en avais sous la main. C''était un régal léger en fin de repas. Merci, je recommande cette recette ! ', '2014-08-16T16:28:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82124, ca7da02b-b357-49d9-b7cd-ca9bf6dd8040, 'Pas mal, mais je l''ai trouvé un peu sec. Par contre, un peu de rhum ne ferait pas de mal dans cette recette!!!', '2008-11-12T22:40:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217633, c50aa84c-e338-4596-bbf8-fcf102e628c9, '7.5/10 d''après mes convives.', '2022-01-30T18:45:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217633, 761df478-286a-4a8e-a73a-315661cef3ea, 'Recette très facile à réaliser ! A part la noix de coco (que j''ai remplacé par de la crème fraiche), j''ai respecté la recette. C''est une recette qui fait voyager, si vous la servez sur des feuilles de bananiers, avec de grosses chips à la crevette et mettre quelques morceaux de poulet sur une petite pochette en bois. Sans oublier une portion de riz blanc avec petites crudités coupées finement autour (comme en Indonésie ). Merci beaucoup. ', '2017-05-01T12:36:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217633, 27d0c745-a943-4653-bf64-383cdaf0cb29, 'Très bon et très simple, n''ayant pas de cumin j''y ai mis des épices "indiennes", et je n''ai pas mis non plus les raisins secs.', '2012-10-22T14:17:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217633, 3a7508d2-77a8-4b2a-a487-62b04fda3c7f, 'On aime beaucoup le sucré-salé, mais là, on a trouvé le goût banane + coco rapidement écœurant. C''était mieux en ajoutant du sel, mais ça n''était pas transcendant quand même. J''ai peut-être loupé quelque chose...', '2012-10-02T16:57:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217633, cde28d29-0ca5-46b6-86d2-28e4e828227a, 'Merci pour cette savoureuse  et excellente recette. ', '2012-06-20T12:25:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217633, 85afc238-10ed-488e-ba92-654844cfa809, 'Recette originale, facile à faire, qui donne un plat savoureux notamment le lait de coco qui s''en être trop sucré donne un moelleux à la viande ! A essayer si vous aimez le sucré-salé ! ', '2011-10-08T15:53:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68390, 24791cd7-80b9-42d7-86ea-f7afe5670dd2, 'Très bien pour l''automne !! =) ', '2010-06-26T21:55:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71256, 0b9ebaba-fba9-454a-88fc-737c70748dc3, 'Délicieux, moi j''ai juste mis 1 pomme, une poire et 2 bananes.', '2017-10-07T16:02:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71256, 82d33add-8eb1-4ec3-9f78-6cde0e503b70, 'Excellent j''ai rajouté  de la canelle !', '2017-08-15T15:15:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71256, 6246d092-40e9-4e3c-baf1-dd14aaa77126, 'Parfait, rien à ajouter ou à retirer ! ', '2016-11-24T19:28:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71256, e3485a1f-4b27-487f-83b5-2a561b3e2e87, 'Très bon ! J''ai mis des bananes bien mûres et j''ai ajouté un peu de jus de citron à la fin pour un peu d''acidité', '2013-11-28T22:24:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71256, 6b864301-055e-4841-a8b4-5f5e1d447c3e, 'Très bon, les enfants ont adoré.', '2013-02-01T20:50:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, e52bff74-4c4e-4b41-8e92-8f057a8d854a, 'J''ai mis 200 g de beurre au lieu de 250... excellent et moelleux ! ', '2016-06-26T19:17:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, 8e8804e5-eb19-41e5-be4a-29aab0f7e195, 'Cuisson à 52 minutes four 200° chaleur tournante sans banane et moins de sucre', '2014-11-15T12:36:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, b21a37ba-a3f1-4da9-a35b-3f5823369e42, 'Très bon quatre-quart. Il est moelleux et savoureux. J''ajouterai juste un peu de poudre d''amande pour la prochaine fois. Mais à refaire.', '2014-05-10T18:20:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, 804230ef-30ce-47e4-bcb8-d404fa484e85, 'Excellent ! Je n''ai pas mis de rhum, sinon j''ai suivi la recette à la lettre ! Il est super bon, pas sec !', '2012-07-29T18:49:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, cdf45815-607f-4d45-99df-1ebd6f51431e, 'Je vais certainement me faire huer mais malheureusement je n''ai pas accroché, ni moi ni mes convives :( Un peu lourd et on aurait mieux senti le goût de la banane si on en avait mis 4 au lieu de 3.', '2012-07-01T15:10:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, 8aee7cae-f8a9-4994-b7e8-c8758ffe9b6e, 'Délicieux. Comme conseillé, je n''ai mis que 180g du sucre et c''est largement suffisant, et je ne l''ai cuit que 50min. Il n''est pas du tout sec. Je le conseille vivement!', '2009-02-13T16:35:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, 177a8621-2201-41a9-9f36-8d0e24698545, 'J''ai mis 4 car mon mari m''a dit : elle est bonne ta couronne !!! Mais je trouve qu''on ne sent pas assez les amandes, j''ai suivi la recette, sauf le rhum que nous n''aimons pas et j''ai ajouté des carrés de chocolat comme suggéré, mais ils n''ont pas fondu. Je le referai en ajoutant plus d''amandes en poudre ou alors de l''extrait d''amandes amère et sans le chocolat. Malgré tout, merci pour cette recette si simple et rapide à faire.', '2008-12-07T14:34:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, 436df538-6993-4b39-a7e9-9690bf04125e, 'J''avais 5 bananes très mûres. J''en ai fait deux en y piquant de gros morceaux de chocolat au dessus qui se sont noyés dans la masse pendant la cuisson. Verdict : Le 1er, que j''ai apporté au boulot a fait l''unanimité. En rentrant du boulot, j''ai demandé à mon mari s''il a aimé (le 2ème) et il m''a dit de le voir par moi même. Il a mangé la moitié d''un coup. Il est excellent. Léger et gourmand. J''y ai mis 180g de sucre en tout au lieu de 250g. Un délice.', '2008-03-06T00:13:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, 5a15ec50-fb3a-4085-9b88-c72a2aa5a321, 'Super bon, gras mais fameux. Je n''avais pas d''amandes mais j''ai mis une cuillère à soupe d''extrait d''amande amère et une d''extrait de vanille!', '2007-09-19T22:43:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, 96bcee29-3a42-41d7-9914-66ebbad8a72e, 'Très bonne recette qui a fait l''unanimité auprès de mes convives, malgré l''absence de sucre glace et d''amandes effilées. Mais c''est promis, la prochaine fois je fais la recette originale!', '2006-11-19T18:35:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, 23b91b72-88a3-43dc-b564-a81216ce2c63, 'Vraiment une bonne recette, le résultat n''est pas sec du tout et très parfumé.', '2006-08-13T13:54:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, f072fc08-72a2-4c40-8cef-a46c7d84e834, 'Génial! Je voulais faire plaisir à mes amis et mon amoureux: c''est chose faite... C''est facile, délicieux et léger!', '2005-10-09T00:04:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, e1e6c1a1-3986-4203-a464-301ead43e549, 'Un vrai régal!!!! Merci Anjuli pour cette recette, facile à faire et délicieuse! ', '2005-10-02T19:38:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, 10981062-8aae-4e16-9027-3eccc981b1f4, 'Merci pour la recette! Très bon gâteau. Facile à faire en plus.', '2005-08-10T19:02:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, 08e76368-2b30-461b-8693-f12370c10ee4, 'Très très bon! Mais ajouter les bananes au moment indiqué est un peu difficile, il vaut mieux le faire après, quand la pâte est moins mastoc...', '2004-07-28T11:56:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, 0129d120-efb8-4bb5-968d-0ce09f9156ba, 'Miam! C''est vrai que c''est un gâteau à éviter dans le cadre d''un régime... ;-) Mais c''est vraiment très bon!', '2004-07-19T22:23:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, 6846a2f2-6825-4284-a8f6-f70909359d80, 'Délicieux! Surveiller la cuisson, car 50 mn m''ont paru beaucoup...', '2004-06-13T23:13:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24534, 6a2eb508-3eb3-4932-affb-db06c11cf90c, 'Très bon, mais très lourd...', '2004-04-20T16:32:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335552, 747c09b7-563e-4817-848c-79ce8b89df9d, 'Bonne recette, fonctionne aussi au lait de vache. ', '2019-09-27T13:20:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335552, 0a72a9a4-d1d1-4c7e-96e6-c1a19d35f226, 'Très bonne recette, indications de cuisson parfaites. Je n''ai pas mis de dattes ni de lait d''amande car je n''en avais pas. J''ai mis 20 g de sucre en plus pour compenser les dattes manquantes, et (n''étant pas intolérante au lactose), j''ai remplacé le lait d''amande par du lait de vache. J''ai aussi rajouté 1 cuillère à café rase de "baking powder" pour plus de gonflant. Le résultat reste un peu "crayeux" dans la bouche, mais c''est excellent.', '2015-11-30T13:02:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (340287, a94b5f6e-56a9-4b82-9c40-51a5ed047659, 'Délicieux!!!!', '2018-07-01T06:47:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345356, 3ea04549-5339-455c-a5d4-fcc6a5fa661b, 'Super', '2023-02-24T14:54:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (232374, b00bf835-46c1-4bc8-b498-7b0b303562ff, 'Le jus de kiwi donne du caractère à la recette à en faire friser les moustaches. Les bananes de Bamako sont difficiles à découper (choisir une bien mûre, longue et dure). Super recette à déguster entre amis.', '2013-05-24T00:45:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219617, 1edd324c-ca49-4a40-9ebe-cc03c13759cf, 'Excellent ! ', '2016-02-04T21:15:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219617, 982cee5c-dc4c-4f80-ab2e-ac5ff46c9cf6, 'Délicieux ! ', '2013-11-18T21:47:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63656, f38e4790-771f-47c5-a235-fb1f9056fdbf, 'Délicieux et j''ai rajouter une plaque de chocolat ,trop bon !', '2023-10-31T15:58:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63656, 3fc24ce9-ab5c-4d3b-8ec3-49f9696eb593, 'Super !!! J''ai aussi enlevé 50 g de sucre et ajouté 1/2 banane... mais ma cuisson des rochers n''est pas la même... je les laisse minimum 1h au thermostat minimum... pour moi c''est meilleur (plus cuit plus croustillant) mais je fais peut-être une erreur', '2010-08-16T23:48:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63656, 020daa74-3a7c-4590-b3a8-a04faea9216e, 'Recette facile et rapide pour un goûter improvisé. J''ai cependant réduit la quantité de sucre à 50 g et j''ai rajouté un peu de poudre d''amandes et de la vanille. Absolument excellent!!!', '2009-01-31T19:34:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63656, a9903fc8-8e50-4379-9a06-05632e8788af, 'J''ai mis deux bananes et des pépites de chocolat... Très sympa mais la consistance est un peu molle.', '2007-12-30T18:50:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (342811, f3414fff-75bd-42a5-927d-70bf41b03341, 'Ovationnée par tous ceux qui aiment les bananes, super recette..
', '2023-06-04T06:28:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (112804, 02b8955a-da4a-43ab-b65f-2952eefd1651, 'Simple, rapide et très bon. Tout le monde a aimé.', '2018-12-31T18:49:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (171586, 6ef7e40f-446b-4e92-90cf-730b7a7c03dc, 'Excellente soupe. J''ai fait revenir les légumes dans de l''huile d''olive, mais n''ayant pas de banane sous la main, je l''ai remplacé par une petite pomme de terre, mis 3 tomates fraîches et du concentré à la place des tomates pelées. Pas de curry, un seul bouillon cube et 1 litre et demi d''eau. 10 minutes sous pression. Rapide et très goûteux.', '2013-10-08T21:31:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (171586, df3a9f61-e793-4408-8bb4-26e6681145b3, 'J''ai ajouté un gros navet, un cube de bouillon de légumes et un de bouillon de poule. En effet, inutile de saler en plus. La banane ne se sent pas, mais adoucit l''acidité de la tomate et du poivron. Très bonne recette, vite faite : je garde !', '2013-01-25T17:12:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (171586, 4c4e3bde-617f-4315-b052-fed06358b88e, 'Très bon quoi qu''un peu trop salée à mon gout avec les bouillons cubes (je n''avais pas mis de sel en plus pourtant)', '2011-06-21T21:37:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 8be38a62-83e9-4d7e-b76c-dd9891ebc6e2, 'Un délicieux gâteau qui ne goûte ni le chocolat ni la banane mais devient parfait avec une bonne couche de chocolat. Oubliez la levure, Le gâteau sera d’autant plus compact, un bon exercice pour les mâchoires à la dégustation...', '2019-04-24T10:09:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, a2cb103b-7c5b-4e73-a5fa-8f00e417e212, 'J''ai pris peur en lisant tous ces commentaires, négatifs pour la plupart ... En fait, le gâteau est super moelleux (j''ai battu le blanc d''oeuf en neige). Il me manquait la proportion de lait, j''ai retrouvé la recette sur un autre site, qui indiquait 10cl. J''ai eu la main lourde sur la cannelle (je ne l''ai pas mesurée) sinon il est vraiment parfait. Mon fils de 5 ans l''a adoré !', '2019-02-09T20:54:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, dfe51509-0330-42d6-8640-895b70bd0f90, 'Comme je n''avais pas de chocolat noir j''ai utilisé 100g de chocolat au lait et j''ai trouvé ce gâteau super bon mais un peu sec une crème anglaise aurait été la bienvenue. Même si c''est pas une tuerie ce gâteau et très bon, d''ailleurs il est idéal quand on a une banane qui traîne dans le frigo ^^', '2013-06-09T22:19:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 20beddf2-1cde-4fce-8824-ca3c209c7886, 'Personnellement, je n''ai pas aimé...', '2011-10-01T00:35:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 6ab82a67-c31d-42e8-a5cd-0cadebf71f1a, 'Je cherchais un gâteau à faire avec des bananes, je suis tombée dessus, mais j''étais loin de me douter que j''allais concevoir la pire erreur chocolatée. Même une part minuscule n''a pu être finie... Personne n''a aimé et ce fût une réelle déception : comment à partir d''éléments tout à fait succulents, peut-on créer une telle abomination culinaire, c''est tout à fait inconcevable...', '2011-08-26T16:57:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 47f30a99-1a47-47f7-bc3c-448329682659, 'Succulent ,délicieux, rien à dire. Servir avec un peu de crème anglaise, ça doit être aussi bien.', '2010-05-02T15:38:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 25649943-d543-4283-80c4-1057e8d175e8, 'A lecture de la recette, et pendant la préparation, on se disait que ça serait un peu juste pour 4 personnes... Finalement, on aurait pu se le partager en 100, vu que personne n''en a mangé!!!! Ce gâteau est infect!! Enfin au moins on a bien rigolé! Surtout en lisant les autres commentaires après coup.', '2009-03-08T00:39:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 51987551-7ce5-49a5-a5cb-ebc473e5a4da, 'Moi je trouve ce gâteau excellent quand on est au régime, c''est sûr qu''avec du beurre et du sucre, ce serait sûrement meilleur...mais pas pour les hanches!!! Et nous sommes trop habitués au sucré et au gras...mes enfants se sont régalés.', '2008-11-15T16:14:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 864b4d89-e844-4d7b-bbae-285f70564d51, 'Franchement !!! Fade ! Vous avez sûrement oublier un ingrédient ! Ça fait 2 fois que je le fais et j''ai eu le même résultat', '2007-12-14T16:20:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, b5690ff0-ddf2-4f0f-a69c-2c3ce10d0a5a, 'J''ai mis 50 g de sucre car quand j''ai goûté la pâte crue j''ai trouvé qu''elle n''était pas assez sucrée. La prochaine fois, j''essaierai sans le miel et avec une pincée de cannelle (au lieu d''1/2 cuillère à café): il y a trop de cannelle pour moi.', '2007-12-02T12:38:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 3229242c-532e-4fe3-a8d1-c63ab0554711, 'Ce gâteau n''a aucun goût. Rien qu''à lire la recette, on remarque qu''il n''est composé quasiment que de farine. Comment voulez-vous qu''un gâteau ait du goût avec seulement un oeuf, pas un seul gramme de sucre ni une goute de beurre, et seulement 50g de chocolat. Vous prenez de la farine et de la levure, puis quatres gouttes d''eau ou de lait, vous le mettez au four, et vous obtiendrez exactement le même résultat. Désolé...', '2007-11-27T23:13:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 5866b5ff-693e-4fb4-8553-dc9ec7bb1afa, 'J''ai été très contente de ce gâteau, beaucoup de goût, ne pas hésiter à forcer un peu sur la cannelle et le miel.', '2007-11-18T17:49:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 0b342004-6fb1-4ce9-9bba-805c4b1b9a45, 'Nous venons de gouter ce gâteau chocolat/banane, un véritable délice ; j''ai doublé les doses, il est parfait, léger, mousseux et vraiment je le recommande. Mon petit-fils le trouve délicieux, mon mari qui n''est pas très "gâteau", excellent,et moi-même idem. Félicitations et en plus quelle facilité, (pour les débutantes).', '2007-08-14T21:56:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 073f0e23-b569-442f-858b-fb48eae453cb, 'Excellent petit gâteau... de régime bien sur mais c''est clairement marqué dans le titre ;) J''ai glané ça et la les conseils, 150 g de farine, 2 oeufs, 100 g de chocolat et 50 g de sucre (je tenterai avec de l''édulcorant la prochaine fois) et c''est vraiment délicieux! Merci pour cette recette qui me permettra de ne pas trop culpabiliser à manger du gâteau alors que je suis au régime :-)', '2007-07-10T00:47:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, bf37a1a7-30a2-4b2d-b104-787ff7ce0297, 'Si vous cherchez un gâteau ni trop gras ni trop lourd cette recette est pour vous! Par contre mettez bien un sachet entier de levure, je n''avais mis que la moitié donc la moitié seulement s''est levée! Bon ap!', '2007-02-22T22:37:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, e2b06cbf-dfb0-4295-b56e-588b40c3cb82, 'Je viens de faire cette recette, je suis loin d''être conquise. Manque de goût...Mon ami partage mon avis, et dire que j''en ai promis une part à la voisine...Pourtant j''y croyais au mélange choco/banane!!!', '2006-10-07T18:25:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, ee9de17f-d7f1-4e59-88c8-d68aac0af755, 'Etant au régime, cette recette nous a semblé très correcte. J''ai rajouté du sucre et pour mettre moins de matières grasses j''ai mis du papier sulfurisé dans le moule. ', '2006-09-06T12:57:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 8eb1fce1-caf5-4fe8-894c-d026358a5b59, 'Franchement, si je pouvais mettre 0/5 je l''aurais fait car j''ai trouvé ce gâteau sans goût, vraiment fade, malgré le fait que j''avais même rajouté du chocolat. J''ai jeté le reste du gâteau tellement mon ami et moi avons trouvé ça mauvais (et pourtant je ne fais jamais ça); heureusement que je n''avais pas d''invités ça aurait été la cata;)', '2006-08-24T14:18:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, c9ba5855-e0f1-434a-92f5-325e35c936fa, 'En effet ce gâteau mérite plus de sucre, et on a beau dire, on ressent l''absence totale de beurre. J''ai mis 150 g de farine et 100 g de chocolat. Le résultat n''est pas mauvais mais j''ai connu des textures bien plus agréables et légères. Bof bof...', '2006-07-12T13:19:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 59c8277b-e911-4d20-827e-c92f5f41abeb, 'Vraiment tous ceux qui ont mis un commentaire négatif sont bien difficiles! Il est vrai que les quantités de levure et de lait ne sont pas bien indiquées, il faudrait corriger ça ! Moi j''ai mis 1/2 sachet de levure. J''ai aussi suivi les conseils de battre le blanc en neige, de doubler la quantité de chocolat et de rajouter du sucre vanillé. Et j''ai mis un peu de maïzena à la place d''une partie de la farine. Résultat délicieux ! Je suis une grosse gourmande et ce gâteau ne m''a pas paru fade du tout !', '2006-06-19T12:53:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, bccbed85-8a04-4dfd-b08e-87925c1128b1, 'Succès assuré auprès de toute la famille. J''ai suivi l''avis des internautes en doublant les quantités et j''ai rajouté 2 cuillérées de rhum. Merci pour cette délicieuxe recette.', '2006-05-30T21:49:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, f95ca7f8-27f3-4d3d-bccc-9d47ed8864ab, 'Très bonne recette même si il y a quelques trucs à modifier : j''ai mis du sucre vanillé avec le chocolat et le miel et le lait bien sûr! J''ai mis 100g de chocolat et j''ai clarifié les oeuf et monté les blancs en neige, et je les incoporés à la fin de la préparation avant le four. Ca donne un resultat très bon;', '2006-05-19T21:12:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 32469048-1672-46ca-8af1-133353647735, 'Très bonne recette, moelleux. J''ai utilisé du chocolat patissier et ajouté un peu de sucre et c''est parfait!', '2006-05-08T22:51:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, f6382f05-5260-48ee-b209-8dc9f5b6f310, 'Ce gâteau est bon mais il manque un petit quelque chose pour en faire un très bon dessert. J''ai légèrement change la recette en ajoutant 50g de sucre à la place du miel et j''ai mis 75g de chocolat au lieu de 50g que j''ai fait fondre au bain-marie.', '2006-04-11T22:40:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 755793d0-5eed-49f0-9ded-7bf2f4a3b5f6, 'Certes, il faut doubler les quantités mais le gâteau est très léger et bon. Je l''ai servi avec une crème anglaise et tout le monde a apprécié.', '2006-03-19T17:28:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 95697e31-81e5-410f-bbaf-23b454cd28ca, 'Je trouve ce gâteau excellent. Mon petit plus: je double le chocolat, je rajoute un sachet de sucre vanillé et je rajoute plus de cannelle mais ça c''est une question de goût! Merci pour cette délicieuse recette!', '2006-02-12T14:03:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 7fde0bf7-885b-43f8-bdd6-604a5f689636, 'Doubler les quantités n''est vraiment pas exagéré. J''ai aussi rajouté deux cuillers à soupe de sucre de canne ainsi qu''une bonne lichée de rhum vieux, c''est bon.', '2005-11-17T00:23:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 5c804ede-e3df-4de8-917b-f2e105cc71e8, 'J''ai augmenté la quantité de chocolat, ça reste quand même assez fade... Le résultat est très moyen. Ca manque de sucre... et peut-être, d''une cuillère de rhum!', '2005-09-30T21:28:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, e47a99c0-3b28-4a8a-945b-f5521bb0f186, 'Comme la plupart des conseils est de rajouter du sucre... et que j''ai encore beaucoup de lapins de paques... j''en ai passé un à la casserole. Pour un moule à cake, il est très petit, donc, la prochaine fois, j''augmenterai les quantités. Vite fait, bon... à refaire!', '2005-08-14T15:08:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 7789f271-fd9c-4553-a6f7-97b574508a46, 'Vraiment mauvais, surtout pas à essayer, nul !', '2005-07-16T00:58:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 4d73e8b4-8f23-4cc5-bdbb-9633ef52859d, 'Bon ben voilà, je l''ai testé, ce gâteau...c''était un peu par curiosité, avec tous ces commentaires les uns positifs, les autres très négatifs. Je n''aurais pas dû le tester; j''ai suivi certains avis en doublant les quantités (sauf pour la farine: 150 g), en mettant un peu de sucre. Résultat : un gâteau au goût assez indéfinissable, à la consistance bizarre, un peu caoutchouteuse, pas assez sucré, hybride quoi. Bref, un conseil : ne le faites pas!! Mangeable avec du miel ou dans un yaourt aux fruits...', '2005-05-27T01:29:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, b696efaa-214a-4b5f-8770-cac564d9eb40, 'Pas de goût ! très mauvais ! parti à la poubelle ! ça devrait être enlevé du site des recettes pareilles !', '2005-05-18T17:16:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 588c3be7-37af-4330-9050-c8e8cb53dad0, 'J''ai essayé ce gâteau hier, il était tellement mauvais que je l''ai jeté.', '2005-03-24T13:51:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 25b39d82-8446-4b6b-9787-bf7973af0d03, 'Difficile à cuire, manque de goût.', '2005-03-13T20:03:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 51c3e318-c012-4a18-983b-a317ada7dc6e, 'Surprenant au premier abord, mais cependant agréable à déguster. Mon mari en a avalé la moitié à lui tout seul!. Donc la prochaine fois, je doublerai les proportions et j''ajouterai tout de même un peu de sucre. Il aurait fallu mettre la quantité de levure. Ceci dit, je vais le refaire!', '2005-02-13T16:31:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 166c5b7f-c652-4767-bbc6-17085536a09c, 'Vraiment fadasse car manque de sucre ou de chocolat, allez savoir!! Je ne le retenterai pas.', '2005-01-31T10:20:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 2a54252d-6221-4a83-951f-f837f7f6eba5, 'Forcément moins ''chocolaté'' au goût qu''un moelleux au chocolat, mais sa légèreté compense largement cet aspect! Un bon petit gâteau déculpabilisant! A faire... :)', '2004-11-09T18:42:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 1e2171d6-c208-427d-bb96-04f22bde9ebd, 'Vraiment léger et rapide à faire, il est délicieux, et plaît aux petits comme aux grands. J''ai remplacé la banane par des morceaux d''ananas et cela se mariait aussi très bien.', '2004-10-23T18:48:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, a8598397-d853-4c12-8902-11a37007633c, 'C''est un gâteau light, donc forcément moins sucré qu''un autre. Mais je l''ai trouvé excellent!! Merci pour cette recette!', '2004-10-23T18:26:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, c5beace5-4829-401d-8904-343964b4d2c7, 'Je trouve étrange de voir autant de critiques pour ce gâteau que j''ai fait cette semaine... Une très bonne recette!!!', '2004-08-08T05:35:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 76c1d399-baac-4665-80ef-233504c427f1, 'Vu que la famille n''aime pas la cannelle, j''ai mis un sachet de sucre vanillé. Franchement... Ca n''est pas mauvais mais sans plus. Vraiment pas assez sucré (je sais, c''est un gâteau léger). Je le referai mais, tant pis, j''y ajouterai un petit peu de sucre.', '2004-07-01T14:34:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 58a37eeb-0544-4126-b667-98bdaa2e4449, 'C''est vraiment trop fade... Il faut un minimum de sucre... Même de régime! ', '2004-05-23T20:38:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, f717441d-282d-4f15-be8f-7b5147970d54, 'Assez bon, mais il manque du chocolat!', '2004-04-13T09:13:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 3a4964ac-d430-4867-81b3-ffc47f613019, 'Agréablement surprise pour un gâteau sans beurre, et sans sucre!!! Petit plaisir même si vous faîtes ''régime''. Je vous suggère de rajouter un peu d''édulcorant cuisson et davantage de lait.', '2004-03-13T17:42:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 3ecc9061-5366-4a60-90ee-ee4587d0b7a6, 'Manque de sucre, mauvais réglage de quantité, goût bizarre', '2004-03-09T16:02:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 50b9f6ee-a9fd-48c9-8d01-f8d87faac3e2, 'J''ai bien aimé! Quoique peu sucré, très bien dans un régime!! Pour le lait, j''ai mis 1/2 verre. Mon conjoint n''a pas aimé du tout! Très facile à faire.', '2003-12-01T17:43:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 4957374a-1fa2-41e7-ab34-8c30a6a95c23, 'Quantités mal proportionnées, goût très spécial...', '2003-07-10T13:47:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 0bb1eaa6-a639-4646-b46e-595684474097, 'Pas du tout convaincue au départ, mais après dégustation... excellent! Toute la famille a apprécié.', '2003-07-08T18:17:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, c2cc5c12-6697-487b-9262-48054d128417, 'Malgré les commentaires, j''ai quand meme essayé car je suis au régime et j''avais envie de sucreries! J''ai juste doublé la quantité de chocolat et mis une pomme à la place de la banane. Eh bien nous nous sommes régalé, même les enfants qui eux ne sont pas au régime... Bravo!', '2003-04-04T19:49:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 91ad3651-eb0f-41f8-ad32-2b8a6057c3b6, 'J''avais décidé de me fier aux critiques positives (peu nombreuses, certes)... et bien je n''aurai pas du! Un goût bizarre (farine ou levure?), dommage...', '2003-03-24T11:07:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, cf2a6578-a5c8-4bd9-b26a-cbda8fe5736b, 'J''ai pioché parmi tous les commentaires: doubler les quantités, choisir du chocolat corsé, rajouter un peu plus de miel et de cannelle, le servir avec une boule de glace vanille. Résultat, tout le monde a aimé. Je l''ai fini, nature, ce matin, au petit-déjeuner et il est vrai que pour les amateurs de sucré, ce gâteau peut paraître fade. A recommander à celles et ceux qui surveillent leur ligne!', '2002-12-09T10:24:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 531f16bf-68dd-45d4-b18d-44acbcec75b8, 'Pas super bon mais pas à jeter quand même.', '2002-12-06T08:13:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, f049c037-5a73-4cde-a964-4bc1a6fe53b2, 'Il a fini à la poubelle alors que d''habitude les gateaux sont mangés en 2 jours. Vraiment pas sucré, un goût bizarre... Je ne vous le conseille pas.', '2002-12-04T13:57:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 1543c1ef-db2b-46fa-8754-501a4fb10f62, 'Très bien, mais un bémol pour la rédaction trop imprécise de la recette qui est certainement responsable des mauvaises notes de cette recette: en particulier quantité de lait, il en faut très peu, juste assez pour faire fondre le chocolat et si vous le choisissez corsé, votre gâteau aura suffisamment gout de chocolat! 20mn de cuisson suffisent et vos obtiendrez un délicieux cake, pour le goûter par exemple.', '2002-12-02T18:05:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, c973d09d-7d12-4713-b71d-19a960ddb457, 'Avec une amie,nous avons testé la recette, malgré les avis défavorables! Le gâteau à un aspect très peu esthétique et le goût l''est tout autant. Mais on a bien rigolé!', '2002-12-01T15:48:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 9e999b67-c05d-431c-a344-33753c35e054, 'Ce gâteau ne sent pas assez le chocolat, pas assez la cannelle, pas assez la banane... décevant.', '2002-12-01T12:09:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 24e93207-e8d3-4faa-8a81-17f9a5bd211e, 'J''ai reçu cette recette dans mon courriel et après avoir lu tous les ingrédients (très peu et c''est bien pratique!!!) je me suis mise au fourneau.... Un délice!!! et puis quelle facilité...  besoin de peu de temps, d''ingrédients, avec un gout exquis (la petite pointe de cannelle est géniale!). Mes collègues ont trouvé cet encas à leur goût et la recette est passé de main en main ravissant surtout les mamans face à ce gâteau  aisé à faire avec les enfants...', '2002-11-30T17:55:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 751e8194-0e40-4567-b7bb-eaa7dac5e178, 'Devant des avis si contradictoires, j''ai été tentée d''essayer cette recette. Même mon chien n''en a pas voulu... Il y a d''autres recettes de gâteau au chocolat léger sur Marmiton, qui sont délicieuses.', '2002-11-28T17:24:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 5f0adeac-2e25-4c61-a540-16f6d90acecf, 'Le gâteau est sans goût ... Si, celui de la farine! Sinon il fait une bonne présentation et ravira surement celles qui sont au régime.', '2002-11-27T19:15:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14160, 0b90221a-e09d-429c-9343-ea3ffd7bcbda, 'Pour les vrais amateurs de bonne cuisine, un seul adjectif pour décrire la recette: catastrophique.', '2002-11-27T13:56:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42620, f51f142e-ad0d-4ca4-89b2-df83619e6945, 'Bravo pour ce shake sans produit laitier, très bien, car je n''ai pas le droit d''en consommer beaucoup, (du lait) ainsi j''étais ravie de trouver cette recette. Merci beaucoup!', '2008-01-16T23:06:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42620, 63b483b0-478b-4317-8404-181174cb3270, 'Je ne mets que 2 car je ne vous pas l''intérêt d''un milk shake sans milk??!! Je pense que la recette appartient à une autre catégorie.', '2007-08-29T16:34:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45924, 2fbd4bd4-6b3c-4f37-8435-614fb7c8004f, 'Délicieux', '2015-10-09T12:31:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45924, 9cdb4bd0-2c86-4dbd-8b9f-f4b3fc433e02, 'Très bonne idée !', '2013-10-09T23:47:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45924, bba2923f-4140-4a87-b84e-8cd2e9014db8, 'Je modifie un peu : biscuits au fond de la coupe, arrosés d''un peu d''alcool et/ou de liqueur, ensuite fruit et crème, surmonté de noisettes / pralin et chantilly. Rapide et délicieux!', '2008-10-19T15:40:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45924, 48f78dfe-d8dd-46ec-bae7-8dfaa9e5012b, 'Je le fais en verrines, en mélangeant les genres sur une grande assiette, c''est aussi beau que bon!', '2007-08-18T13:10:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45924, 8ed520da-d6bb-48cd-9689-3dd0d2cf9dd9, 'Bonjour, dessert super facile à faire, mes invités ont été ravis.... et très rapide !', '2007-07-25T13:08:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45924, 3c79f666-e112-4833-ad9b-6a1d5eed030b, 'J''adore cette recette! Elle est simple, rapide, et étonnement délicieuse! A essayer d''urgence.', '2006-08-30T00:46:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46077, 16277b3e-1fbd-469f-92ec-9c01a874c84f, 'J''ai suivi les conseils et remplacé l''huile par 100g de beurre, d’emblée le gâteau semble compact mais il est moelleux à souhait ! Je l''ai refait en mélangeant farine et farine complète et en mettant du sucre roux et du muscovado pour sucrer, ça marche aussi. Je l''ai mis en programme gâteau (1h45).', '2019-06-27T22:19:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46077, fd7ffb7f-b4da-4f16-bcd8-6890e9569799, 'Super recette ! Gâteau moelleux et délicieux ! Pensez juste à mélanger la levure chimique à la farine en fait car sinon la levure peut faire des agglomérats et quand on tombe sur un morceau de levure bof bof !', '2013-05-17T21:50:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46077, cf15bc0c-a4d3-4a33-956a-865882e5b241, 'Excellent, rien à changer. J''ai juste ajouté un peu de cannelle pour parfumer davantage. Tout le monde a adoré.', '2012-09-11T00:50:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46077, 131eac5a-d572-4be9-8481-94a6eca9ce7b, 'Tellement bon qu''un bout de choux de 3 ans qui n''aime ni les bananes ni le sucré en général, a mangé 4 parts !', '2012-02-05T20:00:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46077, af1a55f2-90c6-4acf-bebb-36f81194856c, 'Merci pour cette recette, je la garde! C''est moelleux et très bon. ', '2009-09-04T01:28:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46077, 6a70a4d5-bbe0-42fe-b4f5-6af8b858aeac, 'Très bonne recette, gâteau moelleux et excellent. J''ai prolongé la cuisson de 20 min (le programme gâteau de ma machine  cuit pendant 50 min). J''ai mis moins d''huile (150ml) que recommandé. Peut être faudrait il préciser pour certains qu''il s''agit de levure chimique et non de levure de boulanger dans la recette.', '2009-03-29T16:14:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46077, ab167bb0-1cd2-49f4-9535-aba6bfbedd6c, 'Ce gâteau est délicieux et moelleux, parfait pour bien commencer la journée. J''ai mis 100 g de beurre à la place de l''huile et les bananes en même temps que les autres ingrédients. Merci pour cette recette.', '2008-09-25T15:57:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46077, 6363126a-c446-4d9a-a819-cdd9bbdf9585, 'Je regrette d''avoir fait tourner la machine à pain pendant 3 heures pour ça... Le produit est compact, bien trop gras, porteur d''un fort goût de levure. A oublier...', '2008-04-24T23:04:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46077, 7436a4d5-7d12-44fb-8900-229d5cc7c0e7, 'J''ai ajouté aux ingrédients de base des pépites de chocolat et citronné les rondelles de banane pour éviter l''oxydation. Cependant, le résultat me paraît compact et farineux, par rapport à un gâteau cuit au four. Il y a sûrement des améliorations à apporter.', '2006-04-13T21:34:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (232586, 04e71df7-ed6b-439a-a819-e6692382b769, 'Frais et plutôt léger ! J''ai pris des oranges à jus et j''avais peur que ça soit trop liquide mais pas du tout ! Pour les proportions ça fait un verre normal par personne. Je mets 4/5 à cause de la texture un peu granuleuse à cause de l''orange. ', '2015-08-08T20:43:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (232586, 0e0cf80c-83fe-4d84-a1c8-4f75017bc1ab, 'Excellent !!!  ', '2014-04-16T20:27:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (231425, 19556a8f-3331-4d05-bd66-70d8568a8683, 'L''idée était bonne pour faire mes fins de placards, mais j''ai trouvé le résultat bien trop farineux à mon goût. Je retenterai avec moins de farine ou + de banane/orange (et moins de sucre, j''ai mis 50g et effectivement j''ai trouvé cela trop sucré). Pour ce qui est de la cuisson, parfait pour moi avec 20mn à 180°C. Merci pour cette recette !', '2014-03-05T21:37:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20433, 29712972-2cf8-44fb-b5bc-37c0668700b0, 'Ma référence depuis 3 ans! Je viens de retrouver la recette d''origine. Cette tarte est délicieuse, mais réalisée sans les noix, car trop lourd sinon. 2 ou 3 bananes max, rondelles posées sur le fond de tarte. Les rondelles sont alors recouvertes du chocolat. Délicieux !', '2006-07-04T00:07:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20433, 6bbe5a8d-3781-4e15-b864-842ffe1db638, 'J''ai mis 10 minutes pour la cuisson avec le chocolat, un peu moins de chocolat et de banane. Il est vrai que cette tarte est difficile à servir correctement, mais tout le monde l''a adorée. A éviter après un repas très riche.', '2005-02-18T01:36:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20433, 0e1c4442-60f1-4d80-a4f2-ddb16e45b274, 'Désolé, mais la texture du chocolat est horrible, les proportions à revoir, le temps de cuisson trop long... Cette tarte n''est pas très présentable et son goût pas très fin.', '2003-02-02T18:21:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 27769478-22df-4fa6-bc7a-9c70a78e54e0, 'La recette, au vue des quantités, me paraissait un peu trop douce, du coup, j''ai mis seulement 200 ml de crème de coco (je n''avais pas de lait de coco) et incorporé de l''eau à laquelle j''ai ajouté du fond de veau dégraissé.
Au lieu de l''ananas, j''ai mis une pomme, des carottes et en fin de cuisson, 2 courgettes.
J''ai fait revenir mon sauté de veau à part, afin de bien le dorer et l''ait ajouté au reste en récupérant tout le jus, évidement.
J''ai utilisé de la pâte de curry rouge (25g) et fait griller à sec les noix de cajou dans les sucs de la sauteuse ou j''avais fait dorer la viande.
Je les ai rajoutées en fin de cuisson.
Du riz basmati en accompagnement et ce fut tout à fait délicieux.', '2018-02-28T07:02:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 91011f8a-8b49-4f4a-b28f-1a5adca4ea55, 'Contrairement aux autres, j''ai ajouté encore plus de curry. J''essaye depuis longtemps de faire des recettes indiennes et pour la première fois je trouve que ça se rapproche beaucoup des plats des restaurants indiens.  Merci beaucoup pour cette recette.', '2012-12-24T13:16:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, ca83d717-a4be-4875-bafa-1a171958ef57, 'Bonne recette, j''ai mis du curry en poudre " à l''inspiration" et sans mango chutney j ai mis du chutney de figues.  Selon les conseils, j''ai ajouté les raisins secs ré-hydratés dans du thé,les noix de cajou et l''ananas 20 min avant la fin de cuisson. La cuisson elle a été faite en 2 fois, la veille le temps annoncé dans la recette et le lendemain, 20 dernières minutes. ', '2013-10-06T14:09:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, b60cb97c-2354-4ee4-ad5b-ab783dbb5134, 'Petit truc donné il y a bien longtemps par une amie anglaise : plusieurs cuillerées de marmelade d’orange versées dans le mélange épices/viande en début de cuisson. Servir le chutney à table comme condiment.
Toujours préférer la pâte de curry vert ou rouge à la poudre et la faire bien “cramer”avec les oignons.', '2022-04-19T12:01:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 284cebfe-e54a-4c2d-b56a-d03465a9aaa8, 'Pour moi 50 g de curry c''est mille fois trop, j''ai rajouté 3 packs de 200 g de lait de coco et ainsi c''était délicieux. Bien vérifier le grammage du curry.', '2015-02-21T17:58:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 4aaf59a3-b2ed-40ff-b414-a735befb7340, 'Excellent ! Je fais revenir l''ananas dans du beurre jusqu''à ce qu''il soit doré et prends des bananes plantains (coupées en rondelles fines et revenues à la poêle dans de l''huile)... Pour le reste je suis la recette à la lettre !! Mille merci pour cette délicieuse recette.', '2014-12-29T22:56:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, b1520ff6-51ea-440c-a0dd-dab61e076440, 'Tout simplement excellent, je n''ai pas mis de mango chutney, j''ai mélangé l''ananas dans le mélange 20 minutes avant la fin de la cuisson, servi avec du riz thaï. Facile à réaliser, à refaire sans modération.', '2012-02-24T21:20:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, a63bd341-1ffd-46a6-8d79-b51c15af45d9, 'Absolument EXCELLENT ! MERCI ! Mélange explosif de saveurs en harmonie. Par contre, j''ai procédé autrement pour l''ordre de cuisson : oignon émincé à sec pendant quelques minutes, ail + gingembre + huile olive. Puis veau. Puis curry. 1 courgette verte 1 courgette jaune en petits cubes. 1 carotte orange, 1 carotte jaune. Saisir le tout. Puis lait de coco, tomates, raisins longs, ananas frais (surgelé héhé). Mijoti-mijoton. Le chutney de mangue. La banane 30 min avant de service. Riz basmati + safran. Miam !', '2011-11-05T10:19:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 2c3445b6-bd09-4d70-a5a1-571270281dc8, 'J''ai mis un tout petit peu de curry en moins et j''ai ajouté de la mangue fraiche en morceaux dans un bol avec les autres fruits. C''était tout simplement délicieux et très sympa avec tous les bols de divers fruits : fondants, craquants, plein de saveurs différentes, un régal...', '2011-04-03T00:57:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 5fdea47c-9b2d-47e5-a7d4-3483405a2991, 'Extra ! Et facile à préparer. Mes invités ont "léché" le plat. J''ai mis l''ananas frais (Ananas Victoria de l''Ile de la Réunion, très gouteux !) et les raisins secs directement dans le plat les 20 dernières minutes de cuisson, ainsi que les noix de cajou. Accompagné d''un riz basmati parfumé au Safran d''Iran, c''est une merveille. Merci pour cette recette, qui va entrer dans mes classiques. ', '2009-01-30T15:42:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 7471c93e-f866-4647-a348-6428c9adf5a0, 'Bonne recette de curry. J''aurais aimé savoir quel chutney était  préconisé. Servi avec du riz thaï comme conseillé. Nous avons bien aimé ce plat. Merci.', '2021-01-02T16:46:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 292cec03-9c19-4d23-8fb0-56754cb2aee1, 'La sauce de ce plat fait perdre toute la finesse du veau. Alourdie par le lait de coco, elle laisse en plus une désagréable sensation grasse en bouche. Ceci étant, ce n''est que mon avis donc bon appétit !!!!', '2016-11-24T15:19:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 40cccd7c-c068-46eb-95e6-bdd87d6570d6, '100 g de riz par personne c''est trop - 60g suffisent. Mais la recette de curry de veau est parfaite. J''ai mis un peu moins de curry cependant.', '2015-09-05T19:02:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 6eb0b9f2-da2e-46e7-a4b7-3022ed4cb61a, 'Recette simplissime. Je l''ai suivie à la lettre. Tout le monde a aimé, c''est vrai que ça se rapproche beaucoup des saveurs de resto indien. Adoptée !', '2014-11-26T17:02:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 29dc9225-8a01-4a28-b5b2-71a49bd61940, 'Tout le monde était agréablement surpris, c''était vraiment très bon. J''ai mis de la pâte de curry verte, attention à ne pas en mettre trop ça peut vite être très fort !', '2014-09-24T20:27:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 440847d7-1e1d-4343-98f6-10d98d3b9353, 'Succès assuré pour un repas entre amis, c''est convivial, savoureux, un incontournable, merci pour cette recette !', '2013-02-19T23:23:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 07427892-083f-4c19-a8d2-c609c2d4c077, 'Excellente recette. Mon invité a aimé, en a redemandé et en redemande. Je ne pensais pas qu''elle aurait tant de succès. Nous étions deux, j''ai alors réduit les portions par quatre. Merci.', '2012-01-23T21:16:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 69450984-9875-41b0-a948-bdc0eff1b13e, 'Souvent je prends des idées ou des recettes mais je ne prends pas le temps de poster des commentaires ; pour cette recette qui a enchanté tout le monde, je mets un 5, mais par contre, comme beaucoup, j''ai mis moins de curry et de gingembre, de l''ananas frais au lieu de la boite, et les noix de cajou que j''ai mis 20 min avant de servir, (pas banane, ni de raisins, histoire de goût...) à refaire, surtout que l''on peut la faire à l''avance, c''est encore meilleur.', '2011-10-04T11:26:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 9d0952bb-087c-4331-b8a3-53cff986c79f, 'Excellente recette, un grand bravo. J''ai fait du veau pour la toute première fois de ma vie et ce fut un réel succès. Délicieux !', '2011-02-13T16:59:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 019425c6-2797-4c0f-86aa-b08d65b65223, 'Très agréable recette... j''ai tout divisé par 2, ajouté les petits raisins secs et qq rondelles de bananes en fin de cuisson pour donner un petit goût salé/sucré... Très réussi ! Je pense que les 50 g sont à appliquer à du curry en pâte, j''ai mis du curry en poudre à "la louche" et ça fonctionne très bien aussi...', '2010-02-16T14:38:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, e44fb885-6378-4306-aa63-811615c5938f, 'Excellent! succès garanti! Comme d''autres, j''ai fait mijoter plusieurs heures et la viande était super tendre. J''ai également mis moins de curry que ce qui était indiqué. C''était délicieux, facile à préparer en grande quantité. A retenir!', '2010-02-07T15:54:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 26fc9dce-e046-4962-aa19-89a34863a13e, 'Je n''avais ni raisins ni bananes ni gingembre !! 1 cuillère de crème fraiche en fin de cuisson, servi avec un flan de légumes !! Très très bon, merci !', '2009-08-12T17:06:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, e6cfffb5-98cd-47d1-832b-6b626d457eba, 'excellente recette tout le monde a apprécié, moi j''ai mis un peu moins de curry et de gingembre à refaire ', '2009-06-22T13:44:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, c1a08777-8ee5-4eb5-9c8f-45ec6a029927, 'Très facile à réaliser et très bon même sans le mango chutney. Mes invités ont apprécié.', '2008-10-26T21:37:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 7df5d45b-35df-4c06-8668-c23d8440e5cc, 'Facile et délicieux, comme j''aime!', '2008-09-14T18:24:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 5a38e791-e552-4e09-bcd3-c08118b21c5c, 'Pour les pressés, on peut aussi faire cuire l''ensemble à la cocotte, comme pour une blanquette... Evidemment, plus ça mijote, plus c''est tendre, mais quand on n''a pas de temps devant soi, c''est pratique. Très bon ajout, la cannelle :-)', '2008-08-25T15:18:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, ba08d8a0-c171-4c07-b583-53954e1563d0, 'Exquis!! J''ai ajouté de la cannelle et des raisins secs pendant la cuisson, un vrai délice! A faire et à refaire!', '2008-08-11T15:24:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, a5a4a9f5-dc0d-4fdd-9c99-87a23d0ac933, 'Très bon. J''ai fait mon mango chutney car je n''en trouvais pas en magasin, j''ai mis 25 g de curry. Par contre j''ai préparé la veille cuit 1h30 et j''ai remis à chauffer le matin à feu doux pendant 2 h, la viande fondait en bouche..... ', '2008-04-30T22:57:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 44582832-c4be-4025-82cd-3f2b340b8821, 'Vraiment délicieux, mais diminuer très légèrement la quantité de curry pour être du goût de tous et je l''ai fait 24 heures avant il n''en était que meilleur...Je l''ai également testé avec du porc, mais la viande est un peu trop "sèche".', '2008-04-20T20:17:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 790442f9-1d5d-440b-a8a7-c7aaf026a7a0, 'Ne pas hésiter à le préparer à l''avance, meilleur il sera. Par contre beaucoup trop de curry, commencer par 30 g et puis compléter à son goût. En accompagnement pour changer du riz, les petit muffins aux légumes de marmiton vont très bien aussi.', '2008-03-31T22:29:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 8026f939-999d-4f86-96ac-89f488445b87, 'Extra!!! rapide à préparer (reste quand même à cuire...) et excellent à manger, un très grand succès !!!! Par contre un riz tout simple suffit à un riz saffrané, le curry l''emportant largement niveau goût .', '2008-03-19T10:55:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, e8f3ad3f-eb81-4f4a-a0c4-4394d2843e94, 'Un régal ! Cette recette est parfaite. Une bouchée et elle vous fait voyager !', '2008-02-06T13:37:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, d9a5dbd2-963c-46d6-b214-aa8c7b9143c5, 'Excellentissime. Non vraiment rien à changer. Evidemment c''est un curry donc évidemment c''est epicé. Fait la veille et réchauffer une bonne heure avant le repas. Il n''en reste rien !', '2008-02-06T10:43:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, f00e3689-d5bd-4db3-9ac3-d05ad8141114, 'Génial!!! Et surtout laissez mijoter longtempts car, plus ça mijote, meilleur c''est!', '2007-11-14T21:16:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, cf118d20-9b80-4088-b0bb-bde79c08328c, 'Mmmmm, un pur délice, même sans le mango chutney.', '2007-09-29T21:31:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 3fa33db9-f219-4067-a2a0-e0195b42b618, 'A mon avis il y a trop de curry. J''ai fait la recette pour 4 donc divisé les quantités par 2 et 25g de curry c''est la moitié d''un verre à moutarde. Je trouve que ça masque le lait de coco et la sauce chutney. Je réessaierai en divisant le curry par 2 ou 3. Le reste est parfait!', '2007-09-23T13:40:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 6e3782d6-80ef-4fd2-8a16-558798affe65, 'J''étais sceptique, en voyant qu''il fallait mettre le chutney, directement dans le plat, mais c''était parfait!', '2005-09-22T00:37:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, 842a42fd-db2e-4258-a157-5288bdd9b5ac, 'Génial! Je l''ai fait pour mes huit invités, il n''en est pas resté une miette! Ne pas hésiter à laisser mijoter longtemps tout doucement. Les invités ont adoré l''idée des petits plats d''ananas, raisin secs etc à rajouter. Je conseille vivement à tous de faire ce plat succulent.', '2005-02-06T23:04:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12265, d3ff5d98-4ed6-46c7-b4cc-a4a99ee3dcfc, 'C''est à la fois bon, simple et ludique avec tous les petits ingrédients à ajouter dans son assiette. Succès assuré!', '2004-07-06T13:58:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69360, aa30f51a-3d1e-49d1-988b-c820cd123527, 'Je n''attends pas que cela compote, et cela donne une coupe ananas/banane avec glace (rhum-raisin), Chantilly et noix de coco râpée. Rapide, pratique, et bon...', '2020-06-24T13:39:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (341935, e5d3903f-a57a-491c-9b2e-bad2b16abd13, 'Très bon gâteau, assez sucré, recette très gourmande', '2020-05-15T21:06:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (341935, 473e8075-d507-4d72-88a4-c618556ab036, 'Gâteau délicieux, pas trop sucré pas écœurant pour moi qui mange moins de Nutella que les enfants. Nous l''avons dévoré à 4. Par contre les deux couches ne se sont pas mélanger à la cuisson (je m''attendais à ça vu la photo) , mais ça n''a posé aucun problème c''était vraiment très très bon.', '2018-11-01T05:26:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (341935, 2461381d-a577-4e8d-9373-0fadcf6a5009, 'Trop léger à mon goût.. ', '2017-05-18T20:17:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (341935, 9365424f-fc07-48f1-ba3a-e9a3133d5870, 'Gâteau super facile à faire, très bon, je l''ai juste fait sans les bananes qui est tout aussi bon d''ailleurs ! A refaire ', '2015-11-20T15:18:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56705, d1b8d609-3d84-47ba-af74-33390c149043, 'Excellent et pas trop sucré !', '2018-03-01T17:02:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223605, ae93838e-fab8-4c80-ba4a-8fcf455d9ca5, 'La recette de base des muffins est assez bonne, quoique pour 6 muffins il faut doubler la dose de farine et 20 cl de lait, sinon pas assez de pâte. Le fondant en revanche n''est pas terrible : le mariage crème fraîche / banania n''est pas très heureux et surtout ne tient pas du tout à la cuisson! Le chocolat s''échappe de la pâte si bien qu''on ne retrouve pas de fondant chocolat au milieu. La cuisson de 15 minutes est trop courte, il faut doubler pour un four à chaleur tournante. Je ne referai pas cette recette.', '2016-05-02T13:22:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223605, 94554369-e373-4974-a887-17848a943596, 'J''ai pourtant suivi la recette mais mes muffins ne ressemblaient à rien ! Le muffin a cuit par dessus le chocolat qui lui a coulé tout au fond du moule... En les retournant j''ai réussi à faire croire que j''avais exprès de faire des "volcans". Je ne sais pas ce qui s''est passé mais en tout cas au goût c''était très bon !', '2014-10-08T01:34:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223605, e5769cc0-18fe-49cd-a05f-deb0a5a9a061, 'C''est vraiment délicieux je recommencerai. A l''école ils se sont régalés ', '2012-06-27T10:27:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, eecfbd58-089e-4fcb-99ba-f82dc5653f0b, 'Cette recette est surprenante... Mais au bout de 2 à 3 cuillères on se fait au goût ... C''est bon mais nous ne mangerons pas tout. Merci !', '2014-07-07T18:27:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, 0bf5ee3b-e95c-49b9-811b-f07733b725ff, 'J''avoue que pendant la préparation, j''étais un peu dans l''appréhension. Mais le résultat ne laisse aucun doute... Un délice ! Un velouté sucré salé onctueux... Une recette à garder.', '2013-02-23T21:11:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, 6eb6dd72-a0dd-4c97-ab3f-19a8c9144de0, 'Très bonne recette, peut être juste un peu plus de lait car très épais.', '2013-01-17T14:09:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, fae1567f-eb1d-4cd8-a913-9383687e26ee, 'Il faut agrémenter le visuel mais sinon c''est plutôt bien !!', '2012-09-05T20:15:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, 35cc7213-2389-4ee8-ab64-2293fe1f19e6, 'Délicieux ! Soupe au goût légèrement sucré et de consistance mousseuse lorsqu''elle est consommée juste après l''avoir passée au blender. A refaire !', '2012-08-24T15:57:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, 19f66cc5-552f-4230-afd3-8be6326bbcfe, 'Nous n''avons pas du tout aimé, les enfants également. Le mélange courgettes bananes laisse une texture à la soupe pas du tout agréable...la soupe a fini dans la poubelle (ce qui n''est pas dans nos habitudes !!!)', '2012-08-15T23:28:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, ee8bb200-6807-42ad-93e4-7cdc9af047da, 'Je viens juste de tenter cette recette, un peu méfiante, et finalement : super! Mon fils de 3 ans et demi et moi sommes ravis, et mon homme réticent à tout ce qui ressemble à un légume a même apprécié le goût !', '2012-01-08T20:38:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, 00549f95-a88a-4c2e-9830-3b25bb8fdc0d, 'Très bonne recette. Attention au cumin car il donne beaucoup de goût. Meilleure à manger le lendemain.', '2006-09-27T22:28:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, 9727c667-06a1-4507-84a8-f006c87bb751, 'Recette très spéciale, que nous n''avons pas su apprécier.', '2006-07-29T16:19:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, 58752a30-df1d-4862-b93a-0bf38024e81c, 'Vraiment très bon, mon mari et moi avons beaucoup aimé. J''ai respecté à la lettre la recette, mes enfants en ont mangé sans problème (sans être aussi enthousiastes que nous, ils ont rajouté de la fleur de sel!). Recette facile, inrattable, à refaire. Merci.', '2006-05-20T20:47:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, 82ba98fa-229f-4946-95f2-11430ab19635, 'Soupe très gourmande à faire en un clin d''oeil!', '2006-05-08T22:56:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, 374ac61d-eee1-4656-a190-60694c7035ea, 'Très bon et très nouvelle cuisine. ', '2006-02-20T22:46:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, f20e1121-d6da-4612-94d9-b1c381a0efba, 'Nous l''avons trouvée absolument délicieuse... Et nous avons couru le risque d''avoir des invités... Tous unanimes... Cette soupe est délicieuse, épatante, etc... hummm... Merci à vous!!!', '2005-12-12T08:39:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, 83750173-632c-4622-8716-4490685cb751, 'Nous, nous trouvons cette soupe excellente... telle qu''elle est décrite...', '2005-12-05T22:10:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, 99abf8fe-d99a-40d0-87db-0830425531ea, 'Je n''ai pas du tout aimé: trop lourd, le mélange ne va pas du tout bien ensemble! Je le déconseille !', '2005-11-03T14:19:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36090, 6c062e0e-01b1-4833-994a-6a20f35bdb91, 'Je trouve que la cougette ne se marie pas avec la banane. La soupe n''a pas bon goût.', '2005-08-24T14:51:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12127, 4dd3849b-434c-45a9-8690-980e07ee1c3c, 'Décevant... C''est bon car tout ce qu''on y met est bon, mais il n''y a vraiment rien de spécial...', '2005-01-28T13:43:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, 69d87ce2-226d-475d-b6ee-85dc2c3d444e, 'Très bien. J''ai utilisé des boudoirs donc je n''ai pas mis de sucre dans le sirop et j''ai réduit le sucre à 100g au lieu de 150 pour que ce soit un peu plus light. Par contre le chocolat avait vraiment durci, et c''était un poil "génant" pour couper, alors lorsque j''ai refait cette recette la deuxième fois je l''ai remplacé par de la mousse au chocolat maison !! Et du coup j''ai essayé dans des verrines, succès assuré!', '2014-08-03T19:32:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, d08a6ccf-daa8-4cf9-9730-adf48306fd2f, 'Cette recette est arrivée droit dans mes recettes favorites que je referai à 100% ! Si vous êtes adeptes du mélange banane-chocolat ... oubliez tout, c''est encore meilleur ici !! 
J''ai mis très peu de sucre par contre. 50g je crois. Largement suffisant. Pour le rhum, j''en ai mis moins aussi. C''est selon les goûts !', '2019-03-20T06:41:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, 2838b435-9244-41ce-8760-f1c0bd3d921c, 'Cette recette est pour moi un classique qu''on me redemande ! Je râpe le chocolat et j''en garde toujours un peu pour la déco du dessus. C''est un vrai régal !', '2014-05-26T12:13:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, a7ffdebc-bf09-4281-ad2b-28abbb615203, 'Un plat entier dévoré un clin d''œil merci pour cette association pourtant classique (banane Choco) je n''aurai pas eu l''idée d''en faire un tiramisu ! Les enfants me le réclament déjà et je deviens la meilleure maman. Seule remarque je l''ai laissé prendre toute la nuit et non 4h. Merci encore', '2014-01-21T21:19:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, 1c7b9b5f-80ba-4b32-88e2-991f43dc90d9, 'Je l''ai fait 2 fois. La première fois, je n''ai pas trop aimé avec le chocolat fondu, ça faisait de gros morceaux de chocolat une fois bien refroidi, bref... Pas très agréable en bouche. La 2ème fois, j''ai râpé le chocolat... Alors là ça change tout! Les parfums se mélangent mieux, on s''est tous régalé et on m''a demandé la recette.', '2005-11-18T09:21:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, 3ff36c8e-b09d-4848-8308-4232d90cf23c, 'Délicieux, personnellement au lieu de m’embêter avec du chocolat, je mets du cacao en poudre et c’est tout aussi bon !', '2022-08-22T20:30:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, aa750698-d15d-4a5e-9c86-59d160012cac, 'Bonne recette mais pour ma part un peu trop sucrée, malgré avoir déjà diminué la quantité de sucre. Mais à part ça, top ! ', '2019-03-25T04:37:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, abf03285-cc21-4411-9331-455d0e96118a, 'Juste parfait ! Merci pour la recette. Moi j''ai juste remplacé le chocolat par un caramel au beurre salé !! Hmmm ', '2017-02-13T13:00:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, b7939b29-5507-419f-8df4-34f2f57b3685, 'Super bon j''ai même fait une variante en remplaçant le chocolat par du coulis de framboise et des morceaux de framboises par dessus et ça se marie très bien avec la banane.', '2012-01-25T10:18:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, 09b27a5c-ee86-4d3d-acf1-60998c7cd18f, 'Waou !!! Et hop voici une recette qui est devenu  un classique !!! J''ai juste coupé le chocolat avec un peu de crème. Pour changer, j''ai fait un sirop à base de chocolat et lait chaud avec une pointe de cannelle... hum !', '2010-06-22T00:15:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, ab7b3b04-ba88-41fb-8591-7ae776ecbf89, 'Juste un mot: excellent!Je l''ai fait deux fois de suite,j''ai trempé les biscuit dans du cacao et râpé le chocolat.Merci pour cette recette.', '2009-03-27T16:51:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, e782a8b3-be1f-4fb3-9437-20145a983b63, 'Ce tiramisu est tout simplement délicieux. La 1ère fois, je l''ai fait avec le sirop de rhum et c''était très bon, la 2nde fois, j''ai fait tremper les biscuits dans du lait chaud avec un peu de cacao et c''était encore meilleur!!! Rapide et facile, c''est un dessert imparable et léger !', '2007-11-02T17:16:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, 396bb346-a6b8-4917-bc3a-19ee4f88d9ea, 'Sympa ... attention, le chocolat se fige, ça fait comme des petits carrés de chocolat.', '2007-08-29T13:09:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, e7ad398d-2577-4eb6-bf36-ea963572a9a2, 'Très bon mais trop sucré même avec seulement 100 g de sucre. Pour le chocolat je pense qu''il vaut mieux effectivement le râper car ça fait des gros morceaux durs. Sinon très bon dessert qui change du tiramisu habituel.', '2006-09-27T21:34:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, efd30f4e-7c33-414a-960c-de09c6a32765, 'C''est vraiment trop bon. Servi lors d''un repas de famille du dimanche midi après un plat de lasagnes maison et bien pas écoeurant du tout. Ceux qui n''aiment pas le tiramisu en temps normal adorent car c''est complètement un autre dessert avec ces ingrédients. Merci pour l''idée de ce mélange.', '2006-02-06T13:57:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, b9540a4a-adf7-4676-b4c9-833d74279076, 'Très très bon ! Le chocolat a durci mais ça m''a pas dérangé plus que ça étant donné que j''en ai mis moins que dans la recette, pour le sucre aussi j''en ai mis moins à peine 20g et c''était parfait, pas du tout écœurant. Je referai cette recette sans hésiter 😋', '2023-07-06T20:35:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, f2c0d5b2-34e3-46fa-8590-3c177d9ca235, 'Après lecture des commentaires, j''ai préparé une "sauce chocolat" (avec un peu d''eau et de crème) pour qu''il ne durcisse pas, et par gourmandise, j''ai fait flamber les bananes... tout le monde a adoré.', '2022-04-18T20:12:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, 8d096b11-e52f-4775-911f-f8eee4502ef7, 'J''ai fondu mon chocolat  façon Tupp, j''ai laissé  assez d''eau  pour que le chocolat soit  liquide  ,et j''ai mis que 80 gros de sucre ', '2022-01-10T11:46:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, be0734b1-d768-47a1-b92f-23cbc5cbe70d, 'Super recette! Fait en portions individuelles. J''adore', '2020-05-07T23:02:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, b5539d52-8d6a-42eb-b1fa-64aeaad8bf7e, 'Super bien à faire !', '2020-05-01T14:40:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, 0d8941b4-73ce-4869-969a-14a6518e9deb, 'Bonne recette  je l''ai juste faite en version verrine', '2019-04-28T09:29:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, 4f9e4839-ae97-4038-bb53-b630962efd79, 'Un régal !  !  !', '2019-04-22T16:11:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, c79544e8-de64-4d55-a83b-d2df5e05969e, 'Super bon !
Mes invités, petits et grands, ont tous adoré.
Je vous le conseille vivement.', '2019-03-29T08:14:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, 353bcd0e-5e9b-4734-9498-adde27134196, 'Très très bon. Par contre le chocolat se fige en plaque lorsque le gâteau se refroidit.
', '2019-03-24T07:28:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, 7b9c1dd6-e18a-424d-ade1-d20a3b3634c4, 'Très bon tiramisu à condition de réduire le sucre. Pour éviter l''aspect trop dur du chocolat, j''ai utilisé du chocolat liquide du commerce. Petits et grands se sont régalés.  ', '2015-08-25T22:28:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, 65edab7b-8d4f-4f35-aad0-62e6c2804af8, 'Pas mal du tout ! Par contre le chocolat a durci. ', '2012-09-05T21:16:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, b39bd497-bfb6-4e96-937d-cb4a93df2c08, 'Miam miam, un régal ! Je referai, et merci encore pour cette recette !', '2010-05-05T10:09:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, d21e067b-4ef5-4904-bbc6-4d6d1d2e8770, 'Excellentissime, j''ai juste mis des copeaux de chocolat plutôt que du chocolat fondu pour alléger la consistance. Mon amoureuse a également adoré. Merci.', '2007-04-07T23:55:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, 70760d5c-4f2b-4110-860f-b7c7a2cf408d, 'Trop sucre, très gras, j''avais déjà mis moins de sucre que dans la recette,  je suis très déçue, je ne pense pas réessayer, ce serait trop d''experiences pour arrive à quelque chose de bon, autant inventer sa propre recette.', '2007-01-31T20:12:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, cd0f0509-e203-4cee-bfdb-c6cf62a59d88, 'Pour ne pas que le chocolat fasse de gros morceaux le faire fondre au micro-ondex le chocolat coupé en morceaux + crème fraîche liquide ou lait à l''oeil!!!', '2007-01-29T10:18:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, ca08e701-b3ac-446a-a00a-6df4b598cff2, 'Très bon mais très sucré...je l''ai refais et cette fois-ci sans sucre. Les biscuits à la cuillère étant déjà sucrés, c''est meilleur. Je n''ai pas mis de rhum.', '2006-11-26T15:27:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, 984ef541-5d6b-41f5-aa86-ce414a44a8bc, 'Très bien! D''ailleurs, je crois que je vais aller en manger encore un petit bout !! Facile à faire, pas de cuisson, assez rapide et surtout excellent. Tout le monde a apprécié. Seule petite chose: un peu trop sucré, la prochaine fois j''en mettrai un peu moins...', '2006-04-02T19:10:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, fa9c65a0-7c0b-46a7-857d-d479dce18d5b, 'Très bon dessert. (Un peu trop sucré à mon goût..., la prochaine fois je ne mettrai que 100 g de sucre et un peu plus de rhum.) Tous mes invités ont bien aimé! A refaire... ', '2006-03-13T14:51:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40008, 9bf005ab-a86b-4805-b8e1-8dd82be56aff, 'Très très bon! Très frais et léger après un repas assez costaud. A été très apprécié par mes invités. A refaire encore et encore !', '2006-02-19T20:19:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, a2bf92db-b836-4172-a220-2ccafa2340b3, 'Très bon gâteau, même si j''ai eu quelques problèmes de cuisson : ça a cuit un peu trop vite si l''on suit les indications, donc j''ai baissé un peu la température et du coup le dessus et les côtés ont un petit peu brûlé... A part ça, moi aussi j''ai monté les blancs en neige (résultat bien meilleur qu''un simple gâteau au yahourt) et j''ai mis 2 bananes et 3 pommes (coupées en dés, pas râpées).', '2010-03-09T17:28:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 16bc7e47-c520-4d4d-831b-7e39b77cc495, 'Superbe recette pour une élève de troisième qui veut faire de la cuisine plus tard 😉🙂 !!
Petit bémol mon gâteau n''a pas assez monté 😅 pourtant j''ai suivi toute la recette
Mais sinon plutôt bon résultat!j''ai hâte de goûter !!
Ps : je mettrai une photo.', '2022-05-29T20:44:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 4d17c8e0-01bf-4a70-a673-6557b249bf1d, 'Simplissime et bon. Au petit dèj ou au gouter ce bon gâteau régale tout le monde. Merci.', '2021-07-29T19:59:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 44ac4b34-5d84-42e3-b5ad-38cc9fa8847e, 'Super gâteau ! 5 cl d''huile suffit.', '2019-01-20T12:03:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 0e98583f-138e-45d7-8d34-ffbdcc9c653c, 'Alors la le four n''est pas du tout bien réglé sur cette recette ! mon gâteau est noir sur le dessus et pas cuit a l''intérieure .. j''ai du monde se soir en plus donc pas du tout présentable .', '2010-03-20T15:30:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 05ec551a-9208-4eb7-99c1-109b3d49192a, 'J''ai suivi la recette améliorée et j''ai ajouté ma propre touche au lieu des 180 g de farine j''ai mis 100 g de farine et 80 g de fleur de mais pour encore plus de moelleux...', '2010-02-03T09:37:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 2e4d896b-20b8-4852-bacc-898c269ea36c, 'Excellent gâteau. J''ai fait comme dans des commentaires précédents, j''ai mis un yaourt à la vanille, puis j''ai séparé les blancs des jaunes que j''ai montés en neige. Je n''ai mis que 5 cl d''huile. Le gâteau est moelleux et très bon. A refaire', '2009-09-05T16:17:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, a4744959-47b6-4513-9cb8-3a5db80100c0, 'Excellent! Rapide et facile. J''ai coupé les pommes en cubes, et ajouté un peu de rhum! Un délice!', '2008-02-02T21:04:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, f29eeab8-1c60-4eef-a4b8-31bd08536466, 'Très bon mais il ne faut pas trop mettre de fruits, sinon poursuivre un peu plus la cuisson.', '2006-10-26T17:13:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 6c976809-fe66-49c3-8f6b-eb9f040e5f35, 'J''ai fait ce gâteau, qui était très bon et rapide, maintenant je le ferais de temps en temps a ma famille, car eux aussi l''ont apprécié. Merci pour cette recette.', '2006-09-11T17:15:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 84eb64ee-8bd7-4b33-a086-d8ec822afb51, 'J''ai fait un mix de tous les commentaires donc j''ai quelque peu modifié la recette initiale: - j''ai ajouté un yaourt, j''ai mis 2 bananes au lieu d''une,moitié moins d''huile, 3oeufs au lieu de 4, j''ai monté les blancs en neige et j''ai ajouté une cuillère à soupe de bon rhum (Mathulasem). Pour la cuisson j''ai mis 30 min a th 7 et ensuite 5 petites minutes a th 6 et c''était tout simplement.. délicieux!! Tout le monde en a repris et en redemande.. et c''est si facile a faire.. A REFAIRE ABSOLUMENT', '2006-08-20T15:05:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, d2541011-0208-4ce9-a7ad-e4793f154f92, 'Très bon moelleux (avec le yaourt les oeufs battus et les fruits en morceaux). ', '2006-05-25T23:56:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 033cc746-950a-4de5-b413-6269296cb78e, 'J''ai trouve le gâteau très bon.', '2006-04-05T19:12:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, a1eecd60-cb4a-4420-9a3d-0bf2e0255573, 'Super! Rapide, simple et pas besoin de trop d''ingrédients.... J''ai mis un sachet entier de levure. Le gâteau n''était pas sec du tout. J''ai laissé cuire jusqu''à avoir une surface brune. ', '2006-03-12T19:48:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 9018a844-51ea-46cd-b0d3-42a34994e898, 'J''ai mis des morceaux de bananes et de pommes coupés, avec un peu de fleur d''oranger, très bon. Le gâteau est un peu compact mais a bien cuit, à 180°C pendant 40 min et après 160°C pendant 10 minutes supplémentaires.', '2005-11-22T18:46:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, d3777b30-803d-49c5-96d3-51abadde19c8, 'J''ai aussi battu les blancs en neige, mis quelques amandes dessus, c''est très bon!  Par contre pour la cuisson, j''ai rajouté 1/4 d''heure....', '2005-03-08T18:00:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 84feb889-e1dc-48b7-b1d0-80fb51521968, 'Original. J''ai ajouté un yaourt vanille et j''ai mis moins d''huile. J''ai mixé la pâte et à la fin, j''ai ajouté les pommes en dés et la banane en fines rondelles. Le gâteau cuit donne l''impression d''un gâteau flan.', '2005-02-22T10:22:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 3438e965-33ef-4f37-92e8-66401d39d91d, 'J''ai coupé les pommes en dés, rajouté un yaourt,mis deux bananes et battu les blancs en neige. Cela donne un goût plus sucré, le gâteau n''est pas sec, il est beaucoup plus moelleux.', '2005-01-31T17:07:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 27150bca-b820-45a5-9e4e-92903238ab36, 'J''ai coupé les pommes et les bananes en dés et ajouté un yaourt: cela donne un bon petit goût apprécié de tous. Cependant, le gâteau reste sec: je pense que thermostat 7 pendant 45 minutes, c''est trop élevé car le gâteau était très foncé, même en ayant baissé la température en cours de cuisson.', '2004-10-31T22:35:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, a46e45b5-6dea-4553-9301-63852425521f, 'J''ai mis 2 fois moins d''huile, j''ai coupé les pommes en petits morceaux et j''ai rajouté un yaourt brassé nature... Un délice! Prévoir 45 minutes de cuisson à thermostat 7. J''ai légèrement baissé en fin de cuisson.', '2004-10-23T17:37:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 7ecf6e27-552d-4b4e-a79f-9cb5aa6cbb46, 'C''est une recette toute simple... Mais avec ce gâteau, c''est le succès assuré!! J''ai diminué les quantités: 160g de farine, 160g de sucre, et 8ml d''huile, avec un peu de rhum ou de fleur d''oranger, c''est un délice...', '2004-03-21T16:48:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 0b96964a-b319-4ed9-963e-920f2519eb30, 'Bon, mais il manque quelque chose : j''ajouterais un peu de sucre.', '2004-02-24T17:33:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 33b5c215-3726-4389-94c8-9d388df7b507, 'Bon, mais sans plus. il faudrait peut-être couper les pommes en dés plutot que les râper. J''ai ajouté du sucre vanillé.', '2003-09-08T10:31:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21472, 151be2ed-06fc-4153-8f8d-e4423939e3db, 'Je n''ai mis que 5cl d''huile! Si vous battez les blancs en neige, il est moelleux et aéré... De plus, il se conserve 3 jours sans problème! ;-)', '2003-04-05T15:47:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64271, 51e3ed0b-bdd0-46d4-b8e0-3cd9ed475e9a, 'Que les biscuits ne fondent pas, c''est normal!! Ce sont des crumbles, le mélange du dessus doit être sableux et croquant!! Pour ma part, j ai trouvé cette recette excellente. J''ai juste préféré mélanger la cassonade aux bananes plutôt qu''aux biscuits. Merci pour la recette.', '2008-05-10T17:12:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64271, ede33e68-cb88-40fd-b3d6-dde2f6e0105f, 'Ou j''ai particulièrement mal suivi la recette ou ce n''est vraiment pas terrible. Les biscuits (même au beurre) n''ont pas fondu. Résultat = cassonade et biscuit en surface sans s''être mélangés donnant un goût vraiment pas terrible. Le reste non plus. Je ne recommencerai pas! ', '2007-12-07T23:08:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22902, 386c58b8-ea6e-4174-a9f9-26025e9dbe66, 'C''était notre (faite à deux) première charlotte et nous sommes fiers du résultat. Il faudrait cependant ajouter 2 feuilles de gélatine pour la mousse à la banane pour qu''elle se tienne mieux.  Je ne trouve pas qu''il y ait trop de citron personnellement. On peut réduire un peu les doses de sucre. Délicieux........la charlotte a été mangée par 3 personnes au lieu de 6.  ', '2012-06-24T22:48:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22902, 4a9a1409-0112-45cc-89df-758cf459d507, 'Trop de jus de citron, un demi est largement suffisant car autrement la mousse banane a un goût de mousse citron !! Sinon, recette sympa à réaliser.', '2012-04-18T11:22:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22902, 8a997084-783d-4ab7-a2f5-80b0ad8e3075, 'J''ai suivi la recette à la lettre et c''était très bon. Je l''ai mis au freezer et le côté 1 peu glacé a plu à tout le monde.', '2006-07-09T00:17:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22902, 460e3bad-43ff-4709-bcc6-3691e7cc411f, 'Très déçue du résultat, malgré un suivi scrupuleux des indications. Néanmoins un goût correct.', '2005-11-20T21:03:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22902, ccc6e833-7b46-41ec-bb48-3e3857123dee, 'La purée de bananes était trop acide avec le jus d''un citron, et elle ne tient pas... Il faudrait lui incorporer de la gélatine. Là, c''est difficile à servir! Je n''ai mis que 100 g de sucre avec les fraises, c''était suffisant. Et j''ai ajouté des morceaux de bananes et de fraises dans les deux préparations.', '2005-05-05T14:36:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530685, b41a961b-3d3f-460e-b869-1e7ce0343325, 'Simple et bon ', '2021-04-21T19:49:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22729, d04666e4-727b-4e0b-8d74-4bc383bc383e, 'Je suis au régime, donc pour moi : pas de beurre, pas de crème. Aussi, j''ai fait fondre mon chocolat (de cuisine) au micro-onde, avec de l''eau et recouvert d''un film adhésif pendant une minute. Le chocolat fondu était bien liquide, ne s''est pas solidifié du tout et on a pu tranquillement le finir avec nos morceaux de fruits frais. Un délice !', '2010-06-21T11:41:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22729, deed6298-f8ce-4258-975f-490c2df9670a, 'Très bon, facile à faire et convivial . Petite astuce pour que le chocolat ne durcisse pas trop vite rajouter de la crème fraîche épaisse lors de fonte du chocolat. Bon appétit à tous', '2007-08-19T22:26:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22729, 4c0e3a01-a098-45cb-82b3-11516088fd15, 'Les fruits sont bien choisis, mais le mélange s''assèche vite. Un Banyuls bien frais accompagne ce dessert à merveille.', '2003-06-06T14:27:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, edda2126-8b78-49a5-ae16-d910ad95eaeb, '1,5 pot de farine... Pot de yaourt? 2 eme essai et gâteau toujours aussi catastrophique', '2021-01-15T15:26:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, eab88c0b-efc7-4095-9161-657bd0df1189, 'Si quelqu’un peut m’indiquer à quoi correspond le pot utilisé pour mesurer la farine? S’agit-il d’un pot de yaourt ou d’une cup de mesures façon recette américaine? Parce que mon premier essai n’était pas une réussite... d’avance merci.', '2020-10-18T12:24:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, a407484b-7d9a-4eaf-8174-682c4621e1b1, 'Très bon gâteau, ultra moelleux ! Pour plus de saveur j''ai ajouté 1 CAS de cannelle et gingembre en poudre et 1 CAC de liqueur de fruit. J''ai fait 2 petites modifications: Huile à la place du yaourt et pommes coupées en cubes que j''ai mélangés à la pâte.', '2020-10-17T21:30:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, a62d72b5-6fc5-47df-ae75-5c7715a790cb, '2 fois que je le réalise mais trop de pommes et pas assez de pâtes le rendu ne donne pas vraiment un gâteau mais cela reste bon ', '2023-04-25T11:59:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, 4a48264c-b7e2-4e36-b9b8-f339e39a7161, 'Échec total. 3 pommes me semblent beaucoup trop par rapport aux autres ingrédients.', '2023-04-09T10:13:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, 95eee149-987c-4724-bfb2-0476433b4aad, 'Super pour l''anniversaire de ma fille de 3 ans, tout le monde a apprécié :-)', '2022-12-13T14:17:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, 67977855-15a3-446d-9a41-17f8e8ae354c, 'J''adore ce gâteau. Je le fais régulièrement.
 Au lieu d'' 1 1/2pot de farine je mets moitié farine et moitié poudre d''amande puis j''ajoute 3 pommes coupés en morceaux à la pâte
-> une tuerie pour un gâteau sans sucre ajoutée. 
Merci pour le partage de la recette.', '2022-07-03T15:19:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, 0b0f5867-8671-4cf1-94d2-5aa8599e0c0b, 'Pour les personnes qui ne comprennent pas un pot et demi, c''est comme le gâteau au yaourt, on prend le pot de yaourt pour doser et on voit la texture à l''œil si trop liquide, trop épais… bon appétit 🙏🙏🙏🙏👍', '2022-05-10T15:36:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, c06d27b7-e21d-474b-9c60-3f645f9fac25, 'Très bon, je conseille ', '2022-01-18T23:37:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, 570125bd-d911-46bb-a93f-69c49eb99fc5, 'Recette suivie à la lettre.
Gateau qui ressemble à un clafoutis lorsqu''il est cuit.
Nous avons adorés le petit goût de banane.
A refaire.', '2021-01-25T14:57:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, 023dbbcf-b957-4f26-a5f7-3abb0e65ccd9, '1,5 pot de farine ? 500g ? Résultant catastrophique. Il faut préciser grammes la farine !', '2021-01-23T14:07:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, 268fd691-360c-41bc-96ec-1ec3d36c157a, 'Très bon !!!', '2021-01-21T20:38:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, 0e08c283-1530-472d-a169-70192b162129, 'Facile et bon
', '2021-01-21T01:19:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, 98274434-b03e-42d8-a9fc-5f1ba306fa4f, 'Trop bon. Pour un "sans sucre ajouté" c''est vraiment trop bon. Sûr qu''entre banane et compote (même sans sucre) la douceur est là !', '2020-11-29T18:50:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, edc5a011-598e-4338-a9e6-043a4438a2ce, 'Je l''ai trouvé vraiment excellent ! J''ai laissé la banane en rondelles, et j''ai mis une pomme coupée en cubes. Très bonne idée la compote de pommes pour sucrer naturellement, ainsi que la banane. A refaire à l''infini avec d''autres fruits...', '2020-10-22T20:54:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, 57950ac5-db6e-46ce-a839-a9de5b4daf40, 'Excellent, merci !', '2020-06-28T15:53:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, c881710a-46bc-4339-88b4-fc6dd269b582, 'Facile, sans sucre parfait pour le petit-déjeuner des enfants (et des grands).', '2019-11-03T11:38:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, c97ef37f-6137-41ec-b99b-f5416718fc73, 'Excellent. PS N''oubliez pas dans votre liste de courses un pot de yaourt grec et une noix de beurre, non renseignés parmi les ingrédients !', '2019-09-03T21:59:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, f4c40fbf-1f63-43e0-924d-86380286619d, 'Grand merci pour cette recette ! Je l''ai déjà réalisée plusieurs fois et le succès est chaque fois au rendez-vous, au point que bien souvent, il n''en reste même plus pour moi ! Nous ne devons pas suivre de régime particulier, mais nous tenons à nous alimenter de façon saine, et donc avec le moins de sucre possible et avec cette recette, nous sommes comblés. Je lui ajoute de la cannelle et des petits raisins de Corinthe et je tenterai d''autres versions très bientôt. Seul petit souci pour moi : le démoulage, parce que cela colle aux parois du moule. Si vous avez une solution, je suis preneuse.', '2019-07-19T15:14:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, b07eaafb-113a-42c3-8a39-ed9e0ee579db, 'Super bon, gâteau très léger entre gâteau et tarte aux pommes. Je garde la recette. ', '2018-05-08T08:22:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, 952a7118-e66d-43d9-b165-c7f77b5b6df7, 'Bon mais un peu sec, peut-être aurai-je du mettre plus de compote. Toutefois le goût est bon.', '2018-05-08T03:12:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, dc2b52d5-f5d4-4d89-af32-f5ab59c169f2, 'Je viens de tester cette recette. C''est un délice ! Génial !', '2018-03-11T16:48:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, c8a6970f-675f-41fa-9244-8af338f28cab, 'Très bon. Pas besoin de sucre les fruits suffisent.', '2018-02-18T07:56:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, 47ab2a4b-3575-4177-874a-3aefd3ec593b, 'Très bon. Pas besoin de sucre les fruits suffisent. Cela ressemble plus à une tarte  avec une pâte moelleuse.', '2018-02-18T07:54:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, ac1c7b27-ceeb-4f2d-9df0-aaad712dc030, 'Très bon. Pas besoin de sucre les fruits suffisent. Cela ressemble plus a une tarte avec une pâte moelleuse.', '2018-02-18T07:42:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, d4d2dce5-cbf5-444f-a1a4-92c517a60ac4, 'Tres bon a mon gout suffisament sucré , doit etre parfait pour le petit dej. J''aime la texture en bouche. ', '2017-05-31T22:12:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, 1dced57a-64a8-498f-a1dd-2a302528f232, 'Bon gateau avec une texture "fondante" un peu surprenante malgré 2 oeufs au lieu d''un. (Nous avons mis 125g de compote fait-maison, peut-être est-ce lié à cela...). Pensez à mettre des épices pour donner du goût. Le goût de la banane n''est pas trop prononcé, juste assez pour "sucrer" le gâteau.', '2017-05-27T23:23:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, 9d164818-92ca-4582-81f1-7f8b5ce9f988, 'Je ne suis pas de régime et ce gâteau sans sel et sans sucre est excellent. Je le referai. ', '2017-04-17T16:17:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, cef3be01-a88c-4ee4-b695-3e13c1659ded, 'Je fait du diabète gestationnel, du coup je ne peux prendre ni sucre, ni miel, ni édulcorant... Cette recette m''a sauvée ! C''est trop bon sans sucre ! Ce n''est pas le texture comme un "vrai" gâteau, mais déjà ça me fait du trop bien ! Merci !', '2016-11-06T16:32:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345181, d7965432-92a5-433a-950f-190de006a360, 'Excellent gâteau sans sucre ajouté. Les enfants ont adoré le faire et le manger. J''ai mis une cuillère de sirop d''agave mais finalement il n''y en avait pas besoin  merci pour cette super recette saine et fruitée.', '2016-09-18T19:30:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61299, 8495e0b3-9a3b-46e0-9edb-e416fbc465cd, 'Parfait !', '2016-06-10T19:41:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61299, 8d9aff9b-5db4-4e86-bfe3-cf85e84eec04, 'Gâteau peu réussi pour ma part, trop sucré et pourtant amer...mais mon pamplemousse ne devait pas être très bon à la base!  l''association pamplemousse-banane n''est pas très inspirante.', '2015-07-08T16:42:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61299, 9a6fb253-b9e5-494a-bc60-3a0d56481831, 'Très bon goût, juste que le gâteau ne se tient pas une fois coupé. Un tout petit peu trop de sucre à mon goût. Je n''en mettrai que 100 g la prochaine fois. Original et facile, je garde la recette !!!', '2014-11-05T21:51:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61299, 0673f8c8-82ef-46ba-b012-8f4e1991a360, 'Très bon gâteau ! Il a été dévoré par les invités .  ', '2014-06-01T11:27:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61299, 19640e68-baff-40eb-bff8-f78001d35bf7, 'Très bon gâteau. Parfait pour un petit goûter ', '2013-11-22T21:02:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61299, 9891e58f-4d2a-4d97-965f-8014112c837f, 'Original et très bon. J''ai rajouté une banane dans la préparation pour ressentir un peu plus le goût. Excellent.', '2012-07-03T13:12:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61299, 235b136c-79a3-4210-82e7-b4c2874b9c7f, 'Etonnant gâteau, très frais, très bon, belle couleur rose ! Ne pas vous inquiéter si la consistance de la pâte est très liquide, ça marche !', '2008-04-12T15:59:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, 402a08f2-1858-413c-b204-fc4a75ef3337, 'Un régal ! beaucoup de caramel mais c''est ca qui est bon...', '2007-06-15T16:57:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, c9e17825-c1c6-446b-9758-0dc407afa4b2, 'Excellente recette de tarte tatin, je l’ai adopté pour le caramel facile à réussir !', '2021-12-18T18:33:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, 728aad3c-b984-4fd1-a4b6-90f10a8741b6, 'Elle est excellente, tout la famille adore !', '2020-02-29T02:12:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, 4432d336-b0a0-4f68-a7bc-8becbb951170, 'Trop sucré à notre goût. Je ressaierai peut-être mais je préparerai le caramel autrement. ', '2016-02-14T23:27:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, b650c929-2599-460a-a531-cf9ca5a8b8e7, 'Encore un peu de mal avec le caramel, sinon c''est très bon', '2015-02-14T12:45:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, 5c8d4b18-6897-42ea-a9b0-d6db3114ff27, 'Tout simplement immangeable, un repas de Saint-Valentin complètement raté...', '2012-02-21T11:16:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, c6bd963f-729b-4347-966e-4017d56788c1, 'Excellent ! C''est ma première tentative de Tatin, et ce fut une vraie réussite. On a oublié de flamber la tarte la première fois, mais ce soir le reste y passe !', '2012-02-09T21:50:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, 3f417767-c11f-4fb4-81e8-a2b9d29d0fb3, 'Nous avons bien aimé cette tarte même sans la flamber mais servie avec un bol de crème chantilly un peu vanillée.', '2009-03-01T14:04:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, 60c3a7a7-258f-45a9-9f06-db9cd51e563e, 'J''ai suivi la recette à la lettre mais pourtant le résultat est sans appel pour moi et ma moitié : immangeable!! J''ai dû me tromper quelque part, ou alors on n''a pas du tout la fibre de la tarte tatin à la banane !! ', '2008-11-14T12:19:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, f1fa7ffe-10eb-4312-8511-67b2852629fd, 'Un régal tout le monde a aimé, on a même oublié de la flamber!! A faire et refaire, simple comme tout. Merci pour cette recette que je garde bien au chaud..!', '2008-11-02T23:15:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, 3d70c59c-1002-4e32-bc44-1b6bd1dd382e, 'Hum!!!!!!! Quel bonheur, et quel plaisir de déguster cette tarte.  (j''ai mis 150 grs de sucre) Merci pour cette recette', '2007-09-11T08:52:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, 297a5713-0194-4a95-bd53-11d68116c23c, 'Cette tarte est excellente. J''ai suivi les conseils des marmitonautes et j''ai mis 75g de beurre et 150g de sucre pour qu''il y ait un peu moins de caramel, c''etait impeccable. ', '2007-04-18T19:52:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, 8d15a9b9-cc01-4f17-a848-1e2bf4852758, 'J''ai suivi les conseils des autres commentaires en mettant un peu moins de caramel. Malgré cela, mon mari a trouvé que le caramel remportait de trop sur la banane.  Moi, j''ai adoré!!! Surtout avec quelques noisettes de chantilly... Pourquoi pas servir avec une boule de glace à la vanille ?', '2007-02-15T11:05:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, b3f59475-4cd0-499a-ab2c-6b80f8b1d9c3, 'On a adoré, bravo.', '2006-12-13T18:13:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, 554d03d1-a533-4352-90bc-50e1a55dacc1, 'Terriblement bon, réalisé avec une pâte brisée. ', '2006-12-12T16:49:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, 34651e63-4262-47d8-a4ae-9fe2010473d0, 'Délicieux! Par contre, les bananes et le caramel ont rendu beaucoup de liquide et ça a trempé la pâte feuilletée... Dommage!', '2006-10-02T19:23:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, 9cd0ea25-d210-451f-9353-3354ab8e7eee, 'Super bonne cette tarte!!!', '2006-09-16T19:42:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, 6f111b54-608b-4d3f-a307-105e12cca5a1, 'Très bonne!Mais j''ai seulement réduit la quantité de caramel et utilisé du citron vert.Merci pour cette recette !', '2006-08-17T18:30:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, 5fc3eb0e-1337-4e50-bb2e-800c76f6ac7e, 'Dantesque. Pas un gramme à changer à la recette, c''est à lécher son assiette! Seul reproche: avec une tarte aussi bonne, pas sûr qu''il y en ait pour quatre personnes... mais je suis un gros gourmand ! ', '2006-04-28T18:40:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, ec35c135-e718-4981-ac3b-d102e026a2ce, 'Extra! ', '2006-03-30T15:50:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, f6ed4a20-e41e-4b9a-82c3-5e51dc96111b, 'Emmanuelle a raison : un peu trop de caramel, sinon c''est excellent.', '2006-03-17T14:33:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44808, 5e6b8ede-82f4-496a-8351-9aa2fb45dadc, 'Délicieux. Trop de caramel en revanche, la moitié suffit largement.', '2006-03-07T09:18:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224760, 911117c9-f4be-4788-ba5b-90163546e6d2, 'A la maison c''est devenu un classique !', '2018-09-29T12:49:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224760, 3024590c-1c62-47a2-ae92-c102e679371e, 'Très sympa, avec un bon dosage entre l''acidité et le sucre.', '2019-10-27T07:35:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49590, 2ba4e1a8-9520-4875-90f6-1cfc4c619e98, 'Consistance de pâte étrange, très épaisse. Et peu par rapport à la quantité de fruits. Cela fait 2 couches de pâte avec de la compote au milieu... Il manque d’oeuf, de blancs en neige, de beurre... De liant...', '2020-03-29T19:23:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49590, ae9a6130-0f96-462f-8dc5-6fcded6c9155, 'Pas mal en rajoutant 1 oeuf et un peu de farine. Il n''y a presque pas assez de pâte pour couvrir le dessus. Cela reste un gâteau très riche en fruits.', '2006-11-12T10:23:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49590, a1a4a398-b748-4620-84a8-1812963a65fc, 'Effectivement, il manque quelque chose, du lait ou du beurre ? La pâte était toute sèche. La quantité de farine est insuffisante pour la quantité de pommes et de bananes. Au 2ème essai, j''ai doublé les proportions de farine, sucre et oeuf (sauf les fruits), et ajouté du lait à la pâte. C''était bien meilleur, le goût est original.', '2006-09-19T19:50:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49590, 70ba986c-3a5d-4fc7-97ea-da4d4e432d40, 'Je pense qu''il manque un ingredient, l''aspect n''est pas encourageant et le goût est original.', '2006-08-20T22:37:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315376, efc2d3b8-e427-46fe-b9ce-b9fa6b7cbcc6, 'Excellent avec des framboises.', '2016-04-09T21:56:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36892, d6a7de8b-74d3-476f-92b8-e5942aa900b0, 'Miam ! Mais attention au four, pour bien dorer, les retourner une foi. Moins gras qu''au beurre, cela fait penser aux samossas en entrée.', '2016-11-16T15:25:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36892, eea78adc-59da-4206-a825-2d61d52cabee, 'J''ai testé en rajoutant de l''extrait de vanille et de la cannelle... C''était très bon, l''idée de faire macérer les fruits est excellente et je referai, mais sans chocolat (j''ai trouvé que c''était de trop) ... enfin, à prévoir en fin d''un menu "light" ... Merci à l''auteur !', '2012-09-01T20:39:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36892, 15be1a25-5a3d-4ecf-9ba5-0e57a467a88e, 'Une merveille de gourmandise ! J''ai ajouté quelques raisins secs marinés dans le rhum. Délicieux, merci pour cette recette !  ', '2010-12-15T17:54:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36892, a51ac525-8451-47ce-9ce5-8129a5f21ba5, 'Vraiment délicieux ! Ne pas lésiner sur le beurre que l''on tartine sur les feuilles de brick car c''est ça qui permet au triangle de se bien se coller.', '2010-11-18T16:30:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36892, 1cfbd2f6-3a8b-45d9-8374-948368d4adf3, 'Trés agréable ! Pour en faire un dessert gourmand mais léger, je n''ai pas beurré les bricks et j''ai cuit le tout au four. Servi avec au choix coulis de framboise ou un duo caramel au beurre salé/chantilly, tout le monde a apprécié !', '2010-03-24T21:28:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36892, 904b6eb6-5734-4894-abe2-5fa1125865e4, 'Recette facile, rapide. Le mélange fruits-chocolat est délicieux. Les feuilles de brick sont croustillantes et dorées. J’ai testé cette recette pour 2 personnes en mettant donc 1 pomme et 1 banane. Je n’ai pas pu mettre la totalité de la garniture dans les triangles (sinon, je n’aurais pas pu les fermer). Pas de souci, on a fait flamber le reste de fruits. Je referai cette recette sans hésiter !', '2010-03-14T19:38:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36892, 9a825caf-01f1-4689-bd4c-f1c6356255b9, 'Très pratique : les fruits marinent pendant le repas. Par facilité je les ai fait cuire au four.', '2008-12-03T13:20:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36892, 7f83e375-f857-4dae-94d9-b05cc97cf60b, 'Excellent... J''ai croisé deux demi-feuilles de bricks pour plus de sécurité!', '2005-11-08T08:43:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23608, da1cd90f-35f5-4bf1-9045-fd20c7d2315a, 'Où puis-je trouver de l''alcool de fruit ? ', '2014-04-29T21:10:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23608, 0763820a-aa6e-48b0-afb2-a92366f760a1, 'Merci encore! J''en aurais pleuré! J''ai retrouvé presque exactement la bière que mes amis rwandais fabriquaient avec des bananes! Simplement, je ne pense pas que cette bière soit aussi fournie en protéines, en vitamines, en oligoéléments que l''est la vraie bière de banane...? ', '2009-05-03T20:44:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309780, a2cbb1d3-c52c-4bef-bca2-d66cb6a462b4, 'Super bon et frais ! A la place des yaourts j''ai mis une Perle de lait et un yaourt à la pêche', '2015-04-11T17:53:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392519, 2303de22-02b6-45a0-8390-086ae4f559fe, 'C’est le gâteau que j’ai le mieux réussi, il est excellent !! ', '2023-10-31T11:28:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392519, 1da2c277-5884-403c-8cec-d4bc437cf120, 'Excellent. Il est super moelleux. 
Je n’avais plus de noix donc j’ai mis des noix de pécans. ', '2023-08-20T13:54:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392519, e7bed3bc-d77f-41ba-8e61-871fc1377e12, 'Excellent. J''ai remplacé la poudre d''amandes par des flocons d''avoine !', '2021-12-15T10:20:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392519, c6915594-c174-48a4-a014-9a976e3f9bac, 'Très bon', '2023-08-01T14:13:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392519, c419b17b-f701-490e-9c7b-32c31cc3a904, 'Trop bon et super moelleux, j''ai rajouté une petite cuillère de rhum négrita. Exquis', '2023-04-14T07:42:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528319, 58004561-0c00-40cf-bfce-b0738d752b66, 'J''ai mis du nutella à la place un délice je recommande 😋', '2023-04-12T15:59:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528319, ee991b3a-d3e1-4551-aaff-e060dbc73d1e, 'Un pur délice. Peut se faire avec des différentes saveurs de glace. J''ai testé avec chocolat, vanille, caramel beurre salé et la recette initiale. Mettre le double de chocolat fondue, c''est encore meilleur !', '2022-03-20T15:49:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528319, be0ad6e2-dfc3-4dd9-bea0-5403075d525f, 'j''ai adoré c''etait délicieux', '2021-04-02T12:35:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528319, 1d6d8752-9616-4f26-ba14-7482fda5e50e, 'Une tuerie, en replaçant le chocolat par des granola, et une petite cuillère a soupe de Nestlé chocolat en poudre une dinguerie !', '2023-09-11T13:38:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528319, a2da87f9-36c1-4142-b09a-a97273853736, 'Super', '2023-02-10T15:09:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23925, e93e9ae5-3418-4f20-b500-cff669383473, 'Idée originale qui permet de varier les menus d''été.  Après un premier essai, j''ai modifié la sauce en remplaçant la crème par du lait de coco et l''huile-vinaigre par du jus de citron vert. C''était délicieux.', '2005-09-08T00:40:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23925, c064e93d-f9e0-4228-aad9-9f2d7be3bc80, 'Très bonne recette, excellente en plat principale, ou pour accompagner un barbecue', '2022-05-12T14:44:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23925, 69f23e9d-0e6b-4297-8837-e0ed28951098, 'J''étais sceptique au début mes j''ai adoré', '2020-04-12T18:39:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23925, 18c72ee7-ef50-4051-98b0-88ed6c8820a3, 'Bien mais trop de bananes.', '2016-06-06T23:41:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23925, e4a011a5-96e6-4171-8683-611500f0a017, 'Délicieux ! Tout le monde a aimé, en plat principal emporté pour un pique nique. Je n''ai mis que du thon en boîte et doublé la quantité de sauce. La prochaine fois, je mettrai un peu de lait de coco avec la crème. ', '2015-04-24T15:41:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23925, a649f0fd-696b-4d24-9ad8-9dbe8e9cadd5, 'Moyen. Le mélange n''est pas très heureux je trouve.', '2015-03-03T15:47:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23925, 91f3180a-f79d-4eb6-90b3-82d1f0c6e8a0, 'Très bon, très frais par une journée ensoleillée. Je n''ai mis que du thon nature en boîte.', '2013-06-12T23:01:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23925, d5cb47fb-b37a-4e05-8cf2-854ec4d20899, 'Bien accepté , pour toute la famille .', '2013-03-12T09:47:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23925, 1c60938c-ed54-4f8e-9360-d0aeb1f789dc, 'Très bonne recette ! J''ai mis de l''huile de noix. Je n''ai pas mis de sel, ni poivre, ni poivron, ni épice. A la place du thon, j''ai mis des miettes de crabe ! C''était excellent et très facile à faire.', '2011-12-02T18:28:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23925, a0ffd00c-efaa-411e-b65e-fc3ae3ed4a87, 'J''ai essayé la recette avec de l''huile de noix pour la sauce. J''étais d''abord un peu sceptique à cause de la banane mais l''association est excellente! J''ai adoré! ', '2008-08-01T11:48:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23925, d4aebd0a-1197-4f27-9835-9c613947a180, 'Je n''ai mis que du thon en boîte mais j''ai rajouté de la noix de coco fraîche coupée en minuscules morceaux. Un délice. Pour la sauce, je voulais rajouter le lait de coco mais je n''en avais pas assez alors j''y ai mis 1 cuillère de sirop de liège. Par dessus, pour décorer, des bananes et des tranches d''ananas cuites. Tout le monde, s''est jeté dessus malgré la couleur.', '2007-07-09T13:26:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23925, 6afb7bf9-7621-4e89-90c5-fc4a50b4e91e, 'Je l''ai présenté, lors d''un buffet, auprès de mes amis. Au début, ils étaient plutôt sceptiques mais, au final, ils ont tous été emballés.  Original et délicicieux.', '2005-09-17T12:32:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23925, 264caf57-c02d-4a46-a055-e47b17eabd5e, 'Extra, même avec du thon en boîte.', '2005-07-18T15:06:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23925, e759300d-172f-4ee4-b6f7-90ba9b4918e2, 'Super! J''ai suivi la recette mais sans mettre le morceau de thon cuit (je n''en avais pas) et le résultat est excellent. Super salade qui change de ce qu''on fait d''habitude et très appréciable lors des grosses chaleurs.', '2003-08-20T15:40:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43079, a9217128-838e-4aca-bece-4f5da3b2d121, 'Très bonne mais... je suis partis avec 300 g de framboises congelées, 250 g de fraises, 700 g de bananes et 800 g de sucre.. j''ai ajouté environ 2,5 dl d''eau au départ, et c''était même un peu juste...', '2006-03-04T21:51:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38810, 647c8b6a-c189-49ce-96b3-6b2aec375c7d, 'Le résultat est...pas top. Le goût de la banane se marie très bien au chocolat mais pas celui de la pomme. Je m''en tiendrai donc à ma recette : mettre une banane à chauffer au micro-ondes dans une assiette, et recouvrir de nutella!! Bon ap'' !', '2005-12-17T17:20:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (311313, ea57fb31-8b4e-4ad4-9da6-c713d84a98fc, 'Très très bon, original. Pour ma part j''ai mis plus de glace à la vanille pour avoir une consistance plus liquide. A faire et à refaire. Merci beaucoup pour cette superbe découverte. Petits et grands ont adoré.', '2016-10-05T23:52:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (311313, 6bd6049a-f1b9-43c7-8b62-dd083828b739, 'Très bon. Fait avec de la glace maison banane noisette chocolat à défaut de glace vanille et dans des petits moules pour chocolat. Le rendu est très sympa et c''est bon et frais.', '2014-04-10T15:14:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29968, c1cd5cbd-2543-474d-98c7-3b331a707299, 'Un délice, même sans la meringue.', '2011-11-01T23:28:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29968, 26beb6cc-6175-433d-b544-bce97cbb8b03, 'Très bon, pourtant je ne suis pas une fan de la rhubarbe! Par contre niveau présentation c''est vrai que c''est pas super, mais je n''ai pas fait la meringue: la prochaine fois j''essaierai avec.', '2006-05-19T19:07:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29968, d021d5bd-4bb6-49cb-bfb8-e660a0419349, 'En effet c''est un peu liquide...', '2006-01-27T22:31:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29968, 3cb8e2fa-e83e-4a7d-9ccb-033f1fb17bbc, 'Cette recette a été un véritable désastre pour moi. Si la rhubarbe et la banane se marient bien, à la fin il n''y a qu''une bouillie informe bien peu appétissante. Par ailleurs, la recette gagnerait à être plus détaillée. Je suis très déçu : je ne recommande pas.', '2004-09-26T20:24:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29968, d844e924-4e10-4159-94c4-1be69e2e853c, 'Pour éviter trop de jus de rubarbe. La veille ou plusieurs heures avant couper la rubarbe épluchée en petits cubes. Placer la rubarbe dans un saladier avec du sucre en poudre bien mélanger. Placer le tout au frigo. La rhubarbe aura dégorgé et sera prête à cuire!', '2004-09-24T10:33:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29968, 984d3146-1e94-4beb-a212-732714f4ff8c, 'Très très bon. J''ai mis à peu près 400g de rhubarbe. Par contre, la présentation n''est pas sensationnelle, il y a beaucoup de ''jus'', mais ça s''oublie vite!', '2004-08-23T12:01:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16722, 28016cd6-d70f-49bf-abb4-7d6f45aa2caf, 'Délicieux et rapide !', '2016-08-19T15:38:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16722, bed8d759-919e-4850-86b5-59740e485ce1, 'Ne pas prendre des bananes mûres mais sinon c''est bon.', '2016-04-14T22:23:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16722, e7fb6231-4ef6-4075-aa4a-1e9102381b6c, 'A refaire :)', '2013-05-10T02:14:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16722, ea7e83db-f97b-46c7-be3c-9b05612a8f05, 'Très bon !', '2011-06-24T15:13:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16722, 381c006c-a912-4278-a210-7bfdcec1f07e, 'J''ai trouvé cette recette très simple à faire. J''ai mis du beurre salé, et cela donne un petit goût en plus très agréable. Par contre, je ne sais pas si c''est du au fait que mes bananes étaient un peu trop mûres, mais elles ce sont énormément ramollies avec la cuisson du coup la présentation était moyenne.', '2011-03-27T19:26:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16722, 4d50d635-083b-4422-b1db-98a56cf053a2, '1 demi cuillère à café de confiture de framboise en plus... excellent !!', '2010-06-29T19:16:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16722, 19072105-e702-4fbe-a6ce-88b6b9e4a2c4, 'Moi ça fait très longtemps que j''en fais et parfois je rajoute pour mon homme du rhum ou du cointreau pour les flamber après qu''elles aient bien caramélisé et c''est un délice !', '2010-05-18T12:50:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16722, 29cb0219-addb-42ec-81ae-7627ccabdd4f, 'Sans cannelle et sans riz mais excellent! un bon dessert très très rapide. Merci!!', '2008-03-24T22:53:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16722, b2c6626b-2892-4a4a-ac44-6314ddc719d9, 'Un régal! Merci pour le "truc" d''ajouter de la cannelle, c''est délicieux. Aussi n''hésitez pas à utiliser du beurre salé, ça donne un petit goût vraiment agréable. ', '2008-02-03T12:10:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16722, 9118d7a9-6fd3-477e-902f-a18a95ac6e37, 'Excellente recette, rapide et pratique. Je n''ai pas du trop réussir la friture, car les bananes ne m''avaient l''air pas très présentables mais avec un peu de cannelle en plus, c''était délicieux! Merci.', '2007-01-23T20:39:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16722, 1701df98-bca6-4578-a515-6d406c0739de, 'Essayez, vous ne serez pas déçu. On peut également flamber au rhum.', '2004-09-26T18:03:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, f8d3509c-0bf0-4f28-8eca-2ef5144c8e1d, 'Moins d''œufs pour éviter le goût d''omelette et c''est nickel bonne appétit', '2025-09-21T15:46:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 815fe438-4f4e-40bd-8e14-2f71b48d97d4, 'Cette tarte m''a beaucoup plu. Pour ma part j''ai mélangé tous les ingredients ensemble (chocolat: 200 g au lieu de 100, oeuf,crème liquide et sucre) er j''ai ensuite versé un peu de cette préparation au fond de la tarte, j''ai mis mes rondelles de bananes dessus et je les ai recouvertes du reste de la préparation.', '2016-01-04T21:57:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, aa847bad-05fd-449a-94ba-25b22219ff93, 'L’œuf battu sur une tarte au chocolat/bananes n''est pas bon ! Personne n''a aimé, tout le monde a trouvé l''a comparée a une omelette sucrée ! De plus ceci n''est pas une tarte, j’appellerai cela une quiche ! Je déconseille cette recette.', '2014-03-20T14:01:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, c6e057cc-fda2-458b-a76d-13ec82b625f1, 'Excellente tarte quand on aime le mélange chocolat/banane… J''ai mis moins de sucre de canne et remplacé par du sirop d''érable et mis de la crème d''amande au lieu de la crème liquide, résultat : le dessus de la tarte à caramélisé ! Que du bonheur !', '2013-11-22T16:17:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 03f8e8e5-48d1-4046-b9b5-020d9f6ef90d, 'Excellente tarte, très gourmande mais tout le monde en raffole !', '2013-04-01T17:36:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 47ba96b8-6c00-4b2c-b2bc-e635bf1248e6, 'Très simple et rapide à faire. J''ai juste mis un peu moins de sucre. Tout le monde à aimé.', '2013-03-08T23:03:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 279eba60-9787-4e98-a306-56bb4aa916b6, 'Sur quatre, deux personnes ont adoré, une n''a pas aimé, et moi j''ai trouvé ça passable. Je trouve que le mariage "banane-chocolat" sous forme de tarte est un peu écœurant.', '2013-01-25T23:32:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, e372ca61-20bd-4931-ac0c-fc72ea44ece6, 'Un délice !', '2012-11-04T20:47:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, b3241610-6c28-4ce5-87a5-f977f236a520, 'C''est bon et ça plaît. Contente de l''avoir testée pour le résultat.', '2012-08-06T17:45:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 99d86f48-20b6-42b6-b181-24bea3ed2b67, 'Super rapide et tout le monde adore à chaque fois. C''est devenu un de mes classiques ! A faire et refaire sans modération !', '2012-08-03T02:09:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 27fd9a7a-a65c-473b-a778-90c395d8ef46, 'Un peu bourratif quand même mais très bonne et facile à faire !!! Même ma petite de 5 ans a adoré', '2012-03-10T13:53:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, ef10db3d-9c71-42b7-80b7-d989ce507b8e, 'Absolument délicieux ! Grand succès ! Merci.', '2012-02-17T13:11:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, bbdbe788-9d2c-404d-83fe-1ee49fc303b6, 'Merci pour la recette, simple, rapide et super bon', '2012-02-08T17:44:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 9d9814cd-29b8-4579-b3ac-53a990e2e584, 'super et facile à faire, les bananes pas trop épaisses c''est mieux. et la tarte un peux chaude c''est encore meilleur ', '2011-12-19T12:16:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, fac69fa8-fdc2-47fd-b80d-491569d878ec, 'Oui, sympa ! Mais déjà, étaler le chocolat fondu sur la pâte... Il faut se dépêcher, pas facile ! Le chocolat refroidi vite... oui, je suis d''accord trop sucré ! 60 g de sucre suffisent. Sinon, le mélange choco-banane, bien.', '2011-11-04T12:27:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, a6d6744f-abb3-450e-9f46-4de817c7cc1f, 'Un régal, mes invités m''ont demandé la recette. A refaire.', '2011-10-28T18:34:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 301c72e7-c0d2-4126-98e1-ed49ab471ce4, 'Très bonne recette. Comme beaucoup je l''ai un peu adaptée ! J''ai mis un peu moins de sucre (avec les bananes c''est suffisant). Étant fan de chocolat, je mélange un peu du chocolat fondu avec la préparation. Merci pour cet ajout dans mon carnet de recettes !', '2011-10-17T20:53:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, e87ddf24-4a84-46fd-9d5e-84c73718dd3e, 'Très simple à faire. Quand on aime la banane, dessert vraiment excellent. J''ai mis 70 g de sucre au lieu de 100 g, car la banane est un fruit bien sucré : c''était parfait. A faire le jour même.', '2011-07-25T12:51:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 59de9192-2dfa-4e70-94f5-a607ff5047a5, 'Si vous avez des bananes mûres à écouler, c''est la recette qu''il vous faut ! Je me suis permis de mélanger tous les ingrédients que j''ai versé sur les bananes en rondelles au lieu de faire une couche de chocolat puis une autre avec le mélange.  C''est très bon et ce dessert a beaucoup plus à mes invités !', '2010-04-19T13:47:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 5cca60e1-16f7-4083-b62a-279d08992c69, 'Oui cette recette est bien : j''ai fait une tarte en ce mois de novembre pluvieux et j''ai invité nos voisins à la goûter... et ils ont vraiment aimé ! A refaire sans doute avec des bananes bien mûre et fondantes.', '2009-11-07T18:31:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, b1f09efa-2b2e-48ef-bf68-fa00df9e8a33, 'Toute la famille a aimé, excellente tarte. A refaire. Merci pour cette délicieuse recette.', '2009-01-07T16:19:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 1c571f87-d564-4c57-ae6c-977b723702f3, 'Délicieuse, avec moins de sucre. Pour les gourmands, le mélange chocolat/banane est un vrai délice.', '2008-05-23T20:34:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, ede35f93-d726-44df-9b8e-5c680f2abf3e, 'Délicieuse! Toute la famille s''est régalée. J''ai remplaçé la crème fraîche par du fromage blanc pour plus de légèreté. Un régal.', '2008-03-10T18:25:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, f6a75ddf-246f-4dee-bbfc-427e037e1273, 'Avec un peu plus de chocolat et un oeuf en moins. Ce n''est pas si lourd! Les gourmands adorent, la tarte ne fait pas long feu!', '2008-02-04T17:22:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 8350b0a7-463a-4d14-a284-6856dcd33f7d, 'Très vite écoeurante. La pâte du dessus c''est de l''omelette, j''ai l''impression de manger une quiche.', '2006-12-29T18:44:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 00280f06-193f-4417-9ee2-9ee215bf4b68, 'J''adore la banane, j''adore le chocolat... et pourtant, les 2 ensemble sont un peu écoeurants, lourds, il n''y a que les enfants qui ont aimés car la recette sucré + choco, ils adorent. Par contre, la tarte à la banane sans chocolat est excellente!', '2006-04-08T22:03:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, b9313e52-05ea-4294-8a30-d539cdd4c06d, 'Je suis désolée mais, toutes les personnes qui ont goûté, ainsi que moi-même, n''avons pas trouvé cette tarte si irrésistible que les commentaires le présageaient... C''est le dessus qui n''était pas super.', '2005-11-13T17:22:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, f9d32e16-dad5-4119-a7ce-a55dd724070e, 'Un peu trop écoeurante à mon goût! Je ne la recommande donc pas aux internautes.', '2005-09-25T21:09:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, c4baf3ee-569f-4a7e-a134-37ec2675fcea, 'Terrible! Autant pour les papilles que pour la ligne... mais franchement ça vaut le coup: tout le monde a adoré!', '2005-08-30T20:41:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 4fdf1c0d-f2fc-40b4-94b6-de202eba4374, 'Par goût personnel je trouve que la banane cuite n''est pas agréable du tout alors j''ai remplacé par des poires (précuites en sirop) qui supportent bien mieux la cuisson et qui se marient à merveille avec le chocolat.. attention à ne pas trop sucrer la crème du dessus sinon cela devient vite écoeurant.', '2005-07-16T18:05:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, f7edae2a-4d0d-4203-b414-105701557b8c, 'Cette tarte n''a d''irrésistible que le nom... Elle est bonne, sans plus. J''ai fait comme d''autres internautes l''ont conseillé, j''ai mis 200g de chocolat au lieu de 100g et 3 oeufs au lieu de 4.', '2005-01-30T15:25:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 428a355d-182a-424d-96c3-04dbd39b791e, 'Je n''ai pas aimé du tout... peut-être est-ce moi qui ai mal suivi la recette... mais le résultat ressemble à un flanc banane choc très très écoeurant... personne n''a aimé dans la famille...', '2004-11-17T18:03:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, d9072065-068a-4cf0-a638-a2b28b3904f7, 'Rien à redire. Par contre, je la préfère chaude plutôt que froide!', '2004-11-01T19:16:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 6a1103ae-424b-49f5-a466-56d6d9370963, 'Très très bon, rien à redire!!!', '2004-06-28T16:46:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, e192e64e-0366-4ac4-8372-9c617a063324, 'J''ai également ajouté 100g de chocolat après avoir lu les commentaires. Le résultat est vraiment très bon :)', '2004-05-11T20:11:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 2c6c1c1e-08a7-4e8b-8fe2-f9b703d00da6, 'Comment peut-on être déçu par cette tarte? Elle est formidable, c''est un régal!', '2004-04-22T10:20:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 2d3ba0d6-a5ad-4278-a587-84c85dab97b4, 'Suite aux commentaires précedents, j''ai ajouté 100g de chocolat et mis seulement 3 oeufs. C''est succulent! Merci pour cette idée de recette.', '2004-04-14T20:49:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, c7df288f-d96c-4f3c-b09f-98697318915c, 'Un peu déçue, il n''y a pas assez de chocolat, mes filles n''ont pas trop aimé.', '2004-04-05T10:07:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, c18e766f-1114-4ff1-9a34-bedc174118a3, 'Cette tarte est en effet nourrissante mais qu''est ce qu''elle est bonne. Rien à redire. Un vrai délice !!!', '2004-03-07T18:28:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, c29e87df-6081-493f-8c28-6cefd2f28c0a, 'Très très bonne mais aussi très nourrissante. Pour une fois le nombre de part annoncées est justifié  ;o)', '2004-03-03T14:16:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 2b97ee66-ff2c-4350-974e-2812617cf696, 'Au vu des autres commentaires, je ne comprends pas bien ce qui s''est passé: j''ai bien suivi la recette mais je me suis retrouvée avec une tarte baignant dans un liquide jaunâtre, pas mauvaise mais impossible à présenter à mes invités! De plus, la tarte refroidie avait un goût et une consistance assez désagréables...', '2004-02-28T20:01:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, 1c8cc87b-5b93-4ef2-8c4c-bdb804b087fc, 'Cette tarte porte bien son nom! C''est un vrai régal. A faire et à refaire absolument!', '2004-01-30T15:39:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22938, ffbfe767-47f3-4463-8fd3-871306db20e9, 'Très bon. Pour une première fois, je l''ai fait avec de l''ananas, mais la prochaine fois ce sera à la banane. Très bon et sans problème. Recette à recommander.', '2003-11-18T22:47:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42319, 559e33e6-140d-4499-9127-74012121d824, 'Recette simple et efficace, j''ai fait moi même la pâte sablée et j''ai mis de la compote de pomme à la place de pomme fraise ! Un vrai régal ! Merci pour le partage.', '2014-10-03T17:18:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42319, 26feb500-1ba8-4fd2-81cd-aebb31cf72a2, 'Agréablement surprise pour ma premiere tarte, elle était très reussie. Facile à réaliser et originale grace au crumble. Tout le monde a adoré. Je n''avais que de la compote pomme banane et c''était très bon aussi. A refaire', '2007-10-03T18:32:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345844, 01be234d-46ac-473a-8144-f3a6f6b50180, 'J''ai remplacé la banane par de la pomme légèrement fondue avec de la cannelle. La crème chocolat est délicieuse. L''autre crème me laisse plus sceptique mais globalement c''est un dessert agréable. Les proportions sont pour 3 a 4 personnes.', '2019-02-05T09:12:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345844, 7624839b-b98c-4e07-8f47-53dadc99b563, 'Gustativement c''est bon, au niveau de l''esthétique ce n''est pas très présentable. Il faudrait épaissir la préparation à la vanille, qui est trop liquide selon moi.', '2021-11-24T17:48:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345844, c850a61c-fe2d-4f11-a985-3fd27fcadd30, 'Très bien, même si assez déroutant par les "textures", goûts et apparence. Original.', '2016-12-04T16:26:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345844, 14fda924-923f-469f-919f-c351829a3160, 'Franchement bluffée. Je n''avais pas d''extrait de vanille j''ai mis de la poudre de vanille. Par contre pour cette quantité cela correspond plus à un dessert pour 3-4 personnes.', '2016-11-06T21:23:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345844, ad3e7fd3-625d-4c39-932b-926261fe56f7, 'Pas bon du tout : c''est gluant, étouffant même, et personne n''a voulu finir sa portion. Comme il n''y a pas de cuisson, le mélange est lourd et les goûts pas bien finis... À éviter donc, sauf si vous voulez vous fâcher avec quelqu''un...', '2016-10-18T17:17:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345844, 82f74da6-2540-453d-9ca1-39d02fe7c20e, 'Parfait. Une très bonne texture de mousse pour le chocolat... A refaire sans hésiter ', '2016-10-06T21:42:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345844, e80125fe-04a7-4a98-9ab5-d5c9e36a7039, 'Dessert rapide à réaliser. J''ai un peu modifié la recette avec ce que j''avais sous la main, j''ai mis du lait d''avoine saveur vanille à la place du lait de coco, du sirop d''agave à la place du miel, une poire bio bien mûre à la place de la banane et de la vanille en poudre au lieu de l''extrait liquide. Très bon dessert 100% végétal, riche en nutriments et sans cuisson. Top!', '2016-10-01T02:20:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345844, 5c0d9cb7-055f-44f8-8350-2e59d9cf6ece, 'Avec du cacao en poudre non sucré c''est top !', '2016-09-28T00:08:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345844, 4a5d6509-c492-48bd-90b7-d7fcdcc433c1, 'Juste parfait ! ', '2016-09-27T23:08:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224459, 39e57505-f837-4c06-919b-ca6247b94ea7, 'Excellent gâteau, léger, pas trop sucré, pas sec du tout, tout le monde a adoré ! Bref...recette testée et approuvée ! A noter : la cuisson dans mon four (à chaleur tournante) a pris 1h.', '2016-05-02T00:32:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224459, c63dc895-e3b7-4fd2-a276-f39169420c5d, 'Trop bon ?', '2021-02-08T16:34:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224459, 0031a207-3070-4ced-a2fd-ee1544defba5, 'super . j ai juste diminué la quantité de sucre de moitié et c est parfait .', '2020-09-06T11:01:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224459, ba8ad77f-5a18-4b88-887d-4de5a0be8368, 'Je suis pas fan de la banane mais j''en avais donc je me suis dit pourquoi pas ?
Et je suis ravie, très bon, aéré. 
J''ai suivi la recette sans rien changer sauf la farine, j''ai pris de la farine de sarrasin.
Merci pour ce partage rapide et efficace !', '2019-09-12T12:41:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224459, eeb238b6-7218-44ce-8a9d-fd08879adb75, 'Il est délicieux ! J’ai mis 3 bananes de taille normal, et mis moitié sesame et moitié pavot. ', '2018-05-30T06:50:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224459, 5e539587-7e65-4d7a-8f43-4641bbd5424e, 'Très très bon. Le croquant des graines de sésame... Hum !', '2018-04-29T18:48:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224459, 28f336aa-6a32-4b0f-9946-c2add0890d6d, 'Super recette. Avec du pavot et du sesame, comme sur la photo.', '2018-04-14T09:12:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217261, 0604dfd8-ea79-4025-8232-705f69fc7ee8, 'Pas la peine d''ajouter du sucre, il y en a suffisamment dans les fruits !', '2012-10-27T12:06:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217261, 5de64538-5384-418c-a617-10595454be06, 'Smoothie excellent', '2023-03-28T18:41:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217261, 569a6341-ee29-434c-87e0-ec69b630ac68, 'Excellent j’adore je trouve que c’est super bon ?', '2020-11-25T14:57:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217261, 763d74c1-8196-4660-bd1f-fa0f5888d563, 'Excellent j’adore je trouve que c’est super bon 😋', '2020-11-25T13:57:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217261, 286d76b6-c205-42ea-8135-98d588eb57f1, 'Extra bon?', '2020-07-23T17:58:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217261, 13342101-7259-4d4c-bf61-792d4fc9c4f5, 'Super ? ?', '2020-04-26T14:21:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217261, ecd6ce77-6bfd-4739-99e1-1fce8b1ec0a0, 'J’ai adoré 😋', '2020-04-21T17:46:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217261, 6bf47092-4eb9-4602-9f43-bab2a3294274, 'Merci', '2020-03-22T10:51:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217261, bf7064fe-bd59-41f7-8195-cfe11bd8d82b, 'Très bon, très doux, pas besoin d''ajouter de sucre, et je n''ai mis qu''une banane bien mure. Au top !', '2018-08-20T09:30:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217261, 26e5a7f1-f512-4f98-a33f-5b246fe6371d, 'Ça va c''est bon ', '2014-03-12T15:41:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40812, 7c9e7f1e-af34-4abb-84fb-7fe2446e83bf, 'Cocktail facile à faire, il ressemble à un punch, on ne discerne pas bien le jus de banane, ni l''eau pétillante, je m''attendais à un goût plus fruité.', '2009-01-01T13:31:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40812, 7340a386-153e-4d14-a5a9-065a4629f4b1, 'Délicieux, frais et pas trop alcoolisé. Bref, des cocktails comme on les aime...! ', '2006-03-27T20:37:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392215, 4c27549b-adfa-4df3-9dc4-68f46b9d2577, 'super bon !!!', '2022-01-13T15:14:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392215, 5befb6bb-6563-47be-beb3-94b27f06b414, 'J''ai testé avec uniquement des bananes (je ne les ai pas faites revenir à la poêle), c''est très bon. ', '2021-12-08T18:04:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392215, 3086a432-466a-43f2-b79c-3bc2cc795bfb, 'Excellent !!!', '2020-12-20T19:39:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (328232, febfb170-855d-48d6-bc19-7859fd65cb3f, 'Je n''ai mis que 40 cl de lait et j''ai ajouté 1 sachet de sucre vanillé... J''ai adoré! Merci pour cette recette!', '2016-05-12T18:24:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (328232, 00cf30d5-88f1-4f83-b0dc-4f9f1281f0db, 'Juste délicieux, j''ai opté pour le yaourt grecque à la place du lait.', '2019-08-02T09:21:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (328232, e43761d6-07ed-481f-a5b5-adcd8a867f06, 'Super recette mais j''ai mis 40 cl de lait et j''ai ajouté 15 g de sucre.', '2018-07-30T08:03:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (328232, c6d5e6e7-2e29-40ba-a49f-372b05738a33, 'Simple et Très bon ! Je n’ai mis que 40 cl de lait par contre !', '2018-05-14T23:18:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (328232, 2cb1c5bb-38f4-49ea-a079-a369d64ab864, 'Je n''ai pas aimé, je l''ai trouvé écœurant car même bien mixé il y a avait des morceaux. ', '2017-04-06T11:43:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (328232, 8e41702f-fc45-4e9f-a49b-7ee6b5b96600, 'Smoothie facile et rapide. J''ai mis du lait d''amandes et c''était délicieux ! ', '2015-12-06T12:19:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (328232, 342ee324-f30a-40ad-815e-faa5dbe2e28d, 'Tellement bon j''en raffole. Mettez le un peu au frigo il sera frais c''est encore meilleur', '2015-04-14T23:03:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (328232, b77b0e61-bdb7-4a51-b216-ea4c1399334f, 'Merci pour nous avoir communiqué cette recette vraiment délicieuse ! Mes enfants en raffolent', '2015-01-04T13:18:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (328232, a7db5321-025c-47ef-8e20-cc433b2f0912, 'Rien à dire, adopté.    ', '2014-10-08T05:10:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45506, fc6f7c95-03ca-4021-8f72-98f1bdb2a6cd, 'Juste pour dire que j''ai oublié de préciser qu''il faut ajouter un yaourt de riz au lait à la vanille.', '2006-05-05T18:05:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, adb5c1f5-5841-42b1-a0fb-e1ba0163d241, 'J''ai fait une pâte brisée maison ! J''ai mis 3 bananes et suivi un commentaire en rajoutant une grosse cuillère de pâte à tartiner choco noisette.
C''était simplement délicieux ', '2020-03-28T14:35:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 94fc7304-b80c-4b4a-9b8c-9fb68af477db, 'Super recette mais j’ai utilisé 225 g de chocolat, 20 cl de crème liquide et 15 cl de lait et j’ai ajouté 2 cuillères à soupe de Nutella pour adoucir !! Trop bonne.', '2019-05-05T18:35:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, f3736712-7c7a-43eb-8908-e780f9a9271e, 'C''est un pur délice ! J''ai juste un peu modifié la recette : je fais fondre 200 g de chocolat avec 30 g de beurre au micro-onde, puis j''ajoute 3 grosses cuillères de crème épaisse (j''utilise rarement de la crème liquide). Tout la famille adore, le gout de la banane est bien relevé et le côté un peu durci du chocolat donne une super texte en bouche. Je recommande !!', '2015-03-26T11:02:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 53e03a81-776f-4deb-bc17-842179e3be84, 'Elle a été très appréciée,  très facile à réaliser et très bonne ', '2020-06-15T01:52:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, b47eadd4-6253-40c4-ae38-66e2586d2c63, 'Très bonne recette. J’ai rajouté plus de chocolat en mettant 200g !', '2018-08-22T07:56:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, b6a85514-2f73-4437-b6f2-ec2caa1e9f31, 'Très bonne recette. Par contre, j''ai mis 250gr de chocolat et un peu plus de crème liquide car je voulais une bonne épaisseur de chocolat sur les bananes. Après refroidissement, j''ai badigeonné du nappage pour tarte au pinceau pour un bel aspect brillant (surtout sur les bananes de déco pour ne pas qu''elles noircissent), et un peu de miettes de spéculoos.  ', '2015-06-14T13:47:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, bc34993c-5e38-43f6-b400-94567a089761, 'Bonne recette, manque peut-être de chocolat et de crème pour remplir le moule', '2021-07-20T21:10:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 969d10bf-153b-441d-89a6-dfe59146ab6f, 'J''ai suivi les conseils et fait une plus grosse couche de chocolat mais cela a écrasé le goût de tarte. Néanmoins, je l''ai appréciée car je lui ai trouvé un goût de banana split !', '2020-01-27T17:52:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, cf7141ed-fc17-4a2f-a291-39f8dd22a334, 'J''ai fait encore plus simple pour une dégustation immédiate : j''avais 100 g de pâte brisée faîte maison au congélateur, j''ai écrasé 1,5 banane avec de la cannelle et j''ai fait fondre quelques carreaux de chocolat au micro-ondes et hop ! Une fois la pâte cuite au four, un fond de banane recouvert de chocolat fondu et miam en bouche !', '2018-11-28T17:33:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 161a2be0-93e2-4a91-82e4-761d39c5e73b, 'Il est préférable de la présenter pour un gouter et après participer à une course ! Délicieux et bien entendu, partage de cette recette... ah marmiton, que ferais-je sans toi ?  ', '2014-01-02T12:05:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, d27d4fd1-95d4-4c61-a34f-fb9d339fb328, 'Cette recette est juste divine. D''habitude moi qui n''aime pas les tartes au chocolat car trop lourde, celle ci est juste parfaitement dose. La prochaine fois je pense en faire deux !!! ', '2013-02-11T19:24:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 4ab78f59-1b25-4210-80e0-a113ee7d4589, 'Trop trop bonne, j''ai mis 200 g de chocolat et de la noix de coco râpé dessus... une nuit au frigo et c''est très bon !', '2012-11-28T05:12:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, e74ca47f-f433-4f54-841e-94a3c2f6a622, 'Faite avec une pâte sablée. 200 g de chocolat noir pâtissier pour 20 cl de crème liquide. Une nuit au réfrigérateur.un vrai régal, je referai cette tarte !! Merci pour cette recette !! ', '2012-10-01T00:08:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, e0310d7c-0438-49a3-a5ec-90b0301c705a, 'C’est dégoûtant, j’ai jamais goûté ton dessert aussi mauvais', '2023-06-23T14:53:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, ac1c6853-7485-4dc2-b89b-7d2425800a91, 'Tarte très bonne, petits et grands se sont régalés.', '2018-11-21T12:32:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 4e244fb4-fd9d-4497-8557-d66097090828, 'Très réussi ! Seulement les quantités sont insuffisantes surtout pour 8, j''ai mis 200gr de chocolat noir et 3 bananes c''était parfait ! ', '2018-04-08T11:28:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 8567083a-dbe4-441a-9902-7619f0a56eee, 'Très bon mais appareil pour moule petit modèle !', '2018-04-07T09:31:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 2683e594-d2a3-4975-b1d3-9dea6eddd913, 'Très rapide et facile a faire ! Un régal !', '2018-03-05T09:04:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, ed1c5f06-d544-44b9-bac8-867cc221cd0c, 'Une super recette tout le monde a adoré je l''ai un peu modifiée en mettant 180 grammes de chocolat au lait et 40 grammes de chocolat noir. En accompagnement une boule de glace à la vanille et des petits billes colorés.', '2017-08-07T19:13:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 22a785e6-950f-473e-b048-35ef5ceb7c94, 'Délicieuse ! J''ai juste remplacé le chocolat noir par une tablette de 170 g de chocolat au lait, j''ai mis 20 cl de crème semi-épaisse, pour être sûr de la consistance, quelques rondelles de bananes au-dessus et des vermicelles en chocolat. Finalement, elle n''aura pas vu beaucoup le jour... tout le monde s''est régalé !', '2017-03-27T15:48:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 73c8a21a-f2dd-4477-85f9-f1bf2fc8862e, 'J''ai laissé la pâte cuire trop longtemps mais sinon c''était bon ', '2016-03-06T19:50:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 3bb551e2-ca7a-4304-8019-150e18638922, 'Très bonne tarte. Merci', '2015-10-13T10:33:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 01d0e9a7-ada6-4997-a16a-9eed02215fc0, 'Super bon rapide et facile. Préparé la veille avec une pâte sablée + un fond de banane (3) + 200g de chocolat pâtissier + 25 cl crème liquide. Accompagnée de chantilly Un délice !! Merci', '2015-03-23T09:22:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 8102d2a2-c7a3-407c-b955-52026c2d929e, 'Ma fille adore cette recette mais elle préfère le chocolat au lait, je l''ai donc faite avec ce dernier. Cependant je rencontre un petit souci de consistance de la crème qui est souvent trop liquide et qui coule quand on découpe la tarte. ', '2014-11-28T14:13:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 2537b1c8-a122-4271-9962-360448eb0a9e, 'En mettant 200 g de chocolat au lait et 20 cl de crème fraîche, cette recette est divine !', '2014-10-28T19:12:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, fb716cf7-d7c5-4196-b225-b78b12024345, 'Fait avec 200 g de chocolat et 3 bananes, même quantité de crème, mais j''ai utilisé de la liquide allégée, le chocolat aurait surement mieux durci avec un crème épaisse, à re-tester :) !', '2014-09-24T23:13:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 3c598543-d3de-4325-bf69-39ccb7737aae, 'La tarte est trop BONNE! Excellente recette avec 200g de chocolat. Merci.', '2014-05-02T01:02:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, cc7346b9-f391-4565-ae64-67879c7ec044, 'Très bonne recette de tarte chocolat sans cuisson ', '2014-03-27T22:02:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, f6a37c75-ecc0-421b-9272-919a6e77c771, 'Très bonne tarte chocolat banane et en plus hyper simple. Mon Mari m''en redemande mais la prochaine fois sans banane :). A servir frais. ', '2014-02-19T23:10:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 5d3eb1e2-577f-4048-aeb6-4763d05060d4, 'Super bonne ! Astuce pour fondre le chocolat : faire chauffer la crème et la mettre bouillante sur les morceaux de chocolat que vous aurez poser dans un bol et au bout de 5/7min, mélangé avec une fourchette !!!!!', '2014-01-23T21:51:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, ac7774a1-f7ac-43bd-b572-c91da9f98f04, 'Recette excellente, très rapide et vraiment délicieuse !', '2014-01-01T18:12:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, f7aea6fd-45ec-4f90-b2d9-a48c3fc57007, 'Très rapide et sympa. ', '2013-10-09T14:02:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 29f5eed0-0726-4780-9d39-c1ceb7d96d47, 'Un vrai régal !', '2013-03-25T00:18:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 0cf44b40-f573-4df4-a407-13f0fbdcdcc9, 'Miam', '2012-11-11T14:49:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, c2c0f8fe-45cd-4530-8d17-1900453d33e9, 'Avec 200g de chocolat pâtissier, une pâte sablée qu''il faut faire cuire plus longtemps et 4 bananes, dont une dessus. J''ai mis un peu plus de crème (grosse erreur). J''ai fait cuire le chocolat et la crème au micro-onde ce qui a modifié le goût.  Je réessaierai la prochaine en suivant la recette à savoir la cuisson au bain marie, et en la faisant la veille. J''ai malgré tout été surprise du résultat vu l''état désastreux de ma tarte avec le chocolat sur et autour de la pâte, et le trop de crème. Mais mes invités ont apprécié ; ce qui est l''essentiel.', '2012-07-16T00:31:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, a2daccb4-e807-4d04-880e-32e3296d954d, 'Très facile à préparer et délicieux :) Je recommande tout de même de la laisser une nuit au refrigerateur, elle ne sera que meilleure :)', '2012-07-14T21:35:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 1d2ce41c-3026-4ea5-9654-b08977907d79, 'Meilleur chaud que froid. J''ai mis tous les ingrédients sur la pâte, une fois mise dans le plat et ai enfourné tout cela au four.', '2011-11-04T17:28:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 51f02600-a1ea-4354-a69b-a438ade7fca3, 'Avec 3 bananes et 200 g de chocolat sans changer la quantité de crème.', '2011-11-02T23:02:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 5c18261d-c7f1-498e-99e6-0559fed4becd, 'L''association chocolat/banane fonctionne en général bien, donc pas de surprise, la tarte se mange. Mais niveau consistance ce n''est pas une réussite. A éviter.', '2011-09-11T15:16:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, a98c1b33-6af1-4d84-acb3-425d27d1d9ea, 'A faire avec un fond de tarte à fruits (tout prêt) et 160 g de chocolat,tremper les ronds de banane dans un mélange de sirop de canne et de rhum, avant de servir garnir d''un décor de crème fouettée... Excellent !', '2011-09-01T15:24:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 75448eb4-7ee9-4fb3-95e0-8b92bd068609, 'La sauce chocolat - crème fraiche est trop liquide. Ce qui fait la recette un peu ratée parce que je l''avais réalisée pour la fête des pères... Papa était déçu... La tarte beignait dans la sauce ! ', '2011-07-03T17:21:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 02adb713-198a-4782-8ede-69f1cf2ffa9f, 'Avec 3 bananes et 200 g de chocolat pâtissier... Miam miam !!! Délicieux, tout simplement !', '2011-05-25T22:18:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, be8bc526-0211-4c73-817a-254ff0db946d, 'Je l''ai faite avec 3 bananes et 200 g de chocolat pâtissier, ça a été un vrai régal ! Je l''ai faite la veille au soir pour le lendemain midi. Succès garanti ! Cette recette va devenir un incontournable au dessert ! J''ai fait revenir les bananes en rondelle avec une cuillère à soupe d’arôme naturel de vanille bourbon. J''ai pas lésiné sur la crème non plus ! Je vous la recommande !', '2011-05-18T17:59:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, c9df0466-e392-49a7-84b4-7c8656cba494, 'Un délice ! Tout le monde a adoré, vraiment un dessert gagnant ! Merci pour cette recette.', '2011-04-28T03:01:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 104fbada-27c0-429e-b632-ba211c523639, 'Super recette !!! La prochaine fois j''ajouterai un peu plus de banane car le goût du chocolat est fort et on ne sent plus trop la banane !!! ', '2011-04-24T00:40:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 44e094bf-a219-4cd6-a2ec-a198097791a9, 'Faite avec 200 g de chocolat mais j''aurais dû mettre plus de 2 bananes car on sentait surtout le chocolat... Mais c''était très bon quand même !', '2011-04-17T22:24:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 8966169b-7808-45ce-b111-c493c132c491, 'Une recette très simple et délicieuse. Un seul problème cependant... Cette tarte nous rend accro ! J''ai eu le malheur de la faire goûter une fois à mes amis et depuis on ne cesse de m''en réclamer une autre, si bien que j''en fais régulièrement. Quelques petits changements cependant pour un résultat plus gourmand : j''utilise une pâte sablée, trois bananes (la dernière servant à la décoration) et 200 g de chocolat.', '2011-03-02T20:12:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 538560f8-1880-4205-b9cf-1d1825a6d08e, 'Très bon ! Une fois préparée le soir, je l''ai mise au réfrigérateur toute la nuit et le lendemain matin elle était parfaite ! J''ai vraiment adoré !', '2010-08-05T17:27:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 85aec210-642a-4b7d-8128-0a26a4d009ae, 'Nous avons adoré !! J''ai également mis 200 g de chocolat noir et ce n''étais pas du tout écœurant. Petite variante : remplacer la banane par des framboise (surgelées pour ma part), succès garanti également. Le chocolat se marie très bien avec ces deux fruits.', '2010-07-22T19:58:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 975d361d-d1bd-4f8a-9c57-76ab70fc7884, 'Excellent et si facile à faire. Je fais juste revenir les rondelles de bananes avec un peu de rhum avant de les déposer sur le fond de tarte. Ça donne un petit gout exotique !', '2010-03-30T14:12:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, d427507b-b89e-4d7b-956d-63ad93d160bf, 'Je l''ai faite pour la kermesse à l''école de mes petites et tout le monde a adoré, heureusement que j''en avais fait plusieurs vu son succès en dix minutes il n''y en avait plus.', '2010-03-29T20:23:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 18c7f51e-9d3d-4bc7-949e-84ce47d05dc2, 'Elle était excellente, merci pour cette recette facile à faire. ', '2010-01-29T16:02:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 7b81c1d8-cc1c-411c-b61a-d60074a91556, 'Tarte très fraiche et excellente pour les amoureux de chocolat ! Vraiment simple et rapide. Merci !', '2009-08-22T01:14:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, bd58c198-14d9-459d-9fbd-2ace61318be9, 'C''est excellent, et comme pâte, j''ai fait la pâte à tarte sucrée aux petits suisse, c''est délicieux et vite fait.', '2009-04-06T12:43:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 90a7ef70-c8c2-424a-8a19-0797129e2409, 'Pas mauvais, mais un peu écœurant pour une part normale. En tout cas facile et vite fait.', '2009-04-03T20:53:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 5cf8b167-ddc3-4575-b47d-b3b3ed97770e, 'Je l''ai fait avec 200 gr de chocolat et ça a été un véritable succès, merci pour cette recette très facile à réaliser!', '2009-03-28T05:38:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 4eabfb0b-3d8a-4d78-87a9-413a10967411, 'Mes invités ont aimé le goût mais sans plus et pour la présentation ce n''est pas un dessert que je recommencerai. ', '2009-02-03T16:20:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 6d8bf3b1-859e-4de1-acd9-18f23df842d8, 'Vraiment excellente, je l''ai déjà faite 4 fois, et je ne m''en lasse pas ! On retrouve vraiment le goût de la banane et du chocolat, ce qui dans certaines recettes n''est pas toujours évident ! Seule modification : j''ai mis 3 bananes (plus il y en a mieux c''est!) et 200 g de chocolat (miam!) !!! Parfait !! Merci pour la recette !!!', '2008-12-08T14:03:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, 390681be-c325-42c0-95a6-0c25f0c3aff2, 'Hummmm recette excellente et très facile, à la portée de n''importe qui. J''en ai fait apporter par mon fils à ma voisine et elle aussi s''est régalée. J''ai mis carrément une tablette de chocolat pâtissier de 200 g(c''est la seule chose que j''ai changé dans la recette). Merci pour cette recette que je garde précieusement.', '2008-12-05T09:29:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13568, ab6971b5-19ac-43c3-b787-61f0544eda1a, 'Facile...rapide...par contre je l''ai laissée 3h au réfrigérateur mais elle n''avait pas assez durcie, le lendemain c''était impeccable ! Merci pour cette recette tout le monde s''est régalé !', '2008-11-27T17:56:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52726, 7748b28f-75b3-4515-9054-2e8670b07088, 'Mes enfants adorent !', '2022-10-01T15:48:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52726, 88e1962a-41f9-4dfa-bb0c-515635e115fd, '8/10. Il faut que la banane soit mure. ', '2022-01-29T18:04:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52726, 72a5c273-b131-4f9d-bc02-2e43e5edc9c8, 'Banane, fromage et jambon se marient très bien, je n''ai pas fait sous formes de rouleaux mais de petits triangles façon samoussa en mettant à chaque fois une rondelle de banane coupée en 4 enroulée dans une demi-tranche de gouda entourée d''une lanière de jambon (donc temps de préparation un peu plus long !).', '2016-12-11T15:42:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52726, 41516184-61b8-4090-b48c-9ebb16c62680, 'Un peu déçue mais sûrement car ma banane n''était pas assez mûre et n''avait pas assez de goût.  J''ai essayé avec différents fromages et le mieux est avec un fromage qui fond. ', '2016-01-05T15:25:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52726, cf7c8a4f-2d26-4c76-b25a-389afe7714f6, 'J''adore cette recette de bricks, j''en fais régulièrement ! Je mets juste de l''emmental râpé a la place du gouda et je tartine un tout petit peu de moutarde sur les tranches de jambon. ', '2015-08-26T23:02:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52726, 6a9b9be0-4125-456d-aedb-dfb56d873086, 'Original ce mélange de saveurs. J''ai testé avec du "vrai" gouda, j''essaierai avec des toastinettes pour le fondant.', '2014-11-29T14:07:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52726, 36296da1-1e60-4c19-9f6f-668755855bc3, 'Délicieux !', '2014-07-07T17:40:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52726, 3544ca0d-58fc-41ad-99fd-0594071be42e, 'Original, très bon. J''ajouterais seulement une épice pour relever un peu le goût mais laquelle, je ne sais pas encore...', '2013-05-30T22:16:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52726, 3fe5706a-4470-4623-88a1-df952bdacb5e, 'Excellente recette, qui va vite devenir un classique pour nous ! Merci', '2012-01-04T21:31:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52726, 9f8f5f6a-9e19-4cad-a391-5688f831fa53, 'J''ai ajouté un peu de gruyère et les ai fait à la poêle, pas mal du tout...', '2011-04-25T19:36:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52726, 5dc037b7-28b8-413e-823b-bc334f5208af, 'J''ai suivi la recette en enveloppant mon quart de banane d''1 tranche de toastinette et d''1/2 tranche de jambon : c''est délicieux. Ma fille et mon mari ont beaucoup aimé. Je vais en faire comme entrée de Noël.', '2010-11-23T10:29:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52726, 1fe05535-33bb-47b6-ae50-76aa1494e188, 'Vraiment sympa comme recette et originale... J''ai mis du comté à la place du gouda, car je ne suis pas fan de ce fromage, et j''ai pris des bananes plantains, elles tiennent mieux la cuisson. En tout cas, mon homme et moi avons adoré et je pense que cela va devenir un classique !!!', '2009-05-13T18:34:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52726, 00180746-321e-4ce0-ac39-922d7f205865, 'Pas mauvais du tout!! Merci pour la recette! Presque tous ont apprécié excepté chez les enfants où la banane était de trop!', '2008-04-07T12:35:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52726, a186fad2-0156-499c-9706-9cac62cd244c, 'Un vrai délice ! Tous mes invités m''ont demandé la recette !', '2007-05-28T21:42:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59060, 5974f077-30e5-4a2f-aa25-5d0a86b08441, 'Dessert hyper simple à réaliser et que nous avons bien apprécié. J''ai utilisé de la brioche, saupoudré le dessus de sucre et mis à dorer quelques minutes sous le gril. A refaire.', '2014-04-24T15:38:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27363, 27b560f2-fde9-4894-80c3-e476451b98cf, 'Très très bon ! Je l''ai faite avec de la rhubarbe congelée, qui s''est délitée en compote quand je l''ai décongelée... du coup, j''y ai mélangé un peu du sucre directement et mis le reste sur le dessus de la tarte. (Note : j''en ai mis moins de 125g au total.)', '2014-05-06T19:11:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27363, 51a30b18-2de9-492e-84ce-5b52a5bac62e, 'Vraiment délicieux !', '2023-04-14T21:51:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27363, c8ea6f78-ba46-4e63-87d2-d08e775684fb, 'Excellente recette !!! Merci beaucoup !', '2013-05-21T19:24:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27363, ef7b33ad-2deb-47bd-ad37-3122b336bb08, 'Délicieux. J''ai utilisé de la rhubarbe congelée. Après décongélation, je l''ai quand même mise à cuire quelques minutes pour qu''elle se compote un peu. Après avoir coupé les rondelles de bananes sur la pâte, j''ai rajouté du chocolat dessert râpé et par dessus la rhubarbe. La douceur de la banane et la légère acidité de la rhubarbe en font un délice. A refaire !', '2013-05-20T16:08:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27363, 4044d98f-5d83-40f9-8cfb-2a3177171a3c, 'La banane et la rhubarbe se complètent magnifiquement. A manger le jour même !', '2012-07-08T14:42:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27363, 03160669-1396-4e51-bbcd-4572100bca6f, 'C''était bon mais le sucre a eu l''air "d''éclater" un peu partout dans le four... Du coup, la tarte n''était pas assez sucrée à mon goût. Je retenterai la prochaine fois en mélangeant la rhubarbe avec le sucre pour éviter qu''il ne "s''échappe" de la tarte.', '2011-05-16T20:32:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27363, 957f2927-47e5-4055-80f2-beda57561f6e, 'Très délicieuse et facile à faire. Mes enfants ont adoré.', '2011-05-04T20:35:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27363, e4a0fcce-ac09-4253-a9a4-b61c67c76aa2, 'Très rapide, très facile, très bon !', '2011-04-17T21:30:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27363, d0ced72b-b640-4581-b050-65040f44425a, 'J''ai juste ajouté 2 sachets de sucre vanillé et 1/2 citron suffit.', '2010-06-09T14:27:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312052, cf23a892-cc65-452c-8886-392f8100ab17, 'J''ai parsemé d''amandes éfilées', '2021-04-25T17:14:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312052, f2307d31-b28d-483b-8edf-07cf3dc122b7, 'Je n''avais pas de crème anglaise, je l''ai remplacé par 20cl de lait concentré sucré, ce qui a donné un excellent résultat !', '2015-11-29T19:55:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43151, 549bfa91-f66a-4a38-a449-617c6f63bb57, 'Mes amis n''ont pas été trés convaincus, mais moi ça m''a plu. Par contre je trouve que c''est bien meilleur quand c''est dégusté bien frais.', '2012-03-10T14:57:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43151, 64ba462b-d4de-4e96-9df3-11cca3facbb6, 'Un peu déçu, finalement on n''a ni le goût de la banane plantain ni le goût du chocolat... Au moins c''est original et ça cale bien !', '2010-10-19T20:38:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43151, 6a60d114-cf34-4ef7-860e-57a4b12c004f, 'Démoniaque.Pire quand on remplace le chocolat par du nutella...', '2009-04-14T17:33:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43151, 3cc9b906-d731-4ec9-ba6c-cbb2809ee0ba, 'Les bananes n''étaient pas assez cuites, du coup ça a rendu la purée assez compacte. Heureusement que le chocolat relevait tout ça. Recette essayée, mais je ne tenterai pas l''expérience à nouveau.', '2008-05-12T00:38:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63520, f1d506b9-4ce3-48d2-adfc-18f1b5ac1539, 'Vraiment délicieuse ! ', '2022-02-09T12:34:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63520, 28be4a3a-02dc-48de-9eb6-13b01c995bb3, 'Très bonne soupe que les enfants ont adoré sans doute à cause du goût sucré des patates douces. Je l''ai faite avec 4 poireaux et 2 patates douces recouvertes de bouillon (il faut mettre plus haut de bouillon dans la casserole que de légumes).', '2011-03-13T23:26:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63520, e10e1660-9d86-44fb-8b19-3563190bfd82, 'Testé ce soir avec des patates douces à la place de la banane ...hummmm, délicieux ! Le choc des cultures pour une savoureuse soupe d''hiver !', '2009-11-07T21:24:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63520, b6c77c54-2890-4116-a968-5d80e6c35ac5, 'L''alliance poireau-banane plantain parait étonnante à la lecture de la recette, et pourtant cette soupe est excellente et légère. Mettre un peu plus de bouillon que préconisé. ', '2008-04-16T22:16:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63520, b1653d86-d07a-4e98-a6e2-216730689f22, 'C''est assez original. La banane plantain donne un petit goût sucré, qui à mon avis peut faire "passer" le poireau plus facilement auprès des enfants, sans ajouter plein de crème ou de fromage. Le tout est léger et agréable. A tester !', '2008-04-12T23:12:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63520, 0ff6f7f4-5d1c-42e2-9f1a-e9bb6eee4404, 'La première à essayer cette recette marmiton. La banane adoucit bien le poireau. Plus besoin de mettre de crème fraîche dans la soupe aux poireaux. Par contre, question quantité, avec 1,5 litres de bouillon et une cuisson à découvert autant dire qu''il n''y en avait que pour 2-3 personnes en guise d''entrée', '2008-02-05T23:07:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331834, d72611a3-4796-48e7-9f7f-bc4b01781cc1, 'Je l''ai fait nature et sans cannelle... Juste un régal et en quinze minutes maxi, j''ai un goûter qui fait plaisir à papa et titou !!', '2016-04-16T17:49:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331834, 76703257-33b5-43f9-b2cb-bf16726c7109, 'Très bon tout le monde a aimé.  Attention à bien faire cuire à la fin pour ne pas que ce soit trop mou et gluant  Demain je teste avec du lait de coco ', '2015-07-29T18:29:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331834, 831046dc-329f-4416-b7c0-e0a4ca380a14, 'C''est délicieux toute ma famille a aimé, facile et rapide. Je vous conseille vivement cette recette !', '2015-03-15T19:21:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331834, cead4bb4-ee21-46f5-8208-a7a2690d2f49, 'Je les ai fait sans banane et sans cannelle. c''était juste délicieux !! ', '2015-02-14T12:40:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38042, 78eaa57a-f065-4000-a16a-68a9bf1b0f18, 'Trop bon😊😍', '2021-08-25T14:39:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38042, 338c5fb1-66b0-4df2-a51e-41c5dda4a92e, 'Très bon mais trop gras à mon goût !', '2010-12-17T12:44:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38042, ea6d5773-31d3-4002-a29c-bb998a3d9b27, 'Donc j ai suivi une partie de la recette en tenant compte des avis 
J''ai mis un seul verre de lait et ajouter 1oeuf et pour cuire la bananes j ai mis un demi verre de lait sans filtrer et je l ai ajouté une fois écraser sans essorer top pas liquide et super bon ', '2020-04-26T18:08:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38042, e2963f49-faae-45a9-8be4-cee9354d80fc, 'Ces beignets sont simples à réaliser et délicieux. La pâte était un peu liquide, j''ai juste ajouté de la farine pour obtenir la consistance qui me plaisait.', '2015-04-20T20:37:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38042, d3407f03-46f3-4dda-b839-aa3d1bcfa3dc, 'J''ai suivi la recette à la lettre mais impossible pour moi de confectionner des boules de pâte. La pâte était trop fluide. ', '2015-02-01T17:50:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38042, d21c3fd6-219c-486a-913c-04ae9c767b33, 'Succulent', '2014-07-02T23:27:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38042, 78c09737-516e-4ff3-bb2a-4f8f4bc7d756, 'Toute la famille s''est régalée. Première recette avec la banane plantain, j''avoue ne pas être déçue de cette recette. Merci', '2012-09-07T20:04:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38042, 00ce2863-fbc2-4074-b66e-ce07903ceebb, 'Rapide, facile, adaptable à son goût. La pâte à beignet est super moelleuse !', '2012-09-04T14:13:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38042, 3059d7b4-e01e-46a0-ac9c-f1d44343562d, 'Beignets délicieux : mon mari et les enfants adorent !', '2010-05-09T14:48:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (531625, d342ad0c-d25a-4344-8d78-243962feb456, 'Trop bon !!!', '2021-08-29T14:55:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36522, 1b77c68f-819b-482b-ab5b-ee62640ffd6b, 'La séquence dégustation:  Rachel : (regarde son dessert) Regardez, il est pas beau?   Ross : Ouais, ouais, qu''est-ce que c''est?   Rachel : C''est un trifle. Ça a plusieurs couches. D''abord une couche de biscuits à la cuiller, ensuite une couche de confiture, ensuite de la crème pâtissière, que j''ai faite moi-même, (Joey et Ross ont l''air impressionés) ensuite des framboises, encore des biscuits, ensuite du boeuf sauté avec de petits pois et des oignons, (Joey et Ross ont soudain l''air inquiet.) ensuite encore un peu de crème, et puis des bananes, et puis j''ai rajouté de la chantilly par-dessus! (Joey et Ross sont apparemment un peu perdus.)   Ross : Q-Qu''est-ce que c''était le truc avant les bananes?   Rachel : Le boeuf? Ouais, ça me paraissait un peu bizarre aussi. Mais bon, vous savez, je me suis dit "eh bien, il y a déjà la tartelette de Noël au mincemeat,” {Note de traduction: un dessert anglais aux fruits, comme son nom ne l''indique pas.}c''est quand même un dessert anglais, et ces g', '2005-05-07T19:14:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36522, aa49e61c-8639-46c1-9b1c-572f915510b6, 'Oh merci depuis le temps que je cherchais cette recette ! Bon je vais l''essayer sans boeuf et petits pois-oignons, sorry !', '2010-09-02T15:17:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36522, 5b398a1c-416b-49dc-bc6a-741605231ef5, 'Je viens de tester la recette et c''était délicieux! Bon j''avoue, j''ai zappé le bœuf (végétarisme oblige! ;-) ) et les petits pois et j''ai mis des fraises et des pêches à la place des framboises et des bananes (j''aime pas la banane et j''ai pas trouvé de framboises...) Mais sinon, c''était délicieux! :-D Je suis sûre que tout le monde se serait régalé si Rachel avait pas mélangé les deux recettes, ils auraient pas éparpillé leurs assiettes un peu partout dans l''appart''! ;-D', '2008-11-29T02:45:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36522, f4b37596-b7db-4ab8-9efd-fd222bcee989, 'Très particulier... Première condition: aimer le salé dans son dessert... hum! Recette testée lors d''une soirée ''friends''. Très peu d''entre nous ont été convaincus... [NDChristophe: cette recette est tout autant une blague qu''autre chose, alors attention... Il n''y a pas de garantie quant au goût!!!! ;-) ]', '2005-06-11T14:46:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36522, dd8f4353-484e-4b63-ad26-0354be591caa, 'Eh bien... Aussi étrange que cela paraisse... C''est mangeable. Ce n''est pas si affreux que cela.  Bon, on n''en reprend pas deux fois et c''est vrai qu''un petit ''trou normand'' est le bienvenu. Ah, ces petits pois qui se rappellent à l''ordre au bout d''un quart d''heure! Je suis par contre ravie de pouvoir dire ''je l''ai mangé!!!''. Je me souviendrai longtemps du 22 mai 2005 à Toulouse!', '2005-06-05T03:17:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36522, 9397794b-6859-417b-99b5-60da973e0284, 'C''était... particulier mais j''ai mangé toute ma part ! Après quelques minutes le goût de la viande et des petits pois revient ... conseil : faire un trou normand avec la liqueur du pharmacien ! (testé à la rencontre toulousaine du 22 Mai)', '2005-05-23T14:10:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36522, ee0700e0-b3e6-4896-b4c3-5ecbd38ceae4, 'Très original. Je l''ai servis frais, avec une  salade verte. Un grand succès, merci Gaëlle! ;-)', '2005-05-17T01:06:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36522, 258c7f1d-0171-44b7-9259-15bf25f397ef, 'Mmmmmmhhhhhhhhh... délicieux !! ', '2005-05-12T01:08:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36522, 07e200f4-6f76-4b24-b01c-82af0894130a, 'J''adore! Quand vous le mangez, veillez à bien prendre un peu de chaque couche pour chaque bouchée, c''est presque aussi bon que la dinde de Monica ! ', '2005-05-06T18:23:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223332, 5a18de72-ea93-433f-b5df-47aab88e3e77, 'Très bon, j''ai quand même ajouté 60-65g de pépites de chocolat ! Ca n''a pas la texture d''un "vrai" cookie, dommage !', '2013-05-05T17:02:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223332, 4a26e80e-b1fc-4bf5-87ef-909e02054eb2, 'Parfait et délicieux. Je recommande', '2012-11-19T09:54:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223332, d9da19ff-646d-4ecc-9fba-41e34fd5bfe7, 'Bon goût mais les instructions de cuisson sont inadaptées. Ils n''étaient pas cuits et je n''ai pas réussi à rattraper la cuisson, la texture est molle. Je suis déçue', '2012-03-11T21:40:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, bc331687-242a-48ac-a0d0-90f1d32ee509, 'Bien pour les enfants mais à ne pas servir à des invités, c''est une simple soupe de banane. A consommer le jour même car la préparation n''est plus bonne le lendemain.  ', '2014-10-26T18:19:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 6e2dc63f-2fa3-4a08-b489-62b85bef61b2, 'Très bonne recette à faire avec du fromage blanc merci ', '2022-02-19T15:33:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 04e1feb1-6b44-4da7-aed0-6fffa3697244, '2ème fois que je la réalise, et c''est encore meilleur.. J''avais du mascarpone donc je l''ai mis pour 2/3 et 1/3 de crème fraîche (proportions pour 3 personnes). Et 1/2 citron vert.  Servi presque glacé avec pépites chocolat en déco et pour le mariage avec la banane. Plus de gaspillage, et pourtant mes bananes semblaient bonnes à jeter ! Merci encore.', '2020-08-23T16:00:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, d41076e8-b463-409a-975d-d2d896272113, 'Recette réalisée plusieurs fois avec des bananes bien mûres, c''est délicieux ! Merci pour cette recette !', '2018-09-22T14:56:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 6e64c6e8-968c-4892-ad4e-cba27b552164, 'Bonne recette un peu trop sucrée peut être, mais excellente ! J''ai fait la recette sans mixer et ça marche très bien aussi. ', '2017-08-11T14:30:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 06aef8e2-5090-4a17-8d03-a430117e2bad, 'J''ai fait avec deux petits suisses à la place de la crème fraîche pour plus de légèreté. Excellent ! Merci pour le partage ! ', '2016-11-03T20:54:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 545c8f47-cabe-4638-adb4-6495499a5ac0, 'Je viens de faire cette recette en délayant 1 demi cuillère à café de maïzena dans un peu de lait pour éviter les grumeaux, et j''ai fait chauffer environ 2 min au micro-ondes avant de répartir dans des ramequins, ce qui donne maintenant une préparation plus consistante. J''essaierai une autre fois avec du lait de coco.', '2016-02-27T18:21:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, ad57cf98-676c-46cf-bde3-73427c8828e2, 'Très bon. Par contre j''ai préféré en congelé. ', '2016-01-21T15:48:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, a9a46e6b-ae82-49ef-b12a-cd7e9dd1f1b4, 'Simple, rapide et très bon !!!', '2015-09-10T12:11:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 8bb5d33f-171b-4f1a-8dee-846997586fe1, 'Très simple à réaliser et plutôt basique sur le principe mais cela n''empêche pas d''être délicieux.  Je testerai avec des petits suisses pour les calories...  Mais celà sera peut-être moins savoureux !', '2015-08-28T14:22:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, fc24d256-00bc-40b9-a2ce-bc681b74cb62, 'J''ai fait cette recette en y ajoutant du Rhum, je l''ai mise dans plusieurs coupelles et j''ai ajouté par dessus des cubes d''ananas. A servir bien frais. Le mélange est exotique ! Excellent !', '2015-07-17T01:19:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 8003dfbe-a947-48e7-8617-b1b434ba3bce, 'Excellent!', '2015-04-26T21:32:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 5f873c45-5169-4e4c-b184-1ed5051492a9, 'Très bonne recette, j''ai ajouté 3 gouttes d''huile essentielle d''orange douce et du gingembre en poudre...Je vais tester avec d''autres fruit pour voir!', '2014-11-09T20:07:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, cf71c6ae-3e19-457d-9337-c945fc30ad94, 'Excellent ! Génial pour utiliser les bananes trop mûres !', '2014-07-26T13:26:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 1f3ae295-6426-414b-b331-75e9886d1bc8, 'Excellent, simple et rapide.', '2014-05-15T21:45:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 2c270b53-4666-4146-8028-075094c5c927, 'Super ! Cette recette permet de ne plus perdre de fruits !!! Je la refais très souvent', '2014-04-27T19:00:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 64461c1c-9a06-4525-9ecf-68574227ca6f, 'Recette réalisée à l''instant. Pour ma part j''ai mis un jus de citron entier au lieu de la moitié et mes bananes étaient mures mais trop ! Même comme ça c''est délicieux !!! Je viens de goûter en remplissant les ramequins et c''est très bon. J''en ai mis la moitié au frigo à déguster bien frais après le déjeuner de ce midi et l''autre moitié au congel à deguster ce soir sous forme de sorbet. Verdict des mes gastronomes (mon mari et mon fils de 15 mois) ce soir mais moi en tout cas j''ai aimé ! Merci pour la recette', '2014-03-21T11:26:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, dab0ef2b-4e01-4b7e-a985-b575d4634906, 'Extra ! Enfin je peux utiliser mes bananes trop mûres que mes enfants refusent de goûter sous prétexte que la peau est marron...', '2013-11-18T13:56:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 07b5e5e4-29fe-48c6-8822-a9a9a5039b37, 'Simple, rapide et fait l''unanimité pour toute la famille', '2013-10-25T18:56:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 7281fbc1-fdb7-469c-9801-317b37bda7d2, 'Excellent, très doux. A déguster bien frais.', '2013-10-14T16:10:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 31fc5492-9eb2-4c3e-9397-777bde7b8e4a, 'J''ai mis plus de banane et la même dose de sucre. Un peu trop sucré a mon gout, mais un réel plaisir.', '2013-07-28T23:41:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, eaa124a9-8a4c-4495-bfd4-ca294ecc149c, 'simple, bon et rapide ! merci pour la recette.', '2013-05-07T20:20:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 5a15fdce-9240-45ef-ba6c-85300b279cd7, 'c''est un délice ! Excellent !', '2012-12-17T16:50:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 576a5d59-1aeb-4a1f-9f8c-be184de71865, 'Excellent ! Rien à redire recette au top.', '2012-11-16T11:28:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 29c7338a-ac20-4fd9-9c92-424f26bfd5cb, 'Pour une recette plus parfumée, je fais flamber 2 bouchons de rhum blanc, je mets du sirop de canne en guise de sucre et du citron vert et un peu de mascarpone; tant pis pour les calories !!!', '2012-10-23T22:02:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, ed5311e3-9aff-48db-aa67-2dc52bea38de, 'Très très bon et rapide.', '2012-09-17T06:29:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, d3f1081b-dcd5-481b-94e4-ae5d8abb4eef, 'Recette simple qui donne de l''originalité à des bananes un peu trop mûres ! Je l''ai faite avec des petits suisses aussi !', '2012-08-18T11:38:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 5c8fdcf5-cc1d-48be-9339-b96ed264e150, 'Recette faite à la fourchette faute de mixeur, et bien c''est délicieux !! Une bonne astuce pour éviter de perdre des bananes un peu mûres !', '2012-04-29T15:42:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 5c137ee6-889b-4a4c-ba1d-f0b98accd675, 'Excellent !!! Je remplacé juste la crème fraîche par un petit suisse.', '2012-03-23T22:45:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 13d986ae-18f7-4578-8582-2d38f95d6528, 'Je n''ai pas encore testé mais cela doit être bon !!', '2012-03-20T20:39:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 77cdc721-481a-489c-8be9-475a75f0ddb0, 'Très bonne recette, à faire et refaire !', '2012-02-20T20:41:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, f04bf486-865f-441c-ae12-afe7808621d1, 'Facile, bon marché et délicieux. Très pratique pour utiliser les bananes qui se dessèchent d''ennui dans la corbeille de fruits.', '2012-02-17T11:16:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, bd57c410-088b-4cfc-9570-a4b33f5a4f4d, 'Très bonne idée mais se garde pas longtemps au frigo : à consommer rapidement ! ', '2011-10-02T09:37:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, a1aec2b0-0b92-4b47-ad1c-7a4766c16a0c, 'Grands et petits ont adoré. A refaire.', '2011-05-19T11:30:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 1f091be9-8e35-4ca9-aebb-d4d430c2a2da, 'Très facile, très bon. Toute la famille aime, je refais cette recette souvent, avec fromage blanc ou crème selon ce qu''il y a dans le frigo...', '2011-04-16T13:00:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 6ce0f2b1-d46b-47ec-92c7-2dbf3a8dfced, 'Vraiment très bon ! Simple, rapide et pas cher. Une petite recette à faire et refaire ! Merci.', '2010-10-18T19:48:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 773573ca-cd33-4364-a7c2-7259184ca595, 'Mes enfants ont beaucoup apprécié cette crème, il est vrai que c''est un délice. Merci!', '2009-10-06T14:46:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, b4d4f21c-c11b-42b6-9630-955392175855, 'Recette très facile à faire et très rapide avec, en plus, des ingrédients qu''on a généralement dans ses placards, idéale! La prochaine fois je mettrais du fromage blanc plutôt que de la crème fraîche, ce sera moins calorique ...', '2009-03-09T15:54:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48894, 52856f00-fafb-4b7b-924a-6771ae7877c7, 'C''est la recette que je cherchais! Extrêmement simple et rapide à faire, très bon au goût!', '2009-03-01T16:25:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336308, a83fe4ba-e64d-4061-bed3-b9fb2cb597a2, 'Très bonne recette et très bonne, je conseille vivement !', '2022-09-27T21:11:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336308, 8a2e66ae-ee8f-4428-b2ea-d7ae2dad21d5, 'J''avais pas de jus d orange j ai pris du lait a la place pour obtenir la bonne texture et nickel', '2021-03-26T16:15:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336308, 9333a83c-9d90-4381-b2c0-e6b28c24957b, 'Délicieux.', '2019-09-06T06:28:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336308, 794b96e1-c9be-48a0-8cf2-390e243205a1, 'Très bon résultat ', '2019-08-22T04:30:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336308, c3050b3d-2249-43af-b4e6-8c46d71c8d30, 'J''aime bien', '2019-05-09T03:02:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336308, d5e9b4c8-80ef-41c3-b5c2-27342798315b, 'Super recette, je la recommande !', '2015-05-30T21:09:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220540, 6c3facbf-0719-4845-922d-6079e5f1ecca, '7.5/10 d''après mes invités.', '2022-01-30T21:31:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, f09598f8-ed7e-4eb5-b754-99806913b267, 'Hum, un régal ! Recette parfaite pour finir la pauvre banane qui se perd dans le frigo ! La prochaine fois, je n''hésiterai pas à doubler voire tripler les quantités !!!', '2014-02-13T20:29:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 0e003e7e-9fa3-472a-8c77-bbb59015910a, 'Presque parfait, à condition de modifier un peu la recette. J''ai diminué de moitié sucre et beurre. J''ai étalé à la petite cuillère et j''ai réussi à obtenir des tuiles bien fines. J''en ai obtenu une douzaine.  ', '2012-11-25T15:33:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 195039a6-09a1-43b5-98c2-d358c15ba0e4, 'Je ne suis pas fan de banane à la base mais j''ai décidé d''essayer cette recette, c''est rapide et ça se mange tout seul !', '2011-12-14T18:33:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 39b8ef2f-49f5-4615-bf75-d07d4eb8c98c, 'Tout simplement délicieux ! Au goûter, avec un café ou avec un yaourt... ', '2010-12-29T20:24:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, bdfb2354-7eb4-4bf0-87d3-d9f09fc13230, 'Excellent ! Trop bon ! Très facile à faire je mettrai peut-être un peu moins de matière grasse pour la prochaine fois. Cuisson à 200° et lorsque les bords sont dorés 170° pour le reste de la cuisson !', '2009-10-10T19:21:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 67ce7f19-6e45-441d-84b0-c407f7588f4b, 'Très très bon! Si ce n''est pas présentable, on s''en fiche après tout, ça finit dans notre estomac!', '2008-10-20T19:24:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 13752b77-ad60-4a5e-9815-4e0fe48fe52c, 'Oulala que c''est pas beau !!! Mais qu''est ce que c''est bon ! Un délice !', '2008-10-09T16:33:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 6272f1bf-8032-4d96-be46-cb20881a3d8b, 'Comment dire... Trop trop bon! Ces tuiles sont un vrai délice. Facile et rapide à faire!', '2007-10-31T18:31:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, d7c9b23d-2e4c-445f-88f5-4cb988624c14, 'Très bon dessert, même si nous ne sommes pas arrivés à faire des tuiles croustillantes, c''était plutôt comme des petites crêpes mais vraiment très bon!!! A peine sorties du four, on a tout mangé, ma fille a adoré, et les parents aussi!!!', '2006-07-02T19:16:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 97d45c97-e4ef-45cf-a21f-5c765eca4c7c, 'Excellent! Léger et super facile à faire, encore bravo!', '2006-06-20T12:18:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 296e40ee-67aa-4462-b22e-3f0c2be9279e, 'Très bon, j''ai réduit la quantité de beurre (environ 15-20g). Le tout présenté sur une assiette saupoudré de sucre glace et accompagné de rondelles de banane fraîche et de quartiers d''orange, beau dessert!', '2006-02-19T21:13:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 1b0ed93e-aedc-41e1-bc36-b57f8b4b4626, 'Je n''ai pas obtenu des tuiles mais plutôt des minis crêpes très grasses...c''est assez ecoeurant.', '2005-06-29T01:12:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 57d3bd14-5da0-4ebc-ab60-c3fc3aa99a35, 'Excellente recette et très facile. J''ai mis 2 bananes, je n''ai pas touché les quantités de beurre ni de sucre, en revanche, j''ai rajouté de la farine et 4 cuillères de lait. Délicieux! Merci.', '2005-06-21T13:50:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 9478bc40-960e-4126-a138-33ff0c79a1fd, 'Très sympas ces petites tuiles! Comme le dit l''auteur, il faut les faire cuire sur du papier sulfurisé (j''ai fait une première tentative sur du papier alu: impossible de les décoller !! direction poubelle !). Mais je me suis rattrapée sur la deuxième fournée qui était délicieuse...', '2005-03-15T15:55:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 1a040f99-d65d-4d87-bb20-88fba895ba7d, 'On sent bien le goût de la banane. J''ai mis un peu plus de farine pour épaissir un peu la pâte.', '2005-03-12T22:57:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, a5770f90-af70-4636-aae7-1a5d39acd848, 'Réalisées sur une plaque en silicone, aucun problème de décollage! Le mot tuiles n''est pas approprié puisqu''on obtient plutôt des sortes de crêpes. Euh pour 4 personnes, les quantités sont à doubler !  Mettre 10g de plus de farine et 10g de moins de beurre car les tuiles sont très "huileuses" à l''aspect. Elles sont excellentes et elle font très "grande cuisine". J''imaginerais bien une sorte de mille-feuilles avec tuile banane, mousse chocolat, tuile banane, mousse banane ou coco, etc...', '2005-03-09T17:08:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 3336b079-34ff-4274-af2d-09ae3d641ce7, 'Ca ne ressemble pas véritablement à des tuiles, mais c''est trop bon!!! J''ai ajouté des copeaux de chocolat blanc dès la sortie du four....elles n''ont pas fait long feu ces petites merveilles!!!!!', '2005-03-04T12:05:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 47b7e454-e9c1-4e86-9121-bdd5a4f2e523, 'Absolument exquis! Super à faire quand il vous reste une vieille banane un peu noire dont plus personne ne veut ! Ma 1ère fournée est restée collée sur le papier sulfurisé, mais la 2ème: impeccable sur la plaque du four préalablement beurrée et farinée. J''ai aussi remplacé le lait de vache par du lait de coco. Hum !!!!', '2005-03-03T12:41:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, f745ae0c-4d15-417d-acb8-d488e6d6d7d3, 'En fait j''ai eu les deux résultats: des tuiles craquantes et fines, et des tuiles molles et épaisses. Les deux sont bonnes (attention, c''est addictif). Seul souci : ça se conserve très mal et on a tendance à en faire beaucoup (en multipliant les proportions), donc en cas de restriction sucrée, respecter scrupuleusement la recette!', '2005-03-02T14:06:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, c3cad3fd-5957-404c-a3a0-ff530612487a, 'Délicieuses, ces tuiles... Et qu''est-ce que ça sent bon dans la maison! La prochaine fois, je mettrai moins de sucre (15g sont suffisants, je pense). C''est amusant, mais on dirait des blinis du dessert... (je les ai faits un peu épais: la prochaine fois j''essaie de les faire plus fins pour essayer d''obtenir des tuiles croustillantes)', '2005-02-17T23:27:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 18800734-8cb7-45da-888e-a6085b65a736, 'Elles sont effectivement très bonnes : la banane donne un goût assez fin mais il faut les étaler très finement sur la plaque (avec le dos d''une cuillère) pour qu''elles puissent sécher suffisamment. ', '2005-01-22T12:54:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, b8da1162-6e76-43c6-9bf1-7dd1dfa3861c, 'J''ai rajouter beaucoup de farine car la pâte était trop molle!!! Et en fin de cuisson des copeaux de chocolats par dessus les biscuits.', '2004-10-26T20:55:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, e987ae19-9e97-4026-80da-249269cfdb6d, 'Super idée! mais je n''ai pas réussi à avoir les tuiles croustillantes : trop de gras ?', '2004-09-10T22:03:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 4dd9f31b-a2bb-4d08-b9bc-03be5ef65a0a, 'Pas mal... Rapide, facile et délicieux.', '2004-09-09T15:22:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 9b0213e0-9b22-439f-bf86-9a9d98351e54, 'C''est très vite fait et pas difficile à étaler sur la plaque de cuisson... Mes enfants se sont régalés!', '2004-06-18T21:20:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 9ddefb9f-56cc-455b-81b7-69925d69929d, 'Mon amoureux en fait très souvent et c''est tellement bon... Un peu de doigté et hop! Une fine tuile qui sent bon la banane sort du four...', '2004-05-03T15:16:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 0605d5c0-a5a5-4efa-8359-8b72bfc3d77d, 'Difficile de faire une fine couche...', '2004-03-11T23:11:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27395, 1ef54847-5168-4457-a3f1-3dc1c8e01e87, 'Super bon et facile Jai mis moitié farine et moitié maizena  UN DELICE', '2004-02-20T22:39:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11111, 0b65c44f-fbbb-4ac4-bf36-d4ea3e2c2f82, 'Il est trop bon ce mille-feuille !', '2014-06-13T22:53:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53173, 9b76356e-c443-42ca-842a-31b297ba29d4, 'C''est super bon!! J''ai juste mis un peu plus de chocolat (environ 130 g ) et ajouté une couche de galettes bretonnes broyées entre la couche de marrons et la couche de mousse au chocolat. ', '2007-02-25T00:10:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229684, 579f3acd-c89f-41d9-9f22-c6fc9f61680e, 'Super bon et très facile à faire... J''ai ajouté le jus d 1/2 citron à la place du lait de coco. Je n''ai pas ajouté d''eau ni de sucre.  Une recette que je garde car tout le monde a adoré. Merci', '2014-03-16T18:03:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229684, a1cee231-43e0-4054-a770-2a1e76a3cb11, 'Personnellement je n''ajoute pas de sucre, les fruits en contiennent bien assez :-) J''ai mis un peu moins de lait de coco et ajouté un peu d''eau afin que ce ne soit pas trop écœurant. Petit plus : j''ai ajouté des glaçons directement dans le blender ! C''était frais et délicieux.', '2013-03-12T11:28:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229684, f19e90d9-8263-4546-930d-fa7b457e01f9, 'Très bonne recette ! J''ai mis la moitié de sucre et un peu d''eau pour désépaissir.', '2021-07-24T19:59:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229684, d4bfb6a8-49f4-424d-83a0-e1b4523c3f0d, 'Bon. Par contre le goût de la mangue est caché par le goût de la banane ( recette faite avec 2 mangue,2 banane,sans sucre, sans lait de coco ).', '2018-01-21T10:01:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, 932e0c59-94f9-4250-bcc9-46e2cf2d9a37, 'Je n''ai pas aimé du tout :-(', '2014-05-15T21:45:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, fcab43c9-2b51-4ab3-b1c5-a3f312a3b13e, 'Nous sommes 4 à ne pas avoir aimé cette recette. Il faudrait mélanger le chocolat avec les fruits pour que cela soit moins fade (et non pas faire une partie fruit et une autre chocolat). De plus mes feuilles avaient un goût quelque peu salé et ne se mariaient pas avec le reste. Assez déçue.', '2014-02-26T23:03:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, 7a0bef18-7275-4108-ac5d-8fe23fda5b34, 'Je n''ai pas ajouté de beurre. Recette donc très saine et légère. Facile à faire, et bonne. Tout le monde a aimé, mais pour éviter le côté pâteux, peut être mettre moins de chocolat. A essayer avec de la poudre chocolatée...', '2013-02-25T20:31:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, da408c03-6482-4962-b1ea-860b147c7005, 'Bon mais assez écœurant à mon goût ', '2011-12-18T00:07:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, cbad7f5f-30a1-4f2f-91bf-c3a0ef8577b5, 'Fait avec des dés de poires et 2 carrés de chocolat par dessus. Délicieux et fondant au four préchauffé à 220°C (thermostat 7)!', '2011-03-04T17:24:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, 383bc177-1188-463a-9492-bd0c8015fae0, 'Dessert bien agréable, les gourmands l''adorent ! Simple et efficace.', '2009-10-20T13:50:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, e3d34656-3c85-405d-b4e6-530d6569758e, 'Excellent! On a adoré. Avec des poires, des pommes, de la banane.', '2009-02-14T00:04:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, 3973c3fb-8749-4549-b6e2-7d4ff902ef19, 'Comme la note, bof... Je m''attendais à quelque chose de plus goûteux. C''est assez fade. J''ai fais deux tests, une fois flambés au rhum et la seconde fois non flambés. Le goût est meilleur flambé mais ce n''est pas appétissant à la vue. De plus, les triangles manquaient alors de croquant. Non flambés, ils sont plus croquants mais manquent de goût...', '2008-11-02T14:47:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, d0d386b3-641c-4262-905e-ad4e1871cdea, 'Très bon. Servies avec une sauce au chocolat. La prochaine fois je mettrai une boule de glace au chocolat avec.', '2008-09-09T12:09:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, 4d6b3ec7-6078-4e81-a3cc-63948bd220d3, 'C''était pas mal, mais je n''ai pas aimé le gros carré de chocolat qui donnait un côté pâteux, la prochaine fois je mettrais plutôt des pépites qui se disperseront mieux parmi les fruits.  PS : pour les bretons comme moi, évitez le beurre salé, ça casse un peu le goût!', '2008-06-06T20:50:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, 0d21bb9d-9852-41df-a6ce-22f052c9d5d3, 'Très bon, il faut juste comprendre rapidement la méthode de pliage car quand on n''a jamais travaillé la feuille de brick auparavant ce n''est pas évident, mais sinon l''originalité plait beaucoup!!', '2008-04-03T15:05:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, 12210d0c-5c81-46d2-8b92-bdd56660d554, 'C''est vraiment bon, mais moi je les ai mieux réussi avec la feuille de brick entière, j''ai aussi essayé avec des fraises c''est bon mais éviter qu''elles soient en dessous car elles se désagrègent un peu et après c''est difficile d''enlever les bricks de la plaque.', '2008-02-25T17:42:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, 480da37e-205a-44d9-ae92-525ed5a9bb47, 'j''ai essayé, c''est super bon mais il ne faut surtout pas mettre trop de beurre sinon c''est écoeurant. je les ai également faites avec du chocolat au lait, c''est plus doux en goût. bref, la recette plaît à tout le monde.', '2007-11-08T12:50:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, a282c01e-22f0-47c9-b324-0326171042c9, 'Très bon! Toutefois, il est préférable de modifier la recette. Tout d''abord, j''ai mis ue feuille de brick entière (au lieu d''une demie) sinon, elle se casse et se n''est pas facil de la plier. Sorties du four, j''ai légèrement nappé l''assiette où les bricks reposaient de chocolat. Décorer avec deux framboise par assiette, mes amonières ont vraiment fait sensation ! ', '2007-09-11T17:57:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, 5c42b38f-88b1-418c-a37f-f0281d7bd66b, 'Pas mauvais, mais sans plus...Il faut peut-être essayer avec d''autres sortes de fruits.', '2007-06-24T10:57:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, 9b44cf53-55a9-43db-a0d6-56705faa28d4, 'Très bon et très facile, il faut juste prendre le coup de main pour plier les feuilles de brick!', '2007-03-11T22:05:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, f86ab823-9822-4816-afa6-ccc482cd80be, 'Super bon! A manger tiède, c''est un délice.', '2007-03-08T20:48:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, 18db9132-f078-46ed-9029-4089d189d49d, 'Très bon dessert, simple et facile à faire. La consistance du croqaunt de la brique avec le coulant du chocolat et le moelleux des fruits est très agréable. Je conseille de faire des tous petits triangles qu''on puisse mettre entiers (ou presque) dans la bouche. Parce qu''avec le chocolat coulant c''est plus facile à manger!!', '2006-08-28T00:23:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, d2e84f7b-5177-4156-b6f1-938544f7d680, 'J''ai mis seulement les bananes dans les feuilles de bricks et je les ai servies avec du chocolat fondu et une boule de glace coco surmontée de feuilles de menthe. Très joli et surtout très bon!', '2006-03-06T16:43:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, 8d07f9a7-87d1-4435-a3b2-ab0cdd9b498e, 'Un délice! J''ai mis des pommes à la place des poires et fait revenir les bricks dans une poële beurrée. Merci pour cette recette.', '2006-02-20T18:50:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, 42bb0abf-b466-40c7-b8f7-1b1c2d706d36, 'Super bon. J''ai mis des pommes et des bananes dans les bricks et je l''ai accompagné d''une petite sauce au chocolat comme dans un des commentaires précédents. C''était tout simplement divin. ', '2005-03-09T10:19:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, 0db55c95-17d3-4b35-ba1b-7c076b1aaa1b, 'Très très bon. Pas de poire, mais un peu de noix de coco râpée. A refaire absolument!', '2005-03-03T21:14:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, ad0d9eba-f5eb-46c2-86da-369a6c3438f0, 'C''est super rapide et drôlement bon. Pour faire un dessert un peu plus sophistiqué, on peut les servir avec une boule de glace à la vanille et un couli de chocolat parsemé de quelques amandes effilées.', '2005-01-28T15:29:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31986, 20d2ffd9-39e6-4f35-a27d-adbf28702a8e, 'Au secours, mon mari me supplie tous les jours de lui faire ce dessert, léger et qui permet d''utiliser les feuilles restantes à la fin du Ramadan...', '2004-12-10T18:45:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, ad50573a-26ae-4928-8177-6c0ed2067b7f, 'Une tuerie ! C''est un régal. Jai remplacé le chocolat par du caramel. Et râpé du chocolat et ajouté quelques pépites ! ', '2019-01-26T02:11:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, e30cfd00-d1c8-44e8-88b8-321f8503ad6b, 'Très bonne recette... Mais ca manque cruellement de caramel pour un banofee non ? C''est dommage mais on s''est quand même regalé :)', '2018-03-30T08:19:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, 9f720e6f-2df2-4b0c-a93b-35736539d408, 'Bonne recette je garde !!! Fait avec du caramel au beurre salé trop bon le vrai goût d''un banofee !! J''ai pris un socle carré pour que le biscuit tienne et très bien tenu !!', '2016-08-14T14:34:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, 23f51cfa-3f4c-40e0-b587-f11ecb45cbaf, 'Très bonne recette mais je l''ai un peu modifié : 1 pot de Philadelphia nature à la place du mascarpone, pas de chocolat mais un peu de caramel au beurre salé sur le dessus, et des biscuits breton pour le dessous. Je l''ai fait en version portions individuelles dans des pots en verre et franchement c''est à tomber !!! Merci beaucoup pour la base...', '2011-06-12T02:22:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, 6579f567-4127-4b29-8148-0ddac87577df, 'Attention danger ! Impossible d''arrêter de manger de ce gâteau ! Il est très bon, pas si lourd que ça pour un gâteau à la banane et vraiment très gouteux. Tout le monde a aimé ici. La prochaine fois je le présenterai en verrine ou en coupe car le mélange miettes de petit beurre-beurre ne tenait pas comme une vraie pâte. Sinon c''est sur, je le referai (peut-être cet après-midi d''ailleurs tiens) !', '2011-04-29T13:04:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, 79bc92a8-eaeb-4c7e-9b0b-91eb75030fb6, 'Un délice ! J’ai toutefois remplacé le yaourt par du St Moret pour une consistance plus ferme et j’ai fait revenir les bananes dans un peu de beurre et de sucre. Terrible…', '2022-11-27T12:42:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, 082a07ee-e48c-438d-80de-94d54cbb4479, 'Excellent, on peut prendre de la confiture de lait pour le toffee. ', '2020-06-21T11:12:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, 9c28dd2c-424e-4057-aa83-3cee63d80e9f, 'Excellent, en suivant à la lettre la recette le gateau a très bon goût et la consistance me plaît. Merci.', '2020-04-01T23:30:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, a0a8d15f-73b9-4ec2-be4c-b0a7a76b66bc, 'J''ai adorée et même ma tante qui n''aime pas trop le sucré à adorée 
À refaire très vite ', '2020-03-23T21:08:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, 6f38e7b3-a07d-43c2-b3ab-d12f92f6a78d, 'C''est assez écoeurant et faire tenir le petit beurre écrasé est compliqué il faudrait rajouter du beurre bien qu''il y en ai déjà beaucoup. La banane est peut-être de trop !', '2020-03-20T18:29:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, 12c76339-7641-433b-86b6-537f52389626, 'C’est bon mais c’est un peu trop sucré pour moi ', '2020-03-15T15:25:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, 36e911f4-4c86-47af-90ac-9686301909e1, 'C''est bon mais la garniture est beaucoup trop liquide et dégouline dans le moule et les assiettes. Faut-il faire le cheesecake la veille? A tester dans des verrines.', '2020-03-08T14:25:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, 1812b418-b599-477c-8e6f-c1b2f030b3ab, 'Quand je le referai, je mettrai plus de chocolat car cela ne se sent pas. Ou alors, je le mettrai en couche par dessus les bananes', '2017-07-28T17:04:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, a99a226d-622e-45b3-88b3-d4a4dd6cf8bc, 'Très bon et bien équilibré ! Je n''ai pas mélangé les bananes à la crème, j''ai d''abord mis les bananes roulées dans le caramel et j''ai recouvert de la crème.... parfait !!! A refaire avec des invités, je vais les bluffer !', '2017-01-10T19:50:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, f2d65159-e80b-4940-acae-cb5198b33661, 'Top ! Vraiment un délice !', '2016-11-06T21:46:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, 1098ca9b-1f0b-4d40-877c-874bb546f1b8, 'Super recette, un vrai succès :) Par contre, je mettrai plus de beurre pour la pâte la prochaine fois, car le biscuit ne se tenait pas parfaitement. ', '2015-11-29T18:34:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, d9dde160-eb63-4e9d-80a5-8b899511ac67, 'Top ! Top ! Je l''ai servi en portions individuelles avec un peu de poudre de cacao dessus. Un délice ! Merci !', '2014-10-04T10:51:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, 3b591d81-aa87-4e3f-92ae-c0c5425f9882, 'Huuummm !!! J''ai mis 30 g de cassonade et c''est bien comme ça ! N''ayant pas de chocolat, j''ai donc fait un caramel pour napper chaque part ! Vraiment... un délice ! ', '2014-08-28T10:55:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, eb48b98f-ad64-44b9-b5bb-aa0f2aba8b86, 'Super facile, rapide et délicieux. Recette parfaite, merci beaucoup.', '2013-11-29T18:44:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72425, 7eb5d1e1-f807-4346-b32d-1bc7c03c5d23, 'Beaucoup beaucoup trop sucré à mon goût, j''ai donc doublé le mascarpone et le yaourt.. mais c''est réussi. Je retenterai avec moitié moins de sucre. ', '2013-06-02T20:32:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47675, 8f6cef10-a933-43a3-99dd-9cd41052101d, 'Bonjour, j''ai fait la quiche aux fruits elle est excellente j''ai juste ajouté un peu de rhum à la cuisson des fruits, c''est un régal merci pour cette recette (j ai remplacé le sucre par de l édulcorants)', '2014-11-10T21:00:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47675, 4af2c1c9-c285-4759-8469-c5df6aaf6a01, 'Pas mal. Le goût de la banane est prononcé. ', '2012-12-01T23:48:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47675, da324c85-13f0-432f-85b9-1d2022dc0f83, 'Très bonne tarte, riche en goût et en fruits. Je la conseille pour le goûter d''après-midi car lourde à digérer en fin de repas. ', '2006-11-26T19:31:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, 94ca88f9-2a59-4900-8005-1e55a16dba01, 'super!!!!!!!!!!!!!!!!', '2023-06-04T11:19:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, 9af21eff-9836-4b85-9345-b49c8b4671af, 'Excellent👌très rafraîchissant pour une période de canicule ☀️', '2022-07-19T18:47:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, 84adb187-6790-4f8c-af61-96218cbfdd94, 'Parfaitement parfait ! ', '2021-07-24T18:28:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, a4a7af1c-51fc-4b63-bc30-ee7e122e4372, 'Excellent.👌 👍🙂💯🙏', '2021-06-16T16:58:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, bd586586-ecde-4113-8afe-0e8899ea7269, 'C''est super bon mais il faudrait plus de fruits ou moins de fromage blanc, bravo !', '2020-08-24T16:13:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, 67387a7c-57a3-4ba6-8018-01134f3b9ddf, 'Excellent ! Le mélange est délicieux ! Je n''avais pas de fromage blanc, j''ai donc mis deux yaourts natures. Le résultat n''en était pas moins satisfaisant. Ma famille a adoré !', '2019-09-05T08:01:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, a7d4e388-7e3f-440f-9910-3e8a971716fa, 'Très très bon, super mélange !', '2017-02-22T16:52:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, 28ca28b6-e846-41db-84e7-dd27921d004e, 'Trop bonnnnnn ! J''adore le mélange banane fraise ', '2016-04-07T19:18:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, 873f6ad3-a308-4d16-9729-d0c3ed15e990, 'Woaw excellent ! J''ai ajouté des framboises c''était top. ', '2016-03-31T02:35:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, 792c2734-0531-4b1b-9a99-cf656caf449d, 'Super, j''adore les bananes et les fraises. Conclusion : ce mélange est délicieux.', '2011-05-28T14:02:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 18f2f719-7fa2-4ff5-8abf-c31f5d826ca7, 'Très bonne recette. Pour que ce soit parfait, j''ajoute de la maïzena avec le bouillon et le lait de coco.', '2016-08-11T16:03:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 2fa5398a-1ce5-4a6d-8648-88b36936f5e9, 'Très bon, fait avec 2 filets mignons laissés entiers et du vin blanc. Sans bananes mais avec des patates douces. Excellent aussi avec du riz basmati. Comme les autres, la sauce était très liquide, avec l''avantage que la viande reste bien moelleuse. Sauce à épaissir ou à réduire avant de servir. Merci pour cette recette.', '2015-11-09T02:43:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 172398ca-8b4f-4e08-8501-9a8e0f5431cd, 'TB', '2023-05-14T10:01:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 83f6ee80-ded0-459d-9676-0a995d8f0c63, 'Simple et délicieux, merci pour cette recette !', '2023-01-08T20:24:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 4a4e9130-ab87-4f78-809f-49b20a6a5b10, 'Suivie à la lettre, délicieux !', '2022-10-09T18:08:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 00e7e7f1-fd32-40e5-a4d5-edb1441b2ffa, 'Excellent ', '2021-02-22T20:42:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, f53b9417-ef15-497d-8785-76a44e2c9f8e, 'Simple et rapide.
Je rajoute de la maïzena pour lier ma sauce sinon c''est beaucoup trop liquide. 
La Sauceline en fin de cuisson convient très bien également.
Je ne fais pas revenir la viande mais je fais fondre les aromates et les épices dans de l huile vierge de coco.
Du poivron très finement émincés ajoutés aux oignons ou échalotes.

Le cury peut parfaitement être remplacé par un mélange d''épices de type mélange pour sambar indien.

On peut également ajouter du piment frais au moment de servir.', '2018-05-29T03:33:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 491bba06-84b0-4d58-89cf-aa1a5c7b8d01, 'Je remplace l''huile d''olive par de l''huile vierge de coco, comme ça la viande est beaucoup plus parfumée !', '2018-03-13T20:09:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 659df277-3939-4cd6-9ef5-12f154fc6a17, 'Délicieux. J''ai mis 10 cl lait coco et 10 cl crème coco.  30 gr râpé de gingembre suffisent !', '2017-08-25T14:51:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 97865b1c-7b98-4a25-b3cc-54dd7f055b57, 'Super bon. Faite et refaite depuis des années. Cette recette est devenue un classique de la famille.', '2017-01-16T12:38:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 4209e991-070e-4eaa-9312-91a565763d79, 'Juste un mot...excellent...merci.', '2017-01-09T14:58:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 649e9c7d-870c-4e2d-beb3-2b0d44993ae6, 'Très bonne recette mais faire mijoter la viande 10 minutes de moins. Et peut-être mettre moins de citron sur les bananes car cet agrume en couvre le goût. Mais je referai c''est sûr.', '2016-04-06T14:32:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 886c03a4-f996-4bc9-b167-f6f20eb0878c, 'Délicieux. J''ai simplement remplacé le curry par de la pâte de curry rouge (1/2 cuillère à café) —j''ai de la chance, j''habite dans un un quartier où il y a de nombreuses épiceries indiennes ! Et, comme je n''aime pas la texture des oignons, j''ai mixé ma sauce avant d''y remettre les morceaux de viande et d''ajouter quelques raisins secs, comme le suggèrent certains commentaires.', '2016-01-31T22:48:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, db5fa24c-5165-4280-aa66-c07fb4d71958, 'Délicieux, très simple, fait sans les bananes.', '2015-03-10T17:56:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, afc6be7a-e1f3-4852-8d6a-be158e3ebb79, 'Super bonne recette, j''ai rajouté de la maïzena et des raisins secs dans la sauce.', '2014-09-21T15:48:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, ad2349c8-1eb1-452b-9abf-5a3852ba3177, 'TRES BON avec l''accompagnement de bananes ! Sauce un peu trop liquide, à épaissir avec de la maïzena.', '2014-07-12T11:21:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 6427b10c-757f-4e1b-b3de-a46389ca16cc, 'Un délice ! Accompagné de riz basmati. Tout le monde s''est régalé. Les enfants ont mis de côté la banane, mais personnellement le mélange banane - viande - riz - sauce au curry m''a beaucoup plu.', '2012-11-25T16:29:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 0d465e78-d2fb-40c5-a07a-5b15af541435, 'Tout simplement un régal. J''ai ajouté 2 carottes coupées en fins bâtonnets et fariné la préparation avant de mettre lait de coco et bouillon + une pincée de piment d''Espelette. 1/2 heure de cuisson suffit.', '2012-08-09T20:53:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, d11cd11e-ddea-40ff-baef-e22db340f917, 'Normalement je ne fais que des desserts, et je me suis lancée, c''est super bon (même pour ceux qui n''aiment pas le goût de la noix de coco) et facile à réaliser. Toute ma famille a adoré ! Déjà fait 2 fois ! ', '2012-01-08T16:40:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, e4e6b61f-52d6-428a-b499-1dc5fb7d3a89, 'Facile et inratable, nous avons juste ajouté un peu de piment. C''était très bon.', '2011-11-14T00:19:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 0423ff77-4347-48dd-af74-d9b80389fcab, 'Un régal, la sauce était un peu liquide à mon gout j''ai ajouté de la maïzena. Tout le monde s''est régalé et c''est une recette simple à réaliser', '2011-09-01T21:29:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 078ba42c-4918-4780-9ea9-8b89df78eec3, 'Délicieux et très apprécié de mes invités.', '2011-04-12T15:57:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 7b0ded1d-fdad-412e-8bce-ca2593100724, 'Je n''avais pas de cube de bouillon alors j''ai juste mis un verre d''eau à la place et c''était une super réussite, mon homme s''est régalé!!! Je note cette excellente recette dans mon cahier de recettes. Merci!!!', '2011-03-03T10:42:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 681903e3-bedf-4863-98c4-54ce4e2f64cf, 'Merci pour cette très bonne recette qui a beaucoup plu à ma grand-mère. J''avais un peu peur de tenter un sucré-salé avec une personne de 80 ans, mais elle a adoré le mélange porc-bananes-lait de coco. Merci pour cette bonne idée !', '2009-05-20T00:11:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 04328710-bd25-4910-b1af-98f8faa4d285, 'Dé-li-cieux ! J''ai adoré ! La 1ere fois, je n''avais pas de gingembre, et c''était déjà très bon, et là, ce petit goût épicé, miammmmmmm !!! Je l''ai servi avec du riz et des bananes, sucrées puis plantain, et ça se mange tout seul... Merci pour la recette !', '2009-03-20T19:16:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 4690e3c5-0f08-4f19-827a-d39bbd4c9b0b, 'Très bonne recette, facile. Par contre j''ai mis seulement 1/2 banane par personne et ça suffisait. J''ai fait cuire le riz avec le reste de lait de coco. A refaire...', '2009-03-01T12:23:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, e8552ddb-5d4a-47e7-a30f-a7fe21027a67, 'Rien à redire!! Sauf que c''est excellent et que maintenant que mon beau frère l''a goûté, il veut revenir de longue manger à la maison, et mon copain me le demande souvent! C''est extra bon!!!!!!!!! Essayez c''est simple.........ment bon........', '2008-06-11T19:58:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 032d9dc7-9b00-416c-9eea-082e2598ebe4, 'Ça change. Je n''ai pas mis de gingembre car je n''en possède pas. Par contre une cuillère à soupe de curry c''est trop. Mais c''est délicieux, même les enfants ont aimé.', '2008-03-16T18:49:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 8a81a08f-b597-447e-bae9-2d1c5b0a7ee0, 'Un vrai régal ! Je n''avais pas de gingembre frais alors j''en ai mis en poudre (l''équivalent d''une cuillère à café). La banane comme légume c''est très original. Un grand bravo et un grand merci !', '2007-04-13T15:46:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, b392f827-c6e4-44ec-be40-bc5f31581e9f, 'Excellent, très simple à faire, la viande était très tendre. Une petite variante pour moi, je n''ai pas mis de gingembre, je ne suis pas fan et j''ai rajouté un peu de maïzena en fin de cuisson car la sauce était un peu trop liquide. L''association avec des bananes est intéressante.', '2007-02-19T21:01:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, 4b2794b5-7971-4b98-9bc5-12a9077a7265, 'Une réussite! Recette très simple et délicieuse ! Ma seule variante: nous n''aimons pas le gingembre frais et l''avons remplacé par du gingembre en poudre. Servi avec du riz basmati, les sceptiques du salé/sucré ont apprécié !', '2006-08-18T09:51:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43482, c6130596-c1e8-4be8-a73a-1a4b46ca07fe, 'Excellentissime! Pour ma part, à la place des bananes, mon mari n''aimant pas trop, j''avais mis dès le début de la cuisson des carottes coupées en rondelles (surgelées, ça va plus vite) et enlevé le gingembre: un résultat peut-être moins épicé mais quel régal (avec bien sur tous les autres ingrédients!!!) Merci encore pour un bon repas de Dimanche que mes étudiants d''enfants nourris toute la semaine de spaguetti ont adoré...', '2006-03-29T10:07:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166488, 32303a0c-fff2-46a0-b4cd-e5e3a40a9abc, 'Recette au top qui est devenue un classique quand j''ai du monde! Par contre moi je les fait toujours en verrines, il faudrait que j''essaye en plat.', '2015-01-17T15:25:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166488, e1fac4d1-398d-49dc-98be-1c727848d6b2, 'C''est super bon et léger. J''ai également présenté en verrine et j''ai préparé la mascarpone la veille... Un régal que je vais refaire. Merci pour cette recette.', '2018-11-14T10:05:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166488, 81231391-de03-412c-a8fa-3502400eb31e, 'Il est délicieux : j''ai suivi la recette à la lettre, merci pour cette recette. Je vais acheter un moule à cake en pyrex pour bien visualiser les différents étages : meilleure présentation pour la prochaine fois', '2011-12-02T19:19:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11063, e09739ed-b3bf-4434-922c-ef7bc3e792f6, 'Je viens de revaloriser environ 1 kg de bananes un peu mûres qu''on m''a donné aujourd''hui. Je n''ai mis d''1/2 kg de sucre et le jus d''un citron. Merci mille fois. Je l''ai goûtée encore chaude, c''est un délice. Et avec des yaourts c''est une superbe idée.', '2018-10-12T18:37:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11063, 7101339e-749f-4cce-9d57-53fa93b9802f, 'Alors moi j''ai fait une variante... j''y ai ajouté une boite de lait de coco et comme j''ai mis 600 grammes de sucre,  j''y ai rajouté de la pectine (ancel vite pris).... c''est encore trop sucré pour moi mais vraiment trop bon.', '2017-07-09T21:58:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11063, 99047262-6ac9-4636-ae9b-02e1793bd2c1, 'Excellente ! ', '2015-01-02T18:25:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11063, 07233e9b-18a4-4a55-a062-d3e59f39ccd5, 'La banane étant un fruit très sucré, 1kg de sucre c''est trop. Après plusieurs essais, je ne mets que 600 g de sucre "démérara" et sans gélifiant ni pectine. Par ailleurs, je mets une gousse de vanille.', '2009-01-04T13:10:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11063, fc5acb26-23eb-4c32-afe5-077288041683, 'Je l''ai fait avec ma machine à pain en divisant les quantités par 2. Un délice! Je vais en refaire pour offrir à Noël à mes invités. Merci ++++', '2008-11-30T16:51:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11063, e17c8613-dfdb-4254-b6d3-6fb01f00004a, 'C''est top! Sur du pain le matin...hummmmm!', '2008-11-10T21:17:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11063, aa902a00-a348-4600-a33e-11f754760853, 'Extra !!! Avec ou sans rhum !!! Surtout dans les yaourts natures, les enfants en raffolent !!', '2008-11-07T16:12:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11063, 02bdaed1-a37e-45c0-af20-7c2c5a09dc73, 'Rapide, simple et très bon... avec des crêpes. Si c''est pour consommer le matin, mieux vaut ne pas mettre de rhum.', '2008-10-25T19:06:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11063, 871cb656-be1b-454d-9bb1-d7b60360629e, 'Pas mal du tout! Je n''avais pas de pamplemousse alors j''ai mis le jus de 2 oranges et c''est délicieux! Un grand merci pour cette recette rapide et exotique!', '2008-07-18T20:51:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11063, a7db8161-efd4-45ef-b3f2-1834eb70e546, 'La meilleure recette sur les quelques que j''ai testé. le mélange pamplemousse, banane est excellent. Recette facile à faire. Il faut vraiment se retenir de ne pas finir le pot.', '2007-09-01T00:20:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11063, c8422588-0321-4880-a65d-686ac85c0270, 'Cette confiture a bien le goût de banane, elle est un peu ferme.', '2005-04-07T21:12:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26566, 0d518d42-f7d1-4014-8c06-983dfcea397e, 'Très simple et bonne. Première fois de ma vie que j''ai réalisé des bananes flambées et ce fût très simple à faire. Merci pour cette recette !', '2016-02-07T02:10:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26566, 78843b83-18e5-427f-aa03-a15fc85f9a3d, 'Agréable façon de revisiter la garniture des crêpes. Nous adhérons.', '2013-11-25T14:47:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26566, 029e9520-5994-489c-b25e-fc2c4d735268, 'Excellent!', '2013-02-03T12:23:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28744, 3560bc98-b13a-4825-906c-ef4ec5804b8a, 'Amok est un plat incontournable dans la cuisine khmère. Vous pouvez consulter quelques plats du Cambodge en cliquant le lien : https://www. Idctravel.fr/blog/plats-cambodgiens-a-ne-pas-manquer.html', '2023-11-30T08:19:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28744, 23517daa-5473-41df-9e53-df0dc5bf02b6, 'Très parfumé, j''avais d''abord compris qu''il fallait mixer le poisson ...car vous n''êtes pas allé à la ligne ...mais j''ai relu 3 fois ..:)) J''ai mis 3 tiges de citronnelle. Mon lait de Coco était très liquide et je n''avais pas de "partie crémeuse". J''aurais dû en mettre plus, mon résultat a été un peu sec. Fait avec dos de cabillaud, ce n''est peut être pas le meilleur choix de poisson pour cette recette. Mais après avoir vu le film le chauchemar de Darwin, je ne mangerai plus JAMAIS de perche du Nil, sauf à mon insu .', '2014-09-13T11:52:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28744, dafd1c24-afee-487d-a5dd-dd97c89c01c5, 'J''ai trouvé tous les ingrédients, y compris les feuilles de bananier (un peu compliqué à fabriquer en cassolettes !) perche du Nil pas terrible, mieux avec cabillaud ou joues de lotte. Presque comme au Cambodge !', '2014-03-02T20:40:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28744, 66496a69-b663-47a6-9416-3f010e4bca3b, 'Excellent !! ', '2013-01-28T12:08:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28744, bc19a4fa-7063-4532-8489-c0a8e76439d1, 'Hmmmm!J''ai remplacé le poisson par du poulet et donc le nuoc nam par de la sauce soja. Tout le monde s''est régalé, en plus c''est une recette très diététique. ', '2009-03-01T13:50:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28744, 8328254c-6c4f-43cb-969c-0d7a0e4146fb, 'Super, j''adore ce plat qui n''est pas compliqué à réaliser si vous avez tous les ingrédients...je ne m''en lasse pas !!!', '2008-11-23T14:34:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28744, c55466fd-6c27-45ab-ae42-f74e55fdac46, 'Miam !! J''ai remplacé la perche par du saumon et mis que des épinards frais. Le mélange d''épices je l''avais déjà au congélateur préparé à l''avance (quand je vais au supermarché asiatique). Très moelleux et excellent servi avec du riz au beurre.', '2008-02-26T00:40:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28744, a9d23d16-67a2-4c70-b273-1304c296fd00, 'C''est très très bon mais plus doux qu''au restaurant cambodgien. Je serai tentée de doubler les proportions d''épices.', '2006-06-04T23:22:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28744, 0c74e90c-c18f-4a37-bf75-316c15c8cd9c, 'Mille fois merci! C''est aussi bon que là-bas, et ça m''a rappelé d''excellents souvenirs ! Tous mes convives ont adoré (une vingtaine de personnes, comme quoi cette recette fait l''unanimité !)', '2005-06-23T12:48:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28744, 7abfda80-2612-4b37-a687-1368510375e0, 'C''est délicieux! On peut aussi tout préparer en vrac, arroser généreusement de lait de coco et présenter dans une noix de coco dans sa gangue. Il faut la couper en bas pour qu''elle tienne debout.', '2005-03-02T12:59:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28744, c7fdc99a-4fb4-4578-97c0-5290ea9a7970, 'Trop le top!!!', '2004-04-18T18:09:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27464, 34c33227-6078-420f-b081-9345bfe3b204, 'La recette est à modifier d''où la note de "4". Il faut mettre moins de cannelle, un soupçon de gingembre comme proposé dans un commentaire et rendre la présentation plus agréable à regarder.', '2015-01-11T17:52:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27464, 7fcc354b-ea32-49c3-9e67-52c4abd3a362, 'Très bonne recette : comme certains invités n''aimaient pas la cannelle, je l''ai remplacée par du gingembre moulu. Beaucoup de succès.', '2013-12-16T18:30:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27464, 17a6f6ca-503e-4bfb-a58e-07c394d24b9e, 'Super bon !!', '2013-02-24T13:21:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27464, 41fcbbaa-59e1-4cda-84b4-3e382524ad6b, 'Avec banane et clémentines (pelées à vif), très peu de cannelle et de poivre (à défaut de baies) et du jus de citron vert. Rapide, facile et très bon.', '2011-12-03T11:22:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27464, f8fa1abc-e3b5-465b-8124-e4cf15f6b39d, 'La présentation sera grandement améliorée en coupant en biais les rondelles de bananes et surtout en pelant "à vif" les oranges : avec un bon couteau, enlever les deux "pôles" des oranges, de qui permet de les poser à plat et d''enlever complètement les peaux orange et blanche, en suivant verticalement avec le couteau la forme du fruit. Il ne reste plus qu''à découper délicatement en tranches fines les oranges sans peau ainsi obtenues. ', '2010-11-21T11:59:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27464, ea7fcba8-d50d-49ca-9356-7db4fadf60e5, 'Il faut la laisser au frais 24h. C''est bon mais avec au moins le double de ''jus'', ce serait encore mieux. Très bien en effet après un repas copieux.', '2008-10-07T23:46:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27464, 39b5df8b-44ba-439e-bfaf-9af8cf65c820, 'Ce mélange des saveurs est délicieux, rapide et très facile pour la débutante que je suis! Un vrai succès auprès de mes amis! ', '2008-02-16T23:23:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27464, cfe71ca7-7c71-43b1-88b9-10da2b387366, 'Dessert frais et léger, à faire en hiver après un repas un peu lourd. Parfait en tous points !', '2008-02-06T19:54:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27464, ce9966fa-ba1f-4389-86a3-232f3cc42813, 'Délicieux. Une salade de fruits simple et originale. Je l''ai également réalisée avec des pommes et des clémentines.', '2008-02-04T10:51:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27464, 002f1967-15fc-45cf-b56c-e1ff96203fad, 'Excellent, les enfants ont adorés. A essayer sans hésiter vous ne serez pas déçu. ', '2008-01-30T22:32:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27464, 9572f49d-9581-4d4f-8280-d43dc25038d1, 'Je n''avais pas de 5 baies moulues, j''ai simplement rajouté un peu de poivre et c''était très bon. Dessert vite préparé et délicieux.', '2008-01-26T15:30:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27464, b364a417-8fa6-4e1a-b068-3beda02890ad, 'De quoi tromper les amis : ..."Ta salade de fruits quel parfum! Quels ingrédients as-tu utilisé?" C''est vrai que c''est vraiment subtil! Pour ma part j''ai mis : poivre blanc, noir et rose, graines de fenouil, graines de coriandre, des graines de "all spice" (qui contient de la cannelle) et des baies de canneberge trempées préalablement dans de l''eau chaude. Bien sur les baies doivent être bien dosées c''est-à-dire pas trop pour que cela reste subtil. Merci pour la recette.', '2008-01-25T20:04:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27464, 06c0e20f-5874-4ec5-af6b-26f980c91ad2, 'Très bon ! Je ne suis pas accro du poivre alors avec des fruits et en tant que dessert... Mais j''ai été conquise ! Merci pour cette recette.', '2008-01-23T22:13:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27464, b5e0332c-0f12-4816-85cf-652143779722, 'Vraiment très bon et original!! Du poivre dans des fruits... à première vue bizarre mais quel délice !! Toutes les saveurs de cette salade se marient bien entre elles. Merci pour la recette. ', '2008-01-13T22:35:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61373, c258671e-3c11-4228-afbc-a3c3ae39c723, 'J''ai respecté la recette à la lettre et résultat plus que décevant... trop compact, pas de goût. ', '2013-08-10T14:11:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61373, d3bfff1c-cbad-45e5-9617-6df55aee434b, 'J''ai mis de la poudre d''amandes sur les bananes et je trouve que c''est assez sucré. Je l''ai servi tiède. Très bon.', '2012-10-30T14:48:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61373, e0efa2f6-d28d-4182-b112-fdfbfe4e68ef, 'Ce gâteau n''avait tout simplement pas de goût, je pense qu''il faudrait y mettre du sucre', '2012-04-01T22:16:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61373, 68ca460f-4a79-485c-94c4-6a902b161821, 'Je suis très déçue du résultat : un gâteau sec, difficile à avaler. Il manque également du sucre. La prochaine fois je ne respecterai point le dosage et ferai à l’œil. ', '2011-10-02T22:55:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61373, 29e9ac5f-42a2-4141-9405-5f5ac64c5e8a, 'Le terme "clafoutis" n''est pas très approprié pour ce qui s''avère plutôt être un gâteau. J''ai également ajouté un ingrédient : le sucre (un peu moins de 100 g). Le résultat est plutôt sympa (une amie qui n''aime pas les desserts au chocolat en a pris plusieurs fois !)', '2007-11-06T18:05:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82082, 84b323d8-0883-4f21-8c6b-85043adbbe30, 'Délicieux, j''ai mis les fruits directement dans la cocotte à la fin de la cuisson, et je n''ai pas mis de noix de coco en poudre ne sachant pas quand la mettre. Un vrai régal', '2014-10-05T15:25:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28681, 7dec6403-e018-4700-8137-f9472b2e890d, 'Juste une proposition en plus: faire flamber les bananes, ça leur donne plus de goût et le chaud/froid de la recette est agréable!', '2006-07-28T18:51:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28681, 1c8e05d1-7dfb-4d31-9652-204f149e4e05, 'Très bonne recette si on change le goût des glaces de manière à rendre la recette plus "exotique"! Par exemple : glace mangue, vanille et coco au lieu de coco, framboise et fruits rouges ! Mais ce n''est qu''un avis personnel ! Bon appétit !', '2006-07-27T17:43:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43080, eae835b7-bdbc-4c7a-8c14-7d2b438adc7d, 'Sublime, un délice, je n''ai mis que 350 g de sucre, pour moi c''est parfait. Ce mélange de saveurs, il faut la goûter, pour moi c''est la reine des confitures. Bravo et merci pour cette recette.  ', '2008-10-12T21:00:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43080, 1a1c8a6b-ca3b-4e4c-ae07-b7ee2b1be488, 'Excellente recette qui ravira les amoureux de framboises et de bananes ! Réalisé avec moins de sucre (280g), mais également moins de framboises (250g) car je n''en avais pas assez, cela donne une compotée délicieuse... Encore meilleure que les délices de fruits d''une célèbre marque de compotes.', '2013-10-18T18:39:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43080, e3b65ea3-8556-4579-8501-5be84c715939, 'Excellentissime !! Suffisant avec 300 g de sucre. Pas trop cuite, ça fait une bonne compote.', '2009-07-20T13:10:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43080, 5b0491aa-0830-44c4-a56d-6a0c0470e0e6, 'Cette confiture est excellente!! Tous les goûts se superposent et s''harmonisent entre eux. Aucune saveur n''écrase l''autre, c''est très agréable au palais. J''ai réalisé la confiture avec du sucre gélifiant de peur qu''elle n''épaississe pas assez. Merci à Adeline.', '2008-04-27T17:25:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43080, 25457767-d6ec-460a-b714-7df9ab2e6206, 'Je n''ai pas encore essayé la recette, mais je l''ai bel et bien goûtée chez Adeline. La confiture est très fruitée et douce, se situant en fait entre une compote et une confiture, donc pas trop sucrée à mon goût. ', '2006-03-14T16:19:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, c4ea867b-556f-4c4d-bc0d-294581de488a, 'Je l''ai fait avec du lait d''amande, c''est délicieux ! 
', '2020-11-12T12:06:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, 31f0c45d-98e8-4bc9-87e9-6578721a6990, 'Très bon, j''ai ajouté 2 pommes et remplacé le lait de soja par du lait de coco.', '2014-11-29T10:16:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, dab35584-dc0f-4c25-a4cd-6b506082299d, 'Avec un peu de cannelle, c''est encore meilleur.', '2014-11-14T22:27:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, 4c95852b-455e-4a41-bf7b-721fbccde4e4, 'Je n''ai jamais pensé à réunir ces ingrédients dans un seul smoothie, mais cela m''a étonné. C''est vraiment délicieux !', '2021-05-23T11:01:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, c248825c-aeae-46b3-9161-4a70360106c8, 'Super délicieux et rafraîchissant', '2019-02-09T11:59:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, 1d9747c1-5dec-4045-9f12-418dc9516e47, 'Parfait, recette suivie, très bonne !', '2019-01-19T06:05:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, 7f928b9b-124f-455b-9d96-b4ccf9150547, 'Mmm! J''ai ajouté une pomme et du lait de coco/soja ! ', '2017-06-03T11:35:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, e1aff53c-895d-40b3-a46b-30d4339420ad, 'Bon, très bien pour un réveil vitaminé !', '2015-03-03T13:50:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, e29a73bc-6825-4514-a50b-976d3f36694c, 'J''ai l''habitude de faire des smoothies et pour moi celui-ci est bien trop acide... Même après avoir ajouté du miel !!! ', '2014-11-20T22:25:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, 7970dba4-728d-4277-97b3-c344afaecf54, 'Délicieux. Et pour les gourmands j''ajoute une goutte de miel...', '2014-11-20T20:20:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, aa754e9f-1305-4a86-99ca-60649f48ced9, 'Excellent ! Même mon fils de 3 ans a adoré', '2014-11-18T12:49:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, b2c4793b-48b2-4fd8-a9c4-f76b0db2e865, 'Excellent !!! A refaire chaque matin !  ', '2014-11-16T20:30:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, fcca2709-08a5-45db-beab-43abd52c5260, 'Excellent je vais ajouter de la cannelle merci !', '2014-11-15T10:26:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, 7467a37e-0d68-4f84-ac03-95f7de4a5547, 'Ils sont tous très bons', '2014-11-14T20:32:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, 21680fce-a2c0-4082-ba10-fe2c25f37150, 'Très bon ', '2014-11-14T20:18:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, 98166b95-2851-4452-b5cc-e7dce47c74f1, 'C''est des saveurs particulières mais j''avoue que c''est pas mauvais !!', '2014-11-14T19:56:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, 700f0900-78ef-4059-8073-2859b29222f5, 'Super simple et efficace !', '2014-11-14T18:50:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, d31e20f2-52db-4eca-a7fa-4bc679ab7c5c, 'Excellent.. Mais question "bon marché" je ne suis pas d''accord.  ', '2014-11-14T18:07:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, 72307ff0-4663-47e0-a7a8-be0fb9d78113, 'J''ai testé ça ce matin avec ce que j''avais sous la main à la maison, donc j''ai mis du lait de coco à la place du lait de soja. J''ai aussi ajouté un peu de cannelle suite à vos conseils et aussi une petite carotte. Et c''était très bon, et très rapide. Ah et j''ai mis l''orange pelée en entier aussi. Merci pour l''idée !', '2014-11-14T14:03:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, d86f9a36-7366-4290-b4e4-18430596c1a1, 'Super bon !!!   ', '2014-11-14T09:42:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, b1cfe252-fe40-4c13-a1ed-8a0f4ec2fb52, 'Parfait pour le matin ', '2014-11-14T09:18:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, 637a0043-b229-459d-934d-7f294d3cf33d, 'Comme dit dans les commentaires, avec un peu de cannelle, c''est encore meilleur !', '2014-03-15T22:26:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, 3c113509-890a-4194-a513-0e4c70fb8b52, 'Les quantités indiquées sont bonnes. J''ai mixé les oranges en entier et j''ai ajouté un peu de cannelle. C''était très bon.', '2013-12-14T22:10:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, 9e0c4e14-880c-45a6-99be-45f36a01cc98, 'Moi je mets directement les oranges (bon sans la peau bien sûr) dans le blender, ça revient au même, et on gagne en vitamines !', '2009-04-26T16:29:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, be2bfacf-9326-4e28-a746-93fddc1d6ebc, 'Je l''ai fait avec 2 kiwis, 10cl de lait de coco et 15cl de lait de vache, 2 oranges et 2 bananes: mes petits malades qui peinent à se remettre de la gastro m''en ont redemandé! Ça donne la pêche, c''est bon, c''est simple, bref une recette réussie, merci!', '2009-01-27T10:40:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, 24ad3509-2c79-4407-92d7-4f1250e5b162, 'FaiT avec 3 bananes et deux kiwis et les 25 cl de lait de soja. La consistance était bonne, ça aurait été un peu trop liquide avec les oranges. ', '2008-06-30T22:25:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72591, 26a4117c-960f-4015-a81a-33e1bf191bdc, 'Super délicieux et bon pour rester svelte!!!', '2008-06-26T12:17:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (195248, 67dca0f5-fccc-4464-b632-6facbfe59680, '
Une salade de fruits très fraîche
', '2023-10-07T10:32:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (195248, 4b95a565-f833-498e-83f8-e044b3bb02e3, 'Le plein de vitamines ! J''ai juste remplacé le jus des oranges par du jus multifruits.', '2011-11-09T22:16:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49045, 0f0acf63-1800-44f9-91d8-efe1d297deab, 'C''est super bon !! Merci Fanny', '2010-03-27T14:41:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (310994, dec6ae5d-bdc2-482f-825f-4505f3796918, 'Une tuerie ! Absolument fabuleux !', '2013-11-11T21:39:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72352, 157e514d-062e-46e7-bc1e-d6b539771d2c, 'Délicieux ! Pour 2 personnes, j''ai mis 125g au lieu de 100, 400mL de crème de coco au lieu de 500. Je conseille quand même de mettre moins de crème... Pour les haricots princesse, je les ai remplacé par des haricots verts fins en conserve.', '2018-06-04T23:24:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70925, 5bbbd85f-17f7-4e87-b73b-a41b2ec8f658, 'Un peu trop sucré à mon goût ', '2017-02-25T20:00:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70925, b8097f71-3f94-4f35-b3c2-41903d241fa4, 'Délicieux !!! Recette réalisée pour un petit-déjeuner entre collègues. Elles ont toutes adoré.  J''ai ajouté un peu de sucre suite à la lecture des commentaires précédents.', '2012-05-02T11:00:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70925, 342c98e0-a5d2-452f-b2cf-65d36d7d608e, 'Carrément compact ! Pas assez sucré, trop de temps passé pour un gâteau jeté à la poubelle.  ', '2011-01-23T21:59:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70925, 59f87227-bd2b-4f16-b392-b9f6d0c0e542, 'En effet, c''est super délicieux, mais attention à ne pas mettre trop de préparation chocolat/chantilly/banane entre chaque crêpe, sinon ça ressort sur les bords et c''est moche !', '2011-01-10T13:14:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70925, 29f94511-c442-43c0-85c5-21542649a520, 'C''est excellent... largement moins écœurant que les recettes avec de la pâte à tartiner... étant une gourmande, je plébiscite cette recette !!!', '2010-08-25T13:45:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33608, cbc788f3-63e5-45d1-9a36-1126f9310ee4, 'Un vrai ananas complet c''est un peu trop.', '2022-01-30T13:56:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33608, 3b07ff17-818e-4fc7-ac10-9187a84f1f01, 'Fondant et délicieux, un peu trop sucrée à mon goût mais très bon.', '2021-11-22T12:31:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33608, db54f031-7f3e-4913-835c-4afa3088305b, 'Il y a beaucoup trop d’ananas mais sinon très bon.', '2019-05-26T06:16:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33608, 508edcca-8eae-4b96-8d8e-3cd3eb7cd2ac, 'A refaire, mais personnellement, sans l''ananas', '2013-01-05T13:17:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33608, 29a04eaa-a93a-4eee-bbf5-316dbef98958, 'Un peu sucré à mon gout mais très bon quand même !', '2011-02-13T11:16:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33608, 33656ce8-7d76-4a4f-8f87-9d06b44ece79, 'Très facile, mais un peu trop sucré (pourtant je n''avais pas mis de sucre vanillé). Je diviserais la quantité de bananes par deux la prochaine fois. Mais merci pour cette super recette !', '2009-12-22T15:53:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33608, 2601b023-cc17-4129-beac-b3b49b434dfb, 'Fondant et délicieux!!!  Sur les conseils de mon épicier indien j''ai mis une épice pimentée "massala spécial grillé avec piment", ça relève bien, je vous le recommande!!', '2009-06-30T02:17:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33608, 50aedd6f-af1c-4426-afd1-5fd82d255c0c, 'Vraiment excellent pour ceux qui aiment le mélange sucré-salé. Merci à vous pour l''info de remplacer le Garam Masala par 1 mélange 4 épices. A refaire sans hésiter car très rapide et faciel... Inratable.', '2008-01-20T18:22:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33608, e37b037a-1ae6-4079-9c5c-9f3374ea676d, 'J''ai remplacé le Garam Masala par un mélange 4 épice. C''est vraiment très bon et très nourrissant. Il faudrait mettre plus de poulet.', '2007-06-07T20:17:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33608, 787e37bc-7efa-4e00-a402-9e8566944629, 'C''est vrai que c''est surprenant! Je n''ai pas mis de sucre vanillé, mais j''ai salé le plat et c''était très bien. Par contre, la présentation n''est pas jolie (lait de coco + épices + bananes en purée, ça fait une drôle de couleur), donc je pense que la prochaine fois, je le colorerai avec du curcuma, ou quelque chose comme ça.', '2005-04-21T23:50:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37615, 59c3c3ed-851c-475e-b177-7396e4df38e3, 'Le tout est assez lourd... le gâteau est compact mais avec un assez bon goût de banane. La sauce chocolat en plus rend le tout trop calorique, ensuite on s''affale au fond du canapé ... je pense qu''il faudrait réduire les quantités de beurre par exemple.', '2005-08-28T15:55:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34372, cb49cbf5-36c6-4929-9212-ae538242f6ea, 'Un flan au final bon pour ceux qui aiment ça, pour ma part je n''ai pas aimé vu que le flan n''est pas ce que je préfère mais j''ai voulu essayer tout de même. Pour la cuisson compter 35 min à peu près. Ca donne un flan nature dessous et un flan coco dessus très sucré.', '2005-08-07T21:26:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61301, 628e75b4-a0a1-473b-8cc9-bd6b8420eb4a, 'Très bon. 8.5/10 de la par de mes convives', '2022-01-29T16:53:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61301, 7e6523e8-1b49-4d08-827c-ca440f85df36, 'C''est un dessert sympa. je l''ai fait avec mon cuiseur vapeur au lieu de le faire en papillotes, comme indiqué. La prochaine fois (car il y en aura une!) je rajouterai un peu de crème chantilly.', '2009-01-23T13:24:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 77c22b8a-acd5-4883-b7f7-e57d37ae388f, 'Super bon, j''ai remplacé la poire par de l''ananas, très sucré mais délicieux !', '2023-02-17T19:39:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 42e34874-5c9a-45f3-8132-3df8c4149318, 'Délicieux Marmiton ! J''ai râpé du chocolat blanc sur les fruits avant de mettre au four !', '2022-02-28T17:37:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 3cb412ce-2ac5-4516-9d0c-613b798545e8, 'Une tuerie ! J''ai remplacé les bananes par de la pomme. Et 75g de sucre au lieu de 100g c''est excellent.', '2019-09-29T17:14:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, f286b7e6-2b38-49ca-a367-2b39f2c79b02, 'Testé et non approuvé. Poire et banane, je n''ai pas trouvé l''association bonne avec le chocolat blanc. C''était un peu écoeurant...', '2015-07-17T21:05:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 89f363ea-34e7-4365-bdec-23d54fbf78c8, 'Très bon ! Rapide ! J''ai ajouté une banane. Nous avons mangé les 3/4 à deux... Donc un peu juste pour 5 personnes... sucré mais quand on est gourmand.', '2015-07-15T22:01:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 3fd8b57e-ad2c-4275-964b-6c9763eeacf1, 'Super bon!! fait avec du chocolat blanc et aussi du noir (une autre fois) avec 60g de sucre magnifique !!', '2015-06-19T22:37:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, afbe3efa-5ac1-4a2c-ab96-f46666c21d64, 'Très rapide et délicieux, j''ai mis de la pralinoise à la place du chocolat blanc !', '2015-05-04T17:02:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, cf48fb86-bea2-44a4-ac58-f418b5c2aeb8, 'Délicieux !', '2015-04-13T12:25:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 5ba34dbc-c817-4662-8db1-5ca3f2d42bda, 'Trop bon et très facile.', '2014-12-11T20:21:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, a339c43d-879b-45d9-abe5-04cf38b448b7, 'Pas mal, moi qui suis un dingue de chocolat blanc j''ai tenté cette recette. La prochaine fois je testerais bien avec des poires fraîches et du chocolat noir.', '2014-07-21T07:53:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 162e7c8f-c194-4d53-ac1c-463cb7813d90, 'Poire/banane c''est excellent. Avec du chocolat noir c''est encore meilleur. ', '2014-06-28T19:20:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, fc32a13d-1fed-46b4-957a-dff28d761b73, 'Pas mal j''ai mis des pommes à la place de la poire et j''ai réduit le sucre à 50 g', '2014-06-12T19:56:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 8a5cc30c-7109-44df-9772-67d6eef5f20e, 'Moi aussi j''ai mis du chocolat noir à la place du blanc et j''ai réduit de 20 g la quantité de sucre : il est vraiment très beau et très très bon. Merci ! ^^ ', '2014-06-04T10:33:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 9e3545ac-4e9d-4ffc-8ed3-725d00135a12, 'J''ai adoré. J''ai mis des pêches à la place des poires. La prochaine fois, à refaire avec moins de sucre. Mais excellent quand même.', '2014-06-04T01:57:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 8b17f38a-3208-41e4-9003-88d304be3a9f, 'Délicieux ! Je n''ai mis qu''un quart de tablette de chocolat blanc et c''était excellent, je pense qu''on peut même éliminer le chocolat complètement. En le laissant bien cuire ça caramélise sur les bords, miam ! Merci pour cette recette.', '2014-06-04T00:15:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 41ff9758-177d-47e3-993a-fba9be5df7d0, 'Recette simple et bonne, à refaire avec des poires fraiches car c''est tout de même très sucré. Je la referai.', '2014-06-03T20:40:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 5d864b43-473e-4bed-8e25-5c585fec6696, 'Excellent. J''ai fait la recette exacte.', '2014-06-02T20:26:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 7c20e00e-18b9-4c5e-8475-54cd1be57a3c, 'J''ai fait la recette comme indiqué, mais à la place du chocolat blanc j''ai mis du chocolat noir c''était une tuerie. Mes invités m''ont demandé ma recette.', '2014-06-02T09:12:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 07d99d2e-8b09-4315-be2a-b4d2984a7c6d, 'Excellentissime !!!  La prochaine fois j''essaierais avec du chocolat noir', '2014-06-01T22:05:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 5ecf266d-9f13-45d0-b75d-42cedf2ca9b0, 'Très bonne recette j''ai mis du chocolat noir à la place du blanc. Recette à refaire !!! ', '2014-06-01T21:37:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 5e8eba19-472f-415b-a5d0-e278c784db9c, 'J''ai essayé avec du chocolat noir et pour la pâte à crumble j''ai ajouté de la poudre d''amande !!!', '2014-06-01T21:32:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 849268ba-08a1-4609-8abf-2a2aa0825340, 'Great !!!  ', '2014-06-01T21:16:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 6a783053-459f-424b-893e-79eb673b1640, 'C''est trop bon :-)   ', '2014-06-01T11:36:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 19e5016c-adff-419c-9ab6-af7e4bf9eb1d, 'Une recette sympathique, un petit bémol sur le chocolat blanc qui a eu du mal à fondre pour ma part.', '2009-12-07T00:05:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 121a32f5-68a2-4ff1-a418-cdc4406164f4, 'Excellent, je ne mets que 80 g de sucre et la moitié d''une tablette. A essayer avec du chocolat noir pour les amateurs, c''est super bon aussi et moins sucré.', '2009-11-24T14:37:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, d18b0c3a-97fc-4723-8b16-9896c8cf964a, 'Merci pour cette recette c''est désormais mon dessert préféré !! ', '2009-11-09T20:24:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 90f5eff4-8b30-434e-9ee8-a913f234ab8d, 'Super dessert, très facile à faire et au succès garanti. J''ai mis un peu moins de sucre que prévu et mis des ananas à la place des bananes. Je n''en ai pas eu assez, mes invités se sont léchés les babines.', '2009-09-09T12:36:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, ad41acee-be7b-4e10-996b-855261cf881d, 'Tout simplement délicieux. Mes invités étaient épatés. J''ai suivi les conseilles d''autres internautes, moins de sucre et des ananas à la place des bananes à la demande de mon mari. A refaire car super. Merci à Fanny_7', '2009-04-05T13:11:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 455e73f2-247a-4316-88c7-fc49c54c70e5, 'C''était bon. Je n''ai mis qu''une tablette de chocolat pour 6 grands ramequins et c''est juste. Un peu trop sucré à mon gout, et je n''avais mis que 70 gr de sucre. Dessert simple.', '2009-03-29T13:18:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, a176994a-e444-4d10-b571-e96ca7a59fa9, 'Hum, super bon. J''ai mis que 80 g de sucre et 1/2 tablette de chocolat blanc, tout le monde a apprécié', '2009-03-22T11:25:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, e6b7a791-4a40-4cb6-8b25-62478dbeefe6, 'Excellent, j''ai mis une tablette de chocolat blanc et un peu moins de sucre. J''ai suivi les conseilles autres internautes en remplaçant la banane par l''ananas. Résultat parfait. Mon homme a fini le plat à lui tout seul.', '2009-03-06T21:34:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 77abc623-5623-419e-bc18-e7c583c3cc22, 'Moi j''ai mis des pommes et des poires mais c''est quand mm excellent et fondant. ', '2009-03-03T16:29:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 4b1e1e14-380e-4469-9eb6-035f13719ffe, 'Très bonne recette, mais le crumble était trop friable à mon goût. Néanmoins je la referai car il n''en n''est pas resté! J''ai mis 1 tablette de chocolat blanc aux morceaux de fraises et l''ensemble était délicieux. Merci pour cette recette.', '2009-03-02T12:53:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, d479bf9e-d264-4623-8d83-2e803abd3a26, 'J''ai mis des pommes et des poires, réduit la quantité de sucre dans le crumble (car j''ai mis beaucoup de chocolat blanc!). C''était excellent! Tout le monde a apprécié!', '2009-02-28T18:09:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, b1814635-9595-4508-af20-a576036d8a4a, 'Avec des bananes c''est trop sucré, j''ai donc remplacé par de l''ananas et le résultat et époustouflant! Délicieux.', '2008-03-18T18:24:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, d4ba5d9b-ddee-431b-91a8-4188c623dc73, 'Excellente recette !!! Très apprécié par mon mari, d''ailleurs c''est lui qui la fait maintenant assez régulièrement!!!', '2008-03-16T12:18:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, f8cc747d-4c1a-42f2-be39-e14888796d4a, 'Moi, je n''ai pas mis de poires, mais plusieurs bananes. C''est très sucré mais délicieux!', '2007-10-13T19:30:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, 5409b851-11fb-4cd3-8cf3-85b6c98ecb27, 'Super bon!! Tout le monde a apprécié! J''ai mis une tablette de chocolat blanc et 90 g de sucre au lieu de 100 , sinon j''ai vraiment suivi la recette et c''etait délicieux! Je recommencerai c''est sur!!', '2007-08-14T21:49:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, a871c538-59ff-4da4-93e4-17de78c31421, 'On ne sent pas vraiment le chocolat blanc qui ne fait que rendre le crumble plus sucré et plus lourd...', '2007-06-28T23:09:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, ba21a11d-5cc3-47a2-a289-f3140cb2a94f, 'J''ai mis la moitié de sucre et pas trop de chocolat blanc, et j''ai obtenu un franc succès avec cette recette!!', '2006-04-04T16:30:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, fc563098-cc1a-4749-82e9-652a95e210e4, 'Un vrai régal. Je n''ai mis que des bananes. La prochaine fois j''utiliserai la 1/2 de sucre, c''était un peu trop sucré à mon goût. Mais autrement c''est délicieux.', '2006-03-18T21:45:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43133, db6462df-40cf-44c4-a00e-b111ce57a679, 'Bon mais un peu trop sucré à mon goût (certainement les poires au sirop). J''ai mis 2 bananes et du chocolat noir. Rapide à préparer dans tous les cas.', '2006-02-20T21:03:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57341, 94b6f23f-c3d4-47a2-b4af-37db7ae0c42b, 'Meilleur froid ; par contre, la mousse à la banane est excellente.', '2009-05-29T17:01:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57341, 6c244a81-3a1c-4726-8c7c-fdacbf156c4c, 'Cette tarte est une réussite, le contenu est très léger et mousseux. On sent très bien les bananes et l''ananas. Je n''avais pas de fromage blanc alors j''ai mis 2 yaourts à la noix de coco et ça a bien fait l''affaire. Par contre elle est nettement meilleure froide. ', '2007-08-15T14:10:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27418, acd29f52-5c34-4f41-8345-079c9e2b11bf, 'Je partage l''avis de Sandrine, c''est beaucoup trop liquide et bien trop sucré!! Le mieux est d''écraser les bananes à la fourchette avec du sucre vanillé ... c''est aussi plus simple !!', '2008-06-08T00:09:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27418, 5eca246e-f145-4953-9b29-82a3d9de57e9, 'Désolée, je ne suis vraiment pas convaincue. La compote est beaucoup trop liquide et trop sucrée alors que j''avais réduit le sucre et mis une banane en plus.', '2006-12-21T20:14:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27608, 5c742e57-0520-4f2b-9e14-501336c4d4f6, 'Très bon et même sans miel, génial. Je me suis régalée mais après t''as plus faim.  ', '2014-03-19T18:29:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27608, 9db8180b-fdf1-4d17-8d33-43bbb67b96d0, 'Très bon', '2013-02-27T14:52:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27608, 7717d6a6-acea-4a65-bfe0-a882f57cee3f, 'Super bon !', '2009-08-21T09:30:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27608, 2c470049-362d-412d-8b42-36e6a56eb5c5, 'C''est très bon mais avec un ou deux glaçons en plus c''est encore meilleur.', '2006-05-29T17:42:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13998, d39eaada-d407-4b7c-acc2-3fa4f7fc894c, 'Tout le monde sais faire des crêpes donc elle sont pas merveilleuses jai vue meilleur donc voila voila derrière cette magnifique photo bas ???‍?', '2023-10-31T16:57:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13998, 56627dd3-1f03-46b3-abd5-e8cd53fa61ef, 'Tout le monde sais faire des crêpes donc elle sont pas merveilleuses jai vue meilleur donc voila voila derrière cette magnifique photo bas 😋🤨👩‍🍳', '2020-04-22T22:25:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13998, 3471bd6e-0b9c-4c56-b7ba-b7dbff7d9828, 'J''ai trouvé ça pas mal, voire bien!!', '2005-10-26T17:19:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17610, b5905e16-2afe-4619-8985-afe55a1ee131, 'Excellent même avec les plantins qui d''habitude ne cassent pas 3 pattes au canard.. je dois avouer qu''en leur ajoutant une bonne noix debeurre et de la bannane fruit (1) + une grosse cuillère de miel sur la fin... on peut comprendre la note excellente... alphilge', '2018-04-25T03:25:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17610, 749c1db6-7e3e-40ae-bd98-4fb8e696bd1e, 'Pas mal mais pas exceptionnel. Poulet et citron se marient bien certes, mais j''ai été déçue par les bananes plantain qui ne servent un peu a rien, ce serait plus original avec de vraies bananes.  Ah et aussi dommage qu''il n''y ait pas plus de précisions dans la recette.', '2013-11-10T16:36:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17610, 499b8fec-a53f-4209-b1f1-6c52eba8533a, 'Pourquoi personne ne fait cette recette?  Bon moi je n''avais pas de bananes plantins, alors j''ai fait sans...mais cette idée de mettre du citron avec du poulet est géniale. J''avais ajouté des graines de fenouil sur le poulet...un délice! Toute la famille a adoré.', '2007-10-19T03:43:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67469, 084608f0-9f62-4bc6-a86e-44579810e64b, 'J''ai remplacé l''huile classique par de l''huile de coco, le sucre par du sucre de coco et mis noix de cajou avec pignons car je n''avais pas de noix classiques. Il me restait un fond de crème de coco, je l''ai ajouté : un régal', '2019-06-19T16:52:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67469, 8934caf1-4366-490b-b994-c65d296d87fa, 'La quantité de sucre peut être réduite de moitié. À part cela, très bonne recette, gâteau aéré.', '2023-04-19T22:44:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67469, c89adcda-9030-4ef3-9def-b0a7d8743836, 'Très simple et excellent !', '2023-01-17T20:00:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67469, 2f72745e-f286-4156-9fea-cb950cfeb651, 'Super recette, j’ai rien changé, délicieux. Ajouté à mon carnet 🤗😋', '2022-01-25T06:59:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67469, 537edd1b-eddd-4250-8801-863a56b2bdcd, 'Super bon, je dirais que c''est un plus un banana-bread, il gonfle bien. En revanche j''ai mis moins d''un demi pot d''huile et je trouve ça déjà très gras !', '2020-04-09T18:42:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67469, 1a2a1f26-0088-4795-9df0-46b2304fd0a9, 'Excellent gâteau que j''ai réalisé en muffins. J''ai mis une banane de plus et seulement un demi pot de sucre et c''était largement assez.', '2020-02-08T04:15:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67469, 8adc88c5-a2d1-40e4-bcbe-1086ae9a1e4b, 'Faite plusieurs fois.  Parfaite. Pour les gourmands de chocolat, l''ajout de pépites est recommandé !', '2019-09-03T06:08:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67469, 09f0dbbb-9f84-427a-83a1-42bfe6646732, 'J''ai fait des muffins, mon mari a adoré ainsi que mes amis du club canin, ils en veulent bien d''autres. Je referai donc cette recette sans hésitation, merci.', '2018-11-14T06:39:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67469, 6008f785-8c26-406a-bec9-a9bc671232ad, 'Excellent ! Texture légère', '2017-11-05T17:40:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67469, 1ad11b9e-7808-4877-a8b1-f45940978fd9, 'Un de mes gâteaux préférés ! Recette top ! J''ajoute quelques pépites de chocolat, et j''utilise de la farine de petit épeautre plus digeste pour moi. Parfait !', '2017-10-15T20:08:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67469, 53e5c303-261c-401f-b31a-1874dfc8c394, 'Excellent  ! Ajouter des noix sur la préparation avant d''enfourner, le goût des noix grillées est délicieux !', '2017-06-26T00:18:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67469, dba3b22f-6840-475b-ba7a-869a4b28f6b7, 'Super, gâteau aéré.', '2016-05-24T20:37:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67469, 69b2a8ed-c6a4-4021-8258-c2b4003098cc, 'Très bon et léger. Bien battre les œufs jusqu''à ce qu''ils soient blancs et ajouter un peu de cannelle. ', '2013-11-21T23:08:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67469, e09a5291-cb89-49b8-9038-c4720d7c1e31, 'La pâte crue est un délice. J''ai remplacé l''huile par du beurre.', '2012-11-18T22:30:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67469, 8cb24726-2eaf-4874-a27e-78705e65480e, 'Super, il a beaucoup plu !', '2012-07-11T17:53:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20050, 7b0b37db-9495-4017-ae71-5cb1ef0dcca8, 'Au top exellent j''ai mis en température 210 degrés 40 minutes', '2021-10-18T21:32:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20050, 053ff0ba-5bbc-4447-9066-86647faca374, 'J’ai pas aimé. Je ne sais pas si c’est la cuisson ou la recette. En tout cas si des personnes arrivent à réaliser la recette ça serait bien qu’elles mettent la température du four ça aiderait beaucoup.', '2020-12-04T20:26:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20050, a82fa172-c6be-47b7-a78f-a955a91e0138, 'Dommage il n''y ait pas la température du four !', '2019-05-25T12:12:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20050, 7ba8d53b-3864-4af9-a1f6-98656954670f, 'Je suis un homme et je cuisine et je,dois dire que c''est délicieux !', '2017-12-16T12:24:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20050, 64155e13-f575-41d9-997e-d24a77293730, 'Un vrai succès! Ça ressemble à un clafoutis!J''ai fait cette recette dans des petits ramequins, ce qui m''a donné de véritables petits gâteaux légers, moelleux et fondants! Ni trop sucrés, ni trop fades, on peut doser les fruits comme on le souhaite!', '2009-02-23T15:27:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20050, 84c0c1eb-a0ab-4b8d-82c3-57fab1a8e89e, 'Nous n''avons pas aimé, on ne sent pas du tout les bananes. Le gâteau est fade. Nous avons été déçus', '2009-01-30T14:51:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20050, a4b9e674-70d9-427d-8ed5-f9bec08a8c05, 'Cette recette est bonne et appréciée des personnes âgées car cela ressemble à un clafoutis aux pommes et bananes! Cela fond dans la bouche !', '2006-04-16T20:25:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20050, 1d73ed64-f0a3-411c-a141-e379a78f7784, 'Tout simplement léger et délicieux, la mariage de la pomme et de la banane est subtil. J''ai ajouté une cuillérée à soupe de rhum blanc pour révéler le parfum. Divin!', '2006-03-13T14:04:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20050, 45130d04-82f5-42a5-892f-4b57e99977ec, 'Nous n''avons aimés, l''ensemble était très compact et ça manquait de moelleux.', '2006-02-14T18:22:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20050, 82c0c725-dd80-432d-b034-669d03b096f8, 'C''était délicieux, avec une boule de glace en plus. Evidemment c''est meilleur chaud. Fameux. Bravo.', '2006-02-08T13:10:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20050, a8547038-e5d9-43ba-b96c-4e57a9d525cc, 'Cette recette porte bien son nom : c''est un délice... A refaire.', '2006-01-13T10:34:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20050, 18d94971-5090-46b2-a275-d0d0836937ba, 'Très bonne recette, facile, rapide et... C''est super bon! J''ai utilisé le même plat que pour les clafoutis.', '2005-08-03T18:33:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20050, e97a1ffa-8ced-4d27-86f4-3e26e504d62d, 'Bon gâteau, bien moelleux, idéal pour le petit déj.', '2004-06-13T19:42:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49736, 9f6a39a6-af29-470a-abbb-abe28e821196, 'Bof...Je m''attendais à beaucoup mieux, ce n''est ni plus ni moins qu''un milk-shake bien frais...', '2006-09-07T02:11:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19376, 98dba00f-5ae4-4d04-89dc-21419193b8e5, 'Ce n''est pas immangeable, bien sûr il faut aimer la banane, mais c''est très bon  et simple à faire ', '2008-06-06T12:40:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19376, 985b2cf4-3c5a-48ab-83b2-b3822a3152c0, 'La banane en pâtisserie : pas terrible. Cette recette n''échappe pas à la règle. C''est (quasi) immangeable !', '2007-06-10T13:32:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19376, fb9ca269-dedd-4596-9516-21cab9c06dd3, 'J''ai déjà fait cette recette! Je trouve cela délicieux. Je suis sûr que plus tard tu feras un bon cuisinier!', '2007-02-25T16:08:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85802, 996c1727-b804-4660-8fd6-139611ea3350, 'J''adore cette recette ', '2023-02-22T22:14:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309227, dfe071ca-439c-4890-91a8-ad5d405bfb45, 'Vraiment délicieux, j''ai par contre doublé les proportions pour obtenir un grand verre', '2019-06-28T13:30:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309227, 9e0b64eb-4b18-4d0f-9bbb-ba883ad7c3ce, 'Très bon et rafraîchissant, mes enfants ont bien aimé.', '2017-05-26T16:32:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309227, 9ee06c5e-ba19-4857-b0f5-40ebb3eab9b9, 'Excellente recette. Testé aujourd''hui, j''adore.', '2016-06-03T19:53:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309227, 5cc8bc22-6bfe-4035-94d5-7c321dd0af5c, 'Excellent. On sent bien le tout des fruits. J''ai mis un peu moins de banane.', '2015-07-28T23:09:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309227, 81c548d8-2416-4f7c-b5bd-42349e90b74c, 'Un peu trop le gout de la banane et j''y ajouté deux glaçons. ', '2015-05-09T17:34:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309227, 49003ac3-cda4-4718-91e8-371c10d1435c, 'Excellent avec la glace à la vanille', '2014-06-08T22:40:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309227, 847111c0-e3de-4bb0-9c39-36c7fbb89de0, 'Je n''ai pas mis la boule de glace de vanille et j''ai ajouté 3 biscuits cuillère. ', '2014-03-27T19:51:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (171098, b419fb7a-e6f2-47b8-802f-138a7235463a, 'Excellent. A refaire !', '2016-09-05T20:48:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (171098, c030184d-42f3-41c0-a0a4-8e8d9de7a2f6, 'Excellente recette, j''ai suivi vos conseils quant à réduire le sucre et le beurre, j''ai remplacé le miel par du sirop d''érable et j''ai même ajouté des pépites de chocolat mmmmm un vrai régal !!!', '2014-02-19T03:49:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (171098, a8458fa9-4ec2-4397-a1b6-0d93ef06ca19, 'M iam miam! Je ne suis pas une grande cuisinière, mais tous mes amis en ont redemandé. A refaire d''urgence !', '2012-10-25T04:40:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (171098, 74e6788d-e52b-4150-b512-00626741da50, 'Très bonne recette, simple à réaliser, et excellente. J''ai suivi le conseil de certains internautes et j''ai mis un peu moins de beurre et de sucre. Gâteau moelleux à souhait ! Merci.', '2012-01-01T19:49:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (171098, 7d9f0e2e-ee96-469c-aa72-109036802a4e, 'Excellente recette réalisée 2 fois et à chaque fois, un régal mais sans le miel au final car assez sucré et moelleux comme ça.', '2011-10-17T18:32:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (171098, aaf50d10-d352-43eb-a708-fe8430d792fe, 'Trop peu de commentaires et de notes pour un gâteau délicieux et si facile à faire. J''ai remplacé la cannelle par du rhum. Vraiment bon. Si vous n''avez pas de banane assez mure, une minute au micro-ondes, et c''est parfait ! J''ai également baissé à 175 g la quantité de sucre. On pourrait carrément la diminuer à 150 g. Je le referai sans hésiter !', '2011-05-21T20:07:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (171098, 82f7006d-2952-4a42-9be6-3e073728e307, 'Excellent. Mari et enfants se sont régalés. A refaire sans hésiter (perso j''ai mis mis moins de sucre et moins de beurre). Merci pour la recette !', '2011-03-13T10:56:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26705, 5871b53f-41a9-408f-8721-7100283e40b8, 'Simple et très bon.', '2011-10-29T22:46:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, 8c7faff1-4f37-403a-aa29-817919b739e8, 'Recette absolument délicieuse, très facile à confectionner. Comme j''ai trouvé la préparation assez généreuse, j''ai fait avec 4 ramequins et 4 bananes, mais je n''ai pas doublé le crumble. À refaire et à essayer avec d''autres fruits. Un grand merci très sincère. Bien à vous.', '2013-05-27T22:16:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, 90fd2303-039d-4504-ab59-af3468b297fd, 'Excellent , et les bananes étaient si mures qu''elles avaient un gout alcoolisé , un régal  j''avais parsemé des vermicelles de chocolat directement sur les bananes écrasées   et je ne suis pas un robot , me demande le robot  hahaha.', '2020-11-26T14:48:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, b4798e20-6e59-451e-97bc-aa293f9fc0bf, 'Waouh, vraiment un grand merci pour cette recette super facile et rapide. J''ai souvent des bananes qui ont ramollies, idéal pour cela et excellant mélange avec le chocolat et ce croquant ! Je recommande vraiment cette recette même aux débutant(e)s. Encore un grand merci MARMITON !', '2020-07-08T23:50:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, 21d686d6-86b9-492a-b155-6baf19d246be, 'Très bonne recette, simple, même sans chocolat.', '2017-06-13T22:35:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, 409943c7-4ed7-4774-8d9e-55c27d6f9fed, 'Délicieux ! Sans ajouter de sucre. Testée avec un mélange bananes mures et poires : donne un côté liquide qui se marie très bien avec le crumble. ', '2016-10-06T08:33:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, 2b7c63c9-92cd-4d9d-a765-107d2a4a440e, 'Je n''avais pas de biscuit donc j''ai mis des flocons d''avoine. Servi avec un peu de crème liquide au soja. Recette très facile et très bonne. Un bon moyen d''utiliser des bananes sur le point de passer.', '2015-11-14T21:59:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, 103e1ce0-2b51-4386-b395-10ddd49f7a93, 'Un pur délice.', '2015-06-17T19:45:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, 0f3a5770-6908-4e8f-9a5c-981c6fbbbabf, 'Trop bon aussi bien chaud que froid', '2014-12-03T20:44:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, 6b5e7dc1-b1b5-472b-8c0c-b232fb542662, 'Recette parfaite pour utiliser les bananes mures. A refaire, ma fille en redemande.', '2014-11-08T08:19:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, 2bde82e9-000a-4b4a-9807-651270b2bc14, 'Cherchant comment utiliser des bananes trop mures, je n''espérais pas trouver une recette aussi facile et rapide à faire, et avec un si grand succès assuré !  Je l''ai fait avec des gâteaux "thé". Je ne mettrai pas de cassonade la prochaine fois car c''était trop sucré.', '2014-10-01T07:27:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, c0f65e99-8435-4fd6-974f-2f213dd39f96, 'Très simple à faire ce qui permet de ne pas jeter les bananes un peu trop mûres. Pour le goûter ou en dessert fait à l''improviste au dernier moment ça fait son petit effet et c''est bon ! Alors merci.', '2014-06-27T19:59:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, 33018df2-568b-4e65-9a01-d6d682ce68a5, 'Très bon. Nous l''avons mangé froid et avons bien apprécié ce dessert', '2014-03-04T12:52:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, c9f6287b-78a6-4e55-9ba4-cd9846ac88dc, 'Recette récurrente chez nous, on laisse mûrir les bananes presque exprès ! Ça marche aussi avec des pommes ou autres.', '2013-02-24T22:27:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, 5cab08a3-18c5-43de-a25f-63418f92ea32, 'Très bonne recette lorsqu''il faut passer des bananes. J''en ai déjà refait 2 fois !', '2012-08-02T21:37:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, b96cbb3e-65f4-4dd0-948d-c9cf66149584, 'Facile, délicieux, rapide. Bref a refaire sans compter. Même résultat avec de la poire écrasée.', '2011-02-28T14:15:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83674, 5200db9e-6de5-4b14-8b8c-1915ca0242ef, 'Très rapide, très facile et qui régale les jeunes convives !!! Merci !', '2010-03-14T11:25:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28522, 6f2ed24f-3f0d-47e5-a650-c5e176ebf50d, 'Plutôt que de les présenter en forme de nems il est plus sympa de les présenter en forme d''aumonière.  Couper une banane en deux sur toute la longueur. Mettre une moitié de banane coupée en rondelles au mileu d''une feuille de brick avec 3 ou 4 carrés de chocolat noir. Rassembler les bords de la feuille au centre en "l''attachant" avec un cure-dents en bois. Mettre à four chaud 180° pendant environ 8 minutes (jusqu''à ce que ça soit doré). Servir tiède accompagné de glace à la vanille ou au pain d''épices et décoré de motifs caramélisés. Bon appétit...', '2008-03-10T00:11:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28522, 567047b2-b0f1-4153-86c9-76677fcaa5fd, 'Rapide et facile à faire. J''ai mis des pépites plutôt que des carrés de chocolat ... Je rajoute de la noix de coco râpée sur le dessus, le goût se marie bien et ça fait "déco" !!', '2007-07-07T18:28:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28522, c742b58d-a3c2-494e-a1df-f2c918edb7cf, 'Pas mauvais sans être exceptionnel. J''ai mis des pépites et j''avais fait revenir à la poêle des rondelles de banane avec du sucre glace et un peu de 4-épices. Il manque un peu de liant...', '2005-12-15T19:38:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28522, 5f2d9543-a6c9-4343-9ebc-12a02ecf9a45, 'Super bon! J''ai rajouté de la noix de coco et du pralin. On s''est régalé avec en plus de la glace à la noix de coco. Merci pour ce délice !', '2005-09-13T18:54:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28522, afd58e1a-3fa8-40e5-9d97-9cb1659c4f53, 'Délicieux. Effectivement j''ai mis des pépites ce qui est bien plus léger. J''ai également rajouté de la noix de coco dans les feuilles de bricK.', '2005-07-05T19:52:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28522, 4f999b78-ab13-4411-9301-aa0279982362, 'C''est délicieux, on ne s''en lasse pas. Toutefois, je pense que la prochaine fois je remplacerai les carrés de chocolat par des pépites de chocolat qui ne déchireront pas la feuille de brick. Facile mais qui fait de l''effet, merci.', '2005-06-23T13:36:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28522, 300c26f3-eb8f-4aea-bf57-ab62d90a0442, 'Je ne mets "que" 4/5 à cause de la présentation qui est moyenne mais très très bon avec une boule de glace vanille...', '2005-05-20T13:15:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28522, 3a5ff59e-192c-4104-bc4d-ce96d6efb884, 'Bon et rapide à faire pour dépannage.', '2005-04-17T08:24:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25611, 03263568-0fa7-448d-9232-2eb5e149bf2c, 'Mes amis tiennent une auberge, ils servent ce dessert: franc succès auprès des clients! Mais on ne sent pas trop le chocolat blanc (petit problème pour les grands amateurs...). Nous, on aime : facile, rapide; très bon...', '2006-09-20T16:23:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25611, 55b2e21d-58ab-4805-879d-8c4ad549f6bd, 'J''ai essayé avec 1 mangue, 1 banane et 1 pomme Granny (pour une note acidulée) : grand succès! Mais... c''est un peu trop sucré! Je pense qu''il n''y a pas besoin de rajouter la dose de sucre, le chocolat blanc l''est sufisamment. Au lieu de ramequins individuels, je l''ai fait dans un grand plat à gratin.', '2005-11-29T18:59:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25611, ac57b377-0682-4949-8061-5eed3e59c90c, 'Déçue... Le chocolat blanc ne se sent pas et en plus, c''était vraiment trop sucré. Mais mon mari, lui, a aimé...', '2005-02-27T18:57:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (320410, 3fc43c47-7612-4fad-90a3-bc17f3b44a3b, 'Pour ma part j''ai mis des petits morceaux d''ananas dans le fond avec le chocolat délicieux à refaire avec ma petite fille.', '2019-07-26T11:23:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (320410, 2dc18387-a7b4-4bea-9394-86eff9d62fbc, 'Il n’y avait pas écrit le temps de cuisson, j’ai laissé 10 minutes puis prolongé de 5 pour 16 miniardises avec les mêmes quantités, j’ai rajouté un peu de rhum blanc.', '2018-02-03T13:51:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 156076b0-caff-4086-b11f-8bc4eec49b8c, 'Ce n''est pas une salade de fruits !! Il faut des quartiers d''orange (ou du pur jus d''oranges, quand ce n''est pas la saison) et des citrons. Un point c''est tout. À la rigueur un peu de pêches en été qui va parfumer.', '2017-02-08T20:17:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, f082eb39-1d5b-451d-9bbd-5650fb79bf92, 'Même sans être un grand buveur, avec seulement 50cl de vin pour 6 personnes, ça ne fait pas lourd par personne ! ', '2016-08-18T21:27:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 62b81f65-407a-4a0e-a34e-0a95049f097d, 'Parfaite pour un apéritif léger en été. j''ai pris un vin espagnol. J''ai eu un peu peur en mettant les sodas, je n''ai mis que des morceaux de pêche et d''orange. Préparée une à deux journées à l''avance et conservée au frais, elle est excellente et peu alcoolisée, ce qui me plaît beaucoup. Merci pour cette recette, elle est fabuleuse.', '2006-07-12T15:13:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 962f3544-1541-4858-82fc-787bc34d3e3e, 'Excellente sangria facile à réaliser. Il faut doubler voire tripler les proportions. ', '2017-08-13T11:53:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 2a7958e9-1179-441d-9315-4c7b60ac5223, 'Excellente sangria. J''ai légèrement changé les dosages pour une préparation pour 6 personnes. 1 bouteille de 75 cl de sidi brahim, 20 cl de soda orange ainsi que 20 cl de soda citron (fanta) et 20 cl de cointreau, 90 g de sucre en poudre, 1 banane, 1 orange, 1 demi citron et 1 demi pomme. Réalisée 24h avant et mise au frais.', '2012-12-03T14:37:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 32c8131d-b7a8-4fdf-b854-3e998c996386, 'Très parfumée mais je pense que le mieux est d''ajouter le soda au dernier moment sous peine comme dans mon cas de ne plus avoir de bulles...', '2011-12-26T12:24:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 43523e16-45f0-4b83-9bee-c4412940361a, 'Très bonne. Merci', '2010-06-15T15:55:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 7c906dc6-824b-4d74-b56f-1acc802bd9dc, 'Je ne bois pas d''alcool donc je me suis fiée à la recette et elle a eu un succès fou. Comme je n''avais plus de place dans la bassine j''ai mis un peu moins de soda mais ça a beaucoup plu. Comme épice j''ai mis pas mal de gingembre (je savais que plusieurs invités n''aiment pas la cannelle).', '2008-05-23T13:17:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, e7cd2d9d-be44-4aa0-9fc5-060bc4b1b2d1, 'Un peu moins de sucre. Faite avec les fruits de saison. Appréciée par tout le monde. Préparée 2 jours avant la consommation. (prendre des fruits pas trop mûrs)', '2007-08-14T13:19:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 6e0e974a-73f0-4f69-a6f7-8e0c56cf0899, 'Préparée 2 jours à l''avance, elle était delicieuse. La preuve tout est parti. Une recette que je conserverai. Merci!', '2007-07-25T15:23:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 672ec56c-6633-45d0-b53c-5e9efacf149b, 'Je met 4 car je n''ai pas réussi à retrouver tout le plaisir d''une sangria qui m''a vraiment marqué cette été. Mais elle est vriament très bonne, moi j''ai mis une bouteille d''armagnac pour 5 l de vin et le résultat : 20 litres, 30 personnes et plus une goutte pour moi!!!', '2005-11-12T15:21:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 4cec53b1-1475-4548-b581-648ca78e49e9, 'Excellente !', '2005-07-16T19:39:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, d89f941a-6961-49fc-8f21-cba3fd9f0376, 'À faire absolumment cet été, j''ai rjouté un peu de sucre après une nuit de macération.', '2005-07-02T17:02:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, b292ca3a-d888-4a48-a251-5163ca83a78e, 'La même qu''à Barcelone ! Une vraie réussite ! Ne pas hésiter sur les épices et à préparer absolument la veille !', '2005-07-02T16:57:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 6f4b5055-c8da-4909-8341-5b2402c82210, 'Trop génial! Facile et bon j''ai eu plein de compliments...', '2005-06-28T20:01:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 982b4d35-7ec0-4e45-8ced-a0264085cabf, 'Très bonne. On retrouve le goût de celle de Granada. Juste un peu moins de soda. Elle se prépare en 2 min!!!', '2005-06-26T22:35:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 206dd09f-ee88-45b2-a922-d61596ec9be4, 'Troooooop bon! Moi qui ne suis pas très alcool j''en ai pris et repris! Et je n''étais pas la seule....', '2005-05-16T19:40:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 6bba1168-76f2-4a29-b607-4d4f2fa1ebcb, 'Trop bonne et vraiment simple à faire! Un delice à consommer avec modération bien sûr!', '2005-04-04T15:59:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, b88a7686-ce4c-45b9-87dc-22317529a3fb, 'Très très bon! J''ai fait cette recette la première fois pour un anniversaire ôù nous étions 15. Même les personnes qui n''aimaient pas la sangria ont aimé cette recette... J''en referai souvent!', '2005-03-06T19:30:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 22d59802-f352-4540-842f-9f708bf00d2b, 'Trop trop bon, je n''ai pas rajouté d''alcool fort, j''ai mis plein de fruits et c''était un régal pour tout le monde!', '2004-08-26T18:21:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 352fbfda-4122-4606-bca1-90c614c68b17, 'Début de soirée très réussi avec cette sangria. Personnellement, j''ai utilisé du vin de Côteau d''Orange et j''ai ajouté du rhum ambré avec de la cannelle (1,5 l de rhum pour 10l de vin).', '2004-02-01T19:33:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21039, 2358b055-0700-4c51-adb2-4a7cf92323f6, 'Parfait pour des soirées espagnoles!', '2003-05-26T19:11:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331223, 07560716-0dcd-49e2-ae00-fa774df05d8f, 'Très bon !
Je recommenderai de mettre moins de gingembre qu''une cuillère à café, j''en avais mis moins que cette quantité et c''était assez relevé haha', '2023-04-15T16:39:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331223, 20dc5462-f2ec-4ae7-b52d-d766d5305fc2, 'Très bonne recette, mais faites attention avec le gingembre !', '2020-04-12T17:53:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331223, 701ce40c-be54-44e1-9474-613c038d1924, 'Sympa ! J''ai plutôt pris un ratio 1 poire/1 banane mais c''est bon ?', '2019-09-04T19:50:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (331223, 76014ecc-714c-4005-b21f-1d656c7f0c78, 'Pas bon. Je ne recommande pas.', '2017-03-17T00:11:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21209, 6c3912fc-3807-40fe-ae29-9ef50fd63abd, 'Goût acceptable mais consistance pâteuse et couleur peu agréable (gris) je ne referai pas cette recette.', '2009-02-05T19:59:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344323, 08c215da-6970-4d01-a777-7b9722f3b839, 'Gâteau anti gaspi bien sympa, on peut y ajouter aussi bien du chocolat que des fruits ou des fruits secs, et nature il est très bien aussi ', '2020-04-08T20:47:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (344323, c3995275-46af-451a-a7ea-d06c57159527, 'Je la fais et la refais dès que j’ai des peaux de bananes (bio de préférence) et j’y ajoute des pépites de chocolat. MIAM ! ', '2019-10-01T02:46:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54314, 2c428ea3-fa3e-49fe-941b-762b8dddfd51, 'La pâte est difficile à étaler (j''ai d''ailleurs ajouté 1/2 verre de lait pour pouvoir le faire)! Par contre, il est vrai que le résultat en vaut la peine : un gâteau ultra moelleux et fondant à souhait, la dose épice et arôme est parfaite. A réserver peut-être pour l''hiver car pas très light!!!', '2008-04-17T17:52:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22162, eb8d96e1-00a5-48e4-aa21-a17537f9dbbd, 'A défaut de goyave, j''ai utilisé un cherimoya, et j''ai remplacé la papaye par un tamarillo. J''ai également diminué la quantité de cannelle. Très bon! ', '2016-01-01T16:31:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22162, ac53b26d-2c6c-438f-a974-1a5a69f9e16b, 'C''est très bon ça change de la salade de fruit traditionnelle ', '2015-06-16T19:32:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22162, c1deee8a-e7e0-4d7a-9c6e-7ed0ef9474d4, 'Bonne recette et très simple. Personnellement, je rajoute des litchis et une banane car c''est mon fruit préféré!', '2003-05-02T14:12:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166751, c125cb58-9113-4064-b84e-e42e9b01982d, 'Goût farineux !! ', '2020-05-04T20:47:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166751, 769cf807-4de4-44ce-922a-c5f01e39e118, 'La cuisson n''est pas exacte. La texture n''est pas agréable du tout je suis désolé mais je ne recommande pas. ', '2020-04-20T18:50:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166751, ff8ce206-16ac-4e09-94bf-2b9c5f5f9a00, 'Je n’ai mis que 200g de farine, ce qui suffisait largement ! Puis j’ai une tablette de 100g de chocolat au lait aux noisette Milka, c’était délicieux !', '2019-10-21T07:10:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166751, 54de9ed3-5049-41ab-8c22-a73cef27ef00, 'La recette est mal expliquée très mal expliquée désolé mais ce sera à revoir.', '2019-08-29T03:57:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166751, dfea1c97-02ca-45d6-b26d-8342261e29d9, 'Mes collègues en redemandent !!! ', '2019-03-11T04:48:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166751, d6dc9513-b8bc-4926-8132-de941d96e57b, 'Déçu de cette recette la texture n''est pas fameuse ce qui rend le muffin difficile à avaler...', '2015-06-23T13:24:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166751, 0aaba86a-5fc8-49b6-ba1a-060c581a7cc4, 'Vraiment pas bon, goût farineux.', '2013-01-29T20:13:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34817, b937063f-d911-4bf9-8d8f-5691469b4e70, 'Un régal !!! Et facile en plus ! Avec 650 g de fruits pour 500 g de sucre (car je n''aime pas quand c''est vraiment très sucré)... j''ai rajouté de la mûre aux 3 autres fruits ! Juste très très bon ! A vos tartines et autres gâteaux roulés !!!', '2014-06-24T21:11:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34817, ca170f33-2039-4902-a351-fc6dd5ad1f9e, 'Mmmmm, délicieuse cette confiture ! Moi j''ai mis 500 g de fraises pour 200 g de framboises, une banane bien mûre et du gingembre frais râpé. J''y ai ajouté 600 g de sucre blanc classique et j''ai laissé cuire après ébullition encore 15 min.', '2013-07-30T18:45:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34817, 511be0d7-715f-46e5-ad13-356c6c5d08f3, 'Tout le monde adore ! Je n''ai pas suivi les proportions de fruits car j''avais surtout des framboises (350 g pour 200 g de fraises, et 2 petites bananes), du coup l''apport de la banane est subtil. Quant au sucre, je suis une adepte du sucre de canne, je n''utilise jamais de sucre à confiture et le goût en est meilleur, je vous le recommande vivement ! Il suffit juste de cuire les confitures plus longtemps (On arrête la cuisson quand le doigt passé sur une cuillère trempée dans la confiture laisse une trace que le jus de confiture ne recouvre pas).', '2013-07-29T13:53:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34817, 2b0f1d2d-7dd9-43f3-b90a-d117caf93d40, 'Très très bonne ! Mais a peine 3 pots seulement ! A refaire très vite pour se régaler de nouveau ! ', '2013-06-23T00:14:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34817, c6fc1da3-9171-4a65-a15e-3dac89625933, 'Un véritable délice. Le mélange des 3 fruits est vraiment une réussite. Merci pour cette délicieuse et originale recette. ', '2010-09-26T21:11:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34817, 85041b8b-e852-4d2b-bc61-f359251ae1dd, 'attention le gout de la banane l''emporte vite sur la fraise donc ne pas sur-doser à moins d''aimer la banane )!', '2009-06-19T22:58:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34817, d9218026-9ebe-4fe2-b4ea-8eb11d1b7298, 'Très bon mais personnellement, je trouve que la banane a tendance à masquer le parfum des autres fruits. Quoi qu''il en soit, c''est la préférée de mon fils de 4 ans.  Merci pour la recette.', '2009-06-04T23:52:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34817, c90d9db0-eb47-425e-b354-95c7ce324ff1, 'Absolument délicieuse ! J''ai juste mixé les framboises avant et les ai passées au tamis car je n’aime pas les grains. J’ai également donné un coup de mixeur à la fin pour qu’il n’y ai pas trop de morceaux.   ', '2007-10-08T10:36:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34817, 92b57530-f859-47dc-8a42-3ea7d094ed08, 'Quel délice! J''ai mis 250 g de fraises et 250 g de framboises, et 2 bananes. J''ai obtenu 650 g de fruits : 400 g de sucre en poudre en ce qui me concerne + 1 sachet de "Vitpris". Cuisson de 5 min après ébullition. Que du bonheur! Bravo pour l''idée.', '2006-04-19T20:49:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34817, 58a3eb19-8e5d-4c6a-b30d-45c37639fcdc, 'C''est vrai que c''est bon et pas que pour les enfants !', '2005-05-11T19:42:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61833, a66c6385-f4e4-4ff7-b1a1-f9e55740469b, 'Le mélange mûre banane est délicieux! Mais juste un petit bémol... pour faire des smoothies très souvent, il est dommage de faire attendre au frigo, une bonne partie des vitamines s''en vont, surtout qu''il y a déjà des glaçons... tout est donc bien frais... A déguster de suite, selon moi, donc!!!', '2007-10-02T13:34:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61833, 0073efb3-30e6-46d8-bb92-0778d735f224, 'Pour 2 fjords j''ai mis 470 g de mûres, 2 bananes, une douzaine de glaçons, et j''ai ajouté 20 g de sucre parce que c''était un peu acide. Très bon! La couleur est surprenante : un beau lilas foncé !', '2016-09-18T21:11:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61833, c7de6664-0990-4ddb-a230-31cf26dd8a24, 'Pour 50 cl, j''ai mis une banane, 150 g de mûres et 1 yaourt nature sans sucre. Pour moi, la quantité est parfaite, on sent bien chaque aliment ! Je vous le conseille :)', '2015-08-20T11:23:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38448, 12dc112c-52ec-4787-ac5a-b4948a8f6563, 'Trop top, on se laisse séduire par ce succulent dessert, le mélange banane-pomme fond dans la bouche et le lait de coco donne une goutte d''exotisme. Personnellement, je vous le recommande c''est délicieux j''en aurai bien repris une deuxième fois ;o)', '2005-09-05T18:07:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55768, fb7e6613-fd3e-4d51-897a-a3d5fdb0a264, 'Grands amateurs de curry nous avons adoré cette recette, suivie point par point, à l''exception des graines de coriandre, que je n''avais pas, remplacées par de la cardamome et un peu de gingembre râpé. Comme fruits, j''ai mis une mangue, assez grosse et suffisante pour deux, et cela a donné une très belle sauce, onctueuse et savoureuse à souhait.', '2007-07-03T22:32:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55768, e466cd67-39d9-4990-a505-0b72db791802, 'Très bonne recette ; le mélange fruit- noix de coco et agneau va très bien ensemble ! Toute la famille s''est régalée ! ', '2013-12-30T12:13:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55768, 970e5e8f-5d1b-4eb0-afc1-ce58f81eb918, 'Recette excellente qui fait l''unanimité chez nous. Le plus souvent, je mets juste des bananes et des pommes comme fruits. Merci pour cette recette.', '2011-04-16T20:42:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55768, 5e1007de-7c16-4084-9afb-7fec08944cb4, 'Excellent et simple, pas prise de tête et efficace, bref, super recette ! Merci !', '2010-08-11T01:39:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55768, 3e176365-ca6d-40a2-bfcb-0adb0647fc04, 'Absolument délicieux!', '2008-03-16T16:22:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28280, 7d51c046-bd7a-484e-9b4f-a2b545a093e8, 'Le dessert est bon sans être excellent . Le rhum dans la pâte crumble ... quelle drôle d idée !! Je dois avouer que ce n est pas désagréable au gout .', '2010-02-01T21:57:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31220, 41a16c22-b3d5-4721-857e-7d926fa6ad4e, 'Frais et très bon ! Parfait après un plat léger.', '2011-05-12T12:43:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31220, 28a2a7cf-d835-499f-9c40-fb9a589f0b87, 'Très proche d''un milk-shake sans glace ce qui est parfait pour les enfants en bas âge car moins froid. (sans le rhum bien sûr). Merci !', '2010-05-03T19:53:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31220, 64faaae2-0735-432e-b9e1-d9f538a34a00, 'Très bonne idée, j''ai parsemé quelques copeaux de chocolat pour le décor!', '2007-03-15T22:27:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345030, a5fc79bc-1d16-49fc-99fe-a0a39465d280, 'Trop gras et trop sucré. Difficile à cuire. Ce gâteau n''est pas une réussite.', '2020-11-01T21:30:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345030, 245cef74-7ebc-4314-acef-e74415fd238c, 'Très bon. 2 bananes au lieu d''une et un peu moins de matière grasse : le résultat est moelleux et savoureux. A renouveler... c''est tellement simple ! ', '2016-08-30T23:04:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50743, 7774d258-05a8-4175-97e3-2ebb7636c523, 'Premier essai : recette suivie : plat et brûlé.
Deuxième essai : à 150°C et avec le sachet entier de levure : bien meilleur. Je recommande. ', '2018-11-23T10:56:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50743, 3e41eb4b-5731-4423-86c9-33817083f659, 'Très bon, j''ai ajouté une larme de rhum qui "parfume" agréablement ce gâteau.', '2012-11-02T14:50:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50743, dedd9cf2-c922-4055-a29e-563cc27aab32, 'J''ai remplacé le beurre salé par de la crème fraiche (la même quantité) et ca rend le gâteau très léger =)', '2010-03-09T21:40:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70407, 6135f8fa-58cb-4e04-97b8-b4512d2f9b10, 'Parfait', '2015-11-28T16:23:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70407, 7cfc7cc4-5116-4d39-a22c-bd8abcf9c617, 'Excellent !!! Mais sans crème fraîche sinon c''est trop lourd !', '2013-05-06T23:17:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70407, c776edd7-ba08-493a-8f4c-5a99945984e0, 'C''est un dessert très facile à faire et surtout délicieux. Personnellement, je mélange la crème fraîche (4 cuillères) dans un bol avec du chocolat en poudre.  Huuumm !!!', '2013-04-16T15:06:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70407, 5e1fd8f3-02c8-49e1-a064-ef6ba25fd401, 'C''est délicieux surtout tiéde. Moi j''ai remplacé le chocolat par du cacao en proudre. Succulent! ', '2008-10-17T15:16:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70407, 0d539547-34b9-447e-af07-978ce20152ac, 'C''est sympa. Par contre il ne faut pas trop charger en banane sinon ça fait un dessert consistant.', '2008-05-14T21:58:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70407, 11e6d84c-b5af-40d5-9b36-01fdb1c11f68, 'Trés bonne recette!', '2008-05-08T01:08:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45911, 18d9ab7c-264c-4bbb-ba42-8348c296a622, 'Bonne recette de compote de pommes à la banane, j''aime beaucoup l''association avec la coco, personnellement j''ai mis du lait de coco généreusement et j''ai saupoudré de coco râpée..', '2011-10-12T00:52:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45911, 3e014f20-8277-4528-873d-cf1bc7c28733, 'Je conseille d''ajouter du lait de coco, plutôt que la pulpe (désagréable sous la langue) - Quant à la cuisson : 5 minutes en cocotte, et 20 minutes en casseroles.', '2010-12-03T18:49:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45911, 632a1271-75a7-4d96-a63f-9db6bf5486d9, 'Je trouve que la coco n''apporte pas grande chose à cette recette', '2009-10-24T11:35:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45911, 88faa869-4463-438a-a53a-fee099a47dcc, 'Moyen... le côté paillettes de noix de coco dans la compote n''est pas très agréable, je trouve.', '2009-05-30T22:56:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45911, fcd5159d-f1e0-4114-8a01-9813fba0708e, 'Cette recette va devenir un classique à la maison, elle est excellente.', '2009-05-02T18:19:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45911, 7d03330f-982c-46d1-906f-e145438baede, 'Je n''ai mis qu''un sachet de sucre vanillé. Le deuxième n''aurait pas été de trop. Mon fils, qui en avait marre de la sempiternelle compote à la pomme ou à la poire, ne fait plus d''histoire quand je lui sert sa compote au goûter. Merci pour cette bonne recette originale! Je fais personnellement la compote à la cocotte : il suffit de 5 minutes de cuisson à partir de la rotation de la soupape.  ', '2008-05-15T16:19:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45911, b8f7dc79-c21f-4600-b54b-a821f48428e7, 'Moi qui ne suis naturellement pas fan de noix de coco j''ai adoré cette recette ! Facile en plus ! ', '2008-03-19T15:13:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45911, 0341f09c-afa1-40ea-b12a-0a7e62a24e84, 'J''ai juste rajouté un peu de noix de coco, et c''était un régal, tiède ou froid!', '2008-02-20T07:49:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45911, 1b7c2036-ded1-42dd-b6ec-fa1d1f5497aa, 'Moi aussi j''ai rajouté de la noix de coco. Un régal!', '2006-12-13T12:14:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45911, f5d9237d-e518-484d-8152-78962621a753, 'Un vrai régal!! J''ai mis plus de noix de coco que prévu et une banane en plus. Juste sucré comme il faut, avec les 2 sachets de sucre vanillé. Bien mixée, cela donne une compote à la saveur délicate de coco, adoucie par la pomme. Je la ferai à nouveau, tant nous nous sommes régalés.', '2006-10-01T17:38:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45911, 22b27402-07c0-47e5-b12a-d32aaeab3c3e, 'Très bon!', '2006-08-21T22:15:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45911, fed2c6b6-0f4d-48c1-8ab7-c87b0857aa2e, 'Simple, délicieux, efficace. Merci pour cette recette!', '2006-04-20T00:30:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45911, ca04ceb4-855e-4d4e-bd2d-fea52b2f3929, 'Délicieux!!!!!', '2006-04-15T03:01:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45911, 95b17aa7-7c51-40c8-9851-7fdc0467d628, 'Très bonne recette! J''ai rajouté un peu plus de noix de coco, car on ne la sentait pas assez... Elle est rapide et bonne!', '2006-04-13T18:09:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38765, b0b2eb3e-18c4-41ef-91b0-6ff1d47dab6f, 'Premier essai concluant... à faire et à refaire sans hésiter.', '2019-08-26T03:59:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38765, 08a320e1-2ef5-43b3-8148-c7e84bde9a91, 'J''ai mixé les fraises avec le sucre pour faire un coulis et c''était vraiment un régal ! La première fois tout avait disparu avant que je puisse y toucher ! Merci pour cette recette simplissime et très rapide, qui a été un franc succès. ', '2016-06-04T18:21:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25819, b67c3414-8b6d-4548-9701-9cfe3be613d3, 'Super recette, j ai diminuée les doses de moitie ce qui m a donné 10 pots de confiture.
J ai rajouté de la vanille liquide, un regal. La rubarbe accompagnée de tous ces fruits n est absolument pas acide.', '2020-05-04T11:05:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25819, 731f5859-d2bc-4655-b590-274d44c0629c, 'J''ai fait ma confiture avec 600 grammes de rhubarbe, 300 grammes de banane , 300 grammes de cerises, le zeste d''un très gros citron, jus d''un demi citron , 500 grammes de sucre, vanille, cardamone , cannelle, amande en poudre, amaretto. 
Le tout macère dans ma bassine en cuivre. J''espère que le résultat sera bon.', '2017-07-15T16:44:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25819, 25470ad0-e436-4124-a080-14b37c4bc5ff, 'J''ai réalisé la confiture avec un reste de rhubarbe (900 g )j''ai donc ajouté 1 banane et demi 2 orange et 2 jus de citron et j''y ai mis 600 g de sucre !!! Recette rapide , j''attends le résultat à froid mais en goûtant le petit reste au fond de la casserole je l''ai trouvé très sucré et la banane un peu trop présente!!! Merci pour la recette ça aura été ma première confiture !!!', '2015-05-25T19:57:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25819, 4fcc2d51-71cf-44fd-a0a5-8489d4fec5ea, 'Très bonne confiture. Le gout de la banane arrive en premier.', '2013-07-26T12:57:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25819, 1f30f9d9-fec7-4b6b-b28d-469ec28c1243, 'Recette excellente. A refaire.', '2013-07-02T19:43:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25819, 5098beff-6dc2-4ebd-aeda-10ebf5e9d71a, 'Facile à faire et délicieux !', '2013-07-02T16:37:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25819, 10a1dbfb-2441-4afc-a32c-2bb72625b090, 'Excellent avec moins de sucre car j''aime l''acidité de la rhubarbe.', '2013-06-29T12:11:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25819, 4be47c0c-937e-40fa-936c-6fa2e5a996ab, 'J''ai réalisé la compote pour 1kg de rhubarbe + 3 oranges et 3 bananes. J''ai ajouté 800g de sucre et j''ai tout fait cuire 30 mn en remuant. Je n''ai pas oublié le jus de citron en fin de cuisson... Résultat compote délicieuse, le goût de la banane arrive en premier en bouche suivi de la rhubarbe sans aucune acidité... C''est un pur régal... Attention, couper les bananes en petits morceaux car sinon ils restent en suspention à la fin de la cuisson de cette merveilleuse confiture... On obtient 6 pots et demi de confiture.', '2013-05-30T18:10:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25819, 3297333c-2b46-47df-a120-6e77744ff409, 'Confiture excellente , merci pour la recette.', '2011-05-08T17:22:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25819, c25f9258-97d1-4f01-b898-292dbd549f01, 'Très bonne confiture. Le mélange rhubarbe/banane est original.', '2010-08-10T13:19:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25819, d4427552-4713-48ff-a875-3e621dae2459, 'Délicieux ! Même les enfants qui ne sont pas fana de rhubarbe ont adoré ! N''aimant pas les aliments trop sucrés, je réduis toujours la quantité de sucre et ai donc là aussi réduit la quantité à 1Kg pour les quantités de fruits indiqués dans la recette.', '2010-05-20T15:22:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53637, 06ea71e2-bbde-4b2d-b9cc-ed9aa001fa43, 'En effet, c''est très bon avec des pâtes! Par contre mon compagnon n''a pas aimé...A proposer aux habitués du sucré salé.', '2007-09-01T20:53:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, b8f88491-9334-4a8f-a4ed-de8230396f59, 'Oh! chez moi aussi on fait cette recette, mais plutôt pour un dimanche soir que pour le réveillon. On peut au choix ajouter sauce madère ou lait de coco (si on cherche un effet salé ou sucré) ou même flamber au ruhm (demande un peu de pratique)...', '2006-06-22T14:46:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, d333da01-c9fa-4606-a272-e6931621e839, 'Je fais une variante pour les enfants, à savoir une banane roulé dans une tranche de jambon j''arrose de crème fraîche et saupoudre de fromage râpé ensuite une promenade au four pour faire gratiner. Bonne appétit. ', '2023-05-09T14:23:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, dd126872-1c9f-40d8-a3ac-2636ba69bdba, 'Un conseil : à faire au barbecue !', '2013-11-10T22:14:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, 513831cf-85f8-40ee-8bfe-c104d730b5fd, 'Je connaissais déjà cette recette qui est originale, facile à faire et délicieuse ! Je fais une variante : avec des tranches de poitrine très fines à la place du bacon.. Super !', '2004-09-22T13:01:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, 9502b98f-f7bd-4de1-8db7-8d59fb638cd0, 'L''idée me paraissait géniale. Un peu déçu. Peut être qu''en ajoutant un peu de cannelle ça pourrait être plus agréable. Cela reste bon !', '2016-02-09T21:50:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, f7cc3f11-83b5-4978-9e0e-94d6ca01fe46, 'Parfait ! Mélange qui peut paraître surprenant au départ mais franchement délicieux et apprécié de tous.', '2015-05-01T13:52:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, fae1b1d6-8135-4b26-931f-7aef64475843, 'Délicieux mariage de la banane et du bacon. A noter que j''ai utilisé de fines tranches de poitrine fumée car je n''avais pas de bacon, tout le monde a adoré!! 8 min de cuisson à four très chaud. A refaire!!', '2014-12-05T10:08:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, 14bba692-3db7-4ffc-a3e1-0b3cf1f5b11c, 'Trop bon !!! J''en fais régulièrement, ça change et c''est super simple.', '2013-09-12T21:43:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, fea0ba8b-5390-4c80-9a3e-1199452a5201, 'Très facile, original et délicieux ! Les invités ont apprécié.', '2013-07-08T01:00:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, 3d7af512-3332-43cf-aade-854dc26a756a, 'Une bonne idée mais les bananes étaient un peu molles en sortant du four, c''était un peu compliqué à manger.', '2013-05-06T15:30:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, c8266e34-982f-406d-ad96-2e6c05a43107, 'Tout simple à faire et vraiment bon !', '2013-03-19T11:42:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, 6cff00a5-3f0b-4e14-9a24-0a151ba47f8c, 'Je zieutais sur cette recette depuis quelques jours et hier soir comme j''ai eu de la visite j''ai testé et ben... Merci pour cette recette ! C''était trop bon !  ', '2013-03-01T23:35:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, 83feb01f-530e-4d96-8a01-2cf3e25a8502, 'Délicieux, c''est un excellent duo !', '2013-02-20T02:38:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, 7da2dd78-ca36-45ce-a4c8-a78a01ba79d3, 'Recette très originale et appréciée.', '2013-02-17T10:42:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, 20ac36eb-88c0-45d1-b473-111bd4575368, 'Très simple et très bon, tout simplement !!', '2013-02-11T23:42:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, cdd79ef0-e033-459e-b8af-32201b75b913, 'Excellent et refaire', '2013-02-09T08:31:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, b820e91f-1c7e-43a3-a4d6-57f37e9e197e, 'On peut remplacer le bacon par du chorizo doux, c''est excellent également.', '2013-02-04T21:52:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, cf4f7630-f7ee-463a-abbd-efcd2c135907, 'Pas fan de cette association.', '2013-02-04T21:29:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, f9c9f9a5-5c8c-4029-aa97-3e28b38f6c91, 'Très bonne recette toutefois je trempe mes bananes dans le vinaigre balsamique. Et j''utilise du streaky beacon que j''étire avant utilisation.', '2012-12-31T12:25:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, 739200ff-7ba7-4759-b71a-cf8fe4d24a8e, 'Super facile à faire. Je les ai faites cuire à 200°C quelques minutes.', '2012-04-12T12:32:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, f620e0ad-131b-4590-8b41-2700e1e149a4, 'Très original et vraiment bon', '2011-12-31T14:14:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, 9946a266-e2ab-4f78-ac8b-35664c45eb9d, 'Très sympa pour un apéro entre amis. Un bon mélange sucré-salé.', '2011-08-30T19:54:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26429, df4db833-7d4c-4ced-a476-4b4d287432e4, 'Je l''ai fait pour l''apéritif au réveillon ! Tout le monde a adoré et a trouvé ça très original ! Et en plus c''est facile à faire !', '2011-01-04T15:50:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28704, c26f942b-3188-4f07-b81c-496684a07fbf, 'Très bon, très fin, mais pourquoi la levure dans le crumble? Pour ce qui est du sable, j''ai trouvé qu il y en avait trop.', '2008-05-04T23:30:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28704, 050517f4-064b-4cd5-9135-5b643e582565, 'Bon, mais effectivement, beaucoup de crumble pour la quantité de fruits, et nous n''avons pas apprécié les corn flakes qui ont tendance à ramollir s''ils sont au contact des fruits. ', '2023-11-23T08:00:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28704, 915aba4b-7c1c-4b00-a517-13bdd0a74312, 'Excellent. Très bonne idée l''association des bananes, c''est fondant. J''en ai fait une autre, celle-ci est la meilleure.', '2013-03-17T23:51:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28704, fc30ef2f-a818-4630-b4ae-4ff4ae1fc2d7, 'C''est une très bonne recette ; je mets toujours dorénavant des corn flakes dans mon crumble ; c''est divin.', '2009-01-18T13:11:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28704, 856db21d-08f4-4932-b7da-633b85ea7157, 'L''idée est au départ très bonne : le mélange pommes-bananes est délicieux mais l''ajout des pépites de chocolat enlève tout le goût, nature c''est meilleur!!', '2007-05-05T00:53:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28704, 7ef66f3c-ab67-40bc-b53e-d96d18d028c9, 'Absolument délicieux... Je n''ai pas utilisé de corn flakes, mais c''était rudement bon quand même!', '2006-10-02T18:56:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28704, cc123e61-3e83-4164-92d6-2edc9ed32e22, 'Très bonne recette et joli mélange de saveurs... mais il faut choisir des fruits bien mûrs, sinon ça manque de jus. J''ai aussi rallongé le temps de cuisson à environ 55/60 min.', '2006-03-15T14:22:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28704, c0ec7100-c6c3-4cf5-997a-44b19c2281aa, 'Une cuisson un peu plus longue pour ma part, mais un résulat formidable. A essayer absolument!', '2004-11-13T19:36:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20573, 20460af3-5717-4b17-9848-50a3d70c8ae9, 'Réunionnaise moi-même, j''ai été assez satisfaite du résultat sauf que j''ai fait l''erreur d''utiliser une poêle antiadhésive. Grave erreur! Ne pas hésiter à les frire (ou utiliser peu d''huile mais un minimum) car sinon ils sont trop secs. Le cumin est l''ingrédient qui donne le goût particulier du bonbon piment, ne pas le négliger! L''idée du yaourt est bonne mais attention, abuser de ces bonnes choses rendraient le plat principal et le dessert bien difficiles à avaler dû à un estomac trop rempli!', '2006-11-12T11:23:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20573, 5226ba81-7953-4001-8531-e970e8d44fa9, 'Excellent ! Je n''ai pas fait de boulettes mais des disques pour qu''ils ressemblent plus à ce qu''on trouve à la Réunion ! Très bon dosage des épices on retrouve vraiment le goût des bonbons piments traditionnels !!', '2016-03-02T15:08:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20573, 27bbc6d8-6df4-40f2-a90d-53ed40dfcdca, 'J''ai fais les bonbons piments ils ont adoré (je suis réunionnaise) mais j''ai mis plus de piments prevue.', '2013-05-08T09:41:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20573, b0f0a6a3-a51b-4382-830f-c833f111c227, 'C''est la première  fois que j''en fait. Pour les faire cuire, j''ai fabriquer la forme en utilisant deux petites cuillères pour réaliser des bouchées en forme de quenelles. Je les ai trouvées un peu sèches, j''ai donc fait une sauce à partir de gaspacho dans lequel j''ai ajouté une petite boîte de concentré de tomates pour la colorer et l''épaissir et du piment à mon goût.  J''ai disposé ensuite chaque bonbon chaud dans une coupelle contenant la sauce froide. Délicieux', '2011-11-12T14:48:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20573, 79860a6d-5fb1-457d-a951-eb42fabc69b8, 'J''ai suivi la recette en divisant les proportions par 2 (c''était un premier essai, je ne voulais pas en faire trop). J''ai juste eu un peu de mal pour mixer les pois du Cap (il faut quand même un hachoir puissant), et j''ai dû ajouter de la banane pour que la pâte s''amalgame suffisament. Du coup j''avais des morceaux de pois un peu gros dans mon appareil par rapport à ce que j''avais pu goûter à la Réunion. Côté goût par contre c''était plus que satisfaisant. Je conseille de goûter la préparation crue pour bien doser les quantités de sel et de piment.', '2007-03-09T17:30:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16442, 5842ff50-c4a9-4299-969f-29cea6e6aa6e, 'Très bonne recette. Comme je n''avais pas de mixer, j''ai passé les bananes à travers un tamis. Le résultat était trop liquide pour que le bavarois prenne, mais en revanche mon copain et moi avons pu déguster une très bonne mousse de banane. Et on a adoré! J''ai aussi doublé les feuilles de gélatine pour une meilleure tenue.', '2009-02-15T14:18:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16442, 1caf3e2d-5d21-4cb7-b42c-744026918df0, 'Goût = ok , couleur = peu mieux faire , démoulage = bof . Je pense que la prochaine fois j''essaierais avec de l''agar-agar car là, la partie supérieure est restée dans le fond du récipient au démoulage. Pour améliorer la couleur du dessert, je pense qu''il faut plutôt utiliser de la vanille en gousse ; le jaune ressortira davantage.', '2008-10-13T15:03:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16442, dfa5f8db-2bca-4dd7-a603-a6b7a22bf5bf, 'Excellent et très léger ! Je sers ce bavarois dans des verres que je décore de quelques framboises.', '2007-12-10T08:55:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16442, c7bb8363-67c4-4b5b-9382-f642cb0991f6, 'C''est bon et frais, j''ai doublé la quantité de crème fleurette pour la chantilly, le bavarois est ainsi plus aérien et augmenté d''une feuille la quantité de gélatine. Puis, 1 nuit entière au réfrigérateur pour un parfait démoulage.', '2007-01-05T21:10:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16442, 93a7a840-0e66-43ab-b26a-e16bb1860005, 'J''ai testé avec des pèches au sirop (1 grosse boîte) et j''ai ajouté une feuille de gélatine en plus. Fin et léger. A réfrigérer une nuit pour une bonne tenue.', '2005-06-28T18:24:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16442, f0fbd231-3efa-4e1b-867d-55b51f223aca, 'Je l''ai essayé, mais la consistance n''est pas la bonne puisqu''il s''est affalé après démoulage! Heureusement que je ne recevais personne! :( Peut-être faudrait-il mettre plus de gélatine?', '2002-11-16T11:58:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (173794, ad48cc2d-445a-416b-b0a5-88f880edbecd, 'Un peu déçue, la mousse de nutella est tout simplement excellente, cependant il faut penser à faire tremper les gâteaux dans de l''eau et du sucre, autrement c''est sec et personnellement nous n''avons trouver aucun intérêt de faire ça en charlotte ! Je garde donc la recette de côté pour la mousse de nutella qui est parfaite.', '2011-07-24T12:11:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36818, 4be43e9d-bbc9-41d8-bcd7-b224fbf14701, 'Super bon.', '2017-02-07T10:46:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36818, 3e7e8cd4-4781-4428-86a1-552b3a3648ee, 'Quel délice, ça m''en met l''eau à la bouche ! Étant une grande gourmande et fan de banane et chocolat, cette recette est l''une de mes favorites et celle de mes fils aussi !', '2012-02-01T09:22:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36818, 11ed1aca-d606-49a7-b9ee-b227894f491c, 'Super simple ! Et quel délice ! Je n''ai pas mis de beurre. Pour le chocolat, je n''avais pas de chocolat à dessert, j''ai pris une tablette de chocolat au lait... résultat : terrrrible ! Merci !', '2011-01-24T22:13:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36818, 271aa7c6-4e8b-4dee-9b89-0493041a5e28, 'Facile à faire, les enfants ont étaient fier d''avoir fait eux-même leurs tartes..et quant on a pas de tablette de chocolat, le nutella va aussi bien!', '2010-02-20T10:58:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36818, 0ef48c54-9b15-48b9-bfff-377d1a8d38b7, 'Excellent!! Il n''en est pas resté une miette!!! J''ai mis la sauce au chocolat directement sur la tarte à la sortie du four c''était un régal! Merci pur cette recette!', '2007-11-09T20:20:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36818, 40de6569-4c9f-4670-a4de-fb2e09fac061, 'C''est bon il est vrai mais sans plus. Sympa quand des amis débarquent à l''improviste. Rapide et facile.', '2007-01-14T00:57:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36818, 2b346d18-7517-4555-b358-2cdb9132e776, 'Très facile, très rapide et très bon! Merci !', '2006-10-25T16:48:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36818, e33d353b-9201-4f57-ab69-943117d78a89, 'Recette facile pour les nuls comme moi, j''ai réussi et c''était bon, seul regret, en préparation je rajouterai peut être un peu de jus de citron par dessus le sucre la prochaine fois. Merci!', '2006-08-20T14:09:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36818, 1abd464a-52c5-4a4f-8681-140acd74ad29, 'Très facile à faire même par des enfants (ils vont adorer).  Par contre, mettre 1/2 tablette de chocolat pâtissier et 10 cl de crème fraîche sinon, il y a tellement de chocolat que l''on perd le goût de la tarte. ', '2006-04-28T17:58:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36818, 8d48b77b-7bfa-444b-9b75-708724463560, 'Testées ce soir: excellentissime et pourtant si simple! Mes enfants se sont régalés, voilà la solution pour écouler les bananes mûres que personne ne mange à la maison ! Merci.', '2006-02-19T21:18:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36818, 6eb068a8-60c0-4e6b-b3fa-c8b04620ad6d, 'Le mélange chocolat/bananes est toujours aussi bon!  C''est là qu''on se rend compte, qu''avec pas beaucoup d''ingrédient, on peut faire quelque chose de très réussi et de super simple!!!! ', '2005-12-17T12:59:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16261, bcdfca77-7a4a-4b22-8eab-f4b30b77ecab, 'C’est très bon, très consistant mais on ne sent pas trop la banane et trop la cannelle dommage.', '2020-11-11T17:29:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16261, 31d2ecd5-fe79-4f54-8b6b-ddb79df4e1d8, 'Gâteau facile à faire mais sans goût..', '2016-03-16T13:57:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16261, 2f520a9d-7776-4378-9277-ab5a68cbec84, 'Gâteau très bon !!!!! Très facile...', '2015-02-01T06:44:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16261, 365fc675-649a-4b5f-b11b-8b9af72e4ce8, 'Je suis d''accord c''est dur à mélanger, mais c''est très facile à faire surtout quand on est débutante !! Je suggère de mouliner ou écraser les bananes pour que ça se mélange mieux et que se soit meilleur sans morceaux.', '2009-08-24T18:13:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16261, a1832675-91b6-4270-b171-bcb1130f05a5, 'Bon ben navrée d''être la seule à ne pas aimer (du tout): d''abord c''est impossible de mélanger farine, sucre, oeufs sans aucun liquide, ensuite après une heure de cuisson, gâteau toujours farineux, donc 30 min de plus et toujours immangeable. Bref, je ne le recommande pas!', '2005-02-25T11:26:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16261, 7f92f6f8-4659-437d-9738-d4f40a2ac8e1, 'Excellent et léger! J''ai remplacé 60g de farine par de la maïzena.', '2005-02-13T13:24:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16261, 0aa655ef-2b84-4a1c-8087-10ab0691f309, 'Gâteau très bon! Je n''ai mis qu''une banane et j''ai rajouté de la noix de coco en poudre.', '2004-09-26T13:54:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16261, 1ebc48df-db8e-4148-8aea-174a033e468c, 'Simplement délicieux. Je n''ai mis que 50g de sucre car les bananes étaient très mûres. Rien à ajouter.', '2004-06-07T09:55:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16261, 018ad3e2-4533-4dae-8834-069540391bab, 'Excellent!', '2003-11-16T15:38:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16261, 03426679-db5d-4640-a2e4-29430eaee1cd, 'Excellent et onctueux. Pour le citron, je n''en mets qu''1/2 et c''est largement suffisant.', '2002-12-14T11:49:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16261, 2a6a1c40-73dc-4564-931b-f057f699ac3c, 'Très bon!', '2002-08-05T18:05:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16261, 0c0ba330-947d-4db6-a24f-1743a4fcd7c9, 'Excellent gâteau, de plus sans matière grasse! Pour ma part j''ai rajouté un yaourt, de la noix de coco rapée et des graines de sesames sur le dessus et le résultat n''en fut que meilleur.', '2002-07-31T08:54:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26942, d23a2755-fcbf-40cf-a719-fa2e39f5b540, 'Je l''ai réalisée avec un peu moins de banane car leur goût domine trop celui de la pêche (330 g pour 1 kg de pêches) et de sucre (550 g), pas de beurre non plus, cuisson 30 minutes et c''était très bon ainsi.', '2014-09-10T12:16:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26942, f7570d5a-4af4-4a3c-8623-e832e85294dc, 'Quel est l''intérêt du beurre dans la confiture ?? Sinon c''est très bon à condition de réduire le sucre et d''allonger le temps de cuisson.', '2009-08-11T20:13:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26942, 69b21bc5-9797-4cdb-ac73-b0ceb9cfc2ba, 'Très bonne confiture. J''ai utilisé 1,3 kg de pêches pour 500 g de bananes et je n''ai pas mixé les fruits.', '2008-07-26T00:05:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26942, c3988a13-5ff7-4905-a62b-86d16490614c, 'C''est très bon, mais il faut mettre nettement moins de sucre (550g) et cuire plus longtemps.', '2008-06-16T21:46:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26942, ce1c85e9-5093-49a6-9120-9f496f147906, 'J''ai fait cette recette avec un peu moins de banane et du sucre blanc à la place du roux (il me manquait des ingrédients!) et elle est excellente comme ça aussi, et facile à faire! ', '2007-08-27T15:37:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26942, 09e12965-4d31-4da6-8c9d-c6dd97532d7b, 'Originale  et...délicieuse! ', '2005-06-15T21:44:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312835, f733cf76-be10-49f1-9424-5f391d562dbe, 'Délicieux ! Perso, je n''avais que des oranges sanguines sous la main ; le jus caramélisé avec le sucre est un régal. Le chocolat fondu est presque de trop.', '2016-03-13T17:33:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312835, 139526df-241c-4d58-9c38-7310840619e6, 'J''ai fait revenir les bananes en morceaux dans le beurre, le sucre, et le jus de citron, les ai retirées et fait caraméliser le jus de cuisson seul (sinon, j''aurais obtenu de la compote de bananes). Je n''ai pas ajouté de zeste d''orange (remplacé par quelques gouttes d''Angostura). J''ai également remplacé la ganache par de la glace au chocolat. Et surmonté le tout de Chantilly. Au final, un très bon dessert !', '2015-01-11T11:12:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, 6c34eee8-2ada-4dec-9c8b-0f1804f022ac, 'Facile, rapide et très bon. Je m''attendais à ce que ce soit très sucré mais pas du tout... J''ai accompagné avec de la glace à la vanille et du chocolat.', '2017-07-03T23:06:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, 6e803cdc-754d-4f46-b66d-d1600ad775d9, 'Extra, très facile et très rapide. Cependant il faut réduire la dose de miel pour éviter que ce ne soit trop sucré.', '2017-03-19T13:23:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, 24696c7f-f4d4-4847-9d14-b1a8062030e3, 'Bien doser le miel pour éviter que ce ne soit trop sucré mais sinon très bon. Cela change des bananes rôties que je faisais dans un mélange beurre/sucre...Excellent avec une boule de glace crème de vanille.', '2012-02-20T13:09:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, 932d5dcc-cfec-4eb2-afa7-45e4a2314152, 'C''est bon mais un peu trop sucré, même en réduisant les doses de miel, n''hésitez pas à bien laisser réduire le mélange miel citron.', '2012-02-15T12:14:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, c3fc12fd-d223-4eda-b00d-77c09a2ad6bc, 'Ultra simple et bon.', '2011-07-05T20:34:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, 831d2344-3baf-4b0e-915b-0d94acdf073c, 'Très bien! Je l''ai fait pour mon menu de Saint Valentin comme suggéré par l''équipe Marmiton !', '2011-02-15T16:13:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, 98ade8b1-633b-4770-a6c9-764e1d4ed8ad, 'J''ai rajouté une boule de glace vanille... Toute la famille a adoré!    ', '2009-03-02T05:51:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, 42495203-39ca-4c4a-84ef-18afdf9387bd, 'C''est bon, mais un peu trop sucré à mon goût...', '2008-12-23T02:37:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, a3b82cdd-c3b7-4d26-b6e8-452b5cb48955, 'Très bon, rapide et simple, on peut adapter le citron et le miel selon son goût, dessert très sympa!', '2008-05-12T16:17:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, b06c3c1a-a504-4bb2-a9e3-2c00bf9ea36e, 'C''est bon, facile à faire et rapide à préparer. Un dessert simple.', '2008-03-20T20:37:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, ae281927-d00b-4f5d-b496-b06573793d5c, 'Trop bon!!! Très rapide et extra ! Merci pour cette recette :)', '2008-02-16T20:53:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, c00db9c3-916c-406b-bb1e-d24a4e1c6994, 'Délicieux !!', '2008-02-15T21:40:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, de4d4c52-23ee-4ffb-892b-bf987474b70d, 'Mon cheri a adoré, c''est un vrai délice.', '2007-04-01T23:01:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, c164a6b6-320e-4a5b-a2b0-e554c3bc5e7b, 'Super bon, super simple, enlevez juste un peu de miel si vous n''aimez pas les desserts trop sucrés.', '2006-06-08T16:09:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, 3b749e64-2a90-4d03-bd6e-bccab52bef78, 'C''est très bon. Il faut juste doser la quantité miel-citron, selon le goût de chacun. Cette recette est aussi extrêmement facile!', '2006-01-15T01:48:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, 23a904ae-241a-4d46-a365-dd5f9a18f56c, 'Facile, agréable, rapide à faire. Une cuillère à soupe de miel suffit, idem pour le citron. Petit plus: faire flamber les bananes au rhum...', '2005-02-14T23:13:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, cce8909a-7b23-4ff1-8590-39d7619cdf37, 'Très bon dessert, vite préparé. Il suffit d''adapter la dose de citron... Un, c''est peut être beaucoup, à ce moment-là un demi suffit pour commencer, on peut en ajouter s''il en manque.', '2004-08-08T12:00:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26577, 9464f577-97f3-4b97-b518-7dac2ac1cb65, 'Beaucoup trop de citron! On ne sent même plus le goût de la banane. J´ai même dû finir l´assiette de mon ami... Obligée de rajouter du sucre dessus pour avoir l´impression de manger un dessert... Bien déçue!', '2004-02-16T16:49:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52308, 808a57f4-b06e-4d10-9191-910dfc553597, 'Surprenante association de la figue  fraîche, de la banane et de l''huile d''olive (un petit filet !). Il faut bien faire dorer la surface de la tarte, c''est délicieux !', '2020-01-04T11:03:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (89009, e0982cf9-e118-491d-b039-73538048122c, 'J''adore le sucré-salé mais le mélange courgette-banane ne fait pas bon ménage, d''autant plus sur une pâte sablée.', '2017-02-10T20:14:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 8e51d30f-3063-4938-9b5e-67a1ec8f6966, 'C’est devenu un de mes classiques à l’apéritif. Tout le monde adore, il n’en reste jamais. Peut se faire à l’avance et réchauffer au micro-ondes 1 ou 2 min juste avant de servir, ce que je trouve bien pratique.', '2022-10-15T17:30:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 19bf9490-16d3-4f37-845d-4ec22a541901, 'Mélange étonnant et délicieux qui a fait l''unanimité. Utiliser du chorizo doux car le fort masque le goût de la banane. Les rondelles de bananes doivent faire le double des rondelles de chorizo et être ajoutées en fin de cuisson pour les tiédir, leur faire prendre la couleur et les enrober de miel sans qu''elles se défassent.', '2018-10-16T20:42:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, e5bac4c1-eeb6-49c6-9978-335750a24f47, 'J''étais sceptique mais les invités ont adoré... original et facile à faire. J''ai fait dorer les bananes dans un peu de beurre avant d''y ajouter la cassonade. Préparé en avance, réchauffé une minute au micro-ondes avant de servir.', '2020-01-04T07:56:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 9c8485e2-f597-4784-99a6-82ed4eb16b8f, 'Très très bon et original ! Par contre il faut vraiment couper des tranches de bananes épaisses et les mettre au dernier moment dans la poêle pour très peu de temps car sinon ça devient de la purée...', '2014-01-28T23:10:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, dd023c13-5028-4f1e-be02-33b59eccf864, 'Succulent ! Une recette que je vais systematiquement quand je reçois a manger, meme les plus sceptiques se regalent 😋', '2021-04-26T12:34:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 6a4e17cf-89af-46a7-9156-250a429bb796, 'Très original. Chorizo deux fois moins épais que la banane, très bien. Ca a beaucoup plu. ', '2016-05-15T23:45:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 8b27ec84-6c97-40a3-97cb-65885c0356bb, 'Vraiment délicieux mais la prochaine fois je ferai des tranches plus fines pour le chorizo.', '2015-10-02T11:09:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 0e3f7b73-787c-40c0-879e-a5dac13ef70e, 'Très bon ce petit amuse gueule sucré salé! Mais ne prenez pas du chorizo trop fort sinon on a plus trop de goût ! ', '2013-09-21T05:00:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, ef657f27-75df-4d9d-a287-27998765e611, 'Très bon mais reste très sucré et gras puisqu''on cuit le chorizo', '2013-04-26T02:25:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 4b713734-77b1-4b9f-9d4b-902bccffd1d4, 'Bon avec un rosé frais.', '2023-08-30T13:36:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 6fe3cab0-b675-4fe2-879e-b3269fc0e893, 'Le mariage chorizo et banane est délice. ', '2023-01-16T08:51:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 44f9f13d-2305-48d8-a411-515f031938ef, 'Ouhaou tropisme et rapide 👍', '2022-05-03T12:03:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, cbcca3cd-be66-4cc9-ae77-a1f4312255c3, 'Très original pour recevoir des invités et surtout très bon.', '2018-11-11T22:49:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, eb740b83-1b8d-4c3f-b943-8370157d792f, 'Original surprenant et délicieux.
Faire des tranches de chorizo plus fines pour l''équilibre banane chorizo', '2018-10-29T05:23:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 7662de67-c44a-44a2-8562-b6496436ce7a, 'C''est très bon, la douceur de la banane contre balance bien le piquant du chorizo. Cependant la présentation laisse un peu à désirer car la banane se défait à la cuisson.', '2018-04-02T08:25:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 2187b55d-6a8a-452a-a611-b66604d1bfce, 'Très bonne recette, mes invités ont aimé', '2016-12-12T12:29:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 7f3ffd33-3f87-4acf-bb79-a80e7cae299e, 'Très bonne recette ! Mes invités ont été surpris et ont adoré ! Par contre la prochaine fois je prendrai un chorizo doux car le chorizo fort prend le dessus sur la banane. ', '2016-10-22T01:07:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 5c8d741b-5908-497d-9dcf-e467bbee2077, 'Super bon et original.', '2016-08-14T12:36:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 0d7dcec0-57ca-484c-b61e-e1f7427359b3, 'Ne pas faire des tranches trop fines de banane sinon elles ne tiennent pas à la cuisson... Mais j''ai fait plus fin avec le chorizo. Pas light du tout mais super bon et original !', '2016-06-30T14:00:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, c2b84319-b097-47fa-b9ea-888b8e9d86e2, 'Excellent ! C''est à présent un incontournable ! ', '2016-05-15T21:31:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 989e37a3-f585-46c0-bfbc-747b6a8e63d6, 'EXCELLENT ! Le mélange sucré-salé est parfait ! Original et rapide à préparer.', '2015-12-28T20:29:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 7a11df19-376e-4572-9337-79b5764c8a26, 'Très bon, faire des tranches plus fines', '2015-12-25T14:46:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, ad24c568-a868-4a96-a7db-5448265fe3a8, 'Mélange surprenant, pas mauvais du tout même si le chorizo prend un peu trop le dessus pour moi !', '2015-10-26T21:53:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, f5499a9b-6d34-4c49-8b8c-2502dc3e8868, 'Simplissime et super bon ! ', '2015-10-20T20:13:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, d50400da-76c2-4dad-880f-cc0039c8879e, 'Rapide simple et bon, très bien pour un petit apéro improvisé.', '2015-09-23T22:14:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 4c824039-3875-4e72-ace9-be4d5fab474d, 'Super rapide et super bon !!! vive le sucré salé !', '2015-09-11T20:53:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 59dcbdc6-d297-4765-8ce6-3b8e85e80801, 'Très original et super bon. J''ai mis de la cassonade et servi froid (car température très chaude) et c''était parfait.', '2015-09-01T20:42:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 1d629a50-150a-4f46-abfc-c8d4de8cc225, 'Simple et bon.', '2015-08-23T14:47:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 7cfbfc00-7659-406a-a435-a0efd1f71091, 'Un vrai régal, mes invités ont été ravis. j''ai fait revenir seulement les chorizo à la poêle puis mis les tranches de banane et dans le four.', '2015-07-04T14:01:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 449fa717-6e2a-4081-a72a-f2fc297c3364, 'Super bon et cela épate les convives', '2015-06-29T23:06:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, d7e8d9da-e428-4dc6-839e-a62db2612714, 'Grand succès ce midi, à refaire !', '2015-06-28T20:57:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, e5a732c4-448e-4804-9751-f33e4eedee8c, 'Un super sucré salé ! merci !!! ', '2015-06-26T23:55:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 2dcd185e-2fc0-477c-bba3-74c770eb2a3b, 'Très bon, mettre les morceaux de bananes en dernier. A refaire', '2015-02-17T00:31:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, cdcaea76-82f8-480d-a8c5-ff0391c3f657, 'Délicieux et très rapide à faire. J''ai utilisé de la cassonade pour caraméliser le chorizo ', '2014-12-26T23:16:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 5e64772e-aa43-4c63-90c2-d28ed15b826b, 'J''étais un peu septique avant de tester et finalement c''était très bon, tout le monde a aimé ! En plus, c''est original.', '2014-12-07T01:50:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 09926c59-2b16-4924-bd18-e74fe6b8bb74, 'Super bon et facile. Le mélange est surprenant', '2014-06-01T15:00:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, a4af5449-f5eb-43df-8f60-57e2ff7308a1, 'Super bon, j''adore !', '2014-05-20T00:20:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 37f36c47-1a01-460b-9894-ea463544270b, 'J''ai pris du chorizo piquant malgré les commentaires et j''ai adoré ! A refaire je prendrai cependant du doux car le goût qui reste en bouche est trop fort ds un apéro comprenant d''autres mets. Dans un diner tapas, à mettre vers la fin ;)', '2014-02-11T22:45:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, b0fa3665-91fd-4115-8ddd-33200d7f588d, 'Très bon ! Même si la prochaine fois je ferai des tranches plus fines et je mettrai du chorizo doux... A essayer avec de l''ananas !!', '2013-12-01T13:55:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 8e71d22c-3607-4e6e-ad82-607bad5955f4, 'Invités d''abord sceptiques, et très vite conquis ! C''est original, rapide à faire et bon !', '2013-06-25T19:34:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, efef8952-014c-491e-a063-bb0759a21930, 'Pas mal ! J''ai trouvé que le chorizo prenait un peu trop le dessus mais le mélange est osé original et réussi.', '2013-05-20T22:13:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, a0e242c0-1cf2-4ddb-9bc7-8f6801f93050, 'Mes invités ont adoré ! À refaire.', '2013-03-24T17:42:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, faba6aa3-0e0b-4d09-9159-8a7c9c44ff4f, 'Excellent !!!!', '2013-02-16T00:17:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, dcc92879-0cab-4dc5-8c3b-0046c209e937, 'Fait à 3 reprises pour des apéros : succès unanime ! Facile et rapide pour ne rien gâcher... Merci !!', '2013-01-24T12:58:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, ad18860a-b124-4fb4-a327-088cc1fb1cea, 'Très surprenant, ces brochettes ont fait l''unanimité auprès des invités ! A refaire, sans hésiter !', '2013-01-16T21:55:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, bfae0cd8-bddc-425e-b7ab-ab18a37adb9c, 'Très apprécié des invités. Le mariage chorizo et banane est super.', '2013-01-12T19:21:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 4ba1c897-9ad3-4754-8b59-ed43b66a216f, 'Super bon. Tous mes invités adorent.', '2013-01-04T00:35:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, f6a137cc-95da-45c1-8e7c-71abc0c3a4ec, 'Pour le premier janvier j''ai fait cette recette, étonnant mais très apprécié. De plus jeune au plus ancien, tous ont aimé ce mélange de saveurs, même avec du champagne rosé', '2013-01-03T15:14:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 23c376e4-7e84-4c1c-b77e-105004114531, 'Super recette, très appréciée par les convives !!!', '2012-12-01T15:27:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 4fc970df-338e-4342-9b9a-a9b602efddc3, 'Sympa, original, rapide.', '2012-11-04T16:03:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 3bfe8f08-43e6-4005-a804-ff9a2b9231bf, 'Ben heu...franchement, j''ai pas trouvé ça terrible...plutôt lourd en fait ! Heureusement que j''ai testé avant d''en faire plein pour les invités !! Pour tant j''adore le sucré-salé, dommage...', '2012-10-03T17:07:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 44698bbe-c226-460f-bdcd-4f5d388e8292, 'La banane adoucit le chorizo, je n''ai pas mis de miel. Attention de ne pas faire trop griller surtout la banane qui se rend en bouillie.', '2012-09-15T11:20:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 49ce9af2-03a7-43d8-baeb-a1f26b3c4bbb, 'Très simple, mes invités étaient un peu sceptiques... Ils ont beaucoup apprécié.', '2012-05-27T22:49:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 53b66907-3dec-433f-9e25-e1802798d32d, 'Je n''aime pas et mes amis non plus.', '2012-05-07T14:14:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, c1065696-cee4-4f95-9fad-c3773180333f, 'Très bon, rapide et original !!', '2012-04-12T23:42:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 0158ffd5-bf3b-4531-a71a-371135f0a229, 'Simple, rapide, étonnant, original et surtout super bon, on a adoré.', '2011-12-30T23:12:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 7144701d-e1ee-4ae1-aaea-a0bb9f3360e1, 'Une excellente recette pour l''apéritif qui a fait sensation auprès de mes invités ! Je conserve précieusement cette idée. Un vrai must have !!! ', '2011-11-12T02:13:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, cc152e92-2729-4f4c-8689-841a264b4242, 'Facile à faire, rapide et joli, que demander de plus ? En prime malgré mon scepticisme nous avons trouvé cela très bon.', '2011-09-23T07:00:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, 92311895-787a-45c7-a2c1-9b67daf7be2a, 'Très bon ! Mélange parfait et assez doux. A refaire soit en brochettes soit en cuillers apéritives ! Faire revenir très rapidement la banane sinon elle se ramollit....', '2011-08-03T11:27:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42997, bdee2d38-0b38-48c4-9b47-359f50adcd58, 'A l''unanimité, excellent ! Tout le monde a adoré, les deux saveurs se marient super bien. Je le referai sans hésiter.', '2010-12-15T15:05:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19858, 1a2a7ecb-940e-4eea-9132-f4a7cc3f32df, 'Meilleur avec de la brioche, c''est délicieux !', '2016-08-16T11:50:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19858, f2b5a630-f03b-4fc1-8914-d3ae06f4d96f, 'Premier essai satisfaisant à peaufiner', '2011-09-02T22:57:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19858, 0d6ed8e7-6673-48b6-896b-377f04deafef, 'Mmmh je connais une variante de cette recette !  A la place du sucre on met du chocolat (noir ou au lait comme vous voulez, lol).  C''est trop miam !!!!!', '2005-07-14T22:36:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19858, 3de7d2c0-d94e-4326-85bf-b40d2c743004, 'Pour les très gourmands, on peut saupoudrer abondamment les bananes avec de la cannelle et un tout petit peu de gingembre en poudre. Une petite pincée de sel pour réhausser le goût et un peu de lait concentré sucré... Servi avec un peu de glace, c''est succulent!', '2004-11-26T00:54:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19858, ccbe5357-f57b-4578-a3ab-80361965dc80, 'J''en fais également en tartinant les tranches de pain avec de la gelée de groseille, et si ce dessert est destiné à des adultes il ne faut pas hésiter à légérement humecter le pain avec un alcool. Le Nutella est également de bon ton avec la banane.', '2004-01-03T19:18:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19858, 760358c6-ddfe-403c-b6ee-2b1396c7aa2d, 'Vive la banane cuite! Surtout l''hiver.', '2002-12-20T18:19:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84239, 120ea032-7200-4b68-b5d4-c47c8c106c27, 'Mélange pain d''épice/banane intéressant, cependant la crème gâche de goût du mascarpone... J''ai fais cette recette avec du pain d''épice fait maison (bien meilleur) et je la recommencerais pour plus de gourmandise en compensant la crème par du mascarpone et plus de bananes (que j''ai d''ailleurs fait revenir avec du rhum....). Recette à essayer !', '2010-03-14T16:25:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84239, 9a46daa9-8e42-4a5a-bb3f-bde3c3adb0c3, 'Merci pour cette excellente recette!  Personnellement j''ai monté la crème en chantilly avant de l''incorporer au mélange " mascarpone œufs" , du coup le mélange est plus mousseux !   J''ai également laissé reposer 4h car sinon la crème est trop liquide ! Et pour la présentation, j''ai saupoudré sucre glace et cacao en poudre sur le dessus ! C''était délicieux !   ', '2009-03-12T16:19:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84239, 5e2ae4a9-cbbf-4414-8794-bd334ba11c7d, 'Trop de mascarpone, pas assez de sucre, trop de rhum, bref dessert complètement raté et immangeable.', '2009-03-08T18:12:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73579, 0e20b1cd-af58-4060-a75f-89ded1cff854, 'Poualalala jamais vu un smoothie aussi bon ! 2 bananes, 2 pommes, du coulis de framboise pas surgelés, 6 glaçons, rien de plus !!! Le goût est magique !!! Je la mets dans les recettes préférées et compte m''en refaire à gogo ! Merci beaucoup', '2016-06-13T20:04:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73579, 2a776a64-e5fd-4f39-bda7-5cfa0587e2dc, 'Très bonne recette. J''ai ajouté un peu d''eau pétillant pour rajouter de la fraîcheur !', '2015-04-25T16:26:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73579, 39b246e1-2f3c-42da-9fca-8c8b7e74fb41, 'Recette délicieuse. J''ai ajouté une glace onctueuse crème fruit rouge en petit pot individuel + un verre de lait : génial !', '2011-01-05T21:46:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73579, f4082961-e108-4a69-b2f0-95798175d377, 'Perso, pour avoir quelque chose de plus liquide j''ai ajouté un peu de jus d''orange (à peine un demi verre) et le jus d''un citron, un régal. Merci', '2010-12-12T19:46:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73579, be556d0d-8e3e-4c5c-8376-4433be56341e, 'C''est facile à faire et plutôt bon. Il me restait des framboises surgelées, que j''ai mis avec le jus rendu par la décongélation. Du coup j''ai ajouté un peu de lait, pour rendre l''ensemble un peu plus lisse.', '2008-07-31T21:34:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73579, 3a555c03-478e-4ec7-b682-69ada240665d, 'Très bon dessert, très vite fait  et à refaire! ', '2008-07-24T23:54:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33103, cbca09ca-001c-4b90-a6e6-ce235ff7b7ab, 'J''ai essayé cette recette et tout le monde a été agréablement surpris ! C''est délicieux même si avec les quantités données on peut faire pour 6 personnes, car c''est assez bourratif ; je n''ai pas ajouté de coco car trop fade à mon goût pour le gâteau, et j''ai rajouté du sucre dans la crème ! mais c''est un délice...', '2005-07-22T23:36:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30238, 083fd124-5ca4-4b80-8723-fc9213949111, 'Facile à réaliser, après cuisson à la poêle, j''ai arrosé les bricks d''un sirop de mirabelle... Un vrai délice.  ', '2014-07-04T23:57:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30238, c9b7ae62-6d2c-43a1-9b25-a44d4f5279f6, 'J''ai remplacé la confiture d''abricot par de la confiture de figue et cuit 15 min au four. Dessert léger, à refaire !', '2012-01-26T13:03:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30238, e506151b-11ca-4646-9ec9-e53815338e05, 'J''ai opté pour une cuisson au four pendant 15 minutes car à la poêle la brick fondait et j''ai maintenu mes ingrédients avec un cure-dent. Cette recette est légère et délicieuse ! A refaire...', '2007-06-10T15:09:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30238, a8818b6b-b6d6-485d-b750-b116b908664d, 'Tout bonnement excellent...Recette toute simple à réaliser et très légère aprés un repas copieux. A refaire sans souci.', '2006-04-16T23:00:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, 4dd6f59b-2b8a-424f-9296-0af1b83fb7a4, 'Pas déçue du tout. J''ai rajouté une banane écrasée et j''ai monté les blancs en neige, que j''ai incorporés en dernier... Ca prend un peu plus de temps que la recette de base, mais le résultat est excellent. Je l''ai fait cuire 5 min de plus. Je mets 4/5 car pour celles qui connaissent WW, ça donne environ 5,5pts/pers pour 8 personne et 7,25pts/personne pour 8 personnes, donc pour une tarte allégée c''est pas top, mais bon on se régale et on économise ailleurs!', '2005-11-18T21:44:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, 3504f797-c576-4d62-8d70-af4f5c180539, 'La recette n''est pas claire, je ne savais pas s''il fallait mettre les 50g de noix de coco dans la prépartion ou pas. J''ai mis la coco dans la préparation et le résultat est dégoûtant, on dirait une tarte de régime aucun goût.', '2005-06-19T17:18:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, 6412db8a-4e4a-4a1f-b2fa-353edb8adafb, 'J''ai adoré, ainsi que presque tous mes invités... Et sans rien modifier!', '2005-02-06T21:57:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, 192da87b-aa64-4ebf-a426-5e678af45ed3, 'Un régal ! j''ai séparé les blancs des jaunes, que j''ai monté en neige. Incorporés de cette façon à la préparation, la tarte est plus moelleuse.', '2005-01-14T16:17:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, 5379cec3-5625-4ed0-93a0-2ff0f719a04e, 'J''ai également mis du lait concentré sucré et pas de sucre. C''était excellent et pas trop sucré. Les invités sont partis avec ma recette.', '2004-05-03T11:23:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, 518fee70-e1f4-4e7c-b2c5-b038bf161856, 'Pas assez sucrée. Désséchée. Tarte présentée à des invités, et personne n''a terminé sa part. Grosse déception...', '2003-10-18T20:22:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, e4971f42-b255-4076-a795-5d87f7daaf45, 'Déliceuse ! j''ai juste mis du lait concentré sucré et oublié le sucre.  Et mes invitées m''ont demandé la recette...', '2003-09-04T20:54:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, ac6befa6-5f4d-4135-a8a4-0767eb0559c3, 'J''ai franchement modifié la recette en mêlant du lait de coco au lait concentré , en ajoutant deux sachets de sucre vanille ainsi que 100 grammes de sucre . Evidemment , le résultat est loin d''être light , mais tellement meilleur !', '2003-08-08T20:16:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, 2f336085-896c-43a1-bea5-bd688bf03e9f, 'Bof... un peu trop fade. Je l''ai amenée au travail et elle n''a pas eu beaucoup de succès.', '2003-07-17T17:40:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, 638a4718-0dfa-4807-8cc9-081d51670dbe, 'Très bonne et légère, facile à préparer, mais j''ai un peu modifié la recette sinon, c''est fade. J''ai mis du sucre roux à la place du sucre traditionnel, j''ai ajouté un sachet de sucre vanillé dans la préparation (d''ailleurs on peut en mettre plus!) et j''ai rajouté une banane. C''était très bon! Pour l''aspect, j''ai mis une bonne couche de noix de coco au-dessus et c''est passé sans problème!', '2003-03-01T10:56:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, 685ae3da-21f6-40d0-913e-a04ca8fc6b5a, 'Moi je la trouve pas mal du tout cette tarte banane-coco! ;-) La couleur pas très avenante: c''est la banane, c''est bien connu, à la cuisson elles restent pas jaune! ;-D Non, ça ne nous a pas gênés... C''était juste un peu fade en effet... ou alors une impression de ''y manque quelque chose, mais quoi?''. Mais bon, c''est une recette censée être light, alors si on ajoute des tonnes de sucre...  Je mets un 4!', '2002-09-11T14:04:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, ec8b3519-bc8b-4fc0-9eb0-562f62b8a311, 'Franchement délicieux léger et très bon surtout pour les amateurs de noix de coco!!', '2002-05-17T20:20:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, ca19db7b-62d7-47df-8024-dd737e99e112, 'Craignant qu''elle soit un peu trop fade, je l''ai préparée avec du lait concentré sucré: on perd certes le côté ''allégé'' de la recette, mais on gagne en saveur! C''était bon, mais je n''en mangerai pas tous les jours... De plus, la couleur est bien peu avenante.', '2002-04-22T17:51:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, 9705a974-a4a0-48af-aa39-08ff133f1a20, 'Je l''ai préparée avec une pâte sablée et l''ai soupoudrée de cacao et de noix de coco. Je pense que comme cela, elle était moins fade.', '2002-04-04T08:32:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, 19b44dc5-733d-4654-ac4e-9a3ca22c3afb, 'Tarte facile à réaliser, mais, rajouté un zeste de citron car sinon, elle est fade.', '2002-02-18T12:08:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, 1a105d47-b601-4f8f-89d4-02c52df2a79d, 'Vraiment décevant... Pas assez sucré, texture moyenne... Sur 4 personnes , aucun n''a fini sa part... et on a jeté le reste le lendemain!', '2002-01-10T17:37:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14781, dd88ee39-95d5-4658-bccc-8e20e7019d9a, 'Bon, facile et pas trop bourratif!', '2001-10-31T20:54:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59619, ca293f08-2106-4cf5-a563-5a46e8a8ea47, 'J''ai fait la recette avec le poids de bananes épluchées. Très bon !', '2015-04-11T09:27:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59619, 9964b0ff-2845-4a8b-98f6-2fb3181c2934, 'Bonne recette, j''ai toutefois fait quelques modif : j''ai utilisé ma confiture de lait et je n''ai pas mis mes bananes dans le beurre. J''ai fait le mélange chocolat et bananes la veille de la cuisson. J''ai fait un pot avec morceaux et un pot mixé, un délice pour les gouters, ou tout simplement pour tremper ses doigts dans le pot (pour les gourmands...)', '2010-09-16T15:09:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, 6aee1e7e-1649-4f40-bf59-19dbe20e7e5c, 'J’ai mis une banane et 200 gr de chocolat noir', '2023-09-19T17:36:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, 5fba17b0-c397-4856-b67b-76d1eca9fe1e, 'Je n''ai mis que 100g de beurre et 50g de sucre en moins super bon', '2021-10-24T19:40:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, 6e7e4832-3496-44b3-95fa-24c4aa5ac8f9, 'Tout simplement délicieux ', '2021-09-17T07:05:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, c6b642d0-82a4-4e77-8f47-fc6cce3394ed, 'Excellente recette qui va rester dans mes recettes favorites. Nous ne sommes que deux donc j''ai réduit les proportions par deux sauf pour le sucre. J''ai réduit un peu. Comme indiqué dans certains commentaires j''ai rajouté de la noix de coco. Le mélange est délicieux et complémentaire avec la banane et le chocolat. Super pour utiliser les bananes un peu trop mûres. La texture est moelleuse un vrai délice. Je conseille vivement. Avec un bon café c''est le top du top.', '2020-03-30T15:34:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, c22c4527-ebeb-438a-94ff-5cfc1393532c, 'Excellente recette à refaire avec un peu moins de beurre mais le mélange chocolat banane est super', '2015-11-29T19:40:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, 220ea313-1748-4b3c-9adc-7c0828efdb8c, 'Je n''ai mis que 150 g de sucre et 100 g de beurre.  J''ai ajouté 10 minutes de cuisson. Le résultat est super moelleux et délicieux. ', '2014-12-03T17:18:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, 28157327-6cc9-4ab3-8583-00b1a1accb96, 'Très bon gâteau. J''ai réduit le sucre (100 g), puis 100 g de beurre, mis du chocolat en poudre... Super bon goûter ! A refaire.', '2014-11-04T16:52:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, 50f77b0c-dc01-4ee6-9b56-9be6d154ff1b, 'Très bon et moelleux, parfait pour les bananes oubliées devenues toutes noires ! J''ai mis de la poudre de cacao à la place du chocolat (3/4 cuillers à soupe) et j''ai réduit le beurre comme le préconisaient les commentaires précédents. La prochaine fois, je réduirai aussi le sucre - je pense que 175 g suffisent. ', '2014-07-02T23:45:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, f379d07d-54a0-455d-8072-b2e028d3c6f1, 'Vraiment très bon gâteau moelleux. Cette recette va devenir une de mes préférées. Merci !', '2014-02-10T18:30:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, 73b45568-23f4-4d4d-b153-70685597e582, 'Toute la famille a adoré. J''avais remplacé le sucre par 130g de vergeoise + 30 g de sirop de coco et ajouté 1 cuillère à soupe de crème fraîche. J''ai utilisé du beurre salé.', '2014-01-01T09:57:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, b6b26b1a-19b1-4e66-a575-cea933024a88, 'J''ai remplacé les pépites de chocolat par du Nutella ! Un vrai délice !', '2013-03-30T09:43:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, e180ddd1-104a-4fe5-8b0a-7741117edfea, 'Très réussi ! Pour ma part, avec moins de beurre en effet et cuit 12-15 min dans des moules à muffin... Un goûter parfait ! A refaire...', '2012-10-15T13:32:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, 1ebf9207-4992-4dff-a389-b7153c0f6608, 'Aie, aie, aie qu''est ce que c''est bon. Si je peux me permettre 100g de beurre suffit amplement, merci pour avoir égayé mes papilles.', '2010-08-29T17:50:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, ca21f7c8-ce37-450f-bf34-5e82155afb8e, 'Mes bananes étaient bien trop mûres pour les manger crues, ce quatre-quarts m''a donc permis de faire quelque chose avec sans avoir à les jeter, et le résultat est très réussi ! Ce gâteau est vraiment délicieux ! Merci !', '2009-07-19T14:39:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, 97576561-4722-484c-8fb7-b89c9870d7a1, 'Merci pour cette recette ! Facile, rapide, et délicieux !!! A manger tiède de préférence (sinon le chocolat durcit). Mixer les bananes que si elles ne sont pas très mures, sinon c''est vraiment un délice de croquer dedans ! Mon petit plus : je n ai mis que 100 g de beurre -entre nous ca suffit- et j ai rajouté 3 cuillères à soupe de noix de coco râpée.', '2007-12-19T13:40:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52609, f41b529e-635b-4d2c-8c52-1f3f2de04cf9, 'Super simple et vraiment très bon!', '2007-01-05T19:23:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224761, e5d30f24-9c34-4b77-81d7-d6bc0a8d1617, 'Super bon ! Je suis fan des cocktails sans alcool et cela change du traditionnel orange pamplemousse grenadine. Un peu sucré toutefois. Au bout de plusieurs fois, j''ai rectifié comme ceci : - 40 cl jus d''orange - 30 cl jus de passion - 30 cl jus de banane - 1 trait de citron - 20 cl d''eau gazeuse - 1 trait de sirop de fraise au moment du service (framboise ça doit être pas mal non plus)', '2015-01-24T15:05:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224761, 2a7feec7-45c0-4a2d-a6b0-34583d175de2, 'C''est très bon.  J''ai refait avec des fruits (des oranges pressées, des bananes écrasées), pareil pour le reste et j''ai passé au mixer. Une bonne façon de faire manger des fruits aux enfants... et un cocktail super pour les adultes !', '2012-05-23T19:14:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30606, c1280920-75cf-48cd-8d95-6710b41ca274, 'Je n''ai pas trouvé ce dessert exceptionnel, n''ayant pas de framboises j''ai essayé avec la noix de coco, et j''ai doré le couvercle de pâte au jaune d''oeuf pour faire plus coloré, à mon avis c''est de toutes façons meilleur bien froid que tiède.', '2009-02-01T18:43:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30606, 942d4e86-5564-4e09-81e1-cbffd1e8c717, 'Un délice, qui à ravi toute ma petite famille. N''ayant pas de framboises, j''ai ajouté à la garniture 100 g de noix de coco râpée. J''ai aussi mis 4 bananes au lieu de 2. ', '2006-09-12T06:32:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30606, 334839a7-ba66-4143-91b8-b053223a69d1, 'Tout le monde a aimé: parents et enfants. J''ai juste augmenté les quantités: 4 bananes et 440 g de framboises surgelées et mis un fond de poudre d''amandes pour absorber le jus des framboises.', '2006-05-15T16:02:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30606, 1374a503-cd93-4906-88e6-1a75c23ed9fe, 'Bonne recette mais je ne l''ai pas trouvée succulente. Originale mais pas assez raffinée au goût.', '2006-04-02T14:31:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30606, 08fd74d3-57dc-4e55-98f0-431a843461cd, 'Super, vraiment délicieux, servi avec un kir à la framboise. Merci pour cette recette originale.', '2006-03-01T23:41:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30606, 4b5ccd2c-b4d6-44a9-be54-36164152cd40, 'Tourte faite avec et sans framboises. La bonne note est pour la version sans fruits rouges, absolument délicieuse et qui permet de terminer des bananes noircies. En sortie de four, j''ai saupoudré d''un peu de sucre glace tamisé.', '2005-11-19T13:41:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30606, fdb0a936-b407-408b-a693-cd193c1682ed, 'Miam, cette alliance banane-framboise est absolument délicieuse! Merci à Aurore d''y avoir pensé! J''ai badigeonné le dessus de la tourte avec un jaune d''oeuf. Je me répète, mais un vrai régal!', '2005-08-01T14:50:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30606, 423f7244-bd3d-4d52-9d71-3b5a5b5ab8c7, 'Dessert facile, ma fille était très fière de le faire toute seule. Par contre, personne n''a aimé, goût très spécial...', '2004-11-01T12:02:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30606, 9bfcb8ad-898a-422f-bf84-3c5063b02940, 'Succulente, cette délicate alliance framboise-banane. J''ai utilisé des framboises surgelées et elles ont rendu un peu d''eau, mais à refaire car c''est vraiment délicieux. Merci Auyo!!!', '2004-10-06T16:13:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30606, eda480ad-852b-4d59-b86c-5fb2f0208ec3, 'Cela n''est pas à mon goût, par contre très facile à faire.', '2004-10-01T03:28:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17611, 1950653c-92bb-434c-a847-7a66c657c582, 'Le goût est délicieux, mais la mousse n''a pas réellement pris, c''est plutôt une crème coco-banane. De plus, il faut diminuer la quantité de poudre de coco, ça croque trop sous les dents. Veillez à chauffer le lait de coco (2 cuillères à soupe) pour faire fondre la gélatine sinon ça ne fonctionne pas (oubli de la recette).', '2012-02-16T16:31:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17611, e7522e6b-745c-4388-9e7d-26bb0f6a5a7b, 'Recette excellente en l''état, mais quand même un calorique à cause du lait de coco... A faire pour 4 personnes sans rien changer et à modifier pour diminuer les calories (en cours).', '2005-04-22T11:54:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17611, b4c3c255-257a-40da-be6c-a98d4a452386, 'Très bonne recette, et bonne tenue de la mousse avec trois feuilles de gélatine.', '2005-02-19T16:04:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17611, 254bd9fd-0658-4eff-b4d7-05006f2a7847, 'J''ai pris en note les commentaires précédents, mais je dois avouer que les quantités données me semblent assez erronées. J''ai fait la recette pour six personnes et j''ai mis 3 bananes, 4 blancs d''oeuf, 6 feuilles de gélatines, 3 fromages blancs mais seulement 100g de sucre et 20 cl de crème de coco. Vanille et noix de coco râpée au jugé en goûtant. La mousse avait une très bonne consistance et n''était pas trop sucrée. Je pense que le mieux est de goûter au moment de mettre le sucre pour adapter à son goût. En tout cas, mes invités ont été ravis. A essayer cet été, avec des fraises ou des framboises...', '2005-02-16T19:44:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17611, c0c96284-1f25-4348-84cc-0d9d235ba41d, 'Comme beaucoup, trop liquide. Mettre moins de lait de coco et plus de gélatine (qui ne se dilue pas dans le lait froid mais chaud). Ne pas hésiter à mettre une grosse pointe de vanille, sinon ça manque de goût.', '2004-11-28T19:33:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17611, 06e906b9-f5e5-456b-941f-fff7696300d4, 'Très bon, cependant la mousse, malgré son passage au réfrigérateur, n''est pas aussi compacte que je le pensais. Je mettrai un peu plus de gélatine la prochaine fois. La recette suffit largement pour 3, voire 4 personnes. En tous les cas, le mélange coco-banane est une réussite, ces 2 ingrédients se marient très bien.', '2004-10-26T17:36:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17611, 01b6de9a-a898-43d5-948c-56f753ba0f76, 'Très bon, mais c''est aussi resté liquide... J''essaierai la prochaine fois avec un peu plus de gélatine ou un blanc d''oeuf en neige en plus.', '2004-06-01T12:18:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17611, a391e974-6c25-4ca2-854f-1686fb03d87e, 'Excellent! Le résultat est très bon. il faut bien diluer la gélatine et le repos au froid est obligatoire pour une bonne texture. A manger le jour même.', '2004-04-27T14:01:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17611, 0f5c9b60-ccc2-4844-9123-436f24b9e726, 'J''ai du rater quelque chose: c''est resté liquide! Dommage, à réessayer...', '2003-07-05T21:03:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17611, fa941de6-9b44-4174-9547-e5f0c808265c, 'Délicieux, léger... Un vrai régal! Mais convient plutôt pour 3 ou 4 personnes.', '2003-06-04T11:26:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309460, 944a6998-c71d-455d-a683-662860d566c5, 'Très bon et bien frais, je vous le conseille vraiment mais je ne m''en ferai pas tous les jours.', '2016-08-07T02:04:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309460, 715e0354-908a-4df0-92bf-b5140dcb71f9, 'Très frais et super bon je recommande !', '2016-07-20T00:46:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309460, e7f76ee4-e7da-4150-ad9d-0cb5c9ef9e77, 'Très bon mais il faut prendre des abricots bien mûrs ou ajouter du sucre !', '2016-06-13T15:02:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91727, 9e07d6e3-a556-4768-800c-c1b95fdcc89e, 'Très bonne recette à refaire ', '2020-10-17T20:40:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91727, b5d258e2-287b-4194-9d38-b328c3ea8b19, 'À quelle température le four ? Merci.', '2019-10-16T21:00:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91727, e005d98c-fe6d-412a-a815-7b548e8acca3, 'Bonne recette. J''ai modifié le glaçage avec une liqueur de goyave avec le coing que j''ai étalé sur les pommes. Mes invités ont adoré.', '2017-10-19T12:35:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91727, e80fdc4a-0224-4fe1-b07a-01ad2a0fafd1, 'Très bonne recette à la différence que j''ai fais une grande tarte au lieu de plusieurs petites. Mes enfants ont été ravis de cuisiner avec moi c''est très facile à faire et un vrai régal pour tout le monde à refaire. Merci', '2017-03-04T14:01:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65413, 51fd0af7-2c85-4fd0-bdb1-9caa1cd7fc46, 'Vraiment très facile et absolument délicieux. Dessert excellent en plein soleil ! J''y ai ajouté des kiwis...', '2017-09-10T23:03:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (529401, 7573b150-70aa-45e1-b0f0-ec3f62d63083, 'Facile et rapide top la vidéo !', '2021-03-20T15:33:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (529401, 46772312-5683-4a3c-9f8c-0d68babf0b84, 'C''est trop bon, continue comme ça', '2023-02-21T17:48:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31879, 409ed9da-54a6-4ecd-8de1-dd671e0e8bcd, 'Ajouter la farine donne à la sauce un côté Bechamel écoeurant avec les fruits. Je déconseille la banane si elle est mûre,  le résultat est bizarre.
Par contre la cuisson est top. Je vais réessayer sans farine ni banane pour voir ce que ça donne.', '2019-10-19T03:26:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31879, c075bd32-4331-48a4-832a-e9da6a8aef33, 'Bravo !!! Recette rapide et délicieuse, à faire découvrir aux anti micro-ondes .', '2014-05-13T16:38:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31879, 87137f0c-4084-4e14-bc1b-d1953c4d58b1, 'Je ne suis pas une adepte de la cuisine "micro ondes" pressé et ayant jamais été déçu par les recettes bien notées, je me suis lancée. Grossière erreur!!! Visuellement, pas agréable. Pour le gout, les saveurs ne se sont pas mêlées,la viande est dure. A oublier très vite.', '2009-01-24T15:50:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31879, f9bd1887-33a7-4f46-a4d8-cbe919d309a8, 'Fait sans banane (mais avec 2 pommes) ni vin blanc, je n''avais ni l''un ni l''autre, mais c''était délicieux tout de même. Pour mon micro-ondes, temps de cuisson de la recette parfait.', '2007-09-05T22:13:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31879, 9c32736f-1b4f-4080-81c8-372d897d27d2, 'Très bonne recette, rapide, facile à préparer. J''ai gardé les mêmes quantités de crème, vin et farine pour 4 personnes, et c''était suffisant. Merci Anne pour la recette et Corinne pour le tuyau!', '2006-02-15T16:51:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31879, 35738e0c-eed8-46ed-be93-35c680f7f769, 'Je n''avais jamais cuisiné au micro-ondes (hormis les timbales de Jeanne): et bien c''est très bon. Recette réalisée sans bananes car elles manquaient. Très rapide lorsque l''on rentre du travail. J''ai cuit 2 minutes de + car au bout de la durée indiquée, les tranches étaient un peu trop rosées, mais cela dépend peut-être des micro-ondes.', '2005-05-11T14:19:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31879, f25234ec-1cb1-4885-8e8f-baed03db6b8f, 'Je suis, d''habitude, plutôt réticente en ce qui concerne la cuisine au micro-ondes. Et bien, tous mes préjugés sont tombés avec cette délicieuse recette. C''est trop boooooooon.', '2004-12-08T23:35:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528281, 170e978f-7035-4ac4-a5cf-d47ba9f520ba, 'Je n''aurais pas appelé cela des cookies au niveau de la texture. Mais ils sont très bons. Sucrés comme il faut. Parfait pour un goûter healthy ', '2020-10-25T17:18:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528281, 0692d1bb-93aa-4aec-8ad3-5e421cc77807, 'Facile, rapide et bon ! Juste assez sucré, une réussite !', '2020-09-13T21:15:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528281, 94230a7b-c9ac-4920-9158-c0e64ef350e5, 'J''ai essayer avec de l''okara (reste de lait d''avoine), de la cannelle et des pépites de chocolat : un délice', '2020-09-13T13:04:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528281, d999e69a-613d-4e54-8549-356f33b5e067, 'Délicieux mais peut être un peu secs ', '2023-06-24T22:08:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528281, 0b5d36bf-994c-437f-9a5d-38fbe05167cf, 'Bon petit gâteau qui permet de ne pas gaspiller des bananes un peu mûres ', '2022-04-30T17:46:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528281, 55013df5-7ba2-4ae6-8d5c-4ca4885b8945, ' C''est vrai que ça fait très diète, mais avec un goût de reviens-y ? ', '2021-02-08T17:39:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528281, a4a6db3d-9617-4000-8b6f-83c2a9c86e85, 'Excellent! Mais je l''ai fait avec une petite cuillère à café car la cuillère à glace est trop grosse!', '2021-01-23T15:48:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528281, 62808616-5cd8-41f0-92c5-bb14e56f375b, 'Pas bon', '2020-12-16T20:10:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528281, 3a470f7c-e928-407f-8571-9a0290d7a873, 'Excellent. Presque trop sucré lorsque l''on se déshabitue du goût du sucre.', '2020-11-29T18:40:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528281, 36c1c530-0eb9-490e-8191-23c4aaa6f9e6, 'J ai adorée ', '2020-11-18T15:21:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528281, 4830e7ef-958f-40ce-8b14-338020f97454, 'Bon, mais je crois les avoir laissés trop longtemps au four. 20 minutes doivent suffire.', '2020-10-04T23:13:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528281, 5fdbecfd-3385-4808-813d-195ca0455004, 'Facile, rapide, diététique. Délicieux.', '2020-09-29T06:26:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528281, 2830ac87-e7b1-42a8-b93f-d737139a6c60, 'Bon mais sans plus.', '2020-09-29T00:44:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528281, c4e962a9-3074-412c-803e-75b0ef98490a, 'Nous, on a adoré ! Un peu de sucre glace sur le dessus pour satisfaire la gourmandise des enfants.
Ils sont croustillants à la sortie du four puis deviennent moelleux en quelques heures. Ne vous attendez pas à de vrais cookies évidemment, mais ce type de gâteau est bien plus sain et tout aussi délicieux !', '2020-09-15T15:07:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22467, 3aefeacc-d528-4065-86d0-968910f2bbee, 'A peine la moyenne pour cette soupe épaisse chocolat-café-bananes en morceaux. Décevant après la lecture des autres commentaires.', '2008-09-13T22:53:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22467, a820bb9a-1eb9-4972-b334-4e3b45c2648b, 'Excellentissime!! L''association des goûts est géniale. Je pense qu''il pourrait être accompagné d''une boule vanille. Il faut deguster ce divin nectar.', '2007-12-26T08:37:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22467, 0260cd3c-36da-48d7-8efc-49b678ba5cca, 'Absolument délicieux! Tout juste si nous n''avons pas léché le saladier à la fin... ', '2007-03-15T18:48:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22467, f9968720-02a8-4ed3-a81e-94e1632fc077, 'Délicieux et facile à faire, même par des enfants!', '2003-06-15T19:26:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 36867925-fbc2-44c9-95fc-d4875c986ffa, 'Bonne recette que je fais en individuel (moule muffin) et que j''ai un peu modifié. Je remplace l''huile par du beurre, 1 pot de cassonnade au lieu des 2 de sucre et je remplace 1 des pots de farine par de la maizena pour alléger le tout.', '2018-08-29T18:23:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 1eab5fea-c2c3-43f0-b871-1d7cd05893fd, 'Modifié en mettant du chocolat en poudre, et double temps de cuisson très bon ', '2023-08-18T16:23:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, f9892a4b-2c2c-4b96-bd74-3d494fa756b9, 'Excellent ! Bien croustillant à l''extérieur et moelleux dedans ! J''ai mis 1 pot de sucre de canne et la moitié d''un pot de cacao non sucré et seulement 2 bananes bien mûres. Un régal.', '2019-08-12T19:24:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 0781e4da-d704-4df1-b5d5-6560e5bf31e8, 'Très bonne recette, j''ai effectué tout de même quelques modifications: je mets 1/2 pot de sucre uniquement (moitié cassonade/moitié sucre blanc), des petites de chocolat et la cuisson 50 min à 180 degrés ', '2017-06-04T10:26:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 41965b7e-d954-4737-9ef2-8420e05420db, 'Savoureux et moelleux ! J''ai mis moins de sucre, mélangé farine et maïzena, ajouté un peu de rhum et cuit 50 min au four à 180°C dans un moule chemisé de papier alu.', '2013-03-10T11:31:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 07483c6f-6ead-425f-a876-4ce3f6a8047d, 'Très bonne recette mais pour qu''il soit plus moelleux, remplacer un pot de farine par de la maïzena et pour que les pépites ne tombent pas au fond, ne pas les mélanger à la pâte. Verser la pâte par couche et entre chaque couche, déposer quelques pépites. Là c''est excellent.', '2012-01-08T13:11:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 4fbd39a1-c5e3-47d0-acb2-81d052f1c45f, 'Succulent, mais un peu lourd. J''ai procédé de cette façon, et je la recommande fortement : séparer le blanc des jaunes d''œufs, blanchir les jaunes avec le sucre vanillé, battre les blancs en neige ferme, ajouter le yaourt dans les jaunes, puis 2 pots de farine, et non trois (prendre un batteur électrique et ne pas paniquer devant l''allure compacte de la pâte !). Ajouter l''huile, le sucre et la levure (la pâte devient très lisse !). Incorporer délicatement les blancs en neige. Finir le recette en mettant 2 bananes au lieu de 3 (selon leur taille). Régalez vous ! ', '2011-07-29T16:07:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 6f863ab5-17e4-4922-80b2-64e342fe9eb1, 'Vous remplacez le yaourt nature par du yaourt aromatisé à la cerise. Vous rajoutez 50 g de chocolat râpé gros, vous supprimez les fruits (j''en avais pas). Super bon.', '2006-11-04T12:59:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, e3faae17-cfa0-4511-ab7d-84b6a192df50, 'Facile à faire. Top
', '2023-10-31T16:38:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 45f9c0ea-031c-4faa-931c-809873de023f, 'Recette suivie à la lettre mais Impossible à cuire .. dégoûtée du gaspillage ', '2023-03-05T20:22:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 63694db8-39a9-4a30-9d76-5dac2685f7bd, 'Excellent gâteau et facile à faire. Perso j’ai remplacé le sucre par du miel. ', '2023-02-19T16:35:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 6f2017dc-da72-4781-9953-250f032dde5f, 'Recette rapide à faire et gâteau très bon 😋', '2023-01-19T14:52:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, a7fb5e01-f3b1-477c-9680-ca5638905de0, 'Fait sans huile, avec 2 yaourts et 2 bananes. Extrêmement moelleux, excellent !', '2022-10-26T22:41:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 5f84f634-0d85-4dab-914f-3c256813df60, 'Excellent. Recette suivie à la lettre, délicieux et super rapide à faire. Bon j''ai juste oublié le sucre vanillé mais pas grave ! Encore meilleur tiède.', '2022-10-16T21:05:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 24bbd0ef-4e36-4ec9-862d-69b4219e7f18, 'Très moelleux j’ai remplacé l’huile par du beurre demi-sel. 

', '2022-03-10T13:27:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 426a4729-f6bf-44bc-9dd6-2f5aa4b14dc1, 'Vraiment très bon. Gâteau très moelleux.  Mis moins de sucre et moins de chocolat ', '2022-02-23T21:53:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 2034bcde-fbaf-44a8-a73c-4c2a20cf265a, 'Délicieux chaud, difficile de s''arrêter d''en manger. Un peu lourd cependant. Je n''ai utilisé que deux bananes, 1/2 yaout d''huile car je n''en avais plus. ', '2022-01-23T16:15:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 0739cc09-f98f-4220-a35d-ae4366999efa, 'Très bonne base de gâteau. j''ai rajouté un peu de noix de coco râpée et tout le monde a adoré. La prochaine fois je rajouterai un bouchon de rhum...', '2022-01-12T19:35:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 44704527-fdd9-42a9-bd42-c9e7833c8e54, 'Un régal ! 
j''ai remplacé le sucre blanc par du sucre roux et du sucre vanillé par de l''extrait de vanille.', '2021-08-12T22:46:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, d0ee7195-9d6a-407e-89ca-286f55ba7273, 'excellent! merci infiniment, je fais cette recette très régulièrement désormais et c''est un vrai régal :) ', '2021-04-14T22:44:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 1c8e7154-569b-4f7a-aee0-36b69ab4b23d, 'Excellente recette. J’ai remplacé 1/3 de farine de blé par de la farine de riz. Très bon résultat également!', '2021-03-13T21:20:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 46d250bd-96ff-4f36-906b-83d8ba18ce30, 'Excellente recette, très facile, sympa à faire avec des enfants. Les enfants et les adultes se régalent', '2020-11-28T22:51:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 9254904a-564b-4742-801f-b9f8dec7fa93, 'Pour plus de légèreté je remplace la levure par du bicarbonate ! ', '2020-04-17T18:20:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 35517812-f7a1-48c0-b7e7-08a3f4da5d8a, 'Très bon et très facile à faire, pour les gros gourmands laisser les 3 bananes. Bonne dégustation ??', '2020-03-31T19:49:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 739b66bf-bf49-48f3-934e-48b14aff9c73, 'Merci !', '2019-12-07T14:31:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 34e485ab-def0-46c1-afb1-1930e30f1f08, 'Délicieusement bon quand on a des bananes trop mûres  cuisson parfaite 40 minutes a 170 degrés ', '2017-05-07T17:36:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 3ccd2759-1b96-455a-b7b0-518a717bfb87, 'Ce gâteau est super bon miam merci pour cette recette !', '2016-09-27T00:13:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 04697c1d-af3c-4ea2-afa4-ae94a3e7f810, 'Délicieux merci beaucoup ! Pour la cuisson j''ai fait 50 min à 180°C', '2016-06-15T21:37:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, fdc3f4c7-bbfe-4dbd-aa1a-70800317822f, 'Excellent ! ', '2016-03-25T17:19:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, ed8e11b6-0978-45a3-a685-39585c9fade8, 'J''ai mis deux bananes au lieu de trois. Et trois oeufs au lieu de deux. un peu plus de sucre. Et 40 min à 170°C. un délice!!', '2015-05-15T22:40:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 63d7ad9b-da73-4f01-b262-949977c38064, 'J''ai mis deux bananes au lieu de trois et des pépites de chocolat ! Un vrai régal, gâteau bien moelleux et très bon goût! J''ai mis à 180°C 40 min.', '2015-03-29T17:56:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, b1837300-d7f8-45d6-a895-c1fc58e899ce, 'Qui a dit qu''il n''était pas bon ?? Réalisé cet après-midi, dégusté ce soir au dessert.....miam ! Recette suivie au gramme près et c''est juste un délice ! Ah, j''ai juste modifié la cuisson...180°C 50 bonnes minutes.. Parfait, merci !!', '2014-10-18T22:35:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 2083a148-5416-48a2-afcf-6749e1bfa085, 'J''ai réduit à 1 demi pot huile 1 pot sucre 2 pots farine mais 2 pots yaourt et bien évidemment avec les bananes (2) du rhum !!!!  Cuisson 180 degres pendant 55 min mais ça c''est selon le four... Résultat : croustillant à l''extérieur moelleux dedans. Manque un peu de saveur : gousse de vanille râpée ou yaourt parfume vanille...', '2013-11-01T20:54:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, d80a6d74-f749-4a08-8404-1eb88378a3db, 'Avec un temps de cuisson plus long, c''est un gâteau parfait.', '2013-01-20T15:30:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 155ff1c4-efdf-4071-8347-1943144e80e1, 'Ma petite-fille l''a fait pour le goûter, il est excellent, moelleux à souhait, en un mot délicieux !!!', '2012-08-14T23:22:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, f5da7484-0fe2-41fc-9261-e7f0c45a6678, 'Pas beaucoup de goût.', '2012-05-31T11:06:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, f3f7ac5f-f6e0-4a62-b483-4a682e79c648, 'Nous nous sommes régalés, même si j''avais diminué les quantités de sucre (1 pot), de farine (2 pots) et d''huile (en remplaçant la moitié par du lait)...', '2011-09-25T22:28:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, fe62febb-3199-45e3-b997-755f76e40788, 'Super déçue ! C''est la première fois que je le suis à ce point. J''ai respecté les dosages dans leurs intégralités. J''ai respecté le temps et la température de cuisson. Et là, quel ne fût pas le désastre, immonde ! Un gâteau tout mou même pas cuit, du coup, pour le rattraper, j''ai corrigé le temps de cuisson qui était bien en dessous de la normal, surtout pour un cake à la banane. En conclusion, le goût n''y est pas, la texture non plus, ceci est la pire déception culinaire ! Je ne recommanderai pas cette recette et ne la referai pas non plus.', '2011-09-21T15:02:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, ab0055b5-b162-404c-bc80-bcbe462f59a0, 'Parfait !', '2011-07-19T13:23:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 744e6a2a-eb97-4966-95e6-ca09ba8d38e9, 'Délicieux, tout simplement !', '2011-05-22T18:59:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 18d794c3-582d-4461-9afe-38bc005ec8a9, 'Très bon gâteau ! Je n''avais que 2 bananes bien mûres et j''ai trouvé que c''était suffisant. Au lieu de hacher 100 g de chocolat pour ma part j''ai mis des vermicelles au chocolat. A refaire.', '2011-04-05T19:09:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, ac9387f6-f1f7-4660-897b-b14c1e5bf170, 'Très bon et facile à faire ! J''ai mis la préparation dans des moules à muffins en mettant 2 rondelles de banane dans le fond ! J''ai rajouté quelques pépites de chocolat ! En revanche j''ai mis 2 fois moins de sucre et ca suffit ! Je vous le recommande ! ', '2011-02-12T01:26:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, abb8023c-e643-44a1-998d-3120a6562c6e, 'Mes enfants ont adoré le faire, mais n''ont pas aimé: fort en goût et peu levé (trop de choses dedans, et pourtant seulement 2 bananes). C''est peut-être aussi ma farine bise qui est fautive!', '2010-10-09T21:14:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 03424075-655d-471d-8394-9bcbdd10cd98, 'Très bon, et en effet 2 bananes suffisent. Juste un peu déçue niveau présentation car mon gâteau ne se démoulait pas bien, malgré que le moule soit bien beurré/fariné... Je crois que c''est dû à la texture bananes-chocolat qui reste "molle" même après cuisson. Mais ça reste un 5/5 niveau goût !', '2010-09-23T16:04:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 4629a96d-9165-4a7c-96e6-d2d7126d4086, 'Excellent ! J''ai effectivement mis seulement 2 bananes bien mûres et tous mes invités (enfants et adultes) ont adoré. Merci pour cette recette.', '2010-01-29T20:59:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 84cac741-81f6-4f5a-ade3-a21c20f9f010, 'Je n''ai rien changé à la recette, le résultat était absolument délicieux !!!', '2009-11-16T11:07:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 5f62a481-2c71-4688-9e2c-4583706a5391, 'Miam miam, Très bon gâteau, parfait pour le petit déjeuner!! ', '2009-03-12T02:33:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 5cfba9eb-1fe9-4fb4-a0d0-313824d4ed0f, 'Gâteau un peu lourd et fort, 2 bananes suffiraient du fait qu''elles soient mûres!', '2006-11-20T20:02:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 5fae6569-481a-4595-8a25-13e669cf3103, 'Très bon et simple à faire. On m''a déjà demandé la recette. 2 bananes effectivement suffisent.', '2006-08-29T19:16:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, be81e489-81c5-4d6e-89f7-b08611564f5b, 'Fameux !!!mais un peu lourd avec 3 bananes bien mûres, la prochaine je n''en mettrai que 2. J''y ai rajouté des épices (cannelle, 4 épices...)', '2006-03-25T11:11:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 0182954b-db49-4791-90c8-0d87d67ee716, 'Je pousse la gourmandise un peu plus loin,  et je fais caraméliser les bananes dans  du beurre et du sucre. C''est délicieux!', '2006-03-18T15:46:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43020, 0483215d-50a1-4413-9ab2-e6b489dc724e, 'Très, très bon et très facile! Pour le croustillant, je parsème le dessus de noix de coco...', '2006-03-15T17:25:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29858, bf3b35d6-c31d-4be7-b45e-86d1277b1096, 'J''ai réalisé des couches avec les deux mousses et voici mes commentaires :  - Quantité trop importante malgré dosage 2/3. - Gélatine quasi-obligatoire parce que les bananes sont dures à faire évaporer sans cramer. - Il faudrait filtrer les bananes car les fibres altèrent la tenue de la mousse-banane, et tend vers un truc plutôt aqueux (style tiramisu raté). - Banane très prononcée, ce qui déçoit les amateurs de chocolat. - Crème fraiche inutile. - Mettez du sucre semoule en base avec les jaunes, et du sucre glace lorsque vous montez les blancs.  Perso, j''ai bien aimé, même si l''aspect laisse à désirer. A peaufiner ! ', '2013-09-26T20:12:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29858, 772257b5-00dd-46de-8f72-b033d12791a9, 'Pas bon, c''est parti à la poubelle !!!', '2010-08-29T18:55:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29858, e56a35d5-7d21-4cdb-a319-0890d2145ed5, 'J''ai suis déçue, j''ai trouvé écoeurant et en plus on ne sentait plus le goût de la banane, je pense qu''il ne faut pas le préparer la veille.', '2009-03-21T16:51:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29858, b0706f23-7613-490e-8681-d45151f77517, 'C''est bon mais un peu écoeurant et trop long à faire.', '2007-12-22T16:02:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29858, 36978d6e-716f-4b57-811e-448cc367befb, 'C''est très bon, très leger, mais bon on est mis au parfum, c''est assez long à préparer (surtout quand le batteur vous lâche dès le debut de la recette). Heureusement que j''avais vu les commentaires concernant l''aspect un peu liquide de la mousse à la banane, sinon j''aurais été démotivé! Cependant ce dessert se marie super bien avec du champagne si vous cherchiez quoi boire...', '2007-06-08T07:14:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29858, c815eb2d-c857-48ac-87b2-a8429d870047, 'Succulent dessert! J''en raffole ! Attention: les commentaires sont exacts : cette quantité est énorme. Je pense qu''il faut effectivement passer les bananes à la poêle. La seule fois où je ne l''ai pas fait, elles ont rendu du jus une fois les mousses au frigidaire et ce n''était pas aussi parfait. Concernant le goût des bananes, j''achète en général des bananes bio : elles sont meilleures que bien d''autres.', '2006-05-13T20:21:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29858, f12ee4a6-a741-4fbf-83dd-a600cb760e1f, 'Tout simplement délicieux, à s''en rouler par terre! Pour la Saint Valentin, j''ai divisé les quantités par 3 (il en reste encore comme ça !) et j''ai mis le tout dans des coupes à glace, boudoirs entres les 2 mousses et quelques éclats de noisettes caramelisées sur le dessus...Du plus bel effet !  Peut-être peut-on ne pas cuire les bananes pour garder le goût de la banane nature (cuite, c''est différent) mais c''est extra super bon ainsi ! ', '2006-02-15T09:51:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29858, 8f0fb3c3-2667-44d0-bef9-816e0533e97a, 'Un veritable délice! La présentation de la mousse dans un verre est digne d un vrai restaurant, les deux mousses se superposent est c''est vraiment joli. C''est un dessert original qui régalera tous les gourmands!', '2006-01-27T10:40:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29858, f8402355-3fca-4e4f-b0ef-3b018089b87f, 'J''ai essayé les 2 mousses, pour faire une charlotte chocolat/bananes. Elles sont délicieuses, un peu longues, mais relativement simples à faire. ', '2005-12-03T13:09:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29858, e5c36fa1-4652-4c81-9542-d1a277565ebd, 'Très déçue... N''ayant pas suffisament de verres, je l''ai faite dans un grand saladier, au niveau présentation c''était lamentable! Enfin, beaucoup de boulot mal récompensé, le goût n''étant pas non plus à la hauteur de mes attentes.', '2005-02-12T19:59:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29858, 9c66df0b-ead3-40e7-84c6-066b25e611e6, 'La mousse au chocolat est un régal... Par contre, effectivement les quantités correspondent davantage à une bonne quinzaine de personnes...', '2004-12-26T02:28:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29858, bbf1aaf5-ea17-40bd-b989-adfaed2d0bf6, 'La consistance de la mousse de bananes est parfaite, même sans gélatine. Le goût de la banane est très présent et ce n''est pas écoeurant, tout le monde a trouvé ça absolument délicieux! Par contre, je n''ai pas essayé la mousse au chocolat, j''incorpore plutôt ma mousse de bananes dans un gâteau roulé au chocolat, avec du chocolat noir fondu par dessus. C''est beaucoup plus réussi que la mousse à l''orange (loupée), au citron (bonne mais un peu acide) et à la framboise (manque de goût), que j''ai testées à partir de recettes données sur le site.', '2004-12-12T22:56:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29858, a8a87353-30a8-4c1b-b1b5-9875445d56e4, 'Bravo, et merci pour cette fabuleuse recette. J''ai laissé les mousses au réfrigérateur pendant 5 heures seulement. Autre chose, les proportions sont parfaites mais faute de vrais verres, j''ai mis les mousses dans des verres en plastique et j''en ai rempli  20 verres, en quantité tout a fait suffisante. Donc les proportions sont tout à fait correctes pour 15 personnes au minimum. Tout le monde a ADORÉ !', '2004-11-30T13:27:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29858, 03f60a3f-510b-4368-813a-69a71ba876a1, 'Très bon, même si peut-être un peu trop sucré. Pour ma part, j''ai imbibé les biscuits (à la cuiller, je n''avais que ça) au rhum et c''était très bien. Pas de panique sur l''aspect liquide de la mousse au chocolat: elle durcit au frigo. Le gros avantage de cette recette (qui prend un peu de temps), c''est qu''elle se prépare la veille ;) )... Merci!!', '2004-11-23T19:24:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92582, 6c9145c3-8746-4127-858c-fd9b79aebd34, 'Très facile à faire et apprécié à la maison. Je les ai saupoudrées de sucre impalpable. A faire avec d''autres fruits.', '2011-01-06T18:39:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42979, ce76bd0e-96e2-4188-a1d1-18f22e2357cc, 'Même si l''on sait qu''il y a du beurre de cacahuète, on en apprécie pas du tout la saveur, on goûte fort le goût de la banane, mes invités ont trouvé mon repas très écoeurant', '2009-01-31T10:51:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42979, ba444593-6e60-4a56-8690-ae56686e5360, '8.5/10 d''après mes invités.', '2022-01-30T17:05:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42979, 55fd3464-bbb9-4111-91b7-ef57c54a0d0c, 'Une excellente recette très facile à réaliser. Mes invités étaient ravis.', '2007-10-10T13:34:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345136, 159f3c92-a9e0-4c85-be3a-909914f93a16, 'Très bonne recette pour ces qui aiment  le caramel  
', '2021-11-06T13:50:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345136, 1566946b-759b-482d-9ee5-8ede407c1606, 'Très bonne avec la glace au beurre salé on peut mettre d autres goût , chocolat', '2019-04-07T07:51:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 1ddce65c-9303-442e-81ed-968c6a8846a2, 'Très simple et très bon, j’adore', '2022-06-12T14:40:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 57f66108-fdea-4d9e-b62a-221e8994bbda, 'Recette facile, très rapide et très très gourmande !', '2022-05-25T16:14:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 94d387a1-8fc9-4bdd-9640-cf1f9d106f68, 'Je suis toujours la première à rigoler des commentaires : j''ai tout changé et c''était bon.. mais... Je n''avais pas de crème, remplacé par un yaourt et un peu d''huile végétale façon gâteau au yaourt et c''était très bien !', '2019-05-31T14:07:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 7cf0c4ad-1b15-429d-9ea2-98c17f3cbb26, 'J''ai rajouté du rhum de l''extrait d''orange, de citron, de la vanille liquide et du pralin.', '2022-05-01T13:36:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 0a85bc4b-ed41-4567-8c0f-5dc59c2cbf86, 'Délicieux avec du lait de coco et du rhum ! ', '2022-01-03T12:00:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 86145348-83fe-4f73-905c-e804cfa99010, 'Exquis ! Je cherchais une recette avec de la banane et j''ai vu ce gâteau. Une belle découverte !', '2021-11-08T07:24:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 2952574a-a8a5-44f0-a6e1-44e8fb6b291a, 'Excellent. Je l''ai préparé la veille: Impeccable et servi avec une petite verrine individuelle de glace à la banane, recette trouvée sur Marmiton. Vous me direz encore de la banane. Oui nos voisins nous en ont donné une énorme main, il fallait en faire quelque chose.', '2020-11-20T11:42:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, a35a2513-06d9-4996-93bc-8de7ee54629b, 'Franchement, c''est très bon. Bon j''ai un peu remplacé quelques trucs à ma sauce: Un peu moins de sucre dans 1ère prépa (75 g largement suffisant) + mix farine sarrasin + maïzena (sans gluten oblige), pas de crème fraîche (plus) mais 1 yaourt + crème d''amande. 1 cc de rhum (en mettre +) et ajouter une 3e banane la prochaine fois. Cuisson 20 mn + 15 mn (180°) + 7 mn (160°). Possible d''ajouter des pépites de chocolat. Gâteau tropical bigoût surprenant mais succès garanti !', '2019-12-15T22:58:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, d6b9a9db-378e-4e1a-8d7b-66edc73ba9a2, 'Cette recette est terriblement délicieuse ... J’aime la coco et la banane et je trouve ici le mélange parfait des saveurs. J’y ai mis moins de sucre ( 50g en moins) et 3 bananes. Fait deux fois et que des compliments ...', '2019-06-05T02:09:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, ccac7d30-d124-4aed-aa77-181a1536cee1, 'Excellent gâteau ! Fan de chocolat, j''ai rajouté des pépites dessus pendant la cuisson, le mariage avec la banane et la coco est une tuerie ;)', '2014-11-15T10:20:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, aef25f1a-a345-4de6-a48f-c06fb22b8e81, 'Très bon et facile à faire, une réussite dès la première fois.', '2023-09-23T12:40:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, fac483cb-e25a-434e-abf5-bb63c4d77ffc, 'Très bon! J''ai remplacé la crème fraiche par du yogourt nature. Facile, rapide et sans beurre. ', '2023-04-26T15:54:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 7b0d2e89-e77b-4d75-952a-5b825a95a8ca, 'Excellent, moelleux, facile à réaliser. J''ai battu les rondelles de bananes grossièrement. Avec du rhum un petit goût de reviens-y!', '2023-04-23T16:30:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, ca87d343-92d2-4bc6-9cce-49d9933b0a64, 'Excellent !! J’ai du improviser étant en panne de crème fraîche - 60g de mascarpone et 80g de lait de coco.', '2023-04-09T13:36:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 2bfb982b-952a-4f25-a42b-df4bd425999b, 'Très tendre, on sent bien le goût de la banane. C''est vraiment bon en rajoutant des noisettes avec la noix de coco ! Peut-être essayer de mettre du rhum avec les bananes. 
Bonne dégustation !😉', '2022-07-16T22:48:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 615341ed-434d-4b05-831a-097aa504ac03, 'Je n''avais pas de coco, j''ai mis de l''amande, ça donne un aspect macaron à la croute. J''ai ajouté un peu de rhum, ça parfume. Fait l''unanimité à la maison', '2022-03-26T16:52:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 292d474f-188b-4b19-a79e-865e1f35cfe2, 'J''ai réalisé ce gâteau en cake et j''ai mis 3 bananes, le goût a été splendide et pas du tout sec. À recommencer.', '2022-03-17T16:57:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 515ceeaa-fc2a-4324-bb0c-9f4dcf80cdec, 'Excellent tout en respectant la recette ! ', '2022-03-06T18:13:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, e64aa8a0-aca8-41f6-96be-74cfc671d79f, 'Hyper bon. J''ai eu besoin de moins de temps de cuisson par contre.', '2021-11-17T17:36:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, b875f568-d5f1-4b52-be17-062b0fb62233, 'Moi qui ne suis pas trop fan des bananes, j''en avais beaucoup à utiliser et j''ai donc testé cette recette. Un délice, simple et rapide ! ', '2021-03-20T09:56:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, dc36e88c-ad0d-44a5-acb7-5d66a9f8f5bb, 'Excellent gâteau ', '2021-03-07T22:00:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 7b59dac3-8e12-467a-938c-3594c7769886, 'Super bon ! ', '2021-03-07T15:03:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, ac95000c-4e68-4311-8141-df743643d8c4, 'Un délice. Mon mari qui n''est pas dessert a adoré et moi aussi. Facile, rapide pas compliqué et très bon. Merci, je le conseille. ?❤', '2020-06-12T12:29:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 888a2cd7-89a6-4d1d-8a96-48300106af08, 'Excellente recette. Pour la première fournée j''ai divisé le sucre par 2. J''ai remplacé la crème fraîche par de la crème coco. J''ai rajouté des pépites de chocolat dessus. 15 + 20 minutes de cuisson. Superbe !', '2020-03-24T17:19:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, a3517ecc-3206-4d14-aca2-530773a6a3e3, 'Excellent !!! J''ai mis plus de pâte "coco" pour plus de gourmandise, et c''est une tuerie !', '2019-09-19T12:16:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 4a30dc61-fba8-40c8-a369-fe9f0f44ec85, 'Encore une recette délicieuse !!!', '2019-04-08T01:21:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 1a2394cd-9a69-4adb-80b8-43dd6895bccc, 'Ce gâteau fait fureur à chaque invité, c''est une valeur sûre quand l''on aime la banane et la coco !!! Merci pour cette recette', '2017-06-13T18:11:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 74f12014-ef95-4426-9e48-6949c7cb36c2, 'Excellent! Je rajoute un glaçage au chocolat avec quelques rondelles de bananes sur le dessus et je vous garantie que vous vous régalerez! ', '2016-11-19T15:36:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, c01e8adb-8733-4069-8dcb-048e46addfa1, 'Tres bonne recette moi je mets un peu moins de sucre et la noix de coco à macérer dans le rhum avant et j''ai rajouté quelques zestes de citron vert. Humm un régal. ', '2016-07-22T11:55:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 5757a724-a8ed-44f7-aea4-9f44b8546a3e, 'J''ai toujours été complimentée avec cette recette. Valeur sûre pour ceux qui aiment la coco et la banane.', '2016-07-04T21:18:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, ce5c5818-badc-458b-98ac-c03f36e7cc58, 'Juste excellent.', '2016-06-04T18:37:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 467fd279-7ebe-4a2d-a72c-2efcd47f2b7a, 'Très bon.', '2016-05-23T08:37:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 65ccd010-7c3f-4822-96c7-6611455551f9, 'J''ai mis que 80 g de sucre, et fait cuire 15 min les deux fois. Super bon !', '2016-05-04T18:17:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, aca11337-c22d-4f76-b6e9-d588ab46e64e, 'Je trouve ce gâteau très bon. On sent bien le goût de la banane et de la noix de coco. Délicieux !', '2016-04-24T13:27:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 2e4c682a-8c7f-40f3-9df2-e0e30ff04c19, 'Même en remplaçant la banane par des pépites de chocolat, cette recette est top!', '2016-04-13T00:36:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 9a8e6f1d-cce0-4e14-8efa-9cbd3e27cdda, 'Très bon gâteau, pas lourd du tout! Je n''ai mis que 80 g de sucre dans la première préparation.', '2016-03-28T18:33:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 04736e76-1de6-4470-85b5-20f7b7a80a26, 'Délicieux et hyper simple à faire, j''ai rien changé à la recette et la note précieusement, merci !', '2016-03-13T14:37:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, e4e0268c-a20d-4e79-bf5e-a89b83927a4a, 'Excellent j''ai adoré, rien à changer en plus c''est hyper simple', '2016-01-30T15:22:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, fe9c9d9c-ebc6-49a4-8448-9bf741ee8ea8, 'Excellent. Ne rien changer à la recette. L''idée des 2 couches permet de préserver les arômes bananes et coco à la cuisson. Prochaine fois, j''essaie les raisons secs avec.', '2015-06-23T00:30:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, a7f75d7e-0efe-4ce3-ad67-d5630baa9ef3, 'Très bon ce gâteau ! On sent très bien le gout de la banane et de la noix de coco ! Très facile à faire en plus !', '2015-05-07T16:20:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 7e09bed8-7a1b-449f-9260-7eeaec48ad0e, 'Super simple et tout simplement délicieux ! Le mélange exotique coco+bananes est canon ! :-)', '2015-02-22T16:56:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 09ba8106-02d1-4a1f-86e7-f339cdd6f48e, 'Super gâteau pour l''anniversaire du plus jeune. J''ai diminué la quantité de sucre. Grand succès auprès de tous !', '2015-02-08T15:44:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 540324f2-4c89-43bc-82ef-9275c22883ab, 'Comme sur la photo, pas du tout sec, moelleux épatant pourtant moi et la banane... on a le gout sans les morceaux, génial à refaire sans rien changer', '2015-02-03T21:18:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 74ad7639-8add-4f30-b29a-dd2a5e0f2fb7, 'Excellent gâteau. J''ai mis 2 bananes. La prochaine fois 3 voire 4. Mélange parfaitement délicieux. Merci.', '2014-12-13T22:43:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 4b43df1a-9290-4a34-a9fc-bb3b4987bbf3, 'J''ai mis 80g de sucre complet, 1 cuillère à café de 4 épices, 3 petites bananes et ajouté du rhum. C''était délicieux ! Je n''ai pas fait la couverture pour réduire les calories.', '2014-11-11T22:47:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, a7941fc9-b910-4fbc-8ce0-caa99760f995, 'Très bon gateau. Léger, moelleux... Délicieux ! Le mélange banane-coco : vraiment original.', '2014-10-27T20:47:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 2722503e-2cb2-4e63-92cc-476315582cd8, 'Très bon gâteau ! Se mange aussi chaud ! J''ai remplacé la crème par du fromage blanc et tout le monde a apprécié :)', '2014-10-22T22:58:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 135e8859-9b27-4acb-bf41-2f52832e1a2c, 'Excellent. A chaque fois que je l''ai fait, ce gâteau était fondant et délicieux. Petits ou grands, tous en redemandent. Pour ma part, je mets un peu moins de sucre à cause de la banane.', '2014-09-24T00:23:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, a1b9435e-03e9-431d-bd44-3ff8ef19fc29, 'Excellente recette ! Bravo ! ', '2014-08-22T01:41:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, c225bdd2-6caf-41b8-ab52-5c5c87edb2ca, 'Très bon, également avec 3 cuillères à soupe de cacao dans la pâte avec les bananes. D''accord pour le cuire 5 minutes de moins avant de mettre la préparation à la noix de coco. Très bon gâteau dans tous les cas ! Merci pour la recette !', '2014-07-14T01:14:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 6b5bc363-64f7-4136-9888-76961fee2e53, 'Trop bon !', '2014-06-29T18:56:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 43475938-8c40-4120-8b40-1f58c9d8350a, 'Super recette ! Rapide, résultat excellent, toute la famille a aimé. J''ai suivi la recette à la lettre.', '2014-03-07T00:20:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 1308e1bf-23dd-4ad0-8480-0de2e8cc7b16, 'Je l''ai fait dimanche. Rapide et très facile à faire. Que 30 min de cuisson avec mon four. Tout le monde s''est régalé petits et grands. Tiède ou froid ce gâteau est extra.', '2013-12-17T15:45:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 88c2c5e0-5d43-40d9-9689-ce71399a603f, 'FannyK86 a raison. Il faut cuire ce gâteau un peu moins longtemps et mettre la préparation à la noix de coco plus tard. Goût excellent. Je referai sans doute.', '2013-10-13T13:45:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 4f963551-f3ad-4c5c-b1fd-93c27518696b, 'Très bon mais il faut le cuire moins longtemps (environ 5 min) avant de mettre la préparation à la noix de coco (avec un four à chaleur tournante).', '2013-04-23T11:01:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, f1c0dbf7-ac3b-4a34-aeff-b318208d6bc6, 'Super gâteau. Je vais le refaire !!', '2013-03-29T22:37:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 6d23f9f6-0f8f-4ba5-a060-1c6a3c896af7, 'J''ai suivi la recette pas à pas car je suis nul en cuisine. Un délice tout simplement. Merci.', '2012-05-18T21:25:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, e3085cf8-a12d-4c40-94b4-b03dc9387c82, 'Super bonne recette ! J''ai remplacé la crème fraîche par la crème liquide et saupoudré la première pâte avec un peu de poudre de cacao. On en redemande. Merci d''avoir partagé cette recette.', '2012-04-09T00:05:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, 48c81209-92b0-4b0f-bf3e-38fd2c74203f, 'Très simple et délicieux !', '2012-01-22T13:19:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49902, f48f0401-54a0-4d45-b321-710200635cf2, 'Fait hier !!! Félicitations des enfants (qui ont participé à la confection) et même de moi !!! La recette est notée dans mon cahier et sera réutilisée !!!', '2012-01-03T21:43:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 731e8688-24a9-4a5b-9a6e-0ba97dd9e7d0, 'Y’a longtemps, ado en camping, je les faisais chauffer une ou 2 petites minutes sous la braise d’un vrai feu de bois. C’était encore meilleur !', '2022-03-19T12:45:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 2e0f28df-8158-4f4e-905e-3123f0452fd6, 'Super dessert pour soirée', '2021-11-22T20:59:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 77070d9f-8264-4d28-b539-8483b6b2f282, 'Super bon je n''ai pas mis le chocolat pendant la cuisson, mais étaler du Nutella dessus une fois la banane dans l''assiette… J''ai rajouté quelques fraises et de la chantilly humm le dessert a plus à tous le monde, une réussite merci !', '2016-09-27T15:27:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, fdffda0e-071e-43ab-ae3c-4ec04902c570, 'J''adore mais je les fais au four à défaut d''avoir un barbecue.', '2016-04-23T14:33:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, a87a13c4-0388-45ca-80f0-d0df72602dc3, 'Trop bon ! C''est devenu un incontournable de nos barbecues !  ', '2015-04-30T19:30:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 87c58587-abd1-427c-903f-aa842c21c1b9, 'Voilà un dessert comme on les aime : rapide et délicieux ! Ne pas hésiter à utiliser des bananes bien mûres et ne pas lésiner sur le chocolat (que j''ai mis en petites pépites). Mes filles ont adoré. Je ferai ce dessert souvent !', '2007-05-14T19:25:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 87473ee4-ec49-4275-8962-63485e0d3414, 'Je vais tester au four 🥰', '2023-09-30T17:30:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, ac455743-c462-4aec-b14e-dc9584080d62, 'Trop bien ', '2022-07-10T12:24:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 86c586bd-e78d-49f6-80b9-6d27d61f666b, 'Excellent, peut se faire avec différents chocolats', '2015-07-05T10:36:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 2b2deec7-ce71-4e64-8cdb-0f6eb35dece4, 'J''adore cette recette !! Jamais un barbecue sans une banane au chocolat en dessert. Par contre je mets du chocolat au lait. Je préfère.', '2015-01-12T19:55:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, d0837013-8ad9-4fe0-a727-e21df6b6ba85, 'Excellent à refaire. La tourner au bout de 5 min c''est mieux', '2012-07-24T00:52:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, e726f49e-5dd8-4cc7-94aa-24c82a42159a, 'Cette recette est bonne mais en ajoutant de la chantilly par-dessus c''est encore meilleur ! Cela adoucit le chocolat moir qui peut paraître un peu amer au premier abord.', '2009-11-14T12:23:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, b2dc57a2-894c-4c4f-a889-1fd9af6074c6, 'Avis mitigés de notre côté. Mes invités ont trouvé ça bon, j''ai fait barbecue de l''entrée au dessert. Moi, j''aime les bananes pas trop mûres, pour le coup, elles sont carrément cuites au barbecue, donc pour moi personnellement, ce n''était pas vraiment à mon goût.', '2009-05-30T01:08:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 9b889b0e-0cdc-46b1-a88b-4a0101a8d9f0, 'Rajouter en plus une petite flambée au rhum, c''est super bon.', '2009-05-27T11:19:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, e2e51b46-f165-4cb8-845c-d33dd4a80bb1, 'Pour moi un incontournable du feu de camp, après les pommes de terre et les oignons dans la braise (cuits dans l''alu avec leur peau, ils ressortent fondants !). J''ai fait découvrir ça à des amies américaines, elles étaient perplexes au départ mais ont adoré et vont expatrier la recette !', '2009-05-23T00:33:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, f6aef233-a0a8-4d36-aac6-570e3e6a86d5, 'L''essayer c''est l''adopter! Très bon aussi à déguster l''hiver directement dans l''âtre de la cheminée ou encore au four. Pour les gourmands, ajouter une boule de glace à la vanille... ', '2008-10-21T02:15:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 603a9b6f-a1db-4715-b03f-0cda87120332, 'Excellent pour finir un barbecue!!!  Préparation super rapide ( 5 mm) et effet garanti !!! Mais attention de ne pas vous brûler, c''est très très chaud!!!  Je n''ai eu que des compliments!!! Merci pour votre recette.', '2008-07-07T10:43:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, b3aa8172-7b04-47e9-80d5-8308b2e9e026, 'Je n''ai pas goûté votre recette mais c''est le genre de dessert qu''on fait en colo autour d''un feu de bois c''est génial et très convivial et pour ceux qui aiment le chocolat (comme moi miam!!!) ce dessert est extrêmement délicieux !!!! ', '2007-10-25T20:24:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 98cba4fb-fc6f-4f08-a4cb-1f49dc5de44c, 'Un vrai régal! j''ai utilisé du nutella, c''est encore meilleur, le goût de la noisette ressort super bien', '2007-08-09T10:31:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, be3159ce-2e02-4a3b-a23a-41b8a81c0c55, 'Simple et super bon ! A faire et à refaire...', '2007-07-26T19:48:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, b2d7e114-8d32-4fe5-b7f4-2f7b4a1ad9ea, 'Simple, rapide et plein d''effet à l''arrivée. Accompagnées d''une boule de glace vanille ou au yaourt tout le monde a adoré.', '2007-05-20T16:12:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 869c1002-bf26-4311-ad7f-a53da0135de6, 'Avec une boule de glace à la vanille et c''est le bonheur!', '2007-05-08T19:39:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 02e974bf-ed79-4c43-9675-9c5c8c91d976, 'Fait avec de la pralinoise, un régal!', '2007-05-06T22:30:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, e3fec194-cf1b-4d9c-99fe-c3c9b477288c, 'Au four c''est très bien aussi! Dessert rapide à faire et très bon, permettant d''écouler facilement des bananes qui commencent à tourner de l''oeil...', '2007-03-11T11:58:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 7bb2b53e-f79a-4e98-94c6-45f06926ff7a, 'Miam miam, un délice!!! ', '2007-01-28T19:48:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 78f7cd05-2310-4a57-89c7-e32ea0b702c0, 'Super idée. Facile et rapide à faire lors d''un barbecue improvisé avec des amis.', '2006-05-16T12:31:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, f9a02285-6c68-477d-b0a2-a233e7f049d6, 'J''ai laissé les ingrédients sur la table et chacun à fait comme il voulait. Un régal.', '2006-05-05T18:49:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 75b74d41-9db2-45c9-9bb9-aa58ad1e71de, 'Avec du Nutella mélangé avec du rhum!!!!', '2005-08-06T23:25:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 891440cb-a9a2-4519-984a-33285eddc6da, 'Ajoutez un bouchon de rhum dans chaque banane et mettez les au barbecue. C''est encore meilleur.', '2005-05-28T17:42:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 6ef2ad1e-2f0d-4866-bab0-9a39f5179884, 'Très bon! Mes invités ont été agréablement surpris!J''ai rajoutée de la noix de coco en poudre avec le chocolat! Excellente recette.', '2005-05-26T15:27:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, ba7f77de-ef66-479b-9b4f-1d1e6bf04c49, 'Un véritable plaisir pour le palais. La banane et le chocolat qui fondent sous la langue... extra!', '2005-04-21T15:52:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, a184507d-fe50-4342-b7fb-e84cef863330, 'Trop bon, ça me rappelle la colo!! Je les passe au four et une fois cuites, je les parsème d''amandes effilées grillées ou de pralin... Parfois, avec une boule de glace vanille ou coco!', '2005-02-25T20:26:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 489c5987-1b92-4933-bda6-f0f4a01c5d3f, 'Très sympa. Et excellente alternative aux bananes flambées pour bananes vieillissantes...', '2005-02-15T13:04:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 989f4fc3-7fa6-46cc-864e-35facf5fe7bd, 'Très bon avec le Nutella.', '2005-01-15T12:53:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 87993f09-fcb7-44e3-8658-38a0ded4f03a, 'C''est extra, facile à faire et original grâce à la papillotte. Sans barbecue, on peut faire la recette au four, en faisant cuire de 20 à 30 minutes.', '2004-09-03T01:03:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 82ed40d3-5098-47d8-adf2-8ccbac53fb68, 'Tout le monde a aimé.', '2004-09-02T00:39:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, c2202637-bddd-4b3a-86d0-0aa5cb2b6ccd, 'Moi je mets les bananes directement sur la grille du barbecue, je les laisse cuire (attendre qu''elles noircissent), je les retire, je fais une fente au milieu sans les ouvrir, je mets du rhum (il faut donc qu''elles soit encore bien chaudes), je fais flamber et je mets du Nutella à la fin. C''est top!!!', '2004-08-12T22:07:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 5cf37822-01a1-40d2-affa-d15a502396dc, 'Je trouve ça un peu écœurant... Et un surtout lourd pour une fin de repas d''été!', '2004-08-03T21:53:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 6ddffe88-c72c-4795-acff-e80ed940c97b, 'Excellent et tellement simple! J''avais un doute donc j''ai fait un essai (au micro-ondes) pour avoir une idée du goût. J''ai adoré et donc renouvellé au barbecue. Je préfère la formule avec pralinoise, mais ça, c''est selon les goûts de chacun!', '2004-07-27T22:33:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, c0cee31f-af5a-4a7c-894c-ac4dbb880a72, 'C''est délicieux. A part que moi j''enlève la pelure, j''enveloppe bien le tout avec du papier alu et je les place directement dans les cendres encore chaudes (si vous avez grillé de la viande par exemple). C''est cuit une fois que vous sentez le chocolat chaud et ça se mange à la petite cuillère. Essayez aussi avec une pomme, une poire, etc.', '2004-06-03T16:54:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, c78731b5-06c3-4f00-8801-87c29d38165e, 'J''ai testé, c''est une recette qui a eu du succès! Pour faire plus vite, j''ai mis les papillottes directement dans les braises. C''est peut-être plus appétissant quand on laisse juste le chocolat fondre, sinon la banane se retrouve en compote. J''ai utilisé du chocolat au lait.', '2004-05-31T12:25:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 4114d4f9-2b3f-4e00-b583-e327bb9b148b, 'Original au barbecue. Facile et rapide. Et, ma foi, bien bon! (j''ai opté pour le nutella)', '2004-05-18T18:37:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, a68e6b54-755e-4647-9fed-ade373fc2f74, 'Délicieux aussi avec du chocolat au lait, c''est au choix! ', '2004-05-11T00:05:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 7233a4d2-80bd-47b4-a430-a512110b0c49, 'C''est une recette que nous faisons souvent chez nous ; toutefois il n''est pas rare que nous remplacions le chocolat par du Nutella. Mes enfants préfèrent car cela nous permet de moins cuire les bananes.', '2004-05-10T00:58:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23215, 85f53752-2886-40c6-b0e6-461a8c09a42d, 'Délicieux. Toutefois, mon fils avait déjà testé cette recette chez des amis et les bananes ont été cuites dans les braises. Ainsi, la banane était plus moelleuse. A refaire surtout pour les enfants.', '2003-07-11T11:30:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46116, d6895e3f-f8c1-407c-9403-afb1b24b07f0, 'Simple, rapide, tres gouteux ! J''ai mis 3 bananes et je les ai mises en premieres sur la pâte. Un delice !', '2017-09-09T15:24:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46116, a71b0db8-8266-475c-9ff0-866bab2a7479, 'Bonne recette qui a le mérite d''être économique et facile. Un conseil cependant: la tarte est meilleure quand elle est bien fraiche.', '2010-03-22T12:46:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46116, a2fae0b3-8326-4484-a6e9-dcc66e7eb85c, 'Une bonne recette simple et rapide. J''ai pu ainsi utiliser des bananes qui attendaient depuis quelque temps et pour éviter qu''elles noircissent j''ai préféré les poser sur la pâte et les recouvrir de la préparation. Toute la tablée a apprécié.', '2009-10-30T23:33:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46116, 5da6add2-caaf-41d5-99ef-e12df4ab5e54, 'Dommage que les bananes noircissent à la cuisson ! Il faudrait mettre un peu de citron avant.', '2009-09-16T09:42:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46116, 944c3b0f-b37a-4b8e-91ca-199411070bad, 'Vraiment très bonne mais la prochaine fois, je rajouterai des pépites de chocolat. Elle peut se faire aussi avec d''autres fruits.', '2009-07-24T13:07:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46116, 79440c6b-b582-4363-b0ad-2b75226cc595, 'Très bonne à la sortie du four et froide le lendemain. Elle est tellement légère qu''elle se mange sans faim. Merci Beaucoup pour cette recette originale.', '2008-02-27T16:01:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46116, 23a27f43-87d6-448a-ae8f-a7084165c14f, 'C''est très bon et léger. j''ai d''abord mis les bananes (3 en tout) et j''ai recouvert de la crème et des pignons. Cela doit être aussi très bon avec d''autre fruits (poires, pommes, prunes etc.)', '2007-10-21T15:31:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46116, 60642e71-ee91-47d1-986b-aeae8f98bbfc, 'Excellentissime, merci', '2007-08-02T18:33:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46116, 6284991b-217c-4ed9-ab03-fde9732b32f6, 'J''ai suivi la recette et c''est délicieux. La seule chose est que j''ai mis les bananes sur la crème et elles ont noirci après le passage au four. La prochaine fois, je les enfoncerai légèrement dans la crème, je crois que ce sera plus présentable.', '2006-05-14T21:57:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92567, 2d6b84b7-d75d-4036-8e84-0d95115ac9cb, 'Gâteau pas du tout cuit même au bout de 30 min. L''intérieur était coulant. Par contre le goût était super grâce aux bananes mais autant prendre une autre recette pour le même goût mais un gâteau qui se tient debout. Je ne vous conseille pas cette recette mais il y a plein d''autres recettes de gâteau au chocolat et à là bananes qui sont sûrement mieux(se serai dur de faire moins bien).', '2017-05-21T20:07:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92567, f8d78bc8-76ee-4bb2-b2b6-17c9994a1be7, 'Super bon ! Par contre pas fondant du tout mais ULTRA moelleux, c''est vraiment agréable. Pour ma part j''ai mis du beurre fondu à la  place de l''huile et je n''avais que 100 g de chocolat. J''en mettrais plus la prochaine fois!! ', '2016-07-13T16:34:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528193, b14de645-22b3-49a3-83d6-36720489ac5c, 'Bien et bon, mais pas très esthétique. Bonne recette, il faut rajouter du sirop d’érable 🍁 (une cuillère ou 2)😊😁', '2022-03-18T15:35:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528193, 16530c81-c7d7-46c0-9039-4fe2140aec19, 'Super bon et moelleux !', '2023-04-17T16:57:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528193, 82d56d92-aca0-4218-9a74-569041c7f178, 'Très bonne recette !', '2022-10-25T15:19:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528193, 05a43d1a-c9e4-40bd-9021-c98f020e95f3, 'Pas mauvais, mais ce n''est pas là meilleure recette que j''ai faite de muffin à la banane...', '2022-03-13T16:09:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528193, bd4933cb-0d4c-432b-9d57-78db3ba389be, 'Top avec 1 noisette de pâte à tartiner ', '2021-05-04T18:14:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528193, 7b32876d-f907-40e8-b21f-100ce7fc7570, 'Excellent !! Super moelleux !! ', '2021-03-07T12:17:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528193, 456d95e7-61de-4661-970f-610a837935c0, 'Super recette ', '2021-02-14T19:11:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528193, 4407570a-a3f3-4679-8f38-63fb03827aea, 'Très bon et très réussi !', '2020-10-07T17:12:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19354, bee56fb9-7a1c-4f7d-930c-414aebd06566, 'Très frais.', '2002-12-06T20:26:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19354, fb016e6f-0544-489b-830c-b684e9aa992c, 'Délicieeuuuuux!!!', '2002-12-02T14:03:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50720, a73c5c8b-bc7f-44b1-9301-a47c6a294d98, 'Bonne au goût, mais en effet la texture est bof. La mienne n''a pas du tout prise, elle a gardé un aspect liquide ! Mais avec un nappage de chocolat dans mes ramequins les invités ont aimé !', '2009-08-10T10:48:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50720, 78ff4df2-451d-4434-a6d3-c7012bede11c, 'Je pense que cette crème aurait une meilleure texture en mixant les bananes. Le goût est bon, mais pour les becs pas très sucrés comme moi il faut réduire 1 peu la quantité de sucre.', '2007-03-20T17:20:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (343649, 6f3b5aa3-5a8c-4019-a4d7-0715a4250a42, 'Super recette ! Très rafraîchissante ', '2022-05-17T14:59:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (343649, 004d3762-9311-4c4d-8355-4e67050e2de7, 'Juste excellente on peut même remplacer 1/2 ananas par 2 kiwis.', '2020-05-15T19:30:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26113, 99a09b36-283f-460c-9ca3-8508bf1633b6, 'Ca ressemble plutôt à un pudding qu''à un flan. Je déconseille de mettre la farine en une fois dans la pâte chaude: grumeaux garantis!', '2004-03-20T16:27:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22297, f3c5c8c2-29b9-40cb-9e1a-a73bfb67b016, 'Au vu du précédent commentaire, j''ai mis 3 fois moins de sucre et c''était très bon. Mieux vaut utiliser des ramequins individuels, la crème n''étant pas très compacte.', '2005-01-20T19:22:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22297, abe3a921-49be-45b9-8be9-32b4c76a6ff2, 'Personne n''a aimé. Beaucoup trop sucré et l''aspect n''est pas appétissant!', '2003-05-13T22:58:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222588, a34776bc-e547-4d6e-974c-907abd2fecca, 'J’ai prit la quantité pour 9 personnes pour la pâte à crumble. J’ai mit 1 mangue et 5/6 bananes. Et de la cannelle en plus dans la pâte et sur les fruits. Une tuerie !', '2022-02-07T16:59:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222588, 44a683c4-2ef8-433f-8cfd-9c5f2591395b, 'Très bon !! Merci pour cette petite recette.', '2016-05-03T18:44:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222588, 27f519ac-7656-4b41-9030-1ac72aa52ede, 'Fait!! Excellent. J''ai ajouté deux bouchons de rhum et mélanger 100 g de farine et 100 g de poudre d''amandes.', '2016-04-13T01:40:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222588, 1b9b7a85-807d-44e3-83e3-8626d19eccca, 'Très bon. La prochaine fois, je ferai une purée avec les fruits ce qui permettrait d''avoir un bon mélange de goût. A refaire !', '2014-08-22T19:48:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (222588, b5204a3d-cf8d-421b-9db0-3583f7f11ae6, 'Très bon ! Merci pour cette recette !', '2012-12-28T01:42:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228098, 8b2dfa88-c72a-4a24-ba43-9bf892dccebb, 'Très bon gâteau !
J''avais un ananas frais dont j''ai coupé un peu plus de 200gr en petits morceaux que j''ai fait revenir légèrement à la poêle avant. 
La banane je l''ai écrasée.
Par contre j''ai mis plus de 50min à le cuire.', '2021-01-11T21:13:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228098, 4bd9ca05-dcfa-4751-8035-bce233547955, 'La pâte est était bien belle.', '2020-02-28T12:48:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228098, 3be35812-326e-47ac-87b0-1c8d93f7941e, 'Très bonne recette ! Par contre, j''ai mi qu''un pot de sucre et ajouté 2 sachets sucre vanillé. Un régal...', '2014-11-09T17:12:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228098, 51a80a8b-548b-4185-b64a-9478c8f8db77, 'Excellent ! j''ai mis un yaourt à la noix de coco pour avoir un goût vraiment exotique, la prochaine fois je mettrai moitié farine, moitié maïzena pour plus de légèreté !', '2013-05-11T16:57:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228098, 863271e8-6fa3-4a88-90c1-719859056df8, 'Ce gâteau est vraiment délicieux et mes invités l''ont beaucoup aimé ! Je l''ai servi saupoudré de noix de coco râpée. Le goût de la banane n''est pas très prononcé : la prochaine fois j''ajoute une banane (et un petit peu de farine).', '2013-01-06T17:49:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39136, 03977046-c8c9-42ec-afd9-ab64ed2bf182, 'Très bon. Ne pas hésiter à tester. Attention il faut que les bananes soient assez mûres sinon c''est farineux et fade.', '2013-11-10T22:52:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39136, ca4c8979-4985-4538-8d72-706ebb4f4a3e, 'Très bon et original ! C''est la deuxième fois que je le fais, et c''est toujours très apprécié ! Merci pour la recette !', '2012-08-30T12:28:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39136, b42b2567-8106-4bf9-a310-e11d5fe4a676, 'Ma banane était un peu mûre, mais finalement ça a donné un petit goût sucré parfait avec le mélange ail/tomate, à refaire !', '2009-12-14T19:35:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39136, 48102954-2a79-4d98-9f95-4fa655e1146c, 'Super!! En Afrique on appelle ça aloco! C''est très simple et bon.', '2008-09-04T20:07:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, 2e00f6aa-6063-41fd-8b11-f5ac121d3ada, 'Belle harmonie de proportions, même si personnellement et comme à mon habitude, j''ai réduit la quantité de sucre (80 g en l''occurrence). D''autant que le chocolat et la banane sont déjà sucrés. C''est "la" recette de crumble qui me servira désormais de référence! Merci !  ', '2005-10-06T13:58:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, abf770af-b8c4-49c7-b2a8-b1d37968d91d, 'Un délice, je remplace une pomme et/ou une banane par des poires de temps en temps.', '2022-12-20T10:39:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, adef2d27-9a5e-4b62-ac71-31b501b42dfc, 'Tout bonnement succulent !', '2022-10-01T19:37:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, 0531855d-d477-46b5-a818-6812e5e446c3, 'C''est sans hésiter ma recette préférée de crumble. Elle est facile à faire, rapide et délicieuse. Je recommande à fond !', '2021-11-27T16:25:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, 4065d044-3cb9-476a-8503-9a92ba644dba, 'Bonsoir 
Je n''est pas rajouté du sucre dans le moule cela fait un peu trop sucré !
Autrement très bonne recettes 
Merci ', '2021-11-26T18:49:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, c9f42ff4-fc98-4435-9082-e0d650fc88fa, 'Délicieux !! Merci beaucoup pour cette recette.', '2019-06-02T08:36:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, a36c4644-0d75-40e7-8c93-3d2a2d64e5fc, 'J''ai respecté les proportions à la lettre et le tout était un pur régal, un merveilleux dessert automnal !', '2012-09-30T23:57:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, 4d500388-8003-4a3e-a1ca-d214513268a9, 'J''ai été un peu déçue : le dessus à brûlé à cause de la température, et les fruits n''étaient pas cuits du tout. La prochaine fois, je ferai cuire plus longtemps à feu plus doux et je couperai les fruits plus fin. ', '2008-12-21T15:13:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, 35bab026-6a50-40dd-995d-71a2fabfad96, 'Premier crumble. Délicieux! J''ai doublé la dose de chocolat mais, au final, il y en avait trop (gourmandise, quand tu nous tiens!). Heureusement, j''avais mis moitié moins de sucre. J''ai mis plusieurs fruits différents (poire et kiwi notamment).', '2007-11-16T20:31:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, c1c05978-149c-47fb-bbcb-c135c09fef17, 'Délicieux! je n''avais jamais fait ni même gouté de crumble ... mais je trouve ça délicieux ! Personellement, je n''aime pas trop la canelle alors je n''en ai pas mis... à la maison, toute la petite tribue a adoré ! Merci', '2007-09-27T18:43:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, f92a1218-c52a-453b-9036-6bd74d210aab, 'Vraiment très bon mais c''était trop sucré à mon goût! 80g de sucre suffisent je pense, et ne pas trop en mettre au fond du moule. Sinon c''était un délice!', '2006-08-11T17:31:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, 479c3fff-6ed5-4da6-8cbe-08b5606c7e1d, 'Très bon mais je n''avais que 200°C sur mon four et en laissant cuire 20 min c''etait pas assez. Il faudrait augmenter la cuisson! mais le mariage est succulent... moins de beurre dans la pâte à crumble et ce serait parfait!', '2006-06-20T17:35:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, 29db8638-403b-4769-9602-d9a7b12a1325, 'Délicieux, aussi bien chaud que froid! La levure apporte un plus à la pâte à crumble, elle est ainsi plus "légère".', '2005-12-18T19:48:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, 3af5dc99-c263-42c2-a61c-18e0f4e65efd, 'Mon chéri a adoré bien qu''il ne soit pas trop dessert ! Mais personnellement j''ai trouvé ce crumble un peu lourd, mais il reste délicieux... ', '2005-05-19T18:42:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, 15e38016-cbb8-40ee-9dfd-071d21548989, 'Sublime ce crumble servi tiède avec une boule de glace coco. L''association bananes/chocolat avec un petit fond de pommes caramélisées est vraiment terrible! Merci beaucoup pour cette recette à refaire sans hésitation...', '2005-02-28T17:47:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, 5c26a381-b415-4bfa-92b6-d85f2b643ea0, 'J''ai divisé les quantités en deux et mis 2 pommes et une banane. J''ai réparti le tout dans 4 verres à whisky qui passent au four, ce qui donne une présentation plutot originale. Pour l''instant, c''est la meilleure recette de crumble de toutes celles que j''ai essayé et la prochaine fois, je mettrai une boule de glace vanille par-dessus. Hummm!!!', '2005-02-07T21:22:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, 34a87f56-b4eb-46f4-8e76-c1c3bc5c3ae4, 'EXCELLENT ! J''ai juste oublié de l''accompagner d''une boule de glace... ce qui n''a pas empêché les invités d''en reprendre une part !', '2004-12-23T22:16:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, bc5b69a9-a0dc-459f-b7d0-bb166d2fc319, 'Un vrai régal ! Je l''ai goûté chez une amie, et je l''ai refait par la suite, tout le monde a adoré !! A déguster tiède avec une boule de glace à la vanille.', '2004-12-23T16:13:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, 9205a51f-b1a1-4fe2-9e74-5dfb4408112e, 'Délicieux crumble. Je l''ai fait avec 5 pommes et 1 banane. Je pense que 3 bananes, c''est trop ; la banane étant très parfumée. Pour ce qui est de la quantité de chocolat, c''est parfait. Il n''en faut pas plus.', '2004-12-22T13:10:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33361, 8cfc2beb-ed4a-4150-8148-91cd85e64567, 'Vraiment très bon! Seul hic: pas très présentable car ça part de tous les côtés... Peut-être parce que c''était encore chaud? On verra ce soir, il en reste un peu!!!', '2004-12-19T17:23:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52688, 52c11ff2-c2da-4c6e-85bb-df00e2c47c4b, 'Original. Renforcer le coté sucré-salé en hésitant pas à rajouter du sel une fois servi par exemple.', '2013-08-09T19:11:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52688, 1f289a08-f435-427c-842b-fed4d6d1082b, 'Sympa mes enfants ont aimé moi moins pourtant j’adore le sucré /salé.
J’ai rajouté 3 œufs dessus pour gratinés .
Rapide et facile a faire.
Pour les proportions j’avais mis 8 carottes mais y en a pas assez qd au pommes de terre étant petites je en ai mis 16/17.
Et tout a été mangés ! ', '2022-02-12T13:59:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52688, ea301561-fe18-41b1-98cf-5a6aa27f92a1, 'Je m''attendais à quelque chose d''étrange, au final ça passe plutôt bien. Belle découverte, je referai !', '2021-09-30T20:54:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52688, e26bd932-0c1e-4e87-a630-1f4cf09846c3, 'Très original. En effet, le goût de la banane est prononcé même en utilisant que 2 bananes et c''est plutôt sympa.', '2013-06-04T22:36:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52688, 208c2a0b-d19c-470c-b511-816ba96c58db, 'Très bon ! Par contre, j''ai préféré mettre 5 pommes de terre (car elles sont de taille moyenne voire petite), 2 carottes et 2 bananes (pour 2 personnes).', '2013-02-04T18:28:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52688, e279d7e4-5a60-41ab-a603-8a7acb55a016, 'J''ai suivi le dernier commentaire : 250 g de pommes de terre/80 g de carotte/1 banane ... pas mal ! Je ressayerai avec moins de pommes de terre et plus de carotte voir une patate douce pour un côte plus orangé mais une banane suffira à mon avis - ne pas oublier le sel poivre, un bon morceau de beurre salé et une bonne cuillère de crème semi épaisse - servi avec magret de canard sauce miel orange du site', '2012-02-12T15:36:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52688, c50419fc-6b3a-4a8e-9943-e0f9ced19449, 'J''ai utilisé (pour 2): 250 g de pommes de terre (pesées net), 80 g de carottes, 1 banane, un peu de beurre et un peu de crème fraîche (à la place du lait). Original et délicieux!', '2009-05-03T17:38:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52688, 6768c7e5-1678-492d-b5c4-e6b4ac64edaa, 'Super! J''ai rajouté du lait, de la crème fraîche (allégée!) et j''ai servi cette recette en entrée, comme une soupe. Mes invités ont été mis au défi de découvrir tous les ingrédients ! ', '2007-01-31T20:31:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52688, f302b294-1e00-4aff-b13e-6422351ca112, 'Très surprenant, mon ami m''a servi cet accompagnement avec des crevettes sautées. Très bon mais nous sommes tombés d''accord sur le nombre de bananes. Peut-être qu''une seule suffirait amplement. Sinon à essayer avec variante...', '2006-12-16T14:45:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27742, 97587211-0bda-4b99-994c-cd2029b96c19, 'Réalisé l''été dernier après un bbq... excellent, je recommande. ', '2018-12-31T09:28:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229940, e9b10f66-20bd-4f7c-8602-93f2a4156314, 'Il faut plus de chocolat, moins de cannelle.', '2017-11-07T10:07:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229940, a14a69fe-36cd-416a-b894-55e1a4ba260a, 'Voila un second commentaire (mon 1er sur marmiton je me lance! ) et franchement pas déçue d''avoir testé cette recette malgré ce seul vote. L''alliance du chocolat, banane, miel et noix est bonne et permet au gâteau une variante de la version choco classique et d''avoir un gâteau onctueux....', '2014-03-21T20:16:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229940, bae0a18d-ad19-40e1-9086-5b81e341c633, 'J''ai osé malgré aucun commentaire favorable et ce gâteau est délicieux et très facile à faire ! Le mariage du chocolat et du miel très bonne idée... et avec la banane et les noix miam ! Bravo !', '2014-01-29T17:39:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229940, 5819ccb6-832c-404f-bbae-f3998f8d63fe, 'Très bon, texture hyper fondante et pas trop sucré, petit bemol : Les quantités données ne suffisent pas a remplir un moule a cake.', '2017-11-06T21:34:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229940, 1cf2a329-3aa6-4365-a1ec-207fc3203870, 'Réalisé sans glaçage. Délicieux.', '2017-08-09T03:42:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229940, 644693c3-3191-4f4d-8b45-f5d96a270f83, 'Excellentissime !!!! Super facile à réaliser et fait sans glaçage !!! N''ayant pas de chocolat noir, et de noix ; je les ai remplacés par du chocolat pralinoise et des amandes effilées et poudre d''amandes. Gâteau terminé le lendemain... du coup ben rebelote puisque j''ai des bananes à écouler rapidement !!', '2017-03-21T18:21:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229940, 6c9115a9-a46a-4e1c-ba65-299b18f9ae4d, 'Très bonne recette, facile, légère et onctueuse. J''ai fait sans glaçage, très bon aussi.', '2016-05-19T23:23:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229940, 182d3799-ed9e-47aa-8b8f-c494d31a0ecd, 'Très simple à réaliser, j ai juste ajouté un peu de lait.  Très apprécié par mes enfants. je mettrai plus de miel la prochaine fois . ', '2015-11-13T18:42:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229940, 4647bb2c-8fd6-4551-8fd0-e7f6aa954a8c, 'J''ai testé cette recette simple et rapide un cake délicieux j''ai juste rajouté un peu de lait et il me reste également du nappage y en avait trop sinon excellent.', '2014-11-11T22:52:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229940, cece1aff-f597-416d-97e0-3dfd5cff4f35, 'Très facile même pour des débutants ! Gâteau léger et onctueux !', '2014-07-26T18:51:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229940, efa1a218-e1ef-457c-8700-6a45d7358ced, 'Fait en cake et en gâteau. Facile, rapide et bon. Je me suis retrouvé avec trop de glaçage par contre lorsque je l''ai fait en cake. ', '2014-05-05T16:31:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229940, 9954ceb6-96cc-4611-b2c6-8da523b78a66, 'Très bon et simple à faire.                         ', '2014-04-26T00:10:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60024, 8f6c29aa-0408-4e8c-9e59-9dd1d8355ad8, 'Vraiment bon', '2011-06-08T19:45:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, c9f80edc-273f-4364-8aa0-4a5a72ce7b17, 'Frais et léger ', '2022-01-13T15:09:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 8350e6b4-ac0b-4e7b-9aaa-09aef0ae3624, 'Vraiment très frais, c''est léger pour finir un repas.', '2015-05-11T14:50:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 16a0acc4-65ae-4bc1-86c5-80179e4e399c, 'Délicieux. Apprécié par tous. Tel quel pour les enfants. Avec un peu de rhum blanc pour les adultes, et voilà un délicieux cocktail. ', '2011-04-15T20:47:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, e4cc7159-3cdf-4ed7-a970-b7a05e881e81, 'Super bon ! J''ai mis moins de jus d''ananas et le résultat est bien crémeux ! ', '2011-02-01T14:39:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 47e8f1e2-256b-4b1a-85fb-80f26c56dd88, 'Délicieux, facile à faire, avec ou sans rhum, c''est un régal!!!', '2009-06-20T01:45:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 019df11b-ebbf-412b-935c-7bf718f2f32c, 'Mes filles et moi même avons adorés quant à papa il a rajouté du rhum bien sur... il parait que c''est hum divin! avis aux amateurs... merci.', '2009-03-19T13:58:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 60276d6b-c508-42c6-9500-a94ec4b5ebbf, 'Le bonheur des petits et des grands. J''ai ajouté un peu de rhum blanc pour cocktail avec alcool. Succès garanti.', '2009-02-01T12:55:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 346a7ae1-aef2-45b8-9a56-a94ffa459bc0, 'Léger et délicieux!', '2022-08-02T13:42:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 579229fa-8050-4575-a33f-597b48f6d567, 'Recette très simple et smoothie délicieux. Personnellement, c''est encore mieux quand on ajoute une ou deux mangues. Pour les soirées, avec du rhume c''est parfait ! ', '2022-04-16T14:01:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 90b95e7a-4579-4dfc-8a47-310240f0ae79, 'Un peu écoeurant', '2019-07-05T02:20:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 8333fa78-ea18-48a2-ac1a-7bba300616ff, 'Très bon mélange.', '2017-04-29T10:50:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 91507755-9ee1-4c54-8410-fc359c779ac1, 'Facile, rapide et délicieux ! Je n''ai pas mesuré les proportions, on peut faire "à la louche" et pourtant la texture et l''épaisseur restent parfaites pour un smoothie. Testée avec du jus d''orange.', '2016-01-18T22:40:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 2494b648-e503-47b4-b6c7-38aa1deec966, 'C''est la pina colada sans rhum très bon ', '2015-12-14T10:08:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 92827209-0165-4a56-b830-51acb5a3047f, 'Je l''ai fait avec un ananas frais mixé, c''était un peu épais, on l''a mangé comme une compote. J''avais mis la préparation au frais et c''était délicieux, tout léger et plein de vitamines. Tout le monde a adoré, à refaire sans hésiter !', '2014-10-15T22:00:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 95f7591f-b3ad-4abf-9a58-e5a92f74e8ad, 'Facile et un délice. J''ai baissé les proportions.', '2014-05-25T20:14:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, f43b82b4-558b-4f9b-a266-501c3b9fbb5a, 'Divin !', '2014-03-05T22:12:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 9d0bdd09-5c70-4fff-9f5b-b3cf2c945c59, 'Délicieux !! J''ai ajouté deux mangues !', '2013-03-20T00:01:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, d477f3a2-8635-49d6-a039-2401c2af1288, 'Vraiment excellent ! Proportions exactes. Bravo.', '2012-11-18T13:19:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 253c4de4-30e5-47b9-9829-9021ff7ada36, 'Rien à redire ! C''est parfait ! A mettre au frigo avant de servir car meilleur bien frais. Cela fait penser à une pina colada non alcoolisée mais en bien crémeux. Personnellement, après une tartiflette ça a été impeccable !', '2011-11-21T10:07:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, d78aefae-730a-46b8-b751-991035f7081e, 'Très bon et très agréable le matin. J''y ai ajoutée quelques gouttes d''extrait de vanille. Doit effectivement être délicieux en cocktail !', '2011-03-10T12:11:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 0dfcf415-a67c-4a32-b3a9-a0c623bd7219, 'Je n''ai pas accroché... Manque de saveur !!!', '2011-01-10T13:16:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 6725d056-5e2d-4792-b641-c42ef8747c41, 'Personnellement, je mets tous les ingrédients au froid, au moins 1 h avant de préparer le smoothie. Et, je rajoute toujours 5 ou 6 glaçons dans le mixeur. Idéal, pour se rafraichir en été !', '2010-02-27T20:11:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 54558448-5ab7-4d1f-bc89-aa915f648c1e, 'Un vrai délice ! J''avais peur que ce soit un peu trop liquide mais non, pas du tout ! C''est onctueux à souhait ! Merci !', '2009-10-04T11:01:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 13a142e4-158d-4cfa-bc75-1bc09bf73113, 'Vraiment délicieux !!!  A goûter absolument.', '2009-06-10T16:45:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 49d383e8-6a09-4c27-8299-d889663a8e3d, 'Vraiment excellent et super facile à faire même sans blender! je n''ai pas mis tout le jus d''ananas ( ça faisait une trop grande quantité) et certain ont rajouté du rhum, d''autres du malibu . C''est nature que je le préfère !!', '2009-03-08T19:21:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, e1a36996-2cbf-4cf3-bb96-b1a15e5581c5, '1ère fois que je faisais un smoothie ... Cette recette est une réussite! merci', '2009-02-24T19:47:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 580be9d1-dc64-4d8b-aafd-fabb57d7f685, 'Délicieux, frais et léger. A faire et refaire en toutes saisons. Merci !', '2008-11-10T16:18:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 7dcf2318-a188-49ac-9e79-f3004178326f, 'Je l''ai utilisé ce week end car il y avait des personnes qui sont ''sans alcool'', donc je n''avais plus qu''à rajouter le rhum pour les autres, tout le monde l''a trouvé délicieux !!', '2008-10-27T14:38:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 1b9347a7-854c-4021-aac4-248fc3fab1b6, 'A la place du jus d''ananas j''ai mis une boîte d''ananas en morceaux au sirop. Très très bon ! Aussi certains ont rajouté un rhum arrangé, c''est devenu une pina colada tip top !!', '2008-06-11T00:02:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, f2999dad-c1a5-4229-ac9b-26839a2901fd, 'Excellent! Je rajoute des morceaux d''ananas frais dans le mixeur et surtout un peu de Rhum. Excellent Pinacolada qui a eu son succès! Surtout, il faut mixer juste avant de servir afin d''avoir une légère mousse de coco sur le dessus...', '2008-04-14T13:19:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 1777c2aa-9c04-4888-b138-bd5ab8a5a1b3, 'A boire très frais, les enfants adorent', '2007-07-28T21:45:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44427, 5722609e-2691-429b-8513-2119f05d8436, 'Délicieux cocktail très onctueux, encore meilleur d''après moi avec un peu de citron.', '2006-06-25T20:27:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229510, 0ae87e90-7595-48a2-bf09-ab140182ee64, 'Facile à faire, pratique pour écouler ses bananes et très bon ! J''ai fait moitié farine de châtaigne et rajouté des amandes effilées sur le dessus.', '2021-12-07T21:57:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229510, 5ea3215a-e0fc-4101-be1b-df71e9d13b3a, 'Température pas du tout adaptée, j’ai pourtant testé de nombreuses recettes de banana bread ici à chaque fois avec succès, mais celle-ci est de loin la pire que j’ai testée. La pâte a durci, le dessus a commencé à roussir bien avant la fin du temps de cuisson et le goût... et bien aucun intérêt.', '2019-11-30T05:34:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229510, f73bff5b-b4b2-4517-8e19-fceb10a25a1c, 'Excellent. J''ai suivi les conseils 10 min avant de baisser à 200°C.
Un peu de sucre dessus pour le croustillant.
J''ai rajouté quelques carrés de chocolat noir.', '2019-10-05T09:10:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229510, baa3cdb4-f6a9-402b-b8bf-98d5ae162227, 'Facile.', '2019-05-08T14:33:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229510, 94f86b09-86ac-4a70-af6e-be6734668ee1, '35 min à 250°C sur un four à chaleur tournante c''est définitivement trop. Le dessus était brûlé et le dedans encore liquide... J''ai réduit le four à 200°C 10 minutes avant la fin pour limiter les dégâts mais il a quand même fallu supprimer le dessus. Dommage, je pense que la pâte n''est pas mauvaise du tout mais je la referai avec d''autres temps de cuissons et température', '2016-06-16T09:33:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229510, d946cba7-13bf-47d9-95f9-5ccee1ab790e, 'J''ai divisé les proportions par deux, j''ai obtenu un pavé bien dense. ', '2015-05-21T06:39:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229510, 4bd6e6bb-e002-4062-a041-d97a78fe7a07, 'Il est dur. ', '2015-05-02T23:59:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229510, 8e7fa5c8-6396-415a-bdce-3d21e6b7164a, 'Enfin la recette que je recherchais ! Pour une version plus light et healthy j''ai remplacé le sucre par une cuillère à soupe de stevia et j''ai pris de yaourts nature 0%...On l''a dévoré sans culpabiliser!!! C''était extra et on sentait bien la banane, comparé à d''autres recettes plus lourdes bourrées de sucre et de beurre... A faire et à refaire! Merci d''avoir partagé la recette!', '2015-04-29T23:31:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229510, 65cd26d5-b712-4b05-b2ea-3654ddc13fd9, 'J''ai mis une pomme et une banane en guise de "farce". Je n''ai mis que 200g de farine et c''était largement suffisant. En tout cas une super recette très diététique, parfait pour un thé entre copine sans culpabilité!', '2013-04-26T23:37:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229510, 91ddd077-1210-4c2b-a73f-dad25c8aaf37, 'Très bon. juste un peu trop cuit, je mettrai 5 min de moins la prochaine fois.  ', '2013-03-10T20:46:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73314, 5f853fdb-de03-40b5-9bda-28fcbbbb3367, 'C''est une bonne recette, à la place de la glace pilée j''ai mis deux boules de glace à la vanille... Bonne cuisine!!', '2008-07-17T14:15:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392219, 6337320f-d493-43e0-9acb-c81aa15a367c, 'Trop bon et moelleux.', '2020-08-24T14:53:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392219, ed04a903-9e30-468c-8f26-dc7bb54581c7, 'Parfait pour terminer des bananes bien mûres ! J''ai pris du chocolat à seulement 40% de cacao, du coup je n''ai pas rajouté de sucre. De plus ma banane était déjà très mûre donc très sucrée.', '2020-06-28T16:13:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392219, a6b76ea1-1f9d-4840-8714-bbf9d105f1e4, 'Recette realise tres facilement. On ne sent pas du tout le gout de la banane et top pour les enfants. ', '2020-05-10T10:10:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81620, 193da9c4-d473-4a74-98e9-06aa0ccbe5ff, 'C''était juste parfait j''ai adoré !!! À refaire et à refaire ', '2016-05-29T22:05:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81620, 4cd0c054-86ee-493e-bfed-480cac3ba9b4, 'Dé-li-cieux! je l''ai fait deux fois et ce n''est que le début !! J''ai mis tout le jus d''une orange et une fois l''ai mis un yaourt aux fruits, encore meilleur !!! Vraiment à tester !', '2016-05-27T22:07:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81620, d1936fcd-706e-4f75-8b2f-ebbc8eddd24f, 'Sans glace à la vanille et moins de jus d''orange c''est mieux.', '2014-10-12T16:10:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 00d84ba8-381e-4306-bcde-5c067c611ce0, 'Au moins c''est une recette rapide. Mais franchement ce n''est pas à "tomber par terre". Surtout ne faites pas cela lorsque vous recevez des invités.', '2008-08-20T21:40:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 7f526ae1-885f-42a5-83e3-f6ab57fd7b3b, 'C''est très bon. Mais je ne me suis pas aventurée avec une cuisson au micro-onde, j''ai utilisé mon four.', '2006-01-27T21:59:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 735c6c14-1000-400c-a5e1-58a7b79a583d, 'Facile et rapide mais pas vraiment bon. Mais il doit y avoir moyen d''améliorer...', '2006-01-12T10:19:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 68a2bcc2-10a5-4191-afcf-7a2b9324c26c, 'Niveau présentation: ça passe, mais à condition de ne pas faire cuire le flan trop longtemps. Niveau saveur : c''est relativement bon mais je suggère de rajouter 1 ou 2 oeufs afin que les fruits soient davantage pris dans le flan. Un petit plus : Accompagnez le flan d''une cuillère à soupe de fromage blanc.', '2005-11-28T23:21:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 4ff183c5-9dd7-444a-bcf2-5a8792608ebb, 'Les oeufs au micro-onde....pas génial! J''ai mangé une cuillère à café puis j''ai jeté ma préparation! J''ai eu l''impression de manger l''omelette de la cantine !', '2005-11-12T15:45:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 0a4472c9-060e-486b-a63a-33ed9299b287, 'Merci pour cette bonne recette rapide et pratique quand on a pas de four sous la main!', '2005-08-31T02:14:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, cc243b90-7b46-477e-b0f2-445cb2eab55b, 'J''ai effectué la recette tel quel, résultat: pas joli! J''ai essayé en changeant le mode de cuisson: au lieu du micro-ondes, je l''ai passé au four traditionnel et là... REGAL pour les yeux et le goût est meilleur!', '2005-04-20T18:15:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, cd7f3590-2aa2-4e0f-833d-647a6be13e3c, 'Un peu de bon sens! Un flan sans lait, ça ne peut pas ressembler à un flan! Il faut ajouter lait et farine, et là ce sera déjà mieux!', '2005-04-12T13:22:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 98e5b64a-f75e-4f5c-b02e-e14b11781feb, 'Dommage que le 0/5 n''existe pas. Il faudrait peut être y songer pour ce genre de recettes. Tout est parti à la poubelle. J''aurais du écouter les commentaires des marmitonautes...', '2004-08-16T16:10:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, ed3bb26a-766d-42bb-997e-7ac4b8fb7560, 'Recette complètement ratée !  On a l''impression de manger une omelette à la banane !', '2003-11-05T17:46:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 5b2cf96d-65ce-4aee-8f74-51a2074e18eb, 'J''ai trouvé ce "gâteau" particulièrement écoeurant!heureusement que je l''ai testé seule car j''aurais vraiment eu honte de le présenter à des invités. Un aspect peu engageant et un goût immonde ! Ce n''est vraiment pas une réussite et je n''encourage personne à tester cette recette ...', '2003-09-03T21:54:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, b1b71017-53f1-473c-ac48-152ca2362f3a, 'Peut-être que je suis bizarre, mais cette recette m''a dégoûtée. Je trouve ça vraiment pas bon et pas appétissant du tout. Mais je vais vite essayer autre chose pour pas rester sur quelque chose de mauvais. Après, ce n''est qu''une question de goût...', '2003-04-13T20:43:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 74437067-cb42-4efa-bf1f-436250bd291d, 'J''ai déjà exécuté cette recette deux fois. Les enfants adorent. Il faut cependant ne pas cuire la préparation aussi longtemps. J''ajoute soit du sucre glace ou du chocolat en poudre après léger refroidissement pour cacher l''aspect pas très engageant...', '2003-01-28T14:31:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, f9fa6c4b-1492-467a-8305-90a9ff3e8041, 'Je l''ai peut etre raté... En tout cas, c''était immangeable, lourd et surtout sans saveur (un probèeme avec les bananes)!', '2002-12-08T17:41:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 61ccc7d7-db5a-4c1d-bf3c-4d36c991e19c, 'Très facile à faire, bon avec une odeur très agréable. Les enfants ont aimé malgré un aspect particulier.', '2002-12-01T16:24:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, fb8f47a1-688e-4ff7-be38-5c25b741d479, 'Délicieux - j''ai remplacé le sucre par de l''aspartam et la crème par du lait concentré non sucré. Des ramequins démoulés sur une assiette garnies de sirop d''érable et d''un dome de chantilly en bombe. Ultra rapide!', '2002-09-04T13:31:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 56ce4542-a9e5-4925-a7ff-6ea4e85819c0, 'C''est très bon! Apparemment, le problème de la présentation revient souvent, mais il n''en tient qu''à nous de l''améliorer. L''idée de présenter le dessert dans des ramequins individuels est très bonne. Et le flan accompagné de glace au chocolat, c''est pas mauvais!', '2002-08-04T13:09:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 5ef861d4-c35f-497f-a235-b0f9ae21ba9c, 'Très bon chaud comme froid. Mon flan était tout à fait présentable. Je l''ai cuit à environ 850 W, pendant 4 mn à chaque fois.', '2002-07-29T14:51:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, f124181a-3009-40c1-8f22-518c0b01cca8, 'C''est un bon dessert pour les personnes au régime.', '2002-07-22T19:07:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 025e774e-db68-4f50-a31e-4b9f346d8262, 'J''ai tout raté. Je recommencerai pour voir...', '2002-01-31T13:07:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 923bf019-777a-4300-b0f1-37245811ea8d, 'Certes, les ingrédients sont bons mais c''est tout! La cuisson au micro-ondes ne donne pas un bon résultat et ce n''est pas présentable du tout.', '2002-01-07T11:06:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, d3653a62-df8d-4d7d-9fde-cb2bf7893d5a, 'Certes c''est moche, mais ca pourrait être bon. Pour ça il faudrait éviter de le laisser 10 MINUTES au micro-onde A FOND! 5 minutes c''est LARGEMENT suffisant.', '2001-12-25T10:29:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 72fb9fa9-3c46-467e-a1e9-37eb9dcfc3ce, 'D''accord, c''est simple à préparer, mais l''aspect a dégouté tout le monde... sans parler du goût... Non vraiment, je n''ai pas aimé!', '2001-12-20T12:01:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 086b9072-e696-49e1-bedc-f602f9541f7b, 'Facile, rapide et excellent pour le goûter.', '2001-11-25T20:31:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, b1794343-8d91-4c70-b1ad-c192c118cdb1, 'Quelle bonne recette, c''est délicieux et prêt en si peu de temps! Bon, certains parlent de l''aspect, mais c''est largement compensé par l''ôdeur délicieuse qui se dégage  du four avant même que l''on ouvre la porte!!! Bravo.', '2001-10-18T21:34:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 22dd883d-249a-4584-bcd5-64136c39ad84, 'Flan facile à réaliser mais l''aspect premier ne donne pas envie de le manger. Par contre, dès la première cuillère on ne peut s''arrêter... Il est très bon !', '2001-05-21T08:36:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, c85d9010-eab5-468a-98bb-544053004aa5, 'Vraiment pas présentable, je ne referai pas cette recette !', '2001-04-08T09:35:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 31b98514-2842-430b-9ea6-e5465105702f, 'Très bon et très rapide. Pour une meilleure présentation, mettre la préparation dans des ramequins individuels et saupoudrer de sucre glace ou de cacao.', '2001-03-06T11:31:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12252, 70fda370-78bb-4982-a9e8-068817205ff4, 'Bon, rapide mais pas très présentable.', '2001-01-14T19:40:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70597, 265c518b-32ff-4119-990c-3c743563e963, 'A faire', '2020-11-12T14:09:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70597, 9fba694f-11bc-498d-9321-7af26dc9484c, 'Je n''avais pas de banane, mais un vrai délice, très subtile en goût. Comme épices je n''ai mis que du sel et paprika. Les raisins apportent un bon goût sucré ! Un succès !', '2017-05-25T14:36:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70597, a355411d-0f54-4115-ad00-988ff3ff4ba7, 'J''ai remplacé la banane par l''abricot sec et ajouté des cacahuètes. Un délice, merci de m''avoir donné cette idée ! ', '2014-05-14T21:19:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70597, fc0ddfad-e20b-441c-85a8-3fd1e3098800, 'Très bien.', '2013-04-29T22:15:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70597, 59ed9eb4-e043-4dd8-9d31-5162355a823c, 'Original et délicieux... J''ai ajouté quelques noix de cajou à la fin de la cuisson pour donner un petit côté croquant et une saveur différente. Bonne dégustation.', '2012-11-26T09:44:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70597, 693ab2b4-3a7f-43f8-b2a6-60e57ee4fe4f, 'Je l''avais préparé et fait cuire dans l''après-midi, et j''ai ajouté une patate douce coupée en gros cubes lorsque j''ai fait réchauffer. Excellent, et gros succès auprès de mes invités (il a fallu que j''imprime la recette pour tout le monde) !', '2012-03-27T17:46:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70597, 39b5d5c7-0e59-48a5-84c8-b36d1a214bf6, 'Très très bon ! J''avais du lait de coco dans le placard dont je ne savais pas quoi faire, l''association avec la banane, les raisins et les poivrons est excellente, la recette a été validée par tout la famille.', '2010-10-28T00:10:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70597, f4797fde-82b8-47a7-8a49-490c32f13259, 'Une excellente recette ! Le sucré-salé rend vraiment bien. J''ai remplacé les tomates par une boite de tomates pelées. ', '2010-03-16T22:04:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70597, 20bb9aa1-2c07-4e6f-b9f7-ac3b93a5f4bd, 'J''ai suivi la recette à la lettre et c''était parfait ! Facile à faire et vraiment excellent !!! Merci beaucoup !', '2009-05-24T15:48:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70597, b46f2791-b4b0-47bf-8f56-d3b2bd20572e, 'Un vrai délice et surtout super simple personnellement je n''ai pas rajouté d''épice comme le curry ou  le safran. J''ai mis pas mal de lait de coco et ça a suffit, mes invités m''ont tout de suite demandé la recette. A déguster sans modération avec un petit riz thai ou basmati', '2009-01-16T21:59:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18149, 8d917021-7c1f-4c9e-8602-3e29fd8974e6, 'Très bon, simplement entières sur le barbecue quelques minutes, puis épluchées, accompagnées de chocolat fondu avec de la crème.', '2002-09-27T12:59:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172341, f53e737d-a89a-4868-b59e-f43686887ef7, 'Vraiment exquis. Les fruits exotiques et le lait sont super ensemble, c''est doux et fruité. Je n''ai pas mis de kiwi, juste mangue, papaye, bananes, fraises, fruit de la passion, melon et pamplemousse. Bref c''est vraiment bon, surtout que l''été arrive et que l''on trouve pleins de fruits exotiques dans les magasins...', '2011-06-18T03:10:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228485, e28a7813-0c19-4073-ba2f-1a2a511ef7d7, 'Je mets 20g chocolat vanhouten avec la farine et 1 plaque de chocolat blanc fondu avec le beurre. Sur le dessus je dépose une belle poire découpée en petit quartiers pour la déco et le moelleux. Délicieux, merci pour cette recette qui reste savoureuse au naturel. Je mets moins de sucre également. Bon appetit !', '2020-09-02T09:43:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228485, 452adaf7-a1c5-44e1-ac9d-cd4c2358dc94, 'J''ai fait cette recette en divisant les quantités par 2 mais ai laissé les 2 bananes et ai utilisé du chocolat à 90% de cacao. Un résultat très moelleux et agréable. 200° était un peu fort pour mon four sans chaleur tournante. La prochaine fois je mettrai sur 180° et qq minutes de plus. ', '2020-05-24T23:08:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228485, e05e78a5-9b6d-47a5-b2bc-8d2e040c4172, 'Super recette qui a eu un franc succès ! Je recommande !', '2019-07-01T03:48:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228485, 7d968b7d-e4f3-4e76-b032-73781550586a, 'Recette essayée un peu au hasard car j''avais un restant de bananes... Tout le monde s''est régalé et en redemande ! Personnellement, j''ai fait fondre le chocolat et y ai incorporé la "purée" de banane avant de mélanger à la pâte. Pour cette dernière, j''ai simplement pris soin de monter les blancs en neige et diminuer la quantité de sucre (125 g). Un gâteau très moelleux et très gourmand.', '2019-04-22T17:38:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228485, eba0c3bb-7cb2-43c4-8125-d532bdaf18f9, 'Réduire la quantité de sucre !', '2018-12-24T17:38:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228485, c46d1887-fc91-40db-be84-dbde43f31325, 'Recette très simple et rapide à faire!  j''ai diminué de moitié la dose de sucre et mis que 3 bananes.
Au résultat : un bon gâteau moelleux ( et non fondant ) et apprécié de tous ! Recette à refaire vite chez moi !', '2018-03-22T13:49:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52149, daec9f63-fdff-4ec0-a657-98ca7c64af65, 'Léger et délicieux ! J''ai mis que 100 g de sucre.', '2022-10-16T15:39:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52149, b7dc8385-0eeb-4fb4-9dc0-2b5e6115928d, 'Recette délicieuse ! Je l''ai déjà faite 2 fois et c''est à chaque fois un régal ! Par contre, je mets 1 banane et demie et seulement 80 g de sucre et c''est largement suffisant !', '2020-12-06T15:46:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52149, fd4e5faf-25ac-4372-990b-31e7d15fac75, 'Super bon, je l''ai déjà fait plusieurs fois ! Par contre je mets plus de banane (selon ce que j''ai et mon envie) et seulement 100 g de sucre.', '2019-02-14T07:48:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52149, 5d3efc5c-a0b0-423d-939e-9ba0f078d776, 'Super bon !', '2018-08-26T11:26:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52149, c52442e6-2ba8-490b-a6ca-0413e7f8be3e, 'J''ai suivi les conseils en ne mettant que 120g de sucre sinon recette suivie à la lettre. Tout le monde en a repris. Ce marbré est très moelleux et savoureux. Niquel !', '2018-03-30T10:35:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52149, 2d8186b4-485e-414f-9e3c-d30a374a7ddc, 'Jai diminué dune bonne cuilliere a soupe la quantité de farine, je nai mis que 100g de sucre et jai ajouté une moitié de banane, un delice! Ma fille et moi avons adoré. Et min conjoint qui n''est pas un fan de banane a beaucoup aimé ! ! Je recommande :)', '2018-03-06T10:28:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52149, 7373f39e-22bc-43a9-9b72-2806c955bddf, 'Bon. Moelleux.', '2017-09-16T19:46:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52149, e7c7157d-f93a-49ab-a4dd-c396137024e4, 'Lourd, presque écœurant.  ', '2014-04-03T05:02:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52149, 48f21ba3-e0a1-4611-a89e-35198619fe23, 'Délicieuse recette mais pour avoir plus le goût de banane, j''en mets 1 et demie !', '2014-02-24T22:25:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52149, 3624f2e7-7237-4248-bdf9-4fe49e2a28b2, 'Très bon et proportions équilibrées pour un résultat pas trop lourd... J''ai remplacé le lait par un yaourt et diminué un peu le sucre (120g)', '2012-12-15T19:20:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52149, ba3f5a5b-09c4-4ff8-9b94-ac7c03bf9c74, 'Super bon ! Très moelleux! A refaire. J''ai légèrement prolongé la cuisson ( question de  four ).', '2011-10-26T01:31:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52149, 55876a77-6531-40c1-a712-87c1161dea5f, 'J''ai bien aimé ce gâteau qui est bon mais il faudrait moins de 40 minutes de cuisson: le mien a un peu brûlé.', '2006-12-03T21:08:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, e74ea5fb-15dc-4152-aa0d-51c6c8f258fe, 'Excellent vraiment.. Un peu moins de sucre que la recette... Pour le reste rien de changé. Vraiment je recommande
', '2021-06-22T20:24:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 0071e19c-5c25-45eb-8756-18f89fb7c3db, 'Super recette.
Je l''ai un peu modifiée pour la rendre plus light. J''ai utilisé 100g de sucre au lieu de 150g. Je n''ai pas mis de beurre du tout, ni de pépites de chocolats.
Je craignais que ce soit un peu sec, et bien que nenni ! C''était super bon et moelleux. Toute la famille a aimé :) ', '2020-11-29T01:00:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, fe3e5ef9-65a4-49e2-9c18-8728409e43e3, 'En suivant les commentaires: 150g de farine, 100g de maïzena, 3 bananes et seulement 100g de sucre: Des muffins moelleux et délicieux ! A refaire', '2020-04-21T21:53:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 3e3d2f70-7822-40ce-8091-eb76ec0ca97a, '100g de sucre suffisent largement pour nous. Les muffins sont très moelleux. C''est ma recette fétiche !', '2020-02-18T09:50:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, a52308f6-8287-42fc-88ee-d0b772428873, 'Juste parfaits mais il faut enlever 50 g de farine.', '2022-12-31T11:11:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 8b111329-bbae-41cb-90d4-2cdae5af8985, 'Excellent ! ', '2022-04-02T23:40:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, c3b1539e-0c57-4c50-936b-9e900542d85d, 'Plutôt facile à réaliser et très bon, j''ai juste eu besoin de rajouter un peu de lait. ', '2022-02-12T16:50:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 6c039b53-c72b-427e-aab1-b9aa439915d8, 'J’ai mis 400g de sucre pour 1kg de farine 👍, par contre j’ai mis que 300g de beurre mais c’est un peu sec, je recommande donc de ne surtout rien changer d’autre 🧡', '2021-11-19T07:51:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, cfafe2af-9fc2-4627-9111-8f015ac5b73c, 'J''ai fait quelques modifications personnel
Pas de beurre, un peu moins de farine et plus de poudre d''amandes, cassonade en plus petite quantité et un peu sur le dessus pour le côté croustillant. 
Super recette très moelleux j''adore ', '2021-04-05T13:45:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 137e44b6-49d4-4cfb-ac04-eeceb824114e, 'Super recette. Et les pepites ne tombent pas à la cuisson. Toute la famille a adoré. ', '2020-12-02T21:13:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 23f046d6-4779-468a-80e2-610785d91de8, 'C’était excellent...', '2020-11-24T01:19:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, b90ff976-bced-4551-86b4-664d96a13710, 'Excellente recette qui n''a laissé aucunes miettes ! 
', '2020-05-09T21:15:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 1283d58c-bf96-4dd0-bd5c-4903ac68ee18, 'Au top ! De quoi faire 12 très jolis muffins.', '2020-03-29T16:41:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 8d520846-56ef-465f-9b51-bc3ea99a18fe, 'Je fais cette recette depuis des années et tout le monde adore ces muffins. Je mets parfois du rhum quand il n''y a pas d''enfants. Par contre, le goût de la levure est parfois trop présent, donc j''en mets un peu moins.', '2020-02-28T02:37:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, d9247725-20ca-466e-8646-d74576351733, 'Très bon ! Pour encore plus de gourmandise je les coupe en 2 horizontalement et mets une couche de pâte à tartiner dessus', '2020-02-12T04:12:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 5e8ad508-9ead-4104-ad80-1b91383c5dbe, 'Excellente recette comme d''habitude. Les muffins sont tendre et moelleux à souhait.', '2020-02-09T17:07:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 96e504f9-5eea-4815-9908-5916bedbc0e5, 'Top ! Par contre on trouvait qu''il y avait beaucoup de sucre dans la recette de base alors que nos bananes étaient bien mures du coup on a mi un peu de sirop d''agave.', '2019-05-06T18:09:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, e855d675-d83f-43af-bbf2-b5b0d28b3c2e, 'Excellent.  Avec un peux de noix de coco sur le dessus.', '2019-03-09T20:40:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, dddb641c-649d-4a98-8d38-ac1e3dc5e187, 'Bons gateaux. Un peu trop sucré. Mettre moins de sucre.', '2018-10-01T16:18:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 210ff9f1-761f-47f7-81a2-b5594e552096, 'Excellente recette par contre jai mis un paquet de levure et ça permet que ça ait gonfler plus et que se soit plus léger...
Recette adopté par toute la famille !', '2018-09-15T09:05:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 71cdccfa-1538-42eb-9fc8-bb631e7f7699, 'Recette adaptée en fonction de ce que j''avais: moitié sucre blanc, moitié sucre roux, moitié beurre, moitié huile. Très bon résultat et très bon goût. Très apprécié des enfants.', '2018-08-09T12:34:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 32e2cc14-2776-4af8-ba53-822de6d1a805, 'J''ai mis une banane de plus, un peu plus de chocolat et moins de sucre. Et j''ai rajouté le zeste d''une demi orange... un bonheur !', '2018-05-23T08:45:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, d137bc62-8f33-4c7d-afce-af691f9a00a3, 'Recette parfaite !  !  !', '2017-09-12T23:30:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 45b02274-f45c-43e0-bcff-36a020eaa9b2, 'Compacts et un peu lourds. Je confirme que avec 2 bananes on ne sent pas bien le goût. J''ai réduit à 100 g le sucre. ', '2017-03-06T15:59:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 2564da6d-a970-4dc7-8a3d-9f5f2e425a21, 'Simple et très bon', '2016-12-28T19:44:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, b8d20d61-17fa-47f4-846c-521ab82e8e43, 'Très bonne recette respectée à la lettre ', '2016-11-21T18:51:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 75cd7eed-c4d8-4315-ab56-d3910624f9a9, 'Merci pour cette super recette. Nous avons mis 135 g de chocolat au lieu de 100 g et pour le temps de cuisson, 22 minutes suffisent pour un four à chaleur tournante. À refaire !!!', '2016-10-12T18:17:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 8577cf98-8972-40bc-a69a-7af1463d4344, 'Recette très simple et efficace. Simplement délicieux, merci !', '2016-06-10T00:25:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 7ac3c067-5e2b-48fd-a917-b2ee018e1432, 'Très bons et très faciles à faire. Juste un peu trop sucré à mon goût. J''en referai en diminuant la dose de sucre. J''ai par contre mis 3 bananes, un délice !', '2016-02-11T15:38:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 6b6eece9-d472-4de1-88e9-520fe286b26d, 'Un vrai régal, les dosages sont parfaits ! Les muffins sont moelleux, on peut varier le dosage des bananes et des pépites en fonction de ses gouts !Validé par toute la famille ! ', '2015-11-04T14:16:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 1950d0fa-49c6-49b3-bfb5-390023d2e01f, 'Rien à redire sur la recette.  C''est succulent. Les muffins sont moelleux et aériens.   Juste une remarque : la prochaine fois je pense ajouter 50 g de pépites de chocolat ', '2015-03-15T15:53:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, e0debd6d-2e03-4884-9c60-ad1511d61829, 'Délicieux! Des beaux muffins bien aérées, moelleux et parfumés. Je n''ai pas écrasés les bananes, juste en rondelles fines, rajouté aussi un fil de crème liquide à la fin de peur que la pâte ne reste trop homogène et mis du chocolat blanc. La cuisson entre 22-25 minutes est parfaite!! Régalez-vous! ', '2015-02-23T19:32:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, aa3d9994-2fc8-407d-aaee-62795bdda775, 'Sympa mais un peu sec je trouve, je m''attendais à plus de fondant. J''essaierai de mettre un peu de mascarpone la prochaine fois !', '2015-01-23T18:33:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 5a8395e6-e1c0-43f8-bc89-ace2aa4c5133, 'Recette délicieuse, encore meilleure avec des éclats de Kinder maxi dans la pâte et un morceau sur le dessus du muffin, le top', '2015-01-09T21:09:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 147aec7a-738d-40dd-8600-3175beb3fc42, 'Très bonne recette facile et efficace. J''ai ajouté des morceaux de chocolat au lait sur le dessus, une tuerie !', '2014-12-28T17:54:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, a91bd220-ff24-47eb-9c99-1ee83182a02a, 'Pour ma part j''ai suivi à la lettre la recette mais nous n''avons pas assez senti le goût de la banane... Peut-être que la prochaine fois je l''écraserai moins. Mais très bon quand même, à refaire', '2014-11-10T14:03:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, e318cba8-4899-484b-b37c-8dc834e832b2, 'Suggestion : on peut ajouter du praliné, de la noix de coco râpée et du chocolat blanc en morceaux pour agrémenter les muffins.', '2014-10-10T19:45:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, bcf6ffab-a881-47bd-b33c-d99f87c388d8, 'Depuis que je connais cette recette, j''ai l''ai fait 202 fois par mois. Mon copain m''en raffole. Je mets moins de sucre par contre.', '2014-09-09T21:57:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 2146a7cd-1f15-4b4d-8c89-b2ad80413b88, 'Très bonne recette, gâteau moelleux.', '2014-08-16T22:51:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, d43306a6-4a5a-42ab-8548-f6e46716b13a, 'Grand succès de cette recette sur mon entourage ! Je mets également moins de sucre.', '2014-06-20T12:16:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, bbe66425-2289-4fd6-bd0d-04d4045114bd, 'Un vrai délice ! C''est toujours un grand succès quand je fais cette recette.', '2014-01-12T08:58:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 6b86fa31-5d0d-4eb8-aae4-07b7c0d98990, 'Excellent !!! Les muffins sont très moelleux et on sent bien la banane. Par contre, je n''ai mis que 100 g de sucre ayant lu les autres commentaires avant et effectivement c''est suffisant ! Recette à refaire, merci.', '2014-01-11T18:07:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 01af3d8a-f3bc-4869-9ee4-d0f5e4daaba5, 'Très bonne recette tout le monde a aimé !', '2013-06-24T20:21:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, f68a4f1d-04a8-4a10-810b-a2088e7c0be9, 'Ces muffins sont un délice ! Juste, au lieu de mettre 150 g de sucre, j''en ai mis 100, sinon c''est trop... J''ai découvert cette recette avec "Kitchen Fighter" la nouvelle émission de la chaîne Marmiton !', '2013-06-12T17:38:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, a4b4ce10-a869-42d8-887e-0d8ef3dc72d2, 'je l''ai ai faite, un vrai régal. Seulement j''ai diminué le sucre. Je n''ai mis que 100 gr, vu que les bananes sont déjà assez sucré. Et je n''avais pas d''amandes en poudre, alors j''ai mis des amandes effilés au dessus. Ce sera le petit gouter des enfants.', '2013-03-12T15:36:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, a8823aa1-3581-4566-97d0-d264faea904f, 'Les muffins étaient moelleux, avec un bon goût de banane.', '2012-12-20T18:43:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, cfc7c8dd-b198-4090-b6c7-6d63e23a37a6, 'Milles merci à l''auteur de cette recette qui a réussi à initier mon conjoint à la pâtisserie. Pour une première c''était plutôt pas mal, gâteaux sont très bons et restent bien moelleux.', '2012-12-10T22:12:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, afac48db-1cbc-4606-afcf-e3e1a2c32641, 'Excellent, cela a fait le régal du gouter... J''ai ajouté de la cannelle.', '2012-12-05T20:32:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, d9259bd5-9e3a-4c50-814b-732afd16146d, 'Fais la 1ère en ayant suivi la recette à la lettre c''était très bon, la 2ème en ajoutant une banane et c''est encore meilleur !', '2012-11-22T17:39:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 371f434b-8c52-43d8-a591-0f29c8d62a46, 'Excellent, rien à dire, j''ajoute un peu de crème liquide et je change de fruit à chaque fois, un vrai régal ', '2012-11-05T23:16:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, b9d3fef0-a5be-4b6a-9dd3-49bf19601680, 'Vraiment bon ! 15-20 min au four suffisent je pense pour garder encore plus de moelleux, et comme je n''avais pas de poudre d''amande ce jour la, je l''ai remplacé par 15 g de chocolat en poudre, ça marche aussi ! J''ai mis le paquet entier de levure, les muffins n''en sont que plus légers! Et c''est vrai qu''avec 3 bonnes grosses bananes on sent mieux le goût du fruit. Super recette !', '2012-11-04T17:10:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 15cc642c-b17c-4d4d-b136-b2bb800f175d, 'Rapide et apprécié de tous !!', '2012-10-22T16:32:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 960b53b5-224b-4f52-bed9-9bc82aa8a39d, 'Très bon c''est vrai qu''on sent bien le goût de la banane, la prochaine fois je mettrais un peu plus de pépites de chocolat !', '2012-10-14T17:18:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, bc8ed3ea-4d44-433b-abda-cc3d82d90ae7, 'Bons muffins, j''ai suivi la recette à la lettre. Les muffins sont un tout petit peu trop lourds et compacts, je suivrai certains conseils et remplacerai une partie de la farine par de la maizena la prochaine fois.', '2012-10-07T22:08:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, 3af6e30a-a54e-413e-a464-d68a5775a8dc, 'Avec les proportions légèrement modifiées pour le sucre (100 g), c''est très bon. La cuisson de 25 min les rend moelleux, franchement une bonne recette, même si je n''ai pas mis les abricots que je trouvais de trop.', '2012-10-07T12:02:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, d0163266-eb18-4619-a0fb-3409ca3ecb85, 'C''est très bon, personnellement j''ai ajouté des épices (4 épices + gingembre) mais je pense que la prochaine fois je rajouterai une bonne pincée de sel pour relever un peu... En respectant les proportions, j''ai fait 15 muffins moyens.', '2012-09-22T23:27:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, b9fe00a8-5497-4661-accd-6c4458988e4f, 'J''ai mis moitié pépites de chocolat noir/pépites de chocolat au lait. Meilleur tiède ou chaud.', '2012-09-22T19:06:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, e63b83f6-f2c9-42eb-adce-7e8e766fdb75, 'Succulents !!', '2012-09-22T01:40:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, eb196624-72b5-428f-af03-b92a75c1d3ea, 'Un vrai délice !! J''ai également mis 3 bananes et 100g de sucre. Muffins pas du tout secs. Merci pour la recette.', '2012-08-13T19:08:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49630, d1048689-ebca-4c84-acb4-3857eae06aa9, 'Parfait !', '2012-07-24T01:15:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, 5c3b3ea9-72c5-43be-baa4-25d959f456e6, 'Excellent clafoutis, ça change des cerises. Je remplace parfois les kiwis par d''autres fruits (aujourd''hui nectarines). Je mets un peu moins de sucre (entre 50 et 75 g selon la maturité des fruits utilisés) et je saupoudre avec un sachet de sucre vanillé avant d''enfourner.', '2025-09-17T11:57:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, 30f1d8de-7e06-4634-a15a-5da931a6eb71, 'Facile et rapide, qui plus est excellent. 3 kiwis très mûrs à utiliser d''urgence et du Soho (litchi). A refaire sans hésitation, encore merci MARMITON !!!!', '2020-12-23T17:43:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, d71e5f9d-354d-40b5-a482-b677e355d404, 'Excellent recette, merci ! (Réalisée avec 2 oeufs et 60 g de sucre, goût perso)', '2017-03-06T17:55:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, 0eb8d46c-b652-405b-9b0d-497889f68899, 'Très facile à réaliser et très très bon (le mariage banane/kiwi est toujours bon). Pour utiliser les bananes très mures, faire cuire le même poids de bananes et de kiwis avec du sucre glace et du jus de citron au micro-ondes. ', '2017-01-23T18:08:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, 178c828c-2b9d-4045-8685-ef7db8a778be, 'Très bonne recette, à refaire sans hésiter ! Mes enfants ont adoré et mon mari aussi. Le kiwi se marie très bien à la banane, je testerai avec d''autres fruits la prochaine fois.', '2016-11-24T18:31:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, c9b52508-9fff-4ab4-ba16-d277131edffe, 'Une recette très simple et tellement bonne! J''ai mis que 50 g de sucre et 2 cuillères à soupe de rhum. Un délice! ', '2016-04-10T18:44:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, 5522f97c-5339-44f0-b319-a90210622165, 'Très bon, moi qui n''aime pas le kiwi je m''en suis resservi...', '2016-02-10T11:31:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, 85a0870e-9e0f-4942-9d81-d82fcc04e393, 'Excellente recette ! Je me régale !', '2016-02-08T22:27:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, d1c4be61-231a-4b5f-a143-cc0747dc93a0, 'Simple et délicieux , sucre vanillé sous le grill en fin de cuisson . à refaire', '2016-01-31T14:51:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, 2ad5092c-cb0a-42f9-93db-faaceb643c59, 'Très bon et rapide à faire. Fait avec 4 kiwis, 1 banane et 1 pomme. J''ai diminué les quantités de sucre à 60 g et comme conseillé j''ai rajouté 1 sachet de sucre vanillé en fin de cuisson.', '2015-11-15T14:18:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, 8ec7c36f-c2a7-4ef1-96d3-aca4e756bd2d, 'Un délice ! Merci !', '2015-09-13T23:43:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, d0578670-fadc-4487-a734-490bd65e6a76, 'Très bonne recette, facile à faire :-) Réalisée avec 50 g de sucre et farine + maïzena et cranberries... 1 délice ;-) ', '2015-03-04T22:43:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, 2f050966-c958-42e2-a3b6-3dfe06df21ac, 'Très bon, belle association! Un sachet de sucre vanillé sur le dessus en fin de cuisson: le top', '2015-03-02T21:01:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, f44ea8ea-dbd8-454c-9f65-5f81d3853df9, 'Facile à faire et délicieux. Merci pour cette recette :-)', '2014-04-18T20:01:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, bee00d35-ab98-4b49-acfb-ed12645e660a, 'Très bon. que des compliments chaque fois que je fais la recette. merci. ', '2014-02-16T23:26:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, 8e8e31c8-8b5c-451c-a7f2-15c916fc1c89, 'J''ai mis 4 kiwis et 2 belles bananes et une cuillère à soupe de mirabelle. ', '2013-03-31T16:11:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, 0b8cfafe-d52f-49c1-b141-81a4501455c6, 'Très bon et original. A la fin de la cuisson j''ai saupoudré le clafoutis avec un sachet de sucre vanillé puis je l''ai passé au grill quelques secondes. Brillant et doré à souhait !', '2011-05-22T20:18:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, c662cb93-eb3d-4e98-90d5-5e0ccf5861b5, 'Super original et extra bon ! Mes convives ont aimé l''originalité de ce clafoutis, recette à refaire merci beaucoup !', '2011-04-29T17:19:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, 7dc160bd-6577-4311-8376-fc3aab4782ea, 'Recette délicieuse, même sans bananes! L''ajout d''1 cuillère à soupe d''alcool est une très bonne idée. ', '2009-01-14T16:34:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, 91cf395c-a642-422d-8fed-0333aa7c85a3, 'Délicieux! plus original qu''un traditionnel clafoutis aux pommes. L''onctuosité de la banane se marie très bien à l''acidité du kiwi. Et en plus très simple à réaliser!', '2008-04-03T19:23:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, 00dca655-d40c-4dbe-9a39-aa8d77aa3dc0, 'Surtout mettre plus de kiwi que de banane pour éviter la lourdeur. J''ai mis du rhum à la place de la liqueur.', '2008-02-25T23:32:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, f9a7f33d-6e41-4574-aecc-8cd0bc4f12c5, 'Vraiment très bon "à faire"!', '2007-12-13T18:15:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55809, a14daec0-fc39-4be8-85f3-c05e0f8d94b6, 'Décidément, le mélange kiwi-banane est vraiment excellent!', '2007-11-28T19:52:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57194, 186503ec-ecfd-435b-a19a-57632792fb62, 'Avec 3 bananes, 2 cuillères à soupe de sirop d''érable et seulement 160g de sucre roux, il était assez sucré. Je n''ai pas trouvé de farine fermentante alors j''ai mélangé un sachet de poudre à lever bio dans la farine. Je n''avais pas non plus de mini moules à cake mais j''ai tout mis dans un moule à cake normal et le gâteau a bien levé et les pépites étaient bien réparties. Merci beaucoup pour cette recette très appréciée ! ', '2012-12-30T09:56:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57194, af76a394-345c-4825-895b-7a8781a11382, 'Super recette ! Ces muffins sont délicieux et inratables ! ', '2012-10-13T01:20:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57194, c07e0708-dd1e-4b75-902c-104a1c68f07c, 'Un vrai délice! A tester!', '2007-11-19T10:16:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (318895, 8240f69a-a4e4-4eb1-9550-c0b3256ff200, 'Même avis que les autres, très bon mais beaucoup trop épais. J''ai rajouté 100 ml de lait de coco et un peu d''eau.', '2019-10-23T12:38:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (318895, 1974298c-61c3-49b0-8aa8-c67033a5f75f, 'Super ! Facile à faire et délicieux ! Rajouter un peu d''eau car trop épais sinon.', '2017-04-03T23:27:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (318895, 1a1c5852-96ad-41b7-bcdf-c58dbfa45efb, 'C''était très bon, mais j''ai dû ajouter un petit peu d''eau pour le liquéfier car c''était super épais !', '2016-05-05T11:45:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166821, dda6e8cb-8e7d-4a0f-9d8b-3b2265a5f9fa, 'POUR LES MODERATEURS : Sur l''appli Marmiton cette recette apparait sans quantités ! Sur l''ordinateur c''est mieux, sauf pour le beurre.', '2023-10-09T04:45:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166821, 5496eaac-e32d-4047-b313-29867ad7e7b6, 'Avec 100 g de sucre au lieu de 150 g et sans la cardamome, je les trouve excellents.  Je n''ajoute plus la noisette car il y a déjà assez de saveurs différentes (banane, chocolat, avoine).', '2012-09-24T19:38:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166821, 4f5da115-bc35-4613-8156-d580e11178fb, 'Très bon, j''aime beaucoup. C''est un peu moelleux et je trouve ça bien meilleur que les cookies secs', '2010-06-15T20:46:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166821, f71e798f-442c-407d-b8e6-e51c374636bf, 'Parfait !! Simple, bon... Génial !! J''ai mis 3 œufs au lieu de 2. Un seul cookie fait un bon goûter ;-)', '2010-05-15T18:28:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95194, 8bd5bd10-081f-4cb7-a06d-c3069651dc65, 'J''ai ajouté du cacao (1/2 pot), 1 cuillère à soupe de sucre et 2 cuillères à soupe de lait, délicieux !!!', '2012-05-02T22:11:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95194, 873894f1-ef25-49cb-abaf-1fdaf038e286, 'Recette simplissime et excellente !!', '2010-10-24T17:20:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95194, 65553fe0-1989-45a4-9be8-5d305b9577d2, 'Moi j''ai fait des petits gâteaux individuels, et j''ai mis un sachet de levure entier, et ils étaient complètement raplapla...', '2010-06-30T18:40:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95194, d0c3041c-7641-4f4b-84a3-2f4001aac51b, 'Et bien ce sera moi la première ! Ce gâteau est bon, bien fruité, hélas il est retombé en refroidissant et du coup il était un peu lourd, dommage. Je le referai en essayant la formule farine + levure ou même peut-être en ajoutant un blanc d''oeuf monté en neige. Le chocolat pour accompagner c''est pas mal, le coulis de fruits rouges c''est plus rafraîchissant ! À vous de voir...', '2010-04-07T21:29:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13994, ca3e4181-25e3-417a-9bd9-61b60202af07, 'Simple et bon, j''ai mis du sucre vanillé car pas de cannelle à disposition.', '2020-08-23T12:54:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13994, 40df0e95-8984-43f4-a237-6f806c18572a, 'C’est très simple mais très bon ! Je vous le recommande vivement !', '2016-06-22T15:35:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13994, 5b34b3b2-0db5-4683-af17-3e57291a9b57, 'J''adore cette recette chaude ! C''est excellent pour le goûter ', '2015-10-07T16:11:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13994, 8ec16726-bda0-4cf4-804b-8275ac64c8e9, 'Super rapide et delicieux, boisson parfaite pour le goûter! ', '2015-06-05T10:06:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13994, 730a8d9f-308e-4083-a092-14108858fbd6, 'A faire en 2 minutes !!!! Et c''est super bon, rafraîchissant ', '2011-07-12T22:17:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13994, d0452857-aa97-436e-8c43-410d1d277549, 'Ah j''aime beaucoup cette boisson que j''utilise en dessert. Cela a le moelleux du milkshake sans les calories de la glace. On obtient un lait bien crémeux et moussant. J''utilise au choix de la cannelle, vanille ou chocolat fondu. Une paille colorée dans le verre et miam !!! ', '2011-02-22T13:30:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13994, 8ece5ef3-e734-45a3-82f7-c1add5b4561e, 'C''est bon et c''est meilleur avec le sucre vanillé qu''avec la cannelle.', '2009-08-17T18:51:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13994, 672507b1-ceb8-40f6-8f2c-7c496c646616, 'Bonne recette, facile à faire et pas trop sucrée', '2009-03-24T21:59:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13994, 4f1b5934-5b2e-484b-9a64-3d884e729ec8, 'Pas mal! Boisson consistante au goût très doux. ', '2008-05-02T21:37:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13994, d039e28a-9f98-4490-af1f-903ec5580560, 'Excellente boisson, je mets un peu plus de banane pour que ce soit plus onctueux!!!', '2005-05-28T16:41:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13994, 2cc5425d-dc66-4e17-be39-c78d4e02ff6e, 'Je ne peux pas résister à cette délicieuse boisson... Pour une plus belle présentation, ajouter sur les parois du verre du chocolat liquide.', '2003-10-29T17:19:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23575, 9585c5a2-266a-457d-ad51-4b8f4beedd6e, 'C''est le gâteau le plus infect, que j''ai jamais goûté! La cuisson a pris presque 1 h 30, et le résultat était gras, pâteux et écoeurant. Je vous le déconseille formellement, à moins de revoir absolument toutes les proportions (de changer de recette, donc)!', '2005-10-02T18:18:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37527, ce01a0e3-2f38-41e3-9820-e5e094ae6539, 'C''est très simple à faire et franchement j''ai trouvé ça très bon. A refaire avec plaisir !', '2015-09-05T14:34:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37527, c05c99ec-e85e-4dc1-b66f-2a7ffae5ad0f, 'Recette faite hier soir, elle est originale, bonne et simple à réaliser. La banane se marie très bien avec le saumon et l’épinard. A refaire sans hésiter.', '2012-04-15T15:09:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37527, 2a66843b-e608-408c-b6ba-c89152d1f747, 'En effet, c''est absolument délicieux, extrêmement fin. J''ai testé la recette en ajoutant un peu de jus de citron et des câpres à la crème fraîche, c''est vraiment délicieux. Merci pour cette recette !', '2008-03-04T20:58:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37527, bedd62d5-6375-4fe3-aaac-8b4e424e725f, 'La banane avec le saumon donne un goût un peu bizarre. Sinon, le reste de la recette est bon.', '2006-01-14T20:57:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37527, 5408ce34-6cfa-4b55-91d8-e02cb92189e8, 'Plat fin, digne d''un grand restaurant.', '2005-11-13T20:55:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, 8fb5b1ca-ce46-4be0-a610-e348203ae3ce, 'Trop bon et hyper facile. Perso, j''ai ajouté un peu de rhum et je n''ai pas mis l''amidon de mais. A conseiller ! ', '2014-03-06T23:22:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, 238edaad-30f9-4a1b-8359-cbbdf4af7f41, 'Recette très sympathique. J''ai mis 4 bananes et le mélange est agréable (sans maïzena). Seul bémol, l''aspect n''est pas franchement très engageant mais c''est bon. Merci pour cette recette.', '2010-04-14T13:47:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, d54cef6d-bcc6-468a-90c4-9dcde6139a97, 'Trop bon ! On a goûté ça hier soir et on s''est régalé! A refaire de toute urgence ! Avec de la chantilly et une touche de crème de marrons et une pincée de beurre de cacahouètes, ça donne une invitation au voyage en Papouasie ! ', '2010-04-04T01:03:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, 92336a11-b3ac-4e1f-9815-87aaa7c40dfb, 'Un seul mot: miam! Merci pour la recette.', '2009-09-19T18:24:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, 3f2604eb-e68a-4c80-86ba-5ac130352392, 'Un succès. J''ai fait le double en quantité pour 6 personnes. Ca m''a fait 14 ramequins. Il m''est resté 4 ramequins comme certains ont pris 2 ramequins...(mais le repas suivant, tout était parti).', '2009-06-15T08:46:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, abe5b3ed-6e11-4c2f-83c7-5c3a28bac9ce, 'Très frais pour le dessert tout le monde a aimé. J''ai peut-être mis un peu trop de crème chantilly, c''était un peu lourd mais à refaire quand même. Merci pour cette recette :-)', '2008-11-11T16:43:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, 699fa810-da60-4679-b554-b0a2b6cf344c, 'Faite la veille pour le lendemain, avec 4 bananes pour 4 personnes et en sautant l''étape 5. Délicieuse! Un succès, surtout quand on pense au temps qu''il m''a fallu pour la faire... Juste pour avoir quelque chose à redire: il n''y en avait peut être pas assez, j''en aurai bien mangé une deuxieme! ', '2008-09-20T21:23:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, 8366f2af-5f58-4fff-9c16-3d9d05b1906a, 'Le mélange coco et banane est très frais! Par contre la texture est peut-être à améliorer...', '2008-06-08T12:06:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, e8083f3c-7a4e-43f7-b49f-c2e95cc9b38c, 'J''adore! Et mes invités aussi, sauf ceux qui n''aiment pas la noix de coco! Car cette dernière prédomine un peu quand même. Je recommencerai mais en augmentant un peu les quantités car c''était tout juste suffisant.', '2008-01-12T15:33:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, fd959898-6569-466d-8550-c7fc477c57ef, 'La crème est sucrée juste ce qu''il faut. Je l''ai servi sur une tranche d''ananas frais, c''était joli et bon. ', '2007-06-10T21:12:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, edb8e5ea-9605-4b5d-8ace-e4294c223104, 'Excellent, tout le monde a apprécié. Pas trop sucré, pas trop lourd, impeccable pour terminer un bon repas. Par contre j''ai rajouté de la cannelle et de la noix de coco râpée car cela me paraissait un peu fade. ', '2007-01-30T09:23:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, 4b4c946f-b81a-4525-a2cd-d80e06233c93, 'C''est tout simple et très bon. J''ai mis du citron vert. Je trouve que la maïzena donne plus de tenue à ce dessert. ', '2006-10-14T00:23:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, 95de30f9-49ac-41b9-b2e4-27ade67685a5, 'C''est bien quand il fait beau dehors et si on est de bonne humeur! C''est très bon!', '2005-01-31T19:05:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, de9a7bd3-0834-46f4-bbce-b4628d529044, 'Facile et très bon. Pour donner une petite note exotique à une fin de repas. Par contre, le résultat est variable et je ne sais trop pourquoi...', '2004-08-04T21:14:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, aee3f1b8-f6f5-4b83-a9bf-3e12f5080696, 'Bon. Idéal quand on n''a pas d''oeuf pour un dessert!', '2004-03-18T19:21:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, b0ead136-b2b8-4aec-8299-d9774524ebe5, 'Très bon!', '2004-01-11T12:00:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21603, 21af7e86-8480-476a-8b1d-5519c091b3ef, 'Recette très simple et savoureuse pour les amateurs de bananes. Augmenter largement le nombre de bananes car à moins d''avoir des bananes géantes 3 c''est un peu juste, misez plutôt sur 5/6.', '2003-04-02T11:19:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52729, 1b0ed595-b77c-416b-93c2-c0a122a61737, 'Très bon dessert, Plus longtemps on le laisse prendre au frigo, meilleur il est. Par contre je mets plutôt 100g de chocolat noir et 100g de beurre.', '2020-05-01T20:08:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52729, f045df58-3bdf-4df5-adcd-c679c73d8d83, 'J''ai réalisé la recette et j''ai accompagné la crème de glace à la vanille et chocolat c''était un régal pour toute la famille ! ', '2017-05-29T00:59:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52729, 5e7453ee-2bf9-450c-a9a6-448ac97fabc5, 'Excellent ! Tout simple et tellement bon, à refaire sans hésitation. Un grand merci !', '2011-09-15T12:05:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52729, b672e328-5878-4f4d-bac0-6f45f491d461, 'Je suis convaincu que cette recette plaira à beaucoup, notamment les plus jeunes. Un bravo pour l''originalité et la simplicité de la recette. En fait, j''ai déjà testé moult recettes à base de banane-chocolat et à chaque fois même observation même constat : c''est vite écoeurant. Pourtant j''aime la banane, pourtant j''aime le chocolat, mais les deux, le tout saupoudré de noix de coco... Intéressant toutefois pour le côté "fraîcheur" que permet le passage au frigo. Bravo donc pour ces deux points mais pas emballé toutefois.', '2006-12-09T22:12:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228236, d37e54ed-5eeb-464d-b7ad-21816bb19515, 'Délicieux! Le mélange pralin amande amandin est vraiment gourmand et apporte une originalité au crumble classique. Pour les fruits j''ai mis 500 g de fraises pour avoir plus d''acidité.', '2016-04-16T23:39:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253880, 776fb33c-b896-463a-a5cf-e6cbe2b9e2fa, 'Très bonne, très simple. Pour ma part, quand la tarte était cuite, j''ai ajouté par dessus du caramel beurre salée fait maison. Aussi je n''ai pas mis de farine (je n''en avais plus) mais je l''ai quand même apprécié.', '2019-09-30T13:26:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253880, 943eda22-be0c-48f9-9746-2164c199a198, 'Très bon ! Simple et rapide à faire. La prochaine fois j''ajouterai peut-être des pépites de chocolat. Merci pour le partage !!', '2019-02-14T10:34:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253880, e1daac0c-804a-4255-aa98-2c350061e77a, 'Sans plus même en y ajoutant des pépites de chocolat !', '2015-11-12T00:16:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37853, 80c141e7-fce3-43c7-ad6c-23ac89764e46, 'Au top mais ce serais encore mieux si il y avait des proposition autre que  les fruits rouges', '2017-05-23T22:52:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37853, d7593c23-4cc5-4a44-b8f5-944ef88cd6f3, 'Simple et efficace ! J''ai mis du nutella et c''était parfait ! Juste un petit problème avec le miel qui se colle au paroi du robot et qui a du mal à se mélanger avec le reste. Sinon super simple !', '2016-12-13T19:23:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37853, 697fe3c7-6f65-46f8-8b89-606ff4e1ccbe, 'Les proportions sont trop justes pour 2 personnes ! Je n''ai pas aimé le miel (peut être est-ce trop une cuillère à soupe) et je pense qu''il faut absolument mettre de la glace pilée car la préparation n''est pas du tout fraîche avec la seule cuillère à soupe de glace vanille... Désolée pour la note.', '2010-10-25T21:06:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37853, a2f84fe8-e4dd-4eba-a68a-c8b125d1fec6, 'Facile, bon et pas compliqué du tout, merci pour la recette.', '2010-01-27T19:37:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37853, 3d252429-1dae-4247-881e-f10cb2e44cf5, 'Très bonne recette facile à mettre en oeuvre. Bien vu pour la petite touche de miel qui change tout. J''ai moi même essayé cette recette avec des yaourts aromatisés (fraise et framboise). Très bon résultat.', '2009-07-24T15:10:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72563, cd00fc4d-909f-4cd3-83cb-56e67a6f9efc, 'Très bon avec de la crème glacée et de la Chantilly.', '2015-01-20T13:37:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72563, e773981d-7c2b-4ff1-a799-a340e90e4803, 'C''est une recette simple et très bonne. Je l''ai fais avec des petites bananes venant de mayotte. A refaire. ', '2014-03-16T15:02:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72563, 5a1e39a2-5be4-46fd-a7eb-165ae30d29ec, 'Très écœurant. Les bananes se transforment en "bouillie". Très peu subtil et lourd sur l''estomac. Je déconseille', '2011-11-13T20:28:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (225403, 7f2e10b7-a4c0-4a6b-bff8-ff8097e4d82e, 'Tout simplement excellent !! Merci !!!!', '2013-07-26T22:07:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (225403, 242f2f4d-20e7-4a0b-8e82-34a797e637fe, 'Un délice facile à faire, léger et gourmand à la fois, à refaire impérativement !!! Je ne comprends pas pourquoi il n''y a pas plus de commentaires...', '2012-10-25T23:46:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (225403, 4c0f12ee-a60a-4c9d-9949-cb4511ff21b7, 'Vraiment très bon, encore meilleur avec des pêches fraiches bien mûres coupées en morceaux (profitons des fruits de saison !). J''ai mis du chocolat dessert au caramel, ce qui relève bien le goût des spéculoos.', '2012-08-25T18:51:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, da3426e6-7273-430e-9713-7bd5a2b20fae, 'J''ai mis 2 bananes, un jus de citron ? un yaourt brassé nature, 2 cuillères de miel ? d''oranger et 30ml de lait. Une vraie tuerie.', '2019-09-27T22:05:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 4dcbc0c4-b586-4ab9-a79d-29f76dc5973b, 'Bonne collation, j''ai mis 2 cuillère de miel et il y a trop de citron, un peu moins aurait été meilleur. ', '2022-05-20T16:57:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, a26cb9f3-62b2-4254-beea-e4e5931b3843, 'Délicieux 😌', '2022-03-04T15:18:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 52289099-b5eb-484c-8d08-6422b5d06eff, 'Très bon et super facile. C''était la première fois que je goûtais un smoothie, le miel ajoute la gourmandise et évite de sentir le sucre qui croque sous la dent. J''ai mis le jus d''un citron entier (ne se conserve pas plus de 24h après la banane rend le smoothie un peut gluant je trouve.)', '2016-06-15T14:54:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 94f67615-45cb-4c5e-a0a9-0fc8bc3b5418, 'Très bon. Je n''ai pas mis de citron et j''ai ajouté une cuillère à café de cannelle. J''ai mis à congeler la banane coupée en rondelles avant pour plus d''onctuosité et de fraîcheur.', '2015-04-15T07:03:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, c978d396-7741-428c-ad2f-1e63b36803bd, 'Délicieux
', '2022-01-26T15:21:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, fc031879-e200-4825-bcfc-99ef44e35cf4, 'Beaucoup trop liquide. On a fini par faire des milkshakes au filling.', '2021-12-29T13:58:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 0921cd94-4d9d-409f-a8cc-3e56e15b4747, 'Vraiment sympathique !', '2021-11-16T17:34:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, c7e0c6e9-b2eb-48ad-8f9b-50f33cd44e1b, 'J’adore le smoothie, je le trouve un peu trop liquide mais très très bon !', '2021-10-27T14:33:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, cf089e25-14a7-4b58-b41f-2ea38956cc85, 'Bon smoothie !', '2021-08-03T10:47:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, fee2cf0e-532f-4017-928c-28f403c4e0f8, 'Très doux. Ce smoothie n‘est pas du tout écœurant ! ', '2021-07-20T16:06:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, f588a022-39cf-49ed-be13-c139e111560a, 'Facile à faire et rapide, pratique pour faire une collation 👍🏼', '2021-06-15T12:09:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, b6b9aec6-05b7-400f-8f81-8b759ee4bad5, 'Fais sans citron. 
La prochaine fois je rajouterai une cac de miel en plus. 
Mais smoothie plutôt bon ! ', '2021-05-23T09:18:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 843ff27f-3a18-4613-986f-bfd5a0fa8e4b, 'Excellent ! ', '2021-05-22T20:00:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 791d581b-c767-40ad-bb11-698d9f149285, 'Très bien ! Le miel rajoute un plus !', '2021-03-01T17:56:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, c2d05e81-ad39-49fa-a85b-d5135dcfaf6e, 'Sympa', '2020-12-15T10:19:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 9d909bce-8002-45cc-93f3-0a55e65cecd4, 'J''ai mis deux banane pour que le smoothie soit plus épais. Très bonne recette', '2020-12-02T10:08:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, a8f4e6a7-9466-4b35-a9a2-7605fead1741, 'Super recette! Je vous la conseille ', '2020-04-12T10:16:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, eb12b14b-731b-4ced-9e63-fcecd81ebeec, 'J''y ai ajouté un peu de cannelle mais sinon c''est une tuerie, je le recommande vivement !', '2020-04-02T17:14:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 64fe0bd5-0031-40d9-8303-bd6784e161a5, 'Merci', '2020-03-22T10:45:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, bb46052a-f169-4ef4-bd61-e04cf7cab996, 'Facile et hyper bon ! Je recommande :) ', '2019-07-31T08:38:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 83736571-a655-439c-899f-0a227a28df16, 'Testé, j''ai suivi la recette et c''est pas mal. J''en ferai de temps en temps pour le petit déjeuner.', '2019-02-14T20:18:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, aee5512c-3cb8-4116-baaf-3ac2c8062467, 'Bien pour 3-4 verres.', '2019-01-08T14:43:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, de2533b5-3841-486c-9031-ca88dcb87c80, 'Mon mari et moi nous sommes régalés merci beaucoup ! Je n''ai pas osé mettre le citron par contre. La prochaine fois ! Merci.', '2019-01-07T19:27:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 608b8b2b-20fd-454b-8dbb-b498b9607e84, 'Simple et délicieux.', '2018-11-02T20:36:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 4208004e-3b18-4779-a890-a0699e54ec76, 'Délicieux pour ma part j''ai ajouté quelques amandes effilées, des graines de sésame et des framboises !', '2018-08-31T19:32:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 6b5216e5-7b73-4750-a0bf-a2757825b277, 'J''ai bien aimé pour le petit-dej'' !
C''est facile, simple et efficace :)
J''ai juste mis des flocons d''avoine à la place du citron !', '2017-08-20T12:13:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 447de20f-5196-453f-a75a-3942e1f81cca, 'Comme je n''avais plus de miel, j''ai remplacé par une cuillère à café de canelle, sans citron de peur que ce soit trop acide... délicieux!', '2017-08-18T15:11:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 26651f2f-9c7c-4420-ba59-86e66f905672, 'Sain et délicieux !', '2017-02-05T12:10:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 45cc0359-76c7-4512-ae76-e4285fb48617, 'On a aimé moi et mon mari ; mon mari a donné 5/5. Mais on l''a préféré avec plus de banane. La prochaine fois je mettrai une banane et demi. Merci pour la recette', '2016-10-16T03:27:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 3e1e3ae1-056a-4886-9e7b-571112a9ba62, 'Très simple à faire, mais par contre je m''attendais à mieux au niveau du goût.', '2016-05-26T09:24:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, c3be3032-1bef-44d6-805f-5b8a31347f17, 'J''ai remplacé le lait par 2 yaourts et j''ai mis le jus d''un citron entier. J''ai ajouté un peu de praline en poudre saupoudré dessus pour la touche finale. Super bon et vraiment très rapide à faire! Je referai c''est sur !', '2016-03-10T18:31:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 45921e86-a2fc-46f9-aaf7-7fbd9298159d, 'Miam ! J''avais préalablement congelé une banane mûre, je n''ai pas mis de citron mais 2 glaçons car je trouvais le smoothie trop sucré. Ensuite miam ! Mousseux, onctueux, une belle couleur, très très bon ! Mille mercis et bonne continuation !', '2015-06-24T15:26:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 8bc88c0e-ba9d-448c-bd4b-fa1e852b4f8b, 'Super Idée, c''était délicieux. Par contre j''avais pas de Citron, alors j''ai mis des amandes. Bravo pour la recette !', '2015-05-28T15:53:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 2e857423-feeb-4f42-b117-876bee8671bc, 'Excellent goût, très apprécié par mon ado de fille ! Le tout préparé au Soup''and Co.', '2014-05-01T12:38:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, f62cae4d-2498-4d34-bb42-b63a48c983d0, 'J''ai essayé ce smoothie en remplaçant le lait par du lait de coco , une tasse environ , pour utiliser ce qui me restait d''une autre recette. C''est très bon .', '2014-04-26T18:04:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 1ebf8a97-70c2-4ab7-b45f-40cca3dd79bb, 'Facile à faire, plutôt bon mais pas dingue. Merci !', '2014-03-06T15:35:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, ee342bc5-3035-4183-a0e4-f4937e31b828, 'Excellent ! Je l''ai fait avec un yaourt au lieu du lait et la petite touche en plus : rajouter un peu de lait de coco ! ', '2014-01-18T11:46:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 6a6d869a-636d-4a15-b1cd-e0138b498948, 'Très facile et permet de faire le plein de vitamines :).', '2013-11-15T20:35:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, dc390b1a-3bca-4e04-9ec6-3c90976d5e54, 'Recettes en général  simples et délicieuses. Bravo Marmiton ', '2013-08-28T15:29:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, dfec4ae4-fa4d-4215-bb68-fd4c05c9e29a, 'C''est rapide et simple à faire, mais je suis déçu au niveau du goût...', '2013-03-02T23:57:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 43ebc564-e08e-4f8e-ab55-5f23c756cf87, 'Bonne recette, très simple et rapide. Pour une version plus cocktail, j''ai juste ajouté un trait de rhum.', '2012-09-19T12:28:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, a0be4af8-93ed-4a43-9ee1-79fe18a097b5, 'Facile et rapide à faire. Par contre au goût, sans être mauvais ce n''est pas exceptionnel.', '2012-08-01T21:24:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 51c0f148-13d2-47e7-90e4-8adee447dffd, 'Très bon ! Surtout si c''est très frais !', '2012-05-17T12:16:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 46e0c4a7-67d5-4fd9-845b-26fd5e68bb82, 'super bon quand c''est servi bien frais', '2012-04-27T23:00:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, a1fe8ef9-b98a-42e8-bae9-5bfb50761253, 'Les enfants ont aimé mais ajouté une cuillère à café de sucre.', '2012-01-08T14:25:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 40e032df-6370-4660-930d-bceefe869119, 'Super idée ! Je l''ai fait sans citron et c''était délicieux. Bon moyen de faire manger des fruits et du lait aux enfants récalcitrants !!', '2011-08-27T22:46:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, dba248af-5f6b-44e2-9800-a6f4b2b0c194, 'Je viens de le faire et je n''ai pas trouvé ça terrible et pourtant j''adore les bananes et le lait étant donné que j''en mange/bois tous les jours ..', '2011-08-12T14:36:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 3b3b82c7-049b-4ff8-9da9-b4df208f1a58, 'C''est trop bon ! A boire le soir : ça aide à dormir ! ', '2011-05-29T00:04:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 986ae66d-54ce-458e-8064-88c032819d30, 'J''ai mis 2 bananes (elles étaient petites) et c''était vraiment délicieux. Très facile à préparer !', '2011-02-27T19:52:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, ca85fa22-765e-40c3-9b04-4c9e51b267e2, 'Super recette, bien entendu il faut aimer la banane ... ', '2010-07-06T16:52:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 30c7e834-8351-46d5-bbac-a9aca32e1633, 'Délicieux par temps chaud en milieu d''après-midi ! N''ayant pas de miel, je l''ai remplacé par 3 cuillères de sucre. je pense ne pas avoir assez mixé, il restait des morceaux de banane...', '2010-06-05T16:59:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, bfb33091-123f-4a53-ad52-9520596561e8, 'Recette assez bon par contre à boire tout de suite car sinon la couleur vire au marron avec la banane... Je l''ai préparer 10 min avant de le boire la couleur ne donne pas envie... Mais sinon sa change ', '2010-03-08T11:25:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 67f56c4a-3024-4418-8bca-7a8e050434a1, 'Super recette. Par contre comme ça a été dit dans un autre commentaire j''ai doublé la quantité de miel.', '2010-02-28T19:10:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 5f7b9e99-d3a6-412b-a04e-1e41b20f3576, 'Déçue... je m''attends à mieux moi qui adore la banane...  Peut-être trop de citron ?', '2010-02-26T16:30:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, f54610e1-3afd-4ab3-91cd-edb162f80aca, 'Délicieux !!! Merci!', '2009-12-28T17:14:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 1be18e14-0ae0-416d-86e0-c1d62d8566aa, 'Délicieux !!! Rien d''autre à dire, à part bon appétit !!!', '2009-11-13T16:41:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 5c35259f-a100-4287-97e9-44794355e836, '1 er smoothie et c''est une réussite ! Mon fils s''est régalé ! J''ai ajouté un peu de sucre vanillé car on sentait un peu trop le citron à mon goût (j''ai dû en mettre un peu trop !) et j''ai mis également un yaourt nature avec du lait en complément ! Merci beaucoup pour ce moment de douceur !!', '2009-09-13T22:37:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, eed8d3df-2323-4416-a84d-254bd043bd9a, 'Smoothie très doux, j''ai apprécié ! Perso, j''ai fait ça avec des petits suisses et un peu plus de miel également. Je ne suis pas déçue.', '2009-08-04T17:49:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48199, 20078958-4861-4d47-bdf0-51a08d010206, 'J''ai remplacé le lait par un yaourt nature, superbe texture onctueuse. A la 1ère cuillère, un régal !!!!', '2009-03-22T13:08:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73626, 3f57713d-9699-4dab-a853-704b3c2b26f3, 'Ce GÂTEAU est très bon. Mais ce n''est pas ce à quoi s''attendait, on pensait avoir des barres type barres chocolatés ou quelques choses du genre. Mais néanmoins ce gâteau est bon.  Le glaçage est un peu trop sucré à mon gout, à l''exception de ce détail, c''est très bon :)  ', '2015-04-21T18:38:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73626, b4730f6b-ff27-4dc1-8656-5d16919da2fd, 'Bonne recette. Je n''avais pas de farine à levure incorporée. J''ai mis un sachet de levure chimique. Du coup le gâteau est assez aéré. Par contre ça fait beaucoup en terme de quantité. A réserver aux gourmands !', '2010-10-19T07:13:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30536, d28b50c3-0abd-406b-bc81-b83c1ef47335, 'Le goût de la banane est très très prononcé. Un peu écoeurant.', '2007-02-13T13:12:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29260, fc150233-9215-442e-b44e-cefc47668e42, 'Excellent !', '2023-12-27T23:47:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29260, f33fdffe-f92e-435e-b0f3-7c3cdb50b399, 'Alors là chapeau j''ai fait cette tarte cette après  midi trop bon mon amis qui n''aime pas trop tarte à la banane il s''est régalé. Moi j''ai fait moitié de tous et le sucre un peu moins on s''est régalés.  5/5', '2015-02-03T18:41:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29260, 3d943068-5260-4c0e-b10d-9709dc671d0d, 'Très bonne tarte et pas écœurante !', '2013-04-21T12:24:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29260, 092ba717-5a83-43b9-af29-f2c10a75acfe, 'Très bon et très facile, pratique pour faire participer les enfants. Juste la cuisson à surveiller.', '2011-09-11T22:42:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29260, f6eb7f6b-9860-4f7a-b0d0-1ba2f1d57c54, 'Personnellement, j''ai remplacé l''amande en poudre par de l''amande amère et j''ai mis tous les ingrédients dans le blender. Excellent !', '2007-12-07T01:22:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29260, 996bbcb8-80ad-44a9-9076-cd075b57f145, 'C''est bon, mais pas transcendant non plus... La texture est un peu étrange, mais on s''y fait! (pour moi, il y a trop d''oeufs). Mon chéri a beaucoup aimé, alors... Attention quand même de ne pas en prendre une trop grosse part, c''est riche!', '2005-03-07T14:43:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, e79bccf2-1a08-429f-879d-e837c7f8d72d, 'Un eu trop de sucre, je diminue le sucre à 150g. Au top avec les enfants, le dessus ne reste pas longtemps.', '2022-01-22T16:03:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, 2f9a1bd5-2306-4898-9ac7-be937e7bb02f, 'Très bien en divisant le sucre par 2. J''ai remplacé le tapioca par de la semoule fine... Miam.', '2020-03-31T15:58:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, 662f3db3-0805-4d01-a615-a9298e38989e, 'C''est excellentissime! Les proportions sont par contre gigantesques ! J''ai testé deux fois cette recette: une fois en divisant les ingrédients par deux on obtient un dessert très bon et bien sucré mais assez compact. La deuxieme fois, j''ai mis 3 bananes, le tapioca (60g dosé dans mon verre doseur au dosage fécule), 100 g de sucre, 2 boîtes de lait de coco de 400 ml, quelques gouttes d''arome vanille. Et le dessert était beaucoup moins épais et moins sucré, j''ai préféré mais après ça dépend des goûts. Je le mange chaud c''est aussi très bon! J''ajoute qu''avec ces doses ( les dernieres) j''ai pu faire 6 ramequins (type petits bols chinois).', '2006-10-25T01:36:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, c198c30f-80c2-43c6-a6ff-1cbcd770bc94, 'D''accord avec les commentaires précédents, trop peu de lait de coco pour le tapioca indiqué (j''ai mis 3 boites de 200ml) et beaucoup beaucoup trop de sucre. ', '2019-01-31T09:34:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, edbf6935-044d-4b6c-adc5-0645b5acae1c, 'Les quantitės ne sont pas appropriées : très épais même avec moitié moins de perles de tapioca ! Très  bon mais un peu écoeurant.', '2018-12-29T07:16:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, 312d6bd1-bbf3-4ad5-8e91-01427342def8, 'A fait l''unanimité, n''en est pas resté une goutte ! réalisé avec des bonnes mangues du Burkina Faso ', '2015-12-16T23:58:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, 6702fe91-1898-4446-946e-22e307c5c716, 'J''adore cette recette ! et elle est vraiment facile ! comme j''avais 2 bananes bien mûres à utiliser, j''ai utilisé les quantités suivantes : 1 boîte de lait de coco et 4 à 5 cuillères à soupe de perles de tapioca imbibées dans l''eau.', '2015-11-21T23:13:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, 4b778b00-3d4d-4f7c-8f9a-59c8143381ad, 'Recette adopté par toute la famille. J''ai un peu modifié les proportions. Trop de tapioca. ', '2012-12-05T11:08:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, 6cee94ff-72e9-4bb9-9713-e54351a5b4fe, 'Je trouve que la recette est très bonne mais que les proportions indiquées ne sont pas appropriées... Il y a bien trop de tapioca et pas assez de lait par rapport au nombre de bananes. Mais sinon très bon et plait même a ceux qui n''aiment pas la coco !', '2011-07-17T15:26:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, 37bf6f9d-9b9f-466f-9efb-45f716deade5, 'C''était super bon !! Mes invités se sont régalés et nous aussi. A recommander et à refaire. Les doses peuvent être divisées par deux : j''en ai eu pour 3 jours à finir ce dessert !!', '2010-12-22T09:08:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, 181d2251-6d1c-4484-b6a6-7f6c4490abab, 'J''adore ! Lais moi aussi je mettrai moins de sucre la prochaine fois. Ne pas faire l''impasse sur les cacahuètes, à mon avis !', '2010-06-16T15:58:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, 103f2e0d-6a33-48fd-9be6-b2e103c35267, 'J''ai adoré! C''est très surprenant, un peu écoeurant, mais c''est un dessert qui invite au cocooning et à la détente. Par contre, j''ai divisé les proportions par 2 et la prochaine fois, je mettrai moins de sucre!', '2009-03-28T14:00:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, 08f7dd8f-e709-456f-a093-356cbeb4b3d2, 'Pour ce qui est de la quantité de lait de coco (qui est la principale difficulté de la recette, et qui est la seule chose qui ne soit pas indiquée... :-/): 3 petites boîtes de 125 cl ne suffisent pas. Il faut à mon avis au moins 1L de lait de coco pour la quantité de tapioca indiquée.', '2008-05-25T21:18:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, 1c074d3b-52a5-4c8f-b4df-a38eaa7cd651, 'A tester avec des fruits de palmier (en vente chez Tang Frères ou épicerie orientale). Je suis devenue "dépendante" de ce dessert ;-)', '2007-05-23T15:32:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, 64f7ed70-d1ae-41d7-b187-fd5397688c5d, 'C''est délicieux! J''ai oublié la vanille mais, même sans, c''était super bon. C''est très copieux par contre, j''aurais carrément pu diviser les proportions par 2, il y en aurait eu assez!', '2006-06-24T04:38:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, d446ea51-094e-4e9b-ae23-d598d28e1e69, 'Très bon et très original...commme au resto! Mais les proportions sont pour des ogres. Et ça aurait été intéressant de savoir combien de lait de coco il fallait réellement (en gr ou ml)', '2005-10-30T13:51:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, a546f809-4eeb-4b29-a192-c6b14c0d215d, 'Parfaite recette, et j''en ai testé plusieurs avant de retrouver le goût semblable de mon resto favori, chez nous ce dessert est consommé bien froid, j''ai eu peur que le tapioca colle dans si peu de liquide mais non !  dès qu''on ajoute bananes + sucres cela se fluidifie encore plus, pour rester au final onctueux et ludique grâce aux petites perles ! un délice en été !!', '2005-07-16T23:55:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, e9f0c164-18a1-4e0c-bc9d-dd70fda31d15, 'Excellent, comme au resto! J''ai dilué le lait de coco dans du lait et de l''eau pour que ce soit plus léger. On adore très frais ! Pour répondre à la 1ère note, non, ça ne doit pas ressembler à de la crème et il faut utiliser des PERLES de tapioca (pas semoule).', '2005-04-25T17:46:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, a34e2fd5-34fe-4f6c-9e00-e4d6af147e30, 'Idée particulièrement originale. Facile et rapide, le goût est un peu inhabituel au début, mais on s''y fait très vite et on en redemande. J''y ai rajouté un peu de rhum lors de la cuisson.', '2005-02-22T13:16:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12212, 649d5966-f4fa-4f05-9ff5-082cb999a161, 'Vraiment pas présentable. Les proportions sont mauvaises, impossible de faire cuire autant de tapioca dans si peu de liquide et surtout ne pas faire tremper le tapioca avant. Ce dessert d''origine vietnamienne doit avoir normalement la consistance d''une crème anglaise...', '2003-09-09T22:55:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81445, 294be47e-efe6-4350-9950-1783e4f02929, 'C''est un peu écœurant avec la banane , le chocolat et le lait...', '2014-08-04T16:56:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81445, 086dff88-66fb-48b8-b6fe-52b252412419, 'Mon fils a adoré, moi sans plus, je trouve que c''est vite écœurant... ', '2009-10-03T18:51:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, cb90721f-a6f8-4622-a375-d1eb0866a942, 'Super bon mais trop de sucre à mon goût.', '2023-03-19T09:01:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, acd25c39-e465-48ae-99c2-9bbdcf35fc25, '1er cake végétalien et c''est une tuerie. Je mettrais juste moins de sucre la prochaine fois, mais c''est une question de goût personnel. Tout le monde a adoré ! À faire sans modération !', '2022-04-09T20:20:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, ec85d8fb-56bf-443d-ad0c-c7cf600d0104, 'Super recette faite avec de la farine de sarrasin et de châtaigne, et seulement 80g de sucre.
 ', '2021-11-12T12:52:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, f622cdf9-aee9-4a81-ae23-b0fc0f2c484c, 'Excellent et très moelleux. Deux cuillères de sirop d''érable à la place du sucre, farine de coco, huile de coco et bicarbonate de soude', '2021-10-28T17:48:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, 42644783-bb71-4f1a-8f37-555dbfdae5f2, 'Très bon malheureusement après la cuisson mon cake s''est effondré sur lui-même pour finir cireux maos cela ne nous a pas empêché de le finir !', '2020-05-13T20:21:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, 41b9b499-8135-4e67-aebd-38c725fe1d4e, 'Gateaux délicieux, adoré par toute ma petite famille! Je met juste moins de sucre de canne (80g) et moins d''huile aussi (50g) je le fais aussi avec des pommes caramélisées au sucre vanillé, un vrai regal. Merci pour cette délicieuse recette que je me lasse pas de faire et refaire.', '2020-04-20T13:05:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, 5a14dd50-a94e-460e-8c9a-d78743799930, 'Pas mal du tout ! Je l''ai un peu modifié en y mettant du sucre de canne bio non raffiné, ainsi que des noix de pécan. Le cake est super moelleux et très parfumé. Par contre, je le trouve un peu trop sucré, 80-100g auraient été suffisant je pense.', '2020-01-10T17:39:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, cdead358-c904-49eb-8436-43304cc6d140, 'Recette excellente en supprimant le sucre contre 2 cuillères à café de sirop d''érable, j''ai remplacé la farine par de la farine de sarrasin un vrai délice, moelleux, fondant,... Sans oeufs, sans gluten, sans sucre.', '2019-11-15T19:17:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, 9b53fdfd-b06c-416d-b339-c3a266bc7620, 'Je ne m’attendais pas à ce délicieux résultat ! Première fois que je réussis un dessert végan. Merci beaucoup. :)', '2019-11-04T08:29:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, 742a2fa0-356e-4cc2-9a08-438757094029, 'Excellent ! J''ai rajouté un peu de noix de coco et des pépites de chocolat noir.', '2019-07-30T06:28:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, a529a869-5f66-4766-b369-f3c7b18c1632, 'Très bon, beaucoup de saveur. J''ai mis un peu moins de sucre, et c''est juste assez.', '2018-12-19T19:43:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, ad8b9d78-f66c-4069-a637-03e228e16c59, 'Très très bonne recette. J''ai testé plusieurs recette de cake vegan et c''est le premier que je trouve bon. J''ai juste mis un peu moins de sucre.', '2018-11-26T22:16:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, daf2a52c-ecf2-4fe4-92f0-372b3cf9a244, 'Très bon même s''il y a un peu trop de sucre à mon coup. Je garde cette recette en stock et je la referais volontiers mais avec moins de sucre je pense ', '2017-06-04T14:40:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, 56db3bb0-48ab-49fd-9a77-2489b9a40dff, 'Un délice ! ', '2017-01-23T23:30:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, 98667e6e-8b0c-4b05-9b1c-910e55fcb56e, 'J''ai fait des mini (dans des caissettes type cup-cakes) c''était top...même avec seulement 3 bananes, de l''huile de coco (à la place de l''huile de tournesol) et du sucre blanc.', '2016-05-28T20:48:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, fa872785-2bfd-4fae-815e-bbee122ab807, 'Très bon et très facile', '2016-01-04T20:48:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220495, 76fd50ae-06ef-4b58-b1f5-7ec925e7b72d, 'Succulent, rencontre un grand succès à chaque fois. J''ajoute des pépites de chocolat noir.', '2015-06-16T16:22:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81835, ba476cb9-2949-4277-b9ed-576e7f9cc4da, 'C EST BON', '2020-10-21T20:23:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81835, 74077efc-6aeb-436a-ae29-fb95c9770c59, 'Très bon ! ', '2020-02-24T02:06:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81835, 92598607-4694-4a07-9390-a0f69acd4280, 'Impeccable par contre les feuilles de brick avait un peu de mal à rester collées à refaire et s''amuser à mettre d''autre fruits.', '2018-12-09T02:12:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81835, ecbcb321-564f-4aa8-8326-9d7ed19e6ef8, 'Un peu pâteux, j''ai dû rater un truc ...', '2016-03-01T21:42:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81835, e43ffe34-1311-4267-a6a3-c2c56cacb5b1, 'C''est succulent ! Je vais en faire très souvent !', '2015-12-22T17:03:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81835, 09eed410-e1f2-437a-8b22-540a3e3f25ef, 'Super bon mais la présentation était pas top.', '2015-10-24T18:13:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81835, f95dcbad-3dd3-4fea-81da-83829410be43, 'Un pur bonheur ! Facile, rapide et... DÉLICIEUX !', '2015-01-28T19:30:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81835, 9cf8f672-48b1-44ef-9e02-f22d6080df48, 'C''était délicieux. Je la referai sans hésiter, cela a plut à tout le monde !! Testez-la !!', '2014-11-23T18:20:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81835, c640dd5a-539b-47b9-9b14-dbfd06263b45, 'Déçue par le goût rendu par la banane. La prochaine fois je remplacerai par autre chose.', '2012-12-06T23:23:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81835, 0d14f978-3b00-4b9e-b61a-a243a9f8ce36, 'Très bon, les nems ont plu, hyper faciles et rapides à faire, il faut juste avoir le coup de main pour le pliage afin d''avoir de beaux nems ', '2012-04-29T14:00:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81835, ae3cc71c-d13b-4eb0-8dfd-f4edabc000b8, 'Super bon. Le miel fait toute la différence, servi avec une boule de glace à la vanille et quelques rondelles de banane.', '2009-11-07T04:34:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81835, 8d16c5c2-cd7b-45a5-a51a-4869fce6b73d, 'Quel régal ! A faire et à refaire, perso pour moi sans ajout de beurre c''est toujours aussi bon!', '2009-09-26T16:48:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81835, 789f7824-4b1e-435f-bab8-340444cc9139, 'Pour ma part je ne fais pas de la même façon. Je mets de la cassonade à la place du miel et je cuis les nems dans un wok avec de l''huile... Pour accompagner, mettre dans une casserole  20 cl de crème liquide et 60 g de chocolat noir. Tout le monde a aimé mais ce n''est pas forcement très léger.', '2008-10-06T18:54:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81835, 5200174e-291d-4a28-bec6-9c7daab51a4d, 'Recette délicieuse! Je n''ai pas mis de beurre fondu mais c''était très fondant aussi. A essayer avec pommes-chocolat ou poires-chocolat ...', '2008-10-05T13:01:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (89362, 41168235-216c-491f-9924-89a4b467a3c8, 'Tout le monde a apprécié, il m''a juste fallu allonger la cuisson de 10 min à 180°C (four électrique )et 5 min four éteint pour obtenir un résultat impeccable, bien cuit, bien doré. Merci ', '2011-01-07T18:50:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (89362, cd2fd99d-3f30-4e60-b605-480dab938c2e, 'J''ai fait la tarte sans coulis de framboise. Mais j''ai rajouté à l''appareil des noisettes émiettées !! Un régal ce mélange fondant des fruits et du croquant des noisettes !! ', '2010-07-23T00:46:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (89362, 1498239f-9245-48f8-a2eb-b37a5e09bd43, 'Bonne tarte je la referais c''est sûr.', '2010-02-27T18:49:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (89362, 1b096c98-a39e-4d51-988b-7b2cf8096bff, 'Simple, et rapide! Bonne petite tarte, sympa à faire quand il nous reste quelques fruits plutôt murs...  J''ai juste rajouté le sucre vanillé à la fin, avant d''enfourner. En 30 minutes, effectivement, c''était prêt! ', '2010-02-09T04:01:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (89362, 4fd2ac77-907c-462a-a62a-6ef9b7a25449, 'Une idée bien réfléchi mais malheureusement le kiwi perd toute sa saveur cuit . Je vous propose de le rajouté une fois la tarte cuite.', '2010-01-31T21:47:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67969, b760bd5c-b7fa-4897-9793-faf37f08784d, 'Adapté en Fraisofee, vraiment excellent !!!
On m''m''en redemande régulièrement depuis le retour des fraises :)  ', '2018-04-08T08:20:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67969, ae3bc884-c02a-46c6-bfc2-44b6d6e527c4, 'Un banoffee quoi ! Bon goût. Mais photo pas très attirante. Pas de quantité. Aussi rapide et plus joli dans une verrine.', '2017-09-02T16:23:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67969, 686bce82-cec2-471e-8146-c14b3f9c6d09, 'Excellente recette. Je l''ai faite plusieurs fois et tout le monde se régale.', '2014-02-02T09:48:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67969, a148eb0e-e463-4cba-a94c-fbdc2f83f014, 'J''ai fait cette recette que j''ai adapté avec des biscuits digestives. Quelques précisions manquent ex: quantité de beurre, comment faire la confiture de lait. Cela n''empêche pas que c''est très facile à faire et extrêmement bon. Pour la confiture de lait : vous avez plusieurs méthodes sur le net pour l''option casserole il faut être patient.', '2013-10-20T12:07:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67969, c6f0cfba-1889-4245-8f4b-51827b266c67, 'Facile à faire et très bon mais vraiment bourratif, donc prévoyez un repas très léger avant !', '2008-04-01T10:09:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 76c1733b-2319-4ed1-a7fd-d99d0c522595, 'Pâte  trop liquide, ça  donne un crumble hyper gras de banane.', '2023-03-25T19:03:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 71a41d8b-4984-4e57-8105-f5dae4b52075, 'Très bonne recette, tout le monde a apprécié.', '2013-11-02T17:38:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, c9dbcf37-a56e-4e27-b744-4c9ce8c879a8, 'Très rapide, très bon.', '2022-09-28T13:32:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 1f62140e-fb4e-44d9-8946-2d6170b9bcaa, 'Très bon, mais après avoir mis les bananes, la pâte un peu trop liquide.', '2022-07-25T19:14:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 2d94112f-c667-4dd9-8031-4194678fd002, 'Très bon ! Merci pour la recette ! ', '2021-11-28T16:27:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 86fb191b-832e-476b-b4f8-3cb470de227f, 'Beignet bien réussit,  merci pour la recette.', '2021-01-23T14:18:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 3b32c28e-9a6d-4384-9d48-939611ad17a0, 'Je valide à 100% ! Les beignets sont légers et délicieux. J’ai ajouté deux cuillères de farine car la pâte était trop liquide.
', '2021-01-22T18:01:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 1bb5eb2a-9efd-43d2-a8c0-4fcc74d39939, 'Simple, rapide et efficace ! Un vrai plaisir.', '2021-01-16T20:04:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, cbc8203f-b553-44ce-b7c8-ed356295478a, 'Beignets bien réussi !', '2020-10-20T20:56:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 5e94e820-80ce-4db7-a8f6-890b2738fd64, 'Trop bon', '2020-04-08T22:38:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 133019b9-c4e7-4ee9-b871-a492602e8c60, 'Très bonne recette excellente !', '2020-03-26T12:49:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, c2d49d29-ded9-41aa-a8cc-2f077492438c, 'J''ai fait la recette une catastrophe !! La dose de rhum n''est pas précisée, la pâte est très vite liquide et à la cuisson le beignet ne se forme pas.', '2019-03-22T20:34:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, c5effa45-a7d3-4ebf-b06a-df2bc16ea4b1, 'Super !', '2016-06-27T22:26:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 40fb020e-532f-450f-ad35-7426484a3b70, 'Excellente recette avec des bananes plantin bien mûres. Mon fils a adoré ', '2016-06-14T22:05:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 90ed375b-54a4-4666-8a6c-b859a42c6a1d, 'Délicieux et tellement simple ! ', '2016-03-13T19:20:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, e7aee686-c9b5-49f0-a3bf-9ed9dd22c7e1, 'Super bon et fondant ', '2016-02-14T18:26:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 66be3559-bbd7-44b0-9745-87854d1927a0, 'Simples et bons', '2015-01-14T20:45:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 99d9a2ba-f365-4f07-a4c0-fa699cbec252, 'Superbe recette. J''ai mis deux cuillères de sucre car les bananes mûres sont très sucrées et au moins deux à trois cuillères de farine en plus', '2014-07-29T15:50:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 80f84155-94d7-47bc-81d9-7675798a213d, 'Il faut juste ajouter 2 cuillères de farine en plus car c''est trop mou... sinon, c''est bon...!', '2014-03-07T19:40:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 4ab89b80-c3c2-45a0-88b2-d87089e60363, 'Excellent ! J''ai juste ajouté une cuillère à soupe de farine car la pâte me semblait trop liquide.', '2014-01-24T14:26:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, 5c541a81-8dbe-464f-82a8-e03160a35af6, 'Très bonne recette mais les beignets sont un peu difficiles à faire.', '2012-09-28T20:06:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219751, f7137e2a-7f15-4c9d-8b48-9cd47a49880a, 'Très bon', '2012-07-31T15:50:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (218399, 9ea0b73b-0d44-46ee-9600-71d0611f9f24, 'Pas mal ! ', '2023-01-07T16:20:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (218399, ffdfb68d-4490-49b6-a8a0-af6227657125, 'J''ai vraiment apprécié pour le petit déjeuner, j''en refais régulièrement.', '2022-04-06T18:42:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (218399, ec665441-494b-45f3-8aed-4446565e1a8c, 'Très facile à faire et délicieux.
Idéal pour un petit déjeuner énergétique.
J''ai laissé tiédir 15min après avoir servi en assiette creuse.', '2018-09-02T13:24:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (218399, b893eaf5-ddbc-44ea-9b79-a5f4ea97c693, 'Très bon ! ', '2017-06-10T22:40:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (218399, 572c9542-44a7-4086-b4d7-2d6ab5036bb0, 'Super facile, super bon !', '2014-12-27T15:46:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (218399, ae9d59bc-1b1c-4d35-8e4a-a6cafb805e5e, 'Pas mal du tout, je n´ai mis qu´une cuillère de sucre et ajouter des raisins secs, je n´ai mis que des pommes. Bien, quand on a pas envie de cuisiner.', '2012-01-18T23:25:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22477, c6673903-c23f-44f7-9751-fd69dbb26414, 'J''ai simplifié la recette (déjà pas compliquée au départ) en utilisant de la Chantilly en bombe et de la sauce chocolat toute faite. J''ai également supprimé le sucre vanillé et ajouté de la glace vanille. Honnête, et surtout, ça dépanne!', '2015-03-15T11:33:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (349039, 7d28b4ee-2c05-4711-924e-ce62ae510067, 'J''ai supprimé les spéculoos, et heureusement, sinon cela aurait été écoeurant.', '2018-12-07T17:02:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69560, 89d47180-1b01-4b8b-b4e9-ae8b80d956d7, 'Excellente recette suivie a la lettre sauf 1 yaourt nature a la place des petits suisses, 30 min a 200°C. Parfait merci !', '2022-10-22T14:24:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69560, 31d99c1b-2ba7-45c1-9cd9-c2be87efdea2, 'Excellent. J''ai rajouté du sucre au rhum et un peu de rhum et de vanille en poudre dans ma pâte. 200 degrés chaleur tournante 25 mins et c''est cuit.', '2020-04-09T21:27:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69560, 8bdcedc5-4140-45a6-bf70-e430a9195e94, 'Délicieux !', '2019-01-13T02:32:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69560, 2fc773e6-7c67-49d2-8d3f-7b42a36ab825, 'Délicieux !! J ai suivi la recette, j''ai juste fait revenir les pommes avec de la fleur d''oranger.', '2018-12-05T20:23:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69560, 1327be89-4ebc-4c28-a13e-373d46d94226, 'Délicieux. J''ai remplacé les petits suisses par un yaourt bulgare et les fruits ont précuit un peu plus longtemps qu''indiqué dans la recette  (20 min). Le temps de cuisson est parfait pour un four en mode chaleur tournante.', '2015-06-22T23:59:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69560, 382c12c8-615b-4f89-b436-960f91efe83b, 'Bon et léger. J''ai cuit dans une poêle des rondelles de bananes sans le rhum. J''ai mis peu de sucre et pas de levure (la consistance était ok).', '2013-06-17T16:08:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69560, 5a90ca66-86ab-4497-b734-eb5e9436cbcb, 'J''ai suivi cette recette à la lettre : un vrai délice !!! Moelleux et très subtil en goût. Je l''ai servi avec de la crème anglaise, tout le monde s''est régalé. Merci pour cette recette, je la garde précieusement...', '2013-05-05T22:36:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69560, 87882014-6054-4af5-b96f-07be24e94b27, 'Terrible !!! J''ai modifié un peu la recette, j''ai rajouté une pomme et une banane que j''ai faites dorer à la poêle pendant 15 min avec du beurre, du sucre vanillé et du jus de citron, puis flambées au rhum. Au lieu d''utiliser 2 petits suisses, j''ai pris un yaourt à la grecque, puis j''ai suivi la recette à la lettre. A refaire !', '2013-03-21T17:39:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69560, 2b9bc60f-8701-4f6a-b2a7-7717d84d4519, 'Une catastrophe... Même après 1/2h de cuisson supplémentaire, les fruits au fond du plat ont donne trop de jus, le gâteau est détrempé et ne ressemble à rien. Heureusement que je l''avais réalisé pour une soirée sans invité !  Peut-être que sans banane, le résultat est meilleur; mais tel quel c''est juste une catastrophe.  ', '2012-12-25T23:50:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69560, 4da92359-d8be-4e02-8f98-8a47e15f8461, 'Excellent ! Je l''ai préparée sans Rhum et sans les pommes et c''est un vrai délice ', '2012-11-12T21:22:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69560, 8070d39a-a8cf-4c5e-b24e-054202b71bf8, 'Sans bananes, je me suis quand même lancée et c''était super bon et très rapide! au dessert ou pour le goûter!', '2009-02-01T16:34:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86464, 2d51b6e1-4b12-4f4e-9cb6-ce53c44460be, 'Super bon, j''ai suivi la recette et c''est délicieux ! A faire et refaire !', '2019-05-16T03:52:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86464, 679276a2-d8bb-4395-883d-2bff6d10f7cc, 'Bonne recette facile. J''ai juste ajouté un peu plus de ketchup (pour le goût sucré). Merci.', '2014-04-20T10:19:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86464, 7a8e1f52-adc6-440e-a80a-35a53b55abe1, 'Super bon, bonne recette, le poulet et l''ananas la banane se marient très bien. Merci !', '2014-01-05T00:26:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86464, 146c84eb-116a-4310-b4f4-2bfc0e59f446, 'Un pur moment de plaisir ! Merci pour l''idée. A refaire.', '2013-09-23T15:11:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86464, eb7f626b-a5c5-48c1-b1e2-c25a8c959633, 'Le goût des fruits est noyé dans le bouillon. Plat assez décevant...', '2013-08-25T10:46:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86464, dbabf8d0-38c8-44c2-bf15-f4839d6d76b3, 'Excellent très apprécié des invités avec du poulet fumé.', '2013-07-01T17:22:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24758, 9584785f-fd3b-45d3-930e-739e6dd9f341, 'Originale mais la sauce est restée un peu épaisse et la viande un peu sèche, à refaire. ', '2008-11-16T21:20:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24758, a6742a9d-a686-40a0-94d7-1351bd59e599, 'Assez bon et original, les invités se sont régalés, et m''ont sifflé la marmite, c''est un plat assez gras, même en mettant moitié moins de crème et en remplaçant par du lait de coco.', '2008-03-10T22:15:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24758, cef41ae8-f158-4f29-978d-a326e95a4aa0, 'Excellent et simple à réaliser. Les convives étaient ravis. Cependant, je n''ai pas mis autant de crème (la moitié seulement): le plat était moins riche et il y avait de toute façon assez de sauce.  J''ai présenté dans un grand plat creux en suivant le descriptif de la recette: c''était magnifique!', '2004-10-10T18:06:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24758, 1b5255a5-51bc-4359-8abc-72a4ae26f3c0, 'Merci pour cette succulente recette! C''est la première fois que j''utilisais les bananes en version salée et c''est une réussite. J''ai juste remplacé la moitié de la crème par une boîte de lait de coco, que j''ai fait réduire et dans lequel j''ai fait infuser une grosse poignée de raisins secs. J''ai relevé le plat avec un zeste de citron vert.', '2004-06-30T11:53:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52041, 2da29397-4e14-405e-a510-c8f1999e72d3, 'Recette toute simple. J''ai utilisé 100g de chocolat pâtissier que j''ai fait fondre avec un peu de crème liquide. Résultat délicieux pour un goûuter copieux : les enfants ont adoré !', '2011-01-02T10:48:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (89784, 1ff1e085-bfc3-4991-84c1-7cfa31e83b36, 'Excellente recette ! Aujourd''hui je n''ai pas de bananes alors on va la tester aux pommes.', '2016-11-01T14:53:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (89784, fc2de1cd-9ae3-4ea2-88b5-10cb73fb2ad3, 'Bonne recette, la cuisson en chausson la rends un peu sèche, c''est bien amélioré par un ajout de crème fraîche dessus au moment du service. A tenter en tatin peut être...', '2012-04-17T20:21:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52358, d172abba-3d4a-4a0b-81f0-bd6bc459f70a, 'Un peu long de prépa mais excellent !... encore plus le lendemain, accompagné de pâtes !', '2023-02-15T16:07:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52358, d6e746f8-236d-4db7-b734-c963b23ed08e, 'Délicieux et simple. J''ai simplement ajouté une banane en plus. Merci beaucoup. Pour les amateurs du genre, il faut également essayer le rôti de porc aux pommes et au miel (la recette est sur marmiton!)!', '2014-04-08T09:24:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52358, 40e58a2b-e955-489a-b356-2d8494c2b434, 'Je suis ravie de retrouver sur marmiton cette recette, que je faisais régulièrement. Très facile a faire, et toujours autant de succès. ', '2013-04-22T12:06:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52358, 9f1cb753-358d-400c-bb84-3c4b8c0f6ac9, 'Très bon en effet cette sauce sucrée/acide !', '2012-02-20T09:16:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52358, 07976815-cd7c-4d42-a73f-5a7171047f41, 'Je suis très friande de ce site, vous avez tous des recettes géniales et vos avis sont extra.  Cette recette a fait un tabac est je recommencerai, ça change et c''est vraiment vraiment très facile à faire et à déguster. Ce soir là, j''avais des invités et j''ignorais que l''un d''entre eux adorait le curry, en arrivant à la maison, il avait déjà apprécié le plat rien qu''en sentant l''odeur !! Merci Michèle', '2010-04-24T14:25:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52358, 281210cc-dd09-4923-a71e-137cbf08a687, 'Vraiment délicieux ! Nous avons tous été très agréablement surpris. Merci.', '2010-04-18T20:30:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52358, 0e7a7dc1-ca03-429e-8ab1-fa1b308069c9, 'Délicieux !!! à faire et à refaire', '2010-01-21T09:26:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52358, f997437d-7286-4e4d-bb04-e1fd3ba55eb8, 'Cette recette a eu un franc succès à l''occasion de l''anniversaire de mon chéri. Nos invités et nous même avons adoré, vraiment délicieux. A l''occasion, j''essaierai de mettre les fruits plus tard pendant la cuisson. Et n''hésitez pas sur les épices.', '2008-11-06T16:39:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52358, c6851bbb-7ca9-4b3d-9de7-214ffb0f5697, 'Merci pour cette délicieuse recette! D''abord hésitante devant ce mélange boeuf/fruits, j''ai été agréablement surprise du résultat. J''avais bien moins de boeuf et comme "pincée" n''était pas très précis, j''ai mis 1 c. à café de chaque épice et ce fut très goûteux. Donc ne pas hésiter a mettre une bonne quantité. Merci encore et bon appétit!', '2008-07-26T11:49:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14792, 61cd018e-9666-490a-b5cd-fb365d5ad05e, 'Bien bien!!! Cette recette permet aux enfants de composer et de faire eux-mêmes leur dessert!', '2004-07-01T15:40:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14792, 7c9418db-09ed-4b5b-bc1c-3bde788112fa, 'Bon et simple.', '2003-10-23T15:28:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14792, 1e1def84-7772-4c17-9b0c-1317e973ec5d, 'Boff...', '2003-04-18T03:18:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14792, a654e100-a53a-4697-9ec3-bf7043b29de9, 'Nous, qui aimons tant les desserts, n''avons pas raffolé de celui-ci...', '2002-12-23T22:16:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14792, 3c607c39-58b0-4ce8-8002-f3667b27b8f8, 'Délicieux.', '2002-01-03T18:15:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47162, bea9fa07-9948-42ba-b2ad-3a5b94e34fb2, 'Même amatrice de chocolat, j''ai eu du mal à terminer ! C''est très bon mais à manger au goûter par exemple ! Les ingrédients sont amplement suffisant pour 4 personnes. ', '2011-07-26T12:09:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47162, 2b22b497-fde6-4234-b8a6-ff45425458cd, 'Trop lourd à mon goût et on sent à peine le chocolat blanc, en fait, à cuisiner je ne trouve pas ça pratique du tout.  La présentation et l''idée est originale et séduira certainement les grands amateurs de chocolats.', '2010-05-08T15:51:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47162, ddfda924-7c75-433f-aa8d-566fd3ab838a, 'Un peu trop sucrée à mon gout et j''ai trouvé que la banane ne se sentait pas et le gâteau au fond n''apportait pas grand chose  ', '2010-04-19T17:49:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47162, 163b5949-1bac-44f0-8b95-baecb64d3155, 'Super recette ! Mes invités ont adoré, et moi aussi. J''ai juste changer le chocolat noir par du chocolat au lait, mais c''était parfait. Merci', '2010-01-05T14:53:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47162, cca30d5a-8aa4-4dd7-a568-789855a0247a, 'Un vrai délice et très beau. Mes amis étaient épatés et tout le monde a léché le fond de son verre !!! Merci', '2009-11-22T18:10:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47162, 22bbf3ea-5b68-4ed2-bec1-68d73593d717, 'J''ai testé, j''ai aimé, j''ai tout mangé!!!', '2007-07-01T18:40:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47162, 96eb814d-5e89-4c6b-8d55-7b79de737b32, 'C''est vraiment très bon. Je suis novice en cuisine, j''ai eu un peu de mal pour la mousse au chocolat blanc, en fait, ça ressemblait pas à de la mousse mais c''était tout de même très bon. Peut-être l''erreur a été de ne pas avoir trouvé du chocolat blanc pâtissier!!', '2006-08-16T19:14:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335672, 564c9954-d211-4861-8a97-5c728359ca37, 'Ou comment transformer une énorme salade de fruits retrouvée dans le frigo après le départ des invités. Pour moi il y avait des raisins secs en plus. Tout cela fait une excellente confiture de... Salade !', '2019-10-01T13:01:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42241, d40c87b7-d736-46c3-86f4-57ab0871fb07, 'Un délice de fraîcheur épicée et d''onctuosité.', '2006-07-06T21:19:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, fc8df085-7195-472d-a335-a2b3a6f20663, 'Un pur délice!!! D’habitude je n’aime pas les cakes à la banane mais ici je trouve ça vraiment délicieux et mes enfants aussi! Mais j’ai un peu ajusté la recette:
- 3 bananes mûres
- 80g de sucre fin
- 100 g de chocolat
- 2 càc d’huile de tournesol
- 2 càc d’huile d’olives (je n’avais pas d’huile de coco)
- 1 sachet de levure chimique 
- 1 pincée de sel
- 100g de farine fermentante
- 50g de maïzena
- 50 ml de lait de soja
C’est troooop bon et moelleux!', '2023-05-04T21:39:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, c22faaa7-76f8-4687-bbdf-a4a9935732fc, 'Ma recette favorite, je met seulement 50g de sucre, faisant de cette recette un gâteau plutôt sain pour la santé à manger sans modération.', '2021-01-14T18:30:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 614b8500-65a7-4491-9591-a177912dfa7a, 'Top
', '2022-05-20T12:13:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 41807c62-0bd2-4092-8ad3-e753cd4d890d, 'Il était vraiment excellent cependant il était assez sucré je conseille de beaucoup réduire les doses de sucre. Après j''ai eu beaucoup de mal à le faire cuire j''ai dû le faire cuire 20 min de plus.. . Mais je le referai parce que ça en valait la peine  ', '2021-05-07T11:14:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 84d6e136-7c35-49a7-892f-ccdc8421f3c6, 'À faire à la St valentin', '2021-03-19T10:25:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, b281a05c-0950-48f4-80b7-d60b45fcb20c, 'J''ai divisé les proportions par 4 pour m''en faire un cake individuel ! Il me restait une demi banane. En effet pas besoin de sucre (je n''ai carrément pas mis de sucre, simplement un peu de compote de pommes).', '2020-11-09T22:33:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 58a70c2c-ca64-4fc6-96ab-7922a75b1fa0, 'Excellente recette ! Moelleux à souhait ! Tout petit bémol: Trop sucré. 80gr de sucre c''est suffisant.', '2020-03-14T17:33:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, c0aecfc8-d65c-4836-9fcc-caee8c241cab, 'Avec des pépites de chocolat et un peu moins de sucre ce serait absolument parfait mais cela reste tout de même de très bonne recette ! ??', '2020-03-03T02:06:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, cbbf045c-cb5f-4b5a-b828-aa2277f765ea, '60 g de sucre suffisent amplement, car il y a déjà le sucre des bananes et du chocolat. Le cacao n’est pas utile je trouve.  Un peu de mélange quatre épices donne un peu plus de caractère au gâteau. 30 mn de cuisson jusqu’à légère caramélisation/coloration de la croûte. ', '2019-12-17T10:24:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 40c84314-9735-4b7a-8a75-7264b6e8bf08, 'Je mets 30min à chaleur tournante. C''est très bon et rapide à faire. ', '2019-11-08T09:58:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 5f45f64b-d5ef-4a78-b859-cead0728fc9d, 'En voyant la pâte, tu te demandes si ce seras bon et paf... . C''est super bon, j''en ai fait façon muffin et j''en suis déjà à mon 4ème', '2019-08-21T17:05:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 569e1efc-fe3b-4756-9cf2-fadaef7a1025, 'J''ai mis moins de sucre également et pas de sucre blanc mais sucre non raffiné 80 g. Pour la farine j''ai mis 100 g farine blé intégrale T 150 et 50 g de farine amande. J''avais 3 bananes bien mures à utiliser et pour la cuisson 40'' min à 180°C.
Résultat : un gâteau gouteux, moelleux...divin.', '2019-03-02T08:13:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 22bbb46e-268d-4f3a-9e96-aad2afc8f905, 'Pour une première fois, ça fait fureur et ça a été validé par ma collègue vegan.
J''ai simplement réduit de moitié les doses de sucres et ajouté en "topping" de la noix de coco râpée.
Je recommande grandement !', '2018-12-04T07:31:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 66226e5f-db61-4d9d-9988-8e1f741a1615, 'Hello je viens de réaliser votre gâteau et je pense mettre moins de sucre car c''est beaucoup sucré.. sinon au top bien moelleux.', '2018-10-03T11:32:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, b9d92648-c985-4d1c-a2dd-7268289354f5, 'Très bon ! Rien à ajouté ', '2018-09-22T10:18:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, ed4a492b-c040-4ce1-8102-bca9228a466e, 'J''ai trouve ça très bon. Ma famille a moins aimé, disant que c''était pas assez relevé a cause de la banane... j''ai rétorqué que c''était un fondant, et donc c''est normal que ce soit peu levé... non mais..!', '2018-03-03T03:24:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, a356a3c8-e316-4058-a319-9fdcc438d5c7, 'Après avoir réalisé la recette, j''ai trouvé le résultat mitigé. . C''est mangeable mais c''est pas gourmand. Le goût de la banane est trop prononcé et gâche le goût du gâteau.', '2018-01-13T06:56:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, f0449228-9d54-42ea-b9a5-40eecbeb2eda, 'Facile et efficace: Résultat bluffant. Excellent pour un début dans la cuisine vegan.', '2017-10-14T00:28:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 45c82cf2-352e-47c9-bbcb-f99f02c07a85, 'Super gâteau, on ressent bien le goût du chocolat et de la banane. Je mettrais à peine moins de sucre la prochaine fois. A refaire sans aucun doute !', '2017-06-22T23:47:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 26662e4c-d5cf-4903-b31f-013906190185, 'Bon goût pour du vegan ! On peut diminuer la dose de sucre. Merci pour cette recette !', '2017-02-18T18:50:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 3b5299bf-dc2a-4488-8b22-6de72d72e0b9, 'Aéré et onctueux. Personnellement je l''ai cuit à 180°C.', '2017-01-26T06:11:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 85a6838c-5b50-45f4-96fd-b13e4c0ef189, 'Excellent ! N''ayant pas le droit au gluten nous avons remplacé la farine de blé par un mélange riz + fécule de maïs. Nous avons allongé la cuisson de 15 min mais je pense que cela vient du four... Merci beaucoup.', '2016-11-27T18:00:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, f59bfc0b-8671-4273-a00f-d421ab1fd40b, 'Je n''avais pas du lait végétal alors remplacé pour du jus d''orange. Délice !!!! ', '2016-11-08T16:06:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 2cfcfb4e-a417-4564-acf8-3a8252e2c70f, 'Assez fade. Je ne le referai pas.', '2016-11-06T13:32:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 6ed8dc0a-9eb8-495d-b450-b05f4c570a70, 'Je ne sais pas ce qui s''est passé, mais j''ai bien suivi la recette mon cake est limite cramé et il n''a pas beaucoup gonflé...dommage ça avait l''air prometteur.', '2016-09-20T00:21:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, c7df51f5-fc0b-4f8e-ae0f-86336dd641b1, 'Très très bonne recette mes filles sont vegan et ce cake est un réel délice.', '2016-07-02T20:22:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 99643cd1-b9b8-4436-a4cc-3a78e23e2a0b, 'Je débute dans la cuisine vegan, recette très simple à réaliser et cake très bon ! Mes amis vegan ont tout simplement adoré. ', '2016-06-09T11:40:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, a618b522-0d39-48e0-8b35-bc31b1fd8b75, 'Je l''ai préparé en portions individuelles dans des ramequins à l''occasion d''un grand repas de famille et comme nous avons des personnes vegan, il a remporté un franc succès. Je l''ai également laisser cuire 10 minutes de plus, à refaire même si on est pas vegan, trop bon', '2016-05-26T21:06:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 886ae70a-debc-406b-8176-800a5956a9ce, 'Très bon et super facile à faire. J''ai également laissé cuire un peu plus longtemps. On sent bien la banane. Je n''avais plus de cacao en poudre et c''était bon quand même, mais je pense que c''est mieux avec le cacao, pour avoir bien le goût chocolaté.', '2016-04-20T19:11:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 49627699-0b8d-4cca-864c-3aa40db13f08, 'Mon premier cake vegan : un succès, tout le monde a aimé ! La texture est moelleuse à souhait.', '2016-03-26T09:41:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 175cb2df-e317-4140-b137-c84ecc263c12, 'Un vrai régal ! J''ai voulu tenter une recette vegan, et bien je ne suis pas déçue ! C''était un délice, tous les goûts étaient là et les proportions parfaites. J''ai seulement fait cuire 10 minutes de plus, donc 30 minutes à 200°C. Idéal quand on a des bananes qui commencent à être bien mûres. Tout le monde a adoré, à refaire vite.', '2016-03-12T00:46:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 1a0ea142-7f78-431d-bf41-b6570fb217b0, 'Idéal quand on n''a plus d''oeufs pour faire un cake ! J''ai ajouté l''huile dans le chocolat fondu au micro-ondes (50 secondes) pour éviter qu''il ne se fige, puis je l''ai ajouté à l''appareil bananes sucre. Parfait !', '2015-08-15T19:50:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339635, 4177bf79-92fb-4433-9ce3-c03415ecee25, 'Trop bon ', '2015-08-14T15:05:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52809, 84bdbe0c-cc9d-4742-9159-617baf6172c8, 'Je n''ai pas testé les pommes mais je les ai remplacé par des tranches d''ananas et c''est un délice, autant que les bananes. Je conseille cette recettes à tout les amateurs de plancha.', '2014-09-21T20:07:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52809, 5dfa7ef3-449f-4584-b2f1-91947207783a, 'À faire sur du papier cuisson et à flamber devant les invités ! Génial !', '2013-04-24T20:17:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52809, 9b7f469b-7e92-4cc6-ae9e-97acdb40a736, 'Très simple à faire et excellent à déguster. A penser pour un quatre heures aussi.', '2009-09-19T21:39:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52809, 40fd8e19-5181-4867-b609-a565af0b63d2, 'J''ai essayé avec que des bananes . mes invités étaient ravis. très facile à faire. truc en plus : les flamber au rhum ambré à la derniere minute...', '2007-08-05T18:43:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533846, ef307c23-14f7-49c3-9b58-1868bc158e25, 'Trop bon😋', '2023-06-12T16:05:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533846, 6ac0df02-a11e-4b76-ae4f-5889c648aca6, 'Miam ', '2023-02-23T16:45:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533846, 5809e9b8-292b-4f87-bee7-18eeb2a88b2d, 'Excellent ! Le goût de la banane est très prononcé, j''ai juste mis moins de farine (environ 200 g pour 4 personnes).', '2022-10-10T21:12:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13575, f80b3eab-b898-4586-a0e1-c2087ea1fbb5, 'Grillés dans une poêle, plutôt qu''au four pour ne pas que ce soit trop sec.', '2005-12-04T21:58:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13575, 43f5d6be-a58b-4ee2-aae5-3789315d56d7, 'Pas très difficile à faire, mais le résultat est un peu décevant. Peut-être y a-t-il trop de beurre et pas assez de fruits?', '2005-06-14T17:24:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13575, b772c23d-b23d-415d-8940-2fe6a1b042e0, 'Très bon, ça a beaucoup plu à Rémi. Très facile à faire et la présentation fait beaucoup d''effet. Un peu lourd tout de même, ne prévoyez pas un repas trop copieux avant!', '2003-03-19T22:00:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13575, 3380d3c4-44c5-41d9-9abc-62c06c0bad20, 'Très simple à réaliser (si on fait l''impasse sur les formes parfaites, les feuilles n''étant pas toujours très faciles à rouler), délicieux et finalement assez léger.', '2002-06-15T17:48:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47685, b1898de1-522e-4a20-8f3a-b445923277a5, 'Sympathique gâteau à faire avec les enfants, nous avons ajouté un peu de cannelle, tout le monde a adoré!', '2013-04-07T16:54:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47685, 159aa894-6d49-4b5f-aa2c-f1132d40db34, 'Un vrai délice et simple à réaliser. J''ai mis 100 g de maïzena, 100 g de farine et j''ai battu les blancs en neige.', '2011-11-20T11:46:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47685, ab12b6a9-5c05-44c6-b7c7-2a52530c668d, 'C''est un super gâteau, rapide à réaliser. Il faut le manger quand il est à peine froid c''est meilleur ! Mon chéri a adoré !', '2011-07-30T11:45:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47685, be995e6e-db97-461f-b6fb-dae56db373a6, 'J''ai fait ce gâteau pour un repas entre collègues un jour. Succès fou ! Je l''ai conseillé à ma maman et je l''ai refait à mon chéri le week-end suivant, pour tous : un régal ! Une recette à garder et à refaire à volonté !', '2009-12-28T17:05:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47685, d222ebcd-6cd8-4d61-be86-b519efc0092f, 'Délicieux. Même mon mari qui n''est pas un fan des gâteaux à la banane, a adoré.', '2006-10-03T21:06:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47685, 132ba19c-0d7d-48de-8463-51a894f9725b, 'Pas génial: cette recette ne fera pas partie de mon carnet.', '2006-09-28T00:00:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47685, d6c0d56f-243e-4559-ad16-4fb3f3a6e606, 'Je l''ai fait...mais pas goûté! Je l''ai amené à la fête de la crèche et n''ai pas eu le temps d''en prendre un bout, tout était déjà parti ! Il est aussi très beau. Merci !', '2006-07-14T13:55:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60428, 6eb3d37c-5878-4f47-849e-f9b54da62796, 'J’ai mis une banane entière, le double d’amendes et du curry. C’était délicieux, et ça change.', '2020-04-15T14:53:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60428, 4daf5615-bf45-487c-9dbe-123752be1ae9, 'Plat très reussi qui a eu un véritable succès lors d''un repas de famille !', '2017-10-25T11:55:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60428, 66c0c103-b6f1-4fdf-87ec-69f497991cbf, 'Plat facile et délicieux. La prochaine fois je supprime les amandes et je mets plus de banane.', '2016-08-30T11:59:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60428, 8f0ebfd2-182c-4336-81c8-2986321b4319, 'Facile et rapide. Un vrai délice. J''ai mis la crème de coco en une seule fois et utilisé de la pâte de tandoori un pur régal. Servi avec une poêlée de légumes nappée de sauce. A refaire sans hésitation ', '2015-06-26T09:58:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60428, 7bac2c0d-4076-467b-8c4d-6c86950b7b1d, 'Parfait, plein de saveurs en bouche.', '2014-11-15T21:04:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60428, 53da4a42-d7d0-4975-b17f-fd75f8340862, 'Très bon, un peu le goût de coco peut-être.', '2014-02-14T19:46:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60428, 90410873-70e7-4937-9d06-6f2d99deadfd, 'Inratable et tout simplement très bon !', '2012-10-30T13:38:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60428, aa517512-730e-4fcb-9978-e61fb89d1e9c, 'Bonne recette ! J''ai mis un peu plus de tandoori pour que le goût des épices soient un peu plus présent.', '2012-02-15T12:40:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60428, 9b4a956a-c67f-4313-b734-478753f56bc8, 'Tout simplement excellent ! Mon homme s''est régalé et moi aussi. Je la recommande vivement !!!', '2010-09-25T22:17:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60428, 5a770d51-f2ed-4c58-aad2-b34dc1a8b8c8, 'J''ai trouvé cela un peu fade !!! Pourtant j''ai rajouté double dose de tandoori. J''ai suivi la recette à la lettre et j''ai mis une banane entière. Son goût y était vraiment peu présent. Je pense que le tandoori est meilleur utilisé seul sur des morceaux de poulet. La saveur du lait de coco était bien trop forte.', '2010-08-12T17:31:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60428, 4f28335c-de05-46ad-8853-dee592976d71, 'Je l''ai fait pour un dîner entre amis. Vraiment excellent !!! La banane fond dans la sauce.  J''ai mis plus de tandoori (1 cuillère à soupe) et j''ai versé tout le lait de coco d''un coup pour aller plus vite (au lieu de faire en 2 temps comme dans la recette). A faire d''urgence.', '2009-11-30T19:54:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60428, 2c577f1c-82e9-42df-acfd-9c57d67f2e9b, 'Ma préférée sur Marmiton !!! Je ne cuisine qu''avec des épices et peu de recettes m''étonnent bien que je me régale toujours. Cette recette est originale, goûteuse et surtout très douce (j''ai mis plus de tandoori et une boîte entière de lait coco pour avoir plus de sauce, ainsi qu''une banane entière. Je mettrai moins d''oignons la prochaine fois). De toutes les recettes aux épices essayées sur marmiton, celle ci est ma préférée !!! Inratable et ultra rapide !!! Génial pour surprendre vos invités. Merci pour cette excellente recette !', '2008-02-27T19:39:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13305, 8166d3a8-7eb3-42d6-b206-5f851be7e280, 'Excellent. Pas de gaufrier donc au four génial. J''ai remplacé les épice par un peu de la pâte à tartiner, et j''ai servi avec une boule de glace à la vanille tout le monde a adoré, à refaire sans problème et ultra rapide.', '2013-03-01T19:02:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13305, fc644aab-162e-4f0c-a0cc-de99cc4c6c1a, 'Testé sans lait concentré n''en ayant pas sous la main. J''ai réduit la banane en purée (avec les épices) pour mieux la répartir, et saupoudré de sucre glace après cuisson. Parfait pour le brunch ou le petit déjeuner !', '2014-07-30T21:26:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13305, 49e5aaab-3952-4271-8465-7e24edae4f3a, 'Dessert très bon. Il est très facile à réaliser et à decliner selon les goûts de chacun. C''est une bonne idée pour un repas improvisé.', '2013-09-09T12:59:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13305, a53657ff-92ac-44c2-a735-0918414a2e2a, 'J''adore !! C''est vrai que c''est un peu lourd, mais c''est tellement bon. Pour info, n''ayant pas de gaufrier, je les ai mis au four pendant 5 min.', '2010-06-09T21:58:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13305, 00ecc28b-59f0-45aa-b1f7-1dea54b009ff, 'On peut également retirer la cannelle et le gingembre et y mettre de la confiture de fraise ou d''abricot, ou encore du chocolat en poudre que l''on laisse se mélanger avec une noix de beurre pendant la cuisson dans le gaufrier. C''est un délice.', '2008-03-19T18:47:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13305, cc67371b-50a6-4748-a07a-b02f2e95f96b, 'Excellent! Dessert rapide à faire et qui épate les invités par son originalité.', '2007-02-09T11:48:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13305, 5f6a5ca9-8262-430e-8dbb-38ce044561a3, 'A réaliser les yeux fermés. De plus, la réalisation est enfantine.  Ne pas oublier de couper très finement les bananes et ne pas hésiter à mettre du lait concentré (3 bonnes cuillères à soupe).  Bon appétit.', '2004-09-08T09:33:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80061, 43aaf443-1d2a-4eaf-b9ad-fcc45a56bc83, 'Vraiment sympa et s''adapte pour tout fruit de saison !', '2017-03-16T23:01:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80061, 9e932a50-244b-485f-8781-d66cb596203e, 'Un délice ! Mais mieux vaut ne pas en abuser : les fruits n''excusent pas tout.', '2010-06-02T22:10:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42323, 10f03e07-6b9b-4945-b2e4-5a84217e8dac, 'Très, très bon. Enfin une soupe originale et très gouteuse. Merci.', '2007-10-05T12:14:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42323, 5a98d48c-ef3c-470e-a299-f41cd88839b5, 'Ce n''est pas mauvais mais ça ne m''emballe pas non plus. On perd le goût du potimarron au détriment des épices…', '2007-09-05T15:39:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42323, 73847ab2-6753-4465-8e2f-4d0df890e8c1, 'Une soupe au goût sublissime!!!', '2006-10-03T17:03:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42323, a13cfc9f-b4e9-458a-a9cf-4d72c6fa35a6, 'Soupe essayée après avoir "trouvé" un potimarron dans le panier de légume livré par notre AMAP locale (AMAP = Association pour le Maintien d''une Agriculture Paysanne). On ne savait trop quoi en faire, et on a vraiment apprécié cette recette, au point de la refaire à plusieurs reprises, y compris à des invités de passage, également conquis. Notre petit plus: on ajoute un peu de miel avant de servir.', '2006-09-29T17:03:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42323, b24d3563-4649-48d3-b600-e1a46f2fc3eb, 'J’ai mis la moyenne, car je n’ai pas vraiment respecté la recette. En effet, le potimarron (petit goût de châtaigne) n’étant plus de saison, j’ai décidé de faire ce velouté avec du potiron. J’en ai acheté 2 kg sur le marché, la quantité d’eau et de lait de coco recouvrent ainsi les légumes, juste ce qu’il faut. ', '2006-04-13T23:41:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42323, 35f0de53-7437-4bb6-ba92-add5ef88aaf2, 'Et même 10 sur 5! Cette soupe est tout simplement délicieuse, la banane donne une texture très veloutée.  Le goût de la cardamome est aussi bien présent (je n''ai pas mis les capsules entières, mais les graines à l''intérieur). Merci pour cette idée très originale!', '2005-12-13T22:08:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83488, f19bb2ea-27de-49d4-876c-d78f2a23ab3e, 'Je n''ai pas non plus ajouté de garniture comme le Muesli était déjà aux fruits secs. J''ai aussi ajouté des céréales au dernier moment pour que la pâte soit moins liquide. C''était très bon, et surtout très léger ! Le goût de la compote de pomme se retrouve subtilement dedans. (En revanche certains n''ont pas aimé le fait qu''il ne soit pas croquant du tout, sans vraiment de morceaux mais plutôt moelleux)', '2014-05-10T22:41:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83488, 03d340e7-9677-43c3-8e3f-8c976f9f8bcf, 'J''ai testé la recette de base sans ajouter de garniture supplémentaire et j''ai trouvé ça très bon ! J''avais choisi une compote pomme / fraise, ce qui a donné un bon petit goût fruité ! Recette rapide, simple... à refaire sans hésitation !', '2013-01-24T14:03:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83488, dac7a697-35f5-4452-be22-1c5c7f3686b0, 'Merci, très bonne recette. Ne possédant pas de mesure adéquate sur mon verre doseur, je ne sais pas exactement quelle quantité de muesli j''ai mis. Les céréales ont gonflées dans le lait mais la pâte était très liquide alors j''ai du en ajouter une deuxième fois pour qu''elle devienne plus consistante. Aucune garniture spéciale pour moi, dans mon muesli il y avait déjà des raisins secs.', '2012-10-06T17:22:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83488, 66a8a70d-87de-490c-b8e2-1a0fbac97a06, 'Pas la base de muffin de mes rêves.. Pâte peu aérée et collante.. Mais bon.. On est light ou on ne l''est pas... peut être faudrait-il mettre davantage de levure.', '2009-03-24T14:24:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83488, 214c524c-1d66-4436-b627-871aa77f2055, 'Très bon, cela agrémente bien le petit déjeuner surtout avec un mari qui a un peu trop de triglycérides! En plus le choix des fruits à ajouter est quasiment illimité! A faire et refaire en toutes saisons!', '2009-01-16T10:22:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58182, 12b58094-8dcc-48ce-a1d6-efd68aa4a849, 'J''ai remplacé le yaourt par du lait de riz et je l''ai aussi fait sans bananes, les deux sont parfaits. Un dessert rapide et excellent.', '2013-03-24T16:14:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58182, 125b8103-b687-4371-af63-8d96a23a5017, 'Un dessert très bon pour toute la famille. Il est préférable de la faire dans un plat à cake.', '2011-12-13T13:42:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49173, 5dc38e1e-4d57-41f3-a51d-ded65567e91d, 'Délicieux ! ', '2023-08-16T18:40:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49173, 20d9e1b4-fdf3-40dd-af97-6e6eb42b98f8, 'Absolument génial. J''ai pris du beurre de cacahuètes déjà prêt, ça allait très bien', '2013-11-08T11:50:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49173, 2ab5df60-248e-4522-ad18-3183c253d316, 'Vraiment surprenant, je ne m''attendais pas à ce que ce soit si bon. Pour le bœuf j''ai pris de la poire, que j''ai à peine saisie et remise à mijoter durant les 10 dernières minutes de cuisson, c''était parfait. J''ai laissé les bananes à part, la prochaine fois j''essaierai de les mélanger à la sauce avec un peu de riz à côté.', '2012-02-11T12:49:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49173, f8f134bc-bb9a-4100-96ef-4c7892035029, 'C''est un plat qui vient du Cameroun, comme ma femme à des origines  Camerounaises, elle a rie quand elle a vu ce plat préparé par un Français. J''ai suivie à la lettre la recette c''est très bon. ', '2012-02-07T16:11:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49173, 331a5ff0-507f-4557-9727-59930f63055e, 'Je trouve la recette peu claire. Faut-il vraiment cuire complètement la viande si on la recuit 25 min ? Avec des explications plus détaillées j''aurais mis un 5  ', '2010-08-15T12:48:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49173, 98fbb8e7-14f6-47d4-8f57-58dc1e5d11aa, 'Mon chéri m''a dit "huum tu viens d''inventer une recette camerounaise" (pour y être allé). J''ai été franche: "pas du tout je l''ai trouvé sur Marmiton !". Merci pour cette recette. Quelques soucis de cuisson avec mes plantains mais délicieux malgré tout !', '2009-07-25T21:31:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49173, ab0d631a-3147-476d-b1d4-e9ad1fc6f605, 'Super bon!!! Moi j''ai mangé ça avec du riz et c''était plutôt bon aussi mais c''est quand même mieux comme c''est conseillé accompagné de bananes plantains!', '2008-10-06T22:33:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49173, 189476f3-3072-4eda-9b57-9e748ee09ccc, 'Super !', '2008-03-22T17:24:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49173, 0ae1bcea-5587-489a-8082-858c66458731, 'Une recette vraiment délicieuse et dépaysante !! J''ai aussi utilisé de la pâte d''arachide toute prête, plus pratique, et remplacé les bananes par des pommes de terre à l''eau. Utiliser de la viande tendre, genre fondue, et la mettre dans la sauce peu de temps avant la fin de cuisson sinon elle risque de durcir.', '2007-10-14T17:14:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49173, fab9d766-1b3d-4b44-b85f-273f905f3653, 'Je conseille d''employer de la pâte d''arachide vendue dans le commerce (genre dakatine). La recette sera ainsi plus simple et plus rapide! Attention, ne pas acheter une pâte d''arachide sucrée!  ', '2007-03-22T11:47:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62631, 9e0eae89-9794-4c29-a2ce-9ad306ba665b, 'Le lait de coco atténue un peu les saveurs des fruits, c''est dommage. La salade de fruit serait meilleure nature. L''aspect n''est pas non plus fabuleux.', '2012-01-24T20:00:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62631, 86680bf1-00fb-4681-af03-9d1918150454, 'Très bonne salade, je n''ai pas mis la noix de coco râpée. Choix que j''ai regretté. ', '2011-04-22T02:21:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62631, 37346b5e-8929-4559-92e8-c4ae341142c2, 'Super bonne salade de fruits! très vite faite, si bien que j''ai eu le temps de faire des tuiles aux amandes pour servir avec et tout mon petit monde c''est régalé.  Merci pour cette recette.', '2009-02-20T11:51:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62631, db0ec7f3-d74f-4501-9980-a2a96546ca9c, 'J''ai fais cette salade avec du malibu à la place du lait de coco et sans rhum, c''est excellent.', '2009-01-26T18:23:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62631, 807ec679-5504-4bbf-8064-1ac15bdf0d94, 'J''ajoute du rhum blanc et doré, superbe recette !', '2008-07-02T13:42:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347168, c3096c99-a4d5-4db2-97e1-9d7c5f40b572, 'J’ai fais un mélange pommes-bananes, on s’est régalé ! A refaire ??', '2020-05-01T20:11:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347168, 3c35cecd-c35c-45f1-b4f8-3fe625a2db04, 'J’ai fais un mélange pommes-bananes, on s’est régalé ! A refaire 👍🏻', '2020-05-01T18:11:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347168, 18ef8932-0f4a-4a62-8ad7-1c6ea371fc8c, 'J''ai fait mélange pommes/bananes. Très bon. A refaire. J''ai mis du beurre végétal, étant intolérante au lactose. A refaire !', '2020-01-15T05:10:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347168, ac7968bd-f4d7-443c-8b50-12df38541916, 'Extrêmement bon et facile a faire !', '2017-06-09T23:27:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46211, 54b446cb-74ff-40c4-b2ac-8644037bb6db, 'Je ne savais pas ce que ça allait donner dans de l''huile bouillante, alors je les ai faites au four. C''est excellent', '2010-03-18T15:01:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46211, 02ca7560-cb93-41a3-b091-f27726387364, 'J''adore les recettes un peu exotiques donc celle là m''a paru très bien a vue d''œil, et quand j''ai gouté, ça a été délicieux ! merci et continuez comme ça !', '2010-03-04T20:49:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46211, b918a97b-ed6c-482a-9409-a14ff73e5cb6, 'N''ayant pas de friteuse, j''ai essayé ces chips à la poêle. Mais le fait d''avoir coupé les bananes en fines lamelles, ça m''a fait de la purée. A essayer en coupant des morceaux plus épais peut être ... Dommage, ça semblait appétissant.', '2008-05-06T22:37:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 41ac004b-f173-4cd4-8fb4-762fb432dcac, 'Super bon ?', '2020-06-07T01:24:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, a77a4f2c-5003-4c60-961e-5f819fed4fcd, 'J''adore.', '2019-10-13T09:37:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 3dcb4a68-757e-4bf4-afce-832748f542c1, 'Excellente, suivie à la lettre, cuisson 50 min, très moelleux, super parfumé.
Une tuerie...', '2019-05-30T05:17:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 5054301d-780a-40d6-967a-07443e2b7ede, 'Gâteau réalisé sans chocolat et c''était un délice !', '2015-12-02T16:05:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, df0192fd-415e-4b88-979b-c7ccace60ccc, 'Délicieux.', '2015-06-13T12:11:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 3a41a5c0-e4e1-4cb0-a4dc-c7e081e30fc5, 'Bon gâteau par contre suivant les conseils de certains, j''avais réduit le sucre ce que je ne ferai pas la prochaine fois sinon en suivant la recette très bon gâteau j''avais fait fondre le chocolat j''essaierai avec les pépites la prochaine fois je vous le conseille.', '2015-03-28T18:16:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 9ba24073-7b22-43a3-b01c-2402d7dfb4ee, 'Excellent et facile ', '2023-08-27T16:01:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, f1f2f159-e69a-4d33-8c4a-7bb7fa4787ed, 'Excellente recette, simple à réaliser, mon petit de 2 ans a adoré ! ', '2022-12-17T10:13:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, cd05feed-fd16-430b-8e51-c2573d4f69bb, 'Recette excellente ! En revanche mes pépites de chocolat restent tout le temps au fond du plat, même en les farinant...', '2021-07-11T23:45:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 28beeeb5-06a9-40f1-87f1-5e4db757289b, 'Moelleux et saveur incomparables ! Utilisé palets au chocolat (noir) qui tiennent très bien à la cuisson. 50mn cuisson totale. Merci ! Recette parfaite', '2021-06-30T20:24:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 569766fd-ffb2-4e67-8245-c5c834368a2f, 'Wawo le meilleur que j’ai jamais mangé. ❤️❤️❤️', '2020-12-04T03:08:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 3cb73998-1931-4aa0-b634-b8bbfdbbded9, 'Super bon ! mes bananes étaient petites donc j''en ai mis 3, j''ai réduit le sucre à 100g, on sent bien les parfums mais personnellement la prochaine fois je mettrais un peu plus de pépites de chocolat quand même !', '2016-11-04T22:46:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, e4468d75-f695-4547-8c23-d8a5030f3c21, 'Super, fait sans Coco j''avais plus. Faire des fines tranches car un peu lourd. ', '2014-12-09T19:20:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 7a7b5937-80f3-4365-a8ad-9a2ee33026b4, 'J''adore ce gâteau ! Un de mes préféré ! Merci pour la recette.', '2014-11-15T20:21:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 31ba18f2-c5d1-4102-8c22-8b6e07cddd93, 'Très bon, je n´avais pas de lait de coco, j´ai mis du lait normal à la place, une cuisson de 55 min pour moi. C´est très bon et fait l´unanimité de mes 4 loustics ! Merci pour cette très bonne recette qui permet d´utiliser les bananes que les enfants ne veulent pas manger car trop mûres !', '2014-10-28T21:14:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 38dd5fdf-4148-4ce5-87ef-92674bc7acfa, 'Très bonne recette suivie à la lettre ! Bon équilibre, cake moelleux et pas sec du tout, il a plu à tout le monde ! L''association banane, coco et chocolat est extra, on sent tout les parfums', '2014-09-27T14:04:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, a93954bc-e903-4baa-8458-a25509c2c2d3, 'Rien à redire, tellement parfait ! Moelleux à souhait, à refaire sans hésitation ! ', '2014-07-12T19:50:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 5597e67c-9c81-44e8-8a31-697eff613489, 'Pour cause de régime, j''ai remplacé le beurre par de la compote, et comme je n''avais pas de coco râpée, j''ai mis de la poudre d''amande (ok, c''est pas terrible pour le régime...). 1 h pile poil au four : super bon, juste ce qu''il faut de sucre. A refaire sans hésiter.', '2014-04-19T22:37:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 92fefc96-23db-4e04-8142-676346b72ea1, 'Ce cake est une vraie réussite, juste un détail qui a son importance, ne pas oublier la pincée de sel ! ', '2013-01-29T11:43:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 00d0ad11-b330-4575-abee-25641152df7d, 'Super recette, merci ! C''est très bon !', '2013-01-27T19:09:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, d404e1dc-5f34-4303-86a3-f2f1a336c400, 'Enfin un cake pas sec ! Une super recette, je n''ai mis qu''une banane, c''était déjà très bien !', '2012-11-30T18:04:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, b186fdae-f533-4e69-8437-017ca5c411cc, 'Délicieux ! Dans des moules à muffins ça marche aussi très bien. A refaire !', '2012-01-14T13:07:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 9b122e0a-2000-4e25-b988-992c381a7c1b, 'Trooooop bon, essayez avec des framboises, miam ', '2011-12-09T13:27:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 4b630f21-62e3-4f56-8c8c-4751b60b32de, 'Excellent ! a faire et refaire !', '2011-11-05T09:45:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, d6a2ca0c-70b1-4a08-9ca0-9be7a19db237, 'Moelleux comme je les adore ! Très riche en goût ! J''ai juste ajouté de la gousse de vanille en poudre pour avoir un gâteau encore plus exotique !', '2011-09-04T18:27:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 34e693e0-22d5-411f-8bfe-f37d7ee459af, 'Très très bon ! Il est très moelleux et gouteux. Pour ma part, j''ai concassé le chocolat dans un robot et il n''a pas coulé dans la pâte. Je l''ai également cuit dans des minis moules. Je mets la photo si j''y arrive !', '2011-06-13T14:57:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 9a4410c8-74ef-4fbb-9041-175733233589, 'Excellent ! J''ai juste fait fondre le chocolat dans le beurre ce qui n''en laissait qu''un arrière goût très bon. Le cake est très moelleux, une très belle découverte !', '2011-05-15T03:23:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 91b339b1-51fd-40b6-b8c4-f1d818a4f04d, 'Vraiment bon ! Fait et refait, ce cake est toujours moelleux et jamais sec. Parfait !', '2011-01-24T22:50:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 1caa54e0-f07d-4da1-90f3-e0e0e63e3eb9, 'Excellente recette ! Bien que n''étant pas une fan des gâteaux à la banane, j''ai trouvé ce cake délicieux. Merci beaucoup pour la recette !', '2010-03-24T14:21:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 171ddb3a-afdb-4e73-924a-4121d5b001e6, 'Ce cake était moëlleux à souhait, j''ai rajouté ma touche personnelle : une pincée de cannelle pour plus d''arôme.', '2010-03-09T17:44:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 548db47e-9ab7-4d31-b94c-064f7b6cae9e, 'Recette suivie à la lettre et qui est une vraie réussite!! Moelleux à souhait, un mélange harmonieux, bref à faire et à refaire. Merci beaucoup.', '2009-12-21T19:16:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 47c9ea68-23d5-4cc1-9e42-344685591429, 'Léger ! Super simple et rapide à préparer ! Juste bien vérifier la cuisson. Pour ma part, 45 min n''ont pas suffit ! Il manquait 5 min pour parfaire la cuisson ! A réessayer !', '2009-07-29T00:23:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 10f15ace-2fa2-4c29-bebc-7ce773026778, 'J''ai apporté quelques petites modifications à la recette : 160 g de farine, 1 cuillère à café de levure chimique, 2 oeufs, 150 mL de lait de coco. Le chocolat facultatif; je le préfère fondu avec le cake banane coco. Séparer les jaunes des blancs et monter ces derniers en neige ferme avec une pincée de sel. Cuisson: 45min. En tout cas un véritable délice : merci pour ta recette !', '2009-04-28T23:10:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, fc34535e-cb4a-4ce5-87c7-ca8da23ecd5a, 'Parfait, c''est tiède que je le trouve le meilleur! Par rapport à un commentaire précédent, pour que les pépites soient bien réparties il suffit que la pâte soit assez froide. Ainsi elle sera plus compacte que liquide, et les pépites ne "couleront" plus.', '2009-01-08T01:04:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, ce976fad-200b-46a0-ae0b-03a4a5c80434, 'Excellent cake même sans lait de coco. J''ai mis du lait à la place et ajouté un peu de rhum. La texture est agréable et le mélange des saveurs parfait. Si quelqu''un a un truc pour que les pépites ne tombent pas "au fond "...', '2008-10-25T11:15:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, cbfb6754-c2ca-46b4-a223-8717d02d08e7, 'J''ai mis 80 g de beurre, 80 g de sucre, 80 g de chocolat et j''ai fait cuire le cake pendant 45 minutes: c''était délicieux!! Un dessert que je referai souvent.', '2008-09-30T12:22:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, e43abf22-fa73-4299-a28e-759f107de1ed, 'Mon fils me l''a fait pour mon retour du travail. Délicieux. Le pauvre, il va devoir en refaire!', '2008-09-07T20:45:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 38cf6a18-f3f1-49ea-a26b-c477e5839ef6, 'Trop bon! Même sans chocolat (je n''en n''avais pas!).', '2008-09-05T21:09:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, ec8ca066-cc51-45f8-bc81-fcc13e7b8c72, 'Magnifique! Très très bon, j''ai adoré! J''ai utilisé du chocolat pour dessert que j''ai coupé en grosses pépites (une fois le gâteau refroidit le chocolat croquait) ainsi que du sucre roux, faute de sucre traditionnel. Je trouve que le goût de la coco est très prononcé, ce qui est rare dans les gâteaux. Aussi bon chaud que froid.  Je vais le refaire tout de suite, merci beaucoup !', '2008-09-04T22:36:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 6d2550e8-3960-47a9-b861-2b4538fbf2fe, 'Très bon cake! J''y ai ajouté un peu de rhum et l''ai fait cuire 45 minutes. Le meilleur c''est l''odeur divine qui s''en dégage pendant la cuisson !', '2008-08-05T12:03:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 706b2f69-8d0b-4cf5-823b-d9e80d310ef5, 'Super bon! Mon seul regret: on ne sent pas trop le goût du lait de coco. Je l''ai fait cuire beaucoup plus longtemps (2h au moins) mais j''ai un petit four électrique et je suppose qu''il manque de puissance...', '2008-06-15T12:30:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 533d0a16-edf9-423c-81d1-066bc0a1dcdb, 'Ce cake est tout simplement délicieux ! Je recherchais une recette de dessert à base de lait de coco pour utiliser les 20 cl qui me restaient après avoir préparé un curry d''agneau et je n''ai pas été déçue. Je le referai ! ', '2008-04-09T21:18:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, bb39af74-a5d0-4e70-a3bb-995cfd1dfc8e, 'Très bon cake. Je l''ai fait dans des petits moules en silicones. J''ai mis plus de chocolat (nous sommes gourmands dans la famille.) A refaire.', '2007-12-09T17:48:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 5c234c5d-14d9-4b12-a917-8ce53c51550b, 'Merci pour cette recette. Ce gâteau est vraiment délicieux et fondant. Pour l''accompagner, je vous conseille un sorbet à la noix de coco. Un vrai délice...', '2007-06-07T23:50:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 6087cf87-7a89-4b8c-b8f6-ab7840753d20, 'Merci pour cette recette. Les enfants comme les adultes adorent... Délicieux et moelleux mais attention à la cuisson. ', '2007-05-13T22:27:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 002b4b95-d914-4da4-a4fd-8d2dd6950580, 'Bravo, Laurence. C''était très bon. J''ai mis le cake dans des moules à muffins en silicone et j''ai fait cuire 20 minutes, c''était vraiment délicieux. Merci.', '2007-02-11T19:13:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 09ff07a0-b595-446d-ae02-f68ab305ea59, 'Très bonne recette. J''ai cependant diminué un petit peu les doses de sucre et de beurre, mais c''est plus une affaire de goût que de dosage.', '2007-01-17T18:56:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53472, 86c4c112-7167-46b7-ad0d-6692e2528ca3, 'Je n''ai rien changé à la recette et c''est parfait. J''ai eu un cake moelleux et très bon, que demander de plus!', '2007-01-15T18:57:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48659, 383417a5-0889-4c15-ae7b-8af13e48c4ac, 'Recette faite à l''atelier culinaire n°9 "BBQ" de l''ABC de Montreuil-le-Gast Super bon. Bravo de la part de tous.', '2012-06-20T12:05:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48659, 4746122a-dc40-454f-a545-ec2c99580453, 'Très simple et vraiment délicieux !', '2012-01-09T11:13:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54936, b22cf46f-8e2c-47b1-8ef5-813fe2807eff, 'J''ai testée cette recette pour ma famille et ils ont tous adoré ! Je la referai sans hésiter ! Merci pour cette recette simple et efficace !', '2011-09-05T17:01:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59983, 1bbc0861-0757-4874-991d-5edd03cba440, 'Trop bon !!! Très apprécié par toute la famille, idéal pour se remonter le moral les longues journées de pluie.', '2010-11-12T20:06:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59983, cad1413c-51fc-429f-9d11-c40a9b149de0, 'Hmmmm... Vraiment parfait ! Merci Émilie pour ce délicieux moment qu''a été la dégustation !', '2010-05-27T00:47:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84831, 9aa6bc9b-8ee4-4ce2-bbaa-1e79aa9cbe5a, 'Les croustillants sont meilleurs froids que chauds, ils sont moins écœurants.', '2011-11-13T13:57:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18812, 29213e28-a089-4192-9f99-c8973aebd6fc, 'Très bonne recette, simple à réaliser. Néanmoins le blanc d’œuf monté en neige n''est pas forcement nécessaire, à la Réunion il est préférable d''utiliser des mangues josé qui ont plus de goût.', '2015-01-05T15:11:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18812, d3c7e31e-2dd9-40ee-8a5c-89547f97a5c3, 'Très bonne glace mais le goût de la banane est beaucoup plus prononcé que la mangue.', '2007-08-25T20:07:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83420, 6fb61f6e-db46-4b5c-9bc7-86a4b576208d, 'Très bon! J''ai testé la recette le week-end dernier et cela a ravi tous mes invités. Le tiramisu est léger, et non écœurant.  Le seul petit bémol est que les bananes noircissent, malgré un arrosage avec du jus de citron. ', '2009-01-21T13:25:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40337, 37977d69-4285-4d30-bcd6-45a6a12b7a9e, 'Excepté la saveur qui est excellente, nous l''avons tous trouvé trop gélatineux et de couleur peu appétissante. J''ai rajouté un coulis de citron pour la cacher. A essayer avec moins de gélatine et peut-être un peu de colorant alimentaire jaune pour aviver cette couleur grise...', '2008-04-04T20:00:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40337, c2b5cd50-3319-45bf-beae-ac88783de7a2, 'Testée et recomandée : très simple, pratique pour les bananes à l''aspect bronzé. J''ai ajouté le sucre au début.', '2006-11-05T11:10:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335054, 21a08142-443f-46c2-b6cb-d1ef8b7f3c08, 'Je n’ai pas ajouté les rondelles de banane la sauce est suffisante. Bon mais un peu sec .', '2021-03-07T17:45:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335054, 3adc25c8-e877-4cb4-baac-812111be38cf, 'Tout d''abord, je n''ai pas ajouté les tranches de bananes dans les samossas. J''ai fait uniquement la première partie. Le bilan est très positif. C''est très bon. Le jour 1 on sent bien le chocolat, le jour 2 on a plus le goût coco en bouche. C''est top. Merci pour cette idée originale d''accommoder des feuilles de brick.', '2019-02-21T17:00:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194818, ed5aef4b-3bf3-404f-afd9-ccb6d267041b, 'Je n''avais pas de kiwi à ma disposition, j''ai remplacé par un abricot, je n''ai pas mis de menthe ni de cannelle (nous ne sommes pas fans). Bonne compote, le goût vanillé est bien agréable. Toutefois, attention aux pommes elles-mêmes, si elles sont bien sucrées naturellement, il faudra modifier la quantité de sucre. Merci.', '2019-08-09T09:06:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194818, 6ac708cc-3774-4ead-8a73-c840633860b7, 'Je conseille vivement cette recette ! Par contre je n''ai pas mis la cuillère à soupe de sucre, je me suis contentée du sucre vanillé et c''était parfait.', '2016-12-23T11:34:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194818, a5bd4786-03bc-44f7-8722-05d24b52ff7a, 'Excellente compote. Les petits comme les grands de régalent ! Ayant un enfant diabétique je n''ajoute pas de sucre les fruits de suffisent à eux même et je mets de l''arôme de vanille à la place du sucre vanillé. Merci pour cette recette. ', '2013-11-04T14:44:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194818, d645322a-e34b-468e-9a2d-c308c91d010b, 'Excellent bonne recette !', '2023-01-23T12:04:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194818, 40647f71-6d5b-40ae-a695-118718e11435, 'Sucre roux à la place du sucre. C''est excellent. ', '2021-04-10T23:06:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194818, f08aedb0-84a1-4f46-9f69-b917d28dda8f, 'Très bonne ! Avec une gousse de vanille à la place du sucre vanillé. Ça a été suffisant pour 4 adultes.', '2016-04-11T22:21:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194818, 4684c6e8-9ed9-40a2-bfb2-d8d5e1454b1e, 'Je viens de tester la recette car j''avais des pommes et kiwis un peu défraîchis. Je l''ai donc faite sans bananes, sans sucre et sans miel. J''ai juste ajouté de l''arôme de vanille et c''est parfait ! Le sucre naturel des fruits se suffit largement à lui-même ! C''est simple, rapide et efficace, merci. ', '2016-02-10T18:59:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194818, b3a01ccc-fe6a-4720-8b84-afd5d9859159, 'Délicieux, la prochaine fois essayer sans sucre et grosse cuillère de miel.', '2014-11-11T16:34:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194818, 71245411-21d2-4c9c-8370-59005b47eb43, 'Très bonne recette !', '2014-05-27T01:02:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194818, 6e055f40-bf0c-4645-a448-ae2c0c2f31b2, 'Bonne recette de compote mais la prochaine fois, je retenterai avec un kiwi de moins.', '2013-12-21T14:39:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194818, 6a6a4fa8-216b-40e8-a559-04774e87dd3e, 'Super bon ! J''ai changé les dises selon ce que j''avais, à savoir deux pommes, deux kiwis et deux bananes en fin de vie. J''ai ajouté une bonne cuillère de miel (j''adore). J''ai suivi la recette sauf que je n''ai pas mis de citron, ni de menthe et c''est délicieux ! ', '2013-05-27T23:26:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (194818, feb255e6-d52b-4693-be97-25a815e99541, 'Très bonne recette ! Je la refais régulièrement.', '2012-11-08T10:21:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, 2cee9ac2-06e1-4681-8cd5-964049316e31, 'Déçu par le goût.  Je m''attendais à ce que ce soit plus frais...', '2022-06-11T22:18:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, f4acbe0a-c428-4c21-8734-af4989d2683b, 'Rapide à faire et excellente, je suggère plus de framboises ?', '2021-02-09T21:09:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, b5a72bfe-1e44-405d-8bd3-db936f2c9ce8, 'Petite version végétalienne : remplacer le yaourt par du yaourt végétal à la coco, et du lait de soja à la place du lait de vache. Un délice !!!! ', '2020-12-12T12:21:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, b6131a56-8091-4de0-89b2-aa77745317b3, 'Trop trop bon', '2020-11-01T16:13:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, b16d9123-2d07-418b-9e3d-76b76522e728, 'Trop bon ces smoothies !', '2020-01-26T12:52:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, 472435c6-a05b-4fca-89b8-04baf93f4153, 'Très bon. Très frais. Pour ma part, 2 poignées de framboise, pas de sucre, pas de lait et un yaourt bulgare. Merci pour cette recette bien utile quand les bananes mûrissent trop vite.', '2016-01-18T13:39:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, 4d4655e5-399e-4189-bf6e-eecd59a02854, 'Un régal ! Simple et rapide à la fois; à refaire !', '2015-07-10T18:47:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, 02f32c17-cff3-4ccb-8662-bb3da782e135, 'C''est trop bon', '2014-09-14T13:44:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, c30f9541-14ea-497c-9665-6d02c8fd4b6f, 'Recette simple et efficace. Pour ma part je n''ai pas rajouté de sucre, c''était très bon.', '2014-04-27T23:04:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, 6f5d2b1f-2257-4446-a8b9-380497fe2d8f, 'J''ai adoré, au lieu de mettre du sucre j''ai remplacé le yaourt nature pas un yaourt sucré ça suffit largement j''ai aussi mis trois glaçon et pour les pépins de framboises je l''ai passé au chinois ! ', '2014-04-27T18:30:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, 9c50998f-b32c-4ddc-b9d4-f57f91c9d8b1, 'Nous avons adoré ! Avec des framboises congelées, j''ai ajouté quelques glaçons... Une cuillère à soupe de sucre suffit, pour un côté pas trop sucré,  juste les petites graines des framboises peuvent déranger... Un bon dessert plein de fraîcheur dont les enfants raffolent.', '2014-03-22T11:06:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, fbafb275-b973-4669-be92-871dae4ba038, 'J''ai été un peu déçue par ce 1er smoothie.', '2009-04-01T16:04:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63970, 9eed5491-23ed-4d56-95ba-11b3aafced9e, 'Délicieux et léger. Le goût de la framboise n''est pas trop couvert par la banane. J''ajoute toutefois un peu de lait de coco en diminuant la quantité de lait.', '2008-10-22T23:10:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, e158e930-22af-43c1-a67b-01001dffc430, 'Il faut mettre un sachet complet de levure, sinon ça ne va pas monter.', '2023-12-09T18:00:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 96d3bc50-9e77-43e7-8804-73dce795ff3d, 'ce gâteau est délicieux, vite fait et idéal quand on a des bananes trop mûres. Mes enfants adorent et moi aussi.', '2022-02-27T16:14:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, b0aee428-96ab-448c-8dca-fc7c9864ec80, 'Mon cake reste mou et n’a pas un bon goût, j’ai fini par le jeter! Je ne comprends pas pourquoi, j’ai suivi la recette. ', '2021-04-04T17:35:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 0bbb81e1-46a5-40a8-8d9b-5cfa775d78e3, 'Très très bonne recette. Réalisée 2 fois et à chaque fois un vrai succès. Cuit comme indiqué 45min à 180° four traditionnel, il ne faut pas utiliser de chaleur tournante pour un cake. Recette idéale pour utiliser les bananes trop mûres pour être mangées.', '2021-03-27T10:21:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, d58d0309-48cf-430d-9f69-3a7b425ced04, 'Délicieux ! Merci pour cette recette.', '2023-10-26T21:44:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 081d878a-15f3-4b6b-85d4-9585312fc52f, 'Excellente recette, gateau moelleux et délicieux. 80g de sucre avec 3 bananes bien mures suffisent largement, un peu de sirop d''érable, 3/4 de paquet de levure. 45 min de cuisson texture parfaite !', '2023-10-17T22:45:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, dbd73384-7913-4f08-b728-0f7942b7cd45, 'Fait le week-end dernier, en ayant modifié quelques choses, et c''était un délice! Je n''ai mis que 70g de cassonade, ajouté du sirop d''érable pour relever le goût de bananes, 2 cuillère à soupe de rhum vieux, et des noix de pécan pour ajouter un peu de texture, c''était à tomber! Merci beaucoup pour cette bonne base, je m''en resservirai!', '2022-03-28T22:18:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, d8adb6ca-b6e1-46a1-a059-d41275159d79, 'Du grand n''importe quoi... Cake pas cuit meme après 2 heures pourtant respect scrupuleux de la recette de A à Z', '2021-02-14T22:51:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 28a7de8f-1165-408b-8b5e-9eabd8c60a09, 'Superbe recette. J''ai mis un sachet de levure entier et rajouté des cerises cueillies dans mon jardin et c''est super bon.', '2019-05-22T07:52:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, b55bc91d-4dc8-4a1e-a059-36a96874b5c9, 'Recette simplissime et délicieuse. J''use et abuse des copeaux ou pépites de chocolat. Je recommande vivement cette recette ! Faite à ce jour 4 fois, 4 réussites et tout le monde aime !', '2023-10-23T18:07:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 3d93c271-2e58-45c8-81d0-896b6a158e61, 'J’ai testé c’est super j’avais ajouté des pépites de chocolat et un vrai délice! 

Par contre j’avais tellement adoré la recette que j’ai réalisé exactement la même mais cette fois avec des pommes et un grain de cannelle et un vrai délice ', '2023-10-01T08:46:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22822, 395ad6fb-51b4-4e57-a86f-c4cefc697d1d, 'Simple, moelleux. Tout simplement délicieux !

