INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28413, 7ba9f0f6-d49f-47ef-b565-57d5503e2cbf, 'J''adore, j''ai rajouté un peu de farine car à mon goût la pâte était un peu trop liquide. Bon appétit ! ?', '2020-11-20T13:35:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28413, 24edc349-f1df-4a8f-b9ac-a66873b24d12, 'Super bon. J''ai ajouté du grand marier pour un peu plus de goût.', '2016-02-24T18:57:27+01:00');
