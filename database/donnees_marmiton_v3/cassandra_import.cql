INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, c5ab6d73-5b58-40f6-96b3-4d5f2359eb55, 'Rapide et efficace. On s''est régalé. La prochaine fois j''augmenterai juste un peu les doses.', '2017-09-28T04:08:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 8bf84f3c-966e-4036-9180-057fe29b107a, 'Parfait mais sans le citron. Tout le monde a adoré.', '2017-08-27T22:45:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, b5b25493-6b59-4a96-9bcd-66e90e7ec374, 'Je me suis lancée, adoptée ! Depuis on déguste plus de poisson à la maison, Merci ! ', '2017-08-06T14:56:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, b1f36df3-1b95-45f3-9eb4-8c7f5522d4f0, 'Très bonne sauce!', '2017-05-22T22:26:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, efe490e2-e81b-4080-abf9-0c8e87b7822d, 'Très bonne sauce, juste un peu liquide.  Mais le goût est là ! ', '2017-04-24T15:09:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 8f6064ce-81ee-4bfc-b2ed-36280fe33847, 'Super recette ! Moi qui suis amatrice de poisson avec de la sauce au beurre blanc je me suis régalée ! Cependant il ne faut pas la préparer trop tôt sinon elle s''épaissit... En suivant les commentaires, j''ai mis très peu de citron et  j''ai rajouté de la farine car la sauce est trop liquide, attention à pas trop en mettre sinon elle s''épaissit et ça a la texture d''une pâte (c''est ce qui m''est arrivé...). Je la referai sans hésiter en mettant moins de farine ce coup-ci', '2017-04-20T12:08:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, a10119f6-aaf4-48b4-9297-58f35f138cf3, 'Excellent et facile à faire ', '2017-03-17T20:09:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 062e8804-0316-4e33-988c-67451a0d376d, 'Inratable.', '2016-11-27T18:19:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 77927e4e-e0c2-4690-84e0-9fc2b660d7da, 'Excellente sauce ! Elle est vraiment simple à réaliser, et a fait l''unanimité au dîner. Pour ma part j''ai ajouté un peu d''aneth et de ciboulette !', '2016-11-01T22:33:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 04213dd5-8a97-4c80-8379-1c1b98c1cf0c, 'La sauce beurre blanc ne contient pas de citron elle ne doit pas être trop acide pour garder le goût du beurre et salé si possible. ', '2016-10-30T22:48:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, ce9f9bc0-2bba-4a1b-af4c-b16d9f642583, 'Très bonne sauce !!', '2016-02-03T20:45:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, f0e750bd-6827-4ab4-b71e-fb6efb61f9d3, 'Excellent et facile à faire !!', '2016-01-26T19:35:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, ff8e878f-f2aa-4401-9e58-62986e4533ac, 'Très bonne sauce !', '2016-01-19T21:34:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23052, 827e800f-a5d0-45f6-8e1c-cdb587f58a0f, 'Juste parfait, tout le monde s''est régalé ! ', '2019-03-22T05:08:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23052, dd2c2ac7-2122-495f-b162-def37aa618e0, 'Accompagné avec du riz noir cuit 18mn et poêlé avec tomates coupées en quartier et parmesan râpé.', '2019-01-20T11:29:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23052, 1c1fb1ab-ba4a-4f3c-81ce-11173f0658bf, 'Très facile à réaliser et succulent, j''ajoute juste un petit verre de bouillon de légumes dans la béchamel.', '2012-10-23T17:17:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23052, 09393aa6-f8b6-40f9-a24e-88643e45a09b, 'C''est délicieux! Je l''ai servi en entrée dans des petits plats à gratin individuels pour une jolie présentation. Merci.', '2008-12-27T14:19:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23052, fac9784f-9ef9-4cc8-8f27-5bd359f27acf, 'Super bon, je le sers en plat principal ou entrée quand j''ai des invités. Je mets des pétoncles surgelés et de la chapelure pour gratiner. Par contre je préfère une béchamel assez liquide', '2008-02-25T13:58:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55375, 5522b4e8-0feb-4f62-a120-2a0ba9e210e2, 'C''est bon ! A défaut de pesto d''aubergine j''ai aussi mis du pesto de poivrons. Par contre la prochaine fois je vide un peu les tomates parce que ça a fait beaucoup de jus.', '2011-01-12T11:40:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55375, 89966535-df64-4fc5-9c78-86b37b71669e, 'Très bonne recette, je n''avais ni courgettes ni pesto, donc j''ai fait sans, j''ai juste mis à la place un peu de poivron rouge frais et c''était extra ! Merci.', '2011-07-15T15:58:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55375, 760e9e91-569a-4945-b664-bd8234bb42da, 'Très simple à préparer et cela a fait son effet. J''ai remplacé le pesto aux aubergines par un pesto aux poivrons, avec cette jolie couleur orangée, encore plus envie d''y goûter.', '2010-09-30T00:47:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55375, fea37e91-1943-4346-a590-fc241c23c814, 'Super, la sauce relève agréablement le poisson', '2010-03-21T19:08:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55375, 63d0ce26-c838-4c7b-9130-2e38abaa882d, 'Un délice, délice, délice, c''est tout ce que je peux dire. Mon mari qui n''aime pas le poisson c''est régalé. Merci beaucoup pour cette recette très simple.', '2010-02-01T11:24:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55375, a807e5b6-5308-471b-8fac-0a0191a94ad9, 'Tout simplement bon !!  C''est bon, c''est facile et rapide à préparer. Les enfants ont adoré la sauce tomates/courgettes et le pesto donne une très bon goût au poisson. Un grand merci pour cette recette', '2009-11-26T19:55:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55375, 2f668e33-9e8e-40ce-8630-2907a580a34b, 'C''était fabuleux !', '2009-10-08T21:20:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55375, 903e2af9-54ab-451e-b38f-8e5d2d67da63, 'Recette vraiment délicieuse et rapide. Effectivement, il manque le début de ma recette mais on se débrouille! J''ai utilisé un mélange de pesto et de sauce à l''aubergine et au poivron faute de pesto à l''aubergine grillée et c''était excellent.', '2009-09-04T16:27:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55375, e19663a8-1167-4424-92fc-86d03ac2eefd, 'Recette délicieuse, facile... Que demander de plus ? Avec un bon vin blanc c''est un délice ! ', '2009-09-02T22:59:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55375, 8995c9f4-e23b-4433-a560-d7a03ac217a4, 'Délicieuse recette. Enfin un poisson en papillote avec assez de sauce pour le riz. Par contre il manque le début de la recette, je pense qu''il faut faire revenir oignon et ail dans une casserole avec un peu d''huile d''olive, puis ajouter courgettes, tomates et pesto. A refaire', '2009-03-23T16:55:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 9ea66bdd-7c7e-4183-8e9e-80564b88bd8a, 'J''ai beaucoup aimé cette recette. 
J''ai mis des carottes champignons courgettes oignons persil avec le poisson.
Servi avec de la semoule il y a pas mal de sauce ( j''ai utilisé une brique de crème liquide)', '2021-03-10T20:56:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 9208240e-70b3-46d4-8107-7f33a5038780, 'Génial ! J''ai également rajouté un demi citron et j''ai remplacé les cornichons par des câpres . Un délice . À la fin j''ai rajouté dans mon plat un reste de brocolis et carottes cuits vapeur et servi le tout avec du riz.', '2020-04-04T23:24:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, b49f686f-dbed-469c-b063-b6ccff525b87, 'Très bon mais pour des gourmands comme nous deux, il faut augmenter les proportions de la sauce sans trop augmenter la moutarde. Je referai certainement.', '2012-12-25T16:35:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, b79190b5-dd03-49eb-b0da-9fa2edfe0da8, 'Cette recette est hyper rapide et simple à préparer. Le poisson est moelleux et très bon. A refaire très vite !', '2011-08-29T01:15:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 7c217a28-a24f-48b3-80d1-15e7c122ad83, 'Parfait, rapide, très bonne recette. ', '2021-06-04T10:42:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, b6fb44ea-5a94-49df-a141-f1bc23662463, 'Parfait vite cuisiné et très bon', '2021-03-21T21:50:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, aee8dbb7-6cdd-408a-a60e-e05c3a89d073, 'Toute la famille adore cette recette. Je la refait souvent', '2020-09-30T23:42:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, e58a0007-3923-4170-9dcc-8f2486d07cc0, 'formidable recette délicieux et tellement facile', '2020-07-27T22:50:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 3f9540b3-f8a9-4dd1-9a02-8a4858921931, 'Très simple et très bon !
Pour moi, 2 fois 8 minutes suffisent (au lieu de 2 fois 10 minutes).', '2019-10-08T12:44:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, a5a99607-8846-4a3a-8a87-fa6b5c765ab7, 'Délicieux et trop facile à faire!', '2018-12-24T04:22:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, a48f301a-1154-435b-b9c2-b9c652249984, 'Très simple et très bon! J''en refais régulièrement.', '2018-11-24T09:29:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 603efaf1-d87e-4869-a798-5005d89eaddd, 'Vraiment très bien, facile et super rapide les enfants ont adorés ils ont fini par lécher le plat !', '2018-06-26T09:00:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, fa0ec10f-a8ef-4ad5-a595-f9988c4c5dc2, 'C''était très bon mais le temps annoncé en début de recette ne correspond pas au temps réel qui est mis dans le déroulement de la recette : 7 min au lieu des 20 que l''on passe cuisson comprise.', '2017-09-09T13:38:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 3e644940-fd28-443d-b69b-084963eae5bf, 'Très bon ', '2017-07-29T18:33:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 8e04bc11-ca71-4b3c-be0d-67e878085b0c, 'Excellente recette, facile et rapide à réaliser et le bonus c''est faible en calories.', '2017-04-02T23:12:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, e5c54bcf-cb30-4746-85cc-8c2223ea81a2, 'Super recette, rapide et délicieuse! Le goût est encore meilleur avec de la moutarde à l''ancienne ! J''ai suivi les commentaires en mettant une cuillère et demi de moutarde et une briquette entière de crème liquide (car sinon il y a vraiment peu de sauce).', '2017-03-06T12:15:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 1a218c05-3b9b-469c-bcea-a497edecf196, 'Hyper facile et très bon, je l''ai fait avec du lieu noir, je pense le faire avec un poisson qui a un peu moins de goût', '2016-08-01T12:03:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 727248b4-f81f-4f9a-8182-55ac4c099faf, 'Très facile et délicieux j''ai juste ajouté un demi jus de citron un délice j''en referai.', '2016-07-13T19:18:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 4dceb823-b3a3-494e-9706-d589a5b5b81b, 'Excellente recette que je fais très régulièrement !!', '2015-11-30T20:24:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, a667527f-c1ee-403f-a26d-4c44ca4c4fd2, 'Très facile et rapide. J''ai testé cette recette : c''est un délice. J''ai mis de la moutarde à l''ancienne. Je la referai c''est sûr !', '2015-03-03T10:34:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, aa3aa510-5875-47f8-bc90-5f1604cf1c91, 'C''était super bon et très facile à préparer...', '2014-01-15T18:55:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 49a5d437-a260-40ac-b8d1-309be66c4fe1, 'Excellent !!!  Avec du riz basmati... Un régal ', '2013-12-12T20:40:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 17bd1390-a207-4e33-9b4c-84e7802b0658, 'Très bon !', '2013-11-17T21:33:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 79f4828c-ae0c-4fa8-b197-5eb936f56231, 'vraiment très bon. Le poisson est bien relevé, pas trop fort, adultes comme enfants, tout le monde en mange. Bonne recette, rapide et facile, à refaire.', '2012-11-11T15:41:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 7dfcf4a5-7d80-4f12-a96e-118bcd121635, 'Rapide, simple, delicieux !', '2012-10-14T20:23:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 3f14a601-8cbb-4e51-84a6-da2458a476fa, 'Super ! Mais j''ai quand même mis moins de moutarde et j''ai ajouté de l''aneth. Facile à faire.', '2012-09-29T16:46:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 779d20bc-9d9a-43bc-bf07-335df6e0b20a, 'J''adore le poisson mais n''aime pas vraiment le cuisiner...me voici réconciliée ! Cette recette est facile, originale et très goûteuse. Avec de la moutarde à l''ancienne, c''est un délice. Merci pour cette idée !', '2012-03-24T19:12:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 44b0c0a0-2094-4ef6-bbb5-550d94d232e7, 'excellent ! mais j''ai quand même mis moins de moutarde. À refaire!', '2012-03-19T21:36:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 5826fe7c-237d-4de2-9dff-4c39971b9b0c, 'Trop bon, un délice. Génial mélange de saveurs intenses !', '2011-11-05T23:23:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, df67ccba-d24b-4020-860a-6788e626ce09, 'Bonne recette, je me suis contentée d''une cuillère à soupe de moutarde pour deux de crème, et c''était suffisamment relevé. J''ai ajouté de la coriandre en plus.', '2011-10-08T16:42:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 3ecc7c0d-ad0c-476d-9dc7-e1c9bab38c13, 'Même avec de la moutarde à l''ancienne nous avons trouvé cela trop fort en gout surtout en acidité.', '2011-06-06T13:46:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 76d1c7b6-f3e4-4be3-9ddc-e3db662281fe, 'Très bon ! J''ai mis davantage de crème fraîche pour ménager les papilles de ma puce de 4 ans et tout a été mangé ! Servi avec du quinoa. Comme poisson, j''ai utilisé un basique : le carré de cabillaud surgelé et ça a été très bien', '2011-05-30T22:08:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 3e96dc36-2241-4c10-8f45-fdfa3e95976a, 'Délicieux avec des pommes de terre vapeur! Idéal pour les filets de perche!', '2011-03-18T19:39:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 5f8ad24b-40d3-4101-9bd3-c8a6219f32d9, 'Trop facile à faire... et très bon à déguster !!!', '2010-03-10T20:21:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 1aca8045-586c-4667-a432-8da3ad2c174c, 'J''ai précuit les filets congelés au court bouillon, j''ai allongé la crème fraîche liquide légère avec de l''eau, les cornichons se marient très bien. 10 mn suffisent... simple, rapide et bon   ', '2010-03-07T16:31:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, a3d76883-a5a2-4145-b2c9-c8dea778fbff, 'Recette facile et délicieuse je l''ai faite sans rien changer. Merci', '2010-02-27T22:29:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, f9bfd3f3-9c88-4a3b-bf7e-1c3dce57be69, 'J''ai trouvé cette recette très bonne, originale, rapide et très facile à faire. Par contre, j''ai mis de la crème fraiche épaisse 30% MG.', '2009-11-30T22:50:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, ecf4707b-92e4-420a-a8e2-5a4ffa306515, 'C''est parfait, j''ai complété la crème fraîche par un pot de fromage blanc pour avoir un plus de crème.', '2009-05-01T22:37:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 8335765f-4c0c-4147-b379-63628db110ea, 'Une recette aussi rapide qu''excellente (même sans cornichon). Possibilité de remplacer la crème fraîche par une crème à cuisiner à base de soja (sans cholestérol)et de rajouter un soupçon de raifort...', '2009-03-01T18:37:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, e06cd8cf-9f1e-4777-88a4-b1dbfda27842, 'Recette très facile à faire et pas chère du tout!!', '2009-02-15T19:41:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, e79d7e2c-e08d-439d-8ed2-6efa103ad201, 'Très simple et rapide à faire. Mon copain qui est un peu difficile a adoré. Merci !!!', '2008-12-02T11:43:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 4021e1b9-bc69-4069-b2ed-2f8d8ed3abab, 'Moutarde à l''ancienne et crème allégée. Comme les autres marmitons, j''ai doublé la quantité de crème et ajouté un peu d''eau pour avoir de la sauce. Ainsi préparé, ce plat mérite 5/5. Facile, rapide et très bon.', '2008-08-11T16:27:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 8f047462-11b8-4802-a974-ed9192f6abc9, 'Je mets plutôt 20 cl de crème fraîche légère (ainsi, il y a plus de sauce...)et des câpres et j''accompagne d''un riz aux petits légumes. A chaque fois, mon mari et mes enfants se régalent!!! ', '2008-07-09T18:28:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 2961accd-4ae4-4e1f-8b82-48b21651adc0, 'Moutarde à l''ancienne, doubler la crème et en cours de cuisson arroser 2 ou 3 fois avec un peu de fond de poisson délayé dans 3 cuillères à soupe d''eau. Très bonne sauce avec un plat de pomme de terre. A refaire également avec du riz!', '2008-04-25T19:16:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 889607d5-36aa-4656-9423-1a45848b9d1f, 'Super, la famille a adoré surtout mon chéri qui s''est resservi deux fois. Par contre, je mettrais un chouia moins de moutarde la prochaine fois sinon rien à redire! et tellement facile!', '2008-04-25T12:12:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, efcb9b4e-e7d7-4f04-9633-eada3f809ff3, 'Bien bon, mais ne pas hésiter à doubler la quantité de crème pour que ce ne soit pas trop sec.', '2008-01-29T17:09:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 1b3019c4-0310-4ad1-9f2e-4b5824730043, 'Moi j''ai cuit le poisson à la poële, j''ai démaré avec des tomates concassées, mis le poisson dessus, et 10 minutes avant la fin de cuisson, mélange moutarde, crème, cornichons, hummmm! Merci pour cette recette!', '2007-11-30T12:17:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 8b8acf39-f57d-48e3-94ee-428b484f778c, 'Merci pour la recette !! Vite faite, à peine 20 minutes, j ai utilisé des filets de merlu congelés, je ne les ai même pas faits décongeler. Tout le monde a adoré, surtout les enfants qui ont avalé cela d un trait. A renouveler pour un repas en semaine...', '2007-10-11T15:10:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, a77b51f5-e3a3-4136-be7a-9e36636b5df1, 'J''ai suivi le conseil de laure, j''ai fait cuire le poisson (filet de Perche du Nil) sur un lit de tomates...un régal !!!', '2007-06-06T22:12:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, a3aba763-203d-4413-9497-2e6aea931eda, 'Impec''! J''ai accompagné d''une poêlée de tagliatelles de courgettes avec crevettes! Rapide à faire !', '2007-05-12T22:25:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 1e5c7880-4e9a-48f5-93cc-44b70dbb9ecc, 'C''est bon même sans les cornichons, il faut juste faire attention à ne pas trop saler.', '2007-05-10T13:02:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, ec879ce5-6e14-4ab4-a269-c74b419a1fe1, 'Un peu déçue!!! Je m''attendais à mieux, le croquant des cornichons même hachés, c''est sans plus... Mon chéri a bien aimé donc je mets 3 sinon j''aurais mis moins....', '2007-03-07T11:41:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 900d7561-eb87-41af-8301-646e7abb904f, 'Nous avons beaucoup aimé. Une nouvelle façon de manger du poisson bien agréable. Merci !', '2007-02-26T19:57:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 6ef176d1-de86-4ed3-877f-4b0e007f4266, 'Très bon, j''ai rajouté du vin blanc dans la sauce et saupoudré de fromage râpé : à essayer !!', '2007-01-27T21:00:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, f6a4e188-314b-450d-b4cc-5e5b6b064567, 'J''ai suivi le conseil de Sylvie et j''ai réalisé cette recette que nous avons tous beaucoup aimé. La sauce va divinement bien avec le poisson (des filets de cabillaud pour moi, mais je pense que l''on peut adapter avec d''autres poissons blancs sans souci...) et c''est original. Un grand succès chez nous! Merci pour cette recette!', '2007-01-21T16:06:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, aca1071c-4ddd-48b5-9924-7ed1cb7ebf0b, 'Excellent. J''ai suivi les conseils précédents en mettant plus de crème fraîche, mais allégée (c''est sensé être une recette minceur après tout lol), en choisissant une moutarde à l''ancienne et en mettant les soles sur un fond de tomates entières découpées plutôt que du beurre. Simple, rapide et délicieux!', '2007-01-17T19:00:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 34e8cdeb-ae47-4424-a918-239bd05fff0e, 'Très, très bon. Les cornichons donnent un goût succulent à la sauce. A faire et à refaire. Merci!', '2007-01-15T10:23:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 78783477-cd20-4bf3-a8e2-5c4439565c08, 'La sauce est délicieuse et se marie à merveille avec le poisson.', '2006-10-20T22:38:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, 0dea6ca8-4f2b-4e96-a82e-516a058652f6, 'Excellent et rapide, je fais très régulièrement cette recette avec toute sorte de poisson, rien à redire.', '2006-08-24T19:25:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20476, f0896c4c-a6ae-4d78-b4ac-0fd04f6a1cf7, 'Moi je n''ai vraiment pas aimé, mais ma copine a trouvé ca bon... Bref, la moutarde cache le goût du poisson et c''est assez sans interêt... Sauf pour ceux qui aiment beaucoup la moutarde.', '2006-08-19T17:39:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71092, 86f80285-de17-43cd-82cf-f4cc60cf5458, 'Un délice, léger et frais pour l été ', '2023-10-20T12:01:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71092, 6d99c985-70a3-4d46-8828-6645ed77f0cc, 'Trop bon, je recommande', '2019-07-06T06:26:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71092, a5964c9c-a9a8-484c-91c7-e6614634bad2, 'Délicieux ! Recette super rapide ! On s''est régalé ', '2019-05-14T08:28:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71092, c271b5f9-9718-4028-a1ac-b9c9286b57b4, 'Super bon. J''ai juste remplacé la crème par du chèvre frais avec de la ciboulette mais sans Tabasco. À refaire encore et encore', '2019-03-15T11:22:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71092, d4332890-4aab-47b9-99fd-1a503498400d, 'Excellent.', '2019-03-08T08:23:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71092, f5587787-b578-4b2f-978e-0be8740cd082, 'Simple et très bon. Fait pour 4 en rajoutant de la moutarde à la sauce et un zeste de curry (pas de tabasco). Tout le monde a adoré :)', '2014-09-19T12:44:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71092, c3811585-53f8-4501-b7a9-0602a448a0a2, 'Frais, gourmand et facile pour les amateurs de saumon fumé, se décline aussi bien en apéro ou buffet ou pic nique... J''ai déjà utilisé cette recette plusieurs fois. Je les fais avec les petits pains tout prêts que l''on cuit chez soi au four, je trouve ça plus chic et meilleur que les pains à burgers. Je n''ai pas testé mais ça doit être idéal sur des bagels !', '2011-08-21T22:24:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71092, 6bf2933c-c54e-498e-9c2b-99e51fdf6a0f, 'Je l''ai testé, mais sous forme de croque monsieur, c''est sympa aussi.', '2009-09-24T22:00:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71092, 83424729-c0d8-43f4-8333-fa282b9ea3b6, 'Trop bon! J''ai ajouté de la moutarde, ça relève un peu le goût du saumon, un classique de la maison maintenant. Merci!', '2008-06-24T18:29:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83749, ff17e4f5-fb3d-4671-b405-0b192fbdf6b8, 'Je m’attendais pas à ce que ce soit aussi bon et rapide à faire ! J’ai mis de la maïzena à la place du pain et j’ai laissé mijoter 5min de plus. Ça a épaissi la soupe et il n y a aucun goût de farine, un régal !', '2021-02-15T00:33:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83749, 51223a3e-b82e-4c2e-bd10-5832cd7955ed, 'C''est vraiment une recette top, à faire et à refaire avec les moyens du bord ! Je mets 1 cube de bouillon de légumes et je ne rajoute pas de pain directement dans la soupe.', '2020-03-30T19:20:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83749, cc9a2ea2-4104-47d5-8306-654f49939ea8, 'Je n''avais pas de persil, même sans ça la soupe est délicieuse ! ', '2022-12-26T17:44:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83749, 32e45067-f147-42e5-a5ab-d29d6bc73365, 'Excellent ! Même mon mari qui n''est pas fan de champignons, a trouvé ça succulent. Nos enfants aussi d''ailleurs ! J''ai servi ce velouté avec quelques croutons à l''ail. A refaire sans hésitation !', '2011-06-16T18:30:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83749, 570f39af-9a5f-4ab1-b5e2-a37fba739d71, 'Excellent j''aime cette recette', '2020-03-23T14:36:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83749, 4b807950-7c7a-4104-a75d-a231ff569c0b, 'Recette super simple à réaliser et très rapide. Délicieux même avec les champignons en boîte les moins chers. Mais bien plus savoureux qu''une soupe en boîte ! Personnellement j''ai ajouté un peu de poivre noir au moulin et c''est un délice.', '2015-04-18T20:12:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83749, 4d10f1c5-5370-4896-a120-53b5fa3ff7cd, 'Vraiment très bon !!!! Même ma fille qui n''aime pas les champignons a aimé et pourtant elle n''est pas facile la miss. J''ai fait cette recette avec des champignons frais, et je n''ai pas mis le cub or ni le bouillon de bœuf car je n''en avais pas mais du 1 bouillon de volaille c''était vraiment très très bon. En plus cela permet d''utiliser le pain dur c''est génial. La prochaine fois j''essais avec les champignons en boite !', '2014-01-27T11:32:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83749, 38e19048-5e09-47a5-929c-2e8c2a24ff6f, 'Bien, surtout pour un potage en dépannage et pour utiliser les restes de pain.', '2012-06-14T11:47:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83749, c7663980-f7f3-48f9-85f3-ef2755af4bed, 'Merci pour la recette, peu chère et vraiment savoureuse, entre autre, c''est très rapide à faire. On ne voit pas qu''on utilise des champignons en boite; à essayer d''urgence, je la recommande', '2010-12-16T09:14:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83749, bad835ff-4c1d-403a-9dfe-f64768cd3294, 'Recette facile et rapide. Résultat: une soupe onctueuse avec le bon goût du champignon. Un délice !', '2010-11-27T16:35:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17271, 5d97493d-18ba-435f-a27c-c29584966111, 'Tout le monde a adoré!! Recette suivie à la lettre, même les enfants ont tout mangé et réclamé de la sauce!! Parfait avec de la semoule.', '2016-03-04T18:31:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17271, ee61d0a3-91a1-4b42-a20d-925999466851, 'Superbe recette. Sauce délicieuse. Tout le monde s''est régalé. ', '2014-05-05T13:58:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17271, 4ad25484-937f-4ce8-8454-10d1ff36261d, 'Très bon. Je referai.', '2014-01-30T14:04:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17271, 45512a0e-5ae7-46c8-aee2-8bddaa8f1c05, 'Délicieux rapide et d''une grande facilité. j''ai pris des filets de merlan, grâce au gruyère, le poisson reste tendre et ne dessèche pas. A refaire sans modération.', '2013-05-10T19:34:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17271, 7e0e4cf4-218f-4422-a1ff-099a08f8aa39, 'Pas mal du tout et si simple à faire!', '2009-01-31T16:16:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17271, be723f43-f7cf-4445-8024-158e636d34fe, 'La recette est exquise, mais je n''aurais pas dû employer ce "nouveau poisson" appellé "claresse". Il est beaucoup trop pâteux.', '2008-09-09T13:44:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17271, ec0e13ec-2efd-427d-ad8a-a2addbf29651, 'J''ai fait ce plat avec 10 filets de cabillaud. J''ai mélangé un peu plus de la moitié d''un grand pot de crème fraîche épaisse avec la boîte de bisque de homard et j''ai ajouté très peu d''eau. C''est vraiment très bon. Je dois donner la recette!', '2008-08-04T21:00:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17271, 95e3f33a-dc84-46b1-92ba-5b3f8ef758a2, 'Excellent ! J''utilise des filets de merlan, la noisette de beurre et le gruyère rendent le poisson particulièrement tendre! Moins gras : je dépose juste une cuillérée à soupe de sauce sur chaque filet. J''ai accompagné cette recette d''un ramequin de riz et d''un duo de haricots verts et blancs. Tous mes invités ont adoré!', '2006-03-09T01:50:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17271, 76b9aaea-a2df-496f-8c2e-48b8ac4e1ad4, 'Délicieux, facile et rapide! Diminuer la quantité de crème mais par contre ne pas hésiter pour la bisque!', '2005-11-29T11:21:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17271, e241fd61-a56c-4c31-ade4-46ae836c1201, 'Excellent et rapide. Je recommande d''accompagner ce plat de riz sauvage.', '2005-11-26T01:13:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17271, f6279ae9-dd94-4c0f-b243-ddb6cfb80074, 'Excellent, plat très apprécié de mes invités. J''ai ajouté un peu de whisky dans la sauce. Très facile à réaliser.', '2005-05-10T10:01:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17271, 98f2cfe9-79d9-42fc-a78e-63369c40c6b8, 'Ce n''était pas vraiment mauvais, mais pas franchement bon non plus. Ca tient peut-être à la marque de la bisque... Celle que j''avais utilisée et la crème rendaient le tout fort lourd et passablement écoeurant...', '2004-05-26T08:51:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17271, b7b23b11-e7c0-4e71-9452-f8eb905270e8, 'C''est très bon mais un peu gras à mon goût. Il faut peut-être limiter l''utilisation de la crème...', '2004-04-27T10:27:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17271, 0972c4f2-0fd7-468e-8c37-a743e7ce34c2, 'Excellent, rapide et simple!', '2004-04-16T20:57:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17271, d23beefd-3e97-4aac-ad75-092baa703da2, 'Très bon! Nous avons utilisé des filets de dorades... Facile, rapide et très bon!', '2003-11-23T11:38:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, 08eb7df9-3bc9-4168-829c-e3c7ff68dfa4, 'Très bon avec une salade.
J''ai juste fait reposer la polenta de façon à ce que les cercles se tiennent, pour les faire dorer dans une poêle avant le dressage.', '2020-02-27T10:25:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, 818fe277-8246-46a0-93ec-656b3a3c65ba, 'Recette originale et bonne, ça change de la Polenta classique. La prochaine fois, je remplacerais la crème fraîche par du St Moret.', '2016-11-14T23:26:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, a3d89d8f-5d33-40cf-afdc-59544644c58a, 'Très bon, attention à ne pas trop faire cuire sinon c''est sec', '2023-04-20T15:27:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, 351aeb46-0062-4006-88d6-d482ef5ccab2, 'Top!
Ma douce a adoré ! Important : bien laisser refroidir la polenta pour pouvoir façonner le burger. Perso, jai rajouté de l''aneth à la sauce, c''est passé crème!', '2021-04-13T12:43:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, c8629079-23d8-4abc-a515-8ebfefd8d8b3, 'À manger froid ou chaud ?', '2019-11-24T12:52:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, 62f33d37-5b24-4c59-967f-9d9771cd80ce, 'Super bon ! Pour un effet plus joli, utilisez un emporte pièce. Seul petit bémol: La sauce à base de crème est un peu fade... Servi accompagné d''une salade, l''effet est garanti !', '2019-11-11T12:51:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, a0640919-ae97-4b04-b61d-704971edba4f, 'C''était super bon à refaire ', '2019-07-18T02:48:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, 2d065eee-4138-4287-bab0-4c61a3e9b41d, 'Du gorgonzola pour gratiner, y aller généreusement. Sauce au yaourt à la grecque. Aneth à la place de la ciboulette. Qq gouttes de citron.  
Plutôt pour 2 personnes que 4.  
Mais c''était délicieux.', '2019-06-10T08:50:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, 89e796c7-f61a-463f-ac07-2d3515ad3e00, 'Un délice équilibré en saveur et nutriments. ', '2019-06-02T03:16:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, f3c6876d-af0a-477e-9ed2-7905f2ea4c5e, 'Excellent et original! 
Tout le monde a aimé ', '2019-05-24T09:18:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, a4f5379e-41d4-492e-b675-73c9b35aec81, 'Délicieux !! Je recommande. On s''est régal !. Bien laisser refroidir la polenta pour faciliter le montage !', '2019-05-13T11:31:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, c1147883-6c2f-447d-9523-6bbd52802975, 'C''est bon et original ! Merci pour cette recette ! J''ai l''ai suivi à la lettre mais pour mon goût il est inutile de mettre du sel dans le mélange crème-ciboulette, le saumon sale suffisamment. Rien de négatif, mais pour ma part il m''a été impossible de faire un "burger" car la polenta était trop molle, du coup j''ai mis dans l''assiette une tranche de saumon, la crème-ciboulette puis sur le dessus un beau carré de polenta gratiné. Top top Top !  !', '2019-05-06T22:17:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, 0e6b8f51-5c2a-4074-9241-6fc1ad470c59, 'Première fois que je fais de la polenta. Instructions suivies à la lettre. Délicieux ! J''ai juste utilisé de la polenta citron-gingembre car c''est tout ce que j''avais sous la main. Par contre, je ne mettrai qu''un demi bouillon cube la prochaine fois.', '2017-08-17T21:25:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, cf2af822-73d0-444f-96e8-3d00eae8bcdb, 'Original. Je l''ai fait avec du jambon.', '2016-12-23T22:24:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, 9f79ce97-08ed-497a-9f10-126a8871f2d6, 'Moi qui n''aime pas trop la polenta, là j''ai adoré et mes enfants n''en parlons pas !!! Par contre trop salé à mon goût.', '2016-12-13T16:27:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, 9c412c0e-c4bc-4266-9da6-65291bbae1c5, 'L''association des goûts est délicieuse mais je n''ai pas réussi à faire des galettes de polenta qui se tiennent. Sans doute les ai-je faites trop épaisses. Je les referai en améliorant la présentation.', '2016-12-11T15:10:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, 582a828e-0877-4894-b1e6-71e5a2a73fcc, 'Mis à part la mozzarella que je n''ai pas ajoutée, la recette est géniale si on la suit à la lettre, je la recommande sincèrement !', '2016-12-02T22:53:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, feb53bf0-f56e-4ff6-9a78-8a6c0550f956, 'Je trouve que ce mélange de saveurs est une excellente trouvaille. C''est une recette facile, délicieuse, à refaire sans problème ! ', '2016-11-26T11:38:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, 0bde7178-92d2-4e4d-bd32-89a5f5e36f2e, 'Très bon !', '2016-11-21T22:29:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (346040, 3dd5d0a6-167e-4244-84ad-14a06faad8cd, 'Vraiment très bon. Je l''ai servi avec de la mâche, ce qui nous a fait un plat complet. Si on a des copains, un soir, voilà un repas tout simple mais excellent.', '2016-11-14T13:31:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, 8b060a9c-f27d-42ca-b49d-d615395123c2, 'Recette excellente et facile... on peut cuire le poisson un peu plus longtemps à la vapeur (10 min): il est bien tendre mais ne se défait pas. On peut réduire les quantités d''oignon etc, mais la sauce de soja est essentielle. A essayer d''urgence!', '2005-06-06T21:11:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, 311de9bb-727e-45ad-a573-d1f2bcbbe962, 'Les proportions sont très mal dosées, nous n''avons pas du tout aimé !!!!', '2016-02-10T15:54:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, 7cfbd89c-e357-4dee-a370-148968b63e5e, 'Pas de cuit vapeur ! Alors en papillote, avec la sauce, 4 min au micro-onde. Très bon,rapide et facile. Merci.', '2016-02-09T11:36:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, c59d812b-c2ba-4412-a541-39be9c1edca3, 'Quant à moi, j''ai ajouté du sirop d''érable à la sauce, pour le côté salé/sucré... Trop bon !', '2013-08-09T21:32:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, 619880bb-216f-4ca0-81d5-44f659ba5d10, 'Il faut s''armer de patience pour débiter le gingembre en batonnets, mais le résultats est tout simplement délicieux. J''ai utilisé un filet de loup de mer de 600g, et 10 min à la vapeur: il était fondant, et la sauce excellente. ', '2007-08-26T14:08:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, 50e7dd75-6ce9-4580-b468-6f715c6c724b, 'Je suis au régime: je l''ai donc fait sans l''huile, et c''est un délice (2 oignons suffisent). Merci pour cette recette simple et délicieuse!', '2006-02-13T18:18:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, a36737eb-0baa-4742-bab2-5d4c8f832b47, 'Pas mal, en revanche il y a beaucoup trop de gingembre frais. Pour 2 personnes, j''en mets à peine un morceau de 2 cm râpé sinon c''est trop fort... mais sinon l''association du tout est bonne. Marche avec n''importe quel poisson blanc d''ailleurs', '2022-04-23T15:47:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, 712849c3-e643-4128-85de-212be40c1445, 'Pour ma part un peu moins d’ail et seulement 2 oignons, mais poivre du Sichuan et flocons de piments en plus... Une tuerie, tout le monde s’est régalé ! À refaire sans hésitation', '2021-09-10T12:01:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, 3fc9adbf-6522-4a22-bcef-d7d14a4d3ba0, '1 tuerie ! J''ai juste remplacé le poivre par du Shishuan, ajouté 1 cuillère de miel et du vinaigre de miel (vinaigre de cidre si on a pas).', '2019-04-25T13:45:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, f81a4166-d8ff-418b-948b-0aa14aeccb91, 'Très bonne recette, faite au four vapeur, très appréciée par mes invités. ', '2016-04-02T21:54:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, f8b6f656-1704-4511-8239-a6c796dbb78b, 'Recette originale, facile, rapide et délicieuse !! Merci pour ce partage.', '2016-02-10T21:16:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, ff302aee-1aa6-402e-8d16-6eaacc16a3d1, 'Délicieux ! Le poisson est ultra moelleux et parfumé. Fait avec du cabillaud, sans rien changer à la recette. Je referai sans hésiter.', '2016-02-07T19:48:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, f81aa133-4cf4-4d4f-9948-e91c223d10c7, 'Délicieux! J''ai fait revenir les oignons avec seulement une goutte d''huile à la place du 1/2 verre pour alléger le plat. On s''est régalés!', '2007-12-18T14:35:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, 72989bc2-65b8-496b-825d-8b6448806754, 'Excellent. Tous le monde s''est régalé. Encore meilleur que dans un bon restaurant chinois !', '2006-06-10T23:18:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, 11f2ab45-27bc-4967-833d-20d3075a0abb, 'Délicieux. J''ai tout simplement fait cuire mon poisson à couvert dans la sauce un peu détendue pour l''effet "vapeur". Et c''était parfait!', '2005-09-02T19:21:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32311, 4476e263-223c-4861-b84b-1c966ce46c9f, '18 sur 5, oui! C''est hyyyyyyper bon!!! Je l''ai fait avec du dos de cabillaud, et au four parce que je n''ai pas de cuit-vapeur, c''est vraiment sublime! Merci pour cette recette!!', '2005-01-16T21:45:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20274, 95ff5d48-3106-45aa-9dc8-e246fcc5004e, 'J''ai essayé avec des poissons de l''Atlantique, je trouve bien la note d''ensemble mais trop calorique. Merci pour cette recette !! ', '2011-03-01T19:22:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20274, 54fc98c8-480f-4d1b-b268-4f2597b35a17, 'J''ai remplacé l''oeuf par un bol de lait salé et poivré et un bol de farine.', '2019-01-14T17:58:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20274, d991140b-eb3b-4072-beee-24bb76da9cec, 'Pour que ce soit moins gras, j''ai suivi l''idée du bouillon en lieu et place de l''huile, bien plus digeste. J''ai simplement préparé un court-bouillon instantané et ce fut un délice. A refaire sans hésiter.', '2010-08-07T14:34:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20274, 67012895-5a71-4176-852b-be2058d7fc93, 'Excellente idée que d''utiliser du poisson pour une fondue ! Par contre, je ne le cuit pas dans l''huile mais dans un bouillon de légumes ! Plus savoureux et bien moins gras...', '2008-03-08T14:45:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20274, a30576ab-2dd8-419f-bf23-5d88fd959ca6, 'Une variante, plus légère, de la bourguignonne. Le défaut: salissant, à cause de l''oeuf qui coule un peu partout, et qui s''agglomère dans les petites épuisettes utilisées pour la cuisson (plus pratiques que les fourchettes quand on cuit des aliments friables comme le poisson). Mais, en ce qui concerne le goût, c''est très, très bon !', '2008-02-25T12:49:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20274, 0bba1cca-d8e5-46a4-9f30-05595b1bcea7, 'Remplacer les oeufs battus par une pâte à beignets, c''est délicieux mais consistant, donc pas d''accompagnement.', '2007-05-17T22:47:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20274, 1f200762-2335-4f73-a392-9098d7f268f0, 'Super bon, j''utilise de la pâte à crêpe par contre et quelques petits légumes en supplément.', '2006-12-21T12:15:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20274, 5bd1d120-85fc-4c67-bb3c-ad25cc6218cd, 'Très bon! Le poisson doit être à chair ferme, j''ai rajouté de la panure ou de la farine (ça a plus de tenue). Les grands et les petits se sont régalés. Plus digeste que la bonne vieille bourguignonne.', '2006-12-13T22:44:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20274, 70ce933b-8649-4bd7-a30f-572f9fa54ab1, 'Moi, je ne mets pas d''oeuf, mais c''est bon! On peut egalement utiliser des langoustines surgelées. Très convivial, avec une touche de fête.', '2005-12-22T13:39:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20274, b6aaaacc-b5d6-4986-b2a2-c00c01b3c228, 'Facile à préparer et très bon si on aime le poisson! Recette originale.', '2003-11-29T22:31:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51261, e9c5e072-4b5f-46ed-aaee-70996f518e9f, 'Très bon ! J''ai fait cuire les carottes coupées en rondelles et les courgettes en tronçons. J''ai alterné des morceaux de cabillaud et des morceaux de saumon et après 20 mn de cuisson j''ai ajouté la crème liquide mais pas d''oeuf. Encore 15 mn au four et c''était très bon, je recommande ce plat.', '2019-06-18T01:23:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51261, 6c5f0947-b8ec-46b7-be24-3eb9d623c412, 'Super recette ,sans aneth mais avec beaucoup de coriandre et de citron ( zeste  aussi) sauce un peu juste en quantité. Mais excellent à refaire sans hésiter. ', '2017-08-23T16:08:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51261, 439908a0-7bc7-4253-8ec6-ec9ab2572c04, 'L''idée est bonne mais il manque un peu de goût (j''ai pourtant respecté les assaisonnements), et surtout, la texture de la crème avec les oeufs n''est vraiment pas agréable, ça fait comme un flan. Je tenterai à nouveau en mettant de la crème avec du fromage ail et fines herbes.', '2015-08-24T06:54:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51261, 6bf12822-9fb7-4730-b45c-63b93f8a8f64, 'Très bonne recette Je n''aurais jamais pensé à mettre des carottes et courgette ensemble mais en fait cela se marie très bien Je l''ai servi avec du riz La prochaine fois j''ajouterai du curry dans la sauce', '2015-05-17T15:50:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51261, c7ba9a51-1839-41f2-865d-60ef477e8e87, 'Plat fade en goût...', '2013-03-02T23:07:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51261, 024333d4-b0b9-44dd-8f5c-4f48d69358bd, 'Super bon ! j''ai mis du colin (4 morceaux) à la place du filet de poisson. Pas de tomates confites sous la main, j''ai donc fait revenir les tomates fraiches avec la courgette... Manger des légumes de cette façon c''est vraiment très agréable ! Mon mari a grandement apprécié !', '2012-09-30T16:35:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51261, 4d66676e-a87a-47e4-99ce-9674fe821407, 'Simple, avec de la crème liquide et sans aneth.', '2011-12-04T22:40:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51261, 14f2396d-fb4f-4436-a3ee-6cfb07bba15e, 'Sympa, j''ai ajouté du gruyère râpé avec la crème fraîche mais sans œufs et tout le monde a apprécié.', '2010-09-22T20:44:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51261, 662e6e7e-8e67-48ea-8d24-3eafa4661c6f, 'Extra vite préparé et vraiment délicieux, j''ai rajouté du gruyère râpé et les enfants ont apprécié ce gratin de poisson. Il faut un peu de temps pour cuire les carottes mais le reste se fait facilement et rapidement.', '2009-06-10T19:21:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51261, ba589b5d-fa4e-4b91-8ce8-eabaf2f8348d, 'Facile à préparer pour un résultat excellent. Les tomates séchées sont indispensables à mon goût. Les enfants ont moins aimé les légumes.', '2008-08-25T14:38:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51261, c556c737-3690-489a-b0a1-c705b94b68e2, 'Excellent, un vrai régal, je l''ai faite deux fois et la deuxieme fois j''ai rajouté des champignons frais, des lamelles de surimi et des dés de saumon fumé. A refaire car vraiment bon. ', '2008-01-30T21:39:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51261, 0fad507c-14d1-468e-b1f6-75d687255878, 'Excellent! J''ai fait cuire les courgettes à la vapeur pour alléger le plat et c''était parfait aussi.', '2007-10-31T08:31:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51261, 3e8011ce-036b-42b5-959d-649a59df9804, 'Je n''ai pas compris pourquoi il fallait précuire les carottes elles ont donné beaucoup d''eau ensuite  je l''ai fait avec des filets de poisson surgelés ', '2007-09-06T21:14:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, a259a82c-b444-4bd7-a826-ad7359370305, 'Trop bon !!!!', '2017-04-29T20:29:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, b461d014-87c2-40ac-96ef-49e94b05f3f8, 'Très bon. Mon homme et moi, on s''est régalé.', '2007-05-17T16:22:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 4414bb43-d45f-40c9-bb68-7432ff071d0d, 'Excellent fait avec un mélange de saumon et de cabillaud ', '2023-07-12T17:08:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 037e10be-ad69-46a1-8dba-3d641317dce2, 'Délicieux, j''ai intercalé de la mozzarella entre les couches, c''est encore plus fondant ', '2022-07-11T11:59:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 8b8153da-d708-48ef-974e-f0c752e18223, 'Fait avec du maquereau. Excellent ! ', '2018-02-24T03:04:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, b0f343b4-6d23-43c1-bdb4-a93fb2637f4b, 'Un vrai délice !', '2017-08-19T23:26:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 88d21e4b-b2c6-4152-97f8-89a133985f34, 'Délicieux ! Excellente recette faite avec du cabillaud et de la lotte surgelée, Boursin ail et fines herbes la moitié du pot et seulement une cuillère à soupe de moutarde...tellement bon ! Seulement pour trois personnes je dirais.', '2016-11-20T15:16:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 91c04ecb-197b-433d-9167-e2aceefb9f08, 'Excellent !', '2016-04-14T13:34:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, f26eea99-5f65-4c53-a88d-10e345352c31, 'Très bonne idée ! Faites plusieurs fois avec du lieu ou du pli. Par contre j''utilise du boursin ail et fines herbes que je garde sans tomates et je ne sale pas la préparation de poisson à mon sens déjà suffisamment par le poisson. Je fais une sauce tomate maison avec carottes et tomates. Je monte une couche sauce tomate, une couche pâte à lasagne, une couche préparation de poisson, ect. Toute la famille se régale !', '2015-12-01T21:56:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 76d40dbb-4e9f-4564-afe6-a9731fa2242e, 'Même mon fils qui n''aime pas le poisson en a redemandé !', '2015-11-21T03:20:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, d2c87015-14ac-487e-b59d-88579e5fdc83, 'Très chouette ! Je devrai juste être un peu plus légère sur la moutarde et le poivre la prochaine fois et un peu plus généreuse sur la crème fraîche.  En effet, à défaut de boursin, crème + ail + concentré de tomates doivent faire l''affaire ! Merci pour la recette !', '2015-05-12T22:52:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 1329c906-cecc-4891-9201-b411aeae6286, 'Excellent ! Vraiment délicieux. Je n''avais pas de boursin cuisine tomate, j''ai mis du boursin cuisine ail et fines herbes et c''était très bon aussi. Le seul bémol est que cela n''était pas vraiment présentable : tout s''est écroulé quand j''ai commencer à découper... Mais en dehors de ça le goût était la ! ', '2015-05-11T21:15:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 0d4d3f6c-7f11-4506-9c2b-6428ec569ad0, 'J''ai préparé de fumet de poisson avec de tomates et de la  carotte pour faire la sauce tomate.  J''ai mis une couche de sauce tomate, une couche de lasagnes, une couche des épinards, un couche de lasagnes, un couche de sauce au poisson, un couche de lasagnes (et recommencer) pour finir j''ai mis des herbes ciselées  pour poisson et de fromage gruyère râpé. Vraiment excellent!  ', '2015-04-17T15:52:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 6d0a069d-3a47-4e17-8ed3-67d7e0f844ab, 'N''ayant pas de boursin, j''ai mis un pack de crème liquide légère, un peu plus de moutarde, un peu d''ail en poudre.  Réalisé avec des filets de cabillaud, une franche réussite. Mes gaillards, pas fans de poisson ont adoré.', '2014-08-27T11:43:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 9f9ce467-28ef-4c2f-9579-eed5c79b32c1, 'Je n''avais pas de boursin mais je l''ai remplacé dans la préparation de poisson avec de la crème fraiche, du concentré de tomate et de l''ail écrasé, j''ai ajouté de l''ail écrasé dans la sauce tomate (encore !) C''était extra !', '2013-05-19T18:06:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 3c61fefb-96fd-4b11-8297-6a9af213cadf, 'Encore meilleures avec des épinards en plus.', '2013-04-27T21:04:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 1c0ec406-e714-4bf4-ba51-42230e031fd8, 'Bon et simple à faire ! C''est une très bonne variante des lasagnes classiques  ', '2012-09-10T23:27:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, b916ea22-d532-4631-ba31-4d8b7ce4b538, 'Bon plat apprécié de tous. Un bémol cependant, je trouve que la tomate et le boursin cuisine cache un peu le goût du poisson. A refaire avec un simple coulis de tomate peut être.', '2012-07-31T12:29:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 84c1e621-e6c4-40dc-9f61-ec679f36e1bf, 'Les épinards ajoutent de l''onctuosité, bonne recette !', '2012-05-16T20:31:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, eac1dcc5-6a4b-4a1c-b787-4639ba5b9501, 'Excellent merci pour la recette tout le monde a adoré! n''ayant pas trouvé le boursin cuisine tomate je l''ai remplacé par celui "ail et fines herbes" ! pas d''hésitation elle fait parti de mon carnet!', '2012-02-26T18:05:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 82513b1e-6f09-44af-b7da-0007eb7d360f, 'C''était bon. Mais attention, ne pas prendre de filets de poisson avec arêtes !', '2012-01-21T12:04:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 97650ddc-7bed-4ba5-b0c1-acd6c99d81ce, 'Testé hier soir ! Très bon Première fois que je faisais des lasagnes de poisson mais ça change des lasagnes bolognaise ! Vraiment à refaire N''hésitez pas ', '2011-09-27T10:43:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, f76c17ba-1e93-45fd-bf3a-dbdad00d1d65, 'Tout simplement succulent, simple à réaliser pour ma 3ème recette de ma vie (et oui !). A mon avis, pour le choix du poisson, il vaut mieux aller sur du cabillaud, la sauce tomate emporte sur le goût du poisson. Merci Marmiton de faire de moi un cuistot (c''était vraiment pas gagné !).', '2011-09-21T10:20:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 51bd29a9-0353-4110-aa90-1f48fe8fa6e5, 'Une petite merveille... pas trouvé de Boursin cuisine, j''ai mis du Boursin salade écrasé... à refaire!', '2011-07-31T19:13:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, e973d114-4dec-477f-a5a4-da0a3e1e6b84, 'Comme tout le monde j''ai dû remplacer le fromage frais (par un pot de crème fraiche safran-tomate) et franchement c’était terrible ! Superbe à l’œil et à la bouche, une merveille, et pourtant je ne suis pas fan de poisson !', '2011-07-22T23:00:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 6f4bdb8d-f662-46f5-a9ce-cde7a2895428, 'C''était trop bon... Recette à refaire, tous mes convives ont apprécié... De plus, nous faisons la pâte des lasagnes à la main, un vrai délice. Je n''ai pas trouvé de fromage frais à la tomate, je l''ai remplacé par le fromage ail et fines herbes, très bon...', '2011-07-03T12:12:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 5e40a5cd-cc7a-4177-89a5-5ee7ca9d3293, 'Trop bon, succès assuré ! Les convives ont tous adorés ! Et ça change des lasagnes traditionnelles. N''hésitez pas à faire la recette.', '2011-03-27T13:35:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, ba7796d4-e57e-4f77-a386-58c3ae6f2b13, 'Un vrai régal, un de mes invité n''aime pas le poisson... Il en a repris deux fois! Merci.', '2011-02-27T11:30:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 9991a742-b89f-4c5d-b982-b60bd38e8f11, 'Vraiment excellent ! Tout le monde a adoré, même ceux qui ne sont pas fan de poisson.', '2011-01-01T22:16:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 8a24423b-11bd-41d9-8822-bb4865c0aef5, 'Trop, trop bon ! Les invités ont adoré et m''ont demandé la recette. Encore merci pour ce bon plan.', '2009-10-20T00:55:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, d1245a8e-8ff3-4443-9941-638f1fe5c4b8, 'Recette délicieuse et très simple à réaliser que j''ai suivie à la lettre.  Tout le monde a adoré, même mon frère à qui il est d''habitude très dur de faire avaler du poisson ! ', '2009-05-07T23:37:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, ed0b17b7-f587-4ba5-81e0-b4dd43ed18cf, 'Excellent, les enfants se sont régalés. A refaire!', '2008-10-10T19:21:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, e88d36cb-961b-432a-8b59-a3cebd4fb139, 'Une recette vraiment excellente!! (A la place du boursin cuisine, j''ai fait un mélange crème fraîche, concentré de tomate et herbes de Provence).', '2008-05-14T22:07:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 6b146a30-80e5-4ec3-bcd9-135d36e5adf6, 'Très bonne lasagne, par contre, j''ai mis une couche de sauce tomate, une couche de lasagnes, une couche de sauce au poisson, une couche de lasagnes (et recommencer) ; afin d''avoir un peu plus de lasagnes pour toute cette sauce. Tout le monde s''est regalé!', '2008-02-11T08:14:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, cdad14b1-2c1e-44fb-8c7d-0c181bc9933d, 'Tout simple à réaliser, je ne trouve pas moi non plus de boursin cuisine, j''ai donc pris du boursin ail et fines herbes. A chaque fois toute la famille se régale ! Merci encore pour cette recette...', '2008-01-10T16:25:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 7fc819ad-2d49-4da3-b7dd-3002f5526197, 'Tout simplement délicieux !', '2007-12-10T16:28:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, a654149a-9c65-4ed8-abf4-20c5ac9a0542, 'Vraiment délicieux et facile à faire. En plus c''est très vite préparé. C''est un plat que j''ai réalisé pour différents repas entre amis et tout le monde m''a complimenté et demandé la recette! Par contre comme je n''ai pas trouvé de boursin cuisine à la tomate, alors je les ai fait avec du boursin cuisine ail et fines herbes et ça relève bien le goût.', '2007-09-18T15:37:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 9aad85c1-c83f-49ef-a2b9-04d1992c3c27, 'Très bonne recette, qui peut être préparée avant que les invités n''arrivent afin de profiter de leur présence. Je n''ai mis que du saumon, c''était excellent et j''ai rajouté du vin blanc dans la sauce tomates et du citron sur le poisson. Je réessayerai avec d''autres types de poissons.', '2006-09-30T15:19:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 80b07777-5711-468a-a016-df80bd596dfa, 'Des lasagnes délicieuses et originales, à faire et à refaire... Je n''avais pas de mozzarella, donc j''ai mis du gruyère.', '2006-09-01T14:41:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, e2aa0f8b-3942-4a85-a013-8f6e64654f68, 'Mioum! J''ai utilisé des filets de colin et de cabillaud surgelés. 500 Gr, mais 600 gr ça pourrait aller aussi. J''ai cuit mes filets au court bouillon (10 min). Un pot de sauce tomate de 500Gr. Pour le reste, idem. J''ai mis l''équivalent d''une petite boule de mozarella en garniture. On est trois, il est resté juste une petite part! ', '2006-08-08T12:22:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, ee712ca1-d0ca-4c21-956b-2dc25a4e01d9, 'C''est vraiment délicieux! En plus ces lasagnes ne sont pas du tout lourdes grâce à l''absence de la béchamel...A faire et à refaire sans modération !', '2006-06-11T23:28:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, a199465c-04ea-4b59-bcb6-e34bdac5603b, 'Très bon et très facile! J''ai remplacé le boursin par de la crème fraîche... 5% de mg (on peut toujours y croire !) et c''est succulent !', '2006-03-18T18:39:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41362, 21cb2d79-5033-4b99-81f8-a48f897e8028, 'Délicieux! N''ayant pas de boursin cuisine à la tomate dans mon hyper, j''ai remplacé par du boursin cuisine à l''échalote auquel j''ai ajouté des tomates confites pulvérisées. Nous étions 5 à table et l''avis a été unanime. Merci pour cette recette.', '2006-01-28T01:57:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69955, 6d2181da-98d6-4784-a418-8108bcd2a08d, 'Très bon ! J''ai rajouté des pommes de terres !', '2014-08-24T14:14:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69955, 2a9f6f8a-5bf7-4061-a180-431738acb45a, 'Délicieux !', '2020-09-05T18:03:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69955, f4f1fd36-58c0-473f-af24-5ba93f4f47f0, 'N''ayant pas de ciboulette j''ai ajouté du thym frais, j''ai remplacé la maïzena par une cuillère à soupe bombée de farine, j''ai poivré la préparation à la crème et salé (légèrement) le poisson. Cuisson intégrale à la casserole. Préparation rapide, plat qui embaume la maison. Mes frères ont ajouté un peu de riz blanc. On s''est tous régalés !', '2014-07-17T14:53:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69955, d397e923-938d-4e7f-99cb-59f543fd1d24, 'À faire et à refaire. Je n''avais pas de paprika mais c''était quand même très bon !', '2014-01-31T20:08:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69955, f27fac3d-fcdb-46e4-a60f-a186a792a1bb, 'Excellente recette ! Je l''ai réalisée dans des mini cocottes et ça en fait un plat très original, mes invités se sont régalés. Côté pratique, j''ai mis le poisson en dessous des légumes, pour être sûre qu''il ne se dessèche pas à la cuisson. Et comme il y avait des enfants, j''ai remplacé le vin blanc par un mélange sauce soja et eau, plus doux que le vin pour la cuisson des légumes. ', '2012-07-28T13:55:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69955, 22512fe5-fe22-439b-b856-9d67ad11a85f, 'Très très bon ! J''ai ajouté des pommes de terre en cubes et j''ai mis le poisson sous les légumes pour davantage de moelleux !', '2011-06-18T14:40:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69955, 46943016-7e83-49de-8043-d143290c0379, 'Merci! Cette recette est tout simplement exquise! Même si, faute de ciboulette fraîche, j''ai utilisé de la ciboulette séchée... Je pense aussi qu''il serait possible de remplacer la crème fraîche par de la crème végétale (soja, avoine...).', '2011-03-19T17:53:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69955, 906c62e4-be1b-4bb7-9658-bc6024cf9cb8, 'Vraiment très satisfaite par le goût, la texture du plat. Pour moi, c''est une façon nouvelle de préparer du poisson. J''ai mis beaucoup de légumes et servi sans riz, cela fait une bonne formule diététique pour le soir. J''ai rallongé le temps de cuisson des légumes que j''ai fait revenir dans de l''échalote. Merci pour cette recette.', '2009-07-18T22:02:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69955, c5c541ba-4d01-4ad3-98a4-c14ef4146c96, 'La sauce donne un excellent goût aux légumes, mais pas trop au poisson. On retrouve le bon goût, simple, du poisson avec des légumes au bon goût. Recette pas trop compliquée. A recommander (avec du bon poisson).', '2008-09-06T17:50:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 314d0392-8a6c-4fa5-85ea-426d525d3bca, 'J’adore cette recette simple rapide et délicieuse. Je ne mets pas de coco râpée et ça suffit. Je surveille le poisson car selon la taille des filets, il faut laisser moins longtemps au four (que je mets à 180) !', '2018-09-16T09:50:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, b192f8cc-8b6e-43c1-aed3-bcc3fb9332b3, 'Super bon, au niveau de la quantité d''épices, il faut mettre environ un quart de cuillère à café par épice.', '2013-01-15T20:41:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, f59d84e5-21c0-481c-bb39-a0f72cb1d1de, 'Très bon, on s''est regalé.
J''ai remplacé le cumin par du curcuma et ajouté 2 petits piments oiseaux et 2 piments végétariens le tout emincé finement.
Un vrai régal et avec un petit graves de bordeaux, un délice.
', '2021-05-08T14:01:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 34e044fd-cb1a-4e35-bf76-f5697b980e99, 'Très bonne recette, j''ai rajouté des carottes, et je pense que je mettrais d''autres légumes avec la prochaine fois afin qu''ils se cuisent avec la sauce. ', '2016-08-21T21:13:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 770559cb-bdb5-49ff-a6eb-d5ed9895442e, 'Bonne recette pour manger du poisson de façon un peu élaborée et rapide ! J''ai utilisé des filets d''aiglefin, et j''ai accompagné le plat de riz. Je n''ai pas tout à fait mis les mêmes épices, j''ai mis du curry (en grande quantité car c''est celle que j''aime le plus avec le goût de lait de coco), du piment, de la cannelle (mais peu je pense que le goût écœurant dont parle certaines vient de là) du cumin du sel et du poivre (ne pas hésiter). Pour la cuisson 5 min a 200°C puis 30 minutes environ à 100°C et avec du papier d''aluminium pour que ça ne sèche pas. Bon appétit à tous ! ', '2010-12-21T22:39:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, c69e0c9c-ce20-4ffb-95e4-29610d9b0759, 'On ne sentais pas assez les épices, je pense qu’au wok cela serait meilleur car le lait de coco avait pratiquement disparu', '2021-06-12T14:26:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 038743b8-afc9-4865-88c1-924b340459f2, 'Bon mais il n’est pas indiqué dans la recette les quantités d’épices à mettre ... j’ai eu du mal à doser les épices car on sentait trop le lait de coco ! Ce serait bien de mettre une indication sur les doses merci', '2020-05-06T21:00:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 91c4f7ac-1d48-4a67-85e8-eb389f879eb5, 'Délicieux! cette recette est une de mes favorites pour le poisson, c''est tellement facile: on met tout dans le plat et on enfourne! Merci avec du retard j''ai du faire cette recette une vingtaine de fois.', '2009-02-16T22:44:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, bf5411be-cd29-41a3-9639-d081aed4ccb4, 'Trop bon ', '2023-10-08T14:21:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, a9a83f6b-e379-4386-a869-2555e4e5f94d, 'Délicieux. Très facile !', '2022-12-17T20:05:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 774abe13-dbf6-402b-bb9b-44f88f6ad630, 'Délicieux, 
Je vous inciterai simplement à ne pas forcément suivre le dosage des épices... ajustez à votre goût !
La cuisson du poisson est juste parfaite 😘👌', '2022-10-04T11:27:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 5d1e5b18-71c3-4e89-b09a-e473b70301e4, 'Délicieux. ', '2019-02-20T05:03:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 6c68b708-17af-4130-b851-2f8ca1995d35, 'Excellent, j''ai divisé les quantités de pulpe et de lait de coco par 2 pour 2 filets et j''ai mis l''équivalent d''une cuillère à café d''épices et une tranche fine de gingembre frais émincé. Mon seul regret est qu''il n''y ait pas de sauce pour assaisonner la julienne de légumes servie avec.', '2016-03-15T15:26:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, d4e248eb-c6a3-4bbb-9308-7156247b8e38, 'Recette bien sympathique. Super simple à réaliser. Fait avec du poisson surgelé et j''ai remplacé par moitié la quantité de lait de coco par du lait demi écrémé bio. J''ai rajouté du curcuma pour la jolie couleur. Plat fait dans un wok et non au four. Aucun problème ! ', '2015-11-26T20:30:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 5d01f80d-f212-4385-8113-67ebeebbf1c3, 'J''ai fait quelques modifications ; j''ai utilisé du lait "normal" à la place du lait de coco que nous n''aimons pas et j''ai ajouté une carotte pour adoucir un peu le tout. Merci beaucoup je la referai.', '2013-01-17T20:57:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 8475df9c-f5f8-4a37-b2c5-06cb455dafa6, 'Délicieux et très simple ! Je n''ai pas mis de coriandre car je n''en avais pas et ajouté un peu de lait pour que la sauce ne s''assèche pas. Sel et poivre en fin de cuisson.', '2012-01-15T16:14:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, dd185b83-9d14-4a8d-ba05-f2804b11e56a, 'Délicieux et facile. J''ai suivi la recette à la lettre. En plus les enfants adorent!', '2011-10-25T14:35:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 08c0235d-40b8-40fc-b735-c4f49527e2c3, 'J''ai suivi la recette à la lettre et j''ai trouvé ça vraiment écœurant... J''ai trouvé que toutes les saveurs n''allaient pas du tout ensemble !  Je ne la referai pas, mais mon mari a bien aimé. ', '2011-10-09T20:32:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 9f0d6bf7-b9e6-480b-a3e5-1f5c5609e79b, 'Bon mais un peu sec.', '2011-04-10T18:35:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 8bd7c1a4-47d6-4c94-8cc8-0fbe3e35860c, 'J''ai fait cette recette avec des filets de sole tropicale, un délice ! En accompagnement, une poêlée de haricots plats, petits pois et chou-fleur (légumes d''hiver) et le tour est joué. Pour ma part, je raffole des épices alors j''ai eu la main lourde, du coup, le lait de coco se fait plus discret. A refaire !', '2011-02-26T23:12:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 40f77116-b737-4b2d-b3e7-28521d00c7e5, 'C''est délicieux. J''ai mis une cuillère à café de chaque épice et supprimé la noix de coco en poudre. J''ai fait des des filets de tacauds. C''est très fondant.', '2010-03-18T23:23:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 039de5ba-9362-42d5-99ca-1748999947ba, 'Merci pour cette recette, rapide à faire, j''ai utilisé des filets de panga surgelés. Mes invités ont tous aimé. On peut remplacer le lait de coco par de la crème liquide pour ceux qui n''aiment ', '2010-02-23T16:07:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, d5af4e67-2437-41a5-a356-806e764a66e1, 'J''ai bien aimé le goût de la recette et sa simplicité de réalisation. Merci. ', '2009-11-08T20:06:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 5975c5f4-c593-42be-b305-236bbdb055e4, 'Nous étions très deçus par cette recette. Lait de coco avec les épices a donné le goût par terrible au poisson. ', '2009-10-21T13:00:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 8378c7c9-3c3a-495e-8dfb-bc5b8b858269, 'Excellente recette, essayée avec des amies qui ont adoré, puis mon chéri qui s''est extasié!  A faire et refaire, surtout que c''est très facile !', '2009-01-27T15:45:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, b17da62e-f211-4133-b7a7-1badb627e1b4, 'Ai trouvé le goût de la sauce trop fade, cela manquaient d''épices, on goûtait trop le lait de coco ... trop écoeurant donc pour nous ... à refaire mais en changeant les épices ...', '2009-01-11T18:38:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, e6d135b8-3425-41a2-9bf5-76350af0738a, 'Excellent et très facile à réaliser!', '2008-10-12T09:08:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, c209d0ad-7ccf-4b89-a22f-c344d75a4862, 'Recette délicieuse. Je connaissais des recettes au lait de coco avec la viande, mais pas avec le poisson, et c''est divin. ', '2008-09-16T22:00:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 4c1b7813-ad86-4b3f-b05c-65d5f570bd34, 'Très très bon, à faire et à refaire.', '2008-08-15T11:36:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 1ba508dd-1f06-48eb-9a79-08a053ed3f9a, 'Vraiment très bon, le lait de coco n''est pas trop prononcé, bien dosé!', '2008-07-25T16:26:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 21e70215-c27c-4b7d-b9ef-c98af7f31a22, 'Très bon!!', '2008-04-18T14:52:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 5758ba36-5f22-4010-95c1-1e8809dcb8ab, 'Parfait. Super bonne recette, ultra simple, effet garanti !', '2008-04-05T09:47:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, d3e3dda5-e7ef-4b1c-bb1d-ca3a0bcf5e09, 'Je le fais avec du pangasus et même les gens qui n''aiment pas le poisson en raffolent! Et en plus c''est super simple !', '2008-03-18T15:12:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, abc29343-93e9-43ba-95a6-2a5131f073e1, 'Avec des darnes de saumon et à la poêle, c''est ultra-rapide (10 minutes grand max)... et c''est un délice!', '2007-12-14T20:14:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 3a2ed6bf-340f-4691-ac8a-f9b2f023ace6, 'C''est pas mal, facile à faire, je trouve que les épices sont trop concentrées sur le poisson et ne dégagent pas leur parfum sur le lait de coco.', '2007-10-25T11:32:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 1cb410d7-6e09-4ef9-9cea-bfa223e2a4ff, 'Très bon, facile et rapide à faire!  J''ai fait la recette avec du saumon. Parfait !', '2007-10-22T16:55:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, f2175098-417d-43e5-80da-4487180bcf83, 'Pour ma part, je remplace coriande et gingembre par une "préparation toute prête pour viande". La recette reste alors très facile à réaliser (15 min maximum de préparation) et surtout le plat est très bon !', '2007-10-12T18:02:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, c13a96cb-eea5-4d27-9f6e-db4edb4e3bd8, 'C''est super bon et une idée originale de manger du poisson. Deux fois que j''en fais et je me régale toujours autant avec mon ami.La seule chose que je n''ai jamais mis s''est la noix de coco râpée... parce que je n''aime pas! et je l''ai servi avec des pommes de terre vapeurs un régal. Pour les épices je n''ai pas mis de coriandre , nide gingembre meis un mélange de 4 épices, cumin, cannelle, piment doux, sel et poivre. En tout cas merçi pour cette recette.', '2007-09-07T13:39:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 39eabfd0-7338-4791-9baa-ae229dfd97e5, 'Bof, j''ai trouvé les épices trop fortes (concentrées) sur le poisson, peut-être faudrait-il les diluer dans le lait ?', '2007-07-28T17:21:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 3da4de9a-60da-4f26-9e1f-e55e57025f45, 'Délicieux ! Mon mari adore ! Merci.', '2007-07-25T18:58:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 206823b9-9ac3-413c-9c8b-77e90174b160, 'Excellent, à refaire sans hésiter.', '2007-06-12T01:24:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, d4db8a5c-ea33-44c3-8cb5-c02c564021b7, 'C''est une recette comorienne entre autres origines. On peut ajouter des chouchous, des lentilles corail si on en a, et une plante aromatique : fenouil, aneth, ou autre.  A faire avec du gros poisson coupé en morceaux, genre thon.  ', '2007-04-25T23:16:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 4098cebd-9d33-4e92-81a1-5bb29c903747, 'Vraiment très très bon et facile ça cuit tout seul!! J''ai mis toutes les épices sauf la noix de coco râpée! A faire et à refaire un vrai régal!', '2007-01-21T20:39:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 12c1493f-0f72-418e-8d5a-75d3fb51639e, 'Excellant!!!!! Par contre, la prochaine fois je salerai plus!!!!!!!', '2007-01-15T17:30:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, aa5c0b1c-7466-428e-89e6-1aef6d4f8d38, 'Excellent! Pour ma part, j''ai ajouté des échalotes avec l''oignon. J''ai mis 1 cuillère à café de chaque épice, en mélangeant toutes les épices dans un bol avant de les mettre sur le poisson, salé un peu, et recouvert entièrement de noix de coco en poudre (pour ne plus voir le poisson) avant d''ajouter le lait de coco. A faire et à refaire !!', '2006-12-07T12:50:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, f346a5fa-454a-40a7-ba2c-a2188b57dbd5, 'Excellent! J''ai fait cette recette avec des filets de poisson blanc, sans coco râpée et paprika. C''était super bon et surtout original. J''en referai avec plaisir. Merci. ', '2006-11-19T23:19:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 153ca243-8e74-462f-83e8-0b7655125079, 'Cuisson au Wok très bien. Pour le goût, 1 cuillère thé de chaque épice n''était pas suffisant pour ma part, trop fade.', '2006-03-18T18:18:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 10104e01-0ab7-46f9-9ab0-a0091ff95488, 'Essayé avec du saumon, mais sans poudre de coco et c''était un régal! Fin et savoureux. ', '2006-03-05T14:25:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 742b9844-08db-4606-a268-975181cfbcda, 'Bon mais l''huile dans le fond du plat s''est avérée inutile: elle flottait nochalemment à la surface... Pour les épices, je conseille une cuiller à café de chaque.', '2006-02-25T15:12:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 33fe2ce8-74c5-431f-8334-aca0598a5f75, 'Très bon, mais il manquait un petit quelque chose pour relever un peu le goùt. Il est très important de faire cuire avec le papier sulfurisé ou du papier d''alu sur le plat. Bon appétit!', '2006-01-26T11:01:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, e1d00cd8-f932-4c60-8503-df40271c4cf8, 'C''était très bon, mais ça ne sentait pas assez le coco...', '2006-01-15T01:00:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, cf9e136f-11bb-4e76-9a9a-895b9ea7d0e2, 'Excellent et tout le monde a apprécié.', '2005-07-12T13:08:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 62c50b79-06ca-4f07-a419-882372326c6c, 'J''ai utilisé un mélange de 3 filets de poissons. Faire précuire les rondelles d''oignons à la poële. J''ai mis 300 ml de lait de coco et j''ai rajouté de la noix de coco fraîche. Ne pas oublier de mettre du sel et du poivre. Ne pas lésiner sur les épices. Utiliser de préférence du gingembre frais qui libère d''avantage d''arôme. Rajouter 5 min avant de sortir du four de la coriandre fraîche finement ciselé. Bon appétit.', '2005-05-20T14:23:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, c702a285-353f-48c4-85ae-568dac7a47cc, 'Excellent, j''ai pris du carrelet car c''est un poisson qui cuit vite et qui est très fin!', '2005-04-12T10:31:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 402b2cd0-76b0-450b-8590-e1e2d93fcdac, 'Super bon, super facile, nous avons été emballés par cette recette !!!', '2005-04-07T14:32:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, b0ea9909-661a-44de-979e-c2386dc76e91, 'Très bon mais je ne l''ai pas fait en gratin : j''ai fait revenir les oignons dans une poêle avec un peu d''huile, j''ai ajouté les filets et parsemé de noix de coco râpée. J''ai ensuite versé le lait et assaisonné le tout. Délicieux, à faire et à refaire sans modération.', '2005-02-23T16:24:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 33ad6d7b-cee5-43ec-8462-812008593b56, 'Très très bon. Doux et très fin, j''en refais ce soir !', '2005-01-28T20:34:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 6450cbfd-74b1-49fb-ba08-1767728e5659, 'Tout simplement EXCELLENT  !! avis aux amateurs... essayez !!!', '2005-01-09T11:43:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, d81c4f8f-425d-44c8-84a7-00af5b92c7a2, 'Je n''avais ni muscade ni cannelle et j''ai fait la recette au wok, mais quel régal!', '2004-09-25T16:12:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15066, 2bd21462-44d1-4d57-8f24-965bd765fd48, 'Un délice! j''avais peur d''ëtre écoeurée par le coco mais pas du tout. Merci pour cette recette originale.', '2004-09-10T18:38:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (311506, c0d5f33f-95f0-48b8-bc81-120db61e6eb3, 'Vraiment très goûteux et très bon !', '2013-10-31T19:23:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 02856fbf-c4a5-4108-ac59-51a2467810a4, 'Bof bof. On a mangé, certes, mais ça manque de goût. C''est fort plat. Par contre, j''ai eu une bonne tenue avec 30 minutes de cuisson.', '2019-05-21T20:49:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 78d9ecf1-0d64-4d10-93c7-c6de9244b526, 'Les galettes étaient très bonnes et pas trop sèches. J''ai mis moins de pois chiches et de graines de tournesols mais plus de Tahine, c''est peut-être pour ça. Un régal !', '2018-10-13T06:40:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 1fa1b53b-4b15-4624-9785-a47755c67daf, 'Un vrai régal ! Ma recette favorite du moment !', '2014-01-29T08:10:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 9b7228c6-06bf-4bf1-819d-0675410fb49d, 'Bonne recette... Si vos burgers sont friables et que vous ne mangez pas d''oeufs (régime végétalien), vous pouvez remplacer un œuf par une cuillère de maïzena mélangée à deux cuillères d''eau. Ça forme une pâte qui aide à tenir les burgers. Bon appétit !', '2011-07-26T16:44:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 8050a2ca-1d76-4ef1-a7f6-44f6f5562c44, 'Super recette, merci. J''ai ajouté du garam masalam et c''était délicieux.', '2019-03-06T17:32:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 5b76274e-1096-44bc-8a91-d35b6a3c8ac1, 'Excellent, facile, un petit plus du tabasco et un peu de vinaigrette sur la salade. Succès.', '2018-05-28T22:44:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 86892475-20ca-49cf-a55a-e140755b7020, 'C''était bon, mais pour la présentation c''était pas ça ! Trop friables, impossible de faire des boules !', '2018-04-16T11:25:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 51c6e84d-a983-4b13-a7d9-ff264e231dc5, 'Les burgers sont tombés en miettes mais c''est très bon malgré ce petit désagrément.', '2017-01-10T21:20:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 39cce5ea-986a-49d9-8123-cc2de48846a6, 'Recette très sympathique. Le seul problème : au moment de retourner mes burgers ils sont démontés. Je pense qu''en effet un œuf en plus est une bonne idée. Pour ce qui est de la quantité, j''ai divisé les proportions par deux et ça m''a fait 1 gros burger + 2 moyens, c''est à dire suffisamment pour 2 personnes.', '2016-01-20T09:14:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, c0504b53-b50e-4787-a8aa-53f260d68c1e, 'Très bonne recette végétarienne, super simple. Pas trop sèche avec des pois chiches en boîte. Au four, je ne les ai pas retournés pour éviter que ça tombe en miettes...', '2015-03-05T01:56:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, f8baa602-5035-4257-9aa8-b71d8abaa2f4, 'Je pense qu''il ne faut pas trop mixer pour garder un peu de texture. Un peu sec en effet. J''ai fait plusieurs petites galettes, mais ce serait mieux 3-4 grands burgers. Je les referai sans mixer, mais en écrasant à la fourchette et avec plus d''huile.', '2015-02-01T12:22:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, eec90ea0-c8d8-40ee-a041-385832468072, 'Super bon, un peu sec peut-être donc je l''ai servi avec une salsa, et j''ai mis 2 œufs pour lier le tout et le rendre plus consistant. Avec les quantités suggérées, j''ai obtenu 7 jolis burgers. La prochaine fois, je mettrai plus de carotte, ou éventuellement d''autres légumes (épinards, courgette...).', '2013-05-14T00:11:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 04fbdffb-970c-4fd3-b893-3e25ba535b80, 'Pas de citron ni de graines de tournesol sous la main mais c''était quand même très bon...on les a mis en wrap avec une feuille de salade et une sauce au yaourt, toute la famille a apprécié et pourtant j''ai des carnivores à la maison !!! A refaire', '2012-06-09T14:50:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 96e428af-709f-4b11-85f5-238cbc52abeb, 'C''était franchement pas mal du tout, original. Comme il était conseillé dans les commentaires, j''ai ajouté 2 œufs entiers. Il faut également un peu plus de cuisson qu''indiqué. J''ai aussi mis de la coriandre en poudre et c''est très bon. J''ai mis plus de tehina qu''indiqué et ça passe très bien. L''idée des poivrons semble excellente.', '2011-11-28T10:01:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, cff9999c-e310-4612-8462-a8f1a29751a4, 'Succulent et original ! Je n''avais pas de carotte et j''ai mis un poivron rouge, donnant une jolie couleur orange. J''ai suivi les conseils des autres commentaires en ajoutant un œuf. Accompagné d''une moussaka qui avait rendu pas mal de jus, on a tout mangé jusqu''à la dernière miette !', '2011-04-25T13:47:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 41e49cd2-408c-4b53-9849-5073e0757e20, 'Très bon, le goût est délicieux mais friable. Mettre 3 œufs et 2 cuillères à soupe d''huile d''olive pour les rendre moins secs. Je n''ai pas mis les graines de tournesol parce que celles que j''ai achetées n''étaient pas décortiquées et l''écorce coriace.', '2011-02-27T18:36:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, f248fee1-7e60-4e57-9239-3b150e0f9fe5, 'Recette originale et plutôt bonne (nous les avons mangé avec du tatziki !) Les burgers sont effectivement très friables malgré l''ajout d''un œuf .Cuisson plus longue qu''indiqué.', '2011-01-31T19:06:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, d4dca4bc-7d6b-40e8-9634-b8e4cbea1f35, 'Assez sec malgré tout, je m''attendais à mieux... Ceci dit on a tout mangé!', '2009-05-06T11:15:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 839045f5-d994-432e-8d31-67d75b994f48, 'C''était vraiment très bon, mais effectivement les burgers avaient tendance à se décomposer. La prochaine fois, j''ajouterai un oeuf pour lier un peu tout ça. Je les ai cuits à la poêle (par manque de place dans le four), ça donne très bien!', '2009-02-22T16:16:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, f2d3e384-508b-49da-b87e-77574c921c10, 'Très bon et rapide. Je la referai surement. J''ai par contre rajouté un oeuf et fais revenir l''oignon et l''ail avant. Avec ces proportions ça nous a fait 5 gros steaks que j''ai servi avec une sauce au yaourt-menthe et du pain.', '2009-02-18T13:56:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 61a5f414-0fdc-4b9d-8155-3140113543be, 'Très bon, parfait pour un dîner léger. Accompagné d''une sauce tomate, c''est délicieux.', '2008-05-07T16:26:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, e74110b5-8e08-471a-8bdd-98b7fa41866f, 'J''ai fais avec les moyens du bord, mais j''ai trouvé que c''était friable et un peu sec. A refaire avec plus d''huile d''olive x 2 je pense. J''ai servi avec une sauce de fromage blanc 0% + chèvre. Ça a relevé un peu le manque de moelleux. Sinon, l''idée est originale. J''ai fait trois gros steaks. La prochaine fois, je les ferai en trois hamburgers végétarien pour changer du tofu.', '2008-04-04T23:13:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 0dab6356-33dc-455d-b61a-2c34fa9b8e18, 'En effet, les boulettes se tiennent difficilement. J''ai ajouté un oeuf dans la deuxième moitié de ma recette et ca aide beaucoup.', '2007-09-26T01:20:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, 05b7bdcd-55de-4233-8c03-0b7c3c8db8a9, 'Mes burgers s''effritaient un peu malgré cela, ils avaient très bon goût et on s''est vraiment régalés...A refaire sans attendre!! Original et goûteux ! merci', '2007-09-18T01:07:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47271, f94f7cbb-0541-4ab4-9160-d0a3f64a6fad, 'J''ai adoré...A servir quand on a des invités, c''est super sympa, "surtout" avec un assortiment de sauces.', '2007-06-05T16:46:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347367, d2bb2fdd-9dc4-4388-8fe9-5f0ed816050f, 'Recette suivie à la lettre mais un gros problème au niveau de la cuisson des pâtes qui étaient cuites à l''extérieur mais encore cru à l''intérieur. Pensez vous que la température est assez chaude ou le temps assez long pour permettre à la pâte de cuire entièrement ? Pourtant j''ai bien fait 20mn à 180 et 10mn pour réchauffer le tout. Bien déçu de ne pas avoir pu réussir cette recette qui avait l''air prometteuse. =/', '2020-03-06T13:30:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347367, b378999e-0343-4df2-bc3d-9f1f69f65e99, 'Originale, la pâte feuilleté !', '2019-07-04T15:34:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347367, 98177781-1c13-41f8-b478-59530b51abf8, 'Très bien, bonne recette.', '2019-01-30T12:03:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347367, 9f75e996-fdae-455f-a63d-ad1a5f3ee281, 'Très bon ! Même si je mangerai pas une pâte feuilletée entière à tous les repas !', '2017-04-12T00:32:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347367, 5860a10b-e19f-41fe-b61e-fe0a80033d15, 'Original et très bon.', '2017-03-27T03:21:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347367, 6665c375-7add-4c0f-9511-b2872d24505e, 'Je n''ai pas réussi à cuire la pâte enroulée en escargot. Mais l’intérieur du burger était très bon !', '2017-03-24T06:53:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347367, f8a880ea-5fd3-49a9-aa81-d910de33b8d3, 'Très bonne idée, la pâte feuilletée ça change du pain et c''est plus léger merci.', '2017-03-22T14:36:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347367, 976e0865-f528-42ae-b052-5f99848021fd, 'Super bon  et facile à faire.  ', '2017-03-22T14:11:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, 8b2bb1d1-dcd2-49fa-bc13-5ad28dd3962b, 'Délicieux ; simple et rapide à réaliser ; meilleur qu''un beurre blanc ; je l''ai accompagné avec un bar et une fondue de poireaux : UN RÉGAL ! A refaire sans hésiter.', '2012-01-01T10:24:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, 58d74e39-2b42-4665-9d82-b322f737b3e5, 'Super!!! Mes convives ont adoré. J''ai servi cette sauce avec un saumon en papilotte. Délicieux! J''ai également essayé avec des penne (pâtes) et j''ai ajouté du saumon fumé en petites lamelles ainsi que du poivre de cayenne. Merveilleux. Recette à recommander. Merci! ', '2008-09-25T22:00:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, a4ab6c6b-6f8b-4fec-abb0-a283235d76d3, 'J''ai moi aussi ajouté des échalotes. Servi avec des pommes de terre vapeur et des épinards : très bon et tellement simple à réaliser!', '2007-02-12T18:14:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, 73b5bbce-9b8a-4e8d-8327-4409323554dd, 'Facile! Rapide! Délicieux! J''avais envie de mettre 6/5! J''ai suivi les conseils des marmitonautes : j''ai ajouté des échalotes émincées et un peu de moutarde.', '2006-11-18T15:16:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, 3ee7cb14-186c-40bb-98fa-07897ad7f222, 'Recette un peu flemmarde, je fait dorer des échalotes émincées dans du beurre, je rajoute le boursin, et la crème ensuite. Juste un petit plus, qui fait plus "fait maison".', '2005-12-21T17:33:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, 3e9ac2f1-8d45-4cfa-b785-4d45d7ae8971, 'Avec un petit peu de moutarde, c''est très bon et très simple à réaliser.... Je l''ai fait avec des filets de poisson et des épinards...Un régal.', '2005-10-05T12:02:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, 5590d217-e8fc-4ac9-ba0a-270c8d06c326, 'Bien et frais, j''ai rajouté un peu de moutarde parce que mon fromage aux herbes n''était pas très puissant... original et rapide pour une cuisine d''aujourd''hui! ;-)', '2002-09-14T13:51:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, d91d3399-ee45-4435-977c-095eac789ec9, 'Trop gras.', '2018-04-19T09:55:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, be56156a-f4c9-44dd-9f59-57fd3e320e9f, 'Ca n''a pas beaucoup de goût mais l''idée est bonne. A refaire en améliorant.', '2012-04-29T21:01:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, f73b6c06-a6de-4819-bab3-8a75a226706a, 'Bonne idée, j''ai également ajouté des échalotes et de la moutarde.', '2010-08-15T18:15:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, fc95503a-e415-48dc-a8cd-a00951915492, 'J''ai été un peu déçue, car comme il faut mettre pas mal de crème pour obtenir une consistance de sauce, cela affadit l''ensemble et on ne sent plus assez le goût de l''ail. Moi qui comptais sur cette sauce pour faire aimer le poisson à mon mari, c''est raté ...Ce n''est pas grave, je referai un essai.', '2010-03-19T18:34:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, b6b86774-1534-4df5-9426-131b99ac4f81, 'Faite ce soir avec du poisson et des pâtes ! C''était super bon et facile ! A refaire.', '2009-10-15T21:53:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, 9459b213-5f36-455e-b09d-fe1240d98a89, 'J''ai essayé cette recette sur des filets de pangasius, un vrai régal! N''ayant pas de crème, je l''ai remplacée par du lait. La sauce était onctueuse et très légère.', '2009-09-07T18:59:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, 3cad5ca9-4f1f-4a1e-94b8-22b48a8a4704, 'Un vrai régal avec un dos de saumon, et d''une facilité! merci', '2009-02-10T17:21:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, fb35199a-36be-4784-b863-be4ad73e4f7e, 'Bonne recette, merci. J''ai rallongé avec un cube spécial poisson n''ayant pas une boîte entière de fromage aux fines herbes.', '2008-02-02T14:31:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, 69bf85e1-c921-4fe8-ab96-4d1372952680, 'Effectivement simple et rapide, mais un peu déçue par l''aspect "fade" de la sauce. Je retenterai avec une autre marque de fromage.', '2007-04-03T23:14:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, 43cb8531-ef16-46bb-9adf-960bfc78a944, 'Je me sers aussi de cette sauce pour les pâtes, tout le monde en reste baba ; Simple et du meilleur effet!', '2007-03-16T18:42:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, 3ee29c66-05de-48e3-b94d-921c1bb5e219, 'Bon et facile à préparer! Fallait y penser ! Merci.', '2006-09-13T13:23:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, 08041ab1-ad4d-4537-80fe-80f86e5f8e7b, 'Très bon et très facile à réaliser. ', '2006-02-18T14:52:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, 3b86daab-5546-47de-a05f-b46088882e0d, 'Très bon et si facile à préparer! On peut également la préparer avec de la crème fraîche épaisse.', '2004-07-14T20:16:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14878, d86da5ae-17a9-447c-9955-7ee9f9be8e20, 'Accompagne délicieusement saumon, truite... Et si rapide à préparer!!!', '2004-01-19T11:58:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (348363, 4b2aea0c-dc96-4949-b017-c56e5f7fe327, 'Très bonne recette. A refaire, surprenant. Mais un peu sec, peut être avec une petite sauce cela pourrait être encore mieux.', '2018-12-01T09:09:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (348363, 51bb543b-ddc4-4f22-a0ee-4133120cbc32, 'On s''est régalés, j''ai accompagné de frites de patate douce.', '2018-11-20T01:52:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (348363, 11d7e164-2fad-48e7-b5fa-b4f1169b03b1, 'Super bonne recette malheureusement j''ai dû louper quelque chose pour le pain car il était très compact.', '2018-08-04T09:14:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (348363, 04768479-0121-469d-b622-f555b2e36699, 'Excellente recette !', '2018-02-19T09:02:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (348363, e36fbbfe-a720-4767-a390-e140b5e34391, 'Très bon !', '2017-12-05T22:12:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, b3133fde-9de6-40cf-9d01-3ddb02c0a6b3, 'Très bon. J''ai juste ajouté une pointe de safran dans la sauce et des échalotes.', '2012-01-22T20:12:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, 2753f2b1-6bba-4d03-a5d5-4dc3c8bd27a5, 'J''ai ajouté du cèleri branche et du persil.', '2011-10-28T16:35:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, 53fc8cf2-fa29-430c-90b0-c65932f2fdde, 'Tout simplement divin !!!! J''ai eu la meilleure note grâce à ce plat dans un  remake d''un diner presque parfait !!!!! L''ensemble est fondant, et exquis, je garde évidement cette recette. merci!', '2010-03-22T18:33:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, a297aa12-aa73-46f2-915e-d094bc8ad618, 'un régal! ça m''a été servi chez des amis et je le referai! parmesan/poisson c''est délicieux...', '2010-03-20T11:06:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, 6394a87e-a506-4b18-b137-9ee64800aa44, 'J''ai fait ce gratin un dimanche soir avec des filets de poissons qui me restaient au congélateur : saumon, thon, cabillaud, grosses crevettes et noix de Saint Jacques. C''était délicieux. Simple, bon et complet. A refaire sans hésiter. merci!', '2008-10-14T00:31:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, 37123382-1889-477e-b156-f95a3c47f429, 'Nickel, je l''ai servi dans des petites cocottes, avec des pates fraiches. Léger et très bon !', '2020-10-18T10:41:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, 3f448211-5725-46af-acf8-bfc64b6fa843, 'Facile a faire et vraiment bon! Un regal avec un lit d''epinard frais dessous et un peu d''echalotte dans la sauce!', '2018-04-11T10:06:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, ea20ad43-b0b2-499f-936e-a13e25908df1, 'Parfait ! Rapide et facile. Petits et grands ont apprécié. A refaire.', '2017-02-24T19:29:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, 2d290b36-fb85-4e9b-9c0e-1e968db26c16, 'Très bonne recette ! Pour ma part, la prochaine fois, je mettrai moins de court-bouillon dans la sauce (50 cl, un peu trop salé à mon goût). En guise d''accompagnement, un lit d''épinards dans le fond du plat. Mariage heureux avec le poisson et les noix de Saint Jacques. Une recette à conserver !', '2015-03-22T22:37:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, ed65d09b-8561-4eae-8def-c1f7e8fa3a29, 'Fait pour les fêtes de noël, sans parmesan, servi avec du riz comme conseillé : franc succès, très goûteux et bien meilleur qu''avec des fruits de mer surgelés en sachet ! ', '2015-01-21T16:33:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, b9593f7c-ef41-4e47-bffa-291b294e5c12, 'Gratin facile à réaliser et qui est goûteux. C''est une recette que je mets de côté. Merci. ', '2012-12-27T12:54:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, 72fc2a18-1659-4386-a8be-198aff1641a4, 'J''ai ajouté des crevettes, tout simplement délicieux et je n''ai pas mis de parmesan.', '2011-12-03T16:38:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, a4262532-1abb-45a3-9e07-509b0d3efa6d, 'Une valeur sûre, un grand classique.', '2011-04-27T22:57:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, e081bd3e-0675-46b2-af35-807119727f96, 'Excellente recette testée lors d''un grand repas de famille ! J''ai ajouté des échalotes et un peu de curry ; comme garniture : fonds d''artichauts garnis de riz basmati et une compotée de poivrons/tomates au piment d''Espelette. Un régal, et un plat équilibré et festif !', '2010-10-09T23:03:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, 444b4d17-f7f4-4ead-919a-3e305338ca4d, 'Très bonne recette, résultat final excellent, mais réalisation de la sauce difficile : pour moi la proportion farine/beurre n''est pas bonne, j''ai du ajouter beaucoup de beurre (en général je mets 10g de farine pour 10g de beurre) et la quantité de sauce un peu juste. Sinon le mélange parmesan/chapelure donne très bien, mais il faut en préparer un peu plus, 2 ou 3 cuillères de chaque. Recette à refaire !', '2008-12-10T21:14:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, 5a2ac15a-5a57-4214-a364-562a32a94186, 'Du même avis que les précédents, excellente recette ! Les coquilles saint-jacques sont délicieuses associées aux poissons et le parmesan se marie très bien avec le tout. Il n''est pas nécessaire d''en mettre trop pour profiter de leur goût (je pense aux budgets serrés) mais les enlever serait dommage.', '2008-12-01T00:46:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, 15a4a697-18a9-47a8-bc6e-f3277ce94a6e, '20/20. Je l''ai servi pour le baptème de mes fils. Les saints Jacques font leur effet. L''accord avec les poissons est parfait. J''ai utilisé du caldo de poisson d''Espagne, c''est encore meilleur ', '2008-05-14T23:41:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, 0d529f9d-b59c-40e4-b5c7-34b0420e1f79, 'Très bon plat, facile à faire, merci', '2008-03-22T00:56:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, 8048faff-429b-406f-87ec-368c7ffb13ee, 'Excellent, je n''y ai rien changé, tout le monde a aimé. Merci.', '2008-01-11T17:06:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, f4b6338f-778d-4c43-a60e-269688152f20, 'Délicieux. J''ai remplacé le cabillaud par de grosses crevettes (3 par personne) que j''ai décortiqué avant de les joindre à  la préparation. Préparation assez rapide pour un résultat très satisfaisant.', '2006-12-18T12:09:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46741, 5253d502-8c43-4cc5-86dc-18a08e2537c1, 'Excellente recette! Tout le monde s''est régalé. On peut peut-être le faire sans les coquilles pour un budget serré.', '2006-11-13T19:05:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90881, e2c86d13-b886-46cf-8886-69715e95991d, 'Très bonne recette. Comme je n''avais pas de boursin, j''ai remplacé par de l''ail en poudre.', '2013-06-25T23:46:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90881, 6bca15d0-299f-42ad-bb1d-069c4f0c10bc, 'Excellent ! Je n''avais pas de boursin alors j''ai mis du fromage cottage, de l''ail et des fines herbes ! Avec des épinards frais et des pétoncles ajoutés aux poissons. Délicieux ! ', '2010-08-24T07:55:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90881, 878ce7c3-8ae4-490b-ab01-b4e3a8e58a47, 'Excellent, mes petits-enfants  qui parait-il n''aimaient pas les épinards se sont régalés.', '2019-11-17T11:31:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90881, 0964320f-d00e-4ae4-92ae-795419d6bf41, 'Facile, simple et surtout bon. J''adore !!! ', '2016-06-17T14:37:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90881, 78c77758-2dbd-4563-9fa7-ec879f12f88e, 'Très bonne recette. L''astuce de précuire les feuilles est excellente. Je n''avais pas de boursin, j''ai fait avec des apéricubes et un reste de fromage au raifort...Merci pour la recette!!', '2014-04-15T20:12:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90881, b0e25bfc-b767-4435-9783-512e67d97814, 'Tout simplement parfaite ! Rapide, simple à préparer et très appréciée.', '2013-04-08T22:56:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90881, 0a8c056f-91c4-4dff-b89a-3fd87293a5be, 'Très bon, à refaire !!! ', '2011-12-21T23:52:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90881, c6686efd-e7e4-41c6-b7b7-1ecdc189147c, 'Excellent, permet de manger épinard et poissons et de se régaler !', '2011-12-18T20:50:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90881, 55ab01d5-8cde-4dd7-938a-b0810d89336c, 'Vraiment excellente, même si on a aucun souci pour manger des légumes, ceux qui ont ce genre de problèmes opteront pour cette recette, merci pour cette recette', '2011-10-08T16:47:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90881, 947192ed-c0f3-4f01-8141-a11b305cf875, 'Super bon, les filles adorent !', '2011-07-20T00:07:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90881, 3465aa6f-ce7b-4a46-a213-70a281d88014, 'Excellent, même les enfants en redemandent !!! Rien à changer !!!!!', '2010-06-10T14:42:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72121, ffc162c8-ee75-49b3-ba70-1eb8c2dfdc7e, 'Très bon - faite avec saumon et bte de thon', '2022-01-03T17:33:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72121, 218e1c5a-08ac-454a-afb5-9f12b2f6fe13, 'Trés Bon. J ai fait avec la moitié des ingrédients. A la place du bouillon cube j ai utilisé in bouillon  fait maison à partir de carapaces de crevettes Et trois tomates à la place du concentré de tomate. Je n ‘ ai pas passé au blender. Jolie apparence.  J’ai servi avec des croutons et in petit verre de Monbazillac. Miam. ', '2018-09-21T03:10:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72121, 4497f13a-40a5-493f-b65b-1a77fc9a42cb, 'Excellente recette, et facile en plus. Merci beaucoup.', '2015-10-19T17:20:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72121, 1e30e38f-3ae3-4876-8ab7-055723ec5ba1, 'Après avoir fait des papillotes de bar, où je n''avais utilisé que les filets, il me restait 3 squelettes de poisson, j''ai donc adapté cette recette : 2 oignons jaune + 1 échalote + 3 carcasses de bar (que ça !) + 4 carottes + 3 patates + 2 gousse ail +1 petit persil + safran + sel et poivre. Je l''ai cuit longtemps jusqu''à n''avoir plus d''eau dans la cocotte. J''ai rediluée cette "sauce" et servi finalement avec croutons ailés et rouille... Super ! Pas cher !', '2013-01-30T18:03:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72121, 6201ad68-1a89-4635-b1a1-ffee65779963, 'Toujours difficile de trouver une recette de soupe de poisson pas trop compliquée et j''avoue que celle-ci en plus d''être facile et bonne. Je l''ai faite avec des filets de saumon surgelés par contre attention à ne pas mettre trop d''eau. J''ai mis du fumet de poisson à la place de cubes. Merci pour cette recette.', '2011-11-30T19:47:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72121, f70d65ef-0db1-44fb-9ea9-8dd55796ecd4, 'Simple, rapide et excellente recette. J''ai cependant mis des oignons jaunes (n''ayant pas de rouges sous la main), ajouter deux poireaux et comme poisson : 600 g de lieu noir. Puis,le tout a cuit 10 minutes sous pression. Pour ma part, je préfère cette soupe en morceaux. A refaire sans hésitation. Un grand merci.', '2011-02-14T20:21:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 27301df9-d7cb-4c98-bcd1-46c33ca1222f, 'Une gousse d''ail et une cuillère de crème fraîche en plus', '2023-10-04T13:09:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 6723a4d7-edc8-4877-b18f-160a27fce2d1, 'Sucré-salé juste comme il faut et super facile à préparer. A refaire sans hésiter !', '2015-01-28T19:57:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 01be62e8-eca9-409a-8f04-b1a45aaed821, 'J''avais un peu peur du sucré-salé avec du poisson, mais le résultat parfait. J''ai fait une compote de pommes avec des granny, et n''ai pas ajouté de filet de citron. Mes invités se sont régalés. Servi avec du riz basmati.', '2013-04-05T11:06:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, c77a464e-6172-46cf-af15-65ae88a34ed8, 'Bon et original !', '2012-07-25T14:49:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 49fae416-a3cc-4b10-943c-9f7aeaf1ff4d, 'Excellente recette, j''ai laissé fondre les pommes pour que ça ai l''aspect d''une compote et c''était tout juste parfait !', '2012-04-11T21:56:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, e7d201c9-442e-44b0-b34f-4748147ffae0, 'Fait avec 2 filets de plie (pour 2 pers). J''ai fait cuire les lardons (sans matières grasses). Puis j''ai fait revenir 1 pomme golden (dans le gras des lardons) à feu doux déglacée à la fin avec un peu de vin blanc. je n''ai pas rajouté de sel. Servi avec du riz basmati et un peu de crème. Excellent...', '2011-03-19T21:40:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 719f9eef-27bc-4e17-bce1-9b0f0c151bf7, 'Je suis toujours méfiant avec les sucré-salé de poisson, mais celui-ci est vraiment génial ! J''ai pris des pommes sucrées (type Golden) plutôt que Granny pour adoucir l''acidité apportée par le citron. Merci pour cette découverte.', '2010-03-06T12:48:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 741bb867-299d-4764-bccd-718654c46e22, 'Très bonne recette pour accompagner et relever un poisson blanc, j''ai respecté les quantités et c''était vraiment très bon. ', '2009-10-04T14:45:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 046345db-de17-49d7-b667-bebf0d45f8f1, 'Recette réalisée avec des filets de cabillaud. Notre famille étant gourmande de citron, j''ai mis le jus de deux citrons pour la cuisson des pommes. Nous nous sommes régalés !', '2009-08-23T00:26:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, d32b8d7b-2795-47e1-bba8-ce7f66427de4, 'J''ai suivi la recette à la lettre mais sans les lardons et c''est très bon. Je  la referai, c''est sûr. Merci pour cette recette.', '2009-04-10T16:15:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 7d41bd71-6144-419b-831a-ba3b0802805e, 'Excellent, une façon délicieuse de cuisiner le poisson blanc!! un régal.', '2009-03-13T17:56:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 982c31ac-1b31-4be8-b4f1-27ecd6c945d1, 'J''ai préparé la recette avec du cabillaud et je l''ai laissé cuire 8mn de plus au four. Un vrai délice.', '2009-03-03T11:57:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 9f789aa5-20df-4bf6-bb92-8513f2bfc37c, 'Excellent, surprenant et très facile à faire!! ', '2008-10-18T08:32:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 89c06630-3ca1-43eb-bf40-053426b2aae1, 'Très bonne recette, je l''ai faite avec du Cabillaud. J''ai remplacé le riz par des pommes de terre coupées en petits morceaux que j''ai fait rissoler avant à la poêle. Je n''ai mis également qu''une 1/2 pomme par part cela suffisait à mon goût. A refaire sans hésiter, merci. ', '2008-06-06T15:47:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 7cc9e8d4-4165-44a7-a8bd-56addc8f207f, 'Très bonne recette, sans rien changer, elle a fait le bonheur des petits comme des grands. Merci', '2008-05-16T10:44:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, fa25a12c-367f-45b4-9508-d5f4adbd200c, 'Ce plat a ravi tout le monde même les enfants. Je ne l''ai pas cuit au four mais dans une grande poêle avec couvercle en ajoutant un peu de crème et une larme de calvados (pas pour les enfants !). Très original, rapide et à garder pour une prochaine fois ! Merci beaucoup !', '2008-05-02T23:22:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, e3fdc227-a261-4064-afc2-c5eceaafd1c1, 'Je l''ai fait avec du pangasius, des lardons tout tout fins et une grosse Jonagold qui me restait. Superbe présentation! Et super bon. Le pangasius est le poisson rêvé pour ceux qui n''aiment pas...le poisson (goût peu prononcé)! J''ai pris 2 grands filets que j''ai coupé en deux pour faire le "montage". Tout est resté bien droit dans la papillote. Génial!', '2008-03-04T13:59:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 1886b3c0-755e-4639-b738-689109a976c5, 'En panne de four, j''ai réalisé cette recette au cuit vapeur. Excellent et très moelleux.', '2008-01-13T10:58:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 567e64dd-353a-41c1-9b6f-574736c807f4, 'Je l''ai fait gouté à des gens pas trop difficiles, ils l''ont trouvé excellent. Demain, je reçois une belle-soeur très cordon bleu, je verrai si elle l''apprécie.', '2007-07-28T22:03:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 65462c9d-87d2-45b4-a1f5-a8645bd20b24, 'Sensationnel! Le mélange lardons/tilapia, surprenant d''idée est très bon. Vraiment. Pommes et mangues se marient bien avec. J''ai mis des pommmes vertes mais je pencherais plutôt pour des Golden la prochaine fois, histoire d''accentuer le côté sucré.', '2007-03-24T00:47:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 6e298ee0-d515-45fd-9bd5-7259a940a880, 'Pas mauvais, mais moi qui aime les mélanges sucré/salé, je trouve la mariage des pommes et des lardons assez moyen...', '2006-08-17T15:23:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 5a2492e6-47a9-4f13-b779-a4fe0a362fe2, 'Très bonne recette, le mélange sucré salé est très agréable. Par contre, je n''ai mis qu''un filet de poisson par personne avec le mélange par dessus dans la papillote.', '2005-08-21T15:32:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 53efb8ef-dcbd-484f-8d0e-d4f42c36a9c7, 'Pas extraordinaire! Je trouve que le goût fin du riz ne se marie pas très bien avec le mélange lardons + pommes, plutôt ''campagnard''.  La prochaine fois, je préparerai ce plat avec une purée de pommes de terre et j''ajouterai des raisins de corinthe au plat.', '2005-08-08T17:53:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 4b80818c-06eb-48e2-a02d-36b097f90579, 'Très bon : j''ai découvert la saveur d''un mélange sucré-salé... Certes, j''ai l''habitude de cuisiner divers poissons mais j''ai été agréablement surprise de la saveur de cette recette.', '2005-04-08T13:25:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 13fe8afd-0b94-4e2e-979e-eba5de7bc06a, 'Fait avec des mangues... Mmmmmmmmh! ', '2005-02-16T16:55:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 038ab451-214c-4a3c-944a-4de98cf830b6, 'J''ai fait la recette avec des pavés de cabillaud, c''est très bon et surprenant, le mélange pomme poisson!', '2005-02-13T15:00:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 22a173bd-e470-4064-835f-21c986fd9cca, 'Je n''ai pas fait plusieurs couches comme indiqué - de toute façons ça s''écroule toujours au moment de fermer les papillotes - j''ai juste mélangé les pommes et les lardons ensemble et mis 1/4 sur chaque gros filet (j''en trouve des surgelés, c''est impeccable). Et même mes enfants ont aimé, c''est dire...', '2003-11-02T20:45:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 06bd253c-6b9a-47b0-958c-bf3e000873fe, 'Très bon, mais peut-être un peu fade en couleurs. La prochaine fois, j''y ajouterai une pointe de safran.', '2003-05-13T20:30:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 0f6edcc4-eaeb-44df-a234-74dc8c17c69e, 'L''astuce: des filets tout prêts et congelés. Pas d''arêtes! La pomme et les lardons sont une combinaison heureuse et originale. Pour la deco, j''aurais peut etre rajouté un peu de ciboulette fraîche. C''est délicieux, léger et digeste.', '2003-02-28T22:21:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, c3fe5765-f713-4c9e-b1e8-34827eb7cd35, 'Très bon avec le tilapia. Pas évident de faire des filets avec ce poisson!', '2003-01-12T17:59:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16509, 308f4b8c-d3f9-41ce-9492-569b59a8a30b, 'Rapide et délicieux, testé avec du cabillaud, cette recette mélange le salé au sucré d''une manière très douce. A essayer sans plus attendre.', '2002-11-16T13:41:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, d034db00-7925-467d-9b41-2cb014f8f63b, 'Très bonne recette! Très simple à réaliser et appréciée de tous. Je rajoute du gingembre et des courgettes pour avoir plus d''épices et de légumes. ', '2009-02-25T15:06:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 30286376-9e0f-4fda-8767-8f85698fd27b, 'Sur 4 personnes, 2 seulement ont apprécié. Peut-être le sucré salé ne leur a pas plu. J''ai remplacé le cucurma par du paprika, personnellement je fais partie des personnes qui ont aimé le plat. En guise de poisson j''ai pris des filets de limandes. Il est vrai que la cuisine au lait de coco est un peu douce, bien assaisonner.', '2007-09-30T21:39:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 5f3089fa-8451-4fa4-bd35-c85eb476fd11, 'Excellent !!!', '2023-03-03T10:04:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, fda780bc-8156-44a6-888e-aafedb16187e, 'Très bon merci ! Pour ma part, j’ai mis du gingembre, de la coriandre en poudre, piment doux, du sel de cèleri et pas mal de persil frais (je pense qu’avec coriandre fraîche ce doit-être encore plus explosif).', '2022-12-13T17:20:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 93f7605f-f86d-4db1-9520-193391507cf6, 'Top !', '2022-07-06T20:44:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, f14cf4a9-fa14-4ce2-b266-09f7c955bb86, 'Pour ma 1ère fois, c''était super bon et j''ai rajouté des petites rondelles de carottes en plus👍Mes enfants ont enfin aimé le poisson!!! Merci', '2022-03-29T20:47:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, dd71211d-275d-40c7-88f8-9c8bcbc74424, 'Top.', '2022-03-26T13:11:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 572aeed5-5f3b-4195-ac8a-24c9091a7176, 'Très simple et très bon. Rapide. Recette suivie à la lettre', '2020-04-18T21:30:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, b90cd472-1397-421a-affe-d2305886d674, 'Recette délicieuse.', '2017-02-06T15:04:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, f4c6fe6d-3d35-4829-b6bd-0dffc0bf8f0a, 'Poisson-lait de coco, délicieux !', '2015-05-05T16:48:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, fa0ae1f6-240d-40eb-8f06-db3ded60a731, 'Génial ! Une recette qui en jette. Réalisée avec le curcumin et le jus d''un citron vert.', '2015-03-27T22:07:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 19be930c-f53c-4655-9d6e-eb6cbf11dc47, 'Excellent!! j''ai mis la brique entière de lait de coco. Comme cela cuit lentement, la sauce prend une bonne texture et ce n''est pas trop contrairement à certains commentaires. Et j''ai juste ajouté un peu de piment. C''est parfait. A refaire.', '2015-02-21T14:49:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, bd22a21b-999d-46c9-8e22-04cab97e5bd1, 'Une de mes recettes fétiches, j''alterne avec du poulet à la place du poisson, pour ma part c''est curry lait de Coco et jus de citron vert, accompagné d''un riz parfumé ( citronnelle, gingembre...en infusion puis filtrer et remplacer l''eau de cuisson du riz par ce bouillon)...voyage garanti.', '2015-01-07T19:48:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, e21295df-ff01-4aa6-821c-f238da78a0fb, 'Super recette, enfin je peux faire manger du poisson à mon chéri et mon fils, pour ma part je l''ai faite avec des filets de lieu, de thon et des crevettes et au curry.', '2014-11-19T18:34:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, a53f6b1f-6427-4aef-ad1d-4b438f755d2a, 'Assez déçue par cette recette. Malgré tous les commentaires enthousiastes, je n''ai pas été convaincue du tout. J''ai trouvé le plat fade et lourd, j''avais pourtant suivi la recette à la lettre...', '2014-05-01T00:26:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, dda891b1-a38f-48bc-948d-1a2f22284298, 'Trop bon !', '2014-04-09T14:15:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, a464ddef-640a-457d-bf95-7e7abb033850, 'Un délice. Un repas de roi. A refaire', '2014-03-06T20:36:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 995bc8df-894d-4895-8c53-e3e65ea08d79, 'Excellente recette !!! Pour ma part, j''ai mis du colombo, plus doux que le curry et plus goûteux que le curcuma. A refaire', '2013-11-24T20:09:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, ef111143-b99c-4986-b96f-aa7b66e0c9ef, 'Très bonne recette ! C''est simple mais efficace. J''ai utilisé de la sole, un mélange de 4 épices au lieu du curcuma et ajouté le jus d''un citron vert. En accompagnement, carottes cuites dans le lait de coco et pommes de terre vapeur. Il n''est rien resté !', '2013-11-18T14:15:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 9e4347ea-3a8e-45f6-b96e-9ba071f0bcef, 'Recette suivie sans modif'', réalisée avec des filets de plie, très bon. Nos trois enfants ont adoré. À refaire.', '2013-11-11T19:30:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 59c124ba-7c4a-4eda-8d75-2fa115a025b3, 'Succès phénoménal à la maison : sur 4 enfants, 4 ont adoré! Du jamais vu pour le poisson :) Merci pour cette recette! J''ai remplacé le curcuma par du curry', '2013-10-10T19:58:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 2dbe4583-ce5b-4c4b-8989-424658d94a11, 'Un régal j''ai cuit le poisson ( du dos de cabillaud ) dans la sauce une dizaine de minutes.', '2013-09-09T14:37:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 7a35f1ee-38a2-4053-a5a2-147dd97acc42, 'Réalisée avec du dos de cabillaud coupé en tronçons, tout le monde à adoré.', '2013-08-17T21:10:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 092239cf-5f39-4e26-900b-4c953817d1aa, 'Facile et bon mais un peu trop doux ne pas hésiter à rajouter un peu de citron, ou plus épicé.', '2013-08-10T09:08:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 3fda67ab-c28b-4102-91cf-718b3ecc5e0d, 'Excellent, à la place du curcuma, j''ai mis 2 cuillères à café de massalé, il ne faut pas hésiter à saler. C''est vraiment délicieux.', '2013-06-18T15:27:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 88f249c0-b1d1-4831-83db-5a80395b468c, 'Je l''ai fait c''était un délice, cette recette est devenue un plat habituel je le recommence ce soir.', '2012-12-27T16:48:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 42b522a0-cdf8-4caa-8108-4956647b139c, 'Simple, rapide et très bon pour changer du quotidien et pour une recette express pour les invités du vendredi soir après le travail ! J''ai mis du curry à la place du curcuma et ajouté des petites amandes effilées pour le croquant au moment de servir. ', '2012-07-20T12:50:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 3a9a723a-bcd7-49a5-a3fd-46bc809378a6, 'Tout simple et très bon! J''ai mis de l''échalote, de la crème légère et de la noix de coco. Je penserai à ravitailler mon placard en lait de coco. Miam !', '2011-06-13T15:59:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 70303d50-5ece-4b7b-94e0-0fa4f6a5888c, 'Très sympa. A tester.', '2011-05-29T21:18:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 6885c1d3-39f0-44fd-a7cf-94f2a34058e5, 'Une demi boîte est largement suffisante ! J''ajouterai un peu de citron à la fin et quelques poivrons pour équilibrer le sucré/acide. Très bon !', '2011-04-14T00:30:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, a7ced2eb-c4c7-40e4-a989-3270aff4b32e, 'J''ai fait la recette avec des filets de flétan qui étaient assez épais donc ils n''étaient pas cuits (j''ai dû finir la cuisson 1min30 au micro-ondes). J''ai mis du curry à la place du curcuma. C''était bon.', '2010-09-04T15:43:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, dc1dabd6-a49d-481f-9d50-32a44ab8a212, 'Une 12 boite de lait est suffisant il est utile de rouler les filets et de les maintenir avec une pique car à plat,ils auraient été trop cuits et se seraient dispersés dans la sauce;Le curcuma y a bien sa place.', '2010-08-19T17:00:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 3f560582-9c46-434f-8a49-58f77515b98b, 'J''ai ajouté du curry, du piment d''Espelette et j''ai mis lieu de noir et perche du nil comme poisson. La recette a fait un tabac mes amis vont la refaire sans tarder !', '2010-07-22T18:17:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, cf71be45-2eb6-43f5-863a-2427a50154b8, 'Accompagné de petits morceaux de banane plantain frits... C''est parfait !', '2010-04-16T21:15:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, f411e303-d9a9-4d2b-a401-4595a36d5771, 'C''est trop fade .', '2009-10-08T23:36:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, e84275b5-7829-4ef6-b073-c891e5c54f0c, 'Très rapide à faire, très bon, Il faut bien assaisonner et bien mettre du curcuma. Sans, ce serait moins bon!! Merci pour cette recette!  ', '2009-10-08T21:13:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 568a665b-b294-4e23-987b-8c85ddbc6fda, 'Recette rapide et diététique, c''est très un bon moyen de cuisiner le poisson. J''ai ajouté un peu de curry, et du citron également. ', '2009-09-30T23:53:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, d115b55c-181a-4fdb-982c-fa1d81db489a, 'Excellent, je n''ai rien enlevé, rien ajouté, c''était excellent (facile à faire et rapide) !', '2009-09-18T21:46:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 0e7db34d-f004-4334-b409-821882239327, 'Bonne recette, simple à faire! Toutefois, je conseille d''ajouter quelques épices pour réhausser le goût !', '2009-09-16T16:00:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, fb5777b9-b8db-4fcb-a42e-80e66e23ba9b, 'Très bien, facile à réaliser. ', '2009-08-12T21:50:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, f1bc511b-2d39-4a3b-8444-9a5581252220, 'Je viens à l''instant de faire cette recette pour 2 personnes, le plat est délicieux. J''ai suivi un des commentaires ayant ajouté une cuillère à café de curry mais j''en ai mis plus pour un goût plus relevé. Très bonne recette, à refaire!', '2009-02-06T22:30:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 36d6ff52-dfb4-4650-a19e-e72b01438e71, 'J''ai ajouté 1 cuillère à café de curry en plus. Le plat fut meilleur qu''au restaurant.', '2009-01-27T22:35:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 106429d7-9ac6-40da-b25a-37685d8576e4, 'Très très bon. Recette réalisée plusieurs fois sans jamais être déçue. Des tronçons de bananes plantain ajoutés dans la sauce vont très bien avec. ', '2009-01-06T16:42:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 50dcca64-1126-4b1e-b1b6-c8597830ca42, 'J''ai utilisé du cabillaud surgelé, un délice. Mon mari qui n''aime pas le poisson a adoré...merci pour cette recette.', '2008-11-13T10:14:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, c14fd26d-2607-4716-9a86-6593c395a8cb, 'Très bonne recette. Facile à faire, goûteuse et originale. C''est devenu un classique à la maison pour faire manger du poisson à tout le monde. Merci de l''avoir partagée...', '2008-08-13T09:49:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 331ecccb-c53f-49a4-9ed6-08a5a88fd705, 'Délicieux! Je n''avais pas de curcuma, mais j''ai ajouté du gingembre et du coriandre. Un vrai régal! Même mon conjoint qui aime modérément les recettes "exotiques" s''est régalé. Merci!', '2008-07-11T12:46:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, f3072a76-d23b-4973-bcac-556226b72eef, 'Excellente recette facile à faire, on s''est régalé. J''ai juste ajouté une 1/2 c à café de purée de piment pour relever le goût.', '2008-07-03T11:30:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 262eda27-10af-412d-8883-8829938013ae, 'Excellent!! Tout le monde a aimé !!! J''ai rien changé !!', '2008-06-15T18:57:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 3c9c3932-716e-4292-9cb2-82dd66902957, 'J''ai pris des filets de cabillaud que j''ai coupés en lamelles et mis du curcuma. La prochaine fois, j''essaierai avec d''autres épices.', '2008-05-31T21:46:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 6697afbb-c543-4196-9b54-88ff3ed19298, 'Vraiment excellent ! Le poisson était juste super ! J''ai remplacé le curcuma par du piment', '2008-03-22T21:18:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, c62cf6fa-c6c2-4c17-a306-acfdf2716476, 'Extra! J''ai fait sans curcuma mais avec du piment de cayenne. Servi avec du riz tout le monde s''est régalé !', '2008-03-09T11:57:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, dd3be55c-6d03-459c-a2e7-dd8cce50f0f0, 'Facile et rapide à réaliser; moi, j''ai rajouté une pincée de piment rouge (sinon c''est trop fade !); Exquis....', '2008-02-19T17:40:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 988fc4ea-f15b-4ade-9450-ba9635b6a340, 'J''adore mais cela manque de caractère. Un peu plus d''épices ou peut-être de la moutarde ', '2008-02-05T20:11:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, db48b4a8-634e-442b-b2a4-a57e51f6648a, 'Nous avons beaucoup apprécié. Vu que je n''aime pas spécialement le trop "doucereux" du lait de coco, j ai bien assaisoné la sauce et y ai même mis de la poudre de piment ce qui a rendu le toux très épicé et doux à la fois ! ', '2008-01-09T12:56:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 75f1120a-100e-47e9-99b4-34e4419e2cf0, 'Etonnant de délice!!! N''ayant qu''une tomate, j''ai remplacé les 3 autres indiquées dans la recette par une petite cuillère de concentré. Le résultat est excellent, pas fade du tout. A refaire en toutes occasions, d''autant que la recette est simple et rapide', '2007-07-19T22:04:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 046db8ce-9576-43cf-af8b-76e71ba15602, 'Délicieux, fin en bouche, belle présentation... facile et rapide à faire. Attention toutefois à la qualité du lait de coco, il doit vraiment être onctueux, sinon cela gâche la recette !', '2007-07-13T19:32:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, f2837bce-46b9-4049-9863-01a3d51d7332, 'Recette toute bête à réaliser, rapide et aux résultats très satisfaisants. Ca change agréablement du traditionnel filet de poisson / riz!', '2007-04-02T22:37:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 3ae00fef-e95f-4014-8dcd-efb195b6b2c2, 'Très bon plat facile à faire. Vivant aux Antilles, j''ai rajouté un peu de Massalé dans le lait de coco, ça donne une petit goût sympa.', '2007-03-20T18:02:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 4490ebd1-06d3-4bb0-bb24-cdde6f8f1d4e, 'Fait avec des filets de saumon. Délicieux avec un riz pilaf. A refaire.', '2007-02-18T17:13:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13238, 880532b2-2f19-44ca-a425-19f18fe542b0, 'Délicieux, sans curcuma. Je n''ai pas roulé les filets, mais je les ai coupés en lanières assez larges. Très onctueux. A refaire sans problème.', '2007-02-17T16:35:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38191, 9abe05f2-1667-4eab-9670-6c8ee18d9768, 'Aaaaah le bon vieux gratin de reste. C''est pas très léger ni très diététique ni rien, mais ça fait plaisir le dimanche soir quand il reste pas grand chose et surtout qu''on a pas envie de bouger. ', '2006-08-24T11:40:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38191, 05a730ed-a608-484d-b686-bb018b31ee19, 'Très bon, mais c''était un peu sec, que faire pour la prochaine fois ?', '2022-09-09T08:01:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38191, f1aaef71-d34d-4bda-a2a8-0fd5dc3af3b0, 'Je n''ai pas mis les raviolis, mais 2 tranches de jambon coupés en petits morceaux mélangé aux autres boîtes. Servi avec une salade verte ... un régal ! Merci pour cette idée de cuisine "repos".', '2009-03-22T14:27:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31836, 16feecfc-6c9a-4322-97bd-9135c5a6e2d0, 'Excellent! Rien à changer', '2016-04-20T20:22:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31836, c3f44806-65aa-47b3-8716-c52497fb8d22, 'Quelle impression j''ai fait avec cette recette (bel aspect et très bon) ! Excellent avec de l''églefin pour ma part. ', '2012-12-29T21:20:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31836, 88dfc305-25db-48fc-a4cd-266b9bcc342b, 'Je l''ai fait avec du dos de cabillaud. Ce fut excellent, les invités qui n''aimaient pas forcément tous le poisson ont adoré !!!! Au final, une recette simple, rapide et excellente.', '2011-12-31T16:36:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31836, 089f5f8f-523e-4c8b-8564-ff798ffd8892, 'Très bonne recette simple à réaliser. Et tout le monde se régale.', '2010-12-20T18:55:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31836, 62460a99-048f-49cf-851e-784e216197cd, 'Recette très bonne et réussie. Par contre j''ai eu peur d''essayer la sauce beurre citron. J''ai fait une autre sauce, recette de ma nièce cuisinière : 1 verre de vinaigre de vin blanc + 1 oignon puis réduire sur feu vif. Rajouter un peu de crème épaisse et du beurre tout en battant. Résultat OK mais par contre c''est une sauce qui n''attend pas!', '2007-01-05T08:26:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31836, e41bb9ea-c7ec-4b7f-bbac-9d869ee6c7c3, 'C''est la troisième fois que je fais cette recette et vraiment à chaque fois c''est un succès. Je change le poisson à chaque fois, sabre, flétan, enfin bref je n''arrive pas à dégoûter mes invités ils en redemandent toujours....en plus la sauce avec le brin d''aneth HUMMMM tout simplement.', '2006-11-26T21:49:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31836, e1eca810-c9db-48cc-a9a1-a354d6c8fd2d, 'Très bonne entrée pour une réception. J''ai remplacé le colin par des filets d''églefins, c''est délicieux et très fin. Servis à l''assiette, cela fait beaucoup d''effet.', '2006-10-01T20:51:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31836, 506bbba2-e55d-46f3-bca0-26ef396a09e2, 'Rapide en préparation pour un résultat délicat. Accompagné de riz, il suffit pour le repas du soir.', '2006-08-05T21:31:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31836, 92f87b51-2c02-4f6e-8078-3b987479bb60, 'Très bonne recette, très rapide à faire mais il faut mettre l''anteh (pour ceux qui aiment) dans la mousse pour donner plus de goût et ne pas saler cette mousse car le saumon fumé est généralement déjà bien salé. Moi je préfère faire une sauce aux crevettes grises plutôt qu''un beurre citron qui est assez calorique et gras.   ', '2006-06-11T09:45:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31836, ac61dee1-b36e-405b-a6ca-de60921578d7, 'Très rapide à faire et une fois dans l''assiette ces petits dômes de poissons épatent tout le monde.  Il faut, je pense, mettre quelque garniture, par exemple des toasts recouverts d''oeufs de lompes, quelque feuilles de persil...', '2005-05-15T12:55:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 266dc3d2-1ff2-4283-bee5-1f8e246b2867, 'Super recette ! Je me suis un peu trompée car la quantité de lentilles c’est quand elles sont cuites donc j’en avais fait cuire trop… Sinon la recette est bien expliqué et c’est très bon 
', '2023-06-07T19:54:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 4a413dc5-99be-45b4-8bab-16b587034182, 'Excellent.  J''ai rajouté de la tomate 🍅l''oignon violet, la salade. Mais je n''en reviens pas. C''est bien meilleure que fait avec la viande. J''ai pris la recette du pain à burger sur la même appli.', '2023-03-08T14:13:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 1a45d44f-66f2-4a78-9db7-5075bffc82ae, 'Delicioso !', '2022-10-05T21:39:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 66b82d50-d881-4fd7-b555-e6cc4d8a44dc, 'Savoureux, tendre. Parfait !', '2022-09-10T21:33:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 1d0aed58-d88b-47f5-97b8-7e3889f6bef8, 'Trop bon! À la sortie du four, j’avais peur que ce soit sec, mais les galettes sont en fait hyper moelleuses !
Avec un bun fait maison, quelques tranches fines de tomate, des feuilles de jeunes pousses, des rondelles d’oignon rouge et des lamelles de cheddar, de quoi faire un burger veggie gourmand ', '2022-01-22T12:43:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 9f3c3b42-7d50-4f4a-a5fe-ba47c20c4be7, 'On a été bluffé! C''est la première recette végétarienne de burger qui est à notre gout. J''avais oublié la carotte mais cela reste très bon. On peut aussi ajouter cette préparation à de la viande pour réduire la quantité de viande nécessaire. Merci! ', '2021-08-19T19:40:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 9776aa81-5416-4349-b79f-82d64d8a8623, 'Recette parfaite. Rien à ajouter', '2021-07-23T14:14:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 080788a7-fff4-408e-b3f4-eb35121677cc, 'Top, j''ai suivi la recette à la lettre et j''ai été bluffée, toute la famille a adoré !', '2021-04-27T18:26:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 7efbb4a0-ff41-43c1-a6a2-750c1954c3d9, 'Très bon. ', '2021-04-18T13:57:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 8fac7fa4-741e-4fae-8234-f57eacaa76c9, 'les galettes sont délicieuses !! pas du tout sèches et remplies de saveurs :)', '2021-04-06T19:42:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 8cf8966a-e679-4519-8064-d18f90b43820, 'Super bon et facile à réaliser. J''ai utilisé de l''oignon rouge et du cheddar', '2020-12-25T15:55:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 6f693cca-bd2f-4e9b-b360-f978c60a929f, 'Hyper facile, bon et c''est tellement agréable de faire des boulettes comme avec de la plasticine. ?', '2020-11-02T16:31:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 03401234-f545-4322-a13d-ccd009c98600, 'Je suis végetarienne, et ce steak est parfait autant dans les burgers que simplement en accompagnement ?. Il n''est pas du tout sec et a la meme consistance que de la viande.Je recommande la recette a 100%! ?', '2020-06-24T20:17:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 999de4b5-125c-427b-bb24-d2fb907934a8, 'Jai remplacé les lentilles vertes par des lentilles oranges, délicieux également ? ', '2020-05-06T10:48:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 4c102c58-4e74-42ce-bb43-88939ce91a8e, 'Un régal ! En divisant la quantité de lentilles par 2 j’ai fait 3 galettes.', '2020-05-02T16:07:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, fecd3ed5-f178-44f1-9499-bd003704c4d1, 'Burger très bon, le steak aux lentilles juste parfait. Consistant sans être sec. Par contre j''en avais 2 fois trop, j''aurai pu faire 8 burger ! Une réussite,  merci pour cette recette', '2020-04-27T20:46:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 8ed43f45-9f38-4fa7-b89b-e6b9acceffe7, 'C’était délicieux nous les avons mangé avec des buns maisons', '2020-04-12T16:49:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, f00883d0-1281-444d-a6a3-c2b0002a7a86, 'C''est délicieux ! Nous avons ajouté des tranches de cornichons Malossol et d''oignon rouge cru. A refaire avec différents fromages.', '2020-01-25T13:35:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 00141887-518e-4c3b-aba2-8ba68b296b5d, 'Parfait ! Très goûtu et pas du tout sec ! La consistance est parfait !', '2020-01-25T13:01:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, a1456f39-521d-4031-a391-c53058d2db0f, 'Trop top ! Je mets juste du cheddar.', '2019-03-22T08:20:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 95431cf0-df17-4214-96c5-b7dc7fb83642, 'Super.', '2018-11-24T04:12:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, b7ad05cf-b06a-46fc-bbea-d3ba41e7a5eb, 'Excellent !', '2018-08-26T03:57:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345408, 82ecdeaa-fbea-4e97-82c5-1ed2353b192c, 'Délicieux !', '2018-04-30T06:55:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212671, 2f4cef9b-47b5-4b53-8136-cd1bf0266985, 'Pas mal comme base, j’ai ajouté une cuillère à soupe de maïzena, de la ciboulette, un délice 👌', '2022-11-16T20:42:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212671, fb27a849-ac71-4ad0-8539-57d6f1936c74, 'Simple, rapide... efficace ! Très bonne base de sauce que l''on peut par la suite agrémenter selon nos envies (ciboulette, citron  .... )  Très bonne nature aussi !', '2012-09-01T15:10:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212671, db1881db-b4cd-402e-a14e-74c5a232c585, 'Simple et super efficace !!', '2025-09-20T20:52:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212671, a4fb3415-7714-4f1a-8ab1-c5398a295583, 'Simple et délicieux.  Merci', '2022-03-10T15:57:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212671, d48be7cc-de32-4478-aa2a-5478cf974a59, 'Sipew😋', '2021-05-18T21:09:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212671, 6befdd62-b167-4c84-9ad8-7630e6610a6a, 'Simple et top.', '2016-01-02T15:59:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212671, 47ff11fc-ca01-4e2a-a70d-2cfd72006ae9, 'Simple et très bonne.', '2015-08-12T15:49:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212671, 196b2369-0d6c-48ed-96f9-87f4bd38c79b, 'Très simple et très bon : parfait pour améliorer un plat de poisson !', '2013-12-31T15:20:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35837, f50b9a14-c28d-4bb3-8460-24bba6c13274, 'Très bon, les enfants ont adoré, pour la viande, j''ai haché moitié boeuf et moitié chipolatas, gratiné le tout avec du parmesan, c''est excellent', '2007-07-21T19:05:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35837, 8c0cb534-0caa-4cd3-951d-8c3ee4a4eff4, 'C''était très bon. J''ai utilisé des épinards hachés congelés. J''ai rajouté de la crème fraîche liquide. Attention à ce que la sauce tomate soit trés liquide sinon les cannelloni sèchent. ', '2005-08-21T19:23:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35837, b094f782-2126-4676-ba6f-bc1e2efb8903, 'Un peu plus d''épinards, un bocal de sauce tomates + un peu de crème light et des épices pour napper les cannelloni (20) et un peu plus de gruyère râpé au-dessus: un délice!!!!', '2005-05-06T20:09:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35837, ef5b38a8-c213-4fb2-9f09-85ccca885e4e, 'On a adoré', '2021-10-19T16:52:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35837, 08ab17e3-7307-450c-8207-951fc2632dcd, 'Aucune saveur. Au lieu de mélanger les épinards et la sauce tomate, qui ne se marient pas du tout, mieux vaut rester dans le simple et le bon... ', '2012-05-28T18:09:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35837, 0efeab8e-47dd-4c23-ad29-30074a94f39d, 'Bonne recette mais sans plus. Le goût des épinards est masqué par la sauce tomate. J''ai ajouté du mascarpone à la sauce et de la béchamel sur les cannellonis. Cela restait cependant assez sec. Peut-être ai-je raté quelque chose ...', '2012-03-11T22:49:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35837, 54d7c639-4bed-469d-9eae-e27683b62589, 'Délicieux, petits et grands se sont régalés....', '2012-02-18T15:13:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35837, 75603830-b4dc-4e12-8d71-832896026377, 'Très bon ! J''ai mis un peu de gruyère râpé dans la farce et j''ai ajouté un bouillon de volaille à la sauce tomate. Très bon et très facile à préparer.', '2012-01-15T14:21:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35837, 2889d560-141d-44e8-a335-69c0fe21e7a5, 'Vraiment très bon. Facilité de réalisation impressionante. Pour la sauce tomate, j''ai utilisé une sauce faite maison et c''était délicieux.', '2008-10-18T15:29:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35837, 3503649b-dbfe-4402-a4db-09ac38238d96, 'Je l''ai fait avec un peu de crème fraîche avec les épinards et un petit peu de béchamel sur le dessus avec la sauce tomate. Les enfants ont tout mangé!', '2008-08-14T11:12:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35837, de4407ec-b92e-4bbb-8615-e2ab195ec29e, 'Trés bon. J''ai également ajouté des petits morceaux de pain durs et du lait.', '2007-10-28T00:53:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35837, e0261b6e-e3cf-4638-85c4-6eb16952428c, 'Super! Et surtout délicieux! Merci! Peut-être que maintenant mon copain voudra bien m''épouser...', '2007-10-06T18:00:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35837, 624f46da-ba57-4074-9b77-ed30f531c175, 'Super bon, moi j''ai rajoute un peu de crême fraîche en plus dans la sauce et c''est super bon', '2007-09-25T18:47:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35837, 2ffae34d-6ade-4b38-80f8-9b3e77185a17, 'C''est effectivement super bon. Epinards hachés surgelés, pas d''oeuf et sauce tomate abondante faite maison. Le tout recouvert de tomme (je n''avais plus de gruyère !). Les proportions sont exactes au gramme près. C''est en plus facile à faire, ce qui ne gache rien. Bref, une recette qui a tout bon.', '2007-06-29T11:29:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35837, 694de4cc-747c-4230-bbda-1fb69a218802, 'Délicieux !!! Mon chéri en reparle encore et encore c''était la première fois qu''il en mangeait et c''était parfait juste avec un peu plus d''épinards et un peu de crème dans la farce.', '2007-06-14T16:42:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53672, a66278c9-249e-43ac-ad07-2b3b386a79b3, 'Très bonne recette, proche de la "salsa verde" utilisée en Italie pour accompagner la viande bouillie du pot au feu. ', '2016-12-27T23:55:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53672, a0a00105-22d9-48d0-a7f4-0266038d1dd4, 'Très bonne sauce (plutôt pour poisson à mon avis). J''avais peu de temps, j''ai donc tout mixé au robot (pas assez de persil dans mon jardin, j''ai donc fait un mélange d''herbes : persil, ciboulette, estragon frais auxquels j''ai ajouté des herbes déshydratées : aneth, origan... ce que j''avais dans mon placard). J''ai également mis les blancs d’œuf durs. ', '2015-09-27T14:58:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53672, d14c7801-cc94-4bdb-bf6f-e4a7a737ee5c, 'Excellent ! Se marie avec nombre de plats.', '2012-12-06T21:07:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53672, 0c4f610a-0400-4378-8ca2-676ff7d1a861, 'DÉLICIEUX ! Je l''ai faite avec un saumon cuit et servi froid accompagné de différentes salades. C''était une pure merveille. A faire et à refaire. Prochainement, je la ferai avec de la viande cuite sur barbecue. ', '2012-05-23T19:31:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53672, 9a8e0516-b5a5-48de-9662-91a7678ce413, 'Un délice avec la poule et viande du pot au feu ! J''ai utilisé le reste en tartinade, en y ajoutant quelques cubes de tomates, miam ! Merci !', '2010-06-26T16:56:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53672, 1873a477-1d72-4e11-8d24-3a75e5b8a16e, 'Excellente, j''en mets un peu partout, poissons, beignets salés, crudités, brochettes... Merci pour cette recette', '2010-03-16T11:37:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16456, 8e7dc2b0-77a8-44d6-bbae-d8d94c538e42, 'Je n''ai pas du tout aimé cette recette, jai du modifier quelques ingrédients comme la menthe et le yogourt. Recette que je ne referai pas.', '2005-01-22T15:57:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16456, a3b924df-fad5-44ef-b2f5-b5bf0f4d6b6f, 'La présentation sous forme de brochettes est très peu pratique, en effet les boulettes ne sont pas assez consistantes pour tenir sur les piques. Nous n''avons pas utilisé de viande d''agneau mais c''est une très bonne recette, appréciée par les convives!! Avis à tous les gourmets!!', '2004-06-12T20:23:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16456, d93f2491-f2b0-48c8-a8ca-7c3b2cae4b8b, 'Très bon, mais j''ai fait quelques adaptations. Je n''ai pas utilisé de hachis et je n''ai pas fait de boulettes. Je n''avais pas de yogourt nature alors j''ai utilisé un yogourt aux poires. Louis n''aime pas la menthe, alors je n''en ai pas mis non plus. J''ai servi dans la sauce. Il n''en restait rien!', '2002-08-01T19:14:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16456, fca5859e-9310-4f4d-b9ca-8cf72d7f8e6a, 'Il manque quelque chose qui relève les brochettes: du cumin, plus de menthe... Attention de ne pas les faire trop cuire car sinon c''est sec. Le montage sur la brochette en bois n''est pas évident, je les ai mises au congélateur 1/2 h avant de les mettre sur le barbecue pour que l''ensemble tienne. Peut-être faut-il rajouter 1 oeuf?', '2002-06-09T18:23:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345086, 0b434352-9a76-4671-8f7d-2baa35afbcc3, 'Recette excellente. Simple et efficace.', '2019-01-14T02:45:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345086, 5abc0382-5853-4e10-874d-a7965d8bc236, 'J''ai bien aimé, mon copain a adoré ! J''ai peut-être mis trop de gruyère mais très bon !', '2022-10-17T22:56:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345086, d862016f-d28e-408e-83d7-b28cb1defbcd, 'Très bon et facile à faire.', '2017-03-07T22:16:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345086, 2ad76d4f-44f8-43ba-a914-3a2531a2f7d2, 'Super recette originale je trouve ! je recommande ! pas très long a faire en plus !', '2016-09-05T23:03:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64022, 93667844-316a-4477-b58b-56b8843eac9e, 'La poignée de gruyère est totalement inutile, la mozza suffit... Sinon très bon résultat!', '2008-03-13T12:10:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63572, 3873e610-0e0b-4e79-997a-b04d32897eae, 'Simple et efficace ', '2022-07-03T23:22:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63572, 27a29793-96a4-447c-9df4-dd21ad41321a, 'J’ai remplacé la muscade par une cuillère à café de miel, délicieux avec des tournedos !', '2019-10-08T20:00:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63572, 3a866f04-8bfb-4a7c-8680-cd59e8cb7e88, 'Quant à moi je fais revenir à feu très doux (sans dorer) des échalotes dans lesquelles j''ajoute ensuite la crème et l’époisse (c''est le fromage de chez moi) !
', '2018-02-05T12:47:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63572, 4615dfcd-506d-43e9-bbb8-08ab92d75203, 'C''est encore meilleur avec quelques morilles en plus.', '2017-12-11T11:28:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63572, 7bdd8fe3-dc48-474e-a4d2-a58969428aad, 'Super !  ', '2015-12-09T22:54:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63572, abaf46a1-dc6a-4d88-942e-6ffe2c8fa494, 'Diabolique !', '2014-03-02T14:03:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63572, c74ac0a4-bef2-4fcc-8211-50bd2e3bc9ab, 'Très bon mais avant je fais revenir des oignons dans du vin blanc. ', '2013-07-11T13:30:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63572, 4df7229a-43de-49bb-8c05-155d02eaac2f, 'Très facile et délicieuse !!! Merci pour cette recette.', '2009-11-08T12:50:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (63572, 4204e23a-2da4-44aa-a4ab-a80921a47cd1, 'Délicieux et très facile!', '2008-09-28T22:50:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24677, 5027bfc3-b294-411f-9df0-c2d2c6c17f2e, 'Je retrouve enfin la recette que l''on m''avait donnée à Angkor ❤❤ mercii 
J''y rajoute de la patate douce, c''est un délice !', '2018-05-14T06:33:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24677, ca741fa0-2548-42ad-acfc-37c7478c0d00, 'Tout le bon goût du Cambodge ! Encore meilleur avec du curry du pays !', '2014-03-06T21:40:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24677, dd7c1bd9-e525-4cd0-bee5-ff0f4c202e77, 'Très bonne recette !', '2013-02-21T13:33:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24677, f1b1d83e-dc0b-491f-91c9-ef47c66728cd, 'Très bon plat qui reste familial et simple à préparer ! Merci bien !', '2012-03-27T05:27:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24677, 2a377ac9-85bc-4e29-ac7a-47925234e774, 'Un curry banal, une association pomme de terre/riz qui ne nous a pas enchantés...', '2004-11-24T14:50:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24677, 5079d58f-2584-4d0b-b6cc-0b0349dc09c7, 'Délicieux. J''avais tout divisé par deux et ce fut un régal. Il reste toujours aussi, bon même réchauffé au micro-ondes.', '2004-09-07T20:46:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24677, f6250d88-f8a3-4ff6-be20-f80b2f49fa0b, 'Ce plat est absolument délicieux, très facile à préparer et facilement proportionnable, selon le nombre d''amis que vous invitez!! Un plat très digeste que l''on peut accompagner aussi de riz sauvage... Hmmmmm!', '2003-10-29T13:18:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17838, 1dbc4a20-9304-4038-bc9f-35f8238f2aa8, 'Rien à redire tout simplement délicieuse, j''ai juste remplacé le pistou par du pesto j''ai mangé la moitié de la tarte à moi toute seule !!!!!!', '2010-10-08T17:06:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17838, 62310986-a346-4954-bb50-787036665e8f, 'Vraiment délicieuse cette tarte, je n''ai pas mis de hachis de porc (400 g de hachis de bœuf) et mélangé la viande avec les légumes et parsemé de gruyère. Une bonne façon de faire manger des légumes, mon fils de 5 ans a adoré et m''a demandé de lui en faire une autre rapidement. Recette à garder précieusement. Merci pour cette recette. ', '2010-06-14T01:00:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17838, 77445c98-5602-410c-b7fa-0e5a9732ef94, 'Rien à redire, je n''ai pas mis de porc et j''ai utilisé un yaourt o% au lieu de la crème liquide pour que ce soit plus léger.', '2009-02-17T12:41:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17838, ffcf0728-72ec-4002-b01a-6b2535d5f463, 'Très bon permet de manger facilement légumes et en plus c''est copieux néanmoins contrairement aux autres commentaires les épices sont largement suffisantes penser peut être à diminuer proportions de légumes et viandes le plat est à ras bord!!!!!!!!!!!!', '2008-02-14T21:37:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17838, bb006585-dbb0-48d2-a071-6846ed715a61, 'Délicieux et original!!! Une autre façon de manger des légumes et de la viande! J''ai diminué un peu les quantités sinon ça déborde (200 g de chaque viande suffisent pour un plat à tarte à bords pas très hauts), et j''ai simplement ajouté avec ma viande des épices à tacos... hummm! Je n''ai eu que des compliments! Merci!', '2006-01-29T17:49:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17838, 51110870-7bcd-4a23-81ed-3ae3047243e0, 'Miam...Bon et facile à faire(même sans raz el hanout)! Attention toutefois aux quantités de légumes et ne pas hésiter sur les épices! J''ai aussi mélangé la viande avec les légumes...', '2005-09-22T17:04:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17838, 721c5838-2e8c-4ce4-a213-2f0f1c65d8ac, 'Très bon, mais un détail : pourquoi ne pas mélanger les légumes à la viande juste avant de les déposer sur la pâte? Ainsi, on évite que la viande ne déssèche dans le four, sur le dessus de la tarte.', '2004-09-27T16:59:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17838, 1889d34c-aac1-4f1d-a2f6-d5e028f95606, 'Assez long à préparer mais vraiment original, cela change des tartes traditionnelles ! Néanmoins, j''ai dû faire sans le raz el hanout car je n''en ai pas trouvé.', '2003-07-22T15:07:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17838, 87771600-e04a-4cad-972a-fd23d6018f01, 'Simple à préparer, un régal qui fond dans la bouche, un mélange d''arômes succulent!', '2003-03-28T19:08:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 69f3aba7-3b86-422a-94c8-6ddda154c064, 'Hacher du persil, de la ciboulette, de l’oignon et de l’échalote. Y ajouter votre mie de pain préalablement trempée dans du lait et bien essorée. Ajouter la viande hachée (50 % de boeuf et 50 % de dinde), de la sauce barbecue pour le goût fumé. Mixer. Saler et poivrer. Mettre tous ces ingrédients dans un saladier et ajouter l’oeuf et un peu de noix de muscade. Pétrir cet appareil à la main et le déverser dans un moule à cake beurré. Laisser cuire au four pendant 45 mn.', '2020-11-14T23:44:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 2afe164a-c65f-4fc8-8db6-52837edbc8e5, 'Vraiment super. J''ai fait caraméliser un peu les oignons avant de les mettre au mélange', '2023-05-05T00:30:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 0116eed3-064a-4f19-b258-d7f2e7944286, 'On peut aussi faire revenir les oignons et échalotes à la poêle dans un peu de beurre avant de les mixer.... En fonction de la quantité ne pas hésiter à allonger le temps de cuisson.', '2016-12-11T19:16:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, af8a03db-1252-4427-8417-b4288fdb4b64, 'Excellent avec échalotes et cuisson au vin blanc', '2019-03-20T18:04:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, b32e8a93-95ad-44b6-904c-edceb319150f, 'Résultat très satisfaisant pour un premier pain de viande. Je ne l''ai fait qu''avec 350 g de viande hâchée, beaucoup moins de persil et seulement 2 cuillères à soupe de ketchup et c''était bon. Je l''ai laissé cuire presque une heure à chaleur tournante (conseil trouvé sur une autre recette) mais c''est de trop. Je pense que 45 minutes, c''est bien suffisant.', '2016-11-18T16:47:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 5b0dc576-65b2-455f-9359-67ee9f410ee1, 'Très bon.', '2023-10-28T11:13:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, a4acd2dc-7a39-49fd-aded-647a7ee070d1, 'Cette recette est devenue un classique dans la famille. ', '2023-09-05T19:10:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 78cddb44-04f4-4e8c-9169-63f12b73a086, 'Parfait !', '2022-12-28T15:42:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 6d5a628b-a9f6-46bc-b397-5037a435f033, 'Simple à faire et vraiment très bon avec une poêlée d’haricots verts et blancs, nous nous sommes régalés !', '2022-11-17T17:30:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, d0172070-7c33-42c7-9111-fe24e0893894, 'Top !', '2022-11-01T14:55:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 43533be9-47e1-4e88-aa8a-2bb88351e278, 'J''ai essayé cette recette, rien à redire, elle est top. J''ai juste ajouté des champignons de Paris à moitié tranchés et le résultat est génial.', '2022-07-04T20:33:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, c5b64050-886e-4843-b7c5-4bc57e0bd4d1, 'Facile à réaliser, les enfants aiment beaucoup. Avec une salade c''est top !', '2019-12-15T12:52:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 11144e31-8b7f-4850-833c-5801075b4e28, 'Je trouve cette recette insipide !', '2015-12-31T00:19:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 14625597-b679-4bd3-9dd0-472b8015501b, 'Excellent, tout simplement !', '2014-08-24T20:54:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 8942f1ba-4610-4973-a758-a86cfb03d133, 'Super bon, Fait ici avec un oignon rouge , une tuerie 😊', '2025-09-22T20:22:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 64de6220-ce98-4734-a9bc-6ccc68c77321, 'Un seul mot : excellent ! Merci pour cette recette ', '2022-05-25T12:14:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, df51d2ec-ad4c-4d22-81b0-166b5a8a74c5, 'A refaire !', '2021-05-09T15:57:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, cd7255a1-6756-41bc-a779-b5cb436367d0, 'Délicieux ! J''y ai ajouté une cuillère 1 café de moutarde et du poivron vert mixé. Un délice ! 40 minutes au four, il était moelleux à l''intérieur et croustillant à l''extérieur. Du bon pain de viande ! J''en referai.', '2020-12-02T08:06:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 7d3e354f-6abf-4426-9813-d4f6900c0723, 'Recette a retenir. Nous avons remplacé la muscade par du curry. 
Excellent,  moelleux et goûteux.', '2020-08-11T20:20:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, f721aa02-6904-4ffb-86be-83fe0b3e8bf3, 'Sans intérêt.', '2019-05-30T06:52:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, e9ce0a0e-6541-4def-8119-0d7b5ef28c19, 'Recette simple et rapide. Réalisée ce soir et mangé chaud. Tout le monde a aimé, même mon fils qui n''aime pourtant pas grand chose ! Il en reste un peu à tester froid demain. Au vu des commentaires, on peut y mettre ce qu''on veut alors j''essaierai avec les restes de viande ou de légumes du frigo une prochaine fois. Finalement cette recette, en plus d''être simple, elle est pratique pour éviter le gaspillage !', '2017-01-22T00:17:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, c8c6d461-f80d-4f43-aee5-b1d8ef7d6d17, 'Délicieux, mes enfants en mangent à coup sûr si je fais des portions individuelles. Ajoutez des épices c''est encore meilleur.', '2017-01-13T19:40:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, fb8020cd-4062-4cbc-8018-566b07d9d2fc, 'Pain de viande délicieux, le ketchup épicé donne un bon goût. Merci pour la recette.', '2016-11-02T14:13:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 9ccdfdb5-76c3-46bd-8d74-a4335db6283a, 'Très bon, j''ai mixé avec la viande un reste de champignons et j''ai cuit le pain dans un moule à cake. Mes enfants, 6, 9 et 11 ans ont adoré.', '2016-10-26T16:54:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 436723ef-3877-43d4-b8ee-3c98a6ff39ba, 'Très facile et excellent avec une petite salade', '2016-05-07T21:13:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 0f668379-ca02-455d-8a08-ae3bbcceda3f, 'Pas mal du tout. Habituellement je prépare du pain de poisson, mais j''avais envie d''essayer pour une fois le pain de viande et je ne suis pas déçue. Visuellement des améliorations sont possibles mais le goût y est. A noter que le persil peut être remplacé par de la coriandre. Servi avec de la sauce aurore, les invités se sont régalés. A refaire et à améliorer ! ', '2016-02-14T16:48:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 99115d1c-e1d6-474c-a1ee-e0322681a731, 'Très bon, fait avec moitié veau et moitié boeuf. Mon conjoint a tellement aimé qu''il en a repris 2 fois !', '2015-11-22T20:59:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, ba2a4e4b-d742-4e04-8e73-74a67eb456bf, 'Une bonne sauce marinara maison remplace avantageusement le ketchup', '2015-11-06T08:45:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, abf61e47-8320-4f9e-85fa-ff9c6b64731e, 'Délicieux, j''ai ajouté de la sauce tomate et du gruyère râpé. Je conseille cette recette rapide et simple. ', '2015-11-01T18:13:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 928315ac-2285-422e-b0f3-dc0a80865446, 'Très bon mon copain a vraiment aimé j''ai respecté la recette à refaire ', '2015-10-27T19:33:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 88317467-bc28-4d7f-804e-74219ec91acb, 'Super recette !! Bon, facile et rapide à faire.', '2015-09-17T23:32:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 95006dcf-8781-4103-bbb3-eddf996ef6a5, 'Très bon, merci pour cette recette, j''ai mis du ketchup "normal" et du piment et j''ai suivi les conseils d''une internaute en rajoutant du bouillon de bœuf avec l''œuf. A refaire', '2015-09-12T23:16:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, dd6019f6-1418-44a7-b15f-1db05ffe5d64, 'Je le fais dorer à la poêle pour qu''il tienne puis je le fais cuire dans une sauce tomate, accompagné de pâte ou de pommes de terre c''est toujours parfait. Je mets aussi un peu de lait sur le pain pour rendre le tout plus moelleux et je n''hésite pas sur les herbes fraiches !', '2015-02-02T19:48:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 6106d91e-08ca-452d-bdd9-a575b7f62ad4, 'Délicieux. Je cherche à faire la croûte maintenant.', '2014-11-25T11:21:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 0a1d30ec-4f33-4303-8883-2b4edc38968d, 'Comment sait-on si le pain de viande est cuit comme il faut ?  ', '2014-08-27T21:33:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, e2f3e5d4-0fd5-4812-b209-348be3eee028, 'J''ai remplacé le persil par des câpres, ajouter un peu de sauce worcestershire, méthode tartare, et tout le monde a aimé aussi bien chaud que froid ! ', '2014-06-08T12:02:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, f6c2f6a5-d080-4845-865d-34b0efd43c00, 'C''est vraiment très bon, j''ai ajouté du gruyère râpé c''était délicieux, à refaire sans hésitation.  ', '2014-06-06T10:59:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 8bf649cf-4541-4f49-bd60-3c624733520d, 'On a l''impression de manger un pain de persil à la viande. Je déconseille cette recette', '2014-05-10T14:49:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, c333d63f-e09d-4e26-8af4-50d704df21bf, 'Avec une petite salade verte c''est parfait, un nouveau classique à la maison !', '2014-05-07T21:37:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, d7349b13-f3d9-499b-abf1-7d6020a03981, 'Juste excellent. Cette recette fait partie de mes favorites. Je n''avais pas de ketchup épicé mais j''ai juste ajouté une pincée d''harissa. ', '2013-01-19T19:44:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 445e8d1b-7e0a-4b8e-971c-621cb0376748, 'Juste excellent. Cette recette fait partie de mes favorites. Je n''avais pas de ketchup épicé mais j''ai juste ajouté une pincée d''harissa. ', '2013-01-19T19:44:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 56937a65-fc8f-40e0-a12c-8825e27ff712, 'J''ai varié un tout petit peu, j''ai mis 500 g de viande de porc et 500 g de veau... Le reste idem... Super bien épicé !', '2012-09-18T22:24:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 3219c0f3-856a-4c89-a365-edc17e2d2d02, 'Juste excellent. Rien à redire', '2012-08-31T00:10:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 2120ca88-87ee-4173-b872-2c547b72bd86, 'Très bon, le ketchup rehausse vraiment le goût !', '2012-02-24T12:13:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, c7642fc9-1de7-414e-9edf-6af945d1506c, 'Déjà fait a plusieurs reprise, en remplaçant le ketchup par du coulis de tomates et des épices (je n''ai jamais de ketchup chez moi), j''ai été pleinement convaincu (et mes amis aussi)  je vais le retenter demain, en ajoutant des carottes, ça ne devrai pas être mauvais... ', '2012-01-27T19:59:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 98737aa5-dac3-478b-b788-88450b082256, 'Extra ! J''ai ajouté deux gousses d''ail pour relever un peu mais je n''ai pas mis de muscade.', '2011-12-28T19:02:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 6d4d1d34-238a-4066-afc5-f4148fa3770b, 'Très bon, j''ai mis de la sauce tomate assaisonnée aux 4 épices, à refaire...', '2011-09-03T10:54:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, d6a0fcd1-7af2-4507-ac75-2fe1b8fe8167, 'Quelle régalade !  ', '2011-08-26T22:06:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 272cb6a0-8a0d-4db8-96bd-46f006288b23, 'Très facile à faire et très bon. N''ayant pas de ketchup, j''ai remplacé par du concentré de tomates. A essayer avec un peu d''ail, ou de tabasco peut-être pour relever un peu le goût. Merci pour cette recette.', '2011-05-15T22:09:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, cf665760-9c41-42dd-be60-6ac7582ab3ad, 'Facile et excellent. J''ai ajouté une courgette qu''il me restait. ', '2011-04-08T14:47:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, cf8ce400-3a2d-47af-82f4-b61a147972c0, 'Très bonne recette, pour ma part haché porc et veau et sans ketchup. Il est très vite parti!', '2011-04-01T13:56:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 061751bf-4edd-4ef7-a8df-b8f16e11d618, 'A chaque fois que je le fais tout le monde le trouve très bon...', '2011-03-18T02:21:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 6d4162bb-3abd-4efe-bde0-48fc8b9f2159, 'Tel quel Excellent !!!! Merci pour la recette.', '2010-06-11T21:30:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, b2983608-9463-4eb0-9422-a5e3bef813ae, 'Testé hier soir pour la première fois. Sympa, mais je pense que la prochaine fois je remplacerai le ketchup par de la sauce tomate ou des tomates concassées. A tester comme farce pour aubergines ou courgettes ...En bref un bon petit plat pour la semaine, pas compliqué et qui change du steack haché purée . A garder ', '2010-03-26T17:02:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 8bcd45af-0132-45d9-bbce-3f8ee3e73d68, 'Très bon ! Cependant j''ai pris du haché de campagne déjà préparé donc... et ai mis du sel donc ce fut un peu trop salé avec le ketchup... Voilà seul conseil : si haché de campagne ne salez pas !!!! Mais cela a quand-même fait le bonheur de mon chéri.', '2009-11-20T20:19:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 4effefa5-2ff9-42d1-b954-e9b46700bcff, 'Nous avons trouvé ce pain de viande vraiment très bon, très facile et rapide à préparer, miam miam, merci ', '2009-11-15T18:32:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 3fcc14ea-636b-41e1-bf71-ea6ab699af0d, 'Super bon. Perso, j''ai remplacé le ketchup par un fond de sauce tomate qui me restait. Un vrai régal.', '2009-10-14T18:02:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 8b276c19-f47f-4347-95a1-08f9adbea82e, 'Excellent on a adoré,10 minutes avant la fin de la cuisson je rajoute des carottes cuites et 300ML de fond de veau accompagné de frites,purée... un régal. ', '2009-02-17T15:33:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 80d0866e-559a-4f50-9974-84ac64de424a, 'Excellent chaud comme froid. Variante agréable du pain de viande habituel.', '2008-10-17T19:04:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18189, 6ac01126-ebf3-486b-8579-50537c8c19fe, 'La recette est facile à réaliser, mais le résultat n''est pas encore au top.  D''après les convives, la cuillère à café de sel est "too much".  Le ketchup suffit largement.  Par ailleurs, le goût de la viande de boeuf n''est pas terrible, terrible... Je réessayerai donc volontiers la recette mais sans sel ajouté et avec un mélange de viandes hachées plus "goûteuses"... à suivre donc... ', '2007-08-29T23:50:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14451, 6a39fbc9-d608-4d18-b94d-20bdfc7449d8, 'Pour 1 yaourt (4 kebab), je mets une demi-cuillère de sel et je remplace la menthe par 1 cuillère à café de cumin en poudre. Avec un kebab à la viande d''agneau c''est sublime !', '2008-02-25T16:56:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14451, 301b2ed3-5247-4a74-bcce-9d50f3a1bf86, 'Très fade ! Bien meilleur avec plein d''aïl !', '2020-03-17T12:27:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14451, a06753da-aa6d-45ac-8d16-1132e2841910, 'Très fade, je pensais que les turcs mangeaient plus épicé, nous avons trouvé cette sauce très fade dommage', '2008-05-29T10:28:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14451, 50617a45-8016-45b5-83a2-e0088d5ad4e7, 'Top! Avec ajout d''un peu de jus de citron et d''ail en poudre pour ma part...', '2008-05-23T23:17:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14451, a63aa0dd-b721-4818-9010-0f5415fc34cf, 'Très très bon! Et facile à faire mais je mets du lait à la place de l''eau c''est encore meilleur ! A vous de l''essayer!', '2007-04-03T21:13:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14451, d1f54101-4460-4028-9072-a3effea57236, 'C''est super bon et facile à faire. Je rajoute un peu d''oignon haché dedans c''est encore meilleur.', '2005-06-01T18:06:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16545, 8eb550bd-0785-46d1-b232-c6d2f769f252, 'J''ai suivi les commentaires, un peu moins de lait, plus de sel, plus d''épices... Parfait !', '2013-07-29T18:38:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16545, d1275569-f524-4c7b-9cff-34a15dfae497, 'Cela vaut vraiment la peine de faire ce pâté maison, tant j''ai reçu de compliments de mes invités, bon j''avais oublié la barde de lard, et je ne pas fais la gelée, j''ai divisée la préparation dans trois petites terrines...un régal.', '2009-02-05T17:44:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16545, a9a81bc4-7587-4325-8808-9a64bbc7b3d2, 'Parfait avec 30 cl de lait.', '2004-07-11T09:03:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16545, 484eb0a9-6afa-4993-9122-1f3755f58874, 'Je l''ai fait pour le buffet de baptême de ma fille dimanche et c''est un succès!  Pour la cuisson, une demi-heure avec le couvercle de la terrine et lh sans le couvercle. Cuisson au bain-marie.', '2004-04-27T13:42:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16545, ad4f39f9-6bf0-4e1e-8a1d-b52f59c109ff, 'Excellent! J''ai toutefois ajouté un oignon revenu, du persil, 2 au lieu d''1 cuillère à café de sel, seulement 3dl de lait, ainsi qu''1 cuillère à café de mélange 4 épices au lieu de la muscade seule. Cuisson 1h40 avec couvercle.', '2003-06-02T13:07:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, e5b0a95c-7856-44f4-8e30-0ac8f149ca57, 'C''est top ! 2 petites modifications à la recette : je hache l''ail avec l''oignon et donc je le laisse, cuisson au four en badigeonnant les triangles d''huile, très bon et moins gras.', '2019-04-06T07:49:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, ef515f2b-815a-48a9-bb82-ea769883145d, 'Superbe, elles ne sont pas sèches. Tous le mondes a adoré', '2022-04-03T23:24:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, c51e8d6b-f5bc-45db-b3aa-2626ad6c4fa5, 'Excellent ! J’ai ajouté quelques feuilles de menthe hachées et une cuillère de quatre épices. Tout le monde s’est régalé.', '2019-05-26T14:24:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, c9da3908-b040-4c65-bd05-f647f751fca3, 'Très bonne préparation !', '2022-11-23T20:13:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, 3c93131a-7bd9-4033-9569-2e0e0739721b, 'Très bon', '2021-05-06T16:32:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, d054f32d-02cc-42f6-a178-f74952d9bbd5, 'Parfait.', '2020-02-04T12:04:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, 4779ff87-1823-4c4d-8a62-b11dde206c85, 'Super, tout le monde a adoré, je recommande cette recette.', '2019-03-29T13:21:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, b459e771-f98d-424e-ba49-a69758978bf0, 'Très bon !', '2018-08-22T03:18:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, ac00d832-448d-47d1-ae86-7f307e20cfa1, 'J''en suis fan !', '2016-11-03T20:50:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, 2b7e1843-12a7-48d2-acaf-67e9bb45dafb, 'Excellent !! J''ai ajouté une cuillère de concentré de tomate. Merci pour cette recette.', '2016-05-23T19:52:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, 38d8edf7-0599-497d-a438-98a71a96e54f, 'Très bon, servies avec une salade verte. Je mettrai un peu plus de moutarde pour relever encore plus le goût.', '2016-03-06T16:22:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, 1b5fc8f4-7617-4adb-8b6a-caec93c1f7ac, 'Une superbe recette. ', '2014-08-06T13:21:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, 4ee674df-ed99-4925-a291-9b63c16bfa5e, 'Faire la même chose avec des crêpes !!! Bien plus économique quand on vit du RSA et qu''on mange dans les Restos du Coeur.', '2014-07-27T12:07:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, ebbbe856-63da-4b59-b1db-bbd208064dac, 'A défaut de ne pas avoir de moutarde ni d''ail, je n''ai mis que de l''oignon et de la mayonnaise et j''ai rajouter des morceaux de kiri a la fin pour ne pas qu''il fonde. On s''est régalés. A refaire !!!', '2014-07-14T20:16:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, baadeb10-8b0b-45e6-9c4e-b62a67c193c8, 'Très bon facile à faire et rapide', '2014-05-29T23:47:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, 9d6796b2-b9b2-4522-b221-1690ce6b9415, 'Très très bon et facile à faire.', '2014-05-04T14:09:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, e547a32b-a099-433b-af63-720f21207b07, 'Très bon !', '2014-04-02T20:36:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, 315f10de-9b6b-4a69-be1d-fc6641699f8f, 'Une tuerie, on a trop aimé. ', '2014-02-19T21:50:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, e79da146-fa61-46e8-8e79-5ac130a942ba, 'Très bien avec crème semi épaisse. La prochaine fois a essayer avec crème fraiche. ', '2014-02-17T07:51:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, a51ac61f-daeb-4e0c-bd7f-6857ace78c0b, 'Super bon, rien à redire !', '2014-01-31T14:00:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, 8571dfa8-d42d-4350-af88-54448039d3a2, 'Un vrai délice, je garde la recette !', '2014-01-10T14:39:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, 3dae4f5f-ff13-455c-9db0-af4aacf75207, 'Excellent !', '2013-12-30T13:35:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, 1f6fb7fd-0438-4ea4-adaf-284b9c8db508, 'Très bon ', '2013-12-06T19:09:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, 68614aeb-6d55-459d-b908-e56579da84e0, 'Parfait !', '2013-12-01T22:30:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, d8825c0e-8351-4a35-913b-70d54730cc5a, 'Waw! Excellente recette : simple, rapide, et délicieuse! J''ai bien assaisonné la viande, ajouté du basilic, et plié les bricks sous forme de samossas. Merci pour cette belle réussite.', '2012-08-20T00:16:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, 7188ea43-978f-4854-a107-eb8acbae2568, 'J''ai également passé ces bricks au four afin qu''elles soient moins grasses. Délicieux ! Idéal pour un apéro dinatoire.', '2010-04-13T17:58:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, a761f7a2-7032-4cc8-a75d-9c8daa7be583, 'Recette super, j''ai juste fait chauffer les bricks au four et quelques minutes sous le grill et c''était très croustillant et pas gras.', '2009-06-28T21:39:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81512, 8d75e39f-90cd-4be1-9c5d-48773c725cbd, 'Mmm!!!!!!!!!! Je recommande cette recette à toutes et à tous!! Facile et original!!! Merci !', '2008-09-25T01:31:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168993, 1dcfc401-8d27-46be-b365-419e56383643, 'J''ai ajouté un peu de poudre de paprika, du cumin et du carvi moulu. Ah, oui et une c à c de moutarde. ', '2022-06-09T23:54:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168993, ea1269fe-8f52-453c-aa6d-3ac85cc37525, 'Pas du tout sec j''ai rajouté un peu de concentré de tomates dans la recette pour moi 1heure a 200 degrés parfait !', '2016-09-28T15:42:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168993, c56985c2-3bb3-48c8-97f9-41fc9822bedd, 'Une tuerie, j''ai ajouté de la julienne de légumes et un pure délice ! J''ai joint une photo.', '2016-03-23T23:15:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168993, 71797cb0-8aa1-4f8d-ac90-95d8edb546a7, 'Sceptique au départ (rien que du boeuf, et sans oeuf, cela doit être sec et se défaire). Mais j''ai quand même essayé, et j''ai bien fait : c''est délicieux, moelleux et ça se tient. N''hésitez pas à tester ! ', '2016-01-26T19:25:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168993, 2a990a55-26e1-4121-b719-ab9ccc5666a4, 'Vraiment très bon avec une petite salade le soir, c’est parfait. Merci beaucoup.  ', '2023-05-18T19:03:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168993, 4274a6fc-704a-47d6-9326-6aed6a1e331b, 'Excellente recette et très moelleux.', '2017-02-10T20:48:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168993, 13404507-365a-420e-8d19-71a6f7e31972, 'Mon fils de 4 ans a adoré ... simple et rapide.', '2016-07-05T13:02:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168993, 0e826cdb-cb23-4e8f-bde1-ae8aeefc13b2, 'Bonne recette de base, un peu sèche et trop fade. Ne pas hésiter sur le lait pour le trempage du pain de mie et encore moins sur les épices !!! ', '2016-05-02T20:36:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168993, fd899732-6798-46ed-8fa4-8c95a31a6893, 'J''ai respecté à la lettre en ayant doublé les proportions pour un pain de viande d''1 Kg.  Une botte de persil complète y est passée et c''était parfait. La dernière demie heure de cuisson j''ai mis dans le plat, des pommes de terre en quartiers et épicées à la provençale .... Un délice, je joins une photo  Le lendemain, les deux tranches froides qui restaient étaient exquises !!!  Merci pour cette recette', '2015-10-22T20:05:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168993, fad51083-853c-4956-bd9a-984b5e5b4288, 'Recette facile et rapide. Rien à redire', '2015-07-10T02:17:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168993, d497ac88-185f-4a14-9c3b-889eeda3af3d, 'Excellent ! Merci pour l''idée ! En effet, il ne faut pas hésiter à bien épicer. Je l''ai, en plus, accompagné de petits poids et carottes lors de la cuisson au four... Un vrai régal !', '2013-04-22T21:16:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168993, fdd266a0-70fe-40be-8bd5-390038b9dcd0, 'En effet, ne pas hésiter sur le sel et le poivre, j''en mettrai plus la prochaine fois. Pour la cuisson 60 minutes, d''un four à l''autre ça dépend toujours. Très bon.', '2012-10-30T23:04:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38412, c3cb6cf0-791a-4d00-b868-53af6790f157, 'Très bon même froid !', '2023-07-07T15:20:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38412, 82c6be2b-7a8c-46a0-8d47-dd927c4b153a, 'Très bonne recette, facile à faire ! On peut agrémenter avec un peu de fromage ou du poivron.', '2022-10-03T20:02:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38412, 396b5aef-2b5e-429f-9641-d0349b996c18, 'Moi qui ne suis pas très fan des feuilletés à la viande j''ai beaucoup aimé le goût et le croquant qu''ont apportés les pignons', '2015-02-03T23:53:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38412, cc350c99-3625-44cf-b8a8-1bfe18daa3c9, 'Je ne m''en lasse pas et je me suis empressée de le rajouter à mon carnet et de le partager avec les chefs cuisine du clan familial. Merci !', '2013-12-18T13:54:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38412, 2c6840bb-79d3-4994-b967-0dd7a1c19c86, 'C''était pas mal, mais un peu trop sec à mon goût et à celui de mes invités...  La cuisson se fait très rapidement, mais vraiment faire des grands carré de pâtes. Avec une salade verte, ça passe très bien !', '2013-03-16T20:53:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38412, 9fa00953-6ea2-4e37-9070-f608067d303a, 'Nous en avons mangé hier soir ! Délicieux et copieux, accompagné d''une salade de cresson. Merci Elodie de nous avoir fait découvrir ce plat. A refaire très vite.', '2013-01-20T10:36:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38412, d4fa69ae-882e-49c5-b3c8-10505ccff4d4, 'Délicieux ! Une salade verte pour accompagner et le tour est joué mes amis se sont régalés. Merci', '2010-11-17T16:59:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38412, d9374944-78e6-44af-8415-99a290fb7c3e, 'Très bon! excellent un soir avec une salade verte ( roquette par exemple! ) les pignons ajoutent un petit plus!!', '2008-12-20T18:30:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38412, 2148fea8-d964-4e11-b6c8-c6f7fcb0b5ce, 'Super bon, avec une salade verte. Je n''avais pas de pignons et c''était tout de même excellent. A refaire.', '2008-07-22T22:46:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38412, b93e8f31-9e24-4e64-bee4-12281489631f, 'Génial, tout le monde a aimé!', '2008-07-01T17:01:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38412, 1551ad1d-38d7-4465-b9fe-3e354549500c, 'Très bon mais j''ai grillé les pignons sans huile, ça marche très bien et c''est beaucoup moins gras.', '2006-05-19T22:32:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38412, 2614beae-d74b-469c-8675-2cf04ccd332e, 'Recette assez bonne, mais un peu grasse à mon goût. Le mélange herbes de Provence-crème fraîche n''est peut-être pas essentiel ? Et ça manque d''épices.  Par contre, avec une pâte feuilletée du commerce, c''est facile et rapide à faire. La salade accompagne bien, ça fait un bon repas du soir facile à préparer.', '2006-04-30T23:02:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38412, b6c4e303-7a60-4ccb-be57-93194ee8c4b9, 'J''ai essayé cette recette et me suis régalée! Je l''ai également accompagnée d''une salade (vinagrette basilic)... très bon !!', '2006-01-26T14:34:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38412, 6be384fa-d59e-4a0f-881e-5babd800d7f5, 'Bon, mais assez bourratif!', '2005-09-06T15:17:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38412, 056f23ab-ef17-419c-bed3-5973f6434041, 'Très bon. Par manque de temps j''ai fais 1 seul et grand feuilleté (une pâte roulée que j''ai plié en 2 tout simplement comme un grand chausson), j''ai donc augmenté un peu le temps de cuisson. Je referai de toutes façons cette très bonne recette.', '2005-09-04T11:15:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 34dbc22d-0f35-4ce2-810a-02f7dbdcfbf7, 'Excellent quand on y met sa touche personnelle : en quartiers, en rondelles ou en bâtonnets, peu importe : épluchez, coupez, mettez dans un grand tupperware avec l''équivalent d''une à deux cuillères à soupe d''huile d''olive, sel, poivre, persillade, paprika ou selon l''envie (curry, etc...) et secouez ! Les pommes de terre sont bien imprégnées de tout. Disposez sur papier sulfurisé et au four 30 min à 180°C environ selon l''épaisseur de la découpe. Résultat : du goût, de la saveur, du moelleux, bref... un régal !', '2016-06-28T22:51:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 9cf09961-a5ce-4613-8e9c-d795d8c5d7b6, 'Parfait !! J’ajoute avec les pommes de terres toutes sortes de légumes : brocolis, carottes par exemple 
Puis filet d’huile d’olive, sel poivre et paprika fumé c’est juste un délice !! ', '2023-05-18T13:16:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 710adbcf-2f9f-4750-95b2-ebebd706cc78, 'Simple, efficace et tellement bon !
J''ai mis dans un sac congélation avec huile d''olive et herbes de Provence on secoue et hop !', '2019-04-14T08:19:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 1ce2d594-4e54-4a1a-bc8f-62aef4985c1e, 'parfait pour accompagner un BBQ, avec un filet d''huile d''olive et des herbes de Provence/ thym', '2023-05-24T19:44:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 1d7be93e-e16a-4f3d-adac-d31c3b78bac6, 'Simple, mettre le fromage avant la fin de la cuisson. C''était très bon avec du reblochon.', '2020-09-23T15:45:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 3cc234a8-8a83-4e82-afb5-af33d7f2e0ea, 'Les pommes de terre au four, ou les pommes de terre "pouf" comme on dit à la maison. C''est un grand classique dans la famille pour accompagner les grillades de l''été. Dans l''assiette, on ouvre la pellicule bombée sur le dessus et on y glisse un peu de beurre... Humm délicieux. Les enfants adorent et les adultes aussi.', '2019-05-15T17:59:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, edc0b83d-161e-4fe0-9e4e-dcf5acbfeeb2, 'Très bon ', '2023-03-27T11:24:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 479a37c5-5001-49a0-8089-555db56daaff, 'Trop bon', '2023-02-05T21:27:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, fbaf3b47-dcf1-423d-bdc1-872bd2e1501f, 'Super !', '2022-10-28T09:31:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 3e116fe4-3e6b-4877-be76-51cdeb9bb168, 'Facile et excellent. À refaire.', '2022-09-18T13:55:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, d4f97df9-09d8-4313-a2ca-ac99ad3b57d4, 'Simple et très bon', '2022-02-26T12:58:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 8af724e7-f1eb-4fe3-bc5e-02c7e8caccd5, 'Facile, rapide et bon... Des invités à l''improviste, cela accompagne très bien une omelette !', '2021-09-13T13:12:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 0c2f5b87-9610-4b1f-952d-46746a58e6bb, 'Parfait ! En réponse à Moulig_91 j''ai mis mon four entre 180 et 200° ( thermostat 6/7 )', '2020-08-20T19:25:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, e4203139-eee1-4c42-8547-04d68ef1e53e, 'Excellent ! Avec une marinade huile d''olive et ciboulette, et un peu de gros sel. Temps de cuisson plus long avec mon four, 50 mn. Tout le monde s''est régalé. ?', '2020-02-09T03:34:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, e11e47f9-0cac-498e-8316-d923afb987ef, 'Excellent et facile ! Je plussoie l’idée du sac congélation, on met tout dedans, on secoue et hop ! Un bon repas prêt en 35 minutes. Avec un peu de parmesan râpé et de la crème fraîche, miam !', '2019-08-10T10:18:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, be4b0e8f-b492-4033-af81-2a2caaab2cb8, 'Pas mal, mais écrire "sans graisse"... Si ce n''est les 30% du fromage', '2019-03-28T13:15:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, e2b4b506-2881-4e93-8f96-21361008463d, 'Prendre plutôt des petites pdt pour 30 mns de cuisson et délicieux avec du saint nectaire (une bonne tranchette sur chaque)', '2019-03-15T14:09:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, b27a942b-d148-449f-91be-6b61e1493326, 'Excellente recette.  Un vrai régal simplissime ! A refaire  !', '2018-09-30T03:54:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 97b3558f-9df1-4ca1-a127-a2bf420eb89b, 'Super facile merci beaucoup ! Rapide et simple et surtout un régale.', '2018-04-07T13:52:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, f2c578cf-99a7-48e2-99f8-0fabf79458e3, 'Plus personne ne veut les pommes de terre autrement ! L''astuce de l''huile dans boite hermétique pour les enrober légèrement c''est top!  Bien rôties, c''est plutôt 40 minutes à 180°C.', '2017-01-26T13:15:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 7a68f5dd-248c-43b7-89b7-36aa8051b881, 'Comme beaucoup d''autres personnes, j''ai, moi aussi, fait macérer les pommes de terre épluchées et coupées en grosses tranches avec huile olive, herbes de Provence, sel, poivre, épices diverses (curcuma, paprika), puis cuisson à 180°C (thermostat 6) pendant 45 minutes ....un pur régal! Merci pour cette recette. ', '2016-02-21T21:34:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, f8fc589d-69f9-40cb-a5af-ac6c31e713cb, 'J''adore, je la refais et la referai encore ! Je mélange dans un saladier pour plus de facilité comme indiqué dans un commentaire, bref j''adhère.', '2015-11-01T12:12:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, da40fbfb-e10c-4298-86a6-2a3ac6fb40e3, 'Tout simplement excellent ! Avec un peu de fleur de sel en fin de cuisson et très bien pour accompagner une bonne viande rouge.', '2015-02-13T20:53:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, f013a40f-3034-48da-81cc-e9c6be7f6e70, 'Si vous souhaitez déposer une légère couche d''huile (je conseille l''huile de noix) sur vos pommes de terre, mettez-les dans un saladier fermant avec un couvercle ; y ajoutez une cuillère à soupe d''huile, fermez le couvercle et agitez vivement. Vous pouvez y ajouter des herbes, du gros sel, des épices...', '2014-11-18T19:07:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, d34ef787-3613-4bd7-be2a-d85f764be810, 'Une valeur sûre et simple à préparer. Meilleur avec un peu d''huile d''olives et des aromates. Pré-cuisson inutile. ', '2014-06-07T23:09:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 6e355f61-6fc7-437e-849d-74ffd0c159b2, 'Je fais toujours mes pommes de terre en casserole à l''eau ou sautées à l''huile dans une poêle, j''ai voulu changer pour les faire au four : bien meilleur. On sent bien le goût et rappel les pommes de terres traditionnelles de campagne servies dans les patateries (oui ces restaurants existent). Nature et pas une goutte de graisse, le top !', '2013-10-11T20:40:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 5176732e-4ada-415a-8dba-1d154b777acf, 'Une très très bonne idée d''accompagnement. A servir avec une sauce crème fraîche-ciboulette. TOP !', '2013-08-16T01:04:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, fbff956b-a725-45aa-86e9-f12c14757fe1, 'Ha oui ! C''est vrai ! Je vais faire goûter aux enfants, c''est délicieux et ça change ! Merci', '2013-04-25T16:34:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 57f0f866-341c-45c7-b9f4-26452ad02a59, 'Super bonne recette, je l''ai faite avec des truites (un régal) et j''ai rajouté de la persillade sur le dessus. La prochaine fois j''essaie avec le fromage.', '2009-05-08T22:20:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 86aaa9a9-6597-4088-b3d2-b929def70a9f, 'Très facile à réaliser et excellent. J''ai fait cuire 50 minutes à 200 degrés. Ce n''est pas gras du tout et c''est assez original.', '2008-02-14T21:54:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, d6623b9f-01c2-44ab-9004-56a7b0b5cd1a, 'Excellent!  Pour ma part, j''ai ajouté une sauce à base d''oignons, d''ail, d''herbes et de crème fraîche.', '2008-01-18T21:55:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 5ab64179-dedf-47e5-a209-309ff6497687, 'Excellent! Tout bête mais vraiment bon. Les pommes de terre sont à la fois moelleuses et dorées. Nous les avons mangées avec des saucisses et du yaourt.', '2007-08-02T19:16:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 55dc071c-552b-4592-b651-2b2cb4efd046, 'C''est croustillant à l''extérieur, onctueux à l''intérieur. A faire pour accompagner toutes sortes de roti.', '2007-06-03T16:27:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 8196b2ae-2eff-4d59-8b1a-0ecda3ec76b6, 'Délicieux 👍', '2023-10-30T12:40:13+01:00');
