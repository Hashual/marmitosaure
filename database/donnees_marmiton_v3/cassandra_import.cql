INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, 80b84e26-41ac-47b3-9203-b86f1954c5a0, 'Super recette facile et rapide pour ma part j’ai tout divisé en deux car je n’avais plus assez de framboises...à part ça cette recette et délicieuse 😍 j’ai rajouté un peu de lait d’amande vanille (de la marque BJORG) dans les framboises et un peu d’extrait de vanille liquide (de la marque VAÏNÉE) dans le mélange mascarpone etc... bref cette recette et TOP et très bonne ! ', '2020-08-04T16:19:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, 4a1e52a2-8fbd-4648-932f-4ef22b024e9c, 'Un peu plus de framboises, 125 g de sucre seulement et franchement c''est parfait ! Merci pour la recette.', '2017-04-21T23:30:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, a2d857fe-eac0-4faf-90be-b9063c08acbd, 'Très bon avec moins de sucre.
J''utilise des framboises congelées que je mets après avoir versé la pâte dans les moules à muffins (3-4 framboises par muffins), ça permet d''avoir des fruits dans tous les gâteaux ! ', '2022-01-08T14:58:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, 7591c2c9-e50b-4d5c-bdec-9449e6c339ea, 'Très bonne recette mais ce serait meilleur avec un peu plus de framboises.', '2020-07-10T15:39:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, 67da353e-fab1-442f-ad31-bbff9fb89def, 'Excellente recette! Un vrai régal! J''ai tenté l''expérience à plusieurs reprises avecd''autres recettes de muffin mais n''étais jamais pleinement satisfaite. Cette fois, les muffins sont très moëlleux! J''ai suivi les conseils des lectrices et n''ai mis que 100g de sucre ce qui est amplement suffisant. J''ai également ajouté 20 cl de lait pour m''assurer des gâteaux plus moëlleux (astuce lue sur une autre recette) et j''ai placé un carré de chocolat au centre de chaque gâteau pour un coeur coulant. Vraiment parfait', '2020-05-03T21:45:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, 160cab7e-40fe-4ed3-9452-258df74d14af, 'Super recette !', '2018-09-23T04:26:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, 1d82f4ab-7f1d-44fe-8e8f-9a3b16967f1b, 'Juste 100 g de sucre et remplacé le sucre vanillé par de la crème de cassis. 30 minutes de cuisson. Un délice!', '2016-07-15T19:04:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, 962c5c10-1e4c-43fc-abfd-86981448f5f1, 'Parfait !', '2015-12-13T18:25:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, e2090d2b-9d98-4bd8-aadc-7ab8822fb5af, 'Très bonne recette, cependant je laisse cuire 15 min de plus et je mets un peu moins de sucre', '2015-09-28T13:47:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81215, bc76f091-8922-4d61-aa68-e2a1ab583f74, 'C''est à pleurer avec les framboises du jardin... j''ai mis moins de sucre pour garder un peu le côté acide des framboises 100 g. terrible', '2015-06-20T22:11:05+02:00');
