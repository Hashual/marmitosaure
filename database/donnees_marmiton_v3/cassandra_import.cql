INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 9e7fb440-d7b0-4190-b3e3-797a3b5bef5c, 'Excellent et simplissime !  Le résultat est absolument succulent, et le flambage se fait bien. A faire et à refaire.', '2016-08-31T00:37:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 89188ff0-d6ed-4cb5-bf95-85b9f731dbad, 'Hyper simple. Seul le flambage a été un peu laborieux... il faut pas avoir peur !! Avec du chocolat noir fondu... hummm', '2016-06-02T13:54:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 721707ba-b6fc-481c-aa40-3960cb59256c, 'Rapide à réaliser et très parfumée. Le meilleur moment est celui de la flambée qui active les papilles.', '2016-05-23T20:13:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 64e71696-4c0f-4900-9679-c4e041be3be9, 'Simplissime, goûteux, à accompagner de plein de choses différentes selon les envies...Top quoi.', '2016-04-25T01:28:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 3c65f4ef-1113-43e0-ab11-353567bc39e9, 'Hum! parfait! (les gourmands, ne pas oublier la petite boule de glace vanille bourbon pour accompagner...)', '2016-04-03T13:16:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 883d84d3-eebf-4b89-bcd4-bc6dcffb5349, 'Je l''ai flambée au whisky (par erreur) mais c''était quand même très bon et facile à faire', '2016-03-19T17:08:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 2dace307-78e7-4588-9c4a-fa349aceafa8, 'Excellent ! j''en mange depuis que je suis petit... je viens d''en refaire ce soir, avec beaucoup moins de rhum, mais du bon ! un régal... ', '2016-02-10T21:43:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 16d70f0d-7273-4cda-90c1-fdfd4f57d5be, 'Super, 5 à 7 min de chaque côté et environ et 20 cl de rhum, un régal !', '2016-01-31T22:12:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, bd736fd0-eb50-4169-8b96-e1fcad7176d9, 'Ce qui est une agréable surprise est que ce dessert n''est pas lourd ! Succulent et vite fait.', '2015-12-12T22:05:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 89b5b514-ca33-4d13-8f96-d6a051236841, 'Divin,  préparation simple et rapide pour finir les bananes trop mûres et flambées avec du rhum et un petit fond de Grand Marnier. A refaire le plus souvent possible.', '2015-09-22T12:26:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, f77c9489-782d-40d5-bdbe-f93e1f38c450, 'Simple et délicieux !! ', '2015-07-19T22:41:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, bec20b4f-0523-4ffe-91f7-8b68b62600a3, 'Idéal pour les bananes trop mûres.', '2015-04-10T18:47:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 25781d61-3b70-49c0-9f8c-eb34806adadf, 'Hummm....même Eva en a mangé !', '2014-12-19T00:02:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, c926971b-c034-4fd5-9b27-96e09e4e342c, 'Un délice !', '2014-11-12T21:37:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 16e02c10-a9b8-46c0-bdd5-9d59567c1dbe, 'Très simple et efficace. Même mon mari qui n''aime pas les bananes (à la différence de moi ;) ) a adoré ', '2014-05-30T23:50:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 33b17466-5b50-4fe7-bcdb-df50dc597e4e, 'Très bonne recette ! A suivre à la lettre. Idéale pour consommer les bananes un peu trop mûres !', '2014-02-05T15:35:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 4eb86dc3-4fe3-48e3-9c3b-0adc26fff57b, 'Simple, facile, excellent. Rien à ajouter. ', '2013-10-20T23:41:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 785bf5b8-326f-47cc-8598-125a04393973, 'Recette simple et réussie, j''ai rajouté du jus d orange avant le rhum, un délice !', '2013-08-19T02:07:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 1f028409-ffe7-4a14-8e19-9ccd20ebd2be, 'Super bonne recette... J''ai remplacé le sucre vanille par du sucre avec une cuillère de cannelle. Super bon', '2013-07-15T22:35:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 37491fa7-305d-4c94-8d5e-7d3f157bbdbd, 'Simple mais tellement bon.', '2013-05-09T16:13:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 4902f9ce-8f7d-4f73-b8a3-3cb63da8a698, 'Miam ! Recette réalisée en 2 minutes avec des bananes trop mûres, j''ai épaté tous les convives ! Réalisée avec du rhum et de la noix de coco râpée puis servie en verrines, cette recette est hyper simple, rapide et gourmande !', '2013-04-28T17:45:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 3a02f14e-998b-4e0a-b146-bd6c1475330a, 'J''adore !! Et toute ma famille aussi', '2013-04-27T16:15:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 9b08cc51-edad-49b9-a641-a17504b0331b, 'Facile rapide et délicieux aux dires de mes enfants.', '2013-04-07T21:47:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 66c35a26-4a9c-42fe-823f-a80d6ad2b5e5, 'Très bon !', '2013-02-26T22:56:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 0f2a3a70-b2b3-46b9-b22d-87eeee97e4d2, 'Simple à réaliser et super bon ! A refaire sans hésitation.      ', '2013-01-11T22:31:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 52e0ad43-a5f8-43d1-a75b-8171b3aa101d, 'Simple et très bon', '2012-12-29T13:45:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 04999b4b-8c37-47c2-adfc-804d57c3a518, 'Fait et bon.', '2012-12-23T20:23:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 877de319-b727-4dcf-9320-b3ffb1a8377e, 'Vite fait bien fait et... DÉLICIEUX !', '2012-12-02T20:56:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72081, 1b332760-f9f0-4cdb-861a-d2a07871cb8e, 'Excellent j''ai ajouté du chocolat fondu dessus ce n''est que meilleur  ', '2012-11-27T15:55:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (218320, 01e70ad1-3ab2-4b36-a164-12605a831824, 'Excellent, c’est très rafraîchissant. C’est le meilleur smoothie que j’ai bu. Je le recommande vivement. J’ai mis des fraises entières. Mais je suis sûre qu’avec le jus de fraise ce serait aussi bon', '2023-10-31T11:58:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (218320, ad8f9b40-a10a-42de-82fb-986a78cacea8, 'Fameux ! Parfait pour le goûter !', '2016-06-15T19:12:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 345685bc-4a93-48e9-aa64-285d8c275bd3, 'Merci pour cette recette ! Comme je fais du diabète gestationnel, cette tarte sans sucre ajouté m''a apporté un peu de réconfort ! Ma fille de 4 ans s''est régalé aussi!', '2015-01-31T18:47:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 40c825de-e1a9-4ee5-b479-46c318f43222, 'WaOuHHH !!! C''est la prmière fois qu''on me dit que c''est trop bon ! Merci pour l''astuce ! J''osais pas essayer sans sucre et en fait les bananes relèvent le goût à fond la caisse !  Remarque une petite touche de crème fraîche... pas mal aussi et du coup on ne culpabilise pas du fait qu''il n''y a pas de sucre !', '2007-12-11T00:29:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, f639ac4c-7937-49bf-a914-d7da63f3c005, 'Excellent. Je suis toujours surprise que certain ne puisse s''empêcher de sucrer "un peu". Quel fléau ce sucre ajouté, à des fruits surtout !!', '2023-01-31T10:54:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, b18071ca-a02c-44db-a14d-07fdc083606f, 'Excellent et très rapide à réaliser !', '2022-12-08T18:03:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, c9bbae4a-a369-47e9-82cc-d8d1e7bd8b34, 'Il fallait passer les bananes qui commençaient a mûrir, et ben agreablement surprise ! Tarte qui ne nécessite pas du tout de sucre, les babanes font lagent surcant et elle est tellement bonne. On la refera ca cest sur ! Appréciée par toute la famille même les réticents du sucré habituellement ?', '2021-02-05T15:13:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, dc488dd5-5689-48d3-b795-6aa83554bbeb, 'Merci pour cette recette que tout le monde adore, surtout enfin un dessert pour diabétique.', '2020-05-30T12:27:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, a47db2b3-c2ba-451c-b204-79ffc0be5e5f, 'Avec une pâte sablée maison, une bonne alternative aux desserts trop sucrés, agréablement surprise par la recette : Simple et efficace !', '2018-11-28T21:18:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 53d94f9f-f1ba-4b32-9a1e-52813f907e34, 'Avec de la pâte brisée c''est une tuerie !', '2018-11-10T11:41:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 149b8592-3e30-4300-9f4e-4ee54e50592d, 'Bien bonne, ajout d''un soupçon de rhum. Ce n''est pas ma préférée mais facile et rapide à faire pour un résultat très convenable. Ma préférence va à la recette tarte aux pommes facile.', '2014-11-16T00:09:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, c8a9458b-abb1-4825-92ea-271196c83e1e, 'Simple et bonne, rien à ajouter, rien à enlever, je l''ai faite avec une pâte brisée.', '2014-10-09T16:19:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 6fdc2dbe-2207-4093-a8ac-a391a26631f2, 'Facile, très bon et sans sucre !!! j''ai mis juste un peu de rhum', '2014-07-05T13:58:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 88383c77-7724-40f5-b822-0364e9d0a887, 'Simple, délicieuse, fine... ne rien changer !', '2013-11-17T11:36:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 6b765346-e087-4234-9bbc-65feeb5b53a9, 'C''est sympa, rapide mais pas exceptionnel non plus. Léger en fin de repas, agréable.', '2013-02-03T16:50:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, fb14151a-7f0c-49e9-9c7f-c4013195928b, 'Très bon ! ', '2012-11-28T20:42:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 4576e674-dd73-4789-84c4-763f9ab55f70, 'Cette tarte est une TUERIE. Réalisée en suivant les instructions à la lettre. D''une simplicité enfantine, rapide. Avalée en moins de temps qu''il faut pour le dire.', '2012-10-30T15:01:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 4c7c56df-c24e-4f70-8030-1a7859a89455, 'Il n''est rien resté j''ai fait tremper les bananes dans du rhum un régal !', '2012-06-05T19:18:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 0cfdfcea-9671-4d1e-9668-3354b925a701, 'Une délicieuse variante de la tarte aux pommes ! La banane fond durant la cuisson sous la pomme et le mélange de goût des deux fruits est surprenant, naturellement sucré avec une pointe acidulée. Je n''étais pas forcément convaincue par l''idée mais on a tous adoré !', '2012-04-20T06:16:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 5045e692-7a5e-4844-a49e-0e7021587c53, 'Excellent et facile à faire', '2011-10-25T18:44:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, d71e8bdd-6965-4c69-ab83-e07caef6aa44, 'Vu les commentaires, je m''attendais à un dessert top et forcément, j''ai été un peu déçue. Pour du light, c''est très bien mais sans plus. A déguster tiède, peut-être est-ce meilleur que froid ?', '2011-02-04T01:57:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 4d1d83ea-c39a-461f-9365-324915f4f0a9, 'Simple, rapide, j''ai aussi ajouté du citron et un peu de rhum...mhhhh délicieux', '2010-01-27T15:28:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 7b008210-09e3-4fb1-b5e8-13c1460f2741, 'J''ai fait la pâte sablée "marmiton" et j''ai garni ma tarte comme dans la recette en sucrant avec de la vergeoise, nous nous sommmes régalés mais je rajouterai la prochaine fois un peu de rhum pour optimiser comme préconisé par une autre personne, nous étions 4 et la tarte est quasiment finie c''est vous dire....!!!', '2009-03-29T14:22:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 137af00f-a911-4803-8f5b-04f70aa25f58, 'Je fais tremper les rondelles de banane dans du rhum! Tout le monde aime !', '2009-03-11T00:21:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 458b7f77-857c-4674-a974-c43648e5eed2, 'Je l''ai faite avec ma petite fille, impeccable, elle s''est amusée à la faire et régalée à la manger. Simple et très bon!!! J''ai juste saupoudré un peu de sucre sur mes pommes avant la cuisson car elles n''était pas très sucrées.', '2008-10-21T00:54:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 15c3e705-796a-48f8-b57b-e9536c7e709d, 'Très bonne recette, simple et rapide: mon mari a adoré! J''ai fait une pâte à crumble que j''ai rajoutée sur les pommes!', '2008-07-21T23:27:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, f4a68dc4-c1f3-416f-aadd-d38938e64e9f, 'Très bonne idée de tarte très légère et très facile à faire!!!! Sans sucre mais pas sans goût...', '2008-05-16T19:19:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 9c4f6226-a552-486e-9cd6-76917e99eeef, 'Excellent! J''ai adoré, si je m''écoutais je me mangerai la tarte à moi toute seule! Par contre moi j''ai citronné les bananes et rajouter du sucre de canne. C''est vraiment super facile à faire pour un résultat garanti.', '2008-04-29T22:59:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, f4716629-9e3c-4390-b8a4-ebfc471004d3, 'Merci, c''est délicieux!!!', '2008-03-31T19:55:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 6a70b964-8764-4201-8703-6e55d97416a3, 'C''est la 1ere fois que je l''ai faite et je l''ai trouvée ainsi que mes enfants succulente et en + pas de sucre ajouté et c''était assez sucré naturellement. A recommencer ', '2008-03-25T18:42:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, d7496a2e-059d-48bd-a950-6963cc37e20c, 'Faite dans l''urgence, car du monde à l''improviste, nous nous sommes régalés...simple, mais très bonne. J''ai mis un peu de sucre roux, car j''avais, moi aussi, citronné les rondelles de bananes. A refaire sans hésiter.', '2008-03-18T09:33:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 187b967d-4257-40c1-bf42-6ab454f41c78, 'Vraiment succulente! J''ai simplement citronné un peu les rondelles de banane. Je n''ai rien ajouté, ni sucre, ni crème et franchement c''est inutile, c''est naturellement sucré, délicieux ! ', '2008-02-20T14:40:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 0b8b3828-7eeb-40cb-807a-ce32be790809, 'Extra et très rapide à faire. Pratique pour un dessert à faire dans l''urgence et avec peu d''ingrédients. Tout le monde s''est régalé. Merci', '2007-11-03T21:36:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, dff065ff-fa69-491c-a830-b7f1145a884c, 'Je n''ai pas fait trop attention aux proportions, mais le tout s''est très bien marié, saupoudré en prime de jus de citron, d''un sachet de sucre vanillé, et de cannelle. Rapide, bon et pas cher, que demander de plus ! Merci !', '2007-10-24T19:10:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 461081d4-62a9-4ceb-8f3c-97a4c4036233, 'Très delicieux!! mes à faire avec des bananes fraîche depuis 2h dans le frigo !! C''est encore meilleur!!', '2007-08-28T11:24:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 7739c53c-0ecc-4d50-9fed-9dd8843240f0, 'Extra simple et délicieux. Le fait de ne mettre que des fruits permet d''en manger sans (trop) penser aux calories! Merci pour cette recette.', '2007-07-19T10:34:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 92b14177-f5a9-409a-9dc3-e02fbce5ae3d, 'Cette tarte est ultra rapide à préparer et en plus elle est délicieuse!', '2007-03-20T10:10:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 25951946-37f2-4acb-83c9-599155cf938d, 'Excellent. J''ai coupé en rondelles 3 bananes que j''ai fait revenir dans du beurre avec du sucre vanillé. Pour la pâte j''ai utilisé de la pâte sablée. Je referai sans problème.', '2007-02-17T19:00:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 22509466-c852-4c1e-bcfb-b282765c8b45, 'Effectivement c''est très bon...merci.', '2006-12-31T20:32:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, 5056c06a-3a13-4ed2-b454-ff7c70f8d9f0, 'Délicieux, aussi simple que rapide et vite finie!!', '2005-03-17T11:00:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, bb737a8d-139c-48f3-9519-0620228e9aa4, 'Très bon, j''ai mis 4 bananes mûres et 4 pommes avec un moule de 28 cm de diamètre, j''ai badigeonné à la sortie du four de confiture d''abricot.', '2004-09-13T19:25:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, a81241b6-26da-4d56-963a-edd871e7c39c, 'Simple, rapide et excellent!! ', '2004-04-03T16:09:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21996, dd18da7f-2163-4e4c-9fdc-2d64c7749cc0, 'Recette facile, rapide et surtout délicieuse. Tout le monde a adoré!', '2003-11-11T14:51:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30714, da2511fa-a691-4dc0-8792-4468b53c5c41, 'C''était excellentissime !!!!!!', '2014-01-13T00:01:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70949, 948739ae-ebdf-437c-b40b-94e5940bf1eb, 'Doubler les quantités de boulgour, lait végétal (aussi coco) à la place du lait, faire griller des noix de cajou et des pignons, les ajouter en fin de cuisson avec les raisins. Ajouter les rondelles de bananes, légèrement citronnées au préalable) à la fin hors feu et avec couvercle, laisser reposer quelques minutes le temps que la banane chauffe. Pas mélanger car la banane va faire bouillir...', '2017-04-22T16:21:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70949, 7ca29288-1273-45cd-83b9-a705487c6e56, 'J''ai suivi la recette et c''était vraiment très bon !', '2020-01-28T02:58:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70949, 95a29223-abca-453f-998c-7f93cbc803cf, 'Bon mais sans plus.', '2015-09-29T00:25:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70949, c988aaf2-4b25-488e-94e5-d0c2744a44a8, 'J''ai mis 50 cl d''eau et pas de lait. La prochaine fois, je diminue la quantité de raisins car c''était trop sucré. En même temps que la banane, j''ai rajouté une poignée de pignons. Avec des noix de cajou, ça doit être pas mal non plus. Les quantités conviennent en accompagnement, mais en plat principal, il faut doubler les proportions.', '2014-05-25T21:28:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70949, 6c769314-6582-4ad4-ae71-b2fd87b62860, 'Testé et franchement bof, je ne recommande pas.', '2014-05-10T01:34:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70949, c85f2cfa-c6c6-4393-8beb-c48deca2a590, 'Très simple, rapide et bon !', '2014-04-04T21:09:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70949, 929699af-725d-47dc-b0b0-9113be89a8ff, 'J''ai mis 23 cL de lait et 23 cL d''eau, et ça a suffit... Délicieux !', '2014-03-06T21:17:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70949, f0d55acc-1383-4825-b19a-7b606f4a8237, 'Excellent ! j''ai suivi la recette à la lettre c''est trop bon ! du coup je le fais souvent et tout le monde adore ça même mon fils de 17 mois !', '2013-07-02T11:39:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70949, c5a3831f-2b6f-460e-a4b9-4a0d87f9960c, 'Pas renversant, mais un petit plat à refaire pour un petit repas simple, vite fait et sympa. A accompagner d''une salade.', '2009-10-23T16:45:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70949, 3899a53b-3e99-426b-bc73-742374cf3064, 'Je n avais pas de curry alors j ai mis du mélange pour colombo, c''était excellent, et j''ai ajouté aussi des oignons. Recette très facile et rapide à refaire!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!', '2008-08-24T15:44:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70949, d2b14476-f94d-42df-b451-561fb5b47866, 'J''ai juste rajouté un oignon. C''est bon... par contre, le temps de cuisson, c''est plutôt 25 min.', '2008-05-30T16:28:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70949, ca508ba4-4cec-44fd-8821-89a1a5240eff, 'Excellent!', '2008-05-22T21:00:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253649, bcbb1094-72d9-49e8-815c-74ffd9cb87de, 'Un vrai régal ! Il est super moelleux et à fait plaisir aux papilles de mes convives. Petite remarque : J’ai juste fait cuire les pommes et bananes dans du sirop de vanille. ', '2020-12-29T14:29:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253649, 3e41afa4-64de-4e00-beef-760869f15f2d, 'Pendant le démoulage le gâteau n''a pas tenu.', '2018-11-14T07:54:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253649, 4f4235bd-3ad2-42ae-a7ba-19efd9c0730d, 'Il est excellent. A refaire et ne rien changer aux ingrédients.', '2017-10-14T17:18:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253649, 2c62ea69-0184-410b-a633-5a014baffd79, 'C''est bon mais le gâteau n''a pas monté. J''ai fait de meilleurs gâteaux aux fruits que celui là malgré tout il est pas mal gustativement. ', '2015-06-23T18:54:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253649, 75b09cec-df9a-4531-9c60-08871443617e, 'J’ai prolongé le temps de cuisson de vingt minutes. C’est très bon.', '2014-10-21T17:55:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253649, c44e0b62-e4f8-4d01-96fb-335d863ff773, 'Vraiment délicieux, plein de fruits et moelleux !!', '2014-10-20T13:51:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253649, 00ea18f2-ec39-49f3-80c1-9e4791bee535, 'Absolument délicieux !', '2014-02-27T15:34:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (253649, 0f7f5c4c-7bee-41ec-a67b-8ab1fd5a9760, 'Très bon et facile. Mon homme a adoré ', '2013-07-23T22:43:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17886, 49cb83ef-27d1-451c-add4-7df04418f80d, 'Pas mal du tout : j''ai juste ajouté de la moutarde dans la tranche de jambon et enlevé le lait de la préparation crème / fromage ! ', '2012-06-06T13:12:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17886, cac5f5e4-a888-4bcc-8f73-64b122c7a61f, 'Mes enfants non pas apprécié du tout!!', '2012-05-14T23:29:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17886, 2ecdd3b1-ec01-410e-a3af-3c2937e18be5, 'Attention, moi je n''ai pas mis de moutarde mais j''ai ajouté par dessus du gruyère. Exquis....', '2005-01-07T17:58:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17886, f2eff45e-e1f8-42ed-bb7f-afdf70fc3103, 'Moyen mais mangeable.', '2003-11-13T12:39:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 32ce1067-01fc-432c-a0fd-7edb9886b5bf, 'Très bonne recette. Je mets 2 oignons et 2 bananes mûres et je mélange la crème à du lait de coco. Merci', '2016-05-16T21:33:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 4a247908-24df-43d5-b9b3-f01b2c7ca12f, 'Vraiment très bonne recette j''avais un peu peur du goût mais au final vraiment excellent. Pour la banane mieux veut la prendre bien mure mais pas noire. merci pour toutes ces recettes ', '2013-11-15T19:52:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, dfccb5a6-aa30-416d-85be-88f45bb94359, 'Merci pour cette recette. J''ajouterai quelques minutes de plus pour la cuisson du poivron.', '2013-08-21T01:20:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 923d92c1-5c56-4b7c-a94f-eebd0b9ac253, 'Super le mariage de la banane et du curry. Un vrai régal, à refaire très vite', '2013-07-22T23:28:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 10f5214d-be76-473f-86ba-8b5fc58fccc1, 'Hyper facile à faire et super super bon. J''ai suivi les autres commentaires et j''ai mis 3 bananes et pas mal de curry. A refaire', '2012-02-28T21:04:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 8a632b55-eb2f-44ff-9959-525e5bc90168, 'Délicieux, même si selon moi il ne faut pas hésiter à ajouter de la banane par rapport à la recette d''origine : 2 bananes coupées en demi-rondelles pour 3 blancs de poulet : tip-top !', '2011-12-05T11:16:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 52443d69-33d6-4144-bc0a-11e78d86bcf8, 'Très bonne recette, le mariage banane-poulet-curry est très réussi. Par contre, j''ai mis 3 bananes et non une seule pour 5 escalopes de poulets (question de goût) et pour 4 personnes. A part ces détails de proportions, recette à refaire.', '2011-11-25T14:24:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 71e943a0-b3c1-4222-80ae-4a337fef9212, 'Recette facile, bon goût mais j''ai ajouté du bouillon de poule et utilisé un poivron rouge. Mon mari a adoré mais moi je suis moins fan du sucré/salé.', '2010-10-13T22:18:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, fce88426-764e-4f95-92a5-a9e052c17bf4, 'Délicieux. J''ai choisi aussi le poivron rouge, ce qui donne un peu de couleur. J''ai augmenté la quantité de bananes. C''est un vrai régal.', '2009-05-17T16:00:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 16f3548a-e491-4c59-863a-689a1d9f4ca1, 'Recette très bonne. Par contre j''aurais du mettre plus de curry. J''ai servi avec du riz basmati et j''ai rajouté un peu de vin blanc. C''est vrai que la banane se marie très bien avec le curry et la crème fraîche. A refaire.', '2009-02-07T14:35:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 454f2530-8175-4a31-8cec-ce04d5dccfcc, 'J''ai utilisé la totalité des ingrédients pour 200 g de poulet (pour 2 personnes) et servi avec du riz. Très bon !', '2019-08-13T09:31:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, e8fa378c-d958-4c70-b390-0711da88a4f1, 'Merci pour cette très bonne recette. ', '2016-02-08T12:12:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 4707b117-b513-48ca-aa46-74db370c7af0, 'Je l''ai faite avec du lait de coco à la place de la crème fraîche, très bon !', '2014-06-18T00:25:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 91e84467-3b99-40d3-83b2-3caa26960494, 'Recette simple mais tellement bonne. J''ai mis moi aussi un peu plus de banane(2). C''était délicieux et rapide à faire !! Je le conseille !', '2013-03-03T18:50:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 00912f26-2a93-4be6-9d93-15413c48bf44, 'Bien parfait, facile et on en redemande', '2010-10-05T12:51:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 173b81ef-f732-4b14-8379-5af4f4d96171, 'DELICIEUX ! L''odeur, les couleurs et le goût ! Un régal et facile à faire !', '2010-04-18T16:57:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 83a76151-7cb9-42ec-b49f-197714ec3350, 'Plat délicieux, facile à faire...', '2009-07-13T19:58:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, ea8027a4-6f31-4e12-a4ae-189984555233, 'Délicieux! La banane se marie très bien avec les épices. Un vrai régal pour les papilles. ', '2008-11-04T23:19:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 66af70aa-a3e6-4d66-9f5b-2f492962b64f, 'Cet après-midi j''ai eu envie de faire du poulet au curry pour mon repas de ce soir...lorsque j''ai vu les bananes. Je me suis demandé si ça pouvait se marier ensemble, alors j''ai couru sur mon ordi et je suis tombée sur votre recette que je viens d''effectuer...et je n''ai qu''un mot! Wouah! c''est délicieux! J''adore le sucré/salé et la c''est vraiment super bon. J''ai hâte que mon fiancé rentre pour le lui faire découvrir!', '2008-03-31T20:26:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, f76bfbd0-139d-4d6e-a281-eee03310adda, 'Pour cette recette, je conseille de cuisiner dès le début le poulet avec le curry. De cette façon, le mariage poulet-curry est plus intense.', '2008-03-23T20:15:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, d6aa3fd8-3b27-4389-8060-aadacd5c6e97, 'Un régal! Je l''ai fait sans poivron car je n''en avais pas. Excellent !!', '2007-01-30T13:48:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, c469ced4-e4fa-4aca-875e-234b3552f877, 'Délicieux, peut-être un peu trop fade pour les adultes mais les enfants ont adoré. Manque de couleur pour le coté visuel, remplacer le poivron vert par un rouge pour remédier à cela.', '2006-03-03T22:13:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 6b9f66b5-b27e-418e-831e-449c3bcf21eb, 'Délicieux! La banane se marie très bien avec le plat. J''ai aussi rajouté des raisins secs. Il ne faut pas laisser la préparation trop longtemps sur le feu, sinon elle perd son côté liquide et le riz risque d''être plus sec. En tout cas, je le referrai!', '2005-09-02T19:28:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 014d00bb-dcce-4dd2-826f-62a1ff40a579, 'C''était vraiment très très bon. Et ce n''est pas bien compliqué à faire. Par contre je n''en avais pas fait assez... il faut compter pour deux personnes 3 filets de poulet.', '2005-07-21T19:13:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 996a2157-0532-48cf-8d54-afbb99d0262d, 'Excellent, sans rien changer et avec du riz en accompagnement.', '2005-03-14T15:03:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 4ddd5caa-48ec-49c1-a658-b071fc2d4ba7, 'Vraiment très bon (même sans banane), j''ai rajouté quelques gouttes de citron pour relever. Ca doit être pas mal aussi avec des petits morceaux d''ananas. Merci pour cette recette sympa', '2005-02-20T16:01:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 6693196f-521d-4ca2-839a-c8c0194afe99, 'J''ai adoré! Mon mari aussi, ça change un peu!!!', '2004-07-08T17:57:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 42fcebb7-be31-47fb-b4a6-03cba27797e3, 'Bravo! Mes convives ont beaucoup apprécié. Petite info: recette parfaite pour être cuisinée dans un wok!', '2004-06-01T19:16:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 6f5429e9-b645-4713-bd7a-792bd130ec59, 'C''est facile et délicieux! Je rajoute un peu de Cayenne pour épicer.', '2004-03-11T19:34:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 65bf4b6a-3fa0-4251-b4f9-aad6820a9024, 'Très apprécié : j''avais fait le plat pour six personnes et à quatre nous l''avons entièrement mangé ! La recette est excellente ; je me suis contentée de rajouter une pointe de moutarde et du citron pour relever le goût.  Petite précision : je pense que le pot de crème doit correspondre à 25 ou 30cl de crème. ', '2004-03-02T19:25:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, af31610a-7f29-4d08-b6b3-d8ea9de699a0, 'Voici un plat original qui surprendra votre table. Très facile a réaliser, puisque moi, cuisinière du dimanche, j''ai remporté un franc succès hier soir. Nous nous sommes régalés, sans pour autant nous alourdir... A faire pour un dîner sympa entre copains!!!', '2004-02-13T09:50:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 95b06624-347b-4b00-8510-9ff5addf0cb4, 'Tout le monde a trouvé ça excellent. J''ai rajouté une pomme granny et des raisins secs en cours de cuisson.', '2003-12-21T21:16:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 8c083d4d-6ad0-455f-aa4e-340ca8989991, 'C''est assez difficile pour l''enfant que je suis... ', '2003-07-02T09:21:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, efc26352-c4f0-42d6-bc2f-fdc455591718, 'Délicieux et original. Pour plus de goût, j''ai rajouté un bouillon de poule, un petit piment vert et sur la banane, un zeste de citron vert. Un vrai régal!', '2003-05-30T19:25:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 2ca57ebf-fea4-406e-834f-5af9cd3e5027, 'Très bon. J''ai toutefois décoré le plat avec une pomme Granny au lieu de banane et rajouté de la noix de coco. Délicieux!', '2003-05-01T14:34:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, ac49c185-5536-471c-b3ec-f3edf934829e, 'Original et bon. Personnellement, je trouve que cela manque de banane. Mais tous les goûts sont dans la nature, non?', '2003-02-21T18:19:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 2ee40c33-c59e-4118-abdc-4f3bd3b72a80, 'Très bonne recette, c''est facile et rapide. Je l''ai servi avec du riz thaï et des carottes en rondelles à la vapeur. On m''en a redemandé.', '2003-01-20T13:52:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 3a913f61-1641-4b89-a0f0-77cfcf6e49a5, 'Recette rapide et facile à faire. Les rondelles de bananes donnent un petit goût sucré sympa.', '2002-12-01T16:27:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 23518b82-396d-4ed6-acc6-863ecc41f5d3, 'Facile à faire et original. Le mélange avec la banane n''est cependant pas exceptionnel. Bien meilleur avec une pomme granny et des raisins secs.', '2002-11-01T18:11:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 75d79f94-be10-42ae-a67d-79917b692a32, 'Un plat sucré salé peu compliqué et réussi (j''ai rajouté une banane).', '2002-10-25T09:03:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, f92ddef8-a3b5-48f8-a70b-47f80c7a5521, 'Très bon et le goût est facile à moduler, grâce aux ''goûters'' nombreux. A essayer.', '2002-10-24T13:48:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 46afd933-4c7d-4e78-b145-760539e4621e, 'Pour ceux qui aiment le sucré-salé, c''est un plat génial... J''aurai tendance à mettre plus de banane! Comme en plus j''aime bien les plats épicés, j''ai rajouté un peu de piment de Cayenne.', '2002-10-20T20:00:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 441fa9b7-f77a-4eb7-906c-6d80fc44d592, 'Tout facile, tout bon!  PS: rajouter ne petite poignée de gros sel pour relever un peu le goût! :)', '2002-10-20T12:45:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 2d3d2796-c89b-4274-89dc-1c19883fe51d, 'J''adore le curry et le banane permet d''adoucir un peu le côté épicé du plat. A tester!', '2002-10-20T00:14:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 7056a365-b3c6-49e2-831f-ca72c51ac8eb, 'La banane ,pas terrible, mais sans, c''est très bon.', '2002-10-14T15:23:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 626d8a0e-891b-45cc-b238-e50f0ab8399f, 'L''idée de la banane rajoutte énormément à ce plat! Mais je dois dire que la prochaine fois, je mettrai du lait de coco à la place de la crème fraîche... Ca mériterait l''essai!', '2002-10-14T00:42:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 7fcb2d53-5ea5-4207-a731-2f4e100a8bae, 'Ma soeur Sarah nous en a fait hier, c''etait excellent, très rapide à faire. Il manque juste un peu de piquant à notre goût.', '2002-10-09T12:45:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, 0f37bedf-ddc2-45ee-a752-4cd72c27927a, 'J''ai mis, à la place de la banane, une pomme. Pas mal.', '2002-10-08T21:25:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18533, ff6091cf-594d-4283-9058-b0cc4b3ff7c2, 'Le plat est bien, par contre je trouve qu''il manque un peu de goût... Facile à préparer. Merci!', '2002-10-07T23:02:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16581, 753465da-af7f-4832-8ac7-26f45aab3a0e, 'Moi... j''adore!!! C''est la deuxième fois que je la fais un vrai régal !', '2013-07-07T17:06:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16581, bc565067-8ad8-4bc4-bd2c-3b03c4323526, 'Ca n''est pas bizarre!!! C''est le goût de la banane et c''est excellent quand on les aime! Il faut précuire la pâte environ 15mn. On peut rajouter du rhum, ainsi que de la cannelle (1/2 cuillère à café) et plus de bananes, selon le diamètre du moule.', '2004-08-14T11:54:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16581, 0bc865db-5ebf-4fb0-a3a0-e6c9e0c7ebe2, 'La texture, le goût... tout est original, voire bizarre! Pas de grand engouement devant ce dessert...', '2002-08-19T10:44:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166394, 96835673-2a10-4192-9e84-8e2a85ffcb93, 'Mes enfants ont adoré ', '2021-02-28T13:08:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, 0e93783e-a20a-42c5-8b3e-a1953c77c2f7, 'C''était excellent ! J''ai enlevé un peu de sucre et je me suis trompé d''un zéro pour le lait... (Erreur de débutant) ça m''a donné une sorte de un far😂 à refaire !', '2022-06-19T14:43:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, 519bb871-a1d0-4de8-af30-7e72c95233fd, 'Très bon ! J''ai ajouté des gros chunk de chocolat noir Nestlé dessert, et seulement une poire et une pomme car je n''avais pas assez de poires mûres et c''est délicieux. J''ai mis un sachet entier de levure chimique et de sucre vanillé, pas de canelle... ', '2021-05-13T22:41:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, 0d609f45-c8dd-44f5-ada8-84822699a91d, 'Suivie à la lettre! Tout simplement délicieux!!! Merci pour cette recette!', '2021-04-26T16:58:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, 272cea7e-dda8-4a0b-b7b3-785ed83f58c6, 'Très bon. J’ai fait 70 petits cannelés ! Pas mis de banane mais 5 poires que j’ai écrasées grossièrement à la fourchette. Un paquet entier de levure. Merci Marmiton.', '2020-08-20T19:39:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, b583fb13-64fa-4b2a-bb44-05cd19fe521f, 'Parfait comme ça. Par contre mes poires étaient un peu trop mûres alors je les ai poêlées, un peu avant mais ça a quand même mouillé la pâte.', '2019-11-01T08:10:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, bfe12181-b770-4d20-919f-748582e55782, 'Seule modification que j''ai faite à la recette : lait de soja au lieu de lait de vache. Très bons tels que.', '2017-03-26T22:39:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, 6eec409f-57e8-4d83-945e-ffb7c5c46a40, 'C''etait trop bon, tout le monde a adoré, je n''ai rien changé à la recette ! ', '2015-10-16T05:03:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, 14b3be86-abbb-4685-a18e-98ac4b1d7500, 'Délicieux avec des pépites de chocolat, je n''ai mis qu''une banane (très mure) et 5 petites poires et un sachet entier de levure. Très facile à faire et à manger avec les enfants !', '2015-09-18T22:39:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, 43e95022-d95e-4906-bd73-0f926383c91e, 'Dégustés tièdes, un délice, merci.', '2014-12-09T23:51:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, fe506599-6f02-43e8-9cbf-ab32db976eec, 'Excellente recette par contre je mettrai plus de levure la prochaine fois, sinon on sentait bien la banane, ma fille a adoré pour le gouter et ma mère avec son thé m''a demandé la recette ! A refaire.', '2014-03-13T19:29:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, efa5aeea-1143-40bc-9644-7cc3667c0045, 'Super bon, même sans la banane...', '2012-05-23T20:29:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, 7963f8e2-40ce-4243-96d2-21bea3adc3ea, 'Humm, encore meilleur avec des pépites ! ', '2012-04-07T14:48:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, ffa9a584-9c53-4f80-9f91-ff7eb02fd3c6, 'Chez moi, tout  le monde en redemandait !! Alors sans hésiter je vais la refaire !', '2010-08-04T11:43:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, eb7b7ce9-1491-40e7-9f9b-80afe925f873, 'Bizarre, les muffins n''ont pas monté, pourtant j''ai respecté la recette, je ne comprends pas. Sinon de goût ça va, mais la texture reste lourde', '2010-03-25T22:30:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, 95d92153-fe61-4c7b-92b6-4d51f4a612a6, 'Pas mal du tout, je les ai faits avec des pommes, effectivement on ne sent pas la banane mais je pense qu''elle donne du moelleux aux muffins. J''ai mis 1 cuillère à café de cannelle comme indiqué mais je pense que c''est sans doute un peu trop, cela cache et peut-être même gâche le reste des goûts.', '2009-04-30T13:19:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, a0bce873-aa98-4e6f-946f-2dcd17e5869b, 'Mes muffins ont mis 1 heure à cuire au lieu de 30 minutes et je n''ai pas du tout aimé la texture finale du muffin mélangée à la banane, bien que le goût ne soit pas mauvais. J''ai obtenu une pâte un peu gluante...', '2009-04-20T19:39:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, 9c87ebe8-2094-4081-bdc7-a125794e5539, 'C''est bon mais on ne sent pas vraiment le goût de la banane!', '2009-03-13T12:22:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, 0145ef8f-ea66-41a1-809f-98d0e89790c6, 'Super bon. A défaut de poires, j''ai utilisé des pommes. Cela va très bien avec la cannelle et avec la banane. En un tour de main, tout avait disparu...Mmmmmmm...', '2009-03-02T19:27:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, 8ab8cc6a-0b32-46c9-834b-afa5e65b9c0a, 'Un délice!! Fondant, moelleux, pas trop sucré... A tomber! A refaire encore et encore! Merci!', '2009-03-01T22:18:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, f624b7f0-74b1-4bb7-88db-c29fa4ad2001, 'Délicieux! Pas trop sucrés ni bourratifs ces petits gâteaux sont idéaux pour le "5 o''clock tea". ', '2009-01-28T23:25:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, cbe3815d-34d9-4af9-a0c0-3e648d041b1c, 'Très bonne recette. J''ai tout divisé pour n''en faire que 6 (à part la cannelle, vu que j''adore ça!!) C''était parfait ! Seul hic, ils ont eu tendance à "redescendre" après démoulage et ne ressemblaient plus trop à des vrais muffins !!! Mais le goût était bien là !', '2009-01-09T18:49:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, 207d0ba6-8a1a-4dfa-afd7-087232a2f2aa, 'Très bon, et moelleux, je l''ai fait dans un moule à cake avec une cuisson un peu plus longue, c''était parfait. Merci beaucoup tout le monde a adoré et en plus il se conserve très bien (enfin s''il en reste, mais on peut aussi le préparer la veille.)', '2008-10-11T16:40:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, b31c7669-2c68-41b3-9553-f6bfc5a1d644, 'Super bon et pas trop sucré. Justement la recette que je cherchais. Ils sont croustillants dehors et fondant dedans. De plus, n''ayant pas de fruits, je les ai remplacé par des pépites de chocolat et cela fait super sympas. Très agréable au petit déjeuner et au goûter. ', '2008-10-09T13:03:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81837, 9d2ed480-0f0f-488a-a446-2fa72688a222, 'Avec une tasse de thé, ils feront sensation auprès de vos invités !', '2008-10-08T17:53:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533483, fe47169d-8c68-47b9-986b-817ef69dbe53, 'Très bon, régressif même 😅', '2023-10-09T21:21:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533483, e198219e-52ac-41e1-a0a9-96b2a776b9f0, 'So good !', '2022-05-11T03:49:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533483, 026cb246-ff8e-4705-988d-bd29957f4828, 'very good and easy to make', '2022-04-15T04:03:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12577, 61f95377-88ba-4da7-a738-cf5db41c541d, 'Pour éviter le goût trop caractéristique de la banane qui "éclipse" un peu trop la saveur des autres ingrédients, j''utilise des bananes encore vertes.', '2006-03-20T11:21:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12577, bc678ff1-f036-471d-88b7-f3c662e295e9, 'Le goût de banane est un peu trop prononcé, par contre, il faudrait peut-être accentuer la touche de curry, car elle est pratiquement inexistante! Bref à tenter (en forçant l''assaisonnement!) mais n''essayez pas de faire passer cela pour de la simple soupe-tomate chez vos enfants,ça ne marche pas!! ', '2001-05-07T01:31:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12577, 120d8871-e790-4e40-b7bf-2f13c7fad11c, 'Etonnant et délicieux !', '2001-02-28T13:12:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530454, 3677e541-151a-42b0-8a66-10d0834f77ba, 'C’était très bon (incroyable)
', '2022-04-23T20:03:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530454, 103924a4-f513-4727-8116-11eddc628cf8, 'Idée simple mais efficace : tout le monde a adoré à la maison !! ', '2021-04-12T12:52:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, 4658c30b-4767-43cb-a30c-0601dd45af46, 'Recette très simple et très bonne, mais serait plus simple s’il y avait des vraies unités de mesures et non des tasses pour doser.', '2022-05-10T15:51:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, 3110e385-3070-4d5d-9f32-6ef54e12dcb2, 'Très bon. J''ai juste diminué le beurre par 3, le sucre et j''ai ajouté un peu d''arôme vanille.', '2017-10-01T16:57:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, 1b842eed-70ae-4f5f-b013-4601e214dd4f, 'J''ai écrasé les bananes et pas mis de beurre du tout. Le goût est bon seulement j''ai obtenu des biscuits très MOU et pas CROUSTILLANTS du tout. Déçue.', '2017-04-25T21:55:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, cf334605-65b2-4664-95ee-ebe63a77e02d, 'Très bon, je n''ai mis qu''une coupe de sucre, merci pour cette recette. Approuvé par adultes et enfants ', '2023-02-25T11:43:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, 17616211-1ff2-49d0-b8ae-9d97e2463603, 'Très très bon croustillant à souhait je n''ai personnellement pas de sucre et c''est déjà sucré avec la banane et le chocolat ! 😁', '2021-12-15T16:24:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, 94dd7959-3a6d-4c1d-99b8-dc7b6f82b91f, 'Délicieux, crousti-moelleux. J''ai allégé en beurre (80 g) et en sucre (1 cup), et je n''ai pas cuit les bananes.', '2017-10-30T17:06:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, 8e5d35d0-5027-4682-99a5-10797a69a9b7, 'Au début, j''étais sceptique, mais mon Dieu, qu''est ce que c''est bon ! J''ai seulement mis 90 g de sucre. ', '2017-04-17T19:55:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, 488bbf6f-1fa2-4c6d-8318-ba1a8a0af95d, 'Excellent ! J''ai utilisé les conversions en gramme dans les commentaires et effectivement réduit le sucre de moitié comme indiqué en commentaire. Par contre j''ai adapte en écrasant mes bananes crues que j''ai incorporé dans ma préparation ce qui m''a permi de ne pas mettre de beurre du tout. Je vous le conseille vivement !', '2015-03-30T19:53:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, feff7728-3a07-4773-8360-a512966b98b9, 'Je ne mets que 3 étoiles car bien qu''ils soient vraiment très bons la recette est à revoir. J''ai réduit la quantité de sucre de MOITIE, et ça reste encore trop sucré. Trop de beurre également. Par ailleurs je trouve les mesures en "tasse" vraiment très pénibles, cela ne correspond à rien ! Nous ne sommes pas aux US où les mesurettes sont commercialisées partout et où tout correspond ! A chaque fois il faut chercher un tableau de conversion... Surtout qu''ici le beurre et le chocolat sont déjà  indiqués en gramme ! Voilà, petit coup de gueule passé, en attendant je me régale ', '2015-03-13T16:58:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, c7492962-af24-40aa-8de5-daf7485763fa, 'Très bons ces biscuits. J''ai utilisé 2 grosse bananes très mures que j''ai écrasé grossièrement et mis quelques sec. dans le micro-ondes. J''ai ajouté 2 autres tasses d''avoine, sinon la pâte était trop molle. La prochaine fois je mettrai moins de sucre. Peut être juste 1 1/4 tasse ou même... 1 tasse seulement.', '2014-03-23T20:46:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, cfd0fd0a-50cb-4e13-9963-b133ed3ad141, 'Très bonne recette, facile à réaliser, merci ! Ma seule remarque, c''est que je trouve qu''ils sont un peu trop sucrés. La prochaine fois, j''essaierai avec moins de sucre. Verdict des amis au brunch de demain.', '2013-01-26T18:40:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, 467a4d6b-52c3-4293-9f2a-0db58abdb26a, 'Super bon, facile et rapide à faire !!! Je les ai faits sans bananes, en divisant la dose par 2, et en mettant une demie tasse de sucre, avec une barre de chocolat noir coupée en morceaux !  ', '2012-07-17T11:28:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, 41245925-c1d0-4f5a-a9e3-2a35b7dda938, 'Allez-y les yeux fermés! Cette recette est géniale.', '2010-02-23T16:34:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, 971771d6-1861-457f-83d6-717f4c772b88, 'C''est excellent!!! A la maison mes trois garçons ont adoré. Et ils en redemandent encore et encore. Samedi, je fais la recette avec mes petits scouts. Ils vont adoré ! Quel délice.  ', '2009-06-05T15:31:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, 3566258f-1f96-4759-b3af-6ba3bbef2751, 'Excellente recette. J''ai utilisé un mug comme mesure, j''ai diminué un peu le sucre et j''ai ajouté une banane. Avec cette recette j''ai fait 45 beaux cookies. Pour info, j''ai utilisé du muesli au lieu des flocons d''avoine. C''est excellent également !', '2009-04-25T22:18:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, c880dc07-fa1e-425b-95db-7ebfe37ca4e6, 'Mmmmhhh...! C''est bon, rien à dire de plus...J''ai utilisé les proportions en grammes proposées dans les commentaires, dosé un peu moins le sucre, et utilisé du beurre demi-sel pour faire cuire les bananes ainsi que pour la préparation. Merci pour cette recette!', '2008-10-11T19:19:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, 3d9c835e-89c2-4ff1-99a5-ee9064bdc502, 'Alors là !!! Ça fait longtemps que je navigue sur Marmiton et j''avoue ne jamais prendre le temps de laisser un commentaire, mais là je ne peux pas faire autrement. Les biscuits sont vraiment délicieux. J''ai mélangé les œufs et le sucre à part et j''ai mis un peu moins de sucre. Puis je les ai ajouté au mélange farine, flocons d''avoine, levure, sel. Pour finir, j''ai ajouté le beurre, puis le chocolat, puis les bananes. Je trouve que cet ordre est préférable pour obtenir une pâte équilibrée, mais ça n''engage que moi. Quoi qu''il en soit n''hésitez pas à essayer, c''est un vrai régal, avec un goût d''authentique. Avec une grosse tasse, j''ai fait 74 biscuits...', '2008-03-19T19:45:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, 2ca3d6d4-21f4-48d1-849f-82a9b52f724e, 'C''est bon! Pour ma part je n''ai pas fait précuire les bananes. J''ai fait la préparation des cookies puis j''ai ajouté les bananes en petits cubes, résultat parfait! En plus ça se conserve quelques jours dans une boîte en métal c''est bien pour les enfants après le sport. ', '2008-03-09T17:57:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, 87a1faa4-e065-4c50-9ad3-1201da828310, 'Extra! Ca change du cookie traditionnel. Je n ai mis que 150g de sucre et 100g de pepites, moitié moins de beurre et utilisé de la farine complete aux 5 cereales et c''est un regal! Parfait pour un petit dej équilibré et pour commencer le journée de bonne humeur! Meri pour cette recette.', '2007-09-29T20:50:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46773, a9f0a949-e1be-40c3-bd0e-59de1e80177f, 'Délicieux!!! Pour simplifier, j''ai converti les tasses : 200g de sucre roux, 150g de flocons d''avoine, 200 g de farine. Bien mélanger toutes les poudres avant d''ajouter les oeufs.  C''est une très bonne recette, qui mérite d''être essayée.', '2006-10-22T14:38:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (89606, 9bb64cfb-9b9a-4c2c-9517-40c45d145d9d, 'Simple à réaliser, et super bon !', '2009-10-08T19:36:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52998, d8bfce53-b2a2-404a-95a2-41480c0710e5, 'J''ai fait cette recette pour le réveillon et sur 20 personnes il n''y en a qu''une qui a aimé. Les autres ont juste mangé les fruits. Beaucoup de mal à étaler la pâte qui doit être en dessous et pas terrible du tout à la fin de la cuisson. J''ai pourtant bien respecté les proportions, je ne comprends pas. Sans intéret. Aucun plaisir à le manger. Il doit y avoir quelque chose à améliorer.', '2007-12-27T04:09:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47407, fa742e8a-be45-4ef7-b3b4-f29fcc5eb6b7, 'Avec un coulis mangue et kiwi, c''est le dessert parfait ', '2016-10-30T03:42:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47407, 348fc1ca-887e-4936-a404-4c61f3e7dcd3, 'Très bon ! Aérien et onctueux ! Avec une couche de framboises au centre ça apporte de la fraîcheur et c''est un RÉGAL. Bien laisser au frais 1h à 2h avant la dégustation !! ', '2016-03-31T22:55:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47407, d9032cd8-1f76-4041-8e04-9d1637d9947b, 'Très, très bon et très léger!!! Accompagnée d''une tranche de mangue et de quelques raisins blanc c''est extra!!', '2008-11-06T16:29:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47407, 45b5db5c-9b69-44b4-8461-e6caae799e29, 'C''est bien bon, mais, en effet, le faire la veille pour que ce soit plus mousseux, même si ça ne fait pas de la vraie mousse.', '2008-07-14T13:13:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47407, ceb85cca-cfdd-4e73-8215-f475437bcc02, 'Vraiment pas terrible, et plus on met au frigo plus la banane rend du jus.', '2008-07-14T12:45:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47407, 111cb547-c68c-4d4a-9576-b733b29c1600, 'Bonne idée originale. Meilleure quand on laisse une nuit au frigo, plus mousseuse. ', '2008-05-16T19:21:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47407, 4e09f9f0-dc10-4463-b29f-02bca569add0, 'Je n''avais pas de bananes ni de pommes, à la place j''ai réalisé cette recette avec des kiwis et de l''ananas, c''est délicieux, léger !! Ce dessert est idéal après un repas copieux.', '2008-03-25T13:25:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47407, 2ae1fd5c-b4b6-42d7-93ff-a9f7c7ad085a, 'Très fraîche, très facile à faire. Et dire que l''on ne sait pas quoi faire avec des bananes trop mures ... Un délice.', '2007-08-02T10:26:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47407, 19e3b1e5-8d1c-422c-8d7b-8d303c315f67, 'Très bon et très frais!', '2006-10-26T07:13:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47407, d29132ad-9453-4f62-86c0-5c30e97ce967, 'Très bonne idée pour les restes de blancs d''oeufs non utilisés par les autres recette; de plus c''est pas mauvais!!', '2006-08-27T23:08:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48974, 6bdc0d80-ec18-4e82-a13b-340d733268e6, 'Plutôt une boisson qu''un dessert. Mais frais et désaltérant.', '2010-09-15T20:07:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52730, cef16c8b-5929-4405-a44b-40cc11080dc5, 'Très bon, j''ai utilisé 1 banane/1 poire et 3 pommes. Sous les fruits j''ai mis du chocolat à l''amande fondu.', '2016-10-06T01:56:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52730, 89850d61-fe7c-46d2-83d0-7da90d6e7ba6, 'Super recette ! J''ai juste utilisé une pâte feuilletée et mis moins de sucre par contre toute une tablette de chocolat noir, un délice !!!', '2014-09-30T15:59:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52730, efc968d0-a721-40e1-b462-b536697e18f0, 'Tout simplement succulent !!!
Je suis bluffée. Hyper facile à faire.
J''ai utilisé de la pâte feuilletée à la place de la pâte brisée. Tout le reste scrupuleusement respecté à la lettre, y compris temps de cuisson.
Ce n''est pas lourd du tout. Et l''idée de mettre des morceaux de carré de chocolat est excellente.', '2019-06-18T12:18:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52730, 9fb2f4b5-9482-44ae-8bc9-f93840d336ad, 'Tarte excellente, moelleuse comme il fallait, je n''ai pas mis de poire et rajouté 1 banane en plus, j''ai aussi rajouté de la cannelle qui se marie très bien avec la pomme et la banane pour la cuisson les 30 min sont nécessaires. Mon mari s''est régalé, à refaire. Merci !', '2014-09-15T01:48:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52730, b48aba34-d704-41e3-a4ad-068b10637b2a, 'C''est délicieux, j''ai ajouté un peu de chocolat, facile à faire et à refaire !!', '2014-01-02T19:25:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52730, 67e90cc5-d78f-496d-a830-09c114618608, 'C''est bon et surtout très facile à réaliser avec des ingrédients qu''on a facilement sous la main. Mes invités ont apprécié mais n''ont pas deviné qu''il y avait de la poire car la banane masque son goût. C''est le seul bémol !', '2013-02-25T16:31:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52730, d30177e2-b6e6-4238-9464-a2f5042a61d5, 'Une recette facile, j''ai mis 3 pommes et 2 bananes. Un véritable délice ! Onctueux et léger ! Je n''avais qu''une pâte feuilletée et c''était parfait ! ', '2011-10-14T16:52:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52730, 994213c5-a4d6-4a60-9f0b-7810bb0cc351, 'Cela m''a pas emballé plus que ça !!!', '2009-12-10T15:33:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52730, 8df0f558-59f5-4f05-8624-5f4660cb7c86, 'Une des meilleures tartes que j''ai testé...il n''y a que des ingrédients que l''on adore, bravo! ', '2007-10-06T12:53:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52730, 43248083-532d-456c-82e4-731fccc71580, 'J''ai un peu modifié cette tarte : 2 pommes, 1 banane, 20 cl de crème liquide, 1 sachet de sucre vanillé et des pépites de chocolat, le reste à l''identique. C''était très sympa comme dessert, à refaire ....', '2007-03-11T19:57:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52730, 632114ec-c600-4c2a-817b-b1f0a09c208d, 'Cette tarte est très savoureuse! On peut, peut-être, rajouter un peu de poudre d''amande ou de noix de coco râpée suivant les goûts!', '2007-03-11T18:19:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52730, b9761d7f-1d82-4003-a9b6-dd60c237ebbd, 'Je sors de table.... miam, miam.... une recette très originale, et en effet très savoureuse. J''ai utilisé une pâte feuilletée, cela rend, je pense, la tarte plus légère a digérer. Un excellent dessert a déguster en famille pour le plus grand plaisir des petits qui adorent le chocolat!! Merci pour cette recette !!', '2007-02-28T14:33:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52730, ae5b6a2d-26e3-4d80-a055-294eecb2d861, 'Tarte au goût plutot banal, étouffante à manger et plutôt lourde à digérer à cause de la banane je pense ( je réessaierai sans). De plus, 20 minutes de cuisson à four chaud suffisent amplement.', '2007-02-23T14:32:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61693, 0cb7ee26-490f-4b85-a182-7fca2044cdcd, 'Bon. Je n''avais pas vraiment envie de presser des oranges alors j''ai mis du jus d''orange. J''ai mis une pomme Granny c''est très rafraichissant. A refaire volontiers.', '2009-12-05T11:16:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61693, 33e13bdf-bbc8-4e8b-b370-3661bfc365d7, 'J''ai divisé les proportions par 2 pour une personne (sauf le yaourt), j''en ai encore pour 2 personnes, c''est parfait! Je n''avais pas de bananes, j''ai donc mis 2 cuillères à soupe de raisins secs pour sucrer un peu, et deux glaçons pour rafraîchir... Délicieux!!!', '2008-02-04T13:18:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22500, 6fff384d-e4b3-4f21-b1c8-f4708f2dae5e, 'Délicieuse recette avec si peu d''ingrédients... Nouveau pain favori !', '2023-01-13T00:11:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22500, 3a743a91-c0e8-428b-9ef5-5e67bc385319, 'Je l''ai fait sans les noix, c''est excellent. J''adopte !', '2021-03-21T15:52:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22500, 8bc93749-d094-4179-9be9-0877545d66f8, 'Parfait ! J''en fait quasiment un par semaine maintenant.', '2018-01-29T20:35:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22500, 5a346d30-2bda-4d61-95c0-3207f382d0b2, 'Je préfère remplacer la cannelle par une cuillère à café de vanille et remplacer la levure par une demi cuillère à café de bicarbonate de soude. Ça passe bien mieux.', '2016-10-18T15:21:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22500, ef78d676-0072-400a-a302-26ddd861f1c8, 'Je l''ai trouvé pas mal, surtout au petit-déjeuner festif. Pas la peine de hacher les noix, j''aime bien le côté craquant dans le gâteau. Par contre, la prochaine fois j''ajouterai une banane en plus, je n''ai pas trop senti le goût. A essayer aussi les conseils précédents, avec des pépites de chocolat.', '2013-05-25T12:13:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22500, 4b2b35d8-cd58-4a09-abd9-127190495c3a, 'Délicieux...nous avons ajouté des dattes et quelques pépites de chocolat ainsi que diminué de moitié la quantité de sucre...On s''est fait des amis!!!', '2008-03-06T04:07:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22500, b0a19d92-05bd-4636-8684-064631584d76, 'Délicieux!!!', '2007-10-03T21:36:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22500, 98c7c3c3-7c3c-4061-9687-609f28e77aa5, 'Rien à ajouter, c''est très bon!!', '2005-02-16T19:29:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22500, 4054ab8b-c75c-405a-a406-ed87ecd53020, 'Très bon, pas trop compliqué. J''ai mis de la fleur d''oranger à la place de la cannelle, et complété les noix par des raisins secs (parce que c''est un peu long de décortiquer 75 grammes de noix fraîches!!! ;D). Mélange très réussi en tout cas !', '2004-09-09T20:25:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22500, fe893453-665a-4074-84c2-b48c49dbb92a, 'Un délice, rien à redire. J''ai suivi exactement les explications et le temps de cuisson, c''est excellent. Pourtant, je ne suis pas fan de cannelle, mais elle se marie bien avec le reste des ingrédients. Les copains ont tous trouvé ça très bon!', '2003-12-21T10:20:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22500, 9882e70d-d3e8-4a28-add1-d087f321bffc, 'J''ai fait ça dans un moule à madeleines, excellent petit déjeuner qui cale bien. Réduire un peu le temps de cuisson pour un petit four.', '2003-10-03T13:11:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22500, 7124dcf3-f63e-49a7-b69d-47f51752205b, 'Très moelleux et très bon. Plus un cake qu''un pain, je dirais. Facile à faire, sauf pour le malaxage du beurre à l''aide des doigts que j''ai remplacé par une cuillère de bois.', '2003-06-09T16:26:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 306d177b-552e-4e75-9d05-e7709c949d26, 'J’adore, c’est délicieux ! En plus, on sent bien le citron et le chocolat, c’est super bon. Moi je mets une note de cinq sur cinq car c''est vraiment délicieux !', '2022-09-04T14:37:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, feee67d1-c2c7-4d21-913c-50ebb048e926, 'On a-do-re !!! Je n’ai pas utilisé de gingembre ni de citron car je n’en avais pas… Mais très honnêtement, c’est parfait comme ça… Je récidive dès ce soir car ce cake est une grosse régalade et il plaît à tout le monde ! Merci beaucoup pour cette recette.', '2022-09-04T19:41:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, d19260f4-1253-4958-a11f-807423ba3923, 'Gros succès auprès de mes collègues qui ont énormément apprécié
J’ai respecté la recette sans y mettre de gingembre, en y ajoutant une banane et en réduisant la cuisson de 5’ afin de le garder moelleux', '2022-06-28T14:40:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 50190005-4069-4d8d-a6b9-a93acb8f68f5, 'Au top ! C''est vraiment une bonne recette. J''ai suivi la recommandation de ne mettre que 100g de sucre et je n''avais pas de gingembre, pas de citron mais c''est vraiment très bon 😋. Merci la recette. ', '2023-05-04T17:29:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 4c3841a6-676f-444d-acde-5584da734105, 'C’est exquis 😋😋🤩👌👌 tout simplement délicieux. J’ai diminuer la quantité de sucre , et j’ai mise seulement 100g de chocolat noir. Grâce aux bananes 🍌 sont suffisamment sucrés. Ma fille n’est pas très fan de banane, mais elle a beaucoup aimé. Je vais refaire sans doute. Merci pour la recette 👍', '2023-04-18T11:24:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 39cfe9ec-14ba-468d-94c2-02f127c30714, 'J''ai réduit la farine, le beurre et le sucre et rajouter 1/2 banane. Délicieux ! ', '2022-05-29T15:08:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 171ebe09-6600-44a5-bcb4-a7d9f586561d, 'Super recette ! J’ai aussi mis moins de beurre et moins de sucre, la cuisson plutôt 30 mn, c’est délicieux ! ', '2021-10-09T17:32:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 84f9940a-8f58-4c04-8852-0b595ab1dff5, 'Simple et efficace merci', '2023-11-11T06:04:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, a13266a8-4319-4859-97f5-c1c5db370a49, '3 bananes : 2 écrasées et mélangées à +/- une grosse cuillère à soupe de jus de citron. 
1 coupée en longueur, déposée sur la pâte et légèrement recouverte. 
Pas de gingembre. ', '2023-10-25T20:50:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 17594907-8ee5-43ea-9338-44a8f1234070, 'Déçu! Ce gâteau était sec. ', '2023-02-23T23:23:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, c1223275-29c3-4d5b-822b-55af88d7f1c1, 'Assez sec', '2023-02-17T09:28:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, e746cacc-94fe-430b-8bcf-f612214dd2b1, 'Bonne recette.', '2022-09-10T19:42:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 9b929e7c-d4a6-4af7-ac99-d2f5d3c6802f, 'Excellent !', '2022-06-13T13:38:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 797f6645-d9c3-4346-b426-f6ea69d3b50f, 'Bonne recette, quelques modifications apportées ', '2022-05-31T20:15:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, de296f66-9028-4766-be59-4d55fb7609e6, 'Parfait quand nous avons des bananes trop mûres. Gateau un peu spongieux. Peut etre quil a manqué de cuisson pourtant j''ai rajouté 30min a 180 degrés', '2021-01-19T09:29:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, a8119636-adce-4695-92ab-66fbb7b1f363, 'La meilleure recette que j’ai trouvée pour ne pas gaspiller des bananes trop mûres. ', '2020-12-11T23:42:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 9ce74ad6-82f8-41c5-b28e-859fd479979d, 'j’adore c’est délicieux !', '2020-05-20T20:59:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, d03196f4-b61e-4827-b22b-d3080540a2a9, 'Excellent
Nous avons fait cependant quelques modifications :
- moitié moins de sucre (on sent mieux les bananes et le chocolat)
- un peu moins de beurre, 100 grammes ici ce qui n''en rend pas le cake moins moelleux, au contraire !
- 35 minutes de cuisson au total car nous aimons le chocolat encore coulant ', '2020-05-02T20:42:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 3ada32d8-4e8a-4e94-88dc-198eaa603bff, 'Délicieux et vite fait', '2020-04-30T10:24:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 7f86e4d6-87ec-40d9-b045-99c24370eba7, 'Délicieux je conseille !! Par contre je n’ai mis ni gingembre ni citron, j’ai fais fondre le chocolat, j’ai mis les bananes en bouillie et je n’ai mis que 150g de beurre.', '2020-04-20T20:08:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 04e44d5c-ab6d-4677-94dd-7397031d5116, 'Excellent ! J''ai suivi les conseils avec 100g de sucre et 200g de chocolat. Pas de gingembre. Le fait de laisser les bananes en petits dés et de laisser le chocolat en petits morceaux fondre pendant la cuisson donnent un résultat fondant, léger et non sec. Un régal, merci pour cette recette !', '2019-09-08T10:49:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 15f0dd78-a58b-405d-9368-e77c64fb359c, 'Délicieux !!', '2018-11-25T12:51:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 4e6923fc-cbac-464a-8396-ce33e9ba5eb2, 'Délicieux ', '2018-09-06T06:06:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 2c15fa08-397e-481e-ad80-ca749e508021, 'Un régal !! J''ai parfaitement respecter le dosage de la recette mais à la place du chocolat (y''en avait plus oups...) j''ai écrasé des "chocobons" !!!! Et mélanger à la pâte !! Un vrai délice !! Merci pour cette recette !! ', '2016-12-15T13:23:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 4b391a6b-6d08-4605-b963-390bd959ccc8, 'Facile à réaliser.   Très bon !', '2016-11-28T21:34:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 2955552f-bab4-4727-8343-96daa71f7bb3, 'Nous avons adoré cette recette ! Les seules modifications apportées sont : - une cuillère à soupe de rhum ambré - cuisson de 35-40 minutes', '2014-04-02T01:13:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23668, 318a23bb-2b77-481f-acd6-a87884167659, 'Cake très facile à faire et délicieux 😋 ', '2023-10-26T12:37:08+02:00');
