INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, f9ba4a12-36e1-4919-b4cb-d47d81844248, 'Parfait je n''ai rien changé à la recette', '2023-03-25T11:06:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, a0de0514-183a-4885-9e7d-46b5b6b35fff, 'J’ai suivi la recette à la lettre donc pour la crème pâtissière nickel mais pour la pâte brisée, ça manquait vraiment de farine que j’ai ajoutée une fois sortie du frigo et top perso je l’ai fait aux framboises ☺️', '2022-11-06T20:54:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 306b2049-4f48-40b3-9633-187794c6fbf5, 'Très facile à réaliser très bon peut-être mettre plus de lait dans la crème pâtissière mais sinon très bon', '2022-07-12T12:30:16+02:00');
