INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339648, 7d3eb7cd-b016-4800-a806-cb7ec6b11a32, 'Une réussite. C’est très bon. Cuisson 180 plutôt 1h', '2020-03-29T14:32:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339648, d5e9dc73-d37a-41c4-93b6-f52a1a4ef129, 'Très bonne recette. J''ai juste réduit la quantité de sucre à 120g et ajouté un sachet de sucre vanille comme proposé dans un des commentaires et c''était parfait. Merci pour cette recette !', '2020-03-26T13:13:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339648, ab161926-f49b-4621-b63b-9d0650308e8a, 'Délicieuse recette,  effectivement un peu trop sucré,  120gr devraient suffire,  je n''avais pas de crème mais la texture était quand même parfaite, j''ai du rallonger de 15mn le temps de cuisson. J''ai ajouté de la vanille. Moi qui adore les myrtilles, c''est le dessert parfait !', '2019-08-11T09:00:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339648, beb5e5f8-cbdc-4e2b-80e8-e0c645f88891, 'Très facile recette à cuisiner, j''y ajouterai de la vanille et moins de sucre ! Merci.', '2019-05-26T22:03:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (339648, 228aa643-11fe-4d30-9b87-41c23eeded11, 'Simple et rapide, il sort du four. Hate d''y plonger une cuillère tant ça sent bon', '2019-03-08T12:01:44+01:00');
