INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, bfccd2ee-2e17-4ae3-9afb-840e8cc47a32, 'J''adore cette recette ! A refaire très vite ! J''ajoute également de la compote de pommes au fond de mon plat ! ', '2014-11-24T21:36:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 3703e7a3-f654-43ff-8322-cae5bc416e07, 'Délicieuse j''ai mélange avec de la banane et j''ai ajouté un bouchon de rhum puis j''ai fait cuire de la confiture de figue que j''ai étalé au pinceau dessus ! Un délice par contre le rhum se sent bien même si j''en ai mis qu''un bouchon', '2014-03-02T20:50:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 4ffd35df-8736-4b33-bd49-24c467e253b3, 'Un peu moins de sucre et c''est parfait !', '2013-11-13T12:41:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, acae8cfc-2c92-40bc-9dd6-1966a77ad2b9, 'Cette recette est très bonne et facile à faire. Le mélange est plus léger que les mélanges traditionnels avec crème et poudre d''amande. Parfait', '2013-10-29T20:05:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, ca417d2b-70f2-4e76-8e64-2133fb52adc7, 'Je remplace le sucre par de la cassonade, c''est délicieux.', '2013-10-19T21:11:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 19fdada4-3f90-43f5-a9fe-83ccda14b10c, 'Merci pour la recette facile mais j''ai été un peu déçue aussi par rapport aux commentaires.  Je trouve que cette tarte manque de quelque chose sans vraiment  savoir  dire quoi... Je ne la referai pas non plus.', '2013-03-30T18:51:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, e835ad23-f488-474e-aecd-86c909c2e7e3, 'Simple, rapide et gourmande. On trouve toujours mieux mais ne faut il pas se contenter quelques fois de plaisirs simples ... ', '2012-11-04T11:07:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, a3eb2267-eff1-4c5c-9d79-c68d861c1f15, 'Bon mais un peu déçue par rapport aux commentaires enthousiastes. Je ne la referai pas.', '2012-04-24T21:40:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 1e2ec389-e360-4edd-9b26-62bada625198, 'Délicieuse je la fais ce week-end à refaire', '2012-04-01T12:35:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 1a11b18b-5263-4e0b-b358-31e3c14b463e, 'Recette facile et toujours un succès. C''est frais et moelleux.', '2012-01-25T17:21:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, b89addbe-47a9-40b3-aeac-ce0fbafab6a6, 'Parfait !', '2011-07-27T21:56:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 0ab5418e-a8c3-47c7-805d-d53f60c0cfb2, 'Très bon et facile. Merci. Tout le monde s''est régalé.', '2011-05-22T21:37:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 0ffa39ad-93a9-47b4-82ef-3e2f4a4332ac, 'je l''ai testé ce week-end : un vrai régal. J''ai hâte de pouvoir la refaire surtout que la recette est simple comme bonjour.', '2011-03-21T17:30:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, ef5eb6a2-e4b7-488c-8171-981cc5a43a35, 'Très bonne tarte aux pommes rapide et facile à faire. Merci.', '2010-08-10T18:02:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 6ac7ad91-4c36-4974-a67d-8c0bb27c0d0f, 'J''ai simplement remplacé la pâte brisée par de la feuilletée, mais tout est parfait quant aux doses d''ingrédients indiqués.           j''ai simplement remplacé la pate   brisée par de la feuilletée ,mais tout est parfait quant aux doses d''ingrédiants indiquées.        ', '2010-03-07T17:32:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 3e8da4ff-8973-4717-b6ba-799c06adf480, 'Je préfère la faire avec une pâte feuilleté c''est moins bourratif et je mets toujours un pots de compotes de pommes dans le fond, c''est beaucoup moins sec et très fondant!', '2009-10-27T09:41:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, eddb8e1a-ccd0-49e0-856b-60c26be29cfe, 'Excellent, j''ai ajouté un peu de rhum dans la préparation, c''est excellent ', '2009-10-15T10:41:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 70887634-93ec-4e34-91d7-3a73c65f045e, 'Entre le flan et le clafoutis, juste ce qu''il faut en sucre, on s''est régalé avec mon mari. J''ai laissé le gâteau dans le moule après la cuisson, du coup la pâte était croutillante, la préparation crèmeuse et les pommes fondantes : un délice !', '2009-08-30T01:12:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 76d68427-49ee-4b4a-993c-5de70418e259, 'Recette très facile et classique. ', '2009-02-08T11:53:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, b9df8b39-19b4-4fff-bdbf-2f9c25216d2a, 'Excellent! On s''est tous régalés! Mais personnellement j''ai laissé cuire 15 à 20 minutes de plus.', '2009-01-20T13:10:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 6be6b2cb-bb5b-47f9-92a4-62e223d3d1b7, 'Un vrai délice!', '2008-10-06T01:49:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 58f3863a-602c-4c26-ba15-4c5f14451f5d, 'Une recette classique incontournable que tout le monde adore, surtout la touche de cannelle!', '2008-08-30T20:07:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, e85a2ace-83ea-4002-b352-59a878aa0398, 'Délicieux!! J''ai juste mis de la crème semi-épaisse (allégée à 3% de MG) à la place du lait. Tout le monde a aimé.', '2008-08-25T22:22:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 2c081389-f4f4-4801-b4b2-14d99807f2f1, 'Excellentissime... la préparation que l''on ajoute est un plus qui fait toute la différence. On peut faire précuire la pâte et faire moitié sucre blanc et roux. Recette que je garde précieusement ^^', '2008-08-18T21:11:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, c924f8f8-d155-4b45-abaa-427d8282e063, 'J''ai fais ce dessert hier soir, en voulant faire une tarte aux pommes plus élaborée que celle que je fais d''habitude. Elle n''est pas mauvaise, mais j''ai été un peu déçue, je n''ai pas trop aimé le flan que cela faisait. Cependant mon chéri m''a dit qu''elle été très bonne! ', '2008-02-15T11:51:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 6ab1535b-7617-4a4c-ab80-6ffe6e92b616, 'Excellente - j''ai utilisé une pâte feuilletée et mis du sucre roux.', '2007-12-02T14:51:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 8d0ea716-822b-4dd0-80bc-89c1db392658, 'J''ai essayer cette tarte qui est exquise et facile à réaliser. J''ai juste remplacé la pâte brisée par de la pâte sablée. Encore merci.', '2007-11-13T21:51:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 41893240-b4f5-4e40-85b3-0cbda77063f3, 'J''ai essayé cette tarte, et c''était super bon! Et vraiment très simple à réaliser. La seule différence par rapport à la recette indiquée, c''est que je ferai précuire un peu la pâte avant d''ajouter les pommes et la garniture dessus. Merci pour cette recette simple et très bonne!', '2007-09-27T17:48:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, e2aa7cb3-a1f5-4017-ac2e-355f3382a213, 'J''ai ajouté une cuillère à soupe de Sirop de Liège dans la préparation à base d''oeuf et de sucre. Aussi, j''ai fait moitié sucre blanc/moitié sucre brun...  Toute la famille a apprécié !', '2007-07-24T12:53:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 205d6863-fed7-4c5b-a437-50bfdeb5a86b, 'Excellent, facile, bref super. Beaucoup de cannelle, un petit sachet de sucre vanillé sur le dessus avant la cuisson et le tour est joué. ', '2006-11-11T20:45:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 3aeebd49-a52b-4f70-8970-bdc732376f4a, 'Un vrai délice et rapide à faire.', '2006-06-15T22:33:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, de1deb85-32aa-4be4-a43d-1876a6688fd6, 'Miammmm...très bon, rien à rajouter. La recette est tip top, j''ai mis pas mal de cannelle, c''était delicious!!!', '2005-11-21T23:17:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 1917c3be-f144-4384-9c58-2182ca8593f8, 'Très bonne et facile à réaliser. Je l''ai faite avec des pommes granny smith (parce que je n''avais que ça!) et j''ai forcé sur la cannelle parce que j''adore ça ! En plus, elle est pas trop calorique en mettant du lait écrémé et éventuellement de l''édulcorant. ', '2005-04-12T17:46:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, cbc0c96e-bd96-42ef-8f13-3864151d0af6, 'J''ai essayé plusieurs recettes de tarte aux pommes provenant de Marmiton, mais c''est celle-ci qui a eu le plus de succès auprès de mes invités ! Un conseil : ne lésinez pas sur la cannelle si vous aimez ça !', '2005-01-07T19:04:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 15cea0ee-0d2a-4231-a780-62a220a0bd6d, 'Bon et inratable, mais ça n''est pas non plus la tarte aux pommes du siècle! Un oeuf peu suffire pour ceux qui ont des problèmes de cholestérol...', '2004-10-03T18:13:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 750c5b09-43df-4a96-baa3-88fac78b16d5, 'Une tarte aux pommes correcte, mais quelconque. Elle sent bon à la sortie du four certes mais au palais c''est plus terne. Pourtant pas de problème de pâte détrempée!', '2004-04-13T14:58:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 4581885e-5fc3-4276-b88e-fd2106ca8d22, 'Délicieux, super facile à faire, même avec ma fille (5 ans). Chaude ou froide, la tarte est toujours aussi bonne.', '2004-04-07T19:48:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, c973eda3-1f6d-4433-89be-0b79901d2ee6, 'Je n''avais jamais fait de tarte aux pommes. En plus, mon invitée n''aime pas la cannelle mais je ne savais pas. Elle l''a trouvée vraiment excellente et moi aussi d''ailleurs. Un grand merci !!', '2004-04-06T10:57:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 5b124e75-2ac4-4028-b1fe-61f04e2872d8, 'Je l''ai faite, elle est très facile à faire et vraiment succulente!!! Je vous la recommande. Toutefois, il faut la laisser un peu plus de temps dans le four et en fin de cuisson, je vous conseille de saupoudrer d''un peu de sucre vanillée...', '2003-10-11T21:53:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, f9366706-fcdf-41b7-ac65-e515855fdf05, 'A tomber!!! Cette tarte est une pure merveille. A chaque fois que je la fais, tout le monde se régale! Un conseil quand même : soyez patient il faut la laisser bien refroidir pour qu''elle exalte tous ses parfums !', '2003-08-05T13:54:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 66ab6570-0b72-497a-9327-55317993f881, 'Très très bon, je recommande!', '2003-05-06T15:44:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 5724c227-8a38-44e4-b0a9-1af1bece1909, 'Simplement délicieuse!', '2003-02-19T12:59:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, f0c38189-2b84-4332-bc09-29a2de39f3ee, 'Excellent! Tarte très bonne et facile à faire!', '2002-09-25T20:16:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, db039277-e38c-4815-9e82-8454b4b2a2cb, 'Excellente recette. Une recommandation toutefois, étant donné la structure liquide incorporée, il est préférable de faire mi-cuire la pâte à blanc, puis de faire refroidir, avant d''y mettre les pommes et la préparation. Sinon, elle a  un véritable succès: elle n''a pas eu le temps de tourner, si ce n''est deux fois autour de la table. ;-)', '2002-04-19T12:19:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, e9cf0d0b-f1ae-4ddd-b358-de5a0070f065, 'Vraiment bonne et simple. Terminée il y a quelques minutes à peine, il n´en reste déjà même plus la moitié (et on n´est que deux à en manger)!!!', '2002-01-21T18:10:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, d2bfade0-1e76-42ec-8c03-33cbb1a747e1, 'Merci pour cette très bonne recette qui est facile à réaliser et délicieuse à déguster!', '2001-10-28T20:02:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, ef9b6491-dc8e-4e9c-a922-50c20d225b82, 'Rien a dire, c''est parfait et exquis!! C''est aussi bon pour le palais que pour le nez: une odeur incroyable et un petit conseil...n''hésitez pas sur la canelle!!', '2001-05-03T19:16:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 4e437efc-0080-4c27-8780-91c28451a107, 'Super sympa. Surtout avec des restes de fruits. J''ai ajouté aussi des cerises ', '2016-06-19T14:47:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, ed91a549-b7c5-4664-a5aa-d8ff99f982a1, 'Rapide et facile à faire. Génial j''ai beaucoup aimé ! A refaire !', '2013-11-25T00:29:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, d7959066-d39a-4c9b-a443-d432e2d771ed, 'Très bon, fait avec de la chantilly maison miam !', '2012-08-02T20:38:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, fb9529d9-643c-44d4-9f4b-d26730911de3, 'Super simple et super bon ! Mes invités ont vraiment apprécié. Merci pour cette recette.', '2012-05-20T20:46:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, aaf1768a-6398-40a6-8b17-85b66a6be569, 'Rapide à faire et sympa ! ', '2011-08-27T23:50:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 60bf3fa6-877c-4ffb-a64e-27d433957e6c, 'Ravie ! Un dessert rapide frais et léger comme je les aime. Merci beaucoup.', '2011-08-15T15:22:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 9aa42a6c-cec2-41eb-b47b-bf4f556e4d03, 'Très bon, très frais, on ne peut plus facile !!! J''adore.', '2011-04-24T20:28:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 25c1b89d-c9c8-45d4-8b6e-1e8987bde72b, 'Un délice, un dessert très frais. Les invités ont adoré.', '2010-04-26T17:56:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 6f327801-e4a9-44db-b6c6-0ec9d1f8868c, 'Facile à réaliser, une jolie présentation, et exquis !', '2009-08-22T10:52:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, dd60d7ca-d6f4-4ed8-b693-f9a06e56712b, 'Recette rapide et excellente. Merci pour la recette.', '2009-07-13T13:22:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 4cc9edb0-8a2b-4837-8c94-da98985fc152, 'Super bon !!! A la place de la crème fraîche, j''ai mis un mélange mascarpone-œuf-sucre (comme pour un tiramisu). Au dessus, j''ai décoré avec des petits morceaux de kiwis et des amandes grillées. Un vrai délice !!!', '2009-05-29T12:40:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 246c385d-a4f9-4201-9b52-63c0c1c595c0, 'Très bon et hyper fastoche !', '2009-04-26T20:38:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 88b6b153-5366-4ab3-80e4-c66c6816e9d0, 'Super simple, rapide et surtout super bon! Merci pour cette recette!', '2008-06-09T12:59:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, f82adf93-809f-42cf-95f7-c0ce63be4979, 'Bonne recette. Pour 8, j''ai mis 4 bananes et 1 kg de fraise. Les spéculoos, je les ai émiétté dans le robot. J''ai suivi les conseils et ajouté du sucre vanillé aux fraises. Sandrine ', '2008-06-08T14:05:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 0c6c9c0c-445b-40ee-af00-49e235234ea3, 'C''est excellent ! Mes 3 enfants ont adoré. J''ai rajouté un peu de sucre en poudre entre les bananes et les fraises et pour finir la déco, j''ai mis une petite fraise sur la chantilly et un spéculoos sur le côté dans la chantilly. Recette à refaire absolument !!!!!', '2008-05-20T23:27:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 7d4be7e9-cf50-4f7f-a911-792ebabe1d40, 'Très bon ! J''ai ajouté un peu de sucre vanillé aux fraises sinon c''est un peu sec. Avec des cigarettes russes en déco sur la chantilly, cela fait son effet c''est très simple à réaliser.', '2008-05-02T16:11:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 4b08044a-c492-4c62-918d-c14716f73e10, 'Excellent!', '2008-01-17T15:26:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 75cf5a1c-7fb9-4c93-a0d8-7267e0e6a2c6, 'Je ne met que quatre, sur trois enfants, deux ont beaucoup aimé! Merci pour cette recette très simple à réaliser. ', '2007-07-10T22:59:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71085, fcc79df5-3bfd-40dc-abe2-377e259b8662, 'Top ! Un délice ', '2021-02-14T22:09:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71085, 89e45f2c-8716-4d09-a1f8-1d157c02f4aa, 'Super bon ! Tout le monde à adorer le mariage fraise/pistache ! Par contre impossible de trouver  de la pate de pistache je l''ai donc faite et c''est  vraiment pas compliqué !', '2018-05-30T07:52:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71085, 79211a09-0a63-4ad9-bad6-c83209710589, 'Le mariage fraises/pistaches est tout simplement génial ! La prohaine fois je mettrai de la pâte à pistaches avec toute la préparation au mascarpone ca sera encore meilleur ! Pour ma part j''ai utilisé des boudoirs traditionnels. Les invités ont adoré !', '2017-07-09T18:41:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71085, a9aeb34a-2055-4dfc-8fac-0fa82d5b1df3, 'Recette super bonne merci ', '2017-05-20T23:44:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71085, 0fa1cfe3-0179-422f-a72d-3129d12285fb, 'Mariage subtil delicieux. Même les réticents à la pistache ont aimé. Moi j''ai adoré, la prochaine fois je ne mettrais pas le lait sur le macaron framboise pour garder le croustillant. ', '2017-05-13T23:25:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71085, 8610bdd3-4238-44c3-b50e-7aa3706549d7, 'Excellent la pistache et la fraise en ensemble un vrai régal', '2017-05-13T21:22:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71085, 8f06b6c7-5b8a-464d-a344-2968b2e8ce2f, 'J''adore', '2017-05-13T15:25:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71085, 7e419291-6091-4c2a-bec6-da682e4a9e61, 'Quel bon dessert de saison !', '2017-05-13T11:26:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (71085, 99a98f30-8a70-4175-9bf0-b43216f78457, 'Excellent! Très sympathique recette qui change du tiramisu traditionnel. Tout le monde a adoré le mariage pistache/fraise. Merci Agathe ....', '2008-06-01T15:41:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, d4b5d381-4ef3-4638-aa6f-f60391ee399e, 'Miam', '2023-06-02T21:11:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, ed63bc59-5894-4239-b1a4-0130f9f44287, 'Très bonne recette. J''ai mis 100g de sucre et 2 sachets de sucre vanillé. A refaire!
', '2021-07-28T21:16:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, e6741e84-e2af-49de-8939-f83f4217f360, 'Franchement, c’est très joli, mais décevant. À mon goût, le rapport fruit/appareil n’est pas équilibré. Trop de fruits ou appareil trop léger. Le Manque de consistance est-il dû au fait que les fruits ont trop mouillé la pâte ou que la maïzena donne une pâte trop légère ? Bref... Next time je mixerai farine et maïzena, et mettrait 300g de fruits au lieu de 400g. J’avais allégé en sucre et mis 100g au lieu de 125g mais pour le ratio fruits à 400g c’était trop léger en sucre aussi. Allez on va tâtonner jusqu’à obtenir le parfait clafoutis... Stay tuned !', '2020-01-03T09:57:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, a567e77c-726c-4580-91be-dfe28d43ccac, 'Super recette en mettant framboises ou abricots à faire aussi avec d''autres fruits mais pas encore essayé. Pour la cuisson 40 minutes c''est très bien.', '2019-07-16T08:56:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 72ae0048-8885-46e6-a04d-44c7c050ad06, 'Vraiment délicieux, simple et rapide à faire.', '2019-05-12T15:10:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, b96081d1-e8dc-472b-b205-2c3fd5111708, 'Excellente recette. Le fait d''utiliser de la maïzena à la place de la farine rend le clafoutis plus onctueux et plus léger. Un délice, à refaire.', '2018-11-04T03:51:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 28114d37-d4fa-45d7-a95a-53c800d28132, 'Parfait !', '2018-09-29T11:10:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 7506e323-bdb3-4b2a-8a82-dcdfadaebefd, 'Délicieux !', '2018-08-15T09:58:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 47bded62-284e-4f3f-93e4-dfb9e7297bc4, 'Super. Trop bon ! Le flan ressemble et à vraiment le goût de clafouti.', '2018-06-26T09:46:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 1cc7438c-ab8f-4d68-a15a-125246dba955, 'Recette faite 2 fois : un vrai succès. J''ai mis des framboises surgelées et le temps de cuisson avec toute la préparation est bien de 40 min.', '2017-08-20T19:48:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, e11bdc75-a6f1-4a86-952d-2c87349d9869, 'Très bon avec les mûres et 100 g de sucre roux. J''ai remplacé la crème fraiche par du fromage blanc. C''est mieux de mettre un peu de sucre dessus le clafoutis pour atténuer l''acidité.', '2017-07-31T15:44:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 85e1f898-c63b-49fe-a5cd-a6e517d96aa4, 'Bon dessert, très parfumé ! Je mettrai juste un peu moins de sucre la prochaine fois, mais j''ai beaucoup aimé !', '2017-07-21T22:20:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, d273950e-3269-41e6-bde8-dd72c3157522, 'J''ai fait ce clafoutis il est super bon et facile ', '2017-07-14T21:41:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 1a2a7a8e-7de7-401f-8ad0-96ec7d19136c, 'Délicieux !  Hyper facile et savoureux à souhait !  Un régal avec des framboises fraîches ! ', '2017-07-02T14:06:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 182dba55-ba50-4e50-baa8-a652cb16c15d, 'Clafoutis excellent. Pour ma part je n''ai rien changé. Le temps de cuisson est plutôt de 40 min au lieu des 30 min indiquées.', '2016-12-21T03:24:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, b1f6f45a-a76d-4784-84e8-b3ac7a0f3d67, 'Effectivement il faut prolonger le temps de cuisson mais ce clafoutis est un véritable régal. Les saveurs ressortent bien, le tout reste très léger.', '2016-10-04T16:23:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 55bab1d8-771a-4206-8f68-7f7b86a58fed, 'Très bon mais faire chauffer beaucoup  plus longtemps. ', '2015-09-17T15:14:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, bd1fbade-dbac-4d47-96d8-7df34081174c, 'Bof! J''ai trouvé la pâte liquide au départ. A la cuisson, confirmation de mes craintes. J''ai dû prolonger jusqu''à 1 heure de cuisson pour avoir quelque chose de mangeable. Résultat final décevant avec des framboises trop cuites et complètement défaites!', '2015-07-22T14:24:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, c1676f2d-4f69-4168-8462-db5ef66b8d5b, 'Super, trop trop bon ! Il faut juste le laisser plus longtemps cuire !', '2015-07-12T18:29:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 0413c3dd-dd13-4c4a-a1ac-817524182353, 'J''ai mis moitié fraises moitié framboises. Le clafoutis était super parfumé et délicieux. Pour la cuisson, j''ai laissé le temps indiqué mais n''ai pas sorti tout de suite le plat du four. C''était parfait.', '2015-06-21T00:34:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, c96abbd9-3b4d-4f18-a420-00f0337174c1, 'Excellent clafoutis. J''ai fait cette recette 2 fois, avec des framboises puis des abricots et c''était un succès à chaque fois. Pour ma part j''ai dû rajouter environ 20 min de cuisson.', '2015-06-17T14:11:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 8d663a5f-d6a1-4eae-897f-34987da29d05, 'En rajoutant 15 minutes de cuisson, c''est parfait! ', '2015-03-04T21:07:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 8e2f1d10-3b58-4c90-9f83-8421b1756a3d, 'Le résultat est parfait. La cuisson est beaucoup plus longue que celle indiqué sur la recette, compter presque 1 h à 180°C.', '2015-01-20T17:18:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, cc556149-b1e6-496a-aa58-f4b2e7231247, 'Très bon mais j''ai essayé framboises et mûres avec sucre vanillé quand je sors le plat du four accompagné d''une glace vanille : excellent   ', '2014-10-27T18:59:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 030ef07a-99f5-4019-8813-2638a3ef5f10, 'Très bonne recette ! Le rendu est impeccable avec 5-10 min de cuisson supplémentaire en fonction du four utilisé. Un peu de sucre glace par dessus avant la fin de cuisson donne un très léger côté craquant et atténue un peu l''acidité des framboises. Une recette que je ferai à nouveau, sans aucun doute !', '2014-09-11T21:58:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 2b865732-13d9-453f-860d-8d5f65ecca6a, 'Très bonne recette mais trop souple et pas assez de tenue pour avoir une part belle dans l''assiette. Mettre un peu moins de framboises mais je le referai', '2014-07-17T20:57:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 2415d998-190a-499f-90d7-17ea64347099, 'Excellente recette et simplissime ! J''ai saupoudré de sucre glace 5 min avant la fin pour un coté doré.', '2014-07-08T02:50:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 19621620-1e65-44a3-8c75-55286cec15de, 'Trop bon !', '2014-06-29T15:23:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 673826fd-102c-4e60-87f9-6344b44ef7ad, 'Très bonne recette ! J''ai juste ajouté du sucre vanillé sur le clafoutis pour éviter que ce soit trop acidulé. Tout le monde a adoré !', '2012-11-25T00:14:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 59d17ed9-3fc4-4f07-8a82-0db9036ed393, 'C''est la recette de base à avoir pour un clafouti ! Pas trop pâteuse et pas trop liquide ! A réutiliser avec toutes sortes de fruits !', '2011-12-18T20:21:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, b808ec53-16a4-460b-a9bc-1dac13fa6626, 'Super dessert, facile à réaliser même en demi portion.', '2011-08-06T20:39:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 53c1c46d-1790-4ca0-8386-8104918480d0, 'Recette simple, rapide et délicieuse ! Ni trop sucrée, ni trop lourde, c''est un dessert idéal qui rappelle les bonbons de notre enfance de par à l''acidité et le goût de la framboise. Désormais je ferai des clafoutis aux framboises plutôt qu''aux cerises même si c''est un incontournable ! ', '2011-05-08T12:52:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, be69ec21-1843-42ae-993b-2056548a19b1, 'Très bon, mes invités ont apprécié, j''y ai ajouté de l''arôme vanille.', '2010-11-13T11:42:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91089, 2c51a714-30be-46d0-9183-712a32c81e54, 'Un vrai délice. Recette adoptée. Facile à faire et hyper bon. Merci.', '2010-10-25T15:30:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 66bc16f0-5687-4b7e-b20f-a903aef63018, 'rapide, délicieux, et bon marché ', '2022-06-19T14:35:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 8aec9bfd-a1de-441c-92f2-f5d233fa2984, 'Excellente recette ! Faite avec un peu de crème fraîche et sans sucre vanillé. Un pur régal ! Merci pour la recette', '2022-06-18T14:36:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, ee281597-c3ca-4784-8007-960b177d2fa7, 'Excellente ! J’ai suivi les commentaires et ajouté un peu de crème fraîche. Les enfants en raffolent !', '2018-08-04T10:41:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 29ce706a-9c88-4a0e-a93b-d6b1e1c165ec, 'Excellent ', '2015-08-15T23:25:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 293009e2-b524-4db6-b91c-52420783bece, 'Délicieuse! C''est vrai qu''il faut avoir un mixeur solide!', '2015-08-06T02:39:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 21e95323-7ae5-48e1-ad7d-2c69f2a0131d, 'Excellent !  J''adopte cette recette, le résultat est parfait. .', '2015-07-13T23:39:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, d0ba0457-1311-46cb-a5df-b892199330c6, 'Excellent !!! J''y ai ajouté du lait et de la crème car mon robot n''arrivait pas à mixer... Et vu la quantité j''ai mis deux sachets de sucre.', '2015-03-17T17:23:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, f2f4ce7d-8250-44c7-b8f6-431a26ba6c2f, 'Frais, sain, bon et rapide. Parfait quand on a des bananes farineuses ou trop mûres. J''ai fait ma flemmarde en utilisant un mélange de fruits rouges déjà surgelé. Et en ajoutant 100 g de fromage blanc on obtient un effet un peu crémeux... mais light ! A refaire.', '2014-09-27T19:04:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, c623818a-3a31-4478-90f8-f3e6ee00d0d4, 'Je fais la même recette depuis un moment déjà avec mon thermomix sauf que je ne mets pas de sucre vanillé. Je goute avant la fin et si ça n''est pas assez sucré je mets du Sirop d''Agave.', '2014-09-15T21:48:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 974122ae-37e9-4c08-b3d7-dcd0666ff0f6, 'Dessert de dernière minute excellent ! A refaire  ', '2014-09-15T20:39:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 4b805182-c624-4fce-8bcc-8f12b81d147b, 'Super ! Rapide et délicieux !', '2014-09-15T19:06:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 421ff8ac-f335-418a-8fd6-45a907843bec, 'Pratique quand on a des bananes trop mures ! Je congèle et quand on a envie d''un dessert vite fait !! J''ajoute simplement pour mixer un ou deux yaourts natures maison. Pratique pour le régime !!', '2014-08-24T16:06:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, d34b5850-d438-43e4-86c3-7501987367a4, 'J''ai trouvé la recette excellente même si pour moi le goût de banane était un peu présent et que pour moi il fallait un peu plus de sucre voila sinon merci beaucoup', '2013-09-16T20:54:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 90f37bcb-cd88-4540-a44c-5ca8ba904655, 'Divin! A faire et refaire sans complexe. En tant que diététicienne je la recommenderai à mes patients.... J''ai utilisé des framboises surgelées et j''ai décoré de riz soufflé et de morceaux de fraises. j''essayerai de la décliner...', '2008-05-29T04:11:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, 2bc639c5-d2a8-4082-b703-4ac6f7145c1e, 'Délicieux!! Encore meilleure avec de la crème fraîche liquide 0%.', '2007-04-20T19:52:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46230, ffbaadff-0608-4cdb-b433-cd12e7e74e64, 'C''est simple et très bon bravo! Parfait l''été, rafraîchissant.  Merci de nous l’avoir présenté! ', '2006-04-26T16:42:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 927a6ea8-3630-4342-8ebe-07f41994741d, 'Très bon', '2018-10-28T14:59:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 3ead753a-a08f-4cae-9572-51ab7cccc495, 'Super bon j''ai fait exactement comme indiqué seul problème, au moment de couper le crumble était en miette.', '2016-08-05T18:48:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 5381af01-abdc-4de3-b343-01e9931d0560, 'Délicieux, mon mari a adoré.', '2016-05-18T21:08:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, aeef65e4-95cb-4ff0-89f5-67f67051d761, 'Vraiment très très bon ! J''ai laissé cuire 10 min de plus pour plus de croustillant, tout le monde a aimé ! ', '2016-05-18T20:25:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 7ad35611-fcfb-49bf-8019-db35e6594276, 'Très bien fait ', '2015-02-25T20:56:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 2826c36d-7786-400a-bf71-aaf1cb7e6690, 'Très bonne recette, par contre j''ai voulu faire caraméliser les fruits avant de mettre le crumble au four mais je n''aurai pas du, c''était un peu trop liquide. La recette est délicieuse, j''ai ajouté quelques goutes de negrita dans la pâte à crumble c''était extra !', '2014-04-14T01:25:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, be296b24-f9c4-405e-966e-b29c3aae9bd1, 'Un régal et facile à faire ! Merci pour cette recette ! ', '2014-03-15T14:51:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 9d984824-1083-4f8f-b6ed-5f7c282adcb2, 'Avec des fruits surgelés le mélange n''est pas très réussi.', '2013-10-23T06:53:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, be6d3aab-5c43-42e2-bf64-3ace4c4f8b8e, 'Délicieux, tout le monde a adoré ! Très bonne recette.', '2013-05-11T01:27:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 4911d619-3acc-4bb3-942e-30d0de3ac3c9, 'Super ! Mon mari a bien aimé par contre je n''ai pas mis de mangue car il est allergique !', '2013-03-26T16:24:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 678f2c10-5163-4195-839a-34343aa23bcf, 'Très bon mais pas avec cette recette de crumble. ', '2013-03-11T02:12:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, ff1a2374-3497-4702-a06d-ec7b8f8575ca, 'C''est juste à tomber par terre ! ', '2013-01-31T18:24:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 87abcd8e-bb90-460d-866b-b659a477a069, 'Très juste, j''ai juste mariné les fruits dans du sirop d''érable et ajouté dans la préparation de la pâte de l''extrait de vanille. Un pur délice !!!', '2012-11-17T20:39:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 34a4840a-133f-4902-bdcd-d3cd2c7ad4aa, 'Magnifique, depuis que je l''ai fait c''est devenu un classique !', '2012-09-06T03:45:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, fefa9fb2-5cce-4cdf-868a-78c55e444921, 'Je n''avais pas de mangues donc j''ai fais uniquement avec des fraises, c''est aussi bon. Le jus des fraises a caramélisé au four et le crumble bien doré, délicieux !', '2012-08-26T18:10:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, e42d4654-215e-44d5-a569-0761185c378b, 'Nous ne sommes pas fans de mangue alors c''est une très bonne idée de les utiliser de cette façon associée à la fraise c''est TOP avec un peu de coco râpée encore meilleur !! Merci ', '2012-06-05T13:32:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, c5597241-5c98-4f66-a507-92bb515f8b97, 'Bon dessert, j''avais suivis le conseil des avis en diminuant le beurre et c''est peut être à cause de ça qu''il n''y avait pas assez de crumble... Ma seule déception... à refaire avec plus de beurre pour que le désert soit plus généreux. Mis à part ça, le mélange fraises mangue est très agréable. Cela reste un très bon dessert. ', '2012-05-28T10:50:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, a028c005-54f8-4332-b583-927ed78140f9, 'Diminuer peut-être un peu le sucre. En le dégustant, je me suis dis qu''arroser les fruits d''un jus de citron vert pourrait relever davantage encore le goût.. à tester !', '2011-10-05T19:12:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, b3986cc2-01d5-4cba-b546-7a53677865cc, 'Excellent le parfum de la mangue avec la fraise est un vrai délice. Un peu trop de pâte à crumble à mon goût cependant. Je pense refaire cette recette également avec des fruits rouges un peu plus acide pour marier à la douceur de la mangue.', '2011-04-19T20:26:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 7aed25a0-0041-493d-9262-0e07d50e5f18, 'J''ai remplacé les fraises par des framboises et ce crumble était très bon. L''acidité des framboises et la douceur de la mangue sont un très bon mélange.', '2011-04-09T12:09:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 25030d6c-dedf-45a5-ae05-9bc82cf9012b, 'Recette simple et sans plus.', '2010-07-27T20:18:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 809a880d-823e-4288-8250-d2999fa573db, 'J''ai utilisé de la mangue surgelée et des brisures de framboises surgelées à défaut d''avoir des fraises. J''ai également doublé la quantité de beurre (100 g). C''était parfait !! Le seul hic: nous étions 8 et j''avais préparé 8 ramequins individuels... Mes invités se sont plaints de ne pas avoir pu en reprendre !! Merci pour la recette !', '2009-04-20T14:14:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, c65f75a6-85b8-473d-89ab-99693e643979, 'Dessert très facile et léger que vous pouvez varier suivant votre humeur. Je l''ai servi chaud.', '2008-05-04T15:34:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 1eab6a00-cea2-4cb3-b4e4-5a46b0319cb4, 'J''ai déjà fait ce crumble 2 fois, et c''est vraiment un régal! Et c''est tellement vite fait! Petites accommodations perso : pour la pâte j''ai utilisé 200 g farine, 200 g beurre, 250 g poudre d''amande. J''ai utilisé du beurre demi-sel.  J''ai fais revenir les fraises dans du beurre demi-sel. Du coup il ne faut vraiment pas oublier le sucre vanillé sur les fruits!!  Et pensez à rajouter la chair de 2 fruits de la passion bien mûrs dans les fruits, ça relève le goût et donne un parfum exotique au crumble!!!  Merci pour cette bonne recette!!', '2008-03-28T20:37:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 70641cd0-6b79-4f5b-a483-471dc191ed46, 'Très bonne recette, simple et facile à faire. Par contre, j''ai diminué par deux la dose de beurre. 50 g est largement suffisant pour faire la pâte sablée. J''ai d''ailleurs remplacé le beurre par de la margarine pour un plat plus léger.', '2008-03-20T21:59:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 0ceee21f-ca22-45e0-b54f-2559749d6945, 'C''est vraiment très bon, il faut juste ajouter un peu de sucre vanillé sur les fruits. Mon homme qui ne mange jamais de fruits à beaucoup aimé !', '2007-07-15T20:22:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 18b23372-4f60-47a2-aa42-8b9d6ed849c8, 'La fraise se marie bien avec la mangue et l''amande, ce crumble est agréable au goût. Le seul hic : il y a trop de beurre dans la pâte sableuse, 50 g suffisent amplement. J''ai essayé de remplacer le sucre vanillé par de l''amaretto, c''est très bon aussi.', '2007-06-10T00:10:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 54cc4865-8000-4670-957a-cd74d0273707, 'Super simple à faire et excellent. Cela donne un mélange de saveurs très original et délicieux. On a mangé tout le plat à deux et c''est parti super vite.', '2007-06-01T23:18:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 1868f5ce-4995-4536-861f-d84938d6edf7, 'Très bonne recette qui change des crumbles ordinaires. Prendre une mangue bien mûre de préférence et ne pas hésiter à laisser cuire un peu plus longtemps au four. Tiède, le crumble est très bon!!', '2007-05-20T22:26:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 71d812c0-522d-411f-b5e4-1bcf70f1dd60, 'Parfait ! Présentation impeccable et un vrai régal à la dégustation !', '2007-05-08T22:06:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, aed5a144-bcbb-494e-9ae1-24687b7f8f8f, 'C''était mon premier crumble et il a été très apprécié. Ma mangue n''était pas assez mûre mais heureusement que la fraisie avait réhaussé le goût. Merci pour cette recette.', '2006-05-22T02:16:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, 21469b42-9545-4e19-b588-2f3b0bb2d3b0, 'Très rapide à faire, très bon, je la referais souvent!', '2005-06-02T15:59:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36549, c10e3a95-63f5-472c-8aab-bfe6ec5d8446, 'L''association fraise-mangue est surprenante. J''ai bluffé ma belle-mère!!! Essayez la recette avec de la cassonade cuivrée (sucre de canne avec de la  réglisse, caramel et cannelle). A faire sans hésiter.', '2005-05-29T16:40:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37214, f16b91c9-e86b-4972-b857-028cd34a6189, 'Très bonne recette, toute simple, mais 200g de sucre (voire moins) suffisent largement. ', '2021-07-28T13:11:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37214, c5727ee2-2ef0-4f53-aad5-cb3befc41eb8, 'Délicieux avec les fraises du jardin. J''ai diminué la quantité de sucre et ajouté du jus de citron', '2016-06-27T22:16:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37214, 9a7ed89f-4cbf-4a9e-9a6c-15e926dca7e0, 'Divin! J''en ai fait une avec 500 g de pastèque, 1 cuillère à café de jus de citron en remplacement de la fraise et miam ! Même moi qui n''aime pas la pastèque je me suis régalée et mon mari m''en redemande!', '2015-07-13T16:34:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37214, 553fb98a-fd03-4edd-81cf-f5d330c4f661, 'Délicieux !', '2010-03-31T20:46:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37214, f1785232-740a-4c4c-b11e-956acee8eb9f, 'merci pour cette recette NATURELLE simple et super bonne.
je mets bien moins de sucre pour avoir plus le goût réel des fraises.
bien l''idée du citron.
', '2023-05-05T13:26:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37214, 44799b73-749a-4f3f-982a-0815d9e617fa, 'J''ai remplacé les fraises par des framboises et c''est tout aussi bon.
Bravo pour la recette !', '2018-06-21T08:21:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37214, 68629fe9-3dcc-40e0-b6dd-ad39a25e6d5e, 'Voulant finir mes fraises surgelées et pour une plus petite quantité histoire de tester, j''ai modifié les quantités: Environ 200g de fraises surgelées pour environ 120g de sucre en poudre, une cuillère à café de jus de citron et 150g de crème fraîche, le tout passé au blender. Ca m''a donné plus un sorbet qu''une crème glacée mais goût savoureux et frais!', '2015-09-20T22:36:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37214, 11eaaf9f-45b2-401b-998f-28aa61726231, 'Simple et délicieux, j''ai mis 250 g de fraises top niveau, une barquette de framboise, j''ai passé le coulis pour ôter les graines, et remixé avec 100 g de crème et 125 g de sucre glace. Puis en sorbetière, ça a pris très vite et ça vaut largement 5/5, bravo et merci.', '2012-07-15T18:52:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37214, 8f5abca8-dea5-4c36-ac46-c4526e43d5c2, 'Super... mais diminuer le sucre et gare aux calories !', '2011-05-17T19:17:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37214, 0d6543dc-a3ff-4e07-9e48-abcf489a19f1, 'Divin surtout avec du tofu soyeux. Testé avec la fraise, la framboise.  Je recommande moins de sucre et la cuillère à café de jus de citron. Merci pour cette divine recette !', '2010-07-02T17:47:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37214, 46338856-5ff7-467b-8738-c1a141c36a40, 'Il faut mettre un peu moins de sucre !!', '2008-04-14T15:49:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37214, 1ea9de60-ba8b-4ab7-ae8c-c5dfb35554c1, 'Simple et délicieux, surtout en rajoutant du citron... et je l''ai refait avec un mélange framboise/fraise, c''était aussi excellent!', '2008-02-04T19:36:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37214, 7819cb48-4083-4d2c-b260-1620382c3d78, 'Pour les allergiques à la crème : remplacer par du tofu soyeux (magasins diététique) Délicieux. + un peu de sel ou de citron.', '2005-06-20T15:35:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, a0e94a2e-c9e0-4d40-b49c-09758a313824, 'Le goût est exquis, la consistante est parfaite. J''ai mis légèrement moins de sucre et c''était nickel. Pour une glace bien prise, il faut laisser la préparation 12h au frigo avant de la passer à la sorbetière pendant 30 min.', '2012-07-12T22:36:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, a10760ff-de3c-40bd-b353-a460e48d6dbb, 'La glace de ma grand mère 😍', '2021-06-07T19:54:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 85a387c7-1b22-497a-8313-4048d9320716, 'Une TUERIE ! Un succès fulgurant ! À peine goûtée, il faut déjà que je la refasse ! Bref, j’ai trouvé ma recette parfaite, merci !', '2019-06-23T07:32:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, f3f13fdb-cb8b-4410-899d-325d73f25251, 'Excellente recette très riche en goût !', '2018-08-09T12:47:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, fe665606-2c4f-402e-82d7-9139a0680c33, 'Glace très parfumée. Il faut en profiter pendant la saison des fraises !', '2015-04-22T00:41:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 5212704d-c406-464b-b693-61e10a6d1dd9, 'J'' ai remplacé la crème par un yaourt grec et supprimé le blanc d''oeuf; le résultat est super ! Goût exquis, texture idéale, à refaire sans hésiter...', '2013-07-26T20:37:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, fb29340f-d515-49c4-973f-1365ebcedf51, 'Fantastique ! J''ai réalisé cette recette avec des fraises des bois. N''ayant pas de sorbetière, j''ai versé la préparation dans des verrines individuelles, que j''ai ensuite mis directement au congélateur. Je les ai sorties environ 20 min avant dégustation (le temps du repas), et j''ai décoré avec des petits cubes de fraises et des feuilles de menthe. Un régal ! Même mon mari, qui n''aime pas les glaces a accepté de goûter pour me faire plaisir et a adoré. Merci pour cette recette. ', '2011-05-31T18:15:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 42a43012-abbf-4a0e-873f-ad77b142534d, 'Glace facile à faire, en 1 heure avec sorbetière, et qui évite la crème anglaise classique.  J''ai utilisé du sirop de sucre tout prêt, avec de la crème fraîche épaisse et de bonnes fraises. Tout simple, pratique mais excellente.', '2009-08-10T21:22:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 95bd9578-5a2c-4b80-9ae2-5d526b6625de, 'Glace très bonne et pas trop compliquée a faire. Merci.', '2005-07-01T22:28:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, d90a31a5-d65d-4742-8bed-c768aa4021ed, 'Super recette, très gourmande et très facile à réaliser.', '2022-08-04T11:51:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 5b66a624-ab4c-4c90-b3f8-cc9f48249aee, 'C''est cool mais c''est un peu compliqué de la réalisée.', '2020-10-21T18:55:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, c0532d20-4842-4b4c-8100-a4e3217b4ce1, 'Ça a l''air très bon, j''essaie cette après-midi.', '2019-10-05T16:04:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 36b0673a-d192-4d83-8a61-e0f5b86b3f58, 'Excellente recette réalisée avec une sorbetière. J''essayerai avec un petit peu moins de sucre la fois prochaine. Je l''ai laissée 40 min dans la sorbetière.', '2019-06-11T10:58:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, f959bedd-91a2-4ee1-a720-26689e3bfabf, 'Une 2ème pour cette recette et c''est mon fils qui l''a réalisé cette fois-ci. Il l''adore et nous aussi !
Merci pour ce partage.', '2018-08-31T12:18:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 3ae30fe5-6dba-4289-b8cd-0a07ec318ab4, 'Très bonne ', '2017-04-13T23:21:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, a97f1f94-28ed-4254-b7d2-5f9a254ff40e, 'Excellente !', '2016-09-01T21:38:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 4b3171ef-e6c6-4344-af86-861b949efda8, 'Glace réalisée à la turbine. Vraiment très bonne. A refaire.', '2014-08-19T11:18:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 84212a8d-ddcb-4a60-9afd-a6fdd60e9b84, 'Parfait. J''adhère totalement. N''aimant pas jeter, j''ai battu le blanc d''oeuf et l''ai ajouté à la fin. ', '2014-01-08T19:26:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, c1814b4d-99d0-4208-aba5-a06ac8e79786, 'Le goût est parfait, le parfum aussi! mais elle n'' est pas du tout liée... dommage et je ne sais pas quoi faire pour qu''elle soit top ! ', '2013-10-22T23:39:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 71617f6a-a504-4929-8e22-95ccec460bd1, 'Parfait. Perso j''ai passé le jus de fraises au chinois et n''ai mis que quelques petits morceaux dedans. ', '2012-05-16T22:33:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, e378e12a-8c98-4f77-8f9f-cc7b6e53808f, 'Excellente, ma première glace à la fraise réussie. Ça change des glaces pleines de colorants, au moins celle-ci a un vrai goût de fraise, bien onctueuse comme il faut (j''ai pris de la crème entière). Mes invités ont adoré, j''en referai, c''est sûr.', '2011-07-26T17:55:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, b9a16ff4-572f-4ce3-95ab-0701608f140c, 'Rien à dire sur le goût, un régal ! Par contre c''est quasi impossible de faire des boules ? Ça ressemble à de la neige qui s''effrite, ça ne colle pas...', '2010-06-29T21:28:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 171a6ca5-49a4-4b56-8249-bd6f7cdc8446, 'Très facile à réaliser et excellent avec les fraises fraîchement cueillies. Un goût de fraises prononcé, une texture agréable. Je n''ai juste pas réussi à mélanger le blanc en neige à la préparation: il flottait dans une soupe de fraises... J''imagine que la sorbetière s''en est chargée car le résultat est excellent.', '2009-09-20T14:51:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 4a32d492-0930-4f98-a384-175d106f3c0e, 'Mes enfants adorent, c''est bien. Je leur met en batonnet, ça ne coule pas, c''est parfait.', '2009-06-15T14:48:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, fe10bddc-268c-4563-b531-e1d1525fb580, 'Cette glace est délicieuse et très facile à réaliser. A conseiller vivement !', '2009-06-15T12:24:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 2664e729-47ba-4610-ab80-605f91c79ff2, 'Super bonne, à la place de la crème j''ai mis du fromage blanc, peut-être que la prochaine fois je mettrais un peu moins de sucre.', '2009-06-02T18:12:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 17e92f24-c6fa-460e-81ae-4930d0f459c1, 'Cette glace est excellente. Mes enfants l''adorent en bâtonnets. A faire et à refaire. Dommage qu''il n''y ait pas de fraises toute l''année.', '2009-01-01T19:00:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 0e6cf40c-1b94-4414-a839-e69b51e9ec8f, 'Le goût de la glace est excellent (cela ressemble plutôt à un sorbet) mais j''ai obtenu une glace très dure et pleine de cristaux. Evidemment, c''est la première fois que j''utilisais une sorbetière... peut-être de la mauvaise manière? Je vais réessayer!', '2008-06-13T15:34:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 3e74b9f2-c037-4b3d-9454-15ef88092fa4, 'Facile, réalisée en turbine à glace, un délice : à recommander. ', '2008-04-05T15:17:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 27a3f134-8a0a-4657-b923-d4d71069c42c, 'Glace trop dure : Sortie du congélateur c''est normal. Il faut attendre 5 à 10 minutes et elle sera à la bonne consistance.', '2007-09-13T00:41:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, e4857fd2-0906-49cc-b05c-c80e11b57c6c, 'Je suis déçue de la consistance, elle est très dure ! Je pense qu''il faut mettre plus de crème. Par contre le goût et le parfum sont excellents !', '2007-06-05T16:08:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 054baa60-3ea6-4899-8e42-c1bb2e7449a6, 'Mes enfants se régalent. J''en ai fait 24 bâtonnets et ils adorent.', '2007-05-30T17:54:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 6ed607ea-0710-4161-b87a-35e9e0f41b20, 'Recette superbe, j''en ai épaté plus d''un! Un vrai régal dès la sortie du congélateur: pas de cristaux, crémeuse, pas trop calorique et on peut faire de belles boules. Bravo et merci.', '2006-05-03T11:24:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, fc437fb1-bd99-42e2-b77f-f53af74678e2, 'C''était délicieux, mon fils qui n''aime pas les fraises fraîches les a adorées en glace.', '2005-05-23T11:32:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29642, 66c72430-55dc-4b83-b69d-f9017adf5be3, 'Cette glace est délicieuse. On a l''impression de manger le fruit glacé. Réalisée sans sorbetière, elle était très bonne!', '2004-07-06T11:15:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59544, 79007ac5-d0e9-4a75-957b-92b6ed231967, 'Très bon, bien que je n''ai pas suivi la recette à la lettre. J''ai dilué le lait avec du lait de coco, et j''ai également ajouté du sucre vanillé dans le coulis des fraises.', '2010-09-23T16:35:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59544, a241f638-a307-4b24-a561-e7ec6a90608e, 'Personnellement je prépare un mélange lait/lait de coco (50/50) et je décore avec un peu de poudre de coco. Une touche d''exotisme en plus.', '2010-05-08T18:17:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59544, d7d8045c-51ad-4acb-ba6b-b131bcbae0fc, 'Délicieux ! Petites idées pour le rendre un peu plus léger: Diluer le lait avec un peu d''eau et y ajouter un blanc d''oeuf (ou du jus de pis chiche ! ) battu en neige... Et une petite feuille de menthe sur le dessus !', '2020-04-26T10:51:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59544, 251c083b-c516-4b2b-9abc-5f823fdc48fd, 'Très bon! Je l''ai fait avec un coulis de framboises et j''y ai ajouté un blanc d''oeuf battu en neige pour rendre la prépation plus mousseuse.', '2008-07-18T13:34:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59544, 4727a27e-b71a-43b0-83ec-d1712ff87ab7, 'Dessert excellent, léger, rafraichissant, et pouvant donner lieu à de multiples variantes quant au choix des fruits. On a adoré et déjà testé avec de la mangue, des bananes, de la canelle... Bravo!', '2007-09-17T00:14:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59544, 11dc5d43-5406-4bb1-acb1-24e0035f673c, 'Très bonne alliance de saveur. J''ai ajouté de la vanille dans le tapioca, c''est bon mais cela nuit à l''esthétique de la présentation (le tapioca devient beige). J''ai utilisé des fraises des bois (mara) pour le coulis : Encore plus original.', '2007-09-09T03:15:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, e4f6e874-9f44-407b-a565-8931ca98015b, 'J''ai flambé le pineau pour enlever l''alcool du coup petits et grands ont pu déguster. J''ai ajouté une banane pour épaissir un peu et j''ai mixé le tout. Servie avec boule de glace et chantilly... Dessert de fête !', '2019-05-30T15:59:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, af0659e2-f7af-42bf-a36c-c0f7c00fd093, 'Excellente recette pour varier des fraises à la crème fraîche et au sucre (excellentes également!). 2/3 de la quantité de fraises pour 3 personnes et une boule de glace vanille chacun : un dessert très frais, léger et surprenant. Réservé aux adultes !', '2014-05-05T00:03:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, 94dc131a-2233-49c5-b6d1-4e02f0ac4689, 'C''est délicieux ! Je l''ai faite avec du grenache, sans cannelle et avec du poivre 5 baies.', '2013-07-24T12:22:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, d69adf15-a57f-4913-a5bc-1bf1fc8acc56, 'Très bon, très simple. J''ai accompagné cette soupe d''une boule de glace vanille et j''ai servi le tout dans une verrine.', '2013-07-11T00:04:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, 61b24aae-9a85-44f5-a960-ab774fdd4c0d, 'Très bonne soupe bien rafraîchissante, j''ajouterai un peu + de sucre la prochaine fois.', '2013-07-02T20:48:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, 88fd26d5-92e0-4671-b4ff-e3b365bb90cf, 'C''est très bon mais j''ai mis beaucoup plus de pineau des Charentes pour couvrir toutes les fraises.', '2013-05-31T13:05:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, 1ad9cd3a-d6a3-4d2f-a4c7-8d694c3db684, 'C''est très frais et agréable, les notes de basilic et de menthe apportent un goût très subtil. J''ai remplacé le pineau part du muscat de Frontignan, c''est très bon aussi.', '2012-05-28T23:45:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, 111d5ff9-0c9c-4c46-b7f6-d8862cefe750, 'Un petit peu déçue, par le manque de goût du résultat : je réessayerai avec du Monbazillac plutôt que le Pineau des Charentes et en y ajoutant un jus de citron pour corser le goût...', '2011-05-06T18:58:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, ab65ccfc-3a07-4f86-becb-a9c8eef884e5, 'Je n''avais plus assez de pineau donc j''ai complété avec du soho et de l''eau... Un régal. Merci pour cette recette', '2010-04-11T23:44:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, ad9dc0b5-f5af-4750-9f39-da11aeb1656b, 'Délicieux et très frais, un super dessert tout en légèreté et en finesse. Les différents arômes se marient très bien (mais je n''ai pas mis de noix de muscade). Je l''ai servi avec des cannelés bordelais.  ', '2008-06-02T17:13:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, 2ca44f31-aba5-4197-8663-e65798567e11, 'Excellent, j''avais ni vanille, ni muscade alors j''ai remplacé par des baies roses (une dizaine), légèrement poivrées et sucrées c''était très joli et cela parfumait agréablement le plat. ', '2008-05-25T12:32:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, b8c14c58-d843-4454-912c-6d38e0bf2c5e, 'Un franc succès! tout le monde s''est resservi ! Avec un cake aux épices, c''est un régal, merci beaucoup !', '2007-05-29T15:14:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, 784fa6f6-7017-4801-ab97-1bf761696735, 'Bon, je l''ai faite avec du floc de Gascogne par manque de pineau des Charentes, et suite aux conseils avisés de mes amis de marmitons, mais je n''ai pas aimé l''accord avec la muscade.', '2007-05-22T17:56:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, 9f047cf4-aa9c-4e6d-aa46-67533056331a, 'Exquise, même quantité seulement avec 500g de fraises, sans basilic.', '2007-05-17T15:56:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, ac3f96e3-98ae-4708-a803-c73b4f9ee458, 'Dé-li-cieux! Même mon mari qui normalement n''aime pas l''alcool dans les desserts a adoré le petit goût subtil du sirop au Pineau... Je l''ai servi avec le cake moelleux au miel (recette sur marmiton.org) tiède et c''était parfait.', '2006-05-15T10:56:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, fd0b7ae2-2dd6-46cf-a4b7-c0fb5d3ea338, 'Recette rapide à réaliser, très rafraîchissante et originale. ', '2006-03-31T19:43:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, 07f15efd-6e18-4608-808f-9d2a8ff65ac2, 'Tout simplement délicieux! Je l''ai servie avec un cake à l''ancienne, nature, avec un verre de vin blanc.', '2004-05-28T10:49:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, 674d8fc5-da25-4c6e-b516-fa8c134de4ea, 'En débitant finement les fraises, servir bien frais avec le crumble à la rhubarbe. Accord parfait!', '2004-05-24T10:00:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, 18fe4910-3083-4c5a-b7ce-0083e1e4a268, 'Le repas était léger, alors j''ai servi une boule de bonne glace à la vanille avec.', '2004-04-26T11:49:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14464, 2240cfd0-b659-4dfc-9424-b320e788253b, 'Respecter les 3 heures de frigo. Parfait pour une fin de repas sous le parasol.', '2003-05-14T10:31:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 0d3e3280-6cbb-47c0-8b4a-4bbbbb43b91f, 'C’est quoi 1,5 levure? Cuillère ? Grammes? Sachet?', '2021-03-17T16:44:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, b2621358-c513-40b5-ba21-62a94a4ba6e7, 'Je rajoute un oeuf et je mets des raisins blonds trempés dans du rhum ou du cognac !', '2020-03-11T19:12:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 689afc65-119d-418c-8583-2e49b15fc940, 'Très bon. J’ai mis du pralin à la place des amandes et noisettes qui parfume le muffin. Par contre la prochaine fois je mettrai dans des moules à muffins car mes petits tas se sont écrasés à la cuisson.', '2020-01-31T06:22:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 7ca005fd-a7e9-4cf3-9108-f82f09d56d4c, 'Je mets un sachet de poudre à lever pour que les muffins lèvent bien, des noisettes en poudre, un sachet de sucre vanilliné et de la cannelle. Je mets la pâte dans des moules à muffins.', '2019-08-03T02:16:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, c354fba4-83bc-40aa-b874-375d3f7110d5, 'J’ai échangé 2 pommes avec 2 bananes, et j’ai remplacé le sucre par du miel et du sirop de dattes', '2023-08-16T16:05:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, d950abd5-ae48-4b82-b76e-a59b9f0be740, 'Excellente recette facile', '2023-04-04T11:06:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 49c7a4a4-aac1-409c-b95d-f31ee2b562e2, 'Recette suivie à la lettre, çà fait exactement 16 muffins très bons et bien moelleux, au top, je la garde, merci !', '2023-04-01T00:09:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, e692ba0e-1370-4cce-a8e1-bc8378282b93, 'Excellemment bon et moelleux dans des moules à muffins avec plus de pommes et sans noix et noisettes ', '2023-03-12T13:59:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, ac33cfc5-bb46-4f73-9b0c-393c5022f267, 'Excellente recette que j’ai légèrement modifiée en ne mettant que 125 g de farine de blé que j’ai complétés avec 50 g de farine de noisette, une pointe de sucre en moule et un pur délice. Je conserve !', '2022-11-20T17:31:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 580b6be1-ba8f-4aed-9ae1-149fc58b0a1a, 'Excellent ', '2022-04-12T21:25:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 07761b30-bb13-4f41-b025-b0b7cf36763d, 'C''était délicieux mais je m''attendais à d''autres saveurs au niveau du goût', '2022-03-28T11:36:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, ec0c0bb4-9f38-4f62-aa1c-2e4f1bea89a0, 'J’ai remplacé les noix et noisettes par des pépites de chocolat, c’est parfait ', '2021-11-28T20:02:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 58802e30-aca8-4532-b232-e7ac974c7ce7, 'Au top 😁', '2021-11-05T14:24:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 75fdda1e-a610-4d83-9afe-f9889a0e2918, 'J’ai rajouté du pralin en plus des pommes. Par contre au lieu d’une pâte pour 18 muffins j’en ai eu que 11. Quantité à doubler. Donc ', '2020-11-15T23:03:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 08f1ba2a-0729-450f-b769-79183b0d6873, 'Très bon, muffins moelleux ', '2020-11-09T22:03:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, ced786b7-0fc9-45b1-a924-5ade6056186f, 'Très facile à faire, la pomme apporte du léger et du moelleux, c''est top ! J''ai ajouté de la cannelle pour relever le goût.', '2019-01-13T02:05:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, f970c3f2-a15f-46b3-90ae-8e0acc515836, 'Très bon
 Ai mis de la cannelle et des raisins sec.
En utilisant des moules a muffin.
Bien goûtu !', '2018-10-06T05:59:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 4951545a-30d8-4f93-b7cd-9adaf894a9d1, 'Recette facile et rapide. 
J''ai fait revenir les pommes a la poêle avec du sucre vanille. Super !', '2018-04-03T07:51:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 4dd42103-ab24-41f5-b9dc-cb6e3fce2544, 'Super recette. Fait au robot momo. Mis des pépites de chocolat à la place fruits secs, en dernier avec les pommes. Petit coup de mixage en gardant des morceaux de pommes. Trop bon. Moelleux à souhait. ', '2018-03-25T05:00:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 9c5f4382-be5f-4f1c-92d9-888af0b68f33, 'Très bon !', '2017-10-27T23:13:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 888f56da-ac46-4f83-95d5-7f166f776032, 'Fait en remplaçant les fruits secs par de la poudre d''amande et en réduisant la quantité de farine comme il etait proposé dans un commentaire : très bon !', '2017-05-08T00:27:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, fd7b6726-d255-4141-8a70-5b22e3ac6ad2, 'Vraiment excellent, mon mari a adoré, merci ! Et simplissime à réaliser !', '2017-02-27T22:57:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 4330e8e6-8bf6-48d4-a204-9062978d8a25, 'J''ai suivi exactement la recette. Excellent !!', '2017-02-12T22:38:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 8b8e1f6a-acdc-45d1-8410-741ed184f05f, 'Excellent ! Je n''ai pas mis les fruits secs et malgré tout c''est très bon. Les pommes sont fondantes c''est un régal.  (utilisé un moule à muffins)', '2017-02-10T17:28:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, cd802e29-6068-4974-9f30-4be5da6b0c62, 'Très facile à réaliser. ', '2017-01-31T16:44:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, d6c2a067-8b5d-4159-a786-7d2da1e6f5f0, 'Pour ma part j''ai remplacé 50 g de farine par 50 g de poudre d''amandes ce qui m''a fait 125 g de farine et 50 g de poudre d''amandes, je n''ai pas mis d''autre fruit sec du coup ! Toute la famille s''est régalée merci pour cette bonne recette.', '2017-01-21T12:26:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 6a2c3926-68cf-4cf5-b026-7cba26151b9d, 'Très simple et accessible, une petite recette de goûter du dimanche sans prise de tête ! J''adore !', '2017-01-15T17:24:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 6c3aa7f9-1e35-4906-8042-878746b92e61, 'Super bon aussi avec des pommes, amandes concassées et pépites de chocolat.', '2017-01-11T16:17:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, a4dbf660-5a47-4024-981c-0c3a5c283039, 'Moi, j''ai essayé 12 minutes et c''était meilleur qu''avec 16 ou 17 minutes. Et si on ne met pas de moule pour les cuire ça reste tout plat comme des cookies.', '2016-10-30T21:04:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, f50beee8-b040-4a5b-87f5-fffd4f823a0f, 'Excellent et facile à faire.', '2016-10-07T15:28:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 1fb806af-190c-47ba-8c36-319d1199485a, 'Recette très agréable ! Faite avec pommes / cannelle puis pommes / amandes. Excellent !', '2016-07-31T22:19:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 74d064d6-80ac-43a3-95aa-9dbfb9275ec7, 'Déçue de la recette par rapport aux avis. Les muffins étaient assez secs, et j''ai essayé avec des noisettes, je ne vous conseille pas d''en mettre. ', '2016-05-30T01:39:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 7d466620-8cf5-40e5-a07f-795b00994ca8, 'Très bon!! J''ai remplacé les noix par de la poudre d''amandes.', '2016-05-26T15:40:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, bda09f09-1660-409f-b454-4a65b66095f7, 'Excellent je n''ai pas changé la recette j''ai juste ajouté des pépites de chocolat. Ils sont moelleux et pas sec. A refaire.', '2016-05-19T20:14:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 2dda84da-3f37-4ed2-bd30-454c24229ee4, 'Très bons ces petits muffins.  Conseil : mélanger le beurre fondu, les oeufs et le lait et ajouter à la farine, sucre et levure mélangés. Répartir dans des moules à muffins. Même temps de cuisson, gâteaux savoureux et moelleux. Suggestion : recette restée avec des noix (très bon), un mélange de baies séchées type raisins, goji ... (très bon), et des cacahuètes non salées (délicieux !).', '2016-04-25T18:27:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 0b1ec69d-fefe-4897-9c9f-a1189f8e086b, 'C''est toujours un délice de faire cette recette.', '2016-02-27T20:04:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 9674402f-1155-47df-a8d7-0a463d7f74f2, 'Je n''ai pas mis 5/5 car par principe rien n''est parfait, mais très bonne recette. J''ai tout mélangé en même temps: résultat nickel. J''ai ajusté les ingrédients car j''avais 3 pommes et j''ai mis du pralin à la place des noix/noisettes.. 200°C pendant 16 minutes et le résultat est parfait!', '2016-02-20T21:54:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, ad1711fc-8a5e-427a-86f9-f13ca8864558, 'Très bonne recette mais il manque un peu de sucre à mon goût... Je n''ai pas mis les amandes par contre.  ', '2016-02-14T23:22:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 866a8661-875d-4174-bcf8-418c1a2415ce, 'Très bonne recette, facile à faire ! J''ai ajouté de la cannelle et une cuillère à café de miel. Je n''avais pas de noix ou d''amandes. Le tout dans des petits moules... parfait !', '2016-02-03T18:07:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 323e0bac-9cb0-495f-9d8e-ba85714d39cf, 'Mis en petits ramequins, excellent aussi mais en ajoutant 5 minutes de cuisson.', '2016-01-29T20:46:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 6db33f78-dfb5-4650-997e-7df0c992533e, 'Super recette !!! J''ai ajouté 1 cuillère à soupe de miel et de la cannelle sans rien changer au reste de la recette, une réussite !! ', '2015-11-18T19:49:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, dab6dfdd-583a-4344-ab52-bceba1b0369f, 'Je l''ai faite dans un plat à cake en ajoutant 10 min de cuisson. Résultat super moelleux !!!', '2015-11-11T17:49:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 366fd93e-667a-4868-830a-ad53edf29624, 'Trop bon ! Tout a été respecté et j''ai mis la pâte dans une plaque avec des moules à muffins, super moelleux et au top !', '2015-11-04T21:57:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 0da7e4dd-4427-456e-9ec5-a8ee021522eb, 'Délicieuse recette. J''ai juste modifié à ma sauce (cassonade brune au lieu du sucre et des copeaux de chocolats sur le dessus) temps de cuisson impeccable. Je garde et referais. Merci', '2015-11-04T13:04:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 7f6ac34a-55fe-4d18-8486-5faa9a997639, 'Très bon et super simple ! Je conseille cette recette pour toutes celles qui sont pas très bonne en pâtisserie ;)', '2015-11-01T20:43:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, bc73836f-f321-4b90-9c34-efbd84447c1f, 'Délicieux. J''ai ajouté des raisins secs. Temps de cuisson parfait.', '2015-10-24T12:27:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 76499249-9c6c-4b9d-a9b5-275596b6f8ee, 'Trop bon ! J''ai juste mis des pommes ... prochaine fois j''essaye la même recette avec des pépites de chocolat.', '2015-10-21T17:31:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 09bc4b8f-6b68-45d5-a2ec-8464b0df3b33, 'Très bon et super moelleux tout le monde adore. J''ai mis un paquet de levure et plus de pommes. Mes copines m''ont demandé la recette pour leurs enfants.', '2015-10-20T21:13:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 9cf118ab-3a0b-4fe0-89cb-916931507232, 'Excellente recette, il a une vrai texture de muffins ! Hâte de le dériver avec d''autres fruits. ', '2015-10-20T01:00:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, aa613514-0ef4-44fc-badd-848ddcfc86cf, 'Très bon et simple à réaliser! c''est vrai que c''est dommage qu''on ne sente pas plus les pommes que ça! mais ça reste une très bonne recette. Je garde!', '2015-10-18T18:39:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, d5c7c877-2f8b-47a8-a92a-bd0ec4837479, 'Très bonne recette. Facile à réaliser et efficace !', '2015-10-01T15:53:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 5a556348-d8d4-4e03-9dcc-95a190edf398, 'Je mets un paquet de levure entier, sinon rien à redire, super facile à faire,  je varie la garniture, pommes cannelle noix, bananes pépites de chocolat, aujourd''hui j''ajoute des raisins secs. Temps de cuisson 15 min suffisant, ils restent moelleux plusieurs jours si on les conserve dans une boîte hermétique. ', '2015-07-12T11:55:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 29e61661-60de-4010-875b-2bb0e83293be, 'Très bon et facile à faire ! Recette incontournable de mes pique-niques et de mes goûters entre amis.', '2015-06-07T12:35:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, cd7662c9-f1a5-4754-8fba-b33ca17e3c8a, 'Super bons !!! J''ai fait moitié pommes moitié poires c''était succulent !!!', '2015-06-02T18:13:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 45a971e2-f4e9-4209-9ae8-4090cf46180d, 'J''ai ajouté une tasse de corn flakes écrasés, une cuillère à soupe de sirop d''érable et mis un glaçage avec une cuillère à café de salidou sur chaque muffin : un délice !', '2015-05-05T00:09:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 806b5d70-0616-4e60-ad3f-60b92d34bf4f, 'Mettre moins de sucre 70 g c''était trop. J''ai improvisé la cuisson, dans mon petit four le temps prévu n''était pas suffisant.  Résultat nickel, super bon et la pomme donne un effet moelleux et aéré. Un peu surprenant qu''il y ai plus de pomme que de pâte, mais ça cuit et passe bien :-D ', '2015-04-26T18:15:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 07548c00-0259-41a0-ba63-14090dcbc54a, 'Excellent, franc succès autour de moi.', '2015-04-18T11:18:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 8efd481e-1991-4beb-804d-356aac974ef1, 'Efficace... Bon et rapide à faire, que demandez de plus pour le goûter des enfants ou le petit gâteau qui va bien avec le café.', '2015-04-08T14:39:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, 1449a1e5-0586-409d-bc00-db862eab46e0, 'Trop bon et facile à faire ', '2015-03-26T12:41:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11582, eec85e47-4f26-4510-97a9-e0e91ae9c224, 'Pâte à muffins excellente, moelleux. Il manque juste à trouver un ingrédient qui rehausse le goût de la pomme ! ', '2015-03-05T09:40:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, 0737cb63-2de8-470a-bf17-37b3e2ebce3a, 'Très bon. Très bonne recette. Peut être à accompagner d''une boule de glace vanille ou de crème anglaise la prochaine fois.', '2017-03-19T08:29:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, b488701b-97c4-4cdf-9a98-2a546594addb, 'Tres bon', '2016-11-02T13:10:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, 78742f8a-3e55-4edd-ae81-37ef907d1848, 'Tout juste divin !! Mes invités ont failli lécher leur assiette ! Sinon je crois qu''en effet cette terrine manque de consistance : au vu des commentaires, j''ai ajouté un peu de gélatine alimentaire, mais je n''ai mis qu''une 1/2 feuille car je ne connais pas les proportions (et j''avais doublé les doses pour la terrine car nous étions 9...). J''ai aussi ajouté une fiche couche de meringues écrasées entre les framboises et le chocolat (je crois que j''avais lu ça dans un commentaire). En définitive, pour éviter les tracas de présentation et de tenue de la terrine, on pourrait je pense la transformer en... Verrines ! je vais essayer comme ça la prochaine fois. ', '2012-11-24T13:01:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, f8e6d8e9-464c-44dd-b1d9-c9fac758ec82, 'A servir aux amateurs de chocolat seulement et en petites quantités. En effet, il faut augmenter les doses, même pour un petit moule à cake il n''y en avait pas assez (rempli seulement à moitié).', '2011-04-27T11:59:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, 912b2a02-56d7-4820-a9c7-1c9c78d08b99, 'C''est délicieux !! Les proportions sont OK pour un petit moule à cake (contenance 1L). J''ai commencé au fond du moule par une couche de framboises, c''est plus joli quand on démoule ! merci pour cette très bonne recette !', '2010-03-23T11:47:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, 6d8f6e82-c57c-4136-9728-6c7fc702996e, 'Effectivement une bonne recette mais dont il faut doubler les proportions.', '2009-04-05T23:35:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, bad7dcd6-0d12-432e-9d86-6adf0cf27120, 'Délicieux malgré les quelques modifications apportées à la recette: j''ai remplacé les framboises par le double de fraises (les premières sur le marché) que j''ai cuites avec un peu de vinaigre balsamique... C''était encore meilleur le lendemain!!!', '2008-06-25T15:58:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, 81ee4e3c-e6fc-4e28-97db-3f299b4176f3, 'J''ai respecté les quantités sauf pour les framboises (j''ai doublé) et j''ai suivi le conseil de les décongeler dans le sucre puis de les égoutter. Gâteau excellent mais effectivement très chocolat à servir aux inconditionnels du chocolat!!', '2007-09-23T22:44:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, 56088483-7803-404d-9a14-bdbefc013990, 'Excellent! Les framboises donnent un peu de légèreté à ce dessert.', '2006-08-13T22:15:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, a3a5dd9c-cbab-4c89-b932-a489dcd39af3, 'Délicieusement bon, un vrai régal. Je n''avais pas de framboises, j''ai remplacé par des mûres. C''est aussi bon. Pour le jus des cuisson des fruits, je ne l''ai pas jeté mais fait bouillir un peu plus (15 min à peu près), cela fait une bonne sauce caramélisée que j''ai utilisée pour servir la terrine. Il est vrai que la quantité de fruit est assez juste mais ça ne dérange pas vraiment (peut-être ajouter 100 g). Sinon je conseille vivement cette recette formidablement appétissante. Je la referai sans aucun doute.', '2006-08-13T21:14:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, 1c9ee090-dba3-4157-a4da-6853c6c63efc, 'C''est délicieux, vraiment! J''ai fait aussi une variante avec quelques gouttes d''huile essentielle d''orange douce et des petits cubes d''orange confite à la place des framboises, cela a été très apprécié également.', '2006-07-05T16:01:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, 22b084a5-67f0-407b-b69c-78e06cff3059, 'Recette assez facile à réaliser...et très bonne! Mais attention à ne pas en abuser car les papilles saturent rapidement sur ce genre de dessert... mieux vaut donc prévoir de petites quantités !', '2006-06-01T01:09:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, 617af2ab-75b6-4a45-9803-27548a694046, 'Très bon! Les proportions sont pour 6 personnes. Dans un moule un cake de taille "normale" cela donne un gâteau un peu mince, ajouter 50% pour un résultat plus esthétique et faire deux couches de framboises. Fait avec des framboises congelées sans problème (prévoir le double de framboises encore congélées, laisser décongéler dans une terrine, ajouter le sucre et laisser mariner, bien égoutter).', '2006-05-31T19:43:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, c152ad19-e62d-47c8-92e2-29a6ef28556c, 'La recette est très longue et pas facile (ne vraiment pas faire bouillir le lait!)pour un résultat esthétique décevant: la terrine ne se tient pas du tout. Au niveau quantité, mon moule à cake était à peine rempli à la moitié! Le goût est bon mais je pense qu''il faut vraiment revoir les doses!', '2006-04-26T23:52:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, 7b49b345-91d0-461e-a98c-c64d2a2776c5, 'Essayer, c''est l''approuver!! Framboises et chocolat n''ont jamais fait aussi bon ménage! J''ai aussi rajouté des petits LU, écrasés entre la couche de framboise et le chocolat pour une petite note croustillante. Les invités se sont régalés, il ne restait plus rien dans les assiettes!', '2006-03-07T21:41:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, bedca0e9-5f1d-46da-8db1-a43541328667, 'Ma mère m''a fait la surprise de ce desert pour mon anniversaire. C''est un vrai régal! J''en redemande!! ', '2006-02-10T16:06:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34317, 49f8d754-e59d-403a-8f2a-bee8fdb141d3, 'Vraiment un délice, et en plus c''est super simple! Elle fait de l''effet, merci je la referai assurément!', '2006-01-14T18:35:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 701ea3e0-88a2-44cd-99ca-239f72bf2b8d, 'J''ai mis du beurre salé en place du beurre doux et remplacé la moitié du sucre blanc par de la cassonade. Mettre aussi la pate au réfrigérateur pendant 1h avant de l''inserer a four chaud pour garder tout le moelleux a coeur en fin de cuisson. Un must familial !!!', '2023-11-05T11:09:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 12b05ef3-2e48-48d8-8dea-503ab831aa31, 'Trop de sucre je meurs', '2024-02-22T21:35:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 8ba3476d-7a98-4cad-8d1e-4efac45397e6, 'Version modifiée parfaite !
125 g de sucre, 20 cl de lait et 45 min de cuisson à 150 °C.', '2022-02-18T11:13:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 8f6014bf-e643-4019-9a8d-bbfce2c28e24, 'Franchement super la recette mais au vu des commentaires j’ai changé les doses 
- 100g de beurre 
- 125g de sucre 
- 1 sachet de levure ( pour un gâteau bien gonflé) 
- 180 degrés pour 30 minutes 
Et le rendu et top, assez sucré, moelleux et très léger
Vous pouvez voir le résultat sur une des photos ( c’est un gâteau saupoudré de sucre glace avec une part coupé qui apparaît plus loin derrière en flou )', '2023-04-20T12:13:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 54213c57-31dc-4b52-821b-b8fd3f67d653, 'J’ai fait la recette pour 6 personnes, j’ai pu nourrir toute ma famille affamé du bled… En plus de ça, on a l’impression de mangé un moelleux au sucre… Si vous souhaitez le diabète, je vous recommande vachement cette recette.', '2023-06-14T16:17:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, e0371123-c589-4a9b-8708-2baaebc0f455, 'Très bon ! Pour cette 2ème fois j''ai suivi les conseils en commentaires, 200 ml de lait et 90 g de sucre. Nous l''avons trouvé meilleur, moins sec et moins sucré ! 👍', '2021-08-22T18:56:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, e62a6f4e-845a-4278-84f5-2d8053feed68, '125 gr pour le sucre, la farine et beurre plus facile à retenir pour refaire la recette 😉', '2021-08-22T15:20:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, fce90a3c-cb1d-4c04-9821-fcc97cf3d56c, 'C est un délice😍😍🤩🤩,juste j ai diminué la quantité de sucre à 125 g seulement, c du top du top. Merciii', '2023-07-24T19:33:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 5b9d5461-24f2-4a77-bb19-ec8cf1f7af17, 'Le gâteau est une réussite, mais beaucoup trop sucré ! La moitié suffirait largement. 
La durée de cuisson est suffisante sinon il ne serait pas assez cuit', '2022-05-05T21:39:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, bf6dce7a-edfc-46c4-99ef-9d42a1f1c780, 'Gâteau trop sucré!! Vouliez-vous qu’on attrape le diabète???? Je suis vraiment déçu, car c’était un gaspillage de temps et d’argent', '2022-03-21T01:28:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 8501e0f8-163e-4d12-ab14-cc66a172f310, 'Un delice, j’ai suivi les commentaires en ajoutant un verre de lait, mis seulement 100grs de beurre, 100 grs de sucre. Cuire 30 minutes a 165 degrés. 
Moelleux et savoureux! ', '2022-01-30T17:44:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, f7399ae3-eebc-4856-a8e9-82624cc0c680, 'Pour moi c''est la meilleure recette de moelleux, inratable. Néanmoins je vous conseille de réduire la quantité de sucre.', '2018-11-26T11:32:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, defbf29c-667e-4434-bc11-48cc47c858f6, 'Très bonne recette mais beaucoup trop de sucre. Je mets moitié moins et c''est très bon.', '2023-02-28T18:10:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 994bc7a0-d1c0-4b89-865e-73e049cc8e69, 'Très bon, mais pour ma part je n''ai mis que 125 g de sucre.', '2022-10-29T07:29:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, d54b0645-a6f9-45df-a8e9-04fabc8ac8a6, 'Vraiment pas bon, très mauvaise recette.', '2022-09-17T23:09:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 9a1b876d-1cdd-4c43-a787-960b187f5ae1, 'Très bonne recette. J’ai mis moitié moins de sucre (et je trouve que c’est encore trop sucré). Je n’ai pas monter les oeufs en neige et le gâteau est quand même monté. Super efficace et rapide à faire', '2021-11-08T00:23:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 24edded6-2e40-49b0-a631-7b13efcf4302, 'Jai ajoute 1 verre de lait et diminue le sucre a 125g
Cuisson a 150° pendant 45 minutes 
Et le resultat est top ! Gateau tres moelleux ', '2021-02-18T17:14:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 1fba8b10-56a7-41df-87b2-46b89ddecde6, 'Merci pour la recette. Nos invités ont adoré !! J''ai cependant suivi les conseils précédents et n''ai mis que 170 g de sucre au lieu de 250 g. Et bien sûr une pincée de sel dans le chocolat fondu (au bain marie) pour relever le goût ! Idem pour la cuisson, un tout petit peu moins que 30'', avec un papier d''alu au dessus les 10 dernières minutes pour éviter qu''il ne soit éventuellement trop cuit. Et saupoudré de sucre glace ... A refaire très prochainement !  : -D', '2019-03-30T00:47:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 1d1c53cf-8e83-4c37-8a33-2f17dad1bdcb, 'J''ai suivi les commentaires et j''ai mis 130grammes de sucre car 200grammes c''est beaucoup trop.Très bon je le fait tout le temps?', '2023-10-31T17:41:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 1e070971-e279-4d3a-8405-2b09da7da404, 'Trop bon', '2023-06-13T17:20:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 88df527f-361c-476e-9920-74d6fcba5e48, 'Top', '2023-06-11T10:06:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, bd676e07-8a34-4a2b-bf08-129679eb49ae, 'Merci pour cette recette, la meilleure selon moi. Je n’utilise qu’elle et tout le monde adore 
', '2023-05-26T15:15:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, ef9ba6fb-d39b-4e51-af6b-7e57ddcb65b2, 'Excellent mais la levure doit mieux préciser 
Mais très bon 
MERCIII MARMITON', '2023-04-15T22:35:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 5362397b-b521-4c87-ac37-764b5deaa4bb, 'Super moelleux au chocolat mais trop sucré à mon goût, la prochaine fois je mettrais moitié moins de sucre. Je recommande cette recette !', '2023-02-20T14:36:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 63ce2068-b1e7-4df6-b7a6-a63cd63544b4, 'Top
', '2023-02-16T16:57:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 06b276c5-a39e-4a6d-9966-dec3e73d6f81, 'Autre option: avec 70g de sucre glace et 60g de beurre, et ajouter une tasse à café de chocolat chaud Vanhouten avant incorporation des blancs: plus light!', '2023-01-22T22:06:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, ffab59cc-25d5-4af8-82f4-5d3df01bd433, 'J''adore cette recette mais même en aimant le sucre je trouve que c''est beaucoup trop sucré. Je trouve qu''avec 175 gr de sucre c''est largement suffisant.', '2023-01-13T16:48:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 70037531-6e6f-42cd-b6d8-8f38785510ea, 'Merci pour cette belle recette ', '2022-07-10T17:11:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 95edf554-0af9-4a1b-8cd8-6619776f59a8, 'Très très très sec ! Ajouter un demi verre de lait minimum dans la préparation sinon ce sera du béton !!!! Et il est vrai que moins de sucre et de beurre serait mieux quand même ', '2022-04-12T23:07:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, bf06bcbc-3771-48f7-b7ad-6947ad218bef, '250 grammes, c’est énormément trop, 180 g maxi pour les gourmands sinon très bon.', '2022-04-04T21:47:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 0030a518-7d80-4d77-b456-7e3ba67465b3, 'Bonne recette', '2022-02-24T14:02:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, bdacaf60-c3c5-4bc7-9bc5-b3c6ef5c8d19, 'Comme conseillé dans les commentaires précédents, j’ai ajouté 1 verre de lait et 150g de sucre étaient suffisants. Un délice ', '2021-04-09T17:44:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 82512ade-e8bb-4927-b29e-d4d49d32f3df, '125g de sucre, 20cl de lait et à 150° pdt 45 min, c''était parfait !!', '2021-03-23T18:36:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 1ae12659-76c3-4ce7-8323-beb6811c5fa5, 'Depuis que j''ai trouvé cette recette je ne fais que celle-là . Par contre 250g de sucre c''est beaucoup trop !! Je mets 90g de sucre vu que les tablettes de chocolats sont deja sucrées et c''est largement suffisant ! Pour le reste je suis à la lettre et il est super bon .', '2021-02-01T15:38:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 52e79441-3567-4588-a9cf-b5733d609058, 'Pour moi, c est "la recette" du moelleux au chocolat. Celle que faisait ma grand-mère.  Je la réalise régulièrement . La seule chose que je ne suis pas dans cette recette c''est le moment de mettre la farine. J''ajoute cette dernière après avoir battue mes jaunes d''œufs avec le sucre. La mettre après avoir ajouté le chocolat je ne trouve pas que ce soit l''idéal. Surtout si le chocolat est chaud, ça épaissi trop  l''appareil. ', '2020-11-30T03:44:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 6f2b27b2-1b6a-484b-b03d-e12df8ffb349, 'J''ai mis 150 g de sucre. Ça suffit.', '2020-03-24T12:30:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 209d28ea-b3a0-448b-afc4-a47d15f78888, 'Très bon en diminuant la quantité de sucre. Une fois le chocolat fondu, j''ajoute le beurre et un brin de menthe verte que je laisse infuser jusqu''à ce que le mélange refroidisse. Cela donne un goût subtil de menthe qui se marie très bien avec le chocolat.', '2019-07-07T15:00:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 859f1932-ad05-425c-bb2a-3ad6a97b1540, 'J''ai fait la recette tout a dégouliné partout car trop cuit sur le dessus et trop coulant donc revoir les cuissons qui ne sont pas bonnes.', '2019-06-15T13:24:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 6a59d655-5c0c-4b9b-9be9-22b7b7dde08d, 'Très bonne recette, j’ai tout de même fait le choix de diminuer la quantité de sucre ... La prochaine, j’essaierai de mettre moins de beurre ! Attention 20 minutes de cuisson suffisent (four à gaz). Aussi beau que bon !', '2019-04-07T13:54:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 367d7e6e-a94a-430e-a914-005bcb6d503a, 'Je l''ai réussi une fois sur trois, je ne comprends pas cette recette. Une fois, le gâteau monte très bien mais les autres fois pas du tout ...', '2019-02-15T10:28:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, dde0f059-373d-4d5c-aa00-e49cf53ed7c2, 'Très bonne recette et facile a faire !', '2018-05-16T10:19:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, bf24cd08-f057-411b-bb86-cd225103eb4e, 'Parfait !!!', '2014-05-23T01:37:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 17ce3aea-6134-46d6-ad4b-c877691f026c, 'Fait avec 170 g de sucre (je pense que la prochaine fois j''en mettrai 180 mais pas 250 !) Résultat extra moelleux et bien gonflé avec 1 sachet de levure chimique. Gâteau très très léger, il n''est pas écoeurant ni trop lourd. Juste parfait. Merci.', '2013-08-13T17:46:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 83dadc7a-c50f-4b69-972d-27737457f397, 'Ce gâteau est un régal !! Je le fais très régulièrement et c''est toujours un vrai succès !!! Je lui met 5/5 sans hésiter et ne comprend pas pourquoi certains écrivent dans leur commentaire "bof" ou "pas moelleux". Moelleux ne veut pas dire "fondant à coeur" ou "coulant", c''est un gâteau avec un "coeur léger", "vaporeux" c''est-à-dire que les oeufs en neige ne doivent surtout pas etre écrasés quand ils sont ajoutés au chocolat. Le résultat doit être un gâteau avec de petites alvéoles et non un gateau compact et trop lourd à manger !!!  Attention donc aux blancs montés en neige !!! A essayer les yeux fermés !!!     ', '2007-12-06T20:30:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 9fde5b5c-2dff-498b-bf73-a0ed92976786, 'Excellent, tout le monde a adoré ! J''ai fait un glaçage avec 1 tasse de sucre glace, 1 cuillère à soupe de chocolat en poudre et un bouchon de rhum pour diluer le tout.', '2025-09-22T22:13:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, c7ecc557-f4f4-4310-8ad2-cd944a137e33, 'Ce gâteau est facile à faire
 mais extrêmement mal expliqué quand tu es pas un expert de la cuisine chaque étape est une épreuve, je vous le déconseille ', '2023-10-24T18:28:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 4f5134a2-6310-4228-a0bf-49a62d7b0252, 'Ce gâteau était vraiment très bon mais je conseille de mettre en accompagnement quelques fruit ou boule de glace ', '2023-10-16T17:02:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 99e114e7-6955-438d-919c-ea2828b732b0, 'J''ai mis 70gr de sucre Stévia, et diminué de 10mn la cuisson.
C''était très bon.', '2023-03-26T14:40:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 0411053b-7960-4787-ae9c-552fd6e0507c, 'Ce gâteau était super bon et super beau .
Mais un peu trop sucré. ', '2023-03-25T18:10:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 6b6efdb3-7664-47c4-a1f3-34fb6394d046, 'Bonne recette 👍
', '2023-03-11T20:37:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 647348a6-c1ba-480a-ac16-7bf82d692420, 'Un délice et facile à faire ', '2023-03-09T12:22:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, b5c19909-e438-4dc5-9ec9-c689d19d5537, 'Superbe recette je l’utilise beaucoup et elle ne m’a jamais déçu. Je recommande 👌😁', '2023-02-25T13:46:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, c8bffb2d-dff4-471b-8274-023b6a3443ba, 'Trop beau !', '2022-12-28T16:40:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, edaf783f-2d68-4a61-a40b-cf7b80b11ec4, 'Très bonne recette.', '2022-12-06T11:02:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 86cdaf1c-18f5-4355-b064-5c9ca3476eff, 'Très bon, je l''ai fait à 2 reprises en une quantité et un moule différent mais le temps de cuisson reste un peu long. Plutôt 15/20min.', '2022-12-05T18:47:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 2a0a8236-d95a-421c-9894-54c3b4ced615, 'Le gâteau ne cuit pas à l''intérieur, c''est sensée être un moelleux, et non un fondant ', '2022-12-04T08:42:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, f6720437-8a69-401c-bb85-3a64d91f23c8, 'Très simple à faire pour les débutants !', '2022-10-24T10:24:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 6c58272e-90fb-4b21-9328-1ac04bbb27a2, 'J''adore ', '2022-10-23T19:50:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, d7fd7ed2-9892-40f1-a8aa-31518b221fde, 'Je l''ai essayée plusieurs fois, et j''ai constaté qu''il faut peut-être réduire le temps de cuisson à 25/30 mn pour un vrai moelleux pas trop sec...', '2022-04-28T10:05:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, df7d5cef-233b-4f4a-a306-c60970df45d5, 'Au top', '2022-02-23T16:20:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 28157436-d283-40df-9048-ddd8b39154b2, 'Première bûche pour moi. Je ne suis pas fan de la crème au beurre alors cette recette me convient parfaitement. Réalisée avec du chocolat 70% et j''ai mis plus de framboise que le préconise la recette.', '2018-01-05T11:46:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 441588fa-3cf3-4481-8b6e-732b781d94d2, 'La famille a bien aimé cette bûche faite pour Noël. Juste deux remarques: le sirop n''a pas rajouté grand chose sinon une note sucrée (car la ganache même l''est (trop?) peu), et il m''est resté presque la moitié de ganache....', '2015-12-25T20:14:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, f252082b-76b5-4858-8c6e-c06660b1219d, 'Parfait et excellent !!!! J''ai juste mis un peu plus de framboises et un poil moins de chocolat. C''est la meilleure bûche que j''ai faite : je n''ai pas mis de sirop comme indiqué mais un peu de rhum directement sur la génoise avec un peu de sirop de sucre de cannes. La bûche est légère, pas du tout bourrative : on pourrait la manger entière d''un coup ! Super ce petit goût acidulé des framboises mélangées au chocolat. Mon chéri a regretté le côté craquant de la framboise, mais en a quand même mangé 2 fois !!! A faire et à refaire, et à consommer sans modération !', '2009-12-10T12:55:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, efde6c5f-e977-4e6c-9adb-1469d69532e7, 'Très bonne recette. J''avais peur qu''elle soit écoeurante mais ça n''a par du tout été le cas ! Pour ma part, j''ai fait attention à mettre un torchon humide sur la pâte dès que je l''ai sortie du four. J''ai également rajouté plus de framboises avec le chocolat, et j''en ai mis des entières juste avant d''enrouler la bûche. J''ai dû en mettre environ 400g en tout, et ce n''était pas trop, loin de là ! Quant au sirop, vu que j''avais peur que la bûche soit trop sucrée, j''en ai à peine mis et ça n''a pas du tout manqué. La bûche était excellente et a plu à des personnes aux goûts très variés. A refaire !', '2020-12-27T16:56:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, b913d9c7-5669-4af1-b203-90af0c3a39c0, 'Superbe recette, la seule chose que je rajouterais, c''est qu''il faut mieux préparer le chocolat avant afin de bien le faire refroidir et qu''il devienne un peu moins liquide.', '2018-01-19T19:53:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 421efd29-f91f-46b2-aeac-15e2e6509ea1, 'J''ai beaucoup aimé cette recette et mes convives se sont régalé ! Mais malgré ça je trouve que la bûche est vraiment un peu trop lourde et chocolatée je pense qu''à la place de la ganache chocolat à l''intérieur il faudrait juste mettre de la confiture framboise pour alléger mais merci quand même !', '2014-12-26T22:36:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 1eb866f1-527d-49a0-8480-d05d4dac3a5e, 'J''ai fait la pâte à ma manière habituelle : séparer le blanc des œufs, le battre en neige, incorporer le tout, faire cuire à 200° 8mn, nous avons bien aimé le mélange chocolat framboises.', '2014-01-03T11:24:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 5997e7db-f0d6-4e36-9936-ecc10b91cc65, 'Cela fait des années que je la fais et tout le monde en redemande !!! Surtout ma fille pour qui je fais cette recette sous forme de gâteau traditionnel rectangulaire pour ses anniversaires. Très facile et excellente si on aime le chocolat !!! Par contre je mets beaucoup plus de framboises, je ne pèse pas toujours mais je dois presque doubler la quantité pour que le goût de la framboise ressorte bien.', '2012-12-23T17:28:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, c8884bce-26b9-4644-b572-0445b72fb09f, 'Ah, ma première buche. j''étais très fière. J''ai eu un peu de mal avec la génoise que j''aurais dû cuire un peu plus mais pour rattraper le coup j''ai roulé la bûche bien serrée dans du cellophane et j''ai laissé 3h au frais, du coup, elle était très belle une fois libérée. La prochaine fois je teste avec de la pralinoise !!!', '2011-12-31T09:14:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 4987f5aa-ce57-4554-bd93-1a266c9f6ea6, 'Excellente recette que j''ai testé pour Nouvel An ! Recette suivi quasi à la lettre, excepté pour le démoulage et le sirop. J''ai démoulé mon biscuit bûche sur un linge humide dès la sortie du four, puis enroulé dans mon linge. Je l''ai ensuite laissé refroidir. Une fois refroidi, j''ai déroulé mon biscuit que j''ai imbibé avec un sirop fait avec du sucre et de l''eau, mais j''ai remplacé la vanille par le jus d''une orange. J''ai appliqué le sirop avec un pinceau, puis garni ma bûche. Il m''est resté beaucoup de garniture, je pense que 200 g de chocolat, 10 cl de crème, 300 g de framboise et 30 g de beurre auraient suffi. Je la referai sans un hésitation, un délice !', '2011-01-01T19:42:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 49a0cf34-f08e-4555-a3e8-dd5f4e90b1f1, 'Magnifique !!!! Pas de soucis pour rouler la génoise - Par contre, j''ai mis de la confiture de framboise à l''intérieur et j''ai enrobé la bûche de ganache au chocolat - J''ai mis 4 petites roues en chocolat avec des smarties et des vermicelles aux chocolat noir/blanc - Ce qui m''a donné un superbe train d''anniversaire pour mon fils de 5 ans ! Excellent ! Merci', '2010-11-27T22:18:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, d81186c2-7450-4037-be7e-6e79fa91853f, 'J''ai fait la répétition de mon repas de Noël et cette bûche sublime en sera l''apothéose ! J''ai suivi la recette à la lettre sauf pour le sirop (j''ai fait un sirop à l''orange avec de la liqueur au litchi, le mélange est très subtil et les différentes saveurs s''accordent harmonieusement. J''ai glissé quelques framboises entières avant de rouler. Un conseil : laisser bien prendre la ganache au frigidaire avant de monter la bûche ! Un grand merci et joyeux Noël !!!  ', '2009-12-10T21:02:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 43e38bdb-22db-4a93-8446-89eaa5a671f4, 'Faire la génoise assez fine pour la rouler plus facilement, la mienne était trop épaisse est ses cassé quand j’ai voulu la rouler. La ganache dessus rattrape bien les imperfections, et elle est très bonne 👍🏻', '2022-12-30T15:23:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, c18c9b52-c652-430d-94ef-635e3f9318e7, 'Très bonne bûche, on s''est régalés', '2022-01-02T06:31:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 9885dbfa-b1da-4d83-8f01-33220dc9c790, 'J’ai réalisé cette bûche pour Noël, on s’est régalés ! ? pour ma part j’ai diminué les quantités de sucre et aussi la quantité de beurre, j’ai mis plus de framboises dans la ganache et je ne les ai pas totalement laissé fondre dans la crème afin d’avoir des morceaux, c’était juste trop bon ! Je n’hésiterai pas à la refaire l’an prochain ?', '2019-12-27T02:56:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, ca8dad97-ab47-4935-95ea-1d184aa0d4f2, 'Bûche réalisée avec la même base des ingrédients. Dessus pralines roses pour la déco. Très bonne.', '2019-11-30T19:23:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, fb8b02d7-409f-4c54-9723-a081f3512e93, 'Très bonne recette mais un peu trop de ganache j''aurais presque pu faire 2 buche j''ai aussi essayé sans les framboises et le résultat est aussi bon !', '2016-12-27T23:15:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 3558a8a7-f07e-4750-bdd6-b117999870ba, 'J''ai ajouté un peu de framboise dans la ganache pour que ce soit un peu moins amer avec le chocolat. Attention à ne pas faire une génoise trop épaisse. Merci pour cette recette.', '2015-12-26T19:10:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 91f5684c-025c-4b29-bdcc-cf32f816aa56, 'Je n''ai rien changé à la recette. Très bonne mais copieuse pour une fin de repas de fête. ', '2015-01-05T08:31:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 6023fdd2-8638-40cc-993d-facdcde2eb2f, 'Je viens de terminer cette recette ; le sirop est impossible à refroidir, comme indiqué ; il cristallise immédiatement et devient inutilisable. J''ai du abandonner et j''ai fait sans. La génoise casse au moment du roulage, elle n''est pas assez souple. La ganache réservée me semble bien trop liquide pour napper et recouvrir l''ensemble, j''attendrai le dernier moment...J''ignore si gustativement cela tiendra la route, pour l''instant je suis assez déçue...', '2014-12-24T12:29:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 6613b457-8378-4b00-ac3c-be0dceac6bdd, 'Excellent : mes convives se sont régales et n''en ont laissé aucune miette. De plus la recette est très bien expliquée et facile à réaliser. J''ai cependant ajouté quelques framboise congélées entières après avoir étalé la ganache sur la génoise.', '2014-01-04T16:36:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 87b60930-2ea0-46e9-bdc0-9b37da51d3c1, 'Très très bonne recette !', '2011-12-19T20:57:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, e1ad2008-8267-4062-9b6c-a2079ebc67d8, 'Désolée mais moi j''ai été déçue par le mélange chocolat noir-framboise. Malgré tout, la recette est originale. Une question : à quoi ça sert de faire autant de sirop ? J''en ai jeté plus de la moitié !', '2010-12-28T15:26:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 6e285204-9de1-440a-8da4-ed7fade50844, 'Très appréciée de toute la famille pour le repas de Noël; à consommer bien frais avec coulis de framboise ou crème anglaise.', '2010-12-27T11:53:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, f8e59281-bd2f-4e21-8273-5a8400f09bd7, 'La ganache chocolat/framboise est délicieuse, cependant il manque un petit quelquechose pour adoucir l''ensemble. ', '2010-12-26T23:28:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, a4da66fd-0500-44fc-a9eb-afbdaddf764f, 'Super, très facile à faire pour un bon résultat. Un petit peu trop sucré pour moi, mais nos invités ont adoré... donc ca dépend des goûts.', '2010-12-26T15:57:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 4fc0f6f5-ae3d-46a5-9117-b1576242a1f1, 'J''ai testé cette bûche pour Noël, proportion impeccable, goût délicieux; réalisation aisée avec des explications rigoureuses, première bûche : réussite. Merci', '2010-12-25T23:04:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, f7ad6459-72c7-4d46-9b21-7e282fa9b329, 'Cette recette est facile à réaliser. Question goût, la framboise donne un petit goût sure au chocolat, pas apprécié de tout le monde... La génoise est un peu plus dure que celle d''autres recettes que je connais (malgré le sirop, d''ailleurs qui est difficile à  faire imprégner). Voilà, bon mais...', '2010-12-25T14:26:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 3b77289b-e2fe-4c48-b85f-21e4478e128b, 'Je viens de la terminer, elle est juste sublime et le chocolat était vraiment très très bon...je suis sûre de faire sensation avec ça !!', '2010-12-24T18:54:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 9bab639a-129f-4ac4-aa36-89477d9d7312, 'La génoise s''est cassée lorsque j''ai voulu rouler la bûche.', '2010-12-18T11:48:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 2c925b90-a0e3-4ae7-9caa-a53b6c459ad2, 'Miam ! Cette bûche est excellente. La ganache aux framboise est un spectacle ! On voudrait que ce soit Noël plusieurs fois par an !', '2010-05-08T16:25:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 4a9db187-ba66-4aa0-a017-e4bd086c684f, 'Cette bûche est délicieuse, pas trop de problèmes pour la rouler si on s''aide du papier cuisson la prochaine fois j''ajouterai de l''alcool pour la parfumer, et je servirai avec un petit coulis de framboise.', '2007-12-29T09:23:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 5bf7fa6c-1475-4b46-b586-a30365bf020d, 'J''ai été déçue après avoir lu les commentaires... Bûche un peu sèche et pas facile à faire (enroulage à faire à chaud et un conseil: rouler jusqu''au bout, quoi qu''il arrive!).', '2007-01-03T14:09:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 497a2c08-b0b1-4361-a895-f2392e7cf91b, 'Fabuleux! Un bonheur pour les papilles des grands et des petits. Pour rouler le biscuit, je mouille et essore mon torchon, puis je le parsème de sucre avant de poser la génoise dessus. Merci de cette recette qu''on va refaire à coup sur !', '2006-12-31T01:33:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 758b92a8-b197-418b-8f1f-b98024575044, 'Très bonne recette, merci. En plus, très facile à faire et tout aussi rapide à réaliser. La bûche n''est pas écoeurante et on sent bien la framboise. Accompagné d''un petit coulis réalisé avec les framboises en rabe et c''est le top.', '2006-12-27T13:36:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, d8d49591-63e1-4c4f-bbfa-b130caba6a1d, 'Très bon mais je suis de l''avis de Mathieu, il faut laisser la ganache refroidir voir devenir compacte car si non ça coule de partout.', '2006-12-27T12:53:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, cea6aab4-f64d-4fd6-9f15-841bfcdffb0d, 'Cette bûche est effectivement très facile à réaliser. J''ai utilisé 300 g de framboises au lieu des 150 g indiqués dans la recette. Le résultat était pas mal mais la bûche était néanmoins assez lourde et sèche. L''astuce c''est de l''arroser avec un petit peu d''alcool de framboises.', '2006-12-26T15:42:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 071ed751-1780-4161-8e52-6303fefd6476, 'Génoise très réussie, facilement, sirop ok, goût framboise sympa. Par contre, la ganache était lourde, proche du chocolat fondu. ', '2006-12-25T15:36:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, c5771cd9-1342-43d3-b4c5-56f0a402d925, 'Archi facile! Cependant quelques conseils pour ceux qui se laisseraient tenter par cette recette : remplacer le fromage blanc par du yaourt à la grecque (moins acide), rouler la génoise dès la sortie du four (n''hésitez pas à bien imbiber de sirop) et laisser la ganache refroidir et devenir compacte avant de l''étaler sur la génoise. Servir avec une crème anglaise ou un coulis de fruit rouge, c''est parfait!', '2006-12-13T20:30:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 8c94936f-e055-4209-b17f-0a2a44742ef9, 'Excellent! J''ai mis plus de framboises et de la crème allégée. Résultat : c''est un régal, très fin et digeste!', '2006-12-10T23:05:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 2f49c8fa-774a-4f35-9e22-6d6e23abb9be, 'Lorsque je roule le biscuit pour former la bûche, la pâte craque et ne s''enroule pas bien. Comment faire, ai-je trop cuit la pâte?', '2006-12-02T18:50:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 341cc649-3fe6-48b1-90e6-205498add736, 'Délicieuse! J''ai respecté la recette, les proportions sont parfaites. Le mélange chocolat-framboise est un régal, et surtout elle n''est pas lourde ce qui est appréciable après un repas déjà copieux! Un petit truc: je roule la génoise dans un torchon humide dès la sortie du four, et je laisse refroidir. Ca assouplit la génoise ensuite elle est plus facile à rouler une fois garnie de ganache!', '2006-01-07T11:55:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 186d5ecf-b2de-4407-9517-c62bb1085436, 'Très bonne recette, merci! Je l''ai faite pour Noël, servie avec un coulis de framboises et tout le monde à aimer. Elle passe facilement, le chocolat ne fait pas lourd. ', '2005-12-28T21:03:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 2eba7d41-32cb-4052-b846-68a0eb3cfba1, 'Excellent. Comme j''adore les framboises, j''en avais ajouté une couche dans le gâteau (je ne l''avais pas fait sous forme de roulé mais avais simplement coupé la génoise en deux). Le mariage du chocolat et des framboises est vraiment extra.', '2005-12-23T15:31:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, cd4e39f7-fa07-4c06-9552-a894e2be380d, 'C''est une copine qui l''a faite pour le réveillon de nouvel an. DÉLICIEUX, tout le monde a adoré. Perso, je doublerai la dose de framboise la prochaine fois car j''adore cela !', '2005-01-11T13:22:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 781bf0b9-1e5a-433d-9446-eb37e7b873d6, 'Très très bonne, facile à faire qui plus est !  Je vous conseille de ne pas faire un sirop trop peu liquide, si c''est le cas, le bûche risque d''être un peu sèche...', '2005-01-03T12:59:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 7a5a52a1-f18e-49c5-aa35-43bf647e445e, '5/5 Mon ami n''aime pas du tout le chocolat, et là c''est vrai qu''à noël on a tous adoré cette bûche, résultat je refais la même au nouvel an. J''ai doublé le nombre de framboises et pour celle du nouvel an, j''ai rajouté des noix concassées par mon chéri lui-même....', '2004-12-31T19:56:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 867a1110-5920-4ee7-967f-8e94b27c3189, 'Une bûche très appréciée pour le réveillon de Noël. Faute de framboises fraîches, j''ai utilisé des framboises surgelées et j''ai utilisé le jus pour faire le sirop... Merci pour cette recette...', '2004-12-27T03:41:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 01277ee6-b3bd-4396-a268-25b7ee6c170e, 'Délicieuse recette et assez facile à réaliser !  Rien à redire, tout était parfait !  Pour ne pas avoir de difficulté avec le biscuit, dès sa sortie du four, je le roule dans une serviette mouillée.', '2004-12-23T17:01:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20303, 5cd88733-020a-4d18-befc-4492e92cbbb6, 'Une bûche exquise pour ceux qui apprécient sans plus le chocolat et raffolent des framboises. A première vue, cette bûche paraît n''être qu''au chocolat, mais elle ne sent en réalité que la framboise. Une bûche aux fruits parfaite, à ne pas manquer!', '2003-12-28T11:42:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, 4b4da631-af01-4720-9cd2-f419a730674f, 'super!!!!!!!!!!!!!!!!', '2023-06-04T11:19:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, 39a4bdb9-41de-4d00-9f6d-88bc7685d6cb, 'Excellent👌très rafraîchissant pour une période de canicule ☀️', '2022-07-19T18:47:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, 5e026383-dd0f-4207-936b-bc10525542fc, 'Parfaitement parfait ! ', '2021-07-24T18:28:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, 7669aebf-14c5-4072-b102-009b731f6f14, 'Excellent.👌 👍🙂💯🙏', '2021-06-16T16:58:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, 3d865270-eeba-4f70-9f7c-736342a5cb44, 'C''est super bon mais il faudrait plus de fruits ou moins de fromage blanc, bravo !', '2020-08-24T16:13:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, d415cd2f-77f3-43eb-928b-d160e9a3d9e9, 'Excellent ! Le mélange est délicieux ! Je n''avais pas de fromage blanc, j''ai donc mis deux yaourts natures. Le résultat n''en était pas moins satisfaisant. Ma famille a adoré !', '2019-09-05T08:01:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, 3a0526b0-11be-4689-a974-fdd94d3522b2, 'Très très bon, super mélange !', '2017-02-22T16:52:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, 6cc0c13f-ed58-4e7d-9dd3-15072c9130a1, 'Trop bonnnnnn ! J''adore le mélange banane fraise ', '2016-04-07T19:18:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, f77fd5f2-6b50-4938-9a4c-984ea5ed1107, 'Woaw excellent ! J''ai ajouté des framboises c''était top. ', '2016-03-31T02:35:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80171, fbbd83af-7348-45cb-9b6c-ad0e55e4cf19, 'Super, j''adore les bananes et les fraises. Conclusion : ce mélange est délicieux.', '2011-05-28T14:02:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 293b9f18-315b-4e98-ba87-bcd155e3e959, 'Recette excellente ! C’est la troisième fois que j’essaye d’en faire et c’est la première fois qu’ils sont réussis. J’ai laissé croûter les macarons 1 heure à l’air libre et j’ai fait cuire pendant 12 minutes à 150°C en ouvrant la porte du four toutes les 3 minutes (j’ai suivi un commentaire) ', '2021-08-22T20:52:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 7c57c4d5-b791-497c-8fa4-aa98c22deb6c, 'Première fois que j''ai réussi des macarons ! Pourtant j''avais essayé beaucoup de recettes auparavant... C''était un régal ! Toute la famille a adoré ! Juste j''ai laissé croûter les coques avant de les enfourner et pendant la cuisson j''ai ouvert la porte du four toutes les 3mins pour laisser l''humidité s''échapper. Résultat ? Des coques ultra lisse et brillante et une magnifique collerette digne des macarons achetés en pâtisserie ! Cette recette est devenu ma base pour les coques ! ?', '2020-05-05T17:00:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 6f30349e-48d9-44af-b520-a6e4fd6b8b01, 'Mes macarons sont au top , je change seulement une chose sur la recette. Je ne met pas de sucre semoule je le remplace par du sucre glace. Et ils sont parfait comme vous pouvez le voir. Bonne soirée !', '2018-02-08T22:56:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 98e99896-015b-4323-ac08-57aa8dd92c96, 'Excellente recette mais pensez à laisser durcir les macarons à l''air libre avant d''enfourner pour éviter qu''ils ne se cassent. Il faudrait aussi un peu plus de garniture. Mais très bien dans l''ensemble. ', '2022-02-10T19:55:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, a4270a5c-0f7d-4f87-8bbf-fa960e67ca5b, 'Un délice ! Très bonne recette (juste peut être cuire moins longtemps, les miens ont craqué) j''ai aussi remplacé le sucre semoule par du glace !', '2018-10-19T00:33:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 4f7c19a5-4530-4bff-9d80-8fd8be2398d0, 'J''ai juste du rajouter du temps de cuisson. Petits conseils: Tamiser le sucre glace et les amandes en poudres. Et laisser crouter les macarons pendant une heure avant de les enfourner.', '2017-09-17T17:36:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 146b89b8-ff7d-4edc-89c1-6207e20b9bad, 'J''ai essayé plusieurs recettes et j''ai laissé tomber facilement car les coques ne tenaient pas or là elles sont très bien et la cuisson est idéale. J''ai fait des macarons tout chocolat et je n''ai pas grand chose à dire à part qu''il est nécessaire de tamiser le sucre glace et la poudre d''amande pour avoir des coques lisses. Je recommande également la recette. ', '2017-05-30T01:47:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, e391b005-5be7-4fb8-99d1-936040c910d0, 'Premier essai de macarons, les coques étaient parfaitement réussies! Petite astuce, une fois vos coques formées à la douille, laissez reposer 15 à 30 min sur la plaque avant d''enfourner pour avoir une belle collerette! À vos marques, prêts, pâtissez!', '2017-05-03T13:49:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 693cfdd9-bffb-4c9c-9850-6197fbc36e0b, 'Un énorme merci pour cette délicieuse recette ! J''avais déjà essayé une fois avec une autre recette et catastrophe. Mais là, une totale réussite !! Par contre je n''ai pas tamisé la poudre d''amande, je l''ai mélangée avec le sucre glace et j''ai mixé l''ensemble. J''ai également laissé "croûter" environ 30 minutes avant la cuisson. J''ai eu les félicitations de ma famille. A refaire sans hésiter !!', '2017-04-12T22:53:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 47ef5254-014f-445d-a43e-afb4ebdda4e0, 'Trop bon !!! Mais trop sucré à mon goût.', '2023-05-19T18:16:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, c56263a2-ce3f-4104-aa20-90c2ca810801, 'Délicieux, meilleur macaron du monde !', '2022-05-21T22:47:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 20591d06-f05d-421d-bbf0-d5bd81ba8563, 'Perso je laisse les coques à l''air libre avant d''enfourner et résultat de belles coques pas cassés. J''ai fait aussi un peu plus de garniture sinon c''était léger en garniture !', '2021-09-26T01:44:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 451e1b6c-00e7-420f-bf02-09d8a94cb6b2, 'C’est la 4éme fois que je fais ce dessert il a toujours était bon j’essaye toujours de nouveau coulis à mettre dedans pour varié que je pique a d’autre recette et franchement c’est top !!!', '2020-11-01T09:36:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, ecc3380d-4a35-473f-8244-bb8a08349c3e, 'Nul la pate est molle', '2020-05-14T19:54:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, c74ca7ad-c26f-4fb6-bd9f-7a4f4fdcb98e, 'Complètement raté !!! Ils n''ont pas du tout gonflé et on sens trop la poudre d''amandes !!! Pour tout j''ai tout suivi ?. Je referai ', '2020-05-03T18:40:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 2363d51c-becd-4a74-b05b-87acce78c79a, 'Recette parfaite, j''ai remplacé la poudre d''amandes par de la poudre de noisettes, excellent ! ', '2019-11-10T09:48:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 8a4931ec-6e18-46be-940f-dc239cd30770, 'Vraiment bon ! La farce est très bien réussie.', '2019-01-04T16:00:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 6836dbf8-5b79-457e-8323-838070a04235, 'Fait avec du coulis de fraises, recette nickel. Par contre bien prendre le temps de laisser les coques et la garniture refroidir, sinon ça dégouline...', '2017-04-24T21:19:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 7fe1f2cb-e598-4e93-9754-274a465f3de0, '1er essai de macarons réussi ! Je les ai laissés reposer à l''air libre 15/20 min avant de les enfourner pour qu''ils croûtent. Tout est là, le goût, la texture, le craquant, la collerette, etc... je les ai fait sur une plaque à macarons en silicone, c''est très simple. Il faut juste bien positionner l''appareil au centre du rond avec la poche à douilles dès le début sinon ils ne ressemblent à rien à l''arrivée. Je disposais l''appareil en spirale alors qu''il faut faire un tas au centre du rond qui s''étale. Merci', '2013-04-25T18:52:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, efea8547-ad39-4ef5-8cef-f7a9c6d17a05, 'Très bonne recette, le resultat est top !
Pour ma part, je pense essayer de refaire la recette en laissant cuire un petit peu plus longtemps les coques, avec 12min elles fondent dans la bouche mais n''ont pas de croquant. J''ai aussi ajouté une feuille de gélatine à la garniture puis laissé un peu au frais pour faciliter le montage', '2023-09-01T12:20:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, bbe91446-6b52-4cac-8417-4c66d25f689e, 'Miam!!', '2023-05-18T09:58:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 422decc3-66a7-4f17-a62d-ef1597adf6d7, 'La recette a fonctionné. Par contre, trop sucré, dommage ', '2023-01-15T13:26:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, a9fd29f1-e3d3-40a9-bea6-81ef28821743, 'Parfait, merci beaucoup ! ', '2023-01-08T18:12:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 3c0faa17-6597-4a19-98f7-bc7a722df436, 'Délicieux mais ganache trop liquide pour moi !', '2023-01-07T19:37:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 6eed4a7f-19d9-4853-84a8-4715d1017401, 'Très facile !', '2022-11-22T19:05:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 70bbdd12-8d26-4a40-b690-1db828efe376, 'je trouve quil manque de garniture mais ils sont excellents
', '2021-03-07T18:19:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, cc9885b4-472f-4d6b-a947-79c3ffaaa2c7, 'Simple et bon', '2021-03-03T17:10:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, ea6f7e00-89ff-428a-b985-1e726ab59835, 'Super recette !! !', '2021-01-28T22:30:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 68bf684a-c5b7-40e8-8ef7-dd4ab44d7103, 'Bof, tout les macarons sont craquelés, pourtant recettes suivi a la lettre.. dommage le goût est là  .', '2021-01-26T15:42:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 655a9f61-ac03-4d52-aa56-880dd1a4913d, 'Bonsoir trois que je réalise votre recette des macarons et ces un désastre en suivant bien la recette et le coulis pareil', '2020-12-30T18:34:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, ca685534-c9fc-4347-8b56-015c0881cecd, 'Super recettes, très bonne mais si vous avez une astuce pour les coques je suis preneuse car elles se sont quasi toutes fendues sur le dessus.', '2020-12-13T08:38:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 986aabc3-d182-4593-91c2-4f13c6cdde45, 'Parfait, une réussite Merci pour cette recette', '2020-12-05T18:08:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 6b075faa-6a52-42d3-906e-af2477c0f605, 'Sublimisime?', '2020-11-22T17:58:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, fd6177eb-c604-440b-b546-cc130acf0682, 'trop bon', '2020-10-24T22:08:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 08303fc5-4df6-4925-8ca6-00cf486d916e, 'Ils sont parfaits!
Toujours réussie cette recette, que je prends comme base pour les macarons avec d''autres parfums! Ils ne font pas long feu à chaque fois
Merci pour la recette', '2020-07-06T20:48:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 4f1fcefd-50e9-47a6-95fe-e7199bd5984a, 'Très bonne recette! J''ai fait cuire une minute en plus pour qu''ils ne soient pas mous et c''est super!', '2020-06-01T15:38:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 9ff340c4-34af-4351-b27b-2ef0c9fa5b2d, 'C’était une première pour moi... recette faite avec mes enfants.... et juste... un délice !!!!', '2020-05-30T18:39:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 0992995a-0032-4b15-aba5-c21e75c03dfc, 'Je laisse d''abord crouter les macarons à 50° environ 15 min (je vérifie qu''il soit bien sec) et en partant de 50° je monte à 150° pour 15 minutes et ils sont parfaits !', '2020-04-11T18:45:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 2cfea281-315e-4c24-96f8-3fca486b151a, 'Ce sont mes premiers macarons. Ils sont très réussis, la recette est facile à suivre.', '2020-03-25T22:33:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 9911cd76-dc4b-4d89-b478-e28fcd181510, 'Délicieux et c’était la première fois que je faisais des macarons, je referai. ?', '2020-02-21T09:59:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 336e6361-eca5-4fdc-9875-13ee3ec6c6bf, 'Sont montés mais pas moyen d''avoir la collerette (four à gaz). Qui peut me conseiller ?', '2020-01-27T14:32:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 6b1ca770-4082-4820-a0a7-6fab3e3ca007, 'Super recette ! Pour le coulis j''ai fait un peu à ma sauce mais macarons très réussis. Belle coque bien lisse, macarons bien formés... Une tuerie !', '2020-01-26T12:53:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 9d12e250-812c-4c43-9760-d4af612d9dd2, 'Super recette !', '2020-01-21T13:10:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 0b3794aa-2887-43bc-8a29-e936e59d954e, 'Excellente recette ! Merci', '2019-12-28T23:15:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 42c52978-7af8-443a-9f8a-0f9218ba7112, 'Les macarons n’ont pas monté... tout raplapla... je ne sais pas si c’est normal', '2019-11-19T05:24:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, c2b5b29a-ed80-4d70-8473-6bcf137eec09, 'Excellente recette jamais eu de loupé tout le monde est content !', '2019-02-23T02:50:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 44e434bb-4914-40a6-a609-5a5caddb84cc, 'Pâte trop liquide.', '2018-12-10T21:18:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 1957af76-bfc7-45b2-80fa-41e17536590e, 'Recette au top ! Satisfaite pour une première dans le monde des macarons !', '2018-07-19T17:05:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 68b66425-ef28-4acf-b287-e84a58db1e71, 'Ca craque dur au niveau de la coque, les quantités, si on les respecte sont limites, et la ganache est très liquide pour le montage (pas d’indication d’attente chiffrée entre la cuisson et son montage)', '2017-10-26T17:34:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 6e496568-d990-4287-891d-ada5b91f7ac5, 'Après 12 mins de cuisson, je retrouve les macarons tout craquelés. . Quelqu''un peut me dire pourquoi ? ? ? J''ai pourtant eu une bonne préparation lisse et homogène: -(', '2017-09-17T16:56:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 76b7fe69-2bd9-4f84-bafd-821583df2b9d, 'J''ai suivi la recette à la lettre et le résultat était au rendez-vous, le biscuit était bien moelleux! Par contre j ai doublé les proportions et du goût le temps d''enfourner toutes les coques la pates devenait de plus en plus liquide...', '2017-06-02T17:22:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 316ce0e2-6107-45ce-8a1a-84915094c3ad, 'Très bonne recette, à suivre à la lettre réalisée plusieurs fois.', '2017-05-18T22:01:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 01043832-40d4-4322-87a5-936fe7a33be1, 'Je n''avais jamais fait de macarons et franchement c''est nickel ! Perso les coques étaient un peu trop cuites mais cela vient de mon four électrique qui n''est pas évident à régler... Je les ai testé au chocolat et au citron : une réussite. Encore merci pour le partage.', '2017-03-19T09:19:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 257c70ea-504c-4c33-99de-01d667ea9731, 'Rien à redire super recette, simple et super bonne, je la refais souvent pour garnir mes macarons.', '2017-03-08T23:55:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 62643f88-ac7f-4f44-a23e-0ed4719d1e18, 'Très bonne recette je l''ai suivie à la lettre c''était ma première fois et j''ai réussi. Je n''aime pas trop le sucre donc j''ai juste réduit mes quantités en deux et c''était bon.', '2017-02-20T05:22:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 048da2e1-2c6e-448a-9483-738914cab3c2, 'Première fois que je fais des macarons... et ce fut une réussite, moelleux à l''intérieur et croquants à l''extérieur, bien cuits, très bons. J''ai suivi la recette à la lettre. Merci !', '2017-02-12T23:42:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 1c4de321-db94-4fd3-97e8-daaec6962c82, 'Super recette pour une première fois impeccable.', '2017-02-04T14:41:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 0e85a537-44f2-4108-ac08-bd7f499d0f73, 'En effet super recette, réalisés en 15 min avant cuisson, ils rendent vraiment très bien !! A tester avec moins de sucre en revanche dans les coques, trop sucrées pour mes papilles (au moins ça évite d''en reprendre 3 fois d''affilé). Et sinon ça m''a permis d''en faire une quinzaine personnellement, mais c''est une très bonne recette.', '2017-01-10T21:52:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 06e0914e-9478-4357-9f8a-f9d3f64e038d, 'Je ne comprends pas ce que j''ai pu rater, mes coques n''ont pas gonflé et reste toutes plates ... Au décollage l''intérieur n''est pas cuit. J''ai dû également ajouter quelques minutes de cuisson mais bon ce n''est pas du tout présentable. Je suis déçu !', '2017-01-07T18:46:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (220452, 590437b5-4eff-4834-9c4e-a1092b8ebd34, 'J''ai testé une autre recette qui n''a pas du tout fonctionné. En suivant à la lettre cette recette, les macarons sont très beaux et bons ! Un régal !', '2017-01-04T20:49:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, 581e9292-532d-47bb-a013-63c7f836c2b1, 'Très bon, ceci dit j''essaierai peut être  avec moins de sucre la prochaine fois.', '2017-05-17T10:19:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, af0fa508-5dfb-4b68-b171-43e9351b37ec, 'J''ai trouvé ça beaucoup trop sucré et le sorbet n''a pas pris. Je l''ai laissé près de 3/4 d''heure dans la sorbetière sans que ça prenne vraiment, c''était à peine épaissi... Ensuite j''ai fini par la mettre quand même au congélateur pendant plus d''une heure, résultat, une soupe de fraise un peu épaisse. Le goût était bon, mais trop sucré et surtout ça n''était pas le sorbet que j''attendais... Dommage.', '2015-09-20T12:15:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, b9479ac6-d5c0-4225-aaee-9f99e55b0e3d, 'Je pense aussi que 100 g de sucre suffisent. Je l''ai fait avec 300 grammes et c''était beaucoup beaucoup trop sucré. ', '2015-06-22T22:41:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, f6512a8a-4fd5-4197-b0c9-b213fe9c3046, 'A faire avec les fraises gariguettes du jardin un délice que vous ne mangerez plus de sorbet industriel.', '2015-05-15T23:35:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, 1f1fbc8e-f85c-4676-83ac-3d2b2d148c47, 'Bon et facile mais il faut diviser le sucre au moins par 2', '2014-09-10T17:41:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, 59bc733c-2823-4a79-8356-9b6c2474bd2a, 'Très bon sorbet ! ', '2014-03-23T14:09:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, 60bb9858-b9fb-4763-bb6e-e284c24f0edd, 'Super facile et délicieux. Les fraises venaient du jardin, et grâce à cette recette on a bien retrouvé leur goût succulent !!!', '2013-07-15T18:08:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, 903b5213-74f9-491e-b6d1-71761a219a5b, 'Recette très facile pour un super résultat. Je réalise la préparation au Thermomix et la termine à la sorbetière.', '2011-08-25T12:04:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, c192051f-175e-4ed7-960f-21fcee7ab93a, 'Je n''ai pas obtenu un sorbet mais un coulis de fraise... Je l''ai fait avec la sorbetière quand même. Je suis déçue.', '2011-07-17T01:54:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, 30dc8ab7-e89b-484c-a6d0-f194f39fd9a3, 'Trop facile au robot et trop bon !', '2011-06-13T20:24:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, 087ce029-71f8-4a39-9058-6616b9550219, 'Recette facile, rapide et excellente. En plus pour peu d’ingrédients ne pas hésiter si vous avez une sorbetière ! ', '2011-05-20T20:02:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, 33aa943a-95ad-4c6e-a9de-65e3fa13094a, 'Super recette avec 100 g de sucre ça suffit. A refaire !', '2011-05-18T17:09:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, ded9978e-efca-46e4-b4d0-b03f2383aad1, 'Avec des fraises de saison (délicieux avec des Mara des bois en provenance directe de Plougastel)il n''est pas utile de mettre autant de sucre. Pour Sylvie : si on ajoute de la crème fraîche ce n''est plus du sorbet mais de la crème glacée !', '2011-02-06T14:24:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, e3008f04-925f-4808-8427-58bf8fd1e9a3, 'Super recette ! Super facile ! J''ai mis moitié moins de sucre, car en plein mois de juillet, les fraises sont déjà très sucrées... C''était parfait ! J''en ai déjà fait deux fois... les enfants sont accros...', '2009-07-22T19:39:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, 498bd159-cdf7-445b-9917-0817e6386378, 'Cette recette est excellente et facile à faire. Le plus dur est d''éplucher les fraises c''est peu dire... Mais je l''ai modifié car je l''ai trouvé bien trop sucrée. Elle est meilleure avec 120 g de sucre et pas 300 g. Avec 120 g, on sent plus le goût des fraises et moins le goût de sucre.', '2009-06-15T10:49:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, 989ec96c-ee5b-4cc9-8248-ad1965d25b50, 'Super bon, on a adoré.', '2009-05-26T21:10:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29787, d3f096eb-4bc8-40c8-a9b0-03f4232a46a9, 'Très bon même sans sorbetière. Je rajoute de la crème fraîche. J''ai testé sans crème et avec crème. Y''a pas photo, avec la crème, c''est succulent.', '2008-06-18T19:31:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, bfb5c3e8-c4b4-4378-a83e-2c06c452b132, 'Excellent. J''ai suivi le conseil pour le beurre salé. Regardez la vidéo pour les astuces utiles !', '2023-03-06T15:04:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, fb877582-7d77-4b93-914a-d11f1378260d, 'J''ai suivi cette recette à la lettre, mon caramel est devenu solide, j''ai dû refaire... les palais étaient trempés, bref je recommande surtout de ne pas la suivre comme elle est expliquée !', '2018-12-02T11:50:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 37d53f33-70cb-4fd6-ad80-fa1c72426d58, 'Alors... c''est très beau ! Mais alors question goût, c''est fade et dépourvu d''intérêt. Les quantités d''ingrédients de la recette sont trop importantes. Il faudrait à mon avis supprimer le caramel car trop écœurant, et sucrer la chantilly. ', '2015-01-26T23:14:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, ec66dd85-4179-4af2-a20e-0375e36a53c8, 'Parfait, attention creme liquide pas creme épaisse.  Beurre sale à la place du beurre.', '2022-11-05T22:51:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 841d4f30-fc5f-44b6-8cc3-e016128f61f9, 'Super recette facile et rapide à faire! ', '2021-12-25T18:53:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, df01ad2d-4fb2-431c-8222-1411bb3e01d4, 'Succulent !', '2021-01-17T21:15:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 2371ea15-087f-4e95-b5e9-e7f0f145f92b, 'C''est bon, la chantilly n''est pas nécessaire ! ', '2019-12-18T07:25:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, de0976b0-581a-41ad-aeda-b73ae7f1f382, 'Excellentissime !! Comme suggéré j''ai remplacé les palets par des spéculoos et mis du beurre salé pour faire mon caramel. Côté chantilly j''ai eu du reste : bien la moitié. A voir en fonction de la taille des verrines. Pour la monter j''ai incorporé 1 cuillère à soupe de sucre glace. Dessert délicat, frais et qui a fait l''unanimité. Merci pour cette recette qui a rejoint mon carnet. Lancez vous les yeux fermés et dégustez !! ', '2017-03-19T08:12:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 5b8a497a-7e61-48bd-b24b-2ab86ca08f24, 'Excellent j''ai eu des compliments de mes invités qui ont été surpris du caramel. Je vais le refaire mais avec un mélange de pommes et poires. J''ai ajouté un peu de sucre glace à la chantilly. Merci pour cette recette', '2015-11-10T22:49:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, c665fc5a-77f2-4d8f-9286-88794e532e60, 'C''est bon mais pas de palets bretons à la maison j''ai remplacé avec des noisettes concassées et mis moins de chantilly', '2015-10-07T15:40:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 0131eaba-40c8-4845-8333-43dcf031acc5, 'C''est bon, mais attention à ne pas faire trop cuire le caramel pour éviter l''amertume ("quand il est blond" serait plus juste que quand il est brun). Si je refais la recette, je mettrai les palets émiettés plutôt sur le dessus pour garder le croquant.', '2015-02-17T23:15:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, f60c5380-724c-4765-8a25-14292f97e878, 'Excellent', '2015-02-14T22:52:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 7bd707cc-1c6e-4691-bbf1-51dafd6fc577, 'C''est excellent, à refaire, facile à faire et vite fait', '2015-01-10T01:22:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 96dad4ee-b920-4943-bc90-db65af4310a7, 'Délicieux et simple à réaliser. Tout le monde s''est resservi !', '2014-12-26T23:20:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, eb34db67-43bf-4ff3-8b00-b03c1ba71b95, 'Vraiment excellent. Je ne suis pas fan de dessert, de chantilly et même si la sensation de gâteau "mouillé" me dérange, j''ai vraiment apprécié ce dessert. Facile à préparer et délicieux, tout le monde en redemande. Peut-être à éviter après un repas très copieux car cela tient bien au corps !', '2014-12-15T09:17:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 0687519f-1863-4e64-bbeb-17980f7e9a43, 'Très agréable dessert, merci beaucoup. J''ai utilisé du caramel tout fait à la pomme (petit pot) et c''était très bon. Je l''ai fait la veille mais la crème fouettée le jour même.', '2014-11-18T11:24:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, bdb7eb87-f094-4ccb-8be8-e2b4fa8a0063, 'Très bon. J''ai fait une partie en verrine et l''autre en samoussa avec la chantilly de mascarpone : une tuerie.', '2014-09-22T00:11:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 00143d6e-921b-4703-9208-53e124aa3cc2, 'Vraiment délicieux ! Pour ma part je l''ai fait avec un caramel au beurre salé, une tuerie... Merci beaucoup pour cette recette qui en plus est facile à faire !', '2014-04-10T22:17:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, a96fa6db-b05e-429c-8b2e-3e0de53e5988, 'Sublime... C''est un vrai délice, très frais et qui a emballé toute la famille. Bravo et merci Nadia pour cette merveilleuse recette très facile et rapide à réaliser.', '2014-03-22T07:59:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 38d5e92e-cb73-4bb0-ad69-6ec5608acfdd, 'Excellent !!!! Cette recette est devenu un incontournable à la maison ! Tout le monde me la redemande !!! Merci', '2014-03-01T18:59:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, fff66c4a-5a18-418a-9a89-67cf673809f3, 'Testé et approuvé. Pas trop sucrées et c''est appréciable. Nous avons tous bien apprécié. Je l''ai réalisé avec des biscuits sans gluten : un des invités étant intolérant au gluten. Nous n''avons pas vu de différence.', '2014-02-28T23:45:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 5af3e74a-6f98-4625-be71-61b5af5f6181, 'Un vrai délice ! Une variante avec du caramel beurre salé pris sur marmiton cela fait une vrai différence !', '2013-12-26T00:13:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, f3aad2dd-33ad-426b-9471-18e18fb129f1, 'Très bon, mais le dosage pour le caramel ne m''a pas réussi, j''ai donc fait avec les miennes....', '2013-11-27T09:30:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 7866de5b-a7f3-4c3d-8245-338a9c964ee8, 'Excellente recette. J''ai remplacé le caramel par caramel au beurre salé.', '2013-11-10T14:04:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 992895a3-2eef-4ce1-84cb-e6b4bb99915e, 'Je confirme, cette recette est super, c''est la 3ème fois que je la fais. Un régal ! Personnellement, je mets une boule de glace vanille.', '2013-07-06T14:10:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 6d5b9108-50f5-4333-ab49-f6749fc62e89, 'Une merveille !!! Cette recette a un succès fou auprès de tous nos invités.', '2013-06-21T19:02:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, e119370d-216d-452f-95fd-6023eb33a39c, 'Simple, rapide pour un résultat excellent !', '2013-05-11T17:27:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 4239873c-8d14-4713-9f3c-308bebb6bdf9, 'Excellent, très facile à préparer. J''ai sorti les verrines un peu avant de les servir. Le caramel a un peu ramolli. Mes amis ont adoré. Merci pour la recette.', '2013-04-27T01:17:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, da8de985-b9e4-4063-8a08-64dbd21caa8a, 'Une tuerie ! Franchement génial !', '2013-03-21T10:05:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 493b5a78-ccfc-47e4-8fd8-13f2ed4e571b, 'Franchement très facile et succulent ! ', '2013-02-10T20:27:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 16e26860-fdc1-42a0-a6f7-eedce4ff745b, 'Hummmmmm mais quel délice ! Une vraie réussite ces verrines ! La crème/mascarpone était un peu glacée et fondait en bouche. Le caramel ? J''avais du mal à croire que c''était moi qu''il l''avait fait tellement qu''il était bon ! Bref une réussite, je garde précieusement cette recette ! Merci! PS : j''ai ajouté de la cannelle dans les pommes lors de la cuisson et un sachet de sucre vanillé dans la crème/mascarpone.', '2012-12-31T17:58:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, bb7915ff-5483-42de-8db8-0338dd45f0ae, 'A tomber ! La 1ère fois, j''ai fait idem puis je l''ai modifiée : spéculoos, pommes caramélisées chaudes, spéculoos, boule de glace vanille, couverte par un caramel breton à la fleur de sel. On tombe deux fois...', '2012-12-17T19:30:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 0e9d33b1-4fff-4d9e-8613-11af1c31610d, 'J''ai testé cette recette et j''ai adoré. Pour la crème fouettée j''ai ajouté un sachet de cremfix car elle avait du mal à monter ! Du coup j''ai une véritable crème fouettée aérée et qui se tient bien. ', '2012-11-16T09:59:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 6bccb6de-9ac4-49c6-95c0-abee15f4d849, 'Simple et bon ! Cependant attention à ne pas mettre trop de caramel, cela devient vite écœurant !!! Bien choisir les pommes aussi... Avec les proportions données, il reste du caramel et de la chantilly.', '2012-10-29T10:28:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 64819ea0-8374-40e9-9f71-d697789614c5, 'C''est excellent, j''ai varié cette recette en pommes caramel beurre salé et poires chocolat ! Tout le monde a adoré !', '2012-10-14T18:31:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, f227cbe2-2fb6-4e6f-aea4-ee2b601bee09, 'Très belle réussite et assez rapide à préparer... Surtout si on a de la compote en reste ! Rangée dans mon classeur, à refaire pour un prochain repas !', '2012-10-12T20:51:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 1b49d1f4-d0b1-4bba-ba4f-6ace08673aa2, 'Impossible de mettre en dessous de 5/5 ! Explosion en bouche ! Quelques modifications pour la prochaine fois : mettre plus de mascarpone (ou une partie de la chantilly) dans le caramel pour éviter qu''il ne soit trop compact. On peut aussi mettre de la compote toute prête pour gagner du temps. Ajouter aussi un peu de sucre glace dans la crème fouettée.', '2012-09-17T09:31:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 9b11772e-80d0-4f60-b91b-250369d561e5, 'Délicieux et frais, tout le monde a adoré. ', '2012-04-21T22:54:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 708544d8-affe-4aae-98ef-f0564251c097, 'Et encore une recette où tout le monde s''est régalé. Merci aux abonnés Marmiton. Ma petite astuce pour émietter les palets bretons proprement, je le fais quand ils sont encore dans le paquet non ouvert en utilisant un rouleau à pâtisserie. Ensuite, je n''ai plus qu''à garnir le fond de ma verrine. Je n''ai pas mis de miettes partout.', '2012-03-10T16:03:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 74da0e8d-8cd8-4c2a-8650-ae50c55981e4, 'Très bonne recette, attention à ne pas laisser colorer trop le caramel sinon cela donne un gout amer', '2012-02-27T22:10:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 24c42084-0d20-4034-ac5b-99dc8eabded8, 'Un vrai régal ! J''ai aussi utilisé des spéculos. Je n''ai pas utilisé toute la chantilly et le caramel pour ne pas que la verrine soit écœurante. J''ai fait 5 verrines avec les quantités données. A refaire...', '2012-02-21T22:15:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 01d24587-817f-44ac-b6f6-30007ddfd71b, 'J''ai remplacé les galettes bretonnes par des spéculoos et 1 peu de cannelle dans la compote de pomme, 1 délice. ', '2012-01-07T13:16:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, c9358d8c-2813-43b7-ae65-dff0a3279dec, 'Recette expérimentée un soir de réveillon, pour changer des bûches traditionnelles. Un vrai régal. Je n''ai pas mis de sucre dans ma compote de pommes, par contre j''ai mis un peu de sucre glace dans ma chantilly. J''en referai c''est sûr, mais la prochaine fois je ne mettrai pas de mascarpone dans ma chantilly, et je le remplacerai par de la crème fraîche dans le caramel. Merci pour cette délicieuse recette.', '2012-01-02T13:08:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 2e6a8f20-5fd3-41fd-bc03-87c7887c1d5e, 'Bonne recette ! Mais je ne met pas 5/5 parce qu''avec les quantités recommandées, je trouve qu''une verrine entière est presque écœurante. Attention de ne pas mettre trop de caramel non plus. Mais je la referai !', '2011-11-03T00:13:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, d913453d-3049-4e04-ab40-55a127621c4d, 'C''est la 2ème fois que je fais ce dessert et il a toujours beaucoup de succès. Sur le dessus de la chantilly, la 2nde fois, j''ai déposé quelques pistaches (sans sel ajouté) que j''ai fait grillé dans du beurre salé et légèrement caraméliser dans un peu de sucre. Très joli et croquant ! Le reste de caramel au beurre salé est conservé dans un petit pot en verre et me sers à aromatiser mes yaourts natures...hum...délicieux !', '2011-11-02T17:20:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, c3d25071-7591-48e8-a8e2-a99158b9ce70, 'Très bon dessert, la sauce caramel est excellente. Attention lors de la préparation de la chantilly de ne pas trop la fouetter car cela devient du beurre, j''en ai fait l’expérience. Le mascarpone dans la crème liquide est facultative. A renouveler.', '2011-09-05T20:46:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, fcdd1e56-8e20-414a-b316-b42707d13165, 'Cette recette est délicieuse. Par contre le caramel était beaucoup trop sucré mais il était assez mou ce qui était très bon. Comme je n''avais pas de palets j''ai mis des galettes bretonnes et c''était aussi très bon.', '2011-09-05T15:43:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 87bbb02a-b160-49bd-ba4a-1b55108227a7, 'Caramel délicieux, un vrai régal ! Un dessert à garder pour la saison des pommes. Merci.', '2011-08-18T09:56:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, ada797c8-88d1-4e6d-97b9-a5df29c4fde8, 'Très bon ! Mais moi je ne n''ai pas mis la crème fouetté, je trouvais que sa faisait trop. Autre détail, le caramel était délicieux (surtout si on met du beurre salé) mais sur verrine il est trop dur et pas facile, cassé, dommage... Mais je tiens a préciser que j''ai les compliments de mes invités pour cette recette !', '2011-03-13T15:08:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 9dacb7bf-3af7-431d-8e0c-079cbbf89ff9, 'A tomber !!! J''ai épaté mes invités, super bon, facile à faire. On peut le faire la veille sans problème. Par contre j''ai remplacé les palets bretons par des spéculoos, c''est délicieux. Merci à celle qui a mis cette recette', '2011-01-11T22:46:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 5bf64c8b-8bce-4375-9f19-3c4c5191ca3e, 'Excellent, j''ai parfumé un peu plus la compote : cassonade, cannelle et vanille. C''était frais, très bon.', '2010-12-13T15:03:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 461cef41-ec43-47d1-95ef-4857f9625501, 'J''ai ajouté un peu de sucre avec le mascarpone et la crème fleurette, les invités ont adoré !!', '2010-12-07T21:06:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, fa93fc88-7116-4341-b384-53b8b62aa0d4, 'Délicieux. J''ai aussi ajouté un peu de sucre glace à la crème montée en chantilly et j''ai utilisé du caramel au beurre salé.', '2010-11-20T23:47:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, fa83bdaa-b865-4f21-9e71-1fbd81b3fc16, 'Vraiment très bon - effectivement il ne faut pas sucrer les pommes le caramel apportant la touche hypersucrée nécessaire. A défaut de mascarpone, j''ai terminé ma verrine par de la chantilly - Dessert apprécié par tous les convives. ', '2010-10-19T18:28:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 07ed7eec-336f-4458-83dc-19977f3b7624, 'Très bon dessert qui a eu un franc succès, j''avais toutefois remplacé les palets bretons par des spéculoos pour un peu plus de goût. Tous les convives ont apprécié.', '2010-10-02T20:43:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 7a6a7ba0-2a40-4fcc-b4ae-a8878fd287cf, 'Excellent, j''ai fait la chantilly dans un siphon et je l''ai mis juste avant de servir, un régal', '2010-08-01T15:10:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, bf9b14e0-132d-4a87-a650-fec8363030ff, 'Délicieuse recette très simple à réaliser. Je fais une variante en remplaçant la crème chantilly par une crème de tiramisu (voir Tiramisu Breton de Satienne) et un caramel au beurre salé. Succès garanti.', '2010-07-22T23:04:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 6d7b8f9b-c0a0-4540-85b6-46632dc917ea, 'Très bon et très copieux !', '2010-05-25T13:45:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 19c8c29f-9b0f-4398-aba5-63e777c64078, 'Très bon. J''ai cuit les pommes avec 1 cuillère à soupe de cassonade, puis je les ai écrasées à la fourchette. Pour le caramel, j''ai fait une fois et demi les proportions indiquées dans la recette. Ne pas mettre trop de biscuits au fond des verres. Pas de sucre dans la chantilly (le caramel est suffisamment sucré) et 20 cl de crème suffisent. J''ai testé 2 modèles de verres : les verres à whisky sont à utiliser pour les gros gourmands (on a du mal à terminer même si c''est bon), sinon, une verrine de taille moyenne est suffisante pour terminer un repas copieux. Se fait bien la veille. Frais et agréable à manger (le mieux : à la verticale en prenant les 4 couches en même temps pour avoir toutes les saveurs !!).  ', '2010-04-05T22:36:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55029, 12a63630-3686-4178-902f-0c4a7979e9e7, 'J''ai suivi la recette à la lettre et c''était délicieux !!! Le caramel fait tout son effet avec le croquant des palets, la fraîcheur de la compote et l''onctuosité de la crème, c''était vraiment réussi ! Merci pour la recette que je vais garder bien précieusement!', '2010-03-07T16:38:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 3f605e99-13a6-47ca-abe9-4e6c82562873, 'Pas mal comme recette, ça change des gâteaux aux pommes classiques mais beaucoup trop sucré et trop gras. Je vous conseille de mettre plus de pommes (on sent à peine le goût) et moins de sucre dans le gâteau et de diviser en 2 la quantité de glaçage. Et aussi de cuire beaucoup plus longtemps (adapter la température en fonction de votre four) la 2ème partie avec glaçage pour que ça caramélise.', '2019-04-16T12:22:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, f2f84281-f257-480f-943c-b7676cc2fc64, 'C''est trop bien 😍', '2023-09-10T17:53:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 6ffcb2f5-2fc2-4e31-8e7d-a02bf18986a3, 'Excellent gâteau facile à réaliser. Pour moi c''est devenu un classique ! Il ne faut rien changer à la recette ! Certes il est riche en beurre et en sucre, il suffit de servir des petites portions...', '2023-04-13T16:39:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 9851c488-d324-4fba-be35-92232bc3ce63, 'Excellent gâteau ! Tout le monde s’est régalé 😋', '2022-11-20T21:40:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, dcda683e-3756-4222-ae23-5ad0bb6db13b, 'J''adore ce gâteau !', '2022-10-09T11:43:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 2bbc2f92-2c50-41a5-b04f-68c1e6585b63, 'Moins de sucre dans la pâte et diminué de moitié beurre et sucre dans la crème. Mis 1 pomme en petits dés. Se démoule bien en couvrant à la sortie du four', '2022-05-06T18:03:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 7f7e4e4c-17d0-4c2e-a7b9-a5abc45c4462, 'Très bonne recette, facile et qui marche à tous les coups !', '2022-04-23T17:17:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 0b4cef0a-e8ad-488e-80ef-d33444695408, 'On a adoré avec un mon mari. Je diminuerai les doses de sucre la prochaine fois par contre si je veux en profiter encore longtemps. Merci pour cette belle recette.', '2021-11-26T22:09:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, de77eac1-fd65-41aa-bb6f-3682cf39ba3f, 'Le nappage a caramélisé et croûté… rien à voir avec la recette de mon ex belle-mère… je suis déçue. Ma famille n’a pas aimé car beaucoup trop sucré et gras. C’est un Kouign Amann 2. 0.', '2021-02-27T15:49:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 50dfc21a-a83e-4ea6-9c2a-fe8dc1023c3e, 'Très bonne recette . Je mets cependant moins de sucre dans la pâte et dans la crème . Je fais tremper les morceaux de pommes dans le calvados et je saupoudre de cannelle les pommes . Dans la crème je rajoute le reste de calvados qui a servi à tremper les pommes . Pour la cuisson il faut cuire plus longtemps.  ', '2020-12-30T13:29:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 98add2cf-da46-4f66-a10d-add29a265099, 'Bon mais trop sucré, et trop de beurre. A refaire pour les gourmands, en allégeant tout ça.', '2020-11-22T15:12:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 2f29b553-0325-4180-a6f5-90959c6de7d4, 'Trop bon.', '2020-11-20T15:13:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 8f572be9-6866-437c-a772-a3f6b2e82fe0, 'Un délice avec cette crème sur le dessus !', '2020-04-26T14:32:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 1ecfca8b-47f5-400d-b07d-f8d9883aa85b, 'Tout simplement délicieux ', '2020-04-13T20:23:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 5fc7caeb-2e41-48d6-acfc-0ae4124e6613, 'Gateau facile qui fait l''unanimité.  J''utilise de la cassonade pour le napage il devient craquant sur les bords.', '2020-04-13T15:27:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, e5feeda6-d564-4e44-a636-f5d02fbfb659, 'Une tuerie!', '2019-06-04T03:18:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 30045954-4c8c-4a7c-b7d2-34861924d0f1, 'J''ai dû laisser cuire la crème 25 min car encore trop molle à la fin des 15 min.', '2018-12-06T03:27:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 8813bddd-e140-4d9b-aeb4-7b5dc01a5c1d, 'Excellente recette de mon enfance et de celle de mes enfants qui ne prend pas une ride.
', '2018-06-14T07:03:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 19f0564b-83c9-4917-b792-56470c66ad4f, 'Excellent !
Ce gâteau est devenu un incontournable chez nous. On adore...', '2018-04-02T11:26:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, a1bcb612-ea8f-4867-9c81-85865d51eddf, 'Très très bon !', '2018-03-31T09:42:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 6f53172c-a9d6-4a3b-9683-71fc8870a9a0, 'Délicieux ! ', '2017-03-05T16:35:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, b1b84fa3-67ea-4854-be6e-76c6ad275488, 'Bonne recette. Comme certains internautes, j''ai mis 2 oeufs au lieu de 1 dans la pâte et une pomme de plus. Par contre, il faudra que l''auteur nous explique comment elle fait pour avoir une cuillère à soupe bombée de lait ou d''huile ! Pour la farine ou le sucre d''accord, mais pour du liquide, mystère.', '2016-12-28T21:03:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 0196a3d7-3224-491b-b622-59f0e29947ac, 'Le dosage à base de cuillères bombées m''a obligé à augmenter le dosage de lait. Mais il est adopté à l''unanimité! Bon simple et rapide tout y est! Merci ', '2016-05-16T18:54:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, eb2ee880-0da0-4195-a837-68df5d8fa172, 'Pas terrible...', '2016-04-16T20:28:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 012bb7b2-464e-49c9-bffe-21b5ef43d30f, 'Un très bon gâteau!! Je n''avais qu''une pomme et un oeuf alors je n''ai pas mis d''oeuf dans la "crème" et ça a fait un magnifique nappage caramel! C''est la recette parfaite de la fin du frigo. Merci!', '2015-11-03T01:34:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 47edef1c-6d44-48ee-89c2-557594cd73b8, 'Tout simplement délicieux et très facile à réaliser. Le gâteau aux pommes de mon enfance !', '2015-10-03T17:04:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 250f1a8c-3c04-4228-8621-6925ab1b93be, 'Depuis le temps que je recherchais la recette de ce gâteau de mon enfance, quel bonheur de l''avoir retrouver. Merci de ce partage.', '2015-09-21T20:09:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 1da73659-25a8-4d5d-b058-92d4f9a016c5, 'Recette devenue un classique dans la famille ! ', '2015-05-02T18:08:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, d49c5aff-5a67-4659-ab6e-fc69a72615c2, 'Très bon gâteau !  Par contre j''ai mis la moitié de quantité de crème pour le dessus car c''est trop.', '2015-03-27T12:26:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 943367e7-efcb-48ef-83a5-f1f876419c63, 'Excellent, approuvé à l''unanimité !', '2015-03-19T22:09:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, b0055836-472c-40db-bde3-1e42467d07d2, 'Délicieux ! Je l''ai fait avec 2 bananes à la place des pommes et deux barres de chocolat dans la crème que l''on rajoute. succulent!!!! surtout bien frais... ', '2015-03-09T14:54:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, b02f29f6-f852-43ad-a4c7-24b89754ebd9, 'Très bon mais les cuillères à soupe bombées d''huile me font sourire !', '2015-02-27T16:21:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 2cde16b0-e876-4da2-a67a-96ce656da245, 'Super bon gâteau !!! J''ai fait la crème avec du beurre demi-sel faute de beurre normal. Le seul bémol c''est qu''il n''est pas très grand... la prochaine fois je doublerai les quantités ;-)', '2015-02-08T18:53:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, f16b1214-dec5-408b-b52c-91e56782de1b, 'J''ai doublé les quantités et utiliser un moule à cake 6 moules à muffin. Il ne me restait plus d''oeuf pour la sauce donc j''ai remplacé par 2 cuillères à soupe bombées (lol) de crème fluide bridelight à 5%, 1 cuillère à soupe d arôme vanille ! et j''ai mis moins de sucre également ! Résultats : TROP BON !!! C''est un régal, MERCI.', '2014-12-07T18:11:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, a2d76fff-250b-42b6-88b1-92e022ac53ca, 'Réalisé pour la 1ère fois mais pas la dernière. Très facile à faire et super bon. Bien moelleux. Je l''ai servi avec une crème anglaise maison. Délicieux..... ', '2014-11-01T13:42:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 10b0fbe4-956d-4152-a10e-b58168f0a1ed, 'Comment fait-on pour avoir 3 cuillères à soupe bombées de lait ???', '2014-05-23T11:08:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, a67c1d89-acb0-458e-a355-e98c033d0532, 'Alors là oui je confirme que c''est vraiment vraiment bon. Je n''étais pas très sûre de moi, sachant que je ne suis pas très bonne pâtissière. Mais gâteau réussi haut la main et fait avec mes enfants. Je recommande vivement d''essayer cette recette !! ', '2014-05-08T10:19:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 5e04f8bd-d541-4801-b776-1a85c4f5829b, 'Souvenir d''enfance et en plus délicieux.', '2014-03-23T15:10:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 180635ec-d7a0-41aa-8db4-8ce8e6a9e976, 'Je l''ai fait dans un plat à cake, et comme le gâteau a gonflé en son centre plus que sur les côtés, la crème a coulé surtout sur les côtés.. Attention : le gâteau n''est pas démoulable ! Il ne faut pas hésiter à mettre plus des pommes, car au final le goût des pommes n''est pas très marqué. Enfin, le goût est très bon, la texture aussi, même si effectivement il pourrait être moins sucré. ', '2013-12-11T17:12:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 99e65c06-e55f-4720-bcc3-e81bca0f1d24, 'Très bon gâteau facile à faire et la base peut facilement être utilisée avec d''autres fruits. ', '2013-10-21T21:28:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, e050e3a7-d4b2-4b3c-81cb-90f13dae1006, 'Avec des bons ingrédients, c''est mangeable, mais le gâteau est raplapla. Peut-être le moule n''était pas bon. ', '2013-10-06T12:43:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 356e0696-3d89-46bd-9535-f4101ec6fad9, 'Très très bonne recette j''ai juste doublé les ingrédients car nous sommes gourmands.', '2013-10-02T17:35:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 0900a629-5c61-4bce-87f5-ec051d62bd92, 'Très bon j''ai mis un peu d''ananas.                                                           ', '2013-08-18T18:19:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 84fec6e7-23b2-410c-a1f7-2e19032988dc, 'Très bon et moelleux, à refaire sans problème.', '2013-05-15T20:51:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 19113bac-bd62-4c42-8391-b41cb595861c, 'Excellent gâteau avec 3 fois rien, simple et rapide c''est la deuxième fois que je le fais, un vrai délice ! ', '2013-05-14T00:22:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, b843489b-d4b1-407f-9496-7194739cf9b2, 'Facile à faire et très bon, j''ai gardé les proportions sauf pour la crème je n''ai mis que 50 g de sucre et je l''ai fait cuire dans un petit moule à tarte', '2013-04-26T16:44:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 6e09137d-507e-4244-8d94-95249d5621ab, 'Excellent gâteau, mais j''ai doublé les quantités, j''ai coupé les pommes en petits morceaux et je les ai mélangées avec la pâte. Par contre, je trouve que la crème est bien trop sucrée et j''aurais mis moins de beurre. Je le referai avec 50 g de beurre, et 60 g de sucre, ça sera moins lourd, ou même sans crème.', '2013-03-24T02:47:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 1a4e1e84-f5a8-48a5-ba7c-8f9f32da7f12, 'Très facile, très bon même sans sauce et on peut l''adapter à pas mal de fruits.', '2013-03-19T16:50:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 5e89ad88-53cf-454d-b9d6-c801d842689b, 'Trop bon !!! La crème de beurre sucré sur le gâteau à utiliser à la fin est vraiment extra !!!', '2013-03-17T15:28:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 2951efb3-c896-45d0-bd7b-2c792167a663, 'Très bon ! A conseiller.', '2013-03-12T22:51:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, d3fdd77d-9de7-43b6-8c24-da45c1b17177, 'Bon gâteau, à refaire !', '2013-03-10T21:58:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 7dfcf8b3-332f-450d-b182-ea43506a3e07, 'Excellent gâteau, moelleux. Il faut rajouter des pommes et une cuillère de lait, je n''ai mis que la moitié de la crème et c''était très bon. ', '2013-03-04T10:37:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, ddd37414-f5b0-4bb3-9d01-7931cce1082a, 'Trop bon !!!', '2013-03-03T18:28:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, d46c22b0-7355-4482-86b9-1cb09072dab2, 'Succulent, exquis selon les petits et les grands. C''est le meilleur gâteau que j''ai pu faire avec les enfants !!! Petite variante, n''ayant pas d''huile, j''ai mis du beurre... Vraiment très bon !', '2013-02-25T18:58:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 10150c5a-bb82-483d-a93d-cd92e6009ac7, 'Excellent ! J''ai mis la pâte dans des moules à muffins (pour faire des gâteaux individuels) et suivi les conseils des internautes en mettant moins de sucre.  Moelleux à souhait, pas sec du tout grâce à la petite crème. Ce gâteau rentre directement dans mon livre de recette! A refaire encore et encore!', '2013-02-24T09:41:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, f1663b3c-6126-40f1-bd6a-a703bd15aff4, 'J''ai été complètement séduite par cette recette, moi qui, d''ordinaire, n''aime pas les gâteaux aux pommes.', '2013-02-21T01:56:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 4619f401-f40d-45de-9b4f-c892432bbdd2, 'Un régal, j''ai mis 2.5 cuillères de sucre. A refaire !', '2013-02-20T22:03:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, ec8dff78-6034-4649-a9b9-016709ada9f7, 'Très facile à faire ! Et le goût est délicieux . Par contre ne pas mettre trop de crème sur le gâteau, ça devient très lourd à manger. ', '2013-02-17T23:13:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, 784418c4-b769-4b15-b05e-488853dc3cb8, 'Super bon, j''ai mis seulement moins de sucre, recette extra et facile à faire.', '2013-02-17T19:01:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18726, a1e4b1d7-b695-46ce-8186-18ca4a6e9487, 'Très bon mais trop sucré, la prochaine fois je mettrai moins de sucre.', '2013-02-12T21:46:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, a6641eef-df0e-4168-9864-edbb26a49834, 'Super recette ! 
Trop de sucre pour moi il faudrait pour 4 personnes : 150g de sucres . 50g pour le début et 100g pour la fin ', '2021-04-20T16:05:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, b0597e93-9081-4f11-8247-f8ded83fcedb, 'je prend la basse de la recette et je change le goût  , fraises,  chocolat,  menthe  etc ....que des fruits de qualité ou surgelés,  et c''est  une tuerie,  mes enfants et moi on en réclame tout le temps ', '2020-11-23T10:29:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, c254a90c-0328-4b21-8443-d01eb019e3c2, 'Parfaite recette ! Plus légère qu''avec de la crème fraîche et sans le goût parfois trop prononcé. Ajuster éventuellement le sucre à la baisse, un peu de 🍋 pour empêcher l''oxydation.', '2022-06-09T16:10:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, b6144e90-4905-4931-a98a-120aa9091d43, 'Délicieuse ! Recette faite à la lettre, rien à changer ', '2015-11-18T20:30:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 8ddbce40-bc79-4477-af90-324095c305ae, 'Délicieuse ! J''ai mis du sucre vanillé à défaut d''avoir de la vanille et j''ai rajouté des feuilles de menthe pour que ce soit encore plus rafraîchissant ! Merci pour cette recette, à refaire.', '2015-05-22T15:53:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, ac9ca787-9276-4e10-9b4e-862c53bb8cd5, 'Je ne comprends pas … la glace n’a pas pris pour moi non plus.. pourtant tout bien respecté…', '2023-06-27T18:09:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, d443e4e1-3ba7-4ed7-9b65-3c3eb2851cc3, 'Je pense qu''on peut utiliser les fruits dont on dispose car cette recette est standard 👍👍👍', '2023-05-12T15:29:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 619e3377-e239-4d5c-8d9e-9e4b02ca3500, 'Pour un 1er essai, c''est pas mal du tout ! J''avais suivi des commentaires et mis plus de fraises (400g environs) et de la crème en plus du lait (oublie !). Pour la prochaine fois, mettre moins de sucre, remplacer du lait par la crème et mettre 500g de fraises pour faire ressortir le goût.', '2019-06-16T21:37:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, ed611571-3105-411b-8c34-22973f6cbbe3, 'J''ai suivi la recette à la lettre et la glace n''a pas pris.', '2019-04-06T11:52:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 6bd2bc15-d96f-491c-80b4-86e5d7f9a9b4, 'Délicieuse recette ! Je la referai en y mettant moins de sucre...à faire prendre à la sorbetière et la mettre ensuite dans le congélateur 4h pour une meilleure texture.', '2016-05-09T12:06:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, b4452bec-c26d-43f4-bc61-ec1b24cb8016, 'Bonne recette mais la préparation ne durcit pas dans la machine, dommage.', '2015-11-06T20:32:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 25ce20b8-3222-49b0-99ce-b592418b3288, 'Très facile à faire en mettant 50% lait et 50% crème épaisse. J''ai mélangé les fraises à la préparation ds la casserole et j''ai bien laissé refroidire au frigo abatée mettre en sorbetière.', '2015-06-13T18:26:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 8332dbc4-4256-40c2-8c69-1e8ebc79fc80, 'Excellente, faite dimanche avec les fraises du jardin, je test aujourd''hui avec du pamplemousse', '2015-06-09T11:50:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, f9991bc5-21ad-4760-96f0-eb6a0dacfcbc, 'Excellente ! Je n''ai rien modifié à la recette.  Toute la famille s''est régalée.', '2015-06-07T14:30:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, ac020926-edec-433e-aef7-a3a2240f543a, 'Merci, bonne recette ! ', '2014-08-29T00:25:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 547528c4-a3f8-4b38-9659-5cb46f1ca9fa, 'Excellent ! Cette recette est super ! ', '2014-07-26T13:29:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 79dbaf25-10d3-4d20-bb3a-ef5b0d6af45d, 'J''ai adoré cette glace, mes enfants aussi, ils en on repris.', '2014-06-25T13:46:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 9b13c210-31ad-42e8-914f-dbaeb609abc8, 'Très bonne glace mais manque d''onctuosité.', '2014-06-15T19:44:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, ea945edb-bc73-4e69-9136-0685982ed517, 'Excellent ! Je referai cette recette avec d''autres fruits rouges car elle était trop trop bonne ! Merci.', '2014-06-15T19:13:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, deccb12e-4715-494f-b17b-fd456f13c1e3, 'Avec les bonnes choses que j''ai mis dedans je ne peux que supposer qu''elle soit très bonne... si toutes fois elle avait pris dans ma sorbetière, mais ça n''a pas été le cas donc assez déçue ! ', '2014-06-08T12:05:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 55225203-1a07-4b09-a278-90bd0f19fb3d, 'Un vrai régal !!!!', '2014-06-08T00:44:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 296cc203-f6ce-4c61-8855-83bdeb51f99b, 'Suivi à la lettre. Très satisfaite, avec des fraises de qualité on obtient une glace savoureuse, toute la famille à adoré ! ', '2014-06-03T19:39:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 38384d54-7149-43c8-af2e-829f9b2e1f21, 'Excellente glace, on sent bien les fraises. Je n''ai pas de sorbetière, le congélateur fait très bien l''affaire. J''ai utilisé du lait concentré non sucré, c''était très bon. Un grand merci à vous.', '2014-05-21T20:38:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, e9df6304-683f-4cfc-a9bf-7f46041248d2, 'Faite avec demi crème et lait et fruits en boîte. J''ai mis seulement 80 g de sucre car les fraises en boîte sont déjà sucrées ! Très bon pour ma première glace maison ! A refaire avec moins de crème et des fraises fraîches.', '2014-04-13T20:48:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, b2ecab9d-0069-44f0-93a5-af30e1f41f44, 'Je l''ai un rien changée ; 15 cl de lait et 15 cl de crème fraiche et 400 à 450 g de fraises : une merveille !', '2013-01-20T16:31:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, e8268b6d-ed09-47a4-a0a3-d65b3ef8255e, 'D''après monsieur, "la meilleure glace à la fraise qu''il ait mangée de sa vie", et ce n''est pas peu dire. L''ajout de la vanille fait merveille et rehausse efficacement le goût, j''ai aussi fait moitié lait moitié crème épaisse par gourmandise. La texture est parfaite, un véritable régal !', '2012-09-23T12:23:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, e56cd27a-7643-4862-ac57-673e0b25da8e, 'DÉLICIEUSE ! J''ai suivi la recette à la lettre avec des fraises de mon jardin, un régal pour petits et grands ! Merci, à refaire encore et encore !', '2012-09-20T13:09:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, a509e1b8-342a-4867-863d-ac80df45a3f6, 'Une glace succulente, pleine de goût, très colorée, et même sans sorbetière très très peu de cristaux.  Je l''ai retenté aujourd''hui, avec la sorbetière. J''ai changé un peu la recette : moitié lait entier, moitié crème liquide, 500g de fraise et j''ai rajouté mes blancs battus en neige. Le résultat est splendide, j''ai obtenu une glace DIVINE, crémeuse et pleine de goût. Je la recommande car elle est simple rapide et vraiment excellente ! Merci pour la recette ! ', '2012-06-21T17:33:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 2eed76a3-902f-4c95-aa4f-fb0b8e7fcf01, 'Très bonne glace réalisée à la sorbetière pour ma part mais la texture manque un peu d''onctuosité', '2012-06-15T22:27:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 5adb5b9a-2ba2-4973-8ad5-312c56888943, 'Très mauvais ! L glace n''a pas pris à la sorbetière ! Je l''ai mise au congélateur et elle était finalement trop dure !  A ne pas faire ! ', '2012-06-15T22:05:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 38a225bb-ee71-4260-83f1-461b5365d404, 'J''ai déjà réalisé cette recette plusieurs fois et à chaque fois c''est troooooooop bon !!! Vraiment facile à faire et succulente ! J''ai mis du sucre vanillé dans le lait car je n''avais plus de gousse de vanille et c''était parfait aussi ! Les enfants adorent et les adultes aussi d''ailleurs. Recette à réaliser sans hésitation ! Miam !', '2012-06-15T20:52:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 114d5262-3a32-4d48-854d-1cbcb5d3c32f, 'Excellente ! Rien a redire, juste parfaite !', '2012-06-01T20:39:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 012d3520-3d67-4766-9fec-cdf2c108ce5c, 'Excellent', '2012-05-31T00:58:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 123f70e0-7704-4e4c-8228-5093875dd60a, 'Première glace que je fais, rapide, facile à faire et résultat..... Elle est super bonne, rien à voir avec celle du commerce. Je garde précieusement cette recette. Encore merci !!!!', '2012-05-15T16:52:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 815eef1c-2cf7-4fea-abf3-f8f2f866e662, 'Comme je n''ai pas de sorbetière, j''ai ajouté 50g de fraises et 10 cl de crème fouettée à la fin, c''est divin !!', '2012-04-29T22:27:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 5d265e52-044a-4f54-8e4a-bb12b4e63849, 'Facile, très bon, très onctueux, parfait.', '2012-04-15T14:06:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, edf2846a-e836-49bc-b5b0-064bd2928b23, 'Je l''ai faite cet été, mes enfants ont adoré, j''ai même ajouté quelques feuilles de menthe et plus de fraises.', '2011-12-01T20:15:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 60bb7a89-1d8d-4877-91bb-4118e05d4ca8, 'J''ai réalisé cette glace hier pour mon fils et c''est un délice ! avec un peu de chantilly maison pour les gourmands, que du bonheur ! merci!', '2011-08-13T07:56:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, e5fea8dd-5963-4128-88b4-ffe2067b6aa0, 'Un vrai délice ! On en refait à chaque fois qu''on reçoit.', '2011-07-31T15:59:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, a03009ec-0f6e-4d20-928a-6eb0c49085ad, 'J''ai ajouté les blancs des œufs montés en neige juste après avoir ajouté les fraises mixées.  Ça donne une glace plus onctueuse. Sinon, cette glace est très bonne ! On goûte très bien les fraises et elle est assez sucrée.', '2011-05-30T11:48:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, f4ee0749-bfc5-43aa-a55d-79e6cf55e318, 'Je n''ai mis que 50 g de sucre avec les jaunes, pour mixer les fraises j''ai ajouté 1 cuillère à café d''édulcorant liquide et puis j''ai aussi mis un peu de crème entière avec le lait pour l''onctuosité. Bonne recette rafraichissante.', '2011-05-13T19:33:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 3ebb79af-150e-4d2c-bc16-4576100a3823, 'Trop bon !!! J''ai mis 150g de sucre en tout et 450 g de fraises. Merci pour la recette', '2011-03-31T11:37:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 930aa963-95b2-40b2-8ef7-c8216d3a0476, 'Miam ! J''ai mis 150 g de sucre en tout. La prochaine fois, j''essaie avec 400 g de fraises pour avoir encore + le goût des fruits.', '2010-06-18T15:20:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 931e5c78-6816-4d4a-8f3f-9e92c2f30f02, 'Simplissime à faire. J''ai mis environ 400 g de fraises et rajouté un peu de cassis et de groseilles. Seul hic : un peu trop sucré.', '2010-06-06T11:44:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 74d7c4e5-a12c-4e31-9ac8-8ca3bdad284e, 'Miam, ça vaut le coup de la faire soi même ! J''ai mis un peu de crème fraîche en complément du lait, et mis moins de sucre car la recette n''est pas cohérente avec la quantité indiquée au départ. Délicieux.', '2010-05-28T10:52:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 9364a18a-ecdc-498c-95ee-f8ccb15af3a4, 'Le top du top. J''ai pris cette recette pour un premier essai avec ma sorbetière en mettant 500 g de fraises. Cette glace n''avait rien à voir avec les toutes faites, c''était bien meilleur.', '2010-05-27T00:49:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, a5fde90c-7df4-436e-90d7-9e847a9b8682, 'Excellent ! On a l''impression de manger des fraises. J''ai juste mis moitié crème liquide, moitié lait entier. Je vais en refaire sans hésiter !', '2010-05-22T17:18:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, ec6ae1c3-aed9-4162-bb5e-0c0e38ae4a7c, 'Très bonne glace, facile et rapide à faire, pleine de goût. Je n''ai mis que 150g de sucre en tout, et ai conservé quelques morceaux de fraises à l''intérieur.', '2010-04-25T18:05:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, e344283d-4f5f-4a4c-a7e6-1924226503eb, 'Tout simplement délicieux ! Nous nous sommes régalés !', '2010-03-31T20:44:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, bfdf7619-60c2-4733-86af-318adccfd319, 'Je n''ai pas de sorbetière et n''avais jamais fais de glace ! Un vrai délice facile à réaliser. J''habite près de Carpentras et on m''avait donné plus de fraises que je ne pouvais en manger !!! Une bonne façon d''en profiter plus longtemps ! Par contre la fraise d''ici étant bien mûre et très sucrée, je n''ai mis que 90 g de sucre en tout dans la recette. Recette à faire sans hésiter.', '2009-06-21T03:42:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 15caa9dc-36d8-4b32-8242-190d1b462c03, 'Parfaite ! Le gout de fraise est bien présent. Délicieux.', '2009-06-01T15:51:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 892f143d-f806-4b8f-9fc3-e98977a5df22, 'Je ne l''ai pas encore faite, mais est-ce obligé de la mettre dans une sorbetière ?', '2009-05-19T22:23:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 6c8bc2e4-5775-48f4-ba94-96089930fcbd, 'Sans être grand amateur de glace à la fraises , même avec moins de fraises (et par conséquent moins de sucre) , c''est excellentissime!!  et rapide à faire si on ne compte pas les temps de refroidissement.', '2009-05-09T17:43:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20996, 36fa0eb3-6ba8-4168-bc0b-aed2682627c7, 'Glace excellente, rien à redire!! ', '2008-09-15T19:58:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168555, 08aceba7-3709-4c1f-9ee5-c13fbb2d38eb, 'J''ai suivi exactement la recette et c’était absolument parfait. Je n''avais jamais fait de charlotte et je cherchais une recette sans gélatine. Je garde cette recette et je la referai. Je l''avais gardé 24h au frigo avant de la servir. Et au moment de servir je l''ai recouverte d''une couche de chantilly maison. C’était vraiment excellent. Tout le monde a aimé même ceux qui n’aiment pas les gâteaux.', '2017-08-15T21:14:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168555, 79385a23-5c3e-4f56-b1d2-965b8f45099c, 'Extra.', '2023-01-05T21:37:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168555, 1cce4adb-aa76-41a0-a2df-7d8dc09a719a, 'Très bonne charlotte, j''ai diminué le sucre dans le sirop et servi avec coulis de framboises', '2014-06-05T00:49:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168555, 317e984f-d984-4efd-bf73-8e0e3092afc0, 'Je l´ai déjà faite plusieurs fois et c´est un vrai délice !', '2013-03-30T20:10:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168555, 3f6715f1-de1e-4ef7-a27f-bce27ff4e023, 'Quand vos framboises sont décongelées, prévoyez plutôt une bonne heure pour réaliser la recette. J''ai du recouper les biscuits et ce n''est pas évident d''enfiler le mélange, assez compact, entre les 2 rangées... J''ai ajouté un paquet de sucre vanillé en plus (acidité des framboises) et du chocolat noir dégustation 70% rapé au couteau. J''appréhendais le démoulage mais nickel en 10 secondes ! Le résultat est super, beau, bon, ça fait son effet (voir photos). Très rafraichissant à la fin d''un bon repas.', '2012-03-03T11:13:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168555, 4884c87f-e48c-4929-a248-f7fd3099930d, 'Excellente recette, j''ai imbibé les biscuit avec de la confiture que j''ai diluée avec de l''eau pour faire un sirop. J''ai servi avec un coulis de framboise.... un vrai régal ! Pour la chantilly j''ai remplacé le sucre semoule par du sucre glace.  Tout le monde a adoré je refais cette recette simplissime et rapide très souvent !', '2011-08-08T12:55:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (168555, 6ab7a402-f2b9-40c7-8101-092aac1e8d5b, 'Très très bon, à refaire sans rien changer, pas trop sucré, pas trop acide, même ma maman qui n''aime pas trop les fruits a aimé ! Merci', '2010-08-14T23:21:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, 6cff7087-88da-48f3-a73c-8c504c1534eb, 'Facile à faire et super bon ', '2023-06-09T20:34:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, 46bf8838-b992-48af-9ffc-e971fd059211, 'J''ai pas mis de menthe et j''ai remplacé le sucre par un trait de miel !  ! Miam miam miam, je le referai !', '2019-01-01T15:04:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, 11365145-a1a8-48eb-a1c2-ccf0506dc3ce, 'Simple et super bon', '2017-05-08T15:39:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, dda335e0-8b8a-4f7b-b6f9-07e39e5dcaa3, 'Moi je mets du lait de soja vanillé, c''est beaucoup plus onctueux !!', '2015-01-08T18:18:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, eef0d997-4909-4e18-a720-8d2d50520df0, 'Très bon, très frais ! Fait avec des fruits rouges. La prochaine fois, j''essayerai d''ajouter une banane.', '2014-03-05T10:52:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, 4edbb716-5a1b-459c-925c-dfc883d9d6cf, 'Très bon. je n''ai pas mis de sucre par contre j''ai ajouté une demie banane pour donner de l''onctuosité. ', '2013-12-09T23:25:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, 38c27b7b-ece1-4a9e-82ae-5c4fe5a072f5, 'Très agréable, frais et léger. Je l''ai testée avec un mélange de fruits rouges bio de chez picard. Et j''ai sucré avec du sirop d''agave.', '2013-07-20T16:22:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, 5b1b7cab-d288-4e7e-a22f-03f9e6675935, 'Très bon, merci.', '2013-07-20T01:13:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, fa5f4f6b-98cd-4440-951e-4becc6da2e3d, 'Parfait ! Merci', '2011-09-20T14:16:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, 58319096-b4d4-4029-a4f4-7b77df2b4b01, 'Très bon et très simple à faire.', '2011-09-07T20:00:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, 15499193-b979-41a2-a101-f1aad386bbd4, 'Mmmmmmhmmmmmmmm', '2011-09-02T22:26:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, dec38ff1-f17c-4910-b6d4-602bea7d0dba, 'Personnellement je n''aime pas trop les framboise surgelées ne donnent pas assez de goût donc on sent trop le gout du lait.', '2011-09-01T19:56:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, e9765f81-c181-4ac2-b2ab-856300b9db9a, 'Si on remplace le lait par un yaourt grec avec un filet de citron on obtient un délicieux sorbet grâce au blender, indispensable ! On peut décliner la recette avec d''autres fruits rouges congelés : myrtilles , fraises , cassis...', '2010-08-25T19:31:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, 185a0b75-cf52-495c-8b35-54d8d6b7b862, 'Très agréable ! Un régal quand il fait chaud !', '2010-05-03T18:15:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, a4961efe-0c2a-4f20-80c3-8b8a05b89a1a, 'C''est très bon, et surtout vraiment léger. Les amateurs de milk-shake plus épais seront sans doute déçus mais pour se désaltérer quand il fait chaud c''est très bien!', '2009-02-28T17:11:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, 6d33c750-ff69-4ec6-98d9-2ce40945574d, 'Pas mal du tout. Mais fait sans feuilles de menthe. J''ai par contre trouvé trop liquide, j''ai donc ajouté du yaourt nature pour épaissir. C''est très bon!!!', '2007-05-17T13:38:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, 9f368801-21d1-4967-bfd6-3fe7aa658801, 'Ça fonctionne aussi avec le mixeur plongeant quand on n''a pas de blender, bien sûr. Idéal car très rapide à faire quand le tiroir "glaces et eskimos" du congèl est vide, et délicieux avec du lait entier !', '2007-05-14T14:08:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23391, 12d3cd32-0a3a-491d-915e-30f20cadaac4, 'J''adore, c''est vraiment très simple et c''est super bon. En plus, ça peut faire un dessert ou un goûter sain. Et si vous mettez des framboises encore gelées, on obtient une sorte de sorbet. ', '2005-03-14T16:31:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 95641eb4-c1bd-4e3b-9162-a997d81222db, 'Très bien', '2023-10-07T17:39:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, d025ee11-663f-44d4-adeb-becc9cffe16a, 'Super avec moins de sucre : 30 g.', '2022-10-12T14:36:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, cf5ddb2a-ab99-4f0c-ba11-2546ed203b84, 'Super facile et très délicieux !', '2021-10-09T10:42:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 3f3d44fa-50bd-4217-aa12-c4ab9eeb561a, 'Je mets la moitié de sucre dans la préparation et je ne mets pas du tout de sucre dans les blancs montés en neige, j''ai goûté et c''était suffisamment sucré, pas de sirop de rose, sinon c''est simple à faire et délicieux', '2021-09-28T16:14:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 915a6b3a-4dd9-4a1a-8d27-8aa4170d2d6c, 'Simple, rapide et délicieux ? ', '2020-09-06T14:00:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, b9005687-808c-4cc8-995d-eb2f108fe207, 'Super bon', '2019-04-09T09:11:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, cdfd9a3e-ca5c-4cbc-b865-bcee4405fe84, 'Excellent ! Recette très facile à réaliser et savoureuse. ', '2016-05-08T21:44:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 8bd0e9b6-6994-4384-9510-3389e44a6142, 'Quelques calories en plus certes... mais pour clôturer un repas, se lâcher un peu pour le plaisir des grands et des petits, c''est la banane assurée !!! ', '2013-08-15T12:16:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, bc7c51de-345b-4b52-8130-aa3019e85153, 'Je fais souvent ce type de mousse au mascarpone,avec différents fruits. Un grand merci pour m''avoir fait découvrir le sirop de roses que je n''avais jamais testé. Ici, utilisé avec 500 g de fraises et de la brisure de framboises, un délice ! Servie avec une tuile aux amandes.', '2013-05-22T22:18:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 71e30641-cfa1-4b66-9a44-b2151359c17d, 'L''été avec les framboises du jardin, l''hiver avec des framboises surgelées ... Un succès à chaque fois !', '2013-05-04T13:08:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, b469b20b-23a0-43c3-84fe-50c197cd6884, 'Très bon dessert ! Je l''ai testé avec les framboises du jardin, j''ai mis 40 g de sucre et des Roudor dessous et sur la mousse pour le petit côté croustillant et les souvenirs de mon enfance... Je conseille cette recette rapide !', '2012-09-15T16:43:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, eadb6055-f5c3-4f9b-8b71-24241c832ddc, 'Au top ! Délicieuse, parfaite, très légère !', '2012-08-01T22:17:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 818681e1-30aa-4056-8136-ac38f11a6707, 'Très bon. J''ai fait des miettes de biscuit rose de Reims dans le fond d''un verrine puis 2 cuillères de soupe de la préparation mascarpone et incorporé des framboises puis ajouté de la préparation de mascarpone et j''ai terminé par un morceau de biscuit de Reims. Par contre je les ai laissé 24h au frais. Au moment de manger il était bien mousseux et léger, tout le monde s''est régalé...', '2012-03-10T18:02:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, c21505d1-7b00-4070-b1ca-25c21b5ff832, 'Bonne recette, fraîche et agréable, qui a eu du succès ! (3 goûteurs) Pourtant, comme quelques autres Marmitonautes avant moi, ma crème était beaucoup trop liquide (je pense que j''ai battu trop énergiquement le mélange après incorporation du mascarpone) mais je m''en suis sortie en épaississant avec de la maïzena. J''ai utilisé des brisures de framboise surgelées. La framboise et la rose se marient bien. Pour la prochaine fois, je testerai bien de nouveau ce dessert avec un mélange framboise/litchi. ', '2012-02-26T15:55:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, ab1515f4-f118-4e7e-b61b-05d4179c8137, 'Excellent dessert. Avec les fruits rouges j''ai ajouté un peu de cacao non sucré. Sur le dessus j''ai ajouté des fruits rouges ainsi que quelques copeaux de chocolat.', '2012-02-12T16:17:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 4229a72d-17a3-40ac-90bb-5849a2158fbf, 'Vraiment très simple, et très bon ! Moi je l''ai fait avec des poires et pommes caramélisées. Le seul petit hic, du coup tout était de la même couleur. Je pense qu''avec des fruits rouges ça doit être plus joli.', '2011-12-18T19:06:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 2e5aeebc-e846-43e3-abf4-427169ddc3d7, 'Au top ! Rapide, léger et bon, très frais et de saison ! Merci ', '2011-07-05T14:50:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, b124cecd-9ed3-453f-a58d-b550565b3f28, 'J''ai essayé cette recette deux fois : j''ai raté la première en incorporant les blancs en neige trop vigoureusement, et me suis aussi retrouvé avec une crème plutôt qu''une mousse (c''était bon quand même). En y allant plus doucement la deuxième fois, j''ai bien eu une mousse. C''était délicieux et très léger, avec une belle complémentarité de saveurs fleuries / fruitées / lactées. Je recommence demain !', '2011-04-30T13:30:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 62418651-f0ca-4de6-894f-1586b132bd81, 'Ratage total! Je n''obtiens pas une mousse mais une crème anglaise! Le mélange à base de jaunes d''œuf/mascarpone/sucre "écrase" complètement les blancs en neige quand on l''incorpore, résultat c''est de la soupe et pas de la mousse! J''ai peut être eu la mauvaise idée de continuer à utiliser mon batteur une fois le mascarpone incorporé....cette recette mériterait d''être un peu complétée. ', '2010-09-26T15:54:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, c23242a1-7c0c-4081-a3db-fab64990d38c, 'Très facile. Peu d''ingrédients. Tout le monde a apprécié. Dans le fond du verre, j''ai ajouté des biscuits cuillers réduits en miette.', '2010-03-14T15:46:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 15472668-96a6-4d98-921d-501e7b4b6184, 'J''ai réalisé ce dessert avec des pommes caramélisées (mars, c''est pas trop la saison des framboises!). La mousse est super bonne, j''en reviens toujours pas ! J''ai pas trop sucré mes pommes et le dessert était divin ! Merci !', '2010-03-12T16:27:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, f2eae281-5039-406e-a474-0238d2a1e2a8, 'Un délice, très simple à réaliser et joli à présenter.', '2010-02-03T19:28:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, f4197d69-ca83-40e2-a1ed-9f0d58d3fc31, 'Dessert très frais et agréable avec ces beaux jours ensoleillés. Le sirop de rose donne un goût très subtil, j''ai ajouté du coulis de framboise. Vraiment délicieux', '2009-10-02T12:57:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, ac7f9e34-53fe-471d-95d1-e0152d7d759e, 'Au lieu du sirop de rose, j''ai mis du sirop de violette, très bon aussi ! Pour le sucre, en effet, je n''en ai pas ajouté dans les blancs en neige et j''ai bien fait car sinon trop sucré ! A refaire avec ajout de spéculoos, miam miam', '2009-08-04T14:05:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, dda1a792-75e8-4d48-add7-c1f06a132ef6, 'Une note de fraicheur à la fin du repas, tout le monde a adoré, je l''ai faite plusieurs fois avec autant de succès. Merci pour cette recette idéale l''été.', '2009-06-27T11:33:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, b6e96d15-1c47-4f24-b803-78fd41a47b45, 'Recette fantastique! je n''avais pas de sirop de rose sous la main et je compte bien refaire la recette avec cet ingrédient. C''est une association de parfums qui me parle ! le dosage du sucre est très bien dans la recette et dépend surtout de l''acidité des fruits.', '2009-03-09T17:36:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, b27eaef6-86e6-4b05-b342-69a3172c0d02, 'Très bonne petite recette, toute simple à faire. J''ai utilisé des framboises surgelées, c''était très bon. Je réduirai simplement le sucre de moitié, ou au moins aux 3/4, comme qqn d''autre l''a suggéré!', '2009-02-19T12:12:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 7625d5c6-d194-4994-9e92-cb588b048588, 'J''ai réalisé cette recette pour la St Valentin et c''était très bien. Il serait pas mal de rajouter des spéculos en poudre pour plus de croustillant...', '2009-02-18T11:53:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 88f92a27-6da7-48c3-a41c-461ef6d4544e, 'Pas mal pas mal. La prochaine fois je mettrai un peu moins de sucre mais c''est super facile et rapide à réaliser. Mes filles et mon mari s''en lèchent encore les babines.', '2008-05-23T01:15:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 7e50c791-138e-4983-ba2a-30a9c5aaf18e, 'Mon ami a trouvé ce dessert très bon, un peu lourd pour moi, j''ai réduit de moitié le sucre, pour le reste j''ai suivi la recette. A essayer avec d''autres fruits. Merci aux cuisiniers qui partagent leurs recettes!', '2008-04-13T11:36:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 2094f8de-6a41-4490-b232-bb61fd4190bb, 'Délicieux, frais et léger après un bon repas. Je n''ai pas mis de sirop de rose sur les framboises et j''ai ajouté des biscuits cuillers dans le fond du verre, préalablement imbibé de sirop de mûre/cassis. Je n''ai pas mis d''alcool car les enfants n''aiment pas. Puis j''ai ajouté les framboises, la mousse de mascarpone et quelques framboises et feuilles de menthe en déco. Les biscuits absorbent le jus rendu par les framboises (surtout si elles sont congelées).', '2008-03-26T13:10:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, f77d1356-ba07-48b7-8ac4-7d94176810c1, 'Très bon dessert et rapide à réaliser, on peut broyer des biscuits à la cuiller et repartir entre chaque couche de framboises et de mousse mascarpone miam ! Miam un délice.', '2008-03-25T16:21:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, d1f71550-a5f9-46d3-8b02-9fd61bf9429d, 'Très très bon, je l''ai réalisé pour terminer un repas d''anniversaire en coupes individuelles avec des framboises surgelees (décongelées au préalable), des palets bretons en petits morceaux et une goutte de coulis de framboise par dessus le mascarpone. PARFAIT!!! ', '2008-01-14T10:01:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 4904d609-c1b3-4929-9cf0-5273daba1cb2, 'EXCELLENT! A consommer sans modération. Même avec des framboises congelées. Frais et léger idéal après un bon repas.', '2007-09-30T16:24:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, faa3b425-7b3e-4b81-84fc-514e812d4104, 'Merci pour cette excellente recette. Ma famille a adoré.', '2007-07-13T15:49:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 2586706d-a402-4302-9ce2-9f99a7a6b0ce, 'C''est super bon, frais et original. De plus c''est très facile à réaliser. Même les enfants peuvent le faire car on n''utilise pas le gaz.', '2007-06-18T12:13:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, a85d3fb8-a349-4feb-a76b-cf95260a81b4, 'Moi j''ai adoré quand tu l''a fait. Délicieux!', '2007-05-19T01:26:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, ed09747f-491b-4525-a814-a50d133f3e7a, 'Un délice très frais ! J''ai également ajouté des sablés au beurre émiettés entre les framboises (sans sirop de rose) et le mascarpone. Sera un must pout cet été !', '2007-05-13T22:20:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, c7573a84-df34-4a82-bb63-2bf836fef0aa, 'Alors là, rien à dire, c''était succulent, divin et excellent! J''ai moi aussi rajouté des palets bretons émiettés sur les framboises avant de mettre la crème.', '2006-12-26T11:19:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, 62c3e7b3-beb3-41d2-8692-f70d6c0ba13a, 'Délicieux et frais! Belle présentation en verrines. J''ai utilisé de l''eau de rose au lieu du sirop... La rose se marie très bien avec la framboise dont elle fait ressortir le goût. Merci pour cette idée!', '2005-05-30T12:44:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, a51a4799-c46a-439d-9063-1c5d56cfb3aa, 'Délicieux. J''ai essayé avec d''autres fruits et quelques biscuits émiettés (type petit beurre ou macaron) par-dessus...', '2005-02-07T22:50:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30578, f357e446-70ab-47e2-910d-78ffb05b4eed, 'Pas léger léger comme dessert... mais vraiment délicieux. Le sirop de rose apporte une petite pointe d''originalité.', '2004-12-10T16:25:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 242478cb-ca49-47aa-be6a-2093fb82e1e1, 'J ai fais quelques modifications : 
- boudoirs au lieu de biscuits à la cuillère car le gâteau se tient beaucoup mieux 
- par dessus un couche de fraises non écrasées avec le mélange citron sucre pour éviter que les boudoirs soient trop mouillés 
- une couche de préparation 
- une couche de boudoirs 
- une couche de mascarpone 
- une couche de fraises 
- au frais au moins 24h 

Le rendu est super joli, se tient à la découpe ', '2023-05-05T16:59:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 537fe1e4-64a0-464c-ae5f-db843a6c397b, 'Trop de sucre. Maximum 70 g.', '2018-07-20T10:06:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 2b11c7ed-1d70-48f0-ad61-39b9b87525ce, 'Il faut remplacer les 2h à l''avance en 24 voir 48h, pour le sucre il faut enlever facilement 100g. Sinon résultat liquide et trop sucré', '2020-06-13T12:43:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 43e614fc-bb0c-4bc8-b6d9-cc62c0e6c9c2, 'Très bon, mais un peu trop sucré et les fraises ont rendu trop d’eau dans le fond. Je réessayerai avec un peu moins de sucre, un demi citron pour avoir moins de jus et moins écraser les fraises et plus de boudoirs :)', '2019-04-28T14:27:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 5c168d92-e543-4389-a247-ffcc7b60a5cc, 'Trop de sucre, 80 g suffisent. J''ai également retiré un oeuf, par habitude. Recette qui fera le régal de mon conjoint, sans aucun doute !', '2019-04-04T15:53:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 25a47b2e-6886-4698-8a2b-03e639b0da4a, 'Très bonne recette par contre, j''ai diminué les quantités de sucre à chaque étape et j''ai laissé une nuit complète au frigo pour qu''il prenne mieux !', '2018-05-12T12:16:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, d84c5bfc-b074-46b6-93b0-dc9f5aaff114, 'Recette beaucoup trop sucrée. J''en mettrais moins dans les jaunes d''oeufs et pas du tout dans les blancs. Biscuits uniquement en-dessous trop mouillés, il faudrait en remettre une couche car trop écoeurant. Déçue', '2020-06-25T09:55:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 3d87efac-0b4b-48e8-b8ce-5f065f4feb97, 'J''ai mis un peu moins de sucre, et au lieu de 250gr de mascarpone, j''en ai mis 500gr, ce qui m''a permis d''avoir une crème plus onctueuse et moins liquide. (et aussi de faire un deuxième étage =D )', '2019-05-23T22:11:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 312ec496-4144-4c2a-a9db-c146384bc92d, 'J''accorde la moyenne car gustativement c''est un tuerie (avec 100 grammes de sucre j''ai suivi vos conseils) mais alors visuellement c''est une cata. Faut le manger les yeux fermés.', '2017-09-25T01:36:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 52ca7cc2-222d-40f0-a411-02b5d2009dc5, 'Très réussi. J''ai cependant mis 500 g de mascarpone pour 1kg de fraises coupées. Mais je n''ai pas changé les quantités de sucre donc en tout 180 g, ni d''oeufs, ce qui nous en fait 4. Ça donne une crème délicieuse qui tient bien au service. 12 h de frigo.', '2023-06-18T00:47:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, ad9f3ede-4247-46fe-ae4b-c2baf6eab43f, 'Une très bonne recette mais je conseille de mettre une heure au congélateur avant de le servir ', '2023-04-16T20:53:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 49f1400f-b5df-4aea-86dd-8d1c66133f54, 'Le liquide n’a pas pris...', '2023-04-16T01:12:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, f8980852-2abb-4109-8f0b-80bfe4262cdc, 'Je mettrai moins de sucre (pas les 30 g de sucre avec les blancs en neige) la prochaine fois, sinon super recette, va avec toutes fins de repas et délicieux. J''ai perso rajouté un peu de marsala...', '2022-04-23T18:41:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 5d25bc58-7003-4820-9eac-616c58433f8b, 'J ai suivi un commentaire qui disait de mettre 3 œufs et 70 g de sucre . Ç était excellent ! ', '2020-05-12T22:39:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 1a2a4251-d7a0-4ee4-9146-ee819741115a, 'J ai suivi les commentaires des personnes concernant la liquidité et le gr de sucre.
j ai mis 500g demascarpone et tenu parfaite 
Ajouter 3 c. à s. de rhum dans le mélange des fraises écrasées.
J ai utilisé 130g de sucre.
Et  j ai divisé les fraises en 2 ,une parties écrasées et l autre laisser en quartier nature.
j ai fais 2 étages, le premier avec le melange des fraises écrasées  et le deuxième avec les quartiers. Excellent', '2020-04-26T22:55:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, a15e1338-a1fb-47cb-b5ca-fa5e80580dc5, 'Trop sucré et trop liquide : déception.', '2020-04-17T13:28:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 0bb1a78d-bb47-4dd7-a1bb-83161e6805a0, 'Trop sucré et beaucoup trop liquide ...', '2019-06-28T10:33:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 42bbf49d-736b-4988-b698-a91b15ccc2f6, 'Recette trop sucrée et trop liquide, je ne la referai plus.', '2019-06-06T13:26:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 10ff8477-89e4-466f-8e7a-cfb2a93fb99d, 'Je ne comprend pas que cette recette soit si bien notée car j''ai suivi et le résultat est décevant, trop liquide, trop sucré et encore je n''ai pas sucré les blancs en neige.', '2019-05-20T14:08:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 01186e31-cddf-4892-9f6f-700b387a882c, 'Juste un petit bémol, un peu trop sucré. A part ça, un vrai délice !', '2019-05-12T04:26:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 47ceb16f-9473-4247-ae88-ea5132424f56, 'Avec des oeufs bien frais, une neige bien mélangée, et toute une nuit au frais c''est impossible de louper.', '2018-06-05T11:07:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 8600fbba-c729-479d-97e9-05148d38a6d0, 'Je n''ai mis que 100g de sucre roux dans la préparation avec 1 sachet de sucre vanillé. 750g de fraises avec sucre et jus de citron. ; la moitié mouliné en jus et l''autre moitié coupée en quartiers que j''ai disposé sur une seconde couche. Le résultat était excellent. Il faut bien évidemment préparer ce dessert la veille pour le déguster bien reposé et frais.', '2017-05-28T20:55:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, ca9dd679-e8c9-46ae-95d8-234bd2eae123, 'C''est pas un tiramisu c''est plus-tôt une bouillie, très déçu.', '2017-05-06T23:59:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 392ff205-40b6-4db2-895c-709b389d3195, 'Beaucoup trop sucré ! Les 4 jaunes d''oeufs rendent la préparation indigeste, sans saveur et masque le gout de la mascarpone (ce n''est pas la recette de l''appareil à tiramisu...!). Déconseillé.', '2015-07-11T23:35:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, ae5ff1cb-8392-49a4-82f1-1657e3d4df97, 'Trop liquide et trop sucré. Un jaune en moins changerait peut-être la consistance ?', '2014-08-08T14:31:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, e21ed392-5a7d-4192-8962-135b31d0853f, 'Trop liquide et trop sucré.', '2014-06-30T20:55:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 2ece5fb2-159f-42f9-8f57-ec9b67aeec9f, 'Recette qui a fait un effet boeuf...  J''ai suivi les conseils, j''ai mis moins de sucre (100 g) et je n''ai pas sucré les blancs.  J''ai mixé les fraises avec le jus de citron et 30 g de sucre. J''ai coupé d''autres fraises en morceaux. J''ai préparé le tiramisu dans des verres à whisky (30 cl). J''ai mis un biscuit à la cuillère bien imbibé des fraises mixées coupé en deux, de la crème, un autre biscuit idem que le premier, des fraises en morceaux et j''ai fini avec de la crème.  J''ai posé un champignon en meringue sur le dessus. Cette recette permet de faire 6 verres.', '2006-04-27T11:42:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 9c9919e5-9858-45e7-ade5-636ad8236732, 'Un vrai succès. J''ai utilisé seulement 100g de sucre, rajouté une cuillère à souep de liqueur de fraises et beaucoup plus de boudoirs, en faisant un grand plat c''était parfait. La règle d''or pour ne pas que ça se démonte, c''est de bien fouetter le mascarpone... Et c''est divin...', '2005-04-10T20:49:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 804f1ca9-f607-4fac-855b-c20462238c77, 'Désolée de saboter les stats, mais la recette n''a pas marché chez moi: les biscuits sont devenus de la bouillie, la crème était semi-liquide... Et pourtant, le tiramisu, je connais! Je vais cependant réessayer en ne mettant que 3 oeufs, et en faisant une couche de biscuit, puis fruits, puis crème, puis re-biscuits,etc. Car de goût, c''était très bon! Ou alors, comme cela est dit plus bas, en coupes individuelles...', '2002-09-09T10:34:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 1cf337c7-91c2-415e-a872-e89a0fa3d5ef, 'J''ai trop aimé', '2023-08-07T22:43:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 2177dc7a-5622-479e-8ff9-743480f1209e, 'Délicieux tiramisu et facile à faire ', '2023-07-01T18:49:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 589a0c37-82ff-416f-b5e1-4beec78bf08a, 'La recette était facile, sauf mes blancs d''oeufs qui étais difficile à faire monter donc j''ai rajouté du citron dans les blancs pour me faciliter.', '2023-05-21T12:53:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 41c88303-11ad-49f9-8e5c-a8b8d1bffeac, 'Excellent ', '2023-04-27T18:28:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 7ec69764-fc32-4f80-b4e9-1d60f72c455a, 'Très mauvaise recette, résultat une crème liquide. Rien à voir avec un tiramisu !', '2023-04-23T13:32:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 4cc54e2b-d7a6-492b-9d90-eced3201e16f, 'C''est une recette qui fonctionne très bien', '2023-04-21T20:47:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 05c46e7e-4890-4b7a-b83d-8a5b8cef1903, 'Nul beaucoup trop liquide plus jamais ', '2023-04-20T20:54:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 524896c4-7925-4152-86ad-8e0714fda7b8, 'Ce tiramisu est délicieux', '2023-04-14T10:45:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 969fa54b-615d-460e-8f2e-18cb9489c38a, 'Ça n''a pas pris. Fait la veille au soir pour le lendemain. Plusieurs heure au frigo. Il n''a pas pris , il était tout liquide ', '2023-04-11T15:44:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, ce98f843-8e1a-44c6-8426-cf0b8b4ad7ad, 'Un vrai délice ! Petite touche de coulis fruit rouge en plus pour ma part', '2023-04-09T22:28:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 82ff6398-571f-41c3-9643-f8990754f29d, 'Texture liquide.. pas présentable.. je ne referai pas…', '2023-04-09T20:06:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, d6c4e90d-7b0c-4051-addb-fec1cb6449dd, 'J’ai remplacé le sucre par du sirop d’agave. 
On s’est régalé 😋', '2022-06-17T18:17:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, a1ea10d7-1799-477f-b36e-6f068f033c86, 'Recette parfaite - c''est frais et savoureux. Toute la famille a adoré, à refaire sans modération ! Pour 6 personnes, j''ai utilisé 4 œufs et 150 gr de sucre', '2022-06-03T21:43:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 31d158ae-e8b3-44b7-b506-6a0c591f630d, 'J’aime', '2022-05-28T18:30:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, daa5dafa-af9d-4a73-b396-da1e7c55044d, 'Ma famille s’est régalé ! Gâteaux super frais et très léger. ', '2022-05-18T09:08:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, d7401229-60c3-474e-b2fd-ea5728f15323, 'Un succès réalisé en version sans gluten ! ', '2022-04-17T18:54:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 3efd4a84-5443-4f56-94cd-b1e5759335bf, 'Super beau et super bon 😋😋😋😋', '2022-02-27T17:46:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, f601cc5a-c805-49e1-97bf-935adcb2ee93, 'Super recette 👍🏻👍🏻👍🏻👍🏻', '2022-02-23T18:35:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 7a4deb4f-ed14-457b-84f2-656bd73d0804, 'Magnifique 🤩. ', '2022-02-05T17:18:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 4de766e5-da52-40e5-a417-d21a1dada70a, 'Vraiment trés bon, tout le monde à aimé, un vrai régal. En plus facile à faire.', '2020-07-02T23:15:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 67458bc1-aa33-41c6-bc4d-77541c934d8f, 'Très bonne recette', '2020-05-31T16:31:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, f2b85210-3548-48d0-abbc-ff4cc165056d, 'Pas vraiment un tiramisu 
J''ai suivi les conseils en mettant que la moitié du sucre, un peu de rhum 
Le montage dans un grand verre à vin (75 cl)
C''est un délice ', '2020-05-30T16:44:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 7e17f9b7-234a-4140-8960-814f98ad62bf, 'Très bonne recette; Ne jetez pas vos queues de fraises; Moi j''en fais un sirop que je mets (une fois froid) sur le tiramisu juste avant de le servir', '2020-05-27T19:40:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 73b3e29f-2bc7-4192-a519-f4ad43219ba4, 'On a adoré, le plat n''as pas fait long feu. C''est un peu liquide donc a faire en portion individuelle pour servir a des inviter. J''ai mis moins e sucre, rien dans les blanc et 100g dans les jaunes', '2020-05-23T20:08:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 9c9131b6-5c3f-490b-b9b8-8744eff5c3d1, 'Très bon mais trop liquide malheureusement !', '2020-05-12T18:11:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 00048289-3b1f-4422-ba43-f44124bd9a69, 'Très bon dessert de printemps. Par contre pour ma part je ne mettrai pas de sucre du tout dans la crème mascarpone la prochaine fois. Je trouves ça trop doux à mon gout. J''ai trempé mes biscuit dans du jus d''orange. Recette validé !', '2020-05-07T15:48:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 7d0de737-0fec-4324-aeff-c2d83eda0431, 'Très satisfaite de ce 1er essai après avoir pris soin de retirer 100 g de sucre pour n''en laisser que 60g (détestant les desserts trop sucrés ! ) et la moitié de mascaporne pour que ce soit plus digeste ! J''ai également choisi de laisser une partie des fraises entières. Je vous le conseille. Le gout est au rendez vous ! A faire et surtout retirez moi tout ce sucre !  !  !: -///', '2020-04-27T21:42:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 4320d4ad-f631-419e-8fcd-daef69f55566, 'J''ai tenu compte des messages et j''ai donc mis moins de sucre dans chaque étape, de plus j''ai rajouté du sucre vanillé et c''est super bon ! Je vous conseille de laisser toute une nuit au frigo pour ne pas avoir un rendu trop liquide. Super recette', '2020-04-18T20:13:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 23f5d8ac-68cf-4a8b-9f59-e5a3c5c88a5d, 'Crème un peut trop liquide pour nous, mais très bon sinon.', '2020-04-15T14:54:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 6996c899-60c1-4b36-bce7-52e658cd3cf4, 'Le tiramisu a fini en bouillie pas présentable du tout. J’ai pourtant suivi la recette à la lettre. Heureusement que c’était quand même bon. ', '2020-03-08T20:37:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14039, 1e28ddd8-0a76-44cd-b04e-428ef47849ed, 'Très facile à réaliser, je préfère diviser le sucre total suggéré par 3 soit 60 gr au lieu de 180. Le biscuit est déjà sucré. On sent bien mieux les fraises et le coulis.', '2019-11-09T23:13:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17382, 24fce8cf-c17f-4fa5-85e4-9cf800c7af75, 'N''ayant pas de fraises, ni de blanc moelleux, j''ai adapté cette recette avec du coulis de framboises surgelé de mon jardin et un apéritif liquoreux (type Pineau, Muscat, ...). C''était très bon.    ', '2016-08-06T15:35:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17382, 27917aec-1278-4a8e-b0ad-310a3f3bd467, 'C''était le dessert de ce midi. J''ai suivi les conseils des autres commentaires, j''ai mis moins de sucre et la prochaine fois je rajouterai quelques fraises au melon.', '2008-07-12T15:57:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17382, 641f5da5-b7c8-42ca-98e1-325f521d599a, 'Un dessert frais, beau et bon. En guise de vin blanc moelleux, j''y ai mis un Coteaux du Layon.', '2006-12-02T17:05:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17382, e5e988d1-d32b-4909-bb94-b63e9f21f668, 'Dessert original et parfait pour l''été. Tout le monde a adoré! ', '2006-07-23T16:43:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17382, 6d9e21db-b1e5-4d78-a678-ba011878f06d, 'J''y ai ajouté de la mangue, et quelques fraises. Délicieux !', '2006-07-13T10:56:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17382, db024c98-c25c-4f6c-8f23-df90c46d491e, 'J''ai également diminué la dose de sucre ce qui n''a pas changé l''excellent goût sucré de cette super recette. 5/5 !', '2006-07-11T14:37:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17382, 9e879b8f-d622-4c38-820e-ba5d7f5f65bf, 'Vraiment excellent! N''hésitez surtout pas à faire beaucoup de coulis de fraise, tout le monde pourra ainsi en rajouter tout au long de sa dégustation !', '2006-07-04T12:41:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17382, 34a322e0-e380-41ed-accd-5870e45c9d23, 'Les fruits étant déjà très sucrés, j''ai fortement diminué la dose de sucre et n''ai finalement pas mis de vin, afin que les enfants puissent également en manger. Grand succès!', '2006-06-28T10:35:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17382, 1ba10575-f519-48c7-be51-1d812c3fbc24, 'Nous avons adoré avec mon mari, mais les enfants n''ont pas du tout apprécié....', '2006-05-08T21:27:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17382, c8530af8-3a0c-4886-aaed-421fde1e71d6, 'Frais, nickel pour l''été et très gouteux. J''ai pris de la cardamome directement en poudre...', '2005-07-02T06:23:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17382, 4a812ff3-7022-41e0-ab68-db9950488f74, 'Excellent! Pas de menthe donc je l''ai remplacé par du basilic. Les coques vides passées au congélateur ont ensuite gardé bien frais le dessert servi avec une boule de glace vanille. Je le referai avec de la menthe aussi.', '2005-06-04T10:51:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17382, 69d154ea-c63c-4ef3-b89d-33c23e6e3719, 'Excellent! J''ai acheté un coulis de fraises surgelé de chez Picard, décongelé à l''avance à température ambiante, puis j''ai mis des fraises fraîches coupées en 2 en mélange avec le melon un peu avant de servir.', '2005-05-30T20:28:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17382, f2afc1de-b5dd-4aae-a579-f8e888392ae8, 'Devenu mon dessert favori! Le ''goût'' du vin disparaît entièrement (si on le laisse bien macérer 2h au frigo). L''alliance avec les fraises est parfaite, mes invités ont léché le plat :-)', '2004-09-12T01:05:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227680, 7fd3d03a-9210-42bf-b566-cec5e8e2bb06, 'Délicieux, je l''ai aussi essayé avec un coulis de fraises au lieu du coulis de fruits rouges. Cela crée un assortiment de fruits, assez agréable.', '2020-02-19T07:32:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227680, 884efc56-f8e5-48e1-8ae2-d0e463fd2aaf, 'Lamoune
Moi, j''ai utilisé du chocolat noir (par préférence), j''ai fait une dacquoise découpée à l''emporte pièce pour en faire un socle et fourré avec mousse de framboises. En fait, j''ai changé un peu la recette, mais quelle présentation!!!! Que des compliments. Ne pas oublier quelques framboises autour du dôme. ', '2018-03-19T03:05:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227680, c102c6b7-7617-4cde-a05f-8e7ecc269775, 'Personnellement j''ai d''abord badigeonné mes demi-dômes de chocolat noir de façon à faire une coque. J''ai laissé refroidir 1/2heure au frigo avant de verser ma mousse. Au démoulage, c''est beaucoup plus facile et c''est excellent. ', '2017-03-05T13:22:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227680, cc5e7410-9ed2-443b-8497-9822bb315e83, 'Succès total auprès de mes invités ! A la place des palets bretons j''ai fait un socle avec 100 g de gavottes et 200 g de chocolat ! Excellent ...', '2016-04-25T15:15:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227680, 79cc72ac-c9b8-4cf1-a664-a50dbe8e533c, 'Trop trop bon !', '2016-01-03T20:23:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227680, b06f8292-6d4d-4f1c-b5ea-fc988e8f7f18, 'Délicieux !', '2016-01-01T16:49:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227680, 21391b50-1a4a-44d3-b14b-ad5d7dcafdc4, 'Un délice', '2014-11-10T22:25:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227680, d6491c74-9a8e-423a-af1c-f74e4d2a6fcf, 'Super recette testée aussi avec une seule framboise dans les moules à pop cake résultat des petites bouchées simplement une tuerie ! Merci.', '2013-10-23T05:12:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227680, e15b7f4f-728d-4cd3-a353-89230e3a2264, 'Idée...super bonne ! Par contre choisir des moules faciles pour démouler.', '2013-10-19T20:40:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227680, 472244ec-2bb6-4c70-a61b-739ee69d1532, 'Le dessert a eu un grand succès a Noël. J''ai remplacé le chocolat blanc par du noir et le résultat était plaisant. Petit bémol, la recette n''est pas très bien expliquée... Sortez les moules juste avant de servir !', '2013-01-02T11:47:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15227, e6db720a-a99c-45f2-85ca-e579785554c5, 'Très bonne et raffinée ! 
Pour la "sauce", je n''ai mis que 2 cuillères de miel, 20g de sucre et 1 sachet de sucre vanillé et le beurre comme dans la recette. C''était impeccable,  tout le monde s''est régalé. À refaire !', '2021-11-14T15:21:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15227, e4ab53d7-e1f7-4438-8030-95403f387d2e, '
Delicieux. J''ai modifié un peu la recette mis seulement 50 g de sucre et un sachet de sucre vanillé. A refaire ', '2021-11-27T14:06:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15227, 9f8b8616-4326-40d1-8896-4d3cb7e23de3, 'Ca baignait dans le beurre dommage.', '2017-10-01T20:38:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15227, a8d24085-504a-40fb-8259-3cb3f0045a86, 'Un rėgal ! Très simple et gourmand. J''ai fait quelques adaptations en suivant les commentaires précédents : - 1 petit pot de compote en fond de tarte - 90 g de sucre dont 1 sachet de sucre vanillé - 100 g de poudre d''amandes et 20 g d''amandes effilées pour la décoration - 3 cuillères à soupe de miel - 4 petites pommes ont suffit', '2017-02-09T01:28:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15227, d19529bb-4f12-4a9d-8fe1-9203b5a1a523, 'Parfait avec moins de sucre ', '2023-02-05T11:55:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15227, 748c67cf-11b9-4017-847c-7b8ad4baca83, 'Excellente, je fais aussi la même tarte avec les poires. Un délice, mes amis me réclament cette tarte !', '2022-05-31T14:52:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15227, b073c0a0-5273-4293-aeb9-f83e08a5bc6d, 'Je mets plutôt moins de sucre. Mais... Excellente !!! ', '2022-03-21T20:43:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15227, 052733d0-c274-4aaa-beaf-98af2342963d, 'Une façon originale et simple de préparer une tarte aux pommes Il faut toutefois impérativement pré cuire la pâte feuilletée et réduire la quantité de sucre. J''ai pour ma part mis davantage de miel (3 cuillères à soupe et 40 g de sucre).', '2017-08-09T19:59:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15227, 9de2e760-de3a-40ad-8622-7b4613de9fca, 'Le mélange miel, pomme et amande est succulent. Seul hic : le fond de la tarte n''était pas cuit. C''est dommage. Il faudrait cuire davantage la pâte à blanc.', '2007-03-31T12:27:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15227, 60da3253-e98d-4987-9519-62987f8ce0e6, 'En diminuant le sucre de moitié, c''est très bon', '2025-09-21T21:19:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15227, 6bccf40d-06b1-4312-bf4c-8c735cb2f59b, 'Délicieux', '2025-09-19T18:11:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15227, e08a35a7-5b30-44cf-b8f7-506c4a1d7f1d, 'Moins de pommes ( 4 ou 5 maxi) Moitié moins de sucre, le reste c''est bon ?', '2023-10-31T16:50:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15227, 9d406b25-e2c1-41a4-b08f-39e750cbb6b4, 'J''ai mis le four à 190, 40g sucre cassonade, un délice, j''avais pas de glace vanille ni de chantilly dommage.
On peut y mettre des pépites de chocolat.
Choisir des pommes bien sucrées si on réduit le sucre', '2023-10-21T21:40:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15227, cdb50044-3234-4878-a913-c4177785f39b, 'Super 😬', '2021-12-17T12:21:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15227, b29d11fa-bb8b-4b28-ad0c-80e472cc2d92, 'Un régal ', '2021-12-03T18:25:45+01:00');
