INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 2138010b-07c4-42ce-93c5-8916121b550c, 'Si on laisse le temps indiqué à 210°C, le contenu a perdu son moelleux, et le dessus n''est pas gratiné. Je suggère donc moins de temps dans le four et un coup de grill supplémentaire. Pour le goût : 5/5 !', '2019-03-24T11:00:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 1d29f20a-ace9-426e-b7f1-aa523f3ed521, 'Très bonne recette.', '2019-03-18T20:12:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, a2c89a5d-2a77-4804-b0e6-eea669861fa9, 'Très bonne purée.', '2019-03-11T07:34:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, fbccf1ab-2b75-42f9-a566-e85cc890d19d, 'Super bon, joli aussi ! La prochaine fois j''essaierai de faire des boulettes avec le mélange.', '2017-11-02T12:23:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, a2b723c5-0229-4316-a389-7905ee7763fc, 'Un pur délice ! ', '2016-04-20T15:52:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, fc887d2d-2162-4feb-a5aa-e029642783ed, 'Préparation un peu longue mais résultat délicieux, j''ai remplacé le fromage râpé par du parmesan, merci pour la recette !', '2016-02-16T22:24:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 2447453f-224c-4b2b-bd94-ef75f4450204, 'Très bonne recette. Comme vu sur les commentaires j''ai ajouté un peu de cumin en plus de la muscade. Et j''ai également saupoudré de chapelure sur le dessus du gratin. ', '2015-12-01T17:18:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 30a2b991-a0f2-4f14-be55-45bfba62e041, 'Très bon mais n''ayant plus de gruyère j''ai mis de la chapelure. Excellent !', '2015-10-10T21:28:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, e2613d4f-9042-4892-bd72-4f5bbd90b20c, 'Très bon plat fait et refait, toujours apprécié. J''ai remplacé les oignons par des blancs de poireau. ', '2015-05-15T21:24:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 7acf564d-f720-4796-a43e-7c3e9274b78f, 'Bonne recette.', '2015-01-17T22:27:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, c49725b4-b1b8-4a7e-9a66-c0c407244363, 'Excellent plat, mon homme et moi même nous nous sommes régalés, c''est bon et léger, à refaire', '2014-11-17T23:00:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 25bec591-cfea-4656-a016-e8024cac59ce, 'Très très bon, elle a eu un énorme succès... On m''en réclame déjà alors elle n''est pas encore digérée', '2014-07-14T16:33:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 70cb6110-9dbb-42cd-9892-ca958242efdd, 'Très bonne recette, qui tient bien au corps. Parfaite pour la pause de midi lors de longues journées de bureau ! Et elle reste très bonne, même réchauffée.', '2014-03-26T20:09:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 678f5770-fb3d-4bb1-a86a-a6dc3d76f27d, 'Il n''a fait qu''une soirée..!!!', '2014-03-07T13:05:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 202329c0-7d65-4544-8f1c-70b4e5bd8e4b, 'Tout simplement très bon...', '2014-02-14T21:09:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 065a6fb6-af1b-4400-b32c-e925ed61d304, 'Recette réalisée avec carottes fraîches, et pommes de terre du jardin. Excellent comme repas du soir (légumes sans viande), le fromage (gruyère râpé) se chargeant de donner le goût au gratin.', '2013-12-26T21:20:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 5bf88de8-3b22-4232-b5a8-cca5a591dcda, 'Très bon gratin, rapide à faire. Mon fils de 3 ans s''est régalé.', '2013-12-01T19:57:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 13c6182d-52d0-4e40-90c9-518bf981a32c, 'Trop bon, ce petit goût d''oignons rend le tout extraordinaire. A refaire très vite !', '2013-08-04T18:55:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, a06a8822-7cbc-40ce-8df3-e02a4ffe7d8c, 'Très bon, léger. Tout le monde a aimé.', '2013-06-04T20:40:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, b7984e58-5eda-4527-85a8-0a9c3c2ced0f, 'J''avais une petite appréhension et j''ai été agréablement surprise!!! Très bon ! Seules les proportions sont un peu limites! J''ai mis plus de 500 g de chaque légume et ce n''était pas suffisant...à mon goût!', '2013-03-26T22:30:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 08598a19-33da-4f7a-905a-813a48ba79ab, 'Très bon, facile et à refaire.', '2013-03-17T18:08:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 5b0e8ee6-5c4f-4281-b01c-e2ab59c4efde, 'Plat sans prétention mais délicieux avec ce petit goût d''oignon (je n''en ai mis qu''un seul). A refaire.', '2013-02-10T19:46:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 85833781-f354-41f8-b0ac-64cf6dfb8d77, 'Très bonne recette facile à faire... Un régal dans l''assiette tout simple... A refaire sans hésitation. ', '2012-12-12T16:40:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, c06d3d67-f352-4b28-996e-99636476287a, 'J''ai ajouté un blanc de poireau et enlevé les oignons. tout simplement délicieux !', '2012-11-30T22:53:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, c8a8b7b3-b41d-423c-92d1-82959e093c45, 'Très très bon ! Facile à faire et permet de faire manger des légumes aux plus réticents !!', '2012-01-03T14:34:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, b34ecd9d-ce8b-48be-a8ff-32e472984546, 'Délicieux et vraiment simple ! J''ai eu la main un peu plus lourde sur le gruyère pour plus de gourmandise...', '2011-12-06T18:56:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 7f4ecb3c-ed59-4f5b-8b03-25a748c6112f, 'Très bon !  ', '2011-08-02T13:16:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 19474637-62b2-4c59-9ad2-f7da9a62fc91, 'Dé-li-cieux ! et très facile. ', '2011-07-17T23:46:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, ec0c8745-c760-495f-9248-fa742478f27d, 'Très bonne recette, je n''ai pas mis d''oignons et même le petit a adoré !!!', '2011-04-18T22:26:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 3d95dd3c-117e-48ab-aa92-a813986f2ff4, 'Très bon! Ça change un peu des purées "classiques". Ça fait déjà 2 fois que j''en fais et nous n''avons pas été déçus.', '2011-03-21T13:56:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, c719f755-cc55-4be8-b410-233c3ed7c50b, 'Recette suivie à la lettre, on a adoré. Merci !', '2010-12-31T14:44:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 737b5f5a-b986-4483-826c-be18c149ea93, 'Merci pour cette recette, rien à redire. Je l''ai servi à mon mari et mon fils : ils ont adoré. Maintenant mon fils de 4 ans mange des carottes !! ', '2010-08-16T10:06:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, c29abc71-7ad3-4e92-81cb-cda272fc434d, 'Cette recette a fait notre bonheur ce soir. Je la mets dans mon carnet ! Merci.', '2010-05-28T00:13:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, cf8cd128-c25e-4a56-b1cb-5712e7523cbc, 'Super, tout le monde adore et l''écraser à la fourchette est bien meilleur qu''une purée lisse !', '2010-05-10T10:17:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, cb4de5e8-26dc-4ca4-8fb2-061ba8131f6e, 'Excellent. N''ayant pas de carottes je n''ai mis que des pommes de terre. Tout le monde a adoré.', '2010-03-15T10:38:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, ee36afef-5df3-424b-aafc-a88aa0588b2a, 'Excellent ! J''ai suivi la recette à la lettre et c''était parfait. J''ai présenté le gratin dans des mini cocottes individuelles. C''était plein d''effet, la recette a beaucoup plu. ', '2010-01-17T16:24:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27529, 47f505fc-860d-44a0-bd06-c258a5129b73, 'Très bon, une petite touche de lait pour le lien et c''est top.', '2009-12-07T21:22:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 2c788cac-704d-44c2-a673-268f867bcebd, 'Très bon gâteau ! Ça fait plusieurs fois que le fait avec quelques modifications de mon côté à savoir que je remplace le sucre blanc par du sucre de coco que je divise par 2 pour les quantités et il est parfait 👍🏻', '2023-11-12T11:46:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 5b0719f5-0026-4939-beea-8589fb7681df, 'Ça fait des années que je fais ce gâteau tous les dimanches car tout le monde l’adore , par contre pour la crème je divise les quantités par 2 ', '2023-04-30T13:36:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 94d1278b-54d3-4125-8a8e-03fb9300805e, 'On me le réclame, alors je le fais ! Mais en diminuant le beurre et le sucre et c''est délicieux ! ', '2023-03-25T09:33:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, f8249a92-c45c-42ef-bfd7-c932622bc8ac, 'Parfait! Le croustillant du dessus, tellement bon! 🤩', '2023-03-18T16:29:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 15cc9558-0e66-463d-8c26-c9250f935631, 'Délicieux gâteau et facile à faire. J’ai également diminué les quantités de sucre : 70 g pour le gâteau et pour la crème et seulement 60 g de beurre pour la crème.', '2022-11-17T15:58:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 7dae2b69-451e-48b2-8f6b-3e95fc6469e2, 'Bonjour, j''adore ce gâteau, mais il ne monte pas très bien...', '2022-10-23T11:16:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 79ab2e26-314a-420a-b6dc-df021abf613e, 'Super bon ! Je double la pâte en mettent juste 120 g de sucre roux. Je mets aussi du sucre roux dans la crème, c''est meilleur. Et ce gâteau s''appelle une bourdaloux ! 😊', '2022-10-15T19:13:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, c05ff72d-16a3-421d-b34e-e885877b1814, 'Très bon !', '2022-09-10T13:50:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 2f052d16-8582-4105-a692-d9527f77cf0b, 'Pâte très liquide et une crème super sucrée. Le résultat est bon, mais trop sucré', '2022-06-29T22:38:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, f8a5ab07-3bd9-4ef5-bcc0-f38a25d41ff7, 'Vraiment délicieux.', '2022-04-23T16:50:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 885b33a8-bf7f-44fc-b876-ec4ee3b57e4c, 'Peut-être un petit peu trop sucrée à mon goût ', '2022-01-17T17:44:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, 5823a237-ae7f-4e17-813c-8fa76d623512, 'Excellent. Je mets néanmoins de « crème » sur le dessus.', '2020-01-24T11:29:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32133, f74d3732-c440-4fcc-ac37-846185203395, 'Bof bof le gâteau ne lève pas et un peu trop sucré. Je cherche toujours le croustillant. Et quelle est l''utilité des 3 pommes alors qu''une seule suffit.', '2023-10-28T12:16:56+02:00');
