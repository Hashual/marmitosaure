INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 2ef8fb3a-fe8c-464f-812c-a87f9b380e7b, 'Trop bon !', '2020-08-14T19:03:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 68188e53-7a39-4a3d-9685-c691ba9681e2, 'Très bonne recette ', '2020-07-25T14:30:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 376195d2-8a85-4a0d-bf34-d3f3ce6d93ab, '1e fois de ma vie que je fais une tarte. Elle etait succulente ?', '2020-07-21T17:27:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, f78349e0-5b77-4b5a-884e-67f78a255652, 'Très très déçue! La pâte est fade et la crème pâtissière est insipide! De plus la recette est très très mal rédigée! Bref une recette a vite oublié!!!', '2020-06-07T08:36:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, e2c00c8e-a3f3-417b-a5d7-1df34c666eaa, 'Crème pâtissière largement insuffisante il faut doubler les quantités ! Mais résultat très bon ? ', '2020-05-30T15:08:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, ada4e67b-36fd-4ef2-989b-239324466b04, 'Pâte brisée faite au mixeur. J''ai moi aussi fait le double de  crême patissière, rigoureusement avec les jaunes d''oeuf, pas les blancs. La prochaine fois je préparerai le fond de tarte et la crème avec plus d''avance pour que les 2 soient bien refroidis avant le montage, trop tiède la crème s''est répandue au 1er coup de pelle à tarte, mieux le lendemain après un passage au réfrigérateur mais dommage pour la pâte qui forcément a ramolli. Fière de ma 1ère tarte aux fraises 100% maison malgré tout. Excellente (ne pas lésiner sur la qualité des fraises), pas trop sucrée et jolie avec des myrtilles en déco dans les interstices. Un grand merci, je referai.', '2020-05-19T01:04:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 7a317014-9a38-4ce3-b49c-0ac8efccb99f, 'Excellente tarte, faite avec de la farine de seigle, faute de blé T55 dispo. . J''ai ajouté 50% des ingrédients en + pour la crème.', '2020-05-13T18:49:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 4a82fcf2-fe64-49ec-88ab-d7c0ee4aec85, 'Très bonne recette, très facile à réalisée malgré que je ne suis pas du tout douée pour la pâtisserie !
J''ai fait néanmoins quelques modifications... J''ai fait ma pâte avec de la farine de châtaigne, je n''ai utilisée que 25 cl d''eau et au vu des commentaires j''ai doublé la crème pâtissière et il fallait bien ça. Par contre pour moi, le tout était un peu trop sucrée, j''en mettrais moins la prochaine fois. ', '2020-04-24T20:05:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 7096b0c2-f986-487a-bb07-1d1418a4f544, 'Excellente recette, mais il faut doubler la quantitée de crème et elle sera parfaite', '2020-04-20T00:14:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 6d7109b9-23d1-4459-82af-84d5fd739fb8, 'Top,à la belle saison toujours autant de succès ?', '2020-04-11T18:19:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 5512e0fe-0a46-4318-8e03-f3b27bb90bcb, 'Validé par la street !', '2020-04-10T00:16:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, c905ad3e-6d8e-46a7-845b-4f394ccb8f68, 'Recette exemplaire, j’ai juste doublé les doses pour la crème pâtissière.', '2019-05-26T06:24:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, f613f9c4-c6bb-429a-a45f-7095ab9a1ae4, 'La quantité de crème pâtissière est insuffisante ; les fraises ne s''enfonçaient pas. J''ai donc rajouté le coulis d''une autre recette Marmiton : mettez sur le feu de l''eau et de la confiture (d''un fruit rouge au choix comme la framboise, le goût est harmonieux) et parsemez ce coulis sur votre tarte terminée. Mais merci pour la recette! ', '2008-10-16T21:45:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 7b54efa2-04bc-4dce-b4d5-7123aa464902, 'J''ai utilisé une pâte feuilletée toute prête cuite à blanc 20 min. Crème pâtissière: 25 cl de lait, 2 oeufs, 75 g de sucre, 1 sachet sucre vanillé, 15 g de farine. Faire bouillir le lait salé. Travaillez, au fouet, les sucres et les oeufs. Incorporer farine et lait bouillant peu à peu. Reversez dans casserole et cuire doucement en remuant avec une cuiller en bois jusqu''à épaississement. Laissez bouillir quelques instants sans laisser attacher au fond de la casserole. Etaler la crème refroidie sur le fond de tarte, mettre les fraises coupées en 2 (préalablement sucrées) et napper de confiture de fraise préalablement réchauffée. Excellent.', '2006-06-08T23:37:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 3b37bd32-0b10-4990-90e6-a57aa2ebccac, 'Super recette 👍🏼 c’est la deuxième fois que je la fait et tous les avis sont favorables. Pâte sablée simple a réalisée par contre en effet pour la cuisson il faut les 25 min, je ne l’ai laissé que 20 et elle n’était pas très bien cuite au centre. J’ai vu dans un commentaire de doubler les doses pour la crème pâtissière c’est ce que j’ai fait et c’est vraiment la bonne quantité je trouve 👌', '2023-08-09T12:53:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 4cfd49ac-ca4e-4141-a4af-664d339d9158, 'Personnellement j’ai doublé et même triplé la crème pâtissière suivant la taille de la tarte. Et je coupe et sucre les fraises en salade en premier, afin d’avoir du jus que je verse sur la tarte à la fin . Hummm !
', '2023-05-07T12:56:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 4617c526-3b2f-4af1-98a0-b1c359d54a29, 'trop peu de crème pâtissière avec les ingrédients indiqués mais très bonne tarte quand même', '2023-04-29T17:10:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 71383fdf-d0ea-4403-9556-40ab17d119c5, 'La pate du sablé etait un peu liquide et en ajoutant de la farine nickel. La tarte etait un délice merci pour la recette je vais la refaire tres vite', '2023-04-26T18:39:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, b1418f69-f77e-48fe-bc35-bd88cec5dc94, 'A éviter à tout prix, la pâte est irréalisable,', '2023-04-23T17:32:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 03105141-2720-4b4a-9bfb-53971bdfe8e0, 'Très bonne recette, que je referais la prochaine fois, cependant je pense que pour 6 personnes la quantité de crème est juste. Je pense augmenter les quantités par gourmandise 😋', '2023-04-22T17:09:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, e7e7494c-0266-4003-b524-d32ce6660dc0, 'Très bon, j’ai remplacé une partie de la farine par de la farine de châtaigne 
C’était excellent ', '2023-04-21T19:01:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22726, 0e17e67d-2b31-4da1-89d4-c4ce94c9d51a, 'Trop bon!! Avec des fraises bien sucrées un régal!', '2023-04-20T11:42:13+02:00');
