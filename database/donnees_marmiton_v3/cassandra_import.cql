INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, c85b7e89-4038-4d9d-931e-35a3ecf60910, 'Une excellente recette, je gagne du temps et le résultat est identique en battant les œufs en omelette ! Temps de cuisson à revoir 40/45 m, th 200', '2022-06-19T08:12:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, fac123e1-e6e5-46e1-a125-043739f96b45, 'C’est la meilleure recette de cake au citron! Facile et très bon! Il suffit de suivre la recette à la lettre.', '2022-05-07T19:32:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 139b6638-761d-4ccf-97f5-cb95c2ac0ddb, 'Super cake ma famille a adoré mon père veut que j''en refasse et ma mère en a repris', '2022-02-18T17:07:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22823, 3302e939-4971-483a-8813-f8c434e125d3, 'Ce n''est pas une salade de fruits!!! Il faut des quartiers d''oranges et citrons à macérer et c''est tout. Si vous mettez une pêche ce sera pour parfumer. Ajouter avant de servir, de la limonade ou de l''eau pétillante (la moins salée possible ).  ', '2016-07-03T18:40:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22823, 89ffdc8c-63f1-4a67-ae95-a36d5e73b903, 'La banane c''est pour le rhum, en tout cas c''est pas vraiment l''espagne. Effectivement, on fait macérer les fruits, le sucre, le vin, en revanche pour ce qui est du gazeux, on le verse juste avant de servir. Sinon, depuis la veille, quel intérêt de mettre quelque chose de pétillant...  Le lendemain, ça ne pétille pus!', '2004-08-27T10:10:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22823, f35ac37c-261f-4117-b3e3-51d92be103b2, 'C''était un régal.', '2013-03-23T17:37:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22823, c1bc0ccf-431c-49ca-a272-e59098ff5521, 'Pour nous ça manquait un peu de goût fruité malgré tous les fruits, peut-être manque de macération, on verra demain !', '2012-08-01T15:51:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22823, fe4f7c3e-6669-4f85-b205-ba341ea603f5, 'Excellente recette! Elle a fait sensation.', '2005-06-12T23:44:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22823, acb5fce0-5190-4910-bcad-f5f38167794a, 'Excellente. Bien parfumée et fruitée. Le lendemain, c''est encore meilleur!', '2004-09-06T16:27:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22823, 7c62b19a-aca9-46e4-9b48-7a471f569ece, 'À consommer après quelques heures: elle n''est plus pétillante mais gagne en saveur. Vraiment un délice!', '2004-04-19T22:38:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22823, 7fceb700-ff97-4aec-9cce-844440a54fe7, 'Pour tout les amateurs, c''est délicieux!! Bonne dégustation!!', '2004-04-03T15:49:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22823, f60f22d4-f642-45db-9001-f1357dac1eda, 'Je préfère sans sucre. Très facile à faire... et en plus, si rafraîchissant!! Pour l''été, c´est idéal!', '2003-06-20T13:48:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22823, 9416dc4a-adf2-4605-a13f-98b0b3ca4f5b, 'J''ai ajouté du vermouth. Bien assorti de fruits. Un délice à boire... et à manger!', '2003-06-11T16:31:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22823, 9751d94f-95bb-49b0-b9f0-694d600a7f86, 'Pas terrible et trop de choses...', '2003-06-10T15:17:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22823, 73b09354-1d6d-4eb6-a21d-146c693ca823, 'Le porto ne fait pas partie de la recette originale.', '2003-06-10T14:57:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36933, 60426173-48d5-40d4-a093-1611c1741844, 'J''adore, la pizza est excellente je le recommandé à tous !', '2015-05-06T16:54:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36933, baa08b37-7e3a-4e96-b640-a466e65487e0, 'Original et excellent. nous n''avons jamais mis les arachides et je trouve que le cheddar donne un goût trop salé. ', '2014-06-15T10:41:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36933, c00da231-2c93-43eb-b228-25b54b79518a, 'L''originalité de la recette m''avait attiré et effectivement je n''ai pas été déçu !! Je la conseille à tous les amateurs de saveurs exotiques. On pourrait même rajouter de fines tranches de piment vert pour les plus téméraires.', '2012-03-18T20:36:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36933, 6c81769b-ab8d-4aaa-8cc1-46eda466e2d3, 'Bof. C''est assez spécial.', '2011-11-10T05:00:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36933, a7487aa7-9835-4a11-8815-0d32c75909f9, 'J''étais très sceptique (je l''ai même fait lors d''un souper quiches, avec plein de monde mais je fut agréablement surprise. le goût est original et plait aux amateurs de nouveaux goût. Petit bémol: plus de préparation et de vaiselle que d''autre pizza', '2007-08-22T00:47:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36933, 75a3016e-877d-4224-9caf-6c207051410c, 'Très bon! Je n’irai pas non plus jusqu’à dire que j’ai trouvé ça fracassant, mais mes invités étaient dithyrambiques, donc merci pour eux ! J’ai remplacé les arachides par deux cuillers à soupe de beurre de cacahuètes délayées dans la réduction de lait de coco, et j’ai aussi utilisé des bouchées de poulet tikka auxquelles j’ai ajouté un peu de citronnelle hachée. Faute de cheddar, j’ai saupoudré le tout de fromage de brebis râpé!', '2006-11-27T13:32:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36933, dd2fffc6-b803-430d-80b1-7cb95fb4ef36, 'Cette pizza est tout simplement délicieuse!', '2006-06-01T21:14:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36933, 2121cdff-ded4-4f3e-b4ea-e3cd21c00a38, 'Très bon et original. ', '2005-09-04T14:26:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36933, f2d88f38-8dca-4a91-9381-eb084717b4d4, 'Bravo, très bon !', '2005-06-08T12:19:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (314805, 5ec2b174-e360-498a-bbd5-cc4155f57f47, 'Très bon et très facile, merci pour cette recette!', '2023-04-10T15:56:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42840, 92b71e92-49ed-45ce-ad12-ef23c16b68a5, 'Excellent, on s''est régalés', '2020-04-29T20:07:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42840, 9f9b4e15-1dd8-4d9b-812c-092e44bc3d41, 'Au départ j''étais sceptique, vu les ingrédients; à l''arrivée un vrai régal, finesse des goûts et légèreté du biscuit. à refaire sans hésiter !', '2015-09-20T18:20:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42840, 3b7fe115-d611-4006-93d2-30350165e215, 'Une recette pas mal. Mais vue que je n''avais pas de noix, je n''en ai pas mis mais c''était bon comme même ! merci', '2014-10-06T19:58:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42840, 8abfeab7-0fc7-4598-9ec5-ae8f48d646b4, 'Excellents, avec farine classique, et mélange muscade, cannelle, gingembre et clou de girofle séparés. Plutôt pressée je n''ai pas fait revenir les bananes. Ils étaient parfumés, moelleux, et le croquant des noix leur apporte le petit plus qui leur vaut la cinquième étoile… à refaire', '2014-05-19T00:32:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42840, 0dc5d7c8-ddc5-418c-960c-024ba7a26d44, 'Vraiment excellent, rapide à faire ! Je m''en suis déjà fait deux fois cette semaine. Rien à redire à la recette. J''ai juste mis moitié noix, moitié noisette et c''est très bon aussi', '2014-02-15T18:00:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42840, f2df216e-8043-437c-b9b0-2e6a2f6ea7a8, 'Excellent ! Ils ont disparu en un rien de temps ! ', '2010-03-14T18:50:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42840, 773752b5-fe2f-42c8-9f8f-a5fbbe6b1c3d, 'Excellent ! J''ai fait avec de la farine normale et du lait demi-écrémé, et c''était vraiment très bon ! Mes muffins n''ont pas fait long feu, j''en ferais + la prochaine fois.', '2009-08-25T17:29:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42840, fd4c9264-9da8-410b-a766-6b73d52fb710, 'Excellents! De vrais muffins qui me rappellent le Québec.. Très bonne idée que la farine complète cependant, j''ai utilisé du lait 1/2 écrémé et pas de 4 épices. 40 min mini au four. C''est vraiment divin !', '2007-02-08T12:42:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42840, 561cdf38-e811-4d8f-9adb-5a4b54ab8e29, 'Très sympa! Avec de la farine normale et du lait demi-écréme... c''était terrible! Moi qui n''aime pas la banane en gâteau, je suis agréablement surprise... A faire et à refaire ab-so-lu-ment!!!', '2006-03-17T12:17:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21606, dfb3483c-3f95-4e04-ab08-a6ac84c9ee7c, 'Miam🍌', '2023-09-30T09:37:50+02:00');
