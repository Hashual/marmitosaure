INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 63710565-3869-4188-863a-64df570ecebe, 'J''ai juste mis moins de sucre. Excellente recette; super simple et rapide à réaliser. Très, très bon. ', '2022-06-10T21:13:23+02:00');
