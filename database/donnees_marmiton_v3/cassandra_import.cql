INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, dffd7cc5-7514-4092-ae4b-aac56064f5ca, 'Vraiment très bon, mon copain a adoré à refaire !', '2016-02-01T23:41:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, d0f29a7e-989b-41c9-8976-9ec673943f80, 'Excellent ! Pour la cuisson, j''ai mis 30 min à 180°C et 10 min de grill.', '2016-02-01T00:17:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 78374ce4-457c-4cc4-83fa-7804107b6e95, 'Rien à dire, trop bon ! J''éplucherai les pommes de terre avant de les cuire la prochaine fois ! Merci pour cette recette.', '2016-01-29T21:28:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 7d867928-b501-47f5-905d-e87531833c7a, 'Facile à faire, très bonne recette. J''ai remplacé moi aussi le jambon par des lardons fumés, un régal ! Merci.', '2016-01-29T15:11:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, d53c1c36-39b5-46df-9de2-30a889611401, 'Un peu fade mais super bon !', '2016-01-27T20:41:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, e96e3c33-b968-4f32-8947-a4776428f9cd, 'J''ai adoré, j''ai mis des saucisses de poulet (ne mangeant pas de porc, j''ai pris ce qu''il y avait dans mon frigo).', '2016-01-12T01:10:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 48dbcd17-ff7a-47ee-ae76-0cadc734f3ac, 'Un régal! j''ai mis des lardons à la place du jambon. ', '2015-10-17T09:59:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, a1317575-ae4c-45ce-815b-0ac9c223c186, 'C''est bon mais j''ai trouvé mes pommes de terre assez sèches. J''ai utilisé 4 tranches de poulet. J''ai bien senti la moutarde. La prochaine fois, je pense que j''utiliserais des lardons et je cuirai mes pommes de terre à la vapeur.', '2015-10-16T12:22:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 54ee53d2-86da-4e77-94f8-e752b10ea513, 'Je ne suis pas une habituée des gratins, mais la.. rapide, facile, délicieux, vraiment rien à dire !! Miam !', '2015-09-30T22:11:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 3ec6d83a-ce39-4131-be41-8611d1aa5488, 'Très bon !', '2015-08-15T22:07:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, 0913b2e8-ee8b-4fd6-924f-22a461cea46f, 'Facile et rapide à faire, mais tout le monde n''a pas aimé', '2015-05-11T00:23:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, aca713c5-7e0c-4953-b376-cd0b05ac32a3, 'J''ai mélangé la crème fraîche avec le jambon, les oignons et le gruyère râpé. C''était vraiment délicieux.', '2015-03-13T18:10:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16638, ee8f34ed-0b9d-4bd8-9b61-a49a93cdb1f5, 'On a adoré et j''ai rajouté du persil ', '2015-02-07T11:50:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 17b752d8-a4db-45a0-9b87-2b01120e6a6b, 'Très bonne recette. Par contre j''ai ajouté 2 pommes pour 4 personnes et 2 magrets. Pour la cuisson des magrets je conseille 7  à 8 min à la place des 10 min sur la 2ème faces. Pour les pommes : je les ai d''abord fait cuire dans de l''eau bouillante 2 min et avant de les servir je les ai fait revenir dans une poêle avec un peu de sucre et de marinade afin de les caraméliser un peu', '2014-02-23T19:03:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, c0cc1c63-9892-4867-b677-2d63189bb21f, 'Extraordinaire ! J''ai caramélisé les pommes à la poêle avec de la cannelle et servi ça avec un gratin dauphinois pour le duo... depuis moi et ma copine on en rêve la nuit au moins une fois par semaine !', '2012-03-21T21:10:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, df41b853-1cbc-4587-93c9-379fb32d27e2, 'Recette exquise, cependant j''ai apporté quelques modifications. Au lieu de mettre la viande au four je l''ai fait cuire à la poêle avec un peu de la marinade. Une fois la cuisson bien avancée, j''ai ajouté les pommes et je les ait laissées caraméliser avec plus de marinade. Trop bon, ça a remporté un franc succès auprès de mon homme qui pourtant n''aime pas trop le salé-sucré.', '2008-08-23T17:26:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 4da9a4d8-3295-4e0a-844e-6c2a6ce2b6d7, 'Cuisson parfaite, le mélange miel soja se marie très bien au canard.', '2021-12-25T18:34:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 41f326cd-2f1b-49d4-bca0-9cb2be9987da, 'Tres bonne recette qui permet de faire évoluer le magret au niveau gustatif.', '2013-07-08T16:32:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 63f4618e-f016-4f1d-b412-7dcaaaff690c, 'Merci pour cette succulente recette !! J''ai fait caramélisé les pommes, et servi ça avec un écrasé de pomme de terre, un vrai délice !   Par contre les quantités sont un peu justes.', '2013-01-06T14:53:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 61fac12c-c53b-437d-ac7a-88d04fde7d43, 'Une recette qui est devenue un de mes musts, qui fait ma réputation de bonne cuisinière ! Une petite variante (je ne suis pas bretonne pour rien), c''est de cuire les pommes et ainsi les caraméliser, c''est délicieux... Merci pour la recette !', '2011-11-27T17:58:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, ead5c223-bcef-493f-92a7-a142a934cd76, 'Excellent, surtout accompagné d''une purée maison, pour jouer sur les deux pommes.', '2011-03-27T00:35:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 618f361b-feae-4781-b25d-ca3e1b9beebd, 'Ben nous on a pas trop aimé ... mais tout est question de goût ... En revanche la cuisson des magrets au four est extra ! Bonnes fêtes à tous  ', '2007-12-28T00:27:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 0216b2d8-1e9e-4216-88ad-b37df1c1265f, 'Excellent, j''ai fait revenir les pommes dans du beurre et surtout ne pas mettre de sel, le soja suffit !!', '2007-05-14T20:11:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, a8fb90ef-483e-4979-a69b-f6ba3dc889ec, 'Dé-li-cieux! J''ai utilisé un mélange mi-soja fort aux champignons mi-soja léger. La cuisson rosée est parfaite. Avec 2 pommes par personne, l''accompagnement est assez conséquent si le repas est complet par ailleurs.', '2006-12-14T22:32:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 4929a859-0355-40d7-8cb1-053e0365f985, 'Excellente recette ! J''adore le mariage canard/miel et avec la sauce soja, ça casse un peu le côté sucré/salé de la recette pour ceux qui n''apprécient pas trop ce mélange. Mes invités se sont régalés ! En accompagnement avec des pommes de terre, un régal !!!', '2013-01-25T16:19:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 4595abb6-36f4-4fb3-8855-029f4878332c, 'Extra ! J''ai suivi la recette à la lettre, nous nous sommes régalés ! ', '2012-05-22T21:36:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 9f0c0336-5435-4967-a8c6-9c4605b2de5e, 'Tout simplement extra ! Rien à changer ! Moi qui ne suis pas fan de canard, j''en redemande.', '2010-04-18T14:15:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, f28ba9f2-0dd8-48c4-a8f1-dfb9e9a56986, 'Excellente recette ! Le mariage canard/pommes est très léger. J''ai mis du riz en accompagnement. C''était parfait ! A faire et à refaire, merci pour cette recette !', '2009-08-29T15:42:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, deec626a-6771-41c8-ba38-755e27006830, 'Excellente recette, rien à redire. ', '2009-01-25T12:57:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 0da218bd-532e-4efa-8943-12166f42737b, 'Très bonne recette, effectivement je n''ai pas salé mais avec la sauce soja c''était suffisant. Le mariage miel canard pommes est curieux mais j''aime découvrir des saveurs nouvelles, par contre, mes ados ont moins apprécié...', '2009-01-24T10:58:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 2e62f536-e19a-4c81-b99f-5306a97d8e1c, 'J''ai déjà fait plusieurs fois cette recette. Dès que les beaux jours apparaîssent, je cuis les magrets au barbecue. Pour cela, je coupe les magrets en deux sur la longueur et je les pique sur des brochettes avant de les faire mariner. Succès garanti! Et je confirme: pas de sel!', '2008-05-30T15:10:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 28444290-e699-41f5-ad44-9cce77856466, 'J''ai déjà fait cette recette plusieurs fois, et à chaque fois je remporte un franc succès... Plus on laisse mariner le magret, meilleur il en est!!!', '2008-05-08T18:36:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, dd47354d-1983-4540-8de9-75a2ff9e5b9f, 'Recette vraiment terrible!!!! On pensait à la déco à apporter, on a fini par y rajouter un flan de courgettes.  Motivez-vous c''est vraiment excellent!', '2007-03-21T14:41:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, befec77e-f07d-4489-90e7-031907d4322b, 'Nous n''avons pas aimé car ce plat n''a pas beaucoup de goût. Nous avons par contre mangé toutes les pommes que je n''avais pas épluchées et cuites dans une poêle légèrement huilée.', '2007-02-16T10:46:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 2c143a15-7fb2-4e9d-a6c2-b1a29d7b7d33, 'Recette originale et si simple à réaliser ! Nous nous sommes tout simplement régalés. J''ai suivi le conseil des internautes et je n''ai pas mis de fleur de sel. A part ça, rien à redire !', '2007-01-27T16:47:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 1e634018-e2ef-4621-a40b-22da5e38de2c, 'Excellente recette, nous nous sommes régalés! Moi, j''ai donc cuit les pommes à l''eau comme indiqué, mais ensuite je les ai mises dans le four avec les magrets pour les 10 dernières minutes de cuisson.', '2006-12-26T11:14:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, e22a99ec-dc32-43bf-ac61-2c85b0611847, 'Excellent. J''ai fait à ma sauce c''est-à-dire pas de pomme mais des échalotes qui ont confit dans la sauce de la marinade (hum...). J''ai rajouté 1 peu de vinaigre balsamique mais avec mon four au bout de 30 minutes, il était toujours cru! J''ai donc fini à la poêle. Le gôut, très fin et subtil, est délicieux mais en effet pas de sel.', '2006-12-16T10:56:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 2732a286-12b6-45b9-bff6-c61ef6a0cc55, 'Vraiment excellent! Le mélange pommes/canard est délicieux. Cependant, comme certains l''ont dit, saler ce plat est inutile. Merci pour cette recette!', '2006-11-20T19:08:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, a05bf8ce-8d69-4718-ac87-433f4949e767, 'Pour éviter d''avoir soif toute la soirée, ne salez pas durant la cuisson, la sauce soja est suffisante!', '2006-10-15T17:44:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 4a8bb916-4955-4908-bb2c-4ed909f06cd0, 'Un zeste trop gras et sucré. Il faudrait trouver un moyen d''enlever le gras quand cela cuit (et caramélise) car c''est très lourd.', '2006-10-01T09:36:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 0a0a0847-a4b7-4cdc-b8c8-aa0803cf4e21, 'Excellente recette et si facile à réussir. Rien à changer, si ce n''est que je n''ai pas ajouté de sel: la sauce suffit amplement.', '2006-08-12T16:59:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 04b6bd9b-51cc-4073-9042-c124c8dbf603, 'Un régal, accompagné de quelques pommes de terre...', '2006-07-19T02:39:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 0d026af4-f5a3-441f-b7bd-5df5e70a9851, 'Très sympa et simple à réaliser. Les pommes juste pochées accompagnent très bien le magret, la sauce se marie aussi parfaitement. A refaire!', '2006-06-09T12:28:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 9a9dc563-95fb-4cc5-a151-6daa9d23a7b9, 'Très, très bon. Le canard était succulent et l''alliance canard-pommes, très harmonieuse. Un vrai plaisr pour les papilles !', '2006-05-28T02:52:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 898ae8d9-767b-45c5-998d-9416ff6b7257, 'Du vite fait, bien fait mais qui a l''originalité de la saveur ! Pour 2, un magret suffit mais il faut un peu plus de marinade !', '2006-05-25T18:59:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 4687f079-e850-4155-b591-f9fbd8babbad, 'Très bon, je n''ai rien changé et tout était parfait. Très bonne idée, les pommes.', '2006-05-24T19:14:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 2a0ccc86-8301-4538-ac21-58b53dc27bdc, 'Délicieux! Attention la sauce est très salée, et avec des pommes au beurre, c''est encore meilleur!', '2006-05-17T21:15:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 323ab335-213b-4793-915c-762106d209ca, 'Excellente idée pour "parfumer" les magrets de canard, cette marinade est très subtile, toutefois il ne faut pas rajouter trop de fleur de sel à la fin, le soja salant déjà pas mal ! Le temps de cuisson est parfait, et le mariage avec les pommes est judicieux !', '2006-04-24T11:53:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 83ba54b7-4482-4dea-a0ff-948d820f2480, 'Super recette ; Le magret mariné est très tendre et change du magret poêlé ; j''ai quand même rajouté des échalotes dans la marinade. A refaire d''urgence... ', '2006-03-27T20:05:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 530ec543-df70-4e5b-b188-c7911ff578fc, 'C''est délicieux tout le monde s''est régalé, j''ai rajouté du gingembre râpé et du coriandre haché à la fin pour une note exotique... réussite assurée !!! ', '2006-03-26T13:27:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 4e7c6b1a-9c36-4690-bd4e-4ea54e860c69, 'Vraiment délicieux et original. La sauce est succulente, j''ai simplement remplacé l''accompagnement par des pommes de terres cuites à la vapeur au lieu du riz.', '2006-03-22T16:01:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 2a2b9038-c208-4bbf-8fbe-a30d496c8d7e, 'Un vrai délice! J''aurais pu en manger encore et encore!', '2006-03-07T11:49:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 0d445d69-55cd-4e69-abd1-ea04fc1098d3, 'Rapide, facile et délicieux... pour changer un peu du simple magret poêlé.', '2006-02-28T13:04:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 07fb7b5a-6b9b-4302-b4b0-6528a3168e5a, 'Très bonne recette, le goût assez prononcé de la sauce soja se marie très bien avec la douceur du miel et des pommes. A tester absolument.', '2006-02-25T10:03:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, bca3d5a6-0969-4fd0-b665-d0709ca888ad, 'C''est génial, facile à faire et un vrai régal!', '2006-02-23T18:25:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 4e4d7c68-c5f3-4674-939f-74d600772cf9, 'Excellente recette. Rien à ajouter.', '2006-02-16T15:50:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 873f0308-015e-49b3-b75c-2a365daa8c7a, 'Excellent, avec légumes wok et riz basmati, bravo le succès était au rdv!', '2006-02-15T11:05:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 79f1cd6f-d7a3-46a9-948a-8420f98556ad, 'Bonne recette et simple à réaliser. J''ai accompagné ce plat de pommes de terre.', '2006-02-13T17:54:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 682ebe40-5862-4361-be1a-581e4920378e, 'Excellent et épatant! J''ai fais cuire les pommes et des pommes de terres à l''eau, puis disposées dans le plat de cuisson en les alternant. Temps de cuisson idéal. ', '2006-02-02T09:37:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, c1c695db-3df5-4661-8c89-7a24b0489169, 'Très bon! Accompagné de pommes de terres sautées à la graisse de magret, pommes cuites à la vapeur et confit d''oignon (faire revenir oignons ajouter sucre + couvrir de vin rouge et un peu de vinaigre balsamique, laisser réduire/épaissir)', '2006-01-05T21:02:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 1ba64125-3a64-4f13-b8a1-f1a6e6edac60, 'C''est de saison, j''ai donc essayé cette recette avec pour accompagnement des coings...FORMIDABLE!!!... Les cuire à l''eau aprés les avoir épluchés, épépinés et coupés en tranches. Les faire revenir dans du beurre, ajouter la sauce au soja-miel et les caraméliser en fin de cuisson avec de la cassonade. Le petit goût acidulé des coings est une merveille pour les papilles, un régal avec les magrets...', '2005-10-20T01:36:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 2681a6f1-ff5a-4798-913c-8039d84c858c, 'J''ai essayé avec des cuisses de canard à la place des magrets, c''était très bon. La viande était tendre, la peau avait pris un aspect un peu caramélisé. J''ai rajouté un peu de calvados dans ma sauce. Rapide, simple et bon!', '2004-10-11T11:09:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 34d628d3-6110-461c-88e3-0bf85c480279, 'Recette très appréciée. J''ai préféré remplacer les pommes en accompagnement par une purée maison (évite le ''tout sucré'').', '2004-03-22T19:42:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25053, 8ca125bc-f1a2-4b0c-8a83-465603041bc6, 'Succulent!... Par contre, j''ai ajouté à la recette des poires coupées en morceaux, cuites au beure et caramélisées (divin!). Je remplacerais les pommes par les poires et aussi, pourquoi pas, une mangue, également cuite au beurre et aussi caramélisée...', '2003-12-01T20:57:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 9e88445b-efdf-43c9-a0f5-c64339a5e824, 'Je mets juste du sucre vanillé pas de sucre et c est tres bien comme cela. Les fruits sont assez sucrés. ', '2023-08-10T10:32:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 20768d78-15e5-47dc-bea0-75dcf7432cbd, 'Très agréable, parfumé et léger. 
J''ai ajouté un peu de zeste de citron frais. Fait avec des framboises surgelées,  donc cuisson 1h à  180°.', '2022-06-24T13:13:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 374adbb2-fbc8-4e54-8632-777eb48af9ef, 'Après 55 minutes de cuisson, rendu parfait et dessert délicieux. À refaire très vite !', '2021-06-21T14:00:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 6e05fcdf-8a6b-4e0a-84a5-f72dc264d947, 'Avec moitié moins de sucre, 1 cac de vanille liquide et 55 minutes de cuisson à 180 degrés c''est excellent ! ', '2020-04-21T00:16:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, decdad44-5ee5-4f65-91e1-88adc4203465, 'TB avec 6 oeufs, poudre d''amandes à la place de la maïzena et moins de lait (25 cl).', '2016-07-10T23:05:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 482c3f01-6a60-44e2-8f6b-1a6d2eded9f3, 'Délicieux! Je trouve ce dessert meilleur lorsqu''on le sert encore un tout petit peu tiède...La pâte du clafoutis est meilleure ainsi!', '2008-03-08T21:47:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 7225f109-9764-42fa-b91c-bba193cf2084, 'easy and delicious recipe', '2023-07-31T17:04:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 938d614c-749d-428f-ac9d-d90729ed9fcd, 'Excellente recette , réalisée avec un mix de framboises congelées et fraîches . Cerise ( framboise ) sur le gâteau : recette SANS GLUTEN ! Merci ! ', '2023-07-15T14:47:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 01f91914-d3ee-4737-af5a-9debb2c2cc42, 'Parfait ', '2023-06-28T20:45:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, ee39dcf4-af54-4b29-a59e-26e9b43deffd, 'Excellent ', '2023-04-24T13:38:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 458dd14f-91fa-4a6e-8dad-652ee7a13269, 'Super !', '2022-07-24T14:15:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 429d56ad-6a78-4d15-8366-06959a1f81c5, 'Super bon, à refaire - Merci -', '2022-07-02T13:48:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 07c61ba7-a47b-46a2-8ee0-ccb7c54ddb77, 'Excellent dessert! Bien frais, parfait pour terminer un repas surtout par cette chaleur. ', '2020-06-25T20:47:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, c65d918c-e457-45dd-bc36-4a455d475f9a, 'Super, par contre avec framboises congelées, 1h de cuisson.', '2019-12-27T08:20:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 8b240b0b-5c8f-4c84-b76b-b093c868d301, 'Excellent !! Je mettrai un poil de sucre en moins la prochaine fois sinon rien à redire juste 3 oeufs.... j''avais peur de l''eau des framboises surgelés j''ai laissé 5 minutes au four en plus à refaire !!', '2019-09-03T10:07:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 960663f4-bd87-49cb-8c5e-b1a6f69908b5, 'Délicieux clafoutis qui a fait l’unanimité de mes invités, merci pour ce partage, bonne fin de journée. Recette publiée sur mon blog aujourd''hui.', '2017-10-09T18:23:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, aa24dd94-ad09-4258-b730-911655583423, 'Très bonne recette. J''ai fait en ramequin individuel. Trop bon.', '2016-10-07T21:43:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, fe60a294-16e6-4728-a6e7-9b1a3d4d7f31, 'J''ai fait mon tout premier clafoutis avec cette recette, et ce fut un grand succès!! A refaire avec d''autres fruits peut-être... J''ai utilisé des framboises surgelées et j''ai laissé cuire presque 1h à 180 degrés dans un four à chaleur tournante. Le résultat se tient bien après refroidissement, et c''est un régal!!! Merci', '2016-03-13T11:42:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, db85e79b-1122-48fa-95c9-8cf202f99799, 'Excellent !!! J''ai mis l''équivalent en œufs entiers (donc 6) j''ai remplacé 1/3 de maïzena par de la poudre d''amandes et j''ai mis des pommes en guise de fruits : un régal .  Un gros + c''est que cette recette est conseillée dans un régime sans gluten : très important à noter pour les personne concernées ', '2015-09-28T18:51:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 7d967642-1266-43e3-8b79-8302562b860e, 'J''adore c''est trop bon !', '2015-09-19T15:19:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 69073111-e842-4fdc-8d12-b106da60e925, 'Excellent ! Je la fais avec des fruits rouges surgelés c''est hyper bon !', '2015-08-14T15:53:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 9feb715b-dcd8-4e79-9009-d11a738d4d83, 'Excellent clafoutis ! ', '2015-05-17T04:04:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 4075300b-4ad1-483d-8511-13202f5cf483, 'Excellent. J''ai aussi laissé cuire 20 minutes de plus. ', '2015-03-15T00:42:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 1fb2e39b-6c8f-4996-be91-314b4680303e, 'Un délice. Fait avec des framboises décongelées. Par contre, le temps de cuisson était beaucoup trop juste. J''ai laissé au moins 20/25 minutes de plus à cette température.', '2015-02-16T11:35:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 6665f9a3-1043-4058-9d1e-711c4fdf859c, 'Très très bon et facile à réaliser. A la place du lait, j''ai mis une boîte de lait gloria 1/2 écrémé. Plus léger.  ', '2014-10-18T20:35:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, e712bfbd-9145-4174-9256-ce5da288fd8c, 'Ce clafoutis est un régal ! J''ai juste ajouté quelques gouttes d''amande amère.', '2014-09-28T15:29:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 1d4358e4-e343-47be-9726-0d42d1806067, 'Superbe recette, résultat délicieux !', '2014-08-07T13:04:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 6a4073b0-4eee-4117-b0c2-d370e98d6d08, 'Super recette, merci !', '2014-07-28T18:23:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 498d0e6a-e768-4424-9045-dd9fe7487498, 'Super bon, à refaire ! ', '2014-05-05T19:18:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 754c2a66-0dfd-4584-b3bd-92495c77e227, 'Une tuerie !! Meilleure recette de clafoutis ! Je la garderai comme base c''est sûr !!! Quelques modif: j''ai mis 20 cl de crème de coco, 10 cl de crème fraîche et rajouté de la noix de coco râpée sur les framboises .... délicieux !!!', '2014-05-04T21:39:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 5bef9e04-9391-48af-9116-d3c97989e596, 'J''ai doublé les doses pour en faire pour une vingtaine de personne et ça a eu un succès fou. J''ai fait cuire plus longtemps mais je pense que ça dépend de l''épaisseur et donc de plat.', '2014-01-01T16:15:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, fac00a1b-6b61-45f9-89c3-1c6016dccb53, 'Très bon.  ', '2013-11-17T15:55:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, bd004c3f-ba30-421b-bc13-070f4b52e0b2, 'Trop bon et facile à faire, j''ai juste un peu réduit la dose de sucre, et pour le temps de cuisson 10 minutes de plus comme pour les autres internautes.  ', '2013-07-17T20:59:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 3fb612f7-5666-4f49-9ea5-171aac6efa58, 'Très bonne recette, mais temps de cuisson insuffisant avec des framboises décongelées. J''ai laissé cuire 1h.', '2012-10-01T23:52:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 79b36d98-8fb9-472b-921a-f4a6a7f1e9d7, '10 min de cuisson en plus sont indispensables et j''ai pour ma part ajouté encore 5 min plus fort pour dorer... et là, c''est un sans faute !!', '2012-09-20T00:06:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 7e9fd090-47d9-4a14-8f90-75eb419886c0, 'Clafoutis très bon ! Excellente recette ! J''ai juste ajouté 10 minutes pour le temps de cuisson ! ', '2012-06-06T20:02:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, e17523d0-dd97-4a4c-ab7f-fe36c6ed30d8, 'Très facile à faire et excellent, difficile de le rater.', '2011-08-25T13:12:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 16e58b1f-8b80-4653-bd8b-686e29633103, 'Tout le monde a adoré. J''ai saupoudré de sucre glace en servant. Pour la cuisson, compter au moins 10 min de plus.', '2011-06-20T00:06:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, e6c45862-63e7-460a-97a3-ea123516cd65, 'À refaire ! Les framboises congelées, ça donne aussi un bon résultat.', '2011-06-06T15:26:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 9a42911d-8c2b-46c1-bbdf-6718c3f2c6e2, 'Oh, il est extra ce clafoutis !!! C''est le meilleur que j''ai jamais mangé !', '2011-04-28T12:39:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, a1fdf153-e185-42df-9ba8-e672928da780, 'Excellent et facile !! J''ai juste ajouté un peu d''alcool... (Kirsch ou alcool de framboise)', '2010-12-15T10:24:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, d1e23b4d-e3a5-4057-bc4d-d17ecc2ae982, 'Délicieux et très facile à faire. J''ai remplacé la crème fraîche par du fromage frais pour alléger et j''ai fait cuire dans des ramequins individuels. Je les ai préparés la veille et ils étaient très faciles à démouler, je les ai présentés dans une assiette avec une boule de glace à la vanille et des framboises fraîches.', '2010-08-16T13:25:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 1ebe9179-bf87-4555-84eb-85c9a4c8c3a2, 'Excellent en plus avec les framboises du jardin, sauf que j''ai remplacée la crème par du fromage blanc ! Un vrai délice, il a rencontré un franc succès au travail de mon homme', '2010-08-04T13:56:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 50a9b8fb-27f6-486d-bed0-628255e3272f, 'Beaucoup de succès pour ce savoureux clafoutis, la deuxième fois, j''ai mis moitié framboises et moitié cerises : le mélange a été très apprécié !', '2010-06-28T13:49:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, c1de1238-47dc-4ea8-b2e0-68a5c8a4248d, 'J''ai fait ce clafoutis pour une fête "familiale" et mon regret est de ne pas en avoir fait plus (j''avais fait 2 plats pourtant): certains invités n''ont pas eu le temps de le goûter tellement il a eu du succès et d''autres en auraient bien repris. Rien à dire, c''était excellent!', '2009-10-14T20:34:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 48d152fc-0c15-4681-9a10-e077c9c1155c, 'Un dessert facile et très apprécié des petits comme des grands. A faire et à refaire en variant les fruits.', '2007-11-17T11:46:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, 74744c3c-839b-4962-9f4d-9f624807fd0d, 'Léger et succulent surtout avec des framboises fraîches du jardin!', '2007-09-22T16:26:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, c0b5a803-7c66-4bc5-8d31-c40954588b55, 'Dessert très apprécié et très facile à faire, Délicieux', '2007-09-17T19:54:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29849, ab9737f0-3547-4f50-91d5-cb2c57a3b79a, 'Il faut juste mettre moins de sucre ; de plus vaniller votre sucre vous même pour ne pas en rajouter un sachet. A faire aussi avec d''autres fruits.', '2007-09-09T16:37:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44189, 7b240f66-eea9-411c-b9db-436f233937c9, 'Très bonne recette, je l’ai fait à la fraise et à la mandarine avec des sablés de retz ', '2020-12-27T21:03:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44189, eb5ad471-dd18-424e-a88b-28b840476567, 'Suis très déçue. La bûche ressemblait à de la glace en paillettes. Immangeable.', '2014-11-06T22:59:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44189, cda68ab7-2177-471b-8ec1-c33e125b6bd5, 'Super bonne. Long à faire car beaucoup d''étapes avec de la réfrigération entre. Mais pour un résultat parfait. Succès assuré le soir du réveillon !! servi avec un coulis de framboise. au Top !! ', '2014-01-12T12:20:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44189, ac8c2e1f-e6e6-4e11-a5ed-e2742ce9b376, 'Très facile et très apprécié !', '2014-01-02T07:14:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44189, 58efbcf5-c31a-411c-bc80-2b0dd924bc18, 'Je l''ai faite plusieurs fois l''année dernière, et mon fils (4 ans et demi) me la redemande cette année. Très facile et légère à la fin d''un repas, on peut adapter les parfums de glace comme on veut. Pour une version sans protéines de lait de vache, j''ai remplacé la crème fraîche par de la purée d''amandes et ajouté un jus de citron. Gros succès pour un moindre effort ! ', '2013-12-22T00:04:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44189, 2634666b-b3e1-4a0c-a39b-9aaf5ee612a8, 'J''ai essayé en remplaçant la glace chocolat par de la glace vanille ! C''est délicieux !', '2013-11-23T17:46:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44189, d2928957-5d5b-485b-8d68-1193cafaf022, 'Très facile et très bon', '2012-12-30T00:44:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44189, 745ebc31-1ca3-47ee-b43a-0ff0990d096f, 'Rien à dire, vraiment parfait !', '2012-02-18T16:07:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44189, 4ad3606f-a8f8-426e-8ba2-c53e4ed04675, 'Très bonne. Le moule à cake doit bien contenir 1,5 L d''eau, il est sûr que lorsque la glace ramollit elle prend moins de place, mais lorsqu''on la remet au congélateur, elle prend à nouveau un peu plus de place.', '2008-01-17T16:27:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44189, 99271c10-f372-4eac-8384-15f202f55504, 'Belle présentation mais assez long à faire finalement (plusieurs étapes) et pas d''une saveur très originale.', '2008-01-01T08:47:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44189, 0fcf5f46-bb00-43ca-8680-97934881b929, 'Très facile à faire et super bon. Tout le monde a adoré, et après un bon repas, c''est idéal car pas lourd.', '2007-12-28T19:13:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44189, 8d75c273-2022-4da7-bc85-7d78f39bf9f9, 'Idée géniale! Cela permet de faire sa propre bûche avec les parfums que l''on aime et sa propre déco. Merci pour l''idée.', '2006-12-22T08:14:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 3c66b6ab-e36a-4321-8118-a32595db46a2, 'Délicieux
', '2021-09-06T16:19:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 993e278f-66a2-48db-9a3f-f9594cdaff1e, 'Bonne recette, mais très sucrée. La prochaine fois, je mettrai 100 g du sucre au lieu des 200 g.', '2023-01-08T20:59:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 2d0c8235-fc8b-4911-b47f-fda58762794e, 'Très bon et rapide !', '2022-10-16T15:37:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 2cd35935-327d-4022-93cf-ff3aa6426c76, 'Mon copain raffole de cette recette, je dois en faire une fois par semaine ! Je caramélise les pommes pour le rendre plus gourmands', '2022-04-13T17:17:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, ba56a22a-8980-4e00-92bd-bef5e151edde, 'Très bon. La prochaine fois je vais tenter de faire un peu cuire les pommes pour qu''elles soient plus fondantes. ', '2021-11-21T09:36:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 142dfd96-c20c-448e-966a-2605697932c6, 'Recette super mais temps de cuisson pas adapté. J’ai fait cuire 40/45min chaleur tournante à 180°C bien plus cohérent ! :)', '2020-05-31T20:34:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 9203a36e-e2b4-49e3-8314-12e1aec0e039, 'Superbe recette, tout le monde a adoré. Moi j''ai mi 2 pommes, 1 poire et un peu de cannelle. Je la garde dans mon cahier de recette pour la refaire !', '2011-03-04T13:49:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 9d69c5fa-1852-4a27-bd9a-478bf116aec7, ' Ça ne cuit pas très vite ', '2023-05-20T14:27:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 4802fa71-044e-427c-950f-70ad67d6e2e4, 'Super bon. Je recommande !', '2023-01-22T18:14:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 3a5ba9b4-127f-4667-80de-bf707efaee82, 'Parfait.', '2021-06-27T11:04:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 71cb26b6-b724-4c4d-8a03-213a71caf40b, 'Parfait ', '2021-02-10T16:16:23+01:00');
