INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28919, c01095da-d584-4150-9eb3-de87db0d6318, 'Un régal, pas compliqué à faire et qui fait son petit effet sur la table !', '2022-05-15T21:05:36+02:00');
