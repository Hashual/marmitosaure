INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, 2b3059a4-7b26-4765-9ec7-0c392110e9d2, 'Un régal qui change. ', '2015-02-09T19:08:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, c05afbb8-2512-490f-b77b-2cbf9970b82d, 'Recette au top ! J''ai simplement ajouté de la poire à la banane. Parce que mon chéri est fan de poire  ! Attention simplement à ce qu''elle ne rejette pas trop d''eau. ', '2015-02-09T17:54:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, a32064e3-d82d-4385-a7ff-6e758ead3d1e, 'C''est bon', '2015-02-09T02:59:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, 6decf390-31d1-4624-938f-f9c4f0c66e15, 'Miammmm... Délicieux je n''ai rien changé de la recette originale, merci', '2015-02-04T21:18:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, 6deac33e-e612-4d8b-b003-0edf39f604e5, 'Parfaitement parfait !', '2014-11-05T20:03:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, ee8cd156-5385-40d8-9d03-991b4a1cd235, 'Super croquant, tout le monde a aimé, j''ai mis de vraies pépites de chocolat au lieu de la tablette !!!', '2014-05-18T22:02:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, da051748-4259-4065-9916-074ade3c48c5, 'J''adore, trop bon, et super simple à faire.', '2013-06-07T17:47:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, 03f94003-170a-4e3c-b732-ca11120a2bfc, 'Trop bon ! Super facile à réaliser et ça change de celui aux pommes... A refaire sans hésiter !', '2011-10-27T21:06:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, bfa212be-7521-4a3f-9367-abcf9de68a21, 'Très bon. Je l''ai fait plusieurs fois et tout le monde a adoré.', '2011-05-21T15:55:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, d5083cfb-06ae-4a58-b2f6-6edebe3629ff, 'Très très bon ! J''ai mis 70g de sucre et la moitié du sachet de sucre vanillé. Pour les pépites de chocolat, je les ai râpé avec un couteau sur une planche à découper. Tout le monde a adoré !! ', '2010-08-29T17:49:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (348087, d482ae64-3342-408e-81b3-42b541ea7cdf, 'Bonjour, super bon !', '2022-11-26T13:59:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (348087, 0f6a8d6c-b9c7-463d-b4a0-438c89955c70, 'Très parfumé et léger. Cela mérite bien la patience pour dépiauter la pulpe de citron et d’orange ! Je garde la recette dans mon carnet.', '2019-10-24T10:07:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12140, dabee868-1ba6-46b8-984f-b49bb63eff16, 'J''ai utilisé un filet de porc mariné au chipotle pour faire cette recette, il était assez épicé et je dirai que c''était parfait dans le plat. Par contre, je n''ai fait cuire que 40 minutes, c''était bien assez, la viande se détachait à la fourchette ! Je n''ai pas mis de poivron ni de banane, question de goût personnel. Je ne sais pas si cette recette est vraiment indonésienne mais elle est bonne et elle possède assurément une certaine saveur exotique! Les pousses de bambou sont croquantes, les épices bien dosées et c''est en soit, un plat assez santé !', '2012-06-23T01:01:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12140, 18e693d4-20b0-44ff-8097-e8b859c41011, 'Un régal !! Mon homme a adoré et les enfants ont dévoré ! A la place des tomates, j''ai tout simplement acheté une boîte de tomates pelées concassées. Un délice !', '2010-11-12T21:26:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12140, b184a207-d884-435b-9f48-91a13ee2897f, 'Un délice... Il est vrai que l''on ne retrouve pas le goût de la cuisine indonésienne mais cela donne un gout "d''envie d''ailleurs". J''ai remplacé les tomates par de la sauce tomate et pas de gingembre...Mes papilles sont sous le charme.', '2006-02-11T17:20:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12140, fbc67c90-60ef-49ef-943e-f0e38c55cf8c, 'Très bon. Pour que la sauce soit moins liquide, j''ai gardé le fond de sauce avec les rondelles de banane et j''ai mixé le tout. Çà a donné une sauce onctueuse, sucrée, qui venait compléter parfaitement le plat. Mon chéri a adoré !', '2005-01-09T13:25:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12140, 42b904a9-bb14-4498-b677-1ea579bbcb65, 'Décevant... Les ingrédients ne sont pas très indonésiens et on ne retrouve pas le goût exotique de ce beau pays, à mon avis...', '2004-08-13T08:35:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12140, 10032652-e63f-47d3-9e8e-9e4e2bd10d11, 'Je l''ai essayé, je l''ai adopté et quand je veux épater mes amis qui aiment le sucré salé, je le cuisine avec du plaisir. Le temps de cuisson est long, mais sur un petit feu, on fait autre chose pendant ce temps.', '2002-11-23T18:32:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12140, 814bf9f2-071e-442f-b5fc-901760ebce3d, '5/5 au niveau du goût mais c''est vraiment très long à cuire. Commencer à le faire au moment de l''apéro !!', '2001-05-02T18:37:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12140, 9793d0d0-5845-400d-98f2-691d6f8344ec, 'C''était bon et assez économique.', '2001-04-23T13:32:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12140, a6678ce4-ae16-4658-953c-e36efc8c1187, 'Très sympa mais il faut aimer les poivrons!', '2001-04-13T15:55:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228113, c0472fed-c1f8-4d7c-a299-019177362896, 'Recette parfaite pour les enfants, avec un peu de chocolat et moins de sucre.', '2022-10-12T15:38:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228113, 36b01d3e-6861-44ad-aab5-ade7980b1903, 'Merci pour cette super recette ! J''ai ajouté des pépites de chocolat qui accompagnent tres bien la banane 😋
Je n''avais pas de petit suisse mais en suivant les commentaires ce n''est effectivement pas un drame. J''ai fait 6 gros muffins. ', '2021-05-16T21:04:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228113, aa6d9392-f2cc-4246-b97e-a87e6f83deab, 'Très bonne recette, je n’ai pas mis le petit suisse et j’ai ajouté du sucre vanillé et des pépites de chocolats, résultat délicieux', '2019-05-03T11:01:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228113, 44397bb6-2e1d-4e8c-b266-07246922ff49, 'Délicieux ! J''ai complètement oublié le yaourt et cela ne s''est pas ressenti. A refaire dès que les bananes traînent', '2016-02-22T19:23:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (228113, c89d4b9f-7d43-40cc-be64-639269cbb349, 'Très bonne recette et muffins légers, j''ai mis moins de sucre (30 g + un sachet de sucre vanillé), une cuillère à café d''extrait de vanille et 60 g de fromage blanc. Quelques pastilles de chocolat pour la gourmandise (3 ou 4 par muffin), à refaire !', '2015-03-09T17:48:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66812, a4721687-5feb-4f96-bcb0-57b45462dc54, 'C''est très bon, mais le plat rend pas mal d''eau, donc les papillotes ne peuvent pas être servies telles quelles.', '2015-01-17T18:25:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66812, bdd5cee9-5a70-4a15-bf7b-45079149e9bf, 'Personnellement je n''ai pas aimé. La banane est trop sucrée et l''emporte sur le goût du poisson.', '2014-11-10T12:52:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66812, fb0007e1-4367-4bf1-ab8e-a3e6ee9efb28, 'Un mariage surprenant mais succulent ! Je me suis régalée pourtant pas très fan du sucré-salé.', '2013-10-14T21:15:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66812, ec592562-003d-4807-9adf-c61cf711c3f1, 'Le mélange salé/sucré est délicieux. Mon mari s''est pris au jeu et a préparé le plat tout seul !', '2013-05-26T21:42:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66812, be994b9f-749f-4df6-a055-56830df8773d, 'C''est juste excellent !!!', '2013-05-24T18:40:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66812, 492b1b63-038f-4146-ac51-afa1acac50c4, 'Les enfants ont moyennement apprécié...', '2013-05-02T00:20:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66812, a2bf6867-4ceb-49af-ab51-19cde0763730, 'Recette rapide et facile. Le goût des bananes est atténué par la cuisson, mariage réussi avec le poisson. A refaire !', '2012-07-23T17:33:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66812, 95f4c5f1-c7d0-4927-ba48-a98482b4a61e, 'Que dire mis à part excellent, en plus des ingrédients, j''ai ajouté de l''aneth !', '2011-10-21T13:48:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66812, 8821a8b0-450c-42cf-aed6-3940047f9e3f, 'On a trouvé la recette bonne et au lieu de faire cuire au four, je les ai faites cuire à la vapeur.', '2011-02-16T14:52:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66812, dec9fad5-a8f7-4854-bf5e-dc6bea2a2143, 'J''ai trouvé ça fade et pas très présentable...', '2010-07-21T17:08:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66812, 3e5646a0-d529-4161-a7c7-742c5debd4d0, 'Super bon!  Ma femme a adoré et pourtant elle n''aime pas trop la banane! Facile, rapide et léger avec une petite sélection 3 riz.', '2009-02-07T21:35:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66812, b0296f04-d724-4a8f-b439-82502f64643c, 'Je l''ai fait avec un steack de requin et j''ai augmenté les doses de citron vert et banane... nous avons adoré!', '2008-09-29T13:05:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52470, f740c9eb-168a-410d-8b82-d299d35aed4b, 'Excellent dessert. Cependant, la mesure de rhum est erronée, c''est à mon avis 50 mL soit 5 cL (10 fois moins!), cela suffit amplement. A part ça, parfait ! ', '2015-02-15T12:20:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52470, 25984008-611b-48b6-8be6-04c3b72508e8, 'Beaucoup trop de rhum!!! On ne sent pas le gout des bananes même en ne mettant que 1/4 de la dose indiquée. Tout est partie à la poubelle!', '2010-02-26T10:36:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52470, 9420a5aa-e420-473f-a328-4dc7e8ace8f0, 'Tarte excellente j''ai flambé les bananes à l''armagnac mais très peu.', '2009-03-23T18:25:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52470, 02cda413-d8e7-4881-b46b-b8e0968f5fb9, 'Recette très simple et effet garanti. Vraiment très bon et original. Un bémol pour les 50 cl de rhum, je pense que cela fait trop (surtout si comme moi vous n''arrivez pas à le faire flamber!!!) A essayer absolument!', '2008-10-28T20:04:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (112817, 1de1a6b0-b488-4732-9cbc-7af61e539bfe, 'L''association est bonne, c''est frais. Même si je n''ai pas trouvé cela exceptionnel, ça se mange bien. Néanmoins, la prochaine fois, je ne mettrai pas de pépites de chocolat.', '2012-06-26T23:55:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 3e2a8cdd-5bad-4d88-9900-4f44b27321c0, 'Délicieux avec des feuilles de menthe à la place du basilic et du lait de coco, à refaire ! 👍🏻', '2022-04-24T18:42:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, ecbe1365-2b35-44a6-9cf9-7ed90dbe9a00, 'Pas terrible quand on suit la recette sans faire de changements.', '2021-01-15T08:57:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 977d0399-821d-48d3-9af0-507b4682d724, 'Excellent! Rafraîchissant et surprenant, ce smoothie est un succès à chaque fois.
J''utilise les épinards du jardins, plus goûtus et pour le moment, je remplace le basilic par la menthe. 
Pour le prochain je testerai avec un trait de citron vert. ', '2019-02-23T02:02:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, bbc19d95-9104-4b2e-867a-3f1c6db99a16, 'Très rafraîchissant, j’apprécie également lorsque les feuilles de basilic sont remplacées par des feuilles de menthe. ', '2016-10-16T14:48:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, aed375b8-2a2b-467e-8aaf-2fe22d19b183, 'Délicieux et très frais. J''aime beaucoup l''association fruits et basilic. ', '2016-04-25T19:28:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 94d68177-9291-41d0-904e-690172079011, 'Très bon, très vitaminé pour le matin.', '2016-02-27T07:57:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 0fb3168d-35e4-4d5e-a120-6f331b2f407b, 'Très bonne recette, c''est frais et riche en goût !', '2015-11-13T20:28:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, dbbb1f57-c21e-4cc9-97ee-beb0de073dad, 'Excellent, ça change des smoothie 100% fruits. ', '2015-10-24T13:27:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 65faf150-3368-486e-bc14-dd5149671de7, 'Original avec du basilic et des épinards. J''ai aussi rajouté de la mangue.', '2015-04-24T14:03:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 41843e70-db89-4a58-9623-93de9ca4c9de, 'Super bon.', '2015-03-28T21:44:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 9ce83ff1-4676-4bbf-b1a4-7a84b5ab32c4, 'Recette respectée à la lettre, je trouve ça horriblement fade sans intérêts. ', '2015-01-31T19:38:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, bbbce714-9ab7-49bf-8d3e-8ed5e2883d95, 'Wahou !!! De la Bombe vitaminée délicieuse ', '2014-10-15T09:30:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 16c8ec5f-860f-4cc1-a9b1-a7400a5114b4, 'Un délice.', '2014-10-09T22:16:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 88bd49d6-071f-4836-b974-c080c6f46ad2, 'Très bon avec du lait d''amande et une bonne dose de gingembre pour le côté piquant. ', '2014-10-08T22:55:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 1405a142-0e7f-4c9b-aa6c-7fa03be9147e, 'Un peu revisité niveau quantités mais bon résultat ! ', '2014-10-06T00:33:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, f4fa42b1-82a6-423b-99ed-6ade43b78a2d, 'J''avais peur mais en fait c''est absolument délicieux ', '2014-10-04T18:29:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, de47c7b5-9e8e-4f31-8b2f-e5cd2334216d, 'Ben. Pas top du tout', '2014-10-03T09:41:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 505701a9-1cb2-47bb-a751-a19e99e5b35c, 'Super !!!', '2014-10-03T05:06:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 7592b9db-e4ea-4362-9b0f-487d27808375, 'Fait avec du lait de riz, très bon ! ', '2014-10-02T16:36:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, a45407cf-3f1e-4038-844b-4fd15a8ac2e3, 'Savoureuse association vitaminée ', '2014-10-02T00:52:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 98723ea3-7730-4229-a4ed-4b0c740ecfb1, 'Génial... Sympathique', '2014-10-02T00:27:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, d22aed88-2e18-4508-8167-ab2389ccb5ef, 'Pas bon du tout', '2014-10-01T19:44:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 9d5ea5f2-587c-47e9-9665-81151d4fb6b1, 'Délicieux ', '2014-10-01T19:40:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, fa9815e3-9cee-47a2-8aec-beabd95e234d, 'Très bon', '2014-10-01T18:21:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 6077f0d3-81c7-4722-a4f5-11287998a5cb, 'Parfait ! Un vrai délice :)', '2014-05-03T15:41:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224655, 388380cf-d980-480c-b8ea-aac014be147d, 'délicieux !', '2013-05-25T19:11:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44064, 6cc4e9c4-b2c6-4bcc-bd81-c5fcb9d83c15, 'Bonne recette de crumble, pour ma part j''aime beaucoup les coings, mais je préfère le crumble version "classique".', '2014-09-29T22:55:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44064, 62fc808f-81b6-478f-9991-cdef34b46012, 'Le goût des coings et des framboises est un mariage exceptionnel. Merci pour cette recette.', '2007-10-22T10:43:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44064, 5daffd67-0099-4673-8e59-3c48a3b11fa9, 'Délicieux malgré l''absence de framboises que j''ai remplacé par 1/2 banane en plus. Les enfants ont adoré et les parents aussi!', '2006-11-19T14:43:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68123, 203048ac-75bb-42d8-b295-eb75ccc04fd2, 'Bon mais sans plus... Mais dessert très très léger !', '2013-02-05T21:26:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68123, f6a32979-59f0-48a7-9603-55ef4cd646a8, 'Dessert "léger", très apprécié et simple à faire. Parfait !', '2012-04-05T16:20:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68123, 47cb0796-a4e6-48ab-9afa-3b76ab09570e, 'Très bonne mousse légère. Parfait pour finaliser un bon repas.', '2012-02-21T11:27:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68123, 68980692-9db8-44dc-b461-5f0c8f25c846, 'J''ai utilisé des fruits surgelés,ils étaient un peu amer, mais ce dessert reste assez léger, saupoudré de cacao noir, adultes et enfants ont apprécié.', '2009-01-07T09:23:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80008, 108b0bee-0f62-4666-9170-d9c874d085a6, 'Très sympa comme recette, et surtout hyper facile à réaliser pour un effet assez surprenant. Les enfants adorent et les parents aussi !!! Recette réalisée à la lettre avec des palets bretons classiques', '2012-01-07T17:26:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80008, b4229e72-97a0-43b1-a68d-1c77eebdfbb3, 'Dessert léger et bon. J''ai utilisé des spéculoos comme gâteaux secs, et j''ai terminé le verre avec de la chantilly. Mon mari en voulait encore. Recette facile et rapide. Bravo.', '2011-02-26T21:12:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80008, 15a7e0db-f7af-4e31-8f74-325f4868be13, 'Mes invités ont adoré tout comme moi, à refaire sans problème. Je n''ai rien changé du tout à la recette si ce n''est que j''ai ajouté de la chantilly.', '2011-01-09T19:20:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80008, 14ad65df-d4f3-4ed3-aa96-62c60cdfd1e1, 'Très bon, très simple et très rapide. J''ai mis un kiwi et une banane pour deux. Pour les gâteaux j''ai mis des palets bretons au chocolat et orange confite au fond et des gâteaux roses de Reims sur la banane.', '2009-11-09T11:24:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91955, 65a132d3-cc1c-4dfa-99ba-057cf89fe920, 'Je l''ai essayé ce midi, mais sans banane. Résultat : c''est plus un "fondant" qu''un gâteau, mais pas mauvais pour autant.', '2011-01-16T22:22:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91955, 560efea6-7573-4e00-8a15-8976524c7530, 'Pâte bien trop liquide qui donne au final (30 min cuisson) des petites choses qui ne sont pas des gâteaux mais des unités comestibles à mi chemin entre le flan et le clafoutis. Pas assez sucré. ', '2010-05-26T22:13:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305587, 0081c258-ec09-411d-9996-0c9f4e57b4e8, 'Grosse déception ! Il y a au moins deux fois trop d''eau dans la recette ! Le goût manque de grand marnier', '2015-01-18T19:31:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51938, 6bac216e-39eb-43bc-96a1-bd6f1c9bcf7e, 'Très bon mais je n''ai pas mis l''ananas et j''ai ajouté du sucre vanillé qui donne un petit goût sympa.', '2016-04-18T13:29:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51938, f431e2b5-2d3d-4de9-a797-187736b89664, 'C''est bon mais le goût de banane est trop prédominant (à mon goût). Bien meilleur avec 1 banane, 1 kiwi, 1/2 ananas et le jus d''1/2 orange à la place de l''eau. Eventuellement sucrer un peu.', '2007-02-14T11:36:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 5b34a510-e962-405a-8d4b-d4fdf8fff5e7, 'Bof .... le gâteau était plat et un goût de farine et levure ... nous n''avons pas aimé ! ', '2013-10-27T12:31:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 486270c2-0fd3-4505-9da8-d85c7d3a4bdf, 'Bof, j''ai ajouté un peu de rhum et du gingembre... Le goût n''est pas mal  mais la texture est vraiment spongieuse !!  Nous n''avons pas aimé.', '2012-11-17T22:52:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 31b42c9b-67fb-411f-afc2-0d3f32faf245, 'Très bon ', '2023-02-06T10:58:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, a4656726-2aa5-41f8-bfaa-27a7853e8947, 'Très bon (je trouve contrairement à d''autres avis qu''on sent bien la banane) et très rapide à faire ! Tout dans le mixeur donc parfait j''ai jamais fait un gâteau avec aussi peu de vaisselle haha. Je recommande la recette ! ', '2021-03-02T20:00:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 7a274a0c-7b4b-479b-96c2-b88b0492fdda, 'Excellent, on l’a fait rapidement et sans parents, c’est parfait ! Il a très bien monté et on a rajouté un petit peu de chocolat c’était super. ', '2020-03-18T17:34:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 6f36bbc8-2a68-48c7-8e52-1332f2eeea45, 'Elle est super simple a réaliser et ce que j''aime le plus c''est qu''il n''y ai pas de  beurre.
Je réduit de moitié la quantité de sucre, les bananes bien mûr sont suffisamment sucré .', '2018-05-21T10:56:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 222bd254-5883-4ffb-8590-b4c065378ed6, 'Testé et approuvé. Seul bémol, on ne sent pas beaucoup la banane et pourtant j''en ai mis 3 mûres.  Pour ma part, j''ai mixé les bananes pour donner une texture purée et je l''ai ajoutée au sucre, aux oeufs.  Mais un gâteau rapide, moelleux. ', '2015-09-19T19:35:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, f346372e-297b-45d9-9f3e-eb995e091eab, 'Trop bon hmmmm !', '2013-12-03T12:58:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 6b442f80-503e-4d61-a101-f4d53c8edade, 'Simple et efficace. Tout ce que je recherche !', '2013-03-17T06:44:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, e4ccc947-da96-4aa3-a613-8d5d3f85e276, 'J''ai testé le gâteau, il est très bon mais j''ai mis 4 bananes au lieu de 3 et on ne sent toujours pas le goût banane. En, plus malgré le sachet de levure chimique, il est resté plat. Sinon, pas mauvais quand même. ', '2013-02-11T12:16:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 6821ba9d-3655-46fb-a092-f9017c15cf79, 'simple et bon, très parfumé en goût banane. c''est vrai que ça donne envie d''y ajouter du chocolat, soit en pépites dans le gâteau, soit en coulis à part...', '2013-01-19T13:15:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 2cc10239-c16b-4541-bb34-6cc65f7a660b, 'Très bon et simple, merci !', '2012-12-06T01:08:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, c01e48eb-8532-4f93-b964-4a5eade6e060, 'Testé et approuvé ! Idéal pour se débarrasser des bananes un peu trop mûres pour être appétissantes telles quelles ! Et en plus, c''est hyper simple et très rapide, que demander de plus ? ', '2012-11-29T11:46:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 9bc1d662-d8c3-4a5c-a2c9-9127e7c69d17, 'J''ai ajouté un peu de fleur d''oranger, très très bon mais je n''ai pas réussi à monter les bananes en mousse.', '2012-11-22T22:01:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, deb59c64-7f9d-48b3-a891-6d05221368f9, 'Très bon, à refaire. ', '2012-11-21T21:52:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 1b602f20-96e5-4db8-84e1-81b058e6fb33, 'Moyen, pas trop le goût de la banane vu que tout était au fond du cake.', '2012-11-18T14:04:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 761e9757-f1ba-40f5-8e62-dc4999f18e35, 'Totalement raté, le gâteau n''est pas monté. Il n''avait pas l''air mauvais en goût. A réessayer.', '2012-11-15T00:36:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 062405b9-d2e5-41c2-ab92-7d05690bab4e, 'Excellent rapport rapidité, simplicité et goût ! Juge très bon par tous les convives, grand merci d''avoir partagé cette recette.', '2012-11-12T23:38:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, acfef7a2-8c9e-4d8b-98a1-443a50ee3a14, 'Assez moyen... Franchement déçue.  Rapide certes mais pour le goût.... Ca sent la banane, mais on n''y retrouve pas le goût. ', '2012-11-12T22:47:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, b423f763-0ea4-4160-bf96-abfd93aa20f8, 'Bof, drôle de couleur et texture un peu collante...', '2012-11-12T19:23:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 3f5567eb-63ec-4f60-87ef-ff45b61a0458, 'Simplissime et très bon mes invités ont adoré. J''ai juste fait quelques modifications, j''ai ajouté 100 g de beurre, un œuf et nappé de chocolat. Merci pour cette recette ultra rapide à réaliser !', '2012-11-12T10:24:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 18b7adb5-acae-4f7f-b015-8449514eb449, 'J''ai mis 60 grammes de sucre, une cuillère de miel, et de la farine de riz et de châtaigne car je suis sans gluten ! de la cannelle ! c''était parfait !', '2012-11-11T21:32:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, adf8416d-6882-45eb-b9a4-0bf5394c0d18, 'Très déçu ! Il manque quelque chose ! J''ai suivi la recette à la lettre et très déçue du résultat...', '2012-11-11T21:30:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 12531a3a-da76-4b66-8dbe-c8a86d884053, 'Pas mal du tout quand on ne sait pas quoi faire de bananes qui murissent trop vite. J''ai mis 70-80 g de sucre seulement et c''est suffisant. A essayer de nouveau avec un peu de rhum !', '2012-11-11T16:52:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, 08a83f6c-f488-452c-8f08-c33ca48ea2a6, 'La texture est plutôt celle d''un flan que d''un gâteau. Il faut laisser cuire plus longtemps ou ne mettre qu''une seule banane.', '2012-11-11T14:42:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, cdd08edf-0bc2-4527-998f-e257d2faddad, 'J''ai ajouté 100 g de miettes de chocolat, de l''extrait de vanille au lieu du sucre vanillé et un peu de gingembre... Délicieux ! (surtout servi encore tiède).', '2012-03-26T00:38:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, fd5ed3a1-0ba0-453e-a784-3bd4b8fe6fb4, 'Très bon !', '2011-09-16T22:37:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86816, e67f8444-2206-40c8-895c-2f8e867215cd, 'Gâteau rapide, ultra simple, et bon. Il ne faudrait mettre que la moitié du sachet de levure et diminuer le sucre. J''ai ajouté du rhum et de la vanille liquide.', '2009-07-13T01:33:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 1df14476-7046-49a1-974a-0f1e21fa6ce3, 'Une tuerie ! On sent tres bien à la fois le nutella er les bananes. Je dirais même que c''est bien équilibré car le nutella fait ressortir le goût des bananes. En revanche, j''ai mis 50 gr de sucre au lieu de 100. 2 oeufs et je n''ai pas mis toute la préparation liquide de peur que la consistance soit celle d''un flan et que la pâte ne cuise pas. De cette façon c''etait tres bien. J''ai cuit la tarte durant 40 minutes à 200 degrés.
', '2020-12-16T21:56:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 6b536ee0-f977-474b-b369-09a92f9b8148, 'Effectivement, 2 oeufs et 50 g de sucre sont largement suffisants. Très bonne recette. Merci.', '2018-08-09T22:20:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, d1014fc9-0fca-46ef-a177-02bfb0d9ab16, 'Cette tarte est un régal, et ma famille l’adore ! Je la conseille à tous les grands gourmands !!!', '2018-03-09T05:08:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, d4254a8f-ae07-4b40-827c-64314b9196ff, 'Facile à faire, c''est bon, avec du sucre à la noix de coco c''est encore meilleur. 2 oeufs sont suffisant, avec beaucoup moins de sucre quand même, sinon ça devient trop écoeurant !', '2016-12-24T12:17:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, e3fc28ce-dcb8-48c8-9755-5cbd8d3c73f2, 'Très bon, le parfum du nutella et de la banane se marient très bien. Il faut faire d''assez grosses rondelles de bananes car lorsque la tarte est froide on ne sent pas sont goût.', '2016-11-17T18:00:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 69f427de-5b4f-4400-9705-55b7711461f0, 'Carrément trop bon, mais je l''ai faite en mode tartelette avec un restant de pâte ^^  A refaire en intégralité la prochaine fois :) Je recommande !', '2015-05-04T21:30:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 7a2e1696-445e-4d82-b42c-410676589c70, 'Bonne recette, cependant j''ai mis 2 bananes, 2 oeufs, 50gr de sucre et un sachet de sucre vanillé.', '2014-02-09T15:07:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 389a82c1-0bfa-452a-afdf-f2af20602b34, 'Merci pour cette fabuleuse recette ! Perso, j''ai mis moitié de sucre, et j''ai saupoudré la base de Nutella et à la fin de la préparation de la noix de coco râpée. Trop bon !!! Mon beau fils n''a pas trouvé le sommeil tant qu''il en restait dans le frigo....', '2012-06-13T20:06:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 180006bf-3462-4104-be92-c44f7025046c, 'Très bon ! Ca a fait plaisir à tout le monde.', '2012-05-08T13:05:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 19c177fd-1319-40b8-a9eb-e8b7fad1cca6, 'Une excellente recette que beaucoup m''ont réclamée par la suite ! Quelques petits conseils pour ma part qui la rendront encore plus savoureuse : la pâte brisée peut être remplacée par de la pâte feuilletée ou sablée afin de varier les plaisirs ; 2 œufs ; 3 bananes ; 4 à 5 cuillères à soupe de Nutella suffisent pour ceux et celles qui n''aiment pas les desserts trop sucrés ; 50 g de sucre. Je n''ai pas versé toute la préparation liquide, sinon cela peut prendre la texture d''un flan et le tout peut devenir trop liquide. J''ai donc ajouté si besoin lors de la cuisson au four. Garder sa tarte le plus moelleuse possible (pas de cuisson trop forte et trop longue) en la surveillant toutes les 5 mn environ afin de garder le Nutella fondant !... Bonne dégustation.', '2012-03-10T10:59:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 844ae5a1-c4c4-46d9-b608-833ca39bb2a9, 'Une recette facile et vite faite pour le gouter, les enfants ont adoré (les parents aussi !). Merci beaucoup.', '2011-11-18T18:49:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 1918dbb6-3b81-4084-bc10-4b7bb70ed2e8, 'Génial, 3 cuillères de nutella suffisent largement... délicieux pour les gourmands !', '2010-07-03T21:59:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, cf30b51b-9101-4518-b10c-6a160d24f548, 'Excellent, sans rien changer. Cela a fait un succès fou et cette tarte fait partie de mes classiques maintenant! Merci pour la recette!', '2009-12-16T21:04:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 6bd145b4-65d4-416d-9d2a-ed25113d0e6d, 'Excellente tarte . Je n''ai mis que la moitié du sucre et c''était suffisant à mon goût...', '2009-09-30T16:27:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 98dc6b7a-2b04-43b1-a619-f24cb9deae3b, 'Cette tarte est pour les gourmands, petits et grands ! Elle est délicieuse ! Je n''ai mis que 2 œufs et 50 g de sucre en poudre (la pâte à tartiner est déjà bien sucrée) et pour donner un petit goût en plus, je rajoute à la préparation œuf/lait/sucre 1 cuillère à soupe de pâte à tartiner.', '2009-05-17T10:54:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, d06d93ee-a9b1-47c1-ba89-e81b834e3fc0, 'La recettes est vraiment pas mal mais le mélange du dessus fait un peu trop flan a mon goût!! Moi j''ai fait revenir les bananes dans un peu de beurre et de sucre !!  Excellent. ', '2009-01-01T21:52:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, ed284f07-5471-453b-aa30-0755b25850c6, 'Très bon !!! Je n''ai mis que 80 g de sucre et laissé cuire environ 15 minutes en plus. En tout cas, c''est facile à faire et le résultat est surprenant - à refaire ! ', '2008-04-01T11:51:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 8bae8ef0-28d8-4f16-8c71-37d06864aa70, 'Je viens de tester la recette et je me suis régalée ainsi que les membres de ma famille. J''ai simplement réduit le nutella à 4 c à soupe et mis 2 oeufs au lieu de 3. Merci de nous l''avoir faite partager, succulent...  ', '2007-10-03T22:49:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 780d8520-11bf-454e-97aa-3daf55da7775, 'Comme Céline, j''ai modifié légèrement en respectant ses ingrédients  et pour la cuisson, j''ai prolongé de 25 minutes. Mes petits enfant se sont régalé, c''est excellent!!', '2007-09-06T17:10:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 326c3b51-7276-4710-bdde-9a45071baeb6, 'L''idée de garnir le fond de tarte au nutella est une bonne idée, mais le reste on dirait un flan à la banane. Très décue, et pas la seule...', '2007-08-21T15:28:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, b1c29a03-61c1-4279-a2c0-412b6dcb6dc0, 'Recette très sympa, amatrice et fidèle de nutella cependant j''ai modifie un peu la recette : 2 oeufs, 50g de sucre, 15 à 20 cl de crème liquide au lieu du lait. Un régal...!!!', '2006-10-07T12:25:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, e053e97b-66b9-46a9-ab81-7ca97cfcd284, 'Délicieuse! J''ai d''abord hésité en lisant les premiers commentaires, mais on s''est régalé et le mot est faible. Une recette simple mais délicieuse !', '2006-05-16T20:58:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, c4ed8fd0-0c40-4a4f-baf4-0fa6095a212d, 'Avis partagés. Amateurs de nutella, vous aimerez! Les autres peuvent trouver cela écoeurant. A essayer au moins une fois...', '2006-02-06T19:45:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 707b7c8b-245b-4d73-b791-a24d82ce0d2a, 'Bof! On ne peut pas dire que ce n''est pas bon mais c''est très banal ! Les goûts sont très mélangés, la saveur du chocolat est presque complètement disparue sous celle des bananes. Ce dessert ne fera pas partie des favoris familiaux malgré sa simplicité de préparation ! ', '2005-11-06T12:18:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 25bd6db0-68de-4ff7-9d5f-909a0ee7684e, 'Très bon les enfants ont aimé. Pâte brisée maison (recette marmiton).', '2005-10-07T10:03:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, f287db86-961a-4eb9-9dd6-eaabea36be3f, 'Je n''ai pas trop aimé... Je trouve qu''on ne sent pas trop le goût des bananes ni le goût du nutella!', '2005-04-28T20:55:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, a11fe74e-e65b-400d-a78b-c3b44b3e5c8b, 'Très très bon. Original, le goût du nutella. A faire avec moins de sucre!', '2005-04-19T00:03:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 2920f350-3fde-4bd1-b9d9-157ed1933708, 'Délicieuse recette. J''ai fait une tartelette et une autre sans la pâte, c''était tout aussi bon.', '2005-02-22T18:07:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, efe32f65-df4f-48c9-989f-47b7abaa9681, 'Bon, mais il faut que les bananes soit totalement recouvertes, sinon elles deviennent sèches à la cuisson. Mais recette très originale!!', '2004-09-21T22:45:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 0ce42084-47eb-45bd-b0e9-5f93b27372a7, 'Cette tarte est fabuleuse! Elle a fait le bonheur de mon entourage. Ne pas hésiter sur le nutella pour qu''on le sente vraiment! Merci pour cette très bonne recette!', '2004-09-01T13:06:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, cfc71d07-cf58-488c-bb0b-03f374e495db, 'Un délice pour les enfants, qui en redemandent toujours!', '2004-08-22T22:17:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, f1a1b199-3477-49a0-aef7-2bb4c6400ab9, 'Cette tarte est absolument délicieuse, simple et rapide. Une note bien méritée!! A faire et à refaire.', '2004-08-05T15:31:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 25861865-453b-4d8f-b02b-cf82d7d8b6fd, 'Cette recette est également excellente en ne mettant que le nutella puis les bananes et en saupoudrant le tout de sucre vanillé.', '2004-08-03T21:33:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 458314be-f10f-4ce0-ba9e-a3b5dc63866e, 'C''est effectivement excellent et très facile à faire! Faites attention cependant à manger des petites parts car cela peut être un peu écoeurant en trop grandes quantités. Parfait pour les amoureux de nutella!!!', '2004-07-25T23:57:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 4c2a8698-16b3-4324-b4d7-a8617041e16c, 'J''aime le nutella et cette tarte est très réussie! On en sent bien le goût, ainsi que des bananes... BRAVO!', '2004-07-21T18:35:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30034, 503c0230-1dd3-4e89-984c-75dd14ccda21, 'Super bon, le mariage du nutella et de la banane!!!', '2004-07-08T22:48:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219150, d223ae94-261d-4fb1-864c-1ea29527b47f, 'un régal

', '2021-07-03T20:34:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68203, 9f721a9f-bc11-4c49-a0ec-50035d8bd090, 'Déçue... Le goût était là mais par contre pas la texture ! C''était liquide, pas de mousse. Peut-être en ai-je trop mis dans mes coupelles ou alors pas assez longtemps au réfrigérateur (pourtant j''ai respecté les 4h).', '2011-08-14T12:14:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68203, 765140dc-5aa5-4f15-b596-0585d6aead95, 'J''adore c''est frais rapide et allège un repas copieux! Merci!', '2008-03-24T12:51:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24791, a1ad00b4-91d9-4e09-9a17-7eb1fd1d886e, 'Sans plus ! Difficile à flamber car la sauce dans le fond du plat empêche le rhum chauffé de flamber le plat ! Conseil :  retirer la sauce avant de flamber mais le résultat est tout de même moyen (aspect des bananes pas très appétissant) !! Je ne referai pas cette recette ! ', '2009-03-22T14:30:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24791, 37cebeda-5986-4671-b66c-79b13f340786, 'Un régal, j''ai remplacé la vanille par un sachet de sucre vanillé... et cela passe très bien ascenseur.', '2009-02-08T11:25:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24791, eafbdb08-69fb-4f17-b3bc-f1a6936e1f1c, 'Un peu déçu ; je trouve qu''il manque 5 ou 10 min sous le grill .   ', '2008-08-12T18:38:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24791, 570b52a9-af9c-499a-8e1b-5c72efa60a3e, 'Hummm !!! Il n''y a que ça à dire!!', '2008-03-27T16:52:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24791, 659ade4c-64de-4c50-b4da-76312b58e430, 'Délicieux, la gousse de vanille donne un goût excellent. Si vos bananes ne sont pas très mûres, je vous conseille de les ramollir au micro-ondes ou de prolonger la cuisson au four. Attention, pour flamber les bananes, il faut enlever l''eau qui resterait éventuellement au fond du plat!', '2008-02-05T14:38:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24791, 615214f6-8bb8-4a7e-b253-f45672b6d900, 'Simple mais efficace, étant fan de la banane flambée. Toutefois, j''ai rajouté du chocolat fondu et de la poudre de noix de coco, un petit plus à ne pas négliger.', '2008-02-05T02:04:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (87322, 209a9b6b-1f0d-4bc5-b06e-3b6fc7bb1f3b, 'Très bonne recette qui change du classique crumble aux pommes 👍', '2023-01-23T13:15:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (87322, 7378a7d2-c660-4d8f-8a3b-a5ba26c0a655, 'Bon dessert qui plait à tout le monde. La quantité de beurre doit être réduite de moitié afin d''obtenir une pâte sableuse et non pas un début de pâte à tarte.', '2009-08-24T01:02:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44044, 8c903906-d963-4862-b3b2-4d46f7618550, 'Les bananes se défont assez vite, les chipolatas et des lardons alourdissent le tout, je n''en mettrai plus. Le mélange banane et ananas reste cependant original.', '2006-11-08T10:23:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46826, 7b9bbe42-501d-4caf-82ea-84c9a82bfbff, 'Super recette, la seule chose c''est que c''est trop sucré, je vais réessayer en mettant moins de sucre dans le crumble, j''ai ajouté des framboises surgelées sur les fruits caramélisés, miam !', '2019-01-01T18:37:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46826, b84a0ed1-3136-4fcd-93d5-a4f7c8ad3e83, 'Recette que je conserve ! La noix de coco change du crumble traditionnel. J''ai fait fondre les fruits dans du beurre avec 1 sachet de sucre vanillé... Pas trop sucré ', '2015-11-20T21:42:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46826, 325a5e4f-1b14-4943-b756-1485004c6ef8, 'C''est très bon mais trop sucré!! La prochaine fois je ferais le caramel avec seulement 20 g de sucre . ', '2008-07-11T00:35:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46037, 5fbf7984-1128-440b-8105-3f31f877f289, 'Très bon, j''ai eu 10 muffins très moelleux.', '2020-01-24T12:01:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46037, 2e3f6ee5-c0f5-433a-8646-ab00911ce734, 'La recette m''a permis de remplir 12 moules à muffins.
J''ai prolongé la cuisson de 5 mn pour qu''ils soient cuits et fondants à l''inéerieur.
C''est bon mais sans plus...', '2017-07-09T02:46:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46037, 4cce6cf0-4fcc-4159-afce-9bf65383c166, 'Moi j''ai adoré ! :)', '2014-03-03T14:20:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46037, 20f4138a-148f-47e9-a83d-20fbe89182d9, 'C''était super bon, moi à la place du rhum j''ai mis du calvados et ça va très bien avec le reste, merci pour cette recette grâce à vous toute la famille en a profité !', '2011-05-08T16:41:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46037, 5a7de4fe-87a7-4109-8fed-9ac4312b5c19, 'On a adoré! De quoi faire 12 petits et 4 gros avec ces proportions. Juste une toute petite modif: 50 g de beurre et 100 g de chocolat, et 75 g de noix de coco! Parfait, ultra moelleux, bien surveiller la cuisson...', '2009-09-10T00:19:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46037, 9bc92379-7063-42ab-bb5d-c71d7062d9c4, 'Rien à redire pour les proportions. J''ai eu juste assez de pâte pour faire 6 muffins. Ils étaient gros, et nous étions un peu écoeuré à la fin alors que nous sommes de gros fan de chocolat.', '2006-09-04T22:34:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46037, 2ffd48ec-9002-476f-82bd-dba4d7c0fe51, 'Hyper bon! J''ai gardé les proportions.. à part pour la noix de coco (j''en ai mis un peu moins) Très simple et vraiment délicieux !', '2006-05-15T12:07:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46037, 989781d8-9651-496f-931b-ee6181da9b76, 'Je viens de goûter ces petits moelleux. C''est bon mais ça manque un peu de sucre, 120g devraient convenir. Pour ma part je n''ai utilisé que 3 oeufs et 30g de noix de coco.  J''avais beaucoup de pâte, alors j''ai utilisé un moule pour muffins et un moule à cake. Si vous utilisez des moules à muffins 8 min de cuisson suffisent, et pour un moule à cake je pense que 15 min c''est idéal. Merci pour cette recette.', '2006-04-17T20:26:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 7a0ce990-9675-471d-8f96-8e78f9c51d54, 'Pour ma part j''ai adapté la recette à ma convenance, 60g de chocolat Nestlé dessert, 1 oeuf, 10g de farine et 5g de maïzéna, 10g de noix de coco rapée, le petit carré de chocolat au milieu et 1mn30 de cuisson au micro-ondes... une tuerie !!!', '2018-02-23T05:49:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 16c20e83-2642-4244-b91b-9c061e9c14ee, 'J''adore ! Petit conseil ne le faite pas trop chauffer 😊', '2023-02-16T09:18:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, d3050164-a5ca-4271-82dc-478371dc2ccd, 'La texture est écoeurante, je n''ai pas pu le finir. Je ne referai pas. ', '2021-05-05T14:23:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 3ca3cf00-8f38-462b-a89b-3f9db0703835, 'bof bof, texture bizarre et écoeurante ://', '2021-03-06T18:48:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, eaa474eb-a29c-4252-bb20-8c297b605af9, 'Chouette recette, j ai mis 5g de sucre (j aime pas quand c est sucré et le chocolat l est deja pas mal) et la prochaine fois je mettrai un peu plus de chocolat pour le goût :) ', '2021-02-27T18:42:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 94ed51c8-6474-4ad3-9be0-33f80e03197d, 'Excellent, juste mettre un petit oeuf si possible mais délicieux', '2020-12-15T17:29:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 170b98dd-3217-455c-a3fd-e3a48a552274, 'Délicieux, j''adore ! ', '2020-10-26T11:18:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 7e69bec4-3a69-4e43-8675-9889f053f372, 'Super bon ! Merci. ;)', '2019-10-30T10:21:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 570df964-cc3b-4d69-92ad-f310dfba1442, 'Très bon ! Je le conseille pour les goûter à l’arrache ! Essayez avec un peu de miel et du chocolat croustillant ! Un délice. ', '2019-09-09T04:20:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 643cf4cd-1a85-4cc1-b1a5-4e865556244b, 'J''ai été surprise en bien ! Pour un goûter rapide ou une gourmandise tardive... Très apprécié, la prochaine fois j''y ajouterai quelques petites touches perso. ', '2019-07-16T05:45:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 632216b4-042d-46b4-81b8-d6fda3c0ea96, 'Pour ma part, c''est la première fois que j''ai fait ce gâteaux-là. Il est très bon, toute ma famille a adoré.', '2019-06-17T11:49:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 1a26f926-2c02-4ff6-8ffe-97f86c4873e9, 'Très bonne recette.', '2019-06-16T08:44:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, feb8c42e-bbcc-4168-a776-4b5f39904a38, 'Rapide simple et efficace un délice.', '2019-06-04T08:43:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 8ffaaaee-42f1-4f7a-b489-24123bb870b9, 'Bonjour une recette facile rapide et sympa merci.', '2019-04-07T14:07:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 544da233-e686-4d4b-90c4-0161ef9f1283, 'Très bon et très léger. Le temps de cuisson varie selon les micro-ondes. Faire attention.', '2018-12-31T09:27:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 2f618273-1594-48e9-a900-eee755f95db9, 'Je trouve pas ça bon et au micro-onde, le mugcake déborde et coule partout dans le micro-onde.', '2018-10-30T02:43:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 1f4ca8c7-b6c5-44bd-bd3f-00d14ce0e924, 'A par les quantités qu''il faut diviser en 2 sinon le gâteau est trop écoeurant cette  recette est parfaite je la recommande vivement !!!!!', '2018-10-20T05:09:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 3ed69789-e28a-455d-abd0-4a1c12167de5, 'La texture d''un mugcake reste spéciale et très copieuse, mais c''est bon ! Recette réalisée avec 35g de crème fraîche liquide à la place du beurre, 15g de sucre au lieu de 20 et un carré de chocolat praliné glissé à la fin (même s''il a coulé au fond, c''est top !).', '2018-10-14T11:07:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 6b66a187-8bcf-4c11-954e-6cf54c239da1, 'Très réussi ! Personnellement j''ai rajouter un coulis aux fruits à l''intérieur et c''est un délice !', '2018-03-18T12:01:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 61a2b79f-c371-49a5-a5aa-b7159f90ba43, 'Miam délicieuse recette ! Je la recommande fortement !', '2017-11-15T09:33:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 24719ccc-4834-427f-a30f-45f8aeb78834, 'Pas mal quand on a une envie soudaine de gâteau au chocolat. J''ai mis moins de sucre et rajouté un peu de levure pour être sûre qu''il monte. Texture moelleux au chocolat et coulant en même temps.', '2017-09-03T15:39:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, b04e36ab-8f10-4b25-8d4a-aff90817c847, 'C''est dur de se dire que ce mugcake ne sera jamais vraiment cuit...
la pâte monte mais n''a pas le temps de cuir. à moins de se retrouver avec un micro-ondes dégueulasse, ce mugcake ne deviendra jamais un gâteau...
rip, mugcake.', '2017-06-17T14:35:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, b275c691-2dff-4a15-a5ad-2d3a1074480e, 'Un peu trop écoeurant mais délicieux ! Je le referai avec plaisir. DÉLICIEUX !!', '2017-04-05T19:22:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 01ea178f-9aec-44ab-987c-eac829b95d28, 'En cas d''envie soudaine ou de besoin de réconfort ce mugcake remplie sa mission ! Vite prêt avec des ingrédients simples il est excellent. Je n''ai rien changé à la recette. 1min20 pour ma part en temps de cuisson. Et un bounty glacé plongé dedans... une tuerie.', '2017-02-18T01:54:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, d2a2d50a-8f1b-431c-9b6d-4124a3705870, 'Très bonne recette...mais bon 35 g de beurre dans un mug ! Remplacez le beurre par de la crème liquide et cela ne changera en rien le résultat, je vous assure. Pour le sucre, la dose d''un sachet vanille fera l''affaire. Vous pouvez obtenir le même plaisir de dégustation !', '2017-01-25T21:41:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 2eb33320-dea4-461c-a243-5445e1f8e677, 'C''était encore liquide même après 20 minute de cuisson au four à micro-ondes.', '2017-01-07T18:58:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, cca8d289-c317-4d2a-947b-1ee8610d9621, 'Délicieuse recette ! Même si j''ai remis et remis le pauvre mug au micro-ondes avant de me rendre compte que j''avais oublié la levure (même si ce n''était pas demandé) malgré ça c''était délicieux ! J''ai remplacé le chocolat par 20 g de caramel (liquide) un peu sucré mais très bon. A refaire !', '2016-12-06T06:38:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 931fd5e7-6332-4298-8b14-3d8cabe359e7, 'J''ai ajouté du pralin dedans et c''était super bon.', '2016-11-15T22:50:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 5af7c67a-46e1-4993-b707-c7f72c45076e, 'Simplement parfait. Les proportions ne sont pas à changer. Je n''ai cependant pas mis de lait. J''ai ajouté un coeur dedans le mugcake au beurre de cacahuètes pour avoir ce coté sucré-salé. Un régal. J''ai fait cuire 50 secondes à 700 W pour que ce soit digne d''une fondant au chocolat.', '2016-10-03T01:28:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 2a66b975-7003-4fad-b820-80f534285a57, 'Au lieu de mettre du chocolat et du beurre, j''ai mis 2 grosse cuillère de Nutella, un régal !', '2016-07-13T13:57:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 9d5dd923-3672-4603-a14d-31c7b04990f9, 'Ma recette de mugcake de prédilection !!! Délicieux', '2016-06-15T16:46:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 6da93634-5e9b-4a4c-b70a-9ae9ce0328c1, 'Délicieux.', '2016-06-08T19:28:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 60892aec-8e82-4eda-98c6-aacf9f186d38, 'C''était excellent moi-même qui suis une ados le mug cake est rapide pour un goûter ou dessert gourmand.', '2016-03-23T16:57:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 336c8789-103d-413e-8d5c-ce571e6e3a18, 'La meilleure recette de mugcake que j''ai pu faire ! Après 1min30, on a vraiment une texture gâteau, bref délicieux ! ', '2016-01-31T17:12:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, bf62c650-c426-4dae-a537-23707d2aa282, 'Excellent ! ', '2016-01-11T19:00:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 72a88e41-85bd-4ab6-a727-2bbfe9e5ef9c, 'Je n''ai pas mis le beurre, ni le sucre parce que je fais un peu attention a ma ligne, et pour évité que ce soit trop gras... Du coup c''était une recette presque diététique ;-) et vraiment bonne ! :-)', '2015-12-28T12:19:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, e5653948-a662-4194-817f-9eed18b28561, 'J''ai suivi la recette à la lettre et mon résultat est une espèce de bouillie spongieuse absolument immangeable. Lorsque j''ajoute la farine, elle fait plein de petites boules et ne se mélange pas avec le reste. Quelqu''un peut-il m''aider svp (je précise que je fais très rarement de la pâtisserie)?', '2015-11-17T18:03:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 9e6b8019-d9d3-4d96-a2af-44bde6562bd0, 'Recette pas terrible avec une texture vraiment pas agréable ! ', '2015-11-08T18:01:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 3bfeb986-5768-4e30-8655-a37a5f7206ff, 'Délicieux, facile et rapide ! Personnellement, j''ai mis 25 g de beurre et 15 g de sucre.', '2015-09-12T20:25:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 5d6a66fb-cd64-44a4-98de-6a54cb7ebf2e, 'J''ai suivi la recette à la lettre, la texture est parfaite mais c''est très fade au goût. Est-ce parce que j''ai utilisé du chocolat au lait? Et que j''ai mis de la pralinoise en plus en guise d''agrément...', '2015-08-10T20:38:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, da837b11-6ce4-4df2-a548-166328c3ac7c, 'Très déçue, texture étrange, impossible de finir tellement écœurant .. ', '2015-06-07T20:04:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 0faa084b-7973-43cc-bc84-6b0e62d6a9d4, 'Facile, rapide et delicieux ! J''ai juste rajouté quelques gouttes de vanille.', '2015-05-11T23:32:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 16e9f4da-fe0e-429a-a70f-7b45bb32009c, 'Personnellement je mettrai moins de sucre la prochaine fois. Sinon j''ai ajouté un peu de levure (une petite cuillère à café) pour que le gâteau soit plus aéré.  Sinon pour la cuisson je l''ai mis sur "Medium" environ 600Watt, et j''ai mis un temps au pif avec vérification de la cuisson de temps en temps. Et le résultat est top ! ', '2015-05-02T22:49:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, e0acaa1d-0436-4799-a77b-ca0d2af41520, 'Mugcake classique, j''ai mis beaucoup moins de sucre par contre...', '2015-03-30T21:03:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 86998e80-5f05-4e39-97f9-98470f2270c0, 'Super recette, testée delicieuse', '2015-03-27T14:32:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, dad5d67d-5420-4bff-bfd6-1cef811511b6, 'Facile rapide mais une texture entre le fondant et le flan... néanmoins ça se laisse manger !', '2015-03-21T18:30:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, e5e2cafc-438c-48de-be8d-640f8b53f81f, 'Simple, rapide et bon !', '2015-03-11T20:43:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 67a7bb89-2e29-4820-80b8-543a2507309a, 'Après une première tentative, et un certain débordement, le résultat n''était pas mauvais sur le plan gustatif, mais visuellement ce n''était pas gagné.... A refaire avec un mug plus gros peut être....', '2015-02-25T18:41:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 9c84a973-ff67-4b05-9ff9-6fed5e613f5a, 'Facile et trop bon ! ', '2015-02-03T22:56:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, a60e240b-a827-4280-b7b4-cf151d8eb865, 'Je viens de finir en suivant la recette à la lettre, l''aspect n''y est pas mais le goût y est. Je ajouté de l''amande en poudre et c''est juste délicieux. À refaire avec plaisir.', '2015-01-30T17:01:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 5de37a1c-5f4d-401a-968a-be92f19003cb, 'Je l''ai fait hier et je dois avouer que je l''ai totalement raté mai je vais me retenter maintenant ! ', '2014-12-13T20:27:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 702b60c3-648b-4bad-9dd3-ae092326b275, 'Mon mari en est ravi !', '2014-12-09T20:39:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, b3ef619e-43ff-4c73-8343-6f14c89d6eb1, 'Merci pour cette recette facile et rapide.', '2014-11-25T13:55:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 7de24fdb-cf43-44c0-a43e-6aac1f26077c, 'Excellente recette !! En a peine 10 minutes, on a un délicieux gâteau au chocolat. Avec un peu plus de beurre on obtient un magnifique moelleux !!', '2014-11-24T21:19:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 960f7500-0efd-4dea-9d27-e8c695466dd5, 'J''ai dû louper quelque chose car honnêtement, ça ne ressemblait à rien :-) au goût (car je ne gâche pas la nourriture, donc on l''a mangé), ça ressemblait à une mauvaise bouillie. Les indications de cuisson au micro-ondes sont peu être trop aléatoires, j''imagine que le problème vient de là. ', '2014-11-19T21:15:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 804ff8d3-94a2-44d8-b2d9-e374e6d82655, 'Merci beaucoup pour cette recette simple et très bonne.', '2014-11-19T17:54:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, f01886b8-8468-4732-a7c7-e2fb87eaff64, 'Facile, sympa et bon', '2014-11-11T17:20:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 53e4b457-2bf6-4b10-8604-e3976381d701, 'Très bon, facile à faire si vous devez faire un gâteau en très peu de temps c''est ce qu''il vous faut. ', '2014-11-06T19:11:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 840aa590-e580-45aa-8ea3-1cec430ecad5, 'Super recette, vous pouvez aussi la faire avec du chocolat en poudre ', '2014-10-26T19:08:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (304996, 45098584-1b9e-49b5-9467-109caa0cb97a, 'Pas mal, à déguster sur le moment sinon la texture est caoutchouteuse. 30 g de beurre pour 15g de sucre suffisent.', '2014-10-24T18:55:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80348, 16b46c30-ee21-4431-9400-52001b4b742e, 'Mes invités ont adoré, avec une boule de glace vanille... Je les ai servies chaudes, je les avais précuites 2h avant et les j''ai remis 10 minutes au four pour faire fondre, super au niveau présentation et au niveau gustatif... Cependant, j''ai mis moins de bananes, 2 bananes pour 200 gr de pépites et 6 cuillères à soupe de poudre de noisette et les aumônières étaient déjà bien garnies... Donc, pour ma part, moins de bananes, peut-être 1/2 par aumônières..', '2011-02-16T14:49:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80348, 50d522a6-d08d-4a65-8ba2-899e8103e3d5, 'Très bonne recette, toute la famille a adoré!  En plus elle est très facile à faire et très rapide ! Sans sucre ni beurre, elle est assez légère!!  Merci pour la recette! ', '2009-04-19T14:05:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305221, 0487e37f-2cb1-4209-829c-5f9175f35762, 'J''ai mis des cubes de mangues congelées à la place des glaçons et une petite cuillère miel pour remplacer le sucre. Excellent le smoothie.', '2022-04-24T09:19:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305221, 1ae67420-2889-4924-be23-2012004b9e8d, 'Vraiment bon !😋', '2022-04-22T20:02:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305221, 439216ca-1c21-49da-8f14-294b238b4b98, 'C est mon premier smoothie ! J ai pris les ingrédients pour 1 personne : 1 banane et 2 kiwi gold c était parfait ', '2020-10-08T19:39:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305221, 0db4abc9-fbad-4f34-b115-ff91bd8aff97, '3 bananes 4 kiwis une seule cuillère de sucre pour un résultat au top ! Miam !', '2018-06-18T20:01:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305221, abf59671-ca4a-47e4-af0f-d83714c1af8c, 'Bof, on sent beaucoup l''assidité du kiwi. Avec une pomme ce serait peut être mieux...', '2017-03-14T20:47:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305221, 33a323a9-8755-41f7-aa2d-a0ce2557f0cc, 'Le kiwi et la banane se marie très bien. J''ai ajouté un jus de pamplemousse pressé et 2 cuillères à soupe de fromage blanc. Pas de glaçons. Le résultat est délicieux.', '2017-02-12T10:38:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305221, 455c469a-7872-4a2f-9378-474041a4e136, 'Super recette, facile à faire. Je me suis permise d''ajouter une pomme.', '2016-12-14T19:32:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (343018, 555170e5-2eba-46a8-beea-87cfe6e2fbd1, 'Hyper rapide à faire, très bon. Laissez 21mn au four car 15mn c''était pas assez pour la pâte feuilletée.
A refaire pour un gouter gourmand !', '2018-03-07T03:41:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (343018, bfb4eb54-2136-4e98-8ba5-d9263388cf5c, 'Facile à faire, avec du gianduja à la place du chocolat et une banane bien mure. Dans mon four, plutôt 25 min que 15 min. J''ai placé le gâteau dans un moule pour éviter qu''il coule. Délicieux !', '2017-08-11T16:44:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (343018, 9315c260-bff4-4cae-a31d-5799902dd489, 'Je l''ai pour ma part faite avec une pâte à tartiner (Nocciolata), c''était délicieux ! ', '2017-02-13T20:02:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86881, 4a0e37c4-4948-4ad7-ba1e-65e128d45575, 'J''ai remplacé le citron par du jus d''orange et c''est pas mal du tout ! On a le goût du kiwi sans son acidité !', '2010-08-02T13:48:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86881, c5e06778-2959-4e60-826b-50f5a28508b9, 'Déjà l''aspect ont dirait de la moutarde à l''ancienne et en bouche c''est très acide !!!! Pas du tout aimé surtout de bon matin!!!!!', '2010-02-13T12:30:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49797, 7f49f65f-f74b-44cf-a4b9-7f0dbc1fcb65, 'Cette glace est hyper onctueuse ! J’ai été agréablement surprise de la texture et depuis j’en fais régulièrement, ça permet de se faire plaisir sans culpabiliser ! ', '2018-08-04T03:24:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49797, 6a6bfba1-8633-4615-8783-a11024172f09, 'C''est un délice. Comme j''étais seule je n''ai fait qu''une banane mixée dans un petit hachoir. C''est aussi onctueux qu''une crème glacée avec un anthentique goût de banane. Merci pour ce dessert hyper-light !', '2014-06-29T17:18:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49797, 2bc2c33e-2abd-4103-8906-91f317bc7700, 'Déçue. Sans intérêt.  J''ai du ajouter du lait pour arriver à mixer mes fruits dans mon blender. J''ai remis le tout au congélateur pour plus tard et à la sortie la glace était aussi dure que du béton et pleine de cristaux d''eau....', '2013-07-27T10:14:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49797, a80dd0f2-558a-44bc-b571-9c1a6085b145, 'Merci pour cette super recette! Très facile est vraiment bon! Génial pour l''été, on peut manger de la glace sans se sentir coupable! Ça va être la révolution de mon été! La texture est vraiment super! J''ai adoré !', '2012-05-27T03:52:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49797, de38d49b-d54b-4d81-8747-b17fa81bc24a, 'C''est très bon !! Je conseille de faire des rondelles de banane plus fines pour faciliter le mixage ! J''essaierai avec d''autres fruits comme la poire pour voir...', '2010-08-23T21:27:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49797, e31aa17a-057e-4646-9330-1538b64ce617, 'Excellent ! J''ai rajouté un peu de sucre et de crème fraiche...', '2010-05-04T22:37:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49797, 432e1d39-9721-4892-a3fe-6bc2fd485217, 'Petit dessert idéal pour les enfants et pour toute la famille.', '2009-04-25T19:08:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49797, b555e45d-d0ca-4f9b-9350-b29289ddfdcc, 'Très bonne recette, j''ai citronné les bananes légèrement avant de les mettre au congélateur, sans cannelle et très bon et pas de calories. A refaire très rapidement.', '2008-08-27T19:16:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49797, ee2b8d68-01be-4311-bd14-ffc7b6cde2e0, 'Très bon et rafraîchissant. Une façon astucieuse quand on a des bananes qui mûrissent plus vite que prévu. On peut le parfumer à son goût. Vraiment astucieux. Merci  Cécile.', '2008-08-07T17:58:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49797, 3eeadff6-02ae-49f7-958e-d24ed43b0bbb, 'Recette testée et approuvée! Tout simplement bluffant.', '2008-07-08T19:36:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49797, a23eb66f-7b69-429a-9ef2-55c7fa2d40a6, 'EXTRA bon, facile économique et light! On dirait vraiment une crème glacée.', '2006-09-11T15:47:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49797, ce172b74-9ca3-4bbd-bcde-4ca1020bf15e, 'C''est très bon mais attention à ne pas mettre trop de cannelle. On peut faire plus simple: écraser les bananes à la fourchette , rajouter un peu de sucre de canne, des morceaux de zeste de citron et un soupçon de rhum agricole si on aime. Bien mélanger à la fourchette pour obtenir une sorte de bouillie. Mettre au congélateur et déguster quand c''est pris.', '2006-09-08T18:13:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49797, 8bc76c35-1c86-4928-a0b8-b82d638e7456, 'Délicieux! Moi j''ai rajouté de l''eau de fleur d''oranger mais c''est juste parce que j''adore ça. Vraiment à conseiller.', '2006-09-08T13:54:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40528, 9846f06e-c61d-47d9-bfb7-721af4a089de, 'Un goût délicieux pour cette recette assez simple à réaliser. Une présentation pas évidente (les mirabelles collaient au fond du plat au démoulage) mais avec une petite boule de glace, on réussit à masquer tout ça. Merci pour cette recette ! ', '2015-08-23T18:38:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40528, 47721e22-da22-4838-b0a5-91724c39d185, 'Bonne tarte. Je tenterai peut-être de démouler tiède ou froid pour la prochaine', '2014-07-23T19:22:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40528, 60fc93b1-0b9b-440f-88f5-21e9c6b4604b, 'Pour moi non plus, aucun problème d''apparence ! J''ai utiliser les mirabelles du jardin. Elles étaient très acides mais grâce aux bananes, le goût s''est adouci. Le gâteau était simple à faire et délicieux !', '2011-07-26T19:41:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40528, a242b18e-bf75-4a4d-a337-fbdf89930745, 'La tarte est très bonne, bravo !', '2010-09-07T20:47:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40528, 6ad18ef9-ef4a-437a-a675-832c774170b8, 'Délicieux ! Et pas de problème de présentation. J''ai utilisé du caramel au beurre salé et j''ai proposé un peu de chantilly pour les très gourmands. Merci !', '2009-08-31T00:34:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40528, 53e9ffcd-d8c0-45f3-bb20-f36c4496e5ee, 'Un délice, on s''est régalé. Un petit souci de présentation pour moi aussi mais c''est tellement bon que ce détail est vite oublié!', '2006-10-01T14:04:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40528, 7e501a26-06b4-41e9-a77c-1b82aa955855, 'Très bon mariage, très bonne tarte! Un petit moins pour la présentation qui ne donne pas forcément un avis favorable mais "faut pas se fier aux apparences! ;-) C''est peut-être moi qui me suis planteée!" En tout cas, à refaire!!!', '2006-09-03T11:56:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 8aedcf51-9c6d-4e9a-b6a5-a9f4ee6630c0, 'Parfait en verrine ! Je fais la confiture de lait au Cookeo (24 min de cuisson suffisent). Avec seulement 50g de sucre et pas de beurre dans la couche de biscuits, qui sont simplement émiettés.', '2019-07-24T22:53:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 389335d1-a45f-4002-a447-1c0c63435847, 'Très bon malgré quelques retouches à faire !', '2018-09-17T14:29:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, fd1eab45-8da4-4ca3-b8e1-297205154bce, 'Très bon mais réduire le sucre et à laisser reposer la nuit pour une texture plus onctueuse ', '2018-03-07T11:33:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 3f537631-b9f6-429d-9531-cf700034ae20, 'Excellent !! Vivement conseillé !', '2016-11-19T20:17:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, c0684d74-25f1-4e1a-a296-df773ef5e703, 'Excellente recette que j''ai suivi à la lettre ! Je ne le trouve pas tant sucré que ça puis le lait concentré est très sucré de base donc normal !! La prochaine fois j''essaie de mettre moins de beurre dans le biscuit car là il était un peu dur mais je l''ai présenté en verrine c''est peut être pour ça.', '2016-05-09T15:58:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 8bf62566-546b-4b9c-9e6c-cc595cd0a3e4, 'Très bonne recette, également trouvée top sucré, la prochaine fois je diminuerai le sucre mais bon une fois de tant en tant, on se fait plaisir !', '2016-04-13T01:35:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 40c766ba-9d47-4410-aa4e-a1610164aef0, 'Extraordinairement bon ! Ca fait longtemps que je ne m''étais pas régalée autant avec un dessert. Je l''ai servi dans des verres individuels mais j''ai trop tassé le biscuit donc il était trop collé au fond, ça n''arrive certainement pas avec un moule à charnière. J''ai suivi les conseils des autres et réduit un peu la dose de sucre, et c''était parfait. A faire et à refaire et à rerefaire. D''ailleurs, autant faire cuire deux ou trois boîtes de lait concentré ensemble comme ça hop, confiture de lait toujours dispo dans le placard !', '2013-03-25T16:34:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 8dc154da-5947-4275-8402-31f94b1d135a, 'Délicieux!! Même si ce n''est pas facile de faire de belles parts, c''est si vite mangé que ce n''est pas grave !! Un régal !!', '2012-08-28T18:16:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, de1860c2-0fe5-4934-b617-7d6414d91afb, 'Cette recette a eu un franc succès. En tenant compte des différentes remarques, je l''ai un peu modifiée. J''ai divisée la quantité de sucre par deux. Pour une meilleure tenue, j''ai mélangé un sachet de gélatine en poudre au toffee. Et pour une crème plus onctueuse, j''ai incorporé avant la mascarpone 10 cl de crème fleurette montée en chantilly. Et c''était un vrai régal.', '2011-07-24T16:03:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, e1006dbd-99c5-4395-8874-8bb8a4351d76, 'Un délice des Dieux ! Je les ai faits dans des coupes individuelles en verre : magnifique car on voit bien les différentes couches ! Mettre moins de sucre effectivement dans la mousse au mascarpone car le lait concentré sucré est vraiment très sucré ! La prochaine fois j''essayerai de mettre de la gélatine ou de l''agar-agar dans la mousse au mascarpone pour que ça se tienne mieux et mon mari veut que je fasse une couche de chocolat dessus... Je vous tiens au courant !', '2010-08-29T15:19:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 32b02332-9fc4-4648-986d-0bdedfa47cec, 'J''ai suivi les commentaires et mis un peu moins de sucre dans la crème au mascarpone. J''ai utilisé des petits beurre car c''est ce que j''avais dans mon placard ! Cette recette est délicieuse, tout le monde a adoré même mon mari qui n''est pas gourmand et ma fille aînée qui n''aime pas trop la banane !', '2010-05-25T16:09:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, b9e7027b-d0ac-4648-b04e-239d6b29ea47, 'Excellente recette, très calorique mais délicieuse. J''ai diminué à 80 g la dose de sucre. Merci pour cette recette', '2009-12-19T15:59:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 76c7e56f-806f-445c-8b53-b3de8527c029, 'Ravie d''avoir retrouver cette recette! J''avais l''habitude d''en manger quand je vivais en Angleterre. J''ai dut utiliser 1 boîte de lait concentré sucré de 1 Kg ( impossible de trouver plus petit! ). On a de quoi faire 2 banoffee! Sinon je mettrai moins de sucre dans le mélange mascarpone/ oeufs en neige: 100 g donne 1 résultat trop sucré à mon goût. Sinon rien à redire.... sinon que je me suis régaler! Recette facile et délicieuse: Yummy!!!', '2009-03-03T18:41:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 6373a34c-dca6-475b-9280-977b48c81fb3, 'C''est un délicieux cake dont je cherchais la recette après l''avoir gouté dans un salon de thé... Résultat de la recette : un goût génial, mais il faut être très gourmand pour finir sa part... Une astuce pour les biscuits à écraser pour faire le sablé : le rouleau à patisserie, ça marche bien mieux que mes petits doigts!', '2007-08-01T17:55:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 68d3360f-7fd2-4521-8cb6-9e7bce557050, 'Délicieux! C''est un gâteau que j''ai decouvert quand je vivais à Londres, il y a longtemps... Et faute d''avoir la recette, je n''en ai jamais plus remangé. Merci infiniment! La seule difference, avec la recette donnée ici, c''est que la crème au mascarpone était parfumée au chocolat... Hummmm... C''est une pure merveille, à faire et à refaire!! ', '2006-04-23T20:47:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, ccf6b91e-4804-48f7-b341-e1b24730b93a, 'Le cheesecake avait franchement peu de tenue, la confiture de lait coulait autour. Cependant, il était délicieux et ce serait dommage de jeter le bébé avec l’eau du bain, je pense donc le refaire sous forme de verrines, en transformant le fond de miettes de sablés et beurre en une simple couche non tassée de grosses miettes de sablés, puis en empilant le reste comme indiqué dans la recette. Je n''ai utilisé que la moitié du sucre, c''était parfait.', '2019-02-22T12:29:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, a8f34b55-23e9-4ac3-92db-a9f6438e15ff, 'Dessert beaucoup trop sucré, écoeurant et trop liquide pour la crème à la mascarpone. Je suivrai les  conseils la prochaine fois!', '2016-11-18T18:55:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, d18d2f9c-44b9-4510-b905-801d2a49c83f, 'On peut dire que c''est un loupé. Déjà le toffee était très très liquide même avec 2:30 de cuisson. Donc sur les conseils j''ai fait en deux temps, la couche de biscuit puis le "toffee" une nuit de plus au frigo. Mais là, même le mascarpone avec oeuf en neige ne donnait aucune consistance. Qui plus est le biscuit était dur comme la pierre donc immangeable alors que le reste était un liquide pas terrible...', '2016-06-15T15:18:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, d3ee6b6a-5106-4d64-9962-7707d431d20c, 'En diminuant le sucre : excellent,... présenté en verrines : top!', '2016-05-06T15:35:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, d80e38f4-2f0f-4015-86f4-75f0f1c0948c, 'Goût parfait, bien prendre en compte les commentaires, à savoir : 100 g de biscuits en plus, ajouter de la gélatine à la confiture de lait et réduire le sucre pour la crème mascarpone.', '2016-05-01T22:07:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, c8cff6c0-0898-4e21-81c2-cdb2addbd1e3, 'Bon mais trop sucré. Le toffee n''a pas cuit assez longtemps . La prochaine fois je le ferai en cocotte minute. ', '2016-04-18T00:10:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 622fb13f-5add-461c-9bf8-ca17b420f2fe, 'J''ai suivi les conseils donnés sur le sucre et je n''ai mis que 50 g dans le mascarpone, par ailleurs on a tous préféré ce dessert après qu''il ait passé une nuit complète dans le frigo, c''est bien meilleur!!', '2016-04-17T22:57:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, b116410d-7639-4dbc-ae3e-354e422c8e43, 'Bon mais écoeurant car trop sucré. La prochaine fois je diminuerai de moitié celui-ci.', '2016-04-17T02:01:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 90adec9a-36c1-4bc4-bc56-ecdff33ea317, 'Extrêmement trop sucrée et le mélange homogène de mascarpone, sucre et blancs d''oeufs en neige est très difficile à réaliser.', '2016-04-14T11:10:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 19dc5e76-0ce4-464c-aca7-bf640b3b6a3a, 'Super !', '2016-04-12T22:51:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, e7959c2b-c5d4-4a11-91fc-3eefdc01b933, 'Un banoffee sans coffee...sacrilège ! Sinon un peu trop sucré, seul bémol notable sur une recette simple et bonne.', '2016-04-12T19:23:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 8aeae11a-a15b-4fb8-8de1-520e825896da, 'Je vais le refaire dans pas longtemps.', '2016-04-12T19:22:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, e869f9a8-ce04-4757-a483-959376f8add8, 'Très bon mais trop sucré, je pense diviser par 2 la dose de sucre. J''ai utilisé des petits beurre, cuisson du toffee pendant 2h15. En revanche le mascarpone est trop liquide, il faut une nuit entière pour que ça prenne donc je retenterai avec de la gélatine mais j''ai un doute sinon plutôt une chantilly mais ça aura moins de goût. J''ai remis au frais après le toffee et avant la banane. A refaire !', '2015-03-19T21:23:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 8980f001-b8df-48fb-89fa-399b54ec92ff, 'Une catastrophe... À éviter', '2013-01-07T21:02:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 81446c60-4f51-4280-83fb-1548251b54a2, 'Très bon et gourmand ! Par contre j''ai augmenté la quantité de spéculoos et de beurre(1/3 de plus) car je trouvais que la base était un peu trop fine. Et aussi j''ai suivi les conseils et ajouté de la gélatine à la crème mascarpone. Ca plusieurs fois que je le fait, les invités sont toujours surpris car ce dessert n''est pas très connu en France et en redemande !', '2012-02-23T22:05:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 77b173ed-1e6e-478e-96d3-d470ddfb78b6, 'J''adore tous les ingrédients, donc forcément je trouve la recette très bonne, si je n''ai mis que 4, c''est parce que le tout est un peu lourd quand même (prévoir de faire la recette à la fin d''un repas très léger), et que j''ai trouvé que ce n''était pas très présentable d''aspect.', '2009-11-04T20:21:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, 26fb35df-4ceb-47d8-a4b7-f519533568a4, 'Dessert vraiment trop sucré, dommage...', '2007-09-20T22:31:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46275, c3037918-ea77-4909-9ab7-dc7dee6b449d, 'Totalement calamiteux sur le plan esthétique!!! Je me suis pourtant strictement conformée à la recette, mais le "caramel" reste très/trop liquide, si bien que l''ensemble se sauve, dérape, glisse, coule, dégouline... sur le plan gustatif, en revanche, c''est un régal. ', '2006-10-31T15:01:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167908, 6691a452-0ebd-42eb-91cf-e1ee606b5ea0, 'Pas très présentable, et pas terrible...dommage', '2010-08-16T16:32:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51644, a9e4513f-0f88-4a1c-8614-3f859a9a78b4, 'Je n''ai pas ajouté de cannelle ni de vanille et servi avec une boule de glace vanille. Peut-être un peu trop sucré...', '2008-02-09T11:36:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25207, 2b72ccb7-fd0d-4130-9455-a8d23cfc2877, 'Merci à Céline et à son papa pour ce dessert simple très apprécié des enfants. A servir dans des petits plats individuels avec 1 coulis de fruits pour 1 belle présentation.  ', '2007-06-18T15:17:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15401, 45f0952d-91b6-4141-b683-9afa04aeb1f9, 'SUPER SYMPA, je passe les bananes au robot pour éviter les morceaux et je mets un peu  plus de citron par gout....', '2010-01-27T21:30:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15401, 6fe48457-ee3d-47a4-a63a-c9838632959b, 'Un dessert un peu sucré mais frais...dans les ramequins on peut jouer avec les couleurs en dessinant des figures (par exemple) en fruits. Pensez au chocolat noir râpé!', '2005-09-10T21:12:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15401, c44e1a2e-4fca-40b4-ba9c-6285c1b5d7d3, 'C''est bon, mais avec la crème chantilly, c''est un peu lourd. Ca allègerait plus avec du yaourt que du fromage blanc. Ca serait meilleur avec des copeaux de chocolat, car le chocolat va très bien avec les bananes.', '2004-04-07T12:10:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15401, 5c6d2e4c-6c55-4211-90a9-449a256d8544, 'Ma fille (6 ans) l''a dit : c''est "super-méga bon" ! J''ai mis moins de sucre et j''ai remplacé le fromage blanc par du yaourt, et les grands ont apprécié aussi !', '2003-12-29T22:36:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 316b14ae-b925-4da7-8585-b2ab57fd28d5, 'Très bonne recette. Je cuis la meringue à 100°C pendant 2h ainsi elle reste bien blanche. Je garnis à la dernière minute et c''est un vrai régal.', '2019-04-14T12:27:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 97804ab7-36a5-4ff6-bc43-2fa7c7fb505c, 'Dommage que je n''ai pas lu les commentaires avant de me lancer ! En effet, le four à 170°, c''est beaucoup trop chaud... Résultat, ma Pavlova était toute plate et j''ai dû recommencer !', '2014-01-11T20:05:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 1f3d4580-1495-455b-835c-2a17e26b5e20, 'Excellent dessert si on respecte bien les températures (préchauffé à 170°C puis cuisson à 110°C). J''ai tout préparé à l''avance y compris la chantilly et j''ai assemblé à la dernière minute pour garder le croustillant de la meringue. Délicieux !', '2013-04-13T14:42:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, e7a3c78f-4693-4ee4-83fa-8cfd956c0b0b, 'Tout simplement excellent ! Très joli et très bon. Petit bémol tout de même sur la température du four... Premier essai de la meringue raté... J''ai un four à gaz, donc thermostat 6 c''était beaucoup trop. Deuxième essai à thermostat 1 et four entrouvert... Ma persévérance a payé. A refaire !', '2013-03-02T11:07:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 56eca821-7a18-4145-8ef2-ddf5d956f2aa, 'Petite astuce; Le maintien après la découpe n''est pas toujours facile donc personnellement j''utilise des cercles de 7 cm de diamètre x 5 cm de haut(coupé dans un tube PVC du magasin de bricolage)ce qui permet de faire un dessert individuel pour chaque convive.', '2013-02-24T10:57:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, c61c0de5-c41c-4695-bc51-73b3c5f52980, 'Superbe recette ', '2020-12-19T19:38:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 2dccebeb-efde-4a30-bd98-8d4f76e2792a, 'Dessert réalisé aujourd’hui même pour Noël, pour finir avec un peu de légèreté. C’était très bon, j’ai peu sucré la chantilly pour contre balancer avec la meringue. J’ai mis : kiwi, banane, clémentine, litchi, grenade et fruits de la passion, très bon!', '2019-12-25T07:54:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 81803f88-f925-423a-97f9-7f302ce10e10, 'Cuisson 2 heures à 100 degrés et c''est parfait.
Préparation meringue faite en 3 minutes avec le robot pâtissier.', '2019-10-07T03:58:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 62b6d68a-1f63-41fa-b85b-70003ed64d74, 'Merci pour la recette 2 modifs pour ma part : réduire le four à 110 degrés pour la cuisson et diviser par 2 (au moins) le sucre, les quantités indiquées dans la recette sont beaucoup trop élevées !', '2019-07-29T10:13:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 40daa8c5-4ab4-428b-a430-d56f5c167c33, 'Super recette, succès au premier essai.', '2017-01-01T11:54:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, ff608d53-64a3-41ad-adee-50bbe73a8a10, 'Bluffant aux yeux et délicieux au palais! Je mettrais quand même moins de sucre la prochaine fois. Merci pour cette recette facile!', '2016-05-22T14:05:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 1e25d98a-772f-49a4-9db7-164455e29130, 'Ne pas mettre de mascarpone à l''intérieur ça casse la chantilly mais ajouter de l''eau de rose c''est délicieux !', '2016-02-22T15:04:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, ff217475-129c-465d-8226-00f767b1f3f3, 'Superbe recette. J''ai enfin réussi ma meringue avec cette recette.  ', '2015-04-14T16:46:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, b9aad909-8ba0-4528-af6b-676ec6012057, 'La meilleure recette du pavlova. En suivant les indications, il est impossible de louper ce dessert délicieux et gratifiant parce qu''il en jette pour très peu de travail. Il est devenu un classique chez moi les soirs de fête, la famille se régale et les invités en prennent plein les yeux  ', '2014-12-31T13:29:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 8f1329c0-45a1-4858-a495-ff99d829a920, 'Excellent, très bonne recette et qui présente très bien ! J''obtiens des félicitations de la part des convives. Une toute petite variante, je mets du vinaigre de framboises à la place du vinaigre blanc. On reste toujours dans une note fruitée !!! Merci Marmiton.', '2014-07-14T09:42:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, db5c6643-60a2-42db-a517-3e122f231dbb, 'Très bonne recette, cependant il faut mettre la chantilly et les fruits en toute dernière minute car tout s''écroule en restant au frigo ! ', '2014-06-25T13:26:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 042044f3-ba1c-461d-b559-c286e700196e, 'Excellente recette ! Je l''ai faite avec du vinaigre de vin blanc à la framboise, ça donne un très bon goût à la meringue, tout le monde a adoré. Je l''ai également faite en format individuel pour éviter le désastre de la découpe sur la meringue, ça fonctionne bien.', '2013-12-29T21:22:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 5a96ac11-e791-4589-aad0-ce2d4394be64, 'Un peu trop sucré à mon goût... mais mes invités ont adoré. Merci pour le partage de cette recette.', '2013-07-24T22:17:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, b520d448-599a-4a7a-aec6-3fabdb094a4c, 'Un succès à 100% auprès des mes invités, et très frais par temps de grosses chaleurs, un gâteau fait avec pastèque-banane, et un autre fait avec fraises-kiwi.', '2013-07-22T14:27:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 6dacf4a8-4b15-4b38-8a3c-1d7001239f03, 'Excellente recette : rapide, facile, esthétique et très bon ! Vraiment, tout le monde a adoré, moi y compris !', '2013-04-13T14:55:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 4564383c-6142-40f8-b8ce-06456026f496, 'Très bon et léger, à refaire.', '2013-04-06T17:11:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, ae613722-0661-4100-92db-2b84f84049e6, 'Ce dessert, c''est juste une tuerie !!!', '2013-02-24T18:19:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 2c660cc8-d97b-431d-b539-2b744a4243ee, 'Très bon et simple à faire ! J''ai suivi les conseils pour la température du four (préchauffage à 170°C puis cuisson à 110°C) et cela a très bien marché. La meringue est difficile à décoller mais ce n''est pas grave car les cassures sont cachées après. Seul bémol : un peu trop sucré. Néanmoins, très recommandable !', '2012-07-29T00:28:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 23791a5b-2acb-4915-81aa-069cba936345, 'J''ai suivi les précédents commentaires pour la cuisson (préchauffage à 170° puis cuisson à 110° pendant une heure et demi et refroidissement dans le four éteint avec la porte entrouverte). Pour la chantilly, 50cl de crème, 30g de sucre et 1 sachet de sucre vanillé et c''était parfait pour nous ! En fruits : fraises, nectarines, pêches et pulpe de fruits de la passion ! Miam !!', '2012-07-01T21:04:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 2989dd6f-8f54-456f-98b7-c01ecc82f5cb, 'Délicieux. Présente bien mais difficile à couper et encore plus à servir !', '2012-06-23T17:40:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 233ff6ff-e1fb-4678-bcd2-f9663eb8d8ae, 'Pour éviter que ça se ramollisse, si toutefois on veut le préparer à l''avance, il suffit de tapisser le centre de la meringue avec du chocolat fondu qui en refroidissant va sécher et donc isoler le fond qui ne craindra plus l''humidité de la chantilly et des fruits !', '2012-02-03T01:30:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 84231bdf-7f57-439b-8329-7c2770d1f910, 'Même remarque sur la température, il faut descendre à 110°C une fois qu''on a préchauffé à 170°C, puis 1h30 de cuisson. Sinon, c''est excellent et bien détaillé.', '2011-08-09T19:41:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 115f7481-b3b5-4eab-b687-85ae94e14a67, 'La meringue doit cuire à 110/120°C maximum pour rester tendre à l’intérieur, c''est la seule modification que j''ai effectué sur la recette. Personnellement, j''ai réalisé le montage à la dernière minute (tous les ingrédients étaient préparés à l''avance) et le résultat était magnifique. Très bonne recette !', '2011-06-12T14:16:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, f556c9d5-8260-4a70-b293-55837b9ba664, 'Je pensais jamais y parvenir ! Délicieux. J''ai toutefois réduit la température pour la cuisson (le dessous de la meringue cuit trop vite - donc 100°C) mais allongé le temps (2h). Mis un coulis de framboises entre la meringue et la crème, pour éviter l’écœurement. Même au frigo, le lendemain, c''était une petite merveille. Merci !', '2011-05-22T17:44:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 5a389712-fcd0-4e18-a848-0a6fe02e72b3, 'Top ! Ou comment impressionner vos invités... Je fais la meringue à l''avance, je coupe les fruits à l''avance, on peut faire de même pour la chantilly et je garnis au dernier moment pour garder le croustillant de la meringue. Le mélange des textures se fait...', '2010-07-30T15:00:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, b449b57f-dd09-4df1-b011-34b48da6d161, 'Je vais faire baisser la note mais les gens qui veulent faire cette recette doivent savoir que la meringue est très fragile. Je l''ai garnie 2 heures avant de la servir et la chantilly a été absorbée et a tout ramolli, c''était donc en milles morceaux dans l''assiette de mes invités. Par contre au goût c''était quand même très bon. Donc je conseille de garnir les parts juste avant de les servir.', '2009-04-06T19:25:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 9430bb0b-6357-458c-9130-fa3a7ba16212, 'Une pure merveille!', '2009-03-28T16:22:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, 04d17ca8-bd5c-4506-9abd-3d7222f19337, 'Une merveilleuse réussite. Je n''osais pas me lancer vue la longueur de la recette, mais c''est extrêmement facile à faire et tellement bon.', '2009-02-22T18:55:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69281, be0d1afb-fa3f-411d-99d6-7e4d3ef6d013, 'Superbe. Mille mercis. Tout le monde en a repris....personne ne voulait croire que je l''avais faite moi-même.', '2008-10-10T09:37:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 50ad84b4-79c6-4752-86cc-63130da9aea9, 'Sublime...
Petit conseil (important): une fois sorti du four, attendre qu''il refroidisse, le démouler délicatement, et le mettre 1h30 au frigo...
Une fois sorti du frigo, ce mi-cuit est formidable.', '2020-05-11T17:09:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 3afceaed-69a9-4396-853e-aef06f8257cb, 'Très bon ! Le meilleur est d’attendre le lendemain, (si mangé de suite après cuisson il est un peu lourd), le lendemain c''est divin. Le goût de la banane est assez fort, mais très bon. Je me demande toute fois s''il ne serait pas meilleur avec un petit peu moins de sucre, a voir selon les bananes que nous avons.', '2011-07-10T23:38:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 40185577-f0a8-4af2-b579-edb5e5d1cc76, 'C''était bien bon, mais je l''ai trouvé trop chocolaté à mon goût. Ceci dit, j''ai utilisé du chocolat à 71% alors ce doit être de ma faute. La prochaine fois, j''en mettrai moitié moins. Merci pour cette excellente recette!', '2011-04-01T00:15:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 59b1e03c-811b-48fd-8138-c8bded34188b, 'Très bon gâteau et toute la famille s''est régaler ', '2023-11-09T20:48:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 21512bcb-ad2c-44c4-b4b9-bc17e38bf10d, 'Juste une tuerie !!! Recette suivie à la lettre et conservée au réfrigérateur pour apporter une fraîcheur. Tout la famille a validé le dessert 😋', '2023-07-22T15:32:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 5847aabb-37b7-4632-ad10-e2289adcd5e5, 'Top ! J’ai juste modifié la cuisson à 180 degrés pendant 25min ', '2023-07-06T21:40:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 6a810954-d24f-4e65-b75d-117597ad69a4, 'Magnifique, tout est parfait... La recette est à respecter à la lettre pour une petite merveille validée et redemandée par tout la famille 😍😍😍', '2023-05-04T14:28:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 80660ed0-eadf-40e6-8131-28c2dee7ad4f, 'Un véritable délice. ', '2023-04-13T02:50:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, c1da44b2-77fb-4d2e-8f25-fc838e7cf29d, 'J''ai remplacé la banane par du Nutella sur le dessus, ca a l''air bon !!!', '2023-02-12T20:52:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 54352554-6c87-44c1-ae5c-24fd4a461552, 'J''ai ajouté un sachet de levure et 10 min de cuisson. Excellent ! ', '2022-12-01T21:22:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 32834e5b-6521-4135-a3f8-9e76335182e4, 'Excellent', '2022-09-11T21:48:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, a2875a53-3d58-48b3-95a5-240256e68c31, 'J''ai fait la recette pour 4 personnes et j''ai mis 2 bananes et 150g de chocolat noir.', '2021-11-24T17:52:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 6a0f30f8-1489-4e44-bb88-602128507e60, 'Très bonne recette, cependant le temps de cuisson n’est pas du tout suffisant ', '2020-06-01T19:31:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 27e824b1-bec2-432b-a117-53208d80d8f4, 'J''ai ajouté le sucre vanillé comme conseillé. 30min à 150 c''était parfait!', '2020-04-20T10:06:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, b6a01bfb-36f2-44d9-9ed2-d3beedbe7d20, 'Une tuerie trop bon. Un des meilleurs que j''ai fait. Merci.', '2020-01-23T18:43:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, b216e687-60ad-4f83-b3f7-ea74b9890728, 'Bonjour, recette très bonne mais après 40 minutes à 150°C le brownie n''est toujours pas cuit. La prochaine fois je cuirais à 180°C.', '2020-01-05T20:37:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, fc95af3a-93db-41b9-8658-6415271e8620, 'Très bonne recette.', '2019-09-17T06:58:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 10082103-207c-486f-87fc-34302ad0a3fa, 'Très facile à faire.', '2019-05-26T09:29:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 8149e2b8-0bb3-428b-a9ff-e383ac79dd57, 'Délicieux ! Recette réalisée à la lettre et le résultat est vraiment fondant.', '2019-03-25T11:09:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, db8002c6-0484-4d2d-ab6f-0f5aadeafa10, 'Certainement meilleure avec du chocolat noir comme indiqué.', '2019-02-28T07:23:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, c919b214-bc2a-42c9-9ecc-f44d41a54552, 'J''ai mis du beurre demi-sel, et suivi la recette à la lettre, mais la prochaine fois je mettrai le chocolat et le beurre à fondre ensemble.
Toute la famille s''est régalée à la dégustation.', '2017-07-30T11:35:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, e1aa570c-d724-4b64-ab27-c6c4585d6da0, 'Delicieux, j''ai mis 3 bananes et j''ai dû mettre 15 minutes en plus (four éléctrique). À refaire!', '2017-07-17T04:59:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, ce2754bc-5485-4930-9b5e-c7bc2cee52ce, 'Recette testée et largement approuvée ! Ce brownie est tout simplement délicieux. J''ai mis une banane de plus et ai ajouté des noix.', '2017-03-05T18:05:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 4b7a72a9-03f1-4117-9b4d-249d9b67c152, 'Une recette suivi à la lettre ou presque, j''ai remplacée le chocolat noir par du chocolat au lait ... Un délice !!! Surtout sorti du four, MIAM.', '2016-11-23T00:32:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, f4e4024d-ae95-42f1-8f8a-3581e65ff42d, 'Très bonne recette, tout le monde à adoré à la maison seule variante apporté, pas de beurre donc margarine et 4 petites bananes. La prochaine fois je mettrais peut-être un peu moins de sucre.', '2016-09-07T16:21:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 2390c615-6eab-45b5-b544-118bbe6dcdf1, 'Je n''ai mis qu''une banane et des amandes effilées. Mon mari, qui n''aime pas trop les gâteaux fondants, a beaucoup aimé. Ma fille de 6 ans aussi.', '2016-05-30T23:23:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 948da6d6-1aa5-473a-a6e8-461d92a5ce82, 'Excellente recette ! J''ai respecté les quantités et le temps de cuisson et c''était juste parfait et délicieux. Je recommande vivement cette recette. Bravo', '2016-03-10T17:50:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 912ae909-def1-4480-a211-e473188a04fc, 'Très bon même sans les bananes. Je l''ai fait avec du chocolat aux noisettes.', '2016-02-21T01:05:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 84ca3ba6-b005-4528-a3a6-2fcb7fe4813c, 'Un vrai régal et super simple à faire!  Je mets dans mes recettes préférées ', '2015-11-03T19:03:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 05f9db1e-6c75-40b2-95f1-690f11694a7e, 'Très bon et facile à faire', '2015-07-10T14:51:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 51365f7c-0320-43f1-91f7-95d40e2ba5fb, 'Simple à réaliser ', '2015-02-27T08:17:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 51c45860-c0a4-43ff-8988-914f41dd7789, 'Délicieux.', '2015-01-31T21:48:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, c44f1d6c-3e52-4226-a8f2-29de09f8bb20, 'Un régal', '2014-12-03T12:03:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 59c7da61-f505-478c-9de5-8c8671d27838, 'Très bonne recette !', '2014-12-01T20:46:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 3910a982-1842-4688-8a16-6489cbb6da0a, 'Excellente recette facile à faire. Un délice ! ', '2014-11-12T15:37:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, a066ab26-0117-44ac-9e15-4bfb0b29fedb, 'Parfait !', '2014-10-05T01:36:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 23be1503-d17e-4714-ae59-55e7b65e1b67, 'Super bon brownie ! Original. Mais j''ai dû le laisser 10 mins de plus au four, je pense que ça dépend des fours. ET il est même meilleur froid. La prochaine fois, je vais ajouter de la noix de coco dessus pour un goût différent...', '2014-09-13T17:48:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, b0b9f4c1-4e9b-49a5-916a-6eeffba0d121, 'Très bonne recette de brownie et rapide à faire', '2014-07-17T22:16:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, e09aac60-ced5-4257-bb22-b405ea8438ed, 'Excellent ! J''ai ajouté une pointe de rhum par goût personnel. Tout le monde s''est resservi : facile, rapide et efficace. Merci pour cette recette.', '2014-07-14T17:10:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 069c95a3-c098-4fe7-bc60-b0276e13d596, 'Mmmmmiam !', '2014-05-19T16:33:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, df7c7d1b-2dd1-4be0-b7fa-e767fc688a33, 'Une très bonne recette et c''était vraiment délicieux', '2014-05-14T16:47:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 16924bdb-2fbf-41c0-9c92-cdfff2bf3817, 'Merci pour cette excellente recette que je viens de déguster... j'' y ai mis 90 g de sucre, trois petites bananes et j''ai parsemé d''amandes effilées. A refaire !', '2014-04-02T13:05:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, d4e2fb5e-cec1-4daf-812a-d6c147167440, 'Simple, rapide et délicieux!', '2014-02-09T13:45:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 00998756-8559-431c-9483-e2a4d26000d7, 'Je l''ai cuit 10 min de plus et je me demande si j''ai bien fait, 5 min aurait été mieux pour plus de fondant.  Le goût est bon mais il est costaud, à manger plutôt au goûter ! ', '2014-01-25T15:05:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 4a7aa528-fe89-472c-bb86-1786834e2593, 'Très sympa comme dessert, meilleur à manger froid. ', '2013-11-11T19:50:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 8bc7ba59-1b3f-4a2b-972f-1b1cb4c23455, 'UN VRAI DÉLICE !!!  Je l''ai mis presque 10min de plus dans le four, il était trop coulant sinon.', '2013-08-15T14:30:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, e3d201bc-94ee-46e4-a4b2-24fa75663108, 'J''adore cette recette, je la fais quasi tout le temps ! Je rajoute parfois de la noix de coco râpée. Et je mets 1 quart de sucre vanillé au lieu de la totalité en sucre blanc. Ma famille raffole de ce gâteau et me le demande tout le temps car je mets les rondelles de bananes coupées en deux dans 2 cuillères à soupe de rhum et un peu de sucre roux pendant que je prépare ma pâte. Je verse le tout après dans ma préparation. Ce gâteau devient juste excellent ! (Du moins pour ma famille et moi même !)', '2013-06-19T03:02:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 7c40ef09-8167-4620-a92d-033bb18201dd, 'N''ayant pas de moule carré, j''ai dû utiliser un moule rectangulaire beaucoup trop grand pour les proportions inscrites ici et donc j''ai préféré ajouter un sachet de levure pour que le gâteau gonfle un peu dans ce moule et réduire le temps de cuisson de 10 min. Cela a bien réussi, mon ami se régale avec. Encore merci pour cette recette délicieuse.', '2013-05-22T18:13:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 3b49691b-0d76-46a1-b1d3-7768989a36c0, 'Très bon. j''avais ajouté de la levure sur conseil d''un commentaire mais il ne faut pas. Mes amis se sont resservis. A refaire sans levure !', '2013-05-09T11:08:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, e5fdd4f2-e580-4e0b-8046-52c605ea19e5, 'Très bonne recette ! A refaire ! Très facile à faire pour les débutants.', '2013-04-13T20:31:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 3a9d455d-83bc-4642-ad5f-54bef02079c2, 'Nous avons respecté les proportions, et le résultat est un peu décevant. Le gâteau est bon mais il est vraiment lourd, et donc pas très digeste.  Avantage: il est facile à faire - avec un enfant. Et rapide aussi.  Mais franchement, je ne le referai pas.', '2013-03-27T00:19:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 8e885e5f-bda2-4883-a96f-2e01d7036572, 'Délicieux !!!!!!', '2013-03-26T22:04:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 7d8802df-0d02-446b-baf2-4c8eb441333b, 'Excellente recette... Un vrai délice !', '2013-03-09T22:37:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 95533fbe-f045-4e16-aa9e-58a599e36cf4, 'mon fils de 2 ans me réclame souvent le gâteau au "cocolat" avec les bananes... c''est donc une réussite par contre, je mets des bananes bien mûres pour avoir un côté bien fondant ! ', '2013-02-21T06:06:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 5441b39e-3f06-4a21-89b2-c66a2efb92de, 'Délicieux ! Rien à changer dans la recette, tout est parfait, cuisson comprise ! Toute la famille s''est régalée ! Bravo.', '2013-02-03T17:18:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 3c22a9b0-32af-4629-af61-556f4741aae8, 'très bonne recette! j''ai ajoutée un peu de levure chimique pour qu''il soit plus épais et moelleux : un succès !', '2013-01-19T14:14:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, d4dee4f7-6b83-4779-9aea-92578d03ebf1, 'Un pur délice ! J''ai utilisé des moules individuels et j''ai réduit la cuisson de 1O minutes. C''était parfait ! Merci de nous faire partager cette gourmandise...', '2013-01-15T19:09:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 2eef4adc-79a2-4bc9-aff9-e641bb51e09b, 'C’était délicieux mais en petite quantité car c''est riche !', '2012-07-06T20:19:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, c56a2920-53fa-4584-af54-e42a14060b74, 'À chaque fois que je suis invitée, on me demande d''en apporter !! L''alliance chocolat banane est là encore un succès. Merci pour cette recette', '2012-02-05T08:37:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53461, 2ad00806-29a5-41ce-91d3-7d3a91b1a2fb, 'J''ai suivi la recette à la lettre, et c''était parfait ! Ce brownie dense et fondant a eu un grand succès.', '2012-01-24T13:03:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81321, d9951f03-0883-40d5-803c-7a2c688c3a43, 'Plat complet et très facile à réaliser, en peu de temps. Je n''avais pas d''épinards surgelés donc j''ai mis une boîte et je l''ai fait dans une papillote de papier sulfurisé. Vraiment très bon. Je le referai.    ', '2011-04-01T21:12:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 74dc08be-21ab-4418-9a15-02adebd7a029, 'Délicieux. La recette a donné 16 meringues. avec le reste de meringue et de chantilly, j''ai fait un dessert chantilly/meringue écrasée/amandes effilées grillées, puis dans un moule à cake et au congélo. A accompagner d''un coulis de fraises ou de framboises.', '2023-10-31T11:15:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 7e8ae44b-b56d-453d-8d2e-cb39935ad945, 'Succulent. La meringue croquante à l’extérieur et crémeuse à l’intérieur. J’ai toujours du mal à la déplacer mais je vais essayer de la laisser refroidir complètement... pas très patiente ! Un pâtissier m’a dit que le sucre devait représenter le double du poids des blancs d’œufs. Du coup je respecte les proportions de la meringue mais je sucre peu la chantilly pour compenser.', '2019-12-14T01:45:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 6b487aff-af38-41b1-b2c3-e16ea0343457, 'Le mieux pour pouvoir la servir sans la casser est de faire cuire 6 meringues en formes de parts ( triangles ), pui de recouvrir de crème et de fruits et le tour est joué !', '2017-07-05T15:12:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 61865f56-a65d-4c94-82e1-8c58cf1f3f10, 'Ce dessert est encore meilleur avec la crème fraiche battu au lieu de la crème liquide.', '2020-01-10T18:11:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 0afc9316-cd54-4068-98a7-bfd2c7a0f62a, 'Ce dessert est vraiment bluffant. La meringue est excellente (bien respecter les doses et les temps de cuisson). Pour la crème, j''ai utilisé la recette marmiton de la crème chantilly au Mascarpone. J''ai fait la meringue la veille, la crème 3h avant et j''ai monté le gâteau au moment de servir. Entre la meringue et la crème, j''ai mis les framboise et des lamelles de chocolat noir. J''ai servi le gâteau avec un coulis de framboise... Excellent ', '2019-02-24T07:58:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 64a9c94d-4ada-4200-a400-335b77253dba, 'Tres tres tres sucré et pourtant je n''ai mis que 250g de sucre. A reessayer avec 150.', '2017-08-28T11:45:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 5f3b3a65-1667-461c-aeb1-b554b7d65e80, 'Délicieux. j''ai suivi les commentaires 4 oeufs 220g de sucre.  Pas la saison des fraises alors on a fait une compotee de pommes poires vanillé cannelle et chantilly maison au siphon. Recette ultra simple et topissime!', '2016-12-28T14:50:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 89a2db9c-a04b-4e51-9f61-274f0cbe65a4, 'Super recette mais attention quand on le sort du four. il faut laisser le gâteau reposer au four une heure avant de la sortir', '2015-06-27T20:17:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 13e40a3d-8784-411d-947f-154b9f9ff443, 'Excellent dessert ,j''en suis à ma 2ème et mes invités sont ravis à chaque fois 🍓🍓🍓', '2023-06-10T10:59:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, ea4ef481-bb5f-4226-a50c-bf1779945235, 'Superbe recette. Enfin un Pavlova réussi du premier coup, mes enfants et mon mari se sont régalés.', '2023-06-09T22:37:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, a289157d-140d-4bfd-a1ba-1f40fdc5cb38, 'Se mange sans fin, meringue légère, on ne sent pas le vinaigre. J''ai mis 50gr de sucre par blanc comme je fais pour la tarte à la rhubarbe meringuée.', '2023-04-21T21:50:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 0a7a24c4-6eee-4742-a3ae-90e3afda4eff, 'Succulent, j’ai diminué la recette de 15% de sucre', '2022-03-13T21:00:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 3439d6fc-9960-4116-bed0-668127f797a0, 'Super bon, légères  parfait pour moi', '2019-03-01T22:07:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 8726aa16-a7e1-4173-9706-230f7e4e92d3, 'J''ai bluffé mon mari ( il faut dire que je ne suis pas une spécialiste des desserts ).', '2017-07-05T14:46:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 6cb64550-b5e5-4872-aad0-27b1a8a3db68, 'Génial !!! merci tout le monde s''est régalé et en a redemandé !!! merci ', '2017-06-01T23:56:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 6fda95d6-ab53-44a6-8786-df8dd3c69e37, 'Essayée avec 4 oeufs et 220g de sucre, recette très simple et dessert très bon !', '2016-08-21T23:51:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 2b86c96d-cc4a-4699-be4f-aad6f18c0d14, 'Extra ! Sauf que je la laisse 60-65 min à cuire.', '2016-02-23T19:16:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 76657435-4dcd-4da2-9ee7-1206f9561c67, 'Facile et délicieux. Bien faire la cavité au centre pour y verser l''essentiel de la chantilly et fruits au dernier moment avant de servir. La prochaine fois j''ajouterai une purée de fruits dans le creux de la meringue. ', '2015-07-05T20:26:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 8cf39d6e-3fa8-4581-b134-2b70085ab195, 'Recette réussie. La meringue à été réalisée dans un moule flexipan et s''est très bien démoulée. La crème chantilly à été remplacée par de la mascarpone fouettée mélangée à du sucre vanille et du sucre glace. C''était délicieux. ', '2014-08-18T23:24:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 7fcff2cb-4c05-44a9-bfbf-e8373af9df3f, 'Dessert fait plein de fois avec autant de succès. En effet, mettre la chantilly au tout dernier moment pour qu''elle ne détrempe pas la meringue. J''ajoute dans ma chantilly un sachet de crème fix pour qu''elle soit bien ferme.', '2011-12-10T11:14:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 51d01c12-cd8c-4e2c-b740-ca38cb0e5168, 'Un excellent dessert. Facile à réaliser, quoiqu''un peu long puisqu''il se fait la veille, ce dessert New-Zélandais est à la fois rafraichissant et original. Pour le rendre plus léger et moins gras, j''ai mis une mousse de framboise, (400g de framboises de jardin) ou une purée de framboise en dessous de la crème Chantilly. J''en ai donc mis moins (une couche très très fine, juste pour faire du blanc) au dessus, j''ai éparpillé quelques frmaboises (une petite 10aine) et j''ai saupoudré de vermicelles en chocolat. Le succés à été présent et l''originalité aussi! je l''ai appelé le Pavlolène. Essayez donc, et dites m''en des nouvelles! ', '2007-09-02T21:58:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, a2552d04-357b-441a-b00a-c4401a3066bb, 'Un vrai délice! Pour les fruits, j''ai mis des fraises, des kiwis et des raisins rouges et on s''est regalés! La prochaine fois je pense que je le ferai avec des fraises, des framboises et des myrtilles... miam miam!', '2007-05-20T09:09:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 637f9fa2-0f15-4b92-baac-577f61d88568, 'Pavlova, dessert russe... Je conseille d''étaler sa meringue en formant une cavité et d''utiliser de la crème épaisse (30cl).  Prendre la moitié des fruits pour faire un coulis et l''autre pour la déco.', '2006-04-30T20:51:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, be07979e-08e7-40d2-8bfe-c3359fd29fed, 'Le papier type sulfurisé est à mon avis indispensable car j''ai eu du mal à démouler ma meringue, pourtant cuite sur une plaque anti-adhésive! Autre point à préciser: il faut bien faire le centre de la meringue plus creux que les bords... sinon tout coule au moment de la mise en place de la chantilly et des fruits !', '2006-03-28T15:10:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 4ff7fc6f-675d-4772-b763-79ed4350895d, 'Bonne recette merci! On peut monter les oeufs au sucre et citron au bain-marie, en battant 10 min hors du BM, lorsque le mélange devient chaud( meringue suisse), n''ajouter qu''une cuillère de farine que lorsque c''est froid, et remplacer le vinaigre par le jus d''un demi-citron. Ca correspond à 4 belles parts, je n''avais pas de cercle, je l''ai dessiné de 20 cm et fait les bords hauts à la douille, posé sur une feuille de papier sulfurisé, à th. 2 pendant 2 h, en ouvrant la porte du four, 1 fois, pour évacuer l''humidité. Les proportions sont bonnes, le poids du sucre est le double des blancs. Cette coque se conserve au sec, et peut se faire 2-3 jours à l''avance. ', '2005-12-19T16:21:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 408aeb56-775b-4dbf-9097-c027ff0ac305, 'Une merveille! La meringue était parfaite, et la présentation magnifique. C''est un des plus jolis desserts, que j''ai réalisé, à ce jour. La prochaine fois, je pense essayer de faire des meringues individuelles, pour éviter le tracas de la coupe, seul point vraiment délicat.', '2005-09-27T16:30:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, d9490219-6b5b-4f19-8f65-8886296098c8, 'Top. Juste réduire la quantité de meringue par rapport au reste car très sucré sinon.', '2025-09-20T14:41:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, d47cd15a-9f3a-40ad-a4c9-7aa8b788c639, 'Super bon', '2023-05-20T12:56:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, f4acf08d-3b37-4548-a841-20264979c406, 'Un délice! Cela me fait penser aux baisers de Malmedy.', '2023-04-11T12:17:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 592ad048-d2b5-4b7f-a0d7-b9c00b926641, 'Easy to make, very delicious 😍', '2022-11-26T16:53:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, be7a133b-2356-4623-b4c8-65bcf7af5fa5, 'Facile et délicieux !', '2022-10-29T12:32:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, d10a8504-ad08-4024-babd-5b1a762d1854, 'Très facile et très pratique !', '2022-10-10T17:32:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, fdaeaf7d-7112-461b-b0b4-6e1a02d18e0d, 'Top pour l’été !!! Néanmoins il faut mettre plutôt la chantilly au dernier moment car elle coule sur les doigts ;) A refaire !!!', '2022-08-03T13:11:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, aad9ace8-8577-4ac8-a10d-39e2eb3c112f, 'Très bonne recette. J''ai suivi les commentaires et n''ai mis que 270 g de sucre (6 personnes). La cuisson varie en fonction de la taille des meringues...', '2022-06-11T19:35:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 9628968b-708d-40e9-8f82-2d4006dedf2b, 'Recette super facile et savoureuse un vrai succès !', '2022-04-19T23:06:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, d19a0006-4616-4817-934d-c8c9a1674a1e, 'Un succès ', '2021-11-21T19:54:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 32919216-2634-42d7-a8a4-08ebec19a490, 'Três bon', '2021-11-13T18:36:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 5939a92b-197e-4069-be59-e03a877d31c4, 'Recette suivie à la lettre sauf pour le choix des fruits. Ce dessert fait toujours l''unanimité.', '2021-10-26T11:23:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 47283c77-3fbb-43b0-90d2-67279c81769b, 'Super bon.', '2021-05-09T12:39:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, dfe0e48a-a4e6-4a34-9e20-6212c0ec765c, 'Ils ont l’air bons ', '2020-12-13T14:18:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 325c0f13-de8f-4985-bd34-d989a9fd281b, 'Excellent', '2020-06-22T12:23:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 5e4f9f37-d5a6-46a1-ae49-9e1778ff6da0, 'Une.réussite gustative. Testée et approuvée', '2020-06-21T23:21:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, fc38a15c-b3c1-4e79-85fa-48403f6ff88d, 'Excellent gâteaux 
', '2020-06-04T12:53:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 7d175612-db4e-4e15-b191-03ea771abd48, 'Excellent, facile et rapide à faire... idéal après les fêtes !', '2020-01-01T07:13:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 547b4b11-5d7e-4c0b-8ca6-ae11d2803ed6, 'Excellent.  En hiver je garnis avec des marrons glacés. Pour monter les blancs d''oeufs je mets le sucre au fond de mon robot et les blancs au-dessus. Ne rate jamais. Les blancs en neige sont impeccables. Dessert très facile à faire et qui remporte beaucoup de succès. Si la meringue se casse ou se fend elle reste présentable en la couvrant de chantilly ', '2019-11-17T02:21:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, dea0aab4-9a6e-417d-b277-100e88486d71, 'Réduire la quantité de sucre, sinon devient vite écoeurant.', '2019-07-18T13:31:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, d4c8a8a4-946d-4b6a-9680-fee2f508c2a8, 'Je n''ai pas mis les fruits sauf les fraises et ça a très bien rendu. Très bonne recette.', '2019-06-10T13:21:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 799c842f-8d2f-45fb-8df2-109c14958fc7, 'Tres déçue... . Tellement sucré... . ! Mis 300g de sucre mais peut être que 150 auraient été suffisants. Vais vite chercher une autre recette !', '2018-09-17T00:40:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 4c1b38ed-cdad-4707-8e58-f69c45c5b7c7, 'Très bon dessert, je le referai volontiers !', '2018-06-28T06:57:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 7fb6641c-0bf6-430c-976a-2dd5f0f1c1ab, 'Très facile , c''est parfait , merci !', '2018-05-19T17:47:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, dc9850f7-e318-46fd-9a22-8a23e09448c5, 'Très très bon mais peu présentable car la meringue en refroidissant s''écrase voire "s''écarte": c''est dommage ! La première fois, j''ai émiettée la meringue dans des coupelles puis j''ai ajouté les fruits et la crème chantilly sur chaque : tout le monde a aimé... Merci pour cette recette. A refaire.', '2017-01-21T18:10:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, a785ca8d-6a87-4485-9615-270c2b2ad5f0, 'Recette réussie j''ai pas changé les quantités juste divisé par 2 car nous sommes que 2. Très bon la meringue est légère. Merci.', '2017-01-15T19:17:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, d3913fa7-f07f-4225-a85e-2610e1bbc70e, 'Essayée avec 270 g de sucre mais encore trop sucrée pour moi. Dommage car superbe dessert. Je réessaierai avec moins de sucre.', '2016-07-14T11:26:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, b28e6ee8-2ba7-4e79-9383-fc15d7b9bdde, 'J''ai mis 270g de sucre et ça a suffit. J''ai pris soin de creuser la forme pour accueillir coulis et crème : impec ! Merci beaucoup pour cette recette facile et délicieuse !', '2015-10-26T17:08:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 98c30bb1-0bcf-497e-8c9b-632782e14252, 'Délicieux ! Rien changé à la recette, le résultat est excellent', '2015-09-19T13:20:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 9f808633-0b70-4cf3-9328-5c7634f4c170, 'Un vrai régal, j''ai utilisé le vinaigre de framboise et j''ai décoré ma pavlova avec un coulis de framboise. A faire et à refaire !', '2015-07-25T20:15:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 9c87d0fe-56dd-453f-bd13-0e257aa71997, 'Une recette parfaite. Rien changer mais juste ajouter du mascarpone avec des framboises,  mixer avant de mettre les fruits sinon tout pareil... Le plat a été vidé à la vitesse de l''éclair. Et le visuel Whaou. Melon, mangue, fraise, pastèque, framboise, groseilles. Hummmmm', '2015-07-05T23:55:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, aad2472a-f06f-4a23-8151-09c4eb036358, 'Oh la la quel dessert !!! réussite totale, meringue croquante à l''extérieur et moelleuse à l''intérieur, pour une 1 ere, grand succès, mes invités ont aimé. ', '2015-06-28T21:11:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 91862caf-6fa3-40bf-ad75-9f201c0d4bef, 'Excellent dessert, facile à réaliser, et qui fait beaucoup d''effet ! Je n''ai pas sucré la chantilly, et j''ai mis un assortiment de fruits rouges. A refaire. ..', '2015-06-06T18:35:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16007, 6bd3e666-a687-4a5f-a17d-ea4da58e5ab5, 'Excellent, un régal avec les premières fraises, recette respectée à la lettre', '2015-06-01T17:12:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26325, 9d88103e-590d-4024-8d9b-1509b57032e7, 'Vraiment exquis!!! ', '2008-01-05T16:04:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67602, fd43846d-5166-4a94-a4bb-658a4a324896, 'Je l''ai trouvée trop sucrée et trop de bananes pour une tarte (trop épais). Du coup, le chocolat ne forme pas un beau dessus plat et recouvrant le tout.  ', '2015-05-16T18:51:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67602, 03671944-43aa-4236-85eb-202b7e458dd8, 'Bon mais le chocolat ne donnait pas du tout un effet tarte, pourtant j''avais choisi de la bonne qualité. Dans l''ensemble bon mais à refaire en changeant la cuisson du chocolat pour ne pas avoir l''effet tablette de chocolat reconstituée.', '2011-01-08T19:44:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67602, e5708143-f2d5-4521-8cc0-55c06c52b37d, 'Les grand-parents, les parents ainsi que les enfants ont adoré !!! C''est une délicieuse recette et simple à réaliser. Que du bonheur !', '2010-08-17T22:46:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67602, 4b9ddb18-adfe-4083-83e1-fc990c487b1a, 'Excellentissime. Je n''avais pas de petits beurres alors j''ai pris des biscuits à la cuillère. Ça va aussi mais attention, la cuisson de la pâte est plus rapide.  Difficile à démouler. La prochaine fois j''essaye dans des verrines.', '2009-03-15T15:41:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67602, 79b0c1e0-fe81-4778-a183-1201903fb98d, 'Excellent, quoiqu''un peu sucré. La pâte à base de petit beurre est croustillante et remplace avantageusement la pâte feuilletée. En plus ma tarte était présentable!', '2009-03-14T15:20:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67602, 7d8be21d-0724-4204-b282-92cd0d2a8cc5, 'Fondante, croquante, riche en saveurs...Fa-bu-leux!!! C''est vrai qu''elle ne se tient pas bien au démoulage à moins d''avoir un plat à tarte avec fond amovible(mais on s''en fiche tellement c''est bon) alors je vais la transférer sans doute dans des verrines. Bravo!', '2008-10-31T19:26:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67602, 11a69c50-b9ba-4f16-b73b-c6fa16a6694d, 'Un pur délice!! Pour ma part, ce n''était pas très présentable, mais qu''est ce que c''était bon!! Et c''est le principal!', '2008-06-15T13:11:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67602, bb9ef0dd-f7b2-4178-b46b-4811cea9cf64, 'Il faut absolument faire cette recette avec les petits beurres, c''est un pur délice! Par contre je n''ai pas fait le caramel comme c''était indiqué, deux sachets tout prêts ont fait l''affaire.', '2008-03-13T09:19:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (171775, 7abbd833-7bc8-41b5-b67c-05487c5240e1, 'Très bien pour finir ses feuilles de brick ou ses bananes un peu mûres. ', '2015-02-25T00:22:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57994, 0c3e41ad-9028-4aa2-a845-16328a5e6576, 'Très bon, mes bananes n''étaient pas très mûres mais c''était très bon. J''avais mis plus de rhum car j''adore le goût. Mes collègues ont adoré.', '2009-09-18T21:51:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57994, 49edb3dc-04e2-4019-a537-e97d8bbbaa46, 'Super bon moi des prunes j''en rajoute une 10 de plus ', '2021-09-21T19:18:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57994, 619fad11-e091-4e1a-92c6-1f9616761221, 'J''ai mis un peu plus de prunes et des bananes bien mûres, un régal !  Merci pour la recette !', '2017-08-15T16:55:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57994, 0644ba2b-4f77-4c92-9cba-449acf8b2f77, 'Excellent. Je l''ai déjà faite plusieurs fois. Mes amis ont adoré.', '2017-07-28T22:29:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57994, 6706f6e2-4325-4c19-99ac-86247226b8b9, 'Facile à faire et très bon. Mes invités n''ont rien laissé...', '2013-10-24T02:21:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57994, 79b52372-5f0a-4f09-96da-bb5f4ba63c1e, 'Bon mais sans plus. Je n''ai pas trop aimé le goût du flambé au rhum avec les fruits.', '2011-08-17T12:11:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57994, 00c21517-985e-4318-bcf0-8898223af0cc, 'Un délice. Mes enfants n''ont pas aimé certes mais ils ne sont pas trop tarte. Par contre j''en ai fais 4 fois pour des invités car mon mari et moi on adore et les invités ont adoré aussi. Bonne tiède mais aussi froide passée au frigo... un délice.', '2010-08-21T21:29:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57994, b6bee63c-9d5b-45a8-8f0e-eefd9259d717, 'Je l''ai fait avec une quinzaine de prunes genre reine claude et du lait de soja. C''était très bon mais je trouve que le goût de la banane domine trop. La prochaine fois je la ferai avec plus de prunes et moins de banane.', '2010-08-08T23:33:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57994, 1ca117a1-7292-4a2e-8347-1924e9e03a02, 'Un vrai délice ! Facile, rapide. J''ai même réussi à épater mon mari qui avait pourtant retroussé le nez à l''annonce du menu ! Merci !', '2009-09-13T16:55:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57994, 618a1674-4cab-4e47-adf8-08528ad8f6aa, 'Excellent!! J''ai rajouté un peu de poudre d''amandes sur le fond de tarte et mis 8 prunes et 2 bananes, pour une pâte feuilletée du commerce et cuisson 45 mn. Bon appétit à tous !!', '2008-08-08T17:04:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57994, 8692d75b-7653-4b91-986c-a9bad95ff710, 'Cette tarte est délicieuse! J''avais un peu peur du mélange prunes/banane mais c''est excellent, je l''ai goutée tiède et froide je conseille de la manger froide. Je vais d''ailleur en refaire une de suite ', '2007-09-06T15:00:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57994, 9fcc1bda-98fb-4065-8704-c0f5cf603577, 'Mes invités ont adoré!! A la place du lait (dans la crème) j''ai récupéré le jus des fruits lors de la cuisson à la pôele. Je n''ai pas eu besoin du lait & la crème était donc un peu plus sucrée. J''ai aussi rajouté du gingembre dans la crème. Un pur régal!! ', '2007-09-02T14:39:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29473, ba305ce6-3bb2-465c-b833-9e03dcecd1f3, 'C''est super bon! J''ai remplacé la 1/2 pomme par 2 grosses fraises. Belle couleur rose, la banane donne un texture bien crémeuse: EXCELLENT. Je vous le conseille vraiment!', '2005-03-31T22:29:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29473, df58e153-070b-4ddf-8aa9-0a7d36c2c6a8, 'Très bon, évidemment il faut aimer le kiwi, qui donne quasiment tout le goût à la boisson. Je suggère de rajouter un peu d''eau dans le mixer car sinon ça ressemble plus à de la purée qu''à un liquide buvable...', '2005-01-25T18:59:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29473, 471bcaa9-d955-45fd-ae2b-584f1a5d896f, 'Délicieux. Comme nous n''aimons pas l''avocat, j''ai remplacé par 100gr de fromage blanc allégé pour conserver la texture. Idéal en hiver pour faire le plein de vitamines autrement :)', '2005-01-23T16:40:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46191, 6207eaea-70b2-43d7-be7e-b6e258bef0ad, 'Très bon bien que le goût du marron soit vraiment très discret, la famille s''est régalée ', '2014-10-27T13:22:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528062, 7b1abe95-4f88-4240-a3d4-fb0dc76bf6fe, 'Idéal pour les p''tits bouts de choux ', '2020-11-14T17:06:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22225, 759bca92-cc4d-4e3d-8e15-a1024c3c122a, 'Recette très bonne et facile, mais il y a effectivement beaucoup trop de sucre et personnellement, je n''en ai pas mis du tout, les bananes étant à mon avis déjà assez sucrées ! Mais c''est évidemment au goût de chacun...', '2019-06-08T10:40:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22225, ce7abc4e-32c6-4ac8-b8db-02ad7562ad07, 'Personnellement, je n''ai mis qu''à peine la moitié du sucre et je n''ai pas mixé les raisins, je les ai ajouté après. Délicieux, succès garanti.', '2006-07-05T18:38:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22225, 076630e3-dab7-4ffa-97eb-3e2c7b0ddfa4, 'Personnellement, je ne mets que 75 g de sucre glace et de l''avis des dizaines de personnes qui l''ont goûtée (ça devient un classique chez nous), c''est amplement suffisant. Je mixe le tout et rajoute une petite banane en petits morceaux. Délicieux!', '2005-10-06T23:31:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22225, 3b0e2b7e-6c42-466f-b60b-079c17d0c8ef, 'Simple, rapide et délicieux. A mon goût, on peut y mettre le double de raisins.', '2005-08-19T16:55:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54922, 0129e89b-0ea7-4c43-bc70-0983fc446035, 'Recette effectuée qui n''a pas beaucoup d''intérêt. Le goût est très fade, pourtant je suis une fan de bananes. A éviter donc.', '2011-08-25T22:06:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41590, 85a754da-45da-49d4-b768-9d0e54f76217, 'Merci pour cette bonne recette qui permet de sauver les bananes un peu trop mûres en régalant toute la famille ! Proportions parfaites, une seule cuillère de confiture de fraises a suffit pour nous. (Version mixée de notre côté)', '2019-12-21T02:23:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41590, b7e20d91-00f2-4252-bb72-45241e6924ea, '1 seule cuillère de confiture suffit. Avec un peu de vanille en poudre c''est un vrai délice.', '2014-02-24T23:20:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41590, 841320e4-4b15-4ea0-bd5a-693667a8b114, 'Recette rapide et diététique, le mélange des saveurs apporte plein de vitamines pour toute la journée.', '2009-04-03T17:18:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41590, 93cda40d-3b69-48c6-a985-617aacbcaa32, 'J''ai mis de la confiture de framboises excellent!  Par contre, pour deux on peut doubler la quantité de bananes et de kiwis mais deux cuillères à soupe de confiture suffisent.  La prochaine fois j''essayerai avec un peu de jus de citron, un vrai dessert pour l''été !', '2009-03-14T13:43:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41590, c200064d-7a00-4144-8688-bcf74430bcae, 'Très bonne recette facile à préparer. Avec un peu de pain et un laitage, cela fait un petit déjeuner très équilibré. J''ai juste remplacé la confiture de fraises par de la confiture de cerises.', '2006-06-16T10:58:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41590, cf0328d0-4cfc-48e7-b6b4-7f4ebe7e7c57, 'C''est une recette rapide mais délicieuse! J''ai juste rajouté 2 cuillères à café de yaourt nature et je l''ai mis 1 min dans le congélateur, miamm...', '2006-04-30T18:24:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41590, fd8c81bd-9e89-4a74-aeda-364ef1d3ca82, 'Recette facile, rapide, parfaite pour la santé et pour la ligne! Le plein de vitamines en un tour de main. Une bonne manière aussi de consommer les fruits un peu trop mûres. J''y ai ajouté une touche personnelle : des fraises fraîches à la place de la confiture... moins sucrées. En bref : un régal et le plein d''énergie au petit déj!', '2006-04-05T13:11:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (318786, 70b9d8f4-5841-44c1-be7b-f1403d4b2d0e, 'Très bon ', '2023-10-30T15:50:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (318786, 7be5e4d0-b8ab-493c-b149-98b35bc0907b, 'Très bon, merci pour la recette, moi j''ai écrasé les bananes 🍌 pour les incorporer à la pâte humm très bon 🤩', '2022-06-08T13:40:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (318786, 661876a0-be51-4125-a3f9-abb11ee5f23b, 'Pas mauvais, mais rien d extraordinaire.', '2014-07-22T18:53:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (318786, 683d6bb2-e535-478e-8824-f13e9909620b, 'Testé et c''est très bon. ', '2014-07-06T23:29:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (318786, 90e33563-5f53-48ab-8ad2-e89d6d2a9f47, 'Très bon ! :-) ', '2014-04-15T20:31:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530057, 093e4c21-2606-4d7e-bbef-aa678673c0d4, 'Il n''y a pas écrit fécule de mais dans les ingrédients et c''est présent dans la recette', '2022-02-24T13:10:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530057, 342e2c24-0323-49b9-9cfa-b0e596e5b222, 'Excellent ! Recette très facile ! ', '2022-01-25T20:33:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (330547, d3026b3e-11dd-43d6-bd17-6c7563da2be0, 'Très bon équilibre, mais il faudrait préciser la quantité de gingembre...', '2022-06-18T14:39:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (330547, 8ac193ef-7f0e-40aa-bec0-96a2379ab4cd, 'Sans gingembre, très bon aussi !', '2018-05-31T12:26:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (330547, 5bf8c9eb-75eb-41b8-9ccd-c19048eeb6dc, 'Très bien !', '2017-06-25T16:45:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (330547, 3e71eb59-fde5-4a61-b8da-2ec3fcdf5ea0, 'Très belle recette. J''ai adoré les bananes et les pommes. Bonne découverte', '2014-10-24T18:50:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32499, 3c6faeb1-175a-4680-8d76-e24723b946c8, 'Pas terrible, les nouilles manquent de sauce, le plat n''est pas assez relevé.', '2011-11-05T03:59:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219614, 578fd53d-2163-4097-8740-caaa326658ae, 'J''ai adoré c''était franchement super bon et tout le monde à aimé c''est très simple à faire. Peut-être que certain n''aimeront pas le chocolat durci mais moi j''ai adoré mais ça aurait été meilleur pour les gourmands avec de la chantilly par dessus.', '2017-09-20T18:46:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219614, eee8b478-0a2d-4ec3-9522-e89aa024ba96, 'C''est bon aussi avec du speculos.', '2013-03-18T18:05:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219614, 5e03189d-d362-4ad8-85a0-a06a8ca477da, 'Très bien au niveau des saveurs de fruits. En revanche, les couches de chocolat ont figé dans la verrine. Peut être fallait-il remplacer le beurre par de la crème légère ? Très bon toutefois et facile à réaliser.', '2011-11-26T22:25:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52822, 4ccd6de0-5812-4403-a8d6-ccd509399484, 'Reduire le sucre sinon ecoeurant.', '2017-01-01T21:26:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52822, 8d24cc73-1594-4c5c-a752-0a8826e6ccbb, 'Absolument délicieux !!!! ', '2011-11-01T12:47:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52822, 2064337d-84c0-4d1f-9151-b9b483c8b4cb, 'Facile et super bon ! A refaire.', '2011-05-16T21:52:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52822, 1553ab89-7164-4534-859f-886a029c746f, 'Je n''ai pas fait de mousse mais un coulis au chocolat (100g de chocolat noir, 10 cl de crème fraîche et 1 jaune d''oeuf et un peu de beurre), j''ai compoté les bananes avec du sucre et du rhum (légèrement) et j''ai servi avec de la glace à la vanille  et j''ai décoré avec de la crème fouettée.', '2009-04-18T19:37:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52822, f4b48595-18ea-404e-9054-18acd16a7844, 'Étonnant! Un goût spécial avec le gingembre mais délicieux ajouté à la banane. Faite la veille c''était super bon, idéal pour un dessert du soir, à refaire!', '2006-12-28T18:38:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44287, a1ade3b5-01cb-46d7-bada-22e5cf5b0f6f, 'un peu acide mais léger et rafraîchissant, demande en effet un accompagnement (glace vanille et/ou biscuit) pour faire encore plus raffiné !', '2010-01-08T20:05:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (174406, ca80e6bc-0312-49d6-b773-49284a08a790, 'J’ai remplacé le vinaigre par du citron, mis 2 fois moins de sucre et rajouté de l’agar agar pour la consistance ! Sinon, recette très bien mais surtout, diminuer la quantité de sucres !! ', '2021-11-25T19:43:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (174406, ed3f67fd-d96c-4f13-9735-5b103dc4af11, 'J''ai testé cette recette avec 1 banane et 1 mangue, du vinaigre de cidre et les ingrédients tels qu''indiqués. J''ai aussi ajouté un trait de citron vert en fin de cuisson, qui donne un peu de pep''s !  Simple et efficace ! Le chutney rivalise avec ceux du commerce.  ', '2014-11-20T17:46:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (174406, d0b564d2-78be-47a2-8bb0-893e38f5b137, 'Très très bon ! J''ai enlevé moitié de sucre et ajouté en cours de cuisson une tablette de chocolat. Un pur délice !', '2013-11-11T17:02:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335279, b026aa66-2079-4326-9310-f026630dde78, 'J''ai réalisé cette recette avec 3 pommes et 2 bananes. J''ai ajouté 3 sachets de sucre vanillé et 2 cuillères à soupe d''eau. Très bonne, cuisson parfaite en 10 min.', '2016-08-01T16:05:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335279, 2740dbf0-c51b-4a91-933b-e6f0e9846a0c, 'Moi j''ai ajouté les graines d''une gousse de vanille, nickel très bonne recette à refaire.', '2019-02-10T13:01:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30151, 00735b48-d0b2-4f42-9abf-a71d5b2a4bb5, 'La crème est bonne, j''ai juste remplacé l''alcool par du miel.', '2016-06-06T17:10:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24644, 0c87e14d-70ee-462c-8075-ed9ad98a8ecb, 'Confectionné avec des médaillons de chevreuil et des airelles fraîches. Dans l''ensemble, c''est assez plaisant. Toutefois, cela manque de sauce, et la garniture n''est pas assez abondante (la banane est étonnante mais indispensable, surtout avec les airelles, même avec ajout de sucre).', '2015-01-01T11:37:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24644, b0134c10-7652-49f7-9e73-298a30de0d26, 'C''est vraiment délicieux et au moins on sort de la routine, merci!', '2006-10-03T11:51:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24644, 5a723cbf-9113-4b3f-9dd6-8c95b98d6360, 'Recette super, on s''est régalé. Merci!', '2005-12-20T09:07:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14774, 282e2298-3702-4e36-ab60-199d44091ae3, 'Tout le monde s est régalé les abricots, pour moi ils sont de trop et attention au rendu du jus de pastèque ça a tendance à macérer', '2023-06-18T20:54:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14774, 8cc26796-d9f4-4e22-b686-576067d27201, 'Excellente recette ! J''ai mis un melon jaune à la place du melon et j''ai coupé le sirop de canne avec un peu d''eau pour que ce soit moins sucré. Toute ma famille a adoré ! ', '2020-10-27T09:52:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14774, ed7a9e5f-2eb9-455d-aa93-04713fc7dda0, 'Excellente, j''ai ajouté de la pêche. Par contre je n''ai pas trouvé de sucre de canne à la vanille, j''ai donc ajouté une gousse de vanille que j''ai laissé macérer 3 bonnes heures dans le sirop de canne.', '2016-07-15T19:04:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14774, b111184c-8179-4a67-a07d-c746848c51f5, 'Très originale avec la cannelle. Très appréciée. J''avais servi la salade dans une moitié de pastèque : très sympa. Merci', '2010-07-26T14:35:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14774, 91ae9ed6-e080-4c1c-af0a-e4762d0abc1f, 'Très bon!  Je n''ai pas mis de sucre de canne, j''ai mis du jus de goyave et des gousses de vanille. Le mélange avec le melon et la pastèque dépayse !', '2008-07-16T21:36:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14774, 9d714121-359b-4dac-8ce3-321943976c74, 'Très bonne salade de fruits. Pour 10 personnes environ. Je n''ai pas trouvé de fruits de la passion, je l''ai donc remplacé par 2 kiwis.', '2003-08-07T10:49:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14774, 6e1b3767-2cfb-4553-9d65-2fb133f7f5bc, 'Très agréable à la fin d''un repas un peu lourd et surtout l''été. C''est un dessert très rafraîchissant. Je n''ai pas mis de sucre, les fruits étaient suffisament murs, j''ai simplement ajouter du sirop de sucre de canne parfumé à la cannelle, mais en très petite quantité.', '2002-08-13T19:27:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46325, 19931f62-f21e-4ea5-9b37-5cc4a8317301, 'Dans mes salades de fruits frais je mets du jus d''orange pressé et du citron pressé avec un peu de sucre.', '2006-04-26T21:52:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46325, 167aaf93-fdb7-4564-98fc-28400a834381, 'Demi-orange et demi-citron pressés, 2 petites pommes, 2 kiwis, 1 banane, 1 c. S. Raisins secs, 1 pincée de cardamome moulue, 1 c. S. Rase de sucre et 2 pincées de fleurs comestibles séchées pour la déco.', '2018-09-12T19:06:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46325, 5422d84f-5dbe-43c0-8c35-1951aac1a24f, 'Trop bon', '2012-10-11T01:22:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 91d48f7d-6910-4433-9ae2-bb69f884763b, 'Hyper facile, rapide et just excellent ! Je compte bien la refaire après le confinement quand je pourrais recevoir du monde pour impressionner !  !  ! ? merci pour cette recette et en plus la bonne surprise c’est que le résultat visuel final est beaucoup plus joli que prévu !', '2020-04-24T05:06:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, fa29d82c-d0b8-472e-8ab3-4ae922754c6d, 'Cette tarte est pas mal, facile à réaliser et bonne lorsqu''on aime les framboises sinon rien d''exceptionnel.', '2007-10-06T17:27:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 20063ff5-b33b-4120-8c5c-668175ac91be, 'Super recette, j''ai diminué quantité sucre et j''ai ajouté de la vanille liquide.', '2022-08-21T14:08:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 6fdc24a4-0d05-47f5-8951-d6d29ad31d8f, 'Très bon, l''alliance de la banane et de la framboise est très réussie. J''ai mis un peu moins de crème que prévu et j''ai mélangé le sucre aux oeufs et à la crème. Par contre j''ai cuit à 180°C, sinon ça brûle. À garder et à refaire.', '2016-07-03T22:53:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, a26c400b-9fab-4551-881a-4ac730f4f2d3, 'Se laisse manger mais je trouve que la banane prend trop le dessus sur la framboise. Pas plus emballée que ça. ', '2016-06-14T15:25:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 6e42fbb7-eaed-459c-bf12-2a5b0e04496c, 'Excellente recette, très simple à réaliser.', '2015-07-21T07:14:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 618b652a-26f7-46db-aaa5-469b47aca28b, 'Très très bon ! Par goût personnel, j''ai mis moins de crème fraîche et je n''ai pas sucré les framboises, vu que la garniture l''ai suffisamment pour moi. On sent bien le goût des framboises et le goût des bananes, l''un ne prend pas le dessus sur l''autre. ', '2014-09-11T18:53:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 0cba9ae0-38e3-4744-9522-c9f36e3997cc, 'Très bonne froide.', '2014-07-12T16:51:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 5cdf7ce2-1ec3-4a1c-8b5c-5eb2b9acf3ec, 'Trop top ! Mon mari qui aime pas les bananes m''a regardé déçu en mettre... et finalement même lui a adoré !!! Tous sont convaincus, alors allez-y : lancez vous !!!', '2014-06-04T00:51:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 480195db-b883-4bfc-9317-867db2f06816, 'Tellement simple et tellement bon ! A faire, refaire, et rerefaire, on ne s''en lasse pas !', '2013-08-24T13:37:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, c5147d07-3466-4886-8478-d9df5662b97b, 'J''ai eu un gros succès au travail.', '2013-06-01T23:00:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 7cfd1068-c2b3-49e5-8363-4fa0cacd92e9, 'Extra telle quelle!', '2013-04-08T15:17:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 9bc7ce80-79d9-429b-b94a-19f952b0faed, 'Excellente recette avec un peu plus de sucre pour la framboise et j''ai mis 2 bananes qui apportent beaucoup de douceur.', '2013-03-23T14:28:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, dda49d58-9744-4382-bcee-2e010166e7fc, 'Très bon et très simple !', '2013-03-14T12:27:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 73468686-a9b9-4bc6-90de-9ad78cb4714a, 'Bon mais pas génial... Peut-être parce que j''ai utilisé une pâte brisée. Je la referai quand même car l''association de la framboise et de la banane est intéressante mais avec moins de crème et la bonne pâte. Perso j''ai du utiliser 3 bananes pour recouvrir le fond de ma tarte et j''ai fait décongeler mes framboises avant de les incorporer pour ne pas qu''elles rendent trop de jus.', '2013-03-11T13:16:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, b2788157-e5de-41d5-9bbf-87e8e754a020, 'C''était vraiment très bon !   La banane apporte une texture moelleuse et on ne sent pas trop son goût qui peut être écœurant, la framboise n''est pas acide et magnifiée.   Ça fait beaucoup penser à un clafoutis, ça m''a donné envie d''essayer de refaire cette recette sans pâte sablée, comme une crème brûlée.   Je mettrais un peu moins de sucre par contre la prochaine fois. ', '2013-02-27T12:41:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 62a4bd71-8b4d-4f6f-a0be-4375673e2856, 'Tout simplement excellente ! Merci pour cette recette qui va rejoindre mes classiques. 30 cl de crème suffisent. ', '2012-11-04T15:14:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, dd732f72-11c9-48a6-aecc-0c7ff54dcfef, 'Très bon, bon mariage entre le côté acide de la framboise et la douceur de la banane, j''ai ajouté un peu de vanille. Rapide et facile à réaliser.', '2012-10-19T17:38:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, c0abead1-ca8a-49fe-8eb9-69273778411b, 'C''est la 2ème fois que je la fais, je remplace juste la moitié de la crème par du lait pour plus de légèreté. Le goût est délicieux !', '2012-08-28T18:11:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 3efc5cec-f5b4-4355-9186-89fb63e6b99c, 'Fait une dizaine de fois. Souvent très bon. Avec éventuellement de la vanille liquide en plus ou du citron confit comme variantes.', '2012-05-23T17:17:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 03ade2ea-28c8-4cd9-83cc-91e0d8e72eb3, 'Très bon. Fait avec un mélange de fraises et framboises du jardin congelées et avec une pâte sablée maison où le beurre a été remplacé par de la purée d''amande. Excellent. J''ai hésité à mettre beaucoup de banane (1 et 1/2) mais au prochain essai j''en mettrai encore plus car cela donne beaucoup de fondant à la tarte.', '2012-05-08T20:08:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 7b8b4fd8-3001-4f22-a5c9-2f03fbf61646, 'Délicieux et rapide.', '2012-05-06T22:52:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, a8df02a8-3bf5-4f07-8c62-00d7a6542be5, 'J''ai fait la recette en préparant ma pâte moi même et en ajoutant des quartiers de pomme légèrement poêlées au beurre et mis 20 cl de crème au lieu de 40, très bon résultat ! ', '2012-03-02T19:50:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 12f352eb-f55a-4aa6-a2c2-d29684dd4fe2, 'Très bonne et originale !!! Peut être un petit peu lourde mais il ne faut pas en prendre deux parts !!!', '2010-09-14T15:56:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 2b2ee773-b7a3-4a3a-9bac-b724e44ad842, 'Pas d''autre mot possible : vraiment délicieux... et pourtant j''ai utilisé une pâte feuilletée par nécessité. Je vais la refaire avec une pâte sablée sans plus attendre !', '2010-05-29T13:05:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 0d6d77bd-908b-4c25-8ace-b3df4e4fc2ad, 'Elle a plu aux petits comme aux grands.', '2009-11-22T19:15:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 1abeb182-7222-4018-a214-1976dc5a9e03, 'Même avec des framboises en conserve c''était délicieux. A refaire.', '2009-05-03T14:53:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 79c027bf-df77-454b-a58a-376c9dc1caf8, 'Pas mal du tout et surtout simplissime à faire!!! Tout le monde a aimé!', '2008-10-19T22:23:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 6bf2ee8f-8bb1-48d6-a106-93d897c38a00, 'La banane et la framboise sont vraiment faites l''une pour l''autre. Dix minutes de cuisson supplémentaires ne sont pas du luxe. Je rajoute un trait de rhum au mélange œufs-crème fraîche. Recette facile, recommandée pour débutant.', '2008-08-09T16:02:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 43df86b9-d52e-4255-82f9-2d43e2c66590, 'Très bonne recette realisée avec mes framboises du jardin, j''y ai rajouté quelques fraises ', '2007-09-11T11:59:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 776491f6-4865-481c-a7e2-7dfa0d771fb4, 'Très sympa ! On peut rajouter un peu plus de framboises. Effectivement l''acidité de la framboise et la douceur de la banane est parfaite. Pour la banane, il suffit juste de recouvrir le fond de tarte donc une banane et demie est suffisante.', '2007-06-25T13:13:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, b5c9b792-4463-4f26-9197-7ba147802fc9, 'Hmmmmmmmmmmm! Délicieux, Délicieux, délicieux... Association géniale, frais comme un clafoutis. C''est sur je vais en refaire.', '2007-04-26T17:31:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, c0d21844-ae69-4e1c-bab1-3b49e3a81a93, 'N''ayant pas de framboises fraîches, j''ai utilisé un mélange de fruits rouges surgelés, c''était très bon aussi.', '2006-09-25T18:04:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 6b8ba87d-c9f1-46f3-b262-3e012809b8d6, 'Très bonne tarte. J’ai respecté la recette à la lettre. J’ai utilisé 40 cl de crème entière liquide (le type de crème n’était pas précisé). Les rondelles de bananes servent et adoucissent la saveur des framboises : c''est très surprenant comme association mais vraiment très bon! Recette que je recommande et que je conserve dans mes tablettes!', '2006-07-16T19:49:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 7325edae-a90d-4c2d-bff1-4f73cf2ff60b, 'Bon, mais sans rien d''exceptionnel.', '2006-07-09T12:05:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, e86f042e-75ba-4595-97a1-9075b8d5df0d, 'Cette tarte est un vrai délice, ces deux fruits se marient à merveille. Je n''ai mis que 60 g de sucre dans la garniture et 20 cl de crème fraîche épaisse avec un peu de lait et j''ai trouvé cela largement suffisant. Pour un plat à tarte de 28 cm, j''ai utilisé 3 bananes. Merci pour cette excellente recette.', '2006-06-29T23:52:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, bb6f7b36-d41b-4edb-9975-724aef580e39, 'Succulente et tellement simple! (j''ai juste rajouté 2 cuillères à soupe d''extrait naturel de vanille dans l''appareil...un vrai régal !) J''ai hâte de la refaire...', '2006-06-14T22:39:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 424054a2-a560-4bed-9532-b44479f45735, 'Recette géniale (et super rapide en plus)! L''acidité de la framboise se lie à merveille avec la douceur de la banane. Dans le doute, j''ai utilisé de la crème liquide car ce n''était pas précisé, et fanchement, je ne regrette pas mon choix. A faire et à refaire, et à rerefaire.', '2006-06-12T18:35:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, aba93d02-e0a3-4fe8-9a9f-94ca85368e81, 'Merci pour cette recette car celà est "une pure merveille", la douceur de la banane, un peu d''acidité dûe aux framboises font de cette tarte un mélange certes étonnant mais hummm...tellement bon ! A faire et à refaire !', '2006-06-10T18:51:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 18bb5318-75e9-4d11-b872-d31f3e21542c, 'Super facile à faire, idéal pour utiliser mes bananes qui commencaient à noircir! Le mélange framboises/bananes est surprenant mais vraiment agréable. A refaire.', '2006-06-07T17:37:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 164c2bc6-4a08-452a-8389-139a0d10c169, 'Mélange à priori surprenant, mais qui est finalement délicieux. Tarte faite à une vitesse record, très belle, qui m''a valu... des compliments!', '2006-05-09T11:56:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 71a3e8dc-1f44-4993-8344-0935fbe11b71, 'Le mélange banane-framboises est délicieux... A faire et à refaire... Et très apprécié des enfants. ', '2006-03-14T11:06:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41723, 4541dedd-4052-40ec-ac76-270a61943925, 'Simple et succulent! Le mélange Banane-Framboise est divin. On ne s''en lasse pas. Merci pour cette bonne tarte!', '2006-02-23T00:59:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28265, 450a84d4-1726-429f-8f60-c414a72ce80b, 'La présentation est originale mais la sauce au chocolat est beaucoup trop liquide, du coup l''effet était loupé!!', '2007-03-05T22:20:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28265, 4c9936fd-aafc-4853-a114-44a42cb2ce21, 'Original, délicieux et pas besoin d''appareil à fondue au chocolat! A faire à mes prochains invités!!', '2004-03-27T15:56:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (340774, 971d900a-b72e-4568-a6ea-cdce26f236c2, 'Simple mais très bon  ', '2016-12-19T02:36:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, c7bc089d-fed4-4910-93d9-2c2f22af7c52, 'Pour ma part, je réduis un peu le beurre et le sucre et j''ajoute du sucre vanillé et une compote de pommes s''il ne me reste pas assez de banane. Autre variante : j''ai fait fondre la moitié du chocolat et le reste en copeaux... ça me fait un marbré chocolat-banane ! Avis aux amateurs...', '2012-06-12T12:15:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, dd70d8a1-fd3d-4f16-bcfb-6927d85a0e74, 'Gâteau bien moelleux. Par contre, 30 minutes de cuisson suffisent. Sinon pour ma part je diminuerais légèrement la quantité de poudre d''amandes et j''ajouterais une banane (malgré 3 bananes bien mûres, on sentait beaucoup l''amande et très peu la banane).', '2019-02-03T03:16:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, fb6ae676-43d8-428c-b06d-517ded5c727d, 'Suivie à la lettre, juste diminué le temps de cuisson comme vu dans les différents commentaires. Du coup le coeur etait fondant, un délice ! 
Moelleux, parfumé, pas trop sucré : parfait !
Mes fils ont adoré aussi.
Recette adoptée !  Merci !', '2018-10-02T08:53:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, 5a1dbf76-c83e-4718-969c-f35f1346623e, 'J''ai mis plus de chocolat et un peu moins de farine, le résultat est à tomber ! Moelleux à souhait et très goûteux. Miam !', '2017-01-03T12:22:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, 1c061453-5982-4f9b-8d87-a9354b889b48, 'La recette ne casse pas des briques et fait penser à un gâteau de grande surface, dommage ', '2016-06-19T18:48:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, e90c391d-084e-48fb-8fde-1381f98d0bd9, 'Recette hyper bonne c''est génial ! ', '2014-08-29T19:57:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, dfcd93fe-f565-4ac5-9f19-4a064485c972, 'Une tuerie, merci ! (Variante : ajouter une touche d''essence de vanille et/ou du miel) ', '2014-05-17T22:16:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, 16bcd3fe-0274-49a2-999e-5cf21e07e8f8, 'Excellent ! J''ai suivi à la lettre les quantités, excepté pour le beurre ou je n''ai mis que 100g. Pour la cuisson 30 minutes ont suffit. On sent bien le goût de la banane, peu les amandes, mais on les retrouve dans la texture. Bonne recette, merci !!', '2013-11-28T18:22:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, b57da230-2c6f-482c-b7f9-103f98be8fbd, 'Mon homme va adorer ! Très bonne idée.', '2011-10-04T10:23:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, 6e098e59-1b77-4330-b8df-ea895ed74092, 'Très bon, mais j''ai ajouté 50 g d chocolat en plus. Par contre on ne retrouve pas la saveur des amandes mais chocolat banane c''est suffisant.', '2011-09-18T01:34:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, cbef8f99-5086-4d37-8005-a11a1de433cb, 'Un classique chez nous... Je mets 5 bananes TRÈS mures... et je fais cuire 35 min... c''est moelleux, très parfumé à la banane... une tuerie ! ', '2011-07-03T16:27:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, 2a957bd7-a6a5-43f1-af1f-00873b80de45, 'On sent fort la texture des amandes et on goûte peu la banane... J''ai préféré une autre recette incluant du yaourt notamment.', '2011-06-14T01:26:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, af5d433a-00ba-4aa2-b30d-b9c4f7479a3c, 'Nous n''avons pas aimé non plus... pas assez de chocolat ou de sucre peut-être (?)', '2010-12-28T19:19:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, 7c9be4ea-626d-493a-abdf-5c8c4f1e3caf, 'Délicieux... et facile  !! Cuisson 30/35 minutes ici pour plus de moelleux ', '2010-12-16T15:58:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, cb6ace60-5d2a-4a4c-8d2e-86c4ee33a0cd, 'Bon gâteau, mais j''ai trouvé qu''il manquait de goût de chocolat. C''est sans doute parce que j''ai mais du chocolat au lait...', '2010-12-13T17:11:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, 3d625568-55e2-41c0-a360-77290e868e8b, 'Nous n''avons pas aimé... le goût de la levure est trop présent, en revanche pas assez de chocolat et on se demande bien pourquoi il y a de la poudre d''amande car on ne la sent pas. Et pour couronner le tout le gâteau ne se tient pas du tout, impossible de servir une part correctement, c''est dommage.', '2010-11-20T23:32:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, 8d84f1d2-f4e7-4962-a052-e50208b553ad, 'Très bon, effectivement très moelleux et la poudre d''amande le rend encore plus délicieux ! J''ai rajouté une banane et c''était parfait !', '2010-07-21T23:51:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, 3ff814dd-be7c-4193-871e-cabd4bccfc54, 'Excellent, très simple à faire et très bon, tout mes invités l''ont apprécié.', '2010-06-18T15:28:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, 73cd1549-d9cd-485d-a6de-c346a4a47008, 'Effectivement bien moelleux, c''est un gâteau original qui a été apprécié à la maison. ', '2010-06-16T13:57:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, 3c7063f2-6718-4301-8ed1-a6e0d3656969, 'Excellent dessert, à refaire !', '2010-04-16T21:55:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, 5440d9b3-d6ce-44f2-b3f1-b854c07f47c0, 'Très bon ! J''ai mis du sucre complet, de la farine T80 et un peu plus de chocolat en gros morceaux, c''est excellent, très bonne recette et très facile à réussir, merci !', '2010-03-07T10:11:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, 9b14733c-b8ca-4f43-9889-3aa805bf71a3, 'Super!! J''ai mis environ 150g de chocolat, c''était très bon ! J''ai dû le mettre a cuire un peu plus longtemps, surement car je l''ai mis dans un moule à cake. La prochaine fois je mettrai du gingembre !!', '2010-03-04T22:45:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92594, 45198846-aeae-4e85-abbb-ac2403e978a9, 'Très facile et très bon. J''ai ajouté 50 g de chocolat pour le gout et baissé la température pour un moelleux encore plus fondant. Délicieux!', '2009-12-15T16:20:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, ca82b170-98b0-4431-b6de-61d45e805ca4, 'J''ai mis le double de bananes, 2 cuillères à soupe de cassonade et je n''ai pas pris de confiture. Juste 3 cuillères de cassonade à la fin pour caraméliser.
Cette recette est excellente ! (Prévoir bien 15 à 20 min de plus de cuisson si comme moi vous ne précuisez pas)', '2022-07-03T16:48:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, 1e59a0cb-dcef-4cb0-a158-df794736579c, 'Très bonne, j''ai modifié la recette en mettant 2 œufs entiers, et en diminuant le sucre à 2 cuillères à soupe. J''ai rajouté des pistols de chocolat noir à côté des morceaux de banane. J''ai bien aimé.', '2019-06-23T11:40:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, d54a6f38-ea22-4ed9-9645-74a746ce9eb1, 'Très bonne tarte, mais, comme toutes les préparations à base de banane, ne se conserve pas. A déguster le jour même!', '2009-02-10T12:24:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, b7124fa7-098b-4618-9439-7d80c98e03c0, 'Vraiment excellente j’ai fais une meringue dessus 
Très bon ', '2022-02-06T15:26:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, 2ffd814f-3da2-4ffa-b714-274ddd860787, 'Excellente recette meilleure froide que chaude par contre !!', '2019-04-16T07:38:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, 0b45881e-525a-4372-903f-97f23c5ef04d, 'Exellente recette j''ai juste rajouté du sucre vanillé', '2018-02-22T07:40:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, d90534d5-c313-470f-ab7f-608c71f67a2e, 'Excellent ! On ne s''en lasse plus ! Devenu le dessert préféré officiel de la maison', '2017-12-30T23:49:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, e9e0fe0e-37d6-4ef5-9def-27b04a3789cc, 'Une tuerie ! Facile, rapide. C''est la meilleure que j''ai mangée. Merci pour cette merveilleuse recette !', '2017-11-23T15:51:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, 0a74f54a-9b7c-4f6e-a0d9-d975bac90e1c, 'Excellente ! On a suivi les conseils avec 100g de sucre.', '2017-08-26T18:17:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, 1fff4e4c-4666-4a0b-ae30-fda9fa5f6f85, 'Vraiment délicieux! Je n''ai mis que 100g de sucre (50g au fond et 50g sur le dessus) c''était parfait! Merci pour cette recette!', '2017-06-11T10:51:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, d4b11c94-0513-4708-94c1-ce885b8101bc, 'Un régal ! on n''en a fait qu''une bouchée ; et facile à préparer en plus. Je n''avais pas de marmelade donc je n''ai rien mis dessus mais même comme ça elle était délicieuse. ', '2017-05-26T17:03:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, 57abd1af-879f-49b7-912b-fc28debc54d8, 'Génialissime !!!! Réalisé avec des rondelles de bananes macérées dans un punch.', '2017-03-21T16:21:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, f4a090a0-95af-4bff-a32c-f5eb1c51be9f, 'J''ai suivi les conseils pour le sucre 100 g c''est largement suffisant et même peut-être encore un peu trop surtout si comme moi vous utilisez des bananes très très mures. En tout cas on s''est régalé.', '2016-05-19T22:06:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, 55b68104-a73e-4d8c-94f1-b6aaff238a78, 'Je n''ai mis que 100 g de sucre et supprimé le sucre glace, et c''était bien suffisant. J''ai aussi râpé une 1/2 fève tonka dessus avant d''enfourner. Résultat bon et joli aussi. Encore meilleur je trouve après une nuit au réfrigérateur.', '2010-01-12T16:06:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, c07a30eb-3cdb-4edc-8c65-122a229c272a, 'Bonne recette, tout le monde a aimé, juste mis que 3 cl de rhum et que 100 g de sucre.', '2008-08-16T15:24:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29060, 2c41b2b7-d2a0-4179-9fbc-9af4775c79c6, 'Testé et apprécié, mais sans mettre le sucre glace. Merci pour cette bonne recette.', '2008-06-28T19:46:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, 677358fe-3218-4fac-993f-fdf7de33b052, 'Tarte très bonne permet d utiliser bananes mûres .', '2020-03-22T16:44:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, c380f6fa-5bc0-4ddb-8582-6746c5257576, 'Très bonne idée. J''ai raté mon caramel (trop fort) mais malgré cela très convainquant. Je ferai plus attention la prochaine fois et mettrai également plus de rhum sur les bananes.', '2017-10-28T12:55:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, 3c5f6544-3be4-4820-adbd-6603fc2398dd, 'C''est une vrai tuerie, super recette. J''ai rajouté une banane supplémentaire et 40 g de beurre par ce que je suis très gourmande :-). Pour avoir un bel aspect, n''hésitez pas à faire un caramel bien doré et faire cuire la tarte dans le tiers inférieur du four pour qu''elle soit bien dorée. Pour ceux qui n''aiment pas le gingembre, du citron vert, du rhum et/ou de la vanille peuvent remplacer. ', '2014-08-31T18:44:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, b04332c3-d6f7-4f2c-b72d-1b23c7fc2b75, 'C''est une bonne tarte... J''ai oublié les épices mais le résultat était bon quand même !!! Réalisé avec du beurre salé dans le caramel. Super original, j''adore!!', '2016-07-24T19:08:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, c2bdfad9-5c03-4552-8b0b-91672881d5aa, 'Huuum ! Délicieuse comme ça. Excellente également avec du caramel au beurre salé, vanille et rhum.........', '2016-07-21T21:17:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, 0fbbf5a5-8711-4e1a-ae9e-08bd7fb48ffa, 'Je ne laisse jamais de commentaire mais là je dois avouer : cette recette est vraiment excellente ! J''ai utilisé une pâte feuilletée plutôt que brisée (achetée toute faite), ajouté quelques gouttes d''arôme de vanille sur le caramel au fond du plat, mis 1 cuillère à soupe de rhum sur les bananes et fait mon caramel avec du beurre (environ 40 g de beurre pour la quantité de sucre de la recette). Par contre la prochaine fois j''insisterai encore plus sur les épices. Pour les personnes qui ont peur de l''effet nid de serpents (idée déjà étrange puisqu''on n''en voit pas vraiment tous les jours, mais soit) il suffit de couper les bananes en 2 dans le sens de la longueur, mais aussi en largeur, et on peut ensuite les disposer joliment en décalé. Servi avec une boule de glace vanille.', '2016-04-03T01:25:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, dfca9325-aaee-4b9b-8568-cfe731f2e22c, 'Très bon. Pour éviter le visuel "nid de serpents", on peut couper les bananes en deux, ou simplement les couper en tronçons de 3 ou 4 cm de haut, et bien les serrer dans le plat... Une pointe de rhum dans le caramel enlève un peu le côté trop sucré.', '2015-09-18T12:35:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, 89ad9953-25a0-4fd3-ac77-6b8dd5674e3b, 'Excellente tarte qui change des tatins traditionnelles. Succès garanti!', '2014-04-23T11:21:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, 8d8ac77e-bb97-40a4-9a97-730345ab5d2b, 'Très bonne recette. Facile à réaliser, et qui fait son petit effet face aux invités. Beaucoup de goût, ne pas hésiter à mettre pas mal de gingembre, car la banane prend vite le dessus. A refaire !', '2013-09-29T16:43:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, 37792294-1104-4684-a04c-70cdfc4fa020, 'Je n''ai pas fait de caramel, j''ai juste mis du sucre au fond du plat (qui caramélise au four) pour gagner du temps. J''ai mis une touche de rhum sur les bananes, c''était très bon !', '2010-06-02T16:12:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, 6c3c6dea-ab8f-4069-9b1d-fb45a16cc2c9, 'Délicieux ! Mon caramel n''était peut être pas bien fait, du coup, la tarte s''est démoulé très vite! Mais elle était super bonne et ça sentait le gingembre et les bananes dans toute la maison ! Merci pour la recette !', '2010-04-07T15:58:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, 93d82aeb-7dc0-4db4-9d6e-b94aad2396ee, 'Facile et très bon !', '2010-03-31T01:25:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, cd1c7ade-5fcb-42c6-b583-9fbffecc55f8, 'C''est très surprenant et très bon !! Je referais !! En plus quand on dit que c''est une tatin les gens nous lance un "oh" d''étonnement ! En ce qui concerne la présentation je l''ai trouvé très belle ma tarte avec les bananes dorées !!', '2007-07-07T15:04:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, 25f65f2b-5fac-4fed-b932-1f9fb80c0074, 'Excellent et très léger!', '2007-02-20T19:43:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, 2cef54f8-5e25-48c4-ab74-5504be5b496d, 'Toujours un grand succés quand je la prépare! Avec une pâte brisée toute faite, je mets toutes les épices que j''ai dans le placard... Seul l''aspect au prime abord n''est pas sensas, mais l''odeur et le goût sont géniaux. Merci pour cette recette.', '2006-10-11T19:40:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, cbe15ac6-c079-40a3-b2cc-f3c7bcfe077d, 'Saveur excellente. Simple à faire et rapide. Par contre c''est assez "moche" à regarder...mais l''essentiel c''est le goût non?!', '2006-07-10T17:18:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, b783dbf7-4387-4e14-a91c-417ae13a695a, 'Je suis étonnée du résultat... Je ne parle pas de la saveur, qui est très bonne, mais de l''aspect!!! La couleur qu''a donné le caramel aux bananes coupées en 2 et déposées en rond... est un vrai nid de serpents ! Brrrr...ahahaha... Trop gourmands, on a quand même tout mangé... Mais on ne renouvellera pas l''expérience... ', '2005-11-26T14:42:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, 80c1d182-b80c-4673-ab7c-b777c39c32b9, 'Excellent, ça fond dans la bouche, c''est original et c''est préparé en 10 minutes sans aucune difficulté! Le dessert qui sauve en cas d''imprévu! Merci!', '2005-11-10T08:16:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, cc48128f-9123-448a-89db-13c2f61c66a1, 'Cette recette est très très bonne... Pour une variante, moi je fais un caramel salé, simplement en ajoutant 50 à 70 g de beurre salé au sucre dans la casserole. A essayer c''est succulent...', '2005-07-05T20:21:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, eb089a59-36f0-4f89-88ed-11752b67b97b, 'C''est très bon et peu sucré au goût. Plutôt que de faire moi même le caramel, j''ai directement utilisé le caramel liquide et j''ai mis une banane de plus pour combler tous les trous... Résultat plébiscité par toute la tablée.', '2005-06-05T20:08:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36627, ec76590f-11cc-460b-ba29-1445eccf8bcb, 'Très bon et original,un vrai succès! ça change de la traditionnelle tarte tatin! ', '2005-05-25T12:07:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21900, 7e8ceadf-1b2d-4c82-94fa-fcf39686bb6c, 'Encore meilleur avec une boule de glace vanille !', '2016-02-26T22:42:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21900, f47869f6-7e4f-4e86-8f83-295f3cee21ed, 'Simple et bon !', '2015-02-10T19:42:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21900, 481ae4c5-6751-46e8-af1f-12720fff8693, 'Une très simple recette et un réel petit délice. Merci.', '2013-02-24T21:13:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21900, a7b8a01a-e548-43f4-8d4f-72754eacf912, 'Très bon et très simple à faire.', '2013-01-27T22:48:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21900, 1ccab9b7-af56-45b9-b12c-7cc3abc1e7cb, 'Excellente recette. On peut effectivement diminuer un peu la dose de rhum et de raisons secs et songer à faire mariner les raisins quelques heures à l''avance, mais c''est très bon.', '2011-11-13T15:44:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21900, 5cdc10dd-e60a-4a50-bc8f-cb3c63281893, 'Très bonne recette que je referai. Je me suis régalée.', '2011-11-06T20:18:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21900, feca4d21-588e-4d63-8a57-e04cdd77ea2b, 'Ultra simple et rapide (faut tout de même laisser aux bananes le temps de cuire...). J''ai utilisé du beurre salé, diminué les doses de rhum et de raisins de presque moitié (60 g et 60 cl) et oublié le sucre vanillé, mais c''était malgré tout un régal fort apprécié. Je referai certainement. Extra !', '2011-10-16T18:33:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21900, 6bbce754-a151-4e81-8c56-a40c2108bf41, 'Toutes les recettes de bananes flambées ne sont pas top, mais celle-ci est géniale ! J''ai fait macérer les raisins dans le rhum pendant environ 3 heures. Trrrrès bon...', '2010-12-06T11:07:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166301, 7730e0ef-78f3-4b16-8897-5b108656f1ec, 'Une recette sympa qui rend tout de suite bien sans être compliquée. J''ai ajouté deux sachets de sucre vanillé pour la compote et c''était parfait !', '2012-12-30T17:57:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166301, c7a65009-c608-459a-a35f-0d083f76c999, 'Une recette simple mais efficace car le spéculoos relève le goût de tout cela. J''avais ajouté un peu de sucre dans le fromage blanc et la compote pour mes invités qui ont la bouche sucrée !', '2012-01-01T16:11:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166301, e7f7a774-fb66-4982-97b2-4bb490fc68d3, 'Délicieux ! Ultra rapide et facile ! Et en plus très léger ! Tous le monde a adoré. A refaire encore et encore', '2010-07-24T19:55:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 944ba4d3-0241-4cdd-8e60-539e12ea51be, 'Alternative super facile ! C''est vrai qu''on ne sent pas trop le goût de la banane, et les quantités sont par pancake, pas par personne. Avec 2 bananes, j''ai réussi à faire six gros pancakes.', '2022-09-04T12:34:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 8c1aeebf-7e6f-43c5-ab66-a9415e808784, 'Excellente recette pour dépanner le petit-déjeuner du samedi ou du dimanche quand on a la flemme de se lever ... Je rajoute un peu de sucre ou un peu de miel dans la préparation pour les manger nature. Super bon avec du sirop d''érable ou du sucre de coco !', '2019-04-26T11:15:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 1576a4d7-e337-4ebd-85fe-feadeab10827, 'Il aurait été bien de préciser que 4 personnes correspondait à seulement 6 pancakes', '2023-08-01T21:05:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 8d6197d0-2c1e-4425-89f9-ecae38c4c0e5, 'Très bon ! Marche aussi avec du lait de vache.', '2022-03-29T20:02:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 85625630-2e4f-480d-8460-2853a9ae0bb9, 'J’ai mixé la pâte pour avoir une pâte lisse. C’est délicieux.', '2019-09-08T10:55:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 39e420a7-6ea3-4324-8d82-197f63cf2d5d, 'Texture pas très agréable à cause des flocons d''avoine.', '2019-05-02T18:46:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 9434abdc-412c-42a6-abd4-2cc2c115d871, 'La texture tient plus une galette irlandaises que d''un pancake. Ça permet de passer des bananes trop mûres et en effet de manger équilibré au petit déjeuner.', '2023-09-10T09:04:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, a81f9a36-4d42-4683-be8f-e6c7614c7682, 'Très bon ses mieux de réduire en poudre les flocons d avoine pour avoir une consistance lisse maintenant chaqun ses goût je r ajoute par dessus beurre de cacahuètes et confiture de fraise un délice au petit dej le plein de protéines 

', '2023-07-15T10:12:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 63c1f7be-eab1-47c4-b261-0275b72b9ec4, 'Excellent!! ', '2023-05-01T16:10:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 34a86109-6b8b-493b-b9c7-744571ef37e9, 'Très bonne recette healthy, je recommande ! 
', '2022-09-11T19:27:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 4ba75af9-addd-48ff-b94b-e63826fb83bb, 'Très bonne alternative, on ne sent pas trop trop le goût de la banane, pour ma part j’ai un peu mixé les flocons et je n’ai pas mis de levure et c’est top!bon ça n’a pas le même esthétique que sur la photo bien sur ;))

', '2022-02-10T16:57:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, cff4534b-d5a3-45ce-a52a-49e8d7008b72, 'Très bon ! (pas très esthétique chez moi car je n''ai pas mis de levure, mais super bon !)
En revanche, la recette pour 4 personnes est très légère pour 4...', '2021-10-15T19:12:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 4a0d1fb9-514a-465b-9205-39485ce0ea96, 'La photo de la recette n''a aucun rapport avec le résultat véritable pour qui suivra la recette a la lettre (voyez plutôt l''image que je poste). Mon chéri et moi n''avons pas du tout aimé le rendu, le goût de banane est très prononcé comme on peut s''en douter, mais le mélange avec l''avoine et l''amande ne nous a pas plu du tout. ', '2021-03-25T11:37:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 1be3a1a4-12d6-4105-8209-a733c316ea20, 'J''ai mis 2 bananes à la place d''une pour remplacer la levure et j''ai mixé l''avoine avant de le mettre dans la recette et c''est super bon! Je valide ', '2021-02-28T13:53:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, cf00a9c8-8ac7-4b04-9dff-5ea16f017f68, 'Top', '2021-02-06T09:39:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 05f12139-a0c6-4402-b374-eaa1131010b6, 'J''ai essayé hier. Bonne recette.', '2020-08-30T09:18:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, ae84ba87-7404-4939-ab70-12f706aeb083, 'Très bon !', '2020-08-02T23:36:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 57af3d89-dd27-41b4-8bd9-f28c2410e749, 'Très bonne recette ! Pancakes réussit et délicieux, bien meilleure que la recette traditionnelle ! ???', '2020-07-07T11:52:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, e6dddeee-124a-49ba-b84c-c6a201934396, 'Recette réalisée jai lu les commentaire donc jai tout mixer au robot et comme je voulais quelque chose de plus "light" jai mis de la compote a la place de la levure jai laisser reposer 30 min. La pâte etait un peu trop epaisse donc j''ai rajouter un chouilla de lait jai mélanger fait cuire et jai tout englouti a moi toute seule c''était trop bon. ', '2020-06-24T11:55:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 571e3c9a-d0d6-4437-b946-1d979b47af91, 'J''ai du rajouter du lait d''amande la pâte était beaucoup trop compacte sinon belle recette', '2020-06-03T19:03:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, ca7fa97b-4d52-45df-97ea-e21f4d15c6f3, 'IL n''est pas préciser de mixer la recette ne marche pas', '2020-04-15T10:23:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 415e698b-3680-456f-90ff-4c1be020a745, 'Très bon, je n’avais pas de levure alors j’ai mis une compote ! Avec ce dosage environ 6-7 pancakes. Je commence tous les dimanches au ptit dej’ !', '2020-03-26T08:03:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371879, 604d25bb-94e1-4fcb-881f-cfb27ab9c527, 'En mixant les ingrédients la recette est top ! ', '2019-11-26T12:26:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223532, 28d68ed3-7656-4dd9-b3d9-6d7ff56973d0, 'Recette hyper facile et rapide !', '2022-11-23T13:57:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223532, 5e52313a-1ce9-4385-bef8-8b7c80207cab, 'J''ai dû ajouter de la farine mais c''est yumi ! ', '2016-05-09T17:39:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223532, 08400f7a-2a69-4e3f-948d-4934ef5d6bbb, 'Très simple à faire et délicieux   ', '2015-05-25T20:15:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223532, e4b5a8ce-2c40-4416-8f74-4eb32ef2f619, 'Maintenant, quand mes bananes sont trop mures, je viens directement prendre cette recette ! Merci Pati...', '2012-12-15T20:24:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223532, 845cb885-fe8f-421b-9ad8-517d50561a36, 'C''était délicieux et simple, merci.', '2012-06-19T17:41:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, e99eddec-a493-448a-9ee3-2a728501bfe0, 'Je l''ai faite avec des fraises et j''ai trouvé que c''était très rafraîchissant et léger.', '2019-06-08T11:45:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 6d03b764-299c-40c8-9291-d448212d3454, 'Inutile d''ajouter de la crème, à la limite du yaourt mais pas d''oeuf ! Les fruits seuls suffisent !', '2016-10-17T11:22:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 92b0f749-6471-480e-8033-49406d7d2f1d, 'Excellent mais ne se conserve pas longtemps.', '2018-12-15T01:50:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 13625c50-daa8-4778-b79c-1f96ad27fa83, 'J''essaierai bien ce dessert, je le trouve très équilibré.', '2018-03-22T00:39:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 4b5ee2c1-ee79-4a6a-bc70-6ae29d6a6417, 'Un délice je recommande !', '2017-06-27T12:16:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 0b6dfcc7-2095-4ae7-8647-ecd6baad9d79, 'Aucun intérêt... la mousse est en fait liquide avec les deux blancs, la couleur noircit...j''ai ajouté de la vanille et remplacé le sucre par du sucre vanillé mais cette recette ne mérite pas d''être réalisée... dommage cela avait l''air appétissant sur le papier! ', '2016-05-04T00:43:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, b3617613-1059-415c-84ba-9250e9d42fc0, 'Très bon, j''ai adoré. La petite différence que j''ai faite, c''est d''incorporer les kiwis au mélange et juste utiliser quelques morceau pour la déco. Du coup dans les coupes à dessert transparente ça donnait super bien', '2014-01-18T20:04:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, e51e22fb-ab27-4e4b-b6d9-8b361256c6bf, 'Délicieux, apprécié par les grands et les petits, super recette !', '2013-03-22T12:36:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, c2dfcdce-082f-44f7-843f-9b29a61e6646, 'Agréable et frais. Peu de goût mais les fruits ajoutés donnent de la texture. La mousse toutefois n''est pas assez épaisse. ', '2013-01-20T18:19:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, ece571f4-9624-4938-8c9b-816b651800aa, 'Très facile, ça plaît beaucoup, c''est frais et très agréable !', '2012-04-14T13:09:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 627ad743-8ec8-4297-8262-d4c5063fabbc, 'disons que l''idée n''est pas mauvaise mais il faut juste revoir un peu les mesures et l''adapter au goût de chacun. ', '2012-04-07T18:59:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 14322b22-8aff-454a-ade4-b396055feaf2, 'Très bon dessert. Je n''ai pas mis de sucre et c''était parfait pour l''été. A servir très frais, mes invités étaient ravis.', '2012-03-31T20:56:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 82896f3e-6b63-437e-ba63-ad9bc9481520, 'Excellent frais et léger, j''ai mixé les kiwis et mis au congélateur 30 min  La prochaine fois je doublerai les kiwis', '2010-01-24T17:02:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 600875b6-17af-489b-a033-68ef21322f57, 'J''avais dégusté une délicieuse mousse banane dans un restaurant africain de Strasbourg, et je me suis mis à la recherche d''une recette.  Celle-ci donne un résultat satisfaisant, mais ce n''est pas aussi léger que je l''aurais espéré, et le goût de banane est, comme quelqu''un l''a déjà dit, assez vite écœurant.  J''essaierai plusieurs choses : citron comme on l''a proposé, mais aussi vanille. Je verrai ce que ça donne à ce moment-là. Je pense aussi à un arôme de banane en plus de la "vraie" banane. Avec la recette tel quel, c''est un peu décevant à mes yeux. Il est certain qu''avec les bananes de mûrissoir qu''on trouve en métropole, on ne peut pas avoir le top...', '2009-01-03T11:40:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, af038def-961c-4798-aa26-6cfcb0294dad, 'Excellent dessert, à déguster frais, un vrai régal. ', '2023-03-24T22:02:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, a8b157cb-de02-447a-a835-d12ce9d6f095, 'Une tuerie, tous les invités ont adoré !', '2022-11-01T01:37:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 360a1ab4-06e0-408d-a9c5-ac5ed83335c0, 'Simple, recette comme indiquée et texture ok. Niveau goût, peu de finesse mais pas mauvais.', '2022-10-09T14:48:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 25e62313-86c1-44ee-96a7-b86aa3f6719d, 'Superbe !  !', '2018-02-14T12:01:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 83cdaadd-df0b-4973-a7a8-3be0ba28a2c4, 'Très beau et une bonne idée pour le désert.', '2017-06-15T17:17:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 15d447a2-6fc9-472f-973a-6c31ae51eb9c, 'Bof. Pas grand intérêt.  ', '2017-03-10T09:32:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 9bfbfe62-04bf-4515-a452-3b1c4670932e, 'Miam ', '2016-04-23T13:17:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 24c8e1f8-a2af-46ca-96b9-ca548a724bcc, 'Pas mauvais mais déjà testée mieux. De plus, ça ne se conserve pas du tout donc à manger de suite !', '2012-04-13T17:44:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 54823ac9-4305-4502-8dc4-fb7c93c038ae, 'C''est bon, mais pas très joli à regarder, et cela noircit vite malgré un peu de jus de citron que j''ai ajouté. La consistance était plutôt liquide, mais c''est peut-être parce que j''ai utilisé de la crème semi-épaisse. A refaire tout de même.', '2012-04-11T15:29:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, a68a591e-0a5d-4b9e-987a-6c3df425f139, 'La banane a besoin de goût pour ressortir. Avec seulement deux blancs, j''ai trouvé que ça manquait de mousseux... attention, ça noircit vite !', '2012-04-02T22:43:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 8a308349-70c5-4859-9d4b-5a9be538fe20, 'J''ai beaucoup aimé la douceur de la mousse et le croquant du kiwi car ils étaient bien fermes. Fait sans sucre, pas du tout écœurant ou lassant. C''est bon, frais et très rapide à réaliser.', '2012-04-01T12:07:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 6a6dfd70-2e83-450b-9942-c8a0292472a1, 'Très bon dessert facile à faire et léger !!! Par contre, j''ai ajouté un sachet de sucre vanillé au mélange banane + crème fraîche. Comme cela a déjà été dit : du sucre est prévu dans les ingrédients mais pas dans le déroulement de la recette, j''ai donc saupoudré le dessus de mes verrines.', '2012-03-28T19:59:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, f97c5581-e427-447e-9d04-2c94783da04f, 'Texture assez spéciale, mais très bon goût ! Je l''ai aussi fait avec 3 blanc d''œufs, je me demande même si avec 4 ce serai pas encore mieux... A voir. Je les ai servi dans des verrines avec des fruits rouges (sac congelé trouvé en grande surface) et c''est vraiment EXTRA ! ', '2011-11-16T21:23:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, d1ba490c-362b-4200-a409-284db85f2e53, 'Frais et fin ! Un régal', '2010-06-24T22:22:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 0c797786-4f82-4252-a052-dad5ebbf78b6, 'La texture n''est pas très appétissante, et le goût à revoir. Dommage car ce dessert pourrait être bon et léger dans d''autres proportions. Reste à les trouver.', '2010-05-01T16:06:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 813acf3c-ee42-40f5-afd1-192b30da6caf, 'Excellent ! Tout le monde a adoré ! Simplement, il faut utiliser un blanc d´œuf de plus et les monter en neige bien ferme, c´est-à-dire que si on retourne le plat dans lequel se trouvent les blancs en neige, les blancs restent au fond et ne tombent pas par terre (du moins pas immédiatement...) !', '2010-04-13T18:22:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 08a8f615-066b-4d77-baa6-5b649a6b1f3a, 'Très bon mais il faut pas mettre beaucoup de sucre car moi j''ai fait l''erreur d''en mettre un peu plus car mes bananes étaient pas trop mures et en fin de compte c''était trop. Très bien pour une fin de repas', '2010-03-10T13:21:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 2f01512b-222f-498a-af8d-c64dd64fc139, 'tres bon, j''ai mis une cuillere a soupe de sucre seulement, les bananes étaient bien sucrés!', '2010-03-05T18:36:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 0e0655ac-d4a9-48d0-af07-d611388429d8, 'C''était pas mal, tout le monde a fini sa coupelle (même les enfants). Par contre, pour un dessert, il manquait du sucre, donc on en a rajouté suivant notre goût.', '2010-02-14T19:15:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, f94deba3-5cd6-4ada-b7c6-712610e20b69, 'Oui, pas mal... surtout pour utiliser des blancs dont les jaunes servent dans une autre recette ! Bien . Deux bananes suffisent, pour deux blancs, et un fromage blanc type "Velouté" à la place de la crème fraîche, et un sachet de sucre vanillé, et du sucre en poudre, et des demi-tranches de kiwis disposées en éventail, et voila un dessert familial tout à fait présentable ! Merci.', '2010-01-26T13:05:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, bee95ed4-300d-428b-a2e7-43932676492b, 'Le mélange est bon, je trouve que ça manque un peu de mousseux pour une mousse. Peut être un 3ème blanc ?Bref, à faire et refaire pour le plaisir !', '2010-01-23T21:43:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, c105dcc7-1f01-4e22-a06f-da9a86263931, 'Je n''ai pas mis de blancs d''oeufs, mais j''ai remplacé par quelques gouttes de jus de citron et 2 boules de glace vanille. Puis dans une verrine, j''ai mis mousse de bananes, framboises, sucre, kiwis, menthe. Succès.', '2010-01-23T14:43:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 69a238c3-70bb-4be9-9bb0-c38a1ebcaddc, 'Facile et rapide à faire, mais pas extraordinaire au niveau du goût. Il doit manquer quelque chose.', '2009-12-03T12:05:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, b5501344-ebf4-4c3a-a034-eaf5a84cc753, 'Recette très bonne, je ne l''ai pas trouvée écoeurante et c''est excellent avec un cake aux épices. Le seul bémol, c''est que la mousse était un peu liquide.', '2009-03-09T21:34:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, d5123ad3-e233-44fb-ab90-080bcd59ec6f, 'Délicieux, j''ai mis moitié mangue moitié banane et de morceaux de kiwi sur le dessus. Par contre à mettre dans de petites verrines car écœurant en grande quantité.', '2009-02-23T21:31:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, a4c4fa45-5396-438d-b5fb-e5aaddae2e35, 'Dessert très facile à faire, mais pas extraordinaire à manger. La prochaine fois, je testerai la mangue avec la banane, si c''est meilleur. C''est un dessert ordinaire, rien de spécial.', '2008-12-15T19:33:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 542ff86e-814b-4616-a04d-b6dd9a3f3df4, 'Excellent et très léger. A essayer avec d''autres fruits et en petite quantité dans des verrines par exemple!', '2008-12-15T13:28:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, e84719cc-ff01-41a8-91e0-4676bca53c75, 'On s''est vraiment régalé. J''ai ajouté du jus d''orange et remplacé les jaunes d''oeuf par des glaçons, c''était tout aussi mousseux.', '2008-10-13T15:07:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 12a5b836-c8ef-4371-b02a-e5e1a3abbd81, 'Excellent, très léger Le faire dans de jolis verres, c''est très chic!', '2008-10-10T20:46:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 51625725-f432-4067-8188-b40ba89aab31, 'C''est vraiment très bon, j''ai dû écraser les bananes avec une fourchette car je n''avais pas de robot, mais sinon je pense que c''est très rapide à faire.', '2008-09-16T14:48:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, f4241fb5-05ff-4cdf-ab93-ccb68edb0800, 'Très frais, très bon! J''ai simplement ajouté un peu de jus de citron pour que la mousse reste bien blanche.', '2008-05-12T12:37:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 1b5594a0-06af-4a48-8dea-7ca2881d25a3, 'Sympa, et cela change', '2008-04-16T11:34:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, e05d7fd4-3704-46b9-b250-6632f4954ec0, 'Délicieux, très frais, très léger...facile à faire, la prochaine fois, je mixerai peut-être les kiwis, suivant l''idée d''une internaute..', '2008-04-08T18:56:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 612e189a-4fd7-4546-a2d2-0c66acf38708, 'Super rapide et délicieux!', '2008-03-11T12:12:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, bd621e86-5d12-425f-aa4a-6122578c299e, 'J''ai remplacé la crème par 200 g de fromage blanc. C''est très onctueux et mousseux mais le goût de la banane est un peu écoeurant...', '2007-12-27T10:23:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 3bbbc3c9-a2f3-4ed2-9576-1ade3436d34b, 'Très bon et très onctueux. J''ai par contre essayé de mettre de la poire à la place de la banane et c''est nettement moins bon (trop liquide).', '2007-12-07T19:47:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 5d76f90c-4379-411e-a3cd-aca087b97eed, 'Très bon, très frais. J''ai juste mixé les kiwis pour garder le côté onctueux de la mousse, et rajouté pas mal de jus de citron pour empêcher la mousse de banane de brunir. Délicieux.', '2007-12-05T18:04:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 276038bb-a201-41a0-aa20-8ef06210822b, 'Merci pour cette recette à retenir. Pour ma part j''ai utilisé du mascarpone et j''ai mixé une mangue avec les bananes. Je vais sûrement réessayer avec du fromage blanc plus "diététique".  ', '2007-12-01T21:21:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, c7a9a304-9cc6-462a-9e66-3235828001e1, 'J''ai suivit scrupuleusement la recette... Et : Dé-li-cieux!!! Ca a beaucoup plus, les enfants ont adoré! Merci!', '2007-11-23T13:34:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 32e88ca6-dedd-4261-a79a-5374d0443df7, 'C''est bon, même si le goût de la banane ressort beaucoup plus que le Kiwi. Cela manque une peu de consistance. C''est peu être du à ma crème qui était semi-épaisse...', '2007-11-18T17:46:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 193eeeff-dca0-41d9-99ce-689e9ddf808a, 'Bon, simple, très rapide, je l''ai présentée en verrines avec de fines lamelles de pommes citonnées sur le dessus. Ça se mange tout seul!', '2007-10-05T14:53:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, 59087c2f-9b3c-44b3-a6f6-94ae2d7d817f, 'Très frais et très bon. Mon mari partait avec des à priori. Finalement, il a beaucoup aimé. Merci pour la recette!', '2007-05-03T21:57:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, db33a16b-2d9e-4131-adc0-6f248b3bc922, 'Tout le monde a beaucoup aimé, très réussi : bien frais! Merci.', '2007-03-23T14:57:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, e42868e6-d217-472d-b59f-5faa451b3a1b, 'Très bon et très joli, c''est frais, à refaire avec d''autre fruits!', '2006-03-15T17:25:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, da48b0cc-5f4c-4652-ac23-3a186690e209, 'Simple et très bon: un dessert léger et rafraichissant! Par contre, il y a du sucre dans les ingrédients et pas dans le déroulement de la recette : j''ai donc juste décoré la mousse avec un peu de sucre de canne. Mais le résultat manquait de sucre ! Quand je referrai cette mousse j''y ajouterai du sucre.', '2006-03-06T17:35:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36422, b4e6bfc7-5014-4377-8274-9bda8f11e9e1, 'Très bon, très facile. Cependant, manque un peu de consistance, à tester avec une feuille de gélatine.', '2006-02-08T16:51:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (221062, ac0d2fed-7ada-49ee-98fa-b0b6b8feca04, 'Permet de récupérer les fruits trop mur. Et c’est très bon en plus !', '2019-07-19T09:55:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (221062, ceeecb21-3aea-4c20-8987-77d275576eb3, 'Un délice à refaire.', '2019-12-02T17:27:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (221062, a945f99d-caf0-4585-a521-b2d9a3d9afc2, 'J''ai mis a sachet de sucre vanillé à la place de la vanille. Recette succulente. Nous avons tout mangé au goûter du coup j''en referai demain.', '2017-07-15T17:59:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (221062, ed63aa3b-ecc2-44ac-ac06-94894670b7f0, 'Excellente recette ! Pour moi le sucre est en trop et pourtant j''ai utilisé des pommes peu sucrées. Je referai cette compote que nous avons tous aimée.', '2015-09-06T17:59:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (221062, 618bff6c-b4aa-403c-a572-9dcb2f0dcb64, 'J''ai adoré !! Facile, rapide et c''est nickel pour un petit dessert bien sympathique.', '2015-02-08T11:58:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (221062, 26590692-1886-484e-8fbf-089a56e41432, 'Une bonne façon de ne pas gâcher des fruits trop murs. Excellent!', '2015-01-23T17:27:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (221062, fbdd9113-60bf-4cfa-b3d6-d330253945ff, 'Très bon, et l''orange permet d''obtenir une compote d''une très jolie couleur.', '2014-02-08T15:56:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (221062, 7219221b-69df-4f12-bea5-26f62725bc04, 'Simple à réaliser et très bon. Merci.', '2011-12-29T19:16:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212252, 1d221074-66e0-4855-82ba-fe23565b3221, 'Recette faite qu''avec de la banane.
Rapide, simple et très bon.', '2020-05-04T21:56:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212252, 55e6637d-2585-46f4-9e6a-9c90affb23b8, 'Pas mal, mais je trouve qu''il n''y a pas assez de fraises par rapport aux bananes, je pense qu''il faudrait plutôt 200 à 250 g de fraises ; pour moi ça manque aussi un peu de sucre, ce serait peut-être mieux avec un sachet de sucre vanillé', '2017-04-15T11:47:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212252, d2d88740-e581-4eb9-a6f1-318f993a5d0c, 'C''est super !', '2016-06-05T01:16:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212252, 8c63b9e2-aecc-499d-aec9-e39cbd8cfb0a, 'La texture ressemble un peu à un flan mais le mélange de fruits est excellent à refaire tout le monde à adoré. ', '2013-06-28T00:10:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219199, 7d8e6711-3ec2-473d-9be1-0c07c21e7ad4, 'Un délice. Suivez la recette à la lettre, vous allez vous faire plaisir.', '2020-11-30T08:36:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219199, c50b4a4d-ff16-4256-ad4c-9237aa6d8ddc, 'Délicieux mélange fruits et fromage blanc, et facile à faire.', '2013-05-09T02:45:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219199, 4ff95548-9a54-4c42-9c94-a6fdc9be8307, 'Simple à faire', '2022-01-29T21:24:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219199, feff8b7a-57f1-4cb5-8238-7360f94793bb, 'Bonjour Je les est fait pour ce soir facile à faire au top .', '2022-01-18T18:05:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219199, 3e9c450c-1d9a-40bb-88c8-0d8e4f31ed3f, 'Super recette, facile à faire et rendu sympa', '2022-01-18T14:17:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219199, 9606893d-33a8-4fdf-b6e5-55418d47a373, 'Grand succès pour ce dessert équilibré, inutile de rajouter du sucre si les fruits sont bien mûrs, juste un peu de vanille. Merci pour le partage !', '2022-01-17T17:51:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219199, 387bea1f-1801-49d2-bd9a-8c9e2bede3a3, 'Facile et certainement très bon
', '2022-01-13T18:35:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219199, dd4af093-d47d-4d56-8abd-f4a3f166d8f9, 'J''ai un peu modifié : j''ai mélangé les biscuits émiettés et le fromage blanc, et ajouté de la glace au spéculoos et un peu de Chantilly. Dessert rapide et bon. ', '2014-04-13T22:43:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219199, a0d5b69f-1044-459a-8267-3d90dd6c6666, 'C''est excellent! Le silence a régné quand tout le monde s''est mis à goûter ce dessert ! J''avais peur que ce ne soit pas assez sucré, donc j''ai légèrement saupoudré de sucre la deuxième couche de fromage blanc, et j''ai remis aussi un peu de sucre sur les pommes, avant de mettre les miettes de spéculoos... C''était hyper bon ! En fait, les spéculoos sucre bien, même s''ils ne sont que dessus. J''ai passé un peu de temps quand même a faire caraméliser mes pommes... Les bananes cuisent plus vite, mais ça réduit donc j''en ai fait plus que noté dans la recette. C''est un dessert copieux quand même. Mais à refaire sans hésiter ! Et ca ne coute pas cher ! Merci !!', '2013-04-22T12:07:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219199, c87ca541-184c-49d8-b3e6-c3ee6963f207, 'Très bon !!!', '2013-02-16T12:18:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (219199, dede1c3c-d515-4df6-991e-bb9226428578, 'Très bon !! ', '2012-09-04T17:22:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11296, 033d9b0e-5a2e-4a1f-ba05-a67bc45c7dd8, 'Simple, goûteux, accompagné de pâtes fraiches.', '2012-02-12T19:19:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11296, 4a0ba3b4-660c-4310-b528-c3c3e672dbf0, 'Je trouve cette recette excellente. Je l''ai faite avec des cuisses de poulet bio et du citron vert. Nourrissant, mais succulent!', '2006-05-18T14:30:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11296, e4ef2aae-dbe2-412b-a09e-82e8b90165a4, 'Recette à faire à mon avis avec des blancs de poulet, car la cuisson est assez difficile. La sauce n''est pas mauvaise mais sans plus.', '2004-10-06T22:14:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35716, 0646f82d-143a-445d-a7cf-b7c6351d9d48, 'Excellent! J’ai ajouté les épices comme conseillé dans les commentaires et réduit le lait de coco par 3. 
', '2023-10-14T20:09:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35716, c2057e64-1e27-4b49-8dc7-d5b80df82c05, 'J''ai suivi les conseils en ajoutant du curry et du paprika, une tuerie. À servir avec un petit verre de litchi et/ou de vin blanc.', '2017-01-18T21:43:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35716, c9231191-e4df-4e1e-a4a3-9af06c04c5b9, 'Recette originale mais un peu monotone si on n''ajoute pas d''épices. J''ai mis du curry et un peu de paprika, les deux se mariant très bien avec le lait de coco et le goût prononcé de la banane. A refaire sans hésiter !', '2010-11-21T11:44:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35716, 184e9826-ac8d-4245-9115-f8e721e4f030, 'C''est bon, mais ça manque d''épices... la prochaine fois j''essaye avec du curry ou du paprika.', '2008-10-04T19:28:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35716, b8faff56-c3c6-4259-b222-f5f6254c4c8e, 'Super facile et bon. Moi j''ai mis une banane par personne et un peu de pigment de Cayenne, le tout servi avec du riz au beurre.', '2007-03-03T18:23:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35716, 7bda5026-9c38-4811-9cf8-b06b782333ce, 'Facile et exotique... Je n''ai mis que deux bananes au lieu de 4 et j''ai trouvé que cela suffisait.', '2005-11-06T15:49:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (531388, 1de0d9fb-063f-4a33-a649-7d5bbc097979, 'Merci, pour ce smoothie très rafraîchissant ❤️', '2023-08-25T12:10:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (531388, d4cd6917-bc77-4db8-8035-f7cd27279785, 'Très bon et très frais, on sent bien la banane comparé aux autres fruits donc pourquoi pas ajouter une demi pêche en plus pour faire ressortir les autres goûts.', '2022-07-24T14:10:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (93368, 7b0c511b-754f-4f68-95ad-233f836e1a45, 'J''ai beaucoup apprécié. Ca permet de changer la façon de cuisiner les ti-nains ou poyo. Aujourd''hui je vais en refaire en ajoutant des dés de jambon. ', '2010-11-02T14:51:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, 87f69b03-b25f-4d94-8aec-41dd816e911a, 'Très bonne recette, je les ai faits pour ma part, cuire au four pour ne pas ajouter plus de gras et avoir des brick plus croustillantes, un régal', '2018-12-29T04:32:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, 569323e4-81fc-48d1-b588-7ff89b2a2820, 'Excellent ! Je l''ai réalisé avec des bananes (bacove-je suis en Guyane et nous avons énormément de variétés de bananes) très très mûres des feuilles de brick (moins de sucre) sinon j''ai suivi la recette. Je l''ai servie avec une petite sauce au chocolat à part. Simple, facile et rapide. J''adore  ', '2014-02-17T20:47:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, dd152d47-c033-4500-be8d-962f0306a75a, 'J''ai bien suivi la règle à la lettre mais le résultat obtenu n''était pas le même. Après avoir enroulé les bananes dans les feuilles de brick et les avoir fait cuire dans le beurre restant, les feuilles se sont ramollis ainsi que la banane. Au final la banane était molle et la feuille pas cuite voire toute ramollie donc pas très digeste. Le seul point positif était le gout caramélisé de la banane... Il faudrait aussi minimum une moitié de feuille de bricks pour bien enrouler la banane.', '2014-02-16T23:09:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, d7fee6f1-e2f6-4dd7-9e82-237054dc04af, 'A trop suivre les commentaires, je n''ai pas mis assez de gingembre donc dommage. Cuisson à surveiller car ça brûle vite dans la sauteuse. Goût très sympa et s''accorde bien avec de la glace. Termine en effet très bien un repas asiatique.', '2012-10-07T00:20:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, 447abac0-e42a-43f3-a884-309e3cb08c7f, 'Très bon on s''est régales avec mon mari ! A refaire sans problème. Merci', '2011-06-22T23:15:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, 393a36cb-fea5-4a97-8808-817a2cc1f6fe, 'Très bonne recette qui termine bien mon repas asiatique. Par contre, comme dit précédemment, attention à ne pas mettre trop de gingembre pour ne pas trop masquer le goût de la banane. J''ai mis 1/2 feuille de brick pour chaque banane (je trouvais que 1/4 c''etait trop peu) merci pour cette recette à refaire.', '2010-10-28T12:28:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, 809fee7e-641f-4c04-b8ce-1005ef2117fc, 'J''ai du un peu raté la cuisson des bananes / sucre / beurre car ça n''a pas vraiment caramélisé. le beurre a fait plutôt des grumeaux avec le sucre. J''ai utilisé des galettes de riz (pour nem) à la place des feuilles de brick Et bien malgré tout ça, c''était très bon! le fondant de la banane se mariait très bien avec la texture de la galette. Mon homme a adoré!', '2009-02-15T10:33:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, e2376d30-5150-43df-ae56-a87c6241841c, 'Une bonne recette, tout le monde a apprécié, attention cependant à ne pas mettre trop de gingembre qui peut masquer le goût de la banane!', '2008-11-14T20:45:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, 26e8dac5-0a47-46a1-a6d1-aaeb9f0c884f, 'Je n''avais jamais servi un dessert aussi nul!!! Rien d''intéressant dans le goût : c''était sec, le goût du gingembre masquant celui de la banane ... bref, à oublier derechef !', '2008-11-02T22:50:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, 0b213f6e-ff4a-41ef-beaf-b5f8714c52e7, 'Mes bananes étaient un peu trop mûres et mon beurre de cuisson à peine assez chaud et pourtant, même comme ça, c''était délicieux. Mon plat principal était pourtant consistant mais tout le monde s''est jeté dessus par gourmandise! A refaire!', '2008-10-13T15:44:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, f213ad67-775e-468e-a3ee-a7d4d383f96a, 'Franchement c''est une idée de dessert surprenante originale et qui ne déçoit pas! attention toutefois à ne pas avoir eu un repas trop riche et copieux avant !!!', '2008-04-12T17:04:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, 5e46775b-de8e-4d83-b160-aefc3974d866, 'Nous nous sommes régalés. Franchement, il n''y a rien à y changer. Très bon dessert pour un diner d''amoureux.', '2007-09-29T18:41:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, 4641c595-6b56-4533-a887-811d1281ecf4, 'Pour éviter une overdose de gras, j''ai fait dorer les bricks au four chaud... moins croustillantes qu''à la poêle, mais franchement plus digestes!!!', '2006-07-31T19:21:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, 52a97865-50c7-4b2e-b84e-e506754a0160, 'Texture trop farineuse ce qui rend le dessert écoeurant.', '2006-02-19T15:53:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, 6aed7145-e335-448d-a9aa-d6eec76c708a, 'C''est original, mais c''est très gras. Attention à faire les croustillants en une seule fois... Ma poêle était trop petite et j''ai dû les faire cuire en plusieurs fois, ce qui fait que le caramel a fini par brûler!', '2005-06-07T16:22:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, 1f4278cc-6ee9-4739-92b2-1c4e7e6a298b, 'Un régal! Merci pour cette recette si simple et rapide.', '2005-03-31T18:32:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, 7b16f700-29ab-4474-941c-58b9fa0a41ec, 'Je les ai servis avec une salade de fruits exotiques relevée au rhum. Un régal !', '2005-02-20T02:07:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, f37e0413-e1e9-4921-aa68-b293e51ae0df, 'Excellent! La feuille de brick est croustillante et la banane fondante.', '2004-06-18T09:46:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21279, 84f57a1e-c6ab-48a2-999c-6031886e426e, 'La recette est très grasse, l''emballage des morceaux de banane cuits dans un quart de feuille de brick est loin d''être évident. La feuille de brick n''est pas croustillante...', '2004-02-05T20:36:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 0af426f7-f4f7-4460-8cee-311c1ca2c460, 'Néanmoins, comme toutes les pâtisseries que je prépare je divise par 2 les quantités de sucre et rajoute toujours une cuillère de bicarbonate alimentaire. Un sachet de levure complet et non la moitié. Beurre à moitié également en rajoutant 10cl d''huile. Sinon texture, goût et moelleux au rendez-vous. ', '2021-05-24T17:12:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, daa5b8ab-7d0c-4f88-9dab-0c77f1907e31, 'Recette déjà faite des dizaines de fois, je la modifie un peu en mettant moins de beurre et de sucre, et en ajoutant 50g de sirop d’érable c’est délicieux !! Vraiment facile a faire en toute circonstance !!', '2021-03-13T20:20:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, c3756e48-0e67-4bad-b94e-826db056fbda, 'J''ai remplacé le beurre par 10 cl d''huile de coco. Le gâteau est bien moelleux. ', '2019-11-18T12:18:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 087a06ea-1a50-4655-93e2-9a5e9ca73537, 'Super. Très simple et bon. Mes enfants ont adoré.', '2015-01-31T11:57:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 941e5fda-567b-4f55-acdd-8a250a19beee, 'Très facile à faire, pour 6 parts j’ai mis que 2 bananes et c’était super bon??', '2023-10-31T09:59:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 62874f78-3bcf-4d84-8d02-0a4ce65841e6, 'Parfait, il est très moelleux. Il faut juste attendre que ça refroidisse et c’est encore meilleur ', '2023-06-17T14:09:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 9a27d2e8-5677-4973-b8cf-f6561d382eb7, 'Je me suis entièrement trompé lors d''un de mes commentaire précédent, chaud il a l''air compact et pas appétissant mais finalement quand il a refroidi, hummm c''est une autre histoire. Ma fille est fan de banane et bie. Elle va être hyper heureuse au petit déjeuner de demain.
Merci est désolé d''avoir jugé trop vite dans mon ancien commentaire . 
', '2020-06-20T00:28:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, aa83c666-06cf-43c1-b6ad-dc9aefe3f3be, 'Très facile à faire, pour 6 parts j’ai mis que 2 bananes et c’était super bon👍🏻', '2020-05-13T14:10:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 91c44af9-e78b-40ee-ba25-ddc3d70cf8f7, 'Recette facile et gâteaux moelleux moi j''ai rajoute des pépites de chocolat.', '2020-04-17T11:55:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, ba0b4976-d5d9-4b92-860f-5e6f96fde63c, 'Tres facile', '2020-04-05T12:29:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 9a26c808-eb79-4cec-93ac-c980961e619a, 'Très facile à faire avec un enfant  et très bon. ', '2019-11-06T09:51:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, dd267558-353f-4bb4-a2de-828c4bfbf863, 'Gâteau facile à faire avec les enfants, et bon. J''ai modifié la quantité de beurre.', '2019-11-03T20:56:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, bcc527ac-0cef-494b-846b-fe50a3635318, 'Au lieu du sucre vanillé, j''ai ajouté une cuillère à café de sirop d''érable et je trouve cela un peu mieux. Tout le monde a aimé.', '2019-06-25T11:20:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 4bc15101-cff1-4e07-9664-ef6b09f16f61, 'Je l''ai fait, ont sent très fort la banane, mais je pense qu''il y a trop de quantité de beurre, il était bien moelleux, il était quand même bon. A refaire mais avec moins de beurre je pense.', '2017-10-02T16:07:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, e64c933e-85b4-45e6-a206-d3363c82594d, 'Bon gâteau et simple à faire. Aimé par toute la famille.', '2017-02-12T18:19:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 052e2968-adf0-4033-ac87-29db4811c6f3, 'Bon gâteau.', '2016-08-08T21:21:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 43298374-e9bb-46a2-8a5a-74a6d6eb1b0e, 'Pas très bon !!  On ne sent pas le goût de banane', '2015-02-07T22:22:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 2daa90e7-bba2-4088-b288-877f73fcf297, 'Super facile à faire... et bon en plus !!!', '2014-12-08T18:01:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, edc1eda2-367a-4795-b767-31abf3fda44c, 'Très bon gâteau je recommande. En plus, j''ai fait un glaçage chocolat (sans chocolat), j''ai mis sucre glace + chocolat en poudre avec une pointe d''eau à étaler sur le gâteau encore doux et hop au frigo.', '2014-10-27T18:26:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 9763e69f-aed3-4977-883f-9ce688ed453f, 'Très bon ', '2014-10-11T16:00:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, b5916497-de0c-45fa-9c53-54f6ef1b7bfa, 'Je fais cette recette depuis plusieurs années maintenant, je l''aime tellement que j''achète parfois trois bananes que je laisse noircir exprès.  Astuce 1 : si vous achetez des bananes exprès, suspendez-les par la jointure et attendez qu''elles soient noires de manière uniforme. Elles seront impeccables pour la cuisine.  Astuce 2 : ajoutez un peu de noisettes en poudre, c''est très bon  Astuce 3 : aspergez de rhum (blanc ou ambré selon vos préférences) à la sortie du four.', '2014-08-01T21:00:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, d21c2fad-8186-4b2e-a239-047798acdb53, 'une merveille!! parfois j''ajoute un petit glaçage au chocolat (100g de chocolat fondu avec 50g de beurre)... mais ça c''est vraiment pour la gourmandise! de plus, vu que je suis allergique au gluten, j''utilise de la farine de riz ou un mix sans gluten et l''humidité de la banane fait que le gâteau reste quand même très très moelleux!', '2013-03-03T20:27:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 8e5e32ca-b838-4db7-bf48-55dabc5a1033, 'Humm vraiment bon et facile à faire !!!! Un très bon goût de banane !!!! A refaire sans hésiter !!!', '2012-11-18T15:36:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, dab08552-96d2-449d-8484-a42cc9a65a33, 'très bon et très simple à préparer. à refaire sans hésiter. ', '2012-04-16T01:35:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 61323959-e13d-40df-93ba-d7133411dde0, 'Très bon. Consistance parfaite pour le petit déjeuner. A déguster avec un chocolat ou un thé. ', '2012-04-15T03:11:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, d6d67b3b-8cf0-457b-afa8-cee1f1f1040d, 'Facile et très bon, il a eu du succès !!!', '2011-02-16T14:02:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 0239f34b-67a9-40f9-b746-b700962bebd6, 'J''ai essayé d''alléger un peu la recette : 100 g farine + 150 g maïzena mais sans succès... Le gâteau est toujours aussi consistant... les amateurs de banane se sont quand même bien régalés !', '2010-06-04T11:13:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, ca0b2fc7-d88d-49cb-b5fe-962de6cd6a0e, 'Bon goût de bananes et relativement consistent !! Bon', '2010-03-01T20:13:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, df8cbb95-0616-4450-9ce6-273170142d58, 'Vraiment excellent, toute la famille a adoré. A refaire.', '2010-02-11T12:07:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 353a5cf6-b033-438b-81a7-66d119710eb5, 'Je sais pas comment vous vous y êtes pris, mais pour moi il était pas bon du tout... une vraie brique, pas assez de banane, et un trop fort goût de farine... bref il était complètement foiré, et je pense pas le tenter à nouveau...', '2010-02-11T11:17:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, b9939475-b076-4ac2-afbf-7411318c73c5, 'Excellente recette. Ce gâteau à la banane est vraiment très bon et a fait des heureux.', '2010-01-07T19:25:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 7af975d3-0c7f-4333-a8e1-983b0fb9173f, 'Un super gâteau, les amateurs sont nombreux, petit inconvénient, il faut en refaire souvent.merci  ', '2009-11-09T16:45:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 820428eb-6dbc-4d0a-a902-eda0e9f1c547, 'Excellent gâteau. Mes enfants et mon mari qui adorent les bananes se sont régalés.', '2007-05-28T21:13:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 94a20d3d-2111-446c-8ba4-ee1b51a6797a, 'Excellent gâteau, j''y ai ajouté du rhum ambré et 2 cuillères de cannelle, savoureux et moelleux!', '2006-08-27T21:53:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 6d263d6f-3368-4d9c-9f0b-227c661c9fc1, 'Très très très bon gâteau, facile à faire...félicitation!!! J''ai juste ajouté un peu de citron et au-dessus du gâteau des paillettes de chocolats...un délice! 45 minute de cuisson.', '2006-02-13T17:47:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 016c56b7-59fc-44cc-a414-56edc4912b95, 'Très bon, j''y ai rajouté un peu de noix de coco.', '2005-04-05T22:06:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20904, 07fe24df-a5f8-452a-b992-fd07de7e905e, 'Un bon gâteau, très simple à faire, assez moelleux mais ''consistant''! Se conserve bien.', '2003-06-03T17:17:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18319, 089ab16a-e6ba-4fde-b16c-fe683a1469b3, 'J''ai trouvé que cette recette est écoeurante, que les proportions sont trop importantes ( il me reste la moitié de ma pâte!) et de plus je ne trouve pas que cette tarte est un bon goût. ', '2007-04-01T20:23:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18319, dc5de15f-bc98-4b7e-a8fc-02ff8331431a, 'Super :o) Très rapide à faire et se déguste tout aussi rapidement.  Je l''ai fait sans mixeur, mais avec des bananes bien mûres, je m''en suis sortie de manière très honorable.  J''ai rajouté une goutte de rhum pour le goût :) Merci!', '2005-08-11T20:10:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18319, d98d452c-5684-4c69-9831-ee485d1c8b14, 'Bonne recette rres facile à faire. Texture particulière mais très bon.', '2020-03-09T00:07:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18319, 983a5534-1978-4f01-9cec-972997988882, 'Très bonne tarte légère, contrairement à d''autres tartes bananes. J''ai fait une pâte sablée, mis un demi bouchon de rhum un peu moins de sucre, un nappage chocolat. Super bon', '2019-04-03T14:03:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18319, 3729c351-a7f3-4141-beb8-8808d66736db, 'Très bonne tarte à la banane !', '2018-03-18T03:25:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18319, 482cc77f-38cb-4f04-8d05-200782734ff0, 'Excellente et rapide. J''ai préféré une pâte  sablée, servie bien fraîche un vrai délice.', '2017-08-21T18:13:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18319, 97a56e7e-b19f-419c-8bed-fd6719779ea5, 'Super facile à préparer et en peu de temps. Permet d''utiliser les dernières bananes trop mures ! Mes invités ce sont régalés ! Du coup je fais cette recette souvent !', '2016-08-31T20:04:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18319, eb3bbd40-6c73-424d-96cc-2d37178277fc, 'Réalisée pour un repas entre amis.  C''est bon, mais un peu écoeurant. Je ne la referai probablement pas.', '2005-09-20T20:05:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18319, 5bf4b617-2588-41ce-a8df-a068bb0e9a32, 'Rapide et très bonne. A manger rapidement, car la mousse a tendance à noircir.', '2003-12-09T21:39:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18319, 840fab7d-0e48-417f-acea-49cdfd495d28, 'Très bonne et très rapide!!!', '2003-04-11T01:21:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18319, 5ae57f03-d960-41fd-b438-8f2b5c6cdeff, 'Super rapide, délicieuse. Préparée avec une pâte feuilletée Picard (légèrement salée).', '2002-11-11T19:47:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27673, 0724c8fd-e67a-4391-b1be-e8e46a536bd4, 'C''est bon et ça change ! J''ai eu du mal avec l''odeur de la banane chaude, du coup je referai cette recette (c''est sur) mais sans banane !', '2013-04-23T23:45:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27673, 74ba0bec-2df9-4bfc-88ab-5e19b3e79325, 'C''est absolument délicieux. Très simple à réaliser. Je l''ai fait avec du lait de coco et accompagné d''escalopes de veau, mais le porc ou le poulet iront parfaitement aussi. Merci pour cette recette.', '2010-02-24T00:38:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229284, f6de831b-005d-4d5e-bdac-bbe79403d957, 'Voici un dessert léger et délicieux. Je suis végétarienne et voilà bien longtemps que je cherchais des recettes avec du tofu soyeux. Votre dessert est délicieux. Merci', '2013-09-26T18:11:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229284, 96c4925f-4867-4abd-82f2-fcbff10f3cbc, 'Excellent ! Je l''ai fait avec du tofu pas spécialement soyeux, pas de biscuits et du melon (j''ai pris ce que j''avais sous la main). La préparation est très rapide, pour un résultat bluffant ! ', '2014-08-19T22:26:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530418, 6a465d39-c54d-4a47-89ec-1e7b917bbbc0, 'Super bon ! 
J''ai fait fondre le chocolat au micro-ondes et c''était très bon. ', '2021-04-15T12:37:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530418, e9d163a2-6cf9-4cde-a4ba-9b88886553fe, 'Goûter rapide et bon. Ne nécessite pas forcément l’aide d’un adulte remplacer le four ou le grille pain part le micro-onde ou la poêle cela fait la même chose. ', '2021-04-13T05:13:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54636, a318cc5f-0dc5-4529-83ae-0de3b1879684, 'Ce n''est pas vraiment une recette !', '2021-11-13T20:06:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54636, 1fb2b991-861c-452d-8a22-379637fed14d, 'Pas trés bon 
', '2022-02-16T18:05:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54636, e212d1bc-76c3-442d-b71c-c564725090f9, 'Très boCa me rappelle des souvenirs de vacances. L''association banane-confiture de fraise n''est pas très belle, mais tellement bonne!!!', '2007-05-02T22:15:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54636, 293380e0-f69b-4981-b719-5b885e8f68e0, 'C''est très bon et original.', '2019-05-29T05:00:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335225, 8e635fdc-fad5-4539-a27f-2f977e6587f1, 'Gâteau facile  à réaliser. Très moelleux, je recommande !', '2022-11-20T19:40:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335225, 16095811-88e7-4e65-9e49-c873b073e305, 'Gâteau délicieux 😋', '2022-02-20T15:33:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335225, cdbb252f-fe67-4a50-919c-ade53d2c1e47, 'Excellent très bon équilibre entre goût banane et rhum. Peut être ajouter 10 mn de cuisson à 160.', '2020-10-21T18:27:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335225, b6c232b3-07f6-4a00-8799-5868ed25775b, 'Super bon. Pas beaucoup le goût de rhum pour moi qui adore ça. Par contre, je n’avais que 4 bananes et pas de levure. J’ai remplacé par une cuillère à café de bicarbonate alimentaire. Pas eu le temps de monter les blancs en neige. C’était parfait !  Pour ajouter un petit côté croustillant, au lieu de faire beurre/farine pour éviter que le gâteau colle. J’ai fait beurre/sucre. Ma belle maman m’a même demandé la recette ! ', '2018-07-18T13:27:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335225, 0ea86ab1-f300-49aa-9b32-21a085f5833c, 'Le gâteau est très bon et très rapide si on monte pas les blancs en neige.', '2015-03-21T23:49:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59443, a3c175c5-c6ab-4594-bf51-64629068bd56, 'A la place du lait, je mets du jus d''orange bio sans ajout de glaçons puisque la fraicheur du smoothie est obtenue avec ce jus de fruits gardé au réfrigérateur. Excellent !', '2018-09-03T20:02:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59443, 4e764ca6-9896-43ab-95e4-4f89351da8f3, 'J''ai mis de l''ananas à la place des fruits rouges, hyper bon ! Je garde précieusement la recette ! Génial en été ou pour faire consommer des fruits aux enfants. Merci beaucoup pour la recette !', '2015-05-08T20:46:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59443, b2431756-89b5-4c38-9c6d-b6fb1b24fa17, 'Très frais et léger!', '2008-04-05T09:07:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59443, 1dd3d938-4ad8-41ae-80d3-4a9bb225d30c, 'très bon, j’ai remplacé le lait écrémé par du jus d’orange ', '2021-04-18T11:35:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59443, fcfcaf3d-c545-42ef-8a26-c082b7d2eec2, 'Excellente j''ai mis du jus d''orange à la place du lait ! Juste un régal !', '2020-04-10T17:36:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52762, f3537552-e649-4a77-87c0-90070aad4603, 'Excellent et très frais. Dessert très agréable. A refaire absolument !', '2015-06-21T10:34:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52762, 2342b43a-db86-4710-8241-3630f665faae, 'C''est un délice ! Je varie les fruits en fonction du marché, ajoute de l''ananas au jus de fraise à rajouter dans le sirop de sucre, ce qui donne un goût vraiment excellent. Merci pour cette super recette.', '2013-08-03T18:23:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52762, 3ae65c60-ab95-4b96-a449-ddfc9946c87c, 'En fait, je n''ai retenu que la préparation du sirop pour savoir comment refaire un minestrone de fruits croquants avec lequel je m''étais régalée dans un restaurant. Et j''y ai coupé, en tout petits cubes, des pommes, de la poire et de la mangue. J''ai servi avec une corne de gazelle après un couscous. Ce dessert a été très apprécié. Merci! J''essaierai aussi de préparer la recette complète. ', '2011-02-21T16:58:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81661, 9db3ae2d-8d4d-4867-90f0-693abbc5bbe0, 'Pratique et rapide, une façon originale d''utiliser les fruits.', '2012-10-21T14:14:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17858, f341854c-cc28-421d-a6f8-20c13136c63d, 'Délicieux avec une briquette de lait de coco.', '2013-05-09T16:34:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17858, b8f68dc6-a844-483b-b52e-634c5bf6c8a6, 'Ne souhaitant pas ajouter d''accompagnement, j''ai ajouté 1 oignon et doublé la quantité de fruits. J''ai également mis de l''eau à quantité égale avec le concentré de tomate, émietté un bouillon cube de légumes et j''ai laissé mijoter deux heures. C''est bon mais la prochaine fois, je ne mettrai qu''une petite boîte de concentré de tomate car il y en avait trop à mon goût et je mettrai plus de curry car je n''en ai pas vraiment senti le goût.', '2012-01-27T15:39:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17858, cd575553-336f-4d68-ab91-6b53980908b9, 'Plat bon, je m''attendais à plus de sauce et moins de tomate... J''ai rajouté un peu d''eau afin d''éviter que ça attache et cuit plus longtemps.Je l''ai accompagné de pommes de terre sautées.', '2006-08-20T17:10:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17858, 363ca1a5-ef0a-417f-96c9-a41230667e75, 'C''était bon. j''ai ajouté de l''eau pendant la cuisson et du paprika. Cuire plus longtemps à feu très doux.', '2004-10-04T15:29:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17858, f05c08a2-c8d4-4c4e-a3cb-af8aa83fc6bc, 'Très bon si on aime le mariage sucré/salé. Ne pas hésiter à laisser cuire plus longtemps à feu très doux. Le poulet est meilleur bien cuit et la sauce s''imprègne mieux.', '2003-12-28T17:24:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533821, be8c4478-6157-452d-aff2-9ced6d675829, 'Très bon !!! Miaaaaaaaaaaaaaaaaaaam ! >_<', '2025-09-24T14:37:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56513, 94f71998-b652-4f87-921a-744b2abe30cb, 'Facile à réaliser, pour 2 personnes j''ai utilisé une banane, environ 300 g de fruits rouges congelés pour la texture et la fraîcheur et pour aider le tout, j''ai ajouté environ un pouce de lait ! Une fois mixé, j''ai disposé des rondelles de bananes et un peu de muesli, résultat c''était frais, sain et délicieux !', '2014-08-03T20:26:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56513, b3764c09-d321-42ce-b379-850086ac43a0, 'J''ai fait cette recette avec des fraises, un vrai délice ! Surtout pour moi qui ne mange presque jamais de fruits. Merci beaucoup.', '2010-04-19T23:33:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56513, bf365e30-d69f-435a-b4f4-c75330b65e2c, 'Toute la famille a adoré et mon frère et ma soeur m''ont aidée à la préparation. ', '2009-04-23T21:56:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, e081914e-b22f-4d41-a450-af41b03d9f03, 'Excellente recette ! On s''est vraiment régalé ! J''ai juste remplacé le vin blanc par du fromage. Et je ne suis pas trop riz, donc j''ai mis des pommes de terre. J''ai aussi un peu de mal avec les champignons, je les ai remplacés par des oignons supplémentaires et du fromage. Et finalement, j''ai tout mis dans un plat au four car c''était plus simple... Super tartiflette, je recommande !', '2020-11-16T09:31:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 18055831-7603-4991-b060-2c8ed40f2234, 'Tout comme Marie Anne Laure (Avril 2020) j’ai simplifié : tout dans la même casserole. Dans l’ordre : huile d’olive , beurre,  oignon , ail , puis champignons de paris + 1 petite boite de girolles,  riz, vin blanc , bouillon , à la fin parmesan.. le tout 1/2 heure environ. Très bon merci !', '2020-11-04T09:58:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 6fd41d99-af63-44a1-a79f-42895745a26b, 'J''aime tellement cette recette 5/5 ', '2023-04-13T11:29:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 9f2bc400-9701-4695-9a33-95bd7878b4ce, 'Excellent une vrai réussite j’ai rajouté des lardons fumé aux champignons à la poêle et une chips de jambon cru sur le dessus :)', '2021-04-16T00:03:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 741dd833-996a-4cbe-b2b5-ae7a4e24ac62, 'Très simple et très facile à faire, 10/10', '2023-05-15T17:37:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, adf2cb37-3bc2-4e9b-a248-144331064558, 'Super, très bon je note 5/5', '2023-04-09T03:50:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 17d37e09-ed55-4968-a0b8-ba7c57aaccae, 'Excellente recette merci 🙏', '2023-02-19T19:06:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 0f76bfab-9e4b-4f8c-9c4e-e5ddbe899037, 'Toujours aussi bonne Les recettes marmiton ', '2023-02-15T21:11:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, eabf1604-8879-4e37-a257-301876e8f18d, 'Excellent. Fait avec des champ de Paris. Juste au niveau quantité quand on passe de 2 a 4 personnes il ne faut pas doubler la quantité comme indiqué pour les oignons, les échalottes, ça fait trop a mon goût . Juste un(e) demi de plus. Pareil, le vin blanc 30cl est suffisant et non 40. 
Sinon parfait ! Merci . ', '2023-01-28T19:35:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 88a497d6-80b1-42bc-bf32-b1bac2d5c238, 'C’est long mais ça vaut le coup 🫰🏼', '2022-12-20T20:07:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 11f9e29e-fc0e-4672-bd8f-5185d40c6fab, 'Vraiment excellent, une des meilleures recettes. L''ajout tout à la fin d''une poêlée de champignons, échalotes et persil frisé donne un joli parfum. ', '2022-10-20T19:39:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 58d7f470-fb59-4687-8409-737e06ceeab5, 'C’est long mais c’est bon ! Pour moi la meilleur des recettes de risotto aux champignons.', '2021-12-22T12:33:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 06441318-a6a1-413f-adf1-b1c4e4429343, 'Top top top ', '2020-05-26T22:27:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 0c24f6da-dd6b-4139-9084-2ef20e3ac955, 'C''est toujours un succès à la maison... Réalisée avec de bons champignons de Paris de producteur !', '2020-03-31T12:13:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 43978b1a-cdda-4c32-832a-6eefd6160ff7, 'Délicieux, même sans parmesan ni vin blanc mais de la crème liquide.', '2019-01-14T18:18:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, c8e99b4e-5065-47a0-8d24-b69121ac95e4, 'Recette suivie à la lettre : excellent !! Tout le monde a apprécié et s''est resservi.', '2018-03-10T09:20:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, ce34c9ea-318a-48d8-9843-012040d77e12, 'Excellente recette. Je la conseille vivement.', '2018-02-08T13:23:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 9184a6a4-223c-40cb-8b1b-1feb7f4e5fa6, 'Excellente recette. J''ai parsemé des morceaux de jambon cru puis le parmesan sur le risotto.', '2017-11-26T22:00:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 20138f69-1850-442e-bb36-3d1a5a4a4399, 'Un régal !', '2016-09-29T00:10:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 822c1bc0-ab19-4354-9022-aaa5946b7f8b, 'Une recette très facile à faire et délicieuse. Les proportions indiquées sont très généreuses.', '2014-05-11T15:28:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 3a4b671b-2286-4cba-ab5e-3581d9ac4482, 'Pas mal aux cèpes, mais nettement plus savoureux aux truffes.', '2014-03-28T20:34:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, fc0e47dc-7259-484d-96f2-0283a722d371, 'Je trouvais mes risotto plutôt bon mais celui-ci est tout simplement d''un autre monde. L''explication est concise et simple à suivre et pleine de bon sens.  A part l''échalote que je n''avais pas sous la main, le succès a été au rendez-vous, tout le monde a aimé et s''est resservit : résultat j''avais l''impression de ne pas avoir fait assez de riz.  Le déglaçage au vin (sylvaner pour ma part) apporte énormément et surtout de faire le bouillon avec les champignon. Puis la poêlé à la fin hmmmmmm je me le referai pour ma gourmandise.  Attention au temps de préparation, avec mes plaques, cela a prit beaucoup de temps (2h) ', '2014-03-03T22:49:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, edbb43ef-6525-4ca0-a47a-9c6023e2ddac, 'Excellent. 100 % parfait. Merci.', '2023-10-26T08:49:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 86730026-f9ca-4dfc-8ff5-1000056a8dcf, 'Délicieux merci !', '2023-10-23T19:01:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, b282e9f5-abcf-41b2-a086-07219583dfb9, 'Délicieux 
', '2023-10-03T18:12:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 7341c659-4d29-490e-8236-5bb1a61585e1, 'Très bon !!!', '2023-04-07T19:42:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 437740d3-6aba-4d36-abc8-26e5fbfeaf15, 'C''est super ', '2023-04-01T17:07:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312215, 9cf8f7e5-66cf-4d89-aafb-a8e4b90b5893, 'Excellent ! 👌', '2023-03-28T12:33:05+02:00');
