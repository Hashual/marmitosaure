INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, a6cf5a29-b0bf-4d02-9ef5-157ee299e328, 'Goût et texture parfaite. Je rajoute un peu de pâte à tartiner en mode muffin fourré pour encore plus de gourmandise', '2022-02-19T23:23:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 6c58c5fc-2437-4a90-ad6f-32562522ec6e, 'Rien à changer, le résultat était délicieux. A refaire sans hésitation! ', '2022-02-12T09:16:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, e41e8574-1c77-43f2-960a-a702cc6004d2, 'Parfait, ils ont beaucoup plu, pas trop sucré, bien le goût de la banane', '2022-01-11T15:38:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 4bae4ff9-9102-49b6-8067-229cabedbded, 'Recette validée, faite et refaite, par contre ici plutôt 14 mn de cuisson mais en chaleur tournante. Un régal merci pour la recette! ', '2021-08-07T16:58:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, 6ed8abb4-3eb8-4400-9a30-6da65a8b09f4, 'Excellent, chaque fois que je les fait ils sont excellent!!!', '2021-07-18T11:42:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14745, e66e91f5-fa07-4060-b9b9-c58654e00b2a, 'Très très bon ! J''ai rajouté un carré de chocolat avant la cuisson et c’était délicieux… Ils sont validés! ☺️', '2021-07-08T21:09:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70807, a27d89a5-8207-4df3-b5b6-fe5daea2a1fd, 'Très bon et hyper simple à réaliser ! ', '2021-07-22T22:35:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70807, 8ce86c73-a9d6-45c0-9f5a-638eff4e6dde, 'Un vrai délice. Tout le monde a adoré.', '2017-05-24T22:29:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70807, 2cf0b48e-2a1d-4f4a-a5fa-0ce8ccdcbd81, 'Rien à redire, on s''est jeté dessus et il n''en restait plus !', '2010-06-27T00:17:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70807, 8d59adec-6d94-49f2-869d-d3675769fa71, 'Très bon mais on peut mettre moins de sucre et un peu moins de banane car leur goût prédomine.', '2009-09-11T09:13:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70807, d9fcf7ec-835e-4fe2-8dc0-d19a2386ea65, 'Délicieux ! Même avec moins de bananes que le préconise la recette, le goût des 2 fruits est vraiment présent et bien distinct. ', '2009-06-10T18:23:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70807, ef93bc38-409a-46d1-aeb4-b9096afc43ed, 'Très bon et rafraîchissant! J''ai juste mis 100 g de sucre de canne au lieu de 150.  ', '2009-04-19T14:22:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70278, 3e295d68-5ea8-4f25-b0f0-13693f3bd3be, 'Très bon mais la prochaine fois je ne mettrai pas les biscuits à tremper dans la grenadine c''est écoeurant et trop sucré, il faut laisser les biscuits secs et de même que la purée banane fraise a un très bon goût mais la prochaine fois je laisserai les fraises en morceaux... évitez d''ajouter des morceaux de fraise tagada comme moi... cela a tout gâché !!!', '2009-08-05T16:20:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70278, 472550ce-6666-42f7-8b1b-2481bc03b862, 'Moyen. Le sirop de grenadine ne se marie pas du tout avec l''ensemble . Je pense qu''il faudrait humecter les biscuits avec du rhum dilué dans de l''eau ou mieux, avec du champagne. Je n''ai pas non plus aimé les fraises mixées ; la prochaine fois, je les laisserai en petits morceaux. Sinon l''alliance banane/fraise est bien, le gout est agréable. ', '2009-07-14T22:49:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21935, 57330d31-a893-4fde-b747-6fdd182f9859, 'Parfait. La famille en redemande. ', '2012-06-24T21:48:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21935, a201be62-73f6-48aa-b9b7-9f96f34a2f35, 'Très bon et très simple, servi avec du caramel, un DÉLICE !', '2010-03-13T21:04:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21935, bb0db213-e740-4cf3-964f-691fe957e3cb, 'J''ai été très déçue par cette recette. J''ai pourtant suivi à la lettre la recette. La banane ne dégage aucun goût, le tout est sans saveur et plutôt sec. Peut être mes bananes n''étaient pas assez mûres...', '2010-03-07T14:00:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21935, 7af6710e-8b4e-4158-807c-186c15269f61, 'Toute la famille a adoré ! Très bon !', '2009-10-23T20:49:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21935, db89ce96-f149-40cb-a821-9cc58fe778fe, 'Délicieux et inratable! Tous mes amis en sont devenus fous!', '2009-09-18T11:56:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21935, 3445a95f-000a-40fb-87e0-1a6577850689, 'Bravo, j''ai déjà fait deux fois cette recette toute simple et rapide, la première fois je l''ai fait exactement comme Emy, et la deuxième fois, j''ai remplacé la poudre d''amandes par de la noix de coco et j''ai ajouté une cuillère à soupe de cacao. ', '2009-06-05T20:08:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21935, 4d7921f5-48b1-40f3-83de-7a04a129102e, 'Très bonne recette, facile et super pratique pour utiliser des bananes qui restent dans la coupe à fruits.  La prochaine fois je testerai en ajoutant des copeaux de chocolat.', '2009-05-27T20:39:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21935, 24354ca5-1797-43d3-81df-86299faa8e5a, 'Réalisée avec une pâte sablée maison (dont la recette est sur le site), c''est un vrai régal ! Vivement la prochaine !', '2009-05-15T19:58:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21935, 5b88a360-ebb7-4a82-885b-c54268388595, 'Un dessert très facile à réaliser. J''ai remplacé la poudre d''amandes par de la noix de coco râpée et j''ai utilisé les bananes noircies que personne ne voulait manger.', '2009-03-29T14:28:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21935, 6c093d99-3f24-493f-8544-4fd611845b0f, 'Dessert facile à réaliser qui permet de passer des bananes à l''aspect extérieur peu présentables. Nous nous sommes régalés.', '2009-02-02T20:00:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21935, 715a25a5-d2f3-41f0-b067-7107971702a5, 'La recette porte bien son nom, c''est un vrai délice!', '2008-07-24T00:36:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21935, 738a0700-1605-4c46-b6b5-15946cee9132, 'Très bon et très facile....', '2007-06-25T10:22:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21935, a7670a10-4cc1-46de-b89e-e871e9da8534, 'Excellent. J''ai remplacé les amandes en poudre par de la noix de coco râpée et j''ai aussi rajouté une pincée de gousse de vanille en poudre et une cuillère à soupe de rhum. Simple et rapide à faire pour un vrai régal.', '2007-04-25T23:33:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21935, fb1376b5-78ef-4a04-b0e2-76fe50880c0b, 'Simple et vraiment trop bon.', '2006-04-11T21:08:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14785, 47e627d7-76f5-4fd1-a701-b158fc467944, 'Cette recette est un délice, mes enfants me demandent ce gâteau régulièrement... Il est top. Bravo.', '2012-12-01T12:00:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14785, 3fcc6008-953d-46d8-ba46-131d1600a1d2, 'A chaque fois que je fais cette recette pour un grand dîner, c''est mon dessert qui part en premier ! C''est vrai c''est calorique, mais mmmmmhhh que c''est bon !', '2009-08-08T15:51:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14785, 7f4325d1-8da5-4628-8009-90c87cc4f08f, 'J''ai longtemps hésité avant de faire cette recette trop calorique mais quel régal! Tout simplement divin ! J''ai utilisé des biscuits sablés qui s''effritent très bien c''était trop bon!!', '2007-04-10T10:52:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14785, c276b35b-f14e-4670-baaf-1ad9ca89fbdb, 'À refaire mais avec du caramel autre car à l''avis général le lait concentré est beaucoup trop sucré! C''est dommage car on ne sent pas assez le goût des bananes du coup!', '2007-03-20T12:39:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14785, 9047d483-f5a6-43ff-bdec-ed797b8f010d, 'Merveilleux! Cela devrait être interdit de proposer d''aussi bonnes recettes... J''ai dû prendre 2 kilos en 10 minutes!', '2003-09-12T14:54:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14785, db2abeb4-bafc-44e4-886b-62dbf6cc475b, 'je l''ai fait avec des chocos BN tout chocolat, c''est très bon. Si on le fait la veille, c''est meilleur car les bananes et le lait caramélisé sont totalement amalgamés.', '2001-09-19T18:51:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14785, f3e25627-2071-4136-b0e8-c27c39b07040, 'Je n''ai pas encore eu l''occasion de le faire, mais ai déjà goûté cette recette. Elle a fait l''unanimité !', '2001-09-05T11:12:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 25636458-21e1-41dd-8a6e-5541a0ffc9bd, 'Je suis exactement l’étape de A à Z, mais il faut bien plus de 30 mn de cuisson au lieu de 15mn.', '2023-04-24T23:45:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 20b88df5-dddb-4e48-a87f-676c84bcf355, 'Recette parfaite, j’ai mis 2 pommes et 2 bananes et 35 min pour le temps de cuisson !', '2022-10-16T12:11:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, d0e57b1b-946b-4855-b441-7383f2fdf438, 'Bonne recette mais avec 35 minutes de cuisson. Je n’avais pas d’huile de tournesol je l’ai remplacée par de la crème fraîche épaisse, Et il faut 1 sachet de levure. Trop bon !', '2019-02-17T14:13:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, d848d22d-0be4-484e-83b3-0d7b3eaaea67, '15 min de cuisson vraiment pas assez ! Au bout de 30 min la pâte n''est pas cuite ! Par contre le goût est top mais je recommande minimum 45 min de cuisson à 180°C.', '2015-11-11T21:52:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 01d0470f-0a55-4319-9dc2-fa736a2b6c61, 'Effectivement la cuisson est plutôt de 45 mn, j''ai rajouté un peu de rhum, ça va bien avec les bananes. J''ai aussi battu les blancs d''œufs en neige pour encore plus de moelleux. Très bonne recette merci.', '2023-11-10T22:09:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, b3df7a86-972f-4f96-8840-73e669c42306, 'Au top', '2023-04-26T16:27:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 7b4fd38d-9a8c-4b85-8c0a-57db1d04222a, 'Super bon spécialement je recommande cette recette hyper moelleux perso moi j''ai rajouté une petite touche de miel dedans 👌🏽', '2022-02-19T02:49:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 05a5074e-d51c-49a6-9bae-f1a116cad53c, 'Difficile à cuire, mais plutôt bon et se conserve bien.', '2021-02-08T21:13:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 4987d7fe-1610-49e4-8678-aa4bd4954956, 'Le gÄteau n''était pas du tout au bout de 35 Minutes.', '2017-08-22T10:09:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 8645890f-64de-4b8d-8f91-79e7c5108134, 'Super bon mais mangez chaud, encore meilleure et pas cher en plus le top. ', '2015-01-26T15:30:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, df60836e-858d-4126-86cf-6815ba2a4ed8, '45 min de cuisson, super bon ', '2012-04-23T21:20:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 3fde180b-2945-410e-aa2d-9162ba286441, 'Pas mal du tout pour un gâteau de gouter facile à faire et sans prétention. Bien pour des enfants, ou pour un petit creux d’après-midi d''hiver avec une tasse de thé. Bien surveiller la cuisson car ça va vite. J''avais doublé la recette et donc j''ai fait 2 gâteaux dans des moules ronds (j''en ai mis un au congélateur, ça a l''air de facilement se congeler/décongeler) et 6 petits gâteaux individuels ronds. C''était sympa aussi comme format, je recommande.', '2012-01-03T11:16:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 1145c33b-5e9d-4f82-a4e7-7a754542c008, 'miam', '2023-10-09T12:26:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, b9e90343-a98b-4558-83ca-7dc67cb40f71, 'Très bon gâteau petite astuce :si vous utilisez un moule à tarte, mettez les fruits au milieu du gâteau et non aux extrémités pour que le cœur du gâteau soit mou et tendre', '2023-08-02T15:13:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, adc1eaca-2609-43b9-9c78-0d45be0041f3, 'Cuisson 45 minutes 
', '2023-04-22T17:01:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, edbcc0cc-b785-46ce-b769-715f0607e9f7, 'Très facile et très bon ', '2023-01-29T15:08:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, d8910a56-0157-4433-8524-6d06ef93b318, 'Très sympathique au petit déjeuner ce gâteau au yaourt ! Et ludique à faire avec de jeunes enfants. Testé avec de l''extrait de citron à la place du sucre vanillé et un temps de cuisson plus long.', '2020-05-28T10:54:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 555fd2a6-62c9-45e2-a700-5cf7e9a2258e, 'Très bonne recette.
J''ai remplacé le yaourt par crème fraîche et lait et j''ai ajouté du rhum pour le rendre encore plus exotique ! Excellent résultat. ?', '2020-05-19T21:22:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 396b4d32-69dc-403e-9623-ed93aa87d6d5, 'Délicieux et facile à faire.', '2020-03-29T23:18:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 77750ded-5875-424b-ab70-7be9d8af7f8c, 'Très simple et très bonne ! Bon j''ai pas mis assez de sucre mais au moment de déguster j''ai nappé d''une cuillère à café de miel à la vanille c''est extra !! Pour la cuisson j''ai mis 25 min à 180°C et c''est parfait.', '2019-09-06T21:19:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 0683ff32-0bd8-4bf8-940a-9bb9b48e88f9, 'Très moelleux, jai ajouté plus de banane, un régal.', '2019-06-06T03:36:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 33bbb2fd-9d94-4143-87ac-3653a8f06415, 'Je l''ai fait avec des bananes bien mures et une pomme. Je l''ai trouvé un peu trop compact et les goûts pas assez prononcés.', '2018-05-16T02:22:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, f7f4ee78-1cdc-4a28-9bd8-f14a145f98ac, 'Parfait !', '2017-09-04T07:17:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 1304191b-594d-4fca-96c3-4b30b50b61fa, 'Bonne recette ! Je l''ai presque suivie à la lettre, j''ai mis un yaourt a la vanille et ai fais cuire pendant 30 min.', '2017-04-06T18:47:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 890796d0-e8a1-43f2-87aa-245ba6990109, 'Bravo !!', '2017-02-17T12:28:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 14021a56-d62b-4371-afa9-1d506df5cb1e, 'C''est très bon, simple et bon marché... Un petit dessert réconfortant à manger très chaud pour un surplus de moelleux.', '2015-01-13T21:11:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 5794272b-00aa-47da-a312-b621a3e3af89, 'Très bon et moelleux, 15 min de cuisson c''est peu, j''ai mis 1 sachet de levure et un peu de lait car la pâte est trop épaisse, je l''ai fait uniquement avec 3 bananes.', '2014-11-05T15:59:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, c8a86c5d-8d60-4225-96d6-d30f1fe514f4, 'Super recette. N''ayant pas de yaourt nature, j''en ai mis un à la framboise. Top ! ', '2014-07-05T21:15:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, cc8fbf9b-3044-4520-8b8b-592ef758d866, 'Un délice de gâteau ! J''ai mis un yaourt à la vanille (donc pas besoin de sucre vanillé). A la place des pommes j''ai rajouté quelques pépites de chocolat. J''ai garde la recette dans mes favoris!  ', '2013-10-14T18:25:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 9073b760-b6bd-45dd-9b75-05ec5e0fd1f9, 'Un délice, j''ai doublé les quantités. J''ai mis 4 pots de farine de pain que j''avais broyé et deux de farine, ainsi que 3 bananes et pas de pommes. Résultat au rendez-vous et une manière sympa de finir son pain !', '2012-12-10T19:03:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, a913f143-4efc-4d45-a3e9-8f3cb3a92768, 'Nous avons beaucoup aimé cette recette de gâteau au yaourt, je l''ai un peu modifiée selon mon placard ce matin ! Je n''ai mis ni pommes, ni sucre vanillé, et ai remplacé par 3 bananes bien mûres en petits morceaux. 3 bananes ont été bien suffisantes bien que j''ai doublé les proportions 2 yaourts/6 œufs etc...). Super moelleux, délicieux, j''avais fait des petits "muffins" individuels (petits moules silicones un peu cannelés, 1 bonne cuillère à soupe de pâte/moule) qui ont tous disparus entre 7 h ce matin et 17 h ce soir !!! Merci pour la publication de votre recette !', '2012-01-25T17:48:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, c26cc82e-98c9-43a8-b646-9768fba92ad3, 'Très bon rapidement fait le must pour un goûter', '2011-11-13T17:10:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 9533a0bd-af01-499a-b9ff-6e397fb9fd9b, 'Rapide à faire, mais aussi à manger, j''ai ajouté pour le goût des graines de pavot bleu, cela donne du croquant au gâteau, à refaire sans hésiter.', '2011-11-07T15:39:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 1eb35d4e-3f7a-4f24-81b6-4c4e9693a771, 'Recette simple, agréable, je la referais mais avec pomme-poire ', '2010-11-11T21:31:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169361, 25843fe2-64ee-41f5-ba6b-e94ba78ea345, 'Très bon ! Pas trop sucré, bien comme il faut ! Moi j''ai mis un yaourt à la vanille car je n''avais que ça dans le frigo.', '2010-10-31T12:44:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54946, f070ceb4-6b11-4923-9b23-f7fea9d8b1a0, 'Super recette, mais la prochaine fois je fait cuire le rôti 10 minutes avant de le badigeonner. Mon rôti n’était pas entièrement cuit et la sauce cramée...', '2013-03-08T21:40:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54946, 758bb8a3-7321-4e1a-9a2f-3ff350044d30, 'Je l''ai refait avec un peu de lait au fond du plat, accompagné de petites pommes de terre, oignons et raisins qui ont caramélisé avec le miel et le curry. Accompagné d''un petit risotto aux courgettes, c''était excellent !!!', '2013-02-16T22:44:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54946, faae50e6-95e9-420c-b478-3cbf5bdff1a2, 'Rien à redire!', '2009-10-05T17:48:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54946, 2f73bec7-d5d3-4256-b3ca-cfa31871a94c, 'Très bonne recette, moi j''ai ajouté dans la sauce de la cannelle et de la sauce soja, si on aime ces deux ingrédients c''est succulent!', '2009-02-27T20:30:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (54946, 10af3d84-b8f9-4069-a686-e698ecc447b0, 'C''est très bon! l''association miel curry me faisait un peu douter, mais j''adopte... Comme nous ne sommes que deux, j''ai adapté les quantités et le temps de cuisson, à un demi-filet mignon. J''aurais pu couper mon four un peu plus tôt, la sauce a un peu trop bruni à mon goût, mais c''était bien quand même. Je le resservirai, ... à des invités !', '2008-11-07T16:47:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66712, 01ca3858-f26d-4fe4-87aa-70ddb4a745a0, 'Un délice par contre mettre les bananes juste avant de servir sinon elles noircissent. J''ai de justesse eu le temps d''en prendre mais seulement une petite coupelle. A refaire. ', '2014-05-04T20:48:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66712, 53f2a923-ba32-467e-917b-cdf3c22e721b, 'Ne rien changer à la recette qui est un de mes classiques depuis au moins 2 ans et fait toujours des heureux... mais vous pouvez AUSSI y mettre votre note personnelle, ça marche aussi : MERCI BEAUCOUP POUR CETTE RECETTE inratable et très bonne. Pourquoi des notes  4/5 quand c''est dit très bon ou excellent ? L''excellence se paie 5/5 non ?', '2013-12-20T16:08:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66712, 452e124b-f11a-48f1-a8f1-635b0a936c82, 'J''ai remplacé l''orange par des litchis. J''ai trouvé du jus de coco/ananas au rayon apéritif (c''est la base de la pina colada) et j''ai dilué de l''extrait de vanille avec de l''eau. Très bon. A refaire', '2012-01-07T00:08:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66712, 78bb8d79-76ec-4f16-80d3-0740f26a6679, 'Très bon ! A refaire. J''ai remplacé le jus de fruit de coco, pas toujours trouvable, par du lait de coco que j''ai sucré : un délice !', '2008-04-23T15:35:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66712, 28f2e3fc-998c-441c-a50f-d723441677f4, 'J''ai remplacé le sirop de vanille et le jus de noix de coco, inconnus au bataillon, par du sirop de gingembre et du jus multi-fruits; et arrosé avec la totalité du liquide contenu dans le bocal de cerises. Excellente salade de fruits!', '2008-02-29T10:55:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72822, 279770d5-13f6-4a16-8728-46700f61dd25, 'Excellent !', '2020-05-30T18:15:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72822, 6b926814-2469-43cb-998c-259dc07ba645, 'Au top, par contre j''ai rajouté un peu de glace vanille, ça donne un goût... humm... et le sucre à doser en fonction de ce que vous aimez, perso je mets du sucre glace.', '2016-09-06T20:03:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72822, de68a7c0-6a8c-4241-8fe0-1a53dc9261ae, 'Bonne recette. Je mettrais un peu moins de sucre et moins de banane la prochaine fois. Car trop sucré et fort en banane !', '2016-08-28T20:21:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72822, 02bcfeab-13bb-4903-baa3-5a1e5f0c5c6d, 'Super !', '2016-08-13T19:25:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72822, b1ee1455-d460-45c2-a943-da10e584de05, 'Moi j''ai mis 2 sachets de sucre vanillé à la place du sucre et 6 glaçons ... c''est très bon !', '2015-11-09T16:43:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72822, 706f0680-dd2e-49f4-bbe3-860697368a9b, 'Très bon ! J''ai suivi les commentaires, 30gr de sucre, 10 glaçons. Parfait, les enfants adorent. Je n''ai pas mis la chantilly ni le chocolat je le ferai surement un jour pour un goûter de fête.', '2015-07-30T17:01:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72822, 2d5cdd34-380c-4a0a-8c30-8ec1ca19622d, 'Hmmm excellent !', '2015-03-15T18:30:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72822, 0ee37685-1098-4bfd-be87-0d3c4539283b, 'Très bien avec un yaourt à la vanille et 30g de sucre seulement puis 10 glaçons pour un effet frappé. ', '2012-03-25T13:23:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72822, e80fcd4f-32fb-41b8-9099-c6569fa69192, 'Recette super simple à faire et réussie à tous les coups !', '2012-02-13T16:41:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72822, 9690795a-001d-4557-a9da-26af77e62314, 'Rapide et vraiment trop bon. Par contre, j''ai mis trois bananes et un sachet de sucre vanillé. ', '2011-12-20T16:54:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72822, 67ff701b-7794-44d6-9d4e-1e54423879a7, 'Parfait quand on n''a pas de glace vanille !', '2011-01-09T13:49:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72822, 3ec5abda-5491-4818-961a-30f945d5977e, 'Très très bon ! Je le fais en général avec de la glace à la vanille et je n''en avais plus :( Mais j''ai trouvé cette recette vraiment très bonne, j''ai juste mis un fromage blanc à la vanille à la place du yaourt car je n''en avais pas des natures et voilà ! Mes enfants ont adoré et moi avec ;)', '2010-08-13T15:55:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169440, e7672133-b8da-4d51-9a18-5d58d2f44dba, 'Recette faite avec des framboises surgelées, résultat parfait. On sent bien toutes les saveurs qui se marient très bien ensemble. A refaire.', '2013-01-12T12:20:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169440, 19f945e7-28b1-4448-966e-dc8a23833618, 'Recette impressionnante mais facile à réaliser avec le bon matériel. Un gâteau très joli et tout aussi bon. NB: j''ai retiré le cœur de banane.', '2010-10-18T18:01:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (314894, 7173750e-8abe-4ff1-a164-4873e756653c, 'Fait la veille mis au congélateur dans les verrines. C''était parfait ! Tout le monde a adoré ! ', '2021-04-07T19:17:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, a43ae30a-3927-49ab-b0d9-6316bbb24d69, 'Excellent et original ! Il faut juste rajouter une échalote.', '2016-09-02T20:30:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, f1deec0b-7d25-4783-9ae2-3cab7500ff12, 'Encore plus facile... Une briquette de lait de coco, 2 cuillères de curry, un reste de poulet et de la banane...et hop tout réchauffer. Pour soir de grande fainéantise !', '2016-02-22T21:36:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, 44ccdae0-4de9-4b66-baba-6aba6abeb6ef, 'Une tuerie appréciée par toute la famille ', '2016-01-04T21:12:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, 0b0424ae-532d-4895-ad7f-6469a8f971c3, 'Excellent. Fait avec 2 bananes plantain elles se tiennent très bien à la cuisson, 25 cl de crème fraiche Bridelice à 18%. 1 brique de lait de coco au fur et à mesure de la cuisson. Résultat : grands et petits ont été séduits et oh agréable surprise, la banane et le lait de coco ont simplement adouci le curry, mais ils n''étaient pas dominants, un parfait équilibre des saveurs.', '2015-01-10T23:07:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, 036e5d49-ded8-4a45-a0dd-2a68987d6420, 'Plutôt bon, mais la prochaine fois, je mettrai plus de bananes, le goût ne me paraissait pas assez présent. De même, 2 filets de poulet pour 3 personnes, ça me paraît un peu léger...', '2014-11-03T00:45:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, fbe764e1-8a25-4b67-97d5-d092f7ef7172, 'Un plat incroyable. Testé avec et sans champignon : trop bon. Par contre, je mets encore plus de curry avant le crème. J''ai aussi ajouter une cuillère de sauce huitre pour avoir le poulet plus fondant et une de sauce soja. À refaire très vite avec du riz !', '2012-04-26T17:03:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, d3df9b6b-f32d-4fb7-ba27-4a297515168e, 'Bon mais quand même assez spécial. Le goût de la banane garde le dessus malgré le pot quasi entier de curry et la grande quantité de sel et de poivre. Je n''ai pas utilisé tout le lait préconisé je trouvais que 10 cl suffisaient. La sauce avait une bonne consistance (ni trop liquide, ni trop épaisse).', '2011-07-27T22:06:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, 3bd8160b-2f91-42d3-afe9-9e07896e29d7, 'Simple, rapide et excellent.', '2011-06-13T02:09:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, ce3cbebb-b398-49d6-b499-2a5e48efcc4e, 'Très très bon!!! Rien à redire!', '2011-03-19T18:35:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, 5c6c9de3-4404-4df9-a6ad-b939ef7309e9, 'Vraiment très bon et très facile à réaliser même pour une novice comme moi', '2011-03-11T11:35:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, 29b0a3e9-6396-454a-ab16-b0b4af40c0be, 'Très bonne recette ! J''ai simplement remplacé les champignons par des oignons et la crème fraîche par le lait de coco , comme certains l''avaient suggéré. A faire et à refaire !', '2011-01-16T12:20:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, fa28fbb8-945c-4159-a8d2-9e8a8d6160f8, 'Excellent, j''ai préparé cette recette ce midi et tout le monde a aimé ! A refaire très vite .', '2010-05-02T14:04:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, 37a7cacf-6a70-4eeb-965c-5d9293990133, 'Excellent. J''ai remplacé la crème par du lait de coco pour faire plus exotique !!! Et, effectivement, contrairement à d''autres fruits, la banane ne donne pas un goût sucré trop prononcé.', '2009-05-22T22:58:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, 654e911b-6920-4555-af2e-5aef0e285f5a, 'Vraiment pas mal! N''étant pas un fan des bananes dans un plat, je trouve ce plat super super bon !!  J''ai mis du lait de coco a la place du lait et de la pâte de curry rouge (un peu trop, prochaine fois je mettrai moins) Rien a dire c''est recette donne une touche d''exotisme incroyable. Je recommande.', '2009-02-04T15:56:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, de964df8-84fb-4d5f-a4e2-e8850903f973, 'J''ai vraiment adoré, mon mari aussi bien qu''il était au départ réticent vis à vis des bananes! Je n''avais pas de champignons, donc j''ai fait sans, et ça allait aussi. Mais j''essayerai avec la prochaine fois. Et au lieu du lait, j''ai mis du lait de coco et effectivement, le côté exotisme était encore plus révélé. A refaire...', '2008-03-25T14:46:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, a4545436-1c73-4374-8d23-582547541aef, 'J''ai remplacé le lait par du lait de coco, ça ajoute encore un peu d''exotisme et c''est très bon! ;o)', '2007-12-04T17:15:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, 1a844d81-4ef1-424f-a55a-9566e52cb382, 'Effectivement une bonne recette pour les amateurs d''exotisme, rien à redire, tout le monde s''est régalé.', '2007-11-18T19:36:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, e328c926-cca6-4aaf-86b2-d907e35bc8ec, 'Délicieux!!! Saveur douce, un peu sucrée, mais pas trop. Je l''ai servi avec du riz parfumé qui se marie très bien avec.', '2007-03-25T22:33:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, be3a922e-d848-4291-a3aa-691e674dc412, 'Repas à peine fini. Nous n''en avons fait qu''une bouchée! Aussi bien les adultes que les petits qui ont adoré les morceaux de banane! Bref, à faire et à refaire, une simplissime recette qui ravit petits et grands.', '2006-11-18T21:37:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, 8e5517c7-af0e-4575-838a-96051ee386f5, 'Délicieux!! J''ai adoré, par contre peut-être que 2 bananes suffisent, car le goût prend vite le dessus. Mais plat exotique à essayer!!! ', '2006-10-19T12:30:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, 02aaaa06-3da2-4f5a-b9ef-2d4948a5135b, 'Bon, moi j''ai trouvé ça plutôt bon, c''est très doux, par contre je l''ai aussi servi à mon mari et mon cousin qui l''ont mangé mais qui ont, semble-t-il, trouvé ça plus bizarre qu''autre chose. Pas trop de succès donc.. A réserver peut-être aux fans du sucré-salé et de la banane.', '2006-04-24T12:58:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, 575b4e69-aeb7-4586-936b-244786fa291e, 'Très bon! J''avais peur que le goût de la banane ne soit trop présent....et bien non! C''est juste comme il faut. Ne pas hésiter à rajouter le lait au cour de la cuisson, car la sauce épaissit beaucoup.', '2006-02-08T17:19:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, fcde92a4-907f-4622-a5a2-fc4a7c5475e5, 'Excellent. Mes invites m''ont vraiment complimenté. J''ai mis 2 bananes pour six personnes mais la prochaine fois j''en mettrai plus. La banane réhausse vraiment le goût...à essayer sans oublier la banane :)', '2005-09-29T19:21:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, 412d87c2-da01-4d05-8455-d36402308978, 'C''est tout simplement exquis! En fait, la banane n''apporte pas vraiment de note sucrée (moins que la pomme ou l''ananas par exemple). Elle donne plutôt un parfum intense, qui se marie merveilleusement bien avec le curry et la crème. Je pense donc que ce plat peut être servi sans problème à des réfractaires au sucré-salé (à condition de ne pas leur dire ce qu''il y a dedans!).  Par contre, j''ai aussi remplacé les champignons par des oignons. On peut également couper la crème avec du lait de coco pour une saveur exotique plus prononcée. Recette qui va devenir culte chez moi, tant elle est goûteuse et simple à préparer.', '2005-04-19T13:57:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35472, 41e65e82-0941-448b-9fea-3b5ffd5d3449, 'Vraiment très bon quand on aime le sucré-salé! N''ayant pas de champignons, je les ai remplacé par des oignons, du coup ce n''est pas la recette originale, mais cet échange fut heureux!', '2005-03-14T10:55:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13762, 4c29c7b9-aa53-49f6-b1ef-14dd352a35ce, 'Sans fioriture c''est mieux, c''est à dire sans eau gazeuze ni banane, pêche etc... Une vraie sangria quoi, juste vin, sucre de canne, cointreau et oranges/citron !', '2018-06-02T08:29:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13762, 02113641-c528-4fd6-a5e6-800152bdf49d, 'Oui, très très bonne. Mais "dangereuse" :-):-):-)', '2015-03-15T01:23:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13762, 9d970fa3-2f36-41a6-bbab-413afca5cb37, 'Pas bon du tout', '2015-03-15T00:51:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13762, e5daabd4-1c5a-4735-9d54-93b4e6a7b7c1, 'Bonne', '2012-08-14T20:37:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13762, ed9cca78-5b10-47ff-a5d0-32b18a6f73ab, 'Le top, c''est de rajouter 6 prises de poivre du moulin.', '2002-09-12T10:34:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13762, fa3ca451-eb5b-4854-bdba-fd0725967dd8, 'Pour répondre à julien Viannais à propos du Cramoisey rosé, c''est un vin qui ne se trouve plus ou peu, il ressemble au vin appelé ''Pelure d''oignons'' et il s''agit d''un vin gris plutôt que rosé. Pour ma part, je remplace le Cramoisey rosé par du Sidi Brahim Rosé. En tout état de cause, il faut un vin corsé.', '2001-08-25T12:23:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13762, 1e301f06-55ad-4fed-9d05-a997fd4fa949, 'Enfin une recette de sangria où les quantités de chaque ingrédient sont mentionnées !!  Question : C''est quoi du cramoisey rosé ?', '2001-05-30T21:31:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18366, a194a9e5-94d8-4d49-a7f8-2cfb473f1acb, 'Très bonne en effet 35mn avec un four au gaz cela et parfait ', '2023-01-21T19:25:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18366, cb539014-d490-4edd-9b0f-7a5790211e67, '30cl de crème suffisent et le sucre roux est bon aussi.  ', '2012-09-18T14:03:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18366, 4c5a00c8-daf7-4bc6-93ed-714abe391a18, 'Recette facile à réaliser et très bonne.  J''ai utilisé de la pâte feuilletée comme indiqué dans le texte de la recette (au lieu de la pâte brisée).  Pour mon 2ème essai, j''ai suivi les conseils de Marmitonautes et fait fondre préalablement le chocolat (totalement). Le résultat est meilleur !', '2012-01-15T00:49:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18366, f869ffe2-53c9-4757-b670-375015863aa1, 'Recette très rapide à réaliser, idéale pour un repas entre amis express, toutefois il est préférable de faire fondre le choco pralin au préalable car sinon on a l''impression de manger une tarte à la banane uniquement ( et c''est dommage le choco pralin c''est tellement bon!!). Petit conseil: ne pas servir froide. ', '2009-05-02T14:16:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18366, f3d55154-cc50-4aff-9e64-2a8ef3f90837, 'Comme suggéré, j''ai mis du pralin fondu dans un peu de crème liquide et c''était parfait ! J''avais fait des tartelettes individuelles, on a tout mangé ! En plus c''est rapide à faire !', '2009-04-18T17:27:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18366, c777be98-307a-442d-9854-2234d728e195, 'Mmmh! Moi j''aime bien le chocolat mi-croquant mi-fondant justement. Cette tarte a bien plu : j''ai pris pâte feuilletée comme dans le corps de la recette.', '2008-08-19T14:16:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18366, 0bbfb361-ec21-4ab2-8aac-8aee33079e82, 'Gâteau très bon qui change du chocolat traditionnel.', '2007-06-28T00:00:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18366, 02219bce-9ef7-431d-b6d8-9f086eb2deae, 'Très bonne tarte, facile à faire. Seul problème : le chocolat n''a pas fondu... La prochaine fois, je le ferai fondre avant.', '2006-11-21T23:00:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18366, c2b25339-df59-4e0e-aca3-3643f0ed4ee7, 'Très bon, mais 30 cl de crème suffisent, ainsi que 70g de sucre.', '2003-04-29T09:58:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18366, ec408ab2-a63e-4d47-8a53-2a83f55e67db, 'J''ai amélioré ma recette et finalement, je coupe des lamelles de chocolat prâlin, ainsi, il est mieux fondu! On peut même faire une couche banane, lamelles de pralin, banane et quelques lamelles sur le dessus!  Lyam.', '2002-11-12T20:47:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18366, 06dfd06c-98c7-46eb-9b37-aabf0efe1803, 'Très bon, mais le chocolat au pralin n''a pas bien fondu.', '2002-10-17T14:27:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59066, 76fa6b6d-5e46-43d0-b511-8461a0aae3bd, 'Sympa, mais ça fait trop de garniture : 3 pommes et 2 bananes devraient être ok. Aussi, 210° ça fait trop chaud : les pommes n''étaient pas cuites mais le dessus brûlé. Je referais moins chaud et plus longtemps.', '2013-04-07T23:14:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66065, f95726fd-5de6-4f52-b4be-a3d5801c92e5, 'c''est facile a faire et c''est tres bon je vous le conseille ????', '2021-01-18T23:26:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66065, 618ae4f7-e948-4481-95f9-341471bc6466, 'Ça a le mérite de faire manger des fruits.', '2018-05-20T13:17:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66065, 7667e33a-c327-429e-85aa-837ea15daae5, 'Bon mais sans plus', '2017-04-21T00:49:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66065, d9fc3575-1e6a-4812-a105-3d044bba0cae, 'Au top tout le monde à adoré  ', '2017-04-20T20:15:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66065, 3d8b0588-a827-47c4-9457-e121c3342335, 'Aussi facile à faire que bon ! Parfait pour accompagner le crousti-choco-coco et permet de faire du bien à l''estomac avant de le déguster... Le reste du mélange à déguster au petit déjeuner le lendemain c''est succulent...  ', '2017-04-11T22:49:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66065, 0d159b84-e135-4deb-9bca-70832deb4519, 'Sain, simple, rapide et délicieux.', '2017-04-04T10:32:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66065, 8acced0b-4544-4040-9a9c-ffd697470cff, 'Simple délicieux et healthy ! Réalisées avec mon grand de 4 ans qui était fier de dire que c''était lui qui les avait faites ! ', '2017-04-03T23:28:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66065, ec12a1e5-ac9a-47dd-aaad-4649eb92b489, 'Très facile à faire, délicieux, et, ce qui ne gâche rien, ni gras ni trop sucré. Je suis grande fan ! Par contre, il y avait trop de melange par rapport aux peaux de bananes, j''ai rempli des ramequins. Merci pour cette super recette !', '2017-04-02T16:03:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66065, cdb0f516-c814-4d64-90be-321861ef657d, 'Très bonne recette! J''ai ajouté du jus de citron, du sucre et un peu de crème fraîche. C''était délicieux! ', '2017-04-02T00:05:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66065, 659d468e-eb40-460e-a0b5-d09b54cb8f36, 'Super recette facile et rapide à faire je la recommande.', '2017-04-01T21:27:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66065, 1d842970-dd48-4e62-bcd5-96a4f9884910, 'Bon', '2017-04-01T13:38:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66065, aa07abd8-dbcc-4d4c-997f-50259025dbd2, 'Il faut moins de kiwis. Trop pour remplir 4 demi-bananes !! ', '2017-04-01T13:27:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66065, 556e21a6-6b91-441d-ba06-108302ef11c3, 'Trop bon', '2017-04-01T10:33:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66065, 88f402d1-da6d-4291-9d78-7d9565833b82, 'Trop chouette comme dessert. Ça permet de faire manger des fruits autrement, à refaire !', '2013-03-10T18:48:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66065, db78d1d5-7a09-4fa0-9d49-af97d83c31b0, 'Simple et délicieux !', '2011-09-03T21:11:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, afd5e827-fd33-4e87-b018-7816a4733061, 'J''ai essayé la recette mais avec la moule c''est un peu bizarre ', '2022-01-22T11:11:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 759f321b-b0fb-49f9-88c7-4675e79ae820, 'Super gâteau, très facile à réaliser. Apprécié de tous. Un petit conseil : prenez des bananes vraiment bien mûres même si elles sont noircies. C’est bien meilleur et plus facile à écraser. Perso je remplace 50 g parmi la totalité de la farine par 50 g de farine de châtaigne. Ça donne un petit goût sympa pour ceux qui aiment. Voilà. Merci pour cette recette.', '2018-11-24T09:31:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, c5051241-6db4-44f8-872b-807411b1fbd5, 'Gros succès ! J''ai réduit le sucre et le beurre par goût personnel mais recette savoureuse et très facile à réaliser. Je garde !', '2020-05-06T21:55:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 5c89e881-3b2c-4a05-baa6-9866fab91991, 'J ai diminué le sucre mais rajout de la poudre d amande avec les bananes et jus de citron très bon et surtout moeilleux', '2020-05-04T14:57:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 1afdc493-eaac-4023-b9bc-d9d997e6b4ac, 'Excellent, je viens de faire ce gâteau avec seulement 2 bananes', '2020-03-29T19:17:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 51bbd146-eaae-4afe-8bb9-3ab2b1da5ea6, 'J''adore cette recette, merci beaucoup Marmiton.', '2019-11-30T04:23:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 69a7e7dd-ae12-418a-a68d-3b9819de9dc1, 'Super recette facile à faire.', '2019-08-03T13:50:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 9a4526db-0161-48cf-b8ee-dfccb8bee49e, 'MERCI pour la recette c''est une tuerie. Trop bon, délicieux. Bonne journée.', '2016-07-16T17:49:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, e58b6eff-4d1f-4a3b-904f-2f564a9dfe9d, 'Toujours réussi.', '2015-06-01T21:02:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 90a69dd6-56d8-4326-a9e8-b250d2338303, 'Trop bon, à refaire, très moelleux avec un filet de chocolat par dessus tout le monde l''a aimé. ', '2014-11-14T22:09:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, c8d4ccb3-df3c-4d53-bf99-d7508b648848, 'Fait avec 120g de cassonade, une pincée de cannelle, 3 cuillères de rhum, une banane pour la rosace et 3 à l''intérieur... Un régal à peine tiédi à la sortie du four.  ', '2014-07-21T21:26:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 9e086823-4351-4e0f-9eea-1a3482a38b86, 'Très facile à faire ! Et très bon en plus ! L''idéal pour ne pas laisser abîmer les bananes qu''on a en trop.', '2013-12-29T17:40:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 17188135-e15c-4ce9-8545-50ecd3b32c70, 'Toute la famille a apprécié le gâteau léger et simple d''Anaïs, et en redemande. J''ai suivi la recette à la lettre à deux différences près. j''ai considéré 02 cuillères à soupe de Rhum et aromatisé avec de la cannelle. J''ai passé la préparation au mixer et pris 04 bananes pour la rosace. Le résultat est un gâteau léger et moelleux. J''ai également essayé une variante en remplaçant les bananes en rosace par des raisins secs, le gâteau est aussi excellent. ', '2013-10-07T02:34:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 9d3e4c6f-cc33-4228-b837-ea3dba88c55a, 'Délicieux gâteau. Tout le monde a aimé. J''ai mis une cuillère à café de rhum en plus. Facile à faire, il est idéal pour les bananes un peu mûres. A refaire sans hésitation.', '2013-10-06T14:53:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 36c2c815-9d59-4942-b7f8-d60734456f89, 'Super Gâteau ! Facile à faire et très bon. Tout le monde aime... avec une boisson chaude (thé, café) ou avec une glace vanille, ça passe très bien !', '2013-08-04T02:26:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 3d7914d5-b2d9-4382-9b68-8cc2859ea0d5, 'J''ai suivi la recette, c''est hyper simple à faire ! Par contre, on ne sent pas du tout le rhum ! Ce gâteau est hyper bon !', '2012-10-29T18:12:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, e6681ce1-4b3f-4ed7-a92b-b32d7326cae3, 'Excellent pour finir des bananes trop mûres et faisable par ma fille de 6 ans sans aucune aide de ma part (sauf pour fondre le beurre).', '2011-08-14T00:26:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 7af07358-4e6f-43a2-941c-6f0ca232a515, 'Très simple, très beau et très bon ! La prochaine fois, je le laisserai cuire 5 min de plus mais à part ça, c''est nickel !', '2011-02-19T14:14:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, b7724ab0-20e4-45d5-b54a-eb53b19868ee, 'Mon mari a adoré, surtout fait avec des bananes du jardin, les fruits sont mûrs à souhait. Merci pour cette excellente recette, que je refais aujourd''hui pour la seconde fois.', '2010-11-27T01:41:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, cbc314c8-5779-467f-92ef-144ef46182a0, 'C''était vraiment très bon et mon mari a adoré, il en redemande !', '2010-08-31T16:02:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 53a3747d-5455-46ba-9c60-18d61b70695e, 'Je faisais mes fonds de placard et j''avais besoin de trouver une recette de gâteau à la banane. Celle-ci est géniale et mon cobaye de mari a adoré.   J''ai changé les quantités et les proportions, faute de les avoir!!! 3 œufs, 117 g de beurre, 5 bananes... et c''était extra!!!', '2010-07-14T12:48:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 45d184b3-8cd1-4781-a769-7e3eb1d3531d, 'Peut être plus de bananes entières au fond du plat...?', '2010-05-18T16:19:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, d7c9a768-ef6b-47f2-8837-87ecb1c30c46, 'J''ai suivi la recette à la lettre, un véritable régal !!!! Les bananes ont un peu caramélisé... Hum ! Les enfants ont adoré ! Merci.', '2009-11-20T15:04:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 82361478-5030-4e39-bb21-39589188ffe5, 'Très facile et très bon. A refaire sans problème !', '2009-10-24T15:35:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, b5467cfc-98da-45d4-b66e-fc5f92521b60, 'Très bon ! Je l''ai fait sans mettre de rhum. Les enfants et le mari ont beaucoup aimé ! Je le referais sans problème, surtout avec des bananes très mûres.', '2009-08-29T20:33:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, bc53699f-0e38-47b2-89bd-8261289d9612, 'Vraiment délicieux ! J''ai tout suivi à la lettre et c''est parfait ! En plus il est simple à réaliser avec mon fils de 2ans et demi ! Merci', '2009-04-24T01:02:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, f43403e5-7a56-4427-a91d-1aff48b630bd, 'Salut, j''ai suivi la recette à la lettre et ma petite famille n''a pas du tout aime; désolée.', '2009-04-05T16:20:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 9450d7f8-c648-452b-b207-ca81e8d73f98, 'Ce gâteau est tout simplement excellent! Très pratique pour utiliser des bananes trop mûres. Par contre,je n''ai mis que 90g de sucre et c''est suffisant. Ma fille a adoré. Merci.', '2009-03-10T21:08:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 4f4c198b-a0c4-44d1-a691-5df18d4736c4, 'Recette suivie à la lettre, et c''est parfait! ', '2009-03-10T20:10:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, a1da4b3a-9ebf-4be4-a7c0-7aacb3200f54, 'Excellent, appliqué à la lettre.', '2009-02-15T15:20:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 8166aea9-067b-4e75-ba09-f0eba901b588, 'Excellent! par contre , je n''ai mis que 80g de sucre qui suffisent largement avec des bananes bien mûres(on pourrait ne mettre que 60g d''ailleurs)et à peine une demi c à soupe de rhum ! moelleux à souhait, un régal!', '2009-02-14T21:38:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 492a7d36-f440-4b5d-b42c-a57a4eef3b95, 'Absolument délicieux!! J''ai ajouté de la cannelle et j''ai mis du malibu coco à la place du rhum...léger et tendre, une réussite ! Merci.', '2008-11-06T16:58:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57785, 5b0435a7-137c-4a59-ae60-2801d6fd03f3, 'Simple et léger effectivement, très apprécié par la famille. Je n''ai mis que 4 (grosses) bananes et c''était très bon. Par contre on voyait très peu la rosace mais la présentation était correcte. Merci pour cette recette.', '2008-04-24T19:09:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38874, 192a21fb-7575-4805-9af4-f0fae33afd1a, 'Je pense que vous pouvez supprimer la boite de conserve et faire un caramel (plus rapide). 360 g de sucre, 250 g de beurre et une pincée de sel, cuire à couleur. ', '2017-03-16T12:31:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38874, cbab60cd-9261-4dc2-9c23-880d7edd002c, 'Faire cuire une boîte de conserve fermée pendant 3h est assez spécial. Mais c''est très bon, très beau, tout le monde a aimé (j''ai remplacé le café par du cacao en poudre). ', '2007-01-26T18:49:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 2a6c27ac-8d72-4fcb-9c84-da6d21a8b0a5, 'C''est parfait, je conseille de doubler la quantité de saucisse crue mais tiède ', '2023-02-19T11:57:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 0a635551-32b8-4605-9be5-9a6a7e7e8919, 'Je pensais cette recette ringarde, mais après l''insistance de mon homme pour lui cuisiner, je me suis surprise à apprécier ce plat.', '2022-12-19T23:26:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 1e3787a5-a3e7-4337-a08b-a89abbe7ce56, 'De très loin la meilleure recette que l’on puisse trouver sur ce site! Maim ! Je me suis régalé !', '2021-04-11T13:20:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, dc28a23f-a4bd-460d-bf9d-f6d048ad81d8, 'C''est génial je ne pensais pas tomber sur cette recette sur marmiton!!!!! Merci beaucoup je trouve l''idée super sympa :):)', '2021-03-17T21:54:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 817f1e91-ad30-44fd-a471-8a279d95ae19, 'Aussi bonne que les madeleines de Proust. Merci.', '2014-12-16T19:22:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 76b75c5d-b3db-4e90-a64c-4b7d16527501, 'J''ai essayé, j''ai trouvé ça fade. Pour y remédier j''ai ajouté un peu de fumet de poisson ainsi que du caramel. ?', '2019-10-07T20:42:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 98b1cbc1-2995-47d6-bfbf-9f9e1f411321, 'Miam miam quel plaisir de retomber ainsi en enfance !!!! Merci pour cette recette "culte" ...', '2016-07-31T01:10:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 90792cb2-ad69-43fd-965d-92a577020f14, 'De la bombe!!', '2016-07-12T20:33:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 2d6368a7-3b72-4873-9514-16f96b1d0b1b, 'Excellent !!! Rien à changer !!!!', '2014-10-14T21:05:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 74c88dd3-6ec1-435b-991e-ddf730397265, 'Un vrai régal et que de bonne sensation après ce délicieux gloubiboulga ! TOUT SIMPLEMENT GÉNIAL !! élu meilleure recette de France selon Marmiton !', '2014-04-06T19:43:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 74437897-29b0-4020-aba2-a68cc4d9cb24, 'Que c''est bon !', '2012-07-03T16:52:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 34d4763c-b941-4ae4-9b53-4d5ff2101732, 'Genius !', '2012-05-30T22:41:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 0c7c4e67-5c9e-448b-8181-03570b3fb7a7, 'A proposer à Master Chef la prochaine saison ! Bravo pour cette petite merveille ! ', '2012-02-09T00:21:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 3d8bf3eb-3377-4bea-97b0-faa74e760463, 'Mon homme a qualifié ainsi le mix de légumes cuisinés avec amour dimanche dernier ! Je lui ai promis de trouver LA recette et de la lui faire ! Rien que pour voir sa tête ! Et le "5/5", c''est pour les souvenirs de cette époque !', '2011-03-23T13:35:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 2cb881e4-2625-4e36-8995-4f411bfc4106, 'Merci beaucoup, c''est un vrai régal.', '2010-09-26T13:55:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 0a3ae527-9f2c-4aaf-befa-6fde6aefcd5b, 'Merveilleux souvenirs... merci !!', '2009-08-20T12:57:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 53318bf2-a942-4751-b533-363d55f90c61, 'Excellent, un régal, entre amis, pour un repas de mariage, toutes les occasions sont bonnes. MERCI !!!!!', '2009-05-16T16:36:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, a90ac483-d641-4ffb-b202-dd9c2f1104ec, 'Quel talent!', '2009-05-11T13:55:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 7b37e16b-474e-481f-ba1f-b34a4ce92463, 'Moi, en ce jour, je rajoute des anchois, c''est d''actualité...', '2009-04-02T02:05:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, e1b15e3e-9a8d-4aa5-8b51-10d67242e2d0, 'A faire et refaire tant que l''on peut et sans réserve, j''ai beaucoup apprécié. Par contre j''ai rajouté un petit poisson glissé dans le plat. C''était délicieux et excellent pour les muscles faciaux.  ', '2009-04-01T19:32:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, b8ead095-f94f-474a-add2-54ea9e0e85cc, 'Beau poisson d''avril!! En attendant c''est dommage je n''ai pas de confiture de fraises, ni de moutarde , ni de saucisses, alors je ne peux pas essayer!!', '2009-04-01T16:12:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 02c9b546-19dc-4ba2-9778-e51277c3f00a, 'Cette fabuleuse recette  exclusive de Marmiton est enfin illustrée, grâce à l''ingéniosité de Nanie! ', '2009-02-02T14:31:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 73c2c130-e59a-424d-a126-ed949d17b5bf, 'Comment ai-je pu être privée tant de temps de cette fabuleuse recette ? Je la refais enfin, un moment historique !!! Merci de rafraîchir notre mémoire et de maintenir le patrimoine gastronomique des années 70/80. Cela fera tellement plaisir à mes enfants devenus adultes. Je vais bien sûr en faire la photo. Un grand Merci.', '2008-10-27T01:51:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, d51ebe4f-d3a8-45f2-9266-9f07fb3f5a6e, 'Dommage qu''on n''ait pas droit à une petite photo... :))', '2008-03-18T23:15:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 632a50cb-087b-4639-bd37-a91525a4b002, 'Hummmmmmmmmmm ! Je vais peut être pas mettre la moutarde et les saucisses mais quel goût d''enfance....', '2008-02-23T13:14:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, af669569-7703-4855-a5d0-373ab6d611ca, 'Moi, je rajoute un peu de tabasco.', '2007-05-13T21:11:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 21b2d3bb-e047-40e3-9bec-58585ea7ab8e, 'Genial! J''avais oublié la recette! Ouf, si Casimir passe à l''improviste...!', '2005-04-21T18:45:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 59020cf9-843a-403d-bd8b-ca02e5f6e533, 'Ah ca y est, enfin je l''ai, cette recette!!! Je vais transformer tout le monde en casimir tellement je la fais souvent... (rires)', '2005-03-18T18:00:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14504, 46355d86-2517-40fb-8a30-b19c360b727b, 'Une recette qu''Hyppolite a beaucoup apprécié!', '2003-08-21T22:09:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 1de3c73e-5a56-4fa1-aa12-80d7ddb29f79, 'Délicieux ! Après lecture des commentaires, j''ai décidé de mettre 1 sachet de levure chimique entier et le cake n''a pas dégonflé après cuisson. L''intérieur était bien cuit et le chocolat fondant.', '2022-10-22T21:57:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 60812db3-06a0-4bcc-8ff1-b42ed4dae084, 'Excellent ! Le gâteau est moelleux et on ne fait pas la différence avec un cake aux œufs. Je n’avais pas de pépites de chocolat alors j’ai mis du cacao en poudre. Toute la famille a adoré. Je recommande. ', '2021-11-06T08:47:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, de23a57c-fb2d-4b96-bd9b-fa643728cf01, 'Avec un peu de sucre vanillé saupoudré sur le dessus, juste avant d''enfourner,  ça ajoute un petit coté croquant caramélisé. Une tuerie !', '2019-09-19T07:29:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 0c359dbc-477d-4ab3-b7df-8c7548f88f45, 'Très bon ! Je l''ai choisi car mon fils est allergique aux oeufs. Trois étoiles, car malheureusement je l''ai fais trois fois et j''ai jamais pu avoir un cake parfait... Pas cuit à l''intérieur même après 1h de cuisson. Peu importe la température, j''ai essayé à 180, 200 et 160. Il gonfle bien pendant la cuisson et s''écrase à la sortie du four à chaque fois. Je deviens fou. Prochaine tentative, je mets le sachet entier de levure au lieu de la moitié et pour la cuisson je ne sais pas quoi faire.', '2019-03-18T20:03:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 901368a4-fabb-4c30-b003-f3b27cacc35a, 'Très bon gateau, moelleux et facile a faire avec très peu d''ingrédients.', '2018-05-25T11:35:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, caeb8f95-c67e-4a35-a4fc-316636cbf0cc, 'Très bonne recette, parfaite quand on n''a plus d''oeufs et des bananes trop mûres... Mon mari qui n''aime pas la banane n''en a pas laissé une miette !', '2017-10-03T19:52:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, cf8063e6-63ec-4818-88d9-a0d7907a6ec1, 'Super ! Mon fils est allergique au lait et à l''oeuf, et les ingrédients de cette recette sont "communs" ce qui a permis de le réaliser à la crèche, tout le monde s''est régalé et a été étonné du résultat : délicieux ! ', '2016-09-05T02:11:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 5651a790-312b-413f-b44b-4760f8be575a, 'J’ai réalisé cette recette avec des moules à muffins… c’était impeccable… la cuisson parfaite… les portions idéales… j’adore ! 
Une recette parfaite pour les jours de carême et plus encore !
Tout le monde en redemande !', '2023-04-04T18:23:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 1cdb804c-16da-45c9-bf04-835c82112f9e, 'Super dessert, facile à réaliser', '2022-04-06T16:08:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, a38c304d-91d1-4b16-bcf7-40f0161bd1cc, 'Je ne sais pas pourquoi mais mon cake n’a pas cuit de l’intérieur alors que j’ai laissé 20 minutes de plus.', '2022-03-08T09:05:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 52b3c183-f29e-43a3-8950-1a4a08cfb779, 'Trop bien 🤠', '2022-02-16T18:18:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, add0aed8-be01-475b-b2b9-b38b97a86a68, 'Une tuerie !!! Un bon gâteau sans oeuf !! Merci', '2021-12-15T16:52:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, e0f5b0b4-c759-4ce4-a1af-7aa1fcf7411a, 'Très bonne recette, si vous n''avez pas de levure chimique sous la main, une petite cuillère à café de bicarbonate marche très bien :)
Pour ma part, j''ai obtenu un gâteau fondant en bouche et bien moelleux. 
Merci pour cette recette ! ', '2021-04-28T22:15:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 3f9d55e7-c0e2-41d7-9d9f-7c5b715c4423, 'Excellent et j’ai carrément enlever le sucre blanc et laissé que le sucre vanille car la banane et le chocolat apporte déjà du sucre.', '2020-12-13T23:24:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, df7c8b84-10c0-4046-a21f-5faec449e8d6, 'Bon gâteau, simple à réaliser. J''ai surement du trop mélanger la pâte car je l''ai trouvé un peu sec. Seulement pépites  de chocolat  ajoutées. Merci.', '2020-10-23T18:55:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, a7be7e20-dae7-4677-8e3a-1e4b5b4f9c8d, 'Merci pour cette recette, ce cake a eu du succès : ) (par contre je pense que je mettrais moins de sucre la prochaine fois) ', '2020-05-07T15:05:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 358adf53-62d6-4006-b73e-79dadc4cf8ca, 'Trop gras mais bon ', '2020-04-30T22:23:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, e39be76c-a9ac-4964-9419-5c5b0040b989, 'Trop bon ', '2020-04-29T22:06:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 80349a59-fa93-4caa-8f7d-4ddfcb99a01e, 'Excellent le gâteau était très bon :)', '2020-04-08T23:24:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 3cd63db2-5d61-443b-9bbb-a14be92a4919, 'Gâteaux délicieux mais à cuire dans un moule rond pour faciliter la cuisson ! J''ai mis un sachet de levure entier. C''est un régal !', '2020-02-09T11:18:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, dbe6c559-b0c9-43ce-abf6-164b5e8cffca, 'Hyper déçue. Ça fais deux fois que je réalise ce cake et à chaque fois je fais exactement ce qui est écrit mais le même constat s''impose, il fuit à l''extérieur et je le met plus longtemps qu''indiqué, pourtant l''intérieur reste cru. Il dégonfle une fois sorti du four. Et le goût est vraiment insatisfaisant.', '2019-09-11T16:59:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 1a30c8e5-9b2e-4d77-b2be-7743ee0699af, 'Très déçue !! Soit j''ai loupé un truc (mais je ne vois pas quoi), soit il y a un souci. Ceci n''a rien d''un gâteau agréable à déguster ... Il est retombé aussi sec. Au final, tout raplapla et tout compact. Les enfants n''ont pas apprécié (contrairement aux congolais que j''ai fait en parallèle et heureusement).', '2019-06-28T22:38:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, f6f9a656-6e12-474a-ad20-4143c89a354f, 'Simple et gourmand, merci !', '2019-05-11T14:51:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 7c3946ce-2f41-4b9b-9e10-7c627b19b65b, 'Très bon, bien moelleux, j''adore. Je mets de l''huile de coco fondue ou de l''huile de tournesol. On peut le faire avec du beurre fondu bien sûr.', '2019-01-10T21:19:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, c7110237-0622-4e28-ba3b-2712609dfd73, 'Parfait et délicieux, même les personnes qui n''aiment pas la banane l''ont fortement apprécié, je n''avais que 3 bananes, alors j''ai adapté les doses. Par contre j''ai mis plus de chocolat et au lieu de pépites, j''ai mis carrément des carrés, ça fait des bouchées tout chocolat par endroit, un délice.', '2018-11-12T21:19:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 8d9b4c53-f5da-4dce-808d-ba481c275aae, 'Excellent !', '2018-06-28T06:08:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 08f18ee5-adaa-4643-81a6-47c4eb5e7436, 'exellent, en plus sans oeuf et sans beurre. Merci', '2017-07-28T23:08:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 23b9f61f-d4e5-40c3-b3d2-e6be6d15d776, 'Pas mal du tout ! J''ai mis de l''huile de coco et ça marche très bien. ', '2016-04-24T19:52:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (334331, 107b6ff0-9d66-42bc-9539-c23ab11994ba, 'Je préfère faire fondre le chocolat et le mélanger plutôt que les pépites. Mais sinon, ce gâteau est parfait et fait toujours des heureux !! ', '2016-04-13T15:10:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172602, be779434-d3a3-4070-b784-dc83d0291ede, 'Recette qui met tout le monde d’accord ?', '2020-10-15T08:19:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172602, 8c4ed600-de58-461d-96cb-c0c04de18cc3, 'Recette magnifique !!  Nous nous sommes bien régalés !!! J''ai juste ajouté du gingembre frais dans les fruits cuits ! Cela a mis une note de pep''s !!!', '2016-01-03T13:44:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172602, f2037efe-88dd-41d9-8af8-849b3681598b, 'Génial ! Mes invités ont adoré. Recette très originale et délicieuse !', '2015-06-17T14:31:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172906, 052ba9bb-9149-44f8-adb4-bf8c5a195fad, 'Super recette! Mais remplacez la spiruline en gelule par de la spiruline en paillettes ou en poudre locale produite en France et ce sera parfait!', '2020-07-15T19:23:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11263, 5c513583-ef8d-4814-944a-01cfe0594567, 'Très frais et en accord avec tous les fruits de la salade, j''ai aussi fait le sorbet citron-vert gingembre qui est très bien aussi ;)', '2008-07-09T09:13:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11263, 4ff2a705-c0d2-4d48-aec0-56a96d188d74, 'Moi aussi je n''ai fait que le sorbet mais pour qu''il soit encore plus léger, j''ai mis du fructose à la place du sucre (60 gr de frucose = 100 gr de sucre). La prochaine fois je mettrai un peu plus de basilic ou seulement 2 jus de citrons verts, mais même comme ça, cette recette reste excellente. Je l''ai accompagné d''un coulis de fraise, le contraste entre la douce amertume du sorbet et le coulis qui est très sucré est absolument divine. Une recette simple et étonnante. Super.', '2008-06-09T20:22:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11263, 8543e280-bb82-42d1-b69c-5c2ca97e7a6b, 'Juste 4 car je n''ai fait que le sorbet, qui est beaucoup moins sucré que les autres recettes que j''ai trouvées. L''association citron vert + basilic est très réussie. ', '2004-10-18T12:09:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, 3de2387c-bda0-43a8-9922-87d7d2f55874, 'Bonne année, avec ce pudding appétissant. J''ai rajouté de la cannelle, une pincée de muscade. J''ai du rajouté au un moins 100ml de lait. Satisfaite.', '2020-01-01T19:50:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, 205d43f4-ce24-46ca-b347-b92bbd47da1c, 'Super recette ! ', '2016-06-17T19:27:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, e83165ed-fa83-4dcc-8289-1ebca9a10e7b, 'Super recette que ma grand mère faisait déjà quand j''étais petite... je rajoute aux bananes des morceaux de chocolat... c''est trop bon ! ', '2014-04-27T23:21:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, b4628618-10df-490a-81ed-25c77590d674, 'Super ! Je sais jamais quoi faire de mon pain rassis ! J''ai mixe la recette avec les commentaires donc ajout d''un peu de rhum, de miel, de muscade et de cannelle. J''ai un peu lutter pour mixer mon pain, il était très rassis, j''ai du ajouter plus de lait. Et n''ayant pas de coco râpée dans mon placard j''ai mis à la place de la poudre d''amande ! Dans les petits j''ai ajoute une petite cuillère de Nutella au centre, très gourmand ! J''en referai ! Merci beaucoup pour la recette.', '2013-11-24T13:17:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, 5bdbd247-d239-4bda-9d95-74b34de1953c, 'Pour moi aussi, mon tout premier pudding. J''ai mis la moitié d''un gros pain de 400 gr et comme je n''avais pas de noix de coco, je me suis contentée des bananes. Je n''en ai mis que deux et deux oeufs également. Le résultat était tout simplement délicieux. Merci pour cette recette ! ', '2013-04-07T13:14:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, b5deee81-3192-43fe-bf32-c8ac31e4e639, 'C''est la première fois que je fais un pudding mais franchement excellent! Fait avec 2 bananes bien mûres ( c''est tout ce qui restait), 1 bouchon de rhum, 1 pincée de cannelle, 80 g de coco râpée : un régal. Merci encore pour la recette.', '2011-04-07T00:59:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, fcac2cc5-1755-44cf-a346-2dd1ffcd4d10, 'Une catastrophe ! Facile à faire, ca il y a pas de doute, mais le contenu est mou... Trop mou !', '2010-06-12T20:20:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, 6fe717fa-4a29-4e60-b7d3-c7f8f7ecfb8d, 'Très bonne recette : un pudding original, qui change de la recette traditionnelle. Je n''avais pas assez de banane, j''ai mis un reste de mirabelles à l''eau de vie maison (juste les fruits !). C''était pas mal. Mais le mariage banane /  noix de coco est très réussi.', '2010-05-26T21:10:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, 914e875a-d63a-4a9c-a6af-faf4e69d388d, 'Un désastre !! La pâte  à l''intérieur n''était pas cuite et la croute était presque cramée ! J''ai gouté puis tout jeté. Seul point positif la pâte pas cuite avait bon gout ', '2010-03-11T18:35:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, 121ee909-49a0-478e-b0e0-1c9c056dbeb6, 'Recette facile, très bonne, rien à modifier, le mariage banane et noix de coco est excellent. Merci pour la recette.', '2009-09-19T14:27:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, d8ee0f21-1e1e-48b8-bf09-9215f9e3aad0, 'Très bon mais je l''ai trouvé un peu sec, j''ai mis les bananes en rondelles sur le dessus.', '2009-06-09T18:18:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, 8011983c-2559-4942-b680-f17623752102, 'Excellent. A refaire. Merci.', '2009-05-02T20:26:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, 8279d03b-2c55-442d-86b0-5997ed2d55ca, 'Trop sucré et la noix de coco l''emporte trop sur la banane.  Sinon la recette de base pour le pudding est très bonne, à retenir. Pour les amoureux des épices, rajoutez un peu de rhum ambré et une pointe de cannelle et muscade râpée.', '2008-08-28T05:36:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, 1f52c8ae-a491-45e7-8615-9d7b183f4c5c, 'Une bonne recette pour utiliser du pain rassis.', '2008-08-15T12:12:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, fa4698fe-82f3-4500-b542-ef4e843bc9e4, 'C''est bien le meilleur pudding que j''ai fait!!! Excellent et fin, j''ai juste ajouté quelques copeaux de chocolat. Economique car en ajoutant un peu de pain et de lait j''ai rempli 2 moules  à cake.', '2008-08-10T00:26:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, f84d5697-62ad-4100-8f49-03e5d67a9651, 'Vite fait et excellent! Juste ajouté un petit bouchon de rhum.', '2008-06-27T23:03:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, d27b2986-b8f4-4964-bddb-8a8a5793f054, 'Comme de fait, super facile. Petite variante : j''ai ajouté une demie plaquette de choco + une banane... Très bon, et ça se présente bien, en plus très léger. Juste un peu long à la cuisson...INRATABLE, merci!', '2008-05-14T13:00:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, a1c12d63-2241-466f-95b8-39ab869f9089, 'Je viens de goûter et je le recommande, je l''ai fait avec des pommes revenu dans le beurre et le sucre + des cranberries et c''est délicieux. ', '2008-03-19T12:30:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, b946742c-b5d5-4c98-90a8-e94b3d9734bc, 'C''est devenu un classique de la maison. Tout le monde adore. Mon fils de bientôt 5 ans aime beaucoup la préparer avec moi. Par contre pour la cuisson, je rajoute souvent 15 minutes voir 30 pour un moule à cake.', '2008-01-20T12:26:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, ab8730fa-0a11-4b93-8329-3c7f7a45c007, 'Mon premier pudding... Une recette simple mais très reussie, à la maison pas de noix de coco, alors la voilà remplacée par une belle cuillère à soupe de sirop de vanille... Un delice!!', '2007-03-26T12:48:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, cb973642-1768-46b9-865e-244b651de8b5, 'Délicieux, j''ai mis un reste de brioche et de pain d''épices (200 g en tout), 2 bananes, 80 g de coco râpée et j''ai rajouté 100 g de chocolat au lait en morceaux.', '2006-07-17T23:29:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, b03f4a5d-1175-47d7-af0c-3d656330e09c, 'Très bon pudding, qui change de la recette du pudding traditionnel. Je le referai sans problème. Merci!', '2006-04-18T14:26:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, ab017608-b37e-4c56-ad41-63c626040f60, 'J''ai diminué un peu la quantité de sucre et ajouté des pépites de chocolat... Ce pudding est très bon tiède.', '2004-10-26T18:46:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, d3ffb985-61aa-4ff8-a685-157a9e1077de, 'Facile, rapide et ce mélange banane-noix de coco avec une touche de rhum est divin! Cela change du pudding traditionnel. Merci pour cette recette originale!', '2004-05-26T16:58:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, 7c987a53-c17d-442e-8754-ebdcc24a5b94, 'Très bon. Ca débarrasse du pain dur. J''avais juste rajouté un peu de rhum, pour forcer le goût.', '2003-01-16T16:20:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15763, 7cf66b26-340a-4144-8899-723649ceea8e, 'Facile à préparer mais un peu fade. La prochaine fois soit, je penserai à mettre plus de bananes ou un fruit plus fort en goût.', '2002-02-26T14:08:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57530, 25f2a206-d436-4e37-9995-fd6552315980, 'Fait avec raisins secs et cranberries à la place du chocolat. Excellent.', '2020-04-03T20:26:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57530, de758a2d-5fad-4298-abf5-655d40865dde, 'Beaucoup trop sucré, ne lève pas du tout et la recette ne fait pas 12 gâteaux (6 fonds de muffins au mieux) J''ai remplacé le chocolat par de la noix de coco (2oz) Il doit manquer un ingrédient ou + Désolée ! ', '2010-03-06T20:02:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22579, 0ee94d36-6b19-4294-9e83-34897925bbe5, 'Pas mauvais mais un peu fade ! La prochaine fois je passerai les bananes à la poêle avec beurre et sucre pour les caraméliser !!!', '2008-02-06T09:34:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22579, 58f953a7-d178-4d54-ac5e-67ef84dca6c7, 'Pas mal du tout! :) J''ai rajouté une boule de glace à la vanille pour le mélange chaud/froid. C''est assez copieux donc surement mieux après un repas léger !', '2008-02-02T01:04:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22579, cfa9d1b7-9d99-4d9f-8785-e257de0ac1ab, 'Je ne savais jamais quoi faire de bananes trop mûres, cette recette est excellente et originale !', '2008-01-31T16:27:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371299, a52a7107-00fb-4e0e-9551-4f79cffdf3c6, 'Ce gâteau a une texture agréable. Pour autant, nous l''avons trouvé trop peu sucré. J''ai comparé les autres recettes de banana bread sur internet et effectivement elles ont toutes des quantités de sucre plus importantes. Le rapport entre farines et sucre est trop important. Dommage je rajouterai 80 g de plus la prochaine fois pour un ratio plus équilibré.', '2020-03-14T19:42:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371299, 33cd4893-08ff-4964-b197-27feeab6f57c, 'Proportions pour deux cakes. Pour ma part, j''ai mis 4 cuillères à soupe de pâte d''amandes complètes à la place du beurre et de la poudre d''amande. Sur le dessus, j''ai mis du beurre de cacahuètes 100% à la poche. On peut aussi, pour une belle presentation, ajouter des rondelles de banane.', '2019-01-24T05:44:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67674, 483dfd99-4306-44df-b1bb-55c1fa438007, 'Un "p''tit" dessert plus que sympa. Le mélange est étonnant et original, il faut être une vraie gourmande pour penser à associer tout ces bons ingrédients! Félicitations au chef, je le recommande les yeux fermés et les papilles grandes ouvertes!', '2008-03-13T01:12:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67674, dbc70dbb-98ea-4b65-93ba-8acc1c084acd, 'Un dessert original tout en gourmandise! A refaire d''urgence...', '2008-03-12T18:12:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (67674, 17432135-ff49-4c24-899c-23bfba53a510, 'Un crumble où tout les goûts apparaissent petit à petit, un mélange étonnant et délicieux. Avis aux gourmands et gourmandes. ', '2008-03-12T13:13:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27294, 9e143643-8990-4673-b87a-10f75c9ade0c, 'Comme Séverine, on garde la banane entière: on découpe une fenêtre au milieu de la banane, on évide de la chair de banane à cet endroit, on y glisse 4 carrés de chocolat, on referme la fenêtre, on emballe le tout dans de l''alu, on glisse ça sous les braises, ou alors dans le four à 200°C pendant 5 minutes, le temps que le chocolat fonde.', '2005-02-08T20:24:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27294, f51369f3-5199-4031-8e5d-2248ee87e63a, 'Je connais les bananes au chocolat, mais sous une autre forme... Couper la banane en deux dans le sens de la longueur, glisser un bâton de chocolat noir dans la fente, mettre le tout dans un papier alu, et sous les braises... C''est tout simple et super bon!', '2004-02-15T12:01:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (328169, 5b45d5e5-5331-4563-8928-358d7a465be9, 'C''est délicieu ! Et j''ai apprécier de pouvoir les préparer avec mes enfants ! Nous sommes tous ravis ! Merci!', '2018-02-09T02:08:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (328169, 94ebef0b-b26c-42e9-98df-77d119533844, 'C''est assez bon ! ', '2015-12-12T12:58:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (328169, 9cdef03e-21da-41ee-a83f-549488895f2d, 'Excellent ! Recette suivie à la lettre !', '2015-01-16T13:09:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66728, 79551595-53e4-4677-a4dc-b3f84d418c25, 'Merci pour cette recette ! Très facile et très bon, une bonne alternative aux versions salées. J''ai mis 40 g de cassonade au lieu de 50 et ajouté quelques amandes effilées avant d''étaler la crème. Les 100 g de chocolat sont généreusement comptés, peut-être que 70 g suffisent. Quoi qu''il en soit il n''est rien resté même sans glace vanille.', '2013-06-02T17:53:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41241, f1e6953b-031c-4334-8f61-053a6cafd5cf, 'Une petite recette toute simple, sympa, surtout pour les enfants. Un problème par contre, 10 min est beaucoup trop long, en à peine 5 min (à 180°C) le bout des biscottes était déjà presque cramé, et les bananes ne sont malheureusement pas assez fondantes. Il faudrait peut-être les faire fondre un peu avant à la casserole.', '2011-11-02T22:09:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36711, 09584717-fb37-46c5-bff6-c1cbaae196fa, 'J''ai raté le cake, je comprends pas pourquoi : 55 mn au four, et pourtant il n''était pas assez cuit et trop compact, pas du tout moelleux...   ', '2015-01-25T03:14:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36711, c4564aad-4940-494f-ad37-521569a8b665, 'Excellent', '2013-09-03T22:15:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36711, 6c324a9f-4882-43a8-965f-b4351a9ed2d0, 'Très bon. Je n''ai mis que 150 g de sucre. Parfait.', '2013-03-12T18:23:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36711, 34c77022-7b56-4e9f-83eb-6689e0d5df24, 'Excellent, facile à faire. Je n''ai pas mis de sucre en revanche mais de la cassonade : 150g. Un régal !', '2012-10-10T18:04:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36711, e93937fc-cb25-495d-ad9f-f26b5269402c, 'Comme les autres, je mets moins de sucre. Mais la recette est excellente, inratable, un vif succès auprès des petits comme des grands, tiède ou froid !', '2012-04-10T23:03:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36711, 4887ab65-dbd9-4022-b467-b56059c75d44, 'C''est un gâteau délicieux ! Très énergétique bien sûr... A savourer aussi au petit déjeuner. Original, saveurs bien équilibrées, même si je me contente de 150 g de sucre : il a vraiment tout pour plaire et les gourmands en redemandent ! Merci d''avoir partagé cette recette!  ', '2011-03-19T17:17:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36711, 39bce049-ae65-4544-b888-e538e3051f5e, 'Très bien..', '2009-03-16T08:26:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36711, 2cd40032-c073-4195-bbb7-a98b586209c9, 'Exellent! J''ai mis seulement 150 g de sucre, cela nous a suffit. Il a eu un grand succès auprès de toute la famille. Gâteau moelleux et très odorant.... un régal!', '2008-09-27T23:04:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36711, f375ae50-5c01-4d2d-9668-6209636c1f3e, 'Je conseille également de ne pas mettre autant de sucre, j''ai mis moins de 200 g et c''était bien assez. Concernant la cannelle, y mettre la dose indiquée vous donnera un petit arrière goût bien délicieux... Attention à ne pas en mettre plus, cela risque de relever le goût et de ne pas plaire à tous. Globalement tout le monde a aimé, petits et grands. On m''a juste conseillé de mettre moins de banane ... A tester la prochaine fois! Merci pour cette recette c''était très bon. ', '2008-09-19T22:42:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36711, 8f980cef-aa86-4995-841c-d3c81d2cac44, 'Moi qui adooooore la cannelle, j''ai fait la bêtise de ne penser qu''à moi et de doubler la dose...  C''était d''ailleurs délicieux. Sinon la recette est excellente et simple. Merci pour ce moment de gourmandise.', '2008-09-14T01:34:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36711, f39d7818-7201-4423-bcc5-0e570775a4ee, 'Très bonne recette! Je n''avais qu''une seule banane mais c''était tout de même délicieux!! J''ai juste un peu changé les proportions...;-) Recette à conserver! Merci.', '2008-02-17T18:52:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36711, bd624074-f9ec-46d6-86c3-8866e89970f7, 'C''est la meilleure recette que je connaisse : rapide et facile à réaliser pour un résultat fabuleux ! Un grand merci à Karin de nous l''avoir fait partager.', '2007-07-24T20:29:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36711, bfb8cf60-78a4-4b34-8697-a81a292c1580, 'Excellent gâteau! Après moults essais voici mes petits changements : je mets seulement 200 g de sucre, 3/4 de farine et 1/4 de maïzena, et du mélange "4 épices". Un délice...', '2006-12-05T19:14:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36711, 49fe745f-3e11-4117-9093-863cf7f0ddb6, 'C''est un gâteau trop bon et en plus avec les bananes qui fondent à la cuisson c''est délicieux...', '2005-05-26T23:13:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (94541, 760c200c-c590-4f82-990b-c291f3981d1c, 'Super recette, à vos fourneaux, Très gourmet , savoureux, éveille vos papilles, chacun peut rajouter sa touche personnelle, moi je relève mon plat avec du piment de Cayenne.  Aller sortez vos fourchettes 🍴 ', '2023-10-22T15:05:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (336907, d2d8927c-f480-4792-bb07-b3b61ca60ea6, 'Goût assez bon mais une cuisson de près d''une heure pour un résultat assez lourd', '2015-07-07T00:21:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217860, c09719d7-2731-4a77-a6f5-8c3b3ce8980c, 'Doux et sucré, et avec un bon rhum de qualité c''est très original ! J''ai personnellement rajouté une autre banane quelques minutes avant la fin pour qu''elle conserve un peu de texture, et cela m''a fait un plat complet. Je me demande si je ne pourrais pas flamber le rhum la prochaine fois !', '2018-05-22T20:05:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217860, b22dea96-fdc9-4ed7-b1c6-9a3853202933, 'Nous avons adoré cette recette. ', '2018-03-30T09:19:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (217860, f51ec7c2-60fe-4050-a200-50290eb3cb30, 'Excellent ', '2017-05-07T21:40:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65561, 19a2c1d3-3450-4ad9-b905-e55b94071cb5, 'Bonne recette, mais trop de sucre j''ai divisé par 3 sinon que dire, des pépites de chocolat pour la gourmandise... et je n''avais plus de crème alors j''ai mis du fromage blanc ainsi qu''une cuillère à café de levure et c''était très bien, à refaire.', '2016-06-30T16:26:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65561, 2830424b-9575-4779-8fc9-cd326037789e, 'Muffins très moelleux, le goût de la banane ressort bien grâce à la cannelle, j''ai l''impression... J''ai ajouté de la levure pour les faire un peu monter. Résultat très sympa au final, merci pour la recette !', '2012-05-25T19:09:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65561, b54096be-34cf-4ede-91b9-f5c1eb8b31d8, 'Résultat à la hauteur de mes espérances pour ces muffins !! Je conseille d''y ajouter des pépites de chocolat au lait, juste un régal ! Pour ce qui est des proportions, avec celles de la recette on peut réaliser 6 muffins de taille moyenne. Attention cependant avec un sachet de levure j''ai trouvé que mes muffins n''avaient pas assez gonflés et étaient du coup un peu compacts, dommage ! Mais à refaire sans hésitation !!', '2011-12-29T11:48:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65561, cc7bef1a-d6bc-4c47-ad52-98bf027b94e4, 'Recette facile et que les petits apprécient, comme le commentaire précédent j''ai ajouté une cuillère de levure. C''est très bien pour finir les bananes que personne ne veut manger car trop noire.', '2011-09-08T18:03:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65561, a3ef91a4-72a2-46e6-804a-4cd9aa0f8bbc, 'Je me suis posé la question de la levure... oubliée (volontairement ou non) dans la recette. J''ai donc ajouté une cuillère à café de levure chimique et le résultat était excellent. Les petits (2/3 ans) se sont absolument régalés.', '2010-09-17T19:35:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65561, 60714ed6-ec24-4a11-abec-2675d69019ae, 'Excellente recette qui a fait l''unanimité.', '2010-05-20T19:29:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65561, 569fdbe8-f998-4485-a3a9-241b15bc7fdf, 'Alorss résultat mitijé car moi je n''ai pas vraiment aimé mais c''est une question de goût je les trouvent un peu écoeurant mais mon mari lui a aimé, donc une simple question de goût. Les muffins sont un peu tassés et petits, il faudrait augmenter un peu les proportions pour 6 muffins moules silicone', '2008-10-26T21:12:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65561, 6de44d2e-53b4-41e6-bffe-884e5e007d5e, 'Que dire ? Un vrai régal! Avec ces muffins aussi beaux que bons j''ai régalé chéri, parents et même grands parents ! A faire et refaire sans modération. La prochaine fois je pense rajouter quelques pépites de chocolat !', '2008-01-22T22:10:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58026, 7ed900d2-d88c-44ad-886f-a0a25f970c14, 'Formidable ce couscous, très vite fait et succulent. Jusqu''ici je faisais avec des merguez mais la dernière fois n''en ayant pas sous la main, j''ai fait avec des chipolatas Mexicaines et c''était une franche réussite. Je prends du couscous prêt en 5 min et comme recommandé, je fais revenir les bananes avec les merguez. Encore félicitations pour cette recette.', '2010-04-22T13:41:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (254475, 78b1ba80-0cc3-44a2-97fe-82aac61e8d86, 'C''est assez facile à faire et c''est bon !', '2022-10-19T16:11:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, efaa1cda-7dbb-400a-8b38-1858ac7d45cf, 'Super recette que j''ai légèrement modifiée, j''ai remplacé la farine par des flocons d''avoine au blé complet mixés, je n''ai pas mis de sucre et j''ai ajouté un peu de poudre d''amande, c''était délicieux 😋', '2022-11-16T11:33:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, f18cc7ad-5efb-4eea-97c2-2a15728ef97a, 'Je n’ai pas mis de sucre (les bananes étaient très mûres). J’ai ajouté qq pépites de chocolat et des amandes concassées. Idéal au petit déjeuner ou au goûter', '2021-12-22T12:55:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 61e5739e-1f10-4535-aeb6-dd165ba1f2a7, 'Très bon! J’ai rajouté des brisures de chocolat noir et de noix de pécan grillées et saupoudré un peu de noix de coco dessus. Un délice 😋', '2023-03-19T09:05:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 4d587d75-6c6c-40ce-8fba-7d2aabfd42a5, 'Délicieuse recette ! N’ayant pas de compote j’ai remplacé par un yaourt 0% et la recette est totalement réussie ! Un bon moyen de se faire plaisir sans culpabiliser !
', '2023-01-31T18:52:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 6b2c3fad-a855-431d-8916-c469006ee6bb, 'Merci pour cette très bonne recette. Pour nous 30 g de sucre ont suffit et la prochaine fois, j’essaierai de supprimer le sucre complètement 😊', '2022-07-10T11:24:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 7e2584aa-6820-4e17-81a6-8d4c9bad7c84, 'Très bon. J''ai mis 30 g de sucre, ça suffisait largement', '2022-06-26T18:54:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 3190ff6a-2e97-4cb0-9fb0-0661df4eea14, 'J’ai remplacé le sucre par du sirop d’érable (25g) 
Et j’ai fait moitié farine/fécule de maïs 
Un régal', '2022-06-01T23:01:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, a8c8100b-6c0f-407d-beb0-792a5f5e6d90, 'Excellent !', '2023-10-31T17:29:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 942e419a-1d3f-4a6e-b48c-3595e7d333e0, 'Avec quelques pépites de chocolat et saupoudré de noix de coco… un délice ! Pour mon premier banana bread je suis conquise 🤗', '2023-06-13T16:08:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, c4bfbb5c-05a9-468e-be46-7f1ad7c83d22, 'Très bonne recette mes proches ont adorés', '2023-02-27T09:49:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, c9a6492a-a3a7-4a04-a8a9-5bb077dd4dcf, 'Un banana bread hyper moelleux : j''ai remplacé la farine de blé par un mélange de maïzena / farine de riz / farine de maïs / farine de coco (sans gluten) et supprimé le sucre (la compote suffit pour moi) ... un régal ! La prochaine fois, en plus du cacao en poudre, je rajouterai du 4 épices, pour un côté "pain d''épice".', '2021-04-14T07:10:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 9845f44d-fdee-4485-815b-59f218a913ca, 'Un délice! J’ai ajouté mélange de noix, raisins secs et cranberries. Parfait pour un brunch !!', '2021-01-02T20:32:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 981c728a-f8ed-4af3-bc15-7d6851751b8a, 'Première fois que je réalise une recette avec de la compote pour le côté moelleux et c’est une grande réussite ! Merci pour cette recette, à refaire ! ', '2020-05-05T16:23:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, f8068dd6-e146-4a22-a480-fe0e41988c12, 'Pour un premier essai je suis ravie. Réalisés en muffins, les gâteaux sont beaux, aérés et savoureux. À refaire c''est sûr !! Peut être sans sucre la prochaine fois.', '2019-09-22T02:58:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 48a473c7-1e0e-4df3-83e2-f77ee3bc3f99, 'C''est la première fois que j''en faisais un. J''ai un peu modifié la recette : 3 cuillères à soupe de sirop d''érable à la place du sucre et 2 sachets de sucre vanillé, cannelle et un bouchon de rhum. Un pur régal ! Merci pour la recette !', '2019-03-03T05:38:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, ea18ce4b-779e-4ad5-86c6-63dfc6979e31, 'Fondant à l''intérieur, j''ai juste mis un peu plus fort sur la fin de cuisson pour faire croustiller les bords. Un délice. ', '2019-02-13T05:03:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 6a07ac6d-be34-4214-89e2-cb69d160f681, 'Hyper sec manque de moelleux...', '2018-03-27T09:42:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 7a26a577-fe46-466a-bd64-e7f531a9bda9, 'Très bon j’ai ajouté des amandes ', '2023-11-04T20:33:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 838c71f2-edbb-4b19-b089-8b1f0e96a473, 'Excellent
', '2023-05-31T18:51:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 6a2d91dd-016e-4494-b8ee-81295f2a2843, 'Il est devenu mon gâteau préféré !', '2023-01-03T17:38:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 330899f7-af71-47ed-8017-56ebf50cccb9, 'J’ai ajouté 80gr de beurre et une cuillère à café d’essence de vanille :)', '2022-02-06T09:52:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 4dd5c292-6643-4b88-960d-a57ebb64f72c, 'Un délice pour ceux comme moi qui ne peuvent pas manger trop de sucre rapide', '2021-11-18T20:53:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 7b288f11-df30-40ea-8b20-bc6e036c01a1, 'Délicieux !!!', '2021-11-18T18:16:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, e7086f34-c728-4482-80e7-210afa8fd120, 'Je l''ai fait en mettant 50g de miel à la place du sucre, ajouter 80g de pépite de chocolat et 50g de noisettes concassées. Avec le four étudiant que j''ai, 170°C pour 50 min c''est préférable.

Résultats : Très bon, bonne texture et facile à démouler avec un moule à cake en silicone. Il ne sera que meilleur une fois refroidi.', '2021-10-30T11:15:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 42d922f6-973c-4a1b-97cf-73ccba70dc4b, 'Gâteau super facile à faire. ', '2021-04-06T11:46:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, cd2055b7-2cbb-4a14-b8da-008cb8748ecc, 'Franchement une tuerie je l''ai enregistré dans coup de cœur je vais le faire souvent . Merci à vous pour cette recette ', '2021-03-08T18:05:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, d177bc76-806c-4dfe-a268-df197b948b6a, 'Top! J’ai ajouté des pépites de chocolat et divisé les quantités de sucre par 4 et c’est très bon !', '2021-03-05T22:05:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 96b2756e-6a77-4a40-a19e-6b18453190bd, 'Magnifique !!! Excellent !!! Je n’ai pas de mots !!!Moelleux, hyper bon !!! Rien a redire !!! Je le referai sans problème chaque semaine !!! Merci beaucoup ', '2021-02-01T20:45:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 4ecc04e4-e7f3-48db-9b48-417a202efb2a, 'J''ai ajouté un peu de rhum. Excellent!', '2021-01-13T22:31:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, a4a1ead8-49c4-4e14-b0ec-246dab057472, 'Super bon merci ', '2020-11-17T14:20:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, a00ad998-0639-4921-b640-1918fcc957b3, 'Delicieux,  avec une compote pommes châtaignes maison et qques noix', '2020-10-25T20:42:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 0573dcbd-525a-4aca-91db-bf2eed6d5703, 'La texture est entre un cake et un pain. Un peu sec. MAIS ! Pas de matière grasse, pas trop de sucre. Vraiment pas mal pour le petit déjeuner. Mais ce n''est pas le gâteau qui va épater la galerie. J''aime bien. J''ai ajouté 2c.à.s de grand manier ça donne un bon goût. Et 1 sachet de sucre vanillé a la place de 10g de sucre normal.', '2020-10-06T00:37:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 6900dca9-0eda-4ccb-ae18-f5b18af13b6f, 'J’ai réduit la quantité pour avoir pour 5 personne au lieu de 8 mais c’est toujours aussi moelleux c’est super bon ! ', '2020-06-30T17:42:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, b84407d8-ce7c-4c83-9a4f-9849e4a3c9d4, 'Remplacé le sucre par 25g de miel de fleurs, et la compote sans sucre ajouté. Cake bien moelleux au bon gout de bananes', '2020-05-23T17:35:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, e974ea5e-da5d-42f9-bd3c-c0db7066977d, 'Recette parfaite ! Avec les pépites de chocolat en plus, c’était délicieux !! ', '2020-05-17T23:04:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 64eb15f3-beff-4b77-85c2-6a0f12fe1995, 'Super gâteau, j''ai réduit un tout petit peu les doses de sucre. Le gâteau aurait pu cuire un peu plus je pense mais il est délicieux et super moelleux. Génial pour se régaler sans culpabiliser !', '2020-05-12T18:07:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, aa96e11f-4172-4025-8884-78dca553c81f, 'Super bon et facile à faire!', '2020-04-21T16:35:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, d1ae86e1-2cc9-48f6-9009-0659ba8459e9, 'Cette recette est super, moelleuse et encore meilleure avec des pépites de chocolat !', '2020-03-21T11:43:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 0eeeee50-3c2b-47ed-8586-d4ba7f4c9c65, 'Fait avec 40g de sucre et 125g de pépites de chocolat. Très moelleux, j’essayerai avec encore moins de sucre la prochaine fois. ', '2020-03-02T04:53:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 51567be4-3d39-484e-8e22-2313e6c25465, 'Je déteste le goût des bananes, et pourtant j''adore cette recette. Je diminue les quantités de sucre car le combo compote + banane sucre suffisamment à mon goût, et j''ajoute de la cannelle dans la préparation. C''est moelleux, savoureux et super sain.', '2020-01-23T18:38:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 1e570b31-b085-4e94-85fc-37653a179d00, '1er essai et très bon !! ', '2019-01-14T08:20:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347558, 9ebe65d6-825a-4e33-b980-5fc9d7b58b28, 'J''ai testé la recette en utilisant de la compote pomme-banane, et en ajoutant des copeaux de chocolat. Un régal !
', '2018-04-04T11:44:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50309, 2f93b786-91b7-4cc1-a902-ffb970389a3b, 'Super recette, rapide et facile. Je suis végétalienne alors je mets du lait végétal (amande ou avoine) et du tofu soyeux à la place des oeuf (environ 2 cuillères à soupe) et question goût en fruit pas de banane mais des raisins secs. Je mets environ 14 min dans mon micro-ondes à 600W (le temps doit vraiment être une question de puissance) et il est fabuleux !', '2016-11-24T22:16:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50309, bb5aaff6-29cf-48cc-99de-76cd7cabd087, 'J''ai remplacé les biscottes par du pain rassis. Je n''ai pas mis de fruits mais du chocolat en poudre et les enfants ont adoré !', '2010-12-20T16:19:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50309, 7b99b643-7007-4320-a5c0-af4611d14459, 'Très bon! Mais ça manquait un peu de sucre malgré des poires très mûres! A refaire avec un petit peu plus de sucre et peut être un arôme ou un peu d''alcool de fruit, à essayer!!', '2008-04-15T16:09:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50309, a3d5eaf4-9387-47fb-9c22-0e5f22a4c0a9, 'Super! Une recette rapide au micro onde et qui permet de finir les surplus de biscottes. J''ai mis plus de sucre et j''ai soupoudré de sucre vanillé. Ce sont des adultes qui ont tout mangé, les enfants ont refusé d''y goûter, je la recommencerais avec des pépites de chocolat en plus....', '2007-07-10T14:45:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371802, b8041507-1852-45b0-bb2c-5d1e51a0db74, 'Délicieux!', '2021-03-31T10:45:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371802, 4c5db619-dc3e-47a0-9b0c-1922af725358, 'Très bon ', '2020-10-16T12:48:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (371802, 8379d1f4-3263-4060-b8a3-f5d66dd68602, 'Très bon j''adore je trouve cela délicieux.', '2019-07-16T10:43:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16109, 03dd9e2c-4852-4303-8f46-df9ec4483064, 'Des bananes à gogo et des tranches de jambon à consommer rapidement ... je suis tombée par hasard sur cette recette surprennante et ... je me suis lancée! remplacé crème fraîche par lait de coco, c''est délicieux !! Aussi sucré que salé, autant entrée que pré-dessert ....', '2007-09-30T00:29:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16109, 6f6c8144-1508-425b-82c1-e2aa97d8df94, 'Moi j''ai adoré!! J''ai mélangé moutarde-crème fraîche. Cette alliance de sucré-salé est délicieuse ! Merci à l''auteur de cette recette.', '2005-09-14T20:59:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16109, a3bd481d-adcc-41da-8a5b-abf3d4b8f4b7, 'C''est assez particulier mais, sans être mauvais, ce n''est pas vraiment bon...', '2005-08-12T19:19:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16109, 948ced11-0d2a-44d4-88c1-35859efa69ba, 'Sans conteste une très bonne recette... Tout le monde a aimé à la maison!', '2004-08-22T21:25:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16109, 089bf5ee-9f41-4a07-9a9a-be423e7ee2d0, 'Pour quelqu''un qui aime le mariage sucré-salé, j''ai été très décue. Il faut absolument l''essayer avant d''inviter vos amis, sauf si ceux-ci n''en sont pas véritablement...', '2003-05-03T16:28:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16109, 36fefea9-22a4-4864-90a4-c44faff1b1a0, 'Recette surprenante mais délicieuse. Attention tout de même à ne pas trop mettre de moutarde!', '2002-05-22T08:54:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (311921, 8ff98bda-1d58-4266-8882-2efdfeb29c4f, 'Très bon et bonne idée avec la pâte d’amandes !', '2013-10-12T01:43:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45362, e107eb83-1b6b-4753-a27c-b35b223b4cc4, 'Pas mauvais du tout, mais je n''ai pas assez mis de nutella, du coup les 2 parties se sont séparées au moment de servir. Un peu long à faire aussi.', '2006-03-15T21:06:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45362, 3716c8cd-4d9f-47df-9d9d-7fba0d239388, 'Trop long.', '2006-03-13T10:51:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28729, 1c243286-b9d6-42d4-b52e-60d9b824be84, 'Très apprécié par mes invités, servi en verrine avec une assiette gourmande
', '2022-06-01T20:12:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28729, 7aa6f19b-94ee-4755-97e3-d763b8a20dc5, 'Pour 5, j''ai mis 3 bananes, 2 pommes, un peu de cannelle et 2 yaourts. J''ai fait l''unanimité ! Dessert original, copieux et facile à faire.', '2015-01-19T23:59:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28729, 2e7744a0-23f5-47ee-bfb7-12c9f5d30203, 'C''est simple, frais, et ça prend très peu de temps. Il fallait y penser ! Par contre, il faut soigner la présentation : une coupe ou un verre (version verrine), car sinon, ce n''est pas très agréable pour les yeux... ', '2008-04-23T20:34:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28729, 98be1609-acfd-4951-8b16-a5111b7063cc, 'Pour ma part je fais une version chaude: éplucher pomme et banane et couper en dès. Passer 2 minutes au micro-ondes, saupoudrer de cannelle. Laisser refroidir 5 minutes et ajouter un petit pot de fromage blanc (0% pour moi), bien mélanger. Ca ressemble à rien mais c''est terrible!', '2005-10-06T16:35:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28729, 840f28a1-1cb2-4cd7-b540-527aa1708c20, 'Rien d''extraordinaire.', '2005-05-23T22:07:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28729, 9ec1cad9-ae9c-4648-8dfc-07cd9704dc4b, 'Très bon et copieux en effet ! Lorsque je ne serai plus au régime j''y rajouterai du miel. On doit pouvoir aussi parfumer au citron, à l''eau de rose, à la vanille et à la cannelle avec de bonnes surprises !', '2005-01-08T16:42:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28729, 55d66828-394b-4e4c-8430-328af4875235, 'Je mange ça tous les matins en temps de régime, donc fromage à 0%. J''y ajoute quelques fruits secs (amande, noix, raisins), et une cuillère de flocons d''avoine.', '2004-04-15T10:36:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28729, 6dd55476-4cd9-495c-a0d7-30e91a0affc5, 'C''est délicieux! En Suisse, on appelle ça de la crème Budwig et on y met aussi des fruits oléagineux. Moi je mets des pignons, ça complète et c''est super bon! On peut le faire avec plein d''autres fruist que la pomme (avec des mangues, des cerises noires ou des litchis, c''est miam!).', '2004-04-15T10:20:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40565, 8af1a091-b0e1-4b7f-8a0e-0a6ebb77bd1f, 'Plutôt agréable, les saveurs se marient bien. J''ai également remplacé la confiture de bananes par une sorte de compote que j''ai faite juste avant.', '2013-03-08T11:09:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40565, ea720cfa-3632-4630-b5d0-e95f5b564dd1, 'Un mariage curieux mais excellent ! A la place de la confiture que je n''avais pas, j''ai mis de la banane écrasée avec un peu de sucre... Servi avec du riz blanc agrémenté du reste de "confiture". Une réussite !', '2012-07-14T15:06:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40565, 6670fc19-74b3-4aa0-9f6c-8c3e72c128e0, 'C''était super bon. On s''est régalé avec mon chéri. J''avais des paupiettes toutes faites et pas de confiture de banane, mais c''était déjà excellent! Recette simple et pratique. J''ai juste ajouté du bouillon de volaille pour avoir plus de sauce.', '2007-03-09T11:39:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29002, 21552cf8-be9c-4480-ad6e-1c2af0c0666b, 'Excellent avec de la brioche (un peu trop sucré pour moi avec du pain d''épices mais c''est une affaire de goût) ! Merci d''avoir partagé cette recette.', '2013-01-15T22:12:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29002, 0c26e134-6b17-455e-98b7-19b86a81a031, 'Délicieux ! Nous avons rajouté de la noix de coco râpée. Un régal!', '2011-09-16T00:00:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29002, a599a71b-ca17-4296-bd42-0dba5cfd02a6, 'Quel régal... Aussitôt fait, aussitôt mangé. Je n''ai rien changé à la recette. A refaire rapidement.', '2011-04-27T18:48:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29002, 514b991a-188e-4ed7-97ac-e4b44c26a792, 'Tellement simple, qu''il fallait y penser. Attention, avec du pain brioché ça cuit très vite... et pourquoi pas 3 morceaux de chocolat, pour les gourmandes!', '2006-02-28T17:27:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29002, c686dd31-e4d6-4fc8-b94d-43d914cf4a4e, 'Idée simple et géniale! Un régal avec du pain brioché. Je pense qu''avec du pain de mie, ça doit être bon également.', '2004-06-23T19:44:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29002, 242f9a1b-19a7-45fe-8ecf-e5badcb047ab, 'Un vrai délice! Je l''ai fait avec de la brioche... Ca va devenir mon 4h préféré et celui de Chéri aussi!!', '2004-06-11T19:47:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29002, 65f1c343-e8a1-4519-b861-374a46b9fa8e, 'Du pur bonheur de gourmand avec des tranches de brioche Maison...', '2004-06-08T09:57:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 2acb572f-32e5-44b2-b2c9-289c4eb2631a, 'Meilleur sans banane, attention à bien faire cuire la base (sinon problème au démoulage)… Très bon!', '2021-07-26T02:25:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, f401c4ed-c0db-4267-b383-d1c00883539a, 'Technique intéressante ! Il manque des infos comme la quantité de sucre préconisée, la température et le temps de cuisson (j''ai fait 25mn à 180 mais ai dû remettre 5mn). Mais résultat sympa!', '2021-01-21T23:38:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 07b4aab6-b889-40b6-b1ea-b9758f4e798f, 'J''ai suivi les commentaires, 3 pommes, 2 bananes un peu de Nutella c''est bon, pas trop sucré. Un délice. 20 min à 200 degré pour avoir les 2 côtés bien cuit. ', '2016-04-21T23:13:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, c65b5ee2-4380-499b-b06e-e682264171bc, 'Très très bon. Pour 4 convives,  j''ai mis 2 pommes, une grosse poire et une banane ainsi que des raisins secs. J''ai utilisé une pâte pliée en 2, dorée à l''oeuf comme indiqué mais en ajoutant un peu de sucre roux avant de faire cuire au four à 200°C (thermostat 6 - 7).', '2016-02-17T23:40:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 68c7a7fe-18aa-4ade-aa1d-c43af500e50e, 'Excellent, j''ai mis 3 pommes et 2 bananes pour faire un chausson avec une pâtes plié en deux. Et une Grosse cuillère de rhum !', '2015-04-16T22:37:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 5f62e171-384d-48b6-904a-128850b7efcf, 'Bon mais lourd ', '2013-11-28T21:44:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 6e8fd4c1-8db4-49f0-aaf9-661273238cae, 'Excellent mais plus sucré ça serait parfait!', '2012-05-25T00:35:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 94d9602b-a744-40ab-b1ce-3ed0f6cffae9, 'Recette excellente ! Je pense qu''il faudrait mettre les pommes à fondre un moment avant de mettre les bananes, pour qu''elles soient bien fondantes, sinon ça fait une sorte de bouillie et c''est pas top pour déglacer la poêle avec le rhum. Mais rien d''autre à redire !', '2012-03-13T16:16:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, da6eceb6-c60d-4046-971d-67e74adbd86b, 'Excellent, super bon avec du chocolat fondu sur les pommes et les bananes !', '2011-07-31T23:23:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 73e3c942-fa75-4524-889d-e4732887662f, 'Mmm, c''est super bon, mes enfants se sont régalés.', '2011-06-11T00:02:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, d6ed2be8-0cc5-4b4d-afca-db0e88e15976, 'Très facile, j''ai ajouté de la cannelle, merci pour cette recette.', '2011-05-25T11:00:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 5c200616-d8dc-457b-8bfb-e8358dd37636, 'Excellente recette ! N''ayant pas de sucre de canne, je l''ai remplacé par du sucre vanillé. J''ai aussi tapissé la pâte de Nutella avant d''y mettre les fruits, un délice pour les gourmands !', '2010-09-25T22:38:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 7174d9f7-c02a-4e65-a929-c138e3e44db3, 'Peut être moins de pommes, j''ai aussi rajouté des carrés de chocolat c''était bon mais à ne pas manger après un gros repas car c''est un peu lourd!!', '2010-01-22T12:50:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 35bf22d0-860c-48dd-8097-58bbd7b626ac, 'J''ai fait plusieurs fois ces chaussons, car c''est une recette inratable et appréciée de tous ! Et comme petit plus, j''ajoute quelques carrés de chocolat sur le dessus avant de refermer mon chausson... hmmmm... un vrai délice ! ', '2009-11-28T19:49:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 79773f1d-2e21-4fdc-858f-be655e57af0e, 'La pâte brisée du dessous était toute molle, d''où problème au démoulage, le fond a lâché. Peut-être faut-il précuire la pâte du dessous !!!!', '2009-08-10T16:15:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 09e76427-7bd7-4b0d-84cc-ff604ddc7c38, 'Top top top. Un franc succès; j''en reste encore étonnée. Rien à changer. Le seul truc est que je n''ai pas trop senti le goût des bananes,et que celà a mis un peu de temps à reduire. Mais que ce fut bon !!!', '2009-06-20T01:08:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 7d2ec48a-5866-4556-8353-b47a3bb65076, 'Je dois avouer que j''étais assez septique sur cette recette mais encouragée par les notes j''ai tenté, il me fallait une dessert rapide et...le résultat était génial ! Tout le monde s''est régalé, j''ai mis du miel au lieu du sucre et le tour était joué !', '2009-04-29T13:40:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 5ceba28d-6d89-4560-b52f-14c1bd0983bc, 'Recette faite avec une seule pâte feuilletée repliée en chausson. La pomme agrémentée par la banane Hum ... superbe idée ! Selon le nombre d''invités, je préfère faire 2 chaussons (avec 2 pâtes repliées) ce qui en fin de compte fait + de parts !!! Merci Merci...', '2009-04-21T21:31:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, a0afd8eb-09d6-4737-b914-6968ee6ba225, 'Pour ma part, je l''ai fait avec une pâte brisée pour le dessous, et une pâte feuilletée dessus. J''ai fait comme une galette des rois. J''y ai ajouté un peu d''amandes en poudre, et du rhum. J''ai hésité avec le rhum, mais la prochaine fois j''en mettrai un peu plus ainsi que les amandes. Tout le monde a aimé. A refaire, merci pour la recette.', '2009-04-18T10:45:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 9332fb46-39a9-4f10-82c6-098eceec863b, 'Succulent et rapide. Une seule pâte pliée en deux comme un chausson et j''ai ajouté des raisins secs. Cuisson Th 200°C. A refaire sans hésitation.', '2009-04-15T18:49:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 847c27a9-d89b-45f0-99f4-fcf7b66393f3, 'Délicieux, je l''ai faite juste avec des pommes et j''ai rajouté un peu de rhum. Très facile à faire et belle présentation. Je n''ai utilisé qu''une seule pâte que j''ai refermée comme un chausson. Mon fils a adoré !', '2009-03-30T10:48:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 414bd406-8144-4c88-ba86-6d208198a090, 'Rapide et très bon.', '2009-03-29T11:25:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 8f9a5931-8f00-4486-9c20-1afe9355f2e6, 'Délicieux. J''ai utilisé une pâte brisée pour le fond de tarte et une pâte feuilletée pour le dessus. C''est une astuce que j''utilise régulièrement et qui évite le durcissement du fond ou son détrempage. J''ai également remplacé le sucre par une grosse cuillère de miel liquide et saupoudré légèrement la préparation de "quatre-épices".', '2009-03-23T18:07:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, ed98b328-239f-4825-9a20-d5831ab80947, 'Excellent, on l''a dégusté tiède, un vrai régal, simple et rapide en plus !', '2009-03-21T22:40:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 92b7b53b-47d8-4290-9763-3aa146fc4c65, 'Je n''ai utilisé qu''une pâte feuilletée que j''ai repliée en deux et j''ai mis de la cannelle à la place du rhum. C''est meilleur tiède.', '2009-03-06T10:37:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 4c8664c3-327f-4098-a3bc-22889d8786e2, 'Comme Nathalie, je dis que ça marche aussi avec une seule pâte repliée comme un grand chausson... Le mélange pommes/bananes est délicieux... simple à faire mais vraiment plein de saveurs!! Bravo et merci.', '2009-02-13T12:55:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 7aa5a22d-8bc0-47a6-a43c-b8d1824d7e66, 'Recette rapide et délicieuse, j''ai ajouté de la cannelle.  Je tenterais prochainement avec une pâte maison. ', '2008-11-29T22:33:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, b1df4aee-7df4-484c-bf6e-2e7c330efba1, 'Très très bon ! Et original ! A faire et à refaire...', '2008-11-24T14:50:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 5e43f93c-3d95-4e07-92dd-c9ece946e9af, 'Recette vraiment appréciée par toute la famille... J''ai juste remplacé la pâte feuilleté en fond de tarte par une pâte brisé. Excellent.', '2008-02-27T11:04:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 84a1f0ec-a375-4e95-aa94-86e2feb85529, 'Très très bon!!! Facile, rapide et peux coûteux. Il n''en restait pas une miette dans le plat, et on était 4 personnes...heum ! J''ai juste rajouté un peu de sucre, en plus du jaune d''oeuf sur la pâte pour caraméliser... A refaire !!!', '2008-02-11T20:37:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 32651b68-92f4-429e-9092-8106c63b3501, 'Un vrai régal! Mes enfants et mon mari ont adoré. Je l''ai également fait avec une pincée de cannelle à la place du rhum, c''était tout aussi délicieux. Merci!', '2007-11-26T19:14:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, ffc822fa-1a15-4dc6-8e63-6120cb56dff0, 'C''est bon et facile à préparer avec des enfants, je recommancerai avec une pâte feuilletée pur beurre. J''ai aussi ajouté de la cannelle et quelques raisins secs. Merci pour cette idée qui change des tartes, ou du traditionnel chausson aux pommes.', '2007-10-30T20:20:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, fdcb8d02-7857-45bc-92e1-5cdd30bad249, 'Pascaline Très très bon, c''est délicieux.', '2007-10-30T10:19:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 0cc92205-6b23-4326-a580-1bc09830b1da, 'C''est vraiment délicieux... J''ai mis de la cannelle après avoir mis le sucre, c''est excellent. Je n''avait que de la pâte à gâteau et ça va très bien.. Merci ', '2007-09-23T23:37:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16850, 35b387b3-dc08-4329-99b6-fd510fea2b78, 'J''ai fait cette recette plusieurs fois, c''est à chaque fois réussi. Avec ou sans bananes, mais il vaut mieux choisir des pommes qui fondent à la cuisson sinon la préparation devient longue. Je n''ai pas badigeonné avec un jaune d''oeuf. Ca marche aussi avec une seule pâte repliée en deux comme un grand chausson aux pommes. merci', '2007-09-12T22:31:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66581, b6f688fd-ceac-4e8a-8234-99500b2c9e66, 'Excellent, même si je n''ai pas suivi rigoureusement la recette car j''ai fait le caramel avec de la panela. Le citron est une riche idée à laquelle je n''avais jamais pensé, son goût acidulé se marie en effet parfaitement avec la banane, le rhum et le caramel. Une gourmandise à refaire !', '2020-10-15T10:41:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66581, c7924dab-09b9-447a-9163-f9bb992a51ad, 'Excellente recette. Je ne mange les bananes que sous cette forme et refais souvent la recette quand une petite envie de dessert me prends le soir ! Je mets très peu de citron et retourne délicatement les bananes à la spatule.', '2015-02-26T17:55:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66581, d90326ce-391e-445e-982c-62ff67f18972, 'Très bonne recette. Pour la caramélisation, j''ai fait dorer les moitiés de bananes dans le beurre, puis je n''ai mis que quelques gouttes de citron sur les moitiés de bananes., puis j''ai mis le sucre et c''était parfait. J''ai servi  ces moitiés de bananes sur des moitiés de pain d''épice, auparavant poêlées. J''ai eu avec cette recette un certain succès. Un grand merci. Bien à vous.', '2014-01-20T17:59:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66581, f08cfda9-eb7d-4fee-a84c-4a304ccfea51, 'En effet les bananes ne caramélisent pas. Certains pourront penser qu''il y a un peu trop de citron. Mais cela reste une bonne recette !', '2010-09-19T18:30:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66581, 24cfc229-32bb-43f0-8e7b-6efed99033f8, 'C''est très bon, mais les bananes ne caramélisent pas.', '2008-03-02T12:21:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13300, ad9b19dd-c18c-4e6b-9dae-e7aabd824fce, 'Mêmes ingrédients, mais je mixe l''ensemble, cela donne une texture de milkshake au fruit. Si c''est trop épais, je rajoute même du jus de fruit. Idéal aussi pour utiliser les fruits qui trainent en les mixant ensemble.', '2008-12-12T21:26:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13300, 3ebf776c-757f-4138-9f67-db6a91ae6917, 'On peut éventuellement rajouter sur les bananes un trait (en gros très peu, comme un petit coulis) de chocolat au lait fondu ou de pâte à tartiner. Ça rajoute un peu de sucre si on a pas sucrer auparavant les yaourt.', '2020-02-20T11:09:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13300, 102e2693-390a-4f73-82ef-12c5492e7832, 'En ajoutant du miel bio et du muesli c''est top pour bien démarrer la journée ou en pause goûter.', '2016-12-09T01:30:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13300, e4e713cb-98d1-455c-a4d4-d49abc4831d3, 'Avec des bananes bien mûres et un soupçon de sirop d''agave c''est excellent ! ', '2016-02-22T13:26:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13300, 88a09854-ee0e-4d2d-b4fe-9fb43a19db7f, 'Dessert délicieux et très simple ', '2015-04-09T14:06:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13300, 735e2141-1062-46f1-8ee3-2bfbbb5ae1a7, 'J''ai fait ce dessert à quelqu''un qui ne mange pas de sucre, j''ai ajouté un peu de rhum et quelques raisins secs', '2010-09-09T23:56:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13300, 73cb662a-509a-46cf-a3cb-bf835e563d6b, 'Je mixe les bananes avec des yaourts brassés et je sers cette préparation avec de la glace au chocolat. Merci pour cette recette.', '2010-03-18T21:34:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13300, f56ad75d-fda9-4b2a-83dd-b9b9f5a401d1, 'Très agréable de consistance, mais nous avons trouvé que cela manquait un peu de sucre... ', '2006-09-05T11:22:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13300, c5ff2536-b2bf-4a25-a821-dc982fe672ec, 'Perfecto, excellent, magnifique!!! Bref, très bon!!', '2004-10-19T14:40:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13300, 9b0d5132-5ccc-4a90-9eaa-5a25922f47b3, 'Excellent !!! à essayer avec des sirops style kiwi, fruits de la passion, etc ...', '2004-01-04T11:27:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13300, fa30e605-5b55-42a9-add2-51fd2dae7443, 'J''adore: rapide et succulent. C''est aussi un dessert qui me rappelle mon enfance. On peut y ajouter du jus de citron ou de pamplemousse ou d''orange (en pack si on a pas de fruits frais à presser).', '2002-06-28T17:12:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90970, 2d8bd4ed-45fd-44fc-ba9e-247512a92406, 'Très bon, facile de réalisation. On s''est régalé le soir même! Ayant fait plusieurs verrines on en a remangé le lendemain et là BÉMOL ;  jus de la banane a couler au fond et la coupure des couleurs complètement mélangé. Plus très appétissant visuellement. PETITE ASTUCE : mettre des biscuits cuillères au fond pour absorber le jus de banane... à essayer.', '2015-01-28T17:20:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90970, fa05f9e2-37c6-4b02-b3bb-3c6876aac197, 'Que du bonheur ! Surtout la mousse banane.', '2012-12-17T14:10:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90970, 27f06f76-6519-46d7-b60c-379456390b4b, 'Décevant. Quantité de sucre problématique, consistance trop liquide.', '2010-03-27T21:18:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90970, 356cd4f4-bc5a-4428-b0e7-c10628c14e01, 'Un vrai délice, il n''en est pas resté, tout le monde s''est régalé ! J''ai servi les verrines avec des petits gâteaux sablés. La palme du succès revient à la framboise, peut etre que la prochaine fois je ne ferai que la framboise!', '2010-03-14T22:35:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (165514, 46fa464d-1d80-42f6-890d-ee7268ad0d67, 'Vraiment très bof! et je mets 1 sur 5 parce que je ne peux pas mettre moins!!!', '2015-12-31T18:10:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, b56873f3-85a6-4a59-b808-747641f5ffe8, 'Un régal comme à chaque fois. Je les présente sous forme de petit muffins et mini cakes, du coup les enfants les mangent au goûter à l''école.', '2022-10-22T11:25:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, 3159cb45-9d4d-4fa3-b62b-8cf02d76e33a, 'Le gâteau mérite un peu plus de cuisson que dans la recette mais il est très bon. J’ai suivi celle ci à la lettre et c’était parfait !', '2021-06-29T14:13:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, d4189153-3f87-4b8a-9da5-f81cd0a6e15e, 'Je n’avais que 2 bananes sous la main et j’ai remplacé la noisette par de l’amande et très bon. M’a demandé 35-40’ de cuisson ', '2021-04-03T18:23:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, 52669071-b7a4-43c3-9dc4-e3ee65622762, 'Excellent mais peut nécessiter un peu plus de cuisson', '2021-01-31T10:28:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, 9b4ea4bd-8170-471a-b73b-0c8c1af1e31a, 'Fait avec 3 bananes, de la poudre d''amandes et 50 min de cuisson. Délicieux ! A la fois moelleux et fondant, et seulement 3% de sucre (le sucre du chocolat) pour un plaisir intact ! Je n''ai mis que 4 étoiles car mon mari et mes enfants n''ont pas l''air d''avoir beaucoup aimé: -(', '2020-04-22T16:28:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, 0d90fea1-b40b-4b7b-8e97-4f0bec3bc580, 'Recette très simple et rapide !', '2025-09-21T10:37:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, 1376e335-575b-4a29-ba29-a51c0e22e1d5, 'Super bon et très moelleux. ?', '2020-12-23T17:58:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, 0b8e42b2-d378-4f1f-8be2-d6c7ca251f3c, 'Pas de chocolat. Les oreillons de 2 mandarines dispersés dans la pâte. J''ai aussi monté le blanc d''oeuf en neige pour plus de légèreté. Un régal pour un dessert sans sucre ajouté. Bravo.', '2020-11-28T14:51:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, 37ebde82-1c83-4a7f-8ab9-ad8252cdf1d3, 'C''est vraiment délicieux ! J''ai mis de la poudre de noix pour remplacer la poudre de noisettes, ainsi que quelques noix concassées (je n''en ai pas mis autant que la recette propose et cela se sent aussi bien). J''ai mis de la cannelle principalement comme épices et remplacé le lait par un peu de yaourt. Le beurre peut être remplacé par de la compote de pommes (cela permet de sucrer également).', '2020-10-31T22:58:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, f4d19859-96c1-4879-aae1-99ed1d0b26ef, 'Un régal, côté cuisson j’ai cuit 45min à 180 avec un four à chaleur tournante, et j’ai remplacé la noisette par de l’amande et ajouté 1 peu de cassonade dans la pâte.', '2020-10-06T19:03:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, 53393d4f-2f6c-42e4-952a-efc3c862dc32, 'Fait avec de la noix de coco râpé et cuit plus longtemps. Délicieux et moelleux.', '2020-10-01T21:17:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, 912c29ee-d089-45d6-9cc0-08364e8ca9e9, 'Un délice moelleux et léger rien à dire', '2020-08-29T01:40:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, 721ed580-8069-4795-84b5-32e2931a625f, 'Très bon et léger! J’ai mis des vraies noisettes concassées ?', '2020-05-19T19:57:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, d4e632f5-28f2-4419-8e99-cd4157555892, 'Super bon ! J’ai remplacé la poudre de noisettes avec de la poudre d’amandes, ça marche aussi très bien. Et j’ai mis 45 minutes au four à 180. Parfait aussi avec de la chantilly si on veut un goût un peu plus sucré.', '2020-04-10T17:13:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, ce7706e6-c833-4450-82a0-e62e05351927, 'Fait avec 3 bananes de taille moyenne et uniquement de la cannelle (au lieu du mélange d’épices). J’ai utilisé de la farine semi complète. Cuisson 45mn à 180°C en chaleur tournante, en couvrant d’une feuille d’alu les 15 dernières minutes. Résultat parfait, dégustation tiède, un régal !', '2020-03-06T21:57:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (391903, b0ce2223-6a3b-438b-9958-d45e0fd82fae, 'Très bon, moi qui aime les gâteaux peu sucrés je suis servie. Très moelleux.', '2020-03-06T15:36:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (340538, 8edff1f7-8f34-405f-ac85-a7d1e78ab01a, 'Un pur bonheur. Cette petite touche de nutella est la cerise sur le gâteau. Je le referai sans hésitation.', '2015-11-08T16:54:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68701, c69c5706-6e68-48eb-b704-c9bb8ba4cdeb, 'J''ai trouvé une texture proche du clafoutis et je crois que je vais essayer avec les blancs en neige pour aérer la texture ou mettre de la levure.', '2013-12-13T19:02:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68701, 3fce2d67-9878-4c39-bf5c-1dd25ec1bae2, 'J''ai remplacé l''édulcorant par 100g de sucre mais un peu trop sucré encore à mon goût. Ressemble un peu à la texture du clafoutis, bon, la prochaine je choisirai entre la banane et la pomme je pense ! ', '2011-02-23T17:43:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170087, 3dd529cb-bc92-4fd2-9248-c22e4e0d902f, 'Excellente recette ! Je me demandais quoi faire de mes kiwis, bananes et de mon fromage blanc. Pour ma part, je l''ai tourné d''une autre manière : j''ai cassé quelques speculoos pour en faire le fond de mes ramequins, j''ai ensuite rajouté une fine couche de fromage blanc+sucre, puis la purée de banane et j''ai mis au centre de la purée de banane une petite boule de confiture de fraises (oui on est gourmands) puis à nouveau une fine couche de fromage blanc+sucre et quelques morceaux de kiwis. J''ai ensuite à nouveau cassé quelques morceaux de speculoos que j''ai mis par-dessus les kiwis, j''ai rajouté à peine un peu de pâte à tartiner au chocolat blanc (fait maison, très facile !), et j''ai rajouté un carreau de chocolat au lait (et quelques billes vahiné pour la décoration). Je me suis amusée à préparer cela, et cela a beaucoup plu ! Je le referai à nouveau, mais je pense le faire cette fois-ci avec des fraises ou des cerises, à voir !', '2012-05-02T13:49:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (320967, 7670acec-d1f5-40e1-a545-b25a660ba7f7, 'Pas mauvais mais je trouve que le sucre est en trop.', '2016-02-27T18:37:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (340053, 9f603dc0-4a15-4cdf-b516-ca08e29340b6, 'Moi j’ai rajouté 100 gr de chocolat à dessert que j’ai fait fondre dans 100 gr de beurre en supprimant l’huile prévue dans la recette ! Ce gâteau (même un peu chaud) à quatre heures avec un thé noir mélange de Noël (même en avril un week-end sous la neige) cela fut une tuerie hummmm', '2022-04-03T16:53:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (340053, 9990509d-d731-499b-a5ee-bda375c2e334, 'Très bon gâteau je l''ai également fait avec de la farine avec levure et j''ai doublé les doses avec un peu plus de bananes que prévu. J''y ai également ajouté de l''essence de vanille de Lifou.', '2019-09-03T07:40:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (340053, a3f8a1b8-2cbd-4264-b2e2-22954f7b3498, 'j''adore ! j''ai mis 5 banane dedans,et 210 gr de sucre j''ai ajouter un sachet vanille et une cuillère à café de vanille liquide en plus des autres ingrédients. J''ai également mis à cuire 40 minutes à 160° . Un vrai régal', '2023-05-06T14:44:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (340053, e529091e-b01b-4f10-8d6d-dcf6c384084f, 'Effectivement sans levure c''est pas très bon !', '2018-07-08T05:47:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (340053, 7f5482d1-bd9a-407a-8e84-1d67d23ae7cc, 'C''est juste excellent ! Par contre j''ai ajouté une banane en plus et j''ai réduit le temps de cuisson à 15min à 190°C, le gâteau est moelleux, c''est une merveille ! ', '2018-04-07T14:54:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (340053, d2915b24-a355-44e0-a769-ea0c29ce0456, 'Avec seulement 120g de sucre, et en ajoutant un sachet de levure et 2 cuillères à soupe de crème fraîche : certes ce n''est plus vegan, mais c''est excellent !!!', '2017-08-08T12:31:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (340053, 070b3727-42d1-4cb9-b321-095f69fdd461, 'Pouahhh quelle horreur ! Un vrai pavé ! autant faire l''impasse sur le désert ! Par contre en ajoutant de la levure et du lait, c''est pas mal. ', '2016-10-25T19:23:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (340053, a917cb41-e7c9-4c56-be4d-e50ca35c5e06, 'Ayant lu les commentaires, j''ai ajouté un yaourt et un sachet de levure… et bien ce gâteau à eu beaucoup de succès, et j''avoue je ne suis pas mécontente du résultat !', '2016-10-23T20:13:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (340053, addc50ce-98b3-4688-b69c-c35f1f28fca3, 'J''ai essayé aujourd''hui !! Le gâteau est en cuisson.. ca me parait bizarre. A voir le résultat dans quelques minutes.', '2016-09-28T16:27:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (340053, 4de79845-16f1-483e-b804-714c7938b7d5, 'Bon mais sans plus, un peu compact. J''ai réduit le sucre à 100g et rajouté 2 bananes, ça ressemble plus à une galette qu''à un gâteau.', '2016-08-31T13:18:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530093, be603edf-dcca-413a-b8fb-abd434530073, 'Pâte trop liquide et crêpes trop liquide. Bonnes et légères quand même', '2022-04-02T16:42:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530093, f9938849-cce3-4377-b771-e168aa6ef0af, 'Pas la pate a tartiné a l''huile de palme', '2022-01-30T11:43:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95822, 18e79751-6fe9-43c6-acb0-8d05f0aba4b7, 'Délicieux mais costaud ! On a dû doubler les doses de jus de fruit. Tous les invités ont apprécié. A refaire très vite !', '2015-07-12T21:30:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41562, ed9c591c-f341-4301-b239-f77013b2a2bb, 'Super recette !!!!!! J’adore ?❤️❤️❤️❤️', '2021-02-28T13:47:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41562, a8fbd432-c8ed-4f99-bffe-fa7f74dcfb20, 'J''ai remplacé la banane par des fraises et j''ai ajouté plus de cookies et je n''ai pas mis de sucre, c''était super bon! ', '2017-06-14T14:51:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41562, 9879aa1b-ebca-4291-bd0d-baf213db3d0c, 'Super bon !  !', '2020-06-20T21:46:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41562, f16a610f-0136-4d8a-baa1-29b8a5f38598, 'j''adore ?❤', '2019-03-10T22:02:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41562, d3b7fc4f-a395-4241-839d-c516dae6217e, 'Bonne idée de recette. J''ai ajouté 2 cookies en plus. Le goût de la banane ressort vraiment bien, un vrai délice.', '2018-12-02T18:32:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41562, 4ae61710-3cae-42f7-95da-f9d19f333bb4, 'J''ai essayé cette recette en diminuant un peu la quantité de sucre et en mettant 1 cookie de plus et franchement c''est juste délicieux! Je vous recommande cette recette, qui est en plus très simple à réaliser! ', '2017-06-03T17:24:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41562, dca24f47-72e6-42e0-a84d-32e74be72d40, 'Juste trop bon, vraiment à refaire', '2017-06-01T13:14:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41562, 424516e6-3f4a-4172-83f8-6f0d0be2cde7, 'Excellent j''ai fait moitié lait moitié glace vanille mais je n''ai pas ajouté de sucre et je dois dire que j''adore !', '2016-07-03T14:12:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41562, 025a9a46-c3e2-428d-8a84-b9929216b1e9, 'Désolé mais pour moi ce n''est pas un milk shake ce serait plutôt du lait avec des cookies ramoli dedans. Je n''ai pas aimée et mes enfants non plus...', '2015-05-17T00:51:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41562, bfcb6d2d-75ba-4eee-985c-614e7fe7cbd5, 'Excellente recette vraiment très originale, qui donne vraiment envie des le déguster, alors merci, car, j''ai trouvé mon dessert, pour demain. 20/20, +++++, (-:', '2015-04-20T00:08:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41562, 7cfbbcf2-15ca-4c0b-9f1a-4b4817ad51a6, 'J''ai un peu modifié la recette, j''ai mis 7 cookies au lieu de 4, 2 boules de glaces vanille, pas de sucre, 250 ml de lait et 1 banane, on sent bien la banane et légèrement le cookie trop bon et pas trop sucré.', '2014-07-20T21:48:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41562, 3fc90f8b-fa5b-4b1d-83ea-698aaf5fab56, 'Super bon, j''ai mis 2 bananes et j''ai mixé en faisant en sorte de laisser quelques bouts de banane. Il m''en restait encore pas mal, alors j''en ai présenté dans des verrines, avec les morceaux de cookies par dessus, c''était très joli ! Merci pour la recette.', '2013-05-12T01:47:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41562, 24def6e0-5387-4b32-81da-2ec6a085dd76, 'À voir le liquide dans le mixeur j''ai cru qu''il allait finir dans l''évier mais j''ai tout de même gouté...et hum!!! Finalement ce mélange est sucré à point et le goût du cookie ressort légèrement!(mais je n''ai essayé qu''en divisant les proportions par 4...c''est-à-dire avec un seul cookie!).', '2006-03-22T18:35:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 6536ae46-642c-4f9a-93a5-10a79768c513, 'J''ai rajouté un petit peu de rhum et un sachet de sucre vanillé et j''ai mis les 3/4 d''une tablette de chocolat noir pâtissier Nestlé concassé au pilon, avec de gros morceaux, et à la cuisson, cela fond mais pas trop et c''est un délice ! A refaire.', '2024-03-04T10:35:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 1c913286-8f68-468b-9c0f-2bf88ad83032, 'Je ne vois pas en quoi la recette est trop sucré ou pourquoi certains disent que les portions sont pas assez grande pour rassasié 3 personnes. . J''ai respecté toute la recette, juste mis 80g de beurre au lieu de 100g, et le gâteau est parfait ! Tiède il est excellent avec le chocolat encore fondu 😇 chacun une part, un petit verre de lait a côté et le goûter a été parfait ! Et on était 5 😏🤔 On a peut pas tous la même habitude quand a nos consommations de gâteau ou de sucre 🤷😂 Mais honnêtement une part chacun nous a largement suffit, en respectant bien les quantités de la recette 😌 ', '2023-11-27T17:29:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, b93897d0-641f-4908-bd8b-f6c3e01660b5, 'Au vu des commentaires, j''ai mis 2 bananes, 110g de sucre et 80g de beurre. J''ai rajouté un demi sachet de levure chimique. 
J''ai mélangé le chocolat concassé et les morceaux de banane directement dans la pâte 
Cuisson 30 min à 180° dans des moules individuels.
C''était parfait ! ', '2022-06-30T17:38:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, ab54c1b3-420a-4448-ae08-f4584859c296, 'Mon gâteau préféré du moment ! Facile à faire et super bon :) je mets moins de sucre (80 gr), je mélange les bananes écrasées directement dans la pâte, je rajoute un sachet de levure et je soupoudre les pépites de chocolat en dernier. Trop bon ! ', '2023-07-09T14:30:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 7fc669f6-c2d6-4a09-8c34-e89b9217d5fe, 'J’ai testé pour 4 personnes mais comme d’autres personnes dans les commentaires j’ai légèrement réduit le sucre (100g au lieu de 120) et écrasé les bananes. Le résultat est super, on s’est régalés ! Attention à la cuisson cependant car si comme moi votre four est un peu puissant pensez à réduire un peu le thermostat (170 degrés pendant 45mn largement suffisant chez moi). ', '2022-03-22T18:13:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 9577cd88-b850-4100-ac98-314b7998869c, 'C''est un bon gâteau !! Mais malheureusement nous avons loupés quelque chose dans la recette donc le gâteau n était pas terrible. Mais si vous faites tous correctement, il sera bon! À refaire (sans rater).', '2022-12-10T17:57:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 4f0b7b74-f4da-45d4-9fd6-a15f6cc59502, 'Juste parfait !! J’ai mis 80g de sucre au lieu de 120 sinon j’ai tout respecté à la lettre, même le moule avec les alvéoles ... encore tiède avec le chocolat qui fond c’est un délice !!!', '2021-03-13T18:33:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 18236212-a6cf-4091-9f20-bb64f2e8a60d, 'C''était trop bon ! !!! !
( A part un petit probleme qui venait de moi parce que j''ai laisse trop longtemps au four )
C''était rapide, facile et DE-LI-CI-EUX
MERCI !!!!!!
Et pour tous ceux qui lisent ce message,
Continuez tous de mettre vos recettes sur marmiton !!!!
C''est super !!!', '2021-02-26T01:13:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, ebbf097c-a53d-4b13-9bcd-18655d8198c2, 'Un vrai bonheur !  ! Merci pour cette recette. Je ne sais pas si battre les oeufs en neige est nécessaire car le gâteau est bien monté à la cuisson puis est retombé. Ceci dit, cela reste un excellent moelleux. Je n''ai pas mis de sucre, les bananes et le chocolat étant suffisamment sucrés ! Si on ne veut pas mettre de beurre, on peut également remplacer par de la compote de pomme.', '2020-12-01T11:17:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 63584f95-78c0-4fd5-bd61-6754310fee35, 'J''ai suivi à la lettre la recette. J''ai juste mis la moitié d''une tablette de chocolat dans la pâte, et j''ai fait fondre l''autre moitié avec un peu de crème fraîche, pour la mettre sur le dessus du gâteau une fois sorti du four ! Un régal ! ', '2020-11-08T18:20:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, b6b506db-56dc-4cd9-9238-bce8545a609d, 'Excellent j ai diminue le sucre de 30% en rajoutant un sachet de sucre vanillé Tout le monde a adoré surtout tiède ', '2024-02-28T22:39:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, f624db5f-76da-4e7b-9ce1-eec2bc1bc1ae, 'Une tuerie ! ! On adore avec mon mari 😍😍', '2023-11-16T23:42:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 4449b37e-b73c-43fe-9c13-97c18a169b32, 'J''ai eu une frayeur en lisant les commentaires après avoir fait la recette (et un doute vu l''absence de levure), mais impec! Dans un soucis zéro déchet, j''ai réutilisé le beurre clarifié (blanc du beurre) pour beurrer le moule. Les indiens appellent cela le ghee il me semble! (A vérifier quand même !). J''ai mis un peu moins de sucre.', '2023-08-09T20:29:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, ab66fe33-4679-47de-ac6c-d354331e1d47, 'Excellent pour les amateurs de gâteau à la banane! N’hésitez pas à mettre moins de sucre et un peu plus de bananes. ', '2023-04-10T21:06:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, d109ab16-46db-4c84-8063-71f60575029f, 'Super bon ', '2023-03-13T23:22:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 4fb959ef-7934-4965-88d7-68aa7e634223, 'Gâteau 🥧 très simple à faire et très bon. J''ai juste diminué le sucre à 100 g', '2022-07-24T15:26:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, bf114eb3-4dc5-4c67-8b08-bd8904df18bc, 'Très bon, j''ai moi aussi faut quelques modifications, 100 g de sucre, 50g de beurre et une compote puis j''ai gardé du chocolat pour faire un nappage dessus, au top', '2022-07-21T22:35:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 26234739-3e07-4af6-982e-810bbd4cfeb3, 'Très bon, pour 4 personnes, j''ai mis 2 banane et 120 g de sucre ainsi que 50 g de chocolat au lait et 50 g de chocolat noir. J''ai mixé les bananes. Bonne journée à vous 😉', '2022-05-28T16:40:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, e0102ff6-94f5-4b5e-9662-c42aa347db3f, 'Ce gâteau est super !  J’ai aussi essayé pomme-banane et poire-banane et c’est toujours un délice.', '2022-04-24T12:52:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 722ca00f-39d8-48c6-a083-efba09fb241a, 'Alors. En prenant un peu de tous les commentaires... Plein de super idées... On l''a fait avec la moitié du sucre, un peu de lait, en écrasant la banane, et dans des moules a muffins. Et pour finir, un glaçage au chocolat sur le dessus. Super !', '2022-02-26T10:39:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 388bef0d-a77f-4f65-bb4f-ac02b124e057, 'Super bon. Je conseille de mixer les bananes et mettre 120g sucre au lieu de 150g. Je les ai mis dans des petits moules individuels.', '2022-02-12T13:13:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 9df4f2f0-ee21-4f04-95dc-ce8c8d2ec4d9, 'Un peu trop banane à notre gout. Testé avec 80g de sucre, c''est bien suffisant. ', '2021-12-21T18:37:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 62cf2b94-4374-455e-8e70-38f98195a8db, 'J''ai mis 3 grosses bananes et une tablette de chocolat, j''ai ajouté un poil de lait pour accentuer le côté moelleux. Vraiment délicieux, assez bouratif mais au top ! Je recommande ? ', '2020-12-06T14:35:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 41c0b5b9-e29b-4d8c-ac8d-307a5513c195, 'Gâteau trop sucré en ne mettant que 2 bananes et des pépites de chocolat. C''est dommage, je m''attendais à mieux vu les commentaires excellents.', '2020-12-01T09:26:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, dbe96156-bb57-4632-ab34-d46602f3dabc, 'Un délice !', '2020-11-25T18:51:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, d68b9ef4-33bc-48cf-a0b7-4a2b7fa8cc43, 'J''ai mis une plaquette de chocolat pour les quantités prévues pour 4 bananes et c''était délicieux !', '2020-11-07T21:42:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, da36ce1c-89c7-4c63-a9a0-54d8fc9e27c5, 'Mon gâteau à succès il est top ! J’écrase les bananes pour les mélanger dans la pâte miam !', '2020-10-13T22:21:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 31fcf93c-6b89-4c64-9313-2781484f8dd9, 'Résultat pas très beau Mais le goût est la', '2020-05-26T18:47:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 2905fc37-7b34-497f-bf79-987e2b495084, 'Recette faite telle quelle. Super bon. ', '2020-05-01T21:10:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 11d62119-c3c0-4e27-ab53-a11307cf31d0, 'Excellent ! J''ai juste réduit la farine et ajouté un peu de lait pour qu''il soit moins compact. J''ai fait cuire 30 mn pour un fondant parfait. Très bonne recette. À refaire absolument', '2019-05-13T10:36:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 6634d629-3efc-4227-ba59-5595eaf7ea41, 'Super recette même si un peu compact et prendre de préférence un moule à cake car avec un moule rond il est difficile de recouvrir entièrement les bananes. ', '2018-12-15T04:11:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 32044e2b-55c2-4b99-9c4d-d656ca64d8ab, 'Selon moi les proportions ne sont pas les bonnes. Il est indiqué un grand moule rond, et je n''ai presque pas pu couvrir les bananes (je n''en avais que deux pourtant). Mon moule pourtant est de taille moyenne et non grand. Et je ne l''ai donc mis que 20 min à cuire. Bien suffisant. Je réessaierai avec le double de pâte pour un gâteau plus épais et gourmand car il ne gonfle quasiment pas à la cuisson. Reste à gouter la première version.', '2018-11-25T12:08:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 4bc41430-e4b9-4cfe-82c3-9b99a1fb17f9, 'J''ai suivie la recette à la lettre. J''ai donc commencé à beurrer un GRAND moule rond. Tout au long de la recette je me suis dit mais ça n''a pas l''air de faire beaucoup de pâte ... résultat beaucoup de mal à couvrir le fond du moule !!!! Quelle barbe de recommencer une deuxième pâte avec laquelle j''ai encore eu bien du mal à couvrir les bananes et le chocolat.  Sinon au goût le double-gâteau est très bon il était très aéré, mais sur la deuxième pâte j''ai ajouté 1/2 paquet de levure l''envie de remonter des blancs m''ayant un peu quitté ! En résumé : Très bon gâteau mais une seule étoile pour les quantités qui sont au moins à doubler !!!!', '2016-12-10T17:23:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 04d7228a-d9e9-4996-b617-c72d72b5cfbc, '2 bananes coupées en rondelles, une tablette de chocolat passée au robot, 50 g de cassonade et 50 g de sucre blanc et j''ai ajouté un demi sachet de levure. J''ai ajouté les bananes et le chocolat à la fin dans la pâte. En suivant les commentaires, j''ai mis en cuisson 20 minutes. Résultat nickel, moelleux, suffisamment cuit. Je referai sans hésiter ', '2016-06-15T17:23:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 98fcfc83-951d-4a61-ac5f-46537ee5b42f, 'Avec 6 bananes bien mûres et une tablette de chocolat casée très grossierement mes collègues étaient a mes pieds !!! AHAHAH', '2016-05-08T14:19:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 8c7ce609-435a-4c6f-88d8-a9805281918c, 'Délicieux ! C''est devenu une de mes recettes préférées, avec juste un peu moins de sucre, et un peu plus de chocolat !', '2015-11-18T15:31:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, e6361f2b-8455-4fa8-999f-685d6fa3749a, 'Très déçu, la pâte est toute fine une fois cuite, sèche, et pas vraiment moelleuse ...', '2010-04-29T19:49:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 8ca8da77-900c-4d92-bd4d-23e5f3ffc6b0, 'Fait avec 120g de sucte et un peu de levure. Gâteau moelleux, aerien et plein de goût, il a fait l''unanimité à la maison, merci pour la recette.', '2023-10-22T15:41:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 30c1c83b-6290-459f-9eb2-4911ce30c5dd, 'Excellent à refaire. j''ai suivi les commentaires en mélangeant bananes  et chocolat à la préparation, levure 1/2 sachet.', '2023-10-16T18:48:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 9a60428a-b2de-4fa5-a9be-494a220b9f67, 'Recette facile', '2023-07-02T17:09:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, fc87197c-79ea-406d-854b-3684a66f880d, 'EXÉCRABLE ! gâteau imbibé de jus de beurre.  impossible à démouler.
Franchement j''ai l''habitude de marmiton mais la je suis vraiment déçue... ', '2023-05-09T08:05:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 046d0b3e-d851-4188-a089-b34b70b0e96d, 'La technique de superposition n’a pas marché pour moi mais sinon c’était bon! ', '2023-05-06T11:04:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 9bd7e02a-5a58-4f1d-aac5-2e6cf7ffe9f8, 'Très bon, les enfants aiment et parfait pour utiliser les bananes 
J’ai mis un demi sachet de levure. 
', '2023-04-20T17:11:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 3a6c8218-052d-4224-bc7e-aabdb04aa65e, 'Trop bon mais tout liquide au milieu... ', '2023-03-10T16:43:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, e7ca0763-da0f-4bd2-91cb-56e9fc75732f, 'Très bon gâteau ! ', '2023-02-16T16:20:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, c6d871f7-4f7d-4238-ba18-a57a2af4db17, 'Ici bananes/poires (écrasées façon purée) et chocolat mélangés dans un grand moule petit biscuit et j''ai mis un tout petit peu de levure pour le faire monter.', '2022-12-23T15:48:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 01290394-2465-445e-9c40-e869d87af10b, 'Très bon au gout MAIS utiliser un petit moule avec 300 g de bananes et peut-être ajouter de la levure, ici seulement 20 minutes de cuisson.', '2022-11-05T15:54:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, d0e2576b-b9c6-419c-b80f-1accb9574d22, 'Trop bon !!', '2022-09-25T21:03:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, a1bc6ba8-0cec-4b81-906f-7c4cdf2d4ed0, 'Très bon. J''ai mis que 100 g de sucre, c''était un peu juste malgré des bananes très mûres que j''ai laissé en rondelles pour bien garder le goût de la banane quand on croque dedans. On a tous aimé. Idéal pour consommer les bananes trop mûres que personne ne veut plus manger.', '2022-06-07T17:28:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, dbb78a91-98d1-4587-8d22-2be663085f53, 'Trop bon, à faire sans hésiter !', '2022-06-07T10:33:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 9b6b9afb-4df9-4440-9dec-26cfd2035943, 'Très bon gâteau, j''ai juste diminué la quantité de sucre. Il a été fini dans l''après midi. Un vrai succès !', '2022-05-27T06:50:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 9c84b214-b918-4bde-be56-a36066618e3e, 'J''ai mis moins de banane, mais c''est délicieux, merci !', '2022-05-04T16:15:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 5be918d5-1626-453d-9999-e1ac0c1700aa, 'Gâteau excellent, moelleux et savoureux', '2022-05-04T12:34:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 4240f876-c937-4811-aab9-22d782b8fa39, 'Juste incroyable, simple, bon et moelleux. J''ai une variante en mélangeant la préparation avec du chocolat fondu et des éclats de noix ❤🔥❤ perfect', '2022-04-27T15:55:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 18e60f7e-faf7-45d9-a8b9-e23dfaf1374f, 'Vraiment très bon, j’ai mis 80gr de sucre, avec les bananes ça compense. Tiède c’est encore meilleur ! ', '2021-11-28T23:27:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 4e0ffc4d-aa9e-4301-aa71-27bfd2f2493d, 'Super goût !', '2021-05-01T17:09:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, a80a9f4e-9d93-460d-b707-9b2631b2a449, 'Parfait ! Je diminue un peu le sucre car il y a le chocolat et la banane ', '2021-03-21T14:31:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, f77ba2ec-79f3-4bcb-9580-9675f56fbdc3, 'Excellent', '2021-03-08T21:45:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 3f933961-e4be-4183-8f10-8554a60e6bcd, 'Une délicieuse merveille ! Tous de suite mis en coup de coeur ! Ma famille entière me supplie pour que je fasse cette recette quand je dis suand je vais faire la cuisine ! ?', '2020-11-18T15:08:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32066, 56eb55f2-fc26-485f-bf9f-ef8c46240abc, 'très bon et très facile ', '2020-11-04T18:37:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, 418ac409-105f-4936-aba0-b12d0041830b, 'Beaucoup trop sucré. Temps de cuisson à rallonger. Plus de kiwi et moins de bananes. Pas top. ', '2013-04-29T13:10:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, 3097c137-55d4-46c6-b094-5671542e052a, 'Confiture surprenante et agréable comme goût. Pour 1 kg de kiwis, 1 kg de poires William et 3 bananes, j''ai mis 1 kg de sucre spécial confiture (c''est largement suffisant) j''ai fait 8 pots. c''est sure je recommancerai', '2013-04-16T17:33:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, f3e7990e-0615-4f39-b10a-13b68eafc9ed, '1kg de kiwi 
1kg de poire
2 bananes
2 paquet de sucre spécial confiture 
Fair bouillir le tout
Mixée 
Dégusté 
En tout j''ai fais 10 pots 
', '2020-06-02T23:55:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, c3eb79f6-4ad3-426a-9f0c-cbd8fa6c107e, 'Super original, super bon surtout!!! Effectivement, c''est un peu sucré mais en même temps c''est de la confiture; et après c est une affaire de goût ;)', '2017-07-25T20:48:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, 53a242a4-620c-450d-a687-585f9b5c569d, 'J''ai testé hier soir, et goûté ce matin un reste, elle est très bonne mais je trouve qu''elle sent trop la poire pourtant ce n''était pas des poires Williams. J''ai rajouté une gousse de vanille pendant la cuisson de 30 minutes. Il faut que je teste une confiture de poire pour voir la différence.', '2012-07-26T11:31:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, 2f61ecf6-3e8b-4301-a46e-9af991111be9, 'très bon, ca change un peu.', '2012-02-27T11:01:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, e4813092-bf02-4858-9a87-bfd05b3f8ae9, 'Très bonne, très appréciée de mes invités qui m''ont demandé la recette. A faire sans hésiter.', '2011-05-10T14:51:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, fc912a76-0727-4bc2-8592-61d6c4ebaa0e, 'Tout simplement délicieuse, à faire, à déguster et à refaire (avec un peu moins de sucre pour mon goût personnel). Merci beaucoup', '2010-10-17T16:56:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, fca1bfe3-4be6-4d7a-bcda-e1e6786aacf9, 'MMMM un vrai délice... l''association est top !!! Pas d''acidité,  belle texture !! J''ai néanmoins mis moins de sucre car mes bananes étaient très sucrées !! Saveur originale, au petit déjeuner, parfait !! A refaire absolument ', '2010-09-04T04:08:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, 43722b6f-2c71-4225-b2e5-2b9f90e70537, 'Très bon ! J''ai mis 1,5kg de fruits pour 700g de sucre normal la cuisson a durée 30 minutes, j''ai rajouté un demi jus de citron et une cuillère à café de gingembre ainsi qu''une cuillère à café de vanille en poudre.', '2010-03-10T18:58:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, 72f4a5ff-0e89-4ea3-820a-e84960d0d665, 'J''ai mis 1 kg de poires, 1 kg de kiwis, 2 bananes et 1 kg de sucre... C''est tout simplement un délice ! Merci pour cette superbe association de fruits.', '2009-10-05T17:24:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, eb6bcbd5-bc33-4dab-83b2-aa7016f1f1cf, 'J''ai mis 500g de kiwis, 300g de poires, 250g de bananes, pour 550g de sucre (250g de sucre spécial confiture, 300g de sucre normal). Résultat : une confiture onctueuse, juste assez acide, juste assez sucrée ; un régal le matin. Merci pour avoir eu l''idée de marier ces 3 fruits.', '2008-02-29T10:24:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, 7fb38541-9a5e-4e6b-95bd-43e8f5034fce, 'J''avais déjà fait de la confiture poires-kiwis, mais la banane rajoute vraiment de la douceur. J''ai mis automatiquement la moitié de la quantité de sucre indiquée, comme je n''aime pas les confitures trop sucrées.', '2007-01-16T22:12:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, 04740bf7-979e-44fb-af6d-6f2b52f9b3dd, 'Très bon, je l''ai faite avec du sucre semoule et un jus de citron.', '2006-10-08T11:42:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, 2307023f-ff45-46d3-9590-5d53adf16f24, 'Excellent...mais beaucoup trop sucré! 400 g de sucre suffisent amplement!', '2005-11-13T20:10:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, 57e9b008-00c5-46ec-8208-9b7baff47160, 'Recette très facile à réaliser, rapide et excellente. Peut-être un peu trop sucrée.', '2005-10-25T22:22:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, 50d7030f-cf7b-4c40-ae12-6b40d8d6c269, 'Un petit bijoux! Bravo.', '2005-10-09T21:39:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (36827, 87d9e26a-ec8b-4f16-a430-c97139676859, 'Très bon, les trois fruits vont bien ensemble, et c''est une recette originale. Par contre, le temps de cuisson est plus proche de 30 min que de 12 min!', '2005-09-12T11:20:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 0310c39f-d0f8-435b-a67c-8b80b7231ede, 'Dommage il n’y a pas la quantité de farine ni de levure …', '2022-06-08T10:39:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, c447a0b5-64d2-4bd4-a927-2adbaf64acbc, 'Très bon ! J ai mis dedans les restes du frigo: aubergine, champignons, sauce tomate, larfons et comté. Servi avec du mesclun', '2023-02-20T19:50:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 417cd123-5bb6-40de-bbe7-2726f1cee9aa, 'Cette base, c''est la base 👌🏻', '2021-10-07T08:18:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 02877f48-9cca-455f-b732-4e30f5cf5b92, 'Excellente recette, la meilleure de toutes celles que j’ai essayées. J’ai remplacé l’huile par 70g de beurre et en garniture j’ai mis 200g de jambon et du roquefort. Je viens de recopier la recette dans mon carnet Best Of. Merci !', '2021-05-08T22:50:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 1a9f5f0c-0be3-41d8-aaa5-f3325b0014cf, 'Ne rien changer ! Moi j''utilise de la farine complète. Je mets un peu de saumon fumé et un peu de chèvre en bûche. Excellent tout le monde adore.', '2019-11-26T17:03:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, ab1e4cbe-7e47-4e8c-be7e-5732d5872474, 'Excellente base, j''ai juste rajouté des lardons cuits et des olives vertes en morceaux, excellent !!!', '2023-03-14T17:47:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 3d6a8e74-bed0-4c91-8e24-718a99ba7b11, 'Top du top ! Excellent cake, aéré, léger, un délice ! Je l''ai fait sans emmental, ça ne manquait pas.', '2022-10-25T14:03:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, c701e78d-fd6c-4e2e-ab20-145d779050d5, 'Ma recette fétiche, et je varie les garnitures au fil des saisons. Ne pas hésiter à mettre de l’huile d’olive si la garniture s’y prête. Dans mon four je mets une quarantaine de minutes à 190°C sinon ça manque de cuisson.', '2022-09-12T18:04:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 0f13f23d-85a8-4d63-a320-0ed045bfe7a3, 'Très bon !                  ', '2022-06-07T12:28:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 48bb5045-4849-425a-87c6-6852813a8c87, 'Super base, texture top à plu à toute la famille', '2022-04-25T13:45:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 1c3cbfc4-cc59-4dd4-a2d5-258cf07f2d41, 'Excellente base, elle marche à tous les coups ! J''ai essayé la plupart des associations proposées et elles sont toutes très bonnes. Diminuer un peu le temps de cuisson quand les ingrédients qui la composent sont plutôt secs, l''augmenter quand ils sont plutôt humides.', '2020-10-29T17:59:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, a5550f1a-6b00-4e52-b4fe-fa5a2fad810d, 'Recette suivi a la lettre, idem pour la cuisson, il est pas sec et reste à peine 5mn sur la table vu la vitesse ou il se mange !
Pour ma part je fais chorizo chèvre origan et les invités en raffolent !', '2020-07-21T19:51:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, d4af8696-110c-47db-afc4-6840a40611b7, 'Cette base cake est géniale. On ajoute ce les ingredients que l''on veut. Tres moelleux et surtout pas sec', '2019-12-26T02:57:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 940818e8-f199-481b-9c5e-04ecd29e656a, 'Super recette aux lardons et pruneaux.  Je l''ai suivie à la lettre. Excellent !!! À refaire. Très facile.', '2019-12-19T01:19:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 35fe33a4-9288-4156-9a9c-98778fe6fd05, 'Parfait ! Cela fait 4 fois que je prends cette base devenue MA référence, elle est simplement excellente, merci Oriane !', '2019-10-28T02:27:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 44c79e4a-0b84-479b-9d6f-f3b44c0b35ed, 'Personnellement je ne mets pas d''huile, la plupart des recettes contiennent du fromage ou des lardons qui sont bien assez gras.
A la place du lait, je mets du vin blanc, et je ne mets jamais de sel : les olives, le fromage ou les lardons suffisent pour saler le cake.
Je les fais aussi dans des moules à muffin, pour un pique-nique.
A la place du poivre, je mets parfois du piment d''Espelette (pour la garniture 3, par exemple).', '2018-07-20T13:39:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, ea6f6576-2a67-4613-be84-d390053a6170, 'J''ai testé avec des lardons des noix et du roquefort c''était excellent !', '2018-07-14T04:31:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, b78d7e76-79cb-448e-9861-f8d637b609ed, 'La recette m''a l''air bonne, mais les proportions sont démesurées. J''ai fait pour "4 personnes" mais j''ai finalement pour 10 ! ça rentrait même pas tout dans 1 moule, j''ai dû utiliser un autre plat en plus pour mettre dans le four.', '2018-05-20T15:25:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, cfbd64e2-d9d4-49c5-8fc0-276690ea3750, 'Très bonne recette, nous avons essayé la garniture 6, lardons bananes pruneaux !! Géniale idée !', '2023-05-30T23:30:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, c44a3607-75b5-4c28-9fb1-83ce58d0908a, 'Super recette. Je m''en sers pour chaque cake en changeant la composition à ma guise. Succès assuré ! ', '2023-01-24T22:33:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, f812c1e6-b9ad-4a7f-8bdc-3f831d45e8c0, 'Perso pour les garnitures j''ai mis Champignon et Saucisse. C''était délicieux un peu fin mais bon. Merci pour cette recette 😁😁', '2023-01-19T17:31:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, f2b94430-1e4a-4fe5-9011-d8532098eef1, 'Très bon cake, ultra moelleux. Merci beaucoup ! Fait avec de la poitrine fumée et du munster. Cuisson de 40mn', '2023-01-19T12:41:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 484c2bbb-7041-41a8-b2b9-fcf74b5c2f60, 'Super base de cake salé que j''ai fait avec garniture brocoli bûche de chèvre et noisettes.', '2022-12-11T11:47:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 91746170-3232-4bbc-bc88-2f4003a4e4ab, 'J''adore !', '2022-12-06T09:01:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, d89d8837-5900-4600-b82f-36c6d1b18339, 'Un régal !', '2022-10-02T02:45:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 77465fb4-bcb0-4e02-ad6c-4aa31f12baae, 'LA BASE EST GÉNIALE, après c''est suivant les goûts, à chacun ses préférences.', '2022-09-10T17:09:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 5941fa0a-f7cf-4bd6-b083-5dbd9bb8f280, 'Recette parfaite ! J''ai testé plusieurs garnitures et c''est à chaque fois un succès !', '2022-04-18T09:26:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 732a559b-8f81-4142-a18f-6efa2c44baa2, 'Parfait!!!', '2022-03-19T10:42:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 17725f5b-3cee-42b7-8287-b503f777f73b, 'Base de cake parfaite . Trois minis cakes avec Garniture saucisses fumées / chorizo, trois poivrons / saumon frais, suprêmes citron jaune, crème et origan. Un régal ', '2022-03-18T23:44:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 72c4ea6d-33db-41bc-8090-3203ad287a3c, 'Recette de base parfaite.J’y ai mis des tomates confites et une bûche de chèvre en morceau, c’était délicieux. ', '2022-01-30T08:23:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 305362cd-6581-4ce6-ab8b-4106fb65bfb0, 'La recette est parfaite, j''ai testé avec plusieurs combinaisons de garnitures et à chaque fois c''est une réussite !', '2022-01-13T10:44:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, c733cd84-c0ef-4f3a-b1f1-89a210ff186b, 'Noix-bleu, lardons-pruneaux, poivrons grillés-graines de courge, macédoine... je ne me lasse pas de cette recette !! Merci !', '2021-12-26T11:30:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 09744b16-99a7-4e26-91fb-d2e626e2c707, 'Délicieux ! Moelleux à souhait. Mes amis m''ont félicitée et c''est pas souvent ! Je reprends gout aux cakes. Merci !', '2021-12-16T09:32:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 3a829428-b858-4864-a8c3-8efcbad28be4, 'Très bonne base, hyper moelleux, aéré et humide à souhait ! (je ne mets que du bicarbonate de soude à la place de la levure)', '2021-12-03T14:30:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 384a3d05-c3c4-40ef-b5f2-c91a22e2e9f7, 'Base épatante, cela fonctionne à chaque fois même en variant les ingrédients.', '2021-10-09T19:33:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, eb79671d-49b0-42f8-b5ae-8e532b0b2c4c, 'Recette parfaite pour faire n''importe quel cake, je recommande!', '2021-09-03T17:36:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, d3a42cd6-9ba7-4227-9424-66b1a36c35ac, 'Excellent ! C''est très facile voir très utile quand je suis pressée', '2021-08-27T13:26:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, b8776d4b-6f54-4ca7-b085-93a8bb6af10f, 'Je l''utilise tout le temps.', '2021-06-18T12:46:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 93ff022d-e31e-4bea-8e3c-d2b78fd217f5, 'Délicieux', '2021-06-05T22:22:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 3d055f35-c91b-478a-8272-3e21c6f18e5f, 'Je ne reussi jamais les cakes, mais vraiment jamais! Mais cette recette est parfaite, j''ai enfin reussi!', '2021-05-05T12:10:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 21949814-13ac-49db-8e17-3c61d20a0bfa, 'Hyper bon! Merci ! ', '2021-04-29T20:58:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 806cf674-5e65-42b0-aa94-bcb0eed3aad9, 'Recette parfaite et efficace. Permet des variantes pour la garniture et super pratique quand on veut faire plusieurs cakes à la fois.', '2020-12-06T21:49:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 65edfb4c-a552-4eda-b6ff-344545af7be7, 'Recette de base parfaite ! Je la garde!', '2020-11-28T14:32:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 4a13c6c7-e432-4b5e-ac62-7de0eac272b9, 'Trop bon !!', '2020-11-01T14:40:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 2ad77ed4-6889-4cdc-a2cf-7f8242c7344a, 'Excellentissime ! J''ai mis 10x moins d''huile et c''est un régal (garniture edam/mimolette). ', '2020-10-31T21:13:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, b33f5c52-d7dc-4320-9c43-d43f194ce7b9, 'Très bonne base, pouvant être adapté avec beaucoup d’ingrédients ', '2020-10-20T20:50:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 8ddf73bc-f770-469e-974a-831da1a173cd, 'Bonne recette, facile et rapide, merci.', '2020-10-07T20:43:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 140c2237-4d4d-427f-b4ba-3460a2289562, 'Base super', '2020-09-13T14:17:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, aabf79ba-4068-400f-be2f-0b628b0ed501, 'Bonjour,
Je vous remercie pour cette base de recette, je l''utilise régulièrement.. encore aujourd''hui avec un cake salé aux deux saumons (frais/fumé) et olives.
Il a fait l''unanimité.. impossible de vous partager la photo.
', '2020-09-06T14:46:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 7d3349f9-1888-42e4-b456-c3ba1aae68f0, 'J''essaie toutes les variantes et je fais mouche à chaque fois ! Merci
', '2020-08-31T10:55:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 08ad3e96-b677-40b7-bc1e-f0f62add620f, 'Infaillible: cakes épais, gourmands et ultra-moelleux!!! Finis les "étouffes-chretiens" insipides! C''est LA recette!', '2020-08-21T18:29:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 387856ef-2d34-490b-a84b-1df5c749475b, 'La base est simple, ensuite il faut juste l''agrémenter de divers ingrédients,  ici pour moi cake jambon/olives et fêta à l''échalote et origan', '2020-08-21T18:21:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 7a07bdf9-8255-4049-af41-2772f2c53696, 'Superbe recette. Je n''ai pas utilisé les propositions de garnitures. J''ai inventé par moi même. J''avais des restes de légumes pour faire une pizza végétarienne. Je cherchais des idées pour le repas. Recette super simple, on a adoré ! Merci !', '2020-08-13T20:16:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, ba54b840-fd45-4cf9-acbf-b1fcd95e80c8, 'Top, facile, savoureux et pour tous les goûts !', '2020-07-30T11:08:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, ecef762f-21b5-4b61-946f-9066da3656e3, 'Excellent ! Je recommande ! De mon côté j''ai fait avec les restes du frigo: Des lardons, de l''emmental, du roquefort et des knackis... Pas très diététique mais très bon !  !  !', '2020-07-19T17:08:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 67480cb4-2331-4e54-a7c4-bba8e2bc5b26, 'Recette parfaite ! ', '2020-07-18T21:35:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 8e85b391-cd8e-4565-8e46-992f91bb7826, 'Excellent, pas du tout sec, merci !', '2020-06-28T15:52:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 0d70f8b3-d98f-49f6-9aba-39d80fb0d94f, 'un vrai  délice', '2020-06-08T00:15:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, ed137a94-d370-4f30-afa2-1e34cbcca3cf, 'Excellente base ! Faite avec plusieurs garnitures, un succès garantie. Par contre je mets à cuire une heure pour les quantités de base et je dirai que ce sont les bonnes doses pour 6 personnes. Merci pour cette recette.', '2020-06-06T17:33:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223949, 46a5d846-cf96-4788-af5b-4383576d5cc1, 'Excellente recette que je fais depuis 2 ans avec différentes variantes, c''est toujours très bon ! La garniture de base est parfaite, les proportions sont bonnes.

Merci !', '2020-06-02T13:44:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 66344478-2c60-4c75-8c45-8f5fcbed7cdc, 'Je n''avais que du fromage blanc sous la main, j''y ai ajouté de l''arôme liquide de vanille. Je l''ai mangé avec des céréales. Ca fait un petit dej'' bien vitaminé et équilibré pour attaquer la journée! Et en plus c''est délicieux!', '2016-02-25T16:44:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 30762751-3c20-45b8-aba5-8223f74e604c, 'UN délice !!!! un activia vanille et pour moi  un fond de jus d''orange 100% fruit pour le rendre un peu plus liquide et 1/2 cuillère à café de miel !!  ', '2016-01-24T00:40:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 040d0144-af81-4899-972d-7c0e86c80c4c, 'Facile à faire, il ne faut pas ajouter de sucre car c''est naturellement très sucré. Je l''ai mangé avec des amandes. On peut aussi ajouter des framboises ! ', '2016-03-23T19:43:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 3f325989-9a27-4d81-bb94-1533a912a98d, 'Très bon ! Et pour varier les plaisirs, un yaourt au coco ! ', '2016-01-24T01:54:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 40e60e87-2b40-4e10-970e-0ea2d418de95, 'Vraiment délicieux ! N''ayant pas de yaourt type "Perle de Lait", je l''ai remplacé par un yaourt nature auquel j''ai ajouté un peu de crème, c''est tout bonnement divin ! La banane et la pomme rendent ce smoothie très rafraîchissant ; la pomme utilisée est une "granny", ce qui a donné une légère touche d''acidité', '2015-07-26T17:41:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, cc83338f-40cc-4497-9bca-5cdffe676fe5, 'Extra ! A servir bien frais en apéro par exemple. J''ai décoré le verre avec du sirop de grenadine et du sucre sur le bord (tremper le verre à l''envers d''abord dans le sirop puis dans le sucre) et une tranche de kiwi. Par contre, en apéro, les quantités sont prévues pour 8 verres, sans quoi cela représente presque un repas complet...', '2009-04-07T13:03:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, a7730225-7e40-4142-9805-3dd21341d004, 'Délicieux !', '2023-10-08T15:29:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 1061bd6e-03f7-4c84-8e99-161ae835d009, 'J’étais un peu septique du mélange mais en fait très bon !', '2023-10-02T20:55:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 1b8a54a5-d22b-4ee4-9be5-547e1e7ce18a, 'Très bon !', '2022-11-02T21:33:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 7114a485-f69b-497b-b29e-a5b7603aa2a2, 'Bonne idée. ', '2022-05-31T13:23:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 06fc12cc-3fc0-4406-b2bd-47a7361d70ba, 'J''aime bien !', '2022-02-28T16:12:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 6350419a-b7aa-47e2-b0e1-3d3d366606fa, 'Très bonne recette, rafraîchissante et fruité, j’approuve ', '2021-11-30T21:03:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 22e7a651-04a3-4896-8e91-bad5a03e522e, 'Super bon gout ! J''adore ! ', '2021-01-26T22:56:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 565b08fc-431e-4828-b920-f9eb8e3f8570, 'Je l''ai fais avec des danettes et ça passe ! Un peu trop épais par contre ', '2020-07-14T14:10:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 2a7e3995-fa46-4659-bdef-d808c96cb933, 'Excellent ', '2019-08-19T06:00:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, d11c3641-1a4d-47d9-b28f-e7ff11a591b3, 'Très bon ! Je vais continuer à expérimenter avec les ingrédients mais la base est déjà super.', '2019-03-27T22:10:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 6af87f5a-2f40-453a-9e0e-d4b760ffadb7, 'Super bon ! Un succulent goût de banane! La dose est bonne pour une personne ', '2017-02-23T18:06:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 4f4e5661-23ea-4427-a0a4-497036410cd6, 'Au goût parfait mais même en mixant 10 min pas moyen d''obtenir un mélange lisse ! Je le recycle en glace on verra ce que cela donne !', '2015-07-21T20:18:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, b538a787-e3d9-4588-ac88-2ef7707be81a, 'C''est super, trop bon, rien à dire, j''adore ', '2015-07-20T21:45:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 56319426-06a2-4dad-8375-349a8fd9d461, 'Fait en 2 min! Et très Bon!', '2015-05-26T20:19:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 17d51fa6-2861-434f-bada-f8e6d5d45162, 'Facile et bon, je vous conseille de rajouter un peu de jus d''orange et du sucre vanillé.', '2015-05-09T12:00:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 5882ec5f-948d-44d7-8921-da05d66405d4, 'Super, c''est bon c''est simple j''ai à peine 12 ans et j''ai réussi à la faire je vous conseille aussi le smoothie kiwi', '2015-03-25T00:50:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 9947bac7-4c1b-476a-b16f-ff09b53606e6, 'Un délice, j''ai mis un yaourt nature et un peu d''extrait de vanille liquide... Trés bon et trés vitaminé !!!', '2015-02-04T16:18:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, dca740e2-1aad-4ece-baed-6442ab6433ea, 'J''ai remplacé le yaourt par un peu de lait écrémé sans ajouter de sucre : cela reste délicieux.', '2014-03-27T07:22:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84545, 0d511ff9-0158-4fec-a375-0f22ae21a67b, 'Très bon et simple, plein de vitamines. J''ai ajouté une pincée de sucre car mon yaourt était nature non sucré et il faut mixer un certain temps pour ne plus avoir de bout de pomme.', '2009-04-23T19:26:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (233179, a6e3fec9-0891-4fe7-a652-16552b07674d, 'Très bonne recette. Il vaut mieux laisser cuire 30mn plutôt que 20.', '2016-10-30T13:55:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166070, b3b2a10d-6588-47d3-aa94-66176260d377, 'Super bon !!! Merci pour cette recette ! J''ai ajouté un peu de lait et de sirop d''agave. A la place de la mangue, une compote pomme-mangue, et à la place du jus exotique, du jus d''orange. Un classique !', '2014-12-29T22:25:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (166070, bd21ef6b-5dfa-4fff-a7ad-85725ce3cac1, 'Tout simplement exquis !', '2011-10-05T19:25:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18338, 1ce57bb3-1785-4165-b2cc-c76772d4b424, 'Il ne faut pas trop exagérer avec la moutarde...', '2002-09-24T16:40:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69411, f6342fe9-8d2a-4d9a-9d31-73089ef854ec, 'Je l''ai trouvée trop sèche. ', '2012-07-28T09:44:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69411, 46776b35-1661-4c5b-bba4-c8a55ba08817, 'Joli et plein de goût, je n''avais pas de fromage blanc, donc je m''en suis passée. J''ai aussi ajouté une demi-pomme sur la tarte. Réussi.', '2012-05-09T11:54:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69411, 2515b4f8-23ae-43ed-aeb8-24c1c876672b, 'Ma tarte n’était pas cuite, déçue.', '2012-04-22T14:23:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69411, 1d13da2b-7d64-4f62-baa2-38818ddb99e0, 'J''ai mis du papier cuisson comme c''était une pâte déjà prête. Tarte meilleure chaude que froide.', '2012-04-15T15:04:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69411, c52124ed-63b3-47c5-9e93-1e87b2575f57, 'Même cuite à blanc, la pâte était quand même un peu détrempée !', '2011-03-20T22:01:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69411, f69eb55a-b5e0-4f6f-af1a-b978f1d196c8, 'Délicieuse, originale et belle présentation. Je n''ai pas cuit la pâte à blanc car je l''aime lorsqu''elle n''est pas trop cuite. Donc si vous l''aimez bien cuite cuire 20 min la pâte avant de la garnir.', '2010-04-03T13:58:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69411, c9deeb69-612d-444b-ac63-9d0d5618f12b, 'La tarte était bonne au goût en revanche, il aurait fallu cuire la pâte à blanc car la crème l''a ramollie et le fond n''a pas cuit.', '2009-03-11T16:11:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69411, 2bd3c340-46d3-4f8b-b299-28142707da64, 'Très originale et délicieusse.', '2008-04-18T15:46:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62261, 1fdefbfd-ae1b-4c2d-8677-78e55a6e82d1, 'Très frais , j’ai rajouter un peu de menthe et de sucre au top 👌', '2021-06-13T19:43:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62261, 12b1a839-a53b-461a-92a8-7fd6310b10ee, 'Excellent. Pour en faire plus j''ai doublé les doses sauf le citron pour que ça ne soit pas trop acide. Réalisé avec des pommes golden car je n''avais que ça. Tout le monde s''est régalé, c''est sain frais et délicieux! À faire et à refaire. ', '2017-07-13T00:37:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62261, 1b3e0fc9-83c3-43ea-8e90-24141e195017, 'Pour ma part c''était assez sucré, cependant ça manquait de "smooth" pour un smoothie. Je l''ai donc coupé au lait de coco et là c''était carrément extra !', '2013-07-06T22:05:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62261, 08fa511a-8682-46f5-85b3-d138373efc6d, 'J''ai adoré, c''est rafraîchissant, mais pas assez sucré.', '2010-06-02T16:05:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62261, 8fcacd4a-583e-4e66-9fc3-d9720bbd0d16, 'Très frais, mousseux, acidulé. Ma fille et mon mari ont adoré.', '2008-05-28T18:10:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, fe18a81d-5444-4394-922c-b87f8deb5d24, 'J’ai une question par rapport aux quantités. Ex pour 15 personnes, les quantités indiquées, c’est pour 1 verre par personne et basta? Ou il y a de quoi s’en resservir? Ou faut il que j’indique pour 30 personnes pour être sûre que tout le monde puisse en avoir 2 verres?', '2019-09-25T08:35:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 3ae5de35-c68f-4eea-bda0-3d881eb2eb63, 'Fait 24h à l''avance. 

C''était très bon, en revanche, comme il n''est pas précisé la quantité de la bouteille.. j''y ai mit une bouteille de 70cl et ce n''était pas suffisant. On ne sentait quasiment pas le rhum. Sachant que j''ai pas pu vidé tous les jus car ma fontaine fait un peu moins de 5L, j''imagine qu''en mettant tous les jus, c''est encore pire. Prévoir minimum 1L de rhum. 

Je pense, qu''il est meilleur fait à l''avance car goûter le jour de conception puis le jour de réception. Et c''était bien meilleur le 2eme jour ! ', '2023-05-05T16:01:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, e171bdd5-0208-47e5-94ef-afa65cf254e4, 'Cette recette de punch est parfaite ! Je l''ai faite pour un nouvel an en triplant les doses car nous étions nombreux, génial les invités ont adoré et moi aussi !', '2016-03-06T16:23:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, be557919-d94d-4eaa-af24-8d5f970c3d37, 'Cette recette est parfaite ! Je l''ai faite pour environ 80 personnes en multipliant les quantités et elle a fait l''unanimité !!! j''ai remplacé l''abricot par du jus de banane et fait moitié-moitié de jus de mangue et de goyave . au top merci !!!!', '2015-09-22T22:49:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 6a6778e4-b5f1-46d6-8281-1d63ca74e823, 'Avec un peu de cannelle, de la vanille, un peu de grenadine et du citron vert, un régal !! Mettre au moins 75 cl de rhum.', '2015-05-23T09:49:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, ccf28101-aee1-43b9-b6b6-87321bfbc125, 'J''ai suivi les avis et mis une bouteille de 70 cl de rhum. Je n''ai pas mis les bananes (pour cause d''allergie dans la famille) et les ai remplacé par des morceaux de kiwi et d''oranges, et j''y ai ajouté une gousse de vanille. Fait 48h à l''avance, tout le monde a adoré. Nous étions 15, et nous avons eu 3 bons verres chacun. A refaire.', '2011-08-21T22:59:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 3c751b0e-0a0c-4718-81cb-2dbb8bb8de66, 'Super recette, j''ai ajouté du rhum et mis deux bâtons de cannelle, top 👍', '2022-06-26T20:08:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 48829d6d-f0af-499b-8656-4852c8afd288, 'Trop bon', '2022-03-03T18:22:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 4e8bf6b1-9161-4f9c-9658-f4e57d25112f, 'À la place du sucre de canne j''ai mis du sirop de fraise magnifique', '2020-12-15T12:56:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 763de6b2-8f80-41bc-96bd-4059f60433ac, 'Recette simple, j''ajoute simplement 2 bâtons de cannelle et quelques clous de girofles.', '2019-09-20T17:07:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 369c2593-b33f-4171-b5c0-d27124960376, 'Je le fait à chaque soirée et à chaque soirée tous mes invités se ruent dessus. C''est à peine si j''arrive à m''en servir un verre. Recette superbe !', '2019-06-06T09:35:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 085de816-e0a7-4aa2-8329-1c2cff147644, 'Très loin de la vraie recette, même le nom n''est pas bon telle qu''elle est présentée il s''agit d''un planteur et non d''un punch.', '2019-03-10T20:14:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 655254a5-c1b7-4ba8-88bf-c0330f29ea65, 'Excellent ! Mais même avec 70 cl de rhum, on ne sent rien. La prochaine fois je mettrait 80 cl.', '2019-02-17T14:29:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 6f88d056-df23-46e6-af70-2a63be0d4f60, 'Excellent mais j''ai ajouté un ananas et 2 oranges en morceau ainsi qu''une gousse de vanille et laisser 5 jours au réfrigérateur !', '2018-10-09T21:20:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, e8924dfe-9daa-49a2-a901-ad69a2560de8, 'Mes invités ont pensé que je leur servait un délicieux cocktail sans alcool... Il était cependant très bon, donc je referais en augmentant le rhum !', '2018-04-04T21:57:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 2b93db7a-5846-4ccf-b264-36e5b7119f44, 'Un vrai délice !  !  !', '2017-10-08T14:52:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 6067be43-5e50-4222-bf84-eb03c2964687, 'Mettre plus de rhum (75 cl).', '2017-09-22T19:37:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, b1985fea-2fdc-4ee7-a081-d9b5018846e7, 'Rien à redire, on ne peut pas être déçu. Juste deux variantes : je coupe les bananes en tout petits dés et surtout, le must (pour moi) je râpe 1 fève de Tonka (pas plus, c''est puissant) pour 5 litres. Ça relève le punch d''une délicate saveur épicée. L''essayer, c''est l''adopter.... pensez à vos salades de fruits ', '2016-11-28T21:58:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, b35db6df-09e4-4daa-b10f-aaa2f4837b8a, 'J''ai mis une boîte de litchi au sirop, 1 boîte de pêches, jus de mangue, orange et ananas. Un régal.', '2016-06-10T22:50:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 1e5ed717-fe59-4d33-bd91-caf903dcad31, 'Classique, mais rudement bon!', '2016-05-14T01:50:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 1172d06c-b977-4768-b965-d8f6fd9ad12c, 'Super ! Par contre j''ai mis la moitié des bouteilles de jus de fruits, pas un litre entier, et un seul verre de sucre de canne. J''ai ajouté une gousse de vanille et 2 cuillères à café de cannelle, c''est vraiment très bon.', '2016-03-17T19:53:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, a5a5c9de-019f-4cbb-8a77-d31507d1ad6b, 'Je l''ai fait hier pour mon anniversaire, j''ai mis 1 L de Rhum, et au lieu des bananes coupées j''ai mis 1L de jus de banane ce punch est au top à refaire.', '2015-08-16T21:02:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 93b9d42f-1c94-430c-8737-379a93f05d1c, 'Je l''ai fait, excellent, rien à redire', '2014-12-06T21:29:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 9125299d-ea42-455f-b91d-bb87895fa176, 'Très facile, rapide et un bon goût. Avec plus de rhum comme conseillé dans les commentaires, gousse de vanille et grenadine ! Un délice !', '2014-11-15T21:51:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, aab9c180-3e53-4c66-9e9e-4e68ab82bdfc, 'Il est excellent et facile à faire. J''ai également utilisé du multifruits. ', '2014-11-01T19:27:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, ad5d6651-87a2-49c3-b7a5-5488c1fe7285, 'Je l''avais essayé avec du rhum blanc 1/2 litre et en effet on ne sent rien. J''ai réessayé avec du rhum ambré et là il était excellent. 1/2 litre suffit', '2014-10-11T23:39:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, ba2985b7-952a-4a92-9760-2ea5665451f5, 'Avec de la cannelle, succulent !!', '2014-10-07T19:29:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 841761b9-951d-4bb8-88ae-dcb4ff0df31c, 'Sans banane et une bouteille entière de rhum c''est nickel ', '2014-09-19T14:56:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, e5029492-ce8c-4c38-9f5b-8a1f5e23d99b, 'Super ! J''ai mis plus de rhum sinon on ne le sent pas.', '2014-08-05T21:48:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 6259a737-0cda-479e-9db5-19d4deaf5f6f, 'Parfait, n''ayant pas trouvé tout les jus de fruit, j''ai utilisé du multifruit', '2014-07-22T21:49:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, fc7a7609-70a1-4efa-83ab-ba428032bc05, 'Parfait, par contre il faut mettre au minimum 75 cl de rhum blanc.', '2013-10-06T16:59:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 3e81c5b1-0212-4ffc-8171-7b8739572f82, 'J''ai mis 1 litre de rhum, j''ai ajouté un bâton de vanille, une pincée de cannelle et un filet de grenadine ! Très frais, très bon !', '2013-09-24T22:29:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 0918bc01-2407-42ca-a0af-82e3f278a3e4, 'Excellente recette, cependant, pour sentir le rhum, j''ai mis plus d''un litre. J''ai aussi ajouté une gousse de vanille... ', '2013-08-11T20:05:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, a28e4052-ff71-4de3-8a6d-d86c2559a305, 'Très bonne recette, pas trop alcoolisé, malgré que j''ai mis un peu moins de jus de fruit et un peu plus de rhum. Tout le monde a adoré.', '2013-08-05T11:40:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 3a06cd64-9ca8-4516-9eb0-7aeff401c55b, '75 cl de rhum, une gousse de vanille et quelques fruits en plus : un régal !', '2013-07-17T17:53:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 543bcc87-ac9b-4073-9650-d9e6347385fb, 'Ajouter un peu d''extrait de vanille, des oranges et des kiwis et il sera encore meilleur', '2012-09-07T17:57:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 93f14b0b-015d-4eb1-8498-744a012df47b, 'Punch délicieux ! Goût exotique et velouté qui a plut à tous les convives ! J''ai mis une bouteille de 1l de rhum blanc et j''ai ajouté du litchi. Je l''ai préparé 2 jours avant pour que les saveurs se mélangent bien entre elles et mis des fruits (pommes, kiwis, oranges) la veille afin qu''ils ne se flétrissent pas mais qu''ils prennent le goût ! ', '2012-07-31T15:41:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 1f834514-6524-49a0-9fd8-0a5bbf90354e, 'Il a fait l''unanimité. En revanche, j''ai mis un peu plus de rhum (70cl).', '2012-07-08T11:27:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 713b1887-3664-4294-a36b-44c5bb6100e1, 'Parfait; pour ceux qui ne sont pas trop alcool, le rhum ne se sent presque pas...', '2012-06-11T23:33:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 72e7239b-235a-405e-bed3-9b5e1fb1e8bb, 'Très bon, mais trop léger en rhum. Moi j''ai mis 75 cl. Je fais ce punch dès que j''ai l''occasion. ', '2012-06-04T10:57:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 3d4031f9-1fcc-40e2-8d92-616682ee6591, 'Très bonne recette. Devenu un incontournable lorsque je fais une soirée. ', '2012-05-23T21:32:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 8f773a95-5cd0-4610-b512-f72f348dd326, 'Très bonne recette, rien à dire, tout le monde s''est régalé', '2012-03-18T15:20:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 439bb1de-8eff-41db-9ad1-0a41db3f7f78, 'Je l''ai fait mais 48 heures à l''avance et j''ai ajouté des morceaux d''ananas et des cerises rouge vif dénoyautées. Au moment de servir j''ai mis un litre de limonade, un délice ! Tout le monde en raffole !', '2012-01-06T18:54:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 940a8418-5fea-415a-ad4a-12ff2970226e, 'Fait sans bananes et avec une gousse de vanille en plus. J''ai aussi ajouté 1/2 l de rhum pour une recette doublée dans les quantités. Un super apéro pour 30 personnes.', '2011-05-04T18:38:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 51d6220e-e8db-4827-b5b6-c5d0fce01ce6, 'Très bon, j''en ai fait 10 l (apéritif pour 35 personnes) et j''ai utilisé 2 l de Rhum en tout, préparé la veille et servi très frais c''était ni trop, ni trop peu ! Merci pour la recette ! ', '2011-04-13T11:22:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, efb6a03f-ea3d-4884-930c-12382437f3b4, 'Très bon effectivement léger en rhum, moi aussi j''en ai ajouté en tout une bouteille 70 cl. A fait l''unanimité !', '2011-03-08T22:01:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, aef5ae22-182b-4cef-b2b5-31fac47e7946, 'Trop léger en rhum, j''en ai ajouté (une bouteille de 75 cl) et de la vanille aussi (une touche). J''ai supprimé la banane car je n''aimais pas l''idée de morceaux de fruits dans une boisson. J''en ai fait pour une quinzaine de personnes, et ils se sont resservis trois fois ! Délicieux !!!', '2010-09-05T22:51:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 63069c29-59a9-414b-b631-1861f762dfd7, 'Très facile à faire mais trop léger au niveau rhum. J''en ai ajouté !!!', '2009-08-09T12:31:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 55766f7e-a55d-4cdc-ae34-1807328e6b98, 'Excellent ! J''en ai fait pour 40 personnes et elles ont toutes adoré !', '2008-12-12T12:21:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, c28da475-f8c2-4a2b-9434-8f423a48b33f, 'C''est excellent et super simple! Si vous ne trouvez pas de jus de mangue, vous pouvez ajouter du jus multifruits, c''est tout aussi bon!', '2008-09-24T19:14:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, b5d9b515-9f38-4a4b-82a3-a40e24efb027, 'Cette recette est excellente!! Je l''ai faite pour mes 20 ans et tout le monde a adoré!! Merci beaucoup !!', '2008-07-11T16:04:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 42e07626-536e-4b3e-af4f-a674e9fa6848, 'Tout simple et excellent!! Rien à redire!!', '2008-07-10T11:47:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 72c1293b-0937-457e-9865-d6da9adab044, 'Délicieux ce punch! Comme nous étions une quinzaine, j''ai ajouté d''autres jus : goyave, passion et cocktail exotique. J''ai mis du rhum blanc, du rhum vieux et du rhum arrangé aux épices (il me restait des fonds de bouteille), un peu de sucre de canne et des fruits frais (ananas et pêches). J''ai laissé une semaine au frigo et tout le monde a adoré. A refaire!!!', '2008-06-18T23:20:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 2ac71edc-cd78-425a-83f7-a90e2d85cea3, 'Ce punch était délicieux!!! J''ai rajouté du jus de citron vert, de la canelle, de la muscade et un peu de vanille, un régal! Plus il a le temps de macérer meilleur il est. J''ai doublé les quantités et ça a été tout juste suffisant pour une quinzaine de personnes. Attention ça se boit très très vite!!!', '2008-01-24T19:08:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 2567a629-d32f-4479-9e25-a260b80eb8eb, 'Parfait avec un peu plus de rhum (75 cl). Je préfère le faire quelque jours avant, ce qui rend ce punch encore meilleur!', '2007-12-30T11:32:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, cf3c7f55-d9fc-4f47-9ee1-85481583b385, 'Très léger voir trop léger. Très bien pour ceux qui aime un apéritif léger. Ajouter un peu plus de rhum il n''en sera que meilleur. Je l''ai préparé 2 jours à l''avance et rassurez-vous il y en a au moins pour 25 personnes avec cette recette car j''ai pu le servir 2 jours en ayant une tablée de 10 personnes buvant ce cocktail.', '2007-12-12T22:23:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 9876956d-90e3-47d6-9c37-92b04f164e5d, 'Gouté et Aprouvé! :-@ Très bonne recette et très facile à réaliser pour les grands groupes. Mes invités ont beaucoup aimé (et pas que par politesse je le garanti). ', '2007-11-12T18:32:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 673465a3-3891-4fd0-9a43-b110651a590b, 'Un délice, facile à faire pour un grand groupe à l''occasion d''un anniversaire. Pour ma part j''ai rajouté, du citron, de la mangue, clou de giroffle et un peu de rhum brun', '2007-10-03T19:36:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 97ee13a8-f78d-49e6-9f4a-1f42e0592027, 'Nous avons servi ce punch à notre mariage et cela a été un franc succès... Ma petite cousine se marie dans un mois et m''a réclamé la recette !!! Pour ma part j''ai supprimé les bananes mais ajouter un peu d''extrait de vanille et une pointe de cannelle. Peut être préparé plusieurs jours à l''avance.', '2007-07-06T20:35:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26610, 9e2ef8bb-0cc7-4926-a96e-ad2a90f9b0a5, 'Très facile à faire. Préférez un mix de rhum blanc et rhum ambré pour plus de saveur!', '2006-12-30T01:04:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335758, e56da88e-cea6-4019-ab8b-b999e6d37cfc, 'Très simple et très bon Merci ', '2021-02-13T18:48:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335758, 8563c5e3-8e87-4162-a6d3-77ba1794711b, 'Simple, rapide et surtout excellente. Perso je divise par 2 la quantité de sucre ?', '2020-11-08T10:34:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335758, 7df8470c-5590-4ac1-acb6-eb97f46594cf, 'Savoureuse.', '2019-09-30T05:42:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (27846, 89de8317-62fc-4167-934f-7e475b870766, 'Un peu bourrative mais bonne. Je ferai moins de nappage la prochaine fois. ', '2004-04-12T10:56:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 9f1de890-84f9-45ff-88ce-7c8788d44286, 'Un délice !', '2018-04-28T15:26:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 3a2d26e4-f5f1-477b-b07d-91afa7dcbc61, 'Il manque le goût de chocolat mais sinon niquel', '2017-01-20T15:20:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 94efa7dd-713a-42f2-a524-1225ed1a4ea3, 'Très facile, rapide. Ma fille en raffole.', '2016-01-19T18:03:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 39417127-fb1b-41e0-9a34-bf510df498e9, 'Trop bon et facile ', '2015-10-11T20:40:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 9773bdb2-0a58-4ce0-9d25-02bea3f165ad, 'Très bon, léger, aéré. ', '2013-04-03T20:16:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 6b38884d-b171-43f2-abf6-0bff8458fdcb, 'Super recette, facile à réaliser et bonne. Ça m''a bien sauvé la vie ! Par contre, 25 min de temps de cuisson à 180°C ont largement suffit. On peut y ajouter 25 g de noisettes aussi.', '2012-04-28T20:20:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, a4a9a562-9f85-4186-bceb-a53b9a09202a, 'Très très facile à faire ! Même pour une piètre pâtissière comme moi. La prochaine fois, je réduirai les doses de sucre mais franchement pour une petite envie de gourmandise, c''est top : pas besoin de courir chercher les ingrédients, c''est du basique.', '2012-04-14T13:24:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, c13e6ffe-2dad-48df-a49b-e9999c0699dc, 'Fan de banania, ce gâteau est très banania et très facile à faire... un délice ', '2012-02-23T17:49:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 274f0738-c2c6-484d-949c-2397e54fffa5, 'Gâteau moelleux et pas trop sucré. Très simple et rapide à faire. L''ai préparé avec de la poudre chocolaté standard et ai ajouté une bonne cuillère à café de levure chimique. Un régal !!', '2011-12-28T17:05:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, fe66ec25-7970-4256-8499-7ae40268bd23, 'recette suivie à la lettre et ce gâteau est vraiment excellent. Merci pour cette bonne recette', '2011-12-19T14:02:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, fd4f82d8-b1d2-4f96-91c8-9055423a94ea, 'J''ai suivi la recette à la lettre. Gâteau rapide à faire et qui n''est pas écœurant.( pour les moins gourmands de chocolat ! ) . Je l''ai fait une 2ème fois en remplaçant une partie du sucre par de l''édulcorant liquide, et c''était très bon aussi.', '2011-12-12T15:38:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, c38ecaa1-3a7b-44aa-90e5-f2ad4452b09b, 'Le gâteau est bon, texture un peu fondante. J''ai mis un peu de levure. Très rapide, parfait. Merci pour cette recette que je vais garder précieusement pour les goûters.', '2011-04-02T11:36:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, b2f92896-c875-459d-909e-7e644ca4e9be, 'Ce gâteau a un goût tout à fait acceptable, on sens bien le goût du banania (attention pas de chocolat) mais c''est la texture qui m''a le plus déplut. Il est un peu élastique, très dense et tout plat... Il ne monte pas du tout alors que la pâte était très aérée...', '2010-04-14T18:20:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 865d4231-382a-4948-98ed-fa5fbfd19367, 'Bonjour à tous, je n''ai pas encore fait ce gâteau au chocolat Banania, mais je vais le faire dès demain et je suis sûre qu''on va se régaler ! Merci à toi de nous avoir donné cette recette si facile à faire ! A bientôt !', '2009-05-21T22:34:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 34bd0932-6a36-42f1-9bb3-6936f8c88777, 'Rajout d''un demi sachet de levure, enfourné a four froid puis cuisson 25 min à Th.7 puis 15 min à Th.5 Résultat : cuisson parfaite. Réalisé avec mes 4 filles de 5 à 7 ans elles ont adoré.', '2009-03-25T19:11:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 8d3998a0-6514-4d7a-a624-73f100a1d27e, 'J''ai suivi cette recette à la lettre et mes convives ont a-do-ré!! Recette très simple et succulente. Merci!', '2009-01-27T13:45:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, a68154de-6b7f-45c3-84d3-5b12a2261be7, 'Simple (fait avec mes fils 5ans et 3ans), rapide et délicieux ( nous avons rajoutes de la poudre d''amande a la farine), aussitôt fait aussitôt manger. Merci cette recette se trouve maintenant dans mon carnet.', '2008-11-09T16:59:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 382b4ddb-2489-4d51-89e4-660853355ace, 'Vraiment très bien ! Je l''ai servi l''autre jour à un couple d''amis et il est parti en moins de 2 ! (presque pas eu le temps de le savourer !). Idéal quand on a un imprévu et pas de vrai chocolat sous la main !', '2007-10-09T18:38:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 00e4a10e-72ac-41da-b9bf-4eec41149d42, 'Très bon et très moelleux. Pas besoin de beurre et pas besoin de monter les blancs en neige...que demande le peuple. Une recette à conserver précieusement.', '2007-05-18T11:34:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, e8e9a5b9-6fcd-4bb0-b03b-517b7afe3025, 'J''ai rajouté un banane en tranche sur le dessus avant la cuisson... Il a gonflé et sa forme est super! Il sent vraiment bon, je crois que même si on est que trois ce soir... On va le finir!! Merci pour cette recette hyper simple!!', '2007-03-23T20:20:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 1ad65667-990f-4ef9-929a-26f5fd03dd2e, 'Assez bon. J''ai rajouté un peu de levure chimique.', '2007-03-11T11:13:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, bd6c1495-e4c3-4f1e-9d7b-02e6f7a7028f, 'La pâte parait très liquide au début, et puis en fait, le gâteau gonfle très bien pendant la cuisson, c''est un délice !', '2006-05-25T16:15:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 02a83848-74ee-4543-b600-0581de289d74, 'Très bon gâteau! Ma famille a adoré! On ne parle pas de levure, alors dans le doute j''en avais mis 1/2 sachet!', '2006-04-10T13:18:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 07344df9-f185-4d01-98e5-80f3d0f98074, 'Super bon et facile à faire. Ca change des gâteaux au chocolat trop corsés.', '2005-04-16T12:30:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, 30c1299b-8647-4dc7-8a86-4c08224b597b, 'Mes enfants l''ont adoré. C''était très léger (pas de beurre) et bien moelleux. Je l''ai mis à thermostat 5-6.', '2005-01-31T15:11:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33628, d04c6ca7-b1a6-41c8-b409-81500d867714, 'J''avais peur que ce soit trop sucré, mais non. Très moelleux et facile à faire. ça manque toutefois de "goût chocolat" !', '2005-01-13T11:58:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 322e3d57-6165-47b5-aa37-c394bf0a97ce, 'Très bon et moelleux à souhait !', '2022-05-25T08:37:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 0b2b5cd2-baf6-419e-9a02-894c1211fd1e, 'Rien de mieux pour adoucir les froides journées d''hiver ! Je vous conseille d''ajouter une pincée de cardamome, gingembre et cannelle... Un délice !', '2020-02-18T14:49:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, fdd56f02-5439-4a5c-8a7e-d745850a262e, 'Excellent ', '2019-04-14T13:33:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 76dc05a7-4fc6-4cc1-81c9-a995c8ae436c, 'Excellent ! Réalisé avec 4 bananes quelques carrés de chocolat au lait placés dans la pâte et des noix concassées sur le dessus. Mes ados en raffolent ! Idéal pour un petit déjeuner avant une dure journée de classe. Merci pour la recette !', '2017-10-13T00:23:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 1303192e-855a-42fc-b597-96e127dad5e6, 'Top', '2017-02-19T15:57:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, ce32178b-13f8-4718-966b-38531f6e9d8e, 'Pour ma part, j''ai mis 150 g de farine, à peine 50 g de sucre. Je n''ai pas trop aimé car la banane cuite n''est pas mon fort, mais l''avis collectif est positif !', '2017-02-12T21:43:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, ea3b84bc-3a83-42bb-8c0f-0a0a8aa98612, 'Je l''ai fait avec du sucre rapadura et un peu de sucre vanillé, cuits 35 min à 180°C dans des moules à muffins. Ah et mes bananes n''étaient pas spécialement mûres, du coup il restait quelques petits morceaux après la cuisson.... Miam miam! Simple et délicieux ! ', '2015-06-29T16:25:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 855279f8-1869-47b8-82bc-98ceab9d8e3e, 'Fait et refait et re-refait ! Délicieux !', '2015-05-11T12:36:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 56b0278e-1820-46c6-8837-42951881c4de, 'Excellentissime ! Ne rien changer ', '2015-05-04T00:47:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, e7c103d6-d6df-45b8-91f5-0ecd4d180aba, 'Très bonne recette mais j''ai ajouté des pépites de chocolat.', '2014-10-24T22:54:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 48373d45-fd66-4a23-8a3c-884be577cda1, 'Pour moi 100 g de beurre - 100 g de sucre - 150 g de farine - (à la place des tasses ) Excellente - A refaire en pensant au rhum.', '2014-05-24T12:37:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, ff0be392-5e90-4135-ac24-bd224715aaba, 'Super bon comme aux USA. J''ai baissé la quantité de sucre à une 1/2 tasse et augmenté un peu la quantité de beurre. Très bon. Merci !', '2013-04-07T18:32:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, a923460a-b3f9-429a-961b-016d9a988a5a, 'J''ai juste ajouté en plus des amandes entières et du chocolat.....un bonheur !! ', '2013-01-04T21:21:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 9a0f93c9-5787-43f6-a32a-714b6114ed71, 'Super bon ! Mon mari a adoré et moi aussi. J''ai pas mis de bicarbonate car j''en avais pas. J''ai ajouté des raisins et du rhum. Ca donne envie de laisser pourrir ses bananes... A refaire', '2012-11-18T20:58:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, a083db6b-7c8c-4fdc-91ac-9533a227dbb4, 'Un succulent dessert, en respectant les doses, j''ai juste ajouté une lichette de rhum. Vraiment bon, cependant je n''ai pas fait attention au thermostat ni au temps de cuisson indiqué, car ça parait étrange une si longue cuisson à cette température. Personnellement, je l''ai cuit à 150°C pendant environ 30 min (mais ça dépend du four donc autant faire à sa guise). Voilà bon appétit à tous, nous on se régale !', '2012-05-02T11:39:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 0039cf07-d68e-455e-80a0-01841a29ec38, 'Déçu de chez déçu !! Le temps de cuisson indiqué est bien trop long, pourtant j''ai un four ou habituellement il faut rajouter du temps pour obtenir une cuisson correcte, mais là 20 minutes avant ça sentait le cramé. On sent peu la banane et c''est sec et élastique, je trouve. Vous l''aurez compris, je n''ai pas du tout aimé !', '2011-01-08T16:09:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 1e4884ee-e497-49c3-9110-fde758dc17fc, 'Très bon gâteau, très léger... tout le monde a adoré même si j''ai pas mis les noix...', '2010-11-30T14:04:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 6671f532-1e03-4f5f-b7ee-ec928f37eba9, 'Délicieux !', '2010-05-15T23:06:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, b14ed893-3b63-4028-905d-b7484e12b27e, 'Vraiment délicieux, un pur délice. Le goût de la banane ressort bien. J''ai rajouté un peu de rhum blanc ainsi que de l''extrait de vanille. Que du bonheur !', '2010-02-27T21:58:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, e40587e1-fe3c-4117-80b9-d8dc5daf6c3c, 'Pratique pour terminer des bananes trop mûres. Un peu lourd, toutefois, mais est idéal pour un petit déjeuner énergétique. Je l''ai fait avec les mesures de Marie et 4 bananes + trois cuillères à soupe de poudre de noix maison. Bon appétit !', '2009-06-14T10:28:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 2e9c7307-dea6-4639-b324-5bf5f877fba9, 'Très déçu, nous avons trouvé cela très sec et sans goût.', '2009-06-11T20:25:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, c121d2ae-73a7-4a39-8d96-4f2fdeb2d951, 'Très bonne et facile à faire. Si l''on n''a pas de bicarbonate (comme moi) mettre un peu plus de levure fonctionne bien. Par contre, de mon côté à la demi-tasse d''huile j''ajoute une demi-tasse de crème fraîche épaisse. Et pour ceux qui veulent masquer le goût des oeufs (j''en est un chez moi) l''astuce c''est d''ajouter un peu d''extrait de vanille (une petite cuillère à café) ou du jus de citron. Sur ce, une recette à expérimenter et répéter! Bon dégustation!', '2009-02-13T19:56:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 2598f4fc-a07b-4343-b1d5-8151ea392b9f, 'Mon marchand de fruits m''avait donné 4 bananes qu''il ne pouvait pas vendre (peau noire). J''ai cherché une recette sur Marmiton et comme j''avais tous les ingrédients (sauf le bicarbonate) j''ai préparé mon pain aux bananes avec les indications en g de marie_30. A peine froid, dégustation avec monsieur, et miam miam c''est trop bon, bien le goût de banane. ', '2009-02-07T19:20:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 5dfaebce-7955-4e37-b924-6581f3582f40, 'J''ai suivi la recette à la lettre. J''ai seulement ajouté des pépites de chocolat à la moitié de la pâte... Délicieux... J''ai fait cuire 55 minutes au four, mais avec des moules à muffins...', '2008-09-03T22:52:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, ee879078-e226-438d-92b7-451a294028e1, 'Gâteau frais, léger et parfumé. Je n''avais pas de noix mais c''était très bon. Excellente recette appréciée par toute ma famille (même les plus difficiles) et mon chéri... on m''en redemande même!  ', '2008-06-04T13:32:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, a5aa8284-0236-4d01-ac0c-cbecb3b58787, 'Bonne recette. Je double la quantité de noix ça donne un bon goût au cake', '2008-04-28T06:34:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 899ece50-6396-42fd-91e2-82f90a537449, 'Très bon ! J''ai fait sans les noix mais avec des petits morceaux de chocolat noir, ça passe très bien.', '2008-03-02T21:19:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, a5040742-bb36-451d-8a6c-b0113905b723, 'Vraiment excellent, surtout avec une bonne poignée de noix! J''avais 4 bananes alors j''ai mis les 4...et tant mieux car le goût de banane était très prononcé...comme je l''aime! :)', '2008-01-21T22:42:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 8eac26eb-f6d7-423d-b755-13b98e208bf6, 'Oui, c''est très bon, mais il me semble que le pain goûté aux USA était plus fort en banane...', '2008-01-18T11:00:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 9f342145-1988-4e94-83da-998322854abe, 'Ce pain est un pur délice et si facile à faire ! Un grand classique de la cuisine américaine. Merci pour cette recette.', '2007-10-16T05:14:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 3b27ed30-c988-496d-9bad-694bd295fddc, 'Excellente recette. J''avais auparavant essayé d''autres recettes de "Banana bread" trouvées aux US ou j''habite, mais aucune ne m''avait convaincue... J''ai suivi cette recette a la lettre, sauf pour la farine. Comme je n''avais pas sufffisament de farine blanche, j''ai mis moitié de farine complète et moitie de farine blanche. Et je n''ai pas mis de noix (les enfants n''aiment pas trop). Cuisson 60 minutes dans un moule que j''avais tapisse de papier sulfurise pour favoriser le demoulage. Resultat parfait, rien a redire... Petits et grands se sont regalés! Je conserve la recette precieusement.', '2007-08-18T21:08:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, d511be4f-6b66-4749-b12a-456e513c563e, 'Superbe ! Nous habitons en Australie ou le "Banana bread" est très populaire mais je n''en connaissais pas la recette. Je l''ai confectionné avec ma fille de huit ans et tout le monde a adoré. Merci pour cette recette !', '2007-06-10T07:34:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 2052df65-4e86-4988-aab6-e9e697516122, 'Très bonne pour n''importe quelle heure! Je l''accompagne avec la délicieusse "confiture de bananes au rhum" (recette Marmiton). A mon avis c''est suffisant avec 45/50 minutes au four 170º/180ºC.', '2007-06-06T17:41:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 50446b07-9031-4e95-a780-ea35e89e4759, 'Merci pour cette recette exquise! Merci aussi à Marie web et Brigitte Titou pour leurs précieux commentaires! J''ai utilisé les mesures en grammes et j''ai mis des raisins secs avec une touche de rhum. J''ai également rajouté de la vanille liquide, une poignée de noix de coco râpée et j''ai remplacé le sucre par 200 g de sirop d''agave. Un délice! Merci encore.', '2006-08-30T19:14:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 4a690f3a-59f3-4866-abc8-ad1ad6f42f5d, 'Très bon, très moelleux... Juste que le goût de la banane n''était pas très prononcé bien que j''avais incorporé des bananes très très mûres et donc pleines de saveurs.  Les recettes avec les tasses, j''aime moins que les grammes; voici donc ce que ça a donné chez moi: 90 g de beurre, 230 g de sucre, 250 g de farine. Ça peut peut-être aider celles ou ceux qui n''aiment pas non plus ! ;-)  En tout cas, le gâteau était excellent !', '2006-07-07T22:08:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 41bc38ae-2595-4996-af6a-a89497e052b2, 'Délicieux!', '2006-06-08T17:36:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 018c086c-115f-444d-9fb3-5df0e0367a2e, 'Tout le monde m''en réclame... je n''arrive plus à avoir assez de bananes très mures pour en faire 1 par semaine... mon fils (grand consommateur de bananes) m''en redemande et j''ai fait l''admiration de tous à mon travail. Merci Marmiton.', '2006-05-23T15:47:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, bf0c4d5e-f4ca-4eb8-bc38-2177fe3150c2, 'Ce cake a une très bonne texture, la cuisson est adéquate. Je trouve cependant, qu''il manque un peu de goût de banane, ou autre. Mais de toute façon, il n''a duré qu''une demi-journée!', '2005-10-21T20:48:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, d7729d3f-7ef7-4641-b946-bc3eede35d10, 'Je souhaitais retrouver le pain aux bananes goûté à l''île maurice durant mon voyage de noces. Cette recette est la bonne. Je n''ai pas mis le bicarbonate mais ça a quand même bien marché. Avec de la confiture de goyave ou de papaye c''est excellent: que de bons souvenirs!!', '2005-08-30T11:39:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, c651a1f1-a621-42f4-9b36-3fcb0aa1ddba, 'Delicious! Idée de repas d''été: ce pain à la banane, avec une méga-salade de fruits!', '2005-07-03T23:29:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 1eab814b-d784-4a6e-b9a3-45ad243646bc, 'Il est excellent. J''en ai fait pour le petit-déjeuner pour des amis avec moitié miel, moitié sucre et ils ont adoré. Je compte faire le prochain avec du sirop d''érable, j''en donnerai des nouvelles!!', '2004-04-11T21:03:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 833e75d2-146f-4c09-a5f5-b430287bb880, 'Très bon. J''ai modifié : j''ai mis 1 1/2 de farine et 1/2 tasse de gruau ; très bon pour la santé.', '2004-01-04T20:43:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, d4b54a8c-c967-437b-ad3f-e4e9e7198dd4, 'Hummiam! Très bon, pas lourd du tout. J''ai remplacé le sucre par du miel, je n''avais pas de noix, alors j''ai cassé une tablette de chocolat à cuire et je l''ai mis dans la préparation...génial. Mon copain a adoré :).', '2002-11-07T10:06:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 92b4156a-40ca-4344-9d83-c9b783f15206, 'Ce pain aux bananes est aussi bon sans les oeufs! Par erreur, j''avais oublié de les ajouter et personne ne s''en s''est rendu compte!! Pour ne pas l''avoir essayé avec les oeufs, je ne peux vous dire s''il y a une grosse différence mais je sais qu''il est bon sans les oeufs et... c''est moins engraissant!!! ;)', '2002-07-25T14:57:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 284c6dff-1de4-43cf-b5b2-4230e4074c1e, 'Super bon, facile et rapide à faire. J''ai pris 4 bananes hyper mûres, j''ai rajouté des raisins de corinthe macérés dans le rhum à la place des noix et j''ai servi le tout tiède avec une boule de galce à la vanille. C''était top moumoutte!!', '2002-05-08T13:00:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11095, 2c091f17-5348-457d-bde7-c666f3da5203, 'Bonjour, j''ai adoré cette recette: ça fait un pain moelleux et j''y ai ajouté un petit glaçage au miel... c''est délicieux et il est facile à faire. N''hésitez pas, il est vraiment extra.', '2001-10-17T17:10:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (31719, e6ebcdfd-e479-4892-9029-f59a14fee4f0, 'Je ne crois pas que la quantité de beurre est la bonne ! J''en ai mis 75g  et la pâte était quand même comme de la chapelure. Et le goût n''est pas terrible aussi, c''est comme un milk shake, alors pour quoi se donner tout ce mal, quand on peut se faire un super milk shake bien facile et qui a le même goût ? ', '2004-10-15T12:11:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16161, 5cedc7a9-df23-4486-bbe0-617f78e3a9f6, 'Magnifique moelleux,léger. J’ai rajouté des écorces d’oranges confites et de pépites de chocolat  noir. Un délice.', '2023-05-19T21:27:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16161, 9c755f6a-65dc-4abc-baa1-48459c277af7, 'Tout le monde l''a trouvé très très bon ce gâteau !  Juste quelques petites modifications : j''ai mis un peu moins de sucre car mes bananes étaient bien mûres, ensuite j''ai aussi ajouté des pépites de chocolat. Très bon !', '2009-06-04T18:03:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16161, 45200594-9f33-40fc-a5eb-59d13bd7e958, 'Très bon, j''ai divisé les quantités par 2 et j''en ai fait 1 aux bananes et 1 aux poires. Servis avec 1 boule de glace vanille, les invités ont beaucoup apprécié!', '2006-12-10T12:29:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16161, 26a75552-2d1a-4e7a-be23-340790a7dce5, 'C''est bon! Il faut mettre moins de rhum et ajouter un sachet de sucre vanillé. Diminuer également de moitié la quantité de sucre: 75g. Idéal quand on a des bananes trop mûres...', '2006-02-02T12:59:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16161, 63ed3e88-dcf0-4e7f-9927-6e2e74ca881f, 'Pas mal, moelleux. Ce gâteau est bon mais n''est pas extraordinaire! Il est facile à faire, ce qui peut aider certain. ', '2002-10-20T11:00:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28469, 145c5532-2d56-4074-8304-102391eab0c1, 'Belle surprise pour cette recette originale', '2020-11-03T21:14:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28469, bedc7740-22d6-4fc6-8a0c-dd4fb7127808, 'Je retiens surtout l''association bacon banane cuite. Quant à l''accompagnement, c''est pas mal mais ça devrait être plus relevé (peut-être du piment d''espelette). J''ai également blanchi le poivron pendant quelques minutes.', '2007-09-09T15:38:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39075, 55f5ecac-8215-48fc-94ba-9ecb5d7cf889, 'Oh là là, c''est vraiment, mais alors vraiment pas bon... On ne sait pas trop combien rajouter de lait de coco à la fin, pas plus qu''on ne sait s''il faut le manger chaud ou froid ; mais, dans un cas comme dans l''autre, le goût final relève de l''indéfinissable...', '2008-03-19T12:17:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39075, 2e03760b-9c9f-4fa3-b269-0469a2ac5045, 'Délicieux!!! Dessert original et léger!!', '2005-12-11T20:53:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (529822, 288f139e-063e-4310-a425-21a9408f3fad, 'Top ! A faire et à refaire ! ! !', '2021-02-07T13:48:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (529822, 6128038f-f39d-47ca-9452-75c790271f96, 'Très bon dessert ???️?', '2021-02-05T18:32:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61767, f50cfd98-0b32-4ae5-a5cd-ff98d5658028, 'Pas trouvé de glace straciatella mais remplacé par de la glace banana split. Ce dessert facile à préparer est très bon et apprécié par de nombreux invités.', '2008-06-19T14:02:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61767, 884b1c6d-01f2-4065-8419-dfdcc4a5d636, 'Pas trouvé de glace stracciatella, remplacée par de la glace "crème brûlée au caramel". Très bon et simplissime!', '2008-03-30T15:03:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72512, a2f595d4-cad3-41d5-b281-475195850742, 'Excellent ! J’ai mis du chocolat au lait praliné (car c’était le seul que j’avais), c’était très bon.', '2019-10-27T05:26:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72512, 023eb6ae-3e29-476d-8b04-335a9b452951, 'Gros succès à la maison, et j’ai pu ainsi utiliser 4 bananes qui avaient trop mûri pour être mangées telles quelles.', '2019-10-05T12:24:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72512, 9a72140c-6662-4469-8179-9cf37552ea3b, 'Top cette recette ! Gâteau bien moelleux et très bon.
Par contre je n''ai mis que 2 bananes et ça suffit en goût pour nous.
Merci !', '2019-08-20T10:38:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72512, 0956f782-418a-4445-922d-c18969f5ad2d, 'Le gâteau est bon, mais j''ai trouvé qu''il manquait un peu de fondant. Et surtout à cause de la précuisson des bananes (15 min au four), elles sont beaucoup trop cuites.', '2016-04-16T20:29:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72512, 1ee84176-1689-4a72-988e-4997a6c76f7f, 'Un vrai régal. Tout le monde ici l''adore et de plus facile à faire avec mes petites filles.', '2015-05-31T00:35:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72512, d5cba0dc-8247-4e1e-973e-9b05af7ccaf5, 'Recette au top ! Très bon et original. Merci beaucoup ', '2014-10-03T20:49:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72512, a5faf4f4-073b-411e-a5fe-0e7ad2efa91b, 'La recette est parfaite pour moi ! Merci Yasmine', '2013-10-20T09:32:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72512, 81bd7e9f-737f-40ca-a659-727277aeb7ef, 'Recette très simple et en plus un fondant délicieux !! Merci pour cette recette qui ravie petits et grand gourmands.  ', '2012-11-22T22:21:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72512, b936ac41-0ea4-4090-8120-0a690a26d8d1, 'Excellent gâteau ! Chaque fois que je le fais je le réussi avec succès tout le monde adore. Alors merci pour cette super recette !!!', '2009-04-20T20:17:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72512, dfef78a5-29c9-49aa-bad3-68c276438fcc, 'Très facile à réaliser et délicieux!', '2008-07-05T12:20:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82382, a9f93bc1-2757-4985-b801-e05b642a1008, 'Pas mal, mais les quantités sont un peu sur-évaluées. La prochaine fois, j''ajouterai peut être un peu de citron vert à la recette.', '2011-02-20T22:23:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (212049, 6f04941f-94ba-4124-acd6-04632b34b612, 'Super recette, très bonne consistance, a refaire ', '2023-05-19T19:59:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29029, 2fcc8a37-ce71-4f80-9822-91a7b6ffd083, 'Pas mal cette petite recette :) Merci.', '2014-03-06T21:04:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29029, d85d2f1b-6910-45b9-8a15-2c209c62909f, 'J''ai fait des tartelettes. J''avais l''intention de saupoudrer de sucre vanillé, mais j''ai oublié. Cela aurait sans doute été meilleur... ', '2010-04-11T13:48:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29029, d7de5294-9da1-452e-912d-1da2c9f1ee31, 'Je saupoudre le tout d''un peu de cassonade avant de mettre au four... et voilà un dessert simplissime, pas cher, qu''adore les enfants et les grands.', '2010-03-20T18:54:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29029, 8ea38ea3-4241-4e01-ba26-bffc67e4f567, 'Bof... C''est vrai que c''est très économique et super simple à faire, mais le résultat m''a un peu déçue. La prochaine fois, je vais la faire avec des pommes, ça fera une tarte aux pommes très simple!', '2004-11-06T17:21:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392616, f637aab3-6efb-4220-9fd4-1f3663f51ad1, 'Penser au curry qui n''est pas inscrit dans les ingrédients.
Super bon, on a adoré.', '2022-05-19T13:26:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56096, 26ff9b71-6998-4c54-b019-d6a3cca35b13, 'Si on met la dose de vin recommandé c''est beaucoup trop liquide, si on en met moins, plus aucun goût de vin... déçu', '2014-03-17T22:05:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56096, 23efc506-6028-4415-87c2-f36f7675e01b, 'Délicieux (j''ai ajouté un peu de sucre pour adoucir) mais très liquide, le résultat ressemblait plus à une soupe qu''à une compote. Cela dit, c''est original comme concept : de la soupe au dessert !', '2011-02-15T12:16:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56096, 168648c4-16b9-4f0f-af3d-104cc42c487f, 'Très fin. Façon originale d''utiliser un reste de vin rouge (même pour moi qui n''aime pas ça !). J''ai utilisé la cannelle et j''ai juste mis un peu de sucre en plus. La prochaine fois, je mettrai juste moins de vin (sinon compote liquide).', '2007-12-13T08:57:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 9c9a7f80-35af-44a4-904a-020b04da022a, 'On adore tous ! Il n''y en a jamais assez ! J''ajoute un carré de chocolat dans mon muffin avant cuisson ! Succès garanti !!!! A faire et à refaire....', '2021-11-16T12:09:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 0be4f2e5-65e1-4f47-be83-ea2ceb69d17e, 'Enlevez 3 bananes pour les remplacer par 3 pommes (il y en a beaucoup en ce moment) à mettre en morceaux dans le micro-ondes et écraser avec les 3 bananes. Ajouter une tablette de chocolat découpée en pépites. Délicieux.', '2016-09-25T10:14:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 9e01e224-57d0-4050-a7cc-0f711fc65dbc, 'J''ai mis moins de sucre et un petit peu moins de beurre et surtout j''ai rajouté une grosse cuillère à café de Nutella au milieu du muffins... un régal', '2015-03-04T16:00:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 8c5da1c5-1448-4aa4-9020-3c55c8e4cb91, 'Bien nommée recette, très facile effectivement. J''ai juste mixé les ingrédients au mixer en respectant l''ordre et les proportions (150 g de beurre suffisent). Le temps de cuisson est bon aussi. Attention aux fours un peu trop puissants (comme le mien). Il faut penser à baisser la température en fin de cuisson pour éviter d''avoir des muffins "trop bronzés".', '2014-11-01T15:40:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, e3a3ab1c-1157-4669-b0b9-8517330e01a1, '1 vrai délice ! J''ai ajouté 1 pointe de cannelle en poudre', '2014-07-17T19:19:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, f1b0c553-6735-44f5-8df4-35578ad3a09a, 'Excellent !!!!! Rien à changer dans la recette !', '2013-07-09T08:39:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 4721cd47-e5fe-41e0-9612-125e0d6b482b, 'J''ai divisé les ingrédients par deux mais j''ai mis un sachet de levure entier pour faire gonfler, et de plus, j''ai ajouté de la noix de coco râpé dans le mélange et un cœur en nutella. Un délice de 14 muffins. ', '2013-03-24T16:42:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 2c4d11da-f31a-40ab-b492-206cfcc57439, 'Très bon, au lieu des bananes j''ai mis des poires. Par contre, il y a trop de beurre...', '2013-03-02T19:35:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, debc52d4-1bd4-4d17-becb-a5c8d38203d6, 'Merci pour la recette, le résultat est absolument génial pour les papilles.  Je me sers de cette recette comme base pour la réalisation d''autres muffins et à chaque fois c''est le top!', '2012-10-08T21:01:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 3e08a2bd-1c42-4ab1-a847-eff4956f2ce0, 'Je ne voulais que 12 muffins alors j''ai divisé les portions par deux. Donc proportionnellement, je ne trouve pas qu''il y avait trop de sucre. Mon copain qui n''est pas très dessert a beaucoup aimé. J''ai ajouté de la cannelle et de la fleur d''oranger, par contre, c''est juste mon opinion personnelle. En revanche, j''ai été un peu déçue du gonflant : peut-être que j''ai mal dosé la levure et le bicarbonate en divisant les portions par deux... Ceci dit c''est une bonne recette que je referai avec plaisir.', '2012-09-15T14:10:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, cd9c3a85-90c7-45e1-977d-d8a91b316abc, 'Vraiment bon. Moelleux à souhait. Le seul souci, c''est que ça part trop vite tellement c''est bon ! Merci pour cette recette que je vais refaire sans hésiter.', '2012-09-03T17:42:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, d7364e5f-f387-418a-ba83-e9ea50e70ad6, 'Un vrai délice, parfait lorsque les bananes sont trop mûres et que personne ne veut les manger ! J''ai juste mis moins de sucre et utilisé un sachet de levure chimique pour remplacer le bicarbonate. J''ai testé avec un morceau de chocolat noir au milieu...les enfants adorent !', '2012-08-20T14:00:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 3edb3c63-e073-4826-8d40-6f44c522a80b, 'Trop de beurre : pâte trop liquide et ne levant pas beaucoup.', '2012-08-13T10:45:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, a8e5f0ae-20ba-4ad6-9221-f842dd58be90, 'Trop bon ! J''ai ajouté aussi des pépites de chocolat. Trop bon !!!!!', '2012-08-12T22:43:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 79a3635e-54fb-408b-9f3e-03b65b153517, 'Pas mal du tout cette recette ! J''ai eu assez de préparation pour faire 12 muffins (plat en silicone) et un cake ! Moelleux, bon goût, je suis contente car je ne suis vraiment pas une pro pour les gâteaux !', '2012-08-04T15:47:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, e3b65b12-650c-4671-991f-f039ec109353, 'Délicieux ! Je conseille en effet de mettre moins de beurre, même en diminuant la quantité (120 g au lieu de 220), on se rend compte que c''est trop. J''ai testé une partie en ajoutant des pépites de chocolat, mais j''ai dû en mettre trop car je n''ai senti que le chocolat et plus du tout la banane... Donc pour les mordus de bananes, je conseille de ne pas mettre de chocolat, ou juste un peu. Merci pour cette recette !', '2012-07-23T14:08:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 43df954d-b0e7-44e9-a4e2-861929c3b15d, 'Recette délicieuse ! Tout le monde a adoré. Super pour éviter de jeter les bananes trop mûres. ', '2012-07-11T20:26:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 35108085-5d18-431d-b29f-42f8de9d07fa, 'Un pur délice, recette suivie à la lettre et rien à dire...', '2012-06-30T03:29:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 619b0a11-e13a-4ded-b42b-38a5341dbfcb, 'Très bonne recette. J''ai partagé la pâte en 3, j''ai fait des muffins aux pépites de chocolat, aux framboises (mes préférés pour le mélange de l''acidité et du sucre miam!)et à la banane comme sur la recette de base.  Par contre, j''ai fait cuire les bananes quelques minutes au micro-ondes parce qu''elles étaient trop vertes.  ', '2012-05-20T01:27:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 6121a82b-568b-4991-ad0d-95bba4f17b37, 'Plus qu''un régal, nous avons adoré, j''ai fait écraser les bananes à mes filles, du coup il restait des morceaux et c''était top avec des pépites de chocolat, recette que je garde dans mon classeur, merci beaucoup, à faire sans hésiter.', '2012-05-12T18:44:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 452d6447-87d8-482b-8690-66404d50a036, 'Super ! Très bons ! Je n''ai mis que 300 g de sucre et c''est vrai que cela suffit ! Merci !', '2012-03-25T21:12:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 0b10a773-be40-49b8-a94e-10eb2a9594ff, 'Recette simple et délicieuse, à agrémenter de quelques pépites de chocolat !', '2012-02-17T17:54:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 37ec0179-a459-4368-bb01-fe15f28a74e5, 'Tout simplement excellent ! Avec une cuillère à café de Nutella au centre un délice...', '2012-02-16T14:39:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 2a7b50c1-b12d-4f5b-ae4f-9c79535a24f9, 'Recette excellente tout le monde a adoré.', '2012-01-28T23:06:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 9d8c2418-8714-49ee-9cd3-138ff6576694, 'Excellent et d''une simplicité biblique ! Merci, tout le monde s''est régalé.', '2011-11-20T10:42:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 022f2a5e-3261-4cbb-90ae-be87a3585b62, 'Divin, excellent, à refaire et à refaire. Mangé tiède un régale, le chocolat se marie très bien avec la banane. Touche personnel par rapport aux autres commentaires: 150gr de farine, 100gr de maïzena, 1 carré de chocolat noir au fond, sucre vanillé (amande, pépite non utilisé).', '2011-10-30T20:35:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, e1ab97c2-49e8-4613-bf6c-618b1158a825, 'Une véritable tuerie !!! J''ai mis 100 g de sucre en moins, et ajouté ce que j''avais à terminer dans mon placard : noix + chocolats de Pâques passés à la moulinette ! Un vrai régal. Comme il y a beaucoup de pâte, j''en ai fait un cake et des muffins.', '2011-10-20T20:55:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, faa22b9b-1a21-4238-b955-8641bf488364, 'Un vrai délice !! ', '2011-09-11T01:03:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 42e4bf78-5514-49b0-9c32-432a2446cbd1, 'Les muffins sont fondants à souhaits, avec des pépites de chocolat ou des noix c''est un délice. Par contre, j''ai mis moins de sucre.', '2011-09-08T06:38:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 15eb8fad-eb08-4001-9e3a-8004c070b9d6, 'Vraiment délicieux, j''ai mis 300 g de sucre et je trouve que c''est suffisant, à refaire vite', '2011-08-29T21:37:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 0a17aa8a-fcf6-4055-9312-6172c01bacff, 'Un vrai délice ! Toute la maisonnée a a-do-ré ! Merci...', '2011-08-20T02:57:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 57149884-d968-4cb7-8afb-7f09eeaf7b94, 'Moi, j''ai trouvé ça excellent ! Paul, lui, il n''a pas aimé ! Dommage, c''était délicieux !', '2011-06-18T11:17:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 79bef457-9ae6-406e-a68e-c95fbc3c436b, 'Gâteau excellent ! Pour ma part, j''ai ajouté des pépites de chocolat.', '2011-04-14T22:59:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 9894dcd2-f394-4b2c-9913-437397320607, 'Excellent. Très simple à faire et très moelleux. Que demander de plus!!!', '2011-03-21T23:05:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 2a73dcc4-4f0f-4518-96f3-2db658ebe247, 'Vraiment excellent, recette facile à réaliser et réellement délicieuse. Un régal pour les petits et les grands. Je mets moins de sucre par contre car sinon je trouve les muffins trop sucré.', '2011-02-20T21:47:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 8f2c727a-4722-4d03-9e5c-26dad2e95c6b, 'Vraiment excellent !! Très facile à faire.. J''en ai fait aux framboises (en boîte car ce n''est plus la saison) meringue et copeaux de chocolat meringue... Miam!!!', '2010-12-28T19:33:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 152546e0-f436-4737-a890-1a3a7149edc0, 'Rapide et simple et bon !! Mais je les ai trouvés un peu trop sucrés ! ', '2010-09-15T22:36:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 5b0fa714-12bf-40fd-8815-793dfd14fc50, 'Merci à mon épicière de m''avoir donné des bananes tigrées, car elle m''a permis de découvrir cette délicieuse recette.', '2010-08-24T20:29:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 37d42e0c-14ee-4471-8d80-b3452b39819e, 'Un régal ! Il me manquait 100 g de sucre alors j''ai mis de la vergeoise. Puis j''ai divisé ma préparation en deux et j''ai mis 5 bananes dans une moitié et 300 g de myrtilles avec une goutte de vanille dans l''autre... une pure merveille... Merci !!', '2010-06-18T13:50:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 264a9a76-3114-416e-a09a-8cbee541c710, 'Avec des copeaux de chocolat, c''est trop bon. On sent très bien le goût de la banane contrairement à ce que certains commentaires laisseraient supposer.', '2010-05-06T22:25:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 25c5d04c-85cf-4acf-a343-059daa5b17d2, 'Bien levés et très moelleux, mais je n''ai pas trouvé que celà avait beaucoup de goût.', '2010-02-25T21:05:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 990d6eb7-5bb3-4c8b-8a8b-9ad8bc90041f, 'J''ai suivi la recette à la lettre, et le résultat est à la hauteur: muffins gonflés, dorés et légers. Il vaut mieux prendre des bananes bien mûres pour que le goût ressorte bien. Je referai cette recette.', '2009-10-31T13:47:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 96aa198b-73e0-4f49-a2b7-d39d1e7af75d, 'Un régal !! J''ai divisé tous les ingrédients par 2 et ajouté des copeaux de chocolat pâtissier... Je sais maintenant comment conserver mon homme !', '2009-07-13T18:59:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 67a58d3d-947b-432a-8f32-96444912bd5c, 'J''ai divisé les proportions par deux et j''ai fait 10 muffins. j''ai mis moins de beurre comme indiqué et c''est très bien. mes muffins sont dorés et moelleux. Super ! J''ai mis un sachet de levure chimique à la place de levure + bicarbonate.', '2009-06-24T18:10:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 505a6b3e-606e-4c94-85d7-ab535f3256dd, 'C''était mes premiers muffins et personnellement je suis déçue, l''apparence et le moelleux sont parfaits par contre le goût de banane n''est pas assez prononcé, j''ai eu un arrière-goût de banane. Sans plus.', '2009-02-25T19:52:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, a0c1699e-b83f-4f62-a6ca-3cb064d34c2f, 'Délicieux! Recette super facile à faire et à agrémenter au fil de ses humeurs ! Je l''ai réalisée avec mon fils de 3 ans : Un jeu d''enfant !', '2009-02-06T12:55:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 14ebe6f0-5105-4ef3-9863-3a727c79f662, 'Délicieux. Recette facile à faire. Je n''ai mis que 2 bananes et 180g de beurre. ', '2009-01-29T22:38:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 3fc96197-0cb3-407e-b020-b46bcd9c7935, 'Parfaits! C''est tout ce que je peux dire de ces muffins légers, pas trop sucrés; quand on en mange un on ne peut plus s''arrêter! La meilleure recette de toutes celles proposées selon moi.', '2009-01-22T19:49:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, eb0b7d6d-5478-4930-a73c-d68788e88a92, 'Tout simplement EXQUIS, DIVIN. J''ai réalisé exactement 28 pièces différentes, puisque en fonction du restant de pâte, j''ai ajouté un carré de chocolat, des raisins secs, de la cannelle. Mon papa présent ce jour là a adoré, ma maman les a gouté également et m''a félicité, il faut que j''en refasse vite, les enfants en réclament pour le gouté.', '2008-11-26T16:13:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, de90ec54-6682-4187-b347-ee999e213915, 'Tout simplement exquis!! J''ai ajouté en plus des copeaux de chocolat (sinon des pépites) et c''était un vrai délice ! Très simple à faire, les enfants adorent!!', '2008-10-22T17:01:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 63634a84-430f-44ec-a3a4-aa10ac0ea682, 'Recette délicieuse, facile à faire en peu de temps. Je l''ai faite hier pour le goûter de mes enfants : un franc succès. Pour ma part j''ai divisé la recette en deux. J''ai mis deux bananes et une belle pomme coupée en petits morceaux et de la cannelle. Pour la deuxième fournée, j''ai rajouté deux bonnes cuillères à soupe de poudre de noisettes : un délice. Merci pour cette recette que je referai régulièrement pour les goûters ou les brunchs.', '2008-10-11T10:39:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 27ff49e1-76d4-4343-b989-fcc0d6cd2e7e, 'J''ai divisé les proportions par deux mais j''ai ajouté 50 g de farine supplémentaire car je trouvais la préparation trop liquide. Les muffins sont excellents, à refaire sans hésiter.', '2008-09-16T17:00:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 4112fb87-ce62-4ac5-9614-f511c99f1508, 'Un vrai délice! J''ai divisé les proportions par 2, diminuer le sucre et le beurre et rajouter des pépites de chocolat, fondant et gourmand, cela m''a fait 10 gros muffins, parfait pour un goûter entre copines!', '2008-09-06T20:29:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 53a26292-13b1-4edc-a1c2-511a4e3dc939, 'Vraiment très bien. J''ai mis plus de bananes. J''ai fait des muffins différents en ajoutant cannelle ou coco râpée ou encore pépite de chocolat... J''avais trop de pâte alors j''ai mis le reste dans un moule à cake et c''était super!', '2008-08-10T16:01:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 663f1ae3-c9a2-4c97-9c25-b4e8cbc1a477, 'Délicieux, croustillant à l''extérieur, moelleux et fondant à l''intérieur! Un grand succès!', '2008-06-23T22:35:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 1bbf76fc-dec1-4652-bcab-1659df9f0cf5, 'Comme conseillé par les autres marmitonnautes, j''ai diminué la quantité de beurre: c''etait un succès!  Par contre les quantités m''ont seulement permis de faire une douzaine de muffins.', '2008-05-04T21:36:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, d02e66df-7837-4a72-85d0-0d3eef622b2d, 'Très bons et très moelleux. Pour parfumer, j''ai rajouté une pincée de cannelle. Un régal au dessert avec une boule de glace.', '2007-11-11T15:13:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, b39246d6-1e85-4050-ac61-daad80c8bef9, 'Impeccables ! J''ai mis moins de beurre comme conseillé dans les commentaires, et je n''avais que 5 bananes. C''était très bien aussi. J''ai carrément passé les bananes au mixer, c''est plus rapide. Vraiment bons : même les grands ont aimé...', '2007-10-25T14:38:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, f39d048d-17a8-4a71-8c27-1c1dcd9adabb, 'J''ai suivi les conseils et je n''ai mis que 80 grammes de beurres.  Un vrai délice, même pour moi qui ne suis pas fan des bananes. Le muffin est bien moelleux et on sent bien la banane. J''ai aussi ajouté de la canelle.', '2007-09-23T14:12:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18292, 4fcb103e-5462-4db9-893c-840def2a9e16, 'Super bon!!!!!!dans la recette j''ai enlevé un peu de beurre et ils sont tjs delicieux et j''ai aussi rajouté des noix   ', '2007-08-03T22:42:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66946, ce16220f-9ccd-482a-aa08-15d442629fbd, 'J''ai adapté la recette pour le petit déjeuner avec une noix de margarine, 1 petite cuillère de sucre vanillé et 1 petite cuillère de rhum arrangé. Impeccable pour consommer les bananes plantain mûres
', '2023-02-01T14:29:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66946, 1c87f400-fc6b-431e-988f-c2d14ded95e4, 'Super pour utiliser des bananes plantains un peu trop mûres. Mais je ne mets ni sel ni piments, et je la mange tiède, avec un peu de yaourt nature, miam !', '2008-04-14T02:19:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80056, dc0ef974-5fed-4127-9a6c-0fcc50c9c13d, 'Personnellement, j''ai mis 10 min à tout faire, mais à la place des framboises, j''ai mis des cerises, et c''est très fort en goût, super bon et vraiment présentable.', '2009-05-16T00:34:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80056, 4e30eec0-bc81-4d00-9e1c-eb3d8fba888f, 'Excellent !! je n''aime pas le melon, et pourtant je me suis régalée!!! grand succès auprès des grands et des petits ', '2015-04-13T00:36:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80056, 31084016-b257-45a6-8b45-f84f23273a97, 'Délicieux. Dessert très frais. N''aimant pas la noix de coco j''avais juste mis du fromage blanc.', '2011-07-17T14:29:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80056, 58e5a4c0-c729-47fa-8b36-2c180862c9ae, 'J''ai eu l''occasion de goûter cette recette avec des abricots à la place des framboises; il est vrai que c''est surprenant de prime abord (je n''aurais jamais osé faire un tel mariage de fruits) mais c''est vraiment délicieux et très rafraichissant... Dommage qu''il n''y ait pas de melons l''hiver pour pouvoir en manger toute l''année!', '2008-08-17T15:18:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80056, 8a43c6a1-cff6-45b2-92e7-a0b6b867349e, 'Très frais, allégé et surtout vite préparé. J''ai simplement mis 2 yaourts noix de coco-chocolat car je n''en trouvais pas seulement noix de coco. Merci', '2008-08-16T18:10:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, a2e0ee0d-de20-4f39-965e-0d330cbd6ffd, 'J''ai préféré retirer la peau des bananes, car j''ai eu peur de la présence de produits chimiques qui seraient en contact avec le poulet. En ce qui concerne la recette, elle ne casse rien, c''est assez fade.', '2019-09-14T12:00:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, f871e9f1-9b94-4a65-a266-ae2ed48c95f3, 'L''idée des bananes est très bonne, mais le mélange avec le citron n''est pas des meilleurs. Je ferai une marinade miel et épices la prochaine fois.', '2018-07-28T20:02:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, d0940e99-6b46-4a82-9239-578e3a868a7b, 'Super cool !', '2018-06-08T11:57:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 9872fa8d-020b-4e9e-bdb2-90f9fb70ef35, 'Recette facile à réaliser ! Le mélange sucré-salé est agréable au palais ! Recette à refaire!', '2016-08-17T16:46:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, a4a34ab0-7516-41c5-8413-832081553ab4, 'Très bonne recette à refaire.', '2016-05-07T00:23:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 5ac9228d-1eef-4487-9c90-db29d23534f1, 'Je suis pas fan de la peau des bananes mais sinon c''était très bon.', '2016-03-03T11:37:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 340dc0a0-ac2a-477b-8c4d-c8bf52699aaa, 'Très facile à faire et toujours très bon    ', '2016-02-25T20:23:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, ba2ff459-4710-462d-82b2-69f8d9163624, 'Délicieux, à refaire !! ', '2016-01-17T19:48:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, b3a20a58-ff0a-4b1e-a135-24fe949c2020, 'Une très bonne recette sucré-salé, de l''originalité pour les brochettes sur barbecue de l''été, les bananes caramélisées donnent une touche douce au poulet curry qui n''est pas du tout sec, un must de l''été .', '2015-06-07T20:09:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, e508e588-b6e8-4461-b7c6-3eb93acd867b, 'Une des meilleurs recettes que j''ai pu trouver, celle-là je la garde sous le coude !', '2015-04-15T21:20:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 73a52123-6c5e-4c76-9d5c-823ea01d9abe, 'Testé cet été, un must have de la brochette ! Bravo !', '2013-11-08T19:02:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, c21cffc1-1039-4218-90bc-413c4b58151e, 'Très bon mais 2 heures ça ne suffit pas.', '2013-08-30T20:27:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, bc50a105-389d-4361-adc4-4f63c3c77490, 'Super recette que j''ai fait hier dimanche, j''ai eu beaucoup de succès. Laisser les peaux aux bananes est une très bonne idée. J''ai fait au four sur un plat crisp. Merci pour cette recette.', '2013-08-26T22:41:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 2118097e-7b7b-4d34-829d-104b54159fa9, 'C''est très bon, de la part de Vanessa et de Julie', '2013-07-14T10:43:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 91c17f3f-88a6-4245-a7d7-5a6d7ca1da38, 'Parfait !! Les invités en ont redemandé, à refaire !!! ', '2012-11-01T19:26:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 8e15b318-cc48-4a31-be6e-df80782caca6, 'Très bon  ', '2012-06-09T17:35:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, e0da35cc-6486-4099-a957-6e36bd5d9b71, 'Facile, rapide, original. J''ai également utilisé cette marinade pour des pilons de poulet.', '2012-06-05T12:33:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 8f33999b-18b7-48b5-a3bf-a328eeed6ba7, 'Simplement délicieux ! J''ai ajouté de la coriandre sèche et au moment de servir du persil plat émincé. Bravo et merci Marmiton ', '2011-11-22T11:44:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 2db1a7fd-bc09-41b0-a478-b348ee58d454, 'La saveur curry/banane est très sympa. Mais c''est trop sec même en faisant attention à ne pas trop cuire le poulet. Autre problème, les bananes noircissent très vite au barbecue.', '2009-08-24T01:18:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, bfc5d739-72dd-4fc1-8541-54be408b456c, 'Recette parfaite. Je l''ai accompagnée de riz mais l''ensemble était un peu sec... Je la referai certainement mais avec une petite sauce et/ou des légumes pour accompagner !', '2009-07-14T13:46:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 336036b3-1e3e-4dc7-983c-bed4cc8ab4e5, 'Très bon et effet garanti !', '2009-06-29T21:11:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 357f4215-3afc-4eba-bfa2-32d73c5002ac, 'J''ai pris l''habitude de faire ces brochettes pour mes barbecues... C''est très bon, ne rien changer à la recette ! Et en plus, c''est pas cher ! Testez-les et vous les adopterez comme moi !', '2009-05-21T21:21:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 3a04d0f0-3897-46d4-8e6c-7d0e07fa787b, 'C''est très bon et plein de saveurs ! Et puis, c''est joli dans l''assiette... La prochaine fois, j''ajouterai aussi du miel, afin d''adoucir l''acidité du citron vert. A refaire au plus vite (en plus c''est simple et rapide) !', '2008-12-13T10:54:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 2e6deeea-fa63-4f8a-b0ab-3e37372ddc0a, 'Simple à réaliser, beau et bon!!! J''ai préparé la marinade la veille pour que la viande prenne bien le gout. Je les ai testées au barbecue et au four...et aussi bon l''une que l''autre. Au four il faut compter 20 min à 180°C. Je les avais servis avec un tian de courgette.', '2008-09-09T13:28:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, c8e2b333-fad2-40fd-9432-56ef0f51afce, 'UN DELICE! Même mes enfants ont adoré (2 ans et demi et 5 ans). La banane cuite avec la peau donne une touche très originale, à refaire entre amis pour les épater. J''ai servi avec des brochettes de légumes cuites au barbecue.', '2008-05-24T19:04:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 20be9808-fa64-4b34-802b-e0a1436f2419, 'Essayer c''est l''adopter ! Je fais maintenant très souvent de ces brochettes, au four. Il m''arrive de remplacer la banane par de l''ananas. Un jour, j''ai essayé avec des pommes. Toujours aussi délicieux !', '2007-11-14T16:28:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, da67c751-f28f-4f37-84f1-fea02fbbbd86, 'Excellent et rapide cependant je laisse mariner 1 nuit. Le goût est plus prononcé. Bon également au four.', '2007-06-30T03:18:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 1fab102e-208a-4792-9a8a-99c9b1330db0, 'Délicieux ! Tout le monde s''est régalé. A faire et à refaire !!!', '2007-06-17T20:47:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, bce45403-02e8-43be-a3da-3c33398cc270, 'J''ai touvé cette recette très originale et vraiment facile et rapide à faire ! Je trouve cependant qu''il aurait fallu saler la viande, ça manqué un peu. Je confirme que la cuisson au four est recevable. La prochaine fois je le préparerai avec du riz au coco!', '2007-05-01T22:16:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, c6ad8b51-47ae-4092-be65-2dc29ba6c892, 'Mélange gustatif très apprécié par mes convives, servi avec un riz au curry. La prochaine fois, je testerai avec du miel ou un yaourt bulgare ajouté à la marinade. ', '2007-04-30T19:37:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, eca3adb8-4509-44b9-af44-d556a0b4090d, 'Super recette. Je la fais à chaque fois que j''ai des invités...c''est un régal et c''est original. Je laisse macérer le poulet plus longtemps (tout l''après-midi). En entrée, je prépare de la mâche avec des fraises!', '2007-02-21T18:23:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, b739ec00-7f3e-49d6-b9c7-e0c122003a73, 'Super recette même faite en hiver. J''ai juste rajouté 1 yaourt bulgare et 1 cuillère à soupe de curry en plus pour réhausser le tout qui était un peu léger à mon goût.', '2006-12-19T22:03:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 2e8cafb9-6f86-4f66-acc5-389571ca0f06, 'Bonne recette surtout très originale. En fin de cuisson des brochettes, j''ai rajouté un filet de miel pour renforcer le goût du curry et du gingembre que j''avais rajouté. La prochaine fois, en revanche, je mettrai un peu moins d''huile d''olive car je trouve que cela atténue les saveurs.', '2006-09-19T17:44:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 646a5921-9a6a-4b7e-b2d1-97674e048585, 'Ces brochettes sont excellentes accompagnées de riz! Rien à redire. J''ai juste préparé la marinade le matin pour l''après-midi les morceaux de poulet sont alors bien tendre et ont bien pris le goût du curry. ', '2006-07-27T14:16:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 82486f73-749f-4626-8111-e3584e76e106, 'Attention à ne pas choisir un curry trop fort, et à ne pas en mettre trop ;-)!!!', '2006-06-11T21:59:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 4ddd7e40-cc15-466d-8560-39408e90a74f, 'Excellente cette recette! Le mélange curry banane c''est au top. Tous les invités ont adoré.', '2006-05-09T14:31:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, f8e0534f-2b29-4ef8-896e-969e48a29276, 'Succulent! La banane confite dégustée avec les morceaux de poulets marinés...Hum, un régal ! Recette qu''on peut également faire l''hiver au four (ce que j''ai fait). Cuire 25 mn à 180°C.', '2005-08-12T18:18:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 85cbbfac-4a74-4644-967d-399bef0f8492, 'Excellente recette! J''ai juste ajouté un petit peu de gingembre en poudre à la marinade, aini que de l''ail... Le mélange bananes-curry est un délice!Merci pour cette recette...', '2004-05-07T13:01:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17656, 4cfe1345-600c-4600-91db-ab34fb9e5eb1, 'Très bonne recette!!! C''est devenu incontournable pour mes barbecues. La banane est excellente car elle est tiède, un peu fondue... J''en referai de suite rien que d''y repenser. A faire au plus vite! Merci mille fois pour ce délice!', '2004-05-01T13:14:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66437, 5354eca4-a1c7-4b1b-93f9-cc394079b897, 'Étant gourmande j''ai doublé la quantité de speculoos.', '2017-05-10T20:17:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66437, 6e13a654-3141-4e85-96d7-ac74cf523ec2, 'Le crumble ne se tient pas du tout. Mais la cuisson était parfaite, le mélange est intéressant.', '2016-02-29T12:24:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66437, aded898b-b735-43b5-b41c-4ad0d678416d, 'Pas trop fan de la banane et poire, autrement bravo.', '2014-07-13T22:17:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66437, 20289d77-bda4-4890-986b-71b18edd923d, 'Excellente recette ! Pas de bananes, donc remplacé par des pêches. Le mixte poire-pêche avec le chocolat fonctionne très bien. Suggestion : ajouter la couche de spéculoos en cours de cuisson car la mienne a failli bruler en l''ajoutant dès le départ...', '2011-06-13T22:30:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66437, fe8072b0-7a58-489b-ba2a-6a4bec3d2ebe, 'Assez bon mais dommage que les spéculoos soient juste saupoudrés au dessus, du coup rien ne se tient. C''est pas du tout présentable. Il faudrait trouver une solution pour que les spéculoos ressemblent plus à une pâte à crumble...', '2010-07-25T11:58:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66437, 2344f6b7-deb6-4356-8177-e237cd473ba2, 'La proportion moitié, moitié pour les fruits ne m''a pas séduite : il y avait trop de bananes à mon goût et cela m''a semblé un peu lourd..;', '2010-04-30T10:27:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66437, 6d019f3f-6fe0-4168-af60-383af231185c, 'L''alliance Poire Banane Chocolat, hum un délice... En plus, c''est plus que rapide à faire !!! Je le referai en augmentant la dose de chocolat et diminuant celle du sucre ...  Merci pour cette recette !', '2009-07-19T21:20:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66437, 9b4c6772-7294-4fde-b366-e6171e4d6952, 'J''ai suivi cette recette à la lettre! ai juste servi avec de la glace à la vanille!! hummmm un régal!!', '2009-02-23T20:47:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66437, 0a677913-4ad2-4a09-b7d0-79c468269d55, 'Alors je l''ai un peu amélioré, disons que j''ai gardé l''idée de faire un crumble avec des spéculos, et franchement, c''est super réussi, ça a remporté un franc succès!  Je ne digère pas les bananes, je n''en ai pas mis, j''ai mis un peu de noix et des amandes avec un peu de beurre.  Sinon, j''ai laissé les carrés de chocolat fondre lentement au four et le chocolat s''imprègne dans les poires!', '2008-09-22T20:34:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164979, 09feab9d-947b-4196-84c8-2994cde8faef, 'Très bonne recette. Mais à la sortie du four, les bananes étaient noircies et donc pas très jolies. ', '2014-01-22T18:44:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164979, efa5bfff-8db8-4ce9-8d76-d2441181b421, 'Très très bien et très bonne recette. ', '2012-11-18T19:00:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (164979, ff004f91-642a-461d-aa1c-d47fb691ff1d, 'J''ai cafouillé, j''ai d''abord cuit la pâte. Ensuite je me suis dit que c''était toute la préparation qui était à cuire, et j''ai recommencé. J''ai donc cuit 20 min à four chaleur tournante thermostat 6 (comme il y avait un temps de cuisson 30 mn).  C''est très bon. La crème pâtissière est facile à faire. Pour la pâte brisée, je suis allée dans la recette "pâte brisée rapide" et j''ai pris quelques conseils, notamment pour la quantité.  ', '2010-03-21T07:11:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11297, ac7a9d7a-fb1e-443b-b2fd-51d33f30b1f9, 'C''est super bon 
', '2020-04-26T14:00:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11297, dfd8a30e-c113-4408-a910-ca157bda9405, 'Bon au goût mais sans plus. La banane devient très molle, et il est difficile de la sortir. Par contre, l''aspect sucré du fruit disparait un peu, ce qui n''est pas mauvais. ', '2009-11-15T15:21:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80885, 787795fe-707b-402f-b34d-f1b80e3cd744, 'Malgré le moule beurré, la pâte colle.', '2019-01-22T19:16:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80885, 72d9c8a5-241b-4675-a211-f8bd63c09351, 'C"est bon mais le temps de cuisson doit être revu à la hausse (environ 45 min). Le trait de rhum est selon moi indispensable sinon c''est fade. Le gâteau s''est affaissé au milieu en refroidissant. ', '2009-11-29T22:09:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13764, 15ec5a3b-2f04-4532-98af-973dbdc568e0, 'Excellente recette ! Les invités ont adorés ce cocktail ! Concernant le sucre de canne, je n''ai mis que 25 cl ce qui était largement suffisant pour 1L de jus d''orange et 1l de jus d''ananas, et j''ai utilisé de la limonade light, Parfait !  Un grand merci ! ', '2014-02-08T14:51:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13764, 6f303671-9040-4bc7-acfd-059e0bab8abb, 'J''en ai proposé 2 grands saladiers soit 80 l, il n''en ai pas resté une goutte. J''ai été félicitée par mes convives. Ma sœur a ajouté de la cannelle et un peu de poivre pour un plus de peps !', '2011-07-15T23:41:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13764, 07a901ac-1785-4367-a603-4bf0bb8d432d, 'J''ai suivi les recommandations concernant le sucre de canne et tous mes invités ont adoré. Une idée sympa qui change des sodas et jus de fruits classiques.', '2009-09-14T16:50:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13764, 9863d4d0-6a22-4a0d-ba1e-5853699277f4, 'Très bonne recette, vite réalisée. J''ai partagé les proportions des liquides par deux, ce qui m''a permis d''utiliser comme contenant un simple saladier un peu grand. Tout est parfait, bravo, merci pour cette idée pour les fêtes.', '2008-12-21T12:41:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13764, 33c4adda-8d7f-4d48-90b1-6aecdea7a62a, 'J''ai suivi les quantités indiquées, sauf pour le sirop que j''ai réduit à 1/4l. La prochaine fois je n''en mettrais pas ou vraiment très peu, car même avec 1/4l je trouvais que le sirop dominait trop les autres saveurs, c''est dommage. Je conseillerais aussi de ne pas verser trop à l''avance la limonade, car avec le temps elle perd un peu de son pétillant. Nos invités nous ont taquiné en disant qu''ils ne comptaient pas non plus rester une semaine chez nous. C''est vrai qu''étant seulement 5, cette quantité de punch peut sembler trop élevé, pourtant en fin de soirée il ne restait plus rien! 4/5 à cause de la quantité de sirop trop élevé à mon goût. Un régal dont on peut varier les plaisirs, en changeant les fruits et les jus. ', '2008-11-16T13:08:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13764, 21c2f35d-cbd8-4dd7-a09b-638e82a5dbd7, 'Il serait meilleur avec moins de sucre de canne... 3/4 de litre, c''est trop!', '2008-06-16T00:55:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13764, 8cb4b392-b78c-45ea-b7d4-29a7dae24de1, 'Un délice tout simplement!!!', '2008-05-18T17:22:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13764, b39b0203-1017-48d4-9080-4dd9e9c2c406, 'Depuis 2004, j''ai réalisé ce punch plusieurs fois et avec toujours le même succès, adoré de tous on me demande toujours la recette. Merci beaucoup pour cette recette, car enfin un punch sans alcool...la fête est plus folle!!!!!!', '2006-09-25T13:51:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13764, f7bffe17-eb5a-4d71-bf01-89e283249e4f, 'Alors là...félicitations ! Vous le préparez la veille pour le lendemain et ce punch devient un délice. Et puis sans alcool c''est merveilleux... Merci mille fois !', '2006-04-06T22:56:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13764, 1277ba4b-3843-47c5-b480-b7d43418b5e7, 'Tous mes invités ont beaucoup aimé. Très rafraîchissant et très facile à réaliser. Je l''ai préparé la veille pour que les fruits soient bien macérés.', '2005-08-31T20:09:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13764, d736ecbd-ba37-4260-8e0b-301012b04cba, 'Très bon. Il en est resté après ce repas et nous l''avons bu sans aucun problème les jours suivants.', '2003-09-04T12:58:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13764, eda22b75-401a-4f73-8932-7fedcbd7f824, 'Très frais et facile à réaliser!!!', '2002-02-13T19:25:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37471, 91a67321-640b-414a-a3f2-6f9b4f1922fc, 'Délicieux, plein de saveur. N''ayant pas de bananes séchées, j''ai remplacé par des bananes fraîches (ça va aussi bien). Ne pas oublier pour contre de mettre un peu de farine autour des pommes histoire qu''elles ne restent pas en haut', '2009-03-09T20:52:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37471, d5f259cd-1532-4c9b-9534-81ee383935af, 'Délicieux, plein de saveurs pour les gourmands!', '2008-10-06T23:51:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37471, 681aa818-573a-4db3-bb9d-06e48504dbbb, 'Recette délicieuse, un vrai régal pour la bouche mais aussi pour les yeux et même le nez, je conseille cette recette à tout le monde. Merci à son créateur!', '2005-07-09T18:55:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88513, 6379cc39-77d4-484e-819b-db48c0677416, 'Parfait avec des fruits rouges surgelés', '2022-07-09T12:44:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88513, ff1a6a45-2903-412d-a9c1-871fd47cc654, 'A cause de la cuisson sinon c''est bon !', '2011-02-06T14:55:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88513, dd42cb0b-a0fc-40aa-b114-f9e536916dd0, 'J''ai fait le 1/3 pour 2 personnes. Pas mauvais, mais à manger le jour même.', '2010-03-29T18:02:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88513, ec42dfb6-67d3-4c56-871d-6fe90c40dd21, 'Je dois dire que j''ai été trés surprise du résultat.Pendant la préparation j''étais un peu septique car la consistance était vraiment bizarre.Mais ya rien à dire sur le résultat,les bananes adoucissent bien l''acidité des fruits rouges et c''est vrais que c''est assé léger comme dessert en petites tartes individuelles trés sympas.J''ai juste rajouté un sachet de sucre vanillé et mon mari qui est difficile a bien aimé,donc je vais la garder dans mes favoris.', '2009-10-25T18:54:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61215, 343757b4-9500-4643-aa58-342e55276474, 'Pour ma part je ferais 25cl de lait 25cl de glace à la vanille avec 2 cuillères à soupe de sucre.', '2015-06-08T15:51:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61215, 648c1cb0-92f5-4295-8e4b-baa9a030400a, 'Très bon et rafraîchissant.  Il faudrait juste ajouter un peu de sucre.', '2013-08-28T20:04:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44334, f40e0587-2930-4896-896e-2362fb2cbe3f, 'Bonne idée mais trop sucré. A tenter sans ajouter de sucre.', '2016-12-08T23:01:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44334, 8c67336e-57cf-4fb9-b4b7-9ec3370cede6, 'Délicieux et très apprécié ! J''ai préféré opter pour une cuisson au bain-marie (35 min).', '2014-07-10T01:10:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44334, ca024a87-655d-4f9f-8495-c74556ec779f, 'C''est délicieux mais c''est pas top au niveau du rendu visuel. Heureusement c''est très parfumé. Un régal avec la noix de coco râpée/pointe de rhum. La prochaine fois, je vais tenter avec des raisins blancs et moins de sucre.', '2012-09-14T17:27:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44334, d966e178-e4a7-4f5d-9607-fcd54348ea24, 'Très bon mais pas très présentable sans une bonne déco. Je conseille de la coco râpée sur le dessus et poser le flan sur du chocolat noir fondu et chaud.', '2008-08-26T21:19:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44334, 9e635191-9a80-4e19-b643-ba0eb3e52389, 'Cette recette fait maintenant partie de mon répertoire. Tout le monde apprécie, je n''utilise que du lait de coco, pas de lait de vache. Je sers généralement les petits flans dans une assiette composée avec d''autres desserts, notamment des fruits (kiwi, quartiers d''orange à vif, ananas...). Nous aimons beaucoup l''aspect et le goût caramélisé qui se forme à la cuisson.', '2008-02-18T21:44:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44334, d8feae08-8eb7-4d9d-96d6-03e6b15dc523, 'Dessert très bon, pour les grands et les petits. Je me suis servie de 3 bananes très mures et d''arôme de vanille, la dose de sucre aurait pu ainsi être diminuée. Le lait de coco a été remplacé par du lait de vache; et la cuisson a été faite au bain marie pendant 30 minutes. Le démoulage s''est très bien effectué aussi bien dans des moules en silicone que dans des ramequins en terre émaillée (graissage au beurre comme indiqué dans la recette et démoulage à la sortie du four).', '2007-08-09T15:42:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44334, 3368d6e6-4685-4208-b958-35957ff1c91f, 'C''est trop sucré, et ça retombe une fois sorti du four, malgré le bel aspect pendant la cuisson... Dommage!', '2006-08-05T15:28:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44334, 81f107cc-bee1-475b-b240-5cd852b2d61f, 'J''ai trouvé cela excellent, même si la consistance de la banane rend ces flans plus proches du clafoutis. Pour obtenir une texture bien lisse il faut mixer longuement les bananes, et ne pas les faire cuire trop longtemps (30 minutes maximum à mon avis, et au bain-marie).', '2006-06-30T18:07:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44334, 444c206b-f5b8-4854-9259-6645e78e0f03, 'La consistance n''est pas top mais le goût est agréable. J''ai fait revenir les bananes (comme pour des bananes flambées) et c''est meilleur car celles qu''on achète ne sont jamais très mûres.', '2006-06-16T10:22:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44334, 0018b8d1-0c12-493a-9a68-3f2335ecf6ba, 'Un petit peu déçue. Je suis assez fana des nouveaux goût mais la je reconnais que c''était assez lourd (c''est vrai que j''ai du tout finir puisque le restant de la famille n''a pas aimé) Je ne pense pas que je réitérerai l''exprérience. Mais le recette est facile à faire!', '2006-06-06T23:13:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44334, b500a297-c285-44e4-b35f-d22285a358bf, 'La recette semblait prometteuse mais je n''ai pas été conquise par ces petits flans: une consistance grumeleuse qui ne flatte pas les papilles... Peut-être faudrait-il apporter quelques modifications à la recette. ', '2006-06-02T20:20:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44334, 543f1d5e-43c0-49bf-96e3-47c3f9cf8c90, 'Excellente recette. Surtout n''hésitez pas à prendre des bananes bien mûres. Pour ce qui est de la cuisson, j''ai suivi le conseil de faire cuire les flans au bain marie. A faire et à refaire. ', '2006-02-18T19:55:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44334, 7b5a0559-163a-4680-96cd-b39d028dac26, 'Excellent! Contrairement aux avis précédents je n''ai trouvé ni lourd ni sec... mais fondants et délicieusement parfumés. Par précaution je les avais fait cuire au bain-marie.... Attention il ne faut pas mettre la noix de coco dans la pâte mais la réserver pour le décor !', '2006-02-15T21:30:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44334, b5c67793-00cb-4147-8457-071c34f1fb2d, 'Pas vraiment concluant. La texture est lourde même si le goût est pas mal. Il faudrait peut-être battre les blancs en neige pour aérer le flan. J''ai rajouté un peu de coco râpé dans certains et nous avons largement préféré mais il faudrait alléger le tout...', '2006-02-02T16:44:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44334, 5126d5ff-094c-4dd1-b07e-c28aeb420169, 'Bien parfumé, mais un peu trop sec.', '2006-02-02T15:18:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, e2a7c01e-6e97-4040-a721-5d565977b9cc, 'Excellente recette!
J''ai suivi un conseil en réduisant le sucre (100g au lieu de 170g). Carré de chocolat praliné au milieu. 20 minutes de cuisson.
Mon dieu que c''est bon!', '2023-10-08T13:30:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 5b557c00-fd4c-4cf2-93af-4c36c3e88345, 'J''ai mis la noix de coco directement dans la préparation.  C''est super bon et super moelleux.  J''ai trouvé LA recette des muffins chocolat !!!', '2023-01-29T08:22:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 70477fe7-a946-4d03-b758-c71be0468abe, 'Presque parfait, bon aussi avec du chocolat au lait. N''hésitez pas à mettre bcp de levure !', '2022-11-29T21:42:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 52f4169d-50af-4a47-953e-b8c04cff2a9f, 'Réalisé avec des pépites de chocolat noir. Excellent ! Je mettrai un peu moins de sucre la prochaine fois.', '2022-09-11T15:30:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, a2cb7216-f407-4d48-9389-5a73c9ac0343, 'Recette pratique pour un pic nique, les enfants en raffole! 
Je ne mets pas de pépite, mais cœur Nutella ou spéculos ', '2022-04-17T20:33:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 851e294a-797d-49de-bd5b-3384b8bbb4f1, 'J''avais 3 banane très mures, c''est une parfaite recette pour les finir, et ça se marie très bien avec le chocolat blanc ', '2017-05-23T13:30:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 810e203f-d481-40ef-b2b2-6ae60ae0c217, 'Super recette !! Pour ma part je n''ai mis que 100 g de sucre et du sucre de canne. J''ai remplacé le chocolat blanc par une petite cuillère de Nutella entre deux couche de pâte et je n''ai pas mis de coco. Les muffins sont moelleux et super bon tout le monde a adoré ! Les manger de préférence tiède.', '2017-01-18T22:28:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, e9ad444a-b9a5-48e5-9ab9-171485d82806, 'Excellent!! Par contre je n''ai mis que 100 g de sucre et c''est largement suffisant. ', '2015-12-29T14:55:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 0f738353-cf8a-489f-b613-574ea00af333, 'Tout simplement excellent !  J''ai respecté la recette sauf pour l''oeuf, j''en ai mis 2 (il ne m''en restait que 2 au frigo donc je n''allais pas laisser le dernier tout seul. Pour le chocolat blanc je n''en avais que 60 grammes. Sortis du four ils sont croustillants au-dessus et caramélisés et l''intérieur est si moelleux.. Un délire. J''en referai sans aucun doute. Un vrai succès. ', '2015-10-12T20:46:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 37aa001f-2324-4293-9c65-83c5e02be318, 'Une tuerie ! On peut réduire un peu le sucre et varier les chocolats.', '2015-01-12T21:13:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, c8656077-7504-4a5a-a61c-ef10d3e16f8f, 'Excellent ! J''ai juste diminué le sucre mais sinon rien à dire, moelleux, faciles à faire... Un régal ! ', '2014-07-23T15:07:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 77356ec8-807b-455b-a02a-16ff585f805d, 'Recette facile à faire, qui donne des muffins très très bons !', '2014-07-15T23:58:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 64496abd-7da1-44c1-8e8c-983501afff93, 'J''ai suivi la recette à la lettre et la texture est excellente ! On ne sent juste pas assez le chocolat blanc, dommage...  A refaire en augmentant la dose ;)', '2014-04-07T00:02:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 2211555e-c72c-42ca-8f31-9558c2bcbe35, 'Vraiment très bon ! Fait avec 80 g de chocolat noir. Le reste, c''est tout comme dans la recette et c''est un délice, merci !', '2014-04-02T01:09:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 45e446cb-8f3d-4f73-95d2-d5fa20248c08, 'Je n''ai pas mis de coco mais j''ai râpé du chocolat blanc au dessus au moment de servir. Très moelleux ! Merci.', '2014-02-22T15:09:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 2a2cb034-f6c4-4b45-a6ef-110a3222f463, 'Délicieux ! Perso j''ai zappé les pépites de chocolat et mis à la place une grosse noix de Nutella entre deux couches de pâte pour avoir un délicieux coeur fondant ! Hummmmmmmm.... un vrai délice !', '2014-02-17T18:28:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, ba41b61f-ba93-495c-887d-74ef411505ad, 'Je suis bluffée par cette recette ! Je viens de la réaliser : le dessus des muffins est croustillant à souhait, l''intérieur fondant, et la banane se marie au chocolat blanc à merveille ! Commentaire de mon homme : "ça cartonne !"', '2013-11-21T20:43:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 7c7f7b75-da25-45eb-8ca8-565a40d7c5a7, 'Facile et rapide à faire. C''est bon, mais...il faudrait peut être ajouter un petit quelque choses qui contre-balance le sucré (un épice ?).', '2013-11-03T17:54:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 849b5c2d-32b5-42dc-95e5-261e6ec2cfa3, 'Parfait ! un délice !!! moi qui suis une piètre pâtissière, tout le monde a adoré et en a repris. J''ai juste préféré les faire au chocolat au lait , recette à refaire.  ', '2013-11-03T16:10:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 3814119d-6ad2-46f7-8502-1d04e7ea73a0, 'Recette testée aujourd''hui... Recette impeccable... On sent très bien la saveur de la banane... Le chocolat blanc pas trop. Mais c est très très bon ! A essayer !', '2013-10-06T21:00:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 81ac0ed8-a069-48b3-9d81-4f15d957f1d5, 'Une tuerie !! Ces muffins ont fait fureur !!!', '2013-09-28T23:46:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 671c952c-f682-45b3-8278-da9e383aaf32, 'Recette facile, rapide et juste excellente ! ', '2013-03-18T22:07:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, a8982757-0267-4689-8399-631a0f5b0278, 'Délicieux! Muffins fondants et moelleux!', '2013-02-16T18:03:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 836243aa-0ff6-4112-aef9-1dbee3651fe8, 'Je viens de faire les muffins, un régal. J''ai envoyé la recette à une amie.', '2013-02-09T19:09:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 9ff0c8c8-de35-4092-9f1b-5b461daa324f, 'C''est trop bon, j''ai épaté mes parents !!', '2012-09-01T18:50:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, c41cce91-c542-40f3-a357-8b38a8c96ecb, 'Excellent !! Merci !', '2012-06-24T21:53:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, e488a4a3-85e6-427d-8b1d-f04dc967353c, 'Une pure merveille ! J''ai mis un peu moins de sucre et de farine et j''aurais bien ajouté un peu plus de chocolat blanc (juste par gourmandise) mais j''en avais pas assez. En tout cas merci pour cette recette ', '2012-06-05T12:42:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, ca69cc0e-f534-4354-a038-70c7591112fe, 'extra à refaire sans attendre  j''ai juste mis 120g de chocolat pour mieux le sentir ... bienvenue aux gourmands  ', '2012-05-08T08:55:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, d49ae5ca-dcda-4819-b209-84df8e1ee8cb, 'Recette étonnante mais délicieuse. J''ai tenu compte des commentaires pour les proportions. Une seule variante. A la place de pépites de chocolat blanc, j''ai mis des pépites au "butterscotch". Ce sont des pépites au beurre salé que j''ai ramenées des USA. Je n''en ai jamais trouvées en France. Tout le monde a adoré.', '2012-01-27T22:01:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 2de11e7d-b8ff-4f61-bbd7-acab21b8dbbb, 'Excellente recette !!! A refaire !!!!', '2011-07-20T02:00:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 0eb4bd17-ee8e-42c0-8237-58fd05f7bc49, 'J''ai suivi les commentaires : 100 g de chocolat, 100 g de sucre et 60 g de beurre. Moelleux à souhait. Merci pour cette excellente recette !', '2011-06-04T23:00:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 7259b2cb-74f1-4af5-854a-4a176efdb143, 'Succulents ! Je regrette qu''on ne sente pas plus le goût du chocolat, du coup je vais tenter aussi au chocolat noir, mais sinon c''est divin, et les muffins sont partis bien vite !', '2011-05-29T01:45:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 8e67cb53-3b00-450b-a59a-51c88437e787, 'On sent bien le gout de la banane par contre je reproche au chocolat blanc de n''être pas assez présent bien que j''en ai mis 100g. Les muffins sont très moelleux je la referai mais avec un chocolat noir car je pense que ce sera encore meilleur!', '2010-11-09T11:59:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 3962b675-eb59-498a-9c7d-5799156c98c6, 'Très faciles à faire, cuisson sans problème. je les ai fait en version gros muffin et minis et c''est délicieuse dans les 2 cas. On pourrait penser que c''est lourd, mais pas tant que ça (au niveau de l''estomac sinon... c''est direct dans les fesses). A éviter quand on est au régime.', '2010-08-26T11:57:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 69f3a58e-e1cb-40f4-9cce-f48e2d107ed2, 'Excellents. Je les ai préparés il y a trois jours et ils se conservent effectivement très bien au réfrigérateur dans une boîte hermétique. Par contre, ils perdent leur croustillant si délicieux au sortir du four.', '2010-06-07T18:14:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 416eba4c-9f1e-4c85-984a-56f12f6b3ed2, 'Rien à ajouter ni enlever. C''est consistant et nourrissant mais cela reste tendre et bon.', '2010-01-22T20:04:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 4bc792ad-cf0a-4c34-aac0-cae1d7dec4aa, 'Tout simplement succulent ! Moi j''ai un peu modifier la recette. Je remplace la moitié de farine par de la maïzena, je mets que 40 g de beurre, je mets par contre 140 g de pépites et je mets 4 bananes (passées au mixeur avec l''œuf et le beurre) ma pâte et ainsi plus parfumée et plus liquide. Tout ça dans des petits moules en silicone pendant 20 min environ. Bonne dégustation à tous !', '2009-08-17T15:45:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 14d28908-1aef-47e2-867b-a7bfeb394218, 'Le résultat est succulent !! Les muffins sont à tomber. Je n''ai jamais essayé cette recette avec du chocolat blanc, je prends du chocolat noir que je coupe en morceaux pour fabriquer les pépites. Huuum, un vrai régal !  Je rajoute aussi un tout petit peu de fleur d''oranger, et je garde quelques pépites et une rondelle de banane par muffin. Je mets également tout le sachet de levure. Un délice !!!', '2009-05-16T17:04:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, ba37f447-f076-4005-af1e-3bae72d0e3f6, 'Un délice ! Je n''avais plus que 20 g de beurre, et les muffins étaient une pure merveille. A  mon avis, une recette inratable.', '2009-05-15T15:38:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, af4ddfca-b98f-437d-bda9-ca3386736539, 'Délicieux!!!  Ces muffins sont moelleux à souhait ! Parfait pour les fans de banane et chocolat blanc ! A la place de la noix de coco, j''ai remplacé par du sucre vanillé pour caraméliser le dessus. Plutôt 25 minutes de cuisson que 20 ! Testez les vite !!! ', '2009-05-03T17:53:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, b01c2178-3562-4251-a9da-8b6339f8237b, 'Cette recette est vraiment facile pour un résultat délicieux. Je mélange des pépites de chocolat blanc et de chocolat au lait pour varier les goûts et les couleurs !', '2009-04-23T21:47:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 2f44b36e-9586-4000-a526-09d42427f83b, 'Pareil je suis d''accord pour dire que cette recette est trop bonne! A essayer...', '2009-04-14T15:36:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 7e3d392a-85f3-43be-a1bc-e9747e61ca15, 'Excellent !!! Je n''ai eu que des compliments, ils sont divins et se conservent très bien dans un tupperware plusieurs jours. La recette est très facile et le résultat succulent : que du bonheur. Merci', '2009-04-10T00:43:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 0f6d6e89-50d4-4c6e-afb2-eb427554515a, 'Recette faite ce jour!! les muffins ont été engloutis par mes 2 gourmands. Ils sont super bon. J''ai mis 140 g de sucre pour 100 g de chocolat blanc. J''ai fait cuire à 180° pendant 22 minutes. Extra !!! A garder et à refaire encore et encore !', '2009-04-05T19:54:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 92fd7b6b-3286-40a5-b8c7-293966708b04, 'J''ai testé cette recette en remplaçant le chocolat blanc par du chocolat noir, et en supprimant le beurre (j''ai oublié d''en acheter). Mon copain et moi nous sommes tout simplement régalé avec ces muffins ! A refaire sans faute !!! ', '2009-04-04T14:34:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 51c26433-ef1f-4e36-801e-12a490e3e68e, 'Un vrai délice, tout le monde en a redemandé. J''ai toutefois un peu modifié la recette faute de chocolat blanc en mettant moitié chocolat noir / moitié praliné. Hummm. Lancez vous!!!', '2009-04-03T14:12:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, aca2ce7b-2209-4c75-8e90-20964f472ff6, 'Je suis d''accord,tester cette recette c''est l''adopter! C''est vraiment léger et excellent, idem avec du chocolat noir, merci!', '2009-03-12T22:52:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, b3325a04-f393-4d61-806f-05e2b3281d14, 'Merci beaucoup pour cette recette originale et tout simplement délicieuse!! Rien que l''odeur qui s''est dégagée dans ma cuisine durant la cuisson m''a donné l''eau à la bouche. Une fois sortis du four, ils ne sont pas restés très longtemps sur le plat. Recette à faire et à refaire et ça change des éternels fondants au chocolat. N''hésitez pas à tester cette recette car la tester c''est l''adopter.', '2009-02-12T11:51:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 92ed7035-bb15-443c-a566-4dc91bd27940, 'J''avais divisé les proportions par 2 mais je l''ai vite regretté...c''est délicieux! Je les ai mis 25 minutes à 180°, avec moins de sucre aussi, extra moelleux et dorés dessus ! Miam.', '2009-01-16T15:21:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, f904d0c8-cbaa-4b03-b01c-93aad6072181, 'Très bonne recette ! 100 g de chocolat blanc aussi pour moi. Elle fait partie de mes recettes préférées !', '2008-11-24T18:08:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, f25007f9-652d-4da9-8dd6-0c0c556ab877, 'Super recette! Je viens de les tester en mettant 100 g de chocolat et 140 g de sucre, c''était vraiment très bon, mon ami s''est régalé ! ', '2008-09-21T20:26:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, b8250434-8f28-4842-9269-1c9bd4615581, 'Un grand classique maintenant! Presque une spécialité ! Pour moi le four n''est qu''à 180°C, mais toujours 20, tendance 25 min plutôt, et bien sûr avec le petit rab de chocolat ! Il faut bien 100 g !', '2008-09-19T14:37:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, da17e75b-71e3-407e-9a6a-ac7186f0d0d2, 'Très bon, j''ai également mit 100 g de chocolat blanc, parfait...merci', '2008-09-10T20:23:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, a6a352e0-46f5-4d59-9675-1bd1a4c74133, 'J''ai suivi les commentaires de Claire et c''est vraiment un régal. Je l''ai fait avec ma fille de 6 ans et on a été épatés. Merci pour cette recette. ', '2007-11-04T04:15:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, de1d2a40-1618-4cc1-ab5a-fde4b86b421f, 'Délicieux et facile! Je mets plus de chocolat blanc (100g) et un peu moins de sucre (150g) surtout si les bananes sont bien mûres. Un conseil, mettez la moitié des morceaux de chocolat sur le dessus du muffin. Au four, ils vont caraméliser.', '2007-10-01T19:21:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56530, 64ce78fa-35ca-48c2-9f76-bf4e071bf391, 'C''est vraiment délicieux!!!', '2007-06-06T18:40:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68572, fd7b2087-d4e2-4dfe-a2c4-b168a3cb62e1, 'Avec la quantité pour la pâte je suis pas arrivée à faire 2 cercles...', '2012-12-14T16:03:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68572, 82ecb8a0-259c-4efe-9c35-be34d866d59c, 'Bien, facile à faire, une recette bien sympathique pour utiliser des bananes bien mûres !  ', '2009-11-11T14:19:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68572, 8277c6e9-3b77-4cc6-a587-9363e86c3d28, 'Pas très bon la tourte est amer. En rajoutant de la compote de pommes ou poires ou tout autre fruit je pense que ce sera meilleur.', '2009-09-07T20:59:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (68572, b0b8e0ef-7e8c-4e38-84ac-66d3dfcd773c, 'Je viens de tester cette recette et je trouve la pâte un peu fade (peut être faudrait il y ajouter un peu de sucre, ou faire une pâte sablée). Néanmoins le mélange banane coco est sympa mais je conseillerai de déguster cette tourte froide pour mieux sentir le goût de la banane. ', '2008-04-30T23:44:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (231291, 7b298fe9-6ed4-451f-b4d0-2788477c7ec3, 'Super recette, on adore ! J''ai fait une ganache montée, car pas assez de glaçage et plus léger aussi...', '2018-05-19T20:53:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (231291, bf38e52d-2336-4e18-b99a-6dbeeb616c76, 'Bonne recette. J''ai mis un sachet et demi de levure chimique. Les muffins étaient très moelleux. Toute la famille a aimé. ', '2017-02-27T14:00:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (231291, b765e597-09e1-456f-be6d-bf5b2f9e1207, 'C''est facile comme recette et moelleux, merci!', '2016-08-06T10:26:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (231291, 1b8e1ca4-9168-4a35-9c69-7000445f266e, 'Très facile à faire et les muffins sont super moelleux.', '2014-09-18T14:24:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (231291, a23d66f8-78cf-4b92-8563-c09c27faa9ab, 'Recette facile, les muffins sont moelleux et bien mouillés comme peu le faire la banane, la ganache fini bien le tout !! A refaire vous pouvez y aller les yeux fermés.', '2013-10-27T17:38:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (231291, d090d81c-7b9b-45bb-bf12-49986c1617e8, 'Recette excellente ! Facile rapide et délicieuse ! Une pâte légère et une ganache excellente également. Pour ma part, je n''ai pas mis de noix de coco car j''avais peur que ce soit trop lourd. Merci pour cette recette qu''on me redemande déjà.', '2013-10-03T12:51:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (231291, 208e9bab-2951-4018-a740-f2806e8d6f83, 'Aussitôt cette recette publiée, aussitôt je l''ai testée et elle est parfaite ! Tout le monde à beaucoup apprécié, je referai ces petits muffins sans hésiter, rien à dire !', '2013-05-11T00:16:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73065, de1a9178-08e4-4fcd-a38d-f51f76903a00, 'J''ai suivi la recette et elle reste liquide!', '2015-11-03T17:40:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84567, d3215c43-5d72-4d15-8101-d382b13c44f6, 'Mettre plus d''abricot, gâteau banal. Le miel est une bonne idée.', '2020-02-29T19:20:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84567, 015a050d-8c7d-4df9-a124-ba95e75b94b1, 'Très bon mais ne pas utiliser un miel ayant trop de caractère (j''ai utilisé un miel de myrtille particulièrement utilisé en pâtisserie). Le mien a pris le pas sur tout le reste. Il faut vraiment doser correctement. Sinon abricot/miel, ca marche super bien :)', '2019-02-15T08:26:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84567, f85f2819-66db-4604-aebe-5953a4d227e4, 'Facile, les enfants ont adoré pourtant il n''y a pas de chocolat !', '2012-09-23T20:31:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84567, 0462e0ad-e43e-4e34-8641-ca21eb4eaf8f, 'Facile à faire et très bon.', '2009-05-04T18:49:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (84567, f3b4d790-8718-4c0a-b200-be0cb936f3da, 'Je l''ai fait cuire dans des moules à muffins, 180°C, 30 min, mais sans miel. Délicieux. Merci ! ', '2009-04-11T21:35:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29882, 8dc9fdce-2273-4426-91cf-bf35af96807e, 'Mélange des fruits très sympa. Merci.', '2019-10-21T19:15:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29882, 546e1fc9-1807-48f5-bcbf-cd9e39ceb1df, 'Je vais la faire au réveillon : léger après noël.', '2018-12-29T03:50:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29882, 4b9edd15-6491-4c6c-a68f-18346930da14, 'Délicieuse tout le monde a apprécié petits et grands ...', '2015-06-07T15:24:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29882, 68cbaccc-206c-441c-9768-9cd8e3059b8b, 'Une vraie réussite ! La fleur d''oranger amène une touche de subtilité à cette salade de fruits très rafraîchissante.', '2015-03-28T11:05:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29882, 6d941039-3220-4fd7-a781-29ae7e9836eb, 'Cette salade a été appréciée par toute la famille et je n''hésiterai pas à la refaire', '2014-07-12T00:25:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29882, 90a50bf6-99a3-44d6-942a-fe39e8b0666f, 'Très bonne idée recette : la fleur d''oranger associé au sucre roux donne un goût frais et original. Simple à réaliser : je pense qu''elle deviendra un de mes classique cet été ', '2012-05-18T11:31:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29882, e8163005-5ce8-426f-b2c4-b8c737154b80, 'Excellent, je l''ai fait avec des pommes, des poires, des kiwis, de l''ananas et les première fraises et tout le monde à adoré. La fleur d''oranger donne un très bon goût.', '2011-04-23T17:13:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29882, 2704d9a8-f6fa-4866-9799-18eab3dead24, 'Merci pour votre recette pratique facile et rapide et surtout délicieuse mon mari et moi avons englouti la salade a nous 2 !! ', '2010-05-26T00:49:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29882, b25744d3-af54-495b-8e36-4c2169af3c62, 'C''était vraiment très bon ! Moi j''ai mis fraises, kiwis, oranges et pommes et par dessus: 1 boule de glace vanille et une meringue émiettée ! Tout le monde a adoré petits et grands !', '2009-05-23T15:54:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29882, d28880b7-c43b-414b-8251-0d4a152c4c32, 'Salade de fruits très très fraîche, et la fleur d''oranger avec le sucre roux est une excellente idée, et en même temps, très originale.', '2009-05-13T10:39:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29882, 466b1dca-26f6-4c4e-b0e6-e358ddaf199f, 'C''était ma première salade de fruits et petits et grands ont étés conquis...', '2008-11-29T10:53:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34207, 38bffd45-de66-44fb-a50a-55559e94c13e, 'Présentez le tilapia entier accompagné de morceaux de tomate, d''oignon et concombre. Le tout assaisonné de vinaigrette maison. Servir avec des bananes plantain et bâton de manioc. Surtout ne pas oublier la bouteille d''arôme que l''on trouve sur toutes les tables africaines! Un régal à manger à la main.', '2009-03-29T20:50:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34207, d963e5ab-edc8-493f-8583-2bc161afa380, 'Parfait, c''est le seul plat de poisson où les enfants se resservent, ils adorent et nous aussi. Info pratique : pour 4 adultes ou 2 adultes + 3 enfants : four préchauffé à 175° (thermostat 6) et cuisson 40 min, 1/2 racine de de gingembre épluché (30 g), 6 tomates moyennes, 30 g de bouillon de légume, 1 banane mûre par personne ou du riz. Pour les tilapias, je les découpe en petits cubes de 3 cm.', '2011-06-11T14:24:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34207, 8e145570-b9f1-48db-a88d-4f5e46bb93e8, 'Excellent, tendre, sauce mmmm. Cuit avec du riz. Le tilapia si il est péché dans la mer du nord est un poisson qui n''est pas surpéché : toujours bien d''y penser :-)', '2008-05-26T01:24:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34207, b704b1d8-c78e-4913-8067-8366645233bf, 'Testé avec du poulet émincé et revenu dans une poêle. Se marie très bien avec les bananes plantin. J''ai mis seulement 3 gousses d''ail et c''était parfait.', '2008-03-19T19:14:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34207, ec8734e4-79a9-483a-a9d6-d6c444594622, 'Miam! Beaucoup de succès chez moi, un peu moins chez monsieur. Fait avec des filets de Tilapia, plus rapide, et servi avec du riz blanc pour "saucer", c''était très bon! Merci pour cette recette!! ', '2007-10-04T03:55:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34207, 1fda34fa-ec11-4580-8d36-353d019d0d66, 'Il me semble que c''est la recette du poisson braisé - aloko, chère aux Ivoiriens, que je fais régulièrement, on connait aussi le tilapia sous le nom de Wass (Ouasse) pour le Sénégalais.', '2007-07-19T00:15:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34207, 28e84f12-089f-4e63-973f-14fac193d512, 'Délicieuse petite recette, où les saveurs se marient à merveille : le gingembre avec la tomate, les plantins avec le basilic, les oignons, le poisson, l''ail... Très frais et léger... Mmmm...', '2007-05-08T02:38:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34207, e51f537d-356c-4814-8783-89b0ff4be483, 'Bon, original et léger.', '2006-04-16T23:39:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34207, 7f072e2f-f876-4520-8a50-68851c0dca4e, 'Très fin et très bon. Le gingembre et la tomate se marient à merveille. Peut également se servir avec du riz brisé...A mon avis la banane plantain convient mieux, en garniture, avec une viande blanche qu''avec du poisson. ', '2006-02-02T18:54:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34207, 06c0e8e3-109f-4c32-aa9d-3d747e8d0f8f, 'Simple à faire et délicieux.', '2005-10-22T10:33:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13279, 351534d4-142d-458c-8ee2-19dd464ef18f, 'Bon, mais trop sucré à mon goût et trop de pâte pour mon moule à tarte pourtant standard.', '2008-11-20T18:35:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13279, be831dd2-2bae-429d-af8a-7d06ee7e64ca, 'Nous n''avons pas trouvé ça trop lourd à digérer, bien au contraire. Très belle surprise. Allez-y, un vrai régal.', '2008-08-10T21:12:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13279, a1c3b3c1-420a-4a0e-8040-4f64d05cc86f, 'J''ai réduit la quantité de sucre. En faisant la pâte brisée, ajoutez 1 cuillère à soupe de vinaigre et votre tarte restera croquante.', '2004-01-29T10:14:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13279, 321db218-5014-418d-99fb-43b5e28a8af3, 'Faire précuire la pâte une dizaine de minutes avant, sinon c''est tout mou!!', '2003-04-15T17:19:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13279, 03355e0b-77e5-4c05-877b-233aaf06c4e2, 'Très bon, mais un peu trop sucré.', '2002-08-26T10:28:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13279, 58a02135-d332-452b-a45b-284249194daf, 'Très facile à faire et mes enfants ont adoré alors qu''ils n''aiment pas spécialement les tartes...', '2001-11-29T12:18:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13279, ac3c965d-89da-4963-9015-06d8ed9e3b52, 'Très bonne recette.', '2001-03-05T10:09:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (72501, 6510a3c1-b358-4f91-891f-f9277edd011d, 'Une recette simple et très fraîche ! ', '2009-08-13T14:05:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, 9af1046e-1653-4fbd-951d-bf974623dbc0, 'Superbe recette, par contre je fais un peu caraméliser les pommes (du verger) et les bananes avec du sucre vanillé et rajoute de la cannelle après avoir caramélisé les fruits je rajoute 2 cuillères à soupe de crème. Je ne met que 100 g de beurre sucre farine et met 15 spéculos. ', '2014-04-15T03:32:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, 6f47560e-f45e-4808-a39d-127f5da78dc4, 'Bon mais très copieux. La prochaine fois je le ferai en plus petite quantité ! ', '2013-11-11T21:16:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, f06fbae1-bc52-48f4-bdce-591caa398575, 'Exceptionnel !!! Gros succès à chaque fois.', '2013-02-25T21:57:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, 453a613f-5a4c-4ad0-8e74-eccc9d9789a9, 'Il est magique ce crumble ! Deux fois que je le réalise, deux fois qu''il a le même succès. Très simple à réaliser, et encore plus à déguster ! Avec du cidre en accompagnement, c''est parfait. Je pense essayer de rajouter quelques framboises la prochaine fois. Merci pour cette recette ! ', '2012-05-24T11:38:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, 39548645-153c-4808-b29d-10de4b9d591a, 'Excellent crumble! Mes invités étaient conquis.', '2012-05-06T01:34:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, c27fbee8-3d8d-4bc0-8c1f-e339983749ca, 'Rien à dire en négatif, tout simplement délicieux.', '2012-04-21T10:32:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, bc4afb44-efce-4ead-832a-314ecdf71fa0, 'Délicieux', '2012-03-18T14:20:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, ab821973-1da4-478f-bef8-9a03f2b216aa, 'Véritable succès pour ce dessert, facile à réaliser et mangé en un éclair. J''ai diminué les quantités de beurre, sucre, farine (100 g), à refaire encore et encore.', '2012-03-13T10:00:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, 01a3c59f-fd7e-447e-bf51-b3cbe45e71b7, 'Comme d''habitude, toujours conquise... La pâte est délicieuse et j''ai mélangé mes pommes à du gingembre en poudre, cannelle, essence de vanille et un peu de rhum... Excellent !', '2012-03-13T06:49:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, 6b272cfa-9749-4a0f-b84f-9948ca2953ea, 'Le mélange bananes et pommes vertes est excellent. J''ai mis 2 fois moins de sucre et de beurre et c''était parfait. Déjà fait 2 fois et très apprécié des petits comme des grands.', '2012-03-01T20:49:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, b98d556b-3ade-4af4-b449-8b676e5724a5, 'Excellent ! J'' ai utilisé des pommes du jardin (pas vertes !). J''ai diminué comme conseillé beurre et sucre (j''ai mis 100g de chaque). J''ai ajouté cannelle et gingembre en poudre. Et avec les fruits coupés j''ai mis 1 jus de citron et 2 cuillères à soupe de fleur d''oranger. J''ai cuit 40 minutes. Le résultat était excellent. Pour la quantité de sucre, je crois que ça dépend du goût de chacun : mon ami me dit de diminuer encore un peu la prochaine fois, moi j''aime bien sucré...', '2011-10-01T13:32:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, 4e37d8dc-2363-4fd6-a7a1-a18bd516caf3, 'Super bon ! On a adoré !', '2011-07-11T00:01:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, 3ecf7d0a-71df-4c78-9111-6b689ed6730f, 'Une recette de crumble qui change. Mais cela reste un peu lourd même avec un peu moins de sucre et de beurre. A privilégier après un repas léger.', '2010-08-08T20:46:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, e1a9691d-a3d8-47e6-b2f7-f1a8290a9f0f, 'Le crumble est meilleur avec les spéculos qu''avec la poudre d''amande à mon goût. Je mettrai peut être un peu moins de beurre la prochaine fois pour que le crumble soit moins collant. Mais c''est une excellente recette la pomme et la banane se marient à merveille.', '2010-06-01T22:56:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, f0d21238-ebf1-4fd3-9376-a24137588d9e, 'C''était très bon. D''habitude je mets de la poudre d''amandes et là avec les spéculos, ça change tout. Par contre, la prochaine fois je mettrais un peu moins de sucre et un peu moins de beurre. Mais les invités ont adorés... avec de la cannelle en poudre.', '2010-02-14T12:07:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, bc218a24-0e5d-4108-84ec-5f6af32e481d, 'Absolument délicieux.', '2009-10-10T10:21:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, 629adb0c-b232-4352-9155-e728e8f131c7, 'Tout simplement délicieux ! J''ai juste arrosé les pommes de citron pour ne pas qu''elles noircissent ! Recette qui a fait un tabac ! Merci', '2009-04-26T19:01:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57369, 732d733e-6459-4ff0-91cb-c01b98391ab8, 'Variante du crumble à retenir!', '2007-09-05T14:30:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 2e6d48dc-000e-4024-8184-47e4e7a8d4bc, 'Dèlicieux cake et recette très facile, j''ai utilisé seulement 2 bananes et il en reste tout aussi excellent ', '2021-02-22T16:35:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, be760381-f9b0-4a89-b2a8-b9f9277df093, 'Recette devenue un classique à la maison! Avec une banane de moins fonctionne très bien aussi.', '2020-07-13T19:39:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 925d8920-1634-4e1b-95c6-ab5950619fcd, 'Excellente recette. Pour ma part, j''ai modifié les doses de 3 ingrédients : je mets 3 oeufs, seulement 60 g de beurre et 400 g de fromage blanc. Je verse la préparation obtenue dans un moule à manqué beurré et fariné puis je mets au four 40 min à 180°C (thermostat 6)... Une "tuerie" !!!!  ', '2015-11-05T15:50:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 090ba434-b636-4b59-ac92-73fdeccab3d4, 'Super bon, impossible à louper ! Je mets du chocolat caramel Nestlé à la place du chocolat noir, c''est un carnage, tout le monde en redemande !', '2015-07-26T19:00:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 03326613-546d-415e-8ee8-a87814165db3, 'Recette excellente, moelleuse....Un vrai bonheur! j''ai mis 2 x moins de beurre et 2 x plus de fromage blanc pour une recette plus légère en cholestérol ! Et bien, c''est parfait ! Bravo et merci !', '2007-10-02T15:34:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 0a38e434-d488-4bbc-a7a5-fc8319cea2d6, 'J’adore c’est un vrai délice ', '2023-11-12T13:56:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 48ed37c3-000e-4563-8e10-d52a09d4c443, 'Excellent et moelleux, on peut faire du fromage blanc en plus pour remplacer l''huile.', '2022-04-19T12:29:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 614fa52d-e496-4f91-93c2-4211cc03b268, 'Recette facile et hyper rapide ! J’adore', '2021-10-17T23:58:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 6553e64f-00ad-4f8d-924d-deb57cf810be, 'Très bonne recette pour utiliser des bananes bien mures. A la place du beurre, j''ai mis la moitié du pot de yaourt de huile. Et je les fait dans des petits moules à muffins...', '2020-04-19T14:23:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, a78b2e93-7fcb-4a77-aeef-1bc16099f07c, 'Excellent gâteau, moelleux, j''ai respecté les proportions et l''ai sorti du four à 30 minutes.
J''ai ajouté un bouchon de rhum ambré qui a donné un très bon goût, et fait cuire dans un plat rond.
A proposer avec une boule de glace vanille pour un dessert gourmand. Je referai sans hésiter ! ', '2020-03-31T01:04:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 7a6dab4c-9921-4e40-b407-f71c21bc4b0e, 'J''ai suivi la recette a la lettre : un succès !', '2020-03-26T17:56:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, f609dd0b-aba7-4cfd-a271-147fcc3a4c04, 'Cake excellent ! Je mets juste 2 bananes et 1/2 paquet de pépites et cela suffit amplement.', '2019-08-31T08:58:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, f6a4f1dd-5091-4919-88d0-a3ef002a7702, 'Excellent ! Nous nous sommes régalés. Je conseille fortement. J''ai juste mis 1 banane de moins, fautes d''ingrédients. Mais c''était parfait. ', '2017-01-23T20:30:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, ad19a2a5-6eda-4b7d-9ead-03c767a26845, 'Immonde, il monte très peu voir pas du tout malgré un respect de la recette à la lettre ... c''est limite pas cuit à l''intérieur. D''ailleurs ça se voit sur l''une des photos du cake ... le bas des parts semble bien humide ... à fuir comme la peste.', '2015-10-10T22:46:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 8b249106-c1f5-4114-9984-126b3c2633b7, 'Facile à faire et vraiment très bon !!!! Comme pas de fromage blanc, j''ai remplacé avec du mascarpone et les pépites de chocolat par des morceaux de chocolat noir dessert concassé. Un délice !', '2015-08-27T18:24:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 3e5a9d95-8738-4d04-ae86-986957647655, 'Pas bon du tout, peut-être que le fromage blanc était de trop...', '2015-03-08T10:05:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 3fa11d2c-fe1e-452e-abda-5b564e9a4c8d, 'Faute d''ingrédients, j''ai modifié la recette en mettant 6 bananes bien mûres, 60g de beurre et de sucre, 1 yaourt à la grecque pour remplacer le fromage blanc et les mêmes doses des autres ingrédients de la recette. Un délice et super pour caser ses bananes trop mûres.', '2014-12-08T12:08:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 75d7b18d-5d2d-462f-86aa-d125497d6bdf, 'Juste extra !!!!!!!!', '2014-10-04T18:36:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, bb02dff2-28a1-4903-b58b-70199551a555, 'Moi j''ai mis moins de sucre et moins de beurre.. J''ai monté les blancs en neige et à la place des pépites j''ai pris une tablette de chocolat caramel que j''ai concassée.. et 2 bananes au lieu de 3... un vrai délice !!', '2014-06-22T14:02:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 5d8fccb7-fe3d-4c7c-8eb7-511dd0a463fb, 'J''ai mis un peu moins de sucre, car la banane est déjà un fruit très sucré. Excellente recette au demeurant.', '2013-04-05T14:18:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, a8e8d3ed-4e51-4620-9c46-f10ff03a2f2c, 'Très bonne recette, j''ai vraiment adoré ! ', '2012-11-13T02:01:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 41ba2991-07e7-46ac-b938-dde86f3e985c, 'Excellent !', '2012-10-11T17:24:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 653f3a86-b716-460d-8a22-9bea3c65a735, 'Très bonne recette, mais la prochaine fois je ne mettrai que 70g de beurre. ', '2012-10-03T23:51:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 634b326e-b126-412c-b0e8-bff39ca36cfa, 'On sent bien la banane. Un peu lourd, je pense que 80 g de sucre et 2 bananes suffisent. Par contre, il a fallu  attendre qu''il refroidisse pour le manger parce qu''on a l''impression que l’intérieur n''est pas cuit, sinon, il faut qu''il durcisse. Je n''en referai pas.', '2012-09-25T04:00:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 8aabe543-c8d8-415e-84f6-dfe06342b3ad, 'très bon ! j''ai mis un yaourt brasse à la place du fromage blanc et 1 seule banane ! je les ai mis dans des moules à muffins (12 en tout). A refaire!', '2012-08-19T23:24:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, f3ecb011-5b69-4496-9d6b-4297332deade, 'Effectivement c''est très "lourd". Certains n''ont pas aimé mais d''autres au contraire ont adoré ! En effet deux bananes suffisent. ', '2012-07-11T19:10:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 25a6927e-9e1a-4291-874f-e0818f0c0f77, 'Cette recette est une bonne idée, dommage que le tout soit un peu lourd. Malheureusement mon cake n''a pas beaucoup levé, peut être ajouter davantage de levure ? En tout cas cela me fera une bonne base pour la prochaine fois !', '2012-03-11T11:18:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 6f3d80dd-7c21-4201-b53f-0422e6e179d5, 'Excellente recette, beaucoup de succes auprès de mes invités. Petit changement à la recette, un peu de crème fraîche liquide à la place du fromage blanc et ajout d''un nappage blanc d''oeuf, sucre glace et jus de citron. Avec 2 bananes au lieu de 3 ça le fait aussi. Merci pour cette recette', '2012-03-04T21:23:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, e7db958f-dbd1-4ccf-b847-453d510aa389, 'J''ai trouvé ce cake trop lourd et qui ne montait pas assez, peu présentable. Je tenterai de le refaire en remplaçant la levure chimique par des blancs d''oeufs battus en neige.', '2011-07-22T10:56:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 7e332528-b7e7-4281-9a2b-8db0c98cdd3a, 'Excellent ! Je l''ai servi en dessert, je croyais que ce serait trop lourd. Il n''en est pas resté une miette. A renouveler !', '2011-07-20T01:50:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, db7680e2-200a-4bb8-b148-77515943c7fe, 'Bon gâteau ! J''ai juste trouvé qu''il n''y avait pas assez de chocolat, la prochaine fois j''en ajouterai. J''avais des pépites mélangées à de la noix de coco et ça se mariait bien au tout. Nickel.', '2011-04-09T23:14:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 70c69dd6-0ba4-4be5-9b29-aa02c047bb3b, 'Le gâteau était très bon ! Tout le monde l''a apprécié, il n''y a pas eu de restes !  Je n''avais pas de fromage blanc alors je l''ai remplacé par un yaourt. ', '2011-02-14T19:24:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 5ac6283d-36a8-4ca5-b850-81542bcb8bff, 'J''ai été très déçu du résultat. J''avais 12 invités et je comptais sur ce gâteau pour être le clou du spectacle ! En fin de compte , il restait les 3/4 du gâteau et les parts de mes invités n''étaient même pas finies ! Pourtant , j''avais suivi la recette à la lettre !! A surtout éviter surtout pour les grandes occasions, vous seriez déçu !!  ', '2011-01-09T06:19:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 7ded0bc1-ecef-43b3-8b0a-6577cc17fab7, 'Vraiment déçue du résultat !! Au départ, le temps de cuisson n''a pas suffit... Puis niveau goût, pas terrible non plus... Je ne me tenterai plus à faire ce gâteau !!', '2010-11-30T22:00:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, ee4d84a5-8f7d-4ab3-80f0-9afdb2066c4e, 'bonjour, ce matin j''ai fait la recette, j''ai diminué le sucre et le beurre comme conseillé par plusieurs personnes, mais je n''ai rien changé d''autre à la recette, je n''ai pas changé le fromage blanc par le yaourt,... (sinon cela ne serait plus la même recette).... nous venons de finir le repas et il reste à peine la moitié du gâteau (3 personnes à table)... pour moi cela se passe de commentaire... à refaire sans aucune hésitation pour mes gourmands et recette à garder précieusement dans mon carnet, car en plus d''être excellente, elle permet d''utiliser les deux-trois dernières bananes qui restent et que personne ne veut. Merci à l''auteur.', '2010-11-02T13:46:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, a27f09fb-e298-41f8-8e3e-68262c11a8d4, 'Très bonne recette. Pour ma part, dans mon frigo je n''avais pas de fromage blanc nature mais un fromage blanc "stracciatella" (avec les petits copeaux de chocolat)... J''ai également ajouté à la préparation une cuillère à soupe de "pisang ambon", une boisson apéritive à la banane, ainsi qu''une demi-plaque de chocolat patissier, cassée au marteau... Pour une première, je ne suis pas déçue! A recommander, c''est facile à faire, et dans des moules à muffins en silicone, la cuisson est rapide (environ 20 min à 190°C).', '2010-11-01T17:26:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 3b1cc5ee-7ce5-48d1-8532-f898e7c455e9, 'J''ai utilisé des moules en silicone pour faire des minis cakes et le résultat était très satisfaisant. J''ai suivi les conseils et diminué par deux le sucre et le beurre. Pas de fromage blanc donc je l''ai remplacé par un yaourt au lait entier. J''ai mis 3 bananes bien mûres comme nous y invitait la recette et je n''ai pas trouvé que ça sentait beaucoup la banane en fait, j''aurais aimé que ce soit un peu plus fort en goût ... Pas de pépites de chocolat donc j''ai râpé du chocolat (environ 80g, pas plus car j''en avais marre de râper !!!!) Les petits cakes n''étaient pas gras du tout et pas trop sucrés. Ils étaient très moelleux. Je ne mets que 4 tout de même car j''ai trouvé ça très bon mais pas extraordinaire non plus.', '2010-09-22T19:21:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 1955d05a-b6cd-49a6-b336-7ab1f249825c, 'Moi qui n''aime pas la banane cuite j''ai été conquise par ce cake. Je n''ai mis que 2 bananes et j''ai mixé du chocolat hummmmmmmm, trop bon, merci ', '2010-07-18T22:19:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, e52f51d6-e58a-41d9-a2e1-ad6ae690c3f4, 'Perso, j''ai séparé mes blancs des jaunes d''œufs afin de les battre en neige. Cela rend la préparation plus légère. Et je les fais cuire dans des moules à muffins pour avoir des cakes individuels', '2010-04-15T20:45:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, a661f1cf-083e-4c7d-891c-c487a806440b, 'Délicieux ! Le cake est moelleux et pas sec du tout.', '2010-02-16T12:25:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 2e38b5e6-34b4-4b65-96de-00af789b2ee6, 'Très bonne recette, le cake est délicieux! ', '2009-09-06T22:54:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, d54b5825-58b2-4691-b851-bb47cea0aa26, 'Délicieux!  Je n''avais pas de pépites de chocolat, alors j''ai déposé un carré de chocolat pâtissier au centre de chaque petit muffin, avant de les mettre four. Une fois cuit le chocolat au centre est encore fondant, c''est un délice. Recette que je conseille et que je referai.', '2009-09-03T19:34:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 324d3afb-a222-43e2-8eb6-7a9483508490, 'La meilleure recette de cake ! Je la conseille à tout le monde ! On obtient un bon cake moelleux et pas sec, un régal tout simplement !', '2009-07-24T03:27:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 315495de-b0f6-446e-910c-76b02cf535f7, 'Excellent, famille, amis ont tous aimés. Je fais dans moule silicone à muffins, ce qui donne des petits gâteaux très appréciés.', '2009-05-02T13:32:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 888873a1-5ba9-4401-84e7-e58b9c33a7f0, 'J''ai séduit mes coéquipiers cavaliers, mon homme, ma famille avec cet étonnant cake. J''ai varié en changeant les bananes par des poires en passant du cake aux mini-cakes (moules en silicone) pour un effet muffin succulent!', '2008-11-29T20:04:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 5e569df5-6d21-4020-9bd2-3ef3c5e7e479, 'J''ai trouvé ce gâteau très facile à faire et il est excellent! ', '2008-07-13T23:22:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 4845bbdb-4c9a-49a8-9eb0-41e373b123d3, 'C''est devenu ma recette incoutournable pour les pic-nics. Tout le monde en raffole, et on me demande souvent la recette. Je suis la recette à la lettre, sauf que je mets 200g de chocolat cassé en petits morceaux plutôt que des pépites toutes prêtes.', '2008-05-09T17:16:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 48bc392b-9755-4f99-b2b6-57412c409485, 'Un de mes succès ! Je remplace le sucre par de la cassonade et diminue les quantités de 20 g, et ce cake est vraiment léger (malgré le titre "banane-chocolat" qui pourrait laisser présager le pire !).', '2008-04-30T18:43:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, bd1c3b26-c572-402f-af4d-f6fcd08253c9, 'Très bon gâteau, je l''ai refait plusieurs fois depuis que je l''ai relevé.', '2008-03-30T16:03:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 001c7a8a-bf67-4894-8419-6b2fe22e4de3, 'J''ai mis moins de beurre d''après les conseils des marmitonnautes, et le résultat n''était pas terrible... Très compact, assez lourd, je ne retenterais pas ce cake.', '2008-03-06T11:20:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 4fbed093-8645-4601-9408-58b2726d2b63, 'Très bon mais je n''ai mis que 100 g de sucre, 80 g de beurre et à la place du chocolat j''ai mis du benco. Résultat souple, pas lourd. A faire et à refaire!', '2007-10-20T17:47:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, cc21f1df-61aa-485b-ab2f-8a596f0ba0d6, 'J''ai suivi la recette à la lettre, et j''ai trouvé ça également décevant : Très pâteux, gras et écoeurant... De plus, le gâteau ne se tenait pas (peut-être n''avait-il pas assez cuit?), et avait l''air d''un tas flasque... Dommage!', '2007-10-02T02:45:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 9439cf74-05c1-4334-afd2-db2085790734, 'J''ai mis seulement 90 g de beurre et par contre 200G de chocolat "découpé" en petits morceaux. Pas mal du tout!', '2007-09-15T22:29:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 856127fa-9985-44ac-b0b6-7a8b5cfe9552, 'Bonne recette vite faite et facile mais j''ai fait quelques changements. Je n''ai pas mis de beurre et pour le sucre 100g au lieu de 110g. J''ai ajouté quelques morceaux de pomme... un vrai régal. Mon homme a adoré.', '2007-09-02T21:57:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 29107341-cebc-4e4c-b9f6-d8d24f40be8d, 'EXCELLENT, mais j''ai mis seulement 20 g de beurre, 90 g de sucre et un sachet 1/2 de levure. Mon mari, qui n''aime pas du tout les bananes, a adoré ce gâteau. Merci pour cette recette.', '2007-07-29T15:42:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 21b04c19-2512-4987-aae0-e7425b6f6baf, 'Bon... ok, j''ai pas suivi la recette à la lettre : 70g de sucre, 90 g de beurre et à la place des pépites de chocolats : 200g de chocolat!!! Tu m''étonnes... au pique-nique j''ai fait des ravages ^^', '2007-05-08T10:47:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 10af7119-299d-4dd8-a401-45094001baaf, 'Cette recette est délicieuse mais si vous souhaitez faire plus léger ajouter un yaourt nature à la place du fromage blanc, mettez que 60 g de beurre, si vous n''avez pas de pepites de chocolat, mettez du chocolat en poudre, c''est moins cher et moi mon p''tit truc, j''ai ajouté une pomme coupée en petits morceaux, mon mari et mon fils ont adoré et moi aussi, bon appétit...', '2007-05-04T18:32:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 1baa59b9-80a8-4224-a5a3-16c1bf8cbfb8, 'Après avoir lu les commentaires, j''étais un peu inquiète du résultat. J''ai suivi plusieurs conseils, 2 bananes au lieu de 3, moins de sucre 100 g, moitié moins de beurre et du chocolat râpé au lieu des pépites et c''était succulent, très moelleux, pas dégonflé, pas gras, pas trop lourd, du chocolat partout. Même mon mari, pas très gâteau, a apprécié.', '2007-01-18T16:43:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, 88d9244d-2ec6-45d3-9a23-3914db915ec6, 'Le gâteau est "lourd", les pépites de chocolat sont tombées au fond, et le goût de banane est méga prononcé... Bref, j''espérai mieux, mais c''était bon quand même! ', '2006-09-18T02:02:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15261, c5ab8baf-664f-4d67-9744-33dbdaa0c588, 'Excellent. Merci pour cette recette. Aussitôt sur la table, aussitôt dévoré! Tout le monde adore.', '2006-06-26T00:01:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73226, a03d4531-040f-42d5-9f67-bd34b1e62de2, 'J''y ajoute un grand verre à eau de LITCHI boisson sucrée à 15% vol et c''est parfait. Que des compliments à chaque fois.', '2012-03-21T18:07:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81171, 65cdee99-b2d4-47ac-ab5c-90b64630c2d8, 'Toute la famille a adoré ! Cependant pour étaler la pâte pour faire les petits sablés c''est très galère ! ', '2014-03-23T18:47:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81171, 27b93deb-d2d7-4858-a4cb-f51c1954136b, 'Délicieux !!', '2013-03-11T23:54:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81171, e4f80d34-f7d9-48c1-8a89-41a08f4d0fd3, 'Très bon, merci pour la recette. ', '2012-12-19T12:55:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81171, 0b9411bb-f12c-4ac0-bcba-0155e5e2100c, 'Une bonne surprise, j''adore le mélange banane-chocolat, mais je n''avais jamais pensé à le faire en biscuits. En tant qu''alsacienne ça me fait une nouvelle recette pour mes bredeles de Noël ! Par contre j''ai voulu doubler les doses et y ai mis 2 grandes bananes. Ma pâte était très collante et j''ai dû ajouter beaucoup de farine. Mais au final très réussi !', '2012-03-11T10:48:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81171, 902754e5-1083-4ee5-9f73-99360ca7df51, 'Très bon ces petits gâteaux. J''ai mis un peu moins de cacao (100g) et un peu plus de farine (300g). Ils sont bon et tendre, largement assez sucré. Mais je trouve la pâte dure à travailler pour avoir de jolis gâteaux, les miens étaient d''aspects, tout "rugueux". ', '2012-02-22T17:34:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81171, fc6c0532-2938-4b44-98f2-97b2e5752e69, 'Excellente recette ; j''ai remplacé la moitié du chocolat en poudre (largement suffisant) par de la farine, et ajouté une petite cuiller de "Bakin''powder" pour qu''ils soient plus légers ; découpés avec des emporte pièces, les enfants ont adoré !', '2011-11-03T16:40:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81171, b1841c40-f0ca-4e96-aa79-ea0f517084e7, 'Il sont bon mais attention au chocolat en poudre...comme il y a peu de sucre dans la recette, il vaut peut-être mieux mettre du chocolat en poudre un peu sucré. Perso j''ai utilisé le poulain et les biscuits étaient à peine sucré. Je pense aussi que 3/4 de banane suffise ! Sinon les biscuits sont originaux et moelleux ! miam!', '2009-11-09T21:15:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81171, 9574cd10-0625-4ec9-8fb6-2659d8225508, 'Déçue, il faut doubler la quantité de farine, les biscuits restent mous après 20 min de cuisson.', '2009-05-25T18:36:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19455, aca6b918-48b0-4810-9d65-69462343222b, 'Super simple et très savoureux, j''ai oublié le rhum, à refaire avec je n''ai pas mis des dés mais des tranches de mangues, et j''ai mis peu de caramel et c''était parfait !', '2021-08-01T13:40:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19455, d3db4d67-368c-4a09-9f43-68efc21a2602, 'Excellente recette, rien à rajouter, pour améliorer la présentation j''ai suivi les conseils de BabyGee87 et j''ai remplacé la mangue par des tranches d''ananas que j''ai disposé en rosace, par contre je n''ai pas mis de rhum question de goût. A faire et à refaire !', '2015-01-14T15:37:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19455, e1a1cf32-36a0-42fe-be97-d70e094311ac, 'J''ai fait la même recette avec de l''ananas !! Super bon !!', '2013-05-25T19:53:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19455, 7df79a75-3724-4af1-a85d-bdfca42dec27, 'Excellent !  On ne s''en lasse pas !  Nous le préférons tous avec des bananes très très mûres qui donnent plus de saveur.  A chaque fois que je mets des mangues, il y a toujours bien un morceau qui colle.  Donc, souvent, je n''en utilise pas.  Le gâteau est tellement bon que, à notre avis, ce n''est pas indispensable.  ', '2011-09-28T20:00:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19455, 41e60a0b-3416-4f3c-9e89-364fade7d248, 'A déguster très frais... J''ai mis beaucoup moins de noix de coco râpée à savoir 50 g environ (ce qui me restait dans le sachet). J''ai trouvé ce gâteau frais, pas lourd et exotique. A refaire !', '2011-03-20T14:52:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19455, b7045ac0-e86e-440c-a8a2-9083476d4001, 'Facile à faire ,je n''ai pas aimé avec la mangue, la prochaine fois j''essai avec un autre fruit exotique.', '2005-07-01T09:28:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19455, b50aae4f-8119-41aa-8437-76aa81c09fa8, 'Pas convaincue, mes amis non plus... ce gâteau manque de goût, mais il est très facile à faire !', '2004-03-06T20:50:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19455, aaa06496-6a34-4262-96c1-4d4b4bfbd93b, 'Excellent, rapide, facile! Il reste frais plusieurs jours! Fantastique pour utiliser des bananes trop mûres... Ce qui ne donne que plus de saveur!', '2003-01-06T11:37:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82638, 2fa45261-c658-4c5c-bfe1-38479eb3604d, 'Trop bon moi je met des rondelles d''orange dans la marinade pas de banane
', '2023-09-26T07:53:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82638, bc26f232-128d-47b2-9b50-bf4f0da326bc, 'Il faut aimer le sucré-salé. Ce qui est notre cas. Je referai c''est sûr.', '2012-07-16T17:20:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82638, aa8bc7d6-698e-4ead-986e-104046cdfa83, 'Surprenant et délicieux, il restera dans mes recettes cultes ! Plein de saveurs, merci ! ', '2011-07-09T14:02:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (82638, e9fd8bf8-368d-4a25-b88c-76691073acc1, 'Délicieuse recette vraiment originale. Tout le monde s''est régalé ! Je la referai, c''est sûr ! Merci!', '2010-02-07T01:37:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45534, 39d99ea1-0c2e-449f-bedb-3a138c00cc8c, 'Excellent, j''ai également saupoudré la pâte de speculoos en poudre avant d''y mettre la compote pour que celle ci ne soit pas trop trempée, et c''etait parfait! Servie tiède avec une boule de glace, un délice!  ', '2009-09-09T12:49:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45534, cfeab4cd-e455-4ad2-974a-5dcacd0ce0df, 'J''ai essayé sans la pâte feuilletée mais en doublant les proportions pour la pâte à crumble et en sucrant la compote de rhubarbe. Bon succès. Merci pour cette bonne idée !', '2009-06-15T11:23:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45534, 29e092ee-12f9-4382-95db-01fe016da85c, 'Mmmm ! Et si on remplace la compote par un peu de chocolat fondu, de préférence noir... le mariage est super, pas d''amertume de la rhubarbe, pas de pâte trempée, et tout le monde est ravi !!!!!', '2009-05-25T14:08:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45534, 0185f1ca-2bd2-419d-8504-d19979922dac, 'Pas mal, mais la pâte ramollit tellement, qu''on se demande si c''est nécessaire. La prochaine fois, je la ferais en crumble uniquement.', '2006-10-28T16:17:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45534, ebb67093-35de-4d91-8b5f-6d41ab09957e, 'Très bonne tarte. Seuls reproches: la pâte ramollit avec la compote donc difficile à servir (je vais essayer de préparer ma compote la veille et de l''égoutter un peu...) et la compote de rhubarbe sans sucre reste quand même un peu amère malgré le goût de la banane...', '2006-08-30T12:54:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45534, 3638604f-924a-46d9-9787-5432e0321fa1, 'Je n''ai qu''un mot: excellent..Le mélange de la rhubarbe et banane avec en finition les speculoos est génial..mais surtout à manger tiède.', '2006-06-11T13:25:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45534, 62f823af-7234-4aac-b239-d7dd9700c160, 'Délicieux accord banane-rhubarbe, et croustillant original avec les spéculoos.', '2006-06-07T11:59:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45534, f50896fd-047a-4a09-8998-25374dd4e1a1, 'Pour éviter que la pâte ne soit trempée, on peut mettre un peu de poudre de spéculoos avant la compote, cela absorbera les liquides.', '2006-05-16T13:44:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45534, 1c73483a-fdcb-4fdc-bfb0-26f97a319759, 'Excellent, par contre j''ai doublé la dose de spéculoos. Et j''ai fais un mélange de compote à la rhubarbe et de compote rhubarbe faite maison.', '2006-03-26T14:11:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45534, 75ce3a91-a6f8-4681-a36c-f83bb1623592, 'Vraiment très bon! Un seul petit bémol: la compote a détrempé la pâte qui est devenue tout molle. ', '2006-03-23T12:11:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45534, 8b25421d-8ba7-4912-a4fd-1171d46dda0b, 'Un mot, un seul excellent.', '2006-03-19T11:45:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65377, 168dd7bf-f2a2-457f-a714-4b3aefd5e82c, 'Très bon muffins, cependant 2 heures au congélateur ne suffisent pas, les glaçons sont trop mous, il vaut mieux attendre encore un peu (4 heures minimum). Je ne met que 100 g de sucre car le chocolat blanc est déjà très sucré. Attention à ne pas enfoncer le "glaçon" trop profond dans le gâteau sinon il coulera dans le fond et coulera dans le moule.', '2013-04-19T16:48:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65377, 790a5617-31ca-47ce-a6e4-3a4ee810d36d, 'C''est absolument délicieux !! J''ai pris en compte les commentaires, mis moins de sucre et un peu plus de farine, et des petites pépites blanches au coeur. Mon frère et moi avons mangé la moitié juste à leur sortie du four !! A refaire pour sur.', '2013-02-03T19:33:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65377, ddafeeee-daca-47d1-8467-9b928ed51d9f, 'Recette très facile et très bonne. Je l''ai déjà faite plusieurs fois. (je ne mets que 100 g de sucre)', '2012-07-24T08:07:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65377, 00423cdd-0c56-4fb8-b340-5898cb27b72e, 'Recette excellente avec ou sans le cœur banane-chocolat blanc c''est parfait. Le gâteau est moelleux à souhait. Rien à redire !!!', '2012-04-21T03:32:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65377, 45d5d01f-1c7d-4e3d-bd84-f297448cc9c7, 'Deux fois en trois jours, une fois avec la farce au chocolat blanc, une fois sans la farce... au gout c''est bon, mais seul le dessus cuit, en dessous ça reste dans le moule, et c''est pas faute d''avoir beurré... à ne pas refaire...', '2009-12-13T18:52:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65377, 042d2dac-4e18-4c9c-aba3-2d159f5ae848, 'Excellents ! Merci pour cette recette.', '2009-10-21T17:59:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65377, 064ece4d-8ff8-4474-8112-0af3972682c6, 'Je n''ai fait que la base sans le cœur chocolat blanc/banane et on s''est régalé! Cela donne des petits moelleux très légers. Je recommande !', '2009-05-07T00:38:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65377, f7284aa5-9092-4120-9147-c3a33d1f6360, 'Délicieuse recette, les muffins sont très bon. J''ai eu raison de suivre les conseils des marmitons, j''ai mis 100 g de sucre (au lieu de 150) et il a fallu 4h pour que les cœurs des muffins soient assez durs.  Merci Sandrine pour cette recette!', '2008-12-26T11:50:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65377, 15237db1-95e3-4c79-a7c4-66518c65b47e, 'Base de moelleux au chocolat toujours très réussi avec une cuisson à la carte. La touche banane chocolat blanc est très agréable. Cependant l''ensemble est beaucoup trop sucré. A refaire en adaptant le sucre selon les goûts.', '2008-04-18T09:07:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65377, 2bdca053-3fe4-44b7-b239-56a747e2d0f6, 'Je suis fière de mettre la 1ère note car ces muffins sont tout à fait délicieux et vraiment moelleux. Par contre, au bout de 3 heures au congélateur, les coeurs de mes muffins n''étaient pas encore assez durs. Je crois que le prochaine fois j''insèrerai juste un carré de chocolat blanc dans la préparation.', '2008-01-17T11:55:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85718, f8cb4187-e3a1-46b4-b371-f8c79ed8c6d6, 'je rajoute de la noix de coco avant de mettre la purée de banane et je mets de la confiture de framboise au lieu du coulis et je rajoute des rondelles de banane pour la decoration', '2009-06-25T15:51:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24669, 97ffa631-eeca-413a-b5f5-b8f30eadfef8, 'Très bonne recette, j''y ai ajouté des raisins secs car je n''avais que 3 bananes. Tout le monde a aimé ', '2012-03-04T20:44:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24669, e9290756-7ac2-4c32-9338-e6f4b6a94e68, 'Mes invités ont trouvé un goût de trop peu tellement c''était bon, les fruits caramélisés un délice ! N''ayant pas de banane j''ai mis des morceaux d''ananas en boite, j''ai mis un peu plus de lait, merci pour la recette pas chère et facile', '2010-08-27T11:12:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48234, 47f85db8-ca65-4eab-995b-e5bde2d2fa70, 'Plat très complet et vraiment délicieux avec le mélange de toutes ces épices, les beignets complètent très bien cette recette. Je referai sans hésitation.', '2014-10-13T20:34:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528502, 0fbec040-5295-4669-9a93-3039bef2dab0, 'Top !', '2022-10-01T11:06:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, c7f50b30-4007-4cc9-8777-ce807f48de63, 'Très bon ! J’ai ajouté quelques pépites de chocolat.
La prochaine fois j’ajouterai aussi quelques noisettes et amandes concassées.', '2021-12-05T19:59:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 9530159b-f2e8-431d-b9e2-3a29a80259ac, 'Très bon, j''ai mi 3 fois moins de sucre et la moitié de beurre. Mais ajouter un peu de sirop d''agave.', '2019-05-06T05:42:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 072f8049-403d-42f4-888e-94a822adcdb8, 'Merci pour cette recette, une vraie découverte ! recette déclinable avec des fruits rouges ou des abricots, du chocolat, des noisettes et des amandes. J''ai diminué les quantités de beurre et de sucre et les enfants ont adoré. Beaucoup plus sain que les barres de céréales industrielles. Cuisson 20 à 25 minutes seulement.', '2018-02-08T05:59:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, f1b8919d-d7d5-4020-84df-2d46623fe9a3, 'A essayer de toute urgence !', '2017-11-04T19:30:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 0c489834-2ddd-4ddc-a3ae-944e46174aba, 'Hummmm trop bon ! Pour ceux comme moi qui ne savent pas trop quoi faire avec les flocons d''avoine... Allez-y essayez !', '2017-07-31T00:11:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 31b30751-6bb0-43d9-8bc1-12198c7fd6c1, 'J''ai suivis les commentaires et mis 125g de beurre et uniquement du miel pour sucrer avec des raisins et des cranberries c''est très bon.  j''hésite à tenter le nappage au chocolat pour un prochain essai.', '2016-08-31T09:54:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 1d73d0b0-4cab-4d3f-aef2-333a20f6849f, 'Nickel pour tenir au ventre et se digérer vite, bref pour le sport c''est top ! J''ai juste diminuer le beurre (plus d''1/3) et sucre (de moitié). Merci.', '2015-05-14T13:16:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, e4ebcd14-1156-46b7-bbce-7ce667974c5a, 'Super recette ! J''ai divisé la quantité de sucre par deux et pour moi c''était parfaitement sucré comme ça. La consistance est un peu plus molle et humide que celle des vrais flap-jacks, mais personnellement ça ne me dérange pas plus que ça. Ca remplace définitivement les barres de céréales du commerce pour moi ! A essayer avec les variantes noix /fruits secs / pépites de chocolat etc....', '2014-03-15T23:53:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 7680feb1-dc19-4b5f-bdd7-df322110c2a1, 'Trooop bon tiède!!! j''ai mis du beurre salé et je n''ai pas mis de sucre (donc juste fait fondre beurre miel) et j''ai rajouté des cranberries...', '2013-10-06T13:30:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 6c78be64-b3f4-4912-8cb0-345c5040ed21, 'Excellent avant d''aller faire du sport ! Moi, je n''ai pas mis de bananes. Je les ai remplacées par des noix de pécans, des raisins secs et des écorces d''oranges confites.', '2012-11-05T21:31:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 8966d05f-a844-47fd-92eb-a1a77984cb66, 'Le goût de la banane est tellement prononcé et sucré qu''il en devient écœurant... Pour ma part cette recette ne sera pas à refaire !', '2011-11-07T19:21:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 500caac7-14e4-44f0-87a8-d079112cd807, 'Beaucoup trop de beurre à mon avis ! La consistance ne ressemble pas du tout à celle des flapjacks que l''on trouve en Angleterre. Trop sucré aussi. D''habitude j''aime les flapjacks, mais là c''est un échec ! Je conseille aux internautes de chercher une autre recette.', '2011-09-26T20:43:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 5133a4c6-29c6-416d-9e1a-03367d194d28, 'Excellente recette qui remporte toujours un franc succès ! Je ne pense pas qu''on puisse le comparer à des barres de céréales, ce n''est pas la même consistance. C''est simplement un gâteau original et vraiment très bon.', '2011-09-23T16:11:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 172579fd-0679-4767-8c18-e6e06fc9e349, 'Recette faite avec des abricots (3 abricots pour une banane), et c''était vraiment délicieux ! Pas trop gras, pas trop sucré, mon seul reproche serait que les barres étaient trop molles, ce qui n''est pas très pratique pour les transporter, mais cela était peut-être dû aux abricots ou à un manque de cuisson. ', '2010-09-08T16:23:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, f07726e2-7d9b-4d59-bc7a-34d455fc73a8, 'Un vrai régal !!! La consistance était cependant assez éloignée de celle des barres de céréales du commerce : j''ai trouvé les flapjack plutôt mous, mais rien de désagréable, au contraire (pas secs comme les classiques barres de céréales) cependant je doute qu''ils puissent se conserver longtemps (de toutes façons ils sont bien trop vite mangés !), le goût est fantastique, ne rien changer aux proportions. Bravo pour cette recette !', '2010-08-05T08:05:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 40bdfff7-5e8b-4f6c-8e76-c105ffdd0df1, 'Très bon et vraiment trop rapide. Je n''achèterai plus de barres de céréales. La banane n''étant pas mon goût préféré je vais aussi tenter avec d''autres fruits. Top pour emporter au sport.', '2010-08-04T21:50:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 6250e0b7-9d76-466b-9293-a15f7b921312, 'Vraiment super bon !!! Tout le monde adore et surtout ma fille de 3ans 1/2 qui se régale au petit déj :-) Merci pour cette recette ultra simple et surtout saine !!!', '2010-06-20T20:26:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 4e057407-28fb-4579-9cc8-38e80b4f3cba, 'Très bon ! Et mon fils de 13 mois les adore aussi à son petit déjeuner ! J''avais aussi mis des raisins secs, pour que ce soit encore plus énergétique. C''est fini, j''achète plus de barres de céréales, je fais des flapjacks ! Merci !', '2010-06-02T16:24:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, d1d51efa-7f53-44c6-8207-aa2516d70879, 'Cela ressemble vraiment à des barres de céréales en moins sucré, moi j''ai bien aimé, mais mes filles un peu moins, peut-être à cause du miel associé à la banane fort en goût et je n''avais mis que 2 bananes, ma prochaine fois j''essaierai avec seulement des raisins secs et des pépites de chocolat.', '2008-09-15T17:34:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 6130f952-833d-4ec0-a584-8276f0729230, 'Très bonne recette qui donne l''illusion des barres de céréales mais faites maison. Ni trop grasses, ni trop sucrées, à tester avec d''autres fruits et même des raisins secs.', '2008-03-08T19:50:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, f75c90ee-0368-451d-92f8-f4952ff1989f, 'Tres bon ce que n''arrête pas de dire ma mère. Je l''ai fait 2 fois une fois avec des bananes et l''autre avec des figues c''est encore mieux avec des figue. Merci et dire que je ne m''en lasse toujours pas.', '2007-09-23T06:09:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 38ecc829-8121-473c-b43f-ef5e27b85960, 'Ca ressemble bien aux flapjack anglais; une touche d''originalité en plus avec la banane.', '2006-10-08T21:14:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47617, 11315a0b-9493-455d-a632-4cd945c4d7b1, 'On a testé la recette telle quelle et c''était extra! Il n''y a rien à modifier, les proportions sont parfaites pour un goût "so british", ni trop gras ni trop sucré! Merci et bravo pour cette contribution.', '2006-08-14T11:37:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20113, f63d4638-ba9f-41b8-b97f-cb2218425591, 'Faute de citron vert il y a eu du gingembre et de la vanille. C''est excellent !', '2016-07-19T10:20:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20113, e5e2ab35-69e3-42b7-a7a1-0e28dbf201cd, 'Une bonne cuillerée de rhum ambré !!! Excellent...', '2014-04-28T00:46:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20113, ba61e2e5-843c-4c78-8c53-395e3414fab2, 'Un délice ! Rien à redire.', '2013-05-07T19:18:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20113, bf186aca-4631-44d0-bdea-adc7637a9362, 'Très bonne recette à faire en toute saison avec des mangues surgelées.  J''ai un peu diminué le sucre pour mettre un peu moins que la moitié du poids de fruits comme je fais pour toutes les confitures', '2012-07-30T11:51:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20113, 71f0b795-3701-4b46-99a1-2dec3250ff46, 'Bonne confiture. J''ai change les proportions, d''une part pour m''adapter à mes quantités, et d''autre part pour tenir compte des précédents commentaires: - 1,1 kg de mangue - 600 gr de banane - 700 gr de sucre - le jus de 3 citrons vert et leur zeste --> quantité: env. 5 pots Bonne Maman Conclusion: ma confiture était bien assez sucrée et a eu beaucoup de succès. La prochaine fois, je prendrai des mangues très très mures car le goût de banane était un peu trop prononcé à mon gout et rajouterai le jus d''un citron vert (et donc peut-être 50 g de sucre). ', '2008-12-18T10:30:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20113, 7211c5ac-2e0e-48c4-8063-3be23b4ca852, 'Génial. 500 g de sucre pour 1 kg de fruit et c''est délicieux !', '2008-11-08T18:13:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20113, 4368e579-245f-49b2-b3bc-ed19ad6fefa8, 'Délicieuse, et sur un pain aux graines, c''est fabuleux!! J''ai utilisé du sucre de canne et un peu d''agar agar pour être certaine de la consistance. Le résultat est vraiment concluant! Mais la prochaine fois, je mettrai aussi un peu moins de sucre. ', '2008-02-06T11:43:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20113, 8abe67b0-eecd-4b0f-84c8-6c25e7d7288d, 'Excellent ! Même ceux qui n''aiment pas les mangues en redemandent !!! En revanche, j''ai dimininué l''apport de sucre compte tenu de la teneur en sucre des mangues - 1,2 kg mangues 600 gr de bananes 3 petits citrons verts et 900 g de sucre.', '2007-12-06T15:52:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392619, 7194ea14-ca8b-47a5-ada4-fdc976caa0c7, 'Cette recette est facile, simple et très bonne !', '2022-10-23T15:25:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (392619, c29d5629-855a-4dd6-bab9-4f486093b43b, 'J''ai mis des raisins secs à la place des peaux de banane. Excellent !! ', '2021-05-27T09:35:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56870, 99e0c923-96e5-437d-a207-749c50fe392a, 'Excellent ! Le mariage vin blanc et lait de coco est original et vraiment délicieux.
J''ai servi le plat sans les bananes.', '2017-07-18T11:57:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56870, 34013e02-97ad-4a1f-a891-f786268cdcdc, 'Très bien ! Perso je fais flamber mes bananes au rhum et j''ajoute du citron vert. Pour le plat les tomates sont restées au placard mais j''ai ajouté des raisins et de l''ananas. ', '2016-02-14T15:25:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56870, 11f2a7b6-f201-45bd-83a0-2a9fe108d75f, 'Très facile à faire! Le mariage curry et lait de coco est très doux en bouche. Mes invités se sont régalés.', '2008-07-24T23:58:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56870, 9ca21f46-aa50-4c87-9eab-311d6f96fd1b, 'Sublissime et simplissime! Un délice, très parfumé, accord parfait avec banane et riz. J''ai oublié l''ail mais il n''a pas manqué. Je pense qu''avec du poisson (de la lotte et un cube de court-bouillon) ça doit être tout aussi bon. C''était ma première recette créole et ça a été un vrai succès. Merci beaucoup pour cette excellentissime recette.', '2007-06-28T22:31:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56870, 77806ca4-d75a-438e-b0e6-67f2fd65f237, 'Vraiment excellent!!!! Facile et suprêmement bon !!!! ', '2008-05-13T11:08:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56870, de535353-d330-46eb-aa70-1183f6ef4f11, 'Trop trop bon ! Tout le monde s''est régalé de ce poulet créole. La banane apporte une touche sucrée délicieuse. Personnellement j''ai mis 40 cl de lait de coco (le contenu d''une boîte), et rajouté du colombo pour relever le tout. Merci pour cette recette.', '2008-03-06T22:16:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56870, 838f97a4-84f6-4d59-bbc4-16a2c86b87d9, 'Très très bon, mais les bananes dorées au beurre ne sont vraiment pas indispensables, je dirais même qu''elles cassent le goût du poulet. Sinon rien à redire.', '2007-11-04T12:06:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19755, 19bbb334-b300-4b41-99a6-1e784cb38a05, 'Avec trois bananes et deux minutes à pleine puissance au micro-ondes. Un dessert express succulent et honteusement facile à faire!', '2006-11-21T05:53:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19755, f40f6d5d-8dd3-4293-a27e-ae34f8417cff, 'Tres bonne recette, juste un peu trop sucré à mon goût! (en respectant les consignes) Ma copine me fait la suggestion pour la prochaine fois de mettre quelques morceaux de chocolat! Je reconnais là la gourmande :) facile et économique, bref parfait!', '2006-10-05T00:24:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19755, db9ad3e9-1d26-4db3-9d73-9d6384edb45d, 'Très bonne cette compote sauf que n''ayant pas de citron, j''ai mis du nectar pêche-banane et j''ai mis une seule cuillère de sucre. Un régal pour petits et grands, merci!', '2006-06-15T14:16:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19755, 3ee62ecb-33de-43f3-b084-a30c3971ffa1, 'Impeccable! Mais j''ai préféré la faire dans une casserole sur feu doux.. et elle accompagnait un magret de canard. Le mariage des deux est un vrai délice !', '2006-05-31T09:05:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19755, 729f60b1-5eb3-4b63-96dd-ab77b058e96b, 'Et encore... c''est parce qu''il n''y a pas de zéro!! J''ai fait cette recette à 2 reprises car je pensais m''être trompée la première fois... la banane est caoutchouteuse, ça ressemble à tout sauf à une compote... je ne comprends pas les notes des autres internautes... moi qui suis très gourmande, ce dessert à fini à la poubelle... les 2 fois !', '2006-05-23T18:57:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19755, 67a31fb5-7f9e-4218-8356-17e6ead9e60a, 'Bof bof bof, je vais essayer avec le sucre vanillé, sans le citron & en dimnuant le temps de cuisson car en suivant scrupuleusement la recette: ce n''est pas terrible.', '2006-05-17T00:09:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19755, 439bcc63-7b20-4298-a9cf-11200b2855e2, 'Je l''ai faite sans sucre et c''est très bon aussi, très " retour en enfance"!', '2006-05-08T12:17:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19755, 7ccf8007-9329-4466-936c-d7709f5333bd, 'Délicieuse, rapide à préparer, cette compote a fait l''unanimité auprès des enfants et des grands. Réalisée suivant la recette, avec du sucre vanillé à la place du sucre en poudre.', '2006-02-18T15:02:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19755, a12f4865-7746-4df0-94b0-e7e60ab32e8e, 'Tout aussi bon, en remplaçant la cannelle par des graines de cardamone pilées. Et sans citron.', '2005-12-05T20:56:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19755, afa486cf-0524-4f90-bf03-7955b2de19d2, 'Moi, j''ai fait cette recette sans citron ni cannelle, mais avec du sucre vanillé et au fond des pots j''ai mis du chocolat blanc fondu. Mon petit frère a adoré!', '2005-08-26T18:54:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19755, c9880487-fe50-4d5e-85d3-d9eab1688d87, 'Je n''ai pas tout à fait la même recette... je pèse mes bananes (bien mûres) je mets la moitié de leur poids en sucre, la moitié d''un verre d''eau et une moitié de gousse de vanille.. sur un feu doux en tournant régulièrement... la compote va prendre une jolie couleur caramel... il faut compter au moins 30 min de cuisson ; éteindre le feu et ajouter alors le jus d''un citron. Elle se conserve au frais et peut se mettre sur une pâte à tarte cuite, vous aurez alors une tarte à la banane super et pas trop sucrée !!', '2005-07-12T13:35:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19755, 2afd4829-c9ce-4d10-a85c-6b9cdcfe3737, 'Le citron permet à la banane de ne pas noircir ! Par contre attention lors de la cuisson que la compote ne déborde pas.', '2004-09-28T14:21:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19755, d77e7045-cc48-4006-84f0-52fd2cfc50a1, 'Eviter le citron, les jeunes enfants ont tendance à faire la grimace.', '2004-03-10T17:33:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19755, 05fd7130-2367-4444-abee-d6faa81b516b, 'Meilleur encore avec du sucre vanillé et sans citron!! ', '2003-07-29T16:23:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57242, 689ee08c-a458-4024-b087-09b1a0ec6c4d, 'Moi j''ai testé la recette dans des petites cassolettes (avec 2 oeufs aussi), et le dessert a fait l''unanimité ! Servi bien chaud, c''est un régal.', '2010-03-21T02:33:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57242, a567a8fe-8683-478b-83e1-24ad7b2d0d69, 'Excellent a refaire.', '2017-11-22T23:09:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57242, 9d28bb03-f68b-4ad2-b8bf-09e451fc3a19, 'Recette facile et délicieuse avec un coulis au chocolat !', '2016-01-22T14:21:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57242, b1667468-9b5e-4043-830c-f20ff2e7f4de, 'Nous étions 5. Donc 5 bananes, 3 oeufs, 5cl rhum, cuisson jusqu''à la couleur dorée. C''était parfait.', '2015-08-20T10:36:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57242, 934d92a4-d6e7-44ef-999b-cb835a02bb94, 'Riche mais très bon. Réalisé avec un sirop de sucre de canne fait maison, 2 cuillères à soupe de rhum. Les invités étant gourmands, j''ai tapissé le fond de mon plat de céréales grossièrement écrasées, des pépites de chocolat noir, mis les bananes, versé la préparation et saupoudré d''un sachet de sucre vanillé et des cubes de noix de coco !!! Merci pour cette recette.', '2012-04-23T01:20:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57242, 92013d8d-a66a-4e89-b5d2-5596650acf20, 'Bon petit dessert après un repas chinois. Je n''ai pas oublié de mettre le chocolat qui rajoute un petit plus. Merci pour cette recette que j''ai mise dans mon carnet.', '2010-10-17T14:46:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57242, 95206184-45ba-4b94-9b87-cc5ebdb7b453, 'Pour moi, il y a trop de rhum - absorbé par les bananes, c''est plutôt costaud ! Je garde la recette pour essayer avec très peu de rhum ou d''autres fruits néanmoins. ', '2010-04-20T20:05:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57242, 67fd5071-6543-4de6-bc7c-20ca52b2ec2d, 'bonne idée pour passer les bananes, simple et facile mais pour les plus gourmand, on peut rajouter quelques carrés de chocolat entre les morceaux de bananes...', '2010-02-23T21:32:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57242, f24bc7b7-dc08-48a5-9125-477fbb6f1516, 'Dans les ingrédients, il n''y a pas la quantité d''oeufs !! Pour ma part, j''en ai mis deux et j''ai divisé tous les ingrédients par deux (je n''avais que deux bananes). Un dessert léger et agréable, mon mari et mes enfants ont adoré.', '2007-06-16T23:13:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, 34824efc-f816-422e-bb29-39b447ef635f, 'Très bonne recette de poulet. C''est original. Je l''ai faite avec des haricots verts et le lendemain on a fini le reste avec du riz. Recette à garder et à refaire.', '2011-07-29T19:02:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, c2ad2eb3-83a3-498e-b21c-97ee6ea93710, 'Succulent ', '2017-06-09T20:01:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, 746f4d40-b073-43d5-a3c7-31378651b241, 'Excellent, même pour une nulle en cuisine comme moi ! Un vrai régal pour tout le monde. La sauce se marie également très bien avec du poisson blanc (type colin ou cabillaud). Penser effectivement à ajouter du sel et du poivre.', '2010-08-25T13:28:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, c1db9410-2cb9-4675-a35b-9f75fc93f460, 'Très bonne recette de poulet curry! Tout le monde a adoré! Attention de ne pas mettre la banane trop tôt sinon celle-ci se ramolli tellement qu''on ne la sent plus du tout.', '2009-10-07T22:13:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, 679abe7a-7c60-4cb4-b7d1-ff609f3dcfb2, 'Merci pour ce délice.', '2008-10-30T20:29:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, 0ebcf820-a881-4f07-af7d-451303687ec6, 'Très très très bon!', '2007-11-22T20:08:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, 2ebd52eb-7a26-4d11-a116-6f10657284f2, 'Excellent, sauce sucrée. C''est un poulet au curry original et délicieux.', '2007-04-17T13:30:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, 1a330152-e97b-43d6-a445-ac2b5fb2d70e, 'Malheureusement, j''ai trouvé la sauce trop sucrée, et très peu prononcée en curry : prendre de la pâte de curry "forte" ou doubler les doses! Bref, le résultat pour moi fut écoeurant... Dommage !', '2006-10-13T03:32:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, 50ae8112-d560-4049-bd6a-4a7f594b7d60, 'Facile rapide et délicieux, que demander de plus? J''ai suivi les conseils, je l''ai cuisiné avec du lait de coco c''est plus simple. On m''a demandé d''où venait le petit goût fruité (super), et comme chez moi on est grand amateurs de plats relevés j''ai bien sûr rajouté du piment confit, ce qui n''a rien gâché. J''en referai en plus grande quantité!', '2006-10-12T17:23:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, 77ec4485-8822-4c3b-a53d-a3c57d3c3ca8, 'Deux mots : Absolument délicieux !', '2006-01-30T20:08:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, 0aa89b5a-d421-45cc-9f0f-10bd0c44db3e, 'En cliquant sur "recette au hasard", je suis tombée sur cette petite recette assez sympa... En tenant compte des commentaires, j''ai mis du lait de coco en brique, et du paprika en plus. Une recette à ne surtout pas perdre!', '2005-11-25T20:45:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, aca8d4e7-a0bb-4e66-8c7b-9ecc233642a0, 'Excellent! Je l''ai aussi cuisiné au lait de coco. La prochaine fois je doublerai les proportions pour en manger plus!', '2005-04-23T13:19:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, 091d3d94-17b5-476e-8173-af5db80a1cf7, 'Tout simplement délicieux... J''ai diminué légèrement la quantité de bananes et de pommes et ai ajouté sel et poivre. Il m''a semblé que le lait avait tourné: je me demande si cette impression n''est pas due à la poudre de coco qui crée des petits ''grumeaux'' en surface. Une fois cuits, j''ai découpé les blancs de poulet en tranches au lieu de les déposer sur la sauce. Enfin, j''ai servi dans différents ramequins: des raisins trempés, de la poudre de coco, des noix de cajou, du chutney, et quelques bananes coupées en rondelles. Très apprécié! Sauf erreur de ma part, la quantité de poulet indiquée couvre très largement 4 personnes, alors que la sauce est un peu insuffisante.', '2005-04-19T01:32:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, 49826b99-ef79-4c6a-a562-8a2909c0d70c, 'Un régal... je l''ai fait avec à la place de la crème et du lait une boîte de lait de coco (40 cl) ... super, il n''en est pas resté! Merci pour cette recette !', '2005-03-05T14:47:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, 73afc1cf-e5f1-42c2-b3a5-89411ee2b56d, 'DÉLICIEUX! Pour mon premier poulet au curry, ce fut un franc succès... Par contre, ne pas oublier le sel.', '2004-09-06T14:54:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, c87db594-2a73-4174-8f8b-fc02c07adb94, 'Il manque un éléent essentiel dans cette recette : LE SEL!!! Avant d''y penser, j''aurais mis 1/5 a cette recette car c''était très fade, de plus le lait a tourné à la cuisson. Mais après quelques cuillerées de crème fraîche et pas mal d''assaisonnement, toutes les saveurs se sont révéles... Et tout le monde s''est régalé!', '2004-08-04T13:35:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30089, ac21cbc9-bc05-4d37-964f-780c38de0c01, 'Miam! Rien d''autre à dire... Petite précision: j''ai choisi de faire cuire le poulet avec de l''eau pour qu''il reste tendre et qu''il ne grille pas! Et j''ai ajouté des amandes dans la sauce. Merci pour la recette!', '2004-08-02T21:57:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83246, aa051d2a-fb93-4c6e-a23b-36e35541a04d, 'Désolée, mais c''est un plat un peu fade, je suis déçue. A éviter.', '2008-12-14T14:01:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50123, b0dc96d1-9b84-43bc-87b4-cdf3f40b6902, 'C''est un vrai régal, j''ai également mis de la poudre d''amande', '2009-11-21T11:36:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50123, cbdc38d1-a63d-4519-87e4-6f4521838cd2, 'Recette parfaite, cake moelleux et très foutu. A refaire ! ', '2013-06-28T12:45:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50123, f4ed28e0-0424-4baf-b33a-b3601b0b099c, 'Moelleux à souhait, mais pas convaincue par le goût... J''ai trouvé ca assez fade. Dommage', '2013-04-14T23:12:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50123, 1bf02ad1-eb21-4b5a-ad95-1b206ce28b8d, 'Très très bon gâteau. Moelleux à souhait et délicieux, même tiède ! Aurait peut-être mérité un petit peu plus de sucre en poudre...', '2012-06-25T18:56:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50123, 8e9702f9-122a-4676-8b6f-7d3faa365d5d, 'Vraiment DIVIN!!! J''y ai apporté quelques modifications cependant: 3 bananes, moitié moins de beurre et des amandes en poudre. Mon chéri m''en réclame un tous les dimanches matins! Bravo!', '2007-09-10T21:31:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50123, 065b01e2-1706-4a9e-be20-f9fd39b1d42c, 'On ne sent pratiquement pas le goût de la banane : je pense qu''il faut en prendre très très mûres, ce qui n''était pas le cas pour moi. Je n''aime pas du tout les morceaux d''amandes. En revanche merci pour le moelleux qui était parfait.', '2006-11-15T14:42:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50123, e21d2518-9c2f-4351-9708-c938bb29b0ec, 'Merci du fond du coeur pour cette recette!!! C''est trop bon. Je l''ai fait un peu trop cuire malheureusement, il vaut mieux qu''il soit un peu fondant mais même comme ça c''était merveilleux. Encore une fois, merci beaucoup.', '2006-10-15T18:26:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50123, f6e89674-336c-4a54-8270-710c91446b37, 'Très, très bon. Très énergétique et aussi peu couteux. Permet d''utiliser les bananes restantes trop mûres.', '2006-10-06T16:22:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338071, 0df0f6ca-9b0e-487f-9667-ea93fe7b4066, 'J''ai divisé le sucre au moins par 2, ajouté de la banane et j''ai donné une forme de cookie, top :) ', '2023-05-02T11:05:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338071, f2017968-2e62-4f1f-bd5d-045f87ae0e67, 'Fait seul par mon grand de 12 ans très bon ! Merci!', '2019-09-04T08:24:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338071, 2c01f9b0-c95f-4861-bb85-ac7836bac535, 'Super recette, très facile ! On goûte pas super fort les bananes (j''en ai mis 2 petites) et je mettrai encore plus de chocolat.', '2019-01-15T07:12:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338071, cb6ebfe4-e5d7-43c9-945c-f7d32bd27925, 'Super bon. Mais j''en ai pas fait 30. Ils étaient moelleux a l''intérieur. Pas trop le goût de banane c''est nickel. ', '2017-04-28T11:22:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338071, fc2f87a8-cd65-4728-ad05-6ca20c349f07, 'Recette réalisée entre amis. Tout le monde a adoré !', '2017-01-18T11:38:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338071, 884c77b8-a505-444c-8724-fa2091c8e7cc, 'Merci pour ta recette, mes enfants ont adoré.', '2016-11-06T14:24:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (338071, 75dd3f95-1d68-4f3d-a65c-cc4f1118480f, 'Trop bon, perso j''ai mis la banane entière et c''est excellent', '2016-04-16T17:18:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60287, 58ce9448-2217-4a3e-9b48-b5c6eb832ceb, 'Cela n''a pas beaucoup de goût.', '2021-06-02T18:57:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60287, 6ebb1b77-c9ef-4974-8bb7-54a92793b980, 'Totale réussite ! j''ai suivi les conseils pour les blancs en neige, à la place de la gélatine j''ai mis de l''agar agar... un vrai délice !', '2021-03-10T22:53:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60287, 4c004ccd-ff6d-4f6c-932f-b7dadbea0c5d, 'Trop mais beaucoup trop de gélatine !!!!
2 feuilles suffisent et ajouter 1 u 2 blancs en neige ferme.
Ainsi c''est une crème épaisse et non une mousse !!!!!', '2018-06-29T12:51:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60287, 336d90d6-2cd8-44cc-b45a-1bcc68b7c494, 'Pas terrible. La gélatine ne donne pas une texture géniale.', '2013-04-11T14:32:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60287, 5e2a0a50-8003-46d7-b17e-5b95781963bd, 'Bon goût, mais ça ressemble à une crème et non à une mousse. Cette crème serait meilleure avec de la cannelle et des pépites de chocolat.', '2011-12-22T23:53:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60287, 52f4c199-c36d-4ecc-9c8b-bf5da0bb65bd, 'Excellent, juste le goût de la banane sans trop de sucre (pour la gélatine, je n''ai mis que 3 feuilles et cela convenait à tous).', '2011-11-06T16:26:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60287, efc79bdb-4ff7-40a6-a43b-1714387cf911, 'Cela ressemble plus à une crème de bananes (très ferme) je n''ai mis que 4 feuilles de gélatine et cela suffisait amplement!', '2008-04-17T19:59:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21852, 02fe3bed-77fc-4deb-81bd-66a64e551f83, 'J''ai remplacé les 400 g de farine par seulement 100 g de Maïzena, et 150 g de farine. J''ai aussi ajouté du lait à la pâte. Ça reste très consistant après cuisson. Au goût, la quantité de citron était parfaite pour moi.', '2014-09-17T14:12:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21852, 1bb70023-f021-4037-a706-4c32ff3804bc, 'Ces muffins sont ultra secs et pourtant j''avais ajouté du lait comme le disait les commentaires. Je pense pourtant que l''idée est bonne et que cela tient bien au ventre. Je pense qu''il faut réduire considérablement la farine (en lisant la recette je me suis déjà dit que c''était énorme), peut être mettre que 250 grammes, A voir. Mais c''est une bonne association.', '2011-10-15T11:04:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21852, ae965e10-ca87-449f-a565-1f4c0dceb723, 'Recette très simple, j''ai juste rajouté un peu de lait pour lier la pâte et servi les muffins avec du sirop d''érable... hum trop bon!!', '2005-10-02T15:26:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21852, ec942534-1b80-4a69-9908-9c1950d10bcb, 'En effet, c''est beaucoup trop pâteux... Peut-être en mettant moins de farine?', '2004-11-07T11:57:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21852, 6a3fc4e4-5059-4b8e-b1d0-15902cc58972, 'Assez lourd et sec. Dommage.', '2004-03-09T08:27:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21852, c708417a-5ab6-4067-a669-2afbfcc8960a, 'C''est très facile à faire, on ne peut que réussir et en plus c''est délicieux. C''est cependant un peu lourd, un seul donne assez d''énergie pour tenir jusqu''à midi!!!', '2004-01-22T09:41:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81183, f14effeb-02bb-47f2-9193-c6e8bfac9aed, 'Bonne recette mais n''ayant pas de bananes, j''ai mis sur ma salade un avocat coupé en lamelles et une petite tomate en tranches. Tout le monde a bien aimé. A refaire.', '2008-09-15T13:03:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 45e5c107-27f0-40dd-a979-c66e3b4bb686, 'Nickel, elle est parfaite je la fais souvent et tout le monde aime, je met un peu moins de beurre', '2022-02-12T15:40:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 9f22b3bc-6bbb-455b-8021-68334b85166c, 'Un bonheur pour les papilles !', '2021-06-27T08:33:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 0e388048-960a-4cfe-816e-e1cfa322130b, 'La tarte est très bonne, mais le temps de préparation ainsi que son niveau de difficulté ne correspondent pas du tout (sauf pour un chef 5 étoiles) pour une personne normale, prévoir au moins le double de temps (sans compter le temps de refroidissement, entre 2 et 3h, soit jusqu''à 4h15min, on est bien loin des 35min indiquées) de plus, il y a plusieurs termes vagues, voire inconnus pour quelqu''un ne connaissant pas bien le domaine de la cuisine, et bien évidemment sans aucune explication ou précision (sachant qu''ils varient selon les recettes/ingrédients)', '2020-06-24T00:31:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 46186608-41e1-4963-96bc-e1c711e18c49, 'Très bonne tarte, juste petite conseille pour ceux qui veulent sentir le goût de la banane, les mettre fraîche plutôt que les cuire à la poêle, elles perdent leurs goût avec le cuisson. Mais sinon nous validons ! ;)', '2020-05-01T18:27:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, db9616a6-ad7e-4bd7-b393-a1d5509a321b, 'Délicieux ! Je conseille plus de bananes en s''assurant que toute la pâte est bien couverte. Cela se déguste en tous petits morceaux pendant longtemps !', '2019-10-07T11:00:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 9de26f9e-83ed-41b8-9fe3-c19d31d8c266, 'Excellente !!  Je la fait à chaque fois que j''ai du monde, moi aussi je mets un peu moins de beurre et de sucre. C''est un délice.', '2016-02-15T05:34:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 19a7c775-0230-4740-8a0c-e55010bdfb52, 'Tout simplement délicieuse ! Une réussite du premier coup... Franchement bravo et merci pour cette merveilleuse recette !! ', '2013-09-17T00:19:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 11f7b586-5b74-4aef-b068-74fcff72086b, 'Pas mal. J''ai mis très peu de beurre (à peine une noisette) et de sucre (même pas une cuillère à café). A part ça, c''est un bon dessert en fin de repas léger ou à l''heure du thé.', '2010-03-20T23:57:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, fb4b5b4c-3707-4b0e-9b70-ced65eb40f59, 'Excellente recette mais j''ai tenu compte des conseils de certains internautes, j''ai mis moitié moins de beurre et de sucre pour faire revenir les bananes, c''est suffisant. Sinon je conseille de faire cette tarte dans un grand moule à tarte, cela étale bien la tarte et la rend plus "légère".', '2009-03-07T19:43:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 399c5847-9d2d-40bf-ae42-5ce4b9af4db7, 'Recette géniale, tous mes amis en raffolent ! Ils m''en redemande c''est excellent.', '2007-07-12T12:22:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 0a926cae-66cb-41cf-9dea-2f0a5cb3a017, 'Géniale cette recette, c''est devenu un grand classique de la maison!!', '2007-06-02T18:01:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, edb724c1-97d2-4f57-a7c5-76229dd36290, 'Je l''adore! Par contre, je mets moitié moins de beurre et de crème fleurette et j''ai une préférence pour la pâte sablée fait maison. L''idée de faire revenir les bananes avec du beurre les rend très fondantes et avec le chocolat par dessus c''est un vrai délice! Merci!', '2006-11-16T16:59:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 9c188d5e-2fb3-4685-ad12-955f709168cc, 'C''est délicieux, tout le monde en redemande... Merci! Je ne change quasi pas la recette, je mets très peu de beurre et de sucre dans les bananes et voilà, je ne fais que des heureux.', '2006-07-21T14:20:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 6c4b594e-eec8-42b4-b7fc-029b29bf4a97, 'Franchement, une vraie merveille. J''ai ajouté une banane et j''ai flambée les banane avce un peu de rhum. Elle était vraiment excellent et nettement moins "beton" que je ne pensais. A refaire!!!', '2006-02-11T00:35:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 22a2e9fd-911b-4ab2-bf4e-d03fa827776d, 'Moi non plus, je ne l''ai pas trouvé terrible, trop de crème, chocolat masqué...', '2005-06-13T19:30:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, d5d8d9dc-55ad-4dbb-9aba-f1d581a51d7d, 'Que du bonheur en bouche! J''ai fais la recette ce week end en respectant les proportions données et tout était parfait. J''ai même ajouté 1 banane supplémentaire et fais flamber le tout au Calva. Il n''en est pas resté.', '2005-04-27T14:26:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, a46c29bd-a034-406b-aac7-6737647162ea, 'Excellente! Je l''ai déjà faite deux fois et c''est toujours le même succès et le même plaisir. En plus, ce n''est pas du tout compliqué. Je ne fais pas fondre le chocolat, je le coupe en petits morceaux et je verse la crème chaude dessus, il fond très facilement et l''appareil est bien brillant.', '2005-03-18T20:57:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 1c7a3598-ebc8-4678-88f7-bfbb6cc663b6, 'Je pense que mettre de la crème dans le chocolat n''est pas indispensable :le chocolat n''est pas "coulant" et ça rend le nappage des bananes plus difficile ! juste du beurre, ça suffit.', '2004-10-02T23:41:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 9d7610da-846e-4d41-b844-32d9aa4c1e97, 'Désolée de jouer au vilain petit canard, mais j''ai trouvé ça très très écoeurant. Beaucoup trop de chocolat, de crème... Et même en divisant par 2 les quantités!', '2004-08-16T23:50:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 06c86abe-1492-468c-bfd3-8f504275ca1a, 'Cette tarte est tout simplement délicieuse! Il faut quand même faire quelques modifications: 25g de beurre sont largement suffisants pour faire cuire les bananes (5, c''est bien). Pour le sucre, j''ai mis 2 sachets de sucre vanillé et une cuillère à soupe de sucre roux et, touche finale, de la cannelle et du 4 épices.', '2003-12-19T14:09:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 439adb56-dfb3-4a16-b67f-7b47a46edaaa, 'Moitié du dosage de sucre et de beurre, plus 2 ou 3 bananes. Un super dessert et surtout facile à faire!', '2003-11-30T22:23:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 3295bd3c-0e4b-49d2-a48d-8cc95cd5d027, 'Pas mal du tout! Avec 200g de crème fraîche à 5% de mg, 100g de bon chocolat noir suffisent amplement. J''ai aussi rajouté 2 bananes.', '2003-07-16T20:55:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 03da5348-dc2d-4cf2-9ed6-1649d3519308, 'J''ai du louper quelque chose: le chocolat n''a pas bien pris et n''est pas homogène... Trop de beurre aussi dans les bananes.', '2003-06-24T06:10:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 7ec634c6-f7e3-475d-8fb6-24a3bf02d7eb, 'C''est tout simplement fabuleux. J''ai rajouté un peu de sucre roux et de cannelle au chocolat.', '2003-06-23T14:15:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 54abb9bd-789a-478b-b3e8-dd643a3cc747, 'Un vrai régal. Avec cinq bananes pour couvrir presque toute la surface, c''est parfait.', '2003-05-28T11:11:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 5b29ee09-929c-4957-bcad-d1b444b6bb31, 'Excellent. Par contre, je rajouterais 1 à 2 bananes en plus car elles fondent pendant la cuisson et après il n''y en a plus assez sous la couche de chocolat.', '2003-03-26T10:34:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 7b1c038c-9d71-45b2-86c4-9a62a75eda3d, 'J''ai voulu écouter Anne-Laure: 2 bananes de plus, c''est trop! Nous avons trouvé ça un peu écoeurant. Je le referai avec 4 bananes et en mettant moins de crème. Sinon, c''est très bon!', '2003-03-10T15:49:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 5eb7c2a7-a110-4f71-81b6-a3520e9687c0, 'Un vrai délice!! Très fondante, parfumée, mon chéri en est fou! J''ai mis 50g de beurre et, la prochaine fois, je garderai quelques rondelles de banane pour la déco!', '2003-03-08T13:38:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21142, 3a0fd4ac-8e38-47ee-9ac9-687e9e80a66a, 'Superbe! Un délice... Je me suis régalée! Juste un petit conseil: mettez plus de bananes (1 ou 2 de plus)et ce sera parfait!!', '2003-02-28T17:13:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229695, 31df13ef-9809-4d82-be26-03a702b23837, 'Ça manque un peu de précision sur le dosage du lait. 
', '2017-06-11T23:38:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229695, 23d3a4d5-167e-4a6c-8e25-749c02632871, 'Nous avons suivi la recette en supprimant le sucre Et ajouter une boule de glace de vanille et un peu de lait pour 1 banane et 1/4 de melon gelés... Excellent !', '2019-07-14T16:26:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229695, b49166be-cd71-456c-b97e-fd2e5ba04102, 'Toute la petite famille aime ! Mais je l''ai fait avec des glaçons pillés.  ', '2015-06-17T22:03:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (229695, 9888a1cc-1c48-463d-a7c6-de3b3b7e7141, 'Trop top ! Le goût des 2 se sentent bien !', '2014-06-30T20:51:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167844, 61d4158a-bf2e-4570-b95b-055f8ee37363, 'Une pomme et une banane ce n''est pas suffisant je pense. Sinon la recette est bien et facile !', '2014-10-23T18:31:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (167844, 1ed27a92-dda7-4a85-95d9-0cab4d87f03e, 'Un délice, j''ai remplacé la cannelle par du sucre vanillé, une pure merveille.', '2011-08-15T17:40:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 7a9f5cd2-822b-4136-a21d-33461ff54a40, 'Excellent, moelleux au possible, je ne mets ni rhum, ni chocolat et seulement 50 g de sucre. Je l''adore. Merci', '2021-09-27T23:22:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 3fb49a08-cc27-48ea-8859-39c83969f503, 'Très moelleux et vraiment délicieux avec les pépites de chocolat. Je n''ai pas mis de bicarbonate ni d''huile, ni de maïzena et ni de rhum et le gâteau est un vrai délice ! ', '2018-11-08T09:06:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, bfba3439-d485-4592-81fc-6f1bc3498092, 'Toujours sans chocolat pour ne pas masquer le goût de la banane. Avec ou sans rhum selon l''humeur, c''est sans conteste le gâteau que je cuisine le plus souvent! Parfait pour passer les 2 dernieres bananes un peu noircies dont plus personne ne veut.', '2017-06-03T17:16:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, fda4968a-0238-46b2-88c9-56156969cfd1, 'Super j''ai mis deux bananes, 1 pomme, quelques amandes et de la cannelle, pas de bicarbonate ni rhum ni chocolat. J''ai remplacé le sucre par 50 g de sucre de canne et 30 g de sirop d''agave, super !! ', '2017-01-15T22:02:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 748fbf21-003b-48e7-98dc-7d76e0934a59, 'Super bonne recette !  J''ai utilisé un fromage blanc aromatisé au citron car je n''avais que ça, et c''est délicieux !  Parfait en cup-cake pour en profiter toute la semaine.', '2015-08-23T19:42:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 6877aba4-8ff1-4839-842a-e49b2b596fab, 'Délicieux, sans pépites de chocolat. Je garde cette recette pour toutes mes bananes trop mures.', '2014-07-06T13:05:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, f70d3428-1b68-4268-a8cb-5f11bbe65d75, 'Réalisé sans maïzena (remplacé par 30 g de farine) et sans bicarbonate de soude. J''ai également remplacé le sucre par de la cassonade c''était un vrai délice. Un moelleux incomparable délicieux tiède avec le chocolat fondu. C''est gâteau est pratiquement sans matières grasses mais n''est pas sec du tout bien au contraire. Je le referai sans hésiter.', '2013-12-28T12:18:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 5b049262-1e12-48ef-8f03-7d54b83a97d3, 'J''ai déjà fait des cakes à la banane, mais celui là il est super extra !!!!!! Moelleux, goûteux, léger, enfin bref à faire et à refaire !!!!!!!! Juste ma touche à moi avant d''enfourner mettre du sucre vanillé sur le cake, sinon rien à changer. C''est aussi délicieux fait avec du fromage blanc ou du yaourt.', '2012-06-24T19:18:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 7eed1a02-2d8f-4c19-b535-ee79f0e13b0a, 'A faire sans hésiter!!! Goût, légèreté, moelleux... tout y est. Pour les gourmands, on peut ajouter de l''amande en poudre : un régal!', '2012-04-04T15:55:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 33ac17ba-81fb-418b-88cd-9ae573274e6e, 'Parfait ! Je n''ai pas mis de rhum mais sinon tout est top !', '2023-08-27T16:25:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 0fca402f-7505-41dc-8df7-8d24c7cd7732, 'Je l''ai  tester a la sortie du four est tout retombé  est ce normal ', '2020-04-05T17:11:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 2ee62b6a-0620-4160-b45b-8d8146881de0, 'Très bon ! (Assez sucré mais je l''aime comme ça)
Au niveau des farines/levures, j''ai simplement ajouté de la farine et du "baking powder". Il est en revanche assez compacte. A refaire, mais un peu plus aérien. ', '2020-03-29T00:03:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, a5349642-07b6-44f0-a466-bd839df0b3ad, 'Très bon ! Très satisfaite de la recette, c''est tellement difficile de réaliser un gâteau à la banane sans qu''il soit très humide et non moelleux ! Je n''ai mis ni chocolat ni rhum mais j''ai saupoudré de la cassonade sur le dessus pour faire une croûte plus gourmande :) ', '2020-03-26T15:36:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, ec7341b6-929e-492f-997a-d3853349031d, 'Excellent fait sans rhum ni chocolat.....', '2020-03-24T19:02:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, e7fc2f30-0272-43ce-a49d-922efad46be9, 'Recette respectée à la lettre, je n''ai mis ni rhum ni pépites de chocolat il est excellent.', '2019-01-07T10:43:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 0016746c-d9d2-4294-8cca-7217b699ba5b, 'Wahou super recette tout le monde adore: Les enfants au chocolat les parents sans choco mais avec du rhum Je met juste 130gr de fromage blanc Merci pour cette super recette !', '2018-09-25T13:45:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 78fbca0b-2a45-45d0-8fa2-7ac0a6b12c5a, 'Moelleux et délicieux, recette parfaite pour des bananes un peu trop mûre.', '2018-05-09T13:50:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 59797f92-5fd2-411f-af3e-a25445709f80, 'Sans huile, avec uniquement de la farine.
Un délice.  Merci pour cette recette pleine d''heureux souvenirs de voyage...', '2017-08-18T23:58:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 5c261479-d9a8-405c-beed-07bbdd3d56a1, 'Simple et délicieux! ', '2017-01-07T09:00:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, a16308c2-5b9a-4de9-8599-0241d4e34b0b, 'Excellent ! J''ai mis 100g de sucre - 4 petites bananes et pas de bicarbonate ni de rhum ! Une tuerie !', '2016-08-19T23:22:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 79821e3e-7411-47f5-907b-ae841da36b97, 'Très bon, léger. J''ai remplacé la banane par de la compote de pomme. Facile à faire, parfait', '2014-10-19T12:15:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 86d8eb25-9682-4f44-9f9e-8b4e5f0c1ad2, 'J''ai testé cette recette pour la première fois en pique-nique avec des amis. Il est parti comme du petit-pain! En effet très moelleux et léger. Je n''ai pas mis de bicarbonate et ai diminué la quantité de sucre à environ 100g. J''ai également choisi un fromage blanc goût banane ce qui a renforcé le goût du gâteau sans le rendre trop écœurant! À refaire!', '2014-06-22T20:44:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, c9382223-4c0b-4ce1-ae89-50c7b4fec67c, 'Réalisé sans Maïzena et sans pépites de chocolat... En suivant les avis, j''ai diminué la dose de sucre de 20 g... erreur... du coup, ça manquait de sucre ! Mais saupoudré de sucre roux, c''était très bon !! Il était néanmoins un peu pâteux, alors que cuit... N''aurait-il pas assez levé...?', '2013-11-26T00:24:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 6404f5e8-bc99-4419-8bee-aac620edcd68, 'Très très bon ! J''ai battu les blancs d’œufs en neige. J''ai mis la pâte dans des moules à muffins, la cuisson est plus courte (20 min).  J''en ai mis quelques uns au frigo et nous avons trouvé cela meilleur !', '2013-11-14T21:29:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, b0e904dd-e159-4519-94d3-a65c31b64011, 'Délicieux et prêt en 5 minutes ! Le gâteau est léger et fondant. Tout le monde s''est régalé et mes 2 bananes trop mûres ont été utilisées !!!', '2013-05-02T20:35:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 0d93a4d6-5a51-46ec-aaae-888d6eeaeffc, 'J''ai un petit problème, les pépites de chocolat sont tombées au fond.', '2013-03-18T21:39:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 6d4724b0-92a7-4e44-b1f0-67449150acba, 'Très bon !', '2012-12-16T12:31:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 376c5440-e999-4169-bf5f-d78d1e5184bc, 'Dès la première bouchée, mon homme a dit " Ça y est, tu l''as, ta recette de gâteau à la banane ! ". Ce gâteau est bel et bien léger et moelleux. Les prochaines fois, je mettrais juste un peu moins de sucre, pour le reste, il n''y a rien a changer ! Merci !', '2012-07-30T00:40:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, b24b628b-9cb6-4be7-97ef-5b1ec81eeec8, 'Pas de fromage blanc, j''ai mis de la crème fraiche. Pas mis le rhum ni le bicarbonate. J''ai mis des pépites de chocolat au lait. Un vrai régal, mon fiston en raffole. ', '2012-06-23T23:16:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 1c6dc0f2-5099-4411-bd18-ec4259d0f2c2, 'Très simple et très bon. Fait avec 1 seul œuf et 1 yaourt et c''est très réussi. A la place des pépites de chocolat, du chocolat noir râpé en gros morceaux. ', '2012-05-16T22:06:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, d9e886dd-ae98-4ea6-aa70-99c548f4a73a, 'Super aérien, facile et rapide à faire. ce sera désormais ma recette pour recycler les bananes dont plus personne ne veut à la maison quand elles sont trop molles.  j''ai suivi la recette à la lettre avec toutefois un yaourt à la place du fromage blanc. fait avec le rhum et aussi un peu de cannelle par goût personnel...', '2012-04-13T00:45:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 48f1bd9b-7d61-45ba-bc3b-20cde7b7e75a, 'Enfin un gâteau à la banane qui n''est pas sec ! Moelleux, il porte bien son nom. Très facile et apprécié des grands comme des petits, j''en garde la recette et la referais sans hésiter. Merci !', '2012-03-12T09:06:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 3d1e3e36-5e4d-4d3b-9215-a39cd8a0f575, 'Facile et rapide à réaliser. Texture un peu trop façon "flan" à notre avis, mais goût banane/choco bien présent ', '2012-03-06T18:49:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 56bd2b08-aacb-4037-a74f-75da6c66ced3, 'Très bonne recette ! ', '2011-12-16T20:06:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, ed5ffaaa-0c27-49b3-85f3-f3e2de36c567, 'Premier essai très réussi, tout le monde l''a trouvé délicieux mais les deux dernières fois alors que j''ai bien respecté la recette : résultat trop compact !', '2011-10-21T18:38:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 5c1b8e71-5d03-467a-8d6f-5f7a0f37bfd2, 'J''ai remplacé le fromage blanc par une brique de lait de coco. Le rendu est très moelleux !', '2011-09-22T14:39:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, edc42af4-30a4-42af-8293-f533286b4de2, 'C''est super bon ! Je n''avais pas de fromage blanc/yaourt, j''ai mis un peu de lait pour remplacer.', '2011-09-11T20:47:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, b6072ef8-afaa-4495-9208-93951e0bc5d2, 'Recette très simple et rapide ! Faible en matières grasses. Je n''ai pas utilisé de bicarbonate. Seulement 1 sachet de levure chimique et pas de maïzena non plus, remplacée par 60 g de farine. Recette excellente qui connait beaucoup de succès...', '2011-06-22T16:04:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 09dd4922-b518-48b8-8552-73fca3ad28df, 'Vraiment très bon ; par contre je n''ai mis qu''une banane car j''avais peur que le gâteau en ait trop le goût. Je recommencerai cette recette car il n''y a pas trop de matières grasses. ', '2011-01-19T17:38:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, ace405f7-6caa-49e4-9d9a-c3f6a481e1ba, 'Excellente recette que je fais et refais souvent ! Je n''ajoute pas le bicarbonate et le gâteau est tout aussi savoureux... Attention à utiliser des bananes bien mûres car le résultat n''est pas le même sinon !', '2010-11-27T16:38:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 289e1d75-e08c-484b-bd3c-e30d5dc49cae, 'Très bon ! Je n''avais pas de bicarbonate donc suivant les conseils des autres internautes j''ai mis le paquet entier de levure. J''ai fait la recette sans mettre de chocolat. Je cherchais juste un gâteau à la banane et celui ci me convient parfaitement !', '2010-11-19T21:18:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 75770d33-bd45-4dd7-adae-96a995ecab70, 'Très bon, très léger, un seule critique : la pâte étant assez liquide (peut être est-ce dû au fait que j''ai mis un yaourt nature au lieu du fromage blanc ?), les pépites de chocolat sont toutes tombées au fond du moule... ', '2010-09-13T17:43:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, e9f93803-23d8-4f9f-a9ea-151cd5f4c575, 'Gâteau testé et adopté ! Mon cher et tendre a mangé la moitié du dit gâteau en une seule fois. J''ai juste mis deux bouchons de rhum. L''association banane, rhum et pépites de chocolat est parfaite. Je le referais avec plaisir et appétit !', '2010-05-14T01:53:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, f6d8326d-a701-4ab3-b509-71160ffa1fb8, 'Gâteau très bon et moelleux, le titre ne ment pas, on sent bien le goût de la banane. Pour les pépites de chocolat, j''en ai ajouté 1/3 après 10 minutes de cuisson. Le gâteau a dégonflé en refroidissant c''est dommage.', '2010-03-23T10:37:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, a4fe686b-5d21-4756-a23a-2ce09e9e293b, 'Gâteau super rapide et excellent... n''ayant pas de fromage blanc, j''ai remplacé par un yaourt nature et pas de bicarbonate donc j''ai mis un sachet de levure en entier... un pur délice !!!', '2009-11-15T21:44:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 9ac152be-cc7f-440f-acde-5afcdc459c12, 'Un gâteau simple et rapide à faire ! Même sans maïzena (en rajoutant de la farine) et sans bicarbonate (en mettant un sachet complet de levure)! J''ai suivi les conseils donnés (moins de sucre, plus de rhum, de la noix de coco dans la pâte) et j''ai mis les pépites sur le dessus après 10 min de cuisson, ce qui rend bien pour la présentation ! Il faut laisser cuire plus longtemps (55 min)... miam !', '2009-07-09T22:41:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 3e218dc0-d342-4028-a890-d06a566a57df, 'Gâteau original et bon ; j''ai mis de l''arôme vanille à la place du rhum.', '2009-02-28T17:53:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, a93156db-2013-4fec-a7c3-d3a511063b94, 'Super bon!', '2008-11-13T15:19:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 407e2c52-8376-491d-b9e6-f135a42afe40, 'Nous n''avons pas trouvé ce gâteau extra, il est lourd, et le mélange banane est bizarre dans le gâteau, je ne referai plus.', '2008-10-28T15:15:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 39484268-c2c5-4bc3-ad92-765a5ee85cda, 'Fais avec une 1/2 plaque de chocolat noir fondu, 3 bananes, sans bicarbonate, avec un sachet complet de levure et 2 bouchons de rhum (couvert pas le goût des bananes).', '2008-10-27T16:52:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, abe6f19b-90eb-405d-a5b8-98ad33a22a61, 'Gâteau très moelleux même le lendemain. Parfait même sans bicarbonate de soude car je n''en avais pas et sans rhum pour les enfants', '2008-10-26T20:58:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 3ccbf2e0-d6a4-4f15-8e5b-d4834e42fbeb, 'Délicieux, fondant, ne s''effrite pas. Testé sans bicarbonate, remplacé par 1/2 sachet de levure, 1 banane, 1/2 pommes, sans rhum. A refaire vendredi pour le goûter de l''école!', '2008-10-20T19:16:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 9e140c2d-46a0-411e-b33e-092474cf2d4a, 'Trés bon, vraiment comme le titre l''indique, léger et moelleux, par contre j''avais mis le rhum, mais ça ne sentait pas, donc, soit il faudrait en rajouter un peu plus, ou bien ne pas en mettre du tout. A refaire sans hésitation.', '2008-09-21T16:00:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 38681987-93c2-43fa-9909-d2a407b6a53e, 'Super!!! J''ai simplement remplacer les pépites par 100g de chocolat fondu et 1 yaourt brassé, car je n''avais pas de fromage blanc. Le gâteaux est très moelleux, bravo pour la recette!!!!', '2008-06-29T09:48:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, f86c9ed8-0002-4f25-8870-02b0ee2edc86, 'Très bon et très léger ! Moi j''ai mis une demi tablette de chocolat fondu dedans au lieu des pépites, une pincée de cannelle et 2 quartiers d''écorce d''orange confite. Miam il a fait seulement un jour à deux.', '2008-04-21T21:57:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, ad5e04a3-0283-4077-86a3-33b234e37151, 'C''est bien bon. Par contre, la durée de vie de ce gâteau est courte, son espérance de vie n''a pas dépassé la demie journée (nous étions seulement deux gourmands)! Sinon, j''avais peur qu''il n''y ait pas assez de levure mais en fait, c''était suffisant, ça a monté comme il faut.  Je le referai ! Merci pour la recette.', '2008-04-10T17:10:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, e1143d67-bb00-4f7e-b87a-36811884ab88, 'En formule "muffin" peut très bien faire aussi! J''ai remplacé le fromage blanc par un demi pot de crème épaisse Isigny (soit 20 cl). Excellent et moëlleux à souhait!', '2007-11-21T11:40:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, e61d05b8-30cb-4eb5-bcf8-19aedb25304b, 'Très très très bon gâteau!! Je voulais quelque chose pour passer mes bananes trop mures, mais quelque chose de léger : C''est parfait! J''ai juste modifié une chose : j''ai battu les blancs en neige pour rajouter du moelleux! Et avec une pincée de cannelle, c''est délicieux! Merci pour cette bonne recette!', '2007-10-05T17:45:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, 220200b7-2c18-4e97-9a2a-c183d87035c4, 'Super bon ! Gâteau à refaire ! Le yaourt le rend vraiment moelleux ! Petite touche perso : ajoutez de la noix de coco râpée dans la pâte on se croirait aux îles ajouté au goût du rhum et des bananes ! ', '2007-04-28T16:19:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41392, f9700c15-bb8d-419b-9412-899f128e5bea, 'J''ai adoré! Mes invités aussi ! Merci pour cette recette.', '2007-03-27T00:43:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17046, b2cd812c-8800-4659-aca1-5d63e9d07475, 'Très bon résultat ! Une belle couleurs, un mélange homogène parfait et lisse ! Bravo ! J''ai tout de même ajouté du sucre et une feuille de gélatine pour voir.', '2012-03-02T15:34:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17046, 7dcdc810-7f6d-4fcf-9633-4832c89e40a7, 'Nous c''est super bon mais c''est pas présentable (c''est fade!) on a essayées de se rattraper sur les vermicelles colorées et des décorations avec des pêches! Bof!', '2005-08-24T17:35:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17046, 3cc248f0-aea2-4c87-b632-e53e98f29714, 'Chez moi ça a complètement raté avec au fond la banane et la crème sur le dessus et même en mélangeant je n''ai rien obtenu de très bon. Dommage!', '2005-06-30T23:58:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17046, 8f1d91c1-a2be-4307-9a35-e516d0093d35, 'Super facile et appréciée de tous, j''ai mis de la crème liquide allégée pour limiter les calories!!!', '2005-03-13T22:01:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17046, 463add6a-3a24-4fbd-b461-577a32dd35e3, 'Simple et facile à réaliser, cette recette est parfaite pour les desserts express et délicieux. J''ai été agréablement surprise... Rien à redire!', '2004-08-02T18:10:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35292, 38e9827d-23fe-4d44-9519-1dc35e0bfcf5, 'Recette très mal expliquée, surtout la partie de la crème pâtissière juste incompréhensible !  !', '2020-04-19T18:06:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35292, e21ecdbc-68c0-4ff1-ad58-e848af015c0a, 'Bof c''est pas super le goût  ça va mais la texture ne va pas !', '2019-11-17T12:04:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35292, e1b518d3-ea16-470e-badb-c133d1fe71a4, 'Super bon, super frais, un régal. J''ai tout divisé par 2 pour un dessert en petit comité.', '2011-07-06T10:31:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (35292, f0aa816b-90b5-4db9-bc8c-b0919a214d18, 'Très bon dessert, merci tatie lolo pour ta recette!', '2005-03-15T12:52:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51347, 7b93ea32-916f-4e32-b93b-57369e3e6e7f, 'Chez moi ça a donné une crème anglaise pas mauvaise si on ajoute du sucre.', '2012-06-16T17:06:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51347, 99e76532-acf7-43a0-97e5-4c627c54d6f7, 'Tout le monde a trouvé que cela n''avait pas de goût. ', '2010-09-12T21:19:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51347, 43c0fddb-635a-4246-9e7d-079daa7d695f, 'J''ai essayé un jour que j''avais des invités tout le monde l''a trouvé bon mais lourd après un bon repas. Peut être à réessayer avec moins de maïzena.', '2010-01-26T12:59:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51347, 8b36b6a9-5f96-489b-9706-c21131b5c16e, 'Cela devient chez moi un  classique facile ! Encore Merci', '2010-01-14T22:44:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51347, af2d4b3e-01b1-4ed4-91ff-e309d9a7feca, 'Texture un peu particulière. J''ai mixé la moitié de la banane dans la crème mais malgré cela je ne la trouve pas assez parfumée pourtant ma banane était bien mûre.', '2010-01-13T18:55:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51347, 512602ef-ee8c-4be8-8caa-e443d9beceb5, 'Pas mal, n''ayant pas de maïzena j''ai mis de la farine.', '2009-11-20T16:35:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 6c38c3ec-2422-4721-b57b-80f1ab7d0354, 'Très bon en effet. Avec un peu moins de sucre, c''est encore meilleur ! Merci pour la recette !', '2019-08-01T14:19:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, af089d9b-3e7e-4fdd-ac09-61b82418dcee, 'Très bonne recette mais trop sucré. les bananes apportent déjà du sucre. La prochaine fois, je ne mettrai que 50g au lieu des 150g de sucre demandés.', '2019-07-31T05:46:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, f2800dfe-5252-458a-aac2-344fa8e5edf4, 'Super bon et très facile à faire ', '2022-04-07T19:35:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 0495ff17-e8d4-420b-82a5-b50e9619290a, 'Vraiment très bon et simple/rapide à faire !', '2022-03-14T22:51:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, b176118c-15f2-4ea3-aa9d-bf6c7793f808, 'Franchement, c''est top et bon. J''ai ajouté une photo pour le rendu.
Perso j''y ai mis noix et pépites de chocolat en plus.', '2022-03-14T19:27:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 6af5bba8-3027-4ed9-b3d5-a6a64278f419, 'Très, très facile et bon ! On peut néanmoins réduire le sucre de moitié, la banane étant déjà sucrée (surtout si on la prend mûre).', '2020-06-23T23:07:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 6f2ea450-af7a-44d5-9c3c-b8488c707bd2, 'Excellent, très facile et très rapide à faire ', '2020-05-03T12:15:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 670c9c3a-b0c0-4803-9cce-3e900ea70c9f, 'Ajouter rhum et graines de chia.', '2019-12-05T04:40:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 37ffb7ba-461c-469a-85f7-bec076bee34d, 'Super bon et simple ! Le gâteau préféré de mon fiancé.', '2019-11-20T01:18:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 0295ca26-36f7-4dd7-b122-7135365019c4, 'La recette est très simple, je remercie les personnes qui ont dit de rajouter des pommes et des abricots, c''est super ! Par rapport aux photos, je suis loin du résultat.
Je mets deux bananes, 12 pommes, 1 abricot.
Pour la pâte : 100g sucre, 125g farine, 2 oeufs, 1 sachet sucre vanille, 130g beurre fondu.', '2019-08-02T13:20:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 74e74026-6f75-4ffc-a26e-4f41c532c53a, 'Je l''ai fait pour 2 personnes, avec du Stevia à la place de sucre. DELICIEUX !', '2019-08-01T20:59:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, e8c924ed-e072-4823-ab9c-0c112eaa89c3, 'Fait exactement comme la recette, on dirait plus un clafoutis raté', '2019-07-31T14:16:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 957d297d-0486-4b28-a05f-bd3a7f80f60f, 'J''ai mis du sucre moscobado pour caramélisé et j''ai ajouté des graines de chia :) un délice ! ', '2018-05-29T09:04:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 0b42c0dd-dd25-48b9-9b4f-c4df3e09546b, 'Je rajoute quelques pépites de chocolat et je mets quelques gouttes de rhum sur les bananes... Trop bon !', '2018-03-31T19:21:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 937528e9-1331-4cff-a735-c3aba6b6c1a6, 'Très bon !', '2018-03-01T20:46:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 7b9e3673-88fb-4172-bea8-7abc9a1ef858, 'Super bon et croustillant. J''ai mis moins de sucre et utilisé du sucre vanillé de Madagascar... Un délice.', '2017-10-08T22:51:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, a71dbb08-8d29-4402-841f-07dbd859a31c, 'Facile à faire, mais pas trop à mon goût. Rajouter peut-être un coulis de caramel sur la part pourrait être sympa.', '2017-08-22T20:21:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 62f6b2eb-e6c0-4b41-b1d5-f1baf4dc5b75, 'Très bonne et simple recette.
J''ai ajouté 125gr de pâte d''amandes coupée en salpicon (petits cubes 5mm) mélangé dans la masse avant de verser dans le moule. Cela donne plus de moelleux. Et saupoudré légèrement de cacao et sucre glace avant de servir.
Trop bon !!!', '2017-08-14T11:54:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, db2202ab-9bef-401e-b767-eef99e7fc814, 'Trop trop trop bon! J''ai suivi la recette à la lettre et j''ai eu un très bon résultat. Mes parents et mon frère ont adoré!!! Puis j''ai testé avec de l''ananas, mais le résultat n''est pas tout à fait le même parce que l''ananas lâchent de l''eau pendant la cuisson donc les bords du gâteau sont beaucoup plus cuits qu''au niveau des fruits!!! Mais ça reste un délice!!!', '2016-10-17T18:46:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, a7ffb8d2-63c2-40a2-8b45-fa0d1e99cae7, 'Super bon, facile et rapide ! Pour le petit déjeuner avec un jus de fruit et hop la journée peut commencer... Mais et oui il y a un mais ça ne fait pas trop sablé peut-être je l''ai loupé. Thanks pour cette recette. ', '2014-12-16T10:52:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 7f629159-4637-4399-8494-6f0594e1b914, 'Pas mal.... mais ce n''était pas un sablé... j''ai peut-être loupé quelque chose ou mon plat ne convenait pas... c''était presque cramé dessous et pas assez cuit dessus. Mais, point positif : le goût est sympa ! ', '2014-05-28T02:04:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, fd7f9eff-0aa6-4353-a5e7-c945a45453d4, 'Pas mal, j''ai monté les oeufs en neige.', '2013-11-13T23:02:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 1f36072a-0490-4d2a-b934-69fd740b237f, 'J''ai adoré ! Au début un peu sceptique car sans photo je n''avais pas trop d''idée de la taille du plat qu''il fallait même du rendu que ça devait avoir. Finalement un délice, cuisson très homogène, dessus croquant et intérieur moelleux. Je l''ai faite goutée à mon mari sans lui dire ce qu''il y avait dedans et il n''a pas reconnu la banane, ceci dit ça lui a plu. J''ajouterais peut-être du rhum la prochaine fois. Je confirme que c''est très sucré, moi ça me plait mais vous pouvez mettre moins de sucre sans problème !', '2013-07-21T11:55:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, b70c42b4-ac2d-43f9-97be-9f09de598f36, 'C''est délicieux ! J''ai réalisé ce dessert avec des bananes plantain.', '2013-04-23T00:43:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 5e873571-52a6-425b-b6c1-c153ccae4626, 'Très bonne recette, simple et économique. J''ai ajouté du rhum dans la pâte afin de relever le goût.', '2012-05-01T23:18:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, aaf27b16-9848-461b-9ece-62178a43c057, 'C''est plus un gâteau qu''un sablé qui mériterait peut-être que les œufs soient montés en neige car il est un peu lourd. Saveur très douce et sucrée, agréable mais pas après un repas copieux!', '2008-08-07T23:03:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 98c1a347-0a7e-4cd6-8e57-b0ee75e1f1ba, 'Je l''ai fait hier soir d''après la recette d''origine, et nous avons beaucoup aimé. Je pense même le refaire aujourd''hui. Merci.', '2008-05-22T12:13:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, e97b7c00-96cb-44fa-93a3-a7e416f9f146, 'Délicieux! J''ai été agréablement surprise par cette recette. J''étais pourtant sceptique avant de me lancer dans la préparation en voyant la liste d''ingrédients...Et puis en lisant les commentaires, je me suis dis que ça ne devait pas être si mauvais que ça. Et c''est le cas! Les bananes sont tendres, la pâte moelleuse (le terme "sablé" ne convient pas à cette recette), la saveur douce et parfumée. Malgré la liste d''ingrédients qui paraît simple et banale, le résultat est excellent! Parfait tiède au goûter ou au petit-déjeuner, c''est un régal!', '2008-02-01T18:44:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, fd794054-9cf8-476d-9b37-942cb826d085, 'DELICIEUX, voilà  les compliments que j''ai pu avoir grâce à vous lors d''une journée Haïtienne... Cependant deux modifications, j''ai fais un caramel avant de mettre les bananes et j''y ai mis des raisins macérés au rhum. Hum! Merci pour cette recette qui nous fait frétiller les papilles.', '2007-11-25T22:04:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 5becb310-97ad-41d0-9bdd-1d4ad4b7fcaf, 'Trop, mais alors trop bon !! Je ne pensais pas que ce dessert serait aussi bon avant de le mettre au four... Très simple et pas cher, c''est parfait !!', '2007-07-29T18:59:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 97cad1ea-f88c-4a0d-be5c-280931584927, 'J''ai mis 100 g de sucre (+ le sucre vanillé), avec un peu moins ce serait sûrement aussi bon.', '2007-07-11T14:10:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 6d18471f-548f-403c-9be1-9afe33e1e1eb, 'Juste une petite astuce pour un résultat encore meilleur et plus esthétique. Après cuisson, démouler, en le retournant, le gâteau sur un plat passant au four. Saupoudrer de sucre cristallisé ou de sucre vergeoise (+ éventuellement quelques copeaux de beurre) et passer 5 à 10 minutes sous le gril du four pour caraméliser les bananes. Le dessus sera ainsi légèrement croustillant et tout doré. Hum c''est bon, c''est bon, c''est bon!', '2006-12-15T20:57:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 68a5c554-a2d2-431e-a664-19252f5ce0da, 'J''ai fait cette recette avec des bananes bien mûres et diminué légèrement le sucre. C''est vraiment très bon et très rapide à faire. Recette à garder. Merci!  ', '2006-09-27T09:47:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 51c5b060-ead7-43ac-8a8e-e981b0a17e88, 'Pas vraiment sablé...mais très bon! J''ai ajouté sur les bananes de la noix de coco râpée et des pépites de chocolat: miam ! Parfait pour le goûter !', '2006-09-16T20:41:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 2f565acc-09c3-4422-b46c-ed367aec25fa, 'Je m''attendais à mieux! J''ai pourtant bien suivi toutes les indications (si si! :p) La banane n''a en fait quasiment aucun goût...et on ne sent pas le sachet de sucre vanillé ! Je ne le referai pas, et je ne le finirai même pas. Déception :''( (j''essaierai peut-être avec du chocolat)', '2006-08-26T01:27:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 0b3cf6d4-04f9-4bc8-963d-aab43e15bb93, 'Excellent, il en restait plus du tout! Mais pour la prochaine fois je mettrai moins de sucre.', '2006-08-09T10:22:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 0a510aea-87e2-41c0-a3ed-4345fd436ccb, 'Trop bon, mais effectivement mieux pour un goûter, ou un dessert familial! Je mettrai plus de rhum la prochaine fois.', '2006-05-10T22:29:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, e888b1fd-1053-4391-b936-14cf2c9c9fa3, 'Génial!!! J''ai failli tout mangé, tellement c''était bon!', '2006-04-21T19:39:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 9a275a38-36b6-443b-92d7-0266fc3ab89f, 'Bonne recette, pour utiliser des bananes trop mûres. Elle a ravi les enfants au goûter, facile et très rapide à faire; tous à déja été dit, bravo pour cette recette!', '2006-04-07T20:18:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 093843a0-d556-44e9-be91-e62e668ac07d, 'Attention, je l''ai fait 2 fois, la première fois avec des bananes très mures, et une pâte travailée à la main qui était assez "sablée", c''était fondant aéré et délicieux! La deuxième fois avec des bananes vertes, et une pâte travaillée au robot qui était liquide, la gâteau était sec et étouffe chrétien…', '2006-02-25T17:37:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 4d065874-2b79-4e83-9c7b-15793060e31f, 'J''ai juste ajouter 2 cuillères à café de rhum blanc à la pâte, et de la cannelle râpée sur les bananes. Mon mari, qui n''aime pas les bananes, à trouver ce dessert délicieux, cela veut tout dire. Rapide à faire et délicieux, mais il vaut mieux utiliser des fruits assez mûrs. Recette à faire passer...', '2006-02-05T18:08:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 698f027f-83aa-4204-9c87-01ad17e7f842, 'Nous on a trouvé vraiment pas bon, pâteux, écoeurant...A ne pas refaire, désolée.', '2006-02-01T19:46:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 01e6e046-5fe0-42cb-9f1b-35f58e0466c4, 'Excellente recette, facile à faire!', '2005-12-06T12:04:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, cde8b381-751c-4d62-bf9e-472249e5614d, 'Ce n''est pas un sablé, mais plutôt un délicieux gâteaux de petit-déjeuner ou de goûter. Il est même facilement congelable!', '2005-12-05T11:15:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 42703184-87b8-425d-885c-6fcdc5f65dd6, 'Disons que c''est une sorte de gâteau à la banane donc pas mal au goûter ou au petit déjeuner, mais nul en dîner... Déçue!', '2005-10-14T15:48:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 46906eb9-0880-487d-939a-5251a421a442, 'C''est très bon, habituellement je suis très nulle en cuisine mais là je l''ai réussi. Petit truc plus santé : ajouter plein de fruits genre kiwi,pommes etc..', '2005-10-12T00:48:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 30fa0d84-6c21-4e11-b6d1-f4e0b862f553, 'Délicieux. Ma famille a adorée (de même que la visite qui était présente à ce moment-là)! Simple et rapide,j''ai apprécié avec un coulis de framboises et un peu de crème fouettée. Attention, l''aspect des bananes après la cuisson est plutôt décevant!', '2005-09-06T02:37:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, eb323569-f828-48eb-8433-5f44add81b51, 'Tous le monde a apprécié cette recette qui change de mes gâteau au chocolat! Très bon, le seul point faible: l''aspect des bananes après cuisson!', '2005-07-25T21:29:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, c4a0d064-e45f-4307-aa45-fefb86508e5a, 'Hummmmm ! facile, rapide, beau et bon que demander de plus ? Recette réalisée telle quelle avec 4 bananes moyennes. Excellente manière d''utiliser les bananes (trop) mûres en un tour de main et au plus grand bonheur des gourmands.', '2005-07-21T16:08:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 1b12c613-bd0a-46a7-9d7d-38e5e56f724c, 'Nous avons beaucoup apprécié, notamment la pâte qui est croustillante sur le dessus et qui est moelleuse à l''intérieur. J''ai rajouté quelques petits morceaux de chocolat avant d''étaler la pâte par-dessus les banane. Miam!', '2005-05-02T17:06:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 9e3108e6-baa9-4e2b-ba9e-90e69e13014f, 'Recette délicieuse et rapide, j''ai ajouté du rhum dans la pâte et de la noix de coco avec les bananes.', '2005-04-26T21:47:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, b0d16e98-fa63-4413-b04a-6aa2db2ee5ea, 'Bon...et super extra rapide à faire!', '2005-04-21T14:09:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 9b420ea4-c6c6-4692-8e12-1ad31ac8c0da, 'Excellent! A tout point de vue car je suis nulle en patisserie et là, c''était très réussi et facile à faire. J''ai juste ajouté un peu de caramel liquide à la pâte. Merci !', '2005-04-03T14:45:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 5582b908-9fe0-47f8-90da-eea7302c0e8e, 'Je trouve ça excellent (dit-elle la bouche pleine). Pas vraiment ''sablé'', plutôt ''cake léger'', mais c''est parfumé, délicieux... Et très facile à faire.', '2005-03-18T22:42:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 0e1ed0ea-8501-4c09-a3c2-fb5eb4525fe1, 'Mes enfants adorent et leur papa aussi. Très facile et rapide à faire, cette recette est géniale, surtout pour les bananes non mangées. Une bonne facons de vous redonner l''envie de les dévorez!!! Merci.', '2005-03-18T20:20:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 127b0046-993e-4316-8854-c8aa3b67cedc, 'Bon, mais pas pour tout le monde...', '2004-12-18T17:25:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, f941afc7-2544-4a95-a1f5-8a9a6f5e77eb, 'J''adore!!! Facile à faire, rapide pour la cuisson, tous les invités ont voulu la recette.', '2004-12-02T20:40:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, e4e79ee2-b2f4-425d-90d7-67ea7808ab0d, 'Superbe gâteau, je le fais en très peu de temps et ma femme me gronde à chaque fois que je le mange car je mangerais tout!!! (en une seule fois)', '2004-10-30T22:38:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, d4de8821-a1a6-4a47-a0a0-f22bff83abe9, 'Soit je suis mauvaise cuisinière, soit c''est vraiment une mauvaise recette... Facile à faire, mais difficile à manger!', '2004-08-27T22:03:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17710, 722ef8c8-590a-4ea1-a10d-aa57f6f5c61e, 'Bonne recette, originale. Ajouter peut-être un jus de citron pour relever le goût très doux des bananes.', '2004-08-24T20:07:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39781, 36b579b3-b316-4d75-a781-1df522c093fa, 'Très sucrée, lourde, rien de spécial, pas décorative, je ne referais pas !', '2010-03-28T17:17:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39781, 70157c78-5a09-4659-9f5e-2df1baf771d2, 'Facile et rapide à faire, démoulage sans problème ! Elle ressemble bien a une tarte tatin !  ', '2009-06-07T13:04:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39781, ac2a8e14-a984-4d14-bb38-3b4f9451bf90, 'Trop sec ', '2008-03-26T09:02:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39781, 622dd766-19f8-453e-b614-dd16e009930a, 'Excellent !!! Juste une petite remarque et interrogation, une majeure partie des bananes sont restées dans le moule, donc la présentation est un peu moins bien. ', '2008-02-06T20:51:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39781, b8b654aa-f1ed-4c3e-9239-19d22d2022d4, 'Délicissime ! je préfère le jus de citron vert et j''ajoute, selon l''humeur du jour, des fruits secs (raisins, papaye, etc) macérés dans le rhum. Bien plus originale et exotique que la traditionnelle tatin aux pommes, parole de normande !!!', '2007-07-16T23:40:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39781, 2c06e90f-9718-4d20-8ff5-0073fb36c6b3, 'Excellente tarte tatin, et qui plus est, si facile à faire. Je n''ai pas mis de cannelle, car mon mari n''aime pas cela. Nous nous sommes régalés !', '2007-04-24T16:46:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39781, cfb76020-6e2e-4391-ad33-27ea4be63ada, 'Excellent mais ne pas mettre plus de 4 bananes pour un moule de 24cm car sinon ça déborde. ', '2007-01-30T14:01:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39781, 1772ddbc-1f76-4492-bd95-5f71b315455b, 'Un vrai régal!!! Cette tarte va vite devenir une recette incontournable à la maison...', '2006-09-24T21:02:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39781, de4c8c19-6908-4996-8a0d-412bcf28eafd, 'Excellente recette. Mes invités ont adoré, surtout avec la boule de glace à la vanille!!', '2006-07-15T19:15:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39781, aa8908d4-337c-42b9-8e32-ea4cf2e2c755, 'C''est une tarte absolument délicieuse!', '2006-05-15T19:33:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39781, 94ec654f-eb8a-42a2-b497-53d136edef31, 'Très bonne tarte, je la préfère de loin à la tatin traditionnelle. Bien faire dorer le caramel afin que ça tienne bien l''ensemble lors du démoulage: lors de mon second essai, la tarte ne ressemblait à rien :(', '2006-01-22T19:23:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 1457f421-9cf7-4aeb-9109-b3d7f3c13abc, 'Un peu trop sucré. La banane et la vanille suffisent; il est inutile d''ajouter de l''aspartame ou autre.', '2016-06-15T02:55:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 02392b1e-f0aa-496a-b527-75c0a2f43007, 'Très simple vite fait et bien fait ! Je mets un sachet de sucre vanillé et mes hommes se régalent, je varie aussi en fonction des fruits que j''ai.', '2014-09-04T15:03:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 136e5408-b10e-4740-9816-b09d4b5f6bca, 'Bon. Pas besoin d''ajouter de sucre. Mais à mon avis, ce serait meilleur mélangé avec un autre fruit, parce que la banane seule c''est un peu écœurant.', '2014-06-23T17:42:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 29fc938d-1bcb-4510-9fc2-2f4d8941f84a, 'Délicieux ! Je n''ai ni ajoutée de sucre, ni d''édulcorant, la banane est suffisamment sucrée ! ', '2013-02-22T17:10:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 7957f1cc-42e9-4b10-9791-b874bec40560, 'Léger en effet mais... fade.', '2011-10-09T15:18:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, cdb9a78a-4803-4db7-a057-cb820f235adb, 'Pas mal mais un rajout de sucre n''est pas gênant ! ', '2011-07-31T18:25:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 51c010d2-8d34-4acd-b447-3cb39d6efb0c, 'Tout simplement MAGNIFIQUE ! ', '2011-03-23T16:51:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 522b6d4b-74c5-46a0-9d5b-7573f80401e5, 'Je n''ai mis que le sucre vanillé et pas d''édulcorant (je trouve que la banane sucre déjà suffisamment, et de toute façon, je n''ai pas d''édulcorant chez moi) et c''était très bon comme ça ! Je le referai pour le petit dej'' ou le goûter. Je vais également voir en remplaçant les glaçons par des morceaux de fruits congelés (mangue, fraise, ananas, etc).', '2011-03-21T19:51:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 06163fde-1f92-4fa3-9102-270e4dc80f09, 'Avec tous les commentaires déjà établis peu de choses à ajouter. Bonne recette facile et agréable à agrémenter selon son goût. Seul "bémol" je pense, compte tenu de ce qui est confirmé sur la grande nocivité et dangerosité de l''aspartame, pourvoyeur de graves soucis de santé à long terme... Peut-être serait-il mieux de mettre un peu de sucre ou encore mieux miel ou sirop d''érable.', '2011-03-20T12:47:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 267805f4-373f-4457-a281-73e2d216c55b, 'Délicieux....', '2010-06-30T18:58:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, cb16eeb9-827f-45ba-a66c-63bf6297c553, 'Tip Top !! C''est vraiment super bon et maintenant à chaque fois que je vois une banane, je m''en fais un !!! Respectez bien le temps de mixage pour qu''il y ait pleins de mousse et que ce soit léger.', '2009-06-03T13:58:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 46639a2d-5a8c-4d13-a4a7-b9d99c025ee3, 'Très simple à faire et très bon à déguster. A refaire !', '2009-05-30T23:37:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 6030d53a-0c13-473b-92ee-b14c43b32bd8, 'Moi je n''ai pas mis tout un paquet de sucre vanillé, c''est trop. J''en ai mis la moitié, et une pointe de miel en plus, c''est largement suffisant.', '2008-03-31T21:01:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 49dbe461-2554-4fcd-ba94-8c0204cfac32, 'Très light, très facile, tres rapide et surtout très bon!!!', '2008-01-06T19:05:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 866c477d-4ee9-436a-9e62-96caec8d764e, 'J''ai mis une banane bien mûre, un grand verre de lait, un sachet de sucre vanillé et j''ai rajouté un trait de sirop d''érable. Très onctueux, délicieux au petit déjeuner quand on vient de se faire retirer les dents de sagesse et qu''on ne peut plus mâcher...', '2007-04-04T14:28:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 6604c8dd-5ded-4d61-b154-3b0bf071c09c, 'Exellent...mais sur la photo on dirai du liquide vaisselle...', '2007-02-10T14:42:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 517d5ddf-40a2-4f7a-b2a9-8e410967545a, 'Léger et frais, idéal pour le goûter, la prochaine fois j''ajouterai 1 ou 2 glaçons.', '2006-09-20T18:02:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, 76db5bc9-2976-4382-ac7f-0c7d877c48d1, 'Très sympa et léger pour le quatre heure ou pour un dessert pas compliqué et original!', '2006-04-22T19:00:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26916, db978c1d-9d28-4627-8c01-2474269034c1, 'Tout simplement génial!', '2005-02-14T15:49:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (175138, 186730ae-17f4-4134-8a92-3f975ab9f944, 'Exquis !', '2017-04-09T19:22:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (175138, 39654d48-3886-4014-9170-f1df07cfa44e, 'Excellent', '2021-02-21T22:12:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (175138, 16e3757e-babf-42ef-a718-b075dc911c68, 'Excellent, super en été au petit déjeuner dehors !', '2020-06-01T20:20:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, 420701fb-5c02-481b-86cb-820a110c1dec, 'Délicieux ! Je n’ai pas mis de sucre et j’ai doublé les quantités pour avoir 6 gros muffins. J''ai ajouté un carré de chocolat au centre pour un effet fondant et des pépites sur le dessus. Par contre j’ai mis plus de temps de cuisson, au moins 25 min, mais ça doit être dû au fait que j’ai mis des fruits rouges congelés.', '2022-03-14T01:48:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, bbff1ab4-69bb-4cad-be4a-1bdc59ecab81, 'Très bon et très moelleux !', '2021-11-14T18:01:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, f952303b-a3b6-4b73-acbd-29f2d78b1ecf, 'J''ai remplacé les myrtilles par 150 grammes de chocolat, et j''ai déposé des pépites de chocolat sur le dessus !!
En revanche, le gâteau est un peu sec.', '2020-02-21T05:55:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, d3a0c40a-05d7-4289-9600-81fe397ee445, 'Moyen... Peut être parce que j''ai utilisé des myrtilles congelées. Je conseille moins de sucre car la banane l''est déjà beaucoup.', '2019-03-19T16:07:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, cdcd29d8-959f-4841-a8dc-6f27798eb65c, 'Parfait ! Fait et refait et toujours un régal. Ultra rapide et simple..
Je remplace les myrtilles par des pépites de chocolat.
Merci !', '2018-05-16T11:33:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, 1d5e9454-8e25-4c45-a7e2-c5221c5934aa, 'Très bonne recette pour les allergiques aux œufs, que j''ai remaniée pour l''adapter aux végétaliens et j''ai remplacé les myrtilles (que je n''avais pas) par 100g de chocolat noir en morceaux. J''ai utilisé de la margarine végétale, du lait végétal, réduit le sucre à 80g et modifié la cuisson : 19mn à 200 degrés avec un moule en silicone. Cela m''a fait 5 muffins. ', '2017-05-11T15:24:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, 106fa3c4-8d2f-4903-8da1-a8d1c4ff4f04, 'Recette parfaite ! J''ai quadruplé les quantités en respectant 2 bananes x 4 et 250 gr de sucre au lieu des 400 recommandés ! Les bananes étaient bien mûres ! Cuisson dans des moules à cannelés et remplacement de la vanille liquide par une gousse infusée dans le lait tiédit ! A refaire :-) Moelleux et goût garantis ! ', '2014-06-01T20:07:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, da3bc303-ce44-470c-96ca-4e9d7a5c6ff2, 'Un délice ces muffins. Permet d''écouler les bananes bien mûres. Je les ai faits avec des fruits rouges surgelés car je n''avais pas de myrtilles.', '2014-01-03T13:09:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, b4577d70-75f7-4a1a-a48c-573f45245075, 'pas trop mal comme recette !', '2012-12-15T18:15:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, 56c79fd5-9e2d-4146-8163-3b6b7289f8ae, 'Super recette facile à faire. J''avais un peu peur de ne pas utiliser d''oeufs mais la banane fait bien le liant. Un peu moins de sucre et un peu plus de myrtilles (sauvages bien sûr !) et le succès est assuré.', '2012-08-25T19:39:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, c23be190-960d-4dfc-ad78-ef1407919b14, 'Testée avec les premières mûres du jardin, vraiment très bon et moelleux !!! J''ai multiplié les ingrédients par 2 sauf pour le sucre seulement 80g; pour le temps de cuisson 15 min supplémentaires.', '2012-08-14T22:04:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, 636e3fe7-23b2-4612-b3f6-70b591bca5cd, 'J''ai peut-être loupé quelques choses car la pâte était assez compacte... Par contre le goût très agréable, j''ai beaucoup aimé... Recette a refaire. Pour le sucre je n''ai mis que 40 g et pour moi c''était largement suffisant.', '2012-03-04T16:51:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, a76da531-9fcb-4814-a81d-bf1f90e726d8, 'Tout à fait d''accord avec Pauline333, muffins délicieux et moelleux a souhaits, légers et simplissimes à faire, et on peut diminuer la quantité de sucre (j''ai ajouté une demie banane du coup). Merci!', '2011-03-14T10:55:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, bd9a9849-c47a-447e-9d7b-31ef092aaeaa, 'Délicieux et très simple à faire !! En plus, ils sont très légers car sans œufs et on peut largement diminuer le sucre si la banane est bien mûre.', '2010-10-28T17:41:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, e6b799d2-348b-4cfa-a9fe-63c8abb13988, 'Recette super, très facile à réaliser. J''ai mixé la banane avec le lait et le beurre fondu pour un résultat plus lisse. A refaire sans aucun doute !!!!', '2010-09-13T21:46:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, a48ef3e1-9ee8-4f62-8488-1105c00a9231, 'Il faut en effet diminuer le sucre ! Par contre le temps de cuisson doit être augmenté (+10min en ce qui me concerne).', '2010-08-22T14:12:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, 104b5960-39a3-4ddb-b97a-aab26c94a386, 'Aussi bons que des "vrais" muffins et l''aspect n''est pas du tout "granuleux" (il faut sûrement bien écraser la banane)! En remplaçant les myrtilles par des raisins secs ou des pépites de chocolat, il faut diminuer le sucre (75 g).', '2010-05-13T13:07:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, 0aff41db-bc8a-419e-98b3-dd127d392253, 'Rapide et excellent; pour ma part, j''ai réduit le sucre et augmenté le temps de cuisson (+ 5 min ); à refaire souvent, merci pour cette recette facile.', '2009-07-31T12:16:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57152, 66d207a1-5cfa-47cd-bdf4-3ed68c5553f1, 'Les muffins ne sont pas aussi beaux que des vrais muffins, ils sont un peu "granuleux" au lieu d''être arrondis au dessus... La prochaine fois je diminuerais un peu la farine ou augmenterais la banane.  Par contre au niveau diététique, cette recette est vraiment TRES intéressante!!', '2008-06-16T21:55:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, 7412e6e3-dfce-4b7e-ab87-6eb5ab8f8d68, 'Pour un premier essai, j''ai utilisé ce que j''avais sous la main, à savoir 1 kiwi, 1 banane et 1 poire. J''ai réussi à confectionner un pot et demi de confiture. Une fois l''avoir goûté, j''ai regretté ... de ne pas en avoir fait davantage. Ça change et c''est très bon en gardant les petits morceaux de fruits. Comme ma banane était bien mûre, elle a lié le tout ! A refaire lorsque ce sera la saison ;)', '2015-04-14T08:22:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, bc3fb4ad-9c64-4d36-96d1-567ed39e4615, 'Réalisée avec des kiwis verts, bananes et pommes. Je n''ai pas mixé, mais coupé les fruits assez petits. Le résultat est excellent, merci !', '2012-08-09T11:33:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, 24b4d385-6e57-4bc7-954d-dfab14bd60c3, 'J''ai bien aimé, j''ai mis une poire en plus, très bon avec un gâteau à l''orange et même pour le petit déjeuner. merci ', '2015-05-17T10:31:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, d7456a46-5d83-481d-aa2c-48a8cc7d9b84, 'Trop similaire à une compote mais trop sucré pour l''être : nous n''avons pas aimé.', '2015-04-19T12:02:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, d49d12f3-d236-46fa-a7fc-a2766e674c20, 'Facile et très bonne j''ai remplacé les pruneaux par des baies de cramberry ', '2015-04-09T18:58:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, f8ea74f8-d6d7-4a26-be2b-4221f7d9a15a, 'Moi, comme j''aime les bananes, cette recette est vraiment faite pour moi, mais je dois avouer :  tout  mon petit monde a vraiment aimé. J''ai pas mis des kiwis jaunes (je ne savais même pas que cela  pouvait  exister). Mais même  comme cela, c''est une véritable régal. Merci. Bien à vous.', '2013-04-28T16:52:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, 59f4b38c-74b4-4116-8d38-42e16759017a, 'La recette a été très appréciée. Cependant, il s''agit plutôt d''une compote. J''ai stérilisé les pots afin de pouvoir conserver cette "confi - pote". Mais la confiture a changé de couleur. ', '2011-10-03T00:36:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, 833da8e8-5c23-416d-8cd8-2534df7f3fa4, 'Je fais une recette à peu près similaire avec des pommes en plus et sans kiwi jaune. Je mets aussi moins de sucre et j''ajoute quelques amandons de pruneaux. Ma famille en raffole ! J''en fais plusieurs pots chaque année pour Noël.', '2011-02-20T00:21:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, 2ab2e94f-581a-467a-9a71-547b324f23b5, 'Excellent, j''adore cette association, très bonne idée, à refaire très vite. J''ai mis un peu moins de sucre.', '2010-09-04T04:30:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, c7430615-55ac-4c20-8e21-ee75b6501cf0, 'Ressemble plus à de la compote qu''à de la confiture. Le goût de la banane est trop présent et masque les autres saveurs. Pas d''amateur à la maison.', '2009-12-26T11:51:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, f3ef4511-5ceb-421b-ae93-25f822b79537, 'Vraiment très bonne association de goûts, la confiture est juste sucrée comme j''aime! J''ai utilisé plus de kiwi (mais j''ai oublié les pruneaux...). Je n''avais pas le temps de laisser macérer comme indiqué, juste 2-3 heures et pour simplifier je l''ai cuite en machine à pain (programme confiture : elle mélange et cuit toute seule, sans attacher !). Résultat épatant !', '2009-05-09T16:45:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, 94d65c88-9445-4509-bf4a-750ca32c1e0d, 'La banane et le kiwi vont bien ensemble, par contre la prochaine fois je rajouterai un kiwi supplémentaire. Très bonne recette.', '2008-09-30T17:49:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, e66fbb46-c2b9-4d37-816e-fd9d4666a8d4, 'Excellent mélange de goût. On a tous aimé!', '2008-09-17T17:23:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, 75f371e0-0c41-410f-b48d-3422ed127056, 'Très bonne idée le mélange des fruits. Elle a été très appréciée par mes amis, même ceux qui n''aiment pas les bananes ont beaucoup aimé. Elle est simple et rapide à faire. Mes amis en ont redemandée.  ', '2008-06-26T12:13:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, cc79e92c-1ee5-43a0-83a9-e3ae9348f4c2, 'Très bonne recette, réalisée sans kiwis jaune (j''ai ajouté un vert à la place).  Mon homme a trouvé que le goût de la banane masquait trop les autres fruits, mais comme j''adore la banane, personnellement, ça ne m''a pas dérangé, et c''était très bien, j''ai fini le pot toute seule!', '2008-04-15T15:49:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40764, 79a00299-9a54-4edd-bd95-74a211c6d686, 'Très bon, entre compote et confiture et donc pas trop sucré (parfait pour ceux qui aiment le goût des fruits dans la confiture!) Je conseillerais simplement de conserver les bocaux au réfrigérateur et de ne pas trop attendre pour la manger (mais comme elle est excellente, ça ne devrait pas poser de problèmes ;-)...)', '2006-01-31T21:22:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, cc847afd-83e5-4a7a-8b01-55ceaf3a1c36, 'Très bon mais trop de nutella à la fin selon moi, la prochaine fois je ne mettrai qu''une cuillère !', '2021-08-09T14:43:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, b6eb28e8-feaa-42b3-aad6-cc954aad9679, 'Bon mais trop lourd !', '2015-12-18T21:08:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 866109fb-1234-41cf-a2e5-fe45b25923f1, 'Moi j''ai mélangé le nutella avec du yaourt nature pour que la texture soit plus onctueuse, et mit pas dessus les bananes et le mélange descend recouvrir les bananes. Un régal ! ', '2015-04-26T19:43:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, ec4fdf68-4742-4f83-afe6-b908dae83d7c, 'Je n''ai pas du tout aimé : le nutella dégoute très rapidement...', '2013-08-09T21:11:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, c4a99458-e693-46ec-a30b-2a3c8352920a, 'La recette est simple, rapide et juste délicieuse. J''ai fouetté le nutella avec un peu de mascarpone pour adoucir le goût afin d''avoir une texture crémeuse et aérienne', '2013-07-28T02:04:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, bff510ea-f4a0-46ce-b624-635b18d9fc77, 'Je n''avais pas de nutella j''ai donc fait fondre 150 g de chocolat noir que j''ai ensuite mélangé avec un peu de crème. Délicieux. Merci.', '2013-01-24T20:51:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, b34128f8-b309-4bbe-9d29-c18601acef0c, 'Extra ! Je les avais placées au frigo et juste avant de servir, je les ai passées 30 sec au micro-ondes. Un régal...', '2012-12-04T10:59:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 970869d4-0338-45c1-b997-a12679edc0e0, 'C''est très bon mais à petite dose...sinon l’écœurement vient vite. Par contre c''est très appétissant à regarder.', '2012-11-15T23:26:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, b416022e-169d-494e-9049-474c7584a3c4, 'Tout simple, rapide et très bon.', '2012-08-26T01:37:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, cc77e0e7-a274-4da5-aea0-2c9e5aad83c5, 'C''est vraiment excellent j''ai trop aimé et mon maris aussi !! J''en referais très souvent. Merci', '2012-08-17T21:51:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 5abc11af-5a37-40a1-9169-893eafde4d08, 'C''est très bon, mais après 2 ou 3 cuillerées ça devient un peu écoeurant..', '2012-05-09T17:36:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 133a27e3-e46f-49ad-a84a-a70c7ec09805, 'J''ai lu la recette et j''avais tout sous la main, j''ai fait la recette en 30 secondes et je me suis régalée, une très bonne idée, un vrai délice !', '2012-04-30T22:23:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, f21167a1-2447-47c2-aae2-027a9087e04f, 'Vraiment pas mal ! J''ai réchauffé les verrines quelques secondes au micro-ondes et j''ai ajouté une petite boule de glace vanille par dessus !! Humm je referai cette recette !!', '2012-04-30T18:59:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 9e9a6c00-8c26-47f3-afe3-24bbdcf4f23e, 'Hummmm un délice pour mes enfants ', '2012-04-20T02:00:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 949a7bb7-973a-4d62-b4a1-2028f307582a, 'Vraiment bon, j''ai juste remplacé la banane par de la poire, donc plus juteux et cassé un spéculoos dans la pâte à tartiner au chocolat pour plus de croustillant. C''était super !', '2012-02-15T10:57:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 4c39a1e4-1e6b-435a-acaa-58c3ac15f23e, 'C''est super bon, un régal et rapide à faire et qui plait à tout le monde merci pour ce partage ! ', '2012-02-07T21:12:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 6b431f0b-4bf7-454d-a93e-0100657e97c6, 'Un dessert un peu lourd dû à l''accumulation de chocolat et banane. A voir si une variante pour liquéfier le chocolat ne serait pas plus profitable. Moi, je l''ai chauffé quelques secondes avant dégustation pour fondre le chocolat et chauffer un peu les bananes. Plaisant au goût et en bouche.', '2011-12-18T20:58:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, d5dbfa1e-9968-49cc-acb6-bed018f31486, 'Très bonne association. J''ai fait plusieurs verrines, mixe les bananes, mixe les spéculos. De bas en haut : spéculos, nutella légèrement fondu en petite quantité, banane mixée. Et ça a fait un carton ! Merci pour la recette.', '2011-12-18T01:14:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 3191c55a-df02-44f3-b976-51638b8dea9f, 'Trop écœurant. Il faut vraiment aimer manger le nutella à la cuillère...', '2011-11-14T20:54:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, bbfbe241-de8b-43be-a583-26b6e896a8f6, 'A essayer : remplacer le nutella par de la crème de spéculos, le résultat est plus agréable. ', '2011-07-20T14:58:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, d17b1b5e-cdd8-46e7-afe9-4d1c2ee9f4c4, 'J''aime beaucoup le nutella mais cette recette était vraiment trop écœurante. J''ai pourtant ajouté un peu de yaourt nature sans sucre dans le nutella mais même comme ça...', '2010-12-12T18:13:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, a89c78dd-f7ab-4779-8075-4c01b05806dc, 'Simple et efficace pour un dessert express ou une envie gourmande. J''ai ajouté une cuillère à café de mascarpone au nutella hmm délicieux.', '2010-09-21T05:50:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 80fef787-f1f5-447d-a785-89339c827882, 'Après un stage au frigo, ce dessert a plu même aux non amateurs de nutella. Un peu difficile dans des verrines d''attraper un peu des 3 couches sans en renverser, mais très, très bon, croustillant et gourmand !!', '2010-06-08T18:34:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, babaa3c6-ee6c-4b6a-b229-07217bc8580b, 'Pour la touche un peu plus recherchée, j''ai fait mariner les bananes en rondelles avec un mélange jus de citron/sucre vanillé/rhum brun. J''ai remplacé le nutella par du chocolat fondu avec une noisette de beurre + lait/crème épaisse. Plus de goût et plus fin en bouche !', '2010-05-16T17:30:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 166fb631-0add-40f6-99c7-d69ee2c39f09, 'Facile, simple mais rien d''extraordinaire...', '2010-05-09T17:48:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 2c24ca93-992f-48a0-93cc-8cd350df3bfc, 'Très facile et très rapide ! J''ai juste remplacé la banane par des pêches pour que se soit moins lourd et plus frais.', '2010-04-27T19:11:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, e6202b43-b2a1-4950-a306-68efe543c6fc, 'J''avais oublié d''acheter les bananes, du coup je l''ai fait avec des pommes que j''ai cuites et saupoudrées de sucre vanillé. Les pommes chaudes ont liquéfié le nutella, et le goût du spéculos se marie très bien avec la pomme. Je suis plutôt fière du résultat : sauce nutella + chaleur des pommes + croquant des spéculos ! Excellent ! Je l''ai ensuite essayée avec des bananes, j''ai trouvé ça plus lourd, mais bon tout de même.', '2010-04-13T21:01:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 54363f3f-72e8-4694-8361-d505bc5ecf37, 'J''ai fait ce désert lundi dernier. Très facile à faire et délicieux. Merci pour cette recette !', '2010-04-01T15:24:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 919a23c6-47ff-49cf-bc81-2ff40e47d06e, 'J''avais des invités et pas le temps de faire un dessert. En 5 min, celui-ci était fait et tout le monde a aimé ! Par contre, faire une petite verrine car assez bourratif.', '2010-03-22T15:37:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 0eeb7eea-24ef-411d-85c4-8993f7c20c33, 'Très bon mais très lourd. A manger le midi. Effectivement il vaut mieux mettre 2 cuillères à café de Nutella que 3. J''ai ajouté une boule de glace à la noisette après avoir ajouter les bananes (je pense que cela peut être bon avec de la vanille aussi) Conseil: Ne pas hésiter à mettre beaucoup de spéculoos en poudre. ', '2010-03-13T01:25:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 17dab457-6e0a-4418-9331-9ef25aa0a328, 'J''ai moi aussi mis du lait dans le nutella au préalable pour le rendre plus liquide. Bravo et merci', '2010-02-28T20:40:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 2a4b3168-064d-4008-88ed-b683182781cd, 'J''ai essayé une première verrine mais l''ensemble était vraiment très écœurant. Par contre en diminuant la quantité de nutella, ça passe vraiment bien même quand on est pas un grand amoureux du chocolat.', '2009-12-23T23:08:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 0a7b8353-12a7-4130-8a49-8b46087eaa09, 'Excellent ! J''ai également ajouté du lait dans le nutella, nécessaire pour le fluidifier. Toute la famille a adoré. ', '2009-11-11T18:28:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 9c33d82f-5ebe-4372-98d7-e814660b2d3e, 'Moi qui suis pourtant une fan inconditionnelle du nutella et du mélange fruit-chocolat, j''ai trouvé ça écoeurant, trop sucré, trop lourd. A refaire mais en allégeant le tout (diluer le nutella dans du lait, mettre moins de fruit ou mettre un autre fruit)', '2009-11-02T16:12:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, d968dab8-143e-4605-bf8a-b524426c2474, 'Délicieux et assez surprenant (le côté croquant est apprécié). J''ai aussi mélangé le nutella avec du lait, afin qu''il soit plus crémeux, il ne faut pas hésiter sur les bananes (une demie ça parait beaucoup mais c''est bien).', '2009-09-23T22:01:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 83aac1c6-5c7f-4add-aa92-4b8451aebee4, 'Excellent.  Je conseille cependant de mélanger la pâte à tartiner à de la crème liquide fouettée (en chantilly) : résultat à tomber, et pourquoi pas une touche de chantilly sur le dessus de la verrine, pour une plus jolie présentation.', '2009-05-21T19:15:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83943, 9024f35f-a9f1-4a75-b75a-2f82e6197c67, 'Excellent, facile, et tout le monde s''est régalé! J''ai juste rajouté un peu de lait pour que le nutella soit crémeux... Merci!', '2009-02-09T20:36:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21655, 513bb04c-9121-4583-9d3e-aa8251127401, 'Recette réalisée sans banane mais 2 pommes supplémentaires ! A REFAIRE ! (les petits se sont régalés de la préparation à la dégustation !) MERCI !', '2012-11-18T10:47:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21655, 526716c7-1967-49ad-8185-a38af385cbc1, 'Je n''avais pas de yaourt citron alors j''ai utilisé un nature et un peut de jus de citrons j''ai aussi ajouté 2 cuillères a café de miel. Très très bon.   Merci pour cette recette  ', '2011-11-24T19:19:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21655, efd752c0-88e9-43c2-9316-6043600c3188, 'J''ai ajouté de la cannelle à la pâte et supprimé la banane. De plus, j''ai utilisé un yaourt nature et du jus de citron.', '2005-02-20T17:58:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21655, 1bcf2b25-7f2e-4db0-a7bf-00d782292ead, 'Bof!! En suivant la recette à la lettre, ce gâteau n''a pas beaucoup de goût et on ne sent pas la banane...', '2004-02-06T20:49:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42660, ef35e1ac-e752-4838-9ac5-4ce0d88b1d8d, 'Ca change de l''ordinaire! Pour ma part je n''ai utilisé qu''une tranche de pain de mie par personne que j''ai recouverte d''un mélange oeuf/crème fraîche. J''ai ajouté par dessus le jambon, la banane et du cheddar. ', '2007-02-04T21:47:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42660, 6ab54ee8-b2be-4bbc-af17-9aa64198f405, 'Bon mais un peu sec, à tester avec de la crème.', '2006-12-13T00:05:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42660, c8aec1ce-a404-43a3-ac77-7004253b089b, 'J''ai bien aimé cette recette, au goût original. J''ai utilisé du fromage de chèvre en bûchette.', '2006-06-01T22:25:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18404, 04cda343-1ddd-442c-9067-a060a3bdb8f6, 'Super bon !! Réalisé 2 fois et à chaque fois il est délicieux. J''ai juste rajouté des pépites de chocolat au lait... Hum un régal !! ', '2012-06-25T18:15:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18404, 75e00c72-c138-45a0-bf3e-93820b4469c0, 'Facile, rapide, mais surtout délicieux ! Et si vous n''avez pas de lait sur (ou si vous ne savez pas ce que c''est, comme moi !) remplacez le par 1/2 tasse de crème liquide ! ', '2011-07-21T23:56:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18404, c805b3f2-dc9f-42bc-9d7d-734bee58584e, 'Super facile à faire et super bon, cependant la prochaine fois j''ajouterai moins de beurre et plus de banane. Merci pour cette super recette !', '2011-07-09T16:29:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18404, 626a61ff-8954-48d9-a45a-e47aff98c21d, 'C''est tout simplement divin !!!!!! Tiède, c''est encore meilleur, un vrai régal, à faire et à refaire. Merci.', '2010-09-30T22:48:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18404, 0b14261b-bbb8-4856-a177-ac1fef58bd1e, 'C''est excellent! Merci! C''est bien moelleux contrairement à d''autres cakes et chaud c''est encore meilleur!', '2008-03-17T17:50:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18404, a10396ca-32b1-43c5-9604-c9264b7e1df0, 'Très bon! J''ai fait quelques entorses à la recette en fonction des ingrédients et du temps disponibles... J''ai donc mis un oeuf de plus, et utilisé de la farine complète et du sucre complet (1 tasse seulement). J''ai remplacé l''extrait de vanille par du sucre vanillé, et pour le glaçage j''ai utilisé du chocolat en plaquette + lait + sucre glace: parfait! Une couche de tranches de bananes sur le fond du moule rend la banane encore plus présente. Il n''a pas fait long feu et est vraiment simple à faire, je recommencerai!', '2006-03-19T21:56:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (18404, 811d4d34-812f-4fac-aad9-e0cad3c04e48, 'Pour un cake, c''est génial... Pour une fois, ce n''est pas bourratif et c''est le meilleur moyen pour utiliser des bananes que personne ne veut parce que trop mûres!', '2002-09-24T13:35:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312180, 937af6e2-e2f3-4773-94d5-1647cc8b7ab8, 'Le croquant au dessus, le moelleux en dessous, ce cake a tout bon. Par contre cuisson, 180 degrés pendant 45mn.', '2020-11-06T21:27:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312180, deb0309f-955b-480e-ada9-c2de1a37a356, 'Très bonne !', '2020-05-08T21:02:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312180, 67edcd18-e556-4c66-957f-9c578a7516cc, 'Délicieux ! Tout le monde m’en redemande. Moi je mélange les deux parties entre elles (banane et spéculos).', '2019-06-19T10:34:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312180, 76c12a6c-4077-4f15-9d1d-c9e1b9b93011, 'Excellent !!!! Pour info, j''ai testé avec de la pâte de spéculoos c''était EXTRA !!! Merci pour cette recette simple , rapide et originale. À refaire ', '2017-02-19T17:50:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312180, 25d8d591-4713-4283-be06-e0938b600ada, 'Excellent et original. Une association agréable entre le croquant de la partie spéculoos et le moelleux du cake avec la banane.  Je n''avais que 2 bananes et c''était parfait.', '2014-08-07T15:04:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (312180, f7fb66df-0132-43b6-984d-1d1e27d1f43e, 'Pas de bananes sous la main, j''ai mis des pommes... un délice !', '2013-10-24T22:02:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345664, e9cc7f04-f678-41f4-af37-684f62b7f1c0, 'Cette recette est géniale, il ne manque que le soleil !! ☹️☹️', '2019-06-18T08:23:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (345664, 75208743-8ece-447c-a669-cedd61f7c97b, 'Parfait en fin de journée à la fraîche !
Surtout plein de Vitamines !
Je le bois pour remplacer mon repas du soir !
BRAVO !', '2018-08-20T11:52:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41431, eda23e17-d644-4d0f-a044-1cc1ba027cad, 'J''ai fait revenir les lardons et les échalotes comme conseillé par une internaute.j''ai coupé en deux les bananes, puis entaillé la peau . J''ai mis entre la peau et la chair  les lardons, puis les échalotes. J''ai légèrement décapité le dessus des moitiés des bananes et mis deux tranches de chèvre sur le dessus, puis la crème fraîche et au four. Vraiment divin, à faire et refaire souvent, mais en essayant avec d''autres variétés de fromages. Un grand merci. Bien à vous. P.S. La peau des bananes a servi réceptacle. ', '2013-11-14T11:31:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41431, 7077e590-089c-4f35-9239-dffc3d0b2888, 'Délicieux. Fait un bon plat rapide, en augmentant les quantités.', '2015-03-03T15:45:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41431, a34e6518-6567-4f87-9487-f48250b3eb62, 'Excellent et original. J''ai remplacé les lardons par de la poitrine fumée.', '2014-12-21T16:33:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41431, 3359a4dc-4cba-47ec-a83c-40e2d51bb686, 'Un délice... servi d''abord en entrée, maintenant servi aussi en plat, accompagné de riz thaï ou basmati !', '2013-06-27T19:39:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41431, 73dc230d-6855-47d2-81f2-bb432d7cdffa, 'Un vrai régal ! Merci !', '2013-03-15T09:36:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41431, 12b77052-5a80-4285-932c-0289ee5c1d52, 'Très bon et facile à préparer. La prochaine fois, je couperai dans le sens de la longueur pour que tout tienne bien sur la banane.', '2013-02-26T11:20:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41431, a84b9960-e2fd-42f7-b51d-95f60e3342fa, 'Je dirais : déconcertant. Je l''ai servi accompagné d''une salade de mâche. Je n''aurais jamais pensé à associer la banane avec du fromage de chèvre mais ça vaut le détour. Je referai volontiers cette recette.', '2012-11-26T13:30:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41431, 024128c9-5124-422f-8816-87890495a62b, 'Fait en 2 minutes et le résultat est tout simplement succulent. A faire et à refaire...', '2011-02-20T14:47:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41431, 236c0e1d-4afc-4f14-a0d7-9c45974f3752, 'On a beaucoup aimé, j''ai aussi fait revenir à la poêle les lardons et les oignons. Le temps de cuisson est cependant peut être un peu long. Avec une petite salade, c''est une très bonne entrée !', '2008-11-30T23:22:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41431, 5b6eb2be-2498-4465-93ea-7a5144ec35fa, '6 aurait été la note idéalale pour cette recette. J''ai fait revenir les échalotes dans un peu de beurre avant de les mettre sur l''assiette. J''ai aussi fait revenir les lardons. Sinon, succès garanti!', '2007-06-06T12:20:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41431, 911026f1-c0f9-496b-8812-09cb542c021c, 'Merci pour cette excellente et originale recette. Nous nous sommes régalés.', '2007-03-14T18:39:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41431, c0d57d07-c7cf-4c0c-b984-9e8c33df44ee, 'Très surprenant mais tellement délicieux ! A faire découvrir aux gourmands du sucré-salé.', '2006-05-31T16:22:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, afbb2a0f-44bf-4378-a996-9bc95ff6ba55, 'Nickel ! 
Deux fois que je fais ce gâteau, la première fois pour écouler des bananes trop mures (vraiment trop mures, du coup j''avais rajouté un peu de farine car pâte très liquide), et comme on a adoré maintenant j''achète les bananes dans le but de faire ce gâteau XD (cette fois ci recette suivie dans les proportions)
Top', '2022-03-14T21:15:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 796d36e1-b3cd-4f11-80ed-4d17150e85ec, 'Fait !! Bien apprécié ', '2023-04-03T18:10:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 4c1f0ba4-bff9-4be5-ae3d-d6182e260d44, 'Très bon gâteau si : 1sachet de levure, ajouter de la farine pour éviter texture liquide après cuisson, cuisson : 40min', '2022-07-02T16:13:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, c3cb9b7b-73fb-4d65-a5b6-ccdf5d3520fa, 'A la vue de certains commentaires négatifs, j''étais perplexe en testant cette recette mais je préfère me faire ma propre opinion : conclusion, ce gâteau est EXCELLENT. À refaire sans hésitation !', '2021-10-25T18:29:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 8bd1f728-c1a2-4628-a353-54cc356d27ea, 'Après lecture des commentaires, j''ai mis 2 bananes, 1 sachet de levure, 25g de maizena et 75g de farine. Je n''avais pas de jus d''orange ni de cannelle en revanche j''ai aussi mis des pépite de chocolat et des restes de noix émiettées ! Un régal !', '2013-01-27T22:48:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, a9e5f9e1-a864-4573-920e-8a36d27cfaf2, 'J''ai ajouté 2 yaourts nature et une cuillère à soupe de miel. Cela rend le gâteau plus doux et mœlleux.', '2011-02-27T10:06:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, a1790cf2-5853-4edb-98e1-9aacba402404, 'Franchement tres bon gâteau, je dirais plutôt que ca ressemble à un clafoutis niveau texture.
J ai mis un sachet de levure entier , par contre je l ai laissé cuire 45 mn à 190° ( mon four est à chaleur tournante).
Tres bon pour le goûter du dimanche', '2020-11-22T18:45:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 8e12685b-6d7d-4793-8a86-ddb82a785ae0, 'En effet, le gâteau lève mais retombe une fois refroidi. Néanmoins je ne pense pas que ce soit bien grave vu qu''il est délicieux et c''est quand même ça qui compte. Je n''ai pas trouvé de meilleure recette de gâteau à la banane sur Marmiton, l''association banane cannelle est exquise !', '2020-10-07T13:05:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 61c14dce-e672-45a1-b45d-c7e5cc82964d, 'Super bon, j''ai testé la recette sans sucre mais en ajoutant des pépites de chocolat et des noix.', '2019-12-18T10:49:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 7e3c8a2b-d4c6-401c-b291-539387f44f6b, 'C''est littéralement le meilleur gâteau du monde !', '2019-10-27T01:06:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, fbe3120f-22ed-46d8-86e5-3b29e7ecb049, 'Gâteau facile à faire, bien moelleux mais un peu amer , mais bon quand même.', '2019-09-30T13:25:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, db92dc26-3598-4e5e-8e9e-c74c6ea0b429, 'Excellent. Simple. Efficace pour des bananes trop mûres.
J''ai mis un carré de chocolat et cuits dans des moules à muffin, top, mais c''est vrai qu''ils ne lèvent pas beaucoup.
À refaire', '2019-05-10T05:10:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 80c63bf6-78e1-472c-8cfe-1baba6d8d758, 'J’ai adoré ce gâteau qui a éviter de gaspiller 3 bananes trop mûres! Ce gâteau est pas sec du tout et on sens bien le goût de la banane! J’ai adoré même si le gâteau n’a pas levé ce qui ne dérange pas !', '2018-09-18T14:41:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, e6752625-8917-42dc-9471-9d66bae30d45, 'Pour moi, il faudrait rajouter un corps gras (huile ou beurre) et mettre un paquet entier de levure. Sinon, le goût est là.', '2013-03-26T08:49:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, e8b71721-bc5c-4928-a5d4-6bdc25419f42, 'Le goût est bon, mais le gâteau ne monte pas. La première fois j''ai mis ça sur le compte de la levure, mais la seconde fois, c''était la même chose. Donc, ne vous attendez pas à un gros gâteau bien gonflé... Je l''ai agrémenté de crème anglaise et de chocolat chaud fondu. C''est meilleur et ça fait passer le côté spongieux...', '2012-07-03T13:56:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 06c50304-a8b5-48e4-b054-175681311d25, 'J''ai mis deux sachets de levure...  Le gâteau n''est jamais monté, mais le goût y est quand même. A éviter cependant. ', '2012-06-14T12:10:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 095877d1-9f73-4ce0-95b6-8fb625a5ca94, 'En général, je n''aime pas critiquer, mais là je me dois de vous prévenir, cette recette doit à tout prix être éviter ! Le gâteau ne lève pas, il est ultra pâteux.', '2012-05-20T20:33:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, da9d258f-51e0-4d9a-9a3e-09e8eef903fe, 'C''est bon mais ça n''a pas levé, j''ai mis un sachet de levure et un demi verre de jus d''orange je ne vois pas ou je me trompe...', '2012-04-03T21:41:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, b960f6a2-5200-41bb-9468-d81f6c4d1a35, 'Bonne recette facile et rapide à réaliser. J''ai mis un paquet entier de levure après avoir lu les commentaires, c''était parfait ! Pour info, n''aimant pas la cannelle, je n''en ai pas mis, le gâteau reste excellent. La cuisson a été plus longue, mais j''ai peut-être un problème avec mon four. ', '2011-11-13T09:31:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, a29400bf-dac2-441b-b3ac-6d51c0961c61, 'Bon goût mais consistance assez pâteuse, genre clafoutis. Je l''ai parfumé avec un mélange pour pâtisserie (cannelle, noix de muscade, coriandre, clou de girofle, piment de Jamaïque non piquant).', '2011-04-10T22:36:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 0f1adecb-f205-46c5-a73e-a64f52b936ec, 'Recette facile à faire mais c''est un gâteau un peu plat, il faut sans doute plus de levure. A refaire, Piemo.', '2011-04-03T16:09:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 3b2d9535-8a83-47db-aa10-dc913560a7f8, 'Il y a eu certainement un problème au niveau de la levure, il n''a pas levé du tout, dommage, mais je vais réessayer.', '2011-02-23T22:11:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 7394b3a9-dacd-461f-99fc-8f411388a42b, 'Super pour utiliser des bananes trop mûres dont personne ne veut. Rapide et facile.', '2011-02-11T15:41:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 6a3d94b9-b288-4335-a9cd-5a6dd2c0797e, 'Très bon dommage seulement que le gâteau retombe à la sortie du four  ; mais bon on s''est quand même régalés.', '2011-02-07T20:18:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 6a8e4678-2efe-485f-b85a-d336b1c36971, 'En lisant les commentaires de cette recette, j''ai un peu hésité à faire ce gâteau, alors j''ai fait un mix. J''ai gardé toutes les proportions sauf que j''ai mis un verre de jus d''orange et une banane. 3 oeufs et le sachet entier de levure. Ce n''est pas un gâteau qui lève beaucoup mais dans un petit moule à manqué c''est parfait. Et je le referais.', '2011-02-04T16:45:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 974c5b7f-2e3e-4742-a736-d0299b14c9e3, 'Personnellement je n''aime pas les bananes, mais le gâteau devait être bon puisqu''il a été mangé en très peu de temps par mes enfants.', '2011-01-29T20:47:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 91394a25-6b3a-4c01-92c7-1bba8856b681, 'Très bon, toutefois un peu trop sucré.', '2011-01-29T15:56:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, cc58ed4c-049c-48f4-be67-edbe6b923254, 'Vraiment très bon et sans matières grasses; pour 2 j''ai divisé les proportions et ajouté une cuillère café de rhum. Pour changer la présentation j''ai pris un moule à muffins. Impeccable !', '2011-01-27T17:47:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 62bd7024-d726-48a1-965d-5cef6cf592bb, 'J''ai trouvé cette recette très bonne et facile ! Je l''ai fait cuire 30 min et c''était moelleux à souhait.', '2011-01-26T13:59:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, ff2c661b-f363-4e8d-915d-beefacb6f3eb, 'Parfait pour écouler les bananes trop mûres et moi je rajoute soit des pépites de chocolat, ou des amandes et noix de pécan. Mes enfants adorent', '2010-06-23T12:59:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, ac8d8f36-db55-44d8-a833-0b22eef9b83b, 'La texture du gâteau n''est en effet pas très bonne, un peu gâteau de pain. Le gâteau avait bien monte en doublant la dose de levure mais est redescendu tout de suite. Bref pas une grande réussite, je préfère utiliser mes banane trop mures en smoothie.', '2010-02-07T16:23:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 75580842-583f-4374-9567-f962f6b353b2, 'C''était pas mal, j''ai mis un peu de maïzena pour être plus léger...et du nutella au milieu pour être plus gourmand !', '2009-07-26T13:57:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 77d11e1f-e218-43c7-a479-87b10dfe37f9, 'Entre 4 et 5, en fait, car le goût est bon, alors que je n''aime pas les bananes. Mais je n''ai pas suivi la recette à la lettre : j''ai tenu compte des commentaires et mis 1 banane au lieu de 3, mis 1 sachet entier de levure et battu les blancs en neige, pour les incorporer ensuite. Mais le gâteau ne lève pas, bien que la pâte soit plus aérée, et il colle quelque peu, sans doute à cause des bananes.', '2009-05-27T15:07:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, bf3c065d-b217-433a-8af7-bbabd4d261c7, 'Je suis en train de le faire cuire, je vais rajouter un glacage au chocolat ! Hum !', '2007-10-17T19:33:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 10281e56-c5c7-49b7-bbc1-009ef977342c, 'La couleur est identique à la photo mais le gâteau n''a pas levé. Très moyen, élastique et pas extra.', '2007-10-08T21:07:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, 1a02828c-c117-48c9-9161-42d428a7887b, 'Gâteau trop compact, je pense qu''il manque de levure ! Et le temps de cuisson a été de plus de 40 min ! Je pense que 3 bananes c''est trop, le goût de la banane était trop élevée à mon goût !', '2007-06-16T17:01:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, d9f58d2f-a367-4d2f-b8d8-a6b60b161e6a, 'Cette recette est une excellente idée pour ne pas jeter les bananes trop mûres... J''ai suivi la recette en ôtant 20g de sucre, et c''était parfait! En revanche, il a fallu plus de 40 minutes de cuisson, et la prochaine fois je mettrai tout le sachet de levure : le gâteau était un peu compact.', '2007-06-01T13:27:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, fd404428-e925-41c3-9ccc-a792deb9db69, 'Un petit gâteau parfait pour finir les bananes même avec 1 seule c''est bon! A servir pour le goûter. ', '2007-02-25T13:39:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, c719d972-bfaf-43b2-be15-c1dd801ea940, 'Recette sympathique, j''ai mixé les 3 bananes avec l''orange entière et une pomme, j''ai ajouté des carrés de chocolat concassés, cuit une quarantaine de minutes et servi avec de la crème chantilly.', '2006-12-24T00:38:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42579, b33ec996-5ba5-4b18-a19e-976ca578cff2, 'Recette simple et délicieuse. J''ai tout de même réduit la quantité de beurre et de sucre surtout avec des bananes très mûres.', '2006-05-29T23:03:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (195058, 8a16c1de-6ce9-402d-a358-af95dcc1f5b2, 'Un véritable délice gourmand ! Je me suis simplifié la tâche, et j''ai remplacé la crème fouettée vanillée par de la Chantilly en bombe. A garder précieusement dans mon carnet.', '2012-01-08T00:18:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48584, d94376ba-bfa5-4847-ba96-1bcf1b029261, 'Je mets 5/5 pour le goût et la texture par contre j''ai diminué la quantité de sucre 150 g et la prochaine fois, je mettrai moins de beurre.', '2007-05-17T11:52:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48584, a7602e60-386b-4d4c-b18a-f3a328d12c65, 'Je mets seulement 1/3 du sucre, 1 sachet de sucre vanille et 1 banane en plus. Merci pour la recette !', '2022-02-20T14:12:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48584, 74036158-69b8-4dc8-bbfd-70c6f2292423, 'Délicieux cake, très moelleux. Je recommandes. ', '2020-04-03T18:23:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48584, 6b111cb6-ce2b-4861-b1d9-4829e56afb21, 'Un vrai régal, très moelleux bien parfumé, extra quoi ! Je referais sans aucun doute dés que j''aurais des bananes avancées', '2011-12-16T19:33:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48584, 48aa6d54-ad5a-4aea-8c0c-e056cc4c5172, 'J''aurais mis un 10 si j''avais pu tant c''est délicieux. J''ai mis moins de sucre (100 g) et de la cassonade brune pour avoir cette couleur foncée. Un peu plus de bananes et la 2ème fois, j''ai mis à macérer dans du rhum. Un grand merci.', '2011-10-20T20:47:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48584, 458ba947-cb8e-4330-975b-62659df1f4e5, 'Excellent cake, vraiment délicieux et si moelleux. Merci pour la recette ! J''ai mis un peu moins de sucre et de beurre, et une 1/2 banane en plus. ', '2010-04-18T19:33:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48584, aaa71c28-f9f3-485f-b1b8-1d9670483c8e, 'Très très bon on a adoré ainsi que l''odeur qui se dégage du four lors de la cuisson (une odeur irrésistible de caramel). Très facile et rapide à faire', '2009-04-25T21:09:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (48584, d634d97a-6503-4115-9f26-7da14386911e, 'J''ai complètement oublié de mettre un commentaire. J''ai testé, et nous avons adoré. J''en ai fait dans des petits moules individuels et au congélateur, c''est le premier lieu que ma belle-fille visite lorsqu''elle vient à la maison. Merci Docteur Girafe, merci pour la recette et pour tout le reste. ', '2006-10-08T19:45:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 3978b8c5-5142-411d-a5b4-c9aaa99c4ddf, 'J''ai suivi les conseils d''un autre commentaire pour la composition du crumble (150g de cassonade, 150g de farine et 60g de beurre mou) et j''ai ajouté du sirop parfumé à la vanille au lieu du sucre pour caraméliser les pommes. Excellent ! Deviendra certainement chez nous une option dessert favori !', '2014-03-22T09:19:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, c3d9503d-a061-435d-8aed-d8795ecc889c, 'Délicieux !', '2019-10-16T19:36:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 94634156-2322-425f-9779-de986f0fb0cf, 'Très bon', '2017-10-10T21:47:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 83f469b7-f8c2-451d-8dcb-7d35b0a4e088, 'Inverser les quantités pomme / banane.', '2016-10-29T13:31:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 731cb2a2-009a-4394-bc60-41d62cb54995, 'Je n''avais pas lu les commentaires et j''ai eu tord. La croûte est toute ratée.', '2016-10-02T15:14:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 1250ef29-dc4f-43bd-9985-c81357bb43be, 'J''ai suivi les conseils des précédents commentaires et j''ai donc mis : 150 g de farine, 150 g de cassonade et 80 g de beurre mou. Par contre ça fait des trop grosses couches de pâtes par dessus et à mon goût il n''en faut pas trop non plus, alors réduire les quantités ou bien ajouter des fruits pour en avoir plus.', '2016-06-02T01:58:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 0c0f24f2-6c74-4f05-850f-05af1b683ff0, '8 biscottes à la place de la cassonade.', '2016-04-11T11:45:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 902c7d47-c906-4b5b-ae10-813a7dfa5ac5, 'Rien à dire au niveau de la préparation des fruits qui est très fondante. En revanche, les proportions de la pâte crumble ne sont pas bonnes : elle est trop pâteuse et ne s''émiette pas. Je reprendrais mes proportions à moi : 120 g de beurre - 120 g de farine - 120 g de sucre. ', '2016-02-14T17:07:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 4260bdec-2e6d-441d-bd9b-93f247ab66a6, 'J''ai suivi les conseils et inversé les proportions de farine et de beurre, mis 3 petites pommes au lieu de 2, et oublié les pistaches mais c''était très bon ! On s''est régalés ! ', '2015-08-21T00:07:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 404a38c9-b26e-4994-9e88-468a7d62073b, 'Superbe, j''ai bien aimé', '2014-11-03T15:58:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 0ac4bc39-584a-4ba1-9b26-e936ba1cd924, 'Tellement facile et tellement bon que lorsque il me reste 1 ou 2 bananes mûres je les fait simplement en crumble sans pommes.', '2014-06-04T10:02:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, d24a7ad5-d975-4644-b7cb-7e8015bc6409, 'Rien à dire sur les fruits, le crumble est très bon avec les pommes caramélisées associées à la banane. Un bémol toutefois sur le biscuit : le crumble a du mal à s''émietter, il est beaucoup trop collant et l''ajout de farine rend l''ensemble un peu trop farineux lorsque le tout est cuit. La prochaine fois, je prendrai une autre recette pour la pâte à crumble.', '2014-02-24T11:50:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 6bf29eb4-e0b0-4489-a418-061db8f4a419, 'Très bien réussi, j''ai juste ajouté un peu de caramel liquide. Régal pour tous.', '2013-04-18T13:14:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 1b651763-8c31-4ae7-8bfb-9393c0f42701, 'Excellent... Le meilleur que je fais.', '2013-04-05T17:50:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 93e9b6bb-2a72-4a64-87b8-94dfb6441123, 'J''utilise cette recette comme base de quasi tous mes crumbles. J''ajoute un peu de farine car la pâte est trop collante sinon.', '2012-08-11T17:21:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 33d2c4e7-8567-4ca2-87e3-069cbb00bf86, 'Proportion mal adaptée et les bananes noircisses...', '2012-01-30T19:55:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 8b786372-bf27-4c4d-a19b-39db6b87e9c8, 'Nous l''avons fait sans pommes et sans les pistaches et on s''est régalé, facile à faire en plus ! On adore.', '2011-11-20T14:28:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, a358f6a6-e845-4ec0-ae7a-2f20a78a8dfc, 'Fait sans les pistaches. J''ai ajouté un peu de farine car la pâte était trop collante. J''ai un peu réduit le beurre. Mes hôtes ont adoré. Facile à faire je le conseille. ', '2011-08-03T00:11:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, a76d7244-3d09-473e-b179-98121b8fdd73, 'Mon 1er crumble : un délice ! Merci ! J''ai néanmoins modifié les quantités : 150g de farine, 80g de beurre mou, 80 de sucre. A refaire sans hésiter. ', '2011-05-15T23:36:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 90eb860a-70a6-4a71-9319-2a0fbf77600b, 'Une recette excellente. Pour ma part, je fais aussi revenir les bananes un peu avant de retirer les pommes. Les pistaches sont incontournables, c''est vraiment meilleur avec. Merci pour cette recette.', '2011-04-16T22:18:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, ba86e51a-f828-4ed3-984c-0b39b167e5e5, 'Délicieux, merci ! Je n''avais pas de pistaches, c''était très bon quand même...', '2011-04-14T04:03:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 0095eed9-1a4d-4b39-b4a9-9d2b875f462e, 'Nous nous sommes régalés mon mari et moi avec cette recette. Je me suis inspirée des remarques des autres internautes en diminuant les quantité de sucre et de beurre. J''ai également mélangé à la farine 40 g de noix de coco râpée et ai ajouté un peu de cannelle et de rhum. ', '2011-02-14T21:59:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 6ddc576d-1d06-4bd6-8fd0-0f9026bdac7a, 'Ce dessert est super bon il est frais est quelque peu original !!!!', '2011-01-25T19:34:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, a3ab0d52-28c8-4d01-a699-46dce640007b, 'Délicieux mais à consommer rapidement car la banane à tendance à noircir', '2009-11-22T12:41:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, c0cd532e-7855-43dc-ad56-a3900c397e27, 'Voilà les doses que je préconise pour la pâte à crumble : 150 g de cassonade, 150 g de farine, 60 g de beurre mou.', '2009-07-07T15:28:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 04702cac-526d-4345-891b-d6ac695829de, 'Trop riche en beurre, j''ai dû rajouter au moins 100 g de farine ainsi que du sucre vanillé afin d''y avoir plus de goût.', '2009-06-02T15:48:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, b47c266b-2324-4919-8026-c1efdc7f5ee3, 'Un peu déçu, j''en ai mangé des meilleurs.', '2009-03-07T13:22:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 6abd6315-c7cf-474e-82a6-b2edce7c8b15, 'Très bonne recette, j''ai juste inversé les proportions de beurre et de farine pour obtenir un dessert moins gras et remplacé le citron par deux cuillères à soupe de rhum. Succès garanti.', '2009-03-02T12:45:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 8b3f473a-fc75-4259-8016-7254b3a6dd3c, 'Un délice! Merci pour cette recette qui a séduit tout le monde...', '2009-02-05T13:58:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 4274b491-ac98-4f09-a462-b8bc3bc22477, 'Je suis bluffée, je ne suis pourtant pas une fan de banane mais alors là, j''adore ; je la referai souvent, c''est un régal même sans les pistaches. J''ai mis dans un grand moule et fais cuire un peu plus longtemps que prévu. Ça va être un de mes classiques dorénavant.', '2009-02-04T13:47:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 959d6597-9609-481a-a227-7af08c622e1d, 'Excellente recette. Comme je n''avais pas d''enfants j''ai déglacé les pommes avec deux bouchons de rhum, cela va très bien avec les pommes et les bananes et rehausse le goût.', '2009-02-02T19:49:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 6eaaae68-ce88-4404-8d6b-261cceb7b0ba, 'Excellent. Gros succès. A faire et à refaire même sans les pistaches. Merci pour cette recette.', '2008-12-22T10:07:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, bf267864-d368-4654-96a8-d77fdaf41732, 'Excellente recette !!! Super simple et super bonne !! A fait l''unanimité auprès des invités, même sans pistaches !! A faire, à faire, à faire et à refaire (j''en ai même refait un le lendemain rien que pour nous !!!) Merci pour cette recette !', '2008-11-21T10:06:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, bc0863c1-2a8e-408a-860c-8881f9d6db3e, 'Un bon dessert au goût, mais je n''ai pas retrouvé le côté crumble. En fait en vérifiant une autre recette, j''ai vu que les proportions sont de 50g de beurre pour 100g de farine... Au final c''est un peu trop gras et trop sucré. Attention à rester près du four dans la phase "grill", risque de brûler le tout :(', '2008-07-03T00:26:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, ab29d8c8-ef03-4d21-8557-c716ace3c305, 'L''un des meilleurs desserts que j''ai goûté, accompagné de glace vanille c''est un délice. Attention à l''explosion de ventre, car on a du mal à s''arrêter avant que le plat ne soit totalement nettoyé !', '2008-05-21T10:29:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 608b8ca7-a22c-4769-9d14-1e03c8daaed0, 'Mon chéri fait exprès de laisser des bananes dans la corbeille pour que je lui re-fasse ce crumble!!!', '2008-05-12T13:18:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 82a84a5a-0f41-42a4-a912-ea1461746238, 'Très bon et facile à faire !', '2008-04-28T01:50:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 65b4c8ec-a47b-4863-a500-5a6704810453, 'Il restait une banane toute noire, deux pommes goldens ridées et un fond de pistaches....Elles nous ont quand même permis de réaliser un super goûter...Rapide, facile et succulent. NB: on a réduit les quantités de sucre et de beurre.    Merci à la communauté marmiton!', '2008-03-24T17:55:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, d6273528-50b9-4d20-955e-8b02b572fab0, 'Vraiment excellent!!! Recette très rapide et très simple à faire. Par contre je n''ai pas mis les pistaches (car je n''en avais pas sous la main), et c''était quand même très réussi! A déguster tiède c''est encore meilleur.', '2008-02-20T21:30:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 5823bc43-fbff-45ea-a5e0-16c8df28df95, 'J''ai suivi les conseils précédents ; je n''ai pas mis de pistaches ; j''ai utilisé un citron vert.  Mes ramequins devaient être trop petits car j''avais une couche de pâte au dessus des fruits de plus d''1 cm d''épaisseur si bien que la pâte au dessous n''était pas très cuite. Enfin, même si les bananes étaient jeunes, j''ai trouvé qu''on les sentaient trop.', '2008-01-04T21:31:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, b2040c9f-e744-45b9-8da5-5afb9b4c8ac6, 'Recette délicieuse ! Attention à ne pas prendre des bananes trop parfumées sinon on ne sent qu''elles !', '2007-10-07T17:00:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 49e0125c-3df6-4aa5-a872-69c525a440fa, 'Bon dessert, facile et rapide à faire', '2007-09-27T20:38:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, ed0c4a72-e964-43ee-aff1-866576e28a11, 'Les enfants ont eu beaucoup de plaisir à mettre les mains à la pâte littéralement!!!!  ainsi qu''à déguster, merci. ', '2007-08-17T16:10:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 7bb61bfc-18fd-4d8a-af01-55679f16bf1d, 'Super bon! Perso, je n''ai pas fait revenir les fruits (bananes, pommes et kiwi) et j''ai mis un bâton de cannelle (par goût). On s''est régalé!!!', '2006-12-31T14:15:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 332ae5a1-0f13-41c0-bc64-546884bfdd61, 'Vraiment bon!! J''ai suivi les conseils : 120g de beurre pour 180g de farine, et c''était bien à mon goût. Je n''aurais pas pensé aux pistaches, mais ça donne un goût très sympa. J''en ai fait aussi avec de la cannelle. ', '2006-10-28T23:04:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 654d60c8-6d65-4f83-a788-290a6e689074, 'Excellente recette facile à faire, mais comptez un peu plus de 10 min. Quelques suggestions: plutôt 200 g de farine pour la pâte si vous voulez obtenir une bonne pâte sablée. Nous avons ajouté de la cannelle au lieu des pistaches, c''est très bon aussi! Quant au citron, préférez le jus d''un demi, et encore... Bon appétit!', '2006-01-21T23:44:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, bbb04667-0fce-4e78-aeed-60772eeeb08a, 'Pour moi c''est LA recette du crumble. J''ai remplacé les pommes par des mandarines et mis un peu de rhum et vanille. Excellent aussi.', '2005-12-30T15:29:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 6158b932-0273-4080-895a-f11c5ed08fd2, 'Je rajouterai personnellement un peu d''épices, la prochaine fois, sinon la banane est fade.', '2005-12-18T18:43:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, df0665ac-3815-4bfa-aef0-e193948ea728, 'Excellent... cependant un peu trop sucré selon mon mari... j''ai peut-être eu la main un peu trop leste sur le sucre pour caraméliser les pommes... mais délicieux tout de même !!', '2005-05-19T12:06:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 7bb81fba-01bb-4edf-816c-eac249d7db4d, 'Absolument délicieuse!', '2005-04-16T12:31:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, c66bb268-2103-4976-a2f0-7abd65be9936, 'Je n''ai pas mis de citron, ni de pistaches. Le résultat: un excellent crumble! A refaire sans hésitation.', '2005-02-22T16:56:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 24e239a4-acdb-490a-a936-ec5ff50d981e, 'C''était mon premier crumble, et je l''ai vraiment bien réussi avec cette très bonne recette! La pomme caramélisée se marie très bien avec les bananes. J''ai fait cette recette pour deux, en divisant toutes les proportions et ça s''est très bien passé. Merci!!!', '2004-06-24T16:19:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 364ac6c9-7f54-4bf8-bf0a-ea6ce24e7323, 'Je ne mets qu''une pomme (coupée en fines lamelles) que je laisse cuire tout doucement en ajoutant du sucre roux et de la cannelle. Attention en  manipulant, c''est fragile. Les pistaches ne sont pas indispensables!!', '2004-06-13T21:19:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 6fce8b45-6bd3-4e15-bf11-2066ab23ebfe, 'Très bon. Pour un grand plat, je mets 150g de farine, 100g de sucre et 100 à 125g de beurre selon comment est la pâte. Durant la saison des fraises, on peux remplacer les bananes par des fraises. Dans ce cas verser le jus d''un citron sur les fraises et les pommes, préparer votre pâte puis placer les fruits au fond du plat avec un peu du jus de la macération. Faites cuire 20 min à 160°C, pas plus, juste ce qu''il faut pour que la pâte soit cuite, vous pourrez la faire dorer en la mettant 2 ou 3 minutes au grill. Délicieux...', '2003-10-04T09:40:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, a6bc43c4-42d8-4066-a5b2-1affd7616aa3, 'Très bon, tout simplement, si on aime les bananes!! J''ai adoré...', '2003-07-06T11:47:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 2a29040e-89c7-4a9a-8104-1e6eba71595d, 'Très bon. Remplacer éventuellement les pommes par de la compote. Mettre plutôt 120g de beurre pour 180g de farine.', '2003-05-15T00:57:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 406ef0a9-2111-4837-a152-63ecf21bcef6, 'Mis à part le biscuit où j''ai changé les doses, le mélange des fruits est super bon!', '2003-01-26T18:52:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 11542a08-ed0a-4754-be9f-3db121bdd3f9, 'Le citron est à bannir!! Il écrase le goût de la banane et de la pomme sans vergogne. J''ai mis la même proportion de farine et de beurre. Plus de temps de préparation que ce qui est indiqué!', '2002-08-20T13:58:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 054a467b-16d9-417b-bede-24d92f1670a5, 'Le mélange de fruits est délicieux, mais les proportions farine/beurre font la part belle au beurre. d''où un goût trop prononcé de beurre qui a gâché un peu l''ensemble.  Les autres recettes de crumble donnent toutes une proportion de farine supérieure à celle de beurre...', '2002-08-14T16:40:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13195, 398f4054-5a23-4e2e-b095-b032fde1eab0, 'Excellent à la fin d''un repas, tiède avec une boule de glace vanille (même sans les pistaches). Tout aussi fameux, légèrement tiède encore, avec une tasse d''un bon thé non parfumé, à 5 heures...    ', '2002-06-09T12:02:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25519, 5a5da337-eddc-45ce-9863-3b099d453e23, 'Je n''ai pas pris les fruits indiqués... mais le résultat est excellent', '2016-06-27T22:11:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25519, f29ea6b1-46cf-43bb-a66e-c028c1c78ee1, 'Après un repas copieux, très bon dessert. Le goût du champagne se marie super bien avec les fruits. ', '2012-02-17T22:20:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (25519, ccdf3e54-ea66-47bb-94cb-7681bcc130df, 'Faite avec des abricots, framboises, fraises et cerises ! Délicieux !', '2009-05-26T22:16:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53123, 93855b1d-d696-4d4a-98c1-7c041beb8f8d, 'miam je me suis régalé', '2019-07-22T17:34:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53123, 2814ffb9-6f0d-41a4-a984-f6ddc8f1a7dc, 'Bonne recette, mais nous n''avons pas adoré', '2010-12-19T15:38:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53123, aced182c-fef2-4c99-8ec4-716b6a45a26f, 'Recette facile à faire et le résultat est délicieux. Une idée originale d''utiliser la banane en dessert. A refaire.', '2010-11-13T13:02:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53123, d0c176b7-6005-4b77-bc9e-8b3b9ab277af, 'J''ai essayé cette recette c''est un délice, je n''avais pas de rhum, j''ai donc mis du kirch et c''était très bon.', '2010-11-11T19:28:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53123, 3ad2f6f9-36ac-472a-b171-0111e7bd1fff, 'Trop trop bon !!! J''ai laissé la peau et mis tous les ingrédients de la recette ! C''était super avec une boule de glace vanille ! Par contre pour les grands enfants vous pouvez y aller sur le rhum, j''ai mis des petites cuillères à soupe ça aurait mérité des grandes. Et quand les raisins cuisent dans le jus d''orange, attention à ne pas les oublier plus de 20 min sinon votre casserole s''en rappelera ! Le seul petit bémol : la présentation, pas super top (mais pour moi c''est la peau qui fait le charme) ', '2010-11-11T15:49:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53123, 38dc1ef7-956a-4e33-a0a9-6d6588b4062e, 'Très bonne recette de dessert! Pour ma part je n''ai pas mis de chocolat (car j''avais déjà fait un plat copieux !). J''avais un a priori sur le fait de laisser la peau mais finalement, au moment de servir, c''était très sympa et ça a rajouté une petite note exotique ! Une autre remarque: les raisins secs !!! un vrai délices ! j''en ai fait plus que prévu et en ai parsemé les boules de glace vanille ! Un vrai régal ! Merci.', '2008-04-24T16:58:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53123, 8314d702-ef68-4aa5-b815-dd3f86719be9, 'C''est très bon mais il serait préférable de faire cuire les bananes dans un plat indivudel car c''est peu pratique à faire avec la peau.', '2007-05-30T18:06:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 71be5c9a-c43d-45b2-a58f-8338f357468b, 'Très bon !!!', '2022-02-02T11:47:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, da6470ad-2f22-40f8-be67-b44080827309, 'J''ai fait cette recette hier soir. C''était super bon sauf que la prochaine fois j’essaierai sans jus de bananes car j''ai trouvé que ça cassait un peu le goût de lait de coco. Mais on a tous adoré. Comme toutes personnes qui aiment cuisiner, j''ai goûté et ajouté un peu de sucre car j''ai comme fait une bouteille de rhum de 1 Litre et ajouté un peu de crème fraîche pour avoir l''épaisseur du bonne crème. Un de mes invités m''a dit qu''il fallait mieux prendre de la crème de coco plutôt que du lait. En tout cas, ça reste un bon cocktail. Merci.   ', '2014-07-13T15:13:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 6b3b7120-d835-4a41-b628-ffc5032eb695, 'J''avais des invités samedi dernier, j''ai fait cette recette de pina colada et je n''ai eu que des félicitations. À l''apéro tout avait disparu ! Merci encore.', '2013-03-23T22:20:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 184ad492-2f40-4ce3-9f6e-23e2c8629bc1, 'Excellente recette ! Les proportions sont idéales et la texture aussi, même si nous n''avions pas de glace pilée. Mes invités ont beaucoup aimé et ont pu se resservir car ce cocktail n''est pas trop fort ! A refaire dès que possible !', '2011-01-31T21:53:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 1d756268-5c82-49e9-9922-da79208bb581, 'Depuis le temps que j''en rêvais... 35 cl de rhum au lieu des 25 proposés, un régal...(même sans blender ni glace pilée)', '2010-03-05T19:42:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 5bb9bdf4-f16c-4db6-bdf5-7e9908964db4, 'Très bon. Je l''ai fait à l''occasion d''un repas mexicain, et mes invités ont tous adoré! Pour certains, un peu plus de rhum serait encore meilleur, mais pas pour tous.', '2008-12-17T19:45:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 1783df6c-3299-40b2-b274-e7266c394921, 'Très bon, j''ai fais cette recette quand il y avait des invités. Ils on adorer et moi aussi, je recommandes cette recette exotique et parfaite... .', '2023-12-27T15:49:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, da5315cc-cb14-4d0b-91ef-4a4a07bd8b02, 'La cannelle et la banane prennent le dessus. Ça ne ressemble pas à la Piña Colada.', '2023-07-14T20:43:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, a164b2c4-c49f-42eb-b119-29723d218fc7, 'Très bonne ! J''ai pris un jus d''ananas de bonne qualité et j''ai mixé moi même 5 bananes avec un fond d''eau. Cannelle en poudre. 2 cuillères à soupe d''arôme de vanille. Sans rhum comme ça chacun rajoute ou pas à sa convenance :) Un délice et bien mousseux sur le dessus. ', '2020-05-25T21:10:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 226eefab-9f27-4c8f-983d-fb2cc216d7d2, 'Franchement cette recette est géniale, merci. Après, je pense qu''il faut choisir les bons jus !', '2019-01-25T05:17:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 7bdb7dc4-36cb-4124-b90a-2ec854f282b8, 'Très bonne recette cependant, je remplace le lait d’en coco par de la crème de coco, et je rajoute 5cl de Malibu pour avoir un meilleur goût de coco Tout cela apporte un cocktail plus onctueux !', '2018-08-27T14:27:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 085a2200-329b-4367-af7e-09240f0a4418, 'J''ai juste oublié de mettre la muscade. J''ai fais 15 litres pour 32 personnes. C''était délicieux !! J''ai eu que des compliments. ', '2017-08-29T11:45:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, bb95d5de-4956-4f4f-8fa9-efe2a3351b59, 'Vraiment bonne, en suivant la recette à la lettre (épices, fait la veille...), tout le monde a adoré.', '2016-11-25T19:55:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 35896385-1398-441f-9e08-4fb114c44772, 'Tres bonne recette :-) mais pour un meilleur effet cocktail, une fois le cocktail dans les verres je rajoute un peu de sirop de curaçao pour faire un fond bleu et le curaçao se marie très bien avec la pina ;-) ', '2014-05-04T18:17:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 3e58c2c5-da25-4d61-9a1f-35c583645891, 'Excellent ! A faire et à refaire mais avec modération...', '2013-04-24T11:19:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, e69076ed-c942-43b3-bf33-d34ec4c4b782, 'Excellent ! Mon amie qui fait régulièrement ce cocktail m''a dit qu''il était meilleur que le sien ! ', '2013-03-01T10:47:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 1825449b-4d1e-4567-bc9d-2af416b00d10, 'Très bonne recette qui a été appréciée de tous!', '2013-01-02T12:18:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 802c525a-a17e-49b4-a86e-64df21b9bca2, 'Alors là... Cette recette est une vague imitation ou pale copie d''une vrai pina : trop liquide, trop alcoolisée, pas assez sucrée, bref cocktail 1er prix. Déçue, déçue, déçue... et pourtant suivie à la lettre.', '2012-09-17T22:04:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, ea31399d-9200-4cb6-b874-6717e13613a7, 'Une tuerie, on en fait très souvent, en plus je suis fan du lait de coco', '2012-08-09T18:23:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 85cce989-d124-49d5-ba94-e96d2772c5fb, 'Piña colada excellentissime ! Prudence on ne sent pas trop le rhum surtout quand elle est bien bien fraîche ! Mais à faire et refaire ! ', '2012-05-21T14:09:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, c3a212c7-4e97-4163-a06d-b9e266ecb8b7, 'Vraiment très bon et on ne sent pas trop le rhum donc prudence !!! Par contre je n''ai pas mis de jus de banane car je n''en avais pas et c''était tout aussi bon !', '2012-03-04T00:28:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 600d6ae1-070a-4970-9de0-35c13c7abb21, 'Curieusement, j''ai trouvé que la texture était trop liquide et que l''ensemble n''était pas assez sucré... Rien à voir avec les bonnes pinas coladas du Mexique... Déçue déçue, je n''adopterai pas cette recette.', '2011-03-13T11:26:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, c1922dee-0e35-43c8-a828-c5e38b51579c, 'Bonne recette. Sans alcool, les enfants ont pu en profiter aussi', '2010-12-26T05:23:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, e7bf9cd0-78b3-4f98-aad0-fd1bfcc6bf5e, 'Voilà essayée mais pas adoptée ! Sur 5 adultes, personne n''a vraiment été conquis et pourtant nous aimions tous les ingrédients séparément ! Désolée mais je ne la referai pas.', '2010-07-16T21:56:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, c9111f7b-4404-4d02-abae-94a36b1db086, 'Avec ou sans alcool, cette recette de cocktail est extra. Encore meilleure si on la fait la veille, cette boisson est très appréciée des petits comme des grands.', '2009-12-14T01:18:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 7900ae71-c374-4d63-bd04-0557451d58bf, 'Je suis enceinte et même sans rhum c''est une boisson conviviale et délicieuse. Parfait!', '2009-02-17T14:18:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 5ad121be-8ae7-4770-ab7b-9def68130965, 'Très bonne recette. Nos amis ont adoré.', '2007-07-29T19:36:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 64b9d63f-db13-4e30-863c-02b39f9c83e5, 'Délicieux et très simple à faire. J''ai mis un sachet de sucre vanillé, on peut augmenter un peu la quantité de rhum mais la recette reste bien dosée. A refaire !', '2007-05-27T23:34:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 1e4654d0-779c-44db-86d7-d70f30df7d1c, 'Excellente!! J''ai mis un sachet de sucre vanillé à la place de la vanille, et j''ai rajouté un peu plus de rhum! Pas besoin de la faire la veille, elle est très bonne le jour même!', '2006-08-21T17:32:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, f6f54eec-f0c5-455e-9fa3-55868ee183ea, 'Délicieux mais manque un peu de rhum à notre goût!', '2006-08-16T17:23:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 841626be-325b-4d89-a90a-b85976855a3a, 'Délicieux! J''en ai fait 8 l pour une soirée tex-mex à 25 personnes, tout le monde a adoré et m''a demandé la recette. Certains ont même fait tout le repas avec. Je n''avais pas de vanille, alors j''ai mis du sucre vanillé à la place.', '2006-07-24T13:20:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, f0dead80-78c4-420a-b08d-12a4e274b3d0, 'Un peu trop écoeurant à mon goût. On peut peut-être améliorer en diminuant la quantité de lait de coco. Là ça fait vraiment trop laiteux...', '2006-06-06T21:15:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 161a21fa-5f7d-4e35-96da-c12f64f38f96, 'Parfait, les dosages sont précis et le résultat à été très apprécié. Merci!', '2006-02-14T18:29:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, e95b4ea4-e3fc-4de9-a73f-9600935caa82, 'Délicieux, réalisé également avec du jus banane-pêche et en augmentant la dose de rhum.', '2006-02-11T12:15:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 9433c739-439c-4f9c-979a-6e29f340229c, 'Délicieux! J''ai fait 2 versions : 1 avec rhum, et l''autre sans alcool. ', '2005-11-28T16:01:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, cad08162-6ad2-4c67-8eb2-5e57ff6aefbc, 'Facile à réaliser. C''est très frais. Cependant, délicat à réaliser, pour un grand nombre de personne.', '2005-10-29T19:01:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 6cf892f7-8f60-42cc-af3d-42b0a655b2e1, 'Moyen. La cannelle a prédominé sur tout le goût. Cette recette nécessite davantage de préparation pour un résultat moins bon...Dommage.', '2005-09-12T15:51:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, fd7ffd82-26a2-4416-9bc2-ec61d84f62dc, 'Faute d''avoir un bâton de cannelle, j''en ai mis en poudre... le charme se fait également! Quelle merveilleuse recette pour inviter des amis... l''alcool ne se sent pas, on le boit comme du petit lait !', '2005-09-11T16:57:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 33dcb6c3-a11b-45cd-bfa3-d505ff5a98ec, 'Mais, c''est la recette de la Banana Colada, ça ! Sauf erreur de ma part, il n''y a pas de banane dans la Pina. Mais bon, ceci n''enlève rien à cette délicieuse recette. Bravo !', '2005-07-11T18:07:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 463c3e18-32a8-4842-85a1-47854ef018df, 'Ca se boit comme du petit lait!', '2005-06-01T15:01:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 4041c86f-c8a7-423c-b75c-6427f3d64744, 'Excellent, comme toujours. La pina colada reste mon cocktail préféré!!!', '2005-05-31T21:21:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 590e5e2b-7da5-49f2-bea7-3dbf68c209b0, 'Excellent!', '2005-03-30T20:09:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 5801a8ba-4a9b-4e9c-890d-52e271c087ef, 'Délicieux! On a du mal à ne pas finir le mixeur en "testant", mais avec du rhum paille.', '2005-02-28T17:07:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 65eaada6-8adc-4aab-9750-9d7a30d60ee0, 'Je trouve qu''il faut augmenter la dose de rhum.', '2005-01-16T12:04:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 56a98636-ea48-4f6e-a910-08db83976a0f, 'Facile et très bon (surtout pour une soirée à thème mexicaine).', '2004-05-04T19:27:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, a729acdb-ce9e-440d-b69d-2256a6ba59a7, 'Excellent ! Un très gros succès auprès de mes invités. J''ai augmenté la proportion de rhum.', '2004-03-08T20:39:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 1ce71982-5d6b-4572-adec-c03d98422cc4, 'Délicieux, on se croirait en vacances...', '2003-10-18T16:52:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23077, 584a8c0d-062e-4df9-af18-5ac49aaba8ab, 'Il n''y a qu''un mot à dire: excellent! Même sans l''extrait de vanille.', '2003-07-08T18:00:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73383, 9b8fc206-fc72-4f1b-a2a6-0ecbbd0e10d1, 'J''adore cette recette. Je recommande.', '2011-03-31T19:31:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (321121, e8ec866d-6f5e-439d-8439-f6b4207e4457, 'Bonjour, dans votre recette vous parlez d''ajouter les œufs un à un. or, il n''y a pas d’œuf dans la liste d’ingrédients. Vous semblez les avoir oublié! Combien en faut-il s''il vous plait?', '2021-04-06T16:27:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39029, 96c18049-17d1-4635-8eff-79ceb144720e, 'Temps de cuisson beaucoup trop long. Je referai en sauteuse 20 minutes , en retournant à mi cuisson et avec couvercle. Sinon le mélange des saveurs est harmonieux', '2023-05-02T15:11:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39029, 63d10fb0-9565-411d-ab8f-4b58280d012d, 'Merci pour cette recette, je me suis régalée! J''ai suivi tous les conseils (faire revenir les oignons avant, mélange du citron, poivre et paprika dans un bol pour y tremper les morceaux de filet mignon). Je me suis juste "battue" avec les tranches de lard qui n''étaient pas assez fines pour entourer les morceaux de filet mignon. J''ai donc remédié au problème en mettant un bout de lard au dessous et au dessus de chaque morceau. Ca fait le même effet! Le moelleux du filet mignon, le goût du lard, de la crème fraîche, de la banane et de la pêche en font un plat succulent! J''ai adoré. ', '2006-11-24T13:25:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39029, 465afd8f-18f5-44f8-b4e1-7172202ca1d9, 'Excellent. J''ai suivi la recette et les conseils des commentaires précédents : mélanger huile, poivre, paprika avant de tremper les tranches et faire revenir les oignons à la poêle pour les rendre plus fondants. Facile à faire, original et très bon.', '2006-03-11T08:59:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39029, 4b66525e-e446-4494-822c-fddd790d71b8, 'Alors là, vraiment très bon et pas très difficile à réaliser. J''ai suivi les conseils, donnés dans un des commentaires : j''ai précuit les oignons à l''huile d''olive, pendant que je préparais la viande. Pour faciliter, la prochaine fois, je mélangerai le jus de citron, le poivre, le sel et le paprika dans un plat, et j''y mélangerai la viande avant de l''entourer des tranches de lard fumé. Comme toujours, j''ai testé cette recette avec des invités, et tout le monde a aimé, même les enfants. Pour les pêches, j''ai utilisé celles du jardin que nous avions congelées.', '2006-01-08T22:21:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39029, 058c6d9a-ade0-435f-b087-9573f3f594c7, 'Excellent...Même si je mettrais la crème plus tard lors de la cuisson. Mais sinon, avec une compagnie agréable et un bon vin, c''était super. Merci...', '2005-11-23T13:07:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39029, 15b0a7b5-0a5a-4284-a2d3-896a7ce9191c, 'Très bon et original! La quantité indiquée est plutôt pour 6 mais on a tout mangé à 4 quand même !... les oignons n''étaient pas assez fondants, la prochaine fois, je les ferai précuire avant dans un poêle avant de les mettre dans le fond du plat (et j''en mettrai un peu moins). Bref, très bon, à refaire !!!', '2005-11-01T11:33:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, 7aa4632f-9d6b-452d-8b2b-51ac2e7e1a2c, 'J''ai ajouté une cuillère à soupe de miel et le jus d''une orange. Très bon !', '2022-11-14T16:15:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, a7e65e5f-10b5-4b93-a6f0-aeac41d82f8e, 'Très bon. J’y ai rajouté un peu de boisson végétale pour le rendre moins épais ', '2022-05-29T12:21:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, 827e2ad9-62fa-40fc-a27f-449b179191d3, 'Très bon ', '2022-04-21T21:30:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, e2daac4e-fb5a-48ba-98a1-f797e90452b1, 'J''ai rajouté un peu de sucre et j''ai mis 4 kiwis pour 2 bananes', '2021-07-09T21:12:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, 4aeaf0d2-94a4-48ba-a56b-509b9755bf79, 'Moi j''ai mis 2 bananes 2 kiwi 25cl de jus d''orange pressé et 5 glaçons le top. ', '2020-06-02T19:07:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, fd281dbf-3067-45eb-80fd-44c885a4c2ef, 'Ajoutez du lait ou de l''eau pour l''acidité et l''onctuosité. 
Pour ceux qui aiment, ajoutez du gingembre également (coupé en fines lamelles) un régal ! ', '2018-03-30T06:33:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, 70fce44c-aa68-4af0-a9e6-f126c03d2267, 'Très bonne recette et un délice 😋', '2021-11-19T20:19:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (85812, de6f494f-9176-41df-b7e0-00cba23a8652, 'Smoothie parfait pour accompagner une brioche perdue.', '2019-01-13T17:57:10+01:00');
