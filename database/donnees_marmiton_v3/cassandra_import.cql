INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, ff4280ad-c375-47b4-b3a4-86c2f24ddf0b, 'sec,étouffant et écoeurant.  Pourtant j''ai suivi scrupuleusement la recette et me réjouissais de la faire. Ma tribu n''a pas apprécié non plus...', '2015-02-13T19:35:35+01:00');
