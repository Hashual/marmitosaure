INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 5857cedf-fffd-46fc-b8e8-c88112f71e41, 'J''ai ajouté 100ml de lait pour en faire des muffins aérés 😊', '2023-03-30T17:13:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, a5488433-a011-42f0-904a-98084de6cafb, 'Super facile et suculent', '2023-02-22T12:43:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 097fde08-d6d8-483f-9ffa-a819d4e31448, 'Super bon ', '2023-02-19T18:30:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, f9bbf65d-ca6b-48ed-b6c7-09ac5fd899d4, 'Excellent ! Inratable ! Servi tiède, c''est mortel ! 2 par semaine tant la famille me le réclame ! Pour 4 personnes, je mets 100 g de sucre roux, pas de rhum.
Merci beaucoup, je partage !', '2022-06-03T17:29:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, b3ad2f1f-2609-46d7-9478-d4168a8ac812, 'J''ai suivi les conseils en mettant 150g de farine.
Ma fille qui n''aime ni les bananes ni les noisettes a adoré,  les autres convives aussi', '2021-10-16T12:09:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, d1b4e175-26e6-42fc-8a8f-d313d5bed851, 'Très bon en revanche j''ai réduit à 150gr de sucre et je l''ai trouvé un peu trop sucré, peut-être parce que j''avais rajouté 50gr de pépites de chocolat noir ;) j''essayerai avec 120gr de sucre la prochaine fois. J''ai rajouté aussi 1c.s de vainille liquide. 50gr de beurre suffise largement ;) recette retenue dans mon carnet, merci! ', '2021-10-02T14:56:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, fe9ae3cc-45d8-4094-987f-5d3484e3e607, 'TRES BON', '2021-02-27T10:26:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 32c66268-01c7-477e-b8f6-d39f72c050e9, 'Super simple et excellent. J''ai mis des noix à la place des noisettes.', '2020-12-30T09:33:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 2731e29a-6843-48de-8d13-6a6f639b8c3f, 'Génial !
Les enfants ont bien aimé. 

', '2020-11-03T20:42:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, a9916fcc-88fc-45ed-8b5f-b6aa34a6f8df, 'Excellent et moelleux. J’ai juste diminué le sucre à 150g et couvert d’une feuille d’alu après 25 minutes de cuisson pour que le gâteau ne brunisse pas trop', '2020-07-14T21:17:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, a11484d3-a895-43de-92c2-2099553e4389, 'Je rajoute des pépites de chocolat et met la moitié d''un sachet de levure un peu moins de sucre et beurre ??extra ?un regal', '2020-04-09T19:59:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, b7fc274b-5cf7-4db1-8c51-2e1c6d021b41, 'Excellent... succès assuré!', '2017-01-31T17:51:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 8843eca7-fa62-47f1-bfa4-e2a478101a89, 'Un très bon gâteau qui est devenu une référence. Toute la famille l''a adoré. Je mets moins de sucre , 100 g et un peu moins de beurre, 80 g.', '2016-11-11T19:27:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, c064b32c-898a-47eb-bd7d-4fd3c1d91726, 'Merci pour la recette. J''ai ajouté 2 poignées de pignons et j''ai mis le paquet de levure entier, pour le reste j''ai suivi la recette, le résultat est excellent, facile à faire, merci encore trop bon.', '2016-08-08T18:41:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 4065cd5a-c233-4ef2-9763-f9b18195424f, 'Un régal. J''ai fais la recette sans regarder pour une fois les commentaires (aller savoir pourquoi...) et du coup je l''ai suivi à la lettre mise à part que je n''ai pas mis les noisettes et le rhum car je n''en avais pas dans le placard. La prochaine fois je mettrais un peu moins de sucre, en tout cas très bon goût de banane. La cuisson impeccable. Recette que je garde car à refaire...', '2016-04-22T21:31:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 4157e63e-7957-4e0c-916e-8e24205960d9, 'Très bonne recette. Ajout de pépites de chocolat, un vrai succès. 150 g de sucre comme conseillé en commentaire largement suffisant !!! Tellement un succès qu''on m''a demandé de le refaire 2 jours après. ', '2016-04-15T10:09:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, eaf60a9e-ff0a-4eb5-add4-1ed8631fcd04, 'Très bonne recette que j''ai faite plusieurs fois mais comme j''aime l''onctuosité par dessus tout, n''hésitez surtout pas à rajouter un petit peu de lait dans la pâte et un petit peu de crème fraiche lorsque vous écrasez les bananes. 150 g de sucre c''est amplement suffisant. Vraiment meilleur comme ça !', '2015-01-05T18:56:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 4d815c47-b4a1-43e6-8df1-ed746ddaaad2, 'Excellent !! Nous l''avons faite avec mon fils de 7 ans... Un délice, nous avons juste ajouté des pépites de chocolat et écouté les conseils des autres "cuisiniers" moins de beurre , moins de sucre ...  Merci pour cette recette. ', '2014-11-30T12:30:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 39d5b278-e768-4242-b050-f0d2fa491ca3, 'Délicieux !!! Je viens de le cuire, il me restait un peu de pâte, j en ai fait en format mini muffins, c''est vraiment bon. Prenez des bananes bien mûres, le gout sortira encore mieux. Pour ma part, je n''ai mis que 70 g de sucre et ça passe très bien. J''ai acheté des noisettes que j''ai mixées, c''est meilleur que la poudre de noisettes car on sent les morceaux. Merci à l''auteur de cette recette!', '2014-06-20T18:23:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 6d27965a-395e-4494-8e70-6be45c27e0a7, 'Je rajoute 1 demi yaourt nature ou à la vanille pour alléger la pâte . Je le sers avec du chocolat fondu. Un délice !', '2014-05-29T17:08:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, f8e836cd-844d-4d29-a4ac-c82599737f21, 'Excellent ! J''ai suivi les recommandations de mycha25 et n''ai mis que 100 g de sucre et 50 g de beurre. J''ai remplacé les noisettes par 30 g de chocolat pâtissier  que j''ai concassé à la moulinette pour en faire des pépites très fines. Un vrai délice. J''adopte la recette !!!!! Super simple et très réussie', '2014-03-17T19:32:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, a2d595e6-08db-43e8-9173-051e488d2b0f, 'Super recette ! Je ne mets que 50g de beurre et la moitié de sucre, mais vraiment excellent surtout quand je le mange froid c''est vraiment à tomber. ', '2013-11-04T21:54:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 4f2d7dda-65ab-4c90-aba4-e20bae54303c, 'Recette très gourmande la banane se mêle bien au goût des noisettes. j''ai suivi les conseils des marmitonautes : 100 g de sucre et 50 g de beurre : un vrai régal pour le thé ou le main au petit déjeuner. Encore une recette qui va devenir culte dans notre famille. Merci !', '2013-06-27T09:47:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, d97a8f8e-1de6-4d31-8fc9-4e4f1c4ebf19, 'On ne peut plus simple ! J''ai suivi les conseils en ne mettant que 100g de sucre, 50g de beurre et j''ai aussi ajouté des pépites de chocolat ... Hé bien même mon fils qui n''est pas fan de banane a adoré et m''a demandé d''en refaire ! Merci beaucoup pour la recette et les bons conseils des marmitonautes ! ', '2013-05-12T13:51:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 1a369d02-0c80-41ac-8818-0d251545d49a, 'Excellent, j''ai ajouté des pépites de chocolat, moi j''ai aimé. Il peut se faire aussi avec une farine sans gluten.', '2013-04-18T03:06:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, f68c6396-69ac-4e61-a636-f4c2fe9960de, 'Super recette. Très simple à réaliser.', '2013-02-03T16:07:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 83023116-f1a4-45b9-850c-f6932f0b16dd, 'Très simple, et surtout : Excellent !', '2012-09-24T23:13:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 3b6b6fd6-91a2-4591-9078-207efecebd18, 'Très bon ! Fait avec seulement 100 g de sucre et 50 g de beurre, comme suggéré dans les commentaires précédents. Par contre, j''ai remplacé la noisette par des pépites de chocolat et je l''ai regretté... La prochaine fois, je le ferai avec les noisettes concassées !', '2012-07-25T09:48:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 4b93cde3-d374-490c-b090-a8e675062b89, 'Très bon et je n''ai mis que 100g de sucre et 50g de beurre avec des pépites de chocolat.... A refaire souvent....', '2012-06-09T23:36:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 9eee5eaa-2e49-4bc9-810c-0682b93ff5dc, 'Très bon ! Idem 100 g de sucre seulement et 50 g de sucre mais j''ai ajouté un peu de lait et de la fleur d''oranger et des pépites de chocolat : une tuerie ! ', '2012-05-13T00:15:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, d2cee4fa-c064-4875-a224-ec4c906be5f6, 'Très bon et super simple ! J''ai juste ajouté un sachet de sucre vanillé et j''ai remplacé les noisettes par des pépites de chocolat.', '2012-04-22T20:26:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 1b2d7468-9c91-4b2d-a1b0-3d6bb8a5421b, 'Excellent, j''ai mis la moitié de la quantité de beurre, idem en sucre, ajouté 1 œuf et de l''extrait de vanille. Tout le monde en redemande. Merci pour cette recette. ', '2012-03-29T14:42:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 340c9cc5-adee-49b7-95e7-46bccc42f313, 'Excellent ! Il n''en reste pas une miette. J''ai suivi certains commentaires, j''ai mis seulement 100 g de sucre et j''ai remplacé les noisettes par des pépites de chocolat. A refaire rapidement.', '2012-02-14T10:55:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 15228c68-63a0-490a-af7f-6be75929d358, 'Combine simplicité et délice! Pour ma part, 150g de sucre suffisent et ajout de pépites de chocolat. Merci pour cette recette.', '2012-02-10T22:24:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, f9b14ccc-e947-4599-b644-2865adad17f4, 'excellent avec 100g de cassonade, des pépites de chocolat et dans des moules à muffins!!!', '2012-02-09T21:55:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 57e0efdd-fc55-4a0c-a995-5e1eabf54bee, 'Un régal.', '2012-01-24T10:51:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 4a547c9c-b4da-4305-bf9b-7d4ed1f5bc13, 'Parfait, je ne pensais avoir autant de succès avec un cake à la banane ! Je n''ai pas mis de noisette (allergie) en tous cas merci !', '2011-12-03T09:27:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 8f87c941-fbd3-41e4-bc07-710192be4a1d, 'Très bonne recette. Je n''avais pas de poudre de noisettes, j''ai mis des pépites de chocolat. Le résultat est très bien et pas du tout sec (même le lendemain).', '2011-10-28T10:02:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 8abb1f26-8854-4049-9610-eaab4a5a46d2, 'Parfait!! avec 100 grammes de sucre seulement... ', '2011-10-14T19:56:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, e4daefc5-89e2-4c8b-aecb-6ff45be6183d, 'J''ai moi aussi mis seulement 100g de sucre, et j''ai ajouté du chocolat dans le cake, façon marbré. J''ai ajouté aussi des noix de pécan sur le cake : un régal ! Merci pour la recette !!!', '2011-09-01T22:33:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, d2d70b30-f2c4-4f39-9872-781863386f74, 'Merci je l''ai fait hier soir et bien mon mari et moi nous nous sommes régalé. Gâteau moelleux et un bon goût de bananes. Moi j''ai mis moins de sucre, moins de beurre et j''ai mixer les bananes. Je vais faire profiter à mes amis ici à l''ile de la Réunion de cette recette.', '2011-08-11T13:48:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 8860dd42-711a-482d-9869-949979e64ca0, 'Cake à la banane excellent !!! Mon copain a adoré. C''est un cake moelleux et parfumé. On sent bien le goût de la banane. Je n''ai mis que 150 g de sucre. Recette excellente pour utiliser les bananes devenues noires restées au fond du réfrigérateur.', '2011-06-19T11:30:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, f5713360-5eb3-43aa-9239-e3e6b1d2c0c0, 'Très bon, bien moelleux, et parfumé. Très facile à faire, j''ai juste un peu aidé mon fils de 4 ans. J''ai ajouté des raisins secs et mis moitié moins de sucre.', '2011-02-06T21:25:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, ca4a7683-5c92-4b1c-b2dc-4670527aa84f, 'J''ai suivi les commentaires précédents j''ai mixé les bananes, le moule à cake étant pris pour un autre dessert j''en en ai fait 30 mini muffins (cuisson 15minutes à 180°C), encore meilleurs le lendemain trempouillés dans le café du matin ! Merci !', '2011-02-06T15:12:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, b578cc8d-d3e1-43a9-be4a-4db6ec13f2aa, 'J''ai trouvé cette recette très bien. Elle est simple comme tout, et on sent très bien la banane. Moi j''ai mis de la poudre d''amande à la place de la poudre de noisettes et je n''ai mis que 80 g de sucre et c''était très bon.', '2011-02-05T21:41:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, afb2d825-cbd0-41d5-ac0b-5b52e9a20131, 'Je n''ai pas trouve ça vraiment bon. Le cake est trop sec et n''a pas beaucoup de goût.', '2010-07-23T19:46:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 8b69be14-faea-41ef-97e3-5f847938ae5b, 'Un vrai délice, j''ai même ajouté deux kiwis que j''ai mixés... Mon fiston de deux ans a adoré et même ses parents ! Merci !', '2010-06-20T16:56:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 8c542d91-f970-44d0-82f8-319ab7ce10e2, 'En m''inspirant des autres commentaires, j''ai remplacé le sucre par 125 g de miel et 2 sachets de sucre vanillé. Je n''ai pas non plus mis de noisette. Résultat, un cake très parfumé et pas trop sucré.', '2010-04-05T11:03:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, b9162dc3-c588-4f44-ba09-fafdfebf1719, 'pas mal mais un peu pâteux. La prochaine fois je monterai mes blancs en neige. Je n''ai mis que 150 g de sucre semoule. A réessayer!!!!', '2010-02-23T18:41:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 0c1c3c63-f7f2-47cd-88c5-dc4cf8fa915f, 'Très bon! je n''ai mis que 2 bananes, 100 g de sucre et un sachet de sucre vanillé : largement suffisant. Attention, 50 minutes de cuisson n''ont pas été suffisantes dans mon cas !', '2010-01-31T12:04:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, d673f4ba-b2ad-4205-be6a-af49257134fb, 'Tout simplement super... Facile à faire avec les enfants et très bon... Merci pour cette recette inratable !', '2010-01-23T12:17:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 7b7e334e-3900-435c-9b3b-e64d90688cc9, 'Mega Super bon. J''ai remplacé les noisettes par de la poudre d''amandes. Et j''ai mis 150 g de cassonade. J''ai fait cuire 45 minutes à 180°, il était super moelleux. ', '2009-12-19T20:21:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 4582214d-51d5-4441-b0e4-0eb67de572f5, 'Excellent, très simple et très rapide à faire. Pour ma part, je n''ai mis que 100 g de sucre, ce qui est amplement suffisant, et pas de noisettes. A refaire.', '2009-07-03T13:04:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, e6c0f90a-d03a-4aa8-9957-f7a3b066fd70, 'C''est une amie qui me l''a fait découvrir, et je ne m''en lasse pas! Excellent...', '2009-01-06T12:45:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, b932f22b-2dbf-42d9-b242-5ccc08ccc786, 'Cake très goûteux. 100 g de sucre suffisent largement pour nous.', '2008-12-08T21:06:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64112, 4bf5a615-6328-4af2-8859-008e4f74a10d, 'Super bonne recette à refaire, très bon goût avec la noisette !', '2008-11-09T19:03:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, aa94958e-d057-46bc-887b-9829b9ce0d7b, 'Super sympa. Surtout avec des restes de fruits. J''ai ajouté aussi des cerises ', '2016-06-19T14:47:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 11f5ad99-735b-4786-9d5b-3dcdfb0bf7af, 'Rapide et facile à faire. Génial j''ai beaucoup aimé ! A refaire !', '2013-11-25T00:29:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 02fdaf3a-c419-4ffe-bd6b-737e6b5276c6, 'Très bon, fait avec de la chantilly maison miam !', '2012-08-02T20:38:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, c010feed-e149-4923-a639-56f6608dcf4f, 'Super simple et super bon ! Mes invités ont vraiment apprécié. Merci pour cette recette.', '2012-05-20T20:46:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 76f6fe40-6a69-4972-8e21-1ea04d7b29f6, 'Rapide à faire et sympa ! ', '2011-08-27T23:50:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 6b198232-c7e9-4338-80b7-17b9804e6c8d, 'Ravie ! Un dessert rapide frais et léger comme je les aime. Merci beaucoup.', '2011-08-15T15:22:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 5b145448-f7dd-4838-a37c-c835bbda4ada, 'Très bon, très frais, on ne peut plus facile !!! J''adore.', '2011-04-24T20:28:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 83cdcd8a-a417-4cf5-8d15-cd3b3b1e45e2, 'Un délice, un dessert très frais. Les invités ont adoré.', '2010-04-26T17:56:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 242fe5e3-b2f2-4059-b309-0254d3feaaab, 'Facile à réaliser, une jolie présentation, et exquis !', '2009-08-22T10:52:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 6cfe2a6d-2702-4257-a505-afbe2750a53e, 'Recette rapide et excellente. Merci pour la recette.', '2009-07-13T13:22:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 985af334-a418-4af1-ae61-923b6616361e, 'Super bon !!! A la place de la crème fraîche, j''ai mis un mélange mascarpone-œuf-sucre (comme pour un tiramisu). Au dessus, j''ai décoré avec des petits morceaux de kiwis et des amandes grillées. Un vrai délice !!!', '2009-05-29T12:40:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 8ca251e7-049a-4357-9a49-9d4f571679bb, 'Très bon et hyper fastoche !', '2009-04-26T20:38:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, db7d1619-1047-403c-974d-69a08ec3bdc2, 'Super simple, rapide et surtout super bon! Merci pour cette recette!', '2008-06-09T12:59:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, a562c0eb-41fd-4bf3-af0d-e60e9fc87e0b, 'Bonne recette. Pour 8, j''ai mis 4 bananes et 1 kg de fraise. Les spéculoos, je les ai émiétté dans le robot. J''ai suivi les conseils et ajouté du sucre vanillé aux fraises. Sandrine ', '2008-06-08T14:05:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, e734b607-8043-4cb2-9b6d-44b6b5ad658b, 'C''est excellent ! Mes 3 enfants ont adoré. J''ai rajouté un peu de sucre en poudre entre les bananes et les fraises et pour finir la déco, j''ai mis une petite fraise sur la chantilly et un spéculoos sur le côté dans la chantilly. Recette à refaire absolument !!!!!', '2008-05-20T23:27:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 4b87c928-a1c3-4d3d-9218-f61841ea947b, 'Très bon ! J''ai ajouté un peu de sucre vanillé aux fraises sinon c''est un peu sec. Avec des cigarettes russes en déco sur la chantilly, cela fait son effet c''est très simple à réaliser.', '2008-05-02T16:11:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 38ef2913-99e5-4aa9-b09e-134ca204b749, 'Excellent!', '2008-01-17T15:26:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (57195, 3691ed5a-880a-4ca0-bb0a-eb0b677cbcf9, 'Je ne met que quatre, sur trois enfants, deux ont beaucoup aimé! Merci pour cette recette très simple à réaliser. ', '2007-07-10T22:59:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24372, ac806be5-38f7-45fb-a880-7eeb2b176702, 'Mes invités n''ont pas du tout apprécié !! ', '2007-11-03T19:52:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (24372, c5f0d1ed-2195-4c7f-8196-df02b1effd7e, 'J''ai adoré, j''ai présenté les gratins dans des moules à crème brûlée (avec des oreilles), j''ai saupoudré un des gratins avec le gruyère et l''autre avec de la chapelure... J''ai préféré la recette avec le gruyère ; mon mari celle à la chapelure... à vous d''essayer !!!! Ce gratin m''a permis d''accompagner un poulet-coco. C''est délicieux et très original...', '2005-07-10T23:22:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315408, 59e70f08-db0d-43df-95a4-1715037c441f, 'Je trouve qu on sent trop le goût du lait de coco,  et pas assez les fruits, je modifierai les proportions la prochaine fois.', '2020-04-11T12:47:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315408, c2055ea5-54ab-4932-a05e-23b3e5bd9d69, 'Très bon j''ai juste remplacer le sirop par du miel !', '2018-01-11T10:50:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315408, 2bf270f7-f178-4a74-92a8-15b7b781f185, 'J''ai rajouté quelques feuilles de menthe et un peu de citron pour donner du pep''s. Je n''ai pas mis de fromage blanc.', '2017-08-27T19:39:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (315408, b2f41bf3-c35b-4f16-af7d-8123a267ddc3, 'Pour moi un peu plus d''ananas, sinon top ! ', '2016-01-10T10:17:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37616, ad989e8f-5cd8-48ab-952a-1cef27c26ddb, 'Très déçue par cette recette, mes amis et moi avons tous trouvé que la feuille de brick se mariait bien mieux pour des préparations salées, mais pas pour du sucré comme c''est le cas ici.', '2016-04-22T12:57:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37616, f1b8b6a8-1a18-4e29-b496-9a81b2032234, 'Hello !  Je n''avais sous la main que des feuilles de brick rondes donc j''ai plutôt fait des aumônières (voir photo proposée). Attention à doubler le fond car finalement, avec le jus des fruits, le fond cède sous le poids. J''ai mis comme fruit dedans: pommes poires et un peu de jus d''orange, sucre,  cannelle, un peu de malibu coco pour flamber. Le petit goût de coco est sympa. J''ai mis au fond de la feuille une cuillère à café de poudre d''amande et une cuillère à moka de vergeoise brune. J''ai doré en milieu de cuisson les feuilles de brick avec le jus dégorgé des fruits en précuisson, et du beurre. J''ai présenté sur une assiette par personne, avec une boule de glace crème brûlée éclats caramel et des tranches d''orange (coupées comme pour un carpaccio). Effet 100% garanti.  Bon, un peu long à préparer tout de même.', '2012-10-21T20:01:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37616, 5641f3cc-1307-456a-a49c-81b2ea9ec1aa, 'Délicieux! Je n''ai pas mis de mandarine, mais j''ai doublé le kiwi. Tout le monde s''est régalé!', '2008-03-27T10:46:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37616, dd5028e0-42e1-43c3-8f7a-6abca6927262, 'Très très bon , de mon coté je les fais revenir à la poele dans du beurre et flamber  au rhum! Quel régal!', '2007-08-01T22:48:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37616, 251a04ca-61af-4c59-b301-2df056d8315e, 'Léger, original et très bon mais il vaut mieux éviter de mettre des mandarines parce qu''en cuisant, ça devient amer.', '2006-03-18T14:14:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528314, 156fd61a-6cd7-44e2-9580-8b07ce7aae7c, 'Excellent, une bonne base que j''ai customisée à ma façon: 2 bananes au lieu d''1, 90g de farine T80, pas de compote de pommes mais un peu de lait pour fluidifier si besoin, 1 oeuf, 25g de chocolat noir concassé. Pas trop sucré, un bon dessert, cela fait environ 4 bonnes parts', '2021-01-13T15:00:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528314, 183c5b65-d82b-4e8e-b824-dfabfcd77e02, 'Super recette, tout le monde a adoré. Gâteaux moelleux à souhait et en plus sans gras 💃', '2022-10-10T06:52:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528314, 82968d2f-baed-416d-90da-9408db32f61d, 'Excellent, pas sec comme d’autres recettes. J’ai suivi les commentaires en mettant moins de chocolat. A refaire sans hésiter ', '2021-01-14T08:56:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528314, 4d5f230e-fc0a-4d68-a32a-da037728f6a6, 'Super bon ! Je n''avais pas de graines de chia et j''ai cuit plus longtemps mais le goût est top !', '2022-10-03T21:11:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528314, 13ffba5c-c4fd-46c5-9bd4-929be87a227f, 'Personnellement, je l''ai trouvé très bon même si mes parents n''ont pas trop aimé, j''ai mis un peu plus de banane et j''ai enlevé le chocolat (peut-être que si je ne l''avais pas fait ils auraient préféré)', '2022-06-06T11:01:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528314, 65dd8dd7-86a8-48cc-8261-6d7b4cf97616, 'J’ai réalisé ce gâteau sans sirop et en mettant des morceaux de chocolats noirs pâtissier à la place des pépites de chocolat. J’ai aussi mis des morceaux d’amande à la place des graines et le gâteau est très bon je recommande ;) ', '2022-03-31T11:00:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528314, 0c78d8ac-b0c6-4473-8a2a-0498d04affb2, 'Super bon, parfait pour le petit déjeuner ! A refaire sans hésiter ', '2021-03-06T09:01:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528314, f8315f9f-28ae-4b39-bedf-de287741a617, 'Correct, j''ai ajouté une demi banane, 2 cas cacao et fait cuire 30min.', '2020-11-27T18:24:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528314, 2e604a9e-bbc9-4915-8f5b-ca5ecf9c7801, 'J''ai beaucoup aimé, surtout que je ne suis pas fan des goutées " healthy" d''habitude.', '2020-11-09T18:02:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528314, 8f608b95-67be-412e-bd42-c18b13aceb75, 'Super bon ! Par contre le chocolat est beaucoup trop présent à mon gout ', '2020-10-18T22:47:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528314, 8098cd2a-b630-42e1-9870-a93b57790ab3, 'Excellent je recommande à 100% ! ', '2020-09-03T14:30:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40119, ecad1cb4-892b-4941-b454-2d9295bc3f4f, 'La glace est bonne, on sent bien la banane et les fruits de la passion, mais aussi un peu trop la crème ! J''ai ajouté du sucre car sinon elle était trop acide, mais cela dépend sans doute des fruits. ', '2010-11-18T09:46:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40119, 998f1895-f500-47b1-8e2f-58fc553dd7a3, 'Un délice !! c''est d''une simplicité enfantine pour un résultat incomparable ( et j''ai l''habitude de faire moi-même toutes mes glaces !) ; cette recette fait désormais partie de mes favorites!', '2010-02-20T12:18:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40119, 2bc9a7d5-a589-4c28-84b9-5f1c2f9688e3, 'Les enfants ont adoré, je n''ai utilisé qu''une creme allegée.', '2009-04-01T13:02:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40119, 60a67d22-1731-49fd-b90f-d53466b36077, 'C''est la première fois que je faisais une glace et grâce à cette recette c''est une réussite! J''ai remplacé une partie des fruits de la passion par un jus passion/mangue et le citron par du citron vert. La glace est légère, la texture agréable et la couleur pas du tout "chimique". La partie la plus longue est finalement d''obtenir le jus des fruits de la passion... ', '2006-08-24T15:12:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40119, 57bf0b36-1888-44ce-b972-91d319f98123, 'Etant un fan de glace, je me suis empressé d’essayer cette recette. Le résultat était parfait, aussi bien l’apparence que le goût. J’ai juste remplacé les fruits de la passion par de la pulpe car c’est moins cher et plus facile à trouver.', '2005-11-05T19:37:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90711, 89f6d798-1077-4b3e-879c-4807cd05182d, 'Super.', '2020-02-23T13:53:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90711, 28ad875c-ec20-40f9-b259-937132e69331, 'Un gâteau simple et rapide à faire, qui ravira les petits et les grands.', '2014-09-03T20:11:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90711, 18885c7c-b4fa-47bb-9539-e640e78ac97e, 'Je viens de faire la recette.  J''ai goûté la pâte avant de la mettre au four : elle était délicieuse !! Et j''adore le mélange banane/chocolat. Je l''ai faite pour la famille et tout le monde a adoré. Vraiment bon merci ! ', '2014-05-19T10:14:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90711, 741539a8-8324-4b4b-8e1a-c2da58ff0b87, 'Bof, les enfants n''ont pas du tout aimé le mélange chocolat-banane. C''est dommage, car l''idée semblait intéressante.', '2014-02-13T08:52:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90711, f476fd25-8be7-4586-b73c-9975edeedefd, 'Bof ! Trop écœurant ! 2 bananes c''est trop ! Le gâteau est tout mietteux en plus ! Déçue !', '2014-01-22T18:02:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90711, 2aaf82fa-a1c0-41bc-8261-700f5ee7381b, 'Facile à faire et très moelleux !!!  ', '2013-11-30T14:45:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (90711, 52dc36b2-31ba-4eae-abe2-2f82da2a12c8, 'Très facile et rapide à faire. J''ai juste poêlé les banane avant dans du beurre pour la touche personnelle.', '2012-11-05T00:20:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12601, fa825530-168b-49ca-a5f4-4d0c40a60b51, 'Pas dur a faire et pas mauvais du tout..  Ah, un truc: au lieu de mettre de l''eau j ai essayé de mettre du lait de coco, ça rend pas mal non plus! :)', '2001-10-06T19:38:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12601, fb5b1f06-221f-42e4-b157-4dfa5b8910d6, 'Très bonne recette.  Faite avec 450gr de sucre.  La prochaine fois je prendrai du sucre gel pour une meilleur tenue. Recette a garder précieusement  !', '2018-10-18T07:28:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12601, d9298c58-6771-4123-bca6-456938913a66, 'Superbe !!! Tous ceux qui ont essayés ont adoré. Je mets moins de sucre aussi. ', '2016-11-16T12:39:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12601, ac8aa336-a0a8-4441-81a4-56c09af3455c, 'J''adore ! J''ai mis moins de sucre comme dans toutes mes confitures. Ma femme n''aime pas ! Serait-ce une confiture d''homme (voir commentaire précédent)??!!', '2013-11-11T13:19:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12601, b527dc6b-2e80-42e6-8c8c-8d89976ba772, 'En fait, c''est une moyenne. Je n''ai pas du tout aimé, ni le goût, ni la consistance de cette confiture. Par contre, mon mari la mange à la petite cuillère et adore ça! Mieux que la fameuse pâte chocolat noisette paraît-il... Question de goût!', '2006-04-05T17:38:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12601, afb4c7b2-3d15-4a1c-b83b-3220a368d2a8, 'Cette confiture est facile et originale - mais seulement 4/5, car trop de chocolat, on ne sent pas assez le parfum de la banane. ', '2006-02-07T19:22:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12601, 01ae52ef-5cab-4305-9e15-e2c781633e47, 'Un peu trop sucré à mon goût... j''ai aussi ajouté des pêches et un peu de melon.', '2005-07-12T14:15:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12601, b1048429-a09d-4bd9-bc48-2234fe8e7a9e, 'Très bon et terriblement facile à faire. Ne pas s''inquiéter, la préparation reste très liquide jusqu''à la mise en pot. J''ai fait moitié dose et réduit les doses de sucre. Pourtant, je trouve le goût du chocolat pas assez prononcé...', '2005-07-09T15:54:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12601, 2beff9e5-cacc-4a37-9669-bafbc466e151, 'Banane+chocolat= vrai régal... le mariage est réussi:-)', '2005-04-08T21:23:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12601, 12d77ef3-d7d2-401e-9493-c2c97dba9cdb, 'Un goût un peu trop fort en chocolat, mais un arrière-goût de banane délicieux.', '2002-12-10T20:44:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224698, a7a068ae-82c2-44ba-9117-fa2ec52aaea4, 'Ma fille dit : c''est trop bon !', '2018-12-20T20:25:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224698, 08c07d2a-6897-4955-a3c4-24fdc4e27dda, 'Bon simple mais rien d''exceptionnel', '2016-01-25T17:45:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224698, e1c2fe11-3bfc-4cbd-a4e5-1e0294d80c63, 'Très simple et très bon !', '2014-02-16T14:08:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224698, 969e566b-de47-4169-acf7-c46e56ce9f8c, 'Trop bon !', '2013-02-28T13:58:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 6d74e3be-bec4-4ada-8c48-38bf4be32568, 'J''ai adoré!J''ai juste supprimé la frangipane et ai mis de l agar agar pour etre sure que la crème tienne ...Délicieux 5 étoiles sans ésiter', '2023-10-31T13:24:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, b593a6b6-6ae4-40ff-93f2-ac166d358487, 'Très bon, c’est parfait ! Tout le monde a beaucoup apprécié ! Nous avons mis des fraises et dés kiwi : le mariage était parfait !', '2023-05-07T12:06:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, cd5524ed-cb13-40a2-8cc1-804c2d875104, 'Excellent  je n''ai  pas fais de crème patissiere', '2023-04-28T08:22:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, a56eb33a-4896-45ea-8ab6-2af64abe6ffd, 'Excellente !!! 
La crème d''amande est parfaite, la crème pâtissière aussi. 
Le mariage de tout est juste parfait tout le monde a adoré.
Les quantités sont parfaites.', '2022-08-21T21:25:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, a7c1ef07-5ca8-4478-9c75-28315acd3e83, 'Au top, légère et rafraîchissante ', '2022-05-06T15:48:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 6a9fe806-10c6-4c0b-98d7-4d0cbfeda9b4, 'Excellente tarte aux fruits!
Je la fais depuis plusieurs années maintenant, avec la pâte fait maison et des fruits de saison, tout le monde se régale et me la redemande.
Ce gout de frangipane apporte un vrai plus!
Il n''en reste jamais une miette, merci pour la recette!', '2020-06-20T09:41:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 2c1f2215-9222-443a-92e9-1c648621c4cb, 'Excellente recette. 
J ''ai aussi remplacé l''amande par la noisette. 
Une belle réussite gustative. 
Pour le goût et le visuel des fruits de saison. 
', '2020-06-08T17:25:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, af774a55-77c7-4f7b-a2c4-50cd97d3225b, 'Tarte réalisée pour un repas d''été en famille ce midi. Tout le monde s''est régalé !
Tarte très agréable à faire qui saura épater chacun des convives et rendre fière la cuisinière !!! A refaire', '2019-06-29T09:12:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, dfd4470e-30d6-4025-97fe-d67355f67282, 'Très bonne recette. Moi j''ai mis moitié d''amande et moitié de noisette pour faire la frangipane et c''était très bon. Une recette facile et rapide et qui fait son impression ! Prévoir un grand plat car les quantités indiquées permettent de remplir plus qu''un plat à tarte classique mais moi j''en ai profité pour faire des mini tartelettes à côté. En fruit j''ai d''abord mis des fraises partout coupées en 2 puis j''ai dispersé des tranches d''abricot et des cerises on peut vraiment adapter à son goût !', '2018-06-28T11:06:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 2b6454e9-3245-4a8e-9d50-9008bd0fc790, 'Super recette qui régale tout le monde à chaque fois ! ', '2016-08-29T13:06:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 20aeee44-6ee0-4384-b453-41ed48164485, 'Superbe recette ! La tarte est délicieuse et présente très bien. A refaire absolument ( ma photo est la 21). J''ai remplacé les nectarines par des mangues. ', '2016-08-21T20:41:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, c2026619-2340-4ace-905d-c61f7cf30ee2, 'Top! On adore! Mon chéri n''aime pas l''amande alors j''ai remplacé par de la poudre noisettes (broyées et décortiquées maison) et c''est top car la noisette donne un goût moins écoeurant que l''amande... Et c''est une bonne variante.', '2016-07-03T15:12:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 6862d2ae-66ba-4a15-82f0-bda3d07cc737, 'Très bonne tarte, vite faite, bonne tenue et beau visuel à la découpe, faite avec une pâte sablée maison, 2 cuillères à café d''extrait de vanille à la place de la gousse et un gros bocal de fruits au sirop (ce qui permet de la faire à l''avance) et c''était parfait', '2016-05-18T20:52:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 2967c7db-58d4-4341-9094-a0077b1641de, 'Essayé ce soir!! Trop bonne! Mes invités se sont régalés comme jamais! Pas trop de sucre, je n''ai pas utilisé la frangipane et c''était très bien. Merci pour la recette.', '2016-03-14T23:42:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 778d7c2c-bdd6-42c2-b5f9-239bd6afbfae, 'Trop bien cette recette moi qui suis une novice en matière de pâtisserie je l''ai réussie et ma famille s''est régalée. On m''a même demandé où je l''avais acheté... Vraiment excellent la recette... ', '2015-07-15T20:48:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, ad4a4f73-03a8-4c8f-a9af-55b5f483e9e8, 'Super bonne !! Merci ! ', '2014-10-10T12:26:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 7a85211f-7c07-4e27-abb4-299ee09e6122, 'Hum excellent ! ', '2014-10-01T19:56:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, f6eeb5fa-0d82-434f-8eb6-6bd1e925d2e9, 'Très bonne recette. Je l''ai faite hier pour la première fois et ça a été un grand succès! Pour ma part je n''avais pas assez d''amandes en poudre alors j''ai complété avec de la noix de coco en poudre : délicieux également.', '2014-06-15T12:52:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 0cf0bf05-f1ee-40bf-a510-335a60d3eb7d, 'Juste excellent', '2014-04-21T21:51:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, deec9a61-60aa-4fc8-8a9e-9b7a6a3a2bc0, 'Recette parfaite bien détaillée à décliner à toutes les saisons !! ', '2014-02-10T00:44:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 3f6f6c12-24d2-48fc-beec-d6a9f2739f9f, 'Super recette', '2013-10-25T14:43:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 064ac0bf-9758-4e0c-ab65-5d75a1a07905, 'Un régal, un délice !!! J''ai suivi la recette à la lettre. On était 5 personnes, et même après un bon barbecue, on a réussi l''exploit de le terminer ! Aucune hésitation à avoir, d''ailleurs je recommence ce week-end ... miaaam !', '2013-08-15T19:18:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, db84cd83-00f6-42f0-beca-4270856d040e, 'Il n''est rien marqué en rapport avec la cuisson si ce n''est "préchauffez le four à 200°". Pas pratique du tout. Mais quand même très bon.', '2013-05-08T16:42:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 09effeb7-67e9-4aa4-993f-e12ea1915cbd, 'Délicieuse tarte, recette suivie à la lettre (variation pour les fruits de saison). J''ai juste badigeonné les fruits pour donner un coté "vernis" comme chez le patissier (avec de la gelée de coings chauffée à la casserole). Bonne dégustation', '2012-08-15T09:38:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, f9229df2-b202-4b93-bd85-1a8e3f5344fc, 'Délicieuse !!!! Digne des tartes en pâtisserie !! Merci pour cette recette !!', '2012-07-19T20:07:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 2684b711-0eb2-4fc0-bee7-ff95e8bfa95e, 'Recette facile pour un résultat parfait ! Ma tarte était non seulement très jolie, mais excellente. Les invités ont adoré !', '2012-07-11T11:23:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 786f2b4e-417b-437c-a852-69eff25cee15, '"Une tuerie" : commentaire de mon fils la bouche pleine !! Simple, goûteuse, très colorée avec ces fruits coupés en cubes... Très bonne recette !! ', '2012-06-04T00:55:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 439def21-539a-4740-a92e-b8104f4079b5, 'Super, je viens de la faire avec des pommes, des kiwis et des fraises et tout le monde a adoré !! Je viens d''ailleurs d''ajouter ma photo à la recette. Seul petit bémol : je n''ai pas trop senti le goût de la frangipane, je modifierai peut-être les proportions la prochaine fois. Merci en tout cas pour cette très bonne recette !', '2012-03-10T21:01:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, fe4ea640-10ed-4581-a046-3a30fc9cde12, 'Super recette ! Je l''ai faite avec des nectarines, kiwis, fraises et abricots. Un vrai délice frais ! J''ai ajouté un nappage pour tarte pour parfaire la présentation !', '2011-07-06T15:07:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, a2e2f0a3-0c93-4cdd-8050-fe86df35e1b8, 'Un délice !!! ', '2010-07-17T01:45:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, d32caf50-a408-4b5d-be90-42cd15b12a47, 'Très bonne recette, la crème d''amande ajoute un goût très sympa. Dessus j''ai mis quelques abricots en cubes, 1 pêche blanche, 1 kiwi, 1 banane, et enfin des framboises au centre. Résultat : très beau et très bon, apprécié par tout le monde.', '2010-06-25T01:29:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, f3ac24d8-5533-45cf-b8f2-310adfc46068, 'Un vrai délice !! J''adore. La frangipane donne un réel plus à la tarte !! Bravo ! Et très facile en plus !', '2010-06-13T00:16:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, d4d87b51-4929-44ee-a4d3-3ff425c16456, 'Bravo ! Je suis débutante, mais ce fut un plaisir à réaliser. ', '2010-05-29T21:34:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (59373, 54ff35f9-6943-4a44-82db-da846ca9b4a4, 'Un grand merci pour la recette de la frangipane et de la crème pâtissière! Le résultat est parfait! Et le mélange, frangipane, crème et fruits frais est un régal pour nos palais! Merci !', '2007-11-11T14:11:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23868, 8147a609-5b21-4edb-af9f-be4314e1bfb6, 'En suivant le commentaire, j''ai trempé mes tranches dans du jus de citron pour qu''elles ne noircissent pas. En revanche pour le séchage j''ai dû les laisser beaucoup plus longtemps au four, peut-être que la température était trop basse. 
J''ai utilisé ces bananes séchées dans des cookies aux pépites de chocolats, c''était excellent.', '2018-05-03T13:34:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23868, 50927d92-8d90-40dc-afee-a1ff797ed44f, 'Les bananes ont malheureusement noirci et sont devenues toutes molles... il manque des étapes ', '2020-12-27T01:04:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23868, 4545f716-0a9c-45c2-8714-e026e1b547ab, 'Les bananes n''ont pas séché après plus de 2h et sont noires.', '2020-12-03T19:36:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23868, d39d6da1-cb75-4eff-9dec-7ab258c6a387, 'Je viens de tester et c''était horrible. Elles ont noirci et rendu beaucoup de jus/sucre. Juste bonnes à jeter. Ni séchées ni bonnes à manger.', '2019-11-30T23:26:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23868, a04c5e59-a49c-4f1e-85ef-9ab3f5c90ff7, 'J''aurai aimé mettre une bonne note mais je n''ai pas trouvé cela fabuleux, je referai un essai en trempant préalablement les bananes dans un sirop au citron.  Citron pour éviter qu''elles noircissent de trop et sucre parce que c''était un peu fade de goût. ', '2007-06-09T18:43:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335108, 90bdbc70-3b3d-417f-8019-c687475cf610, 'Ah nous sommes d''accord ! moi aussi je l''ai testé et le résultat ressemblait plutôt à un espèce de flan. Je pense que c''est le manque de levure oui. ', '2015-12-17T01:04:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335108, f9c79940-8df8-4619-b2fd-b5cad21090a1, 'Je l''ai testé mais cela ressemble plus à un flan ou une crêpe épaisse qu''à un gâteau. la préparation ne monte pas à la cuisson, pas assez de farine ou manque de la levure ? ', '2015-11-28T14:56:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223335, d2f04f70-8ac5-4b01-ae94-93524269f1b2, 'La recette est super mais je n''ai pas pus la faire entièrement car il est écrit dans la liste d''ingrédients 1 pâte brisée mais en réalité dans la recette il y en faut 2.
C''est le seul point négatif, sinon la recette est super 👍.', '2023-04-03T18:19:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86934, 8564e668-3cab-44b4-be47-504b149d0793, 'Très bon ! Par contre remplacer le lait à la crème fraîche pour le rendre moins épais !  J''ai également rajouté un filet de jus de citron et un peu de canelle.  ', '2015-10-25T09:38:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86934, 0a3d1501-98fc-4522-96ad-5017d760d00f, 'Pas mal ', '2021-03-29T16:45:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86934, 8036011b-f6dc-4130-a501-71e8d6da7150, 'Trop bon !!! ', '2015-10-24T11:30:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86934, bfea3636-682e-4e46-8fba-2b1cd018285a, 'Très bonne recette, au départ quand j''ai montré la photo aux enfants, ils n''étaient pas emballés mais en fait, l''aspect n''est pas tout à fait comme sur la photo et il est excellent', '2015-10-23T12:20:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86934, 693ac241-585e-48d2-a48c-d25ce634f143, 'C''est très bon. On a ajouté le jus d''une autre orange et 1 cuillère de crème fraîche.  C''est vrai que c''est assez épais.  mais très bon !!', '2015-10-20T17:20:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86934, 4cafc979-3f8e-4edb-a58d-de131d632355, 'Génial ', '2015-10-19T21:04:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86934, b3e6e2de-74cf-4134-afb7-3902cbd0e7d2, 'C''est pour 2 ou 3 personnes au moins !! Car il faut le consommer de suite...', '2015-10-19T18:38:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86934, cfe5e8eb-f2ed-4c5f-a1cb-5c407ac95d14, 'Super bon et frais,  un peu trop épais mais j''adore', '2014-08-25T22:25:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (86934, 75723e8e-2e6a-404d-86ef-681fa6e30243, 'Très bonne recette. Ma fille de 2 ans s''est également régalée. Merci.', '2009-09-06T22:36:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80711, ba31ff1f-a338-49e8-ab27-7af6e8223cfa, 'Je valide.', '2022-05-26T21:42:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, a1d17ff2-3117-45d9-b98f-4f915791385b, 'Parfait ! Peut être un petit moins de sucre mais ça c''est chacun ses goûts ☺️', '2024-01-03T12:57:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, 0ab4a234-bac3-4b67-b405-e68f82ba6be3, 'C’était très bon !
😋', '2023-09-14T18:38:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, fae78ad1-5b0d-43fb-8afa-56f84a4b1a65, 'Très très bon. Nous nous sommes régalés ! Cuisson parfaite (j''ai bien respecté les 40min). Je le referais sans aucun doute.', '2022-04-10T20:32:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, 48105b05-534c-4747-bde4-1484a0ff070e, 'J''ai respecté le temps de cuisson et la température indiqués dans la recette, le gâteau n''est pas cramé mais limite. Trop sec et trop sucré même avec le sucre réduit par deux.', '2018-06-02T20:54:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, be49034d-cced-4f8b-a282-b617d5903393, 'Très bon. J’ai reduit un peu le sucre.', '2018-04-25T18:51:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, bd7eb555-5b75-4d9d-ba27-e76c6d09269e, 'Délicieux, ce gout de banane avec la cannelle et le chocolat !  !  !  ! J''en refais tout de suite.', '2018-03-07T10:14:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, cf524fee-2ca6-4af0-8464-25f14c82eadd, 'Recette testée et approuvée. Super quand on n''a plus d’oeuf ! Réalisé avec du beurre car pas de margarine, et dans des moules à financiers. Nous nous sommes régalés.', '2017-03-27T15:57:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, 7c604c91-52e2-482f-957c-4de8b29c1afc, 'Tout juste parfait ! ', '2017-02-14T11:10:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, 9ba8a71a-d9ad-4c1f-99fa-eab6e8cc7906, 'Recette testée pour l''anniversaire d''un enfant allergique aux oeufs. Enorme succès, les enfants se sont tous resservis 2 fois !', '2017-02-08T12:44:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, 6929b2ad-51b5-4d87-8039-5a148bed8140, 'Super recette sans oeufs ! J''ai mis du 4 épices et bien fouetté tout au long de la préparation pour aérer. Je l''ai fait en version muffins : extras avec deux bananes, c''est suffisant. ', '2016-05-20T21:13:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, 9c5ac53c-73c2-4c13-a167-608f342492b0, 'J''avais des bananes bien mûres et ni oeufs ni lait... Cette recette était parfaite !! Je l''ai faite à ma manière, j''ai mis 4 bananes dont 2 pas écrasées. J''ai mis de la farine simple et du sucre blanc et remplacé le miel par du nutella.  Un vrai délice, mes convives ont adoré !', '2015-10-29T13:36:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, a59567e6-a3b6-4692-9079-450478e0b3f8, 'Excellents pour un dimanche pluvieux lorsque le frigo est vide! J''ai ajouté du cacao pour donner une couleur acceptable pour les enfants et je les ai réalisés dans des moules à muffins. Très moelleux et pas lourds.', '2015-05-05T23:30:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, f0a4bc53-8a5a-456c-b737-950459f81096, 'Super bon ! j''ai juste remplacé la cannelle par du 4 épices. Parfait !', '2015-02-15T14:40:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, affc2e54-1e30-4a3d-95c8-070a273ef4c4, 'Un régal en version muffin ou gâteau, mes enfants me le réclament toutes les semaines. J''ai plutôt tendance à mettre 3-4 bananes et plus elles sont mûres, meilleur c''est. Je le fais régulièrement en remplaçant la farine de blé par de l''épeautre et la maïzena par de la farine de riz.', '2014-05-07T21:47:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, 6dc8ef90-c8ad-43ec-bdfa-2919cf1c4c71, 'Bof je trouve le gâteau très pâteux, il ne gonfle pas et il y a trop de bananes moi je n''en aurais mis qu''une.', '2014-03-08T21:51:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, e680a834-e62b-4216-971d-d7f612214801, 'Ils sont délicieux, rapide et facile à faire... que du bonheur ! Merci', '2013-12-17T02:13:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, 8c32c86e-a842-4cfc-b9b8-fe2289c3723b, 'Super bon ! Je n''avais ni margarine, ni maïzena. J''ai donc remplacé par du beurre et de la farine. 30 minutes au four dans des moules en silicone (muffin). Tout le monde a adoré.', '2012-11-13T20:59:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, 5ebbdd41-f845-477c-974a-078543f20de8, 'Très bon et facile à faire. Je vous conseille de le faire dans de petits moules et de le laisser seulement 20 min au four. C''est délicieux !', '2011-07-30T17:19:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (62163, cb005b32-9286-4982-8082-d60518141ce5, 'C''est très simple à réaliser de plus ce gâteau est léger avec beaucoup de goût!', '2009-05-01T16:24:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, 6dfe9774-8e18-4a38-823f-777857b04d3e, 'Hyper facile et très très bon', '2017-05-13T22:17:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, 04a5be90-f43e-4367-a721-d33102f1baae, 'J''ai fait cette recette mais j''ai utilisé des cookies au chocolat blanc dans le fond, du coup c''était un peu trop compact et pâteux. J''ai eu la main un peu lourde sur le Nutella donc c''était un peu écoeurant au final. A refaire avec des spéculoos (je préfère que les biscuits cuillères) et un peu moins de Nutella. La crème à la mascarpone avait une bonne tenue après 24h dans le frigo.', '2015-09-12T15:22:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, dd865787-0b4d-4e22-9cc5-88e76a4d0f6a, 'Pour changer ! Une tuerie ! ', '2015-08-12T15:17:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, e5f0343e-e39a-4cf9-8185-c43a787ff071, 'Une tuerie !!! J''ai juste trempé les biscuits dans du lait cacaoté à la place du nectar de banane sinon j''ai suivi la recette à la lettre pour le reste. Original, simple et vraiment très bon. ', '2015-03-08T22:19:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, 984b4a28-f4bf-494c-a7d3-b46224b33bfe, 'Excellent. Très gourmande, j''ai mis 200 g de Nutella.', '2015-01-01T16:34:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, 19abfef7-7d3d-48fd-ad67-0a2aeb73b95e, 'UN VRAI DÉLICE ! J''ai remplacé le Nutella par du chocolat fondu et c''était juste délicieux ! Tout le monde a adoré !', '2014-07-23T21:19:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, 93dcd502-28c9-45d9-bfd9-a5b766e49a01, 'UNE TUERIE. Ce sont les mots de mon mari à la première bouchée. Je pense qu''il faut le laisser plus que 3 heures au frais parce que le mascarpone était encore un peu liquide. Je pense que l’idéal est de le préparer le matin pour le déguster le soir. ', '2014-07-09T11:19:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, de00e739-b293-46da-9ab3-230eb62f2f22, 'Succulent ! Ça change des tiramisus classiques... toute la petite famille a adoré ! Merci pour cette recette.', '2014-03-03T21:08:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, a782e19f-6589-45f0-b3c9-52ea4d210dfb, 'Trop bon ! La crème est super légère et le mélange très équilibre. La banane apporte un peu de fraicheur. Le plus dur reste à mettre le nutella dans la verrine !', '2013-09-24T13:32:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, e28c950a-5fd3-44f8-a210-1d3faba3f34d, 'Très bonne recette ! On s''est régalé !!! Merci.', '2013-02-25T18:42:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, b3d53b53-7887-48e4-bcd5-bfdfee160754, 'Dessert simple à faire et très bon. Merci pour la recette.', '2013-02-17T20:12:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, 8acdd913-9b99-492c-bc2c-ec66c5cc7914, 'super dessert, ça change du tiramisu traditionnel. un vrai régal, mes invités ont aimé.  ', '2013-01-19T18:38:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, e7a3bbf9-6448-420b-a19e-8b0099a81357, 'Vraiment au top, dessert à recommander !', '2012-12-09T21:08:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, fb77d84a-c7c9-44a8-8b22-c9453477f3a0, 'Parfait, un vrai délice ! ', '2012-12-08T07:36:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, e6e0e54e-47c4-41db-ac32-e009025277d4, 'Excellent, à refaire sans hésiter.', '2012-04-16T19:30:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, c408820b-1182-4e34-9a61-d186bbb11c8d, 'Excellent !!! Rien à redire. Très facile à faire. J''en ai fait avec des bananes et des fraises sans nutella, c''était très bon aussi.', '2012-02-22T08:27:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, 7f151daa-2ebb-49ff-bc92-b054e9621872, 'Mon premier tiramisu ! Enorme succès collectif, donc merci pour tous ceux qui n''aiment pas le café. Rien à redire, à part que le nutella ne doit pas être trop dur car c''est pas évident à repartir correctement. Bravo !', '2011-10-18T12:06:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, 1ce0ad57-7c77-414b-8749-7295aec96cb3, 'Je l''ai fait en mode verrines individuelles. Afin d’accentuer le goût de la banane, j''ai fait une purée avec une banane que j''ai ajoutée à la crème de mascarpone... Sur la même base, j''ai fait aussi des tiramisu à la fraise... Au top !', '2011-08-07T15:58:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, 97a1cc4c-6239-43a2-bb59-843ad9494611, 'J''ai suivi la recette originale et tout le monde s''est régalé. Merci pour cette recette...', '2011-04-29T01:40:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, 55a77997-a044-444d-a6e7-d425c83ca04f, 'Un délice !!', '2010-04-30T13:48:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, 30ad1cd8-0147-4751-b926-43d1149711b6, 'Excellent ! A manger bien frais !', '2010-04-21T11:28:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, 52614f5c-4010-449f-b5f4-4c288d85359d, 'Très bon dessert, facile à faire tout le monde a adoré, à refaire !!!!!!', '2009-11-23T00:24:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91040, c55c7964-2339-4971-9347-e9e94a8e5765, 'J''ai mis des spéculoos comme biscuits, faute de mieux ! C''était excellent ! Mon fils de 5 ans m''a dit "Maman ton dessert est exceptionnel !"', '2009-11-07T14:53:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43685, b1aa3fdb-c420-46f5-8ef5-3865c245040b, 'Je mets les mêmes  proportions depuis toujours, sans mettre la pâte  au frigo et cuisson 20 min. Toujours un dessert facile et rapide....', '2021-01-16T12:02:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43685, d9463bcd-e4e3-46f4-a0ee-e1f2cfe3e92b, 'Tellement sucré que c''est immangeable. Cela vient-il de la cassonade ? En tout cas je ne le referai pas : personne n''a pu en venir à bout !', '2009-11-15T11:43:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43685, bf977c0e-1f5d-4746-a9ee-b016d1650e71, 'Facile excellent et qui en a régalé plus d''un !!!! ', '2009-10-17T16:23:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43685, e0d30d16-ca1a-42df-9e1d-6ba3ade0dfab, 'Comme d''habitude, les crumble font sensation. J''ajoute toujours des noisettes pour rendre la pâte croquante.', '2009-01-29T19:51:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43685, 4f497c28-bcab-42bb-a8e1-23ed29b4cd5c, 'Pas mal, mais je ne mettrai qu''une banane la prochaine fois, je trouve que leur goût ressort trop.', '2008-02-03T17:27:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43685, 5e526cd6-b535-4377-b320-5a219deb8de4, 'Le résultat n''est pas mal, je rajouterai juste une pâte sous le mélange. Par contre il n''y a pas de températute de cuisson...j''ai donc fait au pif... Mais le mélange pomme-banane est délicieux.', '2007-07-09T16:09:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43685, 354943d8-5cea-4485-adb0-7149cb5eadd0, 'Très bon, à la fois sucré et acidulé.', '2006-06-13T20:32:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43685, 14a68edb-5d17-4e81-8574-33015c835aad, 'C''est délicieux, fondant et croustillant à la fois. Je n''ai pas mis de bananes, mais 6 pommes (canada et boskoop).', '2006-03-16T20:01:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70895, 3f269f1e-08ad-40f5-a80a-938070ef5538, 'Parfait ', '2023-10-07T18:30:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70895, 978348aa-5819-4c75-8a08-a205f19f00d7, 'Recette sympa, rapide, facile et efficace ! Elle a beaucoup plu aux invités, merci !', '2011-10-19T12:56:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70895, 5a489384-949e-4a96-9526-18b0f4332844, 'Pas mal au goût mais la banane et le chocolat sont restés coller au fond du plat!', '2008-11-17T17:27:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70895, 63710865-c3d4-436d-a838-d657097625be, 'Bien, petits morceaux de chocolat un peu coulant, mon mari a adoré.', '2008-09-21T19:25:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309999, 4657a4c7-9ab5-4d0c-961b-7953b9affb29, 'Super bon ! Pratique pour finir le beurre de cacahouète utiliser pour faire un poulet cacahouète 😇', '2023-08-10T11:52:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309999, 08df091f-b532-4f10-b33a-e0d00b32a71d, 'Très bon ', '2023-04-23T10:53:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309999, a351f59c-b11b-4a65-a6fb-99ac881e34ee, 'Quel délice !

', '2023-03-29T16:29:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309999, 3297594e-59a0-4182-8c01-626a6edb65a6, 'Recette rapide et très bonne !', '2022-10-14T08:46:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309999, aac05412-4502-47f5-a4fa-57c1d480a32e, 'Je n’ai pas mis de miel et quand même très bon !', '2022-02-13T15:02:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309999, f1f7e80e-0bf1-4f32-9c37-0e67a2db593a, 'Bonne recette, on peut y ajouter plus de beurre de cacahuète, avec deux cuillères  (pourtant j''ai mis des cuillères à soupe !) le goût est très léger
Le goût de banane par contre lui est parfait et pas dénaturé par la cacahuète !', '2018-03-18T04:08:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309999, 90547011-7eba-4cd9-bb76-0bc28441418c, 'Très bon ! Peut-être mettre un peu moins de lait pour le rendre un peu plus consistant. Le gout de cacahuète est léger.', '2017-04-04T14:50:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309999, 26c142d8-26dc-462d-8af6-a9befaf50fc4, 'J''ajoute 2 boules de glace vanille.', '2016-11-18T15:26:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309999, e4eab3e7-fe3f-44f6-8aba-28f8748cce2d, 'Super bon ! J''ai mis une cuillère à café de beurre de cacahuètes. A essayer peut être avec un tout petit peu moins de miel la prochaine fois car un peu sucré quand même.', '2016-09-14T09:25:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309999, d1d74304-4ab9-4e32-b2f2-c832d71395ac, 'C''est un délice !', '2015-04-16T22:18:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309999, fec94948-be8c-45e7-a98e-723d281b6272, 'Tout simplement divin ! A refaire !', '2014-03-02T22:23:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (309999, 6303dcca-3d95-4709-8f82-786c15df877d, 'Pas mal du tout ! Le beurre ne se mélange pas si bien, je n''ai peut être pas assez mélangé. Cuillère de cuillère ? ', '2013-07-24T20:20:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39395, 7ca4f273-560c-4b0b-aa9f-a41454529dce, 'La quantité de fruits rouges dépend de votre gourmandise ... moi qui suis très gourmande, et puisque les paquets que j''achète font 1 kilo, et bien j''en mets 1 kilo tout entier, mais pour être raisonnable, je pense que 500 grammes suffiraient. Mais qui dit qu''il faut être raisonnable ?? ', '2009-05-05T12:44:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39395, 0b1a8f51-965c-4216-8a5a-021fae36cd62, 'Super merci beaucoup, le plus de cette recette, c''est qu''on peut vraiment l''adapter en fonction de ses goûts. Je n''aime pas la banane alors je n''en ai pas mis et à la place du jus d''ananas, j''ai mis du jus de mangue. C''était frais, sucré et acidulé. J''ai préparé ce cocktail pour une de mes invitées qui ne buvait pas d''alcool et les autres invités m''en ont tous réclamé tellement il était appétissant! Pas de gâchis, tout est parti. ', '2014-02-01T14:30:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39395, 1cd62fb4-4673-4c6a-afd8-f822dad984cb, 'J''ai fait ce cocktail pour mon départ d''une entreprise il a été très apprécié. Frais ressemblant à un punch, facile à faire et délicieux la rapidité pour le boire a été la preuve, la boisson idéale dans un pot où l''alcool doit être banni, je vous le conseille.', '2013-08-29T10:11:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39395, 3c814e76-2e96-4728-a32f-9d4f17c1fd82, 'Je le fais chaque été, et en hiver c''est oranges citrons doux oranges douces pommes et bananes au moment de servir. Merci quand même, les enfant prennent un verre pour le goûter.', '2013-08-08T19:34:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39395, 4d982ffa-5a62-4b82-82d2-ec3662e63f60, 'Super, les enfants adorent.', '2013-06-25T18:25:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (39395, b8d7d2a8-cd0c-45ce-942a-47ce023a7950, 'Très bon cocktail! Les saveurs sont excellentes et il est sucré ce qu''il faut. Par contre la dose de fruits rouges n''est pas très claire...boîte de combien de grammes ? mystère...à vous de juger selon votre goût !', '2006-05-22T13:56:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 4ab71175-771d-4299-b715-9b3316c0ba6b, 'Parfait ! On a juste remplacé la banane par du jus de goyave et de mangue. Gros succès :)', '2020-07-03T09:56:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 2928dd12-82cf-4d35-8a82-fdcffef00a09, 'Très bon, j''en fais à chaque Noël et nouvel an', '2021-12-03T11:56:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 2b7d64c1-220c-46b8-a83c-8fd26151c1f5, 'Un peu chochotte, j''ai doublé le volume de jus d''orange (5L de punch en tout donc) : parfait ! Des avis entre "il passe bien", "il est costaud" et "il est léger". Il m''en reste très peu ; c''est bon signe ! Par contre, la macération est vraiment non négociable. J''ai goûté avant ;)', '2015-10-05T14:10:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, a762aeac-bc25-4ca1-8d89-937ff84f058d, 'Succulent ! Tous mes invités ont aimé... j''ai ajouté un litre de goyave et mis les fruits la veille (2 bananes, 2 oranges, 2 pommes gala) - fais une semaine avant - j''ai pris du rhum ambré (mis environ 75 cl) ', '2011-09-11T05:43:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, c05eace7-4de6-43e3-8809-235e0c2ff319, 'Ce planteur est tout simplement génial, je le fais à chaque grosse soirée entre amis et il fait fureur ! Je remplace juste le jus de banane par du jus de goyave ! En plus il n''y a rien de plus simple à faire. ', '2010-08-19T20:15:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, f239e5f4-2fa0-4d1c-a160-3c81bb360719, 'Je le prépare longtemps à l''avance (quand j''y pense) et l''ai déjà gardé plus d''un an (lorsque j''en avais préparé une vingtaine de litres pour des fêtes), plus il macère, plus il est délicieux, velouté et imprégné des épices.  Je le remets dans les bouteilles en verre que j''utilise (rhum, jus de fruits), y mets la gousse de vanille fendue et divisée en quatre, un morceau par bouteille, et ne mets pas de cannelle en poudre, mais un bâton de cannelle par bouteille, idem pour les clous de girofle. Je peux ainsi les stocker et transporter facilement et en garder une au frais au réfrigérateur. A consommer très frais, excellente recette !!!', '2010-05-30T23:23:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, ae6b50c8-b2a5-42fe-8942-d14c5cbaf6b5, 'Très bon', '2016-12-24T18:01:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 8b81c0e1-e197-44e0-850a-89e819f9831b, 'Sauf que c''est la recette du planteur et pas du punch antillais (rhum, sucre de canne et éventuellement citron vert) !!!', '2016-09-11T01:21:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, ebd1817f-7c25-43a0-871c-9587ee9bb9a8, 'Excellent. Perso j''ai remplacé le jus de banane par le jus de goyave. Prendre que des jus pur jus. je mets 2 gousses de vanille et je mets des fruits tranchés : 1 ananas 1 orange et 1 citron vert et je respecte les quantités de cannelle, muscade et clous de girofle et je laisse macérer mini 6 jours. La recette a été approuvée à plusieurs reprise. je suis maintenant le fournisseur de punch à chaque soirée. ', '2016-03-14T18:04:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, e2d7cc17-ec42-4443-8232-bb878c947ec3, 'Excellent !!! J''ai ajouté 2 litres de jus d''ananas goyave en plus  ', '2015-11-05T09:23:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, b79cf6c2-5706-4fda-838e-10b67374e0c3, 'Approuvé par un ami Antillais : mais la prochaine fois j''utiliserai des 100% pur jus quelque soit le fruit ! ', '2014-10-09T17:22:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, e9aa5062-f8eb-45d3-93af-37e15a68c065, 'Délicieux et rafraichissant ! J''ai remplacé le jus de banane par du multi-fruits, ai placé les clous de girofle dans un petit sac et des rondelles de citron vert directement dans le saladier.', '2014-09-05T00:10:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, f17e89a3-4f3a-407f-911f-f62878aa3588, 'Parfait ! J''ai mis un peu plus de jus !', '2014-08-11T18:31:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, bc83f46b-bc32-4574-bda2-62a016f75496, 'Très bon mais j''ajouterai du sucre ou sirop de canne la prochaine fois, mes jus étaient peut être trop acides.', '2014-07-06T20:54:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 55fc4630-7685-4a32-8d91-977e8d1dd13b, 'Super !!! J''ai juste remplacé le jus d''ananas par du jus de goyave et un peu de sucre de canne.... Good.', '2013-04-30T10:40:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 523311f9-3a13-4a1f-b94e-30df162d131d, 'Super !!!!', '2012-09-05T19:38:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, e2c9b31d-f6af-49e4-946f-9e9d1550ef0b, 'Excellente base de recette à garder et à ajuster selon les goûts. Je n''ai pas mis de fruits mais j''ai changé les quantités et j''ai mis du sirop de vanille et de l''anis étoilée et jus de goyave à la place du jus de banane. A boire bien frais', '2012-09-04T09:06:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 723eece1-d7ff-4e5f-8cef-17079b96f38c, 'Juste parfait', '2012-08-17T12:38:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, fb74cd76-1977-4c95-b926-c0998fbd67db, 'On adore le punch et cette recette est super. On la fait à chaque occasion. On ajoute quelques morceaux fruits dedans, orange, banane et ananas.', '2012-08-01T08:00:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, d5d47b11-29f4-4042-a3bb-0f60da74e1db, 'Je viens de le goûter chez une amie et me suis régalée il ne me reste plus qu''à le faire !', '2012-06-29T18:17:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, f26ae874-9250-42eb-b706-a47409209968, 'Mes invités ont adoré. Recette facile avec de multiples variantes.', '2011-11-13T12:28:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, d1388145-4e85-4c42-bb2c-aaa6623abf3a, 'Délicieux ! J''ai suivi la recette à la lettre et tout le monde s''est régalé ! Je l''ai faite 3 jours avant, 8 litres pour 10 personnes, c''était un peu juste...J''ai fendu la vanille en deux et coupée en trois.', '2011-07-27T21:37:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 13436302-98ea-4ac1-86e1-d4f61ad455d0, 'Merci pour cette recette, fait avec du jus d''orange, ananas, goyave, mangue et multivitaminé. C''était très bon !! Commentaire de la mamie de ma filleule: " elle est très bonne ta soupe "  Encore merci.', '2010-07-04T14:42:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, cf045c24-b2fc-4693-b72b-a25a7653fcf2, 'J''ai remplacé le jus de banane par du jus multivitaminé. C''est vraiment délicieux !!! ', '2010-05-16T19:54:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 148f6d9c-5dc5-4cca-80a0-3dd9dc936fe9, 'Fait avec 1 litre de jus de mangue en plus et sans clous de girofle, je l''ai fait macérer deux jours, mes invités ont a-do-ré ! Merci pour la recette :)', '2010-04-07T20:34:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, dbe8e774-cb27-476b-8a34-4c316b874b1e, 'J''ai suivi les conseils en ajoutant un litre de jus de goyave... excellent tout simplement délicieux.. tout le monde a apprécié !', '2009-09-05T15:04:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 6f219ff9-8fd8-47fb-85b4-1a3cc745676f, 'Après avoir fait macéré le punch durant 4 jours il a fait le bonheur de mes invités. Respectez les indications et c''est réussi. ', '2009-06-14T19:30:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 92789fa4-d949-4ac1-a2d7-d60a21270dad, 'Il faut vraiment le faire quelques jours à l''avance : juste bon le soir même, très bon 2 jours après et à tomber au bout de 3 jours.', '2009-02-18T19:49:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 69a7eacd-90bb-4cae-a5b2-6db7de186835, 'Nous avons ajouté citron et gingembre, et la note passe à 5.', '2009-02-16T21:21:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, aec20226-9cf2-4b33-94d7-fd8c23bf86ed, 'Absolument incontournable ! Sur les conseils de josette_192, j''ai ajouté 1 litre de jus de goyave, ainsi qu''1 orange et 1 banane finement coupées (mais pas de pomme, j''avais oublié). 70 cl de rhum suffisent. Résultat: j''ai dû envoyer la recette aux 20 convives le lendemain ! Tout simplement le meilleur punch que j''aie jamais goûté. Merci pour cette recette !', '2008-11-23T13:39:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 36595253-64bb-4733-923c-0cca49d20476, 'Je l''ai préparé pour un anniversaire, c''est absolument délicieux. J''ai juste ajouté en plus, 1 l de jus de goyave, 40 cl de sucre de  canne et la veille j''ajoute 2 oranges, 2 pommes et 2 bananes. Quant au rhum c''était une bouteille de 75 cl, c''est largement suffisant.', '2008-10-06T19:47:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 9ab7a3f6-061d-46fc-bb91-890b7f2fd296, 'Un délice! J''ai mis un poil moins de rhum et de jus d''orange, et j''ai rajouté des fruits coupés (bananes, oranges, citrons) la veille au soir. Tout le monde s''est régalé !', '2008-06-16T19:32:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 0231e26a-98eb-4e28-bae9-d068efd2b949, 'Très bon, mais j''ai ajouté du sirop de sucre de canne car il est peu sucré.', '2008-06-16T00:51:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 4ebbce92-8488-4565-a2ab-64f4323096b2, 'Parfait! Le punch a été apprécié de tous. J''ai mis la moitié du punch pour l''alléger tout en gardant le côté sucré. Il est également très facile et rapide à faire (j''ai mélangé les ingrédients deux jours avant la soirée).', '2008-06-06T22:45:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 6be9064b-dc52-4a5d-bccd-2d7b04d374ed, 'Hum!!!qu''il était bon ce punch!! j''ai changé un peu la recette : jus de goyave, cocktail des tropiques et jus d''orande pour ce qui est des jus de fruits. un délice!!', '2007-08-07T20:07:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, be655e12-b93c-4ecb-9fc3-6f7b8226d2bc, 'Parfait. J''avais réduit la quantité de rhum (75 cl) et rajouté deux verres de sirop de canne. Très apprécié des invités qui se sont largement servis ! Merci pour cette recette.', '2007-07-09T21:52:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 5fcca53a-97a4-4aab-8943-6349dd5e848f, 'Parfait! Par contre, nous avons ajouté 1 verre de sucre de canne. Ne pas oublier le citron vert qui donne de la fraîcheur et surtout la maturation qui le rend bien meilleur. Nous n''avons pas mis de clou de girofle.', '2007-05-08T14:14:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 6fecd715-1239-473e-840c-93d2c2464165, 'Délicieux, je l''ai testé pour ma crémaillère et les convives étaient très satisfaits. J''ai rajouté 1 litre de jus de mangue cela relève encore plus le goût. Merci pour cette fabuleuse recette.  ', '2007-04-08T16:57:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 4a55e0f5-70ec-4aa4-844f-c19e82d93a21, 'J''ajoute du sirop de canne (1 mesure pour 3 à 4 mesures de rhum brun et 4 à 5 mesures de jus de fruit) plus 1/3 de bitter (petite bouteille). Je n''oublie pas les fruits...', '2006-12-30T15:05:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, f069c9f3-078c-4022-b964-4fde18293ea7, 'Délicieux. Testé pour Noël, à refaire pour le Nouvel An et pour n''importe quelle autre occasion.', '2006-12-27T15:54:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, ad0c8acc-1321-4c55-bb9f-019aa7b14d7d, 'Testé pour le Nouvel An et depuis un grand classique de nos soirées arrosées.', '2006-08-30T22:01:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 3f39c758-cce9-4d07-a1c3-b7ba6c0138c4, 'Simple à réaliser mais j''ai quand même rajouté 3 litres de jus de fruits (banane, goyave et multifruits). Au bout de 2 jours, ce fut un régal mais après une semaine de macération, il était parfait. Je vous le conseille.', '2006-07-06T23:10:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, af3493f7-55fd-4e33-894f-534b2ff47398, 'Excellent pour l''été. Très facile à faire surtout pour les réunions familliales. A beaucoup plu aux femmes. J''ai rajouté un peu de sucre de canne pour qu''il ne soit pas trop fort. Se conserve très bien. A refaire.    ', '2006-06-13T12:20:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 557dbb22-cff0-42e2-abe0-f2851c9cfa80, 'Vraiment très bon mais attention de ne pas en abuser !', '2006-02-07T20:24:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 3731976c-237e-49b3-ba36-4b1dbdc5a5c8, 'Parfait! A faire et à refaire en plus grande quantité, car il y a un léger goût de reviens-y...', '2005-12-03T00:42:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 5b3325b8-e652-43e7-ba41-98aabba021c7, 'Très bon, à fait fureur!!!', '2005-07-10T23:50:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 045f1b3c-1f3e-4538-a3b1-5afe1f532ec9, 'Parfait selon doudou, il a mis moitié moins de jus d''orange, et tout le monde a adoré, ils sont tous repartis torchés...', '2005-04-24T16:53:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 44174f76-3db0-4163-85a8-1b3310d8a0ec, 'Très bon, j''ai rajouté 1l de jus de goyave + 1l de jus de mangue et du sirop de sucre de cannes et des fruit en tranches (oranges, citron vert et jaune, bananes) et 1/2 litre de rhum en+. ', '2005-04-04T23:38:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 67509a53-70eb-42fe-9731-a039eb44aa63, 'Servi samedi soir pour ma crémaillère, j''ai fait 16 litres pour 30 personnes, il n''en est pas resté une goutte! Un délice !!', '2005-04-04T22:06:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, cda8e7fb-1fb6-4c97-9d1a-d6f9ecc519ac, 'Testé à de nombreuses reprises, il est délicieux, mais peut-être légèrement fort... Dans ce cas-là, rajouter 1/2 litre. Je rajoute un peu de vanille(liquide ou naturelle) et du sucre de canne liquide en quantité moderée. A servir très frais, mais macération pas absolument indispensable, surtout en cas d''urgence!!!', '2004-07-09T18:12:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16275, 36e1cce8-1897-46c1-aba0-77dce5d71d54, 'Super!! Il est doux et ne fait pas mal, surtout lors de réceptions.', '2003-07-08T19:53:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223466, f131759e-e4be-487b-8a18-eaa1f400058f, 'Je fais souvent cette recette et je l’adore !', '2019-10-12T08:24:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223466, e3495cc8-b4f0-4c63-9a3b-dabee79f112c, 'Ça aurait pu être très bon s''il y avait plus de levure car les cupcakes sont tout plats et ont un arrière goût amer. La pâte n’est pas bien cuite à l’intérieur alors que je les ai remis au four et suivi la recette à la lettre.', '2019-07-11T05:48:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223466, 26d6200d-d606-47d8-b4a6-9bf4670e5640, 'Très bon je l''utilise souvent 😋', '2021-12-18T15:14:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223466, 4c780cc6-29eb-41fe-a7a0-f4f10709a789, 'Ils sont super bons ! Je conseille de les laisser 5 minutes de plus car je trouve qu''ils sont un peu trop cru à l''intérieur.. Sinon top ! ', '2021-06-05T13:23:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223466, 35266cb0-fbb6-407a-a940-28865aa026b9, 'J''ai adoré !! J''ai rajouté de la pâte à tartiner au spéculoos c''était super bon. ', '2015-04-25T19:51:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223466, 98645313-67fd-4b66-b8f1-186d987e972c, 'Essayer avec une cuillère à soupe de confiture de lait sur le dessus et pour finir une chantilly pas trop sucré le top', '2015-03-22T12:50:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223466, a5fe6edb-8001-4cf8-8208-697e774cfa90, 'J''ai adoré la recette je l''ai suivi à la lettre. Ils étaient parfaits et bien cuits à l''intérieur. C''est devenu une recette dans mon livre de recettes.', '2014-10-11T16:40:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223466, 6c0b3962-606f-428f-a4b6-c1fc1b10a241, 'En tenant compte des différents commentaires,  ça a donné des bons petits cupcakes. Peut être un peu mou mais vraiment très bons. ', '2014-10-03T00:58:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223466, 7dec9a1b-a866-4413-bb2a-f43c674d27a7, 'Très bonne recette. ', '2014-01-08T19:20:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223466, e648953a-6a42-4bef-a81f-e8cc0e4e1e24, 'La quantité de levure indiquée ne permet pas aux cupcakes de gonfler, ils restent plats, tassés. Bien entendu cela se ressent au niveau du goût. Dommage.', '2013-12-28T16:35:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223466, 8030e218-4ec4-485b-accf-ee09adb43174, 'J''ai vraiment aimé cette recette ! J''ajouterai cependant une trentaine de grammes de farine, la consistance du cupcake n''était pas top ! Merci pour la recette !', '2012-11-03T03:24:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223466, c1bb4660-8aa2-41e2-a168-8886982e6998, 'Excellent ! Ces petits cupcakes sont très moelleux et ont un goût de trop peu... Pour la déco j''ai utilisé du chocolat pâtissier fondu au bain marie plutôt que de la pâte à tartiner. Je réutiliserai la recette avec plaisir !', '2012-03-20T18:53:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (223466, db43160b-ef42-4c47-b8bf-1a1e232af9fe, 'J''ai essayé cet après midi et c''est pas mal. Simple. Je pense qu''il y a moyen de mieux faire, mais c''est convenable comme résultat. ', '2012-03-18T21:00:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42061, 392af2c7-d671-44f9-a7ac-7d265edf941e, 'J’ai mis 25g de poudre d’amandes et 25g de poudre de noisettes, j’ai utilisé de la compote de pommes seulement et mis des pépites de chocolat, un RE-GAL!', '2019-08-02T10:55:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42061, a3ddbcf2-a1a7-4939-9082-a157398ffb29, 'Super bon ! J''ajoute 100 g de compote selon le moule à tarte que j''utilise !', '2010-12-10T18:43:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42061, 74981178-78d4-49e7-9968-0ce0aece08bf, 'J''ai utilisé la base de cette recette simplement pour faire un crumble. J''ai mis la compote dans les ramequins, j''y ai disposé des fines rondelles de banane et des tranches de pomme. J''ai fait ma pâte à crumble et au four... C''est délicieux et vraiment très simple à faire !! ', '2009-05-12T19:08:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42061, 69379357-6168-451d-a638-da5c64782e94, 'J''ai remplacé la poudre d''amandes par des biscuits croissant de lune écrasés. Merveilleux !', '2007-11-04T10:05:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42061, c4251e63-64d2-4ae8-8936-b6aced12d374, 'Je vous conseille vivement de déguster cette petite merveille! Lorque je suis invitée chez des amis j''en prépare une et elle a toujours fait une très bonne impression!', '2006-12-05T16:04:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49677, 61530f8a-23e8-4988-b879-b642a0a0969d, 'C''est parfait rien à dire !!', '2018-07-02T10:29:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49677, e5d43d32-ded5-40be-a428-7085f64790d0, 'Très bien j''adore !', '2018-07-01T10:07:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81534, 921db525-44b0-4b3c-bded-e67a0e7d3f76, 'Moi j''ai remplacé quelques ingrédients et en ajouter d''autres... Et un tiramisu,en général (façon italienne) on le laisse 12 heures de repos, au réfrigérateur. ', '2014-03-10T12:23:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81534, 49af1b7f-509e-4433-8a14-4a8b0418ae39, 'Je suis désolée, moi je n''ai pas aimé, la texture était trop lourde, la prochaine fois, je mettrai plutôt de la crème de coco à la place de la coco séchée. La dernière couche donne un effet sableux, je la zapperai aussi, pour la remplacer par du chocolat fondu. Comme je n''aime pas le café, j''ai remplacé l''expresso par  4  gros carrés de chocolat dessert fondus dans une tasse de lait. Et je n''ai mis que 60 g de sucre, qui étaient suffisants. Effectivement, faire cuire les bananes avant est une bonne idée ! Merci pour ta recette, cela dit ! Les saveurs se marient bien !', '2010-08-18T18:39:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81534, a3bb0876-172c-46be-96cc-dd903a0f9a78, 'Très bonne recette, la banane caramélisée se marie très bien aux spéculos. A mon avis, ce serait meilleur avec moins de sucre. Merci beaucoup pour cette recette !', '2010-08-10T13:25:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81534, d79fdabe-ca64-4f90-bb8f-5a99e4851e67, 'Super bon! Il avait une "tête" bizarre (car j''avais oublié le mascarponne, j''ai dû le rajouter après et en remuant le tout) mais excellent! Mes invités ont beaucoup aimé et moi de même! A refaire!', '2009-01-15T19:19:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53116, 38a49e89-d6d9-4729-bb92-bd023ebdccdf, 'Très bon! Juste quelques modifications: pour la crème, j''ai fait comme un tiramisu... séparé 3 jaunes que j''ai mélangés à 50g de sucre, monté les blancs en neige et mélangé tout ça à la mascarpone.', '2008-06-01T16:54:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81405, 80d68dbb-efb7-4ba1-952b-790f8418fda8, 'Délicieux et facile !', '2010-10-18T22:01:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227918, 6e450df6-8956-4002-8889-1a14fe1c297d, 'Ajouter une banane et diminuer la quantité de pâte d''un quart sinon c''est raté.', '2016-07-03T23:13:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347963, b3714c9c-af4c-4d07-bfd5-fc59f7a0673a, 'Super recette. 👍', '2023-03-13T20:36:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347963, ddf2a9ff-44ac-4cbe-bf19-f40df7f36887, 'Super bonne idée 
', '2022-05-07T10:36:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347963, 0d718cb0-9766-4828-9903-266aa55add1b, 'Très bon il faut simplement prévoir 2 heures avant de déguster pour que le chocolat ai le temps de durcir ', '2020-08-11T13:38:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347963, ed310666-aa92-49bc-bb73-5c784944ab66, 'Parfait. Un régal.', '2019-11-23T10:52:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347963, 395364c9-fe37-4c65-8b63-6596b9362f93, 'Délicieux j''adore facile et rapide a faire moi je l''ai fait avec des fraises et du chocolat blanc !', '2017-08-21T15:44:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347963, 5d6cd950-c08a-4827-ae4c-4787d03072c5, 'Une recette vraiment simple et qui ravit les enfants, avec des raisins c''est délicieux ', '2017-07-23T13:53:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (347963, 4664a4eb-fa3c-4fd6-97a9-bef7eeb48930, 'C''est une recette super rapide à réaliser et c''est délicieux.
Personellement j''en ai fait avec des abricots.', '2017-07-09T17:12:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65736, ad758d02-1ca0-4e93-9a54-d1c6e6c634f9, 'Très bon cake... Mais je m''attendais à plus de goût de banane... Je vais essayer de modifier la recette. Mais excellent quand même !', '2011-03-26T16:37:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65736, f550fdf6-b1a3-4c09-b6fc-fc79bab1ea8a, 'Bof! Bel aspect mais aucun goût! Très déçue, sans plus!!!!!', '2008-06-27T12:12:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65736, 59eb191d-f16d-4dfc-acc6-a78a6f043949, 'Ce cake est excellent, merci pour cette recette.', '2008-01-27T13:28:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44815, 76f9a774-4de7-4686-96d1-7f25dce00ef9, 'Les fruits sont très bons, mais il y a beaucoup trop de farine ! Enfin le miel est une très bonne idée donc ça sauve, mais quand même.', '2011-11-18T01:54:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44815, 7fca8990-ee8c-422e-9e13-d537ebdb9d2f, 'Très bon dessert, rapide et facile a utiliser. Merci! J''ai particulièrement aimé la noix de coco dans le crumble... 2 cuillères à soupe et pareil pour le miel.', '2009-02-14T22:16:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (44815, 8c6611dd-8a8a-42ef-a608-2b4934db6485, 'Excellent dessert...merci Pauline pour cette recette!! J ai réalisé ce crumble sans mangue et avec plus de miel. Seul petit bemol: il manque 1 cuillère de coco dans la pâte crumble, mais bon, ça c''est mon goût personnel.', '2007-02-05T00:08:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172508, 622933b6-9424-487d-a43c-fc4ad9b0b170, 'Très bon !', '2017-09-23T12:18:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172508, ddabd618-436c-4356-8208-3c207c18f879, 'Parfait ! Facile, rapide, ça sent bon, bref à refaire !!!', '2015-02-18T17:49:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172508, 93f952c9-0e6d-4c3b-a703-a96642c0e5be, 'Trop bon !', '2015-01-25T12:06:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172508, 3ee51474-2849-4b6a-91e2-4dc7a38ae1b8, 'Recette simple mais extrêmement bonne !! J''adore !! Très facile et rapide !', '2014-09-12T17:39:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69048, 08b90c75-deff-4d5b-9894-c5f859160a10, 'Je faisais déjà ça avec des fraises et de la banane mais je mélange le tout avec de la crème fraîche, je laisse reposer dans le frigo jusqu''au lendemain et c''est délicieux!!!', '2008-07-18T21:33:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69048, be4d9f20-0ffe-40bf-9e89-155f1c58fcb0, 'Très facile à fair⚽️????', '2023-10-31T11:46:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69048, 05d3015e-1c67-4fd1-873c-79f073ea49c0, 'Très facile à fair⚽️👍👍👍👍', '2020-05-12T19:31:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69048, a7a68965-6bb4-4ccd-ab70-a0b86d690a74, 'Facile et de saison ! J''ai oublié le citron et j''ai remplacé le sucre par une cuillère de sirop d''agave (même pouvoir sucrant mais indice glycémique très bas, pour ceux qui surveille leur taux de sucre, mais très bon quand même).', '2009-04-26T20:14:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (69048, 5ce9fc6a-90fc-4194-80b9-c2bd0d858d90, 'Rien à dire sinon que c''est très bon et peu onéreux', '2009-04-26T12:57:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50869, bf2f4f8b-7789-4243-b466-415c027886f8, 'Je suis tombé amoureuse ', '2023-02-12T14:55:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50869, 2986087c-3041-4c4c-b543-eb7a8e14ba39, 'Super bon, j''adore !', '2022-12-14T21:32:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50869, 402ac57f-72e2-4257-81b6-7671a0a56f7a, 'Trop bon.', '2016-11-21T17:31:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50869, 0196d3d6-e9ca-4c3e-96af-93cdc7e98eb1, 'Un délice ! Merci pour cette recette. ', '2016-11-17T13:18:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50869, c9745233-49f9-476c-b73a-a486d8091462, 'Bon mais un peu trop de chocolat. A refaire quand même !!!', '2016-05-21T18:29:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50869, 5f8da248-667d-4616-9dd3-d7d8db4d3b53, 'Fait avec de la pâte à tartiner bio "Choko noisettes" sans cacao et ça déboite !!!', '2015-07-21T00:49:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50869, 99f42047-cc3c-4e82-bc38-12a60e39dfc0, 'C''est TOP ! On sent bien tous les ingrédients même si le goût du chocolat en poudre et du Nutella prennent le dessus sur le goût de la vanille. J''ai remplacé le yaourt nature par un yaourt a la vanille. C''est un superbe Milk Shake.  A boire bien frais ! ', '2015-07-14T19:38:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (50869, 13908ff7-ffc5-4dda-bc7c-a3106bea17f1, 'Testé sans chocolat en poudre avec une cuillère de nutella en plus....un peu trop chocolaté donc je respecterai bien la dose de nutella la prochaine fois. Le mariage nutella banane est top.   ', '2007-05-05T16:11:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32343, cbaa4244-ba2d-47a5-82d9-1ec0bf5fc5f3, 'Bonne recette à réaliser avec des bananes mûres. ', '2016-02-21T20:45:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32343, 273737ce-ff83-47cc-a00c-465c9a467954, 'Extra avec 1 sachet de pépites (100 g) 75 g d''amandes effilées et 50 g d amandes en poudre. Un regal et un dessert qui étonne. Il marche à tous les coups ! Je ne précuits pas la pâte feuilletée mais par contre je la cuits sur la plaque. ', '2014-06-26T21:28:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32343, 5deefcc6-2d25-4528-b24a-05882c9876ac, 'Très très bof. Nous avons tous trouvé cette tarte très fade, la meilleure partie était la meringue. À faire exclusivement avec des bananes très mûres et à tenter avec autre chose que de la pâte brisée... Grosse déception!', '2009-10-18T17:18:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32343, 147d0f73-2cc5-41c1-989e-6820c245e1eb, 'Facile, rapide. Pour ma par,t les temps de cuisson sont impeccables et c''est excellent ! Pas trop sucré mais assez, on sent bien le gout de la banane, et c''est un dessert léger. En plus, on peut faire une bonne surprise (pour ceux qui aiment la banane) : grâce à la meringue, on peut facilement la faire passer pour une tarte au citron ... ', '2009-05-27T19:59:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32343, cf51e849-3b9b-417b-a09b-5e012542b794, 'Vraiment très bon, par contre la prochaine fois je ne précuirai pas la pâte car pour ma part j''ai dû cuire le gâteau 40 min au lieu de 20, sinon vraiment bien, la meringue aussi.', '2008-08-25T23:32:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32343, 73497f32-d0f8-4597-aa72-08446daa669e, 'Fin, pas lourd, délicieux au palais....facile.. rien à dire...', '2008-01-11T12:12:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (32343, ef1b00c0-bc87-408c-873b-e83493395346, 'Rien à redire très bien. Attention à la cuisson. Je n''ai pas mis d''amandes mais c''était bien', '2008-01-01T13:26:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224414, 1dc23f41-e1a0-4aa6-b894-14e491320a46, 'Le dosage du lait semble erroné, mon cake ressemblait plutôt à un clafoutis, bon je n''avais pas mis de noix de coco, est-ce la raison ?', '2012-04-26T14:45:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (38159, de18efc7-ec4d-46ef-b246-fc0f85cadf53, 'Recette simple, originale et agréable à préparer : les superpositions sucré/salé et doux/acide sont très réussies. Bien que cuits au barbecue, les ingrédients gardent tout leur moëlleux : les noix de St Jacques grâce au trempage dans le lait, les filets de poisson grâce à leur emmaillotage dans la poitrine fumée, et les bananes grâce à leur peau. Merci pour cette recette qui apporte une alternative très réussie aux éternels barbecue-merguez.', '2007-04-18T14:53:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (527853, 215210de-130e-4c94-a0e4-17df5ce79b61, 'Géniale la recette.', '2023-01-03T15:31:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (527853, 0483cda8-f849-4eff-aff1-840aee97baef, 'Bonne recette merci !', '2020-10-16T15:38:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (527853, f1198ed8-ddf1-4892-ac8a-4d460e226502, 'Merci! Cest délicieux! On se regale! Ca va devenir un classique chez nous. 
', '2020-10-15T22:19:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 51c42120-2c71-4dd2-ad6b-5e7297125365, 'Excellent!
Selon les commentaires, je l''ai mis au four 45min et c''est top. J''ai fait une petite variante, au lieu de faire fondre le chocolat, je l''ai coupé en petits morceaux pour faire des pépites, je trouve que le goût de la banane est bien ressorti ! ', '2021-04-08T16:24:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 012602cf-0408-4051-8d35-cdadc55a2584, 'Très bon gâteau, 30 minutes de cuisson suffise, j''ai mis 4 bananes bien mûres. Et j''ai fais en une seule préparation pas en deux fois comme dans la recette. ?', '2020-08-15T12:48:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, c25fea8d-bb49-49db-9eca-13744d0eab6d, 'Bonne recette simple mais par contre, ne pas hésiter à remettre de la banane, pour que le gâteau est plus le goût de la banane', '2020-06-07T11:14:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, abc61f0f-65ef-433e-81c6-edb11213c033, 'Très bon gâteau ! On sent pas trop le goût de la banane mais c’est encore meilleur avec de la noix de coco ?', '2020-05-17T22:19:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 5e0b5610-02d6-4cc8-b7a4-49b7f74c5a8b, 'À notre humble avis il ne faut le faire cuire qu''une demi-heure. C''est délicieux, merci !!', '2020-03-30T00:22:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 397dcb3d-d383-43ff-82f2-57c4bfcb208d, 'Beaucoup trop sec donc pas bon tout simplement. Mon fils a choisi la recette et je n''avais pas lu les commentaires. Vraiment pas terrible ! Première fois que j''ai envie de jeter un gâteau...', '2019-03-09T04:23:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, a6abd964-26a4-48d1-a4aa-ada2ce36b5b3, 'Pas extraordinaire. Compact même après avoir réduit la cuisson. Fait des blancs en neige et remplacé la moitié de la farine par de la maïzena.', '2017-01-08T22:51:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 3e330fbb-7e2e-49df-8b1a-9efef61aa0a4, 'Superbe recette , le gâteau a été terminer en moins de 2 ! ', '2016-10-26T15:43:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, a4385812-41da-4a81-aeea-0543a35044dc, 'Fais à plusieurs reprises : simple et tellement bon! Aucune modification apportée à la recette.', '2016-04-23T17:38:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 2da4f784-afa8-48dc-b1f0-1e0036416de0, 'Franchement j''étais très sceptique au fur et à mesure que je faisais ce dessert... J''ai mis du chocolat au lait au lieu du noir... C''est une tuerie en tout cas mes enfants se sont régalés !', '2016-01-26T18:25:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 1fac54ad-96d5-4469-a382-8b61ff042762, 'Excellent gâteau. J''ai délayé la pâte avec un peu de lait, j''ai mis 100 g de sucre et deux sachets de sucre vanillé. J''ai également mis deux carrés de chocolat au cookies. Pour la cuisson: 50 minutes suffisent pour que le gâteau reste moelleux. ', '2016-01-23T16:06:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 226db04e-bc11-42d5-bfd7-71f5d45b4db8, 'Incompréhension totale pour les commentaires dithyrambiques ! Le gâteau était lourd, peu savoureux, les goûts assez masqués malgré de bonnes bananes bien mûres et du chocolat de qualité ', '2015-08-18T10:38:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, dc1fb880-f2d4-4f86-9795-e1aa2f93646c, 'Excellent on s''est tous régalé !!! J''ai divisé par 2 les ingrédients ainsi que la cuisson et ajoute du bicarbonate , il était très moelleux ', '2015-07-19T21:27:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, bc60677f-2d1c-413d-9dce-1d3c348f2346, 'Le gâteau est un délice, merci pour la recette   ', '2014-07-24T14:23:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, f421f34c-862a-467e-b0f6-70e1bbb873c7, 'Délicieux ! A refaire le plus de fois possible !!! (Il faut effectivement ajouter une banane à la recette)', '2013-12-17T22:33:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 01d9210a-9353-479f-8c78-723caf63c8d4, 'Très facile à faire (fait avec ma nièce de 6 ans) et on sent bien le gout de la banane. C''est un régal ! J''ai mis 3 bananes écrasées + 1 banane coupée en tranche sur la couche de chocolat.', '2013-08-17T11:33:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, cb8170f0-3445-444e-8dd1-3848918cecf7, 'Je n''ai rien changé à la recette, il a fait un malheur. Vraiment excellent, à refaire sans hésiter. 5/5 ', '2013-07-22T21:03:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, e7b0d9f9-6bdd-416a-8446-df354c840f2b, 'Très bon au goût, par contre pour moi le temps de cuisson est trop long et pourtant j''ai fait cuire 50 min. Mon chocolat de la dernière couche à brûlé ! J''ai mis 3 bananes au lieu des 2 initialement prévues.  A réessayer mais peut-être en mettant le four à 150°.', '2013-03-19T13:20:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 56dd2f40-906c-418b-8743-ad49c23c03d7, 'Une vraie tuerie ce gâteau !!! J''ai juste mis 4 bananes au lieu de deux  et fais fondre mon chocolat dans de la crème fraiche, sinon, je n''ai rien changé à cette recette, sûre que ça ne sera pas le dernier de la saison hivernale !! ', '2012-11-21T10:51:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 71c263fa-dd89-4d0d-989d-e3f4ef1c7d09, 'J''ai ajouté de la crème dans le chocolat pour qu''il ne durcisse pas trop en refroidissant. Et j''aurai du mettre une banane de plus que dedans la recette. Sinon très facile à faire, et délicieux !', '2012-08-01T21:08:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, ef0c2c96-6e56-4b4e-abe0-381948c61660, 'Succès monstre pour ce gâteau extra. J''ai rajouté du lait à la pâte, un peu de crème fraîche dans le chocolat et quelques rondelles de banane au dessus de chaque couche de chocolat et sur le dessus du gâteau. C''était excellent! Je le refais demain ! ', '2012-07-14T23:05:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 80a4c138-63e6-4755-bec2-142b72228f62, 'J''ai fait la recette telle quelle (juste ajouté un peu de lait à mon chocolat fondu pour le rendre plus liquide)-> Une tuerie !!!! Trop trop bon !!! A faire et refaire.', '2012-06-19T22:39:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 24898a3d-fd86-4269-8c06-e4bf1fb66861, 'Ayant lu les commentaires avant de commencer la recette, j''ai donc ajusté les proportions : 125 g de beurre, 200 g de farine et 120 g de chocolat noir. J''ai mis les bananes coupées en rondelle par dessus le chocolat fondu, dans lequel j''ai ajouté une poignée de noisettes hachées et une cuillère à soupe de rhum ambré. Par ailleurs, j''ai également ajouté deux bonnes cuillères à soupe de crème fraîche pour le moelleux et 10 cl de lait. Il ne faut pas que l''appareil soit trop compact mais onctueux et un peu liquide (pour l''incorporer dans le moule en plusieurs étapes d''ailleurs, c''est bien plus facile). Heureusement que j''ai diminué les proportions car un peu avant la fin de l''heure de cuisson, ça a commencé à déborder. Résultat : pas trop mal, un bon gâteau moelleux et parfumé mais à mon goût, le chocolat est très fort en bouche. Optez plutôt pour un chocolat noir pas trop fort en cacao et sucré, ou alors un chocolat au lait de qualité. A tester avec du praliné, pourquoi pas. On peut mett', '2011-05-08T20:58:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, e936ce48-6c57-4a83-89bd-35d8140c041c, 'Malgré les commentaires, j''ai décidée de faire la recette comme indiquée, j''ai juste ajouté des tranches de bananes au milieu. A part mon chocolat qui était trop épais (surement dû au chocolat que j''ai utilisé) auquel j''ai ajouté un peu de crème fraîche et un peu d''eau, tout a bien marché pour moi, le cake a bien levé, certes un peu lourd (mais mes bananes n''étaient pas très mûres donc une purée plutôt épaisse) mais il a été très apprécié par moi et toute la famille ! Au moins, une part suffit à se caler ! Je garde cette recette car la différence de texture entre la pâte et le chocolat est très intéressante !', '2011-02-01T11:49:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 2f4d4c4e-313a-404c-bec8-650588e882a9, 'Super fondant pour le goûter des enfants et des parents. Délicieux goût de bananes ! Je le fais souvent car il est facile à réaliser.', '2010-11-13T15:41:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 09cecb02-b8b2-4b6a-960b-837044bb6bb8, 'Trop facile à faire et très bien expliqué et bien sûr trop bon ', '2009-04-04T18:40:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 70e34031-8ec1-4091-85f9-087258fe851e, 'Gâteau facile à faire mais un peu déçue car le goût de banane n''est pas assez mis-en valeur. la cannelle ajoutée sous vos conseils à eu du succès et globalement le gâteau aussi. Avec de la glace à la vanille il ne paraît pas si compact que nature.', '2009-01-15T01:31:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, f91233c6-aee1-4c82-8823-09cddf6f9867, 'Un délice !!! Gâteau très moelleux ou l''on retrouve bien le goût de la banane sous le fondant du chocolat...et en plus très facile à réaliser.', '2008-12-04T19:10:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 6fd1c835-eb1e-4ed6-9f84-a835685316fd, 'Je n''ai pas trop aimé ce gâteau car je l''ai trouvé trop sec (et pourtant, j''ai diminué de 25 minutes le temps de cuisson) et je n''ai pas aimé la banane. Si je dois le refaire, je mettrai moins de farine (150 g). Je partagerai la pâte en deux pour faire une partie banane, vanille, noix de coco ou amandes et l''autre partie au chocolat comme pour un marbré. Et je ne le ferai cuire que 20 minutes (four préalablement préchauffé).', '2008-02-07T15:10:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, f063694b-1fca-42ae-914f-cca202ce8e7d, 'Très bon gâteau mais meilleur avec moins de farine (200g), j''ai ajouté aussi un peu de lait et il est fondant à souhait. Au lieu d''écraser les 2 bananes, gardez-en une coupée en rondelles que vous ajouterez par dessus le chocolat. C''est sympa de tomber sur des morceaux de bananes lors de la dégustation. Avec un glaçage au chocolat et des rondelles de banane en déco, ça fait un super gâteau d''anniversaire, et les enfants adorent.', '2007-11-27T15:25:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 8f546d3a-cb9c-47a0-aff9-d58ec905560a, 'Très bon gâteau et simple. J''ai mis qu''une banane parce que j''en avais qu''une et c''était bon quand même.', '2007-10-21T18:17:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 7b42ee51-e8c2-40da-908b-0f558649b197, 'J''ai mis moins de beurre parce que je n''en avais pas assez (environ 120 g pour la pâte et 10 g pour le chocolat) et j''ai rajouté de la noix de coco en poudre par dessus le chocolat. Mon mari en est tombé par terre, ce gâteau tombe dans nos favoris, on le refera c''est certain! ', '2007-10-17T19:38:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 7a4cf3d9-5a2b-44b5-9265-30cd669629b1, 'Trop gras, trop sucré et trop de chocolat. Ce gâteau est trop lourd pourtant, je n''ai mis que 120 grammes de beurre.', '2007-05-07T19:48:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 364b223f-c73d-4bd9-906e-5681fa49c363, 'Simple et rapide: un pur délice!!! On ne peut plus s''en passer et les collègues de boulot non plus!', '2007-02-05T14:32:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, b3f6ce59-2441-4821-89a0-b8537f82c599, 'Excellent et rapide à faire. J''ai remplacé le chocolat par 100 g de pépites, je trouve cela  plus facile.', '2006-10-20T13:03:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, a13386d9-42ab-4f29-b105-b88027719482, 'Bonne recette de gâteau, faite avec trois bananes et effectivement moins de beurre. J''ai rajouté deux cuillères à café de crème fraîche épaisse dans le chocolat ( et de la cannelle, très bon conseil!), que j''ai versé en une seule fois à la moitié du gâteau (les tiers et les quarts, c''est compliqué !). pas de problème de gâteau friable ou de démoulage à faire !', '2006-05-02T21:21:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 968dcec6-9577-4172-acc8-764dfb3bcbac, 'Bon, mais trop sec. J''ai mis moins de beurre comme c''est conseillé dans les commentaires et j''ai remplacé la moitié de la farine par de la maïzena. Difficile à démouler, le temps de cuisson est peut être trop long ?  Je le referai quand même! ', '2006-04-26T23:10:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, ce116e30-126c-49f1-bc9c-9e20947b99b6, 'Très bon malgré bien je n''ai mis que 2 oeufs! Et la prochaine fois je mettrais moins de beurre! Mais sinon excellente recette. Merci.', '2006-02-25T19:39:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, d19b5fad-2277-4b30-9608-bdb616649db8, 'Délicieux et facile à faire. Je n''ai rien changé à la recette, j''ai juste rajouté un peu de cannelle au chocolat fondu. Je n''ai eu aucune difficulté à le démouler et le mariage du chocolat et de la banane est parfait. Il a plu aux petits comme aux grands.', '2005-11-12T09:53:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 31dd5d91-5905-46fd-ac87-b58065c86a18, 'Ce gâteau est devenu un de mes classiques, il a toujours un franc succès. Je ne mets que 150g de beurre et lorsque je le fais pour des enfants je remplace le chocolat fondu par un peu de poudre cacaotée riche en cacao, c''est moins fort en chocolat, ils en raffolent!!', '2005-08-25T17:39:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 11a14ab6-5bc7-4075-999b-ba9d21c400ce, 'Excellent, un régal merci.', '2005-05-19T21:05:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, e5f5d103-5d2c-4235-a075-c4dd66af944b, 'J''ai mis seulement 150g de beurre dans la pâte et j''ai fait fondre le chocolat avec 50g de beurre. J''ai ajouté un peu de la pâte à la banane au chocolat de façon à obtenir 3 tiers égaux (2/3 banae, 1/3 chocolat).  Puis j''ai mis la pâte au chocolat entre les deux tiers à la banane dans un moule couronne. Cuisson un peu juste, démoulage délicat, mais le résultat a été un gâteau façon fondant au chocolat au milieu. Un délice moelleux et tiède. Par contre le reste était compact le lendemain, mais les goûts de banane et de chocolat sont bien équilibrés.', '2005-05-12T12:43:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 1d592338-a585-4ef0-ae32-a5db5b99d071, 'Délicieux! J''ai seulement diminué les doses de beurre et le temps de cuisson et le succés a été garanti, un régal vraiment.', '2005-04-26T16:18:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 67a0a593-45be-4272-a9d7-5f8e70af96f0, 'Je n''ai pas superposé les couches, j''ai tout mélangé et j''ai trouvé le résultat excellent et très moelleux (ma petite soeur aussi!).', '2005-02-08T19:23:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, d4ee1634-bd3a-499e-a733-d72455b0c26f, 'Le goût est bon (j''ai rajouté du rhum et une pointe de cannelle), les invités ont adoré mais dieu que c''est lourd et compact !!!!', '2005-01-10T12:47:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 6cf9b1cd-8ee8-4212-96ab-e2a2f79859d1, 'Même en suivant les conseils des internautes, rien n''a marché: pas cuit au bout d''1h30 et le chocolat s''étalait mal...', '2004-07-16T10:46:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 58b1cd29-d304-4ef5-a8ec-8293936a501e, 'Délicieux! Dévoré presque entièrement par cinq personnes, c''est dire! Cependant, 125g de beurre suffisent largement... Nonne idée pour la cannelle, tout le monde a apprécié!', '2004-05-24T22:52:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 5f134c5c-11c8-42e9-90c3-2165495b219d, 'Super bon!!! J''ai mis un peu moins de beurre, c''est déjà très riche... Et j''ai ajouté un peu de cannelle dans le chocolat fondu: succès garanti!', '2004-05-18T17:05:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, d45e0409-58ea-4ce1-b5a4-d91af957f98f, 'Délicieux!! Je n''ai mis que 150g de beurre et je l''ai fait cuire moins longtemps mais dans un moule à cake en silicone. Du coup, je n''ai eu aucun problème pour le démouler. Le gâteau était moelleux et le chocolat encore fondant!!!', '2004-05-14T15:38:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, bbc6add1-c763-4ae5-9c78-3e8731c694ef, 'Gâteau très facile à faire et délicieux. Je conseille de le démouler tiède, pour éviter qu''il ne se casse.', '2004-04-15T13:03:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 60fbb14b-2a1e-4e2e-ba47-549c5d4162d6, 'Super bon! Il n''est pas resté plus de 10 minutes sur la table... De plus, il est très facile à faire!', '2004-04-07T18:29:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 3587e7e5-610b-44ef-b3ba-4f83f09a5057, 'Super bon !!! Le temps de cuisson un peu long, malgré la réduction (juste un peu, faut pas exagérer  ;o) de la dose de beurre il se tient pas très bien mais c''est un régal !!!  :oD', '2004-03-01T20:56:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, e39c7cdd-cf36-47b9-875e-6eee52419515, 'Excellent! le mélange banane et choco est extra. :)', '2003-04-01T18:44:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, ee13a576-bdb0-4c4a-9e29-4a00537923fc, 'Bon, mais j''ai trouvé ça un peu trop sucré. Néanmoins, tout le monde a adoré.', '2003-03-08T11:41:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, b695586a-bf46-4e59-a819-00fd8a29ca7d, 'J''ai trouve ce cake beaucoup trop gras... A cause de cela, il se casse lorsqu''on le découpe.', '2003-03-08T11:11:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 3dddeeda-810b-48ad-bb1e-47dda39b654e, 'Simple à faire et très bon, mais un peu sec. Il faut peut-être le laisser moins d''une heure au four...', '2003-03-04T14:27:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21200, 6c9653cf-2665-4b3b-a3e4-731e6df7a58d, 'Hummmm, un régal! Tout le monde en redemande. En plus facile et rapide à réaliser. Par contre il faut lutter pour ne pas se jeter dessus dès la sortie du four à cause de l''odeur de crêpe chocolat-banane qui se dégage pendant la cuisson...', '2003-03-04T11:20:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 004bb8d0-c1ea-4fb0-86fa-ff48abd768a4, 'Très bon, comme dans tous mes desserts, je diminue le sucre, entre 80 et 100 g, largement suffisant.', '2022-12-20T10:41:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, bd0a8f4e-cb52-4634-acac-e494a4bf48fd, 'Un crumble très équilibré sucré et acidulé. La canelle est très gourmande et s''accorde parfaitement avec les fruits', '2021-02-12T20:36:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, ea72a9b1-4356-41e1-98c5-e4beddaca2fa, 'Excellente recette merci ', '2020-03-27T20:38:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 831e3cf4-2e3f-4afc-851b-290e7e12fd6d, 'Bon, jai fait poêler les pommes légèrement écrasées avec sucre et cannelle avant de les mettre dans le plat.', '2018-02-24T04:06:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 25c6988a-3f54-4c2b-a82b-1c5bb9b7aa1b, 'Très bonne recette. Tout le monde a apprécié.', '2016-03-04T13:51:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, a7ecabe7-213f-494d-a8cc-bab1f2667eb4, 'Au top', '2015-05-07T20:45:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, d57ac87a-e48d-459c-8eff-6a3379b52bbb, 'Très satisfaisant ! Ce dessert évoque tous les fruits de la recette ! Nous l''avons mangé pour le nouvel an 2013 et il est succulent !', '2013-01-02T17:19:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 710302f2-93ac-413f-a019-99d2ffb4c63b, 'Ce dessert est une valeur sûre. La pâte est sablée comme il faut et simple à faire. La banane apporte la douceur et le fruit rouge l''acidité. On peut mettre plus ou moins de framboises pour contrôler l''acidité. Je mets 100g de framboise et 100g de myrtilles. C''est excellent, naturel et pas trop lourd.', '2007-05-24T16:57:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, f9138607-b538-466e-a585-4fa87298fed3, 'Excellente recette, goût de la cannelle assez prononcée mais a plu à toutes mes convives. ', '2007-05-09T01:00:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, fff938c1-0609-408a-8e06-281ac80202f0, 'Franchement délicieux, le crumble était croustillant. J''ai utilisé du sucre roux et servi le tout avec une boule de glace vanille avec des pépites de caramel. Cela a eu un franc succès!', '2006-04-01T23:04:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 21737a2b-2081-4b12-84b5-39bcff8d0050, 'Une vrai merveille. Beaucoup d''harmonie entre le sucré pomme/banane et l''acidulé des framboises. Mes invités ont beaucoup aimés. ', '2006-03-16T17:58:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 416c25ff-2ef9-4e5c-9cd7-384536808ec2, 'Délicieux, des notes sucrées et acidulées qui se marient à merveille ! J''ai utilisé de la cassonnade à la place du sucre pour un côté plus "croquant". A tester sans tarder !!!', '2005-04-07T15:25:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 88e7e43c-8546-4d40-9c27-5a467019653b, 'Pas mal! On peut remplacer la banane par des poires.', '2004-10-06T14:02:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43536, 9ac2e40d-8af7-4fcc-b873-cfa7dd843a57, 'Très bon plat. Plein de saveurs qui s''associent bien.', '2023-03-24T22:09:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43536, b5cdf533-4576-4112-b120-8ec38e5e11f2, 'Trop trop bon !!! A refaire ! J''ai suivi la recette à la lettre sauf que j''ai pas mis du romarin ni de noix de coco râpée, ce qui ne change pas grand chose à la recette car c''est super bon. Le temps de préparation est un peu moins de 2h, je pense plus vers 1h30 maximum car pendant les 45 min de cuisson, on peut préparer les bananes et ananas. Les proportions sont impeccables. Merci beaucoup pour cette fabuleuse recette facile à faire.', '2017-04-03T18:08:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43536, 1983f1f7-55ed-43b8-ae7a-065af8a5073f, 'C''est très bon et simple à faire. Merci !', '2015-03-22T21:08:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43536, 65888aa9-2384-4036-8a78-352ccb92c843, 'Super facile à faire, un sucré salé qui renverse les papilles.', '2011-05-08T16:09:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43536, 8657b588-20d8-47cb-b806-61f92431f440, 'Un peu fade...(manque de raisins peut-être)', '2007-10-20T16:43:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (43536, 5d653858-f1ca-46db-b9d1-fe099dc6120b, 'Je l''ai testée plusieurs fois, c''est très bon si on aime le sucré-salé.', '2007-02-28T22:26:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 266dc64f-5755-48fc-ba1a-616d0ac46385, 'Pour une présentation plus soignée, faire ramollir une à deux feuille(s) de gélatine puis les faire fondre dans un peu d''eau et les rajouter au mélange. Faire saisir le tout au frigo pendant plusieurs heures dans des ramequins individuels. Et rajouter au moment de servir les dés de poires préalablement compotés sur la préparation. Sans cela le dessert ressemble effectivement à du gloubi-boulga d''enfants!', '2006-06-14T16:30:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 84dcaa80-331b-489d-812e-42c504c480fa, 'Avec 2 feuilles de gélatine et sans les poires, c''est un 5 sur 5 ! Frais, léger, servi avec les cookies "tout chocolat",  c''est original et peu cher,  adopté. Merci pour cette bonne idée !', '2017-05-07T15:01:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, d815f735-3b7f-45ba-be24-ced93376bc81, 'Succulent, on ne sent pas l''acidité des petits suisses.', '2016-05-06T14:21:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 4fe80e78-2dd7-4045-8ad8-0579fc54f60d, 'Facile à faire mais c''est plutôt un smoothie.', '2014-08-25T02:30:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 4c91d78f-16f2-43a7-9544-2107f01e78ef, 'Très bon, je suis resté sur les bananes et le jus de citron en ajoutant 2 feuilles de gélatine. Je les ai présenté en ramequin individuels laissés au frigo pour que cela prenne bien.  Déco avec des rondelles de banane et des copeaux de chocolat.', '2013-12-26T19:13:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 83810889-dd4d-42cb-a237-34662148d0e7, 'Ce n''est pas du tout une mousse... plutôt un smoothie. J''ai remplacé les poires par des abricots, le mélange est excellent.', '2013-09-01T22:32:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 03ccbc92-0467-430f-be6b-6c4169f51e02, 'Je l''ai faite hier pour une repas entre amies. Elles ont été surprises tellement c''était bon. J''ai mis 3 bananes, du citron et 2 gouttes d''huile essentielle d''orange douce (une goutte peut suffire, je pense), et enfin un peu de gélatine. DIfficile d''arriver à l''aspect "mousse" mais le goût est rafraichissant et très agréable ! Je pense que la mettre 1H au congélateur (je n''en ai pas...) serait une très bonne idée pour l''aspect "mousse". ', '2013-02-10T15:08:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 0a56da24-dbf0-4995-90ff-c0dfe6c1fed1, 'Elle n''a pas la texture d''une mousse mais d''une crème !!! Un peu écoeurant à la longue.', '2009-06-26T12:48:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, d079ab6d-a781-4b09-81a9-c6d770331503, 'C''est bon, rapide et facile à faire. Je n''ai mis que des bananes et comme je n''avais pas de crème double, j''ai remplacé par de la crème à 30% de MG. Par contre j''ai mis la préparation au congélateur jusqu''à obtention d''une consistance semblable à un milk-shake...', '2009-05-30T19:49:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 2ea814f7-4959-48ae-8fd4-6251a27e8e69, 'Un peu sceptique en voyant certains commentaires mais je me suis lancée: sans regret! En ajoutant du jus de citron jaune en bouteille et 2 feuilles de gélatine à la préparation, j''ai laissé prendre au frigo dans des coupes de glace. Les premières ont été dégustées quelques heures après, le reste le lendemain (soit 24h après!). Merci pour ce dessert très simple.', '2008-09-30T13:37:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 739dbb20-4f9e-4106-ab08-d6599e0993c6, 'Je n''avais pas de poire donc je n''en ai pas mis. On a mangé une première partie tout de suite sans réfrigérer et c''était délicieux. Par contre j''ai voulu conserver le reste pour le petit déjeuner, et la mousse avait noirci (en 12h).', '2007-09-01T22:32:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 9a4c3f26-b301-4794-8b31-55699513e1a6, 'Je n''ai pas mis les poires mais j''ai remplacé les petits suisses par du fromage blanc (faute de mieux en réserve) et j''ai tout mis dans mon mixeur quelques secondes, super rapide et pratique cette recette. Ma fille a enfin mangé de la banane.', '2006-06-26T20:45:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, a27de8a6-1144-4e70-980a-b656cec3ee09, 'Cette mousse est bonne mais pas exceptionnelle, la poire n''ajoute rien à celle-ci bien au contraire...A envisager plus comme quatre heure que comme dessert.', '2006-06-19T14:07:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, c592d0be-fb6e-4513-9446-8be369d28efb, 'Pour améliorer ce dessert, y rajouter une mangue, des pêches et remplacer par 2 yaourts natures et aucun sucre... c''est bon! ', '2006-06-17T16:45:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 8e2e13b2-d3a7-4ed4-867e-ec21cfd9cfab, 'Super bon! Ultra rapide, ultra facile, ultra économique ! Donc 5/5 ! Je n''ai pas rajouté la crème double car c''était déjà nickel avant que je passe à cette étape ;o)  L''aspect ne fait pas forcément raffiné de but en blanc mais on peut mettre cette "mousse" dans de petits ramequins avec trois p''tites rondelles de bananes sur le dessus, quelques copeaux de chocolat et c''est parfait !  ', '2006-06-12T20:28:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 4e278ae2-c4a4-41d8-8c02-ef2c796f4514, 'Bon, mais c''est plutôt un dessert pour les enfants... Simple et rapide à faire.', '2004-04-20T11:26:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, d2b12279-d397-4596-b21e-eb59bc2c82ea, 'La saveur est bonne mais l''aspect trop liquide, pâteux, peu présentable. A faire pour le goûter, pas pour un dîner chic!', '2003-02-26T10:36:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 16bfbb03-ebd7-4f88-9707-f743b185a678, 'Un pur délice! Merci pour cette recette simple et économique!', '2003-01-21T13:48:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 20fe5f28-65cf-4add-ad14-6a9574a1a73b, 'Super bon, très frais et original... Peut-être plus savoureux si on ajoutait un peu de jus de citron pour relever le goût de la banane.', '2003-01-17T17:19:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 8fae6718-9fd0-41d3-840c-41082ee40fff, 'Délicieux.', '2002-09-05T08:54:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 186d3a5d-a4f7-4d03-95ba-cf7fe71165a0, 'Super simple et vraiment délicieux.', '2002-08-31T17:47:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 68cb8f60-7b8d-45cc-a604-a213bfbffa35, 'Très bon. Je n''ai pas mis les poires non plus. Les bananes se suffisent à elles-memes. A consommer très frais.', '2002-06-03T14:22:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, a5b3fa68-c002-4859-8076-188b39df0fc1, 'Très bon, mais un peu trop sucré à mon avis. C''est encore meilleur en mettant un peu moins de fromage et plus de crème montée en chantilly. Un régal pour mon mari!', '2002-03-05T10:18:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 141a576c-f964-480a-8b12-fe4fc06493e9, 'Quand les bananes ont la fâcheuse tendance à dépérir dans le fond du frigo...', '2001-04-28T10:39:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13388, 1f931b92-077e-458a-9ea8-a730f9e329bb, 'Quand on adore les bananes c''est exellent, mais les morceaux de poire sont presque inutiles.', '2001-03-03T15:40:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41240, b331d134-8e8d-43c7-8fcd-73fe32130826, 'Je l''ai doré avant de le mettre au four !', '2017-10-12T11:23:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41240, 8a93ddcb-6033-4dc9-90f8-8510b4df7978, 'Délicieux !', '2015-09-02T21:32:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41240, 113fb205-4db1-4ee0-8101-38c4ff4466b2, 'Mon mari n''aimant pas la banane cuite, j''ai remplacé par des pommes et ajouté deux cuillères à soupe de poudre de noisette pour faire ressortir le Nutella. Miam, à refaire sans hésitation.', '2011-03-24T11:11:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41240, 447f02dd-fed6-40e8-a825-dcf4b9963516, 'Super idée en galette, et en plus très simple pour la faire réaliser aux enfants.', '2008-12-18T21:19:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41240, 817a7bce-7a0a-41a4-90e0-402b2ccaf5b8, 'Bon, facile, j''avais au préalable réduit les bananes en compote cuite 5 min avec un peu de jus d''orange et de la cannelle.', '2007-10-29T13:53:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41240, fc2d1af9-1c1b-47df-924a-3e48a1534f11, 'Tout le monde me demande où j''ai acheté mon chocalat!!! Délicieux mais je préfére avec des pommes préalablement cuites à la poele avec un peu de beurre. Moins lourd à digérer que les bananes. Merci', '2007-09-13T20:55:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41240, 1f32a9ec-65e4-449d-b04a-6f50efdfacb0, 'Je n''ai pas aimé ce dessert, désolée chacun ses goûts.', '2007-07-26T03:45:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (41240, 6a1ba3b7-537a-4fc7-9a72-bebebd1130ec, 'Excellente cette recette, j''ai badigeonné d''un jaune d''oeuf les chaussons une fois fermés, pour leurs donner une belle couleur dorée!!!', '2006-02-21T21:50:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (227704, 021e4618-21d7-4b14-ac23-90fa3b77cf88, 'Super bonne.. un vrai délice. Assez sucré du fait du lait concentré mais fraîchement jne tarte délicieuse', '2020-06-23T14:47:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21415, f00c2c92-9446-4e69-8006-3e729e43b76b, 'Recette simple et qui fait son effet... Le rhum est parfaitement dosé et apporte son parfum sans écraser le reste. Ne pas prévoir un repas trop lourd auparavant.', '2006-02-05T23:31:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21415, e474dddd-2ad3-4c4d-92a0-df363b58b9cd, 'Dans la préparation, j''ai mis 2 oeufs entiers (le goût de l''oeuf ne me dérange pas, au contraire). J''ai mis 3 bananes au lieu de 2.', '2005-07-24T17:45:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21415, 552a3b38-303e-42c9-868d-a81626be9279, 'Cette recette est assez légère, elle passe bien après un bon repas. les invités ont beaucoup aimé, nous aussi. Cuit dans un plat transparent, c''est beau et c''est bon.', '2005-04-20T20:53:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (21415, d4cc052c-a138-404f-b94a-0661522b2af6, 'Pas si léger que cela avec 5 oeufs... Bon, mais le goût de l''oeuf est trop prononcé dans la pâte à remettre sur les fruits.', '2003-03-31T14:37:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49366, d44f429d-b60d-4e7a-b692-6c0c6e337e2c, 'Super bon ! Un régal !', '2014-06-08T00:48:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49366, 80bfa8ae-5907-40d1-8de4-6f499551d62d, 'Un vrai régal cette glace à la banane !!! A refaire rapidement ...', '2013-08-10T21:02:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49366, 7c0466aa-3d02-4732-907a-dcd43225de1d, 'Très bonne recette de glace à la banane ! Merci.', '2013-07-10T21:48:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49366, cd7e6bed-1a34-4687-ae93-2810ef34f693, 'Super ultra bon.', '2013-04-13T10:25:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49366, 0b849861-bfde-4d5b-aea9-59c3c811439d, 'J''adore', '2012-06-16T18:32:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49366, 144f77d9-85a1-4c4f-a02d-1de9d6c22618, 'Rapide, super facile et très bon. La finesse reste dans le dosage de la cannelle. Les enfants vont adorer !', '2011-10-11T02:00:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49366, 9737901a-c03a-4b8a-b52c-f20809a9ad97, 'Recette excellente, faite avec mes enfants qui ont pu facilement participer du haut de leurs deux et quatre ans. Dégustée le soir même, avec leur papa qui a été conquis (lui qui n''aime pas les dérivés de la banane!!), accompagnée de chocolat fondu avec un peu de crème fraîche !! huuuummmm', '2009-02-24T23:00:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (52418, b68722eb-4b49-4dbd-b9e3-cb06743be560, 'Cette recette est délicieuse mais je pense que ce n''est pas un plat ni une entrée mais un délicieux dessert. Je l''ai donné à des jeunes enfants qui l''ont vraiment bien apprécié. Mes enfants me demandent de refaire cette recette que je ferai certainement. Peut se préparer quelques jours à l''avance vraiment pratique pour un goûter ou un en cas.', '2008-08-18T15:30:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530775, feef63d7-867c-4566-b50e-01352631fb29, 'C’est vraiment trop bon mes enfants adoré!🤩😉 merci beaucoup pour la recette elle est top!😁👌', '2021-04-28T19:08:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335772, db53de0b-55b9-4f14-ae76-15d0207dd3b1, 'Il me manquait quelques ingredients comme le rhum , l''huile et les pepites de chocolat donc j''ai adapté et ai reduit le sucre car j''avais 3 bananes très mûres. Et ce fut parfait !!!
Plus healthy du coup mais très bon avec un super coté moelleux !', '2020-04-21T17:38:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335772, 25e649b9-995c-4644-b5cb-f4d9ce3cc2a0, 'Gâteau super moelleux !!! Vraiment très bon !!
J''ai suivi à la lettre et ai juste parsemé de pépites de chocolat pour la déco ;)
Je le referai !!!', '2019-09-26T10:59:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335772, a70b0f68-7ebf-4ed0-a545-ecb068098e04, 'Juste délicieux!! à refaire...', '2018-08-18T11:45:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335772, 7ed66494-c54f-489e-b9ac-e34bffd96f01, 'Recette facile, rapide et resultat trés bon.', '2018-05-19T10:41:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335772, e3fe1417-4d35-4a99-89e2-1cf2963ae66e, 'Très bonne recette !', '2018-04-16T06:40:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335772, 44764d4a-11a8-487f-8aaa-dcdce01eda85, 'Super recette ! Le gateau est super moelleux !
Personnellement j''ai rajouté un glaçage au chocolat blanc a la place du sucre glace !', '2018-02-06T12:49:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335772, 892364a8-9d04-43b6-9450-cc850f1b9b37, 'Très bon.', '2017-09-22T00:08:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335772, 5bc876a8-dc94-4246-9ba8-bdf9d5e61505, 'La meilleure recette de gâteau à la banane que j''ai pu réaliser ! Le gâteau est bien moelleux, pas lourd, pas sec. Vraiment très bon ! Ça va faire la 4e fois que je le fait depuis le début d''année. En revanche je ne l''ai jamais fait avec le jus de citron car j''en avais tout simplement pas à la maison', '2017-07-17T11:54:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335772, 581e5ea1-9f9f-4d10-a847-ab36e2b2a5b3, 'Bof.', '2017-03-27T23:02:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335772, 6a511f6c-73d9-4848-b296-8e7ef36148e9, 'Merci pour la recette facile à réaliser et bonne (elle va rejoindre mon cahier de recette). Le gâteau est très moelleux et bien équilibré.', '2015-04-26T17:07:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37358, 3b5722fa-bab5-41f0-9445-1a230d2eac8e, 'C''était très bon, j''ai remplacé la papaye par de la pêche parce que la papaye ce n''est pas la saison.', '2010-04-11T23:05:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37358, 95d9b424-202a-44f9-9d01-f1f060be8d46, 'Bien ', '2021-04-10T15:13:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37358, 3ea46de5-c153-4222-aac8-62b72152096b, 'J''ai remplacé ananas et papaye par un mélange de fruits exotiques au sirop (ananas, papaye, goyave, ramboutan). Pour simplifier, j''ai ajouté le sucre  et le kiwi (jaune) en demi-rondelles directement dans le plat et servi, comme suggéré, avec une boule de glace vanille et une tuile aux amandes. C''est très bon !', '2011-11-05T22:37:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37358, ce6e7434-c20a-4d3d-9bb5-f85adce57ec6, 'Mon mari qui n''aime pas la salade de fruits a trouvé celle-ci excellente, il en a même repris. Plus économique avec une salade de fruits toute prête, c''est bon très aussi!', '2007-05-21T12:38:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37358, a09c0297-cf12-4421-9922-632d2822a598, 'Délicieux! Je remplace parfois la boite de papaye par une boite de melon.', '2006-05-11T19:03:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80238, ab03d2b7-d749-4ef2-af98-256ef9b94ed0, 'Il ne faut pas mettre autant de semoule. 100 gr suffisent. Le goût est bon mais cela n''est pas une merveille !', '2018-04-28T15:59:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335539, 510c4522-8570-4e9d-9966-d1d7e342d217, 'Recette très bonne ! Et très belle aux yeux pour ma part je mets du fromage blanc basique de bonne qualité et moins de sucre ', '2021-02-16T08:44:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335539, 38013bc7-c21d-4dca-8c45-099f04711b10, 'Beaucoup de succès avec ce cheesecake. Je vous le conseille sans modération.', '2016-10-19T00:28:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335539, d8b27a5c-7111-40d0-8cad-3a7f74f5d717, 'Excellent !!', '2016-01-27T17:25:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (335539, 22cb0760-e8d9-48d4-a625-2711d95a0d7d, 'J''ai fait cette recette avec du cottage cheese. Tout le monde a adoré.', '2015-05-12T11:21:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73600, e6c5444a-795b-488a-aadd-4406d67ef05c, 'Très bon smoothie ! J''ai rajouté du citron pour éviter que la banane ne noircisse.', '2013-07-09T14:22:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73600, 70ef13dd-8d81-458f-b458-e1f90d0cfef0, 'Très bon et très frais.', '2013-06-07T20:26:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47429, 15320b68-0d1f-408f-82e3-e02442c021e9, 'Excellent dessert, frais après un bon repas et surtout rapide.', '2008-03-03T10:12:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47429, 1fdc9887-22b0-4cd7-bc91-e327ec050d39, 'C''est bon, mais je n''ai pas réussi à faire de jolies corolles avec les bricks (impossible de mettre les fruits dedans ). La prochaine fois, j''en achèterai des toutes faites !', '2011-02-23T19:00:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47429, b1e48d58-45f3-4eb0-964b-3cbcbb70b43d, 'Merci pour cette recette très facile et appréciée par les convives.', '2009-05-03T23:07:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47429, e8ae9886-ceb3-4234-b65f-d0f00c0264c2, 'Remplacer les feuilles de brick par des crêpes.', '2009-01-03T12:15:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47429, 690f24af-e7b8-4cbf-99ce-9231d3c2baa6, 'C''était bon mais sans plus! C''est vrai que c''est rafraîchissant...', '2008-05-31T18:06:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47429, f48bc6bb-4139-4825-8e65-02028ec79e73, 'Très bon. Adapté avec les fruits du compotiers (poire, pomme, banane, 1 boîte d''ananas) et servi avec sorbet poire. ', '2008-03-07T10:51:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47429, 17a87e99-c61f-47ac-8cd8-a8be67f0bb00, 'Tout simplement délicieux et très frais. Très leger comme dessert aprés un bon repas et vraiment très simple à faire.', '2007-11-13T19:28:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47429, fe702b27-3d24-4980-816a-d7d57891ea5d, 'Très très bon. Dessert léger. J''ai remplacé l''ananas par du kiwi et rajouté quelques framboises mais peut se faire avec n''importe quel fruit. Par contre, je n''ai pas mis de rhum. Servi avec une boule de glace vanille et du coulis de fruits rouges directement dans les ramequins, c''est exquis. Miam miam !!', '2007-10-27T12:41:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47429, 127177d1-c496-48e5-8240-ebeb086f3c4b, 'J''ai modifié la recette. J''ai fait mariner au frais des petits cubes d''ananas frais et de kiwi dans le rhum et le sucre et servi dans les collerettes de feuilles de brick (à garnir au dernier moment) avec des physalis, du coulis de framboises et une boule de glace au rhum/raisins. MIAM!!!', '2007-04-29T12:21:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (47429, 9d03e28f-ea16-4ab2-8725-89d9c9cd44f5, 'Super! Je n''ai pas cuit les fruits (j''ai pris de l''ananas et de la banane) et une boule de glace à la framboise, extra!', '2007-03-04T14:43:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (60376, 99de1775-bc7c-4075-81ea-0f89a31340d1, 'Bof bof bof', '2016-12-16T12:17:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533439, a2dc2864-4f6c-49ee-a0b2-316e138cd17b, 'Excellent  comme toutes les recettes de Laurent Mariotte😋🍌🍽', '2022-04-04T13:33:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533439, 12e9bfdb-0f17-4e7c-9c1f-ae2b49a1c103, 'Super bon, moi qui n''aime pas les bananes trop mûres ! Là, c''est top, hum...', '2022-06-12T13:34:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533439, 0259dc9c-43c9-4249-9279-9301d61506c1, 'Rien à rajouter 👍 parfait tout simplement ', '2023-02-23T18:13:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533439, 937aa052-9e35-4377-ad53-6006e72444c8, 'Excellent, j''ai diminué le sucre par 2 mais j''ai ajouté des pépites de chocolat...un régal ', '2023-02-11T15:06:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533439, 699d176f-df50-4147-92c9-b3eda11ed56e, 'Recette simple - peu cher - facile à réaliser - Bien pour finir des ingrédients plus très beaux à voir, mais aucune perte. Bravo !', '2022-04-21T15:24:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533439, 822733d9-ebae-4ebb-bb94-b7dbd98e5595, 'Facile à réaliser, moelleux pas trop sucré.
C''est un régal de Laurent Mariotte évidemment. ', '2022-04-14T13:36:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (533439, 06f269bd-6cb5-4e8f-a64e-0d4a1379144c, 'Ma famille a adoré il fait partie des préférés !!
Ps j’ai suivis la recette à la lettre la première fois, la 2eme fois dans la préparation j’ai ajouté des pépites de chocolats pour plus de gourmandises ☺️', '2022-04-13T08:56:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13107, c8c9c7a1-9bc4-4e1c-aea0-74e93d09a161, 'Délicieux surtout en été. Il y a quelques années, je faisais très souvent cette recette en fin de journée. Ça m''a aidé à maigrir ! Tout en mangeant équilibré et même bien le reste de la journée.', '2013-06-26T18:40:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13107, 3a89b32e-cc09-48a9-a18d-378285daa55e, 'Simple, rapide et délicieux en accompagnement d''autres petits desserts. Très frais !', '2012-03-08T14:54:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13107, 860f4b87-93e2-4dd3-a9d2-7845688552d7, 'Très bon après un repas, en été rafraîchissant ou même à 4 heures.', '2008-07-29T12:28:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13107, 71196f82-b65c-4d38-b1f0-e0b967055e46, 'Très simple et BON! J''ai ajouté 1 banane en plus, 2 cuillères à café de sucre et 2 cuillères à café de sirop de fraise! Miam miam ', '2007-08-14T13:28:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13107, 174ad185-aad0-4579-804f-bfdcf54d4eb1, 'Super bon! Tous mes invités ont adoré lors de notre soirée menu mexicain... j''ai néanmoins suivi l''un des commentaire ci dessus, je l''ai accompagné d''un millefeuille aux fraises ! Ca a fait tout son effet !!! A refaire... mais peut-être en guise de goûter avec les enfants... ', '2007-03-26T19:12:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13107, 23c6750d-08d7-49d9-8144-ca5a8c6fa7aa, 'UN VRAI REGAL !!!!! et pourtant je ne suis pas fan des bananes... fait sans glaçons, je l''ai mis au frais toute la nuit avant de le servir et c''était très bon ! servi avec un millefeuille aux fraises (Marmiton bien sûr !!!) c''était PARFAIT !!!', '2006-05-27T11:34:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (13107, b4e74191-a0c6-48a0-b6f4-7cd51bd6e952, 'Je reviens tout juste du Mexique, et j''ai bu des icuados tous les jours, c''est à mourir! Je fais la même recette, mais sans glaçons... c''est plus onctueux!', '2006-02-27T23:44:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65398, 281d2137-eaca-4ee1-9cc8-20d94e84aefb, 'Dommage que le mélange pralinoise/rhum soit si ecoeurant. Je pense que c''est bien meilleur avec du chocolat noir. Ou sans rhum ...', '2017-06-12T16:50:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65398, 08acdea3-0197-4ae6-a152-95ffd9018752, 'Merci pour cette recette elle était très bien pour la soirée que j''ai organisé autour des îles.', '2009-03-25T13:10:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65398, 2e1c57e6-c286-43f2-b849-a2428696150a, 'Ce n''est pas mauvais, mais il n''y a pas de quoi se rouler parterre!!! Je suis un peu déçue!', '2008-09-26T18:52:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65398, 03df81ab-cd86-498c-8fde-f32cda990251, 'Plus facile, ça existe pas. Meilleur, c''est difficile. Totalement bluffant. C''est l''idéal si vous avez des invités inattendus comme ça m''est arrivé hier soir. Merci chouqs.', '2008-01-21T09:23:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11556, 3c9d071c-609c-44f7-81e7-4dc1e6100156, 'Recette vraiment délicieuse, j''ai rajouté un filet de citron vert sur chaque banane avant de fermer la feuille de brick, ça relève un peu l''ensemble... ', '2006-01-03T10:10:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11556, 7c1f77b7-f3e3-49e4-ae8a-f18709b562b6, 'Quelle recette délicieuse, par contre j''ai complètement raté la préparation. Bananes trop mûres, j''ai mis sur le dessus un jus de citron, qui a ramolli les bricks. J''ai refait la recette, toujours aussi savoureuse, par contre j''ai fait une mélasse avec le sucre, le coco. le jus de citron,  j''ai mis de la mélasse dessous et dessus de la moitié de la banane que j''ai roulé dans une feuille de brick entière. J''ai servi, avec un filet de miel, un régal. Un grand merci.   ', '2013-05-13T16:39:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11556, 79fb946f-7003-40bc-b5a1-c6c6d408a210, 'Très bon avec du sorbet au citron vert.', '2013-02-22T22:15:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11556, 8597c3bd-475f-4330-9db3-db77e3437ceb, 'Mmmmmmmmm euh trop bon même succulent', '2013-02-18T21:45:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11556, 221a1661-1fb3-41cf-9bcd-f804b09363df, 'A refaire mais sans le zeste de citron et la noix de coco essayer avec de la vanille !!!', '2012-03-18T18:42:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11556, 909005dd-ec93-4b25-9243-3f425ef3b7a2, 'Personnellement je n''ai pas mis de zeste de citron en revanche j''ai mis des gousse de vanille en poudre et légèrement de cannelle avant de refermer les brick et au final une fois la brick cuite un trait de miel sur chaque part et bien c''était succulent.', '2009-02-18T20:54:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11556, e49fa9e3-b1c3-46db-9232-d344e5c747a0, 'J''ai peut-être loupé quelque chose, mais j''ai été plutôt déçue, j''ai trouvée ça très sec et pas tellement croustillant.', '2008-02-15T11:47:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11556, 217bf023-9223-423c-8020-a50269665375, 'Excellent. J''ai ajouté un peu de chantilly et quelques fraises pour la déco.', '2007-06-05T18:13:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11556, ff2867aa-136d-4237-bdac-5be99e8d8db0, 'En fait, j''ai été un peu déçue... Je m''attendais à quelque chose de beaucoup plus crousti fondant. Attention, c''est quand même bon! Personnellement, j''ai rajouté 2 traits de crème anglaise sur chaque banane craquante, ainsi qu''une boule de sorbet coco.', '2005-11-14T16:48:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11556, 56e47fc9-b3f7-4ca0-8a55-36758ba0178e, 'Délicieux. J''ai servi une demi banane, par convives, et accompagné d''une grosse cuillère de sorbet mangue. Le sucre a été ajouté, au mélange coco citron vert, et les bricks ont dorés au four chaud, badigeonnées de beurre fondu.', '2005-09-25T00:55:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11556, 07471602-68ca-4de8-ab1a-50b8c0881872, 'C''est un dessert à la fois léger et croustillant. J''ai fait revenir les bananes avant de les mettre dans les brick, puis au lieu de mettre le sucre sur les brick aprés la cuisson, j''en ai mis sur les bananes avant de rouler la feuille. En tout cas, délicieux dessert... Merci!!!', '2004-03-29T17:19:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11556, 003243e8-b3ef-48ba-b376-857ba8deabdd, 'Avec ou sans glace, c''est un délicieux dessert.', '2002-05-06T13:09:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (87238, 3048a949-034b-43e8-b7dd-90471c4e8fa7, 'Franchement, cette recette pas n''est pas difficile du tout: le temps de cuisson est long mais en fin de compte c''est plus que très bon !!! Mes grands-parents, mes parents et mon frère se sont régalés !', '2015-11-25T22:01:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (87238, f840d859-3563-4e06-88d7-3d44df4c3a1b, 'Recette simple mais le temps de cuisson était trop long. C''est délicieux. A déguster avec un bon thé.', '2015-07-20T16:36:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (173177, a101e416-4c24-4cbf-a22b-0da5038681ac, 'Très bon, j''ai remplacé les boudoirs par des céréales Golden Grahams, un délice ;)', '2019-08-07T09:00:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51050, 6f0e940b-4eb1-4731-9cb6-9a94fcc8b32a, 'Très bon avec la banane. Par contre j''ai ajouté un oeuf pour la génoise, c''était trop sec à manipuler. ', '2016-11-27T15:29:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (51050, 045f1d39-7dc3-4022-b9e5-3296d024b41f, 'Très bon et original, sans être écœurant. J''ai ajouté un petit peu de rhum dans le café pour imbiber la génoise. Par contre j''ai eu bien du mal avec la génoise, très compacte. Je re-testerais cette recette rapidement, avec une génoise plus légère !', '2009-04-08T12:15:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56145, 807fb3e8-0f11-49ff-8142-5cb912e8eaa7, 'Cette recette a eu un succès fou ! J''en ai fait un saladier, sans la salade verte, et l''assaisonnement dans un bol à part pour que chacun mette ce qu''il veut (même nature c''est très bon). A parfaitement agrémenté un barbecue ! ', '2013-04-15T20:34:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56145, c356b1ed-48c7-4ac6-8e65-b3039dc7a7c5, 'Bon mais très copieux pour une entrée !! Je ne mets qu''un avocat et je remplace l''autre par une granny smith. Je n''aime pas trop les bananes flambées au rhum. Je préfère flamber les crevettes !!', '2010-08-31T23:45:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (535033, 7bc53a5f-9474-4434-b4fc-b9313cb7f2b1, 'Fait hier,super bon 😊', '2023-10-24T14:08:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73543, 451e0d1c-093c-4bab-90b3-23b1fb7daf96, 'Excellent, tiède au sortir du four... par contre, éviter après un repas lourd !!!', '2017-03-19T21:05:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73543, 5f91ceab-acd9-4f91-afdc-6339af348e5d, 'Un régal !', '2014-02-04T05:28:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73543, 29e1bafe-d7fc-4139-a5b9-63dc37dc3782, 'Bonne recette bien qu''il me semblait qu''il n''y avait pas assez de pâte à crumble. J''ai ajouté aux fruits une mangue qui traînait et j''ai dû laisser cuire 15 minutes de plus que ce que la recette recommandait. Merci pour cette recette.', '2011-09-19T14:19:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73543, 4d80d427-3826-44f5-9ff1-2a7295911c04, 'Merci pour cette recette : je l''ai suivie à la lettre et nous nous sommes régalés (même sans glace à la vanille) !', '2011-09-18T18:07:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73543, 020b4835-556a-4811-b884-8521be86d9cf, 'Miam !', '2011-02-16T15:27:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73543, 0cabd54a-ff32-46a9-8b5d-8b81c02d4614, 'J''ai adoré cette recette excellente. Je la conseille fortement !', '2011-01-16T14:43:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73543, d5081e90-305a-4db7-89f0-2f0cbbb99c08, 'Tout simplement excellent !!! J''ai reçu que des compliments !! Rien à redire.', '2009-03-30T13:12:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73543, f4ee008b-6632-4bdf-9766-0d496dd030f6, 'J''ai fait un mix de cette recette (je l''ai suivi pour la pâte et l''utilisation de chocolat) et d''une autre trouvée aussi sur marmiton pour les fruits (6 fruits cuits avec de la vanille, de la cannelle, du jus d''orange) : génial!!! à refaire. j''adooore le crumble !', '2009-01-01T15:44:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, aede90c9-6798-4a80-9fd6-b356b5a6a22c, 'C''est bien, pour un milkshake...
Un smoothie c''est la mangue ou la banane ou autre qui donne cet effet... Si utilisation de produit laitier = milkshake', '2017-08-20T13:13:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 9bad8a04-5389-4520-89f1-e8fdf9ebe456, 'N''oubliez surtout pas d''enlever les petits pépins des kiwis.. . (oui je suis très bête)', '2023-12-26T18:21:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 73772cff-eef5-4892-a6a2-22861756efdf, 'Très doux et frais, surtout en été', '2023-03-17T13:56:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 2ebe7b99-742e-4724-b0e4-b8b378f05208, 'Très bon pour ma part, j''y ai rajouté du poulet pour la texture, adopté par toute la famille !', '2022-05-28T13:51:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 5e696492-b015-4af2-a0aa-038394f89ff1, 'Super bon ! Pour ma part; 1 mangue 2 kiwis 1 banane 1 brognon Une poignée de framboises Une poignée de fraises Et a la place du lait, j''ai mis du lait d''amande !  ! Le lait d''amande a adoucit le tout, ce n''etait pas du tout acide !', '2020-07-26T18:42:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, fcb20e36-6d96-449a-8fa8-68705a8e8c09, 'Génial, après un essai raté il y a longtemps, je n''avais jamais osé recommencer un smoothie.
avec cette recette, génial.
j''ai fais la version banane, kiwi, pêche UN RÉGAL !!!', '2017-08-24T12:27:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 27a168de-cc90-4eac-a69a-6ded058aca97, 'Trop bien !', '2016-09-28T16:10:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 03f549aa-3423-46ba-b2d3-9cfcd4185adb, 'Les 3 goûteurs n''ont pas aimé. Testé fraise-banane-kiwi, c''était le choix des enfants, un mélange qu''ils apprécient habituellement mais là les verres sont restés sur la table après 2 gorgées. Cela manquait de goût, peut être trop de lait par rapport aux fruits... C''est vrai que c''est noté "entre 2 à 5 de ces fruits", cela manque de précision parce que entre 2 poignées de framboises et 2 mangues cela fait une grosse différence. J''ai vu dans un commentaire qu''une personne avait ajouté du yaourt, je vais essayer (et ajouter un peu plus de fruits) pour rattraper le coup, cela m''a l''air une bonne idée.', '2016-05-11T12:25:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, c0148b4f-2e7f-49cd-9cd5-ee3739b31565, 'Oh top après une bonne séance de sport. J''ai ajouté du lait de soja vanillé !! ', '2016-05-07T15:45:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, c4534b3a-57e0-4b12-a08c-00ea36924873, 'J''ai changé tous les fruits et c''était très très bon! Merci Marmiton.', '2016-02-24T18:23:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, e121ac26-b645-43b5-9a49-8fb08df0c731, 'Je déconseille les fruits rouges mélangés au kiwi  / je déconseille également les fruits surgelés ça fait des morceaux ', '2015-12-08T17:27:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 41104634-425e-4e4a-b0f1-ead600be72bf, 'C''était bon mais sans plus.', '2013-04-30T19:59:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 8d847452-0601-4d8f-978e-b0337ca412a4, 'J''ai mis banane, kiwi, mangue... Je n''ai pas aimé, cela a gâché le goût de la mangue!', '2013-01-01T22:27:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 86e2ce03-d1ff-46ab-a767-86bfa32c3920, 'Délicieux !', '2012-07-14T17:11:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, ed0f325c-33cc-4648-9845-c9baf4526f40, 'J''ai pris l''option abricots et brugnon. Très bien. A boire très frais.', '2012-06-22T23:59:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 1f32f9f5-6075-4a42-be3f-c1de449edcc6, 'On a pris l''option banane/kiwi/pêche, une vraie réussite !', '2012-05-20T21:49:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, cbf2391e-8a89-4fbd-b914-2c9591071c96, 'Je n''ai jamais couru après les smoothies, mais celui-ci m''a assez plu. J''en ai profité pour me débarrasser de certains de mes fruits, et il a fait plaisir à la famille, bien que cela soit un peu écœurant. Il faut faire attention aux fruits utilisés !', '2011-07-29T14:15:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 43f93c4a-6bcd-4a40-acf9-c2b6569bfe5a, 'Adopté !!!', '2010-06-02T19:28:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 7443c656-3860-4e73-aa66-e554b2f6a48e, 'Un régal ', '2009-08-03T23:17:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 7019522c-acf2-4e10-b0b7-b6121a798e0a, 'J''en bois chaque matin...  une orange, un kiwi, une banane, quelques fruits rouge ou du sirop de fruit rouge ( O% ),du lait ET avec quelques glaçons pour plus de fraîcheur !', '2009-04-26T16:16:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, a6b11ded-1abd-4568-b427-2b07e3fcbc28, 'Maintenant plus personne à la maison ne mange de gâteau pour le 4 h! SUPER, merci beaucoup!!! Pour le p''tit dèj'' c''est super avec des flocons d''avoine ...', '2008-06-29T23:48:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 5ec72b9d-da7e-4364-a721-dada993ede0b, 'Super! Tout le monde a adoré!', '2008-06-21T15:00:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, a6663c58-37cf-4311-8ed8-28b10106885a, 'Très bon!!! Fait souvent et en de nombreuses versions différentes. J''y ajoute parfois un yaourt ou des céréales pour un petit déjeuner complet et délicieux!', '2007-03-20T18:38:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 511eeb8d-5cb1-4361-a194-48b410c35a86, 'Un peu épais. Excellent quand on n''a pas envie ou pas le temps de sortir les casseroles et compagnie. Très roboratif. A fignoler selon les goûts...et les couleurs, bien sûr!', '2006-05-04T15:47:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, f8d6b7cc-0f6d-45c4-b926-aeedf0bc4cf6, 'On ne ressent pas tous les parfums... Il faudrait diminuer la ration de pommes... Sinon, on ne goûte que cela à la maison. Moi, je l''ai utilisé comme sauce pour de la crème glacée. C''était très bon. Pour rehausser le goût, ajouter du miel et des noix. Vous verrez, c''est délicieux.', '2006-04-22T10:11:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34628, 017b2411-4975-489e-8eff-72c19016de24, 'C''est pas super : tous les parfums se mélangent et la texture, la couleur sont plutôt bizarres... On ne sent pas tous les goûts et c''est dommage.', '2005-05-23T23:20:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, d0f7830b-e1ad-4881-8241-b100293868a7, 'Recette coup de cœur ! Je l''ai déjà réalisée des dizaines et des dizaines de fois et on m''en redemande tout le temps. Ça plait aux petits comme aux grands et ça change de la recette classique du crumble aux pommes. J''ajoute juste un peu de beurre et enlève un peu de sucre.', '2022-10-13T15:42:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, 2729fe16-544d-4d1e-beeb-17a6b6073dba, 'Petite variante .... quelques tranches de poire et une demi plaqyette de chocolat praliné ..... une tuerie !!!', '2015-02-13T12:32:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, fd640065-94cf-4018-ac5a-f8eb8c989cdc, 'Super recette ! J''ai juste rajouté des bananes et un peu de beurre... C''était délicieux 😊', '2023-04-17T20:28:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, f73986ef-a249-4b9a-99f9-4a4db0fcd415, 'Un très bon crumble, mais on peut y mettre un peu moins de sucre.', '2022-05-31T22:18:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, c04371e7-a366-4149-a047-f4d7f99daf41, 'J''ai par erreur rajouté de l''agar-agar dans le mix, du coup j''ai ajouté du lait pour faire un topping comme un flan sur les bananes. Super bon :) ', '2022-03-13T22:26:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, a32b0e1a-08a0-43d0-aecb-b4c7bf50e516, 'Très bon, j''ai rajouté un peu de beurre. ', '2022-01-21T12:28:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (88433, d9b1b918-b108-4b6f-8483-fb5b9308ad9f, 'J''ai remplacé par des raisins. Association bananes / raisin parfaits.
