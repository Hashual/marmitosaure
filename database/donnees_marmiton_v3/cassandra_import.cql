Parfaite ❤️', '2022-11-02T12:46:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, ef6f8bad-398a-4749-997b-56650c5761ed, 'J''ai mis plus de citron car ça manquait de goût. Facile et rapide.', '2019-06-14T15:18:26+02:00');
