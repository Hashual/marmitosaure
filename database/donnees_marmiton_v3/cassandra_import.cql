INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, 31b732e3-00a3-4a27-8b26-ca08ef3e9527, 'Excellent ! 150 gr de sucre sont suffisants.', '2021-01-28T20:39:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, f4f1fdb4-65e5-4dfc-ba23-fadf2bbe4d27, '85 grammes de sucre, et du chocolat au lait. 
Pour 42 minutes de cuisson, super.', '2020-12-12T19:57:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55433, d1a9eaf3-a9cb-4ce4-82d4-7f7c1c3ceb37, 'Ok', '2020-11-15T16:40:28+01:00');
