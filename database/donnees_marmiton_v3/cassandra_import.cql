INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92486, 6ac04c3d-4df6-4c8a-a166-611019437d24, 'Vraiment très facile super merci👍🏻👍🏻👍🏻👍🏻', '2023-10-19T14:18:50+02:00');
