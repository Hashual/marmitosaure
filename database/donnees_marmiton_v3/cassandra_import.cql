INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92486, d056b099-a205-471b-bc3c-d37cf3486486, 'Délicieux ', '2023-03-04T13:20:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92486, 7cfd2562-dfbe-4270-85bf-561a07f4d96c, 'Mercii ', '2023-02-25T20:23:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92486, 64878403-4161-44ca-b1ed-57f0b39c09b5, 'Facile à faire merci', '2023-02-05T17:42:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92486, ac441db9-f4d6-4591-9faa-e26341f96e55, 'J’adore faire cette recette, la famille en raffole !', '2022-12-24T16:43:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92486, abc7b76a-12d4-4844-85a6-15b8c389730a, 'Un régal !!! Vraiment délicieuse et effectivement très facile et rapide à faire !! Merci pour la recette !!', '2022-12-22T14:03:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92486, d124b767-b995-419c-8d3a-038023d18278, 'Très facile, simple, rapide et bonne !', '2022-12-03T12:56:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92486, 3a0c4551-20b7-42b8-8a30-d96e686a3093, 'Vite faite et délicieuse !', '2022-12-02T19:06:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92486, b9a63c25-9eab-4a68-8c09-4bf165a3faae, '👍', '2022-12-02T05:25:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92486, 9fa7ac0f-4585-4701-997b-2435f2639e02, 'Topissime.', '2022-12-01T23:30:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34744, c27b5e04-7e75-4ad7-9cae-a6e3994873ea, 'Délicieuse! J''ai rajouté 2 pommes pour un fourrage plus épais.', '2006-01-11T11:43:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34744, e2c3fb48-db67-4eb2-a378-22e83ec7cd0c, 'Délicieux quand comme moi on est ni fan de la frangipane ni de la couronne briochée 
Delicieux tout court même ', '2022-01-16T12:11:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34744, 972d29ba-5a57-45b1-94a6-475a9fc800c0, 'Validée et revalidée !
Une très bonne alternative à la frangipane.
Pour une pâte bien croustillante, j''ai fait cuire moins fort et plus longtemps.
Après la cuisson, j''ai ajouté du sirop de sucre sur le dessus.
La prochaine fois, je mettrai un peu plus de sucre dans les fruits, pour réduire l''acidité.', '2022-01-08T22:11:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34744, a5779e5c-1384-42e1-818f-8448f60e106d, 'Je l''ai faite pour l''épiphanie, elle très bonne j''ai respecté ce qui est dit sauf que j''ai pris des framboises fraîches que j''ai mis à mi-cuisson, tout le monde a aimé, je la referai sans hésiter.', '2013-02-04T16:15:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34744, acf79b08-53e2-4a4c-a932-37c7edf04bfa, 'J''ai respecté toutes les indications. J''ai tout de même ajouté de la poudre d''amandes à la compote pour ne pas qu''elle soit trop liquide. Je pense aussi que l''on pourrait précuire la pâte de dessous une dizaine de minutes afin qu''elle n''absorbe pas trop l''humidité de la compote. En tous cas, excellent !', '2012-01-11T17:48:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34744, f6c24c93-58a3-418b-ae2a-a87daf4d458b, 'Simple à réaliser, les fruits se marient très bien ensemble. Pour lier les fruits j''ai ajouté un peu de poudre d''amande dans la préparation et sur le fond de la pâte feuilletée.', '2012-01-09T19:53:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34744, 08db20ee-7761-4e71-b1fd-947c7016d94e, 'Bonne galette, mais en effet on a pas trop l''impression de manger une galette des rois... En revanche, la galette ne se tient pas... Il faudrait trouver un moyen de lier la garniture.', '2011-01-02T15:05:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34744, ff0c79cc-3383-49aa-a4e7-02687364c293, 'Simple, rapide, économique et délicieux!!! Je n''ai utilisé que des produits bio, et la galette m''a couté 2 fois moins chère qu''une galette à la pomme industrielle vendue en supermarché! Et pour le gout, ce n''est même pas comparable! Je n''attendrais pas l''année prochaine pour refaire cette galette des rois!', '2010-01-31T23:26:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34744, cf1b3f56-9aeb-47b3-9d14-53cf0b4f0433, 'Très bonne recette, compote de fruit délicieuse. Par contre on a plutôt l''impression de manger une tarte aux fruits qu''une galette des rois. ', '2009-01-15T13:17:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34744, 6029a285-0b3f-4141-85de-63c4ae72e313, 'Légère, raffinée, un vrai bonheur quand on trouve la galette à la frangipane beaucoup trop riche!!! Une grande réussite!', '2007-01-08T00:00:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34744, 8eab7eb2-caf1-43a6-b7ca-35a94fa6956d, 'J''ai fait cette recette mais en ajoutant sur la pâte une grosse pomme coupée en fines lamelles avant de la recouvrir du mélange pommes-framboises, c''était extra car il y avait quelques morceaux de pommes fondantes. Par contre, il m''a fallu ajouter plus de sucre que dans la recette originale pour combattre l''acidité des framboises. Succès garanti...', '2007-01-06T15:58:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34744, 8ce03a17-93cd-403c-b774-d2323afd8794, 'Génial! J''ai enfin trouvé la recette alternative que je cherchais! En effet tout le monde n''aime pas la frangipane, et cette galette acidulée a fait craquer tout le monde!', '2006-01-17T13:21:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34744, 0ecba8e5-c5db-46f8-bf81-4cc311b63ac5, 'J''ai fait cette galette hier pour l''Epiphanie, tout le monde s''est régalé et l''a trouvé excellente. Bravo!', '2006-01-09T15:14:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34744, 06932686-62db-48c3-a45f-22cbc67d4849, 'Très simple, très rapide, et surtout délicieux. Que demander de plus, pour épater la galerie?', '2006-01-08T19:09:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (34744, da08dfa9-aa19-4bc9-ac9f-46c774c44089, 'Il aurait fallu plus de fruits, doubler la dose de sucre, surtout ne pas enfourner à 250°C... mais rien d''autre n''est précisé dans la recette!', '2006-01-08T17:31:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, ef5039d0-02b6-40db-8b46-b46a0a905591, 'J''ai juste diminué la quantité de sucre à 100 gr', '2022-05-01T14:13:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, d3ced0c0-e9d9-4c98-a5bd-1e4e016476fb, 'Purée passée au chinois, un délice.', '2013-06-09T12:23:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 4cceaa75-c78c-4306-b47d-52b7992830cb, 'Parfait! Je n''ai passé la purée de fraise au chinois et cela ne se ressent pas. Comparée aux autres recettes, celle-ci est la moins sucrée. Si on prend des fraises bien parfumées, il n''est pas nécessaire de trop sucrer.', '2010-04-25T14:54:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 7badf505-a731-4eba-a1ad-aab93aeea484, 'simple et efficace. Les enfants ont adoré', '2022-06-09T10:38:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 20ca1bd2-1877-49ac-8717-e468dfbf420b, 'J’ai rajouté un peu de vanille, un délice !', '2020-05-24T02:27:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, a8d744fa-bfee-461d-a1a1-1eb77795f21f, 'Effectivement fort sucré. Cela a le goût d''un coulis de fraises.', '2019-07-25T01:40:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 4dca22aa-fc39-4afd-a1bf-016cc23485a3, 'J''essaierais avec la moitié du sirop la prochaine fois mais tout le monde l''a englouti !', '2018-04-15T19:07:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 9d11a92c-6111-4f46-a66d-7d51cb929eb2, 'ATTENTION, ceci n''est pas précisé MAIS verser le mélange une fois la sorbetière en marche ! Mon bac de congélation étant très froid, le mélange a durci sur les bords et il m''était impossible de mettre le couvercle avec le mélangeur ! Le mélange ayant déjà formé un glaçon ! J''attends pour déguster....', '2015-08-07T00:10:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 93b7d003-8a8a-43c5-bf20-fc34c41976da, 'Ma première glace toute seule à la sorbetière !! Plus précisément, un sorbet. Un jeu d''enfant et juste trop bon. Par contre j''ai écrasé les fraises avec un presse purée pour garder quelques morceaux dans le sorbet, un délice!', '2015-06-12T19:44:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 132d2e14-cc1f-4a0c-84f2-3726230edaef, 'Un régal ce sorbet ! Mes petits-enfants adorent. Je vais planter 100 pieds de fraisiers pour l''an prochain :)', '2014-07-31T18:51:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, a0b35fc4-5134-41cb-b312-ee5131dea213, 'C''est un vrai régal je n''ai rien à ajouter. ', '2014-06-29T06:03:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, a82c8de7-8d08-4801-a9a7-a08b952f03ea, 'Absolument délicieux !  Testé la recette deux fois, un régal...', '2014-06-16T02:29:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, ff211253-05c1-47e6-8783-499eaf9faf52, 'Excellent avec des fraises mûres et très gouteuses comme des Mara des bois, le résultat est exceptionnel. J''ai utilisé le blender pour réaliser la purée de fruits, sans avoir à la passer ensuite. Un vrai régal, ce qui fait que pour les gourmands, la quantité peut être un peu juste.', '2014-06-08T14:10:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 836a9f93-4b03-415e-b032-13dc3e973b40, 'Délicieux mais quantités pour 4 environ', '2014-04-20T15:18:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 48b8346e-79d7-45b3-9a48-529a53e2fd68, 'Ok, c''est très bon. Mais pour 6 ? pour moi il y en a pour 3 max... à moins de se contenter d''une mini boule. donc à refaire, en multipliant les proportions par 2. ', '2013-06-08T19:05:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, d461e6c8-ecc8-46a4-9823-f57dda0f3b44, 'Excellent à refaire et à conseiller !', '2013-04-29T13:37:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 5e7c8382-876d-431f-84b8-735548895793, 'Délicieuse recette, l''équilibre est parfait, simple à réaliser, ma petite famille adore ! J''en referais.', '2012-05-23T19:00:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 6fa51ee2-b101-416d-bce9-91c183727803, 'Pppffff c''est un régal !!!!!!! La seule chose que je change est la quantité de sucre je mets que 90g suit au conseil qui a été donné. ', '2012-03-12T23:06:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, a17d856a-b5bd-4af7-975d-f29eb50ba154, 'Proportions impeccables, on a l''impression de croquer des fraises !', '2011-08-30T14:08:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, fbad2c86-ac99-48dc-b309-91dbde661fd5, 'Très bon et très facile à faire.', '2011-07-19T20:37:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 7a601f6c-e4bf-4615-9308-01c493d31dd6, 'Bon, mais on peut mettre moins de sucre : 450 g seulement et 50 g de glucose. Cela rend le sorbet plus onctueux.  ', '2011-05-17T01:14:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 63c10edf-1c75-43d4-9c3d-3d19b7c39546, 'Ce sorbet est juste terrible ! L''impression de manger des fraises glacées, vraiment excellent :)', '2010-07-14T20:38:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 35a8642f-4850-4a42-ad77-814b2f6ebe8b, 'Délicieux. Je n''ai mis que 90 g de sucre, c''était suffisant. J''ai aussi rajouté 2-3 feuilles de menthe et une nectarine. Mixé au blender et pas passé au chinois. Je referai avec d''autres fruits pour essayer... en tous cas, très bien!', '2010-06-06T13:35:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 27c3139a-c1ca-4df1-873a-ca38b705bec8, 'Juste génial ! Les proportions sont parfaites. A faire et à refaire !!!', '2010-06-05T15:15:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 3ea63034-0d6a-42fd-8e31-05eec04a908e, 'Un pur REGAL !! Prend en 20 min dans la sorbetière. Avec des gariguettes c''est succulent.', '2010-05-13T12:35:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 447add9b-1557-4d22-89ea-21b1196d359d, 'Je me suis régalée !', '2009-10-11T17:09:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 1f8ac21a-1972-43ca-bed8-b609dc8b7895, 'Du pur délice! Proportions parfaites, goût exceptionnel, je n''avais jamais mangé de glace où on sent tellement bien le goût du fruit. Et c''est super simple à faire en plus! Tout simplement super: à faire et refaire. ', '2009-09-02T21:38:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, bb561e13-d874-4347-8905-11c111003901, 'Vraiment voila LA recette parfaite !!! première utilisation de ma srobetière et on peu dire qu''elle est reussie les proportions sont parfaites !  par contre j''ai utilisé des fraises guariguette (fraise typique du sud de la france) et on retrouve vraiment le gout de la fraise ! ', '2009-06-24T18:07:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 0f0f2c30-9290-41c6-a95c-7d76b5d31f2f, 'Vraiment bon, les proportions sucre/fruits sont idéales.', '2009-06-04T19:39:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22187, 9ba415b8-60c9-4532-b381-1227311ce2db, 'Excellent! Je n''ai eu que des compliments. C''est délicieux avec de la glace au nougat', '2006-09-16T14:21:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 778c3f2c-529c-4c42-a6ee-31b144e96217, 'Je confirme : 150g de sucre est largement suffisant + beurre fondu à la place de l''huile. En outre j''ai suivi le conseil de laisser tremper au moins 20min dans le sucre les morceaux de pommes : cela permet d''éviter d''ajouter un œuf à la recette de base car les pommes dégorgent un peu de leur jus. Le résultat est parfait.', '2011-11-26T18:51:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, a701d97b-2137-406f-85de-06b380b0bb40, 'Pas du tout aimé. Pâte qui a trop le goût d''huile et pourtant j''ai mis moins que les 12 cl.... Manque de liquide dans cette recette.', '2022-09-29T18:19:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, e7ad458b-b046-4570-8895-65b53878e9e4, 'La recette telle que décrite me parait erronée. Je n''ai réussi qu''à jeter ma pâte, une boule sèche et dure que je ne pouvais même pas tourner dans mon bol. J''ai recommencé mais avec 200 grs de farine 100 gr de sucre et 3 oeufs même poid pour les autres ingrédients que la recette mais j''ai ajouté 20 cl de crème liquide. Mon cake est délicieux et ne s''effrite pas.', '2019-04-08T15:22:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, e5ae7f0c-e739-4cb2-90a7-9ece1b1bd7df, 'La recette ne précise pas que le travail de la pâte forme une boule très compacte et peu habituelle pour une préparation de gâteau. C''est en ajoutant les pommes préalablement mélangées au sucre qui aura fondu qu''on retrouvera une consistance rassurante. Il faut respecter les quantités d''huile, si on en ajoute trop le gâteau s''effritera. Bon gâteau assez consistant. ', '2015-02-07T11:23:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 195e946b-0a72-4a6b-9e2a-35ab10f337c0, 'Il est dans mon carnet perso, mais je n''avais pas laissé d’appréciation ! Alors... excellent. Je fais des gâteaux depuis mon enfance et je ne sais pas pourquoi ce gâteau est le meilleur gâteau aux pommes de ma vie. Peut-être parce que c''est lui et parce que c''est moi...', '2011-05-12T19:19:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, f73675ed-2e7c-4a57-a954-24ce4b6e9e73, 'Super recette !! Goût génial. Attention tout de même au moment de rajouter la farine petit à petit car la pâte deviendra trop dure à travailler, auquel cas rajouter un œuf et ça passera crème 😉', '2023-11-06T19:11:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 3c6e4be6-fbbd-46dc-aa4b-36a42e5c94f5, 'Beaucoup trop sucré, 150g de sucre suffisent et je préfère 125g de beurre à de l''huile . ', '2023-11-05T18:37:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 4f5fb328-da38-4e56-ac74-d9f56ee2e85a, 'Excellent !', '2023-10-27T13:04:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, e02377e4-538f-44b4-900e-2892498f0481, 'Juste 100g de sucre de canne pour confire les pommes et c''est tout.
1 œuf en plus pour que le gâteau se tienne mieux
En mélangeant la pâte épaisse avec les pommes confites (les laisser confire avec le sucre de canne 45 mn en remuant régulièrement) c''est parfait.
Je la fais depuis des années avec ou sans noix', '2023-02-17T14:14:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, b14fc535-7487-4c9d-b599-a8a86d60dcfc, 'Vraiment délicieux ', '2022-04-01T11:57:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 122fd59d-c68f-4585-9eda-9b61b1719236, 'Bonjour , j''ai fais cette recette hier pour aller chez des amis, tout le monde a adoré. Par contre j''ai mis moins de sucre (150g) et à la place de la cannelle j''ai mis un peu de caramel liquide car mon mari n''aime pas trop la cannelle. Il est délicieux !!!!! Tout le monde s''est régalé ! Merci pour cette super recette ! !', '2021-08-01T12:21:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 7573e66a-907d-48f7-ac6d-aeba933d47de, 'Très bon gâteau, tout le monde a adoré,  j''ai mis 100ml d''huile, 200g de farine, 100g de sucre, mixer les noix et 3 pommes, un peu de lait', '2020-11-30T13:45:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 94b0952d-de08-4656-b29d-539d5c71a6e7, 'Une vrai tuerie ! Bon je confirme, il tombe en miette mais il est vraiment bon. Pour ma part, j ''ai mis moitié moitié avec de la farine semi complète', '2020-11-08T19:23:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 61e5f6d4-734f-45e8-8082-0fa4b3a8f5c1, 'Délicieux réduire le sucre', '2020-03-29T18:15:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 4a673a1b-e778-4978-9101-4ac06f97ff79, 'Réduire le sucre de moitié ne pose aucun problème testé et approuvé...', '2018-10-20T14:15:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, abf70dd2-205d-487f-a413-3d00d5402d09, 'Très bonne recette, j''ai juste cuit 10 min en plus, mais tout dépend des fours !', '2018-10-17T12:12:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, b03ba543-9c12-4491-8e5a-0d86997ea87c, 'Très bonne recette. Mis juste 150g de sucre et rajouter un verre d''eau !', '2018-09-26T16:17:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 867acc0f-84a3-4cf5-ba3a-c241de75d921, 'Très bon, merci.', '2018-03-30T07:13:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 093a9e80-6aa1-4152-b4ec-d2a2fed1dcc6, 'Très bon.', '2016-11-20T13:10:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, cdf2c96c-fd33-4627-a4b5-38e8ee8482b5, 'J''ai modifié un peu les proportions, j''ai mis 200 g de sucre brun/200g de farine et 3 œufs / un peu de beurre fondu  un régal ! Et mon gâteau ressemble à la photo en plus ;-) ', '2015-02-27T14:46:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 9fdf25a5-7b16-4f60-a575-a2ae87292b09, 'J''ai juste mis 10 cl d''huile,  160 g de sucre et 250 g de farine. A la fin je l''ai saupoudré de sucre vanillé. C''était pour mon boulot, mes collègues l''ont trouvé extra, moelleux, pas trop sucré et bien aéré. Une parfaite réussite, j''en ai été étonné moi-même ! Je le refais demain. ', '2015-02-25T21:09:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 0373b42c-3ff8-407b-bf22-4de39ce8f0fc, 'Très bon gâteau pour le goûter ou au petit dej avec le café ! J''ai ajouté un œuf pour lier la préparation. 200 g de sucre sont amplement suffisants.', '2014-12-01T10:40:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 5763d7e3-7c21-4744-ba0e-f528472ad8e0, 'J''ai juste changé les 100 g de farine contre 50 g de farine et 50 g de maïzena (question de ligne) Mais franchement c''est réussi et c''est très bon. Par contre comme dessert à la fin d''un repas, cela n''est pas à conseiller, plutôt pour le thé. ', '2014-03-22T10:21:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 7517b5fd-b9fe-4bf7-9244-2167a0ddefb2, 'Parfait mais avec 150 g de sucre, un peu de lait et surtout du rhum ! Hummmm que du bonheur.', '2013-11-13T19:31:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, f6dfb5d8-0cb1-4d82-9915-0727fa046f71, 'la pâte de ce gâteau est beaucoup trop sèche même en rajoutant un œuf et du lait ! Impossible de couper des tranches : tout se met en miettes. De plus le gout n''est pas terrible...', '2013-03-08T14:35:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, e1414677-4f22-4769-aa97-ad40d45ec248, 'Excellente recette. J''ai suivi les conseils des autres internautes. J''ai fait macérer les dés de 5 pommes dans 200g de sucre roux et un peu de calvados pendant 30 min. Dans la préparation, j''ai utilisé 3 oeufs, 5 cl d''huile et 50g de beurre, 1/2 sel fondu et 1 sachet de sucre vanillé. Je l''ai fait cuire à 180°. A refaire. ', '2013-02-10T19:45:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 0ce119a5-bd9c-4f2c-a55b-3f01db3f8eed, 'C''était très bon ! Pas trop de sucre ! ', '2012-11-26T23:45:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, d794859b-968f-405b-9b75-1ad40a1eae6e, 'Dans la recette je pense que le lait a été oublié ! Sinon très bonne recette : le croquant des noix est super agréable, le fait de faire macérer les pommes dans le sucre fait caraméliser un peu les pommes à la cuisson c''est top ! ', '2012-10-13T14:18:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, c31fc2b4-2717-48ed-bdbd-2817263a2316, 'Très bon avec du sucre roux ! ', '2012-05-22T00:43:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, c9abcb97-4a4a-440d-86ca-acae75daf3c0, 'Merci pour cette recette dans laquelle je n''ai mis que 200 g de sucre, ce qui est suffisant.', '2012-05-13T12:51:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 9ce41b54-34ee-47e0-99e2-f2fa53343408, 'Délicieux mais avec le double de pommes et un peu de lait dans la pâte ! Merci, merci, j''adore !', '2012-02-27T22:24:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 419bb30a-45aa-489f-a264-36a383bb9dcd, 'Super, et pour moi les 300 g de sucre sont parfaites..., merci pour la recette  ', '2012-01-15T15:23:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, f28b15ed-9d7b-4663-b8bf-e7ccd2dbb7bd, 'Délicieusement moelleux mais avec, en effet, 150 g de sucre et 3 œufs et plein de pommes ! Merci.', '2011-11-11T20:34:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, c1df632a-bc59-4cff-a2a2-1bf7ccfd423e, 'Je n''ai mis que 200 g de sucre et 3 œufs, et utilisé du beurre à la place de l''huile (j''ai suivi les différents commentaires). Recette succulente, le craquant de la noix est irrésistible. J''ai cassé les noix et c''est le plus long. Le lendemain, le gâteau est encore meilleur et il se découpe parfaitement. A refaire sans hésiter.', '2011-11-11T11:22:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, de3cdc65-79fd-493e-95e6-adec7609afde, 'Bon gâteau mais beaucoup trop de sucre : la moitié serait largement suffisante.', '2011-11-02T17:43:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, a474f784-ba05-4f4c-896b-b3effcd55742, 'Gâteau excellent mais je préconise plutôt 100 g de sucre au lieu de 300 g. J''y ai ajouté un soupçon de lait pour rendre la pâte plus lisse.', '2011-11-01T23:35:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 8d709b2b-b8fd-4bb4-87c3-c71e681f1c6e, 'Tout simplement excellent ! Mais beaucoup trop de sucre à mon goût... Je mets moins de 200g, entre 150 et 200g en fonction de la quantité de pommes + un peu de cannelle et de rhum pour rehausser le goût.', '2011-11-01T10:11:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 4171432a-f7c1-4295-86da-f33ec01ccd6f, 'Il est délicieux ! Mais je m''en suis tenu à la recette telle qu''elle était proposée sur le site et donc un peu trop sucrée à mon goût. Je vais la recommencer en mettait 200 g de sucre et 3 œufs pour la consistance... Sinon il est vraiment très bon !', '2011-10-29T22:32:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 8d579b6d-527b-4216-834c-0b35a547ce49, 'Malheureusement, on ne peut pas mettre plus de 5/5, quel dommage !!! Ce gâteau est un des meilleurs que j''ai fait !  J''ai remplacé l''huile par le beurre et mis 3 œufs, mais j''ai laissé la quantité de sucre préconisé.  Ce gâteau est divin, tout simplement divin !', '2011-10-27T10:33:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 14ad767a-63af-4d1d-9719-8c2e3894c0ff, 'Très bonne recette. J''ai suivi les conseils des autres internautes. J''ai mis 3 œufs et 200g de sucre roux (pour ma part ça suffit largement), j''ai laissé macérer les dés de pommes dans le sucre et un peu de kirsch pendant 30 min à 1h et j''ai remplacé l''huile par du beurre. La préparation n''est pas épaisse, peut-être à cause du jus de macération et se découpe facilement. A refaire.', '2011-10-02T16:01:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, bdda780f-bc90-46ec-9f6c-d7062b3ad556, 'La pâte était vraiment bizarre, ce n''était pas une pâte lisse comme j''en ai l''habitude. Un petit bémol aussi, je le trouvais beaucoup trop sucré (alors que j''adore le sucre), et puis l''huile n''était pas précisée, donc j''ai mis de l''huile de maïs, mais je ne suis pas sûre que ce soit la meilleure pour cette recette. Ceci dit, il a vraiment bon goût !', '2011-09-07T16:55:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 247e6834-7b3a-44ed-bcaa-3c4b1d80a6dd, 'Très bonne recette ! Je la fais chaque week-end avec autant de succès ! Astuce : je mets 250 g de sucre au lieu de 300 g, je remplace l''huile par du beurre fondu et j''ajoute un peu de rhum... Un délice !', '2011-04-17T00:02:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, c8fd5d42-0c7f-427f-bc01-fcc0fab31869, 'Très bon gâteau! J''ai remplacé l''huile par du beurre demi-sel (125g) et ajouté un peu de calvados. Un cake pas du tout sec, très bon mélange noix et pommes.', '2010-10-31T21:28:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 5482f09b-ceef-4036-919a-98323787af83, 'Super !!!!! J''ai mis 125g de beurre, un peu de lait et un peu de calvados. C''est une merveille !', '2010-10-13T18:22:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 08b17278-555b-4b64-99f1-d2c8230287b8, 'Vraiment super bon!!! Facile à faire, pas besoin de 36 ingrédients, et réellement délicieux!!!  ', '2010-02-25T19:40:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 5e8ca7dd-3f89-4515-9b9b-3fadf0b0face, 'On s''est régalés ! J''ai gardé les proportions et j''ai pétri la pâte avec la main, ce qui a fait une pâte bien homogène. Malgré la consistance très compacte cela donne un gâteau moelleux et plein de saveurs.', '2009-10-16T13:53:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 628f9e88-6628-4d52-be8a-b935abd3c547, 'J''ai revu les proportions ainsi: 3 oeufs, pas 2, 5 pommes et non 4, et 150g de sucre au lieu de 300. J''ai aussi mis des noisettes, car j''étais en panne de noix. Pour que la pâte ne soit pas trop épaisse, il suffit de laisser les pommes en morceaux dans le sucre le temps qu''elles rendent du jus (30 minutes à 1h)et ajouter le jus à la pâte avant d''ajouter les pommes et les noisettes. J''ai cuit à 180° une heure et c''était fabuleux... En démoulant dès la sortie du four, la présentation est parfaite. Le gâteau est moelleux, les pommes fondantes, les noisettes croquantes... j''en ai déjà fait deux cette semaine. Slurp!', '2009-06-25T16:31:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 45162db0-b3f0-490d-b3fc-7b42712def67, 'Très déçue. La consistance de la pâte était très compacte, pas du tout celle d''un cake habituellement et impossible de mélanger les pommes et les noix dedans. J''ai donc ajouté 1 oeuf et un peu de lait. Le résultat a été moyen.', '2009-04-16T12:13:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 9df32106-76c3-4dae-a9d1-ff85c8069426, 'Il est délicieux! Apparence spéciale, mais merveilleux! 120g de sucre et 3 oeufs, beurre à la place de l''huile, et c''est un cake absolument merveilleux.', '2009-03-18T09:27:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 97f1c13a-d8f4-48dd-a786-5accf76cf086, 'Très bonne recette, originale, un peu trop de sucre, je n''ai mis que 200g, et je diminuerais encore un peu la prochaine fois, c''est assez léger malgré une consistance au départ plutôt lourde, à refaire!', '2009-03-04T22:34:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 83d38e74-b46d-4c21-97be-fc3df6305418, 'Grâce à cette recette, ma réputation est passée de nulle en pâtisserie à cordon bleu! Inratable et excellent! Encore merci!', '2009-03-02T21:23:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, e5e082e9-ad06-4086-9101-911554c3fece, 'Testé ce matin mais j''ai de suite mis que 200g de sucre et trois oeufs. Il est excellent et très facile à faire. Par contre en ce qui me concerne je dois baisser la chaleur du four, je referais un essai avec 170°C.', '2008-11-13T12:26:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 470d12f3-6425-4d37-a602-d1c77ad9f079, 'Merveilleux gâteau! Ou plutôt gâteaux, la préparation m''a permis d''en faire 2 : un pour la maison, vite englouti et un pour mes collègues, vite disparu ! Un vrai gâteau d''automne... à essayer aussi au printemps !', '2008-11-11T19:44:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, d388fe57-9e30-4e71-917a-27babb90bbee, 'Excellent!! Très simple à réaliser. J''ai suivi les conseils : 3 oeufs, diminuer la quantité d''huile et de sucre... Un régal à dévorer sans modération! Merci pour cette recette!', '2008-10-24T21:59:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 61c4e3a1-c7e8-4865-96da-3f69685c0f8c, 'A faire et refaire, encore meilleur le lendemain, quand il en reste...', '2008-09-28T00:52:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, d076b056-ae36-4680-bb83-9f973b40952f, 'Pour que le gâteau ne se brise pas, ajouter un oeuf ! Sinon délicieux, c''était le premier, à suivre ...', '2008-03-20T10:48:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 5304189b-6e94-4eaa-a449-ad556f9f7ef9, 'Vraiment trop bon! Ne pas hésiter à utiliser de l''huile bio parfumée, comme l''huile de colza bio, ça donne un goût extra au gâteau et se marie bien avec les noix ! A faire et refaire !', '2008-03-12T20:01:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, 20fb2db9-de1e-49b4-9ed6-53fae3ef74a4, 'Excellent, j''ai suivi les conseils pour plus d''oeufs et moins de sucre et j''ai remplacé l''huile par du beurre...Je sais, je sais mais c''était vraiment bon, au point que je n''essaierai pas avec de l''huile.', '2008-02-16T11:59:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, d4d5544e-17c6-4f74-8514-750883dd991e, 'Excellent avec 3 oeufs et 150 g de sucre de canne. N''ayez pas peur de la consistance après avoir mélangé les pommes et la pâte, c''est parfait. Moi je laisse confire les pommes dans le sucre pendant presque une heure. J''ai dû le faire déjà une dizaine de fois. Tout le monde adore. Un grand merci et bravo.', '2008-01-04T20:48:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (19583, cfa0e6ff-eab6-4369-a3be-47c2d57fc28e, 'J''ai mis 200 g de sucre et 3 oeufs, et le résultat était excellent. Merci pour cette recette (merci Fabienne pour les modifications, parfait)', '2007-10-18T09:15:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, bdb5fd95-75a9-4294-a252-c75107d37c80, 'Bon gâteau, j''ai suivi les commentaires précédents, à savoir 150 gr de sucre au lieu de 200 gr, le jus d''un citron dans la pâte et pour le nappage 80 gr de sucre avec le jus de 2 citrons.', '2022-02-28T11:55:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, b35ce748-45f5-4838-8b6d-cd47000c3871, 'Alors c’est la pire recette que j’ai pu essayer. II a trop de farine, le gâteau à failli tuer mes convives. Si vous souhaitez tuer votre belle mere n’hésitez pas à le faire. ', '2023-12-01T22:16:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 23f0a594-cba1-427f-9b31-e31831170bc9, 'J''ai adoré la recette. J''ai mis un jus de citron dans la pâte.', '2024-01-05T15:49:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, fa8879ab-5a75-479a-837f-7c03e9ac572d, 'Gâteau très léger. Moi, j''ai rajouté un jus de citron dans la pâte avant de rajouter les blancs en neige. Ainsi, le goût du citron est bien présent.', '2023-11-19T21:50:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 350a940f-69bd-47a0-ac50-8a05baf117a7, 'Avec un yaourt et moins de beurre +1/3 maïzena et 2/3 farine. dommage que l''option "mon grain de sel" n''existe plus sur Marmiton, c''était bien pratique...', '2023-01-18T18:02:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, a1c73729-14ea-4c8a-a330-0cc308d78e10, 'Délicieux mais encore meilleur avec 2 citrons et leurs jus à l’intérieur du cake !', '2018-08-15T04:11:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 48e7b6f7-512c-4200-87ba-e7d2f90215bc, 'Bonne recette, ne pas hésiter à rajouter des tranches de citron confits.', '2023-12-09T12:35:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 0b090a8f-9dd3-422c-bcaf-a3271e8e95b2, 'Cake au citron testé, mon reproche, c''est trop de farine donc très sec, niveaux zeste de citron pas de goût du citron, j’ai rajouté du jus de citron, mis à part ça, il est bon !!!', '2023-10-31T15:23:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 81f2ace0-2d47-4081-a14e-fd2b5b2c8cf4, 'Une tuerie 😀 Ça fonctionne très bien avec le four solaire !', '2023-01-30T19:14:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, f242948e-2539-4c53-ab90-83b0cb8ad2b2, 'Bonne recette, mais 200 gramme de sucre c’est beaucoup trop ! J’en ai mit 140 et c’était très bien. Je vous conseille aussi de mettre le jus de citron directement dans la pâte, et d’en rajouter en plus du jus du citron que vous avez utilisé.', '2021-12-20T17:45:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 9299fdca-93e4-4a08-bc41-d149f2422124, 'jai remplacé le beurre par une banane écrasée et un filet d''huile de tournesol et c''était délicieux ! aussi une petite astuces : pour avoir plus de goût de citron frotter les zestes avec le Sucre !', '2023-08-27T19:57:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, e51a3bdc-b47e-45fe-8464-6dcfa4094939, 'Excellent. Si l’on nappe le cake d un sirop de citron, je trouve raisonnable de baisser la quantité de sucre dans kff ère cake, le sirop sucre pas mal en bouche. Il fait équilibrer. C’est mon avis. J ai mis 150 g au lieu de 200 g de sucre. ', '2023-08-20T16:14:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 1910e9c8-065e-4e01-8f4e-fc938d799f2c, 'Super cake ! Meilleure recette que j’ai jamais trouvé avec saveur au citron ! Hyper moelleux et la saveur de citron est juste. Je recommande vivement !!!👍👍', '2023-05-01T21:12:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, cd98976a-faf9-4a0b-8674-947d80006c7d, 'Très bon ! J''ai suivi les avis des autres et j''ai mis un peu moins de sucre. Le sirop apporte beaucoup de moelleux au cake, à ne pas louper ! J''y avais ajouté quelques feuilles de basilic pendant la cuisson avant de filtrer le tout au chinois.', '2022-08-23T22:29:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, f2786bb8-169a-45dd-81df-8261d95a11f4, 'Très bonne recette à réaliser, mais pas assez explicite concernant les citrons ! Par ex elle ne spécifie pas qu''il faut les presser avant de les râper', '2022-03-19T19:35:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, cb9eefbd-52c4-4673-9ac7-b5906c836c64, 'Très bon. Un jus de citron dans la pâte et napper de sirop fait avec 80 g de sucre et 2 jus de citron à laisser bien cuire. Pour les amateurs de citron...', '2022-02-20T12:56:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 38130e3c-6c64-4fdc-ad66-1e88513f2f77, 'Super bon ! J''ai mis 180 g de sucre et 1/2 (jus) citron dans le cake. Merci.', '2019-09-11T18:39:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 04a4e761-0581-4c5c-a9ef-d3f6ad5cda60, 'Délicieux, j''ai juste mis 150 g de sucre et c''est parfait.', '2019-03-18T11:23:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 0e885959-85ed-4042-9a6a-99e0f27c5bb2, 'J''ai mis 150 g de sucre et le jus et zeste de 2 citrons pour que ça goûte beaucoup... excellent !', '2018-11-29T10:22:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 8c24072c-010e-425e-98d7-b90e781bcf94, '150 gr de sucre suffisent. Par contre je mettrai 2 citrons la prochaine fois.', '2023-10-08T17:51:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, afe233e8-9b53-467d-a298-7ce283906724, 'Très bon , simple et rapide .', '2023-07-30T10:40:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, ee23e1ed-336f-4d00-a6d7-8815432b8db7, 'Recette facile !', '2022-10-16T15:00:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 21362e85-de6e-483d-9306-2b86f36cf16b, 'Très bon ! Je n’ai pas mis de citron et j’ai mis des framboises congelés et pépite de chocolat. 5/10min de cuisson supplémentaire. C’était délicieux ', '2022-06-29T20:04:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 03b3ac8f-9c40-4489-b107-f02a9d4ad4f5, 'C''était très bon, parfaitement dosé, nous avons adoré', '2022-02-24T17:12:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, ba0c9d0d-b65c-4682-a3ab-c441e82d2555, 'J''adore', '2022-02-05T14:26:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, b4faa8da-d684-4f83-a18e-be835e897269, 'Très bien avec seulement 150g de sucre de canne au lieu de 200g. Sans le sirop le cake est rafraîchissant !', '2022-01-30T21:47:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, f2ae48d5-98e8-4440-b9db-f330a58ca6f6, 'Top! ', '2022-01-30T14:58:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, d7f78b6d-6f07-499c-b132-15d7072eadb6, 'Vraiment très bon par contre je n''ai mis que 150g de sucre et le jus d''un citron vert dans la pâte. Même les enfants ont adoré', '2021-12-04T16:19:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 4c5daed5-9ea1-422c-a21e-64f2a216a5b9, 'Ça fait 118g de sucre en poudre !', '2021-11-13T18:03:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, f6e1d035-1225-4a26-af2e-bbf1dffbcdb7, 'Bonjour, j’ai remplacé le zeste de citron, par des gouttes d’huile essentielles de citron Bergamote au goût fin et subtil.', '2021-08-10T15:05:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, a36c7832-92e3-43a4-b53e-70cb6f1653f5, 'Très bonne recette. Je l''ai un peu modifiée en mettant le zeste de 2 citrons ainsi que le jus d 1 citron, et j''ai remplacé une partie de la farine par des noisettes mixees. Un délice ! ', '2021-05-23T22:18:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 601e0c6c-6418-49cf-83ae-86bbd2bbf8f5, 'Goût très bon mais texture beaucoup trop compacte alors que la recette a été très bien respectée, dommage! ', '2021-03-24T23:22:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 7e27d37e-a635-42ea-9817-8fb5816042ae, 'J’aime bien faire ce cake il est délicieux et facile à faire ', '2021-01-07T09:00:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, cf6d2b7d-87bb-47e4-9a1a-9fccf72acbaa, 'Excellent ? ', '2021-01-03T13:41:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 645ff784-b792-491c-ba0f-d709132103df, 'Facile à reproduire et délicieux !', '2020-12-29T22:32:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, b7214358-5b53-4286-8e81-db9610b5d0ad, 'Excellente recette. J’ai du la faire au moins 5 fois! Ma famille l’adore !', '2020-06-15T11:36:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 4c5fd5d9-0b73-475f-ab60-64ae7e5220df, 'Excellente !! 😀 Rien à rajouter ', '2020-04-21T15:02:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 2cdbc23e-44c7-4c11-ad47-6cb440bfbeb7, 'Merci pour cette excellente recette. J’ai compilé les modifications indiquées dans les commentaires. 
Pour la pâte : 150 g sucre seulement, et moitié maïzena moitié farine, le jus d’un citron (un peu moins pour que la pâte ne soit pas trop liquide). Pour le jus : 100 g de sucre et le jus de 2 citrons et un peu plus. J’ai fait des trous partout pour imbiber de façon homogène. 30 min à 180°C. Délicieux !', '2019-12-15T09:45:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 8d504ef7-9c92-4193-acdf-c73b8c37042c, 'Très bon cake même sans sirop. J''essaierai de le remplacer par un peu de jus moins sucré. Il est très vite consommé de toutes façons.', '2019-12-14T10:51:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 0492b172-f763-4768-86be-27bcc2af2387, 'Excellente recette appréciée par tous !
J''ai tout de même fait quelques petit changements :
Pour le cake: 150 g de sucre 
Pour le sirop : 10 sucres', '2019-05-30T03:45:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 4ee344e6-b274-4236-8fef-64651f84ac28, 'Excellant ! Pour ma part j''ai mis 100 g de sucre et 75 g de beurre pour la pâte et 100 g de sucre pour le sirop. Tout le monde a été conquis.', '2019-04-30T18:54:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 953145fa-cd18-4b46-ab4d-4a30a2a9de42, 'Excellente recette. J''ai apporté quelques modifications à la recettes : j''ai mis seulement 100 g de sucre + j''ai ajouté le jus d''1 citron directement dans la pâte + zestes de 2 citrons + 1 sachet de levure entier (alsa). Pour la sirop : le jus du deuxième citron.', '2019-04-20T19:50:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, af46d1c2-a688-4ccc-a2b1-67362df92613, 'Top !
', '2019-02-24T07:38:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 156ae87f-50df-4251-8156-cfb86f6371f4, 'Délicieux pour ceux qui aiment le citron comme moi, je l''ai préparé plusieurs fois et ma famille adore vraiment. (J''ai mis 2 citrons au passage).', '2018-08-13T17:37:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 952934f7-185e-4e50-a0ac-8cabbe968755, 'Superbe recette ! J''ai juste mis un peu moins de sucre (150g), et ajouté un peu de jus de citron dans la pâte avant cuisson comme le conseillent certains commentaires et c''est délicieux ! Un gâteau bien moelleux comme on les aime !', '2018-07-09T05:30:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, ba5dde87-e1d6-4ad1-8d35-501b94b178ac, 'Délicieux cake moelleux. J''ai retiré un peu de sucre question de goût. Pour le glaçage, j''ai mis 40 g de sucre glace et le jus d''un citron. ', '2015-10-07T13:11:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, ae0240cf-b4be-438d-893a-a0803c87a53d, 'Très bonne recette, pour ma part fait avec farine de blé complete et parfumé au kirsch, excellent ', '2023-11-04T17:41:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, a968f116-0a92-4a89-bedb-ca20d1fe9d48, 'Super recette ! Tout le monde a adoré ce cake délicieux !!!', '2023-05-17T05:24:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 87a756cd-4f9d-4833-ace9-6032d2125b06, 'Excellent. ', '2023-05-12T11:48:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, f6397859-34d7-4a88-84a7-bebef7ef6980, 'Excellent !', '2023-04-12T06:29:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 7fed0a39-59dd-431b-a974-cb972c946093, 'Très facile à préparer et délicieux à déguster. ', '2023-03-31T17:32:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 7372338b-509d-4106-b19f-5690be600b8b, 'Excellent, moelleux, miam un délice! Mais sucré!

', '2023-03-09T21:56:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, 8b159f88-ae3e-4465-8b82-93280d1bea37, 'Très bonne recette, le gâteau est léger et super bon !', '2023-03-07T21:07:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, b87a18b9-cb07-4f6b-83c5-acacc81835fb, 'Super bon.  Très facile 
