INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (328674, 'Bourgui burger pour cocotte minute', 'pain pour hamburger, filet de boeuf, carotte, oignon, bouquet garni, champignon, lardons, farine, vin rouge, huile d''olive, poivre, sel, sucre', '8 min', ['Couper le filet de bœuf en cubes de 3 à 4 cm de côté environ. Eplucher les carottes et les émincer finement. Peler l’oignon et l''émincer.', 'Faire chauffer l''huile à feu vif dans la cocotte sans la fermer et colorer la viande. La retirer (les cubes doivent rester saignants).', 'Verser le vin rouge et gratter bien les sucs de cuisson.', 'Ajouter les lardons et les légumes. Ajouter également la farine et mélanger pour bien enrober les ingrédients.', 'Ajouter le bouquet garni et le morceau de sucre, et assaisonner. Mélanger.', 'Fermer la cocotte-minute. Dès que la vapeur s''échappe, réduire la source de chauffe et laisser cuire selon le temps indiqué.', 'A la fin de la cuisson, remettre la viande dans la sauce pendant 1 à 2 minutes pour la réchauffer et la servir dans les pains à hamburger.'], ['Casserole', 'Rouleau à pâtisserie', 'Verre doseur', 'Moule à tarte', 'Râpe'], ['', 'recettes', 'pain pour hamburger', 'boisson', 'champignon', 'cuisine', 'oignon', 'farine', 'sucre', 'bouquet garni', 'moyen', 'recettes de cuisine', 'entrée', 'Bourgui burger pour cocotte minute', 'testées', 'carotte', 'dessert', 'recette', 'rapide', 'filet de boeuf', 'cocktail', 'poivre', 'plat de résistance', 'lardons', 'plat', 'confiserie', 'vin rouge', 'moyenne', 'huile d''olive', 'sel'], 'Plat principal', 1a8a05db-41e6-4fc9-8be5-1411ffbfd567, '2025-09-26T14:56:38.514533', [{'ingredient_id': '732e6850-21b7-411e-b662-c3028af3760c', 'quantite': '4'}, {'ingredient_id': '6831bc03-c1ca-4ea1-b502-7bcdfc64ee72', 'quantite': '700 g'}, {'ingredient_id': 'd6f8a470-7c43-4cef-aca9-f979611142de', 'quantite': '150 g'}, {'ingredient_id': '4103f69f-1114-4986-a3e5-f50d53fc0821', 'quantite': '1'}, {'ingredient_id': 'eac36800-040c-4620-9657-98c28bb3ea97', 'quantite': '1'}, {'ingredient_id': 'ddf5e8db-3c9a-409b-af23-29b873fd0452', 'quantite': '300 g'}, {'ingredient_id': '517d8c32-0f33-492f-8343-0c78d8ceb600', 'quantite': '50 g'}, {'ingredient_id': '85430d34-3a5e-4c38-9f5e-fd72b4236275', 'quantite': '1 cuillères'}, {'ingredient_id': '1d2e33ac-e54a-4f10-b7f2-159d7da62747', 'quantite': '25 cl'}, {'ingredient_id': '0b7d9716-91d2-4966-bcda-5c87ecbf5202', 'quantite': '2 cuillères'}, {'ingredient_id': 'dffec5ed-4097-4e89-b242-615d879f8f15', 'quantite': ''}, {'ingredient_id': '8b8ccb74-6be1-4ecc-b549-0b0f8337cc7e', 'quantite': ''}, {'ingredient_id': '47a57edb-2bf1-41a4-a127-32ae4dee5d41', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14679, 'Pomme de terre au four', 'pomme de terre', '10 min', ['Préchauffer le four à 180°C / Ther 6.', 'Eplucher les pommes de terre, ou laisser la peau si elle est fine.', 'Les couper dans le sens de la longueur et les placer sur une plaque au four, face bombée contre la plaque. Saler et laisser cuire à four chaud jusqu''à ce que le dessus soit bien doré.', 'Servir chaud accompagnées de salade verte et de toutes sortes de fromages (du kiri pour les enfants en allant jusqu''au maroilles...).', 'C''est délicieux, économique et sans graisse. Délicieux avec de la cancoillotte !'], ['Tire-bouchon', 'Râpe'], ['recettes', 'testées', 'confiserie', 'boisson', 'bon marché', 'dessert', 'très facile', 'cuisine', 'recette', 'plat de résistance', 'pomme de terre', 'pommes au four', 'plat', 'Pomme de terre au four', 'recettes de cuisine', 'entrée', 'cocktail'], 'Plat principal', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:56:45.093312', [{'ingredient_id': 'c4431286-8c54-4d13-8279-9c22b46822ce', 'quantite': '500 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17718, 'Gratin de poisson', 'eau, tsuyu (bouillon au poisson volant), colin, pomme de terre, crème fraîche, gruyère, sel', '10 min', ['Faire bouillir l''eau avec les deux cubes. Une fois que l''eau bout, y plonger le colin d''alaska et laisser cuire 7 à 10 mn. ', 'Egoutter et émietter le colin. ', 'Dans un plat à gratin, mettre deux couches de pommes de terre coupées en tranches fines, saler, mettre le colin puis, de nouveau, une ou deux couches de pommes de terre. ', 'Saler, ajouter la crème fraîche et un peu de gruyère sur le dessus. Mettre au four chaud 180°C pendant 40 mn.'], ['Couteau de chef', 'Spatule'], ['recettes', 'boisson', 'très facile', 'cuisine', 'colin', 'recettes de cuisine', 'entrée', 'poisson au four', 'tsuyu (bouillon au poisson volant)', 'testées', 'bon marché', 'dessert', 'recette', 'cocktail', 'plat de résistance', 'pomme de terre', 'gruyère', 'eau', 'Gratin de poisson', 'plat', 'confiserie', 'sel', 'crème fraîche'], 'Plat principal', 8ee580a4-f08d-435a-8708-dce9bd015b31, '2025-09-26T14:56:50.763188', [{'ingredient_id': '1f1ed18d-ad78-4393-9b13-ddb4a6754d61', 'quantite': '1.5 l'}, {'ingredient_id': 'd14fba66-16f3-4bd0-8418-4a70b1f1421b', 'quantite': '2'}, {'ingredient_id': '5ed3f699-073e-4139-b3eb-e5cca423d1c4', 'quantite': '8'}, {'ingredient_id': 'a1138199-f1d0-4ac6-bc3f-ec32737ad4b1', 'quantite': '8'}, {'ingredient_id': '33634b9d-ff7a-46d8-94e0-530056f287f2', 'quantite': '2'}, {'ingredient_id': 'e365eeb5-1967-487b-b426-119197085600', 'quantite': ''}, {'ingredient_id': 'c138e5c3-0876-45ae-96ab-7ff5c099c201', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57774, 'Gratin de poisson et carottes', 'poisson, carotte, échalote, brousse, huile d''olive, thym, poivre, sel', '10 min', ['Eplucher les carottes, les raper.', 'Dans une poêle, verser la moitié de l''huile, la moitié du thym, les échalotes coupées très finement et les carottes, faire revenir 5 minutes à feu moyen avec sel et poivre.', 'Allumer le four à 160°.', 'Couper le poisson en lamelles (0,5cm) le mettre dans le fond du plat en pyrex.', 'Verser les carottes puis couper le fromages en lamelles de 0,5 cm.', 'Verser le reste du thym et d''huile d''olive, du sel et du poivre.', 'Faire cuire 40 mn.'], ['Économe', 'Râpe', 'Fouet', 'Rouleau à pâtisserie'], ['brousse', 'recettes', 'boisson', 'très facile', 'cuisine', 'recettes de cuisine', 'entrée', 'poisson au four', 'testées', 'carotte', 'bon marché', 'dessert', 'recette', 'poisson', 'thym', 'cocktail', 'poivre', 'plat de résistance', 'plat', 'échalote', 'confiserie', 'Gratin de poisson et carottes', 'huile d''olive', 'sel'], 'Plat principal', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:56:54.440955', [{'ingredient_id': 'f9e92208-cf4d-4905-b556-77fcf53625e3', 'quantite': '2'}, {'ingredient_id': '8f47b959-6c04-4ecf-9319-061ff554cc52', 'quantite': '300 g'}, {'ingredient_id': 'ff5fb689-e83e-44be-a365-56157eb6b7e6', 'quantite': '2'}, {'ingredient_id': '2aa5233b-b8c2-4c76-bf7f-e11fc3cc24f1', 'quantite': '1'}, {'ingredient_id': '12025982-c395-4c86-adb3-ba4fa5a94462', 'quantite': '3 cuillères'}, {'ingredient_id': '7b3c92e9-f7cb-44c3-9b30-44b3e99559be', 'quantite': '1 cuillères'}, {'ingredient_id': 'a883829b-c857-47df-a170-9046a2bd79fd', 'quantite': ''}, {'ingredient_id': 'f69f5a2f-80fd-4214-a8dd-89e280ecba4e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11391, 'Cake au citron', 'farine, sucre, oeuf, levure chimique, beurre, citron, sucre, citron', '10 min', ['Séparer les blancs de jaunes. ', 'Battre les blancs d''oeufs en neige, puis les réserver.', 'Au bain-marie, faire fondre le beurre.', 'Râper le citron.', 'Travailler les jaunes avec le sucre.', 'Ajouter le citron râpé, la farine, la levure et le beurre fondu. Y incorporer délicatement les blancs en neige.', 'Enfourner à 180°C (thermostat 6) pendant 30 à 40 min.', 'Pendant ce temps, faire le sirop à feu doux avec les 20 morceaux de sucre et le jus des 2 citrons; imprégner le cake avec ce sirop.', 'Servir froid avec de la crème anglaise, des fraises, framboises, etc. Et même nature !'], ['Pince de cuisine', 'Planche à découper', 'Fouet', 'Moule à tarte', 'Passoire'], ['recettes', 'boisson', 'cuisine', 'sucre', 'farine', 'beurre', 'recettes de cuisine', 'entrée', 'testées', 'bon marché', 'dessert', 'recette', 'Cake au citron', 'oeuf', 'cocktail', 'plat de résistance', 'plat', 'citron', 'cake au citron', 'confiserie', 'levure chimique', 'facile'], 'Dessert', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:57:01.209851', [{'ingredient_id': '20eb4f32-f5c2-4c2c-b691-0dc3145451b6', 'quantite': '200 g'}, {'ingredient_id': 'fcd7ad29-d36f-4f62-8e36-ed8bececcc2d', 'quantite': '200 g'}, {'ingredient_id': 'c4e81095-949c-4e47-a6b6-b022f6a22b57', 'quantite': '4'}, {'ingredient_id': 'da2bd4fb-39c8-431f-b7cd-ffa294b62f65', 'quantite': ''}, {'ingredient_id': '12f42b00-e236-4dc0-977f-eea46ffada4d', 'quantite': '100 g'}, {'ingredient_id': '45414a9a-8a62-49b1-84b7-32b932241285', 'quantite': '1'}, {'ingredient_id': 'f434a360-cc30-4388-b3e1-729a85156e3c', 'quantite': '20'}, {'ingredient_id': '911ab2ed-5280-4000-a11a-2f4bb81a16cf', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29466, 'Poisson léger aux poireaux', 'poisson, poireau, échalote, huile d''olive, crème allégée, poivre, sel, épices, chapelure', '15 min', ['Couper les poireaux finement en petits tronçons, ainsi que l''échalote. ', 'Dans une sauteuse ou un wok, mettre une bonne cuillère à soupe d''huile d''olive et les faire étuver jusqu''à ce qu''il brunissent un peu.', 'Verser la crème, qui doit couvrir autant que possible le poisson et les poireaux.', 'Assaisonner d''une bonne pincée d''épices, saler et poivrer.', 'Dans un plat allant au four, verser un 1/4 de cette préparation. Y placer le poisson et recouvrir avec le reste.', 'Saupoudrer de chapelure et cuire à four chaud (thermostat 7/210°C) 1/2 heure.'], ['Louche', 'Presse-agrumes', 'Pince de cuisine'], ['', 'recettes', 'boisson', 'très facile', 'cuisine', 'recettes de cuisine', 'entrée', 'testées', 'bon marché', 'dessert', 'recette', 'crème allégée', 'poisson', 'cocktail', 'poivre', 'Poisson léger aux poireaux', 'chapelure', 'épices', 'plat de résistance', 'plat', 'échalote', 'confiserie', 'poireau', 'huile d''olive', 'sel'], 'Plat principal', e1c1d05f-00ba-4ccc-b627-10700ca3da03, '2025-09-26T14:57:06.302222', [{'ingredient_id': '3e7aeff1-5eaa-4d6c-b1bf-0c7277a9de2d', 'quantite': '1'}, {'ingredient_id': '6681f49d-565a-4551-9942-295d0a50f096', 'quantite': '2'}, {'ingredient_id': '653c0f07-e409-4b78-84c6-1f6179244425', 'quantite': '1'}, {'ingredient_id': '9bb14d2f-910e-420e-87f3-5cbc6915b709', 'quantite': ''}, {'ingredient_id': 'fcb5753c-1ca6-4f13-8b16-f1077bf55fe6', 'quantite': '10 cl'}, {'ingredient_id': 'a4058df7-0486-46bb-81ae-08ce2f303da4', 'quantite': ''}, {'ingredient_id': 'cdbde399-daea-436c-aa7a-441f99eaad79', 'quantite': ''}, {'ingredient_id': 'eb429aad-c2ec-4bce-9651-b663ac3e3336', 'quantite': ''}, {'ingredient_id': 'c7ccd240-31b1-44d5-96f6-39abe23e26f6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528917, 'Sushi burger', 'riz rond, eau, vinaigre de riz, sucre, sel, saumon, avocat, mangue, sésame', '15 min', ['Lavez le riz et le cuire.', 'Ajouter au riz le sucre, le sel et le vinaigre de riz et bien mélanger.', 'Former les buns de riz à l’aide d’un bol ou d’un emporte pièce en guise de moule. Réserver.', 'Pendant ce temps, couper en lamelles le saumon (façon sahimis), l''avocat et la mangue.', 'Une fois que les buns ont bien pris, on passe au montage : une couche de saumon, une couche d’avocat, une couche de mangue, une couche de saumon, et pour finir le deuxième bun.', 'Finaliser en saupoudrant de grains de sésames.'], ['Moule à tarte', 'Balance de cuisine', 'Presse-agrumes', 'Pince de cuisine'], ['recettes', 'boisson', 'cuisine', 'sucre', 'moyen', 'recettes de cuisine', 'entrée', 'vinaigre de riz', 'testées', 'dessert', 'recette', 'rapide', 'cocktail', 'riz rond', 'Sushi burger', 'plats japonais', 'plat de résistance', 'eau', 'plat', 'confiserie', 'sel', 'facile'], 'Plat principal', 98e44c88-46be-496e-9f2c-fa40b5235a57, '2025-09-26T14:57:10.026811', [{'ingredient_id': 'f3be2c91-f3e3-4731-a021-6158a4a0931c', 'quantite': '200 g'}, {'ingredient_id': '4ea033ca-c6bd-4cb5-908b-6eaf94fd5c04', 'quantite': '50 cl'}, {'ingredient_id': 'd0dbb229-8c91-4293-bd33-7d57ec0b8f24', 'quantite': '4 cuillères'}, {'ingredient_id': 'c1875082-c525-47d0-8780-dd039161b9c2', 'quantite': '2 cuillères'}, {'ingredient_id': 'b89f84de-571c-4ca4-b691-a19850a669bb', 'quantite': '1 cuillères'}, {'ingredient_id': 'e53b78ff-b18f-4df9-a926-c6e449eb2a0f', 'quantite': '200 g'}, {'ingredient_id': '6b872a8b-3aea-4890-8465-022b6e702104', 'quantite': '1'}, {'ingredient_id': '8e2cfc53-fabb-4dbe-93a3-951782f02226', 'quantite': '1'}, {'ingredient_id': 'f8463d96-f6db-4fe4-b8ee-659b3c78e726', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (82624, 'Chaussons de poisson, épinard et fromage de chèvre', 'pâte brisée, épinards, échalote, chèvre frais, huile d''olive, lieu noir', '10 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Dérouler la pâte brisée et la couper en deux. ', 'Disposer sur chaque moitié : de l''échalote hachée, le poisson surgelé, les épinards qui auront été décongelés au préalable et le fromage de chèvre.', 'Replier la pâte pour fermer le chausson.', 'Tartiner le chausson d''un peu d''huile d''olive ou d''un jaune d''oeuf et remettre un peu de fromage de chèvre sur le dessus pour faire gratiner.', 'Mettre au four pendant 25 minutes à 200°C (thermostat 6-7).'], ['Pince de cuisine', 'Poêle'], ['recettes', 'empanadas', 'boisson', 'très facile', 'cuisine', 'lieu noir', 'recettes de cuisine', 'entrée', 'testées', 'chaussons', 'bon marché', 'dessert', 'recette', 'pâte brisée', 'épinard et fromage de chèvre', 'cocktail', 'plat de résistance', 'épinards', 'plat', 'échalote', 'Chaussons de poisson', 'confiserie', 'chèvre frais', 'huile d''olive'], 'Plat principal', fb5886d4-28aa-4b1b-bb15-861df4796737, '2025-09-26T14:57:14.013832', [{'ingredient_id': '5ee903d4-7b1e-41e4-aaba-e46db7b38da0', 'quantite': '1'}, {'ingredient_id': '2eb718c1-c8d3-4e9e-a4b5-62ed65d99616', 'quantite': '1'}, {'ingredient_id': '59a04327-cacf-42fc-9b75-f86c56205c72', 'quantite': '2'}, {'ingredient_id': '99d4b242-3daf-45a2-be60-5b04046903f3', 'quantite': '1'}, {'ingredient_id': '9971dea4-7241-4b60-81cb-c261785795a4', 'quantite': '1'}, {'ingredient_id': '5860a07a-58ff-4c40-8a32-52826041dee5', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (44090, 'Poisson au curry de Madras au lait de coco', 'poisson, oignon rouge, ail, poivron rouge, poivron vert, gingembre, tomate, citron vert, lait de coco, huile d''olive, curry, curcuma, piment, poivre, sel', '20 min', ['Préparer le poisson, en ôtant la peau et les arrêtes.', 'Le faire rapidement revenir, des deux côtés, dans une sauteuse dans l''huile d''olive, puis réserver.', 'Faire cuire l''oignon et l''ail émincés, ainsi que le gingembre, dans la sauteuse utilisée précédemment.', 'Ajouter les poivrons coupés en lanières, et faire cuire 10 min pour faire réduire.', 'Ajouter les tomates en morceaux, et faire cuire 5 min.', 'Ajouter le curry, le curcuma, le piment, sel et poivre. Mélanger.', 'Ajouter le jus du citron vert, puis le lait de coco. Mélanger.', 'Ajouter le poisson, et bien mélanger le tout.', 'Laisser cuire encore 10 min, en couvrant la sauteuse, à feu doux.', 'Servir chaud, avec un riz blanc.'], ['Spatule', 'Poêle', 'Fouet'], ['curcuma', 'recettes', 'boisson', 'citron vert', 'cuisine', 'moyen', 'recettes de cuisine', 'entrée', 'testées', 'curry', 'dessert', 'recette', 'poivron vert', 'poisson', 'cocktail', 'piment', 'poivre', 'ail', 'plat de résistance', 'Poisson au curry de Madras au lait de coco', 'poivron rouge', 'plat', 'gingembre', 'confiserie', 'oignon rouge', 'viande à l''indienne', 'lait de coco', 'tomate', 'huile d''olive', 'sel', 'facile'], 'Plat principal', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:57:19.115516', [{'ingredient_id': 'b16f7c88-3513-4a4f-89e0-bed080a909c1', 'quantite': '800 g'}, {'ingredient_id': '8cdaa43d-5d3f-4b98-904c-03b8f209818a', 'quantite': '1'}, {'ingredient_id': 'f3c330c5-966d-4ac5-9e2a-50605cc05635', 'quantite': '2'}, {'ingredient_id': '6e51d2d1-c917-4715-83a3-649f91e94bb5', 'quantite': '1'}, {'ingredient_id': '1fdcafc6-1fae-410f-8e41-950947861d5b', 'quantite': '1'}, {'ingredient_id': '63a63b2c-b3cc-47fa-9762-ed0b6e7cff7f', 'quantite': '1'}, {'ingredient_id': '9f8e99ce-35f3-482a-8b0d-bea1ad2fcd9f', 'quantite': '3'}, {'ingredient_id': 'fc76bd24-414f-4ee4-afb9-f5e2ec015495', 'quantite': ''}, {'ingredient_id': '25445985-db43-4c21-b229-97af5b9b66c1', 'quantite': '1'}, {'ingredient_id': 'd247a221-84a0-4e7a-bffb-3eff552d68c6', 'quantite': '1 cuillères'}, {'ingredient_id': 'ee88e0f2-1957-450f-892c-f17e4ab7b277', 'quantite': '1 cuillères'}, {'ingredient_id': 'eab54ed7-18b8-4472-a84c-050bec8bc203', 'quantite': '1 cuillères'}, {'ingredient_id': 'b5e62824-9a61-4224-a493-2603810799cf', 'quantite': '1 cuillères'}, {'ingredient_id': '751bcbf5-e444-4f1a-a811-0f89d6e07f0e', 'quantite': ''}, {'ingredient_id': '4bd09022-50df-4384-bfb7-c513651fd2f1', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (372829, 'Gratin de pâtes et aubergines façon burger', 'aubergine, oignon, pulpe de tomate, viande hachée, cheddar, pâtes, emmental, café, poivre, sel', '30 min', ['Préchauffer le four thermostat 6/7 (200°c).', 'Emincer le premier oignon, peler les aubergines et les couper en gros dés. ', 'Mettre de l''huile d''olive dans un faitout disposant d''un couvercle, et y faire revenir l''oignon et les aubergines à feux vif en mélangeant activement. ', 'Lorsque les oignons et les aubergines ont changé de couleur, ajouter un verre d''eau à la préparation.', 'Baisser le feu, couvrir. Mélanger régulièrement. ', 'Lorsque l''eau est pratiquement évaporée, ajouter la pulpe de tomates, les herbes de Provence, ajouter poivre et sel à votre convenance et mélanger le tout. ', 'Couvrir, laisser mijoter à feux doux, en mélangeant toutes les deux/trois minutes. ', 'Émincer le second oignons et le faire revenir dans une poêle huilée. ', 'Ajouter la viande hachée, cuire et assaisonner à votre convenance. Réserver. ', 'Dans une grande casserole d''eau salée, faire cuire les pâtes. ', 'Égoutter les pâtes. Prêt à dresser! ', 'Dans un plat rectangulaire, déposer au fond la viande hachée cuisinée. ', 'Recouvrir de 6 tranches de cheddar. ', 'Au dessus du cheddar, disposer les pâtes en couche uniforme. ', 'Au dessus des pâtes, disposer les aubergines cuisinées en couche épaisse. ', 'Puis, sur le dessus, ajouter l''emmental rapé et les tranches de cheddar préalablement émiettées. ', 'Enfourner. ', 'Quand le cheddar est gratiné, c''est prêt !'], ['Planche à découper', 'Mixeur', 'Balance de cuisine', 'Ouvre-boîte'], ['Gratin de pâtes et aubergines façon burger', 'recettes', 'boisson', 'emmental', 'très facile', 'cuisine', 'oignon', 'aubergine', 'recettes de cuisine', 'entrée', 'testées', 'cheddar', 'bon marché', 'dessert', 'autres pâtes', 'recette', 'café', 'cocktail', 'poivre', 'plat de résistance', 'plat', 'pâtes', 'viande hachée', 'confiserie', 'pulpe de tomate', 'sel'], 'Plat principal', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:57:22.982281', [{'ingredient_id': '3f4cf5ef-162c-41db-a6cb-a7c501fc0a4d', 'quantite': '2'}, {'ingredient_id': 'b690a82e-7633-41ea-ac40-de588848ebb4', 'quantite': '2'}, {'ingredient_id': '568a6487-f530-4749-bcbd-c0dbd363f3ef', 'quantite': '400 g'}, {'ingredient_id': '373071e0-93b8-4aef-80ce-383a5c59c97d', 'quantite': '250 g'}, {'ingredient_id': '6f8a4e88-8ca8-436a-8c96-eec968ab4cb8', 'quantite': '8'}, {'ingredient_id': '851a2f55-5e21-445a-9f67-4d9011fc914d', 'quantite': '200 g'}, {'ingredient_id': 'e508157a-f29b-420e-a1e7-8968b8e8b2d0', 'quantite': '30 g'}, {'ingredient_id': 'a0e166c5-ddd4-4d43-b93d-1abddafb3bcc', 'quantite': '1 cuillères'}, {'ingredient_id': 'd3f83365-7c85-4fdd-9b56-74ced676e74c', 'quantite': ''}, {'ingredient_id': '321846db-35a3-4a95-a37d-ea14012f41f5', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37209, 'Poisson rapide à la provençale', 'ratatouille, poisson, poivre, sel', '10 min', ['Laver les filets de poisson et les essuyer.', 'Beurre un grand moule à gratin et disposer les filets. Saler et poivrer.', 'Verser dessus la ratatouille.', 'Faire cuire au four à 200°C (thermostat 6-7) pendant 20 à 30 min. Servir avec du riz.'], ['Rouleau à pâtisserie', 'Casserole', 'Ouvre-boîte'], ['Poisson rapide à la provençale', 'recettes', 'boisson', 'très facile', 'cuisine', 'recettes de cuisine', 'entrée', 'testées', 'ratatouille', 'bon marché', 'dessert', 'recette', 'poisson', 'cocktail', 'poivre', 'plat de résistance', 'plat', 'poisson facile', 'confiserie', 'sel'], 'Plat principal', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:57:26.731721', [{'ingredient_id': 'd31c56b9-47d0-4170-aed3-0d34fe33a3f7', 'quantite': '1'}, {'ingredient_id': 'b5a1421f-6733-47bf-846e-a7431ae95611', 'quantite': '4'}, {'ingredient_id': 'b34682cd-68e8-469c-981a-0c178e5258c7', 'quantite': ''}, {'ingredient_id': 'adea3321-8731-4986-8b8b-ff2a811f8ddd', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (533832, 'Burger façon royal cheese light', 'moutarde, ketchup, levure de boulanger, oeuf, farine, jaune d''oeuf, graines de sésame, lait écrémé, cornichons, cheddar, oignon, steak haché', '15 min', ['Mélanger la levure dans le lait tiède.', 'Mélanger les 160g de farine blanche l''oeuf et le mélange de lait.

Travailler la pâte puis faire des pâtons les laisser gonfler à 50°C durant 1h', 'Faire la sauce en mélangeant ketchup et moutarde', 'Dorer les pâtons et mettre le sésame par-dessus. Enfourner 15 minutes à 200 degrés.', 'Cuire le steak puis faire le montage du burger.'], ['Rouleau à pâtisserie', 'Mixeur', 'Verre doseur'], ['', 'recettes', 'testées', 'moutarde', 'confiserie', 'boisson', 'Burger façon royal cheese light', 'bon marché', 'dessert', 'très facile', 'cuisine', 'recette', 'plat de résistance', 'plat', 'ketchup', 'entrée', 'recettes de cuisine', 'cocktail'], 'Plat principal', 1586ae1b-6cd8-4cdb-9ae2-b29353f9058a, '2025-09-26T14:57:31.487530', [{'ingredient_id': '0c9b11a1-504b-4672-9cdf-198e902ea32e', 'quantite': '4 cuillères'}, {'ingredient_id': '5686c9c7-bfd7-43b6-90bf-25fde787e429', 'quantite': '4 cuillères'}, {'ingredient_id': '6c5138c2-715c-40a5-bbae-730ea6ef81aa', 'quantite': '1'}, {'ingredient_id': '8c15e752-c0ec-4b9c-878b-49e51e0a67b9', 'quantite': '1'}, {'ingredient_id': 'df5d4ea0-d4ac-45ca-8d3c-8bf614e58cb4', 'quantite': '160 g'}, {'ingredient_id': '29de7a95-b1c7-4a96-9e9a-6b09fa63c2c7', 'quantite': '1'}, {'ingredient_id': '148965ec-d1e3-4f39-bc58-faff37d9ae4f', 'quantite': '4'}, {'ingredient_id': '9b898e2e-fe6b-4436-b2b8-54041359a0d0', 'quantite': '90 ml'}, {'ingredient_id': '76927cb4-6a92-465a-bda0-731bac8a8aa6', 'quantite': ''}, {'ingredient_id': 'eb5a73bb-ef39-4fd6-b770-21549ed480ea', 'quantite': '8'}, {'ingredient_id': '8a9560fb-28a2-47ae-be5a-a52301d41c11', 'quantite': ''}, {'ingredient_id': 'b7c0529b-45ab-4572-871a-0fe114cfd8d2', 'quantite': '480 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20240, 'Pain aux 2 poissons', 'poisson, bouillon, oeuf, crème fraîche, persil, sel, poivre', '15 min', ['Cuire les filets de poisson ensemble dans le court bouillon. ', 'Battre les oeufs, la crème, le persil, le sel et le poivre. Ajouter le poisson en miette.', 'Beurrer un moule à cake, verser la préparation. ', 'Laisser cuire 30 mn à four chaud : Th 6-7'], ['Balance de cuisine', 'Économe'], ['', 'recettes', 'boisson', 'très facile', 'cuisine', 'persil', 'recettes de cuisine', 'entrée', 'testées', 'bon marché', 'dessert', 'recette', 'oeuf', 'Pain aux 2 poissons', 'poisson', 'cocktail', 'poivre', 'plat de résistance', 'plat', 'confiserie', 'bouillon', 'sel', 'crème fraîche'], 'Entrée', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:57:35.184938', [{'ingredient_id': 'a7c5eed7-d66c-474b-a1ef-9f2dad750bab', 'quantite': '2'}, {'ingredient_id': '2e73ba20-0ef5-4209-b70c-9b09959094e9', 'quantite': ''}, {'ingredient_id': 'bb81fa43-1801-437c-ac97-06bded819df9', 'quantite': '3'}, {'ingredient_id': '8fd3d115-bdec-4ad8-a8bd-0420da5d8e74', 'quantite': '20 cl'}, {'ingredient_id': '54d02874-0e3f-45e1-a3a4-25bd4550531a', 'quantite': ''}, {'ingredient_id': '3259eae4-74cb-4a92-a5a8-1aeb475ef729', 'quantite': '2 cuillères'}, {'ingredient_id': 'd66a639a-6b17-4226-8cc1-92f7d1724c19', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33302, 'Blanquette de poisson', 'lieu noir, champignons de Paris, oignon, vin blanc, crème fraîche liquide, poivre, sel, bouquet garni, farine', '10 min', ['Emincer l''oignon et le faire dorer avec un peu de beurre. ', 'Rajouter les champignons égouttés puis le vin blanc et porter à ébullition. ', 'Ajouter ensuite la crème, le bouquet garni, le sel et le poivre. ', 'Mélanger et laisser un peu réduire. ', 'Rincer les filets de poisson, les éponger puis les passer dans la farine (en éliminant l''excédent). ', 'Ajouter les filets dans la cocotte et baisser le feu. Faire cuire 20 mn.'], ['Râpe', 'Pince de cuisine', 'Couteau de chef'], ['recettes', 'boisson', 'très facile', 'cuisine', 'oignon', 'farine', 'lieu noir', 'bouquet garni', 'recettes de cuisine', 'entrée', 'crème fraîche liquide', 'testées', 'bon marché', 'dessert', 'recette', 'vin blanc', 'cocktail', 'poivre', 'plat de résistance', 'champignons de Paris', 'plat', 'confiserie', 'Blanquette de poisson', 'blanquette', 'sel'], 'Plat principal', 0df99173-36d9-4df4-8f86-48f889a4413b, '2025-09-26T14:57:42.295378', [{'ingredient_id': '5c6fbb24-b976-43a0-b5a1-8582211f8729', 'quantite': '600 g'}, {'ingredient_id': '0d919e85-678c-4398-8ef3-69a9aa3a75d2', 'quantite': '400 g'}, {'ingredient_id': 'e0cd078f-5936-431f-b3dd-c5a907598c7e', 'quantite': '1'}, {'ingredient_id': 'd06a96d8-fad7-46ad-bf35-006980eb68cd', 'quantite': '15 cl'}, {'ingredient_id': '3b3c4291-1268-45ad-8676-4104a8536980', 'quantite': '15 cl'}, {'ingredient_id': 'c063f2d5-9280-43d5-8d79-dfd8a2653925', 'quantite': ''}, {'ingredient_id': 'd6fa5a60-75c6-4fdd-aad7-f2af1111021d', 'quantite': ''}, {'ingredient_id': '50f90f89-9ae2-4eab-b875-7c054b2eded1', 'quantite': ''}, {'ingredient_id': '692ea9e9-bc42-443b-9212-89f03af99533', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169362, 'Cheese Burger ou manuburger', 'farine, oeuf, levure de boulanger, sucre, miel, lait, eau, sésame, herbes de Provence, crème fraîche, concentré de tomates, cornichons, oignon blanc, oignon jaune, tabasco, poivre, vinaigre balsamique, gruyère, bleu, reblochon, toastinette, steak, aubergine, tomate, salade, bacon', '40 min', ['Pain :', '- Mélanger la farine et la levure.', '- Ajouter l''eau, le lait et l''oeuf, et mélanger en commençant à pétrir.', '- Ajouter ensuite le sel, le miel, et les herbes de Provence.', '- Pétrir 15 min.', '- Laisser poser 2h, faire les 7 buns, humidifier le haut des buns et y mettre le sésame (ou l''avoine)', '- Laisser poser encore 2h et faire cuire 30min, Th 6-7 200°C.', '> Préparation de la sauce :', '- Hacher menu les oignons et les cornichons', '- Mélanger les à la crême fraiche ou au concentré de tomate.', '- Assaisonner selon votre goût.', '> Assemblage :', '- Couper les buns', '- Les toastés 2 minutes (ou passer les au grill de votre four)', '- Mettre la sauce sur les 2 cotés du bun (chapeau et socle)', '- Mettre 2 tranches de fromage à buger, une de fromage à tartiflette et une d''emmental sur le socle et le chapeau.', '- Mettre une tranche de bleu sur les chapeau', '- Faire chauffer Th 6, de sorte que les fromages fondent.', '- Pendant ce temps faire cuire les steack (selon les modes préféré : bleu, saignant, cuit, bien cuit) et les aubergines.', '- Mettre sur le socle le steack, puis la tranche d''aubergine, la tranche de tomate, une feuille de salade et le chapeau. (si vous faites la variante bacon une tranche, mettez la au dessus du steack, sinon une au dessous et une au dessus)'], ['Râpe', 'Presse-agrumes', 'Économe', 'Planche à découper', 'Poêle'], ['', 'recettes', 'boisson', 'cuisine', 'sucre', 'farine', 'levure de boulanger', 'moyen', 'recettes de cuisine', 'entrée', 'testées', 'dessert', 'recette', 'oeuf', 'cocktail', 'Cheese Burger ou manuburger', 'lait', 'herbes de Provence', 'plat de résistance', 'eau', 'miel', 'plat', 'confiserie', 'moyenne', 'sésame'], 'Plat principal', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:57:46.484300', [{'ingredient_id': 'a507337f-9efc-4078-898d-14b441005a42', 'quantite': '800 g'}, {'ingredient_id': '78d278e4-b815-48ed-85c8-73476fbbaa91', 'quantite': '1'}, {'ingredient_id': '39f01b26-100b-4bff-b5bf-3722cd565b91', 'quantite': '4'}, {'ingredient_id': '51f1b506-8e09-40fc-b007-5dff7b0bd1b1', 'quantite': '1'}, {'ingredient_id': '21404b40-ad44-45b0-8550-749eeec86863', 'quantite': ''}, {'ingredient_id': '9ed3eb99-a002-4ee4-bf90-c58d8d9bba40', 'quantite': '20 cl'}, {'ingredient_id': '5af2ace9-44d4-4233-b2a1-13b0d6f449b1', 'quantite': '25 cl'}, {'ingredient_id': '11f52d1c-1225-438e-b558-38ea2b5254ad', 'quantite': ''}, {'ingredient_id': 'a7e0536c-ed07-4930-85dc-88d85e82d167', 'quantite': ''}, {'ingredient_id': 'f6138f67-c803-4513-bd2a-1dc60bea058e', 'quantite': '250 g'}, {'ingredient_id': '56fa2c61-da5c-41b2-9550-bae367962e17', 'quantite': ''}, {'ingredient_id': '31014920-585f-4ab4-b9ba-3cd92ffeeacb', 'quantite': '50 g'}, {'ingredient_id': 'e2c68c93-bec6-4795-b682-3fc750ce8bdd', 'quantite': '1'}, {'ingredient_id': '16f3c6af-0337-4f1d-8701-ff9bceedebd0', 'quantite': '1'}, {'ingredient_id': 'f117d164-97a1-4e6e-b11f-68c424d9d933', 'quantite': ''}, {'ingredient_id': '7cf8af12-43fe-4325-a3cc-c5e99f16574c', 'quantite': ''}, {'ingredient_id': '29d1cd27-7e0f-48a3-9c6b-b4a34f2e3b6f', 'quantite': '1'}, {'ingredient_id': '4fe6207a-6347-4b5e-b757-ab1dfd6dd578', 'quantite': '14'}, {'ingredient_id': '17cdd4ca-1492-4695-9748-e0d2f4f1801e', 'quantite': '7'}, {'ingredient_id': 'cbc9b51d-4b1b-47e8-a9f2-b86118a4ba03', 'quantite': '14'}, {'ingredient_id': '946c1cb4-f88e-44ec-86cf-c5662a622c79', 'quantite': '28'}, {'ingredient_id': 'bd0c717c-43fd-4310-b077-fdedcf2ae14c', 'quantite': '7'}, {'ingredient_id': '54dc885d-685a-4deb-8ce7-a54e2bd93262', 'quantite': '7'}, {'ingredient_id': '082de42f-ac68-4d61-a6e5-1cea1ec06c5a', 'quantite': '7'}, {'ingredient_id': '46632a90-1e5b-4370-9e9d-ef20c388027a', 'quantite': '7'}, {'ingredient_id': 'ec246f7a-8eae-4953-ba61-6a7cdb9d71a5', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (91402, 'Sauce beurre citron rapide pour poissons', 'beurre, crème fraîche, jus de citron, ciboulette', '5 min', ['Dans un récipient allant au micro onde, mettre le beurre et faire fondre 1 minute puissance 800 watts.', 'Ajouter la crème fraîche, puis remettre au micro-ondes durant 1 minute puissance 800 watts.', 'Ajouter le jus de citron et la ciboulette (plus ou moins selon les goûts), assaisonner avec poivre et sel, c''est prêt !!'], ['Couteau de chef', 'Louche', 'Balance de cuisine'], ['recettes', 'boisson', 'Sauce beurre citron rapide pour poissons', 'très facile', 'cuisine', 'ciboulette', 'beurre', 'recettes de cuisine', 'entrée', 'testées', 'jus de citron', 'bon marché', 'dessert', 'recette', 'rapide', 'cocktail', 'plat de résistance', 'plat', 'confiserie', 'crème fraîche', 'Autres sauces'], 'Sauce', 2f4ed75c-7332-4c88-9dee-8fd7d19893de, '2025-09-26T14:57:51.346573', [{'ingredient_id': '033896eb-ace7-40ab-8337-5ad6c38a3162', 'quantite': '15 g'}, {'ingredient_id': '1daa34b3-f20a-4b9f-95ba-e5e9c9e72df3', 'quantite': '10 cl'}, {'ingredient_id': '6de52666-bba5-4991-b87a-97c69243a59a', 'quantite': '1 cuillères'}, {'ingredient_id': 'ed888989-6075-4bdc-b5c9-8fa835d10c5d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70522, 'Sauce au beurre blanc pour poisson', 'échalote, crème fraîche, beurre, vin blanc sec, citron', '5 min', ['Couper finement une échalote.', 'Dans une casserole, sur feu doux, faire suer l’échalote avec ½  verre de vin blanc et le jus d’un demi-citron. Laisser un peu évaporer le vin et le citron. ', 'On peut exécuter cette étape un peu à l’avance, pendant la cuisson du poisson par exemple.', 'Au moment de servir, faire fondre 30 à 40 grammes de beurre dans la sauce, puis délayer avec 10 cl de crème fraîche.'], ['Passoire', 'Planche à découper'], ['recettes', 'boisson', 'très facile', 'cuisine', 'beurre', 'recettes de cuisine', 'vin blanc sec', 'entrée', 'testées', 'bon marché', 'dessert', 'recette', 'Sauce au beurre blanc pour poisson', 'rapide', 'cocktail', 'plat de résistance', 'plat', 'échalote', 'citron', 'confiserie', 'crème fraîche', 'Autres sauces'], 'Sauce', 8e1b8740-e33c-4763-9199-45d0dbd8510d, '2025-09-26T14:57:58.259981', [{'ingredient_id': 'a10dc628-3eb2-47df-b7ec-c9b7cb654980', 'quantite': '1'}, {'ingredient_id': 'd62b9d50-c912-4b37-aad0-6df2536782ea', 'quantite': '10 cl'}, {'ingredient_id': 'b04c4a97-b423-4497-94d6-ea55b33a9e7a', 'quantite': '40 g'}, {'ingredient_id': '2d2617a2-dbb9-48af-82cb-d5cbe9c432bd', 'quantite': ''}, {'ingredient_id': '77c5be0c-1742-45f5-936b-13cba8a26116', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (334656, 'Gaufre burger aux oeufs Bénédicte', 'oeuf, bacon, sauce hollandaise, farine, oeuf, beurre, lait, sel', '20 min', ['Pour réaliser cette recette, il faut être muni d''un gaufrier qui puisse des formes rondes.', 'Commencer par réaliser une sauce hollandaise. (recette Marmiton)', 'Faire une pâte à gaufres classique, non sucrée. ', 'Pour cela, mélanger la farine, les jaunes d''oeufs, le beurre ramolli et le sel. ', 'Délayer peu à peu le tout en y ajoutant le lait, mélanger jusqu''à ce que le mélange soit bien homogène. ', 'Battre les blancs en neige et les ajouter au restant en remuant délicatement.', 'Laisser reposer la pâte quelques minutes le temps de faire le reste. ', 'Pocher les oeufs.', 'Faire dorer le bacon quelques minutes à la poêle. ', 'Faire les gaufres : verser la pâte dans l’appareil, le fermer et laisser cuire le temps indiqué (cela doit être assez rapide).', 'Pour le montage : prendre une gaufre, recouvrir d''une tranche de bacon, puis d''un oeuf poché, napper généreusement de sauce hollandaise puis recouvrir à nouveau d''une gaufre.'], ['Fouet', 'Verre doseur'], ['', 'recettes', 'boisson', 'cuisine', 'sauce hollandaise', 'recettes de cuisine', 'entrée', 'testées', 'bon marché', 'dessert', 'recette', 'oeuf', 'rapide', 'cocktail', 'plat de résistance', 'plat', 'bacon', 'confiserie', 'facile', 'Gaufre burger aux oeufs Bénédicte'], 'Plat principal', 93c9dfc7-020c-41d5-9d4e-c3356d0f55e1, '2025-09-26T14:58:03.540808', [{'ingredient_id': '82fa9274-7b22-45df-91ee-e338c9ed7c3f', 'quantite': '5'}, {'ingredient_id': '982f0508-f0f3-4506-8993-3c05c5a3ff3a', 'quantite': '5'}, {'ingredient_id': 'c5e737f1-b61c-4f83-8f3f-35e8bcf67d3a', 'quantite': '25 cl'}, {'ingredient_id': 'b1666f1d-0fd3-4ad3-a9e4-512b1fc5f1b3', 'quantite': '200 g'}, {'ingredient_id': '962c11d6-3ceb-4c81-abc3-6f98a40f975e', 'quantite': '3'}, {'ingredient_id': '84436208-1f51-4ce3-af07-f1092b4b51cb', 'quantite': '20 g'}, {'ingredient_id': '8f184689-0b52-4c0c-a0e6-726b71f2e8e2', 'quantite': '25 cl'}, {'ingredient_id': '3cd12395-b4f7-41ef-acfd-6dff66e6c0c5', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528382, 'Burger comté sauce poivre', 'pain pour hamburger, beurre, crème fraîche, poivre, beurre, échalote, sucre, eau, oignon, steak haché, comté, salade, cornichons, sel, poivre', '60 min', ['Commencer par préparer la sauce, faite fondre le beurre à feu doux et y incorporer la crème fraîche.', 'Passer les grains de poivre au mortier et pilon grossièrement et les ajouter à la casserole. 
Laissez mijoter à feu doux pendant 20min en remuant de temps en temps afin de faire épaissir la sauce.', 'Saler à convenance en goutant de temps en temps.', 'Passer les pains à hamburgers au grille pain afin de les faire dorer.', 'Dans une poêle, déposer la noisette de beurre et la faire fondre à feu vif afin d''avoir un beurre en ébullition. 
Y ajouter les échalotes émincées finement et faire sauter.', 'Lorsqu''elles sont bien dorées, parsemer de sucre et refaire sauter. 
Lorsqu''elles commencent à accrocher à la poêle, verser un peu d''eau pour déglacer et faire caraméliser les échalotes. Répéter le déglaçage autant de fois que nécessaire selon le type de caramélisation voulue (+ de déglaçage = + caramélisé) puis réserver à feu très doux juste pour y garder la chaleur.', 'Couper des rondelles dans l''oignon.', 'Et dans une assiette, aplatir doucement à la main les steaks hachés afin qu''ils soient fins entre 5mm et 1cm et il doivent être légèrement plus large que les pains.', 'Essayer au maximum de garder la forme du steak.', 'Faites chauffer une poêle à feu très vif. 
Une fois la poêle très chaude, déposez y vos steaks hachés sans matière grasse. La poêle très chaude va les faire griller très vite et ça ne va normalement pas accrocher.', 'Retourner les steaks hachés selon la cuisson voulue en salant et poivrant ces derniers.', 'Pendant la cuisson des steaks hachés. Disposer le bas du pain sur une assiette et y mettre de la sauce, des échalotes caramélisées, un peu de salade et une tranche de comté affiné.', 'Un peu avant la fin de la cuisson des steaks, mettre à feu doux, déposer une tranche de comté affiné directement sur chaque steaks et couvrir la poêle.', 'Surveiller et retirer du feu lorsque le fromage est fondu. Déposer alors le steaks sur la tranche de comté qui est sur le burger.', 'Sur le steak haché, ajouter les cornichons coupés en lamelles, une rondelle de tomate, deux rondelles d''oignons.', 'Tartiner le pain du haut de sauce au poivre et y mettre un peu de salade (qui devrait tenir grâce à la sauce). Mettre le pain du haut sur le burger déjà préparé, planter le burger entier d''un couteau en son centre et vous régaler.'], ['Fouet', 'Couteau de chef', 'Mixeur', 'Poêle'], ['recettes', 'viande', 'pain pour hamburger', 'boisson', 'cuisine', 'sucre', 'oignon', 'beurre', 'recettes de cuisine', 'entrée', 'testées', 'bon marché', 'dessert', 'recette', 'cocktail', 'poivre', 'plat de résistance', 'salade', 'eau', 'plat', 'Burger comté sauce poivre', 'échalote', 'confiserie', 'steak haché', 'cornichons', 'sel', 'comté', 'crème fraîche', 'facile'], 'Plat principal', a2efbbf6-bde9-49eb-a8ac-212edc6a52b6, '2025-09-26T14:58:08.721200', [{'ingredient_id': '5485aff4-724d-4fb4-84c5-68ca3eec3f94', 'quantite': '2'}, {'ingredient_id': '76687fac-1e6e-45f1-9da7-115a184d658d', 'quantite': '30 g'}, {'ingredient_id': '854c3222-5ce8-4b97-8e00-5beee8e4f39f', 'quantite': '25 cl'}, {'ingredient_id': '0278a2b2-8ae0-4315-815d-046e286bb11d', 'quantite': '3 cuillères'}, {'ingredient_id': 'c071fb26-509f-466d-9cd4-171fb42000bd', 'quantite': '1'}, {'ingredient_id': '1e561b55-933a-49fb-9b62-56ab92863e15', 'quantite': '2'}, {'ingredient_id': '069c653b-edb3-4934-bc8d-94f221512efb', 'quantite': '2 cuillères'}, {'ingredient_id': '67258e00-faa1-40b8-bf31-30566eee079c', 'quantite': '1'}, {'ingredient_id': '3e79a4dc-1a9a-44e7-a00c-2314a500e5af', 'quantite': '1'}, {'ingredient_id': 'ec60603f-379a-4647-b813-e7af7cf4b544', 'quantite': '2'}, {'ingredient_id': '9aafc2cb-b48b-42cb-b54f-42d60830c255', 'quantite': '4'}, {'ingredient_id': '467b027c-c01e-44d9-993c-e51fd7b88fb9', 'quantite': '50 g'}, {'ingredient_id': 'aae3478b-1ba5-4f97-ab4d-1ce30a012e91', 'quantite': '6'}, {'ingredient_id': '54ae7e23-cbe5-4613-b5b7-4522c5e37306', 'quantite': ''}, {'ingredient_id': '965012e6-eccb-45d6-ada1-2bc2640ca811', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23052, 'Gratin de poisson et de fruits de mer', 'poisson, langoustine, crevettes, moules, champignon, beurre, crabe, béchamel, crème fraîche, gruyère râpé', '10 min', ['Préchauffez le four à 210°C (thermostat 7).', 'Faites fondre les champignons émincés dans le beurre.', 'Détaillez le poisson en morceaux et disposez-le dans un plat à gratin huilé avec les champignons, les moules, les crevetes, les langoustines et la chair de crabe.', 'Mélangez la béchamel avec la crème et le fromage puis nappez-en le plat. ', 'Enfournez 15 minutes jusqu''à ce que le dessus soit gratiné.'], ['Couteau de chef', 'Poêle', 'Mixeur', 'Batteur électrique'], ['recettes', 'boisson', 'champignon', 'cuisine', 'crevettes', 'béchamel', 'moyen', 'beurre', 'recettes de cuisine', 'entrée', 'poisson au four', 'crabe', 'testées', 'dessert', 'recette', 'poisson', 'gruyère râpé', 'Gratin de poisson et de fruits de mer', 'cocktail', 'plat de résistance', 'plat', 'confiserie', 'langoustine', 'moules', 'crème fraîche', 'facile'], 'Plat principal', e3f50fed-c007-4bd2-9aec-652f64903c9f, '2025-09-26T14:58:12.436356', [{'ingredient_id': '94845b3b-a68d-4d7f-a4fb-709dd07cc551', 'quantite': '100 g'}, {'ingredient_id': '75e9dc85-080a-4ab7-bd25-3e7b0fa908d8', 'quantite': '150 g'}, {'ingredient_id': '2667acbd-da1a-4451-b65c-47ec56ae2c95', 'quantite': '100 g'}, {'ingredient_id': '30c6d4e6-0c20-4fe8-bc75-6fb22724b456', 'quantite': '500 g'}, {'ingredient_id': '6e4e82dd-590d-4ff8-81db-2c812ed8f019', 'quantite': '50 g'}, {'ingredient_id': 'ed561800-191b-4cf1-bfdc-485912484f51', 'quantite': '10 g'}, {'ingredient_id': '4d15bb8f-701c-4763-98b3-5adc1833a118', 'quantite': '1'}, {'ingredient_id': '4d27e9f6-eee6-4ac4-aa12-35386d3f9593', 'quantite': '12 cl'}, {'ingredient_id': '6c4681ff-f67f-469b-80be-185af2bf0283', 'quantite': '50 g'}, {'ingredient_id': '099044d2-5dc9-4323-90dc-f73377b3967c', 'quantite': '25 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (533829, 'Wrap Burger', 'tomate, cornichons, steak, cheddar, bacon, salade, skyr, farine, ketchup, moutarde', '15 min', ['Travailler le mélange Skyr et farine', 'Cuire la pâte dans une poêle', 'Cuire les viandes', 'Mélanger pour la sauce', 'Monter le burger avec le cheddar, la salade, la tomate et les cornichons'], ['Casserole', 'Poêle', 'Couteau de chef'], ['', 'Wrap Burger', 'recettes', 'boisson', 'très facile', 'cuisine', 'recettes de cuisine', 'entrée', 'testées', 'cheddar', 'bon marché', 'dessert', 'recette', 'rapide', 'cocktail', 'plat de résistance', 'salade', 'steak', 'plat', 'bacon', 'confiserie', 'cornichons', 'tomate'], 'Plat principal', 1586ae1b-6cd8-4cdb-9ae2-b29353f9058a, '2025-09-26T14:58:17.086297', [{'ingredient_id': '2af464e3-9570-4d09-9606-f3607d4a6edd', 'quantite': ''}, {'ingredient_id': '850cbdaf-7cbe-4c91-a6de-22b2419e7cb4', 'quantite': ''}, {'ingredient_id': '859af99e-6fad-4c09-a450-ed2a376532c6', 'quantite': '300 g'}, {'ingredient_id': 'd09c27c6-57ba-4830-a0d6-0a0f05c1caf9', 'quantite': '3'}, {'ingredient_id': 'e3de1753-7307-463a-9da6-696559b8e157', 'quantite': '6'}, {'ingredient_id': 'caa6ea41-b480-4ade-8945-265c2fe371c4', 'quantite': ''}, {'ingredient_id': '017bd470-d927-48e7-8cfd-2ff167718953', 'quantite': '140 g'}, {'ingredient_id': '834b33ce-49fd-4771-aa3b-0e1eaf615ca9', 'quantite': '120 g'}, {'ingredient_id': '3a393f99-cff3-452c-a0ac-082efb7ab619', 'quantite': '3 cuillères'}, {'ingredient_id': 'eb674fa3-b97a-408d-840d-b1b5b71c08be', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55375, 'Papillote de poisson saveur', 'lieu noir, tomate, courgette, oignon, ail, pesto, poivre, sel', '30 min', ['Faire suer l''oignon et l''ail avec 1c à soupe d''huile d''olive.', 'Ajouter les tomates en dés et la courgette râpée grossièrement ainsi que le pesto, sel et poivre.', 'laisser mijoter +/- 5 minutes.', 'Préparer 4 rectangles d''alu et un grand plat pour le four. Dresser sur chaque rectangle la sauce tomates-courgette et le filet de cabillaud par dessus. Refermer la feuille d''alu en papillote et mettre au four +/- 20 minutes à 200°C (thermostat 6-7).', 'Servir directement soit dans la papillote ou accompagné de riz.'], ['Verre doseur', 'Moule à tarte', 'Spatule', 'Râpe'], ['recettes', 'boisson', 'très facile', 'cuisine', 'oignon', 'courgette', 'lieu noir', 'recettes de cuisine', 'entrée', 'pesto', 'testées', 'bon marché', 'dessert', 'recette', 'poisson en papillote', 'cocktail', 'poivre', 'ail', 'plat de résistance', 'Papillote de poisson saveur', 'plat', 'confiserie', 'tomate', 'sel'], 'Plat principal', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:58:20.746879', [{'ingredient_id': '3b192e4e-337f-4abf-b627-aa2927127f14', 'quantite': '4'}, {'ingredient_id': '90e81d37-8b1d-4c13-a34b-13cb5f3ff2ef', 'quantite': '3'}, {'ingredient_id': '24613daa-dad5-405b-af84-aad250f83fef', 'quantite': '1'}, {'ingredient_id': 'e72aa684-e1d0-4861-9b24-63d89be0c758', 'quantite': '1'}, {'ingredient_id': '6181c37b-d77a-4b6c-8d0f-cfe39f585414', 'quantite': '1'}, {'ingredient_id': 'e52bf94b-e331-40d4-bdfd-eea5ca5f7f58', 'quantite': '2 cuillères'}, {'ingredient_id': 'd946b7e8-4466-4a70-ac7f-d910bd1b7e19', 'quantite': ''}, {'ingredient_id': 'c22cbba9-d0ee-45a7-8b8c-3ebb6a8a9320', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20476, 'Filets de poissons à la moutarde', 'poisson, moutarde de Dijon, crème fraîche allégée, cornichons, poivre, sel', '5 min', ['Disposez les filets dans un plat beurré. Salez et poivrez légèrement. ', 'Enfournez 10 mn dans un four préchauffé à thermostat 7 (210°C). ', 'Videz l''eau rendue.', 'Nappez du mélange crème, moutarde et cornichons. Remettez à cuire 10 mn.'], ['Moule à tarte', 'Poêle', 'Ouvre-boîte'], ['recettes', 'boisson', 'très facile', 'cuisine', 'recettes de cuisine', 'entrée', 'testées', 'bon marché', 'dessert', 'recette', 'Filets de poissons à la moutarde', 'rapide', 'poisson', 'cocktail', 'poivre', 'plat de résistance', 'crème fraîche allégée', 'plat', 'confiserie', 'moutarde de Dijon', 'filets de poisson', 'cornichons', 'sel'], 'Plat principal', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:58:27.659109', [{'ingredient_id': '00f7ebdf-6721-43ba-8de0-63968d0bffc6', 'quantite': '6'}, {'ingredient_id': 'e6fa6d5c-f0d2-4179-b87a-0e1d92964ad7', 'quantite': '2'}, {'ingredient_id': '84a87bf8-fb87-4382-9d9e-b25d49aa0b33', 'quantite': '2'}, {'ingredient_id': '9ff3716f-0bfd-4c96-b7dd-e961c7fd4fd1', 'quantite': '1 cuillères'}, {'ingredient_id': 'bebd0bce-a4fb-47ca-b779-a2a44efaf8f1', 'quantite': ''}, {'ingredient_id': '368b0be1-762f-46a8-9ba4-99093e6b9eca', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (71092, 'Burger au saumon fumé - crème de ciboulette', 'saumon fumé, pain pour hamburger, crème fraîche épaisse, ciboulette, oignon rouge, concombre, salade, poivre, sel, tabasco, avocat, cornichons', '10 min', ['Préparer la crème de ciboulette:', '- mélanger à même le pot la crème fraîche avec la ciboulette ciselée, le poivre (du moulin !), le sel et 10 gouttes de tabasco.', '- tartiner une légère couche sur la moitié basse du pain à burger.', 'Dresser le burger:', '- déposer sur chaque moitié de pain tartiné quelques feuilles de salade, des lamelles de concombre épluché (et/ou d''avocat), des lamelles d''oignon rouge épluché, une tranche de saumon plié de façon à ce qu''elle ne dépasse pas du burger, et déposer une bonne cuillère de crème de ciboulette.', '- refermer avec le chapeau du pain à burger et déposer dessus une moitié de cornichon coupé dans la longueur, piqué-le dans le burger pour le maintenir en place.', '- servir dans les assiettes avec le reste de salade.'], ['Passoire', 'Moule à tarte', 'Balance de cuisine'], ['', 'recettes', 'pain pour hamburger', 'boisson', 'très facile', 'avocat', 'cuisine', 'ciboulette', 'concombre', 'moyen', 'recettes de cuisine', 'entrée', 'testées', 'crème fraîche épaisse', 'dessert', 'recette', 'rapide', 'cocktail', 'poivre', 'Burger au saumon fumé - crème de ciboulette', 'plat de résistance', 'salade', 'tabasco', 'plat', 'confiserie', 'oignon rouge', 'saumon fumé', 'cornichons', 'sel'], 'Plat principal', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:58:31.393667', [{'ingredient_id': '21131438-8519-464c-99bb-1c428cba69e5', 'quantite': '6'}, {'ingredient_id': 'ad6494c0-e1c6-4b03-a7d7-1221c790a652', 'quantite': '6'}, {'ingredient_id': '4afd796c-7517-47f1-9a14-48dc04859846', 'quantite': '1'}, {'ingredient_id': '69305413-ee6d-4bb5-824c-fd2a86c5905e', 'quantite': '4 cuillères'}, {'ingredient_id': '8ccb1262-ed82-4900-b310-a1418da4268a', 'quantite': '1'}, {'ingredient_id': '69a7392f-864c-45c1-826d-dcce76f1e0fd', 'quantite': ''}, {'ingredient_id': '0e3213a8-dd22-41b1-8743-22b1f13cf0fe', 'quantite': ''}, {'ingredient_id': 'a975fd3e-03fe-4657-89ca-5370d8c9a4a5', 'quantite': ''}, {'ingredient_id': '85e3f135-c21e-44c6-9872-2923f14f8aef', 'quantite': ''}, {'ingredient_id': '37d9d0ac-9f28-4b7c-8903-46a1b1f2eb86', 'quantite': ''}, {'ingredient_id': 'dd81659f-a448-4020-870f-804f779c71c2', 'quantite': '1'}, {'ingredient_id': '0d5287f0-b63f-43e4-ba38-de2f87976dd7', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (83749, 'Velouté de champignons express (champignons en boîte)', 'champignons de Paris, eau, crème liquide, beurre, pain, ail, persil, cube de bouillon, kub or, madère', '20 min', ['Commencer par égoutter vos champignons, ensuite mettre le beurre à fondre dans une poêle et ajouter les champignons, les laisser rendre leur eau environ 5 min.', 'Quand il n''y a plus d''eau dans la poêle et qu''ils commencent à dorer ajouter l''ail le persil et le kub OR, laisser  encore mijoter 5 min.', 'Mettre l''eau à bouillir avec les 2 cube de bouillon de boeuf, pendant ce temps ôter la croute de votre pain afin de n''en garder que la mie ensuite couper le pain en gros cube.', 'Quand votre bouillon bout y ajouter vos champignons puis vos cube de pain sec. Laisser encore cuire 5 min puis mixer le tout, ajouter ensuite la brique de crème liquide.', 'Servez tel quel avec quelque crouton de pain c''est délicieux.'], ['Louche', 'Verre doseur', 'Balance de cuisine', 'Passoire', 'Rouleau à pâtisserie'], ['pain', 'cube de bouillon', 'recettes', 'boisson', 'très facile', 'cuisine', 'beurre', 'persil', 'recettes de cuisine', 'entrée', 'testées', 'madère', 'bon marché', 'dessert', 'recette', 'soupe', 'cocktail', 'crème liquide', 'ail', 'plat de résistance', 'eau', 'champignons de Paris', 'plat', 'confiserie', 'kub or', 'Velouté de champignons express (champignons en boîte)'], 'Entrée', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:58:35.163371', [{'ingredient_id': '63b50dfb-7562-4e16-8885-8a6935a76645', 'quantite': '460 g'}, {'ingredient_id': '71bdf55f-ab6a-46a4-baf0-8c9abba2738e', 'quantite': '1.5 l'}, {'ingredient_id': '581f1215-04c4-46f5-9675-5a07b831f916', 'quantite': '25 cl'}, {'ingredient_id': '897149d2-b855-4905-895d-7e7f7922dcd6', 'quantite': '30 g'}, {'ingredient_id': '99822183-c52a-4641-8229-e90f704d78f6', 'quantite': '1'}, {'ingredient_id': 'b89a8a16-4cb5-4bd2-bd77-f97d755f532b', 'quantite': '1 cuillères'}, {'ingredient_id': '1fae9284-6bc8-475c-b5de-8c9d656c61c0', 'quantite': '1 cuillères'}, {'ingredient_id': 'e7298a73-2554-4701-8cb3-ff36a6dcca51', 'quantite': '2'}, {'ingredient_id': 'c3ee7edf-995b-49ff-95cb-306133b0746d', 'quantite': '1'}, {'ingredient_id': '99088208-f2a4-48b6-8763-250cad909103', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (533828, 'Burger maison façon CBO', 'bacon, lait écrémé, graines de sésame, jaune d''oeuf, levure de boulanger, oeuf, farine de blé, cheddar, Oignons frits, salade, viande hachée, crème allégée, carré frais, moutarde, Oignons frits', '25 min', ['PAIN : 
mettre dans 90 ml de lait écrémé tiède le sachet de levure boulangère et bien mélanger. Ajouter à cette préparation 160g de farine blanche et 1 oeuf. Mélanger. 

Découper les 6  pâtons et les mettre à plat sur une grille au four à 50 °C', 'Laisser la pâte lever puis mettre le jaune d’oeuf pour la dorure et placer les pincées de graines de sésame sur le dessus et 4 pincées d’allumettes de bacon en dés.', 'Faire cuire les pains15 min à 200 degrés', 'Mélanger les ingrédients de la sauce ', 'Après avoir fait cuire le bacon et la viande hachée, ajouter la sauce et le cheddar, la salade et les oignons dans le burger.'], ['Ouvre-boîte', 'Casserole', 'Verre doseur'], ['', 'bacon', 'recettes', 'testées', 'confiserie', 'boisson', 'bon marché', 'Burger maison façon CBO', 'très facile', 'cuisine', 'recette', 'dessert', 'plat de résistance', 'plat', 'recettes de cuisine', 'entrée', 'cocktail'], 'Plat principal', 1586ae1b-6cd8-4cdb-9ae2-b29353f9058a, '2025-09-26T14:58:39.645414', [{'ingredient_id': '0f65fc89-d766-4137-a2fd-0b185969d774', 'quantite': '3'}, {'ingredient_id': '6fd46829-5b6d-4587-8be8-d7ffa9346344', 'quantite': '90 ml'}, {'ingredient_id': '7c4e7dfc-b714-4bc4-9689-076a599deff2', 'quantite': '3'}, {'ingredient_id': 'c11f6c52-44ea-4314-8a04-f8657c025609', 'quantite': '1'}, {'ingredient_id': '7cbb2799-600e-415d-a892-cb9862012c16', 'quantite': '1'}, {'ingredient_id': '74c1d42f-7600-4a09-bf39-43e5b28b9eee', 'quantite': '1'}, {'ingredient_id': '657837ce-9540-4690-8084-28d58b054b15', 'quantite': '160 g'}, {'ingredient_id': 'e15b7450-ffc9-462b-8b96-c4735a5492b7', 'quantite': '3'}, {'ingredient_id': 'd96ec3c7-a2ae-4158-bff9-c752356b3c47', 'quantite': '3'}, {'ingredient_id': '8716e238-a8b4-433e-8ef9-a9badd400d28', 'quantite': '6'}, {'ingredient_id': 'e0b3bb3b-b283-459d-94b2-8b85c14ae802', 'quantite': '350 g'}, {'ingredient_id': 'ab71c810-d6dc-4c98-91c5-978de92c88e0', 'quantite': '7 cl'}, {'ingredient_id': '0d781bf0-c617-481d-a6cd-1a9f9b7ca191', 'quantite': '2'}, {'ingredient_id': 'fdf3fc1a-c8db-4fca-b640-3e46d68623b2', 'quantite': '1 cuillères'}, {'ingredient_id': '81a9f47d-1829-45b5-8a41-265a1977fb19', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17271, 'Tranches de poisson à la bisque de homard', 'poisson, beurre, fromage râpé, crème fraîche épaisse, homard, chapelure', '15 min', ['Etalez les filets de poisson à plat et y mettre une noix de beurre avec un peu de fromage râpé à l''intérieur, puis rouler le poisson et le fermer avec un pic à dent. ', 'La sauce : ', 'préparer un pot de crème fraîche épaisse mélanger avec la bisque de homard cela donne une mousse onctueuse. ', 'Placer le poisson dans un plat puis ajouter la sauce, parsemez le dessus d''un un peu de chapelure à dorer. Mettre à four 180°C pendant 30 mn. En fin de cuisson ajouter un peu de fromage râpé et faire dorer.'], ['Râpe', 'Poêle'], ['', 'recettes', 'boisson', 'homard', 'très facile', 'cuisine', 'beurre', 'recettes de cuisine', 'entrée', 'testées', 'crème fraîche épaisse', 'bon marché', 'dessert', 'recette', 'poisson', 'cocktail', 'chapelure', 'plat de résistance', 'plat', 'Tranches de poisson à la bisque de homard', 'confiserie', 'fromage râpé'], 'Plat principal', 17ea5a47-123a-48b4-9598-fa62142d5b01, '2025-09-26T14:58:43.522364', [{'ingredient_id': 'bf553b54-7f20-4c7d-a68e-18efeb76c0cf', 'quantite': '6'}, {'ingredient_id': '98ce5292-fdde-46dc-bd73-2fac4be8a612', 'quantite': ''}, {'ingredient_id': '8c800fef-ad17-44ee-8e87-7e4a73477c1b', 'quantite': ''}, {'ingredient_id': '84cf0e54-f9d4-411d-8f7e-ae5ef3a63246', 'quantite': '1'}, {'ingredient_id': 'ab21b44d-2c58-471a-9ea3-01e9c5f2633a', 'quantite': '1'}, {'ingredient_id': 'b1b9e075-35e1-4961-8688-0564c6e55539', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (346040, 'Burger de polenta', 'eau, lait, cube de bouillon, polenta, safran, muscade, beurre, fromage râpé, mozzarella, saumon fumé, crème fraîche, ciboulette, poivre, sel', '30 min', ['Préparation de la polenta.', 'Porter l''eau et le lait à ébullition avec les cubes de bouillon de légumes.', 'Ajouter la polenta, le safran et la muscade, faire cuire à petit feu en remuant de temps en temps.', 'Ajouter le beurre, le fromage râpé et la mozzarella coupée en petits dés. Mélanger, verser dans un plat à gratin préalablement beurré.', 'Parsemer de 2 à 3 cuillères à soupe de fromage râpé.', 'Cuire 20 min au four préchauffé à 220°C (thermostat 8).', 'Préparation de la crème ciboulette.', 'Mélanger la crème avec la ciboulette ciselée, saler et poivrer. ', 'Dressage du burger.', 'Une galette de polenta, de la chiffonnade de saumon, de la crème ciboulette et une galette de polenta.'], ['Fouet', 'Presse-agrumes', 'Moule à tarte'], ['safran', 'recettes', 'cube de bouillon', 'boisson', 'cuisine', 'polenta', 'Burger de polenta', 'beurre', 'recettes de cuisine', 'entrée', 'testées', 'bon marché', 'dessert', 'recette', 'muscade', 'cocktail', 'lait', 'plat de résistance', 'eau', 'plat', 'mozzarella', 'confiserie', 'facile', 'fromage râpé'], 'Plat principal', ea519efe-5447-4060-bb84-89be5fe30847, '2025-09-26T14:58:48.507362', [{'ingredient_id': '21bfbff4-6fbc-421a-956e-af49d1596830', 'quantite': '25 cl'}, {'ingredient_id': 'a5cfa49d-7db1-4963-b157-34142316b04e', 'quantite': '25 cl'}, {'ingredient_id': '7e698a74-dea3-46c8-aa07-f0c30aff5f03', 'quantite': '1'}, {'ingredient_id': '906a580b-4baa-4aba-b5e5-269b0f891e61', 'quantite': '100 g'}, {'ingredient_id': '7ad16ac8-39b5-482c-adbd-72c436dfb1d5', 'quantite': '1'}, {'ingredient_id': 'd6a77321-7fba-419d-a1da-7b3bff94022f', 'quantite': '1'}, {'ingredient_id': '15e747a5-b861-439f-967a-2441901904d1', 'quantite': '25 g'}, {'ingredient_id': '0c55de8c-0711-44f0-b9fc-8e08a7587a9b', 'quantite': '25 g'}, {'ingredient_id': '9f5bc1c6-1910-4a88-bdc3-364cc73d89b4', 'quantite': '125 g'}, {'ingredient_id': '663bf23b-c447-4ae5-b6b3-1a7fe7249ca4', 'quantite': '4'}, {'ingredient_id': '42d8e8ae-bbb1-4b49-851f-254d53fb830a', 'quantite': '5 cuillères'}, {'ingredient_id': '9a40c267-6920-42b6-b78e-8f88f607b9bb', 'quantite': ''}, {'ingredient_id': '43332236-3f17-448f-963b-a00714eea30d', 'quantite': ''}, {'ingredient_id': 'c876f6f2-50a1-4a9e-96f9-723ff5a47498', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32311, 'Poisson au gingembre à la vapeur (Chine)', 'dorade, huile d''arachide, poivre, gingembre, ail, oignon, soja', '20 min', ['Couper le gingembre en fines lamelles puis en bâtonnets de deux à trois millimètres de section. ', 'Couper finement les oignons frais et débiter les tiges d''oignons en morceaux d''1 cm de long. Couper la tête d''ail en fines lamelles. ', 'Mettre l''huile dans une casserole, ajouter les grains de poivre. Dès que l''huile frémit faire dorer les bâtonnets de gingembre puis ajouter l''ail, l''oignon et les tiges d''oignons. Faire revenir le tout durant trois bonnes minutes. ', 'Ajouter à cette préparation le demi-verre de sauce de soja. ', 'Disposer les dorades ou les filets de poisson dans des assiettes pouvant aller dans le cuiseur vapeur. Répartir la sauce sur chacun des poissons (ou des filets). ', 'Faire cuire à la vapeur, le temps de cuisson varie entre 5 et 7 mn (selon l''épaisseur des poissons) une fois que la vapeur se dégage du couvercle. Déguster chaud.'], ['Fouet', 'Ouvre-boîte', 'Presse-agrumes', 'Couteau de chef', 'Balance de cuisine'], ['recettes', 'plats chinois', 'boisson', 'très facile', 'cuisine', 'dorade', 'oignon', 'recettes de cuisine', 'entrée', 'testées', 'huile d''arachide', 'dessert', 'recette', 'rapide', 'cocktail', 'poivre', 'ail', 'plat de résistance', 'plat', 'gingembre', 'confiserie', 'Poisson au gingembre à la vapeur (Chine)', 'assez cher', 'soja'], 'Plat principal', 6ab0d283-f4f8-40b7-a71c-4ee7c412f22e, '2025-09-26T14:58:52.168763', [{'ingredient_id': '26a2f1b9-b1d5-428a-834c-052553a5198a', 'quantite': '2'}, {'ingredient_id': '301a0b30-5d8f-4c4c-8e8e-3f4f07e6261a', 'quantite': ''}, {'ingredient_id': '565e1538-5983-435d-b659-fddaac6d741a', 'quantite': '15'}, {'ingredient_id': 'bc81ff66-0214-4c92-b409-d9b7b64b6024', 'quantite': '100 g'}, {'ingredient_id': '3aeca8a6-9090-4343-8140-720ffaa7f236', 'quantite': '1'}, {'ingredient_id': 'b7628414-ba0a-41ec-af33-209721ddaf28', 'quantite': '3'}, {'ingredient_id': '33638174-bc0e-4f39-b7a8-af10f540ffca', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20274, 'Fondue de poissons', 'poisson, Fruits de mer, huile de friture, oeuf', '15 min', ['Idées pour diverses sauces :', '- mayonnaise à l’ail', '- tartare', '- aux anchois', '- béarnaise', '- à l’américaine', '- rouille', 'Faire chauffer l’huile dans une casserole. ', 'La mettre dans le caquelon avec l’alcool à brûler que l’on allume. ', 'Chaque convive met un morceau de poisson sur sa fourchette, le trempe dans l’oeuf battu et le met délicatement dans l’huile. Attention à ce que cela ne saute pas pour les premiers morceaux. ', 'Servir avec du riz.'], ['Passoire', 'Tire-bouchon', 'Planche à découper', 'Rouleau à pâtisserie'], ['recettes', 'boisson', 'très facile', 'cuisine', 'huile de friture', 'Fruits de mer', 'moyen', 'recettes de cuisine', 'entrée', 'Fondue de poissons', 'testées', 'dessert', 'recette', 'oeuf', 'poisson', 'cocktail', 'plat de résistance', 'plat', 'fondue à la viande', 'confiserie'], 'Plat principal', f1bcffff-9353-4b5d-a137-8123f3f136fb, '2025-09-26T14:58:55.846021', [{'ingredient_id': '8510c804-c55a-4700-b4e4-674282520018', 'quantite': '200 g'}, {'ingredient_id': 'e028f8eb-ed84-44dd-8924-5a8bb244d5d5', 'quantite': '100 g'}, {'ingredient_id': '6579a4e8-562e-437d-b024-63f1e7ca1651', 'quantite': ''}, {'ingredient_id': '34c77b4b-76f8-428e-9a10-94f194ad92ff', 'quantite': '8'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (51261, 'Gratin de poisson aux carottes et aux courgettes', 'poisson, carotte, courgette, oignon, tomates confites à l’huile, thym, crème, oeuf, jus de citron, huile d''olive, persil, aneth, poivre, sel', '20 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Tailler les carottes en fines lamelles à l''aide d''une râpe puis les plonger dans de l''eau bouillante salée avec du thym et laisser  cuire 5 à 6 minutes.', 'Les égoutter et réserver.', 'Faire suer les courgetes en lamelles et les oignons dans une sauteuse avec de l''huile d''olive, saler et poivrer.', 'Dans un plat allant au four, disposer les carottes, les courgettes aux oignons, les filets de poisson, les petites tomates confites, saler et poivrer.', 'Enfourner pour 15 minutes de cuisson.', 'Battre les 2 oeufs et la crème, ajouter le jus de citron et l''aneth, verser sur le gratin et poursuivre la cuisson au four 15 minutes supplémentaires.'], ['Verre doseur', 'Louche'], ['recettes', 'boisson', 'crème', 'cuisine', 'oignon', 'courgette', 'persil', 'recettes de cuisine', 'entrée', 'testées', 'carotte', 'jus de citron', 'bon marché', 'aneth', 'dessert', 'recette', 'oeuf', 'poisson', 'thym', 'cocktail', 'poivre', 'plat de résistance', 'gratin de légumes', 'plat', 'Gratin de poisson aux carottes et aux courgettes', 'tomates confites à l’huile', 'confiserie', 'huile d''olive', 'sel', 'facile'], 'Plat principal', dec482b7-4dc7-4519-baec-6b88d369a5ce, '2025-09-26T14:58:59.693281', [{'ingredient_id': '9f4b3901-651d-463e-bd43-3a9df6044d19', 'quantite': '4'}, {'ingredient_id': 'c1c779b7-37a8-4a92-b095-0ff37868b2e0', 'quantite': '2'}, {'ingredient_id': 'd2b8290e-87d1-4de7-9df1-1a18283a8773', 'quantite': '2'}, {'ingredient_id': 'ecf5fda5-4647-499d-9c89-a054555f9459', 'quantite': '2'}, {'ingredient_id': '566c1f88-ff74-425e-ad0f-5756575ea4b4', 'quantite': '6'}, {'ingredient_id': '18302759-5e17-4541-987c-2c5725f63a42', 'quantite': ''}, {'ingredient_id': 'e35ad98f-725f-4682-b4a6-713292dfcf10', 'quantite': '25 cl'}, {'ingredient_id': '152ebf94-f8ca-4961-8192-ba6d57f22303', 'quantite': '2'}, {'ingredient_id': 'fbe8ed41-8334-4b10-b05f-fc92628d9953', 'quantite': ''}, {'ingredient_id': '969c15e3-c531-41a7-a9c3-33d732760d6e', 'quantite': ''}, {'ingredient_id': 'f05a8c58-dbb0-4fcc-90da-79594a597a9c', 'quantite': ''}, {'ingredient_id': '537a45c4-b21e-43c2-8408-024140c6d3fa', 'quantite': ''}, {'ingredient_id': '51b623c7-fb0a-4bbb-a047-0cee24691dba', 'quantite': ''}, {'ingredient_id': '4803faba-4957-4bfe-b55b-b796bb3641f0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (41362, 'lasagnes au poisson', 'lasagnes, poisson, sauce tomate, boursin, crème fraîche, moutarde, gruyère râpé, poivre, sel', '20 min', ['Faire cuire le poisson au court-bouillon ou à la vapeur (ou encore au micro onde!)', 'Mélanger le poisson émietté avec le boursin cuisine, la moutarde et la crème fraiche, saler et poivrer.', 'Commencer à "monter les lasagnes" :', 'une couche de sauce tomate, une couche de préparation au poisson et une couche de lasagne... et on recommence!!', 'Terminer par la sauce tomate et parsemer soit de gruyère rapé soit de mozzarella.', 'Passer au four à 200°C (thermostat 6-7) environ 35 min.'], ['Tire-bouchon', 'Ouvre-boîte', 'Économe'], ['recettes', 'boisson', 'très facile', 'cuisine', 'recettes de cuisine', 'entrée', 'testées', 'moutarde', 'bon marché', 'dessert', 'recette', 'sauce tomate', 'poisson', 'gruyère râpé', 'cocktail', 'poivre', 'plat de résistance', 'plat', 'lasagnes', 'confiserie', 'boursin', 'sel', 'lasagnes au poisson', 'crème fraîche', 'lasagne'], 'Plat principal', a3a74e09-4d35-45eb-9a4a-dc013004cc32, '2025-09-26T14:59:05.487234', [{'ingredient_id': '679eecb9-2350-4f48-acfe-904c984783cd', 'quantite': ''}, {'ingredient_id': '335d8334-da69-47a8-b4bb-b597e7b49e89', 'quantite': '500 g'}, {'ingredient_id': 'e54fd535-5d70-4279-b568-8c40376f03ed', 'quantite': '2'}, {'ingredient_id': '8c6aab94-d8e4-4a3e-b3da-84e3d066ef4d', 'quantite': '1'}, {'ingredient_id': 'ee05a1b5-795f-46d0-9235-b77be137e19f', 'quantite': '2 cuillères'}, {'ingredient_id': '9b546a5d-77c3-4439-8dee-0d407c594025', 'quantite': '2 cuillères'}, {'ingredient_id': '157f2704-3986-4e64-8053-2cd65aab5ed2', 'quantite': ''}, {'ingredient_id': '32fe169d-e962-4eef-88cd-5cb69a6bb0e2', 'quantite': ''}, {'ingredient_id': '904ed099-eb13-4ce2-a0aa-3323aac5c502', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (69955, 'Cocotte de poisson aux petits légumes, ciboulette et paprika', 'poisson, carotte, courgette, vin blanc, huile d''olive, crème fraîche, maïzena, ciboulette, paprika', '20 min', ['Couper les carottes et les courgettes en petits morceaux ou rondelles. Les faire cuire 5 minutes dans une casserole avec le vin blanc et l''huile d''olive.', 'Pendant ce temps, mélanger la crème fraîche et la maïzéna.', 'Recouvrir les filets de poisson de ciboulette puis de paprika sur les deux faces.', 'Verser le mélange de légumes avec le vin blanc dans une cocotte allant au four, y intégrer le mélange crème-maïzéna et remuer. ', 'Déposer sur les légumes les filets de poisson et refermer la cocotte.', 'Enfourner pour 30 minutes minimum à 180°C (thermostat 6).', 'Servir avec du riz ou de la semoule.'], ['Moule à tarte', 'Tire-bouchon', 'Rouleau à pâtisserie'], ['', 'recettes', 'boisson', 'maïzena', 'très facile', 'cuisine', 'courgette', 'ciboulette', 'moyen', 'recettes de cuisine', 'entrée', 'testées', 'carotte', 'dessert', 'recette', 'vin blanc', 'poisson', 'cocktail', 'plat de résistance', 'Cocotte de poisson aux petits légumes', 'plat', 'paprika', 'confiserie', 'ciboulette et paprika', 'huile d''olive', 'crème fraîche'], 'Plat principal', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:59:09.314993', [{'ingredient_id': '14c063f7-1c04-4238-bc23-506475d6c07d', 'quantite': '1'}, {'ingredient_id': '6577b12f-df46-4123-94aa-2a365075d051', 'quantite': '3'}, {'ingredient_id': 'b6e9dacb-d07d-4877-982c-49424f285b60', 'quantite': '1'}, {'ingredient_id': '419ad443-c1b8-48f1-a71e-1fdb8ad9bea5', 'quantite': '1'}, {'ingredient_id': '8eae97f0-9c72-463c-9965-79ce7ab3a3af', 'quantite': '2 cuillères'}, {'ingredient_id': 'af760d92-fbb7-477f-8d43-0a356b60e91e', 'quantite': '10 cl'}, {'ingredient_id': '0c18aea5-176c-4ab3-b4af-aae60a45a03e', 'quantite': '2 cuillères'}, {'ingredient_id': '3ed38991-a028-4e4e-8366-e18d39d516c7', 'quantite': ''}, {'ingredient_id': 'f2471330-7cde-4680-b358-97d913d5b58c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15066, 'Poisson aux épices et au lait de coco', 'poisson, oignon, huile d''olive, noix de coco rapée, coriandre, cumin, gingembre, muscade, cannelle, paprika, lait de coco', '15 min', ['Verser un peu d''huile d''olive au fond d''un plat rectangulaire. Garnir des oignons émincés. ', 'Placer les filets de poissons par-dessus. Saupoudrer de noix de coco râpée, puis du mélange d''épices. Ajouter le lait de coco. ', 'Couvrir le plat de papier sulfurisé. Faire cuire 3/4 h au four à 200°C.', 'Servir avec du riz basmati.'], ['Mixeur', 'Poêle', 'Batteur électrique', 'Planche à découper'], ['', 'recettes', 'boisson', 'très facile', 'cuisine', 'oignon', 'recettes de cuisine', 'entrée', 'testées', 'noix de coco rapée', 'bon marché', 'dessert', 'recette', 'poisson', 'cocktail', 'plat de résistance', 'Poisson aux épices et au lait de coco', 'plat', 'confiserie', 'huile d''olive'], 'Plat principal', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:59:16.189099', [{'ingredient_id': '8eb0b9fb-be41-4d9a-b5a2-12d7b80691a0', 'quantite': '4'}, {'ingredient_id': '4ea90d60-f9d1-43ed-859e-26d53ec92dc5', 'quantite': '2'}, {'ingredient_id': '7c927f3e-fd76-4022-8ddc-88799d34821a', 'quantite': '2 cuillères'}, {'ingredient_id': '9f35b632-d57b-4518-aa6c-46c9fc10264e', 'quantite': '50 g'}, {'ingredient_id': '439ecd91-274d-4c44-b66a-83fc4e24016d', 'quantite': ''}, {'ingredient_id': '296efccf-19ca-4364-a5c5-fe57158ef2af', 'quantite': ''}, {'ingredient_id': '585601ae-2b74-4954-8d24-ced8f01c74d2', 'quantite': ''}, {'ingredient_id': '8c8e8d7d-0b0f-4577-bb8b-33007196722e', 'quantite': ''}, {'ingredient_id': '161fbfe5-424f-4e2b-b0ba-a4bed1f06246', 'quantite': ''}, {'ingredient_id': '14ad8c66-d623-4c38-94cd-70d42985e2b9', 'quantite': ''}, {'ingredient_id': '40c68ca9-9d71-4745-8ee3-98dec4f05605', 'quantite': '40 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (311506, 'Burger à la blanquette de veau', 'blanquette de veau, cube de bouillon, cube de bouillon, carotte, oignon, champignon, crème fraîche, jus de citron, jaune d''oeuf, farine, vin blanc, pain pour hamburger, cheddar', '15 min', ['Faire revenir la viande dans du beurre jusqu''à ce que les morceaux soient un peu dorés. Saupoudrer de 2 cuillères de farine. ', 'Bien remuer. Ajouter 2 ou 3 verres d''eau et remuer. ', 'Ajouter les 2 cubes de bouillon. Ajouter le vin et couvrir d''eau. ', 'Couper les carottes en rondelles et les oignons, puis les ajouter, ainsi que les champignons. ', 'Laisser mijoter à feu très doux environ 1h30 en remuant. ', 'Si nécessaire, ajouter de l''eau de temps en temps. ', 'Prenez vos pain hamburger, les ouvrir en deux, sur la face du dessous vous pouvez mettre la sauce de votre choix ( pour ma part, j''ai mis de la sauce bourguignonne ) ', 'Préchauffer votre four a 160°C.', 'Dans un bol, bien mélanger la crème fraîche, le jaune d''oeuf et du jus de citron. Ajouter ce mélange au dernier moment, bien remuer.', 'Ensuite prenez la face de votre pain avec la sauce mettez votre tranche de cheddar, mettre votre blanquette sur le cheddar ( pour les gourmands de cheddar vous pouvez en remettre une tranche par dessus ) refermez votre pain et enfourner peu de temps environs 5 min maximun, juste pour que votre pain soit chaud et croustillant.'], ['Presse-agrumes', 'Rouleau à pâtisserie', 'Casserole'], ['recettes', 'cube de bouillon', 'pain pour hamburger', 'boisson', 'champignon', 'cuisine', 'oignon', 'farine', 'moyen', 'recettes de cuisine', 'entrée', 'testées', 'carotte', 'jus de citron', 'cheddar', 'dessert', 'recette', 'vin blanc', 'cocktail', 'Burger à la blanquette de veau', 'plat de résistance', 'plat', 'confiserie', 'blanquette de veau', 'blanquette', 'crème fraîche', 'facile', 'jaune d''oeuf'], 'Plat principal', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:59:20.034779', [{'ingredient_id': 'aedc7f8e-30c4-44e5-841d-ae0e323f510d', 'quantite': '800 g'}, {'ingredient_id': 'eac8e897-854d-479b-8b84-80186b121a37', 'quantite': '1'}, {'ingredient_id': '83a9727b-4b5b-45fe-80a7-2f4c1af3315a', 'quantite': '1'}, {'ingredient_id': '955810f0-d2df-4ba7-8759-343125dcee07', 'quantite': '2'}, {'ingredient_id': '486859c0-e626-4be8-acba-8c4a3b5bd792', 'quantite': '1'}, {'ingredient_id': 'b87a1332-f2c2-4b80-ae25-f03edc243248', 'quantite': '1'}, {'ingredient_id': 'f13f06e1-b921-424c-984d-5685ca240a5a', 'quantite': '1'}, {'ingredient_id': 'd952707f-d049-44a6-b254-d58d7ae67253', 'quantite': ''}, {'ingredient_id': '87a85b67-4849-4da2-ace9-b556e524bc25', 'quantite': '1'}, {'ingredient_id': '900a7cc0-e23e-49d5-a24e-884a064d828b', 'quantite': ''}, {'ingredient_id': '8c44ef73-d869-4e4c-94be-4ff8c91b3846', 'quantite': '25 cl'}, {'ingredient_id': 'c7b93de2-f1c7-4cba-a2ae-84866732176b', 'quantite': '4'}, {'ingredient_id': '3f4cfa76-6545-4a81-ab4a-c0639b8f8781', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (47271, 'Burger de pois chiches', 'pois chiches, carotte, graines de tournesol, oignon, ail, tahiné, huile d''olive, citron, cumin, poivre, sel', '10 min', ['Mélanger tous les ingrédients au mixer.', 'Former des petites boulettes et les aplatir sur une plaque huilée.', 'Faire cuire au four à 180°C pendant 15 à 20 min en les retournant à mi-cuisson.'], ['Planche à découper', 'Tire-bouchon'], ['', 'recettes', 'pois chiches', 'boisson', 'très facile', 'cuisine', 'oignon', 'tahiné', 'moyen', 'recettes de cuisine', 'entrée', 'testées', 'carotte', 'dessert', 'recette', 'cumin', 'cocktail', 'poivre', 'ail', 'plat de résistance', 'graines de tournesol', 'plat', 'citron', 'Burger de pois chiches', 'confiserie', 'huile d''olive', 'sel'], 'Plat principal', 50a6a9a2-8ffa-4c13-8e80-cea8e5fdcb80, '2025-09-26T14:59:25.139912', [{'ingredient_id': 'eec4a717-41b8-4d33-87a9-62bbf0f047ad', 'quantite': '1'}, {'ingredient_id': 'ae6dd368-1699-49bb-8ef9-8977464b3d7a', 'quantite': '1'}, {'ingredient_id': 'e57c3207-2c53-424d-9636-6d6ae9b3941b', 'quantite': '50 g'}, {'ingredient_id': '1a9a1976-6895-41ed-882d-c0d1054b9bd9', 'quantite': '1'}, {'ingredient_id': '1ab8700c-3b2e-4ca1-88bd-d740e3a0d5d2', 'quantite': '1'}, {'ingredient_id': '318bac54-dbc2-48d9-9e32-c6ff357e841c', 'quantite': '2 cuillères'}, {'ingredient_id': 'de6b1a9c-3aad-4875-8b81-e61c89a12c00', 'quantite': '1 cuillères'}, {'ingredient_id': '8370a828-eb91-4777-b57d-00e5cdf7769e', 'quantite': ''}, {'ingredient_id': '82b784e9-a4bb-4dc0-993e-0f489e69b184', 'quantite': ''}, {'ingredient_id': 'e6e1b78e-9c7f-49e1-952e-36ed63920ac7', 'quantite': ''}, {'ingredient_id': 'cbd9a480-d75e-4bb4-ad9f-ea5e0a4f9d0f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (347367, 'Burger feuilleté', 'pâte feuilletée, salade, oignon rouge, cheddar, steak, ketchup, huile d''olive, sel, poivre', '25 min', ['Préchauffer le four à 180°C (thermostat 6). ', 'Découper des bandes de pâte feuilletée, les enrouler pour former des escargots de pâte. ', 'Disposer sur une plaque recouverte de papier cuisson et humidifier le dessus de chaque escargot. ', 'Enfourner 20 minutes. ', 'Eplucher et couper l''oignon en rondelles. ', 'Cuire les steaks dans une poêle avec un filet d''huile d''olive. Saler et poivrer. Cuire selon la cuisson souhaitée. ', 'Ouvrir les "buns" feuilletés en 2 (comme pour des pains à burger), déposer une cuillère de ketchup, quelques feuilles de salade, des rondelles d''oignon, une tranche de fromage, un steak, une tranche de fromage, quelques feuille de salade et fermer avec le dessus du bun feuilleté. ', 'Enfourner 10 minutes en mode grill pour réchauffer le tout et faire fondre le fromage. ', 'Servir bien chaud.'], ['Moule à tarte', 'Passoire'], ['recettes', 'boisson', 'très facile', 'cuisine', 'recettes de cuisine', 'entrée', 'Burger feuilleté', 'testées', 'cheddar', 'bon marché', 'dessert', 'recette', 'pâte feuilletée', 'cocktail', 'poivre', 'plat de résistance', 'salade', 'steak', 'plat', 'ketchup', 'confiserie', 'oignon rouge', 'feuilleté', 'huile d''olive', 'sel'], 'Plat principal', ea519efe-5447-4060-bb84-89be5fe30847, '2025-09-26T14:59:28.958135', [{'ingredient_id': 'a1852339-8d4a-446d-87ba-c2c1bc825b88', 'quantite': '2'}, {'ingredient_id': 'b0f5aa74-47c8-4600-bbed-37ae24c8a353', 'quantite': ''}, {'ingredient_id': '656112bf-0879-4609-b92d-254021850c93', 'quantite': '1'}, {'ingredient_id': 'cb3afe07-72f4-4c40-a688-9f10e8d74828', 'quantite': '4'}, {'ingredient_id': '3a6a1e87-0511-44f9-af97-393ec025500a', 'quantite': '2'}, {'ingredient_id': '38f42c24-a172-443a-a143-9c32a8603801', 'quantite': ''}, {'ingredient_id': '15688c84-1572-43c7-89ba-3e475dd6d547', 'quantite': '1'}, {'ingredient_id': '8b2ce55c-9d6d-4450-a268-e6906e039b92', 'quantite': ''}, {'ingredient_id': '57506b74-836d-489a-ba92-d54e247ae732', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14878, 'Sauce facile pour poissons', 'fromage ail et fines herbes, crème fraîche liquide', '1 min', ['Faire fondre à feu doux le fromage et la crème en ne mettant pas toute la crème. Goûter pour voir si il faut rajouter un peu de crème selon votre goût. C''est prêt!'], ['Moule à tarte', 'Verre doseur', 'Ouvre-boîte', 'Économe', 'Râpe'], ['recettes', 'boisson', 'très facile', 'cuisine', 'recettes de cuisine', 'entrée', 'crème fraîche liquide', 'testées', 'bon marché', 'dessert', 'recette', 'Sauce facile pour poissons', 'rapide', 'cocktail', 'plat de résistance', 'plat', 'confiserie', 'fromage ail et fines herbes', 'Autres sauces'], 'Sauce', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:59:33.773817', [{'ingredient_id': 'cd543495-61fd-4250-9911-fca1694f4348', 'quantite': '1'}, {'ingredient_id': 'a121409e-7626-4fd1-b5d1-8c976b0c4886', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (348363, 'Bao burger', 'porc, oignon, ail, sauce nuoc mam, huile de sésame, sauce soja, sucre, citron vert, farine, lait, sucre, sel, levure de boulanger, carotte, salade, concombre, coriandre', '40 min', ['Préparation des bao.
Diluer la levure dans le lait tiède puis ajouter la farine, le sucre et le sel. Bien pétrir, au robot ou à la main, pendant au moins 8 minutes. Vous devez obtenir une boule de pâte (comme pour du pain).', 'Laisser reposer une heure sous un torchon, dans un endroit tiède et chaud.', 'Etaler grossièrement la pâte avec les mains pour former un boudin. Diviser en 3 ou 4 belles boules de pâte et disposer sur une plaque recouverte de papier cuisson.', 'Laisser reposer à nouveau dans un endroit chaud (idéalement votre four à 50°C).', 'Préparer la marinade en mélangeant l''huile de sésame, la sauce nuoc mam et la sauce soja. Bien mélanger.', 'Eplucher et hacher finement l''ail et l''oignon.
Mélanger à la marinade.', 'Détailler le porc en lamelles et mélanger à la marinade', 'Laisser le porc mariner 1h.', 'Faire cuire le porc mariné à la poêle, à feu très vif.', 'Ajouter le jus de citron vert sur le porc cuit.', 'Laver et tailler le concombre en rondelles.
Laver la salade.', 'Placer le panier en bambou dans une casserole d''eau bouillante et y déposer les buns.', 'Montage des bao burgers. 
Ouvrir les bao en 2.
Déposer une feuille de salade, couvrir de porc avec la marinade, ajouter des bâtonnets de carotte et des rondelles de concombre. Parsemer de coriandre et fermer avec le deuxième bun.'], ['Ouvre-boîte', 'Verre doseur'], ['', 'recettes', 'boisson', 'Bao burger', 'citron vert', 'cuisine', 'oignon', 'sucre', 'recettes de cuisine', 'entrée', 'testées', 'sauce soja', 'bon marché', 'dessert', 'recette', 'cocktail', 'ail', 'plat de résistance', 'plat', 'huile de sésame', 'sauce nuoc mam', 'porc', 'confiserie', 'moyenne'], 'Plat principal', ea519efe-5447-4060-bb84-89be5fe30847, '2025-09-26T14:59:37.692567', [{'ingredient_id': 'd8b8bcff-5bea-49f7-8cdd-37979fd57f22', 'quantite': '400 g'}, {'ingredient_id': 'ac7fb00d-8210-42de-933d-9c2b625ab005', 'quantite': '1'}, {'ingredient_id': '4516686b-12a4-44cd-90ad-bf8fb11fcfe4', 'quantite': '1'}, {'ingredient_id': '4465a2f9-e23c-495e-8ee3-ef2075ac9ed8', 'quantite': '3 cuillères'}, {'ingredient_id': '7a64f473-4e44-4db0-a2b2-c46936eb4285', 'quantite': '3 cuillères'}, {'ingredient_id': '863d8bcd-77be-4b3a-99e6-d6b0e84f58cb', 'quantite': '3 cuillères'}, {'ingredient_id': '0a982f4e-6234-4c42-b579-d30e214808ac', 'quantite': '2 cuillères'}, {'ingredient_id': 'cf2263c4-846d-43d1-94c5-6c51fa411519', 'quantite': '1'}, {'ingredient_id': 'fb9c4278-b0e3-4ce7-889f-b3987ff3cf11', 'quantite': '400 g'}, {'ingredient_id': '53d365d1-3372-4f55-8ba4-41b8d168fcba', 'quantite': '25 cl'}, {'ingredient_id': 'b943dde5-cb4b-4de5-a819-0e46ef170213', 'quantite': '25 g'}, {'ingredient_id': 'c3f19d69-4ca7-438a-98b5-9e638f091cb0', 'quantite': '2'}, {'ingredient_id': 'cd82814e-a82a-4318-b4a9-0881ea4a67ee', 'quantite': '1'}, {'ingredient_id': '8f04c118-60d9-4ccf-9b04-5ad5dba93f28', 'quantite': ''}, {'ingredient_id': '2d77a927-3e43-4b50-97bf-d1569d27751e', 'quantite': ''}, {'ingredient_id': 'c1d45983-ebce-4fb7-b629-3c92ee22bc6d', 'quantite': ''}, {'ingredient_id': 'e1b32e4f-9018-4dab-8081-ef57a963e5ba', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46741, 'Gratin de poissons et coquilles Saint-Jacques', 'lieu noir, saumon, coquille saint-jacques, beurre, tsuyu (bouillon au poisson volant), vin blanc, farine, Parmesan, chapelure', '40 min', ['Faire décongeler les coquilles Saint-Jacques dans un mélange eau (66 cl) et lait (33 cl) quelques heures.', 'Puis préparer le court bouillon : dans l''eau froide, mettre le poisson (cabillaud + saumon) et faire chauffer à feu moyen jusqu''à ébullition. Arrêter alors, égoutter le poisson et mettre de coté 50 cl de court bouillon.', 'Faire préchauffer le four à 220°C (thermostat 7).', 'Faire fondre 10 g de beurre dans une poêle, faire revenir les coquilles Saint-Jacques de chaque coté moins d''1 min puis réserver dans un plat.', 'Servir avec du riz.', 'Répartir dans un plat à gratin les poissons cuits au court bouillon (séparés en petits morceaux) et les coquilles Saint-Jacques.', 'Déglacer la poêle où ont cuites les Saint-Jacques avec 5 cl de vin blanc (c''est-à-dire faire bouillir le vin en le mélangeant au jus de cuisson) et réserver.', 'Mettre dans une casserole 10 g de beurre et 3 cuillères à soupe de farine, mettre à feu doux, battre avec un fouet, ajouter petit à petit le court bouillon mis de coté (50 cl) et le jus de cuisson des Saint-Jacques déglacées. ', 'Adapter la quantité de liquide en fonction de la consistance de la sauce qui ne doit pas être trop épaisse. Il est possible d''ajouter du vin blanc si nécessaire.', 'Recouvrir le plat avec la sauce obtenue, enfin mélanger 1 cuillerée à soupe de parmesan et 1 cuillère à soupe de panure et parsemer à la surface du gratin.', 'Mettre au four 10 à 15 minutes à 220°C (thermostat 7).'], ['Spatule', 'Poêle', 'Mixeur', 'Couteau de chef', 'Balance de cuisine'], ['recettes', 'boisson', 'Gratin de poissons et coquilles Saint-Jacques', 'cuisine', 'farine', 'lieu noir', 'saint-jacques', 'moyen', 'beurre', 'recettes de cuisine', 'entrée', 'tsuyu (bouillon au poisson volant)', 'testées', 'dessert', 'recette', 'vin blanc', 'rapide', 'cocktail', 'chapelure', 'plat de résistance', 'saumon', 'coquille saint-jacques', 'Parmesan', 'plat', 'confiserie', 'moyenne'], 'Plat principal', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:59:42.960198', [{'ingredient_id': 'ae17f624-7dd3-4840-98c8-624caa28db76', 'quantite': '200 g'}, {'ingredient_id': '187b05c5-0488-4797-a60b-68430808797a', 'quantite': '200 g'}, {'ingredient_id': 'bbf94319-ce2b-45ce-9904-2bcb4a7efcca', 'quantite': '300 g'}, {'ingredient_id': '2369aa05-99ae-4956-ba79-9eecf320e97d', 'quantite': '20 g'}, {'ingredient_id': '8f78addc-fe6c-4eb9-b570-df8a1e1fb170', 'quantite': '1'}, {'ingredient_id': '42d20eea-30a8-430b-8383-3ad02d75b118', 'quantite': '5 cl'}, {'ingredient_id': '3ced58b3-63d2-439b-b59b-49a2aa61f374', 'quantite': ''}, {'ingredient_id': '758c8306-8237-40b8-8a70-60fa50eb0603', 'quantite': ''}, {'ingredient_id': 'a72fd039-6e96-4cee-af1b-36a19ba6841e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (90881, 'Lasagnes de poisson aux épinards', 'lasagnes, poisson, épinards, oignon, boursin, crème fraîche, gruyère râpé, poivre, sel', '20 min', ['Préchauffer le four à 190°(thermostat 6).', 'Faire cuire au court bouillon le mélange de poissons (j''ai utilisé des surgelés).', 'Pendant ce temps, faire fondre les épinards surgelés dans une casserole à feu très doux.', 'Dans un grand bol, émincer l''oignon et y incorporer le pot de boursin cuisine, puis y ajouter la crème liquide. ', 'Lorsque le mélange de poissons est cuit, l''égoutter, l''émietter et l''intégrer au mélange précédent. Y ajouter du poivre et du sel (personnellement je ne sale jamais mais bon...).', 'Faire chauffer une casserole d''eau et plonger 3 plaques de lasagnes 3-4 minutes pour qu''elles ramolissent dedans (cela évite de se retrouver avec des plaques sèches). Les sortir pour les égoutter. Il conviendra par la suite de faire cuire les plaques 3 par 3.', 'Dans un plat qui va au four, arroser le fond d''huile d''olive. ', 'Mettre 3 plaques de lasagne les unes à côté des autres, puis une couche de mélange de poissons, une couche de lasagnes, une couche d''épinards, une couche de lasagnes, une couche de poissons, une couche de lasagnes, une couche d''épinards, une couche de lasagnes.', 'Enfin, parsemer généreusement de gruyère avec quelques noisettes de beurre.', 'Passer au four 45 minutes à 180°C (thermostat 6) jusqu''à ce que le plat ait gratiné.'], ['Fouet', 'Passoire'], ['recettes', 'boisson', 'très facile', 'cuisine', 'oignon', 'recettes de cuisine', 'entrée', 'testées', 'bon marché', 'dessert', 'recette', 'poisson', 'gruyère râpé', 'cocktail', 'poivre', 'plat de résistance', 'épinards', 'plat', 'lasagnes', 'confiserie', 'boursin', 'Lasagnes de poisson aux épinards', 'sel', 'crème fraîche', 'lasagne'], 'Plat principal', e245acb1-bd1b-4f8e-9d68-bc3b681c9538, '2025-09-26T14:59:46.852119', [{'ingredient_id': '321721b2-c94f-4485-9575-8d635a1cb146', 'quantite': '15'}, {'ingredient_id': 'd2557faa-c2b9-496e-aa01-de577a004dd1', 'quantite': '600 g'}, {'ingredient_id': '31a0c9ae-f445-449d-98da-794c323034bd', 'quantite': '1 kg'}, {'ingredient_id': '4d692851-a145-437e-b30a-4162ca7c103c', 'quantite': '1'}, {'ingredient_id': '19f1485f-bbd2-4123-b40a-b617f9388d01', 'quantite': '1'}, {'ingredient_id': 'd6c6db29-bbd4-47b9-87ac-4efd967f813d', 'quantite': '25 cl'}, {'ingredient_id': '4988141a-0b54-4f8a-9fdd-986648c6ad0f', 'quantite': '30 g'}, {'ingredient_id': '09f413d6-13af-4749-a493-f5ece8a353a2', 'quantite': ''}, {'ingredient_id': '08fa294d-71d1-46d3-865d-cc4d460ef081', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72121, 'Soupe de poisson vite faite', 'oignon rouge, pomme de terre, safran, cube de bouillon, carotte, persil, ail, concentré de tomates, saumon frais, lieu noir, poivre, sel, huile d''olive', '15 min', ['Dans une casserole, faites chauffer 3 cuillères à soupe d''huile d''olive. Faites-y revenir les oignons, les pommes de terre et les carottes en morceaux.', 'Ajouter tout de suite le safran.', 'Au bout de 10 min, ajouter les poissons avec l''ail et le persil.', 'Laisser cuire encore 10 à 15 min.', 'Couvrir d''eau (3 L environ) et incorporer les cubes de bouillon de poisson et le concentré de tomates.', 'Saler, poivrer, et laisser mijoter 45 min. Passer au mix soupe.', 'Pour les croûtons, frotter de deux gousses d''ail 6 tartines d''un pain pas trop frais, des deux côtés.', 'Les faire frire dans une sauteuse avec 5 cuillères à soupe d''huile d''olive.', 'Servir avec les croûtons chauds, du gruyère râpé et de la rouille en fonction des goûts.'], ['Balance de cuisine', 'Moule à tarte', 'Poêle', 'Casserole'], ['safran', 'recettes', 'cube de bouillon', 'boisson', 'cuisine', 'lieu noir', 'moyen', 'persil', 'recettes de cuisine', 'entrée', 'testées', 'carotte', 'dessert', 'recette', 'cocktail', 'poivre', 'ail', 'Soupe de poisson vite faite', 'plat de résistance', 'pomme de terre', 'plat', 'soupe de poisson', 'concentré de tomates', 'confiserie', 'oignon rouge', 'saumon frais', 'sel', 'huile d''olive', 'facile'], 'Plat principal', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T14:59:50.589030', [{'ingredient_id': '2cdd7695-8b9a-49af-8bfb-8b173287256b', 'quantite': '2'}, {'ingredient_id': '32e33f58-1dd3-4f04-bba8-46e4288f97ca', 'quantite': '3'}, {'ingredient_id': '24e11638-2344-4470-b00f-19153f172323', 'quantite': '6'}, {'ingredient_id': '54dd4056-b1a4-4d84-a10f-7862b6ba1e24', 'quantite': '2'}, {'ingredient_id': '50ea4b4d-8217-4efa-b2d2-042a672747d6', 'quantite': '4'}, {'ingredient_id': 'ce25bbfd-8785-4e36-bf23-4ddbc121539f', 'quantite': '1'}, {'ingredient_id': '2fd54cbe-184a-426e-a484-6d8ad0d422db', 'quantite': '2'}, {'ingredient_id': '744cd654-138d-4f06-a34e-0c09f33efd1c', 'quantite': '1'}, {'ingredient_id': 'c6e6e8fd-ff81-4627-b5e0-259edae795fe', 'quantite': '2'}, {'ingredient_id': '963beb78-0fb5-4a39-9dd0-4958a781d140', 'quantite': '2'}, {'ingredient_id': '8bf3a32b-b89e-4c4b-83c5-31c7fb8e5726', 'quantite': ''}, {'ingredient_id': '603c0898-0edb-4500-9388-7e7f588c6bd0', 'quantite': ''}, {'ingredient_id': '20204acd-6c9e-431b-a1bb-f5748889eab7', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16509, 'Filets de Tilapia (ou poisson blanc) aux pommes et lardons', 'tilapia, pomme, lardons fumés, citron, beurre, poivre, sel, riz basmati', '15 min', ['Peler et couper les pommes en petits carrés. Mettre une noix de beurre dans une poële anti-adh. Déposer les pommes. Mouiller avec le jus de citron. Les pommes doivent devenir transparentes sans s''écraser.', 'Faire chauffer une noix de beurre dans une poêle, y jeter les lardons et les faire frire.', 'Prendre 4 grands carrés d''aluminium. Dans chacun, déposer un filet, saler légèrement et poivrer, sur chaque feuille, couvrir de 1/8 des pommes et des lardons (sans la graisse), puis superposer deuxième filet et partager reste des pommes et lardons. Fermer les papillotes.', 'Cuire à four moyen (180°C) pendant 20 mn.', 'Servir dans la papillote ouverte et accompagner de riz basmati.'], ['Presse-agrumes', 'Casserole', 'Planche à découper', 'Économe', 'Balance de cuisine'], ['recettes', 'boisson', 'très facile', 'cuisine', 'moyen', 'beurre', 'recettes de cuisine', 'entrée', 'testées', 'dessert', 'recette', 'lardons fumés', 'Filets de Tilapia (ou poisson blanc) aux pommes et lardons', 'cocktail', 'poivre', 'plat de résistance', 'plat', 'citron', 'tilapia', 'confiserie', 'filets de poisson', 'riz basmati', 'sel', 'pomme'], 'Plat principal', 60cbdb26-15d6-43a1-a222-821a89fc3aca, '2025-09-26T14:59:55.693631', [{'ingredient_id': '12856123-f38f-4c08-8f79-65abcc7719d5', 'quantite': '8'}, {'ingredient_id': 'c338c67c-8c89-4e6e-a34f-520f0d12e7ca', 'quantite': '4'}, {'ingredient_id': 'ef1f8da7-86c0-408c-9be9-e570b7c9c7d9', 'quantite': '250 g'}, {'ingredient_id': '70c45e7b-9558-40e0-8ff6-cae7146a7422', 'quantite': ''}, {'ingredient_id': '02ee20ad-19c8-4378-9ecb-2c2534656e3e', 'quantite': '2'}, {'ingredient_id': '13176743-e228-4f38-8e5a-0115e4d7d31e', 'quantite': ''}, {'ingredient_id': '52999f34-67e1-4198-b778-f20b5979d159', 'quantite': ''}, {'ingredient_id': '8ff2c485-919d-4136-ae4f-bedf391f9ba3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13238, 'Poisson au lait de coco', 'poisson, lait de coco, tomate, oignon, curcuma', '30 min', ['Faire revenir les oignons coupés fin dans une grande poêle antiadhésive.', 'Ajouter les filets de poisson roulés sur eux-mêmes, les faire revenir doucement 5 à 6 minutes. Saler et poivrer.', 'Ajouter les tomates coupées en petits dés. Cuire à feu doux 5 minutes.', 'Ajouter le lait de coco et le curcuma (facultatif). Laisser mijoter doucement 10 à 15 minutes sans remuer.'], ['Économe', 'Moule à tarte', 'Louche', 'Balance de cuisine'], ['', 'curcuma', 'recettes', 'boisson', 'très facile', 'cuisine', 'oignon', 'recettes de cuisine', 'entrée', 'testées', 'bon marché', 'dessert', 'recette', 'poisson', 'Poisson au lait de coco', 'cocktail', 'plat de résistance', 'plat', 'confiserie', 'lait de coco', 'tomate'], 'Plat principal', f8cffe6b-9ddf-4f61-84d9-f2ebf7612d57, '2025-09-26T15:00:02.534971', [{'ingredient_id': '9f28dcca-c975-46c4-a932-0e2c171aaeb4', 'quantite': '4'}, {'ingredient_id': 'd1a77685-a9e4-4420-8116-85ded90f8910', 'quantite': '1'}, {'ingredient_id': 'e1e6f2dd-2a16-4462-8b4f-860261d835f7', 'quantite': '4'}, {'ingredient_id': 'd0ca1973-0206-416f-91e3-8479f5557a1d', 'quantite': '1'}, {'ingredient_id': '69856e52-0642-4587-9330-d167c964f119', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38191, 'Gratin de boîtes improvisé', 'ravioli, tomates concassées, coulis de tomate, champignons de Paris, tortils, gruyère râpé, basilic, poivre, sel', '10 min', ['Verser une boîte de raviolis au fromage dans un plat à gratin, ajouter les torti cuites, les tomates concassées, les champignons égouttés, rincés et légèrement poêlés, le basilic, le coulis de tomates, 2 poignées de gruyère.', 'Bien mélanger.', 'Saupoudrer d''une dernière poignée de gruyère, mettre au four environ 10 min pour réchauffer et 10 min pour gratiner'], ['Presse-agrumes', 'Poêle', 'Économe', 'Verre doseur', 'Spatule'], ['', 'recettes', 'boisson', 'très facile', 'cuisine', 'tortils', 'recettes de cuisine', 'entrée', 'tomates concassées', 'testées', 'ravioli', 'bon marché', 'dessert', 'recette', 'Gratin de boîtes improvisé', 'gruyère râpé', 'cocktail', 'coulis de tomate', 'poivre', 'plat de résistance', 'champignons de Paris', 'plat', 'basilic', 'confiserie', 'sel'], 'Plat principal', 24bc6250-d44b-49c9-aed4-cf0ccdb5ecc6, '2025-09-26T15:00:06.036117', [{'ingredient_id': 'f36d5470-1205-4b90-8673-44c4d6868290', 'quantite': '1'}, {'ingredient_id': '3253017e-4585-4ee7-a8a4-4cbc963b54f6', 'quantite': ''}, {'ingredient_id': 'bc3e60c9-625c-4502-8802-54a4c3300ef5', 'quantite': ''}, {'ingredient_id': '708c5699-607f-4a1d-b964-ac46c797d1f5', 'quantite': '1'}, {'ingredient_id': '256f34a8-4516-4988-8b32-3f389cf709fb', 'quantite': '3'}, {'ingredient_id': '4e39c1c2-607b-469f-b7c4-581ac5d94e18', 'quantite': '3'}, {'ingredient_id': 'f9218763-d470-44fc-b7f6-08e355b136df', 'quantite': ''}, {'ingredient_id': 'd46b0de1-a1fa-4766-b686-206224e3e454', 'quantite': ''}, {'ingredient_id': '06b24e9e-ef23-4e69-b24f-e301703e4521', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31836, 'Ramequins de poisson au saumon fumé', 'colin, blanc d''oeuf, crème fraîche, saumon fumé, beurre, citron, oeuf de lump, aneth', '15 min', ['Beurrer 4 ramequins avec 20 g de beurre. ', 'Couper les tranches de saumon pour en tapisser les ramequins. ', 'Couper le reste de saumon en petits dés. ', 'Mixer le colin, saler, ajouter le blanc d''oeuf, mixer, ajouter la crème fraîche, mixer, ajouter le saumon. ', 'Garnir les ramequins. ', 'Cuire au bain-marie au four à 200°C pendant 20 mn. ', 'Pour la sauce : ', 'Faire fondre le beurre, y ajouter le jus de citron, fouetter, saler, poivrer. ', 'Servir le pâté de poisson sur une assiette et l''arroser de beurre-citron. ', 'Décorer avec les oeufs de lump et l''aneth.'], ['Râpe', 'Moule à tarte'], ['', 'recettes', 'boisson', 'cuisine', 'moyen', 'colin', 'recettes de cuisine', 'entrée', 'testées', 'dessert', 'recette', 'cocktail', 'plat de résistance', 'Ramequins de poisson au saumon fumé', 'plat', 'confiserie', 'saumon fumé', 'crème fraîche', 'facile', 'blanc d''oeuf'], 'Entrée', b2b7d059-93f1-4f86-b38c-614932e650e7, '2025-09-26T15:00:09.971791', [{'ingredient_id': '41222d4e-1e36-403d-8ce1-ac684ddf4b6b', 'quantite': '400 g'}, {'ingredient_id': 'ba36f1c7-735d-41bf-a8c6-4af85443f0cc', 'quantite': '1'}, {'ingredient_id': '919fcd75-80e1-40c5-be79-47d393f7bdb9', 'quantite': '100 g'}, {'ingredient_id': '38173553-c9b9-4d0f-bda9-43e8105f15a3', 'quantite': '4'}, {'ingredient_id': '321175dc-6c6f-460b-9e7b-4ff155f8d70f', 'quantite': '150 g'}, {'ingredient_id': '8b252a30-dafa-4f97-b3d2-9bbabcb0e6f4', 'quantite': '1'}, {'ingredient_id': 'd01380af-4ec9-456c-a713-53022008c99f', 'quantite': '1'}, {'ingredient_id': 'd06c903d-44d9-499b-be7e-303aba7ef6e6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345408, 'Burger végétarien aux lentilles', 'lentilles vertes, oignon, carotte, ail, huile d''olive, cumin, concentré de tomates, oeuf, chapelure, salade, comté, pain pour hamburger, ketchup, mayonnaise, sel, poivre', '25 min', ['Faire cuire les lentilles pendant 20 min (départ à froid) et laisser refroidir.', 'Préchauffer le four à 200°C (thermostat 6-7). ', 'Éplucher et râpée la carotte. ', 'Émincer l''oignon et le faire revenir dans la poêle avec l''huile d''olive. ', 'Au bout de 5 minutes ajouter la carotte et le cumin. ', 'Laisser mijoter. ', 'Dans un saladier, écraser les lentilles avec le concentré de tomates. ', 'Ajouter le mélange oignon / carotte, l''oeuf, la chapelure, saler et poivrer. Bien mélanger. ', 'Former des galettes et les disposer sur une plaque recouverte de papier cuisson. ', 'Enfourner 30 minutes et retourner à mi-cuisson. ', 'Toaster les pains à burger. ', 'Tartiner les pains de mayonnaise, déposer une feuille de salade, une galette de lentilles et un morceau de fromage. Refermer le burger avec le pain badigeonner de ketchup.'], ['Presse-agrumes', 'Louche'], ['recettes', 'pain pour hamburger', 'boisson', 'très facile', 'cuisine', 'oignon', 'lentilles vertes', 'recettes de cuisine', 'entrée', 'hamburger végétarien', 'testées', 'carotte', 'bon marché', 'dessert', 'recette', 'oeuf', 'cumin', 'cocktail', 'poivre', 'chapelure', 'ail', 'plat de résistance', 'salade', 'plat', 'ketchup', 'concentré de tomates', 'confiserie', 'huile d''olive', 'Burger végétarien aux lentilles', 'comté', 'sel', 'mayonnaise'], 'Plat principal', ea519efe-5447-4060-bb84-89be5fe30847, '2025-09-26T15:00:15.070464', [{'ingredient_id': 'd2bb2dc7-6b05-4ed2-be12-7d5cc3a6d8b6', 'quantite': '250 g'}, {'ingredient_id': 'e6d9e368-3301-4da7-b015-315d8a19825f', 'quantite': '1'}, {'ingredient_id': 'b164cc18-66b6-484f-8f1a-10b84c2e4e09', 'quantite': '1'}, {'ingredient_id': 'c87293ad-2b84-49aa-8efe-45b76ced74ea', 'quantite': '1'}, {'ingredient_id': 'aff0ebc6-d824-466f-a59f-9f6d7cbe8095', 'quantite': '2 cuillères'}, {'ingredient_id': '18a30696-f809-45c8-8074-61864794b575', 'quantite': '1 cuillères'}, {'ingredient_id': 'ead21517-013f-4f0c-a1e0-66e187ac7dcf', 'quantite': '1 cuillères'}, {'ingredient_id': '2988b807-1a19-423f-aed8-9d31510ef35e', 'quantite': '1'}, {'ingredient_id': 'f30f083f-0939-482a-b8cd-8198eb98da73', 'quantite': '60 g'}, {'ingredient_id': 'f8767893-8964-4aa4-98a1-c60d1607354d', 'quantite': ''}, {'ingredient_id': '8962f1c3-7737-4cf7-834c-bd8f8b873600', 'quantite': '60 g'}, {'ingredient_id': 'c1925381-eef8-4581-a9a7-8679016ac52a', 'quantite': '4'}, {'ingredient_id': '883b9468-b334-49f7-a510-defe0d686565', 'quantite': '2 cuillères'}, {'ingredient_id': '8201b486-0e3c-4898-be98-aa1aeff525d0', 'quantite': '2 cuillères'}, {'ingredient_id': '9e9d0143-44e9-4110-bb22-f9f005431f4b', 'quantite': '1'}, {'ingredient_id': '81785f81-b73b-4238-81a8-960eb6fa545d', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (212671, 'Sauce crème pour accompagner le poisson', 'crème fraîche, beurre, sel, poivre', '5 min', ['Mettre dans une casserole le crème fraiche, le beurre, le sel et le poivre. Mettre à chauffer tout doux et tourner jusqu''à la crème et le beurre soient liés. ', 'Il faut cuire à feu très doux sans cesser de remuer pour que la sauce reste onctueuse, si elle boue elle deviendra liquide.', 'Une fois cuite, elle nappera tous les poissons cuits au court bouillon.'], ['Planche à découper', 'Moule à tarte', 'Économe', 'Ouvre-boîte'], ['recettes', 'boisson', 'sauces à la crème', 'cuisine', 'beurre', 'recettes de cuisine', 'entrée', 'testées', 'Sauce crème pour accompagner le poisson', 'bon marché', 'dessert', 'recette', 'rapide', 'cocktail', 'poivre', 'plat de résistance', 'plat', 'confiserie', 'sel', 'crème fraîche', 'facile'], 'Sauce', e92be45d-360a-4158-ae60-419a5098f588, '2025-09-26T15:00:18.496842', [{'ingredient_id': 'bacc5d26-bae7-4212-b384-d4bbf93cac7e', 'quantite': '40 cl'}, {'ingredient_id': '5ddc5501-7c97-444c-b684-fdface096f78', 'quantite': '40 g'}, {'ingredient_id': '1f7f4f9b-4492-4a8d-977b-329119e63a31', 'quantite': ''}, {'ingredient_id': 'ab224ea0-f849-4533-8b1f-9c3f67d140fa', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (534231, 'Crumble de sardines en boite par Laurent Mariotte', 'sardine, beurre, farine, amandes en poudre, thym, citron, tomate, oignon rouge, basilic, Vinaigre de vin rouge Amora, sel, poivre du moulin', '10 min', ['Préparez la pâte à crumble : mélangez le beurre coupé en cubes, la farine, la poudre d’amandes, une pincée de sel, le thym effeuillé et le zeste de citron jusqu’à obtenir une pâte homogène mais friable.', 'Videz les boîtes de sardines dans le saladier pour les tomates. Récupérez les sardines écrasez-les à la fourchette dans une assiette. Répartissez les miettes de sardines dans les boîtes et ajoutez le crumble sur le dessus. Enfournez 15 minutes à 170°C.', 'Coupez les tomates en quartiers. Ajoutez-les dans le saladier contenant l’huile des sardines. Arrosez de vinaigre, salez, poivrez. Ajoutez l’oignon rouge émincé et le basilic concassé. Mélangez.', 'Servez les crumbles accompagnés de la salade de tomate.'], ['Batteur électrique', 'Tire-bouchon'], ['', 'recettes', 'boisson', 'très facile', 'cuisine', 'farine', 'beurre', 'recettes de cuisine', 'entrée', 'testées', 'bon marché', 'dessert', 'recette', 'thym', 'cocktail', 'Crumble de sardines en boite par Laurent Mariotte', 'plat de résistance', 'Vinaigre de vin rouge Amora', 'plat', 'citron', 'basilic', 'confiserie', 'oignon rouge', 'sardine', 'tomate', 'sel', 'amandes en poudre', 'poivre du moulin'], 'Plat principal', e6dbb89b-a4ed-4327-9a72-0c9ec75a8d75, '2025-09-26T15:00:22.881760', [{'ingredient_id': '318b4818-a184-4d81-95bb-fb87c9e6b865', 'quantite': '4'}, {'ingredient_id': '9c0b73e4-5e31-4d84-87c2-2d73f39a58ce', 'quantite': '70 g'}, {'ingredient_id': 'a235bcfa-9470-4b70-83f7-fbaf64b24121', 'quantite': '70 g'}, {'ingredient_id': '07619fb5-5e2b-4773-81af-210142b199ad', 'quantite': '70 g'}, {'ingredient_id': '8c895115-45af-436a-a5fa-a860839386df', 'quantite': '4'}, {'ingredient_id': 'dc9dba08-3c2b-4761-8619-cde79e231e9a', 'quantite': '1'}, {'ingredient_id': '793a1026-72f4-43bc-b041-34fb6d81f9d0', 'quantite': '800 g'}, {'ingredient_id': '6036ce6c-f483-40c9-88a2-03ffbbf00f82', 'quantite': '1'}, {'ingredient_id': '7cd09875-3a53-452d-9220-e78e08616366', 'quantite': '3'}, {'ingredient_id': '522762cb-ade5-430d-81c0-dcecaaa43547', 'quantite': '2 cuillères'}, {'ingredient_id': '47800f92-3da1-4eeb-b9e7-1afaf2f3a1bd', 'quantite': ''}, {'ingredient_id': '6d1024d2-169e-41ad-9fc6-a8eb929b91c8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392065, 'Burger vegan au chou-fleur et sauce curry', 'farine, lait d''avoine, huile d''olive, levure de boulanger sèche, sucre, sel, sésame, chou-fleur, chou rouge, laitue, huile d''olive, sel, poivre, crème de coco, curry, piment', '40 min', ['Commencer par préparer les buns : mettre la levure dans le lait légèrement tiédi pendant 10 minutes.', 'Dans un saladier, mélanger la farine avec le sel et le sucre. Creuser un puits au centre et y verser le lait avec la levure et l''huile. Mélanger et pétrir jusqu''à obtention d''une pâte homogène.', 'Mettre en boule, recouvrir d''un torchon et laisser pousser 2h à température ambiante (dans une pièce chaude ou près d''un radiateur s''il fait froid).', 'Dégazer la pâte en enfonçant le poing dedans puis pétrir la pâte sur un plan de travail fariné. La partager en 4 morceaux égaux, en faire des boules et les aplatir légèrement.', 'Les laisser pousser à nouveau, recouverts d''un torchon pendant 40 minutes.', 'Préchauffer le four à 200°C (thermostat 6-7). 
Disposer les boules sur une plaque recouverte de papier cuisson. Les humidifier légèrement avec du lait végétal ou de l''eau et saupoudrer de graines de sésame. Faire une croix sur le dessus des buns avec un couteau si vous le souhaitez. Enfourner pour 20 minutes de cuisson et laisser refroidir sur une grille à la sortie du four.', 'Pour la garniture : détailler le chou-fleur en tranches d''environ 5 mm d''épaisseur. Les répartir sur une plaque à four recouverte de papier cuisson. Huiler et saupoudrer de sel.', 'Enfourner à 200°C (thermostat 6-7) pour 35 à 40 minutes de cuisson.', 'Détailler le chou-rouge en lamelles. Assaisonner ainsi que la laitue de l''huile restante, de sel et de poivre.', 'Préparer la sauce en mélangeant tous les ingrédients. Ajouter un peu d''eau si la sauce est trop épaisse.', 'Monter les burgers : couper en 2 les buns.
Disposer un peu de sauce sur les fonds puis le mélange laitue-chou-rouge. Recouvrir de chou-fleur rôti puis du reste de la sauce. Fermer les burgers et déguster.'], ['Spatule', 'Rouleau à pâtisserie', 'Moule à tarte', 'Râpe'], ['recettes', 'boisson', 'plat principal', 'cuisine', 'lait d''avoine', 'farine', 'sucre', 'recettes de cuisine', 'entrée', 'testées', 'bon marché', 'dessert', 'recette', 'cocktail', 'Burger vegan au chou-fleur et sauce curry', 'plat de résistance', 'plat', 'confiserie', 'huile d''olive', 'sel', 'sésame', 'facile', 'levure de boulanger sèche'], 'Accompagnement', ea519efe-5447-4060-bb84-89be5fe30847, '2025-09-26T15:00:27.621301', [{'ingredient_id': '2aead780-9250-44c0-9ea0-473ea51cecc6', 'quantite': '150 g'}, {'ingredient_id': 'c99c327d-5112-41ff-a63d-041a0b751ac4', 'quantite': '9 cl'}, {'ingredient_id': '89d110f1-2c66-4a8f-b0c4-76d740cfbb92', 'quantite': '2 cuillères'}, {'ingredient_id': '7abbbd51-7297-4191-9fb3-0c8a2fa7cc14', 'quantite': '1 cuillères'}, {'ingredient_id': 'dc54e1b8-078d-4c76-8c0a-5877d94d6205', 'quantite': '1 cuillères'}, {'ingredient_id': '632ded13-03d9-4d6d-a609-508c074a4b11', 'quantite': '1'}, {'ingredient_id': 'f5fdb340-b268-4243-a1cc-dcdf114f51cf', 'quantite': '1 cuillères'}, {'ingredient_id': '6a838cca-8383-4d00-a505-9e9b6a2b8b5d', 'quantite': ''}, {'ingredient_id': '45d3e61d-ffa7-44f2-9d0b-3151481bcff3', 'quantite': '20 g'}, {'ingredient_id': '90a7a5c6-a775-4f81-b634-21dc0a4f3a5f', 'quantite': '8'}, {'ingredient_id': 'd6d6e464-c7cc-44a3-b5b2-3e39e28c5ba4', 'quantite': '3 cuillères'}, {'ingredient_id': '8b816194-656b-404c-8c08-36be4b6811c8', 'quantite': ''}, {'ingredient_id': '7bd2eb75-3a9c-4022-9bc3-c929379e1a9a', 'quantite': ''}, {'ingredient_id': 'b6e8ca17-342b-4530-b454-c1e242bd273d', 'quantite': '3 cuillères'}, {'ingredient_id': 'a79a1425-5492-46d7-be0b-4b8a21d34830', 'quantite': '1 cuillères'}, {'ingredient_id': '82dcdfa9-8087-4e89-8d61-e5420b2dbe09', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (35837, 'Cannelloni à la Florentine ( épinards et viande )', 'canneloni, viande hachée, épinards, gruyère râpé, coulis de tomate, oeuf, oignon, persil, ail, poivre, sel, huile d''olive', '45 min', ['Faire blanchir les épinards en 5 minutes.', 'Pendant ce temps, faire revenir un oignon, y ajouter 250 grammes de viande hachée, ainsi que de l''ail et du persil.', 'Ajouter ensuite les épinards hachés, sel et poivre, puis laisser cuire 5 minutes.', 'Faire revenir le deuxième oignons dans une cocotte, y ajouter la viande une fois revenue, puis y ajouter le coulis de tomate.', 'Assaisonner (sel et herbes de Provence), puis laisser cuire 15 minutes', 'Une fois la farce cuite, la laisser refroidir un peu et y rajouter l’œuf pour faire la liaison.', 'Remplir les cannelloni avec la farce, les disposr dans un plat à four préalablement huilé. Les recouvrir avec la sauce tomate et ajouter du gruyère râpé dessus.', 'Mettre au four et laisser cuire 30 minutes (thermostat 7/210°C).', 'Servir avec une salade verte, de préférence une rougette de Montpellier.'], ['Moule à tarte', 'Verre doseur', 'Fouet'], ['huile d''olive', 'entrée', 'cocktail', 'moyen', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'oeuf', 'gruyère râpé', 'viande hachée', 'facile', 'plat de résistance', 'recette', 'Cannelloni à la Florentine ( épinards et viande )', 'sel', 'épinards', 'autres pâtes', 'persil', 'dessert', 'oignon', 'canneloni', 'ail', 'poivre', 'coulis de tomate', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:02:09.203135', [{'ingredient_id': '5a903dd9-62b3-44aa-bcba-962e4473b612', 'quantite': '12'}, {'ingredient_id': 'abecda94-6fd7-4ea3-b425-96c8e509543f', 'quantite': '350 g'}, {'ingredient_id': 'e0a44d45-7175-415c-b203-9ae916103c8e', 'quantite': '200 g'}, {'ingredient_id': '2e2e10cf-2af6-47fe-8118-421fab5a7ca1', 'quantite': '100 g'}, {'ingredient_id': '1b700aec-d0c0-4ae5-8b22-ec40db5e55a4', 'quantite': '25 cl'}, {'ingredient_id': 'b447c169-4674-4a68-93c2-8ac08071850d', 'quantite': '1'}, {'ingredient_id': '0b9c00d1-cd71-44e7-906d-0651e388fce6', 'quantite': '2'}, {'ingredient_id': '5d60540e-a1a4-4fdc-b643-182d74232ca8', 'quantite': '1'}, {'ingredient_id': 'ded4198a-bf5c-4656-87c4-3aeda27a5c88', 'quantite': '3'}, {'ingredient_id': 'c2c4bfcc-1f4f-4809-8f0f-5d2d14befe46', 'quantite': ''}, {'ingredient_id': 'd1821106-c25c-4b08-96a6-9f21e9126d70', 'quantite': ''}, {'ingredient_id': '559058b5-3eab-417e-ba0d-010979f15e1e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (311867, 'Sauce kebab "Shoarma"', 'mayonnaise, crème fraîche, ciboulette, persil, jus de citron, ail, eau', '15 min', ['Dans un bol, mélanger la crème fraîche et le jus de citron. Laisser au repos 15 min.', 'Dans un autre bol, mélanger le reste des ingrédients à savoir: mayonnaise, ciboulette, persil, et ail.', 'Ajouter ce dernier mélange mayonnaise à la crème fraîche à l''aide d''un fouet. Ajouter de l''eau jusqu''à obtenir la consistance désirée.'], ['Presse-agrumes', 'Ouvre-boîte', 'Poêle'], ['entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'bon marché', 'facile', 'Autres sauces', 'plat de résistance', 'recette', 'rapide', 'Sauce kebab "Shoarma"', 'mayonnaise', 'persil', 'dessert', 'eau', 'crème fraîche', 'jus de citron', 'ail', 'boisson', 'ciboulette', 'recettes'], 'Sauce', 6e3c764e-6ea8-410b-a761-83ce26187a63, '2025-09-26T15:02:13.917449', [{'ingredient_id': '0ccddb0d-27db-4675-8c74-f3377ac9f66d', 'quantite': '6 cuillères'}, {'ingredient_id': 'dee833b2-16de-4987-9aa6-59aec3eb778d', 'quantite': '8 cuillères'}, {'ingredient_id': 'bfa959fe-81aa-4b6b-99e9-9d07299d130d', 'quantite': ''}, {'ingredient_id': 'b88fd599-be5e-4b2b-84bb-4b5fe22aaca0', 'quantite': ''}, {'ingredient_id': '93f3ce38-8ec0-4df6-a97c-ca77f4ff4fa3', 'quantite': '4 cuillères'}, {'ingredient_id': 'a4381e87-941a-42d7-8122-f20ac03e833b', 'quantite': '3 cuillères'}, {'ingredient_id': 'a15d0eb5-69d9-415a-afbf-d1f744c08991', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (53672, 'Sauce verte (pour viandes ou poissons)', 'anchois, ail, huile d''olive, oeuf, vinaigre, câpres, pain, persil, sucre, sel', '20 min', ['Bien laver les feuilles de persil (ôter complètement les tiges), les essuyer et les hacher finement. ', 'Hacher finement les anchois aussi (après les avoir bien déssalées), l''ail, les câpres (lavés à l''eau si conservés sous sel).', 'Imbiber la mie de pain dans le vinaigre, la presser et la passer au tamis. ', 'Bien mélanger tous ces ingrédients et y ajouter les 2 jaunes d''oeuf durs finement écrasés, l''huile, sel et poivre. ', 'En tout dernier, les 2 blancs également passés au tamis (facultatif).', 'Servir dans une saucière, pour accompagner du poisson ou de la viande bouillie.'], ['Couteau de chef', 'Ouvre-boîte'], ['huile d''olive', 'câpres', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'sucre', 'confiserie', 'testées', 'oeuf', 'très facile', 'bon marché', 'plat de résistance', 'Autres sauces', 'recette', 'rapide', 'sel', 'Sauce verte (pour viandes ou poissons)', 'persil', 'anchois', 'dessert', 'pain', 'ail', 'vinaigre', 'boisson', 'recettes'], 'Sauce', 323a57d4-483d-4f9f-a378-c5474160aca9, '2025-09-26T15:02:17.695065', [{'ingredient_id': '08c6ff51-3b40-408d-a3ea-1f0ecb880ebc', 'quantite': '3'}, {'ingredient_id': 'f8a0f166-d004-4c45-aff2-f40f8ce7a308', 'quantite': '1'}, {'ingredient_id': '38fa3c09-c821-48dd-8624-071a7cddb56e', 'quantite': '100 g'}, {'ingredient_id': 'c5044074-8b8b-48eb-aee6-f3a3f2fc1b22', 'quantite': '2'}, {'ingredient_id': '248d3488-6921-44eb-9d86-5b21e458ef36', 'quantite': '50 g'}, {'ingredient_id': 'b84f8879-a01b-4cc6-9f74-664b7377f885', 'quantite': '1 cuillères'}, {'ingredient_id': '0f6bab56-79a3-4467-a468-5bc254ffed9d', 'quantite': '50 g'}, {'ingredient_id': 'a62580da-7c8f-4457-9a29-743acd5bc806', 'quantite': '120 g'}, {'ingredient_id': '0c981d07-1944-4b82-9231-c9b52581b18f', 'quantite': '1'}, {'ingredient_id': '1a1ddc97-eac0-43d3-89e3-ea4be03a7284', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16456, 'Chiche-kebab', 'viande hachée, viande d’agneau, ail, oignon, citron, huile, yaourt, menthe, poivre, sel', '20 min', ['Peler et hacher très fin ail et oignon. Les mettre dans une jatte avec le jus de citron, le yaourt, l''huile, les viandes hachées, sel et poivre.', 'Laisser mariner 10 minutes puis façonner des boulettes allongées à piquer sur des baguettes en bois.', 'Griller 5 minutes au grill ou au barbecue, en retournant régulièrement.', 'Servir avec la marinade assaisonnée avec la menthe fraîche.'], ['Râpe', 'Passoire', 'Balance de cuisine'], ['huile', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'menthe', 'confiserie', 'Chiche-kebab', 'testées', 'kebab', 'viande hachée', 'bon marché', 'facile', 'plat de résistance', 'citron', 'recette', 'rapide', 'sel', 'viande d’agneau', 'dessert', 'oignon', 'yaourt', 'ail', 'poivre', 'boisson', 'recettes'], 'Plat principal', bd804469-5e24-4bbd-b535-e9307de59824, '2025-09-26T15:02:21.413163', [{'ingredient_id': 'bd167378-c285-4eba-a418-515287f09277', 'quantite': '200 g'}, {'ingredient_id': '71b4eec0-594d-4764-87cb-451999a7b17c', 'quantite': '200 g'}, {'ingredient_id': '6ee9e993-777a-4204-84fe-d5612e4cdf3f', 'quantite': '1'}, {'ingredient_id': '9710cf2a-113b-439d-97db-42969e1ad56a', 'quantite': '1'}, {'ingredient_id': '598986db-92cb-44be-a83d-5714fd4dae86', 'quantite': '1'}, {'ingredient_id': 'd765ef83-1315-4793-b353-ee910e586710', 'quantite': '2 cuillères'}, {'ingredient_id': '77797879-a143-4bbc-91af-17415a979890', 'quantite': '1'}, {'ingredient_id': 'd0af9d12-60d7-4834-85c4-31b10709bb4e', 'quantite': ''}, {'ingredient_id': 'e49cb081-5693-47ef-bf9c-00f73d3cb985', 'quantite': ''}, {'ingredient_id': '955a98d4-8daf-48fd-aaf4-b7aa4586a306', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345086, 'Tartelette viande hachée', 'pâte brisée, poivron rouge, poivron vert, concentré de tomates, mozzarella, oeuf, viande hachée, beurre, eau, fromage râpé, sel, poivre, paprika, ail, oignon', '20 min', ['Couper la pâte brisée en 4 et la mettre dans des moules à tartelettes en coupant ce qui dépasse.', 'Piquer le fond avec une fourchette et mettre au four à 180°C jusqu''à ce que la pâte commence à dorer.', 'Couper les oignons et les poivrons en petits morceaux (moi, je mets que la moitié d''un poivron mais vous pouvez très bien en mettre plus selon vos goûts). ', 'Faire fondre le beurre dans une poêle et faire dorer l''oignon et les poivrons.', 'Incorporer la viande hachée, mettre le sel, le poivre, le paprika et l''ail en poudre.', 'Une fois que la viande est cuite, mettre la boite de concentrée de tomate ainsi que l''eau, bien mélanger et laisser réduire (vous pouvez goûter la préparation pour vérifier s''il y a assez de sel, poivre etc...).', 'Enlever du feu et mettre un oeuf et mélanger.', 'Mettre le fromage râpé dans la préparation et mélanger.', 'Remplir les tartelettes de la préparation et mettre la mozzarella dessus (soit râpée, soit coupée en morceaux).', 'Mettre au four à 200°C (thermostat 6-7) et attendre que le fromage ait bien fondu.', 'Déguster ces délicieuses tartelettes accompagnées d''une salade verte. :)'], ['Mixeur', 'Spatule'], ['', 'entrée', 'cocktail', 'poivron vert', 'moyen', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'oeuf', 'viande hachée', 'facile', 'plat de résistance', 'fromage râpé', 'concentré de tomates', 'recette', 'Tartelette viande hachée', 'pâte brisée', 'sel', 'beurre', 'dessert', 'oignon', 'eau', 'ail', 'poivron rouge', 'mozzarella', 'poivre', 'paprika', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:02:25.252695', [{'ingredient_id': 'e22b1040-5338-4e24-93fc-dabf904bf98e', 'quantite': '1'}, {'ingredient_id': 'd538bc5e-bc28-4e24-bd22-768eb86d9a53', 'quantite': '1'}, {'ingredient_id': 'e2535c5f-4c16-4eb6-b296-b4cc341f244f', 'quantite': '1'}, {'ingredient_id': '5da4564b-fc2a-4b8b-8a38-9d43186318e2', 'quantite': '1'}, {'ingredient_id': 'e37a3ea4-83d3-468a-b3a8-0e40ad4ce514', 'quantite': '1'}, {'ingredient_id': '67cf46a0-c9ee-4823-bf41-b161bebbff30', 'quantite': '1'}, {'ingredient_id': 'a58f5d93-ab48-49f5-927d-c19c02e5d0b2', 'quantite': '300 g'}, {'ingredient_id': '07796931-fff9-46e0-bc89-f8ece1ff78ab', 'quantite': '15 g'}, {'ingredient_id': '2b4db504-ba43-4267-a832-6ade8163aef8', 'quantite': '10 cl'}, {'ingredient_id': '27c0aaf3-dd93-4e57-b418-68a0de69ca57', 'quantite': '100 g'}, {'ingredient_id': '8ac253d4-b256-43b5-a3db-59f07b3d4060', 'quantite': '1.5 cuillères'}, {'ingredient_id': 'cc3dfa9b-add5-46ce-b6af-398c278cf25a', 'quantite': '1 cuillères'}, {'ingredient_id': '31d2e531-954d-4d77-95e4-e2ddd086112b', 'quantite': '1 cuillères'}, {'ingredient_id': 'ac97eb9d-2866-46a9-b203-384218a610cd', 'quantite': '1 cuillères'}, {'ingredient_id': 'acaeb502-c89d-446d-a61a-c9dc89a8dd44', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (64022, 'Pizza kebab', 'pâte à pizza, coulis de tomate, poulet, mozzarella, gruyère, tomate, huile d''olive', '10 min', ['Etaler la pâte à pizza au rouleau à pâtisserie et mettre dans un moule huilé et fariné (ou la poser ainsi sur une feuille de papier sulfurisé).', 'Déposer la garniture en commençant par étaler la sauce tomate, le kebab, la mozarella coupée en morceaux, le gruyère, la tomate en rondelles et le filet d''huile d''olive. ', 'Mettre au four selon l''indication du paquet pendant 20 min.'], ['Mixeur', 'Balance de cuisine', 'Louche', 'Moule à tarte'], ['huile d''olive', 'Pizza kebab', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'très facile', 'kebab', 'bon marché', 'plat de résistance', 'recette', 'pâte à pizza', 'gruyère', 'dessert', 'tomate', 'poulet', 'mozzarella', 'coulis de tomate', 'boisson', 'recettes'], 'Plat principal', bcd288c6-83bb-494a-9550-382746e5779c, '2025-09-26T15:02:28.879011', [{'ingredient_id': 'cb6eac99-dd15-436f-aaaa-9c340697ca53', 'quantite': '1'}, {'ingredient_id': 'd563fdda-fe61-4994-9ee6-c976fd0dab69', 'quantite': '2 cuillères'}, {'ingredient_id': '7fb86f7e-a453-438c-9060-7d713d0d5ef5', 'quantite': '150 g'}, {'ingredient_id': '62b48abb-d711-4871-9ab8-712cefdb1b95', 'quantite': '1'}, {'ingredient_id': '46f7ecab-ed54-457f-8107-c37ec88c8fa5', 'quantite': '50 g'}, {'ingredient_id': 'f26133b9-ae45-4fbe-9924-df3b3d1cd917', 'quantite': '1'}, {'ingredient_id': 'dd62bf78-d342-4e70-adeb-ebb2b8812328', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (63572, 'Sauce à l''époisse pour accompagner les viandes', 'époisses, crème semi-épaisse, poivre, muscade', '3 min', ['Dans une casserole, à feu très très doux, faire chauffer délicatement la crème. Ajouter l''époisse coupé en dés (on peut laisser la croûte qui fondera tranquillement elle-aussi).', 'Laisser épaissir à feu toujours très doux.', 'Quelques tours de moulin à poivre (par trop), une légère pincée de muscade (pas de sel, l''époisse est déjà bien assez salé).', 'Quand la sauce à suffisamment épaissie, la servir avec une viande rouge.'], ['Poêle', 'Rouleau à pâtisserie'], ['crème semi-épaisse', 'Sauce à l''époisse pour accompagner les viandes', 'muscade', 'entrée', 'cocktail', 'moyen', 'recettes de cuisine', 'plat', 'époisses', 'cuisine', 'confiserie', 'testées', 'très facile', 'plat de résistance', 'Autres sauces', 'recette', 'rapide', 'dessert', 'poivre', 'boisson', 'recettes'], 'Sauce', 9443b609-ff0b-485a-95be-5fff1a696ff6, '2025-09-26T15:02:32.562104', [{'ingredient_id': '4583ddf5-fee6-4b68-84cb-c1f2fb1e43c3', 'quantite': '100 g'}, {'ingredient_id': '838b8ba5-3a88-46db-8bdb-d1908c67dddc', 'quantite': '20 cl'}, {'ingredient_id': '186b4c8f-f3db-497c-8421-7705534e720a', 'quantite': ''}, {'ingredient_id': '879a0631-5170-464f-bcee-cfdd7a540494', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24677, 'Curry de viande (méthode khmère)', 'curry, viande, lait de coco, pomme de terre, carotte, oignon, échalote', '25 min', ['Mettre dans une casserole un verre de lait de coco, la préparation curry et les échalotes. Faire revenir l''ensemble pendant environ 10 mn. ', 'Ajouter la viande et laisser cuire jussqu''à l''évaporation du jus. ', 'Ajouter les pommes de terre et les carottes en morceaux et laisser cuire environ 5 mn. ', 'Ajouter le reste du lait de coco et porter à ébullition. Ajouter les oignons (coupés en gros morceaux). ', 'Laisser bouillir pendant environ 20 mn. ', 'Ajouter un peu de sel si nécessaire. ', 'Servir chaud accompagné de riz blanc.'], ['Pince de cuisine', 'Balance de cuisine', 'Économe'], ['entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'pomme de terre', 'très facile', 'échalote', 'bon marché', 'viande', 'plat de résistance', 'recette', 'viande à l''indienne', 'carotte', 'Curry de viande (méthode khmère)', 'lait de coco', 'dessert', 'oignon', 'curry', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:02:36.265919', [{'ingredient_id': '80362c5b-cccb-446e-be10-09541cf07195', 'quantite': '1.5 cuillères'}, {'ingredient_id': '3c9b5487-64db-4a7f-b20f-5d9f23c3de60', 'quantite': '500 g'}, {'ingredient_id': '8919e550-6390-4c4a-83f0-2666fd9e9d1b', 'quantite': '1 l'}, {'ingredient_id': '2786f396-590b-4a6c-bed8-7d200821a2c9', 'quantite': '400 g'}, {'ingredient_id': '1bd62a86-c5ac-46c0-beac-6e713b66fea4', 'quantite': '200 g'}, {'ingredient_id': 'de36b668-5e29-4fd9-beb1-0168ffaafa6f', 'quantite': '200 g'}, {'ingredient_id': 'b8ef69d0-2e06-4526-aa0c-56fc5ba2973a', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17838, 'Tarte de petits légumes à la viande', 'pâte feuilletée, boeuf haché, viande hachée, courgette, carotte, poivron rouge, oignon, ail, crème liquide, oeuf, pistou, Ras el Hanout, thym, herbes de Provence, persil, muscade, huile d''olive, poivre, sel', '40 min', ['Laver, éplucher et couper les légumes. Hâcher l''oignon et l''ail. Faire revenir dans l''huile d''olive et ajouter les légumes. En cours de cuisson, incorporer le pistou, le raz el hanout et le thym. ', 'Saler, poivrer. ', 'Mélanger les viandes dans un saladier, saler, poivrer, ajouter du persil et quelques herbes de Provence. Faire revenir dans une poêle avec un peu d''huile d''olive. ', 'Etaler la pâte feuilletée dans un moule à tarte. Verser les légumes puis la viande. ', 'Faire un flan avec la crème, l''oeuf, la noix de muscade, saler, poivrer. Verser sur la tarte. ', 'Cuire au four 25 mn thermostat 7 .'], ['Râpe', 'Balance de cuisine', 'Ouvre-boîte', 'Couteau de chef', 'Mixeur'], ['', 'courgette', 'huile d''olive', 'muscade', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'pâte feuilletée', 'testées', 'oeuf', 'boeuf haché', 'viande hachée', 'herbes de Provence', 'bon marché', 'facile', 'plat de résistance', 'thym', 'recette', 'carotte', 'Tarte de petits légumes à la viande', 'Ras el Hanout', 'sel', 'persil', 'dessert', 'oignon', 'crème liquide', 'ail', 'poivron rouge', 'pistou', 'poivre', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:02:39.975602', [{'ingredient_id': '2875716b-521d-434b-b054-80871026a62e', 'quantite': '1'}, {'ingredient_id': '03417592-82da-494d-bebb-740665a5b7ca', 'quantite': '250 g'}, {'ingredient_id': '896afc1c-479c-4a44-b89f-ad3df50d3f54', 'quantite': '250 g'}, {'ingredient_id': 'c91f3dd7-83d1-405f-995e-273e1ab66d0d', 'quantite': '3'}, {'ingredient_id': 'f02f8d50-3b4a-4341-b91f-281a1cff8eb8', 'quantite': '3'}, {'ingredient_id': '41be9595-3ccb-4cff-a022-a31bc662c9ca', 'quantite': '1'}, {'ingredient_id': 'cb7d935d-3a3a-48bd-89ba-4b8872ef500f', 'quantite': '1'}, {'ingredient_id': 'd6d1594b-2ec6-489d-9175-e7504c541fe7', 'quantite': '2'}, {'ingredient_id': '554e22a4-0d63-4fa6-84a4-15d6a9c2cc73', 'quantite': '25 cl'}, {'ingredient_id': 'fb17eeef-eeea-4fe4-a9bc-3d3d21f56722', 'quantite': '1'}, {'ingredient_id': '6378b326-dbb0-4aee-a99c-d8a4eb3a4c14', 'quantite': '1 cuillères'}, {'ingredient_id': 'ea7280a7-e3ea-4b3b-881b-1c2c71cf6d43', 'quantite': ''}, {'ingredient_id': 'b104ab46-944b-419c-b299-005483e073a3', 'quantite': ''}, {'ingredient_id': '920eb573-dd41-41a4-b046-a80045e4b577', 'quantite': ''}, {'ingredient_id': '75fdfbe0-12d4-4469-94fd-48183508ad86', 'quantite': ''}, {'ingredient_id': 'eb9bb486-9e3e-4026-90ac-fadeea1a3b77', 'quantite': ''}, {'ingredient_id': '48e4911c-2588-4fa6-a394-7346302166b6', 'quantite': ''}, {'ingredient_id': '8703919b-6648-4b3e-a99c-16af0169593c', 'quantite': ''}, {'ingredient_id': '8071ee07-8ee9-4a01-a92f-a064e66ab9d5', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18189, 'Pain de viande rapide', 'boeuf, persil, oignon, pain, sel, poivre, muscade, ketchup, oeuf', '10 min', ['Mettre dans le robot le persil et l''oignon.', 'Hacher quelque secondes, puis ajouter le pain coupé en petits dés, mixer quelque secondes.', 'Ajouter la viande, le sel, le poivre, le ketchup, l''oeuf et la muscade.', 'Mixer 5 secondes', 'Mettre le hachis dans un plat en lui donnant la forme d''une boule de pain.', 'Cuire 45 min à 175°C, thermostat 5-6.'], ['Couteau de chef', 'Batteur électrique', 'Mixeur'], ['', 'muscade', 'entrée', 'cocktail', 'moyen', 'boeuf', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'oeuf', 'facile', 'plat de résistance', 'recette', 'sel', 'Pain de viande rapide', 'persil', 'dessert', 'oignon', 'ketchup', 'pain', 'poivre', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:02:46.693570', [{'ingredient_id': '1471467c-223b-4e2e-b005-835efd6b5d9b', 'quantite': '500 g'}, {'ingredient_id': '63fb75b0-39ba-4dd6-a0ee-3c25414d9c52', 'quantite': '1'}, {'ingredient_id': '600cb7e9-b0d0-4b6d-b5cb-d3de278a9682', 'quantite': '1'}, {'ingredient_id': 'a0eabf78-92af-4ff1-945b-8e876a08f27a', 'quantite': '20 g'}, {'ingredient_id': 'b8beed13-866c-4aa4-9484-db7b7765f5c3', 'quantite': '1 cuillères'}, {'ingredient_id': '7107cb42-d2da-4da9-9070-35680899147f', 'quantite': ''}, {'ingredient_id': 'cb3c15c5-d744-441b-a5c2-93b963ac9ce9', 'quantite': '1'}, {'ingredient_id': '3c840b1a-32db-4368-9d9b-e5664d529e9a', 'quantite': '3 cuillères'}, {'ingredient_id': '6d84bf73-e3f3-411f-995b-f77338d08ce4', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392488, 'Wrap Köfte Kebab', 'viande hachée, oignon, ail, poivron, sel, épices, concentré de tomates, tomate, salade, eau, persil, aneth, concombre, crème fraîche, huile d''olive, galette, beurre', '0 min', ['Mettre dans un récipient 400 à 500 grammes de viande hachée (bovine). Éplucher un oignon et une gousse d’ail et râpés en petit morceaux.', 'Rassembler le tout dans le récipient. Ajouter une cuillère à soupe d’huile d’olive ainsi qu''une pincée de sel et des épices, herbes provençales, et un peu de poivre moulu.', 'Ajouter une tranche de poivrons rouge râpée. Puis mélanger le contenu. Donner une forme de boulettes à la farce et faire revenir dans une poêle.', 'Sauce 1 : Aouter deux cuillères à soupes de concentré de tomate puis une à deux tomates pelées sans la peau.', 'Éplucher une petite gousse d’ail et râper en petit morceaux et ajouter une pincée de sel.', 'Rassembler le tout dans une petite casserole mélanger à feux doux et ajouter au fur et à mesure un petit verre d’eau. Ensuite éteindre le feu et verser le contenu dans un bol.', 'Crudités: Deuxième saveur dans notre wrap kebab.
Laver les légumes et couper les trois feuilles de salade.', 'Ajouter une pincée d’aneth ou persil, un oignon éplucher et couper en lamelles aussi.', 'Ajouter une tomate et quelques tranches de concombre que je coupe en mini cubes. Ajouter ensuite un peu de poivron coupé en cube.', 'Pour l’assaisonnement,  ajouteR deux cuillères de crème fraîche épaisse avec une petite cuillère d’huile d’olive et du sel. Mélanger le tout.', 'Dans une petite casserole faire fondre le beurre.', 'Mettre en premier la sauce et ajouter ensuite les boulettes, un peu de salade et une cuillère de beurre fondu. 
La technique pour refermer le wrap est simple : Il faut commencer le wrap en une ligne droite au milieu. Puis refermer le bas puis couvrir d’un côté et rouler jusqu’à l’autre côté et mettre un cure-dent pour tenir votre wrap.', 'J’allume la poêle à feu doux et chauffer les deux côtés. 
 Bon appétit !'], ['Pince de cuisine', 'Moule à tarte'], ['salade', 'huile d''olive', 'poivron', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'viande hachée', 'concombre', 'bon marché', 'galette', 'facile', 'plat de résistance', 'concentré de tomates', 'plat principal', 'recette', 'rapide', 'aneth', 'sel', 'beurre', 'persil', 'dessert', 'eau', 'oignon', 'tomate', 'crème fraîche', 'épices', 'ail', 'Wrap Köfte Kebab', 'boisson', 'recettes'], 'Plat principal', 11554816-11f3-4392-bb87-38abcd96560f, '2025-09-26T15:02:51.063752', [{'ingredient_id': '4b1ffcf3-22cd-4292-bfd2-21cfc389b1c0', 'quantite': '400 g'}, {'ingredient_id': 'f2c02356-cd60-496f-aea9-e76c1b7d6577', 'quantite': '2'}, {'ingredient_id': '982e2b3d-d57c-4f2f-8676-826ced03d834', 'quantite': '2'}, {'ingredient_id': '565576fd-8fe0-4a7d-b0bf-2f92937a5472', 'quantite': ''}, {'ingredient_id': 'daf08ca2-8db8-4edd-a1fd-c06d8aa04307', 'quantite': ''}, {'ingredient_id': '1ff33ebe-1847-4707-bc1b-90dd522440ce', 'quantite': ''}, {'ingredient_id': '57286d2d-1aae-4575-818d-8091458cfdf0', 'quantite': '2 cuillères'}, {'ingredient_id': '9771fb56-0a30-4ff8-adaf-675bb07a0022', 'quantite': '3'}, {'ingredient_id': '98c661cb-d3b5-46d1-9976-aeb6f231fcf0', 'quantite': '3'}, {'ingredient_id': 'c125d481-e88a-40d6-9cba-55d456b28d1e', 'quantite': '1'}, {'ingredient_id': '9a6ea54b-4e0e-4f4b-bb22-9a52293cce8d', 'quantite': ''}, {'ingredient_id': 'a17bd923-8d0b-4fdb-bb99-6f36a38786dd', 'quantite': ''}, {'ingredient_id': '2484403c-0c47-44e6-a3b2-561b39ea51f2', 'quantite': '1'}, {'ingredient_id': '881b9682-73fb-43f4-a0c4-62144e6ab83c', 'quantite': '2 cuillères'}, {'ingredient_id': '3838db39-ae20-4445-b184-231c18d8c6fe', 'quantite': '2 cuillères'}, {'ingredient_id': '6c6f5ea9-fd9e-411c-be00-77930fcc5495', 'quantite': '4'}, {'ingredient_id': '446e5050-90f0-44ef-83bd-1455289a645b', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14451, 'Sauce blanche express pour kebab', 'yaourt à la grecque, menthe, eau', '5 min', ['Diluer le yogourt avec un peu d''eau, puis ajouter de la menthe finement ciselée.', 'C''est tout !'], ['Louche', 'Pince de cuisine'], ['entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'menthe', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat de résistance', 'Autres sauces', 'Sauce blanche express pour kebab', 'recette', 'rapide', 'dessert', 'eau', 'yaourt à la grecque', 'boisson', 'recettes'], 'Sauce', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:02:54.609509', [{'ingredient_id': '95bee749-9662-4dde-a728-ad51c543619e', 'quantite': '500 g'}, {'ingredient_id': 'cb7c150b-28ab-431e-99ff-00e719ef648d', 'quantite': ''}, {'ingredient_id': 'a678f463-6f8d-4a0c-8d9f-8452bb699bde', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16545, 'Pâté de viande (Normandie)', 'veau, jambon, poitrine de porc, farine, oeuf, lait, sel, poivre, muscade, Liqueur, barde de lard, gelée', '30 min', ['Hacher fin la poitrine de porc et couper en lamelles le jambon et le veau.', 'Dans un grand saladier, mélanger les 3 sortes de viande, ajouter la farine, l’œuf, l’assaisonnement, le parfum, puis le liquide petit à petit.', 'Tapisser complètement une terrine à pâté avec la barde. Verser la préparation à l’intérieur. ', 'Mettre sur le dessus une grande feuille de laurier et une ou deux branches de thym (si vous aimez ça). Recouvrir le tout avec de la barde dans laquelle vous aurez pratiqué des incisions au couteau.', 'Cuire à four chaud (6/7) pendant 2 heures sans couvercle. Pour que le pâté soit plus digeste et plus ''light'', il est conseillé de jeter une grande partie du gras fondu qui est tout autour de pâté. Attention à ne pas se brûler!', 'Préparer la gelée et la verser sur le pâté, en ayant fait des incisons dans le pâté pour que la gelée pénètre.', 'Reste le plus difficile : attendre 3 ou 4 jours que le pâté soit légèrement ''rassis'' avant de déguster.'], ['Râpe', 'Mixeur', 'Poêle'], ['lait', 'pâté', 'gelée', 'muscade', 'entrée', 'cocktail', 'moyen', 'recettes de cuisine', 'poitrine de porc', 'plat', 'farine', 'cuisine', 'jambon', 'confiserie', 'barde de lard', 'oeuf', 'testées', 'terrine', 'Liqueur', 'facile', 'plat de résistance', 'recette', 'sel', 'veau', 'Pâté de viande (Normandie)', 'dessert', 'poivre', 'boisson', 'recettes'], 'Entrée', ca2153bc-c1f3-412c-8500-2d247cce7dc5, '2025-09-26T15:02:58.251962', [{'ingredient_id': '5c251afc-8834-463e-b1b8-09ee01ee1e19', 'quantite': '350 g'}, {'ingredient_id': '4b45998c-ae82-4747-aed1-46356c484fb9', 'quantite': '350 g'}, {'ingredient_id': '26c0d270-da77-4ad6-b079-e4bf3f13810c', 'quantite': '350 g'}, {'ingredient_id': 'a8b39912-d5bc-4e5b-b015-7131035107f8', 'quantite': '1.5 cuillères'}, {'ingredient_id': '852fa11d-e631-4642-af49-91ec7e7b5426', 'quantite': '1'}, {'ingredient_id': '97d6cb30-1f92-4e84-ac49-73aa48690544', 'quantite': ''}, {'ingredient_id': '27837df6-ab25-42ab-b5eb-57a10255388c', 'quantite': '1 cuillères'}, {'ingredient_id': 'cf76cd80-f47c-4d76-8d2d-7ea4503431db', 'quantite': ''}, {'ingredient_id': '49fe687a-9f71-465e-a6fa-32198aee9cbf', 'quantite': '1 cuillères'}, {'ingredient_id': 'e9d560f6-d630-4501-9dc4-2a14b632df87', 'quantite': '1'}, {'ingredient_id': 'fa182565-a194-4c6e-8a54-fb8865d82927', 'quantite': '1'}, {'ingredient_id': 'f211a118-ca09-4d55-b692-ea59003c7ca9', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81512, 'Bricks à la viande et moutarde', 'brick, viande hachée, oignon, oeuf, crème fraîche, moutarde à l''ancienne, ail, sel, poivre, beurre, huile', '15 min', ['Couper l''oignon finement et le faire revenir dans une poêle chaude avec le beurre. Avant sa coloration, ajouter la viande hachée et la gousse d''ail entière à peine écrasée, le sel et le poivre.', 'Bien mélanger en écrasant avec la spatule pour éviter les "boulettes"!', 'Quand la viande est cuite, baisser le feu et mettre la moutarde. Bien mélanger puis ajouter la crème fraiche et les œufs; laisser cuire 2-3 min en remuant bien. ', 'Retirer la gousse d''ail et laisser tiédir.', 'Préparer les feuilles de brick: lescouper en deux et les séparer feuille par feuille. Déposer 2 cuillères à soupe de préparation par moitié de bricks, formez des triangles. ', 'Faire chauffer la friture et faire dorer vos samosas des deux cotés.', 'Servir bien chauds!'], ['Louche', 'Planche à découper', 'Pince de cuisine'], ['brick', 'huile', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'moutarde à l''ancienne', 'cuisine', 'confiserie', 'testées', 'oeuf', 'très facile', 'viande hachée', 'bon marché', 'plat de résistance', 'recette', 'Bricks à la viande et moutarde', 'rapide', 'sel', 'beurre', 'dessert', 'oignon', 'crème fraîche', 'ail', 'poivre', 'boisson', 'recettes'], 'Amuse-gueule', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:03:03.319192', [{'ingredient_id': 'a446ab06-0ad6-4eb0-86c3-e30e78582144', 'quantite': '10'}, {'ingredient_id': '893eadec-fd4e-493c-93d6-fd7deb18d5e8', 'quantite': '300 g'}, {'ingredient_id': 'f0328ecf-6f9b-48cf-b817-b337d91ac692', 'quantite': '1'}, {'ingredient_id': '32e38cc4-4016-488c-9592-0f2ab5b5a7e5', 'quantite': '2'}, {'ingredient_id': '8ff01018-2c74-4f79-bda4-7e246f98c117', 'quantite': '3 cuillères'}, {'ingredient_id': '7430d783-7f0c-46ac-a283-1c2680151cf6', 'quantite': '1 cuillères'}, {'ingredient_id': '9a84d91d-42d1-4321-b587-8aa0989011bc', 'quantite': '1'}, {'ingredient_id': '70444493-3ac7-4596-a63d-0e03d54866bd', 'quantite': ''}, {'ingredient_id': 'dc036e65-10bf-4274-b644-fd60c1787f66', 'quantite': ''}, {'ingredient_id': 'b1e29d5c-1592-474a-aa87-9ee003a0d90f', 'quantite': '1'}, {'ingredient_id': 'cbbf719c-cf7a-48eb-849d-a85a26499318', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (168993, 'Pain de viande rôti à ma façon', 'boeuf haché, persil, oignon, pain de mie, lait, poivre, sel', '15 min', ['Préchauffer le four à 200 °C', 'Emincer l''oignon en petits morceaux, le faire revenir dans du beurre ou de l''huile d''olive jusqu''à ce qu''il soit transparent/doré.', 'Ciseler le persil (au moins 1/2 botte.)', 'Malaxer la viande de boeuf avec le pain de mie trempé dans du lait, les oignons revenus, le persil ciselé finement.', 'Saler et poivrer généreusement (la mie de pain a tendance à affadir)', 'Façonner un pain de viande oblong de type "rôti", le mettre dans un plat à four beurré.', 'Enfourner avec une noisette de beurre pendant 40 min.', 'La cuisson n''est pas trop délicate car la mie de pain garde la viande très moëlleuse.'], ['Ouvre-boîte', 'Presse-agrumes'], ['', 'lait', 'entrée', 'cocktail', 'moyen', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'très facile', 'boeuf haché', 'Pain de viande rôti à ma façon', 'plat de résistance', 'recette', 'sel', 'persil', 'dessert', 'oignon', 'poivre', 'pain de mie', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:03:06.888742', [{'ingredient_id': '1549e99e-f153-4565-89d6-1b0e23faa42b', 'quantite': '500 g'}, {'ingredient_id': '79f20ad0-aef9-475e-b0c4-0abb318b37d6', 'quantite': '1'}, {'ingredient_id': 'c53bf724-7627-4d60-bdc0-1c8a075a7f45', 'quantite': '1'}, {'ingredient_id': '2be7df1a-30ff-4b3e-9d3e-0cde89b4dcbc', 'quantite': '4'}, {'ingredient_id': '27fc54c4-2f66-4ce5-a742-119ae60a3d0e', 'quantite': ''}, {'ingredient_id': 'ddef43a4-db13-4b57-8b79-c1f97f354d84', 'quantite': ''}, {'ingredient_id': 'c59e06d3-e405-4fb4-b8b2-45413a71d483', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38412, 'Feuilletés à la viande et aux pignons', 'pâte feuilletée, boeuf haché, pignons, oignon, jaune d''oeuf, poivre, sel, herbes de Provence, ail, crème fraîche', '20 min', ['Mettre le four à chauffer à 210°C (thermostat 7).', 'Dans une poêle, faire chauffer de l''huile d''olive, puis faire dorer les pignons de pin en remuant (attention, ça brunit rapidement !). ', 'Ajouter l''oignon émincé dans la poêle, puis la viande hachée. Assaisonner avec sel, herbes de provence...', 'Dans un bol, mélanger la crème fraiche + sel, poivre, ail, herbes de provence selon votre goût.', 'Sur les carrés de pâte feuilletée, étaler le mélange à base de crème fraîche, puis recouvrir avec la viande et les pignons.', 'Refermer les feuilletés par les coins.', 'Dorer avec le jaune d''oeuf.', 'Mettre au four pendant environ 15 minutes, les feuilletés doivent être dorés.'], ['Batteur électrique', 'Fouet', 'Spatule', 'Moule à tarte', 'Tire-bouchon'], ['jaune d''oeuf', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'pignons', 'pâte feuilletée', 'confiserie', 'testées', 'très facile', 'boeuf haché', 'herbes de Provence', 'bon marché', 'plat de résistance', 'recette', 'feuilleté', 'Feuilletés à la viande et aux pignons', 'sel', 'dessert', 'oignon', 'crème fraîche', 'ail', 'poivre', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:03:10.377481', [{'ingredient_id': '8de5ca3b-0561-47e4-9369-203d83a9a527', 'quantite': '4'}, {'ingredient_id': '6f73f3a1-b65d-46cb-81b3-d885b17d9f8d', 'quantite': '150 g'}, {'ingredient_id': '37a28ca4-ea33-4dbc-bd96-06deabd659f8', 'quantite': '50 g'}, {'ingredient_id': '56cb137d-2a81-4dbb-9871-8a76b6bb04e8', 'quantite': '1'}, {'ingredient_id': 'bb8c6203-b3af-4eea-8000-5f0d9ff51742', 'quantite': '1'}, {'ingredient_id': 'b54a4cfd-64ae-49bf-884b-d70d7c12716a', 'quantite': ''}, {'ingredient_id': '49ef2c05-c8f1-4823-b126-691c2dfc2e04', 'quantite': ''}, {'ingredient_id': 'b678dfcb-b619-4943-a182-5acfd6fc0624', 'quantite': ''}, {'ingredient_id': '38a7f1f7-348c-4c02-abb6-dbefed5266aa', 'quantite': ''}, {'ingredient_id': '696c6208-8de6-4f06-95a6-2bba50d852ab', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14679, 'Pomme de terre au four', 'pomme de terre', '10 min', ['Préchauffer le four à 180°C / Ther 6.', 'Eplucher les pommes de terre, ou laisser la peau si elle est fine.', 'Les couper dans le sens de la longueur et les placer sur une plaque au four, face bombée contre la plaque. Saler et laisser cuire à four chaud jusqu''à ce que le dessus soit bien doré.', 'Servir chaud accompagnées de salade verte et de toutes sortes de fromages (du kiri pour les enfants en allant jusqu''au maroilles...).', 'C''est délicieux, économique et sans graisse. Délicieux avec de la cancoillotte !'], ['Passoire', 'Verre doseur', 'Pince de cuisine', 'Couteau de chef'], ['recette', 'pomme de terre', 'très facile', 'Pomme de terre au four', 'entrée', 'cocktail', 'bon marché', 'pommes au four', 'recettes de cuisine', 'plat', 'plat de résistance', 'boisson', 'cuisine', 'dessert', 'confiserie', 'recettes', 'testées'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:03:16.955209', [{'ingredient_id': '6fb3ace6-aa24-40da-ba27-22a6a7aa074a', 'quantite': '500 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (64856, 'Boulettes de viandes et pommes de terre façon maman', 'boulettes de viande, pomme de terre, ail, toastinette, fond de veau, thym, poivre, sel', '15 min', ['Faire revenir dans un peu d''huile les deux gousses d''ail coupées en petits morceaux.', 'Y rajouter les boulettes de viande, les laisser dorer.', 'Couper les pommes de terres en petits cubes, et les rajouter à la viande.', 'Attendre qu''elles se colorent un peu.', 'Mettre le sel, le poivre et le thym.', 'Déposer les tranches de fromage, attendre qu''elles fondent un peu, en remuant de temps en temps de façon à ce que les pommes de terre n''adhèrent pas à la poêle.', 'Rajouter de l''eau mélangée à 2 ou 3 cuillères de fond de veau, de façon à ce que le liquide recouvre la préparation.', 'Laisser mijoter, et arrêter la cuisson lorsque le jus est bien réduit, mais en garder tout de même pour éviter que ce ne soit trop sec.'], ['Casserole', 'Râpe', 'Verre doseur', 'Moule à tarte'], ['', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'Boulettes de viandes et pommes de terre façon maman', 'cuisine', 'toastinette', 'confiserie', 'testées', 'pomme de terre', 'très facile', 'bon marché', 'plat de résistance', 'boulettes de viande', 'thym', 'recette', 'sel', 'dessert', 'fond de veau', 'ail', 'poivre', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:03:20.618770', [{'ingredient_id': 'be847fa3-72b1-436a-b3be-b723f426b117', 'quantite': '1'}, {'ingredient_id': '363ab620-60e6-4dac-93e5-e37caa427c3b', 'quantite': '10'}, {'ingredient_id': '9a226e05-9a19-4c35-9d41-fdedd885b1ad', 'quantite': '2'}, {'ingredient_id': '28914764-84db-49dc-83d5-16298c262e88', 'quantite': '4'}, {'ingredient_id': '4ebbc23f-8553-4cee-b58c-b4ec0cec37d3', 'quantite': ''}, {'ingredient_id': '43edb169-ae7e-4475-bb45-c1a1216985be', 'quantite': ''}, {'ingredient_id': '3b81f39e-3985-4305-a3ed-b0f798def657', 'quantite': ''}, {'ingredient_id': '35a31b08-557d-4de8-9da9-722d1137968e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66444, 'Pains de viande internationaux', 'viande hachée, pain de mie, bouillon, oeuf, feta, poivron rouge, ail, persil, origan, thym, poivre, sel, poivre, piment, tomate séchée, ail, olives, courgette, mozzarella, basilic, poivre, piment, carotte, citronnelle, cumin, coriandre, sauce soja, champignons de Paris, cèpes, ail, fromage râpé, poivre, sel, carvi, marjolaine, moutarde, olives noires, olives vertes, câpres, aubergine, tomate, herbes de Provence, ail, piment, poivre, sel', '30 min', ['Je mélange les ingrédients de base. Et ensuite je mixe ce qu''on peut mixer et mélange tous les ingrédients d''un pain, le pose dans un plat bien huilé à l''huile d''olive.', 'J''enfourne dans le four préchauffé à 200°C (thermostat 6-7) pour 30 minutes. Je rajoute un peu d''eau, si nécessaire et je continue la cuisson pour une autre demie-heure. ', 'Si j''ai des invités, je fais 3 ou 4 sortes de pain (parfois avec la moitié des ingrédients, c''est-à-dire la moitié des ingrédients de base puis la moitié des ingrédients par pain.)', 'Ça en jette !', 'Le grec et si différent de l''italien ou du provençal! Et c''est si facile à faire. Ça se congèle aussi très bien.', 'En accompagnement, je fais des patates sautées.'], ['Ouvre-boîte', 'Verre doseur'], ['', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'oeuf', 'très facile', 'viande hachée', 'bon marché', 'plat de résistance', 'recette', 'dessert', 'pain de mie', 'Pains de viande internationaux', 'bouillon', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:03:24.536710', [{'ingredient_id': '44edb439-19da-4915-b801-3f0b0bfb7487', 'quantite': '500 g'}, {'ingredient_id': '7ce289f9-fa0b-4003-8517-93c7f8c2ffd7', 'quantite': '4'}, {'ingredient_id': '973494db-5124-471a-b82d-d6dfec8fa197', 'quantite': '50 cl'}, {'ingredient_id': 'ee499cc8-82c6-43c5-9117-6848cf92676a', 'quantite': '1'}, {'ingredient_id': '69702840-ca7d-4010-89ff-4b7793a0c798', 'quantite': '250 g'}, {'ingredient_id': 'd295682a-a537-4100-85d5-e75ae56617f7', 'quantite': '2'}, {'ingredient_id': '2516858d-1fe5-40bf-b9e4-4ef9e212e78e', 'quantite': '3'}, {'ingredient_id': '35b86e67-ac01-43c4-9372-a01dd7116cd8', 'quantite': '1'}, {'ingredient_id': '30de5d7d-4fd0-4281-b298-80c45a445d50', 'quantite': ''}, {'ingredient_id': '52505128-cbd2-4f63-a1c3-24d07aed13f0', 'quantite': ''}, {'ingredient_id': 'f2aa805c-c236-4a25-8818-b8c708e295e4', 'quantite': ''}, {'ingredient_id': 'f7fef868-3c8f-4fd6-a07f-989c67346c84', 'quantite': ''}, {'ingredient_id': '7050ae4e-ee91-43fa-abe3-f0aeffb7ef8f', 'quantite': ''}, {'ingredient_id': 'e0d49b92-0af8-46fb-a1eb-2caea8fcc1e4', 'quantite': ''}, {'ingredient_id': '03a4639b-ee79-4cb4-8751-205428ebc32e', 'quantite': '100 g'}, {'ingredient_id': '60b2fdd6-bd2a-42f5-ac86-65b52053c122', 'quantite': '3'}, {'ingredient_id': 'f759b8ec-82ae-4218-b3f5-06454655a79c', 'quantite': '100 g'}, {'ingredient_id': '95a0927f-1362-4fed-9cf8-a889bf798934', 'quantite': '2'}, {'ingredient_id': '26224167-a0d5-4250-b744-9a55659cdc62', 'quantite': '1'}, {'ingredient_id': 'e4bcb6f9-da65-470b-8e5d-ff6608b023bc', 'quantite': '1'}, {'ingredient_id': '496b3440-8fef-4232-86b3-1be9f408b4c3', 'quantite': ''}, {'ingredient_id': 'bb7199d2-9693-4a12-9b00-4d85d780c4ee', 'quantite': ''}, {'ingredient_id': 'c56ef7d4-eab6-49a9-bbed-f73d9b95ed62', 'quantite': '200 g'}, {'ingredient_id': 'f5ee833a-df37-4eb9-831c-d58613257e5b', 'quantite': ''}, {'ingredient_id': 'b78f4fd0-c899-48da-8fb8-cd83067d7414', 'quantite': ''}, {'ingredient_id': 'e3c24d9d-b4c1-4765-8c6e-9005c61a9c9a', 'quantite': ''}, {'ingredient_id': 'be89eaaf-c4e5-46a0-9dab-851dd31065ee', 'quantite': '3 cuillères'}, {'ingredient_id': '7c24bf13-7077-41bf-afb2-aa5ac91c255f', 'quantite': '450 g'}, {'ingredient_id': '13e887cf-1b3c-4263-a91c-cf115808e968', 'quantite': '20 g'}, {'ingredient_id': '32328a58-0c92-48a0-8d2b-0319a8b65d8e', 'quantite': '2'}, {'ingredient_id': '5c232417-407b-46f6-9a16-d78bd676edd7', 'quantite': '75 g'}, {'ingredient_id': 'ca62d1d3-2d18-4d67-83b1-97a8dc3d9856', 'quantite': ''}, {'ingredient_id': 'be16154c-acee-4a74-b57e-313a5261ee02', 'quantite': ''}, {'ingredient_id': '7595d124-cdc1-4641-9b18-8605a0e67d77', 'quantite': ''}, {'ingredient_id': '083bc5f6-7df4-4dd1-a5ab-69daa9d113d2', 'quantite': ''}, {'ingredient_id': 'f63952d5-06b6-461d-8957-70d894cb77d5', 'quantite': ''}, {'ingredient_id': 'ffd5f506-b616-4703-9c06-5bbcb527570c', 'quantite': '50 g'}, {'ingredient_id': 'd54b5ca7-13fb-4301-af5d-4c4a951e9ba8', 'quantite': '50 g'}, {'ingredient_id': '34ac7fe3-ada0-4688-805f-c5e28f263389', 'quantite': '50 g'}, {'ingredient_id': '2c8b9898-8e1b-48a6-a07f-e57e3209f493', 'quantite': '1'}, {'ingredient_id': '1ffe5b8a-8e27-4931-9fa9-e6977498d935', 'quantite': '2'}, {'ingredient_id': '1135b9bd-db29-41b1-bc1e-7ab43e87de53', 'quantite': ''}, {'ingredient_id': 'ac5e9a47-608a-4400-9366-29287d391fa1', 'quantite': ''}, {'ingredient_id': 'ed0dc892-2690-455f-b8aa-f9c5c3358ac8', 'quantite': ''}, {'ingredient_id': '57ab7bb3-a34b-4fe3-b017-52bed7887290', 'quantite': ''}, {'ingredient_id': 'e803efcf-a866-4c3e-9a33-1a26a7b6641e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22983, 'Gratin de Courgettes à la viande', 'courgette, oignon, viande hachée, coulis de tomate, crème fraîche liquide, gruyère râpé, poivre, sel', '60 min', ['1) Couper la moitié de l''oignon en lamelles et les courgettes en rondelles. ', '2) Dans un filet d''huile d''olive faire revenir la moitié de l''oignon avec les courgettes. Saler, poivrer. Laisser cuire jusqu''à ce que les courgettes soient ramollies tout en les laissant un peu fermes. ', '3) Dans un filet d''huile d''olive, faire revenir l''autre moitié de l''oignon sans le griller, rajouter la viande hachée. Saler, poivrer à votre convenance. ', '4) Une fois que la viande hachée est cuite (qu''elle commence à se détacher) rajouter les briques de crème et de coulis de tomates. Saler et poivrer à nouveau. ', '5) Laisser mijoter jusqu''à ce que le tout épaississe un peu. ', '6) Retirer les courgettes du feu et les mettre dans un plat à four à l''aide d''une écumoire afin que l''eau que celle-ci à relâché ne soient pas dans le gratin. ', '7) Une fois la préparation épaissie, la verser sur les courgettes et parsemer de gruyère râpé. Mettre au four à thermostat 7 jusqu''à ce que ce soit gratiné.'], ['Fouet', 'Rouleau à pâtisserie', 'Couteau de chef', 'Mixeur', 'Économe'], ['gratin de légumes', 'courgette', 'entrée', 'cocktail', 'moyen', 'recettes de cuisine', 'plat', 'cuisine', 'crème fraîche liquide', 'confiserie', 'testées', 'gruyère râpé', 'viande hachée', 'facile', 'plat de résistance', 'recette', 'Gratin de Courgettes à la viande', 'sel', 'dessert', 'oignon', 'poivre', 'coulis de tomate', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:03:31.189398', [{'ingredient_id': '23659379-bc96-4916-bbad-5787e33724e3', 'quantite': '6'}, {'ingredient_id': '92fd5c45-5f26-4026-ae9a-d6a4ab6c2361', 'quantite': '1'}, {'ingredient_id': '9b0e304c-519b-4f5a-a5f1-2d99f6b484ae', 'quantite': '350 g'}, {'ingredient_id': '72bff3db-fa10-45f7-8da4-c2eac7088695', 'quantite': '50 cl'}, {'ingredient_id': '82c58ffc-07df-443a-b394-e81d64ba9af1', 'quantite': '40 cl'}, {'ingredient_id': 'dda2783f-83e4-47be-9750-5d1e65e10a5b', 'quantite': '1'}, {'ingredient_id': '206e0cb7-a09e-4590-a234-0ca1d63687eb', 'quantite': ''}, {'ingredient_id': '634ca691-b63e-4633-b10f-3729b32724de', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (224950, 'Bruschetta de viande hachée pesto et comté', 'baguette, steak, huile, pesto, oignon jaune, tomate, comté', '20 min', ['Tailler le pain en belles tranches, dans la longueur, un peu comme vous feriez pour une tartine au petit-déjeuner !', 'A vous de définir la taille selon votre appétit, mais étant donné la garniture, une quinzaine de centimètre de long semble suffir.', 'Verser un filer d''huile d''olive sur le pain et le toaster, au four ou au grille pain, c''est plus rapide et plus pratique.', 'Si vous n''en avez pas, laisser le pain tel quel, il suffira de le laisser un peu plus longtemps au four après.', 'Tailler la tomate en belle demi-tranche et assaisonner juste de sel et de poivre.', 'Émincer l''oignon et le réserver. ', 'Tailler de belles tranches de fromage avec un épluche-légumes pour obtenir des copeaux. ', 'Faire préchauffer le four à 180°C (thermostat 6).', 'Faire chauffer une poêle avec un peu de beurre.', 'Saisir les steaks jusqu''à la cuisson désirée. ', 'Sachant qu''il y aura pas vraiment de cuisson au four, amener donc les steaks à la cuisson désirée dans la poêle. ', 'A la mi-cuisson ajouter l''oignon émincé. Réduire le feu sous le bœuf : le but étant de faire suer les oignons lentement dans les sucs des steaks.', 'Monter la bruschetta en procédant comme ceci :', 'Badigeonner légèrement la tranche de pain de pesto, puis mettre les tomates et ensuite les steaks. ', 'Tailler les steaks en deux dans la longueur, ils tiendront plus facilement sur le pain. Puis les oignons et enfin le fromage.', 'Glisser les bruschetta dans un plat allant au four et enfourner pendant quelque minutes, pour faire fondre le fromage et harmoniser la bruschetta.', 'Sortir et déguster !', 'Vous pouvez servir avec une belle salade composée ou quelques frites maisons !'], ['Rouleau à pâtisserie', 'Râpe', 'Poêle', 'Casserole', 'Couteau de chef'], ['huile', 'Bruschetta de viande hachée pesto et comté', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'steak', 'bon marché', 'facile', 'plat de résistance', 'recette', 'rapide', 'pesto', 'oignon jaune', 'bruschetta', 'dessert', 'tomate', 'comté', 'boisson', 'baguette', 'recettes'], 'Plat principal', 004bb7c5-c471-4ebe-8a1e-3dc49ae125fe, '2025-09-26T15:03:34.892441', [{'ingredient_id': 'fa3f1874-409c-4ea4-8c9b-317f2e579487', 'quantite': '1'}, {'ingredient_id': '32fc8ab1-f01e-4140-ba6b-ec3c52b37cf6', 'quantite': '2'}, {'ingredient_id': '4caf56e3-da70-49b0-b929-2dcae3fe9b6e', 'quantite': '1 cuillères'}, {'ingredient_id': 'd6e49923-b08c-4ca7-8a44-ea80b4915e78', 'quantite': '1 cuillères'}, {'ingredient_id': '6ec7e33b-b63e-4f0c-9330-7778e84246c0', 'quantite': '1'}, {'ingredient_id': '2ffc281c-05e9-4fee-9130-dd04eff04a07', 'quantite': '1'}, {'ingredient_id': '793ca074-4479-4260-a922-4cd0fc64bdfb', 'quantite': '140 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15696, 'Mi Xao aux  viandes et légumes variés (Vietnam)', 'nouilles aux oeufs, viande, légumes, crevettes, huile de sésame, huître, fécule de pomme de terre, oignon, ail', '25 min', ['Cuire les nouilles dans de l''eau bouillante et laisser égoutter environs 1/2 journée, ou bien frire les nouilles fraîches.', 'Dans un faitout, cuire dans un peu d''huile l''oignon et l''ail hachés, les crevettes et la viande. Réserver.', 'Dans le même faitout, cuire les légumes. Ajouter un peu d''huile de sésame et de la sauce d''huitres (ou du bouillon), de l''eau. Réserver les légumes sans leur sauce.', 'Mettre les viandes/crevettes dans la sauce des légumes, ajouter éventuellement de l''eau. Ecumer et ajouter de la fécule de pomme de terre mélangée à de l''eau.', 'Réserver le tout.', 'Faire sauter les nouilles égouttées en ajoutant éventuellement de l''ail mélangé à de l''huile chaude. Ajouter un peu de sauce de viande.', 'Servir immédiatement dans chaque assiette les nouilles accompagnées des légumes, de la viande/crevettes et de leur sauce.'], ['Rouleau à pâtisserie', 'Passoire', 'Pince de cuisine', 'Louche'], ['entrée', 'cocktail', 'moyen', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'huile de sésame', 'viande', 'plats vietnamiens', 'facile', 'plat de résistance', 'recette', 'crevettes', 'nouilles aux oeufs', 'dessert', 'oignon', 'huître', 'ail', 'fécule de pomme de terre', 'légumes', 'boisson', 'Mi Xao aux  viandes et légumes variés (Vietnam)', 'recettes'], 'Plat principal', b678422e-d425-499c-ab34-d5fc76836565, '2025-09-26T15:03:38.627923', [{'ingredient_id': 'bd9071ef-c91e-4d88-b83f-9c7ecf4bbdf0', 'quantite': ''}, {'ingredient_id': '2b70c097-5cc3-44e9-8e15-9b52c0415f43', 'quantite': ''}, {'ingredient_id': '7fcc4903-d94f-4942-95d7-85e45703c246', 'quantite': ''}, {'ingredient_id': 'ac39057d-7e8a-4c54-8b03-9a35122572be', 'quantite': ''}, {'ingredient_id': 'a121135d-dbcf-4d02-9cb4-20ce231e625b', 'quantite': ''}, {'ingredient_id': 'd97b4c82-b62b-4c6b-b237-951efd441672', 'quantite': ''}, {'ingredient_id': '099f30b7-5ab0-4fd3-bbe5-fd79c5039a3e', 'quantite': '1 cuillères'}, {'ingredient_id': 'b2a10995-218e-4a28-a371-1e7abf66f3db', 'quantite': '1'}, {'ingredient_id': '0b72d8fd-fd12-49a4-aa12-76995958cb2c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (533953, 'Kebab capucin à l''effiloché d''agneau', 'farine de sarrasin, eau, oeuf, beurre, gigot d''agneau, couenne, oignon, carotte, tomate, fond de veau, huile d''olive, vin blanc, cognac, menthe, sucrine, jus de cuisson, carotte, miel, cumin, beurre, oignon, agar-agar, beurre, yaourt à la grecque, huile de pépin de raisin, piment d''Espelette, sel et poivre, poivre blanc, gros sel', '30 min', ['Dans un saladier, former un puits avec la 
farine de sarrasin, mettre le sel, l''oeuf et mélanger doucement au fouet en 
incorporant l''eau au fur et à mesure.', 'Laisser la pâte reposer 30 minutes.', 'Faire cuire à la poêle avec un peu de beurre fondu.', 'Une fois les galettes cuitent, les rouler 
façon capucin et les faire sécher au four. . Réserver.', 'Rissoler à l''huile d''olive le gigot, le déposer 
dans une cocotte sur un lit de couenne. - Ajouter les oignons, carottes en mirepoix et 
les tomates épépinées concassées', 'Mouiller au vin blanc et cognac et laisser 
cuire jusqu''à évaporation de l''alcool, ajouter le fond de veau à hauteur, ajouter le bouquet garni et poursuivre la cuisson au four à couvert pendant environ 7h à 
130°C.', 'En fin de cuisson, décanter le gigot, passer 
la sauce au chinois en foulant fortement.', 'Faire réduire la sauce si nécessaire et 
infuser les bottes de menthe, laisser infuser quelques minutes.', 'Détacher les chairs du gigot et caraméliser 
avec un peu de sauce sous la salamandre. Réserver.', 'Blanchir les sucrines entières. . Les refroidir et les presser.', 'Les disposer dans un plat et couvrir avec le 
reste de cuisson de l''agneau. Réserver après cuisson.', 'Tailler les carottes en sifflet et les glacer à blanc en remplaçant le sucre par le miel', 'Emincer les oignons et les mettre à 
compoter avec le beurre jusqu''à coloration et cuisson, mixer et ajouter de l''eau si nécessaire, coller à l''agar agar (4g au litre), mouler et laisser prendre au froid, détailler en cube. Réserver', 'Emulsionner le yaourt et l''huile de pépin de raisin, ajouter le piment d''Espelette.', 'Dresser l''assiette.'], ['Couteau de chef', 'Râpe'], ['farine de sarrasin', 'entrée', 'cocktail', 'moyen', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'oeuf', 'viande', 'plat de résistance', 'facile', 'recette', 'beurre', 'dessert', 'eau', 'boisson', 'Kebab capucin à l''effiloché d''agneau', 'recettes'], 'Plat principal', 3ac1b53f-fa84-4c89-b1e0-2a5c9d2a5830, '2025-09-26T15:03:43.217655', [{'ingredient_id': '08288b7a-e7a2-451a-bdf2-466521c4b0f9', 'quantite': '330 g'}, {'ingredient_id': '363a25fb-c665-44f0-b5f5-ce7dec6a404b', 'quantite': '75 cl'}, {'ingredient_id': '598333da-ef25-4b1d-82f3-dc370ad595ff', 'quantite': '1'}, {'ingredient_id': '3695edb4-fd9f-420a-b032-218b3ff5f0f2', 'quantite': '75 g'}, {'ingredient_id': 'c99026c1-90eb-4c5d-b3e3-c4c2e6c25faf', 'quantite': '2.5 kg'}, {'ingredient_id': '63d6c82e-80ea-4f15-ae45-22a2d1e4f6b4', 'quantite': '250 g'}, {'ingredient_id': '477e237d-9746-48d4-a92d-a6b6acb41024', 'quantite': '300 g'}, {'ingredient_id': 'e6b0612c-c70f-4d65-b261-862c58e34149', 'quantite': '200 g'}, {'ingredient_id': '61fee241-2721-4dfd-b8e5-3fb89678b82e', 'quantite': '500 g'}, {'ingredient_id': '5851dccc-7db5-4aa3-a4e0-ee48f1321b3a', 'quantite': '3 l'}, {'ingredient_id': '56102571-ef37-48b7-b20d-1c5073b69260', 'quantite': '100 cl'}, {'ingredient_id': '213ab1b6-be62-4c87-b726-a4d36a0ee974', 'quantite': '500 cl'}, {'ingredient_id': '8311d607-6589-44a9-9505-11d7a21bf673', 'quantite': '100 cl'}, {'ingredient_id': 'cd03bab0-8e6f-4977-a8cb-3ff8e7b91f23', 'quantite': '2'}, {'ingredient_id': '932319e2-5879-40a4-b974-6a3f6bc21c37', 'quantite': '10'}, {'ingredient_id': 'db5ef0a8-fe7e-47ef-8ae0-7f8eb2e17212', 'quantite': ''}, {'ingredient_id': 'cf250d10-82ba-4527-bcfd-6b9553469444', 'quantite': '500 g'}, {'ingredient_id': 'bbc61679-bcb8-4b20-86a9-3f55db241a9a', 'quantite': '100 g'}, {'ingredient_id': '3c0ef0a9-af92-48f2-9892-a7cc64aa3d8b', 'quantite': ''}, {'ingredient_id': '7a179424-5089-4746-b4a5-0524cafc7f10', 'quantite': '50 g'}, {'ingredient_id': '6ccaf76d-05bc-4542-8c60-8646ed47f5af', 'quantite': '500 g'}, {'ingredient_id': '909e4833-77f3-4d7b-a055-60cbff8f086f', 'quantite': ''}, {'ingredient_id': 'c6b5d99c-ccb5-4690-a8b6-40ca24f3fda0', 'quantite': '100 g'}, {'ingredient_id': 'ef231a4b-6e90-4e73-b86e-fdc389814af0', 'quantite': '500 g'}, {'ingredient_id': '1a2384bc-b8e6-4971-8efa-574d01fe922e', 'quantite': '250 cl'}, {'ingredient_id': 'ccb4b15e-a489-4f21-8ef5-f9e61cf675f3', 'quantite': ''}, {'ingredient_id': 'ad58334b-3a5d-4187-955e-cd4f50446165', 'quantite': ''}, {'ingredient_id': '410d64fe-2a28-4fbe-895e-f53904dbcb75', 'quantite': ''}, {'ingredient_id': '86f2107e-47a4-4844-8d82-1cf8e95c61bf', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73880, 'raviolis maison viande/chèvre', 'farine, oeuf, sel, huile d''olive, jambon, fromage de chèvre, basilic', '20 min', ['Battez les oeufs avec l''huile. ', 'Versez les oeufs battus au centre de la farine et pétrissez, jusqu''à ce que la pâte soit homogène. ', 'Continuez de pétrir pour développer l''élasticité de la pâte. ', 'Couvrez et laissez reposer la pâte entre 30 min et 1 h. ', 'Pendant ce temps, préparez la farce à raviolis: mixez la tranche de jambon et incorporez-la au fromage de chèvre frais. Assaisonnez de sel (peu), poivre et basilic. ', 'Etendez au rouleau à pâtisserie la pâte le plus finement possible.', 'Couvrez-la et laissez-la reposer 1 h au moins. ', 'A l''aide d''un couteau, commencez à tracer les carrés sur la moitié de la pâte, pour faciliter la découpe des raviolis. ', 'Garnissez de la farce. ', 'Passez du jaune d''oeuf sur les parties qui seront à souder (bord des raviolis).', 'Rabattez la seconde partie de pâte, et à l''aide de vos mains, soudez bien hermétiquement les raviolis autour de la farce. ', 'Découpez les raviolis à l''aide d''une molette dentelée ou à défaut d''un couteau aiguisé.', 'Faites chauffer un grand volume d''eau salée, plongez les raviolis dedans et laissez cuire 8 à 10 min environ. ', 'Egouttez les raviolis et servez-les accompagnés de sauce de votre choix. ', 'Exemples:', '- tomate/champignons', '- sauce bolognaise', '- sauce carbonnara', '- parmesan/basilic/poivrons', 'Variantes:', 'Pour la farce vous pouvez mettre du parmesan ou de la chair à saucisse (accompagné de sauce tomate, excellent!).', 'A servir chaud.', 'Bon appétit !'], ['Balance de cuisine', 'Mixeur'], ['huile d''olive', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'farine', 'cuisine', 'confiserie', 'testées', 'oeuf', 'raviolis', 'bon marché', 'plat de résistance', 'recette', 'rapide', 'sel', 'dessert', 'moyenne', 'boisson', 'raviolis maison viande/chèvre', 'recettes'], 'Plat principal', 4cd47a58-1296-4507-9ee3-d651e99c41e8, '2025-09-26T15:03:46.729334', [{'ingredient_id': 'e723826f-ea4d-4603-b873-f62f6a055a3e', 'quantite': '300 g'}, {'ingredient_id': 'c320dc4f-1ed3-4831-a4b9-8bb85ab97f8e', 'quantite': '3'}, {'ingredient_id': 'bdf6a813-c1b6-454c-bc12-8488a3cc0b1f', 'quantite': ''}, {'ingredient_id': '4294b2d6-1d42-4fe4-9a4c-8736644af401', 'quantite': '2 cuillères'}, {'ingredient_id': 'e7b2512b-e1ac-4a1c-9b30-b0b5a8de1c7d', 'quantite': '1'}, {'ingredient_id': '80febb9a-6d93-48f4-a058-cdef504c7180', 'quantite': '100 g'}, {'ingredient_id': 'b3bbd72f-255e-4493-bed1-6a2266e82c89', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58316, 'gratin de viande hachée', 'viande hachée, aubergine, courgette, tomate, oignon, ail, thym, Parmesan, huile d''olive, poivre, sel', '15 min', ['Préchauffez votre four à thermostat 7 (210°C).', 'Faites revenir à feu doux la viande hachée et l''oignon taillé en dés avec une cuillère à soupe d''huile d''olive, du romarin et du thym.', 'Pressez l''ail, mélangez-le à la viande hachée puis, incorporez les aubergines, la moitié des courgettes et des tomates.', 'Etalez ce mélange dans un plat à gratin et recouvrez avec la courgette et la tomate restante detaillées en tranches.', 'Terminez en parsemant de copeaux de parmesan.', 'Mettez au four et laissez cuire 20 mn.'], ['Louche', 'Pince de cuisine', 'Ouvre-boîte'], ['', 'courgette', 'huile d''olive', 'aubergine', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'gratin de viande hachée', 'testées', 'viande hachée', 'bon marché', 'facile', 'plat de résistance', 'thym', 'recette', 'Parmesan', 'sel', 'dessert', 'oignon', 'tomate', 'ail', 'poivre', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:03:50.331019', [{'ingredient_id': '0e3978fd-5503-4c0e-83ec-16aec4d1984e', 'quantite': '400 g'}, {'ingredient_id': '2719eb9a-2675-4d42-a2b7-79f5b407f193', 'quantite': '2'}, {'ingredient_id': '001e7675-a58c-4c24-be4b-9eaa4bfedda4', 'quantite': '3'}, {'ingredient_id': '64764e2d-76bf-404f-ab04-af0286763ddf', 'quantite': '3'}, {'ingredient_id': '21ea4692-7203-43a7-8f7f-e7bf503ade75', 'quantite': '1'}, {'ingredient_id': 'f6cd499f-0d47-4cfa-b886-4f518c1a780b', 'quantite': '1'}, {'ingredient_id': '9e3b1189-983e-42ac-8f94-c8f9dfdb95c0', 'quantite': ''}, {'ingredient_id': 'a02cfcf4-4033-440f-aebb-868360387eb4', 'quantite': '150 g'}, {'ingredient_id': 'cbab7bf7-484a-44c3-8745-b011302531ed', 'quantite': '1 cuillères'}, {'ingredient_id': '104b755f-3a53-460d-8edc-cbab8b6a0e96', 'quantite': ''}, {'ingredient_id': '673a0b81-9e8b-4603-bad7-e648e97c8241', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (170864, 'Boulettes à la viande façon maison', 'viande hachée, pain, oeuf, persil, ail, Parmesan', '15 min', ['Mettre le pain dur dans un saladier et l''humecter d''eau afin qu''il ramollisse et bien le presser.', 'Ajouter à cette préparation, l’œuf, le persil et l''ail hachés, le parmesan puis sel, poivre.', 'Faire ensuite une pâte, former des boulettes et les faire revenir dans une poêle.', 'Les boulettes peuvent être dégustées comme ça à l''apéritif ou bien accompagnées de spaghettis à la sauce tomate.', 'Bon appétit !'], ['Planche à découper', 'Moule à tarte', 'Presse-agrumes'], ['entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'oeuf', 'très facile', 'viande hachée', 'bon marché', 'Boulettes à la viande façon maison', 'plat de résistance', 'boulettes de viande', 'recette', 'Parmesan', 'rapide', 'persil', 'dessert', 'pain', 'ail', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:03:53.759639', [{'ingredient_id': '2e360c81-e59f-4c3a-a12d-940469d4bb29', 'quantite': '500 g'}, {'ingredient_id': '37be9c33-7d7b-4101-9675-d8035dba9ad3', 'quantite': '30 g'}, {'ingredient_id': '63b4f671-c924-4c8f-b973-791c7d25aef5', 'quantite': '1'}, {'ingredient_id': '7e233dfc-fcba-492d-aab0-44a0ac822774', 'quantite': '1'}, {'ingredient_id': '1075be31-8564-4613-a806-521dad004e36', 'quantite': '1'}, {'ingredient_id': '59a4a066-a05f-4a06-9382-6dc1bbb44df0', 'quantite': '30 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (53703, 'Ragoût corse aux deux viandes', 'échine de porc, boeuf, jambon fumé, oignon, ail, vin rouge, concentré de tomates, laurier, sauge, thym, huile d''olive, persil, poivre, sel', '20 min', ['Coupez la viande en cubes et le jambon en dés. ', 'Emincez les oignons, écrasez l''ail et mélangez avec le persil. ', 'Dans une cocotte, faites chauffer de l''huile pour y faire dorer la viande et l''oignon. ', 'Rajoutez le jambon, 1 cuillère de concentré de tomate, le vin rouge, le laurier, le thym et la sauge; salez et poivrer. ', 'Laissez mijoter pendant 45 min à couvert. Rajoutez de l''eau chaude pour couvrir la viande, et continuez la cuisson 45 min.', 'En accompagnement : des pâtes servies dans un saladier avec du parmesan râpé et quelques cuillères de bouillon de cuisson.'], ['Moule à tarte', 'Planche à découper', 'Poêle', 'Fouet'], ['', 'huile d''olive', 'vin rouge', 'entrée', 'cocktail', 'moyen', 'boeuf', 'jambon fumé', 'Ragoût corse aux deux viandes', 'recettes de cuisine', 'cuisine', 'plat', 'confiserie', 'testées', 'sauge', 'laurier', 'facile', 'plat de résistance', 'concentré de tomates', 'thym', 'recette', 'échine de porc', 'sel', 'persil', 'dessert', 'oignon', 'ail', 'poivre', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:03:57.571200', [{'ingredient_id': '909638b4-a5e9-43c7-a319-2656ae3eedef', 'quantite': '400 g'}, {'ingredient_id': '620a88a5-de50-443a-8bb4-853a5015ff79', 'quantite': '400 g'}, {'ingredient_id': '26cafec2-44ff-4e0f-85a0-bf3a9914f5b9', 'quantite': '200 g'}, {'ingredient_id': '0a9255b3-0863-40b6-a177-cf94aac0880d', 'quantite': '4'}, {'ingredient_id': '0e637819-0638-474f-86a3-7fd562b0c366', 'quantite': '4'}, {'ingredient_id': 'd949b265-09ee-406c-9e05-d4e88e3fcf9f', 'quantite': '2'}, {'ingredient_id': 'ace3e5a7-3395-4652-9cf3-de37713691be', 'quantite': '1 cuillères'}, {'ingredient_id': '4e2146d7-7295-407b-834e-9ac9d6084a05', 'quantite': ''}, {'ingredient_id': '753eb68f-70ac-4fdb-86df-2d226cd26ccb', 'quantite': ''}, {'ingredient_id': 'fe3b1150-4331-45e6-853d-d0afdeb04151', 'quantite': ''}, {'ingredient_id': '11d7db13-4f80-4496-b5ce-dbf234577cc6', 'quantite': ''}, {'ingredient_id': 'c2e89297-08b9-4304-9814-3dd6fb93ec19', 'quantite': ''}, {'ingredient_id': '9a02e040-944e-4aa4-9b65-aa85c87ebac6', 'quantite': ''}, {'ingredient_id': 'caa114c7-bf70-4dc5-a760-31374dcbddbd', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (305302, 'Quiche aux oignons et à la viande hâchée', 'pâte feuilletée, oeuf, crème liquide, oignon, viande hachée, curry, miel, huile d''arachide, sel, poivre', '45 min', ['Préchauffez votre four à 210°C (thermostat 6-7).', 'Épluchez et coupez les oignons. Dans une sauteuse, faites fondre les oignons avec l''huile d''arachide. Assaisonnez. Ajoutez ensuite le curry.', 'Dans une poêle à part, faites cuire la viande hachée.', 'Une fois ceci fait, mettez la viande dans les oignons. Ajoutez ensuite le miel.', 'Mettez la pâte feuilletée dans un plat à tarte puis faites-la cuire à blanc au four pendant 5 minutes.', 'Mélangez la crème et les œufs puis sortez la tarte du four. Versez les oignons et la viande hachée au fond du plat ainsi que les œufs et la crème.', 'Enfournez pendant 20 minutes au four.', 'C''est près !'], ['Économe', 'Rouleau à pâtisserie', 'Spatule', 'Passoire'], ['', 'miel', 'entrée', 'cocktail', 'huile d''arachide', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'pâte feuilletée', 'testées', 'oeuf', 'viande hachée', 'Quiche aux oignons et à la viande hâchée', 'bon marché', 'facile', 'plat de résistance', 'recette', 'sel', 'dessert', 'oignon', 'crème liquide', 'curry', 'poivre', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:04:01.227937', [{'ingredient_id': '92b55524-a3d2-4b6d-8ed5-e179c7995d0f', 'quantite': '1'}, {'ingredient_id': 'f096049d-2142-4ce3-a274-da9a59aae5b2', 'quantite': '4'}, {'ingredient_id': '424bc83a-ab86-4ffb-8f37-9cd2a5f6d4a5', 'quantite': '20 cl'}, {'ingredient_id': '7f45d08d-6a57-4f08-a7df-ce6fe594e067', 'quantite': '6'}, {'ingredient_id': 'da1d22f5-faa5-4749-b01b-084368271599', 'quantite': '300 g'}, {'ingredient_id': '2dd13e66-b972-46f3-bde5-3fa85a8a01b7', 'quantite': '2 cuillères'}, {'ingredient_id': '7f4f56c7-f4ff-4ed3-8c1b-1ba479d36213', 'quantite': '2 cuillères'}, {'ingredient_id': '132661bc-d9db-4153-a88d-a4e0bee813ca', 'quantite': '1 cuillères'}, {'ingredient_id': 'bdb8979c-38fd-4ef6-9b22-751a9a6b6cc8', 'quantite': ''}, {'ingredient_id': '4c947463-dde5-4824-a551-6aabd0a45c71', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61389, 'Tarte à la viande et  aux légumes du soleil de Bibi', 'pâte feuilletée, aubergine, courgette, poivron vert, poivron jaune, poivron rouge, oignon, tomates pelées, boeuf, ail, feuille de laurier, thym, poivre, sel, huile d''olive, beurre, farine', '30 min', ['Faire chauffer le four à 210°C.', 'Etaler la pâte feuilletée sur un moule à tourte, préalablement beurré et fariné. Effectuer quelques trous dans la pâte.', 'La faire cuire 8 min à blanc et la laisser reposer.', 'Laver les légumes, et émincer l''oignon, l''aubergine, la courgette, et les poivrons en petits carrés.', 'Couper l''ail en rondelles (en otant le germe).', 'Faire revenir la viande hachée dans l''huile d''olive, lorsqu''elle est dorée, ajouter l''ail.', 'Ajouter les poivrons, lorsqu''ils sont dorés, incorporer l''oignon, puis l''aubergine et la courgette.', 'Remuer et faire cuire à feu doux pendant 10 minutes. Ajouter la boite de tomate pelée, la feuille de laurier, le thym.', 'Saler et Poivrer. Laisser Cuire 10 minutes.', 'Laisser refroidir la préparation, et la verser dans le moule.', 'S''il vous reste de la pâte feuilletée, vous pouvez décorer le plat en mettant des lamelles sur le dessus.', 'Mettre le moule au four et laisser cuire 40 min.', 'Servir tiède, avec une salade verte et un bon verre de vin rouge !', 'Bon appétit !'], ['Presse-agrumes', 'Pince de cuisine', 'Louche'], ['', 'courgette', 'huile d''olive', 'aubergine', 'entrée', 'cocktail', 'poivron vert', 'recettes de cuisine', 'boeuf', 'plat', 'farine', 'cuisine', 'confiserie', 'pâte feuilletée', 'testées', 'très facile', 'bon marché', 'plat de résistance', 'thym', 'recette', 'sel', 'beurre', 'feuille de laurier', 'dessert', 'oignon', 'tomates pelées', 'Tarte à la viande et  aux légumes du soleil de Bibi', 'ail', 'poivron rouge', 'poivre', 'boisson', 'poivron jaune', 'recettes'], 'Plat principal', 3f709791-3c4e-4c6a-be03-0def367edcdc, '2025-09-26T15:04:05.146609', [{'ingredient_id': '4700b55c-2edb-4a25-8958-ce14dbc22a93', 'quantite': '1'}, {'ingredient_id': 'd37c0b6f-06e1-4600-b8b5-71813cf2481f', 'quantite': ''}, {'ingredient_id': '9f16b204-6d47-4599-84cd-205a0599067f', 'quantite': '1'}, {'ingredient_id': '423e00cf-6533-4f50-aa90-bd150a44bef7', 'quantite': ''}, {'ingredient_id': '2961a0b7-f3de-48c1-b366-a1e0d62d8ea5', 'quantite': ''}, {'ingredient_id': '02564964-f988-49d5-9f5f-310f0195627e', 'quantite': ''}, {'ingredient_id': 'f2cff33b-1970-4106-97c0-312ac117fa86', 'quantite': '1'}, {'ingredient_id': 'b0f7dbe2-c1ee-47d9-b0a7-e2934fd64597', 'quantite': '1'}, {'ingredient_id': 'b37c6ee5-941f-4a60-b9de-94465b705542', 'quantite': '200 g'}, {'ingredient_id': '0b2b3ae4-4793-4430-9cde-cc9c766aeeb9', 'quantite': '1'}, {'ingredient_id': '71a0006c-9fa0-47eb-82a9-db9e6d1fcb5f', 'quantite': '1'}, {'ingredient_id': 'f080b2bb-927a-493b-8dc8-95d16cffd54f', 'quantite': ''}, {'ingredient_id': '1517269c-5a64-4593-a332-6f175bf1b4da', 'quantite': ''}, {'ingredient_id': '287b5a03-d5b2-4f5a-ad90-f292c87be869', 'quantite': ''}, {'ingredient_id': '97e979db-7a82-4309-90c3-afe3f6ee5900', 'quantite': '1 cuillères'}, {'ingredient_id': 'e97a097f-4413-48c8-abe1-3deda64fe0d2', 'quantite': '15 g'}, {'ingredient_id': '5af9d5f1-a980-4c40-b789-73f40b5cff14', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65516, 'Lasagnes de chou vert à la viande', 'chou, viande hachée, chair à saucisse, oignon, carotte, ail, persil, beurre, farine, lait, fromage râpé, poivre, sel, muscade', '20 min', ['Séparer les feuilles de chou, éliminer le trognon et faites cuire à découvert (10 min). Rincer les feuilles à l''eau froide et laisser égoutter (peut se faire la veille au soir).', 'Peler et hacher les oignons, les gousses d ail. Peler les carottes et râper à la râpe à gros grains.', 'Faire chauffer un 10-20 g de beurre dans une sauteuse, ajouter la viande et les légumes, laisser blondir. Saler et poivrer, laisser cuire une dizaine de minutes.', 'Préparer une béchamel pas trop épaisse : faire fondre 50 g de beurre, ajouter la farine et remuer. Quand le mélange prend couleur et forme des boulettes, ajouter peu à peu le lait en fouettant énergiquement pour éviter les grumeaux. Verser le reste de lait au fur et à mesure et laisser un peu épaissir à feu doux. Saler, poivrer et ajouter un peu de muscade.', 'Dans un plat à gratin mettre : un peu de béchamel, une couche de feuilles de chou, une couche de farce, une couche de béchamel...', 'Répéter ainsi jusqu''à épuisement des ingrédients.', 'Finir par une couche de feuille de chou, de la béchamel et le fromage râpé.', 'Faire cuire 30 à 40 min au four à 220°C (thermostat 7-8)'], ['Couteau de chef', 'Spatule', 'Moule à tarte', 'Ouvre-boîte', 'Passoire'], ['lait', 'muscade', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'farine', 'cuisine', 'confiserie', 'testées', 'chair à saucisse', 'viande hachée', 'bon marché', 'chou', 'facile', 'plat de résistance', 'fromage râpé', 'recette', 'carotte', 'sel', 'beurre', 'persil', 'lasagne', 'dessert', 'oignon', 'Lasagnes de chou vert à la viande', 'ail', 'poivre', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:04:10.050028', [{'ingredient_id': '20421178-135a-4a8b-8aef-2990f7f3e896', 'quantite': '1'}, {'ingredient_id': '2fd0dffd-f01c-4a46-9550-f3c918d9c94f', 'quantite': '400 g'}, {'ingredient_id': 'b85f9e35-c83d-46f2-983a-4283ad0eefca', 'quantite': '200 g'}, {'ingredient_id': '973590ea-cffe-4682-a7e4-97bdaa23a7d7', 'quantite': '2'}, {'ingredient_id': 'fcc6ce6b-1979-4b16-9ace-48d8521836ec', 'quantite': '2'}, {'ingredient_id': '80833da5-4819-4a53-8bc9-2b4babb993b0', 'quantite': '2'}, {'ingredient_id': '154e7b2d-8e16-4cb9-b45e-4b053086c585', 'quantite': '1'}, {'ingredient_id': '8e5ac597-a338-4cbc-8d1f-8cbf42f1b41e', 'quantite': '70 g'}, {'ingredient_id': '34478c1f-942a-448c-bc84-ef2974c9aa24', 'quantite': '50 g'}, {'ingredient_id': '72a852ad-8d30-4984-9f50-a37694e58c40', 'quantite': '1 l'}, {'ingredient_id': '4b4fe310-5b3f-4644-bcd1-f5f84bbd10ca', 'quantite': '100 g'}, {'ingredient_id': '205e47f2-7504-466e-bf0e-043d2943fe33', 'quantite': ''}, {'ingredient_id': '4a117c66-2570-4d06-a051-92a056f31c22', 'quantite': ''}, {'ingredient_id': 'c8687a7c-6a96-49a3-b0e3-ca44505fbdd6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (172793, 'Pain de viande au micro-ondes', 'viande hachée, oignon, biscotte, oeuf, ciboulette, poivre, sel', '15 min', ['Ajouter l''oignon, la biscotte et l''oeuf à la viande haché. Bien mélanger avec une fourchette.', 'Ajouter la ciboulette ciselée. Assaisonner selon vos goûts. Mélanger à nouveau.', 'Disposer le mélange dans un plat avec couvercle pour le micro-ondes (pour ma part, j''utilise un Tupp... MicroPlus Rond 1l).', 'Bien "aplatir" le mélange avec une fourchette.', 'Parsemer de paprika (c''est ce qui donnera la couleur brune de la croûte du pain de viande).', 'Cuire 6 minutes à 765 W.', 'Laisser reposer 6 minutes.', 'Avec un couteau pointu, faire plusieurs petites entailles dans le pain pour laisser s''écouler le jus.', 'Cuire une deuxième fois 6 min à 765 W.', 'Laisser reposer 6 minutes.', 'Servir.'], ['Verre doseur', 'Ouvre-boîte', 'Spatule'], ['', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'oeuf', 'très facile', 'viande hachée', 'bon marché', 'plat de résistance', 'recette', 'Pain de viande au micro-ondes', 'rapide', 'sel', 'biscotte', 'dessert', 'oignon', 'poivre', 'boisson', 'ciboulette', 'recettes'], 'Plat principal', b5cf34b7-152d-4498-8fcf-183f105b8ed4, '2025-09-26T15:04:13.849624', [{'ingredient_id': 'cc3dd42b-64b1-408e-900c-70205a49602e', 'quantite': '300 g'}, {'ingredient_id': '8fe075f2-a4b1-48a5-bd35-6c485b5c7503', 'quantite': '1'}, {'ingredient_id': '509d2aaf-173b-4f78-bbc0-f75119f66f92', 'quantite': '1'}, {'ingredient_id': 'e0f0dddc-41ce-4b70-9f76-6b2f1d4d8bc1', 'quantite': '1'}, {'ingredient_id': 'be11cc9f-a81c-4d60-b94e-99c5af714a3f', 'quantite': '15'}, {'ingredient_id': '4c9fea09-77d8-44a1-96fa-4178d6c58f97', 'quantite': ''}, {'ingredient_id': 'd9c3f12c-4318-49d0-9546-6e472a20bb12', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (49923, 'Salade du Mexique', 'tomate, salade, haricots rouges, carotte, maïs, avocat, poivron rouge, viande hachée, mimolette, olives noires, tacos, yaourt brassé, vinaigre, ketchup, tabasco, poivre, sel', '30 min', ['Couper les tomates, les poivrons et la chair d''avocat en dés, râper les carottes, égoutter les haricots et le maïs.', 'Bien faire cuire la viande, hachée en "miettes", et émietter aussi quelques tacos.', 'Préparer la sauce en mélangeant bien le yaourt au ketchup, Tabasco et vinaigre.', 'Mélanger tous les ingrédients en vrac dans un saladier.', 'ou', 'Présenter la salade "au verre", en superposant dans l''ordre tous les ingrédients de la liste (pour les couleurs), avec un peu de sauce entre 3 couches.', 'Servir avec le reste des tacos non émiettés.'], ['Couteau de chef', 'Balance de cuisine'], ['avocat', 'Salade du Mexique', 'salade', 'entrée', 'cocktail', 'mimolette', 'tacos', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'très facile', 'maïs', 'viande hachée', 'bon marché', 'plat de résistance', 'recette', 'carotte', 'rapide', 'dessert', 'tomate', 'salade avocat', 'haricots rouges', 'poivron rouge', 'boisson', 'olives noires', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:04:17.661889', [{'ingredient_id': '6265f3c9-95af-4c8e-a648-37d2ba74c666', 'quantite': '4'}, {'ingredient_id': '1699af31-5994-4585-b274-4fc194dfa971', 'quantite': '4'}, {'ingredient_id': 'e375084c-50a6-435b-9faf-70648c83b8f8', 'quantite': '1'}, {'ingredient_id': 'fa42c702-712f-41ce-91b0-f571c2c5b927', 'quantite': '4'}, {'ingredient_id': '093a07b6-0ef5-4a0c-a6cd-b70e596f8373', 'quantite': '1'}, {'ingredient_id': 'd68e04f3-f91e-4949-8454-e3ef278a2340', 'quantite': '2'}, {'ingredient_id': 'e42ff0e9-649c-49cd-b8c6-9e39490331aa', 'quantite': '2'}, {'ingredient_id': 'bbf6b206-00d1-4458-814c-90db43ec66ba', 'quantite': '150 g'}, {'ingredient_id': '932f7c81-e867-493d-8746-fe5c6b878b67', 'quantite': '100 g'}, {'ingredient_id': '4b985ea6-def0-4ea6-8c80-ac23aa52610b', 'quantite': '50 g'}, {'ingredient_id': 'dfd7aeea-b845-4a90-b737-a60d58a2a4e3', 'quantite': '100 g'}, {'ingredient_id': 'a45dfdfe-94d0-4e00-9ed9-064666d41571', 'quantite': '2'}, {'ingredient_id': 'b3744d4a-fb60-4ea7-8f64-b43c79b266a1', 'quantite': '1'}, {'ingredient_id': 'c1273b1a-5d6c-44c0-92f5-5d21db657f9f', 'quantite': '3 cuillères'}, {'ingredient_id': 'ed852674-832f-4078-9865-5d180fbecd41', 'quantite': '1 cuillères'}, {'ingredient_id': '92274e8d-e5c8-4842-8b32-9dfe256da4e7', 'quantite': ''}, {'ingredient_id': '62eda9fd-21bf-4f88-8fdd-bdf97f767bcc', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20300, 'Ratatouille à la Viande Hachée', 'huile d''olive, oignon, ail, viande hachée, tomate, courgette, poivron, sel, curry', '20 min', ['Mettre un peu d''huile d''olive dans ue grande casserole. ', 'Y faire revenir les oignons et l''ail haché quelques minutes. ', 'Une fois les oignons et l''ail revenus, ajouter la viande hachée. La faire revenir quelques minutes. ', 'Ajouter les tomates coupées grossièrement en dés (ou une boîte de tomates concassées). ', 'Pendant ce temps préparer les courgettes et les poivrons. Les couper en petits dés, sans nécessité d''enlever la peau. ', 'Ajouter les légumes dans la grande casserole. ', 'Couvrir et laisser mijoter entre 30 mn et 1 heure. Surveiller, rajouter un peu d''eau en cours de cuisson.'], ['Poêle', 'Balance de cuisine', 'Moule à tarte', 'Rouleau à pâtisserie'], ['courgette', 'huile d''olive', 'poivron', 'ratatouille', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'très facile', 'viande hachée', 'bon marché', 'plat de résistance', 'recette', 'sel', 'Ratatouille à la Viande Hachée', 'dessert', 'oignon', 'tomate', 'ail', 'curry', 'boisson', 'recettes'], 'Plat principal', 7404ccbf-c301-423f-8734-1c4c7ca8770a, '2025-09-26T15:04:24.593393', [{'ingredient_id': '0040daab-bc27-4455-b905-c8286fabf716', 'quantite': ''}, {'ingredient_id': '6a70558e-b84d-4098-b8ed-d1bf47b11963', 'quantite': '1'}, {'ingredient_id': '6f0c8da5-2d40-45c9-9bd9-e2f2503e7ba1', 'quantite': '2'}, {'ingredient_id': '72a2fda6-113f-4525-a270-2b37dae2a152', 'quantite': '400 g'}, {'ingredient_id': '318578fc-750f-4a6f-a5fc-5a311623eb22', 'quantite': '250 g'}, {'ingredient_id': 'd5d690db-4a00-49e2-8beb-efb4b2e313cf', 'quantite': '1 kg'}, {'ingredient_id': '7a4ae407-ab7a-4cc6-83f4-070f4dea89df', 'quantite': '1'}, {'ingredient_id': '2378c650-4fe5-4ad5-b171-7dca24899a07', 'quantite': ''}, {'ingredient_id': '52258b54-1998-4037-8e14-a0e552e7e604', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66174, 'Casserole de viandes hachées aux poireaux', 'huile, beurre, poireau, fenouil, viande hachée, origan, pomme de terre, cheddar, crème fraîche épaisse, poivre, sel', '20 min', ['Cuire les pommes de terre à l''eau bouillante salée. Egoutter.', 'Laisser refroidir quelques minutes.', 'Couper les pommes de terre en rondelles.', 'Préchauffer le four à 180°C (thermostat 6).', 'Dans une poêle, faire chauffer l''huile et le beurre et faire revenir les poireaux et le fenouil à feu moyen.', 'Ajouter le porc et le veau hachés, émietter à l''aide d''une fourchette pendant la cuisson.', 'Cuire à feu vif jusqu''à ce que la viande soit dorée.', 'Saler et poivrer. Saupoudrer d''origan et mélanger.', 'Etendre la moitié des pommes de terre dans un plat à four.', 'Recouvrir du mélange de viandes et légumes, puis du reste de pommes de terre.', 'Saupoudrer de fromage râpé.', 'Verser la crème sur les pommes de terre. Saler et poivrer.', 'Cuire au four pendant environ 30 minutes.'], ['Fouet', 'Pince de cuisine', 'Poêle', 'Passoire', 'Tire-bouchon'], ['', 'huile', 'entrée', 'cocktail', 'recettes de cuisine', 'crème fraîche épaisse', 'plat', 'cuisine', 'confiserie', 'testées', 'origan', 'pomme de terre', 'Casserole de viandes hachées aux poireaux', 'viande hachée', 'bon marché', 'facile', 'plat de résistance', 'poireau', 'cheddar', 'recette', 'sel', 'beurre', 'dessert', 'poivre', 'boisson', 'fenouil', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:04:28.569644', [{'ingredient_id': 'e238ea9c-c17d-4ab5-8157-34fed391f2e7', 'quantite': '1 cuillères'}, {'ingredient_id': '1a2bff1d-0359-4ece-9c5a-c57d3382fac6', 'quantite': '30 g'}, {'ingredient_id': '815d85e4-578b-452e-bd39-ed17e48fbc6f', 'quantite': '2'}, {'ingredient_id': '624e43de-4ac0-4f81-aba6-06186837c765', 'quantite': '1'}, {'ingredient_id': 'bb120cdb-c269-43a0-a70c-795b1af990f7', 'quantite': '600 g'}, {'ingredient_id': '985842f8-948a-4798-b8b2-a880b6dd92aa', 'quantite': '1 cuillères'}, {'ingredient_id': '37ac0329-ecee-4c28-8c72-f8f959d2c11b', 'quantite': '4'}, {'ingredient_id': '9af4704c-c662-40e0-b75d-2ae964588661', 'quantite': '150 g'}, {'ingredient_id': '8e319943-faf0-4295-836b-642e5f9b2f79', 'quantite': '20 cl'}, {'ingredient_id': 'ba4d1227-fbb4-4cf9-becf-22ef146b8e83', 'quantite': ''}, {'ingredient_id': '491e9b8e-be62-4132-996b-86ed495e9089', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55953, 'Chiche Kebab à L''armenienne', 'gigot d''agneau, persil, oignon blanc, jus de citron, huile d''olive, poivre, sel, cumin', '120 min', ['La veille, dégraissez le gigot et coupez-le en dés de 3 cm de côté.', 'Mettez les dés à mariner avec le persil ciselé, les oignons coupés en fines rondelles, le jus de citron, l''huile d''olive, le poivre, le sel et le cumin.', 'Laisser reposer au réfrigérateur.', 'Le lendemain, mettre 5 ou 6 morceaux de viande par brochette (chiche).', 'Allumez le barbecue avec du charbon  de bois ; lorsque la braise n''est plus très vive, faire cuire les brochettes.', 'Accompagnez ces brochettes avec les oignons et le persil macérés et un riz pilaf (voir remarques ci-dessous).'], ['Spatule', 'Fouet', 'Râpe', 'Ouvre-boîte', 'Tire-bouchon'], ['huile d''olive', 'entrée', 'cocktail', 'moyen', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'kebab', 'facile', 'plat de résistance', 'recette', 'sel', 'persil', 'dessert', 'Chiche Kebab à L''armenienne', 'jus de citron', 'oignon blanc', 'gigot d''agneau', 'cumin', 'poivre', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:04:33.510361', [{'ingredient_id': '4e0b8fe7-5db6-450f-a710-f8ce5cd80447', 'quantite': '1'}, {'ingredient_id': '542228c9-1669-4c3a-9b28-ff44b8711991', 'quantite': '1'}, {'ingredient_id': '08851d82-45b1-4143-ae32-b9cc90381fe8', 'quantite': '1 kg'}, {'ingredient_id': '029964e4-0407-401e-9b69-dc6df2b3c9d0', 'quantite': '1'}, {'ingredient_id': 'ca20b279-a602-4507-96dd-7d0904eb5781', 'quantite': '1'}, {'ingredient_id': 'c34b849f-621f-4376-a8ac-7a0746e2e3f7', 'quantite': '1 cuillères'}, {'ingredient_id': '91989541-1999-4aed-8779-571343c4c73b', 'quantite': '1 cuillères'}, {'ingredient_id': 'cb66c409-cc84-4491-aa96-f90391bda307', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16981, 'Boulettes de viande légères à la tomate.', 'viande hachée, tomates pelées, oignon, huile d''olive, basilic, muscade, fleur de sel, poivre', '15 min', ['Dans un saladier, mélanger à la main, la viande, le basilique, 1 cuillère à café de fleur de sel et une grosse pincée de poivre.', 'Former des petites boulettes, les aplatir légèrement et réserver.', 'Dans une poêle à bords hauts, ou une cocotte, rissoler dans l''huile d''olive ,les oignons finement hachés et ajouter les morceaux de tomates.', 'Cuire tout d''abord à feu vif, en remuant souvent.', 'Puis laisser mijoter, jusqu''à réduction de moitié, du volume initial.', 'Dans la sauce tomate épaisse, ainsi obtenue, déposer les boulettes et les cuire 5 minutes, sur chaque face.', 'Si nécessaire, diviser en deux fournées.', 'Servir accompagné de riz blanc, pâtes natures, ou légumes verts.'], ['Casserole', 'Planche à découper'], ['huile d''olive', 'muscade', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'fleur de sel', 'viande hachée', 'basilic', 'bon marché', 'facile', 'plat de résistance', 'boulettes de viande', 'recette', 'dessert', 'oignon', 'tomates pelées', 'Boulettes de viande légères à la tomate.', 'poivre', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:04:37.461800', [{'ingredient_id': 'dbad9681-a410-4141-a313-a779ce5cd7ff', 'quantite': '700 g'}, {'ingredient_id': '9410b9f4-d61a-45e0-8248-b3304c402252', 'quantite': '12'}, {'ingredient_id': '960abcb5-da25-4af8-86a0-b6c1399bffe5', 'quantite': '4'}, {'ingredient_id': '2b2cce28-0512-45c6-9d06-c2d1373d86c2', 'quantite': '1'}, {'ingredient_id': '58b1271d-2931-42ba-87cf-d03aca63760b', 'quantite': '5 cuillères'}, {'ingredient_id': 'af8cae57-2a96-48ed-9008-75a61fa089e7', 'quantite': '1 cuillères'}, {'ingredient_id': '90f533e1-f87e-4ec8-9a6b-19c95f72b20f', 'quantite': ''}, {'ingredient_id': '4fcec9ae-1453-44b8-8937-37bce85a9d71', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81946, 'Tarte aux légumes et viande hachée', 'pâte feuilletée, boeuf haché, oignon, ail, échalote, tomate, courgette, endive, poivron, sucre en poudre, crème fraîche, oeuf, thym, laurier', '30 min', ['Mettre vos poivrons au four à 210°C (thermostat 7) afin de les faire griller et de pouvoir les peler.', 'Pendant ce temps, ébouillanter vos tomates afin de les peler également.', 'Puis dans une sauteuse, faire revenir votre viande avec un filet d''huile d''olive.', 'Emincer votre oignon et vos échalotes et éplucher l''ail (sans l''écraser).', 'Faire colorer dans la sauteuse servie précédemment. ', 'Ajouter ensuite l''endive coupée en lamelle, la courgette coupée en rondelles, les tomates coupées en dés, le thym, le laurier et le sucre.', 'Sortir les poivrons du four, les peler, les épépiner et les couper en lanières. Ajouter au reste des légumes. ', 'Laisser mijoter jusqu''à quasi-complète évaporation.', 'Dans un bol, mélanger les oeufs et la crème.', 'Etaler la pâte dans le moule à tarte et la faire précuire 10 minutes au four à 210°C (thermostat 7).', 'Ensuite verser la viande avec les légumes sur votre pâte feuilletée, ajouter votre mélange oeufs-crème par dessus et enfourner pour 30 minutes environ (jusqu''à ce que la tarte soit dorée).'], ['Rouleau à pâtisserie', 'Passoire', 'Moule à tarte', 'Planche à découper', 'Batteur électrique'], ['', 'courgette', 'poivron', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'pâte feuilletée', 'testées', 'oeuf', 'laurier', 'sucre en poudre', 'endive', 'très facile', 'boeuf haché', 'échalote', 'bon marché', 'plat de résistance', 'thym', 'recette', 'dessert', 'oignon', 'Tarte aux légumes et viande hachée', 'tomate', 'crème fraîche', 'ail', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:04:41.487023', [{'ingredient_id': 'd0768045-1173-4917-b070-5a523276ac41', 'quantite': '1'}, {'ingredient_id': 'e34a7a0f-2eba-4e37-9a83-f3799adbea0c', 'quantite': '600 g'}, {'ingredient_id': 'bc853471-b80b-4151-be76-809fd66af5c4', 'quantite': '1'}, {'ingredient_id': 'a5460dde-7388-4daf-bed3-c32d25bae24d', 'quantite': '3'}, {'ingredient_id': '3ec31806-49be-4523-afd7-8cf65eed9a21', 'quantite': '2'}, {'ingredient_id': '234eca8a-0104-423f-9bd7-3cea98cab30a', 'quantite': '2'}, {'ingredient_id': '7c962300-dadf-4950-bc04-c8eebd027c31', 'quantite': '1'}, {'ingredient_id': '6b6895cd-6e0c-4c03-bb98-a35fcdb645be', 'quantite': '1'}, {'ingredient_id': '4fc39568-d6ce-4bb5-87fd-bc6b2f113b6d', 'quantite': '2'}, {'ingredient_id': 'b47f8a6d-24e6-4a0c-8918-268738a3a63b', 'quantite': '1 cuillères'}, {'ingredient_id': 'e50f6092-7882-46a2-a0cf-70cef81cf345', 'quantite': ''}, {'ingredient_id': 'eba80703-3bc9-4b21-8343-60f5ae912b25', 'quantite': '3'}, {'ingredient_id': '9614963a-9f27-4c38-a9b6-8c8cc5380287', 'quantite': '1'}, {'ingredient_id': '5dd866c0-0b6e-4af4-98be-82051b518c6b', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16732, 'Tourte à la viande et aux marrons', 'pâte brisée, porc, pomme, marrons, oeuf, madère, beurre, poivre, sel', '15 min', ['Hacher la viande. Ajouter les pommes coupées en lamelles très fines et les marrons grossièrement hachés, le madère, le sel, le poivre et un œuf entier.', 'Abaisser les 2/3 de la pâte et foncer une tourtière beurrée. Piquer le fond avec une fourchette et le garnir avec la farce.', 'Badigeonner de jaune d''oeuf les bords de la pâte. ', 'Étendre le reste de pâte en un disque que l''on pose sur la farce.', 'Bien souder les bords, et badigeonner le dessus avec le reste d''oeuf. Faire une cheminée au centre.', 'Mettre au four pendant 45 min environ (surveiller).'], ['Tire-bouchon', 'Moule à tarte', 'Presse-agrumes', 'Fouet', 'Spatule'], ['entrée', 'cocktail', 'Tourte à la viande et aux marrons', 'moyen', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'oeuf', 'pomme', 'facile', 'plat de résistance', 'recette', 'porc', 'pâte brisée', 'sel', 'beurre', 'madère', 'dessert', 'marrons', 'poivre', 'boisson', 'recettes'], 'Plat principal', cb576788-d95c-478a-9c39-2200902108ee, '2025-09-26T15:04:45.123435', [{'ingredient_id': '95c33eab-4d00-4592-a0c6-88c06a72bbae', 'quantite': '250 g'}, {'ingredient_id': 'c34f3b3f-3b23-4db5-ac29-a8cf60b527e9', 'quantite': '300 g'}, {'ingredient_id': '85c6ee09-a6ba-48b7-a66f-793e6ed1adc5', 'quantite': '3'}, {'ingredient_id': '531e9b38-183e-4c33-a8c0-5d33cab611ff', 'quantite': '1'}, {'ingredient_id': 'de792370-591e-48ad-833c-b97a15efdc5d', 'quantite': '2'}, {'ingredient_id': '85ba2e9f-8284-4311-8e18-180674521a48', 'quantite': '10 cl'}, {'ingredient_id': '838f2e54-c39a-4b6f-9d8a-92fdb901b17c', 'quantite': '20 g'}, {'ingredient_id': 'db7b456f-92ca-47cb-ac16-fa3c1fafb35c', 'quantite': ''}, {'ingredient_id': '6a5e97aa-0765-418a-910a-a1bc9b96be38', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37537, 'Sauce mille et une saveurs (pour viandes et poissons)', 'crème fraîche, moutarde, miel, vinaigre de cidre, couteau, poivre, sel, échalote, huile d''olive', '5 min', ['Faire revenir dans une poêle les échalotes émincées avec l''huile d''olive.', 'Mélanger dans un bol la crème fraiche, le curry, la moutarde, le sel et le poivre.', 'Déglacer la poêle avec le vinaigre de cidre, ajouter le mélange crème, bien remuer, intégrer le miel.', 'Faire chauffer à feu doux.', 'Servir immédiatement en saucière ou napper directement votre viande ou votre poisson.'], ['Presse-agrumes', 'Spatule', 'Pince de cuisine', 'Planche à découper', 'Râpe'], ['moutarde', 'huile d''olive', 'miel', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'très facile', 'échalote', 'bon marché', 'plat de résistance', 'Autres sauces', 'recette', 'rapide', 'Sauce mille et une saveurs (pour viandes et poissons)', 'couteau', 'sel', 'vinaigre de cidre', 'dessert', 'crème fraîche', 'poivre', 'boisson', 'recettes'], 'Sauce', 4c650de6-0882-4c20-a254-cf6842ea37e2, '2025-09-26T15:04:49.963770', [{'ingredient_id': '102fd8c9-b0d4-4740-be0c-357f772f0abd', 'quantite': '30 cl'}, {'ingredient_id': '0818dcec-cd79-4ad8-bbc0-3cc03c79c2a8', 'quantite': '2 cuillères'}, {'ingredient_id': 'c17203ac-e19c-44eb-b41a-6a6bc7979fd6', 'quantite': '1.5 cuillères'}, {'ingredient_id': 'e72c9196-cab1-49a0-b5fb-0e7f0da32726', 'quantite': '1 cuillères'}, {'ingredient_id': 'ab4b6443-a230-4b3d-8d8a-2a7550013312', 'quantite': '1'}, {'ingredient_id': 'e4db49ce-d60b-4cb6-a218-79fec720ab56', 'quantite': ''}, {'ingredient_id': '01eb40ca-3fc8-4159-9fe4-089b6724511b', 'quantite': ''}, {'ingredient_id': 'f211d5f8-aae5-446c-b386-b9eacdfe0009', 'quantite': '2'}, {'ingredient_id': 'd2f9474c-98ac-48f7-99d2-34b7561e7961', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (349823, 'Tacos aux poivrons', 'oignon, poivron rouge, tortilla, Philadelphia, origan, Parmesan, huile d''olive, sel et poivre', '25 min', ['Epluchez l''oignon et découpez-le en lanières. ', 'Faites chauffer l''huile d''olive dans une poêle haute à feu moyen/fort et mettre l''oignon à revenir une fois l''huile bien chaude. Les faire revenir 5 minutes si vous les aimez quand ils sont bien dorés.', 'Pendant la cuisson de l''oignon, épépinez les poivrons rouges et coupez les en lanières. ', 'Ajoutez-les aux oignons et salez poivrez à ce moment. Faites revenir le tout 10 minutes (un peu moins pour ceux qui aime les poivrons croquants).', 'Pendant que les poivrons cuisent, tartinez les tortillas de philadelphia sur la moitié et préchauffez votre four à 220°C (thermostat 7) en mode traditionnel + grill (important!).', 'Répartissez les poivrons et oignon dans les tortillas, refermez-les sur elles-mêmes puis saupoudrez de parmesan fraichement râpé. Ajouter un peu d''origan sur le dessus et un peu de poivre moulu si vous aimez quand c''est un peu relevé.', 'Enfournez pour 3-4 minutes sur une plaque couverte de papier sulfurisé au niveau juste au dessus de mi-hauteur (niveau 3), attention à bien surveiller car les tortillas vont vite dorer et le parmesan doit juste être roussi.', 'Il n''y a plus qu''à les sortir du four et bon appétit !'], ['Casserole', 'Tire-bouchon', 'Économe'], ['huile d''olive', 'entrée', 'cocktail', 'Philadelphia', 'recettes de cuisine', 'plat', 'tortilla', 'cuisine', 'confiserie', 'testées', 'origan', 'sel et poivre', 'très facile', 'bon marché', 'plats mexicains', 'plat de résistance', 'Tacos aux poivrons', 'recette', 'Parmesan', 'rapide', 'dessert', 'oignon', 'poivron rouge', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:04:53.576214', [{'ingredient_id': '8c9fd6e0-c464-4f25-9221-2d106075d933', 'quantite': '1'}, {'ingredient_id': 'df641ffe-e41c-4e5e-9d21-5759e9972136', 'quantite': '2'}, {'ingredient_id': 'ee4b9907-325b-4a97-b89d-90e6b2afa9f6', 'quantite': '3'}, {'ingredient_id': 'd690aff6-e4ac-4e81-a7fb-bb21c09651cf', 'quantite': '75 g'}, {'ingredient_id': 'c90c1ef2-51c0-4063-a52d-d026e3774f71', 'quantite': ''}, {'ingredient_id': '2b8e8298-d29c-48a1-87f0-cdeafd176432', 'quantite': ''}, {'ingredient_id': 'fbd28c7c-253e-4eb7-b8dd-20158dcc8ce7', 'quantite': '3 cuillères'}, {'ingredient_id': 'd43e91ed-822b-4442-b232-d6e1113187a4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (201296, 'Quiche à la viande hachée', 'pâte feuilletée, viande hachée, lardons, tomate, poivron, oeuf, emmental, persil, basilic', '20 min', ['Préchauffer le four à 200°C (thermostat 7).', 'Dans un plat à tarte, étaler la pâte feuilletée. ', 'Dans une poêle, faire revenir la viande hachée (ne pas la cuire totalement) puis saler et poivrer.', 'Mettre la viande hachée dans un saladier et y incorporer les œufs, les lardons (crus), la tomate (préalablement coupée en morceaux), le poivron (émincé), un peu d''emmental et mélanger le tout.', 'Verser la préparation dans le plat à tarte.', 'Parsemer de basilic et de persil à votre convenance puis recouvrir avec le reste d''emmental.', 'Mettre au four pendant 20 min.', 'Servir avec une salade verte. Bon appétit !'], ['Rouleau à pâtisserie', 'Mixeur', 'Couteau de chef', 'Pince de cuisine', 'Casserole'], ['', 'Quiche à la viande hachée', 'poivron', 'entrée', 'cocktail', 'emmental', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'pâte feuilletée', 'testées', 'oeuf', 'viande hachée', 'basilic', 'bon marché', 'facile', 'plat de résistance', 'recette', 'lardons', 'persil', 'dessert', 'tomate', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:04:58.174192', [{'ingredient_id': '1bb065ff-d7ea-4c81-bcd6-a0cf78e5231d', 'quantite': '1'}, {'ingredient_id': 'a77ae9ad-1645-49d2-b0ee-c6c42220cfec', 'quantite': '500 g'}, {'ingredient_id': '2a0adaee-ca28-4898-9e04-a1b32ba1e8aa', 'quantite': '50 g'}, {'ingredient_id': '010eb891-586f-4bf1-981b-7d7e98a7c8e2', 'quantite': '1'}, {'ingredient_id': '423ca647-4a8d-478a-a2f6-7a91568ad7dc', 'quantite': '1'}, {'ingredient_id': 'da0ba27b-4bf1-4a70-8f6b-b8e5495a9e36', 'quantite': '3'}, {'ingredient_id': '428a5c55-f9c4-4618-a2e0-cd3b1d10f41c', 'quantite': '70 g'}, {'ingredient_id': '489cbf88-47ab-4cbc-81e4-3742d5778a2c', 'quantite': ''}, {'ingredient_id': '56649d6b-49cc-4e36-be2e-07428994e36c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (95766, 'Gratin de viande hachée à l''orientale', 'viande hachée, tomate, pomme de terre, poivron, oignon, coriandre, pulpe de tomate, gruyère râpé, huile, ail, colorant alimentaire', '30 min', ['Éplucher et couper les pommes de terres en rondelles fines. Les faire dorer quelques minutes dans un peu d''huile.', 'Hacher les oignons avec la coriandre et l''ail et mélanger à la viande hachée avec le colorant.', 'Mettre la viande dans un plat adapté au four, ajouter les pommes de terres sautées, les tomates coupées en rondelles puis les poivrons coupés en rondelles. Couvrir de la pulpe de tomate puis du fromage choisi.', 'Enfourner pour 45 minutes à 180°C (thermostat 6) en surveillant. c''est prêt!'], ['Planche à découper', 'Passoire', 'Râpe', 'Économe', 'Spatule'], ['', 'huile', 'colorant alimentaire', 'poivron', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'pomme de terre', 'gruyère râpé', 'très facile', 'viande hachée', 'bon marché', 'plat de résistance', 'recette', 'Gratin de viande hachée à l''orientale', 'pulpe de tomate', 'coriandre', 'dessert', 'oignon', 'tomate', 'ail', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:05:02.021736', [{'ingredient_id': 'c65ed2ae-9321-42e0-a939-459bc0c06fb8', 'quantite': '500 g'}, {'ingredient_id': 'bc87edf6-0c74-481b-a7cc-fb9084d5f055', 'quantite': '4'}, {'ingredient_id': 'ca8bb6e2-035c-4049-9a85-1299f9634edd', 'quantite': '6'}, {'ingredient_id': 'e095f3da-a01e-4251-b4bf-c53f07785d0b', 'quantite': '2'}, {'ingredient_id': '941ebfd4-8e34-4255-b689-50de8e55598b', 'quantite': '2'}, {'ingredient_id': '4dae19ff-6aba-47e1-a131-a75dc83581d9', 'quantite': '1'}, {'ingredient_id': '10f65ec4-e35e-4be4-8c21-d49452d3e20f', 'quantite': '1'}, {'ingredient_id': 'f64a4873-7059-4e0a-a266-a4281c4a766f', 'quantite': ''}, {'ingredient_id': 'd64fb6bb-f607-4621-8a1c-17f528a56117', 'quantite': ''}, {'ingredient_id': '1d9f0178-bf94-4852-987e-98909b9942b3', 'quantite': ''}, {'ingredient_id': '6926f815-e31c-4d9d-a279-3097cfe9310a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56835, 'Marinade pour viandes blanches', 'oignon, échalote, jus de citron, sauce soja, bouquet garni, rhum, poivre, eau, huile d''olive, ail', '5 min', ['Mélanger tous les ingrédients en mettant l''eau à la fin pour couvrir la viande.', 'Faire mariner au moins pendant 4 heures au réfrigérateur (idéal veille pour lendemain).', 'Faire cuire la viande au barbecue ou à la poêle ou au four en arrosant avec la marinade pendant la cuisson.', 'Idéale pour les viandes blanches, côtelettes d''agneau, saumon.... ça marche pour tout !'], ['Râpe', 'Économe', 'Couteau de chef', 'Tire-bouchon', 'Rouleau à pâtisserie'], ['', 'sauce soja', 'huile d''olive', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'rhum', 'très facile', 'échalote', 'bon marché', 'plat de résistance', 'recette', 'rapide', 'Marinade pour viandes blanches', 'dessert', 'bouquet garni', 'eau', 'oignon', 'jus de citron', 'ail', 'poivre', 'boisson', 'recettes'], 'Sauce', f5b5e2d6-55cb-40c3-a371-5d4b378669a5, '2025-09-26T15:05:05.958701', [{'ingredient_id': '9e9647b8-3e52-49fe-9283-402c7dbc5c4c', 'quantite': '1'}, {'ingredient_id': 'cc4c8fb2-f346-4471-9f79-2998f1573ab5', 'quantite': '3'}, {'ingredient_id': '2b80bcda-d148-4857-a646-54b164f3360f', 'quantite': '1'}, {'ingredient_id': 'e15b7f4a-1780-431c-9d27-ba4f6d7fb8f2', 'quantite': '2 cuillères'}, {'ingredient_id': 'b2409658-165c-4f7f-8125-3bba876cc521', 'quantite': '1'}, {'ingredient_id': 'c878c163-aece-4a52-b554-7ac16a716caf', 'quantite': '1'}, {'ingredient_id': '167cff77-fcdb-4136-b4c7-422f1d3f19a8', 'quantite': ''}, {'ingredient_id': '0673353b-8f3c-40c7-8524-b6612443d6ca', 'quantite': ''}, {'ingredient_id': 'f8721f57-b255-4773-a34e-36076cc4e977', 'quantite': '3 cuillères'}, {'ingredient_id': '1a4e2852-fc0a-4873-8373-cf0db7efe725', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17252, 'Boulettes de viande à la marocaine - kefta b''matecha (Maroc)', 'tomates pelées, viande hachée, oignon, cumin, paprika, gingembre, persil, beurre, sel, piment', '15 min', ['Mettre la boîte entière de tomates pelées dans une grande casserole ou une cocotte, les écraser grossièrement. ', 'Rajouter par-dessus l''oignon râpé, les épices, le beurre, mélanger puis laisser mijoter à feux doux jusqu''à obtenir une purée de tomates (mélanger de temps à autre) et rajouter le persil. ', 'Pendant ce temps là, faire les boulettes de viande de la taille d''une bille, puis les verser dans la préparation, mélanger. Couvrir, laisser bouillir pendant une bonne demi-heure à feux moyen jusqu''à ce que les boulettes de viande soient bien cuites et la sauce réduite. ', 'Mélanger, servir. Ce plat, très populaire au Maroc, peut se manger aussi bien seul qu''avec du riz blanc en accompagnement (un régal quand on mélange le tout)'], ['Pince de cuisine', 'Spatule', 'Casserole', 'Poêle'], ['entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'gingembre', 'confiserie', 'testées', 'très facile', 'piment', 'viande hachée', 'bon marché', 'plat de résistance', 'recette', 'sel', 'beurre', 'persil', 'dessert', 'oignon', 'tomates pelées', 'kefta', 'Boulettes de viande à la marocaine - kefta b''matecha (Maroc)', 'cumin', 'paprika', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:05:12.769235', [{'ingredient_id': '4a2818d3-50dc-49c3-9547-34868d5134bc', 'quantite': '1'}, {'ingredient_id': '7d01d3e2-d380-4a7a-8a01-35b1ebceacf0', 'quantite': '500 g'}, {'ingredient_id': '8887d595-cae4-4056-8eaf-8e89d5b4eb8d', 'quantite': '1'}, {'ingredient_id': 'b6839479-881b-4226-9a7b-fe20011b8fc6', 'quantite': '1 cuillères'}, {'ingredient_id': 'f19bb5f4-dd67-4078-9c7d-cc091919e56d', 'quantite': '1 cuillères'}, {'ingredient_id': '44c5909b-3cba-4aaa-b1d6-b6beb9cecfeb', 'quantite': '1'}, {'ingredient_id': '23a4e479-0232-480f-bc03-401754772d4a', 'quantite': '1'}, {'ingredient_id': 'a0c8123d-886f-4a6b-a43f-05586f528bb1', 'quantite': '100 g'}, {'ingredient_id': '6a43b6f4-9ada-484a-b687-694803e89482', 'quantite': ''}, {'ingredient_id': '33f837f2-4111-4247-8519-70e2b41a7356', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81182, 'Chou blanc à la viande hachée (recette allemande)', 'chou blanc, viande hachée, oignon, oeuf, crème fraîche épaisse, lait, huile, poivre, sel, carvi', '20 min', ['Couper les oignons en dés et les faire revenir dans une sauteuse avec un peu d''huile et la viande hachée. ', 'Faire saisir la viande pendant 5 minutes avant d''ajouter le chou coupé en lanières.', 'Faire cuire en tournant régulièrement pendant 5 à 10 minutes. ', 'Ajouter sel, poivre et le carvi et disposer le mélange dans un plat allant au four. ', 'Battre les oeufs dans un bol avec la crème et le lait, saler et verser l''appareil sur le chou. ', 'Mettre au four à 200°C (thermostat 6-7) pendant 40 min.'], ['Moule à tarte', 'Râpe', 'Économe', 'Poêle'], ['', 'lait', 'huile', 'entrée', 'cocktail', 'recettes de cuisine', 'crème fraîche épaisse', 'plat', 'cuisine', 'confiserie', 'testées', 'oeuf', 'viande hachée', 'bon marché', 'facile', 'plat de résistance', 'chou blanc', 'recette', 'sel', 'Chou blanc à la viande hachée (recette allemande)', 'dessert', 'oignon', 'poivre', 'boisson', 'carvi', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:05:19.748186', [{'ingredient_id': '50176394-ba62-47cd-b991-ea1b229357ce', 'quantite': ''}, {'ingredient_id': '5b9686c1-257b-4420-a11a-6ecd911b4496', 'quantite': '500 g'}, {'ingredient_id': '897a8051-a51a-4806-ad66-9aefe527500c', 'quantite': '3'}, {'ingredient_id': '19845df6-f658-48ae-b767-5d9b62b52bca', 'quantite': '3'}, {'ingredient_id': 'ff5187ba-ba0a-44a3-b572-7b2d26a1b364', 'quantite': '250 g'}, {'ingredient_id': 'b010f463-85d9-406d-966e-4bda47294a64', 'quantite': '200 ml'}, {'ingredient_id': '16a67565-3fa3-4055-a04b-ce8c9311a4a2', 'quantite': ''}, {'ingredient_id': '516fddcd-3825-4f32-8571-9ff39008cb60', 'quantite': ''}, {'ingredient_id': '0328fb12-d4b8-4d2c-acff-a6f85dc9c138', 'quantite': ''}, {'ingredient_id': 'acc70315-f78c-446b-84e0-25ccda3415bf', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40458, 'Cannellonis farcis à la viande et au jambon (19ème rencontre)', 'viande hachée, jambon, oignon, persil, ail, basilic, origan, poivre, sel, huile d''olive, canneloni, oignon, ail, tomates pelées, feuille de laurier, thym, origan, poivre, sel, vin blanc, gruyère', '60 min', ['Préparation : 1h', 'Cuisson : 1h30', 'Ingrédients (pour 6 personnes) :', 'Préparation :', 'Sauce tomate : hacher les oignons et l’ail.', 'Dans une casserole, faire chauffer l’huile. Faire fondre les oignons, saler et poivrer, ajouter les herbes. Ajouter l’ail. Verser les tomates. Ajouter une larme de vin blanc (et donner un petit verre à la cuisinière)', 'Laisser cuire doucement, de 30 minutes à 1 heure.', 'La farce : couper le jambon en tous petits dés. Hacher l’ail et l’oignon.', 'Faire revenir l’oignon dans un peu d’huile, ajouter le jambon et l’ail. Ajouter le persil, le basilic et l’origan.', 'Ensuite, ajouter le hachis porc / veau. Faire légèrement dorer et laisser cuire. Ajouter une larme de vin blanc (et donner un autre petit verre à la cuisinière)', 'Laisser refroidir (en attendant, la cuisinière peut reprendre un troisième petit verre).', 'Le plat : faire préchauffer le four à 180°C.', 'Remplir les pâtes crues, j’utilise une petite cuillère d’un diamètre légèrement inférieur au tube. (attention : le nombre de petits verres absorbés par la cuisinière influence énormément sur la durée de cette opération)', 'Mettre une première couche de pâte. Verser un peu de sauce. Faire une deuxième couche. Verser la sauce.', 'Mettre le gruyère et faire cuire pendant 25 minutes.', '(Le temps de reprendre un verre et d’ouvrir une autre bouteille…)', 'Faire gratiner.'], ['Verre doseur', 'Râpe', 'Spatule', 'Économe', 'Batteur électrique'], ['huile d''olive', 'entrée', 'cocktail', 'moyen', 'recettes de cuisine', 'plat', 'cuisine', 'jambon', 'confiserie', 'Cannellonis farcis à la viande et au jambon (19ème rencontre)', 'testées', 'origan', 'viande hachée', 'basilic', 'facile', 'plat de résistance', 'recette', 'sel', 'autres pâtes', 'persil', 'dessert', 'oignon', 'ail', 'canneloni', 'poivre', 'boisson', 'recettes'], 'Plat principal', 430b6336-7370-4265-be59-c22d9e52b519, '2025-09-26T15:05:23.950399', [{'ingredient_id': '8f783189-7811-4fac-96df-ef1f233cb49e', 'quantite': '500 g'}, {'ingredient_id': '3a79b665-efd7-4343-a358-12abc6b1f6ad', 'quantite': '300 g'}, {'ingredient_id': '80107531-9061-47aa-a79a-94086d99ca2e', 'quantite': '1'}, {'ingredient_id': 'c7d582b0-31ff-468c-af39-5de73245079e', 'quantite': '1 cuillères'}, {'ingredient_id': '46b65376-750f-404b-ad77-6e129d54ae4c', 'quantite': '1'}, {'ingredient_id': '860b4962-a187-4a9f-80fe-50e56e80fc58', 'quantite': '1'}, {'ingredient_id': '6e92502f-9598-4c0d-829d-c3fb95b70a03', 'quantite': '1'}, {'ingredient_id': 'f774186f-9b07-48e0-85d8-db4c48eb53db', 'quantite': ''}, {'ingredient_id': '82970e96-8a31-4d26-961e-b594f43c7442', 'quantite': ''}, {'ingredient_id': 'a9854c2b-5c4e-4229-8fdb-b600e571ae2a', 'quantite': ''}, {'ingredient_id': '729a1e48-11af-4de1-b112-07af531dbdac', 'quantite': '1'}, {'ingredient_id': 'ef088cad-d260-4593-bfee-0d1ba19c5c19', 'quantite': '2'}, {'ingredient_id': '066a061f-1947-4d03-a5ab-c9a21320f051', 'quantite': '1'}, {'ingredient_id': 'e169ab70-7701-4214-8acf-27580c1762fc', 'quantite': '3'}, {'ingredient_id': '221ea67f-7bb9-4149-8046-7f7e62f90892', 'quantite': '1'}, {'ingredient_id': '6c416e7a-19a2-494f-b031-e1c76c20b7b4', 'quantite': ''}, {'ingredient_id': 'cb1cbe8a-e4d6-4987-bb96-c0eb80c4b6ab', 'quantite': ''}, {'ingredient_id': '875e4c17-14af-4cf0-8a11-c105b08ffc51', 'quantite': ''}, {'ingredient_id': '7c3181ad-67d4-484a-9951-84086b063a72', 'quantite': ''}, {'ingredient_id': '33f41050-c14f-4e1b-8f84-4fd1d5371ee4', 'quantite': '10 cl'}, {'ingredient_id': '391a2adb-595a-4075-be6c-0d79741110c6', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46954, 'Boulettes de viande à la Marrakchi', 'épaule, haché de veau, oignon, ail, coriandre, cannelle, piment, gingembre, huile d''olive, poivre, sel', '15 min', ['Peler et hacher très fin l''oignon, le faire fondre dans une cuillère à soupe d''huile d''olive à feu doux sans laisser colorer.', 'Peler et hacher l''ail dégermé.', 'Dans un grand saladier, mélanger (avec les mains) les 2 viandes, toutes les épices, le persil ou la coriandre hachée très fine, l''huile d''olive restante, le fondu d''oignon, l''ail, le sel (1/2 cuillère à café) et le poivre.', 'Laisser les saveurs se mélanger en réservant 30 min au frigo.', 'Confectionner des boulettes de la taille d''un œuf au creux de la main et les aplatir de la paume pour obtenir des boulettes d''1 cm d''épaisseur.', 'Cuire 5 min sur chaque face dans une poêle chaude légèrement huilée ou mieux, au barbecue.', 'Servir accompagné d''une semoule de couscous ou d''un caviar d''aubergineset d''une salade de tomate citron + huile d''olive parsemée d''olives noires.'], ['Couteau de chef', 'Presse-agrumes'], ['huile d''olive', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'Boulettes de viande à la Marrakchi', 'cuisine', 'gingembre', 'confiserie', 'testées', 'très facile', 'piment', 'cannelle', 'bon marché', 'plat de résistance', 'boulettes de viande', 'recette', 'épaule', 'rapide', 'sel', 'coriandre', 'haché de veau', 'dessert', 'oignon', 'ail', 'poivre', 'boisson', 'recettes'], 'Plat principal', ba1e944a-6337-4ffe-b56d-dfb0a9f28144, '2025-09-26T15:05:27.618572', [{'ingredient_id': '9852d7c1-f0f2-4d04-9da6-863574a7f3e8', 'quantite': '500 g'}, {'ingredient_id': '698d75aa-88bd-4f95-a644-943a138d7e26', 'quantite': '500 g'}, {'ingredient_id': '5a74199c-9a36-44bb-abb1-eba00bcf252b', 'quantite': '1'}, {'ingredient_id': '57f87a53-7b22-4d03-a21a-00b8dbe27bcb', 'quantite': '1'}, {'ingredient_id': 'c8c64682-bfbc-4a50-9d8e-bdfb6c1a79da', 'quantite': '1'}, {'ingredient_id': 'a333ce1f-4497-4c06-8744-f9a48991a738', 'quantite': '1 cuillères'}, {'ingredient_id': '8ed8cf50-c791-48d1-9be7-3bd7b8c603a0', 'quantite': '1 cuillères'}, {'ingredient_id': '4ea43bd0-65b7-4f22-8dad-5071d5d84af6', 'quantite': ''}, {'ingredient_id': 'e7be8174-a9b4-4252-a395-5505c7d6aa40', 'quantite': '4 cuillères'}, {'ingredient_id': 'ed54841d-3d3c-4586-844b-292412bcafd4', 'quantite': ''}, {'ingredient_id': '3d525d16-38dc-48c3-8e50-f6225eac2d3b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23685, 'Quiche ultra-rapide', 'oeuf, farine, lait, sauce à tacos', '10 min', ['Mélanger la farine, les oeufs et le lait ou la crème fraîche (mais beaucoup plus calorique).', 'Huiler le moule (à tarte), y mettre tous les ingrédients de la garniture et verser dessus la préparation précédente.', 'Mettre au four chaud à 180°C (thermostat 6) pendant 45 minutes.', 'Déguster chaud ou froid.'], ['Pince de cuisine', 'Balance de cuisine', 'Poêle'], ['', 'lait', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'farine', 'cuisine', 'confiserie', 'testées', 'oeuf', 'très facile', 'bon marché', 'plat de résistance', 'recette', 'Quiche ultra-rapide', 'dessert', 'sauce à tacos', 'boisson', 'recettes'], 'Plat principal', 21408f67-8015-49a2-924a-ff7532d4c24f, '2025-09-26T15:05:33.744496', [{'ingredient_id': 'c9270c73-3c0e-4591-a4b9-b83db93232a4', 'quantite': '3'}, {'ingredient_id': '9075eb83-4572-4711-a75d-25719678f137', 'quantite': '100 g'}, {'ingredient_id': 'b111c31e-7d5c-4714-a2ba-f2f1b8e73455', 'quantite': ''}, {'ingredient_id': 'c0637b8b-c18b-41bd-b291-cf42dc39648e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23071, 'Taost à la provençale', 'pain de campagne, anchois, huile d''olive, sarriette', '15 min', ['1) sur un barbecue ou au grille-pain faire griller les tranches de pain. ', '2) étendre 1 ou 2 anchois par tranche, puis saupoudrer de sarriette les anchois, et arroser d''huile d''olive. ', 'Servir chaud à l''apéro ; succès garanti.'], ['Passoire', 'Spatule', 'Couteau de chef'], ['', 'huile d''olive', 'entrée', 'cocktail', 'recettes de cuisine', 'plat', 'cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat de résistance', 'recette', 'rapide', 'pain de campagne', 'Taost à la provençale', 'sarriette', 'anchois', 'dessert', 'boisson', 'recettes'], 'Amuse-gueule', d258521c-b6be-48b7-b7e1-8f5f95ff2209, '2025-09-26T15:05:38.561193', [{'ingredient_id': '802e8dc6-1721-402b-8373-d1665317d9f0', 'quantite': '1'}, {'ingredient_id': '322de8be-bd28-46b0-b7a0-c8bec09007c3', 'quantite': '1'}, {'ingredient_id': 'fda099c9-6183-439b-a122-f8c02e8a9df1', 'quantite': ''}, {'ingredient_id': '25d4f158-64f3-48fb-89cb-460c85b80a49', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20261, 'viandes sauce à l''ancienne', 'viande, oignon, lardons, vin blanc, crème, pomme de terre, champignon, farine', '15 min', ['Dans une cocotte minute : ', 'Faire dorer la viande quelques minutes, puis ajouter lardons et oignons coupés en quartier. ', 'Faire dorer lardons et oignons quelques minutes puis ajouter le vin blanc. ', 'Saler, poivrer, aromater, ajouter les champignons puis refermer la cocotte pour une quinzaine de minutes. ', 'Eplucher les pommes de terre et découper en gros morceaux (couper les patates moyenne en 2, les grosses en 3 ). ', 'Une fois les 15 mn écoulées ajouter les pommes de terre et ajouter de l''eau si certaines pommes de terre ne touchent pas l''eau. ', 'Refermer pour un nouveau quart d''heure. ', 'Ajouter de la crème et/ou de la farine pour épaissir un peu la sauce si cela vous tente.'], ['Économe', 'Pince de cuisine', 'Poêle', 'Ouvre-boîte', 'Fouet'], ['', 'entrée', 'crème', 'cocktail', 'recettes de cuisine', 'plat', 'farine', 'cuisine', 'confiserie', 'testées', 'vin blanc', 'pomme de terre', 'très facile', 'bon marché', 'viande', 'plat de résistance', 'recette', 'lardons', 'champignon', 'dessert', 'oignon', 'viandes sauce à l''ancienne', 'boisson', 'recettes'], 'Plat principal', 91deb644-ca6f-4838-bad9-afb95f41d7ef, '2025-09-26T15:05:43.390437', [{'ingredient_id': '517087de-0d5d-461b-9e43-34c807dabc1c', 'quantite': ''}, {'ingredient_id': 'b13078b1-4cbb-433b-a715-2b04dec35fb2', 'quantite': '4'}, {'ingredient_id': '4e89a4e7-687d-4904-b3c8-103e795f4ce8', 'quantite': '250 g'}, {'ingredient_id': '9f8d7221-08ea-44b0-a009-b982a5ef2b85', 'quantite': '50 cl'}, {'ingredient_id': 'ce137b34-de0a-44a2-82c3-7d75cf8cfd65', 'quantite': ''}, {'ingredient_id': '0f02b525-a5d4-4f42-8667-7afc2d42e8ac', 'quantite': '1.25 g'}, {'ingredient_id': '6b4d273f-af46-4bdc-acce-a347990f1377', 'quantite': '1'}, {'ingredient_id': '536575b8-9404-4306-8d4e-711283bbabe4', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (80482, 'Sauce apéritif pour tacos', 'Saint Morêt, sauce salsa, chêne, mimolette', '10 min', ['Dans des ramequins ou un plat allongé (minimum 7 cm de haut), tartiner d''une belle épaisseur le fond de plat de saint-môret. Faire de même avec la sauce salsa, ajouter la salade ciselée puis recouvrir d''une légère couche de sauce salsa. Pour finir, recouvrir généreusement de mimolette râpée. ', 'Filmer et tenir au frais maximum 2 h sinon la salade va "cuire".', 'A servir en apéritif d''une soirée mexicaine avec des tacos = effet assuré!', 'Les premiers vont se jeter à l''eau timidement mais ne vont pas tarder à y replonger 2 tacos pour faire un petit sandwich.', 'Je vous conseille d''y planter votre tacos en premier car commencer le plat est toujours délicat.', 'Vos invités vons se demander pourquoi vous mettez des carottes râpées en apéritif? Vous penserez à moi !'], ['Économe', 'Fouet', 'Planche à découper'], ['entrée', 'recette', 'plat de résistance', 'recettes de cuisine', 'très facile', 'plats mexicains', 'mimolette', 'sauce salsa', 'recettes', 'bon marché', 'chêne', 'dessert', 'rapide', 'Saint Morêt', 'plat', 'cocktail', 'cuisine', 'Sauce apéritif pour tacos', 'boisson', 'testées', 'confiserie'], 'Amuse-gueule', 479a98c9-cb91-4e7f-a998-3ad33bc6c718, '2025-09-26T15:08:45.906116', [{'ingredient_id': '1be189fd-af97-439e-84eb-67bc3fb7ddc1', 'quantite': '1'}, {'ingredient_id': 'ed11c400-98dd-4b53-a715-0d3ae8627b2e', 'quantite': '1'}, {'ingredient_id': '168bdc24-3074-4cf8-9fba-f1435cd0b27e', 'quantite': ''}, {'ingredient_id': '68837fa0-c588-4059-9bdc-efb77011c5dd', 'quantite': '300 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40803, 'Confiture de framboises', 'framboises, sucre, citron', '5 min', ['Trier les framboises sans les rincer.', 'Les mettre dans une bassine, de préférence en cuivre, avec le sucre et le jus de citron. Remuer délicatement. ', 'Portez à ébullition, et écumer avec soin. ', 'Continuer la cuisson à feu vif, en remuant avec une cuillère en bois, pendant 10 min. ', 'Vérifiez la cuisson avec une assiette froide, sur laquelle vous ferez tomber une goutte de confiture... Celle-ci doit se figer immédiatement, et former une "perle". Si la goutte s''étale continuer la cuisson un peu plus longtemps. ', 'Mettre dans des pots ébouillantés, et laisser refroidir.'], ['Pince de cuisine', 'Râpe', 'Tire-bouchon', 'Passoire', 'Casserole'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'Confiture de framboises', 'sucre', 'plat de résistance', 'citron', 'framboises', 'rapide', 'moyen', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiture de framboise', 'confiserie'], 'Confiserie', 70067d64-c141-40ed-82a1-3a6e1e46bff0, '2025-09-26T15:11:09.524128', [{'ingredient_id': 'c2f26774-d304-45de-92fc-2e415d5e1dda', 'quantite': '1 kg'}, {'ingredient_id': 'b094b475-d1b9-4619-ae06-76d0995e144f', 'quantite': '800 g'}, {'ingredient_id': 'ab1645f6-6a08-434e-a5d9-2b9327b7cf48', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22206, 'milk shake aux fraises light', 'fromage blanc, fraises, édulcorant, glaçons', '10 min', ['Laver les fraises les nettoyer et les couper en deux. ', 'Mélanger dans le bol du robot les ingrédients et c''est parti.... mixer jusqu''à obtenir de la mousse. ', 'Verser sans attendre dans de grands verres et sirotez votre délicieux milk shake à l''aide d''une paille.'], ['Tire-bouchon', 'Pince de cuisine', 'Presse-agrumes', 'Balance de cuisine', 'Couteau de chef'], ['', 'recettes de cuisine', 'plat', 'cocktail', 'milk shake aux fraises light', 'plat de résistance', 'fromage blanc', 'bon marché', 'rapide', 'recette', 'glaçons', 'fraises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'édulcorant', 'recettes', 'confiserie'], 'Boisson', c74f7b39-49cf-4e8a-b22f-10b55c6907f8, '2025-09-26T15:11:13.125679', [{'ingredient_id': '0e23e8a4-eebf-4076-817a-d07c825867a3', 'quantite': '200 g'}, {'ingredient_id': '76fe0888-759f-4a9a-8998-5bc6d6e71b85', 'quantite': '150 g'}, {'ingredient_id': 'ccc409c8-27c9-4ae6-9444-05be4b0c5f73', 'quantite': '2'}, {'ingredient_id': '5453bfb0-45d4-40ad-9248-e9278a75928b', 'quantite': '8'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30141, 'Crumble pommes, bananes et framboises', 'farine, sucre en poudre, beurre, cannelle, pomme, banane, framboises', '15 min', ['Dans un saladier, malaxer avec les doigts, la farine, le sucre, une cuillère à café de cannelle et le beurre ramolli pour en faire ''du sable'' et faire reposer le tout une heure au réfrigérateur.', 'Dans un plat allant au four préalablement beurré, mettre les pommes coupées en cubes, les bananes en rondelles et les framboises.', 'Ajouter la cannelle, recouvrir de pâte et mettre au four préchauffé à thermostat 6/7 (200°C) pendant 30mn.', 'Servir chaud, accompagné d''une boule de glace à la vanille.'], ['Verre doseur', 'Râpe', 'Planche à découper', 'Pince de cuisine'], ['cannelle', 'Crumble pommes', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'banane', 'bon marché', 'crumble aux pommes', 'framboises', 'recette', 'sucre en poudre', 'bananes et framboises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'farine'], 'Dessert', 2df065d2-c4b6-49cc-a2f8-b3760a6b5e22, '2025-09-26T15:11:16.499202', [{'ingredient_id': '65e72b60-6b5d-4fa4-88e2-f6cadcfc60b2', 'quantite': '200 g'}, {'ingredient_id': 'df75de7d-5ba8-4041-a92e-a6f3a2566603', 'quantite': '180 g'}, {'ingredient_id': '7ca2ba0a-deab-42d6-8727-05052dd1c8b8', 'quantite': '125 g'}, {'ingredient_id': '269f880c-24c4-41e2-92c0-d3a129dd71aa', 'quantite': '2 cuillères'}, {'ingredient_id': '6669ed0b-e33d-4696-b5aa-8e04d16f6ac0', 'quantite': '3'}, {'ingredient_id': '6fd2b200-8114-4b16-8e6b-f118436b6b51', 'quantite': '2'}, {'ingredient_id': '4db7039c-6cc4-46ab-899e-9b04893f7345', 'quantite': '250 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29679, 'Charlotte aux fraises légère', 'boudoir, fraises, faisselle, sucre vanillé, extrait de vanille, orange, citron, édulcorant', '30 min', ['Égoutter la faisselle, de façon à éliminer le plus d''eau possible.', 'Laver les fraises, et en réserver 3 ou 4 pour la décoration. ', 'Couper le reste en petit morceaux, et les mettre dans un bol avec le sachet de sucre vanille et le jus de citron. ', 'Mélanger le tout et mettre cette préparation de côté.', 'Ajouter à la faisselle l''édulcorant et l''extrait de vanille, mélanger.', 'Tremper rapidement la face non sucrée des boudoirs dans le jus d''orange et en tapisser les bords et le fond d''un moule à charlotte.', 'Mélanger les fraises et la faisselle, en garnir la moitié du moule à charlotte.', 'Etaler une nouvelle couche de boudoirs, puis verser le reste du mélange fraises faisselle; terminer par une couche de boudoirs.', 'Poser une assiette plate sur le dessus de la charlotte ou le couvercle du moule, et placer au réfrigérateur pendant 4 h.', 'Sortir la charlotte juste avant de la servir, la démouler sur une grande assiette plate, et la décorer de quartiers de fraise.'], ['Économe', 'Balance de cuisine', 'Spatule', 'Ouvre-boîte', 'Poêle'], ['sucre vanillé', 'recettes de cuisine', 'plat', 'cocktail', 'Charlotte aux fraises légère', 'charlotte aux fraises', 'plat de résistance', 'citron', 'bon marché', 'rapide', 'recette', 'orange', 'boudoir', 'fraises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'édulcorant', 'recettes', 'extrait de vanille', 'confiserie', 'faisselle'], 'Dessert', 6e4d7db2-9a40-4597-ab1e-a3ae6ed565b8, '2025-09-26T15:11:19.913528', [{'ingredient_id': 'e955a490-13e9-4bd0-874f-a80b4c576a6c', 'quantite': '30'}, {'ingredient_id': '0c89160a-ad74-465c-b12d-447d6836740a', 'quantite': '350 g'}, {'ingredient_id': 'f2d2191d-45e3-42e9-97ff-c3233f062aee', 'quantite': '300 g'}, {'ingredient_id': '7f9dc532-3cdc-4aa6-9922-19c9d78aef36', 'quantite': '1'}, {'ingredient_id': '9248861d-89fc-4672-967e-c0ad44b8ecd7', 'quantite': '1 cuillères'}, {'ingredient_id': '38a5df7c-43e9-4d8a-be29-0cd0d28afd3d', 'quantite': '2'}, {'ingredient_id': 'f970f96b-714f-4b76-b024-b982dc8723c7', 'quantite': '1'}, {'ingredient_id': 'dcd7748d-a624-4815-a915-219ef579402c', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33834, 'Utilisation des variétés de pomme de terre dans les recettes', 'pomme de terre', '0 min', ['Variétés de pommes de terre : 

AMANDINE: cuisson vapeur, en salade et rissolées. 

BELLE DE FONTENAY: cuisson vapeur, en salade et rissolées. 

CHARLOTTE: rissolées et plats mijotés. 

CHERIE: cuisson vapeur, en salade et en plats mijotés. 

FRANCELINE: rissolées et plats mijotés. 

NICOLA: en gratins. 

POMPADOUR: cuisson vapeur et en salade. 

RATTE: cuisson vapeur et plats mijotés. 

ROSEVAL: en salade, rissolées et en gratins. 

AGATA: plats mijotés et en gratins. 

AGRIA: en frites et en purée. 

BINTJE: en frites, en purée et en potage. 

ESTIMA: frites et en purée. 

MANON: purée et en potage. 

MONALISA: gratins en purée. 

SAMBA: au four en papillote. 
'], ['Spatule', 'Batteur électrique', 'Moule à tarte', 'Louche'], ['', 'testées', 'plat de résistance', 'rapide', 'très facile', 'recettes de cuisine', 'plat', 'entrée', 'dessert', 'recette', 'recettes', 'boisson', 'cuisine', 'cocktail', 'pomme de terre', 'confiserie', 'bon marché', 'Utilisation des variétés de pomme de terre dans les recettes'], 'Conseil', 7fac2430-18d4-4fcb-ac82-f186d441b9ee, '2025-09-26T15:11:25.825967', [{'ingredient_id': '8ae9c254-510f-4b7f-bc95-a4c8fecb38dc', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (19562, 'Crumble aux pommes et aux coings', 'farine, pomme, coing, beurre, cassonade, sel', '20 min', ['Couper les pommes et les coings en dés après les avoir épluchés et épépinés. Les faire revenir avec 40 g de cassonade dans 40 g de beurre pendant 15 min. ', 'Dans un saladier, mélanger à la fourchette, la cassonade restante avec la farine, 80 g de beurre et une pincée de sel pour obtenir une pâte sableuse. ', 'Préchauffer votre four à 210°C. ', 'Beurrer un plat, répartir les dés de coing et de pomme et les recouvrir avec la pâte. ', 'Faire cuire 30 min. ', 'Servir chaud dans le plat de cuisson.'], ['Tire-bouchon', 'Économe', 'Passoire', 'Mixeur'], ['facile', 'cassonade', 'recettes de cuisine', 'plat', 'cocktail', 'coing', 'plat de résistance', 'bon marché', 'crumble aux pommes', 'sel', 'recette', 'cuisine', 'Crumble aux pommes et aux coings', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:11:31.466733', [{'ingredient_id': '145f923e-2264-449c-96ff-25be814486d9', 'quantite': '150 g'}, {'ingredient_id': '7cb87b70-a0bd-47d5-885a-ccc9e7296d18', 'quantite': '500 g'}, {'ingredient_id': '00559c8e-74a6-4df6-b44c-b24b2f91a7d1', 'quantite': '500 g'}, {'ingredient_id': '5a360a79-0f8c-4b91-a554-8af6fad018cd', 'quantite': '130 g'}, {'ingredient_id': '59224795-80f2-4b27-99a0-6212b513da36', 'quantite': '120 g'}, {'ingredient_id': 'bb8c5a06-accd-4930-87e6-895ee6790541', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24635, 'Crumble aux pommes, aux poires', 'pomme, poire, beurre, sucre en poudre, amandes en poudre, farine, jus de citron, cannelle', '15 min', ['Allumer le four Th 8 (240°C), beurrer le plat allant au four. ', 'Peler et nettoyer les pommes, couper-les en morceaux, les faire revenir dans une pôele avec un peu de beurre 5 mn. ', 'Peler et nettoyer les poires couper-les en morceaux et les rajouter aux pommes, laisser cuire quelques minutes (3 mn) en remuant de temps en temps. ', 'Mettre les fruits dans le plat et verser le jus de citron par dessus. ', 'Mélanger la farine, le sucre et la poudre d''amande, ajouter le beurre mou coupé en morceaux. Mélanger le tout avec les doigts pour obtenir un sable un peu grossier. Parfumer de cannelle.', 'Etaler ce mélange sur les fruits en une couche régulière. ', 'Mettre au four et laisser cuire 20 à 25 mn. ', 'Servir tiède avec une crème fouettée, ou une crème anglaise ou bien avec une boule de glace à la vanille.'], ['Casserole', 'Spatule', 'Passoire'], ['cannelle', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'Crumble aux pommes', 'bon marché', 'crumble aux pommes', 'recette', 'sucre en poudre', 'cuisine', 'aux poires', 'jus de citron', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'poire', 'beurre', 'confiserie', 'pomme', 'amandes en poudre', 'farine'], 'Dessert', bc0f577f-04e2-4bcc-8003-ead22b9c44f0, '2025-09-26T15:11:37.921953', [{'ingredient_id': '7a002f9b-d701-4bf5-b37a-1e9a35417cc9', 'quantite': '5'}, {'ingredient_id': '9364cafd-af25-4d2d-890d-f75fe4e32d65', 'quantite': '4'}, {'ingredient_id': 'c8714c48-beb5-40a1-8ace-8dfed83ac046', 'quantite': '100 g'}, {'ingredient_id': '04f9d695-66dc-43d3-a54d-3fdb19e1786c', 'quantite': '100 g'}, {'ingredient_id': 'faf9043c-b6fb-4e93-bce8-2e6a3da55ef4', 'quantite': '70 g'}, {'ingredient_id': 'e4cd5812-f3c3-4b96-aa01-7a7b021df025', 'quantite': '150 g'}, {'ingredient_id': '6a440c68-4fc7-4a07-9331-b8a0c908e35a', 'quantite': ''}, {'ingredient_id': '82749718-aa37-4e16-8f6d-67b76d9e962d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (201305, 'Sorbet aux framboises', 'framboises, sucre, blanc d''oeuf', '10 min', ['Passer environ 1 min les framboises au micro-ondes (afin qu''elles se mélangent facilement dans le blender).', 'Elles seront encore un peu surgelées ce qui est normal et il faut qu''elles le soient.', 'Passer tous les ingrédients au mixeur blender, arrêter régulièrement le blender afin de tasser les framboises pour aider le mixeur a bien tout mélanger.', 'Une fois le mélange bien homogène, le mettre dans un récipient  et au congélateur jusqu’à obtention de la consistance souhaitée.'], ['Ouvre-boîte', 'Balance de cuisine', 'Presse-agrumes', 'Louche'], ['recettes de cuisine', 'Sorbet aux framboises', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'bon marché', 'framboises', 'rapide', 'recette', 'cuisine', 'blanc d''oeuf', 'sorbet', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:11:43.209063', [{'ingredient_id': '67ed1252-0f24-4e80-9bbf-86e49bb2a774', 'quantite': '300 g'}, {'ingredient_id': 'b1ca198b-3a9a-4ebd-9d40-e1930c208063', 'quantite': '50 g'}, {'ingredient_id': '221ede4f-b2f8-4cea-b37b-e03cb74c30c6', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31325, 'Muffins aux fraises et à la menthe', 'farine, sucre en poudre, sel, levure chimique, oeuf, lait, huile de tournesol, fraises, menthe, beurre', '10 min', ['1) Beurrez les moules. Tamisez la farine, le sel et la levure dans un saladier et creusez un puits. Dans un autre saladier, battez les oeufs, le sucre en poudre, le lait et l''huile. ', '2) Versez ce mélange dans la farine et incorporez rapidement. ', '3) Lavez les fraises, séchez-les, puis coupez-les en petits dés. Lavez et essorez les feuilles de menthes, puis hachez-les. ', '4) Incorporez le mélange à le pâte. ', '5) Répartissez le tout dans les moules en ne les remplissant qu''au 2/3 . ', '6) Enfournez à mi-hauteur et laissez cuire 20 à 25 mn. ', '7) Démoulez les muffins sur une grille dès le sortir du four et laissez-les complètement refroidir avant de les déguster.'], ['Pince de cuisine', 'Poêle', 'Rouleau à pâtisserie', 'Spatule'], ['recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'Muffins aux fraises et à la menthe', 'menthe', 'plat de résistance', 'huile de tournesol', 'oeuf', 'muffin', 'sel', 'moyen', 'recette', 'sucre en poudre', 'fraises', 'cuisine', 'lait', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:11:50.061618', [{'ingredient_id': 'd5768ce7-ff26-4a97-8995-72e7c6e07a8c', 'quantite': '250 g'}, {'ingredient_id': 'e597d593-7edc-413e-8b5c-9ddedfbb0abe', 'quantite': '180 g'}, {'ingredient_id': '1b98d38e-a9c2-4f7f-9dfe-07e9ab6b1f88', 'quantite': ''}, {'ingredient_id': '884c7da0-74ba-4ce7-969c-73ca91bab3cc', 'quantite': ''}, {'ingredient_id': '0fd328e8-9336-480a-8973-956e14fe0d4e', 'quantite': '2'}, {'ingredient_id': '9c7d91a7-201c-4ea6-9818-57c8c7d9cad6', 'quantite': '20 cl'}, {'ingredient_id': '16bc9441-d3aa-4770-a467-d8e477fd47f9', 'quantite': '15 cl'}, {'ingredient_id': '5fae525a-3ba1-4a12-a785-04e3a2bd67d6', 'quantite': '125 g'}, {'ingredient_id': '6993b5f4-eaba-419f-bced-316edb304f0a', 'quantite': '10'}, {'ingredient_id': '63fb6090-e3ef-4d99-ad8c-d42202dd8be3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22726, '''The'' tarte aux fraises', 'farine, beurre, sucre, jaune d''oeuf, eau, sel, lait, oeuf, farine, sucre, sucre vanillé, fraises', '15 min', ['PÂTE: 

Blanchir les jaunes et le sucre au fouet et détendre le mélange avec un peu d''eau.', 'Mélanger au doigt la farine et le beurre coupé en petites parcelles pour obtenir une consistance sableuse et que tout le beurre soit absorbé (!!! Il faut faire vite pour que le mélange ne ramollisse pas trop!).', 'Verser au milieu de ce "sable" le mélange liquide. 
Incorporer au couteau les éléments rapidement sans leur donner de corps.', 'Former une boule avec les paumes et fraiser 1 ou 2 fois pour rendre la boule + homogène. ', 'Foncer un moule de 25 cm de diamètre avec la pâte, garnissez la de papier sulfurisé et de haricots secs. 

Faire cuire à blanc 20 à 25 min, à 180°C (thermostat 6).', 'CRÈME PÂTISSIÈRE : 

Mettre le lait à  bouillir avec le parfum choisi (vanille ou autre).', 'Travailler l''oeuf avec le sucre jusqu''à ce que la pâte fasse le ruban, ajouter la farine. ', 'Verser le lait bouillant sur le mélange en tournant bien. ', 'Remettre dans la casserole sur le feu. 
Faire cuire en tournant très soigneusement. 
Retirer après ébullition.', 'Verser la crème sur le fond de tarte et disposer joliment les fraises coupées en 2.'], ['Spatule', 'Planche à découper', 'Poêle'], ['''The'' tarte aux fraises', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'eau', 'plat de résistance', 'tarte aux fraises', 'bon marché', 'jaune d''oeuf', 'sel', 'recette', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:11:57.089281', [{'ingredient_id': '37cc580e-df3a-40fe-ad64-6deef6f7832b', 'quantite': '250 g'}, {'ingredient_id': '1df78f54-24db-4f4e-b2dd-c31ced9de4ab', 'quantite': '125 g'}, {'ingredient_id': 'f0b9021c-6ad0-49b6-bdab-1283d5a2341c', 'quantite': '70 g'}, {'ingredient_id': '31f8267a-7208-4d63-aad5-5f6cdc406464', 'quantite': '2'}, {'ingredient_id': 'b7e72ef1-d0de-4a5d-85ee-aa176c174d67', 'quantite': '5 cl'}, {'ingredient_id': 'a02db759-6157-4b93-91bf-892e1a92fc90', 'quantite': '1'}, {'ingredient_id': '080add1d-09c3-4666-a683-cdf424a207c6', 'quantite': '25 cl'}, {'ingredient_id': '21e56e60-5ad0-466c-82cb-6d24c6cc3ddd', 'quantite': '1'}, {'ingredient_id': '8024ed88-9b5c-4aa0-a609-4ec64aba9d68', 'quantite': '30 g'}, {'ingredient_id': 'acd545ee-2ed3-4cfa-a5ab-e8aff6a646ac', 'quantite': '40 g'}, {'ingredient_id': '3e0f58ea-06e8-41a6-80c2-5c4769905c8a', 'quantite': '1'}, {'ingredient_id': 'e42bbf93-c916-4f97-8acf-3d140f6279b8', 'quantite': '500 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (212490, 'Smoothie fraise-menthe', 'fraises, sucre, lait, yaourt, menthe', '5 min', ['Assembler, mixer, servir frais !'], ['Louche', 'Économe', 'Passoire', 'Spatule'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'smoothies', 'menthe', 'plat de résistance', 'yaourt', 'bon marché', 'rapide', 'recette', 'Smoothie fraise-menthe', 'fraises', 'cuisine', 'lait', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Boisson', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:12:00.625427', [{'ingredient_id': '69821015-f436-4d76-a13f-5aa337af6e9a', 'quantite': '200 g'}, {'ingredient_id': '90c5ce7b-9554-4025-9dee-6f1fc473dcd4', 'quantite': '20 g'}, {'ingredient_id': '116a2c7c-0c38-4bb8-b542-4d8c9c38dc73', 'quantite': '20 cl'}, {'ingredient_id': 'd9f227b6-4053-4de0-a004-8845ea8ec73b', 'quantite': '2'}, {'ingredient_id': 'fc81ac68-5cf5-4679-8cf0-bb80c226f500', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (339648, 'Clafoutis myrtilles-framboises', 'oeuf, sucre, farine, lait, crème fraîche, sel, framboises, myrtilles, beurre', '15 min', ['Bien mélanger le sucre et les oeufs, le mélange doit blanchir.', 'Ajouter la farine, mélanger à nouveau.', 'Ajouter le lait, la crème et une pincée de sel.', 'Beurrer un moule peu profond. Laver les fruits si nécessaire puis les verser dans le moule.', 'Ajouter la pâte et préchauffer le four à 180°.', 'Enfourner le clafoutis et laisser cuire 45 min au moins. Selon le jus rendu par les fruits, la cuisson peut être plus longue. Vérifier que la pâte soit dorée et non liquide.'], ['Passoire', 'Pince de cuisine', 'Planche à découper'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'crème fraîche', 'plat de résistance', 'bon marché', 'oeuf', 'framboises', 'clafoutis', 'sel', 'recette', 'cuisine', 'lait', 'myrtilles', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'Clafoutis myrtilles-framboises', 'confiserie', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:12:04.029292', [{'ingredient_id': '692ee9fd-134e-42db-a06d-0b72d5e6950f', 'quantite': '4'}, {'ingredient_id': '33f82f6b-171d-49ad-bffe-9a05961212b4', 'quantite': '150 g'}, {'ingredient_id': '3f625d29-40cf-4933-9dc2-22b8eeb3b332', 'quantite': '100 g'}, {'ingredient_id': '4e88f4ec-82b9-48f1-a42f-8b725e9078f5', 'quantite': '400 ml'}, {'ingredient_id': 'f1b75a98-3556-4d3f-8c20-0d659db570d5', 'quantite': '2 cuillères'}, {'ingredient_id': '1d1c77ba-682d-4de4-8953-6782606ac139', 'quantite': ''}, {'ingredient_id': '7b512b34-731f-4b89-a110-840bea692661', 'quantite': '150 g'}, {'ingredient_id': 'cac73206-4be3-4848-bf17-0df53fd69f6c', 'quantite': '150 g'}, {'ingredient_id': '7f8c0931-06a5-42f3-9992-de91bfc690fd', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46774, 'Tiramisu fraises et speculoos', 'fraises, spéculoos, oeuf, sucre, mascarpone, vanille', '30 min', ['Lavez et équeutez les fraises. Réservez-en 6 pour le décor.', 'Détaillez le reste en petits morceaux.', 'Réservez.', 'Émiettez grossièrement les spéculoos dans un bol. Réservez.', 'Fouettez les jaunes d''œuf avec le sucre jusqu''à ce que le mélange blanchisse.', 'Ajoutez la vanille et le mascarpone et mélangez à l''aide du fouet.', 'Battez les blancs en neige. Incorporez-les délicatement au mélange précédent.', 'Pour le dressage (utilisez de préférence des coupes à dessert individuelles) :', 'Déposez une couche de fraises au fond de la coupe, ajoutez 1 couche de crème au mascarpone puis saupoudrez de spéculoos. Réservez.', 'Rajoutez une couche de fraises, puis de crème au mascarpone.', 'Réservez au frais pendant 2 heures.', 'Détaillez les fraises réservées en lamelles et déposez-les sur les coupes au moment de servir.'], ['Râpe', 'Planche à découper'], ['speculoos', 'recettes de cuisine', 'plat', 'cocktail', 'vanille', 'sucre', 'plat de résistance', 'Tiramisu fraises et speculoos', 'bon marché', 'oeuf', 'rapide', 'recette', 'fraises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'mascarpone', 'confiserie', 'spéculoos'], 'Dessert', a4123842-c5e8-459d-9235-7576878eb829, '2025-09-26T15:12:10.734503', [{'ingredient_id': '5902e313-00a7-4bff-a0a5-fb9fdbe2cbdb', 'quantite': '500 g'}, {'ingredient_id': 'd3dd7587-5d39-4146-895c-7b7885b37cac', 'quantite': '10'}, {'ingredient_id': '9727d643-4d87-4bea-b24b-9024418eacae', 'quantite': '4'}, {'ingredient_id': 'a0c8b955-6f92-499c-a52f-a2cfa96c048d', 'quantite': '100 g'}, {'ingredient_id': 'e2dc1d79-6571-4f17-8fc0-eb4fb630d4ea', 'quantite': '250 g'}, {'ingredient_id': 'a88fb9f5-2bcf-4f0b-86a6-2e8e74b45721', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16382, 'Bavarois à la framboise', 'framboises, coulis de framboise, fromage blanc, citron, gélatine, oeuf, sucre en poudre', '20 min', ['Faites ramollir les feuilles de gélatine dans un grand verre d''eau froide. Serrez-les entre vos mains pour en extraire l''eau. Pressez les citrons.', 'Dans une petite casserole, faites fondre sur feu très doux la gélatine dans le jus des citrons. Laissez tiédir.', 'Battez les blancs d''oeufs en neige ferme. Dans une terrine, mélangez au fouet le fromage blanc avec le sucre, deux jaunes d''oeufs, la gélatine tiédie. Ajoutez 500 g de coulis de framboise, puis incorporez délicatement les deux blancs montés en neige.', 'Versez la préparation à bavarois dans le moule. Placez le plat au réfrigérateur pendant 4 h.', 'Démoulez le bavarois en plongeant le fond du moule 5 secondes dans l''évier rempli d''eau chaude. Retournez le bavarois sur un plat de service.', 'Décorez de framboises. Servez le reste de coulis de framboises à part.', 'En hiver, des framboises surgelées feront aussi bien l''affaire.'], ['Presse-agrumes', 'Passoire', 'Économe'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'gélatine', 'plat de résistance', 'Bavarois à la framboise', 'fromage blanc', 'citron', 'oeuf', 'framboises', 'rapide', 'moyen', 'recette', 'sucre en poudre', 'cuisine', 'coulis de framboise', 'testées', 'entrée', 'dessert', 'boisson', 'bavarois', 'recettes', 'confiserie'], 'Dessert', a4e4e381-6de4-44b0-9df8-d66af127b8d2, '2025-09-26T15:12:15.420868', [{'ingredient_id': '43a552fe-704f-4ef3-acc2-3a8d8a7cefcf', 'quantite': '250 g'}, {'ingredient_id': '97b48718-dce0-49ed-adf1-05c2775f63d0', 'quantite': '600 g'}, {'ingredient_id': '038754ea-1dcf-4a16-a82a-6d01f0828aa4', 'quantite': '500 g'}, {'ingredient_id': '3f671b81-a22c-4aae-96b1-5043f122d319', 'quantite': '2'}, {'ingredient_id': '9b521a3e-54b6-473c-8491-7644de8fd185', 'quantite': '6'}, {'ingredient_id': '3659d9af-4488-49b8-b9da-0e400f71f57e', 'quantite': '2'}, {'ingredient_id': 'c5342d42-dec4-47c8-bf3e-0a73fbe9a69f', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228774, 'Cookie à la framboise', 'beurre tendre, sucre en poudre, oeuf, farine, amandes en poudre, framboises', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Mélanger dans un saladier le beurre, le sucre et l’œuf puis ajouter la farine et la poudre d''amande.', 'Ajouter les framboises, les incorporer avec un batteur ', 'Former des cookies sur une plaque beurrée, et enfourner au four à 180°C durant une quinzaine de minutes.'], ['Batteur électrique', 'Spatule', 'Économe', 'Ouvre-boîte'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'oeuf', 'framboises', 'beurre tendre', 'recette', 'Cookie à la framboise', 'sucre en poudre', 'cuisine', 'cookie', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'amandes en poudre', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:12:19.920665', [{'ingredient_id': '1ffa23bd-d5c6-4d38-b300-3639b14ce729', 'quantite': '150 g'}, {'ingredient_id': '797d6f49-e06b-47e1-99fc-2c82ed6dfd26', 'quantite': '250 g'}, {'ingredient_id': 'fd644adc-31c3-4941-8bd9-495d66ff8889', 'quantite': '1'}, {'ingredient_id': '5d9330db-2014-4739-8ca9-a22424e6fd33', 'quantite': '150 g'}, {'ingredient_id': '87f9f862-f84c-4400-ad2b-e34e8367eca4', 'quantite': '150 g'}, {'ingredient_id': 'd1eb4c18-01e8-4cee-8f4a-1ddc067b29b1', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (223633, 'Coulant au chocolat au coeur de framboise', 'crème dessert au chocolat, beurre, sucre, oeuf, farine, Confiture de framboise, framboises, sucre glace', '15 min', ['Préchauffez le four Thermostat 7 (210° C).', 'Faites fondre le chocolat et le beurre à la casserole ou au micro-onde.', 'Ajoutez le sucre, les œufs et la farine.', 'Versez la moitié de la préparation dans des moules beurrés ou des moules individuels en silicone. ', 'Déposez au centre une généreuse cuillère à soupe de confiture de framboise dans chaque moule, puis recouvrez du reste de la préparation au chocolat.', 'Faites cuire au four pendant 10/12 minutes suivant les fours. ', 'Laissez tiédir avant de déposer 2 framboises sur le coulant et saupoudrez de sucre glace.', 'Peut se servir avec une boule de glace.'], ['Tire-bouchon', 'Mixeur'], ['recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'bon marché', 'oeuf', 'framboises', 'rapide', 'coulant au chocolat', 'recette', 'Coulant au chocolat au coeur de framboise', 'Confiture de framboise', 'cuisine', 'testées', 'sucre glace', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'crème dessert au chocolat', 'beurre', 'confiserie', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:12:23.502584', [{'ingredient_id': '8598019f-1355-47e7-ba7f-8b3f63d1926a', 'quantite': '90 g'}, {'ingredient_id': 'e214f9b8-4226-4e19-846d-9692423f55d9', 'quantite': '95 g'}, {'ingredient_id': '99e25332-3d46-4672-be44-cf79e3b49030', 'quantite': '100 g'}, {'ingredient_id': '60b6a9f6-774d-467a-9801-7e0c6855bdc2', 'quantite': '3'}, {'ingredient_id': '5b7a3ad2-557a-45e2-8641-c7c269366986', 'quantite': '50 g'}, {'ingredient_id': 'ea6bff41-70a0-4e5b-9e3e-34fffbc3f299', 'quantite': ''}, {'ingredient_id': 'c6a52db2-4ee9-40dd-bd04-034667999abe', 'quantite': ''}, {'ingredient_id': 'a5920f73-dcc4-404b-8d03-cafce72e8ff8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40689, 'Gâteau aux pommes et au caramel salé', 'pomme, beurre, farine, oeuf, crème liquide, sucre, levure, sucre vanillé, cannelle, rhum', '25 min', ['Coupez les pommes en 4, puis en 8 quartiers.', 'Faites fondre 30 g de beurre avec 50 g de sucre, dans une poêle sur feu moyen. ', 'Laissez le caramel se faire, en surveillant bien.', 'Une fois fait, versez les pommes, et laissez cuire une dizaine de minutes. ', 'Pendant ces 10 min, versez le sucre vanillé, le rhum, et la cannelle.', 'Pendant ce temps, préparez la pâte avec 50 g de beurre, la farine, 2 oeufs, 80 g de sucre, et la levure. ', 'Mélangez, puis versez la crème liquide.', 'Beurrez un moule, et déposez les pommes avec leur jus de cuisson, dedans. ', 'Versez ensuite la pâte, et faites en sorte que les pommes soient bien imprégnées de cette pâte. ', 'Enfournez une première fois pour 25 min à 180°C (thermostat 6).', 'A la fin de cette cuisson, faites une "sauce" avec 40 g de beurre, 1 oeuf, et 50 g de sucre, et la verser sur le gâteau. ', 'Remettez au four pour 15 à 20 min.', 'Servir froid.'], ['Pince de cuisine', 'Rouleau à pâtisserie', 'Verre doseur', 'Moule à tarte', 'Poêle'], ['cannelle', 'sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'Gâteau aux pommes et au caramel salé', 'sucre', 'caramel', 'plat de résistance', 'bon marché', 'oeuf', 'rhum', 'levure', 'recette', 'crème liquide', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'farine'], 'Dessert', 3d853052-1038-4d1c-a483-f5e77d873b51, '2025-09-26T15:12:30.229877', [{'ingredient_id': 'ceedd7c8-70c5-41d6-b635-a112594701c7', 'quantite': '5'}, {'ingredient_id': '04233c1e-adf0-4370-a554-75eb59b251b9', 'quantite': '120 g'}, {'ingredient_id': '0d869162-ad15-4aed-b9a9-59683135e4eb', 'quantite': '120 g'}, {'ingredient_id': 'bfdf8fcb-4650-4529-856a-37a98ce2a2a0', 'quantite': '3'}, {'ingredient_id': 'cfba6a59-e80d-482d-aa0d-ceae8eeea3d4', 'quantite': '20 cl'}, {'ingredient_id': 'f3ae1aae-7416-405e-9c5c-96ac1753a654', 'quantite': '180 g'}, {'ingredient_id': '57746f53-971c-4cb5-acf7-223e42a2dc6f', 'quantite': '1'}, {'ingredient_id': 'd9ba6ccb-9287-4b4f-8d21-b1b2b4f26236', 'quantite': '1'}, {'ingredient_id': '02bf8fd9-eac2-45cd-985a-e6d7158229cb', 'quantite': ''}, {'ingredient_id': 'd82c8630-ac26-4401-8a4f-f4b9748b2075', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36022, 'Gâteau aux pommes russe (noisettes-chocolat)', 'beurre, sucre semoule, farine, levure chimique, oeuf, pomme, noisettes, chocolat noir, cannelle, rhum', '15 min', ['Battre les oeufs entiers avec le sucre, ajouter le beurre ramolli, puis les noisettes, la cannelle et le rhum. ', 'Ajouter le mélange farine-levure. A l''aide d''une cuillère en bois, rajouter le chocolat concassé en assez gros morceax ainsi que les pommes pelées et coupées en dés.', 'Mettre dans un moule à cake préalablement beurré et mettre au four à 175°C (thermostat 5-6) pendant 30 à 40 minutes.'], ['Râpe', 'Balance de cuisine'], ['cannelle', 'recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'gâteau au chocolat', 'plat de résistance', 'Gâteau aux pommes russe (noisettes-chocolat)', 'bon marché', 'oeuf', 'rhum', 'recette', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'noisettes', 'confiserie', 'pomme', 'sucre semoule', 'farine', 'chocolat noir'], 'Dessert', 3ceea35f-47fd-4eb3-b85c-d0aaedeb470a, '2025-09-26T15:12:34.905173', [{'ingredient_id': 'ce525fcd-9def-40bf-ba10-6be6b165f9f0', 'quantite': '250 g'}, {'ingredient_id': '526b1345-a3ac-426d-86ce-9c7a3e0456d4', 'quantite': '250 g'}, {'ingredient_id': '0fd20221-116a-4d1c-a66b-f98413233b18', 'quantite': '250 g'}, {'ingredient_id': 'b55b3f3a-bc4e-4a23-9a64-1fe7e334a192', 'quantite': '1'}, {'ingredient_id': '67b582b7-7424-4d2c-8e57-3c71875d78ef', 'quantite': '4'}, {'ingredient_id': 'fabe1224-1207-4d4e-b641-871f6844ebda', 'quantite': '3'}, {'ingredient_id': 'c12e9a7d-2cc1-4899-b36f-42fea71a7490', 'quantite': '50 g'}, {'ingredient_id': 'df3b491d-09cd-4f26-9830-23133214eab7', 'quantite': '50 g'}, {'ingredient_id': '98590fad-aeca-4552-bb77-f483be949b20', 'quantite': '1 cuillères'}, {'ingredient_id': '7e417188-36a6-4011-ad61-226c3622b653', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34873, 'Charlotte royale aux fraises et sa mousse coco / citron vert', 'oeuf, sucre, farine, fécule, confiture de fraises, liqueur de fraises, huile, crème anglaise, lait de coco, noix de coco, crème liquide, citron vert, gélatine, biscuit rose de Reims, fraises', '45 min', ['Préparer les biscuits roulés : préchauffer le four à 180°C. Recouvrir deux plaques anti-adhésive de papier sulfurisé. Séparer les blanc des jaunes. Blanchir au fouet les jaunes avec le sucre. Monter les blancs en neige, les incorporer aux jaunes sucrés en les alternant avec le mélange farine/fécule. ', 'Verser la pâte sur les 2 plaques anti-adhésive et enfourner 8 à 10 min. Il faut que le dessus soit légèrement doré. ', 'Une fois cuits, les sortir du four, poser un torchon humide dessus et les retourner pour que le torchon se retrouve en dessous. ', 'Imbiber les 2 biscuits d''alcool et les tartiner de confiture mélanger avec un peu d''alcool. ', 'Rouler les biscuits, les envelopper dans du film alimentaire et les mettre au frais 2 h. ', 'Préparer la mousse : ramollir la gélatine dans de l''eau tiède. Chauffer le lait de coco à frémissements, ajouter la gélatine essorée, bien mélanger au fouet. ', 'Incorporer la poudre de coco, le zeste de citron vert, la crème anglaise et le jus du citron. Mettre au frais 2 h. ', 'Une fois la mousse refroidie, incorporer la crème très froide montée en chantilly. ', 'Couper les biscuits en rondelles de 1 cm. Huiler un saladier rond (18 à 20 cm de diamètre), le tapisser de rondelles de biscuit. ', 'Verser la moitié de la mousse coco. Poser une couche de biscuits roses de Reims au milieu, remettre une couche de mousse coco et encore des biscuits roses. Recouvrir de biscuit roulé s''il en reste. ', 'Laisser prendre une nuit au réfrigérateur. ', 'Le lendemain, démouler la charlotte (tremper le moule 30 secondes dans de l''eau chaude). Poser sur un plat et décorer de fraises et de copeaux de chocolat blanc.'], ['Verre doseur', 'Ouvre-boîte', 'Mixeur'], ['moyenne', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'charlotte aux fraises', 'plat de résistance', 'oeuf', 'liqueur de fraises', 'confiture de fraises', 'moyen', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'Charlotte royale aux fraises et sa mousse coco / citron vert', 'boisson', 'recettes', 'confiserie', 'huile', 'farine', 'fécule'], 'Dessert', 1678cdc4-9439-4335-82b0-46b52c21e871, '2025-09-26T15:12:39.644344', [{'ingredient_id': '293d9b57-97e1-437f-8531-b4302b2f3eb4', 'quantite': '8'}, {'ingredient_id': 'da544257-2f2e-4338-bf12-7fd3b3d8046b', 'quantite': '200 g'}, {'ingredient_id': 'd2cf34ff-7bcf-4832-a46e-a2e930451e95', 'quantite': '100 g'}, {'ingredient_id': '29fdfb8c-04de-4113-a6f8-db2db91e06c6', 'quantite': '100 g'}, {'ingredient_id': 'f8f13f92-584d-4cb7-a68b-b77903869906', 'quantite': '400 g'}, {'ingredient_id': '19a11e5a-5cc4-499b-8deb-e2fe5e3d0eab', 'quantite': '10 cuillères'}, {'ingredient_id': '9e1c244f-930c-4b24-bded-c59fa43a6d16', 'quantite': '2 cuillères'}, {'ingredient_id': '6dde6462-194a-46ce-8c1b-959c9a11861a', 'quantite': '25 cl'}, {'ingredient_id': '08bb9277-872e-47c1-9cf8-af4f4ebc041e', 'quantite': '40 cl'}, {'ingredient_id': '7622d43b-054f-4ea3-ade7-5162d811b609', 'quantite': '6 cuillères'}, {'ingredient_id': '89196cbf-b9cc-4e1a-99cc-cbef5be65ad2', 'quantite': '25 cl'}, {'ingredient_id': '7c79138e-e3fc-42d8-84a9-2de0fa604417', 'quantite': ''}, {'ingredient_id': '4bb34aa4-3ca0-4882-9d41-f4c3d8b6f8f9', 'quantite': '5'}, {'ingredient_id': '66086fad-2180-4e53-886d-3e641a235a0b', 'quantite': '1'}, {'ingredient_id': '81aa9464-c62e-4e2b-81d3-8fdcfe0001d5', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34156, 'Délice aux framboises et aux fruits de la passion', 'oeuf, sucre, farine, coulis de framboise, coulis de fruits de la passion, gélatine, crème fraîche, gelée, gélatine, pâte d''amande, copeaux de chocolat blanc', '40 min', ['Pour la génoise : mélanger ferme le sucre et les jaunes d''oeuf (faire un peu blanchir).', 'Verser sur le mélange les deux blancs battus en neige et 60 g de farine. Incorporer délicatement le tout.', 'Verser dans un moule à manqué et cuire à 180°C (thermostat 6) pendant 10 min.', 'Pour les mousses : faire chauffer dans deux casseroles différentes le coulis de framboises et le coulis de fruits de la passion et mangues.', 'Ajouter 2,5 feuilles de gélatine (préalablement ramollies dans de l''eau froide) dans chacune des casseroles et mélanger jusqu''à ce qu’elles soient bien fondues. Verser dans deux bols et attendre que cela refroidisse.', 'Répartir enfin la crème fraîche battue en chantilly dans chacun des bols. Laisser raffermir un peu au frigidaire.', 'Monter le gâteau : disposer la génoise au fond d’un cercle à pâtisserie. Verser la mousse aux fruits de la passion puis celle aux framboises. Laisser toute une nuit au frais. ', 'Décor : le lendemain, chauffer la gelée de fruits rouges et y faire dissoudre la 1/2 feuille de gélatine (préalablement ramollie dans de l''eau froide). Glacer le dessus du gâteau au pinceau. Décorer le milieu d’une rose en pâte d’amandes et saupoudrer de fins copeaux de chocolat blanc.
Oter le cercle avant de servir (passer la lame d''un couteau sur les bords au préalable)!', 'N.B. Rose en pâte d''amande : confectionner 6 petits disques et un cône. Disposer chacun des disques autour du cône en les faisant se chevaucher (pour faire les pétales).'], ['Râpe', 'Fouet'], ['moyenne', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'oeuf', 'gâteaux aux fruits', 'rapide', 'moyen', 'Délice aux framboises et aux fruits de la passion', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'farine'], 'Dessert', f9413152-bdd9-42f4-bd93-d2c1171434fb, '2025-09-26T15:12:46.482929', [{'ingredient_id': '021bf697-9c89-4b2b-a241-0124000e8a47', 'quantite': '2'}, {'ingredient_id': 'bcffb820-60db-4fd1-b3ce-f8b68b1ce048', 'quantite': '60 g'}, {'ingredient_id': '5c24acf4-f5a5-450e-a3fa-63e767f1d3a9', 'quantite': '60 g'}, {'ingredient_id': 'af646580-dfd6-4dd1-853e-c5f7ec20c247', 'quantite': '250 g'}, {'ingredient_id': '5243e325-9648-409b-b4ec-a3ca2bd66fbb', 'quantite': '250 g'}, {'ingredient_id': '8e8a176f-fe3a-4138-8032-e6457b4feaa9', 'quantite': '5'}, {'ingredient_id': '9b1ca6ba-a4c8-41c6-9092-49ea48612d96', 'quantite': '350 g'}, {'ingredient_id': '6079f963-8b06-4470-9b35-a621076b099d', 'quantite': '35 g'}, {'ingredient_id': 'b2e5b2ea-3be7-4f20-b785-7dc86ec44f80', 'quantite': ''}, {'ingredient_id': '75f48364-ad42-4173-bb0f-115e6fc36073', 'quantite': ''}, {'ingredient_id': '4273a45c-64cb-4521-95ca-ac8d57ab63e5', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17140, 'Mille-feuilles aux fraises', 'pâte feuilletée, crème pâtissière, fraises', '30 min', ['Faire cuire à blanc les pâtes feuilletées en les ayant piquées avec une fourchette.', 'Préparer la crème pâtissière, qui doit être assez consistante (parfumer de vanille et kirsch, par exemple).', 'Poser une pâte sur le plat à dessert, puis badigeonner de crème et poser des fraises coupées en lamelles.', 'Recommencer et terminer la troisième avec des fraises coupées en deux.', 'Napper de glaçage (fait maison ou à défaut, acheté en sachet, dans lequel vous aurez ajouté le jus de 8 fraises que vous aurez fait cuire pour en extraire le jus, pour une belle couleur rose).', 'Placer au réfrigérateur et servir frais.'], ['Planche à découper', 'Spatule', 'Moule à tarte', 'Batteur électrique', 'Passoire'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'mille-feuille', 'plat de résistance', 'bon marché', 'Mille-feuilles aux fraises', 'recette', 'crème pâtissière', 'fraises', 'cuisine', 'testées', 'entrée', 'dessert', 'pâte feuilletée', 'boisson', 'recettes', 'confiserie'], 'Dessert', 31abfd3c-ca5b-4d31-8815-789cb248874e, '2025-09-26T15:12:52.327477', [{'ingredient_id': '43759a19-98d4-4d6e-beec-c3e7efa26626', 'quantite': '3'}, {'ingredient_id': 'f28425e9-21d3-402a-aeec-aeed925719c4', 'quantite': '1 l'}, {'ingredient_id': '31a6e78a-674d-41ed-a287-62d2bbe179c2', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (84332, 'Verrines de mousse de framboises et spéculoos', 'framboises, blanc d''oeuf, mascarpone, crème liquide, sucre vanillé, spéculoos', '20 min', ['Décongelez les framboises et saupoudrez-les d''un 1/2 sachet de sucre vanillé.', 'Montez les blancs en neige très ferme et ajoutez les framboises délicatement. Réservez au frais.', 'Montez la crème liquide en chantilly assez souple en y ayant incorporé le 2ème sachet de sucre vanillé. Ajoutez-y le mascarpone que vous aurez détendu à la cuillère préalablement. L''ensemble doit être souple mais assez épais. ', 'Mixez les spéculoos.', 'Disposez au fond des 6 verrines les miettes de spéculoos tout en réservant quelques miettes pour la fin puis une grosse cuillerée à soupe de mélange chantilly mascarpone.', 'Déposez dessus une couche de mousse de framboises. Finissez par quelques miettes de spéculoos et surmontez d''une fraise pour décorer. ', 'Mettez au frais pendant au moins une 1/2 journée.'], ['Casserole', 'Presse-agrumes', 'Moule à tarte'], ['sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'mousse fruits', 'plat de résistance', 'framboises', 'rapide', 'moyen', 'recette', 'crème liquide', 'cuisine', 'blanc d''oeuf', 'testées', 'Verrines de mousse de framboises et spéculoos', 'entrée', 'dessert', 'boisson', 'recettes', 'mascarpone', 'confiserie', 'spéculoos'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:12:55.820378', [{'ingredient_id': 'a44ae14b-5bbc-4793-888b-ad5d65805840', 'quantite': '250 g'}, {'ingredient_id': 'edc214ed-6056-421d-95e8-9b26517334fa', 'quantite': '1'}, {'ingredient_id': '73c2f1bd-157d-46bb-916b-478827f3a8d3', 'quantite': ''}, {'ingredient_id': '88f5be2d-647c-4322-b09e-b65025ba0d71', 'quantite': '1'}, {'ingredient_id': '8f4480b7-467c-409b-808a-7205b6cd00c7', 'quantite': '1'}, {'ingredient_id': '58ff24bb-cb7a-4e49-b4b8-fc0924e32bdd', 'quantite': '24'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55637, 'Gâteau d''anniversaire mousse chocolat-framboise', 'gâteaux, chocolat pâtissier, sucre en poudre, farine, levure chimique, beurre, pralin, jaune d''oeuf, blanc d''oeuf, jaune d''oeuf, blanc d''oeuf, sucre, chocolat pâtissier, framboises, chocolat, eau', '30 min', ['Préparation du gâteau :', 'Au micro-onde faire fondre le chocolat et le beurre. Une fois fondu, y ajouter un a un, les 3 jaunes d’œuf, la levure, la farine, le sucre et le pralin.', 'Battre les œufs en neige bien fermes et les incorporer au mélange.', 'Beurrer un moule à manquer et mettre au four thermostat 6 ou 180° pendant environ 30mn.', 'Pendant ce temps préparer la mousse au chocolat. ', 'Faire fondre au micro-onde le chocolat avec 3 à 4 cuillère à soupe d''eau.', 'Y ajouter ensuite un a un les jaunes d''oeufs et le sucre.', 'Battre les blancs en neige bien fermes et les ajouter au mélange. Laisser prendre au réfrigérateur pendant 1 heure.', 'Une fois, le gâteau refroidit, le couper en deux dans le sens de la longueur et le fourrer de crème au chocolat.', 'Ajouter une couche de framboise et recouvrir encore une fois de crème au chocolat.', 'Recouvrir pour finir du gâteau au chocolat.', 'Napper avec du chocolat fondu pour finir.'], ['Mixeur', 'Économe', 'Planche à découper', 'Spatule', 'Râpe'], ['recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'plat de résistance', 'Gâteau d''anniversaire mousse chocolat-framboise', 'bon marché', 'chocolat pâtissier', 'jaune d''oeuf', 'recette', 'sucre en poudre', 'cuisine', 'blanc d''oeuf', 'testées', 'très facile', 'entrée', 'dessert', 'mousse au chocolat', 'pralin', 'recettes', 'boisson', 'beurre', 'confiserie', 'gâteaux', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:13:00.511161', [{'ingredient_id': '4a058af1-c8e6-463f-b180-2829b5f39c21', 'quantite': ''}, {'ingredient_id': '041dd359-1961-4d33-a0ac-5c9b1e1d6b69', 'quantite': '100 g'}, {'ingredient_id': '1e019bc5-d6ba-4e67-82ca-a6213d22c4f4', 'quantite': '100 g'}, {'ingredient_id': '33ef94de-e1fb-4b8f-9505-c7f3eb12fa71', 'quantite': '40 g'}, {'ingredient_id': '79d223e3-ef24-4a5d-910b-18599498cef6', 'quantite': ''}, {'ingredient_id': 'f4763d5f-3eaa-4360-aa20-7aeb68c79f56', 'quantite': '100 g'}, {'ingredient_id': '341796e5-392f-49d1-8aa8-72f18ba53602', 'quantite': '100 g'}, {'ingredient_id': 'ec81bc8b-9149-4d82-8e2f-4889f9b6ad8a', 'quantite': '3'}, {'ingredient_id': '1a105dd0-676c-4f66-9bea-13c4561246b7', 'quantite': '3'}, {'ingredient_id': '5cb2a0af-7207-46a5-805d-b106c9713238', 'quantite': '3'}, {'ingredient_id': '6c98f1ce-352f-464b-86cd-d6ccea492d2e', 'quantite': '3'}, {'ingredient_id': '4127da4f-69db-4d59-a5b1-82e9e5618903', 'quantite': '75 g'}, {'ingredient_id': '3254ac7d-d1e8-4563-b431-513133e7c93e', 'quantite': '75 g'}, {'ingredient_id': '6bba3145-dcbe-485a-be22-989bbdfbf7c4', 'quantite': '75 g'}, {'ingredient_id': '46ddc238-77ac-49a4-b3b5-184c74dba097', 'quantite': '30 g'}, {'ingredient_id': 'dc0e9771-874d-4fd9-b06e-78a343ab3772', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (60079, 'Meringue roulée aux fraises et aux amandes', 'blanc d''oeuf, sucre, vanille, crème fraîche épaisse, fraises, amandes effilées', '20 min', ['Préchauffer le four à 220°C (thermostat 7).', 'Monter les oeufs en neige et ajouter cuillère par cuillère le sucre pour obtenir une belle meringue.', 'Mettre du papier sulfurisé sur une plaque et la huiler légèrement. Y déposer la meringue et l''étaler sur toute la surface de façon homogène. Eparpiller les amandes sur la meringue.', 'Enfourner pendant 8 min (jusqu''à ce que le dessus soit brun). Baisser la température à 160°C (thermostat 5-6) et laisser pendant 10 min (jusqu''à ce que le dessus soit ferme).', 'Disposer du papier sulfurisé sur un plat de service. Sortir la meringue du four, la retourner sur ce plat et laisser refroidir.', 'Fouetter la crème en la parfumant avec la vanille liquide.', 'Retirer le papier cuisson de la meringue et verser la crème fouettée dessus. Puis y déposer les fraises coupées en petits morceaux. Rouler ensuite l''ensemble en s''aidant du papier cuisson et entreposer au réfrigérateur au moins pendant 1 heure.'], ['Spatule', 'Râpe', 'Passoire', 'Presse-agrumes'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'vanille', 'sucre', 'plat de résistance', 'Meringue roulée aux fraises et aux amandes', 'bon marché', 'meringues', 'recette', 'crème fraîche épaisse', 'fraises', 'cuisine', 'amandes effilées', 'blanc d''oeuf', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', 444fcbe9-9d96-44ca-9ef1-d9ea26b42f1a, '2025-09-26T15:13:06.476575', [{'ingredient_id': 'ef0d0155-72f7-4470-aa3a-49b344553c6e', 'quantite': '4'}, {'ingredient_id': 'dac31cf0-6591-4f2b-b333-bc647cae7598', 'quantite': '250 g'}, {'ingredient_id': '4334f801-b47c-435c-b765-4acd98cb5968', 'quantite': ''}, {'ingredient_id': '9ae995c8-e6a2-48c8-a0fe-e59d15dc600f', 'quantite': '30 cl'}, {'ingredient_id': '2165d381-28c3-4657-a5a8-871f0f4bff12', 'quantite': '300 g'}, {'ingredient_id': 'e913fc15-6e58-49fb-a5ed-d2896158dce3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62875, 'Tiramisu aux framboises (façon entremets)', 'sucre, farine, oeuf, mascarpone, oeuf, biscuits à la cuillère, sucre, gélatine, framboises, framboises, eau de fleur d''oranger', '60 min', ['Préparer la génoise.', 'Mélanger le sucre avec les jaunes d''oeuf jusqu''à blanchissement.', 'Monter les blancs ferme.', 'Incorporer délicatement les blancs dans les jaunes sucrés.', 'Verser la pâte sur du papier sulfurisé dans le plat en verre ou le cercle (20 cm) qui servira à monter le gâteau. Faire cuire 10 min au four à 200°C (thermostat 6-7).', 'Laisser refroidir la génoise, la couper en deux dans le sens de l''épaisseur et reposer dans le cercle les 2 moitiés l''une sur l''autre faces ouvertes sur le dessus..', 'Imbiber avec un tiers du jus de framboise.', 'Préparer la mousse de mascarpone : séparer les blancs et les jaunes d''oeufs. Laisser tremper les feuilles de gélatine dans de l''eau froide.', 'Faire chauffer le sucre jusqu''à quelques dizaines de secondes après l''ébullition.', 'Hors du feu, ajouter les feuilles de gélatine essorées, laisser fondre puis ajouter la fleur d''oranger. Incorporer le tout dans les jaunes, fouetter la préparation jusqu''à refroidissement', 'Incorporer ensuite le mascarpone.', 'Monter les blancs en neige très ferme, les incorporer délicatement à la préparation.', 'Disposer les framboises sur la génoise, puis une première couche de mousse sur la génoise, puis une couche de biscuits trempés imbibés de jus de framboise et terminer par une couhe de mousse.', 'Laisser reposer au réfrigérateur 4 à 6 heures avant de servir.'], ['Économe', 'Passoire', 'Batteur électrique', 'Poêle'], ['moyenne', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'bon marché', 'oeuf', 'Tiramisu aux framboises (façon entremets)', 'tiramisu', 'rapide', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'farine'], 'Dessert', ff60ad22-21c0-4183-a3e6-dcf0eb1ae512, '2025-09-26T15:13:10.018678', [{'ingredient_id': '8ce790fa-f2e6-43dd-b7e5-ea5505e1d9fe', 'quantite': '60 g'}, {'ingredient_id': 'a6975f6c-b1b5-4878-8ecc-f3bc4a2c08d9', 'quantite': '60 g'}, {'ingredient_id': '05091799-5c16-4fc2-b94d-dc2925e67668', 'quantite': '2'}, {'ingredient_id': '94720e38-415a-480e-9d98-c83a8446e5a3', 'quantite': '500 g'}, {'ingredient_id': '284a3e78-bfc4-4f83-a1da-f65419ab55de', 'quantite': '4'}, {'ingredient_id': 'b803ff63-5b2f-4eb7-b585-0ccef30d1973', 'quantite': '10'}, {'ingredient_id': 'f224a369-10bf-4350-a2a4-40337568b690', 'quantite': '50 g'}, {'ingredient_id': 'afd27e5f-1e98-4863-b122-b44c5fb90578', 'quantite': '3'}, {'ingredient_id': '228bacf5-1780-4d82-8457-b88373c97d7b', 'quantite': '125 g'}, {'ingredient_id': '4536201c-4b8c-44cb-b626-0dce0d349f56', 'quantite': '30 cl'}, {'ingredient_id': '5e6401d2-d45f-42c0-acce-7084015ab6be', 'quantite': '15 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29221, 'Amour de fraises', 'fraises, chocolat pâtissier, beurre', '15 min', ['Nettoyer et équeuter les fraises. Couper le bout de chaque fraise côté feuille, afin de pouvoir les poser à plat. ', 'Faire fondre le chocolat et le beurre au bain-marie et laisser refroidir ensuite un petit quart d''heure. ', 'Tremper la moitié de chaque fraise dans le chocolat, et les déposer dans un plat, en les piquant d''un cure-dent (ce qui permettra de les prendre par la suite sans se salir les doigts). ', 'Mettre au frigo au moins 2 ou 3 heures.'], ['Fouet', 'Moule à tarte', 'Balance de cuisine'], ['', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'chocolat pâtissier', 'Amour de fraises', 'rapide', 'recette', 'fraises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie'], 'Dessert', 7fac2430-18d4-4fcb-ac82-f186d441b9ee, '2025-09-26T15:13:13.548986', [{'ingredient_id': '709a412b-86cf-4f32-93bf-ee3b2816a6f2', 'quantite': '20'}, {'ingredient_id': 'd4c0fdce-bdde-4bf1-b88d-94929b624cf5', 'quantite': '200 g'}, {'ingredient_id': '32f7eb37-334a-4cdf-aaab-999fce3c651b', 'quantite': '25 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34252, 'Tarte aux framboises façon crumble', 'pâte sablée, framboises, amandes en poudre, sucre, oeuf, beurre, farine, sucre, beurre, jaune d''oeuf, sel', '45 min', ['Étaler la pâte sablée dans un moule à tarte, puis y disposer dans cet ordre la crème d''amande, les framboises et enfin la pâte à crumble. ', 'La pâte à crumble n''est pas homogène, elle forme des petits amas, il faut donc la disposer avec les mains pour une répartition homogène. ', 'Cuisson : 180°C - 35 à 45 min. ', 'Servir la tarte tiède.'], ['Moule à tarte', 'Tire-bouchon', 'Presse-agrumes'], ['framboises', 'testées', 'plat de résistance', 'facile', 'moyen', 'recettes de cuisine', 'plat', 'entrée', 'dessert', 'tarte aux framboises', 'recettes', 'recette', 'boisson', 'cocktail', 'confiserie', 'cuisine', 'pâte sablée', 'Tarte aux framboises façon crumble'], 'Dessert', ca56c2a0-5918-4d49-a73b-e8d909304459, '2025-09-26T15:13:19.191245', [{'ingredient_id': 'dc630056-5fae-46a4-a134-667a6510ff24', 'quantite': '1'}, {'ingredient_id': 'd9450ff0-b905-4f91-baff-878e07bab742', 'quantite': '500 g'}, {'ingredient_id': 'f8f9fd08-30fc-466e-9583-c08c70c66adb', 'quantite': '125 g'}, {'ingredient_id': 'a01b2cc0-43da-4a6c-aa92-d86c3705c4a3', 'quantite': '100 g'}, {'ingredient_id': 'ed9e5306-cc50-48d7-a2dc-c70ddeaeb055', 'quantite': '2'}, {'ingredient_id': '57418aa5-7077-460a-b5be-df619bce4016', 'quantite': '100 g'}, {'ingredient_id': '8d39fdf1-1f58-405f-9d57-06e30f08516f', 'quantite': '100 g'}, {'ingredient_id': '7ef61e7e-4d2c-44b2-b230-0265a86da830', 'quantite': '50 g'}, {'ingredient_id': '790071ce-c5ef-4917-8ff1-3c3624326990', 'quantite': '50 g'}, {'ingredient_id': '66a85088-4574-40d0-98a4-cff20e03b922', 'quantite': '1'}, {'ingredient_id': 'c5b277ca-460f-4e4c-b6ed-98f87707c0be', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14804, 'Galette de pommes de terre polonaise', 'pomme de terre, farine, oeuf, poivre, sel', '15 min', ['Epluchez et râpez les pommes de terre finement.', 'Enlevez l''eau rendue avec une cuillère, puis y ajouter la farine, l''oeuf, le sel et le poivre si on veut manger les galettes salées (ne pas mettre de poivre et très peu de sel si l''on désire les manger sucrées).', 'Chauffez de l''huile dans une poêle et avec une cuillère à soupe faire des petits tas que l''on étale, les faire frire des deux côtés.'], ['Passoire', 'Économe', 'Tire-bouchon', 'Poêle'], ['recettes de cuisine', 'plat', 'cocktail', 'galette de légumes', 'plat de résistance', 'bon marché', 'oeuf', 'rapide', 'sel', 'recette', 'cuisine', 'poivre', 'testées', 'très facile', 'Galette de pommes de terre polonaise', 'entrée', 'dessert', 'boisson', 'recettes', 'pomme de terre', 'confiserie', 'farine'], 'Plat principal', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:13:24.904699', [{'ingredient_id': '3f51fb3a-e42d-4245-bc49-ce3833f7f1b3', 'quantite': '3'}, {'ingredient_id': '94e7fc3b-5b01-4d66-b871-34da33512e61', 'quantite': '1'}, {'ingredient_id': 'c0e519b6-25eb-475a-b549-997389f58911', 'quantite': '1'}, {'ingredient_id': '100b5874-10eb-41d5-a51e-43a5e6b3ab55', 'quantite': ''}, {'ingredient_id': '67f410ad-7edd-4b77-823b-f153d2c14f34', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58018, 'Verrines douceur de fraises', 'fraises, yaourt, sucre vanillé, sucre en poudre, vinaigre balsamique, pistaches', '10 min', ['Passer rapidement les fraises sous l''eau et les équeuter.', 'Couper les fraises en très petits dés.', 'Prélever une poignée de dés de fraises, les mettre dans une casseroles avec le sucre en poudre et le vinaigre balsamique. ', 'Mouiller d''eau à hauteur et laisser bouillir jusqu''à ce que les dés de fraises s''écrasent bien et que la sauce ai une consistance sirupeuse (environ 10 minutes).', 'Attention, ça déborde vite!', 'Pendant ce temps, fouetter le yaourt avec le sucre vanillé et réserver au frais.', 'Quand le sirop est cuit, le passer dans une passoire fine ou un chinois en écrasant bien pour récupérer tout le jus.', 'Laisser tiédir le jus et le verser sur les dés de fraises.', 'Réserver au frais.', 'Mettre du yaourt vanillé dans les verrines à hauteur de la moitié et disposer les dés de fraises (avec un peu de jus) dessus.', 'Parsemer de pistaches concassées.'], ['Tire-bouchon', 'Batteur électrique', 'Verre doseur', 'Fouet'], ['', 'Verrines douceur de fraises', 'sucre vanillé', 'recettes de cuisine', 'plat', 'cocktail', 'pistaches', 'vinaigre balsamique', 'plat de résistance', 'yaourt', 'bon marché', 'rapide', 'recette', 'sucre en poudre', 'fraises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', 1f397bb2-9bd2-40b6-8538-ad2054a15064, '2025-09-26T15:13:28.420611', [{'ingredient_id': '2926efb1-8d5a-4c36-93c3-d4448699112f', 'quantite': '2'}, {'ingredient_id': '1b04b8f2-c016-4dbd-8f23-91002bbaa3e4', 'quantite': '4'}, {'ingredient_id': '9652e7e4-5dde-481f-a251-00899facf1f8', 'quantite': '2'}, {'ingredient_id': '3801ff75-79d2-4cc3-8433-321c53785380', 'quantite': '2 cuillères'}, {'ingredient_id': '65baa7de-b560-4324-9346-7fe9009d4a8d', 'quantite': '1 cuillères'}, {'ingredient_id': '450ef3cc-d709-4283-be17-0276195265ab', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22004, 'Milk shake à la framboise', 'framboises, lait, sucre glace, glaçons', '10 min', ['Mixer la totalité des ingrédients. ', 'Répartir dans deux verres. ', 'Déguster!'], ['Tire-bouchon', 'Louche', 'Verre doseur'], ['', 'Milk shake à la framboise', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'framboises', 'rapide', 'recette', 'glaçons', 'cuisine', 'lait', 'testées', 'sucre glace', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Boisson', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:13:33.039257', [{'ingredient_id': '551ea897-5238-466e-ac48-cb850b80becd', 'quantite': '100 g'}, {'ingredient_id': '564b5ad8-d1cf-4565-a33d-ea8e06dbdd4e', 'quantite': '25 cl'}, {'ingredient_id': '79053db9-877e-4df1-869e-b3cc8a98d9ad', 'quantite': '1 cuillères'}, {'ingredient_id': '9dea3759-6495-4428-8c0d-39d25cfd6277', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12315, 'Galettes de pommes de terre', 'pomme de terre, farine, oeuf, oignon, ciboulette, huile', '20 min', ['Epluchez et lavez les pommes de terre. Râpez-les très finement avec les oignons. Enlevez l''eau en pressant dans les mains.', 'Mettez-les dans une terrine. Ajoutez sel, poivre, farine, l''oeuf, ainsi que la ciboulette ciselée.', 'Façonnez à la main des galettes de 1 cm d''épaisseur avec cette préparation.', 'Faites frire à l''huile  des deux côtés, dans une poêle bien chaude, 10 minutes de chaque côté.'], ['Pince de cuisine', 'Économe', 'Spatule', 'Planche à découper'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'galette de légumes', 'plat de résistance', 'ciboulette', 'bon marché', 'oeuf', 'farine', 'oignon', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'pomme de terre', 'confiserie', 'huile', 'Galettes de pommes de terre'], 'Plat principal', 8079beef-1d58-4fa1-9ccb-0cffeebd6449, '2025-09-26T15:13:39.766646', [{'ingredient_id': 'e5eb97d6-7b6c-44bb-8ed9-1165c4d35174', 'quantite': '6'}, {'ingredient_id': '856ece4f-7ac9-4d62-bdb9-f5f1d753c715', 'quantite': '2 cuillères'}, {'ingredient_id': 'b3894fbf-0dc6-40f9-9fb0-77d71b9d1f12', 'quantite': '1'}, {'ingredient_id': '894ba87f-f02c-414e-ba5b-177bde11d07c', 'quantite': '2'}, {'ingredient_id': '30f320c5-d3df-45c3-97d5-6ecaaa23ae13', 'quantite': '1'}, {'ingredient_id': 'f308f7b8-2cdc-4562-b2ac-1e8cec60fffb', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (201187, 'Tiramisu glacé à la fraise', 'crème épaisse, fraises, biscuits à la cuillère, glace fraise, sucre vanillé', '5 min', ['Battez la crème à l''aide d''un fouet, avec une pincée de sucre pour la rendre onctueuse.', 'Disposez deux biscuits à la cuillère cassés dans un verre, imbibez-les avec le jus de fraise.', 'Disposez une cuillère de crème fouettée puis couvrez avec une boule de glace à la fraise.', 'Saupoudrez le tout de sucre vanillé.'], ['Louche', 'Presse-agrumes', 'Verre doseur'], ['sucre vanillé', 'recettes de cuisine', 'plat', 'cocktail', 'glace fraise', 'plat de résistance', 'Tiramisu glacé à la fraise', 'biscuits à la cuillère', 'bon marché', 'tiramisu', 'rapide', 'recette', 'fraises', 'crème épaisse', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:13:43.357352', [{'ingredient_id': 'bdbd50fc-591a-409a-91db-812862b3cb51', 'quantite': '1 cuillères'}, {'ingredient_id': '0f3ee24e-3b24-48bf-bb07-4ef9951c4e05', 'quantite': '15 cl'}, {'ingredient_id': 'd77fd75e-5447-4c1c-a0f9-affd5025223a', 'quantite': '2'}, {'ingredient_id': '7a22e1e4-5b2d-4855-834c-c6296fcfdd36', 'quantite': '1'}, {'ingredient_id': '27b82ea3-29ae-47e7-9d0f-230c04c5852e', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30031, 'Crumble pommes et framboises', 'pomme, framboises, sucre de canne, farine, amandes en poudre, beurre, crème fraîche, caramel, cannelle, vanille', '15 min', ['Peler vos pommes, ôter les pépins et les couper en dés.', 'les mettre dans une poêle avec le caramel liquide et faire chauffer à feu doux, puis verser la cannelle et la vanille.', 'Placer dans un plat rectangulaire et y ajouter les framboises. Recouvrir de crème (facultatif).', 'Préchauffer le four à thermostat 6/7 (200°C).', 'Dans un saladier, mélanger le sucre, la farine et la poudre d''amande.', 'Couper le beurre ramolli en petit dés et le rajouter à la préparation sucre-farine. Malaxer avec les mains jusqu''à obtenir des miettes de pâte que vous mettrez sur les fruits.', 'Cuire au four 30 min (à surveiller).'], ['Spatule', 'Louche'], ['cannelle', 'recettes de cuisine', 'plat', 'cocktail', 'vanille', 'crème fraîche', 'caramel', 'plat de résistance', 'bon marché', 'crumble aux pommes', 'Crumble pommes et framboises', 'framboises', 'recette', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'sucre de canne', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'amandes en poudre', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:13:47.974597', [{'ingredient_id': '14b8c46d-09ab-4917-8f6d-5580f99a5282', 'quantite': '6'}, {'ingredient_id': '7b2afe6b-ae64-4d30-a0fa-4069f56dc5f4', 'quantite': '200 g'}, {'ingredient_id': '947b3e02-739b-4118-8812-4dcbe92add72', 'quantite': '150 g'}, {'ingredient_id': '86e607b2-69b9-4c87-afb5-2f34fc3b9ca7', 'quantite': '200 g'}, {'ingredient_id': '673d0257-258c-4264-ac6a-7cc5329fc4b6', 'quantite': '50 g'}, {'ingredient_id': '5907e125-0b93-42eb-bbae-6aace9becf7b', 'quantite': '125 g'}, {'ingredient_id': '9604737e-b944-4607-a88a-1381142ba93a', 'quantite': '20 cl'}, {'ingredient_id': '6e2da33f-b6e7-45df-af56-22e9e39ef74c', 'quantite': ''}, {'ingredient_id': '7e9975a9-6fff-437f-8934-ec8623d91e9f', 'quantite': '1 cuillères'}, {'ingredient_id': '1fc87ae2-328b-4e15-94fb-bf37595f5883', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16651, 'Crumble au chocolat, pommes et framboises', 'pomme, chocolat noir, framboises, farine, sucre en poudre, beurre tendre', '15 min', ['Laver, peler et couper les pommes en cubes.', 'Dans un saladier, mélanger la farine, le sucre et le beurre du bout des doigts pour obtenir une pâte sableuse.', 'A l''aide d''un grand couteau, hacher le chocolat en pépites puis les mélanger à la préparation.', 'Répartir les cubes de pommes dans le fond du plat et disposer les framboises par dessus et enfin recouvrir avec la pâte à crumble.', 'Faire cuire dans la partie basse du four environ 20 mn.'], ['Verre doseur', 'Pince de cuisine', 'Planche à découper', 'Presse-agrumes'], ['recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'pommes et framboises', 'crumble aux pommes', 'framboises', 'beurre tendre', 'recette', 'sucre en poudre', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'Crumble au chocolat', 'confiserie', 'pomme', 'farine', 'chocolat noir'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:13:53.853049', [{'ingredient_id': 'e21da8b1-8e88-47d8-a00c-1f6d2ad017d9', 'quantite': '3'}, {'ingredient_id': '155985e7-4fcc-4dff-b30d-a997fde00389', 'quantite': '200 g'}, {'ingredient_id': 'a53d11f1-e533-4267-b4bd-35af5f47bc75', 'quantite': '150 g'}, {'ingredient_id': '9b085f12-a3ce-48d7-8ea4-f10994208572', 'quantite': '250 g'}, {'ingredient_id': '33aa0db2-0e2e-4409-80d4-4c0da788dbb4', 'quantite': '125 g'}, {'ingredient_id': '93c74e29-f909-4ca7-a143-e64fa0cabdb2', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (71617, 'gâteau aux fraises et chocolat', 'fraises, chocolat, beurre, oeuf, sucre, crème fraîche, farine, levure, crème fleurette, sucre vanillé, sel', '20 min', ['Porter la crème à ébullition, ajouter le chocolat et 40 g de beurre en morceau. Fouetter et réfrigérer. ', 'Préchauffer le four à 200°, thermostat 6-7. ', 'Faire ramollir le reste de beurre. ', 'Fouetter les œufs et le sucre, ajouter la farine et la levure tamisée. Ajouter une pointe de sel et le beurre mou. Mélanger jusqu’à obtention d’une pâte lisse. ', 'Beurrer un moule à gâteau rond. Verser la pâte, enfourner pendant 35 à 40 min.', 'Rincer et équeuter les fraises. Mettre 10 fraises de côté pour la déco. Couper les fraises en fines tranches. ', 'Couper le gâteau en deux rectangles égaux. Sur le premier, étaler la moitié de chocolat (sortie du frigo), puis une tranche de fraises puis sur le deuxième, étaler le reste du chocolat. Poser les biscuits.', 'Fouetter la crème fleurette en chantilly, ajouter le sucre vanillé.', 'Décorer le gâteau avec la chantilly  et les fraises restantes. ', 'Mettre au frais pendant au moins 1 h.'], ['Poêle', 'Presse-agrumes', 'Louche', 'Rouleau à pâtisserie', 'Casserole'], ['sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'gâteau au chocolat', 'sucre', 'crème fraîche', 'plat de résistance', 'chocolat', 'bon marché', 'oeuf', 'sel', 'levure', 'recette', 'fraises', 'crème fleurette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'gâteau aux fraises et chocolat', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:13:57.483775', [{'ingredient_id': '68cd904d-5e57-46e6-b06e-84321bf94938', 'quantite': '500 g'}, {'ingredient_id': '20a1ad36-666c-410c-8ef5-852988bcf29a', 'quantite': '300 g'}, {'ingredient_id': 'd3f0a5c7-3e3e-4b02-842e-214b9116b068', 'quantite': '200 g'}, {'ingredient_id': 'e8bb0a8c-4671-4820-b642-adfcfd97a84d', 'quantite': '4'}, {'ingredient_id': '195889a0-ac97-48e4-ac02-f662332ff2ac', 'quantite': '150 g'}, {'ingredient_id': 'bfed8a46-3c7d-463b-918e-85528a4d6ef2', 'quantite': '20 cl'}, {'ingredient_id': '53075446-71c0-4221-b3fa-c1153b7d7336', 'quantite': '250 g'}, {'ingredient_id': 'a5c171da-a768-4824-a026-581082bd7f02', 'quantite': '1'}, {'ingredient_id': '61ab15e1-920f-4fdb-b250-fb9820733272', 'quantite': '40 cl'}, {'ingredient_id': '35907f7d-6a66-4279-b067-c9f220b60e1c', 'quantite': '2'}, {'ingredient_id': '96e65fe4-9ca5-4ec2-bd91-dd65e099486b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22232, 'Pommes dauphines', 'pomme de terre, farine, beurre, eau, oeuf, sel, huile de friture', '30 min', ['Faites cuire les pommes de terre à l''eau bouilante salée environ 30 minutes (selon la taille).', 'Pendant ce temps, préparez la pâte à choux : portez à ébullition 10 cl d''eau avec le beurre.', 'Salez et versez d''un coup la farine, remuez énergiquement à la cuillère en bois jusqu''à ce que la pâte se détache des birds de la casserole.', 'Laissez tiédir puis ajoutez les oeufs un à un, en mélangeant bien à chaque fois.', 'Egouttez et pelez les pommes de terre, écrasez-les en purée fine et ajoutez-les à la pâte à choux. Salez et poivrez, puis laissez refroidir.', 'Formez ensuite des petites boules de la taille d''une noix avec vos mains farinées, ou utilisez une poche à douille.', 'Jetez-les dans l''huile de friture bien chaude par petites quantités et laissez dorer 1 min environ.'], ['Casserole', 'Balance de cuisine'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'Pommes dauphines', 'pommes sautées', 'eau', 'plat de résistance', 'huile de friture', 'oeuf', 'sel', 'moyen', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'pomme de terre', 'confiserie', 'farine'], 'Plat principal', bf62113a-9f1d-4743-bcba-ace93a0adb1e, '2025-09-26T15:14:04.182703', [{'ingredient_id': '49719a71-5d40-4ece-8273-6df2fc5d0778', 'quantite': '500 g'}, {'ingredient_id': '8b1795a3-8b9e-4169-98b6-eabcd27dd574', 'quantite': '125 g'}, {'ingredient_id': 'd6e25d2c-a44d-4e06-ab22-10160b562954', 'quantite': '75 g'}, {'ingredient_id': '643bed3c-4a98-4384-a7bf-c401f3d99d24', 'quantite': '100 g'}, {'ingredient_id': 'b689c271-f7b9-4863-9bf1-47ab84603d63', 'quantite': '4'}, {'ingredient_id': 'b1b1d0aa-7390-44f8-983c-031745efceb0', 'quantite': ''}, {'ingredient_id': 'e0bff785-d4e5-4f7b-af2f-fb1b4f8ec935', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12358, 'Mousse aux framboises', 'framboises, sucre, crème fraîche, oeuf, lait, gélatine', '30 min', ['Faire ramollir la gélatine dans un bol d''eau froide. Réduire les framboises en purée, les mettre dans une casserole sur feu doux et ajouter le sucre.', 'Lorsque le jus de framboises est chaud, retirer la casserole du feu (ne pas le porter à ébullition).', 'Essorer la gélatine et la mettre à fondre dans le jus de framboises chaud. Laisser le mélange refroidir complètement.', 'Fouetter la crème bien froide avec le lait afin d''obtenir une consistance assez épaisse (le fouet doit laisser des sillons dans la crème). Réserver au frais.', 'Séparer les blancs des jaunes. Battre les blancs en neige ferme.', 'Verser le jus de framboises petit à petit dans la terrine contenant la crème. Incorporer les blancs en neige.', 'Laisser prendre la mousse pendant 12 heures au réfrigérateur.'], ['Pince de cuisine', 'Économe', 'Spatule', 'Passoire', 'Râpe'], ['recettes de cuisine', 'plat', 'cocktail', 'gélatine', 'mousse fruits', 'Mousse aux framboises', 'sucre', 'crème fraîche', 'plat de résistance', 'bon marché', 'oeuf', 'framboises', 'rapide', 'recette', 'cuisine', 'lait', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:14:10.670530', [{'ingredient_id': '5689e9c8-2fe8-4311-9657-7133924d7147', 'quantite': '500 g'}, {'ingredient_id': '8e6379a0-f4d2-4c10-a975-898f759fab85', 'quantite': '100 g'}, {'ingredient_id': '58129954-497b-4c7d-8fc7-d07d56872ce7', 'quantite': '150 g'}, {'ingredient_id': 'c96fa8c1-0293-4668-9e9b-e40288d9b45a', 'quantite': '2'}, {'ingredient_id': '1ab1f81e-3233-486f-ad43-76260237d41f', 'quantite': '2'}, {'ingredient_id': '9b8fd29b-259d-4da7-86ca-003047918a6b', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70168, 'Verrine de fraises aux spéculoos', 'fraises, fromage blanc, spéculoos', '20 min', ['Mixez puis déposez la moitié des spéculoos au fond de chaque verrine.', 'Recouvrez de fromage blanc sur environ 3 cm de hauteur.', 'Mixez les fraises (sauf 2) et répartissez-les dans chaque verrine.', 'Recouvrez avec le reste des spéculos puis terminez par 1/2 fraise. Mettez au frais avant de servir.'], ['Casserole', 'Râpe', 'Économe'], ['speculoos', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'fromage blanc', 'bon marché', 'rapide', 'Verrine de fraises aux spéculoos', 'recette', 'fraises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'spéculoos'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:14:17.331176', [{'ingredient_id': 'ce8c995e-c2fc-4cc7-9d9e-5c214013a240', 'quantite': '300 g'}, {'ingredient_id': 'c7f36dfd-a0d2-427a-98e5-6313acf4eb24', 'quantite': '300 g'}, {'ingredient_id': 'a9faeac4-342d-426a-92c1-2893658c1f2d', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18527, 'Soupe de fraises très facile', 'fraises, jus de citron, marmelade d''orange, sucre glace', '15 min', ['Laver et enlever les queues des fraises. ', 'Les couper en morceaux. ', 'Les mettre dans un mixeur avec tous les ingrédients pré-cités. ', 'Bien mixer le tout. ', 'Servir frais. Cette préparation peut accompagner un gâteau ou une glace. C''est délicieux.'], ['Économe', 'Spatule', 'Verre doseur', 'Presse-agrumes'], ['', 'Soupe de fraises très facile', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'marmelade d''orange', 'bon marché', 'rapide', 'recette', 'fraises', 'cuisine', 'jus de citron', 'testées', 'sucre glace', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', f3a2a33c-8173-4974-80f7-0b695cd13235, '2025-09-26T15:14:22.036460', [{'ingredient_id': '5e9a4ab9-2df9-4fb8-a672-7257250ead9c', 'quantite': '1 kg'}, {'ingredient_id': '8a80f58b-c9e1-44c0-9f04-c227de2cd74a', 'quantite': '2 cuillères'}, {'ingredient_id': '366c18fd-b905-4db1-9e48-a28a30f9cb4e', 'quantite': '2 cuillères'}, {'ingredient_id': '6fc80d0f-14bc-4b08-94f8-7d70082e2c9d', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (19824, 'Moelleux aux pommes de mon enfance', 'oeuf, sucre, huile, lait, rhum, farine, levure chimique, pomme', '15 min', ['C''est très simple il suffit de tout mélanger et de mettre dans un moule à manqué beurré au four à 210°C (thermostat 7) pendant 20 à 30 min. Vérifier la cuisson.'], ['Rouleau à pâtisserie', 'Passoire'], ['gâteau aux pommes', 'recettes de cuisine', 'plat', 'cocktail', 'Moelleux aux pommes de mon enfance', 'levure chimique', 'sucre', 'plat de résistance', 'bon marché', 'oeuf', 'rhum', 'recette', 'cuisine', 'lait', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme', 'huile', 'farine'], 'Dessert', 5a996ccb-ee9e-48af-bc0d-003631809081, '2025-09-26T15:14:28.749477', [{'ingredient_id': '2f9ab79f-912f-4bae-aedb-07c77d0e6d48', 'quantite': '2'}, {'ingredient_id': 'd20c06a3-12f0-4301-bfec-25ec5558055b', 'quantite': '150 g'}, {'ingredient_id': 'd7ddc2fb-8295-4cab-8845-6256d3f5b3b9', 'quantite': '3 cuillères'}, {'ingredient_id': '9ca60f00-856a-4d65-98eb-0f9cd5a47f3b', 'quantite': '3 cuillères'}, {'ingredient_id': '8541568b-d405-42c3-8daa-cab1f5f39427', 'quantite': '1 cuillères'}, {'ingredient_id': '44283388-0976-4083-ba4b-e9c23a9cfb28', 'quantite': '150 g'}, {'ingredient_id': 'e2a5ce27-6f1b-4e42-ba19-0720e4619e91', 'quantite': '1'}, {'ingredient_id': 'cf0374b4-96b6-4b85-856e-68ecb01316dd', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32831, 'Gâteau moelleux aux pommes', 'farine, sucre, lait, huile, oeuf, levure chimique, pomme, beurre, sucre, oeuf, sucre vanillé', '20 min', ['Mélanger la farine et le sucre, puis incorporer le lait, les oeufs, l''huile et la levure jusqu''à obtenir une pâte homogène. ', 'Verser la pâte dans un moule à manqué beurré et fariné. ', 'Couvrir de fines tranches de pommes pelées, en les faisant se chevaucher. ', 'Mettre au four pendant 5 mn à 210°C . ', 'Faire fondre le beurre au bain-marie, ajouter les sucres et l''oeuf en remuant. ', 'Dès que le gâteau commence à dorer, l''arroser avec le glaçage et le remettre au four pour finir la cuisson.'], ['Économe', 'Râpe', 'Couteau de chef', 'Verre doseur'], ['sucre vanillé', 'gâteau aux pommes', 'recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'sucre', 'Gâteau moelleux aux pommes', 'plat de résistance', 'bon marché', 'oeuf', 'recette', 'cuisine', 'lait', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'huile', 'farine'], 'Dessert', f24969dd-f860-4149-bef9-5af0f9a4e899, '2025-09-26T15:14:35.361191', [{'ingredient_id': '91d3e398-6387-4d0b-a363-96340c9380f0', 'quantite': '5 cuillères'}, {'ingredient_id': 'cbebc4e0-279d-4119-a1b2-2d012f23df94', 'quantite': '5 cuillères'}, {'ingredient_id': 'e859f95d-db70-4eac-abe3-ac3bb6b7a7d1', 'quantite': '5 cuillères'}, {'ingredient_id': '6e45d6c2-1e2a-4b3f-b611-307b8bbf6e11', 'quantite': '3 cuillères'}, {'ingredient_id': '20347b89-2421-49fd-9c0b-3c26e3a5ff2e', 'quantite': '2'}, {'ingredient_id': '61068656-b6bf-45a7-810e-d01cb9595906', 'quantite': ''}, {'ingredient_id': 'c0776598-001f-4aa5-be8d-8e50750d2a64', 'quantite': '4'}, {'ingredient_id': '523222c1-ecef-4b0e-a2d3-031a8626c178', 'quantite': '80 g'}, {'ingredient_id': '0b85a4fe-04ed-46be-8296-09bbbea74689', 'quantite': '100 g'}, {'ingredient_id': 'b87f347f-a498-4c7f-8b35-4c579ddd4557', 'quantite': '1'}, {'ingredient_id': 'd7d725be-4f62-4ca3-82c0-32c44aef084c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33143, 'Cake à la cannelle et aux pommes caramélisées', 'farine, sucre, oeuf, levure chimique, beurre, cassonade, pomme, cannelle', '25 min', ['Si possible prenez des pommes qui ne fondent pas trop à la cuisson', 'Préchauffez le four à 200°C (thermostat 6-7). ', 'Épluchez et coupez les pommes en gros dés. ', 'Dans une sauteuse faites fondre les 30 g de beurre. Faire dorer à feux doux les dés de pommes. Une fois dorés, saupoudrez la cassonade sur les pommes, couvrez pendant quelques minutes, en surveillant naturellement. ', 'Dans un saladier mettez le sucre et ajoutez le beurre fondu, puis y incorporez un à un les œufs. Ajoutez la farine et la levure en mélangeant bien. Et enfin ajoutez la cannelle. ', 'Incorporez à la pâte les pommes et mélangez. Versez le tout dans un moule à cake beurré et fariné. ', 'Au four pendant 35 à 40 min, surveillez la cuisson du cake en plantant un couteau dedans, la pâte de doit pas coller à la lame. ', 'Une fois sorti du four, laissez le cake reposer quelques heures avant de le déguster.'], ['Fouet', 'Mixeur', 'Couteau de chef', 'Moule à tarte', 'Verre doseur'], ['cannelle', 'Cake à la cannelle et aux pommes caramélisées', 'autres cakes', 'cassonade', 'recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'sucre', 'plat de résistance', 'bon marché', 'oeuf', 'recette', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:14:42.186235', [{'ingredient_id': '59895f6c-f169-4c9c-b819-023021383902', 'quantite': '200 g'}, {'ingredient_id': '41d43544-11c0-4f36-b2f3-5145a20b771e', 'quantite': '200 g'}, {'ingredient_id': '37718f8e-3f80-4845-8912-b5f0779064ab', 'quantite': '4'}, {'ingredient_id': '9ea050c0-d219-429f-a308-2195b13c2d73', 'quantite': ''}, {'ingredient_id': '0a4c5110-7371-40d1-a0fe-82683d407d82', 'quantite': '100 g'}, {'ingredient_id': 'ef74e0b3-f0f3-4fad-a292-51fb882157de', 'quantite': '60 g'}, {'ingredient_id': '1cc86e80-4cc5-4fcc-91c6-59578c5cd000', 'quantite': '400 g'}, {'ingredient_id': '68f9c93e-30f4-49d8-98fe-f957b7532f4d', 'quantite': '10 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65922, 'Macaron géant framboise/litchi/rose - presque un Ispahan', 'blanc d''oeuf, amandes, sucre glace, sucre en poudre, eau de rose, colorant, crème liquide, sucre glace, eau de rose, colorant, framboises, litchi au sirop', '120 min', ['Préparer la pâte de macaron :', 'Séparer les blancs des jaunes (conserver les jaunes pour faire autre chose).', 'Peser les blancs et ajuster les autres ingrédients en proportion.', 'Monter les blancs en neige (ferme, mais pas trop).', 'A la fin, rajouter le sucre en poudre, l’arôme de rose et le colorant liquide et continuer à fouetter pendant 30 secondes.', 'Tamiser ensemble la poudre d''amandes et le sucre glace ; bien mélanger.', 'Ajouter progressivement au blanc le mélange poudre d''amandes/sucre glace aux blancs, en mélangeant délicatement avec une spatule jusqu’à obtenir une pâte homogène, lisse et brillante. ', 'Préparer la feuille de papier cuisson.', 'Comme pour les petits macarons, il faut assembler au final deux demi-gâteaux de la même taille. Avec les petits, il est en général assez facile, avec le nombre de biscuits réalisés, de les assembler par deux.', 'Pour les grands gâteaux, il est préférable de tracer sur l’envers du papier cuisson, le gabarit des deux biscuits pour être sûr de ne pas se retrouver avec l’un des deux beaucoup plus grand que l’autre.', 'Les proportions données doivent permettre d’obtenir de former deux bases rectangulaires de 15 cm sur 20 cm ou de bases circulaires d’environ 20 cm de diamètre.', 'Déposer la pâte de macaron sur l’endroit de la feuille de papier cuisson posée sur une plaque, en utilisant une poche à douille (moi j’ai pris une douille de taille 7) soit en faisant des traits les uns à cotés des autres (bases rectangulaires) soit en spirale (en partant du bord extérieur (bases circulaires).', 'Laisser reposer pendant 30 minutes environ.', 'Pendant ce temps, préparer la garniture.', 'Préchauffer le four à 160°C (thermostat 5-6).', 'L’idéal est de mettre les plaques de macarons à cuire sur 2 plaques vides et déjà chaudes (pendant le préchauffage du four), cela aide à "saisir" les macarons.', 'Les gros macarons doivent cuire plus longtemps que les petits, je dirais environ 20 à 30 minutes mais cela dépend beaucoup du four, il faut donc vérifier régulièrement. Eventuellement, tourner votre plaque dans le four à mi cuisson pour avoir quelque chose d’homogène. Il faut que la croûte soit ferme mais le macaron doit être encore moelleux dedans (mais pas liquide). ', 'Pour faciliter le détachage des macarons, 2 possibilités :', '1) Faire passer un peu d’eau froide entre la plaque et la feuille de papier cuisson (en inclinant la plaque au dessus de l’évier), en faisant attention de ne pas mouiller les macarons (il faut pour cela que le papier sulfurisé dépasse de la plaque)!', '2) Déposer la plaque sur une surface froide (par exemple le carrelage), en faisant attention de ne pas marcher dessus !', 'Laisser refroidir avant de décoller délicatement les biscuits du papier cuisson.', 'La garniture :', 'Monter la crème en chantilly ferme en ajoutant le sucre glace.', 'A la fin, ajouter l’arôme de rose (quelques gouttes suffisent, à adapter en fonction de votre goût. Je vous conseille de mettre 2-3 gouttes et de tester) et le colorant (juste quelques gouttes pour que la crème soient très légèrement teintée).', 'Conserver au moins 2 heures au frigo.', 'Montage du biscuit :', 'Si vous utilisez des framboises congelées, penser à les faire décongeler à l’avance pour qu’elles ne rendent plus d’eau. De même, il faut bien égoutter les litchis.', 'Prendre une des deux bases (la moins réussie) comme dessous de gâteau (comme pour les petits macarons, la surface en contact avec le papier cuisson est la surface en contact avec la garniture).', 'Recouvrir cette base avec environ 1/3 de la chantilly.', 'Placer les framboises et les litchis égouttés de façon régulière.', 'Recouvrir (et remplir les trous entre les fruits) avec le reste de la crème chantilly (le mieux est d’utiliser une douille pour être plus précis).', 'Recouvrir avec le deuxième biscuit.', 'Conserver au frigo en attendant la dégustation mais ne pas faire le montage trop longtemps à l’avance pour éviter que les biscuits ne s’imbibent trop.', 'Il est également possible de faire des petits macarons. Personnellement je ne fais que des demi-macarons (sans chapeau) que j’appelle mispahan (demi-ispahan).', 'J’utilise des brisures de framboises surgelées (décongelées et égouttées) et des litchis bien essuyés et coupés en petits morceaux.', 'Montage :', 'Un petit biscuit, une pointe de chantilly étalée, une demi cuillère de framboises brisées, environ 1/2 de litchi en morceaux et une jolie pointe de chantilly sur le dessus (déposée à la douille cannelée) et éventuellement recouvrir le tout d’un deuxième biscuit.'], ['Presse-agrumes', 'Moule à tarte', 'Planche à découper'], ['difficile', 'recettes de cuisine', 'plat', 'macarons', 'cocktail', 'eau de rose', 'amandes', 'plat de résistance', 'bon marché', 'Macaron géant framboise/litchi/rose - presque un Ispahan', 'recette', 'sucre en poudre', 'cuisine', 'blanc d''oeuf', 'testées', 'sucre glace', 'colorant', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', 0e400761-2bdf-4a90-a06c-06eb2351c320, '2025-09-26T15:14:47.041757', [{'ingredient_id': '9b32a810-7f71-4afb-973e-ef3abf2cfa86', 'quantite': '115 g'}, {'ingredient_id': 'dc885a56-f4cf-44bb-82ab-394939f56bbb', 'quantite': '144 g'}, {'ingredient_id': 'bbe2e48b-c324-462f-88b3-58f94244483f', 'quantite': '260 g'}, {'ingredient_id': 'f35f0157-543e-44b5-8b47-ae87c35d23bf', 'quantite': '30 g'}, {'ingredient_id': '73da1aa9-9fea-4dcf-9f6b-333cb8050a8d', 'quantite': '2'}, {'ingredient_id': '718f05a2-0455-4cfb-bb54-873575249b59', 'quantite': ''}, {'ingredient_id': '4737c55c-fcaf-4c97-aa59-6eda79fa7cef', 'quantite': '30 cl'}, {'ingredient_id': '41d3f6c0-8daf-4b4b-8075-0e351836b8eb', 'quantite': '20 g'}, {'ingredient_id': 'fcbf67d0-78d3-45b3-8e99-3e8a000e5029', 'quantite': ''}, {'ingredient_id': 'd10bee03-8bda-49f3-87b6-ff40e4b824f4', 'quantite': ''}, {'ingredient_id': '2c718059-ebb1-4a48-90e9-b51e33d1b9e3', 'quantite': '100 g'}, {'ingredient_id': 'c728d789-a324-46f1-8816-6b87d32ceb6c', 'quantite': '15'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30908, 'Crumble pommes, fraises, rhubarbe aux speculoos', 'pomme, fraises, rhubarbe, sucre, spéculoos, farine, sucre roux, beurre', '20 min', ['Effiler la rhubarbe, la couper en tronçons, et la faire cuire 5 min dans une casserole, avec le sucre et peu d''eau. ', 'Laver et essuyer les pommes, leur couper un chapeau, et les évider délicatement (Elles vont servir de ramequin comestible pour présenter le crumble). ', 'Détailler la chair en dés, puis les ajouter à la rhubarbe et poursuivre la cuisson 5 min. ', 'Laver et équeuter les fraises, les couper en quatre, et mélanger aux fruits cuits hors du feu. ', 'Préchauffer le four à Th 8 (240°C). ', 'Mettre la farine, le beurre, le sucre et les spéculoos dans le bol du robot et mixer par à-coups pour obtenir un mélange sableux. ', 'Garnir les pommes évidées avec les fruits, parsemer le dessus de pâte. ', 'Baisser le four à 6 (180°C) et enfourner 25 à 30 min. ', 'Servir aussitôt, avec de la crème ou une boule de glace vanille.'], ['Couteau de chef', 'Tire-bouchon', 'Mixeur', 'Verre doseur'], ['Crumble pommes', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'rhubarbe aux speculoos', 'sucre', 'plat de résistance', 'crumble aux pommes', 'rhubarbe', 'moyen', 'recette', 'fraises', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme'], 'Dessert', 109f33f9-a00c-4400-94fc-94a2cd3d531f, '2025-09-26T15:14:51.670637', [{'ingredient_id': '4de428fa-e575-4344-a365-48bc9d3a0ba1', 'quantite': '6'}, {'ingredient_id': '0a763ab5-e085-4d9c-913c-d1b2279a51b4', 'quantite': '250 g'}, {'ingredient_id': '6303756b-b7e8-42ef-8ac3-b8a0ff9436a8', 'quantite': '400 g'}, {'ingredient_id': '29ba2822-5602-4cbf-ab8a-de4957668772', 'quantite': '60 g'}, {'ingredient_id': '7be2a483-ec84-429f-9869-9c40fdad8db2', 'quantite': '100 g'}, {'ingredient_id': 'e95b5b18-04c9-4455-9cc1-f608155b547c', 'quantite': '50 g'}, {'ingredient_id': '3dc60ce5-3f47-42eb-85e6-42a5bf1dc1e5', 'quantite': '50 g'}, {'ingredient_id': '524f7a9a-47dc-403c-96ec-7cfce9cb1205', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22846, 'Fondant aux pommes golden', 'pomme, beurre, sucre en poudre, citron, oeuf, farine, levure chimique', '15 min', ['Dans un saladier, mélanger le beurre ramolli avec le sucre et le zeste ou le jus d''orange (ou de citron). ', 'Ajouter les 2 œufs entiers, la farine et la levure. ', 'Ajouter du calva ou du rhum si l''on veut sucré. ', 'Beurrer un moule ou mettre du papier sulfurisé. ', 'Couper les pommes en fine tranches et les mettre au fond du plat. ', 'Verser la pâte sur les pommes. ', 'Faire cuire environ 45 min à 180-200°C.'], ['Presse-agrumes', 'Balance de cuisine', 'Pince de cuisine'], ['', 'recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'plat de résistance', 'citron', 'bon marché', 'oeuf', 'recette', 'sucre en poudre', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'Fondant aux pommes golden', 'farine'], 'Dessert', 30a3e900-a72c-473c-af42-85886787d32f, '2025-09-26T15:14:58.325336', [{'ingredient_id': 'c097f5ea-3e07-44ac-8d0d-92cdef5ebbed', 'quantite': '3'}, {'ingredient_id': '93df4c8b-0873-4a1e-acab-5c152f0cc3c3', 'quantite': '100 g'}, {'ingredient_id': '968e8a3b-46bc-47ea-a950-3446d8d0ca71', 'quantite': '100 g'}, {'ingredient_id': 'eecfec0d-feef-442a-b311-69635b31ed96', 'quantite': '1'}, {'ingredient_id': '4b66c734-5ebb-4a05-a51b-6679912b3060', 'quantite': '2'}, {'ingredient_id': '605c4eec-5981-4ff9-84b2-3913216bef89', 'quantite': '100 g'}, {'ingredient_id': '8dcf78d9-8e6a-4b33-a725-341a19374ac0', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34179, 'Pintade chaponne aux pommes et aux châtaignes', 'pintade, pomme, châtaignes, oignon, romarin, huile d''olive, calvados, sucre roux, muscade, poivre, sel', '20 min', ['Oter le surplus de graisse qui peut se trouver à l''intérieur de la pintade et y introduire une belle branche de romarin frais. Installer la pintade dans un plat allant au four, saler et poivrer l''extérieur des deux côtés, puis badigeonner d''huile d''olive.', 'Répartir tout autour un gros oignon coupé en tranches fines.', 'Enfourner à four chaud (200°C) pendant 90 min.', 'Quelques minutes après le début de la cuisson, ajouter 50 cl d''eau bouillante, en arroser de temps en temps la volaille. En fin de cuisson, sortir la pintade du plat et la réserver au chaud. 
Si le jus est trop gras, en retirer la valeur d''un demi-bol. Réserver pour y faire réchauffer les châtaignes au micro-ondes.', 'Déglacer le plat avec le calvados, ajouter le sucre et saupoudrer de noix muscade. Répartir les pommes coupées en quartier.', 'Enfourner à 240°C jusqu''à ce que les pommes soient bien dorées.', 'Servir la pintade accompagnée des pommes, des châtaignes et de la sauce en saucière.'], ['Rouleau à pâtisserie', 'Planche à découper', 'Mixeur', 'Passoire'], ['', 'romarin', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'calvados', 'pintade', 'sel', 'moyen', 'oignon', 'recette', 'cuisine', 'sucre roux', 'huile d''olive', 'Pintade chaponne aux pommes et aux châtaignes', 'poivre', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'châtaignes', 'confiserie', 'pomme', 'muscade'], 'Plat principal', d9d5908d-023b-4f3b-b18b-bbc6498071b3, '2025-09-26T15:15:02.810665', [{'ingredient_id': 'f45cc69f-964c-45fb-abe0-ce5c888bad1a', 'quantite': '1'}, {'ingredient_id': '2fc232a4-d66a-4d65-afce-00f48d50082e', 'quantite': '6'}, {'ingredient_id': '35773558-86e6-49b0-8e60-44b6b400cb92', 'quantite': '600 g'}, {'ingredient_id': '8f60e5a7-ccbf-4ab4-b46c-446ba9b11776', 'quantite': '1'}, {'ingredient_id': 'cfe1fdf2-61b8-4cda-95f3-7772f43bf145', 'quantite': '1'}, {'ingredient_id': '075abe32-170a-42d8-acf0-0724183d0acd', 'quantite': '1 cuillères'}, {'ingredient_id': '970f591c-ea53-4cb3-8e8f-6409cfe96c64', 'quantite': '10 cl'}, {'ingredient_id': '330d0f05-1491-4ee9-897e-653d1c37290e', 'quantite': '1 cuillères'}, {'ingredient_id': '3970c8a6-6e00-468d-98be-28fc0e0fc50e', 'quantite': ''}, {'ingredient_id': 'f3e015e8-525b-4f9b-8cf2-d2bc2dd9d783', 'quantite': ''}, {'ingredient_id': '0fd91487-e86b-4d12-aafc-e4244abcaff2', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20738, 'Cake frais aux pommes et au citron', 'pomme, citron, oeuf, farine, beurre, sucre en poudre, levure chimique, sel', '20 min', ['I- Préchauffez le four à 180°C (thermostat 6). Pelez et épépinez les pommes. Coupez-les en dés. Rincez le citron et râpez l''équivalent d''une cuillerée à soupe de zeste. ', 'II- Dans un grand saladier, travaillez le beurre ramolli et le sucre en poudre jusqu''à ce que le mélange soit homogène. Incorporez les oeufs un à un, puis la farine tamisée, la levure, le zeste et le sel. ', 'III- Mélangez la pâte avec les dés de pommes et versez-la dans un moule à cake beurré. Glissez-le dans le four puis laissez cuire environ 45 min. Testez la cuisson en piquant le cake avec la lame d''un couteau, qui doit ressortir sèche. ', 'IV- laissez tiédir le cake hors du four environ 15 min puis démoulez-le sur une grille. Servez à température ambiante.'], ['Louche', 'Planche à découper', 'Couteau de chef'], ['recettes de cuisine', 'plat', 'cocktail', 'Cake frais aux pommes et au citron', 'levure chimique', 'plat de résistance', 'citron', 'bon marché', 'oeuf', 'sel', 'recette', 'sucre en poudre', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'cake au citron', 'farine'], 'Dessert', ca1f7b88-c3e9-456c-ba8e-f4bb429275f9, '2025-09-26T15:15:10.297217', [{'ingredient_id': 'e87362bf-a7a1-4a8d-bde7-057810204b8b', 'quantite': '2'}, {'ingredient_id': 'a0b30c26-fd90-429b-818c-ca063945c240', 'quantite': '1'}, {'ingredient_id': 'ebf8c61b-bc7f-4ecf-b7ea-5555968511be', 'quantite': '3'}, {'ingredient_id': '8656c0b0-1c7d-4759-abae-86e607c8fc2b', 'quantite': '250 g'}, {'ingredient_id': '84bca24e-bd90-4e63-8489-9804b1981247', 'quantite': '180 g'}, {'ingredient_id': '2118bd49-49f1-40eb-bbe7-bff5ab765859', 'quantite': '120 g'}, {'ingredient_id': '26529767-bd50-4b52-99ef-3a3760130d7d', 'quantite': ''}, {'ingredient_id': '0f3e039d-8e98-4e59-92b8-ab5d5d4519fd', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38610, 'Charlotte royale aux fraises et fraises Tagada', 'sucre en poudre, farine, oeuf, fraises tagada®, sirop de citrons, fraises, crème liquide, sucre en poudre, gélatine, citron, sucre vanillé', '60 min', ['On commence par les biscuits roulés :', 'Préchauffez le four à 210°C (thermostat 7).', 'Fouettez les jaunes avec le sucre jusqu''à ce que le mélange blanchisse. Ajoutez la farine petit à petit.', 'Incorporez délicatement les blancs d''oeufs battus en neige très ferme.', 'Versez le mélange sur une plaque rectangulaire recouverte de papier sulfurisé et étalez le plus uniformément possible. Mettez au four 7 à 10 min, le biscuit doit gonfler et brunir légèrement.', 'Pendant ce temps faites fondre vos fraises Tagada ® dans une casserole avec un peu d''eau, à feu doux.', 'Une fois cuit soulevez votre biscuit avec son papier et déposez le sur un torchon humide. Retournez le tout et enlevez délicatement la feuille de papier sulfurisé. Roulez sans attendre le biscuit en entraînant le torchon. Laissez reposer quelque minutes, le temps que le biscuit s''humidifie et s''assouplisse.', 'Déroulez et étalez sur votre biscuit vos fraises Tagada ® fondues. Roulez à nouveau et entourez de film alimentaire bien serré. Placez au frigo en attente.', 'Répétez l''opération pour faire votre deuxième biscuit.', 'Pour la mousse de fraises :', 'Faites tremper la gélatine dans de l''eau froide.', 'Lavez et équeutez les fraises, mettez en une dizaine de côté.', 'Mettez le reste des fraises dans votre mixer avec le jus du citron et mixez jusqu''à obtenir un coulis homogène (si vous avez un chinois, vous pouvez filtrer votre coulis pour enlever les petits grains mais ça n''est pas obligatoire).', 'Faites chauffer un peu de ce coulis dans une casserole et incorporez le sucre et la gélatine pour qu''elle fonde. Remélangez au reste du coulis, laissez refroidir et placez au frigo.', 'Montez la crème en chantilly (c''est plus facile si vous avez pris soin de placer votre saladier et votre brique de crème au congélateur 20 à 30 min avant), incorporez délicatement le sucre vanillé.', 'Un fois que le coulis est bien froid, ajoutez-y la chantilly délicatement.', 'Coupez les fraises restantes en deux.', 'Le montage de la charlotte :', 'Tapissez votre moule (je prends un grand saladier) de film alimentaire (le film adhère mieux si le moule est légèrement humide). ', 'Pour tremper vos biscuits, préparez une assiette creuse avec du sirop de citron et un tout petit peu d''eau.', 'Coupez les biscuits roulés en tranches fines (c''est un peu galère car la fraises tagada colle un peu, lavez souvent votre couteau). Trempez brièvement chaque tranche dans le sirop et tapissez le moule avec. Attention il y a un niveau intermédiaire et le socle de la charlotte à faire aussi, n''utilisez pas trop de tranches.', 'Remplissez à moitié votre charlotte de mousse aux fraises, posez la moitié de vos morceaux de fraises par dessus.', 'Formez un niveau intermédiaire de biscuits roulés (y mettre les entames qui sont moins jolies). Terminez avec le reste de la mousse et des fraises.', 'Remettez une couche de tranches de biscuits roulés pour fermer votre charlotte.', 'Placez sur votre charlotte un cercle de même taille (j''utilise un cercle en carton découpé dans une boîte de céréales) et posez dessus un poids (brique de lait par exemple) pour tasser la charlotte.', 'Placez au frigo au moins 12h.', 'Au moment de servir, pour démouler votre charlotte, trempez brièvement votre moule dans de l''eau tiède et renversez sur le plat de service.'], ['Passoire', 'Planche à découper'], ['difficile', 'recettes de cuisine', 'plat', 'cocktail', 'sirop de citrons', 'charlotte aux fraises', 'Charlotte royale aux fraises et fraises Tagada', 'plat de résistance', 'bon marché', 'fraises tagada®', 'oeuf', 'recette', 'sucre en poudre', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'farine'], 'Dessert', 65ef3696-c20f-4922-8b32-5b4d7e23cf50, '2025-09-26T15:15:13.856513', [{'ingredient_id': 'ec185e3f-7d55-41ac-83e0-bf4ff716043a', 'quantite': '100 g'}, {'ingredient_id': '8637a75f-1ed6-4eed-aeca-57751b352409', 'quantite': '80 g'}, {'ingredient_id': 'd523fab0-f34a-48ff-9a37-803cbc99714e', 'quantite': '3'}, {'ingredient_id': 'ce288de8-3dd5-4e55-b938-a97e93db14f2', 'quantite': '200 g'}, {'ingredient_id': '4a42804c-ff1e-427a-b40d-af132d95db4f', 'quantite': ''}, {'ingredient_id': '88740221-ee57-4d33-a21b-946c66e2977b', 'quantite': '500 g'}, {'ingredient_id': '410775d3-6732-40f5-97f9-aed5c2675e8e', 'quantite': '40 cl'}, {'ingredient_id': '09d06850-04f0-4302-b2e9-72e0f6c49fb4', 'quantite': '60 g'}, {'ingredient_id': 'cc95636a-50e1-4a7b-8048-1fd4f4c75561', 'quantite': '6'}, {'ingredient_id': '673f96a7-e1c7-44b5-94fc-a9bea7229860', 'quantite': '1'}, {'ingredient_id': 'cb90c829-d287-4f9b-b825-cf46cdee9a64', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11830, 'Galettes de pommes de terre d''Alsace', 'pomme de terre, oignon, oeuf, farine, sel, épices, persil', '20 min', ['Râper les pommes de terre et les oignons, mélanger avec la farine et l''oeuf, saler et épicer.', 'Dans une poêle, mettre environ 1 cm d''huile.', 'Quand elle est bien chaude, déposer des galettes que vous aurez formées et égoutées en les pressant un peu entre vos mains.', 'Saupoudrer de persil et retourner au bout d''une dizaine de minutes.'], ['Tire-bouchon', 'Moule à tarte', 'Planche à découper'], ['moyenne', 'Galettes de pommes de terre d''Alsace', 'recettes de cuisine', 'plat', 'cocktail', 'galette de légumes', 'plat de résistance', 'oeuf', 'persil', 'épices', 'sel', 'moyen', 'oignon', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'pomme de terre', 'confiserie', 'farine'], 'Plat principal', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:15:20.448606', [{'ingredient_id': '1fb22328-a55c-4b90-9a43-5d9c4f749921', 'quantite': '6'}, {'ingredient_id': 'f198fbfa-f15f-4d4e-bbce-e38c4fe290dd', 'quantite': '2'}, {'ingredient_id': '6626cf24-4845-463e-9221-80df31080f06', 'quantite': '1'}, {'ingredient_id': '53a44dc1-28df-4e4a-9f8d-5e6d28197f06', 'quantite': '1 cuillères'}, {'ingredient_id': 'a557c277-99a4-43d3-99c8-3cac4ce6da43', 'quantite': ''}, {'ingredient_id': 'b28244f4-f9c5-450a-ad34-6a4f7eba6e94', 'quantite': ''}, {'ingredient_id': '961518cc-1149-4618-96fc-44fea20fd19c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169067, 'Mousse au chocolat blanc et fraise', 'chocolat blanc, crème liquide, blanc d''oeuf, fraises, sucre, sel', '20 min', ['Placer la crème liquide et un plat en verre au congélateur durant 15 min.', 'Faire fondre le chocolat blanc au bain marie.', 'Faire monter la crème liquide (bien fraiche) en chantilly ferme.', 'Faire monter les blancs en neige avec une pincée de sel.', 'Mélanger délicatement le chocolat blanc avec la chantilly et ensuite les blancs en neige.', 'Placer ce mélange dans des ramequins et mettre au frais pendant minimum 3h.', 'Laver les fraises, les équeuter, et  les couper en petits morceaux. Y ajouter le sucre.', 'Au moment de servir rajouter sur la mousse au chocolat blanc quelques morceaux de fraises.'], ['Couteau de chef', 'Rouleau à pâtisserie', 'Louche'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'chocolat blanc', 'rapide', 'sel', 'moyen', 'recette', 'crème liquide', 'fraises', 'cuisine', 'blanc d''oeuf', 'testées', 'entrée', 'dessert', 'mousse au chocolat', 'boisson', 'recettes', 'confiserie', 'Mousse au chocolat blanc et fraise'], 'Dessert', 9d8d9922-be74-4da3-a320-2b8b23c60951, '2025-09-26T15:15:25.093743', [{'ingredient_id': '956d9865-8019-4fac-8230-4c30b5d3b4f1', 'quantite': '200 g'}, {'ingredient_id': '59e4dd2e-5616-461d-9fea-56f3f5c73425', 'quantite': '20 cl'}, {'ingredient_id': '8432c252-69a9-455c-bc41-ec56043156e5', 'quantite': '2'}, {'ingredient_id': '8f60df20-f9b0-49ee-9b37-56eef46fd802', 'quantite': '250 g'}, {'ingredient_id': '0aec82e5-4235-4158-9439-a5d463239d5c', 'quantite': '2 cuillères'}, {'ingredient_id': '23e521d1-dc9b-4f06-b3fc-70ae4181c02e', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37608, 'Pistachiers aux fraises de Marielle (19ème rencontre)', 'pistaches, farine, sucre, sucre vanillé, beurre, blanc d''oeuf, fraises', '15 min', ['Préchauffer le four à 200°C (thermostat 6-7).', 'Mettre le beurre à fondre à feu très doux.', 'Mixer les pistaches jusqu''à obtention d''une poudre grossière.', 'Laver, équeuter et couper les fraises en dés d''environ 1 à 1,5 cm.', 'Dans un saladier, mélanger les pistaches, la farine, le sucre, le sucre vanillé, le beurre et 4 blancs d''œufs jusqu''à obtention d''une pâte homogène.', 'Beurrer et fariner les moules à muffins (sauf si silicone).', 'Verser la pâte dans les moules à muffins et enfoncer 4-5 morceaux de fraises dans la pâte de chaque empreinte.', 'Faire cuire pendant 25 min dans votre four préchauffé.', 'Démouler à la sortie du four.'], ['Planche à découper', 'Pince de cuisine'], ['', 'sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'pistaches', 'plat de résistance', 'Pistachiers aux fraises de Marielle (19ème rencontre)', 'moyen', 'recette', 'fraises', 'cuisine', 'blanc d''oeuf', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'farine'], 'Dessert', 70389b44-239e-467b-b12a-512157644eb3, '2025-09-26T15:15:28.737760', [{'ingredient_id': 'e8e73be8-d633-4e75-8835-223ea079d71a', 'quantite': '75 g'}, {'ingredient_id': '34c57188-f82d-4727-adb5-ddc28c1079ce', 'quantite': '50 g'}, {'ingredient_id': '4ba04f7b-66f7-419c-9e87-7954f242d609', 'quantite': '125 g'}, {'ingredient_id': '725fed4f-d4fd-42b0-9c43-79d0518624be', 'quantite': '1'}, {'ingredient_id': 'cf018c46-5431-47c1-9671-8d9029f099e4', 'quantite': '70 g'}, {'ingredient_id': 'c35a3dee-a8c6-4923-8131-70ecaf8c355e', 'quantite': '4'}, {'ingredient_id': 'a18b0935-e95b-4c9b-a7e5-e240565009a1', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (10534, 'Le crumble aux pommes du Chat qui Tousse', 'pomme, cassonade, farine de blé, beurre doux, cannelle, sucre vanillé, citron', '25 min', ['Préchauffer le four à 210°C (thermostat 7).', 'Peler, évider et découper les pommes en cubes grossiers, les répartir dans un plat allant au four.', 'Les arroser de jus du citron et les saupoudrer de cannelle et de sucre vanillé.', 'Dans un saladier, mélanger la farine et la cassonade. Puis ajouter le beurre en petits cubes et mélanger à la main de façon à former une pâte grumeleuse.', 'Émietter cette pâte au dessus des pommes de façon à les recouvrir. ', 'Enfourner pour 30 minutes de cuisson. ', 'Servir tiède avec de la crème fouettée ou de la glace à la vanille.'], ['Presse-agrumes', 'Économe', 'Louche', 'Batteur électrique', 'Ouvre-boîte'], ['cannelle', 'sucre vanillé', 'cassonade', 'recettes de cuisine', 'plat', 'cocktail', 'farine de blé', 'plat de résistance', 'citron', 'bon marché', 'Le crumble aux pommes du Chat qui Tousse', 'crumble aux pommes', 'recette', 'beurre doux', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:15:35.214404', [{'ingredient_id': 'b2ed0d8c-bc07-4016-a64b-c8dc30c95395', 'quantite': '6'}, {'ingredient_id': '7283b6db-0a5d-4932-ac41-487507b30e92', 'quantite': '150 g'}, {'ingredient_id': 'b068d047-3e24-4750-8523-69f397d096ad', 'quantite': '150 g'}, {'ingredient_id': '5028d422-5c6b-4e64-b0dd-12d559089239', 'quantite': '125 g'}, {'ingredient_id': 'eb615000-556f-4fa7-89e5-e451daa7a555', 'quantite': '1'}, {'ingredient_id': '4e433ee5-2f28-4f0e-bdb5-0cb8805b5d91', 'quantite': '1'}, {'ingredient_id': '688414ba-f0a4-41da-a962-fe9284ea0509', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15265, 'Crumble aux pommes', 'pomme, farine, beurre, sucre semoule, cannelle, glace vanille', '20 min', ['Préchauffer votre four à thermostat 8.', 'Eplucher, épépiner et couper les pommes en gros morceaux. Les faire réduire à feu fort 2 mn avec une cuillerée à soupe d''eau puis maintenir la cuisson à feu doux pendant 7 à 8 mn.', 'Ecraser les derniers gros morceaux de pommes à la fourchette. Mélanger les pommes avec 125 g de sucre et 1/2 cuillère à café de cannelle. Verser ce mélange dans un plat à gratin beurré.', 'Travailler énergiquement le beurre. Incorporer le reste du sucre et de le cannelle, ainsi que les 150 g de farine, puis travailler le tout avec les doigts afin d''obtenir un sable grossier.', 'Répartir sur la compote et cuire au four 25 mn (grille centrale).'], ['Passoire', 'Fouet', 'Rouleau à pâtisserie', 'Râpe'], ['cannelle', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'Crumble aux pommes', 'bon marché', 'crumble aux pommes', 'recette', 'cuisine', 'glace vanille', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'sucre semoule', 'farine'], 'Dessert', 07d65eaa-17f4-43e6-9204-3237f87f1201, '2025-09-26T15:15:41.774125', [{'ingredient_id': '8d3a1d46-bb92-4097-948b-887bd431ba21', 'quantite': '1 kg'}, {'ingredient_id': 'e0aa5846-a69e-47c4-b279-6bebd6355ebc', 'quantite': '150 g'}, {'ingredient_id': '253f2fff-08a0-4744-8814-f06851dee64a', 'quantite': '75 g'}, {'ingredient_id': 'c9d0e682-fe98-4912-acea-6e7ac3d896bf', 'quantite': '250 g'}, {'ingredient_id': '4dc90e02-e068-4d87-b0a1-74c531820f25', 'quantite': '1 cuillères'}, {'ingredient_id': '8344e2f7-1da6-4b69-b02e-6dfd507125dd', 'quantite': '30 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (331370, 'Bavarois aux framboises des bois', 'oeuf, sucre, farine, sucre vanillé, levure chimique, sel, framboises, sucre, gélatine, crème liquide, framboises, gélatine', '20 min', ['Préchauffer le four à 150°C (thermostat 5).', 'Pour la génoise, fouetter les jaunes d’œufs avec le sucre en poudre et le sucre vanillé jusqu''à ce que le mélange blanchisse. ', 'Ajouter la farine tamisée avec la levure. ', 'Incorporer délicatement les blancs battus en neige avec le sel. ', 'Verser la pâte dans un moule ou un cercle. ', 'Faire cuire pendant 25 minutes.', 'Une fois le gâteau cuit, le laisser refroidir pendant la préparation de la mousse.', 'Pour la mousse, placer les feuilles de gélatine dans un bol rempli d''eau froide.', 'Mixer les framboises avec le sucre.', 'Passer au tamis pour récupérer uniquement le coulis sans les graines.', 'Chauffer doucement cette préparation avec les feuilles de gélatine puis laisser bien tiédir.', 'Monter la crème en chantilly et l''incorporer délicatement au coulis de framboises, puis la verser sur la génoise refroidie, puis mettre au frigo 1h à 1h30.', 'Pour le miroir, placer les feuilles de gélatine dans un bol rempli d''eau froide.', 'Mixer les framboises puis passer le tout au tamis pour récupérer uniquement le coulis.', 'Le faire chauffer et ajouter le gélifiant, bien remuer pour dissoudre complètement la gélatine.', 'Laisser tiédir et le verser doucement sur la mousse figée, remuer le moule pour bien étaler le miroir sur toute la surface du bavarois, puis mettre au frigo 2 h.'], ['Passoire', 'Presse-agrumes', 'Balance de cuisine', 'Casserole', 'Économe'], ['sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'sucre', 'Bavarois aux framboises des bois', 'plat de résistance', 'bon marché', 'oeuf', 'sel', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'bavarois', 'recettes', 'confiserie', 'farine'], 'Dessert', 82bb267d-701b-49d4-85f7-da160eac1643, '2025-09-26T15:15:46.734169', [{'ingredient_id': '7a118966-5326-46db-9de3-ba6826a08a90', 'quantite': '4'}, {'ingredient_id': '0a4222e4-5029-4310-93d3-4e47ae6f3b3f', 'quantite': '80 g'}, {'ingredient_id': 'acb56fa5-3dbb-4b40-9d3a-55a2ca62e52d', 'quantite': '80 g'}, {'ingredient_id': '2d1e020a-06e9-4529-b753-0d81e5477492', 'quantite': ''}, {'ingredient_id': '1a80df07-9277-4e57-b5e0-c81c36379b83', 'quantite': ''}, {'ingredient_id': '500a9526-3f7c-40e9-91c9-31763ff29a52', 'quantite': '1'}, {'ingredient_id': '2fac1fe7-6314-41a2-9db2-05f69b96b216', 'quantite': '500 g'}, {'ingredient_id': '5280d0fd-f294-4e8d-94e5-a2b135469503', 'quantite': '100 g'}, {'ingredient_id': '98b1501e-574f-4bbb-9601-13e35430f82d', 'quantite': '6'}, {'ingredient_id': '8b7daf62-307c-4a52-bd1f-d385462aa57f', 'quantite': '40 cl'}, {'ingredient_id': '160b7a7a-cf03-4e9d-9147-3536f8e3eaeb', 'quantite': '300 g'}, {'ingredient_id': '5e8acbbc-ed17-48d3-82ea-33fbe8018300', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17263, 'Gratin de framboises à la crème d''amandes', 'framboises, amandes en poudre, beurre tendre, sucre semoule, farine, crème liquide, oeuf', '10 min', ['Battez au fouet le beurre, la poudre d''amandes, la farine et le sucre. Incorporez la crème liquide, l''oeuf entier et le jaune, sans cesser de battre.', 'Allumez le grill du four. Etalez les framboises dans un plat à four pouvant les contenir en une seule couche. Nappez-les de la crème d''amandes et laissez gratiner quelques minutes sous le grill du four, pas trop près de la source de chaleur, jusqu''à obtention d''une légère coloraion', 'Servez aussitôt.'], ['Mixeur', 'Économe', 'Louche'], ['', 'Gratin de framboises à la crème d''amandes', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'oeuf', 'framboises', 'beurre tendre', 'rapide', 'recette', 'crème liquide', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'amandes en poudre', 'sucre semoule', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:15:53.580388', [{'ingredient_id': 'e768384b-3059-40e0-8b02-222737565d44', 'quantite': '300 g'}, {'ingredient_id': '3524234f-ef07-41fb-87e6-fca97a861bcc', 'quantite': '100 g'}, {'ingredient_id': '2bd3ca76-be5d-4e7c-9e4a-b8fb40a00016', 'quantite': '60 g'}, {'ingredient_id': 'cbf5f86a-e708-4469-a130-7c1c61d18323', 'quantite': '100 g'}, {'ingredient_id': 'cb58f63a-5c12-49d7-b9de-d900098ac23c', 'quantite': '1 cuillères'}, {'ingredient_id': 'a61d9237-c0c4-4350-a7a9-d4daec131165', 'quantite': '1 cuillères'}, {'ingredient_id': '2b8dfc80-3926-4cf4-ac2b-9f8c11e2a78a', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (337257, 'Entremets Framboises, Chocolat au Lait et Vanille', 'chocolat au lait, beurre doux, jaune d''oeuf, blanc d''oeuf, sucre, farine, noisettes, sucre, eau, pralin, chocolat au lait, crêpe dentelle, coulis de framboise, jus de citron, gélatine, crème liquide, blanc d''oeuf, sucre, eau, coulis de framboise, sucre, gélatine, lait entier, extrait de vanille, sucre, jaune d''oeuf, vanille, gélatine, crème fraîche liquide, crème fraîche épaisse, sucre glace, sucre glace, amandes, cacao, blanc d''oeuf, sucre en poudre, chocolat au lait, jaune d''oeuf, sucre, crème fraîche, framboises', '360 min', ['Pour le biscuit génoise au chocolat au lait : Beurrez un moule à fond amovible ou un carré à entremets de 20×30 cm ou de 25×25 cm. Le moule doit être plus grand que l’entremets final de sorte qu’on puisse découper la génoise à la bonne taille et ainsi éviter les côtés croustillants, irréguliers ou rétrécis.', 'Préchauffez le four à 170°C (thermostat 5-6).', 'Faites fondre le chocolat et le beurre au bain-marie. Laissez refroidir puis incorporez les jaunes d’oeufs. Battez les oeufs en neige. Quand ils sont mousseux, versez le sucre en pluie pendant que le batteur est toujours en marche. Battez jusqu’à l’obtention d’une meringue ferme. Incorporez délicatement à la spatule le chocolat à la meringue. Ajoutez la farine tamisée. Enfournez pendant 15 minutes. Laissez refroidir avant de découper. Garnissez les parois du carré à entremets avec du papier ciré ou du film rhodoïde. Placez la génoise au fond du moule..', 'Pour la feuilletine praliné : Vous pouvez réaliser le praliné feuillantine avec du pralin acheté en grande surface, mais voici comment je prépare le mien. Certes, cela prend du temps mais c’est tellement moins cher et si délicieux. De plus, il est pratique d’en préparer de grandes quantités à conserver et ressortir pour des utilisations ultérieures. ', 'Pralin maison : si vos noisettes sont déjà mondées, vous pouvez ignorer les prochaines étapes. Sinon, vous devez les peler. Préchauffez votre four à 190°C (thermostat 6-7) et faites cuire les noisettes pendant 15 minutes. Quand elles sont suffisamment refroidies pour être manipulées, enveloppez-les dans un torchon et secouez vigoureusement. La peau des noisettes va commencer à se détacher. Attention, cette étape peut être un peu salissante. Ensuite, tout ce qu’il vous reste à faire, c’est d’enlever le reste de la peau avec les doigts ou un petit couteau. Cela peut prendre un peu de temps. ', 'Quand les noisettes sont mondées, faites bouillir le sucre avec l’eau. Ajoutez les noisettes d’un coup et mélangez bien pour bien enrober les fruits secs de sirop. Retirez du feu et continuer à mélanger avec la cuillères en bois jusqu’à ce que le sucre cristallise. Remettez sur le feu et faites refondre le sucre jusqu’à l’obtention d’une caramel. Versez sur du papier sulfurisé et laissez refroidir. Broyez les noisettes et mixez-les au robot. Mixez jusqu’à l’obtention d’une pâte souple.', 'Feuilletine : Faites fondre le chocolat au bain-marie. Retirez du feu et incorporez le pralin et les crêpes dentelles.  Versez le mélange sur la couche de génoise. Placez l’entremets au réfrigérateur.', 'Pour le bavarois aux framboises : faites ramollir les feuilles de gélatine dans de l’eau froide pendant 5 minutes. Portez le coulis de framboises et le jus de citron à ébullition. Incorporez la gélatine, mélangez bien et laissez refroidir. Fouettez la crème en chantilly et mettez au frigo. Quand le mélange à base de framboises a refroidi, incorporez le à la chantillty. Laissez reposer au réfrigérateur.', 'Versez les blancs d’oeufs dans le bol de votre batteur. Faites bouillir le sucre et l’eau. Quand le sirop atteint 100°C, commencez à battre les blancs d’oeufs à vitesse maximale. Quand le sirop atteint 117°C, retirez du feu et versez sur la meringue en train de battre. Fouettez jusqu’à refroidissement. Incorporez 145 g de la meringue italienne à la chantilly. Versez dans le carré à entremets. Laissez prendre au congélateur.', 'Pour la gelée de framboises : faites ramollir les feuilles de gélatine dans de l’eau froide pendant 5 minutes. Portez le coulis de framboises et le sucre à ébullition. Incorporez la gélatine, mélangez bien et laissez refroidir. Versez doucement sur la couche de mousse à la framboises (soyez sûrs que la mousse soit suffisamment ferme pour qu’on y verse la gelée). Remettez au congélateur pour faire prendre.', 'Pour la mousse à la vanille : faites ramollir les feuilles de gélatine dans de l’eau froide pendant 5 minutes. Mélangez les jaunes d’oeufs, le sucre et le pudding. Portez le lait et la vanille à ébullition. Retirez du feu et versez sur le mélange aux jaunes d’oeufs et ajoutez la gélatine. Mélangez bien et reversez dans la casserole. Remettez sur le feu et faites épaissir. Couvrez de film alimentaire et laissez refroidir au réfrigérateur. Fouettez la crème en chantilly. Quand la crème vanille est froide, incorporez-la à la chantilly. Étalez sur la gelée de framboises. Laissez prendre au congélateur.', 'Pour la crème chantilly : fouettez la crème en chantilly et ajoutez-y le sucre glace. Étalez sur la couche de mousse à la vanille. Placez au frigo pour faire prendre.', 'Pour les macarons au chocolat au lait :', 'Coques de macarons : mixez finement et longuement le sucre glace, la poudre d’amandes et le cacao. Battez les oeufs en neige. Quand ils deviennent mousseux, versez le sucre en pluie sur les blancs en train de battre jusqu’à l’obtention d’une meringue ferme. Quand on retire les fouets, la meringue doit former de beaux becs d’oiseaux. Incorporez le mélange de poudres à la meringue à l’aide d’une spatule. Couchez de petits dômes de pâte sur du papier sulfurisé à l’aide d’une poche à douille munie d’une douille lisse. Laissez reposer pendant 25 minutes. Préchauffez le four à 150°C (thermostat 5). Enfournez pendant 12 minutes. Laissez refroidir.', 'Ganache au chocolat au lait : blanchissez les jaunes d’oeufs avec le sucre. Portez la crème à ébullition. Versez sur les jaunes d’oeufs. Mélangez bien et réchauffez sur le feu pour épaissir. Versez le mélange sur le chocolat. Mélangez bien pour faire fondre ce dernier. La ganache une fois froide, garnissez une coque de macaron à l’aide d’une poche à douille. Remplissez généreusement et placez une seconde coque par dessus la crème. Procédez de la sorte pour tous les macarons.', 'Assemblage : congelez l’entremets pendant plusieurs heures (au moins 4 heures à mon avis). De cette manière, la mousse sera plus facile à découper et gardera sa forme. ', 'Sortez l’entremets du congélateur. Découpez-le en 12 ou 16 parts. Décorez chacune d’entre elles avec un macaron et une framboise fraîche. Placez au réfrigérateur avant de servir.', 'Vous pouvez également garnir de coulis de framboise s’il vous en reste. ', 'Bonne dégustation !'], ['Louche', 'Pince de cuisine', 'Balance de cuisine'], ['difficile', 'recettes de cuisine', 'plat', 'cocktail', 'entremets', 'sucre', 'plat de résistance', 'chocolat au lait', 'jaune d''oeuf', 'Entremets Framboises', 'moyen', 'recette', 'beurre doux', 'cuisine', 'blanc d''oeuf', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'Chocolat au Lait et Vanille', 'confiserie', 'farine'], 'Dessert', b8fffdeb-622b-4462-a8ce-7716d7b3eaa2, '2025-09-26T15:15:58.093707', [{'ingredient_id': 'c69f80b3-9cc8-4f8b-ba7f-62cc123bb2ed', 'quantite': '60 g'}, {'ingredient_id': '824af0af-0315-4773-a159-c1e2f315a877', 'quantite': '40 g'}, {'ingredient_id': '9f0c6f30-6f60-4902-a61b-53763dd568e1', 'quantite': '55 g'}, {'ingredient_id': 'c1e8bf14-26dd-4287-b1da-ce6822c210ac', 'quantite': '85 g'}, {'ingredient_id': '58f9642a-067d-433c-b985-8b74ba10e4c6', 'quantite': '40 g'}, {'ingredient_id': '8b665a65-5d71-40d8-a2ec-48fd3d8b4c85', 'quantite': '40 g'}, {'ingredient_id': '5fa2fd87-18d8-450a-811c-8519b99b9fbf', 'quantite': '100 g'}, {'ingredient_id': '88367f97-a1e8-48fa-9b4c-5f77e182ad56', 'quantite': '100 g'}, {'ingredient_id': 'f7db29da-24d6-4a19-aeac-381f00d3f783', 'quantite': '2 cl'}, {'ingredient_id': 'b2480ac4-0d48-40fe-a15c-b6f8968c345d', 'quantite': '100 g'}, {'ingredient_id': '0d598625-705d-4766-bcf9-0dd320f49bb8', 'quantite': '115 g'}, {'ingredient_id': '03e01ea1-8991-484b-ae1b-424e4752dc09', 'quantite': '85 g'}, {'ingredient_id': '466d3e4a-9589-4286-9b28-8be2ec3cb0ec', 'quantite': '180 g'}, {'ingredient_id': 'ec052600-451a-4226-a9c7-e24e15cdde8a', 'quantite': '30 g'}, {'ingredient_id': '2f8d9304-31e8-4dd2-9354-33c65b3903a5', 'quantite': '6 g'}, {'ingredient_id': 'd792cefd-3c1f-4b9a-ab72-1db2dda69d2c', 'quantite': '11 cl'}, {'ingredient_id': '60e40d57-0295-436a-8073-12b1801243cb', 'quantite': '85 g'}, {'ingredient_id': '7b130481-5c5f-4bd0-ad97-214da214cec8', 'quantite': '170 g'}, {'ingredient_id': '4705f206-70ab-4076-aebf-e5ff9a8a57ec', 'quantite': '3.5 cl'}, {'ingredient_id': '034c0dca-c81a-46ca-ae22-0fc09eafb56b', 'quantite': '190 g'}, {'ingredient_id': 'c2b59d60-dd29-4027-902d-65f0e916b55f', 'quantite': '30 g'}, {'ingredient_id': '005ce8ae-113b-4691-adb6-dcfd7a524404', 'quantite': '6 g'}, {'ingredient_id': '75418a54-13be-4951-b053-5f1ffb274ce1', 'quantite': '31 cl'}, {'ingredient_id': 'bb54593a-afeb-49d3-9785-307e9f00c1b5', 'quantite': '1 cuillères'}, {'ingredient_id': '33ea5272-b390-42e3-9c79-2b47beaf2e2b', 'quantite': '65 g'}, {'ingredient_id': 'f02139fe-4c13-45ec-823e-23c9c64ac161', 'quantite': '50 g'}, {'ingredient_id': '8d2579ee-b5eb-48b5-bb51-7df99d597803', 'quantite': '25 g'}, {'ingredient_id': 'ef2fee7d-ec54-4487-81b2-8484cd4b340f', 'quantite': '4 g'}, {'ingredient_id': 'f9d9ffc0-aa27-49ec-a127-b6c637b7c6a5', 'quantite': '20 cl'}, {'ingredient_id': '89e7a9f6-d956-4433-9699-3a35d1643bbb', 'quantite': '150 g'}, {'ingredient_id': '4ab73831-0b5b-491e-a2f2-7f5821195e75', 'quantite': '3 cuillères'}, {'ingredient_id': '7762aedf-7628-48fe-95d6-2f8d3840f8a0', 'quantite': '120 g'}, {'ingredient_id': 'bebf905f-c1bd-4b89-b998-e6dafb52d212', 'quantite': '80 g'}, {'ingredient_id': '62cbd25d-f38f-4e23-af98-c22500958727', 'quantite': '2 cuillères'}, {'ingredient_id': 'a91ba422-12c8-4177-834a-2455e2243d80', 'quantite': '80 g'}, {'ingredient_id': '886a39ce-7034-499c-89ef-e603cb5be89b', 'quantite': '60 g'}, {'ingredient_id': '016c5219-7d4f-4e42-a783-27a3bebfc11f', 'quantite': '100 g'}, {'ingredient_id': '969de7aa-8089-4116-8934-67513552d92c', 'quantite': '2'}, {'ingredient_id': '58eef3ab-e23f-4598-8e9d-27f187cdd0de', 'quantite': '65 g'}, {'ingredient_id': '768fdf36-c440-44d3-99b2-3ef120cfb24c', 'quantite': '6.5 cl'}, {'ingredient_id': 'f3ead4e8-34c2-4aff-a74a-9897f64f1d00', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14304, 'Tarte à la rhubarbe et aux fraises meringuée', 'pâte brisée, rhubarbe, fraises, sucre semoule, oeuf, sel, sucre glace', '50 min', ['Epluchez la rhubarbe en ôtant la pellicule qui recouvre les tiges. Coupez-la en tronçons et faites-les cuire de 12 à 15 mn à feu doux avec 200 g de sucre.', 'Lavez, equeutez et coupez les fraises en morceaux. Saupoudrez-les du reste de sucre.', 'Diposez sur la pâte une feuille de papier sulfurisé et couvrez la de haricots secs.', 'Enfournez pour 10 minutes. Retirez papier et haricots.', 'Prélevez la rhubarbe avec une écumoire et déposez-la sur la pâte.', 'Répartissez alors les fraises et leur jus dessus et enfournez pour 10 mn.', 'Parez la meringue : fouettez les blancs oeufs, additonnés d''une pincée de sel, en neige très ferme. Incorporez peu à peu le sucre glace.', 'Sortez la tarte, étalez la meringue dessus et remettez au four (thermostat 5) pendant 10 mn jusqu''à ce que les blancs prennent couleur.'], ['Balance de cuisine', 'Presse-agrumes', 'Moule à tarte', 'Fouet'], ['recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'tarte aux fraises', 'bon marché', 'oeuf', 'pâte brisée', 'rhubarbe', 'sel', 'recette', 'fraises', 'cuisine', 'Tarte à la rhubarbe et aux fraises meringuée', 'testées', 'sucre glace', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'sucre semoule'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:16:02.998900', [{'ingredient_id': '7cef05f2-bf77-4ac3-834f-bd1bd42b3e84', 'quantite': '300 g'}, {'ingredient_id': 'ecd542e4-68bb-4910-b481-f55fc54b2317', 'quantite': '500 g'}, {'ingredient_id': '904adc2d-3480-4075-8d0d-74a7ff5388c4', 'quantite': '250 g'}, {'ingredient_id': '689e35e0-f8e3-4459-9700-ecebca0693a0', 'quantite': '250 g'}, {'ingredient_id': 'e1c716de-796b-4243-bf76-4627ebdd14f0', 'quantite': '3'}, {'ingredient_id': '91eb33e7-7a8e-4267-b151-c5b40eac642b', 'quantite': '1'}, {'ingredient_id': 'f132f4a0-5189-4734-93b5-42fd03090bf6', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70589, 'Verrines de tiramisu aux framboises croustillant', 'mascarpone, oeuf, sucre glace, sucre vanillé, gâteaux, framboises, coulis de framboise, menthe', '20 min', ['Mélanger le mascarpone avec les jaunes d''oeuf, ajouter le sucre glace et le sucre vanillé.', 'Monter les blancs en neige bien ferme, puis les incorporer au mascarpone, en remuant délicatement pour que le mélange soit bien aéré.', 'Prendre 6 verrines de taille moyenne, mettre au fond de chacune 1/2 spritz émietté, ensuite une cuillère à soupe de préparation au mascarpone, puis des framboises et un peu de coulis.', 'Rajouter 1/2 spritz émietté, du mascarpone et terminer avec du coulis.', 'Pour finir, disposer la feuille de menthe au dessus de la verrine pour apporter de la couleur et de la fraîcheur.'], ['Batteur électrique', 'Poêle', 'Planche à découper', 'Économe', 'Tire-bouchon'], ['sucre vanillé', 'recettes de cuisine', 'plat', 'cocktail', 'menthe', 'plat de résistance', 'bon marché', 'oeuf', 'framboises', 'Verrines de tiramisu aux framboises croustillant', 'tiramisu', 'rapide', 'recette', 'cuisine', 'coulis de framboise', 'testées', 'sucre glace', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'mascarpone', 'confiserie', 'gâteaux'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:16:07.668014', [{'ingredient_id': '6be1404c-2d0c-44e6-8667-856dd9c6406e', 'quantite': '500 g'}, {'ingredient_id': '62187c05-ec5a-4679-9f12-6eaae092529a', 'quantite': '2'}, {'ingredient_id': '9bd250ea-86d2-4bde-96a6-7ef443fe3616', 'quantite': '150 g'}, {'ingredient_id': 'efe51ba1-c04c-4f6b-9eee-54073b7c8916', 'quantite': '1'}, {'ingredient_id': '81ff5ad1-54ef-4075-9181-068d9afa7b33', 'quantite': ''}, {'ingredient_id': '77446e71-4ab0-4954-bd41-0be9e5421590', 'quantite': '300 g'}, {'ingredient_id': '7b467802-c589-4ea0-9252-3f4b20212561', 'quantite': '20 cl'}, {'ingredient_id': '35d6c7ea-38fd-4135-8eef-c68e20d9203c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11104, 'Vin de fraises', 'fraises, vin blanc, sucre', '10 min', ['Écraser les fraises bien mûres, ajouter le vin et le sucre.', 'Remuer et laisser reposer 1 jour.', 'Filtrer et embouteiller.', 'Pour une meilleure conservation, on peut cuire le vin avant de l''embouteiller, mais l''arôme sera moins fin.'], ['Moule à tarte', 'Presse-agrumes'], ['recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'vins de fruits', 'bon marché', 'rapide', 'recette', 'vin blanc', 'fraises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'Vin de fraises', 'recettes', 'confiserie'], 'Boisson', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:16:13.639285', [{'ingredient_id': '21cfe7a3-c8e4-47ed-a51f-56e025734a7a', 'quantite': '1 kg'}, {'ingredient_id': 'd47bf41e-06f3-40a5-8133-78731c5c537e', 'quantite': '2.5 l'}, {'ingredient_id': '58127f5d-e94b-489e-87b8-dd6835120872', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228915, 'Mini gateau aux fraises Tagada', 'fraises tagada®, farine, sucre en poudre, beurre demi-sel, oeuf, lait', '20 min', ['Préchauffer votre four à 200°C (thermostat 6-7).', 'Faire fondre dans une casserole à feu doux les fraises, le lait et le beurre préalablement coupé en morceaux, mélanger régulièrement.', 'D''autre part battre les œufs entiers avec le sucre.', 'Lorsque le mélange Tagada ® est bien fondu, laisser un peu tiédir et ajouter le au mélange œufs-sucre.', 'En dernier ajouter la farine, bien mélanger afin d''obtenir une pâte bien lisse.', 'Remplir des petits moules en silicone au 3/4 et enfourner pour 20 min'], ['Planche à découper', 'Ouvre-boîte', 'Verre doseur'], ['', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'oeuf', 'fraises tagada®', 'Mini gateau aux fraises Tagada', 'recette', 'sucre en poudre', 'cuisine', 'beurre demi-sel', 'lait', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'farine'], 'Dessert', fee345e3-4aec-4ceb-8e51-2d379e5ea066, '2025-09-26T15:16:17.092905', [{'ingredient_id': '6c5fe95e-02cc-4bb8-9685-b4b67fab4b6a', 'quantite': '25'}, {'ingredient_id': '82b15273-ad96-488e-b792-4ded2c346ca6', 'quantite': '80 g'}, {'ingredient_id': 'fae79f09-475e-4836-bb54-52faebfedce3', 'quantite': '70 g'}, {'ingredient_id': '2c6fec67-200f-4222-a0db-9795f1d425ad', 'quantite': '75 g'}, {'ingredient_id': 'ce93c8f0-3790-49d7-8c9d-54341797656e', 'quantite': '2'}, {'ingredient_id': 'df4084e3-ae95-4b17-92fd-fe1ef9c870ae', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50497, 'Tarte tatin pomme poire', 'farine, beurre, sucre, sel, eau, cannelle, pomme, sucre, beurre, eau, vinaigre balsamique', '35 min', ['Préparer la pâte :', 'Tamiser la farine puis ajouter le sucre et le sel puis le beurre fondu.', 'Mouiller d''eau, former une boule de pâte et laisser reposer pendant au moins 1 heure.', 'Préchauffer le four à 180°C (thermostat 6) et préparez la garniture :', 'Eplucher les fruits et les couper en gros morceaux.', 'Faire fondre le beurre dans une poêle, y ajouter les fruits, faire revenir 2 minutes puis ajouter le sucre et l''eau pour faire un léger caramel autour des fruits.', 'Incorporer le vinaigre et la moitié de la cannelle puis laisser cuire 10 minutes.', 'Si les fruits ne sont pas moelleux, prolonger la cuisson de 5 minutes puis saupoudrer du reste de cannelle.', 'Beurrer le moule et déposer les fruits avec leur caramel au fond.', 'Recouvrir de la pâte étalée en enfonçant les bords au fond du plat.', 'Enfourner pour 30 minutes de cuisson.', 'Laisser refrodir et démouler.'], ['Passoire', 'Spatule', 'Planche à découper', 'Rouleau à pâtisserie'], ['recettes de cuisine', 'plat', 'cocktail', 'sucre', 'Tarte tatin pomme poire', 'eau', 'plat de résistance', 'bon marché', 'sel', 'recette', 'cuisine', 'tarte Tatin', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:16:22.962406', [{'ingredient_id': 'dbbc7742-4caa-4c81-8ce5-130906f758eb', 'quantite': '250 g'}, {'ingredient_id': '6fbe58af-f615-4404-8ea0-6aa20a8943a6', 'quantite': '150 g'}, {'ingredient_id': 'ff8b056c-b6b0-4dac-9d59-8a6090bc12e3', 'quantite': '100 g'}, {'ingredient_id': '6c8386fe-7d31-4ad6-b135-0a3cd8e5ce5c', 'quantite': ''}, {'ingredient_id': 'fdb663b6-2b84-4a83-a388-7f26c4f7e3ae', 'quantite': '2 cuillères'}, {'ingredient_id': '0d42e663-8683-4417-950a-c625d04116e4', 'quantite': '2 cuillères'}, {'ingredient_id': '7659a382-119d-4257-9698-9dae95bff15f', 'quantite': ''}, {'ingredient_id': '5b4ee98c-17e8-4aab-b63a-fef5460d686c', 'quantite': '100 g'}, {'ingredient_id': '40e8edc7-a3dc-4f97-a36d-33ec5f86c77c', 'quantite': '30 g'}, {'ingredient_id': '12dce3d1-0914-499a-a9d5-16895871e206', 'quantite': '1 cuillères'}, {'ingredient_id': '5d6f33fa-100c-4575-8254-26a355c27941', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34545, 'Compote de pommes (avec morceaux) de Marielle', 'pomme, sucre roux, sucre vanillé, cannelle, beurre', '10 min', ['Eplucher et couper les pommes en gros morceaux. ', 'Mettre les pommes dans une casserole sur feu assez fort avec 2 cuillères à soupe d''eau. Dès l''ébullition mettre à feu moyen et ajouter le sucre de canne et le sucre vanillé. Mélanger et faire cuire en remuant de temps en temps. ', 'Lorsque les pommes sont fondues (et qu''il n''y a plus d''eau) ajouter la cannelle et le beurre. Bien mélanger et casser les morceaux de pomme s''ils ne se sont pas défaits tout seuls. Laisser cuire encore 2-3 mn. C''est prêt !'], ['Tire-bouchon', 'Planche à découper'], ['', 'cannelle', 'sucre vanillé', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'recette', 'cuisine', 'sucre roux', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'Compote de pommes (avec morceaux) de Marielle'], 'Accompagnement', 70389b44-239e-467b-b12a-512157644eb3, '2025-09-26T15:16:29.651696', [{'ingredient_id': 'a1db12f4-1d1e-47ad-84f9-0da1bf72d01b', 'quantite': '3'}, {'ingredient_id': '4fb1e481-c498-4e0e-a1aa-809ad5afa852', 'quantite': '2 cuillères'}, {'ingredient_id': 'c54804e7-0694-4533-96e8-77f6d47bb5b2', 'quantite': '1'}, {'ingredient_id': '424bbcfd-ef9d-48f0-8a74-6b4d52539c15', 'quantite': ''}, {'ingredient_id': '3fa434b1-2fdc-4a9c-aa11-84cd1c6bcaa5', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37813, 'Trifle aux fraises', 'fraises, fromage blanc, blanc d''oeuf, sucre, biscuits à la cuillère', '20 min', ['Mélanger le fromage blanc et le sucre. ', 'Battre au fouet quelques minutes pour rendre le mélange mousseux.', 'Battre les blancs d’œuf en neige.', 'Les incorporer au fromage blanc.', 'Séparer la mousse en deux parts.', 'Mixer 5 ou 6 fraises. Les ajouter à une moitié de la mousse.', 'Couper 4 biscuits en 4 ou 6 morceaux. ', 'Les disposer au fond du verre.', 'Monter le trifle en déposant une couche de mousse à la fraise, puis quelques fraises coupées en morceaux, une couche de mousse nature, quelques fraises.', 'Finir par un peu de mousse à la fraise (sans complètement recouvrir le verre), un demi-biscuit et une demi-fraise.', 'Mettre au frais jusqu’au moment de servir.'], ['Casserole', 'Louche'], ['', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'Trifle aux fraises', 'sucre', 'plat de résistance', 'fromage blanc', 'biscuits à la cuillère', 'bon marché', 'rapide', 'recette', 'fraises', 'cuisine', 'blanc d''oeuf', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', f506d67e-695b-41d9-a30b-4766547f43a7, '2025-09-26T15:16:36.579409', [{'ingredient_id': '8874e7b1-0a65-4fab-a0f5-9054902e3144', 'quantite': '250 g'}, {'ingredient_id': '70b1198a-2c60-462f-8c69-7e479ed80207', 'quantite': '400 g'}, {'ingredient_id': '9204fec2-858c-49a8-a994-ded6ce43cf0e', 'quantite': '2'}, {'ingredient_id': '8d2eda4d-8985-4120-b2ac-8e8ec95ad648', 'quantite': '3 cuillères'}, {'ingredient_id': 'bd8d6c56-d538-4141-a68d-9f7233d9d7d0', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34199, 'Bûche Choco-Framboise', 'oeuf, beurre, cacao, farine, sucre en poudre, liqueur de framboise, chocolat noir, chocolat au lait, crème liquide, beurre tendre, framboises, pistaches, sucre glace', '60 min', ['Pour la garniture, casser 300 g de chocolat noir. Portez la crème liquide à ébullition, en dehors du feu versez-y le chocolat en plusieurs fois. Remuez, laisser tiédir, incorporez le beurre. Réserver 1 heure à température ambiante. ', 'Faites bouillir 10 cl d''eau et 80 g de sucre. Hors du feu, ajouter l''alcool et laisser refroidir. ', 'Mélanger la farine et le cacao. Tapisser une plaque de papier de cuisson beurré. Fouettez les jaunes d''oeufs et 100 g de sucre jusqu''à ce que le mélange blanchisse. Montez les blancs en neige, incorporez-les délicatement aux jaunes, puis verser la farine au cacao et enfin le beurre fondu. ', 'Étaler la pâte sur le papier à 1 cm d''épaisseur, enfournez 8 min à four chaud Th 7. Retournez la plaque sur un torchon humide, décollez le papier de cuisson, puis enroulez le biscuit, le temps qu''il refroidisse. ', 'Déroulez puis imbibez-le de sirop. ', 'Étaler les deux-tiers de la ganache sur le biscuit. Ajouter une rangée de framboise à 2 cm du bord le plus petit. Roulez le biscuit (les framboises se trouvent au centre). Recouvrez-le du reste de ganache. ', 'Avec le reste du chocolat, faites des copeaux : le placer une heure au froid puis à l''aide d''un éplucheur, confectionner les copeaux. Placez-les sur la bûche puis garder au frais une nuit. ', 'Le jour même décorer avec le reste des framboises et les pistaches.'], ['Presse-agrumes', 'Fouet', 'Balance de cuisine', 'Ouvre-boîte'], ['moyenne', 'recettes de cuisine', 'plat', 'cocktail', 'bûche framboise', 'plat de résistance', 'bon marché', 'oeuf', 'cacao', 'liqueur de framboise', 'recette', 'sucre en poudre', 'cuisine', 'Bûche Choco-Framboise', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:16:41.468178', [{'ingredient_id': 'bcb54a22-62c8-4256-8889-cbd3ee102bf9', 'quantite': '4'}, {'ingredient_id': '84b7225a-fc58-4d0e-bd3c-0173e44b3e91', 'quantite': '40 g'}, {'ingredient_id': '8ea0ab99-1469-4e40-b392-d21183cd9f68', 'quantite': '20 g'}, {'ingredient_id': 'a3c004da-15a4-4836-b898-fd2cef25cd1b', 'quantite': '100 g'}, {'ingredient_id': '78f32b3b-2070-4e9b-9072-534e166c800a', 'quantite': '180 g'}, {'ingredient_id': 'f3e2641e-ce12-45a1-a25c-9b667423cc66', 'quantite': '6 cuillères'}, {'ingredient_id': '5b0ff6e1-2649-4054-ab15-ecf5c01c62e0', 'quantite': '350 g'}, {'ingredient_id': '5f7e5e0f-1c01-41ee-826f-bffeff609125', 'quantite': '50 g'}, {'ingredient_id': '7a91eada-8454-441f-a739-e92bbc50997b', 'quantite': '30 cl'}, {'ingredient_id': 'a870a248-a19e-4d8b-a1c2-553c6ac81d61', 'quantite': '50 g'}, {'ingredient_id': 'fca0e671-eda6-4d89-a6e0-59457d6c511e', 'quantite': '300 g'}, {'ingredient_id': 'a050e015-019e-4040-9c05-c016e34358d5', 'quantite': '1 cuillères'}, {'ingredient_id': '7d301e1e-e850-421e-9dff-05274f639312', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12044, 'Tarte aux pommes et à la cannelle', 'pâte brisée, pomme, sucre roux, cannelle, beurre', '30 min', ['Etaler la pâte à tarte. ', 'Couper les pommes en lamelles, garnir la pâte avec les lamelles de pomme, puis saupoudrer de sucre roux et de cannelle.', 'Mettre la noix de beurre au milieu de la tarte, et enfourner à 180°C (thermostat 6) pendant 30 min.'], ['Moule à tarte', 'Casserole', 'Ouvre-boîte'], ['cannelle', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'Tarte aux pommes et à la cannelle', 'plat de résistance', 'pâte brisée', 'moyen', 'recette', 'tarte aux pommes', 'cuisine', 'sucre roux', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:16:48.004994', [{'ingredient_id': '5b4213bf-be85-4210-81d4-237e3ce6c095', 'quantite': ''}, {'ingredient_id': 'fa8d9d7d-cc2d-483d-a003-67a8d5f791c1', 'quantite': '6'}, {'ingredient_id': '9c56cc08-293b-4582-b4fb-7063ee0e599e', 'quantite': '50 g'}, {'ingredient_id': '416ecab4-5fce-4e59-b125-547edd48fbbb', 'quantite': ''}, {'ingredient_id': '14af291b-0285-4d20-9e2b-8c45252eb6c8', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15419, 'Gâteau au chocolat fourré aux framboises', 'framboises, mousse au chocolat, chocolat pâtissier, beurre, oeuf, farine, sucre semoule, coulis de framboise', '15 min', ['Faites fondre le beurre et les morceaux de chocolat: mettez-les 5 mn au bain-marie en mélangeant ou laissez-les 1 mn au micro-ondes. Lissez-bien.', 'Mélangez les oeufs, la farine et le sucre au mixeur ou au fouet. Incorporez le chocolat et le beurre fondu.', 'Beurrez et farinez un moule assez haut, de 20 cm environ de diamètre. Faites cuire la préparation au four pendant 35 mn à 170°C', 'Laissez refroidir, démoulez et coupez le gâteau en deux dans l''épaisseur. Saupoudrez les framboises de sucre glace, fourrez le gâteau d''une couche de mousse au chocolat et de framboises, puis refermez.', 'Avant de servir, nappez de coulis de framboises (facultatif).'], ['Rouleau à pâtisserie', 'Spatule', 'Casserole', 'Économe', 'Passoire'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'gâteau au chocolat', 'plat de résistance', 'chocolat pâtissier', 'oeuf', 'framboises', 'moyen', 'recette', 'Gâteau au chocolat fourré aux framboises', 'cuisine', 'coulis de framboise', 'testées', 'entrée', 'dessert', 'mousse au chocolat', 'boisson', 'recettes', 'beurre', 'confiserie', 'sucre semoule', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:16:55.014250', [{'ingredient_id': '5fe55b02-e22e-43a4-a1eb-bd1c59723f31', 'quantite': '100 g'}, {'ingredient_id': 'c797329e-5bc6-40be-afb1-66d8ed422d4b', 'quantite': '100 g'}, {'ingredient_id': '62e938e2-7799-4c2c-88b2-888c58728d41', 'quantite': '150 g'}, {'ingredient_id': 'f887e87d-8808-4d7f-b112-331558ee32f2', 'quantite': '140 g'}, {'ingredient_id': 'd9ecd0a1-7199-4d9f-9670-862d7ac0dfb9', 'quantite': '4'}, {'ingredient_id': 'a39e3ebe-2371-40bf-a40f-7ab773aaa904', 'quantite': '80 g'}, {'ingredient_id': '9b2895c3-c408-42bd-88f5-8f6f4535f6cd', 'quantite': '150 g'}, {'ingredient_id': 'aca65133-8c52-4f41-b861-9e10680d33d3', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16618, 'Quatre quart à la noix de coco et aux framboises', 'sucre, oeuf, beurre, farine, levure, framboises, noix de coco rapée', '15 min', ['Faire fondre le beurre. Battre les jaunes et le sucre jusqu’à ce que le mélange blanchisse, puis ajouter beurre, farine, levure et 50 g de noix de coco.', 'Fouetter les blancs en neige et les incorporer.', 'Verser dans un moule antiadhésif, parsemer de framboises et de la noix de coco restante.', 'Cuire 40 mn à 180°C, servir avec un coulis de framboise.'], ['Rouleau à pâtisserie', 'Pince de cuisine', 'Planche à découper', 'Moule à tarte'], ['recettes de cuisine', 'plat', 'cocktail', 'noix de coco rapée', 'sucre', 'plat de résistance', 'bon marché', 'oeuf', 'framboises', 'quatre quarts', 'levure', 'recette', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'farine', 'Quatre quart à la noix de coco et aux framboises'], 'Dessert', 809424bb-2e2b-48b8-89ae-9224f6d72c20, '2025-09-26T15:16:58.614164', [{'ingredient_id': 'cf497f01-ae2b-4bd1-a508-7575dc5d4313', 'quantite': '180 g'}, {'ingredient_id': 'fa942375-7374-46eb-b277-ed306f1ab46e', 'quantite': '4'}, {'ingredient_id': '13460cc7-3c2c-4e58-a3a5-a785e40a78d4', 'quantite': '200 g'}, {'ingredient_id': '3aef05b9-cb2c-4f97-85c6-5ed3e31fa73d', 'quantite': '120 g'}, {'ingredient_id': '7a42e9eb-bb5a-4f91-acd8-213670fd3dc5', 'quantite': '1 cuillères'}, {'ingredient_id': '4e96ee1f-9188-48ee-9e12-b99513c4087e', 'quantite': '250 g'}, {'ingredient_id': 'd3d87585-3109-4a53-9084-d8c058f0df89', 'quantite': '60 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72925, 'Verrine croquante aux fraises', 'fraises, mascarpone, spéculoos, sucre, citron', '15 min', ['Rincer les fraises et les couper en petits morceaux.', 'Mélanger la mascarpone avec le sucre et le jus des citrons.', 'Ecraser les spéculoos grossièrement pour garder le coté croquant.', 'Dans des verres ou grosses verrines, déposer au fond les spéculoos, puis la mascarpone, et ensuite les fraises.', 'Renouveler la répartition en terminant par le mascarpone.', 'Mettre au frais au moins 2 h avant de servir.'], ['Couteau de chef', 'Fouet', 'Tire-bouchon'], ['', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'Verrine croquante aux fraises', 'citron', 'bon marché', 'rapide', 'recette', 'fraises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'mascarpone', 'confiserie', 'spéculoos'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:17:03.436232', [{'ingredient_id': 'ef88ae76-362d-4b5f-863f-0587b333d78e', 'quantite': '250 g'}, {'ingredient_id': '2497ddf4-8c5e-4061-bc77-935ee530a454', 'quantite': '200 g'}, {'ingredient_id': '0c94b30a-7b39-4be6-be45-c4bec8a4ac5c', 'quantite': '10'}, {'ingredient_id': 'f92b66b5-d409-40dd-8bc0-f4ccdc2796b6', 'quantite': '3 cuillères'}, {'ingredient_id': '61586d31-02d9-479c-a1ec-275e4a406f7f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72617, 'sorbet à la fraise sans sorbetière', 'fraises, citron, orange, sucre en poudre, crème semi-épaisse', '10 min', ['Equeuter les fraises.', 'Mixer le tout.', 'Mettre dans un moule en plastique style charlotte au congélateur.'], ['Poêle', 'Économe', 'Presse-agrumes', 'Balance de cuisine', 'Planche à découper'], ['sorbet à la fraise sans sorbetière', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'crème semi-épaisse', 'citron', 'bon marché', 'rapide', 'recette', 'sucre en poudre', 'orange', 'fraises', 'cuisine', 'sorbet', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', 845d82da-f9f1-43fa-81ee-b8cd9d0f73af, '2025-09-26T15:17:07.105310', [{'ingredient_id': 'c0f641a8-cdca-49e0-861c-cd1e7776a01c', 'quantite': '1 kg'}, {'ingredient_id': '387a5eae-dc9a-4d8f-9f3b-d18417a2d8e1', 'quantite': ''}, {'ingredient_id': '75c3b67a-3252-4902-824d-415d32403e2d', 'quantite': ''}, {'ingredient_id': '4be9558c-66a1-411a-a1a2-4ef26659391e', 'quantite': '600 g'}, {'ingredient_id': '4eda0af3-194f-45bd-938d-2995f3f59315', 'quantite': '1.5 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36356, 'Craquant crémeux aux fraises de Jeanne', 'fraises, brick, beurre, mascarpone, oeuf, arôme amande amère, sucre, sucre glace', '15 min', ['On se calme : ça a l''air long comme ça mais c''est ultra facile.', 'Découper six grands cercles (de taille identique) dans les feuilles de brick.', 'Les badigeonner de beurre fondu et les passer au four maximum dix minutes.', 'Elles doivent être croustillantes, et légèrement dorées', 'Attention: elles doivent pouvoir se détacher les unes des autres, il ne faut surtout pas qu''elle restent collées', 'Pendant que les feuilles de brick cuisent, laver les fraises, et les couper en tronçons.', 'Réserver dans un coin, sages.', 'Dans un saladier, battre le jaune d''oeuf (vous garderez le blanc pour faire des financiers ou ce que vous voulez, ce n''est plus mon problème...&nbsp;hé hé) avec le sucre jusqu''à ce que le mélange blanchisse et devienne un peu mousseux. Les courageux prendront le temps d''exécuter cette étape au bain marie de façon à obtenir une sorte de sabayon...&nbsp;mais ce n''est pas non plus hyper obligatoire.', 'Une fois le mélange mousseux obtenu, ajouter le mascarpone, et bien mélanger de façon à avoir une crème assez épaisse mais pas compacte.', '(Si vous le souhaitez vous pouvez à ce moment là ajouter quelques gouttes d''arôme d''amande amère)', 'Sur un plat, disposer deux feuilles de brick, y étaler la moitié de la crème et la moitié des fraises.', 'Recouvrir à nouveau de deux disques de brick, puis de crème, puis de fraises, puis à nouveau de deux cercles croustillants.', 'Placer au frais pendant 30 minutes.', 'Saupoudrer de sucre glace, décorer de feuilles de menthe et/ou de fraises finement découpées.', 'Servir, manger, miam!'], ['Batteur électrique', 'Ouvre-boîte'], ['', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'brick', 'bon marché', 'oeuf', 'rapide', 'recette', 'fraises', 'cuisine', 'arôme amande amère', 'Craquant crémeux aux fraises de Jeanne', 'sucre glace', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'mascarpone', 'confiserie'], 'Dessert', ab9c6417-e8c0-4553-af01-bc817f793788, '2025-09-26T15:17:14.090474', [{'ingredient_id': '01a2aa60-be31-4617-aa95-1775ba788eac', 'quantite': '250 g'}, {'ingredient_id': '5322baea-6334-4b9d-a622-4e2ac6483352', 'quantite': '6'}, {'ingredient_id': 'db858771-5fc3-4d17-9db9-e15a5468d0fa', 'quantite': ''}, {'ingredient_id': '59bc77c6-adf5-485e-b99e-4614583a9cce', 'quantite': '250 g'}, {'ingredient_id': '06b97ba8-05eb-4b9a-8118-7a641fa8bfce', 'quantite': '1'}, {'ingredient_id': '63beb869-9b5e-4dee-8ffd-c7f82377dc8e', 'quantite': ''}, {'ingredient_id': '74a795b1-e3b1-4e67-86da-d29acd097859', 'quantite': '60 g'}, {'ingredient_id': '7a06d24a-1b9f-4b7d-a879-508ec442c57a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68982, 'Tiramisu aux pommes caramélisées et à la cannelle', 'pomme, miel, beurre, mascarpone, oeuf, sucre, extrait de vanille liquide, cannelle, spéculoos', '30 min', ['Nettoyer les pommes et les éplucher. Les couper en petits dés. Les faire revenir dans une poêle avec le beurre pendant 3 minutes. Ajouter le miel et une cuillère à café de cannelle et laisser les pommes caraméliser jusqu''à ce qu''elle roussissent légèrement (environ 2 minutes).', 'Egoutter les pommes et réserver le jus.', 'Séparer les blancs et les jaunes d''oeufs.', 'Battre les jaunes et le sucre et une cuillère à café d''extrait de vanille jusqu''à ce que le mélange blanchisse. Ajouter le mascarpone et battre. (si possible utiliser un mixer électrique vitesse pour éviter les grumeaux.)', 'Monter les blanc en neige jusqu''à qu''ils soient bien fermes. Les incorporer délicatement à la préparation au mascarpone. ', 'Casser grossièrement les spéculoos et les imbiber du jus de cuisson des pommes.', 'Mettre la moitié des biscuits dans un plat ou dans des verres. Verser ensuite la moitié de la préparation. Mettre les reste des spéculos puis répartir les pommes. Verser le reste de la préparation.', 'Réserver au moins 4h au réfrigérateur. Au moment de servir, parsemer légèrement de cannelle.'], ['Moule à tarte', 'Verre doseur', 'Presse-agrumes', 'Passoire', 'Pince de cuisine'], ['cannelle', 'extrait de vanille liquide', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'Tiramisu aux pommes caramélisées et à la cannelle', 'bon marché', 'oeuf', 'miel', 'tiramisu', 'rapide', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'mascarpone', 'confiserie', 'pomme', 'spéculoos'], 'Dessert', b39f0d30-6afd-475a-abeb-97a3c0c2fef4, '2025-09-26T15:17:19.717583', [{'ingredient_id': '8056c7c8-a8f1-4eed-b3d3-c611cf0ce096', 'quantite': '3'}, {'ingredient_id': '803d3a89-a1a2-4eaf-a0c9-10df636ab12b', 'quantite': '3 cuillères'}, {'ingredient_id': '6ec7ef7d-46b4-47d7-bc41-80cd8b74e02f', 'quantite': '30 g'}, {'ingredient_id': 'f8aea131-6010-44d4-a538-dd2c62189b65', 'quantite': '250 g'}, {'ingredient_id': 'e39ea5db-725b-42cd-80ae-b4c64330c416', 'quantite': '3'}, {'ingredient_id': '1eca925f-5414-4250-b645-8ca364d41c57', 'quantite': '80 g'}, {'ingredient_id': 'bc0c8f74-b173-4c9f-a6c0-dd2dd6cd6136', 'quantite': ''}, {'ingredient_id': '5eca5426-1d2e-4658-aee0-4512c9a3e91a', 'quantite': ''}, {'ingredient_id': '3b5edb33-ade5-45f1-b310-8d989692190a', 'quantite': '15'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26447, 'Crème aux framboises express', 'framboises, crème, ricotta, lait, sucre', '5 min', ['Mixer tous les ingrédients ensemble et mettre au frais !'], ['Moule à tarte', 'Verre doseur', 'Batteur électrique'], ['', 'Crème aux framboises express', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'bon marché', 'framboises', 'rapide', 'recette', 'ricotta', 'cuisine', 'lait', 'crème', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', 44b1c168-5a3e-41ae-8d17-684ef6ba52de, '2025-09-26T15:17:24.264249', [{'ingredient_id': '1a9c1489-ced5-44eb-8b7c-15c88d37042e', 'quantite': '250 g'}, {'ingredient_id': 'b74563d2-e9e1-42ff-b633-c18dfdde596d', 'quantite': '20 cl'}, {'ingredient_id': '46756282-af29-4653-87eb-6625c4fd03c0', 'quantite': '250 g'}, {'ingredient_id': '05968151-df70-482d-9e1a-45b9ea265750', 'quantite': '6 cuillères'}, {'ingredient_id': '109e1a26-9e43-49a9-a181-5d83b7452cb7', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169175, 'Sucettes de fraises au chocolat', 'fraises, chocolat pâtissier', '10 min', ['Rincer les fraises et les sécher avec du papier absorbant de façon à ce qu''elles ne soient plus humides.', 'Mettre le chocolat cassé en morceaux dans une petite casserole et faire fondre au bain-marie.', 'Lorsque le chocolat est fondu, le remuer avec une cuillère en bois.
Piquer chaque fraise avec un pic en bois puis les enrober de chocolat.', 'Laisser durcir en piquant les sucettes sur un support.', 'Manger les sucettes dans la journée car les fruits s''abiment vite.'], ['Balance de cuisine', 'Économe', 'Spatule', 'Moule à tarte', 'Fouet'], ['', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'chocolat pâtissier', 'rapide', 'recette', 'Sucettes de fraises au chocolat', 'fraises', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Confiserie', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:17:29.006030', [{'ingredient_id': 'd128c424-86fd-4525-9245-0e0c91794557', 'quantite': '12'}, {'ingredient_id': '0aa98365-ff41-438b-bd1b-514110ce0274', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26866, 'Fondant aux pommes', 'pomme, sucre, farine, oeuf, crème fleurette, beurre, lait, levure chimique', '15 min', ['Allumer le four à thermostat 6 (180°C). ', 'Dans un bol, mettre la farine, le sucre, les oeufs, le beurre fondu, le lait, la crème et bien mélanger jusqu''à obtention d''une pâte bien lisse. ', 'Beurrer un plat rectangulaire de 20 cm sur 30 cm et verser la préparation dedans. ', 'Eplucher les pommes et les couper en fines lamelles de 2 mm environ. Mettre les pommes dans le plat, bien appuyer avec le doigt pour qu''elles pénètrent bien. Mettre 3 couches de pommes au moins et bien les recouvrir de pâte avant de mettre au four. ', 'Faire cuire 35 min environ. ', 'Pour les gourmands, on peut le saupoudrer de 25 g de sucre à la sortie du four. ', 'Quand il est refroidi, le couper en morceaux.'], ['Fouet', 'Poêle', 'Casserole', 'Batteur électrique'], ['', 'recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'sucre', 'Fondant aux pommes', 'plat de résistance', 'bon marché', 'oeuf', 'recette', 'crème fleurette', 'cuisine', 'lait', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'farine'], 'Dessert', 05a0159f-e94c-4d48-9425-d9af5f3ff722, '2025-09-26T15:17:35.816487', [{'ingredient_id': 'ded42454-735d-48e1-ad01-0853d2d4c949', 'quantite': '3'}, {'ingredient_id': '155755f3-50cc-4ad0-b307-16d07ac04f48', 'quantite': '100 g'}, {'ingredient_id': 'cfa4fb7f-c021-4350-98b5-a6e5b636bfdc', 'quantite': '125 g'}, {'ingredient_id': 'bee6f406-42dc-4b76-88fe-9f3999bfb5ba', 'quantite': '2'}, {'ingredient_id': 'd2db2933-4ec7-40c5-b871-0e8b7b5ffe40', 'quantite': '10 cl'}, {'ingredient_id': 'e19e8bd8-9fb5-4968-a416-65ac060c4bf8', 'quantite': '50 g'}, {'ingredient_id': 'dd15e5bf-1cc9-4069-b30e-d324ca934f0c', 'quantite': '3 cuillères'}, {'ingredient_id': 'fe99ed74-4715-47f0-80c6-c02e58baf7f6', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (212970, 'Mousse de fraises au mascarpone', 'mascarpone, fraises, sucre, sucre vanillé, blanc d''oeuf', '20 min', ['Laver et équeuter les fraises. Les réduire en coulis.', 'Battre le mascarpone avec les sucres. Ajouter le coulis.', 'Battre les blancs d''oeuf en neige. Ajouter délicatement à la préparation.', 'Verser dans 4 verrines et réfrigérer au moins 4 h pour que la mousse prenne.'], ['Économe', 'Verre doseur'], ['sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'Mousse de fraises au mascarpone', 'cocktail', 'mousse fruits', 'sucre', 'plat de résistance', 'rapide', 'moyen', 'recette', 'fraises', 'cuisine', 'blanc d''oeuf', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'mascarpone', 'confiserie'], 'Dessert', bead508b-6b5b-45c6-a873-cdd5a2069d1b, '2025-09-26T15:17:40.345386', [{'ingredient_id': 'f58c6ea1-cff7-4969-a970-40b6527e6c38', 'quantite': '200 g'}, {'ingredient_id': 'b6dade2c-955f-45fa-a344-f81d468117d5', 'quantite': '250 g'}, {'ingredient_id': '31098764-3924-4dd4-8ccd-c70444d57ed8', 'quantite': '15 g'}, {'ingredient_id': '25178db0-06f2-423e-8253-da9ac1a0825f', 'quantite': '1'}, {'ingredient_id': '7c65125a-dff6-48f3-bd2f-77c011a7b4d7', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27980, 'Salade épicée fraises - mangue', 'fraises, mangue, orange, menthe, poivre, gingembre, cannelle, vanille', '10 min', ['Presser l''orange, et faire chauffer le jus en y ajoutant le poivre, le gingembre, la cannelle et la vanille. ', 'Porter à ébullition 1 min pour obtenir un sirop, laisser refroidir.', 'Pendant que le jus refroidi, couper les fraises et la mangue en morceaux. ', 'Mettre dans un saladier et ajouter la menthe finement ciselée. ', 'Quand le jus est froid, verser sur les fruits, mélanger et mettre au moins 30 min au réfrigérateur... ', 'Bon appétit!'], ['Verre doseur', 'Presse-agrumes', 'Balance de cuisine', 'Batteur électrique'], ['', 'cannelle', 'recettes de cuisine', 'plat', 'gingembre', 'cocktail', 'vanille', 'menthe', 'plat de résistance', 'bon marché', 'rapide', 'recette', 'orange', 'mangue', 'fraises', 'cuisine', 'poivre', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'Salade épicée fraises - mangue'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:17:44.923222', [{'ingredient_id': '3aaad85f-293e-470f-9818-2323726aefed', 'quantite': '1'}, {'ingredient_id': 'f21547cd-2b71-4071-8fff-b100d7c6f0cc', 'quantite': '1'}, {'ingredient_id': '2eb9a290-c340-4abe-a586-caeef151ac75', 'quantite': '1'}, {'ingredient_id': '48e750e8-d404-45dd-adb6-343be34457d5', 'quantite': ''}, {'ingredient_id': '413f4e3a-9123-48fb-9602-9ffead73b410', 'quantite': ''}, {'ingredient_id': 'be964600-e2aa-4c46-acc5-92a55247567a', 'quantite': ''}, {'ingredient_id': '6a63d52d-1e3b-4bb6-83b4-fcf312ed5e8d', 'quantite': ''}, {'ingredient_id': 'ceb7d499-0338-4de5-89cc-c91114650e41', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40829, 'tarte aux framboises express', 'pâte brisée, framboises, gelée, oeuf, sucre, farine, lait, sucre vanillé', '20 min', ['Déroulez la pâte brisée avec sa feuille de cuisson dans un moule à tarte. Faites cuire à blanc 20 minutes à 180°C (thermostat 6).', 'Pendant ce temps, travaillez les oeufs et le sucre. Incorporez la farine et le lait chaud. Faites épaissir le mélange dans une casserole à feux doux en tournant avec une cuillère en bois.', 'Retirez du feu dès que la crème est prise. Ajoutez le sachet de sucre vanillé. ', 'Sortez le fond de tarte du four. Laissez refroidir. Versez-y la crème.', 'Disposez les framboises en cercle sur la crème, pour faire une belle présentation. ', 'Nappez de gelée de framboises liquéfiée avec 2 cuillerées d''eau.', 'Servez froid...'], ['Passoire', 'Louche', 'Râpe'], ['sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'bon marché', 'oeuf', 'framboises', 'pâte brisée', 'recette', 'cuisine', 'tarte aux framboises express', 'lait', 'gelée', 'testées', 'entrée', 'dessert', 'tarte aux framboises', 'recettes', 'boisson', 'confiserie', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:17:49.780978', [{'ingredient_id': '05cefb32-5a8c-427f-8ea5-5752d01f6e18', 'quantite': '1'}, {'ingredient_id': '3adbb513-b537-4d1f-abc8-34ff20e0e755', 'quantite': '300 g'}, {'ingredient_id': '0b24007c-0924-4abe-9dee-74504009eb5d', 'quantite': '3 cuillères'}, {'ingredient_id': 'a9e28bcf-758c-49f8-bacc-7d29716e2972', 'quantite': '1'}, {'ingredient_id': '2077d061-9ac4-4ce5-a417-277b1338f4f8', 'quantite': '80 g'}, {'ingredient_id': 'f2968af3-3715-4238-8170-3ca8bcde9f81', 'quantite': '30 g'}, {'ingredient_id': '45a67892-7f9c-41cf-a397-323531422818', 'quantite': ''}, {'ingredient_id': '95167524-d1f9-4163-a1a3-dae88f2ad0db', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (337347, 'Smoothie kiwi banane fraises', 'kiwi, banane, fraises, jus de citron, miel', '10 min', ['Pelez les kiwis, et la banane. Coupez les fruits (banane, fraises et kiwis) en rondelles (grossièrement, de toute façon le tout sera mixé).', 'Versez dans un mixer, sans oublier le jus de citron vert et le miel. Et en dernier les kiwis.', 'On mixe et le tour est joué !'], ['Casserole', 'Couteau de chef', 'Spatule', 'Poêle'], ['recettes de cuisine', 'plat', 'kiwi', 'cocktail', 'smoothies', 'plat de résistance', 'Smoothie kiwi banane fraises', 'bon marché', 'banane', 'miel', 'rapide', 'recette', 'fraises', 'cuisine', 'jus de citron', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Boisson', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:17:53.471940', [{'ingredient_id': '83a926ed-55ea-46b4-a052-7b47e3a4c917', 'quantite': '5'}, {'ingredient_id': 'bfe4d118-82bd-4c0f-b0f3-9752cc677d2f', 'quantite': '1'}, {'ingredient_id': '48f9b06f-660d-4f08-a731-da51b99c1ca8', 'quantite': '10'}, {'ingredient_id': 'bd9374c8-e9bc-4843-ab07-76a1c41498a7', 'quantite': '5 cl'}, {'ingredient_id': '94820469-6b00-4019-be9f-42bd65d5b219', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (25545, 'Gâteau Anna (tendre biscuit aux pommes et poires)', 'sucre en poudre, farine, oeuf, beurre, levure, eau, sel, pomme', '10 min', ['Battre ensemble la farine, la levure, le sucre et les oeufs entiers dans un saladier. Ajouter le sel et l''eau pour obtenir une pâte grossière. ', 'Faire fondre le beurre et l''incorporer à la pâte. ', 'Couper les fruits pelés en quartiers assez fins. ', 'Verser la moitié de la pâte dans un moule à manqué beurré et fariné. ', 'Ajouter les lamelles de fruit en forme de rosace par exemple (ne pas hésiter à les enfoncer un peu). Puis ajouter le reste de la pâte et éventuellement les restes de fruits. ', 'Cuire à four préchauffé à thermostat 5-6 (165°C) suivant le four, pendant 20 à 25 min.', 'Régalez-vous !'], ['Tire-bouchon', 'Louche'], ['recettes de cuisine', 'plat', 'cocktail', 'autres biscuits et petits gâteaux', 'eau', 'plat de résistance', 'bon marché', 'oeuf', 'Gâteau Anna (tendre biscuit aux pommes et poires)', 'sel', 'levure', 'recette', 'sucre en poudre', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'farine'], 'Dessert', 646e8b5f-8474-4bd7-b071-31deed7ab2dc, '2025-09-26T15:17:59.107338', [{'ingredient_id': 'a97abbae-675f-48d9-84fd-720e11a1f7c5', 'quantite': '200 g'}, {'ingredient_id': '9c959a85-8360-4c27-97f8-aadc322fa66c', 'quantite': '200 g'}, {'ingredient_id': '241a3acb-620f-48da-baa9-9a12c00099cc', 'quantite': '4'}, {'ingredient_id': '9bcec170-a19a-4ade-a075-893ae3d352b3', 'quantite': '60 g'}, {'ingredient_id': '43f1bb24-c088-4aad-9b49-028b898be11b', 'quantite': '1'}, {'ingredient_id': 'd9934c42-6a87-4a43-8e6e-e512f9fa4438', 'quantite': '2 cuillères'}, {'ingredient_id': '62e2155a-bd79-4d85-9caa-0e736b0b319d', 'quantite': '1'}, {'ingredient_id': 'bb6af66a-91c7-414d-b4fa-6165a458be42', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315501, 'Bavarois aux framboises & biscuit au citron', 'blanc d''oeuf, jaune d''oeuf, sucre, farine, amandes, citron, citron, sucre, gélatine, framboises, citron, sucre, crème fraîche, framboises, sucre, eau, gélatine', '120 min', ['Préparation du biscuit :', 'Préchauffer le four à 180 C° (thermostat 6).', 'Battre les œufs en neige, dès qu’ils commencent à prendre, ajouter le sucre en pluie.', 'Lorsque la préparation est ferme et brillante (consistance meringuée), ajouter délicatement les jaunes d’œufs, puis la farine, la poudre d’amande et le zeste de citron.', 'Étaler la préparation dans un moule rectangulaire destiné à la préparation des biscuits roulés (ici, 14x10 cm).', 'Une fois le biscuit cuit, le laisser reposer 5 min et le démouler.', 'Découper des biscuits à l’aide de vos emporte-pièces pour préparer les fonds de vos bavarois. Placer le côté spongieux du biscuit vers le haut, afin que le biscuit soit bien imbibé/absorbe plus facilement le sirop de citron.', 'Préparation du sirop au citron :', 'Porter à ébullition durant 1 min le jus de citron et le sucre.', 'Badigeonner les biscuits de ce mélange, bien les imbiber.', 'Bavarois aux framboises :', 'Mettre à tremper les feuilles de gélatine dans de l’eau froide.', 'Faire chauffer les framboises, le sucre et le jus de citron jusqu’à ce qu’ils soient bien ramollis. Passer la préparation au mixeur puis au tamis pour enlever un maximum de pépins.', 'Remettre la moitié de la préparation à chauffer et y ajouter les feuilles de gélatines bien essorées. Puis laisser refroidir en ajoutant l’autre moitié de la préparation.', 'Battre la crème fraîche ferme puis y ajouter délicatement la purée de framboises tiède/refroidie (elle ne doit pas être trop chaude).', 'Verser la préparation sur les biscuits imbibés de sirop de citron et laisser prendre.', 'Miroir aux framboises :', 'Une fois les bavarois bien pris, commencer à préparer le miroir aux framboises.', 'Mettre à tremper les feuilles de gélatine dans de l’eau froide.', 'Porter à ébullition l’eau et le sucre durant une minute et y ajouter les framboises.  Si vous avez des framboises surgelées, les passer quelques minutes au micro-onde pour qu’elles soient bien dégelées.', 'Mixer le tout, passer au tamis et ajouter la gélatine (si la préparation a trop refroidit le temps de passer le tout au tamis, la faire un peu réchauffer afin de bien dissoudre la gélatine).', 'Attendre que la préparation tiédisse et l’ajouter sur les bavarois, laisser prendre.', 'Démoulage :', 'Si vous avez un pressoir avec vos emporte-pièces, le recouvrir de film alimentaire pour s’en servir. Sinon il y a un risque d’abîmer le miroir du bavarois.', 'Passer une lame sur les bords de votre moule et puis enlever les emporte-pièces délicatement à l’aide du pressoir.', 'Décorer le bavarois de quelques framboises fraîches et amandes effilées.', 'Déguster !'], ['Moule à tarte', 'Louche', 'Ouvre-boîte', 'Tire-bouchon'], ['moyenne', 'recettes de cuisine', 'plat', 'cocktail', 'Bavarois aux framboises & biscuit au citron', 'autres biscuits et petits gâteaux', 'sucre', 'amandes', 'plat de résistance', 'citron', 'bon marché', 'jaune d''oeuf', 'recette', 'cuisine', 'blanc d''oeuf', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'farine'], 'Dessert', 324267ac-e052-4a7e-8aa2-7a09d5d66969, '2025-09-26T15:18:03.191480', [{'ingredient_id': 'f42f2e36-f11b-4043-9c94-7fe5c5ca74c3', 'quantite': '4'}, {'ingredient_id': '095fab95-7f60-4ab7-befe-8f8f910561bb', 'quantite': '3'}, {'ingredient_id': 'ee84c959-ce5e-415f-b7af-012921d21ee8', 'quantite': '120 g'}, {'ingredient_id': '22f4a476-5e9d-4d96-80e6-02dcc97ca4ac', 'quantite': '60 g'}, {'ingredient_id': '8419e7c2-8ddd-4885-861a-a3ebff5764db', 'quantite': '70 g'}, {'ingredient_id': '73f5d6c0-4a95-4dd1-8d24-2921f73da782', 'quantite': '1'}, {'ingredient_id': '794694ba-4717-4164-93f6-dcecdfc08e0e', 'quantite': '1'}, {'ingredient_id': 'f018cd82-7200-4cb0-b8f8-11ef8f35c4fb', 'quantite': '42.5 g'}, {'ingredient_id': 'c7ad591e-3c11-43ed-a229-52effec579c5', 'quantite': '6'}, {'ingredient_id': '5d09648a-d372-4bab-bf0a-447034e30ff4', 'quantite': '500 g'}, {'ingredient_id': '4e680ba0-5e85-4796-8947-c5c5beae00a4', 'quantite': '1'}, {'ingredient_id': 'd271df59-b637-4ca9-810d-571923c7e431', 'quantite': '200 g'}, {'ingredient_id': 'dd06d2df-ca7c-4c42-980e-bec0a9d6e5a5', 'quantite': '40 cl'}, {'ingredient_id': '9378b67d-f572-4e2c-bf64-a70589285226', 'quantite': '250 g'}, {'ingredient_id': '5910a366-4d19-40f1-b167-ebcb5d11d984', 'quantite': '100 g'}, {'ingredient_id': 'a8ad0d92-5830-4213-84e7-3c52af2dbcb7', 'quantite': '10 cl'}, {'ingredient_id': '97a99d82-498f-4cc0-8664-b9e4987dff73', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68580, 'Crumble rapide aux framboises et speculoos', 'spéculoos, framboises, beurre tendre, sucre roux, farine', '15 min', ['Broyer les spéculoos dans un mixer, mélanger avec la farine, le sucre et le beurre coupé en petits morceaux, jusqu''à obtenir une consistance sableuse.', 'Disposez les framboises surgelées dans le fond des ramequins (ou dans le fond d''un grand plat), ajoutez la préparation de biscuits.', 'Mettre au four très chaud (220°C - thermostat 7-8) pendant 15 min.'], ['Presse-agrumes', 'Poêle', 'Râpe', 'Moule à tarte'], ['recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'Crumble rapide aux framboises et speculoos', 'bon marché', 'framboises', 'beurre tendre', 'recette', 'cuisine', 'sucre roux', 'testées', 'autres crumbles', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'farine', 'spéculoos'], 'Dessert', e05ec234-1e41-4ead-a851-0628f9c82027, '2025-09-26T15:18:06.545678', [{'ingredient_id': 'c0257e09-3319-48e1-95c4-60caa96be2a4', 'quantite': '1'}, {'ingredient_id': 'd23b3585-cf95-4d12-bfec-e18c19dfbbff', 'quantite': '1'}, {'ingredient_id': '6f9b89bc-6537-4973-b64c-373547123679', 'quantite': '100 g'}, {'ingredient_id': '43ee8825-8d13-4bd1-8dba-35ab5b99651d', 'quantite': '100 g'}, {'ingredient_id': '9de3808f-f9e9-4220-a6af-4568423f331c', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23954, 'Tarte aux fraises et à la crème d''amandes', 'farine, sucre glace, beurre, sel, vanille, oeuf, amandes en poudre, sucre, beurre, oeuf, fraises', '30 min', ['Préparation de la pâte sablée : dans un saladier, mélanger la farine, le sucre et le beurre. Ensuite ajouter le sel, l''intérieur de la gousse de vanille fendue en deux et l''oeuf entier. Mélanger sans trop travailler la pâte. Laisser reposer 30 mn.', 'Préchauffer le four à 160°C.', 'Abaisser la pâte, puis la disposer sur un moule à tarte légèrement beurré. La laisser reposer 15 mn au frigo puis enfourner le fond de tarte à blanc 15 mn.', 'Pendant ce temps, préparer la crème d''amande en mélangeant la poudre d''amande, le sucre, le beurre et les oeufs.', 'Sortir la tarte du four et étaler la crème d''amande sur la pâte. Remettre au four pendant 15 minutes.', 'Laver les fraises et les couper en deux dans le sens de la longueur.', 'Lorsque la tarte est refroidie, la garnir généreusement des fraises coupées.'], ['Rouleau à pâtisserie', 'Planche à découper', 'Casserole', 'Pince de cuisine'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'vanille', 'plat de résistance', 'tarte aux fraises', 'bon marché', 'oeuf', 'Tarte aux fraises et à la crème d''amandes', 'sel', 'recette', 'cuisine', 'testées', 'sucre glace', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'farine'], 'Dessert', eef77d8e-51bc-40a3-8dc8-1c503ab9ee16, '2025-09-26T15:18:11.154864', [{'ingredient_id': '57eb6aed-6bc3-48e3-bd70-1647148149bb', 'quantite': '200 g'}, {'ingredient_id': '369e5ab1-b52b-49b0-b47b-777bd2811961', 'quantite': '80 g'}, {'ingredient_id': '105b9655-3e41-4ffb-821b-4e318099573b', 'quantite': '120 g'}, {'ingredient_id': 'aab1f027-2da0-4b6c-9a05-e48750a7a9e6', 'quantite': '1 cuillères'}, {'ingredient_id': '54b6fe83-ef44-4bc1-8278-1207b64e05dc', 'quantite': '1'}, {'ingredient_id': '08d7a8cc-f273-48a6-9508-c2f91fd0eddc', 'quantite': '1'}, {'ingredient_id': '22124c2d-da79-454d-af29-d9c96ad8ee87', 'quantite': '150 g'}, {'ingredient_id': '1af31d5e-1d81-4806-9f28-14bb811d83a3', 'quantite': '80 g'}, {'ingredient_id': '97741355-3bf6-4161-9a94-c5e4c97c4ff1', 'quantite': '50 g'}, {'ingredient_id': 'dc82480f-6983-4102-82a8-097255ba6d61', 'quantite': '2'}, {'ingredient_id': '512c3223-a7bd-4b5e-be70-1eb35249ae6e', 'quantite': '750 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36250, 'Muffins pomme cannelle gingembre', 'farine, sucre, oeuf, levure, yaourt, gingembre, cannelle, sel, pomme', '15 min', ['Préchauffez le four à 180°C (thermostat 6).', 'Dans un plat, mélanger la farine, la levure, les épices. Ajouter une pincée de sel. ', 'Dans un autre plat, battre les oeufs avec le sucre jusqu''à ce que le mélange blanchisse.', 'Ajouter le yaourt (1 et 1/2). Bien mélanger.', 'Eplucher les pommes, les couper en petits morceaux et les ajouter au mélange.', 'Verser ce mélange dans le plat contenant la farine, remuer (pas la peine de s''affoler sur les grumeaux, ils partiront à la cuisson).', 'Verser dans des moules à muffins en les remplissant aux 2/3.', 'Enfourner 25 à 30 minutes.', 'Pendant que ça cuit, vous pouvez terminer le 2e yaourt et préparer un thé.'], ['Louche', 'Spatule'], ['cannelle', 'recettes de cuisine', 'plat', 'gingembre', 'cocktail', 'sucre', 'plat de résistance', 'yaourt', 'bon marché', 'oeuf', 'muffin', 'sel', 'levure', 'recette', 'cuisine', 'testées', 'très facile', 'Muffins pomme cannelle gingembre', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme', 'farine'], 'Dessert', f11955f3-b402-4a31-ac85-1a72383e34e0, '2025-09-26T15:18:17.672134', [{'ingredient_id': '6b2e50a1-6710-49e6-a9b7-a92eaabbfac5', 'quantite': '200 g'}, {'ingredient_id': '0783271e-0cfd-42c3-af17-7f0f9285fbea', 'quantite': '200 g'}, {'ingredient_id': '0f419796-eb82-4912-a15f-71b38d7849cf', 'quantite': '2'}, {'ingredient_id': '4437b258-1960-4c2b-afa9-a82b1efca155', 'quantite': ''}, {'ingredient_id': '734a1981-683f-4306-8ca1-b1c1ef9ecb98', 'quantite': '1'}, {'ingredient_id': '432ccaa6-7997-41a8-9faa-ac84616e0d0c', 'quantite': '1 cuillères'}, {'ingredient_id': '1a5dc7e0-3617-4ead-a2a0-23337de5a6d7', 'quantite': '1 cuillères'}, {'ingredient_id': 'b2b7a120-e459-494c-905c-ba469a28e9f9', 'quantite': ''}, {'ingredient_id': 'bf520553-03f3-4da4-a606-8e719f51b3bc', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30449, 'Tarte chocolatée aux fraises', 'pâte sablée, chocolat pâtissier, lait, fraises, gelée, sucre, mascarpone, fromage blanc', '20 min', ['Préchauffez le four à thermostat 6 (180°C).', 'Foncez un plat à tarte avec la pâte sablée. Faites accrocher la pâte aux rebords du plat afin d''éviter qu''elle se replie sur elle-même pendant la cuisson! Piquez la pâte à l''aide d''une fourchette pour éviter qu''elle ne lève (vous pouvez également utiliser des haricots secs et du papier sulfurisé pour mettre un poids sur la pâte).', 'Passez la pâte environ 15 mn au four en veillant à ce qu''elle garde une forme correcte (si nécessaire, sortez-la quelques seconde pour lui redonner forme à l''aide d''une cuillère ou d''une spatule).', 'Faites fondre le chocolat avec un peu de lait pour obtenir un mélange brillant et onctueux.', 'Badigeonnez la pâte de chocolat fondu et laissez refroidir le tout.', 'Préparez la garniture : battez au fouet (ou mieux, au robot-hachoir) le mascarpone mélangé au sucre, jusqu''à obtenir une crème. Ajoutez le fromage blanc, mélangez et battez.', 'Etalez la garniture sur la pâte chocolatée. Coupez les fraises pour les placer sur la tarte.', 'Pour la finition : réchauffez de la gelée de groseille avec un peu d''eau pour la rendre un peu plus liquide, puis badigeonnez les fraises. ', 'Petits plus : rajoutez quelques framboises entre les fraises...'], ['Ouvre-boîte', 'Couteau de chef', 'Rouleau à pâtisserie'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'pâte sablée', 'sucre', 'plat de résistance', 'tarte aux fraises', 'fromage blanc', 'chocolat pâtissier', 'rapide', 'moyen', 'recette', 'fraises', 'cuisine', 'gelée', 'lait', 'Tarte chocolatée aux fraises', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'mascarpone', 'confiserie'], 'Dessert', d38a24bf-7bd3-4e65-b34c-6cc909742bd0, '2025-09-26T15:18:23.578098', [{'ingredient_id': '74173f6b-25a1-4d41-8ab3-487f8648e321', 'quantite': '1'}, {'ingredient_id': '325cebdd-0fda-4d50-abb9-05c36f356c58', 'quantite': '100 g'}, {'ingredient_id': '67be13de-3cb4-4fce-9db2-e9e5a093a147', 'quantite': ''}, {'ingredient_id': 'e62880a1-8250-40d4-adff-79621a2d2065', 'quantite': '500 g'}, {'ingredient_id': 'b1d44590-845c-4aff-b17c-5961e8cb0b8f', 'quantite': ''}, {'ingredient_id': '569927f3-84f9-4a0e-92c3-e1017dfed667', 'quantite': '4 cuillères'}, {'ingredient_id': 'b8daad75-57ec-4f84-8e57-3c1b345765be', 'quantite': '250 g'}, {'ingredient_id': '3c44aa53-3fef-4fe4-9958-9740066d79c6', 'quantite': '6 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20990, 'Compote de pommes rapide (micro-ondes)', 'pomme, cannelle, sucre', '10 min', ['Eplucher les pommes et les couper en petits carrés. ', 'Les mettre dans un plat pour four à micro-ondes. Saupoudrer de cannelle et de sucre (si vous en utilisez), mélanger. Couvrir le plat d''un film étirable. ', 'Faire cuire au micro-ondes 5 à 10 mn suivant la puissance du four. Mélanger.'], ['Planche à découper', 'Couteau de chef', 'Balance de cuisine', 'Fouet'], ['cannelle', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'bon marché', 'Compote de pommes rapide (micro-ondes)', 'rapide', 'recette', 'compote de pomme', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme'], 'Dessert', 20e013ad-0197-4455-882f-0098980e8cce, '2025-09-26T15:18:30.259286', [{'ingredient_id': '37a95887-ed7a-42e0-95a9-6272310b9922', 'quantite': '4'}, {'ingredient_id': 'b94290a5-4617-4645-ac1d-4644f17f7efb', 'quantite': ''}, {'ingredient_id': 'c5832f42-4ef9-44c8-aa3c-88161807b586', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (227615, 'Tiramisu framboises, vanille et sablés', 'framboises, sucre en poudre, citron, eau, oeuf, mascarpone, sucre roux, sucre vanillé, framboises, sablés', '30 min', ['Pour faire le coulis, porter l''eau et le sucre à ébullition. Ajouter ce sirop aux framboises et mixer.', 'Dans deux jattes, séparer les blancs des jaunes.', 'Dans la jatte des jaunes, incorporer le sucre roux, le sucre vanillé et la vanille. Bien mélanger.', 'Puis incorporer le mascarpone, bien mélanger au fouet pour bien lisser la crème.', 'Dans la jatte des blancs, ajouter une petite pincée de sel, et monter les blancs en neige bien ferme.', 'Puis incorporer délicatement les blancs en neige au premier mélange à l''aide d''une spatule.', 'Dans de grosse verrine, au fond, mettre une couche de sablés, recouvrir de coulis, ajouter quelques framboises fraiches (4-5 framboises), et recouvrir de crème. Recommencer l''opération, et terminer par une couche de crème.', 'Sur le dessus, ajouter 3 framboises fraiches et une feuille de menthe pour la décoration.', 'Placer au réfrigérateur, au moins 4 heures.', 'Servir bien frais.'], ['Couteau de chef', 'Économe'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'Tiramisu framboises', 'eau', 'plat de résistance', 'citron', 'bon marché', 'sablés', 'framboises', 'rapide', 'recette', 'sucre en poudre', 'vanille et sablés', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', f1bbc85c-6530-460b-8dd5-82d99a1e6cc9, '2025-09-26T15:18:33.670849', [{'ingredient_id': 'd0b6b79d-02fc-4cca-91a3-842332e03f11', 'quantite': '125 g'}, {'ingredient_id': '25ba699d-dffc-4660-b1f9-8a400a5a56cf', 'quantite': '20 g'}, {'ingredient_id': '38bdfbe5-3e15-47f0-af63-3ba18fb30335', 'quantite': '1'}, {'ingredient_id': 'dda761dd-62ae-4fb7-888c-8511ab0e2087', 'quantite': '1'}, {'ingredient_id': '0ca28b4d-1b16-4b9a-bf27-eb505eccedd0', 'quantite': '2'}, {'ingredient_id': '7d3d5562-f65a-4e94-b671-580b3e0e59da', 'quantite': '250 g'}, {'ingredient_id': 'aba51f0d-952d-412a-a621-352a88c5971d', 'quantite': '70 g'}, {'ingredient_id': '3216aca0-0744-4c67-ae70-deed04a51dae', 'quantite': '1'}, {'ingredient_id': '69feae6c-db0f-4f8f-927d-2adf811364a0', 'quantite': '125 g'}, {'ingredient_id': '03b08f20-23a0-4900-bf6b-054f4d2a2833', 'quantite': '120 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65812, 'Potage poireaux-carottes-pommes de terre', 'poireau, pomme de terre, carotte, oignon, eau, lait, cube de bouillon, beurre, poivre', '15 min', ['Emincer les poireaux et couper l''oignon.', 'Faire fondre le beurre dans une marmite et y faire revenir les poireaux et l''oignon.', 'Pendant ce temps laver, éplucher et couper en petits morceaux les pommes de terre et les carottes puis les rajouter dans la marmite.', 'Ajouter l''eau, le lait, les 2 cubes de bouillons de volaille et le poivre. Faire cuire 30 min dans la marmite (ou 15 min dans une cocotte minute).', 'Mixer le tout... C''est prêt!'], ['Rouleau à pâtisserie', 'Fouet', 'Balance de cuisine'], ['recettes de cuisine', 'plat', 'cube de bouillon', 'cocktail', 'eau', 'plat de résistance', 'bon marché', 'soupe', 'poireau', 'oignon', 'recette', 'carotte', 'cuisine', 'lait', 'Potage poireaux-carottes-pommes de terre', 'poivre', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'pomme de terre', 'confiserie'], 'Entrée', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:18:40.359588', [{'ingredient_id': '3fe2474b-df8f-4c41-9a92-0be606271af4', 'quantite': '4'}, {'ingredient_id': '424e0604-088c-4049-9b2b-1e1e4de58d39', 'quantite': '5'}, {'ingredient_id': '29f99b83-71cd-4674-8c99-ec4240cfe820', 'quantite': '3'}, {'ingredient_id': '086048ec-49f0-4d42-854e-32ef9252de12', 'quantite': '1'}, {'ingredient_id': '547b3dab-ecb3-471c-87dc-88a761e7f194', 'quantite': '1 l'}, {'ingredient_id': 'c8c33c83-aba7-49c6-b282-0d55d6377681', 'quantite': '50 cl'}, {'ingredient_id': '1ae5d1f3-6163-4a03-b106-ca71c0dd2286', 'quantite': '2'}, {'ingredient_id': '50eafe44-cc20-4d7f-a3ef-a5b9595c94e3', 'quantite': '50 g'}, {'ingredient_id': '7434fb91-6431-4764-a1f3-e9bacb8a60d1', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12281, 'Gratin de pomme de terre et  de saumon fumé', 'pomme de terre, saumon fumé, fromage râpé, crème fraîche, lait, poivre', '120 min', ['Éplucher les pommes de terre et les faire pré-cuire pendant environ 20 minutes (ne pas faire de purée).', 'Couper les pommes de terre en dés et faire une première couche dans le plat. Poivrez. Poser une couche de saumon et mettre de la crème fraiche par dessus, puis ajoutez le fromage râpé.', 'Recommencez l''opération jusqu''en haut du plat. en finissant par une couche de pommes de terre, de crème fraîche et de fromage.', 'Rajoutez un peu de lait pour que ce ne soit pas trop sec.', 'Mettez au four (200°C) pendant environ une heure.'], ['Économe', 'Passoire', 'Couteau de chef', 'Louche', 'Mixeur'], ['saumon fumé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'crème fraîche', 'plat de résistance', 'autre gratin de pommes de terre', 'Gratin de pomme de terre et  de saumon fumé', 'bon marché', 'fromage râpé', 'recette', 'cuisine', 'lait', 'poivre', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'pomme de terre', 'confiserie'], 'Plat principal', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:18:46.082106', [{'ingredient_id': 'c8bf7c35-fc37-490a-9c56-ffc61d1deeae', 'quantite': '3 kg'}, {'ingredient_id': 'd583fdd2-dcee-4a26-9354-23a6d5e966c6', 'quantite': '200 g'}, {'ingredient_id': 'f0bf39eb-6348-4b6e-8c78-2dba71384aae', 'quantite': '250 g'}, {'ingredient_id': '681826a7-d6cf-4130-b0f1-ea0c1a95827b', 'quantite': '250 ml'}, {'ingredient_id': 'a41dc2e9-7a80-46e5-84f7-7c18b3f6d17d', 'quantite': ''}, {'ingredient_id': '90823c15-ed10-4737-b1d6-a6f3d89e218a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (41161, 'Soupe veloutée de potimarron et pommes de terre', 'potimarron, pomme de terre, oignon, ail, crème fraîche, curry, muscade, cube de bouillon, feuille de laurier, sel, poivre', '15 min', ['Enlever l''écorce et les pépins du potimarron (il n''est pas obligatoire de le peler, mais dans ce cas, le choisir bio et bien le laver) puis couper la chair en gros morceaux.', 'Eplucher les pommes de terre puis les couper en gros morceaux.', 'Faire revenir les oignons et l''ail hachés dans un peu de beurre à feu doux.', 'Ajouter les pommes de terre et le potimarron, faire revenir 5 min.', 'Couvrir le tout d''eau, ajouter le bouillon de poule (émietté), le curry, la muscade, la feuille de laurier et laisser mijoter environ 30 min à feu doux.', 'Lorsque les légumes sont cuits (vérifier à l''aide d''un couteau), mixer votre préparation.', 'Vérifier l''assaisonnement, saler, poivrer selon votre goût puis ajouter la crème fraîche et laisser mijoter encore 2 ou 3 min. Bon appétit !'], ['Moule à tarte', 'Fouet', 'Mixeur', 'Râpe'], ['recettes de cuisine', 'plat', 'cube de bouillon', 'cocktail', 'potimarron', 'ail', 'crème fraîche', 'curry', 'plat de résistance', 'feuille de laurier', 'bon marché', 'soupe', 'sel', 'oignon', 'Soupe veloutée de potimarron et pommes de terre', 'recette', 'cuisine', 'poivre', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'pomme de terre', 'confiserie', 'muscade'], 'Entrée', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:18:52.620654', [{'ingredient_id': 'ffa4b9f0-14ae-48f9-b72f-ab1ac898e807', 'quantite': '1'}, {'ingredient_id': '61d88b3c-838e-4977-9989-70bb6c323b3c', 'quantite': '2'}, {'ingredient_id': '65d09757-7a9f-42ef-a427-cfd35330547e', 'quantite': '2'}, {'ingredient_id': '4c3f7b22-9876-42da-a1e6-08e94528f106', 'quantite': '3'}, {'ingredient_id': 'aaaab025-549d-48d9-8b30-aa99bbaeee30', 'quantite': '10 cl'}, {'ingredient_id': '04a718ee-bddd-4f0e-852c-2b86343ba435', 'quantite': '1 cuillères'}, {'ingredient_id': '81950623-6e5b-400b-b149-1974a0896518', 'quantite': '1'}, {'ingredient_id': '6dc7c2e1-353a-4e1a-a06b-ec7c3b6d984a', 'quantite': '1'}, {'ingredient_id': '99dc090e-3418-4c51-8017-ece64d445344', 'quantite': '1'}, {'ingredient_id': 'cd904272-033e-4f21-9f3d-b49669629bde', 'quantite': ''}, {'ingredient_id': '6536336a-bf46-442b-a78c-83dffca8b799', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (92486, 'Tarte aux pommes facile et pas chère', 'pâte feuilletée, sucre, oeuf, beurre, pomme', '30 min', ['Mettre la pâte feuilletée dans un plat à tarte, la piquer avec une fourchette, garnir avec les pommes coupées en morceaux.', 'Mélanger 90g sucre, les deux œufs, le beurre fondu et verser sur la tarte. ', 'Enfournez, thermostat 6-7 ( 200°) pendant 35 minutes environ.'], ['Balance de cuisine', 'Poêle', 'Passoire', 'Tire-bouchon'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'Tarte aux pommes facile et pas chère', 'bon marché', 'oeuf', 'recette', 'tarte aux pommes', 'cuisine', 'testées', 'entrée', 'dessert', 'pâte feuilletée', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:18:59.324719', [{'ingredient_id': 'f906ec51-1ba1-4ffb-bcdf-32ca75864985', 'quantite': ''}, {'ingredient_id': 'f8f3b224-da09-4e6f-97af-f91e9291fb77', 'quantite': '90 g'}, {'ingredient_id': 'd05b293a-582a-4723-90c6-d565ce971b3c', 'quantite': '2'}, {'ingredient_id': '063f1822-f64d-41ff-98cd-0b72046039d3', 'quantite': '60 g'}, {'ingredient_id': 'd9e660e1-620a-499c-a122-2829b5d9a005', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34744, 'Galette des rois pommes/framboises', 'pâte feuilletée, framboises, pomme, beurre, sucre en poudre, jaune d''oeuf, fèves', '30 min', ['Epluchez et coupez les pommes en dés. ', 'Dans une casserole, mettre les pommes, les framboises encore surgelées et le beurre. Couvrez et laissez cuire à feu doux. ', 'Lorsque le mélange commence à bouillonner, remuez afin d''obtenir une "purée". Une fois obtenue, ajoutez le sucre. Goûtez et rajoutez du sucre si la purée est trop acide. ', 'Remuez. Eteignez le feu et laissez refroidir. ', 'Faites préchauffer votre four 250°C . ', 'Maintenant les choses s''accélèrent : ', 'Sortez les pâtes feuilletées du frigo. ', 'Installez la 1ère pâte, puis versez le mélange, disposez le sujet et la fève puis refermez avec le deuxième rond de pâte. Badigeonnez d''oeuf, faites des rainures à l''aide d''un couteau puis enfournez. ', 'A dégustez tiède avec un bon verre de cidre.'], ['Casserole', 'Économe', 'Presse-agrumes', 'Rouleau à pâtisserie', 'Batteur électrique'], ['recettes de cuisine', 'plat', 'fèves', 'cocktail', 'plat de résistance', 'gâteau des rois', 'jaune d''oeuf', 'framboises', 'moyen', 'recette', 'sucre en poudre', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'pâte feuilletée', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'Galette des rois pommes/framboises'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:19:03.696819', [{'ingredient_id': '256e8d60-ef5c-4333-8e0e-6c92d3fe2a8f', 'quantite': '2'}, {'ingredient_id': '8aef4dc2-5c67-4c2f-8cd1-815035e7999a', 'quantite': '200 g'}, {'ingredient_id': '3be439e7-9476-4f64-9b9c-39a601f97f7c', 'quantite': '3'}, {'ingredient_id': '60bd980e-8485-4cd1-8328-0358f93a193b', 'quantite': '30 g'}, {'ingredient_id': 'f669f399-6c74-48ab-bb5d-f564d23cadd7', 'quantite': '20 g'}, {'ingredient_id': 'c90109cd-a8be-43cb-a595-4bb9120a8e15', 'quantite': '1'}, {'ingredient_id': '5ae1fa5b-b828-4e72-995a-3fd9b5fed13c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22187, 'SORBET A LA FRAISE', 'fraises, sucre semoule, jus de citron, eau', '15 min', ['Faites un sirop avec l''eau et le sucre, remuez pour faire fondre le sucre et laissez bouillir 2 mn. Laissez refroidir. ', 'Rincez, équeutez les fraises. Mixez-les puis passez-les au travers d''un fin chinois pour retirer les pépins. ', 'Mélangez le sirop et le jus de citron à la purée de fruit. ', 'Versez dans la sorbetière et laissez prendre pendant au moins 2 h. ', 'Disposez les boules de sorbet sur les assiettes de service entourées de fruits rouges.'], ['Moule à tarte', 'Râpe', 'Poêle', 'Rouleau à pâtisserie', 'Planche à découper'], ['recettes de cuisine', 'plat', 'cocktail', 'eau', 'plat de résistance', 'bon marché', 'rapide', 'SORBET A LA FRAISE', 'recette', 'fraises', 'cuisine', 'jus de citron', 'sorbet', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'sucre semoule'], 'Dessert', 7144ac18-d61f-4649-9a19-c9ea11149fa4, '2025-09-26T15:19:08.320056', [{'ingredient_id': '49d20c74-a4c2-42c0-a037-9d8f36c21e92', 'quantite': '500 g'}, {'ingredient_id': '6be49bd0-a0fd-4192-9079-647603f35fb2', 'quantite': '125 g'}, {'ingredient_id': '6983b7b7-9394-42ce-ac8f-320f0de9b273', 'quantite': '1 cuillères'}, {'ingredient_id': 'eb45122e-e5b3-4812-bb76-5553081ba66e', 'quantite': '6.5 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (19583, 'Gâteau aux pommes et aux noix de mon enfance!', 'pomme, sucre, oeuf, huile, farine, levure chimique, noix, cannelle, sel', '10 min', ['Mélanger les pommes en dés et le sucre dans un bol.', 'Travailler les œufs, l''huile et toutes les poudres (farine, levure, cannelle, sel).', 'Ajouter les pommes/sucre et les noix, mélanger. ', 'Verser dans un moule à cake bien beurré. ', 'Faites cuire à 190°C pendant 1h00. ', 'Démouler chaud.'], ['Batteur électrique', 'Passoire', 'Spatule', 'Ouvre-boîte'], ['noix', 'cannelle', 'recettes de cuisine', 'Gâteau aux pommes et aux noix de mon enfance!', 'plat', 'cocktail', 'levure chimique', 'sucre', 'plat de résistance', 'bon marché', 'oeuf', 'gâteau aux noix', 'sel', 'recette', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme', 'huile', 'farine'], 'Dessert', 32b07315-ddd4-4e19-8cd6-bf7fb2386a19, '2025-09-26T15:19:14.898241', [{'ingredient_id': 'd6515335-26ca-4293-a03e-8d6e583692fa', 'quantite': '4'}, {'ingredient_id': '2f8cd893-5b02-441d-868b-767a5bc4abb9', 'quantite': '300 g'}, {'ingredient_id': 'd42d456b-e1a9-463f-bc91-0d7b5bd1da30', 'quantite': '2'}, {'ingredient_id': '3160af78-d9e3-4068-bd9e-174723f19f8c', 'quantite': '12.5 cl'}, {'ingredient_id': '67dce3ce-04e2-49de-b9f3-5899241713c9', 'quantite': '250 g'}, {'ingredient_id': 'a7446391-cfd4-4ceb-9bf3-4108f7b5afcb', 'quantite': '1'}, {'ingredient_id': '26ad919c-2d1a-4493-8081-a905209b9fbc', 'quantite': '100 g'}, {'ingredient_id': 'feeb31e0-848d-4d5c-8e93-308995479176', 'quantite': '2 cuillères'}, {'ingredient_id': '571a9960-3440-4b80-9b94-5a5486ce0f9e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11391, 'Cake au citron', 'farine, sucre, oeuf, levure chimique, beurre, citron, sucre, citron', '10 min', ['Séparer les blancs de jaunes. ', 'Battre les blancs d''oeufs en neige, puis les réserver.', 'Au bain-marie, faire fondre le beurre.', 'Râper le citron.', 'Travailler les jaunes avec le sucre.', 'Ajouter le citron râpé, la farine, la levure et le beurre fondu. Y incorporer délicatement les blancs en neige.', 'Enfourner à 180°C (thermostat 6) pendant 30 à 40 min.', 'Pendant ce temps, faire le sirop à feu doux avec les 20 morceaux de sucre et le jus des 2 citrons; imprégner le cake avec ce sirop.', 'Servir froid avec de la crème anglaise, des fraises, framboises, etc. Et même nature !'], ['Passoire', 'Balance de cuisine', 'Râpe', 'Fouet', 'Verre doseur'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'sucre', 'plat de résistance', 'citron', 'bon marché', 'oeuf', 'Cake au citron', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'cake au citron', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:19:21.410957', [{'ingredient_id': '07bbc982-1797-4d9c-8ae3-d9f219cd1b3c', 'quantite': '200 g'}, {'ingredient_id': 'bc76a83b-d311-4060-a4bb-0dd0e68594a4', 'quantite': '200 g'}, {'ingredient_id': '559d1b5f-d43b-426f-8d3a-63c2ab6216ed', 'quantite': '4'}, {'ingredient_id': 'd38de605-71a9-4c1c-8152-3fd57a88e541', 'quantite': ''}, {'ingredient_id': 'e276f688-0b8b-4b6b-866a-bd480c6b1d9d', 'quantite': '100 g'}, {'ingredient_id': '60da82d3-1d86-4f03-a63f-803ffc578eb8', 'quantite': '1'}, {'ingredient_id': '13aad17a-dae2-4b33-956e-c4c97565ec70', 'quantite': '20'}, {'ingredient_id': '30d95fdf-3ab0-421d-a43a-c18e7cdf9202', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62659, 'Cappucino de fraises en verrines', 'fraises, sucre glace, citron, mascarpone, crème fraîche, sucre vanillé, glace à la pistache, pistaches', '30 min', ['Préparez la décoration des verrines en trempant leurs rebords dans du sucre rose (ex : fraises Tagada  ®) et du jus de citron de manière à embellir le contour.', 'Lavez et épluchez les fraises puis égouttez-les biens. Mixez-les abondamment avec le sucre glace et le jus de citron, et si besoin, passez le mélange dans une passoire pour éliminer les petits grains. Réservez au frais.', 'Mélangez le mascarpone et la crème fraîche avec le sucre vanillé, montez-les légèrement avec un fouet électrique et réservez au frais.', 'Au moment de servir, prenez une verrines "témoin" de la même dimension que celles que vous avez préparées, et appuyez là sur le bloc de glace afin d''obtenir le diamètre exacte.', 'Découpez la glace de 1 cm d''épaisseur environ,puis placez proprement les cercles de glaces au fond des verrines préparées. ', 'Versez la préparation fraises par-dessus jusqu''au 3/4 des verres, puis, recouvrez le tout de l''onctueuse crème au mascarpone comme si c''était de la chantilly.', 'Touche de déco finale, parsemez de pistaches écossées, hachées puis émiettées, 2 petites fraises Tagada ®, 2 Mikados ®, le tour est joué !', 'Un vrai régal pour le palet, digne d''un restaurant gastronomique, vous invités vont être épatés !'], ['Tire-bouchon', 'Casserole', 'Louche', 'Couteau de chef'], ['', 'sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'Cappucino de fraises en verrines', 'crème fraîche', 'pistaches', 'plat de résistance', 'citron', 'rapide', 'moyen', 'recette', 'fraises', 'cuisine', 'testées', 'sucre glace', 'glace à la pistache', 'entrée', 'dessert', 'boisson', 'recettes', 'mascarpone', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:19:26.248010', [{'ingredient_id': '4f5055a8-ce5a-422d-93a1-414c07242461', 'quantite': '700 g'}, {'ingredient_id': '8fbee51a-1dde-4e17-8ca3-5e945b6ac838', 'quantite': '60 g'}, {'ingredient_id': '165680b4-b640-4e63-8cfd-27fea6607e39', 'quantite': ''}, {'ingredient_id': 'f18797bb-d488-49a7-bcc0-f72dbfafa79a', 'quantite': '150 g'}, {'ingredient_id': 'b84ab834-63c7-40a2-a45b-a6eb83a8e88a', 'quantite': '15 cl'}, {'ingredient_id': 'bf75dc76-f7ab-411a-afad-58ca536afda6', 'quantite': '50 g'}, {'ingredient_id': '43694428-9f4f-42c3-9cbc-e51f1dc21b9d', 'quantite': '300 g'}, {'ingredient_id': '905fb87f-e794-4f4b-8281-d62cd290e93b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (211777, 'Tarte aux fraises (pâte aux spéculoos)', 'spéculoos, beurre tendre, fraises, mascarpone, sucre glace, crème liquide', '40 min', ['Préparez la pâte quelques heures avant, ou la veille :', 'Préchauffez votre four à 180°C (thermostat 6).', 'Dans un bol robot, réduisez les spéculoos et le beurre en un pâte granuleuse.', 'Étalez-la dans un moule à tarte avec les mains en une couche égale, en remontant un peu sur bords. ', 'Puis la faire cuire 10 min. ', 'Ensuite, laissez-la refroidir et réservez au réfrigérateur jusqu''au lendemain. ', 'Garniture :', 'Mélangez le mascarpone et le sucre jusqu''à ce que le mélange soit souple.', 'Versez la crème liquide très froide dans un saladier.', 'Battez-la à l''aide d''un batteur électrique, jusqu''à obtenir une consistance de crème fouettée.', 'Incorporez délicatement la crème au mascarpone sucré, à l''aide d''une spatule.', 'Puis, versez le mélange sur le fond de tarte.', 'Équeutez les fraises puis disposez-les harmonieusement sur toute la surface.', 'Saupoudrer la tarte aux fraises de sucre glace.', 'Régalez-vous !'], ['Balance de cuisine', 'Louche', 'Pince de cuisine', 'Moule à tarte', 'Batteur électrique'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'tarte aux fraises', 'bon marché', 'beurre tendre', 'rapide', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'Tarte aux fraises (pâte aux spéculoos)', 'spéculoos'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:19:29.764415', [{'ingredient_id': 'e6a1921b-3764-4315-b0bf-8d73b082ef7a', 'quantite': '250 g'}, {'ingredient_id': 'e5f76ca3-519b-4d92-a583-4a44a53c735e', 'quantite': '75 g'}, {'ingredient_id': '4df4687e-163d-4aed-9b84-c2463b9af5bb', 'quantite': '750 g'}, {'ingredient_id': '655afc61-df1a-478d-aeee-127aea45d6f0', 'quantite': '250 g'}, {'ingredient_id': '73c2caa5-449d-4453-adf9-9e8a4bc5d8ae', 'quantite': '35 g'}, {'ingredient_id': '05aa718e-c649-4fc0-a0e2-d3db637e8702', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (172829, 'Dôme croquant de chocolat blanc à la mousse de fruits rouges et coeur de fraise', 'chocolat blanc, beurre, fruits rouges, sucre, gélatine, crème fleurette, blanc d''oeuf, fraises', '240 min', ['Préparation des coques :', 'Faire fondre le chocolat blanc cassé en morceaux avec la noisette de beurre jusqu''à obtenir une crème bien lisse.', 'Étaler au pinceau une fine couche de chocolat fondu sur le fond et les bords de 10 petits moules en silicone.', 'Placer les moules au congélateur pendant 5 min jusqu''à ce que le chocolat durcisse.', 'Sortir les moules, puis recommencer l''opération avec une seconde couche de chocolat pour que le dôme ait une coque plus épaisse. Placer à nouveau les moules au congélateur.', 'Préparation de la mousse de fruits rouges : ', 'Faire chauffer les fruits rouges avec le sucre dans une casserole pour que les fruits perdent un peu de leur eau.', 'Ajouter une feuille de gélatine préalablement ramollie dans de l''eau froide. Bien mélanger.', 'Monter la crème en chantilly et l''ajouter au mélange de fruits refroidi.', 'Monter les blancs d''œufs en neige, les incorporer au mélange chantilly/fruits rouges. ', 'Faire refroidir au réfrigérateur. ', 'Garniture des dômes : ', 'Sortir les moules du congélateur et déposer un peu de mousse aux fruits à l''intérieur de chacun, placer une fraise au centre et recouvrir de mousse aux fruits jusqu''à ras bord des moules.', 'Placer les coques de chocolat à la mousse de fruits au congélateur jusqu''à ce que la mousse soit bien dure.', 'Ultime étape, étaler une couche assez épaisse de chocolat blanc fondu sur le dessus des moules pour fermer la coque des dômes. ', 'Placer une nouvelle fois au congélateur pour que le chocolat durcisse.'], ['Fouet', 'Ouvre-boîte', 'Balance de cuisine', 'Passoire', 'Rouleau à pâtisserie'], ['moyenne', 'recettes de cuisine', 'plat', 'cocktail', 'gélatine', 'Dôme croquant de chocolat blanc à la mousse de fruits rouges et coeur de fraise', 'sucre', 'plat de résistance', 'chocolat blanc', 'bon marché', 'rapide', 'recette', 'fraises', 'crème fleurette', 'cuisine', 'blanc d''oeuf', 'testées', 'entrée', 'dessert', 'mousse au chocolat', 'boisson', 'recettes', 'beurre', 'fruits rouges', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:19:34.482259', [{'ingredient_id': 'c71033e9-9d3d-4783-936d-078d6f03c463', 'quantite': '200 g'}, {'ingredient_id': '4a5ca809-9af5-43f8-b5f4-6c3e6192f7d4', 'quantite': '1'}, {'ingredient_id': 'e09e9769-98ac-417b-9af0-33a76b90208a', 'quantite': '250 g'}, {'ingredient_id': '2f70ceb2-c665-4cd9-968f-dd09b2989f90', 'quantite': '50 g'}, {'ingredient_id': '55f84e5a-9a2d-4a18-b57c-858c4b4c109b', 'quantite': '1'}, {'ingredient_id': '97785cae-f85b-48b7-844a-2d1377d3868b', 'quantite': '5 cl'}, {'ingredient_id': '8c78f906-d32a-4196-a075-608646467f96', 'quantite': '2'}, {'ingredient_id': '338b5e4d-3e92-4f02-bc3b-9c093c581744', 'quantite': '10'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28919, 'Tiramisu aux framboises : la recette inratable', 'oeuf, sucre roux, sucre vanillé, mascarpone, biscuits à la cuillère, lait, framboises', '25 min', ['Dans le fond d''un plat, disposer des biscuits cuillère trempés dans du lait (cette étape n''est pas obligatoire car ils absorberont le jus des framboises). ', 'Dans un saladier, écraser les framboises avec 30 g de sucre avec une fourchette ou presse-purée. Les répartir sur le fond de biscuits et mettre au réfrigérateur. En garder quelques-unes entières pour la décoration. ', 'Pendant ce temps, séparer les blancs des jaunes d''oeufs. ', 'Battre les jaunes avec le sucre et le sucre vanillé jusqu''à blanchiment du mélange. Rajouter le mascarpone au fouet. ', 'Monter les blancs en neige bien fermes et les incorporer délicatement au mélange précédent avec une cuillère en bois. ', 'Verser la préparation sur les framboises. ', 'Mettre au réfrigérateur 24 heures avant de servir, voire 48h.'], ['Passoire', 'Pince de cuisine'], ['sucre vanillé', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'biscuits à la cuillère', 'oeuf', 'Tiramisu aux framboises : la recette inratable', 'framboises', 'tiramisu', 'rapide', 'moyen', 'recette', 'cuisine', 'lait', 'sucre roux', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'mascarpone', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:19:41.045227', [{'ingredient_id': 'eef41895-90b4-434b-a2dc-7d452f352cbb', 'quantite': '3'}, {'ingredient_id': '0bb2ceef-24d7-465f-93d7-64206780a4a3', 'quantite': '100 g'}, {'ingredient_id': '58f9136a-2083-4031-b148-e3db21b02aea', 'quantite': '1'}, {'ingredient_id': 'b75605d7-59f7-454e-bf5a-49fa4b8eb033', 'quantite': '250 g'}, {'ingredient_id': '17b14889-f3f2-4910-bb45-513fca21a4ea', 'quantite': '24'}, {'ingredient_id': 'd6cee4ef-cb2c-4a69-abe2-2689f46a651f', 'quantite': ''}, {'ingredient_id': '18049018-e609-4fc7-8b1c-0c45799cc8fb', 'quantite': '500 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81215, 'Muffins chocolat et framboise', 'chocolat noir, beurre, oeuf, sucre en poudre, sucre vanillé, farine, framboises, sucre glace', '25 min', ['Préchauffez le four thermostat 6 (180°C). ', 'Cassez le chocolat en morceaux et faites-le fondre au bains marie ou au micro ondes et faites fondre le beurre sur feu doux.', 'Battez les oeufs, le sucre en poudre et le sucre vanillé. Ajoutez le chocolat et le beurre fondu, puis la farine tamisée en pluie. Incorporez les framboises.', 'Remplissez aux 3/4 quarts les moules à muffins. Laissez cuire environ 15 min, la pâte doit rester moeulleuse à l''intérieur. Après les avoir démoulés une fois tièdes, saupoudrez de sucre glace.'], ['Planche à découper', 'Presse-agrumes', 'Verre doseur'], ['sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'Muffins chocolat et framboise', 'plat de résistance', 'oeuf', 'muffin', 'framboises', 'moyen', 'recette', 'sucre en poudre', 'cuisine', 'testées', 'sucre glace', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'farine', 'chocolat noir'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:19:45.873723', [{'ingredient_id': 'dfd3b50e-902d-4ce7-8ed6-88a2a72d98dd', 'quantite': '100 g'}, {'ingredient_id': '2df35e75-6b4a-445f-9ade-479da2ec651c', 'quantite': '130 g'}, {'ingredient_id': 'a645dbea-8f39-4b13-a8ff-edbd0bd661f2', 'quantite': '2'}, {'ingredient_id': 'dd757a6d-fcb2-4fc2-a0f1-8c3075c9a55c', 'quantite': '180 g'}, {'ingredient_id': 'ed065e56-8086-43b6-9792-d6122169b11a', 'quantite': '1'}, {'ingredient_id': '87023ad8-e5e0-4e21-9e82-7b0878467f13', 'quantite': '100 g'}, {'ingredient_id': '68129067-b5f3-47f4-9cb3-b09061e02f08', 'quantite': '150 g'}, {'ingredient_id': 'dab752da-8bed-4a0f-ac55-b9381fdb4ba7', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31214, 'Charlotte aux fraises', 'sucre en poudre, liqueur de fraises, gélatine, fraises, citron, crème liquide, sucre vanillé, biscuits à la cuillère, glaçons', '60 min', ['Préparer un sirop en portant à ébullition 15 cl d''eau et 80 g de sucre. Oter du feu et laisser refroidir, ensuite y mettre l''alcool de fraise.', 'Faire tremper la gélatine dans un bol d''eau froide.', 'Laver et équeuter les fraises et en mettre 8 entières de côté.
Mettre les autres fraises dans un mixeur avec le jus de citron et mixer jusqu''à obtenir une puréee lisse. Tranvaser cette purée dans une passoire afin de récolter le coulis et retenir les grains.', 'Prélever un quart de ce coulis et le faire chauffer doucement dans une casserole en y incorporant la gélatine essorée et le restant de sucre. ', 'Ensuite, mélanger le coulis obtenu (chaud) avec le coulis froid. Laisser tiédir à température ambiante. ', 'Mettre la crème liquide dans un saladier et mettre au congelateur 20 mn. Puis la fouetter de façon à obtenir une crème "chantilly". Mettre le sucre vanillé, remuer doucement et mettre en attente au frais. ', 'Placer le récipient où se trouve le coulis dans un récipient + grand rempli de glaçons. Remuer le coulis jusqu''à constater son épaississement. A ce moment, l''ôter des glaçons et y ajouter la chantilly en tournant délicatement. Laisser à température ambiante.', 'Couper les 8 fraises mises de côté dans leur hauteur.
Tapisser le fond et les parois du moule avec des biscuits trempés (vite fait) dans le sirop (les tailler si besoin). Pour les parois : côté bombé contre le moule.', 'Verser un tiers de la crème puis parsemer de fraises coupées (la moitié). ', 'Couvrir du second tiers de crème, disposer le restant de fraises coupées. Terminer par le dernier tiers de crème. Finir par une couche de biscuits (toujours trempés dans le sirop). ', 'Mettre du film plastique sur le plat et laisser au frais 6h (une nuit est l''idéal) avant de démouler.'], ['Économe', 'Planche à découper', 'Verre doseur'], ['sucre vanillé', 'difficile', 'recettes de cuisine', 'plat', 'cocktail', 'gélatine', 'charlotte aux fraises', 'plat de résistance', 'citron', 'biscuits à la cuillère', 'bon marché', 'Charlotte aux fraises', 'liqueur de fraises', 'rapide', 'recette', 'sucre en poudre', 'glaçons', 'crème liquide', 'fraises', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', 13ee6d32-ce1d-46d2-9737-ae5fca483fc7, '2025-09-26T15:19:52.764563', [{'ingredient_id': 'dfcc3ff8-2eb0-4c78-aaee-ae8632c79a83', 'quantite': '140 g'}, {'ingredient_id': 'fe1b4b84-78b5-46e7-b05c-5389db73855f', 'quantite': '1 cuillères'}, {'ingredient_id': 'fa7fe414-394e-497c-bb1b-8cb6b33741c2', 'quantite': '6'}, {'ingredient_id': 'cf0debae-23ec-4f1d-8425-487b7fc29f1a', 'quantite': '500 g'}, {'ingredient_id': 'be00f6d1-7efd-4fd7-a4af-d6575dee9721', 'quantite': '1'}, {'ingredient_id': '6905d43f-1214-4ca3-8b76-e1be594351f6', 'quantite': '40 cl'}, {'ingredient_id': '1a5301ac-70e0-4ce8-88ea-fe0361ec9f2a', 'quantite': '1'}, {'ingredient_id': 'cdb5d3a2-cfc9-4314-bd63-478399ab878b', 'quantite': '26'}, {'ingredient_id': '617c105f-edff-47a6-869a-7b8567e4a894', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166389, 'Verrines pistaches, framboises et spéculoos', 'pâte de pistache, mascarpone, oeuf, sucre, citron, framboises, spéculoos', '25 min', ['- Ecraser grossièrement les framboises avec une fourchette. Y ajouter le jus du demi citron.', 'Vous pouvez ajouter un peu de sucre en poudre selon votre goût.', '- Verser cette purée de framboise au fond des verrines.', '- Ecraser les spéculoos avec un pillon : ils doivent être réduits en poudre. ', 'Déposer 2 à 3 cuillères à soupe de cette poudre sur la couche de framboise.', '- Blanchir les 2 jaunes d''oeuf avec le sucre.', '- Ajouter une cuillère à soupe de pâte de pistache et bien mélanger (la pâte est difficile à "dissoudre").', '- Ajouter le mascarpone en mélangeant encore bien.', '- Monter les deux blancs en neige et les incorporer délicatement à la préparation.', '- Disposer cette crème sur la couche de spéculoos.', 'Réserver au frais au moins deux heures .', 'Pour la déco : quelques framboises disposées sur le dessus.'], ['Presse-agrumes', 'Passoire', 'Mixeur', 'Râpe', 'Verre doseur'], ['facile', 'speculoos', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'pâte de pistache', 'plat de résistance', 'citron', 'oeuf', 'framboises', 'rapide', 'framboises et spéculoos', 'moyen', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'Verrines pistaches', 'boisson', 'recettes', 'mascarpone', 'confiserie', 'spéculoos'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:19:56.279852', [{'ingredient_id': '53948bd3-8909-4ee9-9f7c-5b199b6bf64b', 'quantite': ''}, {'ingredient_id': 'f6a5942b-9c87-41e9-aeab-d984952ccd9d', 'quantite': '200 g'}, {'ingredient_id': '2ec91393-db06-4e57-b465-5646eb382ff8', 'quantite': '2'}, {'ingredient_id': '84b7ddc2-89f9-4f63-b249-c743be2a0c24', 'quantite': '40 g'}, {'ingredient_id': 'e1736785-3ebd-4984-a8a1-fddabb4fdf0d', 'quantite': ''}, {'ingredient_id': '6ffa6b85-9e8b-4e53-839e-1acb4dd252ea', 'quantite': '1'}, {'ingredient_id': '7f38eb91-9001-40eb-8267-9a6530940b3e', 'quantite': '12'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30516, 'Muffins à la framboise', 'framboises, farine, farine, cassonade, oeuf, lait, beurre, farine, beurre, cassonade, cannelle', '20 min', ['Tamiser les deux farines, incorporer la cassonade et les framboises.', 'Fouettez les oeufs et le lait dans une jatte puis ajouter la préparation aux ingrédients précédents avec le beurre. Mélanger. La pâte doit rester grumeleuse.', 'Pour le streusel, mettre la farine, le beurre et la cassonade dans un saladier et émietter avec le bout des doigts. En parsemer le dessus des muffins non cuits et appuyer légèrement. Cuire 25-30 minutes à 210°.'], ['Couteau de chef', 'Presse-agrumes', 'Batteur électrique', 'Passoire', 'Fouet'], ['facile', 'cassonade', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'oeuf', 'muffin', 'framboises', 'recette', 'cuisine', 'lait', 'Muffins à la framboise', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'farine'], 'Dessert', 1512727e-f8a2-45b1-9b16-650309c56bf6, '2025-09-26T15:20:01.041270', [{'ingredient_id': '9e9fd4ac-09f9-4047-ac61-ec052bba0e06', 'quantite': '200 g'}, {'ingredient_id': '77a248f4-9ead-45a6-ab72-4498e33b500b', 'quantite': '225 g'}, {'ingredient_id': 'ae484fb8-8647-4fc1-a4b3-29af20da5b01', 'quantite': '150 g'}, {'ingredient_id': '50150e6e-9da5-4dce-8906-91e2179d3a64', 'quantite': '115 g'}, {'ingredient_id': '84c96ec9-2ec7-4965-8866-02a097f2ceed', 'quantite': '2'}, {'ingredient_id': '3128075b-f828-4f42-8b20-bc8a3a51d605', 'quantite': '25 cl'}, {'ingredient_id': 'd97b3301-b195-4d82-9d06-be741d406791', 'quantite': '125 g'}, {'ingredient_id': '73029eeb-9fde-4198-841e-bffe9bd5dfb2', 'quantite': '50 g'}, {'ingredient_id': '686a058a-2b52-4dc0-85c8-8a515cc7d574', 'quantite': '30 g'}, {'ingredient_id': '4d2d8b1f-e47b-476a-9c0c-4d34fc3817bb', 'quantite': '2 cuillères'}, {'ingredient_id': '2d9ad5f4-1789-4f40-95b3-5926757d8c7e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46617, 'Charlotte aux framboises et sa mousse', 'boudoir, coulis de framboise, framboises, crème fraîche, sucre en poudre, gélatine, blanc d''oeuf, sirop de fraise', '60 min', ['S''y prendre une journée à l''avance !', 'Prendre 300 g de framboises décongelées , les écraser dans une casserole à petit feu.', 'Pendant ce temps , faire ramollir les feuilles de gélatine dans de l''eau froide . Lorsque les framboises sont liquides , y ajouter le sucre , bien remuer , puis la gélatine . Réserver de côté . ', 'Monter la crème fraîche en chantilly et les blancs en neige . ', 'Dans un saladier , y mettre la soupe de framboises et y incorporer très délicatement la chantilly puis les blancs en neige. Réserver au réfrigérateur au moins 12 h (ou une nuit) . Garder le reste des framboises au frais . ', 'Préparer le moule à charlotte en le tapissant de boudoirs préalablement trempés dans de l''eau au sirop .', 'Y mettre la moitié de la mousse aux framboises . Bien répartir la mousse sur la surface . ', 'Prendre le reste des framboises de la veille, (en garder quelques unes pour la décoration) et les écraser à la fourchette . Répartir la préparation sur la couche de mousse , puis mettre le reste de la mousse . Refermer la charlotte par le reste des boudoirs . Poser sur le moule le plat de service et bien aplatir . Tant pis si ça déborde !', 'Mettre au réfrigérateur au moins 4 h . Démouler , couvrir de coulis et parsemer de framboises. '], ['Balance de cuisine', 'Poêle', 'Spatule', 'Planche à découper', 'Râpe'], ['recettes de cuisine', 'plat', 'cocktail', 'gélatine', 'mousse fruits', 'crème fraîche', 'plat de résistance', 'framboises', 'rapide', 'moyen', 'recette', 'sucre en poudre', 'Charlotte aux framboises et sa mousse', 'boudoir', 'sirop de fraise', 'cuisine', 'coulis de framboise', 'blanc d''oeuf', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:20:05.858038', [{'ingredient_id': '09f0269a-6fd8-47f8-b8cf-1eb78c45e08f', 'quantite': ''}, {'ingredient_id': '7d531c5e-f2e2-4a45-b8f3-3cbd75c3f942', 'quantite': ''}, {'ingredient_id': '14bcf18f-01b1-4c84-99be-61ed5a18e5b1', 'quantite': '500 g'}, {'ingredient_id': 'abbce311-b99f-43a2-8dc1-009e82f5f782', 'quantite': '150 g'}, {'ingredient_id': '12ea99e3-c71e-4469-b83b-7dd46e817f8c', 'quantite': '100 g'}, {'ingredient_id': '01043ede-a0a9-4f86-84a9-058a54216edb', 'quantite': '3'}, {'ingredient_id': 'a5756d71-726f-4ae3-b621-87365c92ab97', 'quantite': '2'}, {'ingredient_id': '404cc0c9-0016-4096-ac72-9fdfb6940b54', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (168545, 'Verrines de framboises au mascarpone', 'mascarpone, framboises, biscuits à la cuillère, miel, crème chantilly, biscuit', '15 min', ['Battre le mascarpone avec le miel et ajouter délicatement la chantilly.', 'Ecraser ensuite les biscuits et tapisser le fond de chaque verrine.', 'Ajouter les framboises et le mélange au mascarpone.', 'Décorer avec quelques framboises et des morceaux de biscuits.', 'A déguster frais.'], ['Fouet', 'Tire-bouchon', 'Économe'], ['', 'facile', 'recettes de cuisine', 'plat', 'biscuit', 'cocktail', 'Verrines de framboises au mascarpone', 'plat de résistance', 'biscuits à la cuillère', 'miel', 'framboises', 'rapide', 'moyen', 'recette', 'crème chantilly', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'mascarpone', 'confiserie'], 'Dessert', 74c85acf-2697-4dfc-a19f-826f986b33c5, '2025-09-26T15:20:09.454093', [{'ingredient_id': '77215951-71af-4b94-9b26-f11de6119120', 'quantite': '200 g'}, {'ingredient_id': 'f17f5a93-9311-4e21-b755-8f8dc5237855', 'quantite': '200 g'}, {'ingredient_id': '6ba1f15e-d631-4724-8da9-95287cc178b2', 'quantite': '8'}, {'ingredient_id': '0f371d29-1bdd-4028-844b-4c520e3f192b', 'quantite': '3 cuillères'}, {'ingredient_id': 'a77a598c-6560-4835-ba5c-cf4ecca31dd9', 'quantite': '100 g'}, {'ingredient_id': '96fca487-e590-4d62-9838-2e3b65718d12', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14618, 'Croustade aux Pommes (Gascogne)', 'filo, pomme, pruneau, beurre, sucre en poudre, armagnac, cannelle, poivre, sel', '30 min', ['Clarifiez le beurre : faites-le fondre à feu doux dans une petite casserole, ôtez à l''aide d''une cuillère la fine pellicule blanche qui s''est formée à la surface, puis versez délicatement le beurre fondu dans un bol, pour', 'que le petit lait déposé au fond reste dans la casserole. Le beurre ainsi obtenu ne contient plus du tout d''humidité, ce qui l''empêchera de noircir pendant la cuisson du feuilletage.', 'Préparez les fruits : dénoyautez les pruneaux, coupez-les en lamelles, faites-les mariner dans 4 cuillères à soupe d''armagnac. Épluchez les pommes, coupez-les en fines lamelles en éliminant le cœur et les pépins. Faites-les sauter à feu moyen dans 1 cuillère à soupe de beurre. Poudrez-les de la moitié du sucre et de la', 'cannelle. Faites-les caraméliser 10 mn en secouant le manche de la poêle.', 'Préchauffez le four à thermostat 6 (180°C).', 'Avec un pinceau souple, badigeonnez de beurre clarifié le fond d''un moule à manqué. Beurrez de', 'la même façon 3 feuilles de filo. Disposez-les en croix au fond du moule pour qu''elles le recouvrent', 'parfaitement et que les bords dépassent d''environ 3 à 4 minutes. Répartissez 1/3 des pommes et des', ' pruneaux, sucrez. Recommencez l''opération 2 fois. Rabattez les bords des feuilles de filo sur la dernière couche de fruits.', 'Badigeonnez de beurre, poudrez de sucre et enfournez pour 15 mn.', 'Démoulez délicatement la croustade en la retournant sur une assiette, entaillez la surface avec un couteau et arrosez d''armagnac.', 'Servez aussitôt.'], ['Casserole', 'Économe'], ['', 'moyenne', 'cannelle', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'armagnac', 'pruneau', 'Croustade aux Pommes (Gascogne)', 'filo', 'sel', 'recette', 'sucre en poudre', 'cuisine', 'poivre', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:20:14.243795', [{'ingredient_id': '52589f1a-c4c9-4156-8202-7cf935a26fcd', 'quantite': '12'}, {'ingredient_id': '8080078c-31b2-47f3-9ef4-246c6af536ae', 'quantite': '4'}, {'ingredient_id': 'c7908d25-6373-4a14-9f2c-ef645c876bdf', 'quantite': '8'}, {'ingredient_id': '1f6c29c3-bf2d-43b3-9719-47174263d548', 'quantite': '100 g'}, {'ingredient_id': '7b4cb3d9-a7d2-4432-b6c8-faac9d865f07', 'quantite': '100 g'}, {'ingredient_id': 'a79a915f-8186-4111-8f38-9609a57b4184', 'quantite': '8 cuillères'}, {'ingredient_id': '439ec798-8db7-4959-97a6-62bedf47b402', 'quantite': '1 cuillères'}, {'ingredient_id': 'cf2f8f09-cd6d-44f8-a194-157780a23d1a', 'quantite': ''}, {'ingredient_id': '85c0335a-1898-423a-a38f-2c87160634d0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (82777, 'Gâteau à la fraise et au mascarpone', 'oeuf, yaourt, huile, farine, sucre, levure chimique, mascarpone, sucre, fraises', '10 min', ['Préchauffer votre four à 180°C (thermostat 6).', 'Séparer les blancs des jaunes d''oeufs.', 'Dans une jatte, battre les jaunes d''oeufs avec le yaourt. ', 'Ensuite ajouter la farine, la levure, le sucre et l''huile.', 'Battre les blancs en neige et les ajouter à la préparation.', 'Bien mélanger jusqu''à ce qu''à obtenir une pâte homogène.', 'Verser la pâte dans un moule rond et mettre au four 40 minutes.', 'Pendant ce temps, couper les fraises en tranches. ', 'Réserver.', 'Mélanger le mascarpone avec le sucre et réserver.', 'Une fois le gâteau cuit et refroidi, le couper en deux.', 'Mettre de la crème de mascarpone à l''intérieur ainsi que des fraises. ', 'Le refermer.', 'Sur le dessus répéter la même opération.', 'Mettez votre gâteau au frais si vous ne le consommez pas tout de suite.'], ['Tire-bouchon', 'Poêle'], ['recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'Gâteau à la fraise et au mascarpone', 'sucre', 'plat de résistance', 'yaourt', 'bon marché', 'oeuf', 'gâteaux aux fruits', 'recette', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'huile', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:20:20.140746', [{'ingredient_id': '509691b1-1113-4d43-87e8-c0b5c4d04ab1', 'quantite': '3'}, {'ingredient_id': '8894d402-9783-48ef-8da7-f651892d6b5c', 'quantite': '1'}, {'ingredient_id': '092c2280-73ea-44a7-82b7-4bbe13436576', 'quantite': '1'}, {'ingredient_id': '4c93caa8-b61d-4fda-9414-3b4cda0aa73b', 'quantite': '200 g'}, {'ingredient_id': '9158c694-c92c-46ce-ba4f-bab4faca5be3', 'quantite': '150 g'}, {'ingredient_id': '6ff138d3-2d1e-4de7-bd8e-3984a623975a', 'quantite': '1'}, {'ingredient_id': 'cb308494-3d3e-4d33-9b3a-06d2bfec5488', 'quantite': '500 g'}, {'ingredient_id': 'f109a317-7cff-4bec-8ea5-80ee155a9653', 'quantite': '100 g'}, {'ingredient_id': 'c20f6287-529f-4955-b885-87b1274940db', 'quantite': '700 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (94778, 'Tiramisu pomme caramel beurre salé', 'pomme, compote, spéculoos, caramel au beurre salé, cannelle, mascarpone, oeuf, sucre, sucre vanillé', '10 min', ['Préparation de la crème "tiramisu":', 'Séparer les blancs d''oeuf des jaunes', 'Mélanger les jaunes, le sucre vanillé et le sucre', 'Rajouter le mascarpone au fouet', 'Monter les blancs en neige et les incorporer délicatement à la spatule', 'Réserver', 'Eplucher, vider les pommes et les couper en dés', 'Briser les speculoos en petits bouts', 'Installation dans les verrines:', 'Disposer les petits morceaux de specullos', 'Recouvrir de compote (un demi-pot par verrine)', 'Disposer les dés de pommes', 'Passer le caramel au micro-onde quelques secondes pour le ramollir', 'Arroser les dés de pomme de caramel (une cueillère à soupe par verrine)', 'Recouvrir de la crème de tiramisu (une couche généreuse, 2 cm environ)', 'Saupoudrer de cannelle et ajouter un dé de pomme sur le sommet', 'Réserver 2h minimum au frais'], ['Râpe', 'Balance de cuisine', 'Tire-bouchon'], ['cannelle', 'sucre vanillé', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'caramel au beurre salé', 'caramel', 'plat de résistance', 'Tiramisu pomme caramel beurre salé', 'bon marché', 'oeuf', 'rapide', 'recette', 'cuisine', 'testées', 'très facile', 'compote', 'entrée', 'dessert', 'boisson', 'recettes', 'mascarpone', 'confiserie', 'pomme', 'spéculoos'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:20:24.616003', [{'ingredient_id': '7fa88cde-df78-4140-b7ea-6c9635896d7e', 'quantite': '4'}, {'ingredient_id': 'c35ee5e2-3219-47a3-b0f4-ffbc843460c4', 'quantite': '600 g'}, {'ingredient_id': 'cd630a02-71dd-41eb-8e80-c3f54cedd841', 'quantite': '24'}, {'ingredient_id': '57545cbc-1854-4569-9897-37ad8c99b535', 'quantite': '6'}, {'ingredient_id': '9000e2db-43db-4af8-8a62-ec137110b777', 'quantite': '1 cuillères'}, {'ingredient_id': '5fa860fa-42c9-4083-8c0e-d30890f86789', 'quantite': '250 g'}, {'ingredient_id': 'e22ab4cc-178c-44c3-ae9a-1e58d7893d20', 'quantite': '3'}, {'ingredient_id': 'f41895f5-eec2-4e14-90e6-764b024ea504', 'quantite': '100 g'}, {'ingredient_id': 'c7f7a3cb-7169-4d87-9a92-6dedba0e6748', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27529, 'Gratin de purées de carotte et pomme de terre', 'carotte, pomme de terre, oignon, beurre, oeuf, crème fraîche, gruyère râpé, muscade, poivre, sel', '30 min', ['Peler les carottes et les pommes de terre, puis les plonger dans l''eau bouillante salée et les laisser cuire au moins 40 min.', 'Les égoutter, les couper en morceaux puis les écraser à la fourchette ou passer au presse-purée.', 'Peler et hacher les oignons, les faire fondre à la poêle avec un peu de beurre.', 'Préchauffer le four à 210°C (thermostat 7).', 'Dans un saladier, battre les oeufs avec la crème, le gruyère et la noix de muscade. Incorporer ensuite les oignons fondu, le sel et le poivre, puis la purée de carottes/pommes de terre.', 'Etaler le tout dans un plat à gratin beurré.', 'Saupoudrer de gruyère râpé et de quelques noisettes de beurre. Enfourner à four chaud pendant 10 à 15 min, puis déguster.'], ['Batteur électrique', 'Balance de cuisine', 'Pince de cuisine', 'Fouet', 'Louche'], ['Gratin de purées de carotte et pomme de terre', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'crème fraîche', 'plat de résistance', 'autre gratin de pommes de terre', 'oeuf', 'sel', 'moyen', 'oignon', 'recette', 'carotte', 'cuisine', 'gruyère râpé', 'poivre', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'pomme de terre', 'confiserie', 'muscade'], 'Plat principal', 03b7ff37-0801-49f0-93cb-71ae96b1da25, '2025-09-26T15:20:31.326658', [{'ingredient_id': 'ce11899d-accb-4bd0-bb25-3ffd33be1913', 'quantite': '500 g'}, {'ingredient_id': 'a3b0d765-d697-4063-a59c-adb930b7a63a', 'quantite': '500 g'}, {'ingredient_id': '13388009-47bd-481f-83b0-33a67f11a3ec', 'quantite': '2'}, {'ingredient_id': '9bc1453e-298c-4fc0-aebb-9fbdc192fdf1', 'quantite': ''}, {'ingredient_id': '59a0e151-8b40-48f6-97d4-7589cd29b633', 'quantite': '2'}, {'ingredient_id': 'ecb7800b-1d68-46fa-b79c-0bec1af45524', 'quantite': '10 cl'}, {'ingredient_id': '0bd14286-311b-4ee9-b186-9bcee68f29f3', 'quantite': '50 g'}, {'ingredient_id': 'd91729cf-1667-4154-96c3-617fe1a6b7ff', 'quantite': ''}, {'ingredient_id': '504f7d68-6c6f-4494-88dd-e5a7fce1cd9c', 'quantite': ''}, {'ingredient_id': '7d02c75b-763a-4b57-a731-8f39d67d54e5', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32133, 'Gâteau aux pommes croustillant de maman', 'farine, lait, sucre, huile, oeuf, sel, levure, pomme, beurre, sucre, sucre vanillé, oeuf', '15 min', ['Mélanger la farine, le sucre la levure et le sel. Ajouter l''huile, le lait et l''oeuf. Bien mélanger.', 'Verser dans un moule à manqué beurré ET fariné.', 'Y déposer les tranches de pommes (épluchées et coupées en 12 tranches à peu près!) tout en les chevauchant.', 'Mettre au four 25 minutes à thermostat 6 (180°C).', 'Préparer la crème : faire fondre le beurre et ajouter le sucre, la vanille et l''oeuf.', 'Quand le gâteau commence à dorer et à lever (après 25 mn), verser la crème dessus.', 'Terminer la cuisson (15 minutes).'], ['Tire-bouchon', 'Pince de cuisine'], ['facile', 'gâteau aux pommes', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'bon marché', 'oeuf', 'sel', 'levure', 'recette', 'cuisine', 'lait', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme', 'huile', 'farine', 'Gâteau aux pommes croustillant de maman'], 'Dessert', 1ad13f63-7ea3-4761-b00c-809510e6506a, '2025-09-26T15:20:38.334174', [{'ingredient_id': '1dd911e6-cbad-4420-af8d-2391253c5787', 'quantite': '100 g'}, {'ingredient_id': '4f509518-96df-419e-a1e4-3d9839078b79', 'quantite': '5 cl'}, {'ingredient_id': 'af1cee15-f122-41c1-b0ec-f6e2ceb75b59', 'quantite': '90 g'}, {'ingredient_id': 'a773e9a0-aa2f-4063-b4f7-6d4b522cb203', 'quantite': '3 cl'}, {'ingredient_id': 'e95e45c0-0dad-4d1d-b420-c3904a2470d5', 'quantite': '1'}, {'ingredient_id': 'abc833f3-b4ea-4d2e-bd50-b3381b39009c', 'quantite': '1'}, {'ingredient_id': '65b9c906-7f68-4186-b123-e62c7d38148a', 'quantite': ''}, {'ingredient_id': '84345104-801d-4a92-bd9a-950bca520178', 'quantite': '3'}, {'ingredient_id': '0ad53e9b-3bbc-4b01-ad44-431b0cbc88a0', 'quantite': '80 g'}, {'ingredient_id': '0d001d6e-aeea-4eae-9944-dab89308de90', 'quantite': '100 g'}, {'ingredient_id': '667a31de-f4c9-4159-ad18-c54011ef01ce', 'quantite': '1'}, {'ingredient_id': '93d2add3-8bee-4188-a795-085c9eebdb7a', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15104, 'Poulet au cidre et aux pommes', 'poulet, pomme, cidre, lardons fumés, cannelle, crème fraîche, oignon, poivre, sel', '40 min', ['Couper le poulet en morceaux. Dans une cocotte, avec un mélange beurre-huile, faire revenir le lard fumé pendant 10 mn, le réserver sur une assiette et faire revenir à la place l''oignon émincé et le poulet en morceaux.', 'Pendant ce temps, saler, poivrer et peler les pommes, les couper en gros quartiers, les ajouter dans la cocotte, y remettre également les lardons et mouiller le tout avec les 25 cl de cidre. ', 'Saupoudrer d''une pincée de cannelle avant de couvrir la cocotte et laisser cuire 1 h à feu très modéré.', 'Disposer poulet, pommes et lardons dans un plat creux, en gardant au chaud. Saupoudrer le fond de la cocotte d''une cuillère à café de sucre en poudre, laisser caraméliser 3 mn, puis mouiller avec un demi-verre de cidre et ajouter la crème fraiche.', 'Donner quelques bouillons et verser cette sauce sur la fricassée de poulet.'], ['Pince de cuisine', 'Tire-bouchon'], ['cannelle', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'crème fraîche', 'plat de résistance', 'poulet', 'sel', 'moyen', 'poulet en sauce', 'oignon', 'recette', 'lardons fumés', 'cuisine', 'poivre', 'testées', 'Poulet au cidre et aux pommes', 'entrée', 'dessert', 'cidre', 'boisson', 'recettes', 'confiserie', 'pomme'], 'Plat principal', f35f79cd-5d8c-40e1-9f0d-609a9504114b, '2025-09-26T15:20:44.062601', [{'ingredient_id': '4352c09e-e198-4f27-820e-744a9483c9c5', 'quantite': '1'}, {'ingredient_id': 'c6a27f38-4afb-4321-a08f-99d0078b1360', 'quantite': '1 kg'}, {'ingredient_id': '57fe78af-15e9-4551-9e32-45ec37c1068f', 'quantite': '25 cl'}, {'ingredient_id': '40eab0ff-0f0c-4dd5-a676-2fd902bcc5e0', 'quantite': '200 g'}, {'ingredient_id': '91d03b51-3902-487f-bca3-3024501e981d', 'quantite': ''}, {'ingredient_id': '27037294-0b0e-4004-9710-61841007b4dd', 'quantite': '2'}, {'ingredient_id': 'ff1df05b-03d7-49ef-930b-0981aec6f499', 'quantite': '1'}, {'ingredient_id': '2838ae88-ea44-47bd-8462-e84a7cbf086a', 'quantite': ''}, {'ingredient_id': '18f74a93-98e8-4d33-9402-ff543204549e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15002, 'Confiture de fraises au micro-ondes', 'fraises, sucre, citron, beurre', '10 min', ['Equeuter les fraises et coupez les en deux ou en quatre. Placez les dans une cocotte et ajouter le sucre, petit à petit.', 'Couvrir et laisser reposer toute une nuit jusqu''à ce que les fraises aient rendu tout leur jus. Ajouter le jus de citron avant de faire cuire.', 'Cuisson : faire cuire à découvert 6 mn à pleine puissance. Remuer et refaire cuire 6 mn à pleine puissance.', 'Ajouter le beurre, laisser reposer 15 mn et mettre en pots préalablement ébouillantés. ', 'Enfoncer bien les fraises dans le sirop, fermer et retourner les pots.'], ['Verre doseur', 'Fouet', 'Pince de cuisine', 'Batteur électrique'], ['recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'Confiture de fraises au micro-ondes', 'citron', 'bon marché', 'rapide', 'recette', 'fraises', 'cuisine', 'confiture de fraise', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie'], 'Dessert', 65f7322f-8b42-439b-b736-dd1fea0c7c98, '2025-09-26T15:20:47.639702', [{'ingredient_id': '9a764ff4-4a66-40a3-8be9-49d5275aed94', 'quantite': '500 g'}, {'ingredient_id': 'ae6513cf-9882-4592-afd9-95f6ef69ad8b', 'quantite': '500 g'}, {'ingredient_id': 'b4ade2f6-a80e-4562-a554-937fd5c2d654', 'quantite': '3 cuillères'}, {'ingredient_id': 'ec267e0c-2315-4be3-89c3-dec4f2100793', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28963, 'Pommes au four façon mamie', 'pomme, beurre, sucre en poudre, biscotte', '10 min', ['1) Préchauffer le four à 220°C. ', '2) Evider le coeur des pommes à l''aide d''un vide-pomme (enlever le trognon), pas besoin de les peler. ', '3) beurrer le plat et déposer les biscottes. Poser les pommes sur les biscottes, remplir le coeur des pommes de beurre et saupoudrer largement de sucre et mettre au four pendant 25 à 30 mn.'], ['Poêle', 'Louche', 'Casserole'], ['biscotte', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'recette', 'sucre en poudre', 'cuisine', 'Pommes au four façon mamie', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'pomme au four'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:20:53.129792', [{'ingredient_id': 'cbeaa31a-553d-4dae-a128-7c22edaeda16', 'quantite': '2'}, {'ingredient_id': '4db874ba-0bef-47b9-a7e0-f69c3b10e38f', 'quantite': '2'}, {'ingredient_id': 'f9a6bd4b-22c4-43c5-8c74-b79300a42e22', 'quantite': '50 g'}, {'ingredient_id': 'b64cfaa1-4541-485a-a464-f81dd8d982cd', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55150, 'Far breton aux pommes', 'pomme, farine, sucre, sucre vanillé, oeuf, lait, crème liquide, beurre', '15 min', ['Préchauffez le four à 180°C (th.6).', 'Coupez les pommes en petits morceaux.', 'Beurrez un plat à dessert et poudrez le de sucre.', 'Dans un saladier mélangez la farine, le sucre vanillé et le sucre, puis incorporez les oeufs un à un en fouettant sans arrêt.', 'Versez ensuite le lait puis la crème, sans arrêter de fouetter jusqu''à obtention d''une pâte bien lisse.', 'Ajoutez les pommes, mélangez.', 'Versez la pâte dans le plat et enfournez pour 45 min.', 'Sortez du four, saupoudrez de sucre.', 'Servez tiède.'], ['Louche', 'Économe', 'Mixeur', 'Spatule', 'Verre doseur'], ['sucre vanillé', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'Far breton aux pommes', 'far breton', 'bon marché', 'oeuf', 'recette', 'crème liquide', 'cuisine', 'lait', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:20:58.723801', [{'ingredient_id': '2504c3eb-beec-4aad-aa8f-41f5686cb8a5', 'quantite': '2'}, {'ingredient_id': '6d3f69e5-0a63-46cb-97e6-38616fd1b453', 'quantite': '100 g'}, {'ingredient_id': 'abfd20f9-a04a-41fe-ad3c-0da8b2cd9d68', 'quantite': '120 g'}, {'ingredient_id': '6b491667-3f3b-4529-a591-3c32465e5035', 'quantite': '2'}, {'ingredient_id': 'b92fd12e-b55e-4415-b97d-2b00f77cc28f', 'quantite': '4'}, {'ingredient_id': 'b21737f5-08e4-44ba-8fc8-8c36c02a31d8', 'quantite': '25 cl'}, {'ingredient_id': '7426f832-fa14-4802-89e6-350fa658a277', 'quantite': '25 cl'}, {'ingredient_id': 'a7d34ed6-321c-4434-9a1e-ca095f677630', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28846, 'Feuilletés au chèvre et aux pommes', 'fromage de chèvre, pâte feuilletée, oeuf, pomme, ciboulette', '5 min', ['Avec un verre découpez 8 rondelles dans la pâte feuilletée. ', 'Coupez 4 rondelles de fromage de chèvre de 1,5 à 2 cm de large. ', 'Coupez 4 rondelles de pomme ou de poire (enlevez d''abord la peau et les pépins). ', 'Faites une sorte de hamburger de la façon suivante : une rondelle de pâte + une rondelle de pomme + une rondelle de chèvre + ciboulette ou herbes + une rondelle de pâte. ', 'Collez les bords des rondelles de pâte (astuce : humecter légèrement les bords avec de l''eau pour qu''elles collent). ', 'Faites dorer avec le jaune d''oeuf. ', 'Enfournez à feu moyen à fort pendant 15 min jusqu''à ce que la pâte soit dorée et cuite. Servez chaud avec de la salade verte ou de la mâche. ', 'Variante : pour faire joli vous pouvez ajouter des graines de sésame ou de pavot par dessus, mais si vous n''en avez pas, un peu d''herbes de Provence fera l''affaire.'], ['Presse-agrumes', 'Râpe'], ['recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'ciboulette', 'bon marché', 'oeuf', 'Feuilletés au chèvre et aux pommes', 'feuilleté', 'recette', 'cuisine', 'fromage de chèvre', 'testées', 'très facile', 'entrée', 'dessert', 'pâte feuilletée', 'boisson', 'recettes', 'confiserie', 'pomme'], 'Entrée', 2235baaf-739f-4b3b-8122-6e4939dd0cb4, '2025-09-26T15:21:05.571434', [{'ingredient_id': 'f7cadbfd-f741-40ed-9bc4-c57a8c0d0fe0', 'quantite': '1'}, {'ingredient_id': '9df2a68e-66a4-4312-aecb-c04d96d7cf21', 'quantite': '1'}, {'ingredient_id': '7c7bdd81-ac6c-4391-bef4-f198b15fd74b', 'quantite': '1'}, {'ingredient_id': 'ae13d152-bcb3-4fbd-bd57-b73ae5b5ce81', 'quantite': '1'}, {'ingredient_id': 'dffed30b-2210-4a3d-a52b-772acb0f5b65', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37801, 'Verres de fraises et mousse au thé vert', 'fraises, fromage blanc, sucre, oeuf, thé matcha, gélatine, lait, pistaches', '15 min', ['Rincez, équeutez et coupez les fraises en petits morceaux.', 'Mettez la gélatine à ramollir dans un bol d''eau froide.', 'Dans un saladier, mélangez le fructose avec le jaune d''œuf, jusqu''à ce que le mélange blanchisse. Ajoutez-y ensuite la cuillère à café de matcha, puis le fromage blanc, et mélangez bien. C’est déjà très beau cette couleur, non ?', 'Faites chauffez le lait et, hors du feu, dissolvez-y les feuilles de gélatine, que vous aurez au préalable bien essorées entre vos mains.', 'Versez le mélange lait gélatine dans le saladier.', 'Battez le blanc en neige et incorporez-le à la préparation verte.', 'Disposez dans les verres les morceaux de fraises, (en en mettant quelques uns de côté) et versez par dessus la mousse au matcha.', 'Décorez avec les morceaux de fraises restant et quelques pistaches.', 'Mettez au frais pendant au moins 2 heures (et plus si affinités) pour que la géaltine ait le temps de prendre.', 'Servez bien frais.'], ['Mixeur', 'Râpe', 'Moule à tarte'], ['recettes de cuisine', 'plat', 'cocktail', 'gélatine', 'mousse fruits', 'sucre', 'pistaches', 'plat de résistance', 'assez cher', 'fromage blanc', 'thé matcha', 'oeuf', 'Verres de fraises et mousse au thé vert', 'rapide', 'recette', 'fraises', 'cuisine', 'lait', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:21:10.256595', [{'ingredient_id': '4c317203-763d-406c-982f-05ce3ab88644', 'quantite': '250 g'}, {'ingredient_id': 'e23ade30-c0bc-409d-b4f9-44cd6a8b60a9', 'quantite': '100 g'}, {'ingredient_id': '8db13657-b152-4621-aaaa-97e7563e8c08', 'quantite': '60 g'}, {'ingredient_id': '9001e59f-1fb9-4768-bc9a-cd7dc90517f5', 'quantite': '1'}, {'ingredient_id': '1c318b0c-058a-4017-8c0a-4f1788a7cb81', 'quantite': '1 cuillères'}, {'ingredient_id': 'f4736833-d908-48c9-9e6c-83c1d625585e', 'quantite': '2'}, {'ingredient_id': 'dc081da5-a615-49c8-93c0-770186c8f892', 'quantite': '2 cuillères'}, {'ingredient_id': '454a3ed2-04c1-4d25-8693-8ef103d8ae44', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16982, 'Gâteau pommes, noix et cannelle', 'cerneau de noix, oeuf, huile, cannelle, sucre vanillé, sucre, farine, levure chimique, pomme', '25 min', ['Mélangez au fouet les oeufs, l''huile, la cannelle, les sucres, puis la farine tamisée avec la levure chimique. Incorporez à la pâte lisse les pommes pelées et coupées en dés et les cerneaux de noix hachés (la pâte est alors très épaisse et dure à mélanger). ', 'Versez dans un moule à cake beurré et fariné.', 'Faites cuire au four à thermostat 6 (180°C) pendant 1 heure environ.'], ['Planche à découper', 'Ouvre-boîte', 'Batteur électrique'], ['cannelle', 'Gâteau pommes', 'sucre vanillé', 'recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'sucre', 'cerneau de noix', 'plat de résistance', 'bon marché', 'oeuf', 'gâteau aux noix', 'recette', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'noix et cannelle', 'boisson', 'recettes', 'confiserie', 'pomme', 'huile', 'farine'], 'Dessert', 6f4e652f-4ba6-43eb-a164-ec62c617923e, '2025-09-26T15:21:16.952656', [{'ingredient_id': 'ee0722f0-73f0-4dc9-b08a-a87c7e377722', 'quantite': '75 g'}, {'ingredient_id': '44707b9f-e291-4448-b350-f4fb9c31523f', 'quantite': '2'}, {'ingredient_id': 'e6fb080e-d4bd-462a-bf6f-8d6386c139a4', 'quantite': '180 ml'}, {'ingredient_id': 'c3e2b0af-93b8-4fbf-8565-a0068e94c9ae', 'quantite': '1 cuillères'}, {'ingredient_id': '532d093c-20a9-4e18-8740-5f68cbacf4f8', 'quantite': '7.5 g'}, {'ingredient_id': '99ff6a3a-6df4-4cdd-ad6b-af5f1a213508', 'quantite': '200 g'}, {'ingredient_id': 'fee3d714-8122-409f-a803-77761d1cdca9', 'quantite': '250 g'}, {'ingredient_id': 'bec984a8-1ec7-4659-898b-600880a7ff70', 'quantite': '2 cuillères'}, {'ingredient_id': '88b9df17-39dd-44ff-a6c5-8a8482283b8b', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (71873, 'Verrine aux fraises', 'fraises, boudoir, crème chantilly, sucre en poudre', '10 min', ['Mixez les fraises, ajoutez le sucre puis mélanger.', 'Dans des verrines, mettez les boudoirs en petits morceaux puis ajoutez une couche de chantilly.', 'Versez la préparation de fraises.', 'Laissez reposer au réfrigérateur pendant au moins 2 heures puis au moment de servir ajoutez de la chantilly sur le dessus.', 'Puis dégustez.', 'Le petit plus : Vous pouvez rajouter des feuilles de menthe dans la préparation de fraise.'], ['Casserole', 'Presse-agrumes', 'Rouleau à pâtisserie', 'Poêle'], ['', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'Verrine aux fraises', 'rapide', 'recette', 'crème chantilly', 'sucre en poudre', 'fraises', 'boudoir', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:21:20.359551', [{'ingredient_id': '77467551-f6fe-4706-bd98-a4546e60edd7', 'quantite': '1 kg'}, {'ingredient_id': '9d1a47da-0440-4c09-8936-1496c5bc7c09', 'quantite': '5'}, {'ingredient_id': '408cd4cc-8cb4-4e54-9a02-246be6c08389', 'quantite': ''}, {'ingredient_id': '6e53cf22-9895-41a1-814a-96001cd5bf16', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37130, 'Tarte fraises kiwis à ma façon', 'pâte brisée, oeuf, lait concentré non sucré, crème fraîche allégée, sucre, fraises', '30 min', ['Préparer la pâte brisée (150 g de farine, 75 g de beurre mou, 1 peu d''eau).', 'Faire cuire à blanc 15 min à 200°C (thermostat 6-7).', 'Pendant ce temps préparer l''appareil:', 'Battre les oeufs, ajouter le lait concentré non sucré, la crème fraiche et le sucre, bien mélanger.', 'Verser sur la pâte, et remettre au four, 30 min à 200°C (thermostat 6-7).', 'Surveiller la cuisson de la tarte, il faut que l''appareil soit ferme.', 'Sortir du four, et répartir dessus les fraises et les kiwis, coupées en rondelles.', 'Vous aver le choix de la déco!!', 'Laisser bien refroidir avant de déguster.'], ['Spatule', 'Couteau de chef', 'Ouvre-boîte'], ['crème fraîche allégée', 'recettes de cuisine', 'plat', 'Tarte fraises kiwis à ma façon', 'cocktail', 'sucre', 'lait concentré non sucré', 'plat de résistance', 'tarte aux fraises', 'bon marché', 'oeuf', 'pâte brisée', 'recette', 'fraises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:21:24.039255', [{'ingredient_id': '4c650d53-e8c0-47c1-9ae5-614f86672c53', 'quantite': '1'}, {'ingredient_id': '394a9681-5c58-4317-8ceb-ce0f554842e0', 'quantite': '2'}, {'ingredient_id': 'e8b13ebe-1870-4ac3-a451-51b3d13baef7', 'quantite': '12.5 cl'}, {'ingredient_id': '4e9328c4-2537-47d3-b0f4-0924d15aa2b8', 'quantite': '10 cl'}, {'ingredient_id': 'b30e6953-76e9-485e-a7d1-85aa7b81cfd4', 'quantite': '5 cuillères'}, {'ingredient_id': 'cd9f8aa8-df93-4fc7-98bc-3e3d2592458a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11457, 'Tarte aux pommes à l''Alsacienne', 'pomme, pâte brisée, oeuf, crème fraîche, sucre en poudre, sucre vanillé', '25 min', ['Pelez et coupez les pommes en fines tranches', 'Dans un saladier, mélangez le sucre, les oeufs, le sucre vanillé', 'la crème fraîche', 'Etalez la pâte dans un moule à tarte et piquez le fond à l''aide d''une fourchette. Disposez les pommes sur la pâte et versez le tout sur les pommes (ou versez uniquement la crème) ', 'Puis disposer les lamelles de pommes roulées sur elles-même en roses.', 'Enfournez environ 30 minutes, jusqu''à ce que la tarte prenne une belle couleur dorée.', 'Déguster'], ['Économe', 'Verre doseur', 'Moule à tarte', 'Râpe', 'Presse-agrumes'], ['sucre vanillé', 'recettes de cuisine', 'plat', 'cocktail', 'crème fraîche', 'plat de résistance', 'bon marché', 'oeuf', 'pâte brisée', 'recette', 'Tarte aux pommes à l''Alsacienne', 'sucre en poudre', 'tarte aux pommes', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme'], 'Dessert', c72b2d5f-dfc2-4e13-a4cc-21d998495422, '2025-09-26T15:21:30.686281', [{'ingredient_id': '606b2bc1-9b2f-4afd-b1c3-8e1d4370fe6e', 'quantite': '3'}, {'ingredient_id': '06ff39ea-dff4-43e4-bb7e-9d7b21d0a2bd', 'quantite': '1'}, {'ingredient_id': 'fe6c0eef-6c91-429d-948b-96809762cc07', 'quantite': '2'}, {'ingredient_id': 'a7e916c2-de85-4611-911f-07a084c1c144', 'quantite': '25 cl'}, {'ingredient_id': 'd1a9a81a-ccb9-4865-ba07-cbbea582ce4a', 'quantite': '100 g'}, {'ingredient_id': '6ecfb78d-73b7-4c5f-875f-516d689147ca', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70807, 'Sorbet fraise-banane', 'fraises, banane, citron, sucre', '30 min', ['Lavez et équeutez les fraises, coupez les en 4.', 'Epluchez les bananes et coupez-les en rondelles.', 'Mixez le tout puis ajoutez le jus de citron et le sucre, mélangez bien. Mettez le tout dans la sorbetière et mettez au congélateur.', 'Si vous n''avez pas de sorbetière, mettez la préparation dans un bac que vous placez dans le congélateur. Les 3 premières heures, remuez la préparation tous les quarts d''heure pour éviter la formation de paillettes. ', 'Dégustez après quelques heures au congélateur, lorsque la préparation est consistante.'], ['Pince de cuisine', 'Couteau de chef', 'Économe', 'Balance de cuisine', 'Verre doseur'], ['recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'citron', 'banane', 'bon marché', 'rapide', 'recette', 'Sorbet fraise-banane', 'fraises', 'cuisine', 'sorbet', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:21:34.129394', [{'ingredient_id': '7b5afbb2-6ba8-44da-81bf-909b0ffa4d29', 'quantite': '250 g'}, {'ingredient_id': '5dcc6afa-27d5-47b5-9c0c-cc1f228becb9', 'quantite': '3'}, {'ingredient_id': 'db417344-3461-4854-8db5-7679fc3eb6ca', 'quantite': ''}, {'ingredient_id': '4299d0c0-b29c-4e75-97a2-749d33f50a12', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (39470, 'Muffins aux framboises', 'framboises, farine, beurre, sucre en poudre, sucre vanillé, oeuf, levure chimique, Liqueur', '30 min', ['Beurrer les moules à cannelés avec 15 g de beurre ramolli et mettre les moules dans le frigo. ', 'Préchauffer le four Th 7 (210°C ) . ', 'Mélanger dans un saladier la farine et la levure chimique. ', 'Dans un autre saladier, écraser le beurre restant avec une fourchette, ajouter le sucre en poudre et le sucre vanillé, bien mélanger, puis ajouter les oeufs, fouetter pour obtenir une préparation bien mousseuse. Ajouter une cuillère à café de liqueur de fruits rouges. ', 'Incorporer le 1er mélange farine-levure à la préparation liquide afin d''obtenir une pâte lisse. ', 'Ajouter les framboises et mélanger délicatement. Répartir la pâte dans les moules à cannelés. (16 moules remplis à moitié). ', 'Mettre au four Th 7 pendant 15 mn et 5 mn Th 6 . ', 'Démouler les gâteaux.'], ['Ouvre-boîte', 'Poêle', 'Planche à découper'], ['sucre vanillé', 'recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'plat de résistance', 'Liqueur', 'bon marché', 'oeuf', 'muffin', 'framboises', 'recette', 'sucre en poudre', 'cuisine', 'Muffins aux framboises', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'farine'], 'Dessert', 0f39b9b2-a472-4dcc-b15d-441a71c4602c, '2025-09-26T15:21:40.973645', [{'ingredient_id': '85ef244a-b6d7-4449-a7f5-f9715f31dd61', 'quantite': '150 g'}, {'ingredient_id': '58b02bb3-ed5f-4fee-b411-d5c756d5945f', 'quantite': '150 g'}, {'ingredient_id': '472b400c-9328-44f3-917c-0ac7978ec1b0', 'quantite': '100 g'}, {'ingredient_id': 'cad346a1-5217-40f1-8522-225ed4cc2cbd', 'quantite': '80 g'}, {'ingredient_id': '4ab2dbd0-80e0-498b-8c10-48d7d90d5785', 'quantite': '2'}, {'ingredient_id': 'b451ba41-258d-4d8d-b1a1-c8c9740c49f9', 'quantite': '2'}, {'ingredient_id': 'd4147cfc-0a94-4a66-8abd-95a173d914c8', 'quantite': ''}, {'ingredient_id': '5d815ada-8b54-4dcc-b74a-fef3a69aaadf', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12925, 'Tarte aux pommes à la cannelle', 'pâte brisée, pomme, oeuf, lait, sucre, cannelle, sucre vanillé', '45 min', ['Disposez la pâte dans un moule à tarte. Pelez et découpez les pommes en tranche. Recouvrez le fond de tarte des pommes en lamelle, puis parsemez d''un peu de cannelle en poudre.', 'Dans un bol, mélangez les oeufs, le sucre et le sucre vanillé puis incorporez le lait et un peu de cannelle (selon votre goût). Cela doit être de consistance assez liquide.', 'Versez sur les pommes et mettez au four 20-30mn selon la puissance du four à th 8.'], ['Ouvre-boîte', 'Moule à tarte', 'Poêle', 'Râpe'], ['cannelle', 'sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'bon marché', 'oeuf', 'Tarte aux pommes à la cannelle', 'pâte brisée', 'recette', 'tarte aux pommes', 'cuisine', 'lait', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme'], 'Dessert', d9f05b22-0522-4e8f-903e-9045f5789261, '2025-09-26T15:21:46.601677', [{'ingredient_id': '022aa9a5-9f1c-4901-8901-fc6546921f19', 'quantite': '1'}, {'ingredient_id': 'db7874d0-7ad3-4fd3-b286-d2f333569ec0', 'quantite': '3'}, {'ingredient_id': '11c092de-b632-4351-8931-c63c480d9dc3', 'quantite': '2'}, {'ingredient_id': 'e8484e1b-a5da-4c31-9020-6b17e89e61a8', 'quantite': '30 cl'}, {'ingredient_id': '99428b73-8fa7-4f4f-bcd3-c7a991526906', 'quantite': '50 g'}, {'ingredient_id': '7bebecbb-bb1c-4a74-ade2-594acee372b7', 'quantite': ''}, {'ingredient_id': '9c577bf1-d0ce-4989-82b1-6e67c2ab454e', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57195, 'Verrine banane fraise', 'banane, fraises, spéculoos, crème chantilly', '10 min', ['Coupez les fraises en morceaux et les bananes en rondelles.', 'Ecrasez la moitié du paquet de speculoos dans un torchon de façon à en faire une poudre.', 'Alternez bananes, fraises et speculoos dans les verres, couvrez et placez au frigo pendant 1h30 (environ le temps d''un repas).', 'Au moment du dessert sortez les verrines et recouvrir de crème chantilly.'], ['Couteau de chef', 'Batteur électrique'], ['', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'banane', 'bon marché', 'Verrine banane fraise', 'recette', 'crème chantilly', 'fraises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'spéculoos'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:21:50.080935', [{'ingredient_id': '86f8f767-6a7f-4908-ad9c-608f7526a4f5', 'quantite': '4'}, {'ingredient_id': '5b1db00e-0868-4bcf-9fb6-4257a3e662ec', 'quantite': '500 g'}, {'ingredient_id': '25f38c7c-5948-47fb-8bc4-4973cbbef95f', 'quantite': '1'}, {'ingredient_id': 'bd24d8ed-9ca0-471e-a1cd-d8d6a110f0c2', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (71085, 'Tiramisu vert et rose : pistaches et fraises', 'macaron, mascarpone, sucre, oeuf, pâte de pistache, fraises, lait, macaron, pistaches, coulis de framboise', '15 min', ['Il est possible de préparer ce tiramisu en format individuel (dans des verres, coupelles ou verrines) ou dans un plat commun. Si vous le pouvez, privilégiez un récipient transparent afin de pouvoir profiter des couleurs de ce dessert.', '- Séparez les blancs des jaunes.', '- Mélangez les jaunes et le sucre (jusqu''à obtenir un mélange qui blanchit légèrement) puis ajoutez le mascarpone au fouet. La quantité de sucre peut varier si vous êtes plus ou moins bec sucré, si vous utilisez du coulis de fruit rouge (diminuer le sucre) ou des macarons « tout fait » (diminuer aussi). Pas d’inquiétude même avec 100 g c’est très bon !', '- Séparez la préparation en deux parties égales (si comme moi vous n’avez pas le compas dans l’œil, n’hésitez pas à vous servir d’une balance).', '- Ajoutez à l''une des moitiés la pâte pistache : étendre la pâte à pistache avec un peu de crème fraîche ou avec quelques cuillères du mélange avant d''ajouter tout le mélange pour que ce soit plus facile à mélanger. N’hésitez pas à adapter la quantité de pâte à pistache selon que vous voulez renforcer le goût ou la couleur car cela dépend beaucoup du type de pâte à pistache dont vous disposez.', '- Eventuellement ajoutez quelques cuillères à café de coulis dans la seconde moitié.', '- Montez les blancs en neige et incorporez-les délicatement à la spatule dans chacun des deux mélanges précédents. Attention à bien répartir aussi la moitié des blancs d’œufs dans chaque préparation. N’hésitez pas à vous servir de votre balance.', '- Emiettez le macaron à la framboise et tapissez le fond de 8 verres ou un plat unique de votre choix.', '- Ajoutez une cuillère à café de liquide (lait + amande amère ou eau + sirop) sur les miettes de macaron (1 ou 2 cuillères à café par verres/personnes).', '- Déposez les fraises (ou framboises entières) coupées en 2 ou 4 sur les bords du récipient (ou des verres) si celui-ci est transparent. Si ce n’est pas le cas, vous pouvez tout simplement déposer les morceaux de fraises (ou framboises) dans la crème.', '- Répartissez la préparation blanche (ou rose si utilisation de coulis): comptez 3 ou 4 cuillères à soupe par verre. Si vous utilisez un plat unique, pensez bien à faire une couche la plus uniforme possible.', '- Emiettez le macaron à la pistache et répartissez-le dans votre plat (ou vos verres). Eventuellement ajoutez quelques pistaches entières.', '- Ajoutez la préparation verte (procédez de la même façon qu’avec le mélange précédent).', '- Décorez avec des coques de macarons (la moitié d''un macaron) et quelques pistaches.', '- Réfrigérez 6 à 24 h. Il est possible de congeler ce dessert (laisser décongeler au réfrigérateur).'], ['Rouleau à pâtisserie', 'Râpe'], ['recettes de cuisine', 'plat', 'cocktail', 'sucre', 'pâte de pistache', 'pistaches', 'plat de résistance', 'macaron', 'oeuf', 'tiramisu', 'rapide', 'moyen', 'recette', 'fraises', 'cuisine', 'lait', 'coulis de framboise', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'mascarpone', 'confiserie', 'Tiramisu vert et rose : pistaches et fraises'], 'Dessert', a3533120-19b3-49b0-b29d-c76f2f602d39, '2025-09-26T15:21:53.998598', [{'ingredient_id': 'f818127d-8fb7-4666-9bcb-6375d1f86473', 'quantite': '2'}, {'ingredient_id': '68e68364-8d55-497e-ab15-27b699f09a34', 'quantite': '250 g'}, {'ingredient_id': 'fd061c03-330a-45a5-b9ca-82068fa2110e', 'quantite': '50 g'}, {'ingredient_id': 'ebc78710-90d2-4240-a047-61f27e21fa59', 'quantite': '3'}, {'ingredient_id': 'b30577a7-ccf8-4a40-ac96-c19b3acc79ee', 'quantite': '2 cuillères'}, {'ingredient_id': '05ec4c6b-2ddb-418e-8818-e71c4ac8abf7', 'quantite': '200 g'}, {'ingredient_id': 'eab11bda-5d92-4374-9278-332b48188237', 'quantite': ''}, {'ingredient_id': '08ff73e9-10db-477f-b861-ee88bcedc157', 'quantite': ''}, {'ingredient_id': 'fbc2b762-3146-4687-9fb0-ba3f9fe73e9c', 'quantite': ''}, {'ingredient_id': '3e66ae10-2327-4ec8-bf21-4670cdc5ac93', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (91089, 'Clafoutis aux framboises', 'framboises, maïzena, sucre, sucre vanillé, oeuf, jaune d''oeuf, lait, crème fraîche, beurre, sel', '10 min', ['Bien beurrer le moule et y répartir les framboises.', 'Mélanger la maïzena avec les sucres et le sel. ', 'Ajouter les oeufs entiers et les jaunes. Bien mélanger. ', 'Enfin, ajouter le lait et la crème.', 'Verser la préparation sur les framboises et mettre au four 30 minutes à 180°C (thermostat 6).'], ['Moule à tarte', 'Spatule'], ['sucre vanillé', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'crème fraîche', 'plat de résistance', 'Clafoutis aux framboises', 'bon marché', 'jaune d''oeuf', 'oeuf', 'maïzena', 'framboises', 'clafoutis', 'sel', 'recette', 'cuisine', 'lait', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie'], 'Dessert', 5ca90f3a-bf6f-4c28-b9ba-16fa3c5447eb, '2025-09-26T15:21:58.676104', [{'ingredient_id': '0029a2fb-3efb-42f8-8ede-f08567c9bd70', 'quantite': '400 g'}, {'ingredient_id': '208f469a-352e-4ab7-b594-48bf0312d045', 'quantite': '60 g'}, {'ingredient_id': '3fcfd0cc-e7da-40a6-9c04-91ffb32be8d3', 'quantite': '125 g'}, {'ingredient_id': '9cebc60f-4d4c-41dd-be04-c9215ea57cfe', 'quantite': '1'}, {'ingredient_id': '00ba3a24-fc39-4e57-900a-1fa390ae7305', 'quantite': '2'}, {'ingredient_id': '89c83c61-f04b-464d-b0ff-c7726a665561', 'quantite': '2'}, {'ingredient_id': 'caa572df-d2ff-4634-aa30-893c39165363', 'quantite': '25 cl'}, {'ingredient_id': 'e4e5a253-3b1e-484a-985a-ded9e9c50991', 'quantite': '200 g'}, {'ingredient_id': '3e7cfcff-6c59-465e-a31d-fdd5142af7b7', 'quantite': ''}, {'ingredient_id': '744e73f8-48fb-49ca-bc32-751477fa825e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46230, 'Glace minute bananes - framboises', 'banane, framboises, sucre vanillé', '5 min', ['Couper les bananes en rondelles, les mettre dans un sachet congélation, rajouter les framboises et le sucre vanillé.', 'Fermer le sachet de congélation et laisser prendre au congélateur le temps nécessaire.', 'Une fois tout les fruits congelés, les mettre dans un mixer.', 'Laisser tourner un moment, jusqu''à l''obtention d''un oncteuse crème glacé...', 'Vous pouvez dégustez!!!'], ['Spatule', 'Moule à tarte', 'Casserole', 'Rouleau à pâtisserie', 'Mixeur'], ['sucre vanillé', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'glace à l''italienne', 'Glace minute bananes - framboises', 'banane', 'bon marché', 'framboises', 'rapide', 'recette', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:22:02.420977', [{'ingredient_id': 'eff8a212-6a57-4fd4-bee6-a29403d25e26', 'quantite': '4'}, {'ingredient_id': '8cb5550b-73e2-435b-9fd3-ab936b7c5f93', 'quantite': '1'}, {'ingredient_id': 'cb31539e-19e3-4715-8848-e4671633785e', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36549, 'Crumble mangue et fraise', 'mangue, fraises, beurre, amandes en poudre, farine, cassonade, sucre vanillé', '20 min', ['Faites une pâte sableuse avec le beurre, la farine, la cassonade et la poudre d''amande.', 'Epluchez la mangue, lavez et équeutez les fraises, puis placez-les dans un plat et parsemez le dessus de sucre vanillé (vous pouvez également prendre une gousse de vanille, la couper en deux et mettre les grains).', 'Emiettez la pate sur les fruits de manière à bien les recouvrir.', 'Faites cuire 30 min au four préchauffé à thermostat 6 (180°C): le crumble est prêt lorsque la pâte est dorée.'], ['Tire-bouchon', 'Casserole', 'Verre doseur', 'Mixeur', 'Balance de cuisine'], ['sucre vanillé', 'cassonade', 'recettes de cuisine', 'plat', 'cocktail', 'Crumble mangue et fraise', 'plat de résistance', 'bon marché', 'recette', 'mangue', 'fraises', 'cuisine', 'testées', 'autres crumbles', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'amandes en poudre', 'farine'], 'Dessert', ad1a2e5d-ed97-4085-8866-2260761e8ec0, '2025-09-26T15:22:07.289500', [{'ingredient_id': '0fcb9a44-b092-4880-b40c-63454fccffc5', 'quantite': '1'}, {'ingredient_id': 'fa32f134-5524-4f14-9ebb-ccde26166c03', 'quantite': '250 g'}, {'ingredient_id': 'c9d08fd8-31b5-43a9-848b-2acae68464e1', 'quantite': '100 g'}, {'ingredient_id': '4b789422-31aa-44c4-b4c5-d779f89e8e8a', 'quantite': '50 g'}, {'ingredient_id': '42d3de60-eaff-4c77-b3c5-6db46385e6ca', 'quantite': '100 g'}, {'ingredient_id': '7ccc2d35-9030-46c1-8b5c-2a04a3027871', 'quantite': '50 g'}, {'ingredient_id': '29b35758-a583-436f-a6a7-cfe4daec043e', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37214, 'Crème glacée aux fraises rapide', 'fraises, sucre, crème fraîche', '15 min', ['Lavez les fraises. Égouttez-les. Équeutez-les.', 'Passez-les au mixer et ajoutez le sucre.', 'Mixez à nouveau.', 'Incorporez à ce mélange la crème fraîche et mixez à nouveau cette préparation qui doit être bien homogène.', 'Versez ensuite dans un moule et laissez au freezer 4 h.'], ['Mixeur', 'Balance de cuisine', 'Ouvre-boîte', 'Louche'], ['', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'crème fraîche', 'plat de résistance', 'bon marché', 'rapide', 'recette', 'fraises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'Crème glacée aux fraises rapide', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:22:10.749570', [{'ingredient_id': '0d9cb008-07b7-438a-b0a0-b4b1870e1a1f', 'quantite': '500 g'}, {'ingredient_id': 'ae6cdb55-0728-4b5a-8292-f54c6f2b7865', 'quantite': '250 g'}, {'ingredient_id': 'e7ebd3df-0bab-4bc3-95a2-1c7bd0819484', 'quantite': '250 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29642, 'Glace aux fraises', 'fraises, crème fleurette, sucre, blanc d''oeuf, citron', '30 min', ['Battre le blanc d''oeuf en neige. Peu avant la fin ajouter une cuillérée à soupe de sucre. Réserver au frais.', 'Battre la crème fleurette jusqu''à ce qu''elle épaississe. Réserver au frais.', 'Mixer les fraises, le jus de citron et le reste de sucre au blender.', 'Passer éventuellement pour ôter les petits grains.', 'Mélanger délicatement le tout et mettre en sorbetière.'], ['Tire-bouchon', 'Planche à découper', 'Rouleau à pâtisserie', 'Balance de cuisine', 'Économe'], ['recettes de cuisine', 'plat', 'cocktail', 'sucre', 'glace à l''italienne', 'plat de résistance', 'citron', 'bon marché', 'rapide', 'recette', 'fraises', 'crème fleurette', 'cuisine', 'Glace aux fraises', 'blanc d''oeuf', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:22:15.474063', [{'ingredient_id': 'c5096ec5-89eb-4d0d-a09d-07649c390a71', 'quantite': '600 g'}, {'ingredient_id': '25e0aba1-b49d-4ac8-956a-abe1a000ecb5', 'quantite': '100 g'}, {'ingredient_id': 'b0ba8a00-7617-4572-9668-6f8b621cd545', 'quantite': '150 g'}, {'ingredient_id': 'a3afd301-35c9-430c-8db0-31bc6595a83d', 'quantite': '1'}, {'ingredient_id': 'ed99b568-62f6-4755-bf37-9da811375f49', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (59544, 'Verres de tapioca aux fraises mixées', 'lait, sucre semoule, sucre vanillé, tapioca, fraises, fruits rouges', '15 min', ['Porter à ébullition le lait avec 3 cuillères à soupe de sucre et le sucre vanillé.', 'Verser le tapioca et cuire à petits bouillons pendant 10 minutes en remuant régulièrement.', 'Retirer du feu et laisser épaissir en refroidissant.', 'Donner un tour de cuillère de temps à autre pour qu''aucune peau ne se forme sur le dessus.', 'Mixer les fraises avec le reste de sucre. Répartir le tapioca tiédi et épaissi dans 4 à 6 verres.', 'Au-dessus, disposer une couche de fraises mixées.', 'Mettre un film alimentaire sur chaque verre et entreposer au frigo au moins 4 heures.', 'Avant de servir, décorer avec des fruits rouges.'], ['Tire-bouchon', 'Moule à tarte', 'Économe', 'Rouleau à pâtisserie', 'Passoire'], ['', 'sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'rapide', 'recette', 'fraises', 'cuisine', 'Verres de tapioca aux fraises mixées', 'lait', 'tapioca', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'fruits rouges', 'confiserie', 'sucre semoule'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:22:18.970374', [{'ingredient_id': 'fb691d11-8772-4254-884f-3acc517ca4ee', 'quantite': '50 cl'}, {'ingredient_id': '403e776f-81fc-4cdb-af82-b3b15e11576b', 'quantite': '6 cuillères'}, {'ingredient_id': '99b7404f-384b-400c-b0ad-9e908ba73921', 'quantite': '1'}, {'ingredient_id': '4094f2b6-1180-4bd3-ba94-954484d81afa', 'quantite': '4 cuillères'}, {'ingredient_id': '0534f493-082c-4f73-ad46-a0c78f0faa51', 'quantite': '500 g'}, {'ingredient_id': '1dfca0be-de57-49fa-9183-7079aec49080', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14464, 'Soupe de fraises', 'fraises, pineau des charentes, menthe, basilic, poivre, muscade, vanille, sucre en poudre', '20 min', ['Ciseler les feuilles de menthe et de basilic, puis les mélanger dans une casserole avec tous les ingrédients (sauf les fraises).', 'Faire chauffer en remuant pour dissoudre le sucre.', 'Lorsque le mélange bout, arrêter le feu et le laisser refroidir dans la casserole.', 'Pendant ce temps, préparer les fraises (les laver, puis les équeuter et les couper en quatre), puis les placer dans le sirop froid.', 'Mettre au réfrigérateur pendant 3 h.', 'Servir dans une assiette à soupe, en prenant soin de sortir la gousse de vanille.', 'Accompagner d''un biscuit éventail ou d''une cigarette russe en décoration.'], ['Râpe', 'Planche à découper', 'Économe', 'Couteau de chef', 'Louche'], ['', 'recettes de cuisine', 'plat', 'cocktail', 'vanille', 'menthe', 'plat de résistance', 'bon marché', 'rapide', 'recette', 'sucre en poudre', 'fraises', 'cuisine', 'pineau des charentes', 'poivre', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'basilic', 'recettes', 'confiserie', 'Soupe de fraises', 'muscade'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:22:23.536789', [{'ingredient_id': 'dbda97ad-8e1a-4f84-9dd2-eafd504a75ad', 'quantite': '700 g'}, {'ingredient_id': '15e4e1ea-82f8-449e-95c5-038353a73d87', 'quantite': '20 cl'}, {'ingredient_id': '31bfb2d0-5154-4f09-96db-2d5b74278371', 'quantite': '10'}, {'ingredient_id': '8384a754-9092-4c5d-8044-1cc87594c43e', 'quantite': '10'}, {'ingredient_id': 'd187ae76-d876-4137-b3a6-9987640d92ae', 'quantite': '5'}, {'ingredient_id': 'db8d9a1b-a03a-41c8-95a9-a13bab2f9fe6', 'quantite': '1'}, {'ingredient_id': '120cddf6-a941-4cd6-a7b4-cd060897fd33', 'quantite': ''}, {'ingredient_id': '073f2193-10d7-4b9d-87c6-5b0c51bec271', 'quantite': '10 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11582, 'Muffins aux pommes', 'farine, sucre en poudre, levure, sel, beurre, lait, pomme, oeuf, noix, noisettes', '15 min', ['Verser dans une jatte farine, sucre, levure et sel. Pétrir du bout des doigts pour bien mêler beurre et farine et obtenir un mélange semblable à des miettes de pain.', 'Peler et évider les pommes, les couper en petits morceaux. ', 'Dans un bol, battre ensemble oeuf et lait. Verser sur le mélange de farine, incorporer pommes et fruits secs. Bien pétrir.', 'Déposer des petits monticules de pâte sur une plaque beurrée, puis cuire au four 15 à 20 min à 200°C (thermostat 6/7).'], ['Poêle', 'Tire-bouchon', 'Moule à tarte', 'Râpe'], ['noix', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'oeuf', 'muffin', 'sel', 'levure', 'recette', 'sucre en poudre', 'cuisine', 'lait', 'Muffins aux pommes', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'noisettes', 'confiserie', 'pomme', 'farine'], 'Dessert', ce666d54-eccb-4828-9b66-017eb5d54177, '2025-09-26T15:22:30.220718', [{'ingredient_id': '3f05efb0-3140-4ecb-a29c-6554d2eae662', 'quantite': '175 g'}, {'ingredient_id': '7db0deda-074e-48b7-9611-578adc10f571', 'quantite': '100 g'}, {'ingredient_id': 'fcbbc140-b7e7-4bcf-8514-5e01bbae8bac', 'quantite': '1.5'}, {'ingredient_id': 'bd415d63-1bf7-4f23-bd43-835f087a353d', 'quantite': '1'}, {'ingredient_id': '015e272f-3693-45c0-ab5e-cf720bdd7eb8', 'quantite': '50 g'}, {'ingredient_id': 'a355d1fa-5b46-4cb7-99f3-d556babe499a', 'quantite': '10 cl'}, {'ingredient_id': 'f8654062-75b1-4371-9fd9-71f15aac0cae', 'quantite': '2'}, {'ingredient_id': '8e1cfd06-5c73-449c-9a2f-5a6eea614589', 'quantite': '2'}, {'ingredient_id': '5fddac14-a374-4947-8f17-1266f454c2e9', 'quantite': '80 g'}, {'ingredient_id': '9c4c499f-0604-43e0-a6e4-ee0b45f91541', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34317, 'terrine de chocolat aux framboises', 'framboises, citron, chocolat noir, beurre tendre, lait, sucre, jaune d''oeuf, cacao', '35 min', ['Faire bouillir 10 cl d''eau avec 100 g de sucre et le jus de citron. Après 5 min de cuisson, plonger le framboises et laisser cuire 5 min à feu doux et retirer du feu. Réservez. ', 'Faites bouillir le lait. A part mélangez vivement les jaunes avec les 50 g de sucre restant. Dés que la préparation blanchit incorporez le cacao et peu à peu le lait. Faite cuire cette crème à feu SANS LA FAIRE BOUILLIR. Arrêtez dés qu''elle accroche à la cuillère. ', 'Faire fondre au bain-marie le chocolat en morceaux puis ajouter le beurre. Retirer du feu et remuer. Attendre 10 min puis incorporer ce mélange à la crème au cacao. ', 'Prendre un moule à cake ; garnissez-le de film étirable alimentaire. Puis étaler une couche de chocolat puis une couche de framboises égouttées. Et terminer par une couche de chocolat. ', 'Garder au frais toute une nuit. ', 'Servir le lendemain avec du sucre glace et décorer de quelques framboises et quelques brins de menthe.'], ['Presse-agrumes', 'Mixeur'], ['', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'assez cher', 'citron', 'terrine de chocolat aux framboises', 'jaune d''oeuf', 'framboises', 'beurre tendre', 'cacao', 'recette', 'cuisine', 'lait', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'chocolat noir'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:22:33.827746', [{'ingredient_id': 'db73a136-6b4f-4416-b7e3-739dd95b55a3', 'quantite': '250 g'}, {'ingredient_id': '26aad395-8c76-48ab-ad2a-04bb2fc9c1d6', 'quantite': ''}, {'ingredient_id': 'f2beca6d-d812-486c-872c-97c73025b9ce', 'quantite': '225 g'}, {'ingredient_id': '08fe06ca-83ad-4b5b-87ea-51fdc1cbf30f', 'quantite': '125 g'}, {'ingredient_id': '91bb4a7b-8d2e-4594-bb0b-a4529ec1fd5d', 'quantite': '25 cl'}, {'ingredient_id': '9752037f-0e1e-4e3c-a5dc-a3ef10cdc075', 'quantite': '150 g'}, {'ingredient_id': 'b2eed87b-28f1-48e9-bd2b-aa52c215f386', 'quantite': '3'}, {'ingredient_id': '93d3ca04-9e1d-4916-a43e-3bbc59c51aa2', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12825, 'Véritable moelleux au chocolat', 'farine, beurre doux, sucre semoule, chocolat noir, oeuf, levure', '10 min', ['Préchauffer le four à 180°C (thermostat 6).

Faire fondre le chocolat dans une casserole.', 'Hors du feu, ajouter le beurre, ', 'la farine et la levure.', 'Fouetter les jaunes d’oeuf avec le sucre', 'et un peu d''eau pour faire mousser', 'puis l''ajouter à la préparation chocolatée.', 'Battre les blancs en neige et les incorporer dans la casserole tout doucement.', 'Verser le tout dans un moule beurré à bords hauts', 'et enfourner pendant environ 35 minutes.', 'On peut ajouter du sucre glace ou du chocolat fondu, pour décorer le dessus du gâteau.', 'Déguster'], ['Râpe', 'Planche à découper', 'Louche', 'Spatule', 'Mixeur'], ['recettes de cuisine', 'plat', 'cocktail', 'gâteau au chocolat', 'plat de résistance', 'bon marché', 'oeuf', 'levure', 'recette', 'beurre doux', 'cuisine', 'testées', 'très facile', 'Véritable moelleux au chocolat', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'sucre semoule', 'farine', 'chocolat noir'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:22:40.562186', [{'ingredient_id': '0fcec9a7-d699-47a4-8fcc-3496ba7b46b0', 'quantite': '125 g'}, {'ingredient_id': 'ae985ad9-6548-4635-aadb-03d2d72da511', 'quantite': '125 g'}, {'ingredient_id': '4a3b017d-dc99-4962-acb5-eda96f9d2853', 'quantite': '250 g'}, {'ingredient_id': '8921e0b6-d2c4-4701-938e-3e0ab44361e8', 'quantite': '200 g'}, {'ingredient_id': '83d94d3c-cccb-42df-8e98-62f6978537bd', 'quantite': '4'}, {'ingredient_id': 'b774e3c1-c83e-47f5-9c5d-76558e8e4cf3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20303, 'Bûche chocolat-framboises', 'oeuf, sucre, farine, cacao, chocolat noir, crème liquide, framboises, beurre, eau, sucre, vanille', '30 min', ['* Génoise : ', 'Préchauffer le four à 250°C. Dans un bol, mélanger les oeufs et le sucre. Faire tiédir au bain-marie à 40°C environ. Battre le mélange énergiquement au batteur électrique pendant 5 min, puis plus lentement jusqu''à refroidissement (dans une casserole d''eau froide). Incorporer délicatement à la spatule, la farine et la poudre de cacao tamisées ensemble. ', 'Sur une plaque recouverte d''une feuille de papier sulfurisé, étaler la génoise sur une épaisseur régulière. Mettre la plaque au four en baissant le thermostat à 200°C . Laisser cuire 6 min. A la sortie du four, laisser refroidir sur un torchon. ', '* Ganache : ', 'Faire bouillir ensemble la crème et les framboises. Verser le tout sur le chocolat noir et fouetter jusqu''à la fonte complète du chocolat. Ajouter le beurre et mélanger. Laisser refroidir. ', '* Sirop : ', 'Mettre l''eau, le sucre et la gousse de vanille fendue en 2 dans une casserole et faire bouillir. ', '* Montage de la bûche : ', 'Déposer la génoise côté croûte sur le plan de travail. Enlever le papier. Imbiber la génoise avec le sirop refroidi. Etaler les 2/3 de la ganache sur la génoise. Rouler la bûche et réserver au frais pendant 30 mn. Couvrir le roulé avec le reste de la ganache et tracer des stries à la fourchette. Servir frais.'], ['Mixeur', 'Presse-agrumes', 'Fouet'], ['moyenne', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'Bûche chocolat-framboises', 'bûche au chocolat', 'bon marché', 'oeuf', 'cacao', 'rapide', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'farine'], 'Dessert', 19edef01-c891-428e-81b6-b1005f3f8e73, '2025-09-26T15:22:46.627278', [{'ingredient_id': '2c5583c7-ad8d-40fd-8a68-2204436b19c4', 'quantite': '4'}, {'ingredient_id': '809bbdfa-13d2-4dab-9aee-7ad78eeff2e4', 'quantite': '125 g'}, {'ingredient_id': '910b8406-702b-4e73-8f93-41f5a67466e8', 'quantite': '115 g'}, {'ingredient_id': '145123a8-fbd3-4efc-9ff2-2b760b7988a3', 'quantite': '15 g'}, {'ingredient_id': '73f1a4ac-8a43-4ecb-b1ab-0d6228ec6852', 'quantite': '300 g'}, {'ingredient_id': '3a5918d7-e542-41fd-b1bc-7280f4493194', 'quantite': '150 g'}, {'ingredient_id': 'e7c35966-9ceb-435e-8bee-f3f510405289', 'quantite': '150 g'}, {'ingredient_id': '7e0d9690-fe41-4d73-8ef9-1985b65b1e96', 'quantite': '50 g'}, {'ingredient_id': '809cac05-e18c-4179-8ab3-cd16e49586f4', 'quantite': '10 cl'}, {'ingredient_id': 'e1da1f7f-1e35-4511-9ac3-c2e03dc1fff7', 'quantite': '100 g'}, {'ingredient_id': 'aa0b4aa8-80cb-4ec5-bbee-0a5f9d0f37bf', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (80171, 'Smoothie banane-fraise', 'banane, fraises, fromage blanc', '5 min', ['Mettre tous les ingrédients dans le bol d''un mixer et en avant pour 3 min, le temps de réveiller les enfants!', 'Verser dans de joli mugs et servir avec une paille. Les ados adorent au petit déj!', 'On peut ajouter des cornflakes.'], ['Économe', 'Balance de cuisine', 'Mixeur', 'Verre doseur'], ['', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'fromage blanc', 'banane', 'bon marché', 'rapide', 'Smoothie banane-fraise', 'recette', 'fraises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:22:50.112052', [{'ingredient_id': '50180b37-c01b-4191-9478-696b0b90fdc8', 'quantite': '2'}, {'ingredient_id': '40272b85-a40d-413b-bbea-ba2f00efa79f', 'quantite': '15 cl'}, {'ingredient_id': 'b257902c-e4cd-4fcb-86cc-d67426494ffd', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (220452, 'Macarons framboise Mamitou', 'blanc d''oeuf, sucre semoule, amandes en poudre, sucre glace, colorant alimentaire, coulis de framboise, sucre en poudre, beurre', '40 min', ['Pour les coques :', 'Battre les blancs d''oeufs à vitesse moyenne. Quand la mousse fait des vagues, ajouter 45 g de sucre semoule. Continuer à battre à vitesse moyenne. Lorsque au retrait du mixeur, les blancs forment un bec d''oiseau à base large au bout du batteur, incorporer le reste du sucre et le colorant alimentaire. Puis battre les blancs à vitesse maximum jusqu’à obtention d''une base lisse, brillante et homogène.', 'Ajouter ensuite le mélange poudre d''amande - sucre glace, lentement en ramenant les bords à la spatule, lentement. Former un mélange homogène, puis tester la préparation : lorsque vous lever la spatule, un ruban doit se former. Si ce n''est pas le cas, écraser la préparation avec la spatule par le milieu, re-tester et recommencer si nécessaire.', 'Préchauffer votre four à 150°C (thermostat 5). Chaleur tournante préférable.', 'Mettre la préparation dans une poche à douille et former la coque du macaron : environ 2 cm de diamètre. Les espacer sur du papier sulfurisé ou sur une plaque en silicone. ', 'Enfourner 12 min. Laisser refroidir quelques minutes avant de les retirer de la plaque. ', 'Vous avez fini les coques ! Ouf !', 'La garniture :', 'Mélanger les ingrédients dans une casserole a feu fort, porter à ébullition en remuant sans arrêt pendant 3 min. Sortir du feu, continuer a mélanger. Quand le mélange épaissit, appliquer 1/2 cuillère à café sur la coque du bas, puis placer la coque du haut par dessus. ', 'Laisser reposer les macarons, les conserver au réfrigérateur.'], ['Ouvre-boîte', 'Tire-bouchon', 'Batteur électrique', 'Râpe'], ['moyenne', 'colorant alimentaire', 'recettes de cuisine', 'plat', 'macarons', 'cocktail', 'plat de résistance', 'Macarons framboise Mamitou', 'bon marché', 'rapide', 'recette', 'cuisine', 'blanc d''oeuf', 'testées', 'sucre glace', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'amandes en poudre', 'sucre semoule'], 'Confiserie', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:22:57.127581', [{'ingredient_id': '2731dc02-dfa2-4765-b72b-0903a9e954a4', 'quantite': '75 g'}, {'ingredient_id': 'd2950639-b06e-40c7-a877-46c7626a0cdb', 'quantite': '90 g'}, {'ingredient_id': '9f6a2f5e-ad9e-4c7b-a67e-49c8e7646310', 'quantite': '80 g'}, {'ingredient_id': '218734e2-d71d-4cad-9b5b-6e0b848473f4', 'quantite': '80 g'}, {'ingredient_id': '3fe8a0eb-f490-4d99-b426-878845a97ef5', 'quantite': '15'}, {'ingredient_id': '4059a023-b6c5-4314-90ae-fbedc139ec4e', 'quantite': '70 g'}, {'ingredient_id': '53c1cac5-450d-4817-bddc-5a79f6af16fc', 'quantite': '40 g'}, {'ingredient_id': 'ff04cd7f-4686-41c7-9c9b-d74f14f9cd20', 'quantite': '30 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29787, 'Sorbet à la fraise facile', 'fraises, sucre en poudre, citron', '45 min', ['Laver les fraises, les équeuter, puis les couper en morceaux.', 'Les passer au mixeur avec le sucre en poudre. Ajouter le jus de citron et continuer à mixer', 'Mettre la préparation dans la sorbetière jusqu''à ce que le mélange prenne (pendant 30 minutes environ).', 'Placer la glace (dans une boîte adaptée) et la mettre au congélateur pendant 3/4 heures minimum avant de la déguster.'], ['Couteau de chef', 'Planche à découper', 'Passoire', 'Rouleau à pâtisserie'], ['recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'citron', 'bon marché', 'rapide', 'recette', 'sucre en poudre', 'fraises', 'cuisine', 'sorbet', 'testées', 'Sorbet à la fraise facile', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:23:00.856786', [{'ingredient_id': 'b7ce558d-656c-45c8-93a0-c294a4931269', 'quantite': '600 g'}, {'ingredient_id': '0a52a535-3e41-4fd5-a0da-f786e6622def', 'quantite': '300 g'}, {'ingredient_id': 'ec174c19-2cf3-44c4-bc2a-9bdb77392b42', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55029, 'Verrines aux pommes et caramel', 'pomme, palets bretons, crème fraîche, mascarpone, sucre', '30 min', ['Eplucher et tailler les pommes en quartiers, puis les faire compoter dans 2 cuillères à soupe de sucre, à couvert, avec un tout petit peu d''eau.', 'Faire cuire jusqu''à ce que les pommes soient fondantes.', 'Monter en chantilly : 25 cl de crème fraîche + 2 cuillères à soupe de mascarpone.', 'Caramel (ne pas hésiter à doubler le tout): feu vif 100 g de sucre + 2 cuillères soupe d''eau.', 'Quand le caramel est brun, ajouter hors du feu 50 g de beurre, remuer, puis 2 cuillères à soupe de mascarpone.', 'Dans 4 verrines, émietter les palets bretons.', 'Ajouter une couche de la compote de pommes, puis une couche de caramel.', 'Coiffer le tout de la crème chantilly mascarpone.', 'Mettre au frigo pendant au moins 3 ou 4 h, ou mieux, la nuit.'], ['Pince de cuisine', 'Passoire', 'Balance de cuisine'], ['palets bretons', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'Verrines aux pommes et caramel', 'crème fraîche', 'caramel', 'plat de résistance', 'bon marché', 'rapide', 'recette', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'mascarpone', 'confiserie', 'pomme'], 'Dessert', 5e895ea8-f1a4-4f6f-b572-dfd2843d4290, '2025-09-26T15:23:07.431663', [{'ingredient_id': '157d299e-940e-4e26-8088-08d4a350ef5d', 'quantite': '4'}, {'ingredient_id': '956843a3-6d0d-447e-9630-bfcc935604e7', 'quantite': '6'}, {'ingredient_id': '1398b367-fa3a-4884-a317-c8e0c40a784e', 'quantite': '25 cl'}, {'ingredient_id': 'e6200afe-8756-4e4b-91c8-d2d682350b9f', 'quantite': '4 cuillères'}, {'ingredient_id': '79a4cf7a-5835-4d7b-99f5-9c7800975851', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18726, 'Gâteau aux pommes 5, 4, 3, 2, 1', 'farine, sucre, lait, huile, oeuf, sel, levure, pomme, beurre, sucre, oeuf, vanille', '25 min', ['Gâteau: ', 'Mélanger la farine, le sucre, la levure et le sel. ', 'Ajouter ensuite le lait, l''oeuf et l''huile. ', 'Travailler au fouet ou batteur, puis verser dans un moule. ', 'Couvrez de minces tranches de pommes. ', 'Enfournez à four chaud ( 180°C) pendant 25 min. ', 'Crème: ', 'Faire fondre le beurre tout doucement, ajouter le sucre et l''oeuf. ', 'Au bout de 25 min, quand la gâteau commence à lever et dorer, arroser le de la crème et terminer la cuisson pendant 15 min.'], ['Spatule', 'Pince de cuisine', 'Couteau de chef'], ['gâteau aux pommes', 'recettes de cuisine', 'plat', 'cocktail', 'Gâteau aux pommes 5', 'sucre', 'plat de résistance', '2', 'bon marché', 'oeuf', '3', '4', 'sel', 'levure', 'recette', 'cuisine', 'lait', 'testées', '1', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme', 'huile', 'farine'], 'Dessert', 49b298ed-7720-4e83-a0e8-4fb6307e8e7d, '2025-09-26T15:23:14.155528', [{'ingredient_id': 'ff37d945-b481-478c-8a6a-3ede26a382aa', 'quantite': '5 cuillères'}, {'ingredient_id': 'efbf02c0-43e6-470c-a5a4-4ae69fbdb098', 'quantite': '4 cuillères'}, {'ingredient_id': 'b5a23e5c-3979-4362-ac7e-f6a542eab9f4', 'quantite': '3 cuillères'}, {'ingredient_id': '12dd4a70-5118-4113-8d0f-d6140564117e', 'quantite': '2 cuillères'}, {'ingredient_id': '369b0c52-7e1a-401a-a685-abc7b52726e6', 'quantite': '1'}, {'ingredient_id': '076f8f15-d2a1-470e-853b-fe8cde01a602', 'quantite': ''}, {'ingredient_id': '8f4c6e10-1340-4384-a20a-53d948a0da0c', 'quantite': ''}, {'ingredient_id': '1c217bb7-b614-4b4b-92d0-a762df5140a6', 'quantite': '2'}, {'ingredient_id': '0bac96ba-e328-4d7b-818e-103014ccb583', 'quantite': '80 g'}, {'ingredient_id': '3359403c-7fea-4774-af58-e07bc4e4b042', 'quantite': '100 g'}, {'ingredient_id': '892480bb-4bd1-4259-9c59-02658ba2473e', 'quantite': '1'}, {'ingredient_id': '921769f2-a0b8-44c9-ba9c-31537071e9a3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20996, 'Glace à la fraise (vanille)', 'lait, vanille, jaune d''oeuf, fraises, sucre', '60 min', ['Dans une casserole, porter le lait et la vanille à ébullition.', 'Battre les jaunes d''oeufs et 50 g de sucre jusqu''à l’obtention d’une mousse homogène. ', 'Incorporer le lait à la mousse et faire épaissir l’ensemble à feu doux sans porter à ébullition. ', 'Laisser refroidir.', 'Mixer les fraises et 150 g de sucre. ', 'Incorporer délicatement à la précédente préparation et faire glacer en sorbetière.'], ['Mixeur', 'Casserole', 'Presse-agrumes'], ['recettes de cuisine', 'plat', 'cocktail', 'vanille', 'sucre', 'glace à l''italienne', 'plat de résistance', 'bon marché', 'jaune d''oeuf', 'Glace à la fraise (vanille)', 'recette', 'fraises', 'cuisine', 'lait', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', 897f5cc8-6bdb-4f0a-ab9b-6b37f0ad5b7a, '2025-09-26T15:23:20.155278', [{'ingredient_id': 'ac3c0b15-2d15-4aae-a091-ae07f62682d6', 'quantite': '30 cl'}, {'ingredient_id': '0c960c88-b557-487a-ba1d-768e5f809929', 'quantite': ''}, {'ingredient_id': 'fad69be7-ab1a-4301-8532-58fdfacb25fb', 'quantite': '2'}, {'ingredient_id': '5d97e76f-8c10-43a4-a44f-333455ad5aec', 'quantite': '300 g'}, {'ingredient_id': '1e122e6f-1c04-4463-8e65-e2f92c9d1318', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (168555, 'Charlotte aux framboises et à la chantilly', 'biscuits à la cuillère, framboises, sucre en poudre, crème liquide, petit suisse, sucre vanillé', '30 min', ['1- Faîtes décongeler les framboises au micro-onde ou, si vous avez le temps, le faire la veille.', '2- Récupérez le jus des framboises et le mettre dans une casserole (mettre les framboises au réfrigirateur pour quelles refroidissent si vous les avez fait décongeler au micro-onde).', '3- Ajoutez 50 gr de sucre au jus et faîtes bouillir à feu doux environ 5 min. Ensuite, attendre que ce sirop refroidisse.', '4- Montez en chantilly la crème liquide (préalablement conservée au réfrigirateur pour quelle soit très froide).', '5- Ajoutez le reste de sucre en poudre et le sucre vanillé à la chantilly. Bien mélanger.', '6- Ensuite, rajoutez les petits suisse à la chantilly et mélangez.', '7- Il ne reste plus qu''à mélanger cette préparation avec vos framboises.', '8- Enfin, faîtes tremper vite fait les biscuits cuillères dans le sirop refroidi et tapissez le moule à charlotte avec.', '9- Et maintenant, remplissez avec la crème à la framboise. Recouvrez de biscuits cuillères.', '10- Mettre tout ça au réfrigirateur pendant une nuit. Démoulez au moment de servir.'], ['Planche à découper', 'Couteau de chef'], ['', 'sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'Charlotte aux framboises et à la chantilly', 'biscuits à la cuillère', 'bon marché', 'framboises', 'rapide', 'recette', 'sucre en poudre', 'crème liquide', 'cuisine', 'testées', 'entrée', 'dessert', 'petit suisse', 'boisson', 'recettes', 'confiserie'], 'Dessert', d9dad38d-64bb-4230-87bb-02af1854ce38, '2025-09-26T15:23:23.748231', [{'ingredient_id': 'b76e8265-52be-4b1e-b0c0-4b779c4b5078', 'quantite': '36'}, {'ingredient_id': '72b02d54-01b8-42f2-8166-0bb92beb492e', 'quantite': '200 g'}, {'ingredient_id': 'e973e57f-3b23-4799-b6c1-be72cdbe677e', 'quantite': '80 g'}, {'ingredient_id': '96c31e7e-e317-4fdb-8b9b-6733c10bd36c', 'quantite': '25 cl'}, {'ingredient_id': '20f78cb0-b73a-463d-9222-8086fe71183f', 'quantite': '4'}, {'ingredient_id': 'fd37192e-7751-4521-9798-5186dc42b617', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23391, 'Milk-shake léger aux framboises', 'lait, framboises, menthe, sucre en poudre', '5 min', ['Mettre dans un blender un verre de brisures de framboises pour trois verres de lait environ. Rajouter quelques feuilles de menthe et du sucre à doser selon votre goût. ', 'Activer le blender quelques secondes. ', 'Vous obtenez un délicieux milk-shake glacé (les framboises sont surgelées) et léger puisqu''il ne contient pas de glace. Idéal pour l''été...'], ['Batteur électrique', 'Couteau de chef', 'Rouleau à pâtisserie'], ['', 'recettes de cuisine', 'plat', 'cocktail', 'menthe', 'plat de résistance', 'bon marché', 'framboises', 'rapide', 'recette', 'sucre en poudre', 'cuisine', 'lait', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'Milk-shake léger aux framboises'], 'Boisson', 91c31319-114c-4a73-b4ef-9afd8438dea8, '2025-09-26T15:23:27.270789', [{'ingredient_id': '8af65362-a99f-4382-8375-a52f4dfbd5fa', 'quantite': '20 cl'}, {'ingredient_id': 'f1de22a8-ec82-40d7-a66e-fb43a481ee5e', 'quantite': ''}, {'ingredient_id': 'f3832c55-8132-4fad-aa17-7b86418e16cc', 'quantite': '4'}, {'ingredient_id': '240ffa9c-0353-4a39-a98f-4d67fe680d0b', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30578, 'Framboise sous mousse de mascarpone', 'framboises, mascarpone, oeuf, sucre en poudre, sucre vanillé, sucre glace, sirop', '20 min', ['Versez dans un bol les framboises et le sirop de rose. Couvrez de film alimentaire et glissez au réfrigérateur.', 'Cassez les œufs en séparant les blancs des jaunes. Dans un saladier, mélangez les jaunes d''oeufs avec la mascarpone, le sucre et le sucre vanillé et réservez au frais. ', 'Montez les blancs en neige très ferme et ajoutez le sucre glace sans cesser de fouetter. Incorporez le mélange de mascarpone. Couvrir d''un film alimentaire et la placer au réfrigérateur. ', 'Au moment de servir, répartissez les framboises dans des verres, puis recouvrez-les d''une belle couche de mousse. Décorez avec une framboise et des pétales de rose frais ou confits. ', 'On peut également réaliser cette recette avec des fraises ou un mélange de fruits rouges.'], ['Pince de cuisine', 'Balance de cuisine', 'Râpe', 'Tire-bouchon', 'Mixeur'], ['sucre vanillé', 'recettes de cuisine', 'plat', 'cocktail', 'mousse fruits', 'plat de résistance', 'bon marché', 'oeuf', 'framboises', 'rapide', 'recette', 'sucre en poudre', 'cuisine', 'sirop', 'testées', 'sucre glace', 'très facile', 'entrée', 'dessert', 'Framboise sous mousse de mascarpone', 'boisson', 'recettes', 'mascarpone', 'confiserie'], 'Dessert', a543947f-cc12-4390-8985-6db4a30d799a, '2025-09-26T15:23:32.982849', [{'ingredient_id': 'f186f71b-3923-4ecd-a56a-7d2ced5f804b', 'quantite': '250 g'}, {'ingredient_id': '20135a2d-d64d-4697-bfbf-c6b81d045f13', 'quantite': '200 g'}, {'ingredient_id': '8723b640-bd81-41fd-afc9-d967ab6e0221', 'quantite': '2'}, {'ingredient_id': '5b54e89f-9176-4fa7-9e4b-4a3149fe7cc2', 'quantite': '50 g'}, {'ingredient_id': '0afb3e8c-d580-472d-8cd1-83ee15e1be7e', 'quantite': '1'}, {'ingredient_id': 'b8fc30b3-a891-4bf8-bd33-08e02ffc7421', 'quantite': '1 cuillères'}, {'ingredient_id': 'b3017ad2-254a-4ba9-be24-dfe931a5b69d', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14039, 'Tiramisu aux fraises', 'fraises, citron, oeuf, mascarpone, sucre, biscuits à la cuillère', '20 min', ['Préparer 2 h à l''avance.
Placer les biscuits dans un plat. Laver, équeuter et couper les fraises en quartiers, puis les mettre dans un plat.', 'Arroser les fraises du jus de citron et de 30 g de sucre. Ecraser les fraises à l''aide d''une fourchette. Mettre sur les biscuits cette préparation  en quantité suffisante afin de bien les imbiber. Mettre au frigo.', 'Pendant ce temps, séparer les jaunes et les blancs des oeufs. Battre les jaunes avec 120 g de sucre jusqu''à blanchissement du mélange. Ajouter le mascarpone et mélanger.', 'Monter les blancs en neige, y ajouter les 30 g de sucre. Incorporer délicatement les blancs en neige au mélangez jaune-sucre-mascarpone. Verser la préparation sur les biscuits imbibés. ', 'Verser le restant du ''coulis'' par dessus. Mettre au frais.'], ['Économe', 'Casserole', 'Passoire'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'citron', 'biscuits à la cuillère', 'bon marché', 'oeuf', 'tiramisu', 'Tiramisu aux fraises', 'rapide', 'recette', 'fraises', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'mascarpone', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:23:39.686804', [{'ingredient_id': 'c0cb512f-5419-4789-9949-887a7a83fe69', 'quantite': '500 g'}, {'ingredient_id': 'd14e76d3-9d6f-4668-ae6f-326e0bfd709a', 'quantite': '1'}, {'ingredient_id': '525fd356-5fab-443e-8e03-2f3bfd868b6c', 'quantite': '4'}, {'ingredient_id': '5aa5de1d-db84-4798-b597-711b2eb8499b', 'quantite': '250 g'}, {'ingredient_id': '4c3cbf08-ce1f-49de-9d49-757f4be8cce8', 'quantite': '180 g'}, {'ingredient_id': '0ae177fa-2b27-4512-a089-ed973f1a8652', 'quantite': '12'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17382, 'Dés de melon au coulis de fraises', 'melon, sucre en poudre, vin, cardamome, fraises, citron, menthe', '20 min', ['Ouvrir les melons horizontalement. Les débarrasser de leurs fibres et graines. Prélever toute la chair et la couper en boules à l''aide d''une cuillère parisienne. ', 'Réserver les coques au réfrigérateur.', 'Mettre la chair dans un saladier, avec la moitié du sucre enpoudre, le vin blanc moelleux et les petites graines noires contenues dans les capsules de cardamome. Mélanger et couvrir de film alimentaire. Faire macérer 2 heures au frais.', 'Pendant ce temps, préparer le coulis de fraises : laver et équeuter les fraises. Les passer au mixeur avec le reste de sucre et le jus du cemi-citron, pour les réduire en coulis.', 'Tamiser à l''aide d''une passoire en fin treillis et recueillir le coulis dans un bol. Réserver au frais.', 'Répartir les boules de melon et leur jus dans les coques de melon. Napper avec le coulis de fraises et décorer de quelques feuilles de menthe fraîche.', 'Servir bien frais.'], ['Ouvre-boîte', 'Fouet'], ['facile', 'coulis de fruits rouges', 'melon', 'recettes de cuisine', 'plat', 'cocktail', 'menthe', 'plat de résistance', 'citron', 'Dés de melon au coulis de fraises', 'rapide', 'moyen', 'recette', 'sucre en poudre', 'fraises', 'cuisine', 'vin', 'cardamome', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', 7144ac18-d61f-4649-9a19-c9ea11149fa4, '2025-09-26T15:23:43.263672', [{'ingredient_id': 'c782a0d9-cdff-488b-8bf6-af4aee3d6818', 'quantite': '2'}, {'ingredient_id': '29091cab-01c5-4bda-b323-66cc09e879e5', 'quantite': '100 g'}, {'ingredient_id': '623f1670-4633-4bf6-96f8-e3e73a4527ec', 'quantite': '20 cl'}, {'ingredient_id': '349ec49e-7da5-4bb9-922e-d086d4c4a81c', 'quantite': '2'}, {'ingredient_id': 'c05dc1b0-f703-4f3b-b7d9-2fe27e0d0d88', 'quantite': '250 g'}, {'ingredient_id': '2686a648-45e1-4476-87a3-a0428ef57201', 'quantite': ''}, {'ingredient_id': 'f37ec3b3-8101-49c4-9dc0-823cd31fe40f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (227680, 'Dôme chocolat blanc framboise', 'palets bretons, framboises, crème, chocolat blanc, lait, sucre, maïzena, jaune d''oeuf, gélatine', '20 min', ['Mettre la feuille de gélatine à tremper dans l''eau froide.', 'Faire fondre le chocolat au bain-marie.', 'Mélanger le jaune d''oeuf, le sucre et la Maïzena.', 'Pour faire la crème pâtissière : faire frémir le lait, et incorporer le mélange : jaune-sucre-Maïzena. Faire cuire le tout 2 minutes. Le mélange obtenu doit être épais.', 'Verser la crème pâtissière sur le chocolat blanc et ajouter la gélatine égoutée. Laisser refroidir à température ambiante.', 'Monter la crème en chantilly. L''incorporer à la crème pâtissière.', 'Répartir la mousse dans un moule à dôme en silicone, placer 3 framboises au milieu de chaque dôme, bien lisser le tout.', 'Placer le moule 1 heure ou plus au congélateur. Ce sera plus facile à démouler sur le sablé breton.', 'Pour finir... Accompagner ce dessert d''un coulis de framboise'], ['Moule à tarte', 'Couteau de chef', 'Verre doseur', 'Presse-agrumes'], ['', 'palets bretons', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'gélatine', 'sucre', 'plat de résistance', 'chocolat blanc', 'bon marché', 'jaune d''oeuf', 'maïzena', 'Dôme chocolat blanc framboise', 'framboises', 'rapide', 'recette', 'cuisine', 'lait', 'crème', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:23:46.748853', [{'ingredient_id': '225610d8-ec6f-4c69-b26a-b90050a3b677', 'quantite': '6'}, {'ingredient_id': '73d368b7-8052-4d76-ba13-876c01c3ed35', 'quantite': '18'}, {'ingredient_id': '9e8f7af3-211b-42a9-a211-34eba0a34b08', 'quantite': '250 g'}, {'ingredient_id': '79322887-dcf7-4241-85b1-3a6db100314b', 'quantite': '100 g'}, {'ingredient_id': '86bc5935-a239-4f3f-963a-46891d0aa53f', 'quantite': '50 g'}, {'ingredient_id': '6f0b7cc8-df2e-4911-a351-033f86c0b1dc', 'quantite': '10 g'}, {'ingredient_id': '9358ad80-9832-43d2-bb5b-c6f61aa6669c', 'quantite': '10 g'}, {'ingredient_id': '693234d1-f1a0-4ea3-851c-9f7ac4d74d2a', 'quantite': '1'}, {'ingredient_id': 'fd864c0c-c70c-47e7-a358-6be1c6d419c8', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15227, 'Tarte aux pommes, miel et amandes', 'pâte feuilletée, pomme, beurre, miel, sucre, amandes effilées', '40 min', ['Préchauffer le four à 210°C.', 'Granir un moule à tarte avec la pâte feuilletée.', 'Couper les pommes en lamelles moyennes et les disposer sur la pâte.', 'Mettre au four une vingtaine de minutes.', 'Dans une casserole, faire fondre le beurre à feu doux. Ajouter le miel, le sucre et les amandes.', 'Napper le dessus de la tarte avec l''appareil encore chaud, et remettre au four quelques minutes pour faire dorer le tout.'], ['Presse-agrumes', 'Ouvre-boîte', 'Économe', 'Tire-bouchon'], ['recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'bon marché', 'miel', 'recette', 'tarte aux pommes', 'cuisine', 'amandes effilées', 'testées', 'très facile', 'entrée', 'dessert', 'pâte feuilletée', 'Tarte aux pommes', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'miel et amandes'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:23:53.385261', [{'ingredient_id': '7852003e-98aa-4143-9fdc-a706d2bc904c', 'quantite': '250 g'}, {'ingredient_id': '9059d9d2-7f7b-41fe-a186-3d4614f1e804', 'quantite': '6'}, {'ingredient_id': '14372ee1-cb6f-4a54-9d49-9f69296384cc', 'quantite': '70 g'}, {'ingredient_id': 'edd6a31f-ff8c-4167-a20e-e698f807857c', 'quantite': '2 cuillères'}, {'ingredient_id': '5aeff929-30c9-4c55-9a30-caed50d7ea4e', 'quantite': '100 g'}, {'ingredient_id': 'a92220e1-7f03-4c8f-a9f2-23c85e18b01c', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (47959, 'Verres de tiramisu fraises/rhubarbe', 'rhubarbe, fraises, mascarpone, crème fraîche épaisse, sucre, oeuf, biscuits à la cuillère, kirsch', '40 min', ['Couper les fraises en petits morceaux et les faire dégorger avec 100 g de sucre (pendant environ 30 min à 1 h).', 'Si les fraises ne sont pas assez sucrées, ajouter encore du sucre pendant que celles-ci dégorgent.', 'Pendant ce temps, préparer la compote de rhubarbe.', 'Eplucher les rhubarbes, les couper en cubes, ajouter 50 cl d''eau et 100 g de sucre.', 'Faire cuire à feu doux jusqu''à ce que la rhubarbe soit bien ramollie.', 'Récupérer le jus de la rhubarbe et laisser refroidir.', 'Pendant ce temps, mixer la rhubarbe pour obtenir une compote. ', 'Récupérer également le jus des fraises et réserver.', 'Faire un coulis fraise/rhubarbe :', 'Prendre environ 200 g de fraises avec 5 cuillères à soupe de compote de rhubarbe, mixer le tout et réserver.', 'Ecraser la moitié des biscuits à la cuillère et mélanger en ajoutant doucement le jus de rhubarbe et 1 à 2 cuillères à café de Kirsch (il faut que les biscuits soient humides mais surtout pas liquides).', 'Mettre environ 2/3 cuillères à café de biscuits au fond de chaque verre, puis ajouter environ 2 à 3 cuillères à café de compote de rhubarbe.', 'Dans un saladier, mélanger 100 g de sucre, 6  jaunes d''œufs, ajouter le mascarpone et la crème fouettée.', 'Battre les blancs en neige et les incorporer délicatement à cette préparation.', 'Ajouter ensuite 2 à 3 cuillères de cette préparation dans chaque verre.  ', 'Ecraser l’autre moitié des biscuits à la cuillère et mélanger en ajoutant doucement le jus des fraises et 1 à 2 cuillères à café de Kirsch (il faut que les biscuits soient humides mais surtout pas liquides)', 'Mettre environ 2/3 cuillères à café de biscuits dans chaque verre, puis ajouter 2/3 cuillères à café de fraises en morceaux puis recouvrir avec le reste de crème fouetté.', 'Verser ensuite le coulis fraise/rhubarbe pour recouvrir le haut des verres.', 'Laisser reposer une nuit au réfrigérateur.'], ['Casserole', 'Poêle'], ['moyenne', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'kirsch', 'biscuits à la cuillère', 'oeuf', 'rhubarbe', 'tiramisu', 'rapide', 'moyen', 'recette', 'crème fraîche épaisse', 'fraises', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'mascarpone', 'Verres de tiramisu fraises/rhubarbe', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:23:56.979666', [{'ingredient_id': '9b8a7e2e-35ce-4b23-ac17-db1b3cc56b3e', 'quantite': '1 kg'}, {'ingredient_id': '321b1f51-e3bc-45bb-b0e2-a2536dec2a7b', 'quantite': '1 kg'}, {'ingredient_id': '2d20fc32-a288-403b-9fee-e9a3f1460bd7', 'quantite': '500 g'}, {'ingredient_id': '98c38338-825e-41b9-89f3-4c2ebb45cf93', 'quantite': '500 g'}, {'ingredient_id': '99472fed-76fb-4ed2-aaf7-8c5d605e82ed', 'quantite': '300 g'}, {'ingredient_id': 'c598b83c-1a48-4a58-964f-70ef2e980ed9', 'quantite': '6'}, {'ingredient_id': '8f940b00-6ff9-4d3e-b5dd-e7c2dbe9816d', 'quantite': '80'}, {'ingredient_id': 'd1aa2728-fadf-43e4-8f36-3bb53495e401', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (167995, 'Tarte aux fraises légère', 'farine, beurre salé, cassonade, jaune d''oeuf, lait, rhum, eau, sucre, lait, farine, sucre vanillé, jaune d''oeuf, confiture de fruits rouges, eau', '20 min', ['Verser dans un récipient la farine, le beurre (préalablement ramolli), le sucre, le jaune d’œuf, le lait et le rhum. Mélanger au fur et à mesure. La pâte se présente sous une apparence sableuse. Malaxer le tout en ajoutant de l’eau afin d’obtenir une boule homogène. ', 'Laisser reposer. ', 'Étalez la pâte au rouleau. Ajouter de la farine si la pâte est collante. Puis piquer la pour ne pas qu’elle gonfle.', 'Faire cuire environ 15 minutes à 180°C (thermostat 6)', 'Laisser refroidir.', 'Pendant ce temps, verser dans un saladier le sucre, le lait, la farine et les jaunes d’œufs. Bien mélanger jusqu’à obtenir une consistance homogène.', 'Faire cuire à puissance maximale 2.30 minutes au micro onde. Mélanger et passer à nouveau 2.30 minutes au micro onde. Vous obtenez une crème compacte.', 'Laisser refroidir. ', 'Laver et découper les fraises en deux.', 'Étaler la crème pâtissière sur la pâte sablée. Déposer les fraises.', 'Faire fondre la confiture à feu doux avec un peu d’eau. Laisser refroidir puis rajouter le sirop sur la tarte.'], ['Passoire', 'Ouvre-boîte', 'Rouleau à pâtisserie', 'Spatule'], ['facile', 'cassonade', 'recettes de cuisine', 'plat', 'cocktail', 'beurre salé', 'eau', 'plat de résistance', 'tarte aux fraises', 'bon marché', 'jaune d''oeuf', 'rhum', 'recette', 'cuisine', 'lait', 'Tarte aux fraises légère', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:24:00.544646', [{'ingredient_id': '750311c6-e403-46ff-9b6c-98433a5a6961', 'quantite': '200 g'}, {'ingredient_id': '93d7e7e9-e3a3-4b3b-8bb1-78671963e91a', 'quantite': '60 g'}, {'ingredient_id': '546a5f8d-cc83-44e9-94ce-edc36ca14f2c', 'quantite': '50 g'}, {'ingredient_id': '14824a33-5171-4482-bc3b-b5584dc53c59', 'quantite': '1'}, {'ingredient_id': '2ad02e20-7f88-4496-9aa1-b94338bb83b6', 'quantite': '1 cuillères'}, {'ingredient_id': '78d6e6d8-609e-4eac-88bb-40bed6e0e48d', 'quantite': '1'}, {'ingredient_id': 'f7e80067-d65b-4a8a-88b6-98d476bf7ac0', 'quantite': ''}, {'ingredient_id': 'da30620f-c313-4315-9775-412835176f2f', 'quantite': '50 g'}, {'ingredient_id': '6cc5f033-cf89-4495-a8f0-bf3c37995023', 'quantite': '25 cl'}, {'ingredient_id': '58275c37-af02-4b68-911d-874d4b1cbd36', 'quantite': '25 g'}, {'ingredient_id': '536af041-4182-45bc-96f2-c661aca62bc7', 'quantite': '1'}, {'ingredient_id': '41088c61-7f33-44e7-ae65-96134dac886b', 'quantite': '2'}, {'ingredient_id': '2cbefb9d-3c58-4c65-9593-0c32d6b46714', 'quantite': '100 g'}, {'ingredient_id': 'a9b73222-b492-49e6-b905-f7f9709681fe', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32601, 'Clafoutis aux framboises ultra-simple', 'framboises, oeuf, sucre en poudre, farine, crème fraîche', '5 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Mélanger les oeufs (entiers + jaunes) avec le sucre, de manière à ce que le mélange blanchisse un peu. ', 'Ajouter ensuite la farine, puis la crème.', 'Répartir les framboises dans un plat allant au four, puis recouvrir de la préparation.', 'Placer au four pendant 45 min (mais vérifier la cuisson dès 30 min, chaque four est différent !).', 'Servir tiède ou froid.'], ['Louche', 'Verre doseur', 'Râpe'], ['recettes de cuisine', 'plat', 'cocktail', 'crème fraîche', 'plat de résistance', 'bon marché', 'oeuf', 'framboises', 'clafoutis', 'recette', 'sucre en poudre', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'farine', 'Clafoutis aux framboises ultra-simple'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:24:05.233951', [{'ingredient_id': '15586848-ba8d-4b14-abcf-b8884e9715d9', 'quantite': '500 g'}, {'ingredient_id': '9c2c296b-9cc4-4c1d-86a0-aab93855f628', 'quantite': '3'}, {'ingredient_id': 'aa27a674-047a-45d8-85fe-a630fad49d68', 'quantite': '200 g'}, {'ingredient_id': '198dd0c4-9e6a-4c08-ae54-f8d4f3228158', 'quantite': '80 g'}, {'ingredient_id': '4cd16aea-59da-4538-865d-1f83ace57a68', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40753, 'Tarte aux framboises à la mousse de chocolat blanc', 'pâte brisée, crème, chocolat blanc, framboises', '30 min', ['Faire fondre le chocolat blanc au micro-ondes (règler le micro-ondes au plus bas), ou au bain-marie.', 'Monter la crème entière en chantilly à l''aide d''un batteur électrique ou d''un fouet, à condition que la crème soit très froide!', 'Incorporer le chocolat à la chantilly, et réserver le tout au frigo.', 'Faire cuire la pâte à blanc, et laisser refroidir.', 'Verser la mousse au chocolat blanc sur le fond de tarte, et déposer les framboises sur la mousse.', 'Déguster très frais.'], ['Économe', 'Moule à tarte', 'Râpe', 'Batteur électrique'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'Tarte aux framboises à la mousse de chocolat blanc', 'plat de résistance', 'chocolat blanc', 'framboises', 'pâte brisée', 'moyen', 'recette', 'cuisine', 'crème', 'tarte au chocolat', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', dcb268ee-c052-4b8b-b564-1d34242fd88a, '2025-09-26T15:24:08.712391', [{'ingredient_id': 'a1e1712d-ea20-4a58-97d6-66fee21bcd19', 'quantite': '1'}, {'ingredient_id': '429eb955-d38c-4a6d-b790-828bbfcd1fdc', 'quantite': '20 cl'}, {'ingredient_id': 'fcb72fb9-404c-4487-98a2-05fb571d02eb', 'quantite': '100 g'}, {'ingredient_id': 'fba21705-695d-46fd-8b15-fba0307e9d53', 'quantite': '300 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (527901, 'Cheesecake aux fraises et citron vert (sans cuisson)', 'palets bretons, pistaches, beurre, fromage blanc, Philadelphia, sucre, zeste de citron, jus de citron, fraises, gélatine en feuilles', '30 min', ['Commencez cette recette en faisant fondre le beurre. Réduisez les pistaches et les palets breton en poudre et mélangez le tout avec le beurre fondu.', 'Beurrez les bords d’un moule à charnières et tapissez-le de papier sulfurisé. Tassez la pâte dans le moule et réservez au réfrigérateur.', 'Faites ramollir la gélatine 10 minutes dans l’eau froide. Dans un saladier, fouettez le fromage blanc avec le Philadelphia, le sucre, le jus, et les zestes de citron vert. Faites fondre la gélatine essorée au micro-ondes, puis incorporez-la à la préparation précédente.', 'Sortez le moule du réfrigérateur. Versez y le mélange au fromage et placez le moule au frais pendant 4 heures.', 'Coupez les fraises en morceaux', 'Démoulez et disposez les fraises sur le dessus.'], ['Verre doseur', 'Poêle', 'Batteur électrique'], ['palets bretons', 'cheesecake', 'recettes de cuisine', 'plat', 'Cheesecake aux fraises et citron vert (sans cuisson)', 'cocktail', 'pistaches', 'plat de résistance', 'bon marché', 'rapide', 'recette', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie'], 'Dessert', 4478561c-1abd-4d67-bda7-40fe26cd0a30, '2025-09-26T15:24:12.042324', [{'ingredient_id': 'f823f5f2-3956-4f5e-b3c6-76ee4f82f89d', 'quantite': '150 g'}, {'ingredient_id': '9b7b9341-ca26-4321-a3ab-182293fa6445', 'quantite': '40 g'}, {'ingredient_id': '5d0e28bd-2045-46af-9204-6d8ca0221611', 'quantite': '50 g'}, {'ingredient_id': 'd9c9494b-c520-43d5-91ee-835ec29bd69d', 'quantite': '400 g'}, {'ingredient_id': '3ebff5ba-3652-4e10-a927-9766eec31e35', 'quantite': '200 g'}, {'ingredient_id': '1db5e1b8-804a-48fd-a785-e3bf29dc304c', 'quantite': '80 g'}, {'ingredient_id': 'a334595b-2cb1-446d-b710-a3eb5980143c', 'quantite': '1 cuillères'}, {'ingredient_id': '6c1add90-59a9-4db3-aebf-6f6b64dba0f9', 'quantite': '1 cuillères'}, {'ingredient_id': 'ac7a0025-dfd8-4e13-98c2-cafd15fdc882', 'quantite': '300 g'}, {'ingredient_id': '819b5daa-e28b-47e5-9b8c-c6ae0651d85b', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (326082, 'Moelleux chocolat aux framboises', 'framboises, chocolat noir, oeuf, beurre tendre, sucre en poudre, sucre vanillé, farine', '20 min', ['Beurrez un moule à manqué de 18 cm. ', 'Préchauffez le four à 180°C (thermostat 6). ', 'Hachez le chocolat et le faire fondre au bain Marie. ', 'Fouettez le beurre et le sucre. Y incorporer les oeufs l''un après l''autre sans cesser de fouetter. Ajoutez le chocolat et la farine tamisée. ', 'Versez la moitié de cette pâte dans le moule. ', 'Posez dessus la moitié des framboises. Recouvrez avec le reste de pâte. ', 'Enfournez 30 min, démoulez et laissez refroidir.', 'Réalisez un coulis avec l''autre moitié des framboises et le sucre vanillé. ', 'Servez le gâteau décoré de quelques framboises et accompagné du coulis.'], ['Casserole', 'Couteau de chef'], ['sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'Moelleux chocolat aux framboises', 'gâteau au chocolat', 'plat de résistance', 'bon marché', 'oeuf', 'framboises', 'beurre tendre', 'recette', 'sucre en poudre', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'farine', 'chocolat noir'], 'Dessert', 5366fe7f-8b68-44c3-a501-a7ae0a812fb5, '2025-09-26T15:24:15.343959', [{'ingredient_id': '3b9b32a3-d211-4653-9f71-7663376e3c3a', 'quantite': '250 g'}, {'ingredient_id': '865073ce-30bc-47ca-aa88-cd233cb29b02', 'quantite': '125 g'}, {'ingredient_id': 'c2921a3f-b535-482c-b3ae-0655dcae046b', 'quantite': '2'}, {'ingredient_id': '9402ff25-430e-4fa3-a55c-a2fdeb02bb2c', 'quantite': '125 g'}, {'ingredient_id': '172d9065-839f-4564-80e7-b2873231c963', 'quantite': '100 g'}, {'ingredient_id': 'e46bf219-83d9-4337-acaa-544f9dfd6d09', 'quantite': '1'}, {'ingredient_id': 'df76e910-1b10-4d27-94a5-bd4b8cc21643', 'quantite': '40 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (229498, 'Cheesecake citron vert, sable speculoos, coulis de fraises (sans cuisson, ni gélatine)', 'spéculoos, beurre, fromage frais, crème fraîche, citron vert, sucre vanillé, cassonade, fraises', '60 min', ['Mettre les biscuits dans un sachet congélation bien fermé. Les briser en tapant délicatement dessus à l''aide d''un rouleau à pâtisserie.', 'Mettre le beurre fondé dans un bol, ajouter les brisures de biscuit et bien mélanger. Les brisures de biscuit doivent être bien imprégnées de beurre.', 'Tapisser un plat à gâteaux, ou mieux, le fond d''un cercle à pâtisserie posé sur une assiette, du mélange aux brisures de biscuit.', 'Bien tasser le sablé ainsi obtenu, avec le fond d''un verre, en pressant légèrement. ', 'Mettre au réfrigérateur, ou au congélateur si l''on est pressé.', 'Laver à l''eau tiède et zester les deux citrons verts.', 'Détendre doucement le fromage frais avec 100 g de sucre, le zeste de citron vert et le jus d''un citron vert et demi (réserver le demi citron vert et les 20 g de sucre restants pour le coulis de fraise).', 'Battre la crème en chantilly ferme avec le sucre vanillé.', 'Incorporer délicatement la chantilly, en plusieurs fois, dans l''appareil au fromage frais. Soulever doucement le mélange et ne pas fouetter pour éviter qu''il ne tombe, et/ou devienne trop liquide.', 'Garnir le fond sablé avec la crème au citron vert, bien lisser le dessus. ', 'Mettre au frais pendant plusieurs heures.', 'Lorsque je suis pressée, il m''arrive de le mettre une heure au congélateur, puis ensuite au réfrigérateur.', 'Juste avant de servir, équeuter et couper les fraises en 2.', 'Réserver quelques demi-fraises pour la décoration.', 'Mixer le reste avec le jus du demi-citron vert restant, et les 20 g de sucre.', 'Sortir le cheesecake du réfrigérateur, retirer le cas échéant le cercle à pâtisserie.', 'Disposer les demi-fraises réservées sur le dessus, partie coupée en contact avec le gâteau.', 'Servir le Cheesecake bien frais avec le coulis de fraises.'], ['Spatule', 'Planche à découper'], ['sucre vanillé', 'facile', 'coulis de fruits rouges', 'cassonade', 'recettes de cuisine', 'plat', 'cocktail', 'Cheesecake citron vert', 'sable speculoos', 'crème fraîche', 'plat de résistance', 'coulis de fraises (sans cuisson', 'fromage frais', 'rapide', 'moyen', 'recette', 'fraises', 'cuisine', 'citron vert', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'spéculoos', 'ni gélatine)'], 'Dessert', d0982dae-bfbb-4df5-97eb-cd09c5008e3a, '2025-09-26T15:24:18.859527', [{'ingredient_id': '7f7339a0-256f-4fa3-9a3a-460493e5593b', 'quantite': '25'}, {'ingredient_id': 'f43c01de-be4b-46b4-9989-8e879d1755ee', 'quantite': '80 g'}, {'ingredient_id': 'ff974569-d9b1-4d7b-939a-c17efce06531', 'quantite': '500 g'}, {'ingredient_id': '6e83d2ff-fe48-4405-b0de-2f4385af2842', 'quantite': '20 cl'}, {'ingredient_id': '504152ac-b4e2-40f8-9146-a844fd3e5a58', 'quantite': '2'}, {'ingredient_id': 'b6d9ee1c-4b60-41f7-91ab-b002c04a7656', 'quantite': '1'}, {'ingredient_id': '212020df-5e2e-4620-96c5-a4a5216b76c5', 'quantite': '120 g'}, {'ingredient_id': '6a27bfb1-268f-45a6-b014-3e407d7cdfa8', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18588, 'Tarte aux pommes', 'pâte brisée, pomme, sucre vanillé, beurre', '25 min', ['Éplucher et découper en morceaux 4 Golden.', 'Faire une compote : les mettre dans une casserole avec un peu d''eau (1 verre ou 2). Bien remuer. Quand les pommes commencent à ramollir, ajouter un sachet ou un sachet et demi de sucre vanillé. Ajouter un peu d''eau si nécessaire.', 'Vous saurez si la compote est prête une fois que les pommes ne seront plus dures du tout. Ce n''est pas grave s''il reste quelques morceaux.', 'Pendant que la compote cuit, éplucher et couper en quatre les deux dernières pommes, puis, couper les quartiers en fines lamelles (elles serviront à être posées sur la compote).', 'Préchauffer le four à 210°C (thermostat 7).', 'Laisser un peu refroidir la compote et étaler la pâte brisée dans un moule et la piquer avec une fourchette. ', 'Verser la compote sur la pâte et placer les lamelles de pommes en formant une spirale ou plusieurs cercles, au choix ! Disposer des lamelles de beurre dessus.', 'Mettre au four et laisser cuire pendant 30 min max. Surveiller la cuisson. Vous pouvez ajouter un peu de sucre vanillé sur la tarte pendant que çà cuit pour caraméliser un peu.'], ['Presse-agrumes', 'Fouet', 'Spatule', 'Batteur électrique'], ['sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'pâte brisée', 'recette', 'tarte aux pommes', 'cuisine', 'testées', 'entrée', 'dessert', 'Tarte aux pommes', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme'], 'Dessert', 8c6cf084-6c5a-4ae0-a707-83238e2a7fe5, '2025-09-26T15:24:25.363679', [{'ingredient_id': 'cd88845f-c51c-4248-8871-8ead96e4b648', 'quantite': '1'}, {'ingredient_id': '0c60eba6-a8e1-4e00-95f7-4afe59b5174c', 'quantite': '6'}, {'ingredient_id': '1e93e322-8c73-4a43-aaee-0385cf036439', 'quantite': '1'}, {'ingredient_id': 'b82456a7-4628-4726-831f-ed08ed8a34de', 'quantite': '30 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24946, 'Cake aux pommes', 'pomme, farine, sucre, beurre tendre, oeuf, levure, sucre vanillé, rhum', '20 min', ['Tamisez la farine, la levure et le sucre vanillé.', 'Mélangez le beurre mou avec les oeufs entiers, le sucre en poudre et le rhum jusqu''à l''obtention d''une masse blanche et épaisse.', 'Mélangez les 2 préparations et versez dans un moule rond beurré.', 'Pelez et coupez les pommes en 8 quartiers, disposez-les sur la pâte.', 'Faites cuire 1 h au four à 160°C (thermostat 5-6) environ.'], ['Planche à découper', 'Économe', 'Passoire'], ['sucre vanillé', 'autres cakes', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'oeuf', 'rhum', 'beurre tendre', 'moyen', 'levure', 'recette', 'cuisine', 'Cake aux pommes', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme', 'farine'], 'Dessert', d170d672-3b2c-4265-aee1-6300a0c013f8, '2025-09-26T15:24:31.935661', [{'ingredient_id': 'f25de17b-f603-425e-b468-e473cbf8fcd9', 'quantite': '3'}, {'ingredient_id': 'a27a2186-0872-40d4-ad4b-ec043786e982', 'quantite': '200 g'}, {'ingredient_id': 'ac9fc183-8e54-4cc3-807c-3707baf06f29', 'quantite': '150 g'}, {'ingredient_id': '31eac39b-82c4-42c3-9b54-7bd7cd502e53', 'quantite': '100 g'}, {'ingredient_id': '8ad8c415-224c-40ca-ba1f-e5253156e602', 'quantite': '2'}, {'ingredient_id': '3d2e5c41-bc36-4543-b9a6-f438d80cdcfb', 'quantite': '2 cuillères'}, {'ingredient_id': 'db0071cf-2d47-40b7-b972-186f5cfb3ad0', 'quantite': '1'}, {'ingredient_id': '505a1c27-2f37-4ab3-ad0a-08500c85fbb7', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315337, 'Gateau tout simple aux framboises', 'farine, sucre, framboises, oeuf, levure chimique, beurre, citron, sucre glace', '15 min', ['Préchauffer le four à 180 °C (thermostat 6).', 'Mélanger les œufs et le sucre jusqu’à ce que le mélange blanchisse. Ajouter la farine, la levure et le zeste de citron râpé.', 'Beurrer et fariner votre moule, puis y verser la pâte. Répartir harmonieusement les framboises surgelées par dessus. Trancher finement le beurre, par exemple à l’aide d’un coupe fromage, puis le répartir sur les framboises. Enfourner au milieu du four pour 35 minutes.', 'Laisser le gâteau refroidir, démouler puis saupoudrer de sucre glace pour servir.'], ['Spatule', 'Batteur électrique'], ['', 'recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'sucre', 'plat de résistance', 'citron', 'bon marché', 'oeuf', 'framboises', 'Gateau tout simple aux framboises', 'recette', 'cuisine', 'testées', 'sucre glace', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:24:36.690499', [{'ingredient_id': 'd8ea6cbb-bb8b-4004-99ef-680951668234', 'quantite': '150 g'}, {'ingredient_id': '0ca6cb54-0889-44ac-93ea-f70e2786fe5e', 'quantite': '175 g'}, {'ingredient_id': 'c890660a-bfd6-4abb-bd07-2c667a17e064', 'quantite': '100 g'}, {'ingredient_id': '11c730ce-dc2f-4ccb-811c-15b9b65ac9e0', 'quantite': '2'}, {'ingredient_id': 'ebd81d75-b238-4738-ab33-c089b8b953ee', 'quantite': ''}, {'ingredient_id': 'cb9ec229-13c3-4cf1-b95b-427b8a9d3d69', 'quantite': '50'}, {'ingredient_id': '5e14ebe6-4751-4281-aad5-1a77c125d617', 'quantite': '1'}, {'ingredient_id': '6d8292bd-c530-4e77-beee-8e6670e10796', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31211, 'Gratin de pommes de terre et épinards', 'pomme de terre, épinards frais, oignon, beurre, ail, gruyère râpé, crème fleurette, thym, muscade, poivre, sel', '40 min', ['Au préalable, faire cuire les pommes de terre à l''eau puis lorsqu''elles sont tièdes, les peler et les couper en rondelles. Mettre de côté. ', 'Trier, laver et faire blanchir les épinards dans de l''eau bouillante pendant 15 mn. Egouttez les en pressant. Mettre de côté. ', 'Peler et hacher finement l''oignon et l''ail et faites-les revenir dans le beurre. Ajoutez-y alors les épinards et cuire le tout jusqu''à évaporation du liquide. Saler, poivrer et ajouter de la muscade. ', 'Dans un plat beurré, disposer en alternance une couche de pommes de terre, une d''épinards et une de gruyère râpé, sel et poivre. Terminer par une couche de pommes de terre, saupoudrer de thym. ', 'Arroser le tout avec la crème fleurette et mettre le gruyère restant. Déposer quelques noisettes de beurre et mettre au four pendant 20 mn à 200°C (Th 6).'], ['Fouet', 'Casserole', 'Batteur électrique', 'Louche', 'Balance de cuisine'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'ail', 'plat de résistance', 'autre gratin de pommes de terre', 'Gratin de pommes de terre et épinards', 'épinards frais', 'sel', 'thym', 'moyen', 'oignon', 'recette', 'crème fleurette', 'cuisine', 'gruyère râpé', 'poivre', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'pomme de terre', 'confiserie', 'muscade'], 'Accompagnement', 13ee6d32-ce1d-46d2-9737-ae5fca483fc7, '2025-09-26T15:24:42.483656', [{'ingredient_id': '471beae3-7a3e-4367-91df-ad04877a910e', 'quantite': '700 g'}, {'ingredient_id': 'f0dd9a44-f642-40e9-95ed-3e1a1c298b53', 'quantite': '300 g'}, {'ingredient_id': '39b428ea-7c0e-48ad-b665-3bb3de31f786', 'quantite': '1'}, {'ingredient_id': 'b0f81299-f52f-40f6-9e9e-ea2f5c89e7ee', 'quantite': '40 g'}, {'ingredient_id': 'a52a28f6-fdea-439a-b54d-db251d87e7f2', 'quantite': '1'}, {'ingredient_id': '77ad5e52-b694-4d18-8548-3a3246e39c86', 'quantite': '150'}, {'ingredient_id': '775d177f-f0ae-4614-8551-09777d170f32', 'quantite': '30 cl'}, {'ingredient_id': '6ffa05bb-9b29-4f0c-a50b-896a6b926a0c', 'quantite': ''}, {'ingredient_id': 'c0271448-6ae6-4db1-b698-7c9e6d9c4528', 'quantite': ''}, {'ingredient_id': '0518a32c-4609-42df-af6d-d999503d4d75', 'quantite': ''}, {'ingredient_id': '855dd755-1141-4905-9212-de0e3b720d8d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (222859, 'Trianon croustillant choco-framboise', 'beurre, Digestive, crêpe dentelle, chocolat blanc, Confiture de framboise, chocolat noir, crème fraîche liquide, sucre glace', '30 min', ['Mettre la crème fraîche au frais, voire au congélateur, pour la préparer pour la suite.', 'Préparer le fond de tarte : faire chauffer le four à 210°C (thermostat 7), fondre le beurre et émietter grossièrement les biscuits et les crêpes.', 'Mélanger beurre fondu et biscuits et bien tasser ce mélange au fond d''un plat à manqué en silicone (ou à fond amovible). ', 'Cuire 10-12 min au four, jusqu''à ce que ce soit un peu grillé. Laisser refroidir.', 'Faire fondre le chocolat blanc de la couche intermédiaire avec un peu d''eau et badigeonner délicatement le fond de tarte. Cette étape est importante car c''est ce qui permettra au gâteau de rester croustillant au fond. Laisser durcir et étaler dessus une couche de confiture de framboises. Mettre au frais.', 'Préparer la mousse de la couche supérieure : monter la crème bien froide en chantilly avec le sucre glace. Faire fondre le chocolat et l''incorporer à la crème, toujours avec les batteurs.', 'Étaler cette mousse sur le fond de tarte et réserver au frais pendant 2 heures avant de manger.'], ['Casserole', 'Rouleau à pâtisserie', 'Fouet'], ['moyenne', 'trianon', 'Digestive', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'Trianon croustillant choco-framboise', 'crêpe dentelle', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie'], 'Dessert', 651182c4-8631-4f41-bbe2-9afae4626843, '2025-09-26T15:24:46.424547', [{'ingredient_id': '9566964f-367f-4d12-b0d6-fee3ab289657', 'quantite': '80 g'}, {'ingredient_id': '9d5e44cc-7205-450c-a662-c15ad3c74410', 'quantite': '150 g'}, {'ingredient_id': '801864c9-4fb9-4126-b596-9c3554702502', 'quantite': '50 g'}, {'ingredient_id': '4e2bd54f-ffb5-4e4c-9867-993c69f2661c', 'quantite': '125 g'}, {'ingredient_id': '0bf9a20f-9fc5-4b04-8901-01ee671ae993', 'quantite': '180 g'}, {'ingredient_id': '74a61ae5-ad02-44d7-aee4-5d124a68901c', 'quantite': '200 g'}, {'ingredient_id': 'a5dc9e74-7f0d-49c5-b17a-e08fa6982e06', 'quantite': '20 cl'}, {'ingredient_id': '76d94505-adaf-455a-a1ea-b38acec59dba', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228481, 'Gâteau moelleux aux fraises facile', 'yaourt, levure, huile, sucre, farine, oeuf, fraises, beurre', '10 min', ['Mélanger dans un saladier les ingrédients les un après les autres. ', 'Laver les fraises et les couper en morceaux. ', 'Incorporer les fraises à la pâte. ', 'Beurrer et fariner le moule.', 'Verser la pâte dans le moule.', 'Préchauffer le four à 190°C (thermostat 6) et faire cuire 30 min.'], ['Balance de cuisine', 'Louche'], ['recettes de cuisine', 'plat', 'cocktail', 'sucre', 'Gâteau moelleux aux fraises facile', 'plat de résistance', 'yaourt', 'bon marché', 'oeuf', 'gâteaux aux fruits', 'levure', 'recette', 'fraises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'huile', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:24:51.912309', [{'ingredient_id': '5138e05d-8d24-44d2-8237-9cfa8cfaf1f9', 'quantite': '1'}, {'ingredient_id': 'a2e93bc8-0958-45ac-90a8-f57c9b693915', 'quantite': ''}, {'ingredient_id': '0cbc12c2-1761-4768-8a4b-2730ef23edca', 'quantite': ''}, {'ingredient_id': '41c1e8d0-a1d8-4b38-86c6-b125a351377a', 'quantite': '2'}, {'ingredient_id': 'd00faed5-f9d5-4f63-ad16-bec9c0ff8fb3', 'quantite': '3'}, {'ingredient_id': 'c30b53e1-0f60-4bf5-b16f-1867a235110f', 'quantite': '2'}, {'ingredient_id': '3b18b05c-f3a1-400a-b2f5-24d84287d534', 'quantite': '350 g'}, {'ingredient_id': 'f1de39d7-9832-4d9a-892f-520fb9545a36', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (39688, 'Muffins moelleux aux framboises', 'farine, sucre glace, beurre, blanc d''oeuf, amandes en poudre, framboises', '15 min', ['Préchauffer le four à 190°C (thermostat 6-7).', 'Faire fondre le beurre, dans une casserole, à feu doux.', 'Dans un petit bol, battre les blancs d''oeufs légèrement à l''aide d''une fourchette.', 'Dans un saladier, mélanger la farine et le sucre glace, puis ajouter le beurre fondu, les blancs d''oeufs légèrement battus et la poudre d''amandes.', 'Mélanger jusqu''à ce que la préparation soit homogène.', 'Répartir la pâte dans les empreintes à muffins et placer quelques framboises sur le dessus.', 'Faire cuire au four 40 min environ.'], ['Batteur électrique', 'Passoire', 'Économe', 'Casserole'], ['recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'Muffins moelleux aux framboises', 'bon marché', 'muffin', 'framboises', 'recette', 'cuisine', 'blanc d''oeuf', 'testées', 'sucre glace', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'amandes en poudre', 'farine'], 'Dessert', 0f39b9b2-a472-4dcc-b15d-441a71c4602c, '2025-09-26T15:24:56.635126', [{'ingredient_id': '166614aa-e4c1-4500-8b84-4ae41c419e4d', 'quantite': '90 g'}, {'ingredient_id': 'efad5caf-6fb4-4f58-ae24-f66c661665b0', 'quantite': '120 g'}, {'ingredient_id': '4bf23d38-565f-4017-a81a-3c0eb45078e2', 'quantite': '90 g'}, {'ingredient_id': '9046ab9f-6986-4a69-8212-1178778e6bc5', 'quantite': '3'}, {'ingredient_id': '1b866d1b-c88b-4d76-bb69-8e1f82686248', 'quantite': '20 g'}, {'ingredient_id': '583f4287-505a-4fee-bc52-2b8c2dbec9ea', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72222, 'Charlotte simple aux fraises et à la menthe', 'fraises, fromage blanc, biscuits à la cuillère, menthe', '20 min', ['Lavez et équeuttez les fraises. Réservez 4 fraises. ', 'Coupez les autres en morceaux grossiers.', 'Préparez une tasse de tisane à la menthe. Laissez refroidir.', 'Mixez les 4 fraises et mélangez-les au fromage blanc.', 'Versez la tisane dans une assiette à soupe. ', 'Tapissez le bord puis le fond du moule avec les biscuits à la cuillère que vous trempez très rapidement dans la tisane, en les serrant bien (les biscuits doivent être encore fermes). ', 'Si nécessaire, recoupez les biscuits pour qu''ils soient de la hauteur du moule.', 'Remplissez avec la moitié du fromage blanc puis la moitié des fraises puis une couche de biscuits trempés (utilisez les petits morceaux restant de l''opération précédente).', 'Renouvelez une fois : fromage blanc puis fraises puis biscuits trempés.', 'Couvrir avec une assiette ou un couvercle de la dimension exacte du moule, posez un poids de 1 kg dessus et réservez une nuit au réfrigérateur.', 'Démoulez sur un plat au moment de servir en trempant le moule quelques instants dans l''eau chaude.'], ['Casserole', 'Mixeur', 'Verre doseur', 'Poêle'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'charlotte aux fraises', 'menthe', 'plat de résistance', 'fromage blanc', 'biscuits à la cuillère', 'bon marché', 'rapide', 'recette', 'fraises', 'cuisine', 'testées', 'Charlotte simple aux fraises et à la menthe', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', 9e60a3f1-978c-4382-807d-9cf181f9b6cf, '2025-09-26T15:25:00.109471', [{'ingredient_id': '2b4a84b2-4bae-4d5a-82af-69dd11ff415b', 'quantite': '250 g'}, {'ingredient_id': '950c03e8-8de3-42a4-9048-a53c88cf2d96', 'quantite': '500 g'}, {'ingredient_id': 'd8692c14-e1dc-4160-ba94-d73cd33d8a48', 'quantite': '40'}, {'ingredient_id': '7b4bb3c1-12bf-4753-ba18-063e01f5274f', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20525, 'Soupe d''hiver aux pommes de terre', 'pomme de terre, carotte, céleri, poireau, lard fumé, saucisse de Morteau, fond de volaille, boeuf, crème fraîche, cerfeuil', '30 min', ['Faire cuire les pommes de terre dans de l''eau salée, égoutter. ', 'Dans un grand pot, préparer un bouillon avec le fond et le cerfeuil haché. ', 'Couper en rondelles les carottes et le poireau, couper le céléri en dés. ', 'Mettre 2-3 pommes de terre de côté, ajouter le reste des pommes de terre coupées en dés avec les légumes au bouillon. ', 'Couper le lard en dés et ajouter-le avec la saucisse coupée en rondelles au potage. ', 'Faire cuire une bonne demi-heure. ', 'Ecraser les pommes de terre restantes avec une fourchette et les ajouter avec la crème fraîche à l''ensemble. ', 'Bien remuer, laisser mijoter 5 mn.'], ['Spatule', 'Couteau de chef'], ['lard fumé', 'recettes de cuisine', 'plat', 'Soupe d''hiver aux pommes de terre', 'cocktail', 'crème fraîche', 'plat de résistance', 'bon marché', 'cerfeuil', 'saucisse de Morteau', 'céleri', 'soupe', 'boeuf', 'poireau', 'recette', 'carotte', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'pomme de terre', 'fond de volaille', 'confiserie'], 'Plat principal', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:25:04.859217', [{'ingredient_id': '01d222eb-c023-493c-b0ef-b96df3a1a698', 'quantite': '10'}, {'ingredient_id': '4313e363-fef8-4194-90b0-4cc9e23e3991', 'quantite': '4'}, {'ingredient_id': '69734c15-70f8-413b-85e3-7a0ad0563595', 'quantite': '1'}, {'ingredient_id': '8abde372-b6ea-46bd-825e-6abe7d7a4430', 'quantite': '1'}, {'ingredient_id': 'e6a529a4-9b25-4d52-886f-29e3e3d301b6', 'quantite': '5'}, {'ingredient_id': '753cf701-0a04-4676-810b-0fbcb40a3c7b', 'quantite': '1'}, {'ingredient_id': 'df8fd195-2d3d-4ab3-9e36-b5a238162d55', 'quantite': '1'}, {'ingredient_id': '9da6608f-c4b0-42bd-9a7b-65e757fc25a0', 'quantite': ''}, {'ingredient_id': 'a73c1263-9081-4858-afce-5b3c67089b2f', 'quantite': '2 cuillères'}, {'ingredient_id': '0ddf1646-3700-4041-ae95-40d56b5a251e', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27994, 'Paupiettes de veau pommes et pruneaux', 'paupiette de veau, pomme, pruneau, oignon, fond de veau', '10 min', ['Dans une cocotte en fonte, faire fondre une grosse noisette de beurre. Mettre à fondre les oignons dans la cocotte.', 'Pendant ce temps là, peler et découper les pommes en grosses tranches.', 'Mettre les paupiettes à dorer (de tous les côtés) sur le lit d''oignons.', 'Lorsqu''elles sont toutes bronzées, ajouter les tranches de pomme, les pruneaux, et déglacer avec un peu de fond de veau avant de verser tout le verre. Ajouter, si nécessaire, un peu plus d''eau, mais pas de trop sinon la viande aura un goût de "bouilli".', 'Couvrir et laisser cuire à petit feu de 25 à 30 mn selon la grosseur des paupiettes, sans oublier de les retourner de temps en temps (il faut bien qu''elles cuisent des 2 côtés !).', 'Aussi simple que cela. Bon appétit !'], ['Passoire', 'Fouet'], ['facile', 'fond de veau', 'recettes de cuisine', 'plat', 'cocktail', 'paupiette', 'plat de résistance', 'paupiette de veau', 'pruneau', 'moyen', 'Paupiettes de veau pommes et pruneaux', 'oignon', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme'], 'Plat principal', deb336a3-dfab-434a-84bd-8f1dd8dc18bd, '2025-09-26T15:25:11.654516', [{'ingredient_id': '3edd47f5-d009-40c7-954f-bbcb1307aad2', 'quantite': '4'}, {'ingredient_id': '7f77bd40-78cb-4aed-84db-5c77decbab5e', 'quantite': '2'}, {'ingredient_id': '84653db5-16a8-4f3d-9675-60fbd6135b1e', 'quantite': '10'}, {'ingredient_id': '753c43ca-d8d9-4fa3-8b64-1eff1d57fc67', 'quantite': '1'}, {'ingredient_id': '283d84b0-4efb-4f9e-ae94-f521b7839d14', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30173, 'Gâteau aux pommes ''en deux fois''', 'farine, sucre, lait, huile, oeuf, levure chimique, pomme, beurre, sucre, sucre vanillé, oeuf', '15 min', ['Mélanger la farine, la levure, le sucre, le lait, l''huile et les oeufs.', 'Verser dans un moule à manquer, bien beurré et fariné. Ajouter les pommes coupées en tranches. ', 'Cuire à four moyen préchauffé (thermostat 6/180°C) pendant 30 mn (le gâteau doit commencer à dorer).', 'Pendant ce temps, faire fondre le beurre, le sucre et sucre vanillé.', 'Hors du feu, rajouter les deux oeufs.', 'Verser cette préparation sur le gateau et remettre au four pendant 20 à 25 mn.'], ['Louche', 'Pince de cuisine', 'Râpe'], ['facile', 'gâteau aux pommes', 'recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'sucre', 'Gâteau aux pommes ''en deux fois''', 'plat de résistance', 'bon marché', 'oeuf', 'recette', 'cuisine', 'lait', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme', 'huile', 'farine'], 'Dessert', f506d67e-695b-41d9-a30b-4766547f43a7, '2025-09-26T15:25:18.307455', [{'ingredient_id': 'c216aa4b-0575-4a72-82f3-9075515eb791', 'quantite': '10 cuillères'}, {'ingredient_id': '41eb4171-bf8b-4d25-b50e-48454433f115', 'quantite': '8 cuillères'}, {'ingredient_id': 'f315e5ae-90f2-4b21-8a3b-37833956710b', 'quantite': '6 cuillères'}, {'ingredient_id': 'f4fc19e6-b7f9-4b75-ae9b-e57d4f121337', 'quantite': '4 cuillères'}, {'ingredient_id': 'a7a06335-e67a-465e-8057-c6c11983004d', 'quantite': '2'}, {'ingredient_id': '154cc18d-300a-4f44-be4e-6e49a9019646', 'quantite': '1'}, {'ingredient_id': '216e14c4-5176-492c-a9dc-ff501a571fb4', 'quantite': '3'}, {'ingredient_id': '2e4fdb7e-fa93-43e6-bbf6-c10fd32b42fd', 'quantite': '150 g'}, {'ingredient_id': '1a8d6467-6c88-410c-bd39-222e8a124345', 'quantite': '1'}, {'ingredient_id': '19c1e6ab-9e02-4000-aa00-7747d3b704c4', 'quantite': '1'}, {'ingredient_id': 'dddfd8bd-a352-4655-9473-5f315420891d', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13686, 'Magret de canard aux pommes', 'Magret de Canard, vinaigre, miel liquide, échalote, pomme, citron, poivre, sel', '20 min', ['Retirez la peau grasse des magrets et posez-les dans un plat creux.', 'Enduisez-les de miel, puis poivrez-les assez abondamment sur les 2 faces. Arrosez-les ensuite de vinaigre basalmique et ajoutez l''échalote. Laissez reposer à couvert pendant au moins 1 h.', 'Pelez les pommes, retirez les coeurs et les pépins. Coupez-les en tranches dans une poêle à revêtement antiadhésif. Arrosez-les de jus de citron et ajoutez 15 g de beurre en parcelle.', 'Faites chauffer sur feu moyen pendant 20 mn en retournant les pommes de temps en temps. Salez et poivrez en fin de cuisson.', 'Préchauffez le gril du four.', 'Rangez les magrets dans un plat à four, avec leur marinade. Glissez-les sous le gril, à 15 cm de distance, et comptez 7 à 8 mn. Retournez-les et comptez encore 7 mn de cuisson.', 'Garnissez les assiettes de pommes cuites. Découpez les magrets en tranches et posez-les sur les pommes avec le jus qu''ils on rendu. Donnez un tour de moulin à poivre et servez.'], ['Rouleau à pâtisserie', 'Moule à tarte', 'Presse-agrumes'], ['facile', 'Magret de Canard', 'recettes de cuisine', 'plat', 'cocktail', 'échalote', 'miel liquide', 'Magret de canard aux pommes', 'plat de résistance', 'citron', 'vinaigre', 'magret de canard', 'sel', 'moyen', 'recette', 'cuisine', 'poivre', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme'], 'Plat principal', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:25:24.827361', [{'ingredient_id': '673c5360-c9ec-4e61-8a0e-b2151bdf3085', 'quantite': '2'}, {'ingredient_id': '0d42f9a8-c2cd-43a6-88fb-3656675e28cb', 'quantite': '1 cuillères'}, {'ingredient_id': '75277de1-7226-4f5e-8afc-cc240f8a02af', 'quantite': '2 cuillères'}, {'ingredient_id': '57beee81-5dab-4a19-abdc-a40e2fea1489', 'quantite': '2'}, {'ingredient_id': '005bb14d-44b8-4e18-b738-e34d6af1ae3d', 'quantite': '4'}, {'ingredient_id': '41839bc7-1908-46b5-b2ad-2f7ef5c80eb1', 'quantite': '1'}, {'ingredient_id': 'b7e29aec-36a3-408b-91cd-dbd69f02bd76', 'quantite': ''}, {'ingredient_id': 'f46e5671-9988-4558-81a3-613a61610ec3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16638, 'Gratin de pommes de terre à la paysanne', 'pomme de terre, jambon blanc, oignon, moutarde de Dijon, crème fraîche, gruyère râpé, lait, poivre, sel, persil', '30 min', ['Faire cuire les pommes de terre dans un grand volume d''eau salée. Vérifier qu''elles restent un peu fermes au terme de leur cuisson. Peler et émincer les oignons, les faire fondre à la poêle dans un filet d''huile, jusqu''à ce qu''ils soient dorés. Couper le jambon en petits carrés (1cm) et le badigeonner de moutarde.', 'Mélanger la crème fraîche avec le gruyère. Peler les pommes de terre, les couper en rondelles. Mettre le four à chauffer à 220°C. Beurrer un plat à four, en tapisser le fond avec une 1ère couche de pommes de terre.', 'Recouvrir de la moitié du jambon puis de la moitié des oignons. Saler et poivrer. Recouvrir d''une seconde couche de pommes de terre, d''oignons et de jambon, assaisonner de nouveau.', 'Terminer par une couche de pommes de terre, recouvrir du mélange crème fraîche-gruyère et répandre le lait sur la surface. Saler, poivrer, saupoudrer de persil ciselé.', 'Mettre au four pour 20 à 30 mn, la surface doit être bien dorée.'], ['Balance de cuisine', 'Tire-bouchon', 'Moule à tarte', 'Ouvre-boîte', 'Râpe'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'crème fraîche', 'plat de résistance', 'autre gratin de pommes de terre', 'Gratin de pommes de terre à la paysanne', 'bon marché', 'persil', 'sel', 'oignon', 'recette', 'cuisine', 'lait', 'gruyère râpé', 'poivre', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'moutarde de Dijon', 'pomme de terre', 'confiserie', 'jambon blanc'], 'Plat principal', d6c51879-598f-4ade-b4d0-abb2481d9a44, '2025-09-26T15:25:31.637277', [{'ingredient_id': '51f24968-184f-4675-b3a7-f59ce7901a13', 'quantite': '1 kg'}, {'ingredient_id': '5a66977d-80fc-4ef2-8d3e-ee5f759419c9', 'quantite': '5'}, {'ingredient_id': '38bce743-5973-4313-af99-1eba6602a8f4', 'quantite': '3'}, {'ingredient_id': 'dfb188c9-b23b-49f7-a269-9d0f553b885f', 'quantite': ''}, {'ingredient_id': 'b124b04d-95a5-4c03-b06f-e8dce8427dd9', 'quantite': ''}, {'ingredient_id': 'a5cfe2d1-7f75-4c39-b236-8d42c33b4fef', 'quantite': '75 g'}, {'ingredient_id': '26fbfb32-ef4f-4660-9292-b5f1d7a5d302', 'quantite': ''}, {'ingredient_id': '4c1019d5-cb62-4eb5-9980-c55cc843e10e', 'quantite': ''}, {'ingredient_id': '0d61bf9f-193a-4987-9203-5dbb324748e1', 'quantite': ''}, {'ingredient_id': 'de2919ad-004a-4be4-ade4-808db9f57803', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (25053, 'Magret de canard au miel, sauce soja et pommes', 'Magret de Canard, miel, sauce soja, pomme, fleur de sel, poivre', '15 min', ['La veille ou 8 heures avant la cuisson, mettre le miel et la sauce soja dans un saladier, et plonger les magrets dans la préparation. Laisser reposer au réfrigérateur. ', 'Le jour même, préchauffer le four à 190°C (chaleur tournante et gril).', 'Mettre les magrets (côté peau vers le haut) dans un plat en les arrosant de 2 cuillères à soupe de marinade et réserver le reste. Mettre au four.', 'Laisser griller la peau du magret environ 15 bonnes minutes et prenant soin d''arroser les magrets avec le jus du plat. Retourner le magret et laisser cuire 10 min.', 'Pendant la cuisson des magrets éplucher et découper les pommes en tranches pas trop fines, les plonger dans l''eau bouillante environ 2 mn et égoutter.', 'Mettre le reste de marinade dans une casserole et chauffer à feu très doux. Attention de ne pas faire caraméliser la sauce ! ', 'Découper les magrets et disposer les tranches sur des assiettes chaudes, ainsi que les pommes. Mettre un pincée de fleur de sel et le poivre sur la viande, puis ajouter la sauce. ', 'Servir bien chaud.'], ['Planche à découper', 'Ouvre-boîte'], ['Magret de Canard', 'recettes de cuisine', 'plat', 'cocktail', 'Magret de canard au miel', 'sauce soja', 'plat de résistance', 'bon marché', 'magret de canard', 'fleur de sel', 'miel', 'recette', 'sauce soja et pommes', 'cuisine', 'poivre', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme'], 'Plat principal', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:25:37.235306', [{'ingredient_id': 'b2e98d42-3144-4835-a846-fbab24c3c748', 'quantite': '2'}, {'ingredient_id': '46d3d7b4-4084-4b05-b4a1-72522c26164c', 'quantite': '3 cuillères'}, {'ingredient_id': '2c68083e-b25b-4c0d-9d2e-0a3b4e9ac505', 'quantite': '75 ml'}, {'ingredient_id': '0390c41d-582f-4ea1-99bb-08123bc18425', 'quantite': '3'}, {'ingredient_id': 'b0711ee9-cce5-404e-958b-2c57d7e8ca90', 'quantite': ''}, {'ingredient_id': '33f94666-84cf-48a9-bedf-422d079e6b05', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29849, 'Clafoutis à la framboise', 'framboises, maïzena, sucre en poudre, sucre vanillé, sel, oeuf, lait, crème fraîche', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Rincer et égoutter les framboises, les disposer dans un plat à tarte beurré.', 'Mélanger la maïzena, le sucre en poudre, le sucre vanillé, le sel, les oeufs entiers et les jaunes. Incorporer progressivement le lait et la crème, la pâte doit être fluide.', 'Verser la pâte sur les framboises et enfourner pour 35 minutes de cuisson.'], ['Spatule', 'Poêle', 'Mixeur'], ['sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'Clafoutis à la framboise', 'crème fraîche', 'plat de résistance', 'bon marché', 'oeuf', 'maïzena', 'framboises', 'clafoutis', 'sel', 'recette', 'sucre en poudre', 'cuisine', 'lait', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', 54f8301e-1b95-46fa-b454-60d23bbd4024, '2025-09-26T15:25:42.999420', [{'ingredient_id': 'a627e44b-462e-484d-a2ff-5198c49a1b47', 'quantite': '600 g'}, {'ingredient_id': 'cd99bb1a-a9ff-453c-833b-a69fb75e12e6', 'quantite': '90 g'}, {'ingredient_id': '47eb816a-a153-426a-8b8b-39672476a00a', 'quantite': '180 g'}, {'ingredient_id': 'cb8d9a56-8c30-4d65-9717-d8bd6388bbb8', 'quantite': '1'}, {'ingredient_id': 'b692b18c-b50a-4a91-bf33-af703a6cfd1c', 'quantite': '1'}, {'ingredient_id': '220544e3-e704-441e-850c-37a620e74352', 'quantite': '3'}, {'ingredient_id': 'a2e9161b-2d15-4970-9a79-502d17646738', 'quantite': '37.5 cl'}, {'ingredient_id': 'dd3189cf-0f8b-4110-9706-a6d263bd51fb', 'quantite': '300 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (44189, 'Bûche glacée choco-framboise', 'glace au chocolat, framboises, crème fraîche, meringue, petit beurre, framboises, coulis de framboise', '60 min', ['Dans un moule à cake d''1 litre (pour connaître le volume : remplissez le moule d''eau, car 1 k g d''eau = 1 litre). ', 'Préferez un moule en silicone, plus aisé au démoulage. Sinon, tapissez de film alimentaire votre moule habituel. ', 'Remplissez le moule de glace au chocolat ramollie, mais pas fondue!', 'Placez-le au congélateur pendant 1 à 2 h.', 'Quand la glace a un peu redurcie, creusez une gouttière à l''aide d''une cuillère. ', 'Remplissez la goutière de sorbet à la framboise ramolli. Et placez au congélateur encore 1 à 2 h.', 'Quand la glace a un peu redurci, recouvrez avec la glace au chocolat qui constituait la gouttière. Ne remplissez pas jusqu''en haut!', 'Mixez les biscuits avec un peu de crème fraîche, de manière à obtenir une pâte constitante. ', 'Couvrez-en la bûche, et replacez au congélateur.', 'Démoulez la bûche, recouvrez-la de meringue concassée, et décorez de framboises surgelées et de chantilly (avec 1 poche à douille, c''est plus joli!). Replacez au congélateur.', 'Servez la bûche avec de la chantilly et du coulis de framboise.', 'Miam...'], ['Casserole', 'Couteau de chef', 'Économe', 'Presse-agrumes'], ['meringue', 'recettes de cuisine', 'plat', 'bûche glacée', 'cocktail', 'glace au chocolat', 'crème fraîche', 'plat de résistance', 'bon marché', 'framboises', 'rapide', 'recette', 'cuisine', 'coulis de framboise', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'Bûche glacée choco-framboise', 'confiserie', 'petit beurre'], 'Dessert', 90f37bcb-cd88-4540-a44c-5ca8ba904655, '2025-09-26T15:25:46.859232', [{'ingredient_id': '5186d44f-e38d-444e-9782-64fee54267fa', 'quantite': '1.5 l'}, {'ingredient_id': 'a165bb62-341f-4448-917c-3f2c25b48581', 'quantite': ''}, {'ingredient_id': '8f815279-cae3-4184-b548-b1813d2fae9c', 'quantite': ''}, {'ingredient_id': 'dd6c7e70-695c-4d5a-9236-ab1b300692fd', 'quantite': '2'}, {'ingredient_id': '20e0c325-63ce-49ab-8513-74102660c0ed', 'quantite': '40 g'}, {'ingredient_id': 'bb97ccde-6f97-45cd-8340-8bac22b0a586', 'quantite': '5'}, {'ingredient_id': '57813592-57a2-4d56-9e5b-41d0d2a00844', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55433, 'Crumble pomme chocolat', 'pomme, sucre, farine, beurre, chocolat', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Eplucher les pommes, les couper en lamelles et les disposer dans un plat qui va au four.', 'Mélanger la farine, le sucre et le beurre (ramolli au préalable 30 secondes au micro-ondes) dans un grand récipient jusqu''à obtenir une sorte de pâte.', 'Planter les carreaux de chocolat dans les pommes et saupoudrer de la pâte obtenue.', 'Mettre le plat au four durant 20 minutes.'], ['Louche', 'Planche à découper', 'Râpe', 'Passoire'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'chocolat', 'bon marché', 'recette', 'cuisine', 'testées', 'autres crumbles', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'Crumble pomme chocolat', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:25:53.624480', [{'ingredient_id': '866c4812-f597-4180-ad09-facede1ea804', 'quantite': '4'}, {'ingredient_id': '7a571871-a2f8-4b49-bbf7-6be6d910f8e1', 'quantite': '200 g'}, {'ingredient_id': '2987cafd-1e52-47fa-98fb-bb39939a320b', 'quantite': '200 g'}, {'ingredient_id': 'ba815c71-1344-4b9f-911c-2ecaf052ce2d', 'quantite': '150 g'}, {'ingredient_id': 'eb788019-6ff0-43d2-8556-fa522e29b19b', 'quantite': '12'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37577, 'Gâteau aux pommes rapide', 'beurre, farine, sucre, citron, oeuf, levure chimique, pomme', '20 min', ['Faire fondre le beurre dans le moule au four.', 'Râper le citron (la peau), ajouter le sucre, les œufs bien fouetter le tout.', 'Ajouter la farine déjà mélangée à la levure, puis le beurre fondu un peu refroidi.', 'Bien mélanger le tout et le mettre dans le moule.', 'Eplucher les pommes, les couper en tranches et les planter dans le gâteau. Pour les pommes utilisez si possible des reinettes ou des golden.   ', 'Enfourner à four chaud à 180°C (thermostat 6) pendant 25 minutes. ', 'Soupoudrer de sucre glace une fois refroidi.'], ['Passoire', 'Louche', 'Presse-agrumes', 'Économe', 'Planche à découper'], ['facile', 'gâteau aux pommes', 'recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'sucre', 'plat de résistance', 'citron', 'bon marché', 'oeuf', 'Gâteau aux pommes rapide', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:26:00.343027', [{'ingredient_id': 'd3cbe311-1406-4a14-bf74-0077fc57f3c2', 'quantite': '75 g'}, {'ingredient_id': '04a65bf2-26ed-4f5c-92f6-873012499298', 'quantite': '150 g'}, {'ingredient_id': 'a9d62f19-4d36-4abc-9969-245417eee6ef', 'quantite': '110 g'}, {'ingredient_id': '6ce3dda8-a8ce-472c-a2b0-a48bb3a5f4b6', 'quantite': '1'}, {'ingredient_id': 'ddadbb63-b9c8-4040-b030-af5381bc69d1', 'quantite': '3'}, {'ingredient_id': '8a502bf8-4f15-4a89-9e64-3d249cbe6cfa', 'quantite': '1'}, {'ingredient_id': '269a4c06-1b3a-4fd7-b4f0-4fbe76eeaf08', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17787, 'Tarte aux framboises', 'farine, beurre demi-sel, mascarpone, fromage blanc, sucre, framboises, jus de citron, sucre glace', '30 min', ['Préparez une pâte sablée avec la farine et le beurre ramolli. ', 'Etalez-la à la main dans un plat à tarte préalablement beurré. ', 'Faire cuire à blanc pendant environ 30 mn à 160°C. Laissez refroidir. ', 'Dans le bol du mixeur, mélangez la Mascarpone, le fromage blanc et le sucre. ', 'Lorsque la pâte est refroidie, étalez la crème. Disposez dessus 250 g de framboises. ', 'Mixez les 50 g de framboises restantes, le jus de citron et le sucre glace pour obtenir un coulis de framboise que vous servirez à part. ', 'Laissez refroidir au réfrigérateur environ 2 heures.'], ['Fouet', 'Rouleau à pâtisserie'], ['testées', 'plat de résistance', 'Tarte aux framboises', 'très facile', 'moyen', 'recettes de cuisine', 'plat', 'entrée', 'dessert', 'tarte aux framboises', 'recettes', 'recette', 'boisson', 'cocktail', 'confiserie', 'cuisine', 'beurre demi-sel', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:26:07.170409', [{'ingredient_id': '84a7f3c3-1536-4f0b-9e6d-b74577933d7b', 'quantite': '300 g'}, {'ingredient_id': '86eb0d49-9726-4415-8f44-6945bc6cb22c', 'quantite': '250 g'}, {'ingredient_id': 'abe0c8da-d2ba-4d72-b2db-ab85c1ddc621', 'quantite': '250 g'}, {'ingredient_id': '1317fe9a-4926-4537-ad0e-0713dccbc149', 'quantite': '100 g'}, {'ingredient_id': 'f1c8a004-b510-4b32-b715-32e54b6fcf66', 'quantite': '100 g'}, {'ingredient_id': 'b5e258e5-e20a-4973-b1f5-11b436eeaca3', 'quantite': '300 g'}, {'ingredient_id': '821c7978-ff53-429e-b00c-1212f4085e18', 'quantite': '1'}, {'ingredient_id': '753b3e31-be07-4b77-af3f-17a926bef776', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20545, 'Pommes au four', 'pomme, sucre en poudre', '5 min', ['Préchauffer votre four à 180°C (thermostat 6).
Equeutez les pommes.', 'Placez les  dans un plat allant au four puis piquez-les avec une fourchette (environ 3 fois)', 'Saupoudrez de sucre.', 'Versez un verre d''eau au fond du plat.', 'Mettre au four pendant environ 1/2 heure.', 'Servir chaud !'], ['Économe', 'Fouet'], ['testées', 'plat de résistance', 'très facile', 'recettes de cuisine', 'plat', 'entrée', 'dessert', 'recette', 'recettes', 'sucre en poudre', 'cuisine', 'boisson', 'cocktail', 'Pommes au four', 'pomme', 'confiserie', 'pomme au four', 'bon marché'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:26:13.708160', [{'ingredient_id': '48ca0cf4-df44-4a47-8966-ff7053388e60', 'quantite': '4'}, {'ingredient_id': '2f1eaf7a-17a5-448c-a183-dc350d2eef15', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28852, 'Charlotte aux fraises et fromage blanc', 'fraises, fromage blanc, sucre, kirsch, crème anglaise, sucre vanillé, biscuits à la cuillère', '15 min', ['Dans un saladier mettre le fromage blanc avec le sucre et le sucre vanillé, mélanger. ', 'Mettre du kirsch dans une assiette creuse et couper avec un peu d''eau. ', 'Prendre un moule à charlotte et le garnir de biscuits à la cuillère. ', 'Tremper dans le kirsch (juste un aller retour) en commençant par le fond et ensuite tout le tour. ', 'Verser une couche de fromage blanc dans le moule, puis une couche de fraises et une couche de biscuits passés dans le kirsch, recommencer une autre fois - terminer par les biscuits. ', 'Mettre un poids dessus et laisser au réfrigérateur environ 6 h. ', 'Au moment de servir, démouler et verser de la crème anglaise dessus.'], ['Tire-bouchon', 'Batteur électrique'], ['sucre vanillé', 'recettes de cuisine', 'plat', 'cocktail', 'sucre', 'charlotte aux fraises', 'plat de résistance', 'fromage blanc', 'kirsch', 'biscuits à la cuillère', 'bon marché', 'rapide', 'Charlotte aux fraises et fromage blanc', 'recette', 'fraises', 'cuisine', 'testées', 'crème anglaise', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', 9469dea0-0b30-4105-a5a8-e2f5619ef9fa, '2025-09-26T15:26:19.319117', [{'ingredient_id': 'd94b4e9a-39b8-4aae-a832-4304ed51f8e9', 'quantite': '500 g'}, {'ingredient_id': 'e057326c-11cc-4c12-917c-4ce97bccd41b', 'quantite': '500 g'}, {'ingredient_id': '3da40e21-a2ef-4869-ab93-670b498a35df', 'quantite': ''}, {'ingredient_id': '7142f940-ce2e-4db8-aebb-48da8a685eaa', 'quantite': ''}, {'ingredient_id': 'afb9c77a-821b-49c5-b997-7cced5de9a50', 'quantite': ''}, {'ingredient_id': '064c00ac-2362-4252-bda1-d7183416037c', 'quantite': '1'}, {'ingredient_id': 'ee0398b9-4c75-47ee-9bd4-edd3a0b3927a', 'quantite': '24'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (45826, 'Gratin d''endives et de pommes de terre', 'endive, pomme de terre, lardons, échalote, crème fraîche, poivre, sel, beurre', '15 min', ['Faire suer les endives coupées en tronçons dans une sauteuse avec une noisette de beurre, à couvert, à feu moyen, pendant 15 min. Puis à découvert 5 min.', 'Pendant ce temps, faire cuire les pommes de terre épluchées au cuit-vapeur. ', 'Réserver les endives. Faire rissoler les lardons dans la sauteuse puis l''échalote émincée. Quand elle est transparente, ajouter les endives et mélanger. Une fois le jus évaporé, mettre la crème fraîche. ', 'Couper en lamelles les pommes de terre et les étaler dans un plat à gratin. Saler, poivrer. ', 'Ajouter le mélange endives/lardons/échalote/crème.', 'Passer au four à 180°C (thermostat 6) pendant 15 min.'], ['Tire-bouchon', 'Rouleau à pâtisserie', 'Couteau de chef'], ['recettes de cuisine', 'plat', 'cocktail', 'échalote', 'crème fraîche', 'endive', 'plat de résistance', 'autre gratin de pommes de terre', 'bon marché', 'Gratin d''endives et de pommes de terre', 'sel', 'recette', 'cuisine', 'poivre', 'testées', 'très facile', 'entrée', 'dessert', 'lardons', 'recettes', 'boisson', 'beurre', 'pomme de terre', 'confiserie'], 'Plat principal', fea92a54-eaf7-454c-aea2-1a841a4ab883, '2025-09-26T15:26:24.928320', [{'ingredient_id': '1fa5eda9-8d25-4be6-8a87-d8517de17510', 'quantite': '5'}, {'ingredient_id': 'b3dbc5eb-7209-476b-9f76-5cfa0e144ba0', 'quantite': '4'}, {'ingredient_id': '4e0914d8-836f-4147-af31-7dcf4ffe87c4', 'quantite': '200 g'}, {'ingredient_id': '4a982b0d-6dfb-4806-93b7-a5a58280623b', 'quantite': '1'}, {'ingredient_id': '81ae4b8c-8334-4a25-9675-97eec3dbda72', 'quantite': '10 cl'}, {'ingredient_id': '9278a826-2428-49e7-ac92-615ff20fdc4c', 'quantite': ''}, {'ingredient_id': 'd874477e-494f-453e-86d9-3683f684e332', 'quantite': ''}, {'ingredient_id': '1b584d79-3fbe-454a-bf6c-1e23a93f0c27', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16846, 'Tarte aux fraises facile', 'pâte sablée, fraises, gelée, eau, beurre, sucre en poudre', '15 min', ['Placer votre pâte sablée dans un moule à tarte beurré, et saupoudrer de sucre.', 'Piquer le fond avec une fourchette et recouvrir d''un papier sulfurisé,  placer dessus des petits cailloux ou des haricots secs.', 'Faire cuire à four moyen (thermostat 6/180°C) pendant 15 min, retirer papier et haricots secs (ou cailloux); et laisser cuire 10 min de plus.', 'Mettre la gelée et l''eau dans une petite casserole, laisser mijoter doucement jusqu''à obtenir un coulis.', 'Une fois le fond de tarte froid et démoulé, y placer les fraises (bien serrées) et les napper avec le sirop.', 'VARIANTE : ', 'Faire une <a href="https://www.marmiton.org/recettes/recette_creme-patissiere_35195.aspx" target="_new">crème pâtissière</a> (y incorporer de l''extrait d''amande amère ou de l''Amaretto) et la placer sur le fond de tarte juste avant les fraises.'], ['Râpe', 'Spatule'], ['Tarte aux fraises facile', 'recettes de cuisine', 'plat', 'cocktail', 'pâte sablée', 'eau', 'plat de résistance', 'tarte aux fraises', 'bon marché', 'recette', 'sucre en poudre', 'fraises', 'cuisine', 'gelée', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie'], 'Dessert', 1f4e7bb3-a5c2-4176-aba9-549d5bdea6a1, '2025-09-26T15:26:31.670067', [{'ingredient_id': 'e68bf576-6f8a-413d-9620-1d6331c2e8f0', 'quantite': '1'}, {'ingredient_id': 'dea0caee-f8bb-4910-b436-0be4b8d53520', 'quantite': '1 kg'}, {'ingredient_id': 'e6e68336-1746-41ff-8321-0bfb442cce7b', 'quantite': '150 g'}, {'ingredient_id': '898dcec0-44ac-4e56-8a13-b407d9da9a44', 'quantite': ''}, {'ingredient_id': 'a0ddc24d-8d52-4f38-9924-a9bfec46530f', 'quantite': ''}, {'ingredient_id': '8a46fab2-88d0-49f2-9041-27fededa8045', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20457, 'Chou, pommes de terre, carottes à la façon de Madou', 'chou, carotte, pomme de terre, oignon, cube de bouillon, huile d''olive, lardons, vin blanc sec, graines de coriandre, genièvre, poivre, sel, quatre-épices', '35 min', ['Nettoyer le chou en ôtant les grosses feuilles du dessus. Le faire blanchir pendant 5/6 min. Bien l''égoutter en le pressant. ', 'Pendant qu''il s''égoutte faire revenir dans une cocotte en fonte les oignons et les lardons sans faire trop dorer. ', 'Ajouter le chou, les carottes, les pommes de terre. ', 'Emiettez le cube de bouillon, ajouter un bon verre de vin blanc sec, mettre les graines de coriandre, les baies de genièvre, les 4 épices, sel et poivre. ', 'Laisser cuire à feu pas trop fort pendant environ 20 min. ', 'Surveillez le niveau de liquide et rajouter si besoin est du vin blanc et/ou de l''eau.'], ['Spatule', 'Batteur électrique'], ['recettes de cuisine', 'plat', 'cube de bouillon', 'cocktail', 'carottes à la façon de Madou', 'plat de résistance', 'bon marché', 'quatre-épices', 'pommes de terre', 'chou', 'genièvre', 'Chou', 'sel', 'oignon', 'recette', 'carotte', 'cuisine', 'huile d''olive', 'poivre', 'testées', 'très facile', 'légumes', 'vin blanc sec', 'entrée', 'dessert', 'lardons', 'recettes', 'boisson', 'pomme de terre', 'confiserie', 'graines de coriandre'], 'Accompagnement', 7144ac18-d61f-4649-9a19-c9ea11149fa4, '2025-09-26T15:26:37.465893', [{'ingredient_id': '251b5727-cbd0-4327-a723-234a98375b4e', 'quantite': '1'}, {'ingredient_id': 'd326d73f-1cce-4d8a-beda-2207bb81b81a', 'quantite': '5'}, {'ingredient_id': '3b5c6cc6-f37b-4ba2-aa03-49162e5d1d06', 'quantite': '6'}, {'ingredient_id': '82599e1d-04f4-4447-8c40-89cc15ae37c8', 'quantite': '2'}, {'ingredient_id': '4110cad0-df44-4f7d-b925-ec8331a88e8d', 'quantite': '1'}, {'ingredient_id': 'b120a45a-ee2e-4ce2-9421-e66c4c17c3ef', 'quantite': ''}, {'ingredient_id': 'a7b23cae-a215-4e48-8fb7-eb427bb51d34', 'quantite': '125 g'}, {'ingredient_id': '591b7e99-a0de-4249-b60b-3ba591ca1903', 'quantite': '10 cl'}, {'ingredient_id': 'c06693fa-afed-42e1-aa40-d1ea99b6fc37', 'quantite': '1 cuillères'}, {'ingredient_id': '04c8c7f8-6c2b-47d8-b391-4fad9082e18a', 'quantite': '5'}, {'ingredient_id': '4884806a-d575-4d8f-95a9-a2991063eb01', 'quantite': ''}, {'ingredient_id': 'bda34c54-121d-4350-b6e4-8966b949f5e6', 'quantite': ''}, {'ingredient_id': 'da646459-e805-401c-ae1a-09c7e71e9e36', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (35751, 'Simplissime confiture framboise et rhubarbe', 'framboises, rhubarbe, sucre', '5 min', ['Ebouillantez vos pots de confiture et retournez-les sur un linge propre.', 'Mettez dans un grand faitout les framboises et la rhubarbe encore surgelées, ajoutez le sucre gélifiant et mélangez.', 'Mettez à cuire sur feu vif pendant 10 min, à gros bouillons, en remuant régulièrement.', 'Remplissez vos pots de confiture au maximum pour éviter de laisser trop d''air, fermez-les hermétiquement et posez-les ''la tête en bas'' 5 min (attention aux risques de brûlure), vous pourrez ensuite les remettre à l''endroit.'], ['Ouvre-boîte', 'Économe', 'Batteur électrique', 'Poêle'], ['recettes de cuisine', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'framboises', 'rhubarbe', 'rapide', 'moyen', 'recette', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiture de framboise', 'confiserie', 'Simplissime confiture framboise et rhubarbe'], 'Confiserie', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:26:41.001407', [{'ingredient_id': 'ce4fb688-7ba1-40a0-8205-3a657d1dde83', 'quantite': '1 kg'}, {'ingredient_id': 'b56d6938-763a-4de8-aaf0-c9935afa2e19', 'quantite': '1 kg'}, {'ingredient_id': '95c3a1e9-53bb-4fa1-901f-17f0066877c3', 'quantite': '1.6 kg'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (63970, 'Smoothie ultra-simple banane-framboise', 'banane, framboises, yaourt, lait, sucre en poudre', '5 min', ['Mettre la banane coupée en rondelles, les framboises, le yaourt et le lait dans le bol d''un mixer.', 'Mixer pendant environ 1 minute.', 'Goûter et ajouter du sucre si besoin.', 'Verser la préparation dans un verre.', 'Décorer de quelques framboises.', 'Bonne dégustation =)'], ['Pince de cuisine', 'Poêle', 'Couteau de chef'], ['recettes de cuisine', 'plat', 'cocktail', 'Smoothie ultra-simple banane-framboise', 'smoothies', 'plat de résistance', 'yaourt', 'banane', 'bon marché', 'framboises', 'rapide', 'recette', 'sucre en poudre', 'cuisine', 'lait', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Boisson', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:26:44.451666', [{'ingredient_id': '6e2a4ef9-50f4-42da-99d0-dc7d89c9845f', 'quantite': '1'}, {'ingredient_id': 'f5e5e36f-5b57-4537-a6b2-3d6a1b4194af', 'quantite': '1'}, {'ingredient_id': '998a0e26-d100-464d-8540-fa482ac6b548', 'quantite': '1'}, {'ingredient_id': 'c69228fc-e217-434b-acdf-b5692d0b7edb', 'quantite': '2 cl'}, {'ingredient_id': 'c79f915f-58cf-4308-8a11-2004ee4ea316', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (197431, 'Brownies au coeur de framboises', 'chocolat pâtissier, beurre, sucre en poudre, levure chimique, sucre vanillé, oeuf, farine, framboises, noix de pécan', '15 min', ['Dans une casserole, faire fondre le beurre et le chocolat préalablement coupés en morceaux.', 'Dans un saladier : Casser les œufs et les battre. Ajouter aux œufs battus, le sucre et remuez jusqu''à obtention d''un mélange mousseux. Ensuite ajouter petit à petit la farine et la levure tout en mélangeant la préparation.', 'Lorsque la pâte est lisse ajoutez le mélange (chocolat/beurre) fondu et remuez pour obtenir une pâte homogène.', 'Préchauffez le four à 180°C (th.6)', 'Beurrer un moule à cake ou y mettre du papier cuisson.', 'Verser la pâte jusqu''à mi-hauteur du moule.', 'Déposer les framboises fraiches ou surgelées en ligne puis recouvrir du reste de pâte.', 'Enfourner dans le four chaud et laisser cuire environ 30 minutes.', 'Piquez de temps en temps avec un couteau pour vérifier la cuisson.', 'Bon appétit !'], ['Économe', 'Moule à tarte', 'Spatule'], ['sucre vanillé', 'facile', 'Brownies au coeur de framboises', 'recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'plat de résistance', 'noix de pécan', 'bon marché', 'chocolat pâtissier', 'oeuf', 'framboises', 'recette', 'brownie', 'sucre en poudre', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'farine'], 'Dessert', c6b5b729-4f39-4b0b-892d-061a3e4ef0cd, '2025-09-26T15:26:47.873835', [{'ingredient_id': '12222953-58e2-439e-9031-69b8c9702c4d', 'quantite': '200 g'}, {'ingredient_id': 'b86dbec1-51ad-4d46-8ffa-bc6cca0c4d30', 'quantite': '100 g'}, {'ingredient_id': '1cb774d9-3d6c-4d76-bc39-bdfc8eea9e5c', 'quantite': '100 g'}, {'ingredient_id': 'e0aaead4-1e40-4a4d-ae17-bcbea4fdd02c', 'quantite': ''}, {'ingredient_id': '7464c085-9734-4135-8df5-5ffcc23bdd92', 'quantite': '1'}, {'ingredient_id': '628143fe-d369-40dd-8452-9ab554ef92fc', 'quantite': '3'}, {'ingredient_id': 'c1bf3974-c29c-4c4d-b0eb-e7947c5ef031', 'quantite': '120 g'}, {'ingredient_id': '306cd792-3462-4ae1-85bd-39ad7a1cb753', 'quantite': '250 g'}, {'ingredient_id': '571888b7-bd4b-4228-89c2-9412bf4848eb', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13534, 'Tarte duo aux framboises et à la rhubarbe', 'fond, framboises, rhubarbe, oeuf, sucre vanillé, sucre en poudre, farine', '20 min', ['Nettoyer les framboises, écrasez les et réservez.', 'pendant ce temps, faites réduire la rhubarbe en compote dans une casserole avec 25 g de sucre.', 'Préparez la crème avec les oeufs, le sucre vanillé, la farine et les 100 g de sucre restants, en mélangeant avec un fouet.', 'Séparez cette crème à parts égales dans 2 saladier, et incorporez dans chacun les framboises et la rhubarbe.', 'Dans un plat à tarte, déroulez le fond de tarte puis versez y les 2 mélanges de façon à partager la tarte en deux, puis faites cuire 30 minutes à 200°C.'], ['Casserole', 'Mixeur', 'Tire-bouchon', 'Planche à découper', 'Presse-agrumes'], ['sucre vanillé', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'tarte à la rhubarbe', 'oeuf', 'framboises', 'rhubarbe', 'moyen', 'recette', 'sucre en poudre', 'fond', 'cuisine', 'testées', 'Tarte duo aux framboises et à la rhubarbe', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:26:51.404288', [{'ingredient_id': 'b3b36cb4-0aed-479b-9eab-6bd46e79df39', 'quantite': '1'}, {'ingredient_id': '216ea0cd-3bcc-435d-99f9-a59292b26446', 'quantite': '1'}, {'ingredient_id': '1265e107-8c88-41ea-a3b2-8ec426b04ae3', 'quantite': '1'}, {'ingredient_id': '8a1de308-0e5a-4765-8b5d-129be5bcb954', 'quantite': '4'}, {'ingredient_id': '42b84891-df34-4e8c-b6f0-a986bcdfd3c6', 'quantite': '2'}, {'ingredient_id': '3e103831-d60e-411f-98a0-3ec209b3e863', 'quantite': '125 g'}, {'ingredient_id': '4c334c92-232d-4629-bbef-4c8003fc838d', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29279, 'Parfait glacé à la rhubarbe, coulis de framboises (5ème Rencontre Marmiton)', 'rhubarbe, sucre blond, maïzena, jaune d''oeuf, sucre glace, crème fraîche liquide, citron', '15 min', ['Nettoyer et éplucher la rhubarbe, la couper en petits morceaux. Mettre dans une casserole avec les 200 g de sucre et porter à ébullition, laisser "compoter" 15/20 mn pour ôter l''excédent d''eau. ', 'Délayer la Maïzena et ajouter à la rhubarbe, porter à ébullition 1 mn ; mixer et laisser refroidir. ', 'Battre les jaunes avec le sucre glace en ruban, ajouter le zeste de citron coupé en petits morceaux. Fouetter la crème fraîche en chantilly et ajouter aux oeufs, puis mélanger délicatement avec la rhubarbe. ', 'Passer un moule à cake rapidement à l''eau froide et verser la préparation. Mettre au congélateur 3 heures au minimum. ', 'Pour démouler plonger le fond du moule dans de l''eau très chaude. ', 'Servir avec un coulis de framboises ou de fraises.'], ['Passoire', 'Planche à découper', 'Balance de cuisine'], ['recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'citron', 'bon marché', 'jaune d''oeuf', 'coulis de framboises (5ème Rencontre Marmiton)', 'maïzena', 'crème fraîche liquide', 'rhubarbe', 'recette', 'cuisine', 'Parfait glacé à la rhubarbe', 'testées', 'sucre glace', 'très facile', 'sucre blond', 'entrée', 'dessert', 'parfait glacé', 'recettes', 'boisson', 'confiserie'], 'Dessert', 1d620c4a-ba8e-4d31-bee5-de0d2fabdfac, '2025-09-26T15:26:57.280037', [{'ingredient_id': 'a486f424-1659-4ad6-809e-9da946975c6a', 'quantite': '1 kg'}, {'ingredient_id': 'f259e579-eeae-40c5-b06b-5db63b611618', 'quantite': '200 g'}, {'ingredient_id': 'e4b4d4d0-a1ae-4d4c-b5c7-f9931f860c42', 'quantite': '1 cuillères'}, {'ingredient_id': 'fdad2766-f75c-44f4-9da4-9673626b470f', 'quantite': '2'}, {'ingredient_id': 'a53cf285-c903-467e-b86b-3d1ae47a40eb', 'quantite': '2 cuillères'}, {'ingredient_id': '15efbd32-f78c-4d0b-8430-82b4c28d2223', 'quantite': '20 cl'}, {'ingredient_id': '3f571bba-5b00-4643-ba58-70271c28f60b', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20064, 'tarte confiture de framboise et noix de coco', 'pâte brisée, Confiture de framboise, oeuf, sucre en poudre, noix de coco rapée, beurre', '10 min', ['étaler la pâte dans le moule à tarte puis étaler la confiture et mélanger tous les ingrédients. Cuire au four th 7, 30 mn environ.'], ['Moule à tarte', 'Rouleau à pâtisserie', 'Planche à découper', 'Batteur électrique'], ['recettes de cuisine', 'plat', 'cocktail', 'noix de coco rapée', 'plat de résistance', 'tarte confiture de framboise et noix de coco', 'bon marché', 'oeuf', 'pâte brisée', 'recette', 'sucre en poudre', 'Confiture de framboise', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiture de framboise', 'confiserie'], 'Dessert', f8c16d32-131d-47ac-964e-751783734ea8, '2025-09-26T15:27:02.050831', [{'ingredient_id': 'db495d9c-8663-4acc-864b-be891df3e19a', 'quantite': '1'}, {'ingredient_id': '47e8c73b-7424-4f4b-b84a-52c60c47fa86', 'quantite': ''}, {'ingredient_id': '9fdf8c78-068a-41e0-aecb-b62321405bf5', 'quantite': '4'}, {'ingredient_id': '10fc92f7-6cc6-4429-bf16-79f8b08bbed6', 'quantite': '125 g'}, {'ingredient_id': 'b0d8a483-ebcd-42bf-90db-55c07f61a0a1', 'quantite': '150 g'}, {'ingredient_id': '28b2ea49-f8dc-448b-98d5-fc9a07cc728d', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18921, 'Tarte aux pommes et à la noix de coco', 'pomme, pâte brisée, noix de coco, oeuf, beurre, sucre en poudre, farine', '15 min', ['Pelez les pommes, coupez les en lamelles puis les installer sur la pâte brisée que vous aurez mise dans un moule à tarte. ', 'Mélanger l''oeuf avec le sucre, le beurre fondu, la noix de coco et enfin la farine. ', 'Recouvrez la tarte de cette préparation. ', 'Cuire le tout à four chaud (210°C) pendant 40 min environ.'], ['Ouvre-boîte', 'Râpe', 'Tire-bouchon'], ['recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'oeuf', 'Tarte aux pommes et à la noix de coco', 'pâte brisée', 'recette', 'sucre en poudre', 'tarte aux pommes', 'cuisine', 'noix de coco', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'farine'], 'Dessert', 7927dac1-14f4-4ee5-8fdd-093718f0f3db, '2025-09-26T15:27:08.591926', [{'ingredient_id': 'e7f6b37c-2d01-4173-9210-bfda5f9b3296', 'quantite': '4'}, {'ingredient_id': '5055fa53-a492-4654-b2bc-c08c885a05c4', 'quantite': '1'}, {'ingredient_id': 'd0203564-f678-4fb8-ba39-0238b417bf39', 'quantite': '100 g'}, {'ingredient_id': 'a4d46cb9-edc7-4c79-b4fe-a720ba9a1e49', 'quantite': '1'}, {'ingredient_id': '884bb3bd-af83-4c19-bc70-40d06d29151d', 'quantite': '50 g'}, {'ingredient_id': '39fb357e-40ad-4e04-af59-3da25fab23f8', 'quantite': '100 g'}, {'ingredient_id': '06d130bf-21d5-4449-b263-18c2f115f929', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36555, 'Chorizo aux pommes de terres', 'chorizo, pomme de terre, oignon', '15 min', ['Couper le chorizo en tranches très épaisses. Eplucher les pommes de terres les lavez et les couper en gros morceaux. Couper l''oignon en fine rondelles.', 'Faire fondre l''oignon dans un casserole. Mettre les pommes de terre et le chorizo dans un faitout, recouvrir d''eau, saler et porter à ébullition.', 'Lorsque cela bout, mettre les oignons, baisser le feu et couvrir. Laisser cuire pendant 30 minutes. Surveiller la cuisson pour que cela ne manque pas d''eau, mais aussi pour découvrir s''il y a trop d''eau.', 'Lorsque l''eau de cuisson s''épaissit, c''est prêt. Moins il y a d''eau, plus on se rapproche de la purée.', 'C''est facile et pas cher!'], ['Presse-agrumes', 'Balance de cuisine', 'Planche à découper'], ['', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'chorizo', 'oignon', 'recette', 'cuisine', 'testées', 'Chorizo aux pommes de terres', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'pomme de terre', 'confiserie'], 'Plat principal', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:27:15.334005', [{'ingredient_id': 'c0e6f543-019f-49f7-aef8-781df2a91354', 'quantite': '1'}, {'ingredient_id': '6fffd259-2c58-4081-82f0-27d52b229014', 'quantite': '10'}, {'ingredient_id': '17facce4-db7d-459f-b0ff-1ed7a3f7a4e9', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (230015, 'Cheesecake chocolat blanc framboises', 'fromage blanc, chocolat blanc, crème fraîche épaisse, oeuf, sucre roux, maïzena, spéculoos, beurre, framboises, coulis de fruits rouges, eau, agar-agar', '40 min', ['Préchauffer le four à 170°C (thermostat 5-6).', 'Dans une casserole à feu très doux verser la crème fraîche et casser le chocolat dedans. Mélanger sans arrêt (pour éviter que ça brûle) jusqu''à ce que le chocolat soit fondu puis retirer du feu. Laisser de côté.', 'Préparer un moule à manqué de 26 cm en tapissant le fond de papier cuisson. Dans un récipient réduire en miette/poudre les spéculoos soit en les écrasant avec un cuillère en bois ou en les passant dans un robot. Faire fondre le beurre et le mélange aux spéculoos. Tapissier le fond du moule avec ce mélange en aplatissant bien et égaliser avec une cuillère, mettre le plat au frigo le temps de la préparation du reste du gâteau.', 'Dans un récipient verser le fromage blanc avec le sucre roux et mélanger au batteur en ajoutant un à un les oeufs. Ajouter au mélanger la maïzena. Le mélange doit être lisse. Ajouter ensuite le mélange de crème fraîche chocolat blanc.', 'Sortir le moule du frigo et verser la moitié de la préparation dessus, répartir 2/3 des framboises (vous pouvez verser du coulis de fruits rouges ou framboises avec une cuillère sur la préparation mais ça reste facultatif).', 'Verser ensuite le reste de la préparation et ajouter dessus le reste des framboises. Avec les doigts, les enfoncer sous la préparation.', 'Enfourner le cheesecake pendant 1H à 170°C.', 'Surveiller le cheesecake. Il doit rester un peu comme un flan en fin de cuisson. Éteindre le four et laisser le gâteau 1H au chaud dedans.', 'Réserver le cheesecake au frigo au moins 6H. Il sera meilleur.', 'Faire chauffer dans une casserole le coulis de framboise additionné d''eau, ajouter le agar-agar. Porter à ébullition pendant 3 minutes tout en remuant.', 'Verser le nappage sur le cheesecake, décorer de quelques framboises et laisser refroidir.'], ['Passoire', 'Verre doseur', 'Couteau de chef', 'Tire-bouchon', 'Spatule'], ['moyenne', 'cheesecake', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'chocolat blanc', 'fromage blanc', 'oeuf', 'Cheesecake chocolat blanc framboises', 'maïzena', 'framboises', 'moyen', 'recette', 'crème fraîche épaisse', 'cuisine', 'sucre roux', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'spéculoos'], 'Dessert', 490cc1c1-50d2-41cc-b74d-d07698e95842, '2025-09-26T15:27:18.904963', [{'ingredient_id': 'ccfd3b7b-45b2-4841-9186-1c3f426e18a1', 'quantite': '600 g'}, {'ingredient_id': '00855c57-8340-4e35-b3bb-8eb587813971', 'quantite': '300 g'}, {'ingredient_id': 'bdab2477-97b5-41ed-8d99-13aada8f85c2', 'quantite': '300 g'}, {'ingredient_id': '0d4a3497-9c79-4d54-ad26-864bddb0ec1c', 'quantite': '3'}, {'ingredient_id': '179b4e55-7532-40cc-94c3-d5c399fe9519', 'quantite': '1 cuillères'}, {'ingredient_id': 'a222f609-01b4-48f1-b75c-0e08352f0d36', 'quantite': '1 cuillères'}, {'ingredient_id': '37f91761-3c7e-4986-8a8f-9dad0405c810', 'quantite': '500 g'}, {'ingredient_id': '52674460-f13e-4364-a43d-6ece94c75cdd', 'quantite': '60 g'}, {'ingredient_id': 'a3120ddb-ff63-4dbc-8ba7-c4e03a1f28a3', 'quantite': '300 g'}, {'ingredient_id': '2cdfaf8c-bc63-451f-898a-3de4ada66089', 'quantite': '150 g'}, {'ingredient_id': '03a95deb-7b32-4581-8b81-49e7445a85bd', 'quantite': '50'}, {'ingredient_id': '21a4e89f-1a1c-4d36-8bf9-57f436a0e3b0', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15286, 'Confiture de potiron et de pommes', 'potiron, pomme, sucre, vanille', '45 min', ['Couper le potiron en morceaux après l''avoir épluché et mettre à cuire à l''eau bouillante environ 15 mn.', 'Cuire également les pommes épluchées et coupées en quartier.', 'Mélanger le tout et passer au mixer.', 'Mettre le  sucre et le mélange pommes-potiron dans une bassine à confiture et porter à ébullition. Bien mélanger pendant la cuisson (environ 30 minutes).', 'La confiture est prête à être mise en pots lorsque quelques gouttes de confiture se solidifient rapidement sur une assiettre froide.', 'Mettre en pots et déguster.'], ['Moule à tarte', 'Louche', 'Verre doseur', 'Ouvre-boîte'], ['', 'facile', 'recettes de cuisine', 'plat', 'cocktail', 'Confiture de potiron et de pommes', 'vanille', 'sucre', 'plat de résistance', 'potiron', 'bon marché', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme'], 'Confiserie', eb57388b-567a-4ee9-93bb-821452ec6863, '2025-09-26T15:27:25.526500', [{'ingredient_id': '571bb14b-77d9-4adc-85ef-cbd454d96771', 'quantite': '2 kg'}, {'ingredient_id': '41d42244-a314-4631-810f-84010d2bb9f6', 'quantite': '1 kg'}, {'ingredient_id': '9983c33d-8047-4e27-afc4-3fa526a010be', 'quantite': '3 kg'}, {'ingredient_id': '4932e32a-599e-4f46-b684-397c6cfe3a23', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (325186, 'Gâteau magique au chocolat blanc et framboises', 'oeuf, sucre, eau, beurre, chocolat blanc, farine, lait, framboises', '30 min', ['Préchauffez votre four à 150°C (thermostat 5).', 'Faites fondre le beurre avec le chocolat environ 2 min au micro ondes.', 'Mélangez le sucre à avec les jaunes d''oeuf et l''eau, ajoutez-y le beurre et le chocolat fondu puis la farine, mélangez bien.', 'Versez le lait tiède puis les blancs montés en neige.', 'Beurrez un moule a manqué, déposer-y les framboises, versez la préparation et enfourner pendant 50 minutes.', 'Laissez refroidir puis mettre le gâteau au réfrigérateur.', 'Servir très froid.', 'Vous obtenez un gâteau avec trois textures différentes : biscuit flan crème.'], ['Économe', 'Fouet', 'Couteau de chef', 'Louche', 'Tire-bouchon'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'gâteau au chocolat', 'sucre', 'eau', 'plat de résistance', 'chocolat blanc', 'bon marché', 'oeuf', 'framboises', 'recette', 'cuisine', 'lait', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'Gâteau magique au chocolat blanc et framboises', 'farine'], 'Dessert', 91abecca-0347-41c5-a14b-afbacbd002fd, '2025-09-26T15:27:32.460173', [{'ingredient_id': '87d128fa-1029-487e-83ef-2dd8987c513d', 'quantite': '4'}, {'ingredient_id': 'a16de63e-6d03-44a8-a81a-62508b01fdd6', 'quantite': '150 g'}, {'ingredient_id': '191c2eae-1a50-44db-a0e4-4e200e830a22', 'quantite': '1 cuillères'}, {'ingredient_id': 'ce0d4117-5800-40a2-827f-da148ecad399', 'quantite': '125 g'}, {'ingredient_id': 'd92b6f13-0762-46fb-a910-bf018fbef281', 'quantite': '200 g'}, {'ingredient_id': '5c9e46cf-dc39-4db9-877f-21a0093f28d3', 'quantite': '115 g'}, {'ingredient_id': '2587d291-9b98-436e-bb77-2d6b72f15d95', 'quantite': '50 cl'}, {'ingredient_id': '744c2c0f-a6b0-4215-9184-5fe05410c674', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (313814, 'Bûche de noël à la mousse de framboise et de mangue', 'framboises, sucre semoule, gélatine, poudre de noisette, amandes, blanc d''oeuf, sucre semoule, framboises, fromage blanc, crème fraîche, oeuf, sucre, gélatine, mangue, fromage blanc, crème fraîche, oeuf, sucre vanillé, gélatine, chocolat pâtissier, framboises, mangue', '150 min', ['Le gélifié de framboises : ', 'Découper une feuille de rhodoïd de la taille du moule à bûche (sur la hauteur et la longueur). Mettre les framboises surgelées dans une casserole avec le sucre. Laisser cuire 15 min tout en remuant afin d''obtenir une purée. Ajouter les feuilles de gélatine préalablement ramollie dans l''eau froide et bien essorées. Remuer pour bien dissoudre la gélatine. Passer au mixeur puis au chinois pour éliminer les graines. Laisser refroidir.', 'Lorsque le gélifié de framboises est pratiquement refroidi, l''étaler sur la feuille de rhodoïd en mettant une couche régulière de quelques millimètres d’épaisseur. Poser à plat au réfrigérateur. Lorsque le coulis est bien figée, prendre délicatement la feuille de rhodoïd et la poser dans le fond du moule à bûche (face rhodoïd sur le fond du moule). Réserver.', 'La dacquoise : ', 'Préchauffez votre four à 180°C. Préparer une plaque à pâtisserie de 40 x 30 cm en la couvrant de papier cuisson. Monter les blancs en neige avec un peu de sucre. Lorsque les blancs sont bien fermes, ajouter le reste de sucre et battre encore. A l’aide d’une spatule, incorporer délicatement les poudres d’amandes et de noisettes.', 'Remplir une poche à douille large de ce mélange. Former des bandes larges et serrées du mélange sur le papier cuisson, sur la plaque. Enfourner 15 à 20 minutes, en tournant à mi-cuisson.Laisser refroidir  avant de s''en servir. Retirer délicatement le papier cuisson. Découper 2 rectangles de la taille du moule (un légèrement plus petit).', 'La mousse de framboises : ', 'Faire cuire les framboises avec un peu d''eau jusqu''à l''obtention d''une purée. Y ajouter les feuilles de gélatine préalablement trempées dans l''eau froide puis mixer et passer au chinois pour ôter les graines.', 'Mélanger le fromage blanc, le jaune d’œuf, la crème fraîche, le sucre et la purée de framboise puis incorporer les blancs en neige.', 'La mousse de mangue : ', 'Mixer les mangues et faire chauffer le coulis. Ajouter les feuilles de gélatine préalablement ramollie dans l’eau froide et bien essorées.', 'Mélanger le fromage blanc, le jaune d’œuf, la crème fraîche, le sucre, la purée de mangue puis incorporer les blancs en neige.', 'Montage : ', 'Sur le coulis gélifié préalablement positionné dans le moule, verser la mousse de framboises, puis mettre le rectangle de dacquoise (le plus petit des 2) puis la mousse de mangue et enfin le rectangle de dacquoise.', 'Laisser reposer 1H au congélateur puis au moins 4H au réfrigérateur. Au bout ce temps minimum on peut démouler avec précaution la bûche. Très délicatement, ôter la feuille de rhodoïd en prenant bien soin de ne pas casser le gélifié de framboises.', 'Décor : ', 'Pour la dentelle en chocolat, faire fondre le chocolat au bain-marie puis à l’aide d’une seringue ou d’une poche à douille fine, faire des dessins sur une feuille rhodoïd. Laisser refroidir un peu puis lorsque le chocolat est encore souple, lui donner la forme désirée (tube…).'], ['Batteur électrique', 'Ouvre-boîte', 'Balance de cuisine', 'Économe', 'Verre doseur'], ['moyenne', 'recettes de cuisine', 'plat', 'cocktail', 'gélatine', 'plat de résistance', 'bon marché', 'framboises', 'Bûche de noël à la mousse de framboise et de mangue', 'recette', 'cuisine', 'testées', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'sucre semoule', 'bûche framboise'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:27:36.119791', [{'ingredient_id': 'b4e912ce-09a3-4ca2-938b-1081e3e550ae', 'quantite': '300 g'}, {'ingredient_id': 'aca3103e-e741-46c0-b09f-208791b3aad6', 'quantite': '75 g'}, {'ingredient_id': '4591bb1d-b646-46f2-84f4-b4d7d38c451e', 'quantite': '3'}, {'ingredient_id': 'ddb4e53f-89bd-46d3-b9cf-315921692af2', 'quantite': '35 g'}, {'ingredient_id': '274425e4-ef55-40f7-ad2e-ba8aa0006bfa', 'quantite': '115 g'}, {'ingredient_id': '0ef5d583-d6ad-4162-bb0b-5a7aeaeb5b04', 'quantite': '150 g'}, {'ingredient_id': 'f47432a2-d506-4db7-8a23-b926dfe5a950', 'quantite': '140 g'}, {'ingredient_id': '40d45ec5-0e24-4ee7-ba42-ef344b15ccdc', 'quantite': '250 g'}, {'ingredient_id': '26d9b371-8618-4632-ae0f-0ad041849a7a', 'quantite': '125 g'}, {'ingredient_id': '30ace2ee-a669-442b-9c23-456770b5fbcd', 'quantite': '10 cuillères'}, {'ingredient_id': '6671d759-ad5f-463f-8a5d-d0b5613af6d0', 'quantite': '1'}, {'ingredient_id': '1d795f0b-8540-4581-a09b-05123e3d5952', 'quantite': '50 g'}, {'ingredient_id': '8643d417-6bfd-4fa7-95cb-c967cd2de9aa', 'quantite': '2.5'}, {'ingredient_id': '433c69c6-848d-44e5-a674-527fc19d1945', 'quantite': '250 g'}, {'ingredient_id': '29d41721-5ac3-4263-8e2d-9fe9c13f972d', 'quantite': '125 g'}, {'ingredient_id': '117fbd8d-a7b4-4617-8d65-b907a1a95b3f', 'quantite': '10 cl'}, {'ingredient_id': '5ab4b6b6-6eaa-403a-a3e5-4b480be0c27d', 'quantite': '1'}, {'ingredient_id': '6082f331-c024-4abf-9002-cc16b502ef1d', 'quantite': '1'}, {'ingredient_id': '5a1d3e26-49c0-4bd1-92a7-6886cdc0ac3f', 'quantite': '3'}, {'ingredient_id': '84bfbbb9-3931-464a-b6f1-3149a19eb22e', 'quantite': ''}, {'ingredient_id': 'e3df29c6-0d3f-4355-87d0-21c7f1155d67', 'quantite': ''}, {'ingredient_id': '331cf1b8-d8c3-4df2-a7b8-d3b3c31f83ed', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22075, 'Charlotte aux fraises', 'fraises, boudoir, Gervita, sucre, alcool pour fruits', '15 min', ['Prévoir du film alimentaire et un moule à charlotte ou à soufflé.', 'Equeutez les fraises, coupez- les en grands morceaux. ', 'Placez le film plastique dans le moule en en laissant déborder largement. ', 'Faire fondre le sucre dans de l''eau ou diluez l''alcool, puis faire passer rapidement les biscuits sur les deux faces dans la dilution ; placez les biscuits dans le fond et sur les bords du moule. Mettre très peu de sucre dans le Gervita. mettez une couche de Gervita, une couche de fraises, quelques biscuits. Recommencez.', 'Mettre au frigidaire. Servir frais.'], ['Spatule', 'Tire-bouchon', 'Couteau de chef', 'Louche'], ['recettes de cuisine', 'plat', 'cocktail', 'sucre', 'charlotte aux fraises', 'Gervita', 'alcool pour fruits', 'plat de résistance', 'bon marché', 'Charlotte aux fraises', 'rapide', 'recette', 'boudoir', 'fraises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Dessert', 3140b1c4-19ea-41fb-8c41-f31280011a09, '2025-09-26T15:27:42.876654', [{'ingredient_id': 'def5a1d6-04a5-4ff3-99cc-5f0d9126a64a', 'quantite': '500 g'}, {'ingredient_id': 'cb43d7c1-1c82-4ad9-bb86-096b4e7884d9', 'quantite': '30'}, {'ingredient_id': '3161da71-9028-4fc5-b327-9dd6cd443b80', 'quantite': '5'}, {'ingredient_id': '2298eb06-5227-4b12-b88e-e13143430ee8', 'quantite': ''}, {'ingredient_id': '5875366a-bc73-42cd-88fa-01a2e0f7b8d6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (344021, 'Detox Water fraise concombre', 'concombre, fraises, menthe, eau', '5 min', ['Laver et couper les fraises en morceaux, le concombre en rondelles et ajouter quelques feuilles de menthe dans l''eau. Laisser macérer au moins 20 minutes pour parfumer l''eau, voir quelques heures au frais.', 'Succès assuré.'], ['Passoire', 'Moule à tarte'], ['detow water', 'recettes de cuisine', 'plat', 'cocktail', 'menthe', 'eau', 'plat de résistance', 'Detox Water fraise concombre', 'bon marché', 'rapide', 'recette', 'fraises', 'cuisine', 'concombre', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie'], 'Boisson', 25791c7c-84fa-4376-b73d-1ea47675df65, '2025-09-26T15:27:46.408392', [{'ingredient_id': '0e889dcb-9702-441d-862a-cd9fb08434aa', 'quantite': '1'}, {'ingredient_id': '0b8ac524-9657-4895-ba57-1908cbe78231', 'quantite': '500 g'}, {'ingredient_id': '55efb6d9-5030-4d5c-bffd-f7ce95901103', 'quantite': '1'}, {'ingredient_id': 'cf0ee731-fc82-42d0-974b-ee6b8a3b56e8', 'quantite': '50 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (71350, 'Gâteau pommes kiwi', 'sucre, sucre vanillé, oeuf, levure, farine, huile, pomme, kiwi', '15 min', ['Préchauffer votre four à 180°, thermostat 6.', 'Mélanger les oeufs avec les sucres. Ajouter la farine et la levure, bien mélanger, puis mettre l''huile.', 'Eplucher et couper les fruits en petits morceaux et les mettre dans la pâte. ', 'Beurrer un moule à manqué et verser la préparation.', 'Laisser cuire environ 30 min, voire plus, tout dépend des fours.'], ['Casserole', 'Couteau de chef', 'Moule à tarte'], ['sucre vanillé', 'gâteau aux pommes', 'recettes de cuisine', 'plat', 'kiwi', 'cocktail', 'sucre', 'plat de résistance', 'Gâteau pommes kiwi', 'bon marché', 'oeuf', 'levure', 'recette', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme', 'huile', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:27:52.297039', [{'ingredient_id': '6f4225fa-dca2-425a-8b21-0f40a87e7592', 'quantite': '100 g'}, {'ingredient_id': 'aa2eb938-d953-4788-aec6-4bfc9a7826a9', 'quantite': '1'}, {'ingredient_id': '2fa0d922-66d3-4bf4-974f-2117761fd36e', 'quantite': '3'}, {'ingredient_id': 'b6c7f913-ab18-4c56-9b93-4c1cb5ba7935', 'quantite': ''}, {'ingredient_id': 'dc002359-9807-4f5d-8d92-8f48213c2e23', 'quantite': '125 g'}, {'ingredient_id': 'ce04421a-fd17-4443-bd44-05b8585e0873', 'quantite': ''}, {'ingredient_id': 'c7c32dc6-ddaa-4f88-84f4-915cc26ae78e', 'quantite': '2'}, {'ingredient_id': 'f6e8a23c-e110-49f4-a1d8-533bc5af4b80', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (39814, 'Confiture de fraises et poires vanillées', 'fraises, poire, jus de citron, sucre, vanille', '20 min', ['1 nuit de macération est nécessaire pour cette recette.', 'Équeuter les fraises, et les couper en morceaux.', 'Peler les poires, et les couper en petits morceaux.', 'Mettre tous les fruits à macérer, pendant une nuit, avec le jus de citron, le sucre et la vanille égrenée (laisser la gousse, dans les fruits, pendant la macération).', 'Le lendemain, verser le tout dans un faitout adéquat. ', 'Faire cuire au moins 20 min. ', 'Vérifier la cuisson, en mettant une petite assiette au congélateur. Pour savoir si la confiture est cuite, mettre une goutte sur l''assiette sortie du congélateur. La confiture est prise, si la goutte se fige.', 'Mettre directement en pots.'], ['Verre doseur', 'Fouet', 'Économe', 'Pince de cuisine', 'Tire-bouchon'], ['Confiture de fraises et poires vanillées', 'recettes de cuisine', 'plat', 'cocktail', 'vanille', 'sucre', 'plat de résistance', 'moyen', 'recette', 'fraises', 'cuisine', 'confiture de fraise', 'jus de citron', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'poire', 'confiserie'], 'Confiserie', 7509cc5d-993c-4f3f-a419-3243c980883c, '2025-09-26T15:27:55.912846', [{'ingredient_id': '4d47e499-cb4d-4dea-9ec8-a1b4e8211429', 'quantite': '500 g'}, {'ingredient_id': '6d3a30df-5c3d-4ea5-9773-9f807a176a23', 'quantite': '500 g'}, {'ingredient_id': 'bca55439-3b13-49a9-b804-ac7818d95908', 'quantite': '1'}, {'ingredient_id': 'e6591120-0356-4784-bac5-93403ee0c79a', 'quantite': '700 g'}, {'ingredient_id': '67a9830a-30ee-4e9c-bdfa-f97a83c40771', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31434, 'Cake pomme - banane moelleux', 'beurre, sucre, farine, oeuf, levure chimique, pomme, banane', '15 min', ['Mélanger tous les ingrédients dans l''ordre : beurre (fondu), sucre, oeufs, farine, levure, fruits (coupés en petits morceaux). ', 'Mettre dans un moule à cake, cuire à Th 6 (180°C), entre 40 min et 1 h selon le four. ', 'Variante : ', 'Pour un cake croquant, remplacer les fruits par 3 bananes et 100 g de noix concassées (en gros morceaux). ', 'Ou encore par pommes + bananes + noix, dans les quantités que l''on veut.'], ['Économe', 'Mixeur', 'Couteau de chef'], ['autres cakes', 'recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'sucre', 'plat de résistance', 'banane', 'bon marché', 'oeuf', 'recette', 'cuisine', 'Cake pomme - banane moelleux', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'pomme', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:28:02.707553', [{'ingredient_id': '990bba56-a6cd-4079-b9c2-b9bcc82d4b8d', 'quantite': '75 g'}, {'ingredient_id': '1423ae2e-5138-4e23-935c-4aee375e6069', 'quantite': '125 g'}, {'ingredient_id': '895332e1-ab7e-42fb-9c27-1c4d77d74ff5', 'quantite': '250 g'}, {'ingredient_id': '0e15fc88-b031-498b-8c61-2343dd09630f', 'quantite': '2'}, {'ingredient_id': 'c94087f4-748b-4813-9a0f-5f97e79eec64', 'quantite': '1'}, {'ingredient_id': 'c7bcee41-89e7-4d86-acf8-4f4845362d44', 'quantite': '2'}, {'ingredient_id': 'fece81af-d9aa-4b5f-911a-165cc3241993', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13493, 'Gâteau aux pommes facile', 'sucre semoule, sucre vanillé, oeuf, levure chimique, farine, huile de colza, pomme', '10 min', ['Préchauffer le four à 160°C (thermostat 5-6).
Mélanger tous les ingrédients de la pâte.', 'Ajouter les pommes préalablement coupées en cube.', 'Mélanger à nouveau à la spatule.', 'Verser la pâte à gâteau dans un moule beurré et cuire pendant 40 à 50 minutes.', 'Déguster !'], ['Moule à tarte', 'Passoire', 'Spatule', 'Louche', 'Casserole'], ['sucre vanillé', 'gâteau aux pommes', 'recettes de cuisine', 'plat', 'cocktail', 'levure chimique', 'Gâteau aux pommes facile', 'plat de résistance', 'bon marché', 'oeuf', 'huile de colza', 'recette', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'confiserie', 'pomme', 'sucre semoule', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:28:09.235529', [{'ingredient_id': '19fe2c4d-b0ec-4225-82cf-f7c8c4116071', 'quantite': '120 g'}, {'ingredient_id': '020ac547-6dee-4181-aaa1-6a5ac31e27a4', 'quantite': '1'}, {'ingredient_id': 'b2d7b77c-4acd-4a24-9302-1781295cd2b6', 'quantite': '3'}, {'ingredient_id': 'd45df331-516c-49db-a51c-91d05180d4f3', 'quantite': ''}, {'ingredient_id': '7178e8ea-9994-454e-ab70-335711240616', 'quantite': '125 g'}, {'ingredient_id': '3234d99f-aa20-4bd2-934d-c1eceb1ce9fc', 'quantite': ''}, {'ingredient_id': 'e1637769-bb80-44cd-84cb-57dda7ab6a03', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (83823, 'Tarte nuage aux fraises', 'pâte brisée, mascarpone, sucre, sucre vanillé, fraises', '10 min', ['Dérouler la pâte sur une plaque de cuisson, faire des trous a la fourchette et faire cuire selon les indications mentionnées sur le paquet.', 'Pendant ce temps, laver rapidement les fraises sous l''eau froide puis les équeuter en conservant une base plate. Les garder entières.', 'Sortir la pâte du four et la laisser refroidir.', 'Battre le mascarpone avec le sucre et le sucre vanillé, jusqu''à l''obtention d''une mousse. La repartir sur le fond de tarte.', 'Disposer les fraises en rosace.'], ['Couteau de chef', 'Passoire', 'Tire-bouchon', 'Rouleau à pâtisserie', 'Presse-agrumes'], ['sucre vanillé', 'recettes de cuisine', 'Tarte nuage aux fraises', 'plat', 'cocktail', 'sucre', 'plat de résistance', 'tarte aux fraises', 'pâte brisée', 'moyen', 'recette', 'fraises', 'cuisine', 'testées', 'très facile', 'entrée', 'dessert', 'boisson', 'recettes', 'mascarpone', 'confiserie'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:28:16.062124', [{'ingredient_id': 'cfcaa182-17e6-47f5-a02e-2a8a82ef8078', 'quantite': '1'}, {'ingredient_id': '791db875-c8c8-4108-b17a-14b501e7243d', 'quantite': '250 g'}, {'ingredient_id': '934e35d3-4cc9-4dce-894a-855afeb40a0d', 'quantite': '3 cuillères'}, {'ingredient_id': '6bf8cbad-b249-4663-bb25-a9a0344098af', 'quantite': '1'}, {'ingredient_id': '0321dfac-1ea1-4ae6-8567-8cef98a3f184', 'quantite': '250 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37128, 'Tarte crumble aux pommes', 'pâte brisée, compote, pomme, farine, beurre, cassonade, sel', '15 min', ['Etaler la pâte à tarte dans un moule, napper le fond de compote de pommes, couper les pommes en rondelles ou en petits dés et les disposer sur la compote.', 'Mélanger dans un saladier assez profond la farine, le beurre, la cassonade et le sel (avec vos mains) de facon à obtenir une préparation qui ressemble à du "sable".', 'Recouvrir la tarte aux pommes avec la pâte à crumble et enfourner environ 30 min à 180°C (thermostat 6).'], ['Spatule', 'Casserole', 'Presse-agrumes', 'Passoire'], ['facile', 'cassonade', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'bon marché', 'pâte brisée', 'sel', 'recette', 'tarte aux pommes', 'cuisine', 'testées', 'compote', 'dessert', 'entrée', 'boisson', 'recettes', 'Tarte crumble aux pommes', 'beurre', 'confiserie', 'pomme', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:28:22.781941', [{'ingredient_id': '36c4b69a-bc82-477a-83f9-29efa979f977', 'quantite': '1'}, {'ingredient_id': '543a0be0-23f9-49ce-9dc9-3013fa6327b6', 'quantite': '1'}, {'ingredient_id': '908983d8-857f-4642-a04c-b707f138001c', 'quantite': '3'}, {'ingredient_id': '54377296-48a3-4a26-a04f-1b6199ff3a9c', 'quantite': '150 g'}, {'ingredient_id': '57937463-a0bf-476b-8cf7-1e812363a3af', 'quantite': '80 g'}, {'ingredient_id': '599bc726-d5f7-412e-bb3a-43a495ea7dc7', 'quantite': '80 g'}, {'ingredient_id': '129d9f7c-4e66-475e-bf78-6a41c1651440', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (229810, 'Financiers aux framboises', 'beurre, farine, amandes en poudre, poudre de noisette, sucre glace, blanc d''oeuf, framboises', '15 min', ['Préchauffez votre four à 200°C (thermostat 6-7).', 'Faites fondre le beurre puis laissez-le refroidir.', 'Dans un saladier, mélangez la farine tamisée avec la poudre d’amandes et celle de noisettes (il est tout à fait possible de remplacer la poudre de noisette par 40 g de poudre d’amandes, et vice-versa) et le sucre glace. ', 'Ajoutez les 4 blancs d’œufs, puis mélangez. ', 'Versez-y le beurre fondu puis mélangez de nouveau afin d’obtenir une pâte homogène.', 'Dans de petits moules en silicone, incorporez votre pâte jusqu’au 3/4 du moule, puis ajoutez-y sur chaque financiers une framboise.', 'Baissez votre four à 180°C (thermostat 6) puis laissez cuire pendant 20 min.', 'Conseil : vos financiers seront parfaitement cuits lorsque leurs bords seront dorés.', 'Bonne dégustation !'], ['Presse-agrumes', 'Mixeur', 'Moule à tarte', 'Râpe'], ['facile', 'recettes de cuisine', 'plat', 'cocktail', 'plat de résistance', 'financiers', 'bon marché', 'framboises', 'recette', 'Financiers aux framboises', 'cuisine', 'blanc d''oeuf', 'testées', 'sucre glace', 'poudre de noisette', 'entrée', 'dessert', 'boisson', 'recettes', 'beurre', 'confiserie', 'amandes en poudre', 'farine'], 'Dessert', b85fa9f6-5bce-4367-ab89-689e0c84299b, '2025-09-26T15:28:27.670423', [{'ingredient_id': '8c5a9692-c214-4f01-9ec9-715f32855676', 'quantite': '100 g'}, {'ingredient_id': 'e84f75b1-e074-498d-aed3-0328a69981cb', 'quantite': '60 g'}, {'ingredient_id': '80c0ee77-17bf-4789-8310-037e687243e8', 'quantite': '40 g'}, {'ingredient_id': '36670d1c-227c-4579-82d4-c1f046e08694', 'quantite': '40 g'}, {'ingredient_id': '1df12b77-32b1-4a63-9c75-e1f3ad4dadf8', 'quantite': '150 g'}, {'ingredient_id': '35b28bc3-fe3f-4abe-9861-8cd26e9bb9ca', 'quantite': '4'}, {'ingredient_id': '8062f8c7-73ee-4160-8d07-5558d70c9df3', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28300, 'Coupe de yaourt et mascarpone aux fruits', 'yaourt, mascarpone, sucre semoule, vanille, kiwi, pomme, banane, citron, sucre glace', '15 min', ['Mélangez les yaourts avec le Mascarpone, le sucre, l''essence de vanille dans un saladier. Travaillez au fouet électrique de façon à avoir une préparation onctueuse. Répartissez cette crème dans de beaux verres évasés ou dans des coupes. Mettez-les au réfrigérateur. ', 'Pelez le kiwi, coupez-le en petits morceaux. Pelez la pomme et taillez-la en petits dés. Epluchez la banane et découpez-la en fines rondelles. ', 'Mélangez les fruits dans une jatte, arrosez-les de jus de citron, saupoudrez de sucre glace et remuez délicatement. Mettez-les au frais. ', 'Juste au moment de servir, répartissez la salade de fruits dans les coupes.'], ['Batteur électrique', 'Râpe', 'Mixeur'], ['', 'entrée', 'banane', 'kiwi', 'mascarpone', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'Coupe de yaourt et mascarpone aux fruits', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'pomme', 'citron', 'sucre glace', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:11:47.699791', [{'ingredient_id': '63954500-652c-4eae-b23c-bf4d323384e4', 'quantite': '3'}, {'ingredient_id': '121a20f3-0c88-47db-9568-359aa5cded54', 'quantite': '200 g'}, {'ingredient_id': 'ce941dca-21a0-488c-a3a8-f6fad17cc785', 'quantite': '60 g'}, {'ingredient_id': '44d6a2ac-f675-4c49-93bf-6fa472c4b3ae', 'quantite': ''}, {'ingredient_id': '1f16e4ed-1a45-4d59-a527-fb53b6c9475d', 'quantite': '1'}, {'ingredient_id': '2c9d713e-5826-4bd4-8c31-7b02853bb58d', 'quantite': '1'}, {'ingredient_id': 'ae92cc72-4c55-48ab-bd00-307fcfc7dfe1', 'quantite': '1'}, {'ingredient_id': '3a09c5d3-db84-4c10-a749-25d0d41ce5fd', 'quantite': '1'}, {'ingredient_id': '8882c3ee-050d-4fbf-b49f-fa0170e3848e', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70886, 'Compote de rhubarbe multifruits', 'rhubarbe, pomme, sucre de canne, banane, citron, gingembre, eau', '600 min', ['Eplucher les pommes et les tiges de rhubarbe, les couper en petits cubes.', 'Les mettre dans un récipient avec le sucre et le jus de citron, mélanger et laisser " mariner " 8 à 10 heures.', 'Au moment de la cuisson, y ajouter le gingembre coupé en petits cubes, la banane détaillée en rondelles et l''eau.', 'Faire cuire à feu moyen en remuant pendant 5 minutes.', 'Déguster chaude ou froide.'], ['Balance de cuisine', 'Ouvre-boîte', 'Planche à découper', 'Mixeur', 'Verre doseur'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'rhubarbe', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'compote', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'dessert', 'Compote de rhubarbe multifruits', 'plat de résistance', 'pomme', 'citron', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:11:51.672513', [{'ingredient_id': '30075fcc-04a8-4979-b083-7de9de951807', 'quantite': '6'}, {'ingredient_id': '1b9ad845-b664-4158-b9dd-20df129c0b6b', 'quantite': '4'}, {'ingredient_id': '8639f755-b13e-4cd0-8e26-d3d968b42cfa', 'quantite': '10'}, {'ingredient_id': 'c2476be3-084c-4aa5-acd8-dced985961c1', 'quantite': '1'}, {'ingredient_id': '5882b0c7-2a2a-4676-aaf7-a1a76f17c7c0', 'quantite': ''}, {'ingredient_id': '354b45ba-f19c-4336-8dcc-a59b8c2e5c13', 'quantite': '40 g'}, {'ingredient_id': '7dab0fef-5227-4f8b-94ee-eaea83a7f24b', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (19111, 'Jus Banane Avocat', 'banane, avocat, lait demi-écrémé, sucre', '5 min', ['Dans un blender : ', 'Y mettre les bananes, l''avocat en morceau, ajouter du sucre et un peu de lait pour former une purée. ', 'Mixer un peu. ', 'Rajouter peu à peu le lait, goûter si le sucre vous suffit. Servir 1 grand verre par personne. ', 'Néanmoins si vous voulez le conserver : pas plus de 2 jours et dans une bouteille qui ferme car le jus s''oxyde trés vite (mais c''est un vrai fortifiant les matins d''hiver)'], ['Planche à découper', 'Couteau de chef', 'Spatule', 'Balance de cuisine', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'avocat', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'lait demi-écrémé', 'sucre', 'Jus Banane Avocat', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:11:55.197498', [{'ingredient_id': '98b5a6ea-0617-454e-88ed-c4d605aa5c59', 'quantite': '2'}, {'ingredient_id': 'badc7cf5-3aa8-4cbe-b059-f2e1b5c11990', 'quantite': '1'}, {'ingredient_id': '7c26c39f-b01e-449f-ad2c-9c85e86b3c48', 'quantite': '1 l'}, {'ingredient_id': 'd609e910-ea58-4655-ab10-d608d515d18e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58917, 'Pizza sucrée fraise banane', 'pâte à pizza, fraises, banane, sucre en poudre, crème fraîche liquide', '15 min', ['Voici une pizza sucrée vraiment bonne :', 'on préchauffe le four, on déroule la pâte à pizza, on verse généreusement du sucre en poudre, on découpe des rondelles de banane, on lave et découpe en rondelles des fraises que l''on dispose sur la pâte...', 'Ensuite, on verse un peu de crème fraîche liquide et pour finir, on enfourne à 210°C (thermostat 7) environ.'], ['Moule à tarte', 'Mixeur', 'Tire-bouchon', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'fraises', 'sucre en poudre', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'pâte à pizza', 'boisson', 'dessert', 'Pizza sucrée fraise banane', 'plat de résistance', 'cocktail'], 'Dessert', 4fd3b86d-3877-4ace-853b-f3a9bc994dac, '2025-09-26T15:11:58.693707', [{'ingredient_id': 'fe84c220-dc47-4621-a029-eb87fe4e3fee', 'quantite': '1'}, {'ingredient_id': '6d6a2dc2-d4d6-46d9-8903-896cc41fd7ab', 'quantite': ''}, {'ingredient_id': '4316a73c-82d3-4756-88ff-b592292d37ef', 'quantite': ''}, {'ingredient_id': '11074ddf-5a0e-4d8e-877f-c23e69f329a6', 'quantite': '100 g'}, {'ingredient_id': '6f864b2e-7051-43e1-9195-ed2bf155437d', 'quantite': '15 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73586, 'Colombo de poulet et ses bananes plantains', 'escalope de poulet, banane plantain, huile, poivre, sel, thym, persil, poudre de colombo, ail, oignon, citron vert, cassonade', '20 min', ['1 - Préparation de la marinade: ', 'Dans un récipient creux, mélanger 4 cuillères à soupe d''huile végétale avec la moitié du mélange pour colombo, l''ail haché, le thym, le sel et le poivre. Y ajouter le poulet coupé en cubes et bien mélanger. Recouvrir avec du film étirable et laisser mariner pendant au moins 1 h au réfrigérateur. ', '2 - Préparation du Colombo: ', 'Dans un faitout, faire revenir la viande avec sa marinade pendant 5 min jusqu''à ce que les morceaux soient bien dorés. ', 'Mettre à feu doux et ajouter l''oignon émincé. Ajouter de l''eau jusqu''à bien recouvrir la viande. Rajouter l''autre moitié du mélange pour colombo et quelques cuillères à soupe de persil coupé finement. Couvrir et laisser mijoter pendant 20 min environ. Remuer et surveiller le niveau de l''eau régulièrement. ', 'Pendant ce temps, couper les extrémités des bananes plantains et faire une légère incision tout le long sans atteindre la pulpe. Les plonger 5 min dans de l''eau bouillante. Retirer la peau et couper les bananes en rondelles de 5 mm environ. Les replonger dans l''eau bouillante pendant 5 min encore. Egoutter. ', 'Dans une poêle, faire frire les rondelles de banane dans de l''huile jusqu''à ce qu''elles soient dorées (180° maxi). Mettre ensuite sur du papier absorbant. Assaisonner avec du sel ou du sucre cassonade pour un petit goût sucré-salé. ', 'Au dernier moment, ajouter le jus de citron vert au colombo de poulet et laisser mijoter 5 min. ', 'Servir avec les bananes plantains.'], ['Couteau de chef', 'Spatule', 'Poêle', 'Moule à tarte', 'Fouet'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'cassonade', 'cocktail', 'très facile', 'bon marché', 'curry de poulet', 'ail', 'plat', 'escalope de poulet', 'recette', 'Colombo de poulet et ses bananes plantains', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile', 'dessert', 'persil', 'plat de résistance', 'banane plantain', 'thym', 'citron vert', 'poivre', 'poudre de colombo'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:12:02.269667', [{'ingredient_id': '8cdc1e49-950f-41b9-b4d5-d9cefffce15f', 'quantite': '250 g'}, {'ingredient_id': 'f931049d-dc53-45a1-bfc5-47a94c3c9a3a', 'quantite': '2'}, {'ingredient_id': '5fd5dd38-6978-4392-a420-4abe9113d209', 'quantite': ''}, {'ingredient_id': '3159566b-c333-485b-87dd-a1e3985b1470', 'quantite': ''}, {'ingredient_id': '9eb81216-16bd-4f6f-bb0a-16c88b9e78dc', 'quantite': ''}, {'ingredient_id': '5948192e-14ba-4f84-8e6d-965d8a08dcfc', 'quantite': ''}, {'ingredient_id': '55c7b537-e830-47cd-a410-1c19b2ebe55e', 'quantite': ''}, {'ingredient_id': 'ae2e7a38-fff5-4001-9a12-4c1f522ef5eb', 'quantite': '25 g'}, {'ingredient_id': '09512a92-40e0-44a5-9413-aa47056f6237', 'quantite': '2'}, {'ingredient_id': 'f75253f0-2f7c-46bf-b0e3-4af2b87bbc48', 'quantite': '1'}, {'ingredient_id': '029b315e-2eb8-4043-80fa-565f1b1fa6c9', 'quantite': '1'}, {'ingredient_id': '74a7a55d-2796-443a-bc4a-d6ef762e3f53', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40238, 'Milkshake banane avec framboise', 'framboises, banane, sucre, glace vanille, fraises, crème liquide, crème chantilly, lait, menthe', '20 min', ['Dans un saladier, écrasez à la fourchette les framboises avec le sucre pour obtenir un coulis.', 'Dans le bol d''un mixeur, réunissez la glace vanille, le sorbet fraise, la crème liquide et la banane coupée en gros morceaux. Mixez pendant 1 minute. Si le milk-shake est trop épais, diluez-le avec un peu de lait.', 'Répartissez ce coulis au fond de 2 verres.', 'Versez le milk-shake sur les framboises, décorez de Chantilly, de framboises entières et d''une feuille ou deux de menthe.'], ['Louche', 'Économe', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Milkshake banane avec framboise', 'confiserie', 'testées', 'très facile', 'menthe', 'framboises', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'crème liquide', 'glace vanille', 'dessert', 'plat de résistance', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:12:06.489577', [{'ingredient_id': '33998750-17ab-4ae2-8f3e-dae2421c2b6e', 'quantite': ''}, {'ingredient_id': '79c766f9-bf02-40d4-a3bc-b0c697dea536', 'quantite': ''}, {'ingredient_id': '82a02191-5c07-4261-8a9c-e134ee605031', 'quantite': '1 cuillères'}, {'ingredient_id': '0fdaa66d-b720-4a4e-b050-b9983b6b6ef1', 'quantite': '1 cuillères'}, {'ingredient_id': 'c498b731-4828-4bc2-9040-2498f2f73d9f', 'quantite': '2 cuillères'}, {'ingredient_id': 'd977f84f-26fc-4c5d-8524-9bfcb138fadd', 'quantite': '50 g'}, {'ingredient_id': '8feab45a-d810-4dca-b985-559772710174', 'quantite': '1'}, {'ingredient_id': '9389a772-2d42-4b9b-a26b-524e50e05ce5', 'quantite': '2 cl'}, {'ingredient_id': '94522adc-77aa-4958-ad19-7aead2053f62', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345912, 'Cookies vegan aux amandes', 'flocons d''avoine, crème liquide, banane, farine, purée, margarine, sucre, amandes, levure chimique', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Dans une casserole, mélanger les flocons, la crème et la banane préalablement écrasée.', 'Cuire à feu doux, tout en remuant pendant 2 minutes. Réserver ', 'Mélanger, dans un saladier, la purée d''amandes, la margarine et le sucre.', 'Ajouter ensuite la préparation avec les flocons.', 'Pour finir, incorporer la farine et la levure. ', 'Huiler la plaque de cuisson.', 'Prendre un morceau de pâte, former une petite boule, l''aplatir et mettre au centre une amande. Renouveler l''opération afin d''obtenir environ 15 cookies.', 'Enfourner le tout pendant 15 minutes.'], ['Tire-bouchon', 'Râpe', 'Planche à découper'], ['amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'facile', 'cookie', 'plat', 'Cookies vegan aux amandes', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'farine', 'margarine', 'dessert', 'plat de résistance', 'moyen', 'purée', 'sucre', 'flocons d''avoine', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:12:10.654261', [{'ingredient_id': '0c962ce0-52be-427c-ab91-2f21a94278c8', 'quantite': '150 g'}, {'ingredient_id': '6efd13f2-2b1b-4685-8d47-c2a0f581b187', 'quantite': '20 cl'}, {'ingredient_id': '26d0ab78-b504-4c0b-b473-978fdc14b1bd', 'quantite': '1'}, {'ingredient_id': '95dd21f1-9c98-49b9-84ee-c8e35b836088', 'quantite': '200 g'}, {'ingredient_id': '700811eb-0ffa-4547-81c7-339d9f320459', 'quantite': '4 cuillères'}, {'ingredient_id': 'eb9c6418-c3e7-4435-9de3-5117cdda5f70', 'quantite': '100 g'}, {'ingredient_id': '4784f173-d7df-4a62-b317-4e6143bda20d', 'quantite': '150 g'}, {'ingredient_id': 'c9b73725-c1fb-4c4e-844b-346a2fe439e5', 'quantite': '15'}, {'ingredient_id': '9f77dfc7-40a1-4d75-99de-f7857a0cacda', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61087, 'Smoothie banane praliné', 'banane, lait, miel, pralin', '5 min', ['Coupez la banane en morceaux et mettez-les dans votre mixeur ou blender.', 'Ajoutez-y le miel, le pralin et quelques glaçons et recouvrez de lait.', 'Mixez le tout jusqu''à ce que les glaçons aient fondus et que la consistance soit bien mousseuse.', 'Servez illico dans des grands verres avec une pincée de pralin sur le dessus.', 'Dégustez! Mmmmmmmmm !'], ['Poêle', 'Couteau de chef', 'Fouet', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'pralin', 'dessert', 'plat de résistance', 'lait', 'smoothies', 'Smoothie banane praliné', 'cocktail'], 'Boisson', 8e7207a9-2f0a-4c2c-b4f7-3182dece5e8f, '2025-09-26T15:12:14.150094', [{'ingredient_id': '464115e1-93a9-46f6-89bb-c565ceb3f102', 'quantite': '2'}, {'ingredient_id': '940d352e-6f64-429f-8444-3dd5a798dc21', 'quantite': '1'}, {'ingredient_id': '6070349c-5141-4a04-8b11-7e6de61a8d81', 'quantite': '1 cuillères'}, {'ingredient_id': '79223ad7-57a1-4ccb-8880-34090287d50a', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31815, 'gâteau brioché aux bananes', 'pâte à pain, banane, sucre roux, cannelle', '10 min', ['Etaler la pâte à pain dans un plat à tarte. ', 'Découper les bananes en rondelles et les disposer sur la pâte. ', 'Saupoudrer de sucre roux et de cannelle. ', 'Cuire 20 mn Th 7-8 (220°C). ', 'A la sortie du four, répartir sur le dessus de la tarte des raisins secs ou des pépites de chocolat.'], ['Presse-agrumes', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'gâteau brioché aux bananes', 'très facile', 'bon marché', 'pâte à pain', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cannelle', 'cocktail', 'sucre roux'], 'Dessert', ff329678-ced6-4d66-83cc-66ba7f1bfa09, '2025-09-26T15:12:17.702664', [{'ingredient_id': 'ca43e6be-d016-4aaf-8022-35173b2a87f8', 'quantite': '300 g'}, {'ingredient_id': '1be39bd0-fef8-4911-9315-5d4c0f3a23ab', 'quantite': '3'}, {'ingredient_id': 'd8c14b31-b1e8-40d1-89fd-0ac203020e95', 'quantite': '2 cuillères'}, {'ingredient_id': '5b4721c2-b98d-43b9-b3d3-7ac3a6e8947d', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228569, 'Calzone Nutella Banane', 'farine, beurre, levure de boulanger, eau, banane, Nutella, chocolat', '15 min', ['1 - Même préparation que pour une <a href="http://www.marmiton.org/recettes/recette_pate-brisee-vite-faite_31639.aspx" target="_blank"><u>pâte brisée</u></a> mais à la place de lier la pâte avec de l''eau utilisez l''eau tiède mélangée à la levure, vous pouvez également y ajouter un peu de sucre et de la cannelle à la farine au départ.', 'Préchauffez votre four à 150°C (thermostat 5)', '2- Étalez cette pâte sur un plan de travail enfariné (pour éviter que la pâte colle)', '3- Étalez du nutella au milieu de cette pâte, une couche pas trop épaisse (sauf pour les très gourmands) ', '4- Coupez la banane en rondelle et déposez les rondelles sur une moitié de la pâte.', '5- Ajoutez les carrés de chocolat au dessus de la banane', '6- Vous pouvez maintenant refermer le chausson (comme une calzone)', '7- Enfournez dans un plat antiadhérant pendant 15 à 20 minutes en surveillant, la pâte doit être dorée.'], ['Presse-agrumes', 'Louche', 'Balance de cuisine', 'Couteau de chef', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'chocolat', 'facile', 'bon marché', 'Calzone Nutella Banane', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'Nutella', 'dessert', 'plat de résistance', 'beurre', 'levure de boulanger', 'cocktail'], 'Dessert', c4ee3a4e-b18d-42da-9ce4-11042b83c643, '2025-09-26T15:12:21.119075', [{'ingredient_id': '02f4e35d-5d36-482c-b71a-7b3868c2ee82', 'quantite': '150 g'}, {'ingredient_id': 'ec1195eb-b52d-42ec-baef-88a3148e6015', 'quantite': '80 g'}, {'ingredient_id': 'ffc2ab03-3289-46a5-aec2-21c1748b6d69', 'quantite': ''}, {'ingredient_id': 'ba43a0ae-125b-4752-9f5e-2ea3d1c55a52', 'quantite': '5 cl'}, {'ingredient_id': 'c0a9a303-7cae-4c68-b7ef-6a79d6b79321', 'quantite': '1'}, {'ingredient_id': '8a70f33e-914d-4491-85b8-4c0b7364f69d', 'quantite': ''}, {'ingredient_id': '8805d60f-35f2-445f-aca4-13367d0bf929', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315785, 'Confiture poire, banane et pamplemousse', 'poire, banane, pamplemousse, fruits, vanille', '20 min', ['Éplucher et couper tous les fruits en dés. ', 'Les peser et les mettre dans une grande casserole avec le sucre et la vanille. ', 'Laisser reposer une heure pour que les fruits absorbent le sucre et le goût de la vanille. ', 'Faire cuire à feu moyen (il faut tout de même que la confiture soit à ébullition), pendant une demi heure après le début de l''ébullition. ', 'Mettre en pot la confiture encore chaude, les fermer et les retourner pour enlever l''air des pots (cette étape est indispensable pour que la confiture se conserve).'], ['Poêle', 'Pince de cuisine', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'Confiture poire', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'banane et pamplemousse', 'dessert', 'plat de résistance', 'pamplemousse', 'fruits', 'cocktail'], 'Confiserie', d1d5a164-b0cb-41e0-a1b7-68a061ef425c, '2025-09-26T15:12:25.237017', [{'ingredient_id': '4a9196a9-0ee1-4b82-a19c-e7dee721b8cf', 'quantite': '5'}, {'ingredient_id': 'e90f84a8-068b-4399-b604-3b185d53aed0', 'quantite': '2'}, {'ingredient_id': 'eea92aad-538b-4f38-a2e8-96a3ca090fd3', 'quantite': '2'}, {'ingredient_id': '88647566-9c00-435d-810f-04b119b6da52', 'quantite': ''}, {'ingredient_id': '7c2cff82-1416-4bdd-b08a-4ab0c27d089d', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14002, 'Bananes Beauharnais', 'banane, rhum, beurre, crème fraîche, macaron', '15 min', ['Epluchez les bananes. Coupez-les en 2 dans la longueur. Disposez-les dans une poêle contenant une noix de beurre fondu. Sur feu doux, laissez-les juste blondir. Retournez avec précaution. ', 'Répartissez les 8 demi-bananes sur 4 assiettes à dessert ou 4 coupelles.', 'Faites bouillir le rhum blanc. Enflammez-le et versez-le sur les bananes. Nappez chaque portion d''une cuillère à soupe de crème fraîche. ', 'Saupoudrez de macarons écrasés et de noisettes de beurre.', 'Glissez les coupelles remplies dans le four à micro-ondes. Programmez 1 mn à température moyenne, puis 2 mn à température maximale. Servez aussitôt.'], ['Tire-bouchon', 'Couteau de chef', 'Pince de cuisine', 'Passoire', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'Bananes Beauharnais', 'confiserie', 'testées', 'bon marché', 'rapide', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'macaron', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:12:28.758098', [{'ingredient_id': '93e1b713-90a0-4534-b890-47752174b38b', 'quantite': '4'}, {'ingredient_id': '0d71e9df-0165-4dca-a704-752369ba2b7a', 'quantite': '4 cuillères'}, {'ingredient_id': '5586dda2-daec-4cfc-a679-0511aba4e867', 'quantite': '50 g'}, {'ingredient_id': '67888bfa-fe6a-40dc-a3ee-291ba66333af', 'quantite': '4 cuillères'}, {'ingredient_id': 'a58e2fc9-6c18-4bb4-816d-968a5be29a9a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20462, 'Moulin à vent banane-chocolat', 'banane, oeuf, chocolat noir, sucre en poudre, beurre, amandes en poudre, farine, sel', '20 min', ['1) Préchauffez le four Th 6 (180°C). ', 'Cassez le chocolat en cubes, faites-le fondre avec un peu d''eau au bain-marie (ou au micro-ondes). ', 'Fouettez les jaunes d''oeufs avec le sucre 1 mn. ', '2) Mélangez le chocolat fondu avec les jaunes d''oeufs. Incorporez :', '- 100 g de beurre ramolli. ', '- Les blancs d''oeufs légèrement battus à la fourchette (environ 15 s). ', '- La farine. ', '- La poudre d''amandes et', '- La pincée de sel. ', '3) Pelez les bananes, coupez-les en 2 dans la longueur. ', 'Placez-les en hélice dans un moule à tarte beurré de 28 cm, côté bombé vers le haut et recouvrez de la pâte. ', '4) Mettez au four et laissez cuire environ 20 mn ; le coeur du gâteau devra rester à peine cuit. ', 'Laissez refroidir et démoulez délicatement.'], ['Balance de cuisine', 'Moule à tarte', 'Louche', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'amandes en poudre', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'Moulin à vent banane-chocolat', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:12:35.535862', [{'ingredient_id': 'a8c9cd33-5dff-4318-aa95-c7a3cf32760f', 'quantite': '4'}, {'ingredient_id': '14d06db9-79bd-4c77-b284-00b092069f9d', 'quantite': '3'}, {'ingredient_id': 'c202a01f-3bb3-4a29-bd19-9df68c53ed92', 'quantite': '150 g'}, {'ingredient_id': 'cb022d06-bae0-44a2-92a7-5c5c93ee8f7a', 'quantite': '100 g'}, {'ingredient_id': '35791f22-6df1-4f0c-8835-25748b9060cc', 'quantite': '100 g'}, {'ingredient_id': '1516e71c-a87a-4ada-a511-8d505532402e', 'quantite': '60 g'}, {'ingredient_id': '566d0f40-7828-45aa-bed6-96ec306affd0', 'quantite': '1 cuillères'}, {'ingredient_id': '125e82bb-937f-436c-9c68-8680802b1ebb', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31132, 'gnocchi exotique', 'banane, pomme de terre, farine, ananas, échalote, ail, tomate, chair à saucisse, crème fraîche, beurre, poivre, sel, huile', '30 min', ['Pour la pâte éplucher les bananes, les couper en rondelles et faire revenir le tout au beurre 5 mn. Faire cuire les pommes de terre en robe des champs 15 mn. Une fois cuites, les éplucher, les passer au presse-légume ainsi que les bananes ; mettre le tout sur le plan de travail et pétrir avec la farine pour faire une pâte ferme. Saler, poivrer à votre goût. ', 'Faire des boudins et découper des petits bouts que l''on passe sur le dos d''une fourchette pour faire les stries des gnocchis. ', 'Faire bouillir de l''eau salée avec un filet d''huile, jeter les gnocchis dans l''eau bouillante. Dès qu''ils remontent à la surface les sortir et les mettre dans un plat qui va au four. ', 'Pour la sauce prendre les ananas, les couper en petits triangles, faire revenir l''échalote, l''ail, les tranches d''ananas, la chair à saucisse ; peler les tomates, les couper en petits cubes et les mettre à cuire avec la sauce 10 mn à feu doux avec un petit verre d''eau. ', 'Une fois cuit lier à la crème fraîche et verser le tout sur les gnocchis. ', 'Chauffer au four 5 mn. ', 'Se sert avec un rôti de porc ou poulet.'], ['Ouvre-boîte', 'Verre doseur', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'facile', 'ail', 'tomate', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'moyen', 'chair à saucisse', 'beurre', 'gnocchi exotique', 'ananas', 'poivre', 'pomme de terre', 'cocktail', 'échalote'], 'Accompagnement', 1110cfb0-9235-4d19-99a8-b0a8f6a1c43d, '2025-09-26T15:12:39.201176', [{'ingredient_id': '46b786fe-f1de-4d52-8721-e98c5ddd67a7', 'quantite': '4'}, {'ingredient_id': '8c9bb16e-9f30-4cd1-af41-d0d7ce0f1936', 'quantite': '4'}, {'ingredient_id': '8200bc92-e464-4732-a15f-d55d633f01ea', 'quantite': '400 g'}, {'ingredient_id': 'd777baf1-6bcd-43df-a7d0-ec2eefe05c0f', 'quantite': '4'}, {'ingredient_id': '5b1a05df-85cb-4a4e-9dbd-44346c63db09', 'quantite': '2'}, {'ingredient_id': '8d6088ab-9d20-4460-a1c3-e06889a20f85', 'quantite': '1'}, {'ingredient_id': 'abe6470d-7865-4141-b410-86e6e53851be', 'quantite': '4'}, {'ingredient_id': 'd2809a93-6572-4b35-89ab-d80549188a51', 'quantite': '150 g'}, {'ingredient_id': '48dcd757-4b06-483a-91e6-9c7c3502aa8b', 'quantite': '2 cuillères'}, {'ingredient_id': '2865a9e0-7398-4d19-91ae-cf3c58e7c8da', 'quantite': '50 g'}, {'ingredient_id': 'a51dddce-9455-4209-80cd-b4eef5ea0e64', 'quantite': ''}, {'ingredient_id': '24657bec-e962-4cfa-92a9-4376f7ac4642', 'quantite': ''}, {'ingredient_id': 'e1b9db8b-07c8-4d9c-b340-457fc907f297', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22030, 'Mousse glacée à la banane', 'banane, lait concentré non sucré, sucre, citron', '10 min', ['Mixer les bananes pour obtenir une sorte de crème. Presser les citrons, les ajouter à la crème de banane ainsi que la moitié du sucre.', 'Battre au batteur le contenu de la boîte de lait concentré très froid avec le reste du sucre, jusqu''à l''obtention d''une belle crème fouettée. Ajoutez-la à la crème de banane. ', 'Verser dans un moule à charlotte ou autre et mettre au congélateur 5 heures au minimum. A faire de préférence la veille. ', 'A servir avec un coulis de fruits rouges ou de kiwis.', 'Pour faire un coulis de kiwis : mixer 3 ou 4 kiwis épluchés et débarrassés de la partie blanche centrale. Ajouter un peu de jus de citron et sucrer à volonté.'], ['Économe', 'Pince de cuisine', 'Tire-bouchon', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Mousse glacée à la banane', 'dessert', 'plat de résistance', 'citron', 'mousse fruits', 'lait concentré non sucré', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:12:42.723343', [{'ingredient_id': 'b7106c80-d6b8-4d6b-bf8b-c6f46d1e7b57', 'quantite': '4'}, {'ingredient_id': '52e9f705-fd80-499b-aa89-4d15be55e12d', 'quantite': '1'}, {'ingredient_id': '4e4093d0-30a1-46ab-a88d-aa54cd321399', 'quantite': '200 g'}, {'ingredient_id': '2e9ef2aa-280f-4369-ab17-c715fc95cc3a', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50797, 'Confiture de mûres à la banane', 'banane, mûres, sucre, sucre, citron', '25 min', ['Laver les mûres, puis les faire chauffer pendant une dizaine de minutes pour qu''elles éclatent.', 'Les passer au moulin à légumes avec la grille fine. ', 'Peser le jus ainsi obtenu et ajouter le poids correspondant de pulpe de banane écrasée à la fourchette (poids du jus de mûres = 2,5 fois le poids de banane).', 'Ajouter les sucres et le jus de citron.', 'Faire cuire à feu vif, et compter 5 min à partir de la forte ébullition.', 'Mettre en pots et fermer immédiatement.'], ['Verre doseur', 'Spatule', 'Ouvre-boîte', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'mûres', 'cuisine', 'recettes', 'boisson', 'confiture de mûre', 'Confiture de mûres à la banane', 'dessert', 'plat de résistance', 'citron', 'sucre', 'cocktail'], 'Confiserie', 983646d8-d3b2-409d-873c-16390052ff69, '2025-09-26T15:12:46.245052', [{'ingredient_id': 'bce01e9c-0279-4bc6-8778-59e51f7b1c47', 'quantite': '300 g'}, {'ingredient_id': 'c263aa27-83b4-444e-bd2d-b6610794eb6b', 'quantite': '750 g'}, {'ingredient_id': '13f63ac2-fd35-4a69-a76f-1103b51f76b0', 'quantite': '400 g'}, {'ingredient_id': 'ae03cf0b-2b5f-484c-80a5-0a790c8762a8', 'quantite': '400 g'}, {'ingredient_id': 'daf6e871-8b5d-4111-9bd5-0efd12dd6ef3', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20788, 'Tarte à la banane et aux raisins secs', 'pâte brisée, banane, citron, raisins secs, amandes effilées, oeuf, crème fraîche, sucre en poudre, rhum, cannelle', '20 min', ['Préchauffez le four à 200°C (thermostat 6-7) et mettez les raisins à gonfler dans le rhum.', 'Disposez la pâte dans un moule à tarte beurré, recouvrez d''aluminium et de haricots secs et faites cuire à blanc 10 minutes.', 'Coupez les bananes en rondelles, citronnez-les et répartissez-les sur le fond de tarte. Parsemez des raisins égouttés et des amandes effilées.', 'Mélangez les oeufs, la crème et le sucre. Ajoutez le rhum et la cannelle, versez sur les fruits.', 'Enfournez 30 minutes.'], ['Rouleau à pâtisserie', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'Tarte à la banane et aux raisins secs', 'rhum', 'confiserie', 'testées', 'facile', 'oeuf', 'plat', 'tarte à la banane', 'sucre en poudre', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'citron', 'raisins secs', 'cannelle', 'amandes effilées', 'cocktail'], 'Dessert', f2215ecb-d38d-4254-95c1-2f1f25a89fad, '2025-09-26T15:12:49.810510', [{'ingredient_id': 'f16f0b79-6c4e-4150-bf64-ca25a0c545ea', 'quantite': '1'}, {'ingredient_id': '40e3c932-d422-44b1-b668-ba61c83ae6ce', 'quantite': '4'}, {'ingredient_id': '8bcf18d4-5e46-491d-9862-0113541794d4', 'quantite': '1'}, {'ingredient_id': 'c5c2ee79-2a3d-4b8f-b5b9-7615bc21f36d', 'quantite': '100 g'}, {'ingredient_id': '14666d9d-3fa2-4f68-ba97-f38db5bcb059', 'quantite': '50 g'}, {'ingredient_id': 'bd66638a-5b30-41d2-aca0-086a1400005c', 'quantite': '3'}, {'ingredient_id': 'eb1bd632-40e0-49a2-b48f-25fc13fa86fb', 'quantite': '75 g'}, {'ingredient_id': 'c8ae79e5-67c8-4e86-92a1-96dcc6016fdc', 'quantite': '100 g'}, {'ingredient_id': '2cce4f39-5fd4-4b48-b730-983906f8cb58', 'quantite': '7 cl'}, {'ingredient_id': '29dfbb98-c54f-4964-ba3a-52d511e25a3e', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530582, 'Cake aux bananes citronné et sans beurre', 'sucre, farine, banane, amandes en poudre, zeste de citron, jus de citron, oeuf, bicarbonate, sucre glace, jus de citron', '10 min', ['Préchauffer le  four à 170°C.', 'Bien écraser les bananes, puis les mélanger au sucre à l''aide d''un robot ménager, jusqu''à l''obtention d''une pâte homogène et relativement liquide. ', 'Ajoûter la farine, le bicarbonate et la poudre d''amandes.
Bien mélanger.', 'Ajouter les oeufs un à un, en mélangeant bien entre chaque ajout.', 'Ajouter le zeste d''un citron entier (bio de préférence !) et le jus de citron.
Bien mélanger.
La pâte est assez liquide, mais pas d''inquiétude, c''est normal !', 'Mettre du papier cuisson au fond de votre moule (je me suis contentée de graisser et fariner le moule et le cake est resté collé au fond du moule...) et verser la pâte.', 'Cuire 45 à 50 minutes. Vérifier la cuisson à l''aide de la pointe d''un couteau.', 'Laisser refroidir avant de démouler.', 'Facultatif : une fois le cake froid, mélanger le sucre-glace avec quelques gouttes de jus de citron jusqu''à obtention de la consistance voulue pour le glaçage, et en napper le cake.'], ['Poêle', 'Économe', 'Verre doseur', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'amandes en poudre', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'zeste de citron', 'Cake aux bananes citronné et sans beurre', 'dessert', 'plat de résistance', 'jus de citron', 'sucre', 'cocktail', 'bicarbonate'], 'Dessert', d876da6b-e58c-4125-96f5-3732d1246919, '2025-09-26T15:12:53.849771', [{'ingredient_id': '3382af85-8497-464d-b7d5-5519f1c88eb9', 'quantite': '150 g'}, {'ingredient_id': 'bb77054f-4497-4ac7-a8e2-d942ac146de9', 'quantite': '180 g'}, {'ingredient_id': '9e791b49-82bd-4a38-9e0e-098d71b5500e', 'quantite': '200 g'}, {'ingredient_id': 'f03f0f11-54b0-435a-9bc6-781560ad2524', 'quantite': '70 g'}, {'ingredient_id': 'bd5a99ee-5a80-485d-8d8c-9c461b735f75', 'quantite': '1'}, {'ingredient_id': 'bb403061-1543-4fa8-8a78-5a01b48adf3b', 'quantite': '140 ml'}, {'ingredient_id': 'a1d306e7-2dd0-44a1-99eb-96b29f115428', 'quantite': '5'}, {'ingredient_id': '73379a5f-a32f-49ac-ba7b-da095cb679e5', 'quantite': '1 cuillères'}, {'ingredient_id': 'fc8e350c-3c67-4e1f-8ef3-795b1a1f7655', 'quantite': '60 g'}, {'ingredient_id': '76eeb70c-ff23-4247-914a-ff8bbb3480b5', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (347901, 'Bowl cake healthy aux cacahuètes', 'farine, lait d''amande, cacao, arachide, raisins secs, beurre de cacahuètes, avoine, miel, banane', '15 min', ['Éplucher la banane et l''écraser à l''aide d''une fourchette. Mettre la purée obtenue dans le bol.', 'Rajouter la farine et le lait puis mélanger jusqu''à l''obtention d''une pâte.', 'Rajouter le reste des ingrédients et bien mélanger.', 'Mettre le bol au micro-ondes et faire cuire 5 min à température maxi.'], ['Fouet', 'Rouleau à pâtisserie', 'Mixeur', 'Batteur électrique', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'lait d''amande', 'très facile', 'bon marché', 'cacao', 'beurre de cacahuètes', 'rapide', 'plat', 'recette', 'cuisine', 'Bowl cake healthy aux cacahuètes', 'miel', 'recettes', 'arachide', 'boisson', 'farine', 'avoine', 'dessert', 'plat de résistance', 'raisins secs', 'cocktail'], 'Dessert', bf126612-84ad-45e7-bb2a-cc074ed5a51a, '2025-09-26T15:12:57.398294', [{'ingredient_id': '95fd062a-1a0c-4639-8bc2-1031b1691bd9', 'quantite': '8 cuillères'}, {'ingredient_id': 'f8c3e3bc-2682-47e0-ae7e-f4a4b1ba2edd', 'quantite': '2'}, {'ingredient_id': '4f0606f7-2b4e-4684-90a7-c2a63a9249af', 'quantite': '3 cuillères'}, {'ingredient_id': 'ee214370-5849-4825-a73a-c2f42ee7c447', 'quantite': '1'}, {'ingredient_id': 'a8636b41-3246-40fa-87c1-302e6d92bd14', 'quantite': '2'}, {'ingredient_id': 'ced097f5-5289-4a0f-b668-912374fa99ce', 'quantite': '1 cuillères'}, {'ingredient_id': '192d7ab3-4f4c-4c6a-a350-250a3987a6ac', 'quantite': '2 cuillères'}, {'ingredient_id': 'fe35122a-fe10-469d-90f9-1b5d58c3d61e', 'quantite': '1 cuillères'}, {'ingredient_id': '90463e46-3236-4c88-bcba-fc9dc2fb2573', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (48555, 'Ananas antillais', 'ananas, mangue, citron vert, banane, goyave, litchi, orange, sucre roux, rhum, cannelle, vanille', '25 min', ['Couper l''ananas en 2, dans le sens de la longueur (même le plumet).', 'Retirer la chair, en faisant attention à l''écorce qui nous servira pour la présentation; couper la chair en cubes.', 'Laver, peler les autres fruits, puis les couper en cubes.', 'Ajouter les litchis.', 'Arroser les fruits avec le jus, ajouter le sucre, les épices et le rhum...', 'Couvrir et laisser mariner au réfrigérateur.', 'A table !! Servir bien glacé, en plaçant les fruits dans les deux écorces.'], ['Casserole', 'Verre doseur', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'goyave', 'Ananas antillais', 'facile', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'moyen', 'orange', 'ananas', 'citron vert', 'cannelle', 'litchi', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:13:01.497751', [{'ingredient_id': 'e8a1b910-3c9c-48a7-beb4-142fa8422dbf', 'quantite': '1'}, {'ingredient_id': '80998154-2bd5-40bf-afea-1f8e05037e3a', 'quantite': '2'}, {'ingredient_id': 'b948e541-299e-4e78-82a9-766b6d2b3078', 'quantite': '2'}, {'ingredient_id': '77ac8320-27cd-4a6c-a205-29a54b828776', 'quantite': '2'}, {'ingredient_id': 'bd3d1ccb-8057-409b-8558-39cb2a04aa07', 'quantite': '2'}, {'ingredient_id': '7168e030-f04d-4ae8-8b54-21b0d1b85581', 'quantite': '250 g'}, {'ingredient_id': '0b9974f8-7207-492d-8a69-27ee8f6e2ac0', 'quantite': '2'}, {'ingredient_id': '012d0632-d8a0-483d-9774-d53bc168cfea', 'quantite': '100 g'}, {'ingredient_id': '19ace118-77cb-48cc-8288-7100e07a37f1', 'quantite': '3 cuillères'}, {'ingredient_id': '851a7250-5a2e-4c36-aa60-731c555de559', 'quantite': ''}, {'ingredient_id': 'ed15e827-3fb1-40c5-bdd6-0ee4eed9e0d3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (89422, 'Feuilleté de bananes-pommes', 'banane, pâte feuilletée, beurre, sucre de canne, nappage', '15 min', ['Etalez votre pâte feuilletée et découpez un cercle d''environ 30 cm de diamètre.', 'Déposez votre cercle de pâte sur votre plaque préalablement humectée d''eau.', 'Piquez votre pâte à l''aide d''une fourchette. ', 'Epluchez puis émincez finement vos 5 bananes-pommes.', 'Une fois vos bananes émincées et votre pâte piquée, étalez vos rondelles de bananes sur votre pâte.', 'Saupoudrez vos bananes avec les 40 g de sucre de canne.', 'Emiettez sur votre feuilleté, vos 60 g de beurre. Enfournez pendant environ 15 à 20 minutes à 180°C (thermostat 6). A la sortie du four, nappez votre feuilleté d''abricotine.'], ['Spatule', 'Fouet', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'nappage', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'Feuilleté de bananes-pommes', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'dessert', 'plat de résistance', 'pâte feuilletée', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:13:05.638178', [{'ingredient_id': '2c9f0823-7d99-416b-8b4b-4b967482eda5', 'quantite': '5'}, {'ingredient_id': 'cd4edf6d-33b2-4a42-85b0-cac09ab6aa27', 'quantite': '150 g'}, {'ingredient_id': '7e0b1ba4-f0df-483f-8552-a95a1bd2d327', 'quantite': '60 g'}, {'ingredient_id': 'cf52fb37-f747-453c-a908-c7262fa4187c', 'quantite': '40 g'}, {'ingredient_id': '4b553c6c-7932-4cc9-b36e-5ba0af74918b', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (86637, 'Aumonières de banane', 'crêpe, banane, melon, sucre de canne, citron vert, rhum vieux, cannelle', '30 min', ['Préparer une confiture de bananes : peler les bananes et les couper en rondelles. ', 'Les faire mijoter 20 min avec le sucre, le zeste râpé, le jus d''1/2 citron et une bonne pincée de cannelle.', 'Rajouter au besoin un peu d''eau. Laisser tiédir la confiture de banane. ', 'Couper le melon en 2, l''épépiner et prélever la pulpe. ', 'La mixer avec le rhum vieux. Ajouter un peu de sucre.', 'Farcir chaque crêpe en aumônière. ', 'Accompagner de coulis de melon et, éventuellement d''une boule de sorbet exotique.'], ['Poêle', 'Batteur électrique', 'Louche', 'Fouet', 'Moule à tarte'], ['', 'melon', 'entrée', 'Aumonières de banane', 'banane', 'recettes de cuisine', 'confiserie', 'rhum vieux', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'crêpe', 'dessert', 'plat de résistance', 'citron vert', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:13:09.821175', [{'ingredient_id': 'cd0d41f2-86de-4c1f-8536-4f2b77f5d962', 'quantite': '6'}, {'ingredient_id': '629971df-eb55-4790-bc9c-fe26fe99905d', 'quantite': '3'}, {'ingredient_id': '43532d52-d2a7-4de7-bc49-952d58d37f84', 'quantite': '1'}, {'ingredient_id': 'f887bf0a-bb75-4bfa-8815-63dd6de820af', 'quantite': '200 g'}, {'ingredient_id': '942292c6-c2aa-47f9-8fe9-0233a88ed5bd', 'quantite': '1'}, {'ingredient_id': 'f7acc831-0cf8-40c2-9c94-98a7624684c6', 'quantite': '3 cl'}, {'ingredient_id': '2332a7ed-c945-494e-a53d-dd1c3fffd969', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (35227, 'Gâteau à la banane et à la cannelle', 'beurre, sucre fin, oeuf, farine de blé, levure chimique, crème fraîche épaisse, cannelle, banane, cassonade', '20 min', ['Préchauffez votre four à 180°C. ', 'Mélangez le beurre et le sucre en pommade. Ajoutez l''oeuf et bien mélangez. Puis ajoutez la farine, la levure la crème et la cannelle. Mélangez jusqu''à obtention d''une pâte homogène. ', 'Beurrez et farinez un moule à cake. Versez-y le mélange, puis placez les tranches de banane sur le dessus. Saupoudrez de sucre cassonade et enfournez pour 35 mn. Vérifiez la cuisson. ', 'Bon appétit. ', 'Essayez aussi en remplacant le sucre cassonade par du sucre vanillé. Il est aussi possible de remplacer la crème fraîche épaisse par de la crème fraîche liquide montée en chantilly (dans ce cas , pensez à la laisser quelques minutes au congélateur pour qu''elle soit plus facile à monter en chantilly).'], ['Couteau de chef', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche épaisse', 'confiserie', 'testées', 'levure chimique', 'cassonade', 'sucre fin', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'farine de blé', 'gâteau à la banane', 'beurre', 'Gâteau à la banane et à la cannelle', 'cannelle', 'cocktail'], 'Dessert', 11880e90-bb39-42ed-915d-591fbdfe165d, '2025-09-26T15:13:13.372584', [{'ingredient_id': 'ab021227-2901-4817-8e5d-253fce0cb1b5', 'quantite': '120 g'}, {'ingredient_id': '05c15d78-ff52-4a23-a5ba-4d0be0116aed', 'quantite': ''}, {'ingredient_id': '157958d7-1754-4ce4-82c3-681465631ce7', 'quantite': '1'}, {'ingredient_id': '64fd789d-1ce0-49c2-80ea-013df75f107a', 'quantite': '1.5'}, {'ingredient_id': '545ddd3f-ad0f-442f-9e33-aabf1fa6bcf7', 'quantite': ''}, {'ingredient_id': 'd04181ea-8291-4ace-8a7e-6e2a097d5cc6', 'quantite': ''}, {'ingredient_id': '54589fd7-58f5-42e0-aa7a-dc0e7a3c0d94', 'quantite': '1 cuillères'}, {'ingredient_id': 'ce1e8380-6fea-4859-9229-e736a2ed29ff', 'quantite': '1'}, {'ingredient_id': '9a34d2bb-80f1-4f9f-9284-6ebff20dcdb5', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (533591, 'Milkshake à la fraise', 'lait, banane, yaourt, fraises, confiture de fraises', '10 min', ['Dans un mixeur, tout mélanger.', 'Mixer', 'Mettre dans les tasses'], ['Économe', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'confiture de fraises', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Milkshake à la fraise', 'lait', 'cocktail'], 'Dessert', 02192cda-d513-473d-8ccc-0125ad97b324, '2025-09-26T15:13:17.458259', [{'ingredient_id': '4e9c0933-415b-4ab9-95d9-46974cdcf954', 'quantite': '1'}, {'ingredient_id': 'b9ac54e6-80bb-450e-8e70-8f0439c97c69', 'quantite': '2'}, {'ingredient_id': '49a98c0e-0405-4379-8d47-ce72f33e0f06', 'quantite': '1'}, {'ingredient_id': 'a947fcd6-4599-4109-9813-9e70e034ee86', 'quantite': '6'}, {'ingredient_id': 'c8b3017f-2bc8-4067-be0d-13e3b2254c7a', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21394, 'Gâteau antillais à la banane et au chocolat', 'pâte feuilletée, chocolat, oeuf, banane, noix de coco rapée', '30 min', ['Étaler la pâte feuilletée sur une plaque et la piquer avec une fourchette. ', 'Cuire au four environ 10 mn en surveillant qu''elle ne gonfle pas. ', 'Préparer la mousse au chocolat. ', 'Lorsque la pâte est cuite, laisser refroidir, puis étaler la mousse au chocolat dessus, couper des rondelles de bananes que vous disposez sur la mousse. Parsemez de noix de coco râpée et mettez au frais.'], ['Ouvre-boîte', 'Économe', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'Gâteau antillais à la banane et au chocolat', 'dessert', 'plat de résistance', 'pâte feuilletée', 'gâteau au chocolat', 'cocktail'], 'Dessert', 5c7b642c-ed0e-4b8c-acf4-21d986e0066c, '2025-09-26T15:13:21.530755', [{'ingredient_id': '4c669142-5c8d-4fdb-a3e2-aca9acb12ecb', 'quantite': '1'}, {'ingredient_id': 'c23baa1f-3fa7-4b6d-acc8-671f11c3f024', 'quantite': '200 g'}, {'ingredient_id': '9916fa57-36da-45b9-8fc3-06a9b200c85b', 'quantite': '6'}, {'ingredient_id': 'e1e7af9d-8fb9-47f1-9552-b1e9bcdcc493', 'quantite': '2'}, {'ingredient_id': 'fabe94bd-9725-4ce7-82bc-98e53fb2a875', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13850, 'Crumble pommes-bananes', 'pomme, banane, amandes en poudre, sucre, farine, beurre, rhum, Marie brizard', '10 min', ['Préparer la pâte à crumble : mélanger le beurre mou à la poudre d''amandes. Ajouter le sucre puis la farine. Malaxer jusqu''à l''obtention d''une pâte (type pâte sucrée) et former une boule. La laisser reposer 1 heure au frais.', 'Précauffer le four à 200°C. Couper les pommes en petits morceaux et les bananes en rondelles.', 'Dans un plat à tarte (pas la peine de le beurrer), mélanger pommes, bananes et 2 bouchons de chaque alcool. Laisser cuire 15 mn.', 'Sortir le plat du four et mélanger une fois de plus. Casser des morceaux de pâte de différentes tailles et les disposer sur le dessus de la ''compote''.', 'Passer sous le grill du four jusqu''à ce que les morceaux de pâte soient bien dorés.'], ['Presse-agrumes', 'Casserole', 'Fouet', 'Batteur électrique', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'Crumble pommes-bananes', 'très facile', 'crumble aux pommes', 'amandes en poudre', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'beurre', 'Marie brizard', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:13:26.245926', [{'ingredient_id': 'd535168d-5de5-4e5c-8fd0-3e0e8175cd15', 'quantite': '6'}, {'ingredient_id': '9788ac65-4b84-4735-97c2-13126151f63c', 'quantite': '6'}, {'ingredient_id': 'd81c2b26-7f83-4bca-aade-b303b1fd43bb', 'quantite': '125 g'}, {'ingredient_id': '72fbcfc1-04eb-4ec3-8d92-890cc9da0e81', 'quantite': '100 g'}, {'ingredient_id': '14affbb7-ec78-4465-ab67-5b6ab832ec43', 'quantite': '100 g'}, {'ingredient_id': 'cd3a4404-3782-498e-a727-c4de2f0ccae4', 'quantite': '60 g'}, {'ingredient_id': 'e6b249a4-b8ac-463c-813b-7b2636acae5f', 'quantite': ''}, {'ingredient_id': '4c22b27e-10f1-4e61-aceb-932393929abb', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16998, 'Curry de dinde de Lily', 'blanc de dinde, yaourt nature, lait de coco, citron, oignon, coulis de tomate, curry, huile d''olive, sel, riz, petits pois, poivron rouge, banane, mangue, citron, coriandre', '30 min', ['1. Dans un saladier, mélanger les yaourts, le lait de coco, le jus de citron, les oignons, et y ajouter la dinde coupée en petit cube. Laisser mariner pendant 6 heures minimum.', '2. Au moment du repas, faire chauffer l''huile dans une grande cocotte sur feu moyen et y ajouter la marinade, le curry et le sel. Porter le tout doucement à ébullition. A ce moment rajouter le coulis de tomate, baisser le feu et laisser mijoter pendant au moins 1h15. Après 1h de cuisson , cuire le riz dans une grande quantité d''eau salée.', '3.Au moment de servir, le riz sera parsemé de petits pois et de lanières de poivrons, la viande et sa sauce sera garnie de rondelles de bananes et de lamelles de mangues. Décorer de coriandres.', 'Ce plat doit être dégusté très chaud'], ['Râpe', 'Tire-bouchon', 'Couteau de chef', 'Passoire', 'Spatule'], ['lait de coco', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'yaourt nature', 'facile', 'bon marché', 'curry de poulet', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'Curry de dinde de Lily', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'blanc de dinde', 'citron', 'coulis de tomate', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:13:29.869154', [{'ingredient_id': '6f5a85ab-7e23-4c38-93c7-2f2d09f1347f', 'quantite': '600 g'}, {'ingredient_id': '94011618-4169-4740-8bc8-dad349095536', 'quantite': '4'}, {'ingredient_id': '750e087b-478d-4464-8155-6aa71119ff22', 'quantite': '30 cl'}, {'ingredient_id': '6f24125f-9896-405d-988b-261ce9e71cc2', 'quantite': ''}, {'ingredient_id': 'a4a9eca6-b7b9-490e-ac7a-fffdda058ba9', 'quantite': '3'}, {'ingredient_id': 'b710021e-1561-4563-a370-44ecc55fa74e', 'quantite': '40 cl'}, {'ingredient_id': '681c6847-cafb-49a2-b81e-7ed82b01f974', 'quantite': '3 cuillères'}, {'ingredient_id': '55ae9efc-1447-426d-a345-9034ebdd1cdf', 'quantite': '2 cuillères'}, {'ingredient_id': '7ddb5177-f129-41bd-9beb-cea9627753f9', 'quantite': ''}, {'ingredient_id': '2aabd630-3eaf-41e7-93ce-52a4ba410ad1', 'quantite': ''}, {'ingredient_id': '4f0eb084-fdcc-4b58-8cd0-2702a7a6b39f', 'quantite': '1'}, {'ingredient_id': 'efb46a79-154b-4942-860d-d3ebffcd3d6d', 'quantite': '1'}, {'ingredient_id': 'c8063aa4-8540-466c-9496-a4692cd2d27b', 'quantite': '2'}, {'ingredient_id': 'f99b14f0-fd3b-4606-8fe4-34e7852bbe74', 'quantite': '1'}, {'ingredient_id': '95c01fd5-5416-4c3d-84af-d3e2b1d3c444', 'quantite': ''}, {'ingredient_id': 'b9218b76-6a83-4c6b-8ed0-4b321e8708cc', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169445, 'Le baiser de la Schtroumpfette', 'vodka, curaçao, limonade, jus de banane', '2 min', ['Verser tous les ingrédients dans l''ordre dans un verre à martini ou à cocktail et servir très très frais!'], ['Tire-bouchon', 'Économe'], ['', 'vodka', 'entrée', 'recettes de cuisine', 'Le baiser de la Schtroumpfette', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'jus de banane', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'limonade', 'cocktail', 'curaçao'], 'Boisson', ae44d10b-3394-4f46-92c3-b1da1cb9f034, '2025-09-26T15:13:33.340582', [{'ingredient_id': 'ec962d42-a2a3-4525-a13c-4a290c669e84', 'quantite': '2 cl'}, {'ingredient_id': '2241e9a5-92b2-4631-bc38-c84c1af15d2e', 'quantite': '2 cl'}, {'ingredient_id': '72840662-d809-479a-a6a9-658c1cf21387', 'quantite': '5 cl'}, {'ingredient_id': 'd1621752-b98d-43be-aaa1-1fb96f5b5b12', 'quantite': '5 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (232961, 'Réveil fruité orange, banane et citron de Lola', 'orange, banane, citron, sucre, cannelle', '10 min', ['Couper les oranges en deux au niveau du 2ème tiers.', 'Les presser pour qu''il ne reste que la peau (la coque de l''orange). Réserver le jus obtenu.', 'Pour chaque orange on obtient deux parties de coque : la grosse qui servira de récipient et la petite pour jouer le rôle du couvercle.', 'Écraser la banane dans un bol (si elle ne s’écrase pas bien, ajouter un peu d''eau) et y ajouter un peu de sucre.', 'Presser le citron dans un bol et mettre le jus d''orange (pressé) dans un autre bol.', 'Prendre la grosse partie de la coque et y mettre 1 tiers de banane écrasée. Mettre un peu de jus d''orange et un peu de jus de citron.', 'Ajouter encore un peu de sucre, et pour les fans de cannelle en saupoudrer un peu.', 'Fermer l''orange avec l''autre partie de la coque.', 'Faire un trou sur le dessus et y planter sa paille !'], ['Tire-bouchon', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'Réveil fruité orange', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'orange', 'cannelle', 'sucre', 'banane et citron de Lola', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:13:37.529222', [{'ingredient_id': '98950658-4e18-44d9-8c7a-20b861f2809a', 'quantite': '2'}, {'ingredient_id': 'fa42cac7-8ee6-4a85-808f-244fe1d6bba4', 'quantite': '1'}, {'ingredient_id': '74c0abc2-58a5-4682-bda4-4960832838e9', 'quantite': ''}, {'ingredient_id': 'eb1e94b4-d1f8-4ecd-9a3f-a1e9916ab788', 'quantite': '20 g'}, {'ingredient_id': '2a61c5bc-bdb7-41d7-831c-bdf0ac6e3c98', 'quantite': '5 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (67701, 'Red red', 'banane plantain, haricots coco, concentré de tomates, tomate, oignon, piment, huile', '60 min', ['Le red red est une recette ghanéenne (Afrique de l''ouest).', 'Faire tremper les haricots, la veille. Le lendemain, les faire cuire à l''eau, 45 min (saler à mi-cuisson).', 'Pendant ce temps, préparer la sauce : faire revenir l''oignon coupé fin dans l''huile (là-bas, c''est à l''huile de palme, mais on peut remplacer par de l''huile de tournesol ou d''arachide).', 'Ebouillanter les tomates (15 secondes dans l''eau bouillante, la peau se décolle ensuite aisément), les peler, découper la chair en petits cubes et ajouter aux oignons, laisser réduire.', 'Quand la sauce est bien réduite, ajouter le concentré de tomate et le piment. On peut mettre de l''ail.', 'Peler et couper les plantains en tronçons de 1 cm de large, en biais.', 'Les faire revenir à la poêle à feu moyen, sans lésiner sur l''huile. ', 'Elles sont prêtes quand elle sont bien caramélisées.', 'Mélanger les haricots et la sauce, servir les assiettes moitié haricots et moitié bananes plantains...'], ['Ouvre-boîte', 'Verre doseur', 'Poêle'], ['', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'concentré de tomates', 'très facile', 'bon marché', 'Red red', 'tomate', 'plat', 'recette', 'haricots coco', 'piment', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile', 'dessert', 'plat de résistance', 'banane plantain', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:13:41.054114', [{'ingredient_id': 'baae130d-4e7c-4958-95c6-1fd29114ae84', 'quantite': '2'}, {'ingredient_id': 'c471a86d-b80a-4a4e-847c-07cb58ab873b', 'quantite': '200 g'}, {'ingredient_id': 'db510366-589b-4454-a99d-a5855d23dd81', 'quantite': '1'}, {'ingredient_id': '801cc823-b40b-4958-8699-9d85ada41a45', 'quantite': '2'}, {'ingredient_id': '5e297b32-e578-4119-943f-8664a370abf3', 'quantite': '1'}, {'ingredient_id': '4dd91a7b-760f-473f-8309-2391107879ad', 'quantite': ''}, {'ingredient_id': '1fd0eded-d263-4de2-9ff2-58b9895bab76', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42851, 'Crêpes fourrées au mascarpone et marmelade de bananes', 'crêpe, mascarpone, banane, cassonade, beurre, chocolat', '30 min', ['Préparer la pâte, et confectionner 8 crêpes.', 'Dans une casserole, faire fondre un bon morceau de beurre, et y mettre les bananes (bien mûres), coupées en rondelles.  ', 'Les saupoudrer de cassonade brune, et chauffer tout doucement, en mélangeant, pour obtenir comme une compote avec morceaux.', 'Tartiner les crêpes avec la mascarpone, déposer dessus de la marmelade de banane au sucre, et rouler la crêpe.', 'Déposer dans un plat, et servir les crêpes froides (pas au frigo!), avec de la sauce chocolat chaude.', 'Bon appétit!'], ['Moule à tarte', 'Fouet', 'Presse-agrumes', 'Tire-bouchon', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'confiserie', 'testées', 'cassonade', 'chocolat', 'très facile', 'bon marché', 'plat', 'Crêpes fourrées au mascarpone et marmelade de bananes', 'recette', 'cuisine', 'recettes', 'boisson', 'crêpe', 'dessert', 'plat de résistance', 'crêpes sucrées', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:13:44.681988', [{'ingredient_id': 'fbccc9d4-29a4-4188-a449-93a905d941ac', 'quantite': '8'}, {'ingredient_id': 'c0c31e97-35c6-44df-a3dd-e32bdb704d75', 'quantite': '1'}, {'ingredient_id': '80bd7554-0756-4b17-aaa7-2c388d9cddb7', 'quantite': '4'}, {'ingredient_id': 'c4046fa6-10b2-4335-9bbd-b62c87e88b30', 'quantite': ''}, {'ingredient_id': 'c7f8753e-b9d0-47e5-be9b-9cbacb913013', 'quantite': ''}, {'ingredient_id': '97149fb7-9671-4842-a00e-4a0725354ad1', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57137, 'Gâteau chocolat banane facile façon Mélanie', 'chocolat pâtissier, sucre, beurre tendre, oeuf, maïzena, farine, levure, banane, yaourt nature', '10 min', ['Faire fondre le chocolat avec un peu d''eau.', 'Préchauffer le four à 120°C (thermostat 4).', 'Dans une terrine mettre le sucre, le beurre ramolli et le chocolat.', 'Homogéniser au fouet.', 'Ajouter les oeufs, la maïzena, la farine, la levure, et le yaourt. ', 'Huiler un plat rond (en verre de préférence).', 'Verser la préparation, mettre au four 10 minutes (sinon les bananes tombent au fond).', 'Pendant ce temps, couper les bananes en rondelles (environ 1,5cm d''épaisseur), ajouter à la préparation.', 'Enfourner à nouveau pour environ 30 minutes de cuisson.'], ['Moule à tarte', 'Couteau de chef', 'Presse-agrumes', 'Balance de cuisine', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'beurre tendre', 'yaourt nature', 'facile', 'maïzena', 'bon marché', 'oeuf', 'plat', 'Gâteau chocolat banane facile façon Mélanie', 'recette', 'chocolat pâtissier', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'gâteau au chocolat', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:13:48.117583', [{'ingredient_id': 'd94cd4b0-7d17-4296-a891-916e13161260', 'quantite': '125 g'}, {'ingredient_id': 'e6a8a863-029e-4c6b-8112-d4ee82753cf7', 'quantite': '50 g'}, {'ingredient_id': '22fd864a-3030-4530-b66a-3c8738580308', 'quantite': '125 g'}, {'ingredient_id': '5a449ec7-d64b-49e6-8862-0db1c7b54b9c', 'quantite': '4'}, {'ingredient_id': 'a210a2d0-bb3d-49b2-8a8e-8c5f499dca40', 'quantite': '75 g'}, {'ingredient_id': 'd9d010a7-b92b-489d-849c-557af037d3cb', 'quantite': '50 g'}, {'ingredient_id': 'b1eb215c-ba34-4251-bcca-d688e08ed160', 'quantite': '1'}, {'ingredient_id': '6f9fa944-c9ce-46ba-8be7-6809d6963cc4', 'quantite': '4'}, {'ingredient_id': '7a7ca0fe-32c5-4954-9539-35181be94f24', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58714, 'Verrines bananes et petits palmiers feuilletés', 'feuilleté, banane, sucre en poudre, beurre, petit suisse, eau', '15 min', ['Eplucher et couper les bananes en rondelles.', 'Dans une poêle, chauffer le sucre arrosé d''une cuillère à soupe d''eau jusqu''à obtenir un caramel blond.', 'Ajouter les bananes et le beurre à ce caramel et laisser compoter 3 minutes. Laisser refroidir.', 'Disposer dans le fond des verrines une couche de petit suisse sucré puis des petits morceaux de palmiers.', 'Disposer ensuite les bananes et finir par une nouvelle couche de petits palmiers feuilletés.'], ['Mixeur', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'petit suisse', 'eau', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'Verrines bananes et petits palmiers feuilletés', 'feuilleté', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:13:51.685922', [{'ingredient_id': 'b82a2400-9981-4436-8a1c-1d0a2e06960a', 'quantite': '1'}, {'ingredient_id': '2082cbd2-4bf3-4136-bea7-0a63cb99b263', 'quantite': '4'}, {'ingredient_id': 'd3a16cdd-3ef3-4904-95c3-3a87e74b44c3', 'quantite': '200 g'}, {'ingredient_id': 'b3e87d0c-d6f3-4e0a-805b-b8d8949fee29', 'quantite': '40 g'}, {'ingredient_id': '26b5f02e-6dde-447f-aa95-ba30efe9b905', 'quantite': '120 g'}, {'ingredient_id': '9c7a94f5-10a0-4441-bf65-e3edf15e5722', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315814, 'Coque pralinoise banane nutella', 'chocolat praliné, banane, pâte à tartiner, Spritz, crème fraîche, sucre glace, vanille', '20 min', ['Faire fondre au bain marie le chocolat pralinoise, et badigeonner vos moules afin de faire les coques en chocolat.', 'Mettre au congélateur afin de faire durcir le chocolat, pour ma part je répète 3 fois l''opération afin que la coque soit bien dure. ', 'Une fois fini, démouler les coques, les réserver au réfrigérateur.', 'Pour la chantilly selon votre siphon mettre 25 cl de crème fraiche avec 3 cuillères à soupe de sucre glace et 2 gouttes de vanille liquide (si pas assez sucré rajouter du sucre glace).', 'Dans la coque en chocolat couper des petits morceaux de banane, mettre par dessus des biscuits Sprits émiettés, par dessus ajouter un peu de pâte à tartiner, et pour finir la chantilly que vous aurez préparé.'], ['Verre doseur', 'Râpe', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'Coque pralinoise banane nutella', 'dessert', 'Spritz', 'plat de résistance', 'sucre glace', 'chocolat praliné', 'cocktail', 'pâte à tartiner'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:13:55.841961', [{'ingredient_id': 'f13a92cb-7199-422e-9ba4-2c015d5754b6', 'quantite': '150 g'}, {'ingredient_id': '1a54d7f0-b173-4d64-bc15-405dea017c71', 'quantite': '2'}, {'ingredient_id': 'c02c8a73-4121-4736-9567-2de396532a1c', 'quantite': '2 cuillères'}, {'ingredient_id': 'b93c5004-640c-47eb-878c-2a77d9b66ae8', 'quantite': '10'}, {'ingredient_id': '2f88c1d7-3e4f-41fe-a01e-6443046224b6', 'quantite': '25 cl'}, {'ingredient_id': 'ec5898a9-ec64-4909-a3c9-c28f469354a3', 'quantite': '3 cuillères'}, {'ingredient_id': 'b0d1c4cf-dad8-4e7e-9da9-c1131ad0cbdb', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38043, 'Sherry trifle', 'biscuits à la cuillère, confiture de cerise, sherry, banane, citron, cerises, jaune d''oeuf, sucre, lait entier, crème fleurette, mascarpone, amandes effilées', '15 min', ['Tartinez les biscuits cuillers de confiture de cerises et disposez-les au fond d''une jolie coupe. Versez le sherry dessus.', 'Trempez les rondelles de bananes dans le jus de citron pour qu''elles ne brunissent pas, posez-les sur les biscuits.', 'Egouttez les cerises, posez-les sur les bananes.', 'Fouettez les jaunes d''oeufs et le sucre jusqu''à ce que le mélange blanchisse.', 'Portez le lait à ébullition et versez-le hors du feu sur les jaunes d''oeufs. Cuisez doucement SANS bouillir jusqu''à ce que la crème anglaise épaississe. Laissez refroidir complètement. Versez sur les fruits.', 'Montez la crème fleurette avec le mascarpone et posez sur la crème anglaise. ', 'Décorez d''amandes effilées grillées. Placez au frais au moins 3h avant de consommer.'], ['Presse-agrumes', 'Mixeur', 'Poêle', 'Économe', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'confiserie', 'testées', 'assez cher', 'biscuits à la cuillère', 'crème fleurette', 'lait entier', 'plat', 'moyenne', 'jaune d''oeuf', 'recette', 'cuisine', 'recettes', 'boisson', 'confiture de cerise', 'dessert', 'plat de résistance', 'citron', 'sherry', 'sucre', 'amandes effilées', 'Sherry trifle', 'cocktail', 'cerises'], 'Dessert', 2d53d613-a6e9-41d6-8947-390927d43f3d, '2025-09-26T15:14:00.040879', [{'ingredient_id': '132b632b-ff75-4ff9-b3e7-d32a14e9ad85', 'quantite': '20'}, {'ingredient_id': '5608312d-7115-4ffd-afbd-e35e9cca6479', 'quantite': '4 cuillères'}, {'ingredient_id': 'e8cacb78-06e2-4b33-b00e-30f41ee7c31a', 'quantite': '5 cuillères'}, {'ingredient_id': '20fee4f2-f542-49b2-897c-fe83dd4782a1', 'quantite': '2'}, {'ingredient_id': 'b4dd8e54-c332-4121-a3e9-210d968bb186', 'quantite': ''}, {'ingredient_id': '90cf2d9a-2b9a-46e8-b527-e806be25f341', 'quantite': '225 g'}, {'ingredient_id': '6922c256-8501-4c85-b0f6-b362b1df5790', 'quantite': '5'}, {'ingredient_id': '9099f859-64ed-402a-aade-2f4ae6f13405', 'quantite': '50 g'}, {'ingredient_id': 'a29b76a7-d09b-4def-8c38-4503c4c1afbf', 'quantite': '50 cl'}, {'ingredient_id': '2f7b9e9c-8916-487a-a1e0-c45ff45308e6', 'quantite': '20 cl'}, {'ingredient_id': '377771d1-46c7-477c-8a34-278fd9eccec2', 'quantite': '3 cuillères'}, {'ingredient_id': '2a96325f-8df1-4e2a-b499-7e8b314f770a', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62104, 'Blancs de poulets éxotiques', 'blanc de poulet, banane, oignon, tomate, curry, huile d''olive, feuilles de coriandre', '40 min', ['Couper la tomates en dés, les oignons en dés et les bananes en rondelles.', 'Faire chauffer l''huile dans une sauteuse et y faire revenir l''oignon.', 'Ajouter la viande, les bananes, les tomates et le curry.', 'Couvrir et laisser mijoter 20 min.', 'Parsemer de feuilles de coriandre et servir aussitôt avec du riz.'], ['Moule à tarte', 'Tire-bouchon', 'Pince de cuisine', 'Batteur électrique', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'tomate', 'plat', 'blanc de poulet', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'feuilles de coriandre', 'curry', 'cocktail', 'Blancs de poulets éxotiques'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:14:03.719564', [{'ingredient_id': 'dce484fc-f9d2-45af-a6f9-fdb223f32192', 'quantite': '4'}, {'ingredient_id': '14746de8-fef6-48e3-a820-2d84a5c2ad90', 'quantite': '4'}, {'ingredient_id': 'efd4e1fa-635c-4864-855e-c16411e8143c', 'quantite': '1'}, {'ingredient_id': '58f87851-1589-4912-be75-54acd9e8d1c8', 'quantite': '1'}, {'ingredient_id': '46fbde2e-838d-43ab-93fb-f4ff1e86c0d5', 'quantite': '1 cuillères'}, {'ingredient_id': '72e9debf-02db-4a47-bd92-cbcc8531d79f', 'quantite': '2 cuillères'}, {'ingredient_id': '2afe838f-73fb-4021-84a0-1dc12bb4f828', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (212057, 'Cookie glacé façon macaron', 'cookie, banane, chocolat noir, chocolat blanc, glace vanille', '10 min', ['Faire des cookies ou les acheter dans le commerce. Faire fondre le chocolat.', 'Pour 6 macarons, prendre 12 cookies, en prendre 6 qui serviront de "chapeau" et les couvrir de chocolat fondu. Poser des éclats de chocolat blanc ou des amandes sur le chocolat encore chaud. Réserver au congélateur pendant 1 h.', 'Retourner les 6 autres cookies face plate vers le haut et y déposer quelques rondelles de banane coupées assez fines (les rondelles ne doivent pas dépasser du bord). Déposer sur les bananes une boule de glace à la vanille que vous aurez sortie du congélateur 1/4 d''heure auparavant. Sortir les "chapeaux" du congélateur, les déposer sur la glace et appuyer doucement pour aplatir le tout et ainsi amener le glace jusqu''au pourtour du macaron. ', 'Enlever la glace qui sort des cotés s''il y a lieu et mettre le tout au congélateur. Vous en sortirez le nombre qu''il vous faut un peu avant de déguster.'], ['Ouvre-boîte', 'Casserole', 'Fouet', 'Louche', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'macarons', 'facile', 'Cookie glacé façon macaron', 'bon marché', 'cookie', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'chocolat noir', 'chocolat blanc', 'cocktail'], 'Dessert', 2494ddc8-0278-4438-8722-0172b0be623c, '2025-09-26T15:14:07.110839', [{'ingredient_id': '1ef28cdb-6e17-4d8d-9ca3-fff6f02eaaac', 'quantite': '12'}, {'ingredient_id': 'fc9c1e4e-dcd2-422c-b138-7b717f0583c9', 'quantite': '1'}, {'ingredient_id': '3e9b8fd7-8c7d-4d99-9d93-deff0945f259', 'quantite': '150 g'}, {'ingredient_id': 'b3dbc154-cb5b-4668-b9ba-48b53c8c58ad', 'quantite': '30 g'}, {'ingredient_id': '6b0793e2-01c2-4293-b7b8-332589124931', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392274, 'Balboa Smoothie', 'banane, yaourt nature, extrait de vanille, jus d''oranges', '0 min', ['Réalisez la recette "Balboa Smoothie" au mixer.', 'Mixer avec 5 glaçons la banane, le yaourt et l''extrait de vanille jusqu''à consistance crémeuse. Incorporez lentement le jus d''orange jusqu''à obtention de la consistance voulue. .', 'Servir dans un verre de type "tumbler".', 'Aucune décoration.'], ['Louche', 'Balance de cuisine', 'Économe', 'Ouvre-boîte', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Balboa Smoothie', 'confiserie', 'testées', 'yaourt nature', 'extrait de vanille', 'facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'jus d''oranges', 'cocktail'], 'Boisson', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:14:11.340553', [{'ingredient_id': 'fa4cd8e1-1de9-404c-83ad-f2d9c30b6a21', 'quantite': '1'}, {'ingredient_id': '5faaadfc-9634-44f2-89c9-1dbe136f339e', 'quantite': '1'}, {'ingredient_id': '386b9abb-ad9d-422e-9a01-3771518681d0', 'quantite': ''}, {'ingredient_id': '10bef3e6-3e23-415a-b6ed-6857984deab6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15086, 'Bananes plantain en accompagnement (Congo)', 'banane plantain, huile de palme', '30 min', ['Faites chauffer l''huile de palme, à feux doux (sur une échelle de 1 à 6, prenez 3).', 'L''huile dans la poêle doit former une couche de 2 mm environ. L''huile ne doit SURTOUT PAS FUMER!!', 'En attendant, après avoir enlevé la peau des bananes, il faut les couper dans le sens de la longueur. Couper ensuite chaque moitié en morceaux de 10 cm environ.', 'Placer les morceaux dans la poêle. Si vous avez une hotte aspirante, c''est le moment de vous en servir ! L''huile de palme, bien qu''elle sente bon, sent fort aussi.', 'Laissez les cuire sur chaque face de façon à avoir des morceaux au final légèrement dorés (PAS CROUSTILLANTES!).', 'Se mange avec des légumes (manioc, parex), de la viande et, pourquoi pas, du riz également.', 'Cet accompagnement est une prépartion Muluba, du Kasai, région de la R.D.Congo.'], ['Casserole', 'Louche', 'Râpe', 'Fouet'], ['boisson', 'bon marché', 'recettes', 'Bananes plantain en accompagnement (Congo)', 'légumes', 'entrée', 'recettes de cuisine', 'plat', 'dessert', 'confiserie', 'recette', 'huile de palme', 'testées', 'banane plantain', 'plat de résistance', 'cocktail', 'cuisine', 'très facile'], 'Accompagnement', 71b48b4c-7538-4ad3-b282-796949feeab6, '2025-09-26T15:14:14.886500', [{'ingredient_id': '580857b5-6254-4e8a-ace6-14e9b3d41d68', 'quantite': '4'}, {'ingredient_id': '0da1586e-b80e-428f-9e1f-ba2907fcf66f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530231, 'Kelewele (bananes plantain frites épicées)', 'banane plantain, oignon blanc, gingembre, piment rouge, huile de friture, sel', '15 min', ['Éplucher et découper les bananes en dés. Réserver dans un saladier.', 'Hâcher finement ou mixer le gingembre, le piment et l''oignon.', 'Ajouter les condiments hachés aux bananes, saler et bien mélanger. Laisser reposer 15/20 min (facultatif).', 'Chauffer l''huile et frire les bananes jusqu''à l''obtention d''une couleur dorée. Après cuisson, mettre sur du papier absorbant.', 'Servir chaud nature ou avec une sauce tomate pimentée.'], ['Économe', 'Moule à tarte', 'Rouleau à pâtisserie'], ['gingembre', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'huile de friture', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'piment rouge', 'dessert', 'oignon blanc', 'plat de résistance', 'banane plantain', 'Kelewele (bananes plantain frites épicées)', 'bouchée ou amuse-bouche', 'cocktail'], 'Amuse-gueule', 87e76c0c-91ce-4472-b4d9-6a5844a30451, '2025-09-26T15:14:18.383112', [{'ingredient_id': '29babbc2-d88c-4759-b506-ea75a1bd26a9', 'quantite': '4'}, {'ingredient_id': 'b662690b-20e0-4818-bb36-39b7b462f1d8', 'quantite': '1'}, {'ingredient_id': '6506f8a2-b7a4-46da-b751-53c081d95ed0', 'quantite': '35 g'}, {'ingredient_id': 'a6d67d0f-b225-4c83-951d-d3339eac0152', 'quantite': '1'}, {'ingredient_id': 'c57f08d4-01d9-4187-a3f4-057d5d281f62', 'quantite': ''}, {'ingredient_id': 'c70cbb77-dad0-4576-aed0-6f1fe0fb1272', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336035, 'Gâteau moelleux Banane/Chocolat', 'farine, sucre, chocolat, beurre, oeuf, lait, bicarbonate, banane', '10 min', ['Préchauffez votre four à 180°C (TH7)', 'Base :', 'Dans un saladier mélanger un à un, la farine, le sucre, le bicarbonate, les œufs et le lait.', 'Faire fondre le chocolat et le beurre (micro onde ou bain-marie), une fois fondu, liez, puis incorporer dans la base.', 'Enfin passer les bananes au moulin à légume afin qu''elles soient bien réduites en purée. ', 'Mélanger les bananes à la préparation au plus tôt afin qu''elles ne noircissent pas.', 'Verser dans un moule et mettre au four :', '40 min pour un moule à cake ', '30 min pour un moule à manqué (rond)', 'Une fois la cuisson terminée démouler, puis mettre à refroidir sur une grille', 'Régalez vous !'], ['Rouleau à pâtisserie', 'Poêle', 'Presse-agrumes'], ['', 'entrée', 'banane', 'Gâteau moelleux Banane/Chocolat', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'lait', 'cocktail', 'bicarbonate'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:14:22.039327', [{'ingredient_id': 'd15220b9-bbb5-4386-b90d-cf986ace62df', 'quantite': '200 g'}, {'ingredient_id': '2fed0915-e301-423a-ba0f-f6ba4be2b420', 'quantite': '200 g'}, {'ingredient_id': 'b95d7b38-b834-4d41-8d49-34c3419bffcb', 'quantite': '100 g'}, {'ingredient_id': '2b008693-9e7a-45f9-afda-080c08ae7ced', 'quantite': '70 g'}, {'ingredient_id': '8487e57e-0e4c-47b1-92b1-ab58bf1a8869', 'quantite': '3'}, {'ingredient_id': '278d2901-e7f6-4404-a716-b60343b75c3c', 'quantite': '1'}, {'ingredient_id': 'faf8a7d0-e251-4d0d-8a8a-b2d7ecff83d5', 'quantite': '1'}, {'ingredient_id': '5279aff2-e807-48e8-b826-e5cf5bd1a507', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22526, 'Poulet à l''indienne', 'cuisse de poulet, oignon, curry, farine, concentré de tomates, ail, banane, pomme, bouquet garni, amandes effilées, riz basmati, poivre, sel, beurre', '15 min', ['Dans la cocotte faire chauffer le beurre à feu fort, mettre les cuisses de poulet. 2 mn après ajouter les oignons coupés en lamelles. ', 'Passer à feu doux et laisser cuire 3 mn. ', 'Saupoudrer la farine, le curry. ', 'Mettre le concentré de tomate, l''ail, la banane, la pomme, le bouqet garni. ', 'Ajouter un peu d''eau. ', 'Saler, poivrer et laisser mijoter 45 mn. ', 'Faire cuire le riz basmati. ', 'Dans une poêle faire griller quelques minutes les amandes effilées. ', 'Les présenter sur le riz au moment de servir.'], ['Économe', 'Verre doseur', 'Couteau de chef', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'riz basmati', 'concentré de tomates', 'facile', 'bouquet garni', 'bon marché', 'plats indiens', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'cuisse de poulet', 'oignon', 'boisson', 'farine', 'Poulet à l''indienne', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'poivre', 'amandes effilées', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:14:26.748659', [{'ingredient_id': 'b881232b-215a-4541-b7de-01de0fc0f64d', 'quantite': '4'}, {'ingredient_id': '24af6fb4-7387-45d4-b9bd-1649e332bbe8', 'quantite': '2'}, {'ingredient_id': 'c49344cc-24da-4310-82a2-ebc3432a6a39', 'quantite': '2 cuillères'}, {'ingredient_id': 'bf6dde42-c41e-4fc0-84da-50817d42b96b', 'quantite': '1 cuillères'}, {'ingredient_id': '12120af3-c7b7-4e49-9598-a0be5a0acbc6', 'quantite': '1 cuillères'}, {'ingredient_id': '58010567-40db-4e0e-b0c0-88731ffc4d84', 'quantite': '1'}, {'ingredient_id': '490cafa6-4e23-40ea-80ed-f0441a992256', 'quantite': '1'}, {'ingredient_id': 'e356ee6a-8920-49d4-9182-095ee256b59d', 'quantite': '1'}, {'ingredient_id': 'd5770a93-ce50-4b3a-ad4e-4b1d88e01c60', 'quantite': '1'}, {'ingredient_id': '4df67795-8503-4cf3-a5d4-f22e20817824', 'quantite': ''}, {'ingredient_id': 'c502f5d4-627c-4a98-827a-29eebbda6b11', 'quantite': '200 g'}, {'ingredient_id': 'bbd1d92b-d146-43a7-9eae-35c0a06bb2d2', 'quantite': ''}, {'ingredient_id': 'cca247a5-9527-428c-ac7b-dee69b1d515c', 'quantite': ''}, {'ingredient_id': 'b828217c-8b50-40fe-bd5d-6da3e84d91aa', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (35744, 'Trifle Keraïbes', 'banane, beurre salé, rhum, sauce caramel, palets bretons, crème chantilly, sucre, noix de coco', '20 min', ['Couper les bananes en rondelles ou en cubes, faire fondre le beurre dans une poêle et mettre les bananes à rissoler. Ajouter le rhum. Laisser jusqu’à ce que les bananes prennent une jolie couleur dorée.', 'Laisser refroidir.', 'Mettre les 6 palets bretons dans un sac plastique, nouer le sac et passer le rouleau à pâtisserie (ou une bouteille pour ceux qui n’ont pas de rouleau) pour en faire des miettes.', 'Monter la crème fleurette en chantilly avec le sucre et la noix de coco ou mélanger la noix de coco à la crème en bombe.', 'Mélanger les bananes et les 2 cuillères à soupe de crème de caramel au beurre salé.', 'Procéder au montage, une couche de bananes, une couche de palets pas trop épaisse, à nouveau des bananes, et des palets, terminer par la crème chantilly.', 'Eventuellement, on peut faire griller à la poêle 1 cuillère à soupe de noix de coco et parsemer de chantilly au dernier moment pour le décor.'], ['Batteur électrique', 'Économe', 'Verre doseur', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'sauce caramel', 'très facile', 'beurre salé', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'palets bretons', 'dessert', 'plat de résistance', 'Trifle Keraïbes', 'noix de coco', 'sucre', 'cocktail'], 'Dessert', 7e2626c5-cd60-40ee-86e4-e035509b868d, '2025-09-26T15:14:30.386092', [{'ingredient_id': '3de93152-e174-4f40-bfcb-02bb63b2e1d7', 'quantite': '2'}, {'ingredient_id': '82f673b9-23f8-4837-b1e7-723750eb7dac', 'quantite': '10 g'}, {'ingredient_id': 'cdae94ce-a290-4259-916f-48e54a5db7da', 'quantite': '1 cuillères'}, {'ingredient_id': '730e7937-9fd6-4c8f-b0b7-80340c8c4349', 'quantite': '2 cuillères'}, {'ingredient_id': '91637f0f-8c39-407b-8591-2aa0c2df3ee9', 'quantite': '6'}, {'ingredient_id': '993cd5f4-e978-4ea5-a413-3a62dad06210', 'quantite': '1'}, {'ingredient_id': '31398534-92ae-4bcf-a58a-c1f4148dba84', 'quantite': '2 cuillères'}, {'ingredient_id': '5e904b44-c690-464d-92cb-aa09dd4f5544', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (171061, 'Smoothie Poire Passe-Crassane', 'poire, banane, orange, yaourt', '5 min', ['Épluchez les poires, coupez-les en morceaux.', 'Mixez-les au blender avec le jus des oranges et le yaourt.', 'Servez dans des verres.'], ['Économe', 'Rouleau à pâtisserie', 'Louche', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'Smoothie Poire Passe-Crassane', 'plat de résistance', 'orange', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:14:34.486590', [{'ingredient_id': '6abef9ab-bc2b-4936-9901-f845a8a23ad7', 'quantite': '2'}, {'ingredient_id': 'ed51c120-7873-4315-aba8-1d080487ea52', 'quantite': ''}, {'ingredient_id': 'fe14b847-f531-4d8c-8512-16e4e2bebb35', 'quantite': '1'}, {'ingredient_id': '70d6e21d-2c70-4b0e-b430-1ade3a5e8b0f', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22904, 'Cake banane / yaourt léger et moelleux', 'yaourt, banane, farine, maïzena, huile, fructose, levure chimique, oeuf, cannelle', '10 min', ['Faire préchauffer le four à 180°C. ', 'Dans un saladier, réduire la banane en une purée onctueuse. ', 'Y ajouter le yaourt, mélanger. ', 'Ajouter ensuite un par un tous les ingrédients en terminant par la cannelle et bien mélanger jusqu''à ce que le mélange soit parfaitement homogène. (Veiller à ce que la banane soit bien incorporée uniformément à la pâte). ', 'Verser le tout dans un petit moule à cake et laisser cuire environ 40 mn (le cake doit être d''un doré clair sur le dessus).'], ['Moule à tarte', 'Couteau de chef', 'Poêle', 'Balance de cuisine', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'levure chimique', 'très facile', 'maïzena', 'bon marché', 'oeuf', 'plat', 'recette', 'Cake banane / yaourt léger et moelleux', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'cannelle', 'fructose', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:14:39.118067', [{'ingredient_id': '6638b59f-4aa8-41ec-83fe-b6537e394244', 'quantite': '1'}, {'ingredient_id': 'd3be0512-b620-4a0e-bef5-2790c037c94f', 'quantite': '1'}, {'ingredient_id': 'dce5b5d5-fa36-4476-9c09-d99f877ed660', 'quantite': '1'}, {'ingredient_id': '32da1edf-9aa0-4990-9f48-48e1693bbfc0', 'quantite': '1'}, {'ingredient_id': '87e2b7d1-c22c-469d-b7b2-9f642bbd4030', 'quantite': ''}, {'ingredient_id': '07c44400-3745-46f9-9044-891c63f18ff8', 'quantite': '1'}, {'ingredient_id': 'c6d7fcf5-32f9-4528-b51b-2d2d6d3506ba', 'quantite': ''}, {'ingredient_id': 'b0d60ab8-4de0-423d-a6f3-ee0aac25c060', 'quantite': '2'}, {'ingredient_id': '6b53dfda-af90-4ce1-b6c4-cd1b51214860', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (45004, 'Milkshake vitaminé et light', 'yaourt nature, yaourt, banane, kiwi, fraises, yaourt', '5 min', ['Prenez votre mixer (le petit) mais le mixe soupe fait aussi l''affaire!', 'Si vous utilisez le mixe soupe, utiliser un récipient haut (type carafe) avec bec verseur!', 'Mettez le yaourt nature puis un demi pot de lait.', 'Epluchez les fruits (bananes, kiwis et les fraises sauf une) et coupez-les en morceaux (de toute façon ça va être mixé, donc n''y passez pas trois heure...)', 'Mettez-les dans le yaourt.', 'Ajoutez par dessus le yaourt à la vanille et l''autre moitié de lait (le lait doit servir à bien racler les pots de yaourts et à rendre plus liquide le mélange).', 'Mixez le tout.', 'Servez dans deux beaux verres (c''est très important).', 'Décorez avec une demi fraise.', 'Dégustez à la paille et bien frais...'], ['Planche à découper', 'Économe', 'Balance de cuisine', 'Spatule'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'rapide', 'plat', 'Milkshake vitaminé et light', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Boisson', 991e95a2-7d77-4a85-ad16-8a99e5ca0e32, '2025-09-26T15:14:42.637603', [{'ingredient_id': '445fda35-4075-4acb-86cc-52e682687461', 'quantite': '1'}, {'ingredient_id': 'ac451c45-347e-46a9-82f3-2c1cc46a1836', 'quantite': '1'}, {'ingredient_id': 'd71691c0-6ddb-4065-a6fd-affed31b67cd', 'quantite': '1'}, {'ingredient_id': 'd487ea81-3ca0-454c-a774-0f4eae5e2f89', 'quantite': '2'}, {'ingredient_id': '8029c286-354c-418a-8847-0017b77e478b', 'quantite': '2'}, {'ingredient_id': 'd6c7aa6f-7a47-422b-9953-be644210f939', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (48500, 'Confiture de banane à la cannelle', 'banane, sucre, citron, rhum, cannelle', '60 min', ['Couper les bananes dans le sens de la longueur, puis en rondelles pas trop épaisses.', 'Les mettre dans un plat en cuivre, avec le reste des ingrédients, et bien mélanger le tout.', 'Cuire d''abord à feu vif jusqu''à ébullition, puis à feu doux pendant environ 30 min (elle doit être assez "pâteuse"). Tourner avec une cuillère en bois.', 'Au final, les fruits restent en morceaux mais sont très mous.', 'Mettre en pots... Ma technique : tout ébouillanter; les pots, couvercles et ustensiles au contact de la confiture, puis les retourner et attendre le refroidissement avant de les remettre à l''endroit.', 'Cette confiture a la consistance d''une compote et peut être dégustée aussi de cette façon.'], ['Économe', 'Fouet', 'Verre doseur', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'Confiture de banane à la cannelle', 'cannelle', 'sucre', 'cocktail'], 'Confiserie', 58292515-6987-43ed-96f0-fe31cb742acf, '2025-09-26T15:14:46.108638', [{'ingredient_id': '64f04c2a-1e4c-49ae-9e45-a1e01648198e', 'quantite': '2 kg'}, {'ingredient_id': '98834688-4272-49be-bb51-6ac6976c2bb1', 'quantite': '1 kg'}, {'ingredient_id': '2e7229da-6ccc-4f30-bb8f-b2f35c84f60a', 'quantite': ''}, {'ingredient_id': '94c3973f-ee4b-4b6a-900a-2632a534cfad', 'quantite': '2 cuillères'}, {'ingredient_id': '1c1dc8d0-afa3-41d4-9fe7-bdc94e559c94', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18489, 'bananes au jambon', 'banane, jambon, gruyère râpé, crème fraîche', '10 min', ['Eplucher les bananes. Les entourer ensuite d''une tranche de jambon (comme des endives). Les mettre dans un plat (avec des bords). Etaler le gruyère râpé sur le jambon et ajouter de la crème fraîche par dessus de façon à ce que les bananes ne sèchent pas trop à la cuisson.', 'Mettre au four à 200°C environ 30 mn.'], ['Batteur électrique', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'jambon', 'confiserie', 'bananes au jambon', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'gruyère râpé', 'dessert', 'plat de résistance', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:14:51.670091', [{'ingredient_id': '446ba115-a5ca-42fa-a8d2-62c16441f072', 'quantite': '4'}, {'ingredient_id': '67fdc92e-242a-4c98-8a62-c045e796670a', 'quantite': '4'}, {'ingredient_id': '5e56a93b-4901-4c76-bf5d-cb71ff2ed4cc', 'quantite': ''}, {'ingredient_id': 'c9ae587d-14a9-4e6b-83bf-0cb62fcd32ba', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15961, 'Gâteau express à la banane', 'farine, sucre, lait, huile, oeuf, levure, amandes en poudre, banane', '10 min', ['Mélanger le sucre, la farine, la levure et 250g d''amandes en poudre. Ajouter les oeufs, l''huile et le lait.', 'Mixer les bananes avec 2 cuillères à soupe de lait et les ajouter au mélange.', 'Verser dans un moule a cake et laisser cuire 45 à 50 mn au four, à 180°C.'], ['Louche', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'amandes en poudre', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'Gâteau express à la banane', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:14:56.401313', [{'ingredient_id': 'd82419fb-868b-43fa-84c7-5c7a4b656efb', 'quantite': '8 cuillères'}, {'ingredient_id': '01ef6add-63c0-42ca-ab47-38b7e8e81a0e', 'quantite': '5 cuillères'}, {'ingredient_id': 'f58e1faa-57a9-4845-a283-e406927a5163', 'quantite': '2 cuillères'}, {'ingredient_id': '17e63743-0d8b-4f80-b46a-a724ab374e8a', 'quantite': '3 cuillères'}, {'ingredient_id': 'ba932d0b-01e0-46a5-b460-701d936f9620', 'quantite': '2'}, {'ingredient_id': '18a146ff-65d7-4d9c-b7b6-38ab20636561', 'quantite': ''}, {'ingredient_id': 'b5ec0571-302c-4b97-92d5-aa1fc61bf50d', 'quantite': '250'}, {'ingredient_id': '5142f747-9911-46db-a076-dcbdf82e3d67', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (225188, 'Muffins fraises bananes (sans beurre)', 'oeuf, sucre, amandes en poudre, fromage blanc, farine, levure chimique, fraises, banane', '15 min', ['Battre des œufs avec le sucre jusqu''à blanchir le mélange.', 'Préchauffer le four à 210°C (thermostat 7).', 'Ajouter la poudre d''amandes. Bien mélanger.', 'Ajouter le formage blanc. Bien mélanger.', 'Ajouter la farine et la levure chimique. Mélanger.', 'Quand le mélange est bien homogène, ajouter les fraises coupées en 4 et les bananes tranchées. Mélanger délicatement sans trop écraser les fruits.', 'Remplir la préparation de les moules (si possible moule en silicone)', 'Enfourner 25 min.', 'Démouler et déguster.'], ['Râpe', 'Économe', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'amandes en poudre', 'oeuf', 'plat', 'Muffins fraises bananes (sans beurre)', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'fromage blanc', 'dessert', 'plat de résistance', 'muffin', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:14:59.967223', [{'ingredient_id': '4f75eae5-ef52-41c6-baeb-f575866851d6', 'quantite': '4'}, {'ingredient_id': 'cf786577-a076-40d9-b487-39b1093f8099', 'quantite': '200 g'}, {'ingredient_id': '93ac2439-6bcb-43f9-9e8c-7661c62634aa', 'quantite': '80 g'}, {'ingredient_id': '13133ab9-0dc4-4fda-879c-1722ccbc922c', 'quantite': '150 g'}, {'ingredient_id': '06c55a0b-217f-4c63-a3b1-49ca4fef5983', 'quantite': '300 g'}, {'ingredient_id': '35f74487-dbd9-4144-8251-001261c17acf', 'quantite': '1'}, {'ingredient_id': 'f3b65a49-9cfe-4d87-a1a8-e1bf74cda8a7', 'quantite': '200 g'}, {'ingredient_id': 'dd27d04c-de91-402c-8094-b26b6b7364e1', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12939, 'Casimir (veau au curry et aux fruits)', 'veau, échalote, farine, curry, fond de veau, champignons de Paris, vin blanc sec, crème épaisse, poivre, sel, banane, ananas, pomme', '30 min', ['Couper la viande en lanières. Faire revenir rapidement sur feu vif dans une poêle, dans de l''huile. Pendant ce temps, faire revenir légèrement les échalotes coupées finement dans une cocotte.', 'Au fur et à mesure que la viande est revenue, l''ajouter dans la cocotte.', 'Bien remuer le tout et ajouter la farine. Bien mélanger. Saupoudrer avec le curry, mélanger. ', 'Couvrir le tout avec le fond de veau (le contenu de la préparation définit la quantité de fond de veau nécessaire).', 'Couvrir et laisser mijoter doucement (45 minutes).', 'Pendant de temps, faire revenir dans un peu de beurre les champignons égouttés. Ajouter le demi-verre de vin.', 'Laisser mijoter jusqu''à absorption complète du vin. Ajouter ces champignons à la viande en cours de cuisson. Rectifier l''assaisonnement si nécessaire et ajouter la crème fraîche. La sauce ainsi obtenue doit être bien liée mais pas trop épaisse.', 'Laisser mijoter environ 10 minutes à feu très doux.', '5 minutes avant de servir, ajouter la banane coupée en rondelles ainsi que l''ananas égoutté, coupé en dés et la ½ pomme coupée en lamelles.', 'Servir le tout avec du riz cuit à la créole.'], ['Moule à tarte', 'Pince de cuisine'], ['Casimir (veau au curry et aux fruits)', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'fond de veau', 'testées', 'facile', 'veau', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'vin blanc sec', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'champignons de Paris', 'ananas', 'poivre', 'curry', 'crème épaisse', 'viande à l''indienne', 'cocktail', 'échalote'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:15:03.582587', [{'ingredient_id': '1dbb18f9-9439-4e79-92a8-907f61dd5cd0', 'quantite': '800 g'}, {'ingredient_id': '6108907e-5e17-446b-b52c-113696a06d23', 'quantite': '2'}, {'ingredient_id': 'aa7f1dc1-7085-4399-966e-31512a3a59bc', 'quantite': '1'}, {'ingredient_id': 'b605dccb-c7b1-49c5-9603-9ae9f3b31e11', 'quantite': '1'}, {'ingredient_id': 'e812c732-842f-4dd1-affa-308ce8dd5478', 'quantite': ''}, {'ingredient_id': 'ffbbfffc-1fbe-4edc-8fe2-a520c5e78e50', 'quantite': '200 g'}, {'ingredient_id': '80e011a0-07f2-4946-bf8e-f2d759229b7d', 'quantite': '1'}, {'ingredient_id': '77b97d73-8f69-4122-b952-f8005b8bbfe5', 'quantite': '5 cl'}, {'ingredient_id': '6420e7cf-5595-4066-98a0-368fed298f83', 'quantite': ''}, {'ingredient_id': '085b924d-2586-4d6d-a25b-2cdfbdcb1494', 'quantite': ''}, {'ingredient_id': '6e15e361-73ec-4a88-8fa7-ee7050d34ae9', 'quantite': '1'}, {'ingredient_id': '8e219972-adf2-417e-b245-81a978666954', 'quantite': '10'}, {'ingredient_id': 'a9f0c48f-a77e-4534-95c2-e39eaa44399d', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (53552, 'Tarte aux bananes flambées', 'farine, beurre tendre, sucre, vanille, jaune d''oeuf, sel, banane, miel, sucre, rhum', '30 min', ['Pour la pâte brisée sucrée :', 'Dans un saladier, mettre la farine, faire un puits et y mettre tous les autres ingrédients. Mélanger du bout des doigts jusqu''à ce que ça ressemble à de la semoule.', 'Avec les paumes, cette fois, former une boule.', 'Mettre dans un sachet plastique et placer au frigo pendant 30 min minimum.', 'Pendant ce temps :', 'Mettre le sucre et le miel dans une poêle à feu doux en remuant.', 'Quand le sucre a fondu, disposer les bananes coupées en deux dans le sens de la longueur, et laisser cuire 5 min.', 'Verser le rhum dans la poêle et faire flamber. Quand le sucre a fondu, disposer les bananes coupées en deux dans le sens de la longueur; laisser cuire 5 min.', 'Dans un moule, poser du papier sulphurisé. Disposer délicatement la pâte étalée (épaisseur 5 mm). Faire cuire à four préchauffé à 200°C (Th 6-7) pendant 10 min.', 'Pour garder le croustillant de la pâte, disposer les bananes juste avant de servir. Repasser à four chaud (250°C) pendant 5 min.', 'Servir avec une boule de glace vanille.'], ['Couteau de chef', 'Planche à découper', 'Ouvre-boîte', 'Poêle', 'Râpe'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'beurre tendre', 'assez cher', 'plat', 'tarte à la banane', 'jaune d''oeuf', 'recette', 'cuisine', 'Tarte aux bananes flambées', 'recettes', 'boisson', 'farine', 'vanille', 'dessert', 'plat de résistance', 'difficile', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:15:07.827534', [{'ingredient_id': '67f35067-acff-4de3-b209-11b8bc80484c', 'quantite': '200 g'}, {'ingredient_id': 'd3a48ebb-0390-48f7-84c0-b48e35e73a3a', 'quantite': '125 g'}, {'ingredient_id': 'abd7a0c7-52bb-42b2-84c9-d53ace069086', 'quantite': '50 g'}, {'ingredient_id': 'ee408ade-2f57-4dcc-b041-f2ff0920ab90', 'quantite': '1 cuillères'}, {'ingredient_id': 'e369a1d5-a008-467f-bcbe-380399c9deaf', 'quantite': '2'}, {'ingredient_id': 'db9dddde-d1b3-4630-8ec0-36a4fc80eec4', 'quantite': '1'}, {'ingredient_id': '0c1f6920-3df6-48ec-bbd9-a0639cb68d62', 'quantite': '8'}, {'ingredient_id': 'a6dde07f-5a0f-45b3-87e1-f5e6521ba360', 'quantite': '3 cuillères'}, {'ingredient_id': 'c279ea38-dd74-4d2a-9ae2-920e7e3b9f5e', 'quantite': '75 g'}, {'ingredient_id': '157f8f2b-abf6-4829-be35-6d6fd1dbdc6c', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (308110, 'Croustiilants pomme banane caramel au beurre salé', 'brick, huile de tournesol, glace vanille, pomme, banane, cannelle, sucre vanillé, eau, caramel au beurre salé, beurre, crème liquide, eau, sucre en poudre', '0 min', ['Pour la farce :', 'Éplucher les pommes et la banane. Coupez les pommes en cubes et la banane en rondelles. Faire fondre une noisette de beurre dans une casserole, ajoutez les fruits coupés et l''eau. ', 'Laisser mijoter avec un couvercle jusqu''à ce que les fruits soit fondants.', 'Ajouter le sachet de sucre vanillé et la cannelle.', 'Laisser mijoter quelques minutes. Retirer la casserole du feu. ', 'Couper en 2 une feuille de brick en son centre. Prendre une moitié, la replier en 2. Disposer une cuillerée de farce au bout de la feuille de brick. Plier et rabattre la feuille de brick de manière à  former des triangles (comme pour les samoussas). ', 'Terminer en rabattant le surplus de feuille de brick sous le triangle.', 'Préparation du caramel au beurre salé :', 'Faire le caramel avec le sucre et l''eau dans une casserole.', 'Faire chauffer la crème au micro-onde.', 'Lorsqu''il brunit, hors du feu, verser la crème et mélanger.', 'Remettre sur le feu et ajouter le beurre coupés en dés.', 'Continuer à mélanger pendant 5 minutes. Laisser refroidir . ', 'Cuisson des croustillants :', 'Chauffer une cuillère à soupe d''huile dans une poêle, ajouter les triangles farcis et laisser dorer quelques minutes jusqu''à ce qu''il soit bien dorés.', 'Les essuyer avec du papier absorbant.', 'Disposer deux croustillants sur une assiette, une boule de glace vanille et disposer le caramel par dessus.'], ['Mixeur', 'Balance de cuisine', 'Casserole', 'Moule à tarte', 'Batteur électrique'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'caramel', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'Croustiilants pomme banane caramel au beurre salé', 'glace vanille', 'huile de tournesol', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:15:12.054428', [{'ingredient_id': '399404f2-26e1-45f3-8995-9fd5f1d7f98b', 'quantite': '4'}, {'ingredient_id': '5bb9c793-6eeb-44b3-9e28-82a1eb52da0d', 'quantite': ''}, {'ingredient_id': '9a608027-da40-41e1-b0df-79277d8a665b', 'quantite': ''}, {'ingredient_id': '93d368e8-ed52-41a8-a951-b776432b547f', 'quantite': '2'}, {'ingredient_id': '91344581-f40a-4937-b560-c109305bb76e', 'quantite': '1'}, {'ingredient_id': '3abc70a1-d84e-4102-8eac-7b37a4a73c49', 'quantite': '2 cuillères'}, {'ingredient_id': '721cc822-2415-426d-9721-be6d2fb1639d', 'quantite': '1'}, {'ingredient_id': 'e0707bb2-46da-4897-8114-87b983316151', 'quantite': '2 cuillères'}, {'ingredient_id': '663101d3-b4a7-434a-adb3-7ba632367f46', 'quantite': ''}, {'ingredient_id': '64de73b1-0168-4608-bd4d-474b0111faff', 'quantite': '40 g'}, {'ingredient_id': 'cae15ed4-b139-4753-b2b1-740c01aba339', 'quantite': '20 cl'}, {'ingredient_id': '983aa4ef-563c-4fa6-ad74-8f70f34590bc', 'quantite': '1.5 cuillères'}, {'ingredient_id': 'e6dc06d9-27e7-4620-b648-dfa2b9b41d23', 'quantite': '75 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336779, 'Rolls Nutella banane faciles', 'banane, Nutella, pain de mie, oeuf, lait, beurre', '10 min', ['A l''aide d''un rouleau à pâtisserie (ou des mains) aplatir les tranches de pain de mie.', 'Ensuite, étaler le Nutella sur chacune d''elle.', 'Découper des rondelles de bananes. ', 'Puis les disposer de façon à obtenir une ligne sur un seul côté des tranches.', 'Dans une assiette creuse, mélanger l''oeuf et le lait.', 'Préchauffer la poêle avec une noisette de beurre au fond.', 'Enrouler les tranches de pain de mie sur elles mêmes (obtention d''une forme de tube). Puis les rouler dans la préparation oeuf/lait.', 'Et enfin faire cuire les rolls 1 à 2 min par côté à la poêle à feu chaud.', 'Pour optimiser le résultat, saupoudrer avec du sucre glace.'], ['Batteur électrique', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'Rolls Nutella banane faciles', 'recettes', 'boisson', 'Nutella', 'dessert', 'plat de résistance', 'beurre', 'lait', 'cocktail', 'pain de mie'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:15:15.539891', [{'ingredient_id': '79a58f4d-d097-4888-b20c-30f50660edcb', 'quantite': '1'}, {'ingredient_id': '083da431-4ca3-4e7d-9040-6e88da2483bc', 'quantite': '2 cuillères'}, {'ingredient_id': '2d8238e1-69a3-41c8-9adc-2140fa2d1f26', 'quantite': '4'}, {'ingredient_id': '86d81ae5-fd49-4acf-bcd3-f53e8b68460b', 'quantite': '1'}, {'ingredient_id': 'a62c454e-dbb3-4ec9-9e07-2972df43218d', 'quantite': '1 cuillères'}, {'ingredient_id': 'f1debbc5-ecb4-439c-b419-243e21128d64', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (44455, 'Omelette sucrée à la banane', 'oeuf, colorant alimentaire, banane, sucre', '15 min', ['Battre les oeufs avec le colorant alimentaire et le sucre.', 'Faire cuire "l''omelette"...', 'Couper des petites tranches de bananes.', 'Couper l''omelette en petits ronds (ou en petits carrés).', 'Déposer une tranche de banane sur chaque tranche d''omelette...', 'Et régalez vous!'], ['Poêle', 'Économe', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Omelette sucrée à la banane', 'très facile', 'rapide', 'oeuf', 'plat', 'recette', 'colorant alimentaire', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'sucre', 'cocktail'], 'Dessert', b86d6503-b4a0-414c-b959-af715cf10dd8, '2025-09-26T15:15:19.659907', [{'ingredient_id': '57d9e703-624c-4ae4-bb4c-83bb4b1644c3', 'quantite': '4'}, {'ingredient_id': 'ec3f29aa-ce3b-4e7c-b30f-d8ccf63e64f0', 'quantite': ''}, {'ingredient_id': 'eceba63f-2582-4f1b-b282-d0bc32827873', 'quantite': '2'}, {'ingredient_id': '2163419f-7cb3-4fdc-8147-9db69df91ed4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57979, 'Gâteau à la banane à la poudre d''amandes', 'banane, farine, amandes en poudre, beurre, sucre de canne, oeuf, levure, sel', '10 min', ['Mélanger le sucre, le beurre fondu et la farine.', 'Ajouter les oeufs battus, la poudre d''amandes, la levure et la pincée de sel.', 'Enfin, incorporer au mélange les bananes écrasées.', 'Beurrer le moule avant de verser le mélange.', 'Mettre au four 40-45 min à 150°C, thermostat 5 (au bout de 40 minutes tester la cuisson à l''aide d''un couteau et remettre 5 minutes s''il reste de la pâte collée dessus).'], ['Râpe', 'Ouvre-boîte', 'Passoire', 'Couteau de chef', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'amandes en poudre', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'Gâteau à la banane à la poudre d''amandes', 'boisson', 'farine', 'sucre de canne', 'dessert', 'plat de résistance', 'gâteau à la banane', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:15:26.318138', [{'ingredient_id': '04aa79f1-4af4-4ef3-92f3-8055ba710781', 'quantite': '3'}, {'ingredient_id': '697dc4a3-0b3a-4249-8acd-18145222ea0e', 'quantite': '80 g'}, {'ingredient_id': 'b3bd937d-4306-424a-a0ef-af522e38a9a5', 'quantite': '125 g'}, {'ingredient_id': '4ec78887-c26e-4be7-84e1-7d51968fdc3d', 'quantite': '50 g'}, {'ingredient_id': '62de3ced-0c19-473f-8b08-81f9019081ac', 'quantite': '150 g'}, {'ingredient_id': '77cc0f86-3a98-407a-883c-c07323f060cb', 'quantite': '2'}, {'ingredient_id': 'ce70bbbe-da83-4921-8ed9-15436513a597', 'quantite': '1'}, {'ingredient_id': '09349048-fc02-4c22-8c53-9fc5f3f885ce', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14074, 'Rhum arrangé', 'rhum, vanille, cannelle, sucre de canne, banane', '25 min', ['Dans une bouteille vide, glisser les fruits au préalablement grossièrement découpés (vider les fruits de la passion et ne se servir que des graines, bien entendu !), ajouter les gousses de vanille fendues et la cannelle entière.', 'Ajouter un verre à moutarde de sucre liquide.', 'Compléter avec le rhum.', 'Patienter au moins 3 semaines.', 'Servir frais !'], ['Verre doseur', 'Pince de cuisine', 'Ouvre-boîte', 'Batteur électrique', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'cocktail rhum', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'vanille', 'dessert', 'plat de résistance', 'moyen', 'cannelle', 'cocktail', 'Rhum arrangé'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:15:29.768394', [{'ingredient_id': '0966dd38-2a38-42ab-8867-2a18f869dd26', 'quantite': '1 l'}, {'ingredient_id': '8f7c0cce-58b0-42f0-9996-25472cda72d6', 'quantite': '2'}, {'ingredient_id': '3bb3ed4c-5da3-4bad-aae2-1b5f8c17d41c', 'quantite': '3'}, {'ingredient_id': 'a9c65597-2676-4a4a-adb1-9f2c6335a719', 'quantite': '15 cl'}, {'ingredient_id': 'be67df22-4245-425e-937e-dcf928da527a', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (319790, 'Gâteau banane chocolat et céréales', 'cacao, oeuf, banane, sucre vanillé, sucre en poudre, lait, corn flakes', '15 min', ['Écraser les bananes en bouillie. Y ajouter le jaune d''oeuf et les deux sucres. ', 'Puis le cacao en poudre et enfin le lait. ', 'Bien mélanger, et ajouter en dernier les céréales dans un plat à tarte.', 'Préchauffer le four 5 min à 180°C (thermostat 6). ', 'Enfourner pendant 20 à 25 min. Le gâteau doit rester moelleux.', 'A déguster bien froid !'], ['Tire-bouchon', 'Fouet', 'Mixeur', 'Presse-agrumes', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'corn flakes', 'facile', 'bon marché', 'cacao', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'Gâteau banane chocolat et céréales', 'dessert', 'plat de résistance', 'sucre vanillé', 'gâteau au chocolat', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:15:33.302230', [{'ingredient_id': 'ee591e32-1636-4239-bbda-d6560a397b8c', 'quantite': '6 cuillères'}, {'ingredient_id': '7a738300-94c4-4b9b-a686-750e3b4c12d7', 'quantite': '1'}, {'ingredient_id': 'd4ec3459-7394-4755-96c9-aadbcf5961ce', 'quantite': '4'}, {'ingredient_id': 'd6e0eab3-4e78-4eea-90ce-3ba88ec3e1c4', 'quantite': '1'}, {'ingredient_id': 'e30f0a31-0107-4941-a318-66a6b88516a6', 'quantite': '100 g'}, {'ingredient_id': '172523a3-9e26-40ef-97ab-10c85536fc06', 'quantite': '40 cl'}, {'ingredient_id': 'fdc42d27-e057-4e47-9978-2fabc827cc47', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (67870, 'dessert à la banane', 'banane, citron, sucre, café soluble', '5 min', ['Mixer les 6 bananes avec le jus des citron, le sucre et le café soluble.', 'Augmenter/diminuer les proportions selon le goût de chacun.', 'Servir très frais.'], ['Couteau de chef', 'Râpe', 'Spatule', 'Batteur électrique', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'café soluble', 'sucre', 'cocktail', 'dessert à la banane'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:15:36.776595', [{'ingredient_id': '46fd72ea-b083-49eb-9f17-da7d1b4c7d00', 'quantite': '6'}, {'ingredient_id': '37b4ee88-a948-46db-8a51-129acc65f02c', 'quantite': ''}, {'ingredient_id': '72f40c1b-aaa4-4b1e-bd64-001f4097c41e', 'quantite': '30 g'}, {'ingredient_id': 'ad95aec3-c7fb-4f0a-9a4e-de424e5f2dad', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530695, 'Glace facile banane-fraise', 'banane, fraises, sucre glace, lait concentré sucré', '15 min', ['Je dépose les fruits lavés dans le bol du mixeur, j''ajoute le lait concentré et le sucre. 
Je mixe le tout.', 'Je verse dans un récipient et je le place au congélateur. Après 1h, je remue la crème avec une fourchette, en raclant bien les bords. Recommence cette opération environ 5 ou 6 fois, toutes les demi-heures.'], ['Poêle', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'lait concentré sucré', 'boisson', 'dessert', 'plat de résistance', 'Glace facile banane-fraise', 'sucre glace', 'cocktail'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T15:15:40.807982', [{'ingredient_id': 'c6af7034-09a0-47ad-9a70-dd83894c7df3', 'quantite': '1'}, {'ingredient_id': 'c3a133af-e384-471d-a9ed-ed088f94b050', 'quantite': '70 g'}, {'ingredient_id': 'fa02a227-949a-40a6-836b-ed1226fd723c', 'quantite': '50 g'}, {'ingredient_id': 'c0807466-268c-49b9-b1ae-3531f29cc8d2', 'quantite': '150 ml'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (230277, 'Crème banane raisin et sa ganache chocolatée', 'banane, raisin, rhum, mascarpone, crème fraîche, sucre, chocolat noir, beurre', '15 min', ['Faire revenir les bananes coupées en rondelles, dans le beurre et les faire dorer. Ajouter les raisins et le rhum. ', 'Battre au fouet le mascarpone puis 20 cl de crème fraîche et enfin le sucre jusqu''à ce qu''à atteindre une consistance légère. Partager les fruits dans 4 ramequins, et les recouvrir de la crème préparée. Mettre au réfrigérateur. ', 'Préparation de la ganache : faire fondre le chocolat avec le reste de crème fraîche, fouetter fermement, puis laisser un peu refroidir.', 'Lorsque la ganache est moins chaude, recouvrir les crèmes avec celle-ci. Remettre au frais pendant minimum 2 heures avant dégustation.'], ['Mixeur', 'Économe', 'Planche à découper'], ['ganache', 'raisin', 'entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'crème fraîche', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'beurre', 'Crème banane raisin et sa ganache chocolatée', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:15:45.125937', [{'ingredient_id': 'ced80e44-9ee8-4d00-b003-d89bc4e7b953', 'quantite': '2'}, {'ingredient_id': 'c95c0610-7133-4180-be51-07dc3240915a', 'quantite': '50 g'}, {'ingredient_id': 'a1a6c608-f623-4f2f-b954-706c6e2adb41', 'quantite': '1 cuillères'}, {'ingredient_id': '1141025c-efe1-4dd5-b504-6ea1f88d9fbf', 'quantite': '250 g'}, {'ingredient_id': '729e1257-4c10-4c8c-8bd2-980698a2d013', 'quantite': '30 cl'}, {'ingredient_id': '9e1a8f31-3baa-4954-b4f6-ca89c48aeb68', 'quantite': '2 cuillères'}, {'ingredient_id': '5a099fce-2a86-486a-816d-dec1ef2596f1', 'quantite': '100 g'}, {'ingredient_id': 'bb41b581-9715-4441-9787-0720fea354b5', 'quantite': '10 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530908, 'Gnocchi de banane plantain, poulet et sauce chien', 'blanc de poulet, sel, poivre, vinaigre, cive, tomate, eau, huile, oignon rouge, ail, huile de tournesol, banane plantain, sel, jaune d''oeuf, noix de muscade moulue, farine', '60 min', ['Pelez l’ail, les cives et l’oignon rouge puis émincez-les.', 'Déposez le tout dans un petit saladier. Salez, poivrez, ajoutez le jus du citron et le vinaigre puis l’huile. Mélangez, versez l’eau chaude et émulsionnez à la fourchette.', 'Laisser le tout reposer au moins 30 min', 'Bien laver les bananes sous un filet d''eau. Couper les extrémités des bananes, puis les couper en deux. Réaliser une légère entaille au couteau le long de chaque morceaux (on conserve la peau).', 'Cuire pour 20 minutes environ dans un grand volume d''eau salée (vérifier la cuisson avec un couteau). Au terme de la cuisson, retirer la peau des bananes et réserver dans un saladier. Passer au presse-purée.', 'Ajouter une pincée de noix de muscade, du sel, l''huile, le jaune d’œuf et la farine. Bien mélanger avec les mains, pétrir et former une boule.', 'Déposer la pâte sur un plan de travail fariné et diviser en 4 parts égales. Former 4 longs boudins de 2cm de diamètre environ. Couper en tronçons de 2 cm. Façonner les gnocchis en faisant rouler chaque tronçon sur le dos d''une fourchette.', 'Faire cuire dans un grand volume d''eau bouillante et salée. Quand les gnocchis remontent à la surface, c''est cuit.', '
Faire cuire la viande, assemblez le tout et régalez vous !!'], ['Ouvre-boîte', 'Moule à tarte', 'Économe'], ['boisson', 'recettes', 'entrée', 'recettes de cuisine', 'plat', 'blanc de poulet', 'Gnocchi de banane plantain', 'dessert', 'confiserie', 'poulet et sauce chien', 'recette', 'testées', 'Gnocchis', 'plat de résistance', 'cocktail', 'cuisine', 'moyen', 'facile'], 'Plat principal', 6fafece9-ffc6-418b-8343-7514a526c275, '2025-09-26T15:15:49.256541', [{'ingredient_id': 'fec002e8-d388-46c0-bbab-2a0df0276e31', 'quantite': '2'}, {'ingredient_id': '3b5c92ce-220d-491c-88f5-84bcd7ad367d', 'quantite': ''}, {'ingredient_id': '3df84c48-ffd6-4b4d-9eab-89711a022cdf', 'quantite': ''}, {'ingredient_id': 'ec345790-82ca-4cef-b4fe-d3d8f570b85d', 'quantite': '1 cuillères'}, {'ingredient_id': '38b5cedb-0d7b-43e0-a90f-a3e76fca5688', 'quantite': '3'}, {'ingredient_id': '79242645-e52e-4e0b-a5fc-0277907e71a8', 'quantite': '2'}, {'ingredient_id': '6e42368d-c3fa-486c-a06f-f5adfc300100', 'quantite': '5 cl'}, {'ingredient_id': '8095c632-2c41-44d5-8c51-a41197b2054a', 'quantite': '15 cl'}, {'ingredient_id': '0b83bbc0-7dcf-4e43-b2bb-0626d7889211', 'quantite': '1'}, {'ingredient_id': '7ea73439-eb85-4891-9899-0c8f9fa32e57', 'quantite': '1'}, {'ingredient_id': '80e39b5a-69cb-4185-828e-3ef310e1942f', 'quantite': '1 cuillères'}, {'ingredient_id': 'f19eaa2b-0820-472a-a9fe-f3074b6ea89a', 'quantite': '500 g'}, {'ingredient_id': '33cd2389-0bef-4d1e-966c-56fb107727f4', 'quantite': ''}, {'ingredient_id': 'cf8bddb6-9197-494e-be16-c9ea5cae2fb0', 'quantite': '1'}, {'ingredient_id': '55efe26d-8992-4adf-802d-f87387d83af5', 'quantite': '1'}, {'ingredient_id': '4b4cc098-4853-4235-8200-89b149c3b537', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (325081, 'Tarte banane et chocolat, délicatement parfumée à la noix de coco', 'pâte sablée, banane, citron, crème liquide, chocolat noir, beurre tendre, noix de coco, oeuf', '20 min', ['Faites préchauffer le four à 150°(thermostat 5). Déposez la pâte sablée dans un moule à tarte.', 'Épluchez et découpez les bananes en rondelles. Arrosez-les avec le jus de citron, puis réservez-les au frais.', 'Dans une casserole à fond épais, mélangez sur feu doux la crème liquide et le chocolat cassé en petits morceaux.', 'Dans un saladier, travaillez énergiquement à l''aide d''une spatule le beurre ramolli, la noix de coco en poudre et l''oeuf. ', 'Incorporez la crème chocolatée à cette préparation en mélangeant vivement jusqu''à l''obtention d''une pâte homogène.', 'Versez la crème chocolat-coco sur le fond de tarte, puis disposez par dessus les rondelles de bananes. Enfournez pendant +/- 35 min (en fonction de votre four). Laissez tiédir avant de servir.'], ['Fouet', 'Poêle'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'Tarte banane et chocolat', 'testées', 'beurre tendre', 'très facile', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'chocolat noir', 'citron', 'noix de coco', 'délicatement parfumée à la noix de coco', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:15:52.798037', [{'ingredient_id': 'ed8cc222-7347-4701-89fd-e04be3fa9714', 'quantite': '1'}, {'ingredient_id': 'dcb6d63d-deaa-47fa-a1bd-4b88f1f185e6', 'quantite': '2'}, {'ingredient_id': 'cd46890d-9251-474a-90cd-473361253022', 'quantite': '1'}, {'ingredient_id': '0fef1c65-21a5-44d1-ae19-54b788c77555', 'quantite': '20 cl'}, {'ingredient_id': '7526935d-7cbd-4a08-ab2c-7648522b3024', 'quantite': '50 g'}, {'ingredient_id': '4bc0993c-c37f-4a00-8a0c-c5a188895371', 'quantite': '75 g'}, {'ingredient_id': 'e348cd8a-08f1-4bf9-bbf1-d2043bb72a8d', 'quantite': '75 g'}, {'ingredient_id': '0635e81d-4400-41b5-b4f4-f628a23894bd', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15382, 'Bananier', 'banane, chocolat pâtissier, oeuf, sucre en poudre, farine, beurre, moules', '15 min', ['Préchauffez le four à thermostat 5/6 (160°C).', 'Faites fondre le chocolat avec le beurre sur feu très doux.', 'Ajoutez un à un les oeufs entiers, le sucre et la farine en mélangeant bien à chaque fois.', 'Beurrez et farinez votre moule et versez la moitié de la préparation.', 'Pelez les bananes, coupez-les en rondelles et disposez-les dans le moule pour recouvrir le chocolat.', 'Versez le reste de la préparation et faites cuire votre gâteau 35 min à thermostat 5/6.', 'Laissez refroidir avant de déguster.'], ['Presse-agrumes', 'Râpe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'chocolat pâtissier', 'cuisine', 'moules', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'cocktail', 'Bananier'], 'Dessert', 9eeea802-9de5-4ad0-8abc-0f652ac1a55e, '2025-09-26T15:16:00.116079', [{'ingredient_id': '248d823c-5905-463a-9481-8f8b667fde01', 'quantite': '2'}, {'ingredient_id': '283bef07-d45b-4d5e-8bb8-62b24a2af981', 'quantite': '200 g'}, {'ingredient_id': 'bb65c510-c13e-4894-a4cb-2d615e4497b2', 'quantite': '4'}, {'ingredient_id': 'cb290f84-4121-403f-a38f-4afc9011cf64', 'quantite': '100 g'}, {'ingredient_id': 'a7b31c77-08ec-45ff-92ed-258a0c9ce2cd', 'quantite': '50 g'}, {'ingredient_id': '07ca1c53-b47d-4dc5-845c-100ca9e325ef', 'quantite': '150 g'}, {'ingredient_id': '1aff3144-e4a9-45fd-9538-eab9cf3c2f36', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12225, 'Fondue au chocolat noir', 'chocolat noir, chocolat, crème, banane, cerises, pomme, fraises', '30 min', ['Mélanger le chocolat et la crème dans un caquelon et faire cuire à feu doux afin de fondre le chocolat.', 'Couper les fruits en morceaux pouvant tenir au bout d''une fourchette.', 'Une fois que le chocolat et la crème sont mélangés, poser le caquelon sur un réchaud et venir tremper les morceaux de fruits dedans.'], ['Poêle', 'Batteur électrique', 'Pince de cuisine', 'Tire-bouchon', 'Passoire'], ['Fondue au chocolat noir', '', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'rapide', 'plat', 'fraises', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'pomme', 'moyen', 'cocktail', 'cerises'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:16:03.636567', [{'ingredient_id': '091279f3-26c1-4e19-898d-840a7a9d2a4c', 'quantite': '500 g'}, {'ingredient_id': '9afe1027-5abf-467d-8cbf-9235544d5f1d', 'quantite': '300 g'}, {'ingredient_id': 'cd285f63-8aad-489b-a96f-611206ec6a0e', 'quantite': '3'}, {'ingredient_id': 'c92ae560-5528-4a09-b840-794a87fe1543', 'quantite': '2'}, {'ingredient_id': '4eaf322c-57be-469b-8a64-6363299ca3b2', 'quantite': '1'}, {'ingredient_id': 'befe4569-632f-4002-ba3b-7250456c6602', 'quantite': ''}, {'ingredient_id': '43930589-3a16-4812-947a-00aecc09797f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (88114, 'Bananes rôties au gingembre', 'banane, citron vert, cassonade, beurre, gingembre, rhum, glace vanille', '10 min', ['Préchauffer le four à 220°C (thermostat 7-8).', 'Eplucher les bananes, les couper en deux dans le sens de la longueur et les ranger sur une seule couche dans un plat beurré ; puis arroser avec le jus de citron.', 'Mélanger la cassonade et le gingembre, éparpiller sur les bananes ainsi que le beurre en parcelles. Cuire au four 15 minutes.', 'Chauffer le rhum puis verser sur les bananes et flamber. ', 'Déguster avec une glace à la vanille.'], ['Passoire', 'Spatule', 'Couteau de chef', 'Casserole', 'Poêle'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'cassonade', 'facile', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'citron vert', 'Bananes rôties au gingembre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:16:07.213416', [{'ingredient_id': '2fe7ef0b-efb6-4531-8348-3ec85c223416', 'quantite': '4'}, {'ingredient_id': '164ded21-8982-473f-9488-bc5adfeb4ee6', 'quantite': '1'}, {'ingredient_id': 'bff2fdad-6c50-4eba-bc0e-5e0d42910159', 'quantite': '80 g'}, {'ingredient_id': 'b017d302-3672-4684-ad99-38cb510cdc3e', 'quantite': '50 g'}, {'ingredient_id': '6b3510b4-9e2e-463a-bc26-79b63c508ce3', 'quantite': '2 cuillères'}, {'ingredient_id': 'ac41facd-bf1a-48a1-9776-a45ca5d01dd6', 'quantite': '5 cl'}, {'ingredient_id': 'bacedf2f-9f33-4756-93bc-82ad57bd5dd2', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21674, 'Cookies à la banane', 'banane, farine, beurre, levure chimique, sel, oeuf, sucre en poudre, vanille, chocolat, noix', '15 min', ['1) préchauffez le four à 190°C (et pas plus!!). ', '2) mélangez la farine, la levure, le sel. ', '3) Pelez les bananes et écrasez-les à la fourchettes. ', '4) battez le beurre (bien ramolli) avec le sucre ; ajoutez la banane écrasée, l''oeuf, la vanille. Mélangez bien. Ajoutez le mélange de farine. ', '5) Ajoutez les pépites (+ noix). La pâte doit être molle mais pas trop liquide. ', '6) Faites des petits tas à l''aide de 2 cuillères à café (de la taille d''une noix, pas plus!!) sur une plaque (soit beurrée soit recouverte de papier sulfurisé, + facile!). ', '7) Faites cuire env 6/7 mn (selon votre four). ', 'Pour la 1ère fournée, surveillez bien, ça cuit très vite. Retirez les cookies dès qu''ils sont bruns à la base.'], ['Couteau de chef', 'Passoire', 'Balance de cuisine', 'Louche', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'chocolat', 'Cookies à la banane', 'très facile', 'bon marché', 'cookie', 'rapide', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'noix', 'recettes', 'boisson', 'farine', 'vanille', 'dessert', 'plat de résistance', 'beurre', 'cocktail'], 'Dessert', d7606c9a-f132-402a-bf89-fb09b64f5ca2, '2025-09-26T15:16:13.910834', [{'ingredient_id': 'bb987858-b966-4de2-8011-29ee1bee8444', 'quantite': '200 g'}, {'ingredient_id': '2907e7a8-fa3a-49ae-9dfe-786fdaaa19ac', 'quantite': '175 g'}, {'ingredient_id': 'b6473c8d-d6a8-4894-8e39-3f2dd281717a', 'quantite': '75 g'}, {'ingredient_id': '6b199b77-bfd8-4146-95c1-42d772d24dd3', 'quantite': '5.5 g'}, {'ingredient_id': '5f95e019-5efe-47d0-82c3-84b41fb73c39', 'quantite': '1'}, {'ingredient_id': '4ce62adc-f980-4edf-a8a3-b6f712fae591', 'quantite': '1'}, {'ingredient_id': '81c2fb17-9c05-4163-a491-4bdcafe343c2', 'quantite': '130 g'}, {'ingredient_id': '4fbb8db6-07ac-4ef9-a8ea-ff69bde095fb', 'quantite': '1 cuillères'}, {'ingredient_id': '562641a6-a631-4367-a27e-0a9ff2d85a2d', 'quantite': '160 g'}, {'ingredient_id': '63ea3b50-d4c6-40fa-83cb-1980fcf71019', 'quantite': '80 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392556, 'Crumble aux fruits sans farine et sans beurre', 'pomme, banane, poudre de noisette, poudre de coco, farine de maïs, huile de coco, cannelle', '15 min', ['Préchaffer le four à 180°.', 'Couper les fruits et les disposer dans 2 ramequins huilés. Mélanger les poudres de coco et de noisette, ainsi que la maizena, et la cannelle (selon les goûts : une cuillère à café ou plus).', 'Ajouter l''huile de coco (un peu solide si possible, si besoin la réfrigérer quelques minutes pour obtenir une texture de beurre pour melanger plus facilement).', 'Mélanger avec les doigts pour obtenir une sorte de sable grossier. Ajouter ce mélange sablé sur les fruits.', 'Cuire 30 minutes, puis laisser dans le four entrouvert jusqu''à complet refroidissement, pour un crumble croustillant.'], ['Rouleau à pâtisserie', 'Fouet', 'Casserole', 'Poêle', 'Ouvre-boîte'], ['entrée', 'banane', 'Crumble aux fruits sans farine et sans beurre', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'poudre de noisette', 'recette', 'cuisine', 'recettes', 'boisson', 'poudre de coco', 'dessert', 'plat de résistance', 'pomme', 'huile de coco', 'farine de maïs', 'cannelle', 'crumble', 'cocktail'], 'Dessert', 35e9e49f-b8fb-4942-836e-be1f503bc97f, '2025-09-26T15:16:17.248869', [{'ingredient_id': 'f1c22995-9e77-495d-a262-3afb9e690a43', 'quantite': '1'}, {'ingredient_id': 'bbb41e7a-0b78-4487-9d1d-d92b407747db', 'quantite': '1'}, {'ingredient_id': '382a0c66-ddb9-49a0-9c87-1af852c2db99', 'quantite': '30 g'}, {'ingredient_id': 'a8eb6969-42cc-4c46-bc0a-98e6d3b1ad18', 'quantite': '30 g'}, {'ingredient_id': '28559f5b-1a18-4b25-9ba7-5aec7ce6a36c', 'quantite': '30 g'}, {'ingredient_id': 'c54728fc-c497-41ac-b984-656a5a248644', 'quantite': '2 cuillères'}, {'ingredient_id': 'ecf70ddf-7afe-48e5-a8c2-9b1a68211501', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (328286, 'Brownies chocolat blanc banane', 'oeuf, chocolat blanc, sucre, farine, banane, sucre vanillé', '10 min', ['Mélangez le sucre, la farine et le sachet vanillé.', 'Mixez la banane avec l''oeuf puis l''ajouter au mélange le sucre et la farine.', 'Faire fondre le chocolat blanc puis l''incorporer au reste de la préparation', 'Mettre au four 20 à 25 min maximum à 180°C (thermostat 6).'], ['Mixeur', 'Spatule', 'Couteau de chef', 'Pince de cuisine', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'Brownies chocolat blanc banane', 'confiserie', 'testées', 'brownie', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'chocolat blanc', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:16:20.756158', [{'ingredient_id': 'd80acefb-ea17-4146-9da2-30d453d8f9b1', 'quantite': '1'}, {'ingredient_id': '1069f5e9-1927-4df3-a81a-b55b907714e6', 'quantite': '200 g'}, {'ingredient_id': '3dcf6ed8-45ec-4db3-9932-3f5fc9103360', 'quantite': '80 g'}, {'ingredient_id': '8fec7190-c50f-4488-8c15-c4d29e7d200b', 'quantite': '110 g'}, {'ingredient_id': '1c0b538b-1768-43d2-b2c0-867db87870c7', 'quantite': '2'}, {'ingredient_id': '213d70ae-e1c3-47c3-b3ab-c4d3258bcaab', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (223987, 'Pizza banane coco chocolat', 'chocolat pâtissier, crème liquide, banane, noix de coco, cassonade, pâte à pizza', '10 min', ['Préchauffer le four à 210°C (thermostat 9).', 'Faire fondre le chocolat au micro-onde 30 seconde puissances maxi.', 'A la sortie du micro-onde, bien mélanger pour finir de faire fondre le chocolat et ajouter la crème liquide.', 'Étaler le chocolat sur la pâte à pizza.', 'Couper les bananes en rondelles et les disposer sur le chocolat. Saupoudrer la noix de coco sur la pizza et faire la même chose avec la cassonade.', 'Enfourner à four très chaud 270°C (thermostat 9) pendant 4 à 7 min.', 'Déguster tiède.'], ['Poêle', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'Pizza banane coco chocolat', 'recettes', 'pâte à pizza', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'noix de coco', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:16:24.830058', [{'ingredient_id': 'cd3bc910-f8c3-463e-a287-be69c38ce6e7', 'quantite': '100 g'}, {'ingredient_id': '8564df94-1c63-42cc-b275-a7964375381e', 'quantite': '2 cuillères'}, {'ingredient_id': 'd89e6021-491c-4738-a566-180bc8d839e3', 'quantite': '2'}, {'ingredient_id': 'a24bbc95-3cca-4c9e-bf7d-017a6aea2ed8', 'quantite': '3 cuillères'}, {'ingredient_id': 'a8385f33-4055-418a-9433-24406a6db4ca', 'quantite': '2 cuillères'}, {'ingredient_id': 'ed11a293-b9ab-483f-bd6d-43faf1d0db7b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58118, 'Poulet Lulu façon africaine', 'poulet, lait de coco, oignon, banane, pomme, concentré de tomates, curry, gingembre, noix de coco, raisins secs, arachide', '20 min', ['Faire revenir le poulet dans un peu d''huile jusqu''à qu''il soit doré.', 'Le retirer.', 'Faire revenir les oignons hachés et y ajouter les pommes et les bananes coupés en morceaux.', 'Rajouter le poulet.', 'Ajouter le lait de coco, la tomate concentrée, le curry et le gingembre.', 'Laisser mijoter à feu doux pendant au moins 2h.', 'Mettre la noix de coco, les raisins secs et les cacahuètes pilées dans des petits bols.', 'Accompagner votre poulet de riz.'], ['Passoire', 'Verre doseur', 'Poêle'], ['', 'lait de coco', 'gingembre', 'poulet', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'concentré de tomates', 'très facile', 'bon marché', 'plat', 'recette', 'Poulet Lulu façon africaine', 'cuisine', 'arachide', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'raisins secs', 'noix de coco', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:16:28.352663', [{'ingredient_id': '5b4ea901-899e-4608-8496-6abee3967739', 'quantite': '1.5 kg'}, {'ingredient_id': 'fc394997-291b-47eb-bcc5-1f0304558544', 'quantite': ''}, {'ingredient_id': '66470c6e-5d8a-4b1f-aee0-6fb6fc8879d3', 'quantite': '3'}, {'ingredient_id': 'ced1aea1-bc04-4d9a-9592-7f1996af46f1', 'quantite': '2'}, {'ingredient_id': '2ace78ad-e16c-4470-8eea-eb6b72017eb1', 'quantite': '2'}, {'ingredient_id': '5608ebc1-bf32-4b19-a2b2-0c4d6ad3b936', 'quantite': '1 cuillères'}, {'ingredient_id': 'b42b7b61-5f9a-4d3b-b6e4-25dbf6f48169', 'quantite': '2 cuillères'}, {'ingredient_id': '19c216f7-d15d-41e1-943e-199bf9d6d35a', 'quantite': '1 cuillères'}, {'ingredient_id': 'de6f307f-e91a-4852-a973-ce5f335e6ce0', 'quantite': ''}, {'ingredient_id': '4e0e71dc-ebd3-471d-a051-4346bd6048d7', 'quantite': ''}, {'ingredient_id': '22181731-813a-478f-a187-006b83699eac', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12414, 'Muffins aux bananes et au gingembre', 'farine, gingembre, cassonade, beurre, miel, lait, oeuf, banane', '20 min', ['Préchauffer le four à 210°C. Tamiser la farine et le gingembre.', 'Incorporer la cassonade.', 'Creuser un petit puits au centre du mélange. Mettre le beurre et le miel dans une casserole et faire fondre à feu doux.  ', 'Retirer du feux et ajouter à ce mélange les œufs et le lait. Bien fouetter.', 'Ajouter le mélange à la farine. Bien remuer sans trop travailler la pâte, elle doit être grumeleuse.', 'Mettre dans des moules à muffins préalablement beurrés. Cuire pendant 20 minutes à four moyen (180°C/thermostat 6).'], ['Râpe', 'Spatule', 'Couteau de chef'], ['gingembre', 'Muffins aux bananes et au gingembre', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'muffin', 'beurre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:16:32.037228', [{'ingredient_id': '84a34ab7-796f-44f4-b148-cb3f497b9fea', 'quantite': '300 g'}, {'ingredient_id': '6b7f0c95-b53e-4a75-999c-39ef9603f124', 'quantite': '1 cuillères'}, {'ingredient_id': '0fd48142-59ed-4990-b97b-3831760fcc79', 'quantite': '115 g'}, {'ingredient_id': '430497fd-8e2f-445e-a143-406760eb8653', 'quantite': '60 g'}, {'ingredient_id': '486ff40d-e8e4-453d-bdc6-ebca08bfa27c', 'quantite': '2 cuillères'}, {'ingredient_id': 'd47d222b-3607-454b-9758-94b80837b70b', 'quantite': '125 ml'}, {'ingredient_id': 'f365e76c-4e88-405c-911f-bf558f821602', 'quantite': '2'}, {'ingredient_id': '8274c792-95e3-457c-9682-ea24dd52b9c3', 'quantite': '240 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68059, 'Délice de bananes', 'banane, sucre en poudre, cannelle, rhum, beurre', '5 min', ['Couper les bananes en deux avec la peau, les mettre dans un plat allant au four. Saupoudrer de sucre en poudre et de cannelle, déposer quelques noisettes de beurre sur le dessus des bananes.', 'Arroser de rhum et mettre au four pendant environ 20 min à 150°C (thermostat 5).', 'C''est un délice !'], ['Économe', 'Râpe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'Délice de bananes', 'très facile', 'bon marché', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'cannelle', 'cocktail'], 'Dessert', 363a528a-5fe0-48da-a205-be02a87d3f42, '2025-09-26T15:16:36.149028', [{'ingredient_id': '75c7401e-c00c-48f3-9255-fcfc22c31ec5', 'quantite': '2'}, {'ingredient_id': '42019a27-b661-4fdf-bdd8-4f16d235a0c7', 'quantite': '3 cuillères'}, {'ingredient_id': 'b982351b-b9ff-4e1e-9bbb-c9c75cc7df4e', 'quantite': ''}, {'ingredient_id': 'a9942bf2-77a9-47c3-99f5-7cf68981885c', 'quantite': '3 cuillères'}, {'ingredient_id': 'bf25505f-cec6-47c3-b9bf-f7aba601cffc', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (229056, 'Gâteau dulce de leche banane choco', 'yaourt, sucre, beurre, farine, oeuf, levure chimique, chocolat pâtissier, crème, banane', '15 min', ['J''ai réalisé cette recette en Argentine où l''une des grandes spécialités est le dulce de leche qu''on trouve en France sous le nom de crème ou confiture de lait.', 'Recette très facile et délicieuse.', 'Première chose, faites préchauffer le four à 200°C (thermostat 6-7).', 'Dans un bol versez le pot de yaourt, veillez à conservez le pot qui vous servira d''outils de mesure pour la suite de la recette.', 'Après avoir nettoyé et séché le pot, mesurer une dose de sucre que vous ajouter dans le bol et mélanger.', 'Ajoutez 3 pots de farine. Continuez de mélanger et faites fondre pendant ce temps les 50g de beurre qui une fois fondus peuvent s''ajouter au mélange.', 'Ajouter les 3 oeufs entiers, puis le demi sachet de levure chimique.', 'Si vous n''avez pas de pépites de chocolat, une tablette de chocolat noir de cuisson fait tout à fait l''affaire. Il suffit de la couper en petits morceaux avec un grand couteau de cuisine.', 'Ajoutez donc les 100 g de chocolat concassé et les cuillères à soupe de dulce de leche ou confiture de lait.', 'Une fois que le mélange est homogène et lisse, le verser dans un plat à gâteau beurré au préalable.', 'Pour ajouter une note esthétique et gustative, couper en tranches relativement fines les 2 bananes, environ 3mm. Les disposer sur la pâte à la manière qu''il vous plaira.', 'Vous pouvez désormais enfourner votre mélange. 35min plus tard retirer le gâteau du four et attendez qu''il refroidisse pour le démouler.', 'Bonne dégustation'], ['Spatule', 'Balance de cuisine', 'Planche à découper', 'Couteau de chef', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'Gâteau dulce de leche banane choco', 'yaourt', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'crème', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:16:39.734163', [{'ingredient_id': 'a84503c0-6c72-460c-9a06-18edfc4c1b2f', 'quantite': '1'}, {'ingredient_id': '4e3f59c9-3968-4845-b0aa-1c9ba4199f28', 'quantite': '1'}, {'ingredient_id': '18e5d678-0335-4dc9-a326-6a834a6fde57', 'quantite': '50 g'}, {'ingredient_id': '8c5bb432-0c3f-47bc-bc63-91b789bd79c2', 'quantite': '3'}, {'ingredient_id': '20a9b9d1-8402-492b-909d-a1de76594d77', 'quantite': '3'}, {'ingredient_id': '5b8df557-fcea-4655-8e46-2481b50d7e8c', 'quantite': ''}, {'ingredient_id': '95b1755f-0f05-4240-98c1-d87c71b8dc05', 'quantite': '100 g'}, {'ingredient_id': '7f9aa07b-8910-4ad9-ba94-286a1000ab94', 'quantite': '2 cuillères'}, {'ingredient_id': '0133666f-219b-4af2-a278-7cce97a88a26', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (343954, 'Clafoutis léger bananes poires et chocolat sans beurre', 'farine, maïzena, oeuf, lait, sel, sucre, sucre vanillé, banane, poire, chocolat, calvados', '15 min', ['Je verse la farine dans un saladier et j''y mets : le sucre + le sucre vanillé + le sel + la maïzena et les oeufs et le calva (facultatif).', 'Je mélange le tout délicatement avec un fouet.', 'Quand le mélange s''épaissit, je verse progressivement le lait, afin d''avoir une pâte fluide et sans grumeaux.', 'Je coupe en rondelles les 2 bananes ou 3 suivant la grosseur.', 'J''épluche les 2 poires et les coupe dans le sens de la longueur.', 'Je prends un plat à gratin ou je mets une feuille de papier sulfurisée (pour éviter de mettre du beurre).', 'Je répartis au fond les bananes, les poires et le chocolat raclé en copeau avec un économe (ou vous mettez quelques pépites).', 'Pour finir je verse délicatement la pâte et j''enfourne à four chaud (thermostat : 6/7 ) 200°C pendant 35 minutes.'], ['Couteau de chef', 'Pince de cuisine', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'chocolat', 'poire', 'très facile', 'Clafoutis léger bananes poires et chocolat sans beurre', 'maïzena', 'bon marché', 'oeuf', 'plat', 'calvados', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'clafoutis', 'lait', 'sucre', 'cocktail'], 'Dessert', ae3d3990-c774-48a6-953f-67bb5d836b6c, '2025-09-26T15:16:43.281460', [{'ingredient_id': 'c8e963e3-b0d3-4855-8bc7-887cc64f6e56', 'quantite': '80 g'}, {'ingredient_id': 'e756315e-86f8-4dc0-9967-55ce71e13eee', 'quantite': '40 g'}, {'ingredient_id': '96658985-2e1d-4b34-b922-41a36d7ea141', 'quantite': '2'}, {'ingredient_id': '713c75a0-9d78-4c8b-99ac-5cac11041864', 'quantite': '40 cl'}, {'ingredient_id': 'a97e8f2e-d9ee-4972-9864-a87750e5c043', 'quantite': '1'}, {'ingredient_id': '4c935707-f584-4e21-a918-1169377beb50', 'quantite': '100 g'}, {'ingredient_id': '8333337c-6537-4b65-a653-dc6655fb22fe', 'quantite': '2'}, {'ingredient_id': '57aa64bb-3a5a-4742-9021-0cc68304439d', 'quantite': '2'}, {'ingredient_id': 'a29edff0-8309-46d5-adb4-044780df63f6', 'quantite': '2'}, {'ingredient_id': '64ae4992-fd0e-4dab-9fae-993bb4396c9b', 'quantite': '3'}, {'ingredient_id': 'd340ca0d-b569-436c-b027-5f66968cc70a', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32510, 'Cake du petit déjeuner', 'farine, farine complète, sucre roux, oeuf, lait, margarine, levure, cannelle, banane, pruneau, noix de coco rapée, noix', '15 min', ['Tamiser la farine, la levure et la cannelle. ', 'Ajouter le sucre + la margarine fondue. ', 'Ajouter les oeufs battus un par un. ', 'Ajouter le lait. ', 'Couper la banane en rondelles, les pruneaux en morceaux, faire mariner dans une cuillère à soupe de rhum + 1 d''eau. ', 'Ecraser la banane avec les pruneaux. ', 'Ajouter à la pâte, rajouter la noix de coco et les 3 noix décortiquées. ', 'Cuire 40 mn à 200°C . ', 'Servir tiède ou toasté avec du chèvre.'], ['Planche à découper', 'Tire-bouchon', 'Mixeur', 'Moule à tarte', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'pruneau', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'noix', 'levure', 'recettes', 'boisson', 'farine', 'noix de coco rapée', 'margarine', 'dessert', 'Cake du petit déjeuner', 'plat de résistance', 'farine complète', 'cannelle', 'lait', 'cocktail', 'sucre roux'], 'Dessert', 13f52105-eb28-4716-b80a-7ddf3c94d4e7, '2025-09-26T15:16:46.833643', [{'ingredient_id': 'e6a35c29-ec1f-4942-98e5-cc92aafddbbb', 'quantite': '60 g'}, {'ingredient_id': '9b0b3610-2182-4233-9f07-9edb700bd207', 'quantite': '100 g'}, {'ingredient_id': 'e6127c64-10f1-4fca-8c84-07cfaa86b9de', 'quantite': '90 g'}, {'ingredient_id': 'eb296d7e-88e8-4f9e-b991-64ae012b7ab9', 'quantite': '2'}, {'ingredient_id': '6f9890eb-46d0-4d5d-ade8-2f20dd47a2fa', 'quantite': '70 ml'}, {'ingredient_id': '58073643-6ac0-4b1f-8c9c-cd63bd7af4b1', 'quantite': '20 g'}, {'ingredient_id': 'c808b2a3-ff5c-4ab5-887b-7a725b073bfc', 'quantite': '1'}, {'ingredient_id': '47c7f75e-a37a-4cc3-9f48-3b17dd2c4875', 'quantite': ''}, {'ingredient_id': '14acaef2-3203-4cee-9481-bd04ea21fb4c', 'quantite': '1'}, {'ingredient_id': '24c13e91-4bdf-4c30-96c4-a997f7df271f', 'quantite': '50 g'}, {'ingredient_id': '0af6bc90-0636-4d4a-8974-7ff41cf1544e', 'quantite': ''}, {'ingredient_id': '478b20c8-0ab0-477c-8b10-58007a390907', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36137, 'Banane au miel (au four)', 'banane, beurre, miel, citron, crème fraîche', '2 min', ['Peler les bananes et les couper en 2 dans le sens de la longueur.', 'Préchauffer le four à 250°C (thermostat 8).', 'Beurrer un plat à gratin, et y déposer les demi-bananes. Mettre des petits morceaux de beurre sur les bananes. Les arroser de miel et de jus de citron.', 'Laisser cuire au four pendant 20 min. Retirer du four et laisser tièdir avant dégustation.', 'Verser la crème dans un bol et la servir avec les bananes.'], ['Casserole', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'Banane au miel (au four)', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'beurre', 'cocktail'], 'Dessert', ce2acc24-7f31-4c7e-bc89-8bf990d93676, '2025-09-26T15:16:50.367687', [{'ingredient_id': '0ac8a2aa-7d56-4d9b-b763-04312b14daf0', 'quantite': '4'}, {'ingredient_id': 'cb5f06c2-3c6a-4e36-92f9-cc1ac38edbaa', 'quantite': '40 g'}, {'ingredient_id': '221be770-ebc3-4ae2-87e7-e1f9016d7e26', 'quantite': '2 cuillères'}, {'ingredient_id': 'bb6b4266-7518-43b5-8961-4188a4a9a1ab', 'quantite': ''}, {'ingredient_id': 'bc9dc3e0-ddff-4ca5-aa27-504c0cdec2d3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42212, 'Poulet au lait de coco, banane et cacao (ou cabillaud)', 'blanc de poulet, banane, tomate, ail, cacao, lait, citron vert, huile d''olive', '15 min', ['Couper les blancs de poulet (ou le poisson) en gros dés. Emincer l''ail.', 'Chauffer l''huile dans une poêle, y faire revenir le poulet.', 'Une fois qu''il est bien doré, ajouter les rondelles de bananes, bien mélanger et laisser quelques minutes à feu vif.', 'Ajouter la tomate coupée en quartier, baisser le feu et laisser réduire la tomate. ', 'Verser le lait juste suffisament pour recouvrir le mélange. Délayer le cacao. Saler et poivrer.', 'Laisser cuire à feu doux une petite dizaine de minutes.', 'Servir avec des tagliatelles et citronner juste avant de servir.'], ['Spatule', 'Moule à tarte'], ['poulet en sauce', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'cacao', 'tomate', 'ail', 'plat', 'blanc de poulet', 'banane et cacao (ou cabillaud)', 'recette', 'cuisine', 'recettes', 'boisson', 'Poulet au lait de coco', 'huile d''olive', 'dessert', 'plat de résistance', 'citron vert', 'lait', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:16:54.014538', [{'ingredient_id': '0ea936d0-c7cd-46ed-b2e3-ed55bce32425', 'quantite': '2'}, {'ingredient_id': '872fe4f7-4753-4174-a7e9-f735e9afc9a5', 'quantite': '1'}, {'ingredient_id': '40335fdb-dd34-479a-861f-04356cbdf042', 'quantite': '1'}, {'ingredient_id': '75fd176b-4009-4233-a3c0-e542ee23e540', 'quantite': '2'}, {'ingredient_id': '56c3862f-382e-43b8-8f1c-8114b4c04ef6', 'quantite': '1 cuillères'}, {'ingredient_id': '93e7545e-e80d-4352-bb3c-e0e85c468ec6', 'quantite': ''}, {'ingredient_id': '4cad81f9-2b25-4c91-bb60-8b7eab7ddbff', 'quantite': '1'}, {'ingredient_id': '7cdc8d9c-4998-4a7a-9a75-510c3b5d97d4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (334329, 'Nems perdus au chocolat', 'pain de mie, pâte à tartiner, banane, oeuf, lait, sucre vanillé', '45 min', ['Aplatir les tranches de pain de mie avec un rouleau, puis étaler la pâte à tartiner sur les tranches.', 'Couper les bananes en tranches. Ajouter les bananes sur 1/4 de la tranche. ', 'Rouler les tranches, les nems sont formés.', 'Mélanger le lait, les oeufs et le sucre vanillé dans un saladier.', 'Imbiber les Nems dans le mélange, les mettre dans une poêle chaude et faire cuire 1 à 2 min de chaque côté.', 'Bon appétit ! '], ['Tire-bouchon', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Nems perdus au chocolat', 'sucre vanillé', 'lait', 'cocktail', 'pain de mie', 'pâte à tartiner'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:16:58.268125', [{'ingredient_id': '8cbe9a32-0796-4e68-9614-55caf9c836e1', 'quantite': '9'}, {'ingredient_id': '0c92cbab-841c-436b-9de1-88d5ad5b1054', 'quantite': '1'}, {'ingredient_id': '4c87be03-c5f8-46eb-a08f-304a02c53631', 'quantite': '4'}, {'ingredient_id': 'ef05aa32-ad22-4199-8e5c-363acd65e5d4', 'quantite': '4'}, {'ingredient_id': '01380cf1-19de-4753-b71b-0365364ed7b7', 'quantite': ''}, {'ingredient_id': '46b966ee-0651-4abe-aa70-b3358b622029', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72921, 'sorbet à la banane', 'banane, sucre, eau, jus de citron, blanc d''oeuf', '5 min', ['mixez la banane et le blanc d''oeuf.', 'Puis rajoutez le sucre, l''eau, le citron et remixez le tout.', 'Mettez le tout dans la sorbetière ou dans un bocal au congélateur.', 'C''est prêt!'], ['Poêle', 'Passoire', 'Pince de cuisine', 'Batteur électrique', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'sorbet à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'sorbet', 'dessert', 'plat de résistance', 'jus de citron', 'sucre', 'blanc d''oeuf', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:17:01.922485', [{'ingredient_id': '3c320933-5bc7-4f2e-ad40-eee0488aed6b', 'quantite': '1'}, {'ingredient_id': 'f66d4d08-5d90-4d3f-9781-3f9d80e9adc2', 'quantite': '150 g'}, {'ingredient_id': '0d22505a-236e-49cc-a66b-38cb84acfdfb', 'quantite': '50 cl'}, {'ingredient_id': 'b0bbbfd8-175b-49a6-9738-60e0261081cd', 'quantite': ''}, {'ingredient_id': '9fec28bc-8fbe-4e97-aae7-fa96efc25338', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166892, 'Smoothie facile', 'banane, kiwi, mangue, jus d''ananas, miel liquide', '10 min', ['Éplucher les fruits. Les couper en morceaux et les mettre dans le mixeur.', 'Ajouter le jus et le miel. Mixer le tout jusqu''à ce soit "liquide".', 'Réfrigérer ceci pendant 2 heures, remixer la préparation et... dégustez!', 'Bon appétit!'], ['Tire-bouchon', 'Presse-agrumes', 'Râpe'], ['miel liquide', 'entrée', 'banane', 'kiwi', 'Smoothie facile', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus d''ananas', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:17:05.337742', [{'ingredient_id': 'eb756aec-be86-45d5-b21a-eb7c7e99f1d3', 'quantite': '2'}, {'ingredient_id': '47e97d43-e58e-475e-bad4-252f537b22ff', 'quantite': '3'}, {'ingredient_id': 'a4d16325-6552-4e03-8162-2cdd7d8a85ff', 'quantite': '1'}, {'ingredient_id': '421771c7-c60c-4b28-8886-631767d9328b', 'quantite': '4'}, {'ingredient_id': 'd9045dfe-74e3-474b-b202-535c28158286', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (201340, 'Tagine de veau marocain d''Hanane', 'veau, oignon, tomates concassées, gingembre, paprika, cube de bouillon, feuille de laurier, safran, ail, persil, huile d''olive, poivre, sel, carotte, chou-fleur', '20 min', ['Dans un plat à tagine (à défaut, dans un faitout muni d''un couvercle ayant un petit trou), mettre la viande et saupoudrer dessus le sel, poivre, les cubes dilués, le gingembre, le paprika, le safran, l''ail, le persil et déposer la feuille de laurier. Arroser d''huile (on n''est pas à une cuillerée à soupe près!) et mélanger pour imprégner la viande.', 'Mettre le plat sur le feu et laisser revenir jusqu''à ce que les morceaux soient dorés. Pendant ce temps, éplucher l''oignon, la tomate et les légumes que vous avez choisis. Quand les morceaux de viande sont dorés, les disposer le mieux possible dans le plat car ils ne bougeront plus.', 'Ensuite, émincer l''oignon (même deux si on aime) et le répartir sur la viande. Faire pareil avec la tomate.', 'Répartir les légumes en les superposant sachant que le plus long à cuire doit toujours se trouver en bas (carottes par exemple) et le plus fragile en haut (chou-fleur). Une fois que tout est superposé, on ne touche plus à rien. ', 'Ajouter un petit verre d''eau sur le côté du plat, pas directement sur les aliments imprégnés d''épices et décorer avec du poivre du moulin ou du paprika ou du persil saupoudré sur les légumes du dessus. ', 'Laisser cuire jusqu''à ce que l''eau réduise et forme une sauce (environ 1h30 à feu doux). Entrouvrir le couvercle en fin de cuisson pour aider à la réduction de la sauce.', 'Attention, il peut être nécessaire d''ajouter de l''eau en cours de cuisson alors surveillez de temps en temps.', 'Servir avec du pain car le tagine traditionnel ne se sert pas avec de la semoule !', 'Bonne dégustation.'], ['Rouleau à pâtisserie', 'Mixeur', 'Batteur électrique'], ['gingembre', 'entrée', 'tomates concassées', 'tajine', 'recettes de cuisine', 'feuille de laurier', 'sel', 'confiserie', 'testées', 'carotte', 'veau', 'ail', 'paprika', 'plat', 'moyenne', 'recette', 'cube de bouillon', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile d''olive', 'chou-fleur', 'dessert', 'persil', 'plat de résistance', 'moyen', 'poivre', 'Tagine de veau marocain d''Hanane', 'cocktail', 'safran'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:17:08.831492', [{'ingredient_id': '75bf9a02-1f34-473e-b505-a9567fdc90c2', 'quantite': '1 kg'}, {'ingredient_id': 'da9cf6f0-ded4-4ce2-9c03-c0f185e5e41a', 'quantite': '1'}, {'ingredient_id': '4187432b-dcce-4e97-80ad-ac53b3311dc8', 'quantite': '1'}, {'ingredient_id': 'd4befd07-d8b7-4922-bf6e-9877dc30a556', 'quantite': '1 cuillères'}, {'ingredient_id': '711c2bf7-b6f8-4dff-b50c-2edef6290de2', 'quantite': '1 cuillères'}, {'ingredient_id': 'b986bce1-bec2-4c3a-a781-eb6bad7a3d48', 'quantite': '2'}, {'ingredient_id': '64dad961-8c3e-4d13-81aa-804d0ae9215a', 'quantite': '1'}, {'ingredient_id': 'dde2801b-c337-486f-88b6-c8d2982ae4ac', 'quantite': '5'}, {'ingredient_id': 'c8e9b7ee-7e5a-4811-8ad5-aa1d323cc79c', 'quantite': '2'}, {'ingredient_id': '316968d1-b43e-41de-84dd-4d58d0aa8269', 'quantite': '1 cuillères'}, {'ingredient_id': '8ce5de01-aafc-402f-9ab0-affdd347f20a', 'quantite': '2 cuillères'}, {'ingredient_id': '4d4ce671-f489-4f80-a437-56dbf2992461', 'quantite': ''}, {'ingredient_id': '57e1785d-131c-477b-8747-c39b4debb2fb', 'quantite': ''}, {'ingredient_id': '0b64f6aa-a382-4f2c-9f1d-640e8371b773', 'quantite': ''}, {'ingredient_id': 'be3df1c4-f8fe-4486-a94d-007074de0b76', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58172, 'Purée de banane, accompagnée d''une chantilly au fruit de la passion', 'banane, fruit de la passion, crème fraîche, fromage blanc, sucre', '5 min', ['Dans une assiette, écraser avec une fourchette les bananes et rajouter le fromage blanc, bien remuer avec la fourchette pour avoir une purée.', 'Monter la crème fraîche en chantilly avec le sucre.', 'Couper et enlever les pépins tout en réservant le jus.', 'Ajouter le jus en tournant délicatement à la chantilly.', 'Dans une coupe style cocktail, déposer au fond la purée de banane, puis au dessus, la chantilly.'], ['Spatule', 'Presse-agrumes', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'fruit de la passion', 'dessert', 'plat de résistance', 'Purée de banane', 'accompagnée d''une chantilly au fruit de la passion', 'sucre', 'cocktail'], 'Dessert', fbc4e262-8b77-4a14-8a7a-c382537616fa, '2025-09-26T15:17:13.011041', [{'ingredient_id': 'c92d8f99-2ad1-41e3-97f9-6665bc9d2c8d', 'quantite': '2'}, {'ingredient_id': 'efacf143-9cb5-493c-af37-9199aee348f6', 'quantite': '2'}, {'ingredient_id': 'cee3dfc5-b35d-4395-b13c-b56303d0eee8', 'quantite': '10 cl'}, {'ingredient_id': '90d409cd-4fcb-4054-ab5b-e4af52d653f3', 'quantite': '100 g'}, {'ingredient_id': 'e9e6d378-f4f1-4e6c-90c6-de3c41358055', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (382562, 'Crème de banane au Thermomix', 'banane, crème fraîche, yaourt à la grecque, cassonade, citron, sucre vanillé', '5 min', ['Épluchez, puis coupez les bananes en petits morceaux. Déposez-les dans la cuve.', 'Arrosez de jus de citron, ajoutez le reste des ingrédients, puis mixez pendant 40 sec / 0 °C / vit. 1 à 10.', 'Dégustez immédiatement ou placez au frais pendant 15 minutes maximum.'], ['Couteau de chef', 'Passoire', 'Louche'], ['yaourt à la grecque', 'banane', 'entrée', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'Crème de banane au Thermomix', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron', 'cocktail', 'crème dessert'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:17:17.086863', [{'ingredient_id': '0b416431-b6ab-4401-b2db-3b9c8c0b43f5', 'quantite': '4'}, {'ingredient_id': 'd49b5959-8338-4a4c-9439-5e507d0b57e5', 'quantite': '2 cuillères'}, {'ingredient_id': '0394aec6-ccd1-4e56-b82d-0ec216295126', 'quantite': '2 cuillères'}, {'ingredient_id': 'bf261e5f-a8d2-48bc-96ce-f61f4d081df3', 'quantite': '2 cuillères'}, {'ingredient_id': '41a29584-0e99-4ea6-96f9-0470e13d7701', 'quantite': '2 cuillères'}, {'ingredient_id': '49aa4b2e-de41-4a66-9296-0c215bd8796f', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57030, 'Crêpes aux bananes', 'banane, farine, oeuf, sucre, lait, huile, sucre glace', '5 min', ['Préparer la pâte à crêpe en mélangent la farine, l''oeuf, la moitié du sucre et le lait. ', 'Puis éplucher les bananes et les écraser.', 'Ajouter le sucre et mélanger.', 'Ajouter les bananes écrasées à la pâte à crêpes. ', 'Mélanger et mettre à cuire dans une poêle huilée.', 'La cuisson dépend du goût de chacun.', 'Le plus dur étant de retourner la crêpe.', 'Je conseille de prendre un plat, de le poser sur la poêle et de retourner puis de glisser la crêpe sur la poêle pour cuire la deuxième face.', 'Une fois cuite saupoudrer de sucre glace.'], ['Passoire', 'Presse-agrumes', 'Couteau de chef', 'Louche', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'Crêpes aux bananes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'crêpes sucrées', 'sucre glace', 'sucre', 'lait', 'cocktail'], 'Dessert', b608d6f4-2c71-47f7-a34c-c4a50388752c, '2025-09-26T15:17:21.532425', [{'ingredient_id': '7bb1ed61-15c4-452e-928a-34734b0813e8', 'quantite': '2'}, {'ingredient_id': '2f5949ee-6041-494a-a595-8b9953beb5b9', 'quantite': '100 g'}, {'ingredient_id': '64425c67-8db6-4f0d-89cc-5fb603c6baa3', 'quantite': '1'}, {'ingredient_id': 'b905db73-e3cd-4083-a7cc-512ed1002380', 'quantite': '50 g'}, {'ingredient_id': 'ae61c954-7db8-4591-af4c-3dc29c8acad1', 'quantite': '20 cl'}, {'ingredient_id': '57295723-f7d0-4a00-a33b-6f7e89d557b5', 'quantite': ''}, {'ingredient_id': 'e0138b5b-95f2-4d49-ac21-a44f2f2730a3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (222990, 'Milk-shake à la banane de mamie Monique', 'banane, vanille, lait, sucre', '5 min', ['Mixer tous les ingrédients dans un blender.', 'Saupoudrer de cacao.', 'Savourer tout de suite !'], ['Mixeur', 'Pince de cuisine', 'Planche à découper'], ['', 'entrée', 'banane', 'Milk-shake à la banane de mamie Monique', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'lait', 'sucre', 'cocktail'], 'Boisson', ee04e46c-3bd5-4fda-8763-373c3cb12aad, '2025-09-26T15:17:25.033372', [{'ingredient_id': '593dbd71-de3d-4f47-b79f-fbfc40fe983a', 'quantite': '2'}, {'ingredient_id': 'f7157ab8-c1af-4d8c-a6c0-ada3c77f8ac8', 'quantite': '1'}, {'ingredient_id': '2f0f25e4-58f0-4cab-ad7a-c001b3d5ad2f', 'quantite': '15 cl'}, {'ingredient_id': 'd8ce5e05-aa08-4900-8dce-570f7b9c12dc', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (83817, 'Tarte meringuée framboise citron banane', 'oeuf, sucre, farine, beurre, sel, Confiture de framboise, banane, oeuf, maïzena, crème liquide, sucre glace, jus de citron, citron, oeuf, sucre glace, citron', '30 min', ['Préparer une pâte sablée en mélangeant les 4 jaunes d''oeufs au sucre avec une spatule.', 'Pendant ce temps faire fondre le beurre sans le laisser bouillir.', 'Dans un saladier, faire un puits au milieu de la farine et ajoutez le mélange œufs/sucre puis incorporer le beurre, la pincée de sel.', 'Tout malaxer, former une boule de pâte.', 'Préchauffer le four à 200°C (thermostat 6-7).', 'Beurrer un moule à tarte.', 'Étaler la pâte avec un rouleau à pâtisserie en ajoutant un peu de farine sur le plan de travail pour éviter qu''elle ne colle.', 'Disposer cette pâte dans le moule, y faire des trous à l''aide d''une fourchette et poser du papier sulfurisé sur cette pâte avec un verre de grains de riz ou de haricots secs blancs afin de maintenir ce papier sulfurisé sur la pâte.', 'Enfourner et laisser cuire environ 10 minutes à 200°C (thermostat 7).', 'Sortir le moule du four et retirez les haricots secs et le papier, laissez complètement refroidir.', 'Pendant ce temps, préparez la crème au citron en battant les 3 jaunes d''oeufs au-dessus d''un bain marie (dans un saladier au-dessus d''une casserole d''eau sur le feu)avec la maïzena ou fécule de pommes de terre, la crème liquide et 50 g de sucre glace.', 'Ajoutez le jus et le zeste de citron.', 'Montez les blancs en neige ferme(avec une pincée de sel)en incorporant à mesure les 50 g de sucre glace restant.', 'Ajoutez les blancs en neige à la crème aux oeufs en soulevant délicatement.', 'Tapisser la pâte de confiture de framboises (ou de fraises), découper les bananes en rondelles et les disposer sur le fond de confiture.', 'Versez la crème au citron sur les bananes.', 'Faire cuire 25 minutes au milieu du four à 150°C (Thermostat 3). Laisser refroidir.', 'Pendant ce temps, préparez la meringue en montant les blancs en neige très ferme (avec une pincée de sel pour faciliter l''opération)en ajoutant peu à peu les 100 g de sucre glace.', 'Y incorporer délicatement le zeste de citron.	', 'Recouvrir la tarte de ces blancs en neige en les étalant sur toute la surface.', 'Augmenter la température du four à 250°C (thermostat 8) et enfourner la tarte pour faire dorer la meringue selon votre gout.'], ['Mixeur', 'Moule à tarte', 'Spatule'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Tarte meringuée framboise citron banane', 'tarte au citron', 'farine', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', e0613a29-c5e3-4fdc-b461-438905960e4c, '2025-09-26T15:17:28.644895', [{'ingredient_id': 'cb04327b-bd73-4851-84fa-323b8ed341ba', 'quantite': '4'}, {'ingredient_id': 'da12d347-d5ab-4467-b312-2b20f0f1c0bc', 'quantite': '125 g'}, {'ingredient_id': '39705848-5ff1-4e3c-8594-2b61e05f0381', 'quantite': '250 g'}, {'ingredient_id': 'daebdbbb-f5dd-437c-bfbe-17bb469b8bce', 'quantite': '100 g'}, {'ingredient_id': '35dc6ce1-7b17-4286-80c5-155f607e78c1', 'quantite': '1'}, {'ingredient_id': '9dc80354-023d-4110-abb5-f0e64dd49d22', 'quantite': '8 cuillères'}, {'ingredient_id': 'f83079bf-de6f-407d-96b9-dd958ffd6391', 'quantite': '2'}, {'ingredient_id': '8f4b6289-46ba-4e22-adb9-dc27acd7044b', 'quantite': '3'}, {'ingredient_id': '7a386bed-f4de-4d05-b7db-b82f910b214f', 'quantite': '1 cuillères'}, {'ingredient_id': '3a470f58-34be-4b46-93ec-4849974192d1', 'quantite': '5 cuillères'}, {'ingredient_id': '7bcb83e0-9c49-49a1-b277-7d3c6b5a1f80', 'quantite': '100 g'}, {'ingredient_id': '615c448e-e8ac-4fd9-bbfb-2a19906e346f', 'quantite': '10 cl'}, {'ingredient_id': '588e4570-b0e6-4d50-9770-9fbad082e581', 'quantite': '10 g'}, {'ingredient_id': '4c118c03-8fae-4d9f-b842-372e7db809e6', 'quantite': '4'}, {'ingredient_id': 'a5bcc879-3fe1-4efb-94a4-13540eb46c2c', 'quantite': '100 g'}, {'ingredient_id': '08554fcd-7662-477f-8d59-b4a7d27d3df2', 'quantite': '10 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24411, 'Cake à la banane et aux raisins', 'farine, beurre tendre, sucre roux, banane, raisins secs, noix, fromage blanc, oeuf, vanille, cannelle, levure chimique, sel', '20 min', ['Faire tremper les raisins dans un bol d''eau tiède au moins 30 minutes.', 'Préchauffer le four à 180°C (thermostat 6).', 'Fouetter le beurre avec le sucre puis ajouter l''oeuf, le mélange prend la consistance d''une crème. ', 'Incorporer la banane écrasée, le fromage blanc, les épices et les raisins.', 'Mélanger la farine à la poudre de noix, au sel et à la levure. Ajouter progressivement ce mélange à la pâte.', 'Verser la pâte dans un moule à cake beurré et faire cuire 1 heure environ.'], ['Mixeur', 'Balance de cuisine', 'Spatule'], ['entrée', 'banane', 'Cake à la banane et aux raisins', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'beurre tendre', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'noix', 'recettes', 'boisson', 'farine', 'fromage blanc', 'vanille', 'autres cakes', 'dessert', 'plat de résistance', 'raisins secs', 'cannelle', 'cocktail', 'sucre roux'], 'Dessert', 2a5431ed-2ad8-439b-8654-937771695f6b, '2025-09-26T15:17:32.220839', [{'ingredient_id': 'f282d50d-f578-4c5a-b5e8-e6b513442467', 'quantite': '250 g'}, {'ingredient_id': '39611a6a-4b98-4531-81ef-e0122e69653c', 'quantite': '100 g'}, {'ingredient_id': '205f8ac8-3823-4256-a244-56eb2aa842b9', 'quantite': '100 g'}, {'ingredient_id': 'b14a3c42-321d-4ff5-8e83-c94bc5e7035c', 'quantite': '450 g'}, {'ingredient_id': '337adaf0-69eb-4eaf-9239-2b6f16421b16', 'quantite': '100 g'}, {'ingredient_id': 'dda00213-d0a1-40ba-8b31-22851edbb7f9', 'quantite': '65 g'}, {'ingredient_id': '22b52ae9-33f9-49bd-8158-47aaa9e9c97a', 'quantite': '3 cuillères'}, {'ingredient_id': '02675986-daed-42d0-8f2f-508b66f3411c', 'quantite': '1'}, {'ingredient_id': '149c3813-707d-4b50-abf8-b9eb14c8413b', 'quantite': '1 cuillères'}, {'ingredient_id': '8722017a-7dbf-446b-a641-3b7a1123b1dd', 'quantite': '1 cuillères'}, {'ingredient_id': '2501fb56-50e7-475f-ab96-97539d2e16af', 'quantite': '1'}, {'ingredient_id': '226f68c6-ba85-448a-9c20-e5ca65af5d1b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43951, 'Coupes avocats / bananes', 'avocat, banane, rhum, sucre en poudre', '5 min', ['Mixer le tout. Mettre dans de jolies coupes. Couvrir de film étirable.', 'Et au frigo, pendant au moins 1 h. ', 'Servir bien glacé!'], ['Ouvre-boîte', 'Moule à tarte', 'Économe', 'Batteur électrique', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'avocat', 'très facile', 'rapide', 'plat', 'Coupes avocats / bananes', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'cocktail'], 'Dessert', 2eb78987-3dfb-40f0-90e1-8f193335a2a8, '2025-09-26T15:17:35.706337', [{'ingredient_id': 'aee5c9f3-3bb2-4844-a3f4-034a77df1aae', 'quantite': '1'}, {'ingredient_id': '0ffeafab-7e82-482f-894d-4ab23366f3fe', 'quantite': '3'}, {'ingredient_id': '02542d15-10ed-448f-8761-7fdbfdb09fd5', 'quantite': '1 cuillères'}, {'ingredient_id': '0c645972-92ff-41ec-8c14-a7ec07ecda2b', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (224527, 'Crumble pomme-banane vanillé', 'farine, sucre, beurre, vanille, pomme, banane', '10 min', ['Préchauffer le four à 210°C (thermostat 7).', 'Éplucher et couper en dés les pommes et la banane, réserver au réfrigérateur pour que les pommes ne s''oxydent pas.', 'Dans un saladier, mélanger énergiquement avec les doigts la farine, le sucre, le beurre et la vanille en poudre jusqu''à obtenir une pâte sableuse.', 'Dans un plat allant au four, mettre les fruits puis saupoudrer grossièrement la pâte à crumble.', 'Enfourner 15 min et prolonger de 2 min au grill si ce n''est pas assez doré.', 'Servir tiède.'], ['Moule à tarte', 'Louche', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'vanille', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'sucre', 'cocktail', 'Crumble pomme-banane vanillé'], 'Dessert', fe8a4e7b-f9bc-4d60-b2c8-d4d11539381f, '2025-09-26T15:17:39.170881', [{'ingredient_id': '1be7166b-e0e4-464a-9fed-ac81c9e61ded', 'quantite': '150 g'}, {'ingredient_id': '81e2b051-3fbd-4619-8085-0b8ff52df28a', 'quantite': '125 g'}, {'ingredient_id': 'd0e4f4be-3619-41b4-85f1-f6bf62b66611', 'quantite': '75 g'}, {'ingredient_id': '158c3a7e-4cf7-4805-a1bf-b88fb51e1c26', 'quantite': ''}, {'ingredient_id': 'e18ea525-9f53-4228-a852-8d3252232888', 'quantite': '4'}, {'ingredient_id': '23ef094c-6a80-4dbd-a13d-ff60d4b0214e', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22610, 'tarte frangipane aux bananes et chocolat', 'pâte sablée, beurre tendre, sucre, amandes, oeuf, crème, extrait d''amande, banane, beurre, sucre, chocolat praliné, crème', '60 min', ['Préparez la crème d''amandes : ', 'Mélangez le beurre pommade avec le sucre et les amandes à la spatule. Ajoutez l''oeuf entier et le jaune puis la crème et l''extrait d''amande. Bien mélanger pour que l''appareil soit homogène et réservez à température ambiante recouvert d''un torchon. ', 'Préparez les bananes : ', 'Faites les caraméliser pendant quelques minutes dans une poêle avec le beurre et le sucre. Débarrassez-les sur un papier absorbant. ', 'Faites fondre le chocolat au bain-marie et ajoutez un peu de crème. ', 'Etendre la pâte dans un moule à tarte et tartinez-la de chocolat. Etendre par dessus la crème d''amande et disposez harmonieusement les bananes caramélisées. ', 'Faites cuire environ 25 mn à 200°C. La crème d''amande doit encore être bien fondante.'], ['Économe', 'Mixeur', 'Passoire', 'Couteau de chef', 'Casserole'], ['boisson', 'recettes', 'entrée', 'pâte sablée', 'recettes de cuisine', 'plat', 'dessert', 'confiserie', 'Tarte à la frangipane', 'recette', 'testées', 'plat de résistance', 'cocktail', 'cuisine', 'tarte frangipane aux bananes et chocolat', 'moyen', 'facile'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:17:42.730022', [{'ingredient_id': 'e7fde8f6-4d44-4b80-8004-7cc85a8f0a7d', 'quantite': '1'}, {'ingredient_id': 'eb228ae0-5eeb-4757-8ef5-c251f35e3d05', 'quantite': '125 g'}, {'ingredient_id': '2f479866-65e7-4ffa-ac9e-a88b31054f8f', 'quantite': '125 g'}, {'ingredient_id': '703eb96e-fdbe-4590-95d4-6b7f2a6e69d2', 'quantite': '125 g'}, {'ingredient_id': '0b457af2-0439-44d2-ade1-e912aca5aa3f', 'quantite': '1'}, {'ingredient_id': '0a04a841-ef77-4311-90a6-d7397c265087', 'quantite': '3 cuillères'}, {'ingredient_id': '34737479-5a19-4a65-94eb-d2190df82f4d', 'quantite': ''}, {'ingredient_id': '21160031-0d38-4129-8504-abe0a6ccc47b', 'quantite': '3'}, {'ingredient_id': 'd845525c-4462-413e-a795-b000b7eb3e48', 'quantite': '20 g'}, {'ingredient_id': '3c954f25-009b-46bc-935d-fa12b66ca8b6', 'quantite': '20 g'}, {'ingredient_id': 'dcbdef1b-6218-4688-bc6d-4366b210da5d', 'quantite': '150 g'}, {'ingredient_id': '35a7c0f5-535e-4542-96ad-0145e85eb57b', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (39742, 'Taboulé exotique', 'couscous, banane, jambon, oignon rouge, huile d''olive, eau, citron, persil, poivre, sel', '15 min', ['Rincez le couscous à l''eau froide dans une passoire, puis mettez-le dans un grand plat creux. Arrosez-le avec le jus de citron, l''huile d''olive et l''eau. ', 'Ajoutez l''oignon rouge ciselé, salez et poivrez. ', 'Mélangez le tout soigneusement laissez 2 heures au réfrigérateur en remuant de temps en temps.', 'Détaillez les tranches de jambon en petits dés. Pelez les bananes et coupez en rondelles fines, ajoutez-les au taboulé.', 'Mélangez délicatement.', 'Décorez de brins de persil.', 'Dégustez frais.'], ['Tire-bouchon', 'Balance de cuisine', 'Batteur électrique'], ['couscous', 'entrée', 'banane', 'recettes de cuisine', 'jambon', 'Taboulé exotique', 'sel', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'Taboulé', 'rapide', 'plat', 'recette', 'cuisine', 'oignon rouge', 'recettes', 'boisson', 'huile d''olive', 'dessert', 'persil', 'plat de résistance', 'citron', 'poivre', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:17:46.276447', [{'ingredient_id': 'e870b00e-206e-432b-a01a-11fcd9ff14b8', 'quantite': '200 g'}, {'ingredient_id': '4b7b0c67-36de-44e9-a6ba-b1fd89640a27', 'quantite': '2'}, {'ingredient_id': '2e7fb66d-6195-46fc-8acb-3ad56f671328', 'quantite': '2'}, {'ingredient_id': '2119bcf9-cbd6-42ea-b66f-52c552c7fcae', 'quantite': '1'}, {'ingredient_id': 'b06389dc-6c52-450d-a61c-c30dff67173e', 'quantite': '10 cl'}, {'ingredient_id': '750b8297-20ec-4016-abe5-7b266de190e7', 'quantite': '10 cl'}, {'ingredient_id': 'aadf03a7-d2ef-4170-bdcc-b8341a2cdeaa', 'quantite': ''}, {'ingredient_id': '5e8c739a-7dfe-4872-bb63-ca6eaa2c8b68', 'quantite': ''}, {'ingredient_id': '19a1d990-9f9c-44c8-b0d2-470d73bdaa42', 'quantite': ''}, {'ingredient_id': '70121fff-c0b7-4c6d-8743-f2f35cccc6df', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16811, 'Riz à la cubaine', 'chipolata, riz, banane, oeuf, poivron, tomates pelées, oignon, ail, purée de piment, poivre, sel', '25 min', ['Préparer la sauce : détailler en petits morceaux les poivrons, tomates, oignons, gousses d''ail.  ', 'Faire mijoter avec 1 pointe de purée de piment, du poivre et du sel, pendant 20-25 mn.', 'Pendant ce temps, cuire le riz, les saucisses.  ', 'Quelques minutes avant de servir, faire caraméliser les bananes dans du beurre et préparer des oeufs à la poêle.', 'Servir le riz, napper de sauce et disposer saucisses, bananes et oeufs sur le dessus.'], ['Presse-agrumes', 'Poêle', 'Fouet'], ['Riz à la cubaine', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'chipolata', 'tomates pelées', 'très facile', 'bon marché', 'ail', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'plat de riz', 'poivron', 'dessert', 'plat de résistance', 'riz', 'purée de piment', 'poivre', 'cocktail'], 'Plat principal', 79dd67ac-883e-49eb-ae66-bc63fc4642ec, '2025-09-26T15:17:50.975662', [{'ingredient_id': '5b12b936-6418-47ee-bbb1-c67e6f06eb52', 'quantite': '2'}, {'ingredient_id': '4d52f25c-af29-49c7-8b57-94fcab037355', 'quantite': ''}, {'ingredient_id': '9f7e4326-be7b-4193-8dfd-d8f72b7e7e05', 'quantite': '2'}, {'ingredient_id': 'ac9c5182-c82b-4808-86b2-7c8f8f2856a0', 'quantite': '2'}, {'ingredient_id': 'aaa8d9c5-0a16-462c-a8f1-014c5353e2a4', 'quantite': '3'}, {'ingredient_id': 'aa905862-fe5c-43cf-ba35-10c204961dca', 'quantite': '1'}, {'ingredient_id': 'e6d09827-be54-4a56-99d7-1fe682ef5ce6', 'quantite': '2'}, {'ingredient_id': 'a19ea056-6b14-4014-b50d-d812d7be288e', 'quantite': '2'}, {'ingredient_id': '3a7558bc-d211-43cd-a5af-7e4c7cbac191', 'quantite': ''}, {'ingredient_id': 'f34809be-8d1a-43f0-94c3-bfb966eb1cd2', 'quantite': ''}, {'ingredient_id': 'c98f0257-d98a-4e4b-81db-08fd6185b30d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528287, 'Smoothie bowl de printemps', 'fromage blanc, banane, framboises, sirop d''agave, cranberries, noisettes', '15 min', ['Dans le bol d''un mixeur versez le fromage blanc.', 'Faites décongeler les framboises si vous utilisez des framboises surgelés. Si vous utilisez des framboises fraîches, passez les à l''eau et nettoyez-les.', 'Ajoutez les framboises dans le bol du mixeur.', 'Coupez la banane en rondelles. Réservez en quelques morceaux de côté. Versez-les morceaux restants dans le bol du mixeur.', 'Mixez le tout pendant 1 minute. Ajoutez le sirop d''agave, et mixez une nouvelle fois l''ensemble de la préparation.', 'Une fois le mélange bien homogène, versez le dans un bol.', 'Disposez vos rondelles de bananes restantes sur un côté du bol. Ajoutez les morceaux de fruits secs grossièrement coupés, puis les cranberries.', 'Il n''y a plus qu''à déguster !'], ['Mixeur', 'Tire-bouchon', 'Passoire', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'framboises', 'bon marché', 'cranberries', 'Smoothie bowl de printemps', 'rapide', 'sirop d''agave', 'plat', 'recette', 'noisettes', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'smoothie bowl', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:17:55.185695', [{'ingredient_id': 'a5b0feb2-12fd-4141-a93e-d8994fc62bf3', 'quantite': '150 g'}, {'ingredient_id': 'd56f06c9-491f-47c5-9f47-4020e6f3cd74', 'quantite': '1'}, {'ingredient_id': '5a019134-4082-4a64-8a02-a56a71176c7a', 'quantite': '110 g'}, {'ingredient_id': '8facfc96-2d43-46a7-aebe-b0c38b42945d', 'quantite': '1 cuillères'}, {'ingredient_id': '4ebb74a0-b31c-428f-aa56-6c22b18f613c', 'quantite': '1 cuillères'}, {'ingredient_id': '14342589-736a-44b7-8ee5-e521d9d5afa7', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (25051, 'Tarte pommes bananes', 'pâte sablée, pomme, banane, sucre', '20 min', ['Etaler la pâte dans un moule à tarte, la piquer à la fourchette.', 'Peler, épépiner et couper 3 pommes en dés, et 2 bananes en rondelles. Les faire cuire en compote avec 50 g de sucre.', 'Verser la compote refroidie sur le fond de tarte.', 'Peler et couper les pommes et bananes restantes en lamelles, les disposer dur la tarte. Saupoudrer de sucre et enfourner 25 minutes au four à 200°C (thermostat 6-7).'], ['Mixeur', 'Spatule', 'Ouvre-boîte', 'Casserole', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'pâte sablée', 'plat', 'tarte aux pommes', 'recette', 'cuisine', 'recettes', 'boisson', 'Tarte pommes bananes', 'dessert', 'plat de résistance', 'pomme', 'sucre', 'cocktail'], 'Dessert', a763602c-d6e1-43b9-aeae-eda72e2059cf, '2025-09-26T15:17:58.627137', [{'ingredient_id': 'a1434b05-5a0b-4b43-8b06-c4d05818ec47', 'quantite': '1'}, {'ingredient_id': '5daac71f-5691-4260-b932-bc54cd745b2a', 'quantite': '5'}, {'ingredient_id': '0b13f865-a8e3-4c5e-aa3a-b11c4c5c1322', 'quantite': '4'}, {'ingredient_id': '4e0edced-a04d-4328-9734-a55a8a6e8538', 'quantite': '60 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (48563, 'Crumble fraises - bananes', 'fraises, banane, beurre, sucre de canne, farine, noix de coco rapée, sucre vanillé', '10 min', ['Découper les bananes en rondelles et les fraises en morceaux. ', 'Répartir les morceaux de fraise et les rondelles de banane dans 4 ramequins (fraises dessous, puis bananes par dessus).', 'Pour la pâte à crumble, mélanger avec les mains le beurre, la farine, le sucre, le sucre vanillé, et la noix de coco râpée; émietter le tout avec les doigts, et repartir la préparation sur les fruits dans chaque ramequin.', 'Mettre au four pendant une dizaine de minutes à 200°C (thermostat 6).'], ['Verre doseur', 'Batteur électrique', 'Ouvre-boîte', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'Crumble fraises - bananes', 'sucre de canne', 'farine', 'noix de coco rapée', 'dessert', 'plat de résistance', 'sucre vanillé', 'autres crumbles', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:18:02.179249', [{'ingredient_id': 'ce68aaf4-345f-46e0-8b9e-6c715e137958', 'quantite': '12'}, {'ingredient_id': 'ebd9b7bc-9483-454c-b1dd-a2903748c05b', 'quantite': '2'}, {'ingredient_id': 'e68e799b-c1bb-442e-8680-0db3b0a25042', 'quantite': '25 g'}, {'ingredient_id': '7971c41f-d0cc-4edd-864a-b5a1a2721c43', 'quantite': '20 g'}, {'ingredient_id': '4832ccfb-08fe-45f4-ad57-3d3617bd292e', 'quantite': '35 g'}, {'ingredient_id': '397e6e27-1a7b-4d8b-8e4c-c11fbf5eb53b', 'quantite': '40 g'}, {'ingredient_id': '178a6aaa-522b-4383-a586-4f04db43efc5', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (35542, 'cake pomme, poire, banane', 'pomme, poire, banane, oeuf, sucre en poudre, farine, beurre, levure', '15 min', ['Eplucher et couper les fruits en dés pas trop petits. ', 'Dans un saladier, mélanger le sucre et le beurre ramolli, puis ajouter les oeufs un par un, ajouter ensuite la farine et la levure. ', 'Huiler un plat à cake, disposer les dés de fruits dans le fond. ', 'Recouvrir les fruits avec la préparation. ', 'Faire cuire 30 mn dans le four, thermostat 7 (210°C).'], ['Économe', 'Tire-bouchon', 'Râpe', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'levure', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'cake pomme', 'pomme', 'beurre', 'cocktail'], 'Dessert', 3c8d424c-bf24-4271-8418-7fcb0f97f436, '2025-09-26T15:18:05.747729', [{'ingredient_id': '008c4cde-120d-42a0-b633-30cc2f6177f4', 'quantite': '1'}, {'ingredient_id': '40e76b3c-5830-4e31-b245-235b03c9d000', 'quantite': ''}, {'ingredient_id': '81b8027b-7c2a-4bab-9195-0e358202a603', 'quantite': ''}, {'ingredient_id': 'd51ccd74-260c-4f34-8647-187ca311c235', 'quantite': '3'}, {'ingredient_id': 'b6b03747-8071-4b5c-90f8-1f20d4360fd5', 'quantite': '100 g'}, {'ingredient_id': '75368c94-b60d-4555-849c-af4bfe370a8f', 'quantite': '100 g'}, {'ingredient_id': '064776ad-9f1b-4851-8492-793982e34274', 'quantite': '100 g'}, {'ingredient_id': '96241ea3-93c4-49d0-8699-aa51ad8b81d5', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62980, 'Crumble framboise banane', 'cassonade, farine, beurre, banane, framboises, spéculoos', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Préparer le crumble en mélangeant la cassonade, la farine et le beurre coupé en petits cubes jusqu''à obtenir un pâte granuleuse qui sera à reserver au frigo durant 1 heure.', 'Prendre un plat allant au four et y déposer une couche de spéculoos. Ensuite y déposer les bananes coupées en rondelles et les framboises.', 'Emietter le crumble par dessus et mettre au four pendant environ 20 minutes suivant votre four (le mien : chaleur tournante).'], ['Moule à tarte', 'Planche à découper', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'cassonade', 'facile', 'framboises', 'bon marché', 'plat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'Crumble framboise banane', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:18:09.376114', [{'ingredient_id': '448a86a5-bc85-4e48-89b7-8a964d5a8767', 'quantite': '150 g'}, {'ingredient_id': '9a400ad3-fbe5-4d50-8c7e-a2f98f8386fa', 'quantite': '150 g'}, {'ingredient_id': '15c81dd8-fb96-4334-9301-6a3a040dc34d', 'quantite': '120 g'}, {'ingredient_id': 'd9fc387d-679f-4433-ae5d-9a329c87e25f', 'quantite': '2'}, {'ingredient_id': '4ebb5e52-3576-4e19-b643-73444cd70268', 'quantite': '150 g'}, {'ingredient_id': 'cf32b8d3-223c-471f-bb57-d2e4138cddc6', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17713, 'Tarte à la banane', 'pâte brisée, banane, citron, oeuf, noix de coco rapée, crème fraîche, cassonade, gingembre, cannelle', '20 min', ['Déroulez la pâte brisée et tapissez-en un moule à tarte de 24 cm de diamètre. Piquez le fond à la fourchette. ', 'Épluchez les bananes, coupez-les en rondelles. Arrosez de jus de citron. Disposez-les sur la pâte et saupoudrez de noix de coco râpée. ', 'Battez les oeufs à la fourchette dans une jatte. Incorporez la cassonade, la crème fraîche, le gingembre en poudre et la cannelle. ', 'Versez le mélange sur les bananes. Faites cuire 20 mn dans le four préchauffé à 200°C (thermostat 6-7) ', 'Servez de préférence tiède ou froid.'], ['Économe', 'Casserole'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'citron', 'Tarte à la banane', 'cannelle', 'cocktail'], 'Dessert', 43716b35-0e7e-45b5-8302-13398396a4df, '2025-09-26T15:18:15.029198', [{'ingredient_id': 'ed2fc554-d5aa-45b8-bc20-c8715fc6dc38', 'quantite': '1'}, {'ingredient_id': '3fa775a3-2161-4cae-822d-a2b401a0205d', 'quantite': '4'}, {'ingredient_id': '53ddb9b2-74ce-47bf-8e3c-fc6ed8f5cc9e', 'quantite': '1'}, {'ingredient_id': 'fa7366bf-ac26-4321-ab02-1455074717ec', 'quantite': '3'}, {'ingredient_id': '98257f03-d7a1-47e4-903c-274801276b90', 'quantite': '50 g'}, {'ingredient_id': '15240ff9-f6ac-41a1-b55c-fd5f173c0650', 'quantite': '20 cl'}, {'ingredient_id': '19fd5258-6c37-494f-b169-e0e9bd054ca4', 'quantite': '100 g'}, {'ingredient_id': 'a5d89315-d204-4665-81da-7f55a8f6fc65', 'quantite': ''}, {'ingredient_id': '621cd2fc-89f3-4827-a429-7027e4c97c32', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336396, 'Sorbet rapide à la banane de Réunion', 'banane, sucre roux, eau, citron vert', '5 min', ['Écrasez à la fourchettes les bananes avec le sucre.', 'Ajoutez l''eau et le jus de citron.', 'Mixez le tout avec un pied mixeur.', 'Mettez le tout 40 minutes dans une turbine à glace. ', 'Le sorbet est prêt à être dégusté. Bon appétit !'], ['Fouet', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'Sorbet rapide à la banane de Réunion', 'confiserie', 'eau', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'sorbet', 'dessert', 'plat de résistance', 'citron vert', 'cocktail', 'sucre roux'], 'Dessert', 1cc18fe3-df4a-450a-8721-9eafbc9dc530, '2025-09-26T15:18:18.439137', [{'ingredient_id': '4f1638af-8436-4d7b-8499-cf9544c9356e', 'quantite': '3'}, {'ingredient_id': '5634f221-346c-40cd-9f2c-ae2f85e84a8d', 'quantite': '125 g'}, {'ingredient_id': '3fcb99c9-1b99-4476-b5d1-f0df55579f0a', 'quantite': '250 ml'}, {'ingredient_id': '8fe6706f-212e-4120-b3eb-c3541467c398', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52639, 'Roulé banane / chocolat', 'oeuf, sucre semoule, farine, chocolat, beurre, lait, banane', '10 min', ['Préchauffer le four à 220°C (thermostat 7-8).', 'Couper les bananes en morceaux et les écraser avec une fourchette dans une casserole à feu doux (sorte de compote).', 'Dans un saladier, mélanger les jaunes d''oeufs et le sucre jusqu''à ce que le mélange blanchisse.', 'Monter les blancs en neige, les incorporer dans le mousseux, ajouter la farine et mélanger délicatement à la spatule.', 'Etaler sur une plaque à pâtisserie recouverte de papier cuisson, puis laisser cuire 8 à 10 min.', 'Pendant ce temps, faire fondre à la casserole le chocolat dans le lait, ajouter le beurre.', 'Démouler sur un torchon.', 'Etaler la banane sur toute la pâte, puis le chocolat (c''est pas grave si cela se mélange).', 'Rouler votre gâteau, et badigeonner le dessus avec le reste de chocolat, en guise de glaçage.'], ['Louche', 'Casserole', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'Roulé banane / chocolat', 'sucre semoule', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'gâteau roulé', 'lait', 'cocktail'], 'Dessert', a401b12f-2a65-4ce0-b790-d1e1af1cbdcb, '2025-09-26T15:18:21.975148', [{'ingredient_id': '56d0a185-8827-41fd-b747-45ec32a5b7c1', 'quantite': '4'}, {'ingredient_id': '94647682-c94a-4be2-ad56-4af1a7d3ee10', 'quantite': '50 g'}, {'ingredient_id': 'f416563a-5ec6-4bb2-b34f-141464534567', 'quantite': '60 g'}, {'ingredient_id': 'a9ae29fe-fad5-41e8-91f8-bfea28f5be1f', 'quantite': '150 g'}, {'ingredient_id': 'aa532dda-b489-4c4c-9ac9-b8c8e4438efb', 'quantite': '20 g'}, {'ingredient_id': 'f46f4213-3f70-4521-a262-527b4795a892', 'quantite': '2 cuillères'}, {'ingredient_id': 'dcd6c019-9538-4ef1-a334-02844a24934e', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (253985, 'Muffins banane cacao', 'banane, cassonade, beurre doux, oeuf, farine, levure chimique, sel, cacao, lait', '15 min', ['Mixer (ou écraser) les bananes avec 50 g de cassonade, réserver.', 'Mélanger au batteur le beurre et les oeufs.', 'Ajouter 50 g de cassonade, mélanger puis verser la purée de bananes. Mélanger.', 'Dans un bol, mélanger la farine avec la levure et le sel. Verser d''un coup dans la première préparation et mélanger grossièrement.', 'Séparer la pâte en deux et dans un des saladier ajouter le cacao. Si nécessaire ajouter 4 cl de lait afin d''obtenir une pâte "tout chocolat".', 'Préchauffer le four à 180 °C (thermostat 6).', 'Dans les moules à muffins, déposer la pâte à la banane puis celle au cacao (remplir 3/4 de la hauteur du moule).', 'Faire cuire 15 minutes environ.', 'Laisser refroidir avant de démouler et de goûter.'], ['Casserole', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'cassonade', 'levure chimique', 'facile', 'bon marché', 'cacao', 'Muffins banane cacao', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'muffin', 'beurre doux', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:18:25.524361', [{'ingredient_id': '2192e734-3421-4ffd-b82d-bb761fdd4e33', 'quantite': '2'}, {'ingredient_id': 'a5f18156-144f-405f-82d8-b36191320ac2', 'quantite': '100 g'}, {'ingredient_id': 'b11c45ab-9a92-49fe-ac52-a06ba1e3bb8d', 'quantite': '80 g'}, {'ingredient_id': '70644f75-e2f1-46db-a315-b236101e6374', 'quantite': '2'}, {'ingredient_id': '3a94af1d-1874-44c5-be23-c0368655fa42', 'quantite': '250 g'}, {'ingredient_id': '188dad00-3ade-465e-a333-e939f18d1c0f', 'quantite': '1'}, {'ingredient_id': '9127c91f-4c70-4c9b-947a-f997b5ad85a3', 'quantite': '1'}, {'ingredient_id': '2b5588a5-0d32-4d77-a2f3-0a379485bd36', 'quantite': '2 cuillères'}, {'ingredient_id': '3adf5328-1eab-4d1b-82a2-b3818cf2859e', 'quantite': '4 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (83292, 'Crumble d''automne (pomme, bananes)', 'pomme, banane, sucre roux, sucre en poudre, farine, beurre', '30 min', ['Préchauffez votre four à 175°C (thermostat 5-6).', 'Épluchez les pommes, retirez leurs cœurs et les coupez en quartiers. Épluchez les bananes et les couper en rondelles épaisses.', 'Faites fondre la cuillère à soupe de beurre dans une poêle. Jetez les fruits dans la poêle et ajoutez le sucre roux. Faites dorer les fruits en les remuant, jusqu''à ce qu''ils soient caramélisés. Mettez les fruits au fond d''un plat allant au four.', 'Versez dans un grand bol, le sucre en poudre, la farine et le beurre. Mélangez avec vos mains, afin d''obtenir une pâte émiettée.', 'Puis répartissez votre pâte en miettes sur les fruits.', 'Enfournez le crumble pendant 45 minutes au four à 175°C (thermostat 5-6).'], ['Fouet', 'Poêle', 'Râpe', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'Crumble d''automne (pomme', 'dessert', 'bananes)', 'plat de résistance', 'pomme', 'autres crumbles', 'beurre', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:18:29.079992', [{'ingredient_id': '380217f4-42cc-4504-bb5b-f2b694880263', 'quantite': '4'}, {'ingredient_id': '75e1d86c-e29a-4f06-9751-8950eea7ffc4', 'quantite': '2'}, {'ingredient_id': '9f61381c-ab4d-4c9d-bdf6-4fa049552945', 'quantite': '1 cuillères'}, {'ingredient_id': '2b732263-aa65-46d9-804f-a8f873eae78e', 'quantite': '100 g'}, {'ingredient_id': 'cfd94468-1691-4405-af74-c973c551c052', 'quantite': '100 g'}, {'ingredient_id': 'f926c120-5d6b-46c4-84d6-6470ec628bdf', 'quantite': '75 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12623, 'Scampis à la banane', 'scampi, margarine, oignon, poivre, sel, curry, vin blanc, crème fraîche, banane, persil', '20 min', ['Dégeler les scampis (s''ils sont congelés), les peler.', 'Faire fondre une noix de margarine, y mettre l''oignon  et ensuite les scampis. Assaisonner de poivre de sel et de curry. Ajouter le vin et faire réduire de moitié.', 'Retirer les scampis de la poêle, dans laquelle on verse la crème. Amener à ébullition quelques instants.', 'Peler les bananes et les découper en fines rondelles. Les ajouter à la sauce. La faire bouillir jusqu''à ce qu''elle épaississe (ne pas réduire les bananes en purée !!!).', 'Réchauffer les campis dans la sauce. Au dernier moment, incorporer le persil en remuant.'], ['Casserole', 'Fouet', 'Tire-bouchon', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'très facile', 'vin blanc', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'scampi', 'margarine', 'dessert', 'persil', 'plat de résistance', 'Scampis à la banane', 'moyen', 'poivre', 'curry', 'cocktail'], 'Entrée', 8f078dc3-41b2-407f-8f25-2cf76c540c9d, '2025-09-26T15:18:33.731345', [{'ingredient_id': '0c87c206-c6c2-4b00-ae8c-1633f9191596', 'quantite': '40'}, {'ingredient_id': '481b2681-317f-4f52-b29f-408de90b7c57', 'quantite': ''}, {'ingredient_id': 'de1787bc-21c9-4d35-80cc-f12467d0fbc8', 'quantite': '1'}, {'ingredient_id': '6b2a02c6-dd29-4253-829b-cd6ea0df07cc', 'quantite': ''}, {'ingredient_id': 'b98f6225-3471-4660-84a5-7d379e164888', 'quantite': ''}, {'ingredient_id': 'cbba818c-341b-4153-bb45-1e5d922a897a', 'quantite': ''}, {'ingredient_id': 'f3a3fac9-3dae-4243-81c5-2aff93f01e06', 'quantite': '1'}, {'ingredient_id': '0f255482-2f0a-4385-ab01-95bfa49b1cdb', 'quantite': '2.5'}, {'ingredient_id': '24f2164a-e814-41a5-ac81-e3234214e78d', 'quantite': '2'}, {'ingredient_id': '1136740e-ebf9-4421-84b2-70a19ab00eb3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (82248, 'Tortillas sucrées aux bananes et sauce caramel', 'tortilla, beurre, sucre brun, crème fraîche, vanille, cannelle, banane, crème', '10 min', ['Faites fondre le beurre dans une casserole à feu moyen, ajoutez le sucre et la crème. ', 'Mélangez jusqu''à ce que le sucre se dissolve. ', 'Portez à ébullition et ajoutez la cannelle et l''extait de vanille.', 'Ajoutez les bananes coupées en rondelles et mélangez.', 'Baissez le feu et laissez cuire environ 3 minutes.', 'Réchauffez les galettes.', 'Placez les rondelles de bananes sur chaque tortillia, roulez les tortillias et nappez de sauce caramel.', 'Accompagnez d''une boule de crème glacée'], ['Spatule', 'Râpe', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'caramel', 'bon marché', 'plat', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre brun', 'vanille', 'dessert', 'plat de résistance', 'beurre', 'tortilla', 'cannelle', 'Tortillas sucrées aux bananes et sauce caramel', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:18:37.348019', [{'ingredient_id': '7469b71e-c498-4f2f-b658-50c9db78426b', 'quantite': '8'}, {'ingredient_id': 'c7d55c80-57ec-4ab8-b1c4-8a0ce2448424', 'quantite': '15 g'}, {'ingredient_id': '5e97a64a-d382-4b99-9cb1-95f945824253', 'quantite': '140 g'}, {'ingredient_id': '492d7466-f939-437f-b072-4a26085aa786', 'quantite': '30 cl'}, {'ingredient_id': '1f8b8ec4-71a0-4b41-8b1c-8a67cd11b41a', 'quantite': '1 cuillères'}, {'ingredient_id': '737c1d6a-86c2-4af4-9094-a1b4e5027044', 'quantite': '1 cuillères'}, {'ingredient_id': 'f9e7e6cf-c7d5-4a11-8c73-e0717ce3e233', 'quantite': '8'}, {'ingredient_id': '9b6744d5-035a-4db7-a771-5ec1d2eb1ebe', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (309740, 'Un smoothie simple et excellent, cerise, banane, passion', 'glaçons, cerises, banane, fruit de la passion, sucre', '2 min', ['Mixer les ingrédients et servir de suite.', 'Santé !'], ['Presse-agrumes', 'Batteur électrique'], ['cerise', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'Un smoothie simple et excellent', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'fruit de la passion', 'passion', 'dessert', 'plat de résistance', 'glaçons', 'sucre', 'smoothies', 'cocktail', 'cerises'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:18:41.432115', [{'ingredient_id': '4d8600fb-ac8b-45ff-8e3c-fc54797fe4cd', 'quantite': '3'}, {'ingredient_id': '8e7b67fd-87f0-478b-bb40-13a077858391', 'quantite': '1.5'}, {'ingredient_id': 'a48537f5-c1fc-47ad-9752-86e4ef1a2de3', 'quantite': '1'}, {'ingredient_id': 'ee903777-f090-4e0c-badc-6aadf59e1ce2', 'quantite': '1'}, {'ingredient_id': 'e7ff8737-50bd-4cc1-8c51-99c17b2b81de', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (84574, 'Verrines Manda-banane', 'mascarpone, banane, sucre en poudre, biscuits à la cuillère, rhum, eau, clémentine, vanille, fraises tagada®, bille de décoration sucré', '30 min', ['Mélanger au fouet le mascarpone, la banane écrasée, le sucre, la vanille.', 'Répartir dans les verrines de la façon suivante:', 'D''abord, 1 bonne cuillère à soupe de crème.', 'Puis 1 biscuit cassé en 2 trempé dans le mélange rhum-eau.', 'Puis de nouveau, 1 bonne cuillère à soupe de crème.', 'Ensuite, les 4 quartiers de clémentine sur les bords de façon à faire apparaître le côté le plus large.', 'Ajouter 1 bonne cuillère à café de crème au centre des quartiers.', 'Enfin, mettre 1 fraise Tagada ® et quelques billes sucrées pour couronner le tout!', 'Laisser prendre au réfrigérateur pendant 3h au moins.'], ['Ouvre-boîte', 'Moule à tarte', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'rhum', 'confiserie', 'eau', 'testées', 'biscuits à la cuillère', 'facile', 'rapide', 'plat', 'fraises tagada®', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'bille de décoration sucré', 'boisson', 'vanille', 'clémentine', 'dessert', 'plat de résistance', 'moyen', 'Verrines Manda-banane', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:18:45.062065', [{'ingredient_id': '8a7cda82-03af-4939-93ec-83ee7c86fdc7', 'quantite': '250 g'}, {'ingredient_id': '3077ebc5-45d8-49ef-95f6-7ac204eed40b', 'quantite': '1'}, {'ingredient_id': '8a47e13e-c7fe-4486-9ebd-18bb0da7d017', 'quantite': '20 g'}, {'ingredient_id': '0b4ba9dc-c6ba-436e-9f7c-0f36aebf4299', 'quantite': '5'}, {'ingredient_id': '3d454684-b95c-41cc-90c9-ccc0bfb4086b', 'quantite': ''}, {'ingredient_id': '799428ca-36cf-47dc-be10-52793bd8e4be', 'quantite': ''}, {'ingredient_id': '4129e3a1-e683-4a02-bbf5-0daa6db10510', 'quantite': '20'}, {'ingredient_id': '94846a80-88e1-4190-920d-42b965f7889c', 'quantite': '1 cuillères'}, {'ingredient_id': 'b2ee0770-2c1b-491a-911b-7056cf8d5e3f', 'quantite': '5'}, {'ingredient_id': '513c2fbf-2643-4c33-81c2-27d605279aa8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (64491, 'Tarte bananes, amandes et cannelle', 'amandes en poudre, banane, sucre, oeuf, pâte brisée, crème, cannelle', '10 min', ['Préchauffer le four à 200°C (thermostat 6-7).', 'Etaler la pâte dans un moule à tarte.', 'Couper les bananes en rondelles fines et les disposer sur la pâte.', 'Mélanger les oeufs, la crème, la poudre d''amandes, le sucre et la cannelle.', 'Verser le mélange sur la tarte.', 'Enfourner pour 30 minutes.'], ['Poêle', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'amandes et cannelle', 'amandes en poudre', 'oeuf', 'plat', 'tarte à la banane', 'crème', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'Tarte bananes', 'plat de résistance', 'cannelle', 'sucre', 'cocktail'], 'Dessert', c1150c47-e860-4d00-9020-e9a56becb6c9, '2025-09-26T15:18:48.482213', [{'ingredient_id': '4d8b86b2-acba-4378-bfe1-53326cbbead7', 'quantite': '65 g'}, {'ingredient_id': '59600316-0663-449e-a6b7-be9e77f69994', 'quantite': '4'}, {'ingredient_id': '22aeafd4-f794-4743-b3bd-766bf23fe05d', 'quantite': '100 g'}, {'ingredient_id': 'fb6cfb9d-786c-4307-a321-e9a665653c60', 'quantite': '3'}, {'ingredient_id': 'e23e23a1-89a3-44c5-b4e4-7d6b3f75ca15', 'quantite': '1'}, {'ingredient_id': '50b65826-fa07-4498-8452-783882aec5e0', 'quantite': '30 cl'}, {'ingredient_id': 'e2251340-1a1f-4c5c-b9a4-0e976901629d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (309354, 'Délice de banane à la chantilly', 'banane, sucre, crème fraîche liquide, fixe chantilly, fromage blanc, vermicelles', '40 min', ['Mettre les bananes en morceaux dans une casserole avec un fond d''eau et recouvrir de la moitié du sucre.', 'Faire cuire à feu moyen pour obtenir de la compote de banane.', 'A mi-cuisson ajouter le reste de sucre, et mélanger régulièrement.', 'Une fois votre compote cuite (couleur marron-rose) la mettre dans un saladier et faire refroidir.', 'Pendant ce temps, préparer la chantilly.', 'Mettre la crème fraîche liquide dans un saladier froid et fouetter en ligne droite (jamais en rond).', 'A mi-course verser la chantifix (ou cremfix) puis continuer a fouetter pour obtenir votre chantilly.', 'Lorsque votre compote de banane à refroidi mettre le mascarpone (ou fromage blanc) et mélanger pour obtenir une crème onctueuse et colorer.', 'Verser petit a petit votre mélange dans la chantilly jusqu''à obtention d''une mousse goût banane.', 'Servir dans un ramequin et mettre au frais avant de servir et d''y mettre les petits vermicelles de chocolat.'], ['Mixeur', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'Délice de banane à la chantilly', 'recettes de cuisine', 'fixe chantilly', 'confiserie', 'testées', 'facile', 'vermicelles', 'bon marché', 'rapide', 'plat', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', 51332f20-6feb-4965-ba8e-863bb930707c, '2025-09-26T15:18:52.013702', [{'ingredient_id': '2dfabbfb-e17f-40cb-8ab2-aeaa3318122c', 'quantite': '8'}, {'ingredient_id': '02f3517a-7652-4fef-95b0-15a9d9ef76df', 'quantite': '50 g'}, {'ingredient_id': '59aa003c-98f0-4b93-8a67-67beb0761946', 'quantite': '30 cl'}, {'ingredient_id': '40612ada-3389-4c6e-96ac-5086d6b60ccb', 'quantite': '1'}, {'ingredient_id': 'f602fbcc-fb57-4d34-af85-0eb4b6daf192', 'quantite': '150 g'}, {'ingredient_id': 'f0419072-c347-4bdc-815e-305f18b12d30', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50293, 'Cheesecake à la banane sauce caramel', 'Spritz, beurre, banane, oeuf, petit suisse, Saint Morêt, sucre en poudre, cannelle, jus de citron, caramel, yaourt brassé', '30 min', ['Ces proportions sont données pour un moule à charnière ou un cercle à pâtisserie de 24 cm de diamètre.', 'Préchauffer le four à 180°C (thermostat 6).', 'Mettre les biscuits dans un sac congélation et les écraser à l''aide d''un rouleau à pâtisserie.', 'Quand ils sont en miettes, les mélanger au beurre fondu.', 'Bien tasser ce mélange au fond du moule et enfourner 10 minutes.', 'Sortir le moule du four et baisser la température à 140°C (thermostat 4-5).', 'Préparer la crème : écraser les bananes arrosées de jus de citron à la fourchette.', 'Ajouter le fromage frais, les petits-suisses et mélanger à l''aide d''un fouet électrique (vitesse minimum) pendant environ 30 secondes.', 'Ajouter ensuite le sucre puis les oeufs, un à un, et enfin la cannelle en ne battant le mélange que le temps nécessaire à l''incorporation des ingrédients.', 'Verser la crème sur le fond de pâte et enfourner pour 1 heure de cuisson.', 'Pour éviter que des crevasses ne se forment sur le cheesecake, le refroidissement est une étape capitale!', 'En effet il ne supporte pas les écarts de température soudains.', 'Une fois le cheesecake cuit, éteindre le four et le laisser dans le four porte fermée pendant 1 à 2 heures, puis le sortir et attendre son complet refroidissement avant de le démouler et de le mettre au réfrigérateur pour au moins 24 heures.', 'Préparer la sauce juste avant de servir: ', 'Déballer les caramels dans une casserole et les faire fondre à feu très doux.', 'Ajouter les yaourts et bien mélanger, toujours à feu doux, jusqu''à obtention d''une sauce homogène.', 'Au moment de le servir, décorer le cheesecake de bananes coupées en rondelles fines, arrosées de quelques gouttes de jus de citron, et saupoudrer le tout de cannelle.'], ['Ouvre-boîte', 'Planche à découper', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt brassé', 'confiserie', 'petit suisse', 'testées', 'Saint Morêt', 'Cheesecake à la banane sauce caramel', 'caramel', 'bon marché', 'oeuf', 'plat', 'moyenne', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'Spritz', 'plat de résistance', 'jus de citron', 'beurre', 'cannelle', 'cocktail'], 'Dessert', b48aa1ad-d0ae-4323-9af5-ab2120f213d7, '2025-09-26T15:18:55.609173', [{'ingredient_id': '5d0daaba-258d-4b60-9c49-9740d1f92145', 'quantite': '200 g'}, {'ingredient_id': '0c05abf5-d57b-4813-897f-82e2796a6a72', 'quantite': '80 g'}, {'ingredient_id': 'bcb2a3aa-f72c-4b61-828d-3a51ece82794', 'quantite': '4'}, {'ingredient_id': '07a824a5-264c-4296-adfe-009b2be53887', 'quantite': '4'}, {'ingredient_id': 'd26a425d-492e-4c15-bb82-e39afe3a95f9', 'quantite': '6'}, {'ingredient_id': '8c0b5b53-6606-427e-9be2-6e2260640dbd', 'quantite': '450 g'}, {'ingredient_id': 'f989b57e-13cb-4f49-9cb5-fa7d1aff7c48', 'quantite': '150 g'}, {'ingredient_id': 'bb99d84e-d45c-47a1-bfec-7d872cb49e25', 'quantite': '1 cuillères'}, {'ingredient_id': '264fde6a-7080-4d80-91b4-4ea6605401fd', 'quantite': '1'}, {'ingredient_id': '0fef8c9a-403e-4c5f-9828-1353fb835863', 'quantite': '300 g'}, {'ingredient_id': 'a7616c8d-e60d-4c84-99a0-22e2cd7b5804', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21438, 'Milk shake', 'fromage blanc, sucre, lait, banane', '5 min', ['Mélanger tout dans le robot jusqu''à ce que çà mousse.'], ['Spatule', 'Poêle', 'Verre doseur', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Milk shake', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'lait', 'sucre', 'cocktail'], 'Boisson', 458ac38c-7d62-49eb-b644-379577e0b6c8, '2025-09-26T15:18:59.065440', [{'ingredient_id': 'b6a9033a-615c-4467-8a51-30e098d43b4c', 'quantite': '2 cuillères'}, {'ingredient_id': '7831f6ac-8fce-4f18-bd68-f1015a246584', 'quantite': '1 cuillères'}, {'ingredient_id': '066c71a2-d779-4f87-b238-09658f0a9859', 'quantite': ''}, {'ingredient_id': 'de06ce97-bb8b-4703-a537-4851850a9b52', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36989, 'Tarte bananes chocolat', 'pâte sablée, chocolat pâtissier, crème liquide, banane, sucre en poudre, oeuf, lait', '10 min', ['Préchauffez le four à 200°C (thermostat 6-7).', 'Etalez la pâte sablée dans un plat à tarte.', 'Faites fondre au micro-onde le chocolat pâtissier avec la crème liquide pendant 1min30.', 'Etalez-le sur la pâte.', 'Déposez les rondelles de bananes sur le chocolat. ', 'Mélangez les oeufs, le lait et le sucre en poudre ensemble, si vous avez un shaker, joignez-y ces ingrédients et agitez, c''est très efficace.', 'Il ne vous reste plus qu''à verser cette préparation sur les bananes.', 'Mettez au four pendant 20 min.'], ['Louche', 'Balance de cuisine', 'Spatule', 'Verre doseur'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'Tarte bananes chocolat', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:19:05.757541', [{'ingredient_id': '9ba4e768-7763-488b-a4f5-ebcb0974998b', 'quantite': '1'}, {'ingredient_id': '88da703d-34e4-4120-979a-d2fc9a36d0fd', 'quantite': '100 g'}, {'ingredient_id': '59eae4b7-5868-4be5-b84f-4622b2491112', 'quantite': '10 cl'}, {'ingredient_id': '1400f6c5-cb86-4b65-a14a-6141b5a63802', 'quantite': '4'}, {'ingredient_id': 'd5658e54-555e-4064-b587-d0356488edb8', 'quantite': '50 g'}, {'ingredient_id': '6f8a618d-baf5-4f82-bc32-b7a291c36c28', 'quantite': '3'}, {'ingredient_id': '05dee442-0b27-42be-9c39-99a98d1dec4b', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (53349, 'Crevettes et pétoncles au lait de coco, curcuma et curry', 'crevette rose, noix de pétoncle, lait de coco, oignon, tomate, banane, curcuma, curry, poivre, sel', '45 min', ['Décortiquer les crevettes en laissant l''extrémité de la queue.', 'Les mettre avec les pétoncles encore surgelés dans un saladier.', 'Couper la banane en rondelles et l''ajouter aux crevettes et pétoncles.', 'Recouvrir ce mélange avec le lait de coco.', 'Ajouter le curcuma et le cuury.', 'Bien mélanger et laisser macérer au minimum 30 minutes.', 'Pendant ce temps, verser un peu d''huile d''olive dans une poêle à bords hauts et y faire revenir l''oignon émincé et la tomate coupée en petits dés.', 'Saler et poivrer.', 'Bien laiser "sécher".', 'Egoutter les crevettes, pétoncles et banane avec un écumoire et les mettre dans la poêle.', 'Laisser cuire une dizaine de minutes et rajouter 4 à 5 cuillères à soupe du lait de coco dans lequel ont macéré les fruits de mer.', 'Laisser mijoter un moment pour faire réduire la sauce.', 'Servir avec du riz thaï ou basmati.'], ['Presse-agrumes', 'Mixeur', 'Ouvre-boîte', 'Fouet'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'Crevettes et pétoncles au lait de coco', 'sel', 'confiserie', 'testées', 'facile', 'tomate', 'plat', 'recette', 'cuisine', 'recettes', 'crevette rose', 'oignon', 'boisson', 'curcuma', 'dessert', 'crevettes', 'plat de résistance', 'moyen', 'curcuma et curry', 'poivre', 'curry', 'cocktail', 'noix de pétoncle'], 'Plat principal', 957af551-f972-4162-a6b0-dc042e7cb57e, '2025-09-26T15:19:09.396045', [{'ingredient_id': '9c9a5b67-066f-47e3-a495-ac1a573d6d8d', 'quantite': '400 g'}, {'ingredient_id': '73ee3385-3bec-4fd0-9814-cf08238ab2cd', 'quantite': '150 g'}, {'ingredient_id': '3ee97a1e-d295-4e71-a09e-4a5971e9e211', 'quantite': '40 cl'}, {'ingredient_id': '6f24af0f-ae5d-46f6-8261-6d12dd730d5e', 'quantite': '1'}, {'ingredient_id': '13481f2b-ed97-4987-b012-7087ca1124b5', 'quantite': '1'}, {'ingredient_id': '0066a2a9-1af7-4a69-915c-f9ba1822a9ef', 'quantite': '1'}, {'ingredient_id': 'f05ebd5a-826e-4d90-ae5d-45eaa769b4b1', 'quantite': '1 cuillères'}, {'ingredient_id': 'a1d05667-b6ae-4c13-ad5a-e30dd31afb4c', 'quantite': '1 cuillères'}, {'ingredient_id': 'a16bbbea-631f-4f58-a283-bda045b6d4ba', 'quantite': ''}, {'ingredient_id': '6368b429-dc9e-437f-91b0-705aa6a75d19', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (338321, 'Pancakes banane et rhum facile', 'oeuf, sucre semoule, huile, farine, levure chimique, lait, rhum, banane', '15 min', ['Battre l’oeuf et le sucre dans un saladier, et rajoutez l''huile (ou le beurre selon le gout de chacun).', 'A part, mélangez la farine avec la levure, puis mélangez la moitié avec la préparation.', 'Délayer progressivement avec le lait et rajoutez le reste de farine petit à petit en même temps que le lait en alternant, puis rajoutez le rhum (vous pouvez le doser selon votre gout).', 'Le temps de repos de la pâte n''est pas nécessaire.', 'Découpez la banane en tranche plus ou moins épaisse selon votre gout, mais je conseille à peu près 3 mm.', 'Faite chauffez une petite poêle à feu moyen (ou votre appareil à crêpe), huilez.', 'Déposez 2 tranches de banane, puis la pâte par dessus, étalez-la légèrement pour former un rond.', 'Dès que des bulles apparaissent et éclatent sur la surfaces, retournez votre pancake et ne pas laissez votre pancake plus 1 min sur l''autre face.', 'Si votre pancake est trop brun lorsque vous le retournez baissez légèrement votre feu.'], ['Ouvre-boîte', 'Poêle', 'Verre doseur', 'Casserole', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'levure chimique', 'pancake', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'lait', 'cocktail', 'Pancakes banane et rhum facile'], 'Dessert', 474ecddf-7cfc-4e3b-afb1-5f5120f86a35, '2025-09-26T15:19:12.939522', [{'ingredient_id': '08f47165-2acd-45e5-8f78-7ac514267c32', 'quantite': '1'}, {'ingredient_id': 'e96f6829-1873-4fc5-b7dc-ac4575ddb97a', 'quantite': '1 cuillères'}, {'ingredient_id': 'd41e0ab4-ef1b-49a3-8c1a-9d1d0df00b94', 'quantite': '1 cuillères'}, {'ingredient_id': '3aa10738-b580-4318-8472-3a69963eadd1', 'quantite': '150 g'}, {'ingredient_id': 'dbd9271a-39ae-4380-bd56-e6dadb4ccc8e', 'quantite': ''}, {'ingredient_id': '5e814f28-6780-4b0a-9e75-126398fa1c96', 'quantite': '20 cl'}, {'ingredient_id': 'b4aa211c-0ad2-41be-ab1f-c7835a53e86f', 'quantite': '1 cuillères'}, {'ingredient_id': '7b5c7f67-eedc-4a82-9bd5-217d6172ddba', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (63794, 'Cake marbré banane-chocolat', 'farine, sucre, beurre, oeuf, yaourt, banane, nappage chocolat, lait, levure', '25 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Dans un saladier, mélanger le sucre avec les jaunes d’œufs puis ajouter la farine, la levure et enfin le beurre.', 'Monter les blancs d’œufs en neige et les incorporer à la préparation.', 'Faire fondre le chocolat dans une cuillère à soupe de lait.', 'Écraser les bananes, ajouter le yaourt et mélanger.', 'Verser la moitié de la préparation dans un 2ème saladier et y ajouter le chocolat fondu.', 'Dans l’autre moitié, incorporer les bananes écrasées.', 'Verser dans un moule à cake beurré en alternant les préparations chocolat et banane.', 'Faites cuire pendant 40 à 45 min à four chaud.'], ['Tire-bouchon', 'Batteur électrique', 'Louche', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'beurre', 'Cake marbré banane-chocolat', 'nappage chocolat', 'sucre', 'lait', 'cocktail'], 'Dessert', fcc657e5-9f6c-4817-8213-7839f4092b26, '2025-09-26T15:19:17.441356', [{'ingredient_id': 'b16b9ddd-4bf7-4a16-a77e-295e9c69eb92', 'quantite': '150 g'}, {'ingredient_id': '3dd34275-6eb6-472e-b7d8-b337c9c88143', 'quantite': '80 g'}, {'ingredient_id': '627bbd95-3f42-444b-ba16-f557594c0703', 'quantite': '80 g'}, {'ingredient_id': 'e68b3574-6655-493f-88dd-2637edecb2c0', 'quantite': '4'}, {'ingredient_id': 'ff93a578-c884-46e3-8d88-e004827b824f', 'quantite': '1'}, {'ingredient_id': 'd2c31665-29af-49e5-b1bd-88318062a8ac', 'quantite': '2'}, {'ingredient_id': 'f31aead2-fa01-4f77-bbea-5ab3b89cbb71', 'quantite': '150 g'}, {'ingredient_id': '2af6da50-2a63-45a8-ae6d-cc4afe7316d6', 'quantite': '1 cuillères'}, {'ingredient_id': '2cfdf9d7-cda3-48fb-89c0-a05f562536dd', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (195488, 'Filets de lapin sucré salé', 'lapin, curry, tomates pelées, oignon, banane plantain, pomme, ananas, noix de coco, ail, huile d''arachide, margarine, bouquet garni, poivre, sel', '45 min', ['Faire dorer les filets de lapin dans l''huile. ', 'Retirer les morceaux et mettre les oignons hachés à la place.', 'Les faire fondre sur feu doux sans les laisser colorer.', 'Ajouter les tomates, remettre le lapin, saler, poivrer et poudrer de curry en remuant bien.', 'Mouiller avec la poudre de noix de coco délayée dans 30 cl d''eau.', 'Ajouter l''ail émincé et le bouquet garni. Porter à ébullition puis baisser le feu.', 'Faire revenir dans la margarine les pommes, les ananas et les bananes épluchés et coupés en dés.', 'Servir le lapin nappé de la sauce et entouré des fruits.'], ['Casserole', 'Passoire'], ['', 'entrée', 'huile d''arachide', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'tomates pelées', 'lapin', 'bouquet garni', 'bon marché', 'ail', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'margarine', 'dessert', 'plat de résistance', 'banane plantain', 'pomme', 'ananas', 'noix de coco', 'poivre', 'curry', 'cocktail', 'Filets de lapin sucré salé'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:19:21.614813', [{'ingredient_id': 'd7cf630d-5663-4642-b0a7-26d59cb587ea', 'quantite': '600 g'}, {'ingredient_id': 'c4568487-a339-4c6e-92e2-4d7d3eff9fed', 'quantite': '2 cuillères'}, {'ingredient_id': '2f0f2860-3367-48da-bcb0-19a6d549bdcf', 'quantite': '200 g'}, {'ingredient_id': '2d8f7378-c7ae-4c20-bdff-2f6d7885a200', 'quantite': '200 g'}, {'ingredient_id': '9c15538b-14e1-4dee-aac4-e6f9180e4f97', 'quantite': '200 g'}, {'ingredient_id': 'dc5f9456-0ec3-495d-9010-09f9933504b8', 'quantite': '300 g'}, {'ingredient_id': '0ea3c930-f218-4ccf-88bf-3038aee626d2', 'quantite': '300 g'}, {'ingredient_id': '97512711-7347-4d2f-914c-44c243343dc0', 'quantite': '8 cuillères'}, {'ingredient_id': '00862d57-7b15-43aa-9e64-43970a36a344', 'quantite': '4'}, {'ingredient_id': '089b613b-7a30-43fc-939e-22cea65d129e', 'quantite': '4 cuillères'}, {'ingredient_id': '3d26f6d9-f205-4a1c-83cb-052875f58642', 'quantite': '4 cuillères'}, {'ingredient_id': 'bcef6e93-a8b5-450b-977e-206eb330f880', 'quantite': '1'}, {'ingredient_id': 'bb588769-2a5b-4d4c-854e-51493ffdfb0d', 'quantite': ''}, {'ingredient_id': 'bb8dc8bf-a4c3-4e5f-9476-c1a9f819ed86', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33135, 'Tarte tatin de bananes et de figues', 'pâte feuilletée, banane, Confiture de figue, sucre, sucre vanillé', '5 min', ['Préchauffer le four 10 mn à 210°C. ', 'Couvrir le fond du moule de papier sulfurisé ou papier de cuisson. ', 'Saupoudrer légèrement de sucre. Couper les bananes en rondelles et garnir le fond du moule. Saupoudrer avec le sucre vanillé. Etaler la confiture de figues par dessus (épaisseur selon goût mais attention, la confiture de figues est généralement très sucrée !). ', 'Recouvrir avec la pâte feuilletée en rentrant bien les bords. ', 'Enfourner et laisser cuire 30 mn.'], ['Pince de cuisine', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'Tarte tatin de bananes et de figues', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'tarte Tatin', 'dessert', 'plat de résistance', 'pâte feuilletée', 'sucre vanillé', 'sucre', 'Confiture de figue', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:19:25.225512', [{'ingredient_id': '69437cec-4311-4d1a-a42c-0ff29942db0a', 'quantite': '1'}, {'ingredient_id': '7f38f26f-791e-4ecc-a24b-7d88602b8276', 'quantite': '2'}, {'ingredient_id': 'a5fd1bbe-31f4-4945-9143-1a678e6a5d18', 'quantite': '1'}, {'ingredient_id': '605c2df0-9cfc-4396-be4b-dfc8f51cbc29', 'quantite': ''}, {'ingredient_id': '0ea5ee53-943e-4a9d-bd82-a42bc40f8b17', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (80949, 'salade de fruits agrumes banane', 'kiwi, orange, banane, arôme fleur d''oranger, sucre', '15 min', ['Eplucher tous les fruits et une seule orange en veillant à ne laisser que la chair de l''orange.', 'Découper les fruits en quartiers et rondelles.', 'Dans un saladier, mélanger délicatement les fruits avec le jus de la deuxième orange. Ajouter 3 cuillères à soupe de fleur d''oranger.', 'Enfin, ajouter deux cuillères à soupe de sucre en poudre.'], ['Spatule', 'Couteau de chef', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'arôme fleur d''oranger', 'orange', 'sucre', 'salade de fruits agrumes banane', 'cocktail'], 'Dessert', 674ccaf9-ba11-4ae6-8e40-33143f5ced60, '2025-09-26T15:19:28.717272', [{'ingredient_id': '7459bf24-f0e2-4b07-b6fc-99193d53c8d5', 'quantite': '2'}, {'ingredient_id': '8d3879de-085e-487a-b837-44ecd3853c7b', 'quantite': '2'}, {'ingredient_id': 'b80873e3-db70-4f5d-9cf3-2b494b864a3b', 'quantite': '1'}, {'ingredient_id': 'afe6f2dc-7eef-4844-9f1f-d3c9bdb3b034', 'quantite': ''}, {'ingredient_id': 'e6ce85d6-5943-4867-8eae-cc7f08d03233', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24485, 'crumble aux bananes et au chocolat', 'banane, poire, sucre, beurre, farine, beurre, rhum, chocolat noir', '15 min', ['Eplucher les poires et les bananes, couper les premières en morceaux et les deuxièmes en tranches. ', 'Dans une poêle, faire chauffer un peu de beurre, et y mettre les fruits. faire cuire. ', 'Préparer la pâte du crumble en malaxant 200 g de beurre ramolli, 250 g de farine et 200 g de sucre. ', 'Quand les fruits sont bien fondants, verser dessus les 100 g de sucre restants et faire légérement caraméliser. Dès qu''on atteint ce stade, faire chauffer le rhum (quantité en fonction des goûts) dans un petite casserole. Quand il est chaud, l''enflammer et le vider très rapidement sur les fuits chauds  (attention à NE PAS LE FAIRE sous la hotte !) pour les flamber. Bien agiter la poêle pour brûler tout l''alcool. ', 'Mettre les fruits dans un plat à gratin de façon à ce qu''ils recouvrent le fond complètement. ', 'Laisser refroidir, puis à l''aide d''un couteau parsemer de copeaux de chocolat. ', 'Recouvir avec la pâte qui doit être friable. Procéder en ajoutant la pâte par petits morceaux, mais bien recouvrir le tout. ', 'Enfourner à four chaud pour environ 35 mn. Surveiller le plat, quand la pâte est bien dorée, le sortir du four. ', 'A déguster tiède ou chaud. ', 'On peut servir avec un crème anglaise nature ou dans laquelle on aura ajouté un peu de rhum. ', 'Pour les quantités d''ingrédients pour la pâte du crumble, il peut y avoir des variations en fonction du type de farine utilisé.'], ['Tire-bouchon', 'Passoire', 'Poêle', 'Planche à découper', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'poire', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'crumble aux bananes et au chocolat', 'dessert', 'plat de résistance', 'chocolat noir', 'autres crumbles', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:19:32.187192', [{'ingredient_id': 'fc6d7816-2b25-4386-af05-9966ffffd42b', 'quantite': '6'}, {'ingredient_id': 'e42c51fe-2c58-4054-8bd2-0589dd6ee544', 'quantite': '3'}, {'ingredient_id': 'e057d8a6-6259-4947-93f3-bce3976ec70f', 'quantite': '300 g'}, {'ingredient_id': '6ce0dc0e-f9ff-43f9-94d7-cdb4669e611c', 'quantite': '200 g'}, {'ingredient_id': 'f884bc4e-6966-4dde-8a41-8079da4a4023', 'quantite': '250'}, {'ingredient_id': 'bc0011cd-c9da-47e5-bd3b-6f5afe11cd34', 'quantite': ''}, {'ingredient_id': '44d510e7-8a10-4095-9056-4ea0b782c754', 'quantite': ''}, {'ingredient_id': 'bff0c341-cffc-428f-85ef-f58c8aba15e7', 'quantite': '120 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (39335, 'Punch banane, mangue, ananas', 'banane, mangue, jus d''ananas, rhum, vanille, cannelle, muscade', '10 min', ['Couper grossièrement les bananes et la mangue, et les mixer à l''aide d''un robot mixeur. ', 'Verser la purée obtenue, dans un grand saladier.', 'Ajouter le jus d''ananas et le rhum, mélanger.', 'Ajouter ensuite, la vanille liquide, la cannelle (1 à 2 cuillère à café, suivant les goûts) et la muscade (éviter de mettre plus de muscade que de cannelle).', 'Bien mélanger et mettre au réfrigérateur pendant quelques heures.', 'Avant de servir, bien mélanger à nouveau (un dépôt peut se former en surface) et servir, à l''aide d''une louche, dans des verres à bords larges.'], ['Pince de cuisine', 'Fouet', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'Punch banane', 'testées', 'muscade', 'facile', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'punch', 'dessert', 'plat de résistance', 'jus d''ananas', 'moyen', 'ananas', 'cannelle', 'cocktail'], 'Boisson', 0c960440-e870-48d7-b20a-efebf30a4c12, '2025-09-26T15:19:35.701138', [{'ingredient_id': 'daef48bd-cf7c-4304-ae12-abf6991a8679', 'quantite': '3'}, {'ingredient_id': 'e3963b5d-a8fa-4a64-aeab-65ee454da0a4', 'quantite': '1'}, {'ingredient_id': '3f2a5130-2fec-4193-970d-0b2a6840ea53', 'quantite': '1.5 l'}, {'ingredient_id': '1c485005-0036-452b-8277-871c58a9634c', 'quantite': '40 cl'}, {'ingredient_id': '2c86a069-1ba5-421a-a2ee-e69f51a2d815', 'quantite': '1 cuillères'}, {'ingredient_id': 'caa4d1cc-327d-4f21-84b4-12a84d3378d0', 'quantite': ''}, {'ingredient_id': '145fa6c0-f3ac-4fa4-aecb-e4b07dbc375c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56152, 'Terrine de crêpe pomme banane chocolat', 'crêpe, pomme, banane, citron, eau, sucre vanillé, chocolat, crème fleurette, banane', '40 min', ['La veille : réalisation de la compote et montage de la terrine :', 'Compote pomme-banane :', 'Peler les pommes, les couper en petits morceaux, faire de même avec les bananes.', 'Cuire les fruits à feu doux pendant 20 minutes, avec l''eau et le jus de citron et 2 sachets de sucre vanillé.', 'Préparation de la terrine :', 'Tapisser un moule à cake : 2 crêpes qui dépassent sur le côté et 1 au fond.', 'Mettre de la compote sur la crêpe puis la refermer et faire de même avec le reste des crêpes.', 'Pour la dernière, refermer avec 1/2 crêpe et rabattre les deux crêpes du départ sur le dessus de la terrine.', 'Mettre au réfrigérateur.', 'Le lendemain :', 'Préparer la crème chocolat : faire fondre le chocolat en morceaux au micro-ondes avec un peu d''eau puis ajouter la crème et mélanger.', 'Servir la terrine en grosses tranches sur des assiettes individuelles avec une demi-banane coupée en rondelle autour et arrosée de crème chocolat.'], ['Fouet', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'Terrine de crêpe pomme banane chocolat', 'cuisine', 'recettes', 'boisson', 'crêpe', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'crêpes sucrées', 'citron', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:19:39.876162', [{'ingredient_id': '1059bce3-79da-4bd6-b073-6f43532291be', 'quantite': '6'}, {'ingredient_id': 'bbe3a965-77a6-409f-a6ce-6222814077b8', 'quantite': '10'}, {'ingredient_id': 'a981527a-f30c-4903-bcfe-ad81a902c84b', 'quantite': '5'}, {'ingredient_id': '95028081-ecb6-4d9b-bd70-09c95fa2be53', 'quantite': ''}, {'ingredient_id': '01f4f1db-84ef-48f5-a514-be974714f435', 'quantite': '20 cl'}, {'ingredient_id': '9075f657-fa75-444f-82a3-e94952a90367', 'quantite': '2'}, {'ingredient_id': '693c3016-8d46-4ba6-adf1-784bbdbfc9c7', 'quantite': '20 g'}, {'ingredient_id': '8cb9b1bd-6b9a-41ce-b7f3-d9840b8e465f', 'quantite': ''}, {'ingredient_id': '50678935-0e67-47fe-9ddc-25397d1503fa', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81418, 'Tiramipêche  pomme - banane', 'mascarpone, jaune d''oeuf, blanc d''oeuf, sucre roux, spéculoos, pomme, pêche, banane, sel, cannelle', '30 min', ['Eplucher les fruits, les couper en petits morceaux et les faire compoter dans une casserole. Etaler la compote dans un plat et laisser refroidir.', 'Mélanger 3 jaunes d''oeufs avec le sucre et faire mousser.', 'Ajouter la mascarpone et bien mélanger.', 'Ajouter une pincée de sel dans les blancs d''oeufs et les battre en neige. Ajouter ensuite délicatement au reste de la préparation.', 'Recouvrir la compote d''une couche de spéculoos puis de la préparation. Saupoudrer de cannelle.', 'Placer au réfrigérateur pendant environ 1 heure.'], ['Verre doseur', 'Casserole', 'Louche', 'Couteau de chef', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'sel', 'confiserie', 'testées', 'Tiramipêche  pomme - banane', 'facile', 'rapide', 'plat', 'jaune d''oeuf', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'pêche', 'cannelle', 'blanc d''oeuf', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:19:43.428378', [{'ingredient_id': '020aa96e-0165-4696-a0f0-26f63c645077', 'quantite': '250 g'}, {'ingredient_id': 'da0ac7e0-aa9a-481a-8f97-8e4715610740', 'quantite': '3'}, {'ingredient_id': 'aa40a335-c2c9-469c-bf3a-fc16298c8761', 'quantite': '2'}, {'ingredient_id': 'ce7008be-e41b-41ea-9fd7-8c5a515183f1', 'quantite': '100 g'}, {'ingredient_id': 'af64a0b7-0bc6-4b89-a57f-82db60f00a79', 'quantite': '100 g'}, {'ingredient_id': 'acd05f5f-4866-4634-991e-9b9560a3bb87', 'quantite': '3'}, {'ingredient_id': '96e7119b-7ecb-4868-b741-a149d0316dda', 'quantite': '3'}, {'ingredient_id': '32dcc5bf-fecd-49d3-80d3-1d468635da20', 'quantite': '2'}, {'ingredient_id': 'a676b192-604d-4a65-bd9b-538c842ef9fb', 'quantite': '1'}, {'ingredient_id': '1655c783-a46c-4add-b970-009c5a4fcd6d', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (67796, 'flan de banane très léger et facile ( sans oeuf, sans lait)', 'banane, agar-agar, sucre vanillé, citron vert, banane', '5 min', ['Prélever le zeste d''1/2 citron vert à l''épluche-légume , le couper aux ciseaux en fines lanières (après avoir bien massé le citron sous l''eau chaude pour retirer un peu de traitement si le citron est traité).', 'Eplucher les bananes, les couper en petits cubes, saupoudrer de sucre vanillé, arroser du jus d''un demi-citron les faire revenir dans une poêle non adhésive ou avec un peu de beurre, juste pour que le sucre fonde et les enrobe, il ne faut pas les cuire complètement.', 'Répartir les petits cubes dans de petits moules (silicone c''est mieux, sinon filmer le moule).', 'Dans une casserole mélanger au fouet le litre de nectar et l''agar agar, porter à ébullition en remuant, laisser bouillir 30 secondes', 'verser dans les moules , mélanger un peu avec les cubes, laisser refroidir et mettre au réfrigérateur pendant au moins 2 heures.'], ['Spatule', 'Louche', 'Rouleau à pâtisserie', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'agar-agar', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'flan de banane très léger et facile ( sans oeuf', 'plat de résistance', 'sans lait)', 'sucre vanillé', 'citron vert', 'cocktail', 'oeufs au lait'], 'Dessert', 4b8ae0f6-7fc2-4b2d-8fa7-ff1b0fd173a7, '2025-09-26T15:19:47.491742', [{'ingredient_id': 'd5dedce7-72ed-4481-ace9-15593f7b2bdb', 'quantite': '1 l'}, {'ingredient_id': '4311852c-c673-4334-8493-08f089ffdc50', 'quantite': '4 g'}, {'ingredient_id': 'a0739d2c-152f-4914-8b30-a6a3388521b7', 'quantite': '2'}, {'ingredient_id': 'f210dc87-a5fb-4029-b18d-2c6897c40fc5', 'quantite': '1'}, {'ingredient_id': '803db6ff-ae32-49a0-8cd8-a70e059ffd32', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20956, 'Glace à la banane antillaise', 'banane, sucre, citron, rhum, crème fraîche, raisins secs', '30 min', ['Faire tremper les raisins dans le rhum au moins 30 min.', 'Faire bouillir 40 cl d''eau avec le sucre de manière à obtenir un sirop.', 'Laisser refroidir.', 'Réduire la pulpe de bananes en purée avec le jus des 2 citrons et 2 cuillères à soupe de rhum.', 'Ajouter le sirop.', 'Fouetter la crème en chantilly et l''incorporer au mélange.', 'Egoutter les raisins gonflés et les ajouter délicatement.', 'Faire glacer en sorbetière ou placer au congélateur au moins 3h, en remuant à la fourchette toutes les heures.'], ['Mixeur', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'citron', 'raisins secs', 'sucre', 'glace à l''italienne', 'cocktail', 'Glace à la banane antillaise'], 'Dessert', b651e113-4701-48dc-9330-afedf3a80d1c, '2025-09-26T15:19:51.063040', [{'ingredient_id': '8a5fc590-ea64-41ef-945a-78ed4a21f24f', 'quantite': '500 g'}, {'ingredient_id': 'f8b9b851-f19a-4edd-a239-62da76bc2518', 'quantite': '500 g'}, {'ingredient_id': '364e2da0-c531-40b3-8024-c28e227bd00b', 'quantite': '2'}, {'ingredient_id': '3231229e-c3b7-4616-af90-c81627ead8c5', 'quantite': '15 cl'}, {'ingredient_id': 'f785cdec-f45a-4793-9252-dad0ac78f587', 'quantite': '20 cl'}, {'ingredient_id': 'e4b782b1-127f-46b8-bc03-8519e4b355ed', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (82847, 'Verrine poire banane chocolat', 'poire, banane, chocolat pâtissier, eau, sucre, lait, farine, beurre, sucre', '20 min', ['Couper les poires en petit dés, les faire revenir dans une casserole avec un peu d''eau et un peu de sucre jusqu''à ce que les poires soit cuites.', 'Une fois les poires cuites, ajouter les bananes coupées en rondelles dans la casserole et les laisser fondre un petit peu.', 'Faire fondre le chocolat dans une casserole.', 'Ajouter du lait afin de rendre la texture plus oncteuse et plus lisse.', 'Dans un saladier, mélanger le beurre coupé en morceaux avec la farine, puis le sucre, jusq''à obtention d''une pâte sableuse. ', 'Sur la plaque du four, mettre du papier cuisson et y étaler la préparation sableuse. Laisser dorer à 180°C (thermostat 6) pendant 3 à 5 minutes (surveiller afin de ne pas laisser brûler). Sorter le crumble du four, et émietter.', 'Dans les verrines, mettre les fruits puis faire couler le chocolat esthétiquement.', 'Ajouter le crumble émietté préalablement.', 'Peut se manger tiède ou froid.'], ['Ouvre-boîte', 'Économe', 'Planche à découper', 'Verre doseur', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'poire', 'très facile', 'bon marché', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Verrine poire banane chocolat', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:19:54.645669', [{'ingredient_id': '0daec8f7-2281-47de-b1e0-4a97af1447e7', 'quantite': '3'}, {'ingredient_id': '1d8ad0a6-d200-462b-9321-1918f4a2f18a', 'quantite': '4'}, {'ingredient_id': '1f67ac56-dbd2-4fd8-88b4-6fec54a66b16', 'quantite': '100 g'}, {'ingredient_id': '98abb5f0-99b5-4fd1-8ab8-211d8f0a52d3', 'quantite': '5 cl'}, {'ingredient_id': 'ab7d9399-a10e-4f62-bfa5-e0e0eb3d92ed', 'quantite': '2 cuillères'}, {'ingredient_id': '3a2facc6-ac4b-4a46-bdec-6dedf44c8991', 'quantite': '5 cl'}, {'ingredient_id': '3fd87a4c-28b7-43b5-8367-54ba624ecb9b', 'quantite': '100 g'}, {'ingredient_id': '6100337f-51c6-4725-babd-970a7a62e840', 'quantite': '50 g'}, {'ingredient_id': '44d6ba6c-03e6-4e7e-92bd-23f75787074a', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21498, 'Crumble pommes-bananes à la cannelle', 'pomme, banane, sucre en poudre, cannelle, beurre, citron, beurre, sucre roux, farine', '25 min', ['Eplucher, épépiner puis couper en quartiers les pommes. ', 'Les faire cuire dans une casserole avec un peu de beurre pendant 10 mn à feu moyen, à mi-cuisson, ajouter le sucre et la cannelle. ', 'Peler les bananes, les couper en tranches, ajouter le jus de citron puis les réserver. ', 'Beurrer un moule à gratin. ', 'Préparer la pâte à crumble en mélangant le beurre, la farine et le sucre. Vous devez obtenir un mélange "sableux". ', 'Verser les pommes et les bananes dans le moule (en alternant une couche de bananes et une couche de pommes) puis ajouter la pâte à crumble en une seule couche. ', 'Enfourner environ 25 mn à 210°C (thermostat 7 ).'], ['Couteau de chef', 'Ouvre-boîte', 'Râpe', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'crumble aux pommes', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'citron', 'beurre', 'Crumble pommes-bananes à la cannelle', 'cannelle', 'cocktail'], 'Dessert', d7606c9a-f132-402a-bf89-fb09b64f5ca2, '2025-09-26T15:20:01.238574', [{'ingredient_id': 'fdc3be25-8fd9-4087-9648-0de83edbec8b', 'quantite': '4'}, {'ingredient_id': '48d15d79-1f04-4b9b-bc90-5750808c7e29', 'quantite': '2'}, {'ingredient_id': 'a09b2a71-0295-4691-b834-d09230445a6e', 'quantite': '100 g'}, {'ingredient_id': '9d5fc391-e893-4e3a-8b61-52e809bc2942', 'quantite': '1 cuillères'}, {'ingredient_id': '484ff55e-8a7b-4e04-96aa-caae34081f96', 'quantite': ''}, {'ingredient_id': '4eecb04c-0c2e-4fdb-9b88-bab574a0d21a', 'quantite': ''}, {'ingredient_id': 'c791bdd6-f18e-4316-9aa1-908a3b83c9d8', 'quantite': '100 g'}, {'ingredient_id': 'd566027f-ce45-45e5-a35c-550e893ba23c', 'quantite': '150 g'}, {'ingredient_id': '40b09381-7a06-49f2-9ac3-b5ef5691368a', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (175563, 'Triangles amoureux feuilletés chocolat-banane', 'pâte feuilletée, chocolat noir, crème liquide, amandes effilées, banane', '25 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Couper la pâte feuilletée en 4 parts identiques (triangles).', 'Rouler un peu les bords de manière à obtenir des rebords assez épais.', 'Disposer les triangles sur une feuille de papier sulfurisé et poser quelques pâtes dans chaque triangle.', 'Faire cuire pendant 20 minutes environ. Surveiller la cuisson pour obtenir des triangles bien dorés.', 'Pendant leur cuisson, faire fondre au bain-marie le chocolat et la crème à feux doux. Mélanger.', 'Faire griller les amandes à sec dans une poêle pendant quelques secondes ( attention surveiller de ne pas les brûler )', 'Couper les bananes en rondelles.', 'Verser dans les triangles la crème au chocolat et disposer des rondelles de banane dessus.', 'Déposer les amandes grillées sur les bananes.', 'Laisser refroidir le tout au réfrigérateur au moins 45 minutes avant de servir.'], ['Verre doseur', 'Poêle', 'Passoire', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'Triangles amoureux feuilletés chocolat-banane', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'chocolat noir', 'pâte feuilletée', 'amandes effilées', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:20:05.770000', [{'ingredient_id': '56c4f054-c1bd-4291-b201-a4a0899f5f6d', 'quantite': '1'}, {'ingredient_id': '8b1206d7-ccfb-4f83-8a40-acfc3887db75', 'quantite': '200 g'}, {'ingredient_id': '884aeab6-5bdf-47a1-b884-41f8714793b0', 'quantite': '20 cl'}, {'ingredient_id': '6c9146e1-6f79-436f-bb5a-13562d4b7bb2', 'quantite': '30 g'}, {'ingredient_id': 'a9c1aa4c-53f3-4710-b91a-80465fd4f209', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20545, 'Pommes au four', 'pomme, sucre en poudre', '5 min', ['Préchauffer votre four à 180°C (thermostat 6).
Equeutez les pommes.', 'Placez les  dans un plat allant au four puis piquez-les avec une fourchette (environ 3 fois)', 'Saupoudrez de sucre.', 'Versez un verre d''eau au fond du plat.', 'Mettre au four pendant environ 1/2 heure.', 'Servir chaud !'], ['Mixeur', 'Batteur électrique', 'Planche à découper'], ['boisson', 'bon marché', 'recettes', 'entrée', 'Pommes au four', 'pomme au four', 'cuisine', 'recettes de cuisine', 'plat', 'dessert', 'sucre en poudre', 'confiserie', 'recette', 'testées', 'plat de résistance', 'cocktail', 'pomme', 'très facile'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:20:12.572507', [{'ingredient_id': '4e3ce09c-d1ac-4dc1-953d-518f638f275b', 'quantite': '4'}, {'ingredient_id': 'af61b7d0-3934-42ea-b77b-812cb0de635a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56255, 'Galette des rois bananes et pain d''épices', 'oeuf, amandes en poudre, sucre, beurre, banane, pain d''épices, arôme amande amère, pâte feuilletée, muscade', '20 min', ['Mélanger le beurre pommade avec les oeufs, la poudre d''amandes, le sucre, un peu d''extrait d''amande amère (selon le goût de chacun) et une pincée de sel.', 'Réserver cette frangipane au frais.', 'Poêler les bananes coupées en rondelles dans du beurre et un peu de muscade.', 'Les mélanger à la frangipane avec les tranches de pain d''épices coupées en dés.', 'Mettre la préparation bien fraîche sur une pâte feuilletée.', 'Recouvrir avec l''autre pâte feuilletée et bien les souder, badigeonner le tout d''eau sucrée pour faire dorer à la cuisson.', 'Enfourner dans un four très chaud 240°C (thermostat 8) pendant 5 minutes, puis terminer la cuisson à 180°C (thermostat 6) pendant 15 à 20 minutes.'], ['Batteur électrique', 'Balance de cuisine', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'pain d''épices', 'confiserie', 'galette frangipane', 'testées', 'muscade', 'facile', 'arôme amande amère', 'amandes en poudre', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'moyen', 'beurre', 'sucre', 'cocktail', 'Galette des rois bananes et pain d''épices'], 'Dessert', 3e3aa8f5-97f7-4776-a6f4-314b263625a1, '2025-09-26T15:20:16.141843', [{'ingredient_id': 'ed430823-d1cc-4daf-92b5-0f8125605de0', 'quantite': '2'}, {'ingredient_id': '46c6f6ba-ad13-42d5-8d2d-39eb49a2bb0d', 'quantite': '150 g'}, {'ingredient_id': 'aa84ca19-36d5-44aa-befa-b6491a3c07f2', 'quantite': '110 g'}, {'ingredient_id': '4c8248c0-7df4-40c8-9d24-3547de666ccf', 'quantite': '75 g'}, {'ingredient_id': '2f4fb21e-5314-43b4-a2b8-7fa83200b8e5', 'quantite': '2'}, {'ingredient_id': 'eb59f914-2163-4477-beeb-3a133034db43', 'quantite': '3'}, {'ingredient_id': 'fa77628c-ccb6-459d-ba24-385ccc179858', 'quantite': ''}, {'ingredient_id': 'e6528afd-42d2-4af9-94dc-736522566c4a', 'quantite': '2'}, {'ingredient_id': '5c16c499-6aae-4851-a0a7-f7d61ed93ec6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (59241, 'Banane chaude nutella coco express', 'banane, Nutella, noix de coco', '1 min', ['Eplucher la banane, la couper en 2 dans la longueur.', 'Disposer les 2 morceaux de banane à plat sur une assiette.', 'Tartiner le tout de nutella puis saupoudrer de noix de coco râpée.', 'Mettre au micro-onde pendant 1 minute à 750 w (à voir selon les micro-ondes, il ne faut pas que la banane soit en purée).'], ['Passoire', 'Moule à tarte', 'Mixeur', 'Verre doseur'], ['', 'Banane chaude nutella coco express', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Nutella', 'dessert', 'plat de résistance', 'noix de coco', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:20:19.677563', [{'ingredient_id': 'c7eeed84-4f75-48d7-8b0a-5124cb134824', 'quantite': '1'}, {'ingredient_id': '1764f5d8-b5fd-4017-9234-acc410f9d964', 'quantite': '4 cuillères'}, {'ingredient_id': 'b143793e-4dac-4382-b387-b3cc6e85879f', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (325575, 'Banoffee d''Anne-Sophie', 'spéculoos, beurre, banane, confiture de lait, crème fraîche liquide, mascarpone, sucre glace, chocolat en poudre, caramel', '30 min', ['Faire la confiture de lait : Mettre la boîte de lait concentré sucré dans une cocotte minute au bain marie (eau jusqu’au ¾ de la conserve fermée). A partir du moment où ça siffle compter 45 minutes. Laisser refroidir.', 'Écraser (ou mixer) les biscuits en poudre et les mélanger avec le beurre fondu. Tapisser le fond d’un moule à charnière.', 'Couper les bananes en rondelles, les disposer serrées  sur le biscuit (1 seule couche).', 'Badigeonner les bananes avec la confiture de lait.', 'Monter une chantilly au batteur avec la crème, et incorporer progressivement le sucre et le mascarpone jusqu’à ce que le mélange  soit bien ferme (ustensiles préalablement mis au congélateur pour bien faire monter la crème bien fraiche).', 'Étaler la crème dans le moule et bien la lisser.', 'Laisser 24 heures au réfrigérateur.', 'Avant de servir, pour la décoration, saupoudrer le dessus du gâteau de chocolat en poudre à l’aide d’une petite passoire à lait + zigzag de caramel liquide. ', 'Enlever la charnière du moule au dernier moment.'], ['Moule à tarte', 'Balance de cuisine', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'confiserie', 'testées', 'facile', 'caramel', 'bon marché', 'rapide', 'plat', 'recette', 'crème fraîche liquide', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'confiture de lait', 'Banoffee d''Anne-Sophie', 'dessert', 'plat de résistance', 'beurre', 'sucre glace', 'chocolat en poudre', 'cocktail'], 'Dessert', 000e895c-180c-409e-b604-5e37c03e3bc4, '2025-09-26T15:20:23.260618', [{'ingredient_id': '4fffb9db-4aa4-4413-adea-2397fc68db1f', 'quantite': '200 g'}, {'ingredient_id': 'f4e75d5f-4b0e-459b-9c21-1f91e52da950', 'quantite': '80 g'}, {'ingredient_id': 'f9e29f8b-292d-445b-9121-cb60e5f084a4', 'quantite': '4'}, {'ingredient_id': 'fa372398-8468-4794-98ac-7a0329878edf', 'quantite': '1'}, {'ingredient_id': '3f36c00e-4e72-4507-9ac1-57243684cf63', 'quantite': '40 cl'}, {'ingredient_id': '39d8363a-5aca-4a9c-9960-b6ea1673bad7', 'quantite': '200 g'}, {'ingredient_id': 'f6f0a650-35c7-44bd-b8fe-1f82f4cca46e', 'quantite': '5 cuillères'}, {'ingredient_id': '78327686-6e65-45dc-9965-ae84e57331fc', 'quantite': ''}, {'ingredient_id': '03f18496-11d4-4285-96b0-34c66bca3cfa', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (95050, 'Burger chocolat pommes bananes', 'pain pour hamburger, Nutella, pomme, banane, cannelle', '5 min', ['- Epluchez votre pomme puis couper la en fines lammelles que vous faites revenir à la poêle dans une cuillière à café d''eau à mi-cuisson soupoudrez de cannelle', '- Passez au four vos pain à burger, ils doivent etre dorés sur l''interieur et légérement croustillants sur le dessus.', '- Ajouter à vos pommes 1 banane couper dans le sens de la longueur puis chaque morceau en 2.', '- laissez la banane ramolir avec les pommes', '- Couvrez l''interieur des pains burger de Nutella ( 1 cuillière à café suffit sinon c''est vraiment lourd)', '- ajoutez les pommes puis les banane refermez le burger', '- Deguster encore tiède !!'], ['Louche', 'Casserole', 'Fouet', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Burger chocolat pommes bananes', 'Nutella', 'dessert', 'plat de résistance', 'pomme', 'cannelle', 'cocktail', 'pain pour hamburger'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:20:27.367360', [{'ingredient_id': 'dbe90437-000c-47b9-b25b-4a1ed982f15b', 'quantite': '2'}, {'ingredient_id': '25993e65-9a51-4fe2-9a03-597c2dbdbcc4', 'quantite': '4'}, {'ingredient_id': '83d17a41-ac76-4646-8285-8af88c15ac85', 'quantite': '1'}, {'ingredient_id': '0d88d77e-6854-4406-95f9-4499ccec1c0c', 'quantite': '1'}, {'ingredient_id': '5a6a9f98-1d8d-4065-a7ac-53140d730b5c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61335, 'Biscuit sablé façon tarte aux fruits', 'farine, beurre tendre, sucre en poudre, oeuf, sel, banane, nectarine, fruit de la passion, framboises, fraises, nappage, pomme', '30 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Mettre tous les ingrédients de la pâte dans un saladier et les travailler aux doigts pour obtenir une boule de pâte sablée.', 'Etaler finement et délicatement la pâte sur une plaque de cuisson recouverte de papier sulfurisé, lui donner une forme rectangulaire.', 'Mettre au four 15 minutes pour qu''elle soit dorée.', 'Préparer la compote de pommes : faire cuire des petits cubes de pommes à la poêle et les écraser à la fourchette. Sucrer si nécessaire.', 'Pendant la cuisson, découper les fruits : la banane en rondelles, les pêches en quartiers, et tous les fruits que vous trouverez (plus il y aura de variétés plus le dessert sera réussi).', 'Une fois la pâte cuite, étaler la compote de pomme sur la pâte, puis disposer les fruits sur la pâte en catégories (quelques rondelles de bananes regroupées dans un coin, puis quelques framboises, puis quelques morceaux de pêches,et ainsi de suite de façon à former des petits tas de mêmes fruits).', 'Percer le fruit de la passion et verser le jus sur les fruits.', 'Enfourner pour 15 minutes de cuisson.', 'Préparer le nappage de tarte et l''etaler au pinceau, laisser refroidir et bon dessert.'], ['Batteur électrique', 'Fouet'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'beurre tendre', 'facile', 'bon marché', 'sablés', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'Biscuit sablé façon tarte aux fruits', 'boisson', 'farine', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:20:30.939394', [{'ingredient_id': '07ab54ec-f19b-4ba7-b5ff-ccfd6919f08a', 'quantite': '185 g'}, {'ingredient_id': '394418e4-e1c0-42de-a07c-ef6159c73376', 'quantite': '95 g'}, {'ingredient_id': 'c356f32a-dabc-4364-bf06-a8b90de4c610', 'quantite': '95 g'}, {'ingredient_id': 'ead4e01a-84dc-4ed5-8ddf-080fd381875d', 'quantite': '1'}, {'ingredient_id': 'f717307b-a73b-49e5-81c5-00a70ece28d7', 'quantite': '1'}, {'ingredient_id': '033c0f69-a296-4be9-bd6b-651a94d874b4', 'quantite': '1'}, {'ingredient_id': '179b8e66-7203-4f1f-87a3-60d24afa4860', 'quantite': '2'}, {'ingredient_id': 'b87dc164-7418-47ea-b554-37de58a954fb', 'quantite': '1'}, {'ingredient_id': '3139cd0c-edbf-4180-bfb9-b8638dedabc3', 'quantite': '100 g'}, {'ingredient_id': '3a1070dd-d78c-44fa-8ba4-565bbc09b126', 'quantite': '100 g'}, {'ingredient_id': '95ef0e1d-b3e5-4e53-867f-f4023f4882a2', 'quantite': '1'}, {'ingredient_id': '7e514ecf-76f5-4f28-9cd5-79c0fa5c75a9', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (53620, 'Cake de bananes aux épices', 'fromage blanc, farine, sucre, cassonade, sucre vanillé, beurre, oeuf, levure, cannelle, gingembre, clou de girofle, couteau, banane', '10 min', ['A l''aide d’un fouet électrique ou d’un robot, mélanger le sucre blanc, la cassonade, le sucre vanillé et les 3 jaunes d’œufs jusqu’à obtenir une consistance crémeuse presque blanche. ', 'Réserver les blancs qu’il faudra monter en neige très ferme (ajouter une pincée de sel aux blancs avant de les fouetter).', 'Ajouter à la crème (jaunes + sucre), les épices en poudre, les fromages blancs, le demi sachet de levure et le beurre fondu;  mélanger bien le tout. ', 'Puis, ajouter les bananes coupées en rondelles pas trop épaisses.', 'A la fin, mêler les blancs d’œufs montés en neige ferme délicatement avec la spatule. ', 'Pendant la préparation, préchauffer le four à 200°C, puis enfourner pendant 40 min.', 'En fin de cuisson, piquer le gâteau à l’aide d’un couteau à lame pointue pour vérifier si la cuisson est bonne... Si la lame porte quelques traces de pâte, poursuivez quelques minutes la cuisson.'], ['Ouvre-boîte', 'Spatule', 'Casserole', 'Couteau de chef'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'clou de girofle', 'farine', 'couteau', 'fromage blanc', 'autres cakes', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'Cake de bananes aux épices', 'cannelle', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:20:35.118563', [{'ingredient_id': 'fd15755b-4a5d-4df1-9669-31be306aa177', 'quantite': '2'}, {'ingredient_id': '3bb62005-a60b-4d11-ac26-221f14a3d47e', 'quantite': '240 g'}, {'ingredient_id': 'e3fe1ace-b4c7-4747-9da4-c586db10c480', 'quantite': '100 g'}, {'ingredient_id': 'b9b8b6a3-9a3a-4402-a82a-7483a16086a0', 'quantite': '100 g'}, {'ingredient_id': '0ebd6463-df8a-4046-88db-257147431f14', 'quantite': '1'}, {'ingredient_id': '939ad5cc-ff7f-4819-9f97-422493a5ec4d', 'quantite': '60 g'}, {'ingredient_id': 'e49b826f-a947-4fb6-aa5c-98971b4c330d', 'quantite': '3'}, {'ingredient_id': '38aaa054-412b-4b5e-907f-5c60812feeff', 'quantite': ''}, {'ingredient_id': 'e16684de-b965-4823-81aa-a6be6b56f9a4', 'quantite': '1 cuillères'}, {'ingredient_id': '2caaf67c-06bc-4bb1-9f23-6b61cf6f586d', 'quantite': ''}, {'ingredient_id': '616b6ca7-f021-411c-a923-744efdba6b1c', 'quantite': '1'}, {'ingredient_id': '1ce929cf-2412-484f-8fcc-cc827ad7db76', 'quantite': '1'}, {'ingredient_id': 'b73f9213-17c2-4f15-be5d-377e2e295161', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34577, 'Toasts aux bananes', 'banane, gruyère râpé, pain de mie', '5 min', ['Couper les tranches de pain de mie en 2 (en forme de triangle). ', 'Couper les bananes en fines rondelles, les disposer sur les 1/2 tranches de pain de mie, ajouter du gruyère râpé. ', 'Faire cuire quelques minutes dans le four, sous le grill.'], ['Balance de cuisine', 'Planche à découper', 'Tire-bouchon', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'gruyère râpé', 'dessert', 'plat de résistance', 'Toasts aux bananes', 'cocktail', 'pain de mie'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:20:38.627928', [{'ingredient_id': 'd863cb19-d584-452c-88df-d21421708548', 'quantite': '3'}, {'ingredient_id': 'be8ec81e-b02f-4b46-92bd-86626da15968', 'quantite': '100 g'}, {'ingredient_id': 'd8351a6d-3681-4648-aa87-a4272b596d80', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (326868, 'Sorbet courgettes-pêches ou courgettes-bananes', 'courgette, pêche, citron, sucre', '30 min', ['Découper la courgette et cuire dans de l''eau bouillante non salée environ 15 min. Egoutter.', 'Peler les fruits et les découper en morceaux.', 'Mixer courgettes cuites avec les fruits choisis ou les écraser à la fourchette. Ajouter le sucre. Ajouter le citron au sorbet courgettes bananes (pour éviter que les bananes noircissent).', 'Après refroidissement, placer dans la sorbetière.', 'Ou sans sorbetière : ajouter de la crème 30% ou plus et placer dans un bac au congélateur.'], ['Poêle', 'Planche à découper', 'Casserole', 'Fouet'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'Sorbet courgettes-pêches ou courgettes-bananes', 'cuisine', 'recettes', 'boisson', 'sorbet', 'dessert', 'plat de résistance', 'citron', 'pêche', 'courgette', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:20:42.679124', [{'ingredient_id': '1b191bbd-cfe1-4b52-a03e-348bc12fc702', 'quantite': '250 g'}, {'ingredient_id': '6c8471c5-525e-4c9b-a925-4677fa3374bc', 'quantite': '2'}, {'ingredient_id': '56fa0f1f-2f19-4e61-8c44-afde606fed07', 'quantite': '1'}, {'ingredient_id': '3544c4b5-1cf9-4bb0-b9dd-7dc850c06bd2', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40138, 'Gâteau à la banane et à l''ananas', 'farine, sucre, ananas, banane, huile de tournesol, oeuf, sel, vanille, bicarbonate', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Mélanger dans une terrine la farine, le sucre, le sel et le bicarbonate.', 'Y ajouter le reste des ingrédients en mélangeant bien.', 'Verser dans un moule beurré de préférence un moule à cake.', 'Mettre au four pour 50 minutes environ. ', 'Le couteau doit ressortir propre.', 'Le gâteau se mange tiède ou froid.'], ['Tire-bouchon', 'Râpe', 'Louche', 'Casserole'], ['entrée', 'Gâteau à la banane et à l''ananas', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'gâteau à l''ananas', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'vanille', 'huile de tournesol', 'dessert', 'plat de résistance', 'ananas', 'sucre', 'cocktail', 'bicarbonate'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:20:46.230343', [{'ingredient_id': 'eee4b24d-b9e9-4d70-a406-29a5e65e308a', 'quantite': '3'}, {'ingredient_id': '61826eef-5b21-4183-ac2c-2d2bde8db468', 'quantite': '2'}, {'ingredient_id': '5ec4b1f4-8d42-4da0-a189-1ae011f09a7f', 'quantite': '1'}, {'ingredient_id': '36ec55c4-5a93-4e43-9589-6d72ea966aa5', 'quantite': '3'}, {'ingredient_id': 'ec8fcb92-8b4d-47b9-bc57-ed30f620af08', 'quantite': '1.5'}, {'ingredient_id': '782c1a6c-90b4-440f-9215-ff5199ea5eec', 'quantite': '4'}, {'ingredient_id': '6a2a7d7c-da02-4daa-a70f-07a5fb39bd16', 'quantite': '1 cuillères'}, {'ingredient_id': 'ef79343b-8e1a-45b1-a129-36705a207174', 'quantite': '1 cuillères'}, {'ingredient_id': '1b933e07-0fe4-4261-ba8f-d00be69f00b9', 'quantite': '1.5 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (217387, 'Beignets de bananes et de pommes', 'levure de boulanger, lait, farine, sel, oeuf, blanc d''oeuf, sucre, banane, pomme, huile de friture', '15 min', ['Dans un saladier de taille moyenne, diluer la levure avec le lait.', 'Dans un grand saladier, mélanger la farine, le sucre et l''œuf. Ajouter ensuite la préparation lait-levure, brasser jusqu''à ce qu''elle devienne lisse. Rajouter les blancs en neige délicatement. puis mettre l''huile.', 'Dans une casserole, faire chauffer l''huile pour la friture à feu moyen (hauteur de 2 à 3 cm).', 'Pendant que l''huile chauffe, couper les bananes en petits morceaux et les pommes en rondelles ou en morceaux selon-vous. Les mettre dans la pâte. A l''aide d''une cuillère, mélanger délicatement la pâte.', 'L''huile doit être chaude, mettre à l''aide d''une fourchette les morceaux de fruit dans l''eau, le dorer de chaque coté et les mettre dans une assiette couverte de sopalin. ', 'C''est prêt ! Vous pouvez le déguster chaud, froid, tiède comme vous voulez.'], ['Batteur électrique', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'huile de friture', 'facile', 'bon marché', 'Beignets de bananes et de pommes', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'beignets sucrés', 'farine', 'dessert', 'plat de résistance', 'pomme', 'lait', 'sucre', 'blanc d''oeuf', 'levure de boulanger', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:20:50.443141', [{'ingredient_id': '22bad977-73d8-49a6-936a-c4c380fa1535', 'quantite': '1'}, {'ingredient_id': '902e5a05-b9ac-441c-ad29-6eecaaf2c6cb', 'quantite': '15 ml'}, {'ingredient_id': '841406b1-ef30-4912-937a-d61141790d77', 'quantite': '100 g'}, {'ingredient_id': 'a4987b1a-614c-4b98-a177-48f245c9f1b8', 'quantite': '1'}, {'ingredient_id': '11870b15-9d4b-4079-b41f-27119e929bdc', 'quantite': '1'}, {'ingredient_id': 'e43487db-c649-4556-8586-c250cf8655cc', 'quantite': '2'}, {'ingredient_id': '7853d0aa-5801-4ed2-a3d5-13670cb7e75d', 'quantite': '75 g'}, {'ingredient_id': '66672cdd-b647-4606-8057-de572b22f1b2', 'quantite': '5'}, {'ingredient_id': '1e82d15e-5f01-4a70-a521-451e0a8defc1', 'quantite': '2'}, {'ingredient_id': '053120f2-2dab-4549-9d2b-d453b0702d09', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392226, 'Banana bread ultra fondant (recette américaine)', 'banane, jus de citron, farine, levure chimique, bicarbonate, sel, cannelle, sucre roux, beurre, oeuf, extrait de vanille, lait', '30 min', ['Préchauffer le four à 160°C.', 'Beurrer et fariner un moule à cake. Dans un bol médium, écraser les bananes jusqu''à une consistance crémeuse, incorporer le jus de citron, réserver.', 'Dans un autre bol, mélanger la farine, le bicarbonate de soude, la levure, la cannelle, le sel et réserver aussi.', 'Dans un grand bol, battre le beurre pommade, incorporer le sucre puis les œufs battus et l''extrait de vanille.', 'Rajouter à ce bol, les bananes et le buttermilk.', 'Verser le mélange sec dans le grand bol et incorporer très doucement la préparation à la spatule ou à la Maryse jusqu''à imbiber toute le mélange.', 'Verser la pâte dans le moule et enfourner pour 1h, vérifier la cuisson à l''aide d''un couteau et remettre 10 minutes si besoin.'], ['Presse-agrumes', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'extrait de vanille', 'cakes', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'Banana bread ultra fondant (recette américaine)', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'jus de citron', 'beurre', 'cannelle', 'lait', 'cocktail', 'sucre roux', 'bicarbonate'], 'Dessert', e140a29c-b279-4cee-9757-8bac4412dc22, '2025-09-26T15:20:54.097824', [{'ingredient_id': 'e8679145-7a01-4d24-b400-bb986e095050', 'quantite': '3'}, {'ingredient_id': 'eda2c122-ca74-40c5-a95c-744a08e1c01d', 'quantite': '1'}, {'ingredient_id': '087931bd-d141-4113-af08-c764ab00084f', 'quantite': '250 g'}, {'ingredient_id': '156de229-6cd3-4390-8ab4-7fc9c472a7f8', 'quantite': '1'}, {'ingredient_id': 'd0b6f266-05f7-465e-99e9-40be45d37848', 'quantite': '1 cuillères'}, {'ingredient_id': '6f35a541-a7ba-4478-bc11-cd3de28002b9', 'quantite': ''}, {'ingredient_id': '3682d42f-f9fd-457b-896c-e5af09687dc4', 'quantite': '2 cuillères'}, {'ingredient_id': '72f25daf-f944-402d-92d8-51ed42e2b993', 'quantite': '140 g'}, {'ingredient_id': '9d9a100d-ea4e-4f0e-bc0d-fb9687546744', 'quantite': '150 g'}, {'ingredient_id': '83c99bb1-85fd-4a67-b35c-02ad71a23985', 'quantite': '2'}, {'ingredient_id': 'bf7b582a-32eb-473f-8256-b9f4e1876208', 'quantite': '2 cuillères'}, {'ingredient_id': '6b71f8aa-bfd8-4621-98e3-226943d7b231', 'quantite': '250 ml'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24728, 'Gratin de fruits exotiques', 'mangue, banane, poire, jaune d''oeuf, sucre, cassonade, crème, beurre, rhum, lait de coco', '20 min', ['Pelez les fruits et coupez les en gros dés (mangues, poires) et en rondelles (banane). ', 'Beurrez largement 4 petits plats à gratins individuels, saupoudrez-les de 4 cuillères à soupe de sucre, déposez les fruits en les alternant. ', 'Dans un bol, mélangez le lait de coco, la cassonade, le rhum, les jaunes d’oeufs et la crème. ', 'Versez la préparation sur les fruits et faites gratiner au four (position grill) pendant 15 mn. Servez aussitôt.'], ['Casserole', 'Rouleau à pâtisserie', 'Fouet'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'cassonade', 'poire', 'très facile', 'bon marché', 'plat', 'mangue', 'jaune d''oeuf', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'Gratin de fruits exotiques', 'cocktail'], 'Dessert', 45e798d4-d4e4-433a-9b13-87a793f474e7, '2025-09-26T15:20:57.565482', [{'ingredient_id': '01d10215-d1c7-41fe-81fd-bac32e070b02', 'quantite': '1'}, {'ingredient_id': '8d1bd4bc-dbb3-483f-b5ae-98149a465a39', 'quantite': '1'}, {'ingredient_id': 'c183e593-08d4-4039-bfe6-af023dee545a', 'quantite': '2'}, {'ingredient_id': 'f923975c-794a-4d54-8140-ba0a34ba3002', 'quantite': '2'}, {'ingredient_id': 'dbce4675-9b2e-46c6-8a4d-39667c0bbbb6', 'quantite': '4 cuillères'}, {'ingredient_id': 'f8f10995-6e86-430e-9446-c06104713eaf', 'quantite': '80 g'}, {'ingredient_id': 'c1c087a3-9d76-41d6-b9b7-788c0b81bc08', 'quantite': '1 cuillères'}, {'ingredient_id': '4ec0ef45-c69b-42e0-9889-b0b33a9426c9', 'quantite': '20 g'}, {'ingredient_id': '979b4bdc-7ab3-4816-8a72-86f0613822e8', 'quantite': '2 cuillères'}, {'ingredient_id': 'd6680359-6ce7-4282-8431-cf3b2692332e', 'quantite': '30 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (305222, 'Dessert glacé à la banane et aux raisins', 'raisin, banane, oeuf, maïzena, yaourt nature, citron, cannelle, arôme vanille, quatre-épices', '15 min', ['Couper les raisins en quartier et les épépiner.', 'Les faire chauffer à feu vif pendant 2 min.', 'Les presser au presse purée pour en faire sortir un peu de jus. Mixer les raisins et le jus.', 'Passer la préparation au tamis au dessus d''une casserole pour extraire le maximum de jus.', 'Réduire le jus en sirop.', 'Ajouter le yaourt et fouetter. ', 'Écraser une banane en purée et l''ajouter a la casserole en fouettant.', 'Ajouter l''œuf et fouetter jusqu’à épaississement. Ajouter de l''arôme de vanille et des quatre épices.', 'Chemiser un ramequin de papier sulfurisé et y mettre la préparation. Couper en quartiers, peler et épépiner 2 raisins.', 'Les enfoncer dans le ramequin de préparation. Placer le ramequin de préparation au congélateur durant 1h30. ', 'Ecraser le reste de banane en purée. ', 'Ajouter du jus de citron et de la cannelle jusqu’à obtenir l''acidité souhaitée.'], ['Tire-bouchon', 'Verre doseur', 'Mixeur'], ['', 'raisin', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'facile', 'maïzena', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'Dessert glacé à la banane et aux raisins', 'plat de résistance', 'arôme vanille', 'citron', 'quatre-épices', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:21:01.783508', [{'ingredient_id': '0db0b424-bf94-4fd9-bc8f-10be25b99891', 'quantite': '160 g'}, {'ingredient_id': '02ce5fa0-f4b9-495e-b147-52b205511a53', 'quantite': '1'}, {'ingredient_id': 'e4e2d21c-6f12-44dd-bdbd-7d4e4d9156e9', 'quantite': '1'}, {'ingredient_id': '8da2e9e6-903f-4f2c-a333-a00514488020', 'quantite': '1 cuillères'}, {'ingredient_id': '894a39ba-9418-47de-991d-47650a725532', 'quantite': '1'}, {'ingredient_id': '614ad3f4-8e72-46a8-92c0-13218a010685', 'quantite': '1'}, {'ingredient_id': '69e43fe2-072f-4aca-bc4e-e9ca277f3cf4', 'quantite': '1'}, {'ingredient_id': '49d65daf-c134-4bbf-a6da-8d8c905f582f', 'quantite': '1 cuillères'}, {'ingredient_id': 'c61904fe-1c36-4349-b214-ad832a6b34e3', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (305597, 'Waterzooi du soleil', 'poulet, carotte, patate douce, lait de coco, oignon, ail, banane, jus de citron, coriandre, cube de bouillon, crème fraîche, poivre', '30 min', ['Dans une cocotte en fonte, faites revenir l''oignon haché et la gousse d''ail dans un peu d''huile d''olive.', 'Ajoutez le poulet, les bananes et les carottes découpées en rondelles, les patates douces épluchées et coupées en deux ou trois morceaux selon la taille, le cube de bouillon, la coriandre, le jus de citron et le lait de coco. Ajoutez un peu d''eau (25 cl).', 'Laissez mijoter entre 2 et 3 heures (au plus longtemps, au meilleur).', 'En fin de cuisson, sortez le poulet, découpez-le, ajoutez un peu de crème fraîche pour améliorer la sauce.', 'Servez !'], ['Batteur électrique', 'Balance de cuisine', 'Fouet', 'Spatule', 'Râpe'], ['', 'lait de coco', 'poulet', 'banane', 'entrée', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'carotte', 'patate douce', 'facile', 'bon marché', 'ail', 'plat', 'recette', 'cube de bouillon', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'coriandre', 'Waterzooi du soleil', 'poivre', 'cocktail'], 'Plat principal', d47d2993-fed5-49d7-99b6-e00426f5bc6c, '2025-09-26T15:21:05.896792', [{'ingredient_id': '39339c7c-337d-4494-b59e-ac084f899e5e', 'quantite': '1'}, {'ingredient_id': 'cced5e83-c0df-49d8-9fa4-4f264eaf5e8b', 'quantite': '4'}, {'ingredient_id': '8fb0e4bd-79ca-4609-a9a3-2b7b171aaa41', 'quantite': '3'}, {'ingredient_id': '794300f3-90ed-4d11-accc-8acf6a9dfb19', 'quantite': '25 cl'}, {'ingredient_id': 'dcf968f1-5d24-4298-bf88-5294c9bc0e7a', 'quantite': '1'}, {'ingredient_id': '1ce6030f-16e8-4f48-85d7-e7c6ef9c6811', 'quantite': '1'}, {'ingredient_id': 'd1b2a2f9-71cb-4a4f-b783-6d6ac4e80e8d', 'quantite': '2'}, {'ingredient_id': 'ec21e980-caa4-495b-80f4-cb3316b3b834', 'quantite': '1'}, {'ingredient_id': '97bd433c-21e0-41b4-ae58-631517a19247', 'quantite': '1'}, {'ingredient_id': '3f2d3e91-ace5-4873-8bfd-64cc2b948adb', 'quantite': '1'}, {'ingredient_id': 'd959ce24-a9ac-4b15-8c84-9da15a697ee7', 'quantite': '10 cl'}, {'ingredient_id': '4bfca8fb-7dfa-4d5b-b83f-b109f6fe2ab4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36268, 'confiture pommes bananes au rhum', 'banane, pomme, rhum, fleur d''oranger, eau, sucre', '10 min', ['Mettre tous les ingrédients dans un confiturier (ou un fait tout).', 'Laisser cuire à feu doux en remuant avec une cuillère en bois très régulierement pendant 1h30.', 'Passer légèrement au mixer.', 'Repartir dans 2 pots à confitures.', 'Fermer hermétiquement les pots.'], ['Couteau de chef', 'Économe', 'Casserole', 'Balance de cuisine', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'eau', 'testées', 'facile', 'bon marché', 'confiture pommes bananes au rhum', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'fleur d''oranger', 'sucre', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:21:10.347145', [{'ingredient_id': '8301b16a-93d9-4069-b0f2-b0d9377641c6', 'quantite': '2'}, {'ingredient_id': '285f8c37-8f7a-4ce8-bcd9-db03fab16f4c', 'quantite': '2'}, {'ingredient_id': '682d1161-4ac0-4b45-a709-00a9559e836a', 'quantite': '2 cuillères'}, {'ingredient_id': '5c987fa1-9e4e-46b0-b1e3-71ba5007b908', 'quantite': '2 cuillères'}, {'ingredient_id': '4c0f9ab9-f231-4280-8dfc-db521c84617f', 'quantite': '10 cl'}, {'ingredient_id': '2ccd6b27-e3c4-40ad-8366-4badee40831a', 'quantite': '350 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315052, 'Les bananes meringuées au citron et aux noix de Pauline', 'banane, citron, noix, sucre roux, blanc d''oeuf, beurre, sel', '20 min', ['Éplucher les bananes et les couper une fois en longueur et une fois en largeur.', 'Laver le citron à l''eau chaude, essuyer et râper le zeste. Presser le jus et arroser les bananes avec.', 'Préchauffer le four à 200°C (thermostat 6-7). Beurrer un moule avec une noix de beurre et disposer les bananes dedans. Répartir le reste du beurre en copeaux. Saupoudrer avec une cuillerée de sucre roux et la moitié des noix hachées.', 'Mixer le reste du sucre pour le réduire en poudre fine. Battre les blancs d’œufs en neige avec une pincée de sel et la moitié du sucre moulu.', 'Incorporer délicatement le reste du sucre avec un fouet. Ajouter les noix restantes. Répartir cette meringue sur les bananes.', 'Enfourner le plat à mi-hauteur et laisser cuire 20 minutes jusqu''à ce que la meringue soit dorée. ', 'Parsemer le plat avec le zeste de citron et servir.'], ['Pince de cuisine', 'Verre doseur', 'Ouvre-boîte', 'Planche à découper', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'Les bananes meringuées au citron et aux noix de Pauline', 'cuisine', 'noix', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'citron', 'blanc d''oeuf', 'cocktail', 'sucre roux'], 'Dessert', 177cf222-8294-4bca-862a-1b4c09ff8617, '2025-09-26T15:21:14.484833', [{'ingredient_id': '4498d81d-0ca0-4869-a45e-df0f27485faa', 'quantite': '5'}, {'ingredient_id': '0359e21d-770e-406f-97ef-c06d4490140d', 'quantite': '1'}, {'ingredient_id': '29095796-bc65-4e13-b81a-5493f00b78eb', 'quantite': '100 g'}, {'ingredient_id': '9963c008-1eaa-4dfa-abef-deb19da97823', 'quantite': '100 g'}, {'ingredient_id': '99227992-dc92-41d8-b873-919577fdcfc9', 'quantite': '4'}, {'ingredient_id': 'd5255680-8d11-4041-bcd6-63f77553195b', 'quantite': '40 g'}, {'ingredient_id': '703ccf6d-48a3-44ca-87e3-226c606200a0', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (49432, 'La glace à la banane de ma maman', 'banane, compote, raisins secs', '20 min', ['Eplucher les bananes et les couper en morceaux.', 'Mettre les bananes et la compote dans un mixeur, et mixer.', 'Disposer le mélange ainsi obtenu dans une sorbetière, et turbiner juqu''à ce que le mélange devienne de la glace.', 'Confectionner des boules de glace et les disposer dans des coupes, puis parsemer de raisins secs.'], ['Économe', 'Fouet', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'La glace à la banane de ma maman', 'bon marché', 'rapide', 'plat', 'recette', 'compote', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'raisins secs', 'glace à l''italienne', 'cocktail'], 'Dessert', b8209771-c5af-42f8-a98c-d39f322d8f46, '2025-09-26T15:21:18.650459', [{'ingredient_id': '19354eb9-c26f-445f-8cf4-735a34f75746', 'quantite': '400 g'}, {'ingredient_id': '4e635c5c-792a-4d85-99c2-93b70bf40994', 'quantite': '200 g'}, {'ingredient_id': 'a9acdf64-4acd-4fcb-8e77-4fad9f897eb3', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14363, 'Bananes au ketchup', 'banane, bacon, beurre, ketchup', '20 min', ['Badigeonner les bananes épluchées de ketchup.', 'Enrouler chaque banane dans des tranches de bacon maintenues par des pics en bois.', 'Faire dorer dans du beurre à feu vif. Arroser de beurre pendant la cuisson.', 'Selon les goûts, rajouter du ketchup.'], ['Économe', 'Rouleau à pâtisserie', 'Batteur électrique', 'Ouvre-boîte', 'Louche'], ['', 'Bananes au ketchup', 'ketchup', 'bacon', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'cocktail'], 'Amuse-gueule', e2603029-8d12-469a-a1a1-ce0659686005, '2025-09-26T15:21:22.694635', [{'ingredient_id': 'aefbafa7-05a9-4ac7-9b81-f321635dfa69', 'quantite': '4'}, {'ingredient_id': '5e3cfc59-86f9-4ad6-86ab-ae30bd466299', 'quantite': '16'}, {'ingredient_id': '0c4cde98-c48a-4f38-bdc1-5a0ee75845fa', 'quantite': ''}, {'ingredient_id': '6e1f6c86-17ba-49d1-90cd-47d26510ad58', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (47193, 'Gâteau de crêpes choco bananes', 'oeuf, farine, huile, sel, sucre, lait, beurre, banane, Nutella', '60 min', ['Préparer et faire cuire les crêpes. Les réserver au réfrigérateur le temps qu''elles soient froides.', 'Dans un moule à gâteau, légerement plus petit que les crêpes, mettre une 1ère crêpe à plat. ', 'Puis, étaler du nutella partout, et ranger les rondelles de bananes afin qu''elles remplissent entièrement la crêpe.', 'Remettre une crêpe par dessus et executer la même chose. ', 'Faire de même jusqu''à ce que le moule soit plein, et terminer par une crêpe nature pour servir facilement.', 'Remettre au réfrigérateur avec le moule, et démouler au moment de servir.'], ['Tire-bouchon', 'Casserole'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'Gâteau de crêpes choco bananes', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'crêpes sucrées', 'beurre', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:21:26.279605', [{'ingredient_id': '766f7725-9d03-4c8a-9357-659399f89595', 'quantite': '3'}, {'ingredient_id': '312f45d0-0d78-43ca-90c4-ac566908cba1', 'quantite': '250 g'}, {'ingredient_id': '00a97925-206a-405b-9d98-2e4c48c4e2f7', 'quantite': '2 cuillères'}, {'ingredient_id': 'b2aa3a65-8483-4dee-85a1-b37d29cef2a1', 'quantite': '1'}, {'ingredient_id': 'ead23b6d-876b-481a-ad3d-c4f03b62c57e', 'quantite': '2 cuillères'}, {'ingredient_id': 'd83f3915-8214-44be-8e18-d419d95c6235', 'quantite': '50 cl'}, {'ingredient_id': 'ecfecdf1-44b6-4733-b4ed-521857f97d6a', 'quantite': ''}, {'ingredient_id': '55dc9743-1ab2-4d83-af0f-c804d1ebb2c6', 'quantite': '6'}, {'ingredient_id': 'f55913ba-f3c2-44ce-ba2a-06faa0364d3d', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43358, 'Riz chouchounette', 'riz, lait, eau, cube de bouillon, cardamome, banane, pomme, ananas, noix de coco rapée, beurre', '10 min', ['Faire fondre 20 g de beurre dans une casserole. Y verser le riz et le faire revenir jusqu''à ce qu''il soit transparent.', 'Ajouter le lait, le bouillon et la cardamone. Faire cuire à feu vif. Laisser le riz absorber le liquide jusqu''à ce qu''il ne reste que 3 cm de liquide au fond de la casserole.', 'Réduire le feu et recouvrir la casserole d''un torchon propre plié en 4 et d''un couvercle par-dessus. Laisser cuire doucement pendant 15 mn, sans toucher au riz.', 'Pendant ce temps, éplucher les bananes et les pommes. Les couper en rondelles. Les faire dorer à la poêle avec le reste du beurre. Ajouter la moitié de la boîte d''ananas et laisser cuire sur feu doux pendant 5 min.', 'Verser le riz dans la poêle, mélanger et saupoudrer de noix de coco râpée. Servir immédiatement.'], ['Spatule', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'facile', 'bon marché', 'cardamome', 'plat', 'recette', 'cube de bouillon', 'cuisine', 'recettes', 'boisson', 'Riz chouchounette', 'noix de coco rapée', 'dessert', 'plat de résistance', 'riz', 'pomme', 'beurre', 'ananas', 'lait', 'cocktail'], 'Accompagnement', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:21:29.896119', [{'ingredient_id': '41ace291-3216-4227-a95d-6c2ba5d521da', 'quantite': '2'}, {'ingredient_id': 'ed0b55c4-8aa0-4cf0-adbf-c9946ce15eff', 'quantite': '2'}, {'ingredient_id': '19fc53cf-6a97-4638-b06e-cd69922cb5b9', 'quantite': '2'}, {'ingredient_id': '13e31e24-9d5b-4b59-8e09-e4d73dce3a6a', 'quantite': ''}, {'ingredient_id': '776efcae-e424-4589-a672-1aef7b7d057f', 'quantite': '1'}, {'ingredient_id': '81b4d3a2-126e-4d12-8c04-f4d7f0529951', 'quantite': '2'}, {'ingredient_id': 'f747cdb3-2a3c-45e6-9658-05885f3251fd', 'quantite': '2'}, {'ingredient_id': '6cc1411a-604f-4452-9ab6-f824f9895ed6', 'quantite': ''}, {'ingredient_id': '0a27d99d-3b9f-4cfe-98dd-cd689a0fe698', 'quantite': '6 cuillères'}, {'ingredient_id': '2f14adac-2331-4196-95b6-5ed05cc4532b', 'quantite': '40 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14035, 'Nems de banane au chocolat', 'brick, beurre, citron vert, muscade, banane, chocolat noir, beurre, sucre, oeuf, banane, miel, lait, sucre, crème, jaune d''oeuf, vanille, cannelle', '30 min', ['Pour la sauce : faire bouillir lait et crème avec la vanille fendue en deux et la cannelle. Fouettez les jaunes d''oeufs et le sucre jusqu''à ce que le mélange blanchisse. Ajouter le mélange crème-lait, laissez cuire sur feu doux jusqu''à épaississement, réserver au réfrigérateur.', 'Pour la garniture : pelez 3 bananes, coupez-les en rondelles épaisses et arrosez-les de jus de citron. Faites caraméliser le miel dans une poêle et faites-y dorer les rondelles de banane. ', 'Egouttez, réservez au froid.', 'Faire fondre le chocolat, lissez-le à la spatule, fouettez oeufs entiers, jaune et sucre, jusqu''à ce que le mélange blanchisse.', 'Incorporez le beurre fondu, puis le chocolat, sans cesser de fouetter. Réserver au frais.', 'Pour les nems : four thermostat 7/210°C. Faites fondre le beurre, coupez les feuilles de brick en 2, tartinez-les de beurre fondu au pinceau. ', 'Parsemez de muscade puis posez 1 cuillère de préparation au chocolat au centre de chaque demi-feuille et garnissez de quelques rondelles de banane caramélisées.', 'Rabattez les deux côtés sur la garniture puis roulez le demi-nem.', 'Posez les nems sur une feuille de papier sulfurisé, badigeonnez-les de beurre au pinceau, glissez au four pendant 12 à 15 mn jusqu''à ce que les nems soient blonds,', 'Dégustez chaud, entouré de crème froide.'], ['Batteur électrique', 'Planche à découper', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'muscade', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'Nems de banane au chocolat', 'dessert', 'plat de résistance', 'beurre', 'citron vert', 'cocktail'], 'Dessert', ba85668c-00bf-478d-9bf1-d8127ac4c429, '2025-09-26T15:21:33.527904', [{'ingredient_id': 'a0672f53-7765-466b-b550-c9440c54805d', 'quantite': '12'}, {'ingredient_id': 'fe8b0b9d-fc97-403b-8c7b-c3d36508d9b4', 'quantite': '50 g'}, {'ingredient_id': 'b64debe5-8018-4010-a53b-3fec1069dbe5', 'quantite': '1'}, {'ingredient_id': '6d8db686-52b2-47df-bcc9-64fd1964c7d8', 'quantite': ''}, {'ingredient_id': 'b56a16e3-6325-420a-91c9-c3d6394905bc', 'quantite': '2'}, {'ingredient_id': '15116221-d80a-4e96-887f-1887321c5369', 'quantite': '300 g'}, {'ingredient_id': '3606e4d1-8ff7-4f14-99ec-693598b9ae1b', 'quantite': '200 g'}, {'ingredient_id': 'a20a4414-638b-473e-b51e-300383ddd402', 'quantite': '50 g'}, {'ingredient_id': 'ae951ea2-8284-489d-8cec-0ad32e8a4ba6', 'quantite': '2'}, {'ingredient_id': '695d03e5-08e5-41ff-9c32-ba082e239e80', 'quantite': '3'}, {'ingredient_id': 'd934f22f-62bc-4b11-8ded-2e68480cda1d', 'quantite': '2 cuillères'}, {'ingredient_id': '91af3982-0439-4259-86d5-c14283fa9893', 'quantite': '125 g'}, {'ingredient_id': '1928bb2a-d0b8-416b-8088-7827d5c71fed', 'quantite': '50 g'}, {'ingredient_id': '8198a8a0-0336-42ba-a05e-d8bcb11f28a6', 'quantite': '125 g'}, {'ingredient_id': 'd9124db9-dd76-4d0c-8778-9dd04673c7b5', 'quantite': '4'}, {'ingredient_id': '00bda270-93db-4dc9-beee-654dbd60791b', 'quantite': '1'}, {'ingredient_id': 'cef4c015-c58d-40fc-b886-a7e53d9fa71f', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (391531, 'Glace banane papaye (avec sorbetière)', 'papaye, banane, yaourt nature, miel, orange', '20 min', ['Peler et couper en morceaux les fruits.', 'Mixer et mélangez tous les ingrédients dans un mixeur pour obtenir une purée bien lisse.', 'Versez le tout dans la sorbetière. ', 'Une fois prêt mettez le tout dans un bol et laisser le reposer au congélateur pendant une à deux heures avant de servir.'], ['Tire-bouchon', 'Balance de cuisine', 'Passoire'], ['entrée', 'banane', 'papaye', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'plat', 'moyenne', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'glace', 'dessert', 'plat de résistance', 'moyen', 'orange', 'Glace banane papaye (avec sorbetière)', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:21:36.987979', [{'ingredient_id': '5e511941-7755-41f1-8026-d2b83ff194be', 'quantite': '1'}, {'ingredient_id': '2eced690-98dc-4de2-9cf8-ae28c1191aff', 'quantite': '2'}, {'ingredient_id': 'd5c3f841-e1ee-47d5-829b-7efe0d8d3478', 'quantite': '2'}, {'ingredient_id': '000396f6-9903-4013-8725-7caf68553b18', 'quantite': '3 cuillères'}, {'ingredient_id': 'decf2348-a690-4125-8e2f-1baf842441c8', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (347075, 'Gratin aubergine banane plantain pimenté', 'aubergine, banane plantain, tomate, ail, piment, huile d''olive, persil', '45 min', ['Préchauffer le four à 200°C (thermostat 6-7).', 'Eplucher les aubergines et les couper en tranches d''environ 1 cm d''épaisseur. ', 'Déposer les rondelles sur une plaque allant au four, recouverte de papier cuisson. Badigeonner les aubergines d''huile d''olive et les mettre au four pour 25 min en retournant à mi-cuisson.', '(On peut aussi faire frire les aubergines à la poêle : le gratin sera plus moelleux mais aussi plus riche).', 'Pour la sauce tomate pimentée.', 'Faire revenir la gousse d''ail coupée en deux (ou pressée si vous préférez la manger), avec les piments dans une cuillère à soupe d''huile d''olive.', 'Ajouter les tomates concassées et laisser mijoter une quinzaine de minutes. Rectifier l''assaisonnement, et ajouter 2 bonnes cuillères à soupe de persil haché.', 'Après 3 minutes, éteindre le feu, ôter la gousse d''ail et les piments, et réserver.', 'Couper les bananes plantain en rondelles d''environ 4/5 mm. Les pocher dans de l''eau bouillante salée jusqu''à qu''elles prennent une teinte jaune foncée (5 à 10 min).', 'Monter le gratin.', 'Alterner une couche de sauce tomate, une couche d''aubergines, puis de bananes, en terminant par la sauce tomate.', 'Enfourner pour une vingtaine de minutes.', 'On peut, selon les goûts, recouvrir le gratin de fromage (râpé, mozzarella ou parmesan) ou de chapelure pour obtenir une couche croustillante.'], ['Économe', 'Louche', 'Fouet', 'Spatule', 'Passoire'], ['aubergine', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'tomate', 'ail', 'plat', 'recette', 'piment', 'cuisine', 'recettes', 'boisson', 'huile d''olive', 'dessert', 'gratin de légumes', 'persil', 'plat de résistance', 'banane plantain', 'Gratin aubergine banane plantain pimenté', 'cocktail'], 'Accompagnement', 812eca00-4fcd-4a34-b7da-494ca9d54f29, '2025-09-26T15:21:40.483347', [{'ingredient_id': '97cdc44c-c0b4-4c63-8a60-b664427701d0', 'quantite': '4'}, {'ingredient_id': '45dbb247-df01-4156-81a6-6ac75b316660', 'quantite': '2'}, {'ingredient_id': '9e194a35-a8ce-4dc1-82c6-adcc054810f1', 'quantite': '700 g'}, {'ingredient_id': 'd7ff74f5-0e29-4648-a353-b7aa38503f57', 'quantite': '1'}, {'ingredient_id': 'd92817fe-6491-4778-b8ad-94acd141c7c0', 'quantite': '2'}, {'ingredient_id': '58ace369-efe1-47fb-bda5-fb2be0192d63', 'quantite': ''}, {'ingredient_id': '998393fa-ebba-4fcb-acef-3ab9e75eea85', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26033, 'Emincé de porc aux bananes vertes', 'porc, échalote, lardons, banane, beurre, poivre, sel, curry', '20 min', ['Hacher les échalotes. Peler et couper les bananes en 2', 'Faire fondre le beurre dans une casserole, y faire revenir la viande.', 'Ajoutez les échalotes et les lardons, versez 10 cl d''eau, couvrez et laissez cuire 20 min à feu doux. Ajoutez les bananes, laissez mijoter 10 minutes.', 'Salez, poivrez et saupoudrez de curry.', 'Pour servir, disposez les bananes dans un plat (sauf 4), posez les tranches de viande dessus et déposez 1/2 banane sur chaque.'], ['Spatule', 'Mixeur', 'Batteur électrique', 'Râpe', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'cocktail', 'facile', 'lardons', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'poivre', 'curry', 'Emincé de porc aux bananes vertes', 'échalote', 'porc'], 'Plat principal', f08fce9d-e064-45b0-8358-1a7394971b1d, '2025-09-26T15:21:44.006656', [{'ingredient_id': '3a678139-63e7-48a7-bdba-c5716eb230a8', 'quantite': '4'}, {'ingredient_id': '62e21b80-ccfb-49b2-aa18-1f2a72470067', 'quantite': '4'}, {'ingredient_id': 'e99028db-9b89-4ca0-91ba-acf3f7e65a12', 'quantite': '100 g'}, {'ingredient_id': '9e333459-e9f4-4400-b9d9-2d251be26cee', 'quantite': '8'}, {'ingredient_id': '137ccf3b-3f06-4b46-911e-6818f744f713', 'quantite': '1'}, {'ingredient_id': '9a979418-65a5-4a49-a6e2-1552399a5dea', 'quantite': ''}, {'ingredient_id': 'cb8ece84-984b-4956-b021-948d447e6460', 'quantite': ''}, {'ingredient_id': 'c9e3528a-9b77-45d7-ae96-4799ba2f4546', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65562, 'Tarte crumble Nutella banane et sa pâte sablée à la noisette', 'farine, sucre, poudre de noisette, beurre tendre, oeuf, sel, banane, Nutella, farine, cassonade, poudre de noisette, beurre tendre', '20 min', ['Préchauffer le four à 180 degrés, thermostat 6.', 'Pour la pâte : ', 'Mélanger la farine, le sucre, le sel et la poudre de noisettes.', 'Malaxer pour obtenir une consistance sableuse avec le beurre mou.', 'Ajouter l''oeuf battu pour lier la pâte.', 'Etaler dans un moule à tarte et faire cuire la pâte à blanc pendant 10 min.', 'Pour le crumble :', 'Mélanger la farine, le sucre et la poudre de noisette, puis malaxer avec le beurre pour obtenir une consistance sableuse (comme pour la pâte).', 'Etaler la moitié du Nutella sur la pâte précuite.', 'Disposer des rondelles de banane sur la tarte et recouvrir avec le reste de Nutella.', 'Recouvrir la tarte avec la pâte à crumble et enfourner pour 30 min.'], ['Ouvre-boîte', 'Planche à découper', 'Casserole', 'Passoire'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'beurre tendre', 'très facile', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'poudre de noisette', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'Tarte crumble Nutella banane et sa pâte sablée à la noisette', 'sucre', 'cocktail'], 'Dessert', c1150c47-e860-4d00-9020-e9a56becb6c9, '2025-09-26T15:21:47.455982', [{'ingredient_id': '8d3c8e4d-2cdd-45ee-87d7-e03757390914', 'quantite': '250 g'}, {'ingredient_id': 'f0b16f85-47a0-4914-80f2-4088a5413ae3', 'quantite': '100 g'}, {'ingredient_id': 'e563a811-9ace-4b83-b1cb-ca3ea2f59144', 'quantite': '50 g'}, {'ingredient_id': '1299e6fe-dcfb-4a40-b289-3cdd723bb86f', 'quantite': '125 g'}, {'ingredient_id': '4c486763-a247-434c-8442-2a2fed086249', 'quantite': '1'}, {'ingredient_id': '578a18b6-1e92-4bb4-8018-90e33acd0829', 'quantite': '1'}, {'ingredient_id': 'bc64850d-09f1-402b-b946-f5545e6f7e97', 'quantite': '3'}, {'ingredient_id': '3cba29cc-6582-480d-a83c-b8d431453760', 'quantite': '250 g'}, {'ingredient_id': '09f1c94d-e3af-4b33-989d-d5eb3795df11', 'quantite': '80 g'}, {'ingredient_id': '3a2c536f-1972-4ac0-b527-c2c8d2007329', 'quantite': '80 g'}, {'ingredient_id': '31b0c7ab-f74d-4e88-b5df-1491138d7dbc', 'quantite': '40 g'}, {'ingredient_id': 'af523231-ff8b-4cee-b32f-afe49c5c1f2b', 'quantite': '60 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (92642, 'Crumble pommes, bananes et chocolat', 'pomme, banane, chocolat, sucre, farine, beurre', '15 min', ['Pelez les pommes et coupez les en petits morceaux; coupez les bananes en rondelles.', 'Installez les pommes au fond d''un plat, puis les bananes par dessus.', 'Hachez le chocolat au mixer, et versez le sur les fruits.', 'Préparez la pate à crumble : mélangez le beurre préalablement coupé en morceaux avec le sucre et la farine, de telle sorte que la préparation s''éffrite.', 'Disposez cette pate sur les fruits et le chocolat.', 'Faites cuire 30 minutes à 180° (il faut que la pate à crumble soit croustillante).', 'Régalez vous quand c''est encore chaud !'], ['Moule à tarte', 'Fouet', 'Planche à découper', 'Passoire', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'bananes et chocolat', 'crumble aux pommes', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'sucre', 'Crumble pommes', 'cocktail'], 'Dessert', f8ee3f76-efe3-4ecd-b1c8-0189a049e60f, '2025-09-26T15:21:53.048266', [{'ingredient_id': '3ff92f1e-5327-485b-a579-ee3812e09937', 'quantite': '3'}, {'ingredient_id': 'fd00e738-2a57-41f1-a74a-11ab7c20b858', 'quantite': '2'}, {'ingredient_id': '397e4fd4-2ac4-4526-a1f3-b14b59a94c64', 'quantite': '100 g'}, {'ingredient_id': '09f6cb8a-b5e0-4e87-86a9-4965aa06aaf3', 'quantite': '90 g'}, {'ingredient_id': 'd22a38f6-5888-4ec0-ab06-cf2c4bbf814f', 'quantite': '90 g'}, {'ingredient_id': '9e864ce4-d972-424a-b602-f03d5854eb6f', 'quantite': '90 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62494, 'Crumble express aux fruits d''automne', 'shortbread, banane, figue, mirabelle, reine-claude, miel, cannelle', '15 min', ['Laver, éplucher les fruits (sauf les prunes) et les couper en morceaux. Les disposer en vrac dans un plat allant au four.', 'Dans une jatte, émietter les biscuits, ajouter une bonne cuillerée à soupe de cannelle en poudre (selon vos goûts), et lier avec une à deux cuillerées de miel liquide : malaxer la pâte avec les doigts pour lui redonner une consistance moins sèche et plus proche de la pâte à crumble traditionnelle.', 'Saupoudrer cette pâte sur les fruits, enfourner 20 à 30 min à 200°C (thermostat 6-7).'], ['Batteur électrique', 'Mixeur', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'figue', 'plat', 'recette', 'Crumble express aux fruits d''automne', 'mirabelle', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'autres crumbles', 'cannelle', 'cocktail', 'shortbread', 'reine-claude'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:21:57.162815', [{'ingredient_id': 'd6fc7523-1b34-4190-86ab-6d54f6291b6f', 'quantite': '1'}, {'ingredient_id': '2376f113-df67-49f2-8ddc-e04e74f44eb8', 'quantite': '1'}, {'ingredient_id': '48e9a83d-a389-4fe7-81ea-04ced072d610', 'quantite': '6'}, {'ingredient_id': '4f2a4992-c698-4fa8-8056-b4fe0638502a', 'quantite': '10'}, {'ingredient_id': '53d9357e-4de5-47bb-bd7f-a056d3198ad7', 'quantite': ''}, {'ingredient_id': '057d811c-ec90-4959-8cb7-420c84d38f6e', 'quantite': ''}, {'ingredient_id': 'd153c2fb-a4d2-4f99-9207-67bed9076415', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166731, 'Kondré (Cameroun)', 'huile de palme, banane plantain, boeuf, céleri, poireau, piment, persil, oignon, ail, poivre, poivre blanc, cube Maggi, arôme, poivre, sel, bouquet garni', '10 min', ['- Emincer les condiments (poireau, céleri, persil, piment et oignon) ou les hacher, au choix.', '- Eplucher les bananes et couper chacune d’elle en 3.', '- Dans une cocotte, mettre l’huile à chauffer et faire revenir l’oignon émincé.', '- Laver la viande à l''eau vinaigrée et la couper en morceaux.', '- Avant coloration de l’oignon, ajouter la viande, saler légèrement et la faire revenir pendant environ 5 min afin qu’elle soit dorée.', '- Au bout des 5 min, réserver la viande sur une assiette.', '- Mettre les bananes à la place de la viande. Saler légèrement et ajouter 2 cubes émiétés. Bien remuer. Mettre de l’eau à hauteur, couvrir et laisser cuire pendant 15 min.', '- Pendant ce temps, écraser les poivres au mortier et presser les gousses d’ail.', '- Au bout de 15 min, ajouter dans la cocotte la viande, l’ail, les poivres, les condiments, les 2 cubes restants et un bouquet garni. Mettre de l’eau à hauteur (ça va donner la sauce, faut pas avoir peur d’en mettre), couvrir et laisser mijoter à feu doux pendant 45 min. Penser à goûter en cours de cuisson pour savoir si c’est assez saler et/ou poivrer.', '- Au bout de 45 min, couper le feu et laisser reposer 10 min à couvert avant de servir.', '- Chacun pourra ajouter quelques gouttes d’Arôme Maggi sur son assiette.'], ['Louche', 'Fouet'], ['entrée', 'recettes de cuisine', 'Kondré (Cameroun)', 'boeuf', 'sel', 'confiserie', 'testées', 'cube Maggi', 'facile', 'bouquet garni', 'plats africains', 'ail', 'plat', 'recette', 'arôme', 'piment', 'cuisine', 'recettes', 'oignon', 'boisson', 'poireau', 'dessert', 'persil', 'plat de résistance', 'banane plantain', 'moyen', 'poivre blanc', 'poivre', 'huile de palme', 'cocktail', 'céleri'], 'Plat principal', a204acb7-358e-480f-9dd5-d042cc39590f, '2025-09-26T15:22:00.785279', [{'ingredient_id': '5f02efb2-1488-4082-a7b2-28f91e02fd9d', 'quantite': '4 cuillères'}, {'ingredient_id': '56060238-911d-42ad-8b9a-b21cc70bbf87', 'quantite': '10'}, {'ingredient_id': 'e1cb0f65-a2e5-4e20-9ff2-88a41db91ae1', 'quantite': '800 g'}, {'ingredient_id': '9b963366-b7f2-4d51-b982-220ff84016fe', 'quantite': '1'}, {'ingredient_id': '641d5bed-d739-4ff4-bc3e-7f5fc354757e', 'quantite': '1'}, {'ingredient_id': 'a8aea24e-6a76-4e2c-ab3b-0741d8f32f7b', 'quantite': '1'}, {'ingredient_id': '1c8317b4-712a-4075-adc7-753fc842c135', 'quantite': '1'}, {'ingredient_id': '870680d6-18ca-44b4-b70d-6b8a6b3ddb81', 'quantite': '1'}, {'ingredient_id': '25460d3f-f607-45d3-84de-69d1436c754b', 'quantite': '4'}, {'ingredient_id': 'e576ffd7-b6bd-4d7e-ba5b-ec4b91d55b31', 'quantite': '1 cuillères'}, {'ingredient_id': '881f2081-fd11-4d4b-b7f3-1ae610bbce9b', 'quantite': '1 cuillères'}, {'ingredient_id': 'f7f76e3e-271b-41a3-8499-41cc8e31997c', 'quantite': '4'}, {'ingredient_id': '3d7fd78d-ed6c-4eb0-8c6c-ebdebe1610f4', 'quantite': ''}, {'ingredient_id': '0f643b93-0ee1-4d6b-aa9c-0172e3144afd', 'quantite': ''}, {'ingredient_id': 'e9f3e5ce-0b43-4701-b65c-d816e5753b9b', 'quantite': ''}, {'ingredient_id': 'fab8c753-4925-4828-a5c0-ef578988f521', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (325554, 'Bananes fondantes', 'banane, raisins de Corinthe, beurre, sucre, raisins secs', '10 min', ['Faites gonflez les raisins dans de l''eau tiède au moins une demi-heure à l''avance.', 'Epluchez les bananes, coupez-les en 2 dans le sens de la longueur, puis en 2 ou 3 morceaux.', 'Dans une grande poêle, faites fondre doucement le beurre. Dès qu''il est fondu, placez les bananes dans la poêle et augmentez le feu quelques minutes pour quelles dorent bien.', 'Ajoutez les raisins et laissez cuire à feu plus doux en tournant les bananes de temps en temps. Sucrez pour les plus gourmands.'], ['Planche à découper', 'Louche', 'Balance de cuisine', 'Batteur électrique', 'Spatule'], ['Bananes fondantes', '', 'entrée', 'banane', 'raisins de Corinthe', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'raisins secs', 'sucre', 'cocktail'], 'Dessert', e8824326-9709-48bd-b113-bfcdc6051a63, '2025-09-26T15:22:04.966143', [{'ingredient_id': '9616261a-60d4-4525-a544-3383032201b6', 'quantite': '8'}, {'ingredient_id': 'd03cea1a-12a5-4960-b6c4-781288080720', 'quantite': '100 g'}, {'ingredient_id': '5d9577f6-738d-4d76-b704-21e812224815', 'quantite': '60 g'}, {'ingredient_id': 'fd8ef141-4635-4f60-9f44-93bd19575339', 'quantite': ''}, {'ingredient_id': '1f41d0e4-2d76-4d8f-9b5e-cfe5c75ee4f5', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315623, 'Cake caramel-banane', 'oeuf, farine, levure, lait, caramel, banane', '5 min', ['Casser et battre les oeufs. ', 'Ajouter la farine et levure tamisée.', 'Détendre la pâte avec le lait.', 'Ajouter le caramel et bien mélanger.', 'Couper en 2 dans la longueur les bananes puis faire des petits morceaux, incorporer à la pâte et mélanger délicatement à la spatule.'], ['Batteur électrique', 'Pince de cuisine', 'Balance de cuisine', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'caramel', 'bon marché', 'oeuf', 'plat', 'recette', 'levure', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'lait', 'cocktail', 'Cake caramel-banane'], 'Dessert', ec432678-3b3b-46d1-8af1-f4d00119bb0c, '2025-09-26T15:22:08.517501', [{'ingredient_id': 'b4127c24-77f4-469c-9c1c-db2ddf6c5c2d', 'quantite': '3'}, {'ingredient_id': '33e25891-4316-49b0-a29f-99e84bb58196', 'quantite': '150 g'}, {'ingredient_id': '4cdd258b-d494-4d6e-bc49-4faa18b86754', 'quantite': '1'}, {'ingredient_id': '04c21226-1936-43e6-81af-8a946d04b403', 'quantite': '10 cl'}, {'ingredient_id': 'cce8537f-9667-4561-ac6b-3fcfa1b9065b', 'quantite': '3 cuillères'}, {'ingredient_id': '28244f9e-dc37-4e18-bbdc-7176491d1acd', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73862, 'Milk-shake Banane', 'banane, crème de riz, lait, sirop, lait concentré sucré, jus de citron, cassonade', '5 min', ['Couper les bananes en grosses rondelles, et les asperger de citron.', 'Mixer ensemble tous les ingrédients et ajouter la cassonade à la fin, en ajustant à votre goût.', 'Bon appétit!'], ['Râpe', 'Mixeur'], ['', 'crème de riz', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'lait concentré sucré', 'boisson', 'Milk-shake Banane', 'dessert', 'plat de résistance', 'jus de citron', 'sirop', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:22:12.768376', [{'ingredient_id': '332e90d0-55b2-45c1-9f4f-745ce6df89f5', 'quantite': '2'}, {'ingredient_id': '0e158e17-2f9b-4ef6-9a06-557ed444a0aa', 'quantite': '12.5 cl'}, {'ingredient_id': 'a00fbdef-3f92-49d0-80f8-89f62f5b0dde', 'quantite': '12.5 cl'}, {'ingredient_id': 'b0ea2062-48bf-4dcd-a37b-404cdc361650', 'quantite': '2 cl'}, {'ingredient_id': '59380478-708c-4dca-ab8c-b919177c358f', 'quantite': '2 cuillères'}, {'ingredient_id': 'e50e1a5c-0481-4831-9a4b-1c9a6271c864', 'quantite': '1'}, {'ingredient_id': '44a35ce1-5f8a-4192-b8d4-ae1f6a5d6092', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (313758, 'tiramisu bananes-pisang', 'sucre fin, mascarpone, oeuf, banane, sel, citron, Liqueur, boudoir', '10 min', ['Mélanger les jaunes d’œufs et le sucre pour obtenir une pâte blanche et bien lisse.', 'Y ajouter le mascarpone et bien mélanger.', 'Battre fermement les blancs d’œufs en neige avec une pincée de sel. ', 'Incorporer les blancs à la préparation avec une spatule pour ne pas casser les blancs.', 'Tremper les boudoirs dans la liqueur de banane et les placer dans le fond de la verrine. ', 'Ajouter des rondelles de banane sur les biscuits. Mettre la préparation sur ces biscuits et bananes.', 'Après 2 heures au frigo, la pâte est plus ferme et une rondelle de banane peut décorer la verrine (la plonger dans le jus de citron pour ne pas qu''elle noircisse...).', 'BON APPÉTIT !'], ['Balance de cuisine', 'Rouleau à pâtisserie', 'Casserole', 'Poêle', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'sel', 'confiserie', 'testées', 'sucre fin', 'facile', 'rapide', 'oeuf', 'plat', 'tiramisu bananes-pisang', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'tiramisu', 'moyen', 'citron', 'boudoir', 'Liqueur', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:22:16.938570', [{'ingredient_id': '37417d27-fc13-457d-9ec5-0a8baac2f737', 'quantite': '120 g'}, {'ingredient_id': 'd1cca537-e66b-45be-9b68-4493ace1991a', 'quantite': '500 g'}, {'ingredient_id': '87f1384e-a2b1-4258-be17-63c647968ed5', 'quantite': '3'}, {'ingredient_id': '6dda1aba-99b3-439c-8d76-bfd429aef1b8', 'quantite': '1'}, {'ingredient_id': '5b0acb83-cf62-4d42-9b48-27217d7c1ada', 'quantite': '1'}, {'ingredient_id': '82ca7401-3392-4470-8218-85bb70b3be3f', 'quantite': '1'}, {'ingredient_id': '6a25dde3-e548-4f26-a9c4-800849747c0f', 'quantite': '1'}, {'ingredient_id': 'ecf8a2e4-2a96-4ea7-8fc0-0d4d18325225', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37089, 'Banane congolaise à la poêle', 'banane, gruyère râpé, jambon, moutarde, beurre', '15 min', ['Coupez la banane en 2 dans le sens de la longueur.', 'Badigeonnez les 2 morceaux de banane de moutarde (n''hésitez pas à en mettre car le goût de la moutarde se sent guère après la cuisson).', 'Enroulez les tranches de jambon autour des bananes.', '(Facultatif):Ficelez le tout pour que les tranches se maintiennent avec le contenu.', 'Laissez revenir dans une poêle beurrée le tout pendant 10 min couvercle fermé.', 'Pour la dernière minute de cuisson recouvrez-les de gruyère rapé.'], ['Spatule', 'Fouet', 'Couteau de chef', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'jambon', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Banane congolaise à la poêle', 'gruyère râpé', 'dessert', 'plat de résistance', 'moutarde', 'beurre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:22:20.413281', [{'ingredient_id': '83565c59-af2e-41b8-9bca-33465c892c5a', 'quantite': '1'}, {'ingredient_id': 'bf7471b7-6852-46a4-9dd4-240020f85529', 'quantite': '1'}, {'ingredient_id': '033b3a00-427d-49cc-b9d3-9681249c1ecc', 'quantite': '2'}, {'ingredient_id': '272a042d-b1ae-4932-a4cd-59847230bb7b', 'quantite': ''}, {'ingredient_id': '8e3fbe33-223c-4916-9361-291ba18ec945', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36253, 'clafoutis banane coco', 'banane, noix de coco rapée, oeuf, farine, beurre, crème fraîche épaisse, sucre en poudre, levure, rhum', '15 min', ['Faites fondre 75 g de beurre, réservez. Préchauffez le four à 180°C (thermostat 6).', 'Fouettez 2 oeufs avec 100 g de sucre. Incorporez la crème, la farine puis la levure et le rhum. Versez cette pâte dans 4 petits plats beurrés avec le reste du beurre. Coupez les bananes pelées en rondelles obliques. Répartissez-les sur la pâte.', 'Fouettez les deux oeufs restants avec la noix de coco, le reste de sucre et le beurre fondu. Versez ce mélange sur les bananes.', 'Cuisez 20 min dans le four. Servez tiède.'], ['Verre doseur', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche épaisse', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'noix de coco rapée', 'dessert', 'plat de résistance', 'clafoutis banane coco', 'clafoutis', 'beurre', 'cocktail'], 'Dessert', c8da0aaa-6fbd-4125-bac4-455dfeb1356a, '2025-09-26T15:22:25.207548', [{'ingredient_id': '930ea246-9b69-4482-8ec1-29c0a6ce3efd', 'quantite': '2'}, {'ingredient_id': 'bd299c02-5475-4dfe-b31d-014eae1bf0ef', 'quantite': '60 g'}, {'ingredient_id': 'd719dc87-32af-4390-b428-c51998975122', 'quantite': '4'}, {'ingredient_id': '7ac2ab20-3515-4e81-848b-832bb98e0c03', 'quantite': '125 g'}, {'ingredient_id': 'cdb31f55-96e9-4e68-b898-1e6fa2cfa394', 'quantite': '100 g'}, {'ingredient_id': '88d569db-6b66-4be5-9291-ba400fc4e59b', 'quantite': '10 cl'}, {'ingredient_id': '48d7d4f1-d805-4c6e-b95b-5e71cb44e69d', 'quantite': '170 g'}, {'ingredient_id': 'fdf7a4e5-5701-4b7b-9b23-ef550a38c243', 'quantite': '2'}, {'ingredient_id': '378e132a-8890-4ed5-89c5-48fd7f7705e9', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29122, 'Papillote de fruits frais sauce orange vanille', 'banane, orange, mangue, ananas, vanille, sucre vanillé, cannelle', '40 min', ['Presser le jus de deux oranges et faire chauffer à feu très doux (au minimum) avec une gousse de vanille entière en remuant de temps en temps pour que le jus ne colle pas à la casserole. ', 'Coupez les bananes en lamelles, 2 oranges en quartiers moyens, la mangue en petits cubes et l''ananas en quartiers également. ', 'Mélanger les fruits au jus bien chaud, verser une ou deux cuillerées à café de cannelle suivant les goûts ainsi que le sachet de sucre vanillé, et laisser mijoter 5 petites minutes, sans que le mélange bouille. ', 'Pendant ce temps, préparer deux morceaux de papier de cuisson, où vous déposerez les fruits dessus, formant un rond de plusieurs couches de fruits. ', 'Saupoudrez les fruits du jus restant de la casserole et des graines de la deuxième gousse de vanille. ', 'Refermer la papillote et laisser cuire à feu doux (4/5) durant une trentaines de minutes). ', 'Servir dans une belle assiette, en décorant avec l''orange restante, en coupant de belles tranches rondes entières, et avec une boule de glace à la vanille des îles ou alors accompagné de fromage frais léger. C''est un délice. ', 'Pour la façon de préparer, je prépare parfois la même chose, mais pique les fruits sur un pic en bois que je cuis également en papillote, faisant de belles brochettes de fruits.'], ['Louche', 'Couteau de chef', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'Papillote de fruits frais sauce orange vanille', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'sucre vanillé', 'orange', 'ananas', 'cannelle', 'cocktail'], 'Dessert', 978f186d-1301-4fe7-a998-0dc20b34656d, '2025-09-26T15:22:28.733164', [{'ingredient_id': 'ce4ecee1-f375-483f-8caf-32fff5ed91c1', 'quantite': '2'}, {'ingredient_id': 'a066eef5-f94e-4c82-8cc0-e586723f732d', 'quantite': '5'}, {'ingredient_id': 'f4b22ba3-6069-44e1-90d5-5ac528b4f9ba', 'quantite': '1'}, {'ingredient_id': 'b5f914af-5221-43ac-a565-8bd22d071682', 'quantite': '3'}, {'ingredient_id': 'ad34e3b6-0692-4a8f-9b0d-ea223b9141eb', 'quantite': '2'}, {'ingredient_id': '5f46161e-c3df-4382-a021-8ffa57d9b1b8', 'quantite': '1'}, {'ingredient_id': 'f93a402f-cfdd-4075-96e8-ea6429432260', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (54812, 'Toasts à la Banane', 'toast, banane, beurre de cacahuètes', '10 min', ['Tartiner les toasts de beurre de cacahuète.', 'Eplucher et couper la banane en rondelles de 5 mm d''épaisseur.', 'Disposer une rondelle par toast.'], ['Louche', 'Tire-bouchon', 'Fouet', 'Presse-agrumes', 'Verre doseur'], ['', 'Toasts à la Banane', 'toast', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'beurre de cacahuètes', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Amuse-gueule', 7b73d5ea-34bc-4099-9718-983accac3ad2, '2025-09-26T15:22:32.761147', [{'ingredient_id': 'cbe4f932-8f2f-4984-8bba-d3a8335c26b6', 'quantite': '15'}, {'ingredient_id': 'e27835a3-8194-45e4-9ae2-a3df9e351688', 'quantite': '1'}, {'ingredient_id': '65588844-1069-4a45-b5c6-03c4f47f02fc', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21362, 'Bananes au four', 'banane, beurre, sucre roux', '5 min', ['Epluchez et coupez les bananes en 2. Beurrez votre plat. Disposez-les à l''intérieur puis mettez-les au four préalablement chauffé à 220°C. ', 'Lorsque les bananes sont dorées sortez-les du four puis saupoudrez-les avec le sucre. ', 'Renfournez-les et attendez environ 10 min. A servir chaud. Bon appétit.'], ['Balance de cuisine', 'Casserole', 'Spatule', 'Verre doseur'], ['Bananes au four', '', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:22:36.095702', [{'ingredient_id': 'e22c78fa-75a3-4949-8e83-c4db62453393', 'quantite': '4'}, {'ingredient_id': '10dd1e4f-ac6a-4bf9-bfe2-4b9fea221c73', 'quantite': '40 g'}, {'ingredient_id': 'c0ddb824-80a6-4f6f-b467-593bb86e73e9', 'quantite': '40 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12684, 'Brochettes de porc à la banane', 'filet mignon, banane, lard fumé, poivron, vin blanc, huile d''olive, quatre-épices, tabasco', '15 min', ['Une heure avant : Préparez la marinade en mélangeant ous les ingrédients. Faites mariner le filet mignon 1 h. ', 'Découpez les bananes en quatre. Enveloppez les tronçons de bananes de fines tranches de lard. Préparez quatre brochettes en alternant porc, banane et poivron.', 'Cuire 15 mn a four très chaud.'], ['Batteur électrique', 'Rouleau à pâtisserie', 'Louche', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'Brochettes de porc à la banane', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'poivron', 'dessert', 'plat de résistance', 'filet mignon', 'lard fumé', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:22:40.789305', [{'ingredient_id': '46d78276-fe4e-4b8c-903a-e02d14cb48dd', 'quantite': '1'}, {'ingredient_id': 'a03ff81e-70ef-4f83-8518-490f49ddd59b', 'quantite': '2'}, {'ingredient_id': '12e2830a-8b3f-421e-aab3-9b7f127c9cd8', 'quantite': '8'}, {'ingredient_id': '8c7f3c2f-2df2-43ef-b330-ab5af0a79618', 'quantite': ''}, {'ingredient_id': '5eb81252-de83-4c1c-a48a-ef5e214af19c', 'quantite': '5 cuillères'}, {'ingredient_id': '4c90db7b-041b-4cd2-bd06-f8d5aa8d00d7', 'quantite': '2 cuillères'}, {'ingredient_id': 'e152a357-7338-438f-8f04-84f8da0c532c', 'quantite': '1'}, {'ingredient_id': 'b5c7a8e2-a6ce-4a60-995a-f9057370c04d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18498, 'Ragout caraïbes', 'huile d''arachide, oignon, ail, gingembre, curry, coriandre, clou de girofle, poivre de Cayenne, patate douce, courgette, banane plantain, tomate, jus de citron, ananas', '20 min', ['Faire revenir oignon. ', 'Ajouter l''ail et les épices, faire revenir 3 mn. ', 'Ajouter les patates et les plantains, couvrir et laisser cuire 15 mn. ', 'Ajouter les courgettes, jus de tomate et de citron vert. ', 'Couvrir et laisser mijoter à feu doux pendant 40 mn ou jusqu''à ce que les légumes soient cuits. Vous pouver ajouter de l''eau ou du lait de coco en cours de cuisson si vous désirez avoir plus de jus.'], ['Pince de cuisine', 'Mixeur', 'Verre doseur', 'Râpe'], ['', 'gingembre', 'entrée', 'huile d''arachide', 'recettes de cuisine', 'Ragout caraïbes', 'confiserie', 'testées', 'patate douce', 'très facile', 'bon marché', 'ail', 'tomate', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'clou de girofle', 'dessert', 'plat de résistance', 'banane plantain', 'jus de citron', 'coriandre', 'ananas', 'poivre de Cayenne', 'courgette', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:22:44.383616', [{'ingredient_id': '626dfd23-64e7-4934-829c-ba8b164182e2', 'quantite': '1 cuillères'}, {'ingredient_id': '2fb863eb-7cad-4ab7-ba3c-be52954b18ee', 'quantite': '1'}, {'ingredient_id': '1d2ddc6c-a59b-44b5-891e-986b8821585e', 'quantite': '1'}, {'ingredient_id': 'd39ed520-122e-4a00-9a88-89c5bca965a8', 'quantite': ''}, {'ingredient_id': '42ca1f8c-ad5f-429e-b7e2-e1b159256b05', 'quantite': ''}, {'ingredient_id': '1d2c0151-d65d-45f8-a12d-341c4ad8e187', 'quantite': ''}, {'ingredient_id': '63e23496-de2e-4ba9-85bb-dbe427201ab8', 'quantite': '2'}, {'ingredient_id': '8e075796-00a0-4131-bfb5-1879f0fda350', 'quantite': '1'}, {'ingredient_id': '47059a75-645c-4717-893b-28700dc3f9dd', 'quantite': '450 g'}, {'ingredient_id': '157aaa83-170f-476c-9a0f-b720284d0f9a', 'quantite': '450 g'}, {'ingredient_id': 'bb947780-89ce-4a37-a272-35f784ec6480', 'quantite': '2'}, {'ingredient_id': 'b1aff1e7-dade-4132-8d86-db543d90be5f', 'quantite': '250 ml'}, {'ingredient_id': 'ef670d93-4c27-41c1-872c-3ca994a885d3', 'quantite': '1'}, {'ingredient_id': '370a9114-47f5-4d52-8931-69120af0a216', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (86644, 'Salade de fruits hivernale', 'clémentine, kiwi, pomme, mangue, banane, cannelle, orange', '15 min', ['Couper les fruits en fines lamelles ou en petits dés (selon votre choix esthétique !).', 'Ajouter le tout dans un grand saladier.', 'Presser ensuite les oranges et ajouter le jus dans la salade.', 'Enfin, prendre une toute petite cuillère de cannelle (car la cannelle apporte beaucoup de goût!) et l''ajouter dans le saladier.', 'Mettre au frais 10 min.'], ['Verre doseur', 'Moule à tarte', 'Planche à découper', 'Couteau de chef'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'clémentine', 'dessert', 'plat de résistance', 'Salade de fruits hivernale', 'pomme', 'moyen', 'orange', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:22:48.777650', [{'ingredient_id': '0b6e9bca-638c-4df2-9a9a-2ac48674c021', 'quantite': '2'}, {'ingredient_id': '7c823381-7b57-4e27-bae3-1cc9a66b9caa', 'quantite': '2'}, {'ingredient_id': 'c44fcb5b-5d7c-49ad-9b66-04c9b536d87e', 'quantite': '1'}, {'ingredient_id': 'fab62dd1-69a8-4a3e-83c0-96fe89ecc79e', 'quantite': '2'}, {'ingredient_id': 'dee0526b-6dc2-483c-a3fc-335b04ff1109', 'quantite': '1'}, {'ingredient_id': '3efdeb00-0fb3-409a-94ad-a6b7aa8ca8c6', 'quantite': ''}, {'ingredient_id': '1804cc15-3e7d-47b9-8f0a-b64f6a5d99ec', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14147, 'Clafoutis flambé aux bananes', 'farine, sucre en poudre, oeuf, beurre, lait, sel, banane, rhum', '10 min', ['Mettre la farine, le sucre, les oeufs, le lait et le sel dans le robot, puis battre pour mélanger(battre à la main en l''absence de robot).', 'Beurrer une tôle et préchauffer le four (thermostat 7/8).', 'Découper les bananes en rondelles dans la tôle. Verser la pâte dessus, puis y découper de petites noisettes de beurre.', 'Faire cuire 35 mn à four chaud (thermostat 8/240°C).', 'Saupoudrer alors le clafoutis de sucre en poudre et réenfourner quelques minutes pour caraméliser.', 'Flamber au rhum (ou autre) et servir.', 'Remarque : laisser tiédir et flamber au dernier moment.'], ['Balance de cuisine', 'Ouvre-boîte', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'clafoutis', 'beurre', 'lait', 'cocktail', 'Clafoutis flambé aux bananes'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:22:52.332864', [{'ingredient_id': '0d1ae866-310e-43b6-b2f2-1da509f3550d', 'quantite': '2 cuillères'}, {'ingredient_id': 'ee879e95-361b-4dca-9a08-8960c4ac4bd7', 'quantite': '7 cuillères'}, {'ingredient_id': '988937d5-247e-4251-91e4-d8c09a4b58b8', 'quantite': '3'}, {'ingredient_id': 'c35dd65a-5c31-410c-8694-45c687de2c4e', 'quantite': '50 g'}, {'ingredient_id': '8afb384e-d0c6-4e20-8b3e-e92aca5e13b5', 'quantite': '2'}, {'ingredient_id': '2493b60e-1436-4f91-9979-e62fa912399c', 'quantite': '1'}, {'ingredient_id': 'aecf23a0-f7e8-42cd-b9e2-e319fa68ec2f', 'quantite': '4'}, {'ingredient_id': 'ea2ca2a8-9977-46ff-85c0-0baae0cc4fda', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46725, 'Gâteau banane et caramel', 'banane, Digestive, beurre demi-sel, crème fraîche liquide, sucre en poudre, lait concentré sucré', '60 min', ['Emietter les biscuits, les mettre dans un moule à manquer.', 'Faire fondre le beurre et le verser sur les biscuits, réserver et mettre au frigo après refroidissement.', 'Pendant ce temps, plonger la boite (fermée) de lait concentré dans l''eau bouillante (l''eau doit recouvrir entièrement la boite)  et laisser sur feu moyen pendant 1h15.', 'Sortir la boite de l''eau, attendre quelques minutes et l''ouvrir.', 'Reprendre votre moule et y verser le "caramel".', 'Recouvrir ensuite de rondelles de bananes.', 'Fouetter la crème avec le sucre et verser sur le gâteau.', 'Laisser reposer 2/3 h au frigo.'], ['Casserole', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'caramel', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'lait concentré sucré', 'beurre demi-sel', 'boisson', 'Digestive', 'dessert', 'plat de résistance', 'Gâteau banane et caramel', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:22:56.440883', [{'ingredient_id': '49d387c3-de4f-402b-a6b3-351961bceab5', 'quantite': '4'}, {'ingredient_id': 'e72b1aa3-37a2-4674-ae7d-26572f9010c8', 'quantite': ''}, {'ingredient_id': '9685c613-5731-41a4-881d-649835092f66', 'quantite': '175 g'}, {'ingredient_id': '52304f03-fdf5-4c4f-9101-104247c32b44', 'quantite': '15 cl'}, {'ingredient_id': '287e52cb-004a-4062-911d-547783f29919', 'quantite': '2 cuillères'}, {'ingredient_id': 'bbd31499-7111-4def-893a-50aba90731b6', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14745, 'Muffins à la banane', 'banane, sucre, oeuf, bicarbonate, levure, sel, farine, beurre', '10 min', ['Ecraser les bananes. Ajouter le sucre et l''oeuf légèrement battu. Ajouter le beurre fondu, puis les ingrédients secs (farine, levure, bicarbonate).', 'Placer dans des moules à muffin.', 'Cuire à 190°C pendant 20 min.'], ['Batteur électrique', 'Planche à découper', 'Fouet', 'Ouvre-boîte', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'muffin', 'beurre', 'sucre', 'cocktail', 'bicarbonate', 'Muffins à la banane'], 'Dessert', 0c6ef1bc-cff2-45b2-922c-82369bb91324, '2025-09-26T15:23:03.163575', [{'ingredient_id': 'f142bee7-5d4a-4805-8299-fb19a82314a1', 'quantite': '3'}, {'ingredient_id': '366de106-515d-413b-b1f7-9a943fab4746', 'quantite': '75 g'}, {'ingredient_id': 'feb6a555-22f1-47a4-9a21-5dc52149ed93', 'quantite': '1'}, {'ingredient_id': '77e04bbe-1994-43cf-85af-a6cd0172a814', 'quantite': '1 cuillères'}, {'ingredient_id': '4f90bd58-48a7-41f5-83bd-906110f6d4b6', 'quantite': '1 cuillères'}, {'ingredient_id': '3b827b9f-386e-42b4-985d-48246cf1059c', 'quantite': ''}, {'ingredient_id': '7d498543-3656-439f-b260-126febf81039', 'quantite': '150 g'}, {'ingredient_id': '732ac78b-2f36-4877-9d46-0ffa56cd538d', 'quantite': '70 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70807, 'Sorbet fraise-banane', 'fraises, banane, citron, sucre', '30 min', ['Lavez et équeutez les fraises, coupez les en 4.', 'Epluchez les bananes et coupez-les en rondelles.', 'Mixez le tout puis ajoutez le jus de citron et le sucre, mélangez bien. Mettez le tout dans la sorbetière et mettez au congélateur.', 'Si vous n''avez pas de sorbetière, mettez la préparation dans un bac que vous placez dans le congélateur. Les 3 premières heures, remuez la préparation tous les quarts d''heure pour éviter la formation de paillettes. ', 'Dégustez après quelques heures au congélateur, lorsque la préparation est consistante.'], ['Passoire', 'Spatule'], ['Sorbet fraise-banane', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'sorbet', 'dessert', 'plat de résistance', 'citron', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:23:06.765085', [{'ingredient_id': 'bab1b6fc-a761-4af5-a9dc-22eebd79a776', 'quantite': '250 g'}, {'ingredient_id': 'b1d724a5-c539-48d5-884c-a2b0dc2ee2e6', 'quantite': '3'}, {'ingredient_id': 'e6e6abee-b657-4f14-8b59-8a3cfd528bf1', 'quantite': ''}, {'ingredient_id': '001e9f90-49f2-4bb9-b0bc-b9cf2b023db4', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70278, 'Tiramisu fraises bananes', 'biscuits à la cuillère, fraises, banane, mascarpone, sucre, oeuf, grenadine, spéculoos', '20 min', ['Mettre à tremper les biscuits dans la grenadine dans un plat adapté.', 'Préparer les fraises : les laver, les équeuter et les couper. Ajouter 30 g de sucre et mixer de façon à obtenir une purée. Ajouter les bananes coupées en petits morceaux. Mettre de côté.', 'Pendant ce temps, préparer la crème. Battre les jaunes d''oeufs avec les 30 g de sucre restants, et ajouter le mascarpone. Mélanger de façon à obtenir un mélange bien lisse. Mettre au frais.', 'Dans un saladier, battre les 5 blancs d''oeufs en neige bien ferme. Ajouter les blancs d''oeufs au mélange mascarpone/oeufs/sucre délicatement.', 'Préparer les coupes, en disposant au fond les biscuits à la cuillère trempés rapidement dans la grenadine (1 volume de sirop pour 7 volumes d''eau). Verser le mélange fraises-bananes à mi-hauteur et enfin verser la crème au mascarpone sur le dessus. Laisser reposer au frais quelques heures, l''idéal serait une nuit.', 'Emietter les spéculoos dessus au moment de servir pour conserver leur croquant. Servir.'], ['Verre doseur', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'confiserie', 'testées', 'biscuits à la cuillère', 'facile', 'rapide', 'oeuf', 'plat', 'fraises', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'tiramisu', 'moyen', 'Tiramisu fraises bananes', 'grenadine', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:23:10.332052', [{'ingredient_id': '455f5e7a-7f57-41c1-b45f-4b7756bfe404', 'quantite': '1'}, {'ingredient_id': '46d29f4b-499b-4dc8-93c8-1b33cf1d0f18', 'quantite': '500 g'}, {'ingredient_id': '3880c51b-947c-49c9-96fd-616e8c669d1e', 'quantite': '2'}, {'ingredient_id': 'c70cac77-735e-42e6-a115-55c78ce71296', 'quantite': '250 g'}, {'ingredient_id': 'cdaad177-5e9d-4e22-b437-63104e497715', 'quantite': '60 g'}, {'ingredient_id': 'd50ae494-ee17-446b-96a7-14cbde6d66f8', 'quantite': '3'}, {'ingredient_id': 'f0db0c4e-29ff-4cbf-9f88-ffeab8772e93', 'quantite': ''}, {'ingredient_id': 'd45b2018-c63b-4f8f-8608-9ba74b60ab0e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16815, 'Terrine de bananes au coulis de fraises', 'oeuf, lait, miel, pain aux céréales, margarine, oeuf, lait, fécule de maïs, miel, banane, raisin, gélatine, eau, eau, fraises, pomme, miel', '20 min', ['TERRINE', 'Préchauffer le four à 150oC. ', 'Dans un bol, mélanger l''oeuf, le lait et le miel. Tremper les tranches de pain dans cette préparation. Dans', 'une poêle, faire fondre la margarine et dorer les tranches de pain à feu moyen 1 minute de chaque côté. ', 'Sur une planche de travail, tailler les tranches de pain de façon à couvrir le fond d''une terrine ou un moule à pain légèrement graissé; réserver. ', 'Dans un bol, mélanger les oeufs, le lait, la fécule de maïs, le miel, les bananes et les raisins. Incorporer la gélatine préalablement gonflée dans l''eau froide et délayée dans l''eau chaude. Verser dans le moule et cuire au four au bain-marie 1 h à 1 h 15 minutes environ; réfrigérer. ', 'COULIS DE FRAISES', 'Dans une casserole, amener les fraises, le jus de pomme et le miel à ébullition. Mélanger au robot culinaire et passer au tamis. ', 'Démouler la terrine et couper en tranches épaisses. Servir sur le coulis de fraises et décorer de fruits frais.'], ['Rouleau à pâtisserie', 'Planche à découper', 'Louche', 'Mixeur'], ['coulis de fruits rouges', 'raisin', 'entrée', 'banane', 'pain aux céréales', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'facile', 'Terrine de bananes au coulis de fraises', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'margarine', 'dessert', 'plat de résistance', 'gélatine', 'lait', 'cocktail', 'fécule de maïs'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:23:14.669216', [{'ingredient_id': '7af94ec3-394c-45da-ad0d-8a79ccd2fac4', 'quantite': '1'}, {'ingredient_id': 'dcf4c3c5-5099-4a4a-a931-950dab0c9333', 'quantite': '25 cl'}, {'ingredient_id': '20f56459-a208-45fd-9ce1-d1cb076411b5', 'quantite': '1 cuillères'}, {'ingredient_id': '41a92a47-b881-442c-a100-f40319e67538', 'quantite': '4'}, {'ingredient_id': '96bb740f-5a46-4381-b7a3-55a3cb292855', 'quantite': '1 cuillères'}, {'ingredient_id': 'bcec9266-109f-4781-bca9-7cb5a9a440bd', 'quantite': '4'}, {'ingredient_id': '4642c1ac-045f-4233-857d-59ca9349d2e0', 'quantite': '50 cl'}, {'ingredient_id': '0bb16bc2-6d3f-4f41-b7c3-a07601746301', 'quantite': '1.5 cuillères'}, {'ingredient_id': '021226f2-6d88-485c-b63b-2ec168604bd7', 'quantite': '3 cuillères'}, {'ingredient_id': '978d004c-ab51-4bd3-974c-189c070ac9f3', 'quantite': '2'}, {'ingredient_id': '7d6259f1-f01f-4643-a9ec-61d386226361', 'quantite': '5 cl'}, {'ingredient_id': '621b1f9d-ecc7-40a0-9909-e6ae89739736', 'quantite': '1'}, {'ingredient_id': '25b9c6ce-c58d-4f4e-9aad-85d741440712', 'quantite': '2.5 cl'}, {'ingredient_id': '66b25c83-30d0-47f4-8b38-6ef88eeaa7de', 'quantite': '5 cl'}, {'ingredient_id': '7a90c8a5-1e21-477b-a7aa-6a66ec167a53', 'quantite': '300 g'}, {'ingredient_id': '5eca9d1d-39df-4d57-a2f7-38c6b70a26e2', 'quantite': '17.5 cl'}, {'ingredient_id': '1fb54de9-a13a-498e-aaa7-f39af59d5d14', 'quantite': '5 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21935, 'Délice aux bananes', 'pâte sablée, banane, oeuf, sucre en poudre, crème fraîche, amandes en poudre', '20 min', ['Préchauffez votre four à 200°C. ', 'Etalez la pâte dans un moule à tarte et piquez-en le fond avec une fourchette. ', 'Faites cuire à blanc pendant 8 à 10 mn au four à 200°C. ', 'Dans un saladier, mélangez les oeufs, le sucre, la poudre d''amandes et la crème fraîche. ', 'Coupez les bananes en rondelles et disposez-en la moitié sur la pâte précuite. Versez la préparation et recouvrez à nouveau avec le reste des bananes. ', 'Faites cuire pendant 35 mn à 180°C. ', 'Cette tarte peut être servie tiède ou froide selon votre envie.'], ['Presse-agrumes', 'Couteau de chef', 'Verre doseur', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'Délice aux bananes', 'très facile', 'bon marché', 'amandes en poudre', 'pâte sablée', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', 624e4c9e-3fc4-4b8a-aab4-1854297018d3, '2025-09-26T15:23:18.221014', [{'ingredient_id': '530687ae-c2d4-422f-9575-240c76d09411', 'quantite': '1'}, {'ingredient_id': '9b29cabc-70eb-4b18-abd4-c308df4b42a7', 'quantite': '4'}, {'ingredient_id': 'f99756ac-d169-4616-9b99-de1013c4646a', 'quantite': '2'}, {'ingredient_id': '4596a840-5494-49cb-b0d5-cec0442b388b', 'quantite': '100 g'}, {'ingredient_id': '21abb6a1-a431-40db-af19-3c842e66becf', 'quantite': '20 cl'}, {'ingredient_id': '7ae19afc-33a2-44c8-80d3-0b354e370326', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14785, 'Sablé aux bananes', 'biscuit sablé, beurre, crème fraîche, banane, lait concentré sucré', '20 min', ['Cuire la boîte de lait fermée pendant une heure et demie dans de l''eau bouillante sans interruption et laisser refroidir complètement.', 'Emiettez les biscuits et ajoutez le beurre fondu, applatissez le tout dans un plat à tarte et laissez au frigo pendant 10 mn.', 'Couvrez ce biscuit avec le lait caramélisé puis couvrez de rondelles de bananes.', 'Fouettez la crème fraîche et couvrez le tout avec celle-ci.'], ['Rouleau à pâtisserie', 'Râpe', 'Verre doseur', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'biscuit sablé', 'très facile', 'bon marché', 'sablés', 'plat', 'recette', 'cuisine', 'recettes', 'lait concentré sucré', 'boisson', 'Sablé aux bananes', 'dessert', 'plat de résistance', 'beurre', 'cocktail'], 'Dessert', 702286d2-9614-4b9d-a917-ab624f0274d6, '2025-09-26T15:23:21.638162', [{'ingredient_id': '964893c1-bd7e-42c8-a443-39645d5543e5', 'quantite': '250 g'}, {'ingredient_id': 'b30e0675-d0d0-4561-8d4c-24a7b9c5cf97', 'quantite': '100 g'}, {'ingredient_id': '08e5bb91-4d53-4bd3-a653-1f54d0907d79', 'quantite': '250 ml'}, {'ingredient_id': '2048dcb3-97f6-41c2-b526-ebd7e2363c6c', 'quantite': ''}, {'ingredient_id': 'b3cb3350-6b17-429f-ace5-21614e1a52f1', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169361, 'Gâteau au yaourt pomme banane', 'yaourt, farine, oeuf, sucre semoule, huile, levure, sucre vanillé, pomme, banane', '10 min', ['Préparer la pâte.', 'Verser dans un saladier, le pot de yaourt.', 'ajoutez le pot de sucre , la levure , la farine, l''huile , le sucre vanillé et les oeufs.', 'Mélangez le tout.', 'lavez les deux pommes épluchez les et couper les en petit morceaux.', 'incorporez les dans la pâte.', 'faite de même avec la banane.', 'une fois le mélange prêt.', 'huilez votre moule et verser la pâte dedans.', 'le four préchauffez enfourner a 180 pendant 15 min environ.', 'a la sortie soupoudrez de sucre glaçe.'], ['Économe', 'Poêle', 'Couteau de chef', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'Gâteau au yaourt pomme banane', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'sucre semoule', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'gâteau à la banane', 'cocktail'], 'Dessert', 01e2aee0-f9ef-47bf-be21-e89258120095, '2025-09-26T15:23:26.282504', [{'ingredient_id': '58308d4a-0ecc-462c-9c61-6d5bc845934c', 'quantite': '1'}, {'ingredient_id': 'abd2349e-b813-4aea-a9ce-7d170707b453', 'quantite': '3'}, {'ingredient_id': '38c9bc95-bc4a-40d3-93e5-98588e0bc8e3', 'quantite': '3'}, {'ingredient_id': '2f2013fc-68bc-4706-80f3-a6964e040931', 'quantite': '1'}, {'ingredient_id': 'a2fbfe09-205d-47f6-a05f-0454a198fa77', 'quantite': '1'}, {'ingredient_id': '62776f53-627c-4849-afa1-e575210d1c4f', 'quantite': '1'}, {'ingredient_id': 'f2944cca-c855-4748-b25d-f50f7854ec02', 'quantite': '1'}, {'ingredient_id': '05bb2646-128b-46a3-a8b5-fde525c6509d', 'quantite': '2'}, {'ingredient_id': '148d1c22-378c-42ac-8657-091fadc5f11c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (54946, 'Rôti de porc laqué et bananes poêlées', 'rôti de porc, miel liquide, curry, beurre, banane', '5 min', ['Préchauffer le four à 210°C (thermostat 7).', 'Dans un bol mélanger le miel avec le curry et en badigeonner le rôti.', 'Le mettre dans un plat beurré.', 'Mettre au four pour 45 min en le badigeonnant de la sauce régulièrement, il faut que ça caram&lise, mais pas trop il doit rester un fond de sauce en fin de cuissson. ', 'Si vous voyez que la sauce diminue trop et que le rôti n''est pas encore assez cuit, sortez-le du four et tranchez-le, sans oublier de bien le mouiller de sauce avant de l''enfourner.', 'Partager les bananes en 2 et faites-les rôtir dans une poêle avec le beurre environ 5 minutes de chaque côté.', 'Servir le rôti tranché avec les bananes.', 'Vous pouvez accompagner de riz ou lentilles pour les bons mangeur.'], ['Fouet', 'Poêle'], ['miel liquide', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'Rôti de porc laqué et bananes poêlées', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'curry', 'cocktail', 'rôti de porc'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:23:29.858803', [{'ingredient_id': '118e2d29-a8e1-4e9f-8057-067905f37086', 'quantite': '1'}, {'ingredient_id': '23956f19-3208-4a16-82af-cdc8907aea09', 'quantite': '6 cuillères'}, {'ingredient_id': '16c63c2b-8a95-4f97-9761-b80524f6df35', 'quantite': '6'}, {'ingredient_id': '8f25ec17-806f-48ac-8b93-5b6d5981d1c2', 'quantite': ''}, {'ingredient_id': '4ed2d370-abcd-4255-abf4-0fb5365a0f80', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66712, 'Salade de fruit d''hiver', 'pomme, poire, banane, orange, mandarine, kiwi, cerises, grand-marnier, sirop, fruits', '15 min', ['Peler les fruits frais, et les couper en morceaux dans le saladier. ', 'Ajouter les cerises + la moitié du jus du bocal (éviter de mettre la totalité du jus au risque de voire la salade baigner).', 'Ajouter le Grand-Marnier, le sirop de vanille, le jus de noix de coco, bien remuer, et mettre au réfrigérateur 1 petite heure.'], ['Mixeur', 'Tire-bouchon'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'Salade de fruit d''hiver', 'facile', 'salade de fruits d''hiver', 'mandarine', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'orange', 'grand-marnier', 'sirop', 'fruits', 'cocktail', 'cerises'], 'Dessert', a34495d0-2476-41d1-8063-ebb586ad6c02, '2025-09-26T15:23:33.358654', [{'ingredient_id': '9c62f7b4-656a-47ed-bb7e-fc5ce589bf5b', 'quantite': '1'}, {'ingredient_id': '26485d99-5e70-4a4c-8427-a34bf6cf1bea', 'quantite': '1'}, {'ingredient_id': '3db93aac-9761-4ea2-9e8d-7aed49147dcf', 'quantite': '1'}, {'ingredient_id': '85752edd-f936-4b08-b64d-9c38e02670fc', 'quantite': '1'}, {'ingredient_id': 'f66fc4d8-1d7b-412e-8fb7-e7384dcc960e', 'quantite': '2'}, {'ingredient_id': 'dca318fe-e6bc-4215-a77e-a82c1b8dc93f', 'quantite': '2'}, {'ingredient_id': 'd7134f4c-e13a-47a1-a02e-af2e50fa2902', 'quantite': '1'}, {'ingredient_id': '4f9a3866-52fa-4b0d-8bf2-f0c18814628d', 'quantite': '1 cuillères'}, {'ingredient_id': '726fe32f-4114-4e61-92b7-735a43fffbf8', 'quantite': '1 cuillères'}, {'ingredient_id': '39d7bc24-f8dd-4dc4-abe1-9be5fd4b3ec5', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72822, 'Milk shake banane yaourt', 'banane, lait, yaourt nature, glaçons, sucre, crème chantilly, chocolat', '20 min', ['Dans un shaker, mettre les bananes coupées en rondelles, le lait, le yaourt puis mixer. ', 'Ajouter les glaçons et le sucre, mixer à nouveau. ', 'Verser dans des verres, recouvrir de chantilly puis saupoudrer de copeaux de chocolat. ', 'Bon appétit.'], ['Planche à découper', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'chocolat', 'très facile', 'bon marché', 'Milk shake banane yaourt', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'dessert', 'plat de résistance', 'glaçons', 'lait', 'sucre', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:23:36.908120', [{'ingredient_id': 'f1748a11-b558-4d0a-b103-442c91b5d404', 'quantite': '2'}, {'ingredient_id': '096675d2-f731-468a-95df-f38fd3378a96', 'quantite': '50 cl'}, {'ingredient_id': '12559f59-f52f-4a4c-ac46-53aa9330dd9d', 'quantite': '1'}, {'ingredient_id': '3df4887c-0ed7-4ea9-8618-d3d35b0cd186', 'quantite': '4'}, {'ingredient_id': 'dda3b640-560b-4aaf-bd51-c9b2e4ce6096', 'quantite': '50 g'}, {'ingredient_id': '7ac9dad5-e332-4981-9e32-3861a48ad039', 'quantite': ''}, {'ingredient_id': '7826b384-8912-4678-9099-0358b750d62c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169440, 'Amour de fruits rouges, croustillant chocolat blanc et coeur banane', 'oeuf, sucre en poudre, farine, levure chimique, lait, fruits rouges, sucre en poudre, eau, blanc d''oeuf, petit suisse, agar-agar, chocolat blanc, crêpe dentelle, banane, coulis, chocolat blanc', '90 min', ['Préparation de la génoise:', 'Préchauffer le four à 240°C (th. 8).', 'Fouetter les oeufs avec le sucre jusqu''à ce que la préparation blanchisse, gonfle et devienne mousseuse.', 'Ajouter la farine et la levure, puis le lait.', 'Faire cuire le gâteau 5 à 10 min, jusqu''à ce qu''il soit doré, sur une petite plaque.', 'Sortir et laisser refroidir.', 'Préparation du coulis:', 'Faire compoter les fruits avec le sucre et l''eau dans une casserole pendant environ 10 min.', 'Retirer du feu et filtrer avec un chinois. Ecraser les fruits pour récupérer un maximum de coulis.', 'Peser 100g de coulis, refaire chauffer et laisser frémir pendant 2 minutes avec l''agar-agar. Laisser refroidir.', 'Conserver le reste du coulis non utilisé au réfrigérateur, il servira pour le nappage.', 'Début du montage:', 'Avec les emporte-pièces, prélever des cercles de génoises et les disposer sur un grand plat ou des assiettes individuelles.', 'Préparation du croustillant au chocolat blanc et du coeur banane:', 'Faire fondre le chocolat au bain-marie sans le remuer. Lorsqu''il est presque entièrement fondu, couper le feu, mélanger et laisser finir de fondre.', 'Emietter les crêpes dentelles dans le chocolat et bien mélanger.', 'Répartir ce mélange dans les 4 emporte-pièces.', 'Réduire la banane en purée et la répartir au centre de chaque emporte-pièce.', 'Préparation de la mousse aux fruits rouges:', 'Mélanger le coulis avec l''agar-agar refroidi avec les petits-suisses, débarrassés au préalable du petit lait.', 'Battre le blanc d''oeuf en neige avec une pincée de sel puis l''incorporer délicatement au mélange précédent.', 'Répartir dans les 4 emporte-pièces et mettre une nuit au réfrigérateur.', 'Le lendemain, préparation du nappage:', 'Porter le reste du coulis à ébullition et laisser frémir 2 min avec l''agar-agar.', 'Laisser refroidir pendant 20 min en mélangeant de temps en temps.', 'Etaler sur la mousse aux fruits rouges jusqu''au rebord.', 'Faire prendre au réfrigérateur pendant deux heures.', 'Faire fondre le chocolat blanc au bain-marie de la même façon que pour le croustillant. Ajouter quelques gouttes de colorant.', 'Décorer le dessus du nappage à l''aide d''une seringue selon les envies (on peut mettre des feuilles de menthe, ...).', 'Remettre au réfrigérateur pour que le chocolat durcisse.', 'Démouler très délicatement à l''aide d''un couteau pour bien décoller des bords et servir.'], ['Verre doseur', 'Ouvre-boîte', 'Planche à découper', 'Louche'], ['', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'Amour de fruits rouges', 'croustillant chocolat blanc et coeur banane', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:23:40.532049', [{'ingredient_id': 'f6ebd9a8-5b75-4625-8833-b79596a49d56', 'quantite': '2'}, {'ingredient_id': 'de9bfd7d-b4d5-41ec-a036-5aeea7de5f15', 'quantite': '50 g'}, {'ingredient_id': 'a4b677ab-fed4-47cf-ba3a-53e76a2e468b', 'quantite': '60 g'}, {'ingredient_id': 'aecbe4ca-6d8b-4caf-a778-4753f5c3d7a1', 'quantite': '1 cuillères'}, {'ingredient_id': 'd08b77b2-eaea-4852-8dc0-c21e02d58804', 'quantite': '1 cuillères'}, {'ingredient_id': '67c458e3-b653-4f71-84f8-c9cfa3c60b4e', 'quantite': '300 g'}, {'ingredient_id': 'c9e41797-652d-4e7f-baba-2766047ff1c6', 'quantite': '100 g'}, {'ingredient_id': '60aa2bf4-f41e-4c59-b867-b48fb0dd786c', 'quantite': '1'}, {'ingredient_id': '504c59e5-aa71-49df-a370-d7f0f541282f', 'quantite': '1'}, {'ingredient_id': '3a74d08e-20aa-4822-9198-aa714e99f9d9', 'quantite': '210 g'}, {'ingredient_id': '6ab91ebb-8016-43ee-b0b3-cbc2e5dcaf7c', 'quantite': '2 g'}, {'ingredient_id': '203adaa6-d212-47ee-84c2-fc60d6cf31e1', 'quantite': '60 g'}, {'ingredient_id': '691889cc-3814-47ba-b594-86966491b036', 'quantite': '8'}, {'ingredient_id': '125d4498-7392-4bce-a34e-a8bca9c6f6d1', 'quantite': '1'}, {'ingredient_id': 'e7fc80db-4241-4e61-ab89-d3627bd25ae6', 'quantite': ''}, {'ingredient_id': '7706e6b6-896f-4a12-96a0-92843f22aaab', 'quantite': '25 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (314894, 'Délice à la banane en verrine', 'banane, jus de citron, sucre vanillé, chocolat noir, crème liquide, cacao, mascarpone, spéculoos, banane', '45 min', ['Pour la base banane :', 'Mixer tous les ingrédients au blender.', 'Pour la base chocolat : ', 'Faire fondre le chocolat avec la crème et la poudre de cacao, à feu doux dans une casserole et mélanger l''ensemble avec une spatule.', 'Pour la crème banane mascarpone : ', 'Mélanger la moitié du mélange "base banane" avec la moitié du mascarpone et répartir au fond de 4 verrines.', 'Pour la crème chocolat banane : ', 'Mélanger l''autre moitié de la "base banane" avec la moitié de la "base chocolat" et répartir dans les verrines sur la crème banane mascarpone (répartir avec précaution pour éviter que ça se mélange).', 'Pour la crème chocolat mascarpone : ', 'Mélanger l''autre moitié de la "base chocolat" avec le restant de mascarpone et répartir le tout dans les verrines avec précaution sur la crème chocolat banane.', 'Pour le décor : ', 'Terminer votre dessert en saupoudrant les verrines avec la poudre de mascarpone et poser délicatement 3 rondelles de banane dans chaque verrine.', 'Mettre les verrines au réfrigérateur pendant au moins 1 heure avant de déguster.'], ['Casserole', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'jus de citron', 'Délice à la banane en verrine', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:23:44.104200', [{'ingredient_id': '64b5140f-e1fd-4fe2-9a87-112a15936f39', 'quantite': '2'}, {'ingredient_id': '66c02fbe-1927-424d-b840-c5b28584eee1', 'quantite': '2 cuillères'}, {'ingredient_id': 'bb71e81a-ade7-4211-adc1-be769a236b00', 'quantite': '1'}, {'ingredient_id': 'a5d6e02e-07be-465d-999f-dcf43b278ef9', 'quantite': '30 g'}, {'ingredient_id': '46ec84b1-e831-439d-ae3b-a3fc9a7b7a2d', 'quantite': '2 cuillères'}, {'ingredient_id': 'cbf5cde8-583a-43ae-a2a5-e688e5a5a3d7', 'quantite': '1 cuillères'}, {'ingredient_id': 'e1b211d6-8292-4f34-8809-92056ffae642', 'quantite': '250 g'}, {'ingredient_id': '6e2d3ed8-949f-4baf-aaa9-64683dc4b194', 'quantite': '2'}, {'ingredient_id': 'b8971785-d942-4d81-98ea-4df2a985a216', 'quantite': '12'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (35472, 'poulet aux bananes et curry', 'filet de poulet, champignons de Paris, banane, lait, crème fraîche, curry', '20 min', ['Dans une poêle, faire rissoler les champignons en petits morceaux dans un peu de beurre, réserver. ', 'Faire saisir et roussir la viande coupée en petits cubes. ', 'Rajouter les champignons et ajouter la crème fraîche. ', 'Bien asssaisonner de curry et ajouter 2 bananes en rondelles. ', 'Saler et poivrer à votre goût et laisser mijoter à feux doux 10-15 mn dans la poêle. ', 'Le mélange aura tendance à épaissir à mesure que les bananes fondent, rajouter alors petit à petit le lait et un peu de curry. ', 'Rajouter une bananes en rondelles au moment de servir, accompagner avec du riz à volonté.'], ['Ouvre-boîte', 'Poêle', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'filet de poulet', 'très facile', 'bon marché', 'curry de poulet', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'poulet aux bananes et curry', 'dessert', 'plat de résistance', 'champignons de Paris', 'lait', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:23:48.731695', [{'ingredient_id': '6113ebba-0466-413c-a08a-e1700862652c', 'quantite': '2'}, {'ingredient_id': '0da38589-6920-496e-b6b6-8486672c3737', 'quantite': '200 g'}, {'ingredient_id': 'e846ff37-6845-48e7-a21c-0f0c192b843d', 'quantite': '3'}, {'ingredient_id': '5ffb5dda-7e1c-4dbc-8b1f-3ec84e83eb7f', 'quantite': '30 cl'}, {'ingredient_id': '6da3aa21-8f9e-436e-a032-fee109a9cbc1', 'quantite': '200 ml'}, {'ingredient_id': '018072f2-b8e4-47a3-9565-cce8b78b6fef', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38452, 'Petite salade vitaminée pour l''été', 'tomate, kiwi, banane, avocat, poivre, sel, huile d''olive, citron, menthe', '20 min', ['Préparez la vinaigrette mélanger sel, poivre, 3 cuillères à soupe d''huile et 1 de vinaigre ou de jus de citron.', 'Ebouillantez et pelez les tomates, coupez-les en quartiers ou rondelles.', 'Pelez les kiwis, coupez-les en quartiers ou rondelles.', 'Epluchez les bananes et coupez-les en rondelles.', 'Epluchez les avocats et découpez-les en quartiers.', 'Mélangez tous les ingrédients avec la vinaigrette et parsemez de menthe fraîche (à volonté).'], ['Louche', 'Verre doseur', 'Ouvre-boîte'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'avocat', 'très facile', 'menthe', 'bon marché', 'tomate', 'rapide', 'plat', 'recette', 'salade avocat', 'cuisine', 'recettes', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'citron', 'Petite salade vitaminée pour l''été', 'poivre', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:23:52.862028', [{'ingredient_id': '56b1840c-125f-4d24-a56b-66a01d85a6d7', 'quantite': '6'}, {'ingredient_id': '2c00edbb-0805-418a-b215-6d4206919dc3', 'quantite': '6'}, {'ingredient_id': '6d86d069-f4df-4822-a445-778d5b298b45', 'quantite': '3'}, {'ingredient_id': '45cd9cda-c4f7-44e6-ad27-e8cdaf48613c', 'quantite': '4'}, {'ingredient_id': '833e1fdc-034b-4400-974d-ac9e7bb29ee1', 'quantite': ''}, {'ingredient_id': 'cb0203ce-ce99-40db-8e86-7ef5ad77936f', 'quantite': ''}, {'ingredient_id': '6fa10b5e-caca-4e99-8fe0-4972d4fac8b2', 'quantite': '3 cuillères'}, {'ingredient_id': 'b6bc18e1-b2a5-4b91-a3cd-e365c8f8ac8b', 'quantite': '1 cuillères'}, {'ingredient_id': '01ea4431-e703-4d76-a1aa-df432d6d6876', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37668, 'Bananes au four, abricots secs et noisettes', 'banane, petit suisse, abricot, café, riz soufflé, miel', '5 min', ['Préchauffer votre four 5 minutes à 180°C. ', 'Placer les bananes entières sur une grille pour 25 minutes environ. ', 'Laisser tiédir pour pouvoir les peler sans vous brûler.', 'Mélanger le petit-suisse et le miel. Disposer ce mélange dans une assiette. Placer la banane pelée dessus et rajouter sur le dessus les abricots secs coupés en petits morceaux ainsi que les cérales soufflées et les noisettes grillées.', 'Idéal pour un dessert ou un goûter équilibré pour enfants et parents accompagnateurs !'], ['Passoire', 'Spatule'], ['Bananes au four', '', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'petit suisse', 'testées', 'abricot', 'riz soufflé', 'très facile', 'bon marché', 'plat', 'recette', 'café', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'abricots secs et noisettes', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:23:57.097397', [{'ingredient_id': '767bd6aa-8232-4792-85f3-fc16b4c70ed8', 'quantite': '1'}, {'ingredient_id': 'fdeab537-6c65-433c-8116-eb758fa38a17', 'quantite': '1'}, {'ingredient_id': '79671b57-14f3-4f07-b014-063225c8548b', 'quantite': '2'}, {'ingredient_id': '4835bdf9-f475-42c5-b262-5b26f5ad865f', 'quantite': '1 cuillères'}, {'ingredient_id': '2a0fc21d-9407-4548-a30c-c04e809311a9', 'quantite': '1 cuillères'}, {'ingredient_id': '132b9341-d03b-4aff-9264-2a8f4f2bc4e7', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13762, 'Sangria', 'vin rouge, vin rosé, orange, pomme, banane, pêche, sucre vanillé, cointreau, curaçao, gin, sucre, eau gazeuse', '5 min', ['Laisser macérer tous les ingrédients 24 heures, en remuant de temps en temps. Au moment de servir rajouter la bouteille de Perrier.', 'On peut remplacer les liqueurs Cointreau, Curaçao et Gin par 1 verre à moutarde de Whisky et 1/2 verre à moutarde de Cognac.', 'Vous pouvez remplacer les vins par des crus de votre choix, mais il est préférable d''utiliser des vins corsés.', 'N''utilisez pas cette recette avec du vin spécial Sangria, ce serait gâché!'], ['Passoire', 'Spatule', 'Poêle', 'Louche', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'eau gazeuse', 'recette', 'cuisine', 'recettes', 'sangria', 'Sangria', 'boisson', 'vin rouge', 'cointreau', 'dessert', 'plat de résistance', 'vin rosé', 'sucre vanillé', 'pomme', 'moyen', 'orange', 'pêche', 'sucre', 'gin', 'cocktail', 'curaçao'], 'Boisson', d03dd0d0-ae7f-4371-b7d2-9edf17d71e68, '2025-09-26T15:24:00.631300', [{'ingredient_id': '9536378b-02ec-40d6-9a39-0fdfb4ddaaae', 'quantite': '6 l'}, {'ingredient_id': '071646d0-6150-45ef-a43a-12ffe9cf682e', 'quantite': '6 l'}, {'ingredient_id': 'bed0b421-4473-488a-b07a-16b213767e27', 'quantite': '10'}, {'ingredient_id': '5371b05e-d678-46b1-bf2a-78d126788ded', 'quantite': '8'}, {'ingredient_id': '91d33a8b-661c-4ddf-accb-e22bd0215d20', 'quantite': '4'}, {'ingredient_id': 'eebb603d-5fce-4832-8142-bc05b8ab1516', 'quantite': '6'}, {'ingredient_id': 'e69373be-32fc-4c63-aa1b-c67750f027f3', 'quantite': '2'}, {'ingredient_id': '53305ccd-7a48-4b64-a107-32fe6ad8fae2', 'quantite': '1'}, {'ingredient_id': 'a4d51442-f671-44f2-a3c2-df9a2df82efb', 'quantite': '1'}, {'ingredient_id': 'ca368ea7-8ac0-4c26-a0ce-e7074a11f9b9', 'quantite': ''}, {'ingredient_id': '1f1d0a65-dac0-4e34-a235-3ae5aa1205dd', 'quantite': '40'}, {'ingredient_id': 'cb97ecea-4609-4db1-9fac-3937a10545dc', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55910, 'Milk-shake chocolat, vanille, banane', 'glace vanille, glace au chocolat, banane, lait demi-écrémé', '5 min', ['Mixer tous les ingredients dans l''ordre, à servir tout de suite dans un grand verre avec une paille.'], ['Poêle', 'Économe', 'Pince de cuisine', 'Louche', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Milk-shake chocolat', 'glace vanille', 'vanille', 'dessert', 'plat de résistance', 'chocolat chaud', 'lait demi-écrémé', 'glace au chocolat', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:24:04.876292', [{'ingredient_id': 'bb8033ad-83f6-4971-a158-d388e0d254e3', 'quantite': '1'}, {'ingredient_id': '7cc75cd3-7ca5-4eaf-b239-adfb968c8a4c', 'quantite': '1'}, {'ingredient_id': 'fcd11a83-0f39-4012-ab50-07996a8144ff', 'quantite': '1'}, {'ingredient_id': '4a88b4bb-5f18-40d1-aa39-ae0cd2c538c7', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18366, 'Tarte banane chocolat pralin', 'pâte brisée, banane, chocolat pâtissier, crème liquide, oeuf, sucre', '10 min', ['Préchauffer votre four, th7 (220°).', 'Foncez un moule à tarte avec la pâte feuilletée.  ', 'Découpez des fines rondelles de bananes pour pouvoir en mettre 2 couches l''une sur l''autre. ', 'Disposez-les sur la pâte. ', 'Cassez en petits carrés les morceaux de chocolat au pralin (Carrés de 1 cm.) ', 'Préparez le flan en cassant les oeufs entier dans un saladier, puis battez avec le sucre jusqu''à l''obtention d''une couleur blanchâtre. Ajoutez la crème liquide en continuant de battre la préparation.', 'Puis versez sur les bananes et le chocolat, enfournez pour 30 min.', 'Et régalez-vous!'], ['Casserole', 'Presse-agrumes', 'Planche à découper', 'Passoire'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'crème liquide', 'Tarte banane chocolat pralin', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', ec408ab2-a63e-4d47-8a53-2a83f55e67db, '2025-09-26T15:24:08.448112', [{'ingredient_id': 'b9adc871-3fde-4f84-b244-7d4a52bea348', 'quantite': '1'}, {'ingredient_id': 'de06b43f-dd31-468c-bca0-0930191e29b6', 'quantite': '4'}, {'ingredient_id': 'bf996d3b-b0a4-4294-b181-36d25e91de78', 'quantite': '1'}, {'ingredient_id': 'ca746961-205b-4738-97a2-dd360027d861', 'quantite': '40 cl'}, {'ingredient_id': '91337711-990b-4a06-9363-400b84089163', 'quantite': '2'}, {'ingredient_id': '6379ac28-d1c5-4782-a924-ac0211602a64', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (59066, 'Tarte des Iles', 'pâte feuilletée, pomme, banane, raisins secs, rhum, oeuf, lait, sucre vanillé, noix de coco rapée', '15 min', ['Eplucher et couper les pommes en lamelles. En faire autant avec les bananes.', 'Etaler la pâte feuilletée, couvrir avec les pommes puis avec les rondelles de bananes.', 'Ajouter les raisins secs que l''on a préalablement fait tremper dans le rhum.', 'Casser trois oeufs, ajouter le sucre vanillé, le lait, le reste du rhum dans lequel ont trempé les raisins et un peu de noix de coco râpée. Battre le tout et verser sur la tarte.', 'Mettre au four thermostat 7 (210°C) pour 30 à 35 minutes.'], ['Verre doseur', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'pâte feuilletée', 'sucre vanillé', 'pomme', 'Tarte des Iles', 'raisins secs', 'lait', 'cocktail'], 'Dessert', bf76cc91-bb57-42be-b948-96aad1f4b0cf, '2025-09-26T15:24:12.011878', [{'ingredient_id': 'ce650b84-6624-4c72-907b-59af60e7bfd6', 'quantite': '1'}, {'ingredient_id': '1335b0b6-93b3-454a-be90-4ce0360a926b', 'quantite': '4'}, {'ingredient_id': '33488cdc-6100-42d5-b6d6-6e26b073157c', 'quantite': '3'}, {'ingredient_id': '209c4dde-2311-4b7e-a12a-e0c521f86e0e', 'quantite': '1'}, {'ingredient_id': 'f60da8ad-bfbe-43ed-9496-e820b705e370', 'quantite': ''}, {'ingredient_id': '497f71e6-0df8-442a-8fdd-dbdc9fc53aa7', 'quantite': ''}, {'ingredient_id': '6bb5198d-70f6-46ae-b77f-dc62d87aae52', 'quantite': ''}, {'ingredient_id': '86ae4fe6-a072-42cd-88e2-491dd7e0d491', 'quantite': '2'}, {'ingredient_id': 'c580113c-ef6b-4a65-a657-48a3f13604a1', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66065, 'Bananes givrées aux kiwis', 'banane, kiwi', '10 min', ['Coupez les bananes en deux dans la longeuur, et évidez-les sans ambîmer la peau.', 'Prenez quatre kiwis et évidez-les également.', 'Dans un mixeur, mettez la chair des bananes et des kiwis. Mixez le tout et reversez cette mixture dans les coques de bananes.', 'Puis mettez les banane au congélateur jusqu''à ce que la préparation ait durcie (1h environ).', 'Sortez-les du congélateur et laissez-les se ramollir 5 min avant de déguster.'], ['Balance de cuisine', 'Moule à tarte', 'Mixeur', 'Couteau de chef', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'Bananes givrées aux kiwis', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:24:15.555014', [{'ingredient_id': '952a465a-44ee-420c-add1-a6396095c3b6', 'quantite': '2'}, {'ingredient_id': 'dc1214bd-5428-47dc-95cf-ed21c82d7213', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57785, 'Gâteau à la banane léger et simple d''Anaïs', 'oeuf, farine, sucre, sucre vanillé, levure, beurre, banane, rhum, moules', '25 min', ['Préchauffer le four à 150°C (thermostat 5).', 'Faire fondre le beurre, y ajouter le sucre, la farine, la levure et les oeufs.', 'Couper 5 bananes en fines rondelles puis les écraser afin de les ajouter à la préparation avec la cuillère de rhum.', 'Couper en fines rondelles, les 2 bananes restantes puis les disposer en rosace dans le moule à tarte après l''avoir beurré et versé la préparation.', 'Enfourner pour 40 minutes de cuisson.', 'Puis retourner sur un plateau après sa cuisson, une rosace sera présente sur le dessus du gâteau !!!!', 'Bon appétit, servir avec une boule de glace à la vanille !!!'], ['Presse-agrumes', 'Moule à tarte', 'Râpe', 'Mixeur', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'Gâteau à la banane léger et simple d''Anaïs', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'moules', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'gâteau à la banane', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:24:20.265400', [{'ingredient_id': '4fa3bf98-2a58-4d58-9a9b-d573e426c6a7', 'quantite': '4'}, {'ingredient_id': 'c74461f5-2536-494d-ab8c-6ba9f7c549c5', 'quantite': '200 g'}, {'ingredient_id': 'fe550765-f731-4566-a9bc-c20b7e6d1392', 'quantite': '130 g'}, {'ingredient_id': '498cd9ac-8423-44ff-aa5e-6e2561ac956b', 'quantite': '1'}, {'ingredient_id': '1c23fdc9-bb63-4445-8f74-2bd3b0ac9ee7', 'quantite': '1'}, {'ingredient_id': 'c5502f15-f9b0-4154-90d5-4abc497715a5', 'quantite': '150 g'}, {'ingredient_id': 'd726db09-6796-446a-85f9-8a3d5bcb4baf', 'quantite': '7'}, {'ingredient_id': 'b9be72c0-0635-48fa-9c56-9a5ac4d1d6c7', 'quantite': '1 cuillères'}, {'ingredient_id': '9a473105-fcb4-4f56-917e-2ab75523f2ae', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (69744, 'Coupes de crème aux bananes', 'banane, petit suisse, sucre glace, crème chantilly, chocolat, amandes, pistaches, crème de marrons', '10 min', ['Epluchez les bananes et passez-les au mixer, pour obtenir une pâte sans grumeaux.', 'Ajoutez les petits suisses et le sucre glace, mélangez.', 'Décorez selon votre envie, et mettez les crèmes dans des coupes.', 'Laissez-les au frigo jusqu''au moment de servir.'], ['Râpe', 'Fouet', 'Casserole', 'Verre doseur'], ['', 'amandes', 'crème de marrons', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'petit suisse', 'testées', 'chocolat', 'très facile', 'bon marché', 'rapide', 'plat', 'pistaches', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'Coupes de crème aux bananes', 'dessert', 'plat de résistance', 'sucre glace', 'cocktail'], 'Dessert', 9f1b5999-9c3b-41b3-9d43-2f8115b3adf1, '2025-09-26T15:24:24.424294', [{'ingredient_id': 'bca19568-5d68-4a40-8bea-77aa1b56ad79', 'quantite': '4'}, {'ingredient_id': '5c3d7839-4804-481d-9d8e-7e28e3ad1fa5', 'quantite': '4'}, {'ingredient_id': '2c09b0f3-464c-4269-8de6-c227065ed710', 'quantite': '4 cuillères'}, {'ingredient_id': 'a26940f4-2905-44b1-8eb9-3608707652be', 'quantite': ''}, {'ingredient_id': '1483cbaf-1efd-4a79-b66b-7272e4205c5a', 'quantite': ''}, {'ingredient_id': '3745bf02-08e3-4a2a-8b61-68072350328f', 'quantite': ''}, {'ingredient_id': 'b8c27ee3-57c5-4b63-95dc-09a167e981f1', 'quantite': ''}, {'ingredient_id': 'b7db23fa-6013-4c50-8491-6d5034c6e8d2', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335747, 'Smoothie banane-framboise au lait de riz', 'banane, framboises, lait de riz', '5 min', ['Dans un blender, mélanger les ingrédients et le tour est joué ! ', 'Pour plus de fraîcheur, utiliser des framboises congelées, ou ajouter des glaçons !'], ['Presse-agrumes', 'Économe', 'Fouet'], ['lait de riz', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Smoothie banane-framboise au lait de riz', 'framboises', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:24:28.536945', [{'ingredient_id': '92ab67e1-84ff-478c-8fd2-70ce641b70a7', 'quantite': '2'}, {'ingredient_id': '01d6ad00-3afa-43de-acd3-edb5c55dde36', 'quantite': '200 g'}, {'ingredient_id': '80ff4e10-993f-4a8d-bd38-2fbad6245996', 'quantite': '15 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38874, 'Banofi', 'pâte brisée, banane, lait concentré sucré, crème fraîche liquide, sucre, café en poudre', '20 min', ['Commencer par faire cuire, dans une casserole, la boîte de lait concentré sucré, recouverte d''eau, pendant 3 heures minimum. Il faut que ça prenne la consistance d''une pâte caramélisée. Laisser refroidir.', 'Faire cuire la pâte feuilletée et la laisser refroidir. Une fois froide, étaler la pâte caramélisée à l''intérieur, couper les bananes en deux pour les étaler au-dessus.', 'Fouetter la crème liquide, ajouter un peu de sucre et de café.', 'Etaller le tout, au dessus des bananes, et saupoudrer encore d''un peu de café.'], ['Râpe', 'Passoire', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'Banofi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'crème fraîche liquide', 'cuisine', 'pâte brisée', 'recettes', 'lait concentré sucré', 'boisson', 'café en poudre', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:24:32.112947', [{'ingredient_id': 'dfb095e9-37ee-49a4-9104-b8274503d693', 'quantite': '1'}, {'ingredient_id': '8d8fe017-2e85-4780-a87d-35897cffaa11', 'quantite': '6'}, {'ingredient_id': 'db0fc84a-45ef-489b-b6fb-20a0eaa0432d', 'quantite': '1'}, {'ingredient_id': '7c58bd4e-f2aa-4eb2-bf39-23d27761b414', 'quantite': '2'}, {'ingredient_id': '367cfacd-3527-4bc4-b518-52f92411f371', 'quantite': ''}, {'ingredient_id': '9532a67e-bdfe-495f-92ed-743dd0cb7dbc', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72329, 'Croquant de banane et de fraises', 'fraises, banane, céréale, sucre', '15 min', ['Laver, équeuter, et couper les fraises en petits morceaux, et les mettre dans un bol.', 'Enlever la peau de la banane et la couper en petits morceaux ; les mélanger avec les fraise.', 'Ajouter un peu de sucre si vous ne trouvez pas les fruits assez sucrés. Prendre les céréales, les émietter un peu et les rajouter au mélanges banane-fraises.', 'Déguster !!!'], ['Tire-bouchon', 'Rouleau à pâtisserie', 'Couteau de chef', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Croquant de banane et de fraises', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'céréale', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:24:36.212512', [{'ingredient_id': 'fe417b8e-94a9-4d7e-9b05-4b984b56939c', 'quantite': '12'}, {'ingredient_id': 'f9d30cbb-7e9b-46df-9ecd-7f18c6f325e5', 'quantite': '1'}, {'ingredient_id': 'a96e1a69-1385-49d8-9f59-5ac5cbee4464', 'quantite': '1'}, {'ingredient_id': 'f73a9950-b50c-4f88-9cdd-ae233d6050d5', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14504, 'Gloubi-boulga', 'confiture de fraises, banane, copeaux de chocolat, moutarde de Dijon, saucisse de Toulouse', '5 min', ['Dans un grand saladier vous mélanger de la confiture de fraises, du chocolat râpé, de la banane écrasée, de la moutarde très forte et des saucisses crues mais tièdes, c''est très important.', 'Vous pouvez ajouter quelques anchois,', 'ou un peu de crème Chantilly.', 'A table et bon appétit pour déguster le Gloubi-Boulga.'], ['Mixeur', 'Économe', 'Ouvre-boîte', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Gloubi-boulga', 'bon marché', 'rapide', 'plat', 'recette', 'moutarde de Dijon', 'confiture de fraises', 'cuisine', 'recettes', 'boisson', 'saucisse de Toulouse', 'dessert', 'plat de résistance', 'copeaux de chocolat', 'cocktail'], 'Plat principal', 1266f9d2-717a-4f2c-b8f6-7b9d198b578e, '2025-09-26T15:24:40.618071', [{'ingredient_id': 'a9fde40f-5551-4778-81f2-08cf98cd4b72', 'quantite': ''}, {'ingredient_id': '0600a5c1-dbe4-42d1-90c2-da919a1f2f77', 'quantite': ''}, {'ingredient_id': '16ece55c-f78b-4293-9329-395454ef265d', 'quantite': ''}, {'ingredient_id': '888d63e8-6f18-4b41-8766-0f606333f941', 'quantite': ''}, {'ingredient_id': '5fd63da7-52cf-4a43-8d54-1ec4d8e0cb75', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65677, 'Fondue de guimauve et coulis de fruits rouges', 'framboises, orange, citron, sucre, banane, pomme, poire, guimauve', '20 min', ['Préparer les fruits :', 'Presser l''orange et le citron.', 'Eplucher et couper la banane en rondelles, évider les pommes, les peler et les couper en cubes, de même avec les poires.', 'Faire le coulis :', 'Mixer grossièrement les framboises ou les fruits rouges avec le jus d''orange, le jus de citron et le sucre jusqu''à obtention d''un coulis.', 'Goûtez et ajoutez du sucre si nécessaire.', 'Faire le fondue :', 'Verser le coulis dans un plat creux, ou dans autant de verres qu''il y a de convives, et tremper les morceaux de fruits et de guimauve à l''aide d''une fourchette à fondue.'], ['Rouleau à pâtisserie', 'Tire-bouchon', 'Couteau de chef'], ['guimauve', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'framboises', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'Fondue de guimauve et coulis de fruits rouges', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'citron', 'orange', 'sucre', 'cocktail'], 'Dessert', 4468b2e5-486e-43c5-878b-6e1943159e94, '2025-09-26T15:24:44.851925', [{'ingredient_id': 'c4e3ae4e-a7b9-44fc-8063-b66efc031826', 'quantite': '1 kg'}, {'ingredient_id': 'cf02ec80-382f-4254-b1c6-218e2a00dbb4', 'quantite': '1'}, {'ingredient_id': 'c39e2426-bcf6-4860-8037-58ed50daae02', 'quantite': '1'}, {'ingredient_id': '6f759656-91aa-48f3-907f-3708483cc8b1', 'quantite': '80 g'}, {'ingredient_id': '7cb5c825-5bbb-4ca6-864e-155db3eb77ff', 'quantite': '2'}, {'ingredient_id': 'd6f8a6bb-43a1-4321-9e3b-a4fe3d59a354', 'quantite': '2'}, {'ingredient_id': 'f6bb13b4-d3b2-4c1b-90fd-0ea47ce5a361', 'quantite': '2'}, {'ingredient_id': '28bb2372-de64-4697-a52e-6a34030a8896', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (334331, 'Cake à la banane et au chocolat sans oeufs', 'banane, farine, sel, levure chimique, sucre, sucre vanillé, huile, chocolat', '10 min', ['Préchauffer le four à 180°C (thermostat 6). ', 'Éplucher et couper les bananes. Écraser-les avec une fourchettes ou avec un mixeur. La texture doit presque être liquide.', 'Ajouter le sucre, le sucre vanillé, l''huile. Mélanger bien pour que l''huile soit entièrement incorporée au mélange.', 'Ajouter la farine, la levure chimique et le sel dans le bol et mélanger.', 'Ajouter le chocolat réduit en pépites. Vous pouvez aussi ajouter des noix, des fruits confits...', 'Enfourner dans un moule à cake beurré pour 30 à 35 minutes de cuisson.'], ['Poêle', 'Râpe', 'Rouleau à pâtisserie', 'Casserole', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'chocolat', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'Cake à la banane et au chocolat sans oeufs', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'sucre vanillé', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:24:49.418662', [{'ingredient_id': '87ae07bb-041d-4029-b5ce-a820e662d3c7', 'quantite': '4'}, {'ingredient_id': 'a325bf0b-e2b4-4914-98be-ad10c4b8167c', 'quantite': '180 g'}, {'ingredient_id': '80ce4875-0f1d-47bc-adfa-f466742c0cec', 'quantite': '1'}, {'ingredient_id': 'dc0f2ab1-b936-4d0c-a86e-eee82591687d', 'quantite': ''}, {'ingredient_id': 'ebfd5273-e70a-45ea-9004-ad9d6371eeaa', 'quantite': '50 g'}, {'ingredient_id': '45cef327-87bb-4951-a8a7-25fd49a34f88', 'quantite': '1'}, {'ingredient_id': 'ef691436-3c42-4af8-b2a4-d705b352ef61', 'quantite': '10 cl'}, {'ingredient_id': '9a40e131-8cee-4b81-8b4e-4656037dc2bf', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (172602, 'Curry de poulet exotique', 'oignon, pomme, jambon cru, thym, laurier, ail, sel, poivre, cannelle, cuisse de poulet, tomate, beurre, riz thaï, ananas, orange, banane, lait de coco, noix de coco rapée, arachide, curry, gingembre', '45 min', ['Préparer d''abord le hachis en hachant les oignons avec les pommes sucrées, le jambon cru, de l''ail, du thym, du laurier, de la cannelle, du sel et du poivre.. Faire revenir le tout à feux doux dans un récipient.', 'Dans la cocotte principale, faire revenir ensuite les morceaux de poulet avec du beurre. Ajouter le curry selon convenance, les tomates pelées en petit morceaux et le lait de coco. Verser le hachis sur le poulet et le répartir.', 'Cuire doucement cocotte couverte pendant 40 min.', 'La liaison de la sauce s''obtient par la seule réduction du fond.', 'Faire revenir les fruits coupés en morceaux au beurre. ', 'En garniture, présenter ces fruits, un plat de riz et 2 récipients contenant d''un côté la noix de coco râpée et de l''autre les cacahuètes que vous aurez pris soin de piler.', 'Vous pouvez ôter un bol de sauce et ajouter gingembre et curry pour les bouches épicées.'], ['Fouet', 'Moule à tarte'], ['laurier', 'lait de coco', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'curry de poulet', 'ail', 'tomate', 'plat', 'moyenne', 'jambon cru', 'recette', 'cuisine', 'arachide', 'cuisse de poulet', 'recettes', 'oignon', 'boisson', 'Curry de poulet exotique', 'noix de coco rapée', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'thym', 'beurre', 'orange', 'ananas', 'poivre', 'cannelle', 'riz thaï', 'curry', 'cocktail'], 'Plat principal', be779434-d3a3-4070-b784-dc83d0291ede, '2025-09-26T15:24:53.051857', [{'ingredient_id': '1bcc6755-5b87-4405-8f55-070911bebad5', 'quantite': '2'}, {'ingredient_id': 'c9fb2d71-ab9d-43ec-a2bf-18cb0cda1fdd', 'quantite': '2'}, {'ingredient_id': '2eaf1c09-6172-425b-aded-6c0ac50578fb', 'quantite': '100 g'}, {'ingredient_id': '24d282c1-cdb6-4422-9111-506e4de195a7', 'quantite': ''}, {'ingredient_id': 'a7b9999e-260e-4793-aadc-44dcecba3b12', 'quantite': ''}, {'ingredient_id': 'ef714734-5507-4ee5-af81-5a4be18c1011', 'quantite': ''}, {'ingredient_id': '0baf6f2f-859f-4983-9219-4ba146063ac4', 'quantite': ''}, {'ingredient_id': 'dc4cff93-6413-462f-99d4-36d12983ca39', 'quantite': ''}, {'ingredient_id': '87ada6de-1a97-466a-8bd7-c911e9f7f732', 'quantite': ''}, {'ingredient_id': '9efa31cb-19e5-4966-aed3-3eee9c340f62', 'quantite': '4'}, {'ingredient_id': '532a293e-177b-40ba-9d6c-abeedd7429f7', 'quantite': '2'}, {'ingredient_id': '21f1fd2d-2939-4ec1-99a4-7c95829ae860', 'quantite': ''}, {'ingredient_id': '516367e3-45dc-4bf8-a5eb-50dfa0023894', 'quantite': '240 g'}, {'ingredient_id': 'c4a1a41e-0ac8-4775-9e1a-b86ca4c743ce', 'quantite': '1'}, {'ingredient_id': '33da067c-2bad-4eb9-8df2-3159f9ce1870', 'quantite': '2'}, {'ingredient_id': '368f063d-430a-4782-92ff-64ff2471ce2f', 'quantite': '2'}, {'ingredient_id': '58649026-b027-459e-8445-18cf44fe3ef6', 'quantite': '20 cl'}, {'ingredient_id': '3ffcbafd-4353-4b81-91f2-18cfe4573cd5', 'quantite': ''}, {'ingredient_id': 'a5a31e97-6dd5-4ee3-a9a9-daee24e98be0', 'quantite': ''}, {'ingredient_id': '25c20848-1380-4200-92ee-1b409e996ea0', 'quantite': ''}, {'ingredient_id': '16a2bf32-066b-4cf6-87a2-a7ba4792f842', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26148, 'Crème de yaourt au chocolat et banane', 'banane, extrait de vanille liquide, chocolat, lait, sucre semoule, sucre vanillé, crème fraîche, yaourt', '20 min', ['Mettre le chocolat à fondre avec le lait dans une casserole à feu très doux.', 'Pendant ce temps, éplucher puis détailler les bananes en rondelles et les mettre à mariner dans un peu d’eau avec un peu de sucre vanillé.', 'Lorsque le chocolat devient lisse, incorporer les yaourts et le sucre semoule sans cesser de fouetter vivement.', 'Dans un saladier, battre la crème fraîche épaisse avec le reste du sucre vanillé et réserver cette crème.', 'Verser ensuite les yaourts chocolatés dans des coupes individuelles, avec une cuillère de crème vanillée sur le dessus et décorer de rondelles de bananes.', 'Réserver au frais pendant 3 h et déguster.', 'Vous pouvez également remplacer les yaourts par du fromage blanc et les bananes par des éclats d''amande.'], ['Fouet', 'Râpe', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'yaourt', 'extrait de vanille liquide', 'confiserie', 'testées', 'chocolat', 'facile', 'rapide', 'plat', 'Crème de yaourt au chocolat et banane', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'dessert', 'plat de résistance', 'crème au chocolat', 'sucre vanillé', 'moyen', 'lait', 'cocktail'], 'Dessert', 451f42c1-d752-40cd-abf8-f6432e1747ef, '2025-09-26T15:24:57.189686', [{'ingredient_id': '7b0e86d9-22b9-441d-b5c7-0d066c16aee7', 'quantite': '2'}, {'ingredient_id': '6c60c512-11d9-4399-ad93-01d5a5b6416e', 'quantite': '1 cuillères'}, {'ingredient_id': 'ff7b104c-988a-4ea8-8c20-dfc465acc9e3', 'quantite': '100 g'}, {'ingredient_id': '951b0f10-a119-4f47-9f02-6a3fa5334ccf', 'quantite': '20 cl'}, {'ingredient_id': 'd9ffb777-6f61-4962-a17b-88bafc0f38ca', 'quantite': '100 g'}, {'ingredient_id': 'cc69680e-a5f5-437c-8075-561193b14b4b', 'quantite': '1'}, {'ingredient_id': '46cc5c5c-ee75-4213-b034-79b00df3f3ec', 'quantite': '75 g'}, {'ingredient_id': 'f8dfe300-9925-4585-a708-a92fb5155ef9', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (172906, 'Cocktail vitalisant à la Spiruline', 'spiruline, jaune d''oeuf, jus de banane, miel, eau', '5 min', ['Sortir la spiruline des gélules et la placer dans un shaker.', 'Dans le shaker, ajouter le jaune d''oeuf et mélanger avec la spiruline.', 'Ajouter le jus de banane, le miel et un peu d''eau.', 'Agiter, c''est prêt !', 'A déguster frais.'], ['Rouleau à pâtisserie', 'Ouvre-boîte'], ['', 'Cocktail vitalisant à la Spiruline', 'entrée', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'jaune d''oeuf', 'jus de banane', 'recette', 'cuisine', 'miel', 'recettes', 'spiruline', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:25:00.702404', [{'ingredient_id': '01661f93-34f5-483e-b3aa-477ebc273c1b', 'quantite': '4'}, {'ingredient_id': 'e9561e81-9448-4f9a-96fd-3ed5a42b2cf6', 'quantite': '1'}, {'ingredient_id': 'e9569e0c-b32e-4341-8e51-3b550bcde5e2', 'quantite': '1'}, {'ingredient_id': '0693ffaf-1f40-41d0-9a1d-2443e086ff7b', 'quantite': '1 cuillères'}, {'ingredient_id': '4cbb9d7a-98e1-4d40-9bfc-91009dae3a1c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11263, 'Salade de fruits et sorbet au basilic', 'melon, mangue, banane, pêche, fraise des bois, orange, sucre vanillé, rhum, basilic, citron vert, basilic, sucre', '20 min', ['Préparez le sorbet : portez 50 cl d''eau à ébullition.', 'Hors du feu, ajoutez le zeste râpé de 2 citrons et les feuilles de basilic. Couvrez et laissez infuser 15mn. Filtrez.', 'Faites chauffer de nouveau l''eau avec le sucre et le jus des trois citrons verts pendant 5 min. Laissez refroidir.', 'Versez dans une sorbetière et placez-la au congélateur.', 'Entre-temps, plongez les pêches 30 secondes dans une casserole d''eau bouillante et pelez-les.', 'Pelez la banane et la mangue.', 'Coupez le melon en quatre.', 'Otez les pépins et prélevez la chair.', 'Mélangez délicatement et réservez 1 h au réfrigérateur.', 'Détaillez tous ces fruits en petits dés. Placez-les dans un saladier. Versez le jus de l''orange et le rhum. Saupoudrez de sucre vanillé.', 'Au moment de servir, répartissez la salade de fruits dans six assiettes à dessert. Parsemez des fraises des bois. Posez 1 boule de sorbet au centre et parsemez des feuilles de basilic ciselées.'], ['Économe', 'Presse-agrumes'], ['melon', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'Salade de fruits et sorbet au basilic', 'rapide', 'plat', 'mangue', 'basilic', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'sorbet', 'dessert', 'plat de résistance', 'fraise des bois', 'sucre vanillé', 'moyen', 'orange', 'pêche', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:25:04.309071', [{'ingredient_id': '32436604-60c8-4439-a706-cbe964d862ec', 'quantite': '1'}, {'ingredient_id': 'bc818b35-b2a9-41dd-ac2a-370d816a9457', 'quantite': '1'}, {'ingredient_id': 'c048470b-1de5-440e-bf3c-91dea8141365', 'quantite': '1'}, {'ingredient_id': '683e68cd-82e8-458f-a3b4-d00b35c326fc', 'quantite': '2'}, {'ingredient_id': '7e5facd6-dea6-46b8-bdff-f35fa4372cdf', 'quantite': '250 g'}, {'ingredient_id': '8b348b9a-3212-44d1-bf8b-da3b7de6b6e2', 'quantite': '1'}, {'ingredient_id': '769ed269-394f-443c-bba7-f230f1103f68', 'quantite': '7.5 g'}, {'ingredient_id': '7c4d72e7-e044-48b7-bae9-9147382ca340', 'quantite': '5 cl'}, {'ingredient_id': '9cd548fb-65ba-4fa8-8cfb-cd40db51424a', 'quantite': '2'}, {'ingredient_id': '3aabdad1-3737-496b-9c7f-cda3bacd2e37', 'quantite': '3'}, {'ingredient_id': '5a4e8b3a-bf18-4383-aadc-ee9ab1502397', 'quantite': '1'}, {'ingredient_id': '00a4ce3c-c3e9-447d-b8e9-11e383051448', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15763, 'Pudding banane et noix de coco (super facile!)', 'baguette, lait, sucre, oeuf, noix de coco, banane', '25 min', ['Coupez dans un saladier des morceaux de pain rassis, puis arrosez avec le lait bouillant.', 'Laissez le pain gonfler et tout absorber le lait(si le lait est absorbé et que le pain est encore dur ajoutez du lait). Ecrasez à la fourchette ou mixez.', 'Incorporez le sucre, les oeufs battus et la noix de coco. Ajoutez ensuite les bananes coupées en rondelles.', 'Mettez dans un moule et cuisez environ 45 min à four moyen (thermostat 6 / 180°C).'], ['Tire-bouchon', 'Économe', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Pudding banane et noix de coco (super facile!)', 'pudding', 'dessert', 'plat de résistance', 'baguette', 'noix de coco', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:25:08.955455', [{'ingredient_id': '10af03cd-2e3f-4a32-9dbd-4c0f495f6838', 'quantite': '1'}, {'ingredient_id': '83b7b114-063b-4311-bef7-b231f166e679', 'quantite': '50 cl'}, {'ingredient_id': 'ff7d89a4-029e-4ab5-b0f3-b0f3868a24d8', 'quantite': '100 g'}, {'ingredient_id': '40eabb89-ea1b-44c4-a112-ec7a0202de0c', 'quantite': '3'}, {'ingredient_id': 'ef2595a7-a9fa-4682-be59-5b69742479e7', 'quantite': '100 g'}, {'ingredient_id': '7402fe06-194d-4b3c-9c62-e4b56241328d', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57530, 'Gâteaux à l''avoine et à la banane sans oeufs', 'farine, flocons d''avoine, sucre, beurre, banane, chocolat noir', '5 min', ['Mélanger la farine les flocons d''avoine et le sucre.', 'Faire fondre le beurre, et l''ajouter au mélange précédent, bien mélanger pour obtenir une pâte homogène.', 'Ajouter la banane écrasée.', 'Raper le chocolat (ou le broyer au mixeur) et l''ajouter au mélange.', 'Verser la préparation dans des petits moules à gateaux et faire cuire thermostat 5 (150°C) 25 minutes environ (plus ou moins selon la taille de vos moules).', 'Vous pouvez varier les ingrédients à loisir: raisins secs, cannelle, noix de coco, noisettes...', 'Laisser paler votre imagination!'], ['Casserole', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'Gâteaux à l''avoine et à la banane sans oeufs', 'chocolat noir', 'beurre', 'sucre', 'flocons d''avoine', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:25:12.457270', [{'ingredient_id': '8b0a884f-6303-4021-afcd-1240b569150b', 'quantite': '5 cuillères'}, {'ingredient_id': '978a056d-c480-474b-9edc-530a78d23540', 'quantite': '5 cuillères'}, {'ingredient_id': 'ba321809-46ca-4926-ab3d-b3511aad2f49', 'quantite': '5 cuillères'}, {'ingredient_id': 'f393aa29-f5c8-48c3-8035-9af11d34f373', 'quantite': '100 g'}, {'ingredient_id': '0dc27860-1b47-4ccc-ac8b-c6f16776d423', 'quantite': '1'}, {'ingredient_id': '60997797-d63a-436e-966d-324eff1b69b2', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22579, 'papillotes de bananes', 'banane, brick, quatre-épices, caramel, rhum', '10 min', ['Préchauffer votre four Th 6. ', 'Epluchez et coupez les bananes en 2. ', 'Les saupoudrer de mélange 4 épices. ', 'Les rouler dans les feuilles de brick sous forme de nem. ', 'Les enfourner Th 4. ', 'Pendant que les papillotes cuisent, faites chauffer le caramel tout en veillant à ce qu''il reste + ou - liquide. ', 'Une fois les papillotes dorées, les servir dans une assiette par 2 . ', 'Faites flamber le caramel au rhum et versez cette sauce sur les papillotes. ', 'Servir chaud.'], ['Presse-agrumes', 'Batteur électrique', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'caramel', 'bon marché', 'papillotes de bananes', 'plat', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'quatre-épices', 'cocktail'], 'Dessert', ef9066fc-c181-4afe-9b77-c89f3597b87c, '2025-09-26T15:25:15.979651', [{'ingredient_id': '46531346-dd55-4062-bf10-61b6538834a4', 'quantite': '4'}, {'ingredient_id': '3986e46b-2a04-4dc6-857e-6fc65ed77694', 'quantite': '8'}, {'ingredient_id': '58da2827-ec90-4664-a665-a8f272799ab3', 'quantite': ''}, {'ingredient_id': '22d5d21e-ca7d-4e51-8ade-d4cd361aa83b', 'quantite': ''}, {'ingredient_id': '98d89a9f-d653-403f-bf53-1ddf1dfc2dc2', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (371299, 'Banana bread aux pépites de chocolat, sans gluten !', 'banane, oeuf, beurre, lait, farine de riz, maïzena, amandes en poudre, sucre roux, levure, extrait de vanille, sel, chocolat', '15 min', ['Écraser ou mixer les bananes jusqu''à ce qu''elles deviennent comme "liquides".', 'Battre les œufs avec le sucre, puis ajouter le mélange aux bananes.', 'Ajouter les ingrédients "secs" : les 2 farines, la levure, la poudre d''amande, les pépites et la pincée de sel. Mélanger.', 'Ajouter les ingrédients "humides" : le lait, le beurre fondu et l''extrait de vanille. Mélanger.', 'Enfourner 45 minutes à 175°C (thermostat 6). 
La lame du couteau doit ressortir légèrement humide pour qu''il soit bien moelleux.'], ['Couteau de chef', 'Moule à tarte', 'Mixeur', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'farine de riz', 'confiserie', 'testées', 'extrait de vanille', 'chocolat', 'très facile', 'sans gluten !', 'maïzena', 'bon marché', 'amandes en poudre', 'oeuf', 'plat', 'recette', 'Banana bread aux pépites de chocolat', 'cuisine', 'levure', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'gâteau au chocolat', 'lait', 'cocktail', 'sucre roux'], 'Dessert', e70a4f76-f3df-449c-9ac0-2797e15dce27, '2025-09-26T15:25:19.473123', [{'ingredient_id': 'feac9f6f-22e9-4642-a0f2-b8621d530473', 'quantite': '4'}, {'ingredient_id': 'bdcd3c49-ad00-4f40-8c54-260c351d1aa1', 'quantite': '3'}, {'ingredient_id': 'ef8c3c73-4312-4fdf-9721-193c74e7d49d', 'quantite': '80 ml'}, {'ingredient_id': 'f379b695-2d74-4169-98cb-c2f86ef2b33b', 'quantite': '80 ml'}, {'ingredient_id': '58565e1b-0aa4-4c07-93a3-854102efd5f0', 'quantite': '150 g'}, {'ingredient_id': '3aa47fe6-7030-498c-9ee3-a7eb3067ff02', 'quantite': '130 g'}, {'ingredient_id': 'c7281702-dda5-4cdd-8e1c-0e03f90c9c96', 'quantite': '80 g'}, {'ingredient_id': '4d980d0a-9f76-4ecb-8cf1-99d7c203a33f', 'quantite': '80 g'}, {'ingredient_id': '22b82c28-6828-4690-91d4-6edec9a130f3', 'quantite': '2'}, {'ingredient_id': 'd2863673-9912-4ab9-a086-96cf741b80ff', 'quantite': '2 cuillères'}, {'ingredient_id': '6ae00c36-e923-424b-8779-74bb9640b074', 'quantite': '1'}, {'ingredient_id': '7f104abc-b32c-4c4b-81d0-17a7e674b9c2', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (67674, 'Crumble soirée filles', 'banane, framboises, chocolat, farine, beurre, cassonade, amandes en poudre, cannelle, noix de coco', '15 min', ['Disposer dans un plat allant au four : les framboises, les 3 bananes coupées en rondelles, les pépites de chocolat.', 'Préparer la pâte à crumble : mélanger la farine, la cassonade, le beurre mou, la poudre d''amande et la cannelle.', 'Emietter le mélange sur les fruits, ajouter la noix de coco.', 'Faire cuire 30 minutes au four à 180-200°C (thermostat 6-7). Servir chaud ou tiède c''est meilleur !'], ['Rouleau à pâtisserie', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'chocolat', 'très facile', 'framboises', 'bon marché', 'amandes en poudre', 'plat', 'recette', 'Crumble soirée filles', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'autres crumbles', 'beurre', 'cannelle', 'noix de coco', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:25:22.990030', [{'ingredient_id': '6c03bb38-79d1-49ab-a433-16421ea80109', 'quantite': '3'}, {'ingredient_id': '3ff290f7-65b3-4e82-8c89-57b71e0ae463', 'quantite': '250 g'}, {'ingredient_id': 'fc8effa4-b823-4faa-9895-a833991ee6a8', 'quantite': '100 g'}, {'ingredient_id': 'ec0819f3-b239-471b-b6bb-ab393dfcc9c5', 'quantite': '100 g'}, {'ingredient_id': '4d8d736d-e261-4322-b8bb-257a69da2fa7', 'quantite': '100 g'}, {'ingredient_id': '67cb04b8-24bf-440c-9446-87760d5d776a', 'quantite': '100 g'}, {'ingredient_id': '0a10d787-579c-4031-9576-eb7136d8bd4f', 'quantite': '50 g'}, {'ingredient_id': '69ce289e-634e-4f94-b9cb-ab633429c4d5', 'quantite': '1 cuillères'}, {'ingredient_id': '9f42bc21-a03c-404f-9881-4c4720b58a45', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27294, 'bananes au chocolat façon scout', 'banane, chocolat noir', '5 min', ['Coupez les bananes en rondelles. ', 'Les mettre sur une poêle avec le chocolat coupé en carrés. Laisser cuire jusqu''à ce que ce soit chaud et que ça sente bon. '], ['Rouleau à pâtisserie', 'Pince de cuisine', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'cocktail', 'bananes au chocolat façon scout'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:25:26.577426', [{'ingredient_id': 'a2db429b-733c-4302-9869-acec9ae04535', 'quantite': '8'}, {'ingredient_id': '599fa1e0-3797-40c1-887a-3c54ba35c02f', 'quantite': '2.5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (328169, 'Mon feuilleté de banane facile', 'pâte feuilletée, banane, crème fraîche, cassonade, jaune d''oeuf', '5 min', ['Sortez une plaque du four et préchauffez-le à 180°C en chaleur tournante (thermostat 6). ', 'Pelez les bananes et les réduire en purée en les écrasant à la fourchette dans un bol. ', 'Ajoutez une cuillère à soupe de cassonade et une cuillère à café de crème fraîche. Mélangez. ', 'Étalez votre pâte feuilletée et découpez-la en 4 morceaux, façonnez chacun d''eux en carré. Au centre de chaque carré, mettre 2 ou 3 cuillères à soupe de votre purée de banane et refermez vos carrés en rejoignant les 4 coins vers le centre, puis fermez les parois aux doigts. ', 'Dans un petit bol, mélanger le jaune d’œuf avec une cuillère à soupe de cassonade et une cuillère à café de crème fraîche. Mélangez au pinceau et badigeonnez généreusement vos feuilletés de cette préparation. ', 'Disposez vos 4 feuilletés sur la plaque froide du four sur du papier sulfurisé. ', 'Enfournez 15 à 25 min (selon la puissance de votre four) à 180° (thermostat 6).', 'Les feuilletés doivent être bien dorés.', 'Servez tiède.', 'Bon appétit !'], ['Verre doseur', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'Mon feuilleté de banane facile', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'cocktail'], 'Dessert', f199135e-e9db-4b85-99db-70ea5d2b91ef, '2025-09-26T15:25:30.020916', [{'ingredient_id': '10ad0a93-cbf9-4bde-9ad6-f8bf9611a254', 'quantite': '1'}, {'ingredient_id': '22bd3cee-20e9-441a-9051-adf7c86d24ef', 'quantite': '2'}, {'ingredient_id': 'f36b6695-bcf6-40af-be7f-476ae93bef73', 'quantite': '2 cuillères'}, {'ingredient_id': 'e27b90ae-1f98-445b-8260-02d3944f3b0b', 'quantite': '2 cuillères'}, {'ingredient_id': 'e2058c90-ec47-4b04-b66c-ed579e8e2105', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (173809, 'Smoothie aux fruits exotiques', 'ananas, fruit de la passion, kiwi, banane, glace pilée, menthe, citron vert', '15 min', ['Épluchez l''ananas et coupez-le en morceaux.', 'Versez les morceaux dans le bol d''un mixer.', 'Ajoutez l''intérieur du fruit de la passion, le jus de citron, les kiwis épluchés, la banane en morceaux, la glace pilée et 2 feuilles de menthe.', 'Mixez le tout pour obtenir un délicieux smoothie.'], ['Spatule', 'Moule à tarte', 'Passoire'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'Smoothie aux fruits exotiques', 'confiserie', 'testées', 'très facile', 'menthe', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'fruit de la passion', 'dessert', 'plat de résistance', 'moyen', 'ananas', 'citron vert', 'smoothies', 'cocktail', 'glace pilée'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:25:34.153683', [{'ingredient_id': '5081284c-1332-42de-8729-5b85b655e2ff', 'quantite': '1'}, {'ingredient_id': 'db322f28-d74c-4c1a-a310-e5d807665ce7', 'quantite': '1'}, {'ingredient_id': '610f0c3e-0bff-43bc-a1dc-888de170d5ca', 'quantite': '2'}, {'ingredient_id': '730762c8-9672-4e80-a196-fcfb6f7f604e', 'quantite': '1'}, {'ingredient_id': 'fcf4b911-9fb7-48fb-a9c3-96ff6ea5791e', 'quantite': '4 cuillères'}, {'ingredient_id': '35d4cac1-76a4-4c97-9e3c-571446488a37', 'quantite': '2'}, {'ingredient_id': '6e22669a-75c0-4f66-b907-ddc118e6f0cb', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (340753, 'Coupe de fruits et de biscuits au chocolat', 'biscuit, banane, clémentine, prune, pomme, chocolat noir', '15 min', ['Couper la banane en rondelles, la prune et la pomme en quartiers (même forme qu''un segment de clémentine).', 'Dans chacune des coupes, disposer les ingrédients comme suit :', '2 barquettes à la fraise séparées par 3 rondelles de banane. D''un côté mettre deux quartiers de pomme et de l''autre 3 "quartiers" de prune. Disposer 3 morceaux de clémentine sur les bananes.', 'Faire fondre le chocolat au bain-marie et en recouvrir les fruits.'], ['Économe', 'Balance de cuisine', 'Couteau de chef', 'Pince de cuisine', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'Coupe de fruits et de biscuits au chocolat', 'autres biscuits et petits gâteaux', 'prune', 'rapide', 'plat', 'biscuit', 'recette', 'cuisine', 'recettes', 'boisson', 'clémentine', 'dessert', 'plat de résistance', 'chocolat noir', 'pomme', 'cocktail'], 'Dessert', fb6d469e-2fe4-428d-9b7a-37d8a2e76c4d, '2025-09-26T15:25:38.401566', [{'ingredient_id': '58c8f65d-c9f9-4d8a-b5b5-83db723d7c5b', 'quantite': '1'}, {'ingredient_id': '857f3279-a486-4b23-ba89-81ebe2a3c3c5', 'quantite': '1'}, {'ingredient_id': '7bc160cb-7481-4edb-bc65-76c81e884918', 'quantite': '2'}, {'ingredient_id': '6309c181-e165-43e2-88c8-4c75aca80128', 'quantite': '1'}, {'ingredient_id': 'c70d9208-eb80-4d7a-ac26-ba52b3ad5cb9', 'quantite': '1'}, {'ingredient_id': '168f44e5-19bd-4ba1-b7c8-818e1e368d57', 'quantite': '120 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (60189, 'Croustillant pommes-bananes', 'pomme, cannelle, beurre, sucre en poudre, rhum, banane, brick', '10 min', ['Eplucher et enlever les pépins des pommes, puis les couper en dés grossiers.', 'Faire fondre 35 g de beurre dans une sauteuse ou dans une poêle.', 'Quand le beurre est fondu, faire dorer les pommes pendant 5 minutes, ajouter la cannelle puis le sucre, bien mélanger et laisser revenir. ', 'Au bout de 2-3 minutes, ajouter le rhum et flamber les pommes, une fois flambées, laisser sur feu moyen pendant 10 minutes.', 'Couper des rondelles de bananes et les réserver.', 'Faire fondre 15 g de beurre.', 'Badigeonner les feuilles de brick de beurre fondu.', 'Dans un plat antiadhésif, étaler les feuille de brick et mettre un petit tas de pommes caramélisées et de rondelles de bananes au centre.', 'Refermer les feuilles de brick en les repliant par le haut et en faisant tenir par un curre-dent.', 'Enfourner à four préchauffé à 210°C (thermostat 7) pendant 5 minutes juste avant de servir.'], ['Moule à tarte', 'Balance de cuisine', 'Pince de cuisine', 'Casserole', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'Croustillant pommes-bananes', 'plat', 'sucre en poudre', 'recette', 'brick', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:25:42.588242', [{'ingredient_id': 'b9a478fa-e4e2-44c6-a840-e62d49783497', 'quantite': '1 g'}, {'ingredient_id': 'f1ac67a8-fdb2-475a-ae47-364a1e86f582', 'quantite': '5 g'}, {'ingredient_id': 'd31c5e63-8000-4116-8696-8b9e1f93d5c6', 'quantite': '50 g'}, {'ingredient_id': 'e9205207-af6f-405c-bb7c-cd9591361810', 'quantite': '100 g'}, {'ingredient_id': 'cee36603-b4a1-4059-9f70-8c68748b53ed', 'quantite': '5 cl'}, {'ingredient_id': 'eeb6f16d-74ff-471b-a799-1eed72f82587', 'quantite': '2'}, {'ingredient_id': '5957f4d1-698d-4d45-b42f-044e7ddecbec', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66728, 'Tarte flambée banane chocolat', 'fond, crème fraîche, fromage blanc, banane, chocolat pâtissier, sucre, glace vanille, beurre', '15 min', ['Allumer le four à 250°C (thermostat 8-9).', 'Couper les bananes en rondelles d''un cm d''épaisseur et les faire revenir rapidement dans la poêle avec deux noisettes de beurre.', 'Etaler le fond de tarte flambée sur une plaque allant au four. Mélanger la crème, le fromage blanc et la cassonade. Etaler ce mélange sur le fond de tarte.', 'Disposer les rondelles de banane sur la tarte flambée. Passer au four très chaud pendant 5 min.', 'Pendant ce temps, faire fondre le chocolat. Dès la sortie du four, faire couler le chocolat fondu sur la tarte flambée en dessinant par exemple une spirale.', 'Ajouter une boule de glace vanille sur la préparation encore chaude.', 'Déguster aussitôt!!!'], ['Pince de cuisine', 'Couteau de chef', 'Fouet', 'Ouvre-boîte', 'Presse-agrumes'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'glace vanille', 'Tarte flambée banane chocolat', 'fond', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:25:46.129172', [{'ingredient_id': '3c7d84f1-f0cf-4834-b2ce-bb9feb660da3', 'quantite': '1'}, {'ingredient_id': '3a89d1be-ef06-4235-9613-357a769dd824', 'quantite': '10 cl'}, {'ingredient_id': '46c95940-a1a7-4180-8bdc-5524b7139e50', 'quantite': '10 cl'}, {'ingredient_id': '600cfe1d-738d-4759-a08c-3d63ff2231c0', 'quantite': '2'}, {'ingredient_id': '5c9d26df-1cfa-4169-a4c9-75abd1025f62', 'quantite': '100 g'}, {'ingredient_id': 'e6c6ddd7-da04-4abc-9491-cb621d9cfe48', 'quantite': '50 g'}, {'ingredient_id': '9bbd6538-66a6-470c-81ce-d529ffada356', 'quantite': ''}, {'ingredient_id': '6f181272-ead3-4187-8956-183f4d8c4a18', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (41241, 'Biscottes aux bananes', 'biscotte, beurre, sucre de canne, banane, cannelle', '15 min', ['Pelez les banaces et coupez-les en rondelles pas trop fines.', 'Beurrez vos biscottes. ', 'Disposez les rondelles sur les biscottes (souvent je dispose 4 rondelles + une par dessus, tout cela par biscotte).', 'Saupoudez de sucre de canne.', 'Disposez dans un moule type moule à tarte et passez au grill 10 min (en surveillant la cuisson). ', 'Attendre que les biscottes prennent une coloration dorée...', 'Se déguste tiède ou frois, se conserve un jour ou deux au refrigérateur.'], ['Planche à découper', 'Moule à tarte', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'Biscottes aux bananes', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'dessert', 'plat de résistance', 'beurre', 'biscotte', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:25:49.764549', [{'ingredient_id': '6320b6c9-1b48-4a76-ac55-97f875be7983', 'quantite': '8'}, {'ingredient_id': 'ccf6d2c3-3a06-4834-8641-c23b9c667abb', 'quantite': '25 g'}, {'ingredient_id': 'fefea594-1724-4af1-b40a-f788729f6ba6', 'quantite': '50 g'}, {'ingredient_id': '44fa403c-eb33-4d81-9c72-a2dbbc35440f', 'quantite': '4'}, {'ingredient_id': '14f3b72f-65f4-4436-85c8-9aa1a37acdb4', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36711, 'Biscuit du soleil à la banane', 'farine, beurre tendre, sucre, oeuf, banane, lait, cannelle, café, sel, café, rhum', '15 min', ['Préchaufer le four à 150°C-175°C (thermostat 5-6).', 'Travailler le beurre et le sucre.', 'Ajouter les oeufs battus en omelette et bien mélanger.', 'Eplucher et écraser les bananes, les incorporer au mélange en alternant avec la farine.', 'Ajouter la levure, le sel, la cannelle, la vanille, le lait, et éventuellement le rhum.', 'Verser dans un moule à cake.', 'Faire cuire environ 45 min.'], ['Casserole', 'Spatule', 'Verre doseur', 'Pince de cuisine', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'beurre tendre', 'très facile', 'bon marché', 'autres biscuits et petits gâteaux', 'oeuf', 'plat', 'recette', 'café', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'Biscuit du soleil à la banane', 'cannelle', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:25:53.394147', [{'ingredient_id': '786c2e88-1f3f-4204-ae1a-00b70cf4d571', 'quantite': '225 g'}, {'ingredient_id': '97d69df0-c04a-496d-a801-06335faf5d03', 'quantite': '125 g'}, {'ingredient_id': '930a291e-906f-46a0-91da-180942c71f06', 'quantite': '325 g'}, {'ingredient_id': 'e259f1de-7412-476a-9c92-6b48117deb88', 'quantite': '2'}, {'ingredient_id': '9f971841-5243-4230-8a84-4fb5b00e2706', 'quantite': '3'}, {'ingredient_id': 'ad548d93-a665-493e-a7dd-857ba3ce89bb', 'quantite': '3 cuillères'}, {'ingredient_id': '7ed4e427-c4fe-469f-928b-937e11a01ebe', 'quantite': '1 cuillères'}, {'ingredient_id': 'c55955c9-b6df-4299-84d3-38893769bc6a', 'quantite': '1 cuillères'}, {'ingredient_id': 'a2a03606-ef3e-4f8c-8cbf-8ec849593c8e', 'quantite': '1'}, {'ingredient_id': '15acea2e-cb6f-489a-a291-045d14f0ade5', 'quantite': '1 cuillères'}, {'ingredient_id': '8cf2359c-c042-497d-8d64-1daf645b93fc', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (94541, 'Poulet sucré salé pomme-banane', 'cuisse de poulet, ail, oignon, tomate, banane, pomme, coulis de tomate, curry, maïzena, huile d''olive, eau, crème épaisse, sel', '20 min', ['-faire revenir les cuisses de poulet et l''oignon dans l''huile d''olive.', '- ajouter le curry puis les tomates coupées en dés.', '- ajouter les pommes et les bananes pelées et coupées en morceaux', '- verser le coulis de tomates et ajouter l''ail.', '- ajouter la maïzena puis le verre d''eau.', '- saler.', '- mélanger et laisser mijoter à couvert et à feu doux environ 40 min en remuant de temps en temps.', '-avant de servir et hors du feu ajouter la crème et bien mélanger.', 'A déguster avec du riz ou de la semoule.'], ['Râpe', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'eau', 'testées', 'facile', 'maïzena', 'bon marché', 'ail', 'tomate', 'plat', 'recette', 'Poulet sucré salé pomme-banane', 'cuisine', 'recettes', 'cuisse de poulet', 'oignon', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'pomme', 'coulis de tomate', 'curry', 'crème épaisse', 'cocktail'], 'Plat principal', e9be4714-3a1d-4820-865d-bf532615b2a7, '2025-09-26T15:25:56.926629', [{'ingredient_id': '79f5ca74-5e4a-4b9e-9c4c-296057a7759f', 'quantite': '4'}, {'ingredient_id': 'e2e66a26-9f2b-4e43-9132-5039cb2d5581', 'quantite': '1'}, {'ingredient_id': '07e10f7f-32fa-4eea-b40c-4bc9c86a392e', 'quantite': '1'}, {'ingredient_id': 'dfd09947-635c-4d74-8362-3b272eb6912d', 'quantite': '2'}, {'ingredient_id': 'd0e73bd9-6002-4f2c-b306-3489507c2530', 'quantite': '2'}, {'ingredient_id': '38e1d978-a123-4cab-b9ab-ba05e117a862', 'quantite': '2'}, {'ingredient_id': 'c1cc6e6f-9b2e-45c1-8000-259a63078666', 'quantite': '1'}, {'ingredient_id': 'ee810958-8071-4565-8875-3d2ea9a17740', 'quantite': '1 cuillères'}, {'ingredient_id': '92f77909-12ba-4022-94d3-7d0497351001', 'quantite': '1 cuillères'}, {'ingredient_id': '58d9a5e5-32d7-425d-b65c-50bef702a87f', 'quantite': ''}, {'ingredient_id': '349c7c30-d1cb-4279-9da1-225915f62466', 'quantite': '1'}, {'ingredient_id': 'cb9b351a-e886-417a-b5c7-a418369c7adf', 'quantite': ''}, {'ingredient_id': '0e170b22-3c31-4798-bb29-9ba23bdf5af6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (167323, 'Cocktail tropical sans alcool', 'jus d''orange, papaye, jus de banane, orange, litchi', '10 min', ['Dans un grand saladier, versez le jus d''orange, le jus de papaye ainsi que le jus de banane. Mélangez jusqu''à ce que le melange soit homogène.', 'Prenez l''orange et decoupez la en tranche fine. Ajoutez le a votre saladier. Ouvrez la boite de litchi et mettez en aussi, quelques uns dans votre préparation.', 'Servez bien frais.'], ['Mixeur', 'Tire-bouchon', 'Casserole', 'Presse-agrumes'], ['', 'entrée', 'papaye', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'Cocktail tropical sans alcool', 'plat', 'jus de banane', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus d''orange', 'cocktail'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:26:01.029193', [{'ingredient_id': '6fe3014a-6b01-48e6-a771-4277622475dc', 'quantite': '1'}, {'ingredient_id': 'f0c6c9ec-b578-4e70-84f5-8086c958872a', 'quantite': '1'}, {'ingredient_id': 'b2d0e0c3-b5a6-4039-8b73-bcd372506b53', 'quantite': '50 cl'}, {'ingredient_id': 'f832b0a0-f080-44c4-be81-b3b3f01458cb', 'quantite': '1'}, {'ingredient_id': 'b8e56f7e-fca1-4685-b7ce-b5acc8a08531', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336907, 'Flan à la bananes version Espagnole', 'banane, oeuf, sucre, farine, lait, sucre vanillé', '25 min', ['Éplucher les bananes et les découper en rondelles puis les mettre dans un plat', 'Mélanger le sucre, les oeufs, la  farine, le lait et le sucre vanillé', 'Incorporer la préparation sur les bananes et introduire dans le four pendant 25 min à 150°c', 'Avant la fin de la cuisson saupoudrer de sucre'], ['Balance de cuisine', 'Rouleau à pâtisserie', 'Économe', 'Râpe', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'flan', 'sucre', 'Flan à la bananes version Espagnole', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:26:04.859515', [{'ingredient_id': '6d19edf6-d286-488a-96bc-8ec21ca87de3', 'quantite': '5'}, {'ingredient_id': '20c499d5-1a5c-4747-aa0a-0035f6eed7b5', 'quantite': '5'}, {'ingredient_id': '0f213a36-ad75-4018-9c1f-bbb4ad7b4a76', 'quantite': '200 g'}, {'ingredient_id': 'c18bce9d-55d6-4b5a-858e-a49be979edb5', 'quantite': '5 cuillères'}, {'ingredient_id': 'dfcaa212-3f72-40f0-b732-b586608e1f20', 'quantite': '100 cl'}, {'ingredient_id': '4f825ded-5696-4623-9982-4c6e0f752bf2', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (217860, 'Crevettes à la banane', 'crevettes, crème fraîche, oignon, banane, ail, rhum, sel, poivre, beurre', '20 min', ['Tout d''abord retirer les têtes des crevettes et garder les queues (cela évite de les voir trop se rétracter pendant la cuisson).', 'Faire revenir l''oignon coupé en cubes et l''ail dans la noisette de beurre.', 'Y jeter les crevettes dès que la préparation commence à perdre son eau de cuisson).', 'Ajouter la banane (plus elle est molle, mieux c''est) en la coupant en petites rondelles.', 'Poivrer (selon vos goûts) et saler (afin de relever le plat qui pourrait être trop sucré).', 'Ajouter le rhum et commencer à bien mélanger l''ensemble, les crevettes tiendront le coup, le but étant de créer une sorte de purée de cuisson.', 'Au bout d''une dizaine de minutes (plus si les crevettes étaient crues) ajouter la crème liquide pour terminer la cuisson.', 'Le plat peut être proposé avec le jus de cuisson et être présenté comme une soupe épaisse.', 'A servir avec un verre de rhum...'], ['Mixeur', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'crevettes', 'plat de résistance', 'Crevettes à la banane', 'beurre', 'poivre', 'cocktail'], 'Plat principal', de676beb-d29a-42af-972c-58bf070fded7, '2025-09-26T15:26:08.477455', [{'ingredient_id': '1aaae0da-7827-4eae-a2d4-f9d4b42bbf25', 'quantite': '500 g'}, {'ingredient_id': '61072df1-717b-4e08-b9a7-7a5c0ce5c2ec', 'quantite': '10 cl'}, {'ingredient_id': '73257fc1-9da2-4010-840a-916191b6123d', 'quantite': '1'}, {'ingredient_id': '190f010f-f17b-4bd7-be78-749948ffa18e', 'quantite': '1'}, {'ingredient_id': '019b874a-e196-4fca-a921-99c5d923e851', 'quantite': '2'}, {'ingredient_id': 'e6275da2-662a-4568-ad50-985108146f8b', 'quantite': '10 cl'}, {'ingredient_id': '27a0e45a-e483-4b6b-b37b-94c5a1439fe8', 'quantite': ''}, {'ingredient_id': '52439509-ef84-4ce6-9fdd-5def7baa3054', 'quantite': ''}, {'ingredient_id': 'dc8ba8d0-b42d-43cb-9191-f3bf6052be39', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65561, 'Mini muffins banane cannelle', 'oeuf, farine, beurre, sucre, sucre vanillé, banane, crème, extrait de vanille liquide, cannelle', '10 min', ['Préchauffer le four à 180 degrés, thermostat 6.', 'Battre l''oeuf puis ajouter le beurre fondu, la banane écrasée, le sucre, la farine, le sucre vanillé et la crème.', 'Ajouter un trait d''arôme vanille et saupoudrer de la cannelle tout en mélangeant (la quantité dépend de vos goûts).', 'Répartir le mélange dans un moule à mini-muffins et cuire environ 20 min.'], ['Ouvre-boîte', 'Passoire', 'Balance de cuisine', 'Louche', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'extrait de vanille liquide', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'Mini muffins banane cannelle', 'plat', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'muffin', 'beurre', 'cannelle', 'sucre', 'cocktail'], 'Dessert', c1150c47-e860-4d00-9020-e9a56becb6c9, '2025-09-26T15:26:12.192934', [{'ingredient_id': '84368173-7808-451d-a889-584a900060a1', 'quantite': '1'}, {'ingredient_id': '1e65752e-2ee3-4700-91bc-7e295a76c2b7', 'quantite': '80 g'}, {'ingredient_id': 'd9135326-5910-441c-935d-3c2d967e3681', 'quantite': '50 g'}, {'ingredient_id': '7df75a29-7a46-4f4f-8260-b33c99552721', 'quantite': '100 g'}, {'ingredient_id': 'b1595783-7321-4934-8e74-91f520138fd0', 'quantite': '1'}, {'ingredient_id': '20f8de6b-19fa-4355-8098-5288030cae1f', 'quantite': '1'}, {'ingredient_id': '979a3630-fbee-4b0b-a8bb-459ef57a1acb', 'quantite': '1 cuillères'}, {'ingredient_id': '32993bf2-d032-4091-bf11-0e6fc485a014', 'quantite': ''}, {'ingredient_id': 'f698ae20-661f-41f5-aa2d-970539874f36', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58026, 'couscous antillais', 'semoule, merguez, banane, bouillon de poule, curcuma, raisins secs', '5 min', ['Faire cuire les merguez.', 'Peler les bananes et les faire cuire (avec les merguez c''est meilleur, mais il faut aimer)', 'Faire gonfler la semoule avec le bouillon de poule chaud, les raisins sec et le curcuma (épices à couscous).', 'Servir le tout dans un grand plat.'], ['Ouvre-boîte', 'Batteur électrique', 'Presse-agrumes', 'Fouet', 'Moule à tarte'], ['couscous', 'bouillon de poule', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'semoule', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'curcuma', 'couscous antillais', 'dessert', 'plat de résistance', 'raisins secs', 'cocktail', 'merguez'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:26:15.743607', [{'ingredient_id': 'dafd5be8-4f02-4381-bada-52e35425ceaa', 'quantite': '100 g'}, {'ingredient_id': '4fa647be-37cd-4041-9610-f02118ffc061', 'quantite': '6'}, {'ingredient_id': '0f454ecb-bdd4-449e-8353-b561d009c756', 'quantite': '3'}, {'ingredient_id': '556e829d-7c57-48ba-8fb9-5e21d8effa9b', 'quantite': ''}, {'ingredient_id': 'eaf7f3b2-74f3-4156-b004-c86565065565', 'quantite': ''}, {'ingredient_id': '8100231b-8146-490d-a936-a7206c1968c4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72487, 'Croque choco banane', 'banane, chocolat au lait, pain de mie, beurre', '15 min', ['- Ecrasez les bananes à la fourchette.', '- Beurrez les 8 tranches de pain de mie. Recouvrez de bananes écrasées 4 d''entres elles (côté beurré en dessous). ', 'Disposez 5 morceaux de chocolat sur les bananes.', '- Recouvrez-les des 4 tranches de pain restantes, la face beurrée sur le dessus.', '- Mettez une noix de beurre dans une poêle, et faites dorer les croques 3 à 4 min de chaque côté.'], ['Tire-bouchon', 'Verre doseur', 'Fouet', 'Louche', 'Pince de cuisine'], ['', 'chocolat au lait', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Croque choco banane', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'cocktail', 'pain de mie'], 'Dessert', 096d1d03-ffd2-4021-9fa1-358e8eaa75fd, '2025-09-26T15:26:19.844484', [{'ingredient_id': '84796b0e-a0ea-44e5-bd88-090dc41e1f3b', 'quantite': '2'}, {'ingredient_id': '90eaa5ca-0327-4845-8acd-4cbfd0f86350', 'quantite': '150 g'}, {'ingredient_id': 'edcd89b4-bfd1-40fa-86d8-98f0aff8b7f7', 'quantite': '8'}, {'ingredient_id': '702e28f8-d570-4d7f-83f5-004acc83da11', 'quantite': '30 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (254475, 'Verrines banane, chocolat et caramel au beurre salé', 'oeuf, chocolat pâtissier, beurre, caramel, banane, gâteaux, sucre vanillé, rhum', '20 min', ['Faire fondre le chocolat avec le beurre au bain-marie jusqu''à obtenir un mélange liquide et lisse.', 'Séparer les blancs des jaunes, mélanger les jaunes avec le chocolat fondu.', 'Battre les blanc en neige.', 'Dans le mélange chocolat-jaunes d’œufs, ajouter les caramels coupés en très petits morceaux.', 'Incorporer les blancs délicatement et mélanger doucement (la préparation doit former une mousse).', 'Laisser poser à température ambiante.', 'Dans une poêle, mettre un peu de beurre. Faire cuire à feu doux la banane préalablement découpée en rondelle pas trop fines.', 'A la fin de la cuisson, arroser légèrement de rhum.', 'Concasser les gâteaux secs sucrés et les mettre au fond des verrines.', 'Ajouter les bananes puis recouvrir de mousse au chocolat.'], ['Presse-agrumes', 'Rouleau à pâtisserie', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'caramel', 'bon marché', 'Verrines banane', 'rapide', 'oeuf', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'gâteaux', 'chocolat et caramel au beurre salé', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:26:23.420105', [{'ingredient_id': 'b80a8efc-99ce-4c73-9867-6f201fe336a0', 'quantite': '3'}, {'ingredient_id': 'aef5d130-1c89-498b-9ca4-dd2d250142d3', 'quantite': '150 g'}, {'ingredient_id': 'dfdc5d0f-6e36-4003-a6b2-85d0051cd146', 'quantite': '20 g'}, {'ingredient_id': 'b04f220f-6a3d-4309-b6c6-73eab6131249', 'quantite': '50 g'}, {'ingredient_id': '0e6c2fc3-ca01-4d2a-8c5c-5e26b54ff6f5', 'quantite': '1'}, {'ingredient_id': '74c29184-8b24-467f-9b6d-f3366e4d6a62', 'quantite': '5'}, {'ingredient_id': '13b92957-bbcd-4cf2-90b1-cd41d6fedca9', 'quantite': '1'}, {'ingredient_id': 'b17bae52-daa0-4148-bbc5-4da22e5ebafb', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (347558, 'Banana bread healthy à la compote', 'banane, compote, oeuf, farine, sucre, levure chimique, cacao amer, chocolat', '15 min', ['Préchauffez le four à 150°C (thermostat 5) chaleur tournante.', 'Epluchez et écrasez les bananes (comme de la purée).', 'Ajoutez la compote et mélangez.', 'Ajoutez les oeufs et le sucre.', 'Ajoutez ensuite la farine et la levure chimique.', 'Ajoutez ensuite si vous le souhaitez du cacao, des noix, des pépites de chocolat etc...', 'Versez votre préparation dans un moule (beurré) et mettez la préparation dans le four pendant 50 minutes. Au bout de 20 minutes de cuisson, tracer une ligne avec un couteau sur le milieu du gâteau.'], ['Couteau de chef', 'Spatule', 'Poêle', 'Moule à tarte', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'cacao amer', 'confiserie', 'testées', 'levure chimique', 'chocolat', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'compote', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'Banana bread healthy à la compote', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', 7fd99287-cadd-4024-a24e-f1aae5ab1b53, '2025-09-26T15:26:29.044375', [{'ingredient_id': 'c95d7a21-2f97-490f-bc1c-aae68a367cb8', 'quantite': '3'}, {'ingredient_id': 'ede9b2ac-3182-4210-8a19-2c614ae1ba38', 'quantite': '100 g'}, {'ingredient_id': '14172c80-4ea2-4813-9432-a93231f3210e', 'quantite': '2'}, {'ingredient_id': 'e247ff66-ad70-4a4b-954e-2bbac082c501', 'quantite': '200 g'}, {'ingredient_id': 'af184b4f-5d06-471c-ad02-448a63daca75', 'quantite': '50 g'}, {'ingredient_id': 'd0ec7fa1-a315-428b-99e4-b3041ecae4f2', 'quantite': '1'}, {'ingredient_id': 'd98b08eb-0068-4cc6-aab7-1241deaecbbb', 'quantite': '2 cuillères'}, {'ingredient_id': '474e2c2c-0831-4358-a5aa-a7e1988efac3', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (86093, 'Glace aux petits suisses et à la banane', 'sucre, oeuf, petit suisse, crème fraîche, biscuits à la cuillère, sucre vanillé, banane, sel', '30 min', ['Séparer les blancs des jaunes d''œufs. Réserver les blancs.', 'Battre les jaunes d''œufs, le sucre et le sucre vanillé.', 'Mixer les bananes coupées en morceaux, les petits suisses et la crème fraiche.', 'Ajouter à ce mélange, les jaunes d''œufs et le sucre.', 'Ajouter la pincée de sel aux blancs d''œufs et les monter en neige ferme.', 'Incorporer délicatement les blancs d''œufs au mélange.', 'Émietter les biscuits à la cuillère et les mélanger avec le reste.', 'Placer le saladier au congélateur au moins 12 h.'], ['Fouet', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'petit suisse', 'testées', 'biscuits à la cuillère', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'sucre', 'glace à l''italienne', 'cocktail', 'Glace aux petits suisses et à la banane'], 'Dessert', 407e4eee-a247-4088-800f-b700cd30a264, '2025-09-26T15:26:33.326652', [{'ingredient_id': '9d448bed-eb3e-48e4-a346-2a2927687dde', 'quantite': '100 g'}, {'ingredient_id': 'f3d35ccc-3f11-4e50-aac7-15ab3b5b722c', 'quantite': '4'}, {'ingredient_id': 'd6de8e93-815f-47d8-a254-e9fa372fccfd', 'quantite': '6'}, {'ingredient_id': '6914efdd-4367-4f83-98be-29ffafbbecee', 'quantite': '20 cl'}, {'ingredient_id': 'f90eb872-9033-4c66-8d85-194c759dda19', 'quantite': '16'}, {'ingredient_id': '50e9183f-ce64-46f2-b984-aba3059a237b', 'quantite': '1'}, {'ingredient_id': 'd9b2ab3f-7111-4276-bcc3-44668507ef5a', 'quantite': '4'}, {'ingredient_id': '8005779a-4458-4ac3-b54f-c9e46fe101e1', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228708, 'Milk shake aux speculoos (simple)', 'spéculoos, banane, lait', '10 min', ['Épluchez les bananes, et les mettre avec les spéculoos dans un mixer.', 'Mixez et servir très frais.'], ['Ouvre-boîte', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'Milk shake aux speculoos (simple)', 'dessert', 'plat de résistance', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:26:37.385077', [{'ingredient_id': 'ff5d9f79-c6c1-4949-9e39-a41554b803e7', 'quantite': '4'}, {'ingredient_id': '51cb2088-29ff-4c88-8d84-fecf6a0781e0', 'quantite': '2'}, {'ingredient_id': '90b3bfec-ac45-4384-8382-52784918a083', 'quantite': '75 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50309, 'Mon pudding aux biscottes', 'biscotte, lait, oeuf, sucre en poudre, pomme, banane', '10 min', ['Faire chauffer le lait 2 minutes au micro-ondes avec le sucre.', 'Emietter les biscottes dans le lait sucré chaud et mélanger énergiquement avec une cuillère.', 'Incorporez les oeufs puis les fruits coupés en petits morceaux.', 'Verser la préparation dans un moule à cake allant au micro-ondes.', 'Couvrir avec un film étirable et faire quelques trous.', 'Faire cuire 8 minutes au micro-ondes puissance maximum.', 'Démouler tiède sur un plat et servir froid avec une crème anglaise ou un coulis de fruits.'], ['Économe', 'Poêle', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Mon pudding aux biscottes', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'pudding', 'dessert', 'plat de résistance', 'pomme', 'biscotte', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:26:40.938949', [{'ingredient_id': '04133c70-5345-46cd-a1f2-e9a667b350d3', 'quantite': '160 g'}, {'ingredient_id': 'ad483e73-233c-4a37-98a0-337899b06c13', 'quantite': '50 cl'}, {'ingredient_id': '019ec9bb-0c18-4da0-97c7-738684ccbd8d', 'quantite': '4'}, {'ingredient_id': 'f33a0429-66d2-4864-9585-3bf7460a732d', 'quantite': '4 cuillères'}, {'ingredient_id': '01cce3e4-3c3a-4592-84bb-5920ceaaf57f', 'quantite': '1'}, {'ingredient_id': 'f0978d81-cb55-47c4-87dc-d21bf13d3a09', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (371802, 'Acai bowl', 'banane, poudre d''acaï, boisson aux amandes, fruits rouges, miel, pomme, granola, fruits rouges', '10 min', ['Verser tous les ingrédients de la base dans un blender et mixer jusqu''à l''obtention d''un mélange lisse et crémeux. ', 'Verser la préparation dans un bol. ', 'Laver la pomme et la détailler en fines lamelles. 
Déposer des lamelles de pommes, les fruits rouges et le granola sur la préparation dans le bol. ', 'Déguster immédiatement.'], ['Spatule', 'Pince de cuisine', 'Râpe', 'Presse-agrumes'], ['entrée', 'banane', 'boisson aux amandes', 'recettes de cuisine', 'poudre d''acaï', 'confiserie', 'testées', 'Petit déjeuner', 'très facile', 'rapide', 'plat', 'fruits rouges', 'recette', 'Acai bowl', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:26:44.373120', [{'ingredient_id': '0ee4ef62-cc9c-43a1-b215-08e1c75147c6', 'quantite': '1'}, {'ingredient_id': 'e3a8b11a-7015-49b4-a5d2-96a9b47b182b', 'quantite': '2 cuillères'}, {'ingredient_id': 'b5f06d8c-3e8a-4587-b722-3c2bd34371a4', 'quantite': '1'}, {'ingredient_id': 'bbf0d346-27c2-45a7-9f0c-1c63bbf3cddd', 'quantite': '1'}, {'ingredient_id': 'd7edf6af-9a13-438f-bf6e-b19ea0b587f2', 'quantite': '1 cuillères'}, {'ingredient_id': '33363ca2-af19-476d-ab4b-2f0a5b602000', 'quantite': ''}, {'ingredient_id': '865bce8a-fb12-4215-91e5-4ad0a27d6d7f', 'quantite': '1 cuillères'}, {'ingredient_id': '97709370-db07-4666-b8bf-c52906c6cc37', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16109, 'Bananes au jambon et moutarde', 'banane, jambon, beurre, gruyère râpé, moutarde', '15 min', ['Mettre le four à préchauffer sur thermostat 7.', 'Eplucher les bananes, badigeonner copieusement les tranches de jambon avec la moutarde. Saler modérément.', 'Rouler les bananes dans les tranches de jambon (moutarde à l''intérieur), placer dans un plat allant au four. Parsemer de petits dés de beurre et de fromage râpé (une bonne couche).', 'Mettre au four pendant 30 mn + ou - selon la taille des bananes.', 'On obtient un plat avec un mélange salé sucré, mais  curieusement la banane n''est pas vraiment prédominante et l''alliance est délicieuse. Le jus permet de servir un riz blanc qui marche bien.'], ['Pince de cuisine', 'Fouet', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'jambon', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'Bananes au jambon et moutarde', 'cuisine', 'recettes', 'boisson', 'gruyère râpé', 'dessert', 'plat de résistance', 'moutarde', 'beurre', 'cocktail'], 'Plat principal', 56820e71-b7d1-4bf2-8100-ef8dcb5f9f72, '2025-09-26T15:26:47.872449', [{'ingredient_id': '492653c7-c4f3-42d5-ad9c-d8fa2a3d00a6', 'quantite': '4'}, {'ingredient_id': '54823c8c-a4ba-4ca8-8e0e-1da95ee2dc95', 'quantite': '4'}, {'ingredient_id': '28124608-2ae9-4ccd-b12c-586fe5c9c869', 'quantite': '100 g'}, {'ingredient_id': '3b4dc212-ec99-4625-98db-95b76db830a2', 'quantite': '1'}, {'ingredient_id': 'c78e47da-7632-49a0-8321-c04b5487ac9d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (225274, 'Tarte minute banane et pate à tartiner au chocolat', 'pâte brisée, pâte à tartiner, banane', '10 min', ['Déroulez la pâte brisée dans un moule à tarte et étalez la pâte à tartiner.', 'Préchauffez le four à 180°C (thermostat 6).', 'Coupez les bananes en rondelles et disposez les sur la pâte à tartiner, en faisant une spirale pour que les rondelles de banane soient présentes sur toute la surface de la tarte.', 'Vous pouvez ajouter du sucre sur le dessous pour caraméliser les bananes mais je trouve que ce dessert est déjà assez calorique...', 'A déguster tiède ou froid.'], ['Couteau de chef', 'Rouleau à pâtisserie', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'Tarte minute banane et pate à tartiner au chocolat', 'dessert', 'plat de résistance', 'cocktail', 'pâte à tartiner'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:26:51.928368', [{'ingredient_id': 'cfbfa117-9877-4b03-8374-a286828cf24d', 'quantite': '1'}, {'ingredient_id': '4aa1258a-ff03-4cc4-8266-012d6782d7d6', 'quantite': '7 cuillères'}, {'ingredient_id': 'ff8b53d5-8c8b-455e-a92f-70783bf15d6d', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (311921, 'Gâteau au yaourt, banane, miel et pâte d''amande', 'levure, yaourt nature, huile, oeuf, sucre, farine, banane, amandes en poudre, sucre glace, eau, miel', '60 min', ['Avec les œufs, séparez les blancs des jaunes et battez les blancs en neige. ', 'Écrasez les bananes de façon à obtenir une sorte de purée. ', 'Mélangez ensuite la levure, le yaourt, l''huile, le sucre, les jaunes d’œufs et la farine, auxquels vous intégrerez les bananes et enfin les blancs d’œuf en neige, de façon à avoir à la fin, un mélange uniforme. ', 'Beurrez ou huilez un moule à manqué et mettez-y la pâte. ', 'Enfournez à 180°C pendant environ 45 minutes.', 'Pour faire la pâte d''amande, mélangez la poudre d''amande et le sucre glace avec un peu d''eau et du miel, de façon à obtenir une boule uniforme et peu collante. Réservez au frigo.', 'Lorsque le gâteau est cuit, mettez-le à refroidir. ', 'Lorsque il est devenu tiède, coupez-le en deux dans le sens de la longueur et étalez-y la pâte d''amande.', 'Réunissez le gâteau en un seul morceau et saupoudrez de sucre glace pour décorer.'], ['Tire-bouchon', 'Fouet', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'Gâteau au yaourt', 'confiserie', 'testées', 'yaourt nature', 'facile', 'miel et pâte d''amande', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'moyen', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:26:55.467551', [{'ingredient_id': '6ed696b4-12ba-41e4-b2ee-224a7f1b416c', 'quantite': '1'}, {'ingredient_id': 'e6e1b21c-8940-442b-848a-c848a00a4286', 'quantite': '1'}, {'ingredient_id': '31d5a10a-b0b0-407f-8cea-70f42ad4ac53', 'quantite': ''}, {'ingredient_id': '3c6dc6af-3dfe-42fe-a743-83a06f327c25', 'quantite': '3'}, {'ingredient_id': 'd24011c1-f93a-40cb-ba12-6c692613225e', 'quantite': '1.5'}, {'ingredient_id': '5fd7fd82-4c13-4cd3-adcd-cd9252496676', 'quantite': '3'}, {'ingredient_id': '2587f3cd-fdcb-46b0-9583-bc0901db9a66', 'quantite': '2'}, {'ingredient_id': 'eea73213-5d16-46b6-914f-5893f226da14', 'quantite': '200 g'}, {'ingredient_id': '410f9a13-2fb9-48bb-b819-d201d9a518b3', 'quantite': '200 g'}, {'ingredient_id': '552ec327-9514-4a1c-a23c-a75eac470caa', 'quantite': '1 cuillères'}, {'ingredient_id': '997bb1e6-8adb-44a3-90a9-72e5ed8c166f', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (45362, 'Gâteau duo de chocolat et son coeur de petit beurre', 'farine, sucre, oeuf, crème fraîche, levure, chocolat blanc, chocolat noir, banane, petit beurre, pâte à tartiner, huile, beurre', '30 min', ['Préparation des gâteaux:', 'Il s''agit de préparer 2 gâteaux ayant la même base mais en changeant juste la nature du chocolat.', 'Préchauffer le four à 180°C.', 'Casser 2 oeufs dans un saladier. Les mélanger à 100 g de sucre à l''aide d''un fouet jusqu''a ce que le mélange blanchisse. Incorporer 75 g de farine à la préparation, puis 3 cuillères à soupe de crème fraiche et 1/2 paquet de levure.', 'Faire fondre le chocolat Blanc au bain marie ou au micro-onde et l''incorporer à la préparation. Faire cuire le gâteau dans un moule beurré avec une noix de beurre pendant 25 min et vérifier la cuisson à coeur.', 'Faire de même pour le gâteau au chocolat noir mais ne pas le cuire de suite.', 'Pendant que le gâteau au chocolat blanc cuit, éplucher et découper les bananes en deux dans le sens de la longueur. Les faire frire dans le filet d''huile jusqu''a ce qu''elle caramélisent.', 'Les disposer dans le fond d''un moule beurré et mettre la pâte à gâteau au chocolat noir par dessus. Faire cuire le gâteau comme pour le chocolat blanc (25 min à 180°C - thermostat 6)', 'Montage :', 'Démouler le gateau au chocolat blanc. Couvrir le dessus d''une bonne couche de pâte à tartiner.', 'Briser les petits beurres pour en recouvrir la pâte à tartinr. Démouler le 2ème gâteau et le déposer sur les petits beurres la face avec les bananes vers soi.', 'Servir le gâteau et se régaler...'], ['Ouvre-boîte', 'Râpe', 'Tire-bouchon', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'oeuf', 'plat', 'moyenne', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'Gâteau duo de chocolat et son coeur de petit beurre', 'chocolat noir', 'moyen', 'beurre', 'chocolat blanc', 'petit beurre', 'gâteau au chocolat', 'sucre', 'cocktail', 'pâte à tartiner'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:26:59.128784', [{'ingredient_id': '3013b158-ae3b-4765-b8e7-cb0e25e65483', 'quantite': '150 g'}, {'ingredient_id': 'c8289bcb-b21b-4912-904c-c58693507165', 'quantite': '200 g'}, {'ingredient_id': 'e69d80ea-170a-4956-9263-011b066c7cb3', 'quantite': '4'}, {'ingredient_id': '405b40c0-965f-4007-878b-065a4f408766', 'quantite': '6 cuillères'}, {'ingredient_id': 'f0d4e9a8-03ff-4f3b-bb89-71d1f9f7fef8', 'quantite': '1'}, {'ingredient_id': '0e30e51e-f854-46e5-9e03-b9a31046c479', 'quantite': '100 g'}, {'ingredient_id': 'c824cb98-2877-46ae-b99c-9a78fe953e28', 'quantite': '100 g'}, {'ingredient_id': 'ff0b0441-622c-4ddd-865e-1fc4b7704104', 'quantite': '6'}, {'ingredient_id': '4f71763b-e7a2-497b-997d-6d6d1a29f245', 'quantite': '6'}, {'ingredient_id': 'c0d1cee7-e6f6-447e-97b0-dd600e51df6f', 'quantite': '1'}, {'ingredient_id': '7d9dfbea-4678-4071-8f9f-e9d870dae10a', 'quantite': '1'}, {'ingredient_id': '2fa78e87-9abc-4845-9407-084ad2fbc329', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28729, 'purée de banane et pomme au fromage blanc (petit déj ou dessert).', 'banane, pomme, fromage blanc', '5 min', ['Dans l''assiette écraser la banane à l''aide de la fourchette. ', 'Râper la pomme lavée (avec la râpe moyenne, pas fine comme pour le fromage, les + gros trous en fait) et l''ajouter à la banane. ', 'Ajouter le fromage blanc ou yaourt (0% si au régime), mélanger le tout. ', 'C''est prêt ! Vous pouvez ajouter un peu de sucre roux et déguster !'], ['Poêle', 'Mixeur', 'Économe', 'Verre doseur', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'purée de banane et pomme au fromage blanc (petit déj ou dessert).', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'pomme', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:27:02.571077', [{'ingredient_id': 'c34e6603-95e4-4a39-b1ba-31e4c2a357d6', 'quantite': '1'}, {'ingredient_id': '0a17c4de-7e57-48e2-8adb-e50da8ecb595', 'quantite': '1'}, {'ingredient_id': '507e7062-cede-43c3-91d7-e0adf4e927d7', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40565, 'paupiette de dinde à la banane', 'escalope de dinde, jambon cru, banane, confiture de banane, oignon, crème liquide, rhum, poivre, curry, ficelle', '20 min', ['Applatir les escalopes avec un rouleau à pâtisserie.', 'Déposer une demi tranche de jambon cru par escalope.', 'Tartiner avec de la confiture de banane', 'Déposer quelques rondelles de banane et quelques lamelles d''oignon.', 'Poivrer et saupoudrer de curry.', 'Refermer les paupiettes avec de la ficelle alimentaire.', 'Faire revenir les paupiettes et l''oignon avec de l''huile dans une poêle et flamber avec du rhum. ', 'Laisser cuire un quart d''heure et ajouter de la crème au dernier moment.'], ['Planche à découper', 'Tire-bouchon'], ['paupiette', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'ficelle', 'facile', 'confiture de banane', 'plat', 'jambon cru', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'crème liquide', 'escalope de dinde', 'dessert', 'plat de résistance', 'moyen', 'poivre', 'paupiette de dinde à la banane', 'curry', 'cocktail'], 'Plat principal', 793b3572-b745-4926-8b66-49662353bb0a, '2025-09-26T15:27:06.120188', [{'ingredient_id': '2c2fa792-3d65-4ed9-bcf7-f6c4dbcf7c20', 'quantite': '4'}, {'ingredient_id': '04204208-b6f4-4e0d-9e45-55c3313d58f4', 'quantite': '2'}, {'ingredient_id': '21dba0d3-ca57-4052-aa2c-74e9f12f76e7', 'quantite': '1'}, {'ingredient_id': '802b6b89-35d8-42b1-9978-2d63b70e33dc', 'quantite': ''}, {'ingredient_id': '1d21c284-8a7f-4c6d-9024-82e4b9a5125b', 'quantite': '1'}, {'ingredient_id': '3e211ced-bfff-4426-bd3f-f62d2e045037', 'quantite': ''}, {'ingredient_id': 'dcb25e73-9e95-4eb0-8ec8-e0881efb3819', 'quantite': ''}, {'ingredient_id': '91b202a9-5c6d-4bcd-ae56-f7c5a194fe5b', 'quantite': ''}, {'ingredient_id': '1ab6dfa3-ccb0-4b83-a38a-3f7418576627', 'quantite': ''}, {'ingredient_id': 'b68bec95-c536-4840-8870-5b7c85214721', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29002, 'croque gourmand de 4 heures', 'pain d''épices, banane, chocolat, beurre', '2 min', ['Beurrer les tranches de pain d''épices, poser dessus des rondelles de banane, les carrés de chocolat. ', 'Disposer en sandwich et cuire 3 mn dans l''appareil à croque-monsieur.'], ['Verre doseur', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'pain d''épices', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'cocktail', 'croque gourmand de 4 heures'], 'Dessert', 769de63b-066f-48e2-9d33-e3de54ec7e71, '2025-09-26T15:27:09.643844', [{'ingredient_id': '8f033e7f-54fb-4583-958c-a89b69ec976b', 'quantite': '2'}, {'ingredient_id': 'feb3f82e-adf4-4409-be3e-39d651ccb60a', 'quantite': ''}, {'ingredient_id': 'c7e0a72e-8cf3-4318-b026-f6d5731ecdaf', 'quantite': '1'}, {'ingredient_id': '1a16f3bc-75cd-4038-880a-c07804a5cde7', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16850, 'Gâteau-chausson pomme-banane', 'pâte feuilletée, pomme, banane, beurre, sucre de canne, rhum, jaune d''oeuf', '5 min', ['Eplucher les pommes et les couper en morceaux ainsi que les bananes.', 'Faire chauffer dans une poêle la noisette de beurre et y ajouter les pommes et les bananes jusqu''à ce qu''elles deviennent colorées, puis ajouter le sucre pour faire caraméliser.', 'Une fois le mélange fondu, déglacer avec le rhum et laisser reposer.', 'Pendant ce temps, placer un rouleau de pâte feuilletée dans un plat à tarte et y mettre la préparation. Poser par-dessus l''autre rouleau de pâte feuilletée, pincer les bords et badigeonner le jaune d''oeuf sur le dessus.', 'Cuire 30 mn au four. Le dessus doit être bien doré.'], ['Casserole', 'Balance de cuisine', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'Gâteau-chausson pomme-banane', 'très facile', 'bon marché', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'dessert', 'plat de résistance', 'pâte feuilletée', 'pomme', 'gâteau à la banane', 'beurre', 'cocktail'], 'Dessert', e6568fcf-4ad0-49b0-8e74-f3dd0c6248d5, '2025-09-26T15:27:14.359937', [{'ingredient_id': '0cbf258d-f16b-40b7-9020-11c8b34169eb', 'quantite': '2'}, {'ingredient_id': '3d13978f-9c86-4fd1-93d5-a8b3efebb20a', 'quantite': '6'}, {'ingredient_id': '0f9f08c5-6a0e-4254-83c2-9a22c97a53c8', 'quantite': '2'}, {'ingredient_id': '6f76bf36-7022-4aa3-b878-3a7fcedc4b78', 'quantite': '1'}, {'ingredient_id': '01e75b1f-9c6a-4792-ae75-827fbf91b9af', 'quantite': ''}, {'ingredient_id': 'e38cf8a0-ed7b-4ba3-beb7-ce2028eaa3c0', 'quantite': '1 cuillères'}, {'ingredient_id': '28aa5094-a699-4b54-b541-c444e4c63312', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66581, 'Bananes flambées au miel', 'banane, citron, miel, beurre, rhum', '10 min', ['Peler les bananes, les couper en deux dans le sens de l''épaisseur, les arroser de jus de citron.', 'Faire fondre le beurre dans une sauteuse.', 'Ajouter les bananes et le jus de citron.', 'Napper de miel.', 'Faire cuire 6 minutes en roulant bien les bananes dans le beurre miellé pour les caraméliser.', 'Hors du feu, verser le rhum dans la poêle et faire flamber.'], ['Rouleau à pâtisserie', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'Bananes flambées au miel', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'citron', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:27:17.951009', [{'ingredient_id': '3b3e9fd2-590a-4f08-b72e-93a59dc879a9', 'quantite': '4'}, {'ingredient_id': '168423c3-4f49-4065-8e79-9ef72edc71c3', 'quantite': '1'}, {'ingredient_id': '873f4926-f2a9-4190-9785-b9bd7a6d6d3e', 'quantite': '4 cuillères'}, {'ingredient_id': 'cffb01b7-7726-4c07-9163-0c13a2425d19', 'quantite': '40 g'}, {'ingredient_id': 'd799416a-10e3-4726-83c9-53cd934a7a2f', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13300, 'Yaourt à la banane (dessert peu sucré)', 'banane, yaourt', '5 min', ['Couper les bananes en rondelles et les mettre dans un plat. Y ajouter les yaourts nature. Bien mélanger.'], ['Balance de cuisine', 'Planche à découper', 'Fouet', 'Batteur électrique', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'Yaourt à la banane (dessert peu sucré)', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', 0ae72009-b2e2-486e-8f46-8fc8b14a99a6, '2025-09-26T15:27:21.365307', [{'ingredient_id': 'a2e6cd96-57df-49e5-8b23-94a1bdc3eaf2', 'quantite': '2'}, {'ingredient_id': '924b4840-da79-47af-87b2-86a5e433f97a', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (90970, 'Duo de mousse framboise-banane', 'banane, crème fraîche, sucre, rhum, citron, sucre vanillé, blanc d''oeuf, framboises, fromage blanc, oeuf, sucre', '215 min', ['Pour la mousse de bananes : ', 'Mixez les bananes avec le jus du citron, le sucre et le rhum afin d''obtenir une crème lisse.', 'Fouettez la crème fraîche avec le sucre vanillé.', 'Montez les blancs en neige.', 'Mélangez la crème de banane avec la chantilly puis les blancs en neige.', 'Remplir la moitié des verrines avec la mousse, et mettre au frais.', 'Pour la mousse de framboises :', 'Mixez les fruits.', 'Mixez le jus obtenu avec le fromage blanc et les jaunes d’œufs.', 'Montez les blancs en neige, y incorporer une cuillère à café de sucre lorsqu''ils commencent à monter. Puis le reste du sucre pour qu''ils deviennent brillants.', 'Incorporez délicatement les blancs en neige au mélange précédent.', 'Complétez les verrines avec la mousse à la framboise. ', 'Remettez au réfrigérateur 3 heures.'], ['Rouleau à pâtisserie', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'confiserie', 'testées', 'facile', 'framboises', 'bon marché', 'rapide', 'oeuf', 'plat', 'Duo de mousse framboise-banane', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron', 'mousse fruits', 'sucre', 'blanc d''oeuf', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:27:24.942448', [{'ingredient_id': '0d4eab47-3ca6-46c5-b9a7-2fb2131ea6ac', 'quantite': '4'}, {'ingredient_id': '9682d1d3-9aad-49d3-98a4-e0ce87d3cb29', 'quantite': '25 cl'}, {'ingredient_id': '1cc2271c-3ee2-4d65-a352-3c257aca71aa', 'quantite': '2 cuillères'}, {'ingredient_id': '0a826819-8aa0-4ae8-9261-2fed64756ddb', 'quantite': '1 cuillères'}, {'ingredient_id': 'b8955ea4-9e84-4a69-b55a-461f405bda29', 'quantite': '1'}, {'ingredient_id': 'def8b0ab-62bb-4237-abd6-e72493d4ba22', 'quantite': '2'}, {'ingredient_id': '5d03ecae-af3c-46eb-b2dc-cad342ba2c21', 'quantite': '2'}, {'ingredient_id': '0b9aa205-4aca-4b98-aa05-41589529b78d', 'quantite': '200 g'}, {'ingredient_id': '665ba50b-c15a-41c9-a30b-e675a808c2a8', 'quantite': '250 g'}, {'ingredient_id': '9af0775b-b64d-433a-9bc1-61ce94e1e74e', 'quantite': '2'}, {'ingredient_id': '634c4c10-1f6e-4ebb-8cb8-83e51ee03592', 'quantite': '75 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (165514, 'Jus d''ananas aux épices', 'banane, orange, jus d''orange, ananas, vanille, gingembre, cannelle', '20 min', ['Éplucher l''ananas enlever les yeux noir et le centre dur, le couper en morceaux.', 'Peler les bananes et les couper en rondelle. ', 'Presser les oranges.', 'Couper la gousse de vanille en deux et récupérer à l''aide d''une petite cuillère les grains.   ', 'Mettre les fruits et le jus d''orange dans un blender ou une centrifugeuse. Mixer 1 à 2 min de façon à obtenir un jus lisse et homogène. Rajouter les épices et remixer un peu pour bien mélanger le tout.', 'C''est prêt laisser un peu refroidir et bonne dégustation. Si l''on souhaite, pour une jolie présentation rajouter dans le verre un bâton de cannelle et saupoudrer légèrement d''un peu de cannelle en poudre.'], ['Couteau de chef', 'Râpe', 'Balance de cuisine'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'Jus d''ananas aux épices', 'plat de résistance', 'orange', 'ananas', 'jus d''orange', 'cannelle', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:27:28.474802', [{'ingredient_id': 'de53baf0-f241-48a5-9407-dff2e95ba26e', 'quantite': '2'}, {'ingredient_id': '6978280b-60f5-47d6-8305-039cea74e5c6', 'quantite': '2'}, {'ingredient_id': '2431a3f1-0be6-4b1b-a9fa-7ecbfd656ae5', 'quantite': '40 cl'}, {'ingredient_id': 'c082b299-1b13-42e5-9e21-b09b7f96eeb7', 'quantite': '1'}, {'ingredient_id': '083aeb63-58c1-49a6-a31d-c5fe8db5d348', 'quantite': '1'}, {'ingredient_id': '1a1b3441-0a2e-4750-9c59-0b6514f73ab2', 'quantite': ''}, {'ingredient_id': 'a26efdc2-f5ce-4a01-bd5b-2a9077de04dc', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (391903, 'Banana bread sans sucre', 'banane, oeuf, poudre de noisette, levure, lait, pépites de chocolat, farine de blé, beurre tendre, mélange 4 épices', '10 min', ['Mélanger la farine, la levure, la poudre de noisette, les pépites chocolat et la cannelle.', 'Ajouter le beurre, le lait et les oeufs et 4 bananes écrasées en purée.', 'Verser dans un moule beurré.', 'Couper la dernière banane dans le sens de la longueur, et déposer les 2 morceaux sur le dessus du cake.', 'Faire cuire 30 min à 180°c'], ['Couteau de chef', 'Batteur électrique', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'beurre tendre', 'cakes', 'très facile', 'bon marché', 'oeuf', 'plat', 'pépites de chocolat', 'poudre de noisette', 'Banana bread sans sucre', 'recette', 'mélange 4 épices', 'cuisine', 'levure', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'farine de blé', 'lait', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:27:31.845683', [{'ingredient_id': '72056904-821f-42b0-b4ec-36a3f9fb6950', 'quantite': '5'}, {'ingredient_id': 'd703b8a1-14ad-4245-9246-94662899c5a1', 'quantite': '2'}, {'ingredient_id': '6a21aeb9-3de9-4e8a-b0e7-93a260f88839', 'quantite': '80 g'}, {'ingredient_id': '98b4d057-f4c6-40da-a9c7-4c27da1dde01', 'quantite': '1'}, {'ingredient_id': '8cb88eb6-03d5-41b8-911a-230f2250870b', 'quantite': '60 ml'}, {'ingredient_id': 'd2afeebd-56bb-4992-8dfb-3ed6637cfc50', 'quantite': '50 g'}, {'ingredient_id': '990c5923-2d27-4f16-9e76-152a8a7fb527', 'quantite': '150 g'}, {'ingredient_id': 'dbea1367-faaf-418f-af62-729af6f8eafb', 'quantite': '100 g'}, {'ingredient_id': 'bc8c1843-1b99-4da9-90f0-3894e046aca5', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (340538, 'Crumble rhubarbe pommes et Nutella', 'rhubarbe, pomme, banane, farine, beurre, sucre, Nutella', '30 min', ['Nettoyer la rhubarbe et la couper en morceaux. ', 'Éplucher les pommes et les couper en morceaux. ', 'Couper les bananes en morceaux. ', 'Mettre le tout dans une casserole et faire cuire pour que ca devienne une compote.', 'Mettre le tout dans un plat. Ajouter la cuillère de Nutella en dispersant un peu partout. ', 'Faire la pâte à crumble avec la farine, le beurre ramolli coupé en morceau et le sucre.', 'Le mettre par dessus la compote et enfourner 30 minutes à 180°C. '], ['Louche', 'Mixeur', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rhubarbe', 'bon marché', 'crumble aux pommes', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'Nutella', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'Crumble rhubarbe pommes et Nutella', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:27:35.302560', [{'ingredient_id': '1877eead-35b5-430a-84a6-88617aa4e40b', 'quantite': '6'}, {'ingredient_id': '04825068-f7e8-4f70-91b1-23a7fa238227', 'quantite': '4'}, {'ingredient_id': '3d5f0180-b9e8-431c-a467-d7286a48c6fc', 'quantite': '2'}, {'ingredient_id': '7c805bab-cb16-405c-a7a6-ab0417c51256', 'quantite': '100 g'}, {'ingredient_id': 'dbd9bf91-e8de-4c4d-8756-73cee7533b12', 'quantite': '100 g'}, {'ingredient_id': '36558eae-7d59-4caf-a29f-4b89818d4534', 'quantite': '50 g'}, {'ingredient_id': '2a25377d-5338-4d93-9bc6-852d445f7fe5', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68701, 'Gâteau aux petits suisses, aux pommes et à la banane', 'petit suisse, édulcorant, oeuf, farine, banane, pomme, beurre', '15 min', ['Préchauffer le four à 200°C (thermostat 6-7).', 'Mélanger les petits suisses avec l''édulcorant, les oeufs et la farine. ', 'Ecraser la banane pour en faire de la purée homogène et la mélanger au mélange petits suisses', 'Eplucher les pommes, les couper en morceaux et les étaler dans le fond du moule beurré. Recouvrir du mélange à la banane et mettre au four pendant 30 minutes.', 'La pointe du couteau doit sortir sèche.'], ['Rouleau à pâtisserie', 'Presse-agrumes', 'Râpe', 'Pince de cuisine', 'Mixeur'], ['aux pommes et à la banane', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'petit suisse', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'édulcorant', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'Gâteau aux petits suisses', 'dessert', 'plat de résistance', 'pomme', 'gâteau à la banane', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:27:38.934045', [{'ingredient_id': '81e9a295-538e-49fe-b53b-d7094a315ef4', 'quantite': '3'}, {'ingredient_id': '905ea2ad-c262-4acb-8aa5-e7a1c6514494', 'quantite': '12 g'}, {'ingredient_id': '23d575f7-69a6-47cc-b904-4a9f6f4c3ad5', 'quantite': '2'}, {'ingredient_id': '786dbbb8-9a00-4798-9ce9-ef7430bb974a', 'quantite': '40 g'}, {'ingredient_id': '944bb01d-3cdc-4f22-a902-6038015176a9', 'quantite': '1'}, {'ingredient_id': 'be06943b-50a2-4bac-8b75-12c71b90e829', 'quantite': '1'}, {'ingredient_id': '3a6da95f-e2c2-4c77-ab72-e586e25279cf', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (170087, 'Verrines de fruits façon charlotte', 'biscuits à la cuillère, eau, rhum, fromage blanc, sucre en poudre, banane, kiwi, cannelle', '35 min', ['Dans une assiette à soupe, verser l’eau et le rhum. Tremper les biscuits pour tapisser le fond des verrines.', 'Dans un saladier, mélanger le fromage blanc et le sucre. Mettre une couche de ce mélange dans les verrines.', 'Couper les bananes en rondelles, les écraser à la fourchette pour former une sorte de purée, ajouter la cannelle et mélanger. Mettre une couche de ce mélange dans les verrines.', 'Remettre une couche de biscuits, puis une de fromage blanc. ', 'Couper les kiwis en petits morceaux et les déposer sur les verrines.', 'Mettre au réfrigérateur 1h.'], ['Moule à tarte', 'Économe', 'Casserole', 'Louche'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'rhum', 'confiserie', 'eau', 'testées', 'cocktail', 'biscuits à la cuillère', 'facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'charlotte aux fruits', 'cannelle', 'Verrines de fruits façon charlotte'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:27:42.516158', [{'ingredient_id': 'df61d4da-354d-44a5-bae2-b90ebd740e11', 'quantite': '12'}, {'ingredient_id': '6f879070-6b94-4da8-bcce-270a714dcc3f', 'quantite': '10 cl'}, {'ingredient_id': '94b64974-91e3-4c55-a173-6c399ff27e03', 'quantite': '1 cuillères'}, {'ingredient_id': '56eb8dac-6769-4ad9-b896-bfa83c4fb175', 'quantite': '12 cuillères'}, {'ingredient_id': '20a8e533-70cf-4ae3-8da9-73e45eaa2104', 'quantite': '8 cuillères'}, {'ingredient_id': 'a9724568-0d21-4d76-abe9-44299eb80250', 'quantite': '3'}, {'ingredient_id': '7709a2ee-8292-490f-a3c0-61fca7fb9e24', 'quantite': '3'}, {'ingredient_id': '93858081-87c9-4bd8-bbcf-dca095f0318d', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (320967, 'Banane au lait', 'banane, eau, sucre, lait, glaçons', '10 min', ['Couper la banane en petits morceaux. ', 'Puis mettre la banane dans le mixeur avec l''eau, les glaçons, le sucre et le lait. ', 'Mixer le tout pendant 2 minutes. Vous n''avez plus qu''à verser dans 3 verres !'], ['Casserole', 'Presse-agrumes', 'Rouleau à pâtisserie', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'Banane au lait', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'sucre', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:27:46.008236', [{'ingredient_id': '8d1d8c8e-91c5-4d7c-ba37-e8621f2c594f', 'quantite': '1'}, {'ingredient_id': '02a25266-2ff7-44e1-8183-85041ac8c682', 'quantite': '3'}, {'ingredient_id': '8fc99fbb-dc48-43bc-a08f-4cf3f90115fe', 'quantite': '50 g'}, {'ingredient_id': '0ece3150-cffc-4c26-9168-350ee0ed0d92', 'quantite': '10 cl'}, {'ingredient_id': '09ea10d0-3754-44df-aad3-5ffcf508c64e', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (340053, 'Gâteau à la banane sans œufs Vegan', 'sucre, farine, banane, huile', '15 min', ['Préchauffer le four à 180°C (thermostat 6)', 'Couper les bananes en tranches puis les broyer de manière à ce qu''elles forment un liquide épais homogène. ', 'Dans un saladier ajouter le sucre, la farine, l''huile et la banane broyée et mélanger le tout. ', 'Beurrer le moule à gâteaux et y ajouter le mélange.', 'Enfourner à 180°C pendant 25 à 30 min.'], ['Ouvre-boîte', 'Balance de cuisine', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'Gâteau à la banane sans œufs Vegan', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:27:49.547604', [{'ingredient_id': '8d67a708-002f-4904-9ca0-2dfa2846cd53', 'quantite': '200 g'}, {'ingredient_id': '6af6ef59-ab5f-4cb6-8ceb-9c68f703a681', 'quantite': '250 g'}, {'ingredient_id': '95d501ea-3a84-4a4e-a76d-8941e45af3bd', 'quantite': '3'}, {'ingredient_id': '45303e70-0221-46b8-8a40-a4cb808478e0', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530093, 'Crêpe tortilla banane et pâte à tartiner', 'farine, oeuf, huile, lait, sucre, sel, pâte à tartiner, banane, caramel au beurre salé, amandes effilées, crème chantilly', '10 min', ['Mélanger la farine, le sel, les oeufs et l''huile.', 'Ajouter le lait progressivement pour éviter les grumeaux. Donner un coup de mixeur pour le enlever si besoin.', 'Sucrer la pâte.', 'Faire chauffer une poêle avec un peu de matière grasse. Lorsque la poêle est bien chaude, déposer une bonne louche de pâte et faire cuire chaque côté.', 'Sur chaque crêpe cuite : étaler de la pâte à tartiner sur un quart, la banane en rondelles sur le deuxième, quelques points de chantilly sur la troisième. Attention à ne pas mettre trop de chantilly pour éviter que cela déborde. Sur le dernier quart, tartiner le caramel et le recouvrir d''une poignet d''amandes effilées.', 'Inciser la crêpe entre le quart de pâte à tartiner et le quart de caramel. Plier de quart en quart en suivant l''ordre pâte à tartiner, banane, chantilly, caramel.', 'C''est prêt !'], ['Poêle', 'Mixeur', 'Presse-agrumes', 'Planche à découper', 'Fouet'], ['Crêpe tortilla banane et pâte à tartiner', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'crêpes sucrées', 'lait', 'sucre', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:27:53.220168', [{'ingredient_id': 'f71c3fe2-cfd1-4911-bec2-97a4874ffbfc', 'quantite': '150 g'}, {'ingredient_id': '44300a86-cffb-4ecc-bfb2-9d6f1ff99691', 'quantite': '3'}, {'ingredient_id': 'f0df8500-8645-407c-8e69-7b01609c1556', 'quantite': '2 cuillères'}, {'ingredient_id': 'c9fae401-3fca-491a-89ee-d73dddc1a43c', 'quantite': '500 ml'}, {'ingredient_id': 'e7023a1c-84a4-40e1-960a-473ec28f81c4', 'quantite': '2 cuillères'}, {'ingredient_id': '111b926b-1af2-42b4-8c21-e9f278a0090d', 'quantite': '1'}, {'ingredient_id': '88bf1ce4-6575-4638-a8fb-541e8bdc37d1', 'quantite': ''}, {'ingredient_id': 'efddfee0-d6ae-4407-a1b6-0b26a81ff5c8', 'quantite': '1'}, {'ingredient_id': '911ade6c-f919-4c9f-a305-251a6c26724f', 'quantite': ''}, {'ingredient_id': '511e6c4f-94a3-471c-bdff-1dd1b5637567', 'quantite': ''}, {'ingredient_id': 'f0d92230-9a4f-49b3-8844-e7f5e585b739', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (95822, 'Punch créole', 'rhum, vanille, sirop de canne, sucre roux, miel, jus de citron, orange, goyave, mangue, banane, ananas, cannelle', '15 min', ['Laver citron & oranges. Les presser pour en extraire le jus et griffer leurs peaux pour les zestes. ', 'Dans un grand saladier (ou un grand saut) verser le rhum, les jus de citron & oranges avec les zestes, les nectars de fruit.', 'Ajouter une gousse de vanille fendue dont vous aurez gratter l''intérieur pour faire sortir les graines.', 'Ajouter l''ananas en morceaux.', 'Mélanger puis ajouter le sucre & le miel. Ajouter ensuite une bonne pincée de cannelle & de gingembre.', 'Réserver la préparation au réfrigérateur pendant au minimum 4heures pour faire macérer.', 'Après macération, gouter et rajouter sucre, miel, épices, jus... selon vos goûts.'], ['Moule à tarte', 'Verre doseur', 'Casserole', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'goyave', 'très facile', 'sirop de canne', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'vanille', 'Punch créole', 'punch', 'dessert', 'plat de résistance', 'jus de citron', 'moyen', 'orange', 'ananas', 'cannelle', 'cocktail', 'sucre roux'], 'Boisson', 74188504-3fd5-4289-a1af-79f65678cda5, '2025-09-26T15:27:56.764679', [{'ingredient_id': '23496ae8-451a-41c9-bee2-6fd0e9edaf3c', 'quantite': '1 l'}, {'ingredient_id': '8f169314-df57-4b97-83d3-151bdef42bdd', 'quantite': '1'}, {'ingredient_id': '7b0728f7-553a-4cc6-b724-1d0fba768d3f', 'quantite': '4 cuillères'}, {'ingredient_id': 'abdede00-d6fc-4d9c-bbd2-a4de0488b73c', 'quantite': ''}, {'ingredient_id': 'a0d70ded-c3ec-4814-98ed-99e07f144c94', 'quantite': '2 cuillères'}, {'ingredient_id': '13c0c6fe-626d-4ffe-8f78-d49413ace94f', 'quantite': '1'}, {'ingredient_id': 'e55c1f25-51dc-488c-9fbd-ca21758d03d2', 'quantite': '2'}, {'ingredient_id': '06f040de-b9fa-418e-8c27-0c88bcac9de7', 'quantite': '50 cl'}, {'ingredient_id': '19a1ec3b-7594-4713-9b91-8a6dd255f915', 'quantite': '50 cl'}, {'ingredient_id': '941e6bc3-2d84-481e-b3da-66dcf22e95e8', 'quantite': '25 cl'}, {'ingredient_id': 'c580ac25-065f-4519-b202-76b730ae90f5', 'quantite': '1'}, {'ingredient_id': '9af697f9-5e60-43d2-baa7-c9698be4875b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (41562, 'Milk-shake aux cookies', 'lait, cookie, banane, sucre en poudre', '10 min', ['Mixez le lait, le sucre, la banane, et 3 cookies, jusqu''à obtenir un lait épais et lisse.', 'Emiettez le cookie restant en très petit morceaux, et réserver.', 'Remplissez des verres, assez larges et hauts, avec le milk-shake, et ajoutez les miettes de cookies. ', 'Servir bien froid, lors du goûter !'], ['Poêle', 'Rouleau à pâtisserie', 'Ouvre-boîte', 'Verre doseur', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Milk-shake aux cookies', 'confiserie', 'testées', 'très facile', 'bon marché', 'cookie', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'lait', 'cocktail'], 'Boisson', 1b8261ec-c736-492c-8b0e-83af03fbd17e, '2025-09-26T15:28:00.160072', [{'ingredient_id': 'bda06aac-0fb8-4d9c-b2ec-375eecaf5a6a', 'quantite': ''}, {'ingredient_id': 'b2115a69-1ebb-4f52-ab6b-85ef98423773', 'quantite': '4'}, {'ingredient_id': '0c3a80ec-b069-4e8e-b24b-85f359aa34df', 'quantite': '1'}, {'ingredient_id': '134499b4-db6a-4e41-b2d1-3d7cd2eb847d', 'quantite': '30 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (64184, 'Fruits rôtis au miel et leur sauce exotique', 'yaourt, mangue, fruit de la passion, sucre semoule, pomme, banane, ananas, kiwi, carambole, miel, rhum', '15 min', ['Préparer la sauce :', 'Dans un récipient, verser les yaourts.', 'Passer la pulpe des fruits de la passion au chinois afin d''en extraire le jus et l''ajouter aux yaourts.', 'Ajouter la mangue pelée et coupée en morceaux.', 'Mixer le tout jusqu''à temps d''obtenir une belle sauce orange bien lisse.', 'Ajouter du sucre ou de l''édulcorant selon le goût (attenton à ne pas trop sucrer car les fruits seront déjà sucrés avec le miel). ', 'Réserver au frais.', 'Préparer les fruits rôtis au miel :', 'Peler et couper les pommes et les kiwis en morceaux. Peler et couper les bananes en tranches fines. Egoutter l''ananas. Rincer et couper la carambole en tranches fines.', 'Dans un wok, à feu vif, verser les morceaux de pommes et d''ananas.', 'Laisser saisir pendant 2 min en remuant souvent.', 'Puis ajouter les bananes et kiwis, laisser saisir pendant 2 min à nouveau.', 'Lorsque les bananes commencent à fondre et à compoter, ajouter la carambole et le miel. Laisser rôtir pendant 2 à 3 min en remuant souvent.', 'Eteindre le feu sous le wok.', 'Arroser les fruits avec le rhum et flamber aussitôt. Si l''alcool ne flambe pas de suite, rajouter un peu de rhum et flamber à nouveau.', 'Lorsque les flammes se sont éteintes, dresser 4 assiettes creuses, répartir la sauce exotique dans chaque assiette et répartir ensuite les fruits chauds au milieu.', 'Servir aussitôt ! Bon Appétit !'], ['Presse-agrumes', 'Batteur électrique', 'Spatule', 'Économe'], ['', 'entrée', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'fruit de la passion', 'dessert', 'plat de résistance', 'moyen', 'Fruits rôtis au miel et leur sauce exotique', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:28:04.551369', [{'ingredient_id': '196235b3-6b4d-47db-a9ac-cf3bf439145c', 'quantite': '2'}, {'ingredient_id': '9cdfbf14-b69f-4f75-b4c2-cf8ab174d3bf', 'quantite': '1'}, {'ingredient_id': 'b388abee-8c80-464b-8bbd-c20e94f2d591', 'quantite': '2'}, {'ingredient_id': 'c199dc9a-30c0-4b88-bb7d-3488c5e59930', 'quantite': ''}, {'ingredient_id': '3c8be064-777a-44f3-aa9a-7dff41dc9c5b', 'quantite': '1'}, {'ingredient_id': '07a1db31-a684-4b5b-b948-1825f56940c6', 'quantite': '2'}, {'ingredient_id': 'e42abf39-621c-4c43-aa5c-0772f0f90224', 'quantite': '1'}, {'ingredient_id': 'c17f675d-261a-4c7d-81fa-34f885c9e729', 'quantite': '2'}, {'ingredient_id': 'f5b6a95e-1511-4414-a93f-23db99f55553', 'quantite': '1'}, {'ingredient_id': '44ca9fdf-694f-4b6b-9034-41ea657f1cb7', 'quantite': '5'}, {'ingredient_id': 'c5914c82-8601-485d-b85f-b113b120778d', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32066, 'Gâteau fondant banane chocolat', 'banane, farine, sucre, beurre, oeuf, chocolat', '20 min', ['Beurrez un grand moule rond. Pelez et coupez en dés les 3 bananes, laissez les dans un bol. Faites fondre le beurre à feux doux', 'Séparez les blancs des jaunes d''oeufs.', 'Mettez les jaunes avec le sucre et battez-les au fouet électrique jusqu''à ce qu''ils blanchissent. Ajouter le beurre fondu sans verser le dépôt blanc au fond de la casserole, puis la farine.', 'Fouettez les blancs en neige ferme avec une pincée de sel et incorporez les les petit a petit à la pâte.', 'Versez-la dans le moule en alternant avec les dés de bananes et les pépites de chocolats (quantité variable selon goût!).', 'Enfournez et faites cuire 40 mn à thermostat 6 (180°C).', 'Laissez reposer. Dégustez froid ou encore tiède.'], ['Économe', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'Gâteau fondant banane chocolat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'gâteau au chocolat', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:28:11.255697', [{'ingredient_id': '9a472ce7-1b73-49d8-a5fc-b403cfb7ecd9', 'quantite': '3'}, {'ingredient_id': 'ddfb4119-7097-4b74-9345-cb2344a7b5aa', 'quantite': '120 g'}, {'ingredient_id': '28e2882f-b5c8-4bdf-8d89-8e1c48199c45', 'quantite': '150 g'}, {'ingredient_id': '6b5d1dc3-b81d-471e-9226-f99fdc095d03', 'quantite': '100 g'}, {'ingredient_id': '5a5d6f9c-df37-4d0b-9a8c-3b2e20687937', 'quantite': '3'}, {'ingredient_id': '56075095-c85c-4e01-b260-26eaeb9bb051', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36827, 'Confiture poires, bananes, kiwi', 'poire, banane, kiwi, sucre', '30 min', ['Eplucher les poires, retirer les pépins et les couper en petits morceaux.', 'Eplucher les bananes et les couper en rondelles fines.', 'Eplucher les kiwis et les couper en petits morceaux.', 'Mettre tous les morceaux de fruits dans une sauteuse (ou mieux une bassine à confiture), y ajouter le sucre spécial confiture.', 'Faire cuire en mélangeant régulièrement pendant environ 10 minutes.', 'Une fois la cuisson finie, attendre quelques minutes et mixer grossièrement la préparation.', 'Répartir ensuite dans des pots à confiture.'], ['Poêle', 'Balance de cuisine', 'Couteau de chef'], ['', 'entrée', 'banane', 'Confiture poires', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'rapide', 'bananes', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:28:14.607074', [{'ingredient_id': '410eab11-f5ae-404d-8191-4a891405837e', 'quantite': '600 g'}, {'ingredient_id': '88afa1c7-0510-43a3-88cc-cdef81d2157b', 'quantite': '300 g'}, {'ingredient_id': '0ea098bd-8b38-4b2b-a75f-cff479f858df', 'quantite': '100 g'}, {'ingredient_id': 'c4552253-d15b-40db-997c-7d76c265f7ba', 'quantite': '800 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21653, 'Gâteau à la banane rapide', 'oeuf, sucre vanillé, eau, farine, sucre, levure chimique, lait, poudre à flan, oeuf, beurre, margarine, sucre glace, rhum, crème fraîche, chocolat noir, sucre glace', '1 min', ['Pour la génoise: ', 'Battre les blancs en neige. ', 'Battre les jaunes d''oeufs avec le sucre et le sucre vanille, ajoutez l''eau tiède, la farine et la levure chimique et pour finir les blancs en neige. ', 'Mettre dans un moule à charnière de 27 cm de diamètre environ et cuire pendant 20 mn sur Th 5 . ', 'Laisser refroidir la génoise. ', 'Pour la crème: ', 'Faire le pudding avec le lait. Laisser refroidir. ', 'Mélanger l''oeuf avec le sucre glace, le beurre et la margarine. Ajoutez le Rhum et pour finir ajoutez le pudding refroidi. ', 'Mettre un peu de crème sur la génoise puis mettre 3 à 4 bananes coupées horizontalement sur cette crème puis recouvrir les bananes de crème. ', 'Pour le chocolat : ', 'faire cuire le chocolat, la crème fraîche et le sucre glace. ', 'Après que le chocolat soit refroidi, le faire couler sur le gâteau. ', 'Pour le décor: ', 'Quelques vermicelles multicolores.'], ['Fouet', 'Rouleau à pâtisserie', 'Spatule', 'Louche'], ['entrée', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'Gâteau à la banane rapide', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'gâteau à la banane', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:28:18.801761', [{'ingredient_id': '4fef2855-38e3-4a6c-91e5-ac364d08689d', 'quantite': '3'}, {'ingredient_id': 'bda19922-4d9b-47a3-a0a8-516e837f391d', 'quantite': '1'}, {'ingredient_id': 'c199092b-fcbf-43cd-b95f-e4a9081d2b50', 'quantite': '1'}, {'ingredient_id': '4a66ea27-65c6-4b2e-a6b0-52e043bfd8b5', 'quantite': '90 g'}, {'ingredient_id': '2b0612d9-6f2a-48f1-a70d-8da866a45147', 'quantite': '90 g'}, {'ingredient_id': 'bec2faba-aa9c-437c-8798-47b242e106b8', 'quantite': '1'}, {'ingredient_id': '537a76d7-742e-4c09-8fbf-67092eb0e140', 'quantite': ''}, {'ingredient_id': '658fc96f-90ac-45a2-beff-0e38b7f69fcc', 'quantite': '1'}, {'ingredient_id': 'c43490c6-997a-4477-9606-a40c984a96ee', 'quantite': '1'}, {'ingredient_id': '5f56b81c-3b77-4749-bda8-f07e2373a57b', 'quantite': '125 g'}, {'ingredient_id': 'b26d3757-b800-4d27-bae1-44d2c012c804', 'quantite': '125 g'}, {'ingredient_id': '7e5036a5-15f9-4c00-b12f-2a34ac60262c', 'quantite': '125 g'}, {'ingredient_id': '1c1cb778-ecec-4f83-8b9d-4fa885f5a867', 'quantite': '2 cuillères'}, {'ingredient_id': 'b7402cc4-9854-48a3-a04c-ac0ccd1356f8', 'quantite': '20 cl'}, {'ingredient_id': 'b0492052-80cd-4eed-ad08-499312892d2c', 'quantite': '200 g'}, {'ingredient_id': '62720248-5f0b-4061-a23e-d45eb2b81258', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (223949, 'Cake salé de base avec garnitures', 'farine, levure, oeuf, huile, lait, emmental, sel, poivre, Noix concassée, lardons, roquefort, amandes, lardons, champignon, olives, herbes de Provence, bûche de chèvre, tomate, tomate, herbes de Provence, origan, tabasco, ail, thon, courgette, crème fraîche, cumin, fenouil, chorizo, maroilles, noisettes, lardons, pruneau, banane, boudin noir, pomme, crème fraîche, amandes en poudre, saumon frais, asperge, crème fraîche, aneth', '25 min', ['C''est une recette avec une base similaire pour tous les cakes et ensuite, à votre imagination. Commencer par mélanger la farine et la levure.', 'Ajouter les oeufs, le lait et l''huile (vous pouvez utiliser différentes huiles).', 'Ajouter l''emmental râpé, le sel et le poivre.', 'Votre base est prête ! ', 'Préchauffez votre four à 180°C (thermostat 6).
Ensuite, ajoutez les autres ingrédients (cf propositions de garnitures au dessus).', 'Mélangez et versez la préparation dans un moule à cake.', 'Enfournez 45 min à 180°C.', 'Les possibilités sont infinies une fois le système maîtrisé ! ', 'Peut se servir chaud avec de la salade et un filet de vinaigrette au vinaigrier balsamique, ou froid en apéritif.
A votre imagination !'], ['Mixeur', 'Balance de cuisine', 'Fouet', 'Moule à tarte', 'Poêle'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'cake salé apéritif', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'Cake salé de base avec garnitures', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'emmental', 'poivre', 'lait', 'cocktail'], 'Plat principal', be00d30f-09b4-4b2e-a9b7-22d7044725ed, '2025-09-26T15:28:25.662019', [{'ingredient_id': '25fbd535-d902-47d0-bb8f-d1f2253a283a', 'quantite': '200 g'}, {'ingredient_id': '5cb023b3-116f-4db5-8013-0731eef5d7d1', 'quantite': '1'}, {'ingredient_id': 'cc78792f-3a75-416a-a95a-e54b7306cd09', 'quantite': '4'}, {'ingredient_id': '9838d555-57cc-4de0-97fe-c1ee6a4df09f', 'quantite': '7 cl'}, {'ingredient_id': '278ece0a-500b-4edd-af6a-8512c1764df2', 'quantite': '12.5 cl'}, {'ingredient_id': '8d9f1677-2fa8-432b-a496-f50b8f096262', 'quantite': '100 g'}, {'ingredient_id': '443bcddc-356d-4a24-91ef-c42fadfe7ff9', 'quantite': ''}, {'ingredient_id': '2d371090-c8f5-4fb7-9bd3-1d35d3bcd14f', 'quantite': ''}, {'ingredient_id': '2a457d82-f623-4b79-b38f-e1b01b2a4c30', 'quantite': '70 g'}, {'ingredient_id': '356f7d75-d132-4d45-ba20-072b454e28f6', 'quantite': '200 g'}, {'ingredient_id': '959b1b0d-7dc3-4124-aa1c-d8168c72c0e8', 'quantite': '125 g'}, {'ingredient_id': '9ce324b8-b1e4-4e81-b936-24b7f6d7045a', 'quantite': '50 g'}, {'ingredient_id': '7ce79c46-e5e8-4a4d-9a2e-f9412aeac4f2', 'quantite': '200 g'}, {'ingredient_id': '0ab0a2b9-6b53-4984-a879-c6a2e4862e66', 'quantite': '200 g'}, {'ingredient_id': '58206f0e-6aff-46b6-a395-6732c3cf976f', 'quantite': '150 g'}, {'ingredient_id': '609323d1-c0b0-4aeb-ac6c-366cb35bb2ab', 'quantite': ''}, {'ingredient_id': 'de746c16-73a4-4321-a97b-324b02daa843', 'quantite': '1'}, {'ingredient_id': '766b75a0-7dea-4cd6-8240-819edf5b62b9', 'quantite': '100 g'}, {'ingredient_id': '3209e1a9-a263-42a3-9ab6-78025fa9ebfc', 'quantite': '2'}, {'ingredient_id'