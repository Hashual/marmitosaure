INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 8e3b1fff-e7a9-40e7-9e52-b6a8b3a0a6a8, 'Je l''ai faite pour accompagner du cabillaud. Excellent !! ', '2018-08-18T05:05:30+02:00');
